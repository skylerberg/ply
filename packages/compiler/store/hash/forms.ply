pub fn build_index(
  modules: List<ParsedModule>,
  resolved: Resolution,
) -> { index: Index, diagnostics: List<Diagnostic> } / {abort.raise} = {
  let built = range(0, modules.len()).fold(
    { nodes: [], tests: [], laws: [], order: [], items: [], diagnostics: [] },
    |b: IndexBuilder, m: Int| {
      let module = modules.get(m);
      let walked = module.module.items.fold(
        {
          b: b,
          functions: no_declarations([]),
          types: no_declarations([]),
          effects: no_declarations([]),
          constructors: no_declarations([]),
        },
        |s: { b: IndexBuilder, functions: Declarations, types: Declarations, effects: Declarations, constructors: Declarations }, item: Item| {
          let bb: IndexBuilder = s.b;
          match item {
            FunctionItem(d) -> {
              let id = bb.nodes.len();
              let pushed: IndexBuilder = {
                ..bb,
                nodes: bb.nodes.push({
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeFn(d),
                }),
                order: bb.order.push(DefinitionEntry(id)),
              };
              let functions: Declarations = declare(
                { ..s.functions, diagnostics: [] },
                m,
                d.name,
                id,
                b"definition",
              );
              {
                ..s,
                b: { ..pushed, diagnostics: pushed.diagnostics.concat(functions.diagnostics) },
                functions: { ..functions, diagnostics: [] },
              }
            },
            TypeItem(d) -> {
              let id = bb.nodes.len();
              let pushed: IndexBuilder = {
                ..bb,
                nodes: bb.nodes.push({
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeType(d),
                }),
                order: bb.order.push(DefinitionEntry(id)),
              };
              let types: Declarations = declare(
                { ..s.types, diagnostics: [] },
                m,
                d.name,
                id,
                b"type",
              );
              let constructors: Declarations = match d.body {
                SumBody(variants) ->
                  variants.fold(
                    { ..s.constructors, diagnostics: [] },
                    |c: Declarations, variant: VariantDefinition|
                      declare(c, m, variant.name, id, b"variant"),
                  ),
                _ -> { ..s.constructors, diagnostics: [] },
              };
              {
                ..s,
                b: {
                  ..pushed,
                  diagnostics: pushed.diagnostics.concat(types.diagnostics).concat(
                    constructors.diagnostics,
                  ),
                },
                types: { ..types, diagnostics: [] },
                constructors: { ..constructors, diagnostics: [] },
              }
            },
            EffectItem(d) -> {
              let id = bb.nodes.len();
              let pushed: IndexBuilder = {
                ..bb,
                nodes: bb.nodes.push({
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeEffect(d),
                }),
                order: bb.order.push(DefinitionEntry(id)),
              };
              let effects: Declarations = declare(
                { ..s.effects, diagnostics: [] },
                m,
                d.name,
                id,
                b"effect",
              );
              {
                ..s,
                b: { ..pushed, diagnostics: pushed.diagnostics.concat(effects.diagnostics) },
                effects: { ..effects, diagnostics: [] },
              }
            },
            TestItem(d) ->
              {
                ..s,
                b: {
                  ..bb,
                  order: bb.order.push(TestEntry(bb.tests.len())),
                  tests: bb.tests.push({
                    key: qualify(module.name, d.name),
                    module: m,
                    definition: d,
                  }),
                },
              },
            LawItem(d) ->
              {
                ..s,
                b: {
                  ..bb,
                  order: bb.order.push(LawEntry(bb.laws.len())),
                  laws: bb.laws.push({
                    key: qualify(module.name, d.name),
                    module: m,
                    definition: d,
                  }),
                },
              },
            _ -> s,
          }
        },
      );
      let wb: IndexBuilder = walked.b;
      {
        ..wb,
        items: wb.items.push({
          functions: walked.functions.map,
          members: walked.functions.map.fold(
            Map::new(),
            |accumulator: Map<Bytes, List<Int>>, name: Bytes, node: Int|
              match member_of(name) {
                Some(of) ->
                  accumulator.insert(
                    of.member,
                    List::push(
                      match accumulator.get(of.member) { Some(ns) -> ns, None -> [] },
                      node,
                    ),
                  ),
                None -> accumulator,
              },
          ),
          types: walked.types.map,
          effects: walked.effects.map,
          constructors: walked.constructors.map,
          instances: instances_in(module.module.items),
          numerics: module.module.items.fold(
            Map::new(),
            |accumulator: Map<Bytes, NumericDefinition>, item: Item|
              match item {
                NumericItem(d) -> accumulator.insert(d.target.name, d),
                _ -> accumulator,
              },
          ),
        }),
      }
    },
  );
  let scopes = range(0, modules.len()).map(|m: Int| {
    let scope = resolved.scopes.get(m);
    let project = |bindings: List<Binding>|
      bindings.fold(Map::new(), |accumulator: Map<Bytes, Target>, b: Binding|
        accumulator.insert(b.name, {
          owner: module_index(resolved, b.owner),
          name: simple_of(b.qualified, b.owner),
        }));
    {
      values: project(scope.bound.values),
      types: project(scope.bound.types),
      effects: project(scope.bound.effects),
      modules: scope.modules.fold(Map::new(), |accumulator: Map<Bytes, Int>, mb: ModuleBinding|
        accumulator.insert(mb.binder, module_index(resolved, mb.target))),
      visible_modules: match resolved.visible_modules.at(m) { Some(seen) -> seen, None -> [m] },
    }
  });
  let prelude = range(0, modules.len()).filter(|m: Int| modules.get(m).name == prelude_module);
  let index: Index = {
    modules: modules,
    nodes: built.nodes,
    tests: built.tests,
    laws: built.laws,
    order: built.order,
    items: built.items,
    scopes: scopes,
    written: prelude.fold(Map::new(), |accumulator: Map<Bytes, Int>, m: Int|
      emitted_code.calls.concat(emitted_code.insert_calls).fold(
        accumulator,
        |a: Map<Bytes, Int>, n: Bytes|
          match built.items.get(m).functions.get(n) { Some(v) -> a.insert(n, v), None -> a },
      )),
  };
  { index: index, diagnostics: built.diagnostics }
}

fn bytes_lt(a: Bytes, b: Bytes) -> Bool = match compare_values(a, b) { Less -> true, _ -> false }

pub fn sort_bytes(xs: List<Bytes>) -> List<Bytes> / {abort.raise} =
  xs.fold([], |accumulator: List<Bytes>, x: Bytes| {
    let n = accumulator.len();
    let i = range(0, n).fold(n, |p: Int, j: Int|
      if p < n { p } else if bytes_lt(x, accumulator.get(j)) { j } else { p });
    accumulator.take(i).push(x).concat(range(i, n).map(|j: Int| accumulator.get(j)))
  })

pub fn listed_refs(index: Index, t: TestNode) -> List<Int> / {abort.raise} =
  match t.definition.cases {
    None -> [],
    Some(c) ->
      expression_references(
        expression_template(
          index,
          t.module,
          case_params(c).map(|p: { name: Identifier, ty: TypeExpression }| p.name),
          test_run(t.definition),
        ),
      ).fold(
        expression_references(expression_template(index, t.module, [], test_listing(c))),
        |accumulator: List<Int>, v: Int|
          if accumulator.contains(v) { accumulator } else { accumulator.push(v) },
      ),
  }

const own_domain: Bytes = b"ply.own.2"

const clause_domain: Bytes = b"ply.clause.2"

const contract_domain: Bytes = b"ply.contract.4"

const identity_domain: Bytes = b"ply.identity.2"

const node_domain: Bytes = b"ply.node.1"

const rejected_domain: Bytes = b"ply.rejected.1"

pub fn own_hash(payload: Bytes) -> Bytes = blake3(own_domain.concat(payload))

pub fn spec_hash(owner: Bytes, kind: Int, index: Int, payload: Bytes) -> Bytes / {abort.raise} =
  blake3(Bytes::concat_all([clause_domain, owner, byte_of_int(kind), u32_le(index), payload]))

pub type CallChoices = | ChosenCalls(List<Choice>) | PendingCalls(List<CallResolution>)

derive bin for CallChoices

pub type FramedBody = { calls: CallChoices, form: Bytes }

derive bin for FramedBody

pub fn single_body(f: FilledForm) -> FramedBody =
  {
    calls: match Option::traverse(f.chosen, |p: CallResolution|
        match p { Known(c) -> Some(c), Pending(_) -> None }) {
      Some(choices) -> ChosenCalls(choices),
      None -> PendingCalls(f.chosen),
    },
    form: f.bytes,
  }

pub type Identified =
  | TestRun(Bytes)
  | TestListing(Bytes)
  | LawRun(Bytes)
  | LawProof(Bytes)
  | DefinitionRun(Bytes)
  | DefinitionProof(Bytes)
  | DefinitionContract(NodeRef)

pub type SubjectIdentity = { subject: Identified, identity: Bytes }

derive bin for Identified

derive bin for SubjectIdentity

pub opaque type Identities = | Identities(Map<Identified, Bytes>)

pub fn identity_in(identities: Identities, subject: Identified) -> Option<Bytes> =
  match identities { Identities(found) -> found.get(subject) }

pub fn identities_of(listed: List<SubjectIdentity>) -> Identities =
  Identities(
    listed.fold(Map::new(), |found: Map<Identified, Bytes>, s: SubjectIdentity|
      found.insert(s.subject, s.identity)),
  )

pub fn joined_identities(parts: List<Identities>) -> Identities =
  Identities(
    parts.fold(Map::new(), |all: Map<Identified, Bytes>, part: Identities|
      match part {
        Identities(found) ->
          found.fold(all, |joined: Map<Identified, Bytes>, subject: Identified, identity: Bytes|
            joined.insert(subject, identity)),
      }),
  )

type Digested = { own: List<Bytes>, reached: List<Bytes> }

derive bin for Digested

fn digest_of(domain: Bytes, own: List<Bytes>, reached: List<Bytes>) -> Bytes / {abort.raise} =
  blake3(
    domain.concat(
      bin::encode({ own: own.sort().unique(), reached: reached.sort().unique() }, digested_bin()),
    ),
  )

pub type Boundary = | InsidePackage | OutsidePackage

pub type Origin = | FromSubject(Identified) | FromDefinition(NodeRef)

pub type ReadIdentities = { body: Bytes, contract: Bytes, proof: Bytes }

derive bin for ReadIdentities

pub type DefinitionIdentities = { reference: NodeRef, identities: ReadIdentities }

pub type DefinitionElsewhere = | HashedElsewhere(ReadIdentities) | RejectedElsewhere

pub type WorldIdentities = {
  definitions: List<DefinitionIdentities>,
  subjects: List<SubjectIdentity>,
}

type Policy = | BodyPolicy | ContractPolicy | ProofPolicy

fn policy_of(subject: Identified) -> Policy =
  match subject {
    TestRun(_) -> BodyPolicy,
    TestListing(_) -> BodyPolicy,
    LawRun(_) -> BodyPolicy,
    DefinitionRun(_) -> BodyPolicy,
    LawProof(_) -> ProofPolicy,
    DefinitionProof(_) -> ProofPolicy,
    DefinitionContract(_) -> ContractPolicy,
  }

type Reading = | ReadsBody | ReadsContract | ReadsProof

derive bin for Reading

const readings: List<Reading> = [ReadsBody, ReadsContract, ReadsProof]

fn reading_number(reading: Reading) -> Int =
  match reading { ReadsBody -> 0, ReadsContract -> 1, ReadsProof -> 2 }

fn node_at(definition: Int, reading: Reading) -> Int = 3 * definition + reading_number(reading)

type Next = { reference: NodeRef, inside: Reading, outside: Reading }

fn nexts(references: List<NodeRef>, inside: Reading, outside: Reading) -> List<Next> =
  references.map(|r: NodeRef| { reference: r, inside: inside, outside: outside })

fn nexts_of(d: DefinitionHash, reading: Reading) -> List<Next> =
  match reading {
    ReadsBody -> nexts(d.uses.concat(d.clause_uses), ReadsBody, ReadsBody),
    ReadsContract ->
      nexts(d.contract_uses, ReadsContract, ReadsContract).concat(
        nexts(d.clause_uses, ReadsBody, ReadsBody),
      ),
    ReadsProof -> nexts(d.uses.concat(d.clause_uses), ReadsProof, ReadsContract),
  }

fn first_reads(policy: Policy, uses: List<NodeRef>) -> List<Next> =
  match policy {
    BodyPolicy -> nexts(uses, ReadsBody, ReadsBody),
    ContractPolicy -> nexts(uses, ReadsContract, ReadsContract),
    ProofPolicy -> nexts(uses, ReadsProof, ReadsContract),
  }

fn own_of(d: DefinitionHash, reading: Reading) -> List<Bytes> =
  match reading {
    ReadsBody -> [d.hash].concat(d.clauses),
    ReadsContract -> [d.contract],
    ReadsProof -> [d.hash].concat(d.clauses),
  }

type ReadNode = { definition: DefinitionHash, reading: Reading }

type NodeEntry = { definition: Bytes, reading: Reading, own: List<Bytes> }

derive bin for NodeEntry

fn entry_of(node: ReadNode) -> Bytes / {abort.raise} =
  bin::encode(
    {
      definition: definition_key(node.definition.name, node.definition.kind),
      reading: node.reading,
      own: own_of(node.definition, node.reading),
    },
    node_entry_bin(),
  )

type Resolved = | LocalNode(Int) | KnownIdentity(Bytes)

fn identity_read(found: ReadIdentities, reading: Reading) -> Bytes =
  match reading {
    ReadsBody -> found.body,
    ReadsContract -> found.contract,
    ReadsProof -> found.proof,
  }

fn rejected_identity(reference: NodeRef) -> Bytes / {abort.raise} =
  digest_of(rejected_domain, [definition_key(reference.name, reference.kind)], [])

fn local_nodes(targets: List<Resolved>) -> List<Int> =
  targets.flat_map(|t: Resolved| match t { LocalNode(n) -> [n], KnownIdentity(_) -> [] })

fn known_identities(targets: List<Resolved>) -> List<Bytes> =
  targets.flat_map(|t: Resolved|
    match t { LocalNode(_) -> [], KnownIdentity(identity) -> [identity] })

type World = { at: Map<Bytes, Int>, definitions: List<DefinitionHash> }

fn world_of(definitions: List<DefinitionHash>) -> World =
  definitions.fold({ at: Map::new(), definitions: [] }, |w: World, d: DefinitionHash| {
    let key = definition_key(d.name, d.kind);
    if w.at.contains(key) { w }
    else { { at: w.at.insert(key, w.definitions.len()), definitions: w.definitions.push(d) } }
  })

pub fn world_identities<| e>(
  own: OwnHashes,
  beyond: (NodeRef) -> DefinitionElsewhere / {abort.raise | e},
  boundary: (Origin, NodeRef) -> Boundary / {abort.raise | e},
) -> WorldIdentities / {abort.raise | e} = {
  let world = world_of(own.definitions);
  let resolved = |origin: Origin, next: Next| {
    let reading = match boundary(origin, next.reference) {
      InsidePackage -> next.inside,
      OutsidePackage -> next.outside,
    };
    match world.at.get(definition_key(next.reference.name, next.reference.kind)) {
      Some(i) -> LocalNode(node_at(i, reading)),
      None -> match beyond(next.reference) {
        HashedElsewhere(found) -> KnownIdentity(identity_read(found, reading)),
        RejectedElsewhere -> KnownIdentity(rejected_identity(next.reference)),
      },
    }
  };
  let nodes = world.definitions.flat_map(|d: DefinitionHash|
    readings.map(|reading: Reading| { definition: d, reading: reading }));
  let targets = nodes.map(|node: ReadNode| {
    let origin = FromDefinition({ name: node.definition.name, kind: node.definition.kind });
    nexts_of(node.definition, node.reading).map(|next: Next| resolved(origin, next))
  });
  let condensed = condensation({ out: targets.map(local_nodes) });
  let component_identities = range(0, condensed.members.len()).fold(
    [],
    |found: List<Bytes>, c: Int| {
      let members = condensed.members.get(c);
      found.push(
        digest_of(
          node_domain,
          members.map(|n: Int| entry_of(nodes.get(n))),
          condensed.graph.out.get(c).map(|lower: Int| found.get(lower)).concat(
            members.flat_map(|n: Int| known_identities(targets.get(n))),
          ),
        ),
      )
    },
  );
  let identity_at = |n: Int| component_identities.get(condensed.component.get(n));
  let identity_of_target = |t: Resolved|
    match t { LocalNode(n) -> identity_at(n), KnownIdentity(identity) -> identity };
  {
    definitions: range(0, world.definitions.len()).map(|i: Int| {
      let d = world.definitions.get(i);
      {
        reference: { name: d.name, kind: d.kind },
        identities: {
          body: identity_at(node_at(i, ReadsBody)),
          contract: identity_at(node_at(i, ReadsContract)),
          proof: identity_at(node_at(i, ReadsProof)),
        },
      }
    }),
    subjects: begun_of(own).map(|begun: Begun| {
      let origin = FromSubject(begun.subject);
      {
        subject: begun.subject,
        identity: digest_of(
          identity_domain,
          [begun.own],
          first_reads(policy_of(begun.subject), begun.uses).map(|next: Next|
            identity_of_target(resolved(origin, next))),
        ),
      }
    }),
  }
}

type Begun = { subject: Identified, own: Bytes, uses: List<NodeRef> }

fn begun_of(own: OwnHashes) -> List<Begun> = {
  let definitions = own.definitions.flat_map(|d: DefinitionHash| {
    let itself = { name: d.name, kind: d.kind };
    let contract: Begun = { subject: DefinitionContract(itself), own: d.contract, uses: [itself] };
    if d.kind != HeldValue { [contract] } else {
      [
        contract,
        { subject: DefinitionRun(d.name), own: d.hash, uses: [itself] },
        { subject: DefinitionProof(d.name), own: d.hash, uses: [itself] },
      ]
    }
  });
  let tests = own.tests.flat_map(|t: TestHash| {
    let run: Begun = { subject: TestRun(t.key), own: t.hash, uses: t.uses };
    match t.listing {
      Some(l) -> [run, { subject: TestListing(t.key), own: l.hash, uses: l.uses }],
      None -> [run],
    }
  });
  let laws = own.laws.flat_map(|l: LawHash| {
    let run: Begun = { subject: LawRun(l.key), own: l.hash, uses: l.uses };
    [run, { subject: LawProof(l.key), own: l.hash, uses: l.uses }]
  });
  definitions.concat(tests).concat(laws)
}

pub type TestIdentities = | PlainTestRun(Bytes) | TestRunOverCases({ run: Bytes, listing: Bytes })

pub fn identities_of_test<| e>(
  test_key: Bytes,
  lookup: (Identified) -> Option<Bytes> / {abort.raise | e},
) -> TestIdentities / {abort.raise | e} =
  match lookup(TestRun(test_key)) {
    None -> panic("the test `" ++ String::of_bytes_lossy(test_key) ++ "` has no run identity"),
    Some(run) -> match lookup(TestListing(test_key)) {
      Some(listing) -> TestRunOverCases({ run: run, listing: listing }),
      None -> PlainTestRun(run),
    },
  }

pub type HashOutput = {
  definitions: List<{ name: Bytes, hash: Bytes }>,
  declarations: List<{ name: Bytes, hash: Bytes }>,
  tests: Map<Bytes, Bytes>,
  laws: Map<Bytes, Bytes>,
  specs: List<{ name: Bytes, hashes: List<Bytes> }>,
  dependencies: List<{ name: Bytes, names: List<Bytes> }>,
  refs: Refs,
  bodies: List<{ name: Bytes, body: FramedBody }>,
  test_bodies: Map<Bytes, FramedBody>,
  own: OwnHashes,
}

pub type Refs = {
  nodes: List<NodeRef>,
  edges: List<List<Int>>,
  functions: Map<Bytes, Int>,
  declared: Map<Bytes, List<Int>>,
  items: Map<Bytes, List<Int>>,
  cases: Map<Bytes, List<Int>>,
  clauses: List<List<Int>>,
  listings: Map<Bytes, List<Int>>,
}

type Recording = { out: HashOutput, dependencies_at: Map<Bytes, Int> }

pub fn of_key<a>(m: Map<Bytes, a>, key: Bytes) -> a / {abort.raise} =
  match m.get(key) { Some(x) -> x, None -> panic("a key the table does not contain") }

pub type NodeRef = { name: Bytes, kind: HeldKind }

pub type NodeForm = {
  form: Template,
  signature: Option<Template>,
  clauses: List<ClauseForm>,
  transparent: Bool,
}

pub type ClauseForm = { kind: Int, form: Template }

pub type FormedNode = { node: Int, form: NodeForm }

pub type ItemForm = { form: Template, listing: Option<Template> }

pub type HashItem = { key: Bytes, form: ItemForm }

pub type HashInput = {
  names: List<NodeRef>,
  definitions: List<FormedNode>,
  tests: List<HashItem>,
  laws: List<HashItem>,
}

derive bin for NodeRef

derive bin for ClauseForm

derive bin for NodeForm

derive bin for FormedNode

derive bin for ItemForm

derive bin for HashItem

derive bin for HashInput

pub type DefinitionHash = {
  name: Bytes,
  kind: HeldKind,
  hash: Bytes,
  body: FramedBody,
  contract: Bytes,
  clauses: List<Bytes>,
  uses: List<NodeRef>,
  clause_uses: List<NodeRef>,
  contract_uses: List<NodeRef>,
}

pub type ListingHash = { hash: Bytes, uses: List<NodeRef> }

pub type TestHash = {
  key: Bytes,
  hash: Bytes,
  body: FramedBody,
  uses: List<NodeRef>,
  listing: Option<ListingHash>,
}

pub type LawHash = { key: Bytes, hash: Bytes, uses: List<NodeRef> }

pub type OwnHashes = {
  definitions: List<DefinitionHash>,
  tests: List<TestHash>,
  laws: List<LawHash>,
}

pub const no_own_hashes: OwnHashes = { definitions: [], tests: [], laws: [] }

derive bin for DefinitionHash

derive bin for ListingHash

derive bin for TestHash

derive bin for LawHash

derive bin for OwnHashes

pub fn joined_own_hashes(parts: List<OwnHashes>) -> OwnHashes =
  parts.fold(no_own_hashes, |accumulator: OwnHashes, part: OwnHashes|
    {
      definitions: accumulator.definitions.concat(part.definitions),
      tests: accumulator.tests.concat(part.tests),
      laws: accumulator.laws.concat(part.laws),
    })

pub fn test_uses(item: TestHash) -> List<NodeRef> =
  match item.listing {
    Some(l) ->
      l.uses.fold(item.uses, |accumulator: List<NodeRef>, r: NodeRef|
        if accumulator.contains(r) { accumulator } else { accumulator.push(r) }),
    None -> item.uses,
  }

fn unique_ints(xs: List<Int>) -> List<Int> =
  xs.fold([], |accumulator: List<Int>, x: Int|
    if accumulator.contains(x) { accumulator } else { accumulator.push(x) })

pub fn own_hashes(forms: HashInput) -> OwnHashes / {abort.raise} = {
  let names = forms.names.map(|r: NodeRef| r.name);
  let named = |vs: List<Int>| vs.map(|v: Int| forms.names.get(v));
  let test_hash_of = |x: HashItem| {
    let own = fill(x.form.form, names);
    {
      key: x.key,
      hash: own_hash(own.bytes),
      body: single_body(own),
      uses: named(references(x.form.form)),
      listing: x.form.listing.map(|l: Template|
        { hash: own_hash(fill(l, names).bytes), uses: named(references(l)) }),
    }
  };
  {
    definitions: forms.definitions.map(|d: FormedNode| {
      let own = fill(d.form.form, names);
      let hash = own_hash(own.bytes);
      let reference = forms.names.get(d.node);
      let clause_references = d.form.clauses.fold([], |accumulator: List<Int>, c: ClauseForm|
        accumulator.concat(references(c.form)));
      {
        name: reference.name,
        kind: reference.kind,
        hash: hash,
        body: single_body(own),
        contract: contract_of(d.form, reference.kind, names, hash, own.bytes),
        clauses: range(0, d.form.clauses.len()).map(|i: Int| {
          let clause = d.form.clauses.get(i);
          spec_hash(hash, clause.kind, i, fill(clause.form, names).bytes)
        }),
        uses: named(references(d.form.form)),
        clause_uses: named(unique_ints(clause_references)),
        contract_uses: named(unique_ints(contract_references(d.form, reference.kind))),
      }
    }),
    tests: forms.tests.map(test_hash_of),
    laws: forms.laws.map(|x: HashItem|
      {
        key: x.key,
        hash: own_hash(fill(x.form.form, names).bytes),
        uses: named(references(x.form.form)),
      }),
  }
}

type ContractText = { signature: Option<Bytes>, clauses: List<Bytes>, transparent: Option<Bytes> }

derive bin for ContractText

fn contract_of(
  form: NodeForm,
  kind: HeldKind,
  names: List<Bytes>,
  hash: Bytes,
  payload: Bytes,
) -> Bytes / {abort.raise} =
  if kind != HeldValue { hash } else {
    let filled = |t: Template| fill(t, names).bytes;
    let text: ContractText = {
      signature: form.signature.map(filled),
      clauses: form.clauses.map(|c: ClauseForm| filled(c.form)),
      transparent: if form.transparent { Some(payload) } else { None },
    };
    blake3(contract_domain.concat(bin::encode(text, contract_text_bin())))
  }

fn contract_references(form: NodeForm, kind: HeldKind) -> List<Int> / {abort.raise} =
  if kind != HeldValue { references(form.form) } else {
    let signature = match form.signature { Some(s) -> references(s), None -> [] };
    signature.concat(if form.transparent { references(form.form) } else { [] })
  }

fn node_form(
  index: Index,
  v: Int,
  chose: Option<Map<CallSite, Choice>>,
) -> NodeForm / {abort.raise} = {
  let node = index.nodes.get(v);
  let form = node_template(index, node.module, node.name, chose, node.body);
  match node.body {
    NodeFn(d) ->
      {
        form: form,
        signature: Some(
          node_template(
            index,
            node.module,
            node.name,
            None,
            NodeFn({ ..d, body: LiteralExpression({ span: d.name.span, literal: LiteralUnit }) }),
          ),
        ),
        clauses: d.spec.map(|clause: SpecClause|
          { kind: spec_tag(clause.kind), form: spec_template(index, node.module, d, clause) }),
        transparent: d.transparent != None,
      },
    _ -> { form: form, signature: None, clauses: [], transparent: false },
  }
}

fn test_form(
  index: Index,
  t: TestNode,
  chose: Option<Map<CallSite, Choice>>,
) -> ItemForm / {abort.raise} =
  {
    form: test_template(
      index,
      t.module,
      test_owner(index.modules.get(t.module).name, t.definition.name),
      chose,
      t.definition,
    ),
    listing: match t.definition.cases {
      Some(c) ->
        Some(
          TestOf({
            nondet: false,
            cases: None,
            body: expression_template(index, t.module, [], test_listing(c)),
          }),
        ),
      None -> None,
    },
  }

fn law_form(index: Index, l: LawNode) -> ItemForm / {abort.raise} =
  { form: law_template(index, l.module, l.definition), listing: None }

pub fn node_references(index: Index) -> List<List<Int>> / {abort.raise} =
  range(0, index.nodes.len()).map(|v: Int| {
    let node = index.nodes.get(v);
    match node.body {
      NodeElsewhere(_) -> [],
      _ -> references(node_template(index, node.module, node.name, None, node.body)),
    }
  })

pub type ModuleRecord = { nodes: List<RecordedNode>, tests: List<RecordedTest> }

pub type RecordedNode = { reference: NodeRef, hash: Bytes, edges: List<NodeRef> }

pub type RecordedTest = {
  key: Bytes,
  hash: Bytes,
  uses: List<NodeRef>,
  listing: Option<List<NodeRef>>,
}

derive bin for RecordedNode

derive bin for RecordedTest

derive bin for ModuleRecord

pub fn module_record(own: OwnHashes) -> Bytes / {abort.raise} =
  bin::encode(
    {
      nodes: own.definitions.map(|d: DefinitionHash|
        {
          reference: { name: d.name, kind: d.kind },
          hash: d.hash,
          edges: d.uses.concat(d.clause_uses),
        }),
      tests: own.tests.map(|t: TestHash|
        {
          key: t.key,
          hash: t.hash,
          uses: t.uses,
          listing: t.listing.map(|l: ListingHash| l.uses),
        }),
    },
    module_record_bin(),
  )

pub type ModuleHashes = { record: Bytes, own: OwnHashes }

derive bin for ModuleHashes

pub fn joined_module_hashes(modules: List<ModuleHashes>) -> OwnHashes =
  joined_own_hashes(modules.map(|m: ModuleHashes| m.own))

const record_domain: Bytes = b"ply.record.2"

pub fn record_digest(record: Bytes) -> Bytes = blake3(record_domain.concat(record))

pub type RecordedGraph = {
  nodes: List<RecordedNode>,
  edges: List<List<Int>>,
  tests: Map<Bytes, RecordedTest>,
  at: Map<Bytes, Int>,
}

pub fn recorded_graph(records: List<ModuleRecord>) -> RecordedGraph / {abort.raise} = {
  let nodes = records.flat_map(|r: ModuleRecord| r.nodes);
  let at = range(0, nodes.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, v: Int| {
    let reference = nodes.get(v).reference;
    accumulator.insert(definition_key(reference.name, reference.kind), v)
  });
  {
    nodes: nodes,
    edges: nodes.map(|n: RecordedNode| places_of(at, n.edges)),
    tests: records.fold(Map::new(), |accumulator: Map<Bytes, RecordedTest>, r: ModuleRecord|
      r.tests.fold(accumulator, |m: Map<Bytes, RecordedTest>, t: RecordedTest| m.insert(t.key, t))),
    at: at,
  }
}

fn places_of(at: Map<Bytes, Int>, refs: List<NodeRef>) -> List<Int> =
  refs.fold([], |accumulator: List<Int>, r: NodeRef|
    match at.get(definition_key(r.name, r.kind)) {
      Some(v) -> accumulator.push(v),
      None -> accumulator,
    })

pub type ReachableHashes = { functions: Map<Bytes, Bytes>, declarations: Map<Bytes, Bytes> }

fn starts_of(g: RecordedGraph, key: Bytes, case: Bool) -> Option<List<Int>> =
  match g.tests.get(key) {
    None -> None,
    Some(t) ->
      Some(
        places_of(g.at, match t.listing {
          Some(listed) -> if case { t.uses } else { t.uses.concat(listed) },
          None -> t.uses,
        }),
      ),
  }

pub fn recorded_reachable_hashes(
  g: RecordedGraph,
  key: Bytes,
  case: Bool,
) -> Option<ReachableHashes> / {abort.raise} =
  match starts_of(g, key, case) {
    None -> None,
    Some(starts) ->
      Some(
        breadth_first({ out: g.edges }, starts).fold(
          { functions: Map::new(), declarations: Map::new() },
          |accumulator: ReachableHashes, v: Int| {
            let n = g.nodes.get(v);
            if is_declared_kind(n.reference.kind) {
              {
                ..accumulator,
                declarations: accumulator.declarations.insert(n.reference.name, n.hash),
              }
            } else {
              { ..accumulator, functions: accumulator.functions.insert(n.reference.name, n.hash) }
            }
          },
        ),
      ),
  }

pub fn recorded_hashes(
  g: RecordedGraph,
  tests: List<{ key: Bytes, case: Bool }>,
) -> List<Bytes> / {abort.raise} = {
  let starts = tests.fold([], |accumulator: List<Int>, t: { key: Bytes, case: Bool }|
    match starts_of(g, t.key, t.case) { Some(vs) -> accumulator.concat(vs), None -> accumulator });
  breadth_first({ out: g.edges }, starts).map(|v: Int| g.nodes.get(v).hash)
}

fn form_nodes(form: Template, seen: NodeOrder) -> NodeOrder / {abort.raise} =
  references(form).fold(seen, add_node)

fn optional_form_nodes(form: Option<Template>, seen: NodeOrder) -> NodeOrder / {abort.raise} =
  match form { Some(f) -> form_nodes(f, seen), None -> seen }

type NodeOrder = { order: List<Int>, at: Map<Int, Int> }

fn add_node(t: NodeOrder, v: Int) -> NodeOrder =
  if t.at.contains(v) { t } else { { order: t.order.push(v), at: t.at.insert(v, t.order.len()) } }

fn renumber(form: Template, ids: Map<Int, Int>) -> Template / {abort.raise} =
  renumbered(form, |v: Int|
    match ids.get(v) {
      Some(k) -> k,
      None -> panic("a template refers to a definition that has no new index"),
    })

fn renumbered_node(f: NodeForm, ids: Map<Int, Int>) -> NodeForm / {abort.raise} =
  {
    form: renumber(f.form, ids),
    signature: f.signature.map(|s: Template| renumber(s, ids)),
    clauses: f.clauses.map(|c: ClauseForm| { ..c, form: renumber(c.form, ids) }),
    transparent: f.transparent,
  }

fn renumbered_item(x: ItemForm, ids: Map<Int, Int>) -> ItemForm / {abort.raise} =
  { form: renumber(x.form, ids), listing: x.listing.map(|l: Template| renumber(l, ids)) }

pub fn module_forms(index: Index, module: Int) -> HashInput / {abort.raise} =
  filtered_forms(index, module, {
    node: |_: Bytes| true,
    test: |_: Bytes| true,
    law: |_: Bytes| true,
  })

pub fn index_forms(index: Index) -> HashInput / {abort.raise} =
  selection_forms(index, {
    own: index.order.fold([], |accumulator: List<Int>, e: IndexEntry|
      match e {
        DefinitionEntry(v) -> match index.nodes.get(v).body {
          NodeElsewhere(_) -> accumulator,
          _ -> accumulator.push(v),
        },
        _ -> accumulator,
      }),
    tests: index.tests,
    laws: index.laws,
    called: None,
  })

pub type ItemFilter = {
  node: (Bytes) -> Bool / {abort.raise},
  test: (Bytes) -> Bool / {abort.raise},
  law: (Bytes) -> Bool / {abort.raise},
}

pub fn filtered_forms(index: Index, module: Int, filter: ItemFilter) -> HashInput / {abort.raise} = {
  let c = module_selection(index, module);
  selection_forms(index, {
    own: c.own.filter(|v: Int| (filter.node)(index.nodes.get(v).name)),
    tests: c.tests.filter(|t: TestNode| (filter.test)(t.key)),
    laws: c.laws.filter(|l: LawNode| (filter.law)(l.key)),
    called: c.called,
  })
}

pub type ModuleSelection = {
  own: List<Int>,
  tests: List<TestNode>,
  laws: List<LawNode>,
  called: Option<Map<CallSite, Choice>>,
}

pub fn module_selection(index: Index, module: Int) -> ModuleSelection / {abort.raise} =
  {
    own: index.order.fold([], |accumulator: List<Int>, e: IndexEntry|
      match e {
        DefinitionEntry(v) -> if index.nodes.get(v).module == module { accumulator.push(v) }
        else { accumulator },
        _ -> accumulator,
      }),
    tests: index.tests.filter(|t: TestNode| t.module == module),
    laws: index.laws.filter(|l: LawNode| l.module == module),
    called: None,
  }

pub fn selection_forms(index: Index, chosen: ModuleSelection) -> HashInput / {abort.raise} = {
  let own = chosen.own;
  let forms = own.map(|v: Int| node_form(index, v, chosen.called));
  let test_forms = chosen.tests.map(|t: TestNode| test_form(index, t, chosen.called));
  let law_forms = chosen.laws.map(|l: LawNode| law_form(index, l));
  let item_nodes = |accumulator: NodeOrder, x: ItemForm|
    optional_form_nodes(x.listing, form_nodes(x.form, accumulator));
  let table = law_forms.fold(
    test_forms.fold(
      forms.fold(
        own.fold({ order: [], at: Map::new() }, add_node),
        |accumulator: NodeOrder, f: NodeForm|
          f.clauses.fold(
            optional_form_nodes(f.signature, form_nodes(f.form, accumulator)),
            |a: NodeOrder, c: ClauseForm| form_nodes(c.form, a),
          ),
      ),
      item_nodes,
    ),
    item_nodes,
  );
  let ids = table.at;
  {
    names: table.order.map(|v: Int| {
      let node = index.nodes.get(v);
      { name: node.name, kind: node_kind(node) }
    }),
    definitions: range(0, own.len()).map(|k: Int|
      { node: k, form: renumbered_node(forms.get(k), ids) }),
    tests: range(0, chosen.tests.len()).map(|i: Int|
      { key: chosen.tests.get(i).key, form: renumbered_item(test_forms.get(i), ids) }),
    laws: range(0, chosen.laws.len()).map(|i: Int|
      { key: chosen.laws.get(i).key, form: renumbered_item(law_forms.get(i), ids) }),
  }
}

pub fn joined_forms(parts: List<HashInput>) -> HashInput / {abort.raise} = {
  let all = parts.fold(
    { at: Map::new(), names: [] },
    |accumulator: { at: Map<Bytes, Int>, names: List<NodeRef> }, part: HashInput|
      part.names.fold(
        accumulator,
        |a: { at: Map<Bytes, Int>, names: List<NodeRef> }, r: NodeRef| {
          let key = definition_key(r.name, r.kind);
          if a.at.contains(key) { a }
          else { { at: a.at.insert(key, a.names.len()), names: a.names.push(r) } }
        },
      ),
  );
  let ids = parts.map(|part: HashInput|
    range(0, part.names.len()).fold(Map::new(), |accumulator: Map<Int, Int>, v: Int| {
      let r = part.names.get(v);
      match all.at.get(definition_key(r.name, r.kind)) {
        Some(k) -> accumulator.insert(v, k),
        None -> panic("a definition of one part is missing from the joined list of names"),
      }
    }));
  let joined = |pick: (HashInput) -> List<HashItem>|
    range(0, parts.len()).fold([], |accumulator: List<HashItem>, k: Int|
      accumulator.concat(
        pick(parts.get(k)).map(|x: HashItem|
          { key: x.key, form: renumbered_item(x.form, ids.get(k)) }),
      ));
  {
    names: all.names,
    definitions: range(0, parts.len()).fold([], |accumulator: List<FormedNode>, k: Int|
      accumulator.concat(
        parts.get(k).definitions.map(|d: FormedNode|
          {
            node: match ids.get(k).get(d.node) {
              Some(w) -> w,
              None -> panic("a defined node is missing from its part's names"),
            },
            form: renumbered_node(d.form, ids.get(k)),
          }),
      )),
    tests: joined(|p: HashInput| p.tests),
    laws: joined(|p: HashInput| p.laws),
  }
}

pub fn node_kind(node: Node) -> HeldKind =
  match node.body {
    NodeFn(_) -> HeldValue,
    NodeType(_) -> HeldType,
    NodeEffect(_) -> HeldEffect,
    NodeElsewhere(e) -> e.kind,
  }

pub fn definition_key(name: Bytes, kind: HeldKind) -> Bytes =
  Bytes::concat(
    match kind { HeldValue -> b"def ", HeldType -> b"type ", HeldEffect -> b"effect " },
    name,
  )

fn append_at(m: Map<Bytes, List<Int>>, key: Bytes, vs: List<Int>) -> Map<Bytes, List<Int>> =
  m.insert(key, List::concat(match m.get(key) { Some(xs) -> xs, None -> [] }, vs))

pub type HashLayout = {
  nodes: List<NodeRef>,
  order: List<IndexEntry>,
  tests: List<{ key: Bytes, cases: Bool }>,
  laws: List<Bytes>,
}

pub fn hash_layout(index: Index) -> HashLayout =
  {
    nodes: index.nodes.filter(declared_here).map(|node: Node|
      { name: node.name, kind: node_kind(node) }),
    order: index.order,
    tests: index.tests.map(|t: TestNode| { key: t.key, cases: t.definition.cases != None }),
    laws: index.laws.map(|l: LawNode| l.key),
  }

fn declared_here(node: Node) -> Bool = match node.body { NodeElsewhere(_) -> false, _ -> true }

type LaidNodes = { nodes: List<NodeRef>, keys: Map<Bytes, Int> }

fn with_referenced(laid: LaidNodes, refs: List<NodeRef>) -> LaidNodes =
  refs.fold(laid, |found: LaidNodes, r: NodeRef| {
    let key = definition_key(r.name, r.kind);
    if found.keys.contains(key) { found }
    else { { nodes: found.nodes.push(r), keys: found.keys.insert(key, found.nodes.len()) } }
  })

pub fn hash_output(sk: HashLayout, own: OwnHashes) -> HashOutput / {abort.raise} = {
  let declared = {
    nodes: sk.nodes,
    keys: range(0, sk.nodes.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, v: Int| {
      let node = sk.nodes.get(v);
      accumulator.insert(definition_key(node.name, node.kind), v)
    }),
  };
  let by_node = own.definitions.fold(
    Map::new(),
    |accumulator: Map<Int, DefinitionHash>, d: DefinitionHash|
      match declared.keys.get(definition_key(d.name, d.kind)) {
        Some(v) -> accumulator.insert(v, d),
        None -> accumulator,
      },
  );
  let tests = own.tests.fold(Map::new(), |accumulator: Map<Bytes, TestHash>, t: TestHash|
    accumulator.insert(t.key, t));
  let laws = own.laws.fold(Map::new(), |accumulator: Map<Bytes, LawHash>, l: LawHash|
    accumulator.insert(l.key, l));
  let laid = sk.order.fold(declared, |found: LaidNodes, e: IndexEntry|
    with_referenced(found, match e {
      DefinitionEntry(v) -> match by_node.get(v) {
        Some(d) -> d.uses.concat(d.clause_uses),
        None -> [],
      },
      TestEntry(i) -> match tests.get(sk.tests.get(i).key) { Some(t) -> test_uses(t), None -> [] },
      LawEntry(i) -> match laws.get(sk.laws.get(i)) { Some(l) -> l.uses, None -> [] },
    }));
  let nodes = laid.nodes;
  let in_layout = |refs: List<NodeRef>|
    refs.map(|r: NodeRef| of_key(laid.keys, definition_key(r.name, r.kind)));
  let tested = sk.tests.fold([], |accumulator: List<TestHash>, t: { key: Bytes, cases: Bool }|
    match tests.get(t.key) { Some(x) -> accumulator.push(x), None -> accumulator });
  let lawful = sk.laws.fold([], |accumulator: List<LawHash>, key: Bytes|
    match laws.get(key) { Some(x) -> accumulator.push(x), None -> accumulator });
  let test_keys = tested.map(|t: TestHash| t.key);
  let law_keys = lawful.map(|l: LawHash| l.key);
  let edges = range(0, nodes.len()).map(|v: Int|
    match by_node.get(v) { Some(d) -> in_layout(d.uses), None -> [] });
  let names_at = |refs: List<Int>| refs.map(|r: Int| nodes.get(r).name);
  let test_refs = tested.map(|t: TestHash| in_layout(test_uses(t)));
  let law_refs = lawful.map(|l: LawHash| in_layout(l.uses));
  let laid_out = {
    definitions: sk.order.fold([], |found: List<DefinitionHash>, e: IndexEntry|
      match e {
        DefinitionEntry(v) -> match by_node.get(v) { Some(d) -> found.push(d), None -> found },
        _ -> found,
      }),
    tests: tested,
    laws: lawful,
  };
  let start: HashOutput = {
    definitions: [],
    declarations: [],
    tests: by_key(test_keys, tested.map(|t: TestHash| t.hash)),
    laws: by_key(law_keys, lawful.map(|l: LawHash| l.hash)),
    specs: [],
    dependencies: [],
    refs: {
      nodes: nodes,
      edges: edges,
      functions: range(0, nodes.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, v: Int| {
        let node = nodes.get(v);
        if node.kind == HeldValue { accumulator.insert(node.name, v) } else { accumulator }
      }),
      declared: range(0, nodes.len()).fold(
        Map::new(),
        |accumulator: Map<Bytes, List<Int>>, v: Int| {
          let node = nodes.get(v);
          if is_declared_kind(node.kind) { append_at(accumulator, node.name, [v]) }
          else { accumulator }
        },
      ),
      items: range(0, lawful.len()).fold(
        range(0, tested.len()).fold(Map::new(), |accumulator: Map<Bytes, List<Int>>, i: Int|
          append_at(accumulator, test_keys.get(i), test_refs.get(i))),
        |accumulator: Map<Bytes, List<Int>>, i: Int|
          append_at(accumulator, law_keys.get(i), law_refs.get(i)),
      ),
      cases: tested.fold(Map::new(), |accumulator: Map<Bytes, List<Int>>, t: TestHash|
        match t.listing {
          Some(_) -> append_at(accumulator, t.key, in_layout(t.uses)),
          None -> accumulator,
        }),
      clauses: range(0, nodes.len()).map(|v: Int|
        match by_node.get(v) { Some(d) -> in_layout(d.clause_uses), None -> [] }),
      listings: tested.fold(Map::new(), |accumulator: Map<Bytes, List<Int>>, t: TestHash|
        match t.listing {
          Some(l) -> append_at(accumulator, t.key, in_layout(l.uses)),
          None -> accumulator,
        }),
    },
    bodies: [],
    test_bodies: by_key(test_keys, tested.map(|t: TestHash| t.body)),
    own: laid_out,
  };
  sk.order.fold(
    { out: start, dependencies_at: Map::new() },
    |accumulator: Recording, e: IndexEntry|
      match e {
        DefinitionEntry(v) -> match by_node.get(v) {
          None -> accumulator,
          Some(d) -> {
            let o = accumulator.out;
            let named = { name: d.name, hash: d.hash };
            let placed: HashOutput = {
              ..o,
              bodies: o.bodies.push({ name: d.name, body: d.body }),
              definitions: if d.kind == HeldValue { o.definitions.push(named) }
              else { o.definitions },
              declarations: if d.kind == HeldValue { o.declarations }
              else { o.declarations.push(named) },
              specs: if d.clauses.len() == 0 { o.specs }
              else { o.specs.push({ name: d.name, hashes: d.clauses }) },
            };
            record({ ..accumulator, out: placed }, d.name, names_at(edges.get(v)))
          },
        },
        TestEntry(i) -> match tests.get(sk.tests.get(i).key) {
          Some(t) -> record(accumulator, t.key, names_at(in_layout(test_uses(t)))),
          None -> accumulator,
        },
        LawEntry(i) -> match laws.get(sk.laws.get(i)) {
          Some(l) -> record(accumulator, l.key, names_at(in_layout(l.uses))),
          None -> accumulator,
        },
      },
  ).out
}

fn by_key<a>(keys: List<Bytes>, xs: List<a>) -> Map<Bytes, a> / {abort.raise} =
  range(0, keys.len()).fold(Map::new(), |accumulator: Map<Bytes, a>, i: Int|
    accumulator.insert(keys.get(i), xs.get(i)))

pub fn own_hashes_of(
  index: Index,
  hashes: HashOutput,
  keep: Set<Bytes>,
) -> OwnHashes / {abort.raise} = {
  let own = hashes.own;
  let bodies = hashes.bodies.fold(
    Map::new(),
    |m: Map<Bytes, FramedBody>, b: { name: Bytes, body: FramedBody }| m.insert(b.name, b.body),
  );
  let defined = own.definitions.fold(
    Map::new(),
    |m: Map<Bytes, DefinitionHash>, d: DefinitionHash| m.insert(definition_key(d.name, d.kind), d),
  );
  let tested = own.tests.fold(Map::new(), |m: Map<Bytes, TestHash>, t: TestHash|
    m.insert(t.key, t));
  let lawful = own.laws.fold(Map::new(), |m: Map<Bytes, LawHash>, l: LawHash| m.insert(l.key, l));
  let kept = |module: Int| keep.contains(index.modules.get(module).name);
  {
    definitions: index.order.fold([], |accumulator: List<DefinitionHash>, e: IndexEntry|
      match e {
        DefinitionEntry(v) -> {
          let node = index.nodes.get(v);
          match if kept(node.module) { defined.get(definition_key(node.name, node_kind(node))) }
            else { None } {
            Some(d) -> accumulator.push({ ..d, body: of_key(bodies, d.name) }),
            None -> accumulator,
          }
        },
        _ -> accumulator,
      }),
    tests: index.tests.fold([], |accumulator: List<TestHash>, t: TestNode|
      if !kept(t.module) { accumulator } else {
        accumulator.push({ ..of_key(tested, t.key), body: of_key(hashes.test_bodies, t.key) })
      }),
    laws: index.laws.fold([], |accumulator: List<LawHash>, l: LawNode|
      if !kept(l.module) { accumulator } else { accumulator.push(of_key(lawful, l.key)) }),
  }
}

fn record(a: Recording, name: Bytes, dependencies: List<Bytes>) -> Recording / {abort.raise} = {
  let out: HashOutput = a.out;
  match a.dependencies_at.get(name) {
    Some(i) -> {
      let existing = out.dependencies.get(i);
      {
        out: {
          ..out,
          dependencies: out.dependencies.set(i, {
            name: name,
            names: dependencies.fold(existing.names, |accumulator: List<Bytes>, d: Bytes|
              if accumulator.contains(d) { accumulator } else { accumulator.push(d) }),
          }),
        },
        dependencies_at: a.dependencies_at,
      }
    },
    None ->
      {
        out: { ..out, dependencies: out.dependencies.push({ name: name, names: dependencies }) },
        dependencies_at: a.dependencies_at.insert(name, out.dependencies.len()),
      },
  }
}

pub type Subject = | FunctionNamed(Bytes) | DeclarationNamed(Bytes) | ItemKeyed(Bytes)

pub type ReachableNames = { functions: Set<Bytes>, declarations: Set<Bytes> }

fn nodes_of(r: Refs, which: Subject) -> List<Int> =
  match which {
    FunctionNamed(name) -> match r.functions.get(name) { Some(v) -> [v], None -> [] },
    DeclarationNamed(name) -> match r.declared.get(name) { Some(vs) -> vs, None -> [] },
    ItemKeyed(key) -> match r.items.get(key) { Some(vs) -> vs, None -> [] },
  }

fn start_nodes(r: Refs, roots: List<Subject>) -> List<Int> =
  roots.fold([], |accumulator: List<Int>, which: Subject| accumulator.concat(nodes_of(r, which)))

fn meanings(key: Bytes) -> List<Subject> =
  [ItemKeyed(key), FunctionNamed(key), DeclarationNamed(key)]

fn reachable_names(r: Refs, nodes: List<Int>) -> ReachableNames / {abort.raise} =
  nodes.fold(
    { functions: Set::empty(), declarations: Set::empty() },
    |accumulator: ReachableNames, v: Int| {
      let node = r.nodes.get(v);
      if is_declared_kind(node.kind) {
        { ..accumulator, declarations: accumulator.declarations.insert(node.name) }
      } else { { ..accumulator, functions: accumulator.functions.insert(node.name) } }
    },
  )

pub fn reach(hashes: HashOutput, roots: List<Subject>) -> ReachableNames / {abort.raise} =
  reachable_names(
    hashes.refs,
    breadth_first({ out: hashes.refs.edges }, start_nodes(hashes.refs, roots)),
  )

pub fn closure_of(hashes: HashOutput, keys: List<Bytes>) -> Set<Bytes> / {abort.raise} = {
  let r = hashes.refs;
  let known = keys.filter(|k: Bytes|
    r.items.contains(k) || r.functions.contains(k) || r.declared.contains(k));
  let reachable = reach(
    hashes,
    known.fold([], |accumulator: List<Subject>, k: Bytes| accumulator.concat(meanings(k))),
  );
  Set::unions([Set::of_list(known), reachable.functions, reachable.declarations])
}

pub fn reachable_functions(hashes: HashOutput, roots: List<Subject>) -> Set<Bytes> / {abort.raise} = {
  let r = hashes.refs;
  unit_reach(r, start_nodes(r, roots))
}

fn unit_reach(r: Refs, starts: List<Int>) -> Set<Bytes> / {abort.raise} = {
  let scheduled = scheduler_module.concat(b".");
  let written = range(0, r.nodes.len()).filter(|v: Int| {
    let node = r.nodes.get(v);
    node.kind == HeldValue && node.name.starts_with(scheduled)
  });
  reachable_names(r, breadth_first({ out: with_clauses(r) }, starts.concat(written))).functions
}

fn with_clauses(r: Refs) -> List<List<Int>> / {abort.raise} =
  range(0, r.edges.len()).map(|v: Int|
    r.edges.get(v).concat(match r.clauses.at(v) { Some(cs) -> cs, None -> [] }))

fn with_tables(r: Refs, which: Subject) -> List<Int> =
  nodes_of(r, which).concat(match which {
    ItemKeyed(key) -> match r.listings.get(key) { Some(vs) -> vs, None -> [] },
    _ -> [],
  })

pub fn used_from(hashes: HashOutput, roots: List<Subject>) -> ReachableNames / {abort.raise} = {
  let r = hashes.refs;
  reachable_names(
    r,
    breadth_first({ out: with_clauses(r) }, roots.flat_map(|which: Subject| with_tables(r, which))),
  )
}

pub fn reachable_by_tests(hashes: HashOutput, keys: List<Bytes>) -> Set<Bytes> / {abort.raise} = {
  let r = hashes.refs;
  unit_reach(
    r,
    keys.fold([], |accumulator: List<Int>, k: Bytes|
      match r.listings.get(k) { Some(vs) -> accumulator.concat(vs), None -> accumulator }),
  )
}

pub fn references_in(hashes: HashOutput, which: Subject) -> List<NodeRef> / {abort.raise} = {
  let r = hashes.refs;
  let direct = match which {
    ItemKeyed(_) -> nodes_of(r, which),
    _ ->
      nodes_of(r, which).fold([], |accumulator: List<Int>, v: Int|
        accumulator.concat(r.edges.get(v))),
  };
  direct.map(|v: Int| r.nodes.get(v))
}

fn back_edges(r: Refs) -> List<List<Int>> / {abort.raise} = {
  let n = r.nodes.len();
  range(0, n).fold(range(0, n).map(|i: Int| []), |accumulator: List<List<Int>>, v: Int|
    r.edges.get(v).fold(accumulator, |a: List<List<Int>>, w: Int| {
      let into = a.get(w);
      a.set(w, []).set(w, into.push(v))
    }))
}

pub type Referrers = { functions: List<Bytes>, declarations: List<Bytes>, items: List<Bytes> }

pub fn find_referrers(
  hashes: HashOutput,
  target: Subject,
  through: Bool,
) -> Referrers / {abort.raise} = {
  let r = hashes.refs;
  let targets = nodes_of(r, target);
  let n = r.nodes.len();
  let marked = Set::of_list(if through { breadth_first({ out: back_edges(r) }, targets) }
  else { targets });
  let any_marked = |vs: List<Int>| vs.any(|v: Int| marked.contains(v));
  let nodes = range(0, n).filter(|v: Int|
    if through { marked.contains(v) && !targets.contains(v) } else { any_marked(r.edges.get(v)) });
  let found = reachable_names(r, nodes);
  {
    functions: found.functions.elements(),
    declarations: found.declarations.elements(),
    items: r.items.fold([], |accumulator: List<Bytes>, key: Bytes, vs: List<Int>|
      if any_marked(vs) { accumulator.push(key) } else { accumulator }),
  }
}

pub type ClosureEntry = { reference: NodeRef, hash: Bytes, refs: List<Int> }

pub fn build_closure(hashes: HashOutput, roots: List<Bytes>) -> List<ClosureEntry> / {abort.raise} = {
  let r = hashes.refs;
  let definitions = by_name(hashes.definitions);
  let declarations = by_name(hashes.declarations);
  let hash_of = |node: NodeRef|
    Map::get(if node.kind == HeldValue { definitions } else { declarations }, node.name);
  let hashed = breadth_first(
    { out: r.edges },
    start_nodes(r, roots.map(|name: Bytes| FunctionNamed(name))),
  ).flat_map(|v: Int|
    match hash_of(r.nodes.get(v)) { Some(hash) -> [{ at: v, hash: hash }], None -> [] });
  let place = range(0, hashed.len()).fold(Map::new(), |accumulator: Map<Int, Int>, i: Int|
    accumulator.insert(hashed.get(i).at, i));
  hashed.map(|h: HashedNode|
    {
      reference: r.nodes.get(h.at),
      hash: h.hash,
      refs: r.edges.get(h.at).fold([], |accumulator: List<Int>, w: Int|
        match place.get(w) { Some(i) -> accumulator.push(i), None -> accumulator }),
    })
}

type HashedNode = { at: Int, hash: Bytes }

pub fn by_name(xs: List<{ name: Bytes, hash: Bytes }>) -> Map<Bytes, Bytes> =
  xs.fold(Map::new(), |m: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
    m.insert(x.name, x.hash))
