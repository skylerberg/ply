pub fn build_index(
  modules: List<ParsedModule>,
  resolved: Resolution,
) -> { index: Index, diagnostics: List<Diagnostic> } / {abort.raise} = {
  let built = range(0, modules.len()).fold(
    { nodes: [], tests: [], laws: [], order: [], items: [], diagnostics: [] },
    |b: IndexBuilder, m: Int| {
      let module = modules.get(m);
      let walked = module.module.items.fold(
        {
          b: b,
          functions: no_declarations([]),
          types: no_declarations([]),
          effects: no_declarations([]),
          constructors: no_declarations([]),
        },
        |s: { b: IndexBuilder, functions: Declarations, types: Declarations, effects: Declarations, constructors: Declarations }, item: Item| {
          let bb: IndexBuilder = s.b;
          match item {
            FunctionItem(d) -> {
              let id = bb.nodes.len();
              let pushed: IndexBuilder = {
                ..bb,
                nodes: bb.nodes.push({
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeFn(d),
                }),
                order: bb.order.push(DefinitionEntry(id)),
              };
              let functions: Declarations = declare(
                { ..s.functions, diagnostics: [] },
                m,
                d.name,
                id,
                b"definition",
              );
              {
                ..s,
                b: { ..pushed, diagnostics: pushed.diagnostics.concat(functions.diagnostics) },
                functions: { ..functions, diagnostics: [] },
              }
            },
            TypeItem(d) -> {
              let id = bb.nodes.len();
              let pushed: IndexBuilder = {
                ..bb,
                nodes: bb.nodes.push({
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeType(d),
                }),
                order: bb.order.push(DefinitionEntry(id)),
              };
              let types: Declarations = declare(
                { ..s.types, diagnostics: [] },
                m,
                d.name,
                id,
                b"type",
              );
              let constructors: Declarations = match d.body {
                SumBody(variants) ->
                  variants.fold(
                    { ..s.constructors, diagnostics: [] },
                    |c: Declarations, variant: VariantDefinition|
                      declare(c, m, variant.name, id, b"variant"),
                  ),
                _ -> { ..s.constructors, diagnostics: [] },
              };
              {
                ..s,
                b: {
                  ..pushed,
                  diagnostics: pushed.diagnostics.concat(types.diagnostics).concat(
                    constructors.diagnostics,
                  ),
                },
                types: { ..types, diagnostics: [] },
                constructors: { ..constructors, diagnostics: [] },
              }
            },
            EffectItem(d) -> {
              let id = bb.nodes.len();
              let pushed: IndexBuilder = {
                ..bb,
                nodes: bb.nodes.push({
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeEffect(d),
                }),
                order: bb.order.push(DefinitionEntry(id)),
              };
              let effects: Declarations = declare(
                { ..s.effects, diagnostics: [] },
                m,
                d.name,
                id,
                b"effect",
              );
              {
                ..s,
                b: { ..pushed, diagnostics: pushed.diagnostics.concat(effects.diagnostics) },
                effects: { ..effects, diagnostics: [] },
              }
            },
            TestItem(d) ->
              {
                ..s,
                b: {
                  ..bb,
                  order: bb.order.push(TestEntry(bb.tests.len())),
                  tests: bb.tests.push({
                    key: qualify(module.name, d.name),
                    module: m,
                    definition: d,
                  }),
                },
              },
            LawItem(d) ->
              {
                ..s,
                b: {
                  ..bb,
                  order: bb.order.push(LawEntry(bb.laws.len())),
                  laws: bb.laws.push({
                    key: qualify(module.name, d.name),
                    module: m,
                    definition: d,
                  }),
                },
              },
            _ -> s,
          }
        },
      );
      let wb: IndexBuilder = walked.b;
      {
        ..wb,
        items: wb.items.push({
          functions: walked.functions.map,
          members: walked.functions.map.fold(
            Map::new(),
            |accumulator: Map<Bytes, List<Int>>, name: Bytes, node: Int|
              match member_of(name) {
                Some(of) ->
                  accumulator.insert(
                    of.member,
                    List::push(
                      match accumulator.get(of.member) { Some(ns) -> ns, None -> [] },
                      node,
                    ),
                  ),
                None -> accumulator,
              },
          ),
          types: walked.types.map,
          effects: walked.effects.map,
          constructors: walked.constructors.map,
          instances: instances_in(module.module.items),
          numerics: module.module.items.fold(
            Map::new(),
            |accumulator: Map<Bytes, NumericDefinition>, item: Item|
              match item {
                NumericItem(d) -> accumulator.insert(d.target.name, d),
                _ -> accumulator,
              },
          ),
        }),
      }
    },
  );
  let scopes = range(0, modules.len()).map(|m: Int| {
    let scope = resolved.scopes.get(m);
    let project = |bindings: List<Binding>|
      bindings.fold(Map::new(), |accumulator: Map<Bytes, Target>, b: Binding|
        accumulator.insert(b.name, {
          owner: b.owner,
          name: simple_of(b.qualified, modules.get(b.owner).name),
        }));
    {
      values: project(scope.bound.values),
      types: project(scope.bound.types),
      effects: project(scope.bound.effects),
      modules: scope.modules.fold(Map::new(), |accumulator: Map<Bytes, Int>, mb: ModuleBinding|
        accumulator.insert(mb.binder, mb.target)),
      visible_modules: match resolved.visible_modules.at(m) { Some(seen) -> seen, None -> [m] },
    }
  });
  let prelude = range(0, modules.len()).filter(|m: Int| modules.get(m).name == prelude_module());
  let index: Index = {
    modules: modules,
    nodes: built.nodes,
    tests: built.tests,
    laws: built.laws,
    order: built.order,
    items: built.items,
    scopes: scopes,
    effect_sketches: Map::new(),
    written: prelude.fold(Map::new(), |accumulator: Map<Bytes, Int>, m: Int|
      emitted_code().calls.concat(emitted_code().insert_calls).fold(
        accumulator,
        |a: Map<Bytes, Int>, n: Bytes|
          match built.items.get(m).functions.get(n) { Some(v) -> a.insert(n, v), None -> a },
      )),
  };
  { index: { ..index, effect_sketches: sketch_effects(index) }, diagnostics: built.diagnostics }
}

fn sketch_effects(index: Index) -> Map<Int, Bytes> / {abort.raise} =
  range(0, index.nodes.len()).fold(Map::new(), |accumulator: Map<Int, Bytes>, v: Int| {
    let node = index.nodes.get(v);
    match node.body {
      NodeEffect(_) ->
        accumulator.insert(
          v,
          fill(node_template(index, node.module, node.name, None, node.body), blank()).bytes,
        ),
      _ -> accumulator,
    }
  })

fn bytes_lt(a: Bytes, b: Bytes) -> Bool = match compare_values(a, b) { Less -> true, _ -> false }

pub fn sort_bytes(xs: List<Bytes>) -> List<Bytes> / {abort.raise} =
  xs.fold([], |accumulator: List<Bytes>, x: Bytes| {
    let n = accumulator.len();
    let i = range(0, n).fold(n, |p: Int, j: Int|
      if p < n { p } else if bytes_lt(x, accumulator.get(j)) { j } else { p });
    accumulator.take(i).push(x).concat(range(i, n).map(|j: Int| accumulator.get(j)))
  })

pub fn listed_refs(index: Index, t: TestNode) -> List<Int> / {abort.raise} =
  match t.definition.cases {
    None -> [],
    Some(c) ->
      expression_references(
        expression_template(
          index,
          t.module,
          case_params(c).map(|p: { name: Identifier, ty: TypeExpression }| p.name),
          test_run(t.definition),
        ),
      ).fold(
        expression_references(expression_template(index, t.module, [], test_listing(c))),
        |accumulator: List<Int>, v: Int|
          if accumulator.contains(v) { accumulator } else { accumulator.push(v) },
      ),
  }

fn spec_domain() -> Bytes = b"ply.spec.1"

fn spec_text_domain() -> Bytes = b"ply.spec.text.1"

fn own_domain() -> Bytes = b"ply.own.1"

fn spec_text_hash(kind: Int, index: Int, normalized: Bytes) -> Bytes / {abort.raise} =
  blake3(Bytes::concat_all([spec_text_domain(), byte_of_int(kind), u32_le(index), normalized]))

fn own_hash(normalized: Bytes) -> Bytes = blake3(own_domain().concat(normalized))

pub fn spec_hash(owner: Bytes, kind: Int, index: Int, normalized: Bytes) -> Bytes / {abort.raise} =
  blake3(Bytes::concat_all([spec_domain(), owner, byte_of_int(kind), u32_le(index), normalized]))

pub fn member_hash(component: Bytes, class: Int) -> Bytes = blake3(component.concat(u32_le(class)))

pub fn encoded_resolutions(picks: List<List<Choice>>) -> Bytes = {
  let inner = Bytes::concat_all(
    picks.map(|p: List<Choice>|
      u32_le(p.len()).concat(
        Bytes::concat_all(
          p.map(|c: Choice|
            u32_le(c.targets.len()).concat(Bytes::concat_all(c.targets.map(u32_le)))),
        ),
      )),
  );
  u32_le(inner.len()).concat(inner)
}

pub fn pending_resolutions_bin() -> bin::BinCodec<List<List<CallResolution>>> =
  bin::list_bin(bin::list_bin(call_resolution_bin()))

fn stored_body(
  class: Option<Int>,
  picks: List<List<CallResolution>>,
  payload: Bytes,
) -> Bytes / {abort.raise} = {
  let head = |kind: Int|
    match class { None -> byte_of_int(kind), Some(c) -> byte_of_int(kind + 1).concat(u32_le(c)) };
  let found = Option::traverse(picks, |member: List<CallResolution>|
    Option::traverse(member, |p: CallResolution|
      match p { Known(c) -> Some(c), Pending(_) -> None }));
  match found {
    Some(choices) -> Bytes::concat_all([head(0), encoded_resolutions(choices), payload]),
    None -> {
      let open = bin::encode(picks, pending_resolutions_bin());
      Bytes::concat_all([head(2), u32_le(open.len()), open, payload])
    },
  }
}

pub type HashOutput = {
  definitions: List<{ name: Bytes, hash: Bytes }>,
  own: List<{ name: Bytes, hash: Bytes }>,
  declarations: List<{ name: Bytes, hash: Bytes }>,
  tests: Map<Bytes, Bytes>,
  laws: Map<Bytes, Bytes>,
  specs: List<{ name: Bytes, hashes: List<Bytes> }>,
  spec_texts: List<{ name: Bytes, hashes: List<Bytes> }>,
  law_texts: Map<Bytes, Bytes>,
  dependencies: List<{ name: Bytes, names: List<Bytes> }>,
  refs: Refs,
  bodies: List<{ name: Bytes, body: Bytes }>,
  test_bodies: Map<Bytes, Bytes>,
  test_texts: Map<Bytes, Bytes>,
  contracts: List<{ name: Bytes, hash: Bytes }>,
  checks: List<{ name: Bytes, hash: Bytes }>,
  spec_checks: List<{ name: Bytes, hashes: List<Bytes> }>,
  test_refs: Map<Bytes, List<Int>>,
  test_runs: Map<Bytes, List<Int>>,
  law_refs: Map<Bytes, List<Int>>,
  component_members: List<List<Int>>,
}

pub type Refs = {
  names: List<Bytes>,
  is_declaration: List<Bool>,
  edges: List<List<Int>>,
  functions: Map<Bytes, Int>,
  declared: Map<Bytes, List<Int>>,
  items: Map<Bytes, List<Int>>,
  cases: Map<Bytes, List<Int>>,
  clauses: List<List<Int>>,
  listings: Map<Bytes, List<Int>>,
}

type Recording = { out: HashOutput, dependencies_at: Map<Bytes, Int> }

pub fn of_key<a>(m: Map<Bytes, a>, key: Bytes) -> a / {abort.raise} =
  match m.get(key) { Some(x) -> x, None -> panic("a key the table does not contain") }

pub fn single_body(f: FilledForm) -> Bytes / {abort.raise} = stored_body(None, [f.chosen], f.bytes)

pub fn member_body(refined: Refinement, class: Int) -> Bytes / {abort.raise} =
  stored_body(Some(class), refined.picks, refined.packed)

type Sccs = { component_of: List<Int>, orders: List<List<Int>> }

fn effect_order(
  shapes: HashInput,
  refs: List<Int>,
  scc: Sccs,
  own: Option<Int>,
  out: List<Int>,
) -> List<Int> / {abort.raise} =
  refs.fold(out, |accumulator: List<Int>, r: Int| {
    let with_effect = if shapes.nodes.get(r).effect { accumulator.push_unique(r) }
    else { accumulator };
    let ci = if r < scc.component_of.len() { scc.component_of.get(r) } else { 0 - 1 };
    if (match own { Some(o) -> o == ci, None -> false }) || ci < 0 || ci >= scc.orders.len() {
      with_effect
    } else { scc.orders.get(ci).fold(with_effect, |a: List<Int>, node: Int| a.push_unique(node)) }
  })

pub type HashNode = {
  name: Bytes,
  declaration: Bool,
  effect: Bool,
  package: Int,
  form: Option<NodeForm>,
}

pub type NodeForm = {
  form: Template,
  signature: Option<Template>,
  clauses: List<ClauseForm>,
  transparent: Bool,
}

pub type ClauseForm = { kind: Int, form: Template }

pub type ItemForm = { form: Template, case_refs: List<Int>, listing: List<Int> }

pub type HashItem = { key: Bytes, form: Option<ItemForm> }

pub type HashInput = {
  nodes: List<HashNode>,
  order: List<Int>,
  tests: List<HashItem>,
  laws: List<HashItem>,
}

derive bin for ClauseForm

derive bin for NodeForm

derive bin for HashNode

derive bin for ItemForm

derive bin for HashItem

derive bin for HashInput

fn has_no_form(shape: HashNode) -> Bool = match shape.form { None -> true, Some(_) -> false }

type HashContext = { shapes: HashInput, names: List<Bytes>, graph: Graph }

fn form_of(over: HashContext, v: Int) -> Template / {abort.raise} =
  match over.shapes.nodes.get(v).form {
    Some(f) -> f.form,
    None -> panic("a node being hashed again has no template to compute its hash from"),
  }

fn filled_under(
  over: HashContext,
  form: Template,
  hashes: Map<Int, Bytes>,
  effects: Map<Int, Int>,
  by_name: Bool,
) -> FilledForm / {abort.raise} =
  fill(form, {
    hashes: hashes,
    component: Map::new(),
    effects: effects,
    by_name: by_name,
    names: over.names,
  })

fn slots_of(over: HashContext, form: Template) -> Map<Int, Int> / {abort.raise} =
  slots_under(over, references(form))

fn slots_under(over: HashContext, referenced: List<Int>) -> Map<Int, Int> / {abort.raise} =
  positions(effect_order(over.shapes, referenced, over.graph.scc, None, []))

fn filled_item(
  over: HashContext,
  form: Template,
  hashes: Map<Int, Bytes>,
  by_name: Bool,
) -> FilledForm / {abort.raise} = filled_under(over, form, hashes, slots_of(over, form), by_name)

fn sketch_lt(a: Bytes, ia: Int, b: Bytes, ib: Int) -> Bool = bytes_lt(a, b) || (a == b && ia < ib)

type Refinement = {
  members: List<{ node: Int, hash: Bytes }>,
  packed: Bytes,
  picks: List<List<CallResolution>>,
  classes: Map<Int, Int>,
}

fn hash_component(
  over: HashContext,
  component: List<Int>,
  hashes: Map<Int, Bytes>,
  effects: Map<Int, Int>,
) -> Refinement / {abort.raise} = {
  let encode = |classes: Map<Int, Int>, v: Int|
    fill(form_of(over, v), {
      hashes: hashes,
      component: classes,
      effects: effects,
      by_name: false,
      names: over.names,
    });
  let relabel = |finished: List<FilledForm>| {
    let encodings = finished.map(|f: FilledForm| f.bytes);
    let distinct = dedup_sorted(sort_bytes(encodings));
    range(0, component.len()).fold(Map::new(), |accumulator: Map<Int, Int>, i: Int|
      accumulator.insert(component.get(i), position_bytes(distinct, encodings.get(i))))
  };
  let grouping = |classes: Map<Int, Int>|
    sort_groups(
      component.fold(Map::new(), |accumulator: Map<Int, List<Int>>, v: Int| {
        let c = match classes.get(v) { Some(x) -> x, None -> 0 };
        accumulator.insert(c, List::push(match accumulator.get(c) { Some(g) -> g, None -> [] }, v))
      }),
    );
  let start = component.fold(Map::new(), |accumulator: Map<Int, Int>, v: Int|
    accumulator.insert(v, 0));
  let resolved = iterate(
    { classes: start, encodings: component.map(|v: Int| encode(start, v)) },
    component.len() + 2,
    |s: { classes: Map<Int, Int>, encodings: List<FilledForm> }| {
      let next = relabel(s.encodings);
      let same = grouping(next) == grouping(s.classes);
      let re = { classes: next, encodings: component.map(|v: Int| encode(next, v)) };
      if same { Stop(re) } else { Continue(re) }
    },
  );
  let width = component.fold(0, |accumulator: Int, v: Int|
      max(accumulator, match resolved.classes.get(v) { Some(c) -> c, None -> 0 }))
    + 1;
  let by_class = range(0, component.len()).fold(
    range(0, width).map(|i: Int| { bytes: b"", chosen: [] }),
    |accumulator: List<FilledForm>, i: Int|
      accumulator.set(
        match resolved.classes.get(component.get(i)) { Some(c) -> c, None -> 0 },
        resolved.encodings.get(i),
      ),
  );
  let packed = u32_le(by_class.len()).concat(
    Bytes::concat_all(by_class.map(|m: FilledForm| u32_le(m.bytes.len()).concat(m.bytes))),
  );
  let component_hash = blake3(packed);
  {
    members: component.map(|v: Int|
      {
        node: v,
        hash: member_hash(component_hash, match resolved.classes.get(v) {
          Some(c) -> c,
          None -> 0,
        }),
      }),
    packed: packed,
    picks: by_class.map(|m: FilledForm| m.chosen),
    classes: resolved.classes,
  }
}

fn dedup_sorted(xs: List<Bytes>) -> List<Bytes> / {abort.raise} =
  xs.fold([], |accumulator: List<Bytes>, x: Bytes|
    if accumulator.len() > 0 && accumulator.get(accumulator.len() - 1) == x { accumulator }
    else { accumulator.push(x) })

fn position_bytes(xs: List<Bytes>, v: Bytes) -> Int / {abort.raise} =
  range(0, xs.len()).fold(0, |accumulator: Int, i: Int|
    if xs.get(i) == v { i } else { accumulator })

fn sort_groups(groups: Map<Int, List<Int>>) -> List<List<Int>> / {abort.raise} = {
  let out = groups.fold([], |accumulator: List<List<Int>>, k: Int, g: List<Int>|
    accumulator.push(sort_ints(g)));
  out.fold([], |accumulator: List<List<Int>>, g: List<Int>| {
    let n = accumulator.len();
    let i = range(0, n).fold(n, |p: Int, j: Int|
      if p < n { p } else if ints_lt(g, accumulator.get(j)) { j } else { p });
    accumulator.take(i).push(g).concat(range(i, n).map(|j: Int| accumulator.get(j)))
  })
}

fn sort_ints(xs: List<Int>) -> List<Int> / {abort.raise} =
  xs.fold([], |accumulator: List<Int>, x: Int| {
    let n = accumulator.len();
    let i = range(0, n).fold(n, |p: Int, j: Int|
      if p < n { p } else if x < accumulator.get(j) { j } else { p });
    accumulator.take(i).push(x).concat(range(i, n).map(|j: Int| accumulator.get(j)))
  })

fn ints_lt(a: List<Int>, b: List<Int>) -> Bool =
  match compare_values(a, b) { Less -> true, _ -> false }

type SpecHashes = {
  own: List<{ name: Bytes, hash: Bytes }>,
  specs: List<{ name: Bytes, hashes: List<Bytes> }>,
  spec_texts: List<{ name: Bytes, hashes: List<Bytes> }>,
  spec_checks: List<{ name: Bytes, hashes: List<Bytes> }>,
}

type HashTables = {
  hashes: Map<Int, Bytes>,
  bodies: Map<Int, Bytes>,
  tests: List<Bytes>,
  test_bodies: List<Bytes>,
  test_texts: List<Bytes>,
  test_refs: List<List<Int>>,
  test_runs: List<List<Int>>,
  laws: List<Bytes>,
  law_refs: List<List<Int>>,
  law_texts: List<Bytes>,
  own: List<{ name: Bytes, hash: Bytes }>,
  specs: List<{ name: Bytes, hashes: List<Bytes> }>,
  spec_texts: List<{ name: Bytes, hashes: List<Bytes> }>,
  contracts: Map<Int, Bytes>,
  checks: Map<Int, Bytes>,
  spec_checks: List<{ name: Bytes, hashes: List<Bytes> }>,
  enumerations: List<List<Int>>,
  clauses: List<List<Int>>,
  test_listings: List<List<Int>>,
}

type TestHashes = {
  hashes: List<Bytes>,
  bodies: List<Bytes>,
  texts: List<Bytes>,
  refs: List<List<Int>>,
  runs: List<List<Int>>,
  listings: List<List<Int>>,
}

type ComponentKeys = { hashes: Map<Int, Bytes>, bodies: Map<Int, Bytes>, computed: Map<Int, Bytes> }

type Graph = { edges: List<List<Int>>, components: List<List<Int>>, scc: Sccs }

pub type FirstPass = { sketch: Bytes, references: List<Int> }

fn first_pass_of(shapes: HashInput, fixed: Map<Int, List<Int>>) -> List<FirstPass> / {abort.raise} =
  range(0, shapes.nodes.len()).map(|v: Int| {
    let edges = fixed.get(v);
    match shapes.nodes.get(v).form {
      None -> { sketch: b"", references: match edges { Some(es) -> es, None -> [] } },
      Some(f) ->
        {
          sketch: fill(f.form, blank()).bytes,
          references: match edges { Some(es) -> es, None -> references(f.form) },
        },
    }
  })

fn node_form(
  index: Index,
  v: Int,
  chose: Option<Map<CallSite, Choice>>,
) -> NodeForm / {abort.raise} = {
  let node = index.nodes.get(v);
  let form = node_template(index, node.module, node.name, chose, node.body);
  match node.body {
    NodeFn(d) ->
      {
        form: form,
        signature: Some(
          node_template(
            index,
            node.module,
            node.name,
            None,
            NodeFn({ ..d, body: LiteralExpression({ span: d.name.span, literal: LiteralUnit }) }),
          ),
        ),
        clauses: d.spec.map(|clause: SpecClause|
          { kind: spec_tag(clause.kind), form: spec_template(index, node.module, d, clause) }),
        transparent: d.transparent != None,
      },
    _ -> { form: form, signature: None, clauses: [], transparent: false },
  }
}

fn test_form(
  index: Index,
  t: TestNode,
  chose: Option<Map<CallSite, Choice>>,
) -> ItemForm / {abort.raise} =
  {
    form: test_template(
      index,
      t.module,
      test_owner(index.modules.get(t.module).name, t.definition.name),
      chose,
      t.definition,
    ),
    case_refs: listed_refs(index, t),
    listing: match t.definition.cases {
      Some(c) -> expression_references(expression_template(index, t.module, [], test_listing(c))),
      None -> [],
    },
  }

fn law_form(index: Index, l: LawNode) -> ItemForm / {abort.raise} =
  { form: law_template(index, l.module, l.definition), case_refs: [], listing: [] }

type Shaped = { shapes: HashInput, first: List<FirstPass> }

pub fn hash_input(
  index: Index,
  packages: List<Int>,
  fixed: Map<Int, List<Int>>,
  fixing: CachedHashes,
) -> Shaped / {abort.raise} = {
  let held_tests = fixing.tests.fold(Map::new(), |accumulator: Map<Bytes, Bool>, t: CachedTest|
    accumulator.insert(t.key, true));
  let held_laws = fixing.laws.fold(Map::new(), |accumulator: Map<Bytes, Bool>, l: CachedLaw|
    accumulator.insert(l.key, true));
  let shape = |v: Int, formed: Bool| {
    let node = index.nodes.get(v);
    {
      name: node.name,
      declaration: is_declaration(node),
      effect: is_effect(index, v),
      package: match packages.at(node.module) { Some(p) -> p, None -> 0 },
      form: if formed { Some(node_form(index, v, None)) } else { None },
    }
  };
  let plain = {
    nodes: range(0, index.nodes.len()).map(|v: Int| shape(v, !fixed.contains(v))),
    order: index.order.fold([], |accumulator: List<Int>, e: IndexEntry|
      match e { DefinitionEntry(v) -> accumulator.push(v), _ -> accumulator }),
    tests: index.tests.map(|t: TestNode|
      {
        key: t.key,
        form: if held_tests.contains(t.key) { None } else { Some(test_form(index, t, None)) },
      }),
    laws: index.laws.map(|l: LawNode|
      {
        key: l.key,
        form: if held_laws.contains(l.key) { None } else { Some(law_form(index, l)) },
      }),
  };
  let first = first_pass_of(plain, fixed);
  let cyclic = if fixed.len() == 0 { Map::new() } else {
    graph::components({ out: first.map(|f: FirstPass| f.references) }).fold(
      Map::new(),
      |accumulator: Map<Int, Bool>, c: List<Int>|
        if c.len() < 2 || c.fold(true, |all: Bool, v: Int| all && fixed.contains(v)) { accumulator }
        else {
          c.fold(accumulator, |a: Map<Int, Bool>, v: Int|
            if fixed.contains(v) { a.insert(v, true) } else { a })
        },
    )
  };
  if cyclic.len() == 0 { { shapes: plain, first: first } } else {
    let shapes = {
      ..plain,
      nodes: range(0, index.nodes.len()).map(|v: Int|
        if cyclic.contains(v) { shape(v, true) } else { plain.nodes.get(v) }),
    };
    { shapes: shapes, first: first_pass_of(shapes, fixed) }
  }
}

pub fn hash_context(index: Index) -> HashContext / {abort.raise} = {
  let shaped = hash_input(index, [], Map::new(), no_cached_hashes());
  {
    shapes: shaped.shapes,
    names: shaped.shapes.nodes.map(|s: HashNode| s.name),
    graph: graph_with(shaped.shapes, shaped.first, Map::new()),
  }
}

fn graph_with(
  shapes: HashInput,
  first: List<FirstPass>,
  carried: Map<Int, List<Int>>,
) -> Graph / {abort.raise} = {
  let n = shapes.nodes.len();
  let edges = first.map(|f: FirstPass| f.references);
  let sketches = first.map(|f: FirstPass| f.sketch);
  let components = graph::components({ out: edges }).map(|c: List<Int>| c.reverse());
  let component_of = range(0, components.len()).fold(
    range(0, n).map(|i: Int| 0 - 1),
    |accumulator: List<Int>, ci: Int|
      components.get(ci).fold(accumulator, |a: List<Int>, v: Int| a.set(v, ci)),
  );
  let orders = range(0, components.len()).fold([], |accumulator: List<List<Int>>, ci: Int| {
    let members = components.get(ci).fold([], |ms: List<Int>, v: Int| {
      let k = ms.len();
      let i = range(0, k).fold(k, |p: Int, j: Int|
        if p < k { p }
        else if sketch_lt(sketches.get(v), v, sketches.get(ms.get(j)), ms.get(j)) { j }
        else { p });
      ms.take(i).push(v).concat(range(i, k).map(|j: Int| ms.get(j)))
    });
    let scc = { component_of: component_of, orders: accumulator };
    let carried_order = match members {
      [first_member, ..] -> if members.fold(true, |all: Bool, v: Int| all && carried.contains(v)) {
        carried.get(first_member)
      } else { None },
      [] -> None,
    };
    accumulator.push(match carried_order {
      Some(order) -> order,
      None ->
        members.fold([], |o: List<Int>, v: Int|
          effect_order(shapes, edges.get(v), scc, Some(ci), o)),
    })
  });
  { edges: edges, components: components, scc: { component_of: component_of, orders: orders } }
}

fn key_components(
  over: HashContext,
  pinned: Map<Int, Bytes>,
  cached: Map<Int, CachedNode>,
) -> ComponentKeys / {abort.raise} =
  range(0, over.graph.components.len()).fold(
    { hashes: Map::new(), bodies: Map::new(), computed: Map::new() },
    |accumulator: ComponentKeys, ci: Int| {
      let component = over.graph.components.get(ci);
      if component.fold(true, |all: Bool, v: Int|
          all && (cached.contains(v) || has_no_form(over.shapes.nodes.get(v)))) {
        component.fold(accumulator, |a: ComponentKeys, v: Int|
          match cached.get(v) {
            None -> a,
            Some(f) ->
              {
                hashes: a.hashes.insert(v, f.hash),
                bodies: a.bodies.insert(v, f.body),
                computed: a.computed.insert(v, f.hash),
              },
          })
      } else { key_component(over, pinned, accumulator, ci, component) }
    },
  )

fn key_component(
  over: HashContext,
  pinned: Map<Int, Bytes>,
  accumulator: ComponentKeys,
  ci: Int,
  component: List<Int>,
) -> ComponentKeys / {abort.raise} = {
  let effects = positions(over.graph.scc.orders.get(ci));
  let own: ComponentKeys = if is_cyclic(component, over.graph.edges) {
    let refined: Refinement = hash_component(over, component, accumulator.hashes, effects);
    refined.members.fold(accumulator, |a: ComponentKeys, m: { node: Int, hash: Bytes }| {
      let class = match refined.classes.get(m.node) { Some(c) -> c, None -> 0 };
      {
        ..a,
        computed: a.computed.insert(m.node, m.hash),
        bodies: a.bodies.insert(m.node, member_body(refined, class)),
      }
    })
  } else {
    let v = component.get(0);
    let encoding = filled_under(over, form_of(over, v), accumulator.hashes, effects, false);
    {
      ..accumulator,
      computed: accumulator.computed.insert(v, blake3(encoding.bytes)),
      bodies: accumulator.bodies.insert(v, single_body(encoding)),
    }
  };
  {
    ..own,
    hashes: component.fold(own.hashes, |h: Map<Int, Bytes>, v: Int|
      match pinned.get(v) {
        Some(x) -> h.insert(v, x),
        None -> match own.computed.get(v) { Some(x) -> h.insert(v, x), None -> h },
      }),
  }
}

pub type NodeRef = { name: Bytes, declaration: Bool }

pub type CachedNode = {
  name: Bytes,
  declaration: Bool,
  hash: Bytes,
  own: Option<Bytes>,
  specs: List<Bytes>,
  spec_texts: List<Bytes>,
  spec_checks: List<Bytes>,
  contract: Bytes,
  check: Bytes,
  body: Bytes,
  edges: List<NodeRef>,
  effects: List<NodeRef>,
  clauses: List<NodeRef>,
}

pub type CachedTest = {
  key: Bytes,
  hash: Bytes,
  body: Bytes,
  text: Bytes,
  refs: List<NodeRef>,
  runs: List<NodeRef>,
  listing: List<NodeRef>,
}

pub type CachedLaw = { key: Bytes, hash: Bytes, text: Bytes, refs: List<NodeRef> }

pub type CachedHashes = { nodes: List<CachedNode>, tests: List<CachedTest>, laws: List<CachedLaw> }

pub fn no_cached_hashes() -> CachedHashes = { nodes: [], tests: [], laws: [] }

derive bin for NodeRef

derive bin for CachedNode

derive bin for CachedTest

derive bin for CachedLaw

derive bin for CachedHashes

pub type ModuleRecord = { nodes: List<RecordedNode>, tests: List<RecordedTest> }

pub type RecordedNode = { name: Bytes, declaration: Bool, hash: Bytes, edges: List<NodeRef> }

pub type RecordedTest = { key: Bytes, hash: Bytes, refs: List<NodeRef>, runs: List<NodeRef> }

derive bin for RecordedNode

derive bin for RecordedTest

derive bin for ModuleRecord

pub fn module_record(fixing: CachedHashes) -> Bytes / {abort.raise} =
  bin::encode(
    {
      nodes: fixing.nodes.map(|f: CachedNode|
        { name: f.name, declaration: f.declaration, hash: f.hash, edges: f.edges }),
      tests: fixing.tests.map(|t: CachedTest|
        { key: t.key, hash: t.hash, refs: t.refs, runs: t.runs }),
    },
    module_record_bin(),
  )

pub type ModuleHashes = { record: Bytes, cached: CachedHashes }

pub fn joined_cached_hashes(modules: List<ModuleHashes>) -> CachedHashes =
  modules.fold(no_cached_hashes(), |accumulator: CachedHashes, m: ModuleHashes|
    {
      nodes: accumulator.nodes.concat(m.cached.nodes),
      tests: accumulator.tests.concat(m.cached.tests),
      laws: accumulator.laws.concat(m.cached.laws),
    })

fn record_domain() -> Bytes = b"ply.record.1"

pub fn record_digest(record: Bytes) -> Bytes = blake3(record_domain().concat(record))

pub type RecordedGraph = {
  nodes: List<RecordedNode>,
  edges: List<List<Int>>,
  tests: Map<Bytes, RecordedTest>,
  at: Map<Bytes, Int>,
}

pub fn recorded_graph(records: List<ModuleRecord>) -> RecordedGraph / {abort.raise} = {
  let nodes = records.flat_map(|r: ModuleRecord| r.nodes);
  let at = range(0, nodes.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, v: Int|
    accumulator.insert(definition_key(nodes.get(v).name, nodes.get(v).declaration), v));
  {
    nodes: nodes,
    edges: nodes.map(|n: RecordedNode| places_of(at, n.edges)),
    tests: records.fold(Map::new(), |accumulator: Map<Bytes, RecordedTest>, r: ModuleRecord|
      r.tests.fold(accumulator, |m: Map<Bytes, RecordedTest>, t: RecordedTest| m.insert(t.key, t))),
    at: at,
  }
}

fn places_of(at: Map<Bytes, Int>, refs: List<NodeRef>) -> List<Int> =
  refs.fold([], |accumulator: List<Int>, r: NodeRef|
    match at.get(definition_key(r.name, r.declaration)) {
      Some(v) -> accumulator.push(v),
      None -> accumulator,
    })

pub type ReachableHashes = { functions: Map<Bytes, Bytes>, declarations: Map<Bytes, Bytes> }

fn starts_of(g: RecordedGraph, key: Bytes, case: Bool) -> Option<List<Int>> =
  match g.tests.get(key) {
    None -> None,
    Some(t) -> Some(places_of(g.at, if case { t.runs } else { t.refs })),
  }

pub fn recorded_reachable_hashes(
  g: RecordedGraph,
  key: Bytes,
  case: Bool,
) -> Option<ReachableHashes> / {abort.raise} =
  match starts_of(g, key, case) {
    None -> None,
    Some(starts) ->
      Some(
        walk(g.edges, starts).fold(
          { functions: Map::new(), declarations: Map::new() },
          |accumulator: ReachableHashes, v: Int| {
            let n = g.nodes.get(v);
            if n.declaration {
              { ..accumulator, declarations: accumulator.declarations.insert(n.name, n.hash) }
            } else { { ..accumulator, functions: accumulator.functions.insert(n.name, n.hash) } }
          },
        ),
      ),
  }

pub fn recorded_hashes(
  g: RecordedGraph,
  tests: List<{ key: Bytes, case: Bool }>,
) -> List<Bytes> / {abort.raise} = {
  let starts = tests.fold([], |accumulator: List<Int>, t: { key: Bytes, case: Bool }|
    match starts_of(g, t.key, t.case) { Some(vs) -> accumulator.concat(vs), None -> accumulator });
  walk(g.edges, starts).map(|v: Int| g.nodes.get(v).hash)
}

fn hash_node_keys(shapes: HashInput) -> Map<Bytes, Int> / {abort.raise} =
  range(0, shapes.nodes.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, v: Int| {
    let s = shapes.nodes.get(v);
    accumulator.insert(definition_key(s.name, s.declaration), v)
  })

pub fn hash_all(
  shapes: HashInput,
  first: List<FirstPass>,
  cached: Map<Int, CachedNode>,
  fixing: CachedHashes,
) -> { graph: Graph, hashed: HashTables } / {abort.raise} = {
  let keys = hash_node_keys(shapes);
  let held_tests = fixing.tests.fold(
    Map::new(),
    |accumulator: Map<Bytes, CachedTest>, t: CachedTest| accumulator.insert(t.key, t),
  );
  let held_laws = fixing.laws.fold(
    Map::new(),
    |accumulator: Map<Bytes, CachedLaw>, l: CachedLaw| accumulator.insert(l.key, l),
  );
  let present = |refs: List<NodeRef>|
    refs.fold([], |es: List<Int>, r: NodeRef|
      match keys.get(definition_key(r.name, r.declaration)) { Some(w) -> es.push(w), None -> es });
  let g = graph_with(
    shapes,
    first,
    cached.fold(Map::new(), |accumulator: Map<Int, List<Int>>, v: Int, f: CachedNode|
      accumulator.insert(v, present(f.effects))),
  );
  let over = { shapes: shapes, names: shapes.nodes.map(|s: HashNode| s.name), graph: g };
  let pinned = cached.fold(Map::new(), |accumulator: Map<Int, Bytes>, v: Int, f: CachedNode|
    accumulator.insert(v, f.hash));
  let keyed = key_components(over, pinned, cached);
  let hashes = keyed.hashes;
  let check_keys = check_key_components(over, cached, hashes);
  let contracts = range(0, shapes.nodes.len()).fold(
    Map::new(),
    |accumulator: Map<Int, Bytes>, v: Int|
      if shapes.nodes.get(v).declaration { accumulator } else {
        let fixed_contract = match cached.get(v) { Some(f) -> f.contract, None -> b"" };
        accumulator.insert(v, if fixed_contract.len() > 0 { fixed_contract } else {
          match check_keys.contracts.get(v) {
            Some(c) -> c,
            None -> contract_of(over, cached, hashes, v),
          }
        })
      },
  );
  let tests = shapes.tests.fold(
    { hashes: [], bodies: [], texts: [], refs: [], runs: [], listings: [] },
    |accumulator: TestHashes, t: HashItem|
      match t.form {
        None -> match held_tests.get(t.key) {
          Some(x) ->
            {
              hashes: accumulator.hashes.push(x.hash),
              bodies: accumulator.bodies.push(x.body),
              texts: accumulator.texts.push(x.text),
              refs: accumulator.refs.push(present(x.refs)),
              runs: accumulator.runs.push(present(x.runs)),
              listings: accumulator.listings.push(present(x.listing)),
            },
          None -> panic("a test has no template to hash and no cached hash"),
        },
        Some(form) -> {
          let referenced = references(form.form);
          let effects = slots_under(over, referenced);
          let f: FilledForm = filled_under(over, form.form, hashes, effects, false);
          let text: FilledForm = filled_under(over, form.form, hashes, effects, true);
          {
            hashes: accumulator.hashes.push(blake3(f.bytes)),
            bodies: accumulator.bodies.push(single_body(f)),
            texts: accumulator.texts.push(own_hash(text.bytes)),
            refs: accumulator.refs.push(
              form.case_refs.fold(referenced, |rs: List<Int>, r: Int| rs.push_unique(r)),
            ),
            runs: accumulator.runs.push(referenced),
            listings: accumulator.listings.push(form.listing),
          }
        },
      },
  );
  let laws = shapes.laws.fold(
    { hashes: [], refs: [], texts: [] },
    |accumulator: { hashes: List<Bytes>, refs: List<List<Int>>, texts: List<Bytes> }, l: HashItem|
      match l.form {
        None -> match held_laws.get(l.key) {
          Some(x) ->
            {
              hashes: accumulator.hashes.push(x.hash),
              refs: accumulator.refs.push(present(x.refs)),
              texts: accumulator.texts.push(x.text),
            },
          None -> panic("a law has no template to hash and no cached hash"),
        },
        Some(form) -> {
          let referenced = references(form.form);
          let effects = slots_under(over, referenced);
          let f: FilledForm = filled_under(over, form.form, hashes, effects, false);
          let text: FilledForm = filled_under(over, form.form, hashes, effects, true);
          {
            hashes: accumulator.hashes.push(blake3(f.bytes)),
            refs: accumulator.refs.push(referenced),
            texts: accumulator.texts.push(spec_text_hash(0, 0, text.bytes)),
          }
        },
      },
  );
  let stated = shapes.order.fold(
    { own: [], specs: [], spec_texts: [], spec_checks: [] },
    |accumulator: SpecHashes, v: Int|
      match cached.get(v) {
        Some(f) -> cached_spec_hashes(accumulator, shapes.nodes.get(v).name, f),
        None ->
          computed_spec_hashes(
            over,
            hashes,
            reference_keys(over, cached, hashes, check_keys, v).view,
            check_keys.checks,
            accumulator,
            v,
            first.get(v).references,
          ),
      },
  );
  {
    graph: g,
    hashed: {
      hashes: hashes,
      bodies: keyed.bodies,
      tests: tests.hashes,
      test_bodies: tests.bodies,
      test_texts: tests.texts,
      test_refs: tests.refs,
      test_runs: tests.runs,
      laws: laws.hashes,
      law_refs: laws.refs,
      law_texts: laws.texts,
      own: stated.own,
      specs: stated.specs,
      spec_texts: stated.spec_texts,
      contracts: contracts,
      checks: check_keys.checks,
      spec_checks: stated.spec_checks,
      enumerations: range(0, shapes.nodes.len()).map(|v: Int| {
        let ci = g.scc.component_of.get(v);
        if ci < 0 { [] } else { g.scc.orders.get(ci) }
      }),
      clauses: range(0, shapes.nodes.len()).map(|v: Int|
        match shapes.nodes.get(v).form {
          Some(form) ->
            form.clauses.fold([], |accumulator: List<Int>, c: ClauseForm|
              accumulator.concat(references(c.form))),
          None -> match cached.get(v) { Some(f) -> present(f.clauses), None -> [] },
        }),
      test_listings: tests.listings,
    },
  }
}

fn contract_domain() -> Bytes = b"ply.contract.1"

pub fn contract_of(
  over: HashContext,
  cached: Map<Int, CachedNode>,
  hashes: Map<Int, Bytes>,
  v: Int,
) -> Bytes / {abort.raise} = {
  let shape = over.shapes.nodes.get(v);
  let hash = match hashes.get(v) { Some(h) -> h, None -> b"" };
  if shape.declaration { hash } else {
    match shape.form {
      None -> match cached.get(v) { Some(f) -> f.contract, None -> hash },
      Some(form) -> {
        let signature = match form.signature {
          Some(s) -> filled_item(over, s, hashes, false).bytes,
          None -> b"",
        };
        let clauses = form.clauses.map(|clause: ClauseForm|
          filled_item(over, clause.form, hashes, false).bytes);
        let body = if form.transparent { b"transparent".concat(hash) } else { b"" };
        blake3(Bytes::concat_all([contract_domain(), signature, Bytes::concat_all(clauses), body]))
      },
    }
  }
}

type CheckKeys = { checks: Map<Int, Bytes>, contracts: Map<Int, Bytes> }

type Viewed = { check_keys: CheckKeys, view: Map<Int, Bytes> }

fn reference_keys(
  over: HashContext,
  cached: Map<Int, CachedNode>,
  hashes: Map<Int, Bytes>,
  check_keys: CheckKeys,
  v: Int,
) -> Viewed / {abort.raise} = {
  let own = over.shapes.nodes.get(v).package;
  over.graph.edges.get(v).fold(
    { check_keys: check_keys, view: Map::new() },
    |accumulator: Viewed, r: Int|
      if over.shapes.nodes.get(r).package != own {
        match accumulator.check_keys.contracts.get(r) {
          Some(c) -> { ..accumulator, view: accumulator.view.insert(r, c) },
          None -> {
            let c = contract_of(over, cached, hashes, r);
            {
              check_keys: {
                ..accumulator.check_keys,
                contracts: accumulator.check_keys.contracts.insert(r, c),
              },
              view: accumulator.view.insert(r, c),
            }
          },
        }
      } else {
        match accumulator.check_keys.checks.get(r) {
          Some(x) -> { ..accumulator, view: accumulator.view.insert(r, x) },
          None -> match hashes.get(r) {
            Some(x) -> { ..accumulator, view: accumulator.view.insert(r, x) },
            None -> accumulator,
          },
        }
      },
  )
}

fn check_key_components(
  over: HashContext,
  cached: Map<Int, CachedNode>,
  hashes: Map<Int, Bytes>,
) -> CheckKeys / {abort.raise} =
  range(0, over.graph.components.len()).fold(
    { checks: Map::new(), contracts: Map::new() },
    |accumulator: CheckKeys, ci: Int| {
      let component = over.graph.components.get(ci);
      let keep = |keys: CheckKeys|
        component.fold(keys, |k: CheckKeys, v: Int|
          match hashes.get(v) { Some(h) -> { ..k, checks: k.checks.insert(v, h) }, None -> k });
      if component.fold(true, |all: Bool, v: Int|
          all && (cached.contains(v) || has_no_form(over.shapes.nodes.get(v)))) {
        component.fold(accumulator, |k: CheckKeys, v: Int|
          match cached.get(v) {
            Some(f) -> { ..k, checks: k.checks.insert(v, f.check) },
            None -> k,
          })
      } else {
        let gathered = component.fold(
          { check_keys: accumulator, view: Map::new() },
          |a: Viewed, v: Int| {
            let x = reference_keys(over, cached, hashes, a.check_keys, v);
            {
              check_keys: x.check_keys,
              view: x.view.fold(a.view, |m: Map<Int, Bytes>, r: Int, k: Bytes|
                if over.graph.scc.component_of.get(r) == ci { m } else { m.insert(r, k) }),
            }
          },
        );
        if gathered.view.fold(true, |all: Bool, r: Int, k: Bytes| all && hashes.get(r) == Some(k)) {
          keep(gathered.check_keys)
        } else {
          let effects = positions(over.graph.scc.orders.get(ci));
          if is_cyclic(component, over.graph.edges) {
            let refined: Refinement = hash_component(over, component, gathered.view, effects);
            refined.members.fold(
              gathered.check_keys,
              |keys: CheckKeys, m: { node: Int, hash: Bytes }|
                { ..keys, checks: keys.checks.insert(m.node, m.hash) },
            )
          } else {
            let v = component.get(0);
            let encoding = filled_under(
              over,
              form_of(over, v),
              gathered.view,
              effects,
              false,
            ).bytes;
            {
              ..gathered.check_keys,
              checks: gathered.check_keys.checks.insert(v, blake3(encoding)),
            }
          }
        }
      }
    },
  )

fn cached_spec_hashes(accumulator: SpecHashes, name: Bytes, fixed: CachedNode) -> SpecHashes = {
  let owned: SpecHashes = match fixed.own {
    Some(o) -> { ..accumulator, own: accumulator.own.push({ name: name, hash: o }) },
    None -> accumulator,
  };
  if fixed.specs.len() == 0 { owned } else {
    {
      ..owned,
      specs: owned.specs.push({ name: name, hashes: fixed.specs }),
      spec_texts: owned.spec_texts.push({ name: name, hashes: fixed.spec_texts }),
      spec_checks: owned.spec_checks.push({ name: name, hashes: fixed.spec_checks }),
    }
  }
}

fn computed_spec_hashes(
  over: HashContext,
  hashes: Map<Int, Bytes>,
  view: Map<Int, Bytes>,
  checks: Map<Int, Bytes>,
  accumulator: SpecHashes,
  v: Int,
  refs: List<Int>,
) -> SpecHashes / {abort.raise} = {
  let shape = over.shapes.nodes.get(v);
  match shape.form {
    None -> accumulator,
    Some(form) -> if shape.declaration { accumulator } else {
      let own: FilledForm = filled_under(
        over,
        form.form,
        hashes,
        positions(effect_order(over.shapes, refs, over.graph.scc, None, [])),
        true,
      );
      let owned: SpecHashes = {
        ..accumulator,
        own: accumulator.own.push({ name: shape.name, hash: own_hash(own.bytes) }),
      };
      if form.clauses.len() == 0 { owned } else {
        match hashes.get(v) {
          None -> owned,
          Some(owner) -> {
            let effects = form.clauses.map(|c: ClauseForm| slots_of(over, c.form));
            let encoded = |i: Int, table: Map<Int, Bytes>, by_name: Bool|
              filled_under(over, form.clauses.get(i).form, table, effects.get(i), by_name).bytes;
            let kinds = range(0, form.clauses.len());
            let clauses = kinds.map(|i: Int|
              spec_hash(owner, form.clauses.get(i).kind, i, encoded(i, hashes, false)));
            let texts = kinds.map(|i: Int|
              spec_text_hash(form.clauses.get(i).kind, i, encoded(i, hashes, true)));
            let cut_owner = match checks.get(v) { Some(k) -> k, None -> owner };
            let cuts = kinds.map(|i: Int|
              spec_hash(cut_owner, form.clauses.get(i).kind, i, encoded(i, view, false)));
            {
              ..owned,
              specs: owned.specs.push({ name: shape.name, hashes: clauses }),
              spec_texts: owned.spec_texts.push({ name: shape.name, hashes: texts }),
              spec_checks: owned.spec_checks.push({ name: shape.name, hashes: cuts }),
            }
          },
        }
      }
    },
  }
}

fn form_nodes(form: Template, seen: NodeOrder) -> NodeOrder / {abort.raise} =
  references(form).fold(seen, add_node)

fn optional_form_nodes(form: Option<Template>, seen: NodeOrder) -> NodeOrder / {abort.raise} =
  match form { Some(f) -> form_nodes(f, seen), None -> seen }

type NodeOrder = { order: List<Int>, at: Map<Int, Int> }

fn add_node(t: NodeOrder, v: Int) -> NodeOrder =
  if t.at.contains(v) { t } else { { order: t.order.push(v), at: t.at.insert(v, t.order.len()) } }

fn renumber(form: Template, ids: Map<Int, Int>) -> Template / {abort.raise} =
  renumbered(form, |v: Int|
    match ids.get(v) {
      Some(k) -> k,
      None -> panic("a template refers to a definition that has no new index"),
    })

fn optional_renumber(
  form: Option<Template>,
  ids: Map<Int, Int>,
) -> Option<Template> / {abort.raise} =
  match form { Some(f) -> Some(renumber(f, ids)), None -> None }

pub fn module_forms(index: Index, packages: List<Int>, module: Int) -> HashInput / {abort.raise} =
  filtered_forms(index, packages, module, {
    node: |_: Bytes| true,
    test: |_: Bytes| true,
    law: |_: Bytes| true,
  })

pub type ItemFilter = {
  node: (Bytes) -> Bool / {abort.raise},
  test: (Bytes) -> Bool / {abort.raise},
  law: (Bytes) -> Bool / {abort.raise},
}

pub fn filtered_forms(
  index: Index,
  packages: List<Int>,
  module: Int,
  filter: ItemFilter,
) -> HashInput / {abort.raise} = {
  let c = module_selection(index, module);
  selection_forms(index, packages, {
    own: c.own.filter(|v: Int| (filter.node)(index.nodes.get(v).name)),
    tests: c.tests.filter(|t: TestNode| (filter.test)(t.key)),
    laws: c.laws.filter(|l: LawNode| (filter.law)(l.key)),
    called: c.called,
  })
}

pub type ModuleSelection = {
  own: List<Int>,
  tests: List<TestNode>,
  laws: List<LawNode>,
  called: Option<Map<CallSite, Choice>>,
}

pub fn module_selection(index: Index, module: Int) -> ModuleSelection / {abort.raise} =
  {
    own: index.order.fold([], |accumulator: List<Int>, e: IndexEntry|
      match e {
        DefinitionEntry(v) -> if index.nodes.get(v).module == module { accumulator.push(v) }
        else { accumulator },
        _ -> accumulator,
      }),
    tests: index.tests.filter(|t: TestNode| t.module == module),
    laws: index.laws.filter(|l: LawNode| l.module == module),
    called: None,
  }

pub fn selection_forms(
  index: Index,
  packages: List<Int>,
  chosen: ModuleSelection,
) -> HashInput / {abort.raise} = {
  let own = chosen.own;
  let forms = own.map(|v: Int| node_form(index, v, chosen.called));
  let tests = chosen.tests;
  let laws = chosen.laws;
  let test_forms = tests.map(|t: TestNode| test_form(index, t, chosen.called));
  let law_forms = laws.map(|l: LawNode| law_form(index, l));
  let item_nodes = |accumulator: NodeOrder, x: ItemForm|
    x.case_refs.concat(x.listing).fold(form_nodes(x.form, accumulator), |a: NodeOrder, v: Int|
      add_node(a, v));
  let table = law_forms.fold(
    test_forms.fold(
      forms.fold(
        own.fold({ order: [], at: Map::new() }, add_node),
        |accumulator: NodeOrder, f: NodeForm|
          f.clauses.fold(
            optional_form_nodes(f.signature, form_nodes(f.form, accumulator)),
            |a: NodeOrder, c: ClauseForm| form_nodes(c.form, a),
          ),
      ),
      item_nodes,
    ),
    item_nodes,
  );
  let ids = table.at;
  let item = |x: ItemForm|
    {
      form: renumber(x.form, ids),
      case_refs: x.case_refs.map(|v: Int| match ids.get(v) { Some(k) -> k, None -> v }),
      listing: x.listing.map(|v: Int| match ids.get(v) { Some(k) -> k, None -> v }),
    };
  {
    nodes: range(0, table.order.len()).map(|k: Int| {
      let v = table.order.get(k);
      let node = index.nodes.get(v);
      {
        name: node.name,
        declaration: is_declaration(node),
        effect: is_effect(index, v),
        package: match packages.at(node.module) { Some(p) -> p, None -> 0 },
        form: if k < own.len() {
          let f = forms.get(k);
          Some({
            form: renumber(f.form, ids),
            signature: optional_renumber(f.signature, ids),
            clauses: f.clauses.map(|c: ClauseForm| { ..c, form: renumber(c.form, ids) }),
            transparent: f.transparent,
          })
        } else { None },
      }
    }),
    order: range(0, own.len()),
    tests: range(0, tests.len()).map(|i: Int|
      { key: tests.get(i).key, form: Some(item(test_forms.get(i))) }),
    laws: range(0, laws.len()).map(|i: Int|
      { key: laws.get(i).key, form: Some(item(law_forms.get(i))) }),
  }
}

type JoinedNode = { part: Int, at: Int, shape: HashNode }

pub fn joined_forms(parts: List<HashInput>) -> HashInput / {abort.raise} = {
  let visit = |formed: Bool|
    |accumulator: { at: Map<Bytes, Int>, nodes: List<JoinedNode> }, k: Int|
      range(0, parts.get(k).nodes.len()).fold(
        accumulator,
        |a: { at: Map<Bytes, Int>, nodes: List<JoinedNode> }, v: Int| {
          let shape = parts.get(k).nodes.get(v);
          let key = definition_key(shape.name, shape.declaration);
          if has_no_form(shape) == formed || a.at.contains(key) { a } else {
            {
              at: a.at.insert(key, a.nodes.len()),
              nodes: a.nodes.push({ part: if formed { k } else { 0 - 1 }, at: v, shape: shape }),
            }
          }
        },
      );
  let formed = range(0, parts.len()).fold({ at: Map::new(), nodes: [] }, visit(true));
  let all = range(0, parts.len()).fold(formed, visit(false));
  let ids = parts.map(|part: HashInput|
    range(0, part.nodes.len()).fold(Map::new(), |accumulator: Map<Int, Int>, v: Int| {
      let shape = part.nodes.get(v);
      match all.at.get(definition_key(shape.name, shape.declaration)) {
        Some(k) -> accumulator.insert(v, k),
        None ->
          panic("a definition from one package is missing from the combined list of definitions"),
      }
    }));
  let item = |k: Int|
    |x: HashItem|
      {
        ..x,
        form: match x.form {
          None -> None,
          Some(f) ->
            Some({
              form: renumber(f.form, ids.get(k)),
              case_refs: f.case_refs.map(|v: Int|
                match ids.get(k).get(v) { Some(w) -> w, None -> v }),
              listing: f.listing.map(|v: Int| match ids.get(k).get(v) { Some(w) -> w, None -> v }),
            }),
        },
      };
  {
    nodes: all.nodes.map(|j: JoinedNode|
      match j.shape.form {
        None -> j.shape,
        Some(f) ->
          {
            ..j.shape,
            form: Some({
              form: renumber(f.form, ids.get(j.part)),
              signature: optional_renumber(f.signature, ids.get(j.part)),
              clauses: f.clauses.map(|c: ClauseForm|
                { ..c, form: renumber(c.form, ids.get(j.part)) }),
              transparent: f.transparent,
            }),
          },
      }),
    order: range(0, formed.nodes.len()),
    tests: range(0, parts.len()).fold([], |accumulator: List<HashItem>, k: Int|
      accumulator.concat(parts.get(k).tests.map(item(k)))),
    laws: range(0, parts.len()).fold([], |accumulator: List<HashItem>, k: Int|
      accumulator.concat(parts.get(k).laws.map(item(k)))),
  }
}

pub fn hash_forms(forms: HashInput, fixed: List<CachedNode>) -> CachedHashes / {abort.raise} = {
  let named = hash_node_keys(forms);
  let fixed_by_node = fixed.fold(Map::new(), |accumulator: Map<Int, CachedNode>, f: CachedNode|
    match named.get(definition_key(f.name, f.declaration)) {
      Some(v) -> if has_no_form(forms.nodes.get(v)) { accumulator.insert(v, f) }
      else { accumulator },
      None -> accumulator,
    });
  let extra = fixed_by_node.fold(
    { keys: named, nodes: [] },
    |accumulator: { keys: Map<Bytes, Int>, nodes: List<HashNode> }, _: Int, f: CachedNode|
      f.effects.fold(
        accumulator,
        |a: { keys: Map<Bytes, Int>, nodes: List<HashNode> }, r: NodeRef| {
          let key = definition_key(r.name, r.declaration);
          if a.keys.contains(key) { a } else {
            {
              keys: a.keys.insert(key, forms.nodes.len() + a.nodes.len()),
              nodes: a.nodes.push({
                name: r.name,
                declaration: r.declaration,
                effect: true,
                package: 0 - 1,
                form: None,
              }),
            }
          }
        },
      ),
  );
  let shapes = { ..forms, nodes: forms.nodes.concat(extra.nodes) };
  let keys = extra.keys;
  let unfixed = range(0, forms.nodes.len()).filter(|v: Int|
    has_no_form(forms.nodes.get(v)) && !fixed_by_node.contains(v));
  if unfixed.len() > 0 {
    panic(
      "no template or cached hash for "
        ++ String::of_bytes_lossy(forms.nodes.get(unfixed.get(0)).name),
    )
  };
  let present = |refs: List<NodeRef>|
    refs.fold([], |es: List<Int>, r: NodeRef|
      match keys.get(definition_key(r.name, r.declaration)) { Some(w) -> es.push(w), None -> es });
  let out = hash_all(
    shapes,
    first_pass_of(
      shapes,
      fixed_by_node.fold(Map::new(), |accumulator: Map<Int, List<Int>>, v: Int, f: CachedNode|
        accumulator.insert(v, present(f.edges))),
    ),
    fixed_by_node,
    no_cached_hashes(),
  );
  let h = out.hashed;
  let refs = |rs: List<Int>|
    rs.map(|r: Int|
      { name: shapes.nodes.get(r).name, declaration: shapes.nodes.get(r).declaration });
  let by_name = |xs: List<{ name: Bytes, hashes: List<Bytes> }>|
    xs.fold(
      Map::new(),
      |accumulator: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
        accumulator.insert(x.name, x.hashes),
    );
  let own = h.own.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
      accumulator.insert(x.name, x.hash),
  );
  let specs = by_name(h.specs);
  let texts = by_name(h.spec_texts);
  let checks = by_name(h.spec_checks);
  let listed = |m: Map<Bytes, List<Bytes>>, name: Bytes|
    match m.get(name) { Some(xs) -> xs, None -> [] };
  {
    nodes: forms.order.map(|v: Int| {
      let s = shapes.nodes.get(v);
      let hash = match h.hashes.get(v) { Some(x) -> x, None -> b"" };
      {
        name: s.name,
        declaration: s.declaration,
        hash: hash,
        own: if s.declaration { None } else { own.get(s.name) },
        specs: if s.declaration { [] } else { listed(specs, s.name) },
        spec_texts: if s.declaration { [] } else { listed(texts, s.name) },
        spec_checks: if s.declaration { [] } else { listed(checks, s.name) },
        contract: if s.declaration { b"" }
        else { match h.contracts.get(v) { Some(c) -> c, None -> hash } },
        check: if s.declaration { hash }
        else { match h.checks.get(v) { Some(c) -> c, None -> hash } },
        body: match h.bodies.get(v) { Some(b) -> b, None -> b"" },
        edges: refs(out.graph.edges.get(v)),
        effects: refs(h.enumerations.get(v)),
        clauses: refs(h.clauses.get(v)),
      }
    }),
    tests: range(0, forms.tests.len()).map(|i: Int|
      {
        key: forms.tests.get(i).key,
        hash: h.tests.get(i),
        body: h.test_bodies.get(i),
        text: h.test_texts.get(i),
        refs: refs(h.test_refs.get(i)),
        runs: refs(h.test_runs.get(i)),
        listing: refs(h.test_listings.get(i)),
      }),
    laws: range(0, forms.laws.len()).map(|i: Int|
      {
        key: forms.laws.get(i).key,
        hash: h.laws.get(i),
        text: h.law_texts.get(i),
        refs: refs(h.law_refs.get(i)),
      }),
  }
}

pub fn cached_nodes(
  index: Index,
  hashes: HashOutput,
  keep: Map<Bytes, Bool>,
) -> List<CachedNode> / {abort.raise} = {
  let node_refs = |refs: List<Int>|
    refs.map(|r: Int|
      { name: index.nodes.get(r).name, declaration: is_declaration(index.nodes.get(r)) });
  let edges_of = |v: Int, node: Node|
    match hashes.refs.edges.at(v) {
      Some(refs) -> node_refs(refs),
      None -> node_refs(references(node_template(index, node.module, node.name, None, node.body))),
    };
  let own = hashes.own.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
      accumulator.insert(x.name, x.hash),
  );
  let specs = hashes.specs.fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
      accumulator.insert(x.name, x.hashes),
  );
  let texts = hashes.spec_texts.fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
      accumulator.insert(x.name, x.hashes),
  );
  let checks = hashes.spec_checks.fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
      accumulator.insert(x.name, x.hashes),
  );
  let named = |xs: List<{ name: Bytes, hash: Bytes }>|
    xs.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
      accumulator.insert(x.name, x.hash));
  let contracts = named(hashes.contracts);
  let check_keys = named(hashes.checks);
  let listed = |m: Map<Bytes, List<Bytes>>, name: Bytes|
    match m.get(name) { Some(xs) -> xs, None -> [] };
  let walked = index.order.fold(
    { body: 0, definition: 0, declaration: 0, out: [] },
    |accumulator: { body: Int, definition: Int, declaration: Int, out: List<CachedNode> }, e: IndexEntry|
      match e {
        DefinitionEntry(v) -> {
          let node = index.nodes.get(v);
          let declaration = is_declaration(node);
          let body = hashes.bodies.get(accumulator.body);
          if body.name != node.name {
            panic("hashes and the index disagree on the order of nodes")
          };
          let next = {
            ..accumulator,
            body: accumulator.body + 1,
            definition: if declaration { accumulator.definition }
            else { accumulator.definition + 1 },
            declaration: if declaration { accumulator.declaration + 1 }
            else { accumulator.declaration },
          };
          if !keep.contains(index.modules.get(node.module).name) { next } else {
            {
              ..next,
              out: next.out.push({
                name: node.name,
                declaration: declaration,
                hash: if declaration { hashes.declarations.get(accumulator.declaration).hash }
                else { hashes.definitions.get(accumulator.definition).hash },
                own: if declaration { None } else { own.get(node.name) },
                specs: if declaration { [] } else { listed(specs, node.name) },
                spec_texts: if declaration { [] } else { listed(texts, node.name) },
                spec_checks: if declaration { [] } else { listed(checks, node.name) },
                contract: if declaration { b"" }
                else { match contracts.get(node.name) { Some(c) -> c, None -> b"" } },
                check: if declaration { hashes.declarations.get(accumulator.declaration).hash }
                else { match check_keys.get(node.name) { Some(c) -> c, None -> b"" } },
                body: body.body,
                edges: edges_of(v, node),
                effects: node_refs(match hashes.component_members.at(v) {
                  Some(es) -> es,
                  None -> [],
                }),
                clauses: node_refs(match hashes.refs.clauses.at(v) { Some(cs) -> cs, None -> [] }),
              }),
            }
          }
        },
        _ -> accumulator,
      },
  );
  walked.out
}

pub fn cached_hashes_of(
  index: Index,
  hashes: HashOutput,
  keep: Map<Bytes, Bool>,
) -> CachedHashes / {abort.raise} = {
  let refs = |rs: List<Int>|
    rs.map(|r: Int|
      { name: index.nodes.get(r).name, declaration: is_declaration(index.nodes.get(r)) });
  let in_selection = |module: Int| keep.contains(index.modules.get(module).name);
  {
    nodes: cached_nodes(index, hashes, keep),
    tests: range(0, index.tests.len()).fold([], |accumulator: List<CachedTest>, i: Int| {
      let t = index.tests.get(i);
      if !in_selection(t.module) { accumulator } else {
        accumulator.push({
          key: t.key,
          hash: of_key(hashes.tests, t.key),
          body: of_key(hashes.test_bodies, t.key),
          text: of_key(hashes.test_texts, t.key),
          refs: refs(of_key(hashes.test_refs, t.key)),
          runs: refs(of_key(hashes.test_runs, t.key)),
          listing: refs(match hashes.refs.listings.get(t.key) { Some(xs) -> xs, None -> [] }),
        })
      }
    }),
    laws: range(0, index.laws.len()).fold([], |accumulator: List<CachedLaw>, i: Int| {
      let l = index.laws.get(i);
      if !in_selection(l.module) { accumulator } else {
        accumulator.push({
          key: l.key,
          hash: of_key(hashes.laws, l.key),
          text: of_key(hashes.law_texts, l.key),
          refs: refs(of_key(hashes.law_refs, l.key)),
        })
      }
    }),
  }
}

pub fn is_declaration(node: Node) -> Bool = match node.body { NodeFn(_) -> false, _ -> true }

pub fn definition_key(name: Bytes, declaration: Bool) -> Bytes =
  Bytes::concat(if declaration { b"decl " } else { b"def " }, name)

fn append_at(m: Map<Bytes, List<Int>>, key: Bytes, vs: List<Int>) -> Map<Bytes, List<Int>> =
  m.insert(key, List::concat(match m.get(key) { Some(xs) -> xs, None -> [] }, vs))

pub type HashLayout = {
  nodes: List<NodeRef>,
  order: List<IndexEntry>,
  tests: List<{ key: Bytes, cases: Bool }>,
  laws: List<Bytes>,
}

pub fn hash_layout(index: Index) -> HashLayout =
  {
    nodes: index.nodes.map(|node: Node| { name: node.name, declaration: is_declaration(node) }),
    order: index.order,
    tests: index.tests.map(|t: TestNode| { key: t.key, cases: t.definition.cases != None }),
    laws: index.laws.map(|l: LawNode| l.key),
  }

fn by_key<a>(keys: List<Bytes>, xs: List<a>) -> Map<Bytes, a> / {abort.raise} =
  range(0, keys.len()).fold(Map::new(), |accumulator: Map<Bytes, a>, i: Int|
    accumulator.insert(keys.get(i), xs.get(i)))

pub fn assemble(
  sk: HashLayout,
  edges: List<List<Int>>,
  h: HashTables,
) -> HashOutput / {abort.raise} = {
  let functions = range(0, sk.nodes.len()).fold(
    Map::new(),
    |accumulator: Map<Bytes, Int>, v: Int| {
      let node = sk.nodes.get(v);
      if node.declaration { accumulator } else { accumulator.insert(node.name, v) }
    },
  );
  let declared = range(0, sk.nodes.len()).fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Int>>, v: Int| {
      let node = sk.nodes.get(v);
      if node.declaration { append_at(accumulator, node.name, [v]) } else { accumulator }
    },
  );
  let tested = range(0, sk.tests.len()).fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Int>>, i: Int|
      append_at(accumulator, sk.tests.get(i).key, h.test_refs.get(i)),
  );
  let items = range(0, sk.laws.len()).fold(tested, |accumulator: Map<Bytes, List<Int>>, i: Int|
    append_at(accumulator, sk.laws.get(i), h.law_refs.get(i)));
  let names_at = |refs: List<Int>| refs.map(|r: Int| sk.nodes.get(r).name);
  let tests = sk.tests.map(|t: { key: Bytes, cases: Bool }| t.key);
  let empty: HashOutput = {
    definitions: [],
    own: h.own,
    declarations: [],
    tests: by_key(tests, h.tests),
    laws: by_key(sk.laws, h.laws),
    specs: h.specs,
    spec_texts: h.spec_texts,
    law_texts: by_key(sk.laws, h.law_texts),
    dependencies: [],
    refs: {
      names: sk.nodes.map(|node: NodeRef| node.name),
      is_declaration: sk.nodes.map(|node: NodeRef| node.declaration),
      edges: edges,
      functions: functions,
      declared: declared,
      items: items,
      cases: range(0, sk.tests.len()).fold(
        Map::new(),
        |accumulator: Map<Bytes, List<Int>>, i: Int| {
          let t = sk.tests.get(i);
          if !t.cases { accumulator } else { append_at(accumulator, t.key, h.test_runs.get(i)) }
        },
      ),
      clauses: h.clauses,
      listings: range(0, sk.tests.len()).fold(
        Map::new(),
        |accumulator: Map<Bytes, List<Int>>, i: Int| {
          let t = sk.tests.get(i);
          if !t.cases { accumulator } else { append_at(accumulator, t.key, h.test_listings.get(i)) }
        },
      ),
    },
    bodies: [],
    test_bodies: by_key(tests, h.test_bodies),
    test_texts: by_key(tests, h.test_texts),
    contracts: [],
    checks: [],
    spec_checks: h.spec_checks,
    test_refs: by_key(tests, h.test_refs),
    test_runs: by_key(tests, h.test_runs),
    law_refs: by_key(sk.laws, h.law_refs),
    component_members: h.enumerations,
  };
  sk.order.fold(
    { out: empty, dependencies_at: Map::new() },
    |accumulator: Recording, e: IndexEntry|
      match e {
        DefinitionEntry(v) -> {
          let node = sk.nodes.get(v);
          let bodied: HashOutput = match h.bodies.get(v) {
            None -> accumulator.out,
            Some(body) ->
              {
                ..accumulator.out,
                bodies: accumulator.out.bodies.push({ name: node.name, body: body }),
              },
          };
          let keyed: HashOutput = match h.hashes.get(v) {
            None -> bodied,
            Some(hash) -> if node.declaration {
              { ..bodied, declarations: bodied.declarations.push({ name: node.name, hash: hash }) }
            } else {
              {
                ..bodied,
                definitions: bodied.definitions.push({ name: node.name, hash: hash }),
                contracts: bodied.contracts.push({
                  name: node.name,
                  hash: match h.contracts.get(v) { Some(c) -> c, None -> hash },
                }),
                checks: bodied.checks.push({
                  name: node.name,
                  hash: match h.checks.get(v) { Some(c) -> c, None -> hash },
                }),
              }
            },
          };
          record({ ..accumulator, out: keyed }, node.name, names_at(edges.get(v)))
        },
        TestEntry(i) -> record(accumulator, sk.tests.get(i).key, names_at(h.test_refs.get(i))),
        LawEntry(i) -> record(accumulator, sk.laws.get(i), names_at(h.law_refs.get(i))),
      },
  ).out
}

pub fn hashes_from_cache(sk: HashLayout, fixing: CachedHashes) -> HashOutput / {abort.raise} = {
  let keys = range(0, sk.nodes.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, v: Int| {
    let node = sk.nodes.get(v);
    accumulator.insert(definition_key(node.name, node.declaration), v)
  });
  let ids = |refs: List<NodeRef>|
    refs.fold([], |es: List<Int>, r: NodeRef|
      match keys.get(definition_key(r.name, r.declaration)) { Some(w) -> es.push(w), None -> es });
  let cached_by_node = fixing.nodes.fold(
    Map::new(),
    |accumulator: Map<Int, CachedNode>, f: CachedNode|
      match keys.get(definition_key(f.name, f.declaration)) {
        Some(v) -> accumulator.insert(v, f),
        None -> accumulator,
      },
  );
  let tests = fixing.tests.fold(Map::new(), |accumulator: Map<Bytes, CachedTest>, t: CachedTest|
    accumulator.insert(t.key, t));
  let laws = fixing.laws.fold(Map::new(), |accumulator: Map<Bytes, CachedLaw>, l: CachedLaw|
    accumulator.insert(l.key, l));
  let test_of = |key: Bytes|
    match tests.get(key) {
      Some(t) -> t,
      None -> panic("no cached test has the key " ++ String::of_bytes_lossy(key)),
    };
  let law_of = |key: Bytes|
    match laws.get(key) {
      Some(l) -> l,
      None -> panic("no cached law has the key " ++ String::of_bytes_lossy(key)),
    };
  let field = |pick: (CachedNode) -> Bytes|
    cached_by_node.fold(Map::new(), |accumulator: Map<Int, Bytes>, v: Int, f: CachedNode|
      accumulator.insert(v, pick(f)));
  let stated = sk.order.fold(
    { own: [], specs: [], spec_texts: [], spec_checks: [] },
    |accumulator: SpecHashes, e: IndexEntry|
      match e {
        DefinitionEntry(v) -> match cached_by_node.get(v) {
          Some(f) -> if f.declaration { accumulator }
          else { cached_spec_hashes(accumulator, f.name, f) },
          None -> accumulator,
        },
        _ -> accumulator,
      },
  );
  let tested = sk.tests.map(|t: { key: Bytes, cases: Bool }| test_of(t.key));
  let lawful = sk.laws.map(law_of);
  assemble(
    sk,
    range(0, sk.nodes.len()).map(|v: Int|
      match cached_by_node.get(v) { Some(f) -> ids(f.edges), None -> [] }),
    {
      hashes: field(|f: CachedNode| f.hash),
      bodies: field(|f: CachedNode| f.body),
      tests: tested.map(|t: CachedTest| t.hash),
      test_bodies: tested.map(|t: CachedTest| t.body),
      test_texts: tested.map(|t: CachedTest| t.text),
      test_refs: tested.map(|t: CachedTest| ids(t.refs)),
      test_runs: tested.map(|t: CachedTest| ids(t.runs)),
      laws: lawful.map(|l: CachedLaw| l.hash),
      law_refs: lawful.map(|l: CachedLaw| ids(l.refs)),
      law_texts: lawful.map(|l: CachedLaw| l.text),
      own: stated.own,
      specs: stated.specs,
      spec_texts: stated.spec_texts,
      contracts: cached_by_node.fold(
        Map::new(),
        |accumulator: Map<Int, Bytes>, v: Int, f: CachedNode|
          if f.declaration || f.contract.len() == 0 { accumulator }
          else { accumulator.insert(v, f.contract) },
      ),
      checks: cached_by_node.fold(
        Map::new(),
        |accumulator: Map<Int, Bytes>, v: Int, f: CachedNode|
          if f.declaration || f.check.len() == 0 { accumulator }
          else { accumulator.insert(v, f.check) },
      ),
      spec_checks: stated.spec_checks,
      enumerations: range(0, sk.nodes.len()).map(|v: Int|
        match cached_by_node.get(v) { Some(f) -> ids(f.effects), None -> [] }),
      clauses: range(0, sk.nodes.len()).map(|v: Int|
        match cached_by_node.get(v) { Some(f) -> ids(f.clauses), None -> [] }),
      test_listings: tested.map(|t: CachedTest| ids(t.listing)),
    },
  )
}

fn record(a: Recording, name: Bytes, dependencies: List<Bytes>) -> Recording / {abort.raise} = {
  let out: HashOutput = a.out;
  match a.dependencies_at.get(name) {
    Some(i) -> {
      let existing = out.dependencies.get(i);
      {
        out: {
          ..out,
          dependencies: out.dependencies.set(i, {
            name: name,
            names: dependencies.fold(existing.names, |accumulator: List<Bytes>, d: Bytes|
              if accumulator.contains(d) { accumulator } else { accumulator.push(d) }),
          }),
        },
        dependencies_at: a.dependencies_at,
      }
    },
    None ->
      {
        out: { ..out, dependencies: out.dependencies.push({ name: name, names: dependencies }) },
        dependencies_at: a.dependencies_at.insert(name, out.dependencies.len()),
      },
  }
}

type WalkState = { seen: List<Bool>, frontier: List<Int>, all: List<Int> }

fn visit(w: WalkState, v: Int) -> WalkState / {abort.raise} =
  if w.seen.get(v) { w }
  else { { seen: w.seen.set(v, true), frontier: w.frontier.push(v), all: w.all.push(v) } }

pub fn walked(
  edges: List<List<Int>>,
  from: List<Int>,
) -> { seen: List<Bool>, all: List<Int> } / {abort.raise} = {
  let n = edges.len();
  let start = from.fold({ seen: range(0, n).map(|i: Int| false), frontier: [], all: [] }, visit);
  iterate(start, n + 2, |w: WalkState|
    if w.frontier.len() == 0 { Stop({ seen: w.seen, all: w.all }) } else {
      Continue(
        w.frontier.fold({ ..w, frontier: [] }, |accumulator: WalkState, v: Int|
          edges.get(v).fold(accumulator, visit)),
      )
    })
}

pub type Subject = | FunctionNamed(Bytes) | DeclarationNamed(Bytes) | ItemKeyed(Bytes)

pub type ReachableNames = { functions: Map<Bytes, Bool>, declarations: Map<Bytes, Bool> }

fn nodes_of(r: Refs, which: Subject) -> List<Int> =
  match which {
    FunctionNamed(name) -> match r.functions.get(name) { Some(v) -> [v], None -> [] },
    DeclarationNamed(name) -> match r.declared.get(name) { Some(vs) -> vs, None -> [] },
    ItemKeyed(key) -> match r.items.get(key) { Some(vs) -> vs, None -> [] },
  }

fn start_nodes(r: Refs, roots: List<Subject>) -> List<Int> =
  roots.fold([], |accumulator: List<Int>, which: Subject| accumulator.concat(nodes_of(r, which)))

fn meanings(key: Bytes) -> List<Subject> =
  [ItemKeyed(key), FunctionNamed(key), DeclarationNamed(key)]

fn reachable_names(r: Refs, nodes: List<Int>) -> ReachableNames / {abort.raise} =
  nodes.fold(
    { functions: Map::new(), declarations: Map::new() },
    |accumulator: ReachableNames, v: Int|
      if r.is_declaration.get(v) {
        { ..accumulator, declarations: accumulator.declarations.insert(r.names.get(v), true) }
      } else { { ..accumulator, functions: accumulator.functions.insert(r.names.get(v), true) } },
  )

pub fn reach(hashes: HashOutput, roots: List<Subject>) -> ReachableNames / {abort.raise} =
  reachable_names(hashes.refs, walked(hashes.refs.edges, start_nodes(hashes.refs, roots)).all)

pub fn closure_of(hashes: HashOutput, keys: List<Bytes>) -> Map<Bytes, Bool> / {abort.raise} = {
  let r = hashes.refs;
  let known = keys.filter(|k: Bytes|
    r.items.contains(k) || r.functions.contains(k) || r.declared.contains(k));
  let reachable = reach(
    hashes,
    known.fold([], |accumulator: List<Subject>, k: Bytes| accumulator.concat(meanings(k))),
  );
  known.fold(Map::new(), |accumulator: Map<Bytes, Bool>, k: Bytes|
    accumulator.insert(k, true)).merge(
    reachable.functions,
  ).merge(
    reachable.declarations,
  )
}

pub fn reachable_functions(
  hashes: HashOutput,
  roots: List<Subject>,
) -> Map<Bytes, Bool> / {abort.raise} = {
  let r = hashes.refs;
  unit_reach(r, start_nodes(r, roots))
}

fn unit_reach(r: Refs, starts: List<Int>) -> Map<Bytes, Bool> / {abort.raise} = {
  let scheduled = scheduler_module().concat(b".");
  let written = range(0, r.names.len()).filter(|v: Int|
    !r.is_declaration.get(v) && r.names.get(v).starts_with(scheduled));
  reachable_names(r, walked(with_clauses(r), starts.concat(written)).all).functions
}

fn with_clauses(r: Refs) -> List<List<Int>> / {abort.raise} =
  range(0, r.edges.len()).map(|v: Int|
    r.edges.get(v).concat(match r.clauses.at(v) { Some(cs) -> cs, None -> [] }))

fn with_tables(r: Refs, which: Subject) -> List<Int> =
  nodes_of(r, which).concat(match which {
    ItemKeyed(key) -> match r.listings.get(key) { Some(vs) -> vs, None -> [] },
    _ -> [],
  })

pub fn used_from(hashes: HashOutput, roots: List<Subject>) -> ReachableNames / {abort.raise} = {
  let r = hashes.refs;
  reachable_names(
    r,
    walked(with_clauses(r), roots.flat_map(|which: Subject| with_tables(r, which))).all,
  )
}

pub fn reachable_by_tests(
  hashes: HashOutput,
  keys: List<Bytes>,
) -> Map<Bytes, Bool> / {abort.raise} = {
  let r = hashes.refs;
  unit_reach(
    r,
    keys.fold([], |accumulator: List<Int>, k: Bytes|
      match r.listings.get(k) { Some(vs) -> accumulator.concat(vs), None -> accumulator }),
  )
}

pub fn references_in(hashes: HashOutput, which: Subject) -> List<NodeRef> / {abort.raise} = {
  let r = hashes.refs;
  let direct = match which {
    ItemKeyed(_) -> nodes_of(r, which),
    _ ->
      nodes_of(r, which).fold([], |accumulator: List<Int>, v: Int|
        accumulator.concat(r.edges.get(v))),
  };
  direct.map(|v: Int| { name: r.names.get(v), declaration: r.is_declaration.get(v) })
}

fn back_edges(r: Refs) -> List<List<Int>> / {abort.raise} = {
  let n = r.names.len();
  range(0, n).fold(range(0, n).map(|i: Int| []), |accumulator: List<List<Int>>, v: Int|
    r.edges.get(v).fold(accumulator, |a: List<List<Int>>, w: Int| {
      let into = a.get(w);
      a.set(w, []).set(w, into.push(v))
    }))
}

pub type Referrers = { functions: List<Bytes>, declarations: List<Bytes>, items: List<Bytes> }

pub fn find_referrers(
  hashes: HashOutput,
  target: Subject,
  through: Bool,
) -> Referrers / {abort.raise} = {
  let r = hashes.refs;
  let targets = nodes_of(r, target);
  let n = r.names.len();
  let marked = if through { walked(back_edges(r), targets).seen } else {
    targets.fold(range(0, n).map(|i: Int| false), |accumulator: List<Bool>, v: Int|
      accumulator.set(v, true))
  };
  let any_marked = |vs: List<Int>| vs.fold(false, |b: Bool, v: Int| b || marked.get(v));
  let nodes = range(0, n).filter(|v: Int|
    if through { marked.get(v) && !targets.contains(v) } else { any_marked(r.edges.get(v)) });
  let found = reachable_names(r, nodes);
  {
    functions: found.functions.keys(),
    declarations: found.declarations.keys(),
    items: r.items.fold([], |accumulator: List<Bytes>, key: Bytes, vs: List<Int>|
      if any_marked(vs) { accumulator.push(key) } else { accumulator }),
  }
}

pub fn keys_referring_to(
  hashes: HashOutput,
  names: Map<Bytes, Bool>,
) -> Map<Bytes, Bool> / {abort.raise} = {
  let r = hashes.refs;
  let n = r.names.len();
  let seen = walked(
    back_edges(r),
    range(0, n).filter(|v: Int| names.contains(r.names.get(v))),
  ).seen;
  let named = range(0, n).fold(Map::new(), |accumulator: Map<Bytes, Bool>, v: Int|
    if seen.get(v) { accumulator.insert(r.names.get(v), true) } else { accumulator });
  r.items.fold(named, |accumulator: Map<Bytes, Bool>, k: Bytes, vs: List<Int>|
    if names.contains(k) || vs.fold(false, |b: Bool, v: Int| b || seen.get(v)) {
      accumulator.insert(k, true)
    } else { accumulator })
}

pub type ClosureEntry = { name: Bytes, declaration: Bool, hash: Bytes, refs: List<Int> }

pub fn build_closure(hashes: HashOutput, roots: List<Bytes>) -> List<ClosureEntry> / {abort.raise} = {
  let r = hashes.refs;
  let definitions = by_name(hashes.definitions);
  let declarations = by_name(hashes.declarations);
  let hash_of = |v: Int|
    Map::get(if r.is_declaration.get(v) { declarations } else { definitions }, r.names.get(v));
  let closure_nodes = walked(
    r.edges,
    start_nodes(r, roots.map(|name: Bytes| FunctionNamed(name))),
  ).all.filter(|v: Int| hash_of(v) != None);
  let place = range(0, closure_nodes.len()).fold(
    Map::new(),
    |accumulator: Map<Int, Int>, i: Int| accumulator.insert(closure_nodes.get(i), i),
  );
  closure_nodes.map(|v: Int|
    {
      name: r.names.get(v),
      declaration: r.is_declaration.get(v),
      hash: match hash_of(v) { Some(h) -> h, None -> b"" },
      refs: r.edges.get(v).fold([], |accumulator: List<Int>, w: Int|
        match place.get(w) { Some(i) -> accumulator.push(i), None -> accumulator }),
    })
}

pub fn walk(edges: List<List<Int>>, from: List<Int>) -> List<Int> / {abort.raise} =
  walked(edges, from).all

pub fn by_name(xs: List<{ name: Bytes, hash: Bytes }>) -> Map<Bytes, Bytes> =
  xs.fold(Map::new(), |m: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
    m.insert(x.name, x.hash))
