//! Every stored form printed back to source and read again: a program of examples hashed, printed,
//! and hashed once more, each definition and test under the hash it had. The examples use every
//! variant the stored types declare, read off `stored.ply` itself, so a form added there without
//! an example here fails. A module of its own, which nothing imports: what a shipped module embeds
//! is read on every load that pulls it.

import compiler.syntax.items (Item, IType, TDSum, VariantDef, parse)
import compiler.check.resolve.tables (Source)
import std.value
import std.value (Value, VCtor, VList, VRecord, Field, reflect)
import std.list
import std.option
import std.bytes
import std.string
import compiler.store.hash (indexed, hash_index, checked_body)
import compiler.store.hash.forms (HashOutput, by_name)
import compiler.store.hash.printed (Printed, Unprintable, print_bodies, stored_forms)
import compiler.store.hash.stored (Stored)

/// Modules whose definitions between them hold every form a stored body can, kept beside this
/// module in `examples/`.
fn examples() -> List<Source> =
  [
    { name: b"std.prelude", src: embed("examples/prelude.txt") },
    { name: b"hex", src: embed("examples/hex.txt") },
    { name: b"marks", src: embed("examples/marks.txt") },
    { name: b"lib", src: embed("examples/lib.txt") },
    { name: b"std.map", src: embed("examples/map.txt") },
    { name: b"std.fact", src: embed("examples/host.txt") },
    { name: b"app", src: embed("examples/app.txt") },
  ]

/// Every variant of each sum `stored.ply` declares, by name.
fn declared_variants() -> List<Bytes> / {abort.raise} =
  parse(embed("stored.ply")).node.items.fold([], |acc: List<Bytes>, item: Item|
    match item {
      IType(d) -> match d.body {
        TDSum(vs) -> acc.concat(vs.map(|v: VariantDef| v.name.name)),
        _ -> acc,
      },
      _ -> acc,
    })

/// The variants no stored form a print reads can hold: the references filling writes only while
/// a definition has no hash or is written by name, a template's notes, the forms of a law and a
/// specification clause, which no print holds, and an extern type, which only a shipped module
/// declares.
fn never_printed() -> List<Bytes> =
  [b"Itself", b"ByName", b"Picked", b"Ran", b"LawOf", b"SpecOf", b"Extern", b"EmbeddedLiteral"]

/// Each constructor `v` holds, by its simple name, after those of `seen`.
fn constructors(v: Value, seen: Map<Bytes, Bool>) -> Map<Bytes, Bool> =
  match v {
    VCtor(name, args) ->
      args.fold(
        seen.insert(Bytes::of_string(value::ctor_name(name)), true),
        |acc: Map<Bytes, Bool>, a: Value| constructors(a, acc),
      ),
    VList(items) -> items.fold(seen, |acc: Map<Bytes, Bool>, a: Value| constructors(a, acc)),
    VRecord(fields) ->
      fields.fold(seen, |acc: Map<Bytes, Bool>, f: Field| constructors(f.value, acc)),
    _ -> seen,
  }

type Printing = { out: HashOutput, again: HashOutput, texts: List<{ module: Bytes, text: Bytes }> }

/// `sources` hashed, each call on a value read as a check that found nothing of it reads it, which
/// a print needs.
fn hashed(sources: List<Source>) -> HashOutput / {abort.raise} = {
  let out = hash_index(indexed(sources));
  {
    ..out,
    bodies: out.bodies.map(|b: { name: Bytes, body: Bytes }|
      { ..b, body: checked_body(b.body, Map::new()) }),
    test_bodies: out.test_bodies.fold(
      Map::new(),
      |acc: Map<Bytes, Bytes>, key: Bytes, body: Bytes|
        acc.insert(key, checked_body(body, Map::new())),
    ),
  }
}

fn round_trip(sources: List<Source>) -> Printing / {abort.raise} = {
  let out = hashed(sources);
  let names = out.defs.concat(out.decls).map(|x: { name: Bytes, hash: Bytes }|
    { name: x.name, hash: x.hash, public: true });
  match print_bodies(
      out.bodies.map(|b: { name: Bytes, body: Bytes }| b.body),
      names,
      out.test_bodies.values(),
      [],
    ) {
    Unprintable(why) -> panic(String::of_bytes(why.message)),
    Printed(ms) ->
      {
        out: out,
        again: hash_index(
          indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
        ),
        texts: ms,
      },
  }
}

test "every definition and test of the examples prints back to what it was stored under" {
  let p = round_trip(examples());
  let before = by_name(p.out.defs.concat(p.out.decls));
  let after = by_name(p.again.defs.concat(p.again.decls));
  let moved = before.fold([], |acc: List<Bytes>, name: Bytes, hash: Bytes|
    if after.get(name) == Some(hash) { acc } else { acc.push(name) });
  // What moved, and the text its module printed as, which is where to look.
  let printed = |name: Bytes|
    p.texts.fold(b"", |acc: Bytes, m: { module: Bytes, text: Bytes }|
      if name.starts_with(m.module.concat(b".")) { m.text } else { acc });
  assert(
    moved.len() == 0,
    Some(
      String::of_bytes_lossy(
        Bytes::concat_all([
          Bytes::join(moved, b", "),
          b" moved; printed as:\n",
          printed(moved.at(0).unwrap_or(b"")),
        ]),
      ),
    ),
  );
  assert_eq(p.again.tests.values().sort(), p.out.tests.values().sort())
}

test "the examples hold every variant a printed stored form can" {
  let out = hashed(examples());
  let seen = out.bodies.map(|b: { name: Bytes, body: Bytes }| b.body).concat(
    out.test_bodies.values(),
  ).fold(Map::new(), |acc: Map<Bytes, Bool>, body: Bytes|
    stored_forms(body).fold(acc, |a: Map<Bytes, Bool>, form: Stored|
      constructors(reflect(form), a)));
  let unused = declared_variants().filter(|v: Bytes|
    !seen.contains(v) && !never_printed().contains(v));
  assert(
    unused.len() == 0,
    Some("no example holds " ++ String::of_bytes_lossy(Bytes::join(unused, b", "))),
  )
}
