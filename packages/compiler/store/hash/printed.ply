//! Stored bodies printed back to source: what a mixture and an artifact print. A body decodes to
//! its stored form (`stored.stored_bin`), each reference in it is named where the print can name
//! it, and `fmt` prints the syntax that makes.

import syntax.parsing (Ident, QName, Span, dummy_span)
import syntax.lexer (widths)
import syntax.patterns (Pattern, PWild, PVar, PLit, PRange, PCtor, PRecord, PList, POr, Lit, LInt,
                        LFixed, LWide, LBool, LStr, LBytes, LFloat, LDec, LChar, LUnit)
import syntax.exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord,
                     ERecordUpdate, EField, EList, EPerform, EHandle, EWithHold, ESimulate,
                     EParallel, ETagged, EHole, ETryBlock, Stmt, SLet, SLetElse, SExpr, SAssign,
                     Param, MatchArm, HandleClause, ReturnClause, HandlerVar, RecField, NamedArg,
                     Hole, RaiseName)
import syntax.type_syntax (TypeExpr, TVar, TCon, TFn, TRecord, TUnit, RowExpr, AtomExpr, MWrite,
                           Generics)
import syntax.items (Module, Item, IFn, IType, IEffect, ITest, IInstance, INumeric, FnDef, TypeDef,
                     TDAlias, TDSum, TDNominal, TDExtern, VariantDef, EffectDef, OpDef, TestDef,
                     Constraint, NKey, NShow, ReturnsFresh, ReturnsParam, VPub)
import syntax.fmt (module_text)
import syntax.spelling (float_text, decimal_text)
import check.resolve.tables (qualify, default_binder, backticked)
import std.bin
import std.bytes (ascii_of_int)
import std.hash (blake3)
import std.list
import std.option
import std.bytes
import std.string
import store.hash.encoding (hex, Choice, Slot)
import store.hash.forms (member_hash)
import store.hash.stored
import store.hash.stored (Ref, Hashed, Member, Itself, ByName, Free, Literal, IntLit, FixedLit,
                          WideLit, BoolLit, StrLit, BytesLit, EmbeddedLit, FloatLit, DecimalLit,
                          CharLit, UnitLit, Local, Defined, Constructed, Unbound, Value, Label,
                          LabelParam, LabelName, Effect, Declared, EffectUnbound, TypeParam,
                          TypeDefined, TypeUnbound, Ty, Applied, AppliedOver, Function, Fields,
                          UnitType, RowParam, RowName, Row, Moded, OfOp, Pat, Wild, Bind, Again,
                          LitPat, RangePat, CtorPat, RecordPat, ListPat, OrPat, InFull, Among,
                          Constant, Unwritten, Var, Binary, Unary, Lambda, App, OnValue, If, Match,
                          Record, RecordUpdate, Field, ListOf, Perform, Handle, WithHold, Simulate,
                          Parallel, Tagged, Filled, TryBlock, Block, One, Commuting, Let, LetElse,
                          Effectful, Assign, Unstated, Fresh, ParamReturned, Alias, Sum, Nominal,
                          Extern, FnOf, TypeOf, EffectOf, TestOf, LawOf, SpecOf, Stored, stored_bin)

// --- The hash table ----------------------------------------------------------------------

/// Where a stored body's parts stand: its kind, a member's class, the choices each member's calls
/// on values made from `picks` to `at`, and the bytes its hash is taken over from `at`.
type Envelope = { kind: Int, class: Int, picks: Int, at: Int }

pub fn envelope(body: Bytes) -> Option<Envelope> = {
  let kind = if body.len() == 0 { 0 - 1 } else { body.at(0) };
  let framed = |class: Int, from: Int|
    match body.u32_at(from) {
      Some(n) -> if from + 4 + n > body.len() { None }
      else { Some({ kind: kind, class: class, picks: from + 4, at: from + 4 + n }) },
      None -> None,
    };
  if kind == 0 { framed(0, 1) }
  else if kind == 1 { match body.u32_at(1) { Some(class) -> framed(class, 5), None -> None } }
  else { None }
}

/// The choices of a body `e` opens, a list a member.
pub fn picks_of(body: Bytes, e: Envelope) -> List<List<Choice>> / {abort.raise} = {
  let read = |at: Int| match body.u32_at(at) { Some(n) -> n, None -> panic("a malformed body") };
  iterate(
    { at: e.picks, lists: [] },
    e.at - e.picks + 1,
    |s: { at: Int, lists: List<List<Choice>> }|
      if s.at >= e.at { Stop(s.lists) } else {
        let list = range(0, read(s.at)).fold(
          { at: s.at + 4, choices: [] },
          |acc: { at: Int, choices: List<Choice> }, _i: Int| {
            let k = read(acc.at + 4);
            {
              at: acc.at + 8 + 4 * k,
              choices: acc.choices.push({
                callee: read(acc.at) - 1,
                named: range(0, k).map(|j: Int| read(acc.at + 8 + 4 * j)),
              }),
            }
          },
        );
        Continue({ at: list.at, lists: s.lists.push(list.choices) })
      },
  )
}

/// The members of a component's packed bytes: a count, then each member's length and bytes.
fn members_of(packed: Bytes) -> Option<List<Bytes>> / {abort.raise} =
  match packed.u32_at(0) {
    None -> None,
    Some(n) -> {
      let read = range(0, n).fold(
        Some({ at: 4, members: [] }),
        |acc: Option<{ at: Int, members: List<Bytes> }>, _i: Int|
          match acc {
            None -> None,
            Some(s) -> match packed.u32_at(s.at) {
              None -> None,
              Some(len) -> if s.at + 4 + len > packed.len() { None }
              else { Some({ at: s.at + 4 + len, members: s.members.push(packed.slice(s.at + 4, s.at + 4 + len)) }) },
            },
          },
      );
      match read { Some(s) -> if s.at == packed.len() { Some(s.members) } else { None }, None -> None }
    },
  }

/// The stored form of the body `bytes` holds for the definition `name`.
fn stored_of(bytes: Bytes, name: Bytes) -> Stored / {abort.raise} =
  match bin::decode(bytes, stored_bin()) {
    Ok(form) -> form,
    Err(e) ->
      panic(
        String::of_bytes(Bytes::concat_all([b"the stored body of `", name, b"` does not decode: "]))
          ++ bin::error_to_string(e),
      ),
  }

// --- Stored bodies back to source ------------------------------------------------------------

pub type Refusal = { message: Bytes, notes: List<Bytes> }

pub type Printing = | Printed(List<{ module: Bytes, text: Bytes }>) | Unprintable(Refusal)

type Part = {
  members: List<Bytes>,
  picks: List<List<Choice>>,
  hashes: List<Bytes>,
  names: List<Bytes>,
  public: List<Bool>,
  module: Bytes,
  binder: Bytes,
  printed: Bool,
}

/// `apart` is a printing that sets each body in a module of its own, away from the one that wrote it.
/// `meant` is what each definition names, where the caller said, by `meant_key`.
type Layout = {
  parts: List<Part>,
  by_hash: Map<Bytes, List<Slot>>,
  relink: Map<Bytes, Bytes>,
  apart: Bool,
  meant: Map<Bytes, Map<Bytes, Bool>>,
}

/// The import graph the print has laid down so far travels with the printer: a home is chosen
/// with it in view, so a reference never closes a cycle the source did not have. `meant` is every
/// name the definition being printed names, and empty where nothing said.
type BodyPrinter = {
  layout: Layout,
  part: Int,
  own: Bytes,
  graph: Map<Bytes, List<Bytes>>,
  meant: Map<Bytes, Bool>,
}

/// A hash is thirty-two bytes, so the name after it needs no separator.
fn meant_key(name: Bytes, hash: Bytes) -> Bytes = hash.concat(name)

/// What naming has gathered: each module the print imports and the binder it imports it under,
/// each hash a body refers to that no printed name holds, the slot each effect declaration was
/// met under, and the picks of the body's calls on values, `picked` of them read.
type Naming = {
  imports: Map<Bytes, Bytes>,
  missing: Map<Bytes, Bool>,
  slots: Map<Bytes, Int>,
  picks: List<Choice>,
  picked: Int,
}

/// How many value, type, row and label binders are in scope: each is named by its level.
type Depth = { values: Int, types: Int, rows: Int, labels: Int }

type Out<a> = { naming: Naming, node: a }

/// A pattern named, and the binders it leaves in scope.
type Bound = { naming: Naming, depth: Depth, node: Pattern }

/// A statement named, and the binders it leaves in scope.
type Said = { naming: Naming, depth: Depth, node: Stmt }

fn local_name(level: Int) -> Bytes = b"_l".concat(ascii_of_int(level))

fn type_var_name(level: Int) -> Bytes = b"_t".concat(ascii_of_int(level))

fn row_var_name(level: Int) -> Bytes = b"_e".concat(ascii_of_int(level))

fn label_name(level: Int) -> Bytes = b"_r".concat(ascii_of_int(level))

fn space_name(at: Int) -> Bytes = b"_s".concat(ascii_of_int(at))

fn short_hex(h: Bytes) -> Bytes / {abort.raise} = hex(h).slice(0, 12)

fn id(name: Bytes) -> Ident = { name: name, span: dummy_span() }

fn bare_q(name: Bytes) -> QName = { module: None, name: id(name), span: dummy_span() }

fn free_q(f: Free) -> QName =
  match f.module {
    Some(m) -> { module: Some(id(m)), name: id(f.name), span: dummy_span() },
    None -> bare_q(f.name),
  }

/// A qualified name as one identifier, as a call on a value writes the function it names in full.
fn q_text(q: QName) -> Bytes =
  match q.module { Some(m) -> Bytes::concat_all([m.name, b"::", q.name.name]), None -> q.name.name }

/// What a `{ e }` is to the parser: the block a branch, a test or a fallback is written as.
fn as_block(e: Expr) -> Expr =
  match e { EBlock(_) -> e, _ -> EBlock({ span: dummy_span(), tail: Some(e), stmts: [] }) }

// --- Naming references -------------------------------------------------------------------------

/// A name the module being printed may write: its own needs no export, a printed module is reprinted
/// `pub` throughout, and any other is reached as `binder::name`, which is what its own `pub` permits.
fn nameable(layout: Layout, slot: Slot, own: Bytes) -> Bool / {abort.raise} = {
  let p = layout.parts.get(slot.part);
  p.module == own || p.printed || p.public.get(slot.class)
}

/// Whether `from` reaches `target` along the import edges laid down. Each round reaches one edge
/// further, and a module past the first round has edges only if it is a key, so the rounds suffice.
fn reaches(g: Map<Bytes, List<Bytes>>, from: Bytes, target: Bytes) -> Bool = {
  let walked = range(0, g.len() + 1).fold(
    { seen: [from], frontier: [from] },
    |acc: { seen: List<Bytes>, frontier: List<Bytes> }, _round: Int|
      acc.frontier.fold(
        { seen: acc.seen, frontier: [] },
        |out: { seen: List<Bytes>, frontier: List<Bytes> }, m: Bytes|
          List::fold(
            match g.get(m) { Some(xs) -> xs, None -> [] },
            out,
            |o: { seen: List<Bytes>, frontier: List<Bytes> }, n: Bytes|
              if o.seen.contains(n) { o }
              else { { seen: o.seen.push(n), frontier: o.frontier.push(n) } },
          ),
      ),
  );
  walked.seen.contains(target)
}

/// Two definitions alike are one body under two names, and only some of those names are in reach:
/// an unreachable one is no candidate at all, since printing it names something that will not
/// resolve rather than something merely further away.
fn pick(
  layout: Layout,
  g: Map<Bytes, List<Bytes>>,
  mine: Map<Bytes, Bytes>,
  h: Bytes,
  own: Bytes,
  wanted: (Slot) -> Bool / {abort.raise},
) -> Option<Slot> / {abort.raise} = {
  // A home is safe when pointing at it adds no import edge that closes a cycle: the module's own,
  // one it already imports, or one that cannot reach it in the print so far. When every home
  // would close a cycle the nearest name stands and the print fails downstream as before; a
  // choice that is only worse is still better than a cycle.
  let edges = g.insert(own, mine.keys());
  let safe = |s: Slot| {
    let p = layout.parts.get(s.part);
    p.module == own || mine.contains(p.module) || !reaches(edges, p.module, own)
  };
  let score = |s: Slot| {
    let p = layout.parts.get(s.part);
    (if p.module == own { 0 } else { 4 }) + (if mine.contains(p.module) { 0 } else { 2 })
      + (if p.printed { 0 } else { 1 })
  };
  match layout.by_hash.get(h) {
    None -> None,
    Some(found) -> {
      let named = found.filter(|s: Slot| nameable(layout, s, own) && wanted(s));
      let pool = match named.filter(safe) { [] -> named, homes -> homes };
      pool.fold(None, |best: Option<Slot>, s: Slot|
        match best { Some(b) -> if score(s) < score(b) { Some(s) } else { best }, None -> Some(s) })
    },
  }
}

/// What a filled reference is: a hash and, for a member of the component being printed, its class.
type Target = { hash: Bytes, class: Int }

fn target(printer: BodyPrinter, n: Naming, r: Ref) -> Out<Target> / {abort.raise} =
  match r {
    Hashed(stored) -> {
      let h = match printer.layout.relink.get(stored) { Some(to) -> to, None -> stored };
      {
        naming: if printer.layout.by_hash.contains(h) { n }
        else { { ..n, missing: n.missing.insert(h, true) } },
        node: { hash: h, class: 0 - 1 },
      }
    },
    Member(c) -> {
      let hashes = if printer.part < 0 { [] } else { printer.layout.parts.get(printer.part).hashes };
      if c >= hashes.len() { panic("a reference to a member this component does not have") }
      else { { naming: n, node: { hash: hashes.get(c), class: c } } }
    },
    Itself -> panic("a stored body refers to its own definition by no hash"),
    ByName(_) -> panic("a stored body names a definition by its name"),
  }

/// The name `t` is printed under, its module imported where it is another's; `ctor` names a
/// constructor of the type `t` is.
fn named(printer: BodyPrinter, n: Naming, t: Target, ctor: Option<Bytes>) -> Out<QName> / {abort.raise} = {
  // One body under two modules' names: the checker tells them apart where the hash does not.
  let meant = |s: Slot| {
    let p = printer.layout.parts.get(s.part);
    printer.meant.contains(qualify(p.module, p.names.get(s.class)))
  };
  let told = match printer.layout.by_hash.get(t.hash) {
    Some(slots) -> slots.filter(meant).len() > 0,
    None -> false,
  };
  let found = if t.class >= 0 { Some({ part: printer.part, class: t.class }) } else {
    pick(printer.layout, printer.graph, n.imports, t.hash, printer.own, |s: Slot| !told || meant(s))
  };
  match found {
    // A body with no name this module may write is filed with the ones it has no body for: either
    // way the reference cannot be printed, and a refusal names it rather than a name standing in.
    None ->
      {
        naming: { ..n, missing: n.missing.insert(t.hash, true) },
        node: bare_q(match ctor { Some(c) -> c, None -> short_hex(t.hash) }),
      },
    Some(s) -> {
      let p = printer.layout.parts.get(s.part);
      let name = match ctor { Some(c) -> c, None -> p.names.get(s.class) };
      if p.module == printer.own { { naming: n, node: bare_q(name) } } else {
        {
          naming: { ..n, imports: n.imports.insert(p.module, p.binder) },
          node: { module: Some(id(p.binder)), name: id(name), span: dummy_span() },
        }
      }
    },
  }
}

fn named_ref(printer: BodyPrinter, n: Naming, r: Ref, ctor: Option<Bytes>) -> Out<QName> / {abort.raise} = {
  let t = target(printer, n, r);
  named(printer, t.naming, t.node, ctor)
}

/// `t`, a function a call on a value may be, with its module imported where the module being
/// printed may name it: the call is answered among the modules its own can see.
fn seen(printer: BodyPrinter, n: Naming, t: Target) -> Naming / {abort.raise} =
  if t.class >= 0 { n } else {
    match pick(printer.layout, printer.graph, n.imports, t.hash, printer.own, |_: Slot| true) {
      None -> n,
      Some(s) -> {
        let p = printer.layout.parts.get(s.part);
        if p.module == printer.own { n } else { { ..n, imports: n.imports.insert(p.module, p.binder) } }
      },
    }
  }

/// Whether `module` holds the body `hash` under `name`, where the module being printed may write it.
fn names_body(layout: Layout, module: Bytes, hash: Bytes, name: Bytes, own: Bytes) -> Bool / {abort.raise} =
  match layout.by_hash.get(hash) {
    None -> false,
    Some(found) ->
      found.fold(false, |held: Bool, s: Slot| {
        let p = layout.parts.get(s.part);
        held || (p.module == module && p.names.get(s.class) == name && nameable(layout, s, own))
      }),
  }

/// The binder a tagged literal is written with: one of another module that names the literal's
/// parser `parser`, and its filler `fill` where it has one, and that a string can touch without
/// making an interpolated or a byte string.
fn tag_binder(
  printer: BodyPrinter,
  n: Naming,
  t: Target,
  parser: Bytes,
  filler: Option<Bytes>,
) -> Out<Ident> / {abort.raise} = {
  let layout = printer.layout;
  let found = pick(layout, printer.graph, n.imports, t.hash, printer.own, |s: Slot| {
    let p = layout.parts.get(s.part);
    p.module != printer.own && p.names.get(s.class) == parser && p.binder != b"f" && p.binder != b"b"
      && (match filler {
        None -> true,
        Some(hash) -> names_body(layout, p.module, hash, b"fill", printer.own),
      })
  });
  match found {
    None -> { naming: { ..n, missing: n.missing.insert(t.hash, true) }, node: id(short_hex(t.hash)) },
    Some(s) -> {
      let p = layout.parts.get(s.part);
      { naming: { ..n, imports: n.imports.insert(p.module, p.binder) }, node: id(p.binder) }
    },
  }
}

/// Two effects declared alike share a hash, and only the slot tells them apart.
fn effect_named(printer: BodyPrinter, n: Naming, e: Effect<Ref, Int>) -> Out<QName> / {abort.raise} =
  match e {
    EffectUnbound(free) -> { naming: n, node: free_q(free) },
    Declared(r, slot) -> {
      let t = target(printer, n, r);
      match t.naming.slots.get(t.node.hash) {
        Some(was) -> if was != slot {
          panic("two distinct effects share one declaration, which a hash-keyed body cannot tell apart")
        } else { named(printer, t.naming, t.node, None) },
        None ->
          named(printer, { ..t.naming, slots: t.naming.slots.insert(t.node.hash, slot) }, t.node, None),
      }
    },
  }

fn value_named(printer: BodyPrinter, n: Naming, d: Depth, v: Value<Ref, Int>) -> Out<QName> / {abort.raise} =
  match v.named {
    Local(l) -> if l >= d.values { panic("a local that is not in scope") }
    else { { naming: n, node: bare_q(local_name(l)) } },
    Defined(r) -> named_ref(printer, n, r, None),
    Constructed(r, name) -> named_ref(printer, n, r, Some(name)),
    Unbound(free) -> { naming: n, node: free_q(free) },
  }

fn label_of(d: Depth, l: Label) -> Ident / {abort.raise} =
  match l {
    LabelParam(x) -> if x >= d.labels { panic("a label parameter that is not in scope") }
    else { id(label_name(x)) },
    LabelName(name) -> id(name),
  }

// --- Types -------------------------------------------------------------------------------------

fn tys(printer: BodyPrinter, n: Naming, d: Depth, ts: List<Ty<Ref, Int>>) -> Out<List<TypeExpr>> / {abort.raise} =
  ts.fold({ naming: n, node: [] }, |acc: Out<List<TypeExpr>>, t: Ty<Ref, Int>| {
    let x = ty_of(printer, acc.naming, d, t);
    { naming: x.naming, node: acc.node.push(x.node) }
  })

fn opt_ty(printer: BodyPrinter, n: Naming, d: Depth, t: Option<Ty<Ref, Int>>) -> Out<Option<TypeExpr>> / {abort.raise} =
  match t {
    None -> { naming: n, node: None },
    Some(x) -> {
      let y = ty_of(printer, n, d, x);
      { naming: y.naming, node: Some(y.node) }
    },
  }

fn type_named(printer: BodyPrinter, n: Naming, d: Depth, name: stored::TypeName<Ref>) -> Out<QName> / {abort.raise} =
  match name {
    TypeParam(l) -> if l >= d.types { panic("a type parameter out of scope") }
    else { { naming: n, node: bare_q(type_var_name(l)) } },
    TypeDefined(r) -> named_ref(printer, n, r, None),
    TypeUnbound(free) -> { naming: n, node: free_q(free) },
  }

fn ty_of(printer: BodyPrinter, n: Naming, d: Depth, t: Ty<Ref, Int>) -> Out<TypeExpr> / {abort.raise} =
  match t {
    Applied(TypeParam(l), _, args) ->
      if l >= d.types || args.len() > 0 { panic("a type parameter out of scope, or applied") }
      else { { naming: n, node: TVar(id(type_var_name(l))) } },
    Applied(name, _, args) -> {
      let q = type_named(printer, n, d, name);
      let xs = tys(printer, q.naming, d, args);
      {
        naming: xs.naming,
        node: TCon({ span: dummy_span(), name: q.node, args: xs.node, labels: [], rows: [] }),
      }
    },
    AppliedOver(name, _, args, labels, rows) -> {
      let q = type_named(printer, n, d, name);
      let xs = tys(printer, q.naming, d, args);
      let rs = rows.fold({ naming: xs.naming, node: [] }, |acc: Out<List<RowExpr>>, r: Row<Ref, Int>| {
        let x = row_of(printer, acc.naming, d, r);
        { naming: x.naming, node: acc.node.push(x.node) }
      });
      {
        naming: rs.naming,
        node: TCon({
          span: dummy_span(),
          name: q.node,
          args: xs.node,
          labels: labels.map(|l: Label| label_of(d, l)),
          rows: rs.node,
        }),
      }
    },
    Function(params, ret, r) -> {
      let ps = tys(printer, n, d, params);
      let rt = ty_of(printer, ps.naming, d, ret);
      let rw = opt_row(printer, rt.naming, d, r);
      { naming: rw.naming, node: TFn({ span: dummy_span(), params: ps.node, ret: rt.node, effects: rw.node }) }
    },
    Fields(fs) -> {
      let xs = fs.fold(
        { naming: n, node: [] },
        |acc: Out<List<{ name: Ident, ty: TypeExpr }>>, f: stored::TyField<Ref, Int>| {
          let x = ty_of(printer, acc.naming, d, f.ty);
          { naming: x.naming, node: acc.node.push({ name: id(f.name), ty: x.node }) }
        },
      );
      { naming: xs.naming, node: TRecord({ span: dummy_span(), fields: xs.node }) }
    },
    UnitType -> { naming: n, node: TUnit({ span: dummy_span() }) },
  }

fn opt_row(printer: BodyPrinter, n: Naming, d: Depth, r: Option<Row<Ref, Int>>) -> Out<Option<RowExpr>> / {abort.raise} =
  match r {
    None -> { naming: n, node: None },
    Some(x) -> {
      let y = row_of(printer, n, d, x);
      { naming: y.naming, node: Some(y.node) }
    },
  }

/// What a label `[*]` and `[*t]` and a plain one are to an atom or a clause.
type Labelled = { resource: Option<Ident>, every: Bool, binder: Option<Ident> }

fn labelled(d: Depth, l: Option<Label>) -> Labelled / {abort.raise} =
  match l {
    None -> { resource: None, every: false, binder: None },
    Some(LabelName(name)) -> if name == b"*" { { resource: None, every: true, binder: None } }
    else if name.starts_with(b"*") { { resource: None, every: true, binder: Some(id(name.slice(1, name.len()))) } }
    else { { resource: Some(id(name)), every: false, binder: None } },
    Some(x) -> { resource: Some(label_of(d, x)), every: false, binder: None },
  }

fn row_of(printer: BodyPrinter, n: Naming, d: Depth, r: Row<Ref, Int>) -> Out<RowExpr> / {abort.raise} = {
  let atoms = r.atoms.fold({ naming: n, node: [] }, |acc: Out<List<AtomExpr>>, a: stored::Atom<Ref, Int>| {
    let x = match a {
      Moded(e, mode, label, bounded) -> {
        let q = effect_named(printer, acc.naming, e);
        let l = labelled(d, label);
        {
          naming: q.naming,
          node: { eff: q.node, mode: mode, op: None, resource: l.resource, every: l.every, bounded: bounded, span: dummy_span() },
        }
      },
      OfOp(e, op, label, bounded) -> {
        let q = effect_named(printer, acc.naming, e);
        let l = labelled(d, label);
        {
          naming: q.naming,
          node: { eff: q.node, mode: MWrite, op: Some(id(op)), resource: l.resource, every: l.every, bounded: bounded, span: dummy_span() },
        }
      },
    };
    { naming: x.naming, node: acc.node.push(x.node) }
  });
  {
    naming: atoms.naming,
    node: {
      atoms: atoms.node,
      aliases: [],
      tail: match r.tail {
        None -> None,
        Some(RowParam(l)) -> if l >= d.rows { panic("a row parameter that is not in scope") }
        else { Some(id(row_var_name(l))) },
        Some(RowName(name)) -> Some(id(name)),
      },
      tail_bounded: r.bounded,
      span: dummy_span(),
    },
  }
}

// --- Literals and patterns ---------------------------------------------------------------------

fn width_name(at: Int) -> Bytes / {abort.raise} =
  match widths().at(at) { Some(w) -> w.name, None -> panic("a literal of no width the lexer has") }

fn lit_of(l: Literal) -> Lit / {abort.raise} =
  match l {
    IntLit(i) -> LInt(i),
    FixedLit(w, v) -> LFixed(width_name(w), v),
    WideLit(w, high, low) -> LWide(width_name(w), high, low),
    BoolLit(b) -> LBool(b),
    StrLit(s) -> LStr(s),
    BytesLit(b) -> LBytes(b),
    EmbeddedLit(_, _) -> panic("an embedded file where only a literal is written"),
    FloatLit(bits) -> LFloat(float_text(bits)),
    DecimalLit(mantissa, scale) -> LDec(decimal_text(mantissa, scale)),
    CharLit(v) -> LChar(v),
    UnitLit -> LUnit,
  }

fn pats(printer: BodyPrinter, n: Naming, d: Depth, ps: List<Pat<Ref, Int>>) -> { naming: Naming, depth: Depth, node: List<Pattern> } / {abort.raise} =
  ps.fold(
    { naming: n, depth: d, node: [] },
    |acc: { naming: Naming, depth: Depth, node: List<Pattern> }, p: Pat<Ref, Int>| {
      let x = pat_of(printer, acc.naming, acc.depth, p);
      { naming: x.naming, depth: x.depth, node: acc.node.push(x.node) }
    },
  )

fn pat_of(printer: BodyPrinter, n: Naming, d: Depth, p: Pat<Ref, Int>) -> Bound / {abort.raise} = {
  let s = dummy_span();
  match p {
    Wild -> { naming: n, depth: d, node: PWild({ span: s }) },
    Bind -> { naming: n, depth: { ..d, values: d.values + 1 }, node: PVar({ span: s, name: id(local_name(d.values)) }) },
    Again(l) -> if l >= d.values { panic("an alternative names a binder that is not in scope") }
    else { { naming: n, depth: d, node: PVar({ span: s, name: id(local_name(l)) }) } },
    LitPat(l) -> { naming: n, depth: d, node: PLit({ span: s, lit: lit_of(l) }) },
    RangePat(lo, hi) -> { naming: n, depth: d, node: PRange({ span: s, lo: lit_of(lo), hi: lit_of(hi) }) },
    CtorPat(c, args) -> {
      let q = match c {
        Constructed(r, name) -> named_ref(printer, n, r, Some(name)),
        Unbound(free) -> { naming: n, node: free_q(free) },
        _ -> panic("a pattern of no constructor"),
      };
      let xs = pats(printer, q.naming, d, args);
      { naming: xs.naming, depth: xs.depth, node: PCtor({ span: s, name: q.node, args: xs.node }) }
    },
    RecordPat(fs, rest) -> {
      let xs = fs.fold(
        { naming: n, depth: d, node: [] },
        |acc: { naming: Naming, depth: Depth, node: List<{ name: Ident, pat: Pattern }> }, f: stored::PatField<Ref, Int>| {
          let x = pat_of(printer, acc.naming, acc.depth, f.pat);
          { naming: x.naming, depth: x.depth, node: acc.node.push({ name: id(f.name), pat: x.node }) }
        },
      );
      { naming: xs.naming, depth: xs.depth, node: PRecord({ span: s, rest: rest, fields: xs.node }) }
    },
    ListPat(items, rest) -> {
      let xs = pats(printer, n, d, items);
      match rest {
        None -> { naming: xs.naming, depth: xs.depth, node: PList({ span: s, rest: None, items: xs.node }) },
        Some(r) -> {
          let y = pat_of(printer, xs.naming, xs.depth, r);
          { naming: y.naming, depth: y.depth, node: PList({ span: s, rest: Some(y.node), items: xs.node }) }
        },
      }
    },
    OrPat(alts) -> {
      let xs = pats(printer, n, d, alts);
      { naming: xs.naming, depth: xs.depth, node: POr({ span: s, alts: xs.node }) }
    },
  }
}

// --- Expressions -------------------------------------------------------------------------------

type SExpr = stored::Expr<Ref, Int, Int, Unit>

type SStmt = stored::Stmt<Ref, Int, Int, Unit>

fn exprs(printer: BodyPrinter, n: Naming, d: Depth, es: List<SExpr>) -> Out<List<Expr>> / {abort.raise} =
  es.fold({ naming: n, node: [] }, |acc: Out<List<Expr>>, e: SExpr| {
    let x = expr_of(printer, acc.naming, d, e);
    { naming: x.naming, node: acc.node.push(x.node) }
  })

fn opt_expr(printer: BodyPrinter, n: Naming, d: Depth, e: Option<SExpr>) -> Out<Option<Expr>> / {abort.raise} =
  match e {
    None -> { naming: n, node: None },
    Some(x) -> {
      let y = expr_of(printer, n, d, x);
      { naming: y.naming, node: Some(y.node) }
    },
  }

fn fields_of(
  printer: BodyPrinter,
  n: Naming,
  d: Depth,
  fs: List<stored::RecField<Ref, Int, Int, Unit>>,
) -> Out<List<RecField>> / {abort.raise} =
  fs.fold({ naming: n, node: [] }, |acc: Out<List<RecField>>, f: stored::RecField<Ref, Int, Int, Unit>| {
    let x = expr_of(printer, acc.naming, d, f.value);
    { naming: x.naming, node: acc.node.push({ name: id(f.name), value: x.node }) }
  })

/// A call on a value. Under the program's own names the value's type answers the call as it did;
/// set apart, a function of a type is a plain function under another name, so the call is printed
/// as a call of the one it calls. A printed function's parameters are named by their places, so an
/// argument the call names is named so too, where the check said which parameter it fills.
fn on_value_of(
  printer: BodyPrinter,
  n: Naming,
  d: Depth,
  c: stored::OnValueCall<Ref, Int, Int, Unit>,
) -> Out<Expr> / {abort.raise} = {
  let s = dummy_span();
  let base = expr_of(printer, n, d, c.base);
  let args = exprs(printer, base.naming, d, c.args);
  let given = fields_of(printer, args.naming, d, c.named);
  let pick: Choice = match given.naming.picks.at(given.naming.picked) {
    Some(x) -> x,
    None -> { callee: 0 - 1, named: [] },
  };
  let after = { ..given.naming, picked: given.naming.picked + 1 };
  let named_args = range(0, given.node.len()).map(|j: Int|
    {
      name: if pick.named.len() == given.node.len() { id(local_name(pick.named.get(j))) }
      else { given.node.get(j).name },
      value: given.node.get(j).value,
      span: s,
    });
  let labels = c.labels.map(|l: Label| label_of(d, l));
  let apart = printer.layout.apart;
  let local = match c.base { Var(v) -> match v.named { Local(_) -> true, _ -> false }, _ -> false };
  // A call on a local is written as a perform on it, which is how the parser reads one.
  let on_value = |field: Bytes|
    match base.node {
      EVar(v) -> if local && named_args.len() == 0 && labels.len() <= 1 && field.index_of(b"::") == None {
        EPerform({ span: s, eff: v.name, op: id(field), resource: labels.at(0), args: args.node })
      } else {
        EApp({
          span: s,
          func: EField({ span: s, base: base.node, field: id(field) }),
          named: named_args,
          args: args.node,
          labels: labels,
        })
      },
      _ ->
        EApp({
          span: s,
          func: EField({ span: s, base: base.node, field: id(field) }),
          named: named_args,
          args: args.node,
          labels: labels,
        }),
    };
  let plain = |callee: QName|
    EApp({ span: s, func: EVar({ span: s, name: callee }), named: named_args, args: List::concat([base.node], args.node), labels: labels });
  match c.callees {
    InFull(v) -> {
      let q = value_named(printer, after, d, v);
      { naming: q.naming, node: if apart { plain(q.node) } else { on_value(q_text(q.node)) } }
    },
    Among(refs) -> {
      let chosen = if apart { pick.callee } else { 0 - 1 };
      let walked = range(0, refs.len()).fold(
        { naming: after, node: None },
        |acc: Out<Option<QName>>, i: Int| {
          let t = target(printer, acc.naming, refs.get(i));
          if i == chosen {
            let q = named(printer, t.naming, t.node, None);
            { naming: q.naming, node: Some(q.node) }
          } else if chosen >= 0 { { naming: t.naming, node: acc.node } }
          else { { naming: seen(printer, t.naming, t.node), node: acc.node } }
        },
      );
      {
        naming: walked.naming,
        node: match walked.node { Some(q) -> plain(q), None -> on_value(c.name) },
      }
    },
  }
}

fn expr_of(printer: BodyPrinter, n: Naming, d: Depth, e: SExpr) -> Out<Expr> / {abort.raise} = {
  let s = dummy_span();
  match e {
    // The bytes are not in the form: what prints embeds the file named by the digest's hex, which a
    // load handed the bytes under that digest reads back as this literal.
    Constant(EmbeddedLit(digest, _)) ->
      {
        naming: n,
        node: EApp({
          span: s,
          func: EVar({ span: s, name: bare_q(b"embed") }),
          named: [],
          args: [ELit({ span: s, lit: LStr(hex(digest)) })],
          labels: [],
        }),
      },
    Constant(l) -> { naming: n, node: ELit({ span: s, lit: lit_of(l) }) },
    Unwritten -> { naming: n, node: EHole({ span: s, text: b"???" }) },
    Var(v) -> {
      let q = value_named(printer, n, d, v);
      { naming: q.naming, node: EVar({ span: s, name: q.node }) }
    },
    Binary(op, l, r, _) -> {
      let a = expr_of(printer, n, d, l);
      let b = expr_of(printer, a.naming, d, r);
      { naming: b.naming, node: EBinary({ span: s, op: op, lhs: a.node, rhs: b.node }) }
    },
    Unary(op, x) -> {
      let a = expr_of(printer, n, d, x);
      { naming: a.naming, node: EUnary({ span: s, op: op, operand: a.node }) }
    },
    Lambda(types, body) -> {
      let ts = types.fold({ naming: n, node: [] }, |acc: Out<List<Option<TypeExpr>>>, t: Option<Ty<Ref, Int>>| {
        let x = opt_ty(printer, acc.naming, d, t);
        { naming: x.naming, node: acc.node.push(x.node) }
      });
      let b = expr_of(printer, ts.naming, { ..d, values: d.values + types.len() }, body);
      {
        naming: b.naming,
        node: ELambda({
          span: s,
          body: b.node,
          params: range(0, types.len()).map(|i: Int|
            { name: id(local_name(d.values + i)), keep: false, ty: ts.node.get(i), cost: None, space: None, default: None, span: s }),
          ret: None,
        }),
      }
    },
    App(func, args, labels) -> {
      let f = expr_of(printer, n, d, func);
      let xs = exprs(printer, f.naming, d, args);
      {
        naming: xs.naming,
        node: EApp({ span: s, func: f.node, named: [], args: xs.node, labels: labels.map(|l: Label| label_of(d, l)) }),
      }
    },
    OnValue(c) -> on_value_of(printer, n, d, c),
    If(c, t, x) -> {
      let a = expr_of(printer, n, d, c);
      let b = expr_of(printer, a.naming, d, t);
      let f = expr_of(printer, b.naming, d, x);
      // `if c { t }` is the parser's own spelling of an `else ()`.
      let otherwise = match f.node {
        ELit(l) -> match l.lit { LUnit -> f.node, _ -> as_block(f.node) },
        EIf(_) -> f.node,
        _ -> as_block(f.node),
      };
      { naming: f.naming, node: EIf({ span: s, cond: a.node, then_branch: as_block(b.node), else_branch: otherwise }) }
    },
    Match(scrutinee, arms) -> {
      let a = expr_of(printer, n, d, scrutinee);
      let xs = arms.fold({ naming: a.naming, node: [] }, |acc: Out<List<MatchArm>>, arm: stored::Arm<Ref, Int, Int, Unit>| {
        let p = pat_of(printer, acc.naming, d, arm.pat);
        let g = opt_expr(printer, p.naming, p.depth, arm.guard);
        let b = expr_of(printer, g.naming, p.depth, arm.body);
        { naming: b.naming, node: acc.node.push({ pat: p.node, guard: g.node, body: b.node, span: s }) }
      });
      { naming: xs.naming, node: EMatch({ span: s, scrutinee: a.node, arms: xs.node }) }
    },
    Record(fs) -> {
      let xs = fields_of(printer, n, d, fs);
      { naming: xs.naming, node: ERecord({ span: s, fields: xs.node }) }
    },
    RecordUpdate(base, fs) -> {
      let a = expr_of(printer, n, d, base);
      let xs = fields_of(printer, a.naming, d, fs);
      { naming: xs.naming, node: ERecordUpdate({ span: s, base: a.node, fields: xs.node }) }
    },
    Field(base, name) -> {
      let a = expr_of(printer, n, d, base);
      { naming: a.naming, node: EField({ span: s, base: a.node, field: id(name) }) }
    },
    ListOf(items) -> {
      let xs = exprs(printer, n, d, items);
      { naming: xs.naming, node: EList({ span: s, items: xs.node }) }
    },
    Perform(eff, op, label, args) -> {
      let q = effect_named(printer, n, eff);
      let xs = exprs(printer, q.naming, d, args);
      {
        naming: xs.naming,
        node: EPerform({
          span: s,
          eff: q.node,
          op: id(op),
          resource: match label { Some(l) -> Some(label_of(d, l)), None -> None },
          args: xs.node,
        }),
      }
    },
    Handle(h) -> handle_of(printer, n, d, h),
    WithHold(resource, acquire, release, body) -> {
      let a = expr_of(printer, n, d, acquire);
      let r = expr_of(printer, a.naming, d, release);
      let b = expr_of(printer, r.naming, { ..d, values: d.values + 1 }, body);
      {
        naming: b.naming,
        node: EWithHold({
          span: s,
          resource: id(resource),
          acquire: a.node,
          release: r.node,
          binder: id(local_name(d.values)),
          body: b.node,
        }),
      }
    },
    Simulate(body) -> {
      let b = expr_of(printer, n, d, body);
      { naming: b.naming, node: ESimulate({ span: s, body: as_block(b.node) }) }
    },
    Parallel(branches) -> {
      let xs = exprs(printer, n, d, branches);
      { naming: xs.naming, node: EParallel({ span: s, branches: xs.node }) }
    },
    Tagged(parser, text) -> {
      let t = parsed_by(printer, n, parser);
      let tag = tag_binder(printer, t.naming, t.node, b"literal", None);
      {
        naming: tag.naming,
        node: ETagged({ span: s, tag: tag.node, text: text, quoted: s, holes: [] }),
      }
    },
    Filled(parser, filler, head, holes) -> {
      let t = parsed_by(printer, n, parser);
      let f = parsed_by(printer, t.naming, filler);
      let tag = tag_binder(printer, f.naming, t.node, b"compile", Some(f.node.hash));
      let hs = holes.fold({ naming: tag.naming, node: [] }, |acc: Out<List<Hole>>, h: stored::FilledHole<Ref, Int, Int, Unit>| {
        let v = expr_of(printer, acc.naming, d, h.value);
        { naming: v.naming, node: acc.node.push({ value: v.node, text: h.text, quoted: s }) }
      });
      { naming: hs.naming, node: ETagged({ span: s, tag: tag.node, text: head, quoted: s, holes: hs.node }) }
    },
    TryBlock(raised, body) -> {
      let r = match raised {
        None -> { naming: n, node: None },
        Some(x) -> {
          let q = effect_named(printer, n, x.effect);
          { naming: q.naming, node: Some({ eff: q.node, op: id(x.op) }) }
        },
      };
      let b = expr_of(printer, r.naming, d, body);
      { naming: b.naming, node: ETryBlock({ span: s, raise: r.node, body: as_block(b.node) }) }
    },
    Block(entries, tail) -> {
      let stmts = entries.fold(
        { naming: n, depth: d, node: [] },
        |acc: { naming: Naming, depth: Depth, node: List<Stmt> }, x: stored::Entry<Ref, Int, Int, Unit>|
          match x {
            One(st) -> {
              let y = stmt_of(printer, acc.naming, acc.depth, st);
              { naming: y.naming, depth: y.depth, node: acc.node.push(y.node) }
            },
            Commuting(_, members) ->
              members.fold(acc, |a: { naming: Naming, depth: Depth, node: List<Stmt> }, st: SStmt| {
                let y = stmt_of(printer, a.naming, a.depth, st);
                { naming: y.naming, depth: y.depth, node: a.node.push(y.node) }
              }),
          },
      );
      let t = opt_expr(printer, stmts.naming, stmts.depth, tail);
      { naming: t.naming, node: EBlock({ span: s, tail: t.node, stmts: stmts.node }) }
    },
  }
}

/// The value a tagged literal's parser or filler is: a definition, which names the module it is of.
fn parsed_by(printer: BodyPrinter, n: Naming, v: Value<Ref, Int>) -> Out<Target> / {abort.raise} =
  match v.named {
    Defined(r) -> target(printer, n, r),
    _ -> panic("a tagged literal whose parser is no definition"),
  }

/// A `handle`: its variables first, each seeing those before it, then its body, which sees none of
/// them, then its clauses and its `return`, which see them all.
fn handle_of(printer: BodyPrinter, n: Naming, d: Depth, h: stored::Handled<Ref, Int, Int, Unit>) -> Out<Expr> / {abort.raise} = {
  let s = dummy_span();
  let level = d.values;
  let vars = range(0, h.vars.len()).fold({ naming: n, node: [] }, |acc: Out<List<HandlerVar>>, i: Int| {
    let v = h.vars.get(i);
    let at = { ..d, values: level + i };
    let t = opt_ty(printer, acc.naming, at, v.ty);
    let x = expr_of(printer, t.naming, at, v.init);
    { naming: x.naming, node: acc.node.push({ name: id(local_name(level + i)), ty: t.node, init: x.node, span: s }) }
  });
  let body = expr_of(printer, vars.naming, d, h.body);
  let held = level + h.vars.len();
  let clauses = h.clauses.fold({ naming: body.naming, node: [] }, |acc: Out<List<HandleClause>>, c: stored::Clause<Ref, Int, Int, Unit>| {
    let q = effect_named(printer, acc.naming, c.effect);
    let l = labelled(d, c.label);
    let bound = held + c.params;
    let b = expr_of(printer, q.naming, { ..d, values: if c.resumes { bound + 1 } else { bound } }, c.body);
    {
      naming: b.naming,
      node: acc.node.push({
        eff: q.node,
        op: id(c.op),
        resource: l.resource,
        every_label: l.every,
        label_binder: l.binder,
        resume: if c.resumes { Some(id(local_name(bound))) } else { None },
        body: b.node,
        span: s,
        params: range(held, bound).map(|i: Int| id(local_name(i))),
      }),
    }
  });
  let ret = match h.ret {
    None -> { naming: clauses.naming, node: None },
    Some(r) -> {
      let b = expr_of(printer, clauses.naming, { ..d, values: held + 1 }, r);
      { naming: b.naming, node: Some({ binder: id(local_name(held)), body: b.node, span: s }) }
    },
  };
  { naming: ret.naming, node: EHandle({ span: s, body: body.node, ret: ret.node, clauses: clauses.node, vars: vars.node }) }
}

fn stmt_of(printer: BodyPrinter, n: Naming, d: Depth, st: SStmt) -> Said / {abort.raise} = {
  let s = dummy_span();
  match st {
    Let(t, v, p) -> {
      let a = opt_ty(printer, n, d, t);
      let b = expr_of(printer, a.naming, d, v);
      let c = pat_of(printer, b.naming, d, p);
      { naming: c.naming, depth: c.depth, node: SLet({ span: s, pat: c.node, ty: a.node, value: b.node }) }
    },
    LetElse(t, v, p, fallback) -> {
      let a = opt_ty(printer, n, d, t);
      let b = expr_of(printer, a.naming, d, v);
      let c = pat_of(printer, b.naming, d, p);
      let f = expr_of(printer, c.naming, c.depth, fallback);
      {
        naming: f.naming,
        depth: c.depth,
        node: SLetElse({ span: s, pat: c.node, ty: a.node, value: b.node, fallback: as_block(f.node) }),
      }
    },
    Effectful(x) -> {
      let a = expr_of(printer, n, d, x);
      { naming: a.naming, depth: d, node: SExpr(a.node) }
    },
    Assign(v, x) -> {
      let name = match v.named {
        Local(l) -> if l >= d.values { panic("a handler variable that is not in scope") } else { id(local_name(l)) },
        _ -> panic("an assignment to no handler variable"),
      };
      let a = expr_of(printer, n, d, x);
      { naming: a.naming, depth: d, node: SAssign({ span: s, name: name, value: a.node }) }
    },
  }
}

// --- Definitions -------------------------------------------------------------------------------

fn generics_of(g: stored::Generics) -> Generics =
  {
    types: range(0, g.types).map(|i: Int| id(type_var_name(i))),
    effects: range(0, g.rows).map(|i: Int| id(row_var_name(i))),
    labels: range(0, g.labels).map(|i: Int| id(label_name(i))),
  }

fn constraints_of(cs: List<stored::Constrained>) -> List<Constraint> =
  cs.map(|c: stored::Constrained|
    { deriver: c.deriver, deriver_span: dummy_span(), param: id(type_var_name(c.level)), span: dummy_span() })

/// Everything is `pub`: visibility is metadata the encoding erased. A type's `key`, `show` and
/// `numeric` follow it.
fn items_of(printer: BodyPrinter, n: Naming, form: Stored, name: Bytes) -> Out<List<Item>> / {abort.raise} = {
  let s = dummy_span();
  match form {
    FnOf(f) -> {
      let d = { values: 0, types: f.generics.types, rows: f.generics.rows, labels: f.generics.labels };
      let params = range(0, f.params.len()).fold({ naming: n, node: [] }, |acc: Out<List<Param>>, i: Int| {
        let p = f.params.get(i);
        let t = opt_ty(printer, acc.naming, d, p.ty);
        let x = opt_expr(printer, t.naming, d, p.default);
        {
          naming: x.naming,
          node: acc.node.push({
            name: id(local_name(i)),
            keep: p.kept,
            ty: t.node,
            cost: None,
            space: if p.spaced { Some(id(space_name(i))) } else { None },
            default: x.node,
            span: s,
          }),
        }
      });
      let ret = opt_ty(printer, params.naming, d, f.ret);
      let row = opt_row(printer, ret.naming, d, f.row);
      let inner = { ..d, values: f.params.len() };
      let measure = opt_expr(printer, row.naming, inner, f.decreases);
      let body = expr_of(printer, measure.naming, inner, f.body);
      {
        naming: body.naming,
        node: [
          IFn({
            vis: VPub,
            name: id(name),
            generics: generics_of(f.generics),
            params: params.node,
            ret: ret.node,
            effects: row.node,
            constraints: constraints_of(f.constraints),
            spec: [],
            returns: match f.returns {
              Unstated -> None,
              Fresh -> Some(ReturnsFresh(s)),
              ParamReturned(i) -> if i >= f.params.len() { panic("a `returns` clause names a parameter out of scope") }
              else { Some(ReturnsParam(id(local_name(i)))) },
            },
            reuse: None,
            transparent: None,
            baked: match f.baked { Some(_) -> Some(s), None -> None },
            decreases: measure.node,
            body: body.node,
            doc: None,
            span: s,
          }),
        ],
      }
    },
    TypeOf(t) -> {
      let d = { values: 0, types: t.generics.types, rows: t.generics.rows, labels: t.generics.labels };
      let body = match t.body {
        Alias(x) -> {
          let y = ty_of(printer, n, d, x);
          { naming: y.naming, node: TDAlias(y.node) }
        },
        Sum(_, variants) -> {
          let vs = variants.fold({ naming: n, node: [] }, |acc: Out<List<VariantDef>>, v: stored::Variant<Ref, Int>| {
            let fs = tys(printer, acc.naming, d, v.fields);
            { naming: fs.naming, node: acc.node.push({ name: id(v.name), fields: fs.node, doc: None, span: s }) }
          });
          { naming: vs.naming, node: TDSum(vs.node) }
        },
        Nominal(_, x) -> {
          let y = ty_of(printer, n, d, x);
          { naming: y.naming, node: TDNominal(y.node) }
        },
        Extern(_) -> { naming: n, node: TDExtern },
      };
      let stated = t.through.fold({ naming: body.naming, node: [] }, |acc: Out<List<Item>>, x: stored::Through<Ref, Int>| {
        let q = value_named(printer, acc.naming, d, x.by);
        {
          naming: q.naming,
          node: acc.node.push(IInstance({ kind: if x.key { NKey } else { NShow }, target: id(name), by: id(q_text(q.node)), span: s })),
        }
      });
      let numeric = t.numerics.fold({ naming: stated.naming, node: [] }, |acc: Out<List<{ op: Ident, by: Ident }>>, x: stored::Numeric<Ref, Int>| {
        let q = value_named(printer, acc.naming, d, x.by);
        { naming: q.naming, node: acc.node.push({ op: id(x.op), by: id(q_text(q.node)) }) }
      });
      let declared = IType({
        vis: VPub,
        // Set apart, what only the type's module may write is written wherever a body landed.
        opaque: if t.opaque && !printer.layout.apart { Some({ span: s, answer: [], take: [] }) } else { None },
        name: id(name),
        generics: generics_of(t.generics),
        constraints: constraints_of(t.constraints),
        body: body.node,
        doc: None,
        field_docs: [],
        span: s,
      });
      {
        naming: numeric.naming,
        node: List::concat([declared], stated.node).concat(
          if numeric.node.len() == 0 { [] }
          else { [INumeric({ target: id(name), ops: numeric.node, span: s })] },
        ),
      }
    },
    EffectOf(e) -> {
      let ops = e.ops.fold({ naming: n, node: [] }, |acc: Out<List<OpDef>>, op: stored::Op<Ref, Int>| {
        let d = { values: 0, types: op.types, rows: 0, labels: 0 };
        let ps = tys(printer, acc.naming, d, op.params);
        let rt = ty_of(printer, ps.naming, d, op.ret);
        {
          naming: rt.naming,
          node: acc.node.push({
            name: id(op.name),
            mode: op.mode,
            resource_param: op.resource,
            ty_params: range(0, op.types).map(|i: Int| id(type_var_name(i))),
            params: ps.node,
            ret: rt.node,
            doc: None,
            span: s,
          }),
        }
      });
      {
        naming: ops.naming,
        node: [IEffect({ vis: VPub, name: id(name), is_nondet: e.nondet, ops: ops.node, doc: None, span: s })],
      }
    },
    TestOf(t) -> match t.cases {
      Some(_) -> panic("a test over cases has no body to print without its table"),
      None -> {
        let body = expr_of(printer, n, { values: 0, types: 0, rows: 0, labels: 0 }, t.body);
        {
          naming: body.naming,
          node: [
            ITest({ name: name, name_span: s, is_nondet: t.nondet, cases: None, body: as_block(body.node), span: s }),
          ],
        }
      },
    },
    LawOf(_) -> panic("a law is never printed back"),
    SpecOf(_) -> panic("a specification clause is never printed back"),
  }
}

/// The text of `items`, as `fmt` prints a module of them alone.
fn items_text(items: List<Item>) -> Bytes / {abort.raise} = module_text({ doc: None, imports: [], items: items })

// --- Laying the print out ----------------------------------------------------------------------

type Holder = { module: Bytes, simple: Bytes, public: Bool }

type Component = {
  members: List<Bytes>,
  picks: List<List<Choice>>,
  hashes: List<Bytes>,
  id: Bytes,
  key: Bytes,
}

type Copied = { module: Bytes, names: List<Bytes>, public: List<Bool> }

type Parting = {
  seen: Map<Bytes, Bool>,
  declared: Map<Bytes, Bytes>,
  parts: List<Part>,
  bad: Option<Refusal>,
}

type Sheet = { items: List<Bytes>, imports: Map<Bytes, Bytes> }

fn refuse(message: Bytes, notes: List<Bytes>) -> Option<Refusal> =
  Some({ message: message, notes: notes })

fn comp_of(body: Bytes) -> Component / {abort.raise} =
  match envelope(body) {
    None -> panic("a stored body of a kind this build does not read"),
    Some(e) -> {
      let payload = body.slice(e.at, body.len());
      let id = blake3(payload);
      if e.kind == 0 {
        { members: [payload], picks: picks_of(body, e), hashes: [id], id: id, key: id }
      } else {
        match members_of(payload) {
          Some(ms) -> if e.class >= ms.len() { panic("a malformed component body") } else {
            {
              members: ms,
              picks: picks_of(body, e),
              hashes: range(0, ms.len()).map(|i: Int| member_hash(id, i)),
              id: id,
              key: member_hash(id, e.class),
            }
          },
          None -> panic("a malformed component body"),
        }
      }
    },
  }

/// The stored forms a body holds: its own, or each member's of the component it is part of.
pub fn stored_forms(body: Bytes) -> List<Stored> / {abort.raise} = {
  let c = comp_of(body);
  c.members.map(|m: Bytes| stored_of(m, short_hex(c.key)))
}

/// What kind of definition a member of a component is: two of one name and one kind are one
/// definition, and two of one name and two kinds are two.
fn kind_of(member: Bytes, name: Bytes) -> Int / {abort.raise} =
  match stored_of(member, name) {
    FnOf(_) -> 0,
    TypeOf(_) -> 1,
    EffectOf(_) -> 2,
    TestOf(_) -> 3,
    LawOf(_) -> 4,
    SpecOf(_) -> 5,
  }

fn listed(ns: List<Holder>) -> Bytes / {abort.raise} =
  backticked(ns.map(|n: Holder| qualify(n.module, n.simple)), b", ")

fn named_of(
  names: List<{ name: Bytes, hash: Bytes, public: Bool }>,
  keys: Map<Bytes, Bool>,
) -> { named: Map<Bytes, Map<Bytes, Holder>>, bad: Option<Refusal> } / {abort.raise} =
  names.fold(
    { named: Map::new(), bad: None },
    |acc: { named: Map<Bytes, Map<Bytes, Holder>>, bad: Option<Refusal> }, n: { name: Bytes, hash: Bytes, public: Bool }|
      match acc.bad {
        Some(_) -> acc,
        None -> {
          let simple = default_binder(n.name);
          if simple.len() == n.name.len() {
            { ..acc, bad: refuse(Bytes::concat_all([b"`", n.name, b"` names no module"]), []) }
          } else if !keys.contains(n.hash) {
            { ..acc, bad: refuse(Bytes::concat_all([b"`", n.name, b"` has no body"]), []) }
          } else {
            let module = n.name.slice(0, n.name.len() - simple.len() - 1);
            let had = match acc.named.get(n.hash) { Some(m) -> m, None -> Map::new() };
            {
              ..acc,
              named: acc.named.insert(
                n.hash,
                had.insert(Bytes::concat_all([module, b"\x00", simple]), {
                  module: module,
                  simple: simple,
                  public: n.public,
                }),
              ),
            }
          }
        },
      },
  )

fn copies(classes: List<List<Holder>>) -> Option<List<Copied>> / {abort.raise} =
  if classes.len() == 1 {
    Some(classes.get(0).map(|n: Holder| { module: n.module, names: [n.simple], public: [n.public] }))
  } else {
    let by_module = range(0, classes.len()).fold(
      Map::new(),
      |acc: Map<Bytes, List<List<Holder>>>, c: Int|
        classes.get(c).fold(acc, |a: Map<Bytes, List<List<Holder>>>, n: Holder| {
          let rows = match a.get(n.module) {
            Some(r) -> r,
            None -> classes.map(|k: List<Holder>| []),
          };
          a.insert(n.module, rows.set(c, rows.get(c).push(n)))
        }),
    );
    by_module.fold(Some([]), |acc: Option<List<Copied>>, m: Bytes, rows: List<List<Holder>>|
      match acc {
        None -> None,
        Some(out) -> {
          let count = rows.get(0).len();
          if rows.fold(false, |b: Bool, r: List<Holder>| b || r.len() != count) { None } else {
            Some(
              range(0, count).fold(out, |o: List<Copied>, k: Int|
                o.push({
                  module: m,
                  names: rows.map(|r: List<Holder>| r.get(k).simple),
                  public: rows.map(|r: List<Holder>| r.get(k).public),
                })),
            )
          }
        },
      })
  }

fn part_in(
  acc: Parting,
  component: Component,
  named: Map<Bytes, Map<Bytes, Holder>>,
  shipped: List<Bytes>,
) -> Parting / {abort.raise} = {
  let classes = component.hashes.map(|h: Bytes|
    match named.get(h) { Some(m) -> m.values(), None -> [] });
  let checked: Parting = range(0, component.hashes.len()).fold(acc, |a: Parting, i: Int|
    match a.bad {
      Some(_) -> a,
      None -> {
        let all = classes.get(i);
        let h = component.hashes.get(i);
        if all.len() == 0 {
          {
            ..a,
            bad: refuse(Bytes::concat_all([b"the body `", short_hex(h), b"` has no name"]), []),
          }
        } else {
          let kind = kind_of(component.members.get(i), qualify(all.get(0).module, all.get(0).simple));
          // Two modules declaring one effect alike declare one effect, so a body performing it
          // cannot be printed back under a name: either module's would be a different claim about
          // what it does.
          if kind == 2 && all.len() > 1 {
            {
              ..a,
              bad: refuse(
                listed(all).concat(
                  b" are one effect declaration, so a body cannot say which it performs",
                ),
                [b"make the declarations differ, or keep one of them"],
              ),
            }
          } else {
            all.fold(a, |b: Parting, n: Holder| {
              let q = qualify(n.module, n.simple);
              let key = byte_of_int(kind).concat(q);
              match b.declared.get(key) {
                Some(other) -> if other == h || is_some(b.bad) { b } else {
                  {
                    ..b,
                    bad: refuse(
                      Bytes::concat_all([b"`", q, b"` names two different definitions"]),
                      [],
                    ),
                  }
                },
                None -> { ..b, declared: b.declared.insert(key, h) },
              }
            })
          }
        }
      },
    });
  match checked.bad {
    Some(_) -> checked,
    None -> match copies(classes) {
      None ->
        {
          ..checked,
          bad: refuse(
            listed(classes.fold([], |o: List<Holder>, ns: List<Holder>| o.concat(ns))).concat(
              b" are a mutually recursive group in which two definitions share one body, so a call cannot say which it reaches",
            ),
            [b"make the definitions differ, or keep one of them"],
          ),
        },
      Some(cs) ->
        {
          ..checked,
          parts: cs.fold(checked.parts, |ps: List<Part>, cp: Copied|
            ps.push({
              members: component.members,
              picks: component.picks,
              hashes: component.hashes,
              names: cp.names,
              public: cp.public,
              module: cp.module,
              binder: default_binder(cp.module),
              printed: !shipped.contains(cp.module),
            })),
        },
    },
  }
}

fn is_some(o: Option<Refusal>) -> Bool = match o { Some(_) -> true, None -> false }

/// Each module's binder: its last segment, or its whole path joined where two share one.
fn binders(modules: List<Bytes>) -> Map<Bytes, Bytes> / {abort.raise} = {
  let sharing = modules.fold(Map::new(), |acc: Map<Bytes, Int>, m: Bytes|
    acc.insert(
      default_binder(m),
      1 + (match acc.get(default_binder(m)) { Some(k) -> k, None -> 0 }),
    ));
  let start = {
    taken: sharing.fold(Map::new(), |acc: Map<Bytes, Bool>, b: Bytes, k: Int| acc.insert(b, true)),
    out: Map::new(),
  };
  let done = modules.fold(
    start,
    |s: { taken: Map<Bytes, Bool>, out: Map<Bytes, Bytes> }, m: Bytes| {
      let own = default_binder(m);
      if match sharing.get(own) { Some(k) -> k == 1, None -> true } {
        { ..s, out: s.out.insert(m, own) }
      } else {
        let base = Bytes::join(m.split(b"."), b"_");
        let found = iterate(
          { n: 1, binder: base },
          2 * modules.len() + 2,
          |t: { n: Int, binder: Bytes }|
            if s.taken.contains(t.binder) {
              Continue({
                n: t.n + 1,
                binder: Bytes::concat_all([base, b"_", ascii_of_int(t.n + 1)]),
              })
            } else { Stop(t) },
        );
        { taken: s.taken.insert(found.binder, true), out: s.out.insert(m, found.binder) }
      }
    },
  );
  done.out
}

fn layout_of(
  parts: List<Part>,
  relink: Map<Bytes, Bytes>,
  apart: Bool,
  meant: Map<Bytes, Map<Bytes, Bool>>,
) -> Layout / {abort.raise} = {
  let bound = binders(
    parts.fold(Map::new(), |acc: Map<Bytes, Bool>, part: Part| acc.insert(part.module, true)).keys(
    ),
  );
  let placed = parts.map(|part: Part|
    { ..part, binder: match bound.get(part.module) { Some(b) -> b, None -> part.binder } });
  {
    parts: placed,
    by_hash: range(0, placed.len()).fold(Map::new(), |acc: Map<Bytes, List<Slot>>, u: Int| {
      let hashes = placed.get(u).hashes;
      range(0, hashes.len()).fold(acc, |a: Map<Bytes, List<Slot>>, c: Int|
        a.insert(
          hashes.get(c),
          List::push(match a.get(hashes.get(c)) { Some(xs) -> xs, None -> [] }, {
            part: u,
            class: c,
          }),
        ))
    }),
    relink: relink,
    apart: apart,
    meant: meant,
  }
}

fn fresh_naming(imports: Map<Bytes, Bytes>, missing: Map<Bytes, Bool>, picks: List<Choice>) -> Naming =
  { imports: imports, missing: missing, slots: Map::new(), picks: picks, picked: 0 }

fn print_parts(
  layout: Layout,
) -> { modules: Map<Bytes, Sheet>, missing: Map<Bytes, Bool>, graph: Map<Bytes, List<Bytes>> } / {abort.raise} =
  range(0, layout.parts.len()).fold(
    { modules: Map::new(), missing: Map::new(), graph: Map::new() },
    |acc: { modules: Map<Bytes, Sheet>, missing: Map<Bytes, Bool>, graph: Map<Bytes, List<Bytes>> }, u: Int| {
      let p = layout.parts.get(u);
      if !p.printed { acc } else {
        let x = { layout: layout, part: u, own: p.module, graph: acc.graph, meant: Map::new() };
        let walked = range(0, p.members.len()).fold(
          { imports: Map::new(), missing: acc.missing, texts: [] },
          |w: { imports: Map<Bytes, Bytes>, missing: Map<Bytes, Bool>, texts: List<Bytes> }, c: Int| {
            let name = p.names.get(c);
            let printer = {
              ..x,
              meant: match layout.meant.get(meant_key(qualify(p.module, name), p.hashes.get(c))) {
                Some(names) -> names,
                None -> Map::new(),
              },
            };
            let g = items_of(
              printer,
              fresh_naming(w.imports, w.missing, match p.picks.at(c) { Some(x) -> x, None -> [] }),
              stored_of(p.members.get(c), qualify(p.module, name)),
              name,
            );
            { imports: g.naming.imports, missing: g.naming.missing, texts: w.texts.push(items_text(g.node)) }
          },
        );
        let had = match acc.modules.get(p.module) {
          Some(m) -> m,
          None -> { items: [], imports: Map::new() },
        };
        let imports = had.imports.merge(walked.imports.remove(p.module));
        {
          modules: acc.modules.insert(p.module, { items: had.items.concat(walked.texts), imports: imports }),
          missing: walked.missing,
          graph: acc.graph.insert(p.module, imports.keys()),
        }
      }
    },
  )

fn print_tests(
  layout: Layout,
  g: Map<Bytes, List<Bytes>>,
  tests: List<Bytes>,
  missing: Map<Bytes, Bool>,
) -> { imports: Map<Bytes, Bytes>, missing: Map<Bytes, Bool>, texts: List<Bytes> } / {abort.raise} = {
  let x = { layout: layout, part: 0 - 1, own: b"", graph: g, meant: Map::new() };
  range(0, tests.len()).fold(
    { imports: Map::new(), missing: missing, texts: [] },
    |w: { imports: Map<Bytes, Bytes>, missing: Map<Bytes, Bool>, texts: List<Bytes> }, i: Int| {
      let body = tests.get(i);
      let label = b"t".concat(ascii_of_int(i));
      match envelope(body) {
        Some(e) -> if e.kind != 0 { panic("a test body that is not a solo body") } else {
          let t = items_of(
            x,
            fresh_naming(w.imports, w.missing, match picks_of(body, e).at(0) { Some(p) -> p, None -> [] }),
            stored_of(body.slice(e.at, body.len()), label),
            label,
          );
          { imports: t.naming.imports, missing: t.naming.missing, texts: w.texts.push(items_text(t.node)) }
        },
        None -> panic("a test body that is not a solo body"),
      }
    },
  )
}

fn sheet_text(sheet: Sheet) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    sheet.imports.fold([], |acc: List<Bytes>, m: Bytes, b: Bytes|
      acc.push(
        Bytes::concat_all([
          b"import ",
          m,
          if b == default_binder(m) { b"" } else { b" as ".concat(b) },
          b"\n",
        ]),
      )).concat(
      sheet.items.map(|it: Bytes| Bytes::concat_all([b"\n", it])),
    ),
  )

/// `public` is what the name's own module exports: a reference from a module that is printed reaches
/// a shipped one only through it, so a name filed without it is never the one a reference is printed
/// under.
///
/// `apart` says the names set each body in a module of its own, as a search's do. What only a
/// type's module may write is then written wherever a body landed, so an `opaque` type is printed
/// open; it runs as it did, and is no longer stored under the hash it was.
///
/// `meant` is what each definition names, for those the caller knows it of. Two modules that
/// declare one thing alike file one body under two names, which the checker may still tell apart;
/// a reference to it from a definition listed here is printed under the name that definition
/// names, and from any other under the nearest.
pub fn print_bodies(
  bodies: List<Bytes>,
  names: List<{ name: Bytes, hash: Bytes, public: Bool }>,
  tests: List<Bytes>,
  relink: List<{ from: Bytes, to: Bytes }>,
  shipped: List<Bytes>,
  apart: Bool = false,
  meant: List<{ name: Bytes, hash: Bytes, names: List<Bytes> }> = [],
) -> Printing / {abort.raise} = {
  let comps = bodies.map(comp_of);
  let n = named_of(
    names,
    comps.fold(Map::new(), |acc: Map<Bytes, Bool>, component: Component|
      acc.insert(component.key, true)),
  );
  let parted: Parting = match n.bad {
    Some(_) -> { seen: Map::new(), declared: Map::new(), parts: [], bad: n.bad },
    None ->
      comps.fold(
        { seen: Map::new(), declared: Map::new(), parts: [], bad: None },
        |acc: Parting, component: Component|
          if is_some(acc.bad) || acc.seen.contains(component.id) { acc } else {
            part_in(
              { ..acc, seen: acc.seen.insert(component.id, true) },
              component,
              n.named,
              shipped,
            )
          },
      ),
  };
  match parted.bad {
    Some(r) -> Unprintable(r),
    None -> {
      let l = layout_of(
        parted.parts,
        relink.fold(Map::new(), |acc: Map<Bytes, Bytes>, r: { from: Bytes, to: Bytes }|
          acc.insert(r.from, r.to)),
        apart,
        meant.fold(
          Map::new(),
          |acc: Map<Bytes, Map<Bytes, Bool>>, n: { name: Bytes, hash: Bytes, names: List<Bytes> }|
            acc.insert(
              meant_key(n.name, n.hash),
              n.names.fold(Map::new(), |held: Map<Bytes, Bool>, name: Bytes|
                held.insert(name, true)),
            ),
        ),
      );
      let printed = print_parts(l);
      let t = print_tests(l, printed.graph, tests, printed.missing);
      let missing = t.missing.keys();
      if missing.len() > 0 {
        Unprintable({
          message: ascii_of_int(missing.len()).concat(
            b" definitions a body refers to are not among the bodies it can name",
          ),
          notes: [
            b"missing: ".concat(Bytes::join(missing.take(min(8, missing.len())).map(short_hex), b", ")),
          ],
        })
      } else {
        let texts = printed.modules.fold(
          [],
          |acc: List<{ module: Bytes, text: Bytes }>, m: Bytes, sheet: Sheet|
            acc.push({ module: m, text: sheet_text(sheet) }),
        );
        Printed(if tests.len() == 0 { texts } else {
          texts.push({ module: b"ply_tests", text: sheet_text({ items: t.texts, imports: t.imports }) })
        })
      }
    },
  }
}
