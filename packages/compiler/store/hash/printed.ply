//! Stored bodies printed back to source: what a mixture and an artifact print. A body decodes to
//! its stored form (`stored.stored_bin`), each reference in it is named where the print can name
//! it, and `fmt` prints the syntax that makes.

import compiler.syntax.parsing (Ident, QName, Span, dummy_span)
import compiler.syntax.lexer (widths)
import compiler.syntax.patterns (Pattern, PWild, PVar, PLit, PRange, PCtor, PRecord, PList, POr,
                                 Lit, LInt, LFixed, LWide, LBool, LStr, LBytes, LFloat, LDec, LChar,
                                 LUnit)
import compiler.syntax.exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock,
                              ERecord, ERecordUpdate, EField, EList, EPerform, EHandle, EWithHold,
                              ESimulate, EParallel, ETagged, EHole, ETryBlock, Stmt, SLet, SLetElse,
                              SExpr, SAssign, Param, MatchArm, HandleClause, ReturnClause,
                              HandlerVar, RecField, NamedArg, Hole, RaiseName)
import compiler.syntax.type_syntax (TypeExpr, TVar, TCon, TFn, TRecord, TUnit, RowExpr, AtomExpr,
                                    Mode, MWrite, Generics)
import compiler.syntax.items (Module, Item, IFn, IType, IEffect, ITest, IInstance, INumeric, FnDef,
                              TypeDef, TDAlias, TDSum, TDNominal, TDExtern, VariantDef, EffectDef,
                              OpDef, TestDef, Constraint, ReturnsFresh, ReturnsParam, VPub, NHost)
import compiler.syntax.fmt (module_text)
import compiler.syntax.spelling (float_text, decimal_text)
import compiler.check.resolve.tables (qualify, default_binder, backticked)
import std.bin
import std.bytes (ascii_of_int)
import std.hash (blake3)
import std.list
import std.option
import std.bytes
import std.string
import compiler.store.hash.encoding (hex, Choice, Slot)
import compiler.store.hash.forms (member_hash)
import compiler.store.hash.stored
import compiler.store.hash.stored (Reference, Hashed, Member, Itself, ByName, Free, Literal,
                                   IntLiteral, FixedLiteral, WideLiteral, BoolLiteral,
                                   StringLiteral, BytesLiteral, EmbeddedLiteral, FloatLiteral,
                                   DecimalLiteral, CharLiteral, UnitLiteral, Local, Defined,
                                   Constructed, Unbound, Value, Label, LabelParameter, LabelName,
                                   Effect, Declared, EffectUnbound, TypeParameter, TypeDefined,
                                   TypeUnbound, Type, Applied, AppliedOver, Function, Fields,
                                   UnitType, RowParameter, RowName, Row, Moded, OfOperation, Wild,
                                   Bind, Again, LiteralPattern, RangePattern, ConstructorPattern,
                                   RecordPattern, ListPattern, OrPattern, InFull, Among, Constant,
                                   Unwritten, Variable, Binary, Unary, Lambda, Call, OnValue, If,
                                   Match, Record, RecordUpdate, Field, ListOf, Perform, Handle,
                                   WithHold, Simulate, Parallel, Tagged, Filled, TryBlock, Block,
                                   One, Commuting, Let, LetElse, Effectful, Assign, Unstated, Fresh,
                                   ParameterReturned, Alias, Sum, Nominal, Extern, FunctionOf,
                                   TypeOf, EffectOf, TestOf, LawOf, SpecOf, Stored, stored_bin)

// --- The hash table ----------------------------------------------------------------------

/// Where a stored body's parts stand: its kind, a member's class, the choices each member's calls
/// on values made from `picks` to `at`, and the bytes its hash is taken over from `at`.
type Envelope = { kind: Int, class: Int, picks: Int, at: Int }

pub fn envelope(body: Bytes) -> Option<Envelope> = {
  let kind = if body.len() == 0 { 0 - 1 } else { body.at(0) };
  let framed = |class: Int, from: Int|
    match body.u32_at(from) {
      Some(n) -> if from + 4 + n > body.len() { None }
      else { Some({ kind: kind, class: class, picks: from + 4, at: from + 4 + n }) },
      None -> None,
    };
  if kind == 0 { framed(0, 1) }
  else if kind == 1 { match body.u32_at(1) { Some(class) -> framed(class, 5), None -> None } }
  else { None }
}

/// The choices of a body `e` opens, a list a member.
pub fn picks_of(body: Bytes, e: Envelope) -> List<List<Choice>> / {abort.raise} = {
  let read = |at: Int| match body.u32_at(at) { Some(n) -> n, None -> panic("a malformed body") };
  iterate(
    { at: e.picks, lists: [] },
    e.at - e.picks + 1,
    |s: { at: Int, lists: List<List<Choice>> }|
      if s.at >= e.at { Stop(s.lists) } else {
        let list = range(0, read(s.at)).fold(
          { at: s.at + 4, choices: [] },
          |acc: { at: Int, choices: List<Choice> }, _i: Int| {
            let k = read(acc.at + 4);
            {
              at: acc.at + 8 + 4 * k,
              choices: acc.choices.push({
                callee: read(acc.at) - 1,
                named: range(0, k).map(|j: Int| read(acc.at + 8 + 4 * j)),
              }),
            }
          },
        );
        Continue({ at: list.at, lists: s.lists.push(list.choices) })
      },
  )
}

/// The members of a component's packed bytes: a count, then each member's length and bytes.
fn members_of(packed: Bytes) -> Option<List<Bytes>> / {abort.raise} =
  match packed.u32_at(0) {
    None -> None,
    Some(n) -> {
      let read = range(0, n).fold(
        Some({ at: 4, members: [] }),
        |acc: Option<{ at: Int, members: List<Bytes> }>, _i: Int|
          match acc {
            None -> None,
            Some(s) -> match packed.u32_at(s.at) {
              None -> None,
              Some(len) -> if s.at + 4 + len > packed.len() { None } else {
                Some({
                  at: s.at + 4 + len,
                  members: s.members.push(packed.slice(s.at + 4, s.at + 4 + len)),
                })
              },
            },
          },
      );
      match read {
        Some(s) -> if s.at == packed.len() { Some(s.members) } else { None },
        None -> None,
      }
    },
  }

/// The stored form of the body `bytes` holds for the definition `name`.
fn stored_of(bytes: Bytes, name: Bytes) -> Stored / {abort.raise} =
  match bin::decode(bytes, stored_bin()) {
    Ok(form) -> form,
    Err(e) ->
      panic(
        String::of_bytes(Bytes::concat_all([b"the stored body of `", name, b"` does not decode: "]))
          ++ bin::error_to_string(e),
      ),
  }

// --- Stored bodies back to source ------------------------------------------------------------

pub type Refusal = { message: Bytes, notes: List<Bytes> }

pub type Printing = | Printed(List<{ module: Bytes, text: Bytes }>) | Unprintable(Refusal)

type Part = {
  members: List<Bytes>,
  picks: List<List<Choice>>,
  hashes: List<Bytes>,
  names: List<Bytes>,
  public: List<Bool>,
  module: Bytes,
  binder: Bytes,
  printed: Bool,
}

/// `apart` is a printing that sets each body in a module of its own, away from the one that wrote it.
/// `meant` is what each definition names, where the caller said, by `meant_key`.
type Layout = {
  parts: List<Part>,
  by_hash: Map<Bytes, List<Slot>>,
  relink: Map<Bytes, Bytes>,
  apart: Bool,
  meant: Map<Bytes, Map<Bytes, Bool>>,
}

/// The import graph the print has laid down so far travels with the printer: a home is chosen
/// with it in view, so a reference never closes a cycle the source did not have. `meant` is every
/// name the definition being printed names, and empty where nothing said.
type BodyPrinter = {
  layout: Layout,
  part: Int,
  own: Bytes,
  graph: Map<Bytes, List<Bytes>>,
  meant: Map<Bytes, Bool>,
}

/// A hash is thirty-two bytes, so the name after it needs no separator.
fn meant_key(name: Bytes, hash: Bytes) -> Bytes = hash.concat(name)

/// What naming has gathered: each module the print imports and the binder it imports it under,
/// each hash a body refers to that no printed name holds, the slot each effect declaration was
/// met under, and the picks of the body's calls on values, `picked` of them read.
type Naming = {
  imports: Map<Bytes, Bytes>,
  missing: Map<Bytes, Bool>,
  slots: Map<Bytes, Int>,
  picks: List<Choice>,
  picked: Int,
}

/// How many value, type, row and label binders are in scope: each is named by its level.
type Depth = { values: Int, types: Int, rows: Int, labels: Int }

/// A node the namer built, and the naming it leaves.
type Spelled<a> = { naming: Naming, node: a }

/// A pattern named, and the binders it leaves in scope.
type Bound = { naming: Naming, depth: Depth, node: Pattern }

/// Patterns named in order, and the binders they leave in scope.
type BoundAll = { naming: Naming, depth: Depth, node: List<Pattern> }

/// A statement named, and the binders it leaves in scope.
type Said = { naming: Naming, depth: Depth, node: Stmt }

fn local_name(level: Int) -> Bytes = b"_l".concat(ascii_of_int(level))

fn type_var_name(level: Int) -> Bytes = b"_t".concat(ascii_of_int(level))

fn row_var_name(level: Int) -> Bytes = b"_e".concat(ascii_of_int(level))

fn label_name(level: Int) -> Bytes = b"_r".concat(ascii_of_int(level))

fn space_name(at: Int) -> Bytes = b"_s".concat(ascii_of_int(at))

fn short_hex(h: Bytes) -> Bytes / {abort.raise} = hex(h).slice(0, 12)

fn ident(name: Bytes) -> Ident = { name: name, span: dummy_span() }

fn unqualified(name: Bytes) -> QName = { module: None, name: ident(name), span: dummy_span() }

fn free_name(free: Free) -> QName =
  match free.module {
    Some(module) -> { module: Some(ident(module)), name: ident(free.name), span: dummy_span() },
    None -> unqualified(free.name),
  }

/// A qualified name as one identifier, as a call on a value writes the function it names in full.
fn qualified_text(name: QName) -> Bytes =
  match name.module {
    Some(module) -> Bytes::concat_all([module.name, b"::", name.name.name]),
    None -> name.name.name,
  }

/// What a `{ e }` is to the parser: the block a branch, a test or a fallback is written as.
fn as_block(expression: Expr) -> Expr =
  match expression {
    EBlock(_) -> expression,
    _ -> EBlock({ span: dummy_span(), tail: Some(expression), stmts: [] }),
  }

/// `items` named in order, each under the naming the ones before it left.
fn named_in_turn<a, b>(
  naming: Naming,
  items: List<a>,
  name_one: (Naming, a) -> Spelled<b> / {abort.raise},
) -> Spelled<List<b>> / {abort.raise} =
  items.fold({ naming: naming, node: [] }, |acc: Spelled<List<b>>, item: a| {
    let spelled = name_one(acc.naming, item);
    { naming: spelled.naming, node: acc.node.push(spelled.node) }
  })

/// `item` named, where there is one.
fn named_if_any<a, b>(
  naming: Naming,
  item: Option<a>,
  name_one: (Naming, a) -> Spelled<b> / {abort.raise},
) -> Spelled<Option<b>> / {abort.raise} =
  match item {
    None -> { naming: naming, node: None },
    Some(present) -> {
      let spelled = name_one(naming, present);
      { naming: spelled.naming, node: Some(spelled.node) }
    },
  }

// --- Naming references -------------------------------------------------------------------------

/// A name the module being printed may write: its own needs no export, a printed module is reprinted
/// `pub` throughout, and any other is reached as `binder::name`, which is what its own `pub` permits.
fn nameable(layout: Layout, slot: Slot, own: Bytes) -> Bool / {abort.raise} = {
  let p = layout.parts.get(slot.part);
  p.module == own || p.printed || p.public.get(slot.class)
}

/// Whether `from` reaches `target` along the import edges laid down. Each round reaches one edge
/// further, and a module past the first round has edges only if it is a key, so the rounds suffice.
fn reaches(g: Map<Bytes, List<Bytes>>, from: Bytes, target: Bytes) -> Bool = {
  let walked = range(0, g.len() + 1).fold(
    { seen: [from], frontier: [from] },
    |acc: { seen: List<Bytes>, frontier: List<Bytes> }, _round: Int|
      acc.frontier.fold(
        { seen: acc.seen, frontier: [] },
        |out: { seen: List<Bytes>, frontier: List<Bytes> }, m: Bytes|
          List::fold(
            match g.get(m) { Some(xs) -> xs, None -> [] },
            out,
            |o: { seen: List<Bytes>, frontier: List<Bytes> }, n: Bytes|
              if o.seen.contains(n) { o }
              else { { seen: o.seen.push(n), frontier: o.frontier.push(n) } },
          ),
      ),
  );
  walked.seen.contains(target)
}

/// Two definitions alike are one body under two names, and only some of those names are in reach:
/// an unreachable one is no candidate at all, since printing it names something that will not
/// resolve rather than something merely further away.
fn pick(
  layout: Layout,
  g: Map<Bytes, List<Bytes>>,
  mine: Map<Bytes, Bytes>,
  h: Bytes,
  own: Bytes,
  wanted: (Slot) -> Bool / {abort.raise},
) -> Option<Slot> / {abort.raise} = {
  // A home is safe when pointing at it adds no import edge that closes a cycle: the module's own,
  // one it already imports, or one that cannot reach it in the print so far. When every home
  // would close a cycle the nearest name stands and the print fails downstream as before; a
  // choice that is only worse is still better than a cycle.
  let edges = g.insert(own, mine.keys());
  let safe = |s: Slot| {
    let p = layout.parts.get(s.part);
    p.module == own || mine.contains(p.module) || !reaches(edges, p.module, own)
  };
  let score = |s: Slot| {
    let p = layout.parts.get(s.part);
    (if p.module == own { 0 } else { 4 }) + (if mine.contains(p.module) { 0 } else { 2 })
      + (if p.printed { 0 } else { 1 })
  };
  match layout.by_hash.get(h) {
    None -> None,
    Some(found) -> {
      let named = found.filter(|s: Slot| nameable(layout, s, own) && wanted(s));
      let pool = match named.filter(safe) { [] -> named, homes -> homes };
      pool.fold(None, |best: Option<Slot>, s: Slot|
        match best { Some(b) -> if score(s) < score(b) { Some(s) } else { best }, None -> Some(s) })
    },
  }
}

/// What a filled reference is: a hash and, for a member of the component being printed, its class.
type Target = { hash: Bytes, class: Int }

fn target_of(
  printer: BodyPrinter,
  naming: Naming,
  reference: Reference,
) -> Spelled<Target> / {abort.raise} =
  match reference {
    Hashed(written) -> {
      let hash = match printer.layout.relink.get(written) { Some(to) -> to, None -> written };
      {
        naming: if printer.layout.by_hash.contains(hash) { naming }
        else { { ..naming, missing: naming.missing.insert(hash, true) } },
        node: { hash: hash, class: 0 - 1 },
      }
    },
    Member(class) -> {
      let hashes = if printer.part < 0 { [] }
      else { printer.layout.parts.get(printer.part).hashes };
      if class >= hashes.len() { panic("a reference to a member this component does not have") }
      else { { naming: naming, node: { hash: hashes.get(class), class: class } } }
    },
    Itself -> panic("a stored body refers to its own definition by no hash"),
    ByName(_) -> panic("a stored body names a definition by its name"),
  }

/// The name `target` is printed under, its module imported where it is another's; `constructor`
/// names a constructor of the type `target` is.
fn named(
  printer: BodyPrinter,
  naming: Naming,
  target: Target,
  constructor: Option<Bytes>,
) -> Spelled<QName> / {abort.raise} = {
  // One body under two modules' names: the checker tells them apart where the hash does not.
  let meant = |slot: Slot| {
    let part = printer.layout.parts.get(slot.part);
    printer.meant.contains(qualify(part.module, part.names.get(slot.class)))
  };
  let told = match printer.layout.by_hash.get(target.hash) {
    Some(slots) -> slots.filter(meant).len() > 0,
    None -> false,
  };
  let found = if target.class >= 0 { Some({ part: printer.part, class: target.class }) } else {
    pick(printer.layout, printer.graph, naming.imports, target.hash, printer.own, |slot: Slot|
      !told || meant(slot))
  };
  match found {
    // A body with no name this module may write is filed with the ones it has no body for: either
    // way the reference cannot be printed, and a refusal names it rather than a name standing in.
    None ->
      {
        naming: { ..naming, missing: naming.missing.insert(target.hash, true) },
        node: unqualified(match constructor {
          Some(given) -> given,
          None -> short_hex(target.hash),
        }),
      },
    Some(slot) -> {
      let part = printer.layout.parts.get(slot.part);
      let name = match constructor { Some(given) -> given, None -> part.names.get(slot.class) };
      if part.module == printer.own { { naming: naming, node: unqualified(name) } } else {
        {
          naming: { ..naming, imports: naming.imports.insert(part.module, part.binder) },
          node: { module: Some(ident(part.binder)), name: ident(name), span: dummy_span() },
        }
      }
    },
  }
}

fn reference_named(
  printer: BodyPrinter,
  naming: Naming,
  reference: Reference,
  constructor: Option<Bytes>,
) -> Spelled<QName> / {abort.raise} = {
  let target = target_of(printer, naming, reference);
  named(printer, target.naming, target.node, constructor)
}

/// `target`, a function a call on a value may be, with its module imported where the module being
/// printed may name it: the call is answered among the modules its own can see.
fn seen(printer: BodyPrinter, naming: Naming, target: Target) -> Naming / {abort.raise} =
  if target.class >= 0 { naming } else {
    match pick(
        printer.layout,
        printer.graph,
        naming.imports,
        target.hash,
        printer.own,
        |_: Slot| true,
      ) {
      None -> naming,
      Some(slot) -> {
        let part = printer.layout.parts.get(slot.part);
        if part.module == printer.own { naming }
        else { { ..naming, imports: naming.imports.insert(part.module, part.binder) } }
      },
    }
  }

/// Whether `module` holds the body `hash` under `name`, where the module being printed may write it.
fn names_body(
  layout: Layout,
  module: Bytes,
  hash: Bytes,
  name: Bytes,
  own: Bytes,
) -> Bool / {abort.raise} =
  match layout.by_hash.get(hash) {
    None -> false,
    Some(found) ->
      found.fold(false, |held: Bool, s: Slot| {
        let p = layout.parts.get(s.part);
        held || (p.module == module && p.names.get(s.class) == name && nameable(layout, s, own))
      }),
  }

/// The binder a tagged literal is written with: one of another module that names the literal's
/// parser `parser`, and its filler `fill` where it has one, and that a string can touch without
/// making an interpolated or a byte string.
fn tag_binder(
  printer: BodyPrinter,
  naming: Naming,
  target: Target,
  parser: Bytes,
  filler: Option<Bytes>,
) -> Spelled<Ident> / {abort.raise} = {
  let layout = printer.layout;
  let found = pick(layout, printer.graph, naming.imports, target.hash, printer.own, |slot: Slot| {
    let part = layout.parts.get(slot.part);
    part.module != printer.own && part.names.get(slot.class) == parser && part.binder != b"f"
      && part.binder != b"b"
      && (match filler {
        None -> true,
        Some(hash) -> names_body(layout, part.module, hash, b"fill", printer.own),
      })
  });
  match found {
    None ->
      {
        naming: { ..naming, missing: naming.missing.insert(target.hash, true) },
        node: ident(short_hex(target.hash)),
      },
    Some(slot) -> {
      let part = layout.parts.get(slot.part);
      {
        naming: { ..naming, imports: naming.imports.insert(part.module, part.binder) },
        node: ident(part.binder),
      }
    },
  }
}

/// Two effects declared alike share a hash, and only the slot tells them apart.
fn effect_named(
  printer: BodyPrinter,
  naming: Naming,
  performed: Effect<Reference, Int>,
) -> Spelled<QName> / {abort.raise} =
  match performed {
    EffectUnbound(free) -> { naming: naming, node: free_name(free) },
    Declared(reference, slot) -> {
      let target = target_of(printer, naming, reference);
      match target.naming.slots.get(target.node.hash) {
        Some(was) -> if was != slot {
          panic(
            "two distinct effects share one declaration, which a hash-keyed body cannot tell apart",
          )
        } else { named(printer, target.naming, target.node, None) },
        None ->
          named(
            printer,
            { ..target.naming, slots: target.naming.slots.insert(target.node.hash, slot) },
            target.node,
            None,
          ),
      }
    },
  }

fn value_named(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  value: Value<Reference, Int>,
) -> Spelled<QName> / {abort.raise} =
  match value.named {
    Local(level) -> if level >= depth.values { panic("a local that is not in scope") }
    else { { naming: naming, node: unqualified(local_name(level)) } },
    Defined(reference) -> reference_named(printer, naming, reference, None),
    Constructed(reference, name) -> reference_named(printer, naming, reference, Some(name)),
    Unbound(free) -> { naming: naming, node: free_name(free) },
  }

fn label_of(depth: Depth, label: Label) -> Ident / {abort.raise} =
  match label {
    LabelParameter(level) -> if level >= depth.labels {
      panic("a label parameter that is not in scope")
    } else { ident(label_name(level)) },
    LabelName(name) -> ident(name),
  }

fn optional_label_of(depth: Depth, label: Option<Label>) -> Option<Ident> / {abort.raise} =
  match label { Some(given) -> Some(label_of(depth, given)), None -> None }

// --- Types -------------------------------------------------------------------------------------

fn types_of(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  types: List<Type<Reference, Int>>,
) -> Spelled<List<TypeExpr>> / {abort.raise} =
  named_in_turn(naming, types, |so_far: Naming, each: Type<Reference, Int>|
    type_of(printer, so_far, depth, each))

fn optional_type_of(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  annotation: Option<Type<Reference, Int>>,
) -> Spelled<Option<TypeExpr>> / {abort.raise} =
  named_if_any(naming, annotation, |so_far: Naming, present: Type<Reference, Int>|
    type_of(printer, so_far, depth, present))

fn type_named(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  name: stored::TypeName<Reference>,
) -> Spelled<QName> / {abort.raise} =
  match name {
    TypeParameter(level) -> if level >= depth.types { panic("a type parameter out of scope") }
    else { { naming: naming, node: unqualified(type_var_name(level)) } },
    TypeDefined(reference) -> reference_named(printer, naming, reference, None),
    TypeUnbound(free) -> { naming: naming, node: free_name(free) },
  }

fn type_of(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  original: Type<Reference, Int>,
) -> Spelled<TypeExpr> / {abort.raise} =
  match original {
    Applied(TypeParameter(level), _, arguments) -> if level >= depth.types || arguments.len() > 0 {
      panic("a type parameter out of scope, or applied")
    } else { { naming: naming, node: TVar(ident(type_var_name(level))) } },
    Applied(name, _, arguments) -> {
      let head = type_named(printer, naming, depth, name);
      let spelled = types_of(printer, head.naming, depth, arguments);
      {
        naming: spelled.naming,
        node: TCon({
          span: dummy_span(),
          name: head.node,
          args: spelled.node,
          labels: [],
          rows: [],
        }),
      }
    },
    AppliedOver(name, _, arguments, labels, rows) -> {
      let head = type_named(printer, naming, depth, name);
      let spelled = types_of(printer, head.naming, depth, arguments);
      let spelled_rows = named_in_turn(
        spelled.naming,
        rows,
        |so_far: Naming, row: Row<Reference, Int>| row_of(printer, so_far, depth, row),
      );
      {
        naming: spelled_rows.naming,
        node: TCon({
          span: dummy_span(),
          name: head.node,
          args: spelled.node,
          labels: labels.map(|label: Label| label_of(depth, label)),
          rows: spelled_rows.node,
        }),
      }
    },
    Function(parameters, returned, row, kept, once) -> {
      let spelled_parameters = types_of(printer, naming, depth, parameters);
      let spelled_returned = type_of(printer, spelled_parameters.naming, depth, returned);
      let spelled_row = optional_row_of(printer, spelled_returned.naming, depth, row);
      {
        naming: spelled_row.naming,
        node: TFn({
          span: dummy_span(),
          params: spelled_parameters.node,
          kept: kept,
          once: once,
          ret: spelled_returned.node,
          effects: spelled_row.node,
        }),
      }
    },
    Fields(fields) -> {
      let spelled = named_in_turn(
        naming,
        fields,
        |so_far: Naming, field: stored::TypeField<Reference, Int>| {
          let field_type = type_of(printer, so_far, depth, field.field_type);
          { naming: field_type.naming, node: { name: ident(field.name), ty: field_type.node } }
        },
      );
      { naming: spelled.naming, node: TRecord({ span: dummy_span(), fields: spelled.node }) }
    },
    UnitType -> { naming: naming, node: TUnit({ span: dummy_span() }) },
  }

fn optional_row_of(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  row: Option<Row<Reference, Int>>,
) -> Spelled<Option<RowExpr>> / {abort.raise} =
  named_if_any(naming, row, |so_far: Naming, present: Row<Reference, Int>|
    row_of(printer, so_far, depth, present))

/// What a label `[*]` and `[*t]` and a plain one are to an atom or a clause.
type Labelled = { resource: Option<Ident>, every: Bool, binder: Option<Ident> }

fn labelled(depth: Depth, label: Option<Label>) -> Labelled / {abort.raise} =
  match label {
    None -> { resource: None, every: false, binder: None },
    Some(LabelName(name)) -> if name == b"*" { { resource: None, every: true, binder: None } }
    else if name.starts_with(b"*") {
      { resource: None, every: true, binder: Some(ident(name.slice(1, name.len()))) }
    } else { { resource: Some(ident(name)), every: false, binder: None } },
    Some(parameter) -> { resource: Some(label_of(depth, parameter)), every: false, binder: None },
  }

fn atom_named(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  performed: Effect<Reference, Int>,
  mode: Mode,
  operation: Option<Ident>,
  label: Option<Label>,
  bounded: Bool,
) -> Spelled<AtomExpr> / {abort.raise} = {
  let effect_name = effect_named(printer, naming, performed);
  let labelled_by = labelled(depth, label);
  {
    naming: effect_name.naming,
    node: {
      eff: effect_name.node,
      mode: mode,
      op: operation,
      resource: labelled_by.resource,
      every: labelled_by.every,
      bounded: bounded,
      span: dummy_span(),
    },
  }
}

fn row_of(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  row: Row<Reference, Int>,
) -> Spelled<RowExpr> / {abort.raise} = {
  let atoms = named_in_turn(
    naming,
    row.atoms,
    |so_far: Naming, atom: stored::Atom<Reference, Int>|
      match atom {
        Moded(performed, mode, label, bounded) ->
          atom_named(printer, so_far, depth, performed, mode, None, label, bounded),
        OfOperation(performed, operation, label, bounded) ->
          atom_named(
            printer,
            so_far,
            depth,
            performed,
            MWrite,
            Some(ident(operation)),
            label,
            bounded,
          ),
      },
  );
  {
    naming: atoms.naming,
    node: {
      atoms: atoms.node,
      aliases: [],
      tail: match row.tail {
        None -> None,
        Some(RowParameter(level)) -> if level >= depth.rows {
          panic("a row parameter that is not in scope")
        } else { Some(ident(row_var_name(level))) },
        Some(RowName(name)) -> Some(ident(name)),
      },
      tail_bounded: row.bounded,
      span: dummy_span(),
    },
  }
}

// --- Literals and patterns ---------------------------------------------------------------------

fn width_name(at: Int) -> Bytes / {abort.raise} =
  match widths().at(at) {
    Some(width) -> width.name,
    None -> panic("a literal of no width the lexer has"),
  }

fn literal_of(literal: Literal) -> Lit / {abort.raise} =
  match literal {
    IntLiteral(value) -> LInt(value),
    FixedLiteral(width, bits) -> LFixed(width_name(width), bits),
    WideLiteral(width, high, low) -> LWide(width_name(width), high, low),
    BoolLiteral(value) -> LBool(value),
    StringLiteral(text) -> LStr(text),
    BytesLiteral(content) -> LBytes(content),
    EmbeddedLiteral(_, _) -> panic("an embedded file where only a literal is written"),
    FloatLiteral(bits) -> LFloat(float_text(bits)),
    DecimalLiteral(mantissa, scale) -> LDec(decimal_text(mantissa, scale)),
    CharLiteral(value) -> LChar(value),
    UnitLiteral -> LUnit,
  }

fn patterns_of(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  originals: List<stored::Pattern<Reference, Int>>,
) -> BoundAll / {abort.raise} =
  originals.fold(
    { naming: naming, depth: depth, node: [] },
    |acc: BoundAll, original: stored::Pattern<Reference, Int>| {
      let bound = pattern_of(printer, acc.naming, acc.depth, original);
      { naming: bound.naming, depth: bound.depth, node: acc.node.push(bound.node) }
    },
  )

fn pattern_of(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  original: stored::Pattern<Reference, Int>,
) -> Bound / {abort.raise} = {
  let span = dummy_span();
  match original {
    Wild -> { naming: naming, depth: depth, node: PWild({ span: span }) },
    Bind ->
      {
        naming: naming,
        depth: { ..depth, values: depth.values + 1 },
        node: PVar({ span: span, name: ident(local_name(depth.values)) }),
      },
    Again(level) -> if level >= depth.values {
      panic("an alternative names a binder that is not in scope")
    } else {
      { naming: naming, depth: depth, node: PVar({ span: span, name: ident(local_name(level)) }) }
    },
    LiteralPattern(literal) ->
      { naming: naming, depth: depth, node: PLit({ span: span, lit: literal_of(literal) }) },
    RangePattern(low, high) ->
      {
        naming: naming,
        depth: depth,
        node: PRange({ span: span, lo: literal_of(low), hi: literal_of(high) }),
      },
    ConstructorPattern(constructor, arguments) -> {
      let name = match constructor {
        Constructed(reference, simple) -> reference_named(printer, naming, reference, Some(simple)),
        Unbound(free) -> { naming: naming, node: free_name(free) },
        _ -> panic("a pattern of no constructor"),
      };
      let bound = patterns_of(printer, name.naming, depth, arguments);
      {
        naming: bound.naming,
        depth: bound.depth,
        node: PCtor({ span: span, name: name.node, args: bound.node }),
      }
    },
    RecordPattern(fields, rest) -> {
      let bound = fields.fold(
        { naming: naming, depth: depth, node: [] },
        |acc: { naming: Naming, depth: Depth, node: List<{ name: Ident, pat: Pattern }> }, field: stored::PatternField<Reference, Int>| {
          let field_bound = pattern_of(printer, acc.naming, acc.depth, field.pattern);
          {
            naming: field_bound.naming,
            depth: field_bound.depth,
            node: acc.node.push({ name: ident(field.name), pat: field_bound.node }),
          }
        },
      );
      {
        naming: bound.naming,
        depth: bound.depth,
        node: PRecord({ span: span, rest: rest, fields: bound.node }),
      }
    },
    ListPattern(items, rest) -> {
      let bound = patterns_of(printer, naming, depth, items);
      match rest {
        None ->
          {
            naming: bound.naming,
            depth: bound.depth,
            node: PList({ span: span, rest: None, items: bound.node }),
          },
        Some(tail) -> {
          let tail_bound = pattern_of(printer, bound.naming, bound.depth, tail);
          {
            naming: tail_bound.naming,
            depth: tail_bound.depth,
            node: PList({ span: span, rest: Some(tail_bound.node), items: bound.node }),
          }
        },
      }
    },
    OrPattern(alternatives) -> {
      let bound = patterns_of(printer, naming, depth, alternatives);
      { naming: bound.naming, depth: bound.depth, node: POr({ span: span, alts: bound.node }) }
    },
  }
}

// --- Expressions -------------------------------------------------------------------------------

type StoredExpression = stored::Expression<Reference, Int, Int, Unit>

type StoredStatement = stored::Statement<Reference, Int, Int, Unit>

fn expressions_of(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  expressions: List<StoredExpression>,
) -> Spelled<List<Expr>> / {abort.raise} =
  named_in_turn(naming, expressions, |so_far: Naming, each: StoredExpression|
    expression_of(printer, so_far, depth, each))

fn optional_expression_of(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  expression: Option<StoredExpression>,
) -> Spelled<Option<Expr>> / {abort.raise} =
  named_if_any(naming, expression, |so_far: Naming, present: StoredExpression|
    expression_of(printer, so_far, depth, present))

fn fields_of(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  fields: List<stored::RecordField<Reference, Int, Int, Unit>>,
) -> Spelled<List<RecField>> / {abort.raise} =
  named_in_turn(
    naming,
    fields,
    |so_far: Naming, field: stored::RecordField<Reference, Int, Int, Unit>| {
      let value = expression_of(printer, so_far, depth, field.value);
      { naming: value.naming, node: { name: ident(field.name), value: value.node } }
    },
  )

/// A call on a value. Under the program's own names the value's type answers the call as it did;
/// set apart, a function of a type is a plain function under another name, so the call is printed
/// as a call of the one it calls. A printed function's parameters are named by their places, so an
/// argument the call names is named so too, where the check said which parameter it fills.
fn on_value_of(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  call: stored::OnValueCall<Reference, Int, Int, Unit>,
) -> Spelled<Expr> / {abort.raise} = {
  let span = dummy_span();
  let base = expression_of(printer, naming, depth, call.base);
  let arguments = expressions_of(printer, base.naming, depth, call.arguments);
  let given = fields_of(printer, arguments.naming, depth, call.named);
  let choice: Choice = match given.naming.picks.at(given.naming.picked) {
    Some(found) -> found,
    None -> { callee: 0 - 1, named: [] },
  };
  let after = { ..given.naming, picked: given.naming.picked + 1 };
  let named_arguments = range(0, given.node.len()).map(|i: Int|
    {
      name: if choice.named.len() == given.node.len() { ident(local_name(choice.named.get(i))) }
      else { given.node.get(i).name },
      value: given.node.get(i).value,
      span: span,
    });
  let labels = call.labels.map(|label: Label| label_of(depth, label));
  let apart = printer.layout.apart;
  let local = match call.base {
    Variable(value) -> match value.named { Local(_) -> true, _ -> false },
    _ -> false,
  };
  let on_value = |field: Bytes| {
    let written = EApp({
      span: span,
      func: EField({ span: span, base: base.node, field: ident(field) }),
      named: named_arguments,
      args: arguments.node,
      labels: labels,
    });
    // A call on a local is written as a perform on it, which is how the parser reads one.
    match base.node {
      EVar(variable) -> if local && named_arguments.len() == 0 && labels.len() <= 1
          && field.index_of(b"::") == None {
        EPerform({
          span: span,
          eff: variable.name,
          op: ident(field),
          resource: labels.at(0),
          args: arguments.node,
        })
      } else { written },
      _ -> written,
    }
  };
  let plain = |callee: QName|
    EApp({
      span: span,
      func: EVar({ span: span, name: callee }),
      named: named_arguments,
      args: List::concat([base.node], arguments.node),
      labels: labels,
    });
  match call.callees {
    InFull(value) -> {
      let name = value_named(printer, after, depth, value);
      {
        naming: name.naming,
        node: if apart { plain(name.node) } else { on_value(qualified_text(name.node)) },
      }
    },
    Among(references) -> {
      let chosen = if apart { choice.callee } else { 0 - 1 };
      let walked = range(0, references.len()).fold(
        { naming: after, node: None },
        |acc: Spelled<Option<QName>>, i: Int| {
          let target = target_of(printer, acc.naming, references.get(i));
          if i == chosen {
            let name = named(printer, target.naming, target.node, None);
            { naming: name.naming, node: Some(name.node) }
          } else if chosen >= 0 { { naming: target.naming, node: acc.node } }
          else { { naming: seen(printer, target.naming, target.node), node: acc.node } }
        },
      );
      {
        naming: walked.naming,
        node: match walked.node { Some(name) -> plain(name), None -> on_value(call.name) },
      }
    },
  }
}

fn expression_of(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  original: StoredExpression,
) -> Spelled<Expr> / {abort.raise} = {
  let span = dummy_span();
  match original {
    // The bytes are not in the form: what prints embeds the file named by the digest's hex, which a
    // load handed the bytes under that digest reads back as this literal.
    Constant(EmbeddedLiteral(digest, _)) ->
      {
        naming: naming,
        node: EApp({
          span: span,
          func: EVar({ span: span, name: unqualified(b"embed") }),
          named: [],
          args: [ELit({ span: span, lit: LStr(hex(digest)) })],
          labels: [],
        }),
      },
    Constant(literal) -> { naming: naming, node: ELit({ span: span, lit: literal_of(literal) }) },
    Unwritten -> { naming: naming, node: EHole({ span: span, text: b"???" }) },
    Variable(value) -> {
      let name = value_named(printer, naming, depth, value);
      { naming: name.naming, node: EVar({ span: span, name: name.node }) }
    },
    Binary(operator, left, right, _) -> {
      let spelled_left = expression_of(printer, naming, depth, left);
      let spelled_right = expression_of(printer, spelled_left.naming, depth, right);
      {
        naming: spelled_right.naming,
        node: EBinary({
          span: span,
          op: operator,
          lhs: spelled_left.node,
          rhs: spelled_right.node,
        }),
      }
    },
    Unary(operator, operand) -> {
      let spelled = expression_of(printer, naming, depth, operand);
      { naming: spelled.naming, node: EUnary({ span: span, op: operator, operand: spelled.node }) }
    },
    Lambda(annotations, body) -> {
      let spelled_annotations = named_in_turn(
        naming,
        annotations,
        |so_far: Naming, annotation: Option<Type<Reference, Int>>|
          optional_type_of(printer, so_far, depth, annotation),
      );
      let spelled_body = expression_of(
        printer,
        spelled_annotations.naming,
        { ..depth, values: depth.values + annotations.len() },
        body,
      );
      {
        naming: spelled_body.naming,
        node: ELambda({
          span: span,
          body: spelled_body.node,
          params: range(0, annotations.len()).map(|i: Int|
            {
              name: ident(local_name(depth.values + i)),
              keep: false,
              ty: spelled_annotations.node.get(i),
              cost: None,
              space: None,
              default: None,
              span: span,
            }),
          ret: None,
        }),
      }
    },
    Call(callee, arguments, labels) -> {
      let spelled_callee = expression_of(printer, naming, depth, callee);
      let spelled_arguments = expressions_of(printer, spelled_callee.naming, depth, arguments);
      {
        naming: spelled_arguments.naming,
        node: EApp({
          span: span,
          func: spelled_callee.node,
          named: [],
          args: spelled_arguments.node,
          labels: labels.map(|label: Label| label_of(depth, label)),
        }),
      }
    },
    OnValue(call) -> on_value_of(printer, naming, depth, call),
    If(condition, then_branch, else_branch) -> {
      let spelled_condition = expression_of(printer, naming, depth, condition);
      let spelled_then = expression_of(printer, spelled_condition.naming, depth, then_branch);
      let spelled_else = expression_of(printer, spelled_then.naming, depth, else_branch);
      // `if c { t }` is the parser's own spelling of an `else ()`.
      let otherwise = match spelled_else.node {
        ELit(literal) -> match literal.lit {
          LUnit -> spelled_else.node,
          _ -> as_block(spelled_else.node),
        },
        EIf(_) -> spelled_else.node,
        _ -> as_block(spelled_else.node),
      };
      {
        naming: spelled_else.naming,
        node: EIf({
          span: span,
          cond: spelled_condition.node,
          then_branch: as_block(spelled_then.node),
          else_branch: otherwise,
        }),
      }
    },
    Match(scrutinee, arms) -> {
      let spelled_scrutinee = expression_of(printer, naming, depth, scrutinee);
      let spelled_arms = named_in_turn(
        spelled_scrutinee.naming,
        arms,
        |so_far: Naming, arm: stored::Arm<Reference, Int, Int, Unit>| {
          let bound = pattern_of(printer, so_far, depth, arm.pattern);
          let guard = optional_expression_of(printer, bound.naming, bound.depth, arm.guard);
          let body = expression_of(printer, guard.naming, bound.depth, arm.body);
          {
            naming: body.naming,
            node: { pat: bound.node, guard: guard.node, body: body.node, span: span },
          }
        },
      );
      {
        naming: spelled_arms.naming,
        node: EMatch({ span: span, scrutinee: spelled_scrutinee.node, arms: spelled_arms.node }),
      }
    },
    Record(fields) -> {
      let spelled = fields_of(printer, naming, depth, fields);
      { naming: spelled.naming, node: ERecord({ span: span, fields: spelled.node }) }
    },
    RecordUpdate(base, fields) -> {
      let spelled_base = expression_of(printer, naming, depth, base);
      let spelled_fields = fields_of(printer, spelled_base.naming, depth, fields);
      {
        naming: spelled_fields.naming,
        node: ERecordUpdate({ span: span, base: spelled_base.node, fields: spelled_fields.node }),
      }
    },
    Field(base, name) -> {
      let spelled = expression_of(printer, naming, depth, base);
      {
        naming: spelled.naming,
        node: EField({ span: span, base: spelled.node, field: ident(name) }),
      }
    },
    ListOf(items) -> {
      let spelled = expressions_of(printer, naming, depth, items);
      { naming: spelled.naming, node: EList({ span: span, items: spelled.node }) }
    },
    Perform(performed, operation, label, arguments) -> {
      let effect_name = effect_named(printer, naming, performed);
      let spelled_arguments = expressions_of(printer, effect_name.naming, depth, arguments);
      {
        naming: spelled_arguments.naming,
        node: EPerform({
          span: span,
          eff: effect_name.node,
          op: ident(operation),
          resource: optional_label_of(depth, label),
          args: spelled_arguments.node,
        }),
      }
    },
    Handle(handled) -> handle_of(printer, naming, depth, handled),
    WithHold(resource, acquire, release, body) -> {
      let spelled_acquire = expression_of(printer, naming, depth, acquire);
      let spelled_release = expression_of(printer, spelled_acquire.naming, depth, release);
      let spelled_body = expression_of(
        printer,
        spelled_release.naming,
        { ..depth, values: depth.values + 1 },
        body,
      );
      {
        naming: spelled_body.naming,
        node: EWithHold({
          span: span,
          resource: ident(resource),
          acquire: spelled_acquire.node,
          release: spelled_release.node,
          binder: ident(local_name(depth.values)),
          body: spelled_body.node,
        }),
      }
    },
    Simulate(body) -> {
      let spelled = expression_of(printer, naming, depth, body);
      { naming: spelled.naming, node: ESimulate({ span: span, body: as_block(spelled.node) }) }
    },
    Parallel(branches) -> {
      let spelled = expressions_of(printer, naming, depth, branches);
      { naming: spelled.naming, node: EParallel({ span: span, branches: spelled.node }) }
    },
    Tagged(parser, text) -> {
      let parser_target = parsed_by(printer, naming, parser);
      let tag = tag_binder(printer, parser_target.naming, parser_target.node, b"literal", None);
      {
        naming: tag.naming,
        node: ETagged({ span: span, tag: tag.node, text: text, quoted: span, holes: [] }),
      }
    },
    Filled(parser, filler, head, holes) -> {
      let parser_target = parsed_by(printer, naming, parser);
      let filler_target = parsed_by(printer, parser_target.naming, filler);
      let tag = tag_binder(
        printer,
        filler_target.naming,
        parser_target.node,
        b"compile",
        Some(filler_target.node.hash),
      );
      let spelled_holes = named_in_turn(
        tag.naming,
        holes,
        |so_far: Naming, hole: stored::FilledHole<Reference, Int, Int, Unit>| {
          let value = expression_of(printer, so_far, depth, hole.value);
          { naming: value.naming, node: { value: value.node, text: hole.text, quoted: span } }
        },
      );
      {
        naming: spelled_holes.naming,
        node: ETagged({
          span: span,
          tag: tag.node,
          text: head,
          quoted: span,
          holes: spelled_holes.node,
        }),
      }
    },
    TryBlock(raised, body) -> {
      let spelled_raised = match raised {
        None -> { naming: naming, node: None },
        Some(given) -> {
          let effect_name = effect_named(printer, naming, given.effect);
          {
            naming: effect_name.naming,
            node: Some({ eff: effect_name.node, op: ident(given.operation) }),
          }
        },
      };
      let spelled_body = expression_of(printer, spelled_raised.naming, depth, body);
      {
        naming: spelled_body.naming,
        node: ETryBlock({
          span: span,
          raise: spelled_raised.node,
          body: as_block(spelled_body.node),
        }),
      }
    },
    Block(entries, tail) -> {
      let said = |acc: { naming: Naming, depth: Depth, node: List<Stmt> }, statement: StoredStatement| {
        let spelled = statement_of(printer, acc.naming, acc.depth, statement);
        { naming: spelled.naming, depth: spelled.depth, node: acc.node.push(spelled.node) }
      };
      let statements = entries.fold(
        { naming: naming, depth: depth, node: [] },
        |acc: { naming: Naming, depth: Depth, node: List<Stmt> }, entry: stored::Entry<Reference, Int, Int, Unit>|
          match entry {
            One(statement) -> said(acc, statement),
            Commuting(_, members) -> members.fold(acc, said),
          },
      );
      let spelled_tail = optional_expression_of(printer, statements.naming, statements.depth, tail);
      {
        naming: spelled_tail.naming,
        node: EBlock({ span: span, tail: spelled_tail.node, stmts: statements.node }),
      }
    },
  }
}

/// The value a tagged literal's parser or filler is: a definition, which names the module it is of.
fn parsed_by(
  printer: BodyPrinter,
  naming: Naming,
  value: Value<Reference, Int>,
) -> Spelled<Target> / {abort.raise} =
  match value.named {
    Defined(reference) -> target_of(printer, naming, reference),
    _ -> panic("a tagged literal whose parser is no definition"),
  }

/// A `handle`: its variables first, each seeing those before it, then its body, which sees none of
/// them, then its clauses and its `return`, which see them all.
fn handle_of(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  handled: stored::Handled<Reference, Int, Int, Unit>,
) -> Spelled<Expr> / {abort.raise} = {
  let span = dummy_span();
  let level = depth.values;
  let variables = range(0, handled.variables.len()).fold(
    { naming: naming, node: [] },
    |acc: Spelled<List<HandlerVar>>, i: Int| {
      let variable = handled.variables.get(i);
      let seeing = { ..depth, values: level + i };
      let annotation = optional_type_of(printer, acc.naming, seeing, variable.annotation);
      let first = expression_of(printer, annotation.naming, seeing, variable.first);
      {
        naming: first.naming,
        node: acc.node.push({
          name: ident(local_name(level + i)),
          ty: annotation.node,
          init: first.node,
          span: span,
        }),
      }
    },
  );
  let body = expression_of(printer, variables.naming, depth, handled.body);
  let held = level + handled.variables.len();
  let clauses = named_in_turn(
    body.naming,
    handled.clauses,
    |so_far: Naming, clause: stored::Clause<Reference, Int, Int, Unit>| {
      let effect_name = effect_named(printer, so_far, clause.effect);
      let labelled_by = labelled(depth, clause.label);
      let bound = held + clause.parameters;
      let clause_body = expression_of(
        printer,
        effect_name.naming,
        { ..depth, values: if clause.resumes { bound + 1 } else { bound } },
        clause.body,
      );
      {
        naming: clause_body.naming,
        node: {
          eff: effect_name.node,
          op: ident(clause.operation),
          resource: labelled_by.resource,
          every_label: labelled_by.every,
          label_binder: labelled_by.binder,
          resume: if clause.resumes { Some(ident(local_name(bound))) } else { None },
          body: clause_body.node,
          span: span,
          params: range(held, bound).map(|i: Int| ident(local_name(i))),
        },
      }
    },
  );
  let returned = match handled.returned {
    None -> { naming: clauses.naming, node: None },
    Some(given) -> {
      let spelled = expression_of(printer, clauses.naming, { ..depth, values: held + 1 }, given);
      {
        naming: spelled.naming,
        node: Some({ binder: ident(local_name(held)), body: spelled.node, span: span }),
      }
    },
  };
  {
    naming: returned.naming,
    node: EHandle({
      span: span,
      body: body.node,
      ret: returned.node,
      clauses: clauses.node,
      vars: variables.node,
    }),
  }
}

fn statement_of(
  printer: BodyPrinter,
  naming: Naming,
  depth: Depth,
  original: StoredStatement,
) -> Said / {abort.raise} = {
  let span = dummy_span();
  match original {
    Let(annotation, value, pattern) -> {
      let spelled_annotation = optional_type_of(printer, naming, depth, annotation);
      let spelled_value = expression_of(printer, spelled_annotation.naming, depth, value);
      let bound = pattern_of(printer, spelled_value.naming, depth, pattern);
      {
        naming: bound.naming,
        depth: bound.depth,
        node: SLet({
          span: span,
          pat: bound.node,
          ty: spelled_annotation.node,
          value: spelled_value.node,
        }),
      }
    },
    LetElse(annotation, value, pattern, fallback) -> {
      let spelled_annotation = optional_type_of(printer, naming, depth, annotation);
      let spelled_value = expression_of(printer, spelled_annotation.naming, depth, value);
      let bound = pattern_of(printer, spelled_value.naming, depth, pattern);
      let spelled_fallback = expression_of(printer, bound.naming, bound.depth, fallback);
      {
        naming: spelled_fallback.naming,
        depth: bound.depth,
        node: SLetElse({
          span: span,
          pat: bound.node,
          ty: spelled_annotation.node,
          value: spelled_value.node,
          fallback: as_block(spelled_fallback.node),
        }),
      }
    },
    Effectful(expression) -> {
      let spelled = expression_of(printer, naming, depth, expression);
      { naming: spelled.naming, depth: depth, node: SExpr(spelled.node) }
    },
    Assign(variable, value) -> {
      let name = match variable.named {
        Local(level) -> if level >= depth.values {
          panic("a handler variable that is not in scope")
        } else { ident(local_name(level)) },
        _ -> panic("an assignment to no handler variable"),
      };
      let spelled = expression_of(printer, naming, depth, value);
      {
        naming: spelled.naming,
        depth: depth,
        node: SAssign({ span: span, name: name, value: spelled.node }),
      }
    },
  }
}

// --- Definitions -------------------------------------------------------------------------------

fn generics_of(generics: stored::Generics) -> Generics =
  {
    types: range(0, generics.types).map(|i: Int| ident(type_var_name(i))),
    effects: range(0, generics.rows).map(|i: Int| ident(row_var_name(i))),
    labels: range(0, generics.labels).map(|i: Int| ident(label_name(i))),
    kept: generics.kept.map(|i: Int| ident(type_var_name(i))),
    multi: generics.multi.map(|i: Int| ident(row_var_name(i))),
  }

/// What is in scope at the head of a declaration binding `generics`.
fn depth_of(generics: stored::Generics) -> Depth =
  { values: 0, types: generics.types, rows: generics.rows, labels: generics.labels }

fn constraints_of(constraints: List<stored::Constrained>) -> List<Constraint> =
  constraints.map(|constrained: stored::Constrained|
    {
      deriver: constrained.deriver,
      deriver_span: dummy_span(),
      param: ident(type_var_name(constrained.level)),
      span: dummy_span(),
    })

/// Everything is `pub`: visibility is metadata the encoding erased. A type's `key`, `show` and
/// `numeric` follow it.
fn items_of(
  printer: BodyPrinter,
  naming: Naming,
  form: Stored,
  name: Bytes,
) -> Spelled<List<Item>> / {abort.raise} = {
  let span = dummy_span();
  match form {
    FunctionOf(function) -> {
      let depth = depth_of(function.generics);
      let parameters = range(0, function.parameters.len()).fold(
        { naming: naming, node: [] },
        |acc: Spelled<List<Param>>, i: Int| {
          let parameter = function.parameters.get(i);
          let annotation = optional_type_of(printer, acc.naming, depth, parameter.annotation);
          let default_value = optional_expression_of(
            printer,
            annotation.naming,
            depth,
            parameter.default,
          );
          {
            naming: default_value.naming,
            node: acc.node.push({
              name: ident(local_name(i)),
              keep: parameter.kept,
              ty: annotation.node,
              cost: None,
              space: if parameter.spaced { Some(ident(space_name(i))) } else { None },
              default: default_value.node,
              span: span,
            }),
          }
        },
      );
      let returned = optional_type_of(printer, parameters.naming, depth, function.returned);
      let row = optional_row_of(printer, returned.naming, depth, function.row);
      let inside = { ..depth, values: function.parameters.len() };
      let measure = optional_expression_of(printer, row.naming, inside, function.decreases);
      let body = expression_of(printer, measure.naming, inside, function.body);
      {
        naming: body.naming,
        node: [
          IFn({
            vis: VPub,
            name: ident(name),
            generics: generics_of(function.generics),
            params: parameters.node,
            ret: returned.node,
            effects: row.node,
            constraints: constraints_of(function.constraints),
            spec: [],
            returns: match function.returns {
              Unstated -> None,
              Fresh -> Some(ReturnsFresh(span)),
              ParameterReturned(i) -> if i >= function.parameters.len() {
                panic("a `returns` clause names a parameter out of scope")
              } else { Some(ReturnsParam(ident(local_name(i)))) },
            },
            reuse: None,
            transparent: None,
            constant: if function.constant { Some(span) } else { None },
            decreases: measure.node,
            body: body.node,
            doc: None,
            span: span,
          }),
        ],
      }
    },
    TypeOf(declared) -> {
      let depth = depth_of(declared.generics);
      let body = match declared.body {
        Alias(aliased) -> {
          let spelled = type_of(printer, naming, depth, aliased);
          { naming: spelled.naming, node: TDAlias(spelled.node) }
        },
        Sum(_, variants) -> {
          let spelled = named_in_turn(
            naming,
            variants,
            |so_far: Naming, variant: stored::Variant<Reference, Int>| {
              let fields = types_of(printer, so_far, depth, variant.fields);
              {
                naming: fields.naming,
                node: { name: ident(variant.name), fields: fields.node, doc: None, span: span },
              }
            },
          );
          { naming: spelled.naming, node: TDSum(spelled.node) }
        },
        Nominal(_, wrapped) -> {
          let spelled = type_of(printer, naming, depth, wrapped);
          { naming: spelled.naming, node: TDNominal(spelled.node) }
        },
        Extern(_) -> { naming: naming, node: TDExtern },
      };
      let instances = named_in_turn(
        body.naming,
        declared.through,
        |so_far: Naming, through: stored::Through<Reference, Int>| {
          let function_name = value_named(printer, so_far, depth, through.by);
          {
            naming: function_name.naming,
            node: IInstance({
              kind: through.kind,
              target: ident(name),
              by: ident(qualified_text(function_name.node)),
              span: span,
            }),
          }
        },
      );
      let arithmetic = named_in_turn(
        instances.naming,
        declared.numerics,
        |so_far: Naming, operation: stored::Numeric<Reference, Int>| {
          let function_name = value_named(printer, so_far, depth, operation.by);
          {
            naming: function_name.naming,
            node: { op: ident(operation.operation), by: ident(qualified_text(function_name.node)) },
          }
        },
      );
      let declaration = IType({
        vis: VPub,
        // Set apart, what only the type's module may write is written wherever a body landed.
        opaque: if declared.opaque && !printer.layout.apart {
          Some({ span: span, answer: [], take: [] })
        } else { None },
        name: ident(name),
        generics: generics_of(declared.generics),
        constraints: constraints_of(declared.constraints),
        body: body.node,
        doc: None,
        field_docs: [],
        span: span,
      });
      {
        naming: arithmetic.naming,
        node: List::concat([declaration], instances.node).concat(if arithmetic.node.len() == 0 {
          []
        } else { [INumeric({ target: ident(name), ops: arithmetic.node, span: span })] }),
      }
    },
    EffectOf(declared) -> {
      let operations = named_in_turn(
        naming,
        declared.operations,
        |so_far: Naming, operation: stored::Operation<Reference, Int>| {
          let depth = { values: 0, types: operation.types, rows: 0, labels: 0 };
          let parameters = types_of(printer, so_far, depth, operation.parameters);
          let returned = type_of(printer, parameters.naming, depth, operation.returned);
          {
            naming: returned.naming,
            node: {
              name: ident(operation.name),
              mode: operation.mode,
              multi: operation.multi,
              resource_param: operation.resource,
              ty_params: range(0, operation.types).map(|i: Int| ident(type_var_name(i))),
              params: parameters.node,
              kept: operation.kept,
              ret: returned.node,
              doc: None,
              span: span,
            },
          }
        },
      );
      let declaration = IEffect({
        vis: VPub,
        name: ident(name),
        is_nondet: declared.nondet,
        ops: operations.node,
        doc: None,
        span: span,
      });
      match declared.served {
        None -> { naming: operations.naming, node: [declaration] },
        Some(by) -> {
          let depth = { values: 0, types: 0, rows: 0, labels: 0 };
          let function_name = value_named(printer, operations.naming, depth, by);
          {
            naming: function_name.naming,
            node: [
              declaration,
              IInstance({
                kind: NHost,
                target: ident(name),
                by: ident(qualified_text(function_name.node)),
                span: span,
              }),
            ],
          }
        },
      }
    },
    TestOf(declared) -> match declared.cases {
      Some(_) -> panic("a test over cases has no body to print without its table"),
      None -> {
        let body = expression_of(
          printer,
          naming,
          { values: 0, types: 0, rows: 0, labels: 0 },
          declared.body,
        );
        {
          naming: body.naming,
          node: [
            ITest({
              label: name,
              label_span: span,
              name: name,
              is_nondet: declared.nondet,
              cases: None,
              body: as_block(body.node),
              span: span,
            }),
          ],
        }
      },
    },
    LawOf(_) -> panic("a law is never printed back"),
    SpecOf(_) -> panic("a specification clause is never printed back"),
  }
}

/// The text of `items`, as `fmt` prints a module of them alone.
fn items_text(items: List<Item>) -> Bytes / {abort.raise} =
  module_text({ doc: None, imports: [], items: items })

// --- Laying the print out ----------------------------------------------------------------------

type Holder = { module: Bytes, simple: Bytes, public: Bool }

type Component = {
  members: List<Bytes>,
  picks: List<List<Choice>>,
  hashes: List<Bytes>,
  id: Bytes,
  key: Bytes,
}

type Copied = { module: Bytes, names: List<Bytes>, public: List<Bool> }

type Parting = {
  seen: Map<Bytes, Bool>,
  declared: Map<Bytes, Bytes>,
  parts: List<Part>,
  bad: Option<Refusal>,
}

type Sheet = { items: List<Bytes>, imports: Map<Bytes, Bytes> }

fn refuse(message: Bytes, notes: List<Bytes>) -> Option<Refusal> =
  Some({ message: message, notes: notes })

fn comp_of(body: Bytes) -> Component / {abort.raise} =
  match envelope(body) {
    None -> panic("a stored body of a kind this build does not read"),
    Some(e) -> {
      let payload = body.slice(e.at, body.len());
      let id = blake3(payload);
      if e.kind == 0 {
        { members: [payload], picks: picks_of(body, e), hashes: [id], id: id, key: id }
      } else {
        match members_of(payload) {
          Some(ms) -> if e.class >= ms.len() { panic("a malformed component body") } else {
            {
              members: ms,
              picks: picks_of(body, e),
              hashes: range(0, ms.len()).map(|i: Int| member_hash(id, i)),
              id: id,
              key: member_hash(id, e.class),
            }
          },
          None -> panic("a malformed component body"),
        }
      }
    },
  }

/// The stored forms a body holds: its own, or each member's of the component it is part of.
pub fn stored_forms(body: Bytes) -> List<Stored> / {abort.raise} = {
  let component = comp_of(body);
  component.members.map(|member: Bytes| stored_of(member, short_hex(component.key)))
}

/// What kind of definition a member of a component is: two of one name and one kind are one
/// definition, and two of one name and two kinds are two.
fn kind_of(member: Bytes, name: Bytes) -> Int / {abort.raise} =
  match stored_of(member, name) {
    FunctionOf(_) -> 0,
    TypeOf(_) -> 1,
    EffectOf(_) -> 2,
    TestOf(_) -> 3,
    LawOf(_) -> 4,
    SpecOf(_) -> 5,
  }

fn listed(ns: List<Holder>) -> Bytes / {abort.raise} =
  backticked(ns.map(|n: Holder| qualify(n.module, n.simple)), b", ")

fn named_of(
  names: List<{ name: Bytes, hash: Bytes, public: Bool }>,
  keys: Map<Bytes, Bool>,
) -> { named: Map<Bytes, Map<Bytes, Holder>>, bad: Option<Refusal> } / {abort.raise} =
  names.fold(
    { named: Map::new(), bad: None },
    |acc: { named: Map<Bytes, Map<Bytes, Holder>>, bad: Option<Refusal> }, n: { name: Bytes, hash: Bytes, public: Bool }|
      match acc.bad {
        Some(_) -> acc,
        None -> {
          let simple = default_binder(n.name);
          if simple.len() == n.name.len() {
            { ..acc, bad: refuse(Bytes::concat_all([b"`", n.name, b"` names no module"]), []) }
          } else if !keys.contains(n.hash) {
            { ..acc, bad: refuse(Bytes::concat_all([b"`", n.name, b"` has no body"]), []) }
          } else {
            let module = n.name.slice(0, n.name.len() - simple.len() - 1);
            let had = match acc.named.get(n.hash) { Some(m) -> m, None -> Map::new() };
            {
              ..acc,
              named: acc.named.insert(
                n.hash,
                had.insert(Bytes::concat_all([module, b"\x00", simple]), {
                  module: module,
                  simple: simple,
                  public: n.public,
                }),
              ),
            }
          }
        },
      },
  )

fn copies(classes: List<List<Holder>>) -> Option<List<Copied>> / {abort.raise} =
  if classes.len() == 1 {
    Some(
      classes.get(0).map(|n: Holder| { module: n.module, names: [n.simple], public: [n.public] }),
    )
  } else {
    let by_module = range(0, classes.len()).fold(
      Map::new(),
      |acc: Map<Bytes, List<List<Holder>>>, c: Int|
        classes.get(c).fold(acc, |a: Map<Bytes, List<List<Holder>>>, n: Holder| {
          let rows = match a.get(n.module) {
            Some(r) -> r,
            None -> classes.map(|k: List<Holder>| []),
          };
          a.insert(n.module, rows.set(c, rows.get(c).push(n)))
        }),
    );
    by_module.fold(Some([]), |acc: Option<List<Copied>>, m: Bytes, rows: List<List<Holder>>|
      match acc {
        None -> None,
        Some(out) -> {
          let count = rows.get(0).len();
          if rows.fold(false, |b: Bool, r: List<Holder>| b || r.len() != count) { None } else {
            Some(
              range(0, count).fold(out, |o: List<Copied>, k: Int|
                o.push({
                  module: m,
                  names: rows.map(|r: List<Holder>| r.get(k).simple),
                  public: rows.map(|r: List<Holder>| r.get(k).public),
                })),
            )
          }
        },
      })
  }

fn part_in(
  acc: Parting,
  component: Component,
  named: Map<Bytes, Map<Bytes, Holder>>,
  shipped: List<Bytes>,
) -> Parting / {abort.raise} = {
  let classes = component.hashes.map(|h: Bytes|
    match named.get(h) { Some(m) -> m.values(), None -> [] });
  let checked: Parting = range(0, component.hashes.len()).fold(acc, |a: Parting, i: Int|
    match a.bad {
      Some(_) -> a,
      None -> {
        let all = classes.get(i);
        let h = component.hashes.get(i);
        if all.len() == 0 {
          {
            ..a,
            bad: refuse(Bytes::concat_all([b"the body `", short_hex(h), b"` has no name"]), []),
          }
        } else {
          let kind = kind_of(
            component.members.get(i),
            qualify(all.get(0).module, all.get(0).simple),
          );
          // Two modules declaring one effect alike declare one effect, so a body performing it
          // cannot be printed back under a name: either module's would be a different claim about
          // what it does.
          if kind == 2 && all.len() > 1 {
            {
              ..a,
              bad: refuse(
                listed(all).concat(
                  b" are one effect declaration, so a body cannot say which it performs",
                ),
                [b"make the declarations differ, or keep one of them"],
              ),
            }
          } else {
            all.fold(a, |b: Parting, n: Holder| {
              let q = qualify(n.module, n.simple);
              let key = byte_of_int(kind).concat(q);
              match b.declared.get(key) {
                Some(other) -> if other == h || is_some(b.bad) { b } else {
                  {
                    ..b,
                    bad: refuse(
                      Bytes::concat_all([b"`", q, b"` names two different definitions"]),
                      [],
                    ),
                  }
                },
                None -> { ..b, declared: b.declared.insert(key, h) },
              }
            })
          }
        }
      },
    });
  match checked.bad {
    Some(_) -> checked,
    None -> match copies(classes) {
      None ->
        {
          ..checked,
          bad: refuse(
            listed(classes.fold([], |o: List<Holder>, ns: List<Holder>| o.concat(ns))).concat(
              b" are a mutually recursive group in which two definitions share one body, so a call cannot say which it reaches",
            ),
            [b"make the definitions differ, or keep one of them"],
          ),
        },
      Some(cs) ->
        {
          ..checked,
          parts: cs.fold(checked.parts, |ps: List<Part>, cp: Copied|
            ps.push({
              members: component.members,
              picks: component.picks,
              hashes: component.hashes,
              names: cp.names,
              public: cp.public,
              module: cp.module,
              binder: default_binder(cp.module),
              printed: !shipped.contains(cp.module),
            })),
        },
    },
  }
}

fn is_some(o: Option<Refusal>) -> Bool = match o { Some(_) -> true, None -> false }

/// Each module's binder: its last segment, or its whole path joined where two share one.
fn binders(modules: List<Bytes>) -> Map<Bytes, Bytes> / {abort.raise} = {
  let sharing = modules.fold(Map::new(), |acc: Map<Bytes, Int>, m: Bytes|
    acc.insert(
      default_binder(m),
      1 + (match acc.get(default_binder(m)) { Some(k) -> k, None -> 0 }),
    ));
  let start = {
    taken: sharing.fold(Map::new(), |acc: Map<Bytes, Bool>, b: Bytes, k: Int| acc.insert(b, true)),
    out: Map::new(),
  };
  let done = modules.fold(
    start,
    |s: { taken: Map<Bytes, Bool>, out: Map<Bytes, Bytes> }, m: Bytes| {
      let own = default_binder(m);
      if match sharing.get(own) { Some(k) -> k == 1, None -> true } {
        { ..s, out: s.out.insert(m, own) }
      } else {
        let base = Bytes::join(m.split(b"."), b"_");
        let found = iterate(
          { n: 1, binder: base },
          2 * modules.len() + 2,
          |t: { n: Int, binder: Bytes }|
            if s.taken.contains(t.binder) {
              Continue({
                n: t.n + 1,
                binder: Bytes::concat_all([base, b"_", ascii_of_int(t.n + 1)]),
              })
            } else { Stop(t) },
        );
        { taken: s.taken.insert(found.binder, true), out: s.out.insert(m, found.binder) }
      }
    },
  );
  done.out
}

fn layout_of(
  parts: List<Part>,
  relink: Map<Bytes, Bytes>,
  apart: Bool,
  meant: Map<Bytes, Map<Bytes, Bool>>,
) -> Layout / {abort.raise} = {
  let bound = binders(
    parts.fold(Map::new(), |acc: Map<Bytes, Bool>, part: Part| acc.insert(part.module, true)).keys(
    ),
  );
  let placed = parts.map(|part: Part|
    { ..part, binder: match bound.get(part.module) { Some(b) -> b, None -> part.binder } });
  {
    parts: placed,
    by_hash: range(0, placed.len()).fold(Map::new(), |acc: Map<Bytes, List<Slot>>, u: Int| {
      let hashes = placed.get(u).hashes;
      range(0, hashes.len()).fold(acc, |a: Map<Bytes, List<Slot>>, c: Int|
        a.insert(
          hashes.get(c),
          List::push(match a.get(hashes.get(c)) { Some(xs) -> xs, None -> [] }, {
            part: u,
            class: c,
          }),
        ))
    }),
    relink: relink,
    apart: apart,
    meant: meant,
  }
}

fn fresh_naming(
  imports: Map<Bytes, Bytes>,
  missing: Map<Bytes, Bool>,
  picks: List<Choice>,
) -> Naming = { imports: imports, missing: missing, slots: Map::new(), picks: picks, picked: 0 }

fn print_parts(
  layout: Layout,
) -> { modules: Map<Bytes, Sheet>, missing: Map<Bytes, Bool>, graph: Map<Bytes, List<Bytes>> } / {abort.raise} =
  range(0, layout.parts.len()).fold(
    { modules: Map::new(), missing: Map::new(), graph: Map::new() },
    |acc: { modules: Map<Bytes, Sheet>, missing: Map<Bytes, Bool>, graph: Map<Bytes, List<Bytes>> }, u: Int| {
      let p = layout.parts.get(u);
      if !p.printed { acc } else {
        let x = { layout: layout, part: u, own: p.module, graph: acc.graph, meant: Map::new() };
        let walked = range(0, p.members.len()).fold(
          { imports: Map::new(), missing: acc.missing, texts: [] },
          |w: { imports: Map<Bytes, Bytes>, missing: Map<Bytes, Bool>, texts: List<Bytes> }, c: Int| {
            let name = p.names.get(c);
            let printer = {
              ..x,
              meant: match layout.meant.get(meant_key(qualify(p.module, name), p.hashes.get(c))) {
                Some(names) -> names,
                None -> Map::new(),
              },
            };
            let g = items_of(
              printer,
              fresh_naming(w.imports, w.missing, match p.picks.at(c) { Some(x) -> x, None -> [] }),
              stored_of(p.members.get(c), qualify(p.module, name)),
              name,
            );
            {
              imports: g.naming.imports,
              missing: g.naming.missing,
              texts: w.texts.push(items_text(g.node)),
            }
          },
        );
        let had = match acc.modules.get(p.module) {
          Some(m) -> m,
          None -> { items: [], imports: Map::new() },
        };
        let imports = had.imports.merge(walked.imports.remove(p.module));
        {
          modules: acc.modules.insert(p.module, {
            items: had.items.concat(walked.texts),
            imports: imports,
          }),
          missing: walked.missing,
          graph: acc.graph.insert(p.module, imports.keys()),
        }
      }
    },
  )

fn print_tests(
  layout: Layout,
  g: Map<Bytes, List<Bytes>>,
  tests: List<Bytes>,
  missing: Map<Bytes, Bool>,
) -> { imports: Map<Bytes, Bytes>, missing: Map<Bytes, Bool>, texts: List<Bytes> } / {abort.raise} = {
  let x = { layout: layout, part: 0 - 1, own: b"", graph: g, meant: Map::new() };
  range(0, tests.len()).fold(
    { imports: Map::new(), missing: missing, texts: [] },
    |w: { imports: Map<Bytes, Bytes>, missing: Map<Bytes, Bool>, texts: List<Bytes> }, i: Int| {
      let body = tests.get(i);
      let label = b"t".concat(ascii_of_int(i));
      match envelope(body) {
        Some(e) -> if e.kind != 0 { panic("a test body that is not a solo body") } else {
          let t = items_of(
            x,
            fresh_naming(w.imports, w.missing, match picks_of(body, e).at(0) {
              Some(p) -> p,
              None -> [],
            }),
            stored_of(body.slice(e.at, body.len()), label),
            label,
          );
          {
            imports: t.naming.imports,
            missing: t.naming.missing,
            texts: w.texts.push(items_text(t.node)),
          }
        },
        None -> panic("a test body that is not a solo body"),
      }
    },
  )
}

fn sheet_text(sheet: Sheet) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    sheet.imports.fold([], |acc: List<Bytes>, m: Bytes, b: Bytes|
      acc.push(
        Bytes::concat_all([
          b"import ",
          m,
          if b == default_binder(m) { b"" } else { b" as ".concat(b) },
          b"\n",
        ]),
      )).concat(
      sheet.items.map(|it: Bytes| Bytes::concat_all([b"\n", it])),
    ),
  )

/// `public` is what the name's own module exports: a reference from a module that is printed reaches
/// a shipped one only through it, so a name filed without it is never the one a reference is printed
/// under.
///
/// `apart` says the names set each body in a module of its own, as a search's do. What only a
/// type's module may write is then written wherever a body landed, so an `opaque` type is printed
/// open; it runs as it did, and is no longer stored under the hash it was.
///
/// `meant` is what each definition names, for those the caller knows it of. Two modules that
/// declare one thing alike file one body under two names, which the checker may still tell apart;
/// a reference to it from a definition listed here is printed under the name that definition
/// names, and from any other under the nearest.
pub fn print_bodies(
  bodies: List<Bytes>,
  names: List<{ name: Bytes, hash: Bytes, public: Bool }>,
  tests: List<Bytes>,
  relink: List<{ from: Bytes, to: Bytes }>,
  shipped: List<Bytes>,
  apart: Bool = false,
  meant: List<{ name: Bytes, hash: Bytes, names: List<Bytes> }> = [],
) -> Printing / {abort.raise} = {
  let comps = bodies.map(comp_of);
  let n = named_of(
    names,
    comps.fold(Map::new(), |acc: Map<Bytes, Bool>, component: Component|
      acc.insert(component.key, true)),
  );
  let parted: Parting = match n.bad {
    Some(_) -> { seen: Map::new(), declared: Map::new(), parts: [], bad: n.bad },
    None ->
      comps.fold(
        { seen: Map::new(), declared: Map::new(), parts: [], bad: None },
        |acc: Parting, component: Component|
          if is_some(acc.bad) || acc.seen.contains(component.id) { acc } else {
            part_in(
              { ..acc, seen: acc.seen.insert(component.id, true) },
              component,
              n.named,
              shipped,
            )
          },
      ),
  };
  match parted.bad {
    Some(r) -> Unprintable(r),
    None -> {
      let l = layout_of(
        parted.parts,
        relink.fold(Map::new(), |acc: Map<Bytes, Bytes>, r: { from: Bytes, to: Bytes }|
          acc.insert(r.from, r.to)),
        apart,
        meant.fold(
          Map::new(),
          |acc: Map<Bytes, Map<Bytes, Bool>>, n: { name: Bytes, hash: Bytes, names: List<Bytes> }|
            acc.insert(
              meant_key(n.name, n.hash),
              n.names.fold(Map::new(), |held: Map<Bytes, Bool>, name: Bytes|
                held.insert(name, true)),
            ),
        ),
      );
      let printed = print_parts(l);
      let t = print_tests(l, printed.graph, tests, printed.missing);
      let missing = t.missing.keys();
      if missing.len() > 0 {
        Unprintable({
          message: ascii_of_int(missing.len()).concat(
            b" definitions a body refers to are not among the bodies it can name",
          ),
          notes: [
            b"missing: ".concat(
              Bytes::join(missing.take(min(8, missing.len())).map(short_hex), b", "),
            ),
          ],
        })
      } else {
        let texts = printed.modules.fold(
          [],
          |acc: List<{ module: Bytes, text: Bytes }>, m: Bytes, sheet: Sheet|
            acc.push({ module: m, text: sheet_text(sheet) }),
        );
        Printed(if tests.len() == 0 { texts } else {
          texts.push({
            module: b"ply_tests",
            text: sheet_text({ items: t.texts, imports: t.imports }),
          })
        })
      }
    },
  }
}
