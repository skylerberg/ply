//! The results a toolchain ships for its shipped modules, below each run's own memo store: the
//! records and the long results they name, each a Zstandard frame in one file, found by key through
//! two tables of rows, and an index giving where the tables lie, the id of the queries that made
//! them, the pack's own id, and the shipped files they were made over, as the launcher's `digests`
//! lists them.
//!
//! A run using those queries over exactly those files reuses a pack record unchecked. A run over
//! other files checks each by its reads, as it checks a record of its own store.

import std.bin
import std.bytes (u32_le, u64_le)
import std.hash (blake3)
import compiler.store.segments

/// The file of frames and tables a pack holds below `answers/`.
pub fn store_file() -> String = "store"

/// The pack's index below `answers/`, itself one frame.
pub fn index_file() -> String = "index"

/// Where a frame lies in a pack's file: its first byte and how many bytes it takes.
pub type Range = { offset: Int, len: Int }

derive bin for Range

/// A pack's description of itself: the id of the queries that made it; its own id, a digest of each
/// record's key with its result's digest; the shipped files its records were made over; and where
/// its table of records and its table of long results lie.
pub type Index = { queries: Bytes, id: Bytes, files: Bytes, records: Range, results: Range }

derive bin for Index

fn index_magic() -> Bytes = b"PLYPACK\x03"

/// `i` as a pack keeps it.
pub fn index_bytes(i: Index) -> Bytes / {abort.raise} =
  index_magic().concat(bin::encode(i, index_bin()))

/// The index `b` holds: none for bytes that are not one whole.
pub fn index_from(b: Bytes) -> Option<Index> / {abort.raise} =
  if b.len() < 8 || b.slice(0, 8) != index_magic() { None }
  else { match bin::decode(b.slice(8, b.len()), index_bin()) { Ok(i) -> Some(i), Err(_) -> None } }

/// A table's row: a 32-byte key, then where its frame lies and how long it is.
fn row_width() -> Int = 44

fn row_of(key: Bytes, at: Range) -> Bytes =
  Bytes::concat_all([key, u64_le(at.offset), u32_le(at.len)])

/// Where the frame `table` places under `key` lies: none where it places none.
pub fn frame_range(table: Bytes, key: Bytes) -> Option<Range> / {abort.raise} =
  match segments::row_of(table, row_width(), key) {
    Some(row) -> Some({ offset: segments::read_u64(row, 32), len: segments::read_u32(row, 40) }),
    None -> None,
  }

/// The key a longer answer is found under: its digest without the byte every digest of an answer
/// leads with.
pub fn output_key(digest: Bytes) -> Option<Bytes> =
  if digest.len() == 33 { Some(digest.slice(1, 33)) } else { None }

// --- Trust ------------------------------------------------------------------------------------

/// Whether a run using the queries `queries` names, over the shipped files `shipped_files` lists, can
/// reuse the records of the pack `i` describes unchecked: they were made by those queries over
/// exactly those files. A run that lists no files reuses none this way.
pub fn is_trusted(i: Index, queries: Bytes, shipped_files: Bytes) -> Bool =
  shipped_files.len() > 0 && i.queries == queries && i.files == shipped_files

// --- Writing a pack ---------------------------------------------------------------------------

/// A pack being written: its frames so far, in order, and how many bytes they take.
pub type PackWriter = { frames: List<Bytes>, end: Int }

pub fn new_writer() -> PackWriter = { frames: [], end: 0 }

/// `w` with `bytes`, compressed by `compress`, framed after what it holds, and where that frame lies.
pub fn append_frame(
  w: PackWriter,
  bytes: Bytes,
  compress: (Bytes) -> Bytes / {abort.raise},
) -> { writing: PackWriter, at: Range } / {abort.raise} = {
  let frame = compress(bytes);
  {
    writing: { frames: w.frames.push(frame), end: w.end + frame.len() },
    at: { offset: w.end, len: frame.len() },
  }
}

/// A pack as it is written: its file of frames and tables, and its index.
pub type PackFiles = { store: Bytes, index: Bytes }

/// The pack `w` holds the frames of, finished: its file, its frames and then its tables, which
/// place `records` and `answers` by key; and its index, compressed by `compress`, for the queries
/// `queries` names over the shipped files `files` lists, with an id made from `record_outputs`, each
/// record's key and its result's digest.
pub fn finish(
  w: PackWriter,
  records: Map<Bytes, Range>,
  answers: Map<Bytes, Range>,
  record_outputs: Map<Bytes, Bytes>,
  compress: (Bytes) -> Bytes / {abort.raise},
  queries: Bytes,
  files: Bytes,
) -> PackFiles / {abort.raise} = {
  let rows = |m: Map<Bytes, Range>|
    Bytes::concat_all(m.fold([], |acc: List<Bytes>, k: Bytes, at: Range| acc.push(row_of(k, at))));
  let r = append_frame(w, rows(records), compress);
  let a = append_frame(r.writing, rows(answers), compress);
  let id = blake3(
    Bytes::concat_all(
      record_outputs.fold([b"ply.pack\x00"], |acc: List<Bytes>, k: Bytes, d: Bytes|
        acc.push(blake3(k)).push(blake3(d))),
    ),
  );
  {
    store: Bytes::concat_all(a.writing.frames),
    index: compress(
      index_bytes({ queries: queries, id: id, files: files, records: r.at, results: a.at }),
    ),
  }
}

// --- Reading a pack ---------------------------------------------------------------------------

/// What a run holds of a pack: its index, none where the toolchain packed none, and its tables once
/// read.
pub type PackReader = { index: Option<Index>, records: Option<Bytes>, results: Option<Bytes> }

/// No pack.
pub fn empty_reader() -> PackReader = { index: None, records: None, results: None }

/// The pack `read` reads, which answers what a frame of a pack's file holds: its index, its tables
/// read when first asked.
pub fn open_reader<| e>(
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
) -> PackReader / {abort.raise | e} =
  {
    index: match read(index_file(), 0, 0) { Some(b) -> index_from(b), None -> None },
    records: None,
    results: None,
  }

/// What the frame the table `at` of `p` places under `key` holds, and `p` with that table read.
fn lookup<| e>(
  p: PackReader,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  key: Bytes,
  records: Bool,
) -> { reading: PackReader, bytes: Option<Bytes> } / {abort.raise | e} =
  match p.index {
    None -> { reading: p, bytes: None },
    Some(i) -> {
      let held = if records { p.records } else { p.results };
      let table = match held {
        Some(t) -> t,
        None -> {
          let at = if records { i.records } else { i.results };
          // A frame of no length is an empty table, never a read to the end of the file.
          if at.len == 0 { b"" }
          else { match read(store_file(), at.offset, at.len) { Some(t) -> t, None -> b"" } }
        },
      };
      let reading = if records { { ..p, records: Some(table) } }
      else { { ..p, results: Some(table) } };
      {
        reading: reading,
        bytes: match frame_range(table, key) {
          Some(at) -> read(store_file(), at.offset, at.len),
          None -> None,
        },
      }
    },
  }

/// The bytes of the record `p` holds under `key`, and `p` with what it read to find them.
pub fn record<| e>(
  p: PackReader,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  key: Bytes,
) -> { reading: PackReader, bytes: Option<Bytes> } / {abort.raise | e} = lookup(p, read, key, true)

/// The longer answer `p` holds under `digest`, and `p` with what it read to find it.
pub fn output<| e>(
  p: PackReader,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  digest: Bytes,
) -> { reading: PackReader, bytes: Option<Bytes> } / {abort.raise | e} =
  match output_key(digest) {
    Some(name) -> lookup(p, read, name, false),
    None -> { reading: p, bytes: None },
  }

/// What the frame of `len` bytes at `offset` of the file `path` of `p` holds, as a binary reads one
/// of the pack it carries: the pack a test writes with nothing compressed, each frame as it is.
pub fn frame_in(
  p: Option<PackFiles>,
  path: String,
  offset: Int,
  len: Int,
) -> Option<Bytes> / {abort.raise} =
  match p {
    None -> None,
    Some(w) -> if path == index_file() { Some(w.index) }
    else if path != store_file() || offset < 0 || len < 0 || offset + len > w.store.len() { None }
    else { Some(w.store.slice(offset, if len == 0 { w.store.len() } else { offset + len })) },
  }

// --- Tests ------------------------------------------------------------------------------------

/// What reads no pack: a run over it has nothing below its store.
pub fn no_pack(_: String, _: Int, _: Int) -> Option<Bytes> = None

/// What a test writes a pack with: every frame as it is.
pub fn uncompressed(b: Bytes) -> Bytes = b

fn test_pack(
  records: List<{ key: Bytes, bytes: Bytes }>,
  answers: List<{ key: Bytes, bytes: Bytes }>,
  files: Bytes,
) -> PackFiles / {abort.raise} = {
  let placing = |w: PackWriter, m: Map<Bytes, Range>, items: List<{ key: Bytes, bytes: Bytes }>|
    items.fold(
      { writing: w, placed: m },
      |acc: { writing: PackWriter, placed: Map<Bytes, Range> }, it: { key: Bytes, bytes: Bytes }| {
        let f = append_frame(acc.writing, it.bytes, uncompressed);
        { writing: f.writing, placed: acc.placed.insert(it.key, f.at) }
      },
    );
  let r = placing(new_writer(), Map::new(), records);
  let a = placing(r.writing, Map::new(), answers);
  finish(
    a.writing,
    r.placed,
    a.placed,
    records.fold(Map::new(), |acc: Map<Bytes, Bytes>, it: { key: Bytes, bytes: Bytes }|
      acc.insert(it.key, blake3(it.bytes))),
    uncompressed,
    b"queries",
    files,
  )
}

test "a pack's index reads back as it was written, and bytes that are not one whole read as none" {
  let i = {
    queries: b"s",
    id: b"id",
    files: b"a.ply 00\n",
    records: { offset: 7, len: 44 },
    results: { offset: 51, len: 0 },
  };
  assert_eq(index_from(index_bytes(i)), Some(i));
  let b = index_bytes(i);
  assert_eq(index_from(b.slice(0, b.len() - 1)), None);
  assert_eq(index_from(b.concat(b"x")), None);
  assert_eq(index_from(b"PLYPACK\x01"), None)
}

test "each record and longer answer of a pack is found by its key, and no other" {
  let a = b"a".blake3();
  let b = b"b".blake3();
  let long = b"=".concat(b"long".blake3());
  let written = test_pack(
    [{ key: b, bytes: b"record b" }, { key: a, bytes: b"record a" }],
    [{ key: long.slice(1, 33), bytes: b"a longer answer" }],
    b"files",
  );
  let read = |path: String, offset: Int, len: Int| frame_in(Some(written), path, offset, len);
  let p = open_reader(read);
  let first = record(p, read, a);
  assert_eq(first.bytes, Some(b"record a"));
  assert_eq(record(first.reading, read, b).bytes, Some(b"record b"));
  assert_eq(record(first.reading, read, b"c".blake3()).bytes, None);
  assert_eq(output(first.reading, read, long).bytes, Some(b"a longer answer"));
  assert_eq(output(first.reading, read, b"=".concat(b"short".blake3())).bytes, None);
  assert_eq(record(empty_reader(), read, a).bytes, None)
}

test "a pack's records stand for a run of its queries over the very files it was made over" {
  let written = test_pack([{ key: b"a".blake3(), bytes: b"r" }], [], b"files one");
  let i = match open_reader(|path: String, offset: Int, len: Int|
      frame_in(Some(written), path, offset, len)).index {
    Some(x) -> x,
    None -> panic("the index reads"),
  };
  assert(is_trusted(i, b"queries", b"files one"));
  assert(!is_trusted(i, b"other queries", b"files one"));
  assert(!is_trusted(i, b"queries", b"files two"));
  assert(!is_trusted(i, b"queries", b""))
}
