import std.bin
import std.set (Set)
import std.hash (blake3)
import compiler.store.segments
import compiler.store.memo (Query, main_only, plain_queries)
import compiler.store.memo.store (QueriesId, queries_id, queries_id_bin)

pub const store_file: String = "store"

pub const index_file: String = "index"

pub type Range = { offset: Int, len: Int }

derive bin for Range

pub type Index = { queries: QueriesId, id: Bytes, files: Bytes, records: Range, results: Range }

derive bin for Index

const index_magic: Bytes = b"PLYPACK\x07"

pub fn index_bytes(i: Index) -> Bytes / {abort.raise} =
  index_magic.concat(bin::encode(i, index_bin()))

pub fn damaged_pack<a>(what: String) -> a / {abort.raise} =
  panic("the shipped pack is damaged: " ++ what)

fn index_from(b: Bytes) -> Option<Index> / {abort.raise} =
  if b.len() < 8 || b.slice(0, 8) != index_magic { None } else {
    match bin::decode(b.slice(8, b.len()), index_bin()) {
      Ok(i) -> Some(i),
      Err(_) -> damaged_pack("its index does not decode"),
    }
  }

fn frame_range(table: segments::SortedTable, key: Bytes) -> Option<Range> / {abort.raise} =
  match segments::value_in(table, key) {
    Some(value) -> match bin::decode(value, range_bin()) {
      Ok(at) -> Some(at),
      Err(_) -> damaged_pack("a frame's range does not decode"),
    },
    None -> None,
  }

pub fn output_key(digest: Bytes) -> Option<Bytes> =
  if digest.len() == 33 { Some(digest.slice(1, 33)) } else { None }

pub fn is_trusted(i: Index, queries: QueriesId, shipped_files: Bytes) -> Bool =
  shipped_files.len() > 0 && i.queries == queries && i.files == shipped_files

pub type PackWriter = { frames: List<Bytes>, end: Int }

pub const new_writer: PackWriter = { frames: [], end: 0 }

pub fn append_frame(w: PackWriter, frame: Bytes) -> { writing: PackWriter, at: Range } =
  {
    writing: { frames: w.frames.push(frame), end: w.end + frame.len() },
    at: { offset: w.end, len: frame.len() },
  }

pub type PackFiles = { store: Bytes, index: Bytes }

pub fn finish(
  w: PackWriter,
  records: Map<Bytes, Range>,
  results: Map<Bytes, Range>,
  record_outputs: Map<Bytes, Bytes>,
  queries: QueriesId,
  files: Bytes,
) -> PackFiles / {abort.raise} = {
  let rows = |m: Map<Bytes, Range>|
    segments::table_bytes(
      segments::sorted_table(
        m.fold(Map::new(), |table: Map<Bytes, Bytes>, k: Bytes, at: Range|
          table.insert(k, bin::encode(at, range_bin()))),
      ),
    );
  let r = append_frame(w, rows(records));
  let a = append_frame(r.writing, rows(results));
  let id = blake3(
    Bytes::concat_all(
      record_outputs.fold([b"ply.pack\x00"], |accumulator: List<Bytes>, k: Bytes, d: Bytes|
        accumulator.push(blake3(k)).push(blake3(d))),
    ),
  );
  {
    store: Bytes::concat_all(a.writing.frames),
    index: index_bytes({ queries: queries, id: id, files: files, records: r.at, results: a.at }),
  }
}

pub type PackPart = | WholeIndex | StoreFrame(Range)

pub type PackReader = {
  index: Option<Index>,
  records: Option<segments::SortedTable>,
  results: Option<segments::SortedTable>,
}

pub const empty_reader: PackReader = { index: None, records: None, results: None }

pub fn open_reader<| e>(
  read: (PackPart) -> Option<Bytes> / {abort.raise | e},
) -> PackReader / {abort.raise | e} =
  {
    index: match read(WholeIndex) { Some(b) -> index_from(b), None -> None },
    records: None,
    results: None,
  }

type PackTable = | RecordsTable | ResultsTable

fn range_of(i: Index, table: PackTable) -> Range =
  match table { RecordsTable -> i.records, ResultsTable -> i.results }

fn cached_table(p: PackReader, table: PackTable) -> Option<segments::SortedTable> =
  match table { RecordsTable -> p.records, ResultsTable -> p.results }

fn with_table(p: PackReader, table: PackTable, rows: segments::SortedTable) -> PackReader =
  match table {
    RecordsTable -> { ..p, records: Some(rows) },
    ResultsTable -> { ..p, results: Some(rows) },
  }

fn read_table<| e>(
  i: Index,
  read: (PackPart) -> Option<Bytes> / {abort.raise | e},
  table: PackTable,
) -> segments::SortedTable / {abort.raise | e} =
  match read(StoreFrame(range_of(i, table))) {
    None -> damaged_pack("a table its index names cannot be read"),
    Some(bytes) -> match segments::decoded_table(bytes) {
      Some(rows) -> rows,
      None -> damaged_pack("a table does not decode"),
    },
  }

fn frame_of<| e>(
  rows: segments::SortedTable,
  read: (PackPart) -> Option<Bytes> / {abort.raise | e},
  key: Bytes,
) -> Option<Bytes> / {abort.raise | e} =
  match frame_range(rows, key) {
    None -> None,
    Some(at) -> match read(StoreFrame(at)) {
      Some(bytes) -> Some(bytes),
      None -> damaged_pack("a frame its table names cannot be read"),
    },
  }

fn lookup<| e>(
  p: PackReader,
  read: (PackPart) -> Option<Bytes> / {abort.raise | e},
  key: Bytes,
  table: PackTable,
) -> { reading: PackReader, bytes: Option<Bytes> } / {abort.raise | e} =
  match p.index {
    None -> { reading: p, bytes: None },
    Some(i) -> match cached_table(p, table) {
      Some(rows) -> { reading: p, bytes: frame_of(rows, read, key) },
      None -> {
        let rows = read_table(i, read, table);
        { reading: with_table(p, table, rows), bytes: frame_of(rows, read, key) }
      },
    },
  }

pub fn record<| e>(
  p: PackReader,
  read: (PackPart) -> Option<Bytes> / {abort.raise | e},
  key: Bytes,
) -> { reading: PackReader, bytes: Option<Bytes> } / {abort.raise | e} =
  lookup(p, read, key, RecordsTable)

pub fn output<| e>(
  p: PackReader,
  read: (PackPart) -> Option<Bytes> / {abort.raise | e},
  digest: Bytes,
) -> { reading: PackReader, bytes: Option<Bytes> } / {abort.raise | e} =
  match output_key(digest) {
    Some(name) -> lookup(p, read, name, ResultsTable),
    None -> { reading: p, bytes: None },
  }

pub fn frame_in(p: Option<PackFiles>, part: PackPart) -> Option<Bytes> =
  match p {
    None -> None,
    Some(w) -> match part {
      WholeIndex -> Some(w.index),
      StoreFrame(at) -> if at.offset < 0 || at.len < 0 || at.offset + at.len > w.store.len() {
        None
      } else { Some(w.store.slice(at.offset, at.offset + at.len)) },
    },
  }

pub fn no_pack(_: PackPart) -> Option<Bytes> = None

fn queries_of(names: List<Bytes>) -> QueriesId =
  queries_id(
    plain_queries(
      names.fold(Map::new(), |named: Map<Bytes, Query<| {}>>, name: Bytes|
        named.insert(name, {
          name: name,
          hash: name,
          body: main_only,
          persistent: true,
          product: None,
          interface: Set::empty(),
        })),
    ),
  )

fn test_pack(
  records: List<{ key: Bytes, bytes: Bytes }>,
  results: List<{ key: Bytes, bytes: Bytes }>,
  files: Bytes,
) -> PackFiles / {abort.raise} = {
  let placing = |w: PackWriter, m: Map<Bytes, Range>, items: List<{ key: Bytes, bytes: Bytes }>|
    items.fold(
      { writing: w, placed: m },
      |accumulator: { writing: PackWriter, placed: Map<Bytes, Range> }, it: { key: Bytes, bytes: Bytes }| {
        let f = append_frame(accumulator.writing, it.bytes);
        { writing: f.writing, placed: accumulator.placed.insert(it.key, f.at) }
      },
    );
  let r = placing(new_writer, Map::new(), records);
  let a = placing(r.writing, Map::new(), results);
  finish(
    a.writing,
    r.placed,
    a.placed,
    records.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, it: { key: Bytes, bytes: Bytes }|
      accumulator.insert(it.key, blake3(it.bytes))),
    queries_of([b"queries"]),
    files,
  )
}

test "a pack's index decodes to the value that was encoded, a damaged index raises, and another format's index is no index" {
  let i = {
    queries: queries_of([b"s"]),
    id: b"id",
    files: b"a.ply 00\n",
    records: { offset: 7, len: 44 },
    results: { offset: 51, len: 0 },
  };
  assert_eq(index_from(index_bytes(i)), Some(i));
  let b = index_bytes(i);
  let read = |bytes: Bytes| handle { Some(index_from(bytes)) } with { abort.raise(_) -> None };
  assert_eq(read(b.slice(0, b.len() - 1)), None);
  assert_eq(read(b.concat(b"x")), None);
  assert_eq(read(b"PLYPACK\x01"), Some(None))
}

test "each record and long result of a pack is found by its key, and no other" {
  let a = b"a".blake3();
  let b = b"b".blake3();
  let long = b"=".concat(b"long".blake3());
  let written = test_pack(
    [{ key: b, bytes: b"record b" }, { key: a, bytes: b"record a" }],
    [{ key: long.slice(1, 33), bytes: b"a longer result" }],
    b"files",
  );
  let read = |part: PackPart| frame_in(Some(written), part);
  let p = open_reader(read);
  let first = record(p, read, a);
  assert_eq(first.bytes, Some(b"record a"));
  assert_eq(record(first.reading, read, b).bytes, Some(b"record b"));
  assert_eq(record(first.reading, read, b"c".blake3()).bytes, None);
  assert_eq(output(first.reading, read, long).bytes, Some(b"a longer result"));
  assert_eq(output(first.reading, read, b"=".concat(b"short".blake3())).bytes, None);
  assert_eq(record(empty_reader, read, a).bytes, None)
}

test "a pack's records are reused only when the queries and the files match those the pack was written from" {
  let written = test_pack([{ key: b"a".blake3(), bytes: b"r" }], [], b"files one");
  let i = match open_reader(|part: PackPart| frame_in(Some(written), part)).index {
    Some(x) -> x,
    None -> panic("the index reads"),
  };
  assert(is_trusted(i, queries_of([b"queries"]), b"files one"));
  assert(!is_trusted(i, queries_of([b"other queries"]), b"files one"));
  assert(!is_trusted(i, queries_of([b"queries"]), b"files two"));
  assert(!is_trusted(i, queries_of([b"queries"]), b""))
}

test "a pack whose store is cut short raises when a record is looked up, rather than reading as absent" {
  let written = test_pack([{ key: b"a".blake3(), bytes: b"record a" }], [], b"files");
  let cut = { ..written, store: written.store.slice(0, 8) };
  let read = |part: PackPart| frame_in(Some(cut), part);
  let looked = handle {
    Some(record(open_reader(read), read, b"a".blake3()).bytes)
  } with {
    abort.raise(_) -> None,
  };
  assert_eq(looked, None)
}
