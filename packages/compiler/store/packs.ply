import std.fs (fs, mem_of, on_mem)
import compiler.store.segments
import compiler.store.segments (Segment, SegmentFile)

pub const store_file: String = "store"

pub const index_file: String = "index"

pub type Range = { offset: Int, len: Int }

pub type PackFiles = { store: Bytes, index: Bytes }

pub type PackPart = | WholeIndex | StoreFrame(Range)

pub fn damaged_pack<a>(what: String) -> a / {abort.raise} =
  panic("the shipped pack is damaged: " ++ what)

pub fn written(base: SegmentFile) -> PackFiles / {abort.raise} =
  {
    store: base.bytes,
    index: segments::manifest_bytes({ generation: 0, segments: [base.segment] }),
  }

pub fn opened<| e>(
  read: (PackPart) -> Option<Bytes> / {abort.raise | e},
) -> Option<Segment> / {abort.raise | e} =
  match read(WholeIndex) {
    None -> None,
    Some(b) -> match segments::manifest_from(b) {
      Some(m) -> match m.segments {
        [base] -> Some(base),
        _ -> damaged_pack("its index lists no single segment"),
      },
      None -> damaged_pack("its index does not read"),
    },
  }

pub effect pack_frames {
  read frame(part: PackPart) -> Option<Bytes>
}

pub fn served<a, [r] | e>(
  path: String,
  work: () -> a / {fs.read[r], abort.raise | e},
) -> a / {fs.read[r], pack_frames.frame, abort.raise | e} =
  handle {
    work()
  } with {
    fs.read_at[r](at, offset, len) -> if at == path {
      pack_frames.frame(StoreFrame({ offset: offset, len: len }))
    } else { fs.read_at[r](at, offset, len) },
  }

pub fn frame_in(p: Option<PackFiles>, part: PackPart) -> Option<Bytes> =
  match p {
    None -> None,
    Some(w) -> match part {
      WholeIndex -> Some(w.index),
      StoreFrame(at) -> if at.offset < 0 || at.len < 0 || at.offset + at.len > w.store.len() {
        None
      } else { Some(w.store.slice(at.offset, at.offset + at.len)) },
    },
  }

pub fn no_pack(_: PackPart) -> Option<Bytes> = None

test "a pack opens to the segment it was written from, and reads of that segment's path come from the pack" {
  let base = segments::segment_in_memory(
    b"schema".blake3(),
    b"shipped\x00",
    segments::new_writer,
    [segments::table(4, Map::new().insert(b"k", b"v"))],
  );
  let pack = written(base);
  let read = |part: PackPart| frame_in(Some(pack), part);
  assert_eq(opened(read), Some(base.segment));
  assert(opened(no_pack) == None, None);
  let path = segments::segment_path("store", base.segment.token);
  let entry = base.segment.parts.get(0);
  let rows = on_mem[memory](mem_of([{ path: "store/other", body: b"other" }]), ||
    handle {
      served[memory](path, ||
        (
          match segments::table_index[memory]("store", base.segment.token, entry, true) {
            Some(index) -> match segments::block_holding(index, b"k") {
              Some(place) -> segments::block_rows[memory]("store", base.segment.token, place, true),
              None -> None,
            },
            None -> None,
          },
          fs.read_at[memory]("store/other", 0, 5),
        ))
    } with {
      pack_frames.frame(part) -> read(part),
    }).value;
  assert_eq(rows._1, Some(b"other"));
  match rows._0 {
    Some(t) -> assert_eq(segments::value_in(t, b"k"), Some(b"v")),
    None -> panic("the table reads"),
  }
}

test "a pack whose index is cut short raises when it is opened, rather than reading as empty" {
  let pack = written(
    segments::segment_in_memory(b"schema".blake3(), b"shipped\x00", segments::new_writer, []),
  );
  let cut = { ..pack, index: pack.index.slice(0, 2) };
  let opened_cut = handle {
    Some(opened(|part: PackPart| frame_in(Some(cut), part)))
  } with {
    abort.raise(_) -> None,
  };
  assert_eq(opened_cut, None)
}
