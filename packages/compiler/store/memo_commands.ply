//! Tests of the memo store in files as `ply` uses it to store a command's result and reuse it. A
//! module of its own, which nothing imports.

import std.fs
import std.fs (fs)
import std.list
import compiler.store.memo
import compiler.store.memo (Read, memo, memo_keep, answer, started)
import compiler.store.memo_files
import compiler.store.packs

fn quoted(input: Bytes) -> Bytes / {memo.read} =
  Bytes::concat_all([b"\"", memo.ask(b"text", input), b"\""])

fn query(name: Bytes, hash: Bytes, body: keep (Bytes) -> Bytes / {memo.read}) -> memo::Query<| {}> =
  { name: name, hash: hash, body: body, kept: true, summarized: false }

fn test_queries() -> Map<Bytes, memo::Query<| {}>> =
  Map::new().insert(b"text", query(b"text", b"t1", memo::read_whole)).insert(
    b"quoted",
    query(b"quoted", b"q1", quoted),
  )

/// What the `ply` of the tests names its commands' answers by.
fn program() -> Bytes = b"p"

/// What a load answers: `quoted` asked of a file holding `text` over the store in `s`, with `pack`
/// below it over the shipped files `files` lists, as `ply` answers a load. How many bodies ran,
/// what the driver asked and each place the run looked at.
fn answering<[r]>(
  pack: Option<packs::Written>,
  files: Bytes,
  text: Bytes,
) -> { ran: Int, asked: List<Read>, looked: List<Read> } / {fs.read[r], fs.write[r], abort.raise} = {
  let queries = test_queries();
  memo_files::kept[r](
    "s",
    |path: String, offset: Int, len: Int| packs::frame_in(pack, path, offset, len),
    files,
    |_: Bytes, _: Bytes| Some(text),
    || {
      let a = answer(queries, started(queries), b"quoted", b"a");
      { ran: memo::ran_total(a.run), asked: memo::asked_reads(a.run), looked: memo_keep.looked() }
    },
    commands: [program()],
  )
}

/// `output` filed under `key` as a command's answer over what a load asked and looked at, in a run
/// of its own that asks no query, as `ply` files one once the load is over.
fn filing<[r]>(
  pack: Option<packs::Written>,
  files: Bytes,
  text: Bytes,
  key: Bytes,
  load: { ran: Int, asked: List<Read>, looked: List<Read> },
  output: Bytes,
) -> Unit / {fs.read[r], fs.write[r], abort.raise} =
  memo_files::kept[r](
    "s",
    |path: String, offset: Int, len: Int| packs::frame_in(pack, path, offset, len),
    files,
    |_: Bytes, _: Bytes| Some(text),
    || memo::recorded(test_queries(), key, program(), load.asked, load.looked, output),
    commands: [program()],
  )

/// The command's answer filed under `key`, taken back in a run of its own as `ply` takes one back.
fn taking<[r]>(
  pack: Option<packs::Written>,
  files: Bytes,
  text: Bytes,
  key: Bytes,
) -> Option<Bytes> / {fs.read[r], fs.write[r], abort.raise} =
  memo_files::kept[r](
    "s",
    |path: String, offset: Int, len: Int| packs::frame_in(pack, path, offset, len),
    files,
    |_: Bytes, _: Bytes| Some(text),
    || memo::standing(test_queries(), key),
    commands: [program()],
  )

fn segments_in(tree: fs::MemFs) -> List<String> / {abort.raise} =
  (match fs::listed_names(fs::mem_list(tree, "s")) { Some(names) -> names, None -> [] }).filter(
    |name: String| name.starts_with("seg-"),
  )

/// `tree` with the first hundred bytes of `payload` zeroed wherever a segment of the store holds it.
fn damaged(tree: fs::MemFs, payload: Bytes) -> fs::MemFs / {abort.raise} =
  segments_in(tree).fold(tree, |t: fs::MemFs, name: String| {
    let path = "s/" ++ name;
    match fs::mem_read(t, path) {
      None -> t,
      Some(bytes) -> match bytes.index_of(payload) {
        None -> t,
        Some(at) ->
          fs::mem_write(
            t,
            path,
            Bytes::concat_all([
              bytes.slice(0, at),
              b"\x00".repeat(100),
              bytes.slice(at + 100, bytes.len()),
            ]),
          ).fs,
      },
    }
  })

/// The pack of what `text` and `quoted` answer of a file holding `text`, made over the files
/// `b"files"` lists.
fn quoted_pack(text: Bytes) -> packs::Written / {abort.raise} = {
  let queries = test_queries();
  let keys = [b"text", b"quoted"].map(|name: Bytes|
    match queries.get(name) { Some(q) -> memo::key_of(q, b"a"), None -> b"" });
  fs::on_mem[abs](fs::mem_of([]), || {
    answering[abs](None, b"", text);
    memo_files::packed[abs]("s", keys, packs::as_is, memo::queries_id(queries), b"files")
  }).value.written
}

test "filing commands' answers keeps the records of the queries their loads asked, through the merges it makes" {
  let long = b"long ".repeat(1000);
  let first = fs::on_mem[abs](fs::mem_of([]), || answering[abs](None, b"", long));
  assert_eq(first.value.ran, 2);
  // Commands of other lines filed one after another, until one writes the whole store again.
  let whole = iterate({ tree: first.tree, n: 0 }, 60, |x: { tree: fs::MemFs, n: Int }| {
    let key = Bytes::of_string(x.n.to_string()).blake3();
    let next = fs::on_mem[abs](x.tree, || filing[abs](None, b"", long, key, first.value, b"said"));
    if segments_in(next.tree).len() == 1 { Stop(next.tree) }
    else { Continue({ tree: next.tree, n: x.n + 1 }) }
  });
  assert_eq(fs::on_mem[abs](whole, || answering[abs](None, b"", long)).value.ran, 0)
}

test "a command's longer answer that does not read is written again by the next run that files it" {
  let said = b"said ".repeat(1000);
  let key = b"command".blake3();
  let first = fs::on_mem[abs](fs::mem_of([]), || answering[abs](None, b"", b"four"));
  let filed = fs::on_mem[abs](first.tree, ||
    filing[abs](None, b"", b"four", key, first.value, said)).tree;
  assert_eq(fs::on_mem[abs](filed, || taking[abs](None, b"", b"four", key)).value, Some(said));
  let torn = damaged(filed, said);
  assert_eq(fs::on_mem[abs](torn, || taking[abs](None, b"", b"four", key)).value, None);
  // The load is answered again and the command's answer filed again, as `ply` does next.
  let again = fs::on_mem[abs](torn, || answering[abs](None, b"", b"four"));
  let refiled = fs::on_mem[abs](again.tree, ||
    filing[abs](None, b"", b"four", key, again.value, said)).tree;
  assert_eq(fs::on_mem[abs](refiled, || taking[abs](None, b"", b"four", key)).value, Some(said))
}

test "a command's answer filed after a place moved under its load is taken back only over what the load read" {
  let key = b"command".blake3();
  let first = fs::on_mem[abs](fs::mem_of([]), || answering[abs](None, b"", b"four"));
  // The file moves once the load has read it and before its answer is filed.
  let filed = fs::on_mem[abs](first.tree, ||
    filing[abs](None, b"", b"forty", key, first.value, b"said four")).tree;
  assert_eq(fs::on_mem[abs](filed, || taking[abs](None, b"", b"forty", key)).value, None);
  assert_eq(
    fs::on_mem[abs](filed, || taking[abs](None, b"", b"four", key)).value,
    Some(b"said four"),
  )
}

test "a command's answer over a pack that stood is not taken back over another pack" {
  let four = quoted_pack(b"four");
  let forty = quoted_pack(b"forty");
  let key = b"command".blake3();
  let first = fs::on_mem[abs](fs::mem_of([]), || answering[abs](Some(four), b"files", b"four"));
  assert_eq(first.value.ran, 0);
  let filed = fs::on_mem[abs](first.tree, ||
    filing[abs](Some(four), b"files", b"four", key, first.value, b"said four")).tree;
  assert_eq(
    fs::on_mem[abs](filed, || taking[abs](Some(four), b"files", b"four", key)).value,
    Some(b"said four"),
  );
  // Below the store now is a pack that stands too and answers otherwise.
  assert_eq(fs::on_mem[abs](filed, || taking[abs](Some(forty), b"files", b"four", key)).value, None)
}
