import std.fs
import std.fs (fs)
import std.list
import compiler.store.memo
import compiler.store.memo (query, Dependency, memo, memo_store, query_output, start_run)
import compiler.store.memo_files
import compiler.store.packs
import compiler.store.memo_files (quoted)

fn test_queries() -> Map<Bytes, memo::Query<| {}>> =
  Map::new().insert(b"text", query(b"text", b"t1", memo::read_file)).insert(
    b"quoted",
    query(b"quoted", b"q1", quoted),
  )

fn program() -> Bytes = b"p"

fn run_quoted<[r]>(
  pack: Option<packs::PackFiles>,
  files: Bytes,
  text: Bytes,
) -> { ran: Int, requested: List<Dependency>, looked: List<Dependency> } / {fs.read[r], fs.write[r], abort.raise} = {
  let queries = test_queries();
  memo_files::with_memo_store[r](
    "s",
    |path: String, offset: Int, len: Int| packs::frame_in(pack, path, offset, len),
    files,
    |_: Bytes, _: Bytes| Some(text),
    || {
      let a = query_output(queries, start_run(queries), b"quoted", b"a");
      {
        ran: memo::executed_count(a.run),
        requested: memo::driver_dependencies(a.run),
        looked: memo_store.looked(),
      }
    },
    commands: [program()],
  )
}

fn filing<[r]>(
  pack: Option<packs::PackFiles>,
  files: Bytes,
  text: Bytes,
  key: Bytes,
  load: { ran: Int, requested: List<Dependency>, looked: List<Dependency> },
  output: Bytes,
) -> Unit / {fs.read[r], fs.write[r], abort.raise} =
  memo_files::with_memo_store[r](
    "s",
    |path: String, offset: Int, len: Int| packs::frame_in(pack, path, offset, len),
    files,
    |_: Bytes, _: Bytes| Some(text),
    || memo::record_output(test_queries(), key, program(), load.requested, load.looked, output),
    commands: [program()],
  )

fn stored_output<[r]>(
  pack: Option<packs::PackFiles>,
  files: Bytes,
  text: Bytes,
  key: Bytes,
) -> Option<Bytes> / {fs.read[r], fs.write[r], abort.raise} =
  memo_files::with_memo_store[r](
    "s",
    |path: String, offset: Int, len: Int| packs::frame_in(pack, path, offset, len),
    files,
    |_: Bytes, _: Bytes| Some(text),
    || memo::cached_output(test_queries(), key),
    commands: [program()],
  )

fn segments_in(tree: fs::MemFs) -> List<String> / {abort.raise} =
  (match fs::listed_names(fs::mem_list(tree, "s")) { Some(names) -> names, None -> [] }).filter(
    |name: String| name.starts_with("seg-"),
  )

fn corrupt_payload(tree: fs::MemFs, payload: Bytes) -> fs::MemFs / {abort.raise} =
  segments_in(tree).fold(tree, |t: fs::MemFs, name: String| {
    let path = "s/" ++ name;
    match fs::mem_read(t, path) {
      None -> t,
      Some(bytes) -> match bytes.index_of(payload) {
        None -> t,
        Some(at) ->
          fs::mem_write(
            t,
            path,
            Bytes::concat_all([
              bytes.slice(0, at),
              b"\x00".repeat(100),
              bytes.slice(at + 100, bytes.len()),
            ]),
          ).fs,
      },
    }
  })

fn quoted_pack(text: Bytes) -> packs::PackFiles / {abort.raise} = {
  let queries = test_queries();
  let keys = [b"text", b"quoted"].map(|name: Bytes|
    match queries.get(name) { Some(q) -> memo::key_of(q, b"a"), None -> b"" });
  fs::on_mem[abs](fs::mem_of([]), || {
    run_quoted[abs](None, b"", text);
    memo_files::write_pack[abs]("s", keys, packs::uncompressed, memo::queries_id(queries), b"files")
  }).value.written
}

test "recording command results preserves the records of the queries the commands ran, across the segment merges the store performs" {
  let long = b"long ".repeat(1000);
  let first = fs::on_mem[abs](fs::mem_of([]), || run_quoted[abs](None, b"", long));
  assert_eq(first.value.ran, 2);
  let whole = iterate({ tree: first.tree, n: 0 }, 60, |x: { tree: fs::MemFs, n: Int }| {
    let key = Bytes::of_string(x.n.to_string()).blake3();
    let next = fs::on_mem[abs](x.tree, || filing[abs](None, b"", long, key, first.value, b"said"));
    if segments_in(next.tree).len() == 1 { Stop(next.tree) }
    else { Continue({ tree: next.tree, n: x.n + 1 }) }
  });
  assert_eq(fs::on_mem[abs](whole, || run_quoted[abs](None, b"", long)).value.ran, 0)
}

test "a command's large result whose stored bytes are corrupted is written again by the next run that records the command" {
  let large_output = b"said ".repeat(1000);
  let key = b"command".blake3();
  let first = fs::on_mem[abs](fs::mem_of([]), || run_quoted[abs](None, b"", b"four"));
  let recorded = fs::on_mem[abs](first.tree, ||
    filing[abs](None, b"", b"four", key, first.value, large_output)).tree;
  assert_eq(
    fs::on_mem[abs](recorded, || stored_output[abs](None, b"", b"four", key)).value,
    Some(large_output),
  );
  let torn = corrupt_payload(recorded, large_output);
  assert_eq(fs::on_mem[abs](torn, || stored_output[abs](None, b"", b"four", key)).value, None);
  let again = fs::on_mem[abs](torn, || run_quoted[abs](None, b"", b"four"));
  let refiled = fs::on_mem[abs](again.tree, ||
    filing[abs](None, b"", b"four", key, again.value, large_output)).tree;
  assert_eq(
    fs::on_mem[abs](refiled, || stored_output[abs](None, b"", b"four", key)).value,
    Some(large_output),
  )
}

test "a command result recorded after a file changed during the command is reused only for the file contents the command read" {
  let key = b"command".blake3();
  let first = fs::on_mem[abs](fs::mem_of([]), || run_quoted[abs](None, b"", b"four"));
  let recorded = fs::on_mem[abs](first.tree, ||
    filing[abs](None, b"", b"forty", key, first.value, b"said four")).tree;
  assert_eq(fs::on_mem[abs](recorded, || stored_output[abs](None, b"", b"forty", key)).value, None);
  assert_eq(
    fs::on_mem[abs](recorded, || stored_output[abs](None, b"", b"four", key)).value,
    Some(b"said four"),
  )
}

test "a command result recorded with one pack of prebuilt results is not reused when a different pack is used" {
  let four = quoted_pack(b"four");
  let forty = quoted_pack(b"forty");
  let key = b"command".blake3();
  let first = fs::on_mem[abs](fs::mem_of([]), || run_quoted[abs](Some(four), b"files", b"four"));
  assert_eq(first.value.ran, 0);
  let recorded = fs::on_mem[abs](first.tree, ||
    filing[abs](Some(four), b"files", b"four", key, first.value, b"said four")).tree;
  assert_eq(
    fs::on_mem[abs](recorded, || stored_output[abs](Some(four), b"files", b"four", key)).value,
    Some(b"said four"),
  );
  assert_eq(
    fs::on_mem[abs](recorded, || stored_output[abs](Some(forty), b"files", b"four", key)).value,
    None,
  )
}
