import std.set (Set)
import std.fs
import std.fs (fs)
import std.hash (checksum)
import std.bytes (u32_be, u32_le, u64_le)
import std.list

const format_version: Int = 5

const segment_magic: Bytes = b"PLYSEGM1"

const manifest_magic: Bytes = b"PLYSEGS1"

const frame_header_len: Int = 12

pub const header_len: Int = 52

const max_read_size: Int = 33554432

const block_size: Int = 4096

const flush_threshold: Int = 8388608

const stale_run_ms: Int = 3600000

fn read_u32(b: Bytes, at: Int) -> Int = match b.u32_at(at) { Some(n) -> n, None -> 0 }

fn read_u64(b: Bytes, at: Int) -> Int = match b.u64_at(at) { Some(n) -> n, None -> 0 }

pub type TableEntry = { table: Int, offset: Int, size: Int, sum: Bytes, name: Bytes }

pub type Segment = { token: Bytes, at: Int, size: Int, parts: List<TableEntry> }

pub type Manifest = { generation: Int, segments: List<Segment> }

pub const empty_manifest: Manifest = { generation: 0, segments: [] }

fn manifest_name(schema: Bytes) -> String / {abort.raise} =
  "manifest-" ++ schema.slice(0, 8).hex_of()

fn segment_name(token: Bytes) -> String / {abort.raise} = "seg-" ++ token.hex_of()

pub fn segment_path(dir: String, token: Bytes) -> String / {abort.raise} =
  dir ++ "/" ++ segment_name(token)

fn lock_path(dir: String) -> String = dir ++ "/lock"

fn table_entry_bytes(p: TableEntry) -> Bytes =
  Bytes::concat_all([u32_le(p.table), u64_le(p.offset), u64_le(p.size), p.sum])

fn segment_bytes(s: Segment) -> Bytes =
  Bytes::concat_all([
    s.token,
    u64_le(s.at),
    u64_le(s.size),
    u32_le(s.parts.len()),
    Bytes::concat_all(s.parts.map(table_entry_bytes)),
  ])

pub fn manifest_bytes(m: Manifest) -> Bytes / {abort.raise} = {
  let body = Bytes::concat_all([
    manifest_magic,
    u32_le(format_version),
    u64_le(m.generation),
    u32_le(m.segments.len()),
    Bytes::concat_all(m.segments.map(segment_bytes)),
  ]);
  body.concat(checksum(body))
}

type Decoded<a> = { value: a, at: Int }

fn table_name(token: Bytes, table: Int, sum: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([token, byte_of_int(table), sum])

fn table_entries_from(
  b: Bytes,
  token: Bytes,
  at: Int,
  end_run: Int,
  accumulator: List<TableEntry>,
) -> Decoded<List<TableEntry>> / {abort.raise} =
  if end_run <= 0 { { value: accumulator, at: at } } else {
    let table = read_u32(b, at);
    let sum = b.slice(at + 20, at + 28);
    table_entries_from(
      b,
      token,
      at + 28,
      end_run - 1,
      accumulator.push({
        table: table,
        offset: read_u64(b, at + 4),
        size: read_u64(b, at + 12),
        sum: sum,
        name: table_name(token, table, sum),
      }),
    )
  }

fn segments_from(
  b: Bytes,
  at: Int,
  end_run: Int,
  accumulator: List<Segment>,
) -> List<Segment> / {abort.raise} =
  if end_run <= 0 { accumulator } else {
    let token = b.slice(at, at + 8);
    let parts = table_entries_from(b, token, at + 28, read_u32(b, at + 24), []);
    segments_from(
      b,
      parts.at,
      end_run - 1,
      accumulator.push({
        token: token,
        at: read_u64(b, at + 8),
        size: read_u64(b, at + 16),
        parts: parts.value,
      }),
    )
  }

pub fn manifest_from(b: Bytes) -> Option<Manifest> / {abort.raise} = {
  let n = b.len();
  if n < 32 || b.slice(0, 8) != manifest_magic || read_u32(b, 8) != format_version { None }
  else if checksum(b.slice(0, n - 8)) != b.slice(n - 8, n) { None } else {
    Some({ generation: read_u64(b, 12), segments: segments_from(b, 24, read_u32(b, 20), []) })
  }
}

pub type ManifestFile = | NoManifest | Garbled | Listed(Manifest)

pub fn manifest_file<[r]>(dir: String, schema: Bytes) -> ManifestFile / {fs.read[r], abort.raise} =
  match fs.read_file[r](dir ++ "/" ++ manifest_name(schema)) {
    None -> NoManifest,
    Some(b) -> match manifest_from(b) { Some(m) -> Listed(m), None -> Garbled },
  }

pub fn listed(file: ManifestFile) -> Manifest = match file { Listed(m) -> m, _ -> empty_manifest }

pub fn manifest<[r]>(dir: String, schema: Bytes) -> Manifest / {fs.read[r], abort.raise} =
  listed(manifest_file[r](dir, schema))

pub fn start_run<[r]>(dir: String) -> Option<String> / {fs.write[r]} = {
  fs.create_dir[r](dir);
  fs.temp_dir[r](dir, "run")
}

pub fn end_run<[r]>(run: Option<String>) -> Unit / {fs.write[r]} =
  match run {
    Some(path) -> {
      fs.remove[r](path);
      ()
    },
    None -> (),
  }

pub fn run_start_ms<[r]>(run: Option<String>) -> Int / {fs.read[r]} =
  match run { Some(path) -> match fs.modified_ms[r](path) { Some(ms) -> ms, None -> 0 }, None -> 0 }

pub fn segment_token(run: Option<String>, generation: Int, nth: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    Bytes::of_string(match run { Some(path) -> path, None -> "" }),
    u64_le(generation),
    u64_le(nth),
  ]).blake3(
  ).slice(
    0,
    8,
  )

pub fn read_range<[r]>(
  path: String,
  offset: Int,
  len: Int,
) -> Option<Bytes> / {fs.read[r], abort.raise} =
  if len <= max_read_size {
    match fs.read_at[r](path, offset, len) {
      Some(b) -> if b.len() == len { Some(b) } else { None },
      None -> None,
    }
  } else {
    let read = iterate(
      { at: offset, left: len, got: [] },
      len / max_read_size + 2,
      |x: { at: Int, left: Int, got: List<Bytes> }|
        if x.left <= 0 { Stop(Some(x.got)) } else {
          let n = min(x.left, max_read_size);
          match fs.read_at[r](path, x.at, n) {
            Some(b) -> if b.len() != n { Stop(None) } else {
              let at = x.at;
              let left = x.left;
              Continue({ at: at + n, left: left - n, got: x.got.push(b) })
            },
            None -> Stop(None),
          }
        },
    );
    match read { Some(parts) -> Some(Bytes::concat_all(parts)), None -> None }
  }

pub fn table_entry(seg: Segment, table: Int) -> Option<TableEntry> =
  seg.parts.find(|p: TableEntry| p.table == table)

pub type BlockPlace = { offset: Int, size: Int, sum: Bytes }

fn rows_read<[r]>(
  path: String,
  place: BlockPlace,
  verified: Bool,
) -> Option<SortedTable> / {fs.read[r], abort.raise} =
  match read_range[r](path, place.offset, place.size) {
    Some(b) -> if verified && checksum(b) != place.sum { None } else { decoded_table(b) },
    None -> None,
  }

pub fn table_index<[r]>(
  dir: String,
  token: Bytes,
  entry: TableEntry,
  verified: Bool,
) -> Option<SortedTable> / {fs.read[r], abort.raise} =
  rows_read[r](
    segment_path(dir, token),
    { offset: entry.offset, size: entry.size, sum: entry.sum },
    verified,
  )

pub fn block_rows<[r]>(
  dir: String,
  token: Bytes,
  place: BlockPlace,
  verified: Bool,
) -> Option<SortedTable> / {fs.read[r], abort.raise} =
  rows_read[r](segment_path(dir, token), place, verified)

pub type Row = { key: Bytes, value: Bytes }

pub opaque type SortedTable = new { count: Int, bytes: Bytes }

const row_bounds_width: Int = 8

fn bounds_at(row: Int) -> Int = 4 + row_bounds_width * row

fn key_end(table: SortedTable, row: Int) -> Int = read_u32(table.bytes, bounds_at(row))

fn value_end(table: SortedTable, row: Int) -> Int = read_u32(table.bytes, bounds_at(row) + 4)

fn row_start(table: SortedTable, row: Int) -> Int =
  if row == 0 { 0 } else { value_end(table, row - 1) }

pub fn table_of_rows(table_rows: List<Row>) -> SortedTable = {
  let built = table_rows.fold(
    { end: 0, bounds: [], body: [] },
    |accumulator: { end: Int, bounds: List<Bytes>, body: List<Bytes> }, row: Row| {
      let key = row.key;
      let value = row.value;
      let after_key = accumulator.end + key.len();
      let after_value = after_key + value.len();
      let bounds = accumulator.bounds;
      let body = accumulator.body;
      {
        end: after_value,
        bounds: bounds.push(u32_le(after_key).concat(u32_le(after_value))),
        body: body.push(key).push(value),
      }
    },
  );
  {
    count: table_rows.len(),
    bytes: Bytes::concat_all([
      u32_le(table_rows.len()),
      Bytes::concat_all(built.bounds),
      Bytes::concat_all(built.body),
    ]),
  }
}

pub const empty_table: SortedTable = { count: 0, bytes: u32_le(0) }

pub fn decoded_table(bytes: Bytes) -> Option<SortedTable> =
  match bytes.u32_at(0) {
    None -> None,
    Some(count) -> {
      let body_end = if count == 0 { Some(0) } else { bytes.u32_at(bounds_at(count - 1) + 4) };
      match body_end {
        Some(end) -> if bounds_at(count) + end == bytes.len() {
          Some({ count: count, bytes: bytes })
        } else { None },
        None -> None,
      }
    },
  }

pub fn table_bytes(table: SortedTable) -> Bytes = table.bytes

pub fn row_count(table: SortedTable) -> Int = table.count

fn key_at(table: SortedTable, row: Int) -> Bytes / {abort.raise} = {
  let body = bounds_at(table.count);
  table.bytes.slice(body + row_start(table, row), body + key_end(table, row))
}

pub fn row_at(table: SortedTable, row: Int) -> Row / {abort.raise} = {
  let body = bounds_at(table.count);
  {
    key: key_at(table, row),
    value: table.bytes.slice(body + key_end(table, row), body + value_end(table, row)),
  }
}

pub fn lower_bound(table: SortedTable, key: Bytes) -> Int / {abort.raise} =
  iterate({ low: 0, high: table.count }, table.count + 2, |x: { low: Int, high: Int }|
    if x.low >= x.high { Stop(x.low) } else {
      let middle = x.low + (x.high - x.low) / 2;
      if compare_values(key_at(table, middle), key) == Less {
        Continue({ low: middle + 1, high: x.high })
      } else { Continue({ low: x.low, high: middle }) }
    })

pub fn value_in(table: SortedTable, key: Bytes) -> Option<Bytes> / {abort.raise} = {
  let at = lower_bound(table, key);
  if at >= table.count { None } else {
    let row = row_at(table, at);
    if row.key == key { Some(row.value) } else { None }
  }
}

pub fn rows_between(
  table: SortedTable,
  from: Bytes,
  until: Option<Bytes>,
) -> List<Row> / {abort.raise} =
  range(lower_bound(table, from), match until {
    Some(u) -> lower_bound(table, u),
    None -> table.count,
  }).map(|row: Int| row_at(table, row))

fn place_bytes(p: BlockPlace) -> Bytes =
  Bytes::concat_all([u64_le(p.offset), u64_le(p.size), p.sum])

fn block_place_at(index: SortedTable, block: Int) -> BlockPlace / {abort.raise} = {
  let value = row_at(index, block).value;
  { offset: read_u64(value, 0), size: read_u64(value, 8), sum: value.slice(16, value.len()) }
}

fn first_block_for(index: SortedTable, key: Bytes) -> Int / {abort.raise} = {
  let at = lower_bound(index, key);
  if at < index.count && key_at(index, at) == key { at } else if at == 0 { 0 } else { at - 1 }
}

pub fn block_holding(index: SortedTable, key: Bytes) -> Option<BlockPlace> / {abort.raise} =
  if index.count == 0 { None } else { Some(block_place_at(index, first_block_for(index, key))) }

pub fn blocks_for(
  index: SortedTable,
  from: Bytes,
  until: Option<Bytes>,
) -> List<BlockPlace> / {abort.raise} =
  if index.count == 0 { [] } else {
    let first = first_block_for(index, from);
    let last = match until { Some(u) -> lower_bound(index, u), None -> index.count };
    range(first, if last > first { last } else { first + 1 }).map(|block: Int|
      block_place_at(index, block))
  }

fn blocks_of(table_rows: List<Row>) -> List<List<Row>> = {
  let split = table_rows.fold(
    { done: [], current: [], size: 0 },
    |accumulator: { done: List<List<Row>>, current: List<Row>, size: Int }, row: Row| {
      let current = accumulator.current.push(row);
      let size = accumulator.size + row.key.len() + row.value.len() + row_bounds_width;
      if size >= block_size { { done: accumulator.done.push(current), current: [], size: 0 } }
      else { { ..accumulator, current: current, size: size } }
    },
  );
  if split.current.len() == 0 { split.done } else { split.done.push(split.current) }
}

pub fn framed(payload: Bytes) -> Bytes / {abort.raise} = {
  let head = u32_le(payload.len());
  Bytes::concat_all([head, checksum(head.concat(payload)), payload])
}

pub fn framed_len(len: Int) -> Int = frame_header_len + len

pub fn unframed(b: Bytes) -> Option<Bytes> / {abort.raise} =
  if b.len() < frame_header_len || read_u32(b, 0) != b.len() - frame_header_len { None } else {
    let payload = b.slice(frame_header_len, b.len());
    if checksum(b.slice(0, 4).concat(payload)) != b.slice(4, frame_header_len) { None }
    else { Some(payload) }
  }

pub fn payload<[r]>(
  dir: String,
  token: Bytes,
  offset: Int,
  len: Int,
) -> Option<Bytes> / {fs.read[r], abort.raise} =
  match read_range[r](segment_path(dir, token), offset, framed_len(len)) {
    Some(b) -> unframed(b),
    None -> None,
  }

pub type SegmentWriter = {
  end: Int,
  waiting: List<Bytes>,
  unwritten: Map<Int, Bytes>,
  buffered: Int,
  failed: Bool,
}

pub const new_writer: SegmentWriter =
  { end: header_len, waiting: [], unwritten: Map::new(), buffered: 0, failed: false }

pub const failed_writer: SegmentWriter = { ..new_writer, failed: true }

pub fn append_payload(
  w: SegmentWriter,
  payload: Bytes,
) -> { writing: SegmentWriter, at: Int } / {abort.raise} = {
  let frame = framed(payload);
  let end = w.end;
  let buffered = w.buffered;
  {
    writing: {
      ..w,
      end: end + frame.len(),
      waiting: w.waiting.push(frame),
      unwritten: w.unwritten.insert(end, payload),
      buffered: buffered + frame.len(),
    },
    at: end,
  }
}

pub fn append_frames(w: SegmentWriter, frames: Bytes) -> { writing: SegmentWriter, at: Int } = {
  let end = w.end;
  let buffered = w.buffered;
  {
    writing: {
      ..w,
      end: end + frames.len(),
      waiting: w.waiting.push(frames),
      buffered: buffered + frames.len(),
    },
    at: end,
  }
}

pub fn pending_payload(w: SegmentWriter, at: Int) -> Option<Bytes> = w.unwritten.get(at)

fn header(schema: Bytes, token: Bytes) -> Bytes =
  Bytes::concat_all([segment_magic, u32_le(format_version), token, schema])

fn flush<[r]>(
  dir: String,
  schema: Bytes,
  token: Bytes,
  w: SegmentWriter,
  more: Bytes,
) -> SegmentWriter / {fs.write[r], abort.raise} =
  if w.failed { w } else {
    let path = segment_path(dir, token);
    let body = Bytes::concat_all(w.waiting).concat(more);
    let done = if w.end - w.buffered == header_len {
      fs.write_file[r](path, header(schema, token).concat(body))
    } else { body.len() == 0 || fs.append[r](path, body) != None };
    if done {
      { end: w.end + more.len(), waiting: [], unwritten: Map::new(), buffered: 0, failed: false }
    } else { { ..w, failed: true } }
  }

pub fn flush_when_full<[r]>(
  dir: String,
  schema: Bytes,
  token: Bytes,
  w: SegmentWriter,
) -> SegmentWriter / {fs.write[r], abort.raise} =
  if w.buffered > flush_threshold { flush[r](dir, schema, token, w, b"") } else { w }

pub opaque type Table = new { table: Int, rows: List<Row> }

pub fn table(table: Int, table_rows: Map<Bytes, Bytes>) -> Table =
  { table: table, rows: table_rows.entries() }

type Laid = { parts: List<TableEntry>, bytes: Bytes }

fn laid_out(token: Bytes, start: Int, tables: List<Table>) -> Laid / {abort.raise} = {
  let built = tables.fold(
    { at: start, parts: [], bytes: [] },
    |accumulator: { at: Int, parts: List<TableEntry>, bytes: List<Bytes> }, t: Table|
      if t.rows.len() == 0 { accumulator } else {
        let blocks = blocks_of(t.rows).fold(
          { at: accumulator.at, index: [], bytes: [] },
          |b: { at: Int, index: List<Row>, bytes: List<Bytes> }, block: List<Row>| {
            let encoded = table_of_rows(block).bytes;
            let place = { offset: b.at, size: encoded.len(), sum: checksum(encoded) };
            {
              at: b.at + encoded.len(),
              index: b.index.push({ key: block.get(0).key, value: place_bytes(place) }),
              bytes: b.bytes.push(encoded),
            }
          },
        );
        let index = table_of_rows(blocks.index).bytes;
        let sum = checksum(index);
        let parts = accumulator.parts;
        {
          at: blocks.at + index.len(),
          parts: parts.push({
            table: t.table,
            offset: blocks.at,
            size: index.len(),
            sum: sum,
            name: table_name(token, t.table, sum),
          }),
          bytes: accumulator.bytes.concat(blocks.bytes).push(index),
        }
      },
  );
  { parts: built.parts, bytes: Bytes::concat_all(built.bytes) }
}

pub fn finish<[r]>(
  dir: String,
  schema: Bytes,
  token: Bytes,
  w: SegmentWriter,
  tables: List<Table>,
) -> Option<Segment> / {fs.write[r], abort.raise} = {
  let laid = laid_out(token, w.end, tables);
  let done = flush[r](dir, schema, token, w, laid.bytes);
  if done.failed { None } else { Some({ token: token, at: 0, size: done.end, parts: laid.parts }) }
}

pub type SegmentFile = { segment: Segment, bytes: Bytes }

pub fn segment_in_memory(
  schema: Bytes,
  token: Bytes,
  w: SegmentWriter,
  tables: List<Table>,
) -> SegmentFile / {abort.raise} = {
  let laid = laid_out(token, w.end, tables);
  {
    segment: { token: token, at: 0, size: w.end + laid.bytes.len(), parts: laid.parts },
    bytes: Bytes::concat_all([header(schema, token), Bytes::concat_all(w.waiting), laid.bytes]),
  }
}

pub type CommitResult = | Committed(Manifest) | LockHeld | StoreChanged | WriteFailed

fn replace_manifest<[r]>(
  dir: String,
  schema: Bytes,
  token: Bytes,
  m: Manifest,
  durable: Bool,
) -> Bool / {fs.write[r], abort.raise} = {
  let path = dir ++ "/" ++ manifest_name(schema);
  let temporary_path = path ++ "." ++ token.hex_of() ++ ".tmp";
  (!durable || fs.sync[r](segment_path(dir, token)))
    && fs.write_file[r](temporary_path, manifest_bytes(m))
    && (!durable || fs.sync[r](temporary_path))
    && fs.rename[r](temporary_path, path)
    && (!durable || fs.sync[r](dir))
}

pub fn commit<[r]>(
  dir: String,
  schema: Bytes,
  seg: Segment,
  without: List<Bytes> = [],
  durable: Bool = false,
) -> CommitResult / {fs.read[r], fs.write[r], abort.raise} =
  if !fs.lock[r](lock_path(dir)) { LockHeld } else {
    let now = manifest[r](dir, schema);
    let at = now.generation + 1;
    let next = {
      generation: at,
      segments: now.segments.filter(|s: Segment| !without.contains(s.token)).push({
        ..seg,
        at: at,
      }),
    };
    let done = replace_manifest[r](dir, schema, seg.token, next, durable);
    fs.unlock[r](lock_path(dir));
    if done { Committed(next) } else { WriteFailed }
  }

pub fn replace_merged<[r]>(
  dir: String,
  schema: Bytes,
  m: Manifest,
  from: Int,
  seg: Segment,
  durable: Bool = false,
) -> CommitResult / {fs.read[r], fs.write[r], abort.raise} =
  if !fs.lock[r](lock_path(dir)) { LockHeld } else {
    let now = manifest[r](dir, schema);
    let at = m.generation + 1;
    let next = { generation: at, segments: m.segments.take(from).push({ ..seg, at: at }) };
    let done = now.generation == m.generation
      && replace_manifest[r](dir, schema, seg.token, next, durable);
    fs.unlock[r](lock_path(dir));
    if now.generation != m.generation { StoreChanged }
    else if done { Committed(next) }
    else { WriteFailed }
  }

pub fn merge_start(m: Manifest) -> Int / {abort.raise} = {
  let n = m.segments.len();
  if n < 2 { n - 1 } else {
    iterate({ from: n - 1, sum: m.segments.get(n - 1).size }, n + 1, |x: { from: Int, sum: Int }|
      if x.from == 0 { Stop(0) } else {
        let older = m.segments.get(x.from - 1).size;
        if older > 2 * x.sum { Stop(x.from) }
        else { Continue({ from: x.from - 1, sum: x.sum + older }) }
      })
  }
}

pub fn sweep<[r]>(
  dir: String,
  schema: Bytes,
  run: String,
) -> Unit / {fs.read[r], fs.write[r], abort.raise} = {
  let names = match fs::listed_names(fs.list_dir[r](dir)) { Some(ns) -> ns, None -> [] };
  let now = run_start_ms[r](Some(run));
  let abandoned = |name: String|
    match fs.modified_ms[r](dir ++ "/" ++ name) {
      Some(ms) -> now - ms > stale_run_ms,
      None -> false,
    };
  let removed = |name: String| {
    fs.remove[r](dir ++ "/" ++ name);
    ()
  };
  let running = names.fold(false, |any: Bool, name: String|
    if !name.starts_with("run") || run.ends_with("/" ++ name) { any } else if abandoned(name) {
      removed(name);
      any
    } else { true });
  if !running {
    let own = manifest_name(schema);
    let previous = previous_manifest[r](dir, names, own);
    let kept_manifests = match previous { Some(p) -> [own, p.name], None -> [own] };
    let kept_segments = manifest[r](dir, schema).segments.concat(match previous {
      Some(p) -> p.manifest.segments,
      None -> [],
    }).map(|s: Segment| segment_name(s.token));
    names.fold((), |_: Unit, name: String|
      if (name.starts_with("manifest-") && !kept_manifests.contains(name))
          || (name.starts_with("seg-") && !kept_segments.contains(name)) { removed(name) })
  }
}

type PreviousManifest = { name: String, manifest: Manifest, modified: Int }

fn previous_manifest<[r]>(
  dir: String,
  names: List<String>,
  own: String,
) -> Option<PreviousManifest> / {fs.read[r], abort.raise} =
  names.fold(None, |newest: Option<PreviousManifest>, name: String|
    if !name.starts_with("manifest-") || name == own || name.len() != own.len() { newest } else {
      match ((fs.read_file[r](dir ++ "/" ++ name), fs.modified_ms[r](dir ++ "/" ++ name))) {
        (Some(bytes), Some(modified)) -> match manifest_from(bytes) {
          Some(m) -> match newest {
            Some(n) -> if n.modified >= modified { newest }
            else { Some({ name: name, manifest: m, modified: modified }) },
            None -> Some({ name: name, manifest: m, modified: modified }),
          },
          None -> newest,
        },
        _ -> newest,
      }
    })

const test_shapes: Bytes = b"shapes".blake3()

fn write_test_segment<[r]>(
  dir: String,
  schema: Bytes,
  token: Bytes,
  pairs: List<{ key: Bytes, value: Bytes }>,
) -> Segment / {fs.write[r], abort.raise} = {
  fs.create_dir[r](dir);
  let placed = pairs.fold(
    { writing: new_writer, rows: Map::new() },
    |accumulator: { writing: SegmentWriter, rows: Map<Bytes, Bytes> }, p: { key: Bytes, value: Bytes }| {
      let f = append_payload(accumulator.writing, p.value);
      {
        writing: f.writing,
        rows: accumulator.rows.insert(p.key, u64_le(f.at).concat(u32_le(p.value.len()))),
      }
    },
  );
  match finish[r](dir, schema, token, placed.writing, [table(1, placed.rows)]) {
    Some(seg) -> seg,
    None -> panic("the test's file system could not write the stored file segment"),
  }
}

fn write_segment<[r]>(
  dir: String,
  token: Bytes,
  pairs: List<{ key: Bytes, value: Bytes }>,
) -> Segment / {fs.write[r], abort.raise} = write_test_segment[r](dir, test_shapes, token, pairs)

fn lookup<[r]>(dir: String, key: Bytes) -> Option<Bytes> / {fs.read[r], abort.raise} = {
  let m = manifest[r](dir, test_shapes);
  range(0, m.segments.len()).fold(None, |accumulator: Option<Bytes>, i: Int|
    match accumulator {
      Some(_) -> accumulator,
      None -> {
        let seg = m.segments.get(m.segments.len() - 1 - i);
        match table_entry(seg, 1) {
          None -> None,
          Some(entry) -> match table_index[r](dir, seg.token, entry, true) {
            None -> None,
            Some(index) -> match block_holding(index, key) {
              None -> None,
              Some(block) -> match block_rows[r](dir, seg.token, block, true) {
                None -> None,
                Some(rows) -> match value_in(rows, key) {
                  None -> None,
                  Some(place) -> payload[r](dir, seg.token, read_u64(place, 0), read_u32(place, 8)),
                },
              },
            },
          },
        }
      },
    })
}

fn committed_manifest(c: CommitResult) -> Manifest =
  match c { Committed(m) -> m, _ -> empty_manifest }

fn names_in(tree: fs::MemFs, dir: String) -> List<String> / {abort.raise} =
  match fs::listed_names(fs::mem_list(tree, dir)) { Some(names) -> names, None -> [] }

test "`lookup` reads segment values through the manifest, newest segment first" {
  let run = fs::on_mem[abs](fs::mem_of([]), || {
    let first = write_segment[abs]("s", b"token--1", [
      { key: b"a".blake3(), value: b"one" },
      { key: b"b".blake3(), value: b"two" },
    ]);
    let m1 = committed_manifest(commit[abs]("s", test_shapes, first));
    let second = write_segment[abs]("s", b"token--2", [{ key: b"a".blake3(), value: b"anew" }]);
    let m2 = committed_manifest(commit[abs]("s", test_shapes, second));
    {
      generations: [m1.generation, m2.generation],
      a: lookup[abs]("s", b"a".blake3()),
      b: lookup[abs]("s", b"b".blake3()),
      c: lookup[abs]("s", b"c".blake3()),
    }
  });
  assert_eq(run.value.generations, [1, 2]);
  assert_eq(run.value.a, Some(b"anew"));
  assert_eq(run.value.b, Some(b"two"));
  assert_eq(run.value.c, None);
  assert_eq(names_in(run.tree, "s").len(), 3)
}

test "committing a segment after another run committed one gives a manifest that lists both segments" {
  let run = fs::on_mem[abs](fs::mem_of([]), || {
    let a = write_segment[abs]("s", b"token--a", [{ key: b"a".blake3(), value: b"one" }]);
    let b = write_segment[abs]("s", b"token--b", [{ key: b"b".blake3(), value: b"two" }]);
    commit[abs]("s", test_shapes, a);
    let second = committed_manifest(commit[abs]("s", test_shapes, b));
    { second: second, a: lookup[abs]("s", b"a".blake3()), b: lookup[abs]("s", b"b".blake3()) }
  });
  assert_eq(run.value.second.generation, 2);
  assert_eq(run.value.second.segments.len(), 2);
  assert_eq([run.value.a, run.value.b], [Some(b"one"), Some(b"two")])
}

test "a manifest or table that fails verification is treated as missing, never partly read" {
  let run = fs::on_mem[abs](fs::mem_of([]), || {
    let seg = write_segment[abs]("s", b"token--1", [{ key: b"a".blake3(), value: b"one" }]);
    let m = committed_manifest(commit[abs]("s", test_shapes, seg));
    let entry = List::get(m.segments.get(0).parts, 0);
    let whole = table_index[abs]("s", seg.token, entry, true) != None;
    let torn = table_index[abs]("s", seg.token, { ..entry, sum: b"12345678" }, true);
    let path = "s/" ++ manifest_name(test_shapes);
    let bytes = match fs.read_file[abs](path) { Some(b) -> b, None -> b"" };
    fs.write_file[abs](path, bytes.slice(0, bytes.len() - 1));
    { whole: whole, torn: torn, cut: manifest[abs]("s", test_shapes) }
  });
  assert(run.value.whole);
  assert_eq(run.value.torn, None);
  assert_eq(run.value.cut, empty_manifest)
}

test "a store with a different set of query shapes in the same directory starts with an empty manifest" {
  let run = fs::on_mem[abs](fs::mem_of([]), || {
    let seg = write_segment[abs]("s", b"token--1", [{ key: b"a".blake3(), value: b"one" }]);
    commit[abs]("s", test_shapes, seg);
    manifest[abs]("s", b"other shapes".blake3())
  });
  assert_eq(run.value, empty_manifest)
}

test "a merge replaces its merged segments only if no other run committed meanwhile, and otherwise reports `StoreChanged`" {
  let run = fs::on_mem[abs](fs::mem_of([]), || {
    let a = write_segment[abs]("s", b"token--a", [{ key: b"a".blake3(), value: b"one" }]);
    let m1 = committed_manifest(commit[abs]("s", test_shapes, a));
    let b = write_segment[abs]("s", b"token--b", [{ key: b"b".blake3(), value: b"two" }]);
    let m2 = committed_manifest(commit[abs]("s", test_shapes, b));
    let both = write_segment[abs]("s", b"token--c", [
      { key: b"a".blake3(), value: b"one" },
      { key: b"b".blake3(), value: b"two" },
    ]);
    let late = replace_merged[abs]("s", test_shapes, m1, 0, both);
    let flush = committed_manifest(replace_merged[abs]("s", test_shapes, m2, 0, both));
    {
      shed_timed_out: late,
      landed: flush,
      a: lookup[abs]("s", b"a".blake3()),
      b: lookup[abs]("s", b"b".blake3()),
    }
  });
  assert_eq(run.value.shed_timed_out, StoreChanged);
  assert_eq(run.value.landed.generation, 3);
  assert_eq(run.value.landed.segments.map(|s: Segment| s.token), [b"token--c"]);
  assert_eq(run.value.a, Some(b"one"));
  assert_eq(run.value.b, Some(b"two"))
}

fn sized(size: Int) -> Segment = { token: b"", at: 0, size: size, parts: [] }

test "`merge_start` returns where to start merging: the newest run of segments in which each is at most twice the size of the next older segment" {
  let due = |sizes: List<Int>| merge_start({ generation: 0, segments: sizes.map(sized) });
  assert_eq(due([]), 0 - 1);
  assert_eq(due([400]), 0);
  assert_eq(due([400, 1]), 1);
  assert_eq(due([400, 3, 1]), 2);
  assert_eq(due([400, 1, 1]), 1);
  assert_eq(due([400, 3, 1, 1]), 1);
  assert_eq(due([400, 150, 80]), 0)
}

const other_shapes: Bytes = b"other shapes".blake3()

fn two_schemas_and_another_run() -> fs::MemResult<Option<String>> / {abort.raise} =
  fs::on_mem[abs](fs::mem_of([]), || {
    let x = write_test_segment[abs]("s", oldest_shapes, b"token--x", [
      { key: b"x".blake3(), value: b"oldest" },
    ]);
    commit[abs]("s", oldest_shapes, x);
    let a = write_segment[abs]("s", b"token--a", [{ key: b"a".blake3(), value: b"one" }]);
    commit[abs]("s", test_shapes, a);
    write_segment[abs]("s", b"token--b", [{ key: b"b".blake3(), value: b"two" }]);
    let o = write_test_segment[abs]("s", other_shapes, b"token--o", [
      { key: b"o".blake3(), value: b"other" },
    ]);
    commit[abs]("s", other_shapes, o);
    fs.write_file[abs]("s/" ++ manifest_name(test_shapes) ++ ".746f6b656e.tmp", b"torn");
    fs.write_file[abs]("s/" ++ manifest_name(other_shapes) ++ ".746f6b656e.tmp", b"torn");
    fs.temp_dir[abs]("s", "run")
  })

fn swept(tree: fs::MemFs) -> fs::MemFs / {abort.raise} =
  fs::on_mem[abs](tree, || {
    let run = start_run[abs]("s");
    match run {
      Some(path) -> sweep[abs]("s", test_shapes, path),
      None -> panic("the test's file system could not make a run directory"),
    };
    end_run[abs](run)
  }).tree

fn ended(tree: fs::MemFs, run: Option<String>) -> fs::MemFs / {abort.raise} =
  fs::on_mem[abs](tree, || end_run[abs](run)).tree

test "a sweep keeps its own schema and the one used before it, and removes every other manifest and every segment neither lists, once no other run is active" {
  let made = two_schemas_and_another_run();
  assert_eq(
    Set::of_list(names_in(swept(ended(made.tree, made.value)), "s")),
    Set::of_list([
      manifest_name(test_shapes),
      manifest_name(other_shapes),
      segment_name(b"token--a"),
      segment_name(b"token--o"),
    ]),
  )
}

const oldest_shapes: Bytes = b"oldest shapes".blake3()

test "a sweep removes nothing while another run is active, whatever that run's schema" {
  let made = two_schemas_and_another_run();
  assert_eq(names_in(swept(made.tree), "s"), names_in(made.tree, "s"))
}

test "a sweep never removes a segment its own manifest lists, and every value stays readable" {
  let made = fs::on_mem[abs](fs::mem_of([]), || {
    let a = write_segment[abs]("s", b"token--a", [{ key: b"a".blake3(), value: b"one" }]);
    commit[abs]("s", test_shapes, a);
    let o = write_test_segment[abs]("s", other_shapes, b"token--o", [
      { key: b"o".blake3(), value: b"other" },
    ]);
    commit[abs]("s", other_shapes, o);
    let b = write_segment[abs]("s", b"token--b", [{ key: b"b".blake3(), value: b"two" }]);
    commit[abs]("s", test_shapes, b);
    ()
  });
  let read = fs::on_mem[abs](swept(made.tree), ||
    [lookup[abs]("s", b"a".blake3()), lookup[abs]("s", b"b".blake3())]);
  assert_eq(read.value, [Some(b"one"), Some(b"two")]);
  let remaining_names = names_in(read.tree, "s");
  assert(
    remaining_names.contains(segment_name(b"token--a"))
      && remaining_names.contains(segment_name(b"token--b")),
  )
}

pub fn rows_folded<a | e>(count: Int, init: a, f: (a, Int) -> a / e) -> a / {abort.raise | e} =
  iterate({ at: 0, value: init }, count + 1, |s: { at: Int, value: a }|
    if s.at >= count { Stop(s.value) } else { Continue({ at: s.at + 1, value: f(s.value, s.at) }) })

test "a sorted table returns each key's value, nothing for other keys, and its rows in key order" {
  let rows = Map::new().insert(b"b", b"2").insert(b"ab", b"").insert(b"a", b"one").insert(
    b"abc",
    b"three",
  );
  let encoded = table_bytes(table_of_rows(rows.entries()));
  let read = match decoded_table(encoded) {
    Some(table) -> table,
    None -> panic("a table that was just encoded does not decode"),
  };
  assert_eq(
    rows.keys().map(|key: Bytes| value_in(read, key)),
    rows.values().map(|value: Bytes| Some(value)),
  );
  assert_eq([b"", b"aa", b"abcd", b"c"].map(|key: Bytes| value_in(read, key)), [
    None,
    None,
    None,
    None,
  ]);
  assert_eq(range(0, row_count(read)).map(|row: Int| row_at(read, row)), rows.entries());
  assert_eq(row_at(read, lower_bound(read, b"aa")).key, b"ab");
  assert_eq(value_in(empty_table, b"a"), None);
  assert_eq(decoded_table(encoded.slice(0, 9)), None)
}

test "a table larger than a block finds every key through its index, and a range spans the blocks it crosses" {
  let rows = range(0, 2000).fold(Map::new(), |m: Map<Bytes, Bytes>, i: Int|
    m.insert(u32_be(i), Bytes::of_string("value " ++ i.to_string())));
  let run = fs::on_mem[abs](fs::mem_of([]), || {
    let seg = write_segment[abs]("s", b"token--1", rows.entries());
    let entry = List::get(seg.parts, 0);
    let index = match table_index[abs]("s", seg.token, entry, true) {
      Some(i) -> i,
      None -> panic("the index reads"),
    };
    let block = |key: Bytes|
      match block_holding(index, key) {
        Some(place) -> match block_rows[abs]("s", seg.token, place, true) {
          Some(b) -> b,
          None -> panic("a block reads"),
        },
        None -> empty_table,
      };
    let middle = blocks_for(index, u32_be(500), Some(u32_be(1500))).fold(
      [],
      |found: List<Row>, place: BlockPlace|
        match block_rows[abs]("s", seg.token, place, true) {
          Some(b) -> found.concat(rows_between(b, u32_be(500), Some(u32_be(1500)))),
          None -> found,
        },
    );
    {
      blocks: row_count(index),
      found: rows.keys().all(|key: Bytes| value_in(block(key), key) != None),
      missing: value_in(block(u32_be(5000)), u32_be(5000)),
      middle: middle,
    }
  });
  assert(run.value.blocks > 1, None);
  assert(run.value.found, None);
  assert_eq(run.value.missing, None);
  assert_eq(run.value.middle.map(|r: Row| r.key), range(500, 1500).map(u32_be))
}

test "`rows_folded` visits each row index exactly once, in order" {
  assert_eq(rows_folded(3, [], |seen: List<Int>, i: Int| seen.push(i)), [0, 1, 2]);
  assert_eq(rows_folded(0, [7], |seen: List<Int>, i: Int| seen.push(i)), [7])
}
