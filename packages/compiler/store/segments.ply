//! Immutable segments named by one manifest: where a program that runs briefly keeps keyed bytes
//! between runs and reads a little of them. A segment is written once, by one run, in order: a
//! header, frames, then tables of fixed-width rows sorted by their keys. The manifest names the
//! segments a store is, oldest first, and where each table lies, and is replaced whole under a
//! lock, so what a run wrote is there for every later run or for none. A reader holds the manifest,
//! searches a table in place and reads a frame by its offset: opening a store costs one small
//! file, and a store is a handful of files however much it holds.
//!
//! A run makes a directory of its own in the store before it reads the manifest and removes it when
//! it ends. A sweep removes a segment no manifest names only while no other run's directory is
//! there, so a run reads every segment of the manifest it read to its end.

import std.fs
import std.fs (fs)
import std.hash (checksum)
import std.bytes (u32_le, u64_le)
import std.list

// --- Layout -----------------------------------------------------------------

/// Moves whenever the bytes on disk change meaning: a manifest of another format reads as none.
fn format() -> Int = 3

fn segment_magic() -> Bytes = b"PLYSEGM1"

fn manifest_magic() -> Bytes = b"PLYSEGS1"

/// A frame's payload length and its checksum.
fn frame_header_len() -> Int = 12

/// Magic, format, token and shapes.
pub fn header_len() -> Int = 52

/// The most one read asks for: a table or an answer longer than this is read in parts.
fn max_read_size() -> Int = 33554432

/// How many bytes of frames wait before they are appended.
fn flush_threshold() -> Int = 8388608

/// How long a run's directory stands for a run still going, in milliseconds: one older is left by
/// a run that died.
fn stale_run_ms() -> Int = 3600000

/// How long a manifest of other shapes stands for a store still used, in milliseconds.
fn stale_manifest_ms() -> Int = 172800000

/// The four bytes of `b` at `at` as a number, least significant first: zero past either end.
pub fn read_u32(b: Bytes, at: Int) -> Int = match b.u32_at(at) { Some(n) -> n, None -> 0 }

/// The eight bytes of `b` at `at` as a number, least significant first: zero past either end.
pub fn read_u64(b: Bytes, at: Int) -> Int = match b.u64_at(at) { Some(n) -> n, None -> 0 }

/// One table of a segment: its number, how wide a row is, how many rows it holds, where they start
/// and their checksum.
pub type TableEntry = { table: Int, width: Int, count: Int, offset: Int, sum: Bytes }

/// A segment as the manifest names it: its token, the generation that named it, its length and its
/// tables.
pub type Segment = { token: Bytes, at: Int, size: Int, parts: List<TableEntry> }

/// The segments a store is, oldest first, and the generation of its last commit.
pub type Manifest = { generation: Int, segments: List<Segment> }

/// A store that holds nothing.
pub fn empty_manifest() -> Manifest = { generation: 0, segments: [] }

fn manifest_name(schema: Bytes) -> String / {abort.raise} =
  "manifest-" ++ schema.slice(0, 8).hex_of()

fn segment_name(token: Bytes) -> String / {abort.raise} = "seg-" ++ token.hex_of()

/// The file of the segment `token` names.
pub fn segment_path(dir: String, token: Bytes) -> String / {abort.raise} =
  dir ++ "/" ++ segment_name(token)

fn lock_path(dir: String) -> String = dir ++ "/lock"

// --- The manifest -----------------------------------------------------------

fn table_entry_bytes(p: TableEntry) -> Bytes =
  Bytes::concat_all([u32_le(p.table), u32_le(p.width), u64_le(p.count), u64_le(p.offset), p.sum])

fn segment_bytes(s: Segment) -> Bytes =
  Bytes::concat_all([
    s.token,
    u64_le(s.at),
    u64_le(s.size),
    u32_le(s.parts.len()),
    Bytes::concat_all(s.parts.map(table_entry_bytes)),
  ])

fn manifest_bytes(m: Manifest) -> Bytes / {abort.raise} = {
  let body = Bytes::concat_all([
    manifest_magic(),
    u32_le(format()),
    u64_le(m.generation),
    u32_le(m.segments.len()),
    Bytes::concat_all(m.segments.map(segment_bytes)),
  ]);
  body.concat(checksum(body))
}

type Decoded<a> = { value: a, at: Int }

fn table_entries_from(
  b: Bytes,
  at: Int,
  end_run: Int,
  acc: List<TableEntry>,
) -> Decoded<List<TableEntry>> / {abort.raise} =
  if end_run <= 0 { { value: acc, at: at } } else {
    table_entries_from(
      b,
      at + 32,
      end_run - 1,
      acc.push({
        table: read_u32(b, at),
        width: read_u32(b, at + 4),
        count: read_u64(b, at + 8),
        offset: read_u64(b, at + 16),
        sum: b.slice(at + 24, at + 32),
      }),
    )
  }

fn segments_from(
  b: Bytes,
  at: Int,
  end_run: Int,
  acc: List<Segment>,
) -> List<Segment> / {abort.raise} =
  if end_run <= 0 { acc } else {
    let parts = table_entries_from(b, at + 28, read_u32(b, at + 24), []);
    segments_from(
      b,
      parts.at,
      end_run - 1,
      acc.push({
        token: b.slice(at, at + 8),
        at: read_u64(b, at + 8),
        size: read_u64(b, at + 16),
        parts: parts.value,
      }),
    )
  }

/// The manifest `b` holds: none for bytes of another format, or that do not match their checksum.
fn manifest_from(b: Bytes) -> Option<Manifest> / {abort.raise} = {
  let n = b.len();
  if n < 32 || b.slice(0, 8) != manifest_magic() || read_u32(b, 8) != format() { None }
  else if checksum(b.slice(0, n - 8)) != b.slice(n - 8, n) { None } else {
    Some({ generation: read_u64(b, 12), segments: segments_from(b, 24, read_u32(b, 20), []) })
  }
}

/// The manifest the store in `dir` holds for `schema`: nothing where there is none, or where what is
/// there does not read as one. Its name carries the shapes, so a program that keeps other shapes in
/// the directory reads and replaces a manifest of its own.
pub fn manifest<[r]>(dir: String, schema: Bytes) -> Manifest / {fs.read[r], abort.raise} =
  match fs.read_file[r](dir ++ "/" ++ manifest_name(schema)) {
    None -> empty_manifest(),
    Some(b) -> match manifest_from(b) { Some(m) -> m, None -> empty_manifest() },
  }

/// Whether the store in `dir` holds a manifest for `schema` that does not read as one.
pub fn unreadable<[r]>(dir: String, schema: Bytes) -> Bool / {fs.read[r], abort.raise} =
  match fs.read_file[r](dir ++ "/" ++ manifest_name(schema)) {
    None -> false,
    Some(b) -> manifest_from(b) == None,
  }

/// Whether the store in `dir` holds a manifest of other shapes than `schema`: what another program
/// keeps there, which this one does not read.
pub fn has_other_manifests<[r]>(dir: String, schema: Bytes) -> Bool / {fs.read[r], abort.raise} = {
  let own = manifest_name(schema);
  List::fold(
    match fs::listed_names(fs.list_dir[r](dir)) { Some(names) -> names, None -> [] },
    false,
    |any: Bool, name: String|
      any || (name.starts_with("manifest-") && name != own && !name.starts_with(own ++ ".")),
  )
}

// --- A run's hold on a store -------------------------------------------------

/// A run's directory in the store in `dir`, made before the run reads the manifest: none where the
/// store takes no write.
pub fn start_run<[r]>(dir: String) -> Option<String> / {fs.write[r]} = {
  fs.create_dir[r](dir);
  fs.temp_dir[r](dir, "run")
}

/// A run's directory removed, as the run ends.
pub fn end_run<[r]>(run: Option<String>) -> Unit / {fs.write[r]} =
  match run {
    Some(path) -> {
      fs.remove[r](path);
      ()
    },
    None -> (),
  }

/// When the run whose directory is `run` began, in milliseconds since the epoch.
pub fn run_start_ms<[r]>(run: Option<String>) -> Int / {fs.read[r]} =
  match run { Some(path) -> match fs.modified_ms[r](path) { Some(ms) -> ms, None -> 0 }, None -> 0 }

/// What names the `nth` segment a run writes: `run` is its directory and `generation` that of the
/// manifest it read, so no two runs of a store write one name.
pub fn segment_token(run: Option<String>, generation: Int, nth: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    Bytes::of_string(match run { Some(path) -> path, None -> "" }),
    u64_le(generation),
    u64_le(nth),
  ]).blake3(
  ).slice(
    0,
    8,
  )

// --- Reading ----------------------------------------------------------------

/// `len` bytes from `offset` of the file at `path`, read in parts where one read would be too long:
/// none where the file is shorter.
pub fn read_range<[r]>(
  path: String,
  offset: Int,
  len: Int,
) -> Option<Bytes> / {fs.read[r], abort.raise} =
  if len <= max_read_size() {
    match fs.read_at[r](path, offset, len) {
      Some(b) -> if b.len() == len { Some(b) } else { None },
      None -> None,
    }
  } else {
    let read = iterate(
      { at: offset, left: len, got: [] },
      1048576,
      |x: { at: Int, left: Int, got: List<Bytes> }|
        if x.left <= 0 { Stop(Some(x.got)) } else {
          let n = min(x.left, max_read_size());
          match fs.read_at[r](path, x.at, n) {
            Some(b) -> if b.len() != n { Stop(None) }
            else { Continue({ at: x.at + n, left: x.left - n, got: x.got.push(b) }) },
            None -> Stop(None),
          }
        },
    );
    match read { Some(parts) -> Some(Bytes::concat_all(parts)), None -> None }
  }

fn find_table(parts: List<TableEntry>, table: Int) -> Option<TableEntry> =
  parts.fold(None, |acc: Option<TableEntry>, p: TableEntry|
    match acc { Some(_) -> acc, None -> if p.table == table { Some(p) } else { None } })

/// The rows of `table` in `seg`, empty where it holds none: none where they cannot be read whole or
/// do not match their checksum, which is a damaged segment.
pub fn table_rows<[r]>(
  dir: String,
  seg: Segment,
  table: Int,
) -> Option<Bytes> / {fs.read[r], abort.raise} =
  match find_table(seg.parts, table) {
    None -> Some(b""),
    Some(p) -> if p.count == 0 { Some(b"") } else {
      match read_range[r](segment_path(dir, seg.token), p.offset, p.count * p.width) {
        Some(b) -> if checksum(b) == p.sum { Some(b) } else { None },
        None -> None,
      }
    },
  }

/// A key's first four bytes as a number, high byte first: rows whose keys differ there order as
/// those numbers do, so a search slices a key only where two of them tie.
fn key_prefix(b: Bytes, at: Int) -> Int = {
  let le = read_u32(b, at);
  (le & 255) << 24 | (le >> 8 & 255) << 16 | (le >> 16 & 255) << 8 | le >> 24 & 255
}

/// How many of `rows`, each `width` bytes and sorted by its leading bytes, lie below `key`: the
/// place of the first row that leads with `key` or lies past it. `key` is four bytes or longer.
pub fn lower_bound(table_rows: Bytes, width: Int, key: Bytes) -> Int / {abort.raise} = {
  let n = key.len();
  let head = key_prefix(key, 0);
  iterate({ lo: 0, hi: table_rows.len() / width }, 65, |x: { lo: Int, hi: Int }|
    if x.lo >= x.hi { Stop(x.lo) } else {
      let mid = x.lo + (x.hi - x.lo) / 2;
      let at = mid * width;
      let h = key_prefix(table_rows, at);
      let under = if h != head { h < head }
      else { compare_values(table_rows.slice(at, at + n), key) == Less };
      if under { Continue({ lo: mid + 1, hi: x.hi }) } else { Continue({ lo: x.lo, hi: mid }) }
    })
}

/// The row of `rows` that leads with `key`, where there is one.
pub fn row_of(table_rows: Bytes, width: Int, key: Bytes) -> Option<Bytes> / {abort.raise} = {
  let at = lower_bound(table_rows, width, key) * width;
  if at + width <= table_rows.len() && table_rows.slice(at, at + key.len()) == key {
    Some(table_rows.slice(at, at + width))
  } else { None }
}

/// Every row of `rows` that leads with `key`, in their order.
pub fn rows_of(table_rows: Bytes, width: Int, key: Bytes) -> List<Bytes> / {abort.raise} = {
  let n = key.len();
  iterate(
    { i: lower_bound(table_rows, width, key), out: [] },
    1000000000,
    |x: { i: Int, out: List<Bytes> }| {
      let at = x.i * width;
      if at + width <= table_rows.len() && table_rows.slice(at, at + n) == key {
        Continue({ i: x.i + 1, out: x.out.push(table_rows.slice(at, at + width)) })
      } else { Stop(x.out) }
    },
  )
}

// --- Frames -----------------------------------------------------------------

/// `payload` as a segment holds it: its length and a checksum before it.
pub fn framed(payload: Bytes) -> Bytes / {abort.raise} = {
  let head = u32_le(payload.len());
  Bytes::concat_all([head, checksum(head.concat(payload)), payload])
}

/// How many bytes the frame of a payload of `len` bytes takes.
pub fn framed_len(len: Int) -> Int = frame_header_len() + len

/// The payload of exactly one frame: none for bytes that are not one or do not match their checksum.
pub fn unframed(b: Bytes) -> Option<Bytes> / {abort.raise} =
  if b.len() < frame_header_len() || read_u32(b, 0) != b.len() - frame_header_len() { None } else {
    let payload = b.slice(frame_header_len(), b.len());
    if checksum(b.slice(0, 4).concat(payload)) != b.slice(4, frame_header_len()) { None }
    else { Some(payload) }
  }

/// The payload of `len` bytes framed at `offset` of the segment `token` names.
pub fn payload<[r]>(
  dir: String,
  token: Bytes,
  offset: Int,
  len: Int,
) -> Option<Bytes> / {fs.read[r], abort.raise} =
  match read_range[r](segment_path(dir, token), offset, framed_len(len)) {
    Some(b) -> unframed(b),
    None -> None,
  }

// --- Writing ----------------------------------------------------------------

/// A segment as far as it is written: where its next byte lies, the bytes yet to be appended and
/// how many they are, the payloads framed among them by where each frame lies, and whether the file
/// system refused a write, after which nothing more is written.
pub type SegmentWriter = {
  end: Int,
  waiting: List<Bytes>,
  unwritten: Map<Int, Bytes>,
  buffered: Int,
  dead: Bool,
}

/// A segment of which nothing is written.
pub fn new_writer() -> SegmentWriter =
  { end: header_len(), waiting: [], unwritten: Map::new(), buffered: 0, dead: false }

/// A segment nothing can be written of.
pub fn failed_writer() -> SegmentWriter = { ..new_writer(), dead: true }

/// `w` with `payload` framed after what it holds, and where the frame lies.
pub fn append_payload(
  w: SegmentWriter,
  payload: Bytes,
) -> { writing: SegmentWriter, at: Int } / {abort.raise} = {
  let frame = framed(payload);
  {
    writing: {
      ..w,
      end: w.end + frame.len(),
      waiting: w.waiting.push(frame),
      unwritten: w.unwritten.insert(w.end, payload),
      buffered: w.buffered + frame.len(),
    },
    at: w.end,
  }
}

/// `w` with `frames`, whole frames read from another segment, after what it holds, and where they
/// lie.
pub fn append_frames(w: SegmentWriter, frames: Bytes) -> { writing: SegmentWriter, at: Int } =
  {
    writing: {
      ..w,
      end: w.end + frames.len(),
      waiting: w.waiting.push(frames),
      buffered: w.buffered + frames.len(),
    },
    at: w.end,
  }

/// The payload `w` framed at `at` and has yet to append.
pub fn pending_payload(w: SegmentWriter, at: Int) -> Option<Bytes> = w.unwritten.get(at)

fn header(schema: Bytes, token: Bytes) -> Bytes =
  Bytes::concat_all([segment_magic(), u32_le(format()), token, schema])

/// `w` with what waits and then `more` written to the segment `token` names, which its first write
/// starts under its header.
fn flush<[r]>(
  dir: String,
  schema: Bytes,
  token: Bytes,
  w: SegmentWriter,
  more: Bytes,
) -> SegmentWriter / {fs.write[r], abort.raise} =
  if w.dead { w } else {
    let path = segment_path(dir, token);
    let body = Bytes::concat_all(w.waiting).concat(more);
    let done = if w.end - w.buffered == header_len() {
      fs.write_file[r](path, header(schema, token).concat(body))
    } else { body.len() == 0 || fs.append[r](path, body) != None };
    if done {
      { end: w.end + more.len(), waiting: [], unwritten: Map::new(), buffered: 0, dead: false }
    } else { { ..w, dead: true } }
  }

/// `w` with what waits appended to the segment `token` names, once enough waits.
pub fn flush_when_full<[r]>(
  dir: String,
  schema: Bytes,
  token: Bytes,
  w: SegmentWriter,
) -> SegmentWriter / {fs.write[r], abort.raise} =
  if w.buffered > flush_threshold() { flush[r](dir, schema, token, w, b"") } else { w }

/// One table of a segment being finished: its number, how wide a row is, and its rows. A table is
/// made of a map's entries in their order and no other way, so a search of one misses no row.
pub opaque type Table = new { table: Int, width: Int, rows: Bytes }

/// The table numbered `table` of what `row` makes of each entry of `rows`: the entry's key, then
/// what `row` answers of it, and no row where it answers none. Every row is as wide as the first.
pub fn table<v>(
  table: Int,
  table_rows: Map<Bytes, v>,
  row: (Bytes, v) -> Option<Bytes> / {abort.raise},
) -> Table / {abort.raise} = {
  let built = table_rows.fold(
    { width: 0, rows: [] },
    |acc: { width: Int, rows: List<Bytes> }, key: Bytes, value: v|
      match row(key, value) {
        None -> acc,
        Some(rest) -> {
          let width = key.len() + rest.len();
          if acc.width != 0 && acc.width != width { panic("the rows of a table are one width") };
          { width: width, rows: acc.rows.push(key).push(rest) }
        },
      },
  );
  { table: table, width: built.width, rows: Bytes::concat_all(built.rows) }
}

/// The segment `token` names finished: what waits of `w` appended, then each of `tables` that holds
/// a row, in order. What a manifest names it as: none where the file system refused a write. The
/// file is no part of the store until a manifest names it.
pub fn finish<[r]>(
  dir: String,
  schema: Bytes,
  token: Bytes,
  w: SegmentWriter,
  tables: List<Table>,
) -> Option<Segment> / {fs.write[r], abort.raise} = {
  let built = tables.fold(
    { at: w.end, parts: [], bytes: [] },
    |acc: { at: Int, parts: List<TableEntry>, bytes: List<Bytes> }, t: Table|
      if t.rows.len() == 0 { acc } else {
        {
          at: acc.at + t.rows.len(),
          parts: acc.parts.push({
            table: t.table,
            width: t.width,
            count: t.rows.len() / t.width,
            offset: acc.at,
            sum: checksum(t.rows),
          }),
          bytes: acc.bytes.push(t.rows),
        }
      },
  );
  let done = flush[r](dir, schema, token, w, Bytes::concat_all(built.bytes));
  if done.dead { None } else { Some({ token: token, at: 0, size: done.end, parts: built.parts }) }
}

/// What a commit came to: the manifest it wrote; `LockHeld`, where another run would not let the lock
/// go; `StoreChanged`, where the store was no longer the one the commit was made for; or `WriteFailed`,
/// where the file system refused.
pub type CommitResult = | Committed(Manifest) | LockHeld | StoreChanged | WriteFailed

/// The manifest of the store in `dir` replaced by `m`, which names the segment of `token` last:
/// where `durable`, that segment, the manifest and the directory are each synced, so what the
/// manifest names outlives a loss of power.
fn replace_manifest<[r]>(
  dir: String,
  schema: Bytes,
  token: Bytes,
  m: Manifest,
  durable: Bool,
) -> Bool / {fs.write[r], abort.raise} = {
  let path = dir ++ "/" ++ manifest_name(schema);
  let tmp = path ++ "." ++ token.hex_of() ++ ".tmp";
  (!durable || fs.sync[r](segment_path(dir, token))) && fs.write_file[r](tmp, manifest_bytes(m))
    && (!durable || fs.sync[r](tmp))
    && fs.rename[r](tmp, path)
    && (!durable || fs.sync[r](dir))
}

/// `seg` named as the newest segment of the store in `dir`: the manifest is read again under the
/// store's lock, `seg` takes the next generation, and the manifest is replaced whole. `without`
/// names segments the run found damaged, which are named no longer. A `durable` commit is synced to
/// the disk before it answers.
pub fn commit<[r]>(
  dir: String,
  schema: Bytes,
  seg: Segment,
  without: List<Bytes> = [],
  durable: Bool = false,
) -> CommitResult / {fs.read[r], fs.write[r], abort.raise} =
  if !fs.lock[r](lock_path(dir)) { LockHeld } else {
    let now = manifest[r](dir, schema);
    let at = now.generation + 1;
    let next = {
      generation: at,
      segments: now.segments.filter(|s: Segment| !without.contains(s.token)).push({
        ..seg,
        at: at,
      }),
    };
    let done = replace_manifest[r](dir, schema, seg.token, next, durable);
    fs.unlock[r](lock_path(dir));
    if done { Committed(next) } else { WriteFailed }
  }

/// The segments of `m` from the one at `from` on replaced by `seg`, which holds what they held,
/// where the store's manifest is still `m`: how a merge lands, and `StoreChanged` where a run committed
/// while it worked.
pub fn replace_merged<[r]>(
  dir: String,
  schema: Bytes,
  m: Manifest,
  from: Int,
  seg: Segment,
  durable: Bool = false,
) -> CommitResult / {fs.read[r], fs.write[r], abort.raise} =
  if !fs.lock[r](lock_path(dir)) { LockHeld } else {
    let now = manifest[r](dir, schema);
    let at = m.generation + 1;
    let next = { generation: at, segments: m.segments.take(from).push({ ..seg, at: at }) };
    let done = now.generation == m.generation
      && replace_manifest[r](dir, schema, seg.token, next, durable);
    fs.unlock[r](lock_path(dir));
    if now.generation != m.generation { StoreChanged }
    else if done { Committed(next) }
    else { WriteFailed }
  }

/// Where the newest segments of `m` that are due to be written again as one start, by their place
/// among its segments: each of them is at most twice what the newer ones come to together. So a
/// store is a handful of segments, and a byte is written again only as often as what follows it
/// doubles. One less than the count of segments where the newest stands alone.
pub fn merge_start(m: Manifest) -> Int / {abort.raise} = {
  let n = m.segments.len();
  if n < 2 { n - 1 } else {
    iterate({ from: n - 1, sum: m.segments.get(n - 1).size }, n + 1, |x: { from: Int, sum: Int }|
      if x.from == 0 { Stop(0) } else {
        let older = m.segments.get(x.from - 1).size;
        if older > 2 * x.sum { Stop(x.from) }
        else { Continue({ from: x.from - 1, sum: x.sum + older }) }
      })
  }
}

// --- Sweeping ---------------------------------------------------------------

/// Whether the file `name` in `dir` is a segment of `schema`.
fn is_own_segment<[r]>(
  dir: String,
  name: String,
  schema: Bytes,
) -> Bool / {fs.read[r], abort.raise} =
  match fs.read_at[r](dir ++ "/" ++ name, 0, header_len()) {
    Some(b) ->
      b.len() == header_len() && b.slice(0, 8) == segment_magic() && read_u32(b, 8) == format()
        && b.slice(20, 52) == schema,
    None -> false,
  }

/// The store in `dir` rid of what no run reads any more, by the run whose directory is `run`, which
/// dates the sweep. Each of `retired`, the directories of a layout no program reads, goes whole. A
/// run's directory older than an hour was left by a run that died, and goes. A manifest of other
/// shapes that has not changed for two days goes. And while no other run's directory is there, so
/// no run still reads a manifest older than the one read here: every segment of `schema` the
/// store's manifest does not name, every manifest that was never renamed into place, and, once no
/// manifest of other shapes is left, every segment no manifest names.
pub fn sweep<[r]>(
  dir: String,
  schema: Bytes,
  run: String,
  retired: List<String>,
) -> Unit / {fs.read[r], fs.write[r], abort.raise} = {
  let names = match fs::listed_names(fs.list_dir[r](dir)) { Some(ns) -> ns, None -> [] };
  let now = run_start_ms[r](Some(run));
  let own = manifest_name(schema);
  let older = |name: String, bound: Int|
    match fs.modified_ms[r](dir ++ "/" ++ name) { Some(ms) -> now - ms > bound, None -> false };
  let removed = |name: String| {
    fs.remove[r](dir ++ "/" ++ name);
    ()
  };
  retired.fold((), |_: Unit, name: String|
    if names.contains(name) {
      fs.remove_tree[r](dir ++ "/" ++ name);
      ()
    });
  let running = names.fold(false, |any: Bool, name: String|
    if !name.starts_with("run") || retired.contains(name) || run.ends_with("/" ++ name) { any }
    else if older(name, stale_run_ms()) {
      removed(name);
      any
    } else { true });
  let has_other_manifests = names.fold(false, |any: Bool, name: String|
    if !name.starts_with("manifest-") || name == own || name.starts_with(own ++ ".") { any }
    else if older(name, stale_manifest_ms()) {
      removed(name);
      any
    } else { true });
  if !running {
    let m = manifest[r](dir, schema);
    let committed_manifest = m.segments.map(|s: Segment| segment_name(s.token));
    names.fold((), |_: Unit, name: String|
      if name.starts_with(own ++ ".") { removed(name) }
      else if name.starts_with("seg-") && !committed_manifest.contains(name)
          && (!has_other_manifests || is_own_segment[r](dir, name, schema)) { removed(name) })
  }
}

// --- Tests ------------------------------------------------------------------

fn test_shapes() -> Bytes = b"shapes".blake3()

/// A segment of the store in `dir` keeping `schema`, holding `pairs`, each a frame and a row of its
/// key and where the frame lies, in a table numbered one: what the manifest would name it as.
fn write_test_segment<[r]>(
  dir: String,
  schema: Bytes,
  token: Bytes,
  pairs: List<{ key: Bytes, value: Bytes }>,
) -> Segment / {fs.write[r], abort.raise} = {
  fs.create_dir[r](dir);
  let placed = pairs.fold(
    { writing: new_writer(), rows: Map::new() },
    |acc: { writing: SegmentWriter, rows: Map<Bytes, Bytes> }, p: { key: Bytes, value: Bytes }| {
      let f = append_payload(acc.writing, p.value);
      {
        writing: f.writing,
        rows: acc.rows.insert(p.key, u64_le(f.at).concat(u32_le(p.value.len()))),
      }
    },
  );
  match finish[r](dir, schema, token, placed.writing, [
      table(1, placed.rows, |_: Bytes, at: Bytes| Some(at)),
    ]) {
    Some(seg) -> seg,
    None -> panic("the test's file system refused a segment"),
  }
}

fn write_segment<[r]>(
  dir: String,
  token: Bytes,
  pairs: List<{ key: Bytes, value: Bytes }>,
) -> Segment / {fs.write[r], abort.raise} = write_test_segment[r](dir, test_shapes(), token, pairs)

/// What the store in `dir` holds under `key`, the newest segment first.
fn lookup<[r]>(dir: String, key: Bytes) -> Option<Bytes> / {fs.read[r], abort.raise} = {
  let m = manifest[r](dir, test_shapes());
  range(0, m.segments.len()).fold(None, |acc: Option<Bytes>, i: Int|
    match acc {
      Some(_) -> acc,
      None -> {
        let seg = m.segments.get(m.segments.len() - 1 - i);
        match table_rows[r](dir, seg, 1) {
          None -> None,
          Some(section) -> match row_of(section, 44, key) {
            None -> None,
            Some(row) -> payload[r](dir, seg.token, read_u64(row, 32), read_u32(row, 40)),
          },
        }
      },
    })
}

fn committed_manifest(c: CommitResult) -> Manifest =
  match c { Committed(m) -> m, _ -> empty_manifest() }

fn names_in(tree: fs::MemFs, dir: String) -> List<String> / {abort.raise} =
  match fs::listed_names(fs::mem_list(tree, dir)) { Some(names) -> names, None -> [] }

test "what a segment holds is read back through the manifest, the newest segment first" {
  let run = fs::on_mem[abs](fs::mem_of([]), || {
    let first = write_segment[abs]("s", b"token--1", [
      { key: b"a".blake3(), value: b"one" },
      { key: b"b".blake3(), value: b"two" },
    ]);
    let m1 = committed_manifest(commit[abs]("s", test_shapes(), first));
    let second = write_segment[abs]("s", b"token--2", [{ key: b"a".blake3(), value: b"anew" }]);
    let m2 = committed_manifest(commit[abs]("s", test_shapes(), second));
    {
      generations: [m1.generation, m2.generation],
      a: lookup[abs]("s", b"a".blake3()),
      b: lookup[abs]("s", b"b".blake3()),
      c: lookup[abs]("s", b"c".blake3()),
    }
  });
  assert_eq(run.value.generations, [1, 2]);
  assert_eq(run.value.a, Some(b"anew"));
  assert_eq(run.value.b, Some(b"two"));
  assert_eq(run.value.c, None);
  // A store is its segments, its manifest and nothing else once the lock is let go.
  assert_eq(names_in(run.tree, "s").len(), 3)
}

test "a commit made over a manifest another run replaced names both segments" {
  let run = fs::on_mem[abs](fs::mem_of([]), || {
    let a = write_segment[abs]("s", b"token--a", [{ key: b"a".blake3(), value: b"one" }]);
    let b = write_segment[abs]("s", b"token--b", [{ key: b"b".blake3(), value: b"two" }]);
    commit[abs]("s", test_shapes(), a);
    let second = committed_manifest(commit[abs]("s", test_shapes(), b));
    { second: second, a: lookup[abs]("s", b"a".blake3()), b: lookup[abs]("s", b"b".blake3()) }
  });
  assert_eq(run.value.second.generation, 2);
  assert_eq(run.value.second.segments.len(), 2);
  assert_eq([run.value.a, run.value.b], [Some(b"one"), Some(b"two")])
}

test "a manifest or a table that does not verify reads as none, never as part of one" {
  let run = fs::on_mem[abs](fs::mem_of([]), || {
    let seg = write_segment[abs]("s", b"token--1", [{ key: b"a".blake3(), value: b"one" }]);
    let m = committed_manifest(commit[abs]("s", test_shapes(), seg));
    let whole = table_rows[abs]("s", m.segments.get(0), 1) != None;
    let torn = table_rows[abs](
      "s",
      {
        ..m.segments.get(0),
        size: 0,
        parts: [{ ..List::get(m.segments.get(0).parts, 0), sum: b"12345678" }],
      },
      1,
    );
    let path = "s/" ++ manifest_name(test_shapes());
    let bytes = match fs.read_file[abs](path) { Some(b) -> b, None -> b"" };
    fs.write_file[abs](path, bytes.slice(0, bytes.len() - 1));
    { whole: whole, torn: torn, cut: manifest[abs]("s", test_shapes()) }
  });
  assert(run.value.whole);
  assert_eq(run.value.torn, None);
  assert_eq(run.value.cut, empty_manifest())
}

test "a store keeping other shapes in the same directory has a manifest of its own" {
  let run = fs::on_mem[abs](fs::mem_of([]), || {
    let seg = write_segment[abs]("s", b"token--1", [{ key: b"a".blake3(), value: b"one" }]);
    commit[abs]("s", test_shapes(), seg);
    manifest[abs]("s", b"other shapes".blake3())
  });
  assert_eq(run.value, empty_manifest())
}

test "a merge lands only where no run committed while it worked, and replaces what it merged" {
  let run = fs::on_mem[abs](fs::mem_of([]), || {
    let a = write_segment[abs]("s", b"token--a", [{ key: b"a".blake3(), value: b"one" }]);
    let m1 = committed_manifest(commit[abs]("s", test_shapes(), a));
    let b = write_segment[abs]("s", b"token--b", [{ key: b"b".blake3(), value: b"two" }]);
    let m2 = committed_manifest(commit[abs]("s", test_shapes(), b));
    let both = write_segment[abs]("s", b"token--c", [
      { key: b"a".blake3(), value: b"one" },
      { key: b"b".blake3(), value: b"two" },
    ]);
    let late = replace_merged[abs]("s", test_shapes(), m1, 0, both);
    let flush = committed_manifest(replace_merged[abs]("s", test_shapes(), m2, 0, both));
    {
      late: late,
      landed: flush,
      a: lookup[abs]("s", b"a".blake3()),
      b: lookup[abs]("s", b"b".blake3()),
    }
  });
  assert_eq(run.value.late, StoreChanged);
  assert_eq(run.value.landed.generation, 3);
  assert_eq(run.value.landed.segments.map(|s: Segment| s.token), [b"token--c"]);
  assert_eq(run.value.a, Some(b"one"));
  assert_eq(run.value.b, Some(b"two"))
}

fn sized(size: Int) -> Segment = { token: b"", at: 0, size: size, parts: [] }

test "the newest segments are due as one while each is at most twice what follows it" {
  let due = |sizes: List<Int>| merge_start({ generation: 0, segments: sizes.map(sized) });
  // Nothing to merge: no segment, one, or a newest far smaller than the one before it.
  assert_eq(due([]), 0 - 1);
  assert_eq(due([400]), 0);
  assert_eq(due([400, 1]), 1);
  assert_eq(due([400, 3, 1]), 2);
  // The two newest, then the three, and the whole store once what follows the oldest is half of it.
  assert_eq(due([400, 1, 1]), 1);
  assert_eq(due([400, 3, 1, 1]), 1);
  assert_eq(due([400, 150, 80]), 0)
}

test "a sweep removes what no manifest names, and nothing while another run is there" {
  let made = fs::on_mem[abs](fs::mem_of([{ path: "s/records/of-a", body: b"old" }]), || {
    let a = write_segment[abs]("s", b"token--a", [{ key: b"a".blake3(), value: b"one" }]);
    commit[abs]("s", test_shapes(), a);
    write_segment[abs]("s", b"token--b", [{ key: b"b".blake3(), value: b"two" }]);
    write_test_segment[abs]("s", b"other shapes".blake3(), b"token--o", [
      { key: b"o".blake3(), value: b"other" },
    ]);
    fs.write_file[abs]("s/" ++ manifest_name(test_shapes()) ++ ".746f6b656e.tmp", b"torn");
    fs.temp_dir[abs]("s", "run")
  });
  let other = match made.value { Some(path) -> path, None -> "" };
  let seg = |token: Bytes| segment_name(token);
  // Another run is there: only the retired layout goes.
  let held_back = fs::on_mem[abs](made.tree, || {
    let run = start_run[abs]("s");
    sweep[abs]("s", test_shapes(), match run { Some(path) -> path, None -> "" }, ["records"]);
    end_run[abs](run)
  });
  let kept = names_in(held_back.tree, "s");
  assert(!kept.contains("records"));
  assert(kept.contains(seg(b"token--b")) && kept.contains(seg(b"token--o")));
  // It ended: the segments no manifest names go, and the manifest never renamed into place.
  let alone = fs::on_mem[abs](held_back.tree, || {
    fs.remove[abs](other);
    let run = start_run[abs]("s");
    sweep[abs]("s", test_shapes(), match run { Some(path) -> path, None -> "" }, []);
    end_run[abs](run)
  });
  assert_eq(names_in(alone.tree, "s"), [manifest_name(test_shapes()), seg(b"token--a")])
}

test "a sweep leaves the segments of a store of other shapes while its manifest is in use" {
  let other = b"other shapes".blake3();
  let made = fs::on_mem[abs](fs::mem_of([]), || {
    let a = write_segment[abs]("s", b"token--a", [{ key: b"a".blake3(), value: b"one" }]);
    commit[abs]("s", test_shapes(), a);
    write_segment[abs]("s", b"token--b", [{ key: b"b".blake3(), value: b"two" }]);
    let o = write_test_segment[abs]("s", other, b"token--o", [
      { key: b"o".blake3(), value: b"other" },
    ]);
    commit[abs]("s", other, o);
    let run = start_run[abs]("s");
    sweep[abs]("s", test_shapes(), match run { Some(path) -> path, None -> "" }, []);
    end_run[abs](run)
  });
  let kept = names_in(made.tree, "s");
  assert(kept.contains(segment_name(b"token--o")) && kept.contains(manifest_name(other)));
  assert(!kept.contains(segment_name(b"token--b")));
  // Two days on, the other store's manifest has not changed: it goes, and its segments with it.
  let later = fs::on_mem[abs](made.tree, || {
    let run = start_run[abs]("s");
    let path = match run { Some(p) -> p, None -> "" };
    fs.set_modified[abs](path, run_start_ms[abs](run) + stale_manifest_ms() + 1);
    sweep[abs]("s", test_shapes(), path, []);
    end_run[abs](run)
  });
  assert_eq(names_in(later.tree, "s"), [manifest_name(test_shapes()), segment_name(b"token--a")])
}

pub fn rows_folded<a | e>(count: Int, init: a, f: (a, Int) -> a / e) -> a / {abort.raise | e} =
  iterate({ at: 0, value: init }, count + 1, |s: { at: Int, value: a }|
    if s.at >= count { Stop(s.value) } else { Continue({ at: s.at + 1, value: f(s.value, s.at) }) })

test "rows are folded once each, in order" {
  assert_eq(rows_folded(3, [], |seen: List<Int>, i: Int| seen.push(i)), [0, 1, 2]);
  assert_eq(rows_folded(0, [7], |seen: List<Int>, i: Int| seen.push(i)), [7])
}
