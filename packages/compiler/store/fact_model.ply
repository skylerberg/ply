import std.bin
import std.bytes (u64_le)
import std.fs
import std.fs (fs)
import std.gen
import std.list
import std.show (show)
import compiler.store.fact_edit (CheckedDefinition, EditResult, GroupInput, KeyedDefinition,
                                 SourceDefinition, apply_edit)
import compiler.store.fact_store
import compiler.store.fact_store (Contents, Database, fact_damage, undamaged)
import compiler.store.facts (Added, Change, Changed, Definition, Removed, SourceModule, TreeState,
                             definition_key, module_key, name_key)
import compiler.store.propagation (Recomputed, groups_of)
import compiler.store.segments
import compiler.store.segments (Committed)

type Item = { signature: Int, body: Int, mark: Int, mentions: List<String> }

derive bin for Item

type SourceFile = { comment: Int, items: Map<String, Item> }

derive bin for SourceFile

type Program = Map<String, SourceFile>

fn paths() -> List<String> = ["m0.ply", "m1.ply", "m2.ply"]

fn names() -> List<String> = ["a", "b", "c", "d", "e", "f", "g"]

fn item(signature: Int, mentions: List<String>) -> Item =
  { signature: signature, body: 0, mark: 0, mentions: mentions }

fn source_file(items: List<{ key: String, value: Item }>) -> SourceFile =
  { comment: 0, items: Map::of_entries(items) }

fn start_program() -> Program =
  Map::of_entries([
    {
      key: "m0.ply",
      value: source_file([
        { key: "a", value: item(1, ["b", "missing"]) },
        { key: "b", value: item(2, ["a", "c"]) },
        { key: "c", value: { ..item(3, []), mark: 1 } },
      ]),
    },
    {
      key: "m1.ply",
      value: source_file([
        { key: "d", value: item(4, ["a"]) },
        { key: "e", value: item(5, ["d", "c"]) },
      ]),
    },
    { key: "m2.ply", value: source_file([{ key: "f", value: item(6, ["e", "g"]) }]) },
  ])

fn tree_of(program: Program) -> TreeState / {abort.raise} =
  program.fold(Map::new(), |tree: TreeState, path: String, file: SourceFile|
    tree.insert(path, bin::encode(file, source_file_bin()).blake3()))

fn own_hash_of(found: Item) -> Bytes / {abort.raise} = bin::encode(found, item_bin()).blake3()

fn source_of(program: Program, path: String) -> List<SourceDefinition> / {abort.raise} =
  match program.get(path) {
    None -> [],
    Some(file) ->
      file.items.fold([], |found: List<SourceDefinition>, name: String, entry: Item|
        found.push({ name: name, own_hash: own_hash_of(entry), mentions: entry.mentions })),
  }

fn resolved(path: String, name: String, declared: List<Bytes>) -> Option<Bytes> / {abort.raise} = {
  let own = definition_key(path, name);
  if declared.contains(own) { Some(own) } else { declared.at(0) }
}

fn interface_of(signature: Int, summary: Int) -> Bytes = u64_le(signature).concat(u64_le(summary))

fn summary_of(interface: Bytes) -> Int = segments::read_u64(interface, 8)

fn item_of(program: Program, definition: Definition) -> Item / {abort.raise} =
  match program.get(definition.path) {
    None -> panic("the model has no such file"),
    Some(file) -> match file.items.get(definition.name) {
      None -> panic("the model has no such definition"),
      Some(found) -> found,
    },
  }

fn checked_group(program: Program, input: GroupInput) -> List<CheckedDefinition> / {abort.raise} = {
  let known = input.members.concat(input.read).fold(
    Map::new(),
    |found: Map<Bytes, Definition>, row: KeyedDefinition| found.insert(row.key, row.definition),
  );
  let summary = input.read.fold(
    input.members.fold(0, |marks: Int, row: KeyedDefinition|
      marks | item_of(program, row.definition).mark),
    |marks: Int, row: KeyedDefinition| marks | summary_of(row.definition.interface),
  );
  let missing = input.members.flat_map(|row: KeyedDefinition| {
    let found = row.definition.reads.fold([], |listed: List<String>, key: Bytes|
      match known.get(key) { Some(read) -> listed.push(read.name), None -> listed });
    item_of(program, row.definition).mentions.filter(|mention: String| !found.contains(mention))
  });
  let check = Bytes::concat_all(
    input.members.map(|row: KeyedDefinition| row.definition.own_hash).concat(
      input.read.flat_map(|row: KeyedDefinition| [row.key, row.definition.interface]),
    ).concat(
      missing.map(name_key),
    ),
  ).blake3(
  );
  input.members.map(|row: KeyedDefinition|
    {
      key: row.key,
      interface: interface_of(item_of(program, row.definition).signature, summary),
      check: check,
    })
}

type Declared = { key: Bytes, path: String, name: String, entry: Item }

fn declared_in(program: Program) -> List<Declared> =
  program.fold([], |all: List<Declared>, path: String, file: SourceFile|
    file.items.fold(all, |found: List<Declared>, name: String, entry: Item|
      found.push({ key: definition_key(path, name), path: path, name: name, entry: entry })))

fn with_listed(
  found: Map<Bytes, List<Bytes>>,
  key: Bytes,
  member: Bytes,
) -> Map<Bytes, List<Bytes>> =
  found.insert(key, (match found.get(key) { Some(listed) -> listed, None -> [] }).push(member))

fn sorted_lists(found: Map<Bytes, List<Bytes>>) -> Map<Bytes, List<Bytes>> =
  found.fold(Map::new(), |sorted: Map<Bytes, List<Bytes>>, key: Bytes, listed: List<Bytes>|
    sorted.insert(key, listed.sort().unique()))

fn row_of(found: Declared, group: Bytes, reads: List<Bytes>) -> Definition / {abort.raise} =
  {
    path: found.path,
    name: found.name,
    own_hash: own_hash_of(found.entry),
    interface: b"",
    check: b"",
    group: group,
    reads: reads,
  }

fn reference(program: Program) -> Contents / {abort.raise} = {
  let all = declared_in(program);
  let by_key = all.fold(Map::new(), |found: Map<Bytes, Declared>, d: Declared|
    found.insert(d.key, d));
  let symbols = sorted_lists(
    all.fold(Map::new(), |found: Map<Bytes, List<Bytes>>, d: Declared|
      with_listed(found, name_key(d.name), d.key)),
  );
  let reads_of = |d: Declared|
    d.entry.mentions.fold(Map::new(), |found: Map<Bytes, Unit>, mention: String|
      match resolved(d.path, mention, match symbols.get(name_key(mention)) {
          Some(listed) -> listed,
          None -> [],
        }) {
        Some(read) -> found.insert(read, ()),
        None -> found,
      }).keys(
    );
  let reads = all.fold(Map::new(), |found: Map<Bytes, List<Bytes>>, d: Declared|
    found.insert(d.key, reads_of(d)));
  let read_by = |key: Bytes| match reads.get(key) { Some(listed) -> listed, None -> [] };
  let declared_key = |key: Bytes|
    match by_key.get(key) { Some(found) -> found, None -> panic("the model lost a definition") };
  let groups = groups_of(all.map(|d: Declared| d.key), read_by);
  let definitions = groups.fold(Map::new(), |done: Map<Bytes, Definition>, group: List<Bytes>| {
    let rows = group.map(|key: Bytes|
      { key: key, definition: row_of(declared_key(key), group.get(0), read_by(key)) });
    let read = group.flat_map(read_by).filter(|key: Bytes| !group.contains(key)).sort().unique(
    ).map(|key: Bytes|
      match done.get(key) {
        Some(row) -> { key: key, definition: row },
        None -> panic("a group was checked before a definition it reads"),
      });
    let checked = checked_group(program, { members: rows, read: read });
    range(0, rows.len()).fold(done, |found: Map<Bytes, Definition>, i: Int| {
      let row = rows.get(i).definition;
      found.insert(rows.get(i).key, {
        ..row,
        interface: checked.get(i).interface,
        check: checked.get(i).check,
      })
    })
  });
  {
    files: tree_of(program),
    definitions: definitions,
    groups: groups.fold(Map::new(), |found: Map<Bytes, List<Bytes>>, group: List<Bytes>|
      found.insert(group.get(0), group)),
    modules: program.fold(
      Map::new(),
      |found: Map<Bytes, SourceModule>, path: String, file: SourceFile|
        found.insert(module_key(path), {
          path: path,
          definitions: file.items.keys().map(|name: String| definition_key(path, name)).sort(),
          lookups: file.items.values().flat_map(|entry: Item| entry.mentions.map(name_key)).sort(
          ).unique(
          ),
        }),
    ),
    symbols: symbols,
    dependents: sorted_lists(
      all.fold(Map::new(), |found: Map<Bytes, List<Bytes>>, d: Declared|
        read_by(d.key).fold(found, |edges: Map<Bytes, List<Bytes>>, read: Bytes|
          with_listed(edges, read, d.key))),
    ),
    lookups: sorted_lists(
      all.fold(Map::new(), |found: Map<Bytes, List<Bytes>>, d: Declared|
        d.entry.mentions.fold(found, |looked_up: Map<Bytes, List<Bytes>>, mention: String|
          with_listed(looked_up, name_key(mention), module_key(d.path)))),
    ),
  }
}

fn applied<[r]>(
  db: Database,
  program: Program,
) -> EditResult / {fs.read[r], fact_damage.damaged, abort.raise} =
  apply_edit[r](
    db,
    tree_of(program),
    |path: String| source_of(program, path),
    resolved,
    |input: GroupInput| checked_group(program, input),
  )

fn edit_committed<[r]>(
  program: Program,
) -> EditResult / {fs.read[r], fs.write[r], fact_damage.damaged, abort.raise} = {
  let result = applied[r](fact_store::open[r]("facts"), program);
  match fact_store::commit[r](result.database) {
    Committed(_) -> result,
    other -> panic("the edit did not commit: " ++ show(other)),
  }
}

fn edited_item(program: Program, path: String, name: String, change: (Item) -> Item) -> Program =
  match program.get(path) {
    None -> program,
    Some(file) -> match file.items.get(name) {
      None -> program,
      Some(entry) ->
        program.insert(path, { ..file, items: file.items.insert(name, change(entry)) }),
    },
  }

fn with_item(program: Program, path: String, name: String, added: Item) -> Program = {
  let file = match program.get(path) {
    Some(found) -> found,
    None -> { comment: 0, items: Map::new() },
  };
  program.insert(path, { ..file, items: file.items.insert(name, added) })
}

fn without_item(program: Program, path: String, name: String) -> Program =
  match program.get(path) {
    None -> program,
    Some(file) -> program.insert(path, { ..file, items: file.items.remove(name) }),
  }

fn edited(program: Program, draw: Int) -> Program / {abort.raise} = {
  let path = paths().get(draw / 16 % paths().len());
  let name = names().get(draw / 64 % names().len());
  let other = names().get(draw / 512 % names().len());
  let number = draw / 4096 % 4;
  match draw % 10 {
    0 -> edited_item(program, path, name, |entry: Item| { ..entry, body: entry.body + 1 }),
    1 -> edited_item(program, path, name, |entry: Item| { ..entry, mark: number }),
    2 -> edited_item(program, path, name, |entry: Item| { ..entry, signature: number }),
    3 -> with_item(program, path, name, item(number, [other])),
    4 -> without_item(program, path, name),
    5 ->
      edited_item(program, path, name, |entry: Item|
        { ..entry, mentions: entry.mentions.push(other).unique() }),
    6 ->
      edited_item(program, path, name, |entry: Item|
        { ..entry, mentions: entry.mentions.filter(|mention: String| mention != other) }),
    7 -> match program.get(path) {
      None -> program,
      Some(file) -> program.insert(path, { ..file, comment: file.comment + 1 }),
    },
    8 -> program.remove(path),
    _ -> edited_item(program, path, name, |entry: Item| { ..entry, mark: entry.mark ^ 1 }),
  }
}

type Walk = { program: Program, committed: Contents }

fn expected_changes(before: Contents, after: Contents) -> Map<Bytes, Change> = {
  let current = after.definitions.fold(
    Map::new(),
    |changes: Map<Bytes, Change>, key: Bytes, now: Definition|
      match before.definitions.get(key) {
        None -> changes.insert(key, { definition: key, kind: Added, interface_changed: true }),
        Some(earlier) -> if earlier.own_hash == now.own_hash && earlier.reads == now.reads
            && earlier.interface == now.interface { changes } else {
          changes.insert(key, {
            definition: key,
            kind: Changed,
            interface_changed: earlier.interface != now.interface,
          })
        },
      },
  );
  before.definitions.fold(current, |changes: Map<Bytes, Change>, key: Bytes, _: Definition|
    if after.definitions.contains(key) { changes }
    else { changes.insert(key, { definition: key, kind: Removed, interface_changed: true }) })
}

fn step<[r]>(walk: Walk) -> Walk / {fs.read[r], fs.write[r], fact_damage.damaged, abort.raise} = {
  let log_end = fact_store::open[r]("facts").log_end;
  edit_committed[r](walk.program);
  let reopened = fact_store::open[r]("facts");
  let expected = reference(walk.program);
  assert_eq(fact_store::contents[r](reopened), expected);
  let entries = fact_store::changes_after[r](reopened, log_end).flat_map(
    |entry: fact_store::LogEntry| entry.changes,
  );
  assert_eq(
    entries.fold(Map::new(), |changes: Map<Bytes, Change>, change: Change|
      changes.insert(change.definition, change)),
    expected_changes(walk.committed, expected),
  );
  assert(reopened.log_end - log_end <= 1, None);
  { program: walk.program, committed: expected }
}

fn holds_after_edits(draws: List<Int>) -> Bool / {abort.raise} = {
  let start = start_program();
  let ran = fs::on_mem[disk](fs::mem_of([]), ||
    undamaged(|| {
      edit_committed[disk](start);
      let walked = draws.fold(
        { program: start, committed: reference(start) },
        |walk: Walk, draw: Int| {
          let next = { ..walk, program: edited(walk.program, draw) };
          if draw / 8192 % 3 == 0 { next } else { step[disk](next) }
        },
      );
      let finished = step[disk](walked);
      (fact_store::open[disk]("facts").snapshot, finished.program)
    }));
  let built = fs::on_mem[disk](fs::mem_of([]), ||
    undamaged(|| {
      edit_committed[disk](ran.value._1);
      fact_store::open[disk]("facts").snapshot
    }));
  built.value == ran.value._0
}

test "after any series of edits, the database equals building the same program from nothing" {
  gen::check(gen::list_of(gen::below(1048576), 60), holds_after_edits, cases: 40)
}

fn rechecked(start: Program, program: Program) -> EditResult / {abort.raise} =
  fs::on_mem[disk](fs::mem_of([]), ||
    undamaged(|| {
      edit_committed[disk](start);
      edit_committed[disk](program)
    })).value

fn groups_recomputed(result: EditResult) -> List<List<Bytes>> =
  result.recomputed.map(|r: Recomputed<Bytes>| r.group)

fn key_in(path: String, name: String) -> Bytes = definition_key(path, name)

fn after_edit(start: Program, program: Program) -> Contents / {abort.raise} =
  fs::on_mem[disk](fs::mem_of([]), ||
    undamaged(|| {
      edit_committed[disk](start);
      edit_committed[disk](program);
      fact_store::contents[disk](fact_store::open[disk]("facts"))
    })).value

test "a body edit with an unchanged interface recomputes only that definition" {
  let start = start_program();
  let program = edited_item(start, "m1.ply", "d", |entry: Item| { ..entry, body: 1 });
  assert_eq(groups_recomputed(rechecked(start, program)), [[key_in("m1.ply", "d")]])
}

test "a body edit inside a group recomputes the whole group and no reader" {
  let start = start_program();
  let program = edited_item(start, "m0.ply", "a", |entry: Item| { ..entry, body: 1 });
  assert_eq(groups_recomputed(rechecked(start, program)), [
    [key_in("m0.ply", "a"), key_in("m0.ply", "b")].sort(),
  ])
}

test "adding a name that was missing reaches the modules that looked it up" {
  let start = start_program();
  let program = with_item(start, "m2.ply", "missing", item(9, []));
  let recomputed = groups_recomputed(rechecked(start, program)).flatten();
  assert(recomputed.contains(key_in("m0.ply", "a")), None);
  assert(recomputed.contains(key_in("m2.ply", "missing")), None);
  assert(!recomputed.contains(key_in("m1.ply", "e")), None);
  assert_eq(after_edit(start, program), reference(program))
}

test "a declaration that takes over a name reaches a definition whose text did not change" {
  let start = start_program();
  let program = with_item(start, "m1.ply", "c", { ..item(9, []), mark: 2 });
  let contents = after_edit(start, program);
  assert_eq(contents, reference(program));
  let reader = match contents.definitions.get(key_in("m1.ply", "e")) {
    Some(found) -> found,
    None -> panic("the reader is gone"),
  };
  assert(reader.reads.contains(key_in("m1.ply", "c")), None)
}

test "removing what a cycle's interfaces rested on clears them, because a group never reads its own old interface" {
  let start = with_item(
    with_item(Map::new(), "m0.ply", "x", { ..item(1, ["y"]), mark: 1 }),
    "m0.ply",
    "y",
    item(2, ["x"]),
  );
  let program = edited_item(start, "m0.ply", "x", |entry: Item| { ..entry, mark: 0 });
  let summaries = after_edit(start, program).definitions.values().map(|d: Definition|
    summary_of(d.interface));
  assert_eq(summaries, [0, 0]);
  assert_eq(after_edit(start, program), reference(program))
}

test "an edit that closes a cycle or opens one regroups every definition it affects" {
  let start = start_program();
  let closed = edited_item(start, "m0.ply", "c", |entry: Item|
    { ..entry, mentions: entry.mentions.push("a") });
  assert_eq(after_edit(start, closed), reference(closed));
  assert_eq(after_edit(closed, start), reference(start))
}

test "a definition that now reads a different definition is in the log, though its own hash and interface are the same" {
  let start = with_item(
    with_item(
      with_item(Map::new(), "m0.ply", "x", item(1, [])),
      "m0.ply",
      "reader",
      item(2, ["x"]),
    ),
    "m1.ply",
    "x",
    item(1, []),
  );
  let program = without_item(start, "m0.ply", "x");
  let ran = fs::on_mem[disk](fs::mem_of([]), ||
    undamaged(|| {
      edit_committed[disk](start);
      let log_end = fact_store::open[disk]("facts").log_end;
      edit_committed[disk](program);
      fact_store::changes_after[disk](fact_store::open[disk]("facts"), log_end)
    }));
  let changes = ran.value.flat_map(|entry: fact_store::LogEntry| entry.changes);
  assert(
    changes.contains({
      definition: key_in("m0.ply", "reader"),
      kind: Changed,
      interface_changed: false,
    }),
    None,
  )
}

test "a comment changes the file's digest and no definition, so it adds no log entry" {
  let start = start_program();
  let program = match start.get("m1.ply") {
    Some(file) -> start.insert("m1.ply", { ..file, comment: 1 }),
    None -> start,
  };
  let ran = fs::on_mem[disk](fs::mem_of([]), ||
    undamaged(|| {
      edit_committed[disk](start);
      let before = fact_store::open[disk]("facts").log_end;
      let result = edit_committed[disk](program);
      let reopened = fact_store::open[disk]("facts");
      (reopened.log_end - before, result.recomputed.len(), fact_store::contents[disk](reopened))
    }));
  assert_eq(ran.value._0, 0);
  assert_eq(ran.value._1, 0);
  assert_eq(ran.value._2, reference(program))
}

fn sized_program(modules: Int) -> Program =
  range(0, modules).fold(Map::new(), |program: Program, i: Int| {
    let path = "module" ++ i.to_string() ++ ".ply";
    let previous = "first" ++ (if i == 0 { 0 } else { i - 1 }).to_string();
    let top = "first" ++ i.to_string();
    with_item(
      with_item(
        with_item(program, path, top, item(i, if i == 0 { [] } else { [previous] })),
        path,
        "second" ++ i.to_string(),
        item(i, [top]),
      ),
      path,
      "third" ++ i.to_string(),
      item(i, ["second" ++ i.to_string()]),
    )
  })

fn store_size(tree: fs::MemFs) -> Int / {abort.raise} =
  match fs::listed_names(fs::mem_list(tree, "facts")) {
    None -> 0,
    Some(names) ->
      names.fold(0, |total: Int, name: String|
        total + (match fs::mem_size(tree, "facts/" ++ name) { Some(size) -> size, None -> 0 })),
  }

type EditCost = { program_bytes: Int, edit_bytes: Int }

fn cost_of_edit(modules: Int) -> EditCost / {abort.raise} = {
  let start = sized_program(modules);
  let first = fs::on_mem[disk](fs::mem_of([]), ||
    undamaged(|| {
      edit_committed[disk](start);
      ()
    }));
  let last_module = "module" ++ (modules - 1).to_string() ++ ".ply";
  let name = "third" ++ (modules - 1).to_string();
  let program = edited_item(start, last_module, name, |entry: Item| { ..entry, body: 1 });
  let edit = fs::on_mem[disk](first.tree, ||
    undamaged(|| {
      edit_committed[disk](program);
      ()
    }));
  {
    program_bytes: store_size(first.tree),
    edit_bytes: store_size(edit.tree) - store_size(first.tree),
  }
}

test "the bytes one edit writes do not grow with the size of the program" {
  let small = cost_of_edit(32);
  let large = cost_of_edit(256);
  assert(large.program_bytes > small.program_bytes * 6, Some(show((small, large))));
  assert(large.edit_bytes * 2 < small.edit_bytes * 3, Some(show((small, large))));
  assert(large.edit_bytes * 16 < large.program_bytes, Some(show((small, large))))
}
