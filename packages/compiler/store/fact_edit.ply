import std.fs (fs)
import std.list
import compiler.store.fact_store
import compiler.store.fact_store (Database, Dependents, Lookups, Symbols, fact_damage)
import compiler.store.facts (Added, Change, Changed, ComparedDefinition, Definition,
                             FileDifferences, Removed, SourceModule, TreeState, compare_definitions,
                             definition_key, differing_files, has_differences, module_key, name_key)
import compiler.store.propagation (Recomputed, propagate, regrouped)

pub type SourceDefinition = { name: String, own_hash: Bytes, mentions: List<String> }

pub type KeyedDefinition = { key: Bytes, definition: Definition }

pub type GroupInput = { members: List<KeyedDefinition>, read: List<KeyedDefinition> }

pub type CheckedDefinition = { key: Bytes, interface: Bytes, check: Bytes }

pub type EditResult = { database: Database, recomputed: List<Recomputed<Bytes>> }

type EditState = {
  database: Database,
  touched: Map<Bytes, Unit>,
  recheck: Map<Bytes, Unit>,
  names: Map<String, Unit>,
  moved: Map<Bytes, Unit>,
}

effect editing {
  read current() -> Database
  write replace(database: Database) -> Unit
}

fn stored_definition<[r]>(
  db: Database,
  key: Bytes,
) -> Definition / {fs.read[r], fact_damage.damaged, abort.raise} =
  match fact_store::definition_of[r](db, key) {
    Some(definition) -> definition,
    None -> fact_damage.damaged("an index names a definition that is not stored"),
  }

fn by_own_hash(key: Bytes, own_hash: Bytes) -> ComparedDefinition =
  { definition: key, own_hash: own_hash, interface: b"" }

fn added_definition(
  state: EditState,
  path: String,
  key: Bytes,
  source: SourceDefinition,
) -> EditState / {abort.raise} =
  {
    ..state,
    database: fact_store::with_definition(
      fact_store::add_member(state.database, Symbols, name_key(source.name), key),
      key,
      {
        path: path,
        name: source.name,
        own_hash: source.own_hash,
        interface: b"",
        check: b"",
        group: key,
        reads: [],
      },
    ),
    recheck: state.recheck.insert(key, ()),
    moved: state.moved.insert(key, ()),
    names: state.names.insert(source.name, ()),
  }

fn removed_definition(
  state: EditState,
  key: Bytes,
  stored: Definition,
) -> EditState / {abort.raise} =
  {
    ..state,
    database: fact_store::without_group(
      fact_store::without_definition(
        stored.reads.fold(
          fact_store::remove_member(state.database, Symbols, name_key(stored.name), key),
          |db: Database, read: Bytes| fact_store::remove_member(db, Dependents, read, key),
        ),
        key,
      ),
      stored.group,
    ),
    names: state.names.insert(stored.name, ()),
  }

fn applied_change<[r]>(
  state: EditState,
  path: String,
  source: Map<Bytes, SourceDefinition>,
  change: Change,
) -> EditState / {fs.read[r], fact_damage.damaged, abort.raise} = {
  let key = change.definition;
  let noted = { ..state, touched: state.touched.insert(key, ()) };
  match ((change.kind, source.get(key))) {
    (Added, Some(found)) -> added_definition(noted, path, key, found),
    (Removed, _) -> removed_definition(noted, key, stored_definition[r](state.database, key)),
    (Changed, Some(found)) -> {
      let stored = stored_definition[r](state.database, key);
      {
        ..noted,
        database: fact_store::with_definition(state.database, key, {
          ..stored,
          own_hash: found.own_hash,
        }),
        recheck: state.recheck.insert(key, ()),
      }
    },
    _ -> panic("a comparison named a definition the source does not hold"),
  }
}

fn updated_lookups(
  db: Database,
  module: Bytes,
  before: List<Bytes>,
  after: List<Bytes>,
) -> Database =
  after.fold(
    before.fold(db, |current: Database, name: Bytes|
      fact_store::remove_member(current, Lookups, name, module)),
    |current: Database, name: Bytes| fact_store::add_member(current, Lookups, name, module),
  )

fn edited_module<[r]>(
  state: EditState,
  path: String,
  source: Option<List<SourceDefinition>>,
) -> EditState / {fs.read[r], fact_damage.damaged, abort.raise} = {
  let module = module_key(path);
  let recorded: SourceModule = match fact_store::module_of[r](state.database, module) {
    Some(found) -> found,
    None -> { path: path, definitions: [], lookups: [] },
  };
  let listed = match source { Some(found) -> found, None -> [] };
  let by_key = listed.fold(
    Map::new(),
    |found: Map<Bytes, SourceDefinition>, definition: SourceDefinition|
      found.insert(definition_key(path, definition.name), definition),
  );
  let changed = compare_definitions(
    recorded.definitions.map(|key: Bytes|
      by_own_hash(key, stored_definition[r](state.database, key).own_hash)),
    by_key.fold([], |after: List<ComparedDefinition>, key: Bytes, definition: SourceDefinition|
      after.push(by_own_hash(key, definition.own_hash))),
  ).fold(state, |sofar: EditState, change: Change| applied_change[r](sofar, path, by_key, change));
  let looked_up = listed.flat_map(|definition: SourceDefinition|
    definition.mentions.map(name_key)).sort(
  ).unique(
  );
  let indexed = updated_lookups(changed.database, module, recorded.lookups, looked_up);
  {
    ..changed,
    database: match source {
      Some(_) ->
        fact_store::with_module(indexed, {
          path: path,
          definitions: by_key.keys(),
          lookups: looked_up,
        }),
      None -> fact_store::without_module(indexed, path),
    },
  }
}

fn with_lookups_of_name<[r] | e>(
  state: EditState,
  name: String,
  definitions_in: (String) -> List<SourceDefinition> / e,
) -> EditState / {fs.read[r], fact_damage.damaged, abort.raise | e} =
  fact_store::members[r](state.database, Lookups, name_key(name)).fold(
    state,
    |sofar: EditState, module: Bytes|
      match fact_store::module_of[r](state.database, module) {
        None -> fact_damage.damaged("the Lookups index names a module that is not stored"),
        Some(found) ->
          definitions_in(found.path).fold(sofar, |current: EditState, d: SourceDefinition|
            if d.mentions.contains(name) {
              { ..current, recheck: current.recheck.insert(definition_key(found.path, d.name), ()) }
            } else { current }),
      },
  )

fn with_resolved_reads<[r] | e>(
  state: EditState,
  path: String,
  key: Bytes,
  source: SourceDefinition,
  resolve: (String, String, List<Bytes>) -> Option<Bytes> / e,
) -> EditState / {fs.read[r], fact_damage.damaged, abort.raise | e} = {
  let db = state.database;
  let reads = source.mentions.fold(Map::new(), |found: Map<Bytes, Unit>, mention: String|
    match resolve(path, mention, fact_store::members[r](db, Symbols, name_key(mention))) {
      Some(read) -> found.insert(read, ()),
      None -> found,
    }).keys(
  );
  let stored = stored_definition[r](db, key);
  if reads == stored.reads { state } else {
    let unlinked = stored.reads.fold(db, |current: Database, read: Bytes|
      fact_store::remove_member(current, Dependents, read, key));
    let linked = reads.fold(unlinked, |current: Database, read: Bytes|
      fact_store::add_member(current, Dependents, read, key));
    {
      ..state,
      database: fact_store::with_definition(linked, key, { ..stored, reads: reads }),
      moved: state.moved.insert(key, ()),
    }
  }
}

fn with_all_reads<[r] | e>(
  state: EditState,
  definitions_in: (String) -> List<SourceDefinition> / e,
  resolve: (String, String, List<Bytes>) -> Option<Bytes> / e,
) -> EditState / {fs.read[r], fact_damage.damaged, abort.raise | e} = {
  let paths = state.recheck.fold(Map::new(), |found: Map<String, Unit>, key: Bytes, _: Unit|
    found.insert(stored_definition[r](state.database, key).path, ()));
  paths.fold(state, |sofar: EditState, path: String, _: Unit|
    definitions_in(path).fold(sofar, |current: EditState, source: SourceDefinition| {
      let key = definition_key(path, source.name);
      if state.recheck.contains(key) { with_resolved_reads[r](current, path, key, source, resolve) }
      else { current }
    }))
}

fn with_groups<[r]>(
  state: EditState,
) -> EditState / {fs.read[r], fact_damage.damaged, abort.raise} =
  if state.moved.len() == 0 { state } else {
    let db = state.database;
    let stale = regrouped(
      state.moved.keys(),
      |key: Bytes| fact_store::members[r](db, Dependents, key),
      |key: Bytes| stored_definition[r](db, key).reads,
    ).filter(|group: List<Bytes>|
      group.any(|key: Bytes|
        fact_store::group_members[r](db, stored_definition[r](db, key).group) != group));
    let cleared = stale.flatten().fold(db, |current: Database, key: Bytes|
      fact_store::without_group(current, stored_definition[r](db, key).group));
    let regrouped_database = stale.fold(cleared, |current: Database, group: List<Bytes>|
      group.fold(
        fact_store::with_group(current, group.get(0), group),
        |rows: Database, key: Bytes| {
          let stored = stored_definition[r](db, key);
          fact_store::with_definition(rows, key, { ..stored, group: group.get(0) })
        },
      ));
    {
      ..state,
      database: regrouped_database,
      recheck: stale.flatten().fold(state.recheck, |found: Map<Bytes, Unit>, key: Bytes|
        found.insert(key, ())),
    }
  }

fn keyed<[r]>(
  db: Database,
  key: Bytes,
) -> KeyedDefinition / {fs.read[r], fact_damage.damaged, abort.raise} =
  { key: key, definition: stored_definition[r](db, key) }

fn rechecked_group<[r] | e>(
  group: List<Bytes>,
  check: (GroupInput) -> List<CheckedDefinition> / e,
) -> List<Bytes> / {editing.current, editing.replace, fs.read[r], fact_damage.damaged, abort.raise | e} = {
  let db = editing.current();
  let members = group.map(|key: Bytes| keyed[r](db, key));
  let inside = group.fold(Map::new(), |found: Map<Bytes, Unit>, key: Bytes| found.insert(key, ()));
  let read = members.flat_map(|member: KeyedDefinition| member.definition.reads).filter(
    |key: Bytes| !inside.contains(key),
  ).sort(
  ).unique(
  ).map(|key: Bytes| keyed[r](db, key));
  let results = check({ members: members, read: read });
  editing.replace(
    results.fold(db, |current: Database, result: CheckedDefinition| {
      let stored = stored_definition[r](db, result.key);
      fact_store::with_definition(current, result.key, {
        ..stored,
        interface: result.interface,
        check: result.check,
      })
    }),
  );
  results.filter(|result: CheckedDefinition|
    stored_definition[r](db, result.key).interface != result.interface).map(
    |result: CheckedDefinition| result.key,
  )
}

fn settled<[r] | e>(
  state: EditState,
  check: (GroupInput) -> List<CheckedDefinition> / e,
) -> EditResult / {fs.read[r], fact_damage.damaged, abort.raise | e} =
  handle {
    let recomputed = propagate(
      state.recheck.keys(),
      |key: Bytes| {
        let db = editing.current();
        fact_store::group_members[r](db, stored_definition[r](db, key).group)
      },
      |key: Bytes| fact_store::members[r](editing.current(), Dependents, key),
      |group: List<Bytes>| rechecked_group[r](group, check),
    );
    { database: editing.current(), recomputed: recomputed }
  } with {
    var database = state.database,
    editing.current() -> database,
    editing.replace(next) -> {
      database = next;
    },
  }

fn logged(key: Bytes, definition: Definition) -> ComparedDefinition / {abort.raise} =
  {
    definition: key,
    own_hash: Bytes::concat_all([definition.own_hash].concat(definition.reads)).blake3(),
    interface: definition.interface,
  }

fn logged_definitions<[r]>(
  db: Database,
  keys: List<Bytes>,
) -> List<ComparedDefinition> / {fs.read[r], fact_damage.damaged, abort.raise} =
  keys.fold([], |found: List<ComparedDefinition>, key: Bytes|
    match fact_store::definition_of[r](db, key) {
      Some(definition) -> found.push(logged(key, definition)),
      None -> found,
    })

fn with_files(
  db: Database,
  tree: TreeState,
  differences: FileDifferences,
) -> Database / {abort.raise} =
  differences.added.concat(differences.changed).fold(
    differences.removed.fold(db, |current: Database, path: String|
      fact_store::without_file(current, path)),
    |current: Database, path: String|
      match tree.get(path) {
        Some(digest) -> fact_store::with_file(current, path, digest),
        None -> current,
      },
  )

pub fn apply_edit<[r] | e>(
  db: Database,
  tree: TreeState,
  definitions_in: (String) -> List<SourceDefinition> / e,
  resolve: (String, String, List<Bytes>) -> Option<Bytes> / e,
  check: (GroupInput) -> List<CheckedDefinition> / e,
) -> EditResult / {fs.read[r], fact_damage.damaged, abort.raise | e} = {
  let differences = differing_files(fact_store::tree_state[r](db), tree);
  if !has_differences(differences) { { database: db, recomputed: [] } } else {
    let start: EditState = {
      database: db,
      touched: Map::new(),
      recheck: Map::new(),
      names: Map::new(),
      moved: Map::new(),
    };
    let present = differences.added.concat(differences.changed).fold(
      start,
      |state: EditState, path: String| edited_module[r](state, path, Some(definitions_in(path))),
    );
    let edited = differences.removed.fold(present, |state: EditState, path: String|
      edited_module[r](state, path, None));
    let reached = edited.names.fold(edited, |state: EditState, name: String, _: Unit|
      with_lookups_of_name[r](state, name, definitions_in));
    let resolved = with_all_reads[r](reached, definitions_in, resolve);
    let grouped = with_groups[r](resolved);
    let result = settled[r](grouped, check);
    let touched = grouped.touched.merge(grouped.moved).keys().concat(
      result.recomputed.flat_map(|r: Recomputed<Bytes>| r.group),
    ).sort(
    ).unique(
    );
    {
      database: fact_store::append_change(
        with_files(result.database, tree, differences),
        compare_definitions(
          logged_definitions[r](db, touched),
          logged_definitions[r](result.database, touched),
        ),
      ),
      recomputed: result.recomputed,
    }
  }
}
