import std.bin
import std.bytes (u64_le)
import std.list
import std.hash (blake3)
import std.gen
import compiler.store.packs

pub effect memo {
  read external(kind: Bytes, at: Bytes) -> Option<Bytes>
  read fetch(query: Bytes, input: Bytes) -> Bytes
  read output_digest(query: Bytes, input: Bytes) -> Bytes
  read stored_output(digest: Bytes) -> Option<Bytes>
  read is_cached(query: Bytes, input: Bytes) -> Bool
  read provide(query: Bytes, input: Bytes, output: Bytes) -> Unit
  read provide_as(by: Bytes, query: Bytes, input: Bytes, output: Bytes) -> Unit
  read provided() -> Option<Bytes>
}

pub type Dependency =
  | ExternalDependency(Bytes, Bytes, Bytes)
  | QueryDependency(Bytes, Bytes, Bytes)

type Execution = { run: Run, reads: List<Dependency>, external_reads: Map<Bytes, Bool> }

pub type Record = {
  query: Bytes,
  input: Bytes,
  reads: List<Dependency>,
  output: Bytes,
  summary: List<Dependency>,
}

derive bin for Dependency
derive bin for Record

pub type Query<| e> = {
  name: Bytes,
  hash: Bytes,
  body: (Bytes) -> Bytes / {memo.read, abort.raise | e},
  persistent: Bool,
  summarized: Bool,
}

pub type Run = {
  resolved: Map<Bytes, Bytes>,
  asked: List<Dependency>,
  open: Map<Bytes, Bool>,
  trail: List<{ query: Bytes, input: Bytes }>,
  took: Map<Bytes, Int>,
  ran: Map<Bytes, Int>,
  inputs: List<{ query: Bytes, input: Bytes }>,
  restored: List<{ query: Bytes, input: Bytes }>,
  provided: Map<Bytes, ProvidedOutput>,
  runs: Map<Bytes, Int>,
  lost: Map<Bytes, Int>,
  judged: Map<Bytes, Bool>,
  checking_reuse: Bool,
  provisional: Map<Bytes, Bytes>,
}

type ProvidedOutput = { output: Bytes, by: Bytes, from: Bytes, nth: Int }

fn new_run() -> Run =
  {
    resolved: Map::new(),
    asked: [],
    open: Map::new(),
    trail: [],
    took: Map::new(),
    ran: Map::new(),
    inputs: [],
    restored: [],
    provided: Map::new(),
    runs: Map::new(),
    lost: Map::new(),
    judged: Map::new(),
    checking_reuse: false,
    provisional: Map::new(),
  }

pub fn driver_dependencies(run: Run) -> List<Dependency> = run.asked

fn dependency_keys<| e>(
  queries: Map<Bytes, Query<| e>>,
  reads: List<Dependency>,
  onto: List<Bytes>,
) -> List<Bytes> =
  reads.fold(onto, |acc: List<Bytes>, r: Dependency|
    match r {
      QueryDependency(name, input, _) -> match queries.get(name) {
        Some(q) -> acc.push(key_of(q, input)),
        None -> acc,
      },
      ExternalDependency(_, _, _) -> acc,
    })

pub fn reachable_keys<| e>(
  queries: Map<Bytes, Query<| e>>,
  wanted: Map<Bytes, Bool>,
  run: Run,
) -> List<Bytes> / {memo_store.read, abort.raise} =
  iterate(
    { seen: Map::new(), work: dependency_keys(queries, run.asked, []), keys: [] },
    100000000,
    |x: { seen: Map<Bytes, Bool>, work: List<Bytes>, keys: List<Bytes> }|
      match x.work {
        [] -> Stop(x.keys),
        [key, ..rest] -> if x.seen.contains(key) { Continue({ ..x, work: rest }) } else {
          let seen = x.seen.insert(key, true);
          match memo_store.record(key) {
            None -> Continue({ ..x, seen: seen, work: rest }),
            Some(rec) ->
              Continue({
                seen: seen,
                work: dependency_keys(queries, rec.reads, rest),
                keys: if wanted.contains(rec.query) { x.keys.push(key) } else { x.keys },
              }),
          }
        },
      },
  )

pub fn missing_count(run: Run) -> Int = run.lost.fold(0, |n: Int, _: Bytes, k: Int| n + k)

pub type QueryStats = { query: Bytes, took: Int, ran: Int, lost: Int }

derive bin for QueryStats

fn count_of(m: Map<Bytes, Int>, name: Bytes) -> Int = match m.get(name) { Some(n) -> n, None -> 0 }

fn incremented(m: Map<Bytes, Int>, name: Bytes) -> Map<Bytes, Int> =
  m.insert(name, count_of(m, name) + 1)

pub fn query_stats(run: Run) -> List<QueryStats> =
  run.ran.fold(run.took, |acc: Map<Bytes, Int>, k: Bytes, _: Int|
    if acc.contains(k) { acc } else { acc.insert(k, 0) }).keys(
  ).map(|name: Bytes|
    {
      query: name,
      took: count_of(run.took, name),
      ran: count_of(run.ran, name),
      lost: count_of(run.lost, name),
    })

pub fn merged_query_stats(a: List<QueryStats>, b: List<QueryStats>) -> List<QueryStats> =
  b.fold(
    a.fold(Map::new(), |acc: Map<Bytes, QueryStats>, t: QueryStats| acc.insert(t.query, t)),
    |acc: Map<Bytes, QueryStats>, t: QueryStats|
      acc.insert(t.query, match acc.get(t.query) {
        Some(u) ->
          { query: t.query, took: u.took + t.took, ran: u.ran + t.ran, lost: u.lost + t.lost },
        None -> t,
      }),
  ).values(
  )

pub fn restored_for(run: Run, name: Bytes) -> List<Bytes> =
  run.restored.filter(|r: { query: Bytes, input: Bytes }| r.query == name).map(
    |r: { query: Bytes, input: Bytes }| r.input,
  )

pub fn executed_for(run: Run, name: Bytes) -> List<Bytes> =
  run.inputs.filter(|r: { query: Bytes, input: Bytes }| r.query == name).map(
    |r: { query: Bytes, input: Bytes }| r.input,
  )

pub fn executed_count(run: Run) -> Int = run.ran.fold(0, |n: Int, _: Bytes, k: Int| n + k)

pub fn digest_of(query_output: Option<Bytes>) -> Bytes =
  match query_output { Some(b) -> b"=".concat(blake3(b)), None -> b"-" }

pub fn key_of<| e>(q: Query<| e>, input: Bytes) -> Bytes =
  blake3(Bytes::concat_all([b"ply.memo.key\x00", q.hash, b"\x00", blake3(input)]))

fn length_prefixed(b: Bytes) -> Bytes = u64_le(b.len()).concat(b)

pub fn location_id(kind: Bytes, at: Bytes) -> Bytes =
  blake3(Bytes::concat_all([b"ply.memo.place\x00", length_prefixed(kind), at]))

fn query_kind() -> Bytes = b"query"

pub fn pack_kind() -> Bytes = b"pack"

pub fn pack_place(index: Option<packs::Index>, world: Bytes) -> Option<Bytes> =
  match index {
    Some(i) -> Some(blake3(Bytes::concat_all([length_prefixed(i.id), world]))),
    None -> None,
  }

pub fn queries_id<| e>(queries: Map<Bytes, Query<| e>>) -> Bytes =
  blake3(
    Bytes::concat_all(
      queries.fold([b"ply.memo.queries\x00"], |acc: List<Bytes>, name: Bytes, q: Query<| e>|
        acc.push(length_prefixed(name)).push(length_prefixed(q.hash))),
    ),
  )

pub fn previous_key(key: Bytes) -> Bytes = blake3(b"earlier\x00".concat(key))

pub fn current_records(held: MemoryStore) -> Map<Bytes, Record> = {
  let earlier = held.records.fold(Map::new(), |acc: Map<Bytes, Bool>, k: Bytes, _: Record|
    acc.insert(previous_key(k), true));
  held.records.fold(Map::new(), |acc: Map<Bytes, Record>, k: Bytes, r: Record|
    if earlier.contains(k) { acc } else { acc.insert(k, r) })
}

fn keep_previous(key: Bytes, next: Record) -> Unit / {memo_store.read, memo_store.write} =
  match memo_store.record(key) {
    Some(old) -> if old.output != next.output || old.reads != next.reads {
      memo_store.store_record(previous_key(key), old)
    },
    None -> (),
  }

fn record_format() -> Bytes = b"\x06"

pub fn max_inline_size() -> Int = 2048

pub fn inline_output(output: Bytes) -> Option<Bytes> =
  if output.len() <= max_inline_size() { Some(output) } else { None }

pub fn record_bytes(r: Record, inline: Option<Bytes>) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    record_format(),
    length_prefixed(r.output),
    match inline { Some(o) -> b"\x01".concat(length_prefixed(o)), None -> b"\x00" },
    length_prefixed(r.query),
    length_prefixed(r.input),
    length_prefixed(bin::encode(r.reads, bin::list_bin(dependency_bin()))),
    bin::encode(r.summary, bin::list_bin(dependency_bin())),
  ])

fn length_prefixed_at(b: Bytes, at: Int) -> Option<{ value: Bytes, next: Int }> / {abort.raise} =
  match b.u64_at(at) {
    None -> None,
    Some(n) -> if n < 0 || at + 8 + n > b.len() { None }
    else { Some({ value: b.slice(at + 8, at + 8 + n), next: at + 8 + n }) },
  }

fn has_record_format(b: Bytes) -> Bool = b.len() >= 9 && b.slice(0, 1) == record_format()

pub fn output_digest_of(b: Bytes) -> Option<Bytes> / {abort.raise} =
  if !has_record_format(b) { None }
  else { match length_prefixed_at(b, 1) { Some(o) -> Some(o.value), None -> None } }

fn hashes_of<| e>(queries: Map<Bytes, Query<| e>>) -> List<Bytes> =
  queries.fold([], |acc: List<Bytes>, _: Bytes, q: Query<| e>| acc.push(q.hash))

pub fn inline_output_of(b: Bytes) -> Option<Bytes> / {abort.raise} =
  if !has_record_format(b) { None } else {
    match length_prefixed_at(b, 1) {
      None -> None,
      Some(o) -> if o.next >= b.len() || b.at(o.next) != 1 { None }
      else { match length_prefixed_at(b, o.next + 1) { Some(i) -> Some(i.value), None -> None } },
    }
  }

fn after_embedded_output(b: Bytes, at: Int) -> Option<Int> / {abort.raise} =
  if at >= b.len() { None }
  else if b.at(at) == 0 { Some(at + 1) }
  else if b.at(at) != 1 { None }
  else { match length_prefixed_at(b, at + 1) { Some(i) -> Some(i.next), None -> None } }

pub fn record_head_size() -> Int = 4096

pub fn record_from(b: Bytes) -> Option<Record> / {abort.raise} =
  if !has_record_format(b) { None } else {
    match length_prefixed_at(b, 1) {
      None -> None,
      Some(o) -> match match after_embedded_output(b, o.next) {
          Some(at) -> length_prefixed_at(b, at),
          None -> None,
        } {
        None -> None,
        Some(q) -> match length_prefixed_at(b, q.next) {
          None -> None,
          Some(i) -> match length_prefixed_at(b, i.next) {
            None -> None,
            Some(rs) -> match ((
                bin::decode(rs.value, bin::list_bin(dependency_bin())),
                bin::decode(b.slice(rs.next, b.len()), bin::list_bin(dependency_bin())),
              )) {
              (Ok(reads), Ok(summary)) ->
                Some({
                  query: q.value,
                  input: i.value,
                  reads: reads,
                  output: o.value,
                  summary: summary,
                }),
              _ -> None,
            },
          },
        },
      },
    }
  }

pub effect memo_store {
  read output_digest(key: Bytes) -> Option<Bytes>
  read record(key: Bytes) -> Option<Record>
  read output(digest: Bytes) -> Option<Bytes>
  write put(key: Bytes, r: Record, output: Bytes, lasting: Bool) -> Unit
  write store_record(key: Bytes, r: Record) -> Unit
  read external(kind: Bytes, at: Bytes) -> Option<Bytes>
  read external_digest(kind: Bytes, at: Bytes) -> Bytes
  read looked() -> List<Dependency>
  read has_trusted_record(key: Bytes) -> Bool
  read pack_record(key: Bytes) -> Option<Record>
  write running(id: Bytes, queries: List<Bytes>) -> Unit
}

pub type QueryResult = { run: Run, output: Bytes }

fn query_of<| e>(queries: Map<Bytes, Query<| e>>, name: Bytes) -> Query<| e> / {abort.raise} =
  match queries.get(name) {
    Some(q) -> q,
    None -> panic("no query is named `" ++ String::of_bytes_lossy(name) ++ "`"),
  }

fn too_deep() -> Bytes = b"queries ask one another deeper than any program's queries go"

fn external_at<| e>(
  queries: Map<Bytes, Query<| e>>,
  kind: Bytes,
  at: Bytes,
) -> Option<Bytes> / {memo_store.read} =
  if kind == query_kind() { match queries.get(at) { Some(q) -> Some(q.hash), None -> None } }
  else { memo_store.external(kind, at) }

fn external_digest_at<| e>(
  queries: Map<Bytes, Query<| e>>,
  kind: Bytes,
  at: Bytes,
) -> Bytes / {memo_store.read} =
  if kind == query_kind() { digest_of(external_at(queries, kind, at)) }
  else { memo_store.external_digest(kind, at) }

pub fn start_run<| e>(queries: Map<Bytes, Query<| e>>) -> Run / {memo_store.write} = {
  memo_store.running(queries_id(queries), hashes_of(queries));
  new_run()
}

pub fn query_output<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  name: Bytes,
  input: Bytes,
) -> QueryResult / {memo_store.read, memo_store.write, abort.raise | e} = {
  let q = query_of(queries, name);
  let a = fetch_output(queries, run, q, key_of(q, input), input, 100000);
  {
    run: { ..a.run, asked: a.run.asked.push(QueryDependency(name, input, a.head)) },
    output: a.output,
  }
}

fn fetch_output<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  left: Int,
) -> { run: Run, output: Bytes, head: Bytes } / {memo_store.read, memo_store.write, abort.raise | e} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep())) } else {
    let s = verify_key(queries, run, q, key, input, left - 1);
    match memo_store.output(s.head) {
      Some(o) -> { run: s.run_index, output: o, head: s.head },
      None -> if s.run_index.open.contains(key) { abort.raise(reuse_cycle_message()) } else {
        let e = execute(queries, s.run_index, q, key, input, left - 1);
        if e.head != s.head {
          panic(
            "the query `" ++ String::of_bytes_lossy(q.name)
              ++ "` returned a different result when run again to replace a lost one: its body reads something it does not record",
          )
        };
        {
          run: {
            ..e.run_index,
            lost: if q.persistent { incremented(e.run_index.lost, q.name) }
            else { e.run_index.lost },
          },
          output: match memo_store.output(e.head) {
            Some(o) -> o,
            None -> panic("a store does not contain a result it was just handed to cache"),
          },
          head: e.head,
        }
      },
    }
  }

fn reuse(run: Run, name: Bytes, output: Bytes) -> { run_index: Run, head: Bytes } =
  { run_index: { ..run, took: incremented(run.took, name) }, head: output }

fn verify_key<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  left: Int,
) -> { run_index: Run, head: Bytes } / {memo_store.read, memo_store.write, abort.raise | e} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep())) } else {
    match run.resolved.get(key) {
      Some(h) -> { run_index: run, head: h },
      None -> {
        let step = { query: q.name, input: input };
        if run.open.contains(key) {
          if !run.checking_reuse { report_cycle(run, step) } else {
            match memo_store.output_digest(key) {
              Some(h) ->
                { run_index: { ..run, provisional: run.provisional.insert(key, h) }, head: h },
              None -> abort.raise(reuse_cycle_message()),
            }
          }
        } else {
          let opened = { ..run, open: run.open.insert(key, true), trail: run.trail.push(step) };
          let done = checked(queries, opened, q, key, input, left - 1);
          let early = match done.run_index.provisional.get(key) {
            Some(h) -> h != done.head,
            None -> false,
          };
          {
            run_index: {
              ..done.run_index,
              resolved: (if early { run.resolved } else { done.run_index.resolved }).insert(
                key,
                done.head,
              ),
              provided: if early { run.provided } else { done.run_index.provided },
              open: done.run_index.open.remove(key),
              trail: run.trail,
              provisional: done.run_index.provisional.remove(key),
            },
            head: done.head,
          }
        }
      },
    }
  }

fn checked<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  left: Int,
) -> { run_index: Run, head: Bytes } / {memo_store.read, memo_store.write, abort.raise | e} =
  match memo_store.output_digest(key) {
    None -> execute(queries, run, q, key, input, left),
    Some(out) -> if memo_store.has_trusted_record(key) { reuse(run, q.name, out) } else {
      match memo_store.record(key) {
        None -> execute(queries, run, q, key, input, left),
        Some(r) -> {
          let s = if r.summary.len() == 0 { { run: run, ok: false } }
          else { dependencies_unchanged(queries, run, r.summary, left) };
          if s.ok { reuse(s.run, q.name, r.output) } else {
            let d = dependencies_unchanged(queries, s.run, r.reads, left);
            if d.ok {
              if q.summarized { update_summary(queries, key, r) };
              reuse(d.run, q.name, r.output)
            } else { restore_or_run(queries, d.run, q, key, input, left) }
          }
        },
      }
    },
  }

fn restore_or_run<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  left: Int,
) -> { run_index: Run, head: Bytes } / {memo_store.read, memo_store.write, abort.raise | e} = {
  let earlier = record_if_unchanged(queries, run, memo_store.record(previous_key(key)), left);
  let cycle_to_switched = match earlier.record {
    Some(_) -> earlier,
    None -> record_if_unchanged(queries, earlier.run, memo_store.pack_record(key), left),
  };
  match cycle_to_switched.record {
    None -> execute(queries, cycle_to_switched.run, q, key, input, left),
    Some(e) -> {
      match memo_store.record(key) {
        Some(r) -> memo_store.store_record(previous_key(key), r),
        None -> (),
      };
      memo_store.store_record(key, e);
      reuse(
        {
          ..cycle_to_switched.run,
          restored: cycle_to_switched.run.restored.push({ query: q.name, input: input }),
        },
        q.name,
        e.output,
      )
    },
  }
}

fn record_if_unchanged<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  record: Option<Record>,
  left: Int,
) -> { run: Run, record: Option<Record> } / {memo_store.read, memo_store.write, abort.raise | e} =
  match record {
    None -> { run: run, record: None },
    Some(e) -> {
      let t = dependencies_unchanged(queries, run, e.reads, left);
      {
        run: t.run,
        record: if t.ok && memo_store.output(e.output) != None { Some(e) } else { None },
      }
    },
  }

fn reuse_cycle_message() -> String = "a judgment reached a record being computed"

fn report_cycle(
  run: Run,
  step: { query: Bytes, input: Bytes },
) -> { run_index: Run, head: Bytes } / {abort.raise} =
  panic(
    "the query `" ++ String::of_bytes_lossy(step.query) ++ "` asks for its own result, through"
      ++ run.trail.push(step).fold("", |acc: String, s: { query: Bytes, input: Bytes }|
        acc ++ "\n  " ++ String::of_bytes_lossy(s.query) ++ " "
          ++ String::of_bytes_lossy(s.input.slice(0, min(s.input.len(), 120)))),
  )

fn dependencies_unchanged<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  reads: List<Dependency>,
  left: Int,
) -> { run: Run, ok: Bool } / {memo_store.read, memo_store.write, abort.raise | e} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep())) } else {
    reads.fold({ run: run, ok: true }, |acc: { run: Run, ok: Bool }, r: Dependency|
      if !acc.ok { acc } else {
        match r {
          ExternalDependency(kind, at, digest) ->
            { run: acc.run, ok: external_digest_at(queries, kind, at) == digest },
          QueryDependency(name, input, digest) -> match queries.get(name) {
            None -> { run: acc.run, ok: false },
            Some(aq) -> {
              let a = verify_key(queries, acc.run, aq, key_of(aq, input), input, left - 1);
              { run: a.run_index, ok: a.head == digest }
            },
          },
        }
      })
  }

type Summing = { seen: Map<Bytes, Bool>, summary: List<Dependency>, whole: Bool }

fn query_seen(name: Bytes, input: Bytes) -> Bytes =
  Bytes::concat_all([b"asked\x00", length_prefixed(name), input])

fn place_seen(kind: Bytes, at: Bytes) -> Bytes =
  Bytes::concat_all([b"place\x00", length_prefixed(kind), at])

fn add_to_summary(x: Summing, id: Bytes, r: Dependency) -> Summing =
  if x.seen.contains(id) { x }
  else { { ..x, seen: x.seen.insert(id, true), summary: x.summary.push(r) } }

fn summed_through<| e>(
  queries: Map<Bytes, Query<| e>>,
  x: Summing,
  reads: List<Dependency>,
  left: Int,
) -> Summing / {memo_store.read, abort.raise} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep())) } else {
    reads.fold(x, |acc: Summing, r: Dependency|
      if !acc.whole { acc } else {
        match r {
          ExternalDependency(kind, at, _) -> add_to_summary(acc, place_seen(kind, at), r),
          QueryDependency(name, input, _) -> match queries.get(name) {
            None -> { ..acc, whole: false },
            Some(aq) -> if aq.summarized || memo_store.has_trusted_record(key_of(aq, input)) {
              add_to_summary(acc, query_seen(name, input), r)
            } else {
              let id = query_seen(name, input);
              if acc.seen.contains(id) { acc } else {
                let defined = add_to_summary(
                  { ..acc, seen: acc.seen.insert(id, true) },
                  place_seen(query_kind(), name),
                  ExternalDependency(query_kind(), name, digest_of(Some(aq.hash))),
                );
                match memo_store.record(key_of(aq, input)) {
                  None -> { ..defined, whole: false },
                  Some(below) -> summed_through(queries, defined, below.reads, left - 1),
                }
              }
            },
          },
        }
      })
  }

fn summary_of<| e>(
  queries: Map<Bytes, Query<| e>>,
  reads: List<Dependency>,
) -> Option<List<Dependency>> / {memo_store.read, abort.raise} = {
  let made = summed_through(queries, { seen: Map::new(), summary: [], whole: true }, reads, 100000);
  if made.whole { Some(made.summary) } else { None }
}

fn update_summary<| e>(
  queries: Map<Bytes, Query<| e>>,
  key: Bytes,
  r: Record,
) -> Unit / {memo_store.read, memo_store.write, abort.raise} =
  match summary_of(queries, r.reads) {
    Some(s) -> if s != r.summary { memo_store.store_record(key, { ..r, summary: s }) },
    None -> (),
  }

fn would_reuse<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  left: Int,
) -> { run: Run, ok: Bool } / {memo_store.read, memo_store.write, abort.raise | e} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep())) }
  else if run.resolved.contains(key) { { run: run, ok: true } }
  else if run.open.contains(key) || memo_store.output_digest(key) == None {
    { run: run, ok: false }
  } else if memo_store.has_trusted_record(key) { { run: run, ok: true } } else {
    match run.judged.get(key) {
      Some(ok) -> { run: run, ok: ok },
      None -> {
        let current_records = match memo_store.record(key) {
          None -> { run: run, ok: false },
          Some(rec) -> {
            let s = if rec.summary.len() == 0 { { run: run, ok: false } }
            else { would_reuse_reads(queries, run, q.name, rec.summary, left - 1) };
            let d = if s.ok { s }
            else { would_reuse_reads(queries, s.run, q.name, rec.reads, left - 1) };
            { run: d.run, ok: d.ok && (q.persistent || memo_store.output(rec.output) != None) }
          },
        };
        let j = if current_records.ok { current_records } else {
          let earlier = would_reuse_record(
            queries,
            current_records.run,
            q.name,
            memo_store.record(previous_key(key)),
            left - 1,
          );
          if earlier.ok { earlier } else {
            would_reuse_record(queries, earlier.run, q.name, memo_store.pack_record(key), left - 1)
          }
        };
        { run: { ..j.run, judged: j.run.judged.insert(key, j.ok) }, ok: j.ok }
      },
    }
  }

fn would_reuse_record<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  judged: Bytes,
  record: Option<Record>,
  left: Int,
) -> { run: Run, ok: Bool } / {memo_store.read, memo_store.write, abort.raise | e} =
  match record {
    None -> { run: run, ok: false },
    Some(e) -> {
      let t = would_reuse_reads(queries, run, judged, e.reads, left);
      { run: t.run, ok: t.ok && memo_store.output(e.output) != None }
    },
  }

fn would_reuse_reads<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  judged: Bytes,
  reads: List<Dependency>,
  left: Int,
) -> { run: Run, ok: Bool } / {memo_store.read, memo_store.write, abort.raise | e} =
  reads.fold({ run: run, ok: true }, |acc: { run: Run, ok: Bool }, r: Dependency|
    if !acc.ok { acc } else {
      match r {
        ExternalDependency(kind, at, digest) ->
          { run: acc.run, ok: external_digest_at(queries, kind, at) == digest },
        QueryDependency(name, input, digest) -> match queries.get(name) {
          None -> { run: acc.run, ok: false },
          Some(q) -> {
            let asked = key_of(q, input);
            let offered = match acc.run.provided.get(asked) {
              Some(o) -> if provided_valid(acc.run, o) { Some(digest_of(Some(o.output))) }
              else { None },
              None -> None,
            };
            match acc.run.resolved.get(asked) {
              Some(h) -> { run: acc.run, ok: h == digest },
              None -> if acc.run.open.contains(asked) {
                { run: acc.run, ok: memo_store.output_digest(asked) == Some(digest) }
              } else {
                match offered {
                  Some(d) -> { run: acc.run, ok: d == digest },
                  None -> if name == judged {
                    let w = would_reuse(queries, acc.run, q, asked, left);
                    { run: w.run, ok: w.ok && memo_store.output_digest(asked) == Some(digest) }
                  } else {
                    let a = verify_key(queries, acc.run, q, asked, input, left);
                    { run: a.run_index, ok: a.head == digest }
                  },
                }
              },
            }
          },
        },
      }
    })

fn provided_valid(run: Run, o: ProvidedOutput) -> Bool = run.runs.get(o.from) == Some(o.nth)

fn execute<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  left: Int,
) -> { run_index: Run, head: Bytes } / {memo_store.read, memo_store.write, abort.raise | e} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep())) } else {
    let begun: Execution = {
      run: {
        ..run,
        ran: incremented(run.ran, q.name),
        inputs: run.inputs.push({ query: q.name, input: input }),
        runs: incremented(run.runs, key),
      },
      reads: [],
      external_reads: Map::new(),
    };
    let world = |s: Execution, kind: Bytes, at: Bytes| {
      let found = external_at(queries, kind, at);
      let d = external_digest_at(queries, kind, at);
      let seen = location_id(kind, at).concat(d);
      {
        st: if s.external_reads.contains(seen) { s } else {
          {
            ..s,
            reads: s.reads.push(ExternalDependency(kind, at, d)),
            external_reads: s.external_reads.insert(seen, true),
          }
        },
        found: found,
      }
    };
    let asking = |s: Execution, name: Bytes, asked: Bytes, whole: Bool| {
      let aq = query_of(queries, name);
      let akey = key_of(aq, asked);
      let a = if whole { fetch_output(queries, s.run, aq, akey, asked, left - 1) } else {
        let h = verify_key(queries, s.run, aq, akey, asked, left - 1);
        { run: h.run_index, output: b"", head: h.head }
      };
      {
        st: { ..s, run: a.run, reads: s.reads.push(QueryDependency(name, asked, a.head)) },
        asked: a,
      }
    };
    let provide_taken = |s: Execution, by: Bytes, name: Bytes, asked: Bytes, output: Bytes|
      {
        ..s,
        run: {
          ..s.run,
          provided: s.run.provided.insert(key_of(query_of(queries, name), asked), {
            output: output,
            by: by,
            from: key,
            nth: match s.run.runs.get(key) { Some(n) -> n, None -> 0 },
          }),
        },
      };
    let ran = handle {
      (q.body)(input)
    } with {
      var st = begun,
      memo.external(kind, at) -> {
        let w = world(st, kind, at);
        st = w.st;
        w.found
      },
      memo.fetch(name, asked) -> {
        let a = asking(st, name, asked, true);
        st = a.st;
        a.asked.output
      },
      memo.output_digest(name, asked) -> {
        let a = asking(st, name, asked, false);
        st = a.st;
        a.asked.head
      },
      memo.stored_output(digest) -> memo_store.output(digest),
      memo.is_cached(name, asked) -> {
        let jq = query_of(queries, name);
        let k = key_of(jq, asked);
        let was = st.run;
        let judged = handle {
          Some(would_reuse(queries, { ..was, checking_reuse: true }, jq, k, left - 1))
        } with {
          abort.raise(_) -> None,
        };
        match judged {
          None -> match was.provided.get(k) { Some(o) -> provided_valid(was, o), None -> false },
          Some(w) -> {
            st = { ..st, run: { ..w.run, checking_reuse: was.checking_reuse } };
            w.ok
              || (match w.run.provided.get(k) {
                Some(o) -> provided_valid(w.run, o),
                None -> false,
              })
          },
        }
      },
      memo.provide(name, asked, output) -> {
        st = provide_taken(st, q.name, name, asked, output);
      },
      memo.provide_as(by, name, asked, output) -> {
        st = provide_taken(st, query_of(queries, by).name, name, asked, output);
      },
      memo.provided() -> match st.run.provided.get(key) {
        None -> None,
        Some(o) -> {
          let s = st;
          st = { ..s, run: { ..s.run, provided: s.run.provided.remove(key) } };
          if provided_valid(s.run, o) {
            st = world(st, query_kind(), o.by).st;
            Some(o.output)
          } else { None }
        },
      },
      return output -> { output: output, st: st },
    };
    let s = ran.st;
    let d = digest_of(Some(ran.output));
    let summary = if !q.summarized { [] }
    else { match summary_of(queries, s.reads) { Some(made) -> made, None -> [] } };
    let rec = { query: q.hash, input: input, reads: s.reads, output: d, summary: summary };
    if q.persistent { keep_previous(key, rec) };
    memo_store.put(key, rec, ran.output, q.persistent);
    { run_index: s.run, head: d }
  }

pub fn cached_output<| e>(
  queries: Map<Bytes, Query<| e>>,
  key: Bytes,
) -> Option<Bytes> / {memo_store.read} =
  match memo_store.record(key) {
    None -> None,
    Some(r) -> if r.summary.len() > 0
        && r.summary.fold(true, |ok: Bool, s: Dependency|
          ok
            && (match s {
              ExternalDependency(kind, at, d) -> external_digest_at(queries, kind, at) == d,
              QueryDependency(_, _, _) -> false,
            })) { memo_store.output(r.output) }
    else { None },
  }

pub fn record_output<| e>(
  queries: Map<Bytes, Query<| e>>,
  key: Bytes,
  hash: Bytes,
  reads: List<Dependency>,
  looked: List<Dependency>,
  output: Bytes,
) -> Unit / {memo_store.read, memo_store.write} = {
  memo_store.running(queries_id(queries), hashes_of(queries));
  let defined = queries.fold(looked, |acc: List<Dependency>, name: Bytes, q: Query<| e>|
    acc.push(ExternalDependency(query_kind(), name, digest_of(Some(q.hash)))));
  let rec = {
    query: hash,
    input: b"",
    reads: reads,
    output: digest_of(Some(output)),
    summary: defined,
  };
  keep_previous(key, rec);
  memo_store.put(key, rec, output, true)
}

pub type ExternalRead = { kind: Bytes, at: Bytes, value: Option<Bytes>, digest: Bytes }

type MemoryRunState = {
  looked: Map<Bytes, ExternalRead>,
  pack: packs::PackReader,
  trusted: Bool,
  packed: Map<Bytes, Option<Record>>,
}

pub type MemoryStore = { records: Map<Bytes, Record>, outputs: Map<Bytes, Bytes> }

pub fn empty_memory_store() -> MemoryStore = { records: Map::new(), outputs: Map::new() }

pub fn with_memory_store<a | e>(
  initial: MemoryStore,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_store.read, memo_store.write, abort.raise},
) -> { store: MemoryStore, value: a } / {abort.raise | e} = {
  let packed_at = |r: MemoryRunState, inl: Map<Bytes, Bytes>, key: Bytes|
    match r.packed.get(key) {
      Some(rec) -> { running: r, inlined: inl, rec: rec },
      None -> {
        let found = packs::record(r.pack, read, key);
        let got: { inlined: Map<Bytes, Bytes>, rec: Option<Record> } = match found.bytes {
          None -> { inlined: inl, rec: None },
          Some(b) -> match record_from(b) {
            None -> { inlined: inl, rec: None },
            Some(rec) ->
              {
                inlined: match inline_output_of(b) {
                  Some(o) -> inl.insert(rec.output, o),
                  None -> inl,
                },
                rec: Some(rec),
              },
          },
        };
        {
          running: { ..r, pack: found.reading, packed: r.packed.insert(key, got.rec) },
          inlined: got.inlined,
          rec: got.rec,
        }
      },
    };
  let held_or_packed = |h: MemoryStore, r: MemoryRunState, inl: Map<Bytes, Bytes>, key: Bytes|
    if r.trusted {
      let p = packed_at(r, inl, key);
      match p.rec {
        Some(_) -> p,
        None -> { running: p.running, inlined: p.inlined, rec: h.records.get(key) },
      }
    } else {
      match h.records.get(key) {
        Some(rec) -> { running: r, inlined: inl, rec: Some(rec) },
        None -> packed_at(r, inl, key),
      }
    };
  let looked = |r: MemoryRunState, kind: Bytes, at: Bytes| {
    let id = location_id(kind, at);
    match r.looked.get(id) {
      Some(x) -> { running: r, looked: x },
      None -> {
        let value = if kind == pack_kind() { pack_place(r.pack.index, world) }
        else { look(kind, at) };
        let x = { kind: kind, at: at, value: value, digest: digest_of(value) };
        { running: { ..r, looked: r.looked.insert(id, x) }, looked: x }
      },
    }
  };
  handle {
    work()
  } with {
    var store = initial,
    var inlined: Map<Bytes, Bytes> = Map::new(),
    var transient: Map<Bytes, Bytes> = Map::new(),
    var running: MemoryRunState = {
      looked: Map::new(),
      pack: packs::open_reader(read),
      trusted: false,
      packed: Map::new(),
    },
    memo_store.output_digest(key) -> {
      let p = held_or_packed(store, running, inlined, key);
      running = p.running;
      inlined = p.inlined;
      match p.rec { Some(r) -> Some(r.output), None -> None }
    },
    memo_store.record(key) -> {
      let p = held_or_packed(store, running, inlined, key);
      running = p.running;
      inlined = p.inlined;
      p.rec
    },
    memo_store.output(digest) -> match store.outputs.get(digest) {
      Some(o) -> Some(o),
      None -> match inlined.get(digest) {
        Some(o) -> Some(o),
        None -> match transient.get(digest) {
          Some(o) -> Some(o),
          None -> {
            let found = packs::output(running.pack, read, digest);
            running = { ..running, pack: found.reading };
            found.bytes
          },
        },
      },
    },
    memo_store.put(key, rec, output, lasting) -> {
      let persisted = lasting || inline_output(output) != None;
      if !persisted {
        transient = transient.insert(rec.output, output);
      };
      store = {
        records: store.records.insert(key, rec),
        outputs: if persisted { store.outputs.insert(rec.output, output) } else { store.outputs },
      };
    },
    memo_store.store_record(key, rec) -> {
      store = {
        records: store.records.insert(key, rec),
        outputs: match inlined.get(rec.output) {
          Some(o) -> store.outputs.insert(rec.output, o),
          None -> store.outputs,
        },
      };
    },
    memo_store.external(kind, at) -> {
      let l = looked(running, kind, at);
      running = l.running;
      l.looked.value
    },
    memo_store.external_digest(kind, at) -> {
      let l = looked(running, kind, at);
      running = l.running;
      l.looked.digest
    },
    memo_store.looked() ->
      running.looked.values().map(|x: ExternalRead| ExternalDependency(x.kind, x.at, x.digest)),
    memo_store.pack_record(key) -> if !store.records.contains(key) { None } else {
      let p = packed_at(running, inlined, key);
      running = p.running;
      inlined = p.inlined;
      p.rec
    },
    memo_store.has_trusted_record(key) -> if !running.trusted { false } else {
      let p = packed_at(running, inlined, key);
      running = p.running;
      inlined = p.inlined;
      p.rec != None
    },
    memo_store.running(id, _) -> {
      running = {
        ..running,
        trusted: match running.pack.index {
          Some(i) -> packs::is_trusted(i, id, world),
          None -> false,
        },
      };
      if running.pack.index != None {
        let l = looked(running, pack_kind(), b"");
        running = l.running;
      }
    },
    return value -> { store: store, value: value },
  }
}

pub fn with_temporary_store<a | e>(
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_store.read, memo_store.write, abort.raise},
) -> a / {abort.raise | e} = with_memory_store(empty_memory_store(), read, world, look, work).value

pub fn pack_memory_store<| e>(
  store: MemoryStore,
  queries: Map<Bytes, Query<| e>>,
  files: Bytes,
) -> packs::PackFiles / {abort.raise} = {
  let records = store.records.fold(
    { writing: packs::new_writer(), placed: Map::new(), returned: Map::new() },
    |acc: { writing: packs::PackWriter, placed: Map<Bytes, packs::Range>, returned: Map<Bytes, Bytes> }, k: Bytes, r: Record| {
      let inline = match store.outputs.get(r.output) { Some(o) -> inline_output(o), None -> None };
      let f = packs::append_frame(acc.writing, record_bytes(r, inline), packs::uncompressed);
      {
        writing: f.writing,
        placed: acc.placed.insert(k, f.at),
        returned: acc.returned.insert(k, r.output),
      }
    },
  );
  let results = store.records.fold(
    { writing: records.writing, placed: Map::new() },
    |acc: { writing: packs::PackWriter, placed: Map<Bytes, packs::Range> }, _: Bytes, r: Record|
      match ((store.outputs.get(r.output), packs::output_key(r.output))) {
        (Some(o), Some(name)) -> if inline_output(o) != None || acc.placed.contains(name) { acc }
        else {
          let f = packs::append_frame(acc.writing, o, packs::uncompressed);
          { writing: f.writing, placed: acc.placed.insert(name, f.at) }
        },
        _ -> acc,
      },
  );
  packs::finish(
    results.writing,
    records.placed,
    results.placed,
    records.returned,
    packs::uncompressed,
    queries_id(queries),
    files,
  )
}

type TestEnvironment = { files: Map<Bytes, Bytes>, store: MemoryStore, read: Int }

fn test_world(files: List<{ at: Bytes, text: Bytes }>) -> TestEnvironment =
  {
    files: files.fold(Map::new(), |acc: Map<Bytes, Bytes>, f: { at: Bytes, text: Bytes }|
      acc.insert(f.at, f.text)),
    store: empty_memory_store(),
    read: 0,
  }

pub fn query(name: Bytes, hash: Bytes, body: keep (Bytes) -> Bytes / {memo.read}) -> Query<| {}> =
  { name: name, hash: hash, body: body, persistent: true, summarized: false }

fn length_of(input: Bytes) -> Bytes / {memo.read} =
  match memo.external(b"file", input) {
    Some(text) -> Bytes::of_string(text.len().to_string()),
    None -> b"none",
  }

fn length_label(input: Bytes) -> Bytes / {memo.read} = {
  let n = memo.fetch(b"length", input);
  b"long ".concat(n)
}

fn test_queries(length_hash: Bytes) -> Map<Bytes, Query<| {}>> =
  Map::new().insert(b"length", query(b"length", length_hash, length_of)).insert(
    b"longer",
    query(b"longer", b"l1", length_label),
  )

fn run_query(
  queries: Map<Bytes, Query<| {}>>,
  w: TestEnvironment,
  name: Bytes,
  input: Bytes,
) -> { output: Bytes, executed: Int, lost: Int, read: Int, world: TestEnvironment } / {abort.raise} =
  ask_with_packs(queries, w, None, None, name, input)

fn ask_with_packs(
  queries: Map<Bytes, Query<| {}>>,
  w: TestEnvironment,
  packed: Option<packs::PackFiles>,
  after: Option<Map<Bytes, Bytes>>,
  name: Bytes,
  input: Bytes,
) -> { output: Bytes, executed: Int, lost: Int, read: Int, world: TestEnvironment } / {abort.raise} =
  handle {
    with_memory_store(
      w.store,
      |path: String, offset: Int, len: Int| packs::frame_in(packed, path, offset, len),
      files_of(w),
      |_: Bytes, at: Bytes| {
        let n = world_reads.counted();
        match after {
          Some(files) -> if n > 0 { files.get(at) } else { w.files.get(at) },
          None -> w.files.get(at),
        }
      },
      || {
        let a = query_output(queries, start_run(queries), name, input);
        { output: a.output, executed: executed_count(a.run), lost: missing_count(a.run) }
      },
    )
  } with {
    var reads = 0,
    world_reads.counted() -> {
      let n = reads;
      reads = n + 1;
      n
    },
    return done ->
      {
        output: done.value.output,
        executed: done.value.executed,
        lost: done.value.lost,
        read: reads,
        world: { ..w, store: done.store, read: reads },
      },
  }

effect world_reads {
  write counted() -> Int
}

fn edited(w: TestEnvironment, at: Bytes, text: Bytes) -> TestEnvironment =
  { ..w, files: w.files.insert(at, text) }

fn only_record(w: TestEnvironment, key: Bytes) -> TestEnvironment / {abort.raise} =
  match w.store.records.get(key) {
    Some(r) -> { ..w, store: { ..w.store, records: Map::new().insert(key, r) } },
    None -> panic("no record is kept under the key"),
  }

test "a query's record returns its result again while what it read returns the same" {
  let q = test_queries(b"h1");
  let first = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  assert_eq(first.output, b"4");
  assert_eq(first.executed, 1);
  let again = run_query(q, first.world, b"length", b"a");
  assert_eq(again.output, b"4");
  assert_eq(again.executed, 0);
  let moved = run_query(q, edited(again.world, b"a", b"seven!!"), b"length", b"a");
  assert_eq(moved.output, b"7");
  assert_eq(moved.executed, 1)
}

test "a result that comes out the same stops an edit's change from spreading" {
  let q = test_queries(b"h1");
  let first = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"longer", b"a");
  assert_eq(first.output, b"long 4");
  assert_eq(first.executed, 2);
  let same = run_query(q, edited(first.world, b"a", b"FOUR"), b"longer", b"a");
  assert_eq(same.output, b"long 4");
  assert_eq(same.executed, 1);
  let longer_now = run_query(q, edited(same.world, b"a", b"forty"), b"longer", b"a");
  assert_eq(longer_now.output, b"long 5");
  assert_eq(longer_now.executed, 2)
}

fn switched(input: Bytes) -> Bytes / {memo.read} =
  if memo.external(b"file", b"switch") == Some(b"ask") {
    let relayed = memo.fetch(b"relayed", input);
    if relayed == b"loop" { memo.fetch(b"back", input) } else { relayed }
  } else { b"alone" }

fn file_text(input: Bytes) -> Bytes / {memo.read} = {
  let _ = memo.fetch(b"length", b"pad");
  match memo.external(b"file", b"f") { Some(text) -> text, None -> b"none" }
}

fn relayed(input: Bytes) -> Bytes / {memo.read} = memo.fetch(b"leveled", input)

fn cycle_to_switched(input: Bytes) -> Bytes / {memo.read} = memo.fetch(b"switched", input)

fn paired(input: Bytes) -> Bytes / {memo.read} =
  Bytes::concat_all([memo.fetch(b"switched", input), b"|", memo.fetch(b"relayed", input)])

fn relay_queries() -> Map<Bytes, Query<| {}>> =
  test_queries(b"h1").insert(b"switched", query(b"switched", b"s1", switched)).insert(
    b"leveled",
    query(b"leveled", b"v1", file_text),
  ).insert(
    b"relayed",
    query(b"relayed", b"r1", relayed),
  ).insert(
    b"back",
    query(b"back", b"b1", cycle_to_switched),
  ).insert(
    b"paired",
    query(b"paired", b"o1", paired),
  )

test "records whose reads now lead round to what asked them return what a cold run does" {
  let q = relay_queries();
  let files = [
    { at: b"switch", text: b"no" },
    { at: b"f", text: b"loop" },
    { at: b"pad", text: b"x" },
  ];
  let first = run_query(q, test_world(files), b"paired", b"s");
  assert_eq(first.output, b"alone|loop");
  let moved = edited(edited(first.world, b"switch", b"ask"), b"f", b"fine");
  let cold = edited(
    edited({ ..first.world, store: empty_memory_store() }, b"switch", b"ask"),
    b"f",
    b"fine",
  );
  assert_eq(run_query(q, moved, b"paired", b"s").output, run_query(q, cold, b"paired", b"s").output)
}

fn round_g(input: Bytes) -> Bytes / {memo.read} = memo.fetch(b"h", input)

fn round_h(input: Bytes) -> Bytes / {memo.read} =
  if memo.external(b"file", b"hd") == Some(b"on") { memo.fetch(b"y", input) } else { b"h" }

fn round_y(input: Bytes) -> Bytes / {memo.read} =
  if memo.external(b"file", b"yd") == Some(b"on") { memo.fetch(b"g", input) } else { b"y" }

fn round_queries() -> Map<Bytes, Query<| {}>> =
  Map::new().insert(b"g", query(b"g", b"g1", round_g)).insert(
    b"h",
    query(b"h", b"h1", round_h),
  ).insert(
    b"y",
    query(b"y", b"y1", round_y),
  )

test "records stored in other worlds that ask one another return what a cold run does, and reject a cycle it makes" {
  let q = round_queries();
  let first = run_query(
    q,
    test_world([{ at: b"hd", text: b"on" }, { at: b"yd", text: b"off" }]),
    b"g",
    b"x",
  );
  assert_eq(first.output, b"y");
  let second = run_query(q, edited(edited(first.world, b"hd", b"off"), b"yd", b"on"), b"y", b"x");
  assert_eq(second.output, b"h");
  assert_eq(run_query(q, edited(second.world, b"yd", b"off"), b"g", b"x").output, b"h");
  let both = edited(second.world, b"hd", b"on");
  assert_eq(try_result(|| run_query(q, both, b"g", b"x").output), None);
  assert_eq(
    try_result(|| run_query(q, { ..both, store: empty_memory_store() }, b"g", b"x").output),
    None,
  )
}

test "an edit undone returns what it did before with no body run, from the records it replaced" {
  let q = test_queries(b"h1");
  let first = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"longer", b"a");
  let moved = run_query(q, edited(first.world, b"a", b"forty"), b"longer", b"a");
  assert_eq(moved.output, b"long 5");
  assert_eq(moved.executed, 2);
  let undone = run_query(q, edited(moved.world, b"a", b"four"), b"longer", b"a");
  assert_eq(undone.output, b"long 4");
  assert_eq(undone.executed, 0);
  let redone = run_query(q, edited(undone.world, b"a", b"forty"), b"longer", b"a");
  assert_eq(redone.output, b"long 5");
  assert_eq(redone.executed, 0)
}

test "what a driver's asks reach is each record their reads ask, at any depth" {
  let q = test_queries(b"h1");
  let every = Map::new().insert(b"h1", true).insert(b"l1", true);
  let done = with_memory_store(
    empty_memory_store(),
    packs::no_pack,
    b"",
    |_: Bytes, _: Bytes| Some(b"four"),
    || reachable_keys(q, every, query_output(q, start_run(q), b"longer", b"a").run),
  );
  assert_eq(
    done.value.sort_by_key(|k: Bytes| k),
    [key_of(query_of(q, b"longer"), b"a"), key_of(query_of(q, b"length"), b"a")].sort_by_key(
      |k: Bytes| k,
    ),
  )
}

fn exclaim_longer(input: Bytes) -> Bytes / {memo.read} = memo.fetch(b"longer", input).concat(b"!")

fn loudest_by_digest(input: Bytes) -> Bytes / {memo.read} =
  Bytes::concat(
    match memo.stored_output(memo.output_digest(b"longer", input)) {
      Some(b) -> b,
      None -> memo.fetch(b"longer", input),
    },
    b"!",
  )

test "a result asked for by its digest is the read an ask makes, and is handed over by it" {
  let by = |body: (Bytes) -> Bytes / {memo.read}|
    test_queries(b"h1").insert(b"loudest", query(b"loudest", b"d1", body));
  let asked = run_query(
    by(exclaim_longer),
    test_world([{ at: b"a", text: b"four" }]),
    b"loudest",
    b"a",
  );
  let headed = run_query(
    by(loudest_by_digest),
    test_world([{ at: b"a", text: b"four" }]),
    b"loudest",
    b"a",
  );
  assert_eq(headed.output, b"long 4!");
  assert_eq(headed.world.store.records, asked.world.store.records);
  let moved = run_query(
    by(loudest_by_digest),
    edited(headed.world, b"a", b"forty"),
    b"loudest",
    b"a",
  );
  assert_eq(moved.output, b"long 5!");
  assert_eq(moved.executed, 3)
}

test "a run where nothing moved reads each place once and runs no body" {
  let q = test_queries(b"h1");
  let first = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"longer", b"a");
  let again = run_query(q, first.world, b"longer", b"a");
  assert_eq(again.output, b"long 4");
  assert_eq(again.executed, 0);
  assert_eq(again.read, 1)
}

test "a record no run asked for since a place moved is checked when one asks" {
  let q = test_queries(b"h1");
  let first = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"longer", b"a");
  let moved = run_query(q, edited(first.world, b"a", b"forty"), b"length", b"a");
  assert_eq(moved.output, b"5");
  assert_eq(moved.executed, 1);
  let later = run_query(q, moved.world, b"longer", b"a");
  assert_eq(later.output, b"long 5");
  assert_eq(later.executed, 1)
}

test "a query whose definition changed is computed again, and what asked it stands where it returns the same" {
  let first = run_query(
    test_queries(b"h1"),
    test_world([{ at: b"a", text: b"four" }]),
    b"longer",
    b"a",
  );
  let moved = run_query(test_queries(b"h2"), first.world, b"longer", b"a");
  assert_eq(moved.output, b"long 4");
  assert_eq(moved.executed, 1)
}

test "what stood through a definition that changed under it is computed again where that result changes later" {
  let first = run_query(
    test_queries(b"h1"),
    test_world([{ at: b"a", text: b"four" }]),
    b"longer",
    b"a",
  );
  let stood = run_query(test_queries(b"h2"), first.world, b"longer", b"a");
  assert_eq(stood.executed, 1);
  let moved = run_query(test_queries(b"h2"), edited(stood.world, b"a", b"forty"), b"longer", b"a");
  assert_eq(moved.output, b"long 5");
  assert_eq(moved.executed, 2)
}

test "a store written under queries defined differently returns what they return now" {
  let first = run_query(
    test_queries(b"h1"),
    test_world([{ at: b"a", text: b"four" }]),
    b"longer",
    b"a",
  );
  let counting_twice = test_queries(b"h2").insert(
    b"length",
    query(b"length", b"h2", |input: Bytes|
      match memo.external(b"file", input) {
        Some(text) -> Bytes::of_string(Int::to_string(2 * text.len())),
        None -> b"none",
      }),
  );
  let moved = run_query(counting_twice, first.world, b"longer", b"a");
  assert_eq(moved.output, b"long 8");
  assert_eq(moved.executed, 2)
}

test "a run reads each place once, whatever the place holds later in it" {
  let q = test_queries(b"h1");
  let edited_after = Map::new().insert(b"a", b"forty");
  let first = ask_with_packs(
    q,
    test_world([{ at: b"a", text: b"four" }]),
    None,
    Some(edited_after),
    b"length",
    b"a",
  );
  assert_eq(first.output, b"4");
  assert_eq(first.read, 1);
  let next = run_query(q, edited(first.world, b"a", b"forty"), b"length", b"a");
  assert_eq(next.output, b"5");
  assert_eq(next.executed, 1)
}

pub fn exclaim_middle(input: Bytes) -> Bytes / {memo.read} =
  memo.fetch(b"middle", input).concat(b"!")

pub fn middle_label(input: Bytes) -> Bytes / {memo.read} =
  b"mid ".concat(memo.fetch(b"length", input))

fn summed() -> Map<Bytes, Query<| {}>> =
  test_queries(b"h1").insert(b"top", {
    ..query(b"top", b"t1", exclaim_middle),
    summarized: true,
  }).insert(
    b"middle",
    query(b"middle", b"m1", middle_label),
  )

test "a record whose summary returns what it did stands with no record below it read" {
  let q = summed();
  let first = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"top", b"a");
  assert_eq(first.output, b"mid 4!");
  let top = key_of(query_of(q, b"top"), b"a");
  let again = run_query(q, only_record(first.world, top), b"top", b"a");
  assert_eq(again.output, b"mid 4!");
  assert_eq(again.executed, 0)
}

test "a summary holds each place and definition below, down to records that keep their own" {
  let q = summed().insert(b"middle", { ..query(b"middle", b"m1", middle_label), summarized: true });
  let first = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"top", b"a");
  let summary_of_key = |name: Bytes|
    match first.world.store.records.get(key_of(query_of(q, name), b"a")) {
      Some(r) -> r.summary,
      None -> panic("the record is kept"),
    };
  let middle = summary_of_key(b"middle");
  assert(middle.contains(ExternalDependency(b"file", b"a", digest_of(Some(b"four")))));
  assert(middle.contains(ExternalDependency(query_kind(), b"length", digest_of(Some(b"h1")))));
  assert_eq(summary_of_key(b"top"), [QueryDependency(b"middle", b"a", digest_of(Some(b"mid 4")))])
}

test "a summary that changed under a result that came out the same is made again" {
  let q = summed();
  let first = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"top", b"a");
  let top = key_of(query_of(q, b"top"), b"a");
  let same = run_query(q, edited(first.world, b"a", b"FOUR"), b"top", b"a");
  assert_eq(same.output, b"mid 4!");
  assert_eq(same.executed, 1);
  let again = run_query(q, only_record(same.world, top), b"top", b"a");
  assert_eq(again.executed, 0);
  let moved = run_query(q, edited(same.world, b"a", b"forty"), b"top", b"a");
  assert_eq(moved.output, b"mid 5!");
  assert_eq(moved.executed, 3)
}

test "a summary moves with the definition of a query below it" {
  let first = run_query(summed(), test_world([{ at: b"a", text: b"four" }]), b"top", b"a");
  let top = key_of(query_of(summed(), b"top"), b"a");
  let redefined = summed().insert(b"length", query(b"length", b"h2", length_of));
  let moved = run_query(redefined, only_record(first.world, top), b"top", b"a");
  assert_eq(moved.output, b"mid 4!");
  assert_eq(moved.executed, 2)
}

fn files_of(w: TestEnvironment) -> Bytes =
  Bytes::concat_all(
    w.files.fold([], |acc: List<Bytes>, at: Bytes, text: Bytes|
      acc.push(at).push(b" ").push(blake3(text)).push(b"\n")),
  )

fn pack_over(q: Map<Bytes, Query<| {}>>, w: TestEnvironment) -> packs::PackFiles / {abort.raise} =
  pack_memory_store(w.store, q, files_of(w))

test "a packed result stands as it is over the very files it was made over, and nothing of it is cached" {
  let q = test_queries(b"h1");
  let four = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let first = ask_with_packs(
    q,
    test_world([{ at: b"a", text: b"four" }]),
    Some(pack_over(q, four.world)),
    None,
    b"longer",
    b"a",
  );
  assert_eq(first.output, b"long 4");
  assert_eq(first.executed, 1);
  assert_eq(current_records(first.world.store).keys(), [key_of(query_of(q, b"longer"), b"a")])
}

test "a packed result over other files is checked against its reads, and computed again where they changed" {
  let q = test_queries(b"h1");
  let four = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let packed = pack_over(q, four.world);
  let beside = ask_with_packs(
    q,
    test_world([{ at: b"a", text: b"four" }, { at: b"z", text: b"more" }]),
    Some(packed),
    None,
    b"longer",
    b"a",
  );
  assert_eq(beside.output, b"long 4");
  assert_eq(beside.executed, 1);
  let moved = ask_with_packs(
    q,
    test_world([{ at: b"a", text: b"forty" }]),
    Some(packed),
    None,
    b"longer",
    b"a",
  );
  assert_eq(moved.output, b"long 5");
  assert_eq(moved.executed, 2)
}

test "what asked for a packed result is computed again where another pack is below the store" {
  let q = test_queries(b"h1");
  let four = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let forty = run_query(q, test_world([{ at: b"a", text: b"forty" }]), b"length", b"a");
  let first = ask_with_packs(
    q,
    test_world([{ at: b"a", text: b"four" }]),
    Some(pack_over(q, four.world)),
    None,
    b"longer",
    b"a",
  );
  assert_eq(first.output, b"long 4");
  let again = ask_with_packs(q, first.world, Some(pack_over(q, four.world)), None, b"longer", b"a");
  assert_eq(again.executed, 0);
  let moved = ask_with_packs(
    q,
    { ..again.world, files: forty.world.files },
    Some(pack_over(q, forty.world)),
    None,
    b"longer",
    b"a",
  );
  assert_eq(moved.output, b"long 5");
  assert_eq(moved.executed, 1);
  assert_eq(
    ask_with_packs(q, moved.world, Some(pack_over(q, forty.world)), None, b"longer", b"a").executed,
    0,
  )
}

test "what asked for a packed result is computed again where the files below the pack changed" {
  let q = test_queries(b"h1");
  let four = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let packed = pack_over(q, four.world);
  let first = ask_with_packs(
    q,
    test_world([{ at: b"a", text: b"four" }]),
    Some(packed),
    None,
    b"longer",
    b"a",
  );
  let moved = ask_with_packs(
    q,
    edited(first.world, b"a", b"forty"),
    Some(packed),
    None,
    b"longer",
    b"a",
  );
  assert_eq(moved.output, b"long 5");
  assert_eq(moved.executed, 2)
}

test "a run takes what the pack below its store holds for what moved" {
  let q = test_queries(b"h1");
  let four = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let forty = run_query(q, test_world([{ at: b"a", text: b"forty" }]), b"length", b"a");
  let first = ask_with_packs(
    q,
    test_world([{ at: b"a", text: b"four" }]),
    Some(pack_over(q, four.world)),
    None,
    b"length",
    b"a",
  );
  assert_eq(first.executed, 0);
  let next = ask_with_packs(
    q,
    edited(first.world, b"a", b"forty"),
    Some(pack_over(q, forty.world)),
    None,
    b"length",
    b"a",
  );
  assert_eq(next.output, b"5");
  assert_eq(next.executed, 0)
}

fn commanded_over(
  q: Map<Bytes, Query<| {}>>,
  w: TestEnvironment,
  packed: Option<packs::PackFiles>,
  name: Bytes,
  key: Bytes,
) -> { took: Bool, output: Bytes, executed: Int, world: TestEnvironment } / {abort.raise} = {
  let done = with_memory_store(
    w.store,
    |path: String, offset: Int, len: Int| packs::frame_in(packed, path, offset, len),
    files_of(w),
    |_: Bytes, at: Bytes| w.files.get(at),
    || {
      let run = start_run(q);
      match cached_output(q, key) {
        Some(o) -> { took: true, output: o, executed: 0 },
        None -> {
          let a = query_output(q, run, name, b"a");
          let said = b"said ".concat(a.output);
          record_output(q, key, b"c1", driver_dependencies(a.run), memo_store.looked(), said);
          { took: false, output: said, executed: executed_count(a.run) }
        },
      }
    },
  );
  {
    took: done.value.took,
    output: done.value.output,
    executed: done.value.executed,
    world: { ..w, store: done.store },
  }
}

test "a result cached over what a run asked stands while every place the run looked at is as it was" {
  let q = test_queries(b"h1");
  let first = commanded_over(q, test_world([{ at: b"a", text: b"four" }]), None, b"longer", b"k");
  assert_eq(first.output, b"said long 4");
  assert(!first.took);
  let again = commanded_over(q, first.world, None, b"longer", b"k");
  assert(again.took);
  assert_eq(again.output, b"said long 4");
  let same = commanded_over(q, edited(again.world, b"a", b"FOUR"), None, b"longer", b"k");
  assert(!same.took);
  assert_eq([same.output, Bytes::of_string(same.executed.to_string())], [b"said long 4", b"1"]);
  let moved = commanded_over(q, edited(same.world, b"a", b"forty"), None, b"longer", b"k");
  assert(!moved.took);
  assert_eq(moved.output, b"said long 5");
  assert(commanded_over(q, moved.world, None, b"longer", b"k").took)
}

test "a result cached over what a run asked changes with a query's definition" {
  let first = commanded_over(
    test_queries(b"h1"),
    test_world([{ at: b"a", text: b"four" }]),
    None,
    b"longer",
    b"k",
  );
  assert(!commanded_over(test_queries(b"h2"), first.world, None, b"longer", b"k").took)
}

test "a command's result over a packed result falls where another pack is below the store" {
  let q = test_queries(b"h1");
  let four = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let forty = run_query(q, test_world([{ at: b"a", text: b"forty" }]), b"length", b"a");
  let commanded = |held: MemoryStore, w: TestEnvironment|
    commanded_over(q, { ..w, store: held }, Some(pack_over(q, w)), b"length", b"k");
  let first = commanded(empty_memory_store(), four.world);
  assert_eq(first.output, b"said 4");
  assert(commanded(first.world.store, four.world).took);
  let moved = commanded(first.world.store, forty.world);
  assert(!moved.took);
  assert_eq(moved.output, b"said 5")
}

test "a record whose result is no longer cached is computed again" {
  let q = test_queries(b"h1");
  let first = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let lost = run_query(
    q,
    { ..first.world, store: { ..first.world.store, outputs: Map::new() } },
    b"length",
    b"a",
  );
  assert_eq(lost.output, b"4");
  assert_eq(lost.executed, 1);
  assert_eq([first.lost, lost.lost], [0, 1])
}

test "a result made again that differs from its record is rejected" {
  let q = test_queries(b"h1");
  let first = run_query(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let unrecorded = Map::new().insert(
    b"length",
    query(b"length", b"h1", |input: Bytes| {
      let _ = memo.external(b"file", input);
      b"other"
    }),
  );
  let lost = { ..first.world, store: { ..first.world.store, outputs: Map::new() } };
  assert_eq(try_result(|| run_query(unrecorded, lost, b"length", b"a").output), None)
}

pub fn read_file(input: Bytes) -> Bytes / {memo.read} =
  match memo.external(b"file", input) { Some(t) -> t, None -> b"" }

test "a query that caches no long results keeps its records, and a run that needs one makes it again" {
  let text = b"word ".repeat(1000);
  let q = test_queries(b"h1").insert(b"length", {
    ..query(b"length", b"h1", read_file),
    persistent: false,
  });
  let first = run_query(q, test_world([{ at: b"a", text: text }]), b"longer", b"a");
  assert_eq(first.output, b"long ".concat(text));
  assert(!first.world.store.outputs.contains(digest_of(Some(text))));
  assert(first.world.store.outputs.contains(digest_of(Some(first.output))));
  let again = run_query(q, first.world, b"longer", b"a");
  assert_eq([again.executed, again.lost], [0, 0]);
  let whole = run_query(q, again.world, b"length", b"a");
  assert_eq(whole.output, text);
  assert_eq([whole.executed, whole.lost], [1, 0]);
  let short = test_queries(b"h1").insert(b"length", {
    ..query(b"length", b"h1", length_of),
    persistent: false,
  });
  let held = run_query(short, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  assert(held.world.store.outputs.contains(digest_of(Some(b"4"))))
}

fn provide_taken(input: Bytes) -> Bytes / {memo.read} = {
  memo.provide(b"taken", input, b"v ".concat(input));
  b"offered"
}

fn taking(input: Bytes) -> Bytes / {memo.read} =
  match memo.provided() { Some(o) -> o, None -> b"v ".concat(input) }

fn both(input: Bytes) -> Bytes / {memo.read} = {
  memo.fetch(b"offering", input);
  memo.fetch(b"taken", input)
}

fn offer_queries(offering_hash: Bytes) -> Map<Bytes, Query<| {}>> =
  Map::new().insert(b"offering", query(b"offering", offering_hash, provide_taken)).insert(
    b"taken",
    query(b"taken", b"t1", taking),
  ).insert(
    b"both",
    query(b"both", b"b1", both),
  )

test "a result taken from an offer is made again when the query that offered it is redefined" {
  let first = run_query(offer_queries(b"o1"), test_world([]), b"both", b"a");
  assert_eq(first.output, b"v a");
  let again = run_query(offer_queries(b"o1"), first.world, b"both", b"a");
  assert_eq(again.executed, 0);
  let moved = run_query(offer_queries(b"o2"), again.world, b"both", b"a");
  assert_eq(moved.output, b"v a");
  assert_eq(moved.executed, 2)
}

fn check_taken_cached(input: Bytes) -> Bytes / {memo.read} = {
  let _ = memo.output_digest(b"offering", input);
  if memo.is_cached(b"taken", input) { b"kept" } else { b"not kept" }
}

test "a record is judged cached by a result offered in the run, with no body run for it" {
  let q = offer_queries(b"o1").insert(b"judging", query(b"judging", b"j1", check_taken_cached));
  let first = run_query(q, test_world([]), b"both", b"a");
  let moved = q.insert(b"offering", query(b"offering", b"o2", provide_taken));
  let judged = run_query(moved, first.world, b"judging", b"a");
  assert_eq(judged.output, b"kept");
  assert_eq(judged.executed, 2)
}

test "a query asking for its own result is rejected" {
  let looping = Map::new().insert(
    b"self",
    query(b"self", b"s", |input: Bytes| memo.fetch(b"self", input)),
  );
  assert_eq(try_result(|| run_query(looping, test_world([]), b"self", b"x").output), None)
}

fn records() -> gen::Gen<Record> =
  gen::and_then(gen::bytes(), |query: Bytes|
    gen::map4(
      gen::bytes(),
      gen::list(reads()),
      gen::bytes(),
      gen::list(reads()),
      |input: Bytes, reads: List<Dependency>, output: Bytes, summary: List<Dependency>|
        { query: query, input: input, reads: reads, output: output, summary: summary },
    ))

fn reads() -> gen::Gen<Dependency> =
  gen::one_of([
    gen::map3(gen::bytes(), gen::bytes(), gen::bytes(), |f0: Bytes, f1: Bytes, f2: Bytes|
      ExternalDependency(f0, f1, f2)),
    gen::map3(gen::bytes(), gen::bytes(), gen::bytes(), |f0: Bytes, f1: Bytes, f2: Bytes|
      QueryDependency(f0, f1, f2)),
  ])

test "a record reads back as it was stored, with the result it holds" {
  gen::check2(records(), gen::option_of(gen::bytes()), |r: Record, inline: Option<Bytes>| {
    let b = record_bytes(r, inline);
    record_from(b) == Some(r) && inline_output_of(b) == inline
  })
}

test "a record's first bytes name its result, and hold one it stores inside" {
  gen::check2(records(), gen::bytes(), |r: Record, o: Bytes|
    if r.output.len() <= 64 {
      let inline = inline_output(o);
      let b = record_bytes(r, inline);
      let head = b.slice(0, if b.len() < record_head_size() { b.len() }
      else { record_head_size() });
      output_digest_of(head) == Some(r.output) && inline_output_of(head) == inline
    } else { true })
}

test "bytes of another format read as no record" {
  gen::check(gen::bytes(), |b: Bytes|
    if b.len() == 0 || b.at(0) != 6 {
      record_from(b) == None && output_digest_of(b) == None && inline_output_of(b) == None
    } else { true })
}

fn try_result(f: () -> Bytes / {abort.raise}) -> Option<Bytes> =
  handle { Some(f()) } with { abort.raise(_) -> None }
