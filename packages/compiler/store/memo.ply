import std.bin
import std.bytes (u64_le, u64_be)
import std.list
import std.hash (blake3)
import compiler.store.packs

pub effect memo {
  read external(kind: Bytes, at: Bytes) -> Option<Bytes>
  read fetch(query: Bytes, input: Bytes) -> Bytes
  read fetch_all(query: Bytes, inputs: List<Bytes>) -> List<Bytes>
  read output_digest(query: Bytes, input: Bytes) -> Bytes
  read stored_output(digest: Bytes) -> Option<Bytes>
  write provide(query: Bytes, input: Bytes, output: Bytes) -> Unit
  write written_by(query: Bytes, input: Bytes) -> Option<Bytes>
  write fix(kind: Bytes, at: Bytes) -> Unit
}

pub type Dependency = | ExternalDependency(Bytes, Bytes, Bytes) | QueryDependency(Bytes, Bytes)

pub type StoredFact = { output: Bytes, details: Bytes, depth: Int, written_by: Bytes }

pub type WrittenFact = { key: Bytes, output: Bytes }

pub type FactDetails = {
  query: Bytes,
  code: Bytes,
  input: Bytes,
  reads: List<Dependency>,
  wrote: List<WrittenFact>,
}

pub type StoredInput = { kind: Bytes, at: Bytes, digest: Bytes, fixed: Bool }

derive bin for Dependency

derive bin for StoredFact

derive bin for WrittenFact

derive bin for FactDetails

derive bin for StoredInput

pub type Product = { kind: Bytes, after: List<Bytes> }

pub type Query<| e> = {
  name: Bytes,
  hash: Bytes,
  body: (Bytes) -> Bytes / {memo.read, memo.write, abort.raise | e},
  persistent: Bool,
  product: Option<Product>,
}

pub type Queries<| e> = {
  named: Map<Bytes, Query<| e>>,
  apart: (() -> Bytes / {abort.raise | e}) -> Bytes / {abort.raise},
}

pub fn plain_queries(named: Map<Bytes, Query<| {}>>) -> Queries<| {}> =
  { named: named, apart: |work: () -> Bytes / {abort.raise}| work() }

type Step = { query: Bytes, input: Bytes }

type Settled = { digest: Bytes, depth: Int, sealed: Bool }

type Trail = | Started | Then(Trail, Step)

pub type Run = {
  resolved: Map<Bytes, Settled>,
  requested_dependencies: List<Dependency>,
  open: Map<Bytes, Bool>,
  lowest_open: Option<Int>,
  trail: Trail,
  took: Map<Bytes, Int>,
  ran: Map<Bytes, Int>,
  inputs: List<Step>,
  lost: Map<Bytes, Int>,
  caught_up: Map<Bytes, Bool>,
}

const new_run: Run =
  {
    resolved: Map::new(),
    requested_dependencies: [],
    open: Map::new(),
    lowest_open: None,
    trail: Started,
    took: Map::new(),
    ran: Map::new(),
    inputs: [],
    lost: Map::new(),
    caught_up: Map::new(),
  }

pub fn missing_count(run: Run) -> Int = run.lost.fold(0, |n: Int, _: Bytes, k: Int| n + k)

pub type QueryStats = { query: Bytes, took: Int, ran: Int, lost: Int }

derive bin for QueryStats

fn count_of(m: Map<Bytes, Int>, name: Bytes) -> Int = match m.get(name) { Some(n) -> n, None -> 0 }

fn incremented(m: Map<Bytes, Int>, name: Bytes) -> Map<Bytes, Int> =
  m.insert(name, count_of(m, name) + 1)

pub fn query_stats(run: Run) -> List<QueryStats> =
  run.ran.fold(run.took, |accumulator: Map<Bytes, Int>, k: Bytes, _: Int|
    if accumulator.contains(k) { accumulator } else { accumulator.insert(k, 0) }).keys(
  ).map(|name: Bytes|
    {
      query: name,
      took: count_of(run.took, name),
      ran: count_of(run.ran, name),
      lost: count_of(run.lost, name),
    })

pub fn merged_query_stats(a: List<QueryStats>, b: List<QueryStats>) -> List<QueryStats> =
  b.fold(
    a.fold(Map::new(), |accumulator: Map<Bytes, QueryStats>, t: QueryStats|
      accumulator.insert(t.query, t)),
    |accumulator: Map<Bytes, QueryStats>, t: QueryStats|
      accumulator.insert(t.query, match accumulator.get(t.query) {
        Some(u) ->
          { query: t.query, took: u.took + t.took, ran: u.ran + t.ran, lost: u.lost + t.lost },
        None -> t,
      }),
  ).values(
  )

pub fn executed_for(run: Run, name: Bytes) -> List<Bytes> =
  run.inputs.filter(|r: Step| r.query == name).map(|r: Step| r.input)

pub fn executed_count(run: Run) -> Int = run.ran.fold(0, |n: Int, _: Bytes, k: Int| n + k)

pub fn digest_of(query_output: Option<Bytes>) -> Bytes =
  match query_output { Some(b) -> b"=".concat(blake3(b)), None -> b"-" }

fn query_prefix(name: Bytes) -> Bytes / {abort.raise} = blake3(name).slice(0, 4)

pub fn fact_key(name: Bytes, input: Bytes) -> Bytes / {abort.raise} =
  query_prefix(name).concat(blake3(input).slice(0, 12))

pub fn key_of<| e>(q: Query<| e>, input: Bytes) -> Bytes / {abort.raise} = fact_key(q.name, input)

fn length_prefixed(b: Bytes) -> Bytes = u64_le(b.len()).concat(b)

pub fn location_id(kind: Bytes, at: Bytes) -> Bytes / {abort.raise} =
  blake3(Bytes::concat_all([b"ply.input\x00", length_prefixed(kind), at])).slice(0, 16)

pub fn queries_id<| e>(queries: Queries<| e>) -> Bytes =
  blake3(
    Bytes::concat_all(
      queries.named.fold(
        [b"ply.memo.queries\x00"],
        |accumulator: List<Bytes>, name: Bytes, q: Query<| e>|
          accumulator.push(length_prefixed(name)).push(length_prefixed(q.hash)),
      ),
    ),
  )

pub type EncodedDetails = { details: FactDetails, encoded: Bytes, digest: Bytes }

pub fn encoded_details(d: FactDetails) -> EncodedDetails / {abort.raise} = {
  let encoded = bin::encode(d, fact_details_bin());
  { details: d, encoded: encoded, digest: blake3(encoded) }
}

const sealed_kind: Bytes = b"sealed"

pub effect memo_store {
  read fact(key: Bytes) -> Option<StoredFact>
  read details(digest: Bytes) -> Option<FactDetails>
  read output(digest: Bytes) -> Option<Bytes>
  read sealed(key: Bytes) -> Option<Bytes>
  read sealed_changed() -> Bool
  read dependents(key: Bytes) -> List<Bytes>
  read has_dependents(key: Bytes) -> Bool
  read inputs() -> List<StoredInput>
  read facts_of(prefix: Bytes) -> List<Bytes>
  read code(name: Bytes) -> Option<Bytes>
  read external(kind: Bytes, at: Bytes) -> InputRead
  read is_out_of_date(key: Bytes) -> Bool
  read next_out_of_date() -> Option<Waited>
  read out_of_date_level() -> List<Waited>
  write put(key: Bytes, fact: StoredFact, details: FactDetails, encoded_details: Bytes, output: Bytes, lasting: Bool) -> Unit
  write keep_output(digest: Bytes, output: Bytes, lasting: Bool) -> Unit
  write put_fact(key: Bytes, fact: StoredFact) -> Unit
  write delete(key: Bytes) -> Unit
  write add_dependent(key: Bytes, dependent: Bytes) -> Unit
  write remove_dependent(key: Bytes, dependent: Bytes) -> Unit
  write put_input(input: StoredInput) -> Unit
  write fix_input(kind: Bytes, at: Bytes) -> Unit
  write delete_input(id: Bytes) -> Unit
  write put_code(name: Bytes, hash: Bytes) -> Unit
  write mark_out_of_date(key: Bytes, depth: Int) -> Unit
  write settle(key: Bytes) -> Unit
  write log_change(key: Bytes) -> Unit
  write note_edit() -> Unit
  read deferred_kind(key: Bytes) -> Option<Bytes>
  write defer_products(kinds: Map<Bytes, Bytes>) -> Unit
  write push_products(kind: Bytes) -> Unit
  read logged_changes(kind: Bytes) -> List<Bytes>
  write log_read(kind: Bytes) -> Unit
  write running(id: Bytes) -> Unit
}

pub type QueryResult = { run: Run, output: Bytes }

fn query_of<| e>(queries: Queries<| e>, name: Bytes) -> Query<| e> / {abort.raise} =
  match queries.named.get(name) {
    Some(q) -> q,
    None -> panic("no query is named `" ++ String::of_bytes_lossy(name) ++ "`"),
  }

const too_deep: Bytes = b"queries call each other in a chain longer than the limit"

fn marked(key: Bytes) -> Unit / {memo_store.read, memo_store.write} =
  match memo_store.fact(key) { Some(f) -> memo_store.mark_out_of_date(key, f.depth), None -> () }

fn marked_dependents(key: Bytes) -> Unit / {memo_store.read, memo_store.write} = {
  let deferred = memo_store.dependents(key).fold(false, |any: Bool, d: Bytes|
    if memo_store.deferred_kind(d) != None { true } else {
      marked(d);
      any
    });
  if deferred { memo_store.log_change(key) }
}

fn dependency_id(r: Dependency) -> Bytes / {abort.raise} =
  match r {
    QueryDependency(key, _) -> key,
    ExternalDependency(kind, at, _) -> location_id(kind, at),
  }

fn dependency_ids(reads: List<Dependency>) -> Map<Bytes, Bool> / {abort.raise} =
  reads.fold(Map::new(), |ids: Map<Bytes, Bool>, r: Dependency| ids.insert(dependency_id(r), true))

fn released(id: Bytes) -> Bool / {memo_store.read, memo_store.write} =
  if memo_store.has_dependents(id) { false } else {
    match memo_store.fact(id) {
      Some(f) -> f.written_by == b"",
      None -> {
        memo_store.delete_input(id);
        false
      },
    }
  }

fn deleted_one(key: Bytes) -> List<Bytes> / {memo_store.read, memo_store.write, abort.raise} =
  match memo_store.fact(key) {
    None -> {
      memo_store.settle(key);
      []
    },
    Some(f) -> {
      marked_dependents(key);
      let before = memo_store.details(f.details);
      memo_store.delete(key);
      match before {
        None -> [],
        Some(d) ->
          dependency_ids(d.reads).keys().fold(
            still_written(key, wrote_in(before)),
            |next: List<Bytes>, id: Bytes| {
              memo_store.remove_dependent(id, key);
              if released(id) { next.push(id) } else { next }
            },
          ),
      }
    },
  }

fn deleted_all(keys: List<Bytes>) -> Unit / {memo_store.read, memo_store.write, abort.raise} =
  iterate({ work: keys, next: 0 }, 1099511627776, |left: { work: List<Bytes>, next: Int }| {
    let { work, next } = left;
    match work.at(next) {
      None -> Stop(()),
      Some(key) ->
        Continue({
          next: next + 1,
          work: deleted_one(key).fold(work, |all: List<Bytes>, id: Bytes| all.push(id)),
        }),
    }
  })

fn deleted(key: Bytes) -> Unit / {memo_store.read, memo_store.write, abort.raise} =
  deleted_all([key])

fn edges_updated(
  key: Bytes,
  before: List<Dependency>,
  after: List<Dependency>,
) -> Unit / {memo_store.read, memo_store.write, abort.raise} = {
  let old = dependency_ids(before);
  let new = dependency_ids(after);
  new.keys().fold((), |_: Unit, id: Bytes|
    if !old.contains(id) { memo_store.add_dependent(id, key) });
  deleted_all(
    old.keys().fold([], |gone: List<Bytes>, id: Bytes|
      if new.contains(id) { gone } else {
        memo_store.remove_dependent(id, key);
        if released(id) { gone.push(id) } else { gone }
      }),
  )
}

fn details_before(fact: Option<StoredFact>) -> Option<FactDetails> / {memo_store.read} =
  match fact { Some(f) -> memo_store.details(f.details), None -> None }

fn reads_in(details: Option<FactDetails>) -> List<Dependency> =
  match details { Some(d) -> d.reads, None -> [] }

fn wrote_in(details: Option<FactDetails>) -> List<Bytes> =
  match details { Some(d) -> d.wrote.map(|w: WrittenFact| w.key), None -> [] }

fn still_written(writer: Bytes, wrote: List<Bytes>) -> List<Bytes> / {memo_store.read} =
  wrote.filter(|k: Bytes|
    match memo_store.fact(k) { Some(f) -> f.written_by == writer, None -> false })

pub fn in_session<a | e>(
  queries: Queries<| e>,
  work: (Run) -> { run: Run, value: a } / {memo_store.read, memo_store.write, abort.raise | e},
) -> a / {memo_store.read, memo_store.write, abort.raise | e} = {
  let done = work(updated_run(queries));
  recomputed(queries, done.run);
  done.value
}

pub fn in_session_of<| e>(
  queries: Queries<| e>,
  name: Bytes,
  input: Bytes,
) -> Bytes / {memo_store.read, memo_store.write, abort.raise | e} =
  in_session(queries, |run: Run| reading(queries, run, || memo.fetch(name, input)))

pub fn reading<a | e>(
  queries: Queries<| e>,
  run: Run,
  body: () -> a / {memo.read, abort.raise | e},
) -> { run: Run, value: a } / {memo_store.read, memo_store.write, abort.raise | e} =
  handle {
    body()
  } with {
    var at = run,
    memo.external(kind, place) -> memo_store.external(kind, place).value,
    memo.fetch(name, input) -> {
      let a = query_output(queries, at, name, input);
      at = a.run;
      a.output
    },
    memo.output_digest(name, input) -> {
      let a = query_output(queries, at, name, input);
      at = a.run;
      digest_of(Some(a.output))
    },
    memo.fetch_all(name, inputs) -> {
      let a = query_outputs(queries, at, name, inputs);
      at = a.run;
      a.outputs
    },
    memo.stored_output(digest) -> memo_store.output(digest),
    return value -> { run: at, value: value },
  }

fn updated_run<| e>(
  queries: Queries<| e>,
) -> Run / {memo_store.read, memo_store.write, abort.raise | e} = {
  memo_store.running(queries_id(queries));
  memo_store.defer_products(
    queries.named.fold(Map::new(), |found: Map<Bytes, Bytes>, name: Bytes, q: Query<| e>|
      match q.product { Some(p) -> found.insert(query_prefix(name), p.kind), None -> found }),
  );
  marked_for_new_code(queries);
  marked_for_new_inputs();
  recomputed(queries, new_run)
}

fn marked_for_new_code<| e>(
  queries: Queries<| e>,
) -> Unit / {memo_store.read, memo_store.write, abort.raise} =
  queries.named.fold((), |_: Unit, name: Bytes, q: Query<| e>|
    if memo_store.code(name) != Some(q.hash) {
      memo_store.note_edit();
      let stale = memo_store.facts_of(query_prefix(name));
      if q.product != None { deleted_all(stale) }
      else { stale.fold((), |_: Unit, key: Bytes| marked(key)) };
      memo_store.put_code(name, q.hash)
    })

fn marked_for_new_inputs() -> Unit / {memo_store.read, memo_store.write, abort.raise} = {
  let sealed_may_differ = memo_store.sealed_changed();
  memo_store.inputs().fold((), |_: Unit, stored: StoredInput|
    if stored.kind == sealed_kind {
      if sealed_may_differ {
        let now = match memo_store.sealed(stored.at) { Some(d) -> d, None -> b"" };
        if now != stored.digest {
          memo_store.note_edit();
          memo_store.put_input({ ..stored, digest: now });
          marked_dependents(stored.at)
        }
      }
    } else if !stored.fixed {
      let now = memo_store.external(stored.kind, stored.at).digest;
      if now != stored.digest {
        memo_store.note_edit();
        memo_store.put_input({ ..stored, digest: now });
        marked_dependents(location_id(stored.kind, stored.at))
      }
    })
}

fn recomputed<| e>(
  queries: Queries<| e>,
  run: Run,
) -> Run / {memo_store.read, memo_store.write, abort.raise | e} =
  iterate(run, 1099511627776, |r: Run|
    match memo_store.out_of_date_level() {
      [] -> Stop(r),
      [next] -> Continue(recompute(queries, r, next.key)),
      level -> Continue(recomputed_level(queries, r, level)),
    })

fn recomputed_level<| e>(
  queries: Queries<| e>,
  run: Run,
  level: List<Waited>,
) -> Run / {memo_store.read, memo_store.write, abort.raise | e} = {
  let steps = level.fold([], |found: List<Step>, w: Waited|
    match details_before(memo_store.fact(w.key)) {
      Some(d) -> if recomputable(queries, w.key, d) {
        found.push({ query: d.query, input: d.input })
      } else { found },
      None -> found,
    });
  let done = computed_together(
    queries,
    run,
    steps,
    |r: Run, s: Step| recompute(queries, r, fact_key(s.query, s.input)),
    100000,
  );
  level.fold(done, |r: Run, w: Waited|
    if memo_store.is_out_of_date(w.key) { recompute(queries, r, w.key) } else { r })
}

fn recomputable<| e>(
  queries: Queries<| e>,
  key: Bytes,
  d: FactDetails,
) -> Bool / {memo_store.read} =
  match ((memo_store.fact(key), queries.named.get(d.query))) {
    (Some(f), Some(q)) -> f.written_by == b"" && q.product == None,
    _ -> false,
  }

fn recompute<| e>(
  queries: Queries<| e>,
  run: Run,
  key: Bytes,
) -> Run / {memo_store.read, memo_store.write, abort.raise | e} =
  match memo_store.fact(key) {
    None -> {
      memo_store.settle(key);
      run
    },
    Some(f) -> match memo_store.details(f.details) {
      None -> {
        deleted(key);
        run
      },
      Some(d) -> match queries.named.get(d.query) {
        None -> {
          deleted(key);
          run
        },
        Some(q) -> if f.written_by != b"" {
          memo_store.settle(key);
          run
        } else {
          let attempt = handle {
            Some(run_opened(queries, run, q, key, d.input, true, 100000).run)
          } with {
            abort.raise(_) -> None,
          };
          match attempt {
            Some(done) -> done,
            None -> {
              deleted(key);
              { ..run, resolved: Map::new(), open: Map::new(), lowest_open: None, trail: Started }
            },
          }
        },
      },
    },
  }

fn kind_caught_up<| e>(
  queries: Queries<| e>,
  run: Run,
  kind: Bytes,
) -> Run / {memo_store.read, memo_store.write, abort.raise | e} =
  if run.caught_up.contains(kind) { run } else {
    let of_kind = |key: Bytes| memo_store.deferred_kind(key) == Some(kind);
    memo_store.logged_changes(kind).fold((), |_: Unit, key: Bytes| {
      if of_kind(key) { marked(key) };
      memo_store.dependents(key).fold((), |_: Unit, d: Bytes| if of_kind(d) { marked(d) })
    });
    memo_store.push_products(kind);
    let done = recomputed(queries, { ..run, caught_up: run.caught_up.insert(kind, true) });
    memo_store.log_read(kind);
    done
  }

fn product_caught_up<| e>(
  queries: Queries<| e>,
  run: Run,
  product: Product,
) -> Run / {memo_store.read, memo_store.write, abort.raise | e} =
  kind_caught_up(
    queries,
    product.after.fold(run, |r: Run, kind: Bytes| kind_caught_up(queries, r, kind)),
    product.kind,
  )

pub fn query_output<| e>(
  queries: Queries<| e>,
  run: Run,
  name: Bytes,
  input: Bytes,
) -> QueryResult / {memo_store.read, memo_store.write, abort.raise | e} = {
  let a = query_outputs(queries, run, name, [input]);
  { run: a.run, output: a.outputs.get(0) }
}

pub type QueryResults = { run: Run, outputs: List<Bytes> }

pub fn query_outputs<| e>(
  queries: Queries<| e>,
  run: Run,
  name: Bytes,
  inputs: List<Bytes>,
) -> QueryResults / {memo_store.read, memo_store.write, abort.raise | e} = {
  let q = query_of(queries, name);
  let ready = match q.product { Some(p) -> product_caught_up(queries, run, p), None -> run };
  let { run: fetched_run, fetched } = fetched_together(queries, ready, q, inputs, 100000);
  let outputs = fetched.map(|f: Fetched| f.output);
  { run: with_requested(fetched_run, fetched), outputs: outputs }
}

fn with_ran(run: Run, step: Step) -> Run = {
  let { resolved, requested_dependencies, open, lowest_open, trail, took, ran, inputs, lost, caught_up } = run;
  {
    resolved: resolved,
    requested_dependencies: requested_dependencies,
    open: open,
    lowest_open: lowest_open,
    trail: trail,
    took: took,
    lost: lost,
    caught_up: caught_up,
    ran: incremented(ran, step.query),
    inputs: inputs.push(step),
  }
}

fn with_requested(run: Run, fetched: List<Fetched>) -> Run = {
  let { resolved, requested_dependencies, open, lowest_open, trail, took, ran, inputs, lost, caught_up } = run;
  {
    resolved: resolved,
    open: open,
    lowest_open: lowest_open,
    trail: trail,
    took: took,
    ran: ran,
    inputs: inputs,
    lost: lost,
    caught_up: caught_up,
    requested_dependencies: fetched.fold(
      requested_dependencies,
      |all: List<Dependency>, f: Fetched| all.push(QueryDependency(f.key, f.at.digest)),
    ),
  }
}

type Fetched = { key: Bytes, output: Bytes, at: Settled }

fn fetched_together<| e>(
  queries: Queries<| e>,
  run: Run,
  q: Query<| e>,
  inputs: List<Bytes>,
  left: Int,
) -> { run: Run, fetched: List<Fetched> } / {memo_store.read, memo_store.write, abort.raise | e} = {
  let one = |r: Run, input: Bytes| fetched(queries, r, q, key_of(q, input), input, left - 1);
  let computed = computed_together(
    queries,
    run,
    inputs.map(|input: Bytes| { query: q.name, input: input }),
    |r: Run, s: Step| one(r, s.input).run,
    left - 1,
  );
  inputs.fold(
    { run: computed, fetched: [] },
    |sofar: { run: Run, fetched: List<Fetched> }, input: Bytes| {
      let a = one(sofar.run, input);
      {
        run: a.run,
        fetched: sofar.fetched.push({ key: key_of(q, input), output: a.output, at: a.at }),
      }
    },
  )
}

fn fetched<| e>(
  queries: Queries<| e>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  left: Int,
) -> { run: Run, output: Bytes, at: Settled } / {memo_store.read, memo_store.write, abort.raise | e} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep)) } else {
    let s = settled(queries, run, q, key, input, left - 1);
    match memo_store.output(s.at.digest) {
      Some(o) -> { run: s.run, output: o, at: s.at },
      None -> {
        let e = run_opened(queries, s.run, q, key, input, false, left - 1);
        if e.at.digest != s.at.digest {
          panic(
            "the query `" ++ String::of_bytes_lossy(q.name)
              ++ "` returned a different result when run again after its stored result was lost: its body reads data that is not part of its input",
          )
        };
        {
          run: {
            ..e.run,
            lost: if q.persistent { incremented(e.run.lost, q.name) } else { e.run.lost },
          },
          output: match memo_store.output(e.at.digest) {
            Some(o) -> o,
            None -> panic("the store does not contain a result that was just saved to its cache"),
          },
          at: e.at,
        }
      },
    }
  }

fn remembered(run: Run, name: Bytes, key: Bytes, at: Settled) -> { run: Run, at: Settled } =
  {
    run: { ..run, took: incremented(run.took, name), resolved: run.resolved.insert(key, at) },
    at: at,
  }

fn settled<| e>(
  queries: Queries<| e>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  left: Int,
) -> { run: Run, at: Settled } / {memo_store.read, memo_store.write, abort.raise | e} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep)) }
  else if run.open.contains(key) { report_cycle(run, { query: q.name, input: input }) } else {
    match known(run, q.name, key) {
      Some(a) -> a,
      None -> if memo_store.is_out_of_date(key) {
        run_opened(queries, run, q, key, input, true, left)
      } else {
        match memo_store.fact(key) {
          None -> run_opened(queries, run, q, key, input, true, left),
          Some(f) -> if writer_out_of_date(f) {
            settled(
              queries,
              writer_settled(queries, run, f.written_by, left - 1),
              q,
              key,
              input,
              left - 1,
            )
          } else { report_cycle(run, { query: q.name, input: input }) },
        }
      },
    }
  }

fn writer_out_of_date(f: StoredFact) -> Bool / {memo_store.read} =
  f.written_by != b"" && memo_store.is_out_of_date(f.written_by)

fn known(
  run: Run,
  name: Bytes,
  key: Bytes,
) -> Option<{ run: Run, at: Settled }> / {memo_store.read, abort.raise} =
  if run.open.contains(key) || memo_store.is_out_of_date(key) { None } else {
    match run.resolved.get(key) {
      Some(at) -> Some({ run: run, at: at }),
      None -> match memo_store.sealed(key) {
        Some(digest) ->
          Some(remembered(run, name, key, { digest: digest, depth: 0, sealed: true })),
        None -> match memo_store.fact(key) {
          None -> None,
          Some(f) -> if writer_out_of_date(f) || reaches_open(run, key, f) { None } else {
            Some(remembered(run, name, key, { digest: f.output, depth: f.depth, sealed: false }))
          },
        },
      },
    }
  }

fn reaches_open(run: Run, key: Bytes, fact: StoredFact) -> Bool / {memo_store.read, abort.raise} =
  match run.lowest_open {
    None -> false,
    Some(lowest) -> if fact.depth <= lowest { false } else {
      iterate(
        { work: [{ key: key, fact: fact }], next: 0, seen: Map::new() },
        1099511627776,
        |walk: { work: List<{ key: Bytes, fact: StoredFact }>, next: Int, seen: Map<Bytes, Bool> }| {
          let { work, next, seen } = walk;
          match work.at(next) {
            None -> Stop(false),
            Some(found) -> if run.open.contains(found.key) { Stop(true) }
            else if seen.contains(found.key) {
              Continue({ work: work, next: next + 1, seen: seen })
            } else {
              Continue({
                next: next + 1,
                seen: seen.insert(found.key, true),
                work: reads_in(memo_store.details(found.fact.details)).fold(
                  work,
                  |all: List<{ key: Bytes, fact: StoredFact }>, r: Dependency| {
                    let below = dependency_id(r);
                    match memo_store.fact(below) {
                      Some(f) -> if f.depth >= lowest { all.push({ key: below, fact: f }) }
                      else { all },
                      None -> all,
                    }
                  },
                ),
              })
            },
          }
        },
      )
    },
  }

fn writer_settled<| e>(
  queries: Queries<| e>,
  run: Run,
  key: Bytes,
  left: Int,
) -> Run / {memo_store.read, memo_store.write, abort.raise | e} =
  match details_before(memo_store.fact(key)) {
    None -> run,
    Some(d) -> settled(queries, run, query_of(queries, d.query), key, d.input, left).run,
  }

fn run_opened<| e>(
  queries: Queries<| e>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  may_restore: Bool,
  left: Int,
) -> { run: Run, at: Settled } / {memo_store.read, memo_store.write, abort.raise | e} = {
  let step = { query: q.name, input: input };
  if run.open.contains(key) { report_cycle(run, step) } else {
    let stored_depth = match memo_store.fact(key) { Some(f) -> Some(f.depth), None -> None };
    let opened = {
      ..run,
      open: run.open.insert(key, true),
      lowest_open: match ((run.lowest_open, stored_depth)) {
        (Some(a), Some(b)) -> Some(min(a, b)),
        (Some(a), None) -> Some(a),
        (None, b) -> b,
      },
      trail: Then(run.trail, step),
    };
    let unchanged = if may_restore { product_unchanged(queries, opened, q, key, left - 1) }
    else { { run: opened, at: None } };
    let done = match unchanged.at {
      Some(at) -> { run: unchanged.run, at: at },
      None -> execute(queries, unchanged.run, q, key, input, left - 1),
    };
    {
      run: {
        ..done.run,
        resolved: done.run.resolved.insert(key, done.at),
        open: done.run.open.remove(key),
        lowest_open: run.lowest_open,
        trail: run.trail,
      },
      at: done.at,
    }
  }
}

fn reads_still_hold<| e>(
  queries: Queries<| e>,
  run: Run,
  reads: List<Dependency>,
  left: Int,
) -> { run: Run, same: Bool } / {memo_store.read, memo_store.write, abort.raise | e} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep)) } else {
    reads.fold({ run: run, same: true }, |sofar: { run: Run, same: Bool }, r: Dependency|
      if !sofar.same { sofar } else {
        match r {
          ExternalDependency(kind, at, digest) ->
            { run: sofar.run, same: memo_store.external(kind, at).digest == digest },
          QueryDependency(key, digest) -> match details_before(memo_store.fact(key)) {
            None -> { run: sofar.run, same: false },
            Some(d) -> match queries.named.get(d.query) {
              None -> { run: sofar.run, same: false },
              Some(aq) -> {
                let a = settled(queries, sofar.run, aq, key, d.input, left - 1);
                { run: a.run, same: a.at.digest == digest }
              },
            },
          },
        }
      })
  }

fn product_unchanged<| e>(
  queries: Queries<| e>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  left: Int,
) -> { run: Run, at: Option<Settled> } / {memo_store.read, memo_store.write, abort.raise | e} =
  match if q.product != None { memo_store.fact(key) } else { None } {
    None -> { run: run, at: None },
    Some(f) -> {
      let held = reads_still_hold(queries, run, reads_in(memo_store.details(f.details)), left - 1);
      if !held.same { { run: held.run, at: None } } else {
        memo_store.settle(key);
        { run: held.run, at: Some({ digest: f.output, depth: f.depth, sealed: false }) }
      }
    },
  }

fn report_cycle<a>(run: Run, step: Step) -> a / {abort.raise} =
  panic(
    "the query `" ++ String::of_bytes_lossy(step.query) ++ "` asks for its own result, through"
      ++ trail_text(Then(run.trail, step)),
  )

fn trail_text(trail: Trail) -> String / {abort.raise} =
  match trail {
    Started -> "",
    Then(before, s) ->
      trail_text(before) ++ "\n  " ++ String::of_bytes_lossy(s.query) ++ " "
        ++ String::of_bytes_lossy(s.input.slice(0, min(s.input.len(), 120))),
  }

type Execution = {
  run: Run,
  reads: List<Dependency>,
  external_reads: Map<Bytes, Bool>,
  query_reads: Map<Bytes, Bool>,
  depth: Int,
  wrote: List<WrittenFact>,
}

fn written_fact<| e>(
  queries: Queries<| e>,
  s: Execution,
  writer: Bytes,
  name: Bytes,
  input: Bytes,
  output: Bytes,
) -> Execution / {memo_store.read, memo_store.write, abort.raise} = {
  let q = query_of(queries, name);
  let key = key_of(q, input);
  let digest = digest_of(Some(output));
  let stored = memo_store.fact(key);
  let written = encoded_details({ query: name, code: q.hash, input: input, reads: [], wrote: [] });
  let depth = s.depth + 1;
  let put = ||
    memo_store.put(
      key,
      { output: digest, details: written.digest, depth: depth, written_by: writer },
      written.details,
      written.encoded,
      output,
      q.persistent,
    );
  match stored {
    Some(f) -> if f.output == digest && f.written_by == writer {
      memo_store.keep_output(digest, output, q.persistent)
    } else {
      edges_updated(key, reads_in(details_before(stored)), []);
      if f.output != digest { marked_dependents(key) };
      put()
    },
    None -> put(),
  };
  let { run, reads, external_reads, query_reads, depth: reached, wrote } = s;
  {
    run: run,
    reads: reads,
    external_reads: external_reads,
    query_reads: query_reads,
    depth: reached,
    wrote: wrote.push({ key: key, output: digest }),
  }
}

fn recorded<| e>(
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  s: Execution,
  output: Bytes,
) -> Settled / {memo_store.read, memo_store.write, abort.raise} = {
  let digest = digest_of(Some(output));
  let depth = s.depth + 1;
  let stored = memo_store.fact(key);
  let written_already = match stored {
    Some(f) -> f.written_by != b"" && f.output == digest,
    None -> false,
  };
  if written_already {
    memo_store.keep_output(digest, output, q.persistent);
    { digest: digest, depth: depth, sealed: false }
  } else {
    {
      let before = details_before(stored);
      let details = encoded_details({
        query: q.name,
        code: q.hash,
        input: input,
        reads: s.reads,
        wrote: s.wrote,
      });
      let d = details.digest;
      edges_updated(key, reads_in(before), s.reads);
      let written = s.wrote.fold(Map::new(), |found: Map<Bytes, Bool>, w: WrittenFact|
        found.insert(w.key, true));
      still_written(key, wrote_in(before)).fold((), |_: Unit, k: Bytes|
        if !written.contains(k) { deleted(k) });
      let same_output = match stored { Some(f) -> f.output == digest, None -> false };
      let same_details = match stored { Some(f) -> f.details == d, None -> false };
      if !same_output && stored != None { marked_dependents(key) };
      if same_output && same_details { memo_store.keep_output(digest, output, q.persistent) } else {
        memo_store.put(
          key,
          { output: digest, details: d, depth: depth, written_by: b"" },
          details.details,
          details.encoded,
          output,
          q.persistent,
        )
      };
      { digest: digest, depth: depth, sealed: false }
    }
  }
}

fn execute<| e>(
  queries: Queries<| e>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  left: Int,
) -> { run: Run, at: Settled } / {memo_store.read, memo_store.write, abort.raise | e} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep)) } else {
    let ran = handle {
      (q.body)(input)
    } with {
      var st = execution_begun(run, q, input),
      memo.external(kind, at) -> {
        let w = world_read(st, kind, at);
        st = w.st;
        w.found
      },
      memo.fetch(name, query_input) -> {
        let aq = query_of(queries, name);
        let read = key_of(aq, query_input);
        let a = fetched(queries, st.run, aq, read, query_input, left - 1);
        st = fact_read({ ..st, run: a.run }, read, a.at);
        a.output
      },
      memo.fetch_all(name, inputs) -> {
        let a = fetched_together(queries, st.run, query_of(queries, name), inputs, left - 1);
        st = a.fetched.fold({ ..st, run: a.run }, |s: Execution, f: Fetched|
          fact_read(s, f.key, f.at));
        a.fetched.map(|f: Fetched| f.output)
      },
      memo.output_digest(name, query_input) -> {
        let aq = query_of(queries, name);
        let read = key_of(aq, query_input);
        let a = settled(queries, st.run, aq, read, query_input, left - 1);
        st = fact_read({ ..st, run: a.run }, read, a.at);
        a.at.digest
      },
      memo.stored_output(digest) -> memo_store.output(digest),
      memo.fix(kind, at) -> memo_store.fix_input(kind, at),
      memo.provide(name, query_input, output) -> {
        st = written_fact(queries, st, key, name, query_input, output);
      },
      memo.written_by(name, writer_input) -> {
        let wq = query_of(queries, name);
        let writer = key_of(wq, writer_input);
        let a = settled(queries, st.run, wq, writer, writer_input, left - 1);
        st = { ..st, run: a.run, depth: max(st.depth, a.at.depth) };
        match memo_store.fact(key) {
          Some(f) -> if f.written_by == writer { memo_store.output(f.output) } else { None },
          None -> None,
        }
      },
      return output -> { output: output, st: st },
    };
    execution_ended(q, key, input, ran.st, ran.output)
  }

fn execution_begun<| e>(run: Run, q: Query<| e>, input: Bytes) -> Execution =
  {
    run: with_ran(run, { query: q.name, input: input }),
    reads: [],
    external_reads: Map::new(),
    query_reads: Map::new(),
    depth: 0,
    wrote: [],
  }

fn world_read(
  s: Execution,
  kind: Bytes,
  at: Bytes,
) -> { st: Execution, found: Option<Bytes> } / {memo_store.read, memo_store.write, abort.raise} = {
  let read = memo_store.external(kind, at);
  let d = read.digest;
  let seen = location_id(kind, at).concat(d);
  let { run, reads, external_reads, query_reads, depth, wrote } = s;
  let held = external_reads.contains(seen);
  if !held { memo_store.put_input({ kind: kind, at: at, digest: d, fixed: false }) };
  {
    found: read.value,
    st: {
      run: run,
      query_reads: query_reads,
      depth: depth,
      wrote: wrote,
      external_reads: if held { external_reads } else { external_reads.insert(seen, true) },
      reads: if held { reads } else { reads.push(ExternalDependency(kind, at, d)) },
    },
  }
}

fn fact_read(s: Execution, read: Bytes, at: Settled) -> Execution / {memo_store.write} = {
  if at.sealed {
    memo_store.put_input({ kind: sealed_kind, at: read, digest: at.digest, fixed: false })
  };
  if s.query_reads.contains(read) { { ..s, depth: max(s.depth, at.depth) } } else {
    let { run, reads, external_reads, query_reads, depth, wrote } = s;
    {
      run: run,
      external_reads: external_reads,
      wrote: wrote,
      depth: max(depth, at.depth),
      query_reads: query_reads.insert(read, true),
      reads: reads.push(QueryDependency(read, at.digest)),
    }
  }
}

fn execution_ended<| e>(
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  s: Execution,
  output: Bytes,
) -> { run: Run, at: Settled } / {memo_store.read, memo_store.write, abort.raise} = {
  let at = recorded(q, key, input, s, output);
  if memo_store.is_out_of_date(key) && !reads_moved(s) { memo_store.settle(key) };
  { run: s.run, at: at }
}

fn reads_moved(s: Execution) -> Bool =
  s.reads.any(|r: Dependency|
    match r {
      QueryDependency(key, digest) -> match s.run.resolved.get(key) {
        Some(at) -> at.digest != digest,
        None -> false,
      },
      ExternalDependency(_, _, _) -> false,
    })

type Snapshot = {
  facts: Map<Bytes, Settled>,
  outputs: Map<Bytes, Bytes>,
  world: Map<Bytes, InputRead>,
}

const empty_snapshot: Snapshot = { facts: Map::new(), outputs: Map::new(), world: Map::new() }

type Wanted = | WantedFact(Bytes, Bytes) | WantedWorld(Bytes, Bytes)

type Performed =
  | ReadWorld(Bytes, Bytes)
  | ReadFact(Bytes)
  | Fixed(Bytes, Bytes)
  | Provided(Bytes, Bytes, Bytes)

type Attempt = | Finished(Bytes, List<Performed>) | Needed(Wanted) | Unfinished

derive bin for Wanted

derive bin for Performed

derive bin for Attempt

effect unsettled {
  raise needed(wanted: Wanted)
  raise unfinished()
}

type Known = { run: Run, snapshot: Snapshot, added: Bool }

fn opened_for(run: Run, waiting: List<Step>) -> Run / {memo_store.read, abort.raise} =
  waiting.fold(run, |r: Run, s: Step| {
    let key = fact_key(s.query, s.input);
    {
      ..r,
      open: r.open.insert(key, true),
      lowest_open: match ((r.lowest_open, memo_store.fact(key))) {
        (Some(a), Some(f)) -> Some(min(a, f.depth)),
        (None, Some(f)) -> Some(f.depth),
        (lowest, None) -> lowest,
      },
    }
  })

fn with_wanted(k: Known, wanted: Wanted) -> Known / {memo_store.read, abort.raise} =
  match wanted {
    WantedWorld(kind, at) -> {
      let id = location_id(kind, at);
      if k.snapshot.world.contains(id) { k } else {
        let read = memo_store.external(kind, at);
        { ..k, snapshot: { ..k.snapshot, world: k.snapshot.world.insert(id, read) }, added: true }
      }
    },
    WantedFact(name, input) -> {
      let key = fact_key(name, input);
      if k.snapshot.facts.contains(key) { k } else {
        match known(k.run, name, key) {
          None -> k,
          Some(a) -> match memo_store.output(a.at.digest) {
            None -> { ..k, run: a.run },
            Some(o) ->
              {
                run: a.run,
                snapshot: {
                  ..k.snapshot,
                  facts: k.snapshot.facts.insert(key, a.at),
                  outputs: k.snapshot.outputs.insert(a.at.digest, o),
                },
                added: true,
              },
          },
        }
      }
    },
  }

fn grown(
  run: Run,
  snapshot: Snapshot,
  wanted: List<Wanted>,
  waiting: List<Step>,
) -> Known / {memo_store.read, abort.raise} = {
  let k = wanted.fold(
    { run: opened_for(run, waiting), snapshot: snapshot, added: false },
    with_wanted,
  );
  { ..k, run: { ..k.run, open: run.open, lowest_open: run.lowest_open } }
}

fn predicted(key: Bytes) -> List<Wanted> / {memo_store.read} =
  reads_in(details_before(memo_store.fact(key))).fold([], |found: List<Wanted>, r: Dependency|
    match r {
      ExternalDependency(kind, at, _) -> found.push(WantedWorld(kind, at)),
      QueryDependency(read, _) -> match details_before(memo_store.fact(read)) {
        Some(d) -> found.push(WantedFact(d.query, d.input)),
        None -> found,
      },
    })

fn still_held(run: Run, snapshot: Snapshot) -> Snapshot / {memo_store.read} =
  {
    ..snapshot,
    facts: snapshot.facts.fold(Map::new(), |held: Map<Bytes, Settled>, key: Bytes, at: Settled|
      if run.resolved.get(key) == Some(at) && !memo_store.is_out_of_date(key) {
        held.insert(key, at)
      } else { held }),
  }

fn computable<| e>(
  queries: Queries<| e>,
  run: Run,
  s: Step,
) -> Bool / {memo_store.read, abort.raise} = {
  let q = query_of(queries, s.query);
  let key = key_of(q, s.input);
  if run.open.contains(key) { false } else if memo_store.is_out_of_date(key) {
    q.product == None
      && (match memo_store.fact(key) { Some(f) -> f.written_by == b"", None -> true })
  } else {
    !run.resolved.contains(key) && memo_store.sealed(key) == None && memo_store.fact(key) == None
  }
}

type Round = { run: Run, snapshot: Snapshot, waiting: List<Step> }

fn computed_together<| e>(
  queries: Queries<| e>,
  run: Run,
  steps: List<Step>,
  serially: (Run, Step) -> Run / {memo_store.read, memo_store.write, abort.raise | e},
  left: Int,
) -> Run / {memo_store.read, memo_store.write, abort.raise | e} =
  if steps.len() < 2 { run }
  else if left <= 0 { panic(String::of_bytes_lossy(too_deep)) } else {
    let waiting = steps.fold(
      { seen: Map::new(), found: [] },
      |w: { seen: Map<Bytes, Bool>, found: List<Step> }, s: Step| {
        let key = fact_key(s.query, s.input);
        let { seen, found } = w;
        if seen.contains(key) || !computable(queries, run, s) { { seen: seen, found: found } }
        else { { seen: seen.insert(key, true), found: found.push(s) } }
      },
    ).found;
    let first = grown(
      run,
      empty_snapshot,
      waiting.flat_map(|s: Step| predicted(fact_key(s.query, s.input))),
      waiting,
    );
    iterate(
      { run: first.run, snapshot: first.snapshot, waiting: waiting },
      1099511627776,
      |r: Round|
        match r.waiting {
          [] -> Stop(r.run),
          [only] ->
            Stop(if computable(queries, r.run, only) { serially(r.run, only) } else { r.run }),
          _ -> Continue(next_round(queries, r, serially)),
        },
    )
  }

type Pass = {
  run: Run,
  snapshot: Snapshot,
  again: List<Step>,
  siblings: List<Wanted>,
  progressed: Bool,
}

fn next_round<| e>(
  queries: Queries<| e>,
  r: Round,
  serially: (Run, Step) -> Run / {memo_store.read, memo_store.write, abort.raise | e},
) -> Round / {memo_store.read, memo_store.write, abort.raise | e} = {
  let seen = still_held(r.run, r.snapshot);
  let attempts = attempted_apart(queries, seen, r.waiting);
  let waiting_keys = r.waiting.fold(Map::new(), |m: Map<Bytes, Bool>, s: Step|
    m.insert(fact_key(s.query, s.input), true));
  let passed = range(0, r.waiting.len()).fold(
    { run: r.run, snapshot: seen, again: [], siblings: [], progressed: false },
    |p: Pass, i: Int| {
      let s = r.waiting.get(i);
      let { run, snapshot, again, siblings, progressed } = p;
      if !computable(queries, run, s) {
        { run: run, snapshot: snapshot, again: again, siblings: siblings, progressed: true }
      } else {
        match attempts.get(i) {
          Unfinished ->
            {
              run: serially(run, s),
              snapshot: snapshot,
              again: again,
              siblings: siblings,
              progressed: true,
            },
          Finished(output, performed) -> {
            if any_read_moved(run, seen, performed) {
              {
                run: run,
                snapshot: snapshot,
                siblings: siblings,
                progressed: progressed,
                again: again.push(s),
              }
            } else {
              let q = query_of(queries, s.query);
              {
                run: replayed(
                  queries,
                  run,
                  q,
                  key_of(q, s.input),
                  s.input,
                  seen,
                  output,
                  performed,
                ),
                snapshot: snapshot,
                again: again,
                siblings: siblings,
                progressed: true,
              }
            }
          },
          Needed(wanted) -> {
            let k = grown(run, snapshot, [wanted], r.waiting);
            let sibling = match wanted {
              WantedFact(name, input) -> waiting_keys.contains(fact_key(name, input)),
              WantedWorld(_, _) -> false,
            };
            if k.added {
              {
                run: k.run,
                snapshot: k.snapshot,
                siblings: siblings,
                progressed: true,
                again: again.push(s),
              }
            } else if sibling {
              {
                run: k.run,
                snapshot: k.snapshot,
                progressed: progressed,
                again: again.push(s),
                siblings: siblings.push(wanted),
              }
            } else {
              {
                run: serially(k.run, s),
                snapshot: k.snapshot,
                again: again,
                siblings: siblings,
                progressed: true,
              }
            }
          },
        }
      }
    },
  );
  let after = grown(passed.run, passed.snapshot, passed.siblings, passed.again);
  if passed.progressed || after.added {
    { run: after.run, snapshot: after.snapshot, waiting: passed.again }
  } else {
    {
      run: passed.again.fold(after.run, |run: Run, s: Step|
        if computable(queries, run, s) { serially(run, s) } else { run }),
      snapshot: after.snapshot,
      waiting: [],
    }
  }
}

const pieces: Int = 64

fn attempted_apart<| e>(
  queries: Queries<| e>,
  snapshot: Snapshot,
  steps: List<Step>,
) -> List<Attempt> / {abort.raise} =
  attempted_pieces(
    queries,
    snapshot,
    steps,
    0,
    steps.len(),
    max(1, (steps.len() + pieces - 1) / pieces),
    pieces,
  ).fold([], |all: List<Attempt>, packed: Bytes|
    match bin::decode(packed, bin::list_bin(attempt_bin())) {
      Ok(attempts) -> all.concat(attempts),
      Err(_) ->
        panic("the attempts of a piece of facts could not be decoded after they were encoded"),
    })

fn attempted_pieces<| e>(
  queries: Queries<| e>,
  snapshot: Snapshot,
  steps: List<Step>,
  lo: Int,
  hi: Int,
  grain: Int,
  splits_left: Int,
) -> List<Bytes> / {abort.raise} =
  if hi - lo <= grain || splits_left <= 0 {
    [
      (queries.apart)(||
        bin::encode(
          range(lo, hi).map(|i: Int| attempted(queries, snapshot, steps.get(i))),
          bin::list_bin(attempt_bin()),
        )),
    ]
  } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      attempted_pieces(queries, snapshot, steps, lo, mid, grain, splits_left - 1),
      attempted_pieces(queries, snapshot, steps, mid, hi, grain, splits_left - 1),
    };
    halves._0.concat(halves._1)
  }

fn attempted<| e>(queries: Queries<| e>, snapshot: Snapshot, step: Step) -> Attempt / e =
  match queries.named.get(step.query) {
    None -> Unfinished,
    Some(q) -> handle {
      handle {
        attempted_body(q, snapshot, step.input)
      } with {
        unsettled.needed(wanted) -> Needed(wanted),
        unsettled.unfinished() -> Unfinished,
      }
    } with {
      abort.raise(_) -> Unfinished,
    },
  }

fn snapshot_output(
  snapshot: Snapshot,
  name: Bytes,
  input: Bytes,
) -> Bytes / {unsettled.needed, abort.raise} =
  match snapshot.facts.get(fact_key(name, input)) {
    Some(at) -> match snapshot.outputs.get(at.digest) {
      Some(o) -> o,
      None -> unsettled.needed(WantedFact(name, input)),
    },
    None -> unsettled.needed(WantedFact(name, input)),
  }

fn attempted_body<| e>(
  q: Query<| e>,
  snapshot: Snapshot,
  input: Bytes,
) -> Attempt / {unsettled.needed, unsettled.unfinished, abort.raise | e} =
  handle {
    (q.body)(input)
  } with {
    var performed: List<Performed> = [],
    memo.external(kind, at) -> match snapshot.world.get(location_id(kind, at)) {
      Some(l) -> {
        performed = performed.push(ReadWorld(kind, at));
        l.value
      },
      None -> unsettled.needed(WantedWorld(kind, at)),
    },
    memo.fetch(name, read) -> {
      let o = snapshot_output(snapshot, name, read);
      performed = performed.push(ReadFact(fact_key(name, read)));
      o
    },
    memo.fetch_all(name, reads) -> {
      let found = reads.map(|read: Bytes| snapshot_output(snapshot, name, read));
      performed = reads.fold(performed, |p: List<Performed>, read: Bytes|
        p.push(ReadFact(fact_key(name, read))));
      found
    },
    memo.output_digest(name, read) -> match snapshot.facts.get(fact_key(name, read)) {
      Some(at) -> {
        performed = performed.push(ReadFact(fact_key(name, read)));
        at.digest
      },
      None -> unsettled.needed(WantedFact(name, read)),
    },
    memo.stored_output(digest) -> match snapshot.outputs.get(digest) {
      Some(o) -> Some(o),
      None -> unsettled.unfinished(),
    },
    memo.provide(name, provided, output) -> {
      performed = performed.push(Provided(name, provided, output));
    },
    memo.written_by(_, _) -> unsettled.unfinished(),
    memo.fix(kind, at) -> {
      performed = performed.push(Fixed(kind, at));
    },
    return output -> Finished(output, performed),
  }

fn any_read_moved(
  run: Run,
  snapshot: Snapshot,
  performed: List<Performed>,
) -> Bool / {memo_store.read} =
  performed.fold(false, |moved: Bool, p: Performed| moved || read_moved(run, snapshot, p))

fn read_moved(run: Run, snapshot: Snapshot, p: Performed) -> Bool / {memo_store.read} =
  match p {
    ReadFact(read) ->
      snapshot.facts.get(read) != run.resolved.get(read) || memo_store.is_out_of_date(read),
    _ -> false,
  }

fn replayed<| e>(
  queries: Queries<| e>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  snapshot: Snapshot,
  output: Bytes,
  performed: List<Performed>,
) -> Run / {memo_store.read, memo_store.write, abort.raise} = {
  let s = performed.fold(execution_begun(run, q, input), |s: Execution, p: Performed|
    match p {
      ReadWorld(kind, at) -> world_read(s, kind, at).st,
      ReadFact(read) -> match snapshot.facts.get(read) {
        Some(at) -> fact_read(s, read, at),
        None -> s,
      },
      Fixed(kind, at) -> {
        memo_store.fix_input(kind, at);
        s
      },
      Provided(name, provided, value) -> written_fact(queries, s, key, name, provided, value),
    });
  let { run: done, at } = execution_ended(q, key, input, s, output);
  { ..done, resolved: done.resolved.insert(key, at) }
}

pub fn packs_fact(wanted: Map<Bytes, Bool>, query: Bytes, writer: Option<Bytes>) -> Bool =
  wanted.contains(query) || (match writer { Some(w) -> wanted.contains(w), None -> false })

fn writer_query(f: StoredFact) -> Option<Bytes> / {memo_store.read} =
  if f.written_by == b"" { None } else {
    match details_before(memo_store.fact(f.written_by)) { Some(w) -> Some(w.query), None -> None }
  }

pub fn reachable_keys<| e>(
  queries: Queries<| e>,
  wanted: Map<Bytes, Bool>,
  run: Run,
) -> List<Bytes> / {memo_store.read, abort.raise} = {
  let query_keys = |reads: List<Dependency>|
    reads.fold([], |keys: List<Bytes>, r: Dependency|
      match r { QueryDependency(key, _) -> keys.push(key), ExternalDependency(_, _, _) -> keys });
  iterate(
    { seen: Map::new(), work: query_keys(run.requested_dependencies), next: 0, keys: [] },
    1099511627776,
    |x: { seen: Map<Bytes, Bool>, work: List<Bytes>, next: Int, keys: List<Bytes> }| {
      let { seen, work, next, keys } = x;
      match work.at(next) {
        None -> Stop(keys),
        Some(key) -> if seen.contains(key) {
          Continue({ seen: seen, work: work, next: next + 1, keys: keys })
        } else {
          let marked_seen = seen.insert(key, true);
          match details_before(memo_store.fact(key)) {
            None -> Continue({ seen: marked_seen, work: work, next: next + 1, keys: keys }),
            Some(d) -> {
              let packed = packs_fact(wanted, d.query, match memo_store.fact(key) {
                Some(f) -> writer_query(f),
                None -> None,
              });
              Continue({
                seen: marked_seen,
                next: next + 1,
                keys: if packed { keys.push(key) } else { keys },
                work: query_keys(d.reads).concat(wrote_in(Some(d))).fold(
                  work,
                  |all: List<Bytes>, read: Bytes| all.push(read),
                ),
              })
            },
          }
        },
      }
    },
  )
}

pub type Waiting = {
  depths: Map<Bytes, Int>,
  order: Map<Bytes, Bool>,
  products: Map<Bytes, Bytes>,
  pushing: Map<Bytes, Bool>,
}

pub type Waited = { key: Bytes, depth: Int }

pub const nothing_waiting: Waiting =
  { depths: Map::new(), order: Map::new(), products: Map::new(), pushing: Map::new() }

pub fn deferred_kind(w: Waiting, key: Bytes) -> Option<Bytes> / {abort.raise} =
  match w.products.get(key.slice(0, 4)) {
    Some(kind) -> if w.pushing.contains(kind) { None } else { Some(kind) },
    None -> None,
  }

pub fn nothing_left_waiting(w: Waiting) -> Unit / {abort.raise} =
  if w.depths.len() > 0 { panic("a run reached its commit with facts still out of date") }

fn waiting_name(depth: Int, key: Bytes) -> Bytes = u64_be(depth).concat(key)

pub fn with_mark(w: Waiting, key: Bytes, depth: Int) -> Waiting = {
  let unmarked = without_mark(w, key);
  {
    ..unmarked,
    depths: unmarked.depths.insert(key, depth),
    order: unmarked.order.insert(waiting_name(depth, key), true),
  }
}

pub fn without_mark(w: Waiting, key: Bytes) -> Waiting =
  match w.depths.get(key) {
    None -> w,
    Some(d) -> { ..w, depths: w.depths.remove(key), order: w.order.remove(waiting_name(d, key)) },
  }

pub fn first_waiting(w: Waiting) -> Option<Waited> / {abort.raise} =
  match w.order.range(None, true, None, true, 1) {
    [first, ..] -> {
      let key = first.key.slice(8, first.key.len());
      Some({ key: key, depth: match w.depths.get(key) { Some(d) -> d, None -> 0 } })
    },
    [] -> None,
  }

pub fn lowest_waiting(w: Waiting) -> List<Waited> / {abort.raise} =
  match first_waiting(w) {
    None -> [],
    Some(first) ->
      w.order.range(
        Some(u64_be(first.depth)),
        true,
        Some(u64_be(first.depth + 1)),
        false,
        w.order.len(),
      ).map(|entry: { key: Bytes, value: Bool }|
        { key: entry.key.slice(8, entry.key.len()), depth: first.depth }),
  }

fn pack_key(key: Bytes) -> Bytes = blake3(key)

pub fn pack_record_bytes(digest: Bytes, output: Option<Bytes>) -> Bytes / {abort.raise} =
  bin::encode({ digest: digest, output: output }, pack_record_bin())

type PackRecord = { digest: Bytes, output: Option<Bytes> }

derive bin for PackRecord

const inline_limit: Int = 2048

pub fn inline_output(output: Bytes) -> Option<Bytes> =
  if output.len() <= inline_limit { Some(output) } else { None }

pub fn pack_digest_of(record: Bytes) -> Option<Bytes> / {abort.raise} =
  match bin::decode(record, pack_record_bin()) { Ok(r) -> Some(r.digest), Err(_) -> None }

pub fn pack_inline_of(record: Bytes) -> Option<Bytes> / {abort.raise} =
  match bin::decode(record, pack_record_bin()) { Ok(r) -> r.output, Err(_) -> None }

pub fn sealed_lookup<| e>(
  reader: packs::PackReader,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  key: Bytes,
) -> { reading: packs::PackReader, record: Option<Bytes> } / {abort.raise | e} = {
  let found = packs::record(reader, read, pack_key(key));
  { reading: found.reading, record: found.bytes }
}

pub fn pack_row_key(key: Bytes) -> Bytes = pack_key(key)

pub type InputRead = { value: Option<Bytes>, digest: Bytes }

pub effect session_inputs {
  read held(id: Bytes) -> Option<InputRead>
  write hold(id: Bytes, read: InputRead) -> Unit
}

pub fn with_session_inputs<a | e>(
  body: () -> a / {session_inputs.read, session_inputs.write | e},
) -> a / e =
  handle {
    body()
  } with {
    var held: Map<Bytes, InputRead> = Map::new(),
    session_inputs.held(id) -> held.get(id),
    session_inputs.hold(id, read) -> {
      held = held.insert(id, read);
    },
  }

pub fn session_input<| e>(
  id: Bytes,
  read: () -> Option<Bytes> / {abort.raise | e},
) -> InputRead / {session_inputs.read, session_inputs.write, abort.raise | e} =
  match session_inputs.held(id) {
    Some(x) -> x,
    None -> {
      let value = read();
      let x = { value: value, digest: digest_of(value) };
      session_inputs.hold(id, x);
      x
    },
  }

type MemoryRun = {
  pack: packs::PackReader,
  trusted: Bool,
  transient: Map<Bytes, Bytes>,
  waiting: Waiting,
}

pub type MemoryStore = {
  facts: Map<Bytes, StoredFact>,
  details: Map<Bytes, FactDetails>,
  outputs: Map<Bytes, Bytes>,
  dependents: Map<Bytes, Map<Bytes, Bool>>,
  inputs: Map<Bytes, StoredInput>,
  codes: Map<Bytes, Bytes>,
  log: List<Bytes>,
  cursors: Map<Bytes, Int>,
  edits: Int,
  pack_id: Bytes,
}

pub const empty_memory_store: MemoryStore =
  {
    facts: Map::new(),
    details: Map::new(),
    outputs: Map::new(),
    dependents: Map::new(),
    inputs: Map::new(),
    codes: Map::new(),
    log: [],
    cursors: Map::new(),
    edits: 0,
    pack_id: b"",
  }

pub fn products_behind(store: MemoryStore) -> Bool =
  store.cursors.any(|_: Bytes, at: Int| at < store.log.len())

pub type FactRecord = { query: Bytes, input: Bytes, reads: List<Dependency>, output: Bytes }

pub fn fact_records(store: MemoryStore) -> Map<Bytes, FactRecord> =
  store.facts.fold(Map::new(), |found: Map<Bytes, FactRecord>, key: Bytes, f: StoredFact|
    match store.details.get(f.details) {
      Some(d) ->
        found.insert(key, { query: d.query, input: d.input, reads: d.reads, output: f.output }),
      None -> found,
    })

pub fn stored_outputs(store: MemoryStore) -> Map<Bytes, Bytes> =
  store.facts.fold(Map::new(), |found: Map<Bytes, Bytes>, key: Bytes, f: StoredFact|
    found.insert(key, f.output))

pub fn with_memory_store<a | e>(
  initial: MemoryStore,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_store.read, memo_store.write, abort.raise},
) -> { store: MemoryStore, value: a } / {abort.raise | e} = {
  let looked = |held: MemoryStore, kind: Bytes, at: Bytes| {
    let id = location_id(kind, at);
    session_input(id, ||
      match held.inputs.get(id) {
        Some(i) -> if i.fixed { held.outputs.get(i.digest) } else { look(kind, at) },
        None -> look(kind, at),
      })
  };
  let sealed_record = |r: MemoryRun, key: Bytes|
    if !r.trusted { { running: r, record: None } } else {
      let found = sealed_lookup(r.pack, read, key);
      { running: { ..r, pack: found.reading }, record: found.record }
    };
  with_session_inputs(||
    handle {
      work()
    } with {
      var store = initial,
      var running: MemoryRun = {
        pack: packs::open_reader(read),
        trusted: false,
        transient: Map::new(),
        waiting: nothing_waiting,
      },
      var pack_differs = false,
      var edit_noted = false,
      memo_store.fact(key) -> store.facts.get(key),
      memo_store.details(digest) -> store.details.get(digest),
      memo_store.output(digest) -> match store.outputs.get(digest) {
        Some(o) -> Some(o),
        None -> match running.transient.get(digest) {
          Some(o) -> Some(o),
          None -> {
            let found = packs::output(running.pack, read, digest);
            running = { ..running, pack: found.reading };
            found.bytes
          },
        },
      },
      memo_store.sealed(key) -> {
        let s = sealed_record(running, key);
        running = s.running;
        match s.record {
          Some(b) -> {
            match pack_inline_of(b) {
              Some(o) -> {
                running = { ..running, transient: running.transient.insert(digest_of(Some(o)), o) };
              },
              None -> (),
            };
            pack_digest_of(b)
          },
          None -> None,
        }
      },
      memo_store.sealed_changed() -> pack_differs,
      memo_store.has_dependents(key) -> store.dependents.contains(key),
      memo_store.dependents(key) -> match store.dependents.get(key) {
        Some(m) -> m.keys(),
        None -> [],
      },
      memo_store.inputs() -> store.inputs.values(),
      memo_store.facts_of(prefix) -> store.facts.keys().filter(|k: Bytes| k.starts_with(prefix)),
      memo_store.code(name) -> store.codes.get(name),
      memo_store.external(kind, at) -> looked(store, kind, at),
      memo_store.is_out_of_date(key) -> running.waiting.depths.contains(key),
      memo_store.put_fact(key, fact) -> {
        store = { ..store, facts: store.facts.insert(key, fact) };
      },
      memo_store.next_out_of_date() -> first_waiting(running.waiting),
      memo_store.out_of_date_level() -> lowest_waiting(running.waiting),
      memo_store.put(key, fact, details, _, output, lasting) -> {
        let persisted = lasting || inline_output(output) != None;
        running = if persisted { running }
        else { { ..running, transient: running.transient.insert(fact.output, output) } };
        store = {
          ..store,
          facts: store.facts.insert(key, fact),
          details: store.details.insert(fact.details, details),
          outputs: if persisted { store.outputs.insert(fact.output, output) }
          else { store.outputs },
        };
      },
      memo_store.keep_output(digest, output, lasting) -> {
        if lasting {
          store = { ..store, outputs: store.outputs.insert(digest, output) };
        } else {
          running = { ..running, transient: running.transient.insert(digest, output) };
        };
      },
      memo_store.delete(key) -> {
        running = { ..running, waiting: without_mark(running.waiting, key) };
        store = { ..store, facts: store.facts.remove(key) };
      },
      memo_store.add_dependent(key, dependent) -> {
        let listed = match store.dependents.get(key) { Some(m) -> m, None -> Map::new() };
        store = {
          ..store,
          dependents: store.dependents.insert(key, listed.insert(dependent, true)),
        };
      },
      memo_store.remove_dependent(key, dependent) -> {
        let listed = match store.dependents.get(key) { Some(m) -> m, None -> Map::new() };
        let left = listed.remove(dependent);
        store = {
          ..store,
          dependents: if left.len() == 0 { store.dependents.remove(key) }
          else { store.dependents.insert(key, left) },
        };
      },
      memo_store.put_input(input) -> {
        let id = if input.kind == sealed_kind { input.at }
        else { location_id(input.kind, input.at) };
        let fixed = match store.inputs.get(id) { Some(i) -> i.fixed, None -> false };
        if !fixed {
          store = { ..store, inputs: store.inputs.insert(id, input) };
        };
      },
      memo_store.fix_input(kind, at) -> {
        let id = location_id(kind, at);
        match session_inputs.held(id) {
          Some({ value: Some(v), digest: d }) -> {
            store = {
              ..store,
              outputs: store.outputs.insert(d, v),
              inputs: store.inputs.insert(id, { kind: kind, at: at, digest: d, fixed: true }),
            };
          },
          _ -> (),
        };
      },
      memo_store.delete_input(id) -> {
        store = { ..store, inputs: store.inputs.remove(id) };
      },
      memo_store.put_code(name, hash) -> {
        store = { ..store, codes: store.codes.insert(name, hash) };
      },
      memo_store.mark_out_of_date(key, depth) -> {
        running = { ..running, waiting: with_mark(running.waiting, key, depth) };
      },
      memo_store.settle(key) -> {
        running = { ..running, waiting: without_mark(running.waiting, key) };
      },
      memo_store.log_change(key) -> {
        store = { ..store, log: store.log.push(key) };
      },
      memo_store.note_edit() -> {
        if !edit_noted {
          store = { ..store, edits: store.edits + 1 };
        };
        edit_noted = true;
      },
      memo_store.deferred_kind(key) -> deferred_kind(running.waiting, key),
      memo_store.defer_products(kinds) -> {
        running = { ..running, waiting: { ..running.waiting, products: kinds } };
      },
      memo_store.push_products(kind) -> {
        running = {
          ..running,
          waiting: { ..running.waiting, pushing: running.waiting.pushing.insert(kind, true) },
        };
      },
      memo_store.logged_changes(kind) -> match store.cursors.get(kind) {
        Some(at) -> store.log.drop(at),
        None -> [],
      },
      memo_store.log_read(kind) -> {
        store = { ..store, cursors: store.cursors.insert(kind, store.log.len()) };
      },
      memo_store.running(id) -> {
        let trusted = match running.pack.index {
          Some(i) -> packs::is_trusted(i, id, world),
          None -> false,
        };
        let pack_id = if trusted { blake3(id.concat(world)) } else { b"" };
        pack_differs = pack_id != store.pack_id;
        store = { ..store, pack_id: pack_id };
        running = { ..running, trusted: trusted };
      },
      return value -> {
        nothing_left_waiting(running.waiting);
        { store: store, value: value }
      },
    })
}

pub fn pack_memory_store<| e>(
  store: MemoryStore,
  queries: Queries<| e>,
  files: Bytes,
) -> packs::PackFiles / {abort.raise} = {
  let records = store.facts.fold(
    { writing: packs::new_writer, placed: Map::new(), returned: Map::new() },
    |accumulator: { writing: packs::PackWriter, placed: Map<Bytes, packs::Range>, returned: Map<Bytes, Bytes> }, k: Bytes, f: StoredFact| {
      let inline = match store.outputs.get(f.output) { Some(o) -> inline_output(o), None -> None };
      let framed = packs::append_frame(accumulator.writing, pack_record_bytes(f.output, inline));
      {
        writing: framed.writing,
        placed: accumulator.placed.insert(pack_row_key(k), framed.at),
        returned: accumulator.returned.insert(pack_row_key(k), f.output),
      }
    },
  );
  let results = store.facts.fold(
    { writing: records.writing, placed: Map::new() },
    |accumulator: { writing: packs::PackWriter, placed: Map<Bytes, packs::Range> }, _: Bytes, f: StoredFact|
      match ((store.outputs.get(f.output), packs::output_key(f.output))) {
        (Some(o), Some(name)) -> if inline_output(o) != None || accumulator.placed.contains(name) {
          accumulator
        } else {
          let framed = packs::append_frame(accumulator.writing, o);
          { writing: framed.writing, placed: accumulator.placed.insert(name, framed.at) }
        },
        _ -> accumulator,
      },
  );
  packs::finish(
    results.writing,
    records.placed,
    results.placed,
    records.returned,
    queries_id(queries),
    files,
  )
}

pub fn query(
  name: Bytes,
  hash: Bytes,
  body: keep (Bytes) -> Bytes / {memo.read, memo.write, abort.raise},
) -> Query<| {}> = { name: name, hash: hash, body: body, persistent: true, product: None }

pub fn read_file(input: Bytes) -> Bytes / {memo.read} =
  match memo.external(b"file", input) { Some(text) -> text, None -> b"" }

type TestWorld = { files: Map<Bytes, Bytes>, store: MemoryStore }

fn world_of(files: List<{ at: Bytes, text: Bytes }>) -> TestWorld =
  {
    files: files.fold(Map::new(), |found: Map<Bytes, Bytes>, f: { at: Bytes, text: Bytes }|
      found.insert(f.at, f.text)),
    store: empty_memory_store,
  }

fn edited(w: TestWorld, at: Bytes, text: Bytes) -> TestWorld =
  { ..w, files: w.files.insert(at, text) }

type Answered = { output: Bytes, ran: List<Bytes>, world: TestWorld }

fn fetched_in(
  named: Map<Bytes, Query<| {}>>,
  w: TestWorld,
  name: Bytes,
  input: Bytes,
) -> Answered / {abort.raise} = {
  let queries = plain_queries(named);
  let done = with_memory_store(
    w.store,
    packs::no_pack,
    b"",
    |_: Bytes, at: Bytes| w.files.get(at),
    ||
      in_session(queries, |run: Run| {
        let a = query_output(queries, run, name, input);
        { run: a.run, value: { output: a.output, ran: a.run.inputs.map(|s: Step| s.query) } }
      }),
  );
  { output: done.value.output, ran: done.value.ran, world: { ..w, store: done.store } }
}

fn length_of(input: Bytes) -> Bytes / {memo.read} =
  Bytes::of_string(read_file(input).len().to_string())

fn length_label(input: Bytes) -> Bytes / {memo.read} = b"long ".concat(memo.fetch(b"length", input))

fn lengths(length_code: Bytes) -> Map<Bytes, Query<| {}>> =
  Map::new().insert(b"length", query(b"length", length_code, length_of)).insert(
    b"label",
    query(b"label", b"l1", length_label),
  )

const four: TestWorld = world_of([{ at: b"a", text: b"four" }])

fn fixed_reader(code: Bytes) -> Map<Bytes, Query<| {}>> =
  Map::new().insert(
    b"read",
    query(b"read", code, |input: Bytes| {
      let found = memo.external(b"file", input);
      memo.fix(b"file", input);
      match found { Some(b) -> b, None -> b"" }
    }),
  )

fn picker() -> Map<Bytes, Query<| {}>> =
  Map::new().insert(
    b"pick",
    query(b"pick", b"p1", |input: Bytes| {
      let chosen = match memo.external(b"file", input) { Some(b) -> b, None -> b"" };
      match memo.external(b"file", chosen) { Some(b) -> b, None -> b"" }
    }),
  )

test "a fixed input keeps the value it was read with, so a query that runs again reads that value" {
  let first = fetched_in(fixed_reader(b"r1"), four, b"read", b"a");
  let again = fetched_in(fixed_reader(b"r2"), edited(first.world, b"a", b"FOUR"), b"read", b"a");
  assert_eq([first.output, again.output], [b"four", b"four"])
}

test "an input that no fact reads any more is deleted" {
  let w = world_of([
    { at: b"choice", text: b"a" },
    { at: b"a", text: b"A" },
    { at: b"b", text: b"B" },
  ]);
  let first = fetched_in(picker(), w, b"pick", b"choice");
  let moved = fetched_in(picker(), edited(first.world, b"choice", b"b"), b"pick", b"choice");
  assert_eq([first.output, moved.output], [b"A", b"B"]);
  assert_eq(
    moved.world.store.inputs.values().map(|i: StoredInput| i.at).filter(|at: Bytes| at == b"a"),
    [],
  )
}

test "a key marked again at another depth moves in the queue and leaves it when it settles" {
  let moved = with_mark(with_mark(nothing_waiting, b"k", 1), b"k", 5);
  assert_eq(first_waiting(moved), Some({ key: b"k", depth: 5 }));
  assert_eq(first_waiting(without_mark(moved, b"k")), None)
}

test "a result made again that differs from its record is rejected" {
  let q = lengths(b"h1");
  let first = fetched_in(q, four, b"length", b"a");
  let unrecorded = Map::new().insert(
    b"length",
    query(b"length", b"h1", |input: Bytes| {
      let _ = memo.external(b"file", input);
      b"other"
    }),
  );
  let lost = { ..first.world, store: { ..first.world.store, outputs: Map::new() } };
  assert_eq(
    handle {
      Some(fetched_in(unrecorded, lost, b"length", b"a").output)
    } with {
      abort.raise(_) -> None,
    },
    None,
  )
}

effect looking {
  write looked_at(at: Bytes) -> Unit
}

fn doubled_length(input: Bytes) -> Bytes / {memo.read} =
  read_file(input).concat(memo.fetch(b"length", input))

fn input_looks(
  store: MemoryStore,
  input: Bytes,
) -> { store: MemoryStore, looks: List<Bytes> } / {abort.raise} = {
  let q = lengths(b"h1").insert(b"doubled", query(b"doubled", b"d1", doubled_length));
  handle {
    with_memory_store(
      store,
      packs::no_pack,
      b"",
      |_: Bytes, at: Bytes| {
        looking.looked_at(at);
        Some(at)
      },
      || in_session_of(plain_queries(q), b"doubled", input),
    ).store
  } with {
    var looks: List<Bytes> = [],
    looking.looked_at(at) -> {
      looks = looks.push(at);
    },
    return final_store -> { store: final_store, looks: looks },
  }
}

test "a run reads each input once, in the update and in every query that reads it" {
  let first = input_looks(empty_memory_store, b"a");
  assert_eq(first.looks, [b"a"]);
  assert_eq(input_looks(first.store, b"a").looks, [b"a"])
}

test "a run with no changed input runs no query" {
  let q = lengths(b"h1");
  let first = fetched_in(q, four, b"label", b"a");
  assert_eq(first.output, b"long 4");
  assert_eq(first.ran.len(), 2);
  assert_eq(fetched_in(q, first.world, b"label", b"a").ran, [])
}

test "a result that comes out the same stops a change from reaching its dependents" {
  let q = lengths(b"h1");
  let first = fetched_in(q, four, b"label", b"a");
  let same = fetched_in(q, edited(first.world, b"a", b"FOUR"), b"label", b"a");
  assert_eq(same.output, b"long 4");
  assert_eq(same.ran, [b"length"]);
  let longer = fetched_in(q, edited(same.world, b"a", b"forty"), b"label", b"a");
  assert_eq(longer.output, b"long 5");
  assert_eq(longer.ran, [b"length", b"label"])
}

test "a change reaches every stored dependent, including ones this command does not ask for" {
  let q = lengths(b"h1");
  let first = fetched_in(q, four, b"label", b"a");
  let elsewhere = fetched_in(q, edited(first.world, b"a", b"forty"), b"length", b"a");
  assert_eq(elsewhere.ran, [b"length", b"label"]);
  assert_eq(fetched_in(q, elsewhere.world, b"label", b"a").ran, [])
}

test "a query whose code changed runs again, and its dependents stop there if its result is the same" {
  let first = fetched_in(lengths(b"h1"), four, b"label", b"a");
  let moved = fetched_in(lengths(b"h2"), first.world, b"label", b"a");
  assert_eq(moved.ran, [b"length"]);
  assert_eq(fetched_in(lengths(b"h2"), moved.world, b"label", b"a").ran, [])
}

fn split_lines(input: Bytes) -> Bytes / {memo.read, memo.write, abort.raise} = {
  let lines = read_file(input).split(b"\n");
  range(0, lines.len()).fold((), |_: Unit, i: Int|
    memo.provide(b"line", input.concat(Bytes::of_string(i.to_string())), lines.get(i)));
  Bytes::of_string(lines.len().to_string())
}

fn line_of(input: Bytes) -> Bytes / {memo.write, abort.raise} =
  match memo.written_by(b"split", input.slice(0, 1)) { Some(o) -> o, None -> b"no line" }

fn line_shouted(input: Bytes) -> Bytes / {memo.read} = memo.fetch(b"line", input).concat(b"!")

fn line_queries() -> Map<Bytes, Query<| {}>> =
  Map::new().insert(b"split", query(b"split", b"s1", split_lines)).insert(
    b"line",
    query(b"line", b"n1", line_of),
  ).insert(
    b"shout",
    query(b"shout", b"o1", line_shouted),
  )

fn lines_world(text: Bytes) -> TestWorld = world_of([{ at: b"f", text: text }])

test "a fact that a query wrote never comes back on its own, because its writer decides it" {
  let q = line_queries();
  let first = fetched_in(q, lines_world(b"one\ntwo"), b"line", b"f1");
  let shorter = fetched_in(q, edited(first.world, b"f", b"one"), b"shout", b"f0");
  let longer = fetched_in(q, edited(shorter.world, b"f", b"one\nTWO"), b"line", b"f1");
  assert_eq(longer.output, b"TWO")
}

test "a query that writes several facts changes only the dependents of the facts that differ" {
  let q = line_queries();
  let first = fetched_in(q, lines_world(b"one\ntwo"), b"shout", b"f0");
  assert_eq(first.output, b"one!");
  let second = fetched_in(q, first.world, b"shout", b"f1");
  assert_eq(second.output, b"two!");
  let edit = fetched_in(q, edited(second.world, b"f", b"one\nTWO"), b"shout", b"f1");
  assert_eq(edit.output, b"TWO!");
  assert_eq(edit.ran, [b"split", b"shout"])
}

test "a fact that its writer stops writing is deleted, and its dependents see what a fresh build sees" {
  let q = line_queries();
  let first = fetched_in(q, lines_world(b"one\ntwo"), b"shout", b"f1");
  let shorter = fetched_in(q, edited(first.world, b"f", b"one"), b"shout", b"f1");
  assert_eq(shorter.output, b"no line!");
  assert_eq(shorter.output, fetched_in(q, lines_world(b"one"), b"shout", b"f1").output)
}

fn gated(input: Bytes) -> Bytes / {memo.read} =
  if read_file(b"gate") == b"open" { memo.fetch(b"inner", input) } else { b"closed" }

fn inner(input: Bytes) -> Bytes / {memo.read} = read_file(b"inner").concat(b"!")

fn gated_queries() -> Map<Bytes, Query<| {}>> =
  Map::new().insert(b"gated", query(b"gated", b"g1", gated)).insert(
    b"inner",
    query(b"inner", b"i1", inner),
  )

test "a fact that nothing uses any more is deleted" {
  let q = gated_queries();
  let first = fetched_in(q, world_of([{ at: b"gate", text: b"open" }]), b"gated", b"x");
  assert_eq(first.world.store.facts.len(), 2);
  let closed = fetched_in(q, edited(first.world, b"gate", b"shut"), b"gated", b"x");
  assert_eq(closed.world.store.facts.len(), 1);
  assert_eq(fetched_in(q, edited(closed.world, b"inner", b"new"), b"gated", b"x").ran, [])
}

fn guarded(input: Bytes) -> Bytes / {memo.read} =
  if read_file(b"cycle") == b"yes" { b"reported" } else { memo.fetch(b"walk", input) }

fn walked(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  if read_file(b"cycle") == b"yes" { panic("the walk never ends") } else { b"walked" }

fn guarded_queries() -> Map<Bytes, Query<| {}>> =
  Map::new().insert(b"guard", query(b"guard", b"g1", guarded)).insert(
    b"walk",
    query(b"walk", b"w1", walked),
  )

test "a recomputation that fails deletes its fact, and the run ends as a build from nothing ends" {
  let q = guarded_queries();
  let first = fetched_in(q, world_of([{ at: b"cycle", text: b"no" }]), b"guard", b"x");
  assert_eq(first.output, b"walked");
  let looped = fetched_in(q, edited(first.world, b"cycle", b"yes"), b"guard", b"x");
  assert_eq(looped.output, b"reported");
  assert_eq(
    stored_outputs(looped.world.store),
    stored_outputs(
      fetched_in(q, world_of([{ at: b"cycle", text: b"yes" }]), b"guard", b"x").world.store,
    ),
  )
}

fn ring_a(input: Bytes) -> Bytes / {memo.read} =
  if read_file(b"ring") == b"on" { memo.fetch(b"b", input) } else { b"a" }

fn ring_b(input: Bytes) -> Bytes / {memo.read} = memo.fetch(b"a", input)

test "a query that asks for its own result fails after an edit as it fails in a fresh build" {
  let q = Map::new().insert(b"a", query(b"a", b"a1", ring_a)).insert(
    b"b",
    query(b"b", b"b1", ring_b),
  );
  let first = fetched_in(q, world_of([{ at: b"ring", text: b"off" }]), b"b", b"x");
  assert_eq(first.output, b"a");
  let ringed = edited(first.world, b"ring", b"on");
  let tried = |w: TestWorld|
    handle { Some(fetched_in(q, w, b"b", b"x").output) } with { abort.raise(_) -> None };
  assert_eq(tried(ringed), None);
  assert_eq(tried({ ..ringed, store: empty_memory_store }), None)
}

fn cascading(input: Bytes) -> Bytes / {memo.read} = blake3(memo.fetch(b"length", input))

const hash_kind: Option<Product> = Some({ kind: b"hash", after: [] })

fn product_queries() -> Map<Bytes, Query<| {}>> =
  lengths(b"h1").insert(b"hash", { ..query(b"hash", b"p1", cascading), product: hash_kind })

test "an edit leaves a product alone until a command asks for it, and then updates it from the log" {
  let q = product_queries();
  let first = fetched_in(q, four, b"hash", b"a");
  let moved = fetched_in(q, edited(first.world, b"a", b"forty"), b"length", b"a");
  assert_eq(moved.ran, [b"length"]);
  let later = fetched_in(q, moved.world, b"hash", b"a");
  assert_eq(later.ran, [b"hash"]);
  assert_eq(later.output, blake3(b"5"));
  assert_eq(fetched_in(q, later.world, b"hash", b"a").ran, [])
}

fn doc_of(input: Bytes) -> Bytes / {memo.read} = b"doc ".concat(memo.fetch(b"length", input))

fn two_kinds() -> Map<Bytes, Query<| {}>> =
  product_queries().insert(b"doc", {
    ..query(b"doc", b"d1", doc_of),
    product: Some({ kind: b"doc", after: [] }),
  })

test "each kind of product catches up by itself, so asking for one leaves the other behind" {
  let q = two_kinds();
  let hashed = fetched_in(q, four, b"hash", b"a");
  let both = fetched_in(q, hashed.world, b"doc", b"a");
  let moved = fetched_in(q, edited(both.world, b"a", b"forty"), b"hash", b"a");
  assert_eq(moved.ran, [b"length", b"hash"]);
  assert_eq(fetched_in(q, moved.world, b"doc", b"a").ran, [b"doc"])
}

test "a product whose code changed runs when a command asks for it" {
  let labelled = fetched_in(product_queries(), four, b"label", b"a");
  let first = fetched_in(product_queries(), labelled.world, b"hash", b"a");
  let q = lengths(b"h1").insert(b"hash", {
    ..query(b"hash", b"p2", cascading),
    product: hash_kind,
  });
  assert_eq(fetched_in(q, first.world, b"length", b"a").ran, []);
  assert_eq(fetched_in(q, first.world, b"hash", b"a").ran, [b"hash"])
}

fn over_two(input: Bytes) -> Bytes / {memo.read} =
  Bytes::concat_all([memo.fetch(b"length", input), memo.fetch(b"label", input)])

test "a query with two paths to a change runs once, after both paths" {
  let q = lengths(b"h1").insert(b"both", query(b"both", b"b1", over_two));
  let first = fetched_in(q, four, b"both", b"a");
  let moved = fetched_in(q, edited(first.world, b"a", b"forty"), b"both", b"a");
  assert_eq(moved.output, b"5long 5");
  assert_eq(moved.ran, [b"length", b"label", b"both"])
}

fn shout_text(input: Bytes) -> Bytes / {memo.read} = memo.fetch(b"text", input).concat(b"!")

test "a result that is not stored is computed again, even when an earlier version of its fact would hold" {
  let long = b"long ".repeat(1000);
  let longer = b"longer ".repeat(1000);
  let q = Map::new().insert(b"text", {
    ..query(b"text", b"t1", read_file),
    persistent: false,
  }).insert(
    b"shout",
    query(b"shout", b"o1", shout_text),
  );
  let first = fetched_in(q, world_of([{ at: b"a", text: long }]), b"shout", b"a");
  let moved = fetched_in(q, edited(first.world, b"a", longer), b"shout", b"a");
  let undone = fetched_in(q, edited(moved.world, b"a", long), b"shout", b"a");
  assert_eq(undone.output, long.concat(b"!"))
}

test "a large result of a query that does not keep its results is computed again when needed" {
  let long = b"long ".repeat(1000);
  let q = Map::new().insert(b"text", {
    ..query(b"text", b"t1", read_file),
    persistent: false,
  }).insert(
    b"shout",
    query(b"shout", b"o1", shout_text),
  );
  let first = fetched_in(q, world_of([{ at: b"a", text: long }]), b"shout", b"a");
  let text = fetched_in(q, first.world, b"text", b"a");
  assert_eq(text.output, long);
  assert_eq(text.ran, [b"text"])
}

test "a fact in a trusted pack is used as it is, and a project records what it used" {
  let q = lengths(b"h1");
  let source = fetched_in(q, four, b"length", b"a").world;
  let qs = plain_queries(q);
  let pack = pack_memory_store(source.store, qs, b"files");
  let read = |path: String, offset: Int, len: Int| packs::frame_in(Some(pack), path, offset, len);
  let done = with_memory_store(empty_memory_store, read, b"files", |_: Bytes, _: Bytes| None, ||
    in_session(qs, |run: Run| {
      let a = query_output(qs, run, b"label", b"a");
      { run: a.run, value: { output: a.output, ran: a.run.inputs.map(|s: Step| s.query) } }
    }));
  assert_eq(done.value, { output: b"long 4", ran: [b"label"] });
  assert_eq(done.store.inputs.values().map(|i: StoredInput| i.kind), [b"sealed"])
}

test "a fact that used a sealed fact is recomputed when a new pack changes that fact" {
  let q = lengths(b"h1");
  let pack_of = |w: TestWorld, files: Bytes| {
    let built = fetched_in(q, w, b"length", b"a").world;
    let written = pack_memory_store(built.store, plain_queries(q), files);
    |path: String, offset: Int, len: Int| packs::frame_in(Some(written), path, offset, len)
  };
  let older = pack_of(four, b"old");
  let newer = pack_of(world_of([{ at: b"a", text: b"forty" }]), b"new");
  let run_with = |store: MemoryStore, read: (String, Int, Int) -> Option<Bytes> / {abort.raise}, files: Bytes|
    with_memory_store(store, read, files, |_: Bytes, _: Bytes| None, ||
      in_session_of(plain_queries(q), b"label", b"a"));
  let first = run_with(empty_memory_store, older, b"old");
  assert_eq(first.value, b"long 4");
  assert_eq(run_with(first.store, newer, b"new").value, b"long 5")
}

fn together(name: Bytes, input: Bytes) -> Bytes / {memo.read} =
  Bytes::join(memo.fetch_all(name, input.split(b",")), b",")

fn one_by_one(name: Bytes, input: Bytes) -> Bytes / {memo.read} =
  Bytes::join(input.split(b",").map(|read: Bytes| memo.fetch(name, read)), b",")

fn counted_down(input: Bytes) -> Bytes / {memo.read} =
  if input.len() <= 1 { read_file(input) }
  else { memo.fetch(b"down", input.slice(1, input.len())).concat(input.slice(0, 1)) }

fn batched(fetch_many: keep (Bytes, Bytes) -> Bytes / {memo.read}) -> Map<Bytes, Query<| {}>> =
  lengths(b"h1").insert(b"down", query(b"down", b"d1", counted_down)).insert(
    b"lengths",
    query(b"lengths", b"s1", |input: Bytes| fetch_many(b"length", input)),
  ).insert(
    b"labels",
    query(b"labels", b"s2", |input: Bytes| fetch_many(b"label", input)),
  ).insert(
    b"downs",
    query(b"downs", b"s3", |input: Bytes| fetch_many(b"down", input)),
  )

const three_files: List<{ at: Bytes, text: Bytes }> =
  [{ at: b"a", text: b"four" }, { at: b"b", text: b"seven" }, { at: b"c", text: b"ten" }]

fn same_facts(a: Answered, b: Answered) -> Unit / {abort.raise} = {
  assert_eq(a.output, b.output);
  assert_eq(stored_outputs(a.world.store), stored_outputs(b.world.store));
  assert_eq(fact_records(a.world.store), fact_records(b.world.store))
}

test "facts fetched together store the outputs and reads that fetching them one at a time stores" {
  let w = world_of(three_files);
  let apart = fetched_in(batched(together), w, b"lengths", b"a,b,c");
  assert_eq(apart.output, b"4,5,3");
  same_facts(apart, fetched_in(batched(one_by_one), w, b"lengths", b"a,b,c"))
}

test "facts of one depth recomputed together after an edit end as a build from nothing ends" {
  let first = fetched_in(batched(together), world_of(three_files), b"lengths", b"a,b,c");
  let moved = edited(edited(first.world, b"a", b"forty"), b"c", b"eleven");
  let after = fetched_in(batched(together), moved, b"lengths", b"a,b,c");
  assert_eq(after.output, b"5,5,6");
  same_facts(
    after,
    fetched_in(batched(together), { ..moved, store: empty_memory_store }, b"lengths", b"a,b,c"),
  )
}

test "a fact fetched together whose body needs a fact not yet computed still comes out right" {
  let w = world_of(three_files);
  let labels = fetched_in(batched(together), w, b"labels", b"a,b");
  assert_eq(labels.output, b"long 4,long 5");
  same_facts(labels, fetched_in(batched(one_by_one), w, b"labels", b"a,b"));
  let downs = fetched_in(batched(together), w, b"downs", b"cba,a,ba");
  assert_eq(downs.output, b"fourbc,four,fourb");
  same_facts(downs, fetched_in(batched(one_by_one), w, b"downs", b"cba,a,ba"))
}
