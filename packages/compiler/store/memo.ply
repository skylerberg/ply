import std.set (Set)

pub type Parts = Map<Bytes, Bytes>

pub const main_part: Bytes = b""

pub effect memo {
  read external(kind: Bytes, at: Bytes) -> Option<Bytes>
  read fetch(query: Bytes, input: Bytes, part: Bytes) -> Option<Bytes>
  read fetch_all(query: Bytes, inputs: List<Bytes>, part: Bytes) -> List<Option<Bytes>>
  read output_digest(query: Bytes, input: Bytes, part: Bytes) -> Option<Bytes>
  read stored_output(digest: Bytes) -> Option<Bytes>
  write fix(kind: Bytes, at: Bytes) -> Unit
}

pub type Product = { kind: Bytes, after: List<Bytes> }

pub type Query<| e> = {
  name: Bytes,
  hash: Bytes,
  body: (Bytes) -> Parts / {memo.read, memo.write, abort.raise | e},
  persistent: Bool,
  product: Option<Product>,
  interface: Set<Bytes>,
}

pub type Queries<| e> = {
  named: Map<Bytes, Query<| e>>,
  apart: (() -> Bytes / {abort.raise | e}) -> Bytes / {abort.raise},
}

pub fn plain_queries(named: Map<Bytes, Query<| {}>>) -> Queries<| {}> =
  { named: named, apart: |work: () -> Bytes / {abort.raise}| work() }

pub fn main_only(output: Bytes) -> Parts = Map::new().insert(main_part, output)

pub type RecordedRead =
  | ReadOfFact({ query: Bytes, input: Bytes, part: Bytes, recorded: Option<Bytes>, current: Option<Bytes> })
  | ReadOfDeletedFact({ fact: Bytes, part: Bytes, recorded: Option<Bytes> })
  | ReadOfInput({ kind: Bytes, at: Bytes, recorded: Bytes, current: Bytes })

pub type RecordedFact = { query: Bytes, parts: Map<Bytes, Bytes>, reads: List<RecordedRead> }

pub type FactReader = { query: Bytes, input: Bytes }

pub effect fact_inspection {
  read recorded_fact(query: Bytes, input: Bytes) -> Option<RecordedFact>
  read readers(query: Bytes, input: Bytes, part: Bytes) -> List<FactReader>
  read input_readers(kind: Bytes, at: Bytes) -> List<FactReader>
}
