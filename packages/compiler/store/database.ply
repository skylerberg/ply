import std.set (Set)
import std.bin
import std.fs
import std.fs (fs)
import std.list
import std.hash (blake3)
import std.show (show)
import compiler.store.fact_store
import compiler.store.fact_store (Database, Dependents, Facts, Inputs, Codes, Records, Cursors,
                                  PackUsed, fact_damage, recent_reads, with_recent_reads)
import compiler.store.memo (Parts, Product, Queries, Query, main_only, main_part, memo, plain_queries)
import compiler.store.memo.store (Dependency, ExternalInput, FactDetails, QueriesId, SealedInput,
                                  StoredFact, StoredInput, Waiting, deferred_kind, fact_details_bin,
                                  fact_key, first_waiting, fixed_digest, input_id, location_id,
                                  lowest_waiting, memo_store, nothing_left_waiting, nothing_waiting,
                                  parts_digest, queries_id, session_input, session_inputs,
                                  stored_fact_bin, stored_input_bin, trusted_pack_id, with_mark,
                                  with_session_inputs, without_mark)
import compiler.store.memo.engine (in_session_of)
import compiler.store.packs
import compiler.store.segments
import compiler.store.segments (CommitResult, Committed, LockHeld, StoreChanged, WriteFailed)

type PackUse = | NoTrustedPack | TrustedPack(Bytes)

derive bin for PackUse

const pack_use_key: Bytes = b"pack"

fn pack_key(key: Bytes) -> Bytes = blake3(key)

type SealedRecord = { parts: Map<Bytes, Bytes>, inline: Map<Bytes, Bytes> }

derive bin for SealedRecord

const inline_limit: Int = 2048

fn is_inline(output: Bytes) -> Bool = output.len() <= inline_limit

fn sealed_record_of(record: Bytes) -> Option<SealedRecord> / {abort.raise} =
  match bin::decode(record, sealed_record_bin()) { Ok(r) -> Some(r), Err(_) -> None }

type PackBuild = {
  writing: packs::PackWriter,
  records: Map<Bytes, packs::Range>,
  results: Map<Bytes, packs::Range>,
  returned: Map<Bytes, Bytes>,
}

const empty_pack_build: PackBuild =
  { writing: packs::new_writer, records: Map::new(), results: Map::new(), returned: Map::new() }

fn with_packed_fact<| e>(
  built: PackBuild,
  key: Bytes,
  fact: StoredFact,
  output_of: (Bytes) -> Option<Bytes> / {abort.raise | e},
) -> PackBuild / {abort.raise | e} = {
  let outputs = fact.parts.fold(Map::new(), |found: Map<Bytes, Bytes>, _: Bytes, digest: Bytes|
    match output_of(digest) { Some(o) -> found.insert(digest, o), None -> found });
  let inline = outputs.fold(Map::new(), |found: Map<Bytes, Bytes>, digest: Bytes, o: Bytes|
    if is_inline(o) { found.insert(digest, o) } else { found });
  let with_results = outputs.fold(built, |b: PackBuild, digest: Bytes, o: Bytes|
    match packs::output_key(digest) {
      Some(name) -> if inline.contains(digest) || b.results.contains(name) { b } else {
        let framed = packs::append_frame(b.writing, o);
        { ..b, writing: framed.writing, results: b.results.insert(name, framed.at) }
      },
      None -> b,
    });
  let framed = packs::append_frame(
    with_results.writing,
    bin::encode({ parts: fact.parts, inline: inline }, sealed_record_bin()),
  );
  {
    ..with_results,
    writing: framed.writing,
    records: with_results.records.insert(pack_key(key), framed.at),
    returned: with_results.returned.insert(pack_key(key), parts_digest(fact.parts)),
  }
}

type StoreRun = {
  db: Database,
  outputs: Map<Bytes, Bytes>,
  outputs_size: Int,
  details: Map<Bytes, FactDetails>,
  transient: Map<Bytes, Bytes>,
  pack: packs::PackReader,
  pack_use: PackUse,
  pack_differs: Bool,
  waiting: Waiting,
  changes: List<Bytes>,
  edited: Bool,
  kinds_read: Map<Bytes, Int>,
}

const max_cached_size: Int = 268435456

fn int_bytes(n: Int) -> Bytes / {abort.raise} = bin::encode(n, bin::int_bin())

fn code_key(name: Bytes) -> Bytes = name.blake3()

fn result_key(digest: Bytes) -> Bytes =
  match packs::output_key(digest) { Some(k) -> k, None -> digest }

fn undecoded<a>(bytes: Bytes, codec: bin::BinCodec<a>) -> a / {fact_damage.damaged, abort.raise} =
  match bin::decode(bytes, codec) {
    Ok(value) -> value,
    Err(_) -> fact_damage.damaged("a stored fact does not decode"),
  }

fn remembered_output(o: StoreRun, digest: Bytes, output: Bytes) -> StoreRun =
  if o.outputs.contains(digest) || o.outputs_size + output.len() > max_cached_size { o } else {
    { ..o, outputs: o.outputs.insert(digest, output), outputs_size: o.outputs_size + output.len() }
  }

fn stored_output<[r]>(
  o: StoreRun,
  digest: Bytes,
  output: Bytes,
) -> StoreRun / {fs.read[r], fs.write[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  {
    ..remembered_output(o, digest, output),
    db: fact_store::with_result[r](o.db, result_key(digest), output),
  }

fn results_of_facts(
  found: Set<Bytes>,
  values: List<Bytes>,
) -> Set<Bytes> / {fact_damage.damaged, abort.raise} =
  values.fold(found, |live: Set<Bytes>, b: Bytes| {
    let f = undecoded(b, stored_fact_bin());
    f.parts.fold(live.insert(f.details), |l: Set<Bytes>, _: Bytes, digest: Bytes|
      l.insert(result_key(digest)))
  })

fn inputs_of<[r]>(
  db: Database,
) -> List<StoredInput> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  fact_store::entries_under[r](db, Inputs, b"").values().map(|b: Bytes|
    undecoded(b, stored_input_bin()))

fn live_results<[r]>(
  db: Database,
) -> Set<Bytes> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  inputs_of[r](db).fold(
    results_of_facts(Set::empty(), fact_store::entries_under[r](db, Facts, b"").values()),
    |live: Set<Bytes>, input: StoredInput|
      match fixed_digest(input) { Some(d) -> live.insert(result_key(d)), None -> live },
  )

fn fixed_input<[r]>(
  db: Database,
  id: Bytes,
) -> Option<Bytes> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  match fact_store::value_of[r](db, Inputs, id) {
    Some(b) -> { fixed_digest(undecoded(b, stored_input_bin())) },
    None -> None,
  }

fn cursor_of<[r]>(
  db: Database,
  kind: Bytes,
) -> Option<Int> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  match fact_store::value_of[r](db, Cursors, kind) {
    Some(b) -> Some(undecoded(b, bin::int_bin())),
    None -> None,
  }

fn lowest_cursor<[r]>(
  db: Database,
) -> Int / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  fact_store::entries_under[r](db, Cursors, b"").values().fold(
    fact_store::log_end(db),
    |lowest: Int, b: Bytes| min(lowest, undecoded(b, bin::int_bin())),
  )

fn trusts_pack(st: StoreRun) -> Bool =
  match st.pack_use { TrustedPack(_) -> true, NoTrustedPack -> false }

type Ran<a> = { value: a, commit: CommitResult }

fn over_database<a, [r] | e>(
  database: Database,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  noted: (Bytes) -> Unit / {abort.raise | e},
  work: () -> a / {memo_store.read, memo_store.write, abort.raise},
) -> Ran<a> / {fs.read[r], fs.write[r], recent_reads.read, recent_reads.write, fact_damage.damaged, session_inputs.read, session_inputs.write, abort.raise | e} = {
  let looked = |db: Database, kind: Bytes, at: Bytes| {
    let id = location_id(kind, at);
    session_input(id, ||
      match fixed_input[r](db, id) {
        Some(d) -> fact_store::result_of[r](db, result_key(d)),
        None -> look(kind, at),
      })
  };
  handle {
    work()
  } with {
    var st: StoreRun = {
      db: database,
      outputs: Map::new(),
      outputs_size: 0,
      details: Map::new(),
      transient: Map::new(),
      pack: packs::open_reader(read),
      pack_use: NoTrustedPack,
      pack_differs: false,
      waiting: nothing_waiting,
      changes: [],
      edited: false,
      kinds_read: Map::new(),
    },
    memo_store.fact(key) -> match fact_store::value_of[r](st.db, Facts, key) {
      Some(b) -> Some(undecoded(b, stored_fact_bin())),
      None -> None,
    },
    memo_store.details(digest) -> match st.details.get(digest) {
      Some(d) -> d,
      None -> match fact_store::result_of[r](st.db, digest) {
        None -> fact_damage.damaged("a stored fact names details that are not stored"),
        Some(b) -> {
          let d = undecoded(b, fact_details_bin());
          st = { ..st, details: st.details.insert(digest, d) };
          d
        },
      },
    },
    memo_store.output(digest) -> match st.outputs.get(digest) {
      Some(o) -> Some(o),
      None -> match st.transient.get(digest) {
        Some(o) -> Some(o),
        None -> match fact_store::result_of[r](st.db, result_key(digest)) {
          Some(o) -> {
            st = remembered_output(st, digest, o);
            Some(o)
          },
          None -> if !trusts_pack(st) { None } else {
            let found = packs::output(st.pack, read, digest);
            st = { ..st, pack: found.reading };
            found.bytes
          },
        },
      },
    },
    memo_store.sealed(key) -> if !trusts_pack(st) { None } else {
      let found = packs::record(st.pack, read, pack_key(key));
      st = { ..st, pack: found.reading };
      match match found.bytes { Some(b) -> sealed_record_of(b), None -> None } {
        None -> None,
        Some(r) -> {
          st = {
            ..st,
            transient: r.inline.fold(
              st.transient,
              |t: Map<Bytes, Bytes>, digest: Bytes, o: Bytes| t.insert(digest, o),
            ),
          };
          Some(r.parts)
        },
      }
    },
    memo_store.sealed_changed() -> st.pack_differs,
    memo_store.dependents(key) -> fact_store::members[r](st.db, Dependents, key),
    memo_store.has_dependents(key) -> fact_store::members[r](st.db, Dependents, key) != [],
    memo_store.inputs() -> inputs_of[r](st.db),
    memo_store.facts_of(prefix) -> fact_store::entries_under[r](st.db, Facts, prefix).keys(),
    memo_store.code(name) -> fact_store::value_of[r](st.db, Codes, code_key(name)),
    memo_store.external(kind, at) -> looked(st.db, kind, at),
    memo_store.is_out_of_date(key) -> st.waiting.depths.contains(key),
    memo_store.next_out_of_date() -> first_waiting(st.waiting),
    memo_store.out_of_date_level() -> lowest_waiting(st.waiting),
    memo_store.computed(query) -> noted(query),
    memo_store.put(key, fact, _, encoded_details, outputs, lasting) -> {
      let stored = outputs.fold(st, |o: StoreRun, digest: Bytes, output: Bytes|
        if lasting || is_inline(output) { stored_output[r](o, digest, output) }
        else { { ..o, transient: o.transient.insert(digest, output) } });
      st = {
        ..stored,
        db: fact_store::with_value(
          fact_store::with_result[r](stored.db, fact.details, encoded_details),
          Facts,
          key,
          bin::encode(fact, stored_fact_bin()),
        ),
      };
    },
    memo_store.keep_output(digest, output, lasting) -> {
      st = if lasting { stored_output[r](st, digest, output) }
      else { { ..st, transient: st.transient.insert(digest, output) } };
    },
    memo_store.delete(key) -> {
      st = {
        ..st,
        waiting: without_mark(st.waiting, key),
        db: fact_store::without_value(st.db, Facts, key),
      };
    },
    memo_store.add_dependent(key, dependent) -> {
      st = { ..st, db: fact_store::add_member(st.db, Dependents, key, dependent) };
    },
    memo_store.remove_dependent(key, dependent) -> {
      st = { ..st, db: fact_store::remove_member(st.db, Dependents, key, dependent) };
    },
    memo_store.put_input(input) -> {
      let id = input_id(input);
      let encoded = bin::encode(input, stored_input_bin());
      let held = fact_store::value_of[r](st.db, Inputs, id);
      if held != Some(encoded) && fixed_input[r](st.db, id) == None {
        st = { ..st, db: fact_store::with_value(st.db, Inputs, id, encoded) };
      };
    },
    memo_store.fix_input(kind, at) -> {
      let id = location_id(kind, at);
      match if fixed_input[r](st.db, id) == None { session_inputs.held(id) } else { None } {
        Some({ value: Some(v), digest: d }) -> {
          let stored = stored_output[r](st, d, v);
          st = {
            ..stored,
            db: fact_store::with_value(
              stored.db,
              Inputs,
              id,
              bin::encode(
                ExternalInput({ kind: kind, at: at, digest: d, fixed: true }),
                stored_input_bin(),
              ),
            ),
          };
        },
        _ -> (),
      };
    },
    memo_store.delete_input(id) -> {
      if fact_store::value_of[r](st.db, Inputs, id) != None {
        st = { ..st, db: fact_store::without_value(st.db, Inputs, id) };
      };
    },
    memo_store.put_code(name, hash) -> {
      st = { ..st, db: fact_store::with_value(st.db, Codes, code_key(name), hash) };
    },
    memo_store.mark_out_of_date(key, depth) -> {
      st = { ..st, waiting: with_mark(st.waiting, key, depth) };
    },
    memo_store.settle(key) -> {
      st = { ..st, waiting: without_mark(st.waiting, key) };
    },
    memo_store.log_change(key) -> {
      st = { ..st, changes: st.changes.push(key) };
    },
    memo_store.note_edit() -> {
      st = { ..st, edited: true };
    },
    memo_store.deferred_kind(key) -> deferred_kind(st.waiting, key),
    memo_store.defer_products(kinds) -> {
      st = { ..st, waiting: { ..st.waiting, products: kinds } };
    },
    memo_store.push_products(kind) -> {
      st = { ..st, waiting: { ..st.waiting, pushing: st.waiting.pushing.insert(kind) } };
    },
    memo_store.logged_changes(kind) -> match cursor_of[r](st.db, kind) {
      None -> [],
      Some(at) ->
        fact_store::changes_after[r](st.db, at).fold(
          st.changes,
          |keys: List<Bytes>, entry: fact_store::LogEntry| keys.concat(entry.changes),
        ),
    },
    memo_store.log_read(kind) -> {
      st = { ..st, kinds_read: st.kinds_read.insert(kind, st.changes.len()) };
    },
    memo_store.running(queries) -> {
      let used = match st.pack.index {
        Some(i) -> if packs::is_trusted(i, queries, world) {
          TrustedPack(trusted_pack_id(queries, world))
        } else { NoTrustedPack },
        None -> NoTrustedPack,
      };
      let encoded = bin::encode(used, pack_use_bin());
      let was = fact_store::value_of[r](st.db, PackUsed, pack_use_key);
      st = {
        ..st,
        pack_use: used,
        pack_differs: was != Some(encoded),
        db: if was == Some(encoded) { st.db }
        else { fact_store::with_value(st.db, PackUsed, pack_use_key, encoded) },
      };
    },
    return value -> {
      nothing_left_waiting(st.waiting);
      let logged = if st.edited || st.changes.len() > 0 {
        fact_store::append_change(st.db, st.changes)
      } else { st.db };
      let before = fact_store::log_end(st.db);
      let read_kinds = st.kinds_read.fold(logged, |db: Database, kind: Bytes, changes_seen: Int|
        fact_store::with_value(
          db,
          Cursors,
          kind,
          int_bytes(if changes_seen == st.changes.len() { fact_store::log_end(logged) }
          else { before }),
        ));
      {
        value: value,
        commit: fact_store::commit[r](
          fact_store::with_log_floor(read_kinds, lowest_cursor[r](read_kinds)),
          |current: Database| live_results[r](current),
        ),
      }
    },
  }
}


pub type StoreOutcome<a> = { value: a, damage: Option<String> }

type Session<a> = { outcome: StoreOutcome<a>, commit: CommitResult }

fn with_opened<a, [r] | e>(
  dir: String,
  go: (fact_store::Opening) -> a / {fs.read[r], fs.write[r], recent_reads.read, recent_reads.write, abort.raise | e},
) -> a / {fs.read[r], fs.write[r], abort.raise | e} =
  with_recent_reads(|| {
    let opening = fact_store::open[r](dir);
    let value = go(opening);
    fact_store::close[r](opening);
    value
  })

fn session_in<a, [r] | e>(
  dir: String,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  noted: (Bytes) -> Unit / {abort.raise | e},
  work: () -> a / {memo_store.read, memo_store.write, abort.raise},
) -> Session<a> / {fs.read[r], fs.write[r], abort.raise | e} =
  with_opened[r](dir, |opening: fact_store::Opening|
    with_session_inputs(|| {
      let first = handle {
        Ok(over_database[r](fact_store::loaded[r](opening), read, world, look, noted, work))
      } with {
        fact_damage.damaged(reason) -> Err(reason),
      };
      match first {
        Ok(ran) -> { outcome: { value: ran.value, damage: None }, commit: ran.commit },
        Err(reason) -> {
          let ran = fact_store::undamaged(||
            over_database[r](fact_store::emptied(opening), read, world, look, noted, work));
          { outcome: { value: ran.value, damage: Some(reason) }, commit: ran.commit }
        },
      }
    }))

pub fn with_database<a, [r] | e>(
  dir: String,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  noted: (Bytes) -> Unit / {abort.raise | e},
  work: () -> a / {memo_store.read, memo_store.write, abort.raise},
) -> StoreOutcome<a> / {fs.read[r], fs.write[r], abort.raise | e} =
  session_in[r](dir, read, world, look, noted, work).outcome

pub fn database_in(cache_dir: String) -> String = cache_dir ++ "/memo"

fn read_only_in<a, [r]>(
  dir: String,
  read: (Database) -> a / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise},
) -> Result<a, String> / {fs.read[r], abort.raise} =
  with_recent_reads(||
    handle {
      Ok(read(fact_store::read_only[r](dir)))
    } with {
      fact_damage.damaged(reason) -> Err(reason),
    })

fn undamaged_in<a, [r]>(
  dir: String,
  read: (Database) -> a / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise},
) -> a / {fs.read[r], abort.raise} =
  match read_only_in[r](dir, read) {
    Ok(value) -> value,
    Err(reason) -> panic("the fact database is damaged: " ++ reason),
  }

pub fn read_records<[r]>(dir: String) -> Result<Map<Bytes, Bytes>, String> / {fs.read[r], abort.raise} =
  read_only_in[r](dir, |db: Database| fact_store::entries_under[r](db, Records, b""))

pub fn write_records<[r]>(
  dir: String,
  puts: Map<Bytes, Bytes>,
  deleted: Set<Bytes>,
) -> Result<Unit, String> / {fs.read[r], fs.write[r], abort.raise} =
  with_opened[r](dir, |opening: fact_store::Opening|
    handle {
      let written = puts.fold(
        deleted.fold(fact_store::loaded[r](opening), |d: Database, key: Bytes|
          fact_store::without_value(d, Records, key)),
        |d: Database, key: Bytes, value: Bytes| fact_store::with_value(d, Records, key, value),
      );
      match fact_store::commit[r](written, |current: Database| live_results[r](current)) {
        Committed(_) -> Ok(()),
        LockHeld -> Err("another `ply` was writing the store"),
        StoreChanged -> Err("another `ply` changed the store at the same time"),
        WriteFailed -> Err("the store could not be written"),
      }
    } with {
      fact_damage.damaged(reason) -> Err("the store is damaged (" ++ reason ++ ")"),
    })

pub fn copy_database<[r]>(from: String, to: String) -> Unit / {fs.read[r], fs.write[r]} = {
  fs.create_dir[r](to);
  (match fs::listed_names(fs.list_dir[r](from)) { Some(names) -> names, None -> [] }).filter(
    |name: String| name.starts_with("seg-") || name.starts_with("manifest-"),
  ).fold((), |_: Unit, name: String|
    match fs.read_file[r](from ++ "/" ++ name) {
      Some(bytes) -> {
        fs.write_file[r](to ++ "/" ++ name, bytes);
        ()
      },
      None -> (),
    })
}


pub type KindUsage = { query: Bytes, facts: Int, bytes: Int }

pub type Usage = {
  records: Int,
  results: Int,
  output_bytes: Int,
  kinds: List<KindUsage>,
  segments: Int,
  bytes: Int,
}

fn stored_size<[r]>(
  db: Database,
  digest: Bytes,
) -> Int / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  match fact_store::stored_result_size[r](db, result_key(digest)) {
    Some(size) -> size,
    None -> 0,
  }

fn with_fact_of_kind<[r]>(
  db: Database,
  kinds: Map<Bytes, KindUsage>,
  fact: StoredFact,
) -> Map<Bytes, KindUsage> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  match fact_store::result_of[r](db, fact.details) {
    None -> fact_damage.damaged("a stored fact names details that are not stored"),
    Some(b) -> {
      let name = undecoded(b, fact_details_bin()).query;
      let size = fact.parts.fold(0, |n: Int, _: Bytes, digest: Bytes| n + stored_size[r](db, digest));
      let was = match kinds.get(name) { Some(k) -> k, None -> { query: name, facts: 0, bytes: 0 } };
      kinds.insert(name, { ..was, facts: was.facts + 1, bytes: was.bytes + size })
    },
  }

pub fn usage<[r]>(dir: String) -> Usage / {fs.read[r], abort.raise} =
  undamaged_in[r](dir, |db: Database| {
    let size = fact_store::store_size(db);
    let facts = fact_store::entries_under[r](db, Facts, b"").values();
    let kinds = facts.fold(Map::new(), |found: Map<Bytes, KindUsage>, b: Bytes|
      with_fact_of_kind[r](db, found, undecoded(b, stored_fact_bin())));
    let output_bytes = kinds.fold(0, |n: Int, _: Bytes, k: KindUsage| n + k.bytes);
    {
      records: facts.len(),
      results: live_results[r](db).size(),
      output_bytes: output_bytes,
      kinds: kinds.values(),
      segments: size.segments,
      bytes: size.bytes,
    }
  })

pub type StoredOutput = | Stored(Bytes) | NotKept

pub fn outputs_by_digest<[r]>(
  dir: String,
  digests: List<Bytes>,
) -> Map<Bytes, StoredOutput> / {fs.read[r], abort.raise} =
  undamaged_in[r](dir, |db: Database|
    digests.fold(Map::new(), |found: Map<Bytes, StoredOutput>, digest: Bytes|
      found.insert(digest, match fact_store::result_of[r](db, result_key(digest)) {
        Some(output) -> Stored(output),
        None -> NotKept,
      })))

pub fn write_pack<[r]>(
  from: String,
  keys: List<Bytes>,
  queries: QueriesId,
  files: Bytes,
) -> { written: packs::PackFiles, records: Int } / {fs.read[r], abort.raise} =
  undamaged_in[r](from, |db: Database| {
    let laid = keys.fold(empty_pack_build, |built: PackBuild, key: Bytes|
      match fact_store::value_of[r](db, Facts, key) {
        None -> built,
        Some(b) ->
          with_packed_fact(built, key, undecoded(b, stored_fact_bin()), |digest: Bytes|
            fact_store::result_of[r](db, result_key(digest))),
      });
    {
      written: packs::finish(
        laid.writing,
        laid.records,
        laid.results,
        laid.returned,
        queries,
        files,
      ),
      records: laid.records.len(),
    }
  })

pub type FactRecord = {
  query: Bytes,
  input: Bytes,
  reads: List<Dependency>,
  parts: Map<Bytes, Bytes>,
}

fn fact_records<[r]>(dir: String) -> Map<Bytes, FactRecord> / {fs.read[r], abort.raise} =
  undamaged_in[r](dir, |db: Database|
    fact_store::entries_under[r](db, Facts, b"").fold(
      Map::new(),
      |found: Map<Bytes, FactRecord>, key: Bytes, b: Bytes| {
        let fact = undecoded(b, stored_fact_bin());
        let details = match fact_store::result_of[r](db, fact.details) {
          Some(encoded) -> undecoded(encoded, fact_details_bin()),
          None -> fact_damage.damaged("a stored fact names details that are not stored"),
        };
        found.insert(key, {
          query: details.query,
          input: details.input,
          reads: details.reads,
          parts: fact.parts,
        })
      },
    ))

fn stored_inputs<[r]>(dir: String) -> List<StoredInput> / {fs.read[r], abort.raise} =
  undamaged_in[r](dir, |db: Database| inputs_of[r](db))

pub const in_memory_database_dir: String = "store"

pub type WriteLimit = | AllWrites | FailAfter(Int)

pub type InMemoryOutcome<a> = | Finished(fs::MemResult<a>) | Stopped({ tree: fs::MemFs, reason: String })

fn session_in_memory<a | e>(
  tree: fs::MemFs,
  limit: WriteLimit,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_store.read, memo_store.write, abort.raise},
) -> fs::MemResult<Session<a>> / {abort.raise | e} = {
  let session = ||
    session_in[memory](in_memory_database_dir, read, world, look, |_: Bytes| (), work);
  match limit {
    AllWrites -> fs::on_mem[memory](tree, session),
    FailAfter(writes) -> fs::on_mem_failing[memory](tree, writes, session),
  }
}

pub fn with_writes_limited<a | e>(
  tree: fs::MemFs,
  limit: WriteLimit,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_store.read, memo_store.write, abort.raise},
) -> InMemoryOutcome<a> / {abort.raise | e} = {
  let ran = session_in_memory(tree, limit, read, world, look, work);
  match ran.value.outcome.damage {
    Some(reason) -> Stopped({ tree: ran.tree, reason: "it was damaged: " ++ reason }),
    None -> match ran.value.commit {
      Committed(_) -> Finished({ value: ran.value.outcome.value, tree: ran.tree }),
      refused -> Stopped({ tree: ran.tree, reason: "its commit was refused: " ++ show(refused) }),
    },
  }
}

pub fn with_store_in_memory<a | e>(
  tree: fs::MemFs,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_store.read, memo_store.write, abort.raise},
) -> fs::MemResult<a> / {abort.raise | e} = {
  let ran = session_in_memory(tree, AllWrites, read, world, look, work);
  match ran.value.outcome.damage {
    Some(reason) -> panic("the fact database held in memory is damaged: " ++ reason),
    None -> { value: ran.value.outcome.value, tree: ran.tree },
  }
}

fn database_files(tree: fs::MemFs) -> List<{ name: String, body: Option<Bytes> }> / {abort.raise} =
  (match fs::listed_names(fs::mem_list(tree, in_memory_database_dir)) {
    Some(names) -> names,
    None -> [],
  }).map(|name: String|
    { name: name, body: fs::mem_read(tree, in_memory_database_dir ++ "/" ++ name) })

pub fn same_database_in_memory(a: fs::MemFs, b: fs::MemFs) -> Bool / {abort.raise} =
  database_files(a) == database_files(b)

fn read_in_memory<a>(
  tree: fs::MemFs,
  read: (String) -> a / {fs.read[memory], abort.raise},
) -> a / {abort.raise} = fs::on_mem[memory](tree, || read(in_memory_database_dir)).value

pub fn facts_in_memory(tree: fs::MemFs) -> Map<Bytes, FactRecord> / {abort.raise} =
  read_in_memory(tree, |dir: String| fact_records[memory](dir))

pub fn inputs_in_memory(tree: fs::MemFs) -> List<StoredInput> / {abort.raise} =
  read_in_memory(tree, |dir: String| stored_inputs[memory](dir))

pub fn outputs_in_memory(
  tree: fs::MemFs,
  digests: List<Bytes>,
) -> Map<Bytes, StoredOutput> / {abort.raise} =
  read_in_memory(tree, |dir: String| outputs_by_digest[memory](dir, digests))

pub fn pack_in_memory(
  tree: fs::MemFs,
  keys: List<Bytes>,
  queries: QueriesId,
  files: Bytes,
) -> packs::PackFiles / {abort.raise} =
  read_in_memory(tree, |dir: String| write_pack[memory](dir, keys, queries, files).written)

fn quoted(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  match memo.fetch(b"text", input, main_part) {
    Some(text) -> Bytes::concat_all([b"\"", text, b"\""]),
    None -> panic("the text query returned no main part"),
  }

fn test_queries() -> Queries<| {}> =
  plain_queries(
    Map::new().insert(b"text", query(b"text", b"t1", read_file)).insert(
      b"quoted",
      query(b"quoted", b"q1", quoted),
    ),
  )

fn quoted_in<[r]>(checkout: String, text: Bytes) -> Bytes / {fs.read[r], fs.write[r], abort.raise} =
  with_database[r](
    checkout,
    packs::no_pack,
    b"",
    |_: Bytes, _: Bytes| Some(text),
    |_: Bytes| (),
    || in_session_of(test_queries(), b"quoted", b"a"),
  ).value

fn quoted_over<[r]>(text: Bytes) -> Bytes / {fs.read[r], fs.write[r], abort.raise} =
  quoted_in[r]("s", text)

fn stored_names(tree: fs::MemFs) -> List<String> / {abort.raise} =
  match fs::listed_names(fs::mem_list(tree, "s")) { Some(names) -> names, None -> [] }

test "a run that finds no change writes nothing but its own run directory" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  let again = fs::on_mem[abs](first.tree, || quoted_over[abs](b"four"));
  assert_eq(again.value, b"\"four\"");
  assert_eq(stored_names(again.tree), stored_names(first.tree))
}

test "a query's result survives a reopen, and an edit changes what depends on it" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  let moved = fs::on_mem[abs](first.tree, || quoted_over[abs](b"forty"));
  assert_eq(moved.value, b"\"forty\"");
  assert_eq(fs::on_mem[abs](moved.tree, || quoted_over[abs](b"forty")).value, b"\"forty\"")
}

fn read_then_saved<[r]>(
  path: String,
  saved: Option<Bytes>,
) -> Option<Bytes> / {fs.read[r], fs.write[r]} = {
  let found = fs.read_file[r](path);
  match saved {
    Some(bytes) -> {
      fs.write_file[r](path, bytes);
      ()
    },
    None -> (),
  };
  found
}

fn session_over_files<[r]>(
  saved: Option<Bytes>,
  name: Bytes,
) -> StoreOutcome<Bytes> / {fs.read[r], fs.write[r], abort.raise} =
  with_database[r](
    "s",
    packs::no_pack,
    b"",
    |_: Bytes, at: Bytes| read_then_saved[r]("files/" ++ String::of_bytes_lossy(at), saved),
    |_: Bytes| (),
    || in_session_of(test_queries(), name, b"a"),
  )

test "a session uses the bytes it compared at its start, so a file saved after that read waits for the next command" {
  let first = fs::on_mem[abs](fs::mem_of([{ path: "files/a", body: b"four" }]), ||
    session_over_files[abs](None, b"quoted"));
  let edited = fs::on_mem[abs](first.tree, || {
    fs.write_file[abs]("files/a", b"forty");
    session_over_files[abs](Some(b"FORTY"), b"quoted")
  });
  let next = fs::on_mem[abs](edited.tree, || session_over_files[abs](None, b"quoted"));
  assert_eq([first.value.value, edited.value.value, next.value.value], [
    b"\"four\"",
    b"\"forty\"",
    b"\"FORTY\"",
  ])
}

test "a stored value that fails its checksum makes the run start over from nothing and report the damage" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  let segment = stored_names(first.tree).filter(|n: String| n.starts_with("seg-")).get(0);
  let torn = fs::on_mem[abs](first.tree, || {
    fs.write_file[abs]("s/" ++ segment, b"not a segment");
    session_over_files[abs](None, b"quoted")
  });
  assert(torn.value.damage != None)
}

test "a manifest that names a missing segment is damage, not an empty store" {
  let first = fs::on_mem[abs](fs::mem_of([{ path: "files/a", body: b"four" }]), ||
    session_over_files[abs](None, b"quoted"));
  let segment = stored_names(first.tree).filter(|n: String| n.starts_with("seg-")).get(0);
  let lost = fs::on_mem[abs](first.tree, || {
    fs.remove[abs]("s/" ++ segment);
    session_over_files[abs](None, b"quoted")
  });
  assert_eq(lost.value.value, b"\"four\"");
  assert(lost.value.damage != None)
}

test "records survive a reopen beside the facts, and a dropped record is gone" {
  let facts = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  let written = fs::on_mem[abs](facts.tree, ||
    write_records[abs]("s", Map::new().insert(b"a", b"1").insert(b"b", b"2"), Set::empty()));
  let dropped = fs::on_mem[abs](written.tree, ||
    write_records[abs]("s", Map::new(), Set::empty().insert(b"a")));
  assert_eq(
    fs::on_mem[abs](dropped.tree, || read_records[abs]("s")).value,
    Ok(Map::new().insert(b"b", b"2")),
  );
  assert_eq(fs::on_mem[abs](dropped.tree, || quoted_over[abs](b"four")).value, b"\"four\"")
}

test "a copied database is correct for its new place, and an edit there changes what it reads" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_in[abs]("one", b"four"));
  let copied = fs::on_mem[abs](first.tree, || {
    copy_database[abs]("one", "two");
    quoted_in[abs]("two", b"four")
  });
  assert_eq(copied.value, b"\"four\"");
  assert_eq(fs::on_mem[abs](copied.tree, || quoted_in[abs]("two", b"forty")).value, b"\"forty\"")
}

test "two checkouts share nothing, so an edit in one leaves the other's results in place" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_in[abs]("one", b"four"));
  let other = fs::on_mem[abs](first.tree, || quoted_in[abs]("two", b"forty"));
  assert_eq(fs::on_mem[abs](other.tree, || quoted_in[abs]("one", b"four")).value, b"\"four\"")
}

test "a pack holds the facts of the keys it is built from, and a trusted run uses them without reading the files" {
  let queries = test_queries();
  let long = b"long ".repeat(1000);
  let keys = [b"text", b"quoted"].map(|name: Bytes| fact_key(name, b"a"));
  let pack = fs::on_mem[abs](fs::mem_of([]), || {
    quoted_over[abs](long);
    write_pack[abs]("s", keys, queries_id(queries), b"files")
  }).value;
  let used = fs::on_mem[abs](fs::mem_of([]), ||
    with_database[abs](
      "s",
      |path: String, offset: Int, len: Int| packs::frame_in(Some(pack.written), path, offset, len),
      b"files",
      |_: Bytes, _: Bytes| None,
      |_: Bytes| (),
      || in_session_of(queries, b"quoted", b"a"),
    ));
  assert_eq(used.value.value, Bytes::concat_all([b"\"", long, b"\""]))
}

fn query(
  name: Bytes,
  hash: Bytes,
  body: keep (Bytes) -> Bytes / {memo.read, memo.write, abort.raise},
) -> Query<| {}> =
  {
    name: name,
    hash: hash,
    body: |input: Bytes| main_only(body(input)),
    persistent: true,
    product: None,
  }

fn read_file(input: Bytes) -> Bytes / {memo.read} =
  match memo.external(b"file", input) { Some(text) -> text, None -> b"" }

fn fetched_main(name: Bytes, input: Bytes) -> Bytes / {memo.read, abort.raise} =
  match memo.fetch(name, input, main_part) {
    Some(o) -> o,
    None -> panic("a query returned no main part"),
  }

type TestWorld = { files: Map<Bytes, Bytes>, store: fs::MemFs }

fn world_of(files: List<{ at: Bytes, text: Bytes }>) -> TestWorld =
  {
    files: files.fold(Map::new(), |found: Map<Bytes, Bytes>, f: { at: Bytes, text: Bytes }|
      found.insert(f.at, f.text)),
    store: fs::mem_empty(),
  }

fn edited(w: TestWorld, at: Bytes, text: Bytes) -> TestWorld =
  { ..w, files: w.files.insert(at, text) }

fn from_nothing(w: TestWorld) -> TestWorld = { ..w, store: fs::mem_empty() }

type Answered = { output: Bytes, world: TestWorld }

fn fetched_in(
  named: Map<Bytes, Query<| {}>>,
  w: TestWorld,
  name: Bytes,
  input: Bytes,
) -> Answered / {abort.raise} = {
  let done = with_store_in_memory(w.store, packs::no_pack, b"", |_: Bytes, at: Bytes|
    w.files.get(at), || in_session_of(plain_queries(named), name, input));
  { output: done.value, world: { ..w, store: done.tree } }
}

fn agreed(
  named: Map<Bytes, Query<| {}>>,
  w: TestWorld,
  name: Bytes,
  input: Bytes,
) -> Answered / {abort.raise} = {
  let stored = fetched_in(named, w, name, input);
  assert_eq(stored.output, fetched_in(named, from_nothing(w), name, input).output);
  stored
}

fn same_facts(a: Answered, b: Answered) -> Unit / {abort.raise} = {
  assert_eq(a.output, b.output);
  assert_eq(facts_in_memory(a.world.store), facts_in_memory(b.world.store))
}

fn length_of(input: Bytes) -> Bytes / {memo.read} =
  Bytes::of_string(read_file(input).len().to_string())

fn length_label(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  b"long ".concat(fetched_main(b"length", input))

fn lengths(length_code: Bytes) -> Map<Bytes, Query<| {}>> =
  Map::new().insert(b"length", query(b"length", length_code, length_of)).insert(
    b"label",
    query(b"label", b"l1", length_label),
  )

fn four() -> TestWorld = world_of([{ at: b"a", text: b"four" }])

test "a run stopped after any number of writes leaves a store from which the next run returns what a build from nothing returns" {
  let q = lengths(b"h1");
  let moved = edited(fetched_in(q, four(), b"label", b"a").world, b"a", b"forty");
  let complete = fetched_in(q, moved, b"label", b"a").world.store;
  let look = |_: Bytes, at: Bytes| moved.files.get(at);
  iterate(0, 1099511627776, |writes: Int| {
    let tried = with_writes_limited(moved.store, FailAfter(writes), packs::no_pack, b"", look, ||
      in_session_of(plain_queries(q), b"label", b"a"));
    let left = match tried { Finished(ran) -> ran.tree, Stopped(stopped) -> stopped.tree };
    agreed(q, { ..moved, store: left }, b"label", b"a");
    if same_database_in_memory(left, complete) { Stop(()) } else { Continue(writes + 1) }
  })
}

fn fixed_reader(code: Bytes) -> Map<Bytes, Query<| {}>> =
  Map::new().insert(
    b"read",
    query(b"read", code, |input: Bytes| {
      let found = memo.external(b"file", input);
      memo.fix(b"file", input);
      match found { Some(b) -> b, None -> b"" }
    }),
  )

fn picker() -> Map<Bytes, Query<| {}>> =
  Map::new().insert(
    b"pick",
    query(b"pick", b"p1", |input: Bytes| {
      let chosen = match memo.external(b"file", input) { Some(b) -> b, None -> b"" };
      match memo.external(b"file", chosen) { Some(b) -> b, None -> b"" }
    }),
  )

test "a fixed input keeps the value it was read with, so a query that runs again reads that value" {
  let first = fetched_in(fixed_reader(b"r1"), four(), b"read", b"a");
  let again = fetched_in(fixed_reader(b"r2"), edited(first.world, b"a", b"FOUR"), b"read", b"a");
  assert_eq([first.output, again.output], [b"four", b"four"])
}

test "an input that no fact reads any more is deleted" {
  let w = world_of([
    { at: b"choice", text: b"a" },
    { at: b"a", text: b"A" },
    { at: b"b", text: b"B" },
  ]);
  let first = fetched_in(picker(), w, b"pick", b"choice");
  let moved = fetched_in(picker(), edited(first.world, b"choice", b"b"), b"pick", b"choice");
  assert_eq([first.output, moved.output], [b"A", b"B"]);
  assert_eq(
    inputs_in_memory(moved.world.store).flat_map(|i: StoredInput|
      match i { ExternalInput(e) -> [e.at], SealedInput(_) -> [] }).filter(|at: Bytes| at == b"a"),
    [],
  )
}

fn unkept_text(text: Bytes) -> Map<Bytes, Query<| {}>> = {
  let made = query(b"text", b"t1", |input: Bytes| {
    let _ = memo.external(b"file", input);
    text
  });
  Map::new().insert(b"text", { ..made, persistent: false })
}

test "a result made again that differs from its record is rejected" {
  let long = b"long ".repeat(1000);
  let first = fetched_in(unkept_text(long), four(), b"text", b"a");
  assert_eq(
    handle {
      Some(fetched_in(unkept_text(long.concat(b"!")), first.world, b"text", b"a").output)
    } with {
      abort.raise(_) -> None,
    },
    None,
  )
}

effect looking {
  write looked_at(at: Bytes) -> Unit
}

fn doubled_length(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  read_file(input).concat(fetched_main(b"length", input))

fn input_looks(
  store: fs::MemFs,
  input: Bytes,
) -> { store: fs::MemFs, looks: List<Bytes> } / {abort.raise} = {
  let q = lengths(b"h1").insert(b"doubled", query(b"doubled", b"d1", doubled_length));
  handle {
    with_store_in_memory(
      store,
      packs::no_pack,
      b"",
      |_: Bytes, at: Bytes| {
        looking.looked_at(at);
        Some(at)
      },
      || in_session_of(plain_queries(q), b"doubled", input),
    ).tree
  } with {
    var looks: List<Bytes> = [],
    looking.looked_at(at) -> {
      looks = looks.push(at);
    },
    return final_store -> { store: final_store, looks: looks },
  }
}

test "a run reads each input once, in the update and in every query that reads it" {
  let first = input_looks(fs::mem_empty(), b"a");
  assert_eq(first.looks, [b"a"]);
  assert_eq(input_looks(first.store, b"a").looks, [b"a"])
}

test "a result that comes out the same after an edit leaves its dependents as a build from nothing makes them" {
  let q = lengths(b"h1");
  let first = agreed(q, four(), b"label", b"a");
  let same = agreed(q, edited(first.world, b"a", b"FOUR"), b"label", b"a");
  assert_eq(same.output, b"long 4");
  assert_eq(agreed(q, edited(same.world, b"a", b"forty"), b"label", b"a").output, b"long 5")
}

test "a change reaches every stored dependent, including ones this command does not ask for" {
  let q = lengths(b"h1");
  let first = fetched_in(q, four(), b"label", b"a");
  let elsewhere = agreed(q, edited(first.world, b"a", b"forty"), b"length", b"a");
  assert_eq(agreed(q, elsewhere.world, b"label", b"a").output, b"long 5")
}

test "a query whose code changed gives its dependents what a build from nothing gives them" {
  let first = fetched_in(lengths(b"h1"), four(), b"label", b"a");
  assert_eq(agreed(lengths(b"h2"), first.world, b"label", b"a").output, b"long 4")
}

fn split_lines(input: Bytes) -> Parts / {memo.read, abort.raise} = {
  let lines = read_file(input).split(b"\n");
  range(0, lines.len()).fold(main_only(b"lines"), |parts: Parts, i: Int|
    parts.insert(Bytes::of_string(i.to_string()), lines.get(i)))
}

fn line_shouted(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  match memo.fetch(b"split", input.slice(0, 1), input.slice(1, input.len())) {
    Some(line) -> line.concat(b"!"),
    None -> b"no line!",
  }

fn line_queries() -> Map<Bytes, Query<| {}>> =
  Map::new().insert(b"split", { ..query(b"split", b"s1", read_file), body: split_lines }).insert(
    b"shout",
    query(b"shout", b"o1", line_shouted),
  )

fn lines_world(text: Bytes) -> TestWorld = world_of([{ at: b"f", text: text }])

test "a reader of one part reads what a build from nothing reads after another part of the same fact changes" {
  let q = line_queries();
  let first = fetched_in(q, lines_world(b"one\ntwo"), b"shout", b"f0");
  let second = fetched_in(q, first.world, b"shout", b"f1");
  assert_eq([first.output, second.output], [b"one!", b"two!"]);
  let edit = agreed(q, edited(second.world, b"f", b"one\nTWO"), b"shout", b"f0");
  assert_eq(edit.output, b"one!");
  assert_eq(agreed(q, edit.world, b"shout", b"f1").output, b"TWO!")
}

test "a reader that found no part reads the part once it appears" {
  let q = line_queries();
  let first = fetched_in(q, lines_world(b"one"), b"shout", b"f1");
  assert_eq(first.output, b"no line!");
  let grown = agreed(q, edited(first.world, b"f", b"one\ntwo"), b"shout", b"f2");
  assert_eq(agreed(q, grown.world, b"shout", b"f1").output, b"two!")
}

test "a part its query stops returning is gone, and its readers see what a fresh build sees" {
  let q = line_queries();
  let first = fetched_in(q, lines_world(b"one\ntwo"), b"shout", b"f1");
  assert_eq(agreed(q, edited(first.world, b"f", b"one"), b"shout", b"f1").output, b"no line!")
}

fn gated(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  if read_file(b"gate") == b"open" { fetched_main(b"inner", input) } else { b"closed" }

fn inner(input: Bytes) -> Bytes / {memo.read} = read_file(b"inner").concat(b"!")

fn gated_queries() -> Map<Bytes, Query<| {}>> =
  Map::new().insert(b"gated", query(b"gated", b"g1", gated)).insert(
    b"inner",
    query(b"inner", b"i1", inner),
  )

test "a fact that nothing uses any more is deleted" {
  let q = gated_queries();
  let first = fetched_in(q, world_of([{ at: b"gate", text: b"open" }]), b"gated", b"x");
  let closed = fetched_in(q, edited(first.world, b"gate", b"shut"), b"gated", b"x");
  same_facts(closed, fetched_in(q, from_nothing(closed.world), b"gated", b"x"))
}

fn guarded(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  if read_file(b"cycle") == b"yes" { b"reported" } else { fetched_main(b"walk", input) }

fn walked(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  if read_file(b"cycle") == b"yes" { panic("the walk never ends") } else { b"walked" }

fn guarded_queries() -> Map<Bytes, Query<| {}>> =
  Map::new().insert(b"guard", query(b"guard", b"g1", guarded)).insert(
    b"walk",
    query(b"walk", b"w1", walked),
  )

test "a recomputation that fails deletes its fact, and the run ends as a build from nothing ends" {
  let q = guarded_queries();
  let first = fetched_in(q, world_of([{ at: b"cycle", text: b"no" }]), b"guard", b"x");
  assert_eq(first.output, b"walked");
  let looped = fetched_in(q, edited(first.world, b"cycle", b"yes"), b"guard", b"x");
  assert_eq(looped.output, b"reported");
  same_facts(looped, fetched_in(q, from_nothing(looped.world), b"guard", b"x"))
}

fn ring_a(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  if read_file(b"ring") == b"on" { fetched_main(b"b", input) } else { b"a" }

fn ring_b(input: Bytes) -> Bytes / {memo.read, abort.raise} = fetched_main(b"a", input)

test "a query that asks for its own result fails after an edit as it fails in a fresh build" {
  let q = Map::new().insert(b"a", query(b"a", b"a1", ring_a)).insert(
    b"b",
    query(b"b", b"b1", ring_b),
  );
  let first = fetched_in(q, world_of([{ at: b"ring", text: b"off" }]), b"b", b"x");
  assert_eq(first.output, b"a");
  let ringed = edited(first.world, b"ring", b"on");
  let tried = |w: TestWorld|
    handle { Some(fetched_in(q, w, b"b", b"x").output) } with { abort.raise(_) -> None };
  assert_eq(tried(ringed), None);
  assert_eq(tried(from_nothing(ringed)), None)
}

fn cascading(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  blake3(fetched_main(b"length", input))

const hash_kind: Option<Product> = Some({ kind: b"hash", after: [] })

fn product_queries() -> Map<Bytes, Query<| {}>> =
  lengths(b"h1").insert(b"hash", { ..query(b"hash", b"p1", cascading), product: hash_kind })

test "a product asked for after an edit that another command read first comes out as a build from nothing makes it" {
  let q = product_queries();
  let first = fetched_in(q, four(), b"hash", b"a");
  let moved = agreed(q, edited(first.world, b"a", b"forty"), b"length", b"a");
  let later = agreed(q, moved.world, b"hash", b"a");
  assert_eq(later.output, blake3(b"5"));
  agreed(q, later.world, b"hash", b"a")
}

fn doc_of(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  b"doc ".concat(fetched_main(b"length", input))

fn two_kinds() -> Map<Bytes, Query<| {}>> =
  product_queries().insert(b"doc", {
    ..query(b"doc", b"d1", doc_of),
    product: Some({ kind: b"doc", after: [] }),
  })

test "each kind of product catches up by itself, and each comes out as a build from nothing makes it" {
  let q = two_kinds();
  let hashed = fetched_in(q, four(), b"hash", b"a");
  let both = fetched_in(q, hashed.world, b"doc", b"a");
  let moved = agreed(q, edited(both.world, b"a", b"forty"), b"hash", b"a");
  assert_eq(agreed(q, moved.world, b"doc", b"a").output, b"doc 5")
}

test "a product whose code changed comes out as a build from nothing makes it" {
  let labelled = fetched_in(product_queries(), four(), b"label", b"a");
  let first = fetched_in(product_queries(), labelled.world, b"hash", b"a");
  let q = lengths(b"h1").insert(b"hash", {
    ..query(b"hash", b"p2", |input: Bytes| blake3(b"again ".concat(fetched_main(b"length", input)))),
    product: hash_kind,
  });
  let length = agreed(q, first.world, b"length", b"a");
  assert_eq(agreed(q, length.world, b"hash", b"a").output, blake3(b"again 4"))
}

fn over_two(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  Bytes::concat_all([fetched_main(b"length", input), fetched_main(b"label", input)])

test "a query with two paths to a change comes out as a build from nothing makes it" {
  let q = lengths(b"h1").insert(b"both", query(b"both", b"b1", over_two));
  let first = fetched_in(q, four(), b"both", b"a");
  assert_eq(agreed(q, edited(first.world, b"a", b"forty"), b"both", b"a").output, b"5long 5")
}

fn shout_text(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  fetched_main(b"text", input).concat(b"!")

fn unkept_shout() -> Map<Bytes, Query<| {}>> =
  Map::new().insert(b"text", { ..query(b"text", b"t1", read_file), persistent: false }).insert(
    b"shout",
    query(b"shout", b"o1", shout_text),
  )

test "a result that is not stored is computed again, even when an earlier version of its fact would hold" {
  let long = b"long ".repeat(1000);
  let longer = b"longer ".repeat(1000);
  let q = unkept_shout();
  let first = fetched_in(q, world_of([{ at: b"a", text: long }]), b"shout", b"a");
  let moved = fetched_in(q, edited(first.world, b"a", longer), b"shout", b"a");
  assert_eq(agreed(q, edited(moved.world, b"a", long), b"shout", b"a").output, long.concat(b"!"))
}

test "a large result of a query that does not keep its results is computed again when needed" {
  let long = b"long ".repeat(1000);
  let q = unkept_shout();
  let first = fetched_in(q, world_of([{ at: b"a", text: long }]), b"shout", b"a");
  assert_eq(fetched_in(q, first.world, b"text", b"a").output, long)
}

test "a fact in a trusted pack is used as it is, and a project records what it used" {
  let q = lengths(b"h1");
  let source = fetched_in(q, four(), b"length", b"a").world;
  let qs = plain_queries(q);
  let pack = pack_in_memory(
    source.store,
    facts_in_memory(source.store).keys(),
    queries_id(qs),
    b"files",
  );
  let read = |path: String, offset: Int, len: Int| packs::frame_in(Some(pack), path, offset, len);
  let done = with_store_in_memory(fs::mem_empty(), read, b"files", |_: Bytes, _: Bytes| None, ||
    in_session_of(qs, b"label", b"a"));
  assert_eq(done.value, b"long 4");
  assert(
    inputs_in_memory(done.tree).any(|i: StoredInput|
      match i { SealedInput(_) -> true, ExternalInput(_) -> false }),
  )
}

test "a fact that used a sealed fact is recomputed when a new pack changes that fact" {
  let q = lengths(b"h1");
  let pack_of = |w: TestWorld, files: Bytes| {
    let built = fetched_in(q, w, b"length", b"a").world;
    let written = pack_in_memory(
      built.store,
      facts_in_memory(built.store).keys(),
      queries_id(plain_queries(q)),
      files,
    );
    |path: String, offset: Int, len: Int| packs::frame_in(Some(written), path, offset, len)
  };
  let older = pack_of(four(), b"old");
  let newer = pack_of(world_of([{ at: b"a", text: b"forty" }]), b"new");
  let run_with = |store: fs::MemFs, read: (String, Int, Int) -> Option<Bytes> / {abort.raise}, files: Bytes|
    with_store_in_memory(store, read, files, |_: Bytes, _: Bytes| None, ||
      in_session_of(plain_queries(q), b"label", b"a"));
  let first = run_with(fs::mem_empty(), older, b"old");
  assert_eq(first.value, b"long 4");
  assert_eq(run_with(first.tree, newer, b"new").value, b"long 5")
}

fn together(name: Bytes, input: Bytes) -> Bytes / {memo.read, abort.raise} =
  Bytes::join(
    memo.fetch_all(name, input.split(b","), main_part).map(|o: Option<Bytes>|
      match o { Some(b) -> b, None -> panic("a query returned no main part") }),
    b",",
  )

fn one_by_one(name: Bytes, input: Bytes) -> Bytes / {memo.read, abort.raise} =
  Bytes::join(input.split(b",").map(|read: Bytes| fetched_main(name, read)), b",")

fn counted_down(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  if input.len() <= 1 { read_file(input) }
  else { fetched_main(b"down", input.slice(1, input.len())).concat(input.slice(0, 1)) }

fn batched(
  fetch_many: keep (Bytes, Bytes) -> Bytes / {memo.read, abort.raise},
) -> Map<Bytes, Query<| {}>> =
  lengths(b"h1").insert(b"down", query(b"down", b"d1", counted_down)).insert(
    b"lengths",
    query(b"lengths", b"s1", |input: Bytes| fetch_many(b"length", input)),
  ).insert(
    b"labels",
    query(b"labels", b"s2", |input: Bytes| fetch_many(b"label", input)),
  ).insert(
    b"downs",
    query(b"downs", b"s3", |input: Bytes| fetch_many(b"down", input)),
  )

const three_files: List<{ at: Bytes, text: Bytes }> =
  [{ at: b"a", text: b"four" }, { at: b"b", text: b"seven" }, { at: b"c", text: b"ten" }]

test "facts fetched together store the outputs and reads that fetching them one at a time stores" {
  let w = world_of(three_files);
  let apart = fetched_in(batched(together), w, b"lengths", b"a,b,c");
  assert_eq(apart.output, b"4,5,3");
  same_facts(apart, fetched_in(batched(one_by_one), w, b"lengths", b"a,b,c"))
}

test "facts of one depth recomputed together after an edit end as a build from nothing ends" {
  let first = fetched_in(batched(together), world_of(three_files), b"lengths", b"a,b,c");
  let moved = edited(edited(first.world, b"a", b"forty"), b"c", b"eleven");
  let after = fetched_in(batched(together), moved, b"lengths", b"a,b,c");
  assert_eq(after.output, b"5,5,6");
  same_facts(after, fetched_in(batched(together), from_nothing(moved), b"lengths", b"a,b,c"))
}

test "a fact fetched together whose body needs a fact not yet computed still comes out right" {
  let w = world_of(three_files);
  let labels = fetched_in(batched(together), w, b"labels", b"a,b");
  assert_eq(labels.output, b"long 4,long 5");
  same_facts(labels, fetched_in(batched(one_by_one), w, b"labels", b"a,b"));
  let downs = fetched_in(batched(together), w, b"downs", b"cba,a,ba");
  assert_eq(downs.output, b"fourbc,four,fourb");
  same_facts(downs, fetched_in(batched(one_by_one), w, b"downs", b"cba,a,ba"))
}
