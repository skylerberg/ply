import std.bytes (u32_le, u64_le, ascii_of_int)
import std.hash (blake3)
import compiler.store.segments (read_u32)
import std.list

const magic: Bytes = b"PLYPROG1"

pub const library_magic: Bytes = b"PLYLIB01"

pub const domain: Bytes = b"ply.program.2"

pub const library_domain: Bytes = b"ply.library.1"

pub const format_version: Int = 7

const flag_closure: Int = 1
const flag_unit: Int = 2
const flag_runnable: Int = 4

const header_len: Int = 152
const descriptor_len: Int = 24

const offset_format: Int = 8
const offset_flags: Int = 12
const offset_frontend: Int = 16
const offset_runtime_hash: Int = 48
const offset_entry: Int = 80
pub const offset_digest: Int = 112
const offset_sections: Int = 144
const offset_reserved: Int = 148

fn kind_of(name: Bytes) -> Int =
  if name == b"bodies" { 1 }
  else if name == b"names" { 2 }
  else if name == b"strings" { 3 }
  else if name == b"closure" { 4 }
  else if name == b"unit" { 5 }
  else if name == b"sources" { 6 }
  else if name == b"manifest" { 7 }
  else if name == b"runnable" { 8 }
  else { 0 }

fn name_of(kind: Int) -> Bytes =
  if kind == 1 { b"bodies" }
  else if kind == 2 { b"names" }
  else if kind == 3 { b"strings" }
  else if kind == 4 { b"closure" }
  else if kind == 5 { b"unit" }
  else if kind == 6 { b"sources" }
  else if kind == 7 { b"manifest" }
  else if kind == 8 { b"runnable" }
  else { b"" }

pub type Header = { frontend: Bytes, runtime: Bytes, entry: Bytes }

pub type Section = { name: Bytes, count: Int, payload: Bytes }

pub type SectionLocation = { name: Bytes, kind: Int, count: Int, at: Int, len: Int }

pub type Container = {
  format: Int,
  flags: Int,
  frontend: Bytes,
  runtime: Bytes,
  entry: Bytes,
  digest: Bytes,
  sections: List<SectionLocation>,
}

pub type DecodeError = { stale: Bool, note: Bytes, message: Bytes }

pub type Range = { at: Int, len: Int }

fn fixed_width(b: Bytes, n: Int) -> Bytes / {abort.raise} =
  if b.len() == n { b }
  else if b.len() > n { b.slice(0, n) }
  else { b.concat(b"\x00".repeat(n - b.len())) }

fn has_section(sections: List<Section>, name: Bytes) -> Bool =
  sections.filter(|section: Section| section.name == name).len() > 0

fn flags_of(sections: List<Section>) -> Int =
  (if has_section(sections, b"closure") { flag_closure } else { 0 })
    | (if has_section(sections, b"unit") { flag_unit } else { 0 })
    | (if has_section(sections, b"runnable") { flag_runnable } else { 0 })

fn section_kind(section: Section) -> Int / {abort.raise} = {
  let k = kind_of(section.name);
  if k == 0 { panic("the container format has no kind for a section with this name") } else { k }
}

fn header(container_magic: Bytes, head: Header, sections: List<Section>) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    container_magic,
    u32_le(format_version),
    u32_le(flags_of(sections)),
    fixed_width(head.frontend, 32),
    fixed_width(head.runtime, 32),
    fixed_width(head.entry, 32),
    b"\x00".repeat(32),
    u32_le(sections.len()),
    u32_le(0),
  ])

fn descriptor(section: Section, start: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    u32_le(section_kind(section)),
    u32_le(section.count),
    u64_le(start),
    u64_le(section.payload.len()),
  ])

fn section_offsets(table: Int, sections: List<Section>) -> List<Int> = {
  let walked = sections.fold(
    { at: table, out: [] },
    |accumulator: { at: Int, out: List<Int> }, section: Section|
      { at: accumulator.at + section.payload.len(), out: accumulator.out.push(accumulator.at) },
  );
  walked.out
}

pub fn encode(head: Header, sections: List<Section>) -> Bytes / {abort.raise} =
  encode_named(magic, head, sections)

pub fn encode_named(
  container_magic: Bytes,
  head: Header,
  sections: List<Section>,
) -> Bytes / {abort.raise} = {
  let table = header_len + descriptor_len * sections.len();
  let offsets = section_offsets(table, sections);
  Bytes::concat_all(
    [header(container_magic, head, sections)].concat(
      range(0, sections.len()).map(|i: Int| descriptor(sections.get(i), offsets.get(i))),
    ).concat(
      sections.map(|section: Section| section.payload),
    ),
  )
}

fn malformed(message: Bytes) -> DecodeError = { stale: false, note: b"", message: message }

fn truncated(offset: Int, wanted: Int, n: Int) -> DecodeError =
  malformed(
    Bytes::concat_all([
      b"the artifact is ",
      ascii_of_int(n),
      b" bytes and wants ",
      ascii_of_int(wanted),
      b" more at offset ",
      ascii_of_int(offset),
    ]),
  )

fn hash32(b: Bytes, i: Int) -> Bytes = match b.slice_at(i, 32) { Some(x) -> x, None -> b"" }

fn descriptor_at(
  b: Bytes,
  d: Int,
  k: Int,
  table: Int,
  n: Int,
) -> Result<SectionLocation, DecodeError> = {
  let count = read_u32(b, d + 4);
  let beyond = malformed(
    Bytes::concat_all([
      b"section ",
      ascii_of_int(k),
      b" claims more bytes than a file could contain",
    ]),
  );
  match b.u64_at(d + 8) {
    None -> Err(beyond),
    Some(start) -> match b.u64_at(d + 16) {
      None -> Err(beyond),
      Some(size) -> if start < table || start > n || size > n - start {
        Err(
          malformed(
            Bytes::concat_all([
              b"section ",
              ascii_of_int(k),
              b" claims ",
              ascii_of_int(size),
              b" bytes at ",
              ascii_of_int(start),
              b" of a ",
              ascii_of_int(n),
              b"-byte file",
            ]),
          ),
        )
      } else { Ok({ name: name_of(k), kind: k, count: count, at: start, len: size }) },
    },
  }
}

fn section_table(
  b: Bytes,
  count: Int,
  table: Int,
  n: Int,
) -> Result<List<SectionLocation>, DecodeError> / {abort.raise} =
  iterate({ i: 0, out: [] }, count + 1, |s: { i: Int, out: List<SectionLocation> }|
    if s.i >= count { Stop(Ok(s.out)) } else {
      let d = header_len + descriptor_len * s.i;
      let k = read_u32(b, d);
      if s.out.filter(|placed: SectionLocation| placed.kind == k).len() > 0 {
        Stop(Err(malformed(Bytes::concat_all([b"section ", ascii_of_int(k), b" appears twice"]))))
      } else {
        match descriptor_at(b, d, k, table, n) {
          Err(e) -> Stop(Err(e)),
          Ok(p) -> Continue({ i: s.i + 1, out: s.out.push(p) }),
        }
      }
    })

pub fn decode(b: Bytes) -> Result<Container, DecodeError> / {abort.raise} =
  decode_as(magic, b"program artifact", b)

pub fn decode_library(b: Bytes) -> Result<Container, DecodeError> / {abort.raise} =
  decode_as(library_magic, b"library", b)

fn decode_as(
  container_magic: Bytes,
  what: Bytes,
  b: Bytes,
) -> Result<Container, DecodeError> / {abort.raise} = {
  let n = b.len();
  if n < header_len { Err(truncated(0, header_len, n)) }
  else if b.slice_at(0, 8) != Some(container_magic) {
    Err({
      stale: false,
      note: Bytes::concat_all([
        b"`ply build` writes one; the first eight bytes are `",
        container_magic,
        b"`",
      ]),
      message: b"this file is not a Ply ".concat(what),
    })
  } else {
    let written = read_u32(b, offset_format);
    if written != format_version {
      Err({
        stale: true,
        note: b"",
        message: Bytes::concat_all([
          b"the artifact is format ",
          ascii_of_int(written),
          b" and this `ply` writes and reads format ",
          ascii_of_int(format_version),
        ]),
      })
    } else {
      let count = read_u32(b, offset_sections);
      let table = header_len + descriptor_len * count;
      if table > n { Err(truncated(header_len, table - header_len, n)) } else {
        match section_table(b, count, table, n) {
          Err(e) -> Err(e),
          Ok(sections) ->
            Ok({
              format: written,
              flags: read_u32(b, offset_flags),
              frontend: hash32(b, offset_frontend),
              runtime: hash32(b, offset_runtime_hash),
              entry: hash32(b, offset_entry),
              digest: hash32(b, offset_digest),
              sections: sections,
            }),
        }
      }
    }
  }
}

pub fn digest_covered_ranges(n: Int) -> Option<List<Range>> =
  if n < offset_sections { None }
  else { Some([{ at: offset_entry, len: 32 }, { at: offset_sections, len: n - offset_sections }]) }

pub fn digest_of(digest_domain: Bytes, container: Bytes) -> Option<Bytes> / {abort.raise} =
  match digest_covered_ranges(container.len()) {
    None -> None,
    Some(ranges) ->
      Some(
        blake3(
          Bytes::concat_all(
            [digest_domain].concat(
              ranges.map(|range: Range| container.slice(range.at, range.at + range.len)),
            ),
          ),
        ),
      ),
  }

pub fn digest_text(d: Bytes) -> String / {abort.raise} = "b3:" ++ d.hex_of()

pub type DigestPlan = { domain: Bytes, at: Int, ranges: List<Range> }

pub fn digest_plan(n: Int) -> Option<DigestPlan> =
  match digest_covered_ranges(n) {
    None -> None,
    Some(rs) -> Some({ domain: domain, at: offset_digest, ranges: rs }),
  }

pub fn archive_digest(b: Bytes) -> String / {abort.raise} =
  match digest_of(library_domain, b) { Some(d) -> digest_text(d), None -> "" }

const sample: Header =
  {
    frontend: byte_of_int(0x11).repeat(32),
    runtime: byte_of_int(0x22).repeat(32),
    entry: byte_of_int(0x44).repeat(32),
  }

fn decoded(b: Bytes) -> Container / {abort.raise} =
  match decode(b) { Ok(x) -> x, Err(_) -> panic("a container this module wrote must read back") }

test "every header field is written where it is read back" {
  let bytes = encode(sample, []);
  assert_eq(bytes.len(), header_len);
  assert_eq(bytes.slice_at(0, 8), Some(magic));
  assert_eq(bytes.u32_at(offset_reserved), Some(0));
  let x = decoded(bytes);
  assert_eq(x.format, format_version);
  assert_eq(x.flags, 0);
  assert_eq(x.frontend, byte_of_int(0x11).repeat(32));
  assert_eq(x.runtime, byte_of_int(0x22).repeat(32));
  assert_eq(x.entry, byte_of_int(0x44).repeat(32));
  assert_eq(x.digest, b"\x00".repeat(32));
  assert_eq(x.sections.len(), 0)
}

test "a section's payload comes back where it was put" {
  let sections = [
    { name: b"bodies", count: 2, payload: b"AABBBB" },
    { name: b"closure", count: 1, payload: b"CCC" },
    { name: b"unit", count: 1, payload: b"D" },
  ];
  let bytes = encode(sample, sections);
  assert_eq(bytes.len(), header_len + 3 * descriptor_len + 10);
  let x = decoded(bytes);
  assert_eq(x.sections.len(), 3);
  assert_eq(x.flags, flag_closure | flag_unit);
  let first = x.sections.get(0);
  assert_eq(first.name, b"bodies");
  assert_eq(first.count, 2);
  assert_eq(bytes.slice_at(first.at, first.len), Some(b"AABBBB"));
  let last = x.sections.get(2);
  assert_eq(last.name, b"unit");
  assert_eq(bytes.slice_at(last.at, last.len), Some(b"D"))
}

test "the digest covers the entry point and the sections, and never its own field" {
  let bytes = encode(sample, [{ name: b"bodies", count: 1, payload: b"AA" }]);
  match digest_covered_ranges(bytes.len()) {
    None -> panic("an artifact this module wrote is long enough to carry a digest"),
    Some(rs) -> {
      assert_eq(rs.len(), 2);
      assert_eq(rs.get(0), { at: offset_entry, len: 32 });
      assert_eq(rs.get(1), { at: offset_sections, len: bytes.len() - offset_sections });
      assert(offset_digest >= offset_entry + 32);
      assert(offset_digest + 32 <= offset_sections)
    },
  }
}

test "an artifact's digest depends only on the domain string and the bytes in the digested ranges, not on the bytes stored in the digest field" {
  let bytes = encode_named(library_magic, sample, [{ name: b"sources", count: 0, payload: b"" }]);
  let tail = bytes.slice(offset_sections, bytes.len());
  let want = blake3(Bytes::concat_all([library_domain, byte_of_int(0x44).repeat(32), tail]));
  assert_eq(digest_of(library_domain, bytes), Some(want));
  let spliced = Bytes::concat_all([
    bytes.slice(0, offset_digest),
    want,
    bytes.slice(offset_digest + 32, bytes.len()),
  ]);
  assert_eq(digest_of(library_domain, spliced), Some(want));
  assert(digest_of(domain, bytes) != Some(want));
  assert_eq(digest_of(library_domain, b"short"), None);
  assert_eq(digest_text(b"\x01\xab"), "b3:01ab")
}

test "a library reads back under its own magic, and a program is not a library" {
  let lib = encode_named(library_magic, sample, [{ name: b"manifest", count: 1, payload: b"m" }]);
  let x = match decode_library(lib) {
    Ok(x) -> x,
    Err(_) -> panic("a library this module wrote must read back"),
  };
  assert_eq(x.sections.len(), 1);
  match decode(lib) {
    Ok(_) -> panic("a library is not a program"),
    Err(e) -> assert(e.message.contains(b"not a Ply program artifact")),
  };
  match decode_library(encode(sample, [])) {
    Ok(_) -> panic("a program is not a library"),
    Err(e) -> {
      assert(e.message.contains(b"not a Ply library"));
      assert(e.note.contains(b"PLYLIB01"))
    },
  }
}

test "an artifact too short to contain a header has no byte ranges to digest" {
  assert_eq(digest_covered_ranges(0), None);
  assert_eq(digest_covered_ranges(offset_sections - 1), None);
  assert_eq(
    digest_covered_ranges(offset_sections),
    Some([{ at: offset_entry, len: 32 }, { at: offset_sections, len: 0 }]),
  )
}

test "a digest plan names its domain, the field it is written into and the ranges it covers" {
  assert_eq(digest_plan(offset_sections - 1), None);
  assert_eq(
    digest_plan(offset_sections + 10),
    Some({
      domain: b"ply.program.2",
      at: offset_digest,
      ranges: [{ at: offset_entry, len: 32 }, { at: offset_sections, len: 10 }],
    }),
  )
}

test "a file that does not start with the magic bytes is rejected, and the error names the expected magic" {
  let bytes = encode(sample, []);
  let forged = b"NOTPLY01".concat(bytes.slice(8, bytes.len()));
  match decode(forged) {
    Ok(_) -> panic("a file that is not an artifact must be rejected"),
    Err(e) -> {
      assert_eq(e.stale, false);
      assert(e.message.contains(b"not a Ply program artifact"));
      assert(e.note.contains(b"PLYPROG1"))
    },
  }
}

test "a format this `ply` does not write is stale rather than damaged" {
  let bytes = encode(sample, []);
  let forged = Bytes::concat_all([
    bytes.slice(0, offset_format),
    u32_le(3),
    bytes.slice(offset_format + 4, bytes.len()),
  ]);
  match decode(forged) {
    Ok(_) -> panic("format 3 is not the format this `ply` reads"),
    Err(e) -> {
      assert(e.stale);
      assert(e.message.contains(b"format 3"))
    },
  }
}

test "a section count larger than the file could contain is rejected before any descriptor is read" {
  let bytes = encode(sample, []);
  let forged = Bytes::concat_all([
    bytes.slice(0, offset_sections),
    u32_le(4294967295),
    bytes.slice(offset_sections + 4, bytes.len()),
  ]);
  match decode(forged) {
    Ok(_) -> panic("a count past the end of the file must be rejected"),
    Err(e) -> {
      assert_eq(e.stale, false);
      assert(e.message.contains(b"wants"))
    },
  }
}

test "two sections with the same name are rejected" {
  match decode(
      encode(sample, [
        { name: b"bodies", count: 1, payload: b"A" },
        { name: b"bodies", count: 1, payload: b"B" },
      ]),
    ) {
    Ok(_) -> panic("two sections of one kind must be rejected"),
    Err(e) -> assert(e.message.contains(b"appears twice")),
  }
}

test "decoding any truncated prefix of an artifact fails" {
  let bytes = encode(sample, [
    { name: b"bodies", count: 1, payload: b"AAAA" },
    { name: b"names", count: 1, payload: b"BB" },
  ]);
  let believed = range(0, bytes.len()).filter(|cut: Int|
    match decode(bytes.slice(0, cut)) { Ok(_) -> true, Err(_) -> false });
  assert_eq(believed.len(), 0)
}
