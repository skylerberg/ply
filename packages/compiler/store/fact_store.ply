import std.set (Set)
import std.graph (Visit, traverse)
import std.fs
import std.fs (fs)
import std.bin
import std.bytes (u32_le, u64_le, u64_be)
import std.bytes
import std.list
import std.show (show)
import compiler.store.segments
import compiler.store.segments (CommitResult, Committed, LockHeld, Manifest, Segment, SegmentWriter,
                                StoreChanged, WriteFailed)
import compiler.store.fact_tree
import compiler.store.fact_tree (TreeEntry, TreeNode, TreeRoot, tree_node_bin)

pub effect fact_damage {
  raise damaged(reason: String)
}

pub effect recent_reads {
  read node(hash: Bytes) -> Option<TreeNode>
  write keep_node(hash: Bytes, node: TreeNode) -> Unit
  read table(name: Bytes) -> Option<Bytes>
  write keep_table(name: Bytes, rows: Bytes) -> Unit
}

pub type Tree = | Facts | Dependents | Inputs | Codes | Records | Cursors | PackUsed

pub type LogEntry = { offset: Int, changes: List<Bytes> }

pub type Snapshot = Map<Int, TreeRoot>

pub type Database = {
  dir: String,
  manifest: Manifest,
  snapshot: Snapshot,
  pending: Map<Int, Map<Bytes, Option<Bytes>>>,
  unwritten_log: Map<Int, Bytes>,
  log_end: Int,
  starts_over: Bool,
  run: Option<String>,
  token: Bytes,
  writing: SegmentWriter,
  written_results: Map<Bytes, PayloadPlace>,
  log_floor: Int,
}

const schema: Bytes = b"ply fact database 12".blake3()

type Table = | NodesTable | ChangesTable | SnapshotsTable | ResultsTable

fn table_number(table: Table) -> Int =
  match table { NodesTable -> 1, ChangesTable -> 2, SnapshotsTable -> 4, ResultsTable -> 5 }

fn key_width(table: Table) -> Int = match table { ChangesTable -> 8, _ -> 32 }

fn row_width(table: Table) -> Int = key_width(table) + 12

type PayloadPlace = { at: Int, size: Int }

fn place_row(_: Bytes, place: PayloadPlace) -> Option<Bytes> =
  Some(u64_le(place.at).concat(u32_le(place.size)))

fn row_place(row: Bytes, at: Int) -> PayloadPlace / {fact_damage.damaged, abort.raise} =
  match ((row.u64_at(at), row.u32_at(at + 8))) {
    (Some(offset), Some(size)) -> { at: offset, size: size },
    _ -> fact_damage.damaged("a table row is shorter than its table's width"),
  }

const current_snapshot: Bytes = b"current snapshot".blake3()

fn tree_number(tree: Tree) -> Int =
  match tree {
    Facts -> 1,
    Dependents -> 3,
    Inputs -> 4,
    Codes -> 5,
    Records -> 6,
    Cursors -> 7,
    PackUsed -> 8,
  }

fn changes_codec() -> bin::BinCodec<List<Bytes>> = bin::list_bin(bin::bytes_bin())

fn table_name(seg: Segment, table: Table) -> Bytes / {abort.raise} =
  seg.token.concat(byte_of_int(table_number(table)))

fn loaded_rows<[r]>(
  db: Database,
  seg: Segment,
  table: Table,
) -> Bytes / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} = {
  let name = table_name(seg, table);
  match recent_reads.table(name) {
    Some(rows) -> rows,
    None -> match segments::table_rows[r](db.dir, seg, table_number(table)) {
      Some(rows) -> {
        recent_reads.keep_table(name, rows);
        rows
      },
      None -> fact_damage.damaged("a table does not match its checksum"),
    },
  }
}

fn row_in_segment<[r]>(
  db: Database,
  seg: Segment,
  table: Table,
  key: Bytes,
) -> Option<Bytes> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  segments::row_of(loaded_rows[r](db, seg, table), row_width(table), key)

type StoredRow = { token: Bytes, row: Bytes }

fn stored_row<[r]>(
  db: Database,
  table: Table,
  key: Bytes,
) -> Option<StoredRow> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  iterate(db.manifest.segments.len() - 1, db.manifest.segments.len() + 1, |i: Int|
    if i < 0 || db.starts_over { Stop(None) } else {
      let seg = db.manifest.segments.get(i);
      match row_in_segment[r](db, seg, table, key) {
        Some(row) -> Stop(Some({ token: seg.token, row: row })),
        None -> Continue(i - 1),
      }
    })

fn table_value<[r]>(
  db: Database,
  table: Table,
  key: Bytes,
) -> Option<Bytes> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  match stored_row[r](db, table, key) {
    None -> None,
    Some(found) -> {
      let place = row_place(found.row, key_width(table));
      match segments::payload[r](db.dir, found.token, place.at, place.size) {
        Some(bytes) -> Some(bytes),
        None -> fact_damage.damaged("a stored value does not match its checksum"),
      }
    },
  }

fn decoded<a>(bytes: Bytes, codec: bin::BinCodec<a>) -> a / {fact_damage.damaged, abort.raise} =
  match bin::decode(bytes, codec) {
    Ok(value) -> value,
    Err(_) -> fact_damage.damaged("a stored value does not decode"),
  }

fn node_at<[r]>(
  db: Database,
  hash: Bytes,
) -> TreeNode / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  match recent_reads.node(hash) {
    Some(node) -> node,
    None -> match table_value[r](db, NodesTable, hash) {
      Some(bytes) -> {
        let node = decoded(bytes, tree_node_bin());
        recent_reads.keep_node(hash, node);
        node
      },
      None -> fact_damage.damaged("a snapshot names a tree node that is not stored"),
    },
  }

pub fn with_recent_reads<a | e>(
  work: () -> a / {recent_reads.read, recent_reads.write | e},
) -> a / e =
  handle {
    work()
  } with {
    var nodes: Map<Bytes, TreeNode> = Map::new(),
    var tables: Map<Bytes, Bytes> = Map::new(),
    recent_reads.node(hash) -> nodes.get(hash),
    recent_reads.keep_node(hash, node) -> {
      nodes = nodes.insert(hash, node);
    },
    recent_reads.table(name) -> tables.get(name),
    recent_reads.keep_table(name, rows) -> {
      tables = tables.insert(name, rows);
    },
  }

fn fresh_database(dir: String, manifest: Manifest) -> Database =
  {
    dir: dir,
    manifest: manifest,
    snapshot: Map::new(),
    pending: Map::new(),
    unwritten_log: Map::new(),
    log_end: 0,
    starts_over: false,
    run: None,
    token: b"",
    writing: segments::new_writer,
    written_results: Map::new(),
    log_floor: 0,
  }

pub opaque type Opening = | Opening({ dir: String, run: Option<String> })

type Current = { blank: Database, file: segments::ManifestFile }

fn current<[r]>(opening: Opening) -> Current / {fs.read[r], abort.raise} =
  match opening {
    Opening(o) -> {
      let file = segments::manifest_file[r](o.dir, schema);
      let manifest = segments::listed(file);
      {
        blank: {
          ..fresh_database(o.dir, manifest),
          run: o.run,
          token: segments::segment_token(o.run, manifest.generation, 0),
          writing: if o.run == None { segments::failed_writer } else { segments::new_writer },
        },
        file: file,
      }
    },
  }

pub const unreadable_manifest: String = "its manifest does not read"

pub fn emptied<[r]>(opening: Opening) -> Database / {fs.read[r], abort.raise} = {
  let now = current[r](opening);
  { ..now.blank, starts_over: true }
}

type StoredState = { roots: List<fact_tree::TreeChild>, log_end: Int }

derive bin for StoredState

fn with_stored_state<[r]>(
  blank: Database,
  file: segments::ManifestFile,
) -> Database / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  match file {
    segments::Garbled -> fact_damage.damaged(unreadable_manifest),
    _ -> match table_value[r](blank, SnapshotsTable, current_snapshot) {
      None -> if blank.manifest.segments.len() == 0 { blank }
      else { fact_damage.damaged("the manifest lists segments that hold no snapshot") },
      Some(bytes) -> {
        let state = decoded(bytes, stored_state_bin());
        {
          ..blank,
          snapshot: state.roots.fold(Map::new(), |roots: Snapshot, child: fact_tree::TreeChild|
            roots.insert(child.slot, child.root)),
          log_end: state.log_end,
        }
      },
    },
  }

pub fn loaded<[r]>(
  opening: Opening,
) -> Database / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} = {
  let now = current[r](opening);
  with_stored_state[r](now.blank, now.file)
}

pub fn read_only<[r]>(
  dir: String,
) -> Database / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} = {
  let file = segments::manifest_file[r](dir, schema);
  with_stored_state[r](fresh_database(dir, segments::listed(file)), file)
}

pub fn open<[r]>(dir: String) -> Opening / {fs.write[r]} =
  Opening({ dir: dir, run: segments::start_run[r](dir) })

pub fn close<[r]>(opening: Opening) -> Unit / {fs.write[r]} =
  match opening { Opening(o) -> segments::end_run[r](o.run) }

fn pending_in(db: Database, tree: Int) -> Map<Bytes, Option<Bytes>> =
  match db.pending.get(tree) { Some(entries) -> entries, None -> Map::new() }

fn written(db: Database, tree: Int, key: Bytes, value: Option<Bytes>) -> Database =
  if db.pending.contains(tree) {
    {
      ..db,
      pending: db.pending.update(tree, |entries: Map<Bytes, Option<Bytes>>|
        entries.insert(key, value)),
    }
  } else { { ..db, pending: db.pending.insert(tree, Map::new().insert(key, value)) } }

pub fn with_value(db: Database, tree: Tree, key: Bytes, value: Bytes) -> Database =
  written(db, tree_number(tree), key, Some(value))

pub fn without_value(db: Database, tree: Tree, key: Bytes) -> Database =
  written(db, tree_number(tree), key, None)

pub fn value_of<[r]>(
  db: Database,
  tree: Tree,
  key: Bytes,
) -> Option<Bytes> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} = {
  let number = tree_number(tree);
  match pending_in(db, number).get(key) {
    Some(value) -> value,
    None -> fact_tree::find(|hash: Bytes| node_at[r](db, hash), db.snapshot.get(number), key),
  }
}

fn pending_under(
  db: Database,
  number: Int,
  prefix: Bytes,
) -> List<{ key: Bytes, value: Option<Bytes> }> = {
  let unwritten = pending_in(db, number);
  unwritten.range(
    Some(prefix),
    true,
    Some(prefix.concat(b"\xff".repeat(64))),
    true,
    unwritten.len(),
  )
}

pub fn entries_under<[r]>(
  db: Database,
  tree: Tree,
  prefix: Bytes,
) -> Map<Bytes, Bytes> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} = {
  let number = tree_number(tree);
  pending_under(db, number, prefix).fold(
    fact_tree::entries_under(
      |hash: Bytes| node_at[r](db, hash),
      db.snapshot.get(number),
      prefix,
    ).fold(Map::new(), |found: Map<Bytes, Bytes>, entry: TreeEntry|
      found.insert(entry.key, entry.value)),
    |found: Map<Bytes, Bytes>, write: { key: Bytes, value: Option<Bytes> }|
      match write.value {
        Some(value) -> found.insert(write.key, value),
        None -> found.remove(write.key),
      },
  )
}

pub fn members<[r]>(
  db: Database,
  tree: Tree,
  key: Bytes,
) -> List<Bytes> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  entries_under[r](db, tree, key).keys().map(|pair: Bytes| pair.slice(key.len(), pair.len()))

pub fn add_member(db: Database, tree: Tree, key: Bytes, member: Bytes) -> Database =
  with_value(db, tree, key.concat(member), b"")

pub fn remove_member(db: Database, tree: Tree, key: Bytes, member: Bytes) -> Database =
  without_value(db, tree, key.concat(member))

pub fn with_result<[r]>(
  db: Database,
  digest: Bytes,
  bytes: Bytes,
) -> Database / {fs.read[r], fs.write[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  if db.written_results.contains(digest) || stored_row[r](db, ResultsTable, digest) != None { db }
  else {
    let placed = segments::append_payload(db.writing, bytes);
    {
      ..db,
      writing: segments::flush_when_full[r](db.dir, schema, db.token, placed.writing),
      written_results: db.written_results.insert(digest, { at: placed.at, size: bytes.len() }),
    }
  }

pub fn result_of<[r]>(
  db: Database,
  digest: Bytes,
) -> Option<Bytes> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  match db.written_results.get(digest) {
    None -> table_value[r](db, ResultsTable, digest),
    Some(place) -> match segments::pending_payload(db.writing, place.at) {
      Some(bytes) -> Some(bytes),
      None -> segments::payload[r](db.dir, db.token, place.at, place.size),
    },
  }

pub fn stored_result_size<[r]>(
  db: Database,
  digest: Bytes,
) -> Option<Int> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  match db.written_results.get(digest) {
    Some(place) -> Some(place.size),
    None -> match stored_row[r](db, ResultsTable, digest) {
      Some(found) -> Some(row_place(found.row, key_width(ResultsTable)).size),
      None -> None,
    },
  }

pub fn with_log_floor(db: Database, floor: Int) -> Database = { ..db, log_floor: floor }

pub fn append_change(db: Database, changes: List<Bytes>) -> Database / {abort.raise} = {
  let offset = db.log_end + 1;
  {
    ..db,
    unwritten_log: db.unwritten_log.insert(offset, bin::encode(changes, changes_codec())),
    log_end: offset,
  }
}

pub fn changes_after<[r]>(
  db: Database,
  offset: Int,
) -> List<LogEntry> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  range(offset + 1, db.log_end + 1).map(|at: Int| {
    let bytes = match db.unwritten_log.get(at) {
      Some(unwritten) -> Some(unwritten),
      None -> table_value[r](db, ChangesTable, u64_be(at)),
    };
    match bytes {
      Some(stored) -> { offset: at, changes: decoded(stored, changes_codec()) },
      None -> fact_damage.damaged("the change log has a gap"),
    }
  })

pub fn log_end(db: Database) -> Int = db.log_end

type RowDraft = { writing: SegmentWriter, rows: Map<Bytes, PayloadPlace> }

fn drafted_rows<[r]>(
  db: Database,
  token: Bytes,
  writing: SegmentWriter,
  frames: Map<Bytes, Bytes>,
) -> RowDraft / {fs.write[r], abort.raise} =
  frames.fold(
    { writing: writing, rows: Map::new() },
    |draft: RowDraft, key: Bytes, payload: Bytes| {
      let placed = segments::append_payload(draft.writing, payload);
      {
        writing: segments::flush_when_full[r](db.dir, schema, token, placed.writing),
        rows: draft.rows.insert(key, { at: placed.at, size: payload.len() }),
      }
    },
  )

type SegmentDraft = { writing: SegmentWriter, tables: List<segments::Table> }

fn finished_segment<[r]>(
  db: Database,
  token: Bytes,
  writing: SegmentWriter,
  frames: Map<Table, Map<Bytes, Bytes>>,
  placed_results: Map<Bytes, PayloadPlace>,
) -> Option<Segment> / {fs.write[r], abort.raise} = {
  let drafted = frames.fold(
    { writing: writing, tables: [] },
    |draft: SegmentDraft, table: Table, table_frames: Map<Bytes, Bytes>| {
      let rows = drafted_rows[r](db, token, draft.writing, table_frames);
      {
        writing: rows.writing,
        tables: draft.tables.push(segments::table(table_number(table), rows.rows, place_row)),
      }
    },
  );
  segments::finish[r](
    db.dir,
    schema,
    token,
    drafted.writing,
    drafted.tables.push(segments::table(table_number(ResultsTable), placed_results, place_row)),
  )
}

fn tokens(listed: List<Segment>) -> List<Bytes> = listed.map(|seg: Segment| seg.token)

type Rewrite = { snapshot: Snapshot, fresh: Map<Bytes, Bytes> }

fn rewritten<[r]>(
  db: Database,
) -> Rewrite / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  db.pending.fold(
    { snapshot: db.snapshot, fresh: Map::new() },
    |rewrite: Rewrite, tree: Int, entries: Map<Bytes, Option<Bytes>>| {
      let update = fact_tree::updated(
        |hash: Bytes| node_at[r](db, hash),
        rewrite.snapshot.get(tree),
        entries.entries(),
        rewrite.fresh,
      );
      {
        snapshot: match update.root {
          Some(root) -> rewrite.snapshot.insert(tree, root),
          None -> rewrite.snapshot.remove(tree),
        },
        fresh: update.fresh,
      }
    },
  )

fn commit_frames<[r]>(
  db: Database,
  rewrite: Rewrite,
) -> Map<Table, Map<Bytes, Bytes>> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  Map::of_entries([
    {
      key: NodesTable,
      value: rewrite.fresh.fold(
        Map::new(),
        |frames: Map<Bytes, Bytes>, hash: Bytes, bytes: Bytes|
          if stored_row[r](db, NodesTable, hash) == None { frames.insert(hash, bytes) }
          else { frames },
      ),
    },
    {
      key: ChangesTable,
      value: db.unwritten_log.fold(
        Map::new(),
        |frames: Map<Bytes, Bytes>, offset: Int, bytes: Bytes| frames.insert(u64_be(offset), bytes),
      ),
    },
    {
      key: SnapshotsTable,
      value: Map::new().insert(
        current_snapshot,
        bin::encode(
          {
            roots: rewrite.snapshot.fold(
              [],
              |roots: List<fact_tree::TreeChild>, tree: Int, root: TreeRoot|
                roots.push({ slot: tree, root: root }),
            ),
            log_end: db.log_end,
          },
          stored_state_bin(),
        ),
      ),
    },
  ])

fn removed_after_refusal<[r]>(
  db: Database,
  result: CommitResult,
) -> CommitResult / {fs.write[r], abort.raise} =
  match result {
    Committed(_) -> result,
    WriteFailed -> result,
    _ -> {
      fs.remove[r](segments::segment_path(db.dir, db.token));
      result
    },
  }

pub fn commit<[r]>(
  db: Database,
  live_results: (Database) -> Set<Bytes> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise},
) -> CommitResult / {fs.read[r], fs.write[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} = {
  let rewrite = rewritten[r](db);
  if rewrite.snapshot == db.snapshot && db.unwritten_log.len() == 0 && !db.starts_over
      && db.written_results.len() == 0 { Committed(db.manifest) } else {
    match finished_segment[r](
        db,
        db.token,
        db.writing,
        commit_frames[r](db, rewrite),
        db.written_results,
      ) {
      None -> WriteFailed,
      Some(seg) -> {
        let now = segments::manifest[r](db.dir, schema);
        let installed = if tokens(now.segments) == tokens(db.manifest.segments) {
          segments::replace_merged[r](
            db.dir,
            schema,
            now,
            if db.starts_over { 0 } else { now.segments.len() },
            seg,
            true,
          )
        } else { StoreChanged };
        match installed {
          Committed(m) -> {
            merge_tail[r](
              {
                ..fresh_database(db.dir, m),
                snapshot: rewrite.snapshot,
                log_end: db.log_end,
                log_floor: db.log_floor,
                run: db.run,
              },
              live_results,
            );
            installed
          },
          _ -> removed_after_refusal[r](db, installed),
        }
      },
    }
  }
}

type Located = { token: Bytes, offset: Int, size: Int }

fn located_rows<[r]>(
  db: Database,
  merging: List<Segment>,
  table: Table,
) -> Map<Bytes, Located> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  merging.fold(Map::new(), |found: Map<Bytes, Located>, seg: Segment| {
    let rows = loaded_rows[r](db, seg, table);
    let width = row_width(table);
    let keys = key_width(table);
    segments::rows_folded(rows.len() / width, found, |into: Map<Bytes, Located>, i: Int| {
      let row = rows.slice(i * width, (i + 1) * width);
      let place = row_place(row, keys);
      into.insert(row.slice(0, keys), { token: seg.token, offset: place.at, size: place.size })
    })
  })

const all_tables: List<Table> = [NodesTable, ChangesTable, SnapshotsTable, ResultsTable]

type Rewriting = { writing: SegmentWriter, tables: List<segments::Table> }

type RowToCopy = { key: Bytes, at: Located }

type Chunk = { token: Bytes, start: Int, end: Int, rows: List<RowToCopy> }

const copy_chunk_size: Int = 16777216

fn chunks_in_file_order(located: Map<Bytes, Located>) -> List<Chunk> = {
  let by_file = located.fold(
    Map::new(),
    |files: Map<Bytes, Map<Int, RowToCopy>>, key: Bytes, at: Located|
      files.insert(
        at.token,
        (match files.get(at.token) { Some(rows) -> rows, None -> Map::new() }).insert(at.offset, {
          key: key,
          at: at,
        }),
      ),
  );
  by_file.fold([], |chunks: List<Chunk>, _: Bytes, rows: Map<Int, RowToCopy>|
    rows.fold(chunks, |sofar: List<Chunk>, _: Int, row: RowToCopy| chunk_with(sofar, row)))
}

fn chunk_with(chunks: List<Chunk>, row: RowToCopy) -> List<Chunk> = {
  let size = segments::framed_len(row.at.size);
  match chunks.at(chunks.len() - 1) {
    Some(last) -> if last.token == row.at.token && last.end == row.at.offset
        && last.end - last.start < copy_chunk_size {
      chunks.set(chunks.len() - 1, { ..last, end: last.end + size, rows: last.rows.push(row) })
    } else {
      chunks.push({
        token: row.at.token,
        start: row.at.offset,
        end: row.at.offset + size,
        rows: [row],
      })
    },
    None ->
      chunks.push({
        token: row.at.token,
        start: row.at.offset,
        end: row.at.offset + size,
        rows: [row],
      }),
  }
}

fn chunk_bytes<[r]>(
  db: Database,
  chunk: Chunk,
) -> Bytes / {fs.read[r], fact_damage.damaged, abort.raise} =
  match segments::read_range[r](
      segments::segment_path(db.dir, chunk.token),
      chunk.start,
      chunk.end - chunk.start,
    ) {
    Some(bytes) -> bytes,
    None -> fact_damage.damaged("a segment is shorter than its table says"),
  }

fn table_copied<[r]>(
  db: Database,
  token: Bytes,
  draft: Rewriting,
  table: Table,
  located: Map<Bytes, Located>,
) -> Rewriting / {fs.read[r], fs.write[r], fact_damage.damaged, abort.raise} = {
  let copied = chunks_in_file_order(located).fold(
    { writing: draft.writing, rows: Map::new() },
    |sofar: RowDraft, chunk: Chunk| {
      let put = segments::append_frames(sofar.writing, chunk_bytes[r](db, chunk));
      {
        writing: segments::flush_when_full[r](db.dir, schema, token, put.writing),
        rows: chunk.rows.fold(sofar.rows, |rows: Map<Bytes, PayloadPlace>, row: RowToCopy|
          rows.insert(row.key, { at: put.at + row.at.offset - chunk.start, size: row.at.size })),
      }
    },
  );
  {
    writing: copied.writing,
    tables: draft.tables.push(segments::table(table_number(table), copied.rows, place_row)),
  }
}

fn rewritten_segments<[r]>(
  db: Database,
  m: Manifest,
  from: Int,
  token: Bytes,
  stored: (Table, Bytes) -> Bool / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise},
) -> Bool / {fs.read[r], fs.write[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} = {
  let merging = m.segments.drop(from);
  let draft = all_tables.fold(
    { writing: segments::new_writer, tables: [] },
    |sofar: Rewriting, table: Table|
      table_copied[r](
        db,
        token,
        sofar,
        table,
        located_rows[r](db, merging, table).fold(
          Map::new(),
          |found: Map<Bytes, Located>, key: Bytes, at: Located|
            if stored(table, key) { found.insert(key, at) } else { found },
        ),
      ),
  );
  match segments::finish[r](db.dir, schema, token, draft.writing, draft.tables) {
    None -> false,
    Some(seg) -> match segments::replace_merged[r](db.dir, schema, m, from, seg, true) {
      Committed(_) -> true,
      _ -> {
        fs.remove[r](segments::segment_path(db.dir, token));
        false
      },
    },
  }
}

fn merge_tail<[r]>(
  db: Database,
  live_results: (Database) -> Set<Bytes> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise},
) -> Unit / {fs.read[r], fs.write[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} = {
  let m = db.manifest;
  let from = segments::merge_start(m);
  if from < m.segments.len() - 1 {
    let token = segments::segment_token(db.run, m.generation, 1);
    if from > 0 {
      rewritten_segments[r](db, m, from, token, |_: Table, _: Bytes| true);
      ()
    } else {
      let nodes = tree_nodes[r](db, db.snapshot.values());
      let results = live_results(db);
      rewritten_segments[r](db, m, 0, token, |table: Table, key: Bytes|
        match table {
          NodesTable -> nodes.contains(key),
          ResultsTable -> results.contains(key),
          ChangesTable -> match key.u64_be_at(0) {
            Some(offset) -> offset > db.log_floor,
            None -> true,
          },
          SnapshotsTable -> true,
        });
      ()
    }
  };
  match db.run { Some(run) -> segments::sweep[r](db.dir, schema, run), None -> () }
}

fn tree_nodes<[r]>(
  db: Database,
  roots: List<TreeRoot>,
) -> Set<Bytes> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  traverse(roots.map(|root: TreeRoot| root.hash), |hash: Bytes|
    {
      value: (),
      next: match node_at[r](db, hash) {
        fact_tree::Bucket(_) -> [],
        fact_tree::Branch(branch) ->
          branch.children.map(|child: fact_tree::TreeChild| child.root.hash),
      },
    }).fold(Set::empty(), |found: Set<Bytes>, v: Visit<Bytes, Unit>| found.insert(v.key))

fn store_bytes(m: Manifest) -> Int = m.segments.fold(0, |n: Int, seg: Segment| n + seg.size)

pub fn store_size(db: Database) -> { segments: Int, bytes: Int } =
  { segments: db.manifest.segments.len(), bytes: store_bytes(db.manifest) }

fn key_of(text: String) -> Bytes = Bytes::of_string(text).blake3()

fn sample_change(name: String) -> Bytes = key_of(name)

fn first_edit(db: Database) -> Database / {abort.raise} =
  append_change(
    add_member(
      with_value(db, Facts, key_of("first"), b"one"),
      Dependents,
      key_of("first"),
      key_of("reader"),
    ),
    [sample_change("first")],
  )

fn second_edit(db: Database) -> Database / {abort.raise} =
  append_change(
    add_member(
      remove_member(
        with_value(without_value(db, Facts, key_of("first")), Facts, key_of("second"), b"two"),
        Dependents,
        key_of("first"),
        key_of("reader"),
      ),
      Dependents,
      key_of("first"),
      key_of("other reader"),
    ),
    [sample_change("second")],
  )

fn in_store<a, [r] | e>(
  go: (Database) -> a / {fs.read[r], fs.write[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise | e},
) -> a / {fs.read[r], fs.write[r], abort.raise | e} =
  with_recent_reads(|| {
    let opening = open[r]("facts");
    let value = undamaged(|| go(loaded[r](opening)));
    close[r](opening);
    value
  })

pub fn undamaged<a | e>(go: () -> a / {fact_damage.damaged | e}) -> a / {abort.raise | e} =
  handle {
    go()
  } with {
    fact_damage.damaged(reason) -> panic("the fact database is damaged: " ++ reason),
  }

fn no_results(_: Database) -> Set<Bytes> = Set::empty()

fn committed<[r]>(
  db: Database,
) -> Unit / {fs.read[r], fs.write[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  match commit[r](db, no_results) {
    Committed(_) -> (),
    other -> panic("the commit failed: " ++ show(other)),
  }

fn after_first(tree: fs::MemFs) -> fs::MemFs / {abort.raise} =
  fs::on_mem[abs](tree, || in_store[abs](|db: Database| committed[abs](first_edit(db)))).tree

fn value_stored(tree: fs::MemFs, key: Bytes) -> Option<Bytes> / {abort.raise} =
  fs::on_mem[abs](tree, || in_store[abs](|db: Database| value_of[abs](db, Facts, key))).value

fn dependents_stored(tree: fs::MemFs) -> List<Bytes> / {abort.raise} =
  fs::on_mem[abs](tree, ||
    in_store[abs](|db: Database| members[abs](db, Dependents, key_of("first")))).value

fn log_stored(tree: fs::MemFs, after: Int) -> List<LogEntry> / {abort.raise} =
  fs::on_mem[abs](tree, || in_store[abs](|db: Database| changes_after[abs](db, after))).value

test "a commit makes the writes visible to a reopened database" {
  let tree = after_first(fs::mem_of([]));
  assert_eq(value_stored(tree, key_of("first")), Some(b"one"));
  assert_eq(dependents_stored(tree), [key_of("reader")])
}

test "a member removed in a later snapshot stays removed, and one added later is found beside the older ones" {
  let tree = fs::on_mem[abs](after_first(fs::mem_of([])), ||
    in_store[abs](|db: Database| committed[abs](second_edit(db)))).tree;
  assert_eq(dependents_stored(tree), [key_of("other reader")]);
  assert_eq(value_stored(tree, key_of("first")), None);
  assert_eq(value_stored(tree, key_of("second")), Some(b"two"))
}

test "rows at one offset of two files are both listed" {
  let located = Map::new().insert(b"first", { token: b"one", offset: 20, size: 4 }).insert(
    b"second",
    { token: b"two", offset: 20, size: 4 },
  );
  assert_eq(
    chunks_in_file_order(located).flat_map(|chunk: Chunk|
      chunk.rows.map(|row: RowToCopy| row.key)).sort(
    ),
    [b"first", b"second"],
  )
}

test "a result is found by its digest in the run that wrote it and after a commit" {
  let digest = key_of("result");
  let written = fs::on_mem[abs](fs::mem_of([]), ||
    in_store[abs](|db: Database| {
      let held = with_result[abs](db, digest, b"value");
      assert_eq(result_of[abs](held, digest), Some(b"value"));
      committed[abs](held)
    }));
  let read = fs::on_mem[abs](written.tree, ||
    in_store[abs](|db: Database| result_of[abs](db, digest)));
  assert_eq(read.value, Some(b"value"))
}

test "reading the log returns the entries after an offset" {
  let tree = fs::on_mem[abs](after_first(fs::mem_of([])), ||
    in_store[abs](|db: Database| committed[abs](second_edit(db)))).tree;
  assert_eq(log_stored(tree, 0).map(|e: LogEntry| e.offset), [1, 2]);
  assert_eq(log_stored(tree, 1).map(|e: LogEntry| e.changes), [[sample_change("second")]])
}

test "a run that started from an older snapshot cannot commit, so a snapshot never mixes two edits" {
  let raced = fs::on_mem[abs](after_first(fs::mem_of([])), ||
    in_store[abs](|db: Database| {
      in_store[abs](|other: Database| committed[abs](second_edit(other)));
      commit[abs](with_value(db, Facts, key_of("third"), b"three"), no_results)
    }));
  assert_eq(raced.value, StoreChanged);
  assert_eq(value_stored(raced.tree, key_of("third")), None)
}

test "a disk that fails at any write leaves the old snapshot or the whole new one" {
  let start = after_first(fs::mem_of([]));
  iterate(0, 1000, |n: Int| {
    let died = fs::on_mem_failing[abs](start, n, ||
      in_store[abs](|db: Database| commit[abs](second_edit(db), no_results)));
    let first = value_stored(died.tree, key_of("first"));
    let second = value_stored(died.tree, key_of("second"));
    assert(first != second);
    if second == Some(b"two") && died.value != WriteFailed { Stop(()) } else { Continue(n + 1) }
  })
}

test "a tree node that fails its checksum raises `damaged`, and starting over replaces the store" {
  let tree = after_first(fs::mem_of([]));
  let names = match fs::listed_names(fs::mem_list(tree, "facts")) { Some(n) -> n, None -> [] };
  let segment = "facts/" ++ names.filter(|n: String| n.starts_with("seg-")).get(0);
  let bytes = match fs::mem_read(tree, segment) { Some(b) -> b, None -> b"" };
  let damaged = fs::on_mem[abs](tree, ||
    with_recent_reads(|| {
      let opening = open[abs]("facts");
      let db = undamaged(|| loaded[abs](opening));
      fs.write_file[abs](
        segment,
        Bytes::concat_all([bytes.slice(0, 60), b"\x00".repeat(bytes.len() - 60)]),
      );
      handle {
        value_of[abs](db, Facts, key_of("first")) == None
      } with {
        fact_damage.damaged(_) -> {
          committed_over[abs](emptied[abs](opening));
          true
        },
      }
    }));
  assert(damaged.value);
  assert_eq(value_stored(damaged.tree, key_of("first")), None)
}

fn committed_over<[r]>(
  db: Database,
) -> Unit / {fs.read[r], fs.write[r], recent_reads.read, recent_reads.write, abort.raise} =
  handle {
    committed[r](with_value(db, Facts, key_of("restart"), b"new"))
  } with {
    fact_damage.damaged(reason) -> panic(reason),
  }

test "a snapshot that returns to an earlier state writes no tree nodes, because nodes are stored by their hash" {
  let flip = |value: Bytes| |db: Database| with_value(db, Facts, key_of("first"), value);
  let sized = |tree: fs::MemFs, value: Bytes|
    fs::on_mem[abs](tree, ||
      in_store[abs](|db: Database| {
        committed[abs](flip(value)(db));
        ()
      })).tree;
  let one = sized(fs::mem_of([]), b"a");
  let two = sized(one, b"b");
  let back = sized(two, b"a");
  let size_of = |tree: fs::MemFs|
    fs::on_mem[abs](tree, || in_store[abs](|db: Database| store_size(db).bytes)).value;
  assert(size_of(back) - size_of(two) < 400)
}

test "a commit that replaces a result drops the old one when its merge reaches the oldest segment" {
  let old = key_of("old");
  let new = key_of("new");
  let wrote = |tree: fs::MemFs, digest: Bytes, value: Bytes|
    fs::on_mem[abs](tree, ||
      in_store[abs](|db: Database|
        match commit[abs](with_result[abs](db, digest, value), |_: Database|
            Set::empty().insert(digest)) {
          Committed(_) -> (),
          other -> panic("the commit failed: " ++ show(other)),
        })).tree;
  let tree = wrote(wrote(fs::mem_of([]), old, b"old"), new, b"new");
  let read = |digest: Bytes|
    fs::on_mem[abs](tree, || in_store[abs](|db: Database| result_of[abs](db, digest))).value;
  assert_eq(read(old), None);
  assert_eq(read(new), Some(b"new"))
}
