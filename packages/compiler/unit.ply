test "a root written to enter, compare or digest a value calls a definition generic over rows at the rows it fills" {
  let user = [
    {
      name: b"m",
      src: Bytes::concat_all([
        b"pub type Step<a | e> = () -> Option<a> / e\n",
        b"pub type Seq<a | e> = | Seq(Step<a | e>)\n",
        b"pub fn empty<a | e>() -> Seq<a | e> = {\n  let step: Step<a | e> = || None;\n  Seq(step)\n}\n",
        b"pub fn none<| e>() -> Seq<Int | e> = empty()\n",
        b"pub type Hook<a | e> = | Hook(String, (a) -> Unit / e) | Unhooked\n",
        b"key for Hook by named\n",
        b"pub fn named<a | e>(h: Hook<a | e>) -> Option<String> =\n",
        b"  match h { Hook(name, _) -> Some(name), Unhooked -> None }\n",
        b"test \"rows\" {\n",
        b"  let quiet: Hook<Int | {}> = Hook(\"save\", |_n: Int| ());\n",
        b"  let held: Seq<Int | {}> = none();\n",
        b"  assert(quiet == quiet);\n",
        b"  assert_eq(digest(quiet), digest(quiet))\n",
        b"}\n",
      ]),
    },
  ];
  let dump = dump_of(analyse(parse_all(user)));
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_placed(dump, user),
      Map::new(),
      offered_roots(dump).keys,
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(e) -> {
      assert_eq(dump.diags.map(|d: Diag| d.message), []);
      let ran = e.roots.map(printed);
      assert_eq(
        [
          b"m.empty#entered",
          b"m.none#entered",
          b"m.empty@Int/{}",
          b"m.none@/{}",
          b"m.named@Int/{}",
          b"m.Hook<Int,_>#eq",
          b"m.digest#m.Hook<Int,_>",
        ].filter(|n: Bytes| !ran.contains(n)),
        [],
      );
    },
  }
}

