// --- What crosses the seam ----------------------------------------------------

/// What this binary ships, a function of the binary alone: its shipped modules, its version,
/// what its store's groups are a function of, and the runtime a unit is compiled against.
pub effect shipped {
  read names() -> List<String>
  /// A shipped module's text by its name, or the bytes of a data file one embeds by the name the
  /// shipped modules hold it under (`std/oid/names.txt`).
  read module(name: String) -> Option<Bytes>
  /// What the frame of `len` bytes at `offset` of the file `path` of the pack this binary carries
  /// holds, decompressed: what `ply std --answers` answered of the shipped modules (`packs`). A
  /// `len` of 0 reads the frames from `offset` to the end. Nothing where it carries no such file or
  /// the range holds no whole frame.
  read answer(path: String, offset: Int, len: Int) -> Option<Bytes>
  /// Each file this binary ships, by the name the launcher lays it out under, and its digest, as
  /// the launcher's `digests` beside them lists them: the files a packed answer stands for.
  read digests() -> Bytes
  /// What a load read of the shipped modules it pulled, for whatever observes the run: a test's
  /// pass then stands on the functions its program reached rather than on the whole modules.
  /// `pulled` is whether the load read them itself, rather than re-analysing one that did.
  read reached(view: Bytes, pulled: Bool) -> Unit
  read version() -> String
  /// The running binary's size, or `None` where it cannot be measured, which fails nothing.
  read binary_bytes() -> Option<Int>
  read stamps() -> String
  /// The runtime this binary is linked with, as its library describes itself
  /// (`compiler.emit.abi.runtime_of` reads it).
  read runtime() -> Bytes
  /// Each definition of this binary's own program, the one its launcher entered (the builder's own
  /// where a builder asks), and the hash its front end gave it, a `name hash` line each: a hash
  /// covers all its definition reaches.
  read definitions() -> Bytes
  /// What `root` of the unit compiled into the library `library` answers for `arguments`, the list
  /// of what it takes, within `timeout_ms` milliseconds of wall clock, no host bound, each value as
  /// PLV1 writes it: none where it raised, the clock stopped it or the unit holds no such root. The
  /// unit is opened the first time a process enters it and kept for every later call.
  read entered(library: String, root: String, arguments: Bytes, timeout_ms: Int) -> Option<Bytes>
}

host for shipped by shipping

/// `go` with what this binary ships, which a run is lent with `--allow shipped`.
fn shipping<a | e>(go: () -> a / {shipped.read | e}) -> a / {native.read, abort.raise | e} =
  handle {
    go()
  } with {
    shipped.names() -> {
      observed("", "", 5);
      parts(shipped_names()).map(|name: Bytes| String::of_bytes_lossy(name))
    },
    shipped.module(name) -> {
      observed("", name, 5);
      found(shipped_module(name))
    },
    shipped.answer(path, offset, len) -> if offset < 0 || len < 0 { None }
    else { found(shipped_answer(path, offset, len)) },
    shipped.digests() -> shipped_digests(),
    shipped.reached(view, pulled) ->
      observed("", String::of_bytes_lossy(view), if pulled { 7 } else { 8 }),
    shipped.version() -> String::of_bytes_lossy(shipped_version()),
    shipped.binary_bytes() -> match found(shipped_binary_bytes()) {
      Some(n) -> Some(int_of(n)),
      None -> None,
    },
    shipped.stamps() -> String::of_bytes_lossy(shipped_stamps()),
    shipped.runtime() -> shipped_described(),
    shipped.definitions() -> {
      observed("", "", 6);
      shipped_definitions()
    },
    shipped.entered(library, root, arguments, timeout_ms) ->
      found(shipped_entered(library, root, arguments, timeout_ms)),
  }

/// Every shipped module's name, as parts.
extern fn shipped_names() -> Bytes / {native.read}

/// A shipped module's text or a data file's bytes by its name, found.
extern fn shipped_module(name: String) -> Bytes / {native.read}

/// The frames of `len` bytes at `offset` of the pack's answer file `path`, found.
extern fn shipped_answer(path: String, offset: Int, len: Int) -> Bytes / {native.read}

/// Each file this binary ships and its digest.
extern fn shipped_digests() -> Bytes / {native.read}

/// This binary's version.
extern fn shipped_version() -> Bytes / {native.read}

/// The running binary's size in eight bytes, found where it can be measured.
extern fn shipped_binary_bytes() -> Bytes / {native.read}

/// The runtime's stamps.
extern fn shipped_stamps() -> Bytes / {native.read}

/// The runtime this binary is linked with, as its library describes itself.
extern fn shipped_described() -> Bytes / {native.read}

/// The program the launcher entered, a `name hash` line each.
extern fn shipped_definitions() -> Bytes / {native.read}

/// What `root` of the unit compiled into `library` answers for `arguments`, found.
extern fn shipped_entered(
  library: String,
  root: String,
  arguments: Bytes,
  timeout_ms: Int,
) -> Bytes / {native.read}

/// The runtime this binary is linked with, as it describes itself.
pub fn shipped_runtime() -> Runtime / {shipped.runtime, abort.raise} =
  match runtime_of(shipped.runtime()) {
    Ok(r) -> r,
    Err(why) ->
      panic(
        "this binary describes the runtime it is linked with unreadably: "
          ++ String::of_bytes_lossy(why),
      ),
  }

/// A native as the compiler declares it that the runtime does not implement so, and every native the
/// runtime has under its name: none, more than one, or one that takes other words, answers nothing
/// or raises otherwise.
pub type Unbound = { declared: Extern, found: List<Native> }

/// Each of `declared` that `natives` does not implement, in `declared`'s order: one binds a native of
/// the signature the compiler declares (`declared_signature`).
pub fn unbound(natives: List<Native>, declared: List<Extern>) -> List<Unbound> = {
  let by_name = natives.fold(Map::new(), |acc: Map<Bytes, List<Native>>, n: Native|
    acc.insert(n.name, List::push(match acc.get(n.name) { Some(ns) -> ns, None -> [] }, n)));
  declared.fold([], |acc: List<Unbound>, d: Extern| {
    let found = match by_name.get(d.name) { Some(ns) -> ns, None -> [] };
    match found {
      [n] -> if n == declared_signature(d) { acc } else { acc.push({ declared: d, found: found }) },
      _ -> acc.push({ declared: d, found: found }),
    }
  })
}

/// What the compiler declares of the native `d` at the machine, as the runtime describes one: the
/// kinds a call over machine words passes and is answered; for a native the emitted C calls
/// directly, the kinds `compiler.emit.abi` declares; for any other, a uniform word for each word a
/// call passes, and one answered.
pub fn declared_signature(d: Extern) -> Native =
  match d.call {
    Some(c) -> { name: d.name, params: call_params(c), answer: call_answer(c), raises: d.raises },
    None -> match abi::native_named(d.name) {
      Some(n) -> n,
      None -> uniform_native(d.name, d.words, true, d.raises),
    },
  }

/// The kinds a call of `c` passes past the context, as the runtime describes a native's.
fn call_params(c: MachineCall) -> List<Machine> =
  c.params.fold([], |acc: List<Machine>, v: MachineValue|
    match v {
      MachineInt(_) -> acc.push(abi::I64),
      MachineFloat -> acc.push(abi::F64),
      MachineText(_) -> acc.push(abi::Addr).push(abi::I64),
      MachineSecret(_) -> acc.push(abi::Secret),
      MachineObject(_) -> acc.push(abi::Handle),
      MachineHanded(_) -> acc.push(abi::Handed).push(abi::Type),
      MachineFunction(_) -> acc.push(abi::Block).push(abi::Words).push(abi::Words),
      MachineUnit -> acc,
    }).concat(match c.answer { MachineHanded(_) -> [abi::Type], _ -> [] })

/// The kind a call of `c` is answered, as the runtime describes a native's; `None` for nothing.
fn call_answer(c: MachineCall) -> Option<Machine> =
  match c.answer {
    MachineInt(_) -> Some(abi::I64),
    MachineFloat -> Some(abi::F64),
    MachineText(_) -> Some(abi::Taken),
    MachineSecret(_) -> Some(abi::Secret),
    MachineObject(_) -> Some(abi::Handle),
    MachineHanded(_) -> Some(abi::Handed),
    MachineFunction(_) -> None,
    MachineUnit -> None,
  }

/// Each of `declared` called over machine words, as the unit's C binds it: by its helper's name, at
/// the kinds its call passes and is answered.
fn machine_bound(declared: List<Extern>) -> List<Native> / {abort.raise} =
  declared.fold([], |acc: List<Native>, e: Extern|
    if e.call == None { acc }
    else { acc.push({ ..declared_signature(e), name: builtin_helper(e.name) }) })

/// The C helper of each native a unit's bodies call, by its name without the `_p` its pointer
/// adds.
fn natives_called(made: Made) -> Map<Bytes, Bool> = natives_of(made.bodies)

/// The helper of each machine native `bodies` call, as their tables report them.
fn natives_of(bodies: List<UnitBody>) -> Map<Bytes, Bool> =
  bodies.fold(Map::new(), |acc: Map<Bytes, Bool>, k: UnitBody|
    k.tables.natives.fold(acc, |m: Map<Bytes, Bool>, n: Bytes| m.insert(n, true)))

/// Each native the unit of `p` may call, where its bodies call the helpers `called`: the compiler's
/// own where they call no other, and otherwise `program_natives` over the modules it reads, whose
/// texts are parsed once for a unit.
fn read_natives(p: Program, called: Map<Bytes, Bool>) -> List<Extern> / {abort.raise} = {
  let own = declared_natives();
  let theirs = own.fold(called, |acc: Map<Bytes, Bool>, e: Extern|
    acc.remove(builtin_helper(e.name)));
  if theirs.len() == 0 { own } else {
    program_natives(
      p.modules.fold([], |acc: List<{ name: Bytes, text: Bytes }>, m: ModuleRow|
        if !p.read.contains(m.name) { acc } else {
          match text_at(p, m.index) {
            Some(text) -> acc.push({ name: m.name, text: text }),
            None -> acc,
          }
        }),
    )
  }
}

/// The natives among `natives` whose helpers are `called`.
fn called_externs(called: Map<Bytes, Bool>, natives: List<Extern>) -> List<Extern> / {abort.raise} =
  natives.filter(|e: Extern| called.contains(builtin_helper(e.name)))

fn kinds_said(n: Native) -> Bytes =
  Bytes::concat_all([
    b"takes [",
    Bytes::join(n.params.map(machine_name), b", "),
    b"]",
    match n.answer {
      Some(m) -> b", answers ".concat(machine_name(m)),
      None -> b", answers nothing",
    },
    if n.raises { b" and raises" } else { b" and cannot raise" },
  ])

/// Why `u` does not bind, as a line of the diagnostic that lists it.
fn unbound_line(u: Unbound) -> Bytes = {
  let d = u.declared;
  let named = if d.module == b"" { Bytes::concat_all([b"the compiler's `", d.name, b"`"]) }
  else { Bytes::concat_all([b"`extern fn ", d.name, b"` of `", d.module, b"`"]) };
  match u.found {
    [] -> named.concat(b": no native of the runtime implements it"),
    [n] ->
      Bytes::concat_all([
        named,
        b" ",
        kinds_said(declared_signature(d)),
        b", and the runtime's native ",
        kinds_said(n),
      ]),
    ns ->
      Bytes::concat_all([
        named,
        b": ",
        ascii_of_int(ns.len()),
        b" natives of the runtime implement it",
      ]),
  }
}

/// A body the unit took whose calls of `assumed.def` were written against `assumed`, where what that
/// definition publishes once the rounds settle is `published`; none publishes nothing, which takes
/// every argument and answers a count of its own.
pub type Misassumed = { caller: RootName, assumed: Published, published: Option<Published> }

/// Whether a call written against `assumed` is written as the callee that publishes `now` takes it.
fn agrees(assumed: Published, now: Option<Published>) -> Bool =
  match now {
    Some(h) -> h == assumed,
    None -> !assumed.lent.any(|l: Bool| l) && assumed.borrowed == None,
  }

/// A handing as a diagnostic says it: each parameter lent or given, then how it answers.
fn handing_said(h: Published) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"[",
    Bytes::join(h.lent.map(|l: Bool| if l { b"lent" } else { b"given" }), b", "),
    b"] ",
    match h.borrowed {
      None -> b"owned",
      Some(from) ->
        Bytes::concat_all([
          b"borrowed(",
          Bytes::join(
            from.map(|x: { param: Int, whole: Bool }|
              if x.whole { ascii_of_int(x.param) } else { ascii_of_int(x.param).concat(b" part") }),
            b", ",
          ),
          b")",
        ]),
    },
  ])

/// The calls a unit holds written against a handing other than the one their callee publishes:
/// refused, since a call lending what its callee takes as given, or the other way, counts a value
/// wrongly with no C type to show it.
fn handings_disagree(wrong: List<Misassumed>) -> Diag / {abort.raise} =
  error_with_labels(
    b"E0478",
    Bytes::concat_all([
      b"the emitter wrote ",
      ascii_of_int(wrong.len()),
      if wrong.len() == 1 { b" call against a handing its callee does not publish" }
      else { b" calls against handings their callees do not publish" },
    ]),
    [],
    wrong.map(|m: Misassumed|
      Bytes::concat_all([
        b"`",
        root_text(m.caller),
        b"` calls `",
        root_text(m.assumed.def),
        b"` written ",
        handing_said(m.assumed),
        b", where it publishes ",
        match m.published { Some(h) -> handing_said(h), None -> b"none, so takes every argument" },
      ])),
  )

/// The natives a unit calls that the runtime it is compiled against does not implement as they are
/// declared: refused before a C compiler meets a call that disagrees with the helper it names.
fn natives_refused(refused: List<Unbound>) -> Diag =
  error_with_labels(
    b"E0476",
    Bytes::concat_all([
      b"the runtime does not implement ",
      ascii_of_int(refused.len()),
      if refused.len() == 1 { b" native this program calls as it is declared" }
      else { b" natives this program calls as they are declared" },
    ]),
    [],
    refused.map(unbound_line).push(
      b"the runtime reports a native as the type of the function it binds says, and a call is written as the compiler that emitted it declares the native, so the two disagree where that compiler and the runtime are built from different sources, as a release's compiler and a newer runtime are",
    ),
  )

/// Where the runtime a unit is compiled against binds or lays out what its code calls or reads
/// otherwise than this compiler declares: refused before a C compiler meets code the runtime would
/// run wrongly.
fn runtime_refused(unserved: List<Unserved>) -> Diag / {abort.raise} =
  error_with_labels(
    b"E0481",
    Bytes::concat_all([
      b"the runtime does not serve the code this compiler emits in ",
      ascii_of_int(unserved.len()),
      if unserved.len() == 1 { b" place" } else { b" places" },
    ]),
    [],
    unserved.map(unserved_line).push(
      b"the runtime describes its helpers and what it lays out as its Rust says, and the compiler emits code as `compiler.emit.abi` declares them, so the two disagree where that compiler and the runtime are built from different sources",
    ),
  )

/// What the frame of `len` bytes at `offset` of the file `path` of the pack this binary carries
/// holds: `shipped.answer` as what reads the pack below a run's store.
pub fn pack_frame(path: String, offset: Int, len: Int) -> Option<Bytes> / {shipped.answer} =
  shipped.answer(path, offset, len)

/// The hash `definitions` holds for the definition `name`, by its full name.
pub fn definition_hash(definitions: Bytes, name: Bytes) -> Option<Bytes> / {abort.raise} = {
  let line = name.concat(b" ");
  let found = if definitions.starts_with(line) { Some(0) }
  else { match definitions.index_of(b"\n".concat(line)) { Some(i) -> Some(i + 1), None -> None } };
  match found {
    None -> None,
    Some(i) -> {
      let from = i + line.len();
      // A hash is sixty-four digits, so its line ends within this many bytes.
      let most = if from + 65 > definitions.len() { definitions.len() } else { from + 65 };
      let rest = definitions.slice(from, most);
      Some(rest.slice(0, match rest.index_of_byte(10) { Some(end) -> end, None -> rest.len() }))
    },
  }
}

/// What the answers `roots` compute are a function of on the program's side: each root's hash,
/// which covers all the root reaches and nothing else of the program. A root the program does not
/// hold was renamed without the list that names it.
pub fn identity_of(definitions: Bytes, roots: List<Bytes>) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all(
        roots.map(|root: Bytes|
          match definition_hash(definitions, root) {
            Some(h) -> Bytes::concat_all([root, b" ", h, b"\n"]),
            None ->
              panic(
                "this binary's program holds no definition `" ++ String::of_bytes_lossy(root)
                  ++ "`, which a kept answer is filed under",
              ),
          }),
      ),
    ),
  )

/// The definitions an emitter's answer is a function of besides the root it answers for: the one
/// that reads the program the emitter lowers from, the emitter, and the one that makes the front
/// end's answer it is asked over.
pub fn emitter_roots() -> List<Bytes> =
  [b"compiler.unit.scope_over", b"compiler.emit.answered", b"compiler.front.seam.view_dump"]

pub fn emitter_identity(definitions: Bytes) -> Bytes / {abort.raise} =
  identity_of(definitions, emitter_roots())

/// The definitions a unit is a function of besides the program it is of: the emitter's, and the ones
/// that produce a unit over its answers and hold it to what was offered.
pub fn unit_roots() -> List<Bytes> =
  [b"compiler.unit.emitted", b"compiler.unit.held", b"compiler.front.seam.view_dump"]

/// The definitions a program's analysis and its unit are a function of besides its sources.
pub fn compiler_roots() -> List<Bytes> =
  unit_roots().push(b"compiler.front.analyse_pulling_std_with")

/// What a program a builder built is a function of besides its text: the definition it enters, whose
/// hash covers all that reaches and nothing else of the program, the runtime its unit is compiled
/// against, and the builder's own entry, whose hash covers all the builder runs.
pub fn program_key(entry: Bytes, runtime: Runtime, definitions: Bytes) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all([
        b"ply.program.1\0",
        entry,
        runtime.identity,
        b"\0",
        identity_of(definitions, [b"compiler.build.main"]),
      ]),
    ),
  )

/// Where a builder keeps each program it built under `program_key`, below the toolchain's cache.
pub fn programs_kept() -> String = "programs"

fn kept_path(dir: String, key: Bytes) -> String / {abort.raise} =
  if dir == "" || dir == "." { String::of_bytes(key) } else { dir ++ "/" ++ String::of_bytes(key) }

/// A whole file kept between runs under `dir`, as a build keeps a program it built: a read is a use,
/// which keeps it from the toolchain's sweep, which takes such a file on its own.
pub fn file_kept<[r]>(
  dir: String,
  key: Bytes,
) -> Option<Bytes> / {fs.read[r], fs.write[r], time.now_ms, abort.raise} = {
  let path = kept_path(dir, key);
  match fs.read_file[r](path) {
    None -> None,
    Some(bytes) -> {
      fs.set_modified[r](path, time.now_ms());
      Some(bytes)
    },
  }
}

/// Written beside itself and renamed into place, so a reader finds a whole file or none. A file that
/// cannot be written is left unwritten.
pub fn keep_file<[r]>(
  dir: String,
  key: Bytes,
  bytes: Bytes,
) -> Unit / {fs.write[r], entropy.next, time.now_ms, abort.raise} = {
  let path = kept_path(dir, key);
  let nonce = blake3(u64_le(entropy.next()).concat(u64_le(time.now_ms()))).slice(0, 8);
  let temp = path ++ "." ++ nonce.hex_of() ++ ".tmp";
  if fs.create_dir[r](if dir == "" { "." } else { dir }) && fs.write_file[r](temp, bytes) {
    if !fs.rename[r](temp, path) {
      fs.remove[r](temp);
      ()
    }
  }
}

/// A root a unit is offered: its arity, whether it is pure and takes nothing, which the unit gives a
/// memo slot, the root its failure sites name (its own name, or the definition it specialises, whose
/// text they count from), and `home`, the module whose parts its body sits among (`home_of`).
pub type Offered = { name: RootName, arity: Int, constant: Bool, site: RootName, home: Bytes }

/// A constructor of the unit's table and its arity. The runtime holds each argument of one it makes
/// as its word, which no body reads in place.
pub type Ctor = { name: Bytes, arity: Int }

/// What a unit's C was made of: its bodies, before the unit placed them, and its roots as they were
/// offered, which decide how the unit places each.
pub type Made = { bodies: List<UnitBody>, offered: List<Offered> }

/// A unit's C, the roots it takes, and what it was made of.
pub type Produced = { text: Bytes, taken: List<RootName>, made: Made }

/// A unit produced over answers an earlier run kept and answers the emitter gave now: the roots it
/// runs, each specialisation by its own key though the unit compiles it as its code (`Coded`), how
/// many of the offered roots each covered, the natives the unit calls that the runtime does not
/// implement as they are declared, and its calls written against a handing other than their
/// callee's.
pub type Emission = {
  produced: Produced,
  roots: List<RootKey>,
  kept: Int,
  asked: Int,
  unserved: List<Unserved>,
  unbound: List<Unbound>,
  misassumed: List<Misassumed>,
}

/// Each root's answer, a group's one body answering for every member.
pub fn answers_of(rows: List<RootAnswer>) -> Map<RootName, Answer> =
  rows.fold(Map::new(), |acc: Map<RootName, Answer>, r: RootAnswer|
    if r.answer.tables.members.len() == 0 { acc.insert(r.name, r.answer) } else {
      r.answer.tables.members.fold(acc, |into: Map<RootName, Answer>, m: RootKey|
        into.insert(root_name(m), r.answer))
    })

// --- Order --------------------------------------------------------------------

/// Ascending by byte, each once.
fn ordered(xs: List<Bytes>) -> List<Bytes> =
  xs.fold(Map::new(), |acc: Map<Bytes, Bool>, x: Bytes| acc.insert(x, true)).keys()

/// Ascending, each once.
fn names_ordered(xs: List<RootName>) -> List<RootName> =
  xs.fold(Map::new(), |acc: Map<RootName, Bool>, x: RootName| acc.insert(x, true)).keys()

fn positions(keys: List<Bytes>) -> Map<Bytes, Int> / {abort.raise} =
  range(0, keys.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int| acc.insert(keys.get(i), i))

// --- The bodies a unit takes ------------------------------------------------------

/// A body the unit holds once: a group's under its first member.
pub type UnitBody = { name: RootName, text: Bytes, tables: Tables }

/// How a body defines `name`: by its place among the members, or the body's one definition.
fn defines(name: RootName, tables: Tables) -> Defined / {abort.raise} = {
  let found = range(0, tables.members.len()).fold(0 - 1, |acc: Int, i: Int|
    if acc < 0 && root_name(tables.members.get(i)) == name { i } else { acc });
  match tables.defined.at(if found < 0 { 0 } else { found }) {
    Some(d) -> d,
    None ->
      panic(
        String::of_bytes_lossy(
          b"an emitted body publishes the C it defines, and `".concat(root_text(name)).concat(
            b"`'s publishes none",
          ),
        ),
      ),
  }
}

/// Whether the body `name` is answered by is placed under `name`, of the roots `taken`: its own, or
/// a group's under the first of its members taken, which need not be the group's first.
fn heads_its_group(name: RootName, tables: Tables, taken: Map<RootName, Bool>) -> Bool =
  match tables.members.map(root_name).filter(|m: RootName| taken.contains(m)).at(0) {
    Some(first) -> first == name,
    None -> true,
  }

/// The symbol the unit's C defines root `name` by.
fn symbol_named(name: RootName) -> Bytes / {abort.raise} = symbol_of(root_text(name))

/// The entry the loader binds root `name`, defined as `d`, by; empty where it has none.
fn entry_defined(name: RootName, d: Defined) -> Bytes / {abort.raise} =
  if d.entered { entry_of(root_text(name)) } else { b"" }

/// The bodies of the roots `taken`, each once, and how each root is defined. A unit takes what its
/// roots reach, so every root taken has an answer and calls only roots taken; either failing is a
/// defect in Ply.
fn taken_bodies(
  answers: Map<RootName, Answer>,
  taken: List<RootName>,
) -> { bodies: List<UnitBody>, defined: Map<RootName, Defined> } / {abort.raise} = {
  let set = taken.fold(Map::new(), |acc: Map<RootName, Bool>, n: RootName| acc.insert(n, true));
  taken.fold(
    { bodies: [], defined: Map::new() },
    |r: { bodies: List<UnitBody>, defined: Map<RootName, Defined> }, name: RootName|
      match answers.get(name) {
        None ->
          panic(
            String::of_bytes_lossy(
              Bytes::concat_all([b"the emitter answered nothing for `", root_text(name), b"`"]),
            ),
          ),
        Some(b) -> match b.tables.calls.map(root_name).find(|c: RootName| !set.contains(c)) {
          Some(callee) ->
            panic(
              String::of_bytes_lossy(
                Bytes::concat_all([
                  b"`",
                  root_text(name),
                  b"` calls `",
                  root_text(callee),
                  b"`, which its unit does not take",
                ]),
              ),
            ),
          None ->
            {
              bodies: if heads_its_group(name, b.tables, set) {
                r.bodies.push({ name: name, text: b.text, tables: b.tables })
              } else { r.bodies },
              defined: r.defined.insert(name, defines(name, b.tables)),
            },
        },
      },
  )
}

/// Whether the runtime enters root `k` of `p`, so the unit takes its entry: a test's run or the
/// listing of its cases, a law's guard and body where a lifting reads each of its
/// binders, a definition `emit.enterable` admits by its scheme, and that definition's clauses where
/// a lifting reads its answer too. A specialisation has none.
fn entered_root(p: Program, k: RootKey) -> Bool =
  match k {
    Test(_) -> true,
    Cases(_) -> true,
    // A law over a type variable is judged by a proof over its sort, never entered.
    Law(_) -> match p.binders.get(root_name(k)) {
      Some(tys) -> tys.all(|t: Type| emit::lifted(p.crossing, t)),
      None -> false,
    },
    Clause(c) ->
      entered_root(p, c.def)
        && (match c.def {
          Named(n) -> match p.schemes.get(n) {
            Some(sc) -> emit::judgeable(p.crossing, sc),
            None -> false,
          },
          _ -> false,
        }),
    // A generic one is entered where it is judged, at `Int`, only over variables no constraint
    // hands a witness for: those its specialisation reads.
    Named(n) -> match ((p.schemes.get(n), p.roots.get(root_name(k)))) {
      (Some(sc), Some(r)) ->
        emit::enterable(p.crossing, sc) && (sc.ty_vars.len() == 0 || r.witnesses.len() == 0),
      (Some(sc), None) -> emit::enterable(p.crossing, sc) && sc.ty_vars.len() == 0,
      _ -> false,
    },
    _ -> false,
  }

/// The roots a program's answer offers, in the order `Dump.emitter_roots` lists them, each keyed by
/// what the front end's typed rows say it is, never by reading its name; and the name of each the
/// rows key none of, which no unit is made with.
pub type Offers = { keys: List<RootKey>, unkeyed: List<Bytes> }

pub fn offered_roots(dump: Dump) -> Offers / {abort.raise} = {
  let keyed = rows_keyed(dump);
  dump.emitter_roots.fold({ keys: [], unkeyed: [] }, |acc: Offers, r: EmitterRoot|
    match keyed.get(r.root) {
      Some(k) -> { ..acc, keys: acc.keys.push(k) },
      None -> { ..acc, unkeyed: acc.unkeyed.push(r.root) },
    })
}

/// Each root `dump`'s typed rows say its program may offer, by the name its rows spell it with: a
/// definition and each `requires` and `ensures` clause it states, a test's run and the listing of
/// its cases, and a law's guard and body. A test over no cases and a law of no guard key a root no
/// answer offers. The one place a row the release reads meets a key.
fn rows_keyed(dump: Dump) -> Map<Bytes, RootKey> / {abort.raise} = {
  let keyed = |m: Map<Bytes, RootKey>, k: RootKey| m.insert(root_text(root_name(k)), k);
  let defined = dump.defs.fold(Map::new(), |m: Map<Bytes, RootKey>, d: DefRow|
    d.spec.fold(
      { m: keyed(m, Named(d.name)), requires: 0, ensures: 0 },
      |acc: { m: Map<Bytes, RootKey>, requires: Int, ensures: Int }, s: SpecRow|
        if s.kind == spec_kind_text(SRequires) {
          {
            ..acc,
            m: keyed(acc.m, Clause({ def: Named(d.name), kind: Requires, n: acc.requires })),
            requires: acc.requires + 1,
          }
        } else if s.kind == spec_kind_text(SEnsures) {
          {
            ..acc,
            m: keyed(acc.m, Clause({ def: Named(d.name), kind: Ensures, n: acc.ensures })),
            ensures: acc.ensures + 1,
          }
        } else { acc },
    ).m);
  let tested = dump.tests.fold(defined, |m: Map<Bytes, RootKey>, t: TestRow| {
    let run = test_key(t.module, t.name);
    keyed(keyed(m, run), Cases(run))
  });
  dump.laws.fold(tested, |m: Map<Bytes, RootKey>, l: LawRow|
    keyed(keyed(m, law_key(l.module, l.name, LawGuard)), law_key(l.module, l.name, LawBody)))
}

// --- The unit's tables ------------------------------------------------------------

/// What a unit names that is not code, each table sorted by content and each entry once, so a
/// position is a rank among what the unit holds and a body's C is a function of the unit's content.
type Pools = { fields: List<Bytes>, lambdas: List<Bytes> }

/// The tables of `bodies`, whose static objects are `statics`, the field table holding the names
/// those statics' words name beside the bodies' own.
fn pools_of(
  bodies: List<UnitBody>,
  statics: List<StaticDef>,
  constant_entries: List<{ name: RootName, entry: Bytes }>,
) -> Pools / {abort.raise} = {
  let ts = bodies.map(|k: UnitBody| k.tables);
  let all = |pick: (Tables) -> List<Bytes>|
    ts.fold([], |acc: List<Bytes>, tables: Tables| acc.concat(pick(tables)));
  {
    fields: ordered(
      all(|tables: Tables| tables.fields).concat(
        statics.fold([], |acc: List<Bytes>, d: StaticDef| acc.concat(static_fields(d))),
      ),
    ),
    lambdas: ordered(
      constant_entries.map(|c: { name: RootName, entry: Bytes }|
        entry_named(c.name, c.entry)).concat(
        bodies.fold([], |acc: List<Bytes>, k: UnitBody|
          acc.concat(k.tables.lambdas.map(|l: Bytes| entry_named(k.name, l)))),
      ),
    ),
  }
}

/// `entry`, which the code table names for root `name`, the loader taking it by address: one of no
/// name stops the build at the root that named it, before any C is written.
fn entry_named(name: RootName, entry: Bytes) -> Bytes / {abort.raise} =
  if entry.len() > 0 { entry } else {
    panic(
      String::of_bytes_lossy(
        Bytes::concat_all([
          b"`",
          root_text(name),
          b"` names an entry of no name in the code table",
        ]),
      ),
    )
  }

/// Every static the unit's bodies name, each once and after those it addresses: in the order the
/// bodies list them, each body listing a static's children before it. Two statics of one name holding
/// different content stop the build, since a name is its content's digest.
fn statics_placed(bodies: List<UnitBody>) -> List<StaticDef> / {abort.raise} =
  bodies.fold(
    { out: [], seen: Map::new() },
    |acc: { out: List<StaticDef>, seen: Map<Bytes, StaticDef> }, k: UnitBody|
      k.tables.statics.fold(
        acc,
        |a: { out: List<StaticDef>, seen: Map<Bytes, StaticDef> }, d: StaticDef|
          match a.seen.get(d.name) {
            Some(e) -> if e == d { a } else {
              panic(
                String::of_bytes_lossy(
                  b"two statics of one name hold different content: ".concat(d.name),
                ),
              )
            },
            None -> { out: a.out.push(d), seen: a.seen.insert(d.name, d) },
          },
      ),
  ).out

/// The field-table names a static's words name.
fn static_fields(d: StaticDef) -> List<Bytes> =
  words_of(d).fold([], |acc: List<Bytes>, w: StaticWord|
    match w { WField(n) -> acc.push(n), _ -> acc })

/// Whether a static's C holds a position in the unit's field table, which moves with the unit.
fn holds_field(d: StaticDef) -> Bool = static_fields(d).len() > 0

/// The statics whose addresses a static's words hold.
fn addressed(d: StaticDef) -> List<Bytes> =
  words_of(d).fold([], |acc: List<Bytes>, w: StaticWord|
    match w { WAddress(a) -> acc.push(a.name), _ -> acc })

type Placed = { fields: Map<Bytes, Int>, lambdas: Map<Bytes, Int> }

fn placed_of(p: Pools) -> Placed / {abort.raise} =
  { fields: positions(p.fields), lambdas: positions(p.lambdas) }

fn place(m: Map<Bytes, Int>, key: Bytes) -> Int / {abort.raise} =
  match m.get(key) {
    Some(i) -> i,
    None -> panic("the unit's tables hold everything its bodies name"),
  }

// --- Sites ----------------------------------------------------------------------

/// A placeholder in a body's C, `@@kN@@`: where it opens and closes, its kind byte, and what
/// follows the kind.
type Hole = { open: Int, close: Int, kind: Int, digits: Bytes }

fn holes(text: Bytes) -> List<Hole> / {abort.raise} =
  iterate({ from: 0, out: [] }, text.len() + 1, |s: { from: Int, out: List<Hole> }|
    match text.index_of_from(b"@@", s.from) {
      None -> Stop(s.out),
      Some(open) -> match text.index_of_from(b"@@", open + 2) {
        None -> panic("an emitted placeholder always closes"),
        Some(close) ->
          Continue({
            from: close + 2,
            out: s.out.push({
              open: open,
              close: close,
              kind: text.at(open + 2),
              digits: text.slice(open + 3, close),
            }),
          }),
      },
    })

/// What a hole a body's tables report names in the unit's tables, its kind leading so a part's table
/// sorts by kind.
fn keyed_key(k: Keyed, tables: Tables) -> Bytes / {abort.raise} =
  match k {
    KeyedTag(name) -> b"T".concat(name),
    KeyedField(i) -> b"f".concat(tables.fields.get(i)),
    KeyedEntry(i) -> b"l".concat(tables.lambdas.get(i)),
  }

/// The hole of the unit's tables placeholder `h` is.
fn keyed_of(h: Hole) -> Keyed / {abort.raise} =
  if h.kind == 84 { KeyedTag(h.digits) }
  else if h.kind == 102 { KeyedField(digits(h.digits)) }
  else if h.kind == 108 { KeyedEntry(digits(h.digits)) }
  else { panic("an emitted placeholder of no kind the unit resolves") }

/// A key's position in the unit's table of its kind, which is what the loader writes for it.
fn unit_place(key: Bytes, p: Placed, tags: Map<Bytes, Int>) -> Int / {abort.raise} = {
  let kind = key.at(0);
  let rest = key.slice(1, key.len());
  if kind == 84 { place(tags, rest) }
  else if kind == 102 { place(p.fields, rest) }
  else { place(p.lambdas, rest) }
}

/// The table a part's C reads the unit's positions from, which the `tables` part defines.
fn part_table(label: String) -> Bytes = b"ply_part".concat(Bytes::of_string(label))

/// The root whose symbol a body's own placeholder stands for: its own, or a group's first member's.
fn own_root(body: UnitBody) -> RootName =
  match body.tables.members.at(0) { Some(m) -> root_name(m), None -> body.name }

/// `body`'s C with each placeholder written as its part names it: the root a failure site names as
/// its id, a root the body defines as its symbol, and the rest as a position in the part's own
/// table, so the C reads the same whatever else the unit holds. `site` is the root its failure sites
/// name, and `local` holds each key of the part's table `table` by its position.
fn resolved(
  body: UnitBody,
  site: RootName,
  table: Bytes,
  local: Map<Bytes, Int>,
) -> Bytes / {abort.raise} = {
  let text = body.text;
  let member = |h: Hole, otherwise: RootName|
    if h.digits.len() == 0 { otherwise }
    else { root_name(body.tables.members.get(digits(h.digits))) };
  let walked = holes(text).fold(
    { from: 0, out: [] },
    |s: { from: Int, out: List<Bytes> }, h: Hole| {
      let value = if h.kind == 114 { ascii_of_int(root_id(root_text(member(h, site)))) }
      else if h.kind == 115 { symbol_named(member(h, own_root(body))) } else {
        Bytes::concat_all([
          table,
          b"[",
          ascii_of_int(place(local, keyed_key(keyed_of(h), body.tables))),
          b"]",
        ])
      };
      { from: h.close + 2, out: s.out.push(text.slice(s.from, h.open)).push(value) }
    },
  );
  Bytes::concat_all(walked.out.push(text.slice(walked.from, text.len())))
}

// --- What the unit says about itself ---------------------------------------------

type Taken = { name: RootName, arity: Int, symbol: Bytes, entry: Bytes, head: Head }

fn counted(label: Bytes, n: Int) -> Bytes = Bytes::concat_all([label, b" ", ascii_of_int(n), b"\n"])

fn lines(label: Bytes, xs: List<Bytes>) -> Bytes =
  Bytes::concat_all([counted(label, xs.len())].concat(xs.map(|x: Bytes| x.concat(b"\n"))))

/// What a unit says about itself for its loader to read: the helpers it binds, each constant with
/// its row of the code table, the pools its positions index, and each root the runtime enters
/// through its entry, `R#entered`, which it takes. What the loader takes by address, the `taken` and
/// `tables` parts lay out instead.
fn exports_text(
  helpers: List<Native>,
  constants: List<Bytes>,
  modules: Int,
  p: Pools,
  entered: List<RootName>,
) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    lines(
      b"helpers",
      helpers.map(|h: Native|
        Bytes::concat_all([
          h.name,
          b" ",
          ascii_of_int(h.params.len()),
          b" ",
          dump_flag(h.answer != None),
        ])),
    ),
    lines(b"constants", constants),
    counted(b"modules", modules),
    lines(b"fields", p.fields),
    Bytes::concat_all(
      entered.map(|r: RootName| Bytes::concat_all([b"entered ", root_text(r), b"\n"])),
    ),
  ])

/// `line` and the newline ending it as adjacent C string literals, the newline's last.
fn literal_lines(line: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([c_string(line), b" \"\\n\"\n"])

/// The text's lines as `str::lines` reads them: a final newline ends the last line rather than
/// opening another, and a carriage return before a newline is part of the ending.
fn split_lines(text: Bytes) -> List<Bytes> / {abort.raise} = {
  let parts = text.split(b"\n");
  let whole = if parts.len() > 0 && parts.get(parts.len() - 1).len() == 0 {
    parts.take(parts.len() - 1)
  } else { parts };
  whole.map(|l: Bytes|
    if l.len() > 0 && l.at(l.len() - 1) == 13 { l.slice(0, l.len() - 1) } else { l })
}

/// The table as C string literals, non-printable bytes and `?` in octal.
fn embedded(exports: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\n/* --- what this unit says about itself, read by the loader --- */\n",
    b"const char ply_exports[] =\n",
    Bytes::concat_all(split_lines(exports).map(literal_lines)),
    b";\n",
  ])

/// A part of the unit's C after the runtime's: its mark on a line of its own, then `c`.
fn section(label: String, c: Bytes) -> Bytes =
  Bytes::concat_all([b"\n", part_mark(label), b"\n", c])

/// What the runtime reads of each root a unit takes, which `taken_part` lays out and the
/// descriptor points at.
fn taken_struct() -> Bytes =
  b"struct ply_taken { const char *name; void *entry; unsigned long arity; };\n"

/// Each of `entries`, which a part holding a body defines, declared once so its address can be taken.
fn entries_declared(entries: List<Bytes>) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    ordered(entries).map(|n: Bytes| Bytes::concat_all([b"extern char ", n, b";\n"])),
  )

/// The `taken` part, which moves with the roots the unit takes: each of `taken` by name in byte
/// order, with its entry and how many words it takes, closed with a zero.
fn taken_part(taken: List<Taken>) -> Bytes / {abort.raise} =
  section(
    "taken",
    Bytes::concat_all([
      taken_struct(),
      entries_declared(taken.map(|t: Taken| t.entry).filter(|e: Bytes| e.len() > 0)),
      b"const struct ply_taken ply_taken[] = {\n",
      Bytes::concat_all(
        taken.map(|t: Taken|
          Bytes::concat_all([
            b"  { \"",
            escaped(root_text(t.name)),
            b"\", ",
            if t.entry.len() == 0 { b"(void *)0" } else { b"(void *)&".concat(t.entry) },
            b", ",
            ascii_of_int(t.arity),
            b" },\n",
          ])),
      ),
      b"  { 0, 0, 0 } };\n",
    ]),
  )

/// The `tables` part, which moves with the unit's tables: what the loader takes by address, so it
/// looks no symbol up and fills no table. Each part's table holding the unit's positions, the code
/// table in the unit's order closed with a zero, what the unit says about itself, and
/// `ply_descriptor`, which holds those, the `taken` part's `ply_taken` and its `taken` rows, and the
/// unit's two binders. A native program's `main` hands the runtime the descriptor, so the program
/// exports nothing for `dlsym` to find.
fn tables_part(
  parts: List<Part>,
  lambdas: List<Bytes>,
  exports: Bytes,
  taken: Int,
) -> Bytes / {abort.raise} =
  section(
    "tables",
    Bytes::concat_all([
      Bytes::concat_all(
        parts.filter(|p: Part| p.places.len() > 0).map(|p: Part|
          Bytes::concat_all([
            b"const uint32_t ",
            part_table(p.label),
            b"[] = {",
            Bytes::concat_all(
              p.places.map(|n: Int| Bytes::concat_all([b" ", ascii_of_int(n), b","])),
            ),
            b" };\n",
          ])),
      ),
      entries_declared(lambdas),
      b"void *const ply_code[] = {\n",
      Bytes::concat_all(lambdas.map(|n: Bytes| Bytes::concat_all([b"  (void *)&", n, b",\n"]))),
      b"  0 };\n",
      embedded(exports),
      taken_struct(),
      b"extern const struct ply_taken ply_taken[];\n",
      b"void ply_bind(void **fns);\n",
      b"struct ply_descriptor { const char *exports; unsigned long exports_len; void *bind; void *bind_singletons; void *const *code; unsigned long code_count; const struct ply_taken *taken; unsigned long taken_count; };\n",
      b"const struct ply_descriptor ply_descriptor = { ply_exports, sizeof ply_exports - 1, (void *)ply_bind, (void *)0, ply_code, ",
      ascii_of_int(lambdas.len()),
      b", ply_taken, ",
      ascii_of_int(taken),
      b" };\n",
    ]),
  )

/// The `fields` part, which moves with the unit's field table: each of `statics` that holds a field's
/// position, in their order, each static they address that a part defines declared first; nothing
/// where none does.
fn fields_part(
  statics: List<StaticDef>,
  constant_c: (StaticDef) -> Bytes / {abort.raise},
) -> Bytes / {abort.raise} = {
  let held = statics.filter(holds_field);
  let own = held.fold(Map::new(), |acc: Map<Bytes, Bool>, d: StaticDef| acc.insert(d.name, true));
  if held.len() == 0 { b"" } else {
    section(
      "fields",
      Bytes::concat_all([
        Bytes::concat_all(
          ordered(held.fold([], |acc: List<Bytes>, d: StaticDef| acc.concat(addressed(d)))).filter(
            |n: Bytes| !own.contains(n),
          ).map(
            static_extern,
          ),
        ),
        Bytes::concat_all(held.map(constant_c)),
      ]),
    )
  }
}

// --- Placing it -----------------------------------------------------------------

type Placing = {
  name: RootName,
  text: Bytes,
  reaches: List<RootName>,
  /// The static objects its C names.
  statics: List<Bytes>,
  /// The functions closures alike share that its C names, which its part defines once.
  shared: List<SharedFn>,
  /// The helpers of the machine natives its C calls, whose pointers its part declares.
  natives: List<Bytes>,
}

/// A body and the keys of the unit's tables its holes name, which its part's table is made of.
type Marked = { body: UnitBody, keys: List<Bytes> }

/// Where a unit's C starts a new part, in bytes of its bodies' C before their placeholders are
/// resolved: at a body whose root id has its low `bits` bits all zero, once the part holds `min`;
/// and before a body that would take the part past `max`, so a body larger than `max` sits alone.
/// Since names pick the cuts, an edit to a body seldom moves one.
pub type PartRule = { bits: Int, min: Int, max: Int }

/// The rule a build cuts its units into parts by.
pub fn part_rule() -> PartRule = { bits: 6, min: 65536, max: 1048576 }

/// The module whose parts root `k`'s body sits among: for a specialisation that runs another
/// root's lambdas in place, the first such root's module, so an edit to a lambda moves only its own
/// module's parts; otherwise its own.
fn home_of(k: RootKey) -> Bytes =
  match key_lent(k).at(0) { Some(f) -> module_of(f.owner), None -> module_of(k) }

/// Where a body sits in the unit's C: among its home module's bodies, by name.
fn order_key(home: Bytes, name: RootName) -> Bytes =
  Bytes::concat_all([home, b"\x00", root_text(name)])

/// `bodies`, in the unit's order, cut into parts by `rule`.
fn parted(bodies: List<Marked>, rule: PartRule) -> List<List<Marked>> = {
  let walked = bodies.fold(
    { parts: [], part: [], bytes: 0 },
    |acc: { parts: List<List<Marked>>, part: List<Marked>, bytes: Int }, m: Marked| {
      let size = m.body.text.len();
      let picked = root_id(root_text(m.body.name)) & (1 << rule.bits) - 1 == 0;
      if acc.part.len() > 0 && ((acc.bytes >= rule.min && picked) || acc.bytes + size > rule.max) {
        { parts: acc.parts.push(acc.part), part: [m], bytes: size }
      } else { { parts: acc.parts, part: acc.part.push(m), bytes: acc.bytes + size } }
    },
  );
  if walked.part.len() == 0 { walked.parts } else { walked.parts.push(walked.part) }
}

/// A part's label: its first body's root id as 16 hex digits, which no word labelling a part of the
/// unit's tail is.
fn part_label(name: RootName) -> String / {abort.raise} =
  String::of_bytes(hex(u64_be(root_id(root_text(name)))))

/// A part of a unit's C: its label, the unit's position for each key of its table, its bodies, and
/// the constants it defines, each after those it addresses.
type Part = { label: String, places: List<Int>, bodies: List<Placing>, constants: List<StaticDef> }

/// The keys a part's table holds: each one its bodies' placeholders name, once, in byte order.
fn part_keys(group: List<Marked>) -> List<Bytes> =
  ordered(group.fold([], |acc: List<Bytes>, m: Marked| acc.concat(m.keys)))

/// The constants the part of `group`'s bodies defines, in the order they name them, and every
/// constant defined once it does: each one they name that holds no field's position and that no
/// earlier part defines, as `defined` holds those.
fn constants_defined(
  group: List<Marked>,
  defined: Map<Bytes, Bool>,
) -> { constants: List<StaticDef>, defined: Map<Bytes, Bool> } =
  group.fold(
    { constants: [], defined: defined },
    |acc: { constants: List<StaticDef>, defined: Map<Bytes, Bool> }, m: Marked|
      m.body.tables.statics.fold(
        acc,
        |a: { constants: List<StaticDef>, defined: Map<Bytes, Bool> }, d: StaticDef|
          if holds_field(d) || a.defined.contains(d.name) { a }
          else { { constants: a.constants.push(d), defined: a.defined.insert(d.name, true) } },
      ),
  )

/// What a body's C names of the unit's definitions: its own, a group's every member, and its calls.
fn reaches_of(name: RootName, tables: Tables) -> List<RootName> =
  names_ordered(
    tables.calls.map(root_name).concat(if tables.members.len() == 0 { [name] }
    else { tables.members.map(root_name) }),
  )

fn prototype(symbol: Bytes, head: Head) -> Bytes =
  Bytes::concat_all([
    head.answer,
    b" ",
    symbol,
    b"(PlyCtx*",
    Bytes::concat_all(head.params.map(|t: Bytes| b", ".concat(t))),
    b");\n",
  ])

/// The head, which every part compiles after; then each part of `parts`; then the runtime's part,
/// which binds the pointer to each of `machine`, the natives of shipped modules the unit calls over
/// machine words, beside the head's own; then `tail`, the parts after it. The loader compiles each
/// part alone, cut on the marks.
fn assembled(
  parts: List<Part>,
  taken: Map<RootName, Taken>,
  constant_c: (StaticDef) -> Bytes / {abort.raise},
  machine: List<Native>,
  tail: Bytes,
) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    unit_head(),
    Bytes::concat_all(parts.map(|p: Part| part_c(p, taken, constant_c, machine))),
    unit_tail(machine),
    tail,
  ])

/// A part's C: its mark, then what it takes from the rest of the unit, declared (its table, each
/// constant its bodies name that it does not define, the prototype of each root they reach and the
/// pointer to each of `machine` they call), then its constants, the functions its closures share and
/// its bodies. It reads the same whatever the unit holds beside it, but for which of the constants
/// it names an earlier part defines.
fn part_c(
  p: Part,
  taken: Map<RootName, Taken>,
  constant_c: (StaticDef) -> Bytes / {abort.raise},
  machine: List<Native>,
) -> Bytes / {abort.raise} = {
  let defined = p.constants.fold(Map::new(), |acc: Map<Bytes, Bool>, d: StaticDef|
    acc.insert(d.name, true));
  let called = p.bodies.fold(Map::new(), |acc: Map<Bytes, Bool>, body: Placing|
    body.natives.fold(acc, |m: Map<Bytes, Bool>, n: Bytes| m.insert(n, true)));
  Bytes::concat_all([
    part_mark(p.label),
    b"\n",
    if p.places.len() == 0 { b"" }
    else { Bytes::concat_all([b"extern const uint32_t ", part_table(p.label), b"[];\n"]) },
    Bytes::concat_all(
      ordered(p.bodies.fold([], |acc: List<Bytes>, body: Placing| acc.concat(body.statics))).filter(
        |n: Bytes| !defined.contains(n),
      ).map(
        static_extern,
      ),
    ),
    Bytes::concat_all(
      names_ordered(
        p.bodies.fold([], |acc: List<RootName>, body: Placing| acc.concat(body.reaches)),
      ).map(|name: RootName|
        match taken.get(name) { Some(t) -> prototype(t.symbol, t.head), None -> b"" }),
    ),
    Bytes::concat_all(machine.filter(|n: Native| called.contains(n.name)).map(pointer_declared)),
    b"\n",
    Bytes::concat_all(p.constants.map(constant_c)),
    shared_written(p.bodies),
    Bytes::concat_all(p.bodies.map(|body: Placing| body.text.concat(b"\n"))),
  ])
}

/// The natives of shipped modules `bodies` call over machine words, which the head declares no
/// pointer to: each one `machine_of` declares among the helpers they call beyond `bound`'s.
fn machine_called(
  bodies: List<UnitBody>,
  machine_of: (Map<Bytes, Bool>) -> List<Native> / {abort.raise},
) -> List<Native> / {abort.raise} = {
  let beyond = bound().fold(natives_of(bodies), |acc: Map<Bytes, Bool>, n: Native|
    acc.remove(n.name));
  if beyond.len() == 0 { [] } else { machine_of(beyond) }
}

/// Each function closures alike share that the bodies of `group` name, once, in the order they first
/// name them.
fn shared_written(group: List<Placing>) -> Bytes =
  group.fold(
    { seen: Map::new(), out: [] },
    |acc: { seen: Map<Bytes, Bool>, out: List<Bytes> }, p: Placing|
      p.shared.fold(acc, |a: { seen: Map<Bytes, Bool>, out: List<Bytes> }, f: SharedFn|
        if a.seen.contains(f.symbol) { a }
        else { { seen: a.seen.insert(f.symbol, true), out: a.out.push(f.text) } }),
  ).out.fold(b"", |acc: Bytes, t: Bytes| acc.concat(t))

/// Body `m` placed in the part whose table is `table`, of the keys `local` holds: its placeholders
/// resolved, `site` the root its failure sites name.
fn placing(
  m: Marked,
  site: RootName,
  table: Bytes,
  local: Map<Bytes, Int>,
) -> Placing / {abort.raise} =
  {
    name: m.body.name,
    text: resolved(m.body, site, table, local),
    reaches: reaches_of(m.body.name, m.body.tables),
    statics: m.body.tables.statics.map(|d: StaticDef| d.name),
    shared: m.body.tables.shared,
    natives: m.body.tables.natives,
  }

/// `bodies`, in the unit's order, cut into parts by `rule`: each part's table holding the unit's
/// `position` of each key its bodies name, and each body's placeholders resolved against it, `site`
/// the root the body's failure sites name.
fn parts_of(
  bodies: List<Marked>,
  rule: PartRule,
  site: (RootName) -> RootName / {abort.raise},
  position: (Bytes) -> Int / {abort.raise},
) -> List<Part> / {abort.raise} =
  parted(bodies, rule).fold(
    { parts: [], defined: Map::new() },
    |acc: { parts: List<Part>, defined: Map<Bytes, Bool> }, group: List<Marked>| {
      let label = part_label(group.get(0).body.name);
      let keys = part_keys(group);
      let local = positions(keys);
      let c = constants_defined(group, acc.defined);
      {
        parts: acc.parts.push({
          label: label,
          places: keys.map(position),
          bodies: group.map(|m: Marked| placing(m, site(m.body.name), part_table(label), local)),
          constants: c.constants,
        }),
        defined: c.defined,
      }
    },
  ).parts

/// The unit over `offered`, from each root's answer: closed under calls, its tables sorted by
/// content, its bodies resolved against them and cut into parts by `rule`, and what it holds
/// embedded in its C. `modules` is how many modules the program it was emitted from has, and
/// `inputs` the bytes of each file it embeds, by digest.
pub fn produce(
  ctors: List<Ctor>,
  offered: List<Offered>,
  modules: Int,
  answers: Map<RootName, Answer>,
  inputs: Map<Bytes, Bytes>,
  machine_of: (Map<Bytes, Bool>) -> List<Native> / {abort.raise},
  rule: PartRule,
) -> Produced / {abort.raise} = {
  let offers = offered.fold(Map::new(), |acc: Map<RootName, Offered>, o: Offered|
    acc.insert(o.name, o));
  let offer_of = |n: RootName|
    match offers.get(n) { Some(o) -> o, None -> panic("every body a unit takes was offered it") };
  let names = names_ordered(offered.map(|o: Offered| o.name));
  let s = taken_bodies(answers, names);
  let machine = machine_called(s.bodies, machine_of);
  let published = |n: RootName|
    match s.defined.get(n) {
      Some(d) -> d,
      None -> panic("every definition a unit takes emitted, and an emitted body publishes its C"),
    };
  let entry = |n: RootName| entry_defined(n, published(n));
  let constants = names.filter(|n: RootName|
    match offers.get(n) { Some(o) -> o.constant, None -> false });
  let statics = statics_placed(s.bodies);
  let pools = pools_of(
    s.bodies,
    statics,
    constants.map(|n: RootName| { name: n, entry: entry(n) }),
  );
  let placed = placed_of(pools);
  let constant_c = |d: StaticDef|
    static_c(
      d,
      |f: Bytes| place(placed.fields, f),
      |k: RootKey| symbol_named(root_name(k)),
      |digest: Bytes|
        match inputs.get(digest) {
          Some(b) -> b,
          None ->
            panic(
              "a unit holds an embedded file it was not handed the bytes of, which its driver reads for every embed it emits",
            ),
        },
    );
  let tags = positions(ctors.map(|c: Ctor| c.name));
  let taken = names.map(|n: RootName|
    {
      name: n,
      arity: match offers.get(n) { Some(o) -> o.arity, None -> 0 },
      symbol: symbol_named(n),
      entry: entry(n),
      head: published(n).head,
    });
  // Each call was written to the head its caller read; the callee's own must be that head.
  s.bodies.fold((), |_u: Unit, k: UnitBody|
    k.tables.generics.expects.fold((), |_v: Unit, e: Expect|
      match expected_callee(k.tables, e) {
        None -> (),
        Some(callee) -> match s.defined.get(callee) {
          Some(d) -> if d.head != e.head {
            panic(
              String::of_bytes_lossy(
                Bytes::concat_all([
                  b"`",
                  root_text(k.name),
                  b"` calls `",
                  root_text(callee),
                  b"` as ",
                  prototype(symbol_named(callee), e.head),
                  b"which it defines as ",
                  prototype(symbol_named(callee), d.head),
                ]),
              ),
            )
          } else { () },
          None -> (),
        },
      }));
  let marked = s.bodies.fold(Map::new(), |acc: Map<Bytes, Marked>, k: UnitBody|
    acc.insert(order_key(offer_of(k.name).home, k.name), {
      body: k,
      keys: k.tables.keyed.map(|x: Keyed| keyed_key(x, k.tables)),
    })).values(
  );
  let parts = parts_of(marked, rule, |n: RootName| offer_of(n).site, |k: Bytes|
    unit_place(k, placed, tags));
  let exports = exports_text(
    bound().concat(machine),
    constants.map(|n: RootName|
      Bytes::concat_all([root_text(n), b" ", ascii_of_int(place(placed.lambdas, entry(n)))])),
    modules,
    pools,
    // An entry's site is the root it enters, which the unit need not hold: a generic definition's
    // callers settle its body, and its entry calls a specialisation.
    offered.filter(|o: Offered| o.name == entry_name(o.site)).map(|o: Offered| o.site),
  );
  let by_name = taken.fold(Map::new(), |acc: Map<RootName, Taken>, t: Taken| acc.insert(t.name, t));
  {
    text: assembled(
      parts,
      by_name,
      constant_c,
      machine,
      Bytes::concat_all([
        fields_part(statics, constant_c),
        taken_part(by_name.values()),
        tables_part(parts, pools.lambdas, exports, by_name.len()),
      ]),
    ),
    taken: names,
    made: { bodies: s.bodies, offered: offered },
  }
}

// --- What a root runs ----------------------------------------------------------

/// The names a body answers for: a group's members, or its own.
fn answered(body: UnitBody) -> List<RootName> =
  if body.tables.members.len() == 0 { [body.name] } else { body.tables.members.map(root_name) }

/// How a body's roots were offered, which places them: a constant is held rather than called.
fn offered_as(roots: Map<RootName, Offered>, body: UnitBody) -> Bytes =
  Bytes::concat_all(
    answered(body).map(|name: RootName|
      match roots.get(name) {
        Some(o) ->
          Bytes::concat_all([
            root_text(name),
            b" ",
            ascii_of_int(o.arity),
            if o.constant { b" constant\n" } else { b"\n" },
          ]),
        None -> root_text(name).concat(b" unoffered\n"),
      }),
  )

/// What each root of a unit runs, as one digest: its own body and every body it can call, whatever
/// the calls' cycles. A body is digested as the unit keeps it, before placing, so a root that two
/// compilers or two units made into the same code is named alike by both.
pub fn codes(made: Made) -> Map<RootName, Bytes> / {abort.raise} = {
  let bodies = made.bodies;
  let n = bodies.len();
  let index = range(0, n).fold(Map::new(), |acc: Map<RootName, Int>, i: Int|
    answered(bodies.get(i)).fold(acc, |m: Map<RootName, Int>, name: RootName| m.insert(name, i)));
  let roots = made.offered.fold(Map::new(), |acc: Map<RootName, Offered>, o: Offered|
    acc.insert(o.name, o));
  let own = bodies.map(|b: UnitBody|
    blake3(
      Bytes::concat_all([
        blake3(root_text(b.name)),
        blake3(b.text),
        blake3(bin::encode(b.tables, tables_bin())),
        blake3(offered_as(roots, b)),
      ]),
    ));
  let adj = bodies.map(|b: UnitBody|
    b.tables.calls.fold([], |acc: List<Int>, c: RootKey|
      match index.get(root_name(c)) { Some(j) -> acc.push(j), None -> acc }));
  // Components come callees first, so each folds in the digests of those it reaches.
  let components = graph::components({ out: adj });
  let reached = components.fold(Map::new(), |done: Map<Int, Bytes>, comp: List<Int>| {
    let inside = comp.fold(Map::new(), |m: Map<Int, Bool>, i: Int| m.insert(i, true));
    let below = comp.fold([], |acc: List<Bytes>, i: Int|
      adj.get(i).fold(acc, |a: List<Bytes>, j: Int|
        if inside.contains(j) { a }
        else { match done.get(j) { Some(d) -> a.push(d), None -> a } }));
    let digest = blake3(
      Bytes::concat_all(ordered(comp.map(|i: Int| own.get(i))).concat(ordered(below))),
    );
    comp.fold(done, |m: Map<Int, Bytes>, i: Int| m.insert(i, digest))
  });
  range(0, n).fold(Map::new(), |acc: Map<RootName, Bytes>, i: Int| {
    let code = blake3(own.get(i).concat(match reached.get(i) { Some(d) -> d, None -> b"" }));
    answered(bodies.get(i)).fold(acc, |m: Map<RootName, Bytes>, name: RootName|
      m.insert(name, code))
  })
}

// --- Emitting what no earlier run kept --------------------------------------------

/// What the front end's answer says the emitter works over: each root, the modules in program order,
/// what each module imports, and the modules a unit reads.
type Program = {
  roots: Map<RootName, EmitterRoot>,
  keys: Map<RootName, Bytes>,
  modules: List<ModuleRow>,
  imports: Map<Bytes, List<Bytes>>,
  /// Each module the unit reads, by its name, with the modules it depends on (`modules_read`).
  read: Map<Bytes, List<Bytes>>,
  sources: List<Bytes>,
  /// A digest of what each module embeds, by its index: the emitter writes each call out as its bytes.
  embeds: Map<Int, Bytes>,
  /// Each definition's scheme, as the emitter types it.
  schemes: Map<Bytes, Scheme>,
  /// The types of each law's binders, by its guard's and its body's root.
  binders: Map<RootName, List<Type>>,
  crossing: CrossedSums,
  /// Each declared type's hash, which covers all it reaches, by its name: another program may
  /// declare another type under the same name.
  declared: Map<Bytes, Bytes>,
  /// Each module's text the unit reads digested, by its name, taken once however many roots it writes.
  digests: Map<Bytes, Bytes>,
  /// The functions the program's types state, each printed with the entry the runtime calls it by.
  stated: Map<Bytes, Bool>,
}

/// The program `dump` answers, its modules' texts `sources`, as a unit over `roots` reads it.
fn program_of(dump: Dump, sources: List<Bytes>, roots: List<RootKey>) -> Program / {abort.raise} = {
  let keyed = rows_keyed(dump);
  let named = |row: Bytes| match keyed.get(row) { Some(k) -> Some(root_name(k)), None -> None };
  let by_name = dump.modules.fold(Map::new(), |acc: Map<Bytes, ModuleRow>, m: ModuleRow|
    acc.insert(m.name, m));
  // The program's own prelude, which every module imports; a scope left without one takes the
  // shipped prelude's text.
  let read = modules_read(by_name, sources, modules_lowered(roots).keys().push(prelude_module()));
  let reads = dump.embeds.fold(Map::new(), |acc: Map<Int, List<Bytes>>, e: EmbedAt|
    match by_name.get(e.module) {
      None -> acc,
      Some(m) ->
        acc.insert(
          m.index,
          List::push(
            match acc.get(m.index) { Some(xs) -> xs, None -> [] },
            sized(e.key).concat(read_key(e.read)),
          ),
        ),
    });
  let schemes = dump.rows.defs.fold(Map::new(), |acc: Map<Bytes, Scheme>, row: KnownDefRow|
    acc.insert(row.name, row.scheme));
  let prelude = prelude_module().concat(b".");
  {
    roots: dump.emitter_roots.fold(
      Map::new(),
      |acc: Map<RootName, EmitterRoot>, root: EmitterRoot|
        match named(root.root) { Some(n) -> acc.insert(n, root), None -> acc },
    ),
    keys: dump.keys.fold(Map::new(), |acc: Map<RootName, Bytes>, k: KeyRow|
      match named(k.root) { Some(n) -> acc.insert(n, k.key), None -> acc }),
    // The emitter walks modules in the front end's ordinal order, so this order is not ours to pick.
    modules: dump.ordinals.fold([], |acc: List<ModuleRow>, o: OrdinalRow|
      match by_name.get(o.module) { Some(m) -> acc.push(m), None -> acc }),
    imports: by_name.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, n: Bytes, m: ModuleRow|
      acc.insert(n, m.imports)),
    read: read,
    sources: sources,
    embeds: reads.fold(Map::new(), |acc: Map<Int, Bytes>, i: Int, parts: List<Bytes>|
      acc.insert(i, blake3(Bytes::concat_all(ordered(parts))))),
    schemes: schemes,
    binders: dump.laws.fold(Map::new(), |acc: Map<RootName, List<Type>>, l: LawRow| {
      let tys = l.binders.map(|b: BinderRow| b.ty);
      [LawGuard, LawBody].fold(acc, |m: Map<RootName, List<Type>>, part: LawPart|
        m.insert(root_name(law_key(l.module, l.name, part)), tys))
    }),
    crossing: sums_crossed(ctor_sums(dump.ctors), |n: Bytes| schemes.contains(prelude.concat(n))),
    declared: {
      let types = dump.types.fold(Map::new(), |acc: Map<Bytes, Bool>, t: TypeRow|
        acc.insert(t.name, true));
      dump.hashes.fold(Map::new(), |acc: Map<Bytes, Bytes>, f: HashFrame|
        match f {
          HDef(row) -> match row.decl {
            Some(h) -> if types.contains(row.name) { acc.insert(row.name, h) } else { acc },
            None -> acc,
          },
          _ -> acc,
        })
    },
    digests: read.fold(Map::new(), |acc: Map<Bytes, Bytes>, m: Bytes, _: List<Bytes>|
      match match by_name.get(m) { Some(row) -> sources.at(row.index), None -> None } {
        Some(t) -> acc.insert(m, blake3(t)),
        None -> acc,
      }),
    stated: stated_fns(dump),
  }
}

/// Each module the roots written in `starts` read, by its name, with the modules it depends on: what
/// it imports and what it reads with no import (a type's home, the scheduler), closed over those.
/// `by_name` holds the program's modules, whose texts `sources` holds by index; a module is lexed
/// only once the closure reaches it.
fn modules_read(
  by_name: Map<Bytes, ModuleRow>,
  sources: List<Bytes>,
  starts: List<Bytes>,
) -> Map<Bytes, List<Bytes>> / {abort.raise} = {
  let text = |m: Bytes| match by_name.get(m) { Some(row) -> sources.at(row.index), None -> None };
  let declared = homes_declaring(text);
  let deps = |m: Bytes| {
    let homes = match text(m) {
      Some(t) -> read_without_import(m, parsing::start(t).input, || declared),
      None -> [],
    };
    (match by_name.get(m) { Some(row) -> row.imports, None -> [] }).concat(homes).filter(
      |d: Bytes| d != m && by_name.contains(d),
    )
  };
  // Each round reads a module no earlier one did.
  iterate(
    { read: Map::new(), next: starts.filter(|m: Bytes| by_name.contains(m)) },
    by_name.len() + 1,
    |s: { read: Map<Bytes, List<Bytes>>, next: List<Bytes> }| {
      let read = s.next.fold(s.read, |acc: Map<Bytes, List<Bytes>>, m: Bytes|
        if acc.contains(m) { acc } else { acc.insert(m, deps(m)) });
      let next = s.next.fold([], |acc: List<Bytes>, m: Bytes|
        if s.read.contains(m) { acc } else {
          (match read.get(m) { Some(ds) -> ds, None -> [] }).fold(acc, |a: List<Bytes>, d: Bytes|
            if read.contains(d) { a } else { a.push(d) })
        });
      if next.len() == 0 { Stop({ read: read, next: [] }) }
      else { Continue({ read: read, next: next }) }
    },
  ).read
}

/// The modules a scope must hold to answer the roots `ks`, of those `p` reads: each module they are
/// lowered in (`modules_lowered`), each module declaring a type their keys are at, whose roots
/// written for types their answers call are answered with them, and the prelude, with every module
/// each of those depends on.
fn modules_asked(p: Program, ks: List<RootKey>) -> Map<Bytes, Bool> / {abort.raise} = {
  let starts = ks.fold(
    modules_lowered(ks).insert(prelude_module(), true),
    |acc: Map<Bytes, Bool>, k: RootKey|
      types_keyed(k).fold(acc, |m: Map<Bytes, Bool>, t: Type|
        type_names(t).fold(m, |into: Map<Bytes, Bool>, n: Bytes| {
          let home = module_of_name(n);
          if home.len() == 0 { into } else { into.insert(home, true) }
        })),
  );
  iterate(
    { closed: Map::new(), next: starts.keys().filter(|m: Bytes| p.read.contains(m)) },
    p.read.len() + 1,
    |s: { closed: Map<Bytes, Bool>, next: List<Bytes> }| {
      let closed = s.next.fold(s.closed, |acc: Map<Bytes, Bool>, m: Bytes| acc.insert(m, true));
      let next = s.next.fold(Map::new(), |acc: Map<Bytes, Bool>, m: Bytes|
        List::fold(
          match p.read.get(m) { Some(ds) -> ds, None -> [] },
          acc,
          |a: Map<Bytes, Bool>, d: Bytes| if closed.contains(d) { a } else { a.insert(d, true) },
        ));
      if next.len() == 0 { Stop({ closed: closed, next: [] }) }
      else { Continue({ closed: closed, next: next.keys() }) }
    },
  ).closed
}

/// The types a root's body is lowered at: a specialisation's, a root written for a type's own, and
/// those of each lender whose lambda it runs, of the definition it states a clause of and of the
/// root it enters.
fn types_keyed(k: RootKey) -> List<Type> =
  match k {
    At(_, _) ->
      key_lent(k).fold(key_types(k), |acc: List<Type>, f: FnArg| acc.concat(types_keyed(f.owner))),
    Written(w, _) -> [w.ty],
    Clause(c) -> types_keyed(c.def),
    Entered(e) -> types_keyed(e),
    _ -> [],
  }

/// The functions the program's types state: each `key`, `show` and `numeric` function.
fn stated_fns(dump: Dump) -> Map<Bytes, Bool> =
  dump.emitter_ctors.fold(Map::new(), |acc: Map<Bytes, Bool>, c: EmitterCtor|
    [c.key, c.show].fold(
      c.numeric.fold(acc, |m: Map<Bytes, Bool>, f: Bytes| m.insert(f, true)),
      |m: Map<Bytes, Bool>, f: Option<Bytes>| match f { Some(n) -> m.insert(n, true), None -> m },
    ))

fn text_at(program: Program, index: Int) -> Option<Bytes> = program.sources.at(index)

/// What a kept answer is a function of beyond the emitter and the runtime: the root's name, the key
/// the front end gave it, the text it is written in, since its sites are offsets into that text, and
/// what its module embeds, which that text's calls are written out as; for a specialisation, and a
/// clause judged at one, the kinds it is at, the declarations of the types it is at, and the
/// definitions whose lambdas it runs; for a root written from a type, its
/// module's text and the program's `types`, which together say how it is written. `None` for a root
/// with no key or no place, which is asked again every time.
fn root_material(program: Program, types: Bytes, k: RootKey) -> Option<Bytes> / {abort.raise} = {
  let name = root_text(root_name(k));
  match k {
    Written(_, _) -> match program.digests.get(module_of(k)) {
      None -> None,
      Some(d) -> Some(Bytes::concat_all([name, b"\x00", types, b"\x00", d])),
    },
    At(a, _) ->
      a.lent.fold(
        match definition_material(program, root_name(Named(a.def))) {
          Some(m) -> Some(Bytes::concat_all([m, b"\x00", name, declarations_named(program, k)])),
          None -> None,
        },
        |acc: Option<Bytes>, f: FnArg|
          match acc {
            None -> None,
            Some(m) -> match definition_material(program, sited_as(f.owner)) {
              Some(o) -> Some(Bytes::concat_all([m, b"\x00", o])),
              None -> None,
            },
          },
      ),
    // An entry is written from what its definition takes and answers.
    Entered(e) -> match definition_material(program, root_name(e)) {
      Some(m) -> Some(Bytes::concat_all([m, b"\x00", name])),
      None -> None,
    },
    // A definition a type states is printed with an entry the others lack.
    Named(n) -> match definition_material(program, root_name(k)) {
      Some(m) -> Some(if program.stated.contains(n) { m.concat(b"\x00stated") } else { m }),
      None -> None,
    },
    // A clause judged at a specialisation is its definition's clause at the types that names.
    Clause(c) -> match c.def {
      At(a, _) -> match definition_material(
          program,
          root_name(Clause({ ..c, def: Named(a.def) })),
        ) {
        Some(m) -> Some(Bytes::concat_all([m, b"\x00", name, declarations_named(program, c.def)])),
        None -> None,
      },
      _ -> definition_material(program, root_name(k)),
    },
    _ -> definition_material(program, root_name(k)),
  }
}

/// What a root written from a type reads of the program beyond its module: each constructor, the
/// type it makes of its arguments' types, and what each type states.
fn types_material(dump: Dump) -> Bytes / {abort.raise} =
  blake3(
    Bytes::concat_all(
      dump.ctors.map(|c: CtorRow|
        Bytes::concat_all([
          c.name,
          b"\x00",
          ascii_of_int(c.index),
          b"\x00",
          type_text(c.scheme.ty),
          b"\x01",
        ])).concat(
        dump.emitter_ctors.map(|c: EmitterCtor|
          Bytes::concat_all([
            c.name,
            b"\x00",
            match c.key { Some(k) -> k, None -> b"" },
            b"\x00",
            match c.show { Some(s) -> s, None -> b"" },
            b"\x00",
            Bytes::concat_all(c.numeric.map(|f: Bytes| f.concat(b","))),
            b"\x00",
            // A release's row is what its type's `LetGo` root is handed words for.
            match c.release {
              Some(f) ->
                f.concat(b"\x00").concat(match release_scheme(dump, f) {
                  Some(sc) -> type_text(sc.ty),
                  None -> b"",
                }),
              None -> b"",
            },
            b"\x01",
          ])),
      ),
    ),
  )

/// The scheme of the function named `by` a type's `release` names, as the rows publish it.
fn release_scheme(dump: Dump, by: Bytes) -> Option<Scheme> =
  match dump.rows.defs.find(|d: KnownDefRow| d.name == by) {
    Some(d) -> Some(d.scheme),
    None -> None,
  }

/// The hash of each declared type the types specialisation `k` is at name, in order of name: a key
/// names a type, and two programs may declare two types under one name.
fn declarations_named(program: Program, k: RootKey) -> Bytes = {
  let names = key_types(k).fold(Map::new(), |acc: Map<Bytes, Bool>, t: Type|
    type_names(t).fold(acc, |m: Map<Bytes, Bool>, n: Bytes| m.insert(n, true)));
  Bytes::concat_all(
    names.keys().map(|n: Bytes|
      match program.declared.get(n) {
        Some(h) -> Bytes::concat_all([b"\x00", n, b"=", h]),
        None -> b"",
      }),
  )
}

fn definition_material(program: Program, name: RootName) -> Option<Bytes> =
  match program.keys.get(name) {
    None -> None,
    Some(key) -> match program.roots.get(name) {
      None -> None,
      Some(r) -> match text_at(program, r.at.module) {
        None -> None,
        Some(text) -> if r.at.start < 0 || r.at.end > text.len() || r.at.start > r.at.end { None }
        else {
          Some(
            Bytes::concat_all([
              root_text(name),
              b"\x00",
              key,
              b"\x00",
              blake3(text.slice(r.at.start, r.at.end)),
              match program.embeds.get(r.at.module) { Some(d) -> d, None -> b"" },
            ]),
          )
        },
      },
    },
  }

/// The store below `bodies` that keeps the answers `emitter` gives on `runtime`: one per such pair
/// and format, so a store goes whole once no run uses it.
pub fn answers_store(bodies: String, runtime: Runtime, emitter: Bytes) -> String / {abort.raise} = {
  let id = blake3(
    Bytes::concat_all(
      [b"ply.unit.answer.5", hex(bin::shape_digest(kept_bin())), runtime.identity, emitter].map(
        |b: Bytes| sized(b),
      ),
    ),
  );
  bodies ++ "/answers-" ++ id.slice(0, 16).hex_of()
}

/// What the kept answer of a root whose material is `m` is filed under.
fn answer_key(m: Bytes) -> Bytes = b"answer\x00".concat(m)

/// What the key whose digest is `d` is filed under: each kept once, and named by every kept answer
/// whose body calls it.
fn key_key(d: Bytes) -> Bytes = b"key\x00".concat(d)

/// The digest a kept answer names the root `k` by.
fn key_digest(k: RootKey) -> Bytes / {abort.raise} = blake3(key_bytes(k))

/// A group's kept body stands only when every member is offered and each member's kept answer is
/// that same group; otherwise the group is asked again, and the emitter groups what is wanted now.
fn standing(looked: Map<RootName, Answer>, offered: Map<RootName, Bool>) -> Map<RootName, Answer> =
  looked.fold(Map::new(), |acc: Map<RootName, Answer>, n: RootName, a: Answer|
    if a.tables.members.fold(true, |ok: Bool, m: RootKey|
        ok && offered.contains(root_name(m))
          && (match looked.get(root_name(m)) {
            Some(other) -> other.tables.members == a.tables.members,
            None -> false,
          })) { acc.insert(n, a) }
    else { acc })

/// A kept body: its answer, which names none of the roots its body calls; the digest of each of
/// those, in the order its body names them, each root kept once beside it (`key_key`); and the key
/// each root it calls had, in the order `callees_of` names them. A key reads its callees by hash and
/// the C calls them by name, so two callees that hash alike under two names share a key and not a
/// body.
type Kept = { answer: Answer, calls: List<Bytes>, callees: List<Option<Bytes>> }

derive bin for Kept

/// The roots `a` calls, by name, ascending, each once.
fn callees_of(a: Answer) -> List<RootName> = names_ordered(a.tables.calls.map(root_name))

fn kept_of(keys: Map<RootName, Bytes>, a: Answer) -> Kept / {abort.raise} =
  {
    answer: { ..a, tables: { ..a.tables, calls: [] } },
    calls: a.tables.calls.map(key_digest),
    callees: callees_of(a).map(|c: RootName| keys.get(c)),
  }

/// Whether each root `a`'s body calls still has the key `callees` says it had.
fn holds(keys: Map<RootName, Bytes>, a: Answer, callees: List<Option<Bytes>>) -> Bool = {
  let names = callees_of(a);
  names.len() == callees.len()
    && range(0, names.len()).all(|i: Int|
      match names.at(i) { Some(n) -> callees.at(i) == Some(keys.get(n)), None -> false })
}

/// The answer `k` keeps, its calls named again by the keys `resolved` holds of their digests, where
/// it still stands: none where a root it calls is kept no more or a callee's key moved.
fn standing_kept(
  keys: Map<RootName, Bytes>,
  resolved: Map<Bytes, RootKey>,
  k: Kept,
) -> Option<Answer> =
  if !k.calls.all(|d: Bytes| resolved.contains(d)) { None } else {
    let a = {
      ..k.answer,
      tables: {
        ..k.answer.tables,
        calls: k.calls.fold([], |acc: List<RootKey>, d: Bytes|
          match resolved.get(d) { Some(r) -> acc.push(r), None -> acc }),
      },
    };
    if holds(keys, a, k.callees) { Some(a) } else { None }
  }

/// The kept answers of some roots, each by its root's name, and the digests of the keys the store
/// holds of the roots they call.
type KeptAnswers = { answers: Map<RootName, Answer>, known: Map<Bytes, Bool> }

/// The answers `materials` names a kept one of, each root by its material: each read back with the
/// roots it calls, a key read once however many answers call it.
fn kept_answers<| e>(
  keys: Map<RootName, Bytes>,
  materials: Map<RootName, Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
) -> KeptAnswers / {abort.raise | e} = {
  let found = materials.fold(Map::new(), |acc: Map<RootName, Kept>, n: RootName, m: Bytes|
    match read(answer_key(m)) {
      Some(b) -> match bin::decode(b, kept_bin()) { Ok(k) -> acc.insert(n, k), Err(_) -> acc },
      None -> acc,
    });
  let digests = found.fold(Map::new(), |acc: Map<Bytes, Bool>, _: RootName, k: Kept|
    k.calls.fold(acc, |a: Map<Bytes, Bool>, d: Bytes| a.insert(d, true)));
  let resolved = digests.fold(Map::new(), |acc: Map<Bytes, RootKey>, d: Bytes, _: Bool|
    match read(key_key(d)) {
      Some(b) -> match bin::decode(b, root_key_bin()) { Ok(r) -> acc.insert(d, r), Err(_) -> acc },
      None -> acc,
    });
  {
    answers: found.fold(Map::new(), |acc: Map<RootName, Answer>, n: RootName, k: Kept|
      match standing_kept(keys, resolved, k) { Some(a) -> acc.insert(n, a), None -> acc }),
    known: resolved.fold(Map::new(), |acc: Map<Bytes, Bool>, d: Bytes, _: RootKey|
      acc.insert(d, true)),
  }
}

/// The answers of `kept` of the roots `materials` names, and none of its digests, which a walk
/// knows from its start.
fn kept_among(kept: KeptAnswers, materials: Map<RootName, Bytes>) -> KeptAnswers =
  {
    answers: materials.fold(Map::new(), |acc: Map<RootName, Answer>, n: RootName, _: Bytes|
      match kept.answers.get(n) { Some(a) -> acc.insert(n, a), None -> acc }),
    known: Map::new(),
  }

/// What keeps the bodies among `answers` each root of `materials` names: the body under its
/// material, and each root it calls under its key's digest where neither `known` nor the store
/// holds it yet; and `known` with those digests.
fn answers_kept<| e>(
  keys: Map<RootName, Bytes>,
  materials: Map<RootName, Bytes>,
  answers: Map<RootName, Answer>,
  known: Map<Bytes, Bool>,
  read: (Bytes) -> Option<Bytes> / e,
) -> { records: List<Record>, known: Map<Bytes, Bool> } / {abort.raise | e} =
  answers.fold(
    { records: [], known: known },
    |acc: { records: List<Record>, known: Map<Bytes, Bool> }, n: RootName, a: Answer|
      match materials.get(n) {
        Some(m) -> {
          let called = a.tables.calls.fold(
            acc,
            |x: { records: List<Record>, known: Map<Bytes, Bool> }, k: RootKey| {
              let d = key_digest(k);
              if x.known.contains(d) { x }
              else if read(key_key(d)) != None { { ..x, known: x.known.insert(d, true) } } else {
                {
                  records: x.records.push({ key: key_key(d), bytes: key_bytes(k) }),
                  known: x.known.insert(d, true),
                }
              }
            },
          );
          {
            ..called,
            records: called.records.push({
              key: answer_key(m),
              bytes: bin::encode(kept_of(keys, a), kept_bin()),
            }),
          }
        },
        None -> acc,
      },
  )

/// The program's constructors as the emitter reads them, the unit's table `ctors` laid out as the
/// dump says, with each sum's cases and the constructors whose module states a `key` or arithmetic.
fn program_ctors(dump: Dump, ctors: List<Ctor>) -> Ctors = {
  let table = ctors_of(
    ctors.map(|c: Ctor| c.name),
    dump.emitter_ctors.filter(|c: EmitterCtor| c.key != None).map(|c: EmitterCtor| c.name),
    dump.emitter_ctors.filter(|c: EmitterCtor| c.numeric.len() > 0).map(|c: EmitterCtor| c.name),
    ctor_sums(dump.ctors),
  );
  let released = dump.emitter_ctors.fold(Map::new(), |m: Map<Bytes, Bytes>, c: EmitterCtor|
    match c.release {
      Some(f) -> match table.sum_of.get(c.name) { Some(t) -> m.insert(t, f), None -> m },
      None -> m,
    });
  with_sums_laid({
    ..with_released(table, released, |by: Bytes| release_scheme(dump, by)),
    // Program-wide: a specialisation is emitted where its definition is, which may not import
    // the module stating a `key` for the type it is at.
    stated: stated_fns(dump),
  })
}

/// The emitter's scope over each of `modules`, each whole, reading what the check filed of the
/// bodies `roots` reads (`emit.scope_of`). A root's answer is the same in any scope over the modules
/// it is asked over (`modules_asked`).
fn scope_over(
  dump: Dump,
  p: Program,
  ctors: List<Ctor>,
  roots: List<RootKey>,
  modules: Map<Bytes, Bool>,
) -> emit::Scope / {abort.raise} = {
  let read = p.modules.filter(|m: ModuleRow| modules.contains(m.name));
  let names = read.map(|m: ModuleRow| m.name);
  emit::scope_of(
    emit::zip_sources(
      names,
      read.map(|m: ModuleRow| match text_at(p, m.index) { Some(t) -> t, None -> b"" }),
    ),
    program_ctors(dump, ctors),
    true,
    roots,
    if dump.packages.len() == 0 { [{ prefix: b"", deps: [] }] } else { dump.packages },
    if dump.packages.len() == 0 { names.map(|_: Bytes| 0) } else {
      read.map(|m: ModuleRow| match dump.module_packages.at(m.index) { Some(k) -> k, None -> 0 })
    },
    dump.embeds,
    dump.rows,
    dump.effects,
    dump.walked,
    derived: dump.derived,
  )
}

/// What a unit's emitter holds between asks: the scope it built, over the modules `covered` names,
/// and the roots the walk said it would ask for when it began (`walked`).
type Scoped = { scope: Option<emit::Scope>, covered: Map<Bytes, Bool>, ahead: List<RootKey> }

/// An emitter that has built no scope yet, told the walk will ask it for `ahead`.
fn unscoped(ahead: List<RootKey>) -> Scoped = { scope: None, covered: Map::new(), ahead: ahead }

/// What the emitter answers for `roots`, each written against `handed`, in the scope `held` holds
/// where it holds every module `roots` need (`modules_asked`). Otherwise a scope is built: the first
/// over what every root the walk said it would ask for needs, and a later one over the last one's
/// modules and what each root of `offered` that `done` holds no answer of needs. Resolution reads a
/// scope's modules all at once, so a scope grows by being built again, over what the walk has left.
fn scoped_asked(
  dump: Dump,
  p: Program,
  ctors: List<Ctor>,
  offered: List<RootKey>,
  held: Scoped,
  roots: List<RootKey>,
  handed: Map<RootName, Handing>,
  done: Done,
) -> Asked<Scoped> / {abort.raise} = {
  let needed = modules_asked(p, roots);
  let covers = needed.fold(true, |all: Bool, m: Bytes, _: Bool| all && held.covered.contains(m));
  let scoped = match held.scope {
    Some(s) -> if covers { { scope: s, covered: held.covered } } else {
      let unanswered = offered.filter(|k: RootKey|
        !done.before.contains(root_name(k)) && !done.now.contains(root_name(k)));
      let covered = modules_asked(p, roots.concat(unanswered)).fold(
        held.covered,
        |acc: Map<Bytes, Bool>, m: Bytes, _: Bool| acc.insert(m, true),
      );
      { scope: scope_over(dump, p, ctors, offered, covered), covered: covered }
    },
    None -> {
      let covered = modules_asked(p, roots.concat(held.ahead));
      { scope: scope_over(dump, p, ctors, offered, covered), covered: covered }
    },
  };
  let pieces = dealt(p, roots);
  let a = answers_at_once(scoped.scope, pieces, 0, pieces.len(), 64, handed, done);
  {
    held: { scope: Some(scoped.scope), covered: scoped.covered, ahead: held.ahead },
    answers: unpacked(a),
    found: a.found,
  }
}

/// The lists an ask of the emitter is dealt over, answered at once: several to a core, so the cores
/// a list that lowers for longer than it weighs leaves idle take the others.
fn pieces() -> Int = 64

type Piece = { weight: Int, roots: List<RootKey> }

/// What a root written for a type weighs beside a definition, which weighs the length of its text:
/// about a short definition's.
fn written_weight() -> Int = 256

/// `missed` as at most `pieces()` lists that lower about as much each, the heaviest first onto the
/// lightest list, each root weighing the text it is written in and dealt with those `dealt_with`
/// puts it with.
fn dealt(p: Program, missed: List<RootKey>) -> List<List<RootKey>> / {abort.raise} = {
  let weight = |k: RootKey|
    match p.roots.get(sited_as(k)) { Some(r) -> r.at.end - r.at.start, None -> written_weight() };
  let together = missed.fold(Map::new(), |acc: Map<Bytes, Piece>, k: RootKey| {
    let d = dealt_with(k);
    let had = match acc.get(d) { Some(x) -> x, None -> { weight: 0, roots: [] } };
    acc.insert(d, { weight: had.weight + weight(k), roots: had.roots.push(k) })
  });
  let heaviest_first = together.values().sort_by(|a: Piece, b: Piece| a.weight >= b.weight);
  let dealt = heaviest_first.fold([], |acc: List<Piece>, m: Piece|
    if acc.len() < pieces() { acc.push(m) } else {
      let lightest = range(0, acc.len()).fold(0, |best: Int, i: Int|
        if acc.get(i).weight < acc.get(best).weight { i } else { best });
      range(0, acc.len()).map(|i: Int| {
        let piece = acc.get(i);
        if i == lightest { { weight: piece.weight + m.weight, roots: piece.roots.concat(m.roots) } }
        else { piece }
      })
    });
  dealt.map(|piece: Piece| piece.roots)
}

/// What the emitter answers in `scope` for every list of `pieces` from `lo` up to `hi`, each list
/// asked apart and the lists at once, each written against `handed`: a root's answer is the same
/// whichever list asks for it. `room` is the halvings left, and 64 take any length to one.
fn answers_at_once(
  scope: emit::Scope,
  pieces: List<List<RootKey>>,
  lo: Int,
  hi: Int,
  room: Int,
  handed: Map<RootName, Handing>,
  done: Done,
) -> Packed / {abort.raise} =
  if hi - lo <= 1 {
    match pieces.at(lo) {
      Some(roots) -> {
        let a = answers_closed(scope, roots, handed, done);
        { packed: [bin::encode(a.answers, bin::list_bin(root_answer_bin()))], found: a.found }
      },
      None -> { packed: [], found: [] },
    }
  } else if room <= 0 { panic("more halvings than a length has") } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      answers_at_once(scope, pieces, lo, mid, room - 1, handed, done),
      answers_at_once(scope, pieces, mid, hi, room - 1, handed, done),
    };
    {
      packed: halves._0.packed.concat(halves._1.packed),
      found: halves._0.found.concat(halves._1.found),
    }
  }

/// What a list was answered with: the answers, and the roots written for types they call that the
/// list did not name, answered with them (`answers_closed`).
type Answered = { answers: List<RootAnswer>, found: List<RootKey> }

/// What lists were answered with, each list's answers written as one block: the thread asking reads
/// them back into its own heap, so a worker's pages hold nothing that outlives the list it answered.
type Packed = { packed: List<Bytes>, found: List<RootKey> }

/// The answers `p` holds, read back.
fn unpacked(p: Packed) -> List<RootAnswer> / {abort.raise} =
  p.packed.fold([], |acc: List<RootAnswer>, b: Bytes|
    match bin::decode(b, bin::list_bin(root_answer_bin())) {
      Ok(xs) -> acc.concat(xs),
      Err(_) -> panic("a list's answers, as the emitter wrote them, did not read back"),
    })

/// The roots a walk holds an answer of: those of earlier steps, and those of this one so far.
type Done = { before: Map<RootName, Answer>, now: Map<RootName, Answer> }

/// The emitter's answers in `scope` for `roots`, and for each root written for a type an answer calls that no answer
/// `done` or this holds, until none is new: such a root's handing is fixed, so it is answered here
/// rather than at a step of its own.
fn answers_closed(
  scope: emit::Scope,
  roots: List<RootKey>,
  handed: Map<RootName, Handing>,
  done: Done,
) -> Answered / {abort.raise} = {
  let held = |n: RootName| done.before.contains(n) || done.now.contains(n);
  iterate(
    {
      out: { answers: [], found: [] },
      asking: roots,
      seen: roots.fold(Map::new(), |m: Map<RootName, Bool>, k: RootKey|
        m.insert(root_name(k), true)),
      first: true,
    },
    64,
    |st: { out: Answered, asking: List<RootKey>, seen: Map<RootName, Bool>, first: Bool }|
      if st.asking.len() == 0 { Stop(st) } else {
        let got = emit::answered(scope, st.asking, handed);
        let next = got.fold(
          { keys: [], seen: st.seen },
          |acc: { keys: List<RootKey>, seen: Map<RootName, Bool> }, a: RootAnswer|
            a.answer.tables.calls.fold(
              acc,
              |m: { keys: List<RootKey>, seen: Map<RootName, Bool> }, c: RootKey|
                match c {
                  Written(_, _) -> {
                    let n = root_name(c);
                    if m.seen.contains(n) || held(n) { m }
                    else { { keys: m.keys.push(c), seen: m.seen.insert(n, true) } }
                  },
                  _ -> m,
                },
            ),
        );
        Continue({
          out: {
            answers: st.out.answers.concat(got),
            found: if st.first { st.out.found } else { st.out.found.concat(st.asking) },
          },
          asking: next.keys,
          seen: next.seen,
          first: false,
        })
      },
  ).out
}

/// `handed` with the handing each body of `answers` publishes, as the lending reads it.
fn handed_with(
  handed: Map<RootName, Handing>,
  answers: Map<RootName, Answer>,
) -> Map<RootName, Handing> =
  answers.fold(handed, |acc: Map<RootName, Handing>, _: RootName, a: Answer|
    handed_from(a.tables.handings).fold(
      acc,
      |m: Map<RootName, Handing>, n: RootName, h: Handing| m.insert(n, h),
    ))

/// Each definition's handing as the bodies of `answers` publish it, over `before`: what every
/// caller's code is written against.
fn handings_held(
  before: Map<RootName, Published>,
  answers: Map<RootName, Answer>,
) -> Map<RootName, Published> =
  answers.fold(before, |acc: Map<RootName, Published>, _: RootName, a: Answer|
    a.tables.handings.fold(acc, |m: Map<RootName, Published>, h: Published| m.insert(h.def, h)))

/// Whether `a` was written against a callee's handing other than the one `held` holds; a callee
/// `held` holds nothing of yet is answered in a later round, which judges it then.
fn written_stale(a: Answer, held: Map<RootName, Published>) -> Bool =
  a.tables.assumed.any(|x: Published| match held.get(x.def) { Some(h) -> h != x, None -> false })

/// Each call of a body among `taken` written against a handing other than the one its callee
/// publishes in `answers`: what the rounds settled wrongly, which no unit ships.
fn misassumed_in(answers: Map<RootName, Answer>, taken: List<RootName>) -> List<Misassumed> = {
  let held = handings_held(Map::new(), answers);
  taken.fold([], |acc: List<Misassumed>, n: RootName|
    match answers.get(n) {
      Some(b) ->
        b.tables.assumed.fold(acc, |a: List<Misassumed>, x: Published|
          if agrees(x, held.get(x.def)) { a }
          else { a.push({ caller: n, assumed: x, published: held.get(x.def) }) }),
      _ -> acc,
    })
}

/// The roots among `answers`, each by its key in `keys`, the emitter is asked for again: each
/// written against a handing `held` no longer holds, and with it each definition of its recursion
/// group, which settle together.
fn stale_of(
  answers: Map<RootName, Answer>,
  held: Map<RootName, Published>,
  keys: Map<RootName, RootKey>,
) -> List<RootKey> =
  answers.fold([], |acc: List<RootKey>, n: RootName, a: Answer|
    if !written_stale(a, held) { acc } else {
      let own = match keys.get(n) { Some(k) -> [k], None -> [] };
      let group = a.tables.group;
      own.concat(group).fold(acc, |xs: List<RootKey>, g: RootKey|
        if xs.contains(g) { xs } else { xs.push(g) })
    })

/// `kept` without each answer whose recursion group holds a definition `kept` lacks, which is asked
/// for again with the rest of its group.
fn groups_whole(
  kept: Map<RootName, Answer>,
  asked: List<RootName>,
) -> Map<RootName, Answer> / {abort.raise} =
  iterate(kept, kept.len() + 1, |k: Map<RootName, Answer>| {
    let split = k.fold([], |acc: List<RootName>, n: RootName, a: Answer|
      if a.tables.group.any(|g: RootKey| {
          let member = root_name(g);
          asked.contains(member) && !k.contains(member)
        }) { acc.push(n) }
      else { acc });
    if split.len() == 0 { Stop(k) }
    else { Continue(split.fold(k, |m: Map<RootName, Answer>, n: RootName| m.remove(n))) }
  })

/// Where each module the unit reads settles its definitions' handings: past every module it depends
/// on (`modules_read`), so each callee of a body outside the body's own module is answered at an
/// earlier place. Imports form no cycle, so the places are found within a step a module.
fn places_of(p: Program) -> Map<Bytes, Int> / {abort.raise} =
  iterate(Map::new(), p.read.len() + 2, |at: Map<Bytes, Int>| {
    let next = p.read.fold(Map::new(), |acc: Map<Bytes, Int>, m: Bytes, deps: List<Bytes>|
      acc.insert(
        m,
        deps.fold(0, |n: Int, d: Bytes| {
          let past = match at.get(d) { Some(l) -> l + 1, None -> 0 };
          if past > n { past } else { n }
        }),
      ));
    if next == at { Stop(next) } else { Continue(next) }
  })

/// The module a root is lowered with: a specialisation that runs a lambda goes with its lender's
/// module, which its call lowers too.
fn dealt_module(k: RootKey) -> Bytes / {abort.raise} =
  match key_lent(k).at(0) { Some(f) -> module_of(f.owner), None -> module_of(k) }

/// What a root is dealt with: its module's other roots (`dealt_module`), since a module's definitions
/// settle their handings in one call; but a specialisation running no lambda in place with the other
/// specialisations of its definition, whose handing it takes, and a root written for a type, whose
/// handing is fixed, alone.
fn dealt_with(k: RootKey) -> Bytes / {abort.raise} =
  match k {
    At(a, _) -> if a.lent.len() > 0 { dealt_module(k) } else { a.def },
    Written(_, _) -> root_text(root_name(k)),
    _ -> dealt_module(k),
  }

/// What asking the emitter for some roots came to: their answers, among them those of the roots
/// written for types it `found` they call, and what the emitter holds for the next ask.
type Asked<s> = { held: s, answers: List<RootAnswer>, found: List<RootKey> }

/// How far a unit's walk of its program has come: each root's answer and key; the handing each
/// answered definition publishes, as answers publish it and as the lending reads it; how many answers
/// it took kept and how many roots it asked the emitter for; the roots
/// it found beyond those offered; the digests of the keys the store is known to hold; the needs and
/// the parameters called as functions of the generic bodies whose calls it settled, closed over the
/// calls they make; the roots answered whose calls it has not read, and those whose generic calls it
/// has not settled; what the emitter holds; and the roots its caller offered or holds otherwise.
type Walk<s> = {
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
  held: Map<RootName, Published>,
  handed: Map<RootName, Handing>,
  kept: Int,
  asked: Int,
  added: List<RootKey>,
  known: Map<Bytes, Bool>,
  needs: Map<RootName, List<Need>>,
  called: Map<RootName, List<Int>>,
  unread: List<RootName>,
  unsettled: List<RootName>,
  emitter: s,
  /// The records of what the place's walk answered, kept as it ends.
  unkept: List<Record>,
  /// By definition, each answer written against its handing.
  assumers: Map<RootName, List<RootName>>,
  offered: Map<RootName, Bool>,
}

/// What one place of a unit's walk came to: the place, the roots it answered, how many of those an
/// earlier run kept, how many it asked the emitter for, the steps it took, each answering what the one
/// before found, and the clock as it began and ended.
pub type PlaceTally = {
  place: Int,
  roots: Int,
  kept: Int,
  asked: Int,
  steps: Int,
  began: Int,
  ended: Int,
}

/// The answer to each root of `offered`, and to each root those answers reach, place by place
/// (`places_of`), the emitter asked through `ask`. At each place its offered roots are answered as
/// `answered_now` answers them, and then each root their answers name that no answer holds: a root
/// written for a type, the generic body of a definition called generically, and, once every such
/// body is in, the root each generic call settles on, until none is new. Each callee of a
/// definition is answered at an earlier place or with it, so every body is written once, against
/// its callees' final handings; a root a place finds takes its definition's handing or a fixed one.
/// Every offered root's kept answer is read before the first place, and `start` makes what the
/// emitter holds from the offered roots none stands for, which the walk will ask it for. `types` is
/// what a root written for a type reads of the program's types (`types_material`). Each place is
/// told to `phases` as it ends.
fn walked<s | e>(
  p: Program,
  types: Bytes,
  program: Ctors,
  offered: List<RootKey>,
  read: (Bytes) -> Option<Bytes> / e,
  keep: (List<Record>) -> Unit / e,
  phases: Option<{ now: () -> Int / e, told: (PlaceTally) -> Unit / e }>,
  start: (List<RootKey>) -> s,
  ask: (s, List<RootKey>, Map<RootName, Handing>, Done) -> Asked<s> / {abort.raise | e},
) -> Walk<s> / {abort.raise | e} = {
  let places = places_of(p);
  let place = |k: RootKey| match places.get(dealt_module(k)) { Some(l) -> l, None -> 0 };
  let at = offered.fold(Map::new(), |acc: Map<Int, List<RootKey>>, k: RootKey| {
    let l = place(k);
    acc.insert(l, List::push(match acc.get(l) { Some(ks) -> ks, None -> [] }, k))
  });
  let last = offered.fold(0, |m: Int, k: RootKey| if place(k) > m { place(k) } else { m });
  let kept = kept_answers(p.keys, materials_of(p, types, keys_named(offered)), read);
  let emitter = start(offered.filter(|k: RootKey| !kept.answers.contains(root_name(k))));
  range(0, last + 1).fold(
    {
      answers: Map::new(),
      keys: Map::new(),
      held: Map::new(),
      handed: Map::new(),
      kept: 0,
      asked: 0,
      added: [],
      known: kept.known,
      needs: Map::new(),
      called: Map::new(),
      unread: [],
      unsettled: [],
      emitter: emitter,
      unkept: [],
      assumers: Map::new(),
      offered: offered.map(root_name).fold(Map::new(), |m: Map<RootName, Bool>, n: RootName|
        m.insert(n, true)),
    },
    |w: Walk<s>, l: Int|
      match at.get(l) {
        None -> w,
        Some(roots) ->
          told_place(phases, l, w, ||
            place_walked(p, types, program, w, roots, kept, read, keep, ask)),
      },
  )
}

/// `ks` by their names.
fn keys_named(ks: List<RootKey>) -> Map<RootName, RootKey> =
  ks.fold(Map::new(), |acc: Map<RootName, RootKey>, k: RootKey| acc.insert(root_name(k), k))

/// The material of each root `keys` names that has one (`root_material`).
fn materials_of(
  p: Program,
  types: Bytes,
  keys: Map<RootName, RootKey>,
) -> Map<RootName, Bytes> / {abort.raise} =
  keys.fold(Map::new(), |acc: Map<RootName, Bytes>, n: RootName, k: RootKey|
    match root_material(p, types, k) { Some(m) -> acc.insert(n, m), None -> acc })

/// `run`, the walk of place `l` on from `w`, told to `phases` as it ends.
fn told_place<s | e>(
  phases: Option<{ now: () -> Int / e, told: (PlaceTally) -> Unit / e }>,
  l: Int,
  w: Walk<s>,
  run: () -> { walk: Walk<s>, steps: Int } / {abort.raise | e},
) -> Walk<s> / {abort.raise | e} =
  match phases {
    None -> run().walk,
    Some(t) -> {
      let began = t.now();
      let r = run();
      t.told({
        place: l,
        roots: r.walk.keys.len() - w.keys.len(),
        kept: r.walk.kept - w.kept,
        asked: r.walk.asked - w.asked,
        steps: r.steps,
        began: began,
        ended: t.now(),
      });
      r.walk
    },
  }

/// `w` with each of `roots` answered, their kept answers as `kept` read them, and each root those
/// answers reach (`found`, `settling`), step after step until a step finds none or 64 steps have
/// passed; and how many steps it took.
fn place_walked<s | e>(
  p: Program,
  types: Bytes,
  program: Ctors,
  w: Walk<s>,
  roots: List<RootKey>,
  kept: KeptAnswers,
  read: (Bytes) -> Option<Bytes> / e,
  keep: (List<Record>) -> Unit / e,
  ask: (s, List<RootKey>, Map<RootName, Handing>, Done) -> Asked<s> / {abort.raise | e},
) -> { walk: Walk<s>, steps: Int } / {abort.raise | e} = {
  let walked = iterate(
    {
      walk: answered_now(
        p,
        types,
        w,
        roots,
        |ms: Map<RootName, Bytes>| kept_among(kept, ms),
        read,
        ask,
      ),
      steps: 1,
    },
    66,
    |b: { walk: Walk<s>, steps: Int }| {
      let named = called_unheld(b.walk);
      let read_all = { ..b.walk, unread: [] };
      // Only once every generic body is in are the needs closed, so no call settles on a part of them.
      let next = if named.len() > 0 { { walk: read_all, more: named } }
      else { settling(read_all, program) };
      // A body an earlier step answered, written against a callee this step answered with another
      // handing, is asked for again.
      let moved = stale_here(
        next.walk,
        b.walk.unread.fold([], |acc: List<RootName>, n: RootName|
          match b.walk.answers.get(n) {
            Some(x) -> acc.concat(x.tables.handings.map(|h: Published| h.def)),
            _ -> acc,
          }),
      );
      if (next.more.len() == 0 && moved.len() == 0) || b.steps > 64 {
        Stop({ ..b, walk: next.walk })
      } else {
        let more = next.more.values().concat(moved);
        let unsettled = {
          ..next.walk,
          answers: moved.fold(next.walk.answers, |m: Map<RootName, Answer>, k: RootKey|
            m.remove(root_name(k))),
        };
        let after = answered_now(
          p,
          types,
          unsettled,
          more,
          |ms: Map<RootName, Bytes>| kept_answers(p.keys, ms, read),
          read,
          ask,
        );
        Continue({ walk: { ..after, added: after.added.concat(more) }, steps: b.steps + 1 })
      }
    },
  );
  // One batch a place, so a run that dies keeps every place it finished.
  if walked.walk.unkept.len() > 0 { keep(walked.walk.unkept) };
  { ..walked, walk: { ..walked.walk, unkept: [] } }
}

/// Each root whose answer `w` holds written against a handing of one of `changed` other than the
/// one `w` holds, with the rest of its recursion group: a handing moves only where a step answers
/// its definition, so only what assumed one of those can have gone stale.
fn stale_here<s>(w: Walk<s>, changed: List<RootName>) -> List<RootKey> =
  stale_of(
    changed.fold(Map::new(), |m: Map<RootName, Answer>, d: RootName|
      match w.assumers.get(d) {
        Some(ns) ->
          ns.fold(m, |acc: Map<RootName, Answer>, n: RootName|
            match w.answers.get(n) { Some(a) -> acc.insert(n, a), None -> acc }),
        None -> m,
      }),
    w.held,
    w.keys,
  )

/// `assumers` with each body of `answers` listed under every definition it was written against.
fn assumers_with(
  assumers: Map<RootName, List<RootName>>,
  answers: Map<RootName, Answer>,
) -> Map<RootName, List<RootName>> =
  answers.fold(assumers, |m: Map<RootName, List<RootName>>, n: RootName, a: Answer|
    a.tables.assumed.fold(m, |acc: Map<RootName, List<RootName>>, x: Published|
      acc.insert(x.def, match acc.get(x.def) { Some(ns) -> ns.push(n), None -> [n] })))

/// Where `answered_now` is in asking the emitter: the answers the emitter gave, the kept answers
/// still standing, how many roots it asked for, the roots not yet asked for, what the emitter holds,
/// and the roots written for types it answered with them.
type Asking<s> = {
  fresh: Map<RootName, Answer>,
  kept: Map<RootName, Answer>,
  asked: Int,
  pending: List<RootKey>,
  emitter: s,
  found: Map<RootName, RootKey>,
}

/// `w` with each of `roots` it holds no answer of answered: each kept answer `look` reads of their
/// materials where it stands, the emitter asked through `ask` for the rest, each written against the
/// handings `w` holds and those these answers publish. A kept answer written against a handing that
/// has moved since is asked for again, as is every other one of a recursion group it leaves. The
/// records of what the emitter answers wait in `unkept` for their place's end, `read` telling the
/// keys the store holds already. The emitter answers every root it is asked for.
fn answered_now<s | e>(
  p: Program,
  types: Bytes,
  w: Walk<s>,
  roots: List<RootKey>,
  look: (Map<RootName, Bytes>) -> KeptAnswers / {abort.raise | e},
  read: (Bytes) -> Option<Bytes> / e,
  ask: (s, List<RootKey>, Map<RootName, Handing>, Done) -> Asked<s> / {abort.raise | e},
) -> Walk<s> / {abort.raise | e} = {
  let keys = roots.fold(Map::new(), |acc: Map<RootName, RootKey>, k: RootKey|
    if w.answers.contains(root_name(k)) { acc } else { acc.insert(root_name(k), k) });
  let names = keys.keys();
  let asked = names.fold(Map::new(), |acc: Map<RootName, Bool>, n: RootName| acc.insert(n, true));
  let materials = materials_of(p, types, keys);
  let looked = look(materials);
  let standing_now = standing(looked.answers, asked);
  let stale = stale_of(standing_now, handings_held(w.held, standing_now), keys);
  let kept = groups_whole(
    stale.fold(standing_now, |m: Map<RootName, Answer>, k: RootKey| m.remove(root_name(k))),
    names,
  );
  let missed = keys.values().filter(|k: RootKey| !kept.contains(root_name(k)));
  let settled = iterate(
    {
      fresh: Map::new(),
      kept: kept,
      asked: 0,
      pending: missed,
      emitter: w.emitter,
      found: Map::new(),
    },
    kept.len() + 2,
    |t: Asking<s>| {
      let now = t.fresh.fold(t.kept, |m: Map<RootName, Answer>, n: RootName, a: Answer|
        m.insert(n, a));
      // A body answered in an earlier round, kept or fresh, written against a callee answered
      // after it with another handing, is asked for again.
      let moved = stale_of(now, handings_held(w.held, now), keys);
      let asking = t.pending.concat(moved);
      if asking.len() == 0 { Stop(t) } else {
        let got = ask(t.emitter, asking, handed_with(w.handed, now), {
          before: w.answers,
          now: now,
        });
        let answers = answers_of(got.answers);
        // The roots written for types the answers call, answered with them, are kept as asked ones.
        let found = got.found.fold(t.found, |m: Map<RootName, RootKey>, k: RootKey|
          if keys.contains(root_name(k)) { m } else { m.insert(root_name(k), k) });
        let stood = moved.fold(t.fresh, |m: Map<RootName, Answer>, k: RootKey|
          m.remove(root_name(k)));
        Continue({
          fresh: answers.fold(stood, |m: Map<RootName, Answer>, n: RootName, a: Answer|
            m.insert(n, a)),
          kept: moved.fold(t.kept, |m: Map<RootName, Answer>, k: RootKey| m.remove(root_name(k))),
          asked: t.asked + asking.len() + found.len() - t.found.len(),
          pending: [],
          emitter: got.held,
          found: found,
        })
      }
    },
  );
  let reached = found_reached(
    settled.fresh.fold(settled.kept, |acc: Map<RootName, Answer>, n: RootName, a: Answer|
      acc.insert(n, a)),
    names,
    settled.found,
  );
  // A root found off a body asked for again since is no root this step reaches.
  let answered = missed.fold(
    settled.found.fold(settled.fresh, |acc: Map<RootName, Answer>, n: RootName, _: RootKey|
      if reached.contains(n) { acc } else { acc.remove(n) }),
    |acc: Map<RootName, Answer>, k: RootKey|
      if acc.contains(root_name(k)) { acc } else {
        panic(
          String::of_bytes_lossy(
            Bytes::concat_all([
              b"the emitter answered nothing for `",
              root_text(root_name(k)),
              b"`",
            ]),
          ),
        )
      },
  );
  let all = answered.fold(settled.kept, |acc: Map<RootName, Answer>, n: RootName, a: Answer|
    acc.insert(n, a));
  let now = all.keys();
  // Each answer the emitter gave is kept as it stands once the step settles, never one it replaced.
  let r = answers_kept(
    p.keys,
    reached.fold(materials, |m: Map<RootName, Bytes>, n: RootName, k: RootKey|
      match root_material(p, types, k) { Some(x) -> m.insert(n, x), None -> m }),
    answered,
    looked.known.fold(w.known, |m: Map<Bytes, Bool>, d: Bytes, _: Bool| m.insert(d, true)),
    read,
  );
  {
    ..w,
    answers: all.fold(w.answers, |acc: Map<RootName, Answer>, n: RootName, a: Answer|
      acc.insert(n, a)),
    keys: reached.fold(
      keys.fold(w.keys, |acc: Map<RootName, RootKey>, n: RootName, k: RootKey| acc.insert(n, k)),
      |acc: Map<RootName, RootKey>, n: RootName, k: RootKey| acc.insert(n, k),
    ),
    added: w.added.concat(reached.values()),
    held: handings_held(w.held, all),
    handed: handed_with(w.handed, all),
    assumers: assumers_with(w.assumers, all),
    kept: w.kept + all.len() - answered.len(),
    asked: w.asked + settled.asked,
    unkept: w.unkept.concat(r.records),
    known: r.known,
    unread: w.unread.concat(now),
    unsettled: w.unsettled.concat(now),
    emitter: settled.emitter,
  }
}

/// Of the roots `found` answered ahead, those a body of `roots` calls, or a body of one of them, in
/// `answers`.
fn found_reached(
  answers: Map<RootName, Answer>,
  roots: List<RootName>,
  found: Map<RootName, RootKey>,
) -> Map<RootName, RootKey> / {abort.raise} =
  iterate(
    { reached: Map::new(), from: roots },
    found.len() + 1,
    |s: { reached: Map<RootName, RootKey>, from: List<RootName> }| {
      let next = s.from.fold(Map::new(), |acc: Map<RootName, RootKey>, n: RootName|
        match answers.get(n) {
          Some(b) ->
            b.tables.calls.fold(acc, |m: Map<RootName, RootKey>, c: RootKey| {
              let callee = root_name(c);
              if found.contains(callee) && !s.reached.contains(callee) { m.insert(callee, c) }
              else { m }
            }),
          _ -> acc,
        });
      if next.len() == 0 { Stop(s) } else {
        Continue({
          reached: next.fold(s.reached, |m: Map<RootName, RootKey>, n: RootName, k: RootKey|
            m.insert(n, k)),
          from: next.keys(),
        })
      }
    },
  ).reached

/// The roots the answers `w` has not read call that no answer holds: each root written for a type a
/// body calls, each clause an entry judges at its definition's specialisation, and the generic body
/// of each definition a body calls generically, whose needs settle those calls; and each definition
/// a body calls that no offer names, as a root written for a type or a specialisation may. A body
/// calls a specialisation only as itself.
fn called_unheld<s>(w: Walk<s>) -> Map<RootName, RootKey> =
  w.unread.fold(Map::new(), |acc: Map<RootName, RootKey>, n: RootName|
    match w.answers.get(n) {
      Some(b) -> {
        let unheld = |m: Map<RootName, RootKey>, c: RootKey|
          if w.answers.contains(root_name(c)) { m } else { m.insert(root_name(c), c) };
        let written = b.tables.calls.fold(acc, |m: Map<RootName, RootKey>, c: RootKey|
          match c {
            Written(_, _) -> unheld(m, c),
            Clause(_) -> unheld(m, c),
            Named(_) -> if w.offered.contains(root_name(c)) { m } else { unheld(m, c) },
            _ -> m,
          });
        b.tables.generics.calls.fold(written, |m: Map<RootName, RootKey>, g: GenericCall|
          if w.answers.contains(root_name(g.callee)) { m }
          else { m.insert(root_name(g.callee), g.callee) })
      },
      _ -> acc,
    })

/// `w` with the generic calls of the answers it has not settled settled: the needs and the parameters
/// called as functions of the generic bodies among them closed over the calls they make, and the root
/// each call of a body the unit emits settles on, where no answer holds it. The first call in name
/// order settling on a layout gives the root its type.
fn settling<s>(
  w: Walk<s>,
  program: Ctors,
) -> { walk: Walk<s>, more: Map<RootName, RootKey> } / {abort.raise} = {
  let names = names_ordered(w.unsettled);
  let bodies = generic_bodies(w.answers, w.keys, names);
  let needs = needs_closed(bodies, w.needs);
  let called = called_closed(bodies, w.called);
  let more = names.fold(Map::new(), |acc: Map<RootName, RootKey>, n: RootName|
    match w.answers.get(n) {
      Some(b) -> if settled_by_its_callers(w.keys, n, b.tables, needs) { acc } else {
        b.tables.generics.calls.fold(acc, |m: Map<RootName, RootKey>, g: GenericCall| {
          let root = settled_root(g, needs, called, program);
          let name = root_name(root);
          if w.answers.contains(name) || m.contains(name) { m } else { m.insert(name, root) }
        })
      },
      _ -> acc,
    });
  { walk: { ..w, needs: needs, called: called, unsettled: [] }, more: more }
}

/// The milliseconds of wall clock a check gives a deriver, a tagged literal's parser or a statement
/// it computes before anything runs, past which it is stopped.
pub fn entered_timeout_ms() -> Int = 60000

/// The unit over `every` root offered: each one's answer taken from what an earlier run kept where it
/// stands, the emitter asked for the rest in a scope over the modules those need (`scoped_asked`),
/// what it answered kept for the next run, and the unit produced over all of it.
/// `inputs` holds the bytes of each file `dump` says the program embeds, by digest. `read` reads a
/// record of the store of answers `answers_store` names, and `keep` keeps a batch of them, each batch
/// as the emitter answers it. Each place the unit walks is told to `phases` as it ends. `entered`
/// are the roots the runtime enters, each through an entry the unit holds: every root offered where
/// none is given, as a machine may enter any of them. Returns what broke where making the unit
/// panics, which is a defect in Ply.
pub fn emitted<| e>(
  runtime: Runtime,
  dump: Dump,
  sources: List<Bytes>,
  inputs: Map<Bytes, Bytes>,
  every: List<RootKey>,
  read: (Bytes) -> Option<Bytes> / e,
  keep: (List<Record>) -> Unit / e,
  phases: Option<{ now: () -> Int / e, told: (PlaceTally) -> Unit / e }> = None,
  entered: Option<List<RootKey>> = None,
) -> Result<Emission, Bytes> / {abort.raise | e} =
  handle {
    let p = program_of(dump, sources, every);
    let ctors = dump.emitter_ctors.map(|c: EmitterCtor| { name: c.name, arity: c.arity });
    let entries = (match entered { Some(ks) -> ks, None -> every }).filter(|k: RootKey|
      entered_root(p, k)).map(
      Entered,
    );
    let offered = every.concat(entries);
    let program = program_ctors(dump, ctors);
    let all = walked(
      p,
      types_material(dump),
      program,
      offered,
      read,
      keep,
      phases,
      unscoped,
      |held: Scoped, roots: List<RootKey>, handed: Map<RootName, Handing>, done: Done|
        scoped_asked(dump, p, ctors, offered, held, roots, handed, done),
    );
    {
      let c = compiled(all.answers, all.keys);
      let settled = generics_settled(
        c.answers,
        c.keys,
        c.compiled_as,
        all.needs,
        all.called,
        program,
      );
      let unemitted = settled.unemitted;
      let held = settled_bodies(settled.answers, c.keys, unemitted);
      let roots = every.concat(all.added).filter(|k: RootKey|
        !unemitted.contains(root_name(k))).concat(
        entries,
      );
      // Each specialisation is offered as the code it compiles as, once however many share it, and
      // sits among the parts of the first one's home: a code keeps no lender to place it by.
      let compiled_roots = roots.fold(
        Map::new(),
        |m: Map<RootName, { key: RootKey, home: Bytes }>, k: RootKey| {
          let code = match c.compiled_as.get(root_name(k)) { Some(x) -> x, None -> k };
          if m.contains(root_name(code)) { m }
          else { m.insert(root_name(code), { key: code, home: home_of(k) }) }
        },
      );
      let natives = read_natives(
        p,
        held.fold(Map::new(), |acc: Map<Bytes, Bool>, _: RootName, a: Answer|
          a.tables.natives.fold(acc, |m: Map<Bytes, Bool>, n: Bytes| m.insert(n, true))),
      );
      let produced = produce(
        ctors,
        compiled_roots.values().map(|o: { key: RootKey, home: Bytes }| {
          let k = o.key;
          match k {
            // An entry takes no words: what it reads crosses through the runtime.
            Entered(_) ->
              { name: root_name(k), arity: 0, constant: false, site: sited_as(k), home: o.home },
            _ -> match p.roots.get(sited_as(k)) {
              Some(r) ->
                {
                  name: root_name(k),
                  arity: r.arity,
                  constant: r.pure && r.arity == 0
                    && (match k { At(_, _) -> false, Coded(_) -> false, _ -> true }),
                  site: sited_as(k),
                  home: o.home,
                },
              None ->
                { name: root_name(k), arity: 0, constant: false, site: sited_as(k), home: o.home },
            },
          }
        }),
        p.modules.len(),
        held,
        inputs,
        |called: Map<Bytes, Bool>| machine_bound(called_externs(called, natives)),
        part_rule(),
      );
      Ok({
        produced: produced,
        roots: roots,
        kept: all.kept,
        asked: all.asked,
        unserved: unserved(runtime),
        unbound: unbound(runtime.natives, called_externs(natives_called(produced.made), natives)),
        misassumed: misassumed_in(all.answers, names_ordered(roots.map(root_name))),
      })
    }
  } with {
    // Every program the front end checked makes a unit, so a panic making one is Ply's own.
    abort.raise(m) -> Err(Bytes::of_string(m)),
  }

/// The unit a build of `modules` produces, run by a runtime that implements every native the
/// compiler declares; or why it made none.
pub fn built(
  modules: List<{ name: Bytes, src: Bytes }>,
) -> Result<Emission, Bytes> / {abort.raise} = {
  let dump = dump_of(analyse(parse_all(modules)));
  emitted(
    serving(b"r", program_natives([]).map(declared_signature)),
    dump,
    sources_placed(dump, modules),
    Map::new(),
    offered_roots(dump).keys,
    |_: Bytes| None,
    |_: List<Record>| (),
  )
}

/// The roots a build of `modules` produces its unit over (`built`); or why it made no unit.
pub fn roots_built(
  modules: List<{ name: Bytes, src: Bytes }>,
) -> Result<List<RootKey>, Bytes> / {abort.raise} =
  match built(modules) { Ok(e) -> Ok(e.roots), Err(why) -> Err(why) }

/// The definition the root named `n` specialises, where `keys` holds it as a specialisation or as
/// the code specialisations compile as.
fn specialising(keys: Map<RootName, RootKey>, n: RootName) -> Option<Bytes> =
  match keys.get(n) { Some(At(a, _)) -> Some(a.def), Some(Coded(c)) -> Some(c.def), _ -> None }

// --- Generic calls ---------------------------------------------------------------

/// The tables of each body of `answers` among `names` that is no specialisation, by name: a generic
/// body, whose calls its specialisations' callers settle.
fn generic_bodies(
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
  names: List<RootName>,
) -> Map<RootName, Tables> =
  names.fold(Map::new(), |acc: Map<RootName, Tables>, n: RootName|
    match answers.get(n) {
      Some(b) -> if specialising(keys, n) == None { acc.insert(n, b.tables) } else { acc },
      _ -> acc,
    })

/// `closed` with what the code of each generic body of `bodies` needs of its type arguments, closed
/// over the calls it makes, a callee outside `bodies` needing what `closed` holds of it: a callee's
/// need of the layout of an argument is the caller's need of each variable that argument is laid out
/// by, and its need of a scalar the caller's of the variable the argument is.
fn needs_closed(
  bodies: Map<RootName, Tables>,
  closed: Map<RootName, List<Need>>,
) -> Map<RootName, List<Need>> / {abort.raise} = {
  let start = bodies.fold(closed, |acc: Map<RootName, List<Need>>, n: RootName, t: Tables|
    acc.insert(n, t.generics.needs));
  // Needs only grow, so a round adding none is the last.
  let held = |needs: Map<RootName, List<Need>>|
    bodies.fold(0, |c: Int, n: RootName, _: Tables|
      c + (match needs.get(n) { Some(ns) -> ns.len(), None -> 0 }));
  // Each round adds a need or stops, and a definition has two needs a variable at most.
  let most = bodies.fold(1, |acc: Int, _: RootName, t: Tables|
    acc + 2 * t.generics.calls.fold(1, |n: Int, c: GenericCall| n + c.args.len()));
  iterate(start, most, |needs: Map<RootName, List<Need>>| {
    let next = bodies.fold(needs, |acc: Map<RootName, List<Need>>, n: RootName, t: Tables|
      t.generics.calls.fold(acc, |a: Map<RootName, List<Need>>, call: GenericCall|
        widened(a, n, call, needs)));
    if held(next) == held(needs) { Stop(needs) } else { Continue(next) }
  })
}

/// Whether the body of root `n`, whose tables are `t`, is a generic body the unit never emits: its
/// needs, its own or what its callees need of what it hands them (`needs`), read a type variable's
/// layout or the type itself, which only the type arguments its callers settle say.
fn settled_by_its_callers(
  keys: Map<RootName, RootKey>,
  n: RootName,
  t: Tables,
  needs: Map<RootName, List<Need>>,
) -> Bool =
  specialising(keys, n) == None
    && (settled_by_callers(t.generics.needs)
    || settled_by_callers(match needs.get(n) { Some(ns) -> ns, None -> [] }))

/// The generic bodies the unit never emits (`settled_by_its_callers`). Their calls are settled on
/// their specialisations instead.
fn settled_only(
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
  needs: Map<RootName, List<Need>>,
) -> Map<RootName, Bool> =
  answers.fold(Map::new(), |acc: Map<RootName, Bool>, n: RootName, a: Answer|
    if settled_by_its_callers(keys, n, a.tables, needs) { acc.insert(n, true) } else { acc })

/// `answers` without each body of `unemitted`, which its callers settle at their type arguments,
/// after a check that no specialisation still reads a type variable's layout or type: such a
/// specialisation was settled on type arguments that leave open what it reads, which no unit can
/// emit.
fn settled_bodies(
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
  unemitted: Map<RootName, Bool>,
) -> Map<RootName, Answer> / {abort.raise} =
  answers.fold(Map::new(), |acc: Map<RootName, Answer>, n: RootName, a: Answer|
    if unemitted.contains(n) { acc }
    else if specialising(keys, n) != None && settled_by_callers(a.tables.generics.needs) {
      panic(
        String::of_bytes_lossy(
          Bytes::concat_all([
            b"the specialisation `",
            root_text(n),
            b"` its callers settled still reads a type variable's layout or type",
          ]),
        ),
      )
    } else { acc.insert(n, a) })

/// `closed` with the parameters each body of `bodies` calls as functions, closed over the calls it
/// hands them on to, a callee outside `bodies` calling what `closed` holds of it: one handed on as a
/// parameter its callee calls is called. A tail group's members call none, since a specialisation of
/// one would leave its group's loop.
fn called_closed(
  bodies: Map<RootName, Tables>,
  closed: Map<RootName, List<Int>>,
) -> Map<RootName, List<Int>> / {abort.raise} = {
  let alone = bodies.fold(Map::new(), |acc: Map<RootName, Generics>, n: RootName, t: Tables|
    if t.members.len() <= 1 { acc.insert(n, t.generics) } else { acc });
  let start = alone.fold(closed, |acc: Map<RootName, List<Int>>, n: RootName, g: Generics|
    acc.insert(n, g.called));
  let held = |called: Map<RootName, List<Int>>|
    alone.fold(0, |c: Int, n: RootName, _: Generics|
      c + (match called.get(n) { Some(cs) -> cs.len(), None -> 0 }));
  // Each round adds a parameter or stops, and a body has as many to add as it hands on.
  let most = alone.fold(1, |acc: Int, _: RootName, g: Generics| acc + g.passes.len());
  iterate(start, most, |called: Map<RootName, List<Int>>| {
    let next = alone.fold(called, |acc: Map<RootName, List<Int>>, n: RootName, g: Generics|
      g.passes.fold(acc, |a: Map<RootName, List<Int>>, pass: Pass| {
        let theirs = match called.get(root_name(pass.callee)) { Some(cs) -> cs, None -> [] };
        let mine = match a.get(n) { Some(cs) -> cs, None -> [] };
        if theirs.contains(pass.at) && !mine.contains(pass.param) {
          a.insert(n, mine.push(pass.param))
        } else { a }
      }));
    if held(next) == held(called) { Stop(called) } else { Continue(next) }
  })
}

/// `needs` with caller `n`'s needs of what `call` hands its callee.
fn widened(
  acc: Map<RootName, List<Need>>,
  n: RootName,
  call: GenericCall,
  needs: Map<RootName, List<Need>>,
) -> Map<RootName, List<Need>> / {abort.raise} = {
  let callee = match needs.get(root_name(call.callee)) { Some(ns) -> ns, None -> [] };
  callee.fold(acc, |a: Map<RootName, List<Need>>, need: Need|
    match call.args.at(need.var) {
      None -> a,
      Some(arg) -> {
        let vars = match need.reads {
          Exact -> type_vars(arg),
          Layout -> laid_vars(arg),
          Scalar -> match arg { TyVar(v) -> if v >= 0 { [v] } else { [] }, _ -> [] },
          // A caller hands the rows it settles a callee generic over rows at as its own.
          Rowed -> [],
        };
        vars.fold(a, |m: Map<RootName, List<Need>>, v: Int| {
          let had = match m.get(n) { Some(ns) -> ns, None -> [] };
          let more = { var: v, reads: need.reads };
          if had.contains(more) { m } else { m.insert(n, had.push(more)) }
        })
      },
    })
}

/// The root a generic call settles on over the program's constructors `ctors`: each type argument
/// the callee's code needs and the call knows, keyed by the type itself where the code reads which
/// type it is or does the operators a type's module states, and otherwise by its layout (where the
/// code needs that, does a scalar's operators in C, or the call carries the argument raw), lowered
/// at the call's own argument; every other
/// argument left as the callee's generic body has it. Calls settling on one layout share a root's
/// name. A tail loop's member reads each variable exactly, so its loop runs at its callers' types.
/// A callee generic over rows is settled at the rows the call hands it words for.
fn settled_root(
  call: GenericCall,
  needs: Map<RootName, List<Need>>,
  called: Map<RootName, List<Int>>,
  ctors: Ctors,
) -> RootKey / {abort.raise} = {
  let callee = root_name(call.callee);
  let ns = match needs.get(callee) { Some(x) -> x, None -> [] };
  let open = KeyType(unknown_type());
  let args = range(0, call.args.len()).map(|j: Int| {
    let arg = call.args.get(j);
    let laid = || KeyLayout({ key: layout_key(ctors, arg), at: arg });
    if has_vars(arg) { open }
    else if ns.contains({ var: j, reads: Exact }) { KeyType(arg) }
    else if call.carried.contains(j) || ns.contains({ var: j, reads: Layout }) { laid() }
    else if ns.contains({ var: j, reads: Scalar }) && held_apart(arg) { laid() }
    else if ns.contains({ var: j, reads: Scalar }) && numeric_sum(ctors, arg) { KeyType(arg) }
    else { open }
  });
  // A lambda is run in place only by a callee that calls the parameter it is handed as.
  let calls = match called.get(callee) { Some(cs) -> cs, None -> [] };
  let fns = call.fns.filter(|f: FnArg| calls.contains(f.param));
  match definition_of(call.callee) {
    Some(def) -> if fns.len() == 0 && args.all(|a: KeyArg| a == open) && call.rows.len() == 0 {
      call.callee
    } else { keys::at_rowed(def, args, fns, call.rows) },
    None -> call.callee,
  }
}

/// `answers` with every generic call settled over the program's constructors `ctors`, by the needs
/// and the parameters called as functions the walk closed (`settling`), so each call settles on the
/// root the walk answered for it: each placeholder of a body's C, and of the entries its closures
/// name, written as the root its call settles on, a specialisation as the code `compiled_as` says it
/// compiles as, and that root among the body's calls. Answers those answers, and `unemitted`: the
/// generic bodies the unit never emits, whose calls are settled on their specialisations instead
/// (`settled_only`).
fn generics_settled(
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
  compiled_as: Map<RootName, RootKey>,
  needs: Map<RootName, List<Need>>,
  called: Map<RootName, List<Int>>,
  ctors: Ctors,
) -> { answers: Map<RootName, Answer>, unemitted: Map<RootName, Bool> } / {abort.raise} = {
  let unemitted = settled_only(answers, keys, needs);
  // A root keyed by a layout is the one the unit asked for under its name, whatever type this call
  // settles it at.
  let asked = |k: RootKey| match keys.get(root_name(k)) { Some(x) -> x, None -> k };
  let settled_answers = answers.fold(
    Map::new(),
    |acc: Map<RootName, Answer>, n: RootName, a: Answer|
      acc.insert(n, if a.tables.generics.calls.len() == 0 { a } else {
        let settled = a.tables.generics.calls.map(|g: GenericCall| {
          let own = asked(settled_root(g, needs, called, ctors));
          match compiled_as.get(root_name(own)) { Some(k) -> k, None -> own }
        });
        let roots = settled.map(root_name);
        let calls = settled.fold(a.tables.calls, |cs: List<RootKey>, r: RootKey|
          if cs.any(|c: RootKey| root_name(c) == root_name(r)) { cs } else { cs.push(r) });
        // A generic call's head is held to the root it settles on, by that root's place in `calls`.
        let placed = |name: RootName|
          range(0, calls.len()).fold(None, |found: Option<Int>, i: Int|
            match found {
              Some(_) -> found,
              None -> match calls.at(i) {
                Some(c) -> if root_name(c) == name { Some(i) } else { None },
                None -> None,
              },
            });
        {
          text: placeholders_named(a.text, roots),
          tables: {
            ..a.tables,
            generics: {
              ..a.tables.generics,
              expects: a.tables.generics.expects.map(|e: Expect|
                match e.callee {
                  GenericAt(n) -> match roots.at(n) {
                    Some(r) -> match placed(r) { Some(i) -> { ..e, callee: CallAt(i) }, None -> e },
                    None -> e,
                  },
                  CallAt(_) -> e,
                }),
            },
            lambdas: a.tables.lambdas.map(|l: Bytes| placeholders_named(l, roots)),
            calls: calls,
          },
        }
      }),
  );
  { answers: settled_answers, unemitted: unemitted }
}

/// The answers as a unit compiles them: `answers` with each specialisation's body under the name of
/// the code it compiles as (`Coded`), which every specialisation of that code shares; `keys` with
/// each code's key; and `compiled_as`, each specialisation's name to its code's key.
type Compiled = {
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
  compiled_as: Map<RootName, RootKey>,
}

/// `answers`, each a root's by its key in `keys`, as the unit compiles them (`Compiled`). A code's
/// name is a function of its body alone, so a caller's C does not depend on which other
/// specialisations the program holds. A tail group's members keep their own names, as one body
/// answers for them all.
fn compiled(
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
) -> Compiled / {abort.raise} =
  answers.fold(
    { answers: Map::new(), keys: keys, compiled_as: Map::new() },
    |acc: Compiled, n: RootName, a: Answer|
      match keys.get(n) {
        Some(At(spec, _)) -> if a.tables.members.len() > 0 {
          { ..acc, answers: acc.answers.insert(n, a) }
        } else {
          let k = code_of(spec.def, n, a);
          let c = root_name(k);
          {
            answers: if acc.answers.contains(c) { acc.answers }
            else { acc.answers.insert(c, renamed(a, n, k)) },
            keys: acc.keys.insert(c, k),
            compiled_as: acc.compiled_as.insert(n, k),
          }
        },
        _ -> { ..acc, answers: acc.answers.insert(n, a) },
      },
  )

/// The code body `a` of specialisation `n` of `def` compiles as: the digest of the body with its
/// calls of itself made calls of no name, which a specialisation whose body is alike but for its name
/// shares.
fn code_of(def: Bytes, n: RootName, a: Answer) -> RootKey / {abort.raise} = {
  let unnamed = renamed(a, n, Coded({ def: def, code: b"" }));
  Coded({
    def: def,
    code: Bytes::of_string(blake3(bin::encode(unnamed, answer_bin())).slice(0, 16).hex_of()),
  })
}

/// Body `a` of root `n` as the body of root `k`: each call of `n` a call of `k`. Its C names the root
/// it defines by a placeholder (`pieces.own_symbol`), so nothing else names `n`.
fn renamed(a: Answer, n: RootName, k: RootKey) -> Answer =
  {
    ..a,
    tables: {
      ..a.tables,
      calls: a.tables.calls.map(|c: RootKey| if root_name(c) == n { k } else { c }),
    },
  }

/// `text` with each `@@gN@@` written as the symbol of root `N`.
fn placeholders_named(text: Bytes, roots: List<RootName>) -> Bytes / {abort.raise} = {
  let walked = holes(text).filter(|h: Hole| h.kind == 103).fold(
    { from: 0, out: [] },
    |s: { from: Int, out: List<Bytes> }, h: Hole|
      {
        from: h.close + 2,
        out: s.out.push(text.slice(s.from, h.open)).push(
          symbol_of(root_text(roots.get(digits(h.digits)))),
        ),
      },
  );
  Bytes::concat_all(walked.out.push(text.slice(walked.from, text.len())))
}

// --- What a program is told -------------------------------------------------------

/// Ply failing to make a program's unit, as `why` says: a defect in Ply, not in the program.
fn unmade(why: Bytes) -> Diag =
  error_with_labels(b"E0505", b"Ply failed making this program's unit: ".concat(why), [], [
    b"this is Ply's fault, not the program's",
  ])

/// The unit's C as the runtime compiles it, or why there is none: a runtime that binds or lays out
/// what the unit's code calls or reads otherwise than this compiler declares, a native it calls that
/// the runtime does not implement as declared, or a call written against a handing its callee does
/// not publish; or Ply's own failure, where making the unit panicked or `dump` offers a root no
/// typed row keys (`offered_roots`).
pub fn held(
  dump: Dump,
  emission: Result<Emission, Bytes>,
) -> Result<Bytes, List<Diag>> / {abort.raise} =
  match emission {
    Err(why) -> Err([unmade(why)]),
    Ok(e) -> if e.unserved.len() > 0 { Err([runtime_refused(e.unserved)]) }
    else if e.unbound.len() > 0 { Err([natives_refused(e.unbound)]) }
    else if e.misassumed.len() > 0 { Err([handings_disagree(e.misassumed)]) } else {
      match offered_roots(dump).unkeyed {
        [] -> Ok(e.produced.text),
        unkeyed ->
          Err([
            unmade(
              Bytes::concat_all([
                b"the front end offered ",
                Bytes::join(unkeyed.map(|n: Bytes| Bytes::concat_all([b"`", n, b"`"])), b", "),
                b" with no typed row to key them by",
              ]),
            ),
          ]),
      }
    },
  }

// --- Tests ------------------------------------------------------------------

fn some_definitions() -> Bytes =
  b"compiler.unit.emitted aa\ncompiler.front.seam.view_dump bb\nunit.emitted cc\ncompiler.unit.emitted_twice dd\n"

/// The needs of every generic body of `answers`, closed in one go, as no walk's steps split them.
fn closed_needs(
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
) -> Map<RootName, List<Need>> / {abort.raise} =
  needs_closed(generic_bodies(answers, keys, answers.keys()), Map::new())

/// The parameters every generic body of `answers` calls as functions, closed in one go.
fn closed_called(
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
) -> Map<RootName, List<Int>> / {abort.raise} =
  called_closed(generic_bodies(answers, keys, answers.keys()), Map::new())

/// A generic body that calls `calls` and needs `needs`.
fn generic_body(calls: List<GenericCall>, needs: List<Need>) -> Answer =
  {
    text: b"",
    tables: { ..no_tables(), generics: { ..no_generics(), calls: calls, needs: needs } },
  }

/// The type `s` spells, as a test writes one.
fn spelled(s: Bytes) -> Type / {abort.raise} =
  match type_spelled(s) {
    Some(t) -> t,
    None -> panic(String::of_bytes_lossy(b"a spelling of no type: ".concat(s))),
  }

/// `answers` by their keys' names, and the keys by the same.
fn keyed(
  answers: List<{ key: RootKey, value: Answer }>,
) -> { answers: Map<RootName, Answer>, keys: Map<RootName, RootKey> } =
  {
    answers: answers.fold(
      Map::new(),
      |m: Map<RootName, Answer>, x: { key: RootKey, value: Answer }|
        m.insert(root_name(x.key), x.value),
    ),
    keys: answers.fold(
      Map::new(),
      |m: Map<RootName, RootKey>, x: { key: RootKey, value: Answer }|
        m.insert(root_name(x.key), x.key),
    ),
  }

/// The name of the root of definition `n`.
fn def_root(n: Bytes) -> RootName = root_name(Named(n))

/// The name root `k` prints as.
fn printed(k: RootKey) -> Bytes = root_text(root_name(k))

/// What a program declares of the natives of shipped modules a unit calls over machine words, for one
/// that declares none.
fn no_machine(called: Map<Bytes, Bool>) -> List<Native> = []

/// Each of `entries` by the name of the root of the definition its key names.
fn by_def<v>(entries: List<{ key: Bytes, value: v }>) -> Map<RootName, v> =
  entries.fold(Map::new(), |m: Map<RootName, v>, x: { key: Bytes, value: v }|
    m.insert(def_root(x.key), x.value))

/// Root `k` offered as a call of `arity` words.
fn offer_root(k: RootKey, arity: Int) -> Offered =
  { name: root_name(k), arity: arity, constant: false, site: root_name(k), home: home_of(k) }

/// Definition `n` offered as a call of `arity` words.
fn offer(n: Bytes, arity: Int) -> Offered = offer_root(Named(n), arity)

test "a generic call settles on each argument its callee's code needs, and leaves the rest" {
  let needs = by_def([
    { key: b"m.lay", value: [{ var: 0, reads: Layout }] },
    { key: b"m.add", value: [{ var: 0, reads: Scalar }] },
    { key: b"m.same", value: [{ var: 0, reads: Exact }] },
  ]);
  let root = |callee: Bytes, arg: Bytes|
    settled_root(
      { callee: Named(callee), args: [spelled(arg)], carried: [], fns: [], rows: [] },
      needs,
      Map::new(),
      no_ctors(),
    );
  let call = |callee: Bytes, arg: Bytes| root_text(root_name(root(callee, arg)));
  // A layout the code reads is kept by its key, a record of one pointer by its field, since its word
  // is a box of it; a type it reads is kept whole.
  assert_eq(call(b"m.lay", b"{x:Float}"), b"m.lay@{x:Float}");
  assert_eq(call(b"m.lay", b"_"), b"m.lay@_");
  assert_eq(call(b"m.lay", b"{x:m.Shape}"), b"m.lay@{x:_}");
  // Two types laid alike share the root's name, each lowered at its own type.
  assert_eq(call(b"m.lay", b"{x:m.Date}"), call(b"m.lay", b"{x:m.Shape}"));
  assert_eq(key_types(root(b"m.lay", b"{x:m.Date}")), [spelled(b"{x:m.Date}")]);
  assert_eq(call(b"m.same", b"List<m.Shape>"), b"m.same@List<m.Shape>");
  assert_eq(call(b"m.same", b"m.Date{day:Int}"), b"m.same@m.Date{day:Int}");
  // A scalar its operators read is kept; a record they do not read is not.
  assert_eq(call(b"m.add", b"Float"), b"m.add@Float");
  assert_eq(call(b"m.add", b"{x:Float}"), b"m.add");
  assert_eq(call(b"m.add", b"m.Shape"), b"m.add");
  // An argument the caller does not know yet, or a callee that needs nothing, is the generic body.
  assert_eq(call(b"m.lay", b"{x:'0}"), b"m.lay");
  assert_eq(call(b"m.none", b"Float"), b"m.none")
}

test "a lambda is run in place only by a callee that calls the parameter it is handed as" {
  let body = |called: List<Int>, passes: List<Pass>|
    {
      text: b"",
      tables: { ..no_tables(), generics: { ..no_generics(), called: called, passes: passes } },
    };
  let answers = by_def([
    { key: b"m.each", value: body([1], []) },
    // `pass` hands its parameter on to `each`, which calls it; `keep` only holds it.
    { key: b"m.pass", value: body([], [{ param: 0, callee: Named(b"m.each"), at: 1 }]) },
    { key: b"m.keep", value: body([], []) },
  ]);
  let called = closed_called(answers, Map::new());
  assert_eq(called.get(def_root(b"m.pass")), Some([0]));
  let call = |callee: Bytes, param: Int|
    printed(
      settled_root(
        {
          callee: Named(callee),
          args: [],
          carried: [],
          fns: [{ param: param, owner: Named(b"m.main"), nth: 0 }],
          rows: [],
        },
        Map::new(),
        called,
        no_ctors(),
      ),
    );
  assert_eq(call(b"m.each", 1), b"m.each@|1=m.main:0");
  assert_eq(call(b"m.pass", 0), b"m.pass@|0=m.main:0");
  assert_eq(call(b"m.each", 0), b"m.each");
  assert_eq(call(b"m.keep", 0), b"m.keep")
}

test "a generic body needs what its callees need of what it hands them, through its own variables" {
  let answers = by_def([
    { key: b"m.add", value: generic_body([], [{ var: 0, reads: Scalar }]) },
    { key: b"m.lay", value: generic_body([], [{ var: 0, reads: Layout }]) },
    // `wrap` hands its variable to `add` bare and to `lay` inside a record.
    {
      key: b"m.wrap",
      value: generic_body(
        [
          { callee: Named(b"m.add"), args: [spelled(b"'0")], carried: [], fns: [], rows: [] },
          { callee: Named(b"m.lay"), args: [spelled(b"{v:'1}")], carried: [], fns: [], rows: [] },
        ],
        [],
      ),
    },
    // `outer` hands its variable inside a list, which no layout reads.
    {
      key: b"m.outer",
      value: generic_body(
        [
          {
            callee: Named(b"m.wrap"),
            args: [spelled(b"List<_>"), spelled(b"'0")],
            carried: [],
            fns: [],
            rows: [],
          },
        ],
        [],
      ),
    },
    { key: b"m.same", value: generic_body([], [{ var: 0, reads: Exact }]) },
    // `each` hands its variable inside a list to `same`, which reads the whole of it.
    {
      key: b"m.each",
      value: generic_body(
        [
          {
            callee: Named(b"m.same"),
            args: [spelled(b"List<'0>")],
            carried: [],
            fns: [],
            rows: [],
          },
        ],
        [],
      ),
    },
  ]);
  let closed = closed_needs(answers, Map::new());
  assert_eq(
    closed.get(def_root(b"m.wrap")),
    Some([{ var: 0, reads: Scalar }, { var: 1, reads: Layout }]),
  );
  assert_eq(closed.get(def_root(b"m.outer")), Some([{ var: 0, reads: Layout }]));
  assert_eq(closed.get(def_root(b"m.each")), Some([{ var: 0, reads: Exact }]))
}

test "a generic body whose needs or its callees' read a variable's layout or type is settled by its callers" {
  let answers = by_def([
    { key: b"m.add", value: generic_body([], [{ var: 0, reads: Scalar }]) },
    { key: b"m.lay", value: generic_body([], [{ var: 0, reads: Layout }]) },
    { key: b"m.same", value: generic_body([], [{ var: 0, reads: Exact }]) },
    // `each` reads nothing itself, but hands its variable to `same`.
    {
      key: b"m.each",
      value: generic_body(
        [
          {
            callee: Named(b"m.same"),
            args: [spelled(b"List<'0>")],
            carried: [],
            fns: [],
            rows: [],
          },
        ],
        [],
      ),
    },
    { key: b"m.main", value: generic_body([], []) },
  ]);
  let unemitted = settled_only(answers, Map::new(), closed_needs(answers, Map::new()));
  assert_eq(unemitted.keys(), [b"m.each", b"m.lay", b"m.same"].map(def_root));
  // A specialisation is emitted at its type arguments, whatever its definition needs.
  let had = keyed([
    { key: at_key(b"m.same", [spelled(b"Int")], []), value: generic_body([], []) },
    { key: Named(b"m.same"), value: generic_body([], [{ var: 0, reads: Exact }]) },
  ]);
  let kept = settled_bodies(had.answers, had.keys, settled_only(had.answers, had.keys, Map::new()));
  assert_eq(kept.keys(), [at_key(b"m.same", [spelled(b"Int")], [])].map(root_name));
  // One still reading a variable's type was settled on what leaves it open.
  let open = keyed([
    {
      key: at_key(b"m.same", [unknown_type()], []),
      value: generic_body([], [{ var: 0, reads: Exact }]),
    },
  ]);
  let said = handle {
    settled_bodies(open.answers, open.keys, Map::new());
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert(said.index_of(b"still reads a type variable's layout or type") != None, None)
}

test "a body calling one its unit does not take, such as one its callers settle, stops the unit as Ply's own failure" {
  let calling = { text: b"", tables: { ..no_tables(), calls: [Named(b"m.same")] } };
  let said = handle {
    taken_bodies(by_def([{ key: b"m.main", value: calling }]), [def_root(b"m.main")]);
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert_eq(said, b"`m.main` calls `m.same`, which its unit does not take")
}

test "a call of a generic tail loop at a type settles on the loop at it, whichever member it calls" {
  let source = Bytes::concat_all([
    b"fn ping<a>(x: a, n: Int) -> a = if n <= 0 { x } else { pong(x, n - 1) }\n",
    b"fn pong<a>(x: a, n: Int) -> a = if n <= 0 { x } else { ping(x, n - 1) }\n",
    b"fn go() -> Float = ping(1.5, 3)\n",
    b"fn back() -> String = pong(\"s\", 3)\n",
  ]);
  let dump = dump_of(analyse(parse_all([{ name: b"m", src: source }])));
  match emitted(
      a_runtime(b"r"),
      dump,
      [source],
      Map::new(),
      [Named(b"m.go"), Named(b"m.back")],
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(why) -> panic(String::of_bytes_lossy(why)),
    Ok(e) -> {
      // Each call reaches its loop at the type it settled, and neither reaches the loop as it
      // stands.
      assert_eq(
        [b"m.ping@Float", b"m.pong@String", b"m.ping", b"m.pong"].filter(|n: Bytes|
          e.produced.taken.map(root_text).contains(n)),
        [b"m.ping@Float", b"m.pong@String"],
      )
    },
  }
}

/// The C of a specialisation of `m.f`, as the emitter writes it: it calls itself and adds `answer`.
fn specialisation_text(answer: Bytes) -> Bytes = {
  let own = own_symbol(None);
  Bytes::concat_all([b"Word ", own, b"(PlyCtx *ctx) { return ", own, b"(ctx) + ", answer, b"; }"])
}

/// The tables of a specialisation of `m.f` keyed `k`: it calls itself.
fn specialisation_tables(k: RootKey) -> Tables =
  { ..no_tables(), calls: [k], defined: [{ entered: false, head: word_head(0) }] }

/// A program whose root `m.calls_Int` calls `m.f` at `Int`, and so on for each type of `at`, with
/// the specialisation of `m.f` each call settles on: at `U8` of one code, and at every other type
/// alike but for its name. Answers the code each specialisation compiles as, and each body as the
/// unit compiles it, its generic calls settled.
fn program_calling_f_at(
  at: List<Bytes>,
) -> { compiled_as: Map<RootName, RootKey>, bodies: Map<RootName, Answer> } / {abort.raise} = {
  let specialised = |arg: Bytes| {
    let k = at_key(b"m.f", [spelled(arg)], []);
    {
      key: k,
      value: {
        text: specialisation_text(if arg == b"U8" { b"1" } else { b"0" }),
        tables: specialisation_tables(k),
      },
    }
  };
  // A caller's C is no more than the symbol its call settles on.
  let calling = |arg: Bytes| {
    let call = { callee: Named(b"m.f"), args: [spelled(arg)], carried: [], fns: [], rows: [] };
    { key: Named(b"m.calls_".concat(arg)), value: { ..generic_body([call], []), text: b"@@g0@@" } }
  };
  let had = keyed(
    [{ key: Named(b"m.f"), value: generic_body([], [{ var: 0, reads: Exact }]) }].concat(
      at.map(specialised),
    ).concat(
      at.map(calling),
    ),
  );
  let c = compiled(had.answers, had.keys);
  {
    compiled_as: c.compiled_as,
    bodies: generics_settled(
      c.answers,
      c.keys,
      c.compiled_as,
      closed_needs(had.answers, had.keys),
      closed_called(had.answers, had.keys),
      no_ctors(),
    ).answers,
  }
}

test "a specialisation compiles as its code, the same with or without a sibling of that code, which shares it" {
  let code = |p: Map<RootName, RootKey>, arg: Bytes|
    p.get(root_name(at_key(b"m.f", [spelled(arg)], [])));
  let alone = program_calling_f_at([b"Int", b"U8"]).compiled_as;
  let both = program_calling_f_at([b"Int", b"Bool", b"U8"]).compiled_as;
  assert(code(alone, b"Int") != None, None);
  assert_eq(code(both, b"Int"), code(alone, b"Int"));
  assert_eq(code(both, b"Bool"), code(both, b"Int"));
  assert(code(both, b"U8") != code(both, b"Int"), None)
}

test "a specialisation whose code another's is adds no body and moves no other body's C, and a call of either reaches the one body" {
  let alone = program_calling_f_at([b"Int", b"U8"]).bodies;
  let program = program_calling_f_at([b"Int", b"Bool", b"U8"]);
  let both = program.bodies;
  // Beside the sibling's caller, the program holds the bodies it held, each written as it was.
  assert_eq(both.keys().filter(|n: RootName| !alone.contains(n)), [def_root(b"m.calls_Bool")]);
  assert(
    alone.fold(true, |same: Bool, n: RootName, a: Answer| same && both.get(n) == Some(a)),
    None,
  );
  // Each caller of the shared code names its one body.
  let code = match program.compiled_as.get(root_name(at_key(b"m.f", [spelled(b"Int")], []))) {
    Some(k) -> k,
    None -> Named(b"m.f"),
  };
  let own = symbol_of(printed(code));
  let called = |caller: Bytes| match both.get(def_root(caller)) { Some(a) -> a.text, None -> b"" };
  assert_eq([called(b"m.calls_Int"), called(b"m.calls_Bool")], [own, own]);
  assert(called(b"m.calls_U8") != own, None);
  assert_eq(
    both.get(root_name(code)),
    Some({ text: specialisation_text(b"0"), tables: specialisation_tables(code) }),
  )
}

test "a unit compiles specialisations whose code is alike as one body, and its C names none of theirs" {
  // Each lender's lambda is run in place, and both write the same code.
  let source = Bytes::concat_all([
    b"fn apply<a>(f: (a) -> a, x: a) -> a = f(x)\n",
    b"fn one() -> Int = apply(|x: Int| x, 1)\n",
    b"fn two() -> Int = apply(|x: Int| x, 2)\n",
  ]);
  match built([{ name: b"m", src: source }]) {
    Err(why) -> assert_eq(why, b""),
    Ok(e) -> {
      let specialisations = e.roots.filter(|k: RootKey|
        match k { At(a, _) -> a.def == b"m.apply", _ -> false });
      let codes = e.produced.taken.filter(|n: RootName| root_text(n).starts_with(b"m.apply@="));
      let named = |symbol: Bytes| e.produced.text.index_of(symbol) != None;
      assert_eq([specialisations.len(), codes.len()], [2, 1]);
      assert_eq(specialisations.filter(|k: RootKey| named(symbol_of(printed(k)))), []);
      assert(codes.all(|n: RootName| named(symbol_of(root_text(n)))), None)
    },
  }
}

test "a definition's hash is read under its full name and no other" {
  assert_eq(definition_hash(some_definitions(), b"compiler.unit.emitted"), Some(b"aa"));
  assert_eq(definition_hash(some_definitions(), b"compiler.front.seam.view_dump"), Some(b"bb"));
  assert_eq(definition_hash(some_definitions(), b"compiler.unit.emitted_twice"), Some(b"dd"));
  assert_eq(definition_hash(some_definitions(), b"unit.emitted"), Some(b"cc"));
  assert_eq(definition_hash(some_definitions(), b"front.seam.view_dump"), None);
  assert_eq(definition_hash(some_definitions(), b"emitted"), None);
  assert_eq(definition_hash(some_definitions(), b"compiler.unit.emit"), None)
}

test "an identity moves with the hash of a root it names, and with no other definition's" {
  let roots = [b"compiler.unit.emitted", b"compiler.front.seam.view_dump"];
  let one = identity_of(some_definitions(), roots);
  assert_eq(
    identity_of(
      b"compiler.unit.emitted aa\ncompiler.front.seam.view_dump bb\ncompiler.unit.emitted_twice ee\nzeta.new ff\n",
      roots,
    ),
    one,
  );
  assert(
    identity_of(b"compiler.unit.emitted aa\ncompiler.front.seam.view_dump b0\n", roots) != one,
    Some("a root's hash moved and the identity did not"),
  );
  assert(identity_of(some_definitions(), [b"compiler.unit.emitted"]) != one, None)
}

/// A runtime named `identity` implementing every native the prelude declares and serving this
/// compiler's code, as the shipped one does.
fn a_runtime(identity: Bytes) -> Runtime / {abort.raise} =
  serving(identity, program_natives([]).map(declared_signature))

fn a_builder(main: Bytes) -> Bytes =
  Bytes::concat_all([b"compiler.build.main ", main, b"\ncompiler.build.told e5\n"])

test "a program's key moves with the definition it enters, the runtime and the builder, and with nothing else" {
  let key = program_key(b"entry", a_runtime(b"rt"), a_builder(b"c3"));
  assert_eq(key.len(), 64);
  assert_eq(
    program_key(b"entry", a_runtime(b"rt"), a_builder(b"c3").concat(b"other.one f6\n")),
    key,
  );
  assert(program_key(b"other", a_runtime(b"rt"), a_builder(b"c3")) != key);
  assert(program_key(b"entry", a_runtime(b"tr"), a_builder(b"c3")) != key);
  assert(program_key(b"entry", a_runtime(b"rt"), a_builder(b"c4")) != key)
}

test "a line of what a unit says of itself is cut into literals a compiler takes, its newline last" {
  assert_eq(literal_lines(b""), b"\"\" \"\\n\"\n");
  let long = Bytes::concat_all(range(0, 2001).map(|_: Int| b"x"));
  let pieces = literal_lines(long).split(b"\n");
  assert_eq(pieces.len(), 3);
  assert_eq(pieces.get(0).len(), 2002);
  assert_eq(pieces.get(1), b"  \"x\" \"\\n\"")
}

test "lines are read as a final newline ends the last one" {
  assert_eq(split_lines(b"a\nb\n"), [b"a", b"b"]);
  assert_eq(split_lines(b"a\r\n\nb"), [b"a", b"", b"b"])
}

/// A body of root `name` calling `calls` and naming a static of its own, as the emitter writes it:
/// by a placeholder of its symbol (`body_of` reads it as its part writes it).
fn one_body(name: Bytes, calls: List<Bytes>) -> Answer / {abort.raise} = {
  let own = statics_of(SStr(name));
  {
    text: Bytes::concat_all([
      b"Word ",
      own_symbol(None),
      b"(PlyCtx *ctx) { return (Word)(intptr_t)&",
      own.get(0).name,
      b" + @@r@@; }",
    ]),
    tables: {
      ..no_tables(),
      statics: own,
      calls: calls.map(Named),
      defined: [{ entered: true, head: word_head(0) }],
    },
  }
}

/// `a` publishing `head` as its definition's.
fn headed(a: Answer, head: Head) -> Answer =
  { ..a, tables: { ..a.tables, defined: a.tables.defined.map(|d: Defined| { ..d, head: head }) } }

/// `one_body` with other text, as an edit to its definition would make it.
fn edited_body(name: Bytes) -> Answer / {abort.raise} = {
  let b = one_body(name, []);
  { ..b, text: b.text.concat(b"\n/* edited */") }
}

/// The codes of a unit over `answers`, offering `constants` as constants and the rest as calls, by
/// the names of the definitions they are of.
fn codes_over(
  answers: List<{ key: Bytes, value: Answer }>,
  offered: List<Bytes>,
  constants: List<Bytes>,
) -> Map<Bytes, Bytes> / {abort.raise} =
  codes(
    produce(
      [],
      offered.map(|n: Bytes| { ..offer(n, 0), constant: constants.contains(n) }),
      1,
      by_def(answers),
      Map::new(),
      no_machine,
      part_rule(),
    ).made,
  ).fold(Map::new(), |m: Map<Bytes, Bytes>, n: RootName, code: Bytes| m.insert(root_text(n), code))

test "a root's code moves with every body it can call, and with no other" {
  let program = |g: Answer|
    codes_over(
      [
        { key: b"m.f", value: one_body(b"m.f", [b"m.g"]) },
        { key: b"m.g", value: g },
        { key: b"m.h", value: one_body(b"m.h", []) },
      ],
      [b"m.f", b"m.g", b"m.h"],
      [],
    );
  let before = program(one_body(b"m.g", []));
  let after = program(edited_body(b"m.g"));
  assert(before.get(b"m.f") != after.get(b"m.f"), None);
  assert(before.get(b"m.g") != after.get(b"m.g"), None);
  assert_eq(before.get(b"m.h"), after.get(b"m.h"));
  assert(before.get(b"m.f") != before.get(b"m.h"), None)
}

// The checker decides which roots are constants, and the unit holds a constant where it would call
// a root, so the same bodies offered otherwise are other code.
test "a root's code moves with how it and its callees were offered" {
  let program = |constants: List<Bytes>|
    codes_over(
      [
        { key: b"m.f", value: one_body(b"m.f", [b"m.g"]) },
        { key: b"m.g", value: one_body(b"m.g", []) },
        { key: b"m.h", value: one_body(b"m.h", []) },
      ],
      [b"m.f", b"m.g", b"m.h"],
      constants,
    );
  let called = program([]);
  let held = program([b"m.g"]);
  assert(called.get(b"m.g") != held.get(b"m.g"), None);
  assert(called.get(b"m.f") != held.get(b"m.f"), None);
  assert_eq(called.get(b"m.h"), held.get(b"m.h"))
}

test "a cycle is digested whole, whatever order the unit holds its roots in" {
  let cycle = |b: Answer, order: List<Bytes>|
    codes_over(
      [{ key: b"m.a", value: one_body(b"m.a", [b"m.b"]) }, { key: b"m.b", value: b }],
      order,
      [],
    );
  let one = cycle(one_body(b"m.b", [b"m.a"]), [b"m.a", b"m.b"]);
  assert_eq(cycle(one_body(b"m.b", [b"m.a"]), [b"m.b", b"m.a"]), one);
  assert(one.get(b"m.a") != one.get(b"m.b"), None);
  let edited = {
    let b = edited_body(b"m.b");
    { ..b, tables: { ..b.tables, calls: [Named(b"m.a")] } }
  };
  assert(cycle(edited, [b"m.a", b"m.b"]).get(b"m.a") != one.get(b"m.a"), None)
}

// A body names a constructor's tag by the constructor, so the same answer serves programs whose
// tables differ, and each unit writes the position its own table gives.
test "a constructor's tag is its part's to read, at the position the unit's own table gives it" {
  let answer = {
    text: b"Word f_m.f(PlyCtx *ctx) { return @@Tm.Line@@ + @@TNone@@; }",
    tables: {
      ..no_tables(),
      defined: [{ entered: true, head: word_head(0) }],
      keyed: [KeyedTag(b"m.Line"), KeyedTag(b"None")],
    },
  };
  let unit = |ctors: List<Ctor>|
    produce(
      ctors,
      [offer(b"m.f", 0)],
      1,
      by_def([{ key: b"m.f", value: answer }]),
      Map::new(),
      no_machine,
      part_rule(),
    ).text;
  let alone = unit([
    { name: b"None", arity: 0 },
    { name: b"m.Dot", arity: 0 },
    { name: b"m.Line", arity: 1 },
  ]);
  let beside = unit([
    { name: b"None", arity: 0 },
    { name: b"a.One", arity: 0 },
    { name: b"a.Two", arity: 0 },
    { name: b"m.Dot", arity: 0 },
    { name: b"m.Line", arity: 1 },
  ]);
  let label = part_label(def_root(b"m.f"));
  let table = part_table(label);
  let body = Bytes::concat_all([b"{ return ", table, b"[1] + ", table, b"[0]; }"]);
  assert(alone.index_of(body) != None, None);
  assert(beside.index_of(body) != None, None);
  // The part declares the table, and the `tables` part lays it out filled beside the descriptor.
  let declared = Bytes::concat_all([b"extern const uint32_t ", table, b"[];\n"]);
  assert(part_labelled(alone, label).index_of(declared) != None, None);
  let filled = |places: Bytes|
    Bytes::concat_all([b"const uint32_t ", table, b"[] = {", places, b" };\n"]);
  assert(part_labelled(alone, "tables").index_of(filled(b" 0, 2,")) != None, None);
  assert(part_labelled(beside, "tables").index_of(filled(b" 0, 4,")) != None, None)
}

/// A rule that cuts a unit's C before every body, so each sits in a part of its own.
fn one_each() -> PartRule = { bits: 0, min: 0, max: 1 << 40 }

/// A rule that cuts a unit's C before every body whose root id is even, however little the part
/// holds.
fn by_names() -> PartRule = { bits: 1, min: 0, max: 1 << 40 }

/// A part of a unit's C as `cc.split` cuts it: its label, and its C from its mark on.
type Cut = { label: String, text: Bytes }

/// The parts `cc.split` cuts unit `text` into, in the order the unit holds them.
fn parts_in(text: Bytes) -> List<Cut> / {abort.raise} =
  cc::split(text).parts.sort_by(|a: Cut, b: Cut| found_at(text, a.text) < found_at(text, b.text))

/// The parts of unit `text` that hold its bodies: each before the runtime's.
fn body_parts(text: Bytes) -> List<Cut> / {abort.raise} =
  parts_in(text).fold({ out: [], past: false }, |acc: { out: List<Cut>, past: Bool }, c: Cut|
    if acc.past || c.label == "runtime" { { ..acc, past: true } }
    else { { ..acc, out: acc.out.push(c) } }).out

/// The C of the part of unit `text` labelled `label`, or nothing.
fn part_labelled(text: Bytes, label: String) -> Bytes / {abort.raise} =
  match parts_in(text).find(|c: Cut| c.label == label) { Some(c) -> c.text, None -> b"" }

/// The C of the first part of unit `text` that holds `c`, or nothing.
fn part_holding(text: Bytes, c: Bytes) -> Bytes / {abort.raise} =
  match parts_in(text).find(|p: Cut| p.text.index_of(c) != None) { Some(p) -> p.text, None -> b"" }

/// How `one_body`'s definition of `name` opens once its part writes it.
fn body_of(name: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([b"Word ", symbol_of(name), b"(PlyCtx *ctx)"])

/// Where `needle` first stands in `hay`, or -1.
fn found_at(hay: Bytes, needle: Bytes) -> Int =
  match hay.index_of(needle) { Some(i) -> i, None -> 0 - 1 }

/// The definitions `m.b0` onwards, `n` of them.
fn numbered(n: Int) -> List<Bytes> = range(0, n).map(|i: Int| b"m.b".concat(ascii_of_int(i)))

/// The C of the unit over definitions `names`, each body as `one_body` writes it but `edited`'s, which
/// `edited_body` does, cut by `rule`.
fn unit_over(names: List<Bytes>, edited: Bytes, rule: PartRule) -> Bytes / {abort.raise} =
  produce(
    [],
    names.map(|n: Bytes| offer(n, 0)),
    1,
    by_def(
      names.map(|n: Bytes|
        { key: n, value: if n == edited { edited_body(n) } else { one_body(n, []) } }),
    ),
    Map::new(),
    no_machine,
    rule,
  ).text

/// Each of `xs` that `ys` does not hold.
fn missing_from(xs: List<Cut>, ys: List<Cut>) -> List<Cut> = xs.filter(|x: Cut| !ys.contains(x))

test "a part's C reads the same whatever another part adds to the unit's tables" {
  // A body naming a field of the unit's field table, the name `field`.
  let fielded = |n: Bytes, field: Bytes| {
    let b = one_body(n, []);
    {
      text: b.text.concat(b" /* @@f0@@ */"),
      tables: { ..b.tables, fields: [field], keyed: [KeyedField(0)] },
    }
  };
  let unit = |names: List<Bytes>|
    produce(
      [{ name: b"None", arity: 0 }],
      names.map(|n: Bytes| offer(n, 0)),
      1,
      by_def(names.map(|n: Bytes| { key: n, value: fielded(n, n) })),
      Map::new(),
      no_machine,
      one_each(),
    ).text;
  let alone = unit([b"m.f"]);
  let beside = unit([b"m.f", b"a.other"]);
  let label = part_label(def_root(b"m.f"));
  assert(part_labelled(alone, label).index_of(body_of(b"m.f")) != None, None);
  assert_eq(part_labelled(beside, label), part_labelled(alone, label));
  // What moved is `a.other`'s part and the unit's tables, where `m.f`'s field is one place on.
  assert(part_labelled(beside, "tables") != part_labelled(alone, "tables"), None)
}

test "an edit to one body's C changes only the part holding it" {
  let names = numbered(16);
  let before = unit_over(names, b"", by_names());
  let after = unit_over(names, b"m.b7", by_names());
  let bodies = body_parts(before);
  assert(bodies.len() > 1 && bodies.len() < names.len(), None);
  assert_eq(parts_in(after).map(|c: Cut| c.label), parts_in(before).map(|c: Cut| c.label));
  let changed = missing_from(parts_in(after), parts_in(before));
  assert_eq(changed.map(|c: Cut| c.text), [part_holding(after, body_of(b"m.b7"))]);
  assert(changed.get(0).text.index_of(b"/* edited */") != None, None)
}

// Read backwards, each case is the body removed: the parts it changes are the same.
test "a body added or removed changes the part it sits in and at most one beside it" {
  let names = numbered(16);
  let before = body_parts(unit_over(names, b"", by_names()));
  [2, 7, 11, 13].fold((), |_: Unit, i: Int| {
    let added = Bytes::concat_all([b"m.b", ascii_of_int(i), b"x"]);
    let after = body_parts(unit_over(names.push(added), b"", by_names()));
    let gone = missing_from(before, after);
    let came = missing_from(after, before);
    assert(gone.len() <= 1 && came.len() <= 2, Some(String::of_bytes_lossy(added)));
    assert(came.any(|c: Cut| c.text.index_of(body_of(added)) != None), None)
  })
}

test "a small program's bodies are one part" {
  assert_eq(body_parts(unit_over(numbered(8), b"", part_rule())).len(), 1)
}

test "a body larger than the most a part holds sits alone, and the rest share parts up to it" {
  let big = b"m.b3";
  let names = numbered(8);
  let padded = {
    let b = one_body(big, []);
    { ..b, text: b.text.concat(b" ".repeat(300)) }
  };
  let text = produce(
    [],
    names.map(|n: Bytes| offer(n, 0)),
    1,
    by_def(
      names.map(|n: Bytes| { key: n, value: if n == big { padded } else { one_body(n, []) } }),
    ),
    Map::new(),
    no_machine,
    { bits: 62, min: 1 << 40, max: 250 },
  ).text;
  assert_eq(part_holding(text, body_of(big)).split(b"(PlyCtx *ctx)").len() - 1, 1);
  assert(body_parts(text).len() < names.len(), None)
}

test "each part is labelled apart: a body's by its first body's root id, the tail's by a word" {
  let names = numbered(12);
  let text = unit_over(names, b"", one_each());
  // `cc.split` refuses a unit two parts of which share a label.
  let labels = parts_in(text).map(|c: Cut| c.label);
  assert_eq(
    body_parts(text).map(|c: Cut| c.label),
    ordered(names).map(|n: Bytes| part_label(def_root(n))),
  );
  let digits = b"0123456789abcdef";
  assert(
    body_parts(text).all(|c: Cut| {
      let label = Bytes::of_string(c.label);
      label.len() == 16 && range(0, 16).all(|i: Int| digits.index_of(label.slice(i, i + 1)) != None)
    }),
    None,
  );
  assert_eq(labels.drop(names.len()), ["runtime", "taken", "tables"])
}

test "a root whose entry the unit takes is listed as entered, though the unit holds no body of it" {
  let entry = |n: Bytes| root_name(Entered(Named(n)));
  let def = |n: Bytes| offer(n, 0);
  let entered = |n: Bytes| { ..offer_root(Entered(Named(n)), 0), site: def_root(n) };
  // `m.h`'s callers settle its body, so only its entry is offered.
  let p = produce(
    [],
    [def(b"m.f"), def(b"m.g"), entered(b"m.f"), entered(b"m.h")],
    1,
    Map::of_entries([
      { key: def_root(b"m.f"), value: one_body(b"m.f", []) },
      { key: def_root(b"m.g"), value: one_body(b"m.g", []) },
      { key: entry(b"m.f"), value: one_body(root_text(entry(b"m.f")), [b"m.f"]) },
      { key: entry(b"m.h"), value: one_body(root_text(entry(b"m.h")), []) },
    ]),
    Map::new(),
    no_machine,
    part_rule(),
  );
  assert(p.taken.contains(entry(b"m.f")), None);
  assert(p.text.index_of(b"entered m.f") != None, None);
  assert(p.text.index_of(b"entered m.h") != None, None);
  assert_eq(p.text.index_of(b"entered m.g"), None)
}

/// What unit `text` holds before its first part, which every part compiles after.
fn head_in(text: Bytes) -> Bytes / {abort.raise} = cc::split(text).head

test "every part of a unit compiles after the head, and the runtime's part opens with the tail" {
  let p = produce(
    [],
    [offer(b"m.f", 0)],
    1,
    by_def([{ key: b"m.f", value: one_body(b"m.f", []) }]),
    Map::new(),
    no_machine,
    part_rule(),
  );
  assert(head_in(p.text) == unit_head(), None);
  assert(p.text.index_of(unit_tail([])) != None, None);
  // The unit lists what it binds in the order its `ply_bind` reads their addresses.
  assert(
    p.text.index_of(
        Bytes::concat_all([
          b"\"helpers ",
          ascii_of_int(bound().len()),
          b"\" \"\\n\"\n\"rt_box_decimal 2 1\"",
        ]),
      )
      != None,
    None,
  )
}

// A part is compiled alone, so it declares what its bodies call at the width each is taken at, and
// nothing else; and a body sits once, in one part.
test "a part declares what its bodies reach, and nothing else" {
  let caller = b"m.caller";
  let callee = b"m.callee";
  let apart = b"m.apart";
  let p = produce(
    [],
    [offer(caller, 0), offer(callee, 2), offer(apart, 0)],
    1,
    by_def([
      { key: caller, value: one_body(caller, [callee]) },
      { key: callee, value: headed(one_body(callee, []), word_head(2)) },
      { key: apart, value: one_body(apart, []) },
    ]),
    Map::new(),
    no_machine,
    one_each(),
  );
  let declares = |part: Bytes, name: Bytes, arity: Int|
    part.index_of(prototype(symbol_of(name), word_head(arity))) != None;
  let calling = part_holding(p.text, body_of(caller));
  assert(
    declares(calling, caller, 0) && declares(calling, callee, 2),
    Some(String::of_bytes_lossy(calling)),
  );
  assert(!declares(calling, apart, 0), Some(String::of_bytes_lossy(calling)));
  let alone = part_holding(p.text, body_of(apart));
  assert(
    !declares(alone, caller, 0) && !declares(alone, callee, 2),
    Some(String::of_bytes_lossy(alone)),
  );
  let head = head_in(p.text);
  [caller, callee, apart].fold((), |u: Unit, name: Bytes| {
    assert_eq(p.text.split(body_of(name)).len() - 1, 1);
    assert(head.index_of(symbol_of(name)) == None, None)
  })
}

test "a specialisation running a lambda another module lends sits among that module's bodies" {
  let lent = at_key(b"std.walk.each", [int_type()], [{ param: 1, owner: Named(b"m.a"), nth: 0 }]);
  assert_eq(home_of(lent), b"m");
  assert_eq(home_of(at_key(b"std.walk.each", [int_type()], [])), b"std.walk");
  let roots = [Named(b"m.a"), lent, Named(b"n.b")];
  let text = produce(
    [],
    roots.map(|k: RootKey| offer_root(k, 0)),
    1,
    roots.fold(Map::new(), |acc: Map<RootName, Answer>, k: RootKey|
      acc.insert(root_name(k), one_body(printed(k), []))),
    Map::new(),
    no_machine,
    part_rule(),
  ).text;
  // By its name alone it would sit after `n.b`.
  let at = |k: RootKey| found_at(text, body_of(printed(k)));
  assert(
    at(Named(b"m.a")) >= 0 && at(Named(b"m.a")) < at(lent) && at(lent) < at(Named(b"n.b")),
    None,
  )
}

// A call written to another head than its callee's is C two compilers disagree over silently, as
// a `Word` and an `int64_t` are one type; the unit refuses it instead.
test "a call written to another head than the callee defines fails the unit" {
  let caller = b"m.caller";
  let callee = b"m.callee";
  let expecting = |head: Head| {
    let b = one_body(caller, [callee]);
    {
      ..b,
      tables: {
        ..b.tables,
        // The callee by its place among the caller's calls, which `one_body` gives it.
        generics: { ..no_generics(), expects: [{ callee: CallAt(0), head: head }] },
      },
    }
  };
  let made = |head: Head|
    try[abort.raise] {
      produce(
        [],
        [offer(caller, 0), offer(callee, 1)],
        1,
        by_def([
          { key: caller, value: expecting(head) },
          {
            key: callee,
            value: headed(one_body(callee, []), { answer: b"double", params: [b"double"] }),
          },
        ]),
        Map::new(),
        no_machine,
        part_rule(),
      ).taken
    };
  assert_eq(made({ answer: b"double", params: [b"double"] }), Ok([callee, caller].map(def_root)));
  match made(word_head(1)) {
    Ok(_) -> assert(false, Some("a call to another head was taken")),
    Err(why) ->
      assert(
        Bytes::of_string(why).index_of(
            Bytes::concat_all([
              b"which it defines as double ",
              symbol_of(callee),
              b"(PlyCtx*, double)",
            ]),
          )
          != None,
        Some(why),
      ),
  }
}

/// The unit over `answers`, each root offered as a call and its body in a part of its own.
fn unit_of(
  answers: List<{ key: Bytes, value: Answer }>,
  inputs: Map<Bytes, Bytes>,
) -> Produced / {abort.raise} =
  produce(
    [],
    answers.map(|a: { key: Bytes, value: Answer }| offer(a.key, 0)),
    1,
    by_def(answers),
    inputs,
    no_machine,
    one_each(),
  )

/// `a` naming `defs` beside its own statics.
fn naming(a: Answer, defs: List<StaticDef>) -> Answer =
  { ..a, tables: { ..a.tables, statics: a.tables.statics.concat(defs) } }

/// How a static's definition opens.
fn static_defined(d: StaticDef) -> Bytes = Bytes::concat_all([b"const struct ", d.name, b" {"])

test "a static is defined once, in the part of the first body that names it, and declared by each other part that names it" {
  let child = statics_of(SStr(b"shared-constant")).get(0);
  let parent = named(SPlain([WAddress({ name: child.name, tag: 0 })]));
  let p = unit_of(
    [
      { key: b"m.one", value: naming(one_body(b"m.one", []), [child]) },
      { key: b"m.two", value: naming(one_body(b"m.two", []), [child, parent]) },
      { key: b"m.apart", value: one_body(b"m.apart", []) },
    ],
    Map::new(),
  );
  let one = part_holding(p.text, body_of(b"m.one"));
  let two = part_holding(p.text, body_of(b"m.two"));
  assert(found_at(p.text, one) < found_at(p.text, two), None);
  assert_eq(p.text.split(static_defined(child)).len() - 1, 1);
  assert(
    one.index_of(static_defined(child)) != None && one.index_of(static_extern(child.name)) == None,
    Some(String::of_bytes_lossy(one)),
  );
  // The later part declares the child it names, then defines the parent that addresses it.
  let declared = found_at(two, static_extern(child.name));
  assert(
    declared >= 0 && declared < found_at(two, static_defined(parent))
      && two.index_of(static_defined(child)) == None,
    Some(String::of_bytes_lossy(two)),
  );
  assert(part_holding(p.text, body_of(b"m.apart")).index_of(child.name) == None, None);
  // No static holds a field's position, so the unit has no `fields` part.
  assert_eq(part_labelled(p.text, "fields"), b"");
  // No pool: the unit says nothing of its constants to its loader.
  assert(p.text.index_of(b"consts ") == None, None)
}

test "a static holding a field's position is defined in the `fields` part, and declared where a body names it" {
  let child = statics_of(SStr(b"child")).get(0);
  let held = named(SPlain([WField(b"op"), WAddress({ name: child.name, tag: 0 })]));
  let p = unit_of(
    [{ key: b"m.f", value: naming(one_body(b"m.f", []), [child, held]) }],
    Map::new(),
  );
  let fields = part_labelled(p.text, "fields");
  let own = part_holding(p.text, body_of(b"m.f"));
  assert(
    fields.index_of(static_defined(held)) != None
      && fields.index_of(static_extern(child.name)) != None,
    Some(String::of_bytes_lossy(fields)),
  );
  assert(
    own.index_of(static_defined(child)) != None && own.index_of(static_extern(held.name)) != None,
    Some(String::of_bytes_lossy(own)),
  );
  assert_eq([child, held].map(|d: StaticDef| p.text.split(static_defined(d)).len() - 1), [1, 1])
}

test "an embedded file is laid out once from the bytes the unit is handed, raw" {
  let digest = b"\x00\xff".blake3();
  let file = [named(SFile(digest))];
  let p = unit_of(
    [
      { key: b"m.f", value: naming(one_body(b"m.f", []), file) },
      { key: b"m.g", value: naming(one_body(b"m.g", []), file) },
    ],
    Map::new().insert(digest, b"\x00\xff"),
  );
  assert_eq(p.text.split(b"\"\\000\\377\"").len() - 1, 1);
  assert(p.text.index_of(b"{ .len = 2, .room = 2 }") != None, None)
}

test "two statics of one name holding different content stop the unit" {
  let a = statics_of(SStr(b"a")).get(0);
  let forged = { name: a.name, laid: statics_of(SStr(b"b")).get(0).laid };
  let said = handle {
    unit_of(
      [
        { key: b"m.f", value: naming(one_body(b"m.f", []), [a]) },
        { key: b"m.g", value: naming(one_body(b"m.g", []), [forged]) },
      ],
      Map::new(),
    );
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert(said.starts_with(b"two statics of one name hold different content"), None)
}

test "a kept body stands only where each callee it names still has the key it was filed with" {
  let keys = by_def([{ key: b"m.b", value: b"kb" }]);
  let body = one_body(b"m.a", [b"m.b"]);
  let filed = kept_of(keys, body);
  // The body names each root it calls by its key's digest, which the store keeps once.
  let resolved = {
    let b = body;
    b.tables.calls.fold(Map::new(), |m: Map<Bytes, RootKey>, k: RootKey| m.insert(key_digest(k), k))
  };
  assert_eq(filed.callees, [Some(b"kb")]);
  assert(filed.calls.len() == 1 && filed.calls.all(|d: Bytes| d.len() == 32), None);
  assert_eq(standing_kept(keys, resolved, filed), Some(body));
  // Another tree's callee that hashes alike under another name: the C would call a name not here.
  assert_eq(standing_kept(by_def([{ key: b"m.c", value: b"kb" }]), resolved, filed), None);
  assert_eq(standing_kept(by_def([{ key: b"m.b", value: b"another" }]), resolved, filed), None);
  // A root it calls that the store keeps no more: the body is asked for again.
  assert_eq(standing_kept(keys, Map::new(), filed), None)
}

fn three_modules() -> List<Bytes> =
  [
    b"import b\nimport c\nfn f(x: Int) -> Int = b::g(x) + c::h(x)\n",
    b"import c\npub fn g(x: Int) -> Int = c::h(x) * 2\n",
    Bytes::concat_all([
      b"pub fn h(x: Int) -> Int = if even(x) { x } else { x + 1 }\n",
      b"fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n",
      b"fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n",
    ]),
  ]

fn three_modules_dump() -> Dump / {abort.raise} = {
  let texts = three_modules();
  dump_of(
    analyse(
      parse_all([
        { name: b"a", src: texts.get(0) },
        { name: b"b", src: texts.get(1) },
        { name: b"c", src: texts.get(2) },
      ]),
    ),
  )
}

test "a unit reads the modules its roots are written in and what those import, and no other" {
  let dump = three_modules_dump();
  let over = |root: Bytes| program_of(dump, three_modules(), [Named(root)]);
  let read = |root: Bytes| over(root).read.keys().filter(|m: Bytes| m != prelude_module());
  assert_eq(read(b"c.h"), [b"c"]);
  assert_eq(read(b"b.g"), [b"b", b"c"]);
  assert_eq(read(b"a.f"), [b"a", b"b", b"c"]);
  let p = over(b"b.g");
  assert_eq(p.digests.keys(), [b"b", b"c"]);
  // The scope over what `b.g` reads answers it, though the unit reads `a` too.
  let whole = program_of(dump, three_modules(), [Named(b"a.f")]);
  assert_eq(modules_asked(whole, [Named(b"b.g")]).keys(), p.read.keys());
  let scope = scope_over(dump, whole, [], [Named(b"b.g")], modules_asked(whole, [Named(b"b.g")]));
  assert_eq(
    emit::answered(scope, [Named(b"b.g")], Map::new()).map(|r: RootAnswer| root_text(r.name)),
    [b"b.g"],
  )
}

test "a scope answering a specialisation holds the module declaring a type it is at, which its definition's does not import" {
  let user = [
    { name: b"s", src: b"pub type E = | A | B\n" },
    {
      name: b"g",
      src: b"pub fn first<a>(xs: List<a>) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }\n",
    },
    {
      name: b"m",
      src: b"import g\nimport s (E)\nfn pick(xs: List<E>) -> Option<E> = g::first(xs)\n",
    },
  ];
  let dump = dump_of(analyse(parse_all(user)));
  let p = program_of(dump, sources_placed(dump, user), offered_roots(dump).keys);
  let at = at_key(b"g.first", [TyCon({ name: b"s.E", args: [] })], []);
  // A root its answer calls, written for `E`, is answered in the same scope, and `E`'s module writes it.
  assert_eq(modules_lowered([at]).keys(), [b"g"]);
  let asked = modules_asked(p, [at]);
  assert(asked.contains(b"s") && asked.contains(b"g") && !asked.contains(b"m"), None)
}

test "roots written for types are dealt apart, however many one module writes" {
  let p = program_of(
    three_modules_dump(),
    three_modules(),
    offered_roots(three_modules_dump()).keys,
  );
  let written = range(0, pieces()).map(|i: Int|
    keys::written(keys::Drop, spelled(b"a.T".concat(ascii_of_int(i))), b"a"));
  let lists = dealt(p, written.push(Named(b"a.f")));
  assert_eq(lists.len(), pieces());
  assert_eq(lists.fold(0, |n: Int, roots: List<RootKey>| n + roots.len()), pieces() + 1)
}

test "a module's definitions are dealt together, its specialisations by their definitions, each once" {
  let dump = three_modules_dump();
  let p = program_of(dump, three_modules(), offered_roots(dump).keys);
  let at = |def: Bytes, lent: List<FnArg>| at_key(def, [string_type()], lent);
  let lent = at(b"c.even", [{ param: 0, owner: Named(b"b.g"), nth: 0 }]);
  let missed = offered_roots(dump).keys.concat([at(b"c.h", []), at(b"c.odd", []), lent]);
  let lists = dealt(p, missed);
  // Fewer of them than pieces: a list each module's definitions, one each definition's
  // specialisations, and a specialisation running a lambda in place with its lender's module.
  assert_eq(lists.len(), ordered(missed.map(dealt_with)).len());
  assert_eq(dealt_with(lent), b"b");
  assert_eq(dealt_with(Named(b"c.odd")), dealt_with(Named(b"c.even")));
  assert(dealt_with(at(b"c.h", [])) != dealt_with(at(b"c.odd", [])), None);
  assert_eq(
    names_ordered(
      lists.fold([], |acc: List<RootName>, roots: List<RootKey>| acc.concat(roots.map(root_name))),
    ),
    names_ordered(missed.map(root_name)),
  );
  let together = |roots: List<RootKey>| ordered(roots.map(dealt_with));
  assert_eq(
    lists.fold(0, |n: Int, roots: List<RootKey>| n + together(roots).len()),
    together(missed).len(),
  );
  let many = range(0, 3 * pieces()).map(|i: Int|
    Named(Bytes::concat_all([b"m", ascii_of_int(i), b".f"])));
  assert_eq(dealt(p, many).len(), pieces())
}

test "a root's kept answer moves with what its module embeds, and with no other module's" {
  let dump = three_modules_dump();
  let embedding = |bytes: Bytes|
    program_of(
      {
        ..dump,
        embeds: [{ module: b"c", key: b"file:data.txt", read: Ok([embed_file(b"", bytes)]) }],
      },
      three_modules(),
      offered_roots(dump).keys,
    );
  let one = root_material(embedding(b"one"), b"", Named(b"c.h"));
  assert(one != None, None);
  assert(one != root_material(embedding(b"two"), b"", Named(b"c.h")), None);
  assert_eq(
    root_material(embedding(b"one"), b"", Named(b"a.f")),
    root_material(program_of(dump, three_modules(), offered_roots(dump).keys), b"", Named(b"a.f")),
  );
  // A specialisation's moves with its definition's, and with what each lender of a lambda it runs.
  let spec = |p: Program, lender: Bytes|
    root_material(p, b"", at_key(b"c.h", [], [{ param: 0, owner: Named(lender), nth: 0 }]));
  assert(spec(embedding(b"one"), b"a.f") != spec(embedding(b"two"), b"a.f"), None);
  assert(spec(embedding(b"one"), b"a.f") != spec(embedding(b"one"), b"b.g"), None)
}

/// A program of module `s`, declaring `E` as `cases`, and module `g`, a definition generic over its
/// list's items.
fn declaring(cases: Bytes) -> Program / {abort.raise} = {
  let texts = [
    Bytes::concat_all([b"pub type E = ", cases, b"\n"]),
    b"pub fn first<a>(xs: List<a>) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }\n",
  ];
  let dump = dump_of(
    analyse(parse_all([{ name: b"s", src: texts.get(0) }, { name: b"g", src: texts.get(1) }])),
  );
  program_of(dump, texts, offered_roots(dump).keys)
}

test "a specialisation's kept answer moves with the declaration of a type it is at, not its name alone" {
  let at = |p: Program, t: Type| root_material(p, b"", at_key(b"g.first", [t], []));
  let e = TyCon({ name: b"s.E", args: [] });
  let two = declaring(b"| A | B");
  let three = declaring(b"| A | B | C");
  assert(at(two, e) != None, None);
  assert(at(two, e) != at(three, e), None);
  assert_eq(at(two, e), at(declaring(b"| A | B"), e));
  // A type no program declares is no part of it.
  let int = int_type();
  assert_eq(at(two, int), at(three, int))
}

test "a root written from a type is kept under its module's text and the program's types" {
  let dump = three_modules_dump();
  let p = program_of(dump, three_modules(), offered_roots(dump).keys);
  let types = types_material(dump);
  let reflected = keys::written(keys::Reflect, spelled(b"{x:Int}"), b"a");
  let kept = root_material(p, types, reflected);
  assert(kept != None, None);
  assert(kept == root_material(p, types, reflected), None);
  // Another constructor anywhere, or another text of its module, moves it; a root of no module's
  // text has none.
  assert(kept != root_material(p, types_material({ ..dump, ctors: [] }), reflected), None);
  assert(
    kept
      != root_material(
        program_of(dump, three_modules().map(|s: Bytes| s.concat(b"\n")), offered_roots(dump).keys),
        types,
        reflected,
      ),
    None,
  );
  assert_eq(
    root_material(p, types, keys::written(keys::Reflect, spelled(b"{x:Int}"), b"nowhere")),
    None,
  )
}

test "a call written against a handing its callee does not publish fails the build, naming both" {
  let handing = |def: Bytes, lent: List<Bool>| { def: def_root(def), lent: lent, borrowed: None };
  let body = |handings: List<Published>, assumed: List<Published>|
    { text: b"", tables: { ..no_tables(), handings: handings, assumed: assumed } };
  // The callee publishes its parameter given; one caller was written lending it.
  let answers = by_def([
    { key: b"m.caller", value: body([], [handing(b"m.callee", [true])]) },
    { key: b"m.callee", value: body([handing(b"m.callee", [false])], []) },
    { key: b"m.fine", value: body([], [handing(b"m.callee", [false])]) },
    { key: b"m.alone", value: body([], [handing(b"m.unpublished", [false])]) },
  ]);
  let wrong = misassumed_in(answers, answers.keys());
  assert_eq(wrong.map(|m: Misassumed| m.caller), [def_root(b"m.caller")]);
  let dump = dump_of(analyse(parse_all([{ name: b"m", src: b"fn one() -> Int = 1\n" }])));
  let e = {
    produced: { text: b"", taken: [], made: { bodies: [], offered: [] } },
    roots: [],
    kept: 0,
    asked: 0,
    unserved: [],
    unbound: [],
    misassumed: wrong,
  };
  match held(dump, Ok(e)) {
    Ok(_) -> assert(false, Some("a unit holding a call against the wrong handing was held")),
    Err(diags) -> {
      assert_eq(diags.map(|d: Diag| d.code), [b"E0478"]);
      assert_eq(diags.get(0).notes_text, [
        b"`m.caller` calls `m.callee` written [lent] owned, where it publishes [given] owned",
      ])
    },
  }
}

test "a body written against a handing that moved is asked for again, with its recursion group" {
  let handing = |def: Bytes, lent: List<Bool>| { def: def_root(def), lent: lent, borrowed: None };
  let body = |handings: List<Published>, assumed: List<Published>, group: List<Bytes>|
    {
      text: b"",
      tables: { ..no_tables(), handings: handings, assumed: assumed, group: group.map(Named) },
    };
  let entries = [
    {
      key: b"m.f",
      value: body([handing(b"m.f", [true])], [handing(b"m.h", [true])], [b"m.f", b"m.g"]),
    },
    { key: b"m.g", value: body([handing(b"m.g", [false])], [], [b"m.f", b"m.g"]) },
    { key: b"m.h", value: body([handing(b"m.h", [false])], [], []) },
    { key: b"m.k", value: body([], [handing(b"m.h", [false])], []) },
    // A callee no answer publishes yet is judged once a later round answers it.
    { key: b"m.n", value: body([], [handing(b"m.absent", [true])], []) },
    { key: b"m.o", value: body([], [handing(b"m.absent", [false])], []) },
  ];
  let answers = by_def(entries);
  let keys = by_def(
    entries.map(|x: { key: Bytes, value: Answer }| { key: x.key, value: Named(x.key) }),
  );
  assert_eq(stale_of(answers, handings_held(Map::new(), answers), keys), [
    Named(b"m.f"),
    Named(b"m.g"),
  ]);
  // A kept member of a group another member of which is asked for again goes with it.
  assert_eq(
    groups_whole(answers.remove(def_root(b"m.g")), answers.keys()).keys(),
    [b"m.h", b"m.k", b"m.n", b"m.o"].map(def_root),
  )
}

test "a walk answers the roots it deals over lists, place by place, as the emitter answers them in one" {
  let dump = three_modules_dump();
  let p = program_of(dump, three_modules(), offered_roots(dump).keys);
  let missed = offered_roots(dump).keys;
  let scope = scope_over(dump, p, [], missed, modules_asked(p, missed));
  let together = answers_of(emit::answered(scope, missed, Map::new()));
  assert(
    together.fold(false, |found: Bool, _: RootName, a: Answer|
      found || a.tables.members == [Named(b"c.even"), Named(b"c.odd")]),
    None,
  );
  // Dealt apart, place by place, a call of a definition another list answers is written against the
  // handing that list published, and no root is asked for twice.
  let walk = walked(
    p,
    types_material(dump),
    program_ctors(dump, []),
    missed,
    |_: Bytes| None,
    |_: List<Record>| (),
    None,
    |_: List<RootKey>| 0,
    |asks: Int, roots: List<RootKey>, handed: Map<RootName, Handing>, done: Done| {
      let pieces = dealt(p, roots);
      let a = answers_at_once(scope, pieces, 0, pieces.len(), 64, handed, done);
      { held: asks + 1, answers: unpacked(a), found: a.found }
    },
  );
  assert(
    together.fold(true, |ok: Bool, n: RootName, a: Answer| ok && walk.answers.get(n) == Some(a)),
    None,
  );
  assert_eq(walk.asked, walk.keys.len());
  // Each module past every module it imports.
  let places = places_of(p);
  assert(
    p.imports.fold(true, |ok: Bool, m: Bytes, xs: List<Bytes>|
      ok
        && xs.all(|d: Bytes|
          match ((places.get(m), places.get(d))) { (Some(a), Some(b)) -> a > b, _ -> true })),
    None,
  )
}

test "a cold unit asks the emitter for each root once, place by place" {
  let dump = three_modules_dump();
  let every = offered_roots(dump).keys;
  // Each place asks for its roots once each: no handing moves under a body already written.
  let phases = {
    now: || 0,
    told: |t: PlaceTally|
      if t.asked == t.roots - t.kept { () } else {
        panic(
          String::of_bytes_lossy(
            Bytes::concat_all([
              b"place ",
              ascii_of_int(t.place),
              b" asked ",
              ascii_of_int(t.asked),
              b" of ",
              ascii_of_int(t.roots),
            ]),
          ),
        )
      },
  };
  let texts = three_modules();
  let sources = sources_placed(
    dump,
    range(0, texts.len()).map(|i: Int| { name: [b"a", b"b", b"c"].get(i), src: texts.get(i) }),
  );
  match emitted(
      a_runtime(b"r"),
      dump,
      sources,
      Map::new(),
      every,
      |_: Bytes| None,
      |_: List<Record>| (),
      Some(phases),
    ) {
    Ok(e) -> assert_eq((e.kept, e.misassumed), (0, [])),
    Err(why) -> assert_eq(why, b""),
  }
}

/// The units over module `m` of `source` and the prelude, whose functions what crosses a value of
/// a container is written over, each over the roots it is handed.
fn kept_unit(
  source: Bytes,
) -> { unit: (List<RootKey>) -> Emission / {abort.raise} } / {abort.raise} = {
  let user = [{ name: b"m", src: source }];
  let shipped = [{ name: b"std.prelude", src: prelude_source::text() }];
  let modules = user.concat(shipped);
  let dump = dump_of(analyse_pulling_std_with(user, shipped, no_rows()).out);
  let runtime = { ..a_runtime(b"r"), natives: program_natives([]).map(declared_signature) };
  {
    unit: |every: List<RootKey>|
      match emitted(
          runtime,
          dump,
          sources_placed(dump, modules),
          Map::new(),
          every,
          |_: Bytes| None,
          |_: List<Record>| (),
        ) {
        Ok(e) -> e,
        Err(why) -> panic(String::of_bytes_lossy(why)),
      },
  }
}

test "no root is asked to give back a scalar's box, which its last count gives back by its size" {
  let source = Bytes::concat_all([
    b"effect e {\n  write op(k: Int) -> Float\n}\n",
    b"fn listed<a>(x: a, y: a) -> List<a> = [x, y]\n",
    b"fn ints(n: Int) -> Int = match listed(n, n + 1) { [x, ..] -> x, [] -> 0 }\n",
    b"fn floats(x: Float) -> Float = match listed(x, x) { [y, ..] -> y, [] -> 0.0 }\n",
    b"fn decimals(d: Decimal) -> Int = listed(d, d).len()\n",
    b"fn wides(w: U128) -> Int = listed(w, w).len()\n",
    b"fn held(w: U128) -> Int = [{ a: w, b: \"x\" }].len()\n",
    b"fn performed(n: Int) -> Float / {e.op} = e.op(n)\n",
  ]);
  let dump = dump_of(analyse(parse_all([{ name: b"m", src: source }])));
  let every = [b"m.ints", b"m.floats", b"m.decimals", b"m.wides", b"m.held", b"m.performed"];
  let produced = match emitted(
      a_runtime(b"r"),
      dump,
      [source],
      Map::new(),
      every.map(Named),
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Ok(e) -> e.produced,
    Err(why) -> panic(String::of_bytes_lossy(why)),
  };
  let taken = produced.taken.map(root_text);
  let drop_at = |ty: Bytes| b"std.prelude.drop#".concat(ty);
  // Each list a callee made is let go of through its drop root, which lets go of its items as their
  // types lay them.
  assert_eq(
    [b"List<Int>", b"List<Float>", b"List<Decimal>", b"List<U128>"].filter(|t: Bytes|
      !taken.contains(drop_at(t))),
    [],
  );
  // A perform's descriptors of `Int` and `Float` count and let go of their word forms, their bits,
  // through the head's functions for a word of no count: no root of any scalar's type is asked, to
  // drop, count or let go of it.
  assert(produced.text.index_of(same_word_fn()) != None, None);
  assert_eq(
    taken.filter(|n: Bytes|
      [b"Int", b"Float", b"Decimal", b"U128"].any(|t: Bytes|
        [b"drop#", b"dup#", b"release#"].any(|op: Bytes| n.ends_with(op.concat(t))))),
    [],
  )
}

test "an `extern fn` no native implements, two do, or one does otherwise, is unbound" {
  let declared = |name: Bytes, words: Int, raises: Bool|
    { module: b"std.prelude", name: name, words: words, raises: raises, call: None };
  let native = |name: Bytes, words: Int, answers: Bool, raises: Bool|
    uniform_native(name, words, answers, raises);
  let found = unbound(
    [
      native(b"List::len", 1, true, false),
      native(b"assert", 2, true, true),
      native(b"twice", 1, true, false),
      native(b"twice", 1, true, false),
      native(b"wider", 2, true, false),
      native(b"silent", 1, false, false),
      native(b"calm", 1, true, false),
      native(b"undeclared", 3, true, false),
    ],
    [
      declared(b"List::len", 1, false),
      declared(b"assert", 2, true),
      declared(b"gone", 0, false),
      declared(b"twice", 1, false),
      declared(b"wider", 1, false),
      declared(b"silent", 1, false),
      declared(b"calm", 1, true),
    ],
  );
  assert_eq(found.map(|u: Unbound| { name: u.declared.name, found: u.found.len() }), [
    { name: b"gone", found: 0 },
    { name: b"twice", found: 2 },
    { name: b"wider", found: 1 },
    { name: b"silent", found: 1 },
    { name: b"calm", found: 1 },
  ]);
  assert_eq(found.map(unbound_line), [
    b"`extern fn gone` of `std.prelude`: no native of the runtime implements it",
    b"`extern fn twice` of `std.prelude`: 2 natives of the runtime implement it",
    b"`extern fn wider` of `std.prelude` takes [Word], answers Word and cannot raise, and the runtime's native takes [Word, Word], answers Word and cannot raise",
    b"`extern fn silent` of `std.prelude` takes [Word], answers Word and cannot raise, and the runtime's native takes [Word], answers nothing and cannot raise",
    b"`extern fn calm` of `std.prelude` takes [Word], answers Word and raises, and the runtime's native takes [Word], answers Word and cannot raise",
  ]);
  assert_eq(
    unbound([], [{ module: b"", name: b"?hold_take", words: 1, raises: false, call: None }]).map(
      unbound_line,
    ),
    [b"the compiler's `?hold_take`: no native of the runtime implements it"],
  );
  // A native the emitted C calls directly binds one of the kinds `compiler.emit.abi` declares, in
  // their order, not one taking as many words of other kinds.
  let crossing = |name: Bytes| { module: b"", name: name, words: 3, raises: false, call: None };
  let declared_fun = {
    name: b"?out_fun",
    params: [abi::Handed, abi::Addr, abi::I64],
    answer: None,
    raises: false,
  };
  let swapped = { ..declared_fun, params: [abi::Addr, abi::I64, abi::Handed] };
  assert_eq(unbound([declared_fun], [crossing(b"?out_fun")]), []);
  assert_eq(unbound([swapped], [crossing(b"?out_fun")]).map(unbound_line), [
    b"the compiler's `?out_fun` takes [Handed, Addr, I64], answers nothing and cannot raise, and the runtime's native takes [Addr, I64, Handed], answers nothing and cannot raise",
  ]);
  assert_eq(unbound([native(b"?out_fun", 3, false, false)], [crossing(b"?out_fun")]).len(), 1)
}

/// The unit of a program of `user` modules and the `shipped` ones they import, held against a
/// runtime of `natives`.
fn held_over(
  user: List<{ name: Bytes, src: Bytes }>,
  shipped: List<{ name: Bytes, src: Bytes }>,
  natives: List<Native>,
) -> Result<Bytes, List<Diag>> / {abort.raise} = {
  let dump = dump_of(analyse_pulling_std_with(user, shipped, no_rows()).out);
  let every = offered_roots(dump).keys;
  held(
    dump,
    emitted(
      { ..a_runtime(b"r"), natives: natives },
      dump,
      sources_placed(dump, user.concat(shipped)),
      Map::new(),
      every,
      |_: Bytes| None,
      |_: List<Record>| (),
    ),
  )
}

/// The texts of `modules`, and the prelude's where none of them is it, at the places `dump` gives
/// them.
fn sources_placed(dump: Dump, modules: List<{ name: Bytes, src: Bytes }>) -> List<Bytes> = {
  let texts = modules.fold(
    Map::new().insert(prelude_module(), prelude_source::text()),
    |acc: Map<Bytes, Bytes>, s: { name: Bytes, src: Bytes }| acc.insert(s.name, s.src),
  );
  let indexed = dump.modules.fold(Map::new(), |acc: Map<Int, Bytes>, m: ModuleRow|
    acc.insert(m.index, match texts.get(m.name) { Some(t) -> t, None -> b"" }));
  range(0, indexed.len()).map(|i: Int| match indexed.get(i) { Some(t) -> t, None -> b"" })
}

fn refusal(r: Result<Bytes, List<Diag>>) -> List<Bytes> =
  match r {
    Ok(_) -> [],
    Err(diags) -> diags.fold([], |acc: List<Bytes>, d: Diag| acc.push(d.code).concat(d.notes_text)),
  }

/// What a unit made of `emission` says first: the code, and its message.
fn first_said(emission: Result<Emission, Bytes>, dump: Dump) -> List<Bytes> / {abort.raise} =
  match held(dump, emission) {
    Ok(_) -> [],
    Err(diags) -> match diags.at(0) { Some(d) -> [d.code, d.message], None -> [] },
  }

test "a root the emitter answers nothing for stops its unit as Ply's own failure" {
  let user = [{ name: b"m", src: b"fn one() -> Int = 1\nfn two() -> Int = one() + 1\n" }];
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  let runtime = { ..a_runtime(b"r"), natives: declared_natives().map(declared_signature) };
  let said = first_said(
    emitted(
      runtime,
      dump,
      sources_placed(dump, user),
      Map::new(),
      [b"m.one", b"m.absent", b"m.two"].map(Named),
      |_: Bytes| None,
      |_: List<Record>| (),
    ),
    dump,
  );
  assert_eq(said.at(0), Some(b"E0505"));
  assert(
    said.any(|n: Bytes| n.index_of(b"the emitter answered nothing for `m.absent`") != None),
    Some(String::of_bytes_lossy(Bytes::join(said, b"\n"))),
  )
}

test "each root a program offers is keyed by the row that says what it is, and prints as offered" {
  let user = [
    {
      name: b"m",
      src: Bytes::concat_all([
        b"fn f(x: Int) -> Int requires x > 0 ensures result > 0 = x\n",
        b"fn none<a>() -> List<a> ensures result.len() == 0 = []\n",
        b"test \"t\" for n: Int in [1] { assert(n > 0) }\n",
        b"law \"l\" forall (x: Int) where x > 0 { x + 1 > x }\n",
        b"law \"s\" forall (x: a) { x == x }\n",
      ]),
    },
  ];
  // What a test over cases reads its table through.
  let cases = {
    name: b"std.cases",
    src: Bytes::concat_all([
      b"pub type Table<a> = List<a>\n",
      b"pub type Listed = { label: String, identity: Bytes }\n",
      b"pub fn listed<a | e>(table: List<a>, label: (a) -> String / e) -> List<Listed> / {abort.raise | e} = table.map(|c: a| { label: label(c), identity: b\"\" })\n",
      b"pub fn chosen<a>(table: List<a>, at: Int, wanted: Bytes) -> a / {abort.raise} = match table.at(at) { Some(c) -> c, None -> panic(\"no case\") }\n",
    ]),
  };
  let dump = dump_of(analyse_pulling_std_with(user, [cases], no_rows()).out);
  let offers = offered_roots(dump);
  assert_eq(offers.unkeyed, []);
  assert_eq(offers.keys.map(printed), dump.emitter_roots.map(|r: EmitterRoot| r.root));
  assert_eq(offers.keys.filter(|k: RootKey| module_of(k) == b"m"), [
    Named(b"m.f"),
    Named(b"m.none"),
    test_key(b"m", b"t"),
    Clause({ def: Named(b"m.f"), kind: Requires, n: 0 }),
    Clause({ def: Named(b"m.f"), kind: Ensures, n: 0 }),
    Clause({ def: Named(b"m.none"), kind: Ensures, n: 0 }),
    Cases(test_key(b"m", b"t")),
    law_key(b"m", b"l", LawGuard),
    law_key(b"m", b"l", LawBody),
    law_key(b"m", b"s", LawBody),
  ]);
  // A judge enters a clause and a law's guard and body as the runtime enters a definition, a
  // generic one's at the specialisation it is judged at; a law over a type variable is proved over
  // its sort, never entered.
  let p = program_of(dump, sources_placed(dump, user.concat([cases])), offers.keys);
  let mine = offers.keys.filter(|k: RootKey| module_of(k) == b"m");
  assert_eq(
    mine.filter(|k: RootKey| entered_root(p, k)),
    mine.filter(|k: RootKey| k != law_key(b"m", b"s", LawBody)),
  )
}

test "a constant that may raise keeps its entry, which the unit's code table names, past the word it is handed for the raise" {
  let user = [
    {
      name: b"m",
      src: Bytes::concat_all([
        b"pub fn limit() -> Int / {abort.raise} = if 2 > 3 { abort.raise(\"never\") } else { 7 }\n",
        b"pub fn twice() -> Int / {abort.raise} = limit() + limit()\n",
      ]),
    },
  ];
  let dump = dump_of(analyse(parse_all(user)));
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_placed(dump, user),
      Map::new(),
      offered_roots(dump).keys,
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(e) -> {
      let text = e.produced.text;
      let said = Some(String::of_bytes_lossy(text));
      assert(
        text.index_of(Bytes::concat_all([b"(void *)&", entry_of(b"m.limit"), b",\n"])) != None,
        said,
      );
      assert(text.index_of(b"(void *)&,") == None && text.index_of(b"extern char ;") == None, said)
    },
  }
}

