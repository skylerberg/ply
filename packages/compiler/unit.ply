  };
  let dump = dump_of(analyse_pulling_std_with(user, [fact], no_rows()).out);
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_in_order(dump, user.concat([fact])),
      Map::new(),
      requested_roots(dump).keys,
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(e) -> {
      assert(
        e.produced.taken.any(|n: RootName| root_text(n).starts_with(b"std.fact.served")),
        Some(String::of_bytes_lossy(Bytes::join(e.produced.taken.map(root_text), b", "))),
      );
      assert_eq(bridged_in(unit_text(e.produced.parts), test_key(b"m", b"asks")), b"")
    },
  }
}

test "a clause over a function its definition returns has no entry, as a function is only marshalled out" {
  let user = [
    {
      name: b"m",
      src: b"pub fn adder(n: Int) -> (Int) -> Int ensures result(1) == n + 1 = |x: Int| x + n\n",
    },
  ];
  let dump = dump_of(analyse(parse_all(user)));
  let p = program_of(dump, sources_in_order(dump, user), requested_roots(dump).keys);
  assert(runtime_enters(p, Named(b"m.adder")), None);
  assert(!runtime_enters(p, Clause({ definition: Named(b"m.adder"), kind: Ensures, n: 0 })), None)
}

test "a root the front end offers with no typed row to key it by is an internal error" {
  let user = [{ name: b"m", src: b"fn one() -> Int = 1\nfn two() -> Int = one() + 1\n" }];
  let whole = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  let dump = {
    ..whole,
    definitions: whole.definitions.filter(|d: DefinitionRow| d.name != b"m.one"),
  };
  let offers = requested_roots(dump);
  assert_eq(offers.unkeyed, [b"m.one"]);
  let runtime = { ..a_runtime(b"r"), natives: declared_natives().map(declared_signature) };
  let made = |offered: List<RootKey>|
    emitted(
      runtime,
      dump,
      sources_in_order(dump, user),
      Map::new(),
      offered,
      |_: Bytes| None,
      |_: List<Record>| (),
    );
  [offers.keys, []].fold((), |_: Unit, offered: List<RootKey>| {
    let said = first_said(made(offered), dump);
    assert_eq(said.at(0), Some(b"E0505"));
    assert(
      said.any(|n: Bytes| n.index_of(b"offered `m.one` with no typed effects") != None),
      Some(String::of_bytes_lossy(Bytes::join(said, b"\n"))),
    )
  })
}

test "a unit tells each place it walks to a build's phases as it ends, in the places' order" {
  let user = [{ name: b"m", src: b"fn one() -> Int = 1\nfn two() -> Int = one() + 1\n" }];
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  with_body_store(|| {
    let told = |r: LevelTally|
      body_store.put([
        {
          key: ascii_of_int(r.place),
          bytes: Bytes::concat_all(range(0, r.asked).map(|_: Int| b"x")),
        },
        { key: b"places", bytes: ascii_of_int(r.places) },
        {
          key: b"told",
          bytes: (match body_store.get(b"told") { Some(b) -> b, None -> b"" }).concat(
            Bytes::concat_all([ascii_of_int(r.place), b","]),
          ),
        },
      ]);
    match emitted(
        a_runtime(b"r"),
        dump,
        sources_in_order(dump, user),
        Map::new(),
        [Named(b"m.one"), Named(b"m.two")],
        |_: Bytes| None,
        |_: List<Record>| (),
        phases: Some({ now: || 0, outcome: told }),
      ) {
      Err(reason) -> panic(String::of_bytes_lossy(reason)),
      Ok(e) -> {
        let said = match body_store.get(b"told") { Some(b) -> b.split(b","), None -> [] };
        let order = said.filter(|p: Bytes| p.len() > 0).map(|p: Bytes| digits(p));
        assert(
          order.len() > 0 && range(1, order.len()).all(|i: Int| order.get(i - 1) < order.get(i)),
          None,
        );
        assert_eq(
          match body_store.get(b"places") { Some(b) -> digits(b), None -> 0 },
          order.get(order.len() - 1) + 1,
        );
        assert_eq(
          order.fold(0, |n: Int, l: Int|
            n + (match body_store.get(ascii_of_int(l)) { Some(v) -> v.len(), None -> 0 })),
          e.asked,
        )
      },
    }
  })
}

test "a unit is rejected where the runtime does not implement a native it calls as declared, and not for one it never calls" {
  let program = [
    {
      name: b"m",
      src: b"fn digest(b: Bytes) -> Bytes = b.blake3()\nfn plus<a>(x: a, y: a) -> a where numeric(a) = x + y\n",
    },
  ];
  let implemented = declared_natives().map(declared_signature);
  let taking = |name: Bytes, words: Int|
    implemented.map(|n: Native|
      if n.name == name { word_native(name, words, n.result != None, n.raises) } else { n });
  assert_eq(
    match unit_against_runtime(program, [], implemented) {
      Ok(c) -> c.index_of(b"builtin_elaborated_blake3_p(ctx") != None,
      Err(_) -> false,
    },
    true,
  );
  assert_eq(rejection_codes(unit_against_runtime(program, [], implemented)), []);
  assert_eq(
    rejection_codes(
      unit_against_runtime(
        program,
        [],
        taking(b"Secret::verify", 9).filter(|n: Native| n.name != b"Secret::is_empty"),
      ),
    ),
    [],
  );
  assert_eq(rejection_codes(unit_against_runtime(program, [], taking(b"?numeric_binary", 5))), []);
  assert_eq(rejection_codes(unit_against_runtime(program, [], taking(b"Map::new", 3))), []);
  let rejected = rejection_codes(unit_against_runtime(program, [], taking(b"?blake3", 1)));
  assert_eq(rejected.at(0), Some(b"E0476"));
  assert_eq(
    rejected.at(1),
    Some(
      b"the compiler's `?blake3` takes [Addr, I64], returns I64 and cannot raise, and the runtime's native takes [Word], returns Word and cannot raise",
    ),
  );
  let twice = implemented.concat(implemented.filter(|n: Native| n.name == b"?blake3"));
  assert_eq(
    rejection_codes(unit_against_runtime(program, [], twice)).at(1),
    Some(b"the compiler's `?blake3`: 2 natives of the runtime implement it"),
  )
}

test "a unit whose bodies write externs in place asks the runtime for no native of them" {
  let implemented = program_natives([]).map(declared_signature);
  let names = implemented.map(|n: Native| n.name);
  assert_eq(
    intrinsics().filter(|i: { name: Bytes, op: Intrinsic }|
      names.contains(i.name.slice(b"std.prelude.".len(), i.name.len()))).len(
    ),
    0,
  );
  let calls = b"\npub fn pushed(xs: List<Int>) -> List<Int> = xs.push(1)\npub fn emptied(m: Map<Int, Int>) -> Map<Int, Int> = MapNode::map_swap(m, None, 0, 0).map\n";
  let program = [{ name: b"std.prelude", src: prelude_source::text().concat(calls) }];
  match unit_against_runtime(program, [], implemented) {
    Ok(c) -> {
      let asked = intrinsics().map(|i: { name: Bytes, op: Intrinsic }|
        builtin_helper(i.name.slice(b"std.prelude.".len(), i.name.len())).concat(b"_p(ctx, "));
      assert_eq(asked.filter(|t: Bytes| c.index_of(t) != None), [])
    },
    Err(diagnostics) -> assert_eq(diagnostics.map(|d: Diagnostic| d.code), []),
  }
}

test "a unit is rejected where its runtime binds a helper or lays out what its code reads otherwise than the compiler declares" {
  let user = [{ name: b"m", src: b"fn one() -> Int = 1\n" }];
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  let every = requested_roots(dump).keys;
  let over = |runtime: Runtime|
    rejection_codes(
      unit_parts(
        dump,
        emitted(
          runtime,
          dump,
          sources_in_order(dump, user),
          Map::new(),
          every,
          |_: Bytes| None,
          |_: List<Record>| (),
        ),
      ),
    );
  let r = a_runtime(b"r");
  assert_eq(over(r), []);
  let moved = { ..r, facts: r.facts.insert(b"PlyCtx.frames.at", 72) };
  let rejected = over({
    ..moved,
    helpers: moved.helpers.filter(|n: Native| n.name != b"rt_release_drain"),
  });
  assert_eq(rejected, [
    b"E0481",
    b"the runtime has no helper `rt_release_drain`, which emitted code calls",
    b"the runtime lays out `PlyCtx.frames.at` as 72, where this compiler declares 64",
    runtime_rejected([]).notes_text.get(0),
  ]);
  assert_eq(over({ ..moved, natives: [] }).at(0), Some(b"E0481"))
}

fn identifier_bytes() -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(48, 58).concat(range(65, 91)).push(95).concat(range(97, 123)).map(byte_of_int),
  )

fn pointers_named(
  text: Bytes,
  prefix: Bytes,
  into: Map<Bytes, Bool>,
) -> Map<Bytes, Bool> / {abort.raise} =
  iterate({ from: 0, found: into }, text.len() + 1, |s: { from: Int, found: Map<Bytes, Bool> }|
    match text.index_of_from(prefix, s.from) {
      None -> Stop(s.found),
      Some(at) -> {
        let end = text.scan(at, identifier_bytes(), text.len() - at);
        let name = text.slice(at, end);
        let opens = at == 0 || identifier_bytes().index_of_byte(text.at(at - 1)) == None;
        Continue({
          from: end,
          found: if opens && name.ends_with(b"_p") {
            s.found.insert(name.slice(0, name.len() - 2), true)
          } else { s.found },
        })
      },
    })

fn sample_unit() -> Emission / {abort.raise} =
  unit_builder(
    Bytes::concat_all([
      b"effect e {\n  write op(k: Int) -> Int\n}\n",
      b"effect oops {\n  raise boom(n: Int)\n}\n",
      b"fn bang(n: Int) -> Int / {oops.boom} = if n > 0 { oops.boom(n) } else { n }\n",
      b"fn caught(n: Int) -> Int = handle { bang(n) } with { oops.boom(k) -> k + 1 }\n",
      b"type Shape = | Dot | Line(Int)\n",
      b"fn handled() -> Int = handle { e.op(1) } with { var n = 0, e.op(k) -> { n = k; n }, return x -> x + n }\n",
      b"fn decimals(d: Decimal) -> Decimal = d * d + d\n",
      b"fn floats(x: Float) -> Float = x.sqrt()\n",
      b"fn texts(s: String) -> Int = (s ++ s).len()\n",
      b"fn listed(xs: List<Int>) -> List<Int> = xs.map(|x: Int| x + 1)\n",
      b"fn shaped(n: Int) -> Shape = if n > 0 { Line(n) } else { Dot }\n",
      b"fn width(s: Shape) -> Int = match s { Line(n) -> n, Dot -> 0 }\n",
      b"fn table() -> List<Int> = [1, 2]\n",
      b"fn read() -> Int = table().len()\n",
      b"fn sum(f: (Int) -> Int, n: Int) -> Int = if n <= 0 { 0 } else { f(n) + sum(f, n - 1) }\n",
      b"fn one() -> Int = sum(|x: Int| x, 3)\n",
      b"fn two() -> Int = sum(|x: Int| x, 4)\n",
      b"type Length = | Metres(Int) | Millimetres(Int)\n",
      b"key for Length by millimetres\n",
      b"numeric for Length by { add: plus, sub: minus, mul: times, neg: negated, of_int: metres }\n",
      b"fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }\n",
      b"fn plus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) + millimetres(b))\n",
      b"fn minus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) - millimetres(b))\n",
      b"fn times(a: Length, b: Length) -> Length = Millimetres(millimetres(a) * millimetres(b))\n",
      b"fn negated(a: Length) -> Length = Millimetres(0 - millimetres(a))\n",
      b"fn metres(n: Int) -> Length = Metres(n)\n",
      b"fn total<a>(xs: List<a>) -> a where numeric(a) = xs.fold(numeric_of_int(0), |s: a, x: a| s + x)\n",
      b"fn all(xs: List<Length>) -> Length = total(xs)\n",
    ]),
  ).unit(
    [
      b"m.handled",
      b"m.caught",
      b"m.decimals",
      b"m.floats",
      b"m.texts",
      b"m.listed",
      b"m.shaped",
      b"m.width",
      b"m.read",
      b"m.one",
      b"m.two",
      b"m.all",
    ].map(
      Named,
    ),
  )

test "the natives a body reports are the ones its C calls through a pointer" {
  let bodies = sample_unit().produced.made.bodies;
  let scanned = |k: UnitBody|
    k.tables.shared.fold(
      pointers_named(k.text, b"builtin_", Map::new()),
      |m: Map<Bytes, Bool>, f: SharedFn| pointers_named(f.text, b"builtin_", m),
    ).keys(
    );
  assert_eq(
    bodies.filter(|k: UnitBody| sorted_unique(k.tables.natives) != scanned(k)).map(|k: UnitBody|
      root_text(k.name)),
    [],
  );
  assert(bodies.any(|k: UnitBody| k.tables.natives.len() > 0), None)
}

test "the holes a body reports are the ones its C holds that its part's table places" {
  let bodies = sample_unit().produced.made.bodies;
  let scanned = |k: UnitBody|
    sorted_unique(
      holes(k.text).filter(|h: Hole| ![114, 115, 103].contains(h.kind)).map(|h: Hole|
        keyed_key(keyed_of(h), k.tables)),
    );
  let reported = |k: UnitBody| sorted_unique(k.tables.keyed.map(|x: Keyed| keyed_key(x, k.tables)));
  assert_eq(
    bodies.filter(|k: UnitBody| reported(k) != scanned(k)).map(|k: UnitBody| root_text(k.name)),
    [],
  );
  let all = bodies.fold([], |acc: List<Bytes>, k: UnitBody| acc.concat(reported(k)));
  assert_eq([84, 102, 108].filter(|kind: Int| !all.any(|key: Bytes| key.at(0) == kind)), [])
}

test "a part reads as it would were each root its bodies define written as its symbol" {
  let made = sample_unit().produced.made;
  let constructors = sorted_unique(
    made.bodies.fold([], |acc: List<Bytes>, k: UnitBody|
      k.tables.keyed.fold(acc, |a: List<Bytes>, x: Keyed|
        match x { KeyedTag(n) -> a.push(n), _ -> a })),
  ).map(|n: Bytes| { name: n, arity: 0 });
  let unit = |texts: List<Bytes>|
    fresh(
      constructors,
      made.requested,
      1,
      results_by_name(
        range(0, made.bodies.len()).map(|i: Int| {
          let k = made.bodies.get(i);
          { name: k.name, result: { text: texts.get(i), tables: k.tables } }
        }),
      ),
      Map::new(),
      no_machine,
      one_each(),
    ).text;
  let symbol = |n: RootName| symbol_of(root_text(n));
  let spelled_out = |k: UnitBody| {
    let members = k.tables.members.map(root_name);
    Bytes::join(
      range(0, members.len()).fold(k.text, |t: Bytes, i: Int|
        Bytes::join(t.split(own_symbol(Some(i))), symbol(members.get(i)))).split(
        own_symbol(None),
      ),
      symbol(own_root(k)),
    )
  };
  let resolved = made.bodies.map(|k: UnitBody|
    match made.named.get(k.name) {
      Some(roots) -> { ..k, text: placeholders_named(k.text, roots) },
      None -> k,
    });
  let written = unit(resolved.map(|k: UnitBody| k.text));
  assert(resolved.any(|k: UnitBody| k.text.index_of(own_symbol(None)) != None), None);
  assert_eq(written.index_of(b"@@"), None);
  assert_eq(written, unit(resolved.map(spelled_out)))
}

test "specialisations whose bodies differ only in their names, each calling itself, compile as one code" {
  let source = Bytes::concat_all([
    b"fn sum(f: (Int) -> Int, n: Int) -> Int = if n <= 0 { 0 } else { f(n) + sum(f, n - 1) }\n",
    b"fn one() -> Int = sum(|x: Int| x, 3)\n",
    b"fn two() -> Int = sum(|x: Int| x, 4)\n",
  ]);
  match built([{ name: b"m", src: source }]) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(e) -> {
      let specialisations = e.roots.filter(|k: RootKey|
        match k { Specialisation(a, _) -> a.definition == b"m.sum", _ -> false });
      let codes = e.produced.taken.filter(|n: RootName| root_text(n).starts_with(b"m.sum@="));
      assert_eq([specialisations.len(), codes.len()], [2, 1]);
      assert(
        specialisations.all(|k: RootKey|
          unit_text(e.produced.parts).index_of(symbol_of(printed(k))) != None),
        None,
      )
    },
  }
}

test "every function a unit's C calls through a pointer is one the unit binds" {
  let k = unit_builder(
    Bytes::concat_all([
      b"effect e {\n  write op(k: Int) -> Int\n}\n",
      b"fn handled() -> Int = handle { e.op(1) } with { var n = 0, e.op(k) -> { n = k; n }, return x -> x + n }\n",
      b"fn decimals(d: Decimal) -> Decimal = d * d + d\n",
      b"fn wides(w: U128) -> U128 = w * w\n",
      b"fn floats(x: Float) -> Float = x.sqrt()\n",
      b"fn texts(s: String) -> Int = (s ++ s).len()\n",
      b"fn listed(xs: List<Int>) -> List<Int> = xs.map(|x: Int| x + 1)\n",
    ]),
  );
  let roots = [b"m.handled", b"m.decimals", b"m.wides", b"m.floats", b"m.texts", b"m.listed"];
  let text = unit_text(k.unit(roots.map(Named)).produced.parts);
  let declared = bound_functions().fold(Map::new(), |acc: Map<Bytes, Bool>, n: Native|
    acc.insert(n.name, true));
  let named = pointers_named(text, b"rt_", pointers_named(text, b"builtin_", Map::new()));
  assert_eq(named.keys().filter(|n: Bytes| !declared.contains(n)), []);
  assert(named.contains(b"rt_alloc_bytes") && named.contains(b"builtin_elaborated_out_int"), None)
}

test "a unit is rejected where the runtime implements a shipped module's `extern fn` it calls otherwise" {
  let native = [
    {
      name: b"std.native",
      src: b"pub extern fn counted(x: Int) -> Int\npub extern fn named(id: Int) -> String\n",
    },
  ];
  let program = [
    {
      name: b"m",
      src: b"import std.native (counted, named)\nfn f() -> Int = counted(1)\nfn g() -> String = named(7)\n",
    },
  ];
  let count_line = |params: List<Machine>|
    { name: b"counted", params: params, result: Some(abi::I64), raises: false };
  let named = |result: Machine|
    { name: b"named", params: [abi::I64], result: Some(result), raises: false };
  let implemented = |a: Native, b: Native|
    declared_natives().map(declared_signature).push(a).push(b);
  assert_eq(
    rejection_codes(
      unit_against_runtime(program, native, implemented(count_line([abi::I64]), named(abi::Taken))),
    ),
    [],
  );
  assert_eq(
    rejection_codes(
      unit_against_runtime(
        program,
        native,
        implemented(count_line([abi::I64, abi::I64]), named(abi::Taken)),
      ),
    ),
    [
      b"E0476",
      b"`extern fn counted` of `std.native` takes [I64], returns I64 and cannot raise, and the runtime's native takes [I64, I64], returns I64 and cannot raise",
      natives_rejected([]).notes_text.get(0),
    ],
  );
  assert_eq(
    rejection_codes(
      unit_against_runtime(program, native, implemented(count_line([abi::I64]), named(abi::I64))),
    ),
    [
      b"E0476",
      b"`extern fn named` of `std.native` takes [I64], returns Taken and cannot raise, and the runtime's native takes [I64], returns I64 and cannot raise",
      natives_rejected([]).notes_text.get(0),
    ],
  )
}

test "a unit declares a shipped module's native over machine words where a part calls it, and binds it after the rest" {
  let native = [
    {
      name: b"std.native",
      src: b"pub extern fn named(id: Int, sep: String) -> String\npub extern fn told(on: Bool, x: Float, c: Char, w: U8) -> Char\npub extern fn noted(b: Bytes) -> Unit\n",
    },
  ];
  let program = [
    {
      name: b"m",
      src: b"import std.native (named, told, noted)\nfn g() -> String = named(7, \"-\")\nfn h() -> Char = told(true, 1.5, 'a', 3u8)\nfn k() -> Unit = noted(b\"x\")\n",
    },
  ];
  let named = {
    name: b"named",
    params: [abi::I64, abi::Addr, abi::I64],
    result: Some(abi::Taken),
    raises: false,
  };
  let told = {
    name: b"told",
    params: [abi::I64, abi::F64, abi::I64, abi::I64],
    result: Some(abi::I64),
    raises: false,
  };
  let noted = { name: b"noted", params: [abi::Addr, abi::I64], result: None, raises: false };
  match unit_against_runtime(
      program,
      native,
      declared_natives().map(declared_signature).push(named).push(told).push(noted),
    ) {
    Err(diagnostics) -> assert_eq(diagnostics.map(|d: Diagnostic| d.code), []),
    Ok(text) -> {
      let pointer = b"Word (*builtin_named_p)(PlyCtx*, Word, Word, Word)";
      assert(text.index_of(b"builtin_named_p(ctx, ") != None, None);
      assert_eq(text.split(b"extern ".concat(pointer)).len(), 2);
      assert(text.index_of(pointer.concat(b";\n")) != None, None);
      assert(
        text.index_of(
            Bytes::concat_all([
              b"builtin_named_p = (Word (*)(PlyCtx*, Word, Word, Word))fns[",
              ascii_of_int(bound_functions().len()),
              b"]",
            ]),
          )
          != None,
        None,
      );
      assert(text.index_of(b"builtin_named 3 1") != None, None);
      assert(
        text.index_of(b"extern Word (*builtin_told_p)(PlyCtx*, Word, Word, Word, Word);\n") != None,
        None,
      );
      assert(
        text.index_of(b"extern void (*builtin_noted_p)(PlyCtx*, Word, Word);\n") != None,
        None,
      );
      assert(text.index_of(b"builtin_noted 2 0") != None, None)
    },
  }
}

test "a function of a type a module calls with no import is read from its home, which the emitter is handed" {
  let user = [{ name: b"m", src: b"fn first(xs: List<Int>) -> Int / {abort.raise} = xs.get(0)\n" }];
  let shipped = [
    {
      name: b"std.list",
      src: b"pub fn List::get<a>(xs: List<a>, i: Int) -> a / {abort.raise} = match xs.at(i) { Some(x) -> x, None -> panic(\"no element there\") }\n",
    },
  ];
  let dump = dump_of(analyse_pulling_std_with(user, shipped, no_rows()).out);
  let root = Named(b"m.first");
  let p = program_of(dump, sources_in_order(dump, user.concat(shipped)), [root]);
  let places = module_levels(p);
  assert(
    match ((places.get(b"m"), places.get(b"std.list"))) { (Some(a), Some(b)) -> a > b, _ -> false },
    None,
  );
  let modules = modules_asked(p, [root]);
  assert(modules.contains(b"std.list"), None);
  assert_eq(
    emit::root_outputs(scope_of_modules(dump, p, [], [root], modules), [root], Map::new()).map(
      |r: RootOutput| root_text(r.name),
    ),
    [b"m.first"],
  )
}

test "a module's row names the home and the scheduler it reads with no import, which a unit reads with it" {
  let user = [
    {
      name: b"m",
      src: b"pub fn first(xs: List<Int>) -> Int / {abort.raise, task.write} = {\n  task.yield();\n  xs.get(0)\n}\n",
    },
    { name: b"n", src: b"import m\npub fn one() -> Int = 1\n" },
  ];
  let shipped = [
    {
      name: b"std.list",
      src: b"pub fn List::get<a>(xs: List<a>, i: Int) -> a / {abort.raise} = match xs.at(i) { Some(x) -> x, None -> panic(\"no element there\") }\n",
    },
    { name: b"std.internal.schedule", src: b"pub fn idle() -> Int = 0\n" },
  ];
  let dump = dump_of(analyse_pulling_std_with(user, shipped, no_rows()).out);
  let unimported = |module: Bytes|
    dump.modules.filter(|row: ModuleRow| row.name == module).map(|row: ModuleRow| row.unimported);
  assert_eq(unimported(b"m"), [[b"std.list", b"std.internal.schedule"]]);
  assert_eq(unimported(b"n"), [[]]);
  let p = program_of(dump, sources_in_order(dump, user.concat(shipped)), [Named(b"m.first")]);
  assert_eq(p.read.keys(), [b"m", b"std.internal.schedule", b"std.list", prelude_module()])
}

test "a law's body over a sort it leaves uninterpreted is lowered as a generic body as it stands" {
  let user = [
    {
      name: b"m",
      src: b"fn pair<a>(x: a) -> a = x\n\nlaw \"identity is identity\"\n  forall (x: a) {\n    pair(x) == x\n  }\n",
    },
  ];
  let dump = dump_of(analyse(parse_all(user)));
  let root = law_key(b"m", b"identity is identity", LawBody);
  let p = program_of(dump, sources_in_order(dump, user), [root]);
  assert_eq(
    emit::root_outputs(
      scope_of_modules(dump, p, [], [root], modules_asked(p, [root])),
      [root],
      Map::new(),
    ).map(|r: RootOutput| root_text(r.name)),
    [printed(root)],
  )
}

test "a unit asks the emitter for a root a kept body names, though the body's definition has moved" {
  let borrowing = b"fn each(n: Int, f: (Int) -> Int, i: Int, acc: Int) -> Int = if i >= n { acc } else { each(n, f, i + 1, acc + f(i)) }\nfn total(n: Int, f: (Int) -> Int) -> Int = each(n, f, 0, 0)\nfn scaled(n: Int, k: Int) -> Int = total(n, |x: Int| x * k)\n";
  let runtime = a_runtime(b"r");
  with_body_store(|| {
    let unit = |source: Bytes|
      match emitted(
          runtime,
          dump_of(analyse(parse_all([{ name: b"m", src: source }]))),
          [source],
          Map::new(),
          [b"m.each", b"m.total", b"m.scaled"].map(Named),
          |k: Bytes| body_store.get(k),
          |rs: List<Record>| body_store.put(rs),
        ) {
        Ok(e) -> e,
        Err(reason) -> panic(String::of_bytes_lossy(reason)),
      };
    assert_eq(unit(borrowing).cached, 0);
    let result = |k: Bytes| k.starts_with(result_record_key(b""));
    let body = |k: Bytes| k.starts_with(body_key(b""));
    let scaled = |k: Bytes, v: Bytes|
      k.starts_with(result_record_key(b"m.scaled\x00"))
        && (match bin::decode(v, cached_result_bin()) {
          Ok(recorded) -> !recorded.calls.contains(key_digest(Named(b"m.scaled"))),
          Err(_) -> false,
        });
    let all = body_store.all();
    let cached = all.fold(Map::new(), |acc: Map<Bytes, Bytes>, k: Bytes, v: Bytes|
      if result(k) && scaled(k, v) { acc.insert(k, v) } else { acc });
    let bodies = cached.keys().map(|k: Bytes|
      body_key(k.slice(result_record_key(b"").len(), k.len())));
    body_store.replace(
      all.fold(Map::new(), |acc: Map<Bytes, Bytes>, k: Bytes, v: Bytes|
        if (!result(k) && !body(k)) || cached.contains(k) || bodies.contains(k) { acc.insert(k, v) }
        else { acc }),
    );
    assert_eq(body_store.all().keys().filter(result).len(), 1);
    let moved = unit(
      b"// a comment, and a definition, above them\nfn aside() -> Int = 7\n".concat(borrowing),
    );
    assert_eq(moved.cached, 1);
  })
}

effect body_store {
  read get(k: Bytes) -> Option<Bytes>
  write put(records: List<Record>) -> Unit
  read all() -> Map<Bytes, Bytes>
  write replace(m: Map<Bytes, Bytes>) -> Unit
}

fn with_body_store<a | e>(
  body: () -> a / {body_store.get, body_store.put, body_store.all, body_store.replace | e},
) -> a / e =
  handle {
    body()
  } with {
    var store: Map<Bytes, Bytes> = Map::new(),
    body_store.get(k) -> store.get(k),
    body_store.put(records) -> {
      store = records.fold(store, |m: Map<Bytes, Bytes>, r: Record| m.insert(r.key, r.bytes));
    },
    body_store.all() -> store,
    body_store.replace(m) -> {
      store = m;
    },
  }

fn unit_in_file_store<[r]>(
  user: List<{ name: Bytes, src: Bytes }>,
  told: keep (LevelTally) -> Unit / {abort.raise},
) -> Emission / {fs.read[r], fs.write[r], abort.raise} = {
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  with_record_store[r, ans]("s", ||
    match emitted(
        a_runtime(b"r"),
        dump,
        sources_in_order(dump, user),
        Map::new(),
        requested_roots(dump).keys,
        |k: Bytes| record_store.get[ans](k),
        |rs: List<Record>| record_store.put[ans](rs),
        phases: Some({ now: || 0, outcome: told }),
      ) {
      Ok(e) -> e,
      Err(reason) -> panic(String::of_bytes_lossy(reason)),
    })
}

fn unit_on_tree(
  tree: fs::MemFs,
  user: List<{ name: Bytes, src: Bytes }>,
) -> fs::MemResult<Emission> / {abort.raise} =
  fs::on_mem[abs](tree, || unit_in_file_store[abs](user, ignore_tally))

fn store_files(tree: fs::MemFs) -> List<{ name: String, size: Int }> / {abort.raise} =
  match fs::listed_names(fs::mem_list(tree, "s")) {
    None -> [],
    Some(names) ->
      names.filter(|n: String| n.starts_with("seg-") || n.starts_with("manifest-")).map(
        |n: String|
          { name: n, size: match fs::mem_size(tree, "s/" ++ n) { Some(s) -> s, None -> 0 } },
      ),
  }

fn store_bytes(tree: fs::MemFs) -> Int / {abort.raise} =
  store_files(tree).fold(0, |n: Int, f: { name: String, size: Int }| n + f.size)

fn ignore_tally(_: LevelTally) -> Unit = ()

fn sample_program() -> List<{ name: Bytes, src: Bytes }> =
  [
    {
      name: b"m",
      src: b"fn each(n: Int, f: (Int) -> Int, i: Int, acc: Int) -> Int = if i >= n { acc } else { each(n, f, i + 1, acc + f(i)) }\nfn total(n: Int, f: (Int) -> Int) -> Int = each(n, f, 0, 0)\nfn scaled(n: Int, k: Int) -> Int = total(n, |x: Int| x * k)\nfn pair<a>(x: a) -> List<a> = [x, x]\nfn twice(n: Int) -> Int = pair(n).len() + pair(\"s\").len()\n",
    },
  ]

test "a run over a store an earlier run filled reads every result back and writes nothing" {
  let first = unit_on_tree(fs::mem_of([]), sample_program());
  assert(first.value.asked > 0, None);
  let second = unit_on_tree(first.tree, sample_program());
  assert_eq(second.value.asked, 0);
  assert_eq(second.value.produced.taken, first.value.produced.taken);
  assert_eq(store_files(second.tree), store_files(first.tree))
}

test "a run that dies caches the results of every call the emitter finished" {
  let whole = unit_on_tree(fs::mem_of([]), sample_program());
  let died = fs::on_mem[abs](fs::mem_of([]), ||
    handle {
      unit_in_file_store[abs](sample_program(), |_: LevelTally|
        panic("the run dies as its first place ends"));
      false
    } with {
      abort.raise(_) -> true,
    });
  assert(died.value, None);
  let next = unit_on_tree(died.tree, sample_program());
  assert(next.value.cached > 0 && next.value.asked < whole.value.asked, None);
  assert_eq(next.value.produced.taken, whole.value.produced.taken)
}

test "a run stores only the results it computed anew, however much the store holds" {
  let first = unit_on_tree(fs::mem_of([]), sample_program());
  let grown = |more: Bytes| {
    let user = sample_program().map(|m: { name: Bytes, src: Bytes }|
      { ..m, src: m.src.concat(more) });
    let next = unit_on_tree(first.tree, user);
    { asked: next.value.asked, wrote: store_bytes(next.tree) - store_bytes(first.tree) }
  };
  let one = grown(b"fn aside() -> Int = 7\n");
  let two = grown(b"fn aside() -> Int = 7\nfn beside() -> Int = 8\n");
  let three = grown(b"fn aside() -> Int = 7\nfn beside() -> Int = 8\nfn below() -> Int = 9\n");
  assert(one.asked > 0 && two.asked > one.asked && three.asked > two.asked, None);
  assert(one.wrote > 0 && one.wrote * 2 < store_bytes(first.tree), None);
  assert(three.wrote - two.wrote <= two.wrote - one.wrote + 400, None)
}

test "a run passes over a store's segment it cannot read and asks for those roots again" {
  let first = unit_on_tree(fs::mem_of([]), sample_program());
  let cut = store_files(first.tree).fold(
    first.tree,
    |t: fs::MemFs, f: { name: String, size: Int }|
      if f.name.starts_with("seg-") { fs::mem_write(t, "s/" ++ f.name, b"").fs } else { t },
  );
  let again = unit_on_tree(cut, sample_program());
  assert_eq(again.value.asked, first.value.asked);
  assert_eq(again.value.produced.taken, first.value.produced.taken)
}

test "results are cached in a store of their runtime and emitter" {
  let at = |runtime: Bytes, emitter: Bytes| results_store("b", a_runtime(runtime), emitter);
  assert_eq(at(b"r", b"e"), at(b"r", b"e"));
  assert(at(b"r", b"e") != at(b"r2", b"e"), None);
  assert(at(b"r", b"e") != at(b"r", b"e2"), None)
}

test "a unit takes what it is offered, resolves its bodies and says what it holds" {
  let results = by_definition([{ key: b"m.f", value: one_body(b"m.f", []) }]);
  let p = fresh(
    [{ name: b"None", arity: 0 }],
    [{ ..request(b"m.f", 0), constant: true }],
    1,
    results,
    Map::new(),
    no_machine,
    part_rule(),
  );
  assert_eq(p.taken, [definition_root(b"m.f")]);
  let own = statics_of(StringDatum(b"m.f")).get(0);
  let symbol = symbol_of(b"m.f");
  let entry = entry_symbol(b"m.f");
  let body = part_containing(p.text, body_of(b"m.f"));
  assert(
    body.index_of(
        Bytes::concat_all([
          body_of(b"m.f"),
          b" { return (Word)(intptr_t)&",
          own.name,
          b" + ",
          ascii_of_int(root_id(b"m.f")),
          b"; }",
        ]),
      )
      != None,
    None,
  );
  assert(body.index_of(Bytes::concat_all([b"Word ", symbol, b"(PlyCtx*);\n"])) != None, None);
  assert(body.index_of(static_defined(own)) != None, None);
  let tables = part_labelled(p.text, "tables");
  assert(tables.index_of(b"\"constants 1\" \"\\n\"\n\"m.f 0\" \"\\n\"") != None, None);
  assert(p.text.index_of(b"\"taken ") == None && p.text.index_of(b"\"lambdas ") == None, None);
  assert(
    tables.index_of(
        Bytes::concat_all([
          b"extern char ",
          entry,
          b";\nvoid *const ply_code[] = {\n  (void *)&",
          entry,
          b",\n  0 };\n",
        ]),
      )
      != None,
    None,
  );
  assert(
    part_labelled(p.text, "taken").index_of(
        Bytes::concat_all([
          b"extern char ",
          entry,
          b";\nconst struct ply_taken ply_taken[] = {\n  { \"m.f\", (void *)&",
          entry,
          b", 0 },\n  { 0, 0, 0 } };\n",
        ]),
      )
      != None,
    None,
  );
  assert(
    tables.index_of(b"(void *)ply_bind, (void *)0, ply_code, 1, ply_taken, 1 };\n") != None,
    None,
  )
}

test "a unit lays its definitions out by name in byte order, each name as a C literal holds it" {
  let roots = [Named(b"m.z"), EntryPoint(Named(b"m.a")), Named(b"m.B")];
  let p = fresh(
    [],
    roots.map(|k: RootKey| offer_root(k, 2)),
    1,
    roots.fold(Map::new(), |acc: Map<RootName, Output>, k: RootKey|
      acc.insert(root_name(k), one_body(printed(k), []))),
    Map::new(),
    no_machine,
    part_rule(),
  );
  let row = |n: Bytes|
    Bytes::concat_all([b"  { \"", n, b"\", (void *)&", entry_symbol(n), b", 2 },\n"]);
  assert(
    p.text.index_of(
        Bytes::concat_all([
          b"ply_taken[] = {\n",
          row(b"m.B"),
          row(b"m.a#entered"),
          row(b"m.z"),
          b"  { 0, 0, 0 } };\n",
        ]),
      )
      != None,
    Some(String::of_bytes_lossy(p.text)),
  );
  let taken_struct = b"struct ply_taken { const char *name; void *entry; unsigned long arity; };\n";
  assert_eq(
    taken_part([
      {
        name: definition_root(b"m.\"q\""),
        arity: 0,
        symbol: b"f",
        entry: b"e",
        prototype: word_prototype(0),
      },
    ]),
    Bytes::concat_all([
      b"/* --- part taken --- */\n",
      taken_struct,
      b"extern char e;\n",
      b"const struct ply_taken ply_taken[] = {\n  { \"m.\\\"q\\\"\", (void *)&e, 0 },\n  { 0, 0, 0 } };\n",
    ]),
  );
  let tables = tables_part([], [], b"", 1);
  assert(
    tables.starts_with(b"/* --- part tables --- */\nvoid *const ply_code[] = {\n  0 };\n"),
    None,
  );
  assert(
    tables.ends_with(
      Bytes::concat_all([
        taken_struct,
        b"extern const struct ply_taken ply_taken[];\n",
        b"void ply_bind(void **fns);\n",
        b"struct ply_descriptor { const char *exports; unsigned long exports_len; void *bind; void *bind_singletons; void *const *code; unsigned long code_count; const struct ply_taken *taken; unsigned long taken_count; };\n",
        b"const struct ply_descriptor ply_descriptor = { ply_exports, sizeof ply_exports - 1, (void *)ply_bind, (void *)0, ply_code, 0, ply_taken, 1 };\n",
      ]),
    ),
    Some(String::of_bytes_lossy(tables)),
  )
}

test "a root's code moves with the key a type it names states" {
  let program = |key: Output, calls: List<Bytes>|
    root_codes(
      [
        { key: b"m.make", value: one_body(b"m.make", calls) },
        { key: b"m.area", value: key },
        { key: b"m.edge", value: one_body(b"m.edge", []) },
      ],
      [b"m.make", b"m.area", b"m.edge"],
      [],
    );
  let results_and_keys = program(one_body(b"m.area", []), [b"m.area"]);
  let edited = program(edited_body(b"m.area"), [b"m.area"]);
  let other = program(one_body(b"m.area", []), [b"m.edge"]);
  assert(results_and_keys.get(b"m.make") != edited.get(b"m.make"), None);
  assert(results_and_keys.get(b"m.make") != other.get(b"m.make"), None)
}

test "a read of a definition of no parameters keeps its value for good through its type's keep root" {
  let k = unit_builder(
    Bytes::concat_all([
      b"fn flag() -> Bool = 1 < 2\n",
      b"fn word() -> String = \"a\" ++ \"b\"\n",
      b"fn none<a>() -> Option<a> = None\n",
      b"fn read() -> Int = if flag() { word().len() } else { 0 }\n",
      b"fn nothing() -> Option<Int> = none()\n",
    ]),
  );
  let unit = k.unit([b"m.flag", b"m.word", b"m.none", b"m.read", b"m.nothing"].map(Named));
  let text = unit_text(unit.produced.parts);
  let read_with = |keep: Bytes|
    text.index_of(Bytes::concat_all([b", (Word)(intptr_t)", keep, b")"])) != None;
  assert(text.index_of(read_of(constant_read_fn())) != None, None);
  assert(read_with(identity_fn()), None);
  assert(read_with(symbol_of(printed(root_of(keys::Keep, string_type())))), None);
}

fn read_of(helper: Bytes) -> Bytes = helper.concat(b"(ctx, ply_part")

test "a read of a definition taking a parameter or publishing an effect runs its body, where one of neither is read from the memo" {
  let probes = [b"m.probe_constant", b"m.probe_parameterized", b"m.probe_over_declared"];
  let k = unit_builder(
    Bytes::concat_all([
      b"effect store {\n  read peek() -> Int\n}\n",
      b"fn constant() -> List<Int> = range(0, 20)\n",
      b"fn parameterized(ignored: Int) -> List<Int> = range(0, 20)\n",
      b"fn over_declared() -> List<Int> / {store.read} = range(0, 20)\n",
      b"fn probe_constant() -> Int = constant().len() + constant().len()\n",
      b"fn probe_parameterized() -> Int = parameterized(0).len() + parameterized(0).len()\n",
      b"fn probe_over_declared() -> Int / {store.read} = over_declared().len() + over_declared().len()\n",
    ]),
  );
  let text = unit_text(k.unit(probes.map(Named)).produced.parts);
  assert_eq(
    probes.map(|probe: Bytes|
      defined_in(text, symbol_of(probe)).index_of(read_of(constant_read_fn())) != None),
    [true, false, false],
  )
}

test "a `const fn` is read through the check that no raise left it, and a plain definition is not" {
  let reads = |table: Bytes| {
    let k = unit_builder(Bytes::concat_all([table, b"fn read() -> Int = table().len()\n"]));
    let text = unit_text(k.unit([b"m.table", b"m.read"].map(Named)).produced.parts);
    let count = |helper: Bytes| text.split(read_of(helper)).len() - 1;
    [count(const_fn_read_fn()), count(constant_read_fn())]
  };
  let constant = reads(b"const fn table() -> List<Int> = [1, 2]\n");
  let plain = reads(b"fn table() -> List<Int> = [1, 2]\n");
  assert_eq(constant, [1, plain.get(1) - 1]);
  assert_eq(plain.get(0), 0)
}

test "a `const` read by name is read as a `const fn` of its value is" {
  let reads = |source: Bytes| {
    let k = unit_builder(source);
    let text = unit_text(k.unit([b"m.table", b"m.read"].map(Named)).produced.parts);
    [const_fn_read_fn(), constant_read_fn()].map(|helper: Bytes|
      text.split(read_of(helper)).len() - 1)
  };
  assert_eq(
    reads(b"const table: List<Int> = [1, 2]\nfn read() -> Int = table.len()\n"),
    reads(b"const fn table() -> List<Int> = [1, 2]\nfn read() -> Int = table().len()\n"),
  )
}

test "a read of a definition whose body is data made of literals is that data, with no allocation" {
  let text = |source: Bytes|
    unit_text(unit_builder(source).unit([Named(b"m.read")]).produced.parts);
  let reads = |source: Bytes, helper: Bytes| text(source).index_of(read_of(helper)) != None;
  let read_body = |unit: Bytes| {
    let at = match unit.index_of(symbol_of(b"m.read").concat(b"(PlyCtx *ctx, int64_t p0) {")) {
      Some(i) -> i,
      None -> panic("the unit defines m.read"),
    };
    let body = unit.slice(at, unit.len());
    body.slice(0, match body.index_of(b"\n}\n") { Some(i) -> i, None -> body.len() })
  };
  let int = text(b"fn kept() -> Int = 300\nfn read(n: Int) -> Int = n + kept()\n");
  assert(int.index_of(b"INT64_C(300)") != None, None);
  assert(int.index_of(read_of(constant_read_fn())) == None, None);
  assert(int.index_of(b"ply_m_kept_") == None, None);
  let wide = text(
    b"type W = { a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int, i: Int, j: Bytes }\nfn kept() -> W = { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9, j: b\"abc\" }\nfn read(n: Int) -> Int = n + kept().i\n",
  );
  assert(wide.index_of(read_of(constant_read_fn())) == None, None);
  assert(wide.index_of(b"ply_m_kept_") == None, None);
  assert(!allocates(read_body(wide)), None);
  let boxed = text(
    b"type T = | Off | Pair(Int, Option<Bytes>)\nfn kept() -> T = Pair(7, Some(b\"abc\"))\nfn read(n: Int) -> Int = match kept() { Pair(k, _) -> k + n, Off -> n }\n",
  );
  assert(boxed.index_of(read_of(constant_read_fn())) == None, None);
  assert(!allocates(read_body(boxed)), None);
  assert(
    !reads(
      b"type R = { a: Option<Int>, b: Bool }\nfn kept() -> R = { a: None, b: true }\nfn read(n: Int) -> Int = if kept().b { n } else { 0 }\n",
      constant_read_fn(),
    ),
    None,
  );
  assert(
    reads(
      b"fn kept() -> List<Int> = [1, 2]\nfn read(n: Int) -> Int = n + kept().len()\n",
      constant_read_fn(),
    ),
    None,
  );
  assert(
    reads(
      b"type T = | Make(Int)\nfn kept() -> { make: (Int) -> T } = { make: Make }\nfn read(n: Int) -> T = (kept().make)(n)\n",
      constant_read_fn(),
    ),
    None,
  );
  assert(
    !reads(
      b"fn kept() -> Bytes = b\"abc\"\nfn read(n: Int) -> Int = n + kept().len()\n",
      constant_read_fn(),
    ),
    None,
  );
  assert(
    !reads(b"fn kept() -> U8 = 200u8\nfn read(_: Int) -> U8 = kept()\n", constant_read_fn()),
    None,
  );
  assert(
    !reads(
      b"const fn kept() -> String = \"abc\"\nfn read(n: Int) -> Int = n + kept().len()\n",
      const_fn_read_fn(),
    ),
    None,
  );
  assert(
    reads(b"fn kept() -> Int = 1 + 2\nfn read(n: Int) -> Int = n + kept()\n", constant_read_fn()),
    None,
  )
}

fn unit_in_store(
  user: List<{ name: Bytes, src: Bytes }>,
) -> Emission / {body_store.get, body_store.put, abort.raise} = {
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_in_order(dump, user),
      Map::new(),
      requested_roots(dump).keys,
      |k: Bytes| body_store.get(k),
      |rs: List<Record>|
        match rs.find(|r: Record|
            r.key.starts_with(b"answer\x00") && body_store.get(r.key) != None) {
          Some(r) -> panic(String::of_bytes_lossy(b"a result cached twice: ".concat(r.key))),
          None -> body_store.put(rs),
        },
      phases: Some({
        now: || 0,
        outcome: |r: LevelTally|
          body_store.put([{ key: b"place ".concat(ascii_of_int(r.place)), bytes: b"" }]),
      }),
    ) {
    Ok(e) -> e,
    Err(reason) -> panic(String::of_bytes_lossy(reason)),
  }
}

fn nested_records(d: Int) -> List<{ name: Bytes, src: Bytes }> =
  [
    {
      name: b"m",
      src: Bytes::concat_all(
        range(1, d + 1).fold([b"type T0 = { s: String }\n"], |acc: List<Bytes>, k: Int| {
          let below = ascii_of_int(k - 1);
          acc.push(
            Bytes::concat_all([
              b"type T",
              ascii_of_int(k),
              b" = { x: T",
              below,
              b", y: List<T",
              below,
              b"> }\n",
            ]),
          )
        }).push(
          Bytes::concat_all([b"pub fn crossed(t: T", ascii_of_int(d), b") -> Int = 1\n"]),
        ),
      ),
    },
  ]

test "a unit's places do not grow with how deep the records it marshals nest, and it returns each root once" {
  let places = [2, 4, 8].map(|d: Int|
    with_body_store(|| {
      let e = unit_in_store(nested_records(d));
      body_store.all().keys().filter(|k: Bytes| k.starts_with(b"place ")).len()
    }));
  assert(
    places.all(|n: Int| n == places.get(0)),
    Some("places at depths 2, 4 and 8: " ++ String::join(places.map(|n: Int| n.to_string()), ", ")),
  )
}

type CountingEmitter = { scoped: EmitterScope, built: Int, asked: List<RootName> }

fn walk_in_store(
  user: List<{ name: Bytes, src: Bytes }>,
) -> { walk: EmissionProgress<CountingEmitter>, program: Program, dump: Dump } / {body_store.get, body_store.put, abort.raise} = {
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  let offered = requested_roots(dump).keys;
  let p = program_of(dump, sources_in_order(dump, user), offered);
  let constructors = dump.emitter_constructors.map(|c: EmitterConstructor|
    { name: c.name, arity: c.arity });
  let walk = walk_levels(
    p,
    types_digest(dump),
    program_constructors(dump, constructors),
    offered,
    |k: Bytes| body_store.get(k),
    |rs: List<Record>| body_store.put(rs),
    None,
    |ahead: List<RootKey>| { scoped: initial_emitter_scope(ahead), built: 0, asked: [] },
    |emitter: CountingEmitter, roots: List<RootKey>, handed: Map<RootName, OwnershipSignature>, done: KnownResults| {
      let a = emit_scoped(dump, p, constructors, offered, emitter.scoped, roots, handed, done);
      let grew = match emitter.scoped.scope {
        None -> true,
        Some(_) -> a.state.covered.len() > emitter.scoped.covered.len(),
      };
      {
        state: {
          scoped: a.state,
          built: if grew { emitter.built + 1 } else { emitter.built },
          asked: emitter.asked.concat(roots.map(root_name)).concat(a.found.map(root_name)),
        },
        results: a.results,
        found: a.found,
      }
    },
  );
  { walk: walk, program: p, dump: dump }
}

test "a cold walk asks the emitter for each root once over one scope, and a warm one builds none" {
  with_body_store(|| {
    let walked_cold = walk_in_store(sample_program());
    let cold = walked_cold.walk;
    assert_eq(cold.emitter.built, 1);
    assert_eq(cold.emitter.scoped.covered.keys(), walked_cold.program.read.keys());
    assert(cold.emitter.asked.len() > 0, None);
    assert_eq(sorted_unique(cold.emitter.asked).len(), cold.emitter.asked.len());
    assert_eq(cold.asked, cold.emitter.asked.len());
    let warm = walk_in_store(sample_program()).walk;
    assert_eq((warm.emitter.built, warm.emitter.asked), (0, []));
    assert_eq(warm.results.keys(), cold.results.keys())
  })
}

fn parted_program(applied: Bytes, added: Bytes) -> List<{ name: Bytes, src: Bytes }> =
  [
    {
      name: b"g",
      src: Bytes::concat_all([
        b"pub fn apply<a>(f: (a) -> a, x: a) -> a = ",
        applied,
        b"\n",
        b"pub fn same<a>(x: a, y: a) -> Bool = x == y\n",
        b"pub fn first<a>(xs: List<a>) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }\n",
      ]),
    },
    {
      name: b"k",
      src: Bytes::concat_all([
        b"import g\n",
        b"pub type Box = { v: Int, w: List<Int> }\n",
        b"pub fn both<a>(x: a) -> Bool = g::same(x, x)\n",
        b"pub fn checked(n: Int) -> Bool = both(n)\n",
        b"pub fn one() -> Int = g::apply(|x: Int| x + 1, 1)\n",
        b"pub fn top(xs: List<Box>) -> Int = match g::first(xs) { Some(b) -> b.v + b.w.len(), None -> 0 }\n",
      ]),
    },
    { name: b"d", src: Bytes::concat_all([b"pub fn bump(x: Int) -> Int = x + ", added, b"\n"]) },
    { name: b"e", src: b"import d\npub fn h(x: Int) -> Int = d::bump(x) - 1\n" },
  ]

test "a warm walk's scope holds what the roots it misses read, and no module of the program's other part" {
  with_body_store(|| {
    walk_in_store(parted_program(b"f(x)", b"1"));
    let warm = walk_in_store(parted_program(b"f(x)", b"2"));
    let missed = [Named(b"d.bump"), Named(b"e.h")];
    let read = program_of(warm.dump, warm.program.sources, missed).read.keys();
    assert(!read.contains(b"g") && !read.contains(b"k"), None);
    let emitter = warm.walk.emitter;
    assert_eq(sorted_unique(emitter.asked), sorted_unique(missed.map(root_name)));
    assert_eq(emitter.scoped.covered.keys(), read);
    assert_eq(emitter.built, 1)
  })
}

test "a walk grows its scope once, over what is left, where a cached body's call resolves to a root it misses" {
  with_body_store(|| {
    walk_in_store(parted_program(b"f(x)", b"1"));
    let edited = parted_program(b"f(f(x))", b"1");
    let warm = walk_in_store(edited);
    let scoped = warm.walk.emitter.scoped;
    assert(!modules_asked(warm.program, scoped.expected_roots).contains(b"k"), None);
    assert(scoped.covered.contains(b"k"), None);
    assert_eq(warm.walk.emitter.built, 2);
    let cold = with_body_store(|| walk_in_store(edited)).walk;
    let summaries = |results: Map<RootName, Output>|
      results.fold(Map::new(), |m: Map<RootName, Output>, n: RootName, a: Output|
        m.insert(n, summarised(a)));
    assert(summaries(warm.walk.results) == summaries(cold.results), None)
  })
}

test "a warm unit writes the C a cold one writes, over modules each kept apart or grown into" {
  let first = unit_on_tree(fs::mem_of([]), parted_program(b"f(x)", b"1"));
  let edited = parted_program(b"f(f(x))", b"2");
  let warm = unit_on_tree(first.tree, edited).value;
  let cold = unit_on_tree(fs::mem_of([]), edited).value;
  assert(warm.cached > 0 && warm.asked < cold.asked, None);
  assert_eq(sorted_unique(warm.roots.map(root_name)), sorted_unique(cold.roots.map(root_name)));
  assert(unit_text(warm.produced.parts) == unit_text(cold.produced.parts), None)
}

fn emit_unit<[r]>(
  user: List<{ name: Bytes, src: Bytes }>,
  bodies: Bool,
) -> Emission / {fs.read[r], fs.write[r], abort.raise} = {
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  with_record_store[r, ans]("s", ||
    match emitted(
        a_runtime(b"r"),
        dump,
        sources_in_order(dump, user),
        Map::new(),
        requested_roots(dump).keys,
        |k: Bytes|
          if !bodies && k.starts_with(body_key(b"")) { panic("a part taken back reads no body") }
          else { record_store.get[ans](k) },
        |rs: List<Record>| record_store.put[ans](rs),
        source_cached: Some(|_: String| true),
      ) {
      Ok(e) -> e,
      Err(reason) -> panic(String::of_bytes_lossy(reason)),
    })
}

test "a run over a store an earlier run filled takes each part back as it kept it, reading no body" {
  let first = fs::on_mem[abs](fs::mem_of([]), || emit_unit[abs](sample_program(), true));
  let second = fs::on_mem[abs](first.tree, || emit_unit[abs](sample_program(), false));
  let digests = |e: Emission| e.produced.parts.map(|w: WrittenPart| w.digest);
  assert_eq(digests(second.value), digests(first.value));
  assert(second.value.produced.parts.any(|w: WrittenPart| w.text == None), None);
  assert_eq(store_files(second.tree), store_files(first.tree))
}

fn parts_over(
  names: List<Bytes>,
  edited: Bytes,
  cached: Map<Bytes, Bytes>,
) -> UnitOutput / {abort.raise} =
  produce(
    [],
    names.map(|n: Bytes| request(n, 0)),
    1,
    by_definition(
      names.map(|n: Bytes|
        { key: n, value: if n == edited { edited_body(n) } else { one_body(n, []) } }),
    ),
    Map::new(),
    no_machine,
    one_each(),
    Map::new(),
    Map::new(),
    |k: Bytes| cached.get(k),
    |_: String| true,
  )

test "an edit writes anew just the parts whose C it moved, and each part taken back is the C a cold build writes" {
  let names = numbered(6);
  let first = parts_over(names, b"", Map::new());
  let cached = first.records.fold(Map::new(), |m: Map<Bytes, Bytes>, r: Record|
    m.insert(r.key, r.bytes));
  let digests = |p: UnitOutput| p.parts.map(|w: WrittenPart| w.digest);
  let bodies = |p: UnitOutput|
    p.parts.filter(|w: WrittenPart| !["runtime", "fields", "taken", "tables"].contains(w.label));
  let written = |p: UnitOutput|
    bodies(p).filter(|w: WrittenPart| w.text != None).map(|w: WrittenPart| w.label);
  let again = parts_over(names, b"", cached);
  assert_eq(digests(again), digests(first));
  assert_eq((written(again), again.records), ([], []));
  let edited = parts_over(names, b"m.b3", cached);
  let cold = parts_over(names, b"m.b3", Map::new());
  assert_eq(digests(edited), digests(cold));
  let moved = bodies(cold).filter(|w: WrittenPart| !digests(first).contains(w.digest)).map(
    |w: WrittenPart| w.label,
  );
  assert(moved != [] && moved.len() < bodies(cold).len(), None);
  assert_eq(written(edited), moved)
}

fn same_items<v>(a: Map<RootName, List<v>>, b: Map<RootName, List<v>>) -> Bool
  where derivable(eq, v)
=
  a.keys() == b.keys()
    && a.fold(true, |ok: Bool, n: RootName, xs: List<v>|
      ok
        && (match b.get(n) {
          Some(ys) -> xs.len() == ys.len() && xs.all(|x: v| ys.contains(x)),
          None -> false,
        }))

test "a walk's needs and parameters called are those one closure over all its generic bodies gives" {
  with_body_store(|| {
    let w = walk_in_store(parted_program(b"f(x)", b"1")).walk;
    let needs = transitive_needs(w.results, w.keys);
    let called = transitive_called(w.results, w.keys);
    assert(same_items(w.needs, needs), None);
    assert(same_items(w.called, called), None);
    assert(
      match needs.get(definition_root(b"k.both")) {
        Some(ns) -> ns.contains({ var: 0, reads: Exact }),
        None -> false,
      },
      None,
    );
    assert_eq(called.get(definition_root(b"g.apply")), Some([0]))
  })
}

fn program_codes(src: Bytes) -> Map<Bytes, Bytes> / {abort.raise} = {
  let user = [{ name: b"m", src: src }];
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_in_order(dump, user),
      Map::new(),
      requested_roots(dump).keys,
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(reason) -> panic(String::of_bytes_lossy(reason)),
    Ok(e) ->
      codes(e.produced.made).fold(Map::new(), |m: Map<Bytes, Bytes>, n: RootName, code: Bytes|
        m.insert(root_text(n), code)),
  }
}

fn test_code(codes_of_program: Map<Bytes, Bytes>, label: Bytes) -> Option<Bytes> / {abort.raise} =
  codes_of_program.get(root_text(root_name(test_key(b"m", label))))

test "a body the emitter folds to the one it replaced leaves a test's code, and another body moves it" {
  let code = |body: Bytes|
    test_code(
      program_codes(
        Bytes::concat_all([
          b"fn a(_: Int) -> Int = ",
          body,
          b"\ntest \"a is one\" { assert_eq(a(0), 1) }\n",
        ]),
      ),
      b"a is one",
    );
  assert(code(b"1") != None, None);
  assert_eq(code(b"0 + 1"), code(b"1"));
  assert(code(b"2") != code(b"1"), None)
}

fn length_program(plus: Bytes) -> Bytes =
  Bytes::concat_all([
    b"type Length = | Metres(Int) | Millimetres(Int)\n\nkey for Length by millimetres\n\nnumeric for Length by { add: plus, sub: plus, mul: plus, neg: back, of_int: metres }\n\nfn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }\n\nfn plus(a: Length, b: Length) -> Length = ",
    plus,
    b"\n\nfn back(a: Length) -> Length = a\n\nfn metres(n: Int) -> Length = Metres(n)\n\nfn lengths() -> List<Length> = [Metres(1), Millimetres(500)]\n\nfn total<a>(xs: List<a>) -> a\n  where numeric(a)\n= xs.fold(numeric_of_int(0), |s: a, x: a| s + x)\n\nfn same<a>(x: a, y: a) -> Bool\n  where derivable(eq, a)\n= x == y\n\ntest \"the lengths have a total\" { assert(same(total(lengths()), total(lengths()))) }\n\ntest \"a length is itself\" { assert(same(lengths(), lengths())) }\n",
  ])

test "an edit to a function a numeric names moves the code of a test that adds, and of no test that only holds the type" {
  let before = program_codes(length_program(b"Millimetres(millimetres(a) + millimetres(b))"));
  let after = program_codes(length_program(b"Millimetres(millimetres(b) + millimetres(a))"));
  assert(
    test_code(before, b"the lengths have a total") != test_code(after, b"the lengths have a total"),
    None,
  );
  assert(test_code(before, b"a length is itself") != None, None);
  assert_eq(test_code(before, b"a length is itself"), test_code(after, b"a length is itself"))
}
