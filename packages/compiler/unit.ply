// --- What crosses the seam ----------------------------------------------------

/// A helper the runtime binds by position: its arguments past the context, and whether it answers.
pub type Helper = { name: Bytes, args: Int, answers: Bool }

/// A function the runtime implements for an `extern fn`, as the runtime reads it off the function's
/// type: the name the extern declares, the words a call passes, whether it answers, and whether a
/// failure of it raises rather than ending the run.
pub type Native = { name: Bytes, words: Int, answers: Bool, raises: Bool }

/// The runtime a unit is compiled against: the C every unit opens with, through the runtime's
/// declarations, and closes with, its definitions; the helpers those bind by position; the natives
/// a body may call; how it lays out the objects the emitter writes code over in place; and the
/// digest of the runtime's sources and helper table.
pub type Runtime = {
  head: Bytes,
  tail: Bytes,
  helpers: List<Helper>,
  natives: List<Native>,
  layouts: Layouts,
  identity: Bytes,
}

/// What this binary ships, a function of the binary alone: its shipped modules, its version,
/// what its store's groups are a function of, and the runtime a unit is compiled against.
pub effect shipped {
  read names() -> List<String>
  /// A shipped module's text by its name, or the bytes of a data file one embeds by the name the
  /// shipped modules hold it under (`std/oid/names.txt`).
  read module(name: String) -> Option<Bytes>
  /// What the frame of `len` bytes at `offset` of the file `path` of the pack this binary carries
  /// holds, decompressed: what `ply std --answers` answered of the shipped modules (`packs`). A
  /// `len` of 0 reads the frames from `offset` to the end. Nothing where it carries no such file or
  /// the range holds no whole frame.
  read answer(path: String, offset: Int, len: Int) -> Option<Bytes>
  /// Each file this binary ships, by the name the launcher lays it out under, and its digest, as
  /// the launcher's `digests` beside them lists them: the files a packed answer stands for.
  read digests() -> Bytes
  /// What a load read of the shipped modules it pulled, for whatever observes the run: a test's
  /// pass then stands on the functions its program reached rather than on the whole modules.
  /// `pulled` is whether the load read them itself, rather than re-analysing one that did.
  read reached(view: Bytes, pulled: Bool) -> Unit
  read version() -> String
  read stamps() -> String
  read runtime() -> Runtime
  /// Each definition of this binary's own program, the one its launcher entered (the builder's own
  /// where a builder asks), and the hash its front end gave it, a `name hash` line each: a hash
  /// covers all its definition reaches.
  read definitions() -> Bytes
  /// A program's front end as an artifact carries it for a machine to load: the entry it runs, and
  /// its front end's answer over every source that answer's indices run over, in their order.
  read runnable(entry: String, files: List<{ path: String, name: String, text: Bytes }>, dump: Dump) -> Bytes
  /// A native program's front end as its pack carries it for the runtime it is linked with.
  read front(linked: Linked) -> Bytes
  /// What each of `roots`, each a `stored_root` of a `const` definition, answers on the unit
  /// compiled over that front end's answer into the library `library`, each called alone with
  /// nothing lent and under `steps` calls: the text its value is kept as, or none where it raised,
  /// ran past its calls, or the unit holds no such root.
  read values(files: List<{ path: String, name: String, text: Bytes }>, dump: Dump, library: String, roots: List<String>, steps: Int) -> List<Option<Bytes>>
}

/// A native as the compiler declares it that the runtime does not implement so, and every native the
/// runtime has under its name: none, more than one, or one that takes other words, answers nothing
/// or raises otherwise.
pub type Unbound = { declared: Extern, found: List<Native> }

/// Each of `declared` that `natives` does not implement, in `declared`'s order.
pub fn unbound(natives: List<Native>, declared: List<Extern>) -> List<Unbound> = {
  let by_name = natives.fold(Map::new(), |acc: Map<Bytes, List<Native>>, n: Native|
    acc.insert(n.name, List::push(match acc.get(n.name) { Some(ns) -> ns, None -> [] }, n)));
  declared.fold([], |acc: List<Unbound>, d: Extern| {
    let found = match by_name.get(d.name) { Some(ns) -> ns, None -> [] };
    match found {
      [n] -> if n.words == d.words && n.answers && n.raises == d.raises { acc }
      else { acc.push({ declared: d, found: found }) },
      _ -> acc.push({ declared: d, found: found }),
    }
  })
}

/// The natives the compiler declares itself: each `extern fn` of the prelude, then each native the
/// elaboration writes calls of.
pub fn declared_natives() -> List<Extern> / {abort.raise} =
  prelude_externs().concat(
    elaborated_natives().map(|n: Elaborated|
      { module: b"", name: n.name, words: n.words, raises: n.raises }),
  )

/// The C helper of each native a unit's bodies call, by its name without the `_p` its pointer
/// adds, and of each native a body reads as a value, which the runtime calls as that native.
fn natives_called(made: Made) -> Map<Bytes, Bool> / {abort.raise} =
  made.bodies.fold(Map::new(), |acc: Map<Bytes, Bool>, k: UnitBody|
    k.tables.builtins.fold(helpers_named(k.text, acc), |into: Map<Bytes, Bool>, b: Bytes|
      into.insert(builtin_helper(b), true)))

fn identifier_bytes() -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(48, 58).concat(range(65, 91)).push(95).concat(range(97, 123)).map(byte_of_int),
  )

/// `into` with each helper `text` names: an identifier `builtin_…_p`, the pointer a helper is
/// called through.
fn helpers_named(text: Bytes, into: Map<Bytes, Bool>) -> Map<Bytes, Bool> / {abort.raise} =
  iterate({ from: 0, found: into }, text.len() + 1, |s: { from: Int, found: Map<Bytes, Bool> }|
    match text.index_of_from(b"builtin_", s.from) {
      None -> Stop(s.found),
      Some(at) -> {
        let end = text.scan(at, identifier_bytes(), text.len() - at);
        let name = text.slice(at, end);
        let opens = at == 0 || identifier_bytes().index_of_byte(text.at(at - 1)) == None;
        Continue({
          from: end,
          found: if opens && name.ends_with(b"_p") {
            s.found.insert(name.slice(0, name.len() - 2), true)
          } else { s.found },
        })
      },
    })

/// Every native a program over the shipped `modules`, each by its name and text, may call, each once
/// as it is first declared: the compiler's own (`declared_natives`), then each `extern fn` of the
/// prelude and of each of `modules`.
pub fn program_natives(
  modules: List<{ name: Bytes, text: Bytes }>,
) -> List<Extern> / {abort.raise} =
  natives_beside(
    declared_natives(),
    modules.map(|m: { name: Bytes, text: Bytes }| externs_in(m.name, m.text)),
  )

/// `program_natives` of a program whose modules are parsed as `mods`.
pub fn parsed_natives(mods: List<ParsedModule>) -> List<Extern> / {abort.raise} =
  natives_beside(declared_natives(), mods.map(|m: ParsedModule| module_externs(m.name, m.module)))

fn natives_beside(own: List<Extern>, modules: List<List<Extern>>) -> List<Extern> / {abort.raise} =
  [externs_in(prelude_module(), prelude_source::text())].concat(modules).fold(
    {
      seen: own.fold(Map::new(), |m: Map<Bytes, Bool>, e: Extern| m.insert(e.name, true)),
      all: own,
    },
    |acc: { seen: Map<Bytes, Bool>, all: List<Extern> }, es: List<Extern>|
      es.fold(acc, |a: { seen: Map<Bytes, Bool>, all: List<Extern> }, e: Extern|
        if a.seen.contains(e.name) { a }
        else { { seen: a.seen.insert(e.name, true), all: a.all.push(e) } }),
  ).all

/// What the natives whose helpers are `called` are declared to be, as `program_natives` declares
/// them over the shipped `modules`, each module's text the one `text_of` finds; the modules are read
/// only where the compiler does not declare every one itself.
fn called_externs(
  called: Map<Bytes, Bool>,
  modules: List<ModuleRow>,
  text_of: (ModuleRow) -> Option<Bytes>,
) -> List<Extern> / {abort.raise} = {
  let calls = |e: Extern| called.contains(builtin_helper(e.name));
  let own = declared_natives();
  let rest = own.fold(called, |acc: Map<Bytes, Bool>, e: Extern|
    acc.remove(builtin_helper(e.name)));
  if rest.len() == 0 { own.filter(calls) } else {
    natives_beside(
      own,
      modules.fold([], |acc: List<List<Extern>>, m: ModuleRow|
        match text_of(m) { Some(text) -> acc.push(externs_in(m.name, text)), None -> acc }),
    ).filter(
      calls,
    )
  }
}

fn native_said(words: Int, answers: Bool, raises: Bool) -> Bytes =
  Bytes::concat_all([
    b"takes ",
    ascii_of_int(words),
    if words == 1 { b" word" } else { b" words" },
    if !answers { b", answers nothing" } else { b"" },
    if raises { b" and raises" } else { b" and cannot raise" },
  ])

/// Why `u` does not bind, as a line of the diagnostic that lists it.
fn unbound_line(u: Unbound) -> Bytes = {
  let d = u.declared;
  let named = if d.module == b"" { Bytes::concat_all([b"the compiler's `", d.name, b"`"]) }
  else { Bytes::concat_all([b"`extern fn ", d.name, b"` of `", d.module, b"`"]) };
  match u.found {
    [] -> named.concat(b": no native of the runtime implements it"),
    [n] ->
      Bytes::concat_all([
        named,
        b" ",
        native_said(d.words, true, d.raises),
        b", and the runtime's native ",
        native_said(n.words, n.answers, n.raises),
      ]),
    ns ->
      Bytes::concat_all([
        named,
        b": ",
        ascii_of_int(ns.len()),
        b" natives of the runtime implement it",
      ]),
  }
}

/// The natives a unit calls that the runtime it is compiled against does not implement as they are
/// declared: refused before a C compiler meets a call that disagrees with the helper it names.
fn natives_refused(refused: List<Unbound>) -> Diag =
  error_with_labels(
    b"E0476",
    Bytes::concat_all([
      b"the runtime does not implement ",
      ascii_of_int(refused.len()),
      if refused.len() == 1 { b" native this program calls as it is declared" }
      else { b" natives this program calls as they are declared" },
    ]),
    [],
    refused.map(unbound_line).push(
      b"the runtime reports a native as the type of the function it binds says, and a call is written as the compiler that emitted it declares the native, so the two disagree where that compiler and the runtime are built from different sources, as a release's compiler and a newer runtime are",
    ),
  )

/// What the frame of `len` bytes at `offset` of the file `path` of the pack this binary carries
/// holds: `shipped.answer` as what reads the pack below a run's store.
pub fn pack_frame(path: String, offset: Int, len: Int) -> Option<Bytes> / {shipped.answer} =
  shipped.answer(path, offset, len)

/// The hash `definitions` holds for a definition of the compiler's, `name` as the compiler's own
/// program names it: a program that ships the compiler names it under `compiler.`.
pub fn definition_hash(definitions: Bytes, name: Bytes) -> Option<Bytes> / {abort.raise} = {
  let held = |full: Bytes| {
    let line = full.concat(b" ");
    let found = if definitions.starts_with(line) { Some(0) } else {
      match definitions.index_of(b"\n".concat(line)) { Some(i) -> Some(i + 1), None -> None }
    };
    match found {
      None -> None,
      Some(i) -> {
        let from = i + line.len();
        // A hash is sixty-four digits, so its line ends within this many bytes.
        let most = if from + 65 > definitions.len() { definitions.len() } else { from + 65 };
        let rest = definitions.slice(from, most);
        Some(rest.slice(0, match rest.index_of_byte(10) { Some(end) -> end, None -> rest.len() }))
      },
    }
  };
  match held(b"compiler.".concat(name)) { Some(h) -> Some(h), None -> held(name) }
}

/// What the answers `roots` compute are a function of on the program's side: each root's hash,
/// which covers all the root reaches and nothing else of the program. A root the program does not
/// hold was renamed without the list that names it.
pub fn identity_of(definitions: Bytes, roots: List<Bytes>) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all(
        roots.map(|root: Bytes|
          match definition_hash(definitions, root) {
            Some(h) -> Bytes::concat_all([root, b" ", h, b"\n"]),
            None ->
              panic(
                "this binary's program holds no definition `" ++ String::of_bytes_lossy(root)
                  ++ "`, which a kept answer is filed under",
              ),
          }),
      ),
    ),
  )

/// The definitions an emitter's answer is a function of besides the root it answers for: the one
/// that asks the emitter, and the one that makes the front end's answer it is asked over.
pub fn emitter_roots() -> List<Bytes> = [b"unit.emitter_answers", b"front.seam.view_dump"]

pub fn emitter_identity(definitions: Bytes) -> Bytes / {abort.raise} =
  identity_of(definitions, emitter_roots())

/// The definitions a unit is a function of besides the program it is of: the emitter's, and the ones
/// that produce a unit over its answers and hold it to what was offered.
pub fn unit_roots() -> List<Bytes> = [b"unit.emitted", b"unit.held", b"front.seam.view_dump"]

/// The definitions a program's analysis and its unit are a function of besides its sources.
pub fn compiler_roots() -> List<Bytes> = unit_roots().push(b"front.analyse_pulling_std_with")

/// What a program a builder built is a function of besides its text: the definition it enters, whose
/// hash covers all that reaches and nothing else of the program, the runtime its unit is compiled
/// against, and the builder's own entry, whose hash covers all the builder runs.
pub fn program_key(entry: Bytes, runtime: Runtime, definitions: Bytes) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all([
        b"ply.program.1\0",
        entry,
        runtime.identity,
        b"\0",
        identity_of(definitions, [b"build.main"]),
      ]),
    ),
  )

/// Where a builder keeps each program it built under `program_key`, below the stages.
pub fn programs_kept() -> String = "programs"

fn kept_path(dir: String, key: Bytes) -> String / {abort.raise} =
  if dir == "" || dir == "." { String::of_bytes(key) } else { dir ++ "/" ++ String::of_bytes(key) }

/// An answer kept between runs under `dir`. A read is a use, which keeps it from the toolchain's
/// sweep.
pub fn read_kept<[r]>(
  dir: String,
  key: Bytes,
) -> Option<Bytes> / {fs.read[r], fs.write[r], time.now_ms, abort.raise} = {
  let path = kept_path(dir, key);
  match fs.read_file[r](path) {
    None -> None,
    Some(bytes) -> {
      fs.set_modified[r](path, time.now_ms());
      Some(bytes)
    },
  }
}

/// Written beside itself and renamed into place, so a reader finds a whole answer or none. An answer
/// that cannot be written is left unwritten.
pub fn write_kept<[r]>(
  dir: String,
  key: Bytes,
  bytes: Bytes,
) -> Unit / {fs.write[r], entropy.next, time.now_ms, abort.raise} = {
  let path = kept_path(dir, key);
  let nonce = blake3(u64_le(entropy.next()).concat(u64_le(time.now_ms()))).slice(0, 8);
  let temp = path ++ "." ++ nonce.hex_of() ++ ".tmp";
  if fs.create_dir[r](if dir == "" { "." } else { dir }) && fs.write_file[r](temp, bytes) {
    if !fs.rename[r](temp, path) {
      fs.remove[r](temp);
      ()
    }
  }
}

/// A root a unit is offered: its arity, and whether it is pure and takes nothing, which the unit
/// gives a memo slot.
pub type Offered = { name: Bytes, arity: Int, constant: Bool }

/// A constructor of the unit's table: its arity, and its arguments as a shape spells them where its
/// declaration lays them out by type, none where it holds each as its word.
pub type Ctor = { name: Bytes, arity: Int, args: List<Bytes> }

/// A constructor whose type's module states what its values are compared and shown through, and the
/// function of each.
pub type Stated = { ctor: Bytes, key: Option<Bytes>, show: Option<Bytes>, numeric: List<Bytes> }

/// What the fixpoint dropped and why: the emitter refused it, or it calls `missing`, which the unit
/// does not take.
pub type Dropped = { function: Bytes, construct: Bytes, missing: Option<Bytes> }

/// What a unit's C was made of: its bodies, before the unit placed them, and its roots as they were
/// offered, which decide how the unit places each.
pub type Made = { bodies: List<UnitBody>, offered: List<Offered> }

/// A unit's C, the roots it takes, what it dropped, in the order it dropped them, and what it was
/// made of.
pub type Produced = { text: Bytes, taken: List<Bytes>, dropped: List<Dropped>, made: Made }

/// A unit produced over answers an earlier run kept and answers the emitter gave now: how many of
/// the offered roots each covered, and the natives the unit calls that the runtime does not
/// implement as they are declared.
pub type Emission = { produced: Produced, kept: Int, asked: Int, unbound: List<Unbound> }

/// Each root's answer, a group's one body answering for every member.
pub fn answers_of(rows: List<RootAnswer>) -> Map<Bytes, Answer> =
  rows.fold(Map::new(), |acc: Map<Bytes, Answer>, r: RootAnswer|
    match r.answer {
      Body(b) -> if b.tables.members.len() == 0 { acc.insert(r.name, r.answer) } else {
        b.tables.members.fold(acc, |into: Map<Bytes, Answer>, m: Bytes| into.insert(m, r.answer))
      },
      Refused(_) -> acc.insert(r.name, r.answer),
    })

// --- Order --------------------------------------------------------------------

/// Ascending by byte, each once.
fn ordered(xs: List<Bytes>) -> List<Bytes> =
  xs.fold(Map::new(), |acc: Map<Bytes, Bool>, x: Bytes| acc.insert(x, true)).keys()

/// A shape's names joined by a byte below every name's, so shapes sort as their name lists do.
fn shape_key(names: List<Bytes>) -> Bytes / {abort.raise} =
  range(0, names.len()).fold(b"", |acc: Bytes, i: Int|
    if i == 0 { names.get(i) } else { Bytes::concat_all([acc, b"\x00", names.get(i)]) })

/// Where a shape sorts in the unit's table: after every shape it holds in place, which the runtime
/// interns before it, so a shape's position is the id interning the table in order gives it. A shape
/// held in place opens fewer parentheses than one holding it, and a count sorts as its digits' count
/// and then its digits.
fn shape_order(names: List<Bytes>) -> Bytes / {abort.raise} = {
  let opens = names.fold(0, |acc: Int, nm: Bytes|
    range(0, nm.len()).fold(acc, |n: Int, i: Int| if nm.at(i) == 40 { n + 1 } else { n }));
  let digits = ascii_of_int(opens);
  Bytes::concat_all([ascii_of_int(digits.len()), digits, b"\x00", shape_key(names)])
}

fn positions(keys: List<Bytes>) -> Map<Bytes, Int> / {abort.raise} =
  range(0, keys.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int| acc.insert(keys.get(i), i))

// --- The fixpoint ---------------------------------------------------------------

/// A body the unit holds once: a group's under its first member.
pub type UnitBody = { name: Bytes, text: Bytes, tables: Tables }

type Round = { bodies: List<UnitBody>, symbols: Map<Bytes, Defined>, out: List<Dropped> }

type Settled = {
  taken: List<Bytes>,
  bodies: List<UnitBody>,
  symbols: Map<Bytes, Defined>,
  dropped: List<Dropped>,
}

fn refused_one(name: Bytes, why: Bytes) -> Dropped =
  { function: name, construct: why, missing: None }

fn lost(name: Bytes, callee: Bytes) -> Dropped =
  {
    function: name,
    construct: Bytes::concat_all([b"`", callee, b"`, which is not in this compiled unit"]),
    missing: Some(callee),
  }

/// The C a body publishes for `name`: its place among the members, or the body's one definition.
fn defines(name: Bytes, tables: Tables) -> Defined / {abort.raise} = {
  let found = range(0, tables.members.len()).fold(0 - 1, |acc: Int, i: Int|
    if acc < 0 && tables.members.get(i) == name { i } else { acc });
  match tables.symbols.at(if found < 0 { 0 } else { found }) {
    Some(d) -> d,
    None -> panic("an emitted body publishes the C it defines"),
  }
}

fn first_missing(calls: List<Bytes>, taken: Map<Bytes, Bool>) -> Option<Bytes> =
  calls.fold(None, |acc: Option<Bytes>, c: Bytes|
    match acc { Some(_) -> acc, None -> if taken.contains(c) { None } else { Some(c) } })

fn heads_its_group(name: Bytes, tables: Tables) -> Bool / {abort.raise} =
  tables.members.len() == 0 || tables.members.get(0) == name

fn round_over(answers: Map<Bytes, Answer>, taken: List<Bytes>) -> Round / {abort.raise} = {
  let set = taken.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Bytes| acc.insert(n, true));
  taken.fold({ bodies: [], symbols: Map::new(), out: [] }, |r: Round, name: Bytes|
    match answers.get(name) {
      None -> { ..r, out: r.out.push(refused_one(name, b"which the Ply emitter did not answer")) },
      Some(Refused(why)) -> { ..r, out: r.out.push(refused_one(name, why.why)) },
      Some(Body(b)) -> match first_missing(b.tables.calls, set) {
        Some(callee) -> { ..r, out: r.out.push(lost(name, callee)) },
        None ->
          {
            bodies: if heads_its_group(name, b.tables) {
              r.bodies.push({ name: name, text: b.text, tables: b.tables })
            } else { r.bodies },
            symbols: r.symbols.insert(name, defines(name, b.tables)),
            out: r.out,
          },
      },
    })
}

/// Dropping a body can drop its callers, so rounds repeat until one drops nothing; what a round
/// drops it took, so each round takes fewer, and the bodies taken bound the rounds.
fn settle(
  answers: Map<Bytes, Answer>,
  taken: List<Bytes>,
  dropped: List<Dropped>,
) -> Settled / {abort.raise} =
  iterate(
    { taken: taken, dropped: dropped },
    taken.len() + 1,
    |s: { taken: List<Bytes>, dropped: List<Dropped> }| {
      let r = round_over(answers, s.taken);
      if r.out.len() == 0 {
        Stop({ taken: s.taken, bodies: r.bodies, symbols: r.symbols, dropped: s.dropped })
      } else {
        let gone = r.out.fold(Map::new(), |acc: Map<Bytes, Bool>, d: Dropped|
          acc.insert(d.function, true));
        Continue({
          taken: s.taken.filter(|n: Bytes| !gone.contains(n)),
          dropped: s.dropped.concat(r.out),
        })
      }
    },
  )

/// The dropped bodies that are errors, given what was `offered`. A body dropped because a callee was
/// never offered is the offer's doing, as is anything that lost a callee to such a body; every other
/// drop is a definition the program reaches and cannot run.
pub fn fatal(offered: List<Bytes>, dropped: List<Dropped>) -> List<Dropped> / {abort.raise} = {
  let asked = offered.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Bytes| acc.insert(n, true));
  let narrowed = iterate(Map::new(), dropped.len() + 1, |nar: Map<Bytes, Bool>| {
    let grew = dropped.filter(|d: Dropped|
      !nar.contains(d.function)
        && (match d.missing { None -> false, Some(m) -> !asked.contains(m) || nar.contains(m) }));
    if grew.len() == 0 { Stop(nar) } else {
      Continue(grew.fold(nar, |acc: Map<Bytes, Bool>, d: Dropped| acc.insert(d.function, true)))
    }
  });
  dropped.filter(|d: Dropped| !narrowed.contains(d.function))
}

// --- Constants ------------------------------------------------------------------

/// An `Int`'s 64 bits as sixteen hex digits, its sign bit included.
fn hex16(n: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(range(0, 16).map(|i: Int| hex_digit(n >>> 60 - 4 * i & 15)))

/// `n`'s two's-complement pattern at 128 bits, as a cast to `u128` widens it.
fn wide_of(n: Int) -> U128 = if n >= 0 { U128::of_int(n) } else { ~U128::of_int(0 - (n + 1)) }

/// The low 64 bits of `n`, as an unsigned word.
fn word_of(n: Int) -> U128 = wide_of(n) & wrap_sub(1u128 << 64, 1u128)

fn width_bits(w: Int) -> Int =
  if w == 0 || w == 4 { 8 }
  else if w == 1 || w == 5 { 16 }
  else if w == 2 || w == 6 { 32 }
  else if w == 3 || w == 7 { 64 }
  else { 128 }

fn width_signed(w: Int) -> Bool = (w >= 4 && w <= 7) || w == 9

/// Truncated to the width, then zero- or sign-extended: every fixed-width value is held so.
fn normalized(w: Int, bits: U128) -> U128 = {
  let n = width_bits(w);
  if n == 128 { bits } else {
    let low = bits & ~0u128 >>> 128 - n;
    if width_signed(w) && low >>> n - 1 == 1u128 { low | ~0u128 << n } else { low }
  }
}

fn fixed_line(w: Int, bits: U128) -> Bytes =
  Bytes::concat_all([
    b"f ",
    ascii_of_int(w),
    b" ",
    Bytes::of_string(normalized(w, bits).to_string()),
  ])

fn trimmed_m(s: Bytes) -> Bytes / {abort.raise} =
  iterate(s, s.len() + 1, |t: Bytes|
    if t.len() > 0 && t.at(t.len() - 1) == 109 { Continue(t.slice(0, t.len() - 1)) }
    else { Stop(t) })

/// A decimal as its mantissa and scale, read off the text that keeps its scale.
fn decimal_line(literal: Bytes) -> Bytes / {abort.raise} =
  match Decimal::of_string(String::of_bytes(trimmed_m(without(literal, 95)))) {
    None -> panic("the emitter wrote a decimal literal that does not read"),
    Some(d) -> {
      let text = Bytes::of_string(d.to_string());
      let negative = text.len() > 0 && text.at(0) == 45;
      let body = if negative { text.slice(1, text.len()) } else { text };
      let point = match body.index_of(b".") { Some(i) -> i, None -> body.len() };
      let digits = without(body, 46);
      let lead = iterate(0, digits.len() + 1, |i: Int|
        if i < digits.len() - 1 && digits.at(i) == 48 { Continue(i + 1) } else { Stop(i) });
      let mantissa = digits.slice(lead, digits.len());
      let signed = if negative && mantissa != b"0" { b"-".concat(mantissa) } else { mantissa };
      Bytes::concat_all([
        b"d ",
        signed,
        b" ",
        ascii_of_int(if point < body.len() { body.len() - point - 1 } else { 0 }),
      ])
    },
  }

/// One pooled constant's line: its identity, which the pool sorts and deduplicates by, and what the
/// runtime reads it back from. An embedded file's line is its bytes, out of `inputs` by digest.
pub fn const_line(c: Const, inputs: Map<Bytes, Bytes>) -> Bytes / {abort.raise} =
  match c {
    ConstUnit -> b"u",
    ConstStr(s) -> b"s ".concat(hex(s)),
    ConstBytes(b) -> b"b ".concat(hex(b)),
    ConstEmbedded(digest) -> match inputs.get(digest) {
      Some(b) -> b"b ".concat(hex(b)),
      None ->
        panic(
          "a unit holds an embedded file it was not handed the bytes of, which its driver reads for every embed it emits",
        ),
    },
    ConstFixed(f) -> fixed_line(f.width, wide_of(f.bits)),
    ConstWide(x) -> fixed_line(x.width, word_of(x.high) << 64 | word_of(x.low)),
    ConstChar(v) -> b"c ".concat(ascii_of_int(v)),
    ConstFloat(x) -> b"x ".concat(hex16(literal_bits(x))),
    ConstDecimal(x) -> decimal_line(x),
  }

// --- The unit's tables ------------------------------------------------------------

/// What a unit names that is not code, each table sorted by content and each entry once, so a
/// position is a rank among what the unit holds and a body's C is a function of the unit's content.
type Pools = {
  consts: List<Bytes>,
  fields: List<Bytes>,
  builtins: List<Bytes>,
  shapes: List<List<Bytes>>,
  lambdas: List<Bytes>,
}

fn entry_fields() -> List<Bytes> = [b"key", b"value"]

/// `lines` is each unit body's constants as `const_line` writes them, in its table's order.
fn pools_of(
  bodies: List<UnitBody>,
  lines: List<List<Bytes>>,
  constant_entries: List<Bytes>,
) -> Pools / {abort.raise} = {
  let ts = bodies.map(|k: UnitBody| k.tables);
  let all = |pick: (Tables) -> List<Bytes>|
    ts.fold([], |acc: List<Bytes>, tables: Tables| acc.concat(pick(tables)));
  let shapes = ts.fold(
    Map::new().insert(shape_order(entry_fields()), entry_fields()),
    |acc: Map<Bytes, List<Bytes>>, tables: Tables|
      tables.shapes.fold(acc, |into: Map<Bytes, List<Bytes>>, names: List<Bytes>| {
        let s = ordered(names);
        into.insert(shape_order(s), s)
      }),
  );
  {
    consts: ordered(lines.fold([], |acc: List<Bytes>, ls: List<Bytes>| acc.concat(ls))),
    fields: ordered(all(|tables: Tables| tables.fields)),
    builtins: ordered(all(|tables: Tables| tables.builtins)),
    shapes: shapes.values(),
    lambdas: ordered(constant_entries.concat(all(|tables: Tables| tables.lambdas))),
  }
}

type Placed = {
  consts: Map<Bytes, Int>,
  fields: Map<Bytes, Int>,
  builtins: Map<Bytes, Int>,
  shapes: Map<Bytes, Int>,
  lambdas: Map<Bytes, Int>,
}

fn placed_of(p: Pools) -> Placed / {abort.raise} =
  {
    consts: positions(p.consts),
    fields: positions(p.fields),
    builtins: positions(p.builtins),
    shapes: positions(p.shapes.map(shape_key)),
    lambdas: positions(p.lambdas),
  }

fn place(m: Map<Bytes, Int>, key: Bytes) -> Int / {abort.raise} =
  match m.get(key) {
    Some(i) -> i,
    None -> panic("the unit's tables hold everything its bodies name"),
  }

// --- Sites ----------------------------------------------------------------------

/// The bucket a body compiles in: the top bits of its root id, so it is a function of the name
/// alone and an edit recompiles the one bucket holding the body.
pub fn bucket_of(name: Bytes) -> Int = root_id(name) >>> 57

fn bucket_mark(id: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([b"/* --- bucket ", hex_digit(id / 16), hex_digit(id % 16), b" --- */"])

/// A placeholder in a body's C, `@@kN@@`: where it opens and closes, its kind byte, and what
/// follows the kind.
type Hole = { open: Int, close: Int, kind: Int, digits: Bytes }

fn holes(text: Bytes) -> List<Hole> / {abort.raise} =
  iterate({ from: 0, out: [] }, text.len() + 1, |s: { from: Int, out: List<Hole> }|
    match text.index_of_from(b"@@", s.from) {
      None -> Stop(s.out),
      Some(open) -> match text.index_of_from(b"@@", open + 2) {
        None -> panic("an emitted placeholder always closes"),
        Some(close) ->
          Continue({
            from: close + 2,
            out: s.out.push({
              open: open,
              close: close,
              kind: text.at(open + 2),
              digits: text.slice(open + 3, close),
            }),
          }),
      },
    })

/// What a placeholder names in the unit's tables, its kind leading so a bucket's table sorts by
/// kind; `None` for a root, written as its id. `lines` is the body's constants as the pool holds them.
fn hole_key(h: Hole, tables: Tables, lines: List<Bytes>) -> Option<Bytes> / {abort.raise} =
  if h.kind == 84 { Some(b"T".concat(h.digits)) }
  else if h.kind == 114 { None } else {
    let i = digits(h.digits);
    if h.kind == 99 { Some(b"c".concat(lines.get(i))) }
    else if h.kind == 98 { Some(b"b".concat(tables.builtins.get(i))) }
    else if h.kind == 102 { Some(b"f".concat(tables.fields.get(i))) }
    else if h.kind == 115 { Some(b"s".concat(shape_key(ordered(tables.shapes.get(i))))) }
    else if h.kind == 108 { Some(b"l".concat(tables.lambdas.get(i))) }
    else { panic("an emitted placeholder of no kind the unit resolves") }
  }

/// A key's position in the unit's table of its kind, which is what the loader writes for it.
fn unit_place(key: Bytes, p: Placed, tags: Map<Bytes, Int>) -> Int / {abort.raise} = {
  let kind = key.at(0);
  let rest = key.slice(1, key.len());
  if kind == 84 { place(tags, rest) }
  else if kind == 99 { place(p.consts, rest) }
  else if kind == 98 { place(p.builtins, rest) }
  else if kind == 102 { place(p.fields, rest) }
  else if kind == 115 { place(p.shapes, rest) }
  else { place(p.lambdas, rest) }
}

/// The table a bucket's C reads the unit's positions from, which the loader fills.
fn bucket_table(id: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([b"ply_bk_", hex_digit(id / 16), hex_digit(id % 16)])

/// A body's C with each placeholder written as its bucket names it: a root as its id, and the rest
/// as a position in the bucket's own table, so the C reads the same whatever else the unit holds.
fn resolved(
  text: Bytes,
  hs: List<Hole>,
  keys: List<Option<Bytes>>,
  tables: Tables,
  name: Bytes,
  table: Bytes,
  local: Map<Bytes, Int>,
) -> Bytes / {abort.raise} = {
  let walked = range(0, hs.len()).fold(
    { from: 0, out: [] },
    |s: { from: Int, out: List<Bytes> }, i: Int| {
      let h = hs.get(i);
      let value = match keys.get(i) {
        None ->
          ascii_of_int(if h.digits.len() == 0 { root_id(own_definition(name)) }
          else { root_id(tables.members.get(digits(h.digits))) }),
        Some(k) -> Bytes::concat_all([table, b"[", ascii_of_int(place(local, k)), b"]"]),
      };
      { from: h.close + 2, out: s.out.push(text.slice(s.from, h.open)).push(value) }
    },
  );
  Bytes::concat_all(walked.out.push(text.slice(walked.from, text.len())))
}

// --- What the unit says about itself ---------------------------------------------

type Taken = { name: Bytes, arity: Int, symbol: Bytes, entry: Bytes, head: Head }

fn counted(label: Bytes, n: Int) -> Bytes = Bytes::concat_all([label, b" ", ascii_of_int(n), b"\n"])

fn lines(label: Bytes, xs: List<Bytes>) -> Bytes =
  Bytes::concat_all([counted(label, xs.len())].concat(xs.map(|x: Bytes| x.concat(b"\n"))))

/// A bucket's table: the unit's position for each of the bucket's keys.
type BucketRow = { id: Int, places: List<Int> }

/// What a unit says about itself for its loader to read: the helpers it binds, its constructors,
/// each constant with its row of the code table, and the pools its positions index. What the loader
/// takes by address, `laid` lays out instead.
fn exports_text(
  helpers: List<Helper>,
  ctors: List<Ctor>,
  taken: List<Taken>,
  constants: List<Bytes>,
  modules: Int,
  dropped: List<Dropped>,
  p: Pools,
  stated: List<Stated>,
) -> Bytes / {abort.raise} = {
  let held = taken.fold(Map::new(), |acc: Map<Bytes, Bool>, t: Taken| acc.insert(t.name, true));
  // `-` where the type states none, and `!` for a function the unit does not take, which a value
  // read through it there is refused by.
  let written = |f: Option<Bytes>|
    match f { None -> b"-", Some(name) -> if held.contains(name) { name } else { b"!" } };
  Bytes::concat_all([
    lines(
      b"helpers",
      helpers.map(|h: Helper|
        Bytes::concat_all([h.name, b" ", ascii_of_int(h.args), b" ", dump_flag(h.answers)])),
    ),
    lines(
      b"ctors",
      ctors.map(|c: Ctor|
        Bytes::concat_all(
          [c.name, b" ", ascii_of_int(c.arity)].concat(c.args.map(|a: Bytes| b" ".concat(a))),
        )),
    ),
    lines(b"constants", constants),
    counted(b"modules", modules),
    counted(b"refused", dropped.len()),
    Bytes::concat_all(
      dropped.map(|d: Dropped| Bytes::concat_all([d.function, b"\n", d.construct, b"\n"])),
    ),
    lines(b"consts", p.consts),
    lines(b"builtins", p.builtins),
    lines(b"fields", p.fields),
    lines(
      b"shapes",
      p.shapes.map(|names: List<Bytes>|
        range(0, names.len()).fold(b"", |acc: Bytes, i: Int|
          if i == 0 { names.get(i) } else { Bytes::concat_all([acc, b" ", names.get(i)]) })),
    ),
    // Only a unit one of whose types states either says so, so any other reads as it always did.
    if stated.len() == 0 { b"" } else {
      lines(
        b"instances",
        stated.map(|x: Stated|
          x.numeric.fold(
            Bytes::concat_all([x.ctor, b" ", written(x.key), b" ", written(x.show)]),
            |row: Bytes, f: Bytes| Bytes::concat_all([row, b" ", written(Some(f))]),
          )),
      )
    },
    // The runtime lays an `Int`, a `Decimal`, a bytes slice and an `Option` out as this unit's C
    // reads them: `RAW_INTS`, `RAW_DECIMALS`, `BYTES_VIEWS` and `OPTION_WORDS` in `exports.rs`.
    b"ints held raw\n",
    b"decimals held raw\n",
    b"bytes slices are views\n",
    b"options held as their payload's word\n",
  ])
}

fn octal(b: Int) -> Bytes =
  Bytes::concat_all([b"\\", ascii_of_int(b / 64), ascii_of_int(b / 8 % 8), ascii_of_int(b % 8)])

/// The bytes a C string literal holds as they are: the printable ones but for the quote, the
/// backslash and `?`, which could open a trigraph.
fn plain() -> Bytes / {abort.raise} =
  Bytes::concat_all(range(32, 127).filter(|b: Int| b != 34 && b != 63 && b != 92).map(byte_of_int))

fn escaped(piece: Bytes) -> Bytes / {abort.raise} = {
  let n = piece.len();
  Bytes::concat_all(
    iterate({ from: 0, out: [] }, n + 1, |s: { from: Int, out: List<Bytes> }|
      if s.from >= n { Stop(s.out) } else {
        let stop = piece.scan(s.from, plain(), n - s.from);
        if stop > s.from { Continue({ from: stop, out: s.out.push(piece.slice(s.from, stop)) }) }
        else {
          let b = piece.at(s.from);
          Continue({
            from: s.from + 1,
            out: s.out.push(if b == 34 { b"\\\"" } else if b == 92 { b"\\\\" } else { octal(b) }),
          })
        }
      }),
  )
}

/// Bytes per C string literal, so no literal exceeds what compilers accept.
fn piece_len() -> Int = 2000

fn literal_lines(line: Bytes) -> Bytes / {abort.raise} = {
  let n = line.len();
  let count = if n == 0 { 1 } else { (n + piece_len() - 1) / piece_len() };
  Bytes::concat_all(
    range(0, count).map(|i: Int| {
      let piece = line.slice(i * piece_len(), if (i + 1) * piece_len() < n { (i + 1) * piece_len() }
      else { n });
      Bytes::concat_all([b"\"", escaped(piece), if i == count - 1 { b"\\n" } else { b"" }, b"\"\n"])
    }),
  )
}

/// The text's lines as `str::lines` reads them: a final newline ends the last line rather than
/// opening another, and a carriage return before a newline is part of the ending.
fn split_lines(text: Bytes) -> List<Bytes> / {abort.raise} = {
  let parts = text.split(b"\n");
  let whole = if parts.len() > 0 && parts.get(parts.len() - 1).len() == 0 {
    parts.take(parts.len() - 1)
  } else { parts };
  whole.map(|l: Bytes|
    if l.len() > 0 && l.at(l.len() - 1) == 13 { l.slice(0, l.len() - 1) } else { l })
}

/// The table as C string literals, non-printable bytes and `?` in octal.
fn embedded(exports: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\n/* --- what this unit says about itself, read by the loader --- */\n",
    b"const char ply_exports[] =\n",
    Bytes::concat_all(split_lines(exports).map(literal_lines)),
    b";\n",
  ])

/// What the loader takes by address, so it looks no symbol up and fills no table: each bucket's
/// table holding the unit's positions, the code table in the unit's order, each of `taken` by name
/// in byte order with its entry and how many words it takes, and `ply_descriptor`, which holds
/// those beside what the unit says about itself and its two binders. A native program's `main`
/// hands the runtime the descriptor, so the program exports nothing for `dlsym` to find. The code
/// and the entries are defined in the buckets' objects, and a table closes with a zero so that none
/// is empty.
fn laid(
  taken: List<Taken>,
  lambdas: List<Bytes>,
  buckets: List<BucketRow>,
) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\n/* --- what the loader takes by address --- */\n",
    Bytes::concat_all(
      buckets.map(|r: BucketRow|
        Bytes::concat_all([
          b"const uint32_t ",
          bucket_table(r.id),
          b"[] = {",
          Bytes::concat_all(
            r.places.map(|n: Int| Bytes::concat_all([b" ", ascii_of_int(n), b","])),
          ),
          b" };\n",
        ])),
    ),
    Bytes::concat_all(
      ordered(lambdas.concat(taken.map(|t: Taken| t.entry))).map(|n: Bytes|
        Bytes::concat_all([b"extern char ", n, b";\n"])),
    ),
    b"void *const ply_code[] = {\n",
    Bytes::concat_all(lambdas.map(|n: Bytes| Bytes::concat_all([b"  (void *)&", n, b",\n"]))),
    b"  0 };\n",
    b"struct ply_taken { const char *name; void *entry; unsigned long arity; };\n",
    b"const struct ply_taken ply_taken[] = {\n",
    Bytes::concat_all(
      taken.map(|t: Taken|
        Bytes::concat_all([
          b"  { \"",
          escaped(t.name),
          b"\", (void *)&",
          t.entry,
          b", ",
          ascii_of_int(t.arity),
          b" },\n",
        ])),
    ),
    b"  { 0, 0, 0 } };\n",
    b"struct ply_descriptor { const char *exports; unsigned long exports_len; void *bind; void *bind_singletons; void *const *code; unsigned long code_count; const struct ply_taken *taken; unsigned long taken_count; };\n",
    b"const struct ply_descriptor ply_descriptor = { ply_exports, sizeof ply_exports - 1, (void *)ply_bind, (void *)ply_bind_singletons, ply_code, ",
    ascii_of_int(lambdas.len()),
    b", ply_taken, ",
    ascii_of_int(taken.len()),
    b" };\n",
  ])

// --- Placing it -----------------------------------------------------------------

type Placing = {
  name: Bytes,
  bucket: Int,
  text: Bytes,
  reaches: List<Bytes>,
  /// The definitions its C defines: a group's members, or its own.
  defines: List<Bytes>,
}

/// A body's placeholders and what each names, which its bucket's table is made of.
type Marked = { body: UnitBody, holes: List<Hole>, keys: List<Option<Bytes>> }

/// What a body's C names of the unit's definitions: its own, a group's every member, and its calls.
fn reaches_of(name: Bytes, tables: Tables) -> List<Bytes> =
  ordered(tables.calls.concat(if tables.members.len() == 0 { [name] } else { tables.members }))

fn prototype(symbol: Bytes, head: Head) -> Bytes =
  Bytes::concat_all([
    head.answer,
    b" ",
    symbol,
    b"(PlyCtx*",
    Bytes::concat_all(head.params.map(|t: Bytes| b", ".concat(t))),
    b");\n",
  ])

fn far_table(id: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([b"ply_far_", hex_digit(id / 16), hex_digit(id % 16)])

/// Where the head defines `PLY_FAR`, each of `reached`, a bucket's calls into other buckets, is
/// called through `table`, an address apiece: a load and a call of what it loads, which reaches
/// anywhere, where a call of the function's name reaches only so far.
fn far_calls(table: Bytes, reached: List<Taken>) -> Bytes / {abort.raise} =
  if reached.len() == 0 { b"" } else {
    Bytes::concat_all([
      b"#ifdef PLY_FAR\nstatic void *const ",
      table,
      b"[] = {",
      Bytes::concat_all(reached.map(|t: Taken| Bytes::concat_all([b" (void *)&", t.symbol, b","]))),
      b" 0 };\n",
      Bytes::concat_all(
        range(0, reached.len()).map(|i: Int| {
          let t = reached.get(i);
          Bytes::concat_all([
            b"#define ",
            t.symbol,
            b"(...) ((",
            t.head.answer,
            b" (*)(PlyCtx*",
            Bytes::concat_all(t.head.params.map(|p: Bytes| b", ".concat(p))),
            b"))",
            table,
            b"[",
            ascii_of_int(i),
            b"])(__VA_ARGS__)\n",
          ])
        }),
      ),
      b"#endif\n",
    ])
  }

/// The end of what [`far_calls`] defines, so the bucket after this one reads its names as written.
fn far_ended(reached: List<Taken>) -> Bytes =
  if reached.len() == 0 { b"" } else {
    Bytes::concat_all([
      b"#ifdef PLY_FAR\n",
      Bytes::concat_all(reached.map(|t: Taken| Bytes::concat_all([b"#undef ", t.symbol, b"\n"]))),
      b"#endif\n",
    ])
  }

fn bucket_key(p: Placing) -> Bytes / {abort.raise} =
  Bytes::concat_all([hex_digit(p.bucket / 16), hex_digit(p.bucket % 16), b"\x00", p.name])

/// The header, then a marked bucket per class of names, which declares its table and the
/// prototypes of what its bodies reach, then the runtime's definitions, what the unit says about
/// itself and `tables`, what it lays out for its loader: one translation unit that the loader also
/// compiles in parts, cut on the marks. A bucket declares its table and never defines it, so its C
/// reads the same whatever positions the table holds, and calls what another defines as
/// [`far_calls`] says.
fn assembled(
  runtime: Runtime,
  bodies: List<Placing>,
  sizes: Map<Int, Int>,
  taken: Map<Bytes, Taken>,
  exports: Bytes,
  tables: Bytes,
) -> Bytes / {abort.raise} = {
  let by_bucket = bodies.fold(Map::new(), |acc: Map<Bytes, Placing>, p: Placing|
    acc.insert(bucket_key(p), p));
  let groups = by_bucket.values().fold([], |acc: List<List<Placing>>, p: Placing| {
    let last = acc.len() - 1;
    if last >= 0 && acc.get(last).get(0).bucket == p.bucket { acc.set(last, acc.get(last).push(p)) }
    else { acc.push([p]) }
  });
  let reached_by = |group: List<Placing>| {
    let here = group.fold(Map::new(), |acc: Map<Bytes, Bool>, p: Placing|
      p.defines.fold(acc, |a: Map<Bytes, Bool>, n: Bytes| a.insert(n, true)));
    ordered(group.fold([], |acc: List<Bytes>, p: Placing| acc.concat(p.reaches))).fold(
      [],
      |acc: List<Taken>, name: Bytes|
        if here.contains(name) { acc }
        else { match taken.get(name) { Some(t) -> acc.push(t), None -> acc } },
    )
  };
  Bytes::concat_all([
    runtime.head,
    Bytes::concat_all(
      groups.map(|group: List<Placing>| {
        let reached = reached_by(group);
        Bytes::concat_all([
          bucket_mark(group.get(0).bucket),
          b"\n",
          match sizes.get(group.get(0).bucket) {
            Some(n) -> if n == 0 { b"" } else {
              Bytes::concat_all([
                b"extern const uint32_t ",
                bucket_table(group.get(0).bucket),
                b"[];\n",
              ])
            },
            None -> b"",
          },
          Bytes::concat_all(
            ordered(group.fold([], |acc: List<Bytes>, p: Placing| acc.concat(p.reaches))).map(
              |name: Bytes|
                match taken.get(name) { Some(t) -> prototype(t.symbol, t.head), None -> b"" },
            ),
          ),
          far_calls(far_table(group.get(0).bucket), reached),
          b"\n",
          Bytes::concat_all(group.map(|p: Placing| p.text.concat(b"\n"))),
          far_ended(reached),
        ])
      }),
    ),
    runtime.tail,
    embedded(exports),
    tables,
  ])
}

/// The unit over `offered`, from each root's answer: closed under calls, its tables sorted by
/// content, its bodies resolved against them and bucketed, and what it holds embedded in its C.
/// `modules` is how many modules the program it was emitted from has, and `inputs` the bytes of
/// each file it embeds, by digest.
pub fn produce(
  runtime: Runtime,
  ctors: List<Ctor>,
  offered: List<Offered>,
  modules: Int,
  answers: Map<Bytes, Answer>,
  inputs: Map<Bytes, Bytes>,
  stated: List<Stated> = [],
) -> Produced / {abort.raise} = {
  let arity = offered.fold(Map::new(), |acc: Map<Bytes, Offered>, o: Offered|
    acc.insert(o.name, o));
  let s = settle(answers, ordered(offered.map(|o: Offered| o.name)), []);
  let published = |n: Bytes|
    match s.symbols.get(n) {
      Some(d) -> d,
      None -> panic("every definition a unit takes emitted, and an emitted body publishes its C"),
    };
  let constants = s.taken.filter(|n: Bytes|
    match arity.get(n) { Some(o) -> o.constant, None -> false });
  let lines = s.bodies.map(|k: UnitBody| k.tables.consts.map(|c: Const| const_line(c, inputs)));
  let pools = pools_of(s.bodies, lines, constants.map(|n: Bytes| published(n).entry));
  let placed = placed_of(pools);
  let tags = positions(ctors.map(|c: Ctor| c.name));
  let taken = s.taken.map(|n: Bytes| {
    let d = published(n);
    {
      name: n,
      arity: match arity.get(n) { Some(o) -> o.arity, None -> 0 },
      symbol: d.symbol,
      entry: d.entry,
      head: d.head,
    }
  });
  // Each call was written to the head its caller read; the callee's own must be that head.
  s.bodies.fold((), |_u: Unit, k: UnitBody|
    k.tables.generics.expects.fold((), |_v: Unit, e: Expect|
      match s.symbols.get(e.callee) {
        Some(d) -> if d.head != e.head {
          panic(
            String::of_bytes_lossy(
              Bytes::concat_all([
                b"`",
                k.name,
                b"` calls `",
                e.callee,
                b"` as ",
                prototype(d.symbol, e.head),
                b"which it defines as ",
                prototype(d.symbol, d.head),
              ]),
            ),
          )
        } else { () },
        None -> (),
      }));
  let marked = range(0, s.bodies.len()).map(|i: Int| {
    let k = s.bodies.get(i);
    let hs = holes(k.text);
    { body: k, holes: hs, keys: hs.map(|h: Hole| hole_key(h, k.tables, lines.get(i))) }
  });
  // Each bucket's table: every key its bodies' placeholders name, once, in byte order.
  let keyed = marked.fold(Map::new(), |acc: Map<Int, Map<Bytes, Bool>>, m: Marked| {
    let b = bucket_of(m.body.name);
    acc.insert(
      b,
      m.keys.fold(
        match acc.get(b) { Some(x) -> x, None -> Map::new() },
        |ks: Map<Bytes, Bool>, k: Option<Bytes>|
          match k { Some(key) -> ks.insert(key, true), None -> ks },
      ),
    )
  });
  let locals = keyed.fold(
    Map::new(),
    |acc: Map<Int, Map<Bytes, Int>>, b: Int, ks: Map<Bytes, Bool>|
      acc.insert(b, positions(ks.keys())),
  );
  let bodies = marked.map(|m: Marked| {
    let b = bucket_of(m.body.name);
    {
      name: m.body.name,
      bucket: b,
      text: resolved(
        m.body.text,
        m.holes,
        m.keys,
        m.body.tables,
        m.body.name,
        bucket_table(b),
        match locals.get(b) { Some(l) -> l, None -> Map::new() },
      ),
      reaches: reaches_of(m.body.name, m.body.tables),
      defines: answered(m.body),
    }
  });
  let rows = keyed.fold([], |acc: List<BucketRow>, b: Int, ks: Map<Bytes, Bool>|
    if ks.len() == 0 { acc }
    else { acc.push({ id: b, places: ks.keys().map(|k: Bytes| unit_place(k, placed, tags)) }) });
  let exports = exports_text(
    runtime.helpers,
    ctors,
    taken,
    constants.map(|n: Bytes|
      Bytes::concat_all([n, b" ", ascii_of_int(place(placed.lambdas, published(n).entry))])),
    modules,
    s.dropped,
    pools,
    stated,
  );
  let by_name = taken.fold(Map::new(), |acc: Map<Bytes, Taken>, t: Taken| acc.insert(t.name, t));
  {
    text: assembled(
      runtime,
      bodies,
      keyed.fold(Map::new(), |acc: Map<Int, Int>, b: Int, ks: Map<Bytes, Bool>|
        acc.insert(b, ks.len())),
      by_name,
      exports,
      laid(by_name.values(), pools.lambdas, rows),
    ),
    taken: s.taken,
    dropped: s.dropped,
    made: { bodies: s.bodies, offered: offered },
  }
}

// --- What a root runs ----------------------------------------------------------

/// The names a body answers for: a group's members, or its own.
fn answered(body: UnitBody) -> List<Bytes> =
  if body.tables.members.len() == 0 { [body.name] } else { body.tables.members }

/// How a body's roots were offered, which places them: a constant is held rather than called.
fn offered_as(roots: Map<Bytes, Offered>, body: UnitBody) -> Bytes =
  Bytes::concat_all(
    answered(body).map(|name: Bytes|
      match roots.get(name) {
        Some(o) ->
          Bytes::concat_all([
            name,
            b" ",
            ascii_of_int(o.arity),
            if o.constant { b" constant\n" } else { b"\n" },
          ]),
        None -> name.concat(b" unoffered\n"),
      }),
  )

/// What each root of a unit runs, as one digest: its own body and every body it can call, whatever
/// the calls' cycles. A body is digested as the unit keeps it, before placing, so a root that two
/// compilers or two units made into the same code is named alike by both.
pub fn codes(made: Made) -> Map<Bytes, Bytes> / {abort.raise} = {
  let bodies = made.bodies;
  let n = bodies.len();
  let index = range(0, n).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int|
    answered(bodies.get(i)).fold(acc, |m: Map<Bytes, Int>, name: Bytes| m.insert(name, i)));
  let roots = made.offered.fold(Map::new(), |acc: Map<Bytes, Offered>, o: Offered|
    acc.insert(o.name, o));
  let own = bodies.map(|b: UnitBody|
    blake3(
      Bytes::concat_all([
        blake3(b.name),
        blake3(b.text),
        blake3(bin::encode(b.tables, tables_bin())),
        blake3(offered_as(roots, b)),
      ]),
    ));
  let adj = bodies.map(|b: UnitBody|
    b.tables.calls.fold([], |acc: List<Int>, c: Bytes|
      match index.get(c) { Some(j) -> acc.push(j), None -> acc }));
  // Components come callees first, so each folds in the digests of those it reaches.
  let components = graph::components({ out: adj });
  let reached = components.fold(Map::new(), |done: Map<Int, Bytes>, comp: List<Int>| {
    let inside = comp.fold(Map::new(), |m: Map<Int, Bool>, i: Int| m.insert(i, true));
    let below = comp.fold([], |acc: List<Bytes>, i: Int|
      adj.get(i).fold(acc, |a: List<Bytes>, j: Int|
        if inside.contains(j) { a }
        else { match done.get(j) { Some(d) -> a.push(d), None -> a } }));
    let digest = blake3(
      Bytes::concat_all(ordered(comp.map(|i: Int| own.get(i))).concat(ordered(below))),
    );
    comp.fold(done, |m: Map<Int, Bytes>, i: Int| m.insert(i, digest))
  });
  range(0, n).fold(Map::new(), |acc: Map<Bytes, Bytes>, i: Int| {
    let code = blake3(own.get(i).concat(match reached.get(i) { Some(d) -> d, None -> b"" }));
    answered(bodies.get(i)).fold(acc, |m: Map<Bytes, Bytes>, name: Bytes| m.insert(name, code))
  })
}

// --- Emitting what no earlier run kept --------------------------------------------

/// What the front end's answer says the emitter works over: each root, the modules in program order,
/// and what each module imports.
type Program = {
  roots: Map<Bytes, EmitterRoot>,
  keys: Map<Bytes, Bytes>,
  modules: List<ModuleRow>,
  imports: Map<Bytes, List<Bytes>>,
  sources: List<Bytes>,
  /// A digest of what each module embeds, by its index: the emitter writes each call out as its bytes.
  embeds: Map<Int, Bytes>,
}

fn program_of(dump: Dump, sources: List<Bytes>) -> Program = {
  let by_name = dump.modules.fold(Map::new(), |acc: Map<Bytes, ModuleRow>, m: ModuleRow|
    acc.insert(m.name, m));
  let reads = dump.embeds.fold(Map::new(), |acc: Map<Int, List<Bytes>>, e: EmbedAt|
    match by_name.get(e.module) {
      None -> acc,
      Some(m) ->
        acc.insert(
          m.index,
          List::push(
            match acc.get(m.index) { Some(xs) -> xs, None -> [] },
            sized(e.key).concat(read_key(e.read)),
          ),
        ),
    });
  {
    roots: dump.emitter_roots.fold(Map::new(), |acc: Map<Bytes, EmitterRoot>, root: EmitterRoot|
      acc.insert(root.root, root)),
    keys: dump.keys.fold(Map::new(), |acc: Map<Bytes, Bytes>, k: KeyRow| acc.insert(k.root, k.key)),
    // The emitter walks modules in the front end's ordinal order, so this order is not ours to pick.
    modules: dump.ordinals.fold([], |acc: List<ModuleRow>, o: OrdinalRow|
      match by_name.get(o.module) { Some(m) -> acc.push(m), None -> acc }),
    imports: by_name.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, n: Bytes, m: ModuleRow|
      acc.insert(n, m.imports)),
    sources: sources,
    embeds: reads.fold(Map::new(), |acc: Map<Int, Bytes>, i: Int, parts: List<Bytes>|
      acc.insert(i, blake3(Bytes::concat_all(ordered(parts))))),
  }
}

fn text_at(program: Program, index: Int) -> Option<Bytes> = program.sources.at(index)

/// The home modules each of `modules` calls a function of a type of with no import, as the front
/// end pulled them for it ([`homes_called`]): the checker names each such function through a binder
/// of its home, which no import of the module reaches.
fn homes_called_by(program: Program, modules: List<Bytes>) -> List<Bytes> / {abort.raise} = {
  let texts = program.modules.fold(Map::new(), |acc: Map<Bytes, Bytes>, m: ModuleRow|
    match text_at(program, m.index) { Some(t) -> acc.insert(m.name, t), None -> acc });
  let declared = homes_declaring(|h: Bytes| texts.get(h));
  modules.fold([], |acc: List<Bytes>, m: Bytes|
    match texts.get(m) {
      Some(t) -> acc.concat(homes_called(m, parsing::start(t).input, || declared)),
      None -> acc,
    })
}

/// `modules` and every module they import, directly or not: all the emitter reads to lower a body
/// of one of them.
fn imported(program: Program, modules: List<Bytes>) -> Map<Bytes, Bool> / {abort.raise} = {
  let start = ordered(modules);
  iterate(
    { seen: Map::new(), stack: start },
    start.len() + program.imports.fold(1, |n: Int, _: Bytes, xs: List<Bytes>| n + xs.len()),
    |s: { seen: Map<Bytes, Bool>, stack: List<Bytes> }|
      match s.stack {
        [] -> Stop(s.seen),
        [m, ..rest] -> if s.seen.contains(m) { Continue({ seen: s.seen, stack: rest }) } else {
          Continue({
            seen: s.seen.insert(m, true),
            stack: rest.concat(match program.imports.get(m) { Some(xs) -> xs, None -> [] }),
          })
        },
      },
  )
}

/// What a kept answer is a function of beyond the emitter and the runtime: the root's name, the key
/// the front end gave it, the text it is written in, since its sites are offsets into that text, and
/// what its module embeds, which that text's calls are written out as; for a specialisation, the
/// kinds it is at and the definitions whose lambdas it runs; for a root written from a type, its
/// module's text and the program's `types`, which together say how it is written. `None` for a root
/// with no key or no place, which is asked again every time.
fn root_material(program: Program, types: Bytes, name: Bytes) -> Option<Bytes> / {abort.raise} =
  if derived_of(name) != None {
    let home = module_of_root(name);
    match program.modules.fold(None, |acc: Option<Int>, m: ModuleRow|
        if m.name == home { Some(m.index) } else { acc }) {
      None -> None,
      Some(i) -> match text_at(program, i) {
        None -> None,
        Some(text) -> Some(Bytes::concat_all([name, b"\x00", types, b"\x00", blake3(text)])),
      },
    }
  } else {
    match specialisation_of(name) {
      Some(s) ->
        s.fns.fold(
          match definition_material(program, s.base) {
            Some(m) -> Some(Bytes::concat_all([m, b"\x00", name])),
            None -> None,
          },
          |acc: Option<Bytes>, f: FnArg|
            match acc {
              None -> None,
              Some(m) -> match definition_material(program, own_definition(f.owner)) {
                Some(o) -> Some(Bytes::concat_all([m, b"\x00", o])),
                None -> None,
              },
            },
        ),
      None -> definition_material(program, name),
    }
  }

/// What a root written from a type reads of the program beyond its module: each constructor, the
/// type it makes of its arguments' types, and what each type states.
fn types_material(dump: Dump) -> Bytes / {abort.raise} =
  blake3(
    Bytes::concat_all(
      dump.ctors.map(|c: CtorRow|
        Bytes::concat_all([
          c.name,
          b"\x00",
          ascii_of_int(c.index),
          b"\x00",
          type_text(c.scheme.ty),
          b"\x01",
        ])).concat(
        dump.emitter_ctors.map(|c: EmitterCtor|
          Bytes::concat_all([
            c.name,
            b"\x00",
            match c.key { Some(k) -> k, None -> b"" },
            b"\x00",
            match c.show { Some(s) -> s, None -> b"" },
            b"\x00",
            Bytes::concat_all(c.numeric.map(|f: Bytes| f.concat(b","))),
            b"\x01",
          ])),
      ),
    ),
  )

fn definition_material(program: Program, name: Bytes) -> Option<Bytes> =
  match program.keys.get(name) {
    None -> None,
    Some(key) -> match program.roots.get(name) {
      None -> None,
      Some(r) -> match text_at(program, r.at.module) {
        None -> None,
        Some(text) -> if r.at.start < 0 || r.at.end > text.len() || r.at.start > r.at.end { None }
        else {
          Some(
            Bytes::concat_all([
              name,
              b"\x00",
              key,
              b"\x00",
              blake3(text.slice(r.at.start, r.at.end)),
              match program.embeds.get(r.at.module) { Some(d) -> d, None -> b"" },
            ]),
          )
        },
      },
    },
  }

fn kept_key(parts: List<Bytes>) -> Bytes / {abort.raise} =
  hex(blake3(Bytes::concat_all(parts.map(|b: Bytes| b.concat(b"\x00")))))

/// A group's kept body stands only when every member is offered and each member's kept answer is
/// that same group; otherwise the group is asked again, and the emitter groups what is wanted now.
fn standing(looked: Map<Bytes, Answer>, offered: Map<Bytes, Bool>) -> Map<Bytes, Answer> =
  looked.fold(Map::new(), |acc: Map<Bytes, Answer>, n: Bytes, a: Answer|
    match a {
      Refused(_) -> acc,
      Body(b) -> if b.tables.members.fold(true, |ok: Bool, m: Bytes|
          ok && offered.contains(m)
            && (match looked.get(m) {
              Some(Body(other)) -> other.tables.members == b.tables.members,
              _ -> false,
            })) { acc.insert(n, a) }
      else { acc },
    })

/// A callee a kept body names, with the key it had. A key reads its callees by hash and the C calls
/// them by name, so two callees that hash alike under two names share a key and not a body.
type Callee = { name: Bytes, key: Option<Bytes> }
type Kept = { answer: Answer, callees: List<Callee> }

derive bin for Callee
derive bin for Kept

fn kept_of(keys: Map<Bytes, Bytes>, a: Answer) -> Kept =
  {
    answer: a,
    callees: match a {
      Body(b) -> ordered(b.tables.calls).map(|c: Bytes| { name: c, key: keys.get(c) }),
      Refused(_) -> [],
    },
  }

fn holds(keys: Map<Bytes, Bytes>, callees: List<Callee>) -> Bool =
  callees.fold(true, |ok: Bool, c: Callee| ok && keys.get(c.name) == c.key)

fn decoded(keys: Map<Bytes, Bytes>, bytes: Option<Bytes>) -> Option<Answer> / {abort.raise} =
  match bytes {
    None -> None,
    Some(b) -> match bin::decode(b, kept_bin()) {
      Ok(k) -> if holds(keys, k.callees) { Some(k.answer) } else { None },
      Err(_) -> None,
    },
  }

/// The bodies a bucket's roots had, kept as one answer so a run reads a file per bucket.
type Packed = { name: Bytes, kept: Kept }
type Pack = { rows: List<Packed> }

derive bin for Packed
derive bin for Pack

/// A row whose callees moved is a root the pack holds no body for, which the emitter is asked again.
fn unpacked(
  keys: Map<Bytes, Bytes>,
  bytes: Option<Bytes>,
) -> Option<Map<Bytes, Answer>> / {abort.raise} =
  match bytes {
    None -> None,
    Some(b) -> match bin::decode(b, pack_bin()) {
      Ok(p) ->
        Some(
          p.rows.fold(Map::new(), |acc: Map<Bytes, Answer>, r: Packed|
            if holds(keys, r.kept.callees) { acc.insert(r.name, r.kept.answer) } else { acc }),
        ),
      Err(_) -> None,
    },
  }

/// Each bucket's roots, by name.
fn bucketed(names: List<Bytes>) -> Map<Int, List<Bytes>> =
  names.fold(Map::new(), |acc: Map<Int, List<Bytes>>, n: Bytes| {
    let b = bucket_of(n);
    acc.insert(b, List::push(match acc.get(b) { Some(xs) -> xs, None -> [] }, n))
  })

/// Each root's body as an earlier run kept it, `materials` naming what each is a function of: a
/// bucket's pack, the bodies its roots had when it was written, before a root's own body. A refusal
/// is never kept: what the emitter refuses may be the program's doing, which no material names.
fn looked_up<| e>(
  materials: Map<Bytes, Bytes>,
  packs: Map<Int, Map<Bytes, Answer>>,
  body: (Bytes) -> Option<Answer> / e,
) -> Map<Bytes, Answer> / e =
  materials.fold(Map::new(), |acc: Map<Bytes, Answer>, n: Bytes, m: Bytes| {
    let found = match packs.get(bucket_of(n)) { Some(packed) -> packed.get(n), None -> body(m) };
    match found { Some(a) -> acc.insert(n, a), None -> acc }
  })

type Repack = { names: List<Bytes>, pack: Pack }

/// The packs to write: each bucket's that was missing or in which a root gained a body now, holding
/// every body its roots have.
fn repacked(
  keys: Map<Bytes, Bytes>,
  buckets: Map<Int, List<Bytes>>,
  packs: Map<Int, Map<Bytes, Answer>>,
  looked: Map<Bytes, Answer>,
  answered: Map<Bytes, Answer>,
) -> List<Repack> =
  buckets.fold([], |acc: List<Repack>, b: Int, names: List<Bytes>| {
    let body_of = |n: Bytes|
      match answered.get(n) {
        Some(Body(x)) -> Some(Body(x)),
        Some(Refused(_)) -> None,
        None -> match looked.get(n) { Some(Body(x)) -> Some(Body(x)), _ -> None },
      };
    let gained = names.fold(false, |g: Bool, n: Bytes|
      g || (match answered.get(n) { Some(Body(_)) -> true, _ -> false }));
    if packs.contains(b) && !gained { acc } else {
      acc.push({
        names: names,
        pack: {
          rows: names.fold([], |rows: List<Packed>, n: Bytes|
            match body_of(n) {
              Some(a) -> rows.push({ name: n, kept: kept_of(keys, a) }),
              None -> rows,
            }),
        },
      })
    }
  })

/// What the emitter answers for `missed`: entered once, over the modules those roots are in, the
/// ones whose lambdas they run, the home modules those call functions of types of, and the ones
/// all of those import.
fn emitter_answers(
  runtime: Runtime,
  dump: Dump,
  p: Program,
  ctors: List<Ctor>,
  missed: List<Bytes>,
) -> List<RootAnswer> / {abort.raise} = {
  let lowered = missed.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Bytes|
    List::fold(
      match specialisation_of(n) { Some(s) -> s.fns, None -> [] },
      acc.insert(module_of_root(n), true),
      |m: Map<Bytes, Bool>, f: FnArg| m.insert(module_of_root(f.owner), true),
    ));
  let needed = imported(p, lowered.keys().concat(homes_called_by(p, lowered.keys())));
  let placed = range(0, p.modules.len()).filter(|i: Int| needed.contains(p.modules.get(i).name));
  let names = placed.map(|i: Int| p.modules.get(i).name);
  // A module no wanted root is in is read for its declarations, its rows standing for its bodies.
  let text_of = |m: ModuleRow| {
    let text = match text_at(p, m.index) { Some(t) -> t, None -> b"" };
    if lowered.contains(m.name) { text } else { stubbed(text, m.cuts) }
  };
  emit_roots_answer(
    names,
    placed.map(|i: Int| text_of(p.modules.get(i))),
    ctors_of(
      ctors.map(|c: Ctor| c.name),
      ctor_layouts(dump.ctors),
      // Program-wide: a specialisation is emitted where its definition is, which may not import
      // the module stating a `key` for the type it is at.
      dump.emitter_ctors.filter(|c: EmitterCtor| c.key != None).map(|c: EmitterCtor| c.name),
      ctor_sums(dump.ctors),
    ),
    runtime.natives.map(|n: Native| n.name),
    missed,
    if dump.packages.len() == 0 { [{ prefix: b"", deps: [] }] } else { dump.packages },
    if dump.packages.len() == 0 { names.map(|_: Bytes| 0) }
    else { placed.map(|i: Int| match dump.module_packages.at(i) { Some(k) -> k, None -> 0 }) },
    dump.embeds,
    dump.rows,
    dump.walked,
  )
}

/// The calls the emitter's work is dealt over. Each repeats the front end's work over its modules'
/// imports, so more of them lose more than they gain.
fn pieces() -> Int = 2

type Piece = { weight: Int, roots: List<Bytes> }

/// `missed` as at most `pieces()` lists that lower about as much each: the longest module first onto
/// the lightest list, and a module's roots together, since the emitter groups what one call wants.
/// A specialisation that runs a lambda goes with its lender's module, which its call lowers too.
fn dealt(p: Program, missed: List<Bytes>) -> List<List<Bytes>> / {abort.raise} = {
  let by_module = missed.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, n: Bytes| {
    let m = match specialisation_of(n) {
      Some(s) -> match s.fns.at(0) {
        Some(f) -> module_of_root(f.owner),
        None -> module_of_root(n),
      },
      None -> module_of_root(n),
    };
    acc.insert(m, List::push(match acc.get(m) { Some(xs) -> xs, None -> [] }, n))
  });
  let lengths = p.modules.fold(Map::new(), |acc: Map<Bytes, Int>, m: ModuleRow|
    acc.insert(m.name, match text_at(p, m.index) { Some(t) -> t.len(), None -> 0 }));
  let weighed = by_module.fold([], |acc: List<Piece>, m: Bytes, roots: List<Bytes>|
    acc.push({ weight: match lengths.get(m) { Some(n) -> n, None -> 0 }, roots: roots }));
  let longest_first = weighed.sort_by(|a: Piece, b: Piece| a.weight >= b.weight);
  let dealt = longest_first.fold([], |acc: List<Piece>, m: Piece|
    if acc.len() < pieces() { acc.push(m) } else {
      let lightest = range(0, acc.len()).fold(0, |best: Int, i: Int|
        if acc.get(i).weight < acc.get(best).weight { i } else { best });
      range(0, acc.len()).map(|i: Int| {
        let piece = acc.get(i);
        if i == lightest { { weight: piece.weight + m.weight, roots: piece.roots.concat(m.roots) } }
        else { piece }
      })
    });
  dealt.map(|piece: Piece| piece.roots)
}

/// What the emitter answers for every list of `pieces` from `lo` up to `hi`, each list a call of its
/// own and the calls at once: a root's answer is the same whichever call asks for it. `room` is the
/// halvings left, and 64 take any length to one.
fn answers_at_once(
  runtime: Runtime,
  dump: Dump,
  p: Program,
  ctors: List<Ctor>,
  pieces: List<List<Bytes>>,
  lo: Int,
  hi: Int,
  room: Int,
) -> List<RootAnswer> / {abort.raise} =
  if hi - lo <= 1 {
    match pieces.at(lo) {
      Some(roots) -> emitter_answers(runtime, dump, p, ctors, roots),
      None -> [],
    }
  } else if room <= 0 { panic("more halvings than a length has") } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      answers_at_once(runtime, dump, p, ctors, pieces, lo, mid, room - 1),
      answers_at_once(runtime, dump, p, ctors, pieces, mid, hi, room - 1),
    };
    halves._0.concat(halves._1)
  }

// --- Values a build kept ----------------------------------------------------------

/// A `const` definition and the text a build kept its value as, which the runtime wrote and reads.
pub type Baked = { name: Bytes, text: Bytes }

/// The calls a `const` definition may make before a build gives up on it.
pub fn const_budget() -> Int = 100000000

/// The bytes of text a `const` definition's value may be kept as.
pub fn const_room() -> Int = 16777216

/// What a `const` definition's value is a function of, and so kept under: the runtime that
/// evaluated and wrote it, the compiler whose code it ran as, and what the front end keeps it
/// under, which is the hash of all it reaches, the files it embeds among them, and the names of it.
pub fn baked_key(runtime: Bytes, emitter: Bytes, hash: Bytes) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all([sized(b"ply baked value 1"), sized(runtime), sized(emitter), sized(hash)]),
    ),
  )

/// A value kept under `dir`, whole. It is kept behind its own digest, so one a full disk cut short
/// reads as none and is evaluated again.
pub fn kept_value<[r]>(
  dir: String,
  key: Bytes,
) -> Option<Bytes> / {fs.read[r], fs.write[r], time.now_ms, abort.raise} =
  match read_kept[r](dir, key) {
    None -> None,
    Some(bytes) -> if bytes.len() < 32 { None } else {
      let text = bytes.slice(32, bytes.len());
      if blake3(text) == bytes.slice(0, 32) { Some(text) } else { None }
    },
  }

/// `text` kept under `dir` as `kept_value` reads it back.
pub fn keep_value<[r]>(
  dir: String,
  key: Bytes,
  text: Bytes,
) -> Unit / {fs.write[r], entropy.next, time.now_ms, abort.raise} =
  write_kept[r](dir, key, blake3(text).concat(text))

/// The root that answers a `const` definition's value as that text: what a build enters to keep it.
pub fn stored_root(name: Bytes) -> Bytes = name.concat(b"#stored")

fn stored_of(root: Bytes) -> Option<Bytes> / {abort.raise} =
  if root.ends_with(b"#stored") { Some(root.slice(0, root.len() - 7)) } else { None }

/// `text` as adjacent C string literals, none longer than a compiler accepts. It is hex digits, so
/// no byte of it needs an escape or reads as a placeholder.
fn quoted(text: Bytes) -> Bytes / {abort.raise} = {
  let n = text.len();
  let count = if n == 0 { 1 } else { (n + piece_len() - 1) / piece_len() };
  Bytes::concat_all(
    range(0, count).map(|i: Int|
      Bytes::concat_all([
        b"\"",
        text.slice(i * piece_len(), min(n, (i + 1) * piece_len())),
        b"\"\n",
      ])),
  )
}

fn entered_by(symbol: Bytes, entry: Bytes) -> Bytes =
  Bytes::concat_all([
    b"Word ",
    entry,
    b"(PlyCtx *ctx, const Word *args) {\n  return ",
    symbol,
    b"(ctx);\n}",
  ])

/// A `const` definition as the value a build kept: its unit holds the text and reads it once, where
/// the definition's own body would have run. It calls nothing, so the unit need not hold what the
/// body reaches.
fn baked_body(b: Baked) -> Answer / {abort.raise} = {
  let symbol = symbol_of(b.name);
  let entry = entry_of(b.name);
  let held = symbol.concat(b"_baked");
  Body({
    text: Bytes::concat_all([
      b"static const char ",
      held,
      b"[] =\n",
      quoted(b.text),
      b";\nWord ",
      entry,
      b"(PlyCtx *ctx, const Word *args);\nWord ",
      symbol,
      b"(PlyCtx *ctx) {\n  return rt_baked_p(ctx, (Word)(intptr_t)",
      held,
      b", INT64_C(",
      ascii_of_int(b.text.len()),
      b"));\n}\n",
      entered_by(symbol, entry),
    ]),
    tables: { ..no_tables(), symbols: [{ symbol: symbol, entry: entry, head: word_head(0) }] },
  })
}

/// The body of `root`, the stored root of `of`: the definition read as any body reads a constant,
/// and what it answers written as the text a unit holds a value by.
fn stored_body(root: Bytes, of: Bytes) -> Answer / {abort.raise} = {
  let symbol = symbol_of(root);
  let entry = entry_of(root);
  Body({
    text: Bytes::concat_all([
      b"Word ",
      entry,
      b"(PlyCtx *ctx, const Word *args);\nWord ",
      symbol,
      b"(PlyCtx *ctx) {\n  Word held = rt_constant_p(ctx, @@l0@@);\n",
      b"  if (ctx->failed) return 0;\n  return rt_stored_p(ctx, held);\n}\n",
      entered_by(symbol, entry),
    ]),
    tables: {
      ..no_tables(),
      lambdas: [entry_of(of)],
      calls: [of],
      symbols: [{ symbol: symbol, entry: entry, head: word_head(0) }],
    },
  })
}

/// The unit over `every` root offered: each one's answer taken from what an earlier run kept where it
/// stands, the emitter entered once for the rest, what it answered kept for the next run, and the
/// unit produced over all of it. `inputs` holds the bytes of each file `dump` says the program
/// embeds, by digest. `emitter` is what the emitter's answers are a function of on its
/// side, which every kept answer is filed under. `Err` says why the emitter answered nothing at all.
/// A root `baked` names is held as that value in place of its body, and a `stored_root` offered is
/// made here: the emitter is asked for neither.
pub fn emitted<| e>(
  runtime: Runtime,
  dump: Dump,
  sources: List<Bytes>,
  inputs: Map<Bytes, Bytes>,
  every: List<Bytes>,
  emitter: Bytes,
  read: (Bytes) -> Option<Bytes> / e,
  write: (Bytes, Bytes) -> Unit / e,
  baked: List<Baked> = [],
) -> Result<Emission, Bytes> / {abort.raise | e} = {
  let p = program_of(dump, sources);
  let laid = ctor_layouts(dump.ctors);
  let ctors = dump.emitter_ctors.map(|c: EmitterCtor|
    {
      name: c.name,
      arity: c.arity,
      args: match laid.get(c.name) { Some(fs) -> List::map(fs, spelled_field), None -> [] },
    });
  let wanted = every.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Bytes| acc.insert(n, true));
  let values = baked.fold(Map::new(), |acc: Map<Bytes, Baked>, b: Baked|
    if wanted.contains(b.name) { acc.insert(b.name, b) } else { acc });
  let offered = every.filter(|n: Bytes| !values.contains(n) && stored_of(n) == None);
  // No constructor table: a body names each tag by its constructor, which its key's read
  // declarations already cover, so one answer serves every program that holds the root.
  let common = [
    b"ply.unit.answer.2",
    hex(bin::shape_digest(kept_bin())),
    runtime.identity,
    emitter,
  ];
  match answered_round(runtime, dump, p, ctors, common, offered, read, write) {
    Err(why) -> Err(why),
    Ok(first) -> match closed_rounds(runtime, dump, p, ctors, common, read, write, first, 64) {
      Err(why) -> Err(why),
      Ok(all) -> {
        let shared = alike(all.answers);
        let held = values.fold(
          generics_settled(all.answers, shared),
          |acc: Map<Bytes, Answer>, n: Bytes, b: Baked| acc.insert(n, baked_body(b)),
        );
        let produced = produce(
          runtime,
          ctors,
          every.concat(all.added.filter(|n: Bytes| !shared.contains(n))).map(|n: Bytes|
            match p.roots.get(own_definition(n)) {
              Some(r) ->
                {
                  name: n,
                  arity: r.arity,
                  constant: r.pure && r.arity == 0 && specialisation_of(n) == None,
                },
              None -> { name: n, arity: 0, constant: false },
            }),
          p.modules.len(),
          every.fold(held, |acc: Map<Bytes, Answer>, n: Bytes|
            match stored_of(n) { Some(of) -> acc.insert(n, stored_body(n, of)), None -> acc }),
          inputs,
          dump.emitter_ctors.fold([], |acc: List<Stated>, c: EmitterCtor|
            if c.key == None && c.show == None && c.numeric.len() == 0 { acc }
            else { acc.push({ ctor: c.name, key: c.key, show: c.show, numeric: c.numeric }) }),
        );
        Ok({
          produced: produced,
          kept: all.kept,
          asked: all.asked,
          unbound: unbound(
            runtime.natives,
            called_externs(natives_called(produced.made), p.modules, |m: ModuleRow|
              text_at(p, m.index)),
          ),
        })
      },
    },
  }
}

/// The answers to `names`, and how many came from what an earlier run kept and how many were asked
/// of the emitter: each kept answer read where it stands, the emitter entered once for the rest, and
/// what it answered kept for the next run.
type Answered = { answers: Map<Bytes, Answer>, kept: Int, asked: Int, added: List<Bytes> }

fn answered_round<| e>(
  runtime: Runtime,
  dump: Dump,
  p: Program,
  ctors: List<Ctor>,
  common: List<Bytes>,
  names: List<Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
  write: (Bytes, Bytes) -> Unit / e,
) -> Result<Answered, Bytes> / {abort.raise | e} = {
  let asked = names.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Bytes| acc.insert(n, true));
  let types = types_material(dump);
  let body_key = |m: Bytes| kept_key(common.concat([b"body", m]));
  let materials = names.fold(Map::new(), |acc: Map<Bytes, Bytes>, n: Bytes|
    match root_material(p, types, n) { Some(m) -> acc.insert(n, m), None -> acc });
  let buckets = bucketed(materials.keys());
  let pack_key = |ns: List<Bytes>|
    kept_key(
      common.concat([b"pack", hex(bin::shape_digest(pack_bin()))]).concat(
        ns.map(|n: Bytes| match materials.get(n) { Some(m) -> m, None -> b"" }),
      ),
    );
  let packs = buckets.fold(
    Map::new(),
    |acc: Map<Int, Map<Bytes, Answer>>, b: Int, ns: List<Bytes>|
      match unpacked(p.keys, read(pack_key(ns))) {
        Some(found) -> acc.insert(b, found),
        None -> acc,
      },
  );
  let looked = looked_up(materials, packs, |m: Bytes| decoded(p.keys, read(body_key(m))));
  let kept = standing(looked, asked);
  let missed = names.filter(|n: Bytes| !kept.contains(n));
  let fresh = if missed.len() == 0 { [] } else {
    let pieces = dealt(p, missed);
    answers_at_once(runtime, dump, p, ctors, pieces, 0, pieces.len(), 64)
  };
  if missed.len() > 0 && fresh.len() == 0 {
    Err(
      Bytes::concat_all([
        b"it answered nothing for the ",
        ascii_of_int(missed.len()),
        b" root(s) it was asked for, so no body was emitted: a module it cannot parse, a package it ",
        b"cannot resolve, or a program its own check refuses",
      ]),
    )
  } else {
    let answered = answers_of(fresh);
    answered.fold((), |_: Unit, n: Bytes, a: Answer|
      match root_material(p, types, n) {
        None -> (),
        Some(m) -> match a {
          Body(_) -> write(body_key(m), bin::encode(kept_of(p.keys, a), kept_bin())),
          Refused(_) -> (),
        },
      });
    repacked(p.keys, buckets, packs, looked, answered).fold((), |_: Unit, r: Repack|
      write(pack_key(r.names), bin::encode(r.pack, pack_bin())));
    Ok({
      answers: answered.fold(kept, |acc: Map<Bytes, Answer>, n: Bytes, a: Answer| acc.insert(n, a)),
      kept: kept.len(),
      asked: missed.len(),
      added: [],
    })
  }
}

/// `had` with each root its bodies reach answered too, round after round until none lacks one: a
/// specialisation a body names, the generic body of each definition a body calls generically,
/// whose needs settle those calls, and once every such body is in, the root each call settles on.
/// `room` is the rounds left.
fn closed_rounds<| e>(
  runtime: Runtime,
  dump: Dump,
  p: Program,
  ctors: List<Ctor>,
  common: List<Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
  write: (Bytes, Bytes) -> Unit / e,
  had: Answered,
  room: Int,
) -> Result<Answered, Bytes> / {abort.raise | e} = {
  let named = had.answers.fold(Map::new(), |acc: Map<Bytes, Bool>, _: Bytes, a: Answer|
    match a {
      Body(b) -> {
        let specialised_calls = b.tables.calls.fold(acc, |m: Map<Bytes, Bool>, c: Bytes|
          if (specialisation_of(c) != None || derived_of(c) != None) && !had.answers.contains(c) {
            m.insert(c, true)
          } else { m });
        b.tables.generics.calls.fold(specialised_calls, |m: Map<Bytes, Bool>, g: GenericCall|
          if had.answers.contains(g.callee) { m } else { m.insert(g.callee, true) })
      },
      Refused(_) -> acc,
    });
  // Only once every generic body is in are the needs closed, so no call settles on a part of them.
  let more = if named.len() > 0 { named } else {
    let needs = closed_needs(had.answers);
    let called = closed_called(had.answers);
    had.answers.fold(Map::new(), |acc: Map<Bytes, Bool>, _: Bytes, a: Answer|
      match a {
        Body(b) ->
          b.tables.generics.calls.fold(acc, |m: Map<Bytes, Bool>, g: GenericCall| {
            let root = settled_root(g, needs, called);
            if had.answers.contains(root) { m } else { m.insert(root, true) }
          }),
        Refused(_) -> acc,
      })
  };
  if more.len() == 0 || room <= 0 { Ok(had) } else {
    match answered_round(runtime, dump, p, ctors, common, more.keys(), read, write) {
      Err(why) -> Err(why),
      Ok(r) ->
        closed_rounds(
          runtime,
          dump,
          p,
          ctors,
          common,
          read,
          write,
          {
            answers: r.answers.fold(had.answers, |acc: Map<Bytes, Answer>, n: Bytes, a: Answer|
              acc.insert(n, a)),
            kept: had.kept + r.kept,
            asked: had.asked + r.asked,
            added: had.added.concat(more.keys()),
          },
          room - 1,
        ),
    }
  }
}

// --- Generic calls ---------------------------------------------------------------

/// What each generic definition's code needs of its type arguments, closed over the calls its
/// generic body makes: a callee's need of the layout of an argument is the caller's need of each
/// variable that argument is laid out by, and its need of a scalar the caller's of the variable the
/// argument is.
fn closed_needs(answers: Map<Bytes, Answer>) -> Map<Bytes, List<Need>> / {abort.raise} = {
  let generic = answers.fold(Map::new(), |acc: Map<Bytes, Generics>, n: Bytes, a: Answer|
    match a {
      Body(b) -> if specialisation_of(n) == None { acc.insert(n, b.tables.generics) } else { acc },
      Refused(_) -> acc,
    });
  let grouped = answers.fold(Map::new(), |acc: Map<Bytes, Bool>, _: Bytes, a: Answer|
    match a {
      Body(b) -> if b.tables.members.len() > 1 {
        b.tables.members.fold(acc, |m: Map<Bytes, Bool>, member: Bytes| m.insert(member, true))
      } else { acc },
      Refused(_) -> acc,
    });
  let start = generic.fold(Map::new(), |acc: Map<Bytes, List<Need>>, n: Bytes, g: Generics|
    acc.insert(n, if grouped.contains(n) { [] } else { g.needs }));
  // Each round adds a need or stops, and a definition has two needs a variable at most.
  let most = generic.fold(1, |acc: Int, _: Bytes, g: Generics|
    acc + 2 * g.calls.fold(1, |n: Int, c: GenericCall| n + c.args.len()));
  iterate(start, most, |needs: Map<Bytes, List<Need>>| {
    let next = generic.fold(needs, |acc: Map<Bytes, List<Need>>, n: Bytes, g: Generics|
      if grouped.contains(n) { acc } else {
        g.calls.fold(acc, |a: Map<Bytes, List<Need>>, call: GenericCall| widened(a, n, call, needs))
      });
    if next == needs { Stop(needs) } else { Continue(next) }
  })
}

/// Each body's parameters it calls as functions, closed over the calls it hands them on to: one
/// handed on as a parameter its callee calls is called. A tail group's members call none, since a
/// specialisation of one would leave its group's loop.
fn closed_called(answers: Map<Bytes, Answer>) -> Map<Bytes, List<Int>> / {abort.raise} = {
  let bodies = answers.fold(Map::new(), |acc: Map<Bytes, Generics>, n: Bytes, a: Answer|
    match a {
      Body(b) -> if specialisation_of(n) == None && b.tables.members.len() <= 1 {
        acc.insert(n, b.tables.generics)
      } else { acc },
      Refused(_) -> acc,
    });
  let start = bodies.fold(Map::new(), |acc: Map<Bytes, List<Int>>, n: Bytes, g: Generics|
    acc.insert(n, g.called));
  // Each round adds a parameter or stops, and a body has as many to add as it hands on.
  let most = bodies.fold(1, |acc: Int, _: Bytes, g: Generics| acc + g.passes.len());
  iterate(start, most, |called: Map<Bytes, List<Int>>| {
    let next = bodies.fold(called, |acc: Map<Bytes, List<Int>>, n: Bytes, g: Generics|
      g.passes.fold(acc, |a: Map<Bytes, List<Int>>, pass: Pass| {
        let theirs = match called.get(pass.callee) { Some(cs) -> cs, None -> [] };
        let mine = match a.get(n) { Some(cs) -> cs, None -> [] };
        if theirs.contains(pass.at) && !mine.contains(pass.param) {
          a.insert(n, mine.push(pass.param))
        } else { a }
      }));
    if next == called { Stop(called) } else { Continue(next) }
  })
}

/// `needs` with caller `n`'s needs of what `call` hands its callee.
fn widened(
  acc: Map<Bytes, List<Need>>,
  n: Bytes,
  call: GenericCall,
  needs: Map<Bytes, List<Need>>,
) -> Map<Bytes, List<Need>> / {abort.raise} = {
  let callee = match needs.get(call.callee) { Some(ns) -> ns, None -> [] };
  callee.fold(acc, |a: Map<Bytes, List<Need>>, need: Need|
    match call.args.at(need.var) {
      None -> a,
      Some(spelled) -> match type_spelled(spelled) {
        None -> a,
        Some(arg) -> {
          let vars = match need.reads {
            Exact -> type_vars(arg),
            Layout -> laid_vars(arg),
            Scalar -> match arg { TyVar(v) -> if v >= 0 { [v] } else { [] }, _ -> [] },
          };
          vars.fold(a, |m: Map<Bytes, List<Need>>, v: Int| {
            let had = match m.get(n) { Some(ns) -> ns, None -> [] };
            let more = { var: v, reads: need.reads };
            if had.contains(more) { m } else { m.insert(n, had.push(more)) }
          })
        },
      },
    })
}

/// The root a generic call settles on: each type argument the call carries raw, and each the
/// callee's code needs and the call knows, its layout where the code needs that, a scalar where it
/// does that scalar's operators in C; every other argument left as the callee's generic body has it. A callee in a tail group with
/// others stays its group's body, whose tail calls loop where a specialisation's would nest.
fn settled_root(
  call: GenericCall,
  needs: Map<Bytes, List<Need>>,
  called: Map<Bytes, List<Int>>,
) -> Bytes / {abort.raise} = {
  let ns = match needs.get(call.callee) { Some(x) -> x, None -> [] };
  let args = range(0, call.args.len()).map(|j: Int| {
    let arg = match call.args.at(j) {
      Some(spelled) -> match type_spelled(spelled) { Some(t) -> t, None -> unknown_type() },
      None -> unknown_type(),
    };
    if call.carried.contains(j) { erased(arg) }
    else if has_vars(arg) { unknown_type() }
    else if ns.contains({ var: j, reads: Exact }) { arg }
    else if ns.contains({ var: j, reads: Layout }) { erased(arg) }
    else if ns.contains({ var: j, reads: Scalar }) && held_apart(arg) { erased(arg) }
    else { unknown_type() }
  });
  // A lambda is run in place only by a callee that calls the parameter it is handed as.
  let calls = match called.get(call.callee) { Some(cs) -> cs, None -> [] };
  let fns = call.fns.filter(|f: FnArg| calls.contains(f.param));
  if fns.len() == 0 && args.fold(true, |none: Bool, a: Type| none && a == unknown_type()) {
    call.callee
  } else { specialised_with(call.callee, args, fns) }
}

/// `answers` with every generic call settled: each placeholder of a body's C, and of the entries its
/// closures name, written as the root its call settles on, and that root among the body's calls.
fn generics_settled(
  answers: Map<Bytes, Answer>,
  shared: Map<Bytes, Bytes>,
) -> Map<Bytes, Answer> / {abort.raise} = {
  let needs = closed_needs(answers);
  let called = closed_called(answers);
  answers.fold(Map::new(), |acc: Map<Bytes, Answer>, n: Bytes, a: Answer|
    acc.insert(n, match a {
      Body(b) -> if b.tables.generics.calls.len() == 0 { a } else {
        let roots = b.tables.generics.calls.map(|g: GenericCall| {
          let settled = settled_root(g, needs, called);
          let root = match shared.get(settled) { Some(r) -> r, None -> settled };
          // A specialisation the emitter refused leaves the call to the generic body, which takes
          // what the call hands it where it hands nothing raw.
          match answers.get(root) {
            Some(Refused(_)) -> {
              // Refused with lambdas run in place: the root without them, where it was answered.
              let plain = settled_root({ ..g, fns: [] }, needs, called);
              if g.fns.len() > 0 && plain != root
                  && (match answers.get(plain) { Some(Body(_)) -> true, _ -> false }) { plain }
              else if g.carried.len() == 0 { g.callee }
              else { root }
            },
            _ -> root,
          }
        });
        Body({
          text: placeholders_named(b.text, roots),
          tables: {
            ..b.tables,
            generics: {
              ..b.tables.generics,
              expects: b.tables.generics.expects.map(|e: Expect|
                if e.callee.starts_with(b"@@g") {
                  { ..e, callee: roots.get(digits(e.callee.slice(3, e.callee.len() - 2))) }
                } else { e }),
            },
            lambdas: b.tables.lambdas.map(|l: Bytes| placeholders_named(l, roots)),
            calls: roots.fold(b.tables.calls, |cs: List<Bytes>, r: Bytes|
              if cs.contains(r) { cs } else { cs.push(r) }),
          },
        })
      },
      Refused(_) -> a,
    }))
}

/// Each specialisation whose code another's is but for its name, to that other: the least name of
/// those whose C, but for its own symbol, and tables are alike. One is compiled and every call of
/// either reaches it.
fn alike(answers: Map<Bytes, Answer>) -> Map<Bytes, Bytes> / {abort.raise} = {
  let keyed = answers.fold(Map::new(), |acc: Map<Bytes, Bytes>, n: Bytes, a: Answer|
    match a {
      Body(b) -> match specialisation_of(n) {
        Some(sp) -> acc.insert(n, code_key(sp.base, n, b)),
        None -> acc,
      },
      Refused(_) -> acc,
    });
  let first = keyed.fold(Map::new(), |acc: Map<Bytes, Bytes>, n: Bytes, k: Bytes|
    if acc.contains(k) { acc } else { acc.insert(k, n) });
  keyed.fold(Map::new(), |acc: Map<Bytes, Bytes>, n: Bytes, k: Bytes|
    match first.get(k) { Some(m) -> if m == n { acc } else { acc.insert(n, m) }, None -> acc })
}

/// What the body of specialisation `n` of `base` is but for its name: its C and tables with its own
/// symbol and root name taken out, digested.
fn code_key(base: Bytes, n: Bytes, b: { text: Bytes, tables: Tables }) -> Bytes / {abort.raise} = {
  let own = symbol_of(n);
  let unnamed = |x: Bytes| Bytes::join(Bytes::join(x.split(own), b"@@own@@").split(n), b"@@root@@");
  let tables = {
    ..b.tables,
    calls: b.tables.calls.map(unnamed),
    lambdas: b.tables.lambdas.map(unnamed),
    symbols: b.tables.symbols.map(|d: Defined|
      { ..d, symbol: unnamed(d.symbol), entry: unnamed(d.entry) }),
    generics: {
      ..b.tables.generics,
      expects: b.tables.generics.expects.map(|e: Expect| { ..e, callee: unnamed(e.callee) }),
    },
  };
  blake3(
    Bytes::concat_all([base, b"\x00", unnamed(b.text), b"\x00", bin::encode(tables, tables_bin())]),
  )
}

/// `text` with each `@@gN@@` written as the symbol of root `N`.
fn placeholders_named(text: Bytes, roots: List<Bytes>) -> Bytes / {abort.raise} = {
  let walked = holes(text).filter(|h: Hole| h.kind == 103).fold(
    { from: 0, out: [] },
    |s: { from: Int, out: List<Bytes> }, h: Hole|
      {
        from: h.close + 2,
        out: s.out.push(text.slice(s.from, h.open)).push(symbol_of(roots.get(digits(h.digits)))),
      },
  );
  Bytes::concat_all(walked.out.push(text.slice(walked.from, text.len())))
}

// --- What a program is told -------------------------------------------------------

fn place_of(dump: Dump, name: Bytes) -> { module: Int, start: Int, end: Int } =
  dump.emitter_roots.fold(
    { module: no_module(), start: 0, end: 0 },
    |acc: { module: Int, start: Int, end: Int }, root: EmitterRoot|
      if root.root == name { { module: root.at.module, start: root.at.start, end: root.at.end } }
      else { acc },
  )

fn label_of(dump: Dump, d: Dropped, primary: Bool) -> Label = {
  let at = place_of(dump, d.function);
  { module: at.module, start: at.start, end: at.end, primary: primary, text: d.construct }
}

/// Definitions the program reaches that the emitter refused, in the order the fixpoint dropped them,
/// so the first is a cause and the rest what that cause carried.
fn refused_reach(dump: Dump, dropped: List<Dropped>) -> Diag / {abort.raise} = {
  let listed = dropped.fold(
    b"the emitter refused, in the order it dropped them:",
    |acc: Bytes, d: Dropped|
      Bytes::concat_all([acc, b"\n  `", d.function, b"` (", d.construct, b")"]),
  );
  error_with_labels(
    b"E0448",
    Bytes::concat_all([
      b"the C backend cannot compile ",
      ascii_of_int(dropped.len()),
      b" of the definitions this program reaches",
    ]),
    range(0, dropped.len()).fold([], |acc: List<Label>, i: Int|
      if i > 4 { acc } else { acc.push(label_of(dump, dropped.get(i), i == 0)) }),
    [
      listed,
      b"compiled code is the only evaluator, so a definition it cannot compile is one nothing can enter; the build fails here, where the construct that refused it is still in hand, rather than at the call that would find no body",
    ],
  )
}

fn unanswered(why: Bytes) -> Diag =
  error_with_labels(
    b"E0450",
    b"the C backend could not be built: the Ply emitter failed over the program: ".concat(why),
    [],
    [
      b"compiled code is the only evaluator, so a run without a backend would be reported green over a seam nothing reached",
    ],
  )

/// The unit's C as the runtime compiles it, or why there is none: an emitter that answered nothing
/// at all, a native it calls that the runtime does not implement as declared, or a definition the program
/// reaches that the emitter refused. A definition dropped only because a narrowed offer left its
/// callee out is no refusal of the program's.
pub fn held(
  dump: Dump,
  offered: List<Bytes>,
  emission: Result<Emission, Bytes>,
) -> Result<Bytes, List<Diag>> / {abort.raise} =
  match emission {
    Err(why) -> Err([unanswered(why)]),
    Ok(e) -> if e.unbound.len() > 0 { Err([natives_refused(e.unbound)]) } else {
      let errors = fatal(offered, e.produced.dropped);
      if errors.len() == 0 { Ok(e.produced.text) } else { Err([refused_reach(dump, errors)]) }
    },
  }

/// The unit over `offered`, held as `held` holds it. What is kept between runs is `read` and
/// `write`'s, under keys that name `emitter`.
pub fn compiled<| e>(
  runtime: Runtime,
  dump: Dump,
  sources: List<Bytes>,
  inputs: Map<Bytes, Bytes>,
  offered: List<Bytes>,
  emitter: Bytes,
  read: (Bytes) -> Option<Bytes> / e,
  write: (Bytes, Bytes) -> Unit / e,
) -> Result<Bytes, List<Diag>> / {abort.raise | e} =
  held(dump, offered, emitted(runtime, dump, sources, inputs, offered, emitter, read, write))

// --- Tests ------------------------------------------------------------------

fn some_definitions() -> Bytes =
  b"compiler.unit.emitted aa\nfront.seam.view_dump bb\nunit.emitted cc\nunit.emitted_twice dd\n"

/// A generic body that calls `calls` and needs `needs`.
fn generic_body(calls: List<GenericCall>, needs: List<Need>) -> Answer =
  Body({
    text: b"",
    tables: { ..no_tables(), generics: { ..no_generics(), calls: calls, needs: needs } },
  })

test "a generic call settles on each argument its callee's code needs, and leaves the rest" {
  let needs = Map::of_entries([
    { key: b"m.lay", value: [{ var: 0, reads: Layout }] },
    { key: b"m.add", value: [{ var: 0, reads: Scalar }] },
    { key: b"m.same", value: [{ var: 0, reads: Exact }] },
  ]);
  let call = |callee: Bytes, arg: Bytes|
    settled_root({ callee: callee, args: [arg], carried: [], fns: [] }, needs, Map::new());
  // A layout the code reads is kept, a known word among them; a type it reads is kept whole.
  assert_eq(call(b"m.lay", b"{x:Float}"), b"m.lay@{x:Float}");
  assert_eq(call(b"m.lay", b"_"), b"m.lay@_");
  assert_eq(call(b"m.lay", b"{x:m.Shape}"), b"m.lay@{x:_}");
  assert_eq(call(b"m.same", b"List<m.Shape>"), b"m.same@List<m.Shape>");
  assert_eq(call(b"m.same", b"m.Date{day:Int}"), b"m.same@m.Date{day:Int}");
  // A scalar its operators read is kept; a record they do not read is not.
  assert_eq(call(b"m.add", b"Float"), b"m.add@Float");
  assert_eq(call(b"m.add", b"{x:Float}"), b"m.add");
  assert_eq(call(b"m.add", b"m.Shape"), b"m.add");
  // An argument the caller does not know yet, or a callee that needs nothing, is the generic body.
  assert_eq(call(b"m.lay", b"{x:'0}"), b"m.lay");
  assert_eq(call(b"m.none", b"Float"), b"m.none")
}

test "a lambda is run in place only by a callee that calls the parameter it is handed as" {
  let body = |called: List<Int>, passes: List<Pass>|
    Body({
      text: b"",
      tables: { ..no_tables(), generics: { ..no_generics(), called: called, passes: passes } },
    });
  let answers = Map::of_entries([
    { key: b"m.each", value: body([1], []) },
    // `pass` hands its parameter on to `each`, which calls it; `keep` only holds it.
    { key: b"m.pass", value: body([], [{ param: 0, callee: b"m.each", at: 1 }]) },
    { key: b"m.keep", value: body([], []) },
  ]);
  let called = closed_called(answers);
  assert_eq(called.get(b"m.pass"), Some([0]));
  let call = |callee: Bytes, param: Int|
    settled_root(
      { callee: callee, args: [], carried: [], fns: [{ param: param, owner: b"m.main", nth: 0 }] },
      Map::new(),
      called,
    );
  assert_eq(call(b"m.each", 1), b"m.each@|1=m.main:0");
  assert_eq(call(b"m.pass", 0), b"m.pass@|0=m.main:0");
  assert_eq(call(b"m.each", 0), b"m.each");
  assert_eq(call(b"m.keep", 0), b"m.keep")
}

test "a refused specialisation leaves its call to the generic body, whichever root lent the lambda" {
  let lent = |owner: Bytes| [{ param: 1, owner: owner, nth: 0 }];
  let calling = |callee: Bytes, owner: Bytes|
    generic_body([{ callee: callee, args: [], carried: [], fns: lent(owner) }], []);
  let calls_one = Body({
    text: b"",
    tables: { ..no_tables(), generics: { ..no_generics(), called: [1] } },
  });
  let refused = Refused({ why: b"a body the lowering does not reach" });
  let mapping = specialised_with(b"std.prelude.List::map", [], lent(b"m.mapped"));
  let answers = Map::of_entries([
    { key: b"m.each", value: calls_one },
    { key: b"std.prelude.mapped_from", value: calls_one },
    { key: b"m.main", value: calling(b"m.each", b"m.main") },
    { key: specialised_with(b"m.each", [], lent(b"m.main")), value: refused },
    // `List::map` hands the lambda it runs on to `mapped_from`, whose specialisation is refused.
    {
      key: b"std.prelude.List::map",
      value: Body({
        text: b"",
        tables: {
          ..no_tables(),
          generics: {
            ..no_generics(),
            passes: [{ param: 1, callee: b"std.prelude.mapped_from", at: 1 }],
          },
        },
      }),
    },
    { key: b"m.mapped", value: calling(b"std.prelude.List::map", b"m.mapped") },
    { key: mapping, value: calling(b"std.prelude.mapped_from", b"m.mapped") },
    { key: specialised_with(b"std.prelude.mapped_from", [], lent(b"m.mapped")), value: refused },
  ]);
  let settled = generics_settled(answers, Map::new());
  let calls = |name: Bytes|
    match settled.get(name) { Some(Body(b)) -> b.tables.calls, _ -> panic("no body") };
  // The lambda a caller lends carries its entry, so the generic body calls it as any closure.
  assert_eq(calls(b"m.main"), [b"m.each"]);
  assert_eq(calls(mapping), [b"std.prelude.mapped_from"]);
  assert_eq(calls(b"m.mapped"), [mapping])
}

test "a generic body needs what its callees need of what it hands them, through its own variables" {
  let answers = Map::of_entries([
    { key: b"m.add", value: generic_body([], [{ var: 0, reads: Scalar }]) },
    { key: b"m.lay", value: generic_body([], [{ var: 0, reads: Layout }]) },
    // `wrap` hands its variable to `add` bare and to `lay` inside a record.
    {
      key: b"m.wrap",
      value: generic_body(
        [
          { callee: b"m.add", args: [b"'0"], carried: [], fns: [] },
          { callee: b"m.lay", args: [b"{v:'1}"], carried: [], fns: [] },
        ],
        [],
      ),
    },
    // `outer` hands its variable inside a list, which no layout reads.
    {
      key: b"m.outer",
      value: generic_body(
        [{ callee: b"m.wrap", args: [b"List<_>", b"'0"], carried: [], fns: [] }],
        [],
      ),
    },
    { key: b"m.same", value: generic_body([], [{ var: 0, reads: Exact }]) },
    // `each` hands its variable inside a list to `same`, which reads the whole of it.
    {
      key: b"m.each",
      value: generic_body([{ callee: b"m.same", args: [b"List<'0>"], carried: [], fns: [] }], []),
    },
  ]);
  let closed = closed_needs(answers);
  assert_eq(closed.get(b"m.wrap"), Some([{ var: 0, reads: Scalar }, { var: 1, reads: Layout }]));
  assert_eq(closed.get(b"m.outer"), Some([{ var: 0, reads: Layout }]));
  assert_eq(closed.get(b"m.each"), Some([{ var: 0, reads: Exact }]))
}

test "a definition's hash is read under its own name, or under `compiler.` where the program ships the compiler" {
  assert_eq(definition_hash(some_definitions(), b"unit.emitted"), Some(b"aa"));
  assert_eq(definition_hash(some_definitions(), b"front.seam.view_dump"), Some(b"bb"));
  assert_eq(definition_hash(some_definitions(), b"unit.emitted_twice"), Some(b"dd"));
  assert_eq(definition_hash(b"unit.emitted cc", b"unit.emitted"), Some(b"cc"));
  assert_eq(definition_hash(some_definitions(), b"emitted"), None);
  assert_eq(definition_hash(some_definitions(), b"unit.emit"), None)
}

test "an identity moves with the hash of a root it names, and with no other definition's" {
  let roots = [b"unit.emitted", b"front.seam.view_dump"];
  let one = identity_of(some_definitions(), roots);
  assert_eq(
    identity_of(
      b"compiler.unit.emitted aa\nfront.seam.view_dump bb\nunit.emitted_twice ee\nzeta.new ff\n",
      roots,
    ),
    one,
  );
  assert(
    identity_of(b"compiler.unit.emitted aa\nfront.seam.view_dump b0\n", roots) != one,
    Some("a root's hash moved and the identity did not"),
  );
  assert(identity_of(some_definitions(), [b"unit.emitted"]) != one, None)
}

fn a_runtime(identity: Bytes) -> Runtime =
  { head: b"", tail: b"", helpers: [], natives: [], layouts: layouts(), identity: identity }

fn a_builder(main: Bytes) -> Bytes = Bytes::concat_all([b"build.main ", main, b"\nbuild.told e5\n"])

test "a program's key moves with the definition it enters, the runtime and the builder, and with nothing else" {
  let key = program_key(b"entry", a_runtime(b"rt"), a_builder(b"c3"));
  assert_eq(key.len(), 64);
  assert_eq(
    program_key(b"entry", a_runtime(b"rt"), a_builder(b"c3").concat(b"other.one f6\n")),
    key,
  );
  assert(program_key(b"other", a_runtime(b"rt"), a_builder(b"c3")) != key);
  assert(program_key(b"entry", a_runtime(b"tr"), a_builder(b"c3")) != key);
  assert(program_key(b"entry", a_runtime(b"rt"), a_builder(b"c4")) != key)
}

/// `c`'s line in a unit that embeds nothing.
fn line(c: Const) -> Bytes / {abort.raise} = const_line(c, Map::new())

test "a pooled constant's line is the one the runtime reads it back from" {
  assert_eq(line(ConstUnit), b"u");
  assert_eq(line(ConstStr(b"hi")), b"s 6869");
  assert_eq(line(ConstBytes(b"\x00\xff")), b"b 00ff");
  assert_eq(line(ConstChar(65)), b"c 65");
  assert_eq(line(ConstFixed({ width: 0, bits: 255 })), b"f 0 255");
  assert_eq(line(ConstFixed({ width: 4, bits: 127 })), b"f 4 127");
  // An embedded file's line is its bytes, as a byte string's is.
  let digest = b"\x00\xff".blake3();
  assert_eq(
    const_line(ConstEmbedded(digest), Map::new().insert(digest, b"\x00\xff")),
    line(ConstBytes(b"\x00\xff")),
  )
}

test "a fixed-width constant is held truncated to its width, a signed one sign-extended" {
  assert_eq(
    line(ConstFixed({ width: 4, bits: 0 - 1 })),
    b"f 4 340282366920938463463374607431768211455",
  );
  assert_eq(line(ConstFixed({ width: 1, bits: 0 - 1 })), b"f 1 65535");
  assert_eq(
    line(ConstWide({ width: 8, high: 0 - 1, low: 0 - 1 })),
    b"f 8 340282366920938463463374607431768211455",
  );
  assert_eq(line(ConstWide({ width: 9, high: 0, low: 5 })), b"f 9 5");
  assert_eq(line(ConstWide({ width: 8, high: 1, low: 0 })), b"f 8 18446744073709551616")
}

test "a float is its bits and a decimal its mantissa and scale, as the literal reads" {
  assert_eq(line(ConstFloat(b"1.5")), b"x 3ff8000000000000");
  assert_eq(line(ConstFloat(b"-2_000.0")), b"x c09f400000000000");
  assert_eq(line(ConstDecimal(b"1.50m")), b"d 150 2");
  assert_eq(line(ConstDecimal(b"-0.05m")), b"d -5 2");
  assert_eq(line(ConstDecimal(b"12m")), b"d 12 0")
}

test "a C string literal holds printable bytes as they are and the rest in octal" {
  assert_eq(escaped(b"a\"b\\c?\n\x01z"), b"a\\\"b\\\\c\\077\\012\\001z");
  assert_eq(literal_lines(b""), b"\"\\n\"\n");
  let long = Bytes::concat_all(range(0, 2001).map(|_: Int| b"x"));
  let pieces = literal_lines(long).split(b"\n");
  assert_eq(pieces.len(), 3);
  assert_eq(pieces.get(0).len(), 2002);
  assert_eq(pieces.get(1), b"\"x\\n\"")
}

test "lines are read as a final newline ends the last one" {
  assert_eq(split_lines(b"a\nb\n"), [b"a", b"b"]);
  assert_eq(split_lines(b"a\r\n\nb"), [b"a", b"", b"b"])
}

test "a body dropped for a callee never offered is the offer's doing, and so is its fallout" {
  let dropped = [
    { function: b"m.a", construct: b"why", missing: None },
    { function: b"m.b", construct: b"lost", missing: Some(b"m.out") },
    { function: b"m.c", construct: b"lost", missing: Some(b"m.b") },
    { function: b"m.d", construct: b"lost", missing: Some(b"m.a") },
  ];
  assert_eq(fatal([b"m.a", b"m.b", b"m.c", b"m.d"], dropped).map(|d: Dropped| d.function), [
    b"m.a",
    b"m.d",
  ])
}

fn one_body(name: Bytes, calls: List<Bytes>) -> Answer =
  Body({
    text: Bytes::concat_all([b"Word f_", name, b"(PlyCtx *ctx) { return @@c0@@ + @@r@@; }"]),
    tables: {
      ..no_tables(),
      consts: [ConstStr(name)],
      calls: calls,
      symbols: [{ symbol: b"f_".concat(name), entry: b"e_".concat(name), head: word_head(0) }],
    },
  })

/// `a` publishing `head` as its definition's.
fn headed(a: Answer, head: Head) -> Answer =
  match a {
    Body(b) ->
      Body({
        ..b,
        tables: { ..b.tables, symbols: b.tables.symbols.map(|d: Defined| { ..d, head: head }) },
      }),
    other -> other,
  }

/// `one_body` with other text, as an edit to its definition would make it.
fn edited_body(name: Bytes) -> Answer =
  match one_body(name, []) {
    Body(b) -> Body({ ..b, text: b.text.concat(b"\n/* edited */") }),
    other -> other,
  }

/// The codes of a unit over `answers`, offering `constants` as constants and the rest as calls.
fn codes_over(
  answers: List<{ key: Bytes, value: Answer }>,
  offered: List<Bytes>,
  constants: List<Bytes>,
) -> Map<Bytes, Bytes> / {abort.raise} =
  codes(
    produce(
      a_runtime(b"r"),
      [],
      offered.map(|n: Bytes|
        { name: n, arity: 0, constant: constants.filter(|c: Bytes| c == n).len() > 0 }),
      1,
      Map::of_entries(answers),
      Map::new(),
    ).made,
  )

test "a root's code moves with every body it can call, and with no other" {
  let program = |g: Answer|
    codes_over(
      [
        { key: b"m.f", value: one_body(b"m.f", [b"m.g"]) },
        { key: b"m.g", value: g },
        { key: b"m.h", value: one_body(b"m.h", []) },
      ],
      [b"m.f", b"m.g", b"m.h"],
      [],
    );
  let before = program(one_body(b"m.g", []));
  let after = program(edited_body(b"m.g"));
  assert(before.get(b"m.f") != after.get(b"m.f"), None);
  assert(before.get(b"m.g") != after.get(b"m.g"), None);
  assert_eq(before.get(b"m.h"), after.get(b"m.h"));
  assert(before.get(b"m.f") != before.get(b"m.h"), None)
}

// The checker decides which roots are constants, and the unit holds a constant where it would call
// a root, so the same bodies offered otherwise are other code.
test "a root's code moves with how it and its callees were offered" {
  let program = |constants: List<Bytes>|
    codes_over(
      [
        { key: b"m.f", value: one_body(b"m.f", [b"m.g"]) },
        { key: b"m.g", value: one_body(b"m.g", []) },
        { key: b"m.h", value: one_body(b"m.h", []) },
      ],
      [b"m.f", b"m.g", b"m.h"],
      constants,
    );
  let called = program([]);
  let held = program([b"m.g"]);
  assert(called.get(b"m.g") != held.get(b"m.g"), None);
  assert(called.get(b"m.f") != held.get(b"m.f"), None);
  assert_eq(called.get(b"m.h"), held.get(b"m.h"))
}

test "a cycle is digested whole, whatever order the unit holds its roots in" {
  let cycle = |b: Answer, order: List<Bytes>|
    codes_over(
      [{ key: b"m.a", value: one_body(b"m.a", [b"m.b"]) }, { key: b"m.b", value: b }],
      order,
      [],
    );
  let one = cycle(one_body(b"m.b", [b"m.a"]), [b"m.a", b"m.b"]);
  assert_eq(cycle(one_body(b"m.b", [b"m.a"]), [b"m.b", b"m.a"]), one);
  assert(one.get(b"m.a") != one.get(b"m.b"), None);
  let edited = match edited_body(b"m.b") {
    Body(b) -> Body({ ..b, tables: { ..b.tables, calls: [b"m.a"] } }),
    other -> other,
  };
  assert(cycle(edited, [b"m.a", b"m.b"]).get(b"m.a") != one.get(b"m.a"), None)
}

// A body names a constructor's tag by the constructor, so the same answer serves programs whose
// tables differ, and each unit writes the position its own table gives.
test "a constructor's tag is its bucket's to read, at the position the unit's own table gives it" {
  let runtime = a_runtime(b"r");
  let answer = Body({
    text: b"Word f_m.f(PlyCtx *ctx) { return @@Tm.Line@@ + @@TNone@@; }",
    tables: { ..no_tables(), symbols: [{ symbol: b"f_m.f", entry: b"e_m.f", head: word_head(0) }] },
  });
  let unit = |ctors: List<Ctor>|
    produce(
      runtime,
      ctors,
      [{ name: b"m.f", arity: 0, constant: false }],
      1,
      Map::new().insert(b"m.f", answer),
      Map::new(),
    ).text;
  let alone = unit([
    { name: b"None", arity: 0, args: [] },
    { name: b"m.Dot", arity: 0, args: [] },
    { name: b"m.Line", arity: 1, args: [] },
  ]);
  let beside = unit([
    { name: b"None", arity: 0, args: [] },
    { name: b"a.One", arity: 0, args: [] },
    { name: b"a.Two", arity: 0, args: [] },
    { name: b"m.Dot", arity: 0, args: [] },
    { name: b"m.Line", arity: 1, args: [] },
  ]);
  let table = bucket_table(bucket_of(b"m.f"));
  let body = Bytes::concat_all([b"{ return ", table, b"[1] + ", table, b"[0]; }"]);
  assert(alone.index_of(body) != None, None);
  assert(beside.index_of(body) != None, None);
  // The bucket declares the table, and the unit lays it out filled beside its descriptor.
  let declared = Bytes::concat_all([b"extern const uint32_t ", table, b"[];\n"]);
  assert(bucket_part(alone, bucket_of(b"m.f")).index_of(declared) != None, None);
  let filled = |places: Bytes|
    Bytes::concat_all([b"const uint32_t ", table, b"[] = {", places, b" };\n"]);
  assert(alone.index_of(filled(b" 0, 2,")) != None, None);
  assert(beside.index_of(filled(b" 0, 4,")) != None, None)
}

/// A bucket's part of a unit's C: from its mark to the next part's.
fn bucket_part(unit: Bytes, id: Int) -> Bytes / {abort.raise} =
  match unit.index_of(bucket_mark(id)) {
    None -> b"",
    Some(start) -> match unit.index_of_from(b"/* --- ", start + 1) {
      Some(end) -> unit.slice(start, end),
      None -> unit.slice(start, unit.len()),
    },
  }

test "a bucket's C reads the same whatever another bucket adds to the unit's tables" {
  let runtime = { ..a_runtime(b"r"), head: b"/* head */\n", tail: b"/* --- the runtime --- */\n" };
  let other = range(0, 4096).fold(b"", |found: Bytes, i: Int| {
    let n = b"a.other".concat(ascii_of_int(i));
    if found == b"" && bucket_of(n) != bucket_of(b"m.f") { n } else { found }
  });
  let unit = |names: List<Bytes>|
    produce(
      runtime,
      [{ name: b"None", arity: 0, args: [] }],
      names.map(|n: Bytes| { name: n, arity: 0, constant: false }),
      1,
      names.fold(Map::new(), |acc: Map<Bytes, Answer>, n: Bytes| acc.insert(n, one_body(n, []))),
      Map::new(),
    ).text;
  let alone = unit([b"m.f"]);
  let beside = unit([b"m.f", other]);
  assert(bucket_part(alone, bucket_of(b"m.f")) != b"", None);
  assert_eq(bucket_part(beside, bucket_of(b"m.f")), bucket_part(alone, bucket_of(b"m.f")));
  // What moved is the unit's own table: `other`'s constant sorts first, so `m.f`'s is the second.
  assert(alone != beside, None)
}

/// The first of `prefix` and a number whose bucket is none of `others'`.
fn bucket_apart(prefix: Bytes, others: List<Bytes>) -> Bytes =
  range(0, 4096).fold(b"", |found: Bytes, i: Int| {
    let n = prefix.concat(ascii_of_int(i));
    let free = others.fold(true, |ok: Bool, o: Bytes| ok && bucket_of(o) != bucket_of(n));
    if found == b"" && free { n } else { found }
  })

// A bucket is compiled alone, so it declares what its bodies call at the width each is taken at,
// and nothing else; and a body sits once, in the bucket its name alone decides.
test "a bucket holds the bodies its names decide and declares what they reach, and nothing else" {
  let caller = b"m.caller";
  let callee = bucket_apart(b"m.callee", [caller]);
  let apart = bucket_apart(b"m.apart", [caller, callee]);
  let p = produce(
    { ..a_runtime(b"r"), head: b"/* head */\n", tail: b"/* tail */\n" },
    [],
    [
      { name: caller, arity: 0, constant: false },
      { name: callee, arity: 2, constant: false },
      { name: apart, arity: 0, constant: false },
    ],
    1,
    Map::of_entries([
      { key: caller, value: one_body(caller, [callee]) },
      { key: callee, value: headed(one_body(callee, []), word_head(2)) },
      { key: apart, value: one_body(apart, []) },
    ]),
    Map::new(),
  );
  let declares = |part: Bytes, name: Bytes, arity: Int|
    part.index_of(prototype(b"f_".concat(name), word_head(arity))) != None;
  let calling = bucket_part(p.text, bucket_of(caller));
  assert(
    declares(calling, caller, 0) && declares(calling, callee, 2),
    Some(String::of_bytes_lossy(calling)),
  );
  assert(!declares(calling, apart, 0), Some(String::of_bytes_lossy(calling)));
  let alone = bucket_part(p.text, bucket_of(apart));
  assert(
    !declares(alone, caller, 0) && !declares(alone, callee, 2),
    Some(String::of_bytes_lossy(alone)),
  );
  let head = match p.text.index_of(b"/* --- bucket ") {
    Some(at) -> p.text.slice(0, at),
    None -> p.text,
  };
  [caller, callee, apart].fold((), |u: Unit, name: Bytes| {
    let defined = Bytes::concat_all([b"Word f_", name, b"(PlyCtx *ctx)"]);
    assert_eq(p.text.split(defined).len() - 1, 1);
    assert_eq(bucket_part(p.text, bucket_of(name)).split(defined).len() - 1, 1);
    assert(head.index_of(b"f_".concat(name)) == None, None)
  })
}

test "where the head defines `PLY_FAR` a bucket calls what another defines through its table, and its own directly" {
  let caller = b"m.caller";
  let callee = bucket_apart(b"m.callee", [caller]);
  let p = produce(
    { ..a_runtime(b"r"), head: b"/* head */\n", tail: b"/* tail */\n" },
    [],
    [{ name: caller, arity: 0, constant: false }, { name: callee, arity: 2, constant: false }],
    1,
    Map::of_entries([
      { key: caller, value: one_body(caller, [callee]) },
      { key: callee, value: headed(one_body(callee, []), word_head(2)) },
    ]),
    Map::new(),
  );
  let calling = bucket_part(p.text, bucket_of(caller));
  let shown = Some(String::of_bytes_lossy(calling));
  let table = far_table(bucket_of(caller));
  let opened = calling.index_of(
    Bytes::concat_all([
      b"#ifdef PLY_FAR\nstatic void *const ",
      table,
      b"[] = { (void *)&f_",
      callee,
      b", 0 };\n#define f_",
      callee,
      b"(...) ((Word (*)(PlyCtx*, Word, Word))",
      table,
      b"[0])(__VA_ARGS__)\n#endif\n",
    ]),
  );
  let defined = calling.index_of(Bytes::concat_all([b"Word f_", caller, b"(PlyCtx *ctx)"]));
  let ended = calling.index_of(
    Bytes::concat_all([b"#ifdef PLY_FAR\n#undef f_", callee, b"\n#endif\n"]),
  );
  match ((opened, defined, ended)) {
    (Some(o), Some(d), Some(x)) -> assert(o < d && d < x, shown),
    _ -> assert(false, shown),
  };
  assert(calling.index_of(b"#define f_".concat(caller)) == None, shown);
  assert(bucket_part(p.text, bucket_of(callee)).index_of(b"PLY_FAR") == None, None)
}

// A call written to another head than its callee's is C two compilers disagree over silently, as
// a `Word` and an `int64_t` are one type; the unit refuses it instead.
test "specialisations alike but for their names are one root" {
  let body = |name: Bytes, other: Bytes|
    Body({
      text: Bytes::concat_all([
        b"Word ",
        symbol_of(name),
        b"(PlyCtx *ctx) { return ",
        other,
        b"; }",
      ]),
      tables: {
        ..no_tables(),
        calls: [name],
        symbols: [{ symbol: symbol_of(name), entry: entry_of(name), head: word_head(0) }],
      },
    });
  let answers = Map::of_entries([
    { key: b"m.f@Int", value: body(b"m.f@Int", b"0") },
    { key: b"m.f@Bool", value: body(b"m.f@Bool", b"0") },
    { key: b"m.f@U8", value: body(b"m.f@U8", b"1") },
    { key: b"m.g@Int", value: body(b"m.g@Int", b"0") },
  ]);
  assert_eq(alike(answers).entries(), [{ key: b"m.f@Int", value: b"m.f@Bool" }])
}

test "a call written to another head than the callee defines fails the unit" {
  let caller = b"m.caller";
  let callee = b"m.callee";
  let expecting = |head: Head|
    match one_body(caller, [callee]) {
      Body(b) ->
        Body({
          ..b,
          tables: {
            ..b.tables,
            generics: { ..no_generics(), expects: [{ callee: callee, head: head }] },
          },
        }),
      other -> other,
    };
  let made = |head: Head|
    try[abort.raise] {
      produce(
        a_runtime(b"r"),
        [],
        [{ name: caller, arity: 0, constant: false }, { name: callee, arity: 1, constant: false }],
        1,
        Map::of_entries([
          { key: caller, value: expecting(head) },
          {
            key: callee,
            value: headed(one_body(callee, []), { answer: b"double", params: [b"double"] }),
          },
        ]),
        Map::new(),
      ).taken
    };
  assert_eq(made({ answer: b"double", params: [b"double"] }), Ok([callee, caller]));
  match made(word_head(1)) {
    Ok(_) -> assert(false, Some("a call to another head was taken")),
    Err(why) ->
      assert(
        Bytes::of_string(why).index_of(b"which it defines as double f_m.callee(PlyCtx*, double)")
          != None,
        Some(why),
      ),
  }
}

test "a constant two bodies read is one entry of the pool" {
  let reading = |name: Bytes|
    match one_body(name, []) {
      Body(b) -> Body({ ..b, tables: { ..b.tables, consts: [ConstStr(b"shared-constant")] } }),
      other -> other,
    };
  let p = produce(
    a_runtime(b"r"),
    [],
    [{ name: b"m.one", arity: 0, constant: false }, { name: b"m.two", arity: 0, constant: false }],
    1,
    Map::of_entries([
      { key: b"m.one", value: reading(b"m.one") },
      { key: b"m.two", value: reading(b"m.two") },
    ]),
    Map::new(),
  );
  assert_eq(p.taken, [b"m.one", b"m.two"]);
  assert_eq(p.text.split(line(ConstStr(b"shared-constant"))).len() - 1, 1)
}

/// A name in `name`'s bucket that is not `name`, for a test that wants two roots to share one.
fn bucket_mate(name: Bytes) -> Bytes =
  range(0, 4096).fold(b"", |found: Bytes, i: Int| {
    let n = b"m.mate".concat(ascii_of_int(i));
    if found == b"" && bucket_of(n) == bucket_of(name) { n } else { found }
  })

fn answered_by(answers: List<{ key: Bytes, value: Answer }>) -> (Bytes) -> Option<Answer> = {
  let m = Map::of_entries(answers);
  |k: Bytes| m.get(k)
}

test "a bucket's pack answers before a root's own body, and a root kept with neither is asked again" {
  let mate = bucket_mate(b"m.a");
  assert(bucket_of(b"m.b") != bucket_of(b"m.a") && bucket_of(b"m.c") != bucket_of(b"m.a"), None);
  let packed = one_body(b"m.a", []);
  let looked = looked_up(
    Map::of_entries([
      { key: b"m.a", value: b"ma" },
      { key: b"m.b", value: b"mb" },
      { key: b"m.c", value: b"mc" },
      { key: mate, value: b"md" },
    ]),
    Map::new().insert(bucket_of(b"m.a"), Map::new().insert(b"m.a", packed)),
    answered_by([
      { key: b"ma", value: one_body(b"m.a", [b"m.old"]) },
      { key: b"mb", value: one_body(b"m.b", []) },
      { key: b"md", value: one_body(mate, []) },
    ]),
  );
  assert_eq(looked.get(b"m.a"), Some(packed));
  assert_eq(looked.get(b"m.b"), Some(one_body(b"m.b", [])));
  assert_eq(looked.get(b"m.c"), None);
  // A pack holds every body its bucket had, so a root it does not hold had none.
  assert_eq(looked.get(mate), None)
}

test "a kept body stands only where each callee it names still has the key it was filed with" {
  let keys = Map::of_entries([{ key: b"m.b", value: b"kb" }]);
  let body = one_body(b"m.a", [b"m.b"]);
  let filed = kept_of(keys, body);
  assert(holds(keys, filed.callees));
  // Another tree's callee that hashes alike under another name: the C would call a name not here.
  assert(!holds(Map::of_entries([{ key: b"m.c", value: b"kb" }]), filed.callees));
  assert(!holds(Map::of_entries([{ key: b"m.b", value: b"another" }]), filed.callees));
  assert_eq(decoded(keys, Some(bin::encode(filed, kept_bin()))), Some(body));
  assert_eq(decoded(Map::new(), Some(bin::encode(filed, kept_bin()))), None);
  let pack = bin::encode({ rows: [{ name: b"m.a", kept: filed }] }, pack_bin());
  assert_eq(unpacked(keys, Some(pack)), Some(Map::new().insert(b"m.a", body)));
  assert_eq(unpacked(Map::new(), Some(pack)), Some(Map::new()))
}

test "a pack is written again where it was missing or a root in it gained a body" {
  let mate = bucket_mate(b"m.a");
  let refusal = Refused({ why: b"a body the lowering does not reach" });
  let buckets = bucketed([b"m.a", mate, b"m.b"]);
  let packs = Map::new().insert(bucket_of(b"m.a"), Map::new().insert(b"m.a", one_body(b"m.a", [])));
  let looked = Map::of_entries([
    { key: b"m.a", value: one_body(b"m.a", []) },
    { key: mate, value: refusal },
    { key: b"m.b", value: one_body(b"m.b", []) },
  ]);
  let rows = |rs: List<Repack>| rs.map(|r: Repack| r.pack.rows.map(|p: Packed| p.name));
  assert_eq(rows(repacked(Map::new(), buckets, packs, looked, Map::new())), [[b"m.b"]]);
  let again = rows(
    repacked(Map::new(), buckets, packs, looked, Map::new().insert(mate, one_body(mate, []))),
  );
  assert_eq(again.len(), 2);
  assert(again.fold(false, |found: Bool, r: List<Bytes>| found || r == [b"m.a", mate]), None)
}

fn three_modules() -> List<Bytes> =
  [
    b"import b\nimport c\nfn f(x: Int) -> Int = b::g(x) + c::h(x)\n",
    b"import c\npub fn g(x: Int) -> Int = c::h(x) * 2\n",
    Bytes::concat_all([
      b"pub fn h(x: Int) -> Int = if even(x) { x } else { x + 1 }\n",
      b"fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n",
      b"fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n",
    ]),
  ]

fn three_modules_dump() -> Dump / {abort.raise} = {
  let texts = three_modules();
  dump_of(
    analyse(
      parse_all([
        { name: b"a", src: texts.get(0) },
        { name: b"b", src: texts.get(1) },
        { name: b"c", src: texts.get(2) },
      ]),
    ),
  )
}

test "roots are dealt a module at a time, each once, over no more lists than there are pieces" {
  let dump = three_modules_dump();
  let p = program_of(dump, three_modules());
  let missed = dump.emitter_roots.map(|r: EmitterRoot| r.root);
  let lists = dealt(p, missed);
  assert_eq(lists.len(), pieces());
  assert_eq(
    ordered(lists.fold([], |acc: List<Bytes>, roots: List<Bytes>| acc.concat(roots))),
    ordered(missed),
  );
  assert_eq(lists.fold(0, |n: Int, roots: List<Bytes>| n + roots.len()), missed.len());
  let modules = |roots: List<Bytes>| ordered(roots.map(module_of_root));
  assert_eq(
    lists.fold(0, |n: Int, roots: List<Bytes>| n + modules(roots).len()),
    modules(missed).len(),
  );
  let many = range(0, 3 * pieces()).map(|i: Int| Bytes::concat_all([b"m", ascii_of_int(i), b".f"]));
  assert_eq(dealt(p, many).len(), pieces())
}

test "a root's kept answer moves with what its module embeds, and with no other module's" {
  let dump = three_modules_dump();
  let embedding = |bytes: Bytes|
    program_of(
      {
        ..dump,
        embeds: [{ module: b"c", key: b"file:data.txt", read: Ok([embed_file(b"", bytes)]) }],
      },
      three_modules(),
    );
  let one = root_material(embedding(b"one"), b"", b"c.h");
  assert(one != None, None);
  assert(one != root_material(embedding(b"two"), b"", b"c.h"), None);
  assert_eq(
    root_material(embedding(b"one"), b"", b"a.f"),
    root_material(program_of(dump, three_modules()), b"", b"a.f"),
  )
}

test "a root written from a type is kept under its module's text and the program's types" {
  let dump = three_modules_dump();
  let p = program_of(dump, three_modules());
  let types = types_material(dump);
  let reflected = b"a.reflect#{x:Int}";
  let kept = root_material(p, types, reflected);
  assert(kept != None, None);
  assert(kept == root_material(p, types, reflected), None);
  // Another constructor anywhere, or another text of its module, moves it; a root of no module's
  // text has none.
  assert(kept != root_material(p, types_material({ ..dump, ctors: [] }), reflected), None);
  assert(
    kept
      != root_material(
        program_of(dump, three_modules().map(|s: Bytes| s.concat(b"\n"))),
        types,
        reflected,
      ),
    None,
  );
  assert_eq(root_material(p, types, b"nowhere.reflect#{x:Int}"), None)
}

test "the emitter answers roots dealt over calls as it answers them in one" {
  let dump = three_modules_dump();
  let p = program_of(dump, three_modules());
  let missed = dump.emitter_roots.map(|r: EmitterRoot| r.root);
  let runtime = a_runtime(b"r");
  let lists = dealt(p, missed);
  let rows = |answers: List<RootAnswer>|
    answers_of(answers).fold([], |acc: List<RootAnswer>, n: Bytes, a: Answer|
      acc.push({ name: n, answer: a }));
  let together = rows(emitter_answers(runtime, dump, p, [], missed));
  assert(
    together.fold(false, |found: Bool, r: RootAnswer|
      found
        || (match r.answer {
          Body(b) -> b.tables.members == [b"c.even", b"c.odd"],
          Refused(_) -> false,
        })),
    None,
  );
  assert_eq(rows(answers_at_once(runtime, dump, p, [], lists, 0, lists.len(), 64)), together)
}

test "a unit holds a `const` definition as the value a build kept, and makes its stored root" {
  let source = b"const fn table() -> List<Int> = spread(3)\nfn spread(n: Int) -> List<Int> = [n, n + 1]\nfn first() -> Int = match table() { [x, ..] -> x, [] -> 0 }\n";
  let dump = dump_of(analyse(parse_all([{ name: b"m", src: source }])));
  assert_eq(dump.baked.map(|row: { name: Bytes, hash: Bytes }| row.name), [b"m.table"]);
  let runtime = a_runtime(b"r");
  let unit = |every: List<Bytes>, baked: List<Baked>|
    match emitted(
        runtime,
        dump,
        [source],
        Map::new(),
        every,
        b"",
        |_: Bytes| None,
        |_: Bytes, _: Bytes| (),
        baked,
      ) {
      Ok(e) -> e,
      Err(why) -> panic(String::of_bytes_lossy(why)),
    };
  let held = unit([b"m.table", b"m.first"], [{ name: b"m.table", text: b"78da" }]);
  // The value stands where the body would: nothing asks the emitter for it, or for what it calls.
  assert_eq(held.asked, 1);
  assert_eq(held.produced.taken, [b"m.first", b"m.table"]);
  assert(
    held.produced.text.index_of(
        Bytes::concat_all([
          b"static const char ",
          symbol_of(b"m.table"),
          b"_baked[] =\n\"78da\"\n;",
        ]),
      )
      != None,
    None,
  );
  assert(held.produced.text.index_of(b", INT64_C(4));") != None, None);
  // A value for a root the unit does not hold is no part of it.
  let apart = unit([b"m.spread"], [{ name: b"m.table", text: b"78da" }]);
  assert_eq(apart.produced.text.index_of(b"_baked"), None);
  // The stored root reads the definition as any body reads a constant, and needs it held.
  let storing = unit([b"m.table", b"m.spread", stored_root(b"m.table")], []);
  assert_eq(storing.asked, 2);
  assert_eq(storing.produced.taken, [b"m.spread", b"m.table", b"m.table#stored"]);
  assert(storing.produced.text.index_of(b"rt_stored_p(ctx, held)") != None, None);
  let alone = unit([stored_root(b"m.table")], []);
  assert_eq(alone.produced.dropped.map(|d: Dropped| d.function), [b"m.table#stored"])
}

fn native_of(e: Extern) -> Native =
  { name: e.name, words: e.words, answers: true, raises: e.raises }

test "an `extern fn` no native implements, two do, or one does otherwise, is unbound" {
  let declared = |name: Bytes, words: Int, raises: Bool|
    { module: b"std.prelude", name: name, words: words, raises: raises };
  let native = |name: Bytes, words: Int, answers: Bool, raises: Bool|
    { name: name, words: words, answers: answers, raises: raises };
  let found = unbound(
    [
      native(b"List::len", 1, true, false),
      native(b"assert", 2, true, true),
      native(b"twice", 1, true, false),
      native(b"twice", 1, true, false),
      native(b"wider", 2, true, false),
      native(b"silent", 1, false, false),
      native(b"calm", 1, true, false),
      native(b"undeclared", 3, true, false),
    ],
    [
      declared(b"List::len", 1, false),
      declared(b"assert", 2, true),
      declared(b"gone", 0, false),
      declared(b"twice", 1, false),
      declared(b"wider", 1, false),
      declared(b"silent", 1, false),
      declared(b"calm", 1, true),
    ],
  );
  assert_eq(found.map(|u: Unbound| { name: u.declared.name, found: u.found.len() }), [
    { name: b"gone", found: 0 },
    { name: b"twice", found: 2 },
    { name: b"wider", found: 1 },
    { name: b"silent", found: 1 },
    { name: b"calm", found: 1 },
  ]);
  assert_eq(found.map(unbound_line), [
    b"`extern fn gone` of `std.prelude`: no native of the runtime implements it",
    b"`extern fn twice` of `std.prelude`: 2 natives of the runtime implement it",
    b"`extern fn wider` of `std.prelude` takes 1 word and cannot raise, and the runtime's native takes 2 words and cannot raise",
    b"`extern fn silent` of `std.prelude` takes 1 word and cannot raise, and the runtime's native takes 1 word, answers nothing and cannot raise",
    b"`extern fn calm` of `std.prelude` takes 1 word and raises, and the runtime's native takes 1 word and cannot raise",
  ]);
  assert_eq(
    unbound([], [{ module: b"", name: b"?hold_take", words: 1, raises: false }]).map(unbound_line),
    [b"the compiler's `?hold_take`: no native of the runtime implements it"],
  )
}

/// The unit of a program of `user` modules and the `shipped` ones they import, held against a
/// runtime of `natives`.
fn held_over(
  user: List<{ name: Bytes, src: Bytes }>,
  shipped: List<{ name: Bytes, src: Bytes }>,
  natives: List<Native>,
) -> Result<Bytes, List<Diag>> / {abort.raise} = {
  let dump = dump_of(analyse_pulling_std_with(user, shipped, no_rows()).out);
  let every = dump.emitter_roots.map(|r: EmitterRoot| r.root);
  held(
    dump,
    every,
    emitted(
      { ..a_runtime(b"r"), natives: natives },
      dump,
      sources_placed(dump, user.concat(shipped)),
      Map::new(),
      every,
      b"",
      |_: Bytes| None,
      |_: Bytes, _: Bytes| (),
    ),
  )
}

/// The texts of `modules`, and the prelude's where none of them is it, at the places `dump` gives
/// them.
fn sources_placed(dump: Dump, modules: List<{ name: Bytes, src: Bytes }>) -> List<Bytes> = {
  let texts = modules.fold(
    Map::new().insert(prelude_module(), prelude_source::text()),
    |acc: Map<Bytes, Bytes>, s: { name: Bytes, src: Bytes }| acc.insert(s.name, s.src),
  );
  let indexed = dump.modules.fold(Map::new(), |acc: Map<Int, Bytes>, m: ModuleRow|
    acc.insert(m.index, match texts.get(m.name) { Some(t) -> t, None -> b"" }));
  range(0, indexed.len()).map(|i: Int| match indexed.get(i) { Some(t) -> t, None -> b"" })
}

fn refusal(r: Result<Bytes, List<Diag>>) -> List<Bytes> =
  match r {
    Ok(_) -> [],
    Err(diags) -> diags.fold([], |acc: List<Bytes>, d: Diag| acc.push(d.code).concat(d.notes_text)),
  }

test "a unit is refused where the runtime does not implement a native it calls as declared, and not for one it never calls" {
  let program = [
    {
      name: b"m",
      src: b"fn upto(n: Int) -> List<Int> = range(0, n)\nfn twice<a>(x: a) -> a where numeric(a) = x + x\n",
    },
  ];
  let implemented = declared_natives().map(native_of);
  let taking = |name: Bytes, words: Int|
    implemented.map(|n: Native| if n.name == name { { ..n, words: words } } else { n });
  assert_eq(refusal(held_over(program, [], implemented)), []);
  // Neither is called, so a runtime that lacks one or takes the other otherwise is no matter.
  assert_eq(
    refusal(
      held_over(
        program,
        [],
        taking(b"Secret::verify", 9).filter(|n: Native| n.name != b"Secret::is_empty"),
      ),
    ),
    [],
  );
  let refused = refusal(held_over(program, [], taking(b"range", 3)));
  assert_eq(refused.get(0), b"E0476");
  assert_eq(
    refused.get(1),
    b"`extern fn range` of `std.prelude` takes 2 words and cannot raise, and the runtime's native takes 3 words and cannot raise",
  );
  assert_eq(
    refusal(held_over(program, [], taking(b"?numeric_binary", 5))).get(1),
    b"the compiler's `?numeric_binary` takes 4 words and cannot raise, and the runtime's native takes 5 words and cannot raise",
  );
  let twice = implemented.concat(implemented.filter(|n: Native| n.name == b"range"));
  assert_eq(
    refusal(held_over(program, [], twice)).get(1),
    b"`extern fn range` of `std.prelude`: 2 natives of the runtime implement it",
  )
}

test "a unit whose bodies write externs in place asks the runtime for no native of them" {
  // What the prelude declares that a native implements: its builtins, and `ListNode::leaf_of`.
  let implemented = program_natives([]).map(native_of);
  let names = implemented.map(|n: Native| n.name);
  assert_eq(
    intrinsics().filter(|i: { name: Bytes, op: Intrinsic }|
      names.contains(i.name.slice(b"std.prelude.".len(), i.name.len()))).len(
    ),
    0,
  );
  let calls = b"\npub fn pushed(xs: List<Int>) -> List<Int> = ListNode::tail_push(xs, 1)\npub fn emptied(m: Map<Int, Int>) -> Map<Int, Int> = MapNode::map_swap(m, None, 0, 0).map\n";
  let program = [{ name: b"std.prelude", src: prelude_source::text().concat(calls) }];
  match held_over(program, [], implemented) {
    Ok(c) ->
      assert_eq(
        [
          c.index_of(b"rt_list_writable_p(ctx, ") != None,
          c.index_of(b"rt_map_writable_p(ctx, ") != None,
        ],
        [true, true],
      ),
    Err(diags) -> assert_eq(diags.map(|d: Diag| d.code), []),
  }
}

test "a unit is refused where the runtime implements a shipped module's `extern fn` it calls otherwise" {
  let native = [{ name: b"std.native", src: b"pub extern fn doubled(x: Int) -> Int\n" }];
  let program = [{ name: b"m", src: b"import std.native (doubled)\nfn f() -> Int = doubled(2)\n" }];
  let doubled = |words: Int| { name: b"doubled", words: words, answers: true, raises: false };
  let implemented = declared_natives().map(native_of);
  assert_eq(refusal(held_over(program, native, implemented.push(doubled(1)))), []);
  assert_eq(refusal(held_over(program, native, implemented.push(doubled(2)))), [
    b"E0476",
    b"`extern fn doubled` of `std.native` takes 1 word and cannot raise, and the runtime's native takes 2 words and cannot raise",
    natives_refused([]).notes_text.get(0),
  ])
}

test "a function of a type a module calls with no import is read from its home, which the emitter is handed" {
  let user = [{ name: b"m", src: b"fn first(xs: List<Int>) -> Int / {abort.raise} = xs.get(0)\n" }];
  let shipped = [
    {
      name: b"std.list",
      src: b"pub fn List::get<a>(xs: List<a>, i: Int) -> a / {abort.raise} = match xs.at(i) { Some(x) -> x, None -> panic(\"no element there\") }\n",
    },
  ];
  let dump = dump_of(analyse_pulling_std_with(user, shipped, no_rows()).out);
  let p = program_of(dump, sources_placed(dump, user.concat(shipped)));
  assert_eq(
    emitter_answers(a_runtime(b"r"), dump, p, [], [b"m.first"]).map(|r: RootAnswer|
      match r.answer { Body(_) -> r.name, Refused(no) -> no.why }),
    [b"m.first"],
  )
}

test "a law's body over a sort it leaves uninterpreted is lowered as a generic body as it stands" {
  let user = [
    {
      name: b"m",
      src: b"fn pair<a>(x: a) -> a = x\n\nlaw \"identity is identity\"\n  forall (x: a) {\n    pair(x) == x\n  }\n",
    },
  ];
  let dump = dump_of(analyse(parse_all(user)));
  let p = program_of(dump, sources_placed(dump, user));
  let root = law_root(b"m", b"identity is identity", b"body");
  assert_eq(
    emitter_answers(a_runtime(b"r"), dump, p, [], [root]).map(|r: RootAnswer|
      match r.answer { Body(_) -> r.name, Refused(no) -> no.why }),
    [root],
  )
}

test "a root the emitter refuses is asked again, and nothing of the refusal is kept" {
  let dump = dump_of(analyse(parse_all([{ name: b"m", src: b"pub fn f() -> Int = 1\n" }])));
  // The text the emitter reads names a module the program does not hold: the refusal is the
  // program's doing, which nothing the root is filed under says.
  let source = b"import gone (x)\n\npub fn f() -> Int = 1\n";
  let runtime = a_runtime(b"r");
  kept_bodies(|| {
    let run = ||
      match emitted(
          runtime,
          dump,
          [source],
          Map::new(),
          [b"m.f"],
          b"",
          |k: Bytes| body_store.get(k),
          |k: Bytes, v: Bytes| body_store.put(k, v),
        ) {
        Ok(e) -> e,
        Err(why) -> panic(String::of_bytes_lossy(why)),
      };
    let first = run();
    assert_eq(first.produced.dropped.map(|d: Dropped| d.function), [b"m.f"]);
    let again = run();
    assert_eq(again.asked, 1);
    assert_eq(again.produced.dropped.map(|d: Dropped| d.function), [b"m.f"])
  })
}

test "a unit asks the emitter for a root a kept body names, though the body's definition has moved" {
  let lending = b"fn each(n: Int, f: (Int) -> Int, i: Int, acc: Int) -> Int = if i >= n { acc } else { each(n, f, i + 1, acc + f(i)) }\nfn total(n: Int, f: (Int) -> Int) -> Int = each(n, f, 0, 0)\nfn scaled(n: Int, k: Int) -> Int = total(n, |x: Int| x * k)\n";
  let runtime = a_runtime(b"r");
  kept_bodies(|| {
    let unit = |source: Bytes|
      match emitted(
          runtime,
          dump_of(analyse(parse_all([{ name: b"m", src: source }]))),
          [source],
          Map::new(),
          [b"m.each", b"m.total", b"m.scaled"],
          b"",
          |k: Bytes| body_store.get(k),
          |k: Bytes, v: Bytes| body_store.put(k, v),
        ) {
        Ok(e) -> e,
        Err(why) -> panic(String::of_bytes_lossy(why)),
      };
    assert_eq(unit(lending).produced.dropped, []);
    // What the next run starts from: the body of `scaled`, and of no root it names.
    body_store.replace(
      body_store.all().fold(Map::new(), |acc: Map<Bytes, Bytes>, k: Bytes, v: Bytes|
        match bin::decode(v, kept_bin()) {
          Ok(filed) -> match filed.answer {
            Body(b) -> if b.tables.symbols.map(|d: Defined| d.symbol) == [symbol_of(b"m.scaled")] {
              acc.insert(k, v)
            } else { acc },
            Refused(_) -> acc,
          },
          Err(_) -> acc,
        }),
    );
    assert_eq(body_store.all().len(), 1);
    let moved = unit(
      b"// a comment, and a definition, above them\nfn aside() -> Int = 7\n".concat(lending),
    );
    assert_eq(moved.kept, 1);
    assert_eq(moved.produced.dropped, [])
  })
}

/// The store a test's emissions keep bodies in.
effect body_store {
  read get(k: Bytes) -> Option<Bytes>
  write put(k: Bytes, v: Bytes) -> Unit
  read all() -> Map<Bytes, Bytes>
  write replace(m: Map<Bytes, Bytes>) -> Unit
}

/// `body` with an empty store of bodies.
fn kept_bodies<a | e>(
  body: () -> a / {body_store.get, body_store.put, body_store.all, body_store.replace | e},
) -> a / e =
  handle {
    body()
  } with {
    var store: Map<Bytes, Bytes> = Map::new(),
    body_store.get(k) -> store.get(k),
    body_store.put(k, v) -> {
      store = store.insert(k, v);
    },
    body_store.all() -> store,
    body_store.replace(m) -> {
      store = m;
    },
  }

test "a value's text is cut into literals no longer than a compiler takes" {
  assert_eq(quoted(b"ab"), b"\"ab\"\n");
  assert_eq(quoted(b""), b"\"\"\n");
  let long = Bytes::concat_all(range(0, piece_len() + 1).map(|_: Int| b"0"));
  assert_eq(quoted(long).split(b"\n").len(), 3)
}

/// What reading `key` back answers over a directory `kept` whose file for it holds `bytes`.
fn read_back(tree: fs::MemFs, key: Bytes, bytes: Bytes) -> Option<Bytes> / {abort.raise} =
  fs::on_mem[abs](fs::mem_write(tree, "kept/" ++ String::of_bytes(key), bytes).fs, ||
    handle { kept_value[abs]("kept", key) } with { time.now_ms() -> 0 }).value

test "a kept value reads back whole, and one cut short or altered reads as none" {
  let key = baked_key(b"runtime", b"emitter", b"hash");
  let kept = fs::on_mem[abs](fs::mem_empty(), ||
    handle {
      keep_value[abs]("kept", key, b"78da01");
      kept_value[abs]("kept", key)
    } with {
      entropy.next() -> 7,
      time.now_ms() -> 0,
    });
  assert_eq(kept.value, Some(b"78da01"));
  let whole = match fs::mem_read(kept.tree, "kept/" ++ String::of_bytes(key)) {
    Some(bytes) -> bytes,
    None -> panic("the value is kept under its key"),
  };
  assert_eq(read_back(kept.tree, key, whole), Some(b"78da01"));
  assert_eq(read_back(kept.tree, key, whole.slice(0, whole.len() - 1)), None);
  assert_eq(read_back(kept.tree, key, whole.concat(b"0")), None);
  assert_eq(read_back(kept.tree, key, b""), None)
}

test "a value is kept under the runtime, the compiler and the hash of all its definition reaches" {
  let key = baked_key(b"runtime", b"emitter", b"hash");
  assert_eq(key.len(), 64);
  assert(baked_key(b"another", b"emitter", b"hash") != key);
  assert(baked_key(b"runtime", b"another", b"hash") != key);
  assert(baked_key(b"runtime", b"emitter", b"another") != key);
  assert(baked_key(b"runtim", b"eemitter", b"hash") != key)
}

test "a unit takes what its callees let it, resolves its bodies and says what it holds" {
  let runtime = {
    ..a_runtime(b"r"),
    head: b"/* head */\n",
    tail: b"/* tail */\n",
    helpers: [{ name: b"rt_a", args: 1, answers: true }],
  };
  let answers = Map::new().insert(b"m.f", one_body(b"m.f", [])).insert(
    b"m.g",
    one_body(b"m.g", [b"m.gone"]),
  );
  let p = produce(
    runtime,
    [{ name: b"None", arity: 0, args: [] }],
    [{ name: b"m.g", arity: 0, constant: false }, { name: b"m.f", arity: 0, constant: true }],
    1,
    answers,
    Map::new(),
  );
  assert_eq(p.taken, [b"m.f"]);
  assert_eq(p.dropped.map(|d: Dropped| d.function), [b"m.g"]);
  assert(
    p.text.index_of(
        Bytes::concat_all([
          b"Word f_m.f(PlyCtx *ctx) { return ",
          bucket_table(bucket_of(b"m.f")),
          b"[0] + ",
        ]),
      )
      != None,
    None,
  );
  assert(p.text.index_of(b"Word f_m.f(PlyCtx*);\n") != None, None);
  assert(p.text.index_of(b"/* tail */\n\n/* --- what this unit says about itself") != None, None);
  // A constant says its row of the code table, and the loader takes that table and each
  // definition's entry by address.
  assert(p.text.index_of(b"\"constants 1\\n\"\n\"m.f 0\\n\"") != None, None);
  assert(p.text.index_of(b"\"taken ") == None && p.text.index_of(b"\"lambdas ") == None, None);
  assert(p.text.index_of(b"void *const ply_code[] = {\n  (void *)&e_m.f,\n  0 };\n") != None, None);
  assert(
    p.text.index_of(
        b"const struct ply_taken ply_taken[] = {\n  { \"m.f\", (void *)&e_m.f, 0 },\n  { 0, 0, 0 } };\n",
      )
      != None,
    None,
  );
  assert(
    p.text.index_of(b"(void *)ply_bind_singletons, ply_code, 1, ply_taken, 1 };\n") != None,
    None,
  )
}

test "a unit lays its definitions out by name in byte order, each name as a C literal holds it" {
  let names = [b"m.z", b"m.a#stored", b"m.B"];
  let p = produce(
    a_runtime(b"r"),
    [],
    names.map(|n: Bytes| { name: n, arity: 2, constant: false }),
    1,
    names.fold(Map::new(), |acc: Map<Bytes, Answer>, n: Bytes| acc.insert(n, one_body(n, []))),
    Map::new(),
  );
  assert(
    p.text.index_of(
        b"ply_taken[] = {\n  { \"m.B\", (void *)&e_m.B, 2 },\n  { \"m.a#stored\", (void *)&e_m.a#stored, 2 },\n  { \"m.z\", (void *)&e_m.z, 2 },\n  { 0, 0, 0 } };\n",
      )
      != None,
    Some(String::of_bytes_lossy(p.text)),
  );
  assert_eq(
    laid([{ name: b"m.\"q\"", arity: 0, symbol: b"f", entry: b"e", head: word_head(0) }], [], []),
    Bytes::concat_all([
      b"\n/* --- what the loader takes by address --- */\nextern char e;\nvoid *const ply_code[] = {\n  0 };\n",
      b"struct ply_taken { const char *name; void *entry; unsigned long arity; };\n",
      b"const struct ply_taken ply_taken[] = {\n  { \"m.\\\"q\\\"\", (void *)&e, 0 },\n  { 0, 0, 0 } };\n",
      b"struct ply_descriptor { const char *exports; unsigned long exports_len; void *bind; void *bind_singletons; void *const *code; unsigned long code_count; const struct ply_taken *taken; unsigned long taken_count; };\n",
      b"const struct ply_descriptor ply_descriptor = { ply_exports, sizeof ply_exports - 1, (void *)ply_bind, (void *)ply_bind_singletons, ply_code, 0, ply_taken, 1 };\n",
    ]),
  )
}

test "a unit says which constructors are read through a function, and which function it lacks" {
  let p = produce(
    { ..a_runtime(b"r"), head: b"/* head */\n", tail: b"/* tail */\n" },
    [{ name: b"m.Box", arity: 2, args: [] }, { name: b"m.Dot", arity: 0, args: [] }],
    [
      { name: b"m.area", arity: 1, constant: false },
      { name: b"m.make", arity: 0, constant: false },
    ],
    1,
    Map::of_entries([
      { key: b"m.area", value: one_body(b"m.area", [b"m.area"]) },
      { key: b"m.make", value: one_body(b"m.make", [b"m.area"]) },
    ]),
    Map::new(),
    [{ ctor: b"m.Box", key: Some(b"m.area"), show: Some(b"m.text"), numeric: [] }],
  );
  assert_eq(p.taken, [b"m.area", b"m.make"]);
  assert(p.text.index_of(b"\"instances 1\\n\"\n\"m.Box m.area !\\n\"") != None, None);
  // A body that names the constructor is not taken without the key its type states.
  let alone = produce(
    a_runtime(b"r"),
    [{ name: b"m.Box", arity: 2, args: [] }],
    [{ name: b"m.make", arity: 0, constant: false }],
    1,
    Map::of_entries([{ key: b"m.make", value: one_body(b"m.make", [b"m.area"]) }]),
    Map::new(),
    [{ ctor: b"m.Box", key: Some(b"m.area"), show: None, numeric: [] }],
  );
  assert_eq(alone.taken, []);
  assert_eq(alone.dropped.map(|d: Dropped| d.missing), [Some(b"m.area")]);
  // A unit none of whose types states one says nothing of it.
  let plain = produce(
    a_runtime(b"r"),
    [],
    [{ name: b"m.f", arity: 0, constant: false }],
    1,
    Map::of_entries([{ key: b"m.f", value: one_body(b"m.f", []) }]),
    Map::new(),
  );
  assert(plain.text.index_of(b"instances") == None, None);
  // Last, every unit says it holds a `Decimal` as its two words.
  assert(plain.text.index_of(b"decimals held raw") != None, None)
}

test "a root's code moves with the key a type it names states" {
  let program = |key: Answer, calls: List<Bytes>|
    codes_over(
      [
        { key: b"m.make", value: one_body(b"m.make", calls) },
        { key: b"m.area", value: key },
        { key: b"m.edge", value: one_body(b"m.edge", []) },
      ],
      [b"m.make", b"m.area", b"m.edge"],
      [],
    );
  let keyed = program(one_body(b"m.area", []), [b"m.area"]);
  let edited = program(edited_body(b"m.area"), [b"m.area"]);
  let other = program(one_body(b"m.area", []), [b"m.edge"]);
  assert(keyed.get(b"m.make") != edited.get(b"m.make"), None);
  assert(keyed.get(b"m.make") != other.get(b"m.make"), None)
}
