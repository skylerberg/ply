        b"pub fn first<a>(xs: List<a>) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }\n",
        b"pub fn made<a>(make: () -> a) -> a = make()\n",
        b"pub fn total<a>(xs: List<a>) -> a where numeric(a) = xs.fold(numeric_of_int(0), |s: a, x: a| s + x)\n",
        b"pub fn counted<a>(xs: Columns<a>) -> Int = xs.len()\n",
      ]),
