// --- What crosses the seam ----------------------------------------------------

/// A helper the runtime binds by position: its arguments past the context, and whether it answers.
pub type Helper = { name: Bytes, args: Int, answers: Bool }

/// A function the runtime implements for an `extern fn`, as the runtime reads it off the function's
/// type: the name the extern declares, the words a call passes, whether it answers, and whether a
/// failure of it raises rather than ending the run.
pub type Native = { name: Bytes, words: Int, answers: Bool, raises: Bool }

/// The runtime a unit is compiled against: the C every unit opens with, through the runtime's
/// declarations, and closes with, its definitions; the helpers those bind by position; the natives
/// a body may call; how it lays out the objects the emitter writes code over in place; and the
/// digest of the runtime's sources and helper table.
pub type Runtime = {
  head: Bytes,
  tail: Bytes,
  helpers: List<Helper>,
  natives: List<Native>,
  layouts: Layouts,
  identity: Bytes,
}

/// What this binary ships, a function of the binary alone: its shipped modules, its version,
/// what its store's groups are a function of, and the runtime a unit is compiled against.
pub effect shipped {
  read names() -> List<String>
  /// A shipped module's text by its name, or the bytes of a data file one embeds by the name the
  /// shipped modules hold it under (`std/oid/names.txt`).
  read module(name: String) -> Option<Bytes>
  /// What the frame of `len` bytes at `offset` of the file `path` of the pack this binary carries
  /// holds, decompressed: what `ply std --answers` answered of the shipped modules (`packs`). A
  /// `len` of 0 reads the frames from `offset` to the end. Nothing where it carries no such file or
  /// the range holds no whole frame.
  read answer(path: String, offset: Int, len: Int) -> Option<Bytes>
  /// Each file this binary ships, by the name the launcher lays it out under, and its digest, as
  /// the launcher's `digests` beside them lists them: the files a packed answer stands for.
  read digests() -> Bytes
  /// What a load read of the shipped modules it pulled, for whatever observes the run: a test's
  /// pass then stands on the functions its program reached rather than on the whole modules.
  /// `pulled` is whether the load read them itself, rather than re-analysing one that did.
  read reached(view: Bytes, pulled: Bool) -> Unit
  read version() -> String
  read stamps() -> String
  read runtime() -> Runtime
  /// Each definition of this binary's own program, the one its launcher entered (the builder's own
  /// where a builder asks), and the hash its front end gave it, a `name hash` line each: a hash
  /// covers all its definition reaches.
  read definitions() -> Bytes
  /// A program's front end as an artifact carries it for a machine to load: the entry it runs, and
  /// its front end's answer over every source that answer's indices run over, in their order.
  read runnable(entry: String, files: List<{ path: String, name: String, text: Bytes }>, dump: Dump) -> Bytes
  /// A native program's front end as its pack carries it for the runtime it is linked with.
  read front(linked: Linked) -> Bytes
  /// What each of `roots`, each a `stored_root` of a `const` definition, answers on the unit
  /// compiled over that front end's answer into the library `library`, each called alone with
  /// nothing lent and under `steps` calls: its value's encoding, or none where it raised, ran past
  /// its calls, or the unit holds no such root.
  read values(files: List<{ path: String, name: String, text: Bytes }>, dump: Dump, library: String, roots: List<String>, steps: Int) -> List<Option<Bytes>>
}

/// A native as the compiler declares it that the runtime does not implement so, and every native the
/// runtime has under its name: none, more than one, or one that takes other words, answers nothing
/// or raises otherwise.
pub type Unbound = { declared: Extern, found: List<Native> }

/// Each of `declared` that `natives` does not implement, in `declared`'s order: every native answers
/// but a crossing native the compiler declares answering nothing.
pub fn unbound(natives: List<Native>, declared: List<Extern>) -> List<Unbound> = {
  let by_name = natives.fold(Map::new(), |acc: Map<Bytes, List<Native>>, n: Native|
    acc.insert(n.name, List::push(match acc.get(n.name) { Some(ns) -> ns, None -> [] }, n)));
  declared.fold([], |acc: List<Unbound>, d: Extern| {
    let found = match by_name.get(d.name) { Some(ns) -> ns, None -> [] };
    match found {
      [n] -> if n.words == d.words && n.answers == declared_answers(d) && n.raises == d.raises {
        acc
      } else { acc.push({ declared: d, found: found }) },
      _ -> acc.push({ declared: d, found: found }),
    }
  })
}

/// The natives the compiler declares itself: each `extern fn` of the prelude, then each native the
/// elaboration writes calls of.
pub fn declared_natives() -> List<Extern> / {abort.raise} =
  prelude_externs().concat(
    elaborated_natives().map(|n: Elaborated|
      { module: b"", name: n.name, words: n.words, raises: n.raises }),
  )

/// The C helper of each native a unit's bodies call, by its name without the `_p` its pointer
/// adds, and of each native a body reads as a value, which the runtime calls as that native.
fn natives_called(made: Made) -> Map<Bytes, Bool> / {abort.raise} =
  made.bodies.fold(Map::new(), |acc: Map<Bytes, Bool>, k: UnitBody|
    k.tables.builtins.fold(helpers_named(k.text, acc), |into: Map<Bytes, Bool>, b: Bytes|
      into.insert(builtin_helper(b), true)))

fn identifier_bytes() -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(48, 58).concat(range(65, 91)).push(95).concat(range(97, 123)).map(byte_of_int),
  )

/// `into` with each helper `text` names: an identifier `builtin_…_p`, the pointer a helper is
/// called through.
fn helpers_named(text: Bytes, into: Map<Bytes, Bool>) -> Map<Bytes, Bool> / {abort.raise} =
  iterate({ from: 0, found: into }, text.len() + 1, |s: { from: Int, found: Map<Bytes, Bool> }|
    match text.index_of_from(b"builtin_", s.from) {
      None -> Stop(s.found),
      Some(at) -> {
        let end = text.scan(at, identifier_bytes(), text.len() - at);
        let name = text.slice(at, end);
        let opens = at == 0 || identifier_bytes().index_of_byte(text.at(at - 1)) == None;
        Continue({
          from: end,
          found: if opens && name.ends_with(b"_p") {
            s.found.insert(name.slice(0, name.len() - 2), true)
          } else { s.found },
        })
      },
    })

/// Every native a program over the shipped `modules`, each by its name and text, may call, each once
/// as it is first declared: the compiler's own (`declared_natives`), then each `extern fn` of the
/// prelude and of each of `modules`.
pub fn program_natives(
  modules: List<{ name: Bytes, text: Bytes }>,
) -> List<Extern> / {abort.raise} =
  natives_beside(
    declared_natives(),
    modules.map(|m: { name: Bytes, text: Bytes }| externs_in(m.name, m.text)),
  )

/// `program_natives` of a program whose modules are parsed as `mods`.
pub fn parsed_natives(mods: List<ParsedModule>) -> List<Extern> / {abort.raise} =
  natives_beside(declared_natives(), mods.map(|m: ParsedModule| module_externs(m.name, m.module)))

fn natives_beside(own: List<Extern>, modules: List<List<Extern>>) -> List<Extern> / {abort.raise} =
  [externs_in(prelude_module(), prelude_source::text())].concat(modules).fold(
    {
      seen: own.fold(Map::new(), |m: Map<Bytes, Bool>, e: Extern| m.insert(e.name, true)),
      all: own,
    },
    |acc: { seen: Map<Bytes, Bool>, all: List<Extern> }, es: List<Extern>|
      es.fold(acc, |a: { seen: Map<Bytes, Bool>, all: List<Extern> }, e: Extern|
        if a.seen.contains(e.name) { a }
        else { { seen: a.seen.insert(e.name, true), all: a.all.push(e) } }),
  ).all

/// What the natives whose helpers are `called` are declared to be, as `program_natives` declares
/// them over the shipped `modules`, each module's text the one `text_of` finds; the modules are read
/// only where the compiler does not declare every one itself.
fn called_externs(
  called: Map<Bytes, Bool>,
  modules: List<ModuleRow>,
  text_of: (ModuleRow) -> Option<Bytes>,
) -> List<Extern> / {abort.raise} = {
  let calls = |e: Extern| called.contains(builtin_helper(e.name));
  let own = declared_natives();
  let rest = own.fold(called, |acc: Map<Bytes, Bool>, e: Extern|
    acc.remove(builtin_helper(e.name)));
  if rest.len() == 0 { own.filter(calls) } else {
    natives_beside(
      own,
      modules.fold([], |acc: List<List<Extern>>, m: ModuleRow|
        match text_of(m) { Some(text) -> acc.push(externs_in(m.name, text)), None -> acc }),
    ).filter(
      calls,
    )
  }
}

/// Whether the native `d` declares answers a word: all but a crossing native the compiler declares
/// answering nothing.
pub fn declared_answers(d: Extern) -> Bool =
  d.module != b"" || !elaborated_natives().any(|n: Elaborated| n.name == d.name && !n.answers)

fn native_said(words: Int, answers: Bool, raises: Bool) -> Bytes =
  Bytes::concat_all([
    b"takes ",
    ascii_of_int(words),
    if words == 1 { b" word" } else { b" words" },
    if !answers { b", answers nothing" } else { b"" },
    if raises { b" and raises" } else { b" and cannot raise" },
  ])

/// Why `u` does not bind, as a line of the diagnostic that lists it.
fn unbound_line(u: Unbound) -> Bytes = {
  let d = u.declared;
  let named = if d.module == b"" { Bytes::concat_all([b"the compiler's `", d.name, b"`"]) }
  else { Bytes::concat_all([b"`extern fn ", d.name, b"` of `", d.module, b"`"]) };
  match u.found {
    [] -> named.concat(b": no native of the runtime implements it"),
    [n] ->
      Bytes::concat_all([
        named,
        b" ",
        native_said(d.words, declared_answers(d), d.raises),
        b", and the runtime's native ",
        native_said(n.words, n.answers, n.raises),
      ]),
    ns ->
      Bytes::concat_all([
        named,
        b": ",
        ascii_of_int(ns.len()),
        b" natives of the runtime implement it",
      ]),
  }
}

/// A body the unit took whose calls of `assumed.def` were written against `assumed`, where what that
/// definition publishes once the rounds settle is `published`; none publishes nothing, which takes
/// every argument and answers a count of its own.
pub type Misassumed = { caller: RootName, assumed: Published, published: Option<Published> }

/// Whether a call written against `assumed` is written as the callee that publishes `now` takes it.
fn agrees(assumed: Published, now: Option<Published>) -> Bool =
  match now {
    Some(h) -> h == assumed,
    None -> !assumed.lent.any(|l: Bool| l) && assumed.borrowed == None,
  }

/// A handing as a diagnostic says it: each parameter lent or given, then how it answers.
fn handing_said(h: Published) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"[",
    Bytes::join(h.lent.map(|l: Bool| if l { b"lent" } else { b"given" }), b", "),
    b"] ",
    match h.borrowed {
      None -> b"owned",
      Some(from) ->
        Bytes::concat_all([
          b"borrowed(",
          Bytes::join(
            from.map(|x: { param: Int, whole: Bool }|
              if x.whole { ascii_of_int(x.param) } else { ascii_of_int(x.param).concat(b" part") }),
            b", ",
          ),
          b")",
        ]),
    },
  ])

/// The calls a unit holds written against a handing other than the one their callee publishes:
/// refused, since a call lending what its callee takes as given, or the other way, counts a value
/// wrongly with no C type to show it.
fn handings_disagree(wrong: List<Misassumed>) -> Diag / {abort.raise} =
  error_with_labels(
    b"E0478",
    Bytes::concat_all([
      b"the emitter wrote ",
      ascii_of_int(wrong.len()),
      if wrong.len() == 1 { b" call against a handing its callee does not publish" }
      else { b" calls against handings their callees do not publish" },
    ]),
    [],
    wrong.map(|m: Misassumed|
      Bytes::concat_all([
        b"`",
        root_text(m.caller),
        b"` calls `",
        root_text(m.assumed.def),
        b"` written ",
        handing_said(m.assumed),
        b", where it publishes ",
        match m.published { Some(h) -> handing_said(h), None -> b"none, so takes every argument" },
      ])),
  )

/// The natives a unit calls that the runtime it is compiled against does not implement as they are
/// declared: refused before a C compiler meets a call that disagrees with the helper it names.
fn natives_refused(refused: List<Unbound>) -> Diag =
  error_with_labels(
    b"E0476",
    Bytes::concat_all([
      b"the runtime does not implement ",
      ascii_of_int(refused.len()),
      if refused.len() == 1 { b" native this program calls as it is declared" }
      else { b" natives this program calls as they are declared" },
    ]),
    [],
    refused.map(unbound_line).push(
      b"the runtime reports a native as the type of the function it binds says, and a call is written as the compiler that emitted it declares the native, so the two disagree where that compiler and the runtime are built from different sources, as a release's compiler and a newer runtime are",
    ),
  )

/// What the frame of `len` bytes at `offset` of the file `path` of the pack this binary carries
/// holds: `shipped.answer` as what reads the pack below a run's store.
pub fn pack_frame(path: String, offset: Int, len: Int) -> Option<Bytes> / {shipped.answer} =
  shipped.answer(path, offset, len)

/// The hash `definitions` holds for a definition of the compiler's, `name` as the compiler's own
/// program names it: a program that ships the compiler names it under `compiler.`.
pub fn definition_hash(definitions: Bytes, name: Bytes) -> Option<Bytes> / {abort.raise} = {
  let held = |full: Bytes| {
    let line = full.concat(b" ");
    let found = if definitions.starts_with(line) { Some(0) } else {
      match definitions.index_of(b"\n".concat(line)) { Some(i) -> Some(i + 1), None -> None }
    };
    match found {
      None -> None,
      Some(i) -> {
        let from = i + line.len();
        // A hash is sixty-four digits, so its line ends within this many bytes.
        let most = if from + 65 > definitions.len() { definitions.len() } else { from + 65 };
        let rest = definitions.slice(from, most);
        Some(rest.slice(0, match rest.index_of_byte(10) { Some(end) -> end, None -> rest.len() }))
      },
    }
  };
  match held(b"compiler.".concat(name)) { Some(h) -> Some(h), None -> held(name) }
}

/// What the answers `roots` compute are a function of on the program's side: each root's hash,
/// which covers all the root reaches and nothing else of the program. A root the program does not
/// hold was renamed without the list that names it.
pub fn identity_of(definitions: Bytes, roots: List<Bytes>) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all(
        roots.map(|root: Bytes|
          match definition_hash(definitions, root) {
            Some(h) -> Bytes::concat_all([root, b" ", h, b"\n"]),
            None ->
              panic(
                "this binary's program holds no definition `" ++ String::of_bytes_lossy(root)
                  ++ "`, which a kept answer is filed under",
              ),
          }),
      ),
    ),
  )

/// The definitions an emitter's answer is a function of besides the root it answers for: the one
/// that reads the program the emitter lowers from, the one that asks the emitter, and the one that
/// makes the front end's answer it is asked over.
pub fn emitter_roots() -> List<Bytes> =
  [b"unit.scope_over", b"unit.answers_in", b"front.seam.view_dump"]

pub fn emitter_identity(definitions: Bytes) -> Bytes / {abort.raise} =
  identity_of(definitions, emitter_roots())

/// The definitions a unit is a function of besides the program it is of: the emitter's, and the ones
/// that produce a unit over its answers and hold it to what was offered.
pub fn unit_roots() -> List<Bytes> = [b"unit.emitted", b"unit.held", b"front.seam.view_dump"]

/// The definitions a program's analysis and its unit are a function of besides its sources.
pub fn compiler_roots() -> List<Bytes> = unit_roots().push(b"front.analyse_pulling_std_with")

/// What a program a builder built is a function of besides its text: the definition it enters, whose
/// hash covers all that reaches and nothing else of the program, the runtime its unit is compiled
/// against, and the builder's own entry, whose hash covers all the builder runs.
pub fn program_key(entry: Bytes, runtime: Runtime, definitions: Bytes) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all([
        b"ply.program.1\0",
        entry,
        runtime.identity,
        b"\0",
        identity_of(definitions, [b"build.main"]),
      ]),
    ),
  )

/// Where a builder keeps each program it built under `program_key`, below the stages.
pub fn programs_kept() -> String = "programs"

fn kept_path(dir: String, key: Bytes) -> String / {abort.raise} =
  if dir == "" || dir == "." { String::of_bytes(key) } else { dir ++ "/" ++ String::of_bytes(key) }

/// A whole file kept between runs under `dir`, as a build keeps a program it built: a read is a use,
/// which keeps it from the toolchain's sweep, which takes such a file on its own.
pub fn file_kept<[r]>(
  dir: String,
  key: Bytes,
) -> Option<Bytes> / {fs.read[r], fs.write[r], time.now_ms, abort.raise} = {
  let path = kept_path(dir, key);
  match fs.read_file[r](path) {
    None -> None,
    Some(bytes) -> {
      fs.set_modified[r](path, time.now_ms());
      Some(bytes)
    },
  }
}

/// Written beside itself and renamed into place, so a reader finds a whole file or none. A file that
/// cannot be written is left unwritten.
pub fn keep_file<[r]>(
  dir: String,
  key: Bytes,
  bytes: Bytes,
) -> Unit / {fs.write[r], entropy.next, time.now_ms, abort.raise} = {
  let path = kept_path(dir, key);
  let nonce = blake3(u64_le(entropy.next()).concat(u64_le(time.now_ms()))).slice(0, 8);
  let temp = path ++ "." ++ nonce.hex_of() ++ ".tmp";
  if fs.create_dir[r](if dir == "" { "." } else { dir }) && fs.write_file[r](temp, bytes) {
    if !fs.rename[r](temp, path) {
      fs.remove[r](temp);
      ()
    }
  }
}

/// A root a unit is offered: its arity, whether it is pure and takes nothing, which the unit gives a
/// memo slot, and the root its failure sites name: its own name, or the definition it specialises,
/// whose text they count from.
pub type Offered = { name: RootName, arity: Int, constant: Bool, site: RootName }

/// A constructor of the unit's table and its arity. The runtime holds each argument of one it makes
/// as its word, which no body reads in place.
pub type Ctor = { name: Bytes, arity: Int }

/// A constructor whose type's module states what its values are compared and shown through, and the
/// function of each.
pub type Stated = { ctor: Bytes, key: Option<Bytes>, show: Option<Bytes>, numeric: List<Bytes> }

/// What the fixpoint dropped and why: the emitter refused it or a root it calls, or it calls
/// `missing`, which the unit does not take.
pub type Dropped = { function: RootName, construct: Bytes, missing: Option<RootName> }

/// What a unit's C was made of: its bodies, before the unit placed them, and its roots as they were
/// offered, which decide how the unit places each.
pub type Made = { bodies: List<UnitBody>, offered: List<Offered> }

/// A unit's C, the roots it takes, what it dropped, in the order it dropped them, and what it was
/// made of.
pub type Produced = { text: Bytes, taken: List<RootName>, dropped: List<Dropped>, made: Made }

/// A unit produced over answers an earlier run kept and answers the emitter gave now: how many of
/// the offered roots each covered, the natives the unit calls that the runtime does not implement as
/// they are declared, its calls written against a handing other than their callee's, and the scope
/// it walked under, for an ask of another unit of the same program to walk under.
pub type Emission = {
  produced: Produced,
  kept: Int,
  asked: Int,
  unbound: List<Unbound>,
  misassumed: List<Misassumed>,
  scope: Option<Result<emit::Scope, Bytes>>,
}

/// Each root's answer, a group's one body answering for every member.
pub fn answers_of(rows: List<RootAnswer>) -> Map<RootName, Answer> =
  rows.fold(Map::new(), |acc: Map<RootName, Answer>, r: RootAnswer|
    match r.answer {
      Body(b) -> if b.tables.members.len() == 0 { acc.insert(r.name, r.answer) } else {
        b.tables.members.fold(acc, |into: Map<RootName, Answer>, m: RootKey|
          into.insert(root_name(m), r.answer))
      },
      Refused(_) -> acc.insert(r.name, r.answer),
    })

// --- Order --------------------------------------------------------------------

/// Ascending by byte, each once.
fn ordered(xs: List<Bytes>) -> List<Bytes> =
  xs.fold(Map::new(), |acc: Map<Bytes, Bool>, x: Bytes| acc.insert(x, true)).keys()

/// Ascending, each once.
fn names_ordered(xs: List<RootName>) -> List<RootName> =
  xs.fold(Map::new(), |acc: Map<RootName, Bool>, x: RootName| acc.insert(x, true)).keys()

/// A shape's names joined by a byte below every name's, so shapes sort as their name lists do.
fn shape_key(names: List<Bytes>) -> Bytes / {abort.raise} =
  range(0, names.len()).fold(b"", |acc: Bytes, i: Int|
    if i == 0 { names.get(i) } else { Bytes::concat_all([acc, b"\x00", names.get(i)]) })

/// Where a shape sorts in the unit's table: after every shape it holds in place, which the runtime
/// interns before it, so a shape's position is the id interning the table in order gives it. A shape
/// held in place opens fewer parentheses than one holding it, and a count sorts as its digits' count
/// and then its digits.
fn shape_order(names: List<Bytes>) -> Bytes / {abort.raise} = {
  let opens = names.fold(0, |acc: Int, nm: Bytes|
    range(0, nm.len()).fold(acc, |n: Int, i: Int| if nm.at(i) == 40 { n + 1 } else { n }));
  let digits = ascii_of_int(opens);
  Bytes::concat_all([ascii_of_int(digits.len()), digits, b"\x00", shape_key(names)])
}

fn positions(keys: List<Bytes>) -> Map<Bytes, Int> / {abort.raise} =
  range(0, keys.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int| acc.insert(keys.get(i), i))

// --- The fixpoint ---------------------------------------------------------------

/// A body the unit holds once: a group's under its first member.
pub type UnitBody = { name: RootName, text: Bytes, tables: Tables }

type Round = { bodies: List<UnitBody>, symbols: Map<RootName, Defined>, out: List<Dropped> }

type Settled = {
  taken: List<RootName>,
  bodies: List<UnitBody>,
  symbols: Map<RootName, Defined>,
  dropped: List<Dropped>,
}

fn refused_one(name: RootName, why: Bytes) -> Dropped =
  { function: name, construct: why, missing: None }

fn lost(name: RootName, callee: RootName) -> Dropped =
  {
    function: name,
    construct: Bytes::concat_all([
      b"`",
      root_text(callee),
      b"`, which is not in this compiled unit",
    ]),
    missing: Some(callee),
  }

/// `name` dropped for calling `callee`, which the unit refused for `why`: no offer could have taken
/// the callee.
fn refused_call(name: RootName, callee: RootName, why: Bytes) -> Dropped =
  {
    function: name,
    construct: Bytes::concat_all([b"`", root_text(callee), b"`, refused: ", why]),
    missing: None,
  }

/// The C a body publishes for `name`: its place among the members, or the body's one definition.
fn defines(name: RootName, tables: Tables) -> Defined / {abort.raise} = {
  let found = range(0, tables.members.len()).fold(0 - 1, |acc: Int, i: Int|
    if acc < 0 && root_name(tables.members.get(i)) == name { i } else { acc });
  match tables.symbols.at(if found < 0 { 0 } else { found }) {
    Some(d) -> d,
    None ->
      panic(
        String::of_bytes_lossy(
          b"an emitted body publishes the C it defines, and `".concat(root_text(name)).concat(
            b"`'s publishes none",
          ),
        ),
      ),
  }
}

fn first_missing(calls: List<RootName>, taken: Map<RootName, Bool>) -> Option<RootName> =
  calls.fold(None, |acc: Option<RootName>, c: RootName|
    match acc { Some(_) -> acc, None -> if taken.contains(c) { None } else { Some(c) } })

/// Whether the body `name` is answered by is placed under `name`, of the roots `taken`: its own, or
/// a group's under the first of its members taken, which need not be the group's first.
fn heads_its_group(name: RootName, tables: Tables, taken: Map<RootName, Bool>) -> Bool =
  match tables.members.map(root_name).filter(|m: RootName| taken.contains(m)).at(0) {
    Some(first) -> first == name,
    None -> true,
  }

fn round_over(answers: Map<RootName, Answer>, taken: List<RootName>) -> Round / {abort.raise} = {
  let set = taken.fold(Map::new(), |acc: Map<RootName, Bool>, n: RootName| acc.insert(n, true));
  taken.fold({ bodies: [], symbols: Map::new(), out: [] }, |r: Round, name: RootName|
    match answers.get(name) {
      None -> { ..r, out: r.out.push(refused_one(name, b"which the Ply emitter did not answer")) },
      Some(Refused(why)) -> { ..r, out: r.out.push(refused_one(name, why.why)) },
      Some(Body(b)) -> match first_missing(b.tables.calls.map(root_name), set) {
        Some(callee) ->
          {
            ..r,
            out: r.out.push(match answers.get(callee) {
              Some(Refused(no)) -> refused_call(name, callee, no.why),
              _ -> lost(name, callee),
            }),
          },
        None ->
          {
            bodies: if heads_its_group(name, b.tables, set) {
              r.bodies.push({ name: name, text: b.text, tables: b.tables })
            } else { r.bodies },
            symbols: r.symbols.insert(name, defines(name, b.tables)),
            out: r.out,
          },
      },
    })
}

/// Dropping a body can drop its callers, so rounds repeat until one drops nothing; what a round
/// drops it took, so each round takes fewer, and the bodies taken bound the rounds.
fn settle(
  answers: Map<RootName, Answer>,
  taken: List<RootName>,
  dropped: List<Dropped>,
) -> Settled / {abort.raise} =
  iterate(
    { taken: taken, dropped: dropped },
    taken.len() + 1,
    |s: { taken: List<RootName>, dropped: List<Dropped> }| {
      let r = round_over(answers, s.taken);
      if r.out.len() == 0 {
        Stop({ taken: s.taken, bodies: r.bodies, symbols: r.symbols, dropped: s.dropped })
      } else {
        let gone = r.out.fold(Map::new(), |acc: Map<RootName, Bool>, d: Dropped|
          acc.insert(d.function, true));
        Continue({
          taken: s.taken.filter(|n: RootName| !gone.contains(n)),
          dropped: s.dropped.concat(r.out),
        })
      }
    },
  )

/// The dropped bodies that are errors, given what was `offered`. A body dropped because a callee was
/// never offered is the offer's doing, as is anything that lost a callee to such a body; every other
/// drop is a definition the program reaches and cannot run.
pub fn fatal(offered: List<RootName>, dropped: List<Dropped>) -> List<Dropped> / {abort.raise} = {
  let asked = offered.fold(Map::new(), |acc: Map<RootName, Bool>, n: RootName| acc.insert(n, true));
  let narrowed = iterate(Map::new(), dropped.len() + 1, |nar: Map<RootName, Bool>| {
    let grew = dropped.filter(|d: Dropped|
      !nar.contains(d.function)
        && (match d.missing { None -> false, Some(m) -> !asked.contains(m) || nar.contains(m) }));
    if grew.len() == 0 { Stop(nar) } else {
      Continue(grew.fold(nar, |acc: Map<RootName, Bool>, d: Dropped| acc.insert(d.function, true)))
    }
  });
  dropped.filter(|d: Dropped| !narrowed.contains(d.function))
}

/// Whether the runtime enters root `k` of `p`, so the unit takes its entry: a stored root, a test's
/// run or the listing of its cases, a law's guard and body where a lifting reads each of its
/// binders, a definition `emit.enterable` admits by its scheme, and that definition's clauses where
/// a lifting reads its answer too. A specialisation has none.
fn entered_root(p: Program, k: RootKey) -> Bool =
  match k {
    Stored(_) -> true,
    Test(_) -> true,
    Cases(_) -> true,
    // A law over a type variable is judged by a proof over its sort, never entered.
    Law(_) -> match p.binders.get(root_name(k)) {
      Some(tys) -> tys.all(|t: Type| emit::lifted(p.crossing, t)),
      None -> false,
    },
    Clause(c) ->
      entered_root(p, c.def)
        && (match c.def {
          Named(n) -> match p.schemes.get(n) {
            Some(sc) -> emit::judgeable(p.crossing, sc),
            None -> false,
          },
          _ -> false,
        }),
    // A generic one is entered where it is judged, at `Int`, only over variables no constraint
    // hands a witness for: those its specialisation reads.
    Named(n) -> match ((p.schemes.get(n), p.roots.get(root_name(k)))) {
      (Some(sc), Some(r)) ->
        emit::enterable(p.crossing, sc) && (sc.ty_vars.len() == 0 || r.witnesses.len() == 0),
      (Some(sc), None) -> emit::enterable(p.crossing, sc) && sc.ty_vars.len() == 0,
      _ -> false,
    },
    _ -> false,
  }

/// The roots a program's answer offers, in the order `Dump.emitter_roots` lists them, each keyed by
/// what the front end's typed rows say it is, never by reading its name; and the name of each the
/// rows key none of, which a unit refuses.
pub type Offers = { keys: List<RootKey>, unkeyed: List<Bytes> }

pub fn offered_roots(dump: Dump) -> Offers / {abort.raise} = {
  let keyed = rows_keyed(dump);
  dump.emitter_roots.fold({ keys: [], unkeyed: [] }, |acc: Offers, r: EmitterRoot|
    match keyed.get(r.root) {
      Some(k) -> { ..acc, keys: acc.keys.push(k) },
      None -> { ..acc, unkeyed: acc.unkeyed.push(r.root) },
    })
}

/// Each root `dump`'s typed rows say its program may offer, by the name its rows spell it with: a
/// definition and each `requires` and `ensures` clause it states, a test's run and the listing of
/// its cases, and a law's guard and body. A test over no cases and a law of no guard key a root no
/// answer offers. The one place a row the release reads meets a key.
fn rows_keyed(dump: Dump) -> Map<Bytes, RootKey> / {abort.raise} = {
  let keyed = |m: Map<Bytes, RootKey>, k: RootKey| m.insert(root_text(root_name(k)), k);
  let defined = dump.defs.fold(Map::new(), |m: Map<Bytes, RootKey>, d: DefRow|
    d.spec.fold(
      { m: keyed(m, Named(d.name)), requires: 0, ensures: 0 },
      |acc: { m: Map<Bytes, RootKey>, requires: Int, ensures: Int }, s: SpecRow|
        if s.kind == spec_kind_text(SRequires) {
          {
            ..acc,
            m: keyed(acc.m, Clause({ def: Named(d.name), kind: Requires, n: acc.requires })),
            requires: acc.requires + 1,
          }
        } else if s.kind == spec_kind_text(SEnsures) {
          {
            ..acc,
            m: keyed(acc.m, Clause({ def: Named(d.name), kind: Ensures, n: acc.ensures })),
            ensures: acc.ensures + 1,
          }
        } else { acc },
    ).m);
  let tested = dump.tests.fold(defined, |m: Map<Bytes, RootKey>, t: TestRow| {
    let run = test_key(t.module, t.name);
    keyed(keyed(m, run), Cases(run))
  });
  dump.laws.fold(tested, |m: Map<Bytes, RootKey>, l: LawRow|
    keyed(keyed(m, law_key(l.module, l.name, LawGuard)), law_key(l.module, l.name, LawBody)))
}

/// Why a unit refuses a root its program's answer offers that no typed row keys.
fn unkeyed_why(name: Bytes) -> Bytes =
  Bytes::concat_all([b"the front end offered `", name, b"` with no typed row to key it by"])

// --- The unit's tables ------------------------------------------------------------

/// What a unit names that is not code, each table sorted by content and each entry once, so a
/// position is a rank among what the unit holds and a body's C is a function of the unit's content.
type Pools = {
  fields: List<Bytes>,
  builtins: List<Bytes>,
  shapes: List<List<Bytes>>,
  lambdas: List<Bytes>,
}

fn entry_fields() -> List<Bytes> = [b"key", b"value"]

/// The tables of `bodies`, whose static objects are `statics`, the field table holding the names
/// those statics' words name beside the bodies' own.
fn pools_of(
  bodies: List<UnitBody>,
  statics: List<StaticDef>,
  constant_entries: List<Bytes>,
) -> Pools / {abort.raise} = {
  let ts = bodies.map(|k: UnitBody| k.tables);
  let all = |pick: (Tables) -> List<Bytes>|
    ts.fold([], |acc: List<Bytes>, tables: Tables| acc.concat(pick(tables)));
  let shapes = ts.fold(
    Map::new().insert(shape_order(entry_fields()), entry_fields()),
    |acc: Map<Bytes, List<Bytes>>, tables: Tables|
      tables.shapes.fold(acc, |into: Map<Bytes, List<Bytes>>, names: List<Bytes>| {
        let s = ordered(names);
        into.insert(shape_order(s), s)
      }),
  );
  {
    fields: ordered(
      all(|tables: Tables| tables.fields).concat(
        statics.fold([], |acc: List<Bytes>, d: StaticDef| acc.concat(static_fields(d))),
      ),
    ),
    builtins: ordered(all(|tables: Tables| tables.builtins)),
    shapes: shapes.values(),
    lambdas: ordered(constant_entries.concat(all(|tables: Tables| tables.lambdas))),
  }
}

/// Every static the unit's bodies name, each once and after those it addresses: in the order the
/// bodies list them, each body listing a static's children before it. Two statics of one name holding
/// different content stop the build, since a name is its content's digest.
fn statics_placed(bodies: List<UnitBody>) -> List<StaticDef> / {abort.raise} =
  bodies.fold(
    { out: [], seen: Map::new() },
    |acc: { out: List<StaticDef>, seen: Map<Bytes, StaticDef> }, k: UnitBody|
      k.tables.statics.fold(
        acc,
        |a: { out: List<StaticDef>, seen: Map<Bytes, StaticDef> }, d: StaticDef|
          match a.seen.get(d.name) {
            Some(e) -> if e == d { a } else {
              panic(
                String::of_bytes_lossy(
                  b"two statics of one name hold different content: ".concat(d.name),
                ),
              )
            },
            None -> { out: a.out.push(d), seen: a.seen.insert(d.name, d) },
          },
      ),
  ).out

/// The field-table names a static's words name.
fn static_fields(d: StaticDef) -> List<Bytes> =
  words_of(d).fold([], |acc: List<Bytes>, w: StaticWord|
    match w { WField(n) -> acc.push(n), _ -> acc })

type Placed = {
  fields: Map<Bytes, Int>,
  builtins: Map<Bytes, Int>,
  shapes: Map<Bytes, Int>,
  lambdas: Map<Bytes, Int>,
}

fn placed_of(p: Pools) -> Placed / {abort.raise} =
  {
    fields: positions(p.fields),
    builtins: positions(p.builtins),
    shapes: positions(p.shapes.map(shape_key)),
    lambdas: positions(p.lambdas),
  }

fn place(m: Map<Bytes, Int>, key: Bytes) -> Int / {abort.raise} =
  match m.get(key) {
    Some(i) -> i,
    None -> panic("the unit's tables hold everything its bodies name"),
  }

// --- Sites ----------------------------------------------------------------------

/// The bucket a body compiles in: the top bits of its root id, so it is a function of the name
/// alone and an edit recompiles the one bucket holding the body.
fn bucket_of(name: RootName) -> Int = root_id(root_text(name)) >>> 57

fn bucket_mark(id: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([b"/* --- bucket ", hex_digit(id / 16), hex_digit(id % 16), b" --- */"])

/// A placeholder in a body's C, `@@kN@@`: where it opens and closes, its kind byte, and what
/// follows the kind.
type Hole = { open: Int, close: Int, kind: Int, digits: Bytes }

fn holes(text: Bytes) -> List<Hole> / {abort.raise} =
  iterate({ from: 0, out: [] }, text.len() + 1, |s: { from: Int, out: List<Hole> }|
    match text.index_of_from(b"@@", s.from) {
      None -> Stop(s.out),
      Some(open) -> match text.index_of_from(b"@@", open + 2) {
        None -> panic("an emitted placeholder always closes"),
        Some(close) ->
          Continue({
            from: close + 2,
            out: s.out.push({
              open: open,
              close: close,
              kind: text.at(open + 2),
              digits: text.slice(open + 3, close),
            }),
          }),
      },
    })

/// What a placeholder names in the unit's tables, its kind leading so a bucket's table sorts by
/// kind; `None` for a root, written as its id.
fn hole_key(h: Hole, tables: Tables) -> Option<Bytes> / {abort.raise} =
  if h.kind == 84 { Some(b"T".concat(h.digits)) }
  else if h.kind == 114 { None } else {
    let i = digits(h.digits);
    if h.kind == 98 { Some(b"b".concat(tables.builtins.get(i))) }
    else if h.kind == 102 { Some(b"f".concat(tables.fields.get(i))) }
    else if h.kind == 115 { Some(b"s".concat(shape_key(ordered(tables.shapes.get(i))))) }
    else if h.kind == 108 { Some(b"l".concat(tables.lambdas.get(i))) }
    else { panic("an emitted placeholder of no kind the unit resolves") }
  }

/// A key's position in the unit's table of its kind, which is what the loader writes for it.
fn unit_place(key: Bytes, p: Placed, tags: Map<Bytes, Int>) -> Int / {abort.raise} = {
  let kind = key.at(0);
  let rest = key.slice(1, key.len());
  if kind == 84 { place(tags, rest) }
  else if kind == 98 { place(p.builtins, rest) }
  else if kind == 102 { place(p.fields, rest) }
  else if kind == 115 { place(p.shapes, rest) }
  else { place(p.lambdas, rest) }
}

/// The table a bucket's C reads the unit's positions from, which the loader fills.
fn bucket_table(id: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([b"ply_bk_", hex_digit(id / 16), hex_digit(id % 16)])

/// A body's C with each placeholder written as its bucket names it: a root as its id, and the rest
/// as a position in the bucket's own table, so the C reads the same whatever else the unit holds.
fn resolved(
  text: Bytes,
  hs: List<Hole>,
  keys: List<Option<Bytes>>,
  tables: Tables,
  site: RootName,
  table: Bytes,
  local: Map<Bytes, Int>,
) -> Bytes / {abort.raise} = {
  let walked = range(0, hs.len()).fold(
    { from: 0, out: [] },
    |s: { from: Int, out: List<Bytes> }, i: Int| {
      let h = hs.get(i);
      let value = match keys.get(i) {
        None ->
          ascii_of_int(
            root_id(
              root_text(if h.digits.len() == 0 { site }
              else { root_name(tables.members.get(digits(h.digits))) }),
            ),
          ),
        Some(k) -> Bytes::concat_all([table, b"[", ascii_of_int(place(local, k)), b"]"]),
      };
      { from: h.close + 2, out: s.out.push(text.slice(s.from, h.open)).push(value) }
    },
  );
  Bytes::concat_all(walked.out.push(text.slice(walked.from, text.len())))
}

// --- What the unit says about itself ---------------------------------------------

type Taken = { name: RootName, arity: Int, symbol: Bytes, entry: Bytes, head: Head }

fn counted(label: Bytes, n: Int) -> Bytes = Bytes::concat_all([label, b" ", ascii_of_int(n), b"\n"])

fn lines(label: Bytes, xs: List<Bytes>) -> Bytes =
  Bytes::concat_all([counted(label, xs.len())].concat(xs.map(|x: Bytes| x.concat(b"\n"))))

/// A bucket's table: the unit's position for each of the bucket's keys.
type BucketRow = { id: Int, places: List<Int> }

/// What a unit says about itself for its loader to read: the helpers it binds, its constructors,
/// each constant with its row of the code table, the pools its positions index, and each root the
/// runtime enters through its entry, `R#entered`, which it takes. What the loader takes by address,
/// `laid` lays out instead.
fn exports_text(
  helpers: List<Helper>,
  ctors: List<Ctor>,
  taken: List<Taken>,
  constants: List<Bytes>,
  modules: Int,
  dropped: List<Dropped>,
  p: Pools,
  stated: List<Stated>,
  entered: List<RootName>,
) -> Bytes / {abort.raise} = {
  let held = taken.fold(Map::new(), |acc: Map<RootName, Bool>, t: Taken| acc.insert(t.name, true));
  // `-` where the type states none, and `!` for a function the unit does not take, which a value
  // read through it there is refused by.
  let written = |f: Option<Bytes>|
    match f {
      None -> b"-",
      Some(name) -> if held.contains(root_name(Named(name))) { name } else { b"!" },
    };
  Bytes::concat_all([
    lines(
      b"helpers",
      helpers.map(|h: Helper|
        Bytes::concat_all([h.name, b" ", ascii_of_int(h.args), b" ", dump_flag(h.answers)])),
    ),
    lines(b"ctors", ctors.map(|c: Ctor| Bytes::concat_all([c.name, b" ", ascii_of_int(c.arity)]))),
    lines(b"constants", constants),
    counted(b"modules", modules),
    counted(b"refused", dropped.len()),
    Bytes::concat_all(
      dropped.map(|d: Dropped|
        Bytes::concat_all([root_text(d.function), b"\n", d.construct, b"\n"])),
    ),
    lines(b"builtins", p.builtins),
    lines(b"fields", p.fields),
    lines(
      b"shapes",
      p.shapes.map(|names: List<Bytes>|
        range(0, names.len()).fold(b"", |acc: Bytes, i: Int|
          if i == 0 { names.get(i) } else { Bytes::concat_all([acc, b" ", names.get(i)]) })),
    ),
    // Only a unit one of whose types states either says so, so any other reads as it always did.
    if stated.len() == 0 { b"" } else {
      lines(
        b"instances",
        stated.map(|x: Stated|
          x.numeric.fold(
            Bytes::concat_all([x.ctor, b" ", written(x.key), b" ", written(x.show)]),
            |row: Bytes, f: Bytes| Bytes::concat_all([row, b" ", written(Some(f))]),
          )),
      )
    },
    // The runtime lays an `Int`, a `Decimal`, a bytes slice and an `Option` out as this unit's C
    // reads them: `RAW_INTS`, `RAW_DECIMALS`, `BYTES_VIEWS` and `OPTION_WORDS` in `exports.rs`.
    b"ints held raw\n",
    b"decimals held raw\n",
    b"bytes slices are views\n",
    b"options held as their payload's word\n",
    // The release's runtime reads these lines as nothing.
    Bytes::concat_all(
      entered.map(|r: RootName| Bytes::concat_all([b"entered ", root_text(r), b"\n"])),
    ),
  ])
}

/// `line` and the newline ending it as adjacent C string literals, the newline's last.
fn literal_lines(line: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([c_string(line), b" \"\\n\"\n"])

/// The text's lines as `str::lines` reads them: a final newline ends the last line rather than
/// opening another, and a carriage return before a newline is part of the ending.
fn split_lines(text: Bytes) -> List<Bytes> / {abort.raise} = {
  let parts = text.split(b"\n");
  let whole = if parts.len() > 0 && parts.get(parts.len() - 1).len() == 0 {
    parts.take(parts.len() - 1)
  } else { parts };
  whole.map(|l: Bytes|
    if l.len() > 0 && l.at(l.len() - 1) == 13 { l.slice(0, l.len() - 1) } else { l })
}

/// The table as C string literals, non-printable bytes and `?` in octal.
fn embedded(exports: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\n/* --- what this unit says about itself, read by the loader --- */\n",
    b"const char ply_exports[] =\n",
    Bytes::concat_all(split_lines(exports).map(literal_lines)),
    b";\n",
  ])

/// What the loader takes by address, so it looks no symbol up and fills no table: each bucket's
/// table holding the unit's positions, the code table in the unit's order, each of `taken` by name
/// in byte order with its entry and how many words it takes, and `ply_descriptor`, which holds
/// those beside what the unit says about itself and its two binders. A native program's `main`
/// hands the runtime the descriptor, so the program exports nothing for `dlsym` to find. The code
/// and the entries are defined in the buckets' objects, and a table closes with a zero so that none
/// is empty.
fn laid(
  taken: List<Taken>,
  lambdas: List<Bytes>,
  buckets: List<BucketRow>,
) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\n/* --- what the loader takes by address --- */\n",
    Bytes::concat_all(
      buckets.map(|r: BucketRow|
        Bytes::concat_all([
          b"const uint32_t ",
          bucket_table(r.id),
          b"[] = {",
          Bytes::concat_all(
            r.places.map(|n: Int| Bytes::concat_all([b" ", ascii_of_int(n), b","])),
          ),
          b" };\n",
        ])),
    ),
    Bytes::concat_all(
      ordered(lambdas.concat(taken.map(|t: Taken| t.entry))).map(|n: Bytes|
        Bytes::concat_all([b"extern char ", n, b";\n"])),
    ),
    b"void *const ply_code[] = {\n",
    Bytes::concat_all(lambdas.map(|n: Bytes| Bytes::concat_all([b"  (void *)&", n, b",\n"]))),
    b"  0 };\n",
    b"struct ply_taken { const char *name; void *entry; unsigned long arity; };\n",
    b"const struct ply_taken ply_taken[] = {\n",
    Bytes::concat_all(
      taken.map(|t: Taken|
        Bytes::concat_all([
          b"  { \"",
          escaped(root_text(t.name)),
          b"\", (void *)&",
          t.entry,
          b", ",
          ascii_of_int(t.arity),
          b" },\n",
        ])),
    ),
    b"  { 0, 0, 0 } };\n",
    b"struct ply_descriptor { const char *exports; unsigned long exports_len; void *bind; void *bind_singletons; void *const *code; unsigned long code_count; const struct ply_taken *taken; unsigned long taken_count; };\n",
    b"const struct ply_descriptor ply_descriptor = { ply_exports, sizeof ply_exports - 1, (void *)ply_bind, (void *)ply_bind_singletons, ply_code, ",
    ascii_of_int(lambdas.len()),
    b", ply_taken, ",
    ascii_of_int(taken.len()),
    b" };\n",
  ])

// --- Placing it -----------------------------------------------------------------

type Placing = {
  name: RootName,
  bucket: Int,
  text: Bytes,
  reaches: List<RootName>,
  /// The definitions its C defines: a group's members, or its own.
  defines: List<RootName>,
  /// The static objects its C names, which the unit's tail defines.
  statics: List<Bytes>,
}

/// A body's placeholders and what each names, which its bucket's table is made of.
type Marked = { body: UnitBody, holes: List<Hole>, keys: List<Option<Bytes>> }

/// What a body's C names of the unit's definitions: its own, a group's every member, and its calls.
fn reaches_of(name: RootName, tables: Tables) -> List<RootName> =
  names_ordered(
    tables.calls.map(root_name).concat(if tables.members.len() == 0 { [name] }
    else { tables.members.map(root_name) }),
  )

fn prototype(symbol: Bytes, head: Head) -> Bytes =
  Bytes::concat_all([
    head.answer,
    b" ",
    symbol,
    b"(PlyCtx*",
    Bytes::concat_all(head.params.map(|t: Bytes| b", ".concat(t))),
    b");\n",
  ])

fn far_table(id: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([b"ply_far_", hex_digit(id / 16), hex_digit(id % 16)])

/// Where the head defines `PLY_FAR`, each of `reached`, a bucket's calls into other buckets, is
/// called through `table`, an address apiece: a load and a call of what it loads, which reaches
/// anywhere, where a call of the function's name reaches only so far.
fn far_calls(table: Bytes, reached: List<Taken>) -> Bytes / {abort.raise} =
  if reached.len() == 0 { b"" } else {
    Bytes::concat_all([
      b"#ifdef PLY_FAR\nstatic void *const ",
      table,
      b"[] = {",
      Bytes::concat_all(reached.map(|t: Taken| Bytes::concat_all([b" (void *)&", t.symbol, b","]))),
      b" 0 };\n",
      Bytes::concat_all(
        range(0, reached.len()).map(|i: Int| {
          let t = reached.get(i);
          Bytes::concat_all([
            b"#define ",
            t.symbol,
            b"(...) ((",
            t.head.answer,
            b" (*)(PlyCtx*",
            Bytes::concat_all(t.head.params.map(|p: Bytes| b", ".concat(p))),
            b"))",
            table,
            b"[",
            ascii_of_int(i),
            b"])(__VA_ARGS__)\n",
          ])
        }),
      ),
      b"#endif\n",
    ])
  }

/// The end of what [`far_calls`] defines, so the bucket after this one reads its names as written.
fn far_ended(reached: List<Taken>) -> Bytes =
  if reached.len() == 0 { b"" } else {
    Bytes::concat_all([
      b"#ifdef PLY_FAR\n",
      Bytes::concat_all(reached.map(|t: Taken| Bytes::concat_all([b"#undef ", t.symbol, b"\n"]))),
      b"#endif\n",
    ])
  }

fn bucket_key(p: Placing) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    hex_digit(p.bucket / 16),
    hex_digit(p.bucket % 16),
    b"\x00",
    root_text(p.name),
  ])

/// The runtime's head and the emitter's part of it, which every part compiles after, then a marked
/// bucket per class of names, which declares its table, the static objects its bodies name and the
/// prototypes of what they reach, then the runtime's definitions, `statics`, the static objects'
/// definitions, what the unit says about itself and `tables`, what it lays out for its loader: one
/// translation unit that the loader also compiles in parts, cut on the marks. A bucket declares its
/// table and its statics and never defines them, so its C reads the same whatever the unit holds
/// beside it, and calls what another defines as [`far_calls`] says.
fn assembled(
  runtime: Runtime,
  bodies: List<Placing>,
  sizes: Map<Int, Int>,
  taken: Map<RootName, Taken>,
  statics: Bytes,
  exports: Bytes,
  tables: Bytes,
) -> Bytes / {abort.raise} = {
  let by_bucket = bodies.fold(Map::new(), |acc: Map<Bytes, Placing>, p: Placing|
    acc.insert(bucket_key(p), p));
  let groups = by_bucket.values().fold([], |acc: List<List<Placing>>, p: Placing| {
    let last = acc.len() - 1;
    if last >= 0 && acc.get(last).get(0).bucket == p.bucket { acc.set(last, acc.get(last).push(p)) }
    else { acc.push([p]) }
  });
  let reached_by = |group: List<Placing>| {
    let here = group.fold(Map::new(), |acc: Map<RootName, Bool>, p: Placing|
      p.defines.fold(acc, |a: Map<RootName, Bool>, n: RootName| a.insert(n, true)));
    names_ordered(group.fold([], |acc: List<RootName>, p: Placing| acc.concat(p.reaches))).fold(
      [],
      |acc: List<Taken>, name: RootName|
        if here.contains(name) { acc }
        else { match taken.get(name) { Some(t) -> acc.push(t), None -> acc } },
    )
  };
  Bytes::concat_all([
    runtime.head,
    head_part(),
    Bytes::concat_all(
      groups.map(|group: List<Placing>| {
        let reached = reached_by(group);
        Bytes::concat_all([
          bucket_mark(group.get(0).bucket),
          b"\n",
          match sizes.get(group.get(0).bucket) {
            Some(n) -> if n == 0 { b"" } else {
              Bytes::concat_all([
                b"extern const uint32_t ",
                bucket_table(group.get(0).bucket),
                b"[];\n",
              ])
            },
            None -> b"",
          },
          Bytes::concat_all(
            ordered(group.fold([], |acc: List<Bytes>, p: Placing| acc.concat(p.statics))).map(
              static_extern,
            ),
          ),
          Bytes::concat_all(
            names_ordered(
              group.fold([], |acc: List<RootName>, p: Placing| acc.concat(p.reaches)),
            ).map(|name: RootName|
              match taken.get(name) { Some(t) -> prototype(t.symbol, t.head), None -> b"" }),
          ),
          far_calls(far_table(group.get(0).bucket), reached),
          b"\n",
          Bytes::concat_all(group.map(|p: Placing| p.text.concat(b"\n"))),
          far_ended(reached),
        ])
      }),
    ),
    runtime.tail,
    statics,
    embedded(exports),
    tables,
  ])
}

/// The unit over `offered`, from each root's answer: closed under calls, its tables sorted by
/// content, its bodies resolved against them and bucketed, and what it holds embedded in its C.
/// `modules` is how many modules the program it was emitted from has, and `inputs` the bytes of
/// each file it embeds, by digest.
pub fn produce(
  runtime: Runtime,
  ctors: List<Ctor>,
  offered: List<Offered>,
  modules: Int,
  answers: Map<RootName, Answer>,
  inputs: Map<Bytes, Bytes>,
  stated: List<Stated> = [],
) -> Produced / {abort.raise} = {
  let arity = offered.fold(Map::new(), |acc: Map<RootName, Offered>, o: Offered|
    acc.insert(o.name, o));
  let s = settle(answers, names_ordered(offered.map(|o: Offered| o.name)), []);
  let published = |n: RootName|
    match s.symbols.get(n) {
      Some(d) -> d,
      None -> panic("every definition a unit takes emitted, and an emitted body publishes its C"),
    };
  let constants = s.taken.filter(|n: RootName|
    match arity.get(n) { Some(o) -> o.constant, None -> false });
  let statics = statics_placed(s.bodies);
  let pools = pools_of(s.bodies, statics, constants.map(|n: RootName| published(n).entry));
  let placed = placed_of(pools);
  let laid_statics = Bytes::concat_all(
    statics.map(|d: StaticDef|
      static_c(
        d,
        |f: Bytes| place(placed.fields, f),
        |k: RootKey| symbol_of(root_text(root_name(k))),
        |digest: Bytes|
          match inputs.get(digest) {
            Some(b) -> b,
            None ->
              panic(
                "a unit holds an embedded file it was not handed the bytes of, which its driver reads for every embed it emits",
              ),
          },
      )),
  );
  let tags = positions(ctors.map(|c: Ctor| c.name));
  let taken = s.taken.map(|n: RootName| {
    let d = published(n);
    {
      name: n,
      arity: match arity.get(n) { Some(o) -> o.arity, None -> 0 },
      symbol: d.symbol,
      entry: d.entry,
      head: d.head,
    }
  });
  // Each call was written to the head its caller read; the callee's own must be that head.
  s.bodies.fold((), |_u: Unit, k: UnitBody|
    k.tables.generics.expects.fold((), |_v: Unit, e: Expect|
      match expected_callee(k.tables, e) {
        None -> (),
        Some(callee) -> match s.symbols.get(callee) {
          Some(d) -> if d.head != e.head {
            panic(
              String::of_bytes_lossy(
                Bytes::concat_all([
                  b"`",
                  root_text(k.name),
                  b"` calls `",
                  root_text(callee),
                  b"` as ",
                  prototype(d.symbol, e.head),
                  b"which it defines as ",
                  prototype(d.symbol, d.head),
                ]),
              ),
            )
          } else { () },
          None -> (),
        },
      }));
  let marked = s.bodies.map(|k: UnitBody| {
    let hs = holes(k.text);
    { body: k, holes: hs, keys: hs.map(|h: Hole| hole_key(h, k.tables)) }
  });
  // Each bucket's table: every key its bodies' placeholders name, once, in byte order.
  let keyed = marked.fold(Map::new(), |acc: Map<Int, Map<Bytes, Bool>>, m: Marked| {
    let b = bucket_of(m.body.name);
    acc.insert(
      b,
      m.keys.fold(
        match acc.get(b) { Some(x) -> x, None -> Map::new() },
        |ks: Map<Bytes, Bool>, k: Option<Bytes>|
          match k { Some(key) -> ks.insert(key, true), None -> ks },
      ),
    )
  });
  let locals = keyed.fold(
    Map::new(),
    |acc: Map<Int, Map<Bytes, Int>>, b: Int, ks: Map<Bytes, Bool>|
      acc.insert(b, positions(ks.keys())),
  );
  let bodies = marked.map(|m: Marked| {
    let b = bucket_of(m.body.name);
    {
      name: m.body.name,
      bucket: b,
      text: resolved(
        m.body.text,
        m.holes,
        m.keys,
        m.body.tables,
        match arity.get(m.body.name) {
          Some(o) -> o.site,
          None -> panic("every body a unit takes was offered it"),
        },
        bucket_table(b),
        match locals.get(b) { Some(l) -> l, None -> Map::new() },
      ),
      reaches: reaches_of(m.body.name, m.body.tables),
      defines: answered(m.body),
      statics: m.body.tables.statics.map(|d: StaticDef| d.name),
    }
  });
  let rows = keyed.fold([], |acc: List<BucketRow>, b: Int, ks: Map<Bytes, Bool>|
    if ks.len() == 0 { acc }
    else { acc.push({ id: b, places: ks.keys().map(|k: Bytes| unit_place(k, placed, tags)) }) });
  let took = s.taken.fold(Map::new(), |acc: Map<RootName, Bool>, n: RootName| acc.insert(n, true));
  let exports = exports_text(
    runtime.helpers,
    ctors,
    taken,
    constants.map(|n: RootName|
      Bytes::concat_all([
        root_text(n),
        b" ",
        ascii_of_int(place(placed.lambdas, published(n).entry)),
      ])),
    modules,
    s.dropped,
    pools,
    stated,
    offered.filter(|o: Offered| took.contains(entry_name(o.name))).map(|o: Offered| o.name),
  );
  let by_name = taken.fold(Map::new(), |acc: Map<RootName, Taken>, t: Taken| acc.insert(t.name, t));
  {
    text: assembled(
      runtime,
      bodies,
      keyed.fold(Map::new(), |acc: Map<Int, Int>, b: Int, ks: Map<Bytes, Bool>|
        acc.insert(b, ks.len())),
      by_name,
      laid_statics,
      exports,
      laid(by_name.values(), pools.lambdas, rows),
    ),
    taken: s.taken,
    dropped: s.dropped,
    made: { bodies: s.bodies, offered: offered },
  }
}

// --- What a root runs ----------------------------------------------------------

/// The names a body answers for: a group's members, or its own.
fn answered(body: UnitBody) -> List<RootName> =
  if body.tables.members.len() == 0 { [body.name] } else { body.tables.members.map(root_name) }

/// How a body's roots were offered, which places them: a constant is held rather than called.
fn offered_as(roots: Map<RootName, Offered>, body: UnitBody) -> Bytes =
  Bytes::concat_all(
    answered(body).map(|name: RootName|
      match roots.get(name) {
        Some(o) ->
          Bytes::concat_all([
            root_text(name),
            b" ",
            ascii_of_int(o.arity),
            if o.constant { b" constant\n" } else { b"\n" },
          ]),
        None -> root_text(name).concat(b" unoffered\n"),
      }),
  )

/// What each root of a unit runs, as one digest: its own body and every body it can call, whatever
/// the calls' cycles. A body is digested as the unit keeps it, before placing, so a root that two
/// compilers or two units made into the same code is named alike by both.
pub fn codes(made: Made) -> Map<RootName, Bytes> / {abort.raise} = {
  let bodies = made.bodies;
  let n = bodies.len();
  let index = range(0, n).fold(Map::new(), |acc: Map<RootName, Int>, i: Int|
    answered(bodies.get(i)).fold(acc, |m: Map<RootName, Int>, name: RootName| m.insert(name, i)));
  let roots = made.offered.fold(Map::new(), |acc: Map<RootName, Offered>, o: Offered|
    acc.insert(o.name, o));
  let own = bodies.map(|b: UnitBody|
    blake3(
      Bytes::concat_all([
        blake3(root_text(b.name)),
        blake3(b.text),
        blake3(bin::encode(b.tables, tables_bin())),
        blake3(offered_as(roots, b)),
      ]),
    ));
  let adj = bodies.map(|b: UnitBody|
    b.tables.calls.fold([], |acc: List<Int>, c: RootKey|
      match index.get(root_name(c)) { Some(j) -> acc.push(j), None -> acc }));
  // Components come callees first, so each folds in the digests of those it reaches.
  let components = graph::components({ out: adj });
  let reached = components.fold(Map::new(), |done: Map<Int, Bytes>, comp: List<Int>| {
    let inside = comp.fold(Map::new(), |m: Map<Int, Bool>, i: Int| m.insert(i, true));
    let below = comp.fold([], |acc: List<Bytes>, i: Int|
      adj.get(i).fold(acc, |a: List<Bytes>, j: Int|
        if inside.contains(j) { a }
        else { match done.get(j) { Some(d) -> a.push(d), None -> a } }));
    let digest = blake3(
      Bytes::concat_all(ordered(comp.map(|i: Int| own.get(i))).concat(ordered(below))),
    );
    comp.fold(done, |m: Map<Int, Bytes>, i: Int| m.insert(i, digest))
  });
  range(0, n).fold(Map::new(), |acc: Map<RootName, Bytes>, i: Int| {
    let code = blake3(own.get(i).concat(match reached.get(i) { Some(d) -> d, None -> b"" }));
    answered(bodies.get(i)).fold(acc, |m: Map<RootName, Bytes>, name: RootName|
      m.insert(name, code))
  })
}

// --- Emitting what no earlier run kept --------------------------------------------

/// What the front end's answer says the emitter works over: each root, the modules in program order,
/// and what each module imports.
type Program = {
  roots: Map<RootName, EmitterRoot>,
  keys: Map<RootName, Bytes>,
  modules: List<ModuleRow>,
  imports: Map<Bytes, List<Bytes>>,
  sources: List<Bytes>,
  /// A digest of what each module embeds, by its index: the emitter writes each call out as its bytes.
  embeds: Map<Int, Bytes>,
  /// Each definition's scheme, as the emitter types it.
  schemes: Map<Bytes, Scheme>,
  /// The types of each law's binders, by its guard's and its body's root.
  binders: Map<RootName, List<Type>>,
  crossing: CrossedSums,
  /// Each declared type's hash, which covers all it reaches, by its name: another program may
  /// declare another type under the same name.
  declared: Map<Bytes, Bytes>,
}

fn program_of(dump: Dump, sources: List<Bytes>) -> Program / {abort.raise} = {
  let keyed = rows_keyed(dump);
  let named = |row: Bytes| match keyed.get(row) { Some(k) -> Some(root_name(k)), None -> None };
  let by_name = dump.modules.fold(Map::new(), |acc: Map<Bytes, ModuleRow>, m: ModuleRow|
    acc.insert(m.name, m));
  let reads = dump.embeds.fold(Map::new(), |acc: Map<Int, List<Bytes>>, e: EmbedAt|
    match by_name.get(e.module) {
      None -> acc,
      Some(m) ->
        acc.insert(
          m.index,
          List::push(
            match acc.get(m.index) { Some(xs) -> xs, None -> [] },
            sized(e.key).concat(read_key(e.read)),
          ),
        ),
    });
  let schemes = dump.rows.defs.fold(Map::new(), |acc: Map<Bytes, Scheme>, row: KnownDefRow|
    acc.insert(row.name, row.scheme));
  let prelude = prelude_module().concat(b".");
  {
    roots: dump.emitter_roots.fold(
      Map::new(),
      |acc: Map<RootName, EmitterRoot>, root: EmitterRoot|
        match named(root.root) { Some(n) -> acc.insert(n, root), None -> acc },
    ),
    keys: dump.keys.fold(Map::new(), |acc: Map<RootName, Bytes>, k: KeyRow|
      match named(k.root) { Some(n) -> acc.insert(n, k.key), None -> acc }),
    // The emitter walks modules in the front end's ordinal order, so this order is not ours to pick.
    modules: dump.ordinals.fold([], |acc: List<ModuleRow>, o: OrdinalRow|
      match by_name.get(o.module) { Some(m) -> acc.push(m), None -> acc }),
    imports: by_name.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, n: Bytes, m: ModuleRow|
      acc.insert(n, m.imports)),
    sources: sources,
    embeds: reads.fold(Map::new(), |acc: Map<Int, Bytes>, i: Int, parts: List<Bytes>|
      acc.insert(i, blake3(Bytes::concat_all(ordered(parts))))),
    schemes: schemes,
    binders: dump.laws.fold(Map::new(), |acc: Map<RootName, List<Type>>, l: LawRow| {
      let tys = l.binders.map(|b: BinderRow| b.ty);
      [LawGuard, LawBody].fold(acc, |m: Map<RootName, List<Type>>, part: LawPart|
        m.insert(root_name(law_key(l.module, l.name, part)), tys))
    }),
    crossing: sums_crossed(ctor_sums(dump.ctors), |n: Bytes| schemes.contains(prelude.concat(n))),
    declared: {
      let types = dump.types.fold(Map::new(), |acc: Map<Bytes, Bool>, t: TypeRow|
        acc.insert(t.name, true));
      dump.hashes.fold(Map::new(), |acc: Map<Bytes, Bytes>, f: HashFrame|
        match f {
          HDef(row) -> match row.decl {
            Some(h) -> if types.contains(row.name) { acc.insert(row.name, h) } else { acc },
            None -> acc,
          },
          _ -> acc,
        })
    },
  }
}

fn text_at(program: Program, index: Int) -> Option<Bytes> = program.sources.at(index)

/// What a kept answer is a function of beyond the emitter and the runtime: the root's name, the key
/// the front end gave it, the text it is written in, since its sites are offsets into that text, and
/// what its module embeds, which that text's calls are written out as; for a specialisation, the
/// kinds it is at, the declarations of the types it is at, and the definitions whose lambdas it
/// runs; for a root written from a type, its
/// module's text and the program's `types`, which together say how it is written. `None` for a root
/// with no key or no place, which is asked again every time.
fn root_material(program: Program, types: Bytes, k: RootKey) -> Option<Bytes> / {abort.raise} = {
  let name = root_text(root_name(k));
  match k {
    Written(_, _) -> {
      let home = module_of(k);
      match program.modules.fold(None, |acc: Option<Int>, m: ModuleRow|
          if m.name == home { Some(m.index) } else { acc }) {
        None -> None,
        Some(i) -> match text_at(program, i) {
          None -> None,
          Some(text) -> Some(Bytes::concat_all([name, b"\x00", types, b"\x00", blake3(text)])),
        },
      }
    },
    At(a, _) ->
      a.lent.fold(
        match definition_material(program, root_name(Named(a.def))) {
          Some(m) -> Some(Bytes::concat_all([m, b"\x00", name, declarations_named(program, k)])),
          None -> None,
        },
        |acc: Option<Bytes>, f: FnArg|
          match acc {
            None -> None,
            Some(m) -> match definition_material(program, sited_as(f.owner)) {
              Some(o) -> Some(Bytes::concat_all([m, b"\x00", o])),
              None -> None,
            },
          },
      ),
    // An entry, and a stored root, is written from what its definition takes and answers.
    Entered(e) -> match definition_material(
        program,
        root_name(match e { Stored(s) -> s, _ -> e }),
      ) {
      Some(m) -> Some(Bytes::concat_all([m, b"\x00", name])),
      None -> None,
    },
    Stored(s) -> match definition_material(program, root_name(s)) {
      Some(m) -> Some(Bytes::concat_all([m, b"\x00", name])),
      None -> None,
    },
    _ -> definition_material(program, root_name(k)),
  }
}

/// What a root written from a type reads of the program beyond its module: each constructor, the
/// type it makes of its arguments' types, and what each type states.
fn types_material(dump: Dump) -> Bytes / {abort.raise} =
  blake3(
    Bytes::concat_all(
      dump.ctors.map(|c: CtorRow|
        Bytes::concat_all([
          c.name,
          b"\x00",
          ascii_of_int(c.index),
          b"\x00",
          type_text(c.scheme.ty),
          b"\x01",
        ])).concat(
        dump.emitter_ctors.map(|c: EmitterCtor|
          Bytes::concat_all([
            c.name,
            b"\x00",
            match c.key { Some(k) -> k, None -> b"" },
            b"\x00",
            match c.show { Some(s) -> s, None -> b"" },
            b"\x00",
            Bytes::concat_all(c.numeric.map(|f: Bytes| f.concat(b","))),
            b"\x01",
          ])),
      ),
    ),
  )

/// The hash of each declared type the types specialisation `k` is at name, in order of name: a key
/// names a type, and two programs may declare two types under one name.
fn declarations_named(program: Program, k: RootKey) -> Bytes = {
  let names = key_types(k).fold(Map::new(), |acc: Map<Bytes, Bool>, t: Type|
    type_names(t).fold(acc, |m: Map<Bytes, Bool>, n: Bytes| m.insert(n, true)));
  Bytes::concat_all(
    names.keys().map(|n: Bytes|
      match program.declared.get(n) {
        Some(h) -> Bytes::concat_all([b"\x00", n, b"=", h]),
        None -> b"",
      }),
  )
}

fn definition_material(program: Program, name: RootName) -> Option<Bytes> =
  match program.keys.get(name) {
    None -> None,
    Some(key) -> match program.roots.get(name) {
      None -> None,
      Some(r) -> match text_at(program, r.at.module) {
        None -> None,
        Some(text) -> if r.at.start < 0 || r.at.end > text.len() || r.at.start > r.at.end { None }
        else {
          Some(
            Bytes::concat_all([
              root_text(name),
              b"\x00",
              key,
              b"\x00",
              blake3(text.slice(r.at.start, r.at.end)),
              match program.embeds.get(r.at.module) { Some(d) -> d, None -> b"" },
            ]),
          )
        },
      },
    },
  }

/// The store below `bodies` that keeps the answers `emitter` gives on `runtime`, and the values a
/// build kept of `const` definitions beside them: one per such pair and format, so a store goes
/// whole once no run uses it.
pub fn answers_store(bodies: String, runtime: Runtime, emitter: Bytes) -> String / {abort.raise} = {
  let id = blake3(
    Bytes::concat_all(
      [b"ply.unit.answer.4", hex(bin::shape_digest(kept_bin())), runtime.identity, emitter].map(
        |b: Bytes| sized(b),
      ),
    ),
  );
  bodies ++ "/answers-" ++ id.slice(0, 16).hex_of()
}

/// What the kept answer of a root whose material is `m` is filed under.
fn answer_key(m: Bytes) -> Bytes = b"answer\x00".concat(m)

/// What the key whose digest is `d` is filed under: each kept once, and named by every kept answer
/// whose body calls it.
fn key_key(d: Bytes) -> Bytes = b"key\x00".concat(d)

/// The digest a kept answer names the root `k` by.
fn key_digest(k: RootKey) -> Bytes / {abort.raise} = blake3(key_bytes(k))

/// A group's kept body stands only when every member is offered and each member's kept answer is
/// that same group; otherwise the group is asked again, and the emitter groups what is wanted now.
fn standing(looked: Map<RootName, Answer>, offered: Map<RootName, Bool>) -> Map<RootName, Answer> =
  looked.fold(Map::new(), |acc: Map<RootName, Answer>, n: RootName, a: Answer|
    match a {
      Refused(_) -> acc,
      Body(b) -> if b.tables.members.fold(true, |ok: Bool, m: RootKey|
          ok && offered.contains(root_name(m))
            && (match looked.get(root_name(m)) {
              Some(Body(other)) -> other.tables.members == b.tables.members,
              _ -> false,
            })) { acc.insert(n, a) }
      else { acc },
    })

/// A kept body: its answer, which names none of the roots its body calls; the digest of each of
/// those, in the order its body names them, each root kept once beside it (`key_key`); and the key
/// each root it calls had, in the order `callees_of` names them. A key reads its callees by hash and
/// the C calls them by name, so two callees that hash alike under two names share a key and not a
/// body.
type Kept = { answer: Answer, calls: List<Bytes>, callees: List<Option<Bytes>> }

derive bin for Kept

/// The roots `a` calls, by name, ascending, each once.
fn callees_of(a: Answer) -> List<RootName> =
  match a { Body(b) -> names_ordered(b.tables.calls.map(root_name)), Refused(_) -> [] }

fn kept_of(keys: Map<RootName, Bytes>, a: Answer) -> Kept / {abort.raise} =
  match a {
    Body(b) ->
      {
        answer: Body({ ..b, tables: { ..b.tables, calls: [] } }),
        calls: b.tables.calls.map(key_digest),
        callees: callees_of(a).map(|c: RootName| keys.get(c)),
      },
    Refused(_) -> { answer: a, calls: [], callees: [] },
  }

/// Whether each root `a`'s body calls still has the key `callees` says it had.
fn holds(keys: Map<RootName, Bytes>, a: Answer, callees: List<Option<Bytes>>) -> Bool = {
  let names = callees_of(a);
  names.len() == callees.len()
    && range(0, names.len()).all(|i: Int|
      match names.at(i) { Some(n) -> callees.at(i) == Some(keys.get(n)), None -> false })
}

/// The answer `k` keeps, its calls named again by the keys `resolved` holds of their digests, where
/// it still stands: none where a root it calls is kept no more or a callee's key moved.
fn standing_kept(
  keys: Map<RootName, Bytes>,
  resolved: Map<Bytes, RootKey>,
  k: Kept,
) -> Option<Answer> =
  if !k.calls.all(|d: Bytes| resolved.contains(d)) { None } else {
    let a = match k.answer {
      Body(b) ->
        Body({
          ..b,
          tables: {
            ..b.tables,
            calls: k.calls.fold([], |acc: List<RootKey>, d: Bytes|
              match resolved.get(d) { Some(r) -> acc.push(r), None -> acc }),
          },
        }),
      Refused(_) -> k.answer,
    };
    if holds(keys, a, k.callees) { Some(a) } else { None }
  }

/// The answers `materials` names a kept one of, each root by its material: each read back with the
/// roots it calls, a key read once however many answers call it, and the digests of those keys,
/// which the store holds.
fn kept_answers<| e>(
  keys: Map<RootName, Bytes>,
  materials: Map<RootName, Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
) -> { answers: Map<RootName, Answer>, known: Map<Bytes, Bool> } / {abort.raise | e} = {
  let found = materials.fold(Map::new(), |acc: Map<RootName, Kept>, n: RootName, m: Bytes|
    match read(answer_key(m)) {
      Some(b) -> match bin::decode(b, kept_bin()) { Ok(k) -> acc.insert(n, k), Err(_) -> acc },
      None -> acc,
    });
  let digests = found.fold(Map::new(), |acc: Map<Bytes, Bool>, _: RootName, k: Kept|
    k.calls.fold(acc, |a: Map<Bytes, Bool>, d: Bytes| a.insert(d, true)));
  let resolved = digests.fold(Map::new(), |acc: Map<Bytes, RootKey>, d: Bytes, _: Bool|
    match read(key_key(d)) {
      Some(b) -> match bin::decode(b, root_key_bin()) { Ok(r) -> acc.insert(d, r), Err(_) -> acc },
      None -> acc,
    });
  {
    answers: found.fold(Map::new(), |acc: Map<RootName, Answer>, n: RootName, k: Kept|
      match standing_kept(keys, resolved, k) { Some(a) -> acc.insert(n, a), None -> acc }),
    known: resolved.fold(Map::new(), |acc: Map<Bytes, Bool>, d: Bytes, _: RootKey|
      acc.insert(d, true)),
  }
}

/// What keeps the bodies among `answers` each root of `materials` names: the body under its
/// material, and each root it calls under its key's digest where neither `known` nor the store
/// holds it yet; and `known` with those digests. A refusal is never kept: what the emitter refuses
/// may be the program's doing, which no material names.
fn answers_kept<| e>(
  keys: Map<RootName, Bytes>,
  materials: Map<RootName, Bytes>,
  answers: Map<RootName, Answer>,
  known: Map<Bytes, Bool>,
  read: (Bytes) -> Option<Bytes> / e,
) -> { records: List<Record>, known: Map<Bytes, Bool> } / {abort.raise | e} =
  answers.fold(
    { records: [], known: known },
    |acc: { records: List<Record>, known: Map<Bytes, Bool> }, n: RootName, a: Answer|
      match ((a, materials.get(n))) {
        (Body(b), Some(m)) -> {
          let called = b.tables.calls.fold(
            acc,
            |x: { records: List<Record>, known: Map<Bytes, Bool> }, k: RootKey| {
              let d = key_digest(k);
              if x.known.contains(d) { x }
              else if read(key_key(d)) != None { { ..x, known: x.known.insert(d, true) } } else {
                {
                  records: x.records.push({ key: key_key(d), bytes: key_bytes(k) }),
                  known: x.known.insert(d, true),
                }
              }
            },
          );
          {
            ..called,
            records: called.records.push({
              key: answer_key(m),
              bytes: bin::encode(kept_of(keys, a), kept_bin()),
            }),
          }
        },
        _ -> acc,
      },
  )

/// The program's constructors as the emitter reads them, the unit's table `ctors` laid out as the
/// dump says, with each sum's cases and the constructors whose module states a `key` or arithmetic.
fn program_ctors(dump: Dump, ctors: List<Ctor>) -> Ctors =
  ctors_of(
    ctors.map(|c: Ctor| c.name),
    // Program-wide: a specialisation is emitted where its definition is, which may not import
    // the module stating a `key` for the type it is at.
    dump.emitter_ctors.filter(|c: EmitterCtor| c.key != None).map(|c: EmitterCtor| c.name),
    dump.emitter_ctors.filter(|c: EmitterCtor| c.numeric.len() > 0).map(|c: EmitterCtor| c.name),
    ctor_sums(dump.ctors),
  )

/// The emitter's scope over every module of `p`, each whole, reading what the check filed of the
/// bodies `roots` reads (`emit.scope_of`): built once, when a walk first asks the emitter for a
/// root.
fn scope_over(
  runtime: Runtime,
  dump: Dump,
  p: Program,
  ctors: List<Ctor>,
  roots: List<RootKey>,
) -> Result<emit::Scope, Bytes> / {abort.raise} = {
  let names = p.modules.map(|m: ModuleRow| m.name);
  emit::scope_of(
    emit::zip_sources(
      names,
      p.modules.map(|m: ModuleRow| match text_at(p, m.index) { Some(t) -> t, None -> b"" }),
    ),
    program_ctors(dump, ctors),
    runtime.natives.map(|n: Native| n.name),
    true,
    roots,
    if dump.packages.len() == 0 { [{ prefix: b"", deps: [] }] } else { dump.packages },
    if dump.packages.len() == 0 { names.map(|_: Bytes| 0) } else {
      range(0, names.len()).map(|i: Int|
        match dump.module_packages.at(i) { Some(k) -> k, None -> 0 })
    },
    dump.embeds,
    dump.rows,
    dump.walked,
  )
}

/// A program's scope kept from one ask of the emitter to the next: the digest of what it was read
/// from, and the scope itself. A build asks for more than one unit of one program (the unit its
/// `const` values are evaluated in, then the unit it ships), and the scope is the same value for
/// each, so all but the first ask take it from here.
pub type Scoped = { key: Bytes, scope: Result<emit::Scope, Bytes> }

/// What a scope over a program is read from, digested: the front end's identity for the analysis it
/// published, each module's name and text, each file the program embeds, the packages it resolves
/// against, and the owners whose facts a scope over `facts_of` reads (`emit.read_in`). The scope is
/// a function of these, so asks that agree on them share one.
pub fn scope_key(
  dump: Dump,
  sources: List<Bytes>,
  inputs: Map<Bytes, Bytes>,
  facts_of: List<RootKey>,
) -> Bytes / {abort.raise} = {
  let embedded = inputs.entries().map(|e: { key: Bytes, value: Bytes }|
    Bytes::concat_all([sized(e.key), sized(e.value)]));
  let packages = dump.packages.map(|p: PackageDeps|
    Bytes::concat_all([sized(p.prefix)].concat(p.deps.map(|d: Bytes| sized(d)))));
  let module_packages = dump.module_packages.map(|k: Int|
    Bytes::concat_all([ascii_of_int(k), b"\x00"]));
  let read = emit::read_in(dump.rows, facts_of).keys().map(|n: Bytes| sized(n));
  blake3(
    Bytes::concat_all([
      sized(dump.hashes_digest),
      Bytes::concat_all(dump.modules.map(|m: ModuleRow| sized(m.name))),
      Bytes::concat_all(sources.map(|s: Bytes| sized(s))),
      Bytes::concat_all(embedded),
      Bytes::concat_all(packages),
      Bytes::concat_all(module_packages),
      Bytes::concat_all(read),
    ]),
  )
}

test "a scope's key holds while asks read the same facts, and moves with anything it reads" {
  let dump = three_modules_dump();
  let texts = three_modules();
  let roots = [Named(b"a.f")];
  let one = scope_key(dump, texts, Map::new(), roots);
  // Every owner these roots are dealt with holds facts, so both asks read every definition's, and
  // the scope one of them resolves answers the other's.
  assert_eq(
    emit::read_in(dump.rows, roots).keys(),
    emit::read_in(dump.rows, [Named(b"a.f"), Named(b"b.g")]).keys(),
  );
  assert_eq(scope_key(dump, texts, Map::new(), [Named(b"a.f"), Named(b"b.g")]), one);
  // A root no row holds facts of makes its ask read an owner another ask does not.
  assert(scope_key(dump, texts, Map::new(), [Named(b"a.absent")]) != one, None);
  // So does a root filed under a name no definition has, which is why a driver hands the roots its
  // program offers rather than the ones one ask of it wants: `Stored`, `Written`, `Test` and a
  // clause's roots each file under a name of their own.
  assert(scope_key(dump, texts, Map::new(), [Stored(Named(b"a.f"))]) != one, None);
  // Any module's text, and any file the program embeds, moves it.
  let edited = texts.set(1, b"pub fn g(x: Int) -> Int = x\n");
  assert(scope_key(dump, edited, Map::new(), roots) != one, None);
  assert(scope_key(dump, texts, Map::new().insert(b"h", b"x"), roots) != one, None)
}

/// What the emitter answers in `scope` for `roots`, each written against `handed` where it calls a
/// definition answered apart: each refused alike where the program lowers nothing.
fn answers_in(
  scope: Result<emit::Scope, Bytes>,
  roots: List<RootKey>,
  handed: Map<RootName, Handing>,
) -> List<RootAnswer> / {abort.raise} =
  match scope {
    Err(why) ->
      roots.fold(Map::new(), |acc: Map<RootName, Bool>, k: RootKey|
        acc.insert(root_name(k), true)).keys(
      ).map(|n: RootName| { name: n, answer: Refused({ why: why }) }),
    Ok(s) -> emit::answered(s, roots, handed),
  }

/// The lists an ask of the emitter is dealt over, answered at once: several to a core, so the cores
/// a list that lowers for longer than it weighs leaves idle take the others.
fn pieces() -> Int = 16

type Piece = { weight: Int, roots: List<RootKey> }

/// What a root written for a type weighs beside a definition, which weighs the length of its text:
/// about a short definition's.
fn written_weight() -> Int = 256

/// `missed` as at most `pieces()` lists that lower about as much each, the heaviest first onto the
/// lightest list, each root weighing the text it is written in and dealt with those `dealt_with`
/// puts it with.
fn dealt(p: Program, missed: List<RootKey>) -> List<List<RootKey>> / {abort.raise} = {
  let weight = |k: RootKey|
    match p.roots.get(sited_as(k)) { Some(r) -> r.at.end - r.at.start, None -> written_weight() };
  let together = missed.fold(Map::new(), |acc: Map<Bytes, Piece>, k: RootKey| {
    let d = dealt_with(k);
    let had = match acc.get(d) { Some(x) -> x, None -> { weight: 0, roots: [] } };
    acc.insert(d, { weight: had.weight + weight(k), roots: had.roots.push(k) })
  });
  let heaviest_first = together.values().sort_by(|a: Piece, b: Piece| a.weight >= b.weight);
  let dealt = heaviest_first.fold([], |acc: List<Piece>, m: Piece|
    if acc.len() < pieces() { acc.push(m) } else {
      let lightest = range(0, acc.len()).fold(0, |best: Int, i: Int|
        if acc.get(i).weight < acc.get(best).weight { i } else { best });
      range(0, acc.len()).map(|i: Int| {
        let piece = acc.get(i);
        if i == lightest { { weight: piece.weight + m.weight, roots: piece.roots.concat(m.roots) } }
        else { piece }
      })
    });
  dealt.map(|piece: Piece| piece.roots)
}

/// What the emitter answers in `scope` for every list of `pieces` from `lo` up to `hi`, each list
/// asked apart and the lists at once, each written against `handed`: a root's answer is the same
/// whichever list asks for it. `room` is the halvings left, and 64 take any length to one.
fn answers_at_once(
  scope: Result<emit::Scope, Bytes>,
  pieces: List<List<RootKey>>,
  lo: Int,
  hi: Int,
  room: Int,
  handed: Map<RootName, Handing>,
) -> List<RootAnswer> / {abort.raise} =
  if hi - lo <= 1 {
    match pieces.at(lo) { Some(roots) -> answers_in(scope, roots, handed), None -> [] }
  } else if room <= 0 { panic("more halvings than a length has") } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      answers_at_once(scope, pieces, lo, mid, room - 1, handed),
      answers_at_once(scope, pieces, mid, hi, room - 1, handed),
    };
    halves._0.concat(halves._1)
  }

/// `handed` with the handing each body of `answers` publishes, as the lending reads it.
fn handed_with(
  handed: Map<RootName, Handing>,
  answers: Map<RootName, Answer>,
) -> Map<RootName, Handing> =
  answers.fold(handed, |acc: Map<RootName, Handing>, _: RootName, a: Answer|
    match a {
      Body(b) ->
        handed_from(b.tables.handings).fold(
          acc,
          |m: Map<RootName, Handing>, n: RootName, h: Handing| m.insert(n, h),
        ),
      Refused(_) -> acc,
    })

/// Each definition's handing as the bodies of `answers` publish it, over `before`: what every
/// caller's code is written against.
fn handings_held(
  before: Map<RootName, Published>,
  answers: Map<RootName, Answer>,
) -> Map<RootName, Published> =
  answers.fold(before, |acc: Map<RootName, Published>, _: RootName, a: Answer|
    match a {
      Body(b) ->
        b.tables.handings.fold(acc, |m: Map<RootName, Published>, h: Published| m.insert(h.def, h)),
      Refused(_) -> acc,
    })

/// Whether `a` was written against a callee's handing other than the one `held` holds; a callee
/// `held` holds nothing of yet is answered in a later round, which judges it then.
fn written_stale(a: Answer, held: Map<RootName, Published>) -> Bool =
  match a {
    Body(b) ->
      b.tables.assumed.any(|x: Published|
        match held.get(x.def) { Some(h) -> h != x, None -> false }),
    Refused(_) -> false,
  }

/// Each call of a body among `taken` written against a handing other than the one its callee
/// publishes in `answers`: what the rounds settled wrongly, which no unit ships.
fn misassumed_in(answers: Map<RootName, Answer>, taken: List<RootName>) -> List<Misassumed> = {
  let held = handings_held(Map::new(), answers);
  taken.fold([], |acc: List<Misassumed>, n: RootName|
    match answers.get(n) {
      Some(Body(b)) ->
        b.tables.assumed.fold(acc, |a: List<Misassumed>, x: Published|
          if agrees(x, held.get(x.def)) { a }
          else { a.push({ caller: n, assumed: x, published: held.get(x.def) }) }),
      _ -> acc,
    })
}

/// The roots among `answers`, each by its key in `keys`, the emitter is asked for again: each
/// written against a handing `held` no longer holds, and with it each definition of its recursion
/// group, which settle together.
fn stale_of(
  answers: Map<RootName, Answer>,
  held: Map<RootName, Published>,
  keys: Map<RootName, RootKey>,
) -> List<RootKey> =
  answers.fold([], |acc: List<RootKey>, n: RootName, a: Answer|
    if !written_stale(a, held) { acc } else {
      let own = match keys.get(n) { Some(k) -> [k], None -> [] };
      let group = match a { Body(b) -> b.tables.group, Refused(_) -> [] };
      own.concat(group).fold(acc, |xs: List<RootKey>, g: RootKey|
        if xs.contains(g) { xs } else { xs.push(g) })
    })

/// `kept` without each answer whose recursion group holds a definition `kept` lacks, which is asked
/// for again with the rest of its group.
fn groups_whole(
  kept: Map<RootName, Answer>,
  asked: List<RootName>,
) -> Map<RootName, Answer> / {abort.raise} =
  iterate(kept, kept.len() + 1, |k: Map<RootName, Answer>| {
    let split = k.fold([], |acc: List<RootName>, n: RootName, a: Answer|
      match a {
        Body(b) -> if b.tables.group.any(|g: RootKey| {
            let member = root_name(g);
            asked.contains(member) && !k.contains(member)
          }) { acc.push(n) }
        else { acc },
        Refused(_) -> acc,
      });
    if split.len() == 0 { Stop(k) }
    else { Continue(split.fold(k, |m: Map<RootName, Answer>, n: RootName| m.remove(n))) }
  })

/// Where each module's definitions settle their handings: past every module it imports or reads a
/// type's functions from (its home), so each callee of a body outside the body's own module is
/// answered at an earlier place. Imports form no cycle, so the places are found within a step a
/// module.
fn places_of(p: Program) -> Map<Bytes, Int> / {abort.raise} = {
  let names = p.modules.map(|m: ModuleRow| m.name);
  let texts = p.modules.fold(Map::new(), |acc: Map<Bytes, Bytes>, m: ModuleRow|
    match text_at(p, m.index) { Some(t) -> acc.insert(m.name, t), None -> acc });
  let declared = homes_declaring(|h: Bytes| texts.get(h));
  let deps = names.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, m: Bytes| {
    let homes = match texts.get(m) {
      Some(t) -> homes_called(m, parsing::start(t).input, || declared),
      None -> [],
    };
    acc.insert(
      m,
      (match p.imports.get(m) { Some(xs) -> xs, None -> [] }).concat(homes).filter(|d: Bytes|
        d != m),
    )
  });
  iterate(Map::new(), names.len() + 2, |at: Map<Bytes, Int>| {
    let next = names.fold(Map::new(), |acc: Map<Bytes, Int>, m: Bytes|
      acc.insert(
        m,
        (match deps.get(m) { Some(ds) -> ds, None -> [] }).fold(0, |n: Int, d: Bytes| {
          let past = match at.get(d) { Some(l) -> l + 1, None -> 0 };
          if past > n { past } else { n }
        }),
      ));
    if next == at { Stop(next) } else { Continue(next) }
  })
}

/// The module a root is lowered with: a specialisation that runs a lambda goes with its lender's
/// module, which its call lowers too.
fn dealt_module(k: RootKey) -> Bytes / {abort.raise} =
  match key_lent(k).at(0) { Some(f) -> module_of(f.owner), None -> module_of(k) }

/// What a root is dealt with: its module's other roots (`dealt_module`), since a module's definitions
/// settle their handings in one call; but a specialisation running no lambda in place with the other
/// specialisations of its definition, whose handing it takes, and a root written for a type, whose
/// handing is fixed, alone.
fn dealt_with(k: RootKey) -> Bytes / {abort.raise} =
  match k {
    At(a, _) -> if a.lent.len() > 0 { dealt_module(k) } else { a.def },
    Written(_, _) -> root_text(root_name(k)),
    _ -> dealt_module(k),
  }

/// What asking the emitter for some roots came to: their answers, and what the emitter holds for the
/// next ask.
type Asked<s> = { held: s, answers: List<RootAnswer> }

/// How far a unit's walk of its program has come: each root's answer and key; the handing each
/// answered definition publishes, as answers publish it and as the lending reads it; how many answers
/// it took kept, how many roots it asked the emitter for and how many answers are refusals; the roots
/// it found beyond those offered; the digests of the keys the store is known to hold; the needs and
/// the parameters called as functions of the generic bodies whose calls it settled, closed over the
/// calls they make; the roots answered whose calls it has not read, and those whose generic calls it
/// has not settled; and what the emitter holds.
type Walk<s> = {
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
  held: Map<RootName, Published>,
  handed: Map<RootName, Handing>,
  kept: Int,
  asked: Int,
  refused: Int,
  added: List<RootKey>,
  known: Map<Bytes, Bool>,
  needs: Map<RootName, List<Need>>,
  called: Map<RootName, List<Int>>,
  unread: List<RootName>,
  unsettled: List<RootName>,
  emitter: s,
}

/// What one place of a unit's walk came to: the place, the roots it answered, how many of those an
/// earlier run kept, how many it asked the emitter for, how many were refused, the steps it took, each
/// answering what the one before found, and the clock as it began and ended.
pub type PlaceTally = {
  place: Int,
  roots: Int,
  kept: Int,
  asked: Int,
  refused: Int,
  steps: Int,
  began: Int,
  ended: Int,
}

/// The answer to each root of `offered`, and to each root those answers reach, place by place
/// (`places_of`), the emitter asked through `ask`, which starts from `emitter`. At each place its
/// offered roots are answered as `answered_now` answers them, and then each root their answers name
/// that no answer holds: a root written for a type, the generic body of a definition called
/// generically, and, once every such body is in, the root each generic call settles on, until none
/// is new. Each callee of a definition is answered at an earlier place or with it, so every body is
/// written once, against its callees' final handings; a root a place finds takes its definition's
/// handing or a fixed one. `types` is what a root written for a type reads of the program's types
/// (`types_material`). Each place is told to `phases` as it ends.
fn walked<s | e>(
  p: Program,
  types: Bytes,
  program: Ctors,
  offered: List<RootKey>,
  read: (Bytes) -> Option<Bytes> / e,
  keep: (List<Record>) -> Unit / e,
  phases: Option<{ now: () -> Int / e, told: (PlaceTally) -> Unit / e }>,
  emitter: s,
  ask: (s, List<RootKey>, Map<RootName, Handing>) -> Asked<s> / {abort.raise | e},
) -> Walk<s> / {abort.raise | e} = {
  let places = places_of(p);
  let place = |k: RootKey| match places.get(dealt_module(k)) { Some(l) -> l, None -> 0 };
  let at = offered.fold(Map::new(), |acc: Map<Int, List<RootKey>>, k: RootKey| {
    let l = place(k);
    acc.insert(l, List::push(match acc.get(l) { Some(ks) -> ks, None -> [] }, k))
  });
  let last = offered.fold(0, |m: Int, k: RootKey| if place(k) > m { place(k) } else { m });
  range(0, last + 1).fold(
    {
      answers: Map::new(),
      keys: Map::new(),
      held: Map::new(),
      handed: Map::new(),
      kept: 0,
      asked: 0,
      refused: 0,
      added: [],
      known: Map::new(),
      needs: Map::new(),
      called: Map::new(),
      unread: [],
      unsettled: [],
      emitter: emitter,
    },
    |w: Walk<s>, l: Int|
      match at.get(l) {
        None -> w,
        Some(roots) ->
          told_place(phases, l, w, || place_walked(p, types, program, w, roots, read, keep, ask)),
      },
  )
}

/// `run`, the walk of place `l` on from `w`, told to `phases` as it ends.
fn told_place<s | e>(
  phases: Option<{ now: () -> Int / e, told: (PlaceTally) -> Unit / e }>,
  l: Int,
  w: Walk<s>,
  run: () -> { walk: Walk<s>, steps: Int } / {abort.raise | e},
) -> Walk<s> / {abort.raise | e} =
  match phases {
    None -> run().walk,
    Some(t) -> {
      let began = t.now();
      let r = run();
      t.told({
        place: l,
        roots: r.walk.keys.len() - w.keys.len(),
        kept: r.walk.kept - w.kept,
        asked: r.walk.asked - w.asked,
        refused: r.walk.refused - w.refused,
        steps: r.steps,
        began: began,
        ended: t.now(),
      });
      r.walk
    },
  }

/// `w` with each of `roots` answered, and each root those answers reach (`found`, `settling`), step
/// after step until a step finds none or 64 steps have passed; and how many steps it took.
fn place_walked<s | e>(
  p: Program,
  types: Bytes,
  program: Ctors,
  w: Walk<s>,
  roots: List<RootKey>,
  read: (Bytes) -> Option<Bytes> / e,
  keep: (List<Record>) -> Unit / e,
  ask: (s, List<RootKey>, Map<RootName, Handing>) -> Asked<s> / {abort.raise | e},
) -> { walk: Walk<s>, steps: Int } / {abort.raise | e} =
  iterate(
    { walk: answered_now(p, types, w, roots, read, keep, ask), steps: 1 },
    66,
    |b: { walk: Walk<s>, steps: Int }| {
      let named = found(b.walk);
      let read_all = { ..b.walk, unread: [] };
      // Only once every generic body is in are the needs closed, so no call settles on a part of them.
      let next = if named.len() > 0 { { walk: read_all, more: named } }
      else { settling(read_all, program) };
      // A body an earlier step answered, written against a callee a later step answered with
      // another handing, is asked for again.
      let moved = stale_here(next.walk, roots.concat(next.walk.added));
      if (next.more.len() == 0 && moved.len() == 0) || b.steps > 64 {
        Stop({ ..b, walk: next.walk })
      } else {
        let more = next.more.values().concat(moved);
        let unsettled = {
          ..next.walk,
          answers: moved.fold(next.walk.answers, |m: Map<RootName, Answer>, k: RootKey|
            m.remove(root_name(k))),
        };
        let after = answered_now(p, types, unsettled, more, read, keep, ask);
        Continue({ walk: { ..after, added: after.added.concat(more) }, steps: b.steps + 1 })
      }
    },
  )

/// Each of `here`, roots this place answered, whose answer `w` holds written against a handing `w`
/// no longer holds, with the rest of its recursion group.
fn stale_here<s>(w: Walk<s>, here: List<RootKey>) -> List<RootKey> = {
  let keys = here.fold(Map::new(), |m: Map<RootName, RootKey>, k: RootKey|
    m.insert(root_name(k), k));
  let answers = keys.fold(Map::new(), |m: Map<RootName, Answer>, n: RootName, _: RootKey|
    match w.answers.get(n) { Some(a) -> m.insert(n, a), None -> m });
  stale_of(answers, w.held, keys)
}

/// Where `answered_now` is in asking the emitter: the answers the emitter gave, the kept answers
/// still standing, how many roots it asked for, the digests of the keys the store is known to hold,
/// the roots not yet asked for, and what the emitter holds.
type Asking<s> = {
  fresh: Map<RootName, Answer>,
  kept: Map<RootName, Answer>,
  asked: Int,
  known: Map<Bytes, Bool>,
  pending: List<RootKey>,
  emitter: s,
}

/// `w` with each of `roots` it holds no answer of answered: each kept answer read where it stands,
/// the emitter asked through `ask` for the rest, each written against the handings `w` holds and
/// those these answers publish. A kept answer written against a handing that has moved since is asked
/// for again, as is every other one of a recursion group it leaves. What the emitter answers is kept
/// through `keep` as it comes back, so a run that dies keeps what it was answered; a root it answers
/// nothing for is refused as one it declined.
fn answered_now<s | e>(
  p: Program,
  types: Bytes,
  w: Walk<s>,
  roots: List<RootKey>,
  read: (Bytes) -> Option<Bytes> / e,
  keep: (List<Record>) -> Unit / e,
  ask: (s, List<RootKey>, Map<RootName, Handing>) -> Asked<s> / {abort.raise | e},
) -> Walk<s> / {abort.raise | e} = {
  let keys = roots.fold(Map::new(), |acc: Map<RootName, RootKey>, k: RootKey|
    if w.answers.contains(root_name(k)) { acc } else { acc.insert(root_name(k), k) });
  let names = keys.keys();
  let asked = names.fold(Map::new(), |acc: Map<RootName, Bool>, n: RootName| acc.insert(n, true));
  let materials = keys.fold(Map::new(), |acc: Map<RootName, Bytes>, n: RootName, k: RootKey|
    match root_material(p, types, k) { Some(m) -> acc.insert(n, m), None -> acc });
  let looked = kept_answers(p.keys, materials, read);
  let standing_now = standing(looked.answers, asked);
  let stale = stale_of(standing_now, handings_held(w.held, standing_now), keys);
  let kept = groups_whole(
    stale.fold(standing_now, |m: Map<RootName, Answer>, k: RootKey| m.remove(root_name(k))),
    names,
  );
  let missed = keys.values().filter(|k: RootKey| !kept.contains(root_name(k)));
  let settled = iterate(
    {
      fresh: Map::new(),
      kept: kept,
      asked: 0,
      known: looked.known.fold(w.known, |m: Map<Bytes, Bool>, d: Bytes, _: Bool| m.insert(d, true)),
      pending: missed,
      emitter: w.emitter,
    },
    kept.len() + 2,
    |t: Asking<s>| {
      let now = t.fresh.fold(t.kept, |m: Map<RootName, Answer>, n: RootName, a: Answer|
        m.insert(n, a));
      // A body answered in an earlier round, kept or fresh, written against a callee answered
      // after it with another handing, is asked for again.
      let moved = stale_of(now, handings_held(w.held, now), keys);
      let asking = t.pending.concat(moved);
      if asking.len() == 0 { Stop(t) } else {
        let got = ask(t.emitter, asking, handed_with(w.handed, now));
        let answers = answers_of(got.answers);
        let r = answers_kept(p.keys, materials, answers, t.known, read);
        if r.records.len() > 0 { keep(r.records) };
        let stood = moved.fold(t.fresh, |m: Map<RootName, Answer>, k: RootKey|
          m.remove(root_name(k)));
        Continue({
          fresh: answers.fold(stood, |m: Map<RootName, Answer>, n: RootName, a: Answer|
            m.insert(n, a)),
          kept: moved.fold(t.kept, |m: Map<RootName, Answer>, k: RootKey| m.remove(root_name(k))),
          asked: t.asked + asking.len(),
          known: r.known,
          pending: [],
          emitter: got.held,
        })
      }
    },
  );
  let answered = missed.fold(settled.fresh, |acc: Map<RootName, Answer>, k: RootKey|
    if acc.contains(root_name(k)) { acc }
    else { acc.insert(root_name(k), Refused({ why: unanswered_why() })) });
  let all = answered.fold(settled.kept, |acc: Map<RootName, Answer>, n: RootName, a: Answer|
    acc.insert(n, a));
  let now = all.keys();
  {
    ..w,
    answers: all.fold(w.answers, |acc: Map<RootName, Answer>, n: RootName, a: Answer|
      acc.insert(n, a)),
    keys: keys.fold(w.keys, |acc: Map<RootName, RootKey>, n: RootName, k: RootKey|
      acc.insert(n, k)),
    held: handings_held(w.held, all),
    handed: handed_with(w.handed, all),
    kept: w.kept + all.len() - answered.len(),
    asked: w.asked + settled.asked,
    refused: w.refused
      + all.fold(0, |c: Int, _: RootName, a: Answer| match a { Refused(_) -> c + 1, Body(_) -> c }),
    known: settled.known,
    unread: w.unread.concat(now),
    unsettled: w.unsettled.concat(now),
    emitter: settled.emitter,
  }
}

/// The roots the answers `w` has not read call that no answer holds: each root written for a type a
/// body calls, each clause an entry judges at its definition's specialisation, and the generic body
/// of each definition a body calls generically, whose needs settle those calls. Of a body's other
/// calls none can be new: it calls a specialisation only as itself.
fn found<s>(w: Walk<s>) -> Map<RootName, RootKey> =
  w.unread.fold(Map::new(), |acc: Map<RootName, RootKey>, n: RootName|
    match w.answers.get(n) {
      Some(Body(b)) -> {
        let unheld = |m: Map<RootName, RootKey>, c: RootKey|
          if w.answers.contains(root_name(c)) { m } else { m.insert(root_name(c), c) };
        let written = b.tables.calls.fold(acc, |m: Map<RootName, RootKey>, c: RootKey|
          match c { Written(_, _) -> unheld(m, c), Clause(_) -> unheld(m, c), _ -> m });
        b.tables.generics.calls.fold(written, |m: Map<RootName, RootKey>, g: GenericCall|
          if w.answers.contains(root_name(g.callee)) { m }
          else { m.insert(root_name(g.callee), g.callee) })
      },
      _ -> acc,
    })

/// `w` with the generic calls of the answers it has not settled settled: the needs and the parameters
/// called as functions of the generic bodies among them closed over the calls they make, and the root
/// each call of a body the unit emits settles on, where no answer holds it. The first call in name
/// order settling on a layout gives the root its type.
fn settling<s>(
  w: Walk<s>,
  program: Ctors,
) -> { walk: Walk<s>, more: Map<RootName, RootKey> } / {abort.raise} = {
  let names = names_ordered(w.unsettled);
  let bodies = generic_bodies(w.answers, w.keys, names);
  let needs = needs_closed(bodies, w.needs);
  let called = called_closed(bodies, w.called);
  let more = names.fold(Map::new(), |acc: Map<RootName, RootKey>, n: RootName|
    match w.answers.get(n) {
      Some(Body(b)) -> if settled_by_its_callers(w.keys, n, b.tables, needs) { acc } else {
        b.tables.generics.calls.fold(acc, |m: Map<RootName, RootKey>, g: GenericCall| {
          let root = settled_root(g, needs, called, program);
          let name = root_name(root);
          if w.answers.contains(name) || m.contains(name) { m } else { m.insert(name, root) }
        })
      },
      _ -> acc,
    });
  { walk: { ..w, needs: needs, called: called, unsettled: [] }, more: more }
}

// --- Values a build kept ----------------------------------------------------------

/// A `const` definition and the encoding of its value a build kept, which its stored root wrote.
pub type Baked = { name: Bytes, bytes: Bytes }

/// The calls a `const` definition may make before a build gives up on it.
pub fn const_budget() -> Int = 100000000

/// The bytes a `const` definition's value's encoding may take.
pub fn const_room() -> Int = 16777216

/// What a `const` definition's value is kept under in the store of answers of the emitter that
/// encoded it on the runtime that evaluated it (`answers_store`): what the front end keeps the
/// definition under, which is the hash of all it reaches, the files it embeds among them, and the
/// names of it.
pub fn baked_key(hash: Bytes) -> Bytes = b"value\x00".concat(hash)

/// The name of the root that answers the encoding of the value of the `const` definition `name`,
/// which a build enters to keep it.
pub fn stored_root(name: Bytes) -> Bytes = root_text(root_name(Stored(Named(name))))

/// A `const` definition as the value a build kept of it, laid out as static data: its body answers
/// the value from there and calls nothing, so the unit need not hold what the body reaches, and a
/// read of it neither steps nor allocates; refused where the emitter refuses that body. Stops the
/// unit where the value does not lay out at the definition's type, which no value a build kept
/// fails to.
fn kept_body(ctors: Ctors, p: Program, b: Baked) -> Answer / {abort.raise} = {
  let unlaid = |why: Bytes|
    panic(
      String::of_bytes_lossy(
        Bytes::concat_all([
          b"the value a build kept of `",
          b.name,
          b"` does not lay out at its type: ",
          why,
          b"; this is Ply's fault",
        ]),
      ),
    );
  match p.schemes.get(b.name) {
    Some(sc) -> match sc.ty {
      TyFn(f) -> match value::decode(b.bytes) {
        Some(v) -> match known_of_value(ctors, f.ret, v) {
          Ok(k) -> {
            let name = root_name(Named(b.name));
            let e = emitted_of(
              Formed({ name: name, form: Ok(kept_root(ctors, Named(b.name), f.ret, k)) }),
              ctors,
            );
            match e.why {
              Some(why) -> Refused({ why: why }),
              // Its answer owned, as the lending settles any definition's of no parameters.
              None ->
                Body({
                  text: e.text,
                  tables: { ..e.tables, handings: [published_of(name, taking_all(0))] },
                }),
            }
          },
          Err(why) -> unlaid(why),
        },
        None -> unlaid(b"its encoding does not decode"),
      },
      _ -> unlaid(b"its definition is no function"),
    },
    None -> unlaid(b"no scheme types its definition"),
  }
}

/// The unit over `every` root offered: each one's answer taken from what an earlier run kept where it
/// stands, the emitter asked for the rest, in one scope over the program built when it is first
/// asked, what it answered kept for the next run, and the unit produced over all of it. `inputs`
/// holds the bytes of each file `dump` says the program embeds, by digest. `read` reads a record of
/// the store of answers `answers_store` names, and `keep` keeps a batch of them, each batch as the
/// emitter answers it. A root the emitter answers nothing for is refused. A root `baked` names is
/// held as that value in place of its body, which the emitter is not asked for. Each place the unit
/// walks is told to `phases` as it ends. `scope_held` is the scope an earlier ask of this program
/// walked under, which this one walks under too, or `None` to resolve the program here. `facts_of`
/// are the roots whose bodies the scope reads what the check filed of; it is the roots offered where
/// none is given, so that every root a walk may be asked for is one the scope holds facts of.
pub fn emitted<| e>(
  runtime: Runtime,
  dump: Dump,
  sources: List<Bytes>,
  inputs: Map<Bytes, Bytes>,
  every: List<RootKey>,
  read: (Bytes) -> Option<Bytes> / e,
  keep: (List<Record>) -> Unit / e,
  baked: List<Baked> = [],
  phases: Option<{ now: () -> Int / e, told: (PlaceTally) -> Unit / e }> = None,
  scope_held: Option<Result<emit::Scope, Bytes>> = None,
  facts_of: Option<List<RootKey>> = None,
) -> Result<Emission, Bytes> / {abort.raise | e} = {
  let p = program_of(dump, sources);
  let ctors = dump.emitter_ctors.map(|c: EmitterCtor| { name: c.name, arity: c.arity });
  let wanted = every.fold(Map::new(), |acc: Map<RootName, Bool>, k: RootKey|
    acc.insert(root_name(k), true));
  let values = baked.fold(Map::new(), |acc: Map<RootName, Baked>, b: Baked| {
    let n = root_name(Named(b.name));
    if wanted.contains(n) { acc.insert(n, b) } else { acc }
  });
  let entries = every.filter(|k: RootKey| entered_root(p, k)).map(Entered);
  let offered = every.filter(|k: RootKey| !values.contains(root_name(k))).concat(entries);
  let reading = match facts_of { Some(rs) -> rs, None -> offered };
  let program = program_ctors(dump, ctors);
  let all = walked(
    p,
    types_material(dump),
    program,
    offered,
    read,
    keep,
    phases,
    scope_held,
    |held: Option<Result<emit::Scope, Bytes>>, roots: List<RootKey>, handed: Map<RootName, Handing>| {
      let scope = match held { Some(s) -> s, None -> scope_over(runtime, dump, p, ctors, reading) };
      let pieces = dealt(p, roots);
      { held: Some(scope), answers: answers_at_once(scope, pieces, 0, pieces.len(), 64, handed) }
    },
  );
  {
    let shared = alike(all.answers, all.keys);
    let unemitted = settled_only(all.answers, all.keys, closed_needs(all.answers, all.keys));
    let held = values.fold(
      settled_bodies(generics_settled(all.answers, all.keys, shared, program), all.keys, unemitted),
      |acc: Map<RootName, Answer>, n: RootName, b: Baked| acc.insert(n, kept_body(program, p, b)),
    );
    let produced = produce(
      runtime,
      ctors,
      every.concat(all.added.filter(|k: RootKey| !shared.contains(root_name(k)))).filter(
        |k: RootKey| !unemitted.contains(root_name(k)),
      ).concat(
        entries,
      ).map(|k: RootKey|
        match k {
          // An entry takes no words: what it reads crosses through the runtime.
          Entered(_) -> { name: root_name(k), arity: 0, constant: false, site: sited_as(k) },
          _ -> match p.roots.get(sited_as(k)) {
            Some(r) ->
              {
                name: root_name(k),
                arity: r.arity,
                constant: r.pure && r.arity == 0 && (match k { At(_, _) -> false, _ -> true }),
                site: sited_as(k),
              },
            None -> { name: root_name(k), arity: 0, constant: false, site: sited_as(k) },
          },
        }),
      p.modules.len(),
      held,
      inputs,
      dump.emitter_ctors.fold([], |acc: List<Stated>, c: EmitterCtor|
        if c.key == None && c.show == None && c.numeric.len() == 0 { acc }
        else { acc.push({ ctor: c.name, key: c.key, show: c.show, numeric: c.numeric }) }),
    );
    Ok({
      produced: produced,
      kept: all.kept,
      asked: all.asked,
      unbound: unbound(
        runtime.natives,
        called_externs(natives_called(produced.made), p.modules, |m: ModuleRow|
          text_at(p, m.index)),
      ),
      misassumed: misassumed_in(all.answers, produced.taken),
      scope: all.emitter,
    })
  }
}

/// The definition the root named `n` specialises, where `keys` holds it as a specialisation.
fn specialising(keys: Map<RootName, RootKey>, n: RootName) -> Option<Bytes> =
  match keys.get(n) { Some(At(a, _)) -> Some(a.def), _ -> None }

/// Why a root is refused that the emitter was asked for and answered nothing for.
fn unanswered_why() -> Bytes = b"the emitter answered nothing for it"

// --- Generic calls ---------------------------------------------------------------

/// The tables of each body of `answers` among `names` that is no specialisation, by name: a generic
/// body, whose calls its specialisations' callers settle.
fn generic_bodies(
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
  names: List<RootName>,
) -> Map<RootName, Tables> =
  names.fold(Map::new(), |acc: Map<RootName, Tables>, n: RootName|
    match answers.get(n) {
      Some(Body(b)) -> if specialising(keys, n) == None { acc.insert(n, b.tables) } else { acc },
      _ -> acc,
    })

/// What each generic definition's code needs of its type arguments, closed over the calls its
/// generic body makes: a callee's need of the layout of an argument is the caller's need of each
/// variable that argument is laid out by, and its need of a scalar the caller's of the variable the
/// argument is.
fn closed_needs(
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
) -> Map<RootName, List<Need>> / {abort.raise} =
  needs_closed(generic_bodies(answers, keys, answers.keys()), Map::new())

/// `closed` with the needs of each body of `bodies` closed over the calls it makes, as
/// `closed_needs` closes them, a callee outside `bodies` needing what `closed` holds of it.
fn needs_closed(
  bodies: Map<RootName, Tables>,
  closed: Map<RootName, List<Need>>,
) -> Map<RootName, List<Need>> / {abort.raise} = {
  let start = bodies.fold(closed, |acc: Map<RootName, List<Need>>, n: RootName, t: Tables|
    acc.insert(n, t.generics.needs));
  // Needs only grow, so a round adding none is the last.
  let held = |needs: Map<RootName, List<Need>>|
    bodies.fold(0, |c: Int, n: RootName, _: Tables|
      c + (match needs.get(n) { Some(ns) -> ns.len(), None -> 0 }));
  // Each round adds a need or stops, and a definition has two needs a variable at most.
  let most = bodies.fold(1, |acc: Int, _: RootName, t: Tables|
    acc + 2 * t.generics.calls.fold(1, |n: Int, c: GenericCall| n + c.args.len()));
  iterate(start, most, |needs: Map<RootName, List<Need>>| {
    let next = bodies.fold(needs, |acc: Map<RootName, List<Need>>, n: RootName, t: Tables|
      t.generics.calls.fold(acc, |a: Map<RootName, List<Need>>, call: GenericCall|
        widened(a, n, call, needs)));
    if held(next) == held(needs) { Stop(needs) } else { Continue(next) }
  })
}

/// Whether the body of root `n`, whose tables are `t`, is a generic body the unit never emits: its
/// needs, its own or what its callees need of what it hands them (`needs`), read a type variable's
/// layout or the type itself, which only the type arguments its callers settle say.
fn settled_by_its_callers(
  keys: Map<RootName, RootKey>,
  n: RootName,
  t: Tables,
  needs: Map<RootName, List<Need>>,
) -> Bool =
  specialising(keys, n) == None
    && (settled_by_callers(t.generics.needs)
    || settled_by_callers(match needs.get(n) { Some(ns) -> ns, None -> [] }))

/// The generic bodies the unit never emits (`settled_by_its_callers`). Their calls are settled on
/// their specialisations instead.
fn settled_only(
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
  needs: Map<RootName, List<Need>>,
) -> Map<RootName, Bool> =
  answers.fold(Map::new(), |acc: Map<RootName, Bool>, n: RootName, a: Answer|
    match a {
      Body(b) -> if settled_by_its_callers(keys, n, b.tables, needs) { acc.insert(n, true) }
      else { acc },
      Refused(_) -> acc,
    })

/// Why a call of a body its callers settle cannot run where it settles on no type arguments.
fn settled_why() -> Bytes =
  b"a body its callers settle at their type arguments, which this call does not settle"

/// `answers` with each body of `unemitted` refused as its callers settle it, after a check that no
/// specialisation still reads a type variable's layout or type: such a specialisation was settled
/// on type arguments that leave open what it reads, which no unit can emit.
fn settled_bodies(
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
  unemitted: Map<RootName, Bool>,
) -> Map<RootName, Answer> / {abort.raise} =
  answers.fold(Map::new(), |acc: Map<RootName, Answer>, n: RootName, a: Answer|
    if unemitted.contains(n) { acc.insert(n, Refused({ why: settled_why() })) } else {
      match a {
        Body(b) -> if specialising(keys, n) != None && settled_by_callers(b.tables.generics.needs) {
          panic(
            String::of_bytes_lossy(
              Bytes::concat_all([
                b"the specialisation `",
                root_text(n),
                b"` its callers settled still reads a type variable's layout or type",
              ]),
            ),
          )
        } else { acc.insert(n, a) },
        Refused(_) -> acc.insert(n, a),
      }
    })

/// Each body's parameters it calls as functions, closed over the calls it hands them on to: one
/// handed on as a parameter its callee calls is called. A tail group's members call none, since a
/// specialisation of one would leave its group's loop.
fn closed_called(
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
) -> Map<RootName, List<Int>> / {abort.raise} =
  called_closed(generic_bodies(answers, keys, answers.keys()), Map::new())

/// `closed` with the parameters each body of `bodies` calls as functions closed over the calls it
/// hands them on to, as `closed_called` closes them, a callee outside `bodies` calling what `closed`
/// holds of it.
fn called_closed(
  bodies: Map<RootName, Tables>,
  closed: Map<RootName, List<Int>>,
) -> Map<RootName, List<Int>> / {abort.raise} = {
  let alone = bodies.fold(Map::new(), |acc: Map<RootName, Generics>, n: RootName, t: Tables|
    if t.members.len() <= 1 { acc.insert(n, t.generics) } else { acc });
  let start = alone.fold(closed, |acc: Map<RootName, List<Int>>, n: RootName, g: Generics|
    acc.insert(n, g.called));
  let held = |called: Map<RootName, List<Int>>|
    alone.fold(0, |c: Int, n: RootName, _: Generics|
      c + (match called.get(n) { Some(cs) -> cs.len(), None -> 0 }));
  // Each round adds a parameter or stops, and a body has as many to add as it hands on.
  let most = alone.fold(1, |acc: Int, _: RootName, g: Generics| acc + g.passes.len());
  iterate(start, most, |called: Map<RootName, List<Int>>| {
    let next = alone.fold(called, |acc: Map<RootName, List<Int>>, n: RootName, g: Generics|
      g.passes.fold(acc, |a: Map<RootName, List<Int>>, pass: Pass| {
        let theirs = match called.get(root_name(pass.callee)) { Some(cs) -> cs, None -> [] };
        let mine = match a.get(n) { Some(cs) -> cs, None -> [] };
        if theirs.contains(pass.at) && !mine.contains(pass.param) {
          a.insert(n, mine.push(pass.param))
        } else { a }
      }));
    if held(next) == held(called) { Stop(called) } else { Continue(next) }
  })
}

/// `needs` with caller `n`'s needs of what `call` hands its callee.
fn widened(
  acc: Map<RootName, List<Need>>,
  n: RootName,
  call: GenericCall,
  needs: Map<RootName, List<Need>>,
) -> Map<RootName, List<Need>> / {abort.raise} = {
  let callee = match needs.get(root_name(call.callee)) { Some(ns) -> ns, None -> [] };
  callee.fold(acc, |a: Map<RootName, List<Need>>, need: Need|
    match call.args.at(need.var) {
      None -> a,
      Some(arg) -> {
        let vars = match need.reads {
          Exact -> type_vars(arg),
          Layout -> laid_vars(arg),
          Scalar -> match arg { TyVar(v) -> if v >= 0 { [v] } else { [] }, _ -> [] },
        };
        vars.fold(a, |m: Map<RootName, List<Need>>, v: Int| {
          let had = match m.get(n) { Some(ns) -> ns, None -> [] };
          let more = { var: v, reads: need.reads };
          if had.contains(more) { m } else { m.insert(n, had.push(more)) }
        })
      },
    })
}

/// The root a generic call settles on over the program's constructors `ctors`: each type argument
/// the callee's code needs and the call knows, keyed by the type itself where the code reads which
/// type it is or does the operators a type's module states, and otherwise by its layout (where the
/// code needs that, does a scalar's operators in C, or the call carries the argument raw), lowered
/// at the call's own argument; every other
/// argument left as the callee's generic body has it. Calls settling on one layout share a root's
/// name. A tail loop's member reads each variable exactly, so its loop runs at its callers' types.
fn settled_root(
  call: GenericCall,
  needs: Map<RootName, List<Need>>,
  called: Map<RootName, List<Int>>,
  ctors: Ctors,
) -> RootKey / {abort.raise} = {
  let callee = root_name(call.callee);
  let ns = match needs.get(callee) { Some(x) -> x, None -> [] };
  let open = KeyType(unknown_type());
  let args = range(0, call.args.len()).map(|j: Int| {
    let arg = call.args.get(j);
    let laid = || KeyLayout({ key: layout_key(ctors, arg), at: arg });
    if has_vars(arg) { open }
    else if ns.contains({ var: j, reads: Exact }) { KeyType(arg) }
    else if call.carried.contains(j) || ns.contains({ var: j, reads: Layout }) { laid() }
    else if ns.contains({ var: j, reads: Scalar }) && held_apart(arg) { laid() }
    else if ns.contains({ var: j, reads: Scalar }) && numeric_sum(ctors, arg) { KeyType(arg) }
    else { open }
  });
  // A lambda is run in place only by a callee that calls the parameter it is handed as.
  let calls = match called.get(callee) { Some(cs) -> cs, None -> [] };
  let fns = call.fns.filter(|f: FnArg| calls.contains(f.param));
  match definition_of(call.callee) {
    Some(def) -> if fns.len() == 0 && args.all(|a: KeyArg| a == open) { call.callee }
    else { keys::at_keyed(def, args, fns) },
    None -> call.callee,
  }
}

/// `answers` with every generic call settled over the program's constructors `ctors`: each
/// placeholder of a body's C, and of the entries its closures name, written as the root its call
/// settles on, and that root among the body's calls. A call whose specialisation the emitter
/// refused reaches the body it specialises where the unit emits that body and the call hands it
/// nothing raw; otherwise it keeps the specialisation, so its caller is dropped for that refusal.
fn generics_settled(
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
  shared: Map<RootName, RootName>,
  ctors: Ctors,
) -> Map<RootName, Answer> / {abort.raise} = {
  let needs = closed_needs(answers, keys);
  let called = closed_called(answers, keys);
  let unemitted = settled_only(answers, keys, needs);
  let emits = |k: RootKey|
    match answers.get(root_name(k)) {
      Some(Body(_)) -> !unemitted.contains(root_name(k)),
      _ -> false,
    };
  // A root keyed by a layout is the one the unit asked for under its name, whatever type this call
  // settles it at.
  let asked = |k: RootKey| match keys.get(root_name(k)) { Some(x) -> x, None -> k };
  answers.fold(Map::new(), |acc: Map<RootName, Answer>, n: RootName, a: Answer|
    acc.insert(n, match a {
      Body(b) -> if b.tables.generics.calls.len() == 0 { a } else {
        let settled = b.tables.generics.calls.map(|g: GenericCall| {
          let own = asked(settled_root(g, needs, called, ctors));
          let root = match shared.get(root_name(own)) {
            Some(r) -> match keys.get(r) {
              Some(k) -> k,
              None ->
                panic(
                  String::of_bytes_lossy(b"a root answered with no key: ".concat(root_text(r))),
                ),
            },
            None -> own,
          };
          match answers.get(root_name(root)) {
            Some(Refused(_)) -> {
              // Refused with lambdas run in place: the root without them, where it is emitted.
              let plain = asked(settled_root({ ..g, fns: [] }, needs, called, ctors));
              if g.fns.len() > 0 && root_name(plain) != root_name(root) && emits(plain) { plain }
              else if g.carried.len() == 0 && emits(g.callee) { g.callee }
              else { root }
            },
            _ -> root,
          }
        });
        let roots = settled.map(root_name);
        let calls = settled.fold(b.tables.calls, |cs: List<RootKey>, r: RootKey|
          if cs.any(|c: RootKey| root_name(c) == root_name(r)) { cs } else { cs.push(r) });
        // A generic call's head is held to the root it settles on, by that root's place in `calls`.
        let placed = |name: RootName|
          range(0, calls.len()).fold(None, |found: Option<Int>, i: Int|
            match found {
              Some(_) -> found,
              None -> match calls.at(i) {
                Some(c) -> if root_name(c) == name { Some(i) } else { None },
                None -> None,
              },
            });
        Body({
          text: placeholders_named(b.text, roots),
          tables: {
            ..b.tables,
            generics: {
              ..b.tables.generics,
              expects: b.tables.generics.expects.map(|e: Expect|
                match e.callee {
                  GenericAt(n) -> match roots.at(n) {
                    Some(r) -> match placed(r) { Some(i) -> { ..e, callee: CallAt(i) }, None -> e },
                    None -> e,
                  },
                  CallAt(_) -> e,
                }),
            },
            lambdas: b.tables.lambdas.map(|l: Bytes| placeholders_named(l, roots)),
            calls: calls,
          },
        })
      },
      Refused(_) -> a,
    }))
}

/// Each specialisation whose code another's is but for its name, to that other: the least name of
/// those whose C, but for its own symbol, and tables are alike. One is compiled and every call of
/// either reaches it.
fn alike(
  answers: Map<RootName, Answer>,
  keys: Map<RootName, RootKey>,
) -> Map<RootName, RootName> / {abort.raise} = {
  let keyed = answers.fold(Map::new(), |acc: Map<RootName, Bytes>, n: RootName, a: Answer|
    match a {
      Body(b) -> match specialising(keys, n) {
        Some(base) -> acc.insert(n, code_key(base, n, b)),
        None -> acc,
      },
      Refused(_) -> acc,
    });
  let first = keyed.fold(Map::new(), |acc: Map<Bytes, RootName>, n: RootName, k: Bytes|
    if acc.contains(k) { acc } else { acc.insert(k, n) });
  keyed.fold(Map::new(), |acc: Map<RootName, RootName>, n: RootName, k: Bytes|
    match first.get(k) { Some(m) -> if m == n { acc } else { acc.insert(n, m) }, None -> acc })
}

/// What the body of specialisation `n` of `base` is but for its name: its C and tables with its own
/// symbol and root name taken out, digested.
fn code_key(base: Bytes, n: RootName, b: { text: Bytes, tables: Tables }) -> Bytes / {abort.raise} = {
  let name = root_text(n);
  let own = symbol_of(name);
  let unnamed = |x: Bytes|
    Bytes::join(Bytes::join(x.split(own), b"@@own@@").split(name), b"@@root@@");
  let tables = {
    ..b.tables,
    calls: [],
    lambdas: b.tables.lambdas.map(unnamed),
    symbols: b.tables.symbols.map(|d: Defined|
      { ..d, symbol: unnamed(d.symbol), entry: unnamed(d.entry) }),
  };
  let calls = b.tables.calls.map(|c: RootKey| unnamed(root_text(root_name(c))));
  blake3(
    Bytes::concat_all([
      base,
      b"\x00",
      unnamed(b.text),
      b"\x00",
      bin::encode(calls, bin::list_bin(bin::bytes_bin())),
      bin::encode(tables, tables_bin()),
    ]),
  )
}

/// `text` with each `@@gN@@` written as the symbol of root `N`.
fn placeholders_named(text: Bytes, roots: List<RootName>) -> Bytes / {abort.raise} = {
  let walked = holes(text).filter(|h: Hole| h.kind == 103).fold(
    { from: 0, out: [] },
    |s: { from: Int, out: List<Bytes> }, h: Hole|
      {
        from: h.close + 2,
        out: s.out.push(text.slice(s.from, h.open)).push(
          symbol_of(root_text(roots.get(digits(h.digits)))),
        ),
      },
  );
  Bytes::concat_all(walked.out.push(text.slice(walked.from, text.len())))
}

// --- What a program is told -------------------------------------------------------

/// A root a build refuses, by the name its row spells it with, and why.
type Refusal = { root: Bytes, why: Bytes }

fn place_of(dump: Dump, name: Bytes) -> { module: Int, start: Int, end: Int } =
  dump.emitter_roots.fold(
    { module: no_module(), start: 0, end: 0 },
    |acc: { module: Int, start: Int, end: Int }, root: EmitterRoot|
      if root.root == name { { module: root.at.module, start: root.at.start, end: root.at.end } }
      else { acc },
  )

fn label_of(dump: Dump, r: Refusal, primary: Bool) -> Label = {
  let at = place_of(dump, r.root);
  { module: at.module, start: at.start, end: at.end, primary: primary, text: r.why }
}

/// Definitions the program reaches that the build refuses, in the order the fixpoint dropped them,
/// so the first is a cause and the rest what that cause carried.
fn refused_reach(dump: Dump, dropped: List<Refusal>) -> Diag / {abort.raise} = {
  let listed = dropped.fold(
    b"the emitter refused, in the order it dropped them:",
    |acc: Bytes, d: Refusal| Bytes::concat_all([acc, b"\n  `", d.root, b"` (", d.why, b")"]),
  );
  error_with_labels(
    b"E0448",
    Bytes::concat_all([
      b"the C backend cannot compile ",
      ascii_of_int(dropped.len()),
      b" of the definitions this program reaches",
    ]),
    range(0, dropped.len()).fold([], |acc: List<Label>, i: Int|
      if i > 4 { acc } else { acc.push(label_of(dump, dropped.get(i), i == 0)) }),
    [
      listed,
      b"compiled code is the only evaluator, so a definition it cannot compile is one nothing can enter; the build fails here, where the construct that refused it is still in hand, rather than at the call that would find no body",
    ],
  )
}

fn unsettled(why: Bytes) -> Diag =
  error_with_labels(
    b"E0450",
    b"the C backend could not be built: the Ply emitter failed over the program: ".concat(why),
    [],
    [
      b"compiled code is the only evaluator, so a run without a backend would be reported green over a seam nothing reached",
    ],
  )

/// The unit's C as the runtime compiles it, or why there is none: rounds of the emitter's answers
/// that did not settle, a native it calls that the runtime does not implement as declared, a call
/// written against a handing its callee does not publish, a root `dump` offers that no typed row
/// keys (`offered_roots`), or a definition the program reaches that the emitter refused. A
/// definition dropped only because a narrowed offer left its callee out is no refusal of the
/// program's.
pub fn held(
  dump: Dump,
  offered: List<RootKey>,
  emission: Result<Emission, Bytes>,
) -> Result<Bytes, List<Diag>> / {abort.raise} =
  match emission {
    Err(why) -> Err([unsettled(why)]),
    Ok(e) -> if e.unbound.len() > 0 { Err([natives_refused(e.unbound)]) }
    else if e.misassumed.len() > 0 { Err([handings_disagree(e.misassumed)]) } else {
      let errors = offered_roots(dump).unkeyed.map(|n: Bytes|
        { root: n, why: unkeyed_why(n) }).concat(
        fatal(offered.map(root_name), e.produced.dropped).map(|d: Dropped|
          { root: root_text(d.function), why: d.construct }),
      );
      if errors.len() == 0 { Ok(e.produced.text) } else { Err([refused_reach(dump, errors)]) }
    },
  }

// --- Tests ------------------------------------------------------------------

fn some_definitions() -> Bytes =
  b"compiler.unit.emitted aa\nfront.seam.view_dump bb\nunit.emitted cc\nunit.emitted_twice dd\n"

/// A generic body that calls `calls` and needs `needs`.
fn generic_body(calls: List<GenericCall>, needs: List<Need>) -> Answer =
  Body({
    text: b"",
    tables: { ..no_tables(), generics: { ..no_generics(), calls: calls, needs: needs } },
  })

/// The type `s` spells, as a test writes one.
fn spelled(s: Bytes) -> Type / {abort.raise} =
  match type_spelled(s) {
    Some(t) -> t,
    None -> panic(String::of_bytes_lossy(b"a spelling of no type: ".concat(s))),
  }

/// `answers` by their keys' names, and the keys by the same.
fn keyed(
  answers: List<{ key: RootKey, value: Answer }>,
) -> { answers: Map<RootName, Answer>, keys: Map<RootName, RootKey> } =
  {
    answers: answers.fold(
      Map::new(),
      |m: Map<RootName, Answer>, x: { key: RootKey, value: Answer }|
        m.insert(root_name(x.key), x.value),
    ),
    keys: answers.fold(
      Map::new(),
      |m: Map<RootName, RootKey>, x: { key: RootKey, value: Answer }|
        m.insert(root_name(x.key), x.key),
    ),
  }

/// The name of the root of definition `n`.
fn def_root(n: Bytes) -> RootName = root_name(Named(n))

/// The name root `k` prints as.
fn printed(k: RootKey) -> Bytes = root_text(root_name(k))

/// Each of `entries` by the name of the root of the definition its key names.
fn by_def<v>(entries: List<{ key: Bytes, value: v }>) -> Map<RootName, v> =
  entries.fold(Map::new(), |m: Map<RootName, v>, x: { key: Bytes, value: v }|
    m.insert(def_root(x.key), x.value))

/// The bucket the body of definition `n` compiles in.
fn def_bucket(n: Bytes) -> Int = bucket_of(def_root(n))

/// Definition `n` offered as a call of `arity` words.
fn offer(n: Bytes, arity: Int) -> Offered =
  { name: def_root(n), arity: arity, constant: false, site: def_root(n) }

test "a generic call settles on each argument its callee's code needs, and leaves the rest" {
  let needs = by_def([
    { key: b"m.lay", value: [{ var: 0, reads: Layout }] },
    { key: b"m.add", value: [{ var: 0, reads: Scalar }] },
    { key: b"m.same", value: [{ var: 0, reads: Exact }] },
  ]);
  let root = |callee: Bytes, arg: Bytes|
    settled_root(
      { callee: Named(callee), args: [spelled(arg)], carried: [], fns: [] },
      needs,
      Map::new(),
      no_ctors(),
    );
  let call = |callee: Bytes, arg: Bytes| root_text(root_name(root(callee, arg)));
  // A layout the code reads is kept by its key, a record of one pointer by its field, since its word
  // is a box of it; a type it reads is kept whole.
  assert_eq(call(b"m.lay", b"{x:Float}"), b"m.lay@{x:Float}");
  assert_eq(call(b"m.lay", b"_"), b"m.lay@_");
  assert_eq(call(b"m.lay", b"{x:m.Shape}"), b"m.lay@{x:_}");
  // Two types laid alike share the root's name, each lowered at its own type.
  assert_eq(call(b"m.lay", b"{x:m.Date}"), call(b"m.lay", b"{x:m.Shape}"));
  assert_eq(key_types(root(b"m.lay", b"{x:m.Date}")), [spelled(b"{x:m.Date}")]);
  assert_eq(call(b"m.same", b"List<m.Shape>"), b"m.same@List<m.Shape>");
  assert_eq(call(b"m.same", b"m.Date{day:Int}"), b"m.same@m.Date{day:Int}");
  // A scalar its operators read is kept; a record they do not read is not.
  assert_eq(call(b"m.add", b"Float"), b"m.add@Float");
  assert_eq(call(b"m.add", b"{x:Float}"), b"m.add");
  assert_eq(call(b"m.add", b"m.Shape"), b"m.add");
  // An argument the caller does not know yet, or a callee that needs nothing, is the generic body.
  assert_eq(call(b"m.lay", b"{x:'0}"), b"m.lay");
  assert_eq(call(b"m.none", b"Float"), b"m.none")
}

test "a lambda is run in place only by a callee that calls the parameter it is handed as" {
  let body = |called: List<Int>, passes: List<Pass>|
    Body({
      text: b"",
      tables: { ..no_tables(), generics: { ..no_generics(), called: called, passes: passes } },
    });
  let answers = by_def([
    { key: b"m.each", value: body([1], []) },
    // `pass` hands its parameter on to `each`, which calls it; `keep` only holds it.
    { key: b"m.pass", value: body([], [{ param: 0, callee: Named(b"m.each"), at: 1 }]) },
    { key: b"m.keep", value: body([], []) },
  ]);
  let called = closed_called(answers, Map::new());
  assert_eq(called.get(def_root(b"m.pass")), Some([0]));
  let call = |callee: Bytes, param: Int|
    printed(
      settled_root(
        {
          callee: Named(callee),
          args: [],
          carried: [],
          fns: [{ param: param, owner: Named(b"m.main"), nth: 0 }],
        },
        Map::new(),
        called,
        no_ctors(),
      ),
    );
  assert_eq(call(b"m.each", 1), b"m.each@|1=m.main:0");
  assert_eq(call(b"m.pass", 0), b"m.pass@|0=m.main:0");
  assert_eq(call(b"m.each", 0), b"m.each");
  assert_eq(call(b"m.keep", 0), b"m.keep")
}

test "a refused specialisation leaves its call to the generic body, whichever root lent the lambda" {
  let lent = |owner: Bytes| [{ param: 1, owner: Named(owner), nth: 0 }];
  let calling = |callee: Bytes, owner: Bytes|
    generic_body([{ callee: Named(callee), args: [], carried: [], fns: lent(owner) }], []);
  let calls_one = Body({
    text: b"",
    tables: { ..no_tables(), generics: { ..no_generics(), called: [1] } },
  });
  let refused = Refused({ why: b"a body the lowering does not reach" });
  let mapping = at_key(b"std.prelude.List::map", [], lent(b"m.mapped"));
  let had = keyed([
    { key: Named(b"m.each"), value: calls_one },
    { key: Named(b"std.prelude.mapped_from"), value: calls_one },
    { key: Named(b"m.main"), value: calling(b"m.each", b"m.main") },
    { key: at_key(b"m.each", [], lent(b"m.main")), value: refused },
    // `List::map` hands the lambda it runs on to `mapped_from`, whose specialisation is refused.
    {
      key: Named(b"std.prelude.List::map"),
      value: Body({
        text: b"",
        tables: {
          ..no_tables(),
          generics: {
            ..no_generics(),
            passes: [{ param: 1, callee: Named(b"std.prelude.mapped_from"), at: 1 }],
          },
        },
      }),
    },
    { key: Named(b"m.mapped"), value: calling(b"std.prelude.List::map", b"m.mapped") },
    { key: mapping, value: calling(b"std.prelude.mapped_from", b"m.mapped") },
    { key: at_key(b"std.prelude.mapped_from", [], lent(b"m.mapped")), value: refused },
  ]);
  let settled = generics_settled(had.answers, had.keys, Map::new(), no_ctors());
  let calls = |k: RootKey|
    match settled.get(root_name(k)) { Some(Body(b)) -> b.tables.calls, _ -> panic("no body") };
  // The lambda a caller lends carries its entry, so the generic body calls it as any closure.
  assert_eq(calls(Named(b"m.main")), [Named(b"m.each")]);
  assert_eq(calls(mapping), [Named(b"std.prelude.mapped_from")]);
  assert_eq(calls(Named(b"m.mapped")), [mapping])
}

test "a caller of a refused specialisation of a body its callers settle is dropped for the specialisation's refusal" {
  let lay = { callee: Named(b"m.lay"), args: [spelled(b"Float")], carried: [], fns: [] };
  let spec = settled_root(
    lay,
    by_def([{ key: b"m.lay", value: [{ var: 0, reads: Layout }] }]),
    Map::new(),
    no_ctors(),
  );
  let why = b"the typed form of `m.lay@Float` fails its check";
  let had = keyed([
    { key: Named(b"m.lay"), value: generic_body([], [{ var: 0, reads: Layout }]) },
    { key: spec, value: Refused({ why: why }) },
    { key: Named(b"m.main"), value: generic_body([lay], []) },
  ]);
  let settled = generics_settled(had.answers, had.keys, Map::new(), no_ctors());
  let held = settled_bodies(
    settled,
    had.keys,
    settled_only(settled, had.keys, closed_needs(settled, had.keys)),
  );
  let s = settle(held, [def_root(b"m.main")], []);
  assert_eq(s.dropped.map(|d: Dropped| d.construct), [
    Bytes::concat_all([b"`", printed(spec), b"`, refused: ", why]),
  ])
}

test "a generic body needs what its callees need of what it hands them, through its own variables" {
  let answers = by_def([
    { key: b"m.add", value: generic_body([], [{ var: 0, reads: Scalar }]) },
    { key: b"m.lay", value: generic_body([], [{ var: 0, reads: Layout }]) },
    // `wrap` hands its variable to `add` bare and to `lay` inside a record.
    {
      key: b"m.wrap",
      value: generic_body(
        [
          { callee: Named(b"m.add"), args: [spelled(b"'0")], carried: [], fns: [] },
          { callee: Named(b"m.lay"), args: [spelled(b"{v:'1}")], carried: [], fns: [] },
        ],
        [],
      ),
    },
    // `outer` hands its variable inside a list, which no layout reads.
    {
      key: b"m.outer",
      value: generic_body(
        [
          {
            callee: Named(b"m.wrap"),
            args: [spelled(b"List<_>"), spelled(b"'0")],
            carried: [],
            fns: [],
          },
        ],
        [],
      ),
    },
    { key: b"m.same", value: generic_body([], [{ var: 0, reads: Exact }]) },
    // `each` hands its variable inside a list to `same`, which reads the whole of it.
    {
      key: b"m.each",
      value: generic_body(
        [{ callee: Named(b"m.same"), args: [spelled(b"List<'0>")], carried: [], fns: [] }],
        [],
      ),
    },
  ]);
  let closed = closed_needs(answers, Map::new());
  assert_eq(
    closed.get(def_root(b"m.wrap")),
    Some([{ var: 0, reads: Scalar }, { var: 1, reads: Layout }]),
  );
  assert_eq(closed.get(def_root(b"m.outer")), Some([{ var: 0, reads: Layout }]));
  assert_eq(closed.get(def_root(b"m.each")), Some([{ var: 0, reads: Exact }]))
}

test "a generic body whose needs or its callees' read a variable's layout or type is settled by its callers" {
  let answers = by_def([
    { key: b"m.add", value: generic_body([], [{ var: 0, reads: Scalar }]) },
    { key: b"m.lay", value: generic_body([], [{ var: 0, reads: Layout }]) },
    { key: b"m.same", value: generic_body([], [{ var: 0, reads: Exact }]) },
    // `each` reads nothing itself, but hands its variable to `same`.
    {
      key: b"m.each",
      value: generic_body(
        [{ callee: Named(b"m.same"), args: [spelled(b"List<'0>")], carried: [], fns: [] }],
        [],
      ),
    },
    { key: b"m.main", value: generic_body([], []) },
  ]);
  let unemitted = settled_only(answers, Map::new(), closed_needs(answers, Map::new()));
  assert_eq(unemitted.keys(), [b"m.each", b"m.lay", b"m.same"].map(def_root));
  // A specialisation is emitted at its type arguments, whatever its definition needs.
  let had = keyed([
    { key: at_key(b"m.same", [spelled(b"Int")], []), value: generic_body([], []) },
    { key: Named(b"m.same"), value: generic_body([], [{ var: 0, reads: Exact }]) },
  ]);
  let kept = settled_bodies(had.answers, had.keys, settled_only(had.answers, had.keys, Map::new()));
  assert_eq(
    kept.keys().map(|n: RootName|
      match kept.get(n) { Some(Refused(_)) -> b"refused", _ -> b"body" }),
    [b"refused", b"body"],
  );
  // One still reading a variable's type was settled on what leaves it open.
  let open = keyed([
    {
      key: at_key(b"m.same", [unknown_type()], []),
      value: generic_body([], [{ var: 0, reads: Exact }]),
    },
  ]);
  let said = handle {
    settled_bodies(open.answers, open.keys, Map::new());
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert(said.index_of(b"still reads a type variable's layout or type") != None, None)
}

test "a body calling one its callers settle, on no type arguments, is dropped as an error whatever was offered" {
  let calling = Body({ text: b"", tables: { ..no_tables(), calls: [Named(b"m.same")] } });
  let answers = by_def([
    { key: b"m.main", value: calling },
    { key: b"m.same", value: Refused({ why: settled_why() }) },
  ]);
  let s = settle(answers, [def_root(b"m.main")], []);
  assert_eq(s.taken, []);
  assert_eq(s.dropped.map(|d: Dropped| { function: d.function, missing: d.missing }), [
    { function: def_root(b"m.main"), missing: None },
  ]);
  assert(s.dropped.all(|d: Dropped| d.construct.index_of(settled_why()) != None), None);
  assert_eq(fatal([], s.dropped).len(), 1)
}

test "a call of a generic tail loop at a type settles on the loop at it, whichever member it calls" {
  let source = Bytes::concat_all([
    b"fn ping<a>(x: a, n: Int) -> a = if n <= 0 { x } else { pong(x, n - 1) }\n",
    b"fn pong<a>(x: a, n: Int) -> a = if n <= 0 { x } else { ping(x, n - 1) }\n",
    b"fn go() -> Float = ping(1.5, 3)\n",
    b"fn back() -> String = pong(\"s\", 3)\n",
  ]);
  let dump = dump_of(analyse(parse_all([{ name: b"m", src: source }])));
  match emitted(
      a_runtime(b"r"),
      dump,
      [source],
      Map::new(),
      [Named(b"m.go"), Named(b"m.back")],
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(why) -> panic(String::of_bytes_lossy(why)),
    Ok(e) -> {
      assert_eq(e.produced.dropped.map(|d: Dropped| d.function), []);
      // Each call reaches its loop at the type it settled, and neither reaches the loop as it
      // stands.
      assert_eq(
        [b"m.ping@Float", b"m.pong@String", b"m.ping", b"m.pong"].filter(|n: Bytes|
          e.produced.taken.map(root_text).contains(n)),
        [b"m.ping@Float", b"m.pong@String"],
      )
    },
  }
}

test "a definition's hash is read under its own name, or under `compiler.` where the program ships the compiler" {
  assert_eq(definition_hash(some_definitions(), b"unit.emitted"), Some(b"aa"));
  assert_eq(definition_hash(some_definitions(), b"front.seam.view_dump"), Some(b"bb"));
  assert_eq(definition_hash(some_definitions(), b"unit.emitted_twice"), Some(b"dd"));
  assert_eq(definition_hash(b"unit.emitted cc", b"unit.emitted"), Some(b"cc"));
  assert_eq(definition_hash(some_definitions(), b"emitted"), None);
  assert_eq(definition_hash(some_definitions(), b"unit.emit"), None)
}

test "an identity moves with the hash of a root it names, and with no other definition's" {
  let roots = [b"unit.emitted", b"front.seam.view_dump"];
  let one = identity_of(some_definitions(), roots);
  assert_eq(
    identity_of(
      b"compiler.unit.emitted aa\nfront.seam.view_dump bb\nunit.emitted_twice ee\nzeta.new ff\n",
      roots,
    ),
    one,
  );
  assert(
    identity_of(b"compiler.unit.emitted aa\nfront.seam.view_dump b0\n", roots) != one,
    Some("a root's hash moved and the identity did not"),
  );
  assert(identity_of(some_definitions(), [b"unit.emitted"]) != one, None)
}

fn a_runtime(identity: Bytes) -> Runtime =
  { head: b"", tail: b"", helpers: [], natives: [], layouts: layouts(), identity: identity }

fn a_builder(main: Bytes) -> Bytes = Bytes::concat_all([b"build.main ", main, b"\nbuild.told e5\n"])

test "a program's key moves with the definition it enters, the runtime and the builder, and with nothing else" {
  let key = program_key(b"entry", a_runtime(b"rt"), a_builder(b"c3"));
  assert_eq(key.len(), 64);
  assert_eq(
    program_key(b"entry", a_runtime(b"rt"), a_builder(b"c3").concat(b"other.one f6\n")),
    key,
  );
  assert(program_key(b"other", a_runtime(b"rt"), a_builder(b"c3")) != key);
  assert(program_key(b"entry", a_runtime(b"tr"), a_builder(b"c3")) != key);
  assert(program_key(b"entry", a_runtime(b"rt"), a_builder(b"c4")) != key)
}

test "a line of what a unit says of itself is cut into literals a compiler takes, its newline last" {
  assert_eq(literal_lines(b""), b"\"\" \"\\n\"\n");
  let long = Bytes::concat_all(range(0, 2001).map(|_: Int| b"x"));
  let pieces = literal_lines(long).split(b"\n");
  assert_eq(pieces.len(), 3);
  assert_eq(pieces.get(0).len(), 2002);
  assert_eq(pieces.get(1), b"  \"x\" \"\\n\"")
}

test "lines are read as a final newline ends the last one" {
  assert_eq(split_lines(b"a\nb\n"), [b"a", b"b"]);
  assert_eq(split_lines(b"a\r\n\nb"), [b"a", b"", b"b"])
}

test "a body dropped for a callee never offered is the offer's doing, and so is its fallout" {
  let dropped = [
    { function: def_root(b"m.a"), construct: b"why", missing: None },
    { function: def_root(b"m.b"), construct: b"lost", missing: Some(def_root(b"m.out")) },
    { function: def_root(b"m.c"), construct: b"lost", missing: Some(def_root(b"m.b")) },
    { function: def_root(b"m.d"), construct: b"lost", missing: Some(def_root(b"m.a")) },
  ];
  assert_eq(
    fatal([b"m.a", b"m.b", b"m.c", b"m.d"].map(def_root), dropped).map(|d: Dropped| d.function),
    [def_root(b"m.a"), def_root(b"m.d")],
  )
}

/// A body of root `name` calling `calls` and naming a static of its own.
fn one_body(name: Bytes, calls: List<Bytes>) -> Answer / {abort.raise} = {
  let own = statics_of(SStr(name));
  Body({
    text: Bytes::concat_all([
      b"Word f_",
      name,
      b"(PlyCtx *ctx) { return (Word)(intptr_t)&",
      own.get(0).name,
      b" + @@r@@; }",
    ]),
    tables: {
      ..no_tables(),
      statics: own,
      calls: calls.map(Named),
      symbols: [{ symbol: b"f_".concat(name), entry: b"e_".concat(name), head: word_head(0) }],
    },
  })
}

/// `a` publishing `head` as its definition's.
fn headed(a: Answer, head: Head) -> Answer =
  match a {
    Body(b) ->
      Body({
        ..b,
        tables: { ..b.tables, symbols: b.tables.symbols.map(|d: Defined| { ..d, head: head }) },
      }),
    other -> other,
  }

/// `one_body` with other text, as an edit to its definition would make it.
fn edited_body(name: Bytes) -> Answer / {abort.raise} =
  match one_body(name, []) {
    Body(b) -> Body({ ..b, text: b.text.concat(b"\n/* edited */") }),
    other -> other,
  }

/// The codes of a unit over `answers`, offering `constants` as constants and the rest as calls, by
/// the names of the definitions they are of.
fn codes_over(
  answers: List<{ key: Bytes, value: Answer }>,
  offered: List<Bytes>,
  constants: List<Bytes>,
) -> Map<Bytes, Bytes> / {abort.raise} =
  codes(
    produce(
      a_runtime(b"r"),
      [],
      offered.map(|n: Bytes| { ..offer(n, 0), constant: constants.contains(n) }),
      1,
      by_def(answers),
      Map::new(),
    ).made,
  ).fold(Map::new(), |m: Map<Bytes, Bytes>, n: RootName, code: Bytes| m.insert(root_text(n), code))

test "a root's code moves with every body it can call, and with no other" {
  let program = |g: Answer|
    codes_over(
      [
        { key: b"m.f", value: one_body(b"m.f", [b"m.g"]) },
        { key: b"m.g", value: g },
        { key: b"m.h", value: one_body(b"m.h", []) },
      ],
      [b"m.f", b"m.g", b"m.h"],
      [],
    );
  let before = program(one_body(b"m.g", []));
  let after = program(edited_body(b"m.g"));
  assert(before.get(b"m.f") != after.get(b"m.f"), None);
  assert(before.get(b"m.g") != after.get(b"m.g"), None);
  assert_eq(before.get(b"m.h"), after.get(b"m.h"));
  assert(before.get(b"m.f") != before.get(b"m.h"), None)
}

// The checker decides which roots are constants, and the unit holds a constant where it would call
// a root, so the same bodies offered otherwise are other code.
test "a root's code moves with how it and its callees were offered" {
  let program = |constants: List<Bytes>|
    codes_over(
      [
        { key: b"m.f", value: one_body(b"m.f", [b"m.g"]) },
        { key: b"m.g", value: one_body(b"m.g", []) },
        { key: b"m.h", value: one_body(b"m.h", []) },
      ],
      [b"m.f", b"m.g", b"m.h"],
      constants,
    );
  let called = program([]);
  let held = program([b"m.g"]);
  assert(called.get(b"m.g") != held.get(b"m.g"), None);
  assert(called.get(b"m.f") != held.get(b"m.f"), None);
  assert_eq(called.get(b"m.h"), held.get(b"m.h"))
}

test "a cycle is digested whole, whatever order the unit holds its roots in" {
  let cycle = |b: Answer, order: List<Bytes>|
    codes_over(
      [{ key: b"m.a", value: one_body(b"m.a", [b"m.b"]) }, { key: b"m.b", value: b }],
      order,
      [],
    );
  let one = cycle(one_body(b"m.b", [b"m.a"]), [b"m.a", b"m.b"]);
  assert_eq(cycle(one_body(b"m.b", [b"m.a"]), [b"m.b", b"m.a"]), one);
  assert(one.get(b"m.a") != one.get(b"m.b"), None);
  let edited = match edited_body(b"m.b") {
    Body(b) -> Body({ ..b, tables: { ..b.tables, calls: [Named(b"m.a")] } }),
    other -> other,
  };
  assert(cycle(edited, [b"m.a", b"m.b"]).get(b"m.a") != one.get(b"m.a"), None)
}

// A body names a constructor's tag by the constructor, so the same answer serves programs whose
// tables differ, and each unit writes the position its own table gives.
test "a constructor's tag is its bucket's to read, at the position the unit's own table gives it" {
  let runtime = a_runtime(b"r");
  let answer = Body({
    text: b"Word f_m.f(PlyCtx *ctx) { return @@Tm.Line@@ + @@TNone@@; }",
    tables: { ..no_tables(), symbols: [{ symbol: b"f_m.f", entry: b"e_m.f", head: word_head(0) }] },
  });
  let unit = |ctors: List<Ctor>|
    produce(
      runtime,
      ctors,
      [offer(b"m.f", 0)],
      1,
      by_def([{ key: b"m.f", value: answer }]),
      Map::new(),
    ).text;
  let alone = unit([
    { name: b"None", arity: 0 },
    { name: b"m.Dot", arity: 0 },
    { name: b"m.Line", arity: 1 },
  ]);
  let beside = unit([
    { name: b"None", arity: 0 },
    { name: b"a.One", arity: 0 },
    { name: b"a.Two", arity: 0 },
    { name: b"m.Dot", arity: 0 },
    { name: b"m.Line", arity: 1 },
  ]);
  let table = bucket_table(def_bucket(b"m.f"));
  let body = Bytes::concat_all([b"{ return ", table, b"[1] + ", table, b"[0]; }"]);
  assert(alone.index_of(body) != None, None);
  assert(beside.index_of(body) != None, None);
  // The bucket declares the table, and the unit lays it out filled beside its descriptor.
  let declared = Bytes::concat_all([b"extern const uint32_t ", table, b"[];\n"]);
  assert(bucket_part(alone, def_bucket(b"m.f")).index_of(declared) != None, None);
  let filled = |places: Bytes|
    Bytes::concat_all([b"const uint32_t ", table, b"[] = {", places, b" };\n"]);
  assert(alone.index_of(filled(b" 0, 2,")) != None, None);
  assert(beside.index_of(filled(b" 0, 4,")) != None, None)
}

/// A bucket's part of a unit's C: from its mark to the next part's.
fn bucket_part(unit: Bytes, id: Int) -> Bytes / {abort.raise} =
  match unit.index_of(bucket_mark(id)) {
    None -> b"",
    Some(start) -> match unit.index_of_from(b"/* --- ", start + 1) {
      Some(end) -> unit.slice(start, end),
      None -> unit.slice(start, unit.len()),
    },
  }

test "a bucket's C reads the same whatever another bucket adds to the unit's tables" {
  let runtime = { ..a_runtime(b"r"), head: b"/* head */\n", tail: b"/* --- the runtime --- */\n" };
  let other = range(0, 4096).fold(b"", |found: Bytes, i: Int| {
    let n = b"a.other".concat(ascii_of_int(i));
    if found == b"" && def_bucket(n) != def_bucket(b"m.f") { n } else { found }
  });
  let unit = |names: List<Bytes>|
    produce(
      runtime,
      [{ name: b"None", arity: 0 }],
      names.map(|n: Bytes| offer(n, 0)),
      1,
      by_def(names.map(|n: Bytes| { key: n, value: one_body(n, []) })),
      Map::new(),
    ).text;
  let alone = unit([b"m.f"]);
  let beside = unit([b"m.f", other]);
  assert(bucket_part(alone, def_bucket(b"m.f")) != b"", None);
  assert_eq(bucket_part(beside, def_bucket(b"m.f")), bucket_part(alone, def_bucket(b"m.f")));
  // What moved is the rest of the unit: `other`'s bucket and the static its body names.
  assert(alone != beside, None)
}

test "a root whose entry the unit takes is listed as entered, and one whose entry it dropped is not" {
  let entry = |n: Bytes| root_name(Entered(Named(n)));
  let offered = |n: RootName| { name: n, arity: 0, constant: false, site: n };
  let p = produce(
    a_runtime(b"r"),
    [],
    [def_root(b"m.f"), def_root(b"m.g"), entry(b"m.f"), entry(b"m.g")].map(offered),
    1,
    Map::of_entries([
      { key: def_root(b"m.f"), value: one_body(b"m.f", []) },
      { key: def_root(b"m.g"), value: one_body(b"m.g", []) },
      { key: entry(b"m.f"), value: one_body(root_text(entry(b"m.f")), [b"m.f"]) },
      { key: entry(b"m.g"), value: Refused({ why: b"no entry for it" }) },
    ]),
    Map::new(),
  );
  assert(p.taken.contains(entry(b"m.f")), None);
  assert(p.text.index_of(b"entered m.f") != None, None);
  assert_eq(p.text.index_of(b"entered m.g"), None);
  // An entry the unit asked for and did not get fails the build, naming its root.
  assert_eq(fatal([def_root(b"m.f"), def_root(b"m.g")], p.dropped).map(|d: Dropped| d.function), [
    entry(b"m.g"),
  ])
}

test "every part of a unit compiles after the runtime's head and then the emitter's" {
  let p = produce(
    { ..a_runtime(b"r"), head: b"/* head */\n", tail: b"/* tail */\n" },
    [],
    [offer(b"m.f", 0)],
    1,
    by_def([{ key: b"m.f", value: one_body(b"m.f", []) }]),
    Map::new(),
  );
  let head = match p.text.index_of(b"/* --- bucket ") {
    Some(at) -> p.text.slice(0, at),
    None -> b"",
  };
  assert(head.starts_with(b"/* head */\n".concat(head_part())), None)
}

/// The first of `prefix` and a number whose bucket is none of `others'`.
fn bucket_apart(prefix: Bytes, others: List<Bytes>) -> Bytes =
  range(0, 4096).fold(b"", |found: Bytes, i: Int| {
    let n = prefix.concat(ascii_of_int(i));
    let free = others.fold(true, |ok: Bool, o: Bytes| ok && def_bucket(o) != def_bucket(n));
    if found == b"" && free { n } else { found }
  })

// A bucket is compiled alone, so it declares what its bodies call at the width each is taken at,
// and nothing else; and a body sits once, in the bucket its name alone decides.
test "a bucket holds the bodies its names decide and declares what they reach, and nothing else" {
  let caller = b"m.caller";
  let callee = bucket_apart(b"m.callee", [caller]);
  let apart = bucket_apart(b"m.apart", [caller, callee]);
  let p = produce(
    { ..a_runtime(b"r"), head: b"/* head */\n", tail: b"/* tail */\n" },
    [],
    [offer(caller, 0), offer(callee, 2), offer(apart, 0)],
    1,
    by_def([
      { key: caller, value: one_body(caller, [callee]) },
      { key: callee, value: headed(one_body(callee, []), word_head(2)) },
      { key: apart, value: one_body(apart, []) },
    ]),
    Map::new(),
  );
  let declares = |part: Bytes, name: Bytes, arity: Int|
    part.index_of(prototype(b"f_".concat(name), word_head(arity))) != None;
  let calling = bucket_part(p.text, def_bucket(caller));
  assert(
    declares(calling, caller, 0) && declares(calling, callee, 2),
    Some(String::of_bytes_lossy(calling)),
  );
  assert(!declares(calling, apart, 0), Some(String::of_bytes_lossy(calling)));
  let alone = bucket_part(p.text, def_bucket(apart));
  assert(
    !declares(alone, caller, 0) && !declares(alone, callee, 2),
    Some(String::of_bytes_lossy(alone)),
  );
  let head = match p.text.index_of(b"/* --- bucket ") {
    Some(at) -> p.text.slice(0, at),
    None -> p.text,
  };
  [caller, callee, apart].fold((), |u: Unit, name: Bytes| {
    let defined = Bytes::concat_all([b"Word f_", name, b"(PlyCtx *ctx)"]);
    assert_eq(p.text.split(defined).len() - 1, 1);
    assert_eq(bucket_part(p.text, def_bucket(name)).split(defined).len() - 1, 1);
    assert(head.index_of(b"f_".concat(name)) == None, None)
  })
}

test "where the head defines `PLY_FAR` a bucket calls what another defines through its table, and its own directly" {
  let caller = b"m.caller";
  let callee = bucket_apart(b"m.callee", [caller]);
  let p = produce(
    { ..a_runtime(b"r"), head: b"/* head */\n", tail: b"/* tail */\n" },
    [],
    [offer(caller, 0), offer(callee, 2)],
    1,
    by_def([
      { key: caller, value: one_body(caller, [callee]) },
      { key: callee, value: headed(one_body(callee, []), word_head(2)) },
    ]),
    Map::new(),
  );
  let calling = bucket_part(p.text, def_bucket(caller));
  let shown = Some(String::of_bytes_lossy(calling));
  let table = far_table(def_bucket(caller));
  let opened = calling.index_of(
    Bytes::concat_all([
      b"#ifdef PLY_FAR\nstatic void *const ",
      table,
      b"[] = { (void *)&f_",
      callee,
      b", 0 };\n#define f_",
      callee,
      b"(...) ((Word (*)(PlyCtx*, Word, Word))",
      table,
      b"[0])(__VA_ARGS__)\n#endif\n",
    ]),
  );
  let defined = calling.index_of(Bytes::concat_all([b"Word f_", caller, b"(PlyCtx *ctx)"]));
  let ended = calling.index_of(
    Bytes::concat_all([b"#ifdef PLY_FAR\n#undef f_", callee, b"\n#endif\n"]),
  );
  match ((opened, defined, ended)) {
    (Some(o), Some(d), Some(x)) -> assert(o < d && d < x, shown),
    _ -> assert(false, shown),
  };
  assert(calling.index_of(b"#define f_".concat(caller)) == None, shown);
  assert(bucket_part(p.text, def_bucket(callee)).index_of(b"PLY_FAR") == None, None)
}

// A call written to another head than its callee's is C two compilers disagree over silently, as
// a `Word` and an `int64_t` are one type; the unit refuses it instead.
test "specialisations alike but for their names are one root" {
  let body = |k: RootKey, other: Bytes| {
    let name = printed(k);
    Body({
      text: Bytes::concat_all([
        b"Word ",
        symbol_of(name),
        b"(PlyCtx *ctx) { return ",
        other,
        b"; }",
      ]),
      tables: {
        ..no_tables(),
        calls: [k],
        symbols: [{ symbol: symbol_of(name), entry: entry_of(name), head: word_head(0) }],
      },
    })
  };
  let at = |def: Bytes, arg: Bytes| {
    let k = at_key(def, [spelled(arg)], []);
    { key: k, value: body(k, if arg == b"U8" { b"1" } else { b"0" }) }
  };
  let had = keyed([at(b"m.f", b"Int"), at(b"m.f", b"Bool"), at(b"m.f", b"U8"), at(b"m.g", b"Int")]);
  assert_eq(alike(had.answers, had.keys).entries(), [
    {
      key: root_name(at_key(b"m.f", [spelled(b"Int")], [])),
      value: root_name(at_key(b"m.f", [spelled(b"Bool")], [])),
    },
  ])
}

test "a call written to another head than the callee defines fails the unit" {
  let caller = b"m.caller";
  let callee = b"m.callee";
  let expecting = |head: Head|
    match one_body(caller, [callee]) {
      Body(b) ->
        Body({
          ..b,
          tables: {
            ..b.tables,
            // The callee by its place among the caller's calls, which `one_body` gives it.
            generics: { ..no_generics(), expects: [{ callee: CallAt(0), head: head }] },
          },
        }),
      other -> other,
    };
  let made = |head: Head|
    try[abort.raise] {
      produce(
        a_runtime(b"r"),
        [],
        [offer(caller, 0), offer(callee, 1)],
        1,
        by_def([
          { key: caller, value: expecting(head) },
          {
            key: callee,
            value: headed(one_body(callee, []), { answer: b"double", params: [b"double"] }),
          },
        ]),
        Map::new(),
      ).taken
    };
  assert_eq(made({ answer: b"double", params: [b"double"] }), Ok([callee, caller].map(def_root)));
  match made(word_head(1)) {
    Ok(_) -> assert(false, Some("a call to another head was taken")),
    Err(why) ->
      assert(
        Bytes::of_string(why).index_of(b"which it defines as double f_m.callee(PlyCtx*, double)")
          != None,
        Some(why),
      ),
  }
}

/// The unit over `answers`, each root offered as a call, compiled against a runtime whose definitions
/// are marked, so a test can tell the buckets from the tail.
fn unit_of(
  answers: List<{ key: Bytes, value: Answer }>,
  inputs: Map<Bytes, Bytes>,
) -> Produced / {abort.raise} =
  produce(
    { ..a_runtime(b"r"), head: b"/* head */\n", tail: b"/* --- the runtime --- */\n" },
    [],
    answers.map(|a: { key: Bytes, value: Answer }| offer(a.key, 0)),
    1,
    by_def(answers),
    inputs,
  )

/// `a` naming `defs` beside its own statics.
fn naming(a: Answer, defs: List<StaticDef>) -> Answer =
  match a {
    Body(b) -> Body({ ..b, tables: { ..b.tables, statics: b.tables.statics.concat(defs) } }),
    other -> other,
  }

/// The part of unit `text` after the runtime's mark: the runtime's definitions and the unit's own.
fn tail_of(text: Bytes) -> Bytes / {abort.raise} =
  match text.index_of(b"/* --- the runtime --- */") {
    Some(at) -> text.slice(at, text.len()),
    None -> b"",
  }

test "a static two bodies name is defined once, in the tail, and declared by each bucket that names it" {
  let shared = statics_of(SStr(b"shared-constant"));
  let name = shared.get(0).name;
  let one = b"m.one";
  let two = bucket_apart(b"m.two", [one]);
  let apart = bucket_apart(b"m.apart", [one, two]);
  let p = unit_of(
    [
      { key: one, value: naming(one_body(one, []), shared) },
      { key: two, value: naming(one_body(two, []), shared) },
      { key: apart, value: one_body(apart, []) },
    ],
    Map::new(),
  );
  let defined = Bytes::concat_all([b"const struct ", name, b" {"]);
  assert_eq(p.text.split(defined).len() - 1, 1);
  assert(tail_of(p.text).index_of(defined) != None, None);
  let declares = |id: Int| bucket_part(p.text, id).index_of(static_extern(name)) != None;
  assert_eq([one, two, apart].map(|n: Bytes| declares(def_bucket(n))), [true, true, false]);
  // No pool: the unit says nothing of its constants to its loader.
  assert(p.text.index_of(b"consts ") == None, None)
}

test "an embedded file is laid out once from the bytes the unit is handed, raw" {
  let digest = b"\x00\xff".blake3();
  let file = [named(SFile(digest))];
  let p = unit_of(
    [
      { key: b"m.f", value: naming(one_body(b"m.f", []), file) },
      { key: b"m.g", value: naming(one_body(b"m.g", []), file) },
    ],
    Map::new().insert(digest, b"\x00\xff"),
  );
  let laid = tail_of(p.text);
  assert_eq(laid.split(b"\"\\000\\377\"").len() - 1, 1);
  assert(laid.index_of(b".len = 2, .layout = 2") != None, None)
}

test "two statics of one name holding different content stop the unit" {
  let a = statics_of(SStr(b"a")).get(0);
  let forged = { name: a.name, laid: statics_of(SStr(b"b")).get(0).laid };
  let said = handle {
    unit_of(
      [
        { key: b"m.f", value: naming(one_body(b"m.f", []), [a]) },
        { key: b"m.g", value: naming(one_body(b"m.g", []), [forged]) },
      ],
      Map::new(),
    );
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert(said.starts_with(b"two statics of one name hold different content"), None)
}

test "a kept body stands only where each callee it names still has the key it was filed with" {
  let keys = by_def([{ key: b"m.b", value: b"kb" }]);
  let body = one_body(b"m.a", [b"m.b"]);
  let filed = kept_of(keys, body);
  // The body names each root it calls by its key's digest, which the store keeps once.
  let resolved = match body {
    Body(b) ->
      b.tables.calls.fold(Map::new(), |m: Map<Bytes, RootKey>, k: RootKey|
        m.insert(key_digest(k), k)),
    Refused(_) -> Map::new(),
  };
  assert_eq(filed.callees, [Some(b"kb")]);
  assert(filed.calls.len() == 1 && filed.calls.all(|d: Bytes| d.len() == 32), None);
  assert_eq(standing_kept(keys, resolved, filed), Some(body));
  // Another tree's callee that hashes alike under another name: the C would call a name not here.
  assert_eq(standing_kept(by_def([{ key: b"m.c", value: b"kb" }]), resolved, filed), None);
  assert_eq(standing_kept(by_def([{ key: b"m.b", value: b"another" }]), resolved, filed), None);
  // A root it calls that the store keeps no more: the body is asked for again.
  assert_eq(standing_kept(keys, Map::new(), filed), None)
}

fn three_modules() -> List<Bytes> =
  [
    b"import b\nimport c\nfn f(x: Int) -> Int = b::g(x) + c::h(x)\n",
    b"import c\npub fn g(x: Int) -> Int = c::h(x) * 2\n",
    Bytes::concat_all([
      b"pub fn h(x: Int) -> Int = if even(x) { x } else { x + 1 }\n",
      b"fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n",
      b"fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n",
    ]),
  ]

fn three_modules_dump() -> Dump / {abort.raise} = {
  let texts = three_modules();
  dump_of(
    analyse(
      parse_all([
        { name: b"a", src: texts.get(0) },
        { name: b"b", src: texts.get(1) },
        { name: b"c", src: texts.get(2) },
      ]),
    ),
  )
}

test "roots written for types are dealt apart, however many one module writes" {
  let p = program_of(three_modules_dump(), three_modules());
  let written = range(0, pieces()).map(|i: Int|
    keys::written(keys::Drop, spelled(b"a.T".concat(ascii_of_int(i))), b"a"));
  let lists = dealt(p, written.push(Named(b"a.f")));
  assert_eq(lists.len(), pieces());
  assert_eq(lists.fold(0, |n: Int, roots: List<RootKey>| n + roots.len()), pieces() + 1)
}

test "a module's definitions are dealt together, its specialisations by their definitions, each once" {
  let dump = three_modules_dump();
  let p = program_of(dump, three_modules());
  let at = |def: Bytes, lent: List<FnArg>| at_key(def, [string_type()], lent);
  let lent = at(b"c.even", [{ param: 0, owner: Named(b"b.g"), nth: 0 }]);
  let missed = offered_roots(dump).keys.concat([at(b"c.h", []), at(b"c.odd", []), lent]);
  let lists = dealt(p, missed);
  // Fewer of them than pieces: a list each module's definitions, one each definition's
  // specialisations, and a specialisation running a lambda in place with its lender's module.
  assert_eq(lists.len(), ordered(missed.map(dealt_with)).len());
  assert_eq(dealt_with(lent), b"b");
  assert_eq(dealt_with(Named(b"c.odd")), dealt_with(Named(b"c.even")));
  assert(dealt_with(at(b"c.h", [])) != dealt_with(at(b"c.odd", [])), None);
  assert_eq(
    names_ordered(
      lists.fold([], |acc: List<RootName>, roots: List<RootKey>| acc.concat(roots.map(root_name))),
    ),
    names_ordered(missed.map(root_name)),
  );
  let together = |roots: List<RootKey>| ordered(roots.map(dealt_with));
  assert_eq(
    lists.fold(0, |n: Int, roots: List<RootKey>| n + together(roots).len()),
    together(missed).len(),
  );
  let many = range(0, 3 * pieces()).map(|i: Int|
    Named(Bytes::concat_all([b"m", ascii_of_int(i), b".f"])));
  assert_eq(dealt(p, many).len(), pieces())
}

test "a root's kept answer moves with what its module embeds, and with no other module's" {
  let dump = three_modules_dump();
  let embedding = |bytes: Bytes|
    program_of(
      {
        ..dump,
        embeds: [{ module: b"c", key: b"file:data.txt", read: Ok([embed_file(b"", bytes)]) }],
      },
      three_modules(),
    );
  let one = root_material(embedding(b"one"), b"", Named(b"c.h"));
  assert(one != None, None);
  assert(one != root_material(embedding(b"two"), b"", Named(b"c.h")), None);
  assert_eq(
    root_material(embedding(b"one"), b"", Named(b"a.f")),
    root_material(program_of(dump, three_modules()), b"", Named(b"a.f")),
  );
  // A specialisation's moves with its definition's, and with what each lender of a lambda it runs.
  let spec = |p: Program, lender: Bytes|
    root_material(p, b"", at_key(b"c.h", [], [{ param: 0, owner: Named(lender), nth: 0 }]));
  assert(spec(embedding(b"one"), b"a.f") != spec(embedding(b"two"), b"a.f"), None);
  assert(spec(embedding(b"one"), b"a.f") != spec(embedding(b"one"), b"b.g"), None)
}

/// A program of module `s`, declaring `E` as `cases`, and module `g`, a definition generic over its
/// list's items.
fn declaring(cases: Bytes) -> Program / {abort.raise} = {
  let texts = [
    Bytes::concat_all([b"pub type E = ", cases, b"\n"]),
    b"pub fn first<a>(xs: List<a>) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }\n",
  ];
  program_of(
    dump_of(
      analyse(parse_all([{ name: b"s", src: texts.get(0) }, { name: b"g", src: texts.get(1) }])),
    ),
    texts,
  )
}

test "a specialisation's kept answer moves with the declaration of a type it is at, not its name alone" {
  let at = |p: Program, t: Type| root_material(p, b"", at_key(b"g.first", [t], []));
  let e = TyCon({ name: b"s.E", args: [] });
  let two = declaring(b"| A | B");
  let three = declaring(b"| A | B | C");
  assert(at(two, e) != None, None);
  assert(at(two, e) != at(three, e), None);
  assert_eq(at(two, e), at(declaring(b"| A | B"), e));
  // A type no program declares is no part of it.
  let int = TyCon({ name: b"Int", args: [] });
  assert_eq(at(two, int), at(three, int))
}

test "a root written from a type is kept under its module's text and the program's types" {
  let dump = three_modules_dump();
  let p = program_of(dump, three_modules());
  let types = types_material(dump);
  let reflected = keys::written(keys::Reflect, spelled(b"{x:Int}"), b"a");
  let kept = root_material(p, types, reflected);
  assert(kept != None, None);
  assert(kept == root_material(p, types, reflected), None);
  // Another constructor anywhere, or another text of its module, moves it; a root of no module's
  // text has none.
  assert(kept != root_material(p, types_material({ ..dump, ctors: [] }), reflected), None);
  assert(
    kept
      != root_material(
        program_of(dump, three_modules().map(|s: Bytes| s.concat(b"\n"))),
        types,
        reflected,
      ),
    None,
  );
  assert_eq(
    root_material(p, types, keys::written(keys::Reflect, spelled(b"{x:Int}"), b"nowhere")),
    None,
  )
}

test "a call written against a handing its callee does not publish fails the build, naming both" {
  let handing = |def: Bytes, lent: List<Bool>| { def: def_root(def), lent: lent, borrowed: None };
  let body = |handings: List<Published>, assumed: List<Published>|
    Body({ text: b"", tables: { ..no_tables(), handings: handings, assumed: assumed } });
  // The callee publishes its parameter given; one caller was written lending it.
  let answers = by_def([
    { key: b"m.caller", value: body([], [handing(b"m.callee", [true])]) },
    { key: b"m.callee", value: body([handing(b"m.callee", [false])], []) },
    { key: b"m.fine", value: body([], [handing(b"m.callee", [false])]) },
    { key: b"m.alone", value: body([], [handing(b"m.unpublished", [false])]) },
  ]);
  let wrong = misassumed_in(answers, answers.keys());
  assert_eq(wrong.map(|m: Misassumed| m.caller), [def_root(b"m.caller")]);
  let dump = dump_of(analyse(parse_all([{ name: b"m", src: b"fn one() -> Int = 1\n" }])));
  let e = {
    produced: { text: b"", taken: [], dropped: [], made: { bodies: [], offered: [] } },
    kept: 0,
    asked: 0,
    unbound: [],
    misassumed: wrong,
    scope: None,
  };
  match held(dump, [], Ok(e)) {
    Ok(_) -> assert(false, Some("a unit holding a call against the wrong handing was held")),
    Err(diags) -> {
      assert_eq(diags.map(|d: Diag| d.code), [b"E0478"]);
      assert_eq(diags.get(0).notes_text, [
        b"`m.caller` calls `m.callee` written [lent] owned, where it publishes [given] owned",
      ])
    },
  }
}

test "a body written against a handing that moved is asked for again, with its recursion group" {
  let handing = |def: Bytes, lent: List<Bool>| { def: def_root(def), lent: lent, borrowed: None };
  let body = |handings: List<Published>, assumed: List<Published>, group: List<Bytes>|
    Body({
      text: b"",
      tables: { ..no_tables(), handings: handings, assumed: assumed, group: group.map(Named) },
    });
  let entries = [
    {
      key: b"m.f",
      value: body([handing(b"m.f", [true])], [handing(b"m.h", [true])], [b"m.f", b"m.g"]),
    },
    { key: b"m.g", value: body([handing(b"m.g", [false])], [], [b"m.f", b"m.g"]) },
    { key: b"m.h", value: body([handing(b"m.h", [false])], [], []) },
    { key: b"m.k", value: body([], [handing(b"m.h", [false])], []) },
    // A callee no answer publishes yet is judged once a later round answers it.
    { key: b"m.n", value: body([], [handing(b"m.absent", [true])], []) },
    { key: b"m.o", value: body([], [handing(b"m.absent", [false])], []) },
  ];
  let answers = by_def(entries);
  let keys = by_def(
    entries.map(|x: { key: Bytes, value: Answer }| { key: x.key, value: Named(x.key) }),
  );
  assert_eq(stale_of(answers, handings_held(Map::new(), answers), keys), [
    Named(b"m.f"),
    Named(b"m.g"),
  ]);
  // A kept member of a group another member of which is asked for again goes with it.
  assert_eq(
    groups_whole(answers.remove(def_root(b"m.g")), answers.keys()).keys(),
    [b"m.h", b"m.k", b"m.n", b"m.o"].map(def_root),
  )
}

test "a walk answers the roots it deals over lists, place by place, as the emitter answers them in one" {
  let dump = three_modules_dump();
  let p = program_of(dump, three_modules());
  let missed = offered_roots(dump).keys;
  let scope = scope_over(a_runtime(b"r"), dump, p, [], missed);
  let together = answers_of(answers_in(scope, missed, Map::new()));
  assert(
    together.fold(false, |found: Bool, _: RootName, a: Answer|
      found
        || (match a {
          Body(b) -> b.tables.members == [Named(b"c.even"), Named(b"c.odd")],
          Refused(_) -> false,
        })),
    None,
  );
  // Dealt apart, place by place, a call of a definition another list answers is written against the
  // handing that list published, and no root is asked for twice.
  let walk = walked(
    p,
    types_material(dump),
    program_ctors(dump, []),
    missed,
    |_: Bytes| None,
    |_: List<Record>| (),
    None,
    0,
    |asks: Int, roots: List<RootKey>, handed: Map<RootName, Handing>| {
      let pieces = dealt(p, roots);
      { held: asks + 1, answers: answers_at_once(scope, pieces, 0, pieces.len(), 64, handed) }
    },
  );
  assert(
    together.fold(true, |ok: Bool, n: RootName, a: Answer| ok && walk.answers.get(n) == Some(a)),
    None,
  );
  assert_eq(walk.asked, walk.keys.len());
  // Each module past every module it imports.
  let places = places_of(p);
  assert(
    p.imports.fold(true, |ok: Bool, m: Bytes, xs: List<Bytes>|
      ok
        && xs.all(|d: Bytes|
          match ((places.get(m), places.get(d))) { (Some(a), Some(b)) -> a > b, _ -> true })),
    None,
  )
}

test "a cold unit asks the emitter for each root once, place by place" {
  let dump = three_modules_dump();
  let every = offered_roots(dump).keys;
  // Each place asks for its roots once each: no handing moves under a body already written.
  let paced = {
    now: || 0,
    told: |t: PlaceTally|
      if t.asked == t.roots - t.kept { () } else {
        panic(
          String::of_bytes_lossy(
            Bytes::concat_all([
              b"place ",
              ascii_of_int(t.place),
              b" asked ",
              ascii_of_int(t.asked),
              b" of ",
              ascii_of_int(t.roots),
            ]),
          ),
        )
      },
  };
  let texts = three_modules();
  let sources = sources_placed(
    dump,
    range(0, texts.len()).map(|i: Int| { name: [b"a", b"b", b"c"].get(i), src: texts.get(i) }),
  );
  match emitted(
      a_runtime(b"r"),
      dump,
      sources,
      Map::new(),
      every,
      |_: Bytes| None,
      |_: List<Record>| (),
      [],
      Some(paced),
    ) {
    Ok(e) -> assert_eq((e.kept, e.misassumed), (0, [])),
    Err(why) -> assert_eq(why, b""),
  }
}

/// A chain of `n` modules, each calling the one before it.
fn chained(n: Int) -> List<{ name: Bytes, src: Bytes }> =
  range(0, n).map(|i: Int| {
    let before = b"m".concat(ascii_of_int(i - 1));
    {
      name: b"m".concat(ascii_of_int(i)),
      src: if i == 0 { b"pub fn f(x: Int) -> Int = x + 1\n" } else {
        Bytes::concat_all([
          b"import ",
          before,
          b"\npub fn f(x: Int) -> Int = ",
          before,
          b"::f(x) * 2 + ",
          ascii_of_int(i),
          b"\n",
        ])
      },
    }
  })

/// How many objects the emission of a chain of `n` modules holds live once its walk ends.
fn held_by_walk(n: Int) -> Int / {abort.raise} = {
  let modules = chained(n);
  let dump = dump_of(analyse(parse_all(modules)));
  let sources = sources_placed(dump, modules);
  metered(||
    emitted(
      a_runtime(b"r"),
      dump,
      sources,
      Map::new(),
      offered_roots(dump).keys,
      |_: Bytes| None,
      |_: List<Record>| (),
    )).live
}

test "what a unit's walk holds grows with the program it walks, no faster" {
  let measures = [4, 8, 16, 32].map(|n: Int| { size: n, steps: held_by_walk(n), bound: n });
  assert(!outgrown(measures), Some(f"{measures}"))
}

test "a unit holds a `const` definition as its kept value laid out as static data, its body asked for nothing" {
  let source = Bytes::concat_all([
    b"type Row = { name: String, items: List<Int> }\n",
    b"const fn table() -> List<Int> = spread(3)\n",
    b"const fn row() -> Row = { name: \"r\", items: spread(5) }\n",
    b"const fn names() -> Map<String, Int> = #{\"a\": 1, \"b\": 2}\n",
    b"fn spread(n: Int) -> List<Int> = [n, n + 1]\n",
    b"fn first() -> Int = match table() { [x, ..] -> x, [] -> 0 }\n",
  ]);
  let k = kept_unit(source);
  let encoded = |v: Value| match value::encode(v) { Some(b) -> b, None -> panic("no encoding") };
  let kept = [
    { name: b"m.table", bytes: encoded(VList([VInt(3), VInt(4)])) },
    {
      name: b"m.row",
      bytes: encoded(
        VRecord([
          { name: "items", value: VList([VInt(5), VInt(6)]) },
          { name: "name", value: VStr("r") },
        ]),
      ),
    },
    {
      name: b"m.names",
      bytes: encoded(
        VMap([{ key: VStr("a"), value: VInt(1) }, { key: VStr("b"), value: VInt(2) }]),
      ),
    },
  ];
  let held = k.unit([b"m.table", b"m.row", b"m.names", b"m.first"].map(Named), kept);
  let text = held.produced.text;
  let has = |b: Bytes| text.index_of(b) != None;
  // What a `const` body calls is no part of the unit, and no value is read back from text.
  assert(!held.produced.taken.contains(def_root(b"m.spread")), None);
  assert(!has(b"rt_baked_p") && !has(b"rt_stored_p") && !has(b"rt_constant_p"), None);
  // Each answers from its static data: its entry hands back the value's word, which a read of it
  // neither steps through nor allocates; a record's is the static box of its words.
  [b"m.table", b"m.row", b"m.names"].fold((), |_: Unit, n: Bytes|
    assert(
      has(
        Bytes::concat_all([
          b"Word ",
          symbol_of(n),
          b"_entry(PlyCtx *ctx, const Word *args) {\n  return (Word)(intptr_t)(&ply_k_",
        ]),
      ),
      Some(String::of_bytes_lossy(n)),
    ));
  // The list and the map are laid out as the runtime lays them: a list's items in its tail, a
  // map's pairs in a leaf.
  assert(
    has(b"{ .rc = UINT32_MAX, .kind = 5, .len = 2, .layout = 0, .flags = 2, .aux = 2 }"),
    None,
  );
  assert(has(b"{ .rc = UINT32_MAX, .kind = 13, .len = 2, .layout = 32 }"), None);
  assert(has(b"{ .rc = UINT32_MAX, .kind = 8, .len = 2, .layout = 0 }"), None);
  // A value for a root the unit does not hold is no part of it.
  let apart = k.unit([Named(b"m.spread")], kept);
  assert_eq(apart.produced.text.index_of(symbol_of(b"m.table")), None)
}

test "a kept value its definition's type does not hold stops the unit, naming the definition" {
  let k = kept_unit(b"const fn table() -> List<Int> = [1]\n");
  let stopped = handle {
    let wrong = match value::encode(VStr("x")) { Some(b) -> b, None -> b"" };
    k.unit([Named(b"m.table")], [{ name: b"m.table", bytes: wrong }]);
    ""
  } with {
    abort.raise(m) -> m,
  };
  assert(stopped.index_of("`m.table`") != None, Some(stopped))
}

test "a `const` definition's stored root encodes what its body answers, calling the body itself" {
  let k = kept_unit(
    b"const fn table() -> { n: Int, s: String } = { n: spread(3), s: \"x\" }\nfn spread(n: Int) -> Int = n + 1\n",
  );
  let stored = Stored(Named(b"m.table"));
  let storing = k.unit([Named(b"m.table"), Named(b"m.spread"), stored], []);
  let text = storing.produced.text;
  assert(storing.produced.taken.contains(root_name(stored)), None);
  assert(storing.produced.taken.contains(root_name(Entered(stored))), None);
  // It writes the value's encoding, sharing what it meets again, from a call of the definition's
  // own function rather than a constant's read of it.
  assert(text.index_of(b"lower_open") != None, None);
  assert(text.index_of(symbol_of(b"m.table").concat(b"(ctx")) != None, None);
  assert_eq(text.index_of(b"rt_constant_p"), None);
  assert_eq(text.index_of(b"rt_stored_p"), None);
  // It needs the definition held.
  let alone = k.unit([stored], []);
  assert_eq(alone.produced.dropped.map(|d: Dropped| d.function), [
    root_name(stored),
    root_name(Entered(stored)),
  ]);
  // A stored root and its entry are named as they were before they were keys.
  assert_eq([stored, Entered(stored)].map(printed), [b"m.table#stored", b"m.table#stored#entered"])
}

/// The units over module `m` of `source` and the prelude, whose functions what crosses a value of
/// a container is written over, each over the roots it is handed and the values kept of the `const`
/// definitions it names.
fn kept_unit(
  source: Bytes,
) -> { unit: (List<RootKey>, List<Baked>) -> Emission / {abort.raise} } / {abort.raise} = {
  let user = [{ name: b"m", src: source }];
  let shipped = [{ name: b"std.prelude", src: prelude_source::text() }];
  let modules = user.concat(shipped);
  let dump = dump_of(analyse_pulling_std_with(user, shipped, no_rows()).out);
  let runtime = { ..a_runtime(b"r"), natives: program_natives([]).map(native_of) };
  {
    unit: |every: List<RootKey>, baked: List<Baked>|
      match emitted(
          runtime,
          dump,
          sources_placed(dump, modules),
          Map::new(),
          every,
          |_: Bytes| None,
          |_: List<Record>| (),
          baked,
        ) {
        Ok(e) -> e,
        Err(why) -> panic(String::of_bytes_lossy(why)),
      },
  }
}

test "no root is asked to give back a scalar's box, which its last count gives back by its size" {
  let source = Bytes::concat_all([
    b"effect e {\n  write op(k: Int) -> Float\n}\n",
    b"fn ints(n: Int) -> Int = match [n, n + 1] { [x, ..] -> x, [] -> 0 }\n",
    b"fn floats(x: Float) -> Float = match [x, x] { [y, ..] -> y, [] -> 0.0 }\n",
    b"fn decimals(d: Decimal) -> Int = [d, d].len()\n",
    b"fn wides(w: U128) -> Int = [w].len()\n",
    b"fn held(w: U128) -> Int = [{ a: w, b: \"x\" }].len()\n",
    b"fn performed(n: Int) -> Float / {e.op} = e.op(n)\n",
  ]);
  let dump = dump_of(analyse(parse_all([{ name: b"m", src: source }])));
  let every = [b"m.ints", b"m.floats", b"m.decimals", b"m.wides", b"m.held", b"m.performed"];
  let produced = match emitted(
      a_runtime(b"r"),
      dump,
      [source],
      Map::new(),
      every.map(Named),
      |_: Bytes| None,
      |_: List<Record>| (),
      [],
    ) {
    Ok(e) -> e.produced,
    Err(why) -> panic(String::of_bytes_lossy(why)),
  };
  let taken = produced.taken.map(root_text);
  let drop_at = |ty: Bytes| b"std.prelude.drop#".concat(ty);
  // Each list is let go of through its drop root, which lets go of its items as their types lay them.
  assert_eq(
    [b"List<Int>", b"List<Float>", b"List<Decimal>", b"List<U128>"].filter(|t: Bytes|
      !taken.contains(drop_at(t))),
    [],
  );
  // A perform's descriptors of `Int` and `Float` count and let go of their word forms through the
  // head's functions: no root of any scalar's type is asked, to drop, count or let go of it.
  assert(
    produced.text.index_of(int_released_fn()) != None
      && produced.text.index_of(box_released_fn(1)) != None,
    None,
  );
  assert_eq(
    taken.filter(|n: Bytes|
      [b"Int", b"Float", b"Decimal", b"U128"].any(|t: Bytes|
        [b"drop#", b"dup#", b"release#"].any(|op: Bytes| n.ends_with(op.concat(t))))),
    [],
  )
}

fn native_of(e: Extern) -> Native =
  { name: e.name, words: e.words, answers: declared_answers(e), raises: e.raises }

test "an `extern fn` no native implements, two do, or one does otherwise, is unbound" {
  let declared = |name: Bytes, words: Int, raises: Bool|
    { module: b"std.prelude", name: name, words: words, raises: raises };
  let native = |name: Bytes, words: Int, answers: Bool, raises: Bool|
    { name: name, words: words, answers: answers, raises: raises };
  let found = unbound(
    [
      native(b"List::len", 1, true, false),
      native(b"assert", 2, true, true),
      native(b"twice", 1, true, false),
      native(b"twice", 1, true, false),
      native(b"wider", 2, true, false),
      native(b"silent", 1, false, false),
      native(b"calm", 1, true, false),
      native(b"undeclared", 3, true, false),
    ],
    [
      declared(b"List::len", 1, false),
      declared(b"assert", 2, true),
      declared(b"gone", 0, false),
      declared(b"twice", 1, false),
      declared(b"wider", 1, false),
      declared(b"silent", 1, false),
      declared(b"calm", 1, true),
    ],
  );
  assert_eq(found.map(|u: Unbound| { name: u.declared.name, found: u.found.len() }), [
    { name: b"gone", found: 0 },
    { name: b"twice", found: 2 },
    { name: b"wider", found: 1 },
    { name: b"silent", found: 1 },
    { name: b"calm", found: 1 },
  ]);
  assert_eq(found.map(unbound_line), [
    b"`extern fn gone` of `std.prelude`: no native of the runtime implements it",
    b"`extern fn twice` of `std.prelude`: 2 natives of the runtime implement it",
    b"`extern fn wider` of `std.prelude` takes 1 word and cannot raise, and the runtime's native takes 2 words and cannot raise",
    b"`extern fn silent` of `std.prelude` takes 1 word and cannot raise, and the runtime's native takes 1 word, answers nothing and cannot raise",
    b"`extern fn calm` of `std.prelude` takes 1 word and raises, and the runtime's native takes 1 word and cannot raise",
  ]);
  assert_eq(
    unbound([], [{ module: b"", name: b"?hold_take", words: 1, raises: false }]).map(unbound_line),
    [b"the compiler's `?hold_take`: no native of the runtime implements it"],
  );
  // A crossing native the compiler declares answering nothing is bound by one that answers nothing.
  let crossing = { module: b"", name: b"?out_int", words: 1, raises: false };
  assert_eq(unbound([native(b"?out_int", 1, false, false)], [crossing]), []);
  assert_eq(unbound([native(b"?out_int", 1, true, false)], [crossing]).map(unbound_line), [
    b"the compiler's `?out_int` takes 1 word, answers nothing and cannot raise, and the runtime's native takes 1 word and cannot raise",
  ])
}

/// The unit of a program of `user` modules and the `shipped` ones they import, held against a
/// runtime of `natives`.
fn held_over(
  user: List<{ name: Bytes, src: Bytes }>,
  shipped: List<{ name: Bytes, src: Bytes }>,
  natives: List<Native>,
) -> Result<Bytes, List<Diag>> / {abort.raise} = {
  let dump = dump_of(analyse_pulling_std_with(user, shipped, no_rows()).out);
  let every = offered_roots(dump).keys;
  held(
    dump,
    every,
    emitted(
      { ..a_runtime(b"r"), natives: natives },
      dump,
      sources_placed(dump, user.concat(shipped)),
      Map::new(),
      every,
      |_: Bytes| None,
      |_: List<Record>| (),
    ),
  )
}

/// The texts of `modules`, and the prelude's where none of them is it, at the places `dump` gives
/// them.
fn sources_placed(dump: Dump, modules: List<{ name: Bytes, src: Bytes }>) -> List<Bytes> = {
  let texts = modules.fold(
    Map::new().insert(prelude_module(), prelude_source::text()),
    |acc: Map<Bytes, Bytes>, s: { name: Bytes, src: Bytes }| acc.insert(s.name, s.src),
  );
  let indexed = dump.modules.fold(Map::new(), |acc: Map<Int, Bytes>, m: ModuleRow|
    acc.insert(m.index, match texts.get(m.name) { Some(t) -> t, None -> b"" }));
  range(0, indexed.len()).map(|i: Int| match indexed.get(i) { Some(t) -> t, None -> b"" })
}

fn refusal(r: Result<Bytes, List<Diag>>) -> List<Bytes> =
  match r {
    Ok(_) -> [],
    Err(diags) -> diags.fold([], |acc: List<Bytes>, d: Diag| acc.push(d.code).concat(d.notes_text)),
  }

test "a root the emitter answers nothing for is refused and listed, and the rest are answered and kept" {
  let user = [{ name: b"m", src: b"fn one() -> Int = 1\nfn two() -> Int = one() + 1\n" }];
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  let every = [b"m.one", b"m.absent", b"m.two"].map(Named);
  let runtime = { ..a_runtime(b"r"), natives: declared_natives().map(native_of) };
  kept_bodies(|| {
    let run = ||
      match emitted(
          runtime,
          dump,
          sources_placed(dump, user),
          Map::new(),
          every,
          |k: Bytes| body_store.get(k),
          |rs: List<Record>| body_store.put(rs),
        ) {
        Ok(e) -> e,
        Err(why) -> panic(String::of_bytes_lossy(why)),
      };
    let first = run();
    let both = [b"m.one", b"m.two"].map(def_root);
    assert_eq(both.filter(|n: RootName| first.produced.taken.contains(n)), both);
    assert_eq(
      first.produced.dropped.map(|d: Dropped| { function: d.function, construct: d.construct }),
      [{ function: def_root(b"m.absent"), construct: unanswered_why() }],
    );
    let said = refusal(held(dump, every, Ok(first)));
    assert_eq(said.at(0), Some(b"E0448"));
    assert(
      said.any(|n: Bytes| n.index_of(b"`m.absent` (".concat(unanswered_why())) != None),
      Some(String::of_bytes_lossy(Bytes::join(said, b"\n"))),
    );
    // What the emitter answered is kept: the next run asks it for the unanswered root alone.
    assert_eq(run().asked, 1)
  })
}

test "each root a program offers is keyed by the row that says what it is, and prints as offered" {
  let user = [
    {
      name: b"m",
      src: Bytes::concat_all([
        b"fn f(x: Int) -> Int requires x > 0 ensures result > 0 = x\n",
        b"fn none<a>() -> List<a> ensures result.len() == 0 = []\n",
        b"test \"t\" for n: Int in [1] { assert(n > 0) }\n",
        b"law \"l\" forall (x: Int) where x > 0 { x + 1 > x }\n",
        b"law \"s\" forall (x: a) { x == x }\n",
      ]),
    },
  ];
  // What a test over cases reads its table through.
  let cases = {
    name: b"std.cases",
    src: Bytes::concat_all([
      b"pub type Table<a> = List<a>\n",
      b"pub type Listed = { label: String, identity: Bytes }\n",
      b"pub fn listed<a | e>(table: List<a>, label: (a) -> String / e) -> List<Listed> / {abort.raise | e} = table.map(|c: a| { label: label(c), identity: b\"\" })\n",
      b"pub fn chosen<a>(table: List<a>, at: Int, wanted: Bytes) -> a / {abort.raise} = match table.at(at) { Some(c) -> c, None -> panic(\"no case\") }\n",
    ]),
  };
  let dump = dump_of(analyse_pulling_std_with(user, [cases], no_rows()).out);
  let offers = offered_roots(dump);
  assert_eq(offers.unkeyed, []);
  assert_eq(offers.keys.map(printed), dump.emitter_roots.map(|r: EmitterRoot| r.root));
  assert_eq(offers.keys.filter(|k: RootKey| module_of(k) == b"m"), [
    Named(b"m.f"),
    Named(b"m.none"),
    test_key(b"m", b"t"),
    Clause({ def: Named(b"m.f"), kind: Requires, n: 0 }),
    Clause({ def: Named(b"m.f"), kind: Ensures, n: 0 }),
    Clause({ def: Named(b"m.none"), kind: Ensures, n: 0 }),
    Cases(test_key(b"m", b"t")),
    law_key(b"m", b"l", LawGuard),
    law_key(b"m", b"l", LawBody),
    law_key(b"m", b"s", LawBody),
  ]);
  // A judge enters a clause and a law's guard and body as the runtime enters a definition, a
  // generic one's at the specialisation it is judged at; a law over a type variable is proved over
  // its sort, never entered.
  let p = program_of(dump, sources_placed(dump, user.concat([cases])));
  let mine = offers.keys.filter(|k: RootKey| module_of(k) == b"m");
  assert_eq(
    mine.filter(|k: RootKey| entered_root(p, k)),
    mine.filter(|k: RootKey| k != law_key(b"m", b"s", LawBody)),
  )
}

test "a generic definition's clause is entered at the specialisation it is judged at, which the unit asks for" {
  let user = [{ name: b"m", src: b"pub fn none<a>() -> List<a> ensures result.len() == 0 = []\n" }];
  let dump = dump_of(analyse(parse_all(user)));
  let clause = |def: RootKey| Clause({ def: def, kind: Ensures, n: 0 });
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_placed(dump, user),
      Map::new(),
      offered_roots(dump).keys,
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(e) -> {
      let judged = [Entered(clause(Named(b"m.none"))), clause(judged_at(b"m.none", 1))].map(
        root_name,
      );
      assert(judged.all(|n: RootName| e.produced.taken.contains(n)), None);
      assert(!e.produced.dropped.any(|d: Dropped| judged.contains(d.function)), None)
    },
  }
}

test "a generic definition's entry is taken, its call settled where the entry judges it" {
  let user = [
    {
      name: b"m",
      src: Bytes::concat_all([
        b"pub fn first<a>(xs: List<a>) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }\n",
        b"pub fn made<a>(make: () -> a) -> a = make()\n",
        b"pub fn total<a>(xs: List<a>) -> a where numeric(a) = xs.fold(numeric_of_int(0), |s: a, x: a| s + x)\n",
      ]),
    },
  ];
  let dump = dump_of(analyse(parse_all(user)));
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_placed(dump, user),
      Map::new(),
      offered_roots(dump).keys,
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(e) -> {
      let entry = |n: Bytes| root_name(Entered(Named(n)));
      assert_eq(e.produced.dropped.filter(|d: Dropped| d.function == entry(b"m.first")), []);
      // A function crosses only out, and a witnessed variable has no specialisation at `Int`.
      assert_eq(
        [b"m.first", b"m.made", b"m.total"].filter(|n: Bytes| e.produced.taken.contains(entry(n))),
        [b"m.first"],
      )
    },
  }
}

test "a clause over a function its definition answers has no entry, as a function crosses only out" {
  let user = [
    {
      name: b"m",
      src: b"pub fn adder(n: Int) -> (Int) -> Int ensures result(1) == n + 1 = |x: Int| x + n\n",
    },
  ];
  let dump = dump_of(analyse(parse_all(user)));
  let p = program_of(dump, sources_placed(dump, user));
  assert(entered_root(p, Named(b"m.adder")), None);
  assert(!entered_root(p, Clause({ def: Named(b"m.adder"), kind: Ensures, n: 0 })), None)
}

test "a root the front end offers with no typed row to key it by fails the build, and what calls it is dropped" {
  let user = [{ name: b"m", src: b"fn one() -> Int = 1\nfn two() -> Int = one() + 1\n" }];
  let whole = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  let dump = { ..whole, defs: whole.defs.filter(|d: DefRow| d.name != b"m.one") };
  let offers = offered_roots(dump);
  assert_eq(offers.unkeyed, [b"m.one"]);
  let runtime = { ..a_runtime(b"r"), natives: declared_natives().map(native_of) };
  match emitted(
      runtime,
      dump,
      sources_placed(dump, user),
      Map::new(),
      offers.keys,
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(why) -> panic(String::of_bytes_lossy(why)),
    Ok(e) -> {
      assert_eq(
        e.produced.dropped.filter(|d: Dropped| d.function == def_root(b"m.two")).map(
          |d: Dropped| d.missing,
        ),
        [Some(def_root(b"m.one"))],
      );
      let said = refusal(held(dump, offers.keys, Ok(e)));
      assert_eq(said.at(0), Some(b"E0448"));
      assert(
        said.any(|n: Bytes|
          n.index_of(Bytes::concat_all([b"`m.one` (", unkeyed_why(b"m.one"), b")"])) != None),
        Some(String::of_bytes_lossy(Bytes::join(said, b"\n"))),
      )
    },
  }
}

test "a unit tells each place it walks to a build's phases as it ends, in the places' order" {
  let user = [{ name: b"m", src: b"fn one() -> Int = 1\nfn two() -> Int = one() + 1\n" }];
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  kept_bodies(|| {
    // Each place is kept under its number, as a byte for each root it asked the emitter for, and the
    // places in the order they were told.
    let told = |r: PlaceTally|
      body_store.put([
        {
          key: ascii_of_int(r.place),
          bytes: Bytes::concat_all(range(0, r.asked).map(|_: Int| b"x")),
        },
        {
          key: b"told",
          bytes: (match body_store.get(b"told") { Some(b) -> b, None -> b"" }).concat(
            Bytes::concat_all([ascii_of_int(r.place), b","]),
          ),
        },
      ]);
    match emitted(
        a_runtime(b"r"),
        dump,
        sources_placed(dump, user),
        Map::new(),
        [Named(b"m.one"), Named(b"m.two")],
        |_: Bytes| None,
        |_: List<Record>| (),
        phases: Some({ now: || 0, told: told }),
      ) {
      Err(why) -> panic(String::of_bytes_lossy(why)),
      Ok(e) -> {
        let said = match body_store.get(b"told") { Some(b) -> b.split(b","), None -> [] };
        let order = said.filter(|p: Bytes| p.len() > 0).map(|p: Bytes| digits(p));
        assert(
          order.len() > 0 && range(1, order.len()).all(|i: Int| order.get(i - 1) < order.get(i)),
          None,
        );
        assert_eq(
          order.fold(0, |n: Int, l: Int|
            n + (match body_store.get(ascii_of_int(l)) { Some(v) -> v.len(), None -> 0 })),
          e.asked,
        )
      },
    }
  })
}

test "a unit is refused where the runtime does not implement a native it calls as declared, and not for one it never calls" {
  let program = [
    {
      name: b"m",
      src: b"fn power(x: Float) -> Float = x.pow(2.0)\nfn plus<a>(x: a, y: a) -> a where numeric(a) = x + y\n",
    },
  ];
  let implemented = declared_natives().map(native_of);
  let taking = |name: Bytes, words: Int|
    implemented.map(|n: Native| if n.name == name { { ..n, words: words } } else { n });
  // `Float::pow` is called through the runtime's native, as an extern the emitter writes in place
  // is not.
  assert_eq(
    match held_over(program, [], implemented) {
      Ok(c) -> c.index_of(b"builtin_float_pow_p(ctx, ") != None,
      Err(_) -> false,
    },
    true,
  );
  assert_eq(refusal(held_over(program, [], implemented)), []);
  // Neither is called, so a runtime that lacks one or takes the other otherwise is no matter.
  assert_eq(
    refusal(
      held_over(
        program,
        [],
        taking(b"Secret::verify", 9).filter(|n: Native| n.name != b"Secret::is_empty"),
      ),
    ),
    [],
  );
  let refused = refusal(held_over(program, [], taking(b"Float::pow", 3)));
  assert_eq(refused.at(0), Some(b"E0476"));
  assert_eq(
    refused.at(1),
    Some(
      b"`extern fn Float::pow` of `std.prelude` takes 2 words and cannot raise, and the runtime's native takes 3 words and cannot raise",
    ),
  );
  assert_eq(
    refusal(held_over(program, [], taking(b"?numeric_binary", 5))).at(1),
    Some(
      b"the compiler's `?numeric_binary` takes 4 words and cannot raise, and the runtime's native takes 5 words and cannot raise",
    ),
  );
  let twice = implemented.concat(implemented.filter(|n: Native| n.name == b"Float::pow"));
  assert_eq(
    refusal(held_over(program, [], twice)).at(1),
    Some(b"`extern fn Float::pow` of `std.prelude`: 2 natives of the runtime implement it"),
  )
}

test "a unit whose bodies write externs in place asks the runtime for no native of them" {
  // What the prelude declares that a native implements: its builtins, and `ListNode::leaf_of`.
  let implemented = program_natives([]).map(native_of);
  let names = implemented.map(|n: Native| n.name);
  assert_eq(
    intrinsics().filter(|i: { name: Bytes, op: Intrinsic }|
      names.contains(i.name.slice(b"std.prelude.".len(), i.name.len()))).len(
    ),
    0,
  );
  let calls = b"\npub fn pushed(xs: List<Int>) -> List<Int> = ListNode::tail_push(xs, 1)\npub fn emptied(m: Map<Int, Int>) -> Map<Int, Int> = MapNode::map_swap(m, None, 0, 0).map\n";
  let program = [{ name: b"std.prelude", src: prelude_source::text().concat(calls) }];
  match held_over(program, [], implemented) {
    Ok(c) -> {
      // Each write is the emitted code's own, a block another holds copied by its type's root: the
      // runtime is asked for no extern's helper, nor whether a block may be written in place.
      let asked = intrinsics().map(|i: { name: Bytes, op: Intrinsic }|
        builtin_helper(i.name.slice(b"std.prelude.".len(), i.name.len())).concat(
          b"_p(ctx, ",
        )).concat([b"rt_list_writable_p(", b"rt_map_writable_p(", b"rt_node_writable_p("]);
      assert_eq(asked.filter(|t: Bytes| c.index_of(t) != None), [])
    },
    Err(diags) -> assert_eq(diags.map(|d: Diag| d.code), []),
  }
}

test "a unit is refused where the runtime implements a shipped module's `extern fn` it calls otherwise" {
  let native = [{ name: b"std.native", src: b"pub extern fn doubled(x: Int) -> Int\n" }];
  let program = [{ name: b"m", src: b"import std.native (doubled)\nfn f() -> Int = doubled(2)\n" }];
  let doubled = |words: Int| { name: b"doubled", words: words, answers: true, raises: false };
  let implemented = declared_natives().map(native_of);
  assert_eq(refusal(held_over(program, native, implemented.push(doubled(1)))), []);
  assert_eq(refusal(held_over(program, native, implemented.push(doubled(2)))), [
    b"E0476",
    b"`extern fn doubled` of `std.native` takes 1 word and cannot raise, and the runtime's native takes 2 words and cannot raise",
    natives_refused([]).notes_text.get(0),
  ])
}

test "a function of a type a module calls with no import is read from its home, which the emitter is handed" {
  let user = [{ name: b"m", src: b"fn first(xs: List<Int>) -> Int / {abort.raise} = xs.get(0)\n" }];
  let shipped = [
    {
      name: b"std.list",
      src: b"pub fn List::get<a>(xs: List<a>, i: Int) -> a / {abort.raise} = match xs.at(i) { Some(x) -> x, None -> panic(\"no element there\") }\n",
    },
  ];
  let dump = dump_of(analyse_pulling_std_with(user, shipped, no_rows()).out);
  let p = program_of(dump, sources_placed(dump, user.concat(shipped)));
  let root = Named(b"m.first");
  // Placed past its home, the module is answered with the home's handings.
  let places = places_of(p);
  assert(
    match ((places.get(b"m"), places.get(b"std.list"))) { (Some(a), Some(b)) -> a > b, _ -> false },
    None,
  );
  assert_eq(
    answers_in(scope_over(a_runtime(b"r"), dump, p, [], [root]), [root], Map::new()).map(
      |r: RootAnswer| match r.answer { Body(_) -> root_text(r.name), Refused(no) -> no.why },
    ),
    [b"m.first"],
  )
}

test "a law's body over a sort it leaves uninterpreted is lowered as a generic body as it stands" {
  let user = [
    {
      name: b"m",
      src: b"fn pair<a>(x: a) -> a = x\n\nlaw \"identity is identity\"\n  forall (x: a) {\n    pair(x) == x\n  }\n",
    },
  ];
  let dump = dump_of(analyse(parse_all(user)));
  let p = program_of(dump, sources_placed(dump, user));
  let root = law_key(b"m", b"identity is identity", LawBody);
  assert_eq(
    answers_in(scope_over(a_runtime(b"r"), dump, p, [], [root]), [root], Map::new()).map(
      |r: RootAnswer| match r.answer { Body(_) -> root_text(r.name), Refused(no) -> no.why },
    ),
    [printed(root)],
  )
}

test "a root the emitter refuses is asked again, and nothing of the refusal is kept" {
  let dump = dump_of(analyse(parse_all([{ name: b"m", src: b"pub fn f() -> Int = 1\n" }])));
  // The text the emitter reads names a module the program does not hold: the refusal is the
  // program's doing, which nothing the root is filed under says.
  let source = b"import gone (x)\n\npub fn f() -> Int = 1\n";
  let runtime = a_runtime(b"r");
  kept_bodies(|| {
    let run = ||
      match emitted(
          runtime,
          dump,
          [source],
          Map::new(),
          [Named(b"m.f")],
          |k: Bytes| body_store.get(k),
          |rs: List<Record>| body_store.put(rs),
        ) {
        Ok(e) -> e,
        Err(why) -> panic(String::of_bytes_lossy(why)),
      };
    // Its entry, written in its module, is refused with it.
    let refused = [Named(b"m.f"), Entered(Named(b"m.f"))].map(root_name);
    let first = run();
    assert_eq(first.produced.dropped.map(|d: Dropped| d.function), refused);
    let again = run();
    assert_eq(again.asked, 2);
    assert_eq(again.produced.dropped.map(|d: Dropped| d.function), refused)
  })
}

test "a unit asks the emitter for a root a kept body names, though the body's definition has moved" {
  let lending = b"fn each(n: Int, f: (Int) -> Int, i: Int, acc: Int) -> Int = if i >= n { acc } else { each(n, f, i + 1, acc + f(i)) }\nfn total(n: Int, f: (Int) -> Int) -> Int = each(n, f, 0, 0)\nfn scaled(n: Int, k: Int) -> Int = total(n, |x: Int| x * k)\n";
  let runtime = a_runtime(b"r");
  kept_bodies(|| {
    let unit = |source: Bytes|
      match emitted(
          runtime,
          dump_of(analyse(parse_all([{ name: b"m", src: source }]))),
          [source],
          Map::new(),
          [b"m.each", b"m.total", b"m.scaled"].map(Named),
          |k: Bytes| body_store.get(k),
          |rs: List<Record>| body_store.put(rs),
        ) {
        Ok(e) -> e,
        Err(why) -> panic(String::of_bytes_lossy(why)),
      };
    assert_eq(unit(lending).produced.dropped, []);
    // What the next run starts from: the body of `scaled`, and of no root it names, beside the keys
    // of the roots it calls.
    let answer = |k: Bytes| !k.starts_with(key_key(b""));
    body_store.replace(
      body_store.all().fold(Map::new(), |acc: Map<Bytes, Bytes>, k: Bytes, v: Bytes|
        if !answer(k) { acc.insert(k, v) } else {
          match bin::decode(v, kept_bin()) {
            Ok(filed) -> match filed.answer {
              Body(b) -> if b.tables.symbols.map(|d: Defined| d.symbol)
                  == [symbol_of(b"m.scaled")] { acc.insert(k, v) }
              else { acc },
              Refused(_) -> acc,
            },
            Err(_) -> acc,
          }
        }),
    );
    assert_eq(body_store.all().keys().filter(answer).len(), 1);
    let moved = unit(
      b"// a comment, and a definition, above them\nfn aside() -> Int = 7\n".concat(lending),
    );
    assert_eq(moved.kept, 1);
    assert_eq(moved.produced.dropped, [])
  })
}

/// The store a test's emissions keep bodies in.
effect body_store {
  read get(k: Bytes) -> Option<Bytes>
  write put(records: List<Record>) -> Unit
  read all() -> Map<Bytes, Bytes>
  write replace(m: Map<Bytes, Bytes>) -> Unit
}

/// `body` with an empty store of bodies.
fn kept_bodies<a | e>(
  body: () -> a / {body_store.get, body_store.put, body_store.all, body_store.replace | e},
) -> a / e =
  handle {
    body()
  } with {
    var store: Map<Bytes, Bytes> = Map::new(),
    body_store.get(k) -> store.get(k),
    body_store.put(records) -> {
      store = records.fold(store, |m: Map<Bytes, Bytes>, r: Record| m.insert(r.key, r.bytes));
    },
    body_store.all() -> store,
    body_store.replace(m) -> {
      store = m;
    },
  }

/// The unit over every root of `user`, its answers kept in the store at `s`, told each place as
/// `told` says.
fn unit_kept<[r]>(
  user: List<{ name: Bytes, src: Bytes }>,
  told: keep (PlaceTally) -> Unit / {abort.raise},
) -> Emission / {fs.read[r], fs.write[r], abort.raise} = {
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  with_kept[r, ans]("s", ||
    match emitted(
        a_runtime(b"r"),
        dump,
        sources_placed(dump, user),
        Map::new(),
        offered_roots(dump).keys,
        |k: Bytes| kept_records.get[ans](k),
        |rs: List<Record>| kept_records.put[ans](rs),
        phases: Some({ now: || 0, told: told }),
      ) {
      Ok(e) -> e,
      Err(why) -> panic(String::of_bytes_lossy(why)),
    })
}

fn kept_over(
  tree: fs::MemFs,
  user: List<{ name: Bytes, src: Bytes }>,
) -> fs::Over<Emission> / {abort.raise} = fs::on_mem[abs](tree, || unit_kept[abs](user, unaided))

/// Each file of the store at `s` and the bytes it takes.
fn store_files(tree: fs::MemFs) -> List<{ name: String, size: Int }> / {abort.raise} =
  match fs::mem_list(tree, "s") {
    None -> [],
    Some(names) ->
      names.filter(|n: String| n.starts_with("seg-") || n.starts_with("manifest-")).map(
        |n: String|
          { name: n, size: match fs::mem_size(tree, "s/" ++ n) { Some(s) -> s, None -> 0 } },
      ),
  }

fn store_bytes(tree: fs::MemFs) -> Int / {abort.raise} =
  store_files(tree).fold(0, |n: Int, f: { name: String, size: Int }| n + f.size)

fn unaided(_: PlaceTally) -> Unit = ()

fn kept_program() -> List<{ name: Bytes, src: Bytes }> =
  [
    {
      name: b"m",
      src: b"fn each(n: Int, f: (Int) -> Int, i: Int, acc: Int) -> Int = if i >= n { acc } else { each(n, f, i + 1, acc + f(i)) }\nfn total(n: Int, f: (Int) -> Int) -> Int = each(n, f, 0, 0)\nfn scaled(n: Int, k: Int) -> Int = total(n, |x: Int| x * k)\nfn pair<a>(x: a) -> List<a> = [x, x]\nfn twice(n: Int) -> Int = pair(n).len() + pair(\"s\").len()\n",
    },
  ]

test "a run over a store an earlier run filled reads every answer back and writes nothing" {
  let first = kept_over(fs::mem_of([]), kept_program());
  assert(first.value.asked > 0 && first.value.produced.dropped == [], None);
  let second = kept_over(first.tree, kept_program());
  assert_eq(second.value.asked, 0);
  assert_eq(second.value.produced.taken, first.value.produced.taken);
  assert_eq(store_files(second.tree), store_files(first.tree))
}

test "a run that dies keeps the answers of every call the emitter finished" {
  let whole = kept_over(fs::mem_of([]), kept_program());
  let died = fs::on_mem[abs](fs::mem_of([]), ||
    handle {
      unit_kept[abs](kept_program(), |_: PlaceTally| panic("the run dies as its first place ends"));
      false
    } with {
      abort.raise(_) -> true,
    });
  assert(died.value, None);
  let next = kept_over(died.tree, kept_program());
  // The answers of its first place were kept as they came back; the next run asks for the rest.
  assert(next.value.kept > 0 && next.value.asked < whole.value.asked, None);
  assert_eq(next.value.produced.taken, whole.value.produced.taken)
}

test "a run keeps only what it was answered anew, however much the store holds" {
  let first = kept_over(fs::mem_of([]), kept_program());
  let grown = |more: Bytes| {
    let user = kept_program().map(|m: { name: Bytes, src: Bytes }|
      { ..m, src: m.src.concat(more) });
    let next = kept_over(first.tree, user);
    { asked: next.value.asked, wrote: store_bytes(next.tree) - store_bytes(first.tree) }
  };
  // A definition more is a root more and the keys it calls; nothing kept before is written again.
  let one = grown(b"fn aside() -> Int = 7\n");
  let three = grown(b"fn aside() -> Int = 7\nfn beside() -> Int = 8\nfn below() -> Int = 9\n");
  assert(one.asked > 0 && three.asked > one.asked, None);
  assert(one.wrote > 0 && one.wrote * 2 < store_bytes(first.tree), None);
  assert(three.wrote <= one.wrote * three.asked / one.asked + 400, None)
}

test "a run passes over a store's segment it cannot read and asks for those roots again" {
  let first = kept_over(fs::mem_of([]), kept_program());
  let cut = store_files(first.tree).fold(
    first.tree,
    |t: fs::MemFs, f: { name: String, size: Int }|
      if f.name.starts_with("seg-") { fs::mem_write(t, "s/" ++ f.name, b"").fs } else { t },
  );
  let again = kept_over(cut, kept_program());
  assert_eq(again.value.asked, first.value.asked);
  assert_eq(again.value.produced.taken, first.value.produced.taken)
}

test "answers and values are kept in a store of their runtime and emitter, a value under its hash" {
  let at = |runtime: Bytes, emitter: Bytes| answers_store("b", a_runtime(runtime), emitter);
  assert_eq(at(b"r", b"e"), at(b"r", b"e"));
  assert(at(b"r", b"e") != at(b"r2", b"e"), None);
  assert(at(b"r", b"e") != at(b"r", b"e2"), None);
  assert(baked_key(b"hash") != baked_key(b"another"), None)
}

test "a unit takes what its callees let it, resolves its bodies and says what it holds" {
  let runtime = {
    ..a_runtime(b"r"),
    head: b"/* head */\n",
    tail: b"/* tail */\n",
    helpers: [{ name: b"rt_a", args: 1, answers: true }],
  };
  let answers = by_def([
    { key: b"m.f", value: one_body(b"m.f", []) },
    { key: b"m.g", value: one_body(b"m.g", [b"m.gone"]) },
  ]);
  let p = produce(
    runtime,
    [{ name: b"None", arity: 0 }],
    [offer(b"m.g", 0), { ..offer(b"m.f", 0), constant: true }],
    1,
    answers,
    Map::new(),
  );
  assert_eq(p.taken, [def_root(b"m.f")]);
  assert_eq(p.dropped.map(|d: Dropped| d.function), [def_root(b"m.g")]);
  let own = statics_of(SStr(b"m.f")).get(0).name;
  assert(
    p.text.index_of(
        Bytes::concat_all([
          b"Word f_m.f(PlyCtx *ctx) { return (Word)(intptr_t)&",
          own,
          b" + ",
          ascii_of_int(root_id(b"m.f")),
          b"; }",
        ]),
      )
      != None,
    None,
  );
  assert(p.text.index_of(b"Word f_m.f(PlyCtx*);\n") != None, None);
  // The tail defines the static the body names, then says what the unit holds.
  assert(
    p.text.index_of(Bytes::concat_all([b"/* tail */\nconst struct ", own, b" {"])) != None,
    None,
  );
  assert(p.text.index_of(b"};\n\n/* --- what this unit says about itself") != None, None);
  // A constant says its row of the code table, and the loader takes that table and each
  // definition's entry by address.
  assert(p.text.index_of(b"\"constants 1\" \"\\n\"\n\"m.f 0\" \"\\n\"") != None, None);
  assert(p.text.index_of(b"\"taken ") == None && p.text.index_of(b"\"lambdas ") == None, None);
  assert(p.text.index_of(b"void *const ply_code[] = {\n  (void *)&e_m.f,\n  0 };\n") != None, None);
  assert(
    p.text.index_of(
        b"const struct ply_taken ply_taken[] = {\n  { \"m.f\", (void *)&e_m.f, 0 },\n  { 0, 0, 0 } };\n",
      )
      != None,
    None,
  );
  assert(
    p.text.index_of(b"(void *)ply_bind_singletons, ply_code, 1, ply_taken, 1 };\n") != None,
    None,
  )
}

test "a unit lays its definitions out by name in byte order, each name as a C literal holds it" {
  let roots = [Named(b"m.z"), Stored(Named(b"m.a")), Named(b"m.B")];
  let p = produce(
    a_runtime(b"r"),
    [],
    roots.map(|k: RootKey| { name: root_name(k), arity: 2, constant: false, site: root_name(k) }),
    1,
    roots.fold(Map::new(), |acc: Map<RootName, Answer>, k: RootKey|
      acc.insert(root_name(k), one_body(printed(k), []))),
    Map::new(),
  );
  assert(
    p.text.index_of(
        b"ply_taken[] = {\n  { \"m.B\", (void *)&e_m.B, 2 },\n  { \"m.a#stored\", (void *)&e_m.a#stored, 2 },\n  { \"m.z\", (void *)&e_m.z, 2 },\n  { 0, 0, 0 } };\n",
      )
      != None,
    Some(String::of_bytes_lossy(p.text)),
  );
  assert_eq(
    laid(
      [{ name: def_root(b"m.\"q\""), arity: 0, symbol: b"f", entry: b"e", head: word_head(0) }],
      [],
      [],
    ),
    Bytes::concat_all([
      b"\n/* --- what the loader takes by address --- */\nextern char e;\nvoid *const ply_code[] = {\n  0 };\n",
      b"struct ply_taken { const char *name; void *entry; unsigned long arity; };\n",
      b"const struct ply_taken ply_taken[] = {\n  { \"m.\\\"q\\\"\", (void *)&e, 0 },\n  { 0, 0, 0 } };\n",
      b"struct ply_descriptor { const char *exports; unsigned long exports_len; void *bind; void *bind_singletons; void *const *code; unsigned long code_count; const struct ply_taken *taken; unsigned long taken_count; };\n",
      b"const struct ply_descriptor ply_descriptor = { ply_exports, sizeof ply_exports - 1, (void *)ply_bind, (void *)ply_bind_singletons, ply_code, 0, ply_taken, 1 };\n",
    ]),
  )
}

test "a unit says which constructors are read through a function, and which function it lacks" {
  let p = produce(
    { ..a_runtime(b"r"), head: b"/* head */\n", tail: b"/* tail */\n" },
    [{ name: b"m.Box", arity: 2 }, { name: b"m.Dot", arity: 0 }],
    [offer(b"m.area", 1), offer(b"m.make", 0)],
    1,
    by_def([
      { key: b"m.area", value: one_body(b"m.area", [b"m.area"]) },
      { key: b"m.make", value: one_body(b"m.make", [b"m.area"]) },
    ]),
    Map::new(),
    [{ ctor: b"m.Box", key: Some(b"m.area"), show: Some(b"m.text"), numeric: [] }],
  );
  assert_eq(p.taken, [b"m.area", b"m.make"].map(def_root));
  assert(p.text.index_of(b"\"instances 1\" \"\\n\"\n\"m.Box m.area !\" \"\\n\"") != None, None);
  // A body that names the constructor is not taken without the key its type states.
  let alone = produce(
    a_runtime(b"r"),
    [{ name: b"m.Box", arity: 2 }],
    [offer(b"m.make", 0)],
    1,
    by_def([{ key: b"m.make", value: one_body(b"m.make", [b"m.area"]) }]),
    Map::new(),
    [{ ctor: b"m.Box", key: Some(b"m.area"), show: None, numeric: [] }],
  );
  assert_eq(alone.taken, []);
  assert_eq(alone.dropped.map(|d: Dropped| d.missing), [Some(def_root(b"m.area"))]);
  // A unit none of whose types states one says nothing of it.
  let plain = produce(
    a_runtime(b"r"),
    [],
    [offer(b"m.f", 0)],
    1,
    by_def([{ key: b"m.f", value: one_body(b"m.f", []) }]),
    Map::new(),
  );
  assert(plain.text.index_of(b"instances") == None, None);
  // Last, every unit says it holds a `Decimal` as its two words.
  assert(plain.text.index_of(b"decimals held raw") != None, None)
}

test "a root's code moves with the key a type it names states" {
  let program = |key: Answer, calls: List<Bytes>|
    codes_over(
      [
        { key: b"m.make", value: one_body(b"m.make", calls) },
        { key: b"m.area", value: key },
        { key: b"m.edge", value: one_body(b"m.edge", []) },
      ],
      [b"m.make", b"m.area", b"m.edge"],
      [],
    );
  let keyed = program(one_body(b"m.area", []), [b"m.area"]);
  let edited = program(edited_body(b"m.area"), [b"m.area"]);
  let other = program(one_body(b"m.area", []), [b"m.edge"]);
  assert(keyed.get(b"m.make") != edited.get(b"m.make"), None);
  assert(keyed.get(b"m.make") != other.get(b"m.make"), None)
}

test "a read of a definition of no parameters keeps its value for good through its type's keep root" {
  let k = kept_unit(
    Bytes::concat_all([
      b"fn flag() -> Bool = 1 < 2\n",
      b"fn word() -> String = \"a\" ++ \"b\"\n",
      b"fn none<a>() -> Option<a> = None\n",
      b"fn read() -> Int = if flag() { word().len() } else { 0 }\n",
      b"fn nothing() -> Option<Int> = none()\n",
    ]),
  );
  let held = k.unit([b"m.flag", b"m.word", b"m.none", b"m.read", b"m.nothing"].map(Named), []);
  let text = held.produced.text;
  let read_with = |keep: Bytes|
    text.index_of(Bytes::concat_all([b", (Word)(intptr_t)", keep, b")"])) != None;
  assert_eq(text.index_of(b"rt_constant_p"), None);
  assert(text.index_of(b"rt_memo_p(ctx, ") != None, None);
  // A word form that holds no block is kept as it is, and one that may by its type's root.
  assert(read_with(same_word_fn()), None);
  assert(read_with(symbol_of(printed(root_of(keys::Keep, string_type())))), None);
  // A generic definition is called at its caller's type arguments, which settle its body.
  assert_eq(held.produced.dropped.map(|d: Dropped| d.function), [])
}

/// The unit over every root `user` offers, its answers read from and kept in the test's store, and
/// each place it walks kept there as `place` and its number. Stops where it keeps an answer the store
/// holds already, which is a root answered twice.
fn unit_in_store(
  user: List<{ name: Bytes, src: Bytes }>,
) -> Emission / {body_store.get, body_store.put, abort.raise} = {
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_placed(dump, user),
      Map::new(),
      offered_roots(dump).keys,
      |k: Bytes| body_store.get(k),
      |rs: List<Record>|
        match rs.find(|r: Record|
            r.key.starts_with(b"answer\x00") && body_store.get(r.key) != None) {
          Some(r) -> panic(String::of_bytes_lossy(b"an answer kept twice: ".concat(r.key))),
          None -> body_store.put(rs),
        },
      phases: Some({
        now: || 0,
        told: |r: PlaceTally|
          body_store.put([{ key: b"place ".concat(ascii_of_int(r.place)), bytes: b"" }]),
      }),
    ) {
    Ok(e) -> e,
    Err(why) -> panic(String::of_bytes_lossy(why)),
  }
}

/// A module of records nested `d` deep, each holding the one below and a list of them, and a function
/// of the deepest the runtime enters: its entry lifts the record and lets go of it.
fn nested_records(d: Int) -> List<{ name: Bytes, src: Bytes }> =
  [
    {
      name: b"m",
      src: Bytes::concat_all(
        range(1, d + 1).fold([b"type T0 = { s: String }\n"], |acc: List<Bytes>, k: Int| {
          let below = ascii_of_int(k - 1);
          acc.push(
            Bytes::concat_all([
              b"type T",
              ascii_of_int(k),
              b" = { x: T",
              below,
              b", y: List<T",
              below,
              b"> }\n",
            ]),
          )
        }).push(
          Bytes::concat_all([b"pub fn crossed(t: T", ascii_of_int(d), b") -> Int = 1\n"]),
        ),
      ),
    },
  ]

test "a unit's places do not grow with how deep the records it crosses nest, and it answers each root once" {
  let places = [2, 4, 8].map(|d: Int|
    kept_bodies(|| {
      let e = unit_in_store(nested_records(d));
      assert_eq(e.produced.dropped, []);
      body_store.all().keys().filter(|k: Bytes| k.starts_with(b"place ")).len()
    }));
  assert(
    places.all(|n: Int| n == places.get(0)),
    Some("places at depths 2, 4 and 8: " ++ String::join(places.map(|n: Int| n.to_string()), ", ")),
  )
}

/// What a test's emitter holds: its scope once built, how many scopes it built, and the roots it was
/// asked for, in order, each as often as it was asked for.
type Counted = { scope: Option<Result<emit::Scope, Bytes>>, built: Int, asked: List<RootName> }

/// The walk of every root `user` offers, its answers read from and kept in the test's store, the
/// emitter counting the scopes it builds and the roots it is asked for.
fn walk_in_store(
  user: List<{ name: Bytes, src: Bytes }>,
) -> Walk<Counted> / {body_store.get, body_store.put, abort.raise} = {
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  let p = program_of(dump, sources_placed(dump, user));
  let offered = offered_roots(dump).keys;
  let ctors = dump.emitter_ctors.map(|c: EmitterCtor| { name: c.name, arity: c.arity });
  walked(
    p,
    types_material(dump),
    program_ctors(dump, ctors),
    offered,
    |k: Bytes| body_store.get(k),
    |rs: List<Record>| body_store.put(rs),
    None,
    { scope: None, built: 0, asked: [] },
    |held: Counted, roots: List<RootKey>, handed: Map<RootName, Handing>| {
      let scope = match held.scope {
        Some(s) -> s,
        None -> scope_over(a_runtime(b"r"), dump, p, ctors, offered),
      };
      let pieces = dealt(p, roots);
      {
        held: {
          scope: Some(scope),
          built: match held.scope { Some(_) -> held.built, None -> held.built + 1 },
          asked: held.asked.concat(roots.map(root_name)),
        },
        answers: answers_at_once(scope, pieces, 0, pieces.len(), 64, handed),
      }
    },
  )
}

test "a cold walk asks the emitter for each root once over one scope, and a warm one builds none" {
  kept_bodies(|| {
    let cold = walk_in_store(kept_program());
    assert_eq(cold.emitter.built, 1);
    assert(cold.emitter.asked.len() > 0, None);
    assert_eq(names_ordered(cold.emitter.asked).len(), cold.emitter.asked.len());
    assert_eq(cold.asked, cold.emitter.asked.len());
    let warm = walk_in_store(kept_program());
    assert_eq((warm.emitter.built, warm.emitter.asked), (0, []));
    assert_eq(warm.answers.keys(), cold.answers.keys())
  })
}

/// The base-2 logarithm of `n`, rounded down.
fn log2(n: Int) -> Int =
  range(0, 63).fold(0, |k: Int, i: Int| if n >> i + 1 > 0 { i + 1 } else { k })

test "a walk's steps grow with the roots it answers, however long the chain of calls that finds them" {
  let p = program_of(three_modules_dump(), []);
  // Root `i` of a chain of roots written for types of module `a`, each calling the next.
  let link = |i: Int| keys::written(keys::Drop, spelled(b"a.T".concat(ascii_of_int(i))), b"a");
  paced(|n: Int| n * (log2(n) + 1), |n: Int| {
    let at = range(0, n).fold(Map::new(), |m: Map<RootName, Int>, i: Int|
      m.insert(root_name(link(i)), i));
    let answer = |k: RootKey|
      match at.get(root_name(k)) {
        Some(i) ->
          Body({
            text: b"",
            tables: { ..no_tables(), calls: if i + 1 < n { [link(i + 1)] } else { [] } },
          }),
        None -> Refused({ why: b"no root of the chain" }),
      };
    walked(
      p,
      b"",
      no_ctors(),
      [link(0)],
      |_: Bytes| None,
      |_: List<Record>| (),
      None,
      (),
      |_: Unit, roots: List<RootKey>, _: Map<RootName, Handing>|
        { held: (), answers: roots.map(|k: RootKey| { name: root_name(k), answer: answer(k) }) },
    ).answers.len(
    )
  })
}
