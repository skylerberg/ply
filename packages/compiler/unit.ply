pub effect shipped {
  read names() -> List<String>
  read module(name: String) -> Option<Bytes>
  read read_pack(path: String, offset: Int, len: Int) -> Option<Bytes>
  read digests() -> Bytes
  read report_view_used(view: Bytes, pulled: Bool) -> Unit
  read version() -> String
  read binary_size() -> Option<Int>
  read stamps() -> String
  read runtime() -> Bytes
  read definitions() -> Bytes
  read run_root(library: String, root: String, arguments: Bytes, timeout_ms: Int) -> Option<Bytes>
}

host for shipped by shipped_handler

fn shipped_handler<a | e>(go: () -> a / {shipped.read | e}) -> a / {native.read, abort.raise | e} =
  handle {
    go()
  } with {
    shipped.names() -> {
      observed("", "", 5);
      parts(shipped_names()).map(|name: Bytes| String::of_bytes_lossy(name))
    },
    shipped.module(name) -> {
      observed("", name, 5);
      found(shipped_module(name))
    },
    shipped.read_pack(path, offset, len) -> if offset < 0 || len < 0 { None }
    else { found(shipped_answer(path, offset, len)) },
    shipped.digests() -> shipped_digests(),
    shipped.report_view_used(view, pulled) ->
      observed("", String::of_bytes_lossy(view), if pulled { 7 } else { 8 }),
    shipped.version() -> String::of_bytes_lossy(shipped_version()),
    shipped.binary_size() -> match found(shipped_binary_bytes()) {
      Some(n) -> Some(decode_int(n)),
      None -> None,
    },
    shipped.stamps() -> String::of_bytes_lossy(shipped_stamps()),
    shipped.runtime() -> shipped_described(),
    shipped.definitions() -> {
      observed("", "", 6);
      shipped_definitions()
    },
    shipped.run_root(library, root, arguments, timeout_ms) ->
      found(shipped_entered(library, root, arguments, timeout_ms)),
  }

extern fn shipped_names() -> Bytes / {native.read}

extern fn shipped_module(name: String) -> Bytes / {native.read}

extern fn shipped_answer(path: String, offset: Int, len: Int) -> Bytes / {native.read}

extern fn shipped_digests() -> Bytes / {native.read}

extern fn shipped_version() -> Bytes / {native.read}

extern fn shipped_binary_bytes() -> Bytes / {native.read}

extern fn shipped_stamps() -> Bytes / {native.read}

extern fn shipped_described() -> Bytes / {native.read}

extern fn shipped_definitions() -> Bytes / {native.read}

extern fn shipped_entered(
  library: String,
  root: String,
  arguments: Bytes,
  timeout_ms: Int,
) -> Bytes / {native.read}

pub fn shipped_runtime() -> Runtime / {shipped.runtime, abort.raise} =
  match runtime_of(shipped.runtime()) {
    Ok(r) -> r,
    Err(reason) ->
      panic(
        "this binary describes the runtime it is linked with unreadably: "
          ++ String::of_bytes_lossy(reason),
      ),
  }

pub type Unbound = { declared: Extern, found: List<Native> }

pub fn unbound(natives: List<Native>, declared: List<Extern>) -> List<Unbound> = {
  let by_name = natives.fold(Map::new(), |acc: Map<Bytes, List<Native>>, n: Native|
    acc.insert(n.name, List::push(match acc.get(n.name) { Some(ns) -> ns, None -> [] }, n)));
  declared.fold([], |acc: List<Unbound>, d: Extern| {
    let found = match by_name.get(d.name) { Some(ns) -> ns, None -> [] };
    match found {
      [n] -> if n == declared_signature(d) { acc } else { acc.push({ declared: d, found: found }) },
      _ -> acc.push({ declared: d, found: found }),
    }
  })
}

pub fn declared_signature(d: Extern) -> Native =
  match d.call {
    Some(c) ->
      { name: d.name, params: call_params(c), result: call_result_kind(c), raises: d.raises },
    None -> match abi::native_named(d.name) {
      Some(n) -> n,
      None -> word_native(d.name, d.words, true, d.raises),
    },
  }

fn call_params(c: MachineCall) -> List<Machine> =
  c.params.fold([], |acc: List<Machine>, v: MachineValue|
    match v {
      MachineInt(_) -> acc.push(abi::I64),
      MachineFloat -> acc.push(abi::F64),
      MachineText(_) -> acc.push(abi::Addr).push(abi::I64),
      MachineSecret(_) -> acc.push(abi::Secret),
      MachineObject(_) -> acc.push(abi::Handle),
      MachineTypeVariable(_) -> acc.push(abi::Opaque).push(abi::Type),
      MachineFunction(_) -> acc.push(abi::Block).push(abi::Words).push(abi::Words),
      MachineUnit -> acc,
    }).concat(match c.result { MachineTypeVariable(_) -> [abi::Type], _ -> [] })

fn call_result_kind(c: MachineCall) -> Option<Machine> =
  match c.result {
    MachineInt(_) -> Some(abi::I64),
    MachineFloat -> Some(abi::F64),
    MachineText(_) -> Some(abi::Taken),
    MachineSecret(_) -> Some(abi::Secret),
    MachineObject(_) -> Some(abi::Handle),
    MachineTypeVariable(_) -> Some(abi::Opaque),
    MachineFunction(_) -> None,
    MachineUnit -> None,
  }

fn extern_natives(declared: List<Extern>) -> List<Native> / {abort.raise} =
  declared.fold([], |acc: List<Native>, e: Extern|
    if e.call == None { acc }
    else { acc.push({ ..declared_signature(e), name: builtin_helper(e.name) }) })

fn natives_called(made: UnitContents) -> Map<Bytes, Bool> = natives_of(made.bodies)

fn natives_of(bodies: List<UnitBody>) -> Map<Bytes, Bool> =
  bodies.fold(Map::new(), |acc: Map<Bytes, Bool>, k: UnitBody|
    k.tables.natives.fold(acc, |m: Map<Bytes, Bool>, n: Bytes| m.insert(n, true)))

fn read_natives(p: Program, called: Map<Bytes, Bool>) -> List<Extern> / {abort.raise} = {
  let own = declared_natives();
  let theirs = own.fold(called, |acc: Map<Bytes, Bool>, e: Extern|
    acc.remove(builtin_helper(e.name)));
  if theirs.len() == 0 { own } else {
    program_natives(
      p.modules.fold([], |acc: List<{ name: Bytes, text: Bytes }>, m: ModuleRow|
        if !p.read.contains(m.name) { acc } else {
          match text_at(p, m.index) {
            Some(text) -> acc.push({ name: m.name, text: text }),
            None -> acc,
          }
        }),
    )
  }
}

fn called_externs(called: Map<Bytes, Bool>, natives: List<Extern>) -> List<Extern> / {abort.raise} =
  natives.filter(|e: Extern| called.contains(builtin_helper(e.name)))

fn kinds_text(n: Native) -> Bytes =
  Bytes::concat_all([
    b"takes [",
    Bytes::join(n.params.map(machine_name), b", "),
    b"]",
    match n.result {
      Some(m) -> b", returns ".concat(machine_name(m)),
      None -> b", returns nothing",
    },
    if n.raises { b" and raises" } else { b" and cannot raise" },
  ])

fn unbound_line(u: Unbound) -> Bytes = {
  let d = u.declared;
  let named = if d.module == b"" { Bytes::concat_all([b"the compiler's `", d.name, b"`"]) }
  else { Bytes::concat_all([b"`extern fn ", d.name, b"` of `", d.module, b"`"]) };
  match u.found {
    [] -> named.concat(b": no native of the runtime implements it"),
    [n] ->
      Bytes::concat_all([
        named,
        b" ",
        kinds_text(declared_signature(d)),
        b", and the runtime's native ",
        kinds_text(n),
      ]),
    ns ->
      Bytes::concat_all([
        named,
        b": ",
        ascii_of_int(ns.len()),
        b" natives of the runtime implement it",
      ]),
  }
}

pub type SignatureMismatch = {
  caller: RootName,
  assumed: PublishedSignature,
  published: Option<PublishedSignature>,
}

fn agrees(assumed: PublishedSignature, now: Option<PublishedSignature>) -> Bool =
  match now {
    Some(h) -> h == assumed,
    None -> !assumed.borrowed.any(|l: Bool| l) && assumed.borrowed_from == None,
  }

fn handing_text(h: PublishedSignature) -> Bytes =
  Bytes::concat_all([
    b"[",
    Bytes::join(h.borrowed.map(|l: Bool| if l { b"borrowed" } else { b"given" }), b", "),
    b"] ",
    match h.borrowed_from {
      None -> b"owned",
      Some(from) ->
        Bytes::concat_all([
          b"borrowed(",
          Bytes::join(
            from.map(|x: { param: Int, whole: Bool }|
              if x.whole { ascii_of_int(x.param) } else { ascii_of_int(x.param).concat(b" part") }),
            b", ",
          ),
          b")",
        ]),
    },
  ])

fn signature_mismatch_error(wrong: List<SignatureMismatch>) -> Diagnostic =
  error_with_labels(
    b"E0478",
    Bytes::concat_all([
      b"the emitter wrote ",
      ascii_of_int(wrong.len()),
      if wrong.len() == 1 { b" call against a handing its callee does not publish" }
      else { b" calls against handings their callees do not publish" },
    ]),
    [],
    wrong.map(|m: SignatureMismatch|
      Bytes::concat_all([
        b"`",
        root_text(m.caller),
        b"` calls `",
        root_text(m.assumed.definition),
        b"` written ",
        handing_text(m.assumed),
        b", where it publishes ",
        match m.published { Some(h) -> handing_text(h), None -> b"none, so takes every argument" },
      ])),
  )

fn natives_rejected(rejected: List<Unbound>) -> Diagnostic =
  error_with_labels(
    b"E0476",
    Bytes::concat_all([
      b"the runtime does not implement ",
      ascii_of_int(rejected.len()),
      if rejected.len() == 1 { b" native this program calls as it is declared" }
      else { b" natives this program calls as they are declared" },
    ]),
    [],
    rejected.map(unbound_line).push(
      b"the runtime reports a native as the type of the function it binds says, and a call is written as the compiler that emitted it declares the native, so the two disagree where that compiler and the runtime are built from different sources, as a release's compiler and a newer runtime are",
    ),
  )

fn runtime_rejected(unserved: List<RuntimeMismatch>) -> Diagnostic =
  error_with_labels(
    b"E0481",
    Bytes::concat_all([
      b"the runtime does not serve the code this compiler emits in ",
      ascii_of_int(unserved.len()),
      if unserved.len() == 1 { b" place" } else { b" places" },
    ]),
    [],
    unserved.map(mismatch_line).push(
      b"the runtime describes its helpers and what it lays out as its Rust says, and the compiler emits code as `compiler.emit.abi` declares them, so the two disagree where that compiler and the runtime are built from different sources",
    ),
  )

pub fn pack_frame(path: String, offset: Int, len: Int) -> Option<Bytes> / {shipped.read_pack} =
  shipped.read_pack(path, offset, len)

pub fn definition_hash(definitions: Bytes, name: Bytes) -> Option<Bytes> / {abort.raise} = {
  let line = name.concat(b" ");
  let found = if definitions.starts_with(line) { Some(0) }
  else { match definitions.index_of(b"\n".concat(line)) { Some(i) -> Some(i + 1), None -> None } };
  match found {
    None -> None,
    Some(i) -> {
      let from = i + line.len();
      let most = if from + 65 > definitions.len() { definitions.len() } else { from + 65 };
      let rest = definitions.slice(from, most);
      Some(rest.slice(0, match rest.index_of_byte(10) { Some(end) -> end, None -> rest.len() }))
    },
  }
}

pub fn identity_of(definitions: Bytes, roots: List<Bytes>) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all(
        roots.map(|root: Bytes|
          match definition_hash(definitions, root) {
            Some(h) -> Bytes::concat_all([root, b" ", h, b"\n"]),
            None ->
              panic(
                "this binary's program holds no definition `" ++ String::of_bytes_lossy(root)
                  ++ "`, which a cached result is recorded under",
              ),
          }),
      ),
    ),
  )

pub fn emitter_roots() -> List<Bytes> =
  [
    b"compiler.unit.scope_of_modules",
    b"compiler.emit.root_outputs",
    b"compiler.front.emitter_input.view_dump",
    b"compiler.unit.produce",
  ]

pub fn emitter_identity(definitions: Bytes) -> Bytes / {abort.raise} =
  identity_of(definitions, emitter_roots())

pub fn unit_roots() -> List<Bytes> =
  [b"compiler.unit.emitted", b"compiler.unit.unit_parts", b"compiler.front.emitter_input.view_dump"]

pub fn compiler_roots() -> List<Bytes> =
  unit_roots().push(b"compiler.front.analyse_pulling_std_with")

pub fn program_key(entry: Bytes, runtime: Runtime, definitions: Bytes) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all([
        b"ply.program.1\0",
        entry,
        runtime.identity,
        b"\0",
        identity_of(definitions, [b"compiler.build.build_program"]),
      ]),
    ),
  )

pub fn programs_dir() -> String = "programs"

fn cache_path(dir: String, key: Bytes) -> String / {abort.raise} =
  if dir == "" || dir == "." { String::of_bytes(key) } else { dir ++ "/" ++ String::of_bytes(key) }

pub fn read_cached_file<[r]>(
  dir: String,
  key: Bytes,
) -> Option<Bytes> / {fs.read[r], fs.write[r], time.now_ms, abort.raise} = {
  let path = cache_path(dir, key);
  match fs.read_file[r](path) {
    None -> None,
    Some(bytes) -> {
      fs.set_modified[r](path, time.now_ms());
      Some(bytes)
    },
  }
}

pub fn write_cached_file<[r]>(
  dir: String,
  key: Bytes,
  bytes: Bytes,
) -> Unit / {fs.write[r], entropy.next, time.now_ms, abort.raise} = {
  let path = cache_path(dir, key);
  let nonce = blake3(u64_le(entropy.next()).concat(u64_le(time.now_ms()))).slice(0, 8);
  let temp = path ++ "." ++ nonce.hex_of() ++ ".tmp";
  if fs.create_dir[r](if dir == "" { "." } else { dir }) && fs.write_file[r](temp, bytes) {
    if !fs.rename[r](temp, path) {
      fs.remove[r](temp);
      ()
    }
  }
}

pub type RequestedRoot = { name: RootName, arity: Int, constant: Bool, site: RootName, home: Bytes }

pub type Constructor = { name: Bytes, arity: Int }

pub type UnitContents = {
  bodies: List<UnitBody>,
  requested: List<RequestedRoot>,
  named: Map<RootName, List<RootName>>,
}

pub type UnitOutput = {
  parts: List<WrittenPart>,
  taken: List<RootName>,
  made: UnitContents,
  records: List<Record>,
}

pub type Emission = {
  produced: UnitOutput,
  roots: List<RootKey>,
  cached: Int,
  asked: Int,
  unserved: List<RuntimeMismatch>,
  unbound: List<Unbound>,
  signature_mismatches: List<SignatureMismatch>,
}

pub fn results_by_name(rows: List<RootOutput>) -> Map<RootName, Output> =
  rows.fold(Map::new(), |acc: Map<RootName, Output>, r: RootOutput|
    if r.result.tables.members.len() == 0 { acc.insert(r.name, r.result) } else {
      r.result.tables.members.fold(acc, |into: Map<RootName, Output>, m: RootKey|
        into.insert(root_name(m), r.result))
    })

pub type UnitBody = { name: RootName, text: Bytes, tables: Tables, body: Bytes, size: Int }

fn defined_symbol(name: RootName, tables: Tables) -> DefinitionSymbol / {abort.raise} = {
  let found = range(0, tables.members.len()).fold(0 - 1, |acc: Int, i: Int|
    if acc < 0 && root_name(tables.members.get(i)) == name { i } else { acc });
  match tables.defined.at(if found < 0 { 0 } else { found }) {
    Some(d) -> d,
    None ->
      panic(
        String::of_bytes_lossy(
          b"an emitted body publishes the C it defines, and `".concat(root_text(name)).concat(
            b"`'s publishes none",
          ),
        ),
      ),
  }
}

fn is_group_head(name: RootName, tables: Tables, taken: Map<RootName, Bool>) -> Bool =
  match tables.members.map(root_name).filter(|m: RootName| taken.contains(m)).at(0) {
    Some(first) -> first == name,
    None -> true,
  }

fn symbol_named(name: RootName) -> Bytes / {abort.raise} = symbol_of(root_text(name))

fn entry_defined(name: RootName, d: DefinitionSymbol) -> Bytes / {abort.raise} =
  if d.entered { entry_symbol(root_text(name)) } else { b"" }

fn taken_bodies(
  results: Map<RootName, Output>,
  stored: Map<RootName, Stored>,
  taken: List<RootName>,
) -> { bodies: List<UnitBody>, defined: Map<RootName, DefinitionSymbol> } / {abort.raise} = {
  let set = taken.fold(Map::new(), |acc: Map<RootName, Bool>, n: RootName| acc.insert(n, true));
  taken.fold(
    { bodies: [], defined: Map::new() },
    |r: { bodies: List<UnitBody>, defined: Map<RootName, DefinitionSymbol> }, name: RootName|
      match results.get(name) {
        None ->
          panic(
            String::of_bytes_lossy(
              Bytes::concat_all([b"the emitter returned nothing for `", root_text(name), b"`"]),
            ),
          ),
        Some(b) -> match b.tables.calls.map(root_name).find(|c: RootName| !set.contains(c)) {
          Some(callee) ->
            panic(
              String::of_bytes_lossy(
                Bytes::concat_all([
                  b"`",
                  root_text(name),
                  b"` calls `",
                  root_text(callee),
                  b"`, which its unit does not take",
                ]),
              ),
            ),
          None ->
            {
              bodies: if is_group_head(name, b.tables, set) {
                r.bodies.push({
                  name: name,
                  text: b.text,
                  tables: b.tables,
                  body: digest_in(stored, name, b),
                  size: if b.text.len() > 0 { b.text.len() }
                  else { match stored.get(name) { Some(s) -> s.size, None -> 0 } },
                })
              } else { r.bodies },
              defined: r.defined.insert(name, defined_symbol(name, b.tables)),
            },
        },
      },
  )
}

fn runtime_enters(p: Program, k: RootKey) -> Bool =
  match k {
    Test(_) -> true,
    TestCases(_) -> true,
    Law(_) -> match p.binders.get(root_name(k)) {
      Some(types) -> types.all(|t: Type| emit::liftable(p.marshalling, t)),
      None -> false,
    },
    Clause(c) ->
      runtime_enters(p, c.definition)
        && (match c.definition {
          Named(n) -> match p.schemes.get(n) {
            Some(sc) -> emit::judgeable(p.marshalling, sc),
            None -> false,
          },
          _ -> false,
        }),
    Named(n) -> match ((p.schemes.get(n), p.roots.get(root_name(k)))) {
      (Some(sc), Some(r)) ->
        emit::enterable(p.marshalling, sc)
          && (sc.type_variables.len() == 0 || r.witnesses.len() == 0),
      (Some(sc), None) -> emit::enterable(p.marshalling, sc) && sc.type_variables.len() == 0,
      _ -> false,
    },
    _ -> false,
  }

pub type RequestedRoots = { keys: List<RootKey>, unkeyed: List<Bytes> }

pub fn requested_roots(dump: Dump) -> RequestedRoots / {abort.raise} = {
  let results_and_keys = roots_by_row_name(dump);
  dump.emitter_roots.fold({ keys: [], unkeyed: [] }, |acc: RequestedRoots, r: EmitterRoot|
    match results_and_keys.get(r.root) {
      Some(k) -> { ..acc, keys: acc.keys.push(k) },
      None -> { ..acc, unkeyed: acc.unkeyed.push(r.root) },
    })
}

fn roots_by_row_name(dump: Dump) -> Map<Bytes, RootKey> / {abort.raise} = {
  let results_and_keys = |m: Map<Bytes, RootKey>, k: RootKey| m.insert(root_text(root_name(k)), k);
  let defined = dump.definitions.fold(Map::new(), |m: Map<Bytes, RootKey>, d: DefinitionRow|
    d.spec.fold(
      { m: results_and_keys(m, Named(d.name)), requires: 0, ensures: 0 },
      |acc: { m: Map<Bytes, RootKey>, requires: Int, ensures: Int }, s: SpecRow|
        if s.kind == spec_kind_text(RequiresClause) {
          {
            ..acc,
            m: results_and_keys(
              acc.m,
              Clause({ definition: Named(d.name), kind: Requires, n: acc.requires }),
            ),
            requires: acc.requires + 1,
          }
        } else if s.kind == spec_kind_text(EnsuresClause) {
          {
            ..acc,
            m: results_and_keys(
              acc.m,
              Clause({ definition: Named(d.name), kind: Ensures, n: acc.ensures }),
            ),
            ensures: acc.ensures + 1,
          }
        } else { acc },
    ).m);
  let tested = dump.tests.fold(defined, |m: Map<Bytes, RootKey>, t: TestRow| {
    let run = test_key(t.module, t.name);
    results_and_keys(results_and_keys(m, run), TestCases(run))
  });
  dump.laws.fold(tested, |m: Map<Bytes, RootKey>, l: LawRow|
    results_and_keys(
      results_and_keys(m, law_key(l.module, l.name, LawGuard)),
      law_key(l.module, l.name, LawBody),
    ))
}

type Pools = { fields: List<Bytes>, lambdas: List<Bytes> }

fn pools_of(
  bodies: List<UnitBody>,
  statics: List<StaticDefinition>,
  constant_entries: List<{ name: RootName, entry: Bytes }>,
) -> Pools / {abort.raise} = {
  let ts = bodies.map(|k: UnitBody| k.tables);
  let all = |pick: (Tables) -> List<Bytes>|
    ts.fold([], |acc: List<Bytes>, tables: Tables| acc.concat(pick(tables)));
  {
    fields: sorted_unique(
      all(|tables: Tables| tables.fields).concat(
        statics.fold([], |acc: List<Bytes>, d: StaticDefinition| acc.concat(static_fields(d))),
      ),
    ),
    lambdas: sorted_unique(
      constant_entries.map(|c: { name: RootName, entry: Bytes }|
        nonempty_entry(c.name, c.entry)).concat(
        bodies.fold([], |acc: List<Bytes>, k: UnitBody|
          acc.concat(k.tables.lambdas.map(|l: Bytes| nonempty_entry(k.name, l)))),
      ),
    ),
  }
}

fn nonempty_entry(name: RootName, entry: Bytes) -> Bytes / {abort.raise} =
  if entry.len() > 0 { entry } else {
    panic(
      String::of_bytes_lossy(
        Bytes::concat_all([
          b"`",
          root_text(name),
          b"` names an entry of no name in the code table",
        ]),
      ),
    )
  }

fn ordered_statics(bodies: List<UnitBody>) -> List<StaticDefinition> / {abort.raise} =
  bodies.fold(
    { out: [], seen: Map::new() },
    |acc: { out: List<StaticDefinition>, seen: Map<Bytes, StaticDefinition> }, k: UnitBody|
      k.tables.statics.fold(
        acc,
        |a: { out: List<StaticDefinition>, seen: Map<Bytes, StaticDefinition> }, d: StaticDefinition|
          match a.seen.get(d.name) {
            Some(e) -> if e == d { a } else {
              panic(
                String::of_bytes_lossy(
                  b"two statics of one name contain different content: ".concat(d.name),
                ),
              )
            },
            None -> { out: a.out.push(d), seen: a.seen.insert(d.name, d) },
          },
      ),
  ).out

fn static_fields(d: StaticDefinition) -> List<Bytes> =
  words_of(d).fold([], |acc: List<Bytes>, w: StaticWord|
    match w { FieldWord(n) -> acc.push(n), _ -> acc })

fn has_fields(d: StaticDefinition) -> Bool = static_fields(d).len() > 0

fn addressed(d: StaticDefinition) -> List<Bytes> =
  words_of(d).fold([], |acc: List<Bytes>, w: StaticWord|
    match w { AddressWord(a) -> acc.push(a.name), _ -> acc })

type TablePositions = { fields: Map<Bytes, Int>, lambdas: Map<Bytes, Int> }

fn table_positions(p: Pools) -> TablePositions / {abort.raise} =
  { fields: positions(p.fields), lambdas: positions(p.lambdas) }

fn position_in(m: Map<Bytes, Int>, key: Bytes) -> Int / {abort.raise} =
  match m.get(key) {
    Some(i) -> i,
    None -> panic("the unit's tables contain everything its bodies name"),
  }

type Hole = { open_position: Int, close_position: Int, kind: Int, digits: Bytes }

fn holes(text: Bytes) -> List<Hole> / {abort.raise} =
  iterate({ from: 0, out: [] }, text.len() + 1, |s: { from: Int, out: List<Hole> }|
    match text.index_of_from(b"@@", s.from) {
      None -> Stop(s.out),
      Some(open) -> match text.index_of_from(b"@@", open + 2) {
        None -> panic("an emitted placeholder always closes"),
        Some(close) ->
          Continue({
            from: close + 2,
            out: s.out.push({
              open_position: open,
              close_position: close,
              kind: text.at(open + 2),
              digits: text.slice(open + 3, close),
            }),
          }),
      },
    })

fn keyed_key(k: Keyed, tables: Tables) -> Bytes / {abort.raise} =
  match k {
    KeyedTag(name) -> b"T".concat(name),
    KeyedField(i) -> b"f".concat(tables.fields.get(i)),
    KeyedEntry(i) -> b"l".concat(tables.lambdas.get(i)),
  }

fn keyed_of(h: Hole) -> Keyed / {abort.raise} =
  if h.kind == 84 { KeyedTag(h.digits) }
  else if h.kind == 102 { KeyedField(digits(h.digits)) }
  else if h.kind == 108 { KeyedEntry(digits(h.digits)) }
  else { panic("an emitted placeholder of no kind the unit resolves") }

fn unit_position(key: Bytes, p: TablePositions, tags: Map<Bytes, Int>) -> Int / {abort.raise} = {
  let kind = key.at(0);
  let rest = key.slice(1, key.len());
  if kind == 84 { position_in(tags, rest) }
  else if kind == 102 { position_in(p.fields, rest) }
  else { position_in(p.lambdas, rest) }
}

fn part_table(label: String) -> Bytes = b"ply_part".concat(Bytes::of_string(label))

fn own_root(body: UnitBody) -> RootName =
  match body.tables.members.at(0) { Some(m) -> root_name(m), None -> body.name }

fn resolved(
  body: UnitBody,
  site: RootName,
  table: Bytes,
  local: Map<Bytes, Int>,
) -> Bytes / {abort.raise} = {
  let text = body.text;
  let member = |h: Hole, otherwise: RootName|
    if h.digits.len() == 0 { otherwise }
    else { root_name(body.tables.members.get(digits(h.digits))) };
  let walk_levels = holes(text).fold(
    { from: 0, out: [] },
    |s: { from: Int, out: List<Bytes> }, h: Hole| {
      let value = if h.kind == 114 { ascii_of_int(root_id(root_text(member(h, site)))) }
      else if h.kind == 115 { symbol_named(member(h, own_root(body))) } else {
        Bytes::concat_all([
          table,
          b"[",
          ascii_of_int(position_in(local, keyed_key(keyed_of(h), body.tables))),
          b"]",
        ])
      };
      {
        from: h.close_position + 2,
        out: s.out.push(text.slice(s.from, h.open_position)).push(value),
      }
    },
  );
  Bytes::concat_all(walk_levels.out.push(text.slice(walk_levels.from, text.len())))
}

type IncludedRoot = {
  name: RootName,
  arity: Int,
  symbol: Bytes,
  entry: Bytes,
  prototype: Prototype,
}

fn count_line(label: Bytes, n: Int) -> Bytes =
  Bytes::concat_all([label, b" ", ascii_of_int(n), b"\n"])

fn labelled_lines(label: Bytes, xs: List<Bytes>) -> Bytes =
  Bytes::concat_all([count_line(label, xs.len())].concat(xs.map(|x: Bytes| x.concat(b"\n"))))

fn exports_text(
  helpers: List<Native>,
  constants: List<Bytes>,
  modules: Int,
  p: Pools,
  entered: List<RootName>,
) -> Bytes =
  Bytes::concat_all([
    labelled_lines(
      b"helpers",
      helpers.map(|h: Native|
        Bytes::concat_all([
          h.name,
          b" ",
          ascii_of_int(h.params.len()),
          b" ",
          dump_flag(h.result != None),
        ])),
    ),
    labelled_lines(b"constants", constants),
    count_line(b"modules", modules),
    labelled_lines(b"fields", p.fields),
    Bytes::concat_all(
      entered.map(|r: RootName| Bytes::concat_all([b"entered ", root_text(r), b"\n"])),
    ),
  ])

fn literal_lines(line: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([c_string(line), b" \"\\n\"\n"])

fn split_lines(text: Bytes) -> List<Bytes> / {abort.raise} = {
  let parts = text.split(b"\n");
  let whole = if parts.len() > 0 && parts.get(parts.len() - 1).len() == 0 {
    parts.take(parts.len() - 1)
  } else { parts };
  whole.map(|l: Bytes|
    if l.len() > 0 && l.at(l.len() - 1) == 13 { l.slice(0, l.len() - 1) } else { l })
}

fn exports_c(exports: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\n/* --- what this unit says about itself, read by the loader --- */\n",
    b"const char ply_exports[] =\n",
    Bytes::concat_all(split_lines(exports).map(literal_lines)),
    b";\n",
  ])

fn section(label: String, c: Bytes) -> Bytes = Bytes::concat_all([part_mark(label), b"\n", c])

fn taken_struct() -> Bytes =
  b"struct ply_taken { const char *name; void *entry; unsigned long arity; };\n"

fn entries_declared(entries: List<Bytes>) -> Bytes =
  Bytes::concat_all(
    sorted_unique(entries).map(|n: Bytes| Bytes::concat_all([b"extern char ", n, b";\n"])),
  )

fn taken_part(taken: List<IncludedRoot>) -> Bytes / {abort.raise} =
  section(
    "taken",
    Bytes::concat_all([
      taken_struct(),
      entries_declared(taken.map(|t: IncludedRoot| t.entry).filter(|e: Bytes| e.len() > 0)),
      b"const struct ply_taken ply_taken[] = {\n",
      Bytes::concat_all(
        taken.map(|t: IncludedRoot|
          Bytes::concat_all([
            b"  { \"",
            escaped(root_text(t.name)),
            b"\", ",
            if t.entry.len() == 0 { b"(void *)0" } else { b"(void *)&".concat(t.entry) },
            b", ",
            ascii_of_int(t.arity),
            b" },\n",
          ])),
      ),
      b"  { 0, 0, 0 } };\n",
    ]),
  )

fn tables_part(
  parts: List<Planned>,
  lambdas: List<Bytes>,
  exports: Bytes,
  taken: Int,
) -> Bytes / {abort.raise} =
  section(
    "tables",
    Bytes::concat_all([
      Bytes::concat_all(
        parts.filter(|p: Planned| p.places.len() > 0).map(|p: Planned|
          Bytes::concat_all([
            b"const uint32_t ",
            part_table(p.label),
            b"[] = {",
            Bytes::concat_all(
              p.places.map(|n: Int| Bytes::concat_all([b" ", ascii_of_int(n), b","])),
            ),
            b" };\n",
          ])),
      ),
      entries_declared(lambdas),
      b"void *const ply_code[] = {\n",
      Bytes::concat_all(lambdas.map(|n: Bytes| Bytes::concat_all([b"  (void *)&", n, b",\n"]))),
      b"  0 };\n",
      exports_c(exports),
      taken_struct(),
      b"extern const struct ply_taken ply_taken[];\n",
      b"void ply_bind(void **fns);\n",
      b"struct ply_descriptor { const char *exports; unsigned long exports_len; void *bind; void *bind_singletons; void *const *code; unsigned long code_count; const struct ply_taken *taken; unsigned long taken_count; };\n",
      b"const struct ply_descriptor ply_descriptor = { ply_exports, sizeof ply_exports - 1, (void *)ply_bind, (void *)0, ply_code, ",
      ascii_of_int(lambdas.len()),
      b", ply_taken, ",
      ascii_of_int(taken),
      b" };\n",
    ]),
  )

fn fields_part(
  statics: List<StaticDefinition>,
  constant_c: (StaticDefinition) -> Bytes / {abort.raise},
) -> Bytes / {abort.raise} = {
  let with_fields = statics.filter(has_fields);
  let own = with_fields.fold(Map::new(), |acc: Map<Bytes, Bool>, d: StaticDefinition|
    acc.insert(d.name, true));
  if with_fields.len() == 0 { b"" } else {
    section(
      "fields",
      Bytes::concat_all([
        Bytes::concat_all(
          sorted_unique(
            with_fields.fold([], |acc: List<Bytes>, d: StaticDefinition| acc.concat(addressed(d))),
          ).filter(|n: Bytes| !own.contains(n)).map(
            static_extern,
          ),
        ),
        Bytes::concat_all(with_fields.map(constant_c)),
      ]),
    )
  }
}

type BucketBody = { text: Bytes, statics: List<Bytes>, shared: List<SharedFn> }

type BodyHoles = { body: UnitBody, keys: List<Bytes> }

pub type PartRule = { bits: Int, min: Int, max: Int }

pub fn part_rule() -> PartRule = { bits: 6, min: 65536, max: 1048576 }

fn home_of(k: RootKey) -> Bytes =
  match inlined_lambdas(k).at(0) { Some(f) -> module_of(f.owner), None -> module_of(k) }

fn order_key(home: Bytes, name: RootName) -> Bytes =
  Bytes::concat_all([home, b"\x00", root_text(name)])

fn split_into_parts(bodies: List<BodyHoles>, rule: PartRule) -> List<List<BodyHoles>> = {
  let walk_levels = bodies.fold(
    { parts: [], part: [], bytes: 0 },
    |acc: { parts: List<List<BodyHoles>>, part: List<BodyHoles>, bytes: Int }, m: BodyHoles| {
      let size = m.body.size;
      let picked = root_id(root_text(m.body.name)) & (1 << rule.bits) - 1 == 0;
      if acc.part.len() > 0 && ((acc.bytes >= rule.min && picked) || acc.bytes + size > rule.max) {
        { parts: acc.parts.push(acc.part), part: [m], bytes: size }
      } else { { parts: acc.parts, part: acc.part.push(m), bytes: acc.bytes + size } }
    },
  );
  if walk_levels.part.len() == 0 { walk_levels.parts }
  else { walk_levels.parts.push(walk_levels.part) }
}

fn part_label(name: RootName) -> String / {abort.raise} =
  String::of_bytes(hex(u64_be(root_id(root_text(name)))))

type Part = {
  label: String,
  places: List<Int>,
  bodies: List<BucketBody>,
  constants: List<StaticDefinition>,
}

fn part_keys(group: List<BodyHoles>) -> List<Bytes> =
  sorted_unique(group.fold([], |acc: List<Bytes>, m: BodyHoles| acc.concat(m.keys)))

fn constants_defined(
  group: List<BodyHoles>,
  defined: Map<Bytes, Bool>,
) -> { constants: List<StaticDefinition>, defined: Map<Bytes, Bool> } =
  group.fold(
    { constants: [], defined: defined },
    |acc: { constants: List<StaticDefinition>, defined: Map<Bytes, Bool> }, m: BodyHoles|
      m.body.tables.statics.fold(
        acc,
        |a: { constants: List<StaticDefinition>, defined: Map<Bytes, Bool> }, d: StaticDefinition|
          if has_fields(d) || a.defined.contains(d.name) { a }
          else { { constants: a.constants.push(d), defined: a.defined.insert(d.name, true) } },
      ),
  )

fn reaches_of(name: RootName, tables: Tables) -> List<RootName> =
  sorted_unique(
    tables.calls.map(root_name).concat(if tables.members.len() == 0 { [name] }
    else { tables.members.map(root_name) }),
  )

fn prototype(symbol: Bytes, head: Prototype) -> Bytes =
  Bytes::concat_all([
    head.result,
    b" ",
    symbol,
    b"(PlyCtx*",
    Bytes::concat_all(head.params.map(|t: Bytes| b", ".concat(t))),
    b");\n",
  ])

fn part_c(
  p: Part,
  prototypes: List<Bytes>,
  natives: List<Native>,
  constant_c: (StaticDefinition) -> Bytes / {abort.raise},
) -> Bytes / {abort.raise} = {
  let defined = p.constants.fold(Map::new(), |acc: Map<Bytes, Bool>, d: StaticDefinition|
    acc.insert(d.name, true));
  Bytes::concat_all([
    part_mark(p.label),
    b"\n",
    if p.places.len() == 0 { b"" }
    else { Bytes::concat_all([b"extern const uint32_t ", part_table(p.label), b"[];\n"]) },
    Bytes::concat_all(
      sorted_unique(
        p.bodies.fold([], |acc: List<Bytes>, body: BucketBody| acc.concat(body.statics)),
      ).filter(|n: Bytes| !defined.contains(n)).map(
        static_extern,
      ),
    ),
    Bytes::concat_all(prototypes),
    Bytes::concat_all(natives.map(pointer_declared)),
    b"\n",
    Bytes::concat_all(p.constants.map(constant_c)),
    shared_functions_c(p.bodies),
    Bytes::concat_all(p.bodies.map(|body: BucketBody| body.text.concat(b"\n"))),
  ])
}

fn machine_called(
  bodies: List<UnitBody>,
  machine_of: (Map<Bytes, Bool>) -> List<Native> / {abort.raise},
) -> List<Native> / {abort.raise} = {
  let beyond = bound_functions().fold(natives_of(bodies), |acc: Map<Bytes, Bool>, n: Native|
    acc.remove(n.name));
  if beyond.len() == 0 { [] } else { machine_of(beyond) }
}

fn shared_functions_c(group: List<BucketBody>) -> Bytes =
  group.fold(
    { seen: Map::new(), out: [] },
    |acc: { seen: Map<Bytes, Bool>, out: List<Bytes> }, p: BucketBody|
      p.shared.fold(acc, |a: { seen: Map<Bytes, Bool>, out: List<Bytes> }, f: SharedFn|
        if a.seen.contains(f.symbol) { a }
        else { { seen: a.seen.insert(f.symbol, true), out: a.out.push(f.text) } }),
  ).out.fold(b"", |acc: Bytes, t: Bytes| acc.concat(t))

fn placing(
  m: BodyHoles,
  site: RootName,
  table: Bytes,
  local: Map<Bytes, Int>,
) -> BucketBody / {abort.raise} =
  {
    text: resolved(m.body, site, table, local),
    statics: m.body.tables.statics.map(|d: StaticDefinition| d.name),
    shared: m.body.tables.shared,
  }

type Planned = {
  label: String,
  keys: List<Bytes>,
  places: List<Int>,
  group: List<BodyHoles>,
  constants: List<StaticDefinition>,
}

fn planned(
  bodies: List<BodyHoles>,
  rule: PartRule,
  position: (Bytes) -> Int / {abort.raise},
) -> List<Planned> / {abort.raise} =
  split_into_parts(bodies, rule).fold(
    { parts: [], defined: Map::new() },
    |acc: { parts: List<Planned>, defined: Map<Bytes, Bool> }, group: List<BodyHoles>| {
      let keys = part_keys(group);
      let c = constants_defined(group, acc.defined);
      {
        parts: acc.parts.push({
          label: part_label(group.get(0).body.name),
          keys: keys,
          places: keys.map(position),
          group: group,
          constants: c.constants,
        }),
        defined: c.defined,
      }
    },
  ).parts

type PartPlan = {
  label: String,
  keys: List<Bytes>,
  bodies: List<{ name: Bytes, site: Bytes, body: Bytes, named: List<Bytes>, tables: Tables }>,
  constants: List<StaticDefinition>,
  prototypes: List<Bytes>,
  natives: List<Bytes>,
}

derive bin for PartPlan

type CachedPart = { digest: String, size: Int }

derive bin for CachedPart

fn part_record(key: Bytes) -> Bytes = b"part\x00".concat(key)

fn part_written<| e>(
  p: Planned,
  site: (RootName) -> RootName / {abort.raise},
  taken: Map<RootName, IncludedRoot>,
  machine: List<Native>,
  constant_c: (StaticDefinition) -> Bytes / {abort.raise},
  stored: Map<RootName, Stored>,
  named: Map<RootName, List<RootName>>,
  read: (Bytes) -> Option<Bytes> / e,
  source_cached: (String) -> Bool / e,
) -> { part: WrittenPart, records: List<Record> } / {abort.raise | e} = {
  let prototypes = sorted_unique(
    p.group.fold([], |acc: List<RootName>, m: BodyHoles|
      acc.concat(reaches_of(m.body.name, m.body.tables))),
  ).map(|name: RootName|
    match taken.get(name) { Some(t) -> prototype(t.symbol, t.prototype), None -> b"" });
  let called = p.group.fold(Map::new(), |acc: Map<Bytes, Bool>, m: BodyHoles|
    m.body.tables.natives.fold(acc, |x: Map<Bytes, Bool>, n: Bytes| x.insert(n, true)));
  let natives = machine.filter(|n: Native| called.contains(n.name));
  let plan = {
    label: p.label,
    keys: p.keys,
    bodies: p.group.map(|m: BodyHoles|
      {
        name: root_text(m.body.name),
        site: root_text(site(m.body.name)),
        body: m.body.body,
        named: match named.get(m.body.name) { Some(rs) -> rs.map(root_text), None -> [] },
        tables: { ..m.body.tables, shared: [] },
      }),
    constants: p.constants,
    prototypes: prototypes,
    natives: natives.map(pointer_declared),
  };
  let key = blake3(bin::encode(plan, part_plan_bin()));
  let recorded = match read(part_record(key)) {
    Some(b) -> match bin::decode(b, cached_part_bin()) { Ok(k) -> Some(k), Err(_) -> None },
    None -> None,
  };
  let reused = match recorded {
    Some(k) -> if source_cached(k.digest) { recorded } else { None },
    None -> None,
  };
  match reused {
    Some(k) ->
      { part: { label: p.label, digest: k.digest, size: k.size, text: None }, records: [] },
    None -> {
      let local = positions(p.keys);
      let bodies = p.group.map(|m: BodyHoles| {
        let a = resolved_text(
          m.body.name,
          { text: m.body.text, tables: m.body.tables },
          stored,
          named,
          read,
        );
        placing(
          { ..m, body: { ..m.body, text: a.text, tables: a.tables } },
          site(m.body.name),
          part_table(p.label),
          local,
        )
      });
      let text = part_c(
        { label: p.label, places: p.places, bodies: bodies, constants: p.constants },
        prototypes,
        natives,
        constant_c,
      );
      let part = written_part(unit_header(), p.label, text);
      let made = { digest: part.digest, size: part.size };
      {
        part: part,
        records: if recorded == Some(made) { [] }
        else { [{ key: part_record(key), bytes: bin::encode(made, cached_part_bin()) }] },
      }
    },
  }
}

pub fn produce<| e>(
  constructors: List<Constructor>,
  offered: List<RequestedRoot>,
  modules: Int,
  results: Map<RootName, Output>,
  inputs: Map<Bytes, Bytes>,
  machine_of: (Map<Bytes, Bool>) -> List<Native> / {abort.raise},
  rule: PartRule,
  stored: Map<RootName, Stored>,
  named: Map<RootName, List<RootName>>,
  read: (Bytes) -> Option<Bytes> / e,
  source_cached: (String) -> Bool / e,
) -> UnitOutput / {abort.raise | e} = {
  let offers = offered.fold(Map::new(), |acc: Map<RootName, RequestedRoot>, o: RequestedRoot|
    acc.insert(o.name, o));
  let offer_of = |n: RootName|
    match offers.get(n) { Some(o) -> o, None -> panic("every body a unit takes was offered it") };
  let names = sorted_unique(offered.map(|o: RequestedRoot| o.name));
  let s = taken_bodies(results, stored, names);
  let machine = machine_called(s.bodies, machine_of);
  let published = |n: RootName|
    match s.defined.get(n) {
      Some(d) -> d,
      None -> panic("every definition a unit takes emitted, and an emitted body publishes its C"),
    };
  let entry = |n: RootName| entry_defined(n, published(n));
  let constants = names.filter(|n: RootName|
    match offers.get(n) { Some(o) -> o.constant, None -> false });
  let statics = ordered_statics(s.bodies);
  let pools = pools_of(
    s.bodies,
    statics,
    constants.map(|n: RootName| { name: n, entry: entry(n) }),
  );
  let placed = table_positions(pools);
  let constant_c = |d: StaticDefinition|
    static_c(
      d,
      |f: Bytes| position_in(placed.fields, f),
      |k: RootKey| symbol_named(root_name(k)),
      |digest: Bytes|
        match inputs.get(digest) {
          Some(b) -> b,
          None ->
            panic(
              "a unit holds an embedded file it was not handed the bytes of, which its driver reads for every embed it emits",
            ),
        },
    );
  let tags = positions(constructors.map(|c: Constructor| c.name));
  let taken = names.map(|n: RootName|
    {
      name: n,
      arity: match offers.get(n) { Some(o) -> o.arity, None -> 0 },
      symbol: symbol_named(n),
      entry: entry(n),
      prototype: published(n).head,
    });
  s.bodies.fold((), |_u: Unit, k: UnitBody|
    k.tables.generics.expects.fold((), |_v: Unit, e: ExpectedPrototype|
      match callee_name(k.tables, e) {
        None -> (),
        Some(callee) -> match s.defined.get(callee) {
          Some(d) -> if d.head != e.head {
            panic(
              String::of_bytes_lossy(
                Bytes::concat_all([
                  b"`",
                  root_text(k.name),
                  b"` calls `",
                  root_text(callee),
                  b"` as ",
                  prototype(symbol_named(callee), e.head),
                  b"which it defines as ",
                  prototype(symbol_named(callee), d.head),
                ]),
              ),
            )
          } else { () },
          None -> (),
        },
      }));
  let marked = s.bodies.fold(Map::new(), |acc: Map<Bytes, BodyHoles>, k: UnitBody|
    acc.insert(order_key(offer_of(k.name).home, k.name), {
      body: k,
      keys: k.tables.keyed.map(|x: Keyed| keyed_key(x, k.tables)),
    })).values(
  );
  let plans = planned(marked, rule, |k: Bytes| unit_position(k, placed, tags));
  let exports = exports_text(
    bound_functions().concat(machine),
    constants.map(|n: RootName|
      Bytes::concat_all([root_text(n), b" ", ascii_of_int(position_in(placed.lambdas, entry(n)))])),
    modules,
    pools,
    offered.filter(|o: RequestedRoot| o.name == entry_name(o.site)).map(|o: RequestedRoot| o.site),
  );
  let by_name = taken.fold(Map::new(), |acc: Map<RootName, IncludedRoot>, t: IncludedRoot|
    acc.insert(t.name, t));
  let written = plans.fold(
    { parts: [], records: [] },
    |acc: { parts: List<WrittenPart>, records: List<Record> }, p: Planned| {
      let w = part_written(
        p,
        |n: RootName| offer_of(n).site,
        by_name,
        machine,
        constant_c,
        stored,
        named,
        read,
        source_cached,
      );
      { parts: acc.parts.push(w.part), records: acc.records.concat(w.records) }
    },
  );
  let tail = [
    { label: "runtime", text: unit_tail(machine) },
    { label: "fields", text: fields_part(statics, constant_c) },
    { label: "taken", text: taken_part(by_name.values()) },
    { label: "tables", text: tables_part(plans, pools.lambdas, exports, by_name.len()) },
  ].filter(|s: { label: String, text: Bytes }| s.text.len() > 0).map(
    |s: { label: String, text: Bytes }| written_part(unit_header(), s.label, s.text),
  );
  {
    parts: written.parts.concat(tail),
    taken: names,
    made: { bodies: s.bodies, requested: offered, named: named },
    records: written.records,
  }
}

pub fn cache_parts(
  parts: List<WrittenPart>,
) -> Result<List<Source>, String> / {toolchain.read, toolchain.write, abort.raise} =
  cc::cache_sources(unit_header(), parts)

pub fn read_back(sources: List<Source>) -> Result<Bytes, String> / {toolchain.read, abort.raise} =
  cc::read_back(unit_header(), sources)

fn body_names(body: UnitBody) -> List<RootName> =
  if body.tables.members.len() == 0 { [body.name] } else { body.tables.members.map(root_name) }

fn request_text(roots: Map<RootName, RequestedRoot>, body: UnitBody) -> Bytes =
  Bytes::concat_all(
    body_names(body).map(|name: RootName|
      match roots.get(name) {
        Some(o) ->
          Bytes::concat_all([
            root_text(name),
            b" ",
            ascii_of_int(o.arity),
            if o.constant { b" constant\n" } else { b"\n" },
          ]),
        None -> root_text(name).concat(b" unoffered\n"),
      }),
  )

pub fn codes(made: UnitContents) -> Map<RootName, Bytes> / {abort.raise} = {
  let bodies = made.bodies;
  let n = bodies.len();
  let index = range(0, n).fold(Map::new(), |acc: Map<RootName, Int>, i: Int|
    body_names(bodies.get(i)).fold(acc, |m: Map<RootName, Int>, name: RootName| m.insert(name, i)));
  let roots = made.requested.fold(
    Map::new(),
    |acc: Map<RootName, RequestedRoot>, o: RequestedRoot| acc.insert(o.name, o),
  );
  let own = bodies.map(|b: UnitBody|
    blake3(
      Bytes::concat_all([
        blake3(root_text(b.name)),
        b.body,
        blake3(bin::encode({ ..b.tables, shared: [] }, tables_bin())),
        blake3(request_text(roots, b)),
      ]),
    ));
  let adj = bodies.map(|b: UnitBody|
    b.tables.calls.fold([], |acc: List<Int>, c: RootKey|
      match index.get(root_name(c)) { Some(j) -> acc.push(j), None -> acc }));
  let components = graph::components({ out: adj });
  let reached = components.fold(Map::new(), |done: Map<Int, Bytes>, comp: List<Int>| {
    let inside = comp.fold(Map::new(), |m: Map<Int, Bool>, i: Int| m.insert(i, true));
    let below = comp.fold([], |acc: List<Bytes>, i: Int|
      adj.get(i).fold(acc, |a: List<Bytes>, j: Int|
        if inside.contains(j) { a }
        else { match done.get(j) { Some(d) -> a.push(d), None -> a } }));
    let digest = blake3(
      Bytes::concat_all(sorted_unique(comp.map(|i: Int| own.get(i))).concat(sorted_unique(below))),
    );
    comp.fold(done, |m: Map<Int, Bytes>, i: Int| m.insert(i, digest))
  });
  range(0, n).fold(Map::new(), |acc: Map<RootName, Bytes>, i: Int| {
    let code = blake3(own.get(i).concat(match reached.get(i) { Some(d) -> d, None -> b"" }));
    body_names(bodies.get(i)).fold(acc, |m: Map<RootName, Bytes>, name: RootName|
      m.insert(name, code))
  })
}

type Program = {
  roots: Map<RootName, EmitterRoot>,
  keys: Map<RootName, Bytes>,
  modules: List<ModuleRow>,
  imports: Map<Bytes, List<Bytes>>,
  read: Map<Bytes, List<Bytes>>,
  sources: List<Bytes>,
  embeds: Map<Int, Bytes>,
  schemes: Map<Bytes, Scheme>,
  binders: Map<RootName, List<Type>>,
  marshalling: MarshalledSums,
  declared: Map<Bytes, Bytes>,
  digests: Map<Bytes, Bytes>,
  constructor_functions: Map<Bytes, Bool>,
}

fn program_of(dump: Dump, sources: List<Bytes>, roots: List<RootKey>) -> Program / {abort.raise} = {
  let results_and_keys = roots_by_row_name(dump);
  let named = |row: Bytes|
    match results_and_keys.get(row) { Some(k) -> Some(root_name(k)), None -> None };
  let by_name = dump.modules.fold(Map::new(), |acc: Map<Bytes, ModuleRow>, m: ModuleRow|
    acc.insert(m.name, m));
  let read = modules_read(by_name, modules_lowered(roots).keys().push(prelude_module()));
  let reads = dump.embeds.fold(Map::new(), |acc: Map<Int, List<Bytes>>, e: ModuleEmbed|
    match by_name.get(e.module) {
      None -> acc,
      Some(m) ->
        acc.insert(
          m.index,
          List::push(
            match acc.get(m.index) { Some(xs) -> xs, None -> [] },
            length_prefixed(e.key).concat(embed_read_digest(e.read)),
          ),
        ),
    });
  let schemes = dump.rows.definitions.fold(
    Map::new(),
    |acc: Map<Bytes, Scheme>, row: KnownDefinitionRow| acc.insert(row.name, row.scheme),
  );
  let prelude = prelude_module().concat(b".");
  {
    roots: dump.emitter_roots.fold(
      Map::new(),
      |acc: Map<RootName, EmitterRoot>, root: EmitterRoot|
        match named(root.root) { Some(n) -> acc.insert(n, root), None -> acc },
    ),
    keys: dump.keys.fold(Map::new(), |acc: Map<RootName, Bytes>, k: KeyRow|
      match named(k.root) { Some(n) -> acc.insert(n, k.key), None -> acc }),
    modules: dump.ordinals.fold([], |acc: List<ModuleRow>, o: OrdinalRow|
      match by_name.get(o.module) { Some(m) -> acc.push(m), None -> acc }),
    imports: by_name.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, n: Bytes, m: ModuleRow|
      acc.insert(n, m.imports)),
    read: read,
    sources: sources,
    embeds: reads.fold(Map::new(), |acc: Map<Int, Bytes>, i: Int, parts: List<Bytes>|
      acc.insert(i, blake3(Bytes::concat_all(sorted_unique(parts))))),
    schemes: schemes,
    binders: dump.laws.fold(Map::new(), |acc: Map<RootName, List<Type>>, l: LawRow| {
      let types = l.binders.map(|b: BinderRow| b.ty);
      [LawGuard, LawBody].fold(acc, |m: Map<RootName, List<Type>>, part: LawPart|
        m.insert(root_name(law_key(l.module, l.name, part)), types))
    }),
    marshalling: marshalled_sums(constructor_sums(dump.constructors), |n: Bytes|
      schemes.contains(prelude.concat(n))),
    declared: {
      let types = dump.types.fold(Map::new(), |acc: Map<Bytes, Bool>, t: TypeRow|
        acc.insert(t.name, true));
      dump.hashes.fold(Map::new(), |acc: Map<Bytes, Bytes>, f: HashTableRow|
        match f {
          DefinitionHashRow(row) -> match row.declaration {
            Some(h) -> if types.contains(row.name) { acc.insert(row.name, h) } else { acc },
            None -> acc,
          },
          _ -> acc,
        })
    },
    digests: read.fold(Map::new(), |acc: Map<Bytes, Bytes>, m: Bytes, _: List<Bytes>|
      match match by_name.get(m) { Some(row) -> sources.at(row.index), None -> None } {
        Some(t) -> acc.insert(m, blake3(t)),
        None -> acc,
      }),
    constructor_functions: stated_functions(dump),
  }
}

fn modules_read(
  by_name: Map<Bytes, ModuleRow>,
  starts: List<Bytes>,
) -> Map<Bytes, List<Bytes>> / {abort.raise} = {
  let dependencies = |m: Bytes|
    match by_name.get(m) { Some(row) -> row.imports.concat(row.unimported), None -> [] };
  iterate(
    { read: Map::new(), next: starts.filter(|m: Bytes| by_name.contains(m)) },
    by_name.len() + 1,
    |s: { read: Map<Bytes, List<Bytes>>, next: List<Bytes> }| {
      let read = s.next.fold(s.read, |acc: Map<Bytes, List<Bytes>>, m: Bytes|
        if acc.contains(m) { acc } else { acc.insert(m, dependencies(m)) });
      let next = s.next.fold([], |acc: List<Bytes>, m: Bytes|
        if s.read.contains(m) { acc } else {
          (match read.get(m) { Some(ds) -> ds, None -> [] }).fold(acc, |a: List<Bytes>, d: Bytes|
            if read.contains(d) { a } else { a.push(d) })
        });
      if next.len() == 0 { Stop({ read: read, next: [] }) }
      else { Continue({ read: read, next: next }) }
    },
  ).read
}

fn modules_asked(p: Program, ks: List<RootKey>) -> Map<Bytes, Bool> / {abort.raise} = {
  let starts = ks.fold(
    modules_lowered(ks).insert(prelude_module(), true),
    |acc: Map<Bytes, Bool>, k: RootKey|
      types_keyed(k).fold(acc, |m: Map<Bytes, Bool>, t: Type|
        type_names(t).fold(m, |into: Map<Bytes, Bool>, n: Bytes| {
          let home = module_of_name(n);
          if home.len() == 0 { into } else { into.insert(home, true) }
        })),
  );
  iterate(
    { closed: Map::new(), next: starts.keys().filter(|m: Bytes| p.read.contains(m)) },
    p.read.len() + 1,
    |s: { closed: Map<Bytes, Bool>, next: List<Bytes> }| {
      let closed = s.next.fold(s.closed, |acc: Map<Bytes, Bool>, m: Bytes| acc.insert(m, true));
      let next = s.next.fold(Map::new(), |acc: Map<Bytes, Bool>, m: Bytes|
        List::fold(
          match p.read.get(m) { Some(ds) -> ds, None -> [] },
          acc,
          |a: Map<Bytes, Bool>, d: Bytes| if closed.contains(d) { a } else { a.insert(d, true) },
        ));
      if next.len() == 0 { Stop({ closed: closed, next: [] }) }
      else { Continue({ closed: closed, next: next.keys() }) }
    },
  ).closed
}

fn types_keyed(k: RootKey) -> List<Type> =
  match k {
    Specialisation(_, _) ->
      inlined_lambdas(k).fold(key_types(k), |acc: List<Type>, f: InlinedLambda|
        acc.concat(types_keyed(f.owner))),
    Generated(w, _) -> [w.ty],
    Clause(c) -> types_keyed(c.definition),
    EntryPoint(e) -> types_keyed(e),
    _ -> [],
  }

fn stated_functions(dump: Dump) -> Map<Bytes, Bool> =
  dump.emitter_constructors.fold(Map::new(), |acc: Map<Bytes, Bool>, c: EmitterConstructor|
    [c.key, c.show].fold(
      c.numeric.fold(acc, |m: Map<Bytes, Bool>, f: Bytes| m.insert(f, true)),
      |m: Map<Bytes, Bool>, f: Option<Bytes>| match f { Some(n) -> m.insert(n, true), None -> m },
    ))

fn text_at(program: Program, index: Int) -> Option<Bytes> = program.sources.at(index)

fn root_cache_key(program: Program, types: Bytes, k: RootKey) -> Option<Bytes> = {
  let name = root_text(root_name(k));
  match k {
    Generated(_, _) -> match program.digests.get(module_of(k)) {
      None -> None,
      Some(d) -> Some(Bytes::concat_all([name, b"\x00", types, b"\x00", d])),
    },
    Specialisation(a, _) ->
      a.borrowed.fold(
        match definition_cache_key(program, root_name(Named(a.definition))) {
          Some(m) -> Some(Bytes::concat_all([m, b"\x00", name, declared_type_hashes(program, k)])),
          None -> None,
        },
        |acc: Option<Bytes>, f: InlinedLambda|
          match acc {
            None -> None,
            Some(m) -> match definition_cache_key(program, site_owner(f.owner)) {
              Some(o) -> Some(Bytes::concat_all([m, b"\x00", o])),
              None -> None,
            },
          },
      ),
    EntryPoint(e) -> match definition_cache_key(program, root_name(e)) {
      Some(m) -> Some(Bytes::concat_all([m, b"\x00", name])),
      None -> None,
    },
    Named(n) -> match definition_cache_key(program, root_name(k)) {
      Some(m) ->
        Some(if program.constructor_functions.contains(n) { m.concat(b"\x00stated") } else { m }),
      None -> None,
    },
    Clause(c) -> match c.definition {
      Specialisation(a, _) -> match definition_cache_key(
          program,
          root_name(Clause({ ..c, definition: Named(a.definition) })),
        ) {
        Some(m) ->
          Some(Bytes::concat_all([m, b"\x00", name, declared_type_hashes(program, c.definition)])),
        None -> None,
      },
      _ -> definition_cache_key(program, root_name(k)),
    },
    _ -> definition_cache_key(program, root_name(k)),
  }
}

fn types_digest(dump: Dump) -> Bytes / {abort.raise} =
  blake3(
    Bytes::concat_all(
      dump.constructors.map(|c: ConstructorRow|
        Bytes::concat_all([
          c.name,
          b"\x00",
          ascii_of_int(c.index),
          b"\x00",
          type_text(c.scheme.ty),
          b"\x01",
        ])).concat(
        dump.emitter_constructors.map(|c: EmitterConstructor|
          Bytes::concat_all([
            c.name,
            b"\x00",
            match c.key { Some(k) -> k, None -> b"" },
            b"\x00",
            match c.show { Some(s) -> s, None -> b"" },
            b"\x00",
            Bytes::concat_all(c.numeric.map(|f: Bytes| f.concat(b","))),
            b"\x00",
            match c.release {
              Some(f) ->
                f.concat(b"\x00").concat(match definition_scheme(dump, f) {
                  Some(sc) -> type_text(sc.ty),
                  None -> b"",
                }),
              None -> b"",
            },
            b"\x01",
          ])),
      ),
    ),
  )

fn definition_scheme(dump: Dump, by: Bytes) -> Option<Scheme> =
  match dump.rows.definitions.find(|d: KnownDefinitionRow| d.name == by) {
    Some(d) -> Some(d.scheme),
    None -> None,
  }

fn declared_type_hashes(program: Program, k: RootKey) -> Bytes = {
  let names = key_types(k).fold(Map::new(), |acc: Map<Bytes, Bool>, t: Type|
    type_names(t).fold(acc, |m: Map<Bytes, Bool>, n: Bytes| m.insert(n, true)));
  Bytes::concat_all(
    names.keys().map(|n: Bytes|
      match program.declared.get(n) {
        Some(h) -> Bytes::concat_all([b"\x00", n, b"=", h]),
        None -> b"",
      }),
  )
}

fn definition_cache_key(program: Program, name: RootName) -> Option<Bytes> =
  match program.keys.get(name) {
    None -> None,
    Some(key) -> match program.roots.get(name) {
      None -> None,
      Some(r) -> match text_at(program, r.at.module) {
        None -> None,
        Some(text) -> if r.at.start < 0 || r.at.end > text.len() || r.at.start > r.at.end { None }
        else {
          Some(
            Bytes::concat_all([
              root_text(name),
              b"\x00",
              key,
              b"\x00",
              blake3(text.slice(r.at.start, r.at.end)),
              match program.embeds.get(r.at.module) { Some(d) -> d, None -> b"" },
            ]),
          )
        },
      },
    },
  }

pub fn results_store(bodies: String, runtime: Runtime, emitter: Bytes) -> String / {abort.raise} = {
  let id = blake3(
    Bytes::concat_all(
      [
        b"ply.unit.answer.5",
        hex(bin::shape_digest(cached_result_bin())),
        runtime.identity,
        emitter,
      ].map(|b: Bytes| length_prefixed(b)),
    ),
  );
  bodies ++ "/answers-" ++ id.slice(0, 16).hex_of()
}

fn result_record_key(m: Bytes) -> Bytes = b"answer\x00".concat(m)

fn callee_record_key(d: Bytes) -> Bytes = b"key\x00".concat(d)

fn body_key(m: Bytes) -> Bytes = b"body\x00".concat(m)

fn key_digest(k: RootKey) -> Bytes / {abort.raise} = blake3(key_bytes(k))

fn fully_cached_results(
  looked: Map<RootName, Output>,
  offered: Map<RootName, Bool>,
) -> Map<RootName, Output> =
  looked.fold(Map::new(), |acc: Map<RootName, Output>, n: RootName, a: Output|
    if a.tables.members.fold(true, |ok: Bool, m: RootKey|
        ok && offered.contains(root_name(m))
          && (match looked.get(root_name(m)) {
            Some(other) -> other.tables.members == a.tables.members,
            None -> false,
          })) { acc.insert(n, a) }
    else { acc })

type CachedResult = {
  result: Output,
  calls: List<Bytes>,
  callees: List<Option<Bytes>>,
  body: Bytes,
  size: Int,
}

derive bin for CachedResult

type Body = { text: Bytes, shared: List<SharedFn> }

derive bin for Body

fn output_body(a: Output) -> Body = { text: a.text, shared: a.tables.shared }

fn summarised(a: Output) -> Output = { text: b"", tables: { ..a.tables, shared: [] } }

fn body_digest(a: Output) -> Bytes / {abort.raise} = blake3(bin::encode(output_body(a), body_bin()))

type Stored = { cache_key: Bytes, body: Bytes, size: Int }

fn callees_of(a: Output) -> List<RootName> = sorted_unique(a.tables.calls.map(root_name))

fn cached_result_of(keys: Map<RootName, Bytes>, a: Output) -> CachedResult / {abort.raise} = {
  let s = summarised(a);
  {
    result: { ..s, tables: { ..s.tables, calls: [] } },
    calls: a.tables.calls.map(key_digest),
    callees: callees_of(a).map(|c: RootName| keys.get(c)),
    body: body_digest(a),
    size: a.text.len(),
  }
}

fn callees_unchanged(keys: Map<RootName, Bytes>, a: Output, callees: List<Option<Bytes>>) -> Bool = {
  let names = callees_of(a);
  names.len() == callees.len()
    && range(0, names.len()).all(|i: Int|
      match names.at(i) { Some(n) -> callees.at(i) == Some(keys.get(n)), None -> false })
}

fn restored_result(
  keys: Map<RootName, Bytes>,
  resolved: Map<Bytes, RootKey>,
  k: CachedResult,
) -> Option<Output> =
  if !k.calls.all(|d: Bytes| resolved.contains(d)) { None } else {
    let a = {
      ..k.result,
      tables: {
        ..k.result.tables,
        calls: k.calls.fold([], |acc: List<RootKey>, d: Bytes|
          match resolved.get(d) { Some(r) -> acc.push(r), None -> acc }),
      },
    };
    if callees_unchanged(keys, a, k.callees) { Some(a) } else { None }
  }

type CachedResults = {
  results: Map<RootName, Output>,
  stored: Map<RootName, Stored>,
  known: Map<Bytes, Bool>,
}

fn cached_results<| e>(
  keys: Map<RootName, Bytes>,
  materials: Map<RootName, Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
) -> CachedResults / {abort.raise | e} = {
  let found = materials.fold(
    Map::new(),
    |acc: Map<RootName, CachedResult>, n: RootName, m: Bytes|
      match read(result_record_key(m)) {
        Some(b) -> match bin::decode(b, cached_result_bin()) {
          Ok(k) -> acc.insert(n, k),
          Err(_) -> acc,
        },
        None -> acc,
      },
  );
  let digests = found.fold(Map::new(), |acc: Map<Bytes, Bool>, _: RootName, k: CachedResult|
    k.calls.fold(acc, |a: Map<Bytes, Bool>, d: Bytes| a.insert(d, true)));
  let resolved = digests.fold(Map::new(), |acc: Map<Bytes, RootKey>, d: Bytes, _: Bool|
    match read(callee_record_key(d)) {
      Some(b) -> match bin::decode(b, root_key_bin()) { Ok(r) -> acc.insert(d, r), Err(_) -> acc },
      None -> acc,
    });
  let results = found.fold(
    Map::new(),
    |acc: Map<RootName, Output>, n: RootName, k: CachedResult|
      match restored_result(keys, resolved, k) { Some(a) -> acc.insert(n, a), None -> acc },
  );
  {
    results: results,
    stored: results.fold(Map::new(), |acc: Map<RootName, Stored>, n: RootName, _: Output|
      match ((materials.get(n), found.get(n))) {
        (Some(m), Some(k)) -> acc.insert(n, { cache_key: m, body: k.body, size: k.size }),
        _ -> acc,
      }),
    known: resolved.fold(Map::new(), |acc: Map<Bytes, Bool>, d: Bytes, _: RootKey|
      acc.insert(d, true)),
  }
}

fn cached_among(cached: CachedResults, materials: Map<RootName, Bytes>) -> CachedResults =
  {
    results: materials.fold(Map::new(), |acc: Map<RootName, Output>, n: RootName, _: Bytes|
      match cached.results.get(n) { Some(a) -> acc.insert(n, a), None -> acc }),
    stored: materials.fold(Map::new(), |acc: Map<RootName, Stored>, n: RootName, _: Bytes|
      match cached.stored.get(n) { Some(s) -> acc.insert(n, s), None -> acc }),
    known: Map::new(),
  }

fn results_to_cache<| e>(
  keys: Map<RootName, Bytes>,
  materials: Map<RootName, Bytes>,
  results: Map<RootName, Output>,
  known: Map<Bytes, Bool>,
  read: (Bytes) -> Option<Bytes> / e,
) -> { records: List<Record>, known: Map<Bytes, Bool> } / {abort.raise | e} =
  results.fold(
    { records: [], known: known },
    |acc: { records: List<Record>, known: Map<Bytes, Bool> }, n: RootName, a: Output|
      match materials.get(n) {
        Some(m) -> {
          let called = a.tables.calls.fold(
            acc,
            |x: { records: List<Record>, known: Map<Bytes, Bool> }, k: RootKey| {
              let d = key_digest(k);
              if x.known.contains(d) { x }
              else if read(callee_record_key(d)) != None { { ..x, known: x.known.insert(d, true) } }
              else {
                {
                  records: x.records.push({ key: callee_record_key(d), bytes: key_bytes(k) }),
                  known: x.known.insert(d, true),
                }
              }
            },
          );
          {
            ..called,
            records: called.records.push({
              key: result_record_key(m),
              bytes: bin::encode(cached_result_of(keys, a), cached_result_bin()),
            }).push({ key: body_key(m), bytes: bin::encode(output_body(a), body_bin()) }),
          }
        },
        None -> acc,
      },
  )

fn program_constructors(dump: Dump, constructors: List<Constructor>) -> Constructors = {
  let table = constructors_of(
    constructors.map(|c: Constructor| c.name),
    dump.emitter_constructors.filter(|c: EmitterConstructor| c.key != None).map(
      |c: EmitterConstructor| c.name,
    ),
    dump.emitter_constructors.filter(|c: EmitterConstructor| c.numeric.len() > 0).map(
      |c: EmitterConstructor| c.name,
    ),
    constructor_sums(dump.constructors),
  );
  let released = dump.emitter_constructors.fold(
    Map::new(),
    |m: Map<Bytes, Bytes>, c: EmitterConstructor|
      match c.release {
        Some(f) -> match table.sum_of.get(c.name) { Some(t) -> m.insert(t, f), None -> m },
        None -> m,
      },
  );
  with_sums_laid({
    ..with_released(table, released, |by: Bytes| definition_scheme(dump, by)),
    stated: stated_functions(dump),
  })
}

fn scope_of_modules(
  dump: Dump,
  p: Program,
  constructors: List<Constructor>,
  roots: List<RootKey>,
  modules: Map<Bytes, Bool>,
) -> emit::Scope / {abort.raise} = {
  let read = p.modules.filter(|m: ModuleRow| modules.contains(m.name));
  let names = read.map(|m: ModuleRow| m.name);
  emit::scope_of(
    emit::zip_sources(
      names,
      read.map(|m: ModuleRow| match text_at(p, m.index) { Some(t) -> t, None -> b"" }),
    ),
    program_constructors(dump, constructors),
    true,
    roots,
    if dump.packages.len() == 0 { [{ prefix: b"", dependencies: [] }] } else { dump.packages },
    if dump.packages.len() == 0 { names.map(|_: Bytes| 0) } else {
      read.map(|m: ModuleRow| match dump.module_packages.at(m.index) { Some(k) -> k, None -> 0 })
    },
    dump.embeds,
    dump.rows,
    dump.effects,
    dump.inferred_facts,
    derived: dump.derived,
  )
}

type EmitterScope = {
  scope: Option<emit::Scope>,
  covered: Map<Bytes, Bool>,
  expected_roots: List<RootKey>,
}

fn initial_emitter_scope(ahead: List<RootKey>) -> EmitterScope =
  { scope: None, covered: Map::new(), expected_roots: ahead }

fn emit_scoped(
  dump: Dump,
  p: Program,
  constructors: List<Constructor>,
  offered: List<RootKey>,
  scope: EmitterScope,
  roots: List<RootKey>,
  handed: Map<RootName, OwnershipSignature>,
  done: KnownResults,
) -> EmitterReply<EmitterScope> / {abort.raise} = {
  let needed = modules_asked(p, roots);
  let covers = needed.fold(true, |all: Bool, m: Bytes, _: Bool| all && scope.covered.contains(m));
  let scoped = match scope.scope {
    Some(s) -> if covers { { scope: s, covered: scope.covered } } else {
      let pending = offered.filter(|k: RootKey|
        !done.before.contains(root_name(k)) && !done.now.contains(root_name(k)));
      let covered = modules_asked(p, roots.concat(pending)).fold(
        scope.covered,
        |acc: Map<Bytes, Bool>, m: Bytes, _: Bool| acc.insert(m, true),
      );
      { scope: scope_of_modules(dump, p, constructors, offered, covered), covered: covered }
    },
    None -> {
      let covered = modules_asked(p, roots.concat(scope.expected_roots));
      { scope: scope_of_modules(dump, p, constructors, offered, covered), covered: covered }
    },
  };
  let batch_count = batches(p, roots);
  let a = results_in_parallel(scoped.scope, batch_count, 0, batch_count.len(), 64, handed, done);
  {
    state: {
      scope: Some(scoped.scope),
      covered: scoped.covered,
      expected_roots: scope.expected_roots,
    },
    results: decoded_results(a),
    found: a.found,
  }
}

fn batch_count() -> Int = 64

type Batch = { weight: Int, roots: List<RootKey> }

fn type_root_weight() -> Int = 256

fn batches(p: Program, missed: List<RootKey>) -> List<List<RootKey>> / {abort.raise} = {
  let weight = |k: RootKey|
    match p.roots.get(site_owner(k)) {
      Some(r) -> r.at.end - r.at.start,
      None -> type_root_weight(),
    };
  let together = missed.fold(Map::new(), |acc: Map<Bytes, Batch>, k: RootKey| {
    let d = batch_key(k);
    let had = match acc.get(d) { Some(x) -> x, None -> { weight: 0, roots: [] } };
    acc.insert(d, { weight: had.weight + weight(k), roots: had.roots.push(k) })
  });
  let heaviest_first = together.values().sort_by(|a: Batch, b: Batch| a.weight >= b.weight);
  let batches = heaviest_first.fold([], |acc: List<Batch>, m: Batch|
    if acc.len() < batch_count() { acc.push(m) } else {
      let lightest = range(0, acc.len()).fold(0, |best: Int, i: Int|
        if acc.get(i).weight < acc.get(best).weight { i } else { best });
      range(0, acc.len()).map(|i: Int| {
        let piece = acc.get(i);
        if i == lightest { { weight: piece.weight + m.weight, roots: piece.roots.concat(m.roots) } }
        else { piece }
      })
    });
  batches.map(|piece: Batch| piece.roots)
}

fn results_in_parallel(
  scope: emit::Scope,
  batch_count: List<List<RootKey>>,
  lo: Int,
  hi: Int,
  depth_left: Int,
  handed: Map<RootName, OwnershipSignature>,
  done: KnownResults,
) -> EncodedBatches / {abort.raise} =
  if hi - lo <= 1 {
    match batch_count.at(lo) {
      Some(roots) -> {
        let a = results_closed(scope, roots, handed, done);
        { packed: [bin::encode(a.results, bin::list_bin(root_output_bin()))], found: a.found }
      },
      None -> { packed: [], found: [] },
    }
  } else if depth_left <= 0 { panic("more halvings than a length has") } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      results_in_parallel(scope, batch_count, lo, mid, depth_left - 1, handed, done),
      results_in_parallel(scope, batch_count, mid, hi, depth_left - 1, handed, done),
    };
    {
      packed: halves._0.packed.concat(halves._1.packed),
      found: halves._0.found.concat(halves._1.found),
    }
  }

type BatchResults = { results: List<RootOutput>, found: List<RootKey> }

type EncodedBatches = { packed: List<Bytes>, found: List<RootKey> }

fn decoded_results(p: EncodedBatches) -> List<RootOutput> / {abort.raise} =
  p.packed.fold([], |acc: List<RootOutput>, b: Bytes|
    match bin::decode(b, bin::list_bin(root_output_bin())) {
      Ok(xs) -> acc.concat(xs),
      Err(_) -> panic("a list's results, as the emitter wrote them, did not read back"),
    })

type KnownResults = { before: Map<RootName, Output>, now: Map<RootName, Output> }

fn results_closed(
  scope: emit::Scope,
  roots: List<RootKey>,
  handed: Map<RootName, OwnershipSignature>,
  done: KnownResults,
) -> BatchResults / {abort.raise} = {
  let done_already = |n: RootName| done.before.contains(n) || done.now.contains(n);
  iterate(
    {
      out: { results: [], found: [] },
      asking: roots,
      seen: roots.fold(Map::new(), |m: Map<RootName, Bool>, k: RootKey|
        m.insert(root_name(k), true)),
      first: true,
    },
    64,
    |st: { out: BatchResults, asking: List<RootKey>, seen: Map<RootName, Bool>, first: Bool }|
      if st.asking.len() == 0 { Stop(st) } else {
        let got = emit::root_outputs(scope, st.asking, handed);
        let next = got.fold(
          { keys: [], seen: st.seen },
          |acc: { keys: List<RootKey>, seen: Map<RootName, Bool> }, a: RootOutput|
            a.result.tables.calls.fold(
              acc,
              |m: { keys: List<RootKey>, seen: Map<RootName, Bool> }, c: RootKey|
                match c {
                  Generated(_, _) -> {
                    let n = root_name(c);
                    if m.seen.contains(n) || done_already(n) { m }
                    else { { keys: m.keys.push(c), seen: m.seen.insert(n, true) } }
                  },
                  _ -> m,
                },
            ),
        );
        Continue({
          out: {
            results: st.out.results.concat(got),
            found: if st.first { st.out.found } else { st.out.found.concat(st.asking) },
          },
          asking: next.keys,
          seen: next.seen,
          first: false,
        })
      },
  ).out
}

fn merged_ownership(
  handed: Map<RootName, OwnershipSignature>,
  results: Map<RootName, Output>,
) -> Map<RootName, OwnershipSignature> =
  results.fold(handed, |acc: Map<RootName, OwnershipSignature>, _: RootName, a: Output|
    signatures_from(a.tables.handings).fold(
      acc,
      |m: Map<RootName, OwnershipSignature>, n: RootName, h: OwnershipSignature| m.insert(n, h),
    ))

fn published_signatures(
  before: Map<RootName, PublishedSignature>,
  results: Map<RootName, Output>,
) -> Map<RootName, PublishedSignature> =
  results.fold(before, |acc: Map<RootName, PublishedSignature>, _: RootName, a: Output|
    a.tables.handings.fold(acc, |m: Map<RootName, PublishedSignature>, h: PublishedSignature|
      m.insert(h.definition, h)))

fn written_stale(a: Output, published: Map<RootName, PublishedSignature>) -> Bool =
  a.tables.assumed.any(|x: PublishedSignature|
    match published.get(x.definition) { Some(h) -> h != x, None -> false })

fn signature_mismatches(
  results: Map<RootName, Output>,
  taken: List<RootName>,
) -> List<SignatureMismatch> = {
  let published = published_signatures(Map::new(), results);
  taken.fold([], |acc: List<SignatureMismatch>, n: RootName|
    match results.get(n) {
      Some(b) ->
        b.tables.assumed.fold(acc, |a: List<SignatureMismatch>, x: PublishedSignature|
          if agrees(x, published.get(x.definition)) { a }
          else { a.push({ caller: n, assumed: x, published: published.get(x.definition) }) }),
      _ -> acc,
    })
}

fn stale_of(
  results: Map<RootName, Output>,
  published: Map<RootName, PublishedSignature>,
  keys: Map<RootName, RootKey>,
) -> List<RootKey> =
  results.fold([], |acc: List<RootKey>, n: RootName, a: Output|
    if !written_stale(a, published) { acc } else {
      let own = match keys.get(n) { Some(k) -> [k], None -> [] };
      let group = a.tables.group;
      own.concat(group).fold(acc, |xs: List<RootKey>, g: RootKey|
        if xs.contains(g) { xs } else { xs.push(g) })
    })

fn without_partial_groups(
  cached: Map<RootName, Output>,
  asked: List<RootName>,
) -> Map<RootName, Output> / {abort.raise} =
  iterate(cached, cached.len() + 1, |k: Map<RootName, Output>| {
    let split = k.fold([], |acc: List<RootName>, n: RootName, a: Output|
      if a.tables.group.any(|g: RootKey| {
          let member = root_name(g);
          asked.contains(member) && !k.contains(member)
        }) { acc.push(n) }
      else { acc });
    if split.len() == 0 { Stop(k) }
    else { Continue(split.fold(k, |m: Map<RootName, Output>, n: RootName| m.remove(n))) }
  })

fn module_levels(p: Program) -> Map<Bytes, Int> / {abort.raise} =
  iterate(Map::new(), p.read.len() + 2, |at: Map<Bytes, Int>| {
    let next = p.read.fold(
      Map::new(),
      |acc: Map<Bytes, Int>, m: Bytes, dependencies: List<Bytes>|
        acc.insert(
          m,
          dependencies.fold(0, |n: Int, d: Bytes| {
            let past = match at.get(d) { Some(l) -> l + 1, None -> 0 };
            if past > n { past } else { n }
          }),
        ),
    );
    if next == at { Stop(next) } else { Continue(next) }
  })

fn owning_module(k: RootKey) -> Bytes =
  match inlined_lambdas(k).at(0) { Some(f) -> module_of(f.owner), None -> module_of(k) }

fn batch_key(k: RootKey) -> Bytes =
  match k {
    Specialisation(a, _) -> if a.borrowed.len() > 0 { owning_module(k) } else { a.definition },
    Generated(_, _) -> root_text(root_name(k)),
    _ -> owning_module(k),
  }

type EmitterReply<s> = { state: s, results: List<RootOutput>, found: List<RootKey> }

type EmissionProgress<s> = {
  results: Map<RootName, Output>,
  stored: Map<RootName, Stored>,
  keys: Map<RootName, RootKey>,
  published: Map<RootName, PublishedSignature>,
  ownership: Map<RootName, OwnershipSignature>,
  cached: Int,
  asked: Int,
  added: List<RootKey>,
  known: Map<Bytes, Bool>,
  needs: Map<RootName, List<Need>>,
  called: Map<RootName, List<Int>>,
  unread: List<RootName>,
  unresolved: List<RootName>,
  emitter: s,
  unstored_records: List<Record>,
  dependents: Map<RootName, List<RootName>>,
  requested: Map<RootName, Bool>,
}

pub type LevelTally = {
  place: Int,
  places: Int,
  roots: Int,
  cached: Int,
  asked: Int,
  steps: Int,
  began: Int,
  ended: Int,
}

fn walk_levels<s | e>(
  p: Program,
  types: Bytes,
  program: Constructors,
  offered: List<RootKey>,
  read: (Bytes) -> Option<Bytes> / e,
  keep: (List<Record>) -> Unit / e,
  phases: Option<{ now: () -> Int / e, outcome: (LevelTally) -> Unit / e }>,
  start: (List<RootKey>) -> s,
  ask: (s, List<RootKey>, Map<RootName, OwnershipSignature>, KnownResults) -> EmitterReply<s> / {abort.raise | e},
) -> EmissionProgress<s> / {abort.raise | e} = {
  let places = module_levels(p);
  let position_in = |k: RootKey| match places.get(owning_module(k)) { Some(l) -> l, None -> 0 };
  let at = offered.fold(Map::new(), |acc: Map<Int, List<RootKey>>, k: RootKey| {
    let l = position_in(k);
    acc.insert(l, List::push(match acc.get(l) { Some(ks) -> ks, None -> [] }, k))
  });
  let last = offered.fold(0, |m: Int, k: RootKey|
    if position_in(k) > m { position_in(k) } else { m });
  let cached = cached_results(p.keys, materials_of(p, types, keys_named(offered)), read);
  let emitter = start(offered.filter(|k: RootKey| !cached.results.contains(root_name(k))));
  range(0, last + 1).fold(
    {
      results: Map::new(),
      stored: Map::new(),
      keys: Map::new(),
      published: Map::new(),
      ownership: Map::new(),
      cached: 0,
      asked: 0,
      added: [],
      known: cached.known,
      needs: Map::new(),
      called: Map::new(),
      unread: [],
      unresolved: [],
      emitter: emitter,
      unstored_records: [],
      dependents: Map::new(),
      requested: offered.map(root_name).fold(Map::new(), |m: Map<RootName, Bool>, n: RootName|
        m.insert(n, true)),
    },
    |w: EmissionProgress<s>, l: Int|
      match at.get(l) {
        None -> w,
        Some(roots) ->
          report_level(phases, l, last + 1, w, ||
            walk_level(p, types, program, w, roots, cached, read, keep, ask)),
      },
  )
}

fn keys_named(ks: List<RootKey>) -> Map<RootName, RootKey> =
  ks.fold(Map::new(), |acc: Map<RootName, RootKey>, k: RootKey| acc.insert(root_name(k), k))

fn materials_of(p: Program, types: Bytes, keys: Map<RootName, RootKey>) -> Map<RootName, Bytes> =
  keys.fold(Map::new(), |acc: Map<RootName, Bytes>, n: RootName, k: RootKey|
    match root_cache_key(p, types, k) { Some(m) -> acc.insert(n, m), None -> acc })

fn report_level<s | e>(
  phases: Option<{ now: () -> Int / e, outcome: (LevelTally) -> Unit / e }>,
  l: Int,
  places: Int,
  w: EmissionProgress<s>,
  run: () -> { walk: EmissionProgress<s>, steps: Int } / {abort.raise | e},
) -> EmissionProgress<s> / {abort.raise | e} =
  match phases {
    None -> run().walk,
    Some(t) -> {
      let began = t.now();
      let r = run();
      t.outcome({
        place: l,
        places: places,
        roots: r.walk.keys.len() - w.keys.len(),
        cached: r.walk.cached - w.cached,
        asked: r.walk.asked - w.asked,
        steps: r.steps,
        began: began,
        ended: t.now(),
      });
      r.walk
    },
  }

fn walk_level<s | e>(
  p: Program,
  types: Bytes,
  program: Constructors,
  w: EmissionProgress<s>,
  roots: List<RootKey>,
  cached: CachedResults,
  read: (Bytes) -> Option<Bytes> / e,
  keep: (List<Record>) -> Unit / e,
  ask: (s, List<RootKey>, Map<RootName, OwnershipSignature>, KnownResults) -> EmitterReply<s> / {abort.raise | e},
) -> { walk: EmissionProgress<s>, steps: Int } / {abort.raise | e} = {
  let walk_levels = iterate(
    {
      walk: with_results(
        p,
        types,
        w,
        roots,
        |ms: Map<RootName, Bytes>| cached_among(cached, ms),
        read,
        ask,
      ),
      steps: 1,
    },
    66,
    |b: { walk: EmissionProgress<s>, steps: Int }| {
      let named = missing_callees(b.walk);
      let read_all = { ..b.walk, unread: [] };
      let next = if named.len() > 0 { { walk: read_all, more: named } }
      else { specialise_generic_calls(read_all, program) };
      let moved = stale_here(
        next.walk,
        b.walk.unread.fold([], |acc: List<RootName>, n: RootName|
          match b.walk.results.get(n) {
            Some(x) -> acc.concat(x.tables.handings.map(|h: PublishedSignature| h.definition)),
            _ -> acc,
          }),
      );
      if (next.more.len() == 0 && moved.len() == 0) || b.steps > 64 {
        Stop({ ..b, walk: next.walk })
      } else {
        let more = next.more.values().concat(moved);
        let emitter_error = {
          ..next.walk,
          results: moved.fold(next.walk.results, |m: Map<RootName, Output>, k: RootKey|
            m.remove(root_name(k))),
        };
        let after = with_results(
          p,
          types,
          emitter_error,
          more,
          |ms: Map<RootName, Bytes>| cached_results(p.keys, ms, read),
          read,
          ask,
        );
        Continue({ walk: { ..after, added: after.added.concat(more) }, steps: b.steps + 1 })
      }
    },
  );
  if walk_levels.walk.unstored_records.len() > 0 { keep(walk_levels.walk.unstored_records) };
  { ..walk_levels, walk: { ..walk_levels.walk, unstored_records: [] } }
}

fn stale_here<s>(w: EmissionProgress<s>, changed: List<RootName>) -> List<RootKey> =
  stale_of(
    changed.fold(Map::new(), |m: Map<RootName, Output>, d: RootName|
      match w.dependents.get(d) {
        Some(ns) ->
          ns.fold(m, |acc: Map<RootName, Output>, n: RootName|
            match w.results.get(n) { Some(a) -> acc.insert(n, a), None -> acc }),
        None -> m,
      }),
    w.published,
    w.keys,
  )

fn dependents_with(
  assumers: Map<RootName, List<RootName>>,
  results: Map<RootName, Output>,
) -> Map<RootName, List<RootName>> =
  results.fold(assumers, |m: Map<RootName, List<RootName>>, n: RootName, a: Output|
    a.tables.assumed.fold(m, |acc: Map<RootName, List<RootName>>, x: PublishedSignature|
      acc.insert(x.definition, match acc.get(x.definition) {
        Some(ns) -> ns.push(n),
        None -> [n],
      })))

type AskProgress<s> = {
  emitted: Map<RootName, Output>,
  cached: Map<RootName, Output>,
  asked: Int,
  pending: List<RootKey>,
  emitter: s,
  found: Map<RootName, RootKey>,
}

fn with_results<s | e>(
  p: Program,
  types: Bytes,
  w: EmissionProgress<s>,
  roots: List<RootKey>,
  look: (Map<RootName, Bytes>) -> CachedResults / {abort.raise | e},
  read: (Bytes) -> Option<Bytes> / e,
  ask: (s, List<RootKey>, Map<RootName, OwnershipSignature>, KnownResults) -> EmitterReply<s> / {abort.raise | e},
) -> EmissionProgress<s> / {abort.raise | e} = {
  let keys = roots.fold(Map::new(), |acc: Map<RootName, RootKey>, k: RootKey|
    if w.results.contains(root_name(k)) { acc } else { acc.insert(root_name(k), k) });
  let names = keys.keys();
  let asked = names.fold(Map::new(), |acc: Map<RootName, Bool>, n: RootName| acc.insert(n, true));
  let materials = materials_of(p, types, keys);
  let looked = look(materials);
  let standing_now = fully_cached_results(looked.results, asked);
  let stale = stale_of(standing_now, published_signatures(w.published, standing_now), keys);
  let cached = without_partial_groups(
    stale.fold(standing_now, |m: Map<RootName, Output>, k: RootKey| m.remove(root_name(k))),
    names,
  );
  let missed = keys.values().filter(|k: RootKey| !cached.contains(root_name(k)));
  let resolved = iterate(
    {
      emitted: Map::new(),
      cached: cached,
      asked: 0,
      pending: missed,
      emitter: w.emitter,
      found: Map::new(),
    },
    cached.len() + 2,
    |t: AskProgress<s>| {
      let now = t.emitted.fold(t.cached, |m: Map<RootName, Output>, n: RootName, a: Output|
        m.insert(n, a));
      let moved = stale_of(now, published_signatures(w.published, now), keys);
      let asking = t.pending.concat(moved);
      if asking.len() == 0 { Stop(t) } else {
        let got = ask(t.emitter, asking, merged_ownership(w.ownership, now), {
          before: w.results,
          now: now,
        });
        let results = results_by_name(got.results);
        let found = got.found.fold(t.found, |m: Map<RootName, RootKey>, k: RootKey|
          if keys.contains(root_name(k)) { m } else { m.insert(root_name(k), k) });
        let stood = moved.fold(t.emitted, |m: Map<RootName, Output>, k: RootKey|
          m.remove(root_name(k)));
        Continue({
          emitted: results.fold(stood, |m: Map<RootName, Output>, n: RootName, a: Output|
            m.insert(n, a)),
          cached: moved.fold(t.cached, |m: Map<RootName, Output>, k: RootKey|
            m.remove(root_name(k))),
          asked: t.asked + asking.len() + found.len() - t.found.len(),
          pending: [],
          emitter: got.state,
          found: found,
        })
      }
    },
  );
  let reached = reachable_found_roots(
    resolved.emitted.fold(resolved.cached, |acc: Map<RootName, Output>, n: RootName, a: Output|
      acc.insert(n, a)),
    names,
    resolved.found,
  );
  let body_names = missed.fold(
    resolved.found.fold(resolved.emitted, |acc: Map<RootName, Output>, n: RootName, _: RootKey|
      if reached.contains(n) { acc } else { acc.remove(n) }),
    |acc: Map<RootName, Output>, k: RootKey|
      if acc.contains(root_name(k)) { acc } else {
        panic(
          String::of_bytes_lossy(
            Bytes::concat_all([
              b"the emitter returned nothing for `",
              root_text(root_name(k)),
              b"`",
            ]),
          ),
        )
      },
  );
  let all = body_names.fold(
    resolved.cached,
    |acc: Map<RootName, Output>, n: RootName, a: Output| acc.insert(n, a),
  );
  let now = all.keys();
  let r = results_to_cache(
    p.keys,
    reached.fold(materials, |m: Map<RootName, Bytes>, n: RootName, k: RootKey|
      match root_cache_key(p, types, k) { Some(x) -> m.insert(n, x), None -> m }),
    body_names,
    looked.known.fold(w.known, |m: Map<Bytes, Bool>, d: Bytes, _: Bool| m.insert(d, true)),
    read,
  );
  {
    ..w,
    results: all.fold(w.results, |acc: Map<RootName, Output>, n: RootName, a: Output|
      acc.insert(n, a)),
    stored: resolved.cached.fold(w.stored, |acc: Map<RootName, Stored>, n: RootName, _: Output|
      match looked.stored.get(n) { Some(s) -> acc.insert(n, s), None -> acc }),
    keys: reached.fold(
      keys.fold(w.keys, |acc: Map<RootName, RootKey>, n: RootName, k: RootKey| acc.insert(n, k)),
      |acc: Map<RootName, RootKey>, n: RootName, k: RootKey| acc.insert(n, k),
    ),
    added: w.added.concat(reached.values()),
    published: published_signatures(w.published, all),
    ownership: merged_ownership(w.ownership, all),
    dependents: dependents_with(w.dependents, all),
    cached: w.cached + all.len() - body_names.len(),
    asked: w.asked + resolved.asked,
    unstored_records: w.unstored_records.concat(r.records),
    known: r.known,
    unread: w.unread.concat(now),
    unresolved: w.unresolved.concat(now),
    emitter: resolved.emitter,
  }
}

fn reachable_found_roots(
  results: Map<RootName, Output>,
  roots: List<RootName>,
  found: Map<RootName, RootKey>,
) -> Map<RootName, RootKey> / {abort.raise} =
  iterate(
    { reached: Map::new(), from: roots },
    found.len() + 1,
    |s: { reached: Map<RootName, RootKey>, from: List<RootName> }| {
      let next = s.from.fold(Map::new(), |acc: Map<RootName, RootKey>, n: RootName|
        match results.get(n) {
          Some(b) ->
            b.tables.calls.fold(acc, |m: Map<RootName, RootKey>, c: RootKey| {
              let callee = root_name(c);
              if found.contains(callee) && !s.reached.contains(callee) { m.insert(callee, c) }
              else { m }
            }),
          _ -> acc,
        });
      if next.len() == 0 { Stop(s) } else {
        Continue({
          reached: next.fold(s.reached, |m: Map<RootName, RootKey>, n: RootName, k: RootKey|
            m.insert(n, k)),
          from: next.keys(),
        })
      }
    },
  ).reached

fn missing_callees<s>(w: EmissionProgress<s>) -> Map<RootName, RootKey> =
  w.unread.fold(Map::new(), |acc: Map<RootName, RootKey>, n: RootName|
    match w.results.get(n) {
      Some(b) -> {
        let unheld = |m: Map<RootName, RootKey>, c: RootKey|
          if w.results.contains(root_name(c)) { m } else { m.insert(root_name(c), c) };
        let written = b.tables.calls.fold(acc, |m: Map<RootName, RootKey>, c: RootKey|
          match c {
            Generated(_, _) -> unheld(m, c),
            Clause(_) -> unheld(m, c),
            Named(_) -> if w.requested.contains(root_name(c)) { m } else { unheld(m, c) },
            _ -> m,
          });
        b.tables.generics.calls.fold(written, |m: Map<RootName, RootKey>, g: GenericCall|
          if w.results.contains(root_name(g.callee)) { m }
          else { m.insert(root_name(g.callee), g.callee) })
      },
      _ -> acc,
    })

fn specialise_generic_calls<s>(
  w: EmissionProgress<s>,
  program: Constructors,
) -> { walk: EmissionProgress<s>, more: Map<RootName, RootKey> } / {abort.raise} = {
  let names = sorted_unique(w.unresolved);
  let bodies = generic_bodies(w.results, w.keys, names);
  let needs = extended_needs(bodies, w.needs);
  let called = extended_called(bodies, w.called);
  let more = names.fold(Map::new(), |acc: Map<RootName, RootKey>, n: RootName|
    match w.results.get(n) {
      Some(b) -> if specialised_by_callers(w.keys, n, b.tables, needs) { acc } else {
        b.tables.generics.calls.fold(acc, |m: Map<RootName, RootKey>, g: GenericCall| {
          let root = call_specialisation(g, needs, called, program);
          let name = root_name(root);
          if w.results.contains(name) || m.contains(name) { m } else { m.insert(name, root) }
        })
      },
      _ -> acc,
    });
  { walk: { ..w, needs: needs, called: called, unresolved: [] }, more: more }
}

pub fn entered_timeout_ms() -> Int = 60000

pub fn emitted<| e>(
  runtime: Runtime,
  dump: Dump,
  sources: List<Bytes>,
  inputs: Map<Bytes, Bytes>,
  every: List<RootKey>,
  read: (Bytes) -> Option<Bytes> / e,
  keep: (List<Record>) -> Unit / e,
  phases: Option<{ now: () -> Int / e, outcome: (LevelTally) -> Unit / e }> = None,
  entered: Option<List<RootKey>> = None,
  source_cached: Option<(String) -> Bool / e> = None,
) -> Result<Emission, Bytes> / e =
  handle {
    let p = program_of(dump, sources, every);
    let constructors = dump.emitter_constructors.map(|c: EmitterConstructor|
      { name: c.name, arity: c.arity });
    let entries = (match entered { Some(ks) -> ks, None -> every }).filter(|k: RootKey|
      runtime_enters(p, k)).map(
      EntryPoint,
    );
    let offered = every.concat(entries);
    let program = program_constructors(dump, constructors);
    let all = walk_levels(
      p,
      types_digest(dump),
      program,
      offered,
      read,
      keep,
      phases,
      initial_emitter_scope,
      |scope: EmitterScope, roots: List<RootKey>, handed: Map<RootName, OwnershipSignature>, done: KnownResults|
        emit_scoped(dump, p, constructors, offered, scope, roots, handed, done),
    );
    {
      let c = compiled(all.results, all.keys, all.stored);
      let resolved = generic_calls_specialised(c.results, c.keys, all.needs, all.called, program);
      let unemitted = resolved.unemitted;
      let outputs = with_unemitted_rejected(resolved.results, c.keys, unemitted);
      let roots = every.concat(all.added).filter(|k: RootKey|
        !unemitted.contains(root_name(k))).concat(
        entries,
      );
      let compiled_roots = c.coded.fold(
        roots.fold(Map::new(), |m: Map<RootName, { key: RootKey, home: Bytes }>, k: RootKey|
          if m.contains(root_name(k)) { m }
          else { m.insert(root_name(k), { key: k, home: home_of(k) }) }),
        |m: Map<RootName, { key: RootKey, home: Bytes }>, x: { key: RootKey, home: Bytes }|
          m.insert(root_name(x.key), x),
      );
      let natives = read_natives(
        p,
        outputs.fold(Map::new(), |acc: Map<Bytes, Bool>, _: RootName, a: Output|
          a.tables.natives.fold(acc, |m: Map<Bytes, Bool>, n: Bytes| m.insert(n, true))),
      );
      let produced = produce(
        constructors,
        compiled_roots.values().map(|o: { key: RootKey, home: Bytes }| {
          let k = o.key;
          match k {
            EntryPoint(_) ->
              { name: root_name(k), arity: 0, constant: false, site: site_owner(k), home: o.home },
            _ -> match p.roots.get(site_owner(k)) {
              Some(r) ->
                {
                  name: root_name(k),
                  arity: r.arity,
                  constant: r.pure && r.arity == 0
                    && (match k { Specialisation(_, _) -> false, Coded(_) -> false, _ -> true }),
                  site: site_owner(k),
                  home: o.home,
                },
              None ->
                {
                  name: root_name(k),
                  arity: 0,
                  constant: false,
                  site: site_owner(k),
                  home: o.home,
                },
            },
          }
        }),
        p.modules.len(),
        outputs,
        inputs,
        |called: Map<Bytes, Bool>| extern_natives(called_externs(called, natives)),
        part_rule(),
        c.stored,
        resolved.named,
        read,
        |digest: String| match source_cached { Some(h) -> h(digest), None -> false },
      );
      if produced.records.len() > 0 { keep(produced.records) };
      Ok({
        produced: produced,
        roots: roots,
        cached: all.cached,
        asked: all.asked,
        unserved: runtime_mismatches(runtime),
        unbound: unbound(runtime.natives, called_externs(natives_called(produced.made), natives)),
        signature_mismatches: signature_mismatches(
          all.results,
          sorted_unique(roots.map(root_name)),
        ),
      })
    }
  } with {
    abort.raise(m) -> Err(Bytes::of_string(m)),
  }

pub fn built(
  modules: List<{ name: Bytes, src: Bytes }>,
) -> Result<Emission, Bytes> / {abort.raise} = {
  let dump = dump_of(analyse(parse_all(modules)));
  emitted(
    serving_runtime(b"r", program_natives([]).map(declared_signature)),
    dump,
    sources_in_order(dump, modules),
    Map::new(),
    requested_roots(dump).keys,
    |_: Bytes| None,
    |_: List<Record>| (),
  )
}

pub fn roots_built(
  modules: List<{ name: Bytes, src: Bytes }>,
) -> Result<List<RootKey>, Bytes> / {abort.raise} =
  match built(modules) { Ok(e) -> Ok(e.roots), Err(reason) -> Err(reason) }

fn specialised_definition(keys: Map<RootName, RootKey>, n: RootName) -> Option<Bytes> =
  match keys.get(n) {
    Some(Specialisation(a, _)) -> Some(a.definition),
    Some(Coded(c)) -> Some(c.definition),
    _ -> None,
  }

fn generic_bodies(
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
  names: List<RootName>,
) -> Map<RootName, Tables> =
  names.fold(Map::new(), |acc: Map<RootName, Tables>, n: RootName|
    match results.get(n) {
      Some(b) -> if specialised_definition(keys, n) == None { acc.insert(n, b.tables) }
      else { acc },
      _ -> acc,
    })

fn extended_needs(
  bodies: Map<RootName, Tables>,
  closed: Map<RootName, List<Need>>,
) -> Map<RootName, List<Need>> / {abort.raise} = {
  let start = bodies.fold(closed, |acc: Map<RootName, List<Need>>, n: RootName, t: Tables|
    acc.insert(n, t.generics.needs));
  let needs_count = |needs: Map<RootName, List<Need>>|
    bodies.fold(0, |c: Int, n: RootName, _: Tables|
      c + (match needs.get(n) { Some(ns) -> ns.len(), None -> 0 }));
  let most = bodies.fold(1, |acc: Int, _: RootName, t: Tables|
    acc + 2 * t.generics.calls.fold(1, |n: Int, c: GenericCall| n + c.args.len()));
  iterate(start, most, |needs: Map<RootName, List<Need>>| {
    let next = bodies.fold(needs, |acc: Map<RootName, List<Need>>, n: RootName, t: Tables|
      t.generics.calls.fold(acc, |a: Map<RootName, List<Need>>, call: GenericCall|
        with_callee_needs(a, n, call, needs)));
    if needs_count(next) == needs_count(needs) { Stop(needs) } else { Continue(next) }
  })
}

fn specialised_by_callers(
  keys: Map<RootName, RootKey>,
  n: RootName,
  t: Tables,
  needs: Map<RootName, List<Need>>,
) -> Bool =
  specialised_definition(keys, n) == None
    && (needs_specialisation(t.generics.needs)
    || needs_specialisation(match needs.get(n) { Some(ns) -> ns, None -> [] }))

fn unemitted_generics(
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
  needs: Map<RootName, List<Need>>,
) -> Map<RootName, Bool> =
  results.fold(Map::new(), |acc: Map<RootName, Bool>, n: RootName, a: Output|
    if specialised_by_callers(keys, n, a.tables, needs) { acc.insert(n, true) } else { acc })

fn with_unemitted_rejected(
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
  unemitted: Map<RootName, Bool>,
) -> Map<RootName, Output> / {abort.raise} =
  results.fold(Map::new(), |acc: Map<RootName, Output>, n: RootName, a: Output|
    if unemitted.contains(n) { acc }
    else if specialised_definition(keys, n) != None
        && needs_specialisation(a.tables.generics.needs) {
      panic(
        String::of_bytes_lossy(
          Bytes::concat_all([
            b"the specialisation `",
            root_text(n),
            b"` its callers resolved still reads a type variable's layout or type",
          ]),
        ),
      )
    } else { acc.insert(n, a) })

fn extended_called(
  bodies: Map<RootName, Tables>,
  closed: Map<RootName, List<Int>>,
) -> Map<RootName, List<Int>> / {abort.raise} = {
  let alone = bodies.fold(Map::new(), |acc: Map<RootName, Generics>, n: RootName, t: Tables|
    if t.members.len() <= 1 { acc.insert(n, t.generics) } else { acc });
  let start = alone.fold(closed, |acc: Map<RootName, List<Int>>, n: RootName, g: Generics|
    acc.insert(n, g.called_parameters));
  let calls_count = |called: Map<RootName, List<Int>>|
    alone.fold(0, |c: Int, n: RootName, _: Generics|
      c + (match called.get(n) { Some(cs) -> cs.len(), None -> 0 }));
  let most = alone.fold(1, |acc: Int, _: RootName, g: Generics| acc + g.passes.len());
  iterate(start, most, |called: Map<RootName, List<Int>>| {
    let next = alone.fold(called, |acc: Map<RootName, List<Int>>, n: RootName, g: Generics|
      g.passes.fold(acc, |a: Map<RootName, List<Int>>, pass: ForwardedParameter| {
        let theirs = match called.get(root_name(pass.callee)) { Some(cs) -> cs, None -> [] };
        let mine = match a.get(n) { Some(cs) -> cs, None -> [] };
        if theirs.contains(pass.at) && !mine.contains(pass.param) {
          a.insert(n, mine.push(pass.param))
        } else { a }
      }));
    if calls_count(next) == calls_count(called) { Stop(called) } else { Continue(next) }
  })
}

fn with_callee_needs(
  acc: Map<RootName, List<Need>>,
  n: RootName,
  call: GenericCall,
  needs: Map<RootName, List<Need>>,
) -> Map<RootName, List<Need>> = {
  let callee = match needs.get(root_name(call.callee)) { Some(ns) -> ns, None -> [] };
  callee.fold(acc, |a: Map<RootName, List<Need>>, need: Need|
    match call.args.at(need.var) {
      None -> a,
      Some(arg) -> {
        let vars = match need.reads {
          Exact -> type_variables(arg),
          Layout -> layout_variables(arg),
          Scalar -> match arg { VariableType(v) -> if v >= 0 { [v] } else { [] }, _ -> [] },
          EffectsGeneric -> [],
        };
        vars.fold(a, |m: Map<RootName, List<Need>>, v: Int| {
          let had = match m.get(n) { Some(ns) -> ns, None -> [] };
          let more = { var: v, reads: need.reads };
          if had.contains(more) { m } else { m.insert(n, had.push(more)) }
        })
      },
    })
}

fn call_specialisation(
  call: GenericCall,
  needs: Map<RootName, List<Need>>,
  called: Map<RootName, List<Int>>,
  constructors: Constructors,
) -> RootKey / {abort.raise} = {
  let callee = root_name(call.callee);
  let ns = match needs.get(callee) { Some(x) -> x, None -> [] };
  let open = KeyType(unknown_type());
  let args = range(0, call.args.len()).map(|j: Int| {
    let arg = call.args.get(j);
    let loader_tables = || KeyLayout({ key: layout_key(constructors, arg), at: arg });
    if has_variables(arg) { open }
    else if ns.contains({ var: j, reads: Exact }) { KeyType(arg) }
    else if call.specialised_variables.contains(j) || ns.contains({ var: j, reads: Layout }) {
      loader_tables()
    } else if ns.contains({ var: j, reads: Scalar }) && is_scalar_type(arg) { loader_tables() }
    else if ns.contains({ var: j, reads: Scalar }) && numeric_sum(constructors, arg) {
      KeyType(arg)
    } else { open }
  });
  let calls = match called.get(callee) { Some(cs) -> cs, None -> [] };
  let functions = call.functions.filter(|f: InlinedLambda| calls.contains(f.param));
  match definition_of(call.callee) {
    Some(definition) -> if functions.len() == 0 && args.all(|a: KeyArg| a == open)
        && call.effect_evidence.len() == 0 { call.callee } else {
      keys::specialisation_key_with_effects(definition, args, functions, call.effect_evidence)
    },
    None -> call.callee,
  }
}

fn generic_calls_specialised(
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
  needs: Map<RootName, List<Need>>,
  called: Map<RootName, List<Int>>,
  constructors: Constructors,
) -> { results: Map<RootName, Output>, named: Map<RootName, List<RootName>>, unemitted: Map<RootName, Bool> } / {abort.raise} = {
  let unemitted = unemitted_generics(results, keys, needs);
  let asked = |k: RootKey| match keys.get(root_name(k)) { Some(x) -> x, None -> k };
  let named = results.fold(
    Map::new(),
    |acc: Map<RootName, List<RootName>>, n: RootName, a: Output|
      if a.tables.generics.calls.len() == 0 { acc } else {
        acc.insert(
          n,
          a.tables.generics.calls.map(|g: GenericCall|
            root_name(asked(call_specialisation(g, needs, called, constructors)))),
        )
      },
  );
  let resolved_results = results.fold(
    Map::new(),
    |acc: Map<RootName, Output>, n: RootName, a: Output|
      acc.insert(n, if a.tables.generics.calls.len() == 0 { a } else {
        let resolved = a.tables.generics.calls.map(|g: GenericCall|
          asked(call_specialisation(g, needs, called, constructors)));
        let roots = resolved.map(root_name);
        let calls = resolved.fold(a.tables.calls, |cs: List<RootKey>, r: RootKey|
          if cs.any(|c: RootKey| root_name(c) == root_name(r)) { cs } else { cs.push(r) });
        let placed = |name: RootName|
          range(0, calls.len()).fold(None, |found: Option<Int>, i: Int|
            match found {
              Some(_) -> found,
              None -> match calls.at(i) {
                Some(c) -> if root_name(c) == name { Some(i) } else { None },
                None -> None,
              },
            });
        {
          text: a.text,
          tables: {
            ..a.tables,
            generics: {
              ..a.tables.generics,
              expects: a.tables.generics.expects.map(|e: ExpectedPrototype|
                match e.callee {
                  GenericAt(n) -> match roots.at(n) {
                    Some(r) -> match placed(r) { Some(i) -> { ..e, callee: CallAt(i) }, None -> e },
                    None -> e,
                  },
                  CallAt(_) -> e,
                }),
            },
            lambdas: a.tables.lambdas.map(|l: Bytes| placeholders_named(l, roots)),
            calls: calls,
          },
        }
      }),
  );
  { results: resolved_results, named: named, unemitted: unemitted }
}

fn resolved_text<| e>(
  n: RootName,
  a: Output,
  stored: Map<RootName, Stored>,
  named: Map<RootName, List<RootName>>,
  read: (Bytes) -> Option<Bytes> / e,
) -> Output / {abort.raise | e} = {
  let body = if a.text.len() > 0 { output_body(a) } else {
    match stored.get(n) {
      None -> output_body(a),
      Some(s) -> match read(body_key(s.cache_key)) {
        None -> panic("a cached result's body is cached beside it"),
        Some(b) -> match bin::decode(b, body_bin()) {
          Ok(x) -> x,
          Err(_) -> panic("a cached result's body reads back as it was cached"),
        },
      },
    }
  };
  {
    text: match named.get(n) {
      Some(roots) -> placeholders_named(body.text, roots),
      None -> body.text,
    },
    tables: { ..a.tables, shared: body.shared },
  }
}

type Compiled = {
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
  coded: List<{ key: RootKey, home: Bytes }>,
  stored: Map<RootName, Stored>,
}

fn compiled(
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
  stored: Map<RootName, Stored>,
) -> Compiled / {abort.raise} = {
  let sharing = results.fold(
    Map::new(),
    |acc: Map<RootName, { key: RootKey, shared: List<RootName> }>, n: RootName, a: Output|
      match keys.get(n) {
        Some(Specialisation(spec, _)) -> if a.tables.members.len() > 0
            || a.tables.defined.any(|d: DefinitionSymbol| d.entered) { acc } else {
          let k = code_of(spec.definition, n, a, digest_in(stored, n, a));
          let c = root_name(k);
          acc.insert(c, {
            key: k,
            shared: List::push(match acc.get(c) { Some(x) -> x.shared, None -> [] }, n),
          })
        },
        _ -> acc,
      },
  );
  sharing.fold(
    { results: results, keys: keys, coded: [], stored: stored },
    |acc: Compiled, c: RootName, s: { key: RootKey, shared: List<RootName> }|
      match if s.shared.len() < 2 { None } else { results.get(s.shared.get(0)) } {
        None -> acc,
        Some(a) ->
          {
            results: s.shared.fold(
              acc.results.insert(c, renamed(a, s.shared.get(0), s.key)),
              |m: Map<RootName, Output>, n: RootName|
                match results.get(n) { Some(b) -> m.insert(n, stub(b, s.key)), None -> m },
            ),
            keys: acc.keys.insert(c, s.key),
            coded: acc.coded.push({
              key: s.key,
              home: sorted_unique(
                s.shared.map(|n: RootName|
                  match keys.get(n) { Some(k) -> home_of(k), None -> b"" }),
              ).get(
                0,
              ),
            }),
            stored: s.shared.fold(
              match stored.get(s.shared.get(0)) {
                Some(x) -> acc.stored.insert(c, x),
                None -> acc.stored,
              },
              |m: Map<RootName, Stored>, n: RootName| m.remove(n),
            ),
          },
      },
  )
}

fn digest_in(stored: Map<RootName, Stored>, n: RootName, a: Output) -> Bytes / {abort.raise} =
  if a.text.len() > 0 { body_digest(a) }
  else { match stored.get(n) { Some(s) -> s.body, None -> body_digest(a) } }

fn stub(a: Output, code: RootKey) -> Output / {abort.raise} =
  match a.tables.defined.at(0) {
    None -> panic("a specialisation defines its root"),
    Some(d) -> {
      let params = range(0, d.head.params.len());
      let call = Bytes::concat_all([
        symbol_of(root_text(root_name(code))),
        b"(ctx",
        Bytes::concat_all(params.map(|i: Int| b", p".concat(ascii_of_int(i)))),
        b");",
      ]);
      {
        text: Bytes::concat_all([
          d.head.result,
          b" ",
          own_symbol(None),
          b"(PlyCtx *ctx",
          Bytes::concat_all(
            params.map(|i: Int|
              Bytes::concat_all([b", ", d.head.params.get(i), b" p", ascii_of_int(i)])),
          ),
          b") { ",
          if d.head.result == b"void" { call } else { b"return ".concat(call) },
          b" }",
        ]),
        tables: {
          ..no_tables(),
          calls: [code],
          defined: a.tables.defined,
          handings: a.tables.handings,
        },
      }
    },
  }

fn code_of(definition: Bytes, n: RootName, a: Output, body: Bytes) -> RootKey / {abort.raise} = {
  let unnamed = renamed(summarised(a), n, Coded({ definition: definition, code: b"" }));
  Coded({
    definition: definition,
    code: Bytes::of_string(
      blake3(bin::encode(unnamed, output_bin()).concat(body)).slice(0, 16).hex_of(),
    ),
  })
}

fn renamed(a: Output, n: RootName, k: RootKey) -> Output =
  {
    ..a,
    tables: {
      ..a.tables,
      calls: a.tables.calls.map(|c: RootKey| if root_name(c) == n { k } else { c }),
    },
  }

fn placeholders_named(text: Bytes, roots: List<RootName>) -> Bytes / {abort.raise} = {
  let walk_levels = holes(text).filter(|h: Hole| h.kind == 103).fold(
    { from: 0, out: [] },
    |s: { from: Int, out: List<Bytes> }, h: Hole|
      {
        from: h.close_position + 2,
        out: s.out.push(text.slice(s.from, h.open_position)).push(
          symbol_of(root_text(roots.get(digits(h.digits)))),
        ),
      },
  );
  Bytes::concat_all(walk_levels.out.push(text.slice(walk_levels.from, text.len())))
}

fn unmade(reason: Bytes) -> Diagnostic =
  error_with_labels(b"E0505", b"Ply failed making this program's unit: ".concat(reason), [], [
    b"this is Ply's fault, not the program's",
  ])

pub fn unit_parts(
  dump: Dump,
  emission: Result<Emission, Bytes>,
) -> Result<List<WrittenPart>, List<Diagnostic>> / {abort.raise} =
  match emission {
    Err(reason) -> Err([unmade(reason)]),
    Ok(e) -> if e.unserved.len() > 0 { Err([runtime_rejected(e.unserved)]) }
    else if e.unbound.len() > 0 { Err([natives_rejected(e.unbound)]) }
    else if e.signature_mismatches.len() > 0 {
      Err([signature_mismatch_error(e.signature_mismatches)])
    } else {
      match requested_roots(dump).unkeyed {
        [] -> Ok(e.produced.parts),
        unkeyed ->
          Err([
            unmade(
              Bytes::concat_all([
                b"the front end offered ",
                Bytes::join(unkeyed.map(|n: Bytes| Bytes::concat_all([b"`", n, b"`"])), b", "),
                b" with no typed effects to key them by",
              ]),
            ),
          ]),
      }
    },
  }

pub fn unit_text(parts: List<WrittenPart>) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    [unit_header()].concat(
      parts.map(|w: WrittenPart|
        match w.text {
          Some(t) -> t,
          None -> panic("a unit whose text is read takes no part from the cache"),
        }),
    ),
  )

type Fresh = { text: Bytes, parts: List<WrittenPart>, taken: List<RootName>, made: UnitContents }

fn fresh(
  constructors: List<Constructor>,
  offered: List<RequestedRoot>,
  modules: Int,
  results: Map<RootName, Output>,
  inputs: Map<Bytes, Bytes>,
  machine_of: (Map<Bytes, Bool>) -> List<Native> / {abort.raise},
  rule: PartRule,
) -> Fresh / {abort.raise} = {
  let p = produce(
    constructors,
    offered,
    modules,
    results,
    inputs,
    machine_of,
    rule,
    Map::new(),
    Map::new(),
    |_: Bytes| None,
    |_: String| false,
  );
  { text: unit_text(p.parts), parts: p.parts, taken: p.taken, made: p.made }
}

fn some_definitions() -> Bytes =
  b"compiler.unit.emitted aa\ncompiler.front.emitter_input.view_dump bb\nunit.emitted cc\ncompiler.unit.emitted_twice dd\n"

fn transitive_needs(
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
) -> Map<RootName, List<Need>> / {abort.raise} =
  extended_needs(generic_bodies(results, keys, results.keys()), Map::new())

fn transitive_called(
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
) -> Map<RootName, List<Int>> / {abort.raise} =
  extended_called(generic_bodies(results, keys, results.keys()), Map::new())

fn generic_body(calls: List<GenericCall>, needs: List<Need>) -> Output =
  {
    text: b"",
    tables: { ..no_tables(), generics: { ..no_generics(), calls: calls, needs: needs } },
  }

fn parsed_type(s: Bytes) -> Type / {abort.raise} =
  match decode_type(s) {
    Some(t) -> t,
    None -> panic(String::of_bytes_lossy(b"a spelling of no type: ".concat(s))),
  }

fn results_and_keys(
  results: List<{ key: RootKey, value: Output }>,
) -> { results: Map<RootName, Output>, keys: Map<RootName, RootKey> } =
  {
    results: results.fold(
      Map::new(),
      |m: Map<RootName, Output>, x: { key: RootKey, value: Output }|
        m.insert(root_name(x.key), x.value),
    ),
    keys: results.fold(
      Map::new(),
      |m: Map<RootName, RootKey>, x: { key: RootKey, value: Output }|
        m.insert(root_name(x.key), x.key),
    ),
  }

fn definition_root(n: Bytes) -> RootName = root_name(Named(n))

fn no_machine(called: Map<Bytes, Bool>) -> List<Native> = []

fn by_definition<v>(entries: List<{ key: Bytes, value: v }>) -> Map<RootName, v> =
  entries.fold(Map::new(), |m: Map<RootName, v>, x: { key: Bytes, value: v }|
    m.insert(definition_root(x.key), x.value))

fn offer_root(k: RootKey, arity: Int) -> RequestedRoot =
  { name: root_name(k), arity: arity, constant: false, site: root_name(k), home: home_of(k) }

fn request(n: Bytes, arity: Int) -> RequestedRoot = offer_root(Named(n), arity)

test "a generic call resolves on each argument its callee's code needs, and leaves the rest" {
  let needs = by_definition([
    { key: b"m.lay", value: [{ var: 0, reads: Layout }] },
    { key: b"m.add", value: [{ var: 0, reads: Scalar }] },
    { key: b"m.same", value: [{ var: 0, reads: Exact }] },
  ]);
  let root = |callee: Bytes, arg: Bytes|
    call_specialisation(
      {
        callee: Named(callee),
        args: [parsed_type(arg)],
        specialised_variables: [],
        functions: [],
        effect_evidence: [],
      },
      needs,
      Map::new(),
      no_constructors(),
    );
  let call = |callee: Bytes, arg: Bytes| root_text(root_name(root(callee, arg)));
  assert_eq(call(b"m.lay", b"{x:Float}"), b"m.lay@{x:Float}");
  assert_eq(call(b"m.lay", b"_"), b"m.lay@_");
  assert_eq(call(b"m.lay", b"{x:m.Shape}"), b"m.lay@{x:_}");
  assert_eq(call(b"m.lay", b"{x:m.Date}"), call(b"m.lay", b"{x:m.Shape}"));
  assert_eq(key_types(root(b"m.lay", b"{x:m.Date}")), [parsed_type(b"{x:m.Date}")]);
  assert_eq(call(b"m.same", b"List<m.Shape>"), b"m.same@List<m.Shape>");
  assert_eq(call(b"m.same", b"m.Date{day:Int}"), b"m.same@m.Date{day:Int}");
  assert_eq(call(b"m.add", b"Float"), b"m.add@Float");
  assert_eq(call(b"m.add", b"{x:Float}"), b"m.add");
  assert_eq(call(b"m.add", b"m.Shape"), b"m.add");
  assert_eq(call(b"m.lay", b"{x:'0}"), b"m.lay");
  assert_eq(call(b"m.none", b"Float"), b"m.none")
}

test "a lambda is run in place only by a callee that calls the parameter it is handed as" {
  let body = |called: List<Int>, passes: List<ForwardedParameter>|
    {
      text: b"",
      tables: {
        ..no_tables(),
        generics: { ..no_generics(), called_parameters: called, passes: passes },
      },
    };
  let results = by_definition([
    { key: b"m.each", value: body([1], []) },
    { key: b"m.pass", value: body([], [{ param: 0, callee: Named(b"m.each"), at: 1 }]) },
    { key: b"m.keep", value: body([], []) },
  ]);
  let called = transitive_called(results, Map::new());
  assert_eq(called.get(definition_root(b"m.pass")), Some([0]));
  let call = |callee: Bytes, param: Int|
    printed(
      call_specialisation(
        {
          callee: Named(callee),
          args: [],
          specialised_variables: [],
          functions: [{ param: param, owner: Named(b"m.main"), nth: 0 }],
          effect_evidence: [],
        },
        Map::new(),
        called,
        no_constructors(),
      ),
    );
  assert_eq(call(b"m.each", 1), b"m.each@|1=m.main:0");
  assert_eq(call(b"m.pass", 0), b"m.pass@|0=m.main:0");
  assert_eq(call(b"m.each", 0), b"m.each");
  assert_eq(call(b"m.keep", 0), b"m.keep")
}

test "a generic body needs what its callees need of what it hands them, through its own variables" {
  let results = by_definition([
    { key: b"m.add", value: generic_body([], [{ var: 0, reads: Scalar }]) },
    { key: b"m.lay", value: generic_body([], [{ var: 0, reads: Layout }]) },
    {
      key: b"m.wrap",
      value: generic_body(
        [
          {
            callee: Named(b"m.add"),
            args: [parsed_type(b"'0")],
            specialised_variables: [],
            functions: [],
            effect_evidence: [],
          },
          {
            callee: Named(b"m.lay"),
            args: [parsed_type(b"{v:'1}")],
            specialised_variables: [],
            functions: [],
            effect_evidence: [],
          },
        ],
        [],
      ),
    },
    {
      key: b"m.outer",
      value: generic_body(
        [
          {
            callee: Named(b"m.wrap"),
            args: [parsed_type(b"List<_>"), parsed_type(b"'0")],
            specialised_variables: [],
            functions: [],
            effect_evidence: [],
          },
        ],
        [],
      ),
    },
    { key: b"m.same", value: generic_body([], [{ var: 0, reads: Exact }]) },
    {
      key: b"m.each",
      value: generic_body(
        [
          {
            callee: Named(b"m.same"),
            args: [parsed_type(b"List<'0>")],
            specialised_variables: [],
            functions: [],
            effect_evidence: [],
          },
        ],
        [],
      ),
    },
  ]);
  let closed = transitive_needs(results, Map::new());
  assert_eq(
    closed.get(definition_root(b"m.wrap")),
    Some([{ var: 0, reads: Scalar }, { var: 1, reads: Layout }]),
  );
  assert_eq(closed.get(definition_root(b"m.outer")), Some([{ var: 0, reads: Layout }]));
  assert_eq(closed.get(definition_root(b"m.each")), Some([{ var: 0, reads: Exact }]))
}

test "a generic body whose needs or its callees' read a variable's layout or type is resolved by its callers" {
  let results = by_definition([
    { key: b"m.add", value: generic_body([], [{ var: 0, reads: Scalar }]) },
    { key: b"m.lay", value: generic_body([], [{ var: 0, reads: Layout }]) },
    { key: b"m.same", value: generic_body([], [{ var: 0, reads: Exact }]) },
    {
      key: b"m.each",
      value: generic_body(
        [
          {
            callee: Named(b"m.same"),
            args: [parsed_type(b"List<'0>")],
            specialised_variables: [],
            functions: [],
            effect_evidence: [],
          },
        ],
        [],
      ),
    },
    { key: b"m.main", value: generic_body([], []) },
  ]);
  let unemitted = unemitted_generics(results, Map::new(), transitive_needs(results, Map::new()));
  assert_eq(unemitted.keys(), [b"m.each", b"m.lay", b"m.same"].map(definition_root));
  let had = results_and_keys([
    { key: specialisation_key(b"m.same", [parsed_type(b"Int")], []), value: generic_body([], []) },
    { key: Named(b"m.same"), value: generic_body([], [{ var: 0, reads: Exact }]) },
  ]);
  let cached = with_unemitted_rejected(
    had.results,
    had.keys,
    unemitted_generics(had.results, had.keys, Map::new()),
  );
  assert_eq(
    cached.keys(),
    [specialisation_key(b"m.same", [parsed_type(b"Int")], [])].map(root_name),
  );
  let open = results_and_keys([
    {
      key: specialisation_key(b"m.same", [unknown_type()], []),
      value: generic_body([], [{ var: 0, reads: Exact }]),
    },
  ]);
  let said = handle {
    with_unemitted_rejected(open.results, open.keys, Map::new());
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert(said.index_of(b"still reads a type variable's layout or type") != None, None)
}

test "a body calling one its unit does not take, such as one its callers resolve, stops the unit with an internal error" {
  let calling = { text: b"", tables: { ..no_tables(), calls: [Named(b"m.same")] } };
  let said = handle {
    taken_bodies(by_definition([{ key: b"m.main", value: calling }]), Map::new(), [
      definition_root(b"m.main"),
    ]);
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert_eq(said, b"`m.main` calls `m.same`, which its unit does not take")
}

test "a call of a generic tail loop at a type resolves to the loop at it, whichever member it calls" {
  let source = Bytes::concat_all([
    b"fn ping<a>(x: a, n: Int) -> a = if n <= 0 { x } else { pong(x, n - 1) }\n",
    b"fn pong<a>(x: a, n: Int) -> a = if n <= 0 { x } else { ping(x, n - 1) }\n",
    b"fn go() -> Float = ping(1.5, 3)\n",
    b"fn back() -> String = pong(\"s\", 3)\n",
  ]);
  let dump = dump_of(analyse(parse_all([{ name: b"m", src: source }])));
  match emitted(
      a_runtime(b"r"),
      dump,
      [source],
      Map::new(),
      [Named(b"m.go"), Named(b"m.back")],
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(reason) -> panic(String::of_bytes_lossy(reason)),
    Ok(e) -> {
      assert_eq(
        [b"m.ping@Float", b"m.pong@String", b"m.ping", b"m.pong"].filter(|n: Bytes|
          e.produced.taken.map(root_text).contains(n)),
        [b"m.ping@Float", b"m.pong@String"],
      )
    },
  }
}

fn specialisation_text(result: Bytes) -> Bytes = {
  let own = own_symbol(None);
  Bytes::concat_all([b"Word ", own, b"(PlyCtx *ctx) { return ", own, b"(ctx) + ", result, b"; }"])
}

fn specialisation_tables(k: RootKey) -> Tables =
  { ..no_tables(), calls: [k], defined: [{ entered: false, head: word_prototype(0) }] }

fn program_calling_f_at(
  at: List<Bytes>,
) -> { coded: List<RootKey>, bodies: Map<RootName, Output> } / {abort.raise} = {
  let specialised = |arg: Bytes| {
    let k = specialisation_key(b"m.f", [parsed_type(arg)], []);
    {
      key: k,
      value: {
        text: specialisation_text(if arg == b"U8" { b"1" } else { b"0" }),
        tables: specialisation_tables(k),
      },
    }
  };
  let calling = |arg: Bytes| {
    let call = {
      callee: Named(b"m.f"),
      args: [parsed_type(arg)],
      specialised_variables: [],
      functions: [],
      effect_evidence: [],
    };
    { key: Named(b"m.calls_".concat(arg)), value: { ..generic_body([call], []), text: b"@@g0@@" } }
  };
  let had = results_and_keys(
    [{ key: Named(b"m.f"), value: generic_body([], [{ var: 0, reads: Exact }]) }].concat(
      at.map(specialised),
    ).concat(
      at.map(calling),
    ),
  );
  let c = compiled(had.results, had.keys, Map::new());
  let s = generic_calls_specialised(
    c.results,
    c.keys,
    transitive_needs(had.results, had.keys),
    transitive_called(had.results, had.keys),
    no_constructors(),
  );
  {
    coded: c.coded.map(|x: { key: RootKey, home: Bytes }| x.key),
    bodies: s.results.fold(Map::new(), |m: Map<RootName, Output>, n: RootName, a: Output|
      m.insert(n, resolved_text(n, a, Map::new(), s.named, |_: Bytes| None))),
  }
}

fn f_specialisation_key(arg: Bytes) -> RootKey / {abort.raise} =
  specialisation_key(b"m.f", [parsed_type(arg)], [])

test "a code two specialisations share is one body and a stub of each, and a code one has stays its body" {
  let alone = program_calling_f_at([b"Int", b"U8"]);
  let both = program_calling_f_at([b"Int", b"Bool", b"U8"]);
  assert_eq(alone.coded, []);
  assert_eq(
    alone.bodies.get(root_name(f_specialisation_key(b"Int"))),
    Some({
      text: specialisation_text(b"0"),
      tables: specialisation_tables(f_specialisation_key(b"Int")),
    }),
  );
  match both.coded {
    [code] -> {
      assert_eq(
        both.bodies.get(root_name(code)),
        Some({ text: specialisation_text(b"0"), tables: specialisation_tables(code) }),
      );
      let calls = |arg: Bytes|
        match both.bodies.get(root_name(f_specialisation_key(arg))) {
          Some(a) -> a.tables.calls,
          None -> [],
        };
      assert_eq([calls(b"Int"), calls(b"Bool")], [[code], [code]]);
      let stub_text = match both.bodies.get(root_name(f_specialisation_key(b"Int"))) {
        Some(a) -> a.text,
        None -> b"",
      };
      assert(
        stub_text.index_of(symbol_of(printed(code))) != None,
        Some(String::of_bytes_lossy(stub_text)),
      )
    },
    _ -> assert_eq(both.coded.len(), 1),
  };
  assert_eq(
    both.bodies.get(root_name(f_specialisation_key(b"U8"))),
    alone.bodies.get(root_name(f_specialisation_key(b"U8"))),
  )
}

test "a caller names the specialisation it calls by its own name, whichever other specialisations share its code" {
  let called = |p: { coded: List<RootKey>, bodies: Map<RootName, Output> }, caller: Bytes|
    match p.bodies.get(definition_root(caller)) { Some(a) -> a.text, None -> b"" };
  let alone = program_calling_f_at([b"Int", b"U8"]);
  let both = program_calling_f_at([b"Int", b"Bool", b"U8"]);
  assert_eq(called(alone, b"m.calls_Int"), symbol_of(printed(f_specialisation_key(b"Int"))));
  assert_eq(called(both, b"m.calls_Int"), called(alone, b"m.calls_Int"));
  assert_eq(called(both, b"m.calls_Bool"), symbol_of(printed(f_specialisation_key(b"Bool"))));
  assert_eq(called(both, b"m.calls_U8"), called(alone, b"m.calls_U8"))
}

test "a unit compiles specialisations whose code is alike as one body, and each as a stub of its own name" {
  let source = Bytes::concat_all([
    b"fn apply<a>(f: (a) -> a, x: a) -> a = f(x)\n",
    b"fn one() -> Int = apply(|x: Int| x, 1)\n",
    b"fn two() -> Int = apply(|x: Int| x, 2)\n",
  ]);
  match built([{ name: b"m", src: source }]) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(e) -> {
      let specialisations = e.roots.filter(|k: RootKey|
        match k { Specialisation(a, _) -> a.definition == b"m.apply", _ -> false });
      let codes = e.produced.taken.filter(|n: RootName| root_text(n).starts_with(b"m.apply@="));
      let named = |symbol: Bytes| unit_text(e.produced.parts).index_of(symbol) != None;
      assert_eq([specialisations.len(), codes.len()], [2, 1]);
      assert(specialisations.all(|k: RootKey| named(symbol_of(printed(k)))), None);
      assert(codes.all(|n: RootName| named(symbol_of(root_text(n)))), None)
    },
  }
}

test "a definition's hash is read under its full name and no other" {
  assert_eq(definition_hash(some_definitions(), b"compiler.unit.emitted"), Some(b"aa"));
  assert_eq(
    definition_hash(some_definitions(), b"compiler.front.emitter_input.view_dump"),
    Some(b"bb"),
  );
  assert_eq(definition_hash(some_definitions(), b"compiler.unit.emitted_twice"), Some(b"dd"));
  assert_eq(definition_hash(some_definitions(), b"unit.emitted"), Some(b"cc"));
  assert_eq(definition_hash(some_definitions(), b"front.seam.view_dump"), None);
  assert_eq(definition_hash(some_definitions(), b"emitted"), None);
  assert_eq(definition_hash(some_definitions(), b"compiler.unit.emit"), None)
}

test "an identity moves with the hash of a root it names, and with no other definition's" {
  let roots = [b"compiler.unit.emitted", b"compiler.front.emitter_input.view_dump"];
  let one = identity_of(some_definitions(), roots);
  assert_eq(
    identity_of(
      b"compiler.unit.emitted aa\ncompiler.front.emitter_input.view_dump bb\ncompiler.unit.emitted_twice ee\nzeta.new ff\n",
      roots,
    ),
    one,
  );
  assert(
    identity_of(b"compiler.unit.emitted aa\ncompiler.front.emitter_input.view_dump b0\n", roots)
      != one,
    Some("a root's hash moved and the identity did not"),
  );
  assert(identity_of(some_definitions(), [b"compiler.unit.emitted"]) != one, None)
}

fn a_runtime(identity: Bytes) -> Runtime / {abort.raise} =
  serving_runtime(identity, program_natives([]).map(declared_signature))

fn builder_definitions(main: Bytes) -> Bytes =
  Bytes::concat_all([b"compiler.build.build_program ", main, b"\ncompiler.build.told e5\n"])

test "a program's key moves with the definition it enters, the runtime and the builder, and with nothing else" {
  let key = program_key(b"entry", a_runtime(b"rt"), builder_definitions(b"c3"));
  assert_eq(key.len(), 64);
  assert_eq(
    program_key(b"entry", a_runtime(b"rt"), builder_definitions(b"c3").concat(b"other.one f6\n")),
    key,
  );
  assert(program_key(b"other", a_runtime(b"rt"), builder_definitions(b"c3")) != key);
  assert(program_key(b"entry", a_runtime(b"tr"), builder_definitions(b"c3")) != key);
  assert(program_key(b"entry", a_runtime(b"rt"), builder_definitions(b"c4")) != key)
}

test "a line of what a unit says of itself is cut into literals a compiler takes, its newline last" {
  assert_eq(literal_lines(b""), b"\"\" \"\\n\"\n");
  let long = Bytes::concat_all(range(0, 2001).map(|_: Int| b"x"));
  let batch_count = literal_lines(long).split(b"\n");
  assert_eq(batch_count.len(), 3);
  assert_eq(batch_count.get(0).len(), 2002);
  assert_eq(batch_count.get(1), b"  \"x\" \"\\n\"")
}

test "lines are read as a final newline ends the last one" {
  assert_eq(split_lines(b"a\nb\n"), [b"a", b"b"]);
  assert_eq(split_lines(b"a\r\n\nb"), [b"a", b"", b"b"])
}

fn one_body(name: Bytes, calls: List<Bytes>) -> Output / {abort.raise} = {
  let own = statics_of(StringDatum(name));
  {
    text: Bytes::concat_all([
      b"Word ",
      own_symbol(None),
      b"(PlyCtx *ctx) { return (Word)(intptr_t)&",
      own.get(0).name,
      b" + @@r@@; }",
    ]),
    tables: {
      ..no_tables(),
      statics: own,
      calls: calls.map(Named),
      defined: [{ entered: true, head: word_prototype(0) }],
    },
  }
}

fn with_head(a: Output, head: Prototype) -> Output =
  {
    ..a,
    tables: {
      ..a.tables,
      defined: a.tables.defined.map(|d: DefinitionSymbol| { ..d, head: head }),
    },
  }

fn edited_body(name: Bytes) -> Output / {abort.raise} = {
  let b = one_body(name, []);
  { ..b, text: b.text.concat(b"\n/* edited */") }
}

fn root_codes(
  results: List<{ key: Bytes, value: Output }>,
  offered: List<Bytes>,
  constants: List<Bytes>,
) -> Map<Bytes, Bytes> / {abort.raise} =
  codes(
    fresh(
      [],
      offered.map(|n: Bytes| { ..request(n, 0), constant: constants.contains(n) }),
      1,
      by_definition(results),
      Map::new(),
      no_machine,
      part_rule(),
    ).made,
  ).fold(Map::new(), |m: Map<Bytes, Bytes>, n: RootName, code: Bytes| m.insert(root_text(n), code))

test "a root's code moves with every body it can call, and with no other" {
  let program = |g: Output|
    root_codes(
      [
        { key: b"m.f", value: one_body(b"m.f", [b"m.g"]) },
        { key: b"m.g", value: g },
        { key: b"m.h", value: one_body(b"m.h", []) },
      ],
      [b"m.f", b"m.g", b"m.h"],
      [],
    );
  let before = program(one_body(b"m.g", []));
  let after = program(edited_body(b"m.g"));
  assert(before.get(b"m.f") != after.get(b"m.f"), None);
  assert(before.get(b"m.g") != after.get(b"m.g"), None);
  assert_eq(before.get(b"m.h"), after.get(b"m.h"));
  assert(before.get(b"m.f") != before.get(b"m.h"), None)
}

test "a root's code moves with how it and its callees were offered" {
  let program = |constants: List<Bytes>|
    root_codes(
      [
        { key: b"m.f", value: one_body(b"m.f", [b"m.g"]) },
        { key: b"m.g", value: one_body(b"m.g", []) },
        { key: b"m.h", value: one_body(b"m.h", []) },
      ],
      [b"m.f", b"m.g", b"m.h"],
      constants,
    );
  let called = program([]);
  let only_g = program([b"m.g"]);
  assert(called.get(b"m.g") != only_g.get(b"m.g"), None);
  assert(called.get(b"m.f") != only_g.get(b"m.f"), None);
  assert_eq(called.get(b"m.h"), only_g.get(b"m.h"))
}

test "a cycle is digested whole, whatever order the unit holds its roots in" {
  let cycle = |b: Output, order: List<Bytes>|
    root_codes(
      [{ key: b"m.a", value: one_body(b"m.a", [b"m.b"]) }, { key: b"m.b", value: b }],
      order,
      [],
    );
  let one = cycle(one_body(b"m.b", [b"m.a"]), [b"m.a", b"m.b"]);
  assert_eq(cycle(one_body(b"m.b", [b"m.a"]), [b"m.b", b"m.a"]), one);
  assert(one.get(b"m.a") != one.get(b"m.b"), None);
  let edited = {
    let b = edited_body(b"m.b");
    { ..b, tables: { ..b.tables, calls: [Named(b"m.a")] } }
  };
  assert(cycle(edited, [b"m.a", b"m.b"]).get(b"m.a") != one.get(b"m.a"), None)
}

test "a constructor's tag is its part's to read, at the position the unit's own table gives it" {
  let result = {
    text: b"Word f_m.f(PlyCtx *ctx) { return @@Tm.Line@@ + @@TNone@@; }",
    tables: {
      ..no_tables(),
      defined: [{ entered: true, head: word_prototype(0) }],
      keyed: [KeyedTag(b"m.Line"), KeyedTag(b"None")],
    },
  };
  let unit = |constructors: List<Constructor>|
    fresh(
      constructors,
      [request(b"m.f", 0)],
      1,
      by_definition([{ key: b"m.f", value: result }]),
      Map::new(),
      no_machine,
      part_rule(),
    ).text;
  let alone = unit([
    { name: b"None", arity: 0 },
    { name: b"m.Dot", arity: 0 },
    { name: b"m.Line", arity: 1 },
  ]);
  let beside = unit([
    { name: b"None", arity: 0 },
    { name: b"a.One", arity: 0 },
    { name: b"a.Two", arity: 0 },
    { name: b"m.Dot", arity: 0 },
    { name: b"m.Line", arity: 1 },
  ]);
  let label = part_label(definition_root(b"m.f"));
  let table = part_table(label);
  let body = Bytes::concat_all([b"{ return ", table, b"[1] + ", table, b"[0]; }"]);
  assert(alone.index_of(body) != None, None);
  assert(beside.index_of(body) != None, None);
  let declared = Bytes::concat_all([b"extern const uint32_t ", table, b"[];\n"]);
  assert(part_labelled(alone, label).index_of(declared) != None, None);
  let filled = |places: Bytes|
    Bytes::concat_all([b"const uint32_t ", table, b"[] = {", places, b" };\n"]);
  assert(part_labelled(alone, "tables").index_of(filled(b" 0, 2,")) != None, None);
  assert(part_labelled(beside, "tables").index_of(filled(b" 0, 4,")) != None, None)
}

fn one_each() -> PartRule = { bits: 0, min: 0, max: 1 << 40 }

fn by_names() -> PartRule = { bits: 1, min: 0, max: 1 << 40 }

type Cut = { label: String, text: Bytes }

fn parts_in(text: Bytes) -> List<Cut> / {abort.raise} =
  cc::split(text).parts.map(|w: WrittenPart|
    { label: w.label, text: match w.text { Some(t) -> t, None -> b"" } })

fn parts_before_runtime(text: Bytes) -> List<Cut> / {abort.raise} =
  parts_in(text).fold({ out: [], past: false }, |acc: { out: List<Cut>, past: Bool }, c: Cut|
    if acc.past || c.label == "runtime" { { ..acc, past: true } }
    else { { ..acc, out: acc.out.push(c) } }).out

fn part_labelled(text: Bytes, label: String) -> Bytes / {abort.raise} =
  match parts_in(text).find(|c: Cut| c.label == label) { Some(c) -> c.text, None -> b"" }

fn part_containing(text: Bytes, c: Bytes) -> Bytes / {abort.raise} =
  match parts_in(text).find(|p: Cut| p.text.index_of(c) != None) { Some(p) -> p.text, None -> b"" }

fn body_of(name: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([b"Word ", symbol_of(name), b"(PlyCtx *ctx)"])

fn numbered(n: Int) -> List<Bytes> = range(0, n).map(|i: Int| b"m.b".concat(ascii_of_int(i)))

fn unit_over(names: List<Bytes>, edited: Bytes, rule: PartRule) -> Bytes / {abort.raise} =
  fresh(
    [],
    names.map(|n: Bytes| request(n, 0)),
    1,
    by_definition(
      names.map(|n: Bytes|
        { key: n, value: if n == edited { edited_body(n) } else { one_body(n, []) } }),
    ),
    Map::new(),
    no_machine,
    rule,
  ).text

fn missing_from(xs: List<Cut>, ys: List<Cut>) -> List<Cut> = xs.filter(|x: Cut| !ys.contains(x))

test "a part's C reads the same whatever another part adds to the unit's tables" {
  let fielded = |n: Bytes, field: Bytes| {
    let b = one_body(n, []);
    {
      text: b.text.concat(b" /* @@f0@@ */"),
      tables: { ..b.tables, fields: [field], keyed: [KeyedField(0)] },
    }
  };
  let unit = |names: List<Bytes>|
    fresh(
      [{ name: b"None", arity: 0 }],
      names.map(|n: Bytes| request(n, 0)),
      1,
      by_definition(names.map(|n: Bytes| { key: n, value: fielded(n, n) })),
      Map::new(),
      no_machine,
      one_each(),
    ).text;
  let alone = unit([b"m.f"]);
  let beside = unit([b"m.f", b"a.other"]);
  let label = part_label(definition_root(b"m.f"));
  assert(part_labelled(alone, label).index_of(body_of(b"m.f")) != None, None);
  assert_eq(part_labelled(beside, label), part_labelled(alone, label));
  assert(part_labelled(beside, "tables") != part_labelled(alone, "tables"), None)
}

test "an edit to one body's C changes only the part holding it" {
  let names = numbered(16);
  let before = unit_over(names, b"", by_names());
  let after = unit_over(names, b"m.b7", by_names());
  let bodies = parts_before_runtime(before);
  assert(bodies.len() > 1 && bodies.len() < names.len(), None);
  assert_eq(parts_in(after).map(|c: Cut| c.label), parts_in(before).map(|c: Cut| c.label));
  let changed = missing_from(parts_in(after), parts_in(before));
  assert_eq(changed.map(|c: Cut| c.text), [part_containing(after, body_of(b"m.b7"))]);
  assert(changed.get(0).text.index_of(b"/* edited */") != None, None)
}

test "a body added or removed changes the part it sits in and at most one beside it" {
  let names = numbered(16);
  let before = parts_before_runtime(unit_over(names, b"", by_names()));
  [2, 7, 11, 13].fold((), |_: Unit, i: Int| {
    let added = Bytes::concat_all([b"m.b", ascii_of_int(i), b"x"]);
    let after = parts_before_runtime(unit_over(names.push(added), b"", by_names()));
    let gone = missing_from(before, after);
    let came = missing_from(after, before);
    assert(gone.len() <= 1 && came.len() <= 2, Some(String::of_bytes_lossy(added)));
    assert(came.any(|c: Cut| c.text.index_of(body_of(added)) != None), None)
  })
}

test "a small program's bodies are one part" {
  assert_eq(parts_before_runtime(unit_over(numbered(8), b"", part_rule())).len(), 1)
}

test "a body larger than the most a part holds sits alone, and the rest share parts up to it" {
  let big = b"m.b3";
  let names = numbered(8);
  let padded = {
    let b = one_body(big, []);
    { ..b, text: b.text.concat(b" ".repeat(300)) }
  };
  let text = fresh(
    [],
    names.map(|n: Bytes| request(n, 0)),
    1,
    by_definition(
      names.map(|n: Bytes| { key: n, value: if n == big { padded } else { one_body(n, []) } }),
    ),
    Map::new(),
    no_machine,
    { bits: 62, min: 1 << 40, max: 250 },
  ).text;
  assert_eq(part_containing(text, body_of(big)).split(b"(PlyCtx *ctx)").len() - 1, 1);
  assert(parts_before_runtime(text).len() < names.len(), None)
}

test "each part is labelled apart: a body's by its first body's root id, the tail's by a word" {
  let names = numbered(12);
  let text = unit_over(names, b"", one_each());
  let labels = parts_in(text).map(|c: Cut| c.label);
  assert_eq(
    parts_before_runtime(text).map(|c: Cut| c.label),
    sorted_unique(names).map(|n: Bytes| part_label(definition_root(n))),
  );
  let digits = b"0123456789abcdef";
  assert(
    parts_before_runtime(text).all(|c: Cut| {
      let label = Bytes::of_string(c.label);
      label.len() == 16 && range(0, 16).all(|i: Int| digits.index_of(label.slice(i, i + 1)) != None)
    }),
    None,
  );
  assert_eq(labels.drop(names.len()), ["runtime", "taken", "tables"])
}

test "a root whose entry the unit takes is listed as entered, though the unit holds no body of it" {
  let entry = |n: Bytes| root_name(EntryPoint(Named(n)));
  let definition = |n: Bytes| request(n, 0);
  let entered = |n: Bytes| { ..offer_root(EntryPoint(Named(n)), 0), site: definition_root(n) };
  let p = fresh(
    [],
    [definition(b"m.f"), definition(b"m.g"), entered(b"m.f"), entered(b"m.h")],
    1,
    Map::of_entries([
      { key: definition_root(b"m.f"), value: one_body(b"m.f", []) },
      { key: definition_root(b"m.g"), value: one_body(b"m.g", []) },
      { key: entry(b"m.f"), value: one_body(root_text(entry(b"m.f")), [b"m.f"]) },
      { key: entry(b"m.h"), value: one_body(root_text(entry(b"m.h")), []) },
    ]),
    Map::new(),
    no_machine,
    part_rule(),
  );
  assert(p.taken.contains(entry(b"m.f")), None);
  assert(p.text.index_of(b"entered m.f") != None, None);
  assert(p.text.index_of(b"entered m.h") != None, None);
  assert_eq(p.text.index_of(b"entered m.g"), None)
}

fn head_in(text: Bytes) -> Bytes / {abort.raise} = cc::split(text).head

test "every part of a unit compiles after the head, and the runtime's part opens with the tail" {
  let p = fresh(
    [],
    [request(b"m.f", 0)],
    1,
    by_definition([{ key: b"m.f", value: one_body(b"m.f", []) }]),
    Map::new(),
    no_machine,
    part_rule(),
  );
  assert(head_in(p.text) == unit_header(), None);
  assert(p.text.index_of(unit_tail([])) != None, None);
  assert(
    p.text.index_of(
        Bytes::concat_all([
          b"\"helpers ",
          ascii_of_int(bound_functions().len()),
          b"\" \"\\n\"\n\"rt_failed 4 0\"",
        ]),
      )
      != None,
    None,
  )
}

test "a part declares what its bodies reach, and nothing else" {
  let caller = b"m.caller";
  let callee = b"m.callee";
  let apart = b"m.apart";
  let p = fresh(
    [],
    [request(caller, 0), request(callee, 2), request(apart, 0)],
    1,
    by_definition([
      { key: caller, value: one_body(caller, [callee]) },
      { key: callee, value: with_head(one_body(callee, []), word_prototype(2)) },
      { key: apart, value: one_body(apart, []) },
    ]),
    Map::new(),
    no_machine,
    one_each(),
  );
  let declares = |part: Bytes, name: Bytes, arity: Int|
    part.index_of(prototype(symbol_of(name), word_prototype(arity))) != None;
  let calling = part_containing(p.text, body_of(caller));
  assert(
    declares(calling, caller, 0) && declares(calling, callee, 2),
    Some(String::of_bytes_lossy(calling)),
  );
  assert(!declares(calling, apart, 0), Some(String::of_bytes_lossy(calling)));
  let alone = part_containing(p.text, body_of(apart));
  assert(
    !declares(alone, caller, 0) && !declares(alone, callee, 2),
    Some(String::of_bytes_lossy(alone)),
  );
  let head = head_in(p.text);
  [caller, callee, apart].fold((), |u: Unit, name: Bytes| {
    assert_eq(p.text.split(body_of(name)).len() - 1, 1);
    assert(head.index_of(symbol_of(name)) == None, None)
  })
}

test "a specialisation running a lambda that another module passes borrowed sits among that module's bodies" {
  let borrowed = specialisation_key(b"std.walk.each", [int_type()], [
    { param: 1, owner: Named(b"m.a"), nth: 0 },
  ]);
  assert_eq(home_of(borrowed), b"m");
  assert_eq(home_of(specialisation_key(b"std.walk.each", [int_type()], [])), b"std.walk");
  let roots = [Named(b"m.a"), borrowed, Named(b"n.b")];
  let text = fresh(
    [],
    roots.map(|k: RootKey| offer_root(k, 0)),
    1,
    roots.fold(Map::new(), |acc: Map<RootName, Output>, k: RootKey|
      acc.insert(root_name(k), one_body(printed(k), []))),
    Map::new(),
    no_machine,
    part_rule(),
  ).text;
  let at = |k: RootKey| first_offset(text, body_of(printed(k)));
  assert(
    at(Named(b"m.a")) >= 0 && at(Named(b"m.a")) < at(borrowed) && at(borrowed) < at(Named(b"n.b")),
    None,
  )
}

test "a call written to another head than the callee defines fails the unit" {
  let caller = b"m.caller";
  let callee = b"m.callee";
  let expecting = |head: Prototype| {
    let b = one_body(caller, [callee]);
    {
      ..b,
      tables: {
        ..b.tables,
        generics: { ..no_generics(), expects: [{ callee: CallAt(0), head: head }] },
      },
    }
  };
  let made = |head: Prototype|
    try[abort.raise] {
      fresh(
        [],
        [request(caller, 0), request(callee, 1)],
        1,
        by_definition([
          { key: caller, value: expecting(head) },
          {
            key: callee,
            value: with_head(one_body(callee, []), { result: b"double", params: [b"double"] }),
          },
        ]),
        Map::new(),
        no_machine,
        part_rule(),
      ).taken
    };
  assert_eq(
    made({ result: b"double", params: [b"double"] }),
    Ok([callee, caller].map(definition_root)),
  );
  match made(word_prototype(1)) {
    Ok(_) -> assert(false, Some("a call to another head was taken")),
    Err(reason) ->
      assert(
        Bytes::of_string(reason).index_of(
            Bytes::concat_all([
              b"which it defines as double ",
              symbol_of(callee),
              b"(PlyCtx*, double)",
            ]),
          )
          != None,
        Some(reason),
      ),
  }
}

fn fresh_unit(
  results: List<{ key: Bytes, value: Output }>,
  inputs: Map<Bytes, Bytes>,
) -> Fresh / {abort.raise} =
  fresh(
    [],
    results.map(|a: { key: Bytes, value: Output }| request(a.key, 0)),
    1,
    by_definition(results),
    inputs,
    no_machine,
    one_each(),
  )

fn with_statics(a: Output, definitions: List<StaticDefinition>) -> Output =
  { ..a, tables: { ..a.tables, statics: a.tables.statics.concat(definitions) } }

fn static_defined(d: StaticDefinition) -> Bytes =
  Bytes::concat_all([b"const struct ", d.name, b" {"])

test "a static is defined once, in the part of the first body that names it, and declared by each other part that names it" {
  let child = statics_of(StringDatum(b"shared-constant")).get(0);
  let parent = named_by_content(StaticWords([AddressWord({ name: child.name, tag: 0 })]));
  let p = fresh_unit(
    [
      { key: b"m.one", value: with_statics(one_body(b"m.one", []), [child]) },
      { key: b"m.two", value: with_statics(one_body(b"m.two", []), [child, parent]) },
      { key: b"m.apart", value: one_body(b"m.apart", []) },
    ],
    Map::new(),
  );
  let one = part_containing(p.text, body_of(b"m.one"));
  let two = part_containing(p.text, body_of(b"m.two"));
  assert(first_offset(p.text, one) < first_offset(p.text, two), None);
  assert_eq(p.text.split(static_defined(child)).len() - 1, 1);
  assert(
    one.index_of(static_defined(child)) != None && one.index_of(static_extern(child.name)) == None,
    Some(String::of_bytes_lossy(one)),
  );
  let declared = first_offset(two, static_extern(child.name));
  assert(
    declared >= 0 && declared < first_offset(two, static_defined(parent))
      && two.index_of(static_defined(child)) == None,
    Some(String::of_bytes_lossy(two)),
  );
  assert(part_containing(p.text, body_of(b"m.apart")).index_of(child.name) == None, None);
  assert_eq(part_labelled(p.text, "fields"), b"");
  assert(p.text.index_of(b"consts ") == None, None)
}

test "a static holding a field's position is defined in the `fields` part, and declared where a body names it" {
  let child = statics_of(StringDatum(b"child")).get(0);
  let parent = named_by_content(
    StaticWords([FieldWord(b"op"), AddressWord({ name: child.name, tag: 0 })]),
  );
  let p = fresh_unit(
    [{ key: b"m.f", value: with_statics(one_body(b"m.f", []), [child, parent]) }],
    Map::new(),
  );
  let fields = part_labelled(p.text, "fields");
  let own = part_containing(p.text, body_of(b"m.f"));
  assert(
    fields.index_of(static_defined(parent)) != None
      && fields.index_of(static_extern(child.name)) != None,
    Some(String::of_bytes_lossy(fields)),
  );
  assert(
    own.index_of(static_defined(child)) != None && own.index_of(static_extern(parent.name)) != None,
    Some(String::of_bytes_lossy(own)),
  );
  assert_eq([child, parent].map(|d: StaticDefinition| p.text.split(static_defined(d)).len() - 1), [
    1,
    1,
  ])
}

test "an embedded file is laid out once from the bytes the unit is handed, raw" {
  let digest = b"\x00\xff".blake3();
  let file = [named_by_content(StaticFile(digest))];
  let p = fresh_unit(
    [
      { key: b"m.f", value: with_statics(one_body(b"m.f", []), file) },
      { key: b"m.g", value: with_statics(one_body(b"m.g", []), file) },
    ],
    Map::new().insert(digest, b"\x00\xff"),
  );
  assert_eq(p.text.split(b"\"\\000\\377\"").len() - 1, 1);
  assert(p.text.index_of(b"{ .len = 2, .room = 2 }") != None, None)
}

test "two statics of one name holding different content stop the unit" {
  let a = statics_of(StringDatum(b"a")).get(0);
  let forged = { name: a.name, layout: statics_of(StringDatum(b"b")).get(0).layout };
  let said = handle {
    fresh_unit(
      [
        { key: b"m.f", value: with_statics(one_body(b"m.f", []), [a]) },
        { key: b"m.g", value: with_statics(one_body(b"m.g", []), [forged]) },
      ],
      Map::new(),
    );
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert(said.starts_with(b"two statics of one name contain different content"), None)
}

test "a cached body stands only where each callee it names still has the key it was recorded with" {
  let keys = by_definition([{ key: b"m.b", value: b"kb" }]);
  let body = one_body(b"m.a", [b"m.b"]);
  let recorded = cached_result_of(keys, body);
  let resolved = {
    let b = body;
    b.tables.calls.fold(Map::new(), |m: Map<Bytes, RootKey>, k: RootKey| m.insert(key_digest(k), k))
  };
  assert_eq(recorded.callees, [Some(b"kb")]);
  assert(recorded.calls.len() == 1 && recorded.calls.all(|d: Bytes| d.len() == 32), None);
  assert_eq(restored_result(keys, resolved, recorded), Some(summarised(body)));
  assert_eq(recorded.body, body_digest(body));
  assert_eq(
    restored_result(by_definition([{ key: b"m.c", value: b"kb" }]), resolved, recorded),
    None,
  );
  assert_eq(
    restored_result(by_definition([{ key: b"m.b", value: b"another" }]), resolved, recorded),
    None,
  );
  assert_eq(restored_result(keys, Map::new(), recorded), None)
}

fn three_modules() -> List<Bytes> =
  [
    b"import b\nimport c\nfn f(x: Int) -> Int = b::g(x) + c::h(x)\n",
    b"import c\npub fn g(x: Int) -> Int = c::h(x) * 2\n",
    Bytes::concat_all([
      b"pub fn h(x: Int) -> Int = if even(x) { x } else { x + 1 }\n",
      b"fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n",
      b"fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n",
    ]),
  ]

fn three_modules_dump() -> Dump / {abort.raise} = {
  let texts = three_modules();
  dump_of(
    analyse(
      parse_all([
        { name: b"a", src: texts.get(0) },
        { name: b"b", src: texts.get(1) },
        { name: b"c", src: texts.get(2) },
      ]),
    ),
  )
}

test "a unit reads the modules its roots are written in and what those import, and no other" {
  let dump = three_modules_dump();
  let over = |root: Bytes| program_of(dump, three_modules(), [Named(root)]);
  let read = |root: Bytes| over(root).read.keys().filter(|m: Bytes| m != prelude_module());
  assert_eq(read(b"c.h"), [b"c"]);
  assert_eq(read(b"b.g"), [b"b", b"c"]);
  assert_eq(read(b"a.f"), [b"a", b"b", b"c"]);
  let p = over(b"b.g");
  assert_eq(p.digests.keys(), [b"b", b"c"]);
  let whole = program_of(dump, three_modules(), [Named(b"a.f")]);
  assert_eq(modules_asked(whole, [Named(b"b.g")]).keys(), p.read.keys());
  let scope = scope_of_modules(
    dump,
    whole,
    [],
    [Named(b"b.g")],
    modules_asked(whole, [Named(b"b.g")]),
  );
  assert_eq(
    emit::root_outputs(scope, [Named(b"b.g")], Map::new()).map(|r: RootOutput| root_text(r.name)),
    [b"b.g"],
  )
}

test "a scope serving a specialisation holds the module declaring a type it is at, which its definition's does not import" {
  let user = [
    { name: b"s", src: b"pub type E = | A | B\n" },
    {
      name: b"g",
      src: b"pub fn first<a>(xs: List<a>) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }\n",
    },
    {
      name: b"m",
      src: b"import g\nimport s (E)\nfn pick(xs: List<E>) -> Option<E> = g::first(xs)\n",
    },
  ];
  let dump = dump_of(analyse(parse_all(user)));
  let p = program_of(dump, sources_in_order(dump, user), requested_roots(dump).keys);
  let at = specialisation_key(b"g.first", [NamedType({ name: b"s.E", args: [] })], []);
  assert_eq(modules_lowered([at]).keys(), [b"g"]);
  let asked = modules_asked(p, [at]);
  assert(asked.contains(b"s") && asked.contains(b"g") && !asked.contains(b"m"), None)
}

test "roots written for types are dealt apart, however many one module writes" {
  let p = program_of(
    three_modules_dump(),
    three_modules(),
    requested_roots(three_modules_dump()).keys,
  );
  let written = range(0, batch_count()).map(|i: Int|
    keys::generated_key(keys::Drop, parsed_type(b"a.T".concat(ascii_of_int(i))), b"a"));
  let lists = batches(p, written.push(Named(b"a.f")));
  assert_eq(lists.len(), batch_count());
  assert_eq(lists.fold(0, |n: Int, roots: List<RootKey>| n + roots.len()), batch_count() + 1)
}

test "a module's definitions are dealt together, its specialisations by their definitions, each once" {
  let dump = three_modules_dump();
  let p = program_of(dump, three_modules(), requested_roots(dump).keys);
  let at = |definition: Bytes, borrowed: List<InlinedLambda>|
    specialisation_key(definition, [string_type()], borrowed);
  let borrowed = at(b"c.even", [{ param: 0, owner: Named(b"b.g"), nth: 0 }]);
  let missed = requested_roots(dump).keys.concat([at(b"c.h", []), at(b"c.odd", []), borrowed]);
  let lists = batches(p, missed);
  assert_eq(lists.len(), sorted_unique(missed.map(batch_key)).len());
  assert_eq(batch_key(borrowed), b"b");
  assert_eq(batch_key(Named(b"c.odd")), batch_key(Named(b"c.even")));
  assert(batch_key(at(b"c.h", [])) != batch_key(at(b"c.odd", [])), None);
  assert_eq(
    sorted_unique(
      lists.fold([], |acc: List<RootName>, roots: List<RootKey>| acc.concat(roots.map(root_name))),
    ),
    sorted_unique(missed.map(root_name)),
  );
  let together = |roots: List<RootKey>| sorted_unique(roots.map(batch_key));
  assert_eq(
    lists.fold(0, |n: Int, roots: List<RootKey>| n + together(roots).len()),
    together(missed).len(),
  );
  let many = range(0, 3 * batch_count()).map(|i: Int|
    Named(Bytes::concat_all([b"m", ascii_of_int(i), b".f"])));
  assert_eq(batches(p, many).len(), batch_count())
}

test "a root's cached result changes with what its module embeds, and with no other module's" {
  let dump = three_modules_dump();
  let embedding = |bytes: Bytes|
    program_of(
      {
        ..dump,
        embeds: [{ module: b"c", key: b"file:data.txt", read: Ok([embed_file(b"", bytes)]) }],
      },
      three_modules(),
      requested_roots(dump).keys,
    );
  let one = root_cache_key(embedding(b"one"), b"", Named(b"c.h"));
  assert(one != None, None);
  assert(one != root_cache_key(embedding(b"two"), b"", Named(b"c.h")), None);
  assert_eq(
    root_cache_key(embedding(b"one"), b"", Named(b"a.f")),
    root_cache_key(
      program_of(dump, three_modules(), requested_roots(dump).keys),
      b"",
      Named(b"a.f"),
    ),
  );
  let spec = |p: Program, lender: Bytes|
    root_cache_key(
      p,
      b"",
      specialisation_key(b"c.h", [], [{ param: 0, owner: Named(lender), nth: 0 }]),
    );
  assert(spec(embedding(b"one"), b"a.f") != spec(embedding(b"two"), b"a.f"), None);
  assert(spec(embedding(b"one"), b"a.f") != spec(embedding(b"one"), b"b.g"), None)
}

fn program_declaring(cases: Bytes) -> Program / {abort.raise} = {
  let texts = [
    Bytes::concat_all([b"pub type E = ", cases, b"\n"]),
    b"pub fn first<a>(xs: List<a>) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }\n",
  ];
  let dump = dump_of(
    analyse(parse_all([{ name: b"s", src: texts.get(0) }, { name: b"g", src: texts.get(1) }])),
  );
  program_of(dump, texts, requested_roots(dump).keys)
}

test "a specialisation's cached result changes with the declaration of a type it is at, not its name alone" {
  let at = |p: Program, t: Type| root_cache_key(p, b"", specialisation_key(b"g.first", [t], []));
  let e = NamedType({ name: b"s.E", args: [] });
  let two = program_declaring(b"| A | B");
  let three = program_declaring(b"| A | B | C");
  assert(at(two, e) != None, None);
  assert(at(two, e) != at(three, e), None);
  assert_eq(at(two, e), at(program_declaring(b"| A | B"), e));
  let int = int_type();
  assert_eq(at(two, int), at(three, int))
}

test "a root written from a type is kept under its module's text and the program's types" {
  let dump = three_modules_dump();
  let p = program_of(dump, three_modules(), requested_roots(dump).keys);
  let types = types_digest(dump);
  let reflected = keys::generated_key(keys::Reflect, parsed_type(b"{x:Int}"), b"a");
  let cached = root_cache_key(p, types, reflected);
  assert(cached != None, None);
  assert(cached == root_cache_key(p, types, reflected), None);
  assert(cached != root_cache_key(p, types_digest({ ..dump, constructors: [] }), reflected), None);
  assert(
    cached
      != root_cache_key(
        program_of(
          dump,
          three_modules().map(|s: Bytes| s.concat(b"\n")),
          requested_roots(dump).keys,
        ),
        types,
        reflected,
      ),
    None,
  );
  assert_eq(
    root_cache_key(
      p,
      types,
      keys::generated_key(keys::Reflect, parsed_type(b"{x:Int}"), b"nowhere"),
    ),
    None,
  )
}

test "a call written against a handing its callee does not publish fails the build, naming both" {
  let handing = |definition: Bytes, borrowed: List<Bool>|
    { definition: definition_root(definition), borrowed: borrowed, borrowed_from: None };
  let body = |handings: List<PublishedSignature>, assumed: List<PublishedSignature>|
    { text: b"", tables: { ..no_tables(), handings: handings, assumed: assumed } };
  let results = by_definition([
    { key: b"m.caller", value: body([], [handing(b"m.callee", [true])]) },
    { key: b"m.callee", value: body([handing(b"m.callee", [false])], []) },
    { key: b"m.fine", value: body([], [handing(b"m.callee", [false])]) },
    { key: b"m.alone", value: body([], [handing(b"m.unpublished", [false])]) },
  ]);
  let wrong = signature_mismatches(results, results.keys());
  assert_eq(wrong.map(|m: SignatureMismatch| m.caller), [definition_root(b"m.caller")]);
  let dump = dump_of(analyse(parse_all([{ name: b"m", src: b"fn one() -> Int = 1\n" }])));
  let e = {
    produced: {
      parts: [],
      taken: [],
      made: { bodies: [], requested: [], named: Map::new() },
      records: [],
    },
    roots: [],
    cached: 0,
    asked: 0,
    unserved: [],
    unbound: [],
    signature_mismatches: wrong,
  };
  match unit_parts(dump, Ok(e)) {
    Ok(_) -> assert(false, Some("a unit containing a call against the wrong handing was cached")),
    Err(diagnostics) -> {
      assert_eq(diagnostics.map(|d: Diagnostic| d.code), [b"E0478"]);
      assert_eq(diagnostics.get(0).notes_text, [
        b"`m.caller` calls `m.callee` written [borrowed] owned, where it publishes [given] owned",
      ])
    },
  }
}

test "a body written against a handing that moved is asked for again, with its recursion group" {
  let handing = |definition: Bytes, borrowed: List<Bool>|
    { definition: definition_root(definition), borrowed: borrowed, borrowed_from: None };
  let body = |handings: List<PublishedSignature>, assumed: List<PublishedSignature>, group: List<Bytes>|
    {
      text: b"",
      tables: { ..no_tables(), handings: handings, assumed: assumed, group: group.map(Named) },
    };
  let entries = [
    {
      key: b"m.f",
      value: body([handing(b"m.f", [true])], [handing(b"m.h", [true])], [b"m.f", b"m.g"]),
    },
    { key: b"m.g", value: body([handing(b"m.g", [false])], [], [b"m.f", b"m.g"]) },
    { key: b"m.h", value: body([handing(b"m.h", [false])], [], []) },
    { key: b"m.k", value: body([], [handing(b"m.h", [false])], []) },
    { key: b"m.n", value: body([], [handing(b"m.absent", [true])], []) },
    { key: b"m.o", value: body([], [handing(b"m.absent", [false])], []) },
  ];
  let results = by_definition(entries);
  let keys = by_definition(
    entries.map(|x: { key: Bytes, value: Output }| { key: x.key, value: Named(x.key) }),
  );
  assert_eq(stale_of(results, published_signatures(Map::new(), results), keys), [
    Named(b"m.f"),
    Named(b"m.g"),
  ]);
  assert_eq(
    without_partial_groups(results.remove(definition_root(b"m.g")), results.keys()).keys(),
    [b"m.h", b"m.k", b"m.n", b"m.o"].map(definition_root),
  )
}

test "a walk returns the roots it deals over lists, place by place, as the emitter returns them in one" {
  let dump = three_modules_dump();
  let p = program_of(dump, three_modules(), requested_roots(dump).keys);
  let missed = requested_roots(dump).keys;
  let scope = scope_of_modules(dump, p, [], missed, modules_asked(p, missed));
  let together = results_by_name(emit::root_outputs(scope, missed, Map::new()));
  assert(
    together.fold(false, |found: Bool, _: RootName, a: Output|
      found || a.tables.members == [Named(b"c.even"), Named(b"c.odd")]),
    None,
  );
  let walk = walk_levels(
    p,
    types_digest(dump),
    program_constructors(dump, []),
    missed,
    |_: Bytes| None,
    |_: List<Record>| (),
    None,
    |_: List<RootKey>| 0,
    |asks: Int, roots: List<RootKey>, handed: Map<RootName, OwnershipSignature>, done: KnownResults| {
      let batch_count = batches(p, roots);
      let a = results_in_parallel(scope, batch_count, 0, batch_count.len(), 64, handed, done);
      { state: asks + 1, results: decoded_results(a), found: a.found }
    },
  );
  assert(
    together.fold(true, |ok: Bool, n: RootName, a: Output| ok && walk.results.get(n) == Some(a)),
    None,
  );
  assert_eq(walk.asked, walk.keys.len());
  let places = module_levels(p);
  assert(
    p.imports.fold(true, |ok: Bool, m: Bytes, xs: List<Bytes>|
      ok
        && xs.all(|d: Bytes|
          match ((places.get(m), places.get(d))) { (Some(a), Some(b)) -> a > b, _ -> true })),
    None,
  )
}

test "a cold unit asks the emitter for each root once, place by place" {
  let dump = three_modules_dump();
  let every = requested_roots(dump).keys;
  let phases = {
    now: || 0,
    outcome: |t: LevelTally|
      if t.asked == t.roots - t.cached { () } else {
        panic(
          String::of_bytes_lossy(
            Bytes::concat_all([
              b"place ",
              ascii_of_int(t.place),
              b" asked ",
              ascii_of_int(t.asked),
              b" of ",
              ascii_of_int(t.roots),
            ]),
          ),
        )
      },
  };
  let texts = three_modules();
  let sources = sources_in_order(
    dump,
    range(0, texts.len()).map(|i: Int| { name: [b"a", b"b", b"c"].get(i), src: texts.get(i) }),
  );
  match emitted(
      a_runtime(b"r"),
      dump,
      sources,
      Map::new(),
      every,
      |_: Bytes| None,
      |_: List<Record>| (),
      Some(phases),
    ) {
    Ok(e) -> assert_eq((e.cached, e.signature_mismatches), (0, [])),
    Err(reason) -> assert_eq(reason, b""),
  }
}

fn unit_builder(
  source: Bytes,
) -> { unit: (List<RootKey>) -> Emission / {abort.raise} } / {abort.raise} = {
  let user = [{ name: b"m", src: source }];
  let shipped = [{ name: b"std.prelude", src: prelude_source::text() }];
  let modules = user.concat(shipped);
  let dump = dump_of(analyse_pulling_std_with(user, shipped, no_rows()).out);
  let runtime = { ..a_runtime(b"r"), natives: program_natives([]).map(declared_signature) };
  {
    unit: |every: List<RootKey>|
      match emitted(
          runtime,
          dump,
          sources_in_order(dump, modules),
          Map::new(),
          every,
          |_: Bytes| None,
          |_: List<Record>| (),
        ) {
        Ok(e) -> e,
        Err(reason) -> panic(String::of_bytes_lossy(reason)),
      },
  }
}

test "no root is asked to give back a scalar's box, which its last count gives back by its size" {
  let source = Bytes::concat_all([
    b"effect e {\n  write op(k: Int) -> Float\n}\n",
    b"fn listed<a>(x: a, y: a) -> List<a> = [x, y]\n",
    b"fn ints(n: Int) -> Int = match listed(n, n + 1) { [x, ..] -> x, [] -> 0 }\n",
    b"fn floats(x: Float) -> Float = match listed(x, x) { [y, ..] -> y, [] -> 0.0 }\n",
    b"fn decimals(d: Decimal) -> Int = listed(d, d).len()\n",
    b"fn wides(w: U128) -> Int = listed(w, w).len()\n",
    b"fn held(w: U128) -> Int = [{ a: w, b: \"x\" }].len()\n",
    b"fn performed(n: Int) -> Float / {e.op} = e.op(n)\n",
  ]);
  let dump = dump_of(analyse(parse_all([{ name: b"m", src: source }])));
  let every = [b"m.ints", b"m.floats", b"m.decimals", b"m.wides", b"m.held", b"m.performed"];
  let produced = match emitted(
      a_runtime(b"r"),
      dump,
      [source],
      Map::new(),
      every.map(Named),
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Ok(e) -> e.produced,
    Err(reason) -> panic(String::of_bytes_lossy(reason)),
  };
  let taken = produced.taken.map(root_text);
  let drop_at = |ty: Bytes| b"std.prelude.drop#".concat(ty);
  assert_eq(
    [b"List<Int>", b"List<Float>", b"List<Decimal>", b"List<U128>"].filter(|t: Bytes|
      !taken.contains(drop_at(t))),
    [],
  );
  assert(unit_text(produced.parts).index_of(identity_fn()) != None, None);
  assert_eq(
    taken.filter(|n: Bytes|
      [b"Int", b"Float", b"Decimal", b"U128"].any(|t: Bytes|
        [b"drop#", b"dup#", b"release#"].any(|op: Bytes| n.ends_with(op.concat(t))))),
    [],
  )
}

test "an `extern fn` no native implements, two do, or one does otherwise, is unbound" {
  let declared = |name: Bytes, words: Int, raises: Bool|
    { module: b"std.prelude", name: name, words: words, raises: raises, call: None };
  let native = |name: Bytes, words: Int, results: Bool, raises: Bool|
    word_native(name, words, results, raises);
  let found = unbound(
    [
      native(b"List::len", 1, true, false),
      native(b"assert", 2, true, true),
      native(b"twice", 1, true, false),
      native(b"twice", 1, true, false),
      native(b"wider", 2, true, false),
      native(b"silent", 1, false, false),
      native(b"calm", 1, true, false),
      native(b"undeclared", 3, true, false),
    ],
    [
      declared(b"List::len", 1, false),
      declared(b"assert", 2, true),
      declared(b"gone", 0, false),
      declared(b"twice", 1, false),
      declared(b"wider", 1, false),
      declared(b"silent", 1, false),
      declared(b"calm", 1, true),
    ],
  );
  assert_eq(found.map(|u: Unbound| { name: u.declared.name, found: u.found.len() }), [
    { name: b"gone", found: 0 },
    { name: b"twice", found: 2 },
    { name: b"wider", found: 1 },
    { name: b"silent", found: 1 },
    { name: b"calm", found: 1 },
  ]);
  assert_eq(found.map(unbound_line), [
    b"`extern fn gone` of `std.prelude`: no native of the runtime implements it",
    b"`extern fn twice` of `std.prelude`: 2 natives of the runtime implement it",
    b"`extern fn wider` of `std.prelude` takes [Word], returns Word and cannot raise, and the runtime's native takes [Word, Word], returns Word and cannot raise",
    b"`extern fn silent` of `std.prelude` takes [Word], returns Word and cannot raise, and the runtime's native takes [Word], returns nothing and cannot raise",
    b"`extern fn calm` of `std.prelude` takes [Word], returns Word and raises, and the runtime's native takes [Word], returns Word and cannot raise",
  ]);
  assert_eq(
    unbound([], [{ module: b"", name: b"?scope_take", words: 1, raises: false, call: None }]).map(
      unbound_line,
    ),
    [b"the compiler's `?scope_take`: no native of the runtime implements it"],
  );
  let marshalling = |name: Bytes| { module: b"", name: name, words: 3, raises: false, call: None };
  let declared_fun = {
    name: b"?out_fun",
    params: [abi::Opaque, abi::Addr, abi::I64],
    result: None,
    raises: false,
  };
  let swapped = { ..declared_fun, params: [abi::Addr, abi::I64, abi::Opaque] };
  assert_eq(unbound([declared_fun], [marshalling(b"?out_fun")]), []);
  assert_eq(unbound([swapped], [marshalling(b"?out_fun")]).map(unbound_line), [
    b"the compiler's `?out_fun` takes [Handed, Addr, I64], returns nothing and cannot raise, and the runtime's native takes [Addr, I64, Handed], returns nothing and cannot raise",
  ]);
  assert_eq(unbound([native(b"?out_fun", 3, false, false)], [marshalling(b"?out_fun")]).len(), 1)
}

fn unit_against_runtime(
  user: List<{ name: Bytes, src: Bytes }>,
  shipped: List<{ name: Bytes, src: Bytes }>,
  natives: List<Native>,
) -> Result<Bytes, List<Diagnostic>> / {abort.raise} = {
  let dump = dump_of(analyse_pulling_std_with(user, shipped, no_rows()).out);
  let every = requested_roots(dump).keys;
  let parts = unit_parts(
    dump,
    emitted(
      { ..a_runtime(b"r"), natives: natives },
      dump,
      sources_in_order(dump, user.concat(shipped)),
      Map::new(),
      every,
      |_: Bytes| None,
      |_: List<Record>| (),
    ),
  );
  match parts { Ok(ps) -> Ok(unit_text(ps)), Err(diagnostics) -> Err(diagnostics) }
}

fn sources_in_order(dump: Dump, modules: List<{ name: Bytes, src: Bytes }>) -> List<Bytes> = {
  let texts = modules.fold(
    Map::new().insert(prelude_module(), prelude_source::text()),
    |acc: Map<Bytes, Bytes>, s: { name: Bytes, src: Bytes }| acc.insert(s.name, s.src),
  );
  let indexed = dump.modules.fold(Map::new(), |acc: Map<Int, Bytes>, m: ModuleRow|
    acc.insert(m.index, match texts.get(m.name) { Some(t) -> t, None -> b"" }));
  range(0, indexed.len()).map(|i: Int| match indexed.get(i) { Some(t) -> t, None -> b"" })
}

fn rejection_codes<a>(r: Result<a, List<Diagnostic>>) -> List<Bytes> =
  match r {
    Ok(_) -> [],
    Err(diagnostics) ->
      diagnostics.fold([], |acc: List<Bytes>, d: Diagnostic| acc.push(d.code).concat(d.notes_text)),
  }

fn first_said(emission: Result<Emission, Bytes>, dump: Dump) -> List<Bytes> / {abort.raise} =
  match unit_parts(dump, emission) {
    Ok(_) -> [],
    Err(diagnostics) -> match diagnostics.at(0) { Some(d) -> [d.code, d.message], None -> [] },
  }

test "a root the emitter returns nothing for stops its unit with an internal error" {
  let user = [{ name: b"m", src: b"fn one() -> Int = 1\nfn two() -> Int = one() + 1\n" }];
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  let runtime = { ..a_runtime(b"r"), natives: declared_natives().map(declared_signature) };
  let said = first_said(
    emitted(
      runtime,
      dump,
      sources_in_order(dump, user),
      Map::new(),
      [b"m.one", b"m.absent", b"m.two"].map(Named),
      |_: Bytes| None,
      |_: List<Record>| (),
    ),
    dump,
  );
  assert_eq(said.at(0), Some(b"E0505"));
  assert(
    said.any(|n: Bytes| n.index_of(b"the emitter returned nothing for `m.absent`") != None),
    Some(String::of_bytes_lossy(Bytes::join(said, b"\n"))),
  )
}

test "each root a program offers is keyed by the row that says what it is, and prints as offered" {
  let user = [
    {
      name: b"m",
      src: Bytes::concat_all([
        b"fn f(x: Int) -> Int requires x > 0 ensures result > 0 = x\n",
        b"fn none<a>() -> List<a> ensures result.len() == 0 = []\n",
        b"test \"t\" for n: Int in [1] { assert(n > 0) }\n",
        b"law \"l\" forall (x: Int) where x > 0 { x + 1 > x }\n",
        b"law \"s\" forall (x: a) { x == x }\n",
      ]),
    },
  ];
  let cases = {
    name: b"std.cases",
    src: Bytes::concat_all([
      b"pub type Table<a> = List<a>\n",
      b"pub type Listed = { label: String, identity: Bytes }\n",
      b"pub fn listed<a | e>(table: List<a>, label: (a) -> String / e) -> List<Listed> / {abort.raise | e} = table.map(|c: a| { label: label(c), identity: b\"\" })\n",
      b"pub fn chosen<a>(table: List<a>, at: Int, wanted: Bytes) -> a / {abort.raise} = match table.at(at) { Some(c) -> c, None -> panic(\"no case\") }\n",
    ]),
  };
  let dump = dump_of(analyse_pulling_std_with(user, [cases], no_rows()).out);
  let offers = requested_roots(dump);
  assert_eq(offers.unkeyed, []);
  assert_eq(offers.keys.map(printed), dump.emitter_roots.map(|r: EmitterRoot| r.root));
  assert_eq(offers.keys.filter(|k: RootKey| module_of(k) == b"m"), [
    Named(b"m.f"),
    Named(b"m.none"),
    test_key(b"m", b"t"),
    Clause({ definition: Named(b"m.f"), kind: Requires, n: 0 }),
    Clause({ definition: Named(b"m.f"), kind: Ensures, n: 0 }),
    Clause({ definition: Named(b"m.none"), kind: Ensures, n: 0 }),
    TestCases(test_key(b"m", b"t")),
    law_key(b"m", b"l", LawGuard),
    law_key(b"m", b"l", LawBody),
    law_key(b"m", b"s", LawBody),
  ]);
  let p = program_of(dump, sources_in_order(dump, user.concat([cases])), offers.keys);
  let mine = offers.keys.filter(|k: RootKey| module_of(k) == b"m");
  assert_eq(
    mine.filter(|k: RootKey| runtime_enters(p, k)),
    mine.filter(|k: RootKey| k != law_key(b"m", b"s", LawBody)),
  )
}

test "a constant that may raise keeps its entry, which the unit's code table names, past the word it is handed for the raise" {
  let user = [
    {
      name: b"m",
      src: Bytes::concat_all([
        b"pub fn limit() -> Int / {abort.raise} = if 2 > 3 { abort.raise(\"never\") } else { 7 }\n",
        b"pub fn twice() -> Int / {abort.raise} = limit() + limit()\n",
      ]),
    },
  ];
  let dump = dump_of(analyse(parse_all(user)));
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_in_order(dump, user),
      Map::new(),
      requested_roots(dump).keys,
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(e) -> {
      let text = unit_text(e.produced.parts);
      let said = Some(String::of_bytes_lossy(text));
      assert(
        text.index_of(Bytes::concat_all([b"(void *)&", entry_symbol(b"m.limit"), b",\n"])) != None,
        said,
      );
      assert(text.index_of(b"(void *)&,") == None && text.index_of(b"extern char ;") == None, said)
    },
  }
}

