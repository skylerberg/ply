test "a host handler waits on a ticket for each operation whose clause performs the wait, a helper's too" {
  let user = [
    {
      name: b"m",
      src: b"import std.fact (fact)\npub fn asked() -> Int / {fact.slow, fact.fast, fact.behind} = fact.slow() + fact.fast() + fact.behind()\n",
    },
  ];
  let fact = {
    name: b"std.fact",
    src: Bytes::concat_all([
      b"import std.internal.native (native, wait, job_wait)\n",
      b"pub effect fact {\n  read slow() -> Int\n  read fast() -> Int\n  read behind() -> Int\n}\n",
      b"host for fact by served\n",
      b"fn waited() -> Int / {native.read, wait.read} = job_wait(1).len()\n",
      b"fn served<a | e>(go: () -> a / {fact.slow, fact.fast, fact.behind | e}) -> a / {native.read, wait.read | e} =\n",
      b"  handle { go() } with { fact.slow() -> job_wait(0).len(), fact.fast() -> 1, fact.behind() -> waited() }\n",
    ]),
  };
  let native = {
    name: b"std.internal.native",
    src: b"pub nondet effect native {}\npub nondet effect wait {}\npub extern fn job_wait(ticket: Int) -> Bytes / {native.read, wait.read}\n",
  };
  let dump = dump_of(analyse_pulling_std_with(user, [fact, native], no_rows()).out);
  assert_eq(
    dump.diagnostics.filter(|d: Diagnostic| d.severity == b"error").map(|d: Diagnostic| d.message),
    [],
  );
  assert_eq(
    dump.effects.filter(|r: EffectRow| r.name == b"std.fact.fact").map(|r: EffectRow| r.waits),
    [[b"slow", b"behind"]],
  )
}

test "a test's entry runs under the host handler of each effect it performs, a labelled one included" {
  let user = [
    {
      name: b"m",
