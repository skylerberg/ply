test "a generic definition's entry is taken, its call settled where the entry judges it" {
  let user = [
    {
      name: b"m",
      src: Bytes::concat_all([
        b"pub fn first<a>(xs: List<a>) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }\n",
        b"pub fn made<a>(make: () -> a) -> a = make()\n",
        b"pub fn total<a>(xs: List<a>) -> a where numeric(a) = xs.fold(numeric_of_int(0), |s: a, x: a| s + x)\n",
        b"pub fn counted<a>(xs: Columns<a>) -> Int = xs.len()\n",
      ]),
    },
  ];
  let dump = dump_of(analyse(parse_all(user)));
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_placed(dump, user),
      Map::new(),
      offered_roots(dump).keys,
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(e) -> {
      let entry = |n: Bytes| root_name(Entered(Named(n)));
      // A function crosses only out, a witnessed variable has no specialisation at `Int`, and a
      // `Columns` at `Int` would hold no records.
      assert_eq(
        [b"m.first", b"m.made", b"m.total", b"m.counted"].filter(|n: Bytes|
          e.produced.taken.contains(entry(n))),
        [b"m.first"],
      )
    },
  }
}

/// The C function `symbol` names in unit text `text`, from its head to the brace that ends it;
/// empty where the unit defines none.
fn defined_in(text: Bytes, symbol: Bytes) -> Bytes / {abort.raise} =
  match text.index_of(symbol.concat(b"(PlyCtx *ctx")) {
    Some(i) -> {
      let rest = text.slice(i, text.len());
      match rest.index_of(b"\n}\n") { Some(j) -> rest.slice(0, j), None -> rest }
    },
    None -> b"",
  }

/// Root `key`'s C in unit text `text` where it performs, and never through the bridge: what it
/// performs reaches the real handler's object through the words its entry hands it. Empty where it
/// does.
fn bridged_in(text: Bytes, key: RootKey) -> Bytes / {abort.raise} = {
  let own = defined_in(text, symbol_of(root_text(root_name(key))));
  if own.index_of(b"ply_perform(") != None && own.index_of(b"ctx->bridge") == None { b"" }
  else { own.concat(b"\n") }
}

test "an entry runs under the real handler of each effect its root's row names, which the unit takes" {
  let user = [
    {
      name: b"m",
      src: b"import std.fact (fact)\npub fn asked() -> Int / {fact.get} = fact.get()\npub fn plain() -> Int = 1\npub fn shifted(n: Int, s: String) -> Int / {fact.get} = fact.get() + n + s.len()\n",
    },
  ];
  let fact = {
    name: b"std.fact",
    src: b"pub effect fact {\n  read get() -> Int\n}\nhost for fact by served\nfn served<a | e>(go: () -> a / {fact.get | e}) -> a / e = handle { go() } with { fact.get() -> 7 }\n",
  };
  let dump = dump_of(analyse_pulling_std_with(user, [fact], no_rows()).out);
  assert_eq(
    dump.effects.filter(|r: EffectRow| r.name == b"std.fact.fact").map(|r: EffectRow| r.host),
    [Some(b"std.fact.served")],
  );
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_placed(dump, user.concat([fact])),
      Map::new(),
      offered_roots(dump).keys,
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(e) -> {
      // A root that takes arguments hands the handler a closure over them.
      let entries = [b"m.asked", b"m.plain", b"m.shifted"].map(|n: Bytes|
        root_name(Entered(Named(n))));
      assert(entries.all(|n: RootName| e.produced.taken.contains(n)), None);
      assert_eq(
        [Named(b"m.asked"), Named(b"m.shifted")].map(|k: RootKey| bridged_in(e.produced.text, k)),
        [b"", b""],
      );
      // Taken at what the entry answers, as any generic function its callers settle.
      assert(
        e.produced.taken.any(|n: RootName|
          root_text(n).starts_with(b"std.fact.served") && root_text(n) != b"std.fact.served"),
        None,
      )
    },
  }
}

test "an entry of a root that performs `task` runs it under the run's region, `task`'s real handler, and one that performs `clock` too under `clock`'s" {
  let user = [
    {
      name: b"m",
      src: Bytes::concat_all([
        b"pub fn yielded() -> Int / {task.write} = {\n  task.yield();\n  1\n}\npub fn plain() -> Int = 1\n",
        b"pub fn timed() -> Int / {task.write, clock.read} = {\n  task.yield();\n  match clock.now() { Instant(n) -> n }\n}\n",
      ]),
    },
  ];
  let clauses = [
    b"spawn(f)",
    b"join(t)",
    b"await(t)",
    b"cancel(t)",
    b"yield()",
    b"channel(n)",
    b"send(c, x)",
    b"recv(c)",
    b"close(c)",
    b"select(arms, wait)",
  ];
  let scheduler = {
    name: b"std.internal.schedule",
    src: Bytes::concat_all([
      b"pub fn scheduled<a | e>(body: keep () -> a / {task.write | e}) -> a / {abort.raise | e} =\n",
      b"  handle { body() } with {\n",
      Bytes::concat_all(
        clauses.map(|c: Bytes|
          Bytes::concat_all([b"    task.", c, b" -> abort.raise(\"none\"),\n"])),
      ),
      b"  }\n",
      b"pub fn clocked<a | e>(go: () -> a / {clock.read, clock.write | e}) -> a / e =\n",
      b"  handle { go() } with {\n    clock.now() -> Instant(0),\n    clock.sleep(_d) -> (),\n  }\n",
    ]),
  };
  let dump = dump_of(analyse_pulling_std_with(user, [scheduler], no_rows()).out);
  assert_eq(dump.diags.filter(|d: Diag| d.severity == b"error").map(|d: Diag| d.message), []);
  assert_eq(dump.effects.filter(|r: EffectRow| r.name == b"task").map(|r: EffectRow| r.host), [
    Some(b"std.internal.schedule.scheduled"),
  ]);
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_placed(dump, user.concat([scheduler])),
      Map::new(),
      offered_roots(dump).keys,
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(e) -> {
      let entry = |n: Bytes| root_name(Entered(Named(n)));
      // Taken at what the entry answers, as any generic function its callers settle.
      assert(
        e.produced.taken.any(|n: RootName|
          root_text(n).starts_with(b"std.internal.schedule.scheduled")
            && root_text(n) != b"std.internal.schedule.scheduled"),
        None,
      )
    },
  }
}

test "an entry hands its root, for each effect nothing of the program answers, the object the runtime answers it by" {
  let user = [
    {
      name: b"m",
      src: Bytes::concat_all([
        b"import std.time (time)\n",
        b"effect ask {\n  read get() -> Int\n}\n",
        b"pub fn main() -> Int / {ask.read, time.read, clock.read, abort.raise} = {\n",
        b"  let n = ask.get() + time.now() + match clock.now() { Instant(at) -> at };\n",
        b"  if n < 0 { panic(\"negative\") } else { n }\n",
        b"}\n",
      ]),
    },
  ];
  let time = { name: b"std.time", src: b"pub nondet effect time {\n  read now() -> Int\n}\n" };
  let dump = dump_of(analyse_pulling_std_with(user, [time], no_rows()).out);
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_placed(dump, user.concat([time])),
      Map::new(),
      offered_roots(dump).keys,
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(e) -> {
      let entry = defined_in(
        e.produced.text,
        symbol_of(root_text(root_name(Entered(Named(b"m.main"))))),
      );
      let held = |object: Bytes| entry.split(object).len() - 1;
      // `ask`, `abort` and a `time` no real handler serves share the refusal; `clock`, whose real
      // handler this load holds no scheduler for, is the bridge's.
      assert_eq([b"ctx->unserved", b"ctx->bridge"].map(held), [1, 1])
    },
  }
}

