}

test "a real handler waits on a ticket for each operation whose clause performs the wait, a helper's too" {
  let user = [
    {
      name: b"m",
      src: b"import std.fact (fact)\npub fn asked() -> Int / {fact.slow, fact.fast, fact.behind} = fact.slow() + fact.fast() + fact.behind()\n",
    },
  ];
  let fact = {
    name: b"std.fact",
    src: Bytes::concat_all([
      b"import std.internal.native (native, wait, job_wait)\n",
      b"pub effect fact {\n  read slow() -> Int\n  read fast() -> Int\n  read behind() -> Int\n}\n",
      b"host for fact by served\n",
      b"fn waited() -> Int / {native.read, wait.read} = job_wait(1).len()\n",
      b"fn served<a | e>(go: () -> a / {fact.slow, fact.fast, fact.behind | e}) -> a / {native.read, wait.read | e} =\n",
      b"  handle { go() } with { fact.slow() -> job_wait(0).len(), fact.fast() -> 1, fact.behind() -> waited() }\n",
    ]),
  };
  let native = {
    name: b"std.internal.native",
    src: b"pub nondet effect native {}\npub nondet effect wait {}\npub extern fn job_wait(ticket: Int) -> Bytes / {native.read, wait.read}\n",
  };
  let dump = dump_of(analyse_pulling_std_with(user, [fact, native], no_rows()).out);
  assert_eq(dump.diags.filter(|d: Diag| d.severity == b"error").map(|d: Diag| d.message), []);
  assert_eq(
    dump.effects.filter(|r: EffectRow| r.name == b"std.fact.fact").map(|r: EffectRow| r.waits),
    [[b"slow", b"behind"]],
  )
}

test "a test's entry runs under the real handler of each effect it performs, a labelled one included" {
  let user = [
    {
      name: b"m",
      src: b"import std.fact (fact)\ntest \"asks\" {\n  fact.put[cell](1);\n  assert(fact.get() == 7)\n}\n",
    },
  ];
  let fact = {
    name: b"std.fact",
    src: b"pub effect fact {\n  read get() -> Int\n  write put[r](x: Int) -> Unit\n}\nhost for fact by served\nfn served<a | e>(go: () -> a / {fact.get, fact.put[*] | e}) -> a / e = handle { go() } with { fact.get() -> 7, fact.put[*](x) -> () }\n",
  };
  let dump = dump_of(analyse_pulling_std_with(user, [fact], no_rows()).out);
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_placed(dump, user.concat([fact])),
      Map::new(),
      offered_roots(dump).keys,
      |_: Bytes| None,
      |_: List<Record>| (),
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(e) -> {
      // Nothing but the test's entry performs `fact`, so only it takes the handler.
      assert(
        e.produced.taken.any(|n: RootName| root_text(n).starts_with(b"std.fact.served")),
        Some(String::of_bytes_lossy(Bytes::join(e.produced.taken.map(root_text), b", "))),
      );
      assert_eq(bridged_in(e.produced.text, test_key(b"m", b"asks")), b"")
    },
  }
}

test "a clause over a function its definition answers has no entry, as a function crosses only out" {
  let user = [
    {
      name: b"m",
      src: b"pub fn adder(n: Int) -> (Int) -> Int ensures result(1) == n + 1 = |x: Int| x + n\n",
    },
  ];
  let dump = dump_of(analyse(parse_all(user)));
  let p = program_of(dump, sources_placed(dump, user), offered_roots(dump).keys);
  assert(entered_root(p, Named(b"m.adder")), None);
  assert(!entered_root(p, Clause({ def: Named(b"m.adder"), kind: Ensures, n: 0 })), None)
}

test "a root the front end offers with no typed row to key it by is Ply's own failure" {
  let user = [{ name: b"m", src: b"fn one() -> Int = 1\nfn two() -> Int = one() + 1\n" }];
  let whole = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  let dump = { ..whole, defs: whole.defs.filter(|d: DefRow| d.name != b"m.one") };
  let offers = offered_roots(dump);
  assert_eq(offers.unkeyed, [b"m.one"]);
  let runtime = { ..a_runtime(b"r"), natives: declared_natives().map(declared_signature) };
  let made = |offered: List<RootKey>|
    emitted(
      runtime,
      dump,
      sources_placed(dump, user),
      Map::new(),
      offered,
      |_: Bytes| None,
      |_: List<Record>| (),
    );
  // A unit of every root offered, and a unit of none, each say so.
  [offers.keys, []].fold((), |_: Unit, offered: List<RootKey>| {
    let said = first_said(made(offered), dump);
    assert_eq(said.at(0), Some(b"E0505"));
    assert(
      said.any(|n: Bytes| n.index_of(b"offered `m.one` with no typed row") != None),
      Some(String::of_bytes_lossy(Bytes::join(said, b"\n"))),
    )
  })
}

test "a unit tells each place it walks to a build's phases as it ends, in the places' order" {
  let user = [{ name: b"m", src: b"fn one() -> Int = 1\nfn two() -> Int = one() + 1\n" }];
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  kept_bodies(|| {
    // Each place is kept under its number, as a byte for each root it asked the emitter for, and the
    // places in the order they were told.
    let told = |r: PlaceTally|
      body_store.put([
        {
          key: ascii_of_int(r.place),
          bytes: Bytes::concat_all(range(0, r.asked).map(|_: Int| b"x")),
        },
        {
          key: b"told",
          bytes: (match body_store.get(b"told") { Some(b) -> b, None -> b"" }).concat(
            Bytes::concat_all([ascii_of_int(r.place), b","]),
          ),
        },
      ]);
    match emitted(
        a_runtime(b"r"),
        dump,
        sources_placed(dump, user),
        Map::new(),
        [Named(b"m.one"), Named(b"m.two")],
        |_: Bytes| None,
        |_: List<Record>| (),
        phases: Some({ now: || 0, told: told }),
      ) {
      Err(why) -> panic(String::of_bytes_lossy(why)),
      Ok(e) -> {
        let said = match body_store.get(b"told") { Some(b) -> b.split(b","), None -> [] };
        let order = said.filter(|p: Bytes| p.len() > 0).map(|p: Bytes| digits(p));
        assert(
          order.len() > 0 && range(1, order.len()).all(|i: Int| order.get(i - 1) < order.get(i)),
          None,
        );
        assert_eq(
          order.fold(0, |n: Int, l: Int|
            n + (match body_store.get(ascii_of_int(l)) { Some(v) -> v.len(), None -> 0 })),
          e.asked,
        )
      },
    }
  })
}

test "a unit is refused where the runtime does not implement a native it calls as declared, and not for one it never calls" {
  let program = [
    {
      name: b"m",
      src: b"fn at(b: Bytes, i: Int) -> Int / {abort.raise} = b.at(i)\nfn plus<a>(x: a, y: a) -> a where numeric(a) = x + y\n",
    },
  ];
  let implemented = declared_natives().map(declared_signature);
  let taking = |name: Bytes, words: Int|
    implemented.map(|n: Native|
      if n.name == name { uniform_native(name, words, n.answer != None, n.raises) } else { n });
  // `Bytes::at` past the end raises through the compiler's `?refused`.
  assert_eq(
    match held_over(program, [], implemented) {
      Ok(c) -> c.index_of(b"builtin_elaborated_refused_p(ctx") != None,
      Err(_) -> false,
    },
    true,
  );
  assert_eq(refusal(held_over(program, [], implemented)), []);
  // None of these is called, so a runtime that lacks one or takes another otherwise is no matter.
  assert_eq(
    refusal(
      held_over(
        program,
        [],
        taking(b"Secret::verify", 9).filter(|n: Native| n.name != b"Secret::is_empty"),
      ),
    ),
    [],
  );
  assert_eq(refusal(held_over(program, [], taking(b"?numeric_binary", 5))), []);
  assert_eq(refusal(held_over(program, [], taking(b"Map::new", 3))), []);
  let refused = refusal(held_over(program, [], taking(b"?refused", 3)));
  assert_eq(refused.at(0), Some(b"E0476"));
  assert_eq(
    refused.at(1),
    Some(
      b"the compiler's `?refused` takes [I64, I64, I64, I64], answers nothing and raises, and the runtime's native takes [Word, Word, Word], answers nothing and raises",
    ),
  );
  let twice = implemented.concat(implemented.filter(|n: Native| n.name == b"?refused"));
  assert_eq(
    refusal(held_over(program, [], twice)).at(1),
    Some(b"the compiler's `?refused`: 2 natives of the runtime implement it"),
  )
}

test "a unit whose bodies write externs in place asks the runtime for no native of them" {
  // What the prelude declares that a native implements: its builtins, and `ListNode::leaf_of`.
  let implemented = program_natives([]).map(declared_signature);
  let names = implemented.map(|n: Native| n.name);
  assert_eq(
    intrinsics().filter(|i: { name: Bytes, op: Intrinsic }|
      names.contains(i.name.slice(b"std.prelude.".len(), i.name.len()))).len(
    ),
    0,
  );
  let calls = b"\npub fn pushed(xs: List<Int>) -> List<Int> = ListNode::tail_push(xs, 1)\npub fn emptied(m: Map<Int, Int>) -> Map<Int, Int> = MapNode::map_swap(m, None, 0, 0).map\n";
  let program = [{ name: b"std.prelude", src: prelude_source::text().concat(calls) }];
  match held_over(program, [], implemented) {
    Ok(c) -> {
      // Each write is the emitted code's own, a block another holds copied by its type's root: the
      // runtime is asked for no extern's helper.
      let asked = intrinsics().map(|i: { name: Bytes, op: Intrinsic }|
        builtin_helper(i.name.slice(b"std.prelude.".len(), i.name.len())).concat(b"_p(ctx, "));
      assert_eq(asked.filter(|t: Bytes| c.index_of(t) != None), [])
    },
    Err(diags) -> assert_eq(diags.map(|d: Diag| d.code), []),
  }
}

test "a unit is refused where its runtime binds a helper or lays out what its code reads otherwise than the compiler declares" {
  let user = [{ name: b"m", src: b"fn one() -> Int = 1\n" }];
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  let every = offered_roots(dump).keys;
  let over = |runtime: Runtime|
    refusal(
      held(
        dump,
        emitted(
          runtime,
          dump,
          sources_placed(dump, user),
          Map::new(),
          every,
          |_: Bytes| None,
          |_: List<Record>| (),
        ),
      ),
    );
  let r = a_runtime(b"r");
  assert_eq(over(r), []);
  let moved = { ..r, facts: r.facts.insert(b"PlyCtx.frames.at", 72) };
  let refused = over({
    ..moved,
    helpers: moved.helpers.filter(|n: Native| n.name != b"rt_no_match"),
  });
  assert_eq(refused, [
    b"E0481",
    b"the runtime has no helper `rt_no_match`, which emitted code calls",
    b"the runtime lays out `PlyCtx.frames.at` as 72, where this compiler declares 64",
    runtime_refused([]).notes_text.get(0),
  ]);
  // Before the natives: a runtime that serves the code no compiler of this form emits is refused so.
  assert_eq(over({ ..moved, natives: [] }).at(0), Some(b"E0481"))
}

fn identifier_bytes() -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(48, 58).concat(range(65, 91)).push(95).concat(range(97, 123)).map(byte_of_int),
  )

/// `into` with each function `text` calls through a pointer whose name opens with `prefix`: an
/// identifier `<prefix>…_p`, by its name less the `_p`.
fn pointers_named(
  text: Bytes,
  prefix: Bytes,
  into: Map<Bytes, Bool>,
) -> Map<Bytes, Bool> / {abort.raise} =
  iterate({ from: 0, found: into }, text.len() + 1, |s: { from: Int, found: Map<Bytes, Bool> }|
    match text.index_of_from(prefix, s.from) {
      None -> Stop(s.found),
      Some(at) -> {
        let end = text.scan(at, identifier_bytes(), text.len() - at);
        let name = text.slice(at, end);
        let opens = at == 0 || identifier_bytes().index_of_byte(text.at(at - 1)) == None;
        Continue({
          from: end,
          found: if opens && name.ends_with(b"_p") {
            s.found.insert(name.slice(0, name.len() - 2), true)
          } else { s.found },
        })
      },
    })

/// A unit over roots that call natives through pointers, hand a type's stated arithmetic by a
/// constructor's tag, land a raise left pending by its operation's names in the field table, read a
/// constant through the code table, and call a definition that calls itself at two lenders' lambdas.
fn pointing_unit() -> Emission / {abort.raise} =
  kept_unit(
    Bytes::concat_all([
      b"effect e {\n  write op(k: Int) -> Int\n}\n",
      b"effect oops {\n  raise boom(n: Int)\n}\n",
      b"fn bang(n: Int) -> Int / {oops.boom} = if n > 0 { oops.boom(n) } else { n }\n",
      b"fn caught(n: Int) -> Int = handle { bang(n) } with { oops.boom(k) -> k + 1 }\n",
      b"type Shape = | Dot | Line(Int)\n",
      b"fn handled() -> Int = handle { e.op(1) } with { var n = 0, e.op(k) -> { n = k; n }, return x -> x + n }\n",
      b"fn decimals(d: Decimal) -> Decimal = d * d + d\n",
      b"fn floats(x: Float) -> Float = x.sqrt()\n",
      b"fn texts(s: String) -> Int = (s ++ s).len()\n",
      b"fn listed(xs: List<Int>) -> List<Int> = xs.map(|x: Int| x + 1)\n",
      b"fn shaped(n: Int) -> Shape = if n > 0 { Line(n) } else { Dot }\n",
      b"fn width(s: Shape) -> Int = match s { Line(n) -> n, Dot -> 0 }\n",
      b"fn table() -> List<Int> = [1, 2]\n",
      b"fn read() -> Int = table().len()\n",
      b"fn sum(f: (Int) -> Int, n: Int) -> Int = if n <= 0 { 0 } else { f(n) + sum(f, n - 1) }\n",
      b"fn one() -> Int = sum(|x: Int| x, 3)\n",
      b"fn two() -> Int = sum(|x: Int| x, 4)\n",
      b"type Length = | Metres(Int) | Millimetres(Int)\n",
      b"key for Length by millimetres\n",
      b"numeric for Length by { add: plus, sub: minus, mul: times, neg: negated, of_int: metres }\n",
      b"fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }\n",
      b"fn plus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) + millimetres(b))\n",
      b"fn minus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) - millimetres(b))\n",
      b"fn times(a: Length, b: Length) -> Length = Millimetres(millimetres(a) * millimetres(b))\n",
      b"fn negated(a: Length) -> Length = Millimetres(0 - millimetres(a))\n",
      b"fn metres(n: Int) -> Length = Metres(n)\n",
      b"fn total<a>(xs: List<a>) -> a where numeric(a) = xs.fold(numeric_of_int(0), |s: a, x: a| s + x)\n",
      b"fn all(xs: List<Length>) -> Length = total(xs)\n",
    ]),
  ).unit(
    [
      b"m.handled",
      b"m.caught",
      b"m.decimals",
      b"m.floats",
      b"m.texts",
      b"m.listed",
      b"m.shaped",
      b"m.width",
      b"m.read",
      b"m.one",
      b"m.two",
      b"m.all",
    ].map(
      Named,
    ),
  )

test "the natives a body reports are the ones its C calls through a pointer" {
  let bodies = pointing_unit().produced.made.bodies;
  let scanned = |k: UnitBody|
    k.tables.shared.fold(
      pointers_named(k.text, b"builtin_", Map::new()),
      |m: Map<Bytes, Bool>, f: SharedFn| pointers_named(f.text, b"builtin_", m),
    ).keys(
    );
  assert_eq(
    bodies.filter(|k: UnitBody| ordered(k.tables.natives) != scanned(k)).map(|k: UnitBody|
      root_text(k.name)),
    [],
  );
  assert(bodies.any(|k: UnitBody| k.tables.natives.len() > 0), None)
}

test "the holes a body reports are the ones its C holds that its part's table places" {
  let bodies = pointing_unit().produced.made.bodies;
  let scanned = |k: UnitBody|
    ordered(
      holes(k.text).filter(|h: Hole| h.kind != 114 && h.kind != 115).map(|h: Hole|
        keyed_key(keyed_of(h), k.tables)),
    );
  let reported = |k: UnitBody| ordered(k.tables.keyed.map(|x: Keyed| keyed_key(x, k.tables)));
  assert_eq(
    bodies.filter(|k: UnitBody| reported(k) != scanned(k)).map(|k: UnitBody| root_text(k.name)),
    [],
  );
  // Among them a tag, a field and a constant's entry.
  let all = bodies.fold([], |acc: List<Bytes>, k: UnitBody| acc.concat(reported(k)));
  assert_eq([84, 102, 108].filter(|kind: Int| !all.any(|key: Bytes| key.at(0) == kind)), [])
}

test "a part reads as it would were each root its bodies define written as its symbol" {
  let made = pointing_unit().produced.made;
  let ctors = ordered(
    made.bodies.fold([], |acc: List<Bytes>, k: UnitBody|
      k.tables.keyed.fold(acc, |a: List<Bytes>, x: Keyed|
        match x { KeyedTag(n) -> a.push(n), _ -> a })),
  ).map(|n: Bytes| { name: n, arity: 0 });
  let unit = |texts: List<Bytes>|
    produce(
      ctors,
      made.offered,
      1,
      answers_of(
        range(0, made.bodies.len()).map(|i: Int| {
          let k = made.bodies.get(i);
          { name: k.name, answer: { text: texts.get(i), tables: k.tables } }
        }),
      ),
      Map::new(),
      no_machine,
      one_each(),
    ).text;
  let symbol = |n: RootName| symbol_of(root_text(n));
  let spelled_out = |k: UnitBody| {
    let members = k.tables.members.map(root_name);
    Bytes::join(
      range(0, members.len()).fold(k.text, |t: Bytes, i: Int|
        Bytes::join(t.split(own_symbol(Some(i))), symbol(members.get(i)))).split(
        own_symbol(None),
      ),
      symbol(own_root(k)),
    )
  };
  let written = unit(made.bodies.map(|k: UnitBody| k.text));
  assert(made.bodies.any(|k: UnitBody| k.text.index_of(own_symbol(None)) != None), None);
  assert_eq(written.index_of(b"@@"), None);
  assert_eq(written, unit(made.bodies.map(spelled_out)))
}

test "specialisations whose bodies differ only in their names, each calling itself, compile as one code" {
  let source = Bytes::concat_all([
    b"fn sum(f: (Int) -> Int, n: Int) -> Int = if n <= 0 { 0 } else { f(n) + sum(f, n - 1) }\n",
    b"fn one() -> Int = sum(|x: Int| x, 3)\n",
    b"fn two() -> Int = sum(|x: Int| x, 4)\n",
  ]);
  match built([{ name: b"m", src: source }]) {
    Err(why) -> assert_eq(why, b""),
    Ok(e) -> {
      let specialisations = e.roots.filter(|k: RootKey|
        match k { At(a, _) -> a.def == b"m.sum", _ -> false });
      let codes = e.produced.taken.filter(|n: RootName| root_text(n).starts_with(b"m.sum@="));
      assert_eq([specialisations.len(), codes.len()], [2, 1]);
      assert_eq(
        specialisations.filter(|k: RootKey|
          e.produced.text.index_of(symbol_of(printed(k))) != None),
        [],
      )
    },
  }
}

test "every function a unit's C calls through a pointer is one the unit binds" {
  let k = kept_unit(
    Bytes::concat_all([
      b"effect e {\n  write op(k: Int) -> Int\n}\n",
      b"fn handled() -> Int = handle { e.op(1) } with { var n = 0, e.op(k) -> { n = k; n }, return x -> x + n }\n",
      b"fn decimals(d: Decimal) -> Decimal = d * d + d\n",
      b"fn wides(w: U128) -> U128 = w * w\n",
      b"fn floats(x: Float) -> Float = x.sqrt()\n",
      b"fn texts(s: String) -> Int = (s ++ s).len()\n",
      b"fn listed(xs: List<Int>) -> List<Int> = xs.map(|x: Int| x + 1)\n",
    ]),
  );
  let roots = [b"m.handled", b"m.decimals", b"m.wides", b"m.floats", b"m.texts", b"m.listed"];
  let text = k.unit(roots.map(Named)).produced.text;
  let declared = bound().fold(Map::new(), |acc: Map<Bytes, Bool>, n: Native|
    acc.insert(n.name, true));
  let named = pointers_named(text, b"rt_", pointers_named(text, b"builtin_", Map::new()));
  assert_eq(named.keys().filter(|n: Bytes| !declared.contains(n)), []);
  assert(named.contains(b"rt_alloc_bytes") && named.contains(b"builtin_elaborated_out_int"), None)
}

test "a unit is refused where the runtime implements a shipped module's `extern fn` it calls otherwise" {
  let native = [
    {
      name: b"std.native",
      src: b"pub extern fn counted(x: Int) -> Int\npub extern fn named(id: Int) -> String\n",
    },
  ];
  let program = [
    {
      name: b"m",
      src: b"import std.native (counted, named)\nfn f() -> Int = counted(1)\nfn g() -> String = named(7)\n",
    },
  ];
  let counted = |params: List<Machine>|
    { name: b"counted", params: params, answer: Some(abi::I64), raises: false };
  let named = |answer: Machine|
    { name: b"named", params: [abi::I64], answer: Some(answer), raises: false };
  let implemented = |a: Native, b: Native|
    declared_natives().map(declared_signature).push(a).push(b);
  assert_eq(
    refusal(held_over(program, native, implemented(counted([abi::I64]), named(abi::Taken)))),
    [],
  );
  assert_eq(
    refusal(
      held_over(program, native, implemented(counted([abi::I64, abi::I64]), named(abi::Taken))),
    ),
    [
      b"E0476",
      b"`extern fn counted` of `std.native` takes [I64], answers I64 and cannot raise, and the runtime's native takes [I64, I64], answers I64 and cannot raise",
      natives_refused([]).notes_text.get(0),
    ],
  );
  // A native binds the kinds its call passes: bytes are told from an integer by theirs.
  assert_eq(
    refusal(held_over(program, native, implemented(counted([abi::I64]), named(abi::I64)))),
    [
      b"E0476",
      b"`extern fn named` of `std.native` takes [I64], answers Taken and cannot raise, and the runtime's native takes [I64], answers I64 and cannot raise",
      natives_refused([]).notes_text.get(0),
    ],
  )
}

test "a unit declares a shipped module's native over machine words where a part calls it, and binds it after the rest" {
  let native = [
    {
      name: b"std.native",
      src: b"pub extern fn named(id: Int, sep: String) -> String\npub extern fn told(on: Bool, x: Float, c: Char, w: U8) -> Char\npub extern fn noted(b: Bytes) -> Unit\n",
    },
  ];
  let program = [
    {
      name: b"m",
      src: b"import std.native (named, told, noted)\nfn g() -> String = named(7, \"-\")\nfn h() -> Char = told(true, 1.5, 'a', 3u8)\nfn k() -> Unit = noted(b\"x\")\n",
    },
  ];
  let named = {
    name: b"named",
    params: [abi::I64, abi::Addr, abi::I64],
    answer: Some(abi::Taken),
    raises: false,
  };
  let told = {
    name: b"told",
    params: [abi::I64, abi::F64, abi::I64, abi::I64],
    answer: Some(abi::I64),
    raises: false,
  };
  let noted = { name: b"noted", params: [abi::Addr, abi::I64], answer: None, raises: false };
  match held_over(
      program,
      native,
      declared_natives().map(declared_signature).push(named).push(told).push(noted),
    ) {
    Err(diags) -> assert_eq(diags.map(|d: Diag| d.code), []),
    Ok(text) -> {
      let pointer = b"Word (*builtin_named_p)(PlyCtx*, Word, Word, Word)";
      // Called with the string's address and count, its answer the count of the bytes it left.
      assert(text.index_of(b"builtin_named_p(ctx, ") != None, None);
      assert_eq(text.split(b"extern ".concat(pointer)).len(), 2);
      assert(text.index_of(pointer.concat(b";\n")) != None, None);
      assert(
        text.index_of(
            Bytes::concat_all([
              b"builtin_named_p = (Word (*)(PlyCtx*, Word, Word, Word))fns[",
              ascii_of_int(bound().len()),
              b"]",
            ]),
          )
          != None,
        None,
      );
      assert(text.index_of(b"builtin_named 3 1") != None, None);
      // Each scalar is one raw word, and a native answering `()` is `void`.
      assert(
        text.index_of(b"extern Word (*builtin_told_p)(PlyCtx*, Word, Word, Word, Word);\n") != None,
        None,
      );
      assert(
        text.index_of(b"extern void (*builtin_noted_p)(PlyCtx*, Word, Word);\n") != None,
        None,
      );
      assert(text.index_of(b"builtin_noted 2 0") != None, None)
    },
  }
}

test "a function of a type a module calls with no import is read from its home, which the emitter is handed" {
  let user = [{ name: b"m", src: b"fn first(xs: List<Int>) -> Int / {abort.raise} = xs.get(0)\n" }];
  let shipped = [
    {
      name: b"std.list",
      src: b"pub fn List::get<a>(xs: List<a>, i: Int) -> a / {abort.raise} = match xs.at(i) { Some(x) -> x, None -> panic(\"no element there\") }\n",
    },
  ];
  let dump = dump_of(analyse_pulling_std_with(user, shipped, no_rows()).out);
  let root = Named(b"m.first");
  let p = program_of(dump, sources_placed(dump, user.concat(shipped)), [root]);
  // Placed past its home, the module is answered with the home's handings.
  let places = places_of(p);
  assert(
    match ((places.get(b"m"), places.get(b"std.list"))) { (Some(a), Some(b)) -> a > b, _ -> false },
    None,
  );
  // The home is among what a scope answering the module's root holds.
  let modules = modules_asked(p, [root]);
  assert(modules.contains(b"std.list"), None);
  assert_eq(
    emit::answered(scope_over(dump, p, [], [root], modules), [root], Map::new()).map(
      |r: RootAnswer| root_text(r.name),
    ),
    [b"m.first"],
  )
}

test "a law's body over a sort it leaves uninterpreted is lowered as a generic body as it stands" {
  let user = [
    {
      name: b"m",
      src: b"fn pair<a>(x: a) -> a = x\n\nlaw \"identity is identity\"\n  forall (x: a) {\n    pair(x) == x\n  }\n",
    },
  ];
  let dump = dump_of(analyse(parse_all(user)));
  let root = law_key(b"m", b"identity is identity", LawBody);
  let p = program_of(dump, sources_placed(dump, user), [root]);
  assert_eq(
    emit::answered(
      scope_over(dump, p, [], [root], modules_asked(p, [root])),
      [root],
      Map::new(),
    ).map(|r: RootAnswer| root_text(r.name)),
    [printed(root)],
  )
}

test "a unit asks the emitter for a root a kept body names, though the body's definition has moved" {
  let lending = b"fn each(n: Int, f: (Int) -> Int, i: Int, acc: Int) -> Int = if i >= n { acc } else { each(n, f, i + 1, acc + f(i)) }\nfn total(n: Int, f: (Int) -> Int) -> Int = each(n, f, 0, 0)\nfn scaled(n: Int, k: Int) -> Int = total(n, |x: Int| x * k)\n";
  let runtime = a_runtime(b"r");
  kept_bodies(|| {
    let unit = |source: Bytes|
      match emitted(
          runtime,
          dump_of(analyse(parse_all([{ name: b"m", src: source }]))),
          [source],
          Map::new(),
          [b"m.each", b"m.total", b"m.scaled"].map(Named),
          |k: Bytes| body_store.get(k),
          |rs: List<Record>| body_store.put(rs),
        ) {
        Ok(e) -> e,
        Err(why) -> panic(String::of_bytes_lossy(why)),
      };
    assert_eq(unit(lending).kept, 0);
    // What the next run starts from: the body of `scaled`, and of no root it names, beside the keys
    // of the roots it calls.
    let answer = |k: Bytes| !k.starts_with(key_key(b""));
    // An answer is filed under its material, which opens with its definition's name; the entry of
    // `scaled` is filed so too, and calls it.
    let scaled = |k: Bytes, v: Bytes|
      k.starts_with(answer_key(b"m.scaled\x00"))
        && (match bin::decode(v, kept_bin()) {
          Ok(filed) -> !filed.calls.contains(key_digest(Named(b"m.scaled"))),
          Err(_) -> false,
        });
    body_store.replace(
      body_store.all().fold(Map::new(), |acc: Map<Bytes, Bytes>, k: Bytes, v: Bytes|
        if !answer(k) || scaled(k, v) { acc.insert(k, v) } else { acc }),
    );
    assert_eq(body_store.all().keys().filter(answer).len(), 1);
    let moved = unit(
      b"// a comment, and a definition, above them\nfn aside() -> Int = 7\n".concat(lending),
    );
    assert_eq(moved.kept, 1);
  })
}

/// The store a test's emissions keep bodies in.
effect body_store {
  read get(k: Bytes) -> Option<Bytes>
  write put(records: List<Record>) -> Unit
  read all() -> Map<Bytes, Bytes>
  write replace(m: Map<Bytes, Bytes>) -> Unit
}

/// `body` with an empty store of bodies.
fn kept_bodies<a | e>(
  body: () -> a / {body_store.get, body_store.put, body_store.all, body_store.replace | e},
) -> a / e =
  handle {
    body()
  } with {
    var store: Map<Bytes, Bytes> = Map::new(),
    body_store.get(k) -> store.get(k),
    body_store.put(records) -> {
      store = records.fold(store, |m: Map<Bytes, Bytes>, r: Record| m.insert(r.key, r.bytes));
    },
    body_store.all() -> store,
    body_store.replace(m) -> {
      store = m;
    },
  }

/// The unit over every root of `user`, its answers kept in the store at `s`, told each place as
/// `told` says.
fn unit_kept<[r]>(
  user: List<{ name: Bytes, src: Bytes }>,
  told: keep (PlaceTally) -> Unit / {abort.raise},
) -> Emission / {fs.read[r], fs.write[r], abort.raise} = {
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  with_kept[r, ans]("s", ||
    match emitted(
        a_runtime(b"r"),
        dump,
        sources_placed(dump, user),
        Map::new(),
        offered_roots(dump).keys,
        |k: Bytes| kept_records.get[ans](k),
        |rs: List<Record>| kept_records.put[ans](rs),
        phases: Some({ now: || 0, told: told }),
      ) {
      Ok(e) -> e,
      Err(why) -> panic(String::of_bytes_lossy(why)),
    })
}

fn kept_over(
  tree: fs::MemFs,
  user: List<{ name: Bytes, src: Bytes }>,
) -> fs::Over<Emission> / {abort.raise} = fs::on_mem[abs](tree, || unit_kept[abs](user, unaided))

/// Each file of the store at `s` and the bytes it takes.
fn store_files(tree: fs::MemFs) -> List<{ name: String, size: Int }> / {abort.raise} =
  match fs::listed_names(fs::mem_list(tree, "s")) {
    None -> [],
    Some(names) ->
      names.filter(|n: String| n.starts_with("seg-") || n.starts_with("manifest-")).map(
        |n: String|
          { name: n, size: match fs::mem_size(tree, "s/" ++ n) { Some(s) -> s, None -> 0 } },
      ),
  }

fn store_bytes(tree: fs::MemFs) -> Int / {abort.raise} =
  store_files(tree).fold(0, |n: Int, f: { name: String, size: Int }| n + f.size)

fn unaided(_: PlaceTally) -> Unit = ()

fn kept_program() -> List<{ name: Bytes, src: Bytes }> =
  [
    {
      name: b"m",
      src: b"fn each(n: Int, f: (Int) -> Int, i: Int, acc: Int) -> Int = if i >= n { acc } else { each(n, f, i + 1, acc + f(i)) }\nfn total(n: Int, f: (Int) -> Int) -> Int = each(n, f, 0, 0)\nfn scaled(n: Int, k: Int) -> Int = total(n, |x: Int| x * k)\nfn pair<a>(x: a) -> List<a> = [x, x]\nfn twice(n: Int) -> Int = pair(n).len() + pair(\"s\").len()\n",
    },
  ]

test "a run over a store an earlier run filled reads every answer back and writes nothing" {
  let first = kept_over(fs::mem_of([]), kept_program());
  assert(first.value.asked > 0, None);
  let second = kept_over(first.tree, kept_program());
  assert_eq(second.value.asked, 0);
  assert_eq(second.value.produced.taken, first.value.produced.taken);
  assert_eq(store_files(second.tree), store_files(first.tree))
}

test "a run that dies keeps the answers of every call the emitter finished" {
  let whole = kept_over(fs::mem_of([]), kept_program());
  let died = fs::on_mem[abs](fs::mem_of([]), ||
    handle {
      unit_kept[abs](kept_program(), |_: PlaceTally| panic("the run dies as its first place ends"));
      false
    } with {
      abort.raise(_) -> true,
    });
  assert(died.value, None);
  let next = kept_over(died.tree, kept_program());
  // The answers of its first place were kept as they came back; the next run asks for the rest.
  assert(next.value.kept > 0 && next.value.asked < whole.value.asked, None);
  assert_eq(next.value.produced.taken, whole.value.produced.taken)
}

test "a run keeps only what it was answered anew, however much the store holds" {
  let first = kept_over(fs::mem_of([]), kept_program());
  let grown = |more: Bytes| {
    let user = kept_program().map(|m: { name: Bytes, src: Bytes }|
      { ..m, src: m.src.concat(more) });
    let next = kept_over(first.tree, user);
    { asked: next.value.asked, wrote: store_bytes(next.tree) - store_bytes(first.tree) }
  };
  // A definition more is a root more and the keys it calls; nothing kept before is written again, so
  // each definition more writes what the one before it did.
  let one = grown(b"fn aside() -> Int = 7\n");
  let two = grown(b"fn aside() -> Int = 7\nfn beside() -> Int = 8\n");
  let three = grown(b"fn aside() -> Int = 7\nfn beside() -> Int = 8\nfn below() -> Int = 9\n");
  assert(one.asked > 0 && two.asked > one.asked && three.asked > two.asked, None);
  assert(one.wrote > 0 && one.wrote * 2 < store_bytes(first.tree), None);
  assert(three.wrote - two.wrote <= two.wrote - one.wrote + 400, None)
}

test "a run passes over a store's segment it cannot read and asks for those roots again" {
  let first = kept_over(fs::mem_of([]), kept_program());
  let cut = store_files(first.tree).fold(
    first.tree,
    |t: fs::MemFs, f: { name: String, size: Int }|
      if f.name.starts_with("seg-") { fs::mem_write(t, "s/" ++ f.name, b"").fs } else { t },
  );
  let again = kept_over(cut, kept_program());
  assert_eq(again.value.asked, first.value.asked);
  assert_eq(again.value.produced.taken, first.value.produced.taken)
}

test "answers are kept in a store of their runtime and emitter" {
  let at = |runtime: Bytes, emitter: Bytes| answers_store("b", a_runtime(runtime), emitter);
  assert_eq(at(b"r", b"e"), at(b"r", b"e"));
  assert(at(b"r", b"e") != at(b"r2", b"e"), None);
  assert(at(b"r", b"e") != at(b"r", b"e2"), None)
}

test "a unit takes what it is offered, resolves its bodies and says what it holds" {
  let answers = by_def([{ key: b"m.f", value: one_body(b"m.f", []) }]);
  let p = produce(
    [{ name: b"None", arity: 0 }],
    [{ ..offer(b"m.f", 0), constant: true }],
    1,
    answers,
    Map::new(),
    no_machine,
    part_rule(),
  );
  assert_eq(p.taken, [def_root(b"m.f")]);
  let own = statics_of(SStr(b"m.f")).get(0);
  let symbol = symbol_of(b"m.f");
  let entry = entry_of(b"m.f");
  let body = part_holding(p.text, body_of(b"m.f"));
  assert(
    body.index_of(
        Bytes::concat_all([
          body_of(b"m.f"),
          b" { return (Word)(intptr_t)&",
          own.name,
          b" + ",
          ascii_of_int(root_id(b"m.f")),
          b"; }",
        ]),
      )
      != None,
    None,
  );
  // The body's part declares it and defines the static it names.
  assert(body.index_of(Bytes::concat_all([b"Word ", symbol, b"(PlyCtx*);\n"])) != None, None);
  assert(body.index_of(static_defined(own)) != None, None);
  // A constant says its row of the code table, and the loader takes that table and each
  // definition's entry by address.
  let tables = part_labelled(p.text, "tables");
  assert(tables.index_of(b"\"constants 1\" \"\\n\"\n\"m.f 0\" \"\\n\"") != None, None);
  assert(p.text.index_of(b"\"taken ") == None && p.text.index_of(b"\"lambdas ") == None, None);
  assert(
    tables.index_of(
        Bytes::concat_all([
          b"extern char ",
          entry,
          b";\nvoid *const ply_code[] = {\n  (void *)&",
          entry,
          b",\n  0 };\n",
        ]),
      )
      != None,
    None,
  );
  assert(
    part_labelled(p.text, "taken").index_of(
        Bytes::concat_all([
          b"extern char ",
          entry,
          b";\nconst struct ply_taken ply_taken[] = {\n  { \"m.f\", (void *)&",
          entry,
          b", 0 },\n  { 0, 0, 0 } };\n",
        ]),
      )
      != None,
    None,
  );
  assert(
    tables.index_of(b"(void *)ply_bind, (void *)0, ply_code, 1, ply_taken, 1 };\n") != None,
    None,
  )
}

test "a unit lays its definitions out by name in byte order, each name as a C literal holds it" {
  let roots = [Named(b"m.z"), Entered(Named(b"m.a")), Named(b"m.B")];
  let p = produce(
    [],
    roots.map(|k: RootKey| offer_root(k, 2)),
    1,
    roots.fold(Map::new(), |acc: Map<RootName, Answer>, k: RootKey|
      acc.insert(root_name(k), one_body(printed(k), []))),
    Map::new(),
    no_machine,
    part_rule(),
  );
  let row = |n: Bytes|
    Bytes::concat_all([b"  { \"", n, b"\", (void *)&", entry_of(n), b", 2 },\n"]);
  assert(
    p.text.index_of(
        Bytes::concat_all([
          b"ply_taken[] = {\n",
          row(b"m.B"),
          row(b"m.a#entered"),
          row(b"m.z"),
          b"  { 0, 0, 0 } };\n",
        ]),
      )
      != None,
    Some(String::of_bytes_lossy(p.text)),
  );
  let taken_struct = b"struct ply_taken { const char *name; void *entry; unsigned long arity; };\n";
  assert_eq(
    taken_part([
      { name: def_root(b"m.\"q\""), arity: 0, symbol: b"f", entry: b"e", head: word_head(0) },
    ]),
    Bytes::concat_all([
      b"\n/* --- part taken --- */\n",
      taken_struct,
      b"extern char e;\n",
      b"const struct ply_taken ply_taken[] = {\n  { \"m.\\\"q\\\"\", (void *)&e, 0 },\n  { 0, 0, 0 } };\n",
    ]),
  );
  // The descriptor's layout is the runtime's, and it takes the `taken` part's table by address.
  let tables = tables_part([], [], b"", 1);
  assert(
    tables.starts_with(b"\n/* --- part tables --- */\nvoid *const ply_code[] = {\n  0 };\n"),
    None,
  );
  assert(
    tables.ends_with(
      Bytes::concat_all([
        taken_struct,
        b"extern const struct ply_taken ply_taken[];\n",
        b"void ply_bind(void **fns);\n",
        b"struct ply_descriptor { const char *exports; unsigned long exports_len; void *bind; void *bind_singletons; void *const *code; unsigned long code_count; const struct ply_taken *taken; unsigned long taken_count; };\n",
        b"const struct ply_descriptor ply_descriptor = { ply_exports, sizeof ply_exports - 1, (void *)ply_bind, (void *)0, ply_code, 0, ply_taken, 1 };\n",
      ]),
    ),
    Some(String::of_bytes_lossy(tables)),
  )
}

test "a root's code moves with the key a type it names states" {
  let program = |key: Answer, calls: List<Bytes>|
    codes_over(
      [
        { key: b"m.make", value: one_body(b"m.make", calls) },
        { key: b"m.area", value: key },
        { key: b"m.edge", value: one_body(b"m.edge", []) },
      ],
      [b"m.make", b"m.area", b"m.edge"],
      [],
    );
  let keyed = program(one_body(b"m.area", []), [b"m.area"]);
  let edited = program(edited_body(b"m.area"), [b"m.area"]);
  let other = program(one_body(b"m.area", []), [b"m.edge"]);
  assert(keyed.get(b"m.make") != edited.get(b"m.make"), None);
  assert(keyed.get(b"m.make") != other.get(b"m.make"), None)
}

test "a read of a definition of no parameters keeps its value for good through its type's keep root" {
  let k = kept_unit(
    Bytes::concat_all([
      b"fn flag() -> Bool = 1 < 2\n",
      b"fn word() -> String = \"a\" ++ \"b\"\n",
      b"fn none<a>() -> Option<a> = None\n",
      b"fn read() -> Int = if flag() { word().len() } else { 0 }\n",
      b"fn nothing() -> Option<Int> = none()\n",
    ]),
  );
  let held = k.unit([b"m.flag", b"m.word", b"m.none", b"m.read", b"m.nothing"].map(Named));
  let text = held.produced.text;
  let read_with = |keep: Bytes|
    text.index_of(Bytes::concat_all([b", (Word)(intptr_t)", keep, b")"])) != None;
  assert(text.index_of(b"rt_memo_p(ctx, ") != None, None);
  // A word form that holds no block is kept as it is, and one that may by its type's root.
  assert(read_with(same_word_fn()), None);
  assert(read_with(symbol_of(printed(root_of(keys::Keep, string_type())))), None);
  // A generic definition is called at its caller's type arguments, which settle its body.
}

// The prelude reads plain constants of its own, so the counts compare two programs.
test "a read of a `const fn` is charged nothing, and a read of a plain definition what it cost" {
  let reads = |table: Bytes| {
    let k = kept_unit(Bytes::concat_all([table, b"fn read() -> Int = table().len()\n"]));
    let text = k.unit([b"m.table", b"m.read"].map(Named)).produced.text;
    let count = |helper: Bytes| text.split(helper).len() - 1;
    [count(b"rt_const_p(ctx, "), count(b"rt_memo_p(ctx, ")]
  };
  let constant = reads(b"const fn table() -> List<Int> = [1, 2]\n");
  let plain = reads(b"fn table() -> List<Int> = [1, 2]\n");
  assert_eq(constant, [1, plain.get(1) - 1]);
  assert_eq(plain.get(0), 0)
}

/// The unit over every root `user` offers, its answers read from and kept in the test's store, and
/// each place it walks kept there as `place` and its number. Stops where it keeps an answer the store
/// holds already, which is a root answered twice.
fn unit_in_store(
  user: List<{ name: Bytes, src: Bytes }>,
) -> Emission / {body_store.get, body_store.put, abort.raise} = {
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  match emitted(
      a_runtime(b"r"),
      dump,
      sources_placed(dump, user),
      Map::new(),
      offered_roots(dump).keys,
      |k: Bytes| body_store.get(k),
      |rs: List<Record>|
        match rs.find(|r: Record|
            r.key.starts_with(b"answer\x00") && body_store.get(r.key) != None) {
          Some(r) -> panic(String::of_bytes_lossy(b"an answer kept twice: ".concat(r.key))),
          None -> body_store.put(rs),
        },
      phases: Some({
        now: || 0,
        told: |r: PlaceTally|
          body_store.put([{ key: b"place ".concat(ascii_of_int(r.place)), bytes: b"" }]),
      }),
    ) {
    Ok(e) -> e,
    Err(why) -> panic(String::of_bytes_lossy(why)),
  }
}

/// A module of records nested `d` deep, each holding the one below and a list of them, and a function
/// of the deepest the runtime enters: its entry lifts the record and lets go of it.
fn nested_records(d: Int) -> List<{ name: Bytes, src: Bytes }> =
  [
    {
      name: b"m",
      src: Bytes::concat_all(
        range(1, d + 1).fold([b"type T0 = { s: String }\n"], |acc: List<Bytes>, k: Int| {
          let below = ascii_of_int(k - 1);
          acc.push(
            Bytes::concat_all([
              b"type T",
              ascii_of_int(k),
              b" = { x: T",
              below,
              b", y: List<T",
              below,
              b"> }\n",
            ]),
          )
        }).push(
          Bytes::concat_all([b"pub fn crossed(t: T", ascii_of_int(d), b") -> Int = 1\n"]),
        ),
      ),
    },
  ]

test "a unit's places do not grow with how deep the records it crosses nest, and it answers each root once" {
  let places = [2, 4, 8].map(|d: Int|
    kept_bodies(|| {
      let e = unit_in_store(nested_records(d));
      body_store.all().keys().filter(|k: Bytes| k.starts_with(b"place ")).len()
    }));
  assert(
    places.all(|n: Int| n == places.get(0)),
    Some("places at depths 2, 4 and 8: " ++ String::join(places.map(|n: Int| n.to_string()), ", ")),
  )
}

/// What a test's emitter holds: what a unit's emitter holds, how many scopes it built, and the roots
/// it was asked for, in order, each as often as it was asked for.
type Counted = { scoped: Scoped, built: Int, asked: List<RootName> }

/// The walk of every root `user` offers, its answers read from and kept in the test's store, the
/// emitter a unit's (`scoped_asked`) counting the scopes it builds and the roots it is asked for;
/// with the program it walked and the front end's answer it was read from.
fn walk_in_store(
  user: List<{ name: Bytes, src: Bytes }>,
) -> { walk: Walk<Counted>, program: Program, dump: Dump } / {body_store.get, body_store.put, abort.raise} = {
  let dump = dump_of(analyse_pulling_std_with(user, [], no_rows()).out);
  let offered = offered_roots(dump).keys;
  let p = program_of(dump, sources_placed(dump, user), offered);
  let ctors = dump.emitter_ctors.map(|c: EmitterCtor| { name: c.name, arity: c.arity });
  let walk = walked(
    p,
    types_material(dump),
    program_ctors(dump, ctors),
    offered,
    |k: Bytes| body_store.get(k),
    |rs: List<Record>| body_store.put(rs),
    None,
    |ahead: List<RootKey>| { scoped: unscoped(ahead), built: 0, asked: [] },
    |held: Counted, roots: List<RootKey>, handed: Map<RootName, Handing>, done: Done| {
      let a = scoped_asked(dump, p, ctors, offered, held.scoped, roots, handed, done);
      let grew = match held.scoped.scope {
        None -> true,
        Some(_) -> a.held.covered.len() > held.scoped.covered.len(),
      };
      {
        held: {
          scoped: a.held,
          built: if grew { held.built + 1 } else { held.built },
          // The roots written for types it found are asked of it too, with those it was handed.
          asked: held.asked.concat(roots.map(root_name)).concat(a.found.map(root_name)),
        },
        answers: a.answers,
        found: a.found,
      }
    },
  );
  { walk: walk, program: p, dump: dump }
}

test "a cold walk asks the emitter for each root once over one scope, and a warm one builds none" {
  kept_bodies(|| {
    let walked_cold = walk_in_store(kept_program());
    let cold = walked_cold.walk;
    assert_eq(cold.emitter.built, 1);
    // Every root is asked for, so the scope holds every module the unit reads.
    assert_eq(cold.emitter.scoped.covered.keys(), walked_cold.program.read.keys());
    assert(cold.emitter.asked.len() > 0, None);
    assert_eq(names_ordered(cold.emitter.asked).len(), cold.emitter.asked.len());
    assert_eq(cold.asked, cold.emitter.asked.len());
    let warm = walk_in_store(kept_program()).walk;
    assert_eq((warm.emitter.built, warm.emitter.asked), (0, []));
    assert_eq(warm.answers.keys(), cold.answers.keys())
  })
}

/// A program of two parts that share only the prelude. In the first, `k` calls what `g` defines
/// generically: `apply`, written `applied`, running the lambda `k.one` lends it; `same`, which reads
/// the type it is at, through `k.both`; and `first`, at a record type `k` declares. In the second,
/// `e` calls `d.bump`, which adds `added`.
fn parted_program(applied: Bytes, added: Bytes) -> List<{ name: Bytes, src: Bytes }> =
  [
    {
      name: b"g",
      src: Bytes::concat_all([
        b"pub fn apply<a>(f: (a) -> a, x: a) -> a = ",
        applied,
        b"\n",
        b"pub fn same<a>(x: a, y: a) -> Bool = x == y\n",
        b"pub fn first<a>(xs: List<a>) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }\n",
      ]),
    },
    {
      name: b"k",
      src: Bytes::concat_all([
        b"import g\n",
        b"pub type Box = { v: Int, w: List<Int> }\n",
        b"pub fn both<a>(x: a) -> Bool = g::same(x, x)\n",
        b"pub fn checked(n: Int) -> Bool = both(n)\n",
        b"pub fn one() -> Int = g::apply(|x: Int| x + 1, 1)\n",
        b"pub fn top(xs: List<Box>) -> Int = match g::first(xs) { Some(b) -> b.v + b.w.len(), None -> 0 }\n",
      ]),
    },
    { name: b"d", src: Bytes::concat_all([b"pub fn bump(x: Int) -> Int = x + ", added, b"\n"]) },
    { name: b"e", src: b"import d\npub fn h(x: Int) -> Int = d::bump(x) - 1\n" },
  ]

test "a warm walk's scope holds what the roots it misses read, and no module of the program's other part" {
  kept_bodies(|| {
    walk_in_store(parted_program(b"f(x)", b"1"));
    let warm = walk_in_store(parted_program(b"f(x)", b"2"));
    // `bump` moved, and `h`'s kept body called it as it was.
    let missed = [Named(b"d.bump"), Named(b"e.h")];
    let read = program_of(warm.dump, warm.program.sources, missed).read.keys();
    assert(!read.contains(b"g") && !read.contains(b"k"), None);
    let held = warm.walk.emitter;
    assert_eq(names_ordered(held.asked), names_ordered(missed.map(root_name)));
    assert_eq(held.scoped.covered.keys(), read);
    assert_eq(held.built, 1)
  })
}

test "a walk grows its scope once, over what is left, where a kept body's call settles on a root it misses" {
  kept_bodies(|| {
    walk_in_store(parted_program(b"f(x)", b"1"));
    let edited = parted_program(b"f(f(x))", b"1");
    let warm = walk_in_store(edited);
    let held = warm.walk.emitter.scoped;
    // Of what was offered only `apply` moved, so the first scope lacked `k`; `one`'s kept body lends
    // its lambda to `apply`, and the call settles on a specialisation lowered with `k`.
    assert(!modules_asked(warm.program, held.ahead).contains(b"k"), None);
    assert(held.covered.contains(b"k"), None);
    assert_eq(warm.walk.emitter.built, 2);
    let cold = kept_bodies(|| walk_in_store(edited)).walk;
    assert(warm.walk.answers == cold.answers, None)
  })
}

test "a warm unit writes the C a cold one writes, over modules each kept apart or grown into" {
  let first = kept_over(fs::mem_of([]), parted_program(b"f(x)", b"1"));
  let edited = parted_program(b"f(f(x))", b"2");
  let warm = kept_over(first.tree, edited).value;
  let cold = kept_over(fs::mem_of([]), edited).value;
  assert(warm.kept > 0 && warm.asked < cold.asked, None);
  assert_eq(names_ordered(warm.roots.map(root_name)), names_ordered(cold.roots.map(root_name)));
  assert(warm.produced.text == cold.produced.text, None)
}

/// Whether `a` and `b` hold the same keys, each with the same items in any order.
fn same_items<v>(a: Map<RootName, List<v>>, b: Map<RootName, List<v>>) -> Bool
  where derivable(eq, v)
=
  a.keys() == b.keys()
    && a.fold(true, |ok: Bool, n: RootName, xs: List<v>|
      ok
        && (match b.get(n) {
          Some(ys) -> xs.len() == ys.len() && xs.all(|x: v| ys.contains(x)),
          None -> false,
        }))

test "a walk's needs and parameters called are those one closure over all its generic bodies gives" {
  kept_bodies(|| {
    let w = walk_in_store(parted_program(b"f(x)", b"1")).walk;
    let needs = closed_needs(w.answers, w.keys);
    let called = closed_called(w.answers, w.keys);
    assert(same_items(w.needs, needs), None);
    assert(same_items(w.called, called), None);
    // `both` needs of its variable what `same` does of the one `both` hands it, and `apply` calls the
    // function it is handed.
    assert(
      match needs.get(def_root(b"k.both")) {
        Some(ns) -> ns.contains({ var: 0, reads: Exact }),
        None -> false,
      },
      None,
    );
    assert_eq(called.get(def_root(b"g.apply")), Some([0]))
  })
}
