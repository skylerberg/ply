pub effect shipped {
  read names() -> List<String>
  read module(name: String) -> Option<Bytes>
  read read_pack(path: String, offset: Int, len: Int) -> Option<Bytes>
  read digests() -> Bytes
  read report_view_used(view: Bytes, pulled: Bool) -> Unit
  read version() -> String
  read binary_size() -> Option<Int>
  read stamps() -> String
  read runtime() -> Bytes
  read definitions() -> Bytes
  read run_root(library: String, root: String, arguments: Bytes, timeout_ms: Int) -> Option<Bytes>
}

host for shipped by shipped_handler

fn shipped_handler<a | e>(go: () -> a / {shipped.read | e}) -> a / {native.read, abort.raise | e} =
  handle {
    go()
  } with {
    shipped.names() -> {
      observed("", "", 5);
      parts(shipped_names()).map(|name: Bytes| String::of_bytes_lossy(name))
    },
    shipped.module(name) -> {
      observed("", name, 5);
      found(shipped_module(name))
    },
    shipped.read_pack(path, offset, len) -> if offset < 0 || len < 0 { None }
    else { found(shipped_answer(path, offset, len)) },
    shipped.digests() -> shipped_digests(),
    shipped.report_view_used(view, pulled) ->
      observed("", String::of_bytes_lossy(view), if pulled { 7 } else { 8 }),
    shipped.version() -> String::of_bytes_lossy(shipped_version()),
    shipped.binary_size() -> match found(shipped_binary_bytes()) {
      Some(n) -> Some(decode_int(n)),
      None -> None,
    },
    shipped.stamps() -> String::of_bytes_lossy(shipped_stamps()),
    shipped.runtime() -> shipped_described(),
    shipped.definitions() -> {
      observed("", "", 6);
      shipped_definitions()
    },
    shipped.run_root(library, root, arguments, timeout_ms) ->
      found(shipped_entered(library, root, arguments, timeout_ms)),
  }

extern fn shipped_names() -> Bytes / {native.read}

extern fn shipped_module(name: String) -> Bytes / {native.read}

extern fn shipped_answer(path: String, offset: Int, len: Int) -> Bytes / {native.read}

extern fn shipped_digests() -> Bytes / {native.read}

extern fn shipped_version() -> Bytes / {native.read}

extern fn shipped_binary_bytes() -> Bytes / {native.read}

extern fn shipped_stamps() -> Bytes / {native.read}

extern fn shipped_described() -> Bytes / {native.read}

extern fn shipped_definitions() -> Bytes / {native.read}

extern fn shipped_entered(
  library: String,
  root: String,
  arguments: Bytes,
  timeout_ms: Int,
) -> Bytes / {native.read}

pub fn shipped_runtime() -> Runtime / {shipped.runtime, abort.raise} =
  match runtime_of(shipped.runtime()) {
    Ok(r) -> r,
    Err(reason) ->
      panic(
        "this binary could not read the description of the runtime it is linked with: "
          ++ String::of_bytes_lossy(reason),
      ),
  }

pub type Unbound = { declared: Extern, found: List<Native> }

pub fn unbound(natives: List<Native>, declared: List<Extern>) -> List<Unbound> = {
  let by_name = natives.fold(Map::new(), |accumulator: Map<Bytes, List<Native>>, n: Native|
    accumulator.insert(
      n.name,
      List::push(match accumulator.get(n.name) { Some(ns) -> ns, None -> [] }, n),
    ));
  declared.fold([], |accumulator: List<Unbound>, d: Extern| {
    let found = match by_name.get(d.name) { Some(ns) -> ns, None -> [] };
    match found {
      [n] -> if n == declared_signature(d) { accumulator }
      else { accumulator.push({ declared: d, found: found }) },
      _ -> accumulator.push({ declared: d, found: found }),
    }
  })
}

pub fn declared_signature(d: Extern) -> Native =
  match d.call {
    Some(c) ->
      { name: d.name, params: call_params(c), result: call_result_kind(c), raises: d.raises },
    None -> match abi::native_named(d.name) {
      Some(n) -> n,
      None -> word_native(d.name, d.words, true, d.raises),
    },
  }

fn call_params(c: MachineCall) -> List<Machine> =
  c.params.fold([], |accumulator: List<Machine>, v: MachineValue|
    match v {
      MachineInt(_) -> accumulator.push(abi::I64),
      MachineFloat -> accumulator.push(abi::F64),
      MachineText(_) -> accumulator.push(abi::Address).push(abi::I64),
      MachineSecret(_) -> accumulator.push(abi::Secret),
      MachineObject(_) -> accumulator.push(abi::Handle),
      MachineTypeVariable(_) -> accumulator.push(abi::Opaque).push(abi::Type),
      MachineFunction(_) -> accumulator.push(abi::Block).push(abi::Words).push(abi::Words),
      MachineUnit -> accumulator,
    }).concat(match c.result { MachineTypeVariable(_) -> [abi::Type], _ -> [] })

fn call_result_kind(c: MachineCall) -> Option<Machine> =
  match c.result {
    MachineInt(_) -> Some(abi::I64),
    MachineFloat -> Some(abi::F64),
    MachineText(_) -> Some(abi::Taken),
    MachineSecret(_) -> Some(abi::Secret),
    MachineObject(_) -> Some(abi::Handle),
    MachineTypeVariable(_) -> Some(abi::Opaque),
    MachineFunction(_) -> None,
    MachineUnit -> None,
  }

fn extern_natives(declared: List<Extern>) -> List<Native> / {abort.raise} =
  declared.fold([], |accumulator: List<Native>, e: Extern|
    if e.call == None { accumulator }
    else { accumulator.push({ ..declared_signature(e), name: builtin_helper(e.name) }) })

fn natives_of(bodies: List<UnitBody>) -> Map<Bytes, Bool> =
  bodies.fold(Map::new(), |accumulator: Map<Bytes, Bool>, k: UnitBody|
    k.tables.natives.fold(accumulator, |m: Map<Bytes, Bool>, n: Bytes| m.insert(n, true)))

fn called_externs(called: Map<Bytes, Bool>, natives: List<Extern>) -> List<Extern> / {abort.raise} =
  natives.filter(|e: Extern| called.contains(builtin_helper(e.name)))

fn kinds_text(n: Native) -> Bytes =
  Bytes::concat_all([
    b"takes [",
    Bytes::join(n.params.map(machine_name), b", "),
    b"]",
    match n.result {
      Some(m) -> b", returns ".concat(machine_name(m)),
      None -> b", returns nothing",
    },
    if n.raises { b" and raises" } else { b" and cannot raise" },
  ])

fn unbound_line(u: Unbound) -> Bytes = {
  let d = u.declared;
  let named = if d.module == b"" { Bytes::concat_all([b"the compiler's `", d.name, b"`"]) }
  else { Bytes::concat_all([b"`extern fn ", d.name, b"` of `", d.module, b"`"]) };
  match u.found {
    [] -> named.concat(b": no native of the runtime implements it"),
    [n] ->
      Bytes::concat_all([
        named,
        b" ",
        kinds_text(declared_signature(d)),
        b", and the runtime's native ",
        kinds_text(n),
      ]),
    ns ->
      Bytes::concat_all([
        named,
        b": ",
        ascii_of_int(ns.len()),
        b" natives of the runtime implement it",
      ]),
  }
}

pub type SignatureMismatch = {
  caller: RootName,
  assumed: PublishedSignature,
  published: Option<PublishedSignature>,
}

pub fn natives_rejected(rejected: List<Unbound>) -> Diagnostic =
  error_with_labels(
    b"E0476",
    Bytes::concat_all([
      b"the runtime does not implement ",
      ascii_of_int(rejected.len()),
      if rejected.len() == 1 { b" native this program calls as it is declared" }
      else { b" natives this program calls as they are declared" },
    ]),
    [],
    rejected.map(unbound_line).push(
      b"a native is a function the runtime implements for the program; the runtime declares each native with one function type, while the compiler that generated the program declared it with another; they differ when that compiler and the runtime come from different versions of Ply, such as an older release's compiler and a newer runtime",
    ),
  )

pub fn runtime_rejected(unserved: List<RuntimeMismatch>) -> Diagnostic =
  error_with_labels(
    b"E0481",
    Bytes::concat_all([
      b"the runtime does not support the code this compiler emits in ",
      ascii_of_int(unserved.len()),
      if unserved.len() == 1 { b" place" } else { b" places" },
    ]),
    [],
    unserved.map(mismatch_line).push(
      b"the runtime defines its helper functions and data layout in its Rust code, while the compiler generates code that follows the definitions in `compiler.emit.abi`; they differ when that compiler and the runtime come from different versions of Ply",
    ),
  )

pub fn pack_frame(path: String, offset: Int, len: Int) -> Option<Bytes> / {shipped.read_pack} =
  shipped.read_pack(path, offset, len)

pub fn definition_hash(definitions: Bytes, name: Bytes) -> Option<Bytes> / {abort.raise} = {
  let line = name.concat(b" ");
  let found = if definitions.starts_with(line) { Some(0) }
  else { match definitions.index_of(b"\n".concat(line)) { Some(i) -> Some(i + 1), None -> None } };
  match found {
    None -> None,
    Some(i) -> {
      let from = i + line.len();
      let most = if from + 65 > definitions.len() { definitions.len() } else { from + 65 };
      let rest = definitions.slice(from, most);
      Some(rest.slice(0, match rest.index_of_byte(10) { Some(end) -> end, None -> rest.len() }))
    },
  }
}

pub fn identity_of(definitions: Bytes, roots: List<Bytes>) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all(
        roots.map(|root: Bytes|
          match definition_hash(definitions, root) {
            Some(h) -> Bytes::concat_all([root, b" ", h, b"\n"]),
            None ->
              panic(
                "this binary's program has no definition `" ++ String::of_bytes_lossy(root)
                  ++ "`, but cached results are recorded under that name",
              ),
          }),
      ),
    ),
  )

pub const unit_roots: List<Bytes> =
  [
    b"compiler.front.checking.units.code_result",
    b"compiler.unit.produce",
    b"compiler.front.emitter_input.view_dump",
  ]

pub const compiler_roots: List<Bytes> = unit_roots.push(b"compiler.front.analyse_pulling_std_with")

pub fn program_key(entry: Bytes, runtime: Runtime, definitions: Bytes) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all([
        b"ply.program.1\0",
        entry,
        runtime.identity,
        b"\0",
        identity_of(definitions, [b"compiler.build.build_program"]),
      ]),
    ),
  )

pub const programs_dir: String = "programs"

fn cache_path(dir: String, key: Bytes) -> String / {abort.raise} =
  if dir == "" || dir == "." { String::of_bytes(key) } else { dir ++ "/" ++ String::of_bytes(key) }

pub fn read_cached_file<[r]>(
  dir: String,
  key: Bytes,
) -> Option<Bytes> / {fs.read[r], fs.write[r], time.now_ms, abort.raise} = {
  let path = cache_path(dir, key);
  match fs.read_file[r](path) {
    None -> None,
    Some(bytes) -> {
      fs.set_modified[r](path, time.now_ms());
      Some(bytes)
    },
  }
}

pub fn write_cached_file<[r]>(
  dir: String,
  key: Bytes,
  bytes: Bytes,
) -> Unit / {fs.write[r], entropy.next, time.now_ms, abort.raise} = {
  let path = cache_path(dir, key);
  let nonce = blake3(u64_le(entropy.next()).concat(u64_le(time.now_ms()))).slice(0, 8);
  let temp = path ++ "." ++ nonce.hex_of() ++ ".tmp";
  if fs.create_dir[r](if dir == "" { "." } else { dir }) && fs.write_file[r](temp, bytes) {
    if !fs.rename[r](temp, path) {
      fs.remove[r](temp);
      ()
    }
  }
}

pub type RequestedRoot = {
  key: RootKey,
  name: RootName,
  arity: Int,
  constant: Bool,
  site: RootName,
  home: Bytes,
}

derive bin for RequestedRoot

pub type Constructor = { name: Bytes, arity: Int }

pub type UnitContents = { bodies: List<UnitBody>, requested: List<RequestedRoot> }

pub type UnitOutput = { parts: List<WrittenPart>, taken: List<RootName>, made: UnitContents }

pub type Emission = {
  produced: UnitOutput,
  roots: List<RootKey>,
  cached: Int,
  emitter_requests: Int,
  unserved: List<RuntimeMismatch>,
  unbound: List<Unbound>,
  signature_mismatches: List<SignatureMismatch>,
}

pub fn results_by_name(rows: List<RootOutput>) -> Map<RootName, Output> =
  rows.fold(Map::new(), |accumulator: Map<RootName, Output>, r: RootOutput|
    if r.result.tables.members.len() == 0 { accumulator.insert(r.name, r.result) } else {
      r.result.tables.members.fold(accumulator, |into: Map<RootName, Output>, m: RootKey|
        into.insert(root_name(m), r.result))
    })

pub fn sorted_unique(xs: List<Bytes>) -> List<Bytes> =
  xs.fold(Map::new(), |accumulator: Map<Bytes, Bool>, x: Bytes| accumulator.insert(x, true)).keys()

fn sorted_unique_names(xs: List<RootName>) -> List<RootName> =
  xs.fold(Map::new(), |accumulator: Map<RootName, Bool>, x: RootName|
    accumulator.insert(x, true)).keys(
  )

pub type UnitBody = { name: RootName, text: Bytes, tables: Tables, body: Bytes, size: Int }

fn defined_symbol(name: RootName, tables: Tables) -> DefinitionSymbol / {abort.raise} = {
  let found = range(0, tables.members.len()).fold(0 - 1, |accumulator: Int, i: Int|
    if accumulator < 0 && root_name(tables.members.get(i)) == name { i } else { accumulator });
  match tables.defined.at(if found < 0 { 0 } else { found }) {
    Some(d) -> d,
    None ->
      panic(
        String::of_bytes_lossy(
          b"every generated body must contain the C code for its definition, but `".concat(
            root_text(name),
          ).concat(
            b"`'s publishes none",
          ),
        ),
      ),
  }
}

fn is_group_head(name: RootName, tables: Tables, taken: Map<RootName, Bool>) -> Bool =
  match tables.members.map(root_name).filter(|m: RootName| taken.contains(m)).at(0) {
    Some(first) -> first == name,
    None -> true,
  }

fn symbol_named(name: RootName) -> Bytes / {abort.raise} = symbol_of(root_text(name))

fn entry_defined(name: RootName, d: DefinitionSymbol) -> Bytes / {abort.raise} =
  if d.entered { entry_symbol(root_text(name)) } else { b"" }

fn taken_bodies(
  results: Map<RootName, Output>,
  taken: List<RootName>,
  foreign: Map<RootName, Prototype>,
) -> { bodies: List<UnitBody>, defined: Map<RootName, DefinitionSymbol> } / {abort.raise} = {
  let set = taken.fold(Map::new(), |accumulator: Map<RootName, Bool>, n: RootName|
    accumulator.insert(n, true));
  taken.fold(
    { bodies: [], defined: Map::new() },
    |r: { bodies: List<UnitBody>, defined: Map<RootName, DefinitionSymbol> }, name: RootName|
      match results.get(name) {
        None ->
          panic(
            String::of_bytes_lossy(
              Bytes::concat_all([b"the emitter returned nothing for `", root_text(name), b"`"]),
            ),
          ),
        Some(b) -> match b.tables.calls.map(root_name).find(|c: RootName|
            !set.contains(c) && !foreign.contains(c)) {
          Some(callee) ->
            panic(
              String::of_bytes_lossy(
                Bytes::concat_all([
                  b"`",
                  root_text(name),
                  b"` calls `",
                  root_text(callee),
                  b"`, which is not part of the same compiled program",
                ]),
              ),
            ),
          None ->
            {
              bodies: if is_group_head(name, b.tables, set) {
                r.bodies.push({
                  name: name,
                  text: b.text,
                  tables: b.tables,
                  body: body_digest(b),
                  size: b.text.len(),
                })
              } else { r.bodies },
              defined: r.defined.insert(name, defined_symbol(name, b.tables)),
            },
        },
      },
  )
}

pub fn always_enters(k: RootKey) -> Bool =
  match k { Test(_) -> true, TestCases(_) -> true, _ -> false }

fn runtime_enters(p: LoweringInput, marshalling: MarshalledSums, k: RootKey) -> Bool =
  match k {
    Test(_) -> true,
    TestCases(_) -> true,
    Law(_) -> match p.binders.get(root_name(k)) {
      Some(types) -> types.all(|t: Type| emit::liftable(marshalling, t)),
      None -> false,
    },
    Clause(c) ->
      runtime_enters(p, marshalling, c.definition)
        && (match c.definition {
          Named(n) -> match p.schemes.get(n) {
            Some(scheme) -> emit::judgeable(marshalling, scheme),
            None -> false,
          },
          _ -> false,
        }),
    Named(n) -> match ((p.schemes.get(n), p.roots.get(root_name(k)))) {
      (Some(scheme), Some(r)) ->
        emit::enterable(marshalling, scheme)
          && (scheme.type_variables.len() == 0 || r.witnesses.len() == 0),
      (Some(scheme), None) ->
        emit::enterable(marshalling, scheme) && scheme.type_variables.len() == 0,
      _ -> false,
    },
    _ -> false,
  }

fn entered_types(p: LoweringInput, k: RootKey) -> List<Type> =
  match k {
    Law(_) -> match p.binders.get(root_name(k)) { Some(types) -> types, None -> [] },
    Clause(c) -> entered_types(p, c.definition),
    Named(n) -> match p.schemes.get(n) { Some(scheme) -> [scheme.ty], None -> [] },
    _ -> [],
  }

fn marshalling_of(types: List<Type>) -> MarshalledSums / {EmitReads} = {
  let defined = emitted_code.calls.concat(emitted_code.insert_calls).fold(
    Map::new(),
    |found: Map<Bytes, Bool>, n: Bytes|
      if definition_called(qualify(prelude_module, n)) == None { found }
      else { found.insert(n, true) },
  );
  marshalled_sums(
    sums_around(|n: Bytes| code_facts.sum_named(n), types.flat_map(type_names)),
    |n: Bytes| defined.contains(n),
  )
}

pub type RequestedRoots = { keys: List<RootKey>, unkeyed: List<Bytes> }

pub fn requested_roots(dump: Dump) -> RequestedRoots / {abort.raise} = {
  let results_and_keys = roots_by_row_name(dump);
  dump.emitter_roots.fold(
    { keys: [], unkeyed: [] },
    |accumulator: RequestedRoots, r: EmitterRoot|
      match results_and_keys.get(r.root) {
        Some(k) -> { ..accumulator, keys: accumulator.keys.push(k) },
        None -> { ..accumulator, unkeyed: accumulator.unkeyed.push(r.root) },
      },
  )
}

fn roots_by_row_name(dump: Dump) -> Map<Bytes, RootKey> / {abort.raise} = {
  let results_and_keys = |m: Map<Bytes, RootKey>, k: RootKey| m.insert(root_text(root_name(k)), k);
  let defined = dump.definitions.fold(Map::new(), |m: Map<Bytes, RootKey>, d: DefinitionRow|
    d.spec.fold(
      { m: results_and_keys(m, Named(d.name)), requires: 0, ensures: 0 },
      |accumulator: { m: Map<Bytes, RootKey>, requires: Int, ensures: Int }, s: SpecRow|
        if s.kind == spec_kind_text(RequiresClause) {
          {
            ..accumulator,
            m: results_and_keys(
              accumulator.m,
              Clause({ definition: Named(d.name), kind: Requires, n: accumulator.requires }),
            ),
            requires: accumulator.requires + 1,
          }
        } else if s.kind == spec_kind_text(EnsuresClause) {
          {
            ..accumulator,
            m: results_and_keys(
              accumulator.m,
              Clause({ definition: Named(d.name), kind: Ensures, n: accumulator.ensures }),
            ),
            ensures: accumulator.ensures + 1,
          }
        } else { accumulator },
    ).m);
  let tested = dump.tests.fold(defined, |m: Map<Bytes, RootKey>, t: TestRow| {
    let run = test_key(t.module, t.name);
    results_and_keys(results_and_keys(m, run), TestCases(run))
  });
  dump.laws.fold(tested, |m: Map<Bytes, RootKey>, l: LawRow|
    results_and_keys(
      results_and_keys(m, law_key(l.module, l.name, LawGuard)),
      law_key(l.module, l.name, LawBody),
    ))
}

type Pools = { fields: List<Bytes>, lambdas: List<Bytes> }

fn pools_of(
  bodies: List<UnitBody>,
  statics: List<StaticDefinition>,
  constant_entries: List<{ name: RootName, entry: Bytes }>,
) -> Pools / {abort.raise} = {
  let ts = bodies.map(|k: UnitBody| k.tables);
  let all = |pick: (Tables) -> List<Bytes>|
    ts.fold([], |accumulator: List<Bytes>, tables: Tables| accumulator.concat(pick(tables)));
  {
    fields: sorted_unique(
      all(|tables: Tables| tables.fields).concat(
        statics.fold([], |accumulator: List<Bytes>, d: StaticDefinition|
          accumulator.concat(static_fields(d))),
      ),
    ),
    lambdas: sorted_unique(
      constant_entries.map(|c: { name: RootName, entry: Bytes }|
        nonempty_entry(c.name, c.entry)).concat(
        bodies.fold([], |accumulator: List<Bytes>, k: UnitBody|
          accumulator.concat(k.tables.lambdas.map(|l: Bytes| nonempty_entry(k.name, l)))),
      ),
    ),
  }
}

fn nonempty_entry(name: RootName, entry: Bytes) -> Bytes / {abort.raise} =
  if entry.len() > 0 { entry } else {
    panic(
      String::of_bytes_lossy(
        Bytes::concat_all([
          b"`",
          root_text(name),
          b"` has an empty name for its generated C function",
        ]),
      ),
    )
  }

fn ordered_statics(bodies: List<UnitBody>) -> List<StaticDefinition> / {abort.raise} =
  bodies.fold(
    { out: [], seen: Map::new() },
    |accumulator: { out: List<StaticDefinition>, seen: Map<Bytes, StaticDefinition> }, k: UnitBody|
      k.tables.statics.fold(
        accumulator,
        |a: { out: List<StaticDefinition>, seen: Map<Bytes, StaticDefinition> }, d: StaticDefinition|
          match a.seen.get(d.name) {
            Some(e) -> if e == d { a } else {
              panic(
                String::of_bytes_lossy(
                  b"two statics of one name contain different content: ".concat(d.name),
                ),
              )
            },
            None -> { out: a.out.push(d), seen: a.seen.insert(d.name, d) },
          },
      ),
  ).out

fn static_fields(d: StaticDefinition) -> List<Bytes> =
  words_of(d).fold([], |accumulator: List<Bytes>, w: StaticWord|
    match w { FieldWord(n) -> accumulator.push(n), _ -> accumulator })

fn has_fields(d: StaticDefinition) -> Bool = static_fields(d).len() > 0

fn addressed(d: StaticDefinition) -> List<Bytes> =
  words_of(d).fold([], |accumulator: List<Bytes>, w: StaticWord|
    match w { AddressWord(a) -> accumulator.push(a.name), _ -> accumulator })

type TablePositions = { fields: Map<Bytes, Int>, lambdas: Map<Bytes, Int> }

fn table_positions(p: Pools) -> TablePositions / {abort.raise} =
  { fields: positions(p.fields), lambdas: positions(p.lambdas) }

fn position_in(m: Map<Bytes, Int>, key: Bytes) -> Int / {abort.raise} =
  match m.get(key) {
    Some(i) -> i,
    None ->
      panic(
        "the compiled program's tables are missing a field, lambda or tag that its code refers to",
      ),
  }

pub type Hole = { open_position: Int, close_position: Int, kind: Int, digits: Bytes }

pub fn holes(text: Bytes) -> List<Hole> / {abort.raise} =
  iterate({ from: 0, out: [] }, text.len() + 1, |s: { from: Int, out: List<Hole> }|
    match text.index_of_from(b"@@", s.from) {
      None -> Stop(s.out),
      Some(open) -> match text.index_of_from(b"@@", open + 2) {
        None -> panic("an emitted placeholder is missing its closing `@@`"),
        Some(close) ->
          Continue({
            from: close + 2,
            out: s.out.push({
              open_position: open,
              close_position: close,
              kind: text.at(open + 2),
              digits: text.slice(open + 3, close),
            }),
          }),
      },
    })

pub fn keyed_key(k: Keyed, tables: Tables) -> Bytes / {abort.raise} =
  match k {
    KeyedTag(name) -> b"T".concat(name),
    KeyedField(i) -> b"f".concat(tables.fields.get(i)),
    KeyedEntry(i) -> b"l".concat(tables.lambdas.get(i)),
  }

pub fn keyed_of(h: Hole) -> Keyed / {abort.raise} =
  if h.kind == 84 { KeyedTag(h.digits) }
  else if h.kind == 102 { KeyedField(digits(h.digits)) }
  else if h.kind == 108 { KeyedEntry(digits(h.digits)) }
  else { panic("an emitted placeholder has a kind the compiler does not recognize") }

fn unit_position(key: Bytes, p: TablePositions, tags: Map<Bytes, Int>) -> Int / {abort.raise} = {
  let kind = key.at(0);
  let rest = key.slice(1, key.len());
  if kind == 84 { position_in(tags, rest) }
  else if kind == 102 { position_in(p.fields, rest) }
  else { position_in(p.lambdas, rest) }
}

fn part_table(label: String) -> Bytes = b"ply_part".concat(Bytes::of_string(label))

pub fn own_root(body: UnitBody) -> RootName =
  match body.tables.members.at(0) { Some(m) -> root_name(m), None -> body.name }

fn resolved(
  body: UnitBody,
  site: RootName,
  table: Bytes,
  local: Map<Bytes, Int>,
) -> Bytes / {abort.raise} = {
  let text = body.text;
  let member = |h: Hole, otherwise: RootName|
    if h.digits.len() == 0 { otherwise }
    else { root_name(body.tables.members.get(digits(h.digits))) };
  let walk_levels = holes(text).fold(
    { from: 0, out: [] },
    |s: { from: Int, out: List<Bytes> }, h: Hole| {
      let value = if h.kind == 114 { ascii_of_int(root_id(root_text(member(h, site)))) }
      else if h.kind == 115 { symbol_named(member(h, own_root(body))) } else {
        Bytes::concat_all([
          table,
          b"[",
          ascii_of_int(position_in(local, keyed_key(keyed_of(h), body.tables))),
          b"]",
        ])
      };
      {
        from: h.close_position + 2,
        out: s.out.push(text.slice(s.from, h.open_position)).push(value),
      }
    },
  );
  Bytes::concat_all(walk_levels.out.push(text.slice(walk_levels.from, text.len())))
}

type IncludedRoot = {
  name: RootName,
  arity: Int,
  symbol: Bytes,
  entry: Bytes,
  prototype: Prototype,
}

fn count_line(label: Bytes, n: Int) -> Bytes =
  Bytes::concat_all([label, b" ", ascii_of_int(n), b"\n"])

fn labelled_lines(label: Bytes, xs: List<Bytes>) -> Bytes =
  Bytes::concat_all([count_line(label, xs.len())].concat(xs.map(|x: Bytes| x.concat(b"\n"))))

fn exports_text(
  helpers: List<Native>,
  constants: List<Bytes>,
  modules: Int,
  p: Pools,
  entered: List<RootName>,
) -> Bytes =
  Bytes::concat_all([
    labelled_lines(
      b"helpers",
      helpers.map(|h: Native|
        Bytes::concat_all([
          h.name,
          b" ",
          ascii_of_int(h.params.len()),
          b" ",
          dump_flag(h.result != None),
        ])),
    ),
    labelled_lines(b"constants", constants),
    count_line(b"modules", modules),
    labelled_lines(b"fields", p.fields),
    Bytes::concat_all(
      entered.map(|r: RootName| Bytes::concat_all([b"entered ", root_text(r), b"\n"])),
    ),
  ])

fn literal_lines(line: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([c_string(line), b" \"\\n\"\n"])

fn split_lines(text: Bytes) -> List<Bytes> / {abort.raise} = {
  let parts = text.split(b"\n");
  let whole = if parts.len() > 0 && parts.get(parts.len() - 1).len() == 0 {
    parts.take(parts.len() - 1)
  } else { parts };
  whole.map(|l: Bytes|
    if l.len() > 0 && l.at(l.len() - 1) == 13 { l.slice(0, l.len() - 1) } else { l })
}

fn exports_c(exports: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\n/* --- what this unit says about itself, read by the loader --- */\n",
    b"const char ply_exports[] =\n",
    Bytes::concat_all(split_lines(exports).map(literal_lines)),
    b";\n",
  ])

fn section(label: String, c: Bytes) -> Bytes = Bytes::concat_all([part_mark(label), b"\n", c])

fn taken_struct() -> Bytes =
  b"struct ply_taken { const char *name; void *entry; unsigned long arity; };\n"

fn entries_declared(entries: List<Bytes>) -> Bytes =
  Bytes::concat_all(
    sorted_unique(entries).map(|n: Bytes| Bytes::concat_all([b"extern char ", n, b";\n"])),
  )

fn taken_part(taken: List<IncludedRoot>) -> Bytes / {abort.raise} =
  section(
    "taken",
    Bytes::concat_all([
      taken_struct(),
      entries_declared(taken.map(|t: IncludedRoot| t.entry).filter(|e: Bytes| e.len() > 0)),
      b"const struct ply_taken ply_taken[] = {\n",
      Bytes::concat_all(
        taken.map(|t: IncludedRoot|
          Bytes::concat_all([
            b"  { \"",
            escaped(root_text(t.name)),
            b"\", ",
            if t.entry.len() == 0 { b"(void *)0" } else { b"(void *)&".concat(t.entry) },
            b", ",
            ascii_of_int(t.arity),
            b" },\n",
          ])),
      ),
      b"  { 0, 0, 0 } };\n",
    ]),
  )

fn tables_part(
  parts: List<Planned>,
  lambdas: List<Bytes>,
  exports: Bytes,
  taken: Int,
  linked: Bool,
) -> Bytes / {abort.raise} =
  section(
    "tables",
    Bytes::concat_all([
      if linked { b"extern const struct ply_links ply_links;\n" } else { b"" },
      Bytes::concat_all(
        parts.filter(|p: Planned| p.places.len() > 0).map(|p: Planned|
          Bytes::concat_all([
            if linked { b"uint32_t " } else { b"const uint32_t " },
            part_table(p.label),
            b"[] = {",
            Bytes::concat_all(
              p.places.map(|n: Int| Bytes::concat_all([b" ", ascii_of_int(n), b","])),
            ),
            b" };\n",
          ])),
      ),
      entries_declared(lambdas),
      b"void *const ply_code[] = {\n",
      Bytes::concat_all(lambdas.map(|n: Bytes| Bytes::concat_all([b"  (void *)&", n, b",\n"]))),
      b"  0 };\n",
      exports_c(exports),
      taken_struct(),
      b"extern const struct ply_taken ply_taken[];\n",
      b"void ply_bind(void **fns);\n",
      b"struct ply_descriptor { const char *exports; unsigned long exports_len; void *bind; void *bind_singletons; void *const *code; unsigned long code_count; const struct ply_taken *taken; unsigned long taken_count; };\n",
      b"const struct ply_descriptor ply_descriptor = { ply_exports, sizeof ply_exports - 1, (void *)ply_bind, ",
      if linked { b"(void *)&ply_links" } else { b"(void *)0" },
      b", ply_code, ",
      ascii_of_int(lambdas.len()),
      b", ply_taken, ",
      ascii_of_int(taken),
      b" };\n",
    ]),
  )

fn fields_part(
  statics: List<StaticDefinition>,
  relocated: (StaticDefinition) -> Bool,
  constant_c: (StaticDefinition) -> Bytes / {abort.raise},
  cells: Bytes,
) -> Bytes / {abort.raise} = {
  let with_fields = statics.filter(relocated);
  let own = with_fields.fold(Map::new(), |accumulator: Map<Bytes, Bool>, d: StaticDefinition|
    accumulator.insert(d.name, true));
  if with_fields.len() == 0 && cells.len() == 0 { b"" } else {
    section(
      "fields",
      Bytes::concat_all([
        Bytes::concat_all(
          sorted_unique(
            with_fields.fold([], |accumulator: List<Bytes>, d: StaticDefinition|
              accumulator.concat(addressed(d))),
          ).filter(|n: Bytes| !own.contains(n)).map(
            static_extern,
          ),
        ),
        Bytes::concat_all(with_fields.map(constant_c)),
        cells,
      ]),
    )
  }
}

type BucketBody = { text: Bytes, statics: List<Bytes>, shared: List<SharedFunction> }

type BodyHoles = { body: UnitBody, keys: List<Bytes> }

pub type PartRule = { bits: Int, min: Int, max: Int }

pub const part_rule: PartRule = { bits: 6, min: 65536, max: 1048576 }

fn home_of(k: RootKey) -> Bytes =
  match inlined_lambdas(k).at(0) { Some(f) -> module_of(f.owner), None -> module_of(k) }

fn order_key(home: Bytes, name: RootName) -> Bytes =
  Bytes::concat_all([home, b"\x00", root_text(name)])

fn split_into_parts(bodies: List<BodyHoles>, rule: PartRule) -> List<List<BodyHoles>> = {
  let walk_levels = bodies.fold(
    { parts: [], part: [], bytes: 0 },
    |accumulator: { parts: List<List<BodyHoles>>, part: List<BodyHoles>, bytes: Int }, m: BodyHoles| {
      let size = m.body.size;
      let picked = root_id(root_text(m.body.name)) & (1 << rule.bits) - 1 == 0;
      if accumulator.part.len() > 0
          && ((accumulator.bytes >= rule.min && picked) || accumulator.bytes + size > rule.max) {
        { parts: accumulator.parts.push(accumulator.part), part: [m], bytes: size }
      } else {
        {
          parts: accumulator.parts,
          part: accumulator.part.push(m),
          bytes: accumulator.bytes + size,
        }
      }
    },
  );
  if walk_levels.part.len() == 0 { walk_levels.parts }
  else { walk_levels.parts.push(walk_levels.part) }
}

fn part_label(name: RootName) -> String / {abort.raise} =
  String::of_bytes(hex(u64_be(root_id(root_text(name)))))

type Part = {
  label: String,
  places: List<Int>,
  bodies: List<BucketBody>,
  constants: List<StaticDefinition>,
}

fn part_keys(group: List<BodyHoles>) -> List<Bytes> =
  sorted_unique(group.fold([], |accumulator: List<Bytes>, m: BodyHoles| accumulator.concat(m.keys)))

fn constants_defined(
  group: List<BodyHoles>,
  defined: Map<Bytes, Bool>,
  relocated: (StaticDefinition) -> Bool,
) -> { constants: List<StaticDefinition>, defined: Map<Bytes, Bool> } =
  group.fold(
    { constants: [], defined: defined },
    |accumulator: { constants: List<StaticDefinition>, defined: Map<Bytes, Bool> }, m: BodyHoles|
      m.body.tables.statics.fold(
        accumulator,
        |a: { constants: List<StaticDefinition>, defined: Map<Bytes, Bool> }, d: StaticDefinition|
          if relocated(d) || a.defined.contains(d.name) { a }
          else { { constants: a.constants.push(d), defined: a.defined.insert(d.name, true) } },
      ),
  )

fn reachable_names(name: RootName, tables: Tables) -> List<RootName> =
  sorted_unique_names(
    tables.calls.map(root_name).concat(if tables.members.len() == 0 { [name] }
    else { tables.members.map(root_name) }),
  )

fn prototype(symbol: Bytes, head: Prototype) -> Bytes =
  Bytes::concat_all([
    head.result,
    b" ",
    symbol,
    b"(PlyCtx*",
    Bytes::concat_all(head.params.map(|t: Bytes| b", ".concat(t))),
    b");\n",
  ])

fn part_c(
  p: Part,
  prototypes: List<Bytes>,
  natives: List<Native>,
  constant_c: (StaticDefinition) -> Bytes / {abort.raise},
) -> Bytes / {abort.raise} = {
  let defined = p.constants.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bool>, d: StaticDefinition| accumulator.insert(d.name, true),
  );
  Bytes::concat_all([
    part_mark(p.label),
    b"\n",
    if p.places.len() == 0 { b"" }
    else { Bytes::concat_all([b"extern const uint32_t ", part_table(p.label), b"[];\n"]) },
    Bytes::concat_all(
      sorted_unique(
        p.bodies.fold([], |accumulator: List<Bytes>, body: BucketBody|
          accumulator.concat(body.statics)),
      ).filter(|n: Bytes| !defined.contains(n)).map(
        static_extern,
      ),
    ),
    Bytes::concat_all(prototypes),
    Bytes::concat_all(natives.map(pointer_declared)),
    b"\n",
    Bytes::concat_all(p.constants.map(constant_c)),
    shared_functions_c(p.bodies),
    Bytes::concat_all(p.bodies.map(|body: BucketBody| body.text.concat(b"\n"))),
  ])
}

fn machine_called(
  bodies: List<UnitBody>,
  machine_of: (Map<Bytes, Bool>) -> List<Native> / {abort.raise},
) -> List<Native> / {abort.raise} = {
  let beyond = bound_functions.fold(
    natives_of(bodies),
    |accumulator: Map<Bytes, Bool>, n: Native| accumulator.remove(n.name),
  );
  if beyond.len() == 0 { [] } else { machine_of(beyond) }
}

fn shared_functions_c(group: List<BucketBody>) -> Bytes =
  group.fold(
    { seen: Map::new(), out: [] },
    |accumulator: { seen: Map<Bytes, Bool>, out: List<Bytes> }, p: BucketBody|
      p.shared.fold(
        accumulator,
        |a: { seen: Map<Bytes, Bool>, out: List<Bytes> }, f: SharedFunction|
          if a.seen.contains(f.symbol) { a }
          else { { seen: a.seen.insert(f.symbol, true), out: a.out.push(f.text) } },
      ),
  ).out.fold(b"", |accumulator: Bytes, t: Bytes| accumulator.concat(t))

fn placing(
  m: BodyHoles,
  site: RootName,
  table: Bytes,
  local: Map<Bytes, Int>,
) -> BucketBody / {abort.raise} =
  {
    text: resolved(m.body, site, table, local),
    statics: m.body.tables.statics.map(|d: StaticDefinition| d.name),
    shared: m.body.tables.shared,
  }

type Planned = {
  label: String,
  keys: List<Bytes>,
  places: List<Int>,
  group: List<BodyHoles>,
  constants: List<StaticDefinition>,
}

fn planned(
  bodies: List<BodyHoles>,
  rule: PartRule,
  position: (Bytes) -> Int / {abort.raise},
  relocated: (StaticDefinition) -> Bool,
) -> List<Planned> / {abort.raise} =
  split_into_parts(bodies, rule).fold(
    { parts: [], defined: Map::new() },
    |accumulator: { parts: List<Planned>, defined: Map<Bytes, Bool> }, group: List<BodyHoles>| {
      let keys = part_keys(group);
      let c = constants_defined(group, accumulator.defined, relocated);
      {
        parts: accumulator.parts.push({
          label: part_label(group.get(0).body.name),
          keys: keys,
          places: keys.map(position),
          group: group,
          constants: c.constants,
        }),
        defined: c.defined,
      }
    },
  ).parts

fn part_written(
  p: Planned,
  site: (RootName) -> RootName / {abort.raise},
  taken: Map<RootName, IncludedRoot>,
  machine: List<Native>,
  constant_c: (StaticDefinition) -> Bytes / {abort.raise},
  foreign: Map<RootName, Prototype>,
) -> WrittenPart / {abort.raise} = {
  let prototypes = sorted_unique_names(
    p.group.fold([], |accumulator: List<RootName>, m: BodyHoles|
      accumulator.concat(reachable_names(m.body.name, m.body.tables))),
  ).map(|name: RootName|
    match taken.get(name) {
      Some(t) -> prototype(t.symbol, t.prototype),
      None -> match foreign.get(name) {
        Some(head) -> slot_declared(symbol_named(name), head),
        None -> b"",
      },
    });
  let called = p.group.fold(Map::new(), |accumulator: Map<Bytes, Bool>, m: BodyHoles|
    m.body.tables.natives.fold(accumulator, |x: Map<Bytes, Bool>, n: Bytes| x.insert(n, true)));
  let natives = machine.filter(|n: Native| called.contains(n.name));
  let local = positions(p.keys);
  let bodies = p.group.map(|m: BodyHoles|
    placing(m, site(m.body.name), part_table(p.label), local));
  written_part(
    unit_header,
    p.label,
    part_c(
      { label: p.label, places: p.places, bodies: bodies, constants: p.constants },
      prototypes,
      natives,
      constant_c,
    ),
  )
}

pub fn produce(
  constructors: List<Constructor>,
  offered: List<RequestedRoot>,
  modules: Int,
  results: Map<RootName, Output>,
  inputs: Map<Bytes, Bytes>,
  machine_of: (Map<Bytes, Bool>) -> List<Native> / {abort.raise},
  rule: PartRule,
  foreign: Option<Map<RootName, Prototype>> = None,
) -> UnitOutput / {abort.raise} = {
  let linked = foreign != None;
  let outside = match foreign { Some(m) -> m, None -> Map::new() };
  let offers = offered.fold(
    Map::new(),
    |accumulator: Map<RootName, RequestedRoot>, o: RequestedRoot| accumulator.insert(o.name, o),
  );
  let offer_of = |n: RootName|
    match offers.get(n) {
      Some(o) -> o,
      None -> panic("every body in the compiled program must have been requested"),
    };
  let names = sorted_unique_names(offered.map(|o: RequestedRoot| o.name));
  let s = taken_bodies(results, names, outside);
  let machine = machine_called(s.bodies, machine_of);
  let published = |n: RootName|
    match s.defined.get(n) {
      Some(d) -> d,
      None ->
        panic(
          "every definition in the compiled program must have generated C code, but one has none",
        ),
    };
  let entry = |n: RootName| entry_defined(n, published(n));
  let constants = names.filter(|n: RootName|
    match offers.get(n) { Some(o) -> o.constant, None -> false });
  let statics = ordered_statics(s.bodies);
  let elsewhere = |k: RootKey| outside.contains(root_name(k));
  let relocated = |d: StaticDefinition| has_fields(d) || entries_of(d).any(elsewhere);
  let pools = own_entries_of(
    pools_of(s.bodies, statics, constants.map(|n: RootName| { name: n, entry: entry(n) })),
    outside,
  );
  let placed = table_positions(pools);
  let constant_c = |d: StaticDefinition|
    static_c(
      d,
      |f: Bytes| position_in(placed.fields, f),
      |k: RootKey| symbol_named(root_name(k)),
      |digest: Bytes|
        match inputs.get(digest) {
          Some(b) -> b,
          None ->
            panic(
              "the compiled program embeds a file whose contents were not supplied, but the build must supply the contents of every file the program embeds",
            ),
        },
      linking: if linked && relocated(d) { Some(elsewhere) } else { None },
    );
  let taken = names.map(|n: RootName|
    {
      name: n,
      arity: match offers.get(n) { Some(o) -> o.arity, None -> 0 },
      symbol: symbol_named(n),
      entry: entry(n),
      prototype: published(n).head,
    });
  s.bodies.fold((), |_u: Unit, k: UnitBody|
    k.tables.generics.expects.fold((), |_v: Unit, e: ExpectedPrototype|
      match callee_name(k.tables, e) {
        None -> (),
        Some(callee) -> match s.defined.get(callee) {
          Some(d) -> if d.head != e.head {
            panic(
              String::of_bytes_lossy(
                Bytes::concat_all([
                  b"`",
                  root_text(k.name),
                  b"` calls `",
                  root_text(callee),
                  b"` as ",
                  prototype(symbol_named(callee), e.head),
                  b"which it defines as ",
                  prototype(symbol_named(callee), d.head),
                ]),
              ),
            )
          } else { () },
          None -> (),
        },
      }));
  let marked = s.bodies.fold(
    Map::new(),
    |accumulator: Map<Bytes, BodyHoles>, k: UnitBody|
      accumulator.insert(order_key(offer_of(k.name).home, k.name), {
        body: k,
        keys: k.tables.keyed.map(|x: Keyed| keyed_key(x, k.tables)),
      }),
  ).values(
  );
  let tagged = marked.fold(Map::new(), |found: Map<Bytes, Bool>, m: BodyHoles|
    m.keys.fold(found, |f: Map<Bytes, Bool>, k: Bytes|
      if k.at(0) == 84 { f.insert(k.slice(1, k.len()), true) } else { f }));
  let tags = positions(
    constructors.map(|c: Constructor| c.name).filter(|name: Bytes| tagged.contains(name)),
  );
  let plans = planned(
    marked,
    rule,
    |k: Bytes| if linked { 0 } else { unit_position(k, placed, tags) },
    relocated,
  );
  let exports = exports_text(
    bound_functions.concat(machine),
    constants.map(|n: RootName|
      Bytes::concat_all([root_text(n), b" ", ascii_of_int(position_in(placed.lambdas, entry(n)))])),
    modules,
    pools,
    offered.filter(|o: RequestedRoot| o.name == entry_name(o.site)).map(|o: RequestedRoot| o.site),
  );
  let by_name = taken.fold(
    Map::new(),
    |accumulator: Map<RootName, IncludedRoot>, t: IncludedRoot| accumulator.insert(t.name, t),
  );
  let written = plans.map(|p: Planned|
    part_written(p, |n: RootName| offer_of(n).site, by_name, machine, constant_c, outside));
  let tail = [
    { label: "runtime", text: unit_tail(machine) },
    {
      label: "fields",
      text: fields_part(statics, relocated, constant_c, if linked {
        cells_of(statics.filter(relocated), outside)
      } else { b"" }),
    },
    { label: "taken", text: taken_part(by_name.values()) },
    { label: "tables", text: tables_part(plans, pools.lambdas, exports, by_name.len(), linked) },
    { label: "links", text: if linked { links_part(plans, pools.lambdas, by_name) } else { b"" } },
  ].filter(|s: { label: String, text: Bytes }| s.text.len() > 0).map(
    |s: { label: String, text: Bytes }| written_part(unit_header, s.label, s.text),
  );
  { parts: written.concat(tail), taken: names, made: { bodies: s.bodies, requested: offered } }
}

fn own_entries_of(pools: Pools, foreign: Map<RootName, Prototype>) -> Pools / {abort.raise} = {
  let theirs = foreign.fold(Map::new(), |m: Map<Bytes, Bool>, n: RootName, _: Prototype|
    m.insert(entry_symbol(root_text(n)), true));
  { ..pools, lambdas: pools.lambdas.filter(|l: Bytes| !theirs.contains(l)) }
}

fn slot_of(symbol: Bytes) -> Bytes = b"ply_slot_".concat(symbol)

fn slot_declared(symbol: Bytes, head: Prototype) -> Bytes =
  Bytes::concat_all([
    b"extern ",
    prototype(Bytes::concat_all([b"(*", slot_of(symbol), b")"]), head),
    b"#define ",
    symbol,
    b" (*",
    slot_of(symbol),
    b")\n",
  ])

fn name_rows(table: Bytes, rows: List<{ name: Bytes, cell: Bytes }>) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"const struct ply_name_cell ",
    table,
    b"[] = {\n",
    Bytes::concat_all(
      rows.map(|r: { name: Bytes, cell: Bytes }|
        Bytes::concat_all([b"  { \"", escaped(r.name), b"\", (void *)", r.cell, b" },\n"])),
    ),
    b"  { 0, 0 } };\n",
  ])

const name_cell_struct: Bytes = b"struct ply_name_cell { const char *name; void *cell; };\n"

fn cells_of(
  relocated: List<StaticDefinition>,
  foreign: Map<RootName, Prototype>,
) -> Bytes / {abort.raise} = {
  let cells = relocated.fold([], |accumulator: List<StaticCell>, d: StaticDefinition|
    accumulator.concat(static_cells(d)));
  let slot_cells = foreign.keys().map(|n: RootName|
    { name: symbol_named(n), cell: b"&".concat(slot_of(symbol_named(n))) });
  let entry_cells = cells.fold(
    [],
    |accumulator: List<{ name: Bytes, cell: Bytes }>, c: StaticCell|
      match c.word {
        EntryWord(k) -> if foreign.contains(root_name(k)) {
          accumulator.push({ name: symbol_named(root_name(k)), cell: b"&".concat(c.cell) })
        } else { accumulator },
        _ -> accumulator,
      },
  );
  let field_cells = cells.fold(
    [],
    |accumulator: List<{ name: Bytes, cell: Bytes }>, c: StaticCell|
      match c.word {
        FieldWord(f) -> accumulator.push({ name: f, cell: b"&".concat(c.cell) }),
        _ -> accumulator,
      },
  );
  Bytes::concat_all([
    name_cell_struct,
    Bytes::concat_all(
      foreign.keys().map(|n: RootName|
        Bytes::concat_all([b"void *", slot_of(symbol_named(n)), b";\n"])),
    ),
    name_rows(b"ply_slots", slot_cells.concat(entry_cells)),
    name_rows(b"ply_field_words", field_cells),
  ])
}

fn links_part(
  plans: List<Planned>,
  lambdas: List<Bytes>,
  own: Map<RootName, IncludedRoot>,
) -> Bytes / {abort.raise} = {
  let keys = plans.fold([], |accumulator: List<{ name: Bytes, cell: Bytes }>, p: Planned|
    range(0, p.keys.len()).fold(accumulator, |a: List<{ name: Bytes, cell: Bytes }>, i: Int|
      a.push({
        name: p.keys.get(i),
        cell: Bytes::concat_all([b"&", part_table(p.label), b"[", ascii_of_int(i), b"]"]),
      })));
  let defined = own.values();
  section(
    "links",
    Bytes::concat_all([
      name_cell_struct,
      b"extern const struct ply_name_cell ply_slots[];\n",
      b"extern const struct ply_name_cell ply_field_words[];\n",
      Bytes::concat_all(defined.map(|t: IncludedRoot| prototype(t.symbol, t.prototype))),
      Bytes::concat_all(
        plans.filter(|p: Planned| p.places.len() > 0).map(|p: Planned|
          Bytes::concat_all([b"extern uint32_t ", part_table(p.label), b"[];\n"])),
      ),
      name_rows(
        b"ply_exported",
        defined.map(|t: IncludedRoot| { name: t.symbol, cell: b"&".concat(t.symbol) }),
      ),
      name_rows(b"ply_keys", keys),
      b"const char *const ply_code_names[] = {\n",
      Bytes::concat_all(lambdas.map(|l: Bytes| Bytes::concat_all([b"  \"", escaped(l), b"\",\n"]))),
      b"  0 };\n",
      b"struct ply_links { const struct ply_name_cell *slots, *exported, *keys, *field_words; const char *const *code_names; };\n",
      b"const struct ply_links ply_links = { ply_slots, ply_exported, ply_keys, ply_field_words, ply_code_names };\n",
    ]),
  )
}

fn offered_as_shared(
  offered: List<RequestedRoot>,
  c: { key: RootKey, home: Bytes },
) -> RequestedRoot / {abort.raise} =
  match offered.find(|o: RequestedRoot| o.site == site_owner(c.key)) {
    Some(o) -> { ..o, key: c.key, name: root_name(c.key), home: c.home },
    None -> panic("a shared body has no root that requested it"),
  }

fn produced_from_codes(
  codes: List<UnitCode>,
  constructors: List<Constructor>,
  modules: Int,
  inputs: Map<Bytes, Bytes>,
  foreign: Option<Map<RootName, Prototype>>,
  rule: PartRule,
) -> UnitOutput / {abort.raise} = {
  let offered = codes.fold([], |accumulator: List<RequestedRoot>, c: UnitCode|
    accumulator.concat(c.requested));
  let results = codes.fold(Map::new(), |accumulator: Map<RootName, Output>, c: UnitCode|
    results_by_name(c.results).fold(
      accumulator,
      |m: Map<RootName, Output>, n: RootName, a: Output| m.insert(n, a),
    ));
  let keys = offered.fold(Map::new(), |m: Map<RootName, RootKey>, o: RequestedRoot|
    m.insert(o.name, o.key));
  let sharing = if foreign != None { { results: results, keys: keys, coded: [] } }
  else { compiled(results, keys) };
  produce(
    constructors,
    offered.concat(
      sharing.coded.map(|c: { key: RootKey, home: Bytes }| offered_as_shared(offered, c)),
    ),
    modules,
    sharing.results,
    inputs,
    |called: Map<Bytes, Bool>|
      codes.fold(Map::new(), |accumulator: Map<Bytes, Native>, c: UnitCode|
        extern_natives(c.externs).fold(accumulator, |m: Map<Bytes, Native>, n: Native|
          if called.contains(n.name) { m.insert(n.name, n) } else { m })).values(
      ),
    rule,
    foreign: foreign,
  )
}

pub fn part_library(
  codes: List<UnitCode>,
  foreign: Map<RootName, Prototype>,
  inputs: Map<Bytes, Bytes>,
) -> UnitOutput / {abort.raise} =
  produced_from_codes(codes, [], 1, inputs, Some(foreign), {
    bits: part_rule.bits,
    min: library_part_size,
    max: library_part_size,
  })

pub fn program_output(
  codes: List<UnitCode>,
  constructors: List<Bytes>,
  modules: Int,
  inputs: Map<Bytes, Bytes>,
) -> UnitOutput / {abort.raise} =
  produced_from_codes(
    codes,
    constructors.map(|name: Bytes| { name: name, arity: 0 }),
    modules,
    inputs,
    None,
    part_rule,
  )

pub fn whole_program_text(
  codes: List<UnitCode>,
  constructors: List<Bytes>,
  modules: Int,
  inputs: Map<Bytes, Bytes>,
) -> Bytes / {abort.raise} = unit_text(program_output(codes, constructors, modules, inputs).parts)

const library_part_size: Int = 1 << 60

pub fn generated_c(parts: List<WrittenPart>) -> GeneratedC = { head: unit_header, files: parts }

pub type Program = {
  roots: Map<RootName, EmitterRoot>,
  keys: Map<RootName, Bytes>,
  modules: List<ModuleRow>,
  imports: Map<Bytes, List<Bytes>>,
  read: Map<Bytes, List<Bytes>>,
  embeds: Map<Int, Bytes>,
  schemes: Map<Bytes, Scheme>,
  binders: Map<RootName, List<Type>>,
  declared: Map<Bytes, Bytes>,
  digests: Map<Bytes, Bytes>,
  constructor_functions: Map<Bytes, Bool>,
}

pub type LoweringInput = {
  roots: Map<RootName, EmitterRoot>,
  schemes: Map<Bytes, Scheme>,
  binders: Map<RootName, List<Type>>,
}

pub fn lowering_input(
  roots: List<KeyedRoot>,
  definitions: List<KnownDefinitionRow>,
  laws: List<LawBinders>,
) -> LoweringInput / {abort.raise} =
  {
    roots: roots.fold(Map::new(), |found: Map<RootName, EmitterRoot>, k: KeyedRoot|
      found.insert(root_name(k.key), k.root)),
    schemes: definitions.fold(Map::new(), |found: Map<Bytes, Scheme>, row: KnownDefinitionRow|
      found.insert(row.name, row.scheme)),
    binders: laws.fold(Map::new(), |found: Map<RootName, List<Type>>, l: LawBinders|
      [LawGuard, LawBody].fold(found, |m: Map<RootName, List<Type>>, part: LawPart|
        m.insert(root_name(law_key(l.module, l.name, part)), l.types))),
  }

pub fn lowering_input_of(dump: Dump) -> LoweringInput / {abort.raise} =
  keyed_lowering_input(dump, roots_by_row_name(dump))

fn keyed_lowering_input(dump: Dump, keys: Map<Bytes, RootKey>) -> LoweringInput / {abort.raise} =
  lowering_input(
    dump.emitter_roots.fold([], |found: List<KeyedRoot>, root: EmitterRoot|
      match keys.get(root.root) { Some(k) -> found.push({ key: k, root: root }), None -> found }),
    dump.rows.definitions,
    dump.laws.map(|l: LawRow|
      { module: l.module, name: l.name, types: l.binders.map(|b: BinderRow| b.ty) }),
  )

pub fn program_of(
  dump: Dump,
  sources: List<Bytes>,
  roots: List<RootKey>,
) -> Program / {abort.raise} = {
  let results_and_keys = roots_by_row_name(dump);
  let input = keyed_lowering_input(dump, results_and_keys);
  let named = |row: Bytes|
    match results_and_keys.get(row) { Some(k) -> Some(root_name(k)), None -> None };
  let by_name = dump.modules.fold(Map::new(), |accumulator: Map<Bytes, ModuleRow>, m: ModuleRow|
    accumulator.insert(m.name, m));
  let read = modules_read(by_name, modules_lowered(roots).keys().push(prelude_module));
  let reads = dump.embeds.fold(Map::new(), |accumulator: Map<Int, List<Bytes>>, e: ModuleEmbed|
    match by_name.get(e.module) {
      None -> accumulator,
      Some(m) ->
        accumulator.insert(
          m.index,
          List::push(
            match accumulator.get(m.index) { Some(xs) -> xs, None -> [] },
            length_prefixed(e.key).concat(embed_read_digest(e.read)),
          ),
        ),
    });
  {
    roots: input.roots,
    keys: dump.keys.fold(Map::new(), |accumulator: Map<RootName, Bytes>, k: KeyRow|
      match named(k.root) { Some(n) -> accumulator.insert(n, k.key), None -> accumulator }),
    modules: dump.ordinals.fold([], |accumulator: List<ModuleRow>, o: OrdinalRow|
      match by_name.get(o.module) { Some(m) -> accumulator.push(m), None -> accumulator }),
    imports: by_name.fold(
      Map::new(),
      |accumulator: Map<Bytes, List<Bytes>>, n: Bytes, m: ModuleRow|
        accumulator.insert(n, m.imports),
    ),
    read: read,
    embeds: reads.fold(Map::new(), |accumulator: Map<Int, Bytes>, i: Int, parts: List<Bytes>|
      accumulator.insert(i, blake3(Bytes::concat_all(sorted_unique(parts))))),
    schemes: input.schemes,
    binders: input.binders,
    declared: {
      let types = dump.types.fold(Map::new(), |accumulator: Map<Bytes, Bool>, t: TypeRow|
        accumulator.insert(t.name, true));
      dump.hashes.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, f: HashTableRow|
        match f {
          DefinitionHashRow(row) -> match row.declaration {
            Some(h) -> if types.contains(row.name) { accumulator.insert(row.name, h) }
            else { accumulator },
            None -> accumulator,
          },
          _ -> accumulator,
        })
    },
    digests: read.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, m: Bytes, _: List<Bytes>|
      match match by_name.get(m) { Some(row) -> sources.at(row.index), None -> None } {
        Some(t) -> accumulator.insert(m, blake3(t)),
        None -> accumulator,
      }),
    constructor_functions: stated_functions(dump),
  }
}

fn modules_read(
  by_name: Map<Bytes, ModuleRow>,
  starts: List<Bytes>,
) -> Map<Bytes, List<Bytes>> / {abort.raise} = {
  let dependencies = |m: Bytes|
    match by_name.get(m) { Some(row) -> row.imports.concat(row.unimported), None -> [] };
  iterate(
    { read: Map::new(), next: starts.filter(|m: Bytes| by_name.contains(m)) },
    by_name.len() + 1,
    |s: { read: Map<Bytes, List<Bytes>>, next: List<Bytes> }| {
      let read = s.next.fold(s.read, |accumulator: Map<Bytes, List<Bytes>>, m: Bytes|
        if accumulator.contains(m) { accumulator } else { accumulator.insert(m, dependencies(m)) });
      let next = s.next.fold([], |accumulator: List<Bytes>, m: Bytes|
        if s.read.contains(m) { accumulator } else {
          (match read.get(m) { Some(ds) -> ds, None -> [] }).fold(
            accumulator,
            |a: List<Bytes>, d: Bytes|
              if read.contains(d) || !by_name.contains(d) { a } else { a.push(d) },
          )
        });
      if next.len() == 0 { Stop({ read: read, next: [] }) }
      else { Continue({ read: read, next: next }) }
    },
  ).read
}

pub fn types_keyed(k: RootKey) -> List<Type> =
  match k {
    Specialisation(_, _) ->
      inlined_lambdas(k).fold(key_types(k), |accumulator: List<Type>, f: InlinedLambda|
        accumulator.concat(types_keyed(f.owner))),
    Generated(w, _) -> [w.ty],
    Clause(c) -> types_keyed(c.definition),
    EntryPoint(e) -> types_keyed(e),
    _ -> [],
  }

fn stated_functions(dump: Dump) -> Map<Bytes, Bool> =
  dump.emitter_constructors.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bool>, c: EmitterConstructor|
      [c.key, c.show].fold(
        c.numeric.fold(accumulator, |m: Map<Bytes, Bool>, f: Bytes| m.insert(f, true)),
        |m: Map<Bytes, Bool>, f: Option<Bytes>| match f { Some(n) -> m.insert(n, true), None -> m },
      ),
  )

type Body = { text: Bytes, shared: List<SharedFunction> }

derive bin for Body

fn output_body(a: Output) -> Body = { text: a.text, shared: a.tables.shared }

fn summarised(a: Output) -> Output = { text: b"", tables: { ..a.tables, shared: [] } }

fn body_digest(a: Output) -> Bytes / {abort.raise} = blake3(bin::encode(output_body(a), body_bin()))

fn batch_count() -> Int = 64

type Batch = { weight: Int, roots: List<RootKey> }

const type_root_weight: Int = 256

fn batches(p: Program, missed: List<RootKey>) -> List<List<RootKey>> / {abort.raise} = {
  let weight = |k: RootKey|
    match p.roots.get(site_owner(k)) { Some(r) -> r.at.end - r.at.start, None -> type_root_weight };
  let together = missed.fold(Map::new(), |accumulator: Map<Bytes, Batch>, k: RootKey| {
    let d = batch_key(k);
    let had = match accumulator.get(d) { Some(x) -> x, None -> { weight: 0, roots: [] } };
    accumulator.insert(d, { weight: had.weight + weight(k), roots: had.roots.push(k) })
  });
  let heaviest_first = together.values().sort_by(|a: Batch, b: Batch| a.weight >= b.weight);
  let batches = heaviest_first.fold([], |accumulator: List<Batch>, m: Batch|
    if accumulator.len() < batch_count() { accumulator.push(m) } else {
      let lightest = range(0, accumulator.len()).fold(0, |best: Int, i: Int|
        if accumulator.get(i).weight < accumulator.get(best).weight { i } else { best });
      range(0, accumulator.len()).map(|i: Int| {
        let piece = accumulator.get(i);
        if i == lightest { { weight: piece.weight + m.weight, roots: piece.roots.concat(m.roots) } }
        else { piece }
      })
    });
  batches.map(|piece: Batch| piece.roots)
}

fn merged_ownership(
  ownership: Map<RootName, OwnershipSignature>,
  results: Map<RootName, Output>,
) -> Map<RootName, OwnershipSignature> =
  results.fold(
    ownership,
    |accumulator: Map<RootName, OwnershipSignature>, _: RootName, a: Output|
      signatures_from(a.tables.handings).fold(
        accumulator,
        |m: Map<RootName, OwnershipSignature>, n: RootName, h: OwnershipSignature| m.insert(n, h),
      ),
  )

fn published_signatures(
  before: Map<RootName, PublishedSignature>,
  results: Map<RootName, Output>,
) -> Map<RootName, PublishedSignature> =
  results.fold(before, |accumulator: Map<RootName, PublishedSignature>, _: RootName, a: Output|
    a.tables.handings.fold(
      accumulator,
      |m: Map<RootName, PublishedSignature>, h: PublishedSignature| m.insert(h.definition, h),
    ))

fn written_stale(a: Output, published: Map<RootName, PublishedSignature>) -> Bool =
  a.tables.assumed.any(|x: PublishedSignature|
    match published.get(x.definition) { Some(h) -> h != x, None -> false })

fn stale_of(
  results: Map<RootName, Output>,
  published: Map<RootName, PublishedSignature>,
  keys: Map<RootName, RootKey>,
) -> List<RootKey> =
  results.fold([], |accumulator: List<RootKey>, n: RootName, a: Output|
    if !written_stale(a, published) { accumulator } else {
      let own = match keys.get(n) { Some(k) -> [k], None -> [] };
      let group = a.tables.group;
      own.concat(group).fold(accumulator, |xs: List<RootKey>, g: RootKey|
        if xs.contains(g) { xs } else { xs.push(g) })
    })

fn module_levels(p: Program) -> Map<Bytes, Int> / {abort.raise} =
  iterate(Map::new(), p.read.len() + 2, |at: Map<Bytes, Int>| {
    let next = p.read.fold(
      Map::new(),
      |accumulator: Map<Bytes, Int>, m: Bytes, dependencies: List<Bytes>|
        accumulator.insert(
          m,
          dependencies.fold(0, |n: Int, d: Bytes| {
            let past = match at.get(d) { Some(l) -> l + 1, None -> 0 };
            if past > n { past } else { n }
          }),
        ),
    );
    if next == at { Stop(next) } else { Continue(next) }
  })

fn owning_module(k: RootKey) -> Bytes =
  match inlined_lambdas(k).at(0) { Some(f) -> module_of(f.owner), None -> module_of(k) }

fn batch_key(k: RootKey) -> Bytes =
  match k {
    Specialisation(a, _) -> if a.borrowed.len() > 0 { owning_module(k) } else { a.definition },
    Generated(_, _) -> root_text(root_name(k)),
    _ -> owning_module(k),
  }

pub type LevelTally = {
  place: Int,
  places: Int,
  roots: Int,
  cached: Int,
  emitter_requests: Int,
  steps: Int,
  began: Int,
  ended: Int,
}

pub const entered_timeout_ms: Int = 60000

pub fn enters(input: LoweringInput, root: RootKey) -> Bool / {EmitReads} = {
  runtime_enters(input, marshalling_of(entered_types(input, root)), root)
}

pub type RootSummary = { key: RootKey, calls: List<RootKey>, head: Option<Prototype> }

pub type UnitSummary = {
  published: List<PublishedSignature>,
  needs: Map<RootName, List<Need>>,
  called: Map<RootName, List<Int>>,
  roots: List<RootSummary>,
  failure: Option<Bytes>,
}

pub type UnitCode = {
  results: List<RootOutput>,
  requested: List<RequestedRoot>,
  externs: List<Extern>,
}

derive bin for RootSummary

derive bin for UnitSummary

derive bin for UnitCode

pub type LoweredUnit = { code: UnitCode, summary: UnitSummary }

pub type LoweredBatch = { results: List<RootOutput>, input: LoweringInput }

pub type CalleeFacts = {
  published: Map<RootName, PublishedSignature>,
  ownership: Map<RootName, OwnershipSignature>,
  needs: Map<RootName, List<Need>>,
  called: Map<RootName, List<Int>>,
  read: Map<RootName, Bool>,
}

pub const no_callee_facts: CalleeFacts =
  {
    published: Map::new(),
    ownership: Map::new(),
    needs: Map::new(),
    called: Map::new(),
    read: Map::new(),
  }

pub fn with_callee(facts: CalleeFacts, s: UnitSummary) -> CalleeFacts =
  {
    published: s.published.fold(
      facts.published,
      |m: Map<RootName, PublishedSignature>, h: PublishedSignature| m.insert(h.definition, h),
    ),
    ownership: signatures_from(s.published).fold(
      facts.ownership,
      |m: Map<RootName, OwnershipSignature>, n: RootName, h: OwnershipSignature| m.insert(n, h),
    ),
    needs: s.needs.fold(facts.needs, |m: Map<RootName, List<Need>>, n: RootName, x: List<Need>|
      m.insert(n, x)),
    called: s.called.fold(facts.called, |m: Map<RootName, List<Int>>, n: RootName, x: List<Int>|
      m.insert(n, x)),
    read: facts.read,
  }

type UnitWalk<s> = {
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
  batches: Map<RootName, LoweredBatch>,
  facts: CalleeFacts,
  needs: Map<RootName, List<Need>>,
  called: Map<RootName, List<Int>>,
  state: s,
}

fn callees_named(a: Output) -> List<RootKey> =
  a.tables.calls.concat(a.tables.generics.calls.map(|g: GenericCall| g.callee)).map(unspecialised)

fn with_lowered<s>(
  w: UnitWalk<s>,
  requested: List<RootKey>,
  state: s,
  batches: List<LoweredBatch>,
) -> UnitWalk<s> =
  batches.fold(
    {
      ..w,
      state: state,
      keys: requested.fold(w.keys, |m: Map<RootName, RootKey>, k: RootKey|
        m.insert(root_name(k), k)),
    },
    |walk: UnitWalk<s>, b: LoweredBatch| {
      let made = results_by_name(b.results);
      {
        ..walk,
        results: made.fold(walk.results, |m: Map<RootName, Output>, n: RootName, a: Output|
          m.insert(n, a)),
        batches: made.fold(
          walk.batches,
          |m: Map<RootName, LoweredBatch>, n: RootName, _: Output| m.insert(n, b),
        ),
      }
    },
  )

pub fn unit_lowered<s | e>(
  roots: List<RootKey>,
  start: s,
  ask: (s, List<RootKey>, Map<RootName, OwnershipSignature>) -> { state: s, batches: List<LoweredBatch> } / {abort.raise | e},
  callees_read: (CalleeFacts, List<RootKey>) -> CalleeFacts / {abort.raise | e},
  belongs: (RootKey) -> Bool / {abort.raise | e},
  natives_here: (s) -> List<Extern> / {abort.raise | e},
) -> LoweredUnit / {EmitReads | e} = {
  let seeded = callees_read(no_callee_facts, roots.map(unspecialised));
  let first = ask(start, roots, seeded.ownership);
  let settled = iterate(
    with_lowered(
      {
        results: Map::new(),
        keys: Map::new(),
        batches: Map::new(),
        facts: seeded,
        needs: Map::new(),
        called: Map::new(),
        state: first.state,
      },
      roots,
      first.state,
      first.batches,
    ),
    66,
    |w: UnitWalk<s>| {
      let facts = w.results.fold(w.facts, |f: CalleeFacts, _: RootName, a: Output|
        callees_read(f, callees_named(a)));
      let published = published_signatures(facts.published, w.results);
      let names = w.results.keys();
      let bodies = generic_bodies(w.results, w.keys, names);
      let needs = extended_needs(bodies, facts.needs);
      let called = extended_called(bodies, facts.called);
      let more = names.fold(Map::new(), |accumulator: Map<RootName, RootKey>, n: RootName|
        match ((w.results.get(n), w.batches.get(n))) {
          (Some(b), Some(_)) -> if specialised_by_callers(w.keys, n, b.tables, needs) {
            accumulator
          } else {
            b.tables.generics.calls.fold(accumulator, |m: Map<RootName, RootKey>, g: GenericCall| {
              let root = call_specialisation(g, needs, called);
              let name = root_name(root);
              if w.results.contains(name) || m.contains(name) || !belongs(root) { m }
              else { m.insert(name, root) }
            })
          },
          _ -> accumulator,
        });
      let stale = stale_of(w.results, published, w.keys);
      let asking = more.values().concat(stale);
      let walked = { ..w, facts: facts, needs: needs, called: called };
      if asking.len() == 0 { Stop(walked) } else {
        let got = ask(w.state, asking, merged_ownership(facts.ownership, w.results));
        Continue(with_lowered(walked, asking, got.state, got.batches))
      }
    },
  );
  unit_finished(settled, natives_here(settled.state))
}

fn unit_finished<s>(w: UnitWalk<s>, natives_here: List<Extern>) -> LoweredUnit / {EmitReads} = {
  let resolved = generic_calls_specialised(w.results, w.keys, w.needs, w.called);
  let outputs = with_unemitted_rejected(resolved.results, w.keys, resolved.unemitted);
  let finished = outputs.fold(
    Map::new(),
    |accumulator: Map<RootName, Output>, n: RootName, a: Output|
      accumulator.insert(n, named_output(resolved.named, n, a)),
  );
  let distinct_outputs = finished.fold(
    { seen: Map::new(), out: [] },
    |accumulator: { seen: Map<RootName, Bool>, out: List<RootOutput> }, n: RootName, a: Output|
      if accumulator.seen.contains(n) { accumulator } else {
        {
          seen: a.tables.members.map(root_name).fold(
            accumulator.seen.insert(n, true),
            |m: Map<RootName, Bool>, x: RootName| m.insert(x, true),
          ),
          out: accumulator.out.push({ name: n, result: a }),
        }
      },
  ).out;
  let called_natives = finished.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bool>, _: RootName, a: Output|
      a.tables.natives.fold(accumulator, |m: Map<Bytes, Bool>, n: Bytes| m.insert(n, true)),
  );
  {
    code: {
      results: distinct_outputs,
      requested: w.keys.fold([], |accumulator: List<RequestedRoot>, n: RootName, k: RootKey|
        match w.batches.get(n) {
          Some(b) -> if finished.contains(n) {
            accumulator.push(requested_root(b.input, k, home_of(k)))
          } else { accumulator },
          None -> accumulator,
        }),
      externs: called_externs(called_natives, natives_here).fold(
        Map::new(),
        |m: Map<Bytes, Extern>, x: Extern| m.insert(x.name, x),
      ).values(
      ),
    },
    summary: {
      published: published_signatures(Map::new(), w.results).values(),
      needs: w.keys.fold(
        Map::new(),
        |accumulator: Map<RootName, List<Need>>, n: RootName, _: RootKey|
          match w.needs.get(n) {
            Some(ns) -> if ns.len() == 0 { accumulator } else { accumulator.insert(n, ns) },
            None -> accumulator,
          },
      ),
      called: w.keys.fold(
        Map::new(),
        |accumulator: Map<RootName, List<Int>>, n: RootName, _: RootKey|
          match w.called.get(n) {
            Some(cs) -> if cs.len() == 0 { accumulator } else { accumulator.insert(n, cs) },
            None -> accumulator,
          },
      ),
      roots: w.keys.fold([], |accumulator: List<RootSummary>, n: RootName, k: RootKey|
        match finished.get(n) {
          Some(a) ->
            accumulator.push({
              key: k,
              calls: a.tables.calls,
              head: match a.tables.defined.at(0) {
                Some(_) -> Some(defined_symbol(n, a.tables).head),
                None -> None,
              },
            }),
          None -> accumulator,
        }),
      failure: None,
    },
  }
}

fn requested_root(p: LoweringInput, k: RootKey, home: Bytes) -> RequestedRoot =
  match k {
    EntryPoint(_) ->
      { key: k, name: root_name(k), arity: 0, constant: false, site: site_owner(k), home: home },
    _ -> match p.roots.get(site_owner(k)) {
      Some(r) ->
        {
          key: k,
          name: root_name(k),
          arity: r.arity,
          constant: r.pure && r.arity == 0
            && (match k { Specialisation(_, _) -> false, Coded(_) -> false, _ -> true }),
          site: site_owner(k),
          home: home,
        },
      None ->
        { key: k, name: root_name(k), arity: 0, constant: false, site: site_owner(k), home: home },
    },
  }

fn specialised_definition(keys: Map<RootName, RootKey>, n: RootName) -> Option<Bytes> =
  match keys.get(n) {
    Some(Specialisation(a, _)) -> Some(a.definition),
    Some(Coded(c)) -> Some(c.definition),
    _ -> None,
  }

fn generic_bodies(
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
  names: List<RootName>,
) -> Map<RootName, Tables> =
  names.fold(Map::new(), |accumulator: Map<RootName, Tables>, n: RootName|
    match results.get(n) {
      Some(b) -> if specialised_definition(keys, n) == None { accumulator.insert(n, b.tables) }
      else { accumulator },
      _ -> accumulator,
    })

fn extended_needs(
  bodies: Map<RootName, Tables>,
  closed: Map<RootName, List<Need>>,
) -> Map<RootName, List<Need>> / {abort.raise} = {
  let start = bodies.fold(
    closed,
    |accumulator: Map<RootName, List<Need>>, n: RootName, t: Tables|
      accumulator.insert(n, t.generics.needs),
  );
  let needs_count = |needs: Map<RootName, List<Need>>|
    bodies.fold(0, |c: Int, n: RootName, _: Tables|
      c + (match needs.get(n) { Some(ns) -> ns.len(), None -> 0 }));
  let most = bodies.fold(1, |accumulator: Int, _: RootName, t: Tables|
    accumulator + 2 * t.generics.calls.fold(1, |n: Int, c: GenericCall| n + c.args.len()));
  iterate(start, most, |needs: Map<RootName, List<Need>>| {
    let next = bodies.fold(
      needs,
      |accumulator: Map<RootName, List<Need>>, n: RootName, t: Tables|
        t.generics.calls.fold(accumulator, |a: Map<RootName, List<Need>>, call: GenericCall|
          with_callee_needs(a, n, call, needs)),
    );
    if needs_count(next) == needs_count(needs) { Stop(needs) } else { Continue(next) }
  })
}

fn specialised_by_callers(
  keys: Map<RootName, RootKey>,
  n: RootName,
  t: Tables,
  needs: Map<RootName, List<Need>>,
) -> Bool =
  specialised_definition(keys, n) == None
    && (needs_specialisation(t.generics.needs)
    || needs_specialisation(match needs.get(n) { Some(ns) -> ns, None -> [] }))

fn unemitted_generics(
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
  needs: Map<RootName, List<Need>>,
) -> Map<RootName, Bool> =
  results.fold(Map::new(), |accumulator: Map<RootName, Bool>, n: RootName, a: Output|
    if specialised_by_callers(keys, n, a.tables, needs) { accumulator.insert(n, true) }
    else { accumulator })

fn with_unemitted_rejected(
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
  unemitted: Map<RootName, Bool>,
) -> Map<RootName, Output> / {abort.raise} =
  results.fold(Map::new(), |accumulator: Map<RootName, Output>, n: RootName, a: Output|
    if unemitted.contains(n) { accumulator }
    else if specialised_definition(keys, n) != None
        && needs_specialisation(a.tables.generics.needs) {
      panic(
        String::of_bytes_lossy(
          Bytes::concat_all([
            b"the specialisation `",
            root_text(n),
            b"` was made for specific types but still depends on the size or type of a generic type parameter",
          ]),
        ),
      )
    } else { accumulator.insert(n, a) })

fn extended_called(
  bodies: Map<RootName, Tables>,
  closed: Map<RootName, List<Int>>,
) -> Map<RootName, List<Int>> / {abort.raise} = {
  let alone = bodies.fold(
    Map::new(),
    |accumulator: Map<RootName, Generics>, n: RootName, t: Tables|
      if t.members.len() <= 1 { accumulator.insert(n, t.generics) } else { accumulator },
  );
  let start = alone.fold(
    closed,
    |accumulator: Map<RootName, List<Int>>, n: RootName, g: Generics|
      accumulator.insert(n, g.called_parameters),
  );
  let calls_count = |called: Map<RootName, List<Int>>|
    alone.fold(0, |c: Int, n: RootName, _: Generics|
      c + (match called.get(n) { Some(cs) -> cs.len(), None -> 0 }));
  let most = alone.fold(1, |accumulator: Int, _: RootName, g: Generics|
    accumulator + g.passes.len());
  iterate(start, most, |called: Map<RootName, List<Int>>| {
    let next = alone.fold(
      called,
      |accumulator: Map<RootName, List<Int>>, n: RootName, g: Generics|
        g.passes.fold(accumulator, |a: Map<RootName, List<Int>>, pass: ForwardedParameter| {
          let theirs = match called.get(root_name(pass.callee)) { Some(cs) -> cs, None -> [] };
          let mine = match a.get(n) { Some(cs) -> cs, None -> [] };
          if theirs.contains(pass.at) && !mine.contains(pass.param) {
            a.insert(n, mine.push(pass.param))
          } else { a }
        }),
    );
    if calls_count(next) == calls_count(called) { Stop(called) } else { Continue(next) }
  })
}

fn with_callee_needs(
  accumulator: Map<RootName, List<Need>>,
  n: RootName,
  call: GenericCall,
  needs: Map<RootName, List<Need>>,
) -> Map<RootName, List<Need>> = {
  let callee = match needs.get(root_name(call.callee)) { Some(ns) -> ns, None -> [] };
  callee.fold(accumulator, |a: Map<RootName, List<Need>>, need: Need|
    match call.args.at(need.var) {
      None -> a,
      Some(arg) -> {
        let variables = match need.reads {
          Exact -> type_variables(arg),
          Layout -> layout_variables(arg),
          Scalar -> match arg { VariableType(v) -> if v >= 0 { [v] } else { [] }, _ -> [] },
          EffectsGeneric -> [],
        };
        variables.fold(a, |m: Map<RootName, List<Need>>, v: Int| {
          let had = match m.get(n) { Some(ns) -> ns, None -> [] };
          let more = { var: v, reads: need.reads };
          if had.contains(more) { m } else { m.insert(n, had.push(more)) }
        })
      },
    })
}

fn call_specialisation(
  call: GenericCall,
  needs: Map<RootName, List<Need>>,
  called: Map<RootName, List<Int>>,
) -> RootKey / {ShapeReads} = {
  let callee = root_name(call.callee);
  let ns = match needs.get(callee) { Some(x) -> x, None -> [] };
  let open = KeyType(unknown_type);
  let calls = match called.get(callee) { Some(cs) -> cs, None -> [] };
  let functions = call.functions.filter(|f: InlinedLambda| calls.contains(f.param));
  let args = range(0, call.args.len()).map(|j: Int| {
    let arg = call.args.get(j);
    let loader_tables = ||
      KeyLayout({
        key: layout_key(arg),
        at: if functions.len() > 0 { arg } else { layout_representative(arg) },
      });
    if has_variables(arg) { open }
    else if ns.contains({ var: j, reads: Exact }) { KeyType(arg) }
    else if call.specialised_variables.contains(j) || ns.contains({ var: j, reads: Layout }) {
      loader_tables()
    } else if ns.contains({ var: j, reads: Scalar }) && is_scalar_type(arg) { loader_tables() }
    else if ns.contains({ var: j, reads: Scalar }) && numeric_sum(arg) { KeyType(arg) }
    else { open }
  });
  match definition_of(call.callee) {
    Some(definition) -> if functions.len() == 0 && args.all(|a: KeyArg| a == open)
        && call.effect_evidence.len() == 0 { call.callee } else {
      keys::specialisation_key_with_effects(definition, args, functions, call.effect_evidence)
    },
    None -> call.callee,
  }
}

fn generic_calls_specialised(
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
  needs: Map<RootName, List<Need>>,
  called: Map<RootName, List<Int>>,
) -> { results: Map<RootName, Output>, named: Map<RootName, List<RootName>>, unemitted: Map<RootName, Bool> } / {ShapeReads} = {
  let unemitted = unemitted_generics(results, keys, needs);
  let named = results.fold(
    Map::new(),
    |accumulator: Map<RootName, List<RootName>>, n: RootName, a: Output|
      if a.tables.generics.calls.len() == 0 { accumulator } else {
        accumulator.insert(
          n,
          a.tables.generics.calls.map(|g: GenericCall|
            root_name(call_specialisation(g, needs, called))),
        )
      },
  );
  let resolved_results = results.fold(
    Map::new(),
    |accumulator: Map<RootName, Output>, n: RootName, a: Output|
      accumulator.insert(n, if a.tables.generics.calls.len() == 0 { a } else {
        let resolved = a.tables.generics.calls.map(|g: GenericCall|
          call_specialisation(g, needs, called));
        let roots = resolved.map(root_name);
        let calls = resolved.fold(a.tables.calls, |cs: List<RootKey>, r: RootKey|
          if cs.any(|c: RootKey| root_name(c) == root_name(r)) { cs } else { cs.push(r) });
        let placed = |name: RootName|
          range(0, calls.len()).fold(None, |found: Option<Int>, i: Int|
            match found {
              Some(_) -> found,
              None -> match calls.at(i) {
                Some(c) -> if root_name(c) == name { Some(i) } else { None },
                None -> None,
              },
            });
        {
          text: a.text,
          tables: {
            ..a.tables,
            generics: {
              ..a.tables.generics,
              expects: a.tables.generics.expects.map(|e: ExpectedPrototype|
                match e.callee {
                  GenericAt(n) -> match roots.at(n) {
                    Some(r) -> match placed(r) { Some(i) -> { ..e, callee: CallAt(i) }, None -> e },
                    None -> e,
                  },
                  CallAt(_) -> e,
                }),
            },
            lambdas: a.tables.lambdas.map(|l: Bytes| placeholders_named(l, roots)),
            calls: calls,
          },
        }
      }),
  );
  { results: resolved_results, named: named, unemitted: unemitted }
}

fn named_output(
  named: Map<RootName, List<RootName>>,
  n: RootName,
  a: Output,
) -> Output / {abort.raise} =
  match named.get(n) { Some(names) -> { ..a, text: placeholders_named(a.text, names) }, None -> a }

type Compiled = {
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
  coded: List<{ key: RootKey, home: Bytes }>,
}

fn compiled(
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
) -> Compiled / {abort.raise} = {
  let sharing = results.fold(
    Map::new(),
    |accumulator: Map<RootName, { key: RootKey, shared: List<RootName> }>, n: RootName, a: Output|
      match keys.get(n) {
        Some(Specialisation(spec, _)) -> if a.tables.members.len() > 0
            || a.tables.defined.any(|d: DefinitionSymbol| d.entered) { accumulator } else {
          let k = code_of(spec.definition, n, a, body_digest(a));
          let c = root_name(k);
          accumulator.insert(c, {
            key: k,
            shared: List::push(match accumulator.get(c) { Some(x) -> x.shared, None -> [] }, n),
          })
        },
        _ -> accumulator,
      },
  );
  sharing.fold(
    { results: results, keys: keys, coded: [] },
    |accumulator: Compiled, c: RootName, s: { key: RootKey, shared: List<RootName> }|
      match if s.shared.len() < 2 { None } else { results.get(s.shared.get(0)) } {
        None -> accumulator,
        Some(a) ->
          {
            results: s.shared.fold(
              accumulator.results.insert(c, renamed(a, s.shared.get(0), s.key)),
              |m: Map<RootName, Output>, n: RootName|
                match results.get(n) { Some(b) -> m.insert(n, stub(b, s.key)), None -> m },
            ),
            keys: accumulator.keys.insert(c, s.key),
            coded: accumulator.coded.push({
              key: s.key,
              home: sorted_unique(
                s.shared.map(|n: RootName|
                  match keys.get(n) { Some(k) -> home_of(k), None -> b"" }),
              ).get(
                0,
              ),
            }),
          },
      },
  )
}

fn stub(a: Output, code: RootKey) -> Output / {abort.raise} =
  match a.tables.defined.at(0) {
    None -> panic("a specialised function has no definition of its own"),
    Some(d) -> {
      let params = range(0, d.head.params.len());
      let call = Bytes::concat_all([
        symbol_of(root_text(root_name(code))),
        b"(ctx",
        Bytes::concat_all(params.map(|i: Int| b", p".concat(ascii_of_int(i)))),
        b");",
      ]);
      {
        text: Bytes::concat_all([
          d.head.result,
          b" ",
          own_symbol(None),
          b"(PlyCtx *ctx",
          Bytes::concat_all(
            params.map(|i: Int|
              Bytes::concat_all([b", ", d.head.params.get(i), b" p", ascii_of_int(i)])),
          ),
          b") { ",
          if d.head.result == b"void" { call } else { b"return ".concat(call) },
          b" }",
        ]),
        tables: {
          ..no_tables,
          calls: [code],
          defined: a.tables.defined,
          handings: a.tables.handings,
        },
      }
    },
  }

fn code_of(definition: Bytes, n: RootName, a: Output, body: Bytes) -> RootKey / {abort.raise} = {
  let unnamed = renamed(summarised(a), n, Coded({ definition: definition, code: b"" }));
  Coded({
    definition: definition,
    code: Bytes::of_string(
      blake3(bin::encode(unnamed, output_bin()).concat(body)).slice(0, 16).hex_of(),
    ),
  })
}

fn renamed(a: Output, n: RootName, k: RootKey) -> Output =
  {
    ..a,
    tables: {
      ..a.tables,
      calls: a.tables.calls.map(|c: RootKey| if root_name(c) == n { k } else { c }),
    },
  }

pub fn placeholders_named(text: Bytes, roots: List<RootName>) -> Bytes / {abort.raise} = {
  let walk_levels = holes(text).filter(|h: Hole| h.kind == 103).fold(
    { from: 0, out: [] },
    |s: { from: Int, out: List<Bytes> }, h: Hole|
      {
        from: h.close_position + 2,
        out: s.out.push(text.slice(s.from, h.open_position)).push(
          symbol_of(root_text(roots.get(digits(h.digits)))),
        ),
      },
  );
  Bytes::concat_all(walk_levels.out.push(text.slice(walk_levels.from, text.len())))
}

pub fn code_rejections(runtime: Runtime, codes: List<UnitCode>) -> List<Diagnostic> = {
  let unserved = runtime_mismatches(runtime);
  let refused = unbound(
    runtime.natives,
    codes.fold(Map::new(), |found: Map<Bytes, Extern>, c: UnitCode|
      c.externs.fold(found, |m: Map<Bytes, Extern>, x: Extern| m.insert(x.name, x))).values(
    ),
  );
  if unserved.len() > 0 { [runtime_rejected(unserved)] }
  else if refused.len() > 0 { [natives_rejected(refused)] }
  else { [] }
}

pub fn lowering_rejected(reason: Bytes) -> Diagnostic = error_with_labels(b"E0505", reason, [], [])

pub fn unit_text(parts: List<WrittenPart>) -> Bytes =
  Bytes::concat_all([unit_header].concat(parts.map(|w: WrittenPart| w.text)))

type Fresh = { text: Bytes, parts: List<WrittenPart>, taken: List<RootName>, made: UnitContents }

pub fn fresh(
  constructors: List<Constructor>,
  offered: List<RequestedRoot>,
  modules: Int,
  results: Map<RootName, Output>,
  inputs: Map<Bytes, Bytes>,
  machine_of: (Map<Bytes, Bool>) -> List<Native> / {abort.raise},
  rule: PartRule,
) -> Fresh / {abort.raise} = {
  let p = produce(constructors, offered, modules, results, inputs, machine_of, rule);
  { text: unit_text(p.parts), parts: p.parts, taken: p.taken, made: p.made }
}

const some_definitions: Bytes =
  b"compiler.unit.emitted aa\ncompiler.front.emitter_input.view_dump bb\nunit.emitted cc\ncompiler.unit.emitted_twice dd\n"

fn transitive_needs(
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
) -> Map<RootName, List<Need>> / {abort.raise} =
  extended_needs(generic_bodies(results, keys, results.keys()), Map::new())

fn transitive_called(
  results: Map<RootName, Output>,
  keys: Map<RootName, RootKey>,
) -> Map<RootName, List<Int>> / {abort.raise} =
  extended_called(generic_bodies(results, keys, results.keys()), Map::new())

fn generic_body(calls: List<GenericCall>, needs: List<Need>) -> Output =
  { text: b"", tables: { ..no_tables, generics: { ..no_generics, calls: calls, needs: needs } } }

fn parsed_type(s: Bytes) -> Type / {abort.raise} =
  match decode_type(s) {
    Some(t) -> t,
    None -> panic(String::of_bytes_lossy(b"this text names no known type: ".concat(s))),
  }

fn results_and_keys(
  results: List<{ key: RootKey, value: Output }>,
) -> { results: Map<RootName, Output>, keys: Map<RootName, RootKey> } =
  {
    results: results.fold(
      Map::new(),
      |m: Map<RootName, Output>, x: { key: RootKey, value: Output }|
        m.insert(root_name(x.key), x.value),
    ),
    keys: results.fold(
      Map::new(),
      |m: Map<RootName, RootKey>, x: { key: RootKey, value: Output }|
        m.insert(root_name(x.key), x.key),
    ),
  }

fn definition_root(n: Bytes) -> RootName = root_name(Named(n))

pub fn no_machine(called: Map<Bytes, Bool>) -> List<Native> = []

fn by_definition<v>(entries: List<{ key: Bytes, value: v }>) -> Map<RootName, v> =
  entries.fold(Map::new(), |m: Map<RootName, v>, x: { key: Bytes, value: v }|
    m.insert(definition_root(x.key), x.value))

fn offer_root(k: RootKey, arity: Int) -> RequestedRoot =
  {
    key: k,
    name: root_name(k),
    arity: arity,
    constant: false,
    site: root_name(k),
    home: home_of(k),
  }

fn request(n: Bytes, arity: Int) -> RequestedRoot = offer_root(Named(n), arity)

test "a generic call is compiled for an argument type only in the detail its callee reads, and the rest of the type becomes `_`" {
  let needs = by_definition([
    { key: b"m.lay", value: [{ var: 0, reads: Layout }] },
    { key: b"m.add", value: [{ var: 0, reads: Scalar }] },
    { key: b"m.same", value: [{ var: 0, reads: Exact }] },
  ]);
  let root = |callee: Bytes, arg: Bytes|
    with_no_shapes(||
      call_specialisation(
        {
          callee: Named(callee),
          args: [parsed_type(arg)],
          specialised_variables: [],
          functions: [],
          effect_evidence: [],
        },
        needs,
        Map::new(),
      ));
  let call = |callee: Bytes, arg: Bytes| root_text(root_name(root(callee, arg)));
  assert_eq(call(b"m.lay", b"{x:Float}"), b"m.lay@{x:Float}");
  assert_eq(call(b"m.lay", b"_"), b"m.lay@_");
  assert_eq(call(b"m.lay", b"{x:m.Shape}"), b"m.lay@{x:_}");
  assert_eq(call(b"m.lay", b"{x:m.Date}"), call(b"m.lay", b"{x:m.Shape}"));
  assert_eq(key_types(root(b"m.lay", b"{x:m.Date}")), key_types(root(b"m.lay", b"{x:m.Shape}")));
  assert_eq(call(b"m.same", b"List<m.Shape>"), b"m.same@List<m.Shape>");
  assert_eq(call(b"m.same", b"m.Date{day:Int}"), b"m.same@m.Date{day:Int}");
  assert_eq(call(b"m.add", b"Float"), b"m.add@Float");
  assert_eq(call(b"m.add", b"{x:Float}"), b"m.add");
  assert_eq(call(b"m.add", b"m.Shape"), b"m.add");
  assert_eq(call(b"m.lay", b"{x:'0}"), b"m.lay");
  assert_eq(call(b"m.none", b"Float"), b"m.none")
}

test "a lambda argument is inlined only into a callee that calls the parameter receiving it, directly or by passing it on" {
  let body = |called: List<Int>, passes: List<ForwardedParameter>|
    {
      text: b"",
      tables: {
        ..no_tables,
        generics: { ..no_generics, called_parameters: called, passes: passes },
      },
    };
  let results = by_definition([
    { key: b"m.each", value: body([1], []) },
    { key: b"m.pass", value: body([], [{ param: 0, callee: Named(b"m.each"), at: 1 }]) },
    { key: b"m.keep", value: body([], []) },
  ]);
  let called = transitive_called(results, Map::new());
  assert_eq(called.get(definition_root(b"m.pass")), Some([0]));
  let call = |callee: Bytes, param: Int|
    printed(
      with_no_shapes(||
        call_specialisation(
          {
            callee: Named(callee),
            args: [],
            specialised_variables: [],
            functions: [{ param: param, owner: Named(b"m.main"), nth: 0 }],
            effect_evidence: [],
          },
          Map::new(),
          called,
        )),
    );
  assert_eq(call(b"m.each", 1), b"m.each@|1=m.main:0");
  assert_eq(call(b"m.pass", 0), b"m.pass@|0=m.main:0");
  assert_eq(call(b"m.each", 0), b"m.each");
  assert_eq(call(b"m.keep", 0), b"m.keep")
}

test "a generic function needs the detail of its own type variables that its callees need of the types it passes them" {
  let results = by_definition([
    { key: b"m.add", value: generic_body([], [{ var: 0, reads: Scalar }]) },
    { key: b"m.lay", value: generic_body([], [{ var: 0, reads: Layout }]) },
    {
      key: b"m.wrap",
      value: generic_body(
        [
          {
            callee: Named(b"m.add"),
            args: [parsed_type(b"'0")],
            specialised_variables: [],
            functions: [],
            effect_evidence: [],
          },
          {
            callee: Named(b"m.lay"),
            args: [parsed_type(b"{v:'1}")],
            specialised_variables: [],
            functions: [],
            effect_evidence: [],
          },
        ],
        [],
      ),
    },
    {
      key: b"m.outer",
      value: generic_body(
        [
          {
            callee: Named(b"m.wrap"),
            args: [parsed_type(b"List<_>"), parsed_type(b"'0")],
            specialised_variables: [],
            functions: [],
            effect_evidence: [],
          },
        ],
        [],
      ),
    },
    { key: b"m.same", value: generic_body([], [{ var: 0, reads: Exact }]) },
    {
      key: b"m.each",
      value: generic_body(
        [
          {
            callee: Named(b"m.same"),
            args: [parsed_type(b"List<'0>")],
            specialised_variables: [],
            functions: [],
            effect_evidence: [],
          },
        ],
        [],
      ),
    },
  ]);
  let closed = transitive_needs(results, Map::new());
  assert_eq(
    closed.get(definition_root(b"m.wrap")),
    Some([{ var: 0, reads: Scalar }, { var: 1, reads: Layout }]),
  );
  assert_eq(closed.get(definition_root(b"m.outer")), Some([{ var: 0, reads: Layout }]));
  assert_eq(closed.get(definition_root(b"m.each")), Some([{ var: 0, reads: Exact }]))
}

test "a generic function that reads a type variable's size, layout or exact type, itself or through callees, is compiled only per caller" {
  let results = by_definition([
    { key: b"m.add", value: generic_body([], [{ var: 0, reads: Scalar }]) },
    { key: b"m.lay", value: generic_body([], [{ var: 0, reads: Layout }]) },
    { key: b"m.same", value: generic_body([], [{ var: 0, reads: Exact }]) },
    {
      key: b"m.each",
      value: generic_body(
        [
          {
            callee: Named(b"m.same"),
            args: [parsed_type(b"List<'0>")],
            specialised_variables: [],
            functions: [],
            effect_evidence: [],
          },
        ],
        [],
      ),
    },
    { key: b"m.main", value: generic_body([], []) },
  ]);
  let unemitted = unemitted_generics(results, Map::new(), transitive_needs(results, Map::new()));
  assert_eq(unemitted.keys(), [b"m.each", b"m.lay", b"m.same"].map(definition_root));
  let had = results_and_keys([
    { key: specialisation_key(b"m.same", [parsed_type(b"Int")], []), value: generic_body([], []) },
    { key: Named(b"m.same"), value: generic_body([], [{ var: 0, reads: Exact }]) },
  ]);
  let cached = with_unemitted_rejected(
    had.results,
    had.keys,
    unemitted_generics(had.results, had.keys, Map::new()),
  );
  assert_eq(
    cached.keys(),
    [specialisation_key(b"m.same", [parsed_type(b"Int")], [])].map(root_name),
  );
  let open = results_and_keys([
    {
      key: specialisation_key(b"m.same", [unknown_type], []),
      value: generic_body([], [{ var: 0, reads: Exact }]),
    },
  ]);
  let message = handle {
    with_unemitted_rejected(open.results, open.keys, Map::new());
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert(
    message.index_of(b"still depends on the size or type of a generic type parameter") != None,
    None,
  )
}

test "a body that calls a function missing from its unit, such as a generic function, fails with an internal error" {
  let calling = { text: b"", tables: { ..no_tables, calls: [Named(b"m.same")] } };
  let message = handle {
    taken_bodies(
      by_definition([{ key: b"m.main", value: calling }]),
      [definition_root(b"m.main")],
      Map::new(),
    );
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert_eq(message, b"`m.main` calls `m.same`, which is not part of the same compiled program")
}

fn specialisation_text(result: Bytes) -> Bytes = {
  let own = own_symbol(None);
  Bytes::concat_all([b"Word ", own, b"(PlyCtx *ctx) { return ", own, b"(ctx) + ", result, b"; }"])
}

fn specialisation_tables(k: RootKey) -> Tables =
  { ..no_tables, calls: [k], defined: [{ entered: false, head: word_prototype(0) }] }

fn program_calling_f_at(
  at: List<Bytes>,
) -> { coded: List<RootKey>, bodies: Map<RootName, Output> } / {abort.raise} = {
  let specialised = |arg: Bytes| {
    let k = specialisation_key(b"m.f", [parsed_type(arg)], []);
    {
      key: k,
      value: {
        text: specialisation_text(if arg == b"U8" { b"1" } else { b"0" }),
        tables: specialisation_tables(k),
      },
    }
  };
  let calling = |arg: Bytes| {
    let call = {
      callee: Named(b"m.f"),
      args: [parsed_type(arg)],
      specialised_variables: [],
      functions: [],
      effect_evidence: [],
    };
    { key: Named(b"m.calls_".concat(arg)), value: { ..generic_body([call], []), text: b"@@g0@@" } }
  };
  let had = results_and_keys(
    [{ key: Named(b"m.f"), value: generic_body([], [{ var: 0, reads: Exact }]) }].concat(
      at.map(specialised),
    ).concat(
      at.map(calling),
    ),
  );
  let c = compiled(had.results, had.keys);
  let s = with_no_shapes(||
    generic_calls_specialised(
      c.results,
      c.keys,
      transitive_needs(had.results, had.keys),
      transitive_called(had.results, had.keys),
    ));
  {
    coded: c.coded.map(|x: { key: RootKey, home: Bytes }| x.key),
    bodies: s.results.fold(Map::new(), |m: Map<RootName, Output>, n: RootName, a: Output|
      m.insert(n, named_output(s.named, n, a))),
  }
}

fn f_specialisation_key(arg: Bytes) -> RootKey / {abort.raise} =
  specialisation_key(b"m.f", [parsed_type(arg)], [])

test "specialisations with identical code share one body and each becomes a stub calling it, but a lone specialisation has its own body" {
  let alone = program_calling_f_at([b"Int", b"U8"]);
  let both = program_calling_f_at([b"Int", b"Bool", b"U8"]);
  assert_eq(alone.coded, []);
  assert_eq(
    alone.bodies.get(root_name(f_specialisation_key(b"Int"))),
    Some({
      text: specialisation_text(b"0"),
      tables: specialisation_tables(f_specialisation_key(b"Int")),
    }),
  );
  match both.coded {
    [code] -> {
      assert_eq(
        both.bodies.get(root_name(code)),
        Some({ text: specialisation_text(b"0"), tables: specialisation_tables(code) }),
      );
      let calls = |arg: Bytes|
        match both.bodies.get(root_name(f_specialisation_key(arg))) {
          Some(a) -> a.tables.calls,
          None -> [],
        };
      assert_eq([calls(b"Int"), calls(b"Bool")], [[code], [code]]);
      let stub_text = match both.bodies.get(root_name(f_specialisation_key(b"Int"))) {
        Some(a) -> a.text,
        None -> b"",
      };
      assert(
        stub_text.index_of(symbol_of(printed(code))) != None,
        Some(String::of_bytes_lossy(stub_text)),
      )
    },
    _ -> assert_eq(both.coded.len(), 1),
  };
  assert_eq(
    both.bodies.get(root_name(f_specialisation_key(b"U8"))),
    alone.bodies.get(root_name(f_specialisation_key(b"U8"))),
  )
}

test "a caller calls a specialisation by that specialisation's own name, even when other specialisations share its code" {
  let called = |p: { coded: List<RootKey>, bodies: Map<RootName, Output> }, caller: Bytes|
    match p.bodies.get(definition_root(caller)) { Some(a) -> a.text, None -> b"" };
  let alone = program_calling_f_at([b"Int", b"U8"]);
  let both = program_calling_f_at([b"Int", b"Bool", b"U8"]);
  assert_eq(called(alone, b"m.calls_Int"), symbol_of(printed(f_specialisation_key(b"Int"))));
  assert_eq(called(both, b"m.calls_Int"), called(alone, b"m.calls_Int"));
  assert_eq(called(both, b"m.calls_Bool"), symbol_of(printed(f_specialisation_key(b"Bool"))));
  assert_eq(called(both, b"m.calls_U8"), called(alone, b"m.calls_U8"))
}

test "`definition_hash` finds a definition's hash by its full name only, not by a suffix or similar name" {
  assert_eq(definition_hash(some_definitions, b"compiler.unit.emitted"), Some(b"aa"));
  assert_eq(
    definition_hash(some_definitions, b"compiler.front.emitter_input.view_dump"),
    Some(b"bb"),
  );
  assert_eq(definition_hash(some_definitions, b"compiler.unit.emitted_twice"), Some(b"dd"));
  assert_eq(definition_hash(some_definitions, b"unit.emitted"), Some(b"cc"));
  assert_eq(definition_hash(some_definitions, b"front.seam.view_dump"), None);
  assert_eq(definition_hash(some_definitions, b"emitted"), None);
  assert_eq(definition_hash(some_definitions, b"compiler.unit.emit"), None)
}

test "`identity_of` changes when the hash of a root it names changes, and not when any other definition's hash changes" {
  let roots = [b"compiler.unit.emitted", b"compiler.front.emitter_input.view_dump"];
  let one = identity_of(some_definitions, roots);
  assert_eq(
    identity_of(
      b"compiler.unit.emitted aa\ncompiler.front.emitter_input.view_dump bb\ncompiler.unit.emitted_twice ee\nzeta.new ff\n",
      roots,
    ),
    one,
  );
  assert(
    identity_of(b"compiler.unit.emitted aa\ncompiler.front.emitter_input.view_dump b0\n", roots)
      != one,
    Some("a root's hash moved and the identity did not"),
  );
  assert(identity_of(some_definitions, [b"compiler.unit.emitted"]) != one, None)
}

pub fn a_runtime(identity: Bytes) -> Runtime / {abort.raise} =
  serving_runtime(identity, program_natives([]).map(declared_signature))

fn builder_definitions(main: Bytes) -> Bytes =
  Bytes::concat_all([b"compiler.build.build_program ", main, b"\ncompiler.build.told e5\n"])

test "`program_key` changes only when the entry definition, the runtime or the builder's definitions change" {
  let key = program_key(b"entry", a_runtime(b"rt"), builder_definitions(b"c3"));
  assert_eq(key.len(), 64);
  assert_eq(
    program_key(b"entry", a_runtime(b"rt"), builder_definitions(b"c3").concat(b"other.one f6\n")),
    key,
  );
  assert(program_key(b"other", a_runtime(b"rt"), builder_definitions(b"c3")) != key);
  assert(program_key(b"entry", a_runtime(b"tr"), builder_definitions(b"c3")) != key);
  assert(program_key(b"entry", a_runtime(b"rt"), builder_definitions(b"c4")) != key)
}

test "`literal_lines` writes each line of a unit's text as C string literals ending with a newline literal, and wraps long lines" {
  assert_eq(literal_lines(b""), b"\"\" \"\\n\"\n");
  let long = Bytes::concat_all(range(0, 2001).map(|_: Int| b"x"));
  let batch_count = literal_lines(long).split(b"\n");
  assert_eq(batch_count.len(), 3);
  assert_eq(batch_count.get(0).len(), 2002);
  assert_eq(batch_count.get(1), b"  \"x\" \"\\n\"")
}

test "`split_lines` splits on newlines, treats a final newline as ending the last line, and drops `\r`" {
  assert_eq(split_lines(b"a\nb\n"), [b"a", b"b"]);
  assert_eq(split_lines(b"a\r\n\nb"), [b"a", b"", b"b"])
}

fn one_body(name: Bytes, calls: List<Bytes>) -> Output / {abort.raise} = {
  let own = with_no_shapes(|| statics_of(StringDatum(name)));
  {
    text: Bytes::concat_all([
      b"Word ",
      own_symbol(None),
      b"(PlyCtx *ctx) { return (Word)(intptr_t)&",
      own.get(0).name,
      b" + @@r@@; }",
    ]),
    tables: {
      ..no_tables,
      statics: own,
      calls: calls.map(Named),
      defined: [{ entered: true, head: word_prototype(0) }],
    },
  }
}

fn with_head(a: Output, head: Prototype) -> Output =
  {
    ..a,
    tables: {
      ..a.tables,
      defined: a.tables.defined.map(|d: DefinitionSymbol| { ..d, head: head }),
    },
  }

fn edited_body(name: Bytes) -> Output / {abort.raise} = {
  let b = one_body(name, []);
  { ..b, text: b.text.concat(b"\n/* edited */") }
}

test "a constructor's tag is its position among the constructors the code uses, so a constructor it does not use changes no text" {
  let result = {
    text: b"Word f_m.f(PlyCtx *ctx) { return @@Tm.Line@@ + @@TNone@@; }",
    tables: {
      ..no_tables,
      defined: [{ entered: true, head: word_prototype(0) }],
      keyed: [KeyedTag(b"m.Line"), KeyedTag(b"None")],
    },
  };
  let unit = |constructors: List<Constructor>|
    fresh(
      constructors,
      [request(b"m.f", 0)],
      1,
      by_definition([{ key: b"m.f", value: result }]),
      Map::new(),
      no_machine,
      part_rule,
    ).text;
  let alone = unit([
    { name: b"None", arity: 0 },
    { name: b"m.Dot", arity: 0 },
    { name: b"m.Line", arity: 1 },
  ]);
  let beside = unit([
    { name: b"None", arity: 0 },
    { name: b"a.One", arity: 0 },
    { name: b"a.Two", arity: 0 },
    { name: b"m.Dot", arity: 0 },
    { name: b"m.Line", arity: 1 },
  ]);
  let label = part_label(definition_root(b"m.f"));
  let table = part_table(label);
  let body = Bytes::concat_all([b"{ return ", table, b"[1] + ", table, b"[0]; }"]);
  assert(alone.index_of(body) != None, None);
  let declared = Bytes::concat_all([b"extern const uint32_t ", table, b"[];\n"]);
  assert(part_labelled(alone, label).index_of(declared) != None, None);
  let filled = |places: Bytes|
    Bytes::concat_all([b"const uint32_t ", table, b"[] = {", places, b" };\n"]);
  assert(part_labelled(alone, "tables").index_of(filled(b" 0, 1,")) != None, None);
  assert_eq(alone, beside)
}

pub const one_each: PartRule = { bits: 0, min: 0, max: 1 << 40 }

const by_names: PartRule = { bits: 1, min: 0, max: 1 << 40 }

type Cut = { label: String, text: Bytes }

fn parts_in(text: Bytes) -> List<Cut> / {abort.raise} =
  cc::split(text).files.map(|w: WrittenPart| { label: w.label, text: w.text })

fn parts_before_runtime(text: Bytes) -> List<Cut> / {abort.raise} =
  parts_in(text).fold(
    { out: [], past: false },
    |accumulator: { out: List<Cut>, past: Bool }, c: Cut|
      if accumulator.past || c.label == "runtime" { { ..accumulator, past: true } }
      else { { ..accumulator, out: accumulator.out.push(c) } },
  ).out

fn part_labelled(text: Bytes, label: String) -> Bytes / {abort.raise} =
  match parts_in(text).find(|c: Cut| c.label == label) { Some(c) -> c.text, None -> b"" }

fn part_containing(text: Bytes, c: Bytes) -> Bytes / {abort.raise} =
  match parts_in(text).find(|p: Cut| p.text.index_of(c) != None) { Some(p) -> p.text, None -> b"" }

fn body_of(name: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([b"Word ", symbol_of(name), b"(PlyCtx *ctx)"])

fn numbered(n: Int) -> List<Bytes> = range(0, n).map(|i: Int| b"m.b".concat(ascii_of_int(i)))

fn unit_over(names: List<Bytes>, edited: Bytes, rule: PartRule) -> Bytes / {abort.raise} =
  fresh(
    [],
    names.map(|n: Bytes| request(n, 0)),
    1,
    by_definition(
      names.map(|n: Bytes|
        { key: n, value: if n == edited { edited_body(n) } else { one_body(n, []) } }),
    ),
    Map::new(),
    no_machine,
    rule,
  ).text

fn missing_from(xs: List<Cut>, ys: List<Cut>) -> List<Cut> = xs.filter(|x: Cut| !ys.contains(x))

test "a section's C code is unchanged when other sections add entries to the unit's tables" {
  let fielded = |n: Bytes, field: Bytes| {
    let b = one_body(n, []);
    {
      text: b.text.concat(b" /* @@f0@@ */"),
      tables: { ..b.tables, fields: [field], keyed: [KeyedField(0)] },
    }
  };
  let unit = |names: List<Bytes>|
    fresh(
      [{ name: b"None", arity: 0 }],
      names.map(|n: Bytes| request(n, 0)),
      1,
      by_definition(names.map(|n: Bytes| { key: n, value: fielded(n, n) })),
      Map::new(),
      no_machine,
      one_each,
    ).text;
  let alone = unit([b"m.f"]);
  let beside = unit([b"m.f", b"a.other"]);
  let label = part_label(definition_root(b"m.f"));
  assert(part_labelled(alone, label).index_of(body_of(b"m.f")) != None, None);
  assert_eq(part_labelled(beside, label), part_labelled(alone, label));
  assert(part_labelled(beside, "tables") != part_labelled(alone, "tables"), None)
}

test "editing the C code of one body changes only the section that contains that body" {
  let names = numbered(16);
  let before = unit_over(names, b"", by_names);
  let after = unit_over(names, b"m.b7", by_names);
  let bodies = parts_before_runtime(before);
  assert(bodies.len() > 1 && bodies.len() < names.len(), None);
  assert_eq(parts_in(after).map(|c: Cut| c.label), parts_in(before).map(|c: Cut| c.label));
  let changed = missing_from(parts_in(after), parts_in(before));
  assert_eq(changed.map(|c: Cut| c.text), [part_containing(after, body_of(b"m.b7"))]);
  assert(changed.get(0).text.index_of(b"/* edited */") != None, None)
}

test "adding or removing a body changes the section containing it and at most one neighbouring section" {
  let names = numbered(16);
  let before = parts_before_runtime(unit_over(names, b"", by_names));
  [2, 7, 11, 13].fold((), |_: Unit, i: Int| {
    let added = Bytes::concat_all([b"m.b", ascii_of_int(i), b"x"]);
    let after = parts_before_runtime(unit_over(names.push(added), b"", by_names));
    let gone = missing_from(before, after);
    let came = missing_from(after, before);
    assert(gone.len() <= 1 && came.len() <= 2, Some(String::of_bytes_lossy(added)));
    assert(came.any(|c: Cut| c.text.index_of(body_of(added)) != None), None)
  })
}

test "all the bodies of a small program go into a single section of the generated C" {
  assert_eq(parts_before_runtime(unit_over(numbered(8), b"", part_rule)).len(), 1)
}

test "a body larger than the section size limit gets a section to itself, and smaller bodies share sections up to that limit" {
  let big = b"m.b3";
  let names = numbered(8);
  let padded = {
    let b = one_body(big, []);
    { ..b, text: b.text.concat(b" ".repeat(300)) }
  };
  let text = fresh(
    [],
    names.map(|n: Bytes| request(n, 0)),
    1,
    by_definition(
      names.map(|n: Bytes| { key: n, value: if n == big { padded } else { one_body(n, []) } }),
    ),
    Map::new(),
    no_machine,
    { bits: 62, min: 1 << 40, max: 250 },
  ).text;
  assert_eq(part_containing(text, body_of(big)).split(b"(PlyCtx *ctx)").len() - 1, 1);
  assert(parts_before_runtime(text).len() < names.len(), None)
}

test "each unit section is labelled with 16 hex digits from its first body's root id, and the final sections `runtime`, `taken` and `tables`" {
  let names = numbered(12);
  let text = unit_over(names, b"", one_each);
  let labels = parts_in(text).map(|c: Cut| c.label);
  assert_eq(
    parts_before_runtime(text).map(|c: Cut| c.label),
    sorted_unique(names).map(|n: Bytes| part_label(definition_root(n))),
  );
  let digits = b"0123456789abcdef";
  assert(
    parts_before_runtime(text).all(|c: Cut| {
      let label = Bytes::of_string(c.label);
      label.len() == 16 && range(0, 16).all(|i: Int| digits.index_of(label.slice(i, i + 1)) != None)
    }),
    None,
  );
  assert_eq(labels.drop(names.len()), ["runtime", "taken", "tables"])
}

test "a unit's text has an `entered` line for each root whose entry point the unit includes, even without a body for that root" {
  let entry = |n: Bytes| root_name(EntryPoint(Named(n)));
  let definition = |n: Bytes| request(n, 0);
  let entered = |n: Bytes| { ..offer_root(EntryPoint(Named(n)), 0), site: definition_root(n) };
  let p = fresh(
    [],
    [definition(b"m.f"), definition(b"m.g"), entered(b"m.f"), entered(b"m.h")],
    1,
    Map::of_entries([
      { key: definition_root(b"m.f"), value: one_body(b"m.f", []) },
      { key: definition_root(b"m.g"), value: one_body(b"m.g", []) },
      { key: entry(b"m.f"), value: one_body(root_text(entry(b"m.f")), [b"m.f"]) },
      { key: entry(b"m.h"), value: one_body(root_text(entry(b"m.h")), []) },
    ]),
    Map::new(),
    no_machine,
    part_rule,
  );
  assert(p.taken.contains(entry(b"m.f")), None);
  assert(p.text.index_of(b"entered m.f") != None, None);
  assert(p.text.index_of(b"entered m.h") != None, None);
  assert_eq(p.text.index_of(b"entered m.g"), None)
}

fn head_in(text: Bytes) -> Bytes / {abort.raise} = cc::split(text).head

test "every section of a unit comes after the unit header, and the runtime section begins with `unit_tail`" {
  let p = fresh(
    [],
    [request(b"m.f", 0)],
    1,
    by_definition([{ key: b"m.f", value: one_body(b"m.f", []) }]),
    Map::new(),
    no_machine,
    part_rule,
  );
  assert(head_in(p.text) == unit_header, None);
  assert(p.text.index_of(unit_tail([])) != None, None);
  assert(
    p.text.index_of(
        Bytes::concat_all([
          b"\"helpers ",
          ascii_of_int(bound_functions.len()),
          b"\" \"\\n\"\n\"rt_failed 4 0\"",
        ]),
      )
      != None,
    None,
  )
}

test "a section declares only the functions that its own bodies define or call" {
  let caller = b"m.caller";
  let callee = b"m.callee";
  let apart = b"m.apart";
  let p = fresh(
    [],
    [request(caller, 0), request(callee, 2), request(apart, 0)],
    1,
    by_definition([
      { key: caller, value: one_body(caller, [callee]) },
      { key: callee, value: with_head(one_body(callee, []), word_prototype(2)) },
      { key: apart, value: one_body(apart, []) },
    ]),
    Map::new(),
    no_machine,
    one_each,
  );
  let declares = |part: Bytes, name: Bytes, arity: Int|
    part.index_of(prototype(symbol_of(name), word_prototype(arity))) != None;
  let calling = part_containing(p.text, body_of(caller));
  assert(
    declares(calling, caller, 0) && declares(calling, callee, 2),
    Some(String::of_bytes_lossy(calling)),
  );
  assert(!declares(calling, apart, 0), Some(String::of_bytes_lossy(calling)));
  let alone = part_containing(p.text, body_of(apart));
  assert(
    !declares(alone, caller, 0) && !declares(alone, callee, 2),
    Some(String::of_bytes_lossy(alone)),
  );
  let head = head_in(p.text);
  [caller, callee, apart].fold((), |u: Unit, name: Bytes| {
    assert_eq(p.text.split(body_of(name)).len() - 1, 1);
    assert(head.index_of(symbol_of(name)) == None, None)
  })
}

test "a specialisation that runs a lambda borrowed from another module is placed among that module's bodies" {
  let borrowed = specialisation_key(b"std.walk.each", [int_type], [
    { param: 1, owner: Named(b"m.a"), nth: 0 },
  ]);
  assert_eq(home_of(borrowed), b"m");
  assert_eq(home_of(specialisation_key(b"std.walk.each", [int_type], [])), b"std.walk");
  let roots = [Named(b"m.a"), borrowed, Named(b"n.b")];
  let text = fresh(
    [],
    roots.map(|k: RootKey| offer_root(k, 0)),
    1,
    roots.fold(Map::new(), |accumulator: Map<RootName, Output>, k: RootKey|
      accumulator.insert(root_name(k), one_body(printed(k), []))),
    Map::new(),
    no_machine,
    part_rule,
  ).text;
  let at = |k: RootKey| first_offset(text, body_of(printed(k)));
  assert(
    at(Named(b"m.a")) >= 0 && at(Named(b"m.a")) < at(borrowed) && at(borrowed) < at(Named(b"n.b")),
    None,
  )
}

test "a call that expects a different function prototype than the callee defines makes the unit fail with an error" {
  let caller = b"m.caller";
  let callee = b"m.callee";
  let expecting = |head: Prototype| {
    let b = one_body(caller, [callee]);
    {
      ..b,
      tables: {
        ..b.tables,
        generics: { ..no_generics, expects: [{ callee: CallAt(0), head: head }] },
      },
    }
  };
  let made = |head: Prototype|
    try[abort.raise] {
      fresh(
        [],
        [request(caller, 0), request(callee, 1)],
        1,
        by_definition([
          { key: caller, value: expecting(head) },
          {
            key: callee,
            value: with_head(one_body(callee, []), { result: b"double", params: [b"double"] }),
          },
        ]),
        Map::new(),
        no_machine,
        part_rule,
      ).taken
    };
  assert_eq(
    made({ result: b"double", params: [b"double"] }),
    Ok([callee, caller].map(definition_root)),
  );
  match made(word_prototype(1)) {
    Ok(_) -> assert(false, Some("a call to another head was taken")),
    Err(reason) ->
      assert(
        Bytes::of_string(reason).index_of(
            Bytes::concat_all([
              b"which it defines as double ",
              symbol_of(callee),
              b"(PlyCtx*, double)",
            ]),
          )
          != None,
        Some(reason),
      ),
  }
}

fn fresh_unit(
  results: List<{ key: Bytes, value: Output }>,
  inputs: Map<Bytes, Bytes>,
) -> Fresh / {abort.raise} =
  fresh(
    [],
    results.map(|a: { key: Bytes, value: Output }| request(a.key, 0)),
    1,
    by_definition(results),
    inputs,
    no_machine,
    one_each,
  )

fn with_statics(a: Output, definitions: List<StaticDefinition>) -> Output =
  { ..a, tables: { ..a.tables, statics: a.tables.statics.concat(definitions) } }

fn static_defined(d: StaticDefinition) -> Bytes =
  Bytes::concat_all([b"const struct ", d.name, b" {"])

test "a static is defined once, in the section of the first body that uses it, and declared in every other section that uses it" {
  let child = statics_of(StringDatum(b"shared-constant")).get(0);
  let parent = named_by_content(StaticWords([AddressWord({ name: child.name, tag: 0 })]));
  let p = fresh_unit(
    [
      { key: b"m.one", value: with_statics(one_body(b"m.one", []), [child]) },
      { key: b"m.two", value: with_statics(one_body(b"m.two", []), [child, parent]) },
      { key: b"m.apart", value: one_body(b"m.apart", []) },
    ],
    Map::new(),
  );
  let one = part_containing(p.text, body_of(b"m.one"));
  let two = part_containing(p.text, body_of(b"m.two"));
  assert(first_offset(p.text, one) < first_offset(p.text, two), None);
  assert_eq(p.text.split(static_defined(child)).len() - 1, 1);
  assert(
    one.index_of(static_defined(child)) != None && one.index_of(static_extern(child.name)) == None,
    Some(String::of_bytes_lossy(one)),
  );
  let declared = first_offset(two, static_extern(child.name));
  assert(
    declared >= 0 && declared < first_offset(two, static_defined(parent))
      && two.index_of(static_defined(child)) == None,
    Some(String::of_bytes_lossy(two)),
  );
  assert(part_containing(p.text, body_of(b"m.apart")).index_of(child.name) == None, None);
  assert_eq(part_labelled(p.text, "fields"), b"");
  assert(p.text.index_of(b"consts ") == None, None)
}

test "a static that stores a field's position is defined in the `fields` section, and declared in sections whose bodies use it" {
  let child = statics_of(StringDatum(b"child")).get(0);
  let parent = named_by_content(
    StaticWords([FieldWord(b"op"), AddressWord({ name: child.name, tag: 0 })]),
  );
  let p = fresh_unit(
    [{ key: b"m.f", value: with_statics(one_body(b"m.f", []), [child, parent]) }],
    Map::new(),
  );
  let fields = part_labelled(p.text, "fields");
  let own = part_containing(p.text, body_of(b"m.f"));
  assert(
    fields.index_of(static_defined(parent)) != None
      && fields.index_of(static_extern(child.name)) != None,
    Some(String::of_bytes_lossy(fields)),
  );
  assert(
    own.index_of(static_defined(child)) != None && own.index_of(static_extern(parent.name)) != None,
    Some(String::of_bytes_lossy(own)),
  );
  assert_eq([child, parent].map(|d: StaticDefinition| p.text.split(static_defined(d)).len() - 1), [
    1,
    1,
  ])
}

test "an embedded file is emitted once, byte for byte, from the file contents given to the unit" {
  let digest = b"\x00\xff".blake3();
  let file = [named_by_content(StaticFile(digest))];
  let p = fresh_unit(
    [
      { key: b"m.f", value: with_statics(one_body(b"m.f", []), file) },
      { key: b"m.g", value: with_statics(one_body(b"m.g", []), file) },
    ],
    Map::new().insert(digest, b"\x00\xff"),
  );
  assert_eq(p.text.split(b"\"\\000\\377\"").len() - 1, 1);
  assert(p.text.index_of(b"{ .len = 2, .room = 2 }") != None, None)
}

test "two statics with the same name but different contents make the unit fail with an error" {
  let a = statics_of(StringDatum(b"a")).get(0);
  let forged = { name: a.name, layout: statics_of(StringDatum(b"b")).get(0).layout };
  let error_message = handle {
    fresh_unit(
      [
        { key: b"m.f", value: with_statics(one_body(b"m.f", []), [a]) },
        { key: b"m.g", value: with_statics(one_body(b"m.g", []), [forged]) },
      ],
      Map::new(),
    );
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert(error_message.starts_with(b"two statics of one name contain different content"), None)
}

const three_modules: List<Bytes> =
  [
    b"import b\nimport c\nfn f(x: Int) -> Int = b::g(x) + c::h(x)\n",
    b"import c\npub fn g(x: Int) -> Int = c::h(x) * 2\n",
    Bytes::concat_all([
      b"pub fn h(x: Int) -> Int = if even(x) { x } else { x + 1 }\n",
      b"fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n",
      b"fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n",
    ]),
  ]

const three_modules_dump: Dump = {
  let texts = three_modules;
  dump_of(
    analyse(
      parse_all([
        { name: b"a", source_text: texts.get(0) },
        { name: b"b", source_text: texts.get(1) },
        { name: b"c", source_text: texts.get(2) },
      ]),
    ),
  )
}

test "a unit depends only on the modules that contain its roots and the modules those import" {
  let dump = three_modules_dump;
  let over = |root: Bytes| program_of(dump, three_modules, [Named(root)]);
  let read = |root: Bytes| over(root).read.keys().filter(|m: Bytes| m != prelude_module);
  assert_eq(read(b"c.h"), [b"c"]);
  assert_eq(read(b"b.g"), [b"b", b"c"]);
  assert_eq(read(b"a.f"), [b"a", b"b", b"c"]);
  let p = over(b"b.g");
  assert_eq(p.digests.keys(), [b"b", b"c"])
}

test "roots generated for types are split into separate batches, however many types one module generates roots for" {
  let p = program_of(three_modules_dump, three_modules, requested_roots(three_modules_dump).keys);
  let written = range(0, batch_count()).map(|i: Int|
    keys::generated_key(keys::Drop, parsed_type(b"a.T".concat(ascii_of_int(i))), b"a"));
  let lists = batches(p, written.push(Named(b"a.f")));
  assert_eq(lists.len(), batch_count());
  assert_eq(lists.fold(0, |n: Int, roots: List<RootKey>| n + roots.len()), batch_count() + 1)
}

test "a module's definitions are listed together, its specialisations are listed with their definitions, and no root is listed twice" {
  let dump = three_modules_dump;
  let p = program_of(dump, three_modules, requested_roots(dump).keys);
  let at = |definition: Bytes, borrowed: List<InlinedLambda>|
    specialisation_key(definition, [string_type], borrowed);
  let borrowed = at(b"c.even", [{ param: 0, owner: Named(b"b.g"), nth: 0 }]);
  let missed = requested_roots(dump).keys.concat([at(b"c.h", []), at(b"c.odd", []), borrowed]);
  let lists = batches(p, missed);
  assert_eq(lists.len(), sorted_unique(missed.map(batch_key)).len());
  assert_eq(batch_key(borrowed), b"b");
  assert_eq(batch_key(Named(b"c.odd")), batch_key(Named(b"c.even")));
  assert(batch_key(at(b"c.h", [])) != batch_key(at(b"c.odd", [])), None);
  assert_eq(
    sorted_unique_names(
      lists.fold([], |accumulator: List<RootName>, roots: List<RootKey>|
        accumulator.concat(roots.map(root_name))),
    ),
    sorted_unique_names(missed.map(root_name)),
  );
  let together = |roots: List<RootKey>| sorted_unique(roots.map(batch_key));
  assert_eq(
    lists.fold(0, |n: Int, roots: List<RootKey>| n + together(roots).len()),
    together(missed).len(),
  );
  let many = range(0, 3 * batch_count()).map(|i: Int|
    Named(Bytes::concat_all([b"m", ascii_of_int(i), b".f"])));
  assert_eq(batches(p, many).len(), batch_count())
}

test "an `extern fn` is reported unbound when no native matches it, two natives match it, or the matching native has a different signature" {
  let declared = |name: Bytes, words: Int, raises: Bool|
    { module: b"std.prelude", name: name, words: words, raises: raises, call: None };
  let native = |name: Bytes, words: Int, results: Bool, raises: Bool|
    word_native(name, words, results, raises);
  let found = unbound(
    [
      native(b"List::len", 1, true, false),
      native(b"assert", 2, true, true),
      native(b"twice", 1, true, false),
      native(b"twice", 1, true, false),
      native(b"wider", 2, true, false),
      native(b"silent", 1, false, false),
      native(b"calm", 1, true, false),
      native(b"undeclared", 3, true, false),
    ],
    [
      declared(b"List::len", 1, false),
      declared(b"assert", 2, true),
      declared(b"gone", 0, false),
      declared(b"twice", 1, false),
      declared(b"wider", 1, false),
      declared(b"silent", 1, false),
      declared(b"calm", 1, true),
    ],
  );
  assert_eq(found.map(|u: Unbound| { name: u.declared.name, found: u.found.len() }), [
    { name: b"gone", found: 0 },
    { name: b"twice", found: 2 },
    { name: b"wider", found: 1 },
    { name: b"silent", found: 1 },
    { name: b"calm", found: 1 },
  ]);
  assert_eq(found.map(unbound_line), [
    b"`extern fn gone` of `std.prelude`: no native of the runtime implements it",
    b"`extern fn twice` of `std.prelude`: 2 natives of the runtime implement it",
    b"`extern fn wider` of `std.prelude` takes [Word], returns Word and cannot raise, and the runtime's native takes [Word, Word], returns Word and cannot raise",
    b"`extern fn silent` of `std.prelude` takes [Word], returns Word and cannot raise, and the runtime's native takes [Word], returns nothing and cannot raise",
    b"`extern fn calm` of `std.prelude` takes [Word], returns Word and raises, and the runtime's native takes [Word], returns Word and cannot raise",
  ]);
  assert_eq(
    unbound([], [{ module: b"", name: b"?scope_take", words: 1, raises: false, call: None }]).map(
      unbound_line,
    ),
    [b"the compiler's `?scope_take`: no native of the runtime implements it"],
  );
  let marshalling = |name: Bytes| { module: b"", name: name, words: 3, raises: false, call: None };
  let declared_fun = {
    name: b"?out_fun",
    params: [abi::Opaque, abi::Address, abi::I64],
    result: None,
    raises: false,
  };
  let swapped = { ..declared_fun, params: [abi::Address, abi::I64, abi::Opaque] };
  assert_eq(unbound([declared_fun], [marshalling(b"?out_fun")]), []);
  assert_eq(unbound([swapped], [marshalling(b"?out_fun")]).map(unbound_line), [
    b"the compiler's `?out_fun` takes [Handed, Addr, I64], returns nothing and cannot raise, and the runtime's native takes [Addr, I64, Handed], returns nothing and cannot raise",
  ]);
  assert_eq(unbound([native(b"?out_fun", 3, false, false)], [marshalling(b"?out_fun")]).len(), 1)
}

pub fn sources_in_order(
  dump: Dump,
  modules: List<{ name: Bytes, source_text: Bytes }>,
) -> List<Bytes> = {
  let texts = modules.fold(
    Map::new().insert(prelude_module, prelude_source::text),
    |accumulator: Map<Bytes, Bytes>, s: { name: Bytes, source_text: Bytes }|
      accumulator.insert(s.name, s.source_text),
  );
  let indexed = dump.modules.fold(Map::new(), |accumulator: Map<Int, Bytes>, m: ModuleRow|
    accumulator.insert(m.index, match texts.get(m.name) { Some(t) -> t, None -> b"" }));
  range(0, indexed.len()).map(|i: Int| match indexed.get(i) { Some(t) -> t, None -> b"" })
}

pub fn rejection_codes<a>(r: Result<a, List<Diagnostic>>) -> List<Bytes> =
  match r {
    Ok(_) -> [],
    Err(diagnostics) ->
      diagnostics.fold([], |accumulator: List<Bytes>, d: Diagnostic|
        accumulator.push(d.code).concat(d.notes_text)),
  }

test "each root a program requests has a key built from its kind, and the key's printed text equals the matching emitter root's name" {
  let user = [
    {
      name: b"m",
      source_text: Bytes::concat_all([
        b"fn f(x: Int) -> Int requires x > 0 ensures result > 0 = x\n",
        b"fn none<a>() -> List<a> ensures result.len() == 0 = []\n",
        b"test \"t\" for n: Int in [1] { assert(n > 0) }\n",
        b"law \"l\" forall (x: Int) where x > 0 { x + 1 > x }\n",
        b"law \"s\" forall (x: a) { x == x }\n",
      ]),
    },
  ];
  let cases = {
    name: b"std.cases",
    source_text: Bytes::concat_all([
      b"pub type Table<a> = List<a>\n",
      b"pub type Listed = { label: String, identity: Bytes }\n",
      b"pub fn listed<a | e>(table: List<a>, label: (a) -> String / e) -> List<Listed> / {abort.raise | e} = table.map(|c: a| { label: label(c), identity: b\"\" })\n",
      b"pub fn chosen<a>(table: List<a>, at: Int, wanted: Bytes) -> a / {abort.raise} = match table.at(at) { Some(c) -> c, None -> panic(\"no case\") }\n",
    ]),
  };
  let analysed = analyse_pulling_std_with(user, [cases], no_rows).out;
  let dump = dump_of(analysed);
  let offers = requested_roots(dump);
  assert_eq(offers.unkeyed, []);
  assert_eq(offers.keys.map(printed), dump.emitter_roots.map(|r: EmitterRoot| r.root));
  assert_eq(offers.keys.filter(|k: RootKey| module_of(k) == b"m"), [
    Named(b"m.f"),
    Named(b"m.none"),
    test_key(b"m", b"t"),
    Clause({ definition: Named(b"m.f"), kind: Requires, n: 0 }),
    Clause({ definition: Named(b"m.f"), kind: Ensures, n: 0 }),
    Clause({ definition: Named(b"m.none"), kind: Ensures, n: 0 }),
    TestCases(test_key(b"m", b"t")),
    law_key(b"m", b"l", LawGuard),
    law_key(b"m", b"l", LawBody),
    law_key(b"m", b"s", LawBody),
  ]);
  let p = program_of(dump, sources_in_order(dump, user.concat([cases])), offers.keys);
  let mine = offers.keys.filter(|k: RootKey| module_of(k) == b"m");
  assert_eq(
    mine.filter(|k: RootKey|
      over_outcome(analysed, |_: Analysis| enters(lowering_input_of(dump), k))),
    mine.filter(|k: RootKey| k != law_key(b"m", b"s", LawBody)),
  )
}

pub fn defined_in(text: Bytes, symbol: Bytes) -> Bytes / {abort.raise} =
  match text.index_of(symbol.concat(b"(PlyCtx *ctx")) {
    Some(i) -> {
      let rest = text.slice(i, text.len());
      match rest.index_of(b"\n}\n") { Some(j) -> rest.slice(0, j), None -> rest }
    },
    None -> b"",
  }

pub fn bridged_in(text: Bytes, key: RootKey) -> Bytes / {abort.raise} = {
  let own = defined_in(text, symbol_of(root_text(root_name(key))));
  if own.index_of(b"ply_perform(") != None && own.index_of(b"ctx->bridge") == None { b"" }
  else { own.concat(b"\n") }
}

test "a host handler waits for the result of each operation whose clause performs a wait, including when the wait is inside a helper function" {
  let user = [
    {
      name: b"m",
      source_text: b"import std.fact (fact)\npub fn asked() -> Int / {fact.slow, fact.fast, fact.behind} = fact.slow() + fact.fast() + fact.behind()\n",
    },
  ];
  let fact = {
    name: b"std.fact",
    source_text: Bytes::concat_all([
      b"import std.internal.native (native, wait, job_wait)\n",
      b"pub effect fact {\n  read slow() -> Int\n  read fast() -> Int\n  read behind() -> Int\n}\n",
      b"host for fact by served\n",
      b"fn waited() -> Int / {native.read, wait.read} = job_wait(1).len()\n",
      b"fn served<a | e>(go: () -> a / {fact.slow, fact.fast, fact.behind | e}) -> a / {native.read, wait.read | e} =\n",
      b"  handle { go() } with { fact.slow() -> job_wait(0).len(), fact.fast() -> 1, fact.behind() -> waited() }\n",
    ]),
  };
  let native = {
    name: b"std.internal.native",
    source_text: b"pub nondet effect native {}\npub nondet effect wait {}\npub extern fn job_wait(ticket: Int) -> Bytes / {native.read, wait.read}\n",
  };
  let dump = dump_of(analyse_pulling_std_with(user, [fact, native], no_rows).out);
  assert_eq(
    dump.diagnostics.filter(|d: Diagnostic| d.severity == b"error").map(|d: Diagnostic| d.message),
    [],
  );
  assert_eq(
    dump.effects.filter(|r: EffectRow| r.name == b"std.fact.fact").map(|r: EffectRow| r.waits),
    [[b"slow", b"behind"]],
  )
}

test "an `ensures` clause about a function that a definition returns gets no entry function, because the runtime can return a function but cannot call one" {
  let user = [
    {
      name: b"m",
      source_text: b"pub fn adder(n: Int) -> (Int) -> Int ensures result(1) == n + 1 = |x: Int| x + n\n",
    },
  ];
  let analysed = analyse(parse_all(user));
  let dump = dump_of(analysed);
  let entered = |k: RootKey|
    over_outcome(analysed, |_: Analysis| enters(lowering_input_of(dump), k));
  assert(entered(Named(b"m.adder")), None);
  assert(!entered(Clause({ definition: Named(b"m.adder"), kind: Ensures, n: 0 })), None)
}

const identifier_bytes: Bytes =
  Bytes::concat_all(
    range(48, 58).concat(range(65, 91)).push(95).concat(range(97, 123)).map(byte_of_int),
  )

pub fn pointers_named(
  text: Bytes,
  prefix: Bytes,
  into: Map<Bytes, Bool>,
) -> Map<Bytes, Bool> / {abort.raise} =
  iterate({ from: 0, found: into }, text.len() + 1, |s: { from: Int, found: Map<Bytes, Bool> }|
    match text.index_of_from(prefix, s.from) {
      None -> Stop(s.found),
      Some(at) -> {
        let end = text.scan(at, identifier_bytes, text.len() - at);
        let name = text.slice(at, end);
        let opens = at == 0 || identifier_bytes.index_of_byte(text.at(at - 1)) == None;
        Continue({
          from: end,
          found: if opens && name.ends_with(b"_p") {
            s.found.insert(name.slice(0, name.len() - 2), true)
          } else { s.found },
        })
      },
    })

test "a method of a type that a module calls without importing is compiled from the module that defines it, and that module is passed to the code generator" {
  let user = [
    { name: b"m", source_text: b"fn first(xs: List<Int>) -> Int / {abort.raise} = xs.get(0)\n" },
  ];
  let shipped = [
    {
      name: b"std.list",
      source_text: b"pub fn List::get<a>(xs: List<a>, i: Int) -> a / {abort.raise} = match xs.at(i) { Some(x) -> x, None -> panic(\"no element there\") }\n",
    },
  ];
  let analysed = analyse_pulling_std_with(user, shipped, no_rows).out;
  let dump = dump_of(analysed);
  let root = Named(b"m.first");
  let p = program_of(dump, sources_in_order(dump, user.concat(shipped)), [root]);
  let places = module_levels(p);
  assert(
    match ((places.get(b"m"), places.get(b"std.list"))) { (Some(a), Some(b)) -> a > b, _ -> false },
    None,
  );
  assert_eq(outputs_of(analysed, root), [b"m.first"])
}

fn over_outcome<a>(
  analysed: AnalysisOutcome,
  body: (Analysis) -> a / {EmitReads},
) -> a / {abort.raise} =
  match analysed {
    Analysed(a) -> over_analysis(a, || body(a)),
    Rejected(_) -> panic("the program does not check"),
  }

fn outputs_of(analysed: AnalysisOutcome, root: RootKey) -> List<Bytes> / {abort.raise} =
  over_outcome(analysed, |a: Analysis|
    emit::root_outputs(emit::scope_of(a, true, [root]), [root], Map::new()).map(|r: RootOutput|
      root_text(r.name)))

test "a module's analysis record lists the standard library modules it uses without importing, such as the list module and the scheduler, and a build reads them too" {
  let user = [
    {
      name: b"m",
      source_text: b"pub fn first(xs: List<Int>) -> Int / {abort.raise, task.write} = {\n  task.yield();\n  xs.get(0)\n}\n",
    },
    { name: b"n", source_text: b"import m\npub fn one() -> Int = 1\n" },
  ];
  let shipped = [
    {
      name: b"std.list",
      source_text: b"pub fn List::get<a>(xs: List<a>, i: Int) -> a / {abort.raise} = match xs.at(i) { Some(x) -> x, None -> panic(\"no element there\") }\n",
    },
    { name: b"std.internal.schedule", source_text: b"pub fn idle() -> Int = 0\n" },
  ];
  let dump = dump_of(analyse_pulling_std_with(user, shipped, no_rows).out);
  let unimported = |module: Bytes|
    dump.modules.filter(|row: ModuleRow| row.name == module).map(|row: ModuleRow| row.unimported);
  assert_eq(unimported(b"m"), [[b"std.list", b"std.internal.schedule"]]);
  assert_eq(unimported(b"n"), [[]]);
  let p = program_of(dump, sources_in_order(dump, user.concat(shipped)), [Named(b"m.first")]);
  assert_eq(p.read.keys(), [b"m", b"std.internal.schedule", b"std.list", prelude_module])
}

test "a `law` whose body uses a type variable that the checker treats as unknown is compiled as a generic function, without a copy for each type" {
  let user = [
    {
      name: b"m",
      source_text: b"fn pair<a>(x: a) -> a = x\n\nlaw \"identity is identity\"\n  forall (x: a) {\n    pair(x) == x\n  }\n",
    },
  ];
  let root = law_key(b"m", b"identity is identity", LawBody);
  assert_eq(outputs_of(analyse(parse_all(user)), root), [printed(root)])
}

test "a build compiles the definitions requested from it, finds their compiled functions, and lists the definitions it contains" {
  let results = by_definition([{ key: b"m.f", value: one_body(b"m.f", []) }]);
  let p = fresh(
    [{ name: b"None", arity: 0 }],
    [{ ..request(b"m.f", 0), constant: true }],
    1,
    results,
    Map::new(),
    no_machine,
    part_rule,
  );
  assert_eq(p.taken, [definition_root(b"m.f")]);
  let own = statics_of(StringDatum(b"m.f")).get(0);
  let symbol = symbol_of(b"m.f");
  let entry = entry_symbol(b"m.f");
  let body = part_containing(p.text, body_of(b"m.f"));
  assert(
    body.index_of(
        Bytes::concat_all([
          body_of(b"m.f"),
          b" { return (Word)(intptr_t)&",
          own.name,
          b" + ",
          ascii_of_int(root_id(b"m.f")),
          b"; }",
        ]),
      )
      != None,
    None,
  );
  assert(body.index_of(Bytes::concat_all([b"Word ", symbol, b"(PlyCtx*);\n"])) != None, None);
  assert(body.index_of(static_defined(own)) != None, None);
  let tables = part_labelled(p.text, "tables");
  assert(tables.index_of(b"\"constants 1\" \"\\n\"\n\"m.f 0\" \"\\n\"") != None, None);
  assert(p.text.index_of(b"\"taken ") == None && p.text.index_of(b"\"lambdas ") == None, None);
  assert(
    tables.index_of(
        Bytes::concat_all([
          b"extern char ",
          entry,
          b";\nvoid *const ply_code[] = {\n  (void *)&",
          entry,
          b",\n  0 };\n",
        ]),
      )
      != None,
    None,
  );
  assert(
    part_labelled(p.text, "taken").index_of(
        Bytes::concat_all([
          b"extern char ",
          entry,
          b";\nconst struct ply_taken ply_taken[] = {\n  { \"m.f\", (void *)&",
          entry,
          b", 0 },\n  { 0, 0, 0 } };\n",
        ]),
      )
      != None,
    None,
  );
  assert(
    tables.index_of(b"(void *)ply_bind, (void *)0, ply_code, 1, ply_taken, 1 };\n") != None,
    None,
  )
}

test "a unit lists its definitions sorted by name in byte order, with each name written as a C string literal" {
  let roots = [Named(b"m.z"), EntryPoint(Named(b"m.a")), Named(b"m.B")];
  let p = fresh(
    [],
    roots.map(|k: RootKey| offer_root(k, 2)),
    1,
    roots.fold(Map::new(), |accumulator: Map<RootName, Output>, k: RootKey|
      accumulator.insert(root_name(k), one_body(printed(k), []))),
    Map::new(),
    no_machine,
    part_rule,
  );
  let row = |n: Bytes|
    Bytes::concat_all([b"  { \"", n, b"\", (void *)&", entry_symbol(n), b", 2 },\n"]);
  assert(
    p.text.index_of(
        Bytes::concat_all([
          b"ply_taken[] = {\n",
          row(b"m.B"),
          row(b"m.a#entered"),
          row(b"m.z"),
          b"  { 0, 0, 0 } };\n",
        ]),
      )
      != None,
    Some(String::of_bytes_lossy(p.text)),
  );
  let taken_struct = b"struct ply_taken { const char *name; void *entry; unsigned long arity; };\n";
  assert_eq(
    taken_part([
      {
        name: definition_root(b"m.\"q\""),
        arity: 0,
        symbol: b"f",
        entry: b"e",
        prototype: word_prototype(0),
      },
    ]),
    Bytes::concat_all([
      b"/* --- part taken --- */\n",
      taken_struct,
      b"extern char e;\n",
      b"const struct ply_taken ply_taken[] = {\n  { \"m.\\\"q\\\"\", (void *)&e, 0 },\n  { 0, 0, 0 } };\n",
    ]),
  );
  let tables = tables_part([], [], b"", 1, false);
  assert(
    tables.starts_with(b"/* --- part tables --- */\nvoid *const ply_code[] = {\n  0 };\n"),
    None,
  );
  assert(
    tables.ends_with(
      Bytes::concat_all([
        taken_struct,
        b"extern const struct ply_taken ply_taken[];\n",
        b"void ply_bind(void **fns);\n",
        b"struct ply_descriptor { const char *exports; unsigned long exports_len; void *bind; void *bind_singletons; void *const *code; unsigned long code_count; const struct ply_taken *taken; unsigned long taken_count; };\n",
        b"const struct ply_descriptor ply_descriptor = { ply_exports, sizeof ply_exports - 1, (void *)ply_bind, (void *)0, ply_code, 0, ply_taken, 1 };\n",
      ]),
    ),
    Some(String::of_bytes_lossy(tables)),
  )
}

pub fn read_of(helper: Bytes) -> Bytes = helper.concat(b"(ctx, ply_part")
