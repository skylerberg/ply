//! The try operator, rewritten with the grammar into the match it is.

import std.list
import compiler.syntax.parsing (Span, Ident, ParseDiag, bare, error_at, is_bare)
import compiler.syntax.type_syntax (TypeExpr, NamedTypeExpression, is_generic)
import compiler.syntax.items (Module, Item, FunctionItem, TestItem, LawItem, SchemaItem, TypeDef,
                              AliasBody, SumBody, SpecClause, RequiresClause, EnsuresClause,
                              CostClause, SpaceClause, NominalBody, ExternBody)
import compiler.syntax.exprs (Expr, LiteralExpression, NameExpression, BinaryExpression,
                              UnaryExpression, LambdaExpression, CallExpression, IfExpression,
                              MatchExpression, BlockExpression, RecordExpression,
                              RecordUpdateExpression, PropagateExpression, FieldExpression,
                              ListExpression, PerformExpression, HandleExpression,
                              WithHoldExpression, SimulateExpression, ParallelExpression,
                              InvalidExpression, TryBlockExpression, Stmt, LetStatement,
                              LetElseStatement, ExpressionStatement, AssignmentStatement,
                              HandlerVar, NamedArg, MatchArm, HandleClause, ReturnClause,
                              RecordLiteralField, expr_span, TaggedLiteralExpression, Hole,
                              with_hole_values, exit_effect, is_exit_effect, exit_op)
import compiler.syntax.patterns (Pattern, PatternWildcard, PatternVariable, PatternConstructor,
                                 LiteralUnit)
import std.bytes (ascii_of_int)
import compiler.expand.rewrite.shared (max_alias_depth, collect_types, find_type, is_pure,
                                       own_binding_among, count_in)
import compiler.check.known (ok_ctor, err_ctor, some_ctor, none_ctor, result_name, option_name)

// --- Record update -----------------------------------------------------------------------

// `{..b, f: e}` is the literal it stands for. The shape it copies is the checker's answer for the
// base, keyed by the update's span, so this runs after the check and not with the other rewrites.

fn too_deep() -> Bytes =
  Bytes::concat_all([b"more than ", ascii_of_int(max_alias_depth()), b" type aliases deep"])

// --- The try operator ------------------------------------------------------------------------

type TryMode = | TryResult | TryOption

/// `shadowed` is the note for a module whose own `Ok`/`Err`/`Some`/`None` would capture the expansion.
/// `exit` is the effect a `?` raises to leave the `handle` it stands in, while one is expanded;
/// `exits` numbers the item's functions and typed lambdas, written at `item_start`, that `?` exits.
type TryState = {
  types: List<TypeDef>,
  shadowed: Option<Bytes>,
  diags: List<ParseDiag>,
  mode: Option<TryMode>,
  fresh: Int,
  exit: Option<Bytes>,
  exits: Int,
  item_start: Int,
}

type Lift = { operand: Expr, binder: Ident, at: Span }

type Scan = | ScanFound(Lift) | ScanPure | ScanImpure

type ScanResult = { state: TryState, scan: Scan, expr: Expr }

type TryOutput = { state: TryState, expr: Expr }

fn shadowing_ctor(module: Module) -> Option<Bytes> =
  match own_binding_among(module, [ok_ctor(), err_ctor(), some_ctor(), none_ctor()]) {
    None -> None,
    Some(own) ->
      Some(if own.imported {
        Bytes::concat_all([
          b"this module imports `",
          own.name,
          b"` unqualified, which would capture the `match` `?` expands to; import the module instead and qualify the name, or write the `match` out",
        ])
      } else {
        Bytes::concat_all([
          b"this module declares its own `",
          own.name,
          b"`, which would capture the `match` `?` expands to; rename it, or write the `match` out",
        ])
      }),
  }

fn unreadable() -> Bytes =
  b"the return type has no head constructor this file can read: a type parameter and a generic alias have none until they are applied"

fn not_result_or_option(head: Bytes) -> Bytes =
  Bytes::concat_all([
    b"this function returns `",
    head,
    b"`; `?` binds a `Result` inside a function returning `Result`, or an `Option` inside one returning `Option`, because those are the constructors it expands to",
  ])

fn no_return_type() -> Bytes =
  b"this function writes no `->`, and `?` reads which constructors to name off the written return type; write one"

fn not_in_a_function(what: Bytes) -> Bytes =
  what.concat(b" has no written return type, and `?` needs one")

fn mode_of(state: TryState, ty: TypeExpr, depth: Int) -> Result<TryMode, Bytes> =
  if depth > max_alias_depth() { Err(too_deep()) } else {
    match ty {
      NamedTypeExpression(c) -> if !is_bare(c.name) {
        Err(
          b"the return type is named through another module, and `?` reads only this file \xe2\x80\x94 a meaning read across a module boundary would go stale in a file that never changed",
        )
      } else if c.name.name.name == result_name() { Ok(TryResult) }
      else if c.name.name.name == option_name() { Ok(TryOption) } else {
        let n = c.name.name.name;
        match find_type(state.types, n) {
          None -> Err(not_result_or_option(n)),
          Some(d) -> if is_generic(d.generics) { Err(unreadable()) } else {
            match d.body {
              SumBody(_) -> Err(not_result_or_option(n)),
              NominalBody(_) -> Err(not_result_or_option(n)),
              ExternBody -> Err(not_result_or_option(n)),
              AliasBody(inner) -> mode_of(state, inner, depth + 1),
            }
          },
        }
      },
      _ -> Err(unreadable()),
    }
  }

fn mode_for(state: TryState, return_position: Option<TypeExpr>) -> Result<TryMode, Bytes> =
  match state.shadowed {
    Some(why) -> Err(why),
    None -> match return_position {
      None -> Err(no_return_type()),
      Some(ty) -> mode_of(state, ty, 0),
    },
  }

/// The outermost barrier is the one named.
fn outermost_barrier(barrier: Option<Bytes>, what: Bytes) -> Option<Bytes> =
  match barrier { Some(_) -> barrier, None -> Some(what) }

fn made_at(at: Span) -> Span = { ..at, site: 0 }

fn fresh_binder(state: TryState, span: Span) -> { state: TryState, binder: Ident } =
  {
    state: { ..state, fresh: state.fresh + 1 },
    binder: { name: b"?".concat(Bytes::of_string(state.fresh.to_string())), span: made_at(span) },
  }

pub fn var_of(name: Ident) -> Expr = NameExpression({ span: name.span, name: bare(name) })

pub fn var_pattern(name: Ident) -> Pattern = PatternVariable({ span: name.span, name: name })

pub fn ctor_pattern(name: Bytes, args: List<Pattern>, span: Span) -> Pattern =
  PatternConstructor({
    span: made_at(span),
    name: bare({ name: name, span: made_at(span) }),
    args: args,
  })

/// Where the constructor a `?` written at `at` hands its failure on by stands: the `?` itself, a
/// place of its own, which the checker files the constructor's type at as it does a written one's.
fn failure_span(at: Span) -> Span =
  made_at(if at.end > at.start { { ..at, start: at.end - 1 } } else { at })

/// The raise of `exit` a `?` written at `span` leaves its `handle` by, carrying `value`.
fn exit_raise(exit: Bytes, span: Span, value: Expr) -> Expr = {
  let at = failure_span(span);
  PerformExpression({
    span: at,
    effect_name: bare({ name: exit, span: at }),
    op: { name: exit_op(), span: at },
    resource: None,
    args: [value],
  })
}

/// `match operand { <failure>, <success>(pat) -> body }`, failure arm first. Inside a `handle`
/// the failure leaves it by `state.exit`, carrying what the function or lambda would answer
/// beside the constructor.
fn try_match(
  state: TryState,
  operand: Expr,
  span: Span,
  pat: Pattern,
  body: Expr,
) -> TryOutput / {abort.raise} = {
  let mode = match state.mode {
    Some(m) -> m,
    None -> panic("a mode is established before any lift"),
  };
  match mode {
    TryResult -> {
      let fresh = fresh_binder(state, span);
      let fail_pat = ctor_pattern(err_ctor(), [var_pattern(fresh.binder)], span);
      let fail_body = match state.exit {
        Some(exit) -> exit_raise(exit, span, var_of(fresh.binder)),
        None ->
          CallExpression({
            span: made_at(span),
            func: var_of({ name: err_ctor(), span: failure_span(span) }),
            args: [var_of(fresh.binder)],
            named: [],
            labels: [],
          }),
      };
      {
        state: fresh.state,
        expr: MatchExpression({
          span: span,
          scrutinee: operand,
          arms: [
            { pat: fail_pat, guard: None, body: fail_body, span: made_at(span) },
            {
              pat: ctor_pattern(ok_ctor(), [pat], span),
              guard: None,
              body: body,
              span: made_at(span),
            },
          ],
        }),
      }
    },
    TryOption -> {
      let fail_pat = ctor_pattern(none_ctor(), [], span);
      let fail_body = match state.exit {
        Some(exit) ->
          exit_raise(exit, span, LiteralExpression({ span: failure_span(span), lit: LiteralUnit })),
        None -> var_of({ name: none_ctor(), span: failure_span(span) }),
      };
      {
        state: state,
        expr: MatchExpression({
          span: span,
          scrutinee: operand,
          arms: [
            { pat: fail_pat, guard: None, body: fail_body, span: made_at(span) },
            {
              pat: ctor_pattern(some_ctor(), [pat], span),
              guard: None,
              body: body,
              span: made_at(span),
            },
          ],
        }),
      }
    },
  }
}

fn purity(pure: Bool) -> Scan = if pure { ScanPure } else { ScanImpure }

type SequenceResult = { state: TryState, scan: Scan, exprs: List<Expr> }

/// Sub-expressions left to right, stopping at the first `?` and at the first impure one.
fn sequence(state: TryState, parts: List<Expr>) -> SequenceResult / {abort.raise} =
  sequence_on({ state: state, scan: ScanPure, exprs: [] }, parts)

/// `sequence` going on from where one over the sub-expressions before `parts` stopped.
fn sequence_on(before: SequenceResult, parts: List<Expr>) -> SequenceResult / {abort.raise} =
  parts.fold(before, |acc: SequenceResult, expr: Expr|
    match acc.scan {
      ScanPure -> {
        let o = scan(acc.state, expr);
        { state: o.state, scan: o.scan, exprs: acc.exprs.push(o.expr) }
      },
      _ -> { ..acc, exprs: acc.exprs.push(expr) },
    })

/// Lifts the first `?` reachable in evaluation order, leaving its binder in its place.
fn scan(state: TryState, expr: Expr) -> ScanResult / {abort.raise} =
  match expr {
    LiteralExpression(_) -> { state: state, scan: ScanPure, expr: expr },
    NameExpression(_) -> { state: state, scan: ScanPure, expr: expr },
    InvalidExpression(_) -> { state: state, scan: ScanPure, expr: expr },
    PropagateExpression(t) -> {
      let inner = scan(state, t.operand);
      match inner.scan {
        ScanFound(_) ->
          {
            state: inner.state,
            scan: inner.scan,
            expr: PropagateExpression({ span: t.span, operand: inner.expr }),
          },
        _ -> {
          let fresh = fresh_binder(inner.state, t.span);
          {
            state: fresh.state,
            scan: ScanFound({ operand: inner.expr, binder: fresh.binder, at: t.span }),
            expr: var_of(fresh.binder),
          }
        },
      }
    },
    BinaryExpression(b) -> {
      let short = b.op == b"and" || b.op == b"or";
      let l = scan(state, b.lhs);
      match l.scan {
        ScanFound(_) ->
          {
            state: l.state,
            scan: l.scan,
            expr: BinaryExpression({ span: b.span, op: b.op, lhs: l.expr, rhs: b.rhs }),
          },
        ScanImpure -> { state: l.state, scan: ScanImpure, expr: expr },
        ScanPure -> if short { { state: l.state, scan: purity(is_pure(b.rhs)), expr: expr } } else {
          let r = scan(l.state, b.rhs);
          {
            state: r.state,
            scan: r.scan,
            expr: BinaryExpression({ span: b.span, op: b.op, lhs: l.expr, rhs: r.expr }),
          }
        },
      }
    },
    UnaryExpression(u) -> {
      let o = scan(state, u.operand);
      {
        state: o.state,
        scan: o.scan,
        expr: UnaryExpression({ span: u.span, op: u.op, operand: o.expr }),
      }
    },
    CallExpression(a) -> {
      let o = sequence_on(
        sequence_on(sequence(state, [a.func]), a.args),
        a.named.map(|n: NamedArg| n.value),
      );
      let func = o.exprs.get(0);
      let args = o.exprs.drop(1).take(a.args.len());
      let nvals = o.exprs.drop(1 + a.args.len());
      let named = range(0, a.named.len()).map(|i: Int| {
        let n = a.named.get(i);
        { name: n.name, value: nvals.get(i), span: n.span }
      });
      let rebuilt = CallExpression({
        span: a.span,
        func: func,
        named: named,
        args: args,
        labels: a.labels,
      });
      match o.scan {
        ScanFound(_) -> { state: o.state, scan: o.scan, expr: rebuilt },
        _ -> { state: o.state, scan: ScanImpure, expr: rebuilt },
      }
    },
    PerformExpression(p) -> {
      let o = sequence(state, p.args);
      let rebuilt = PerformExpression({
        span: p.span,
        effect_name: p.effect_name,
        op: p.op,
        resource: p.resource,
        args: o.exprs,
      });
      match o.scan {
        ScanFound(_) -> { state: o.state, scan: o.scan, expr: rebuilt },
        _ -> { state: o.state, scan: ScanImpure, expr: rebuilt },
      }
    },
    RecordExpression(r) -> {
      let o = sequence(state, r.fields.map(|f: RecordLiteralField| f.value));
      {
        state: o.state,
        scan: o.scan,
        expr: RecordExpression({
          span: r.span,
          fields: range(0, r.fields.len()).map(|i: Int|
            { name: r.fields.get(i).name, value: o.exprs.get(i) }),
        }),
      }
    },
    ListExpression(l) -> {
      let o = sequence(state, l.items);
      { state: o.state, scan: o.scan, expr: ListExpression({ span: l.span, items: o.exprs }) }
    },
    FieldExpression(f) -> {
      let o = scan(state, f.base);
      {
        state: o.state,
        scan: o.scan,
        expr: FieldExpression({ span: f.span, base: o.expr, field: f.field }),
      }
    },
    RecordUpdateExpression(r) -> {
      let o = sequence_on(sequence(state, [r.base]), r.fields.map(|f: RecordLiteralField| f.value));
      {
        state: o.state,
        scan: o.scan,
        expr: RecordUpdateExpression({
          span: r.span,
          base: o.exprs.get(0),
          fields: range(0, r.fields.len()).map(|i: Int|
            { name: r.fields.get(i).name, value: o.exprs.get(i + 1) }),
        }),
      }
    },
    IfExpression(i) -> {
      let c = scan(state, i.cond);
      let rebuilt = IfExpression({
        span: i.span,
        cond: c.expr,
        then_branch: i.then_branch,
        else_branch: i.else_branch,
      });
      match c.scan {
        ScanFound(_) -> { state: c.state, scan: c.scan, expr: rebuilt },
        ScanImpure -> { state: c.state, scan: ScanImpure, expr: rebuilt },
        ScanPure ->
          {
            state: c.state,
            scan: purity(is_pure(i.then_branch) && is_pure(i.else_branch)),
            expr: rebuilt,
          },
      }
    },
    MatchExpression(m) -> {
      let sc = scan(state, m.scrutinee);
      let rebuilt = MatchExpression({ span: m.span, scrutinee: sc.expr, arms: m.arms });
      match sc.scan {
        ScanFound(_) -> { state: sc.state, scan: sc.scan, expr: rebuilt },
        ScanImpure -> { state: sc.state, scan: ScanImpure, expr: rebuilt },
        ScanPure ->
          {
            state: sc.state,
            scan: purity(
              m.arms.fold(true, |acc: Bool, arm: MatchArm|
                acc && is_pure(arm.body)
                  && (match arm.guard { None -> true, Some(g) -> is_pure(g) })),
            ),
            expr: rebuilt,
          },
      }
    },
    TaggedLiteralExpression(t) -> {
      let o = sequence(state, t.holes.map(|h: Hole| h.value));
      let rebuilt = TaggedLiteralExpression(with_hole_values(t, o.exprs));
      match o.scan {
        ScanFound(_) -> { state: o.state, scan: o.scan, expr: rebuilt },
        _ -> { state: o.state, scan: purity(t.holes.len() == 0), expr: rebuilt },
      }
    },
    // A nested block is not entered; a lambda, handler, region, `simulate` or `parallel` is a barrier
    // to `?`.
    _ -> { state: state, scan: purity(is_pure(expr)), expr: expr },
  }

/// One `match` per `?` lifted from `expr`'s head, with the rewritten `expr` as the success arm's body.
/// `remaining` is how many `?` are left to lift: each lift takes one away and none is copied.
fn lift_from_head(state: TryState, expr: Expr, remaining: Int) -> TryOutput / {abort.raise} = {
  let found = scan_head(state, expr);
  match found.scan {
    ScanFound(l) -> {
      let w = try_match(found.state, l.operand, l.at, var_pattern(l.binder), found.expr);
      match w.expr {
        MatchExpression(m) -> {
          let success = m.arms.get(1);
          let inner = if remaining <= 0 { panic(lifted_past()) }
          else { lift_from_head(w.state, success.body, remaining - 1) };
          {
            state: inner.state,
            expr: MatchExpression({
              span: m.span,
              scrutinee: m.scrutinee,
              arms: [
                m.arms.get(0),
                { pat: success.pat, guard: None, body: inner.expr, span: success.span },
              ],
            }),
          }
        },
        _ -> w,
      }
    },
    _ -> { state: found.state, expr: found.expr },
  }
}

fn scan_head(state: TryState, expr: Expr) -> ScanResult / {abort.raise} =
  match expr {
    IfExpression(i) -> {
      let c = scan(state, i.cond);
      {
        state: c.state,
        scan: c.scan,
        expr: IfExpression({
          span: i.span,
          cond: c.expr,
          then_branch: i.then_branch,
          else_branch: i.else_branch,
        }),
      }
    },
    MatchExpression(m) -> {
      let sc = scan(state, m.scrutinee);
      {
        state: sc.state,
        scan: sc.scan,
        expr: MatchExpression({ span: m.span, scrutinee: sc.expr, arms: m.arms }),
      }
    },
    _ -> scan(state, expr),
  }

fn lifted_past() -> String = "a `?` lifted past the ones written"

/// An expression in return position, with `remaining` as in `lift_from_head`.
fn return_position(state: TryState, expr: Expr, remaining: Int) -> TryOutput / {abort.raise} =
  match expr {
    BlockExpression(_) -> return_block(state, expr, remaining),
    IfExpression(i) -> {
      let t = return_position(state, i.then_branch, remaining);
      let el = return_position(t.state, i.else_branch, remaining);
      lift_from_head(
        el.state,
        IfExpression({ span: i.span, cond: i.cond, then_branch: t.expr, else_branch: el.expr }),
        remaining,
      )
    },
    MatchExpression(m) -> {
      let arms = m.arms.fold(
        { state: state, arms: [] },
        |acc: { state: TryState, arms: List<MatchArm> }, arm: MatchArm| {
          let b = return_position(acc.state, arm.body, remaining);
          {
            state: b.state,
            arms: acc.arms.push({ pat: arm.pat, guard: arm.guard, body: b.expr, span: arm.span }),
          }
        },
      );
      lift_from_head(
        arms.state,
        MatchExpression({ span: m.span, scrutinee: m.scrutinee, arms: arms.arms }),
        remaining,
      )
    },
    _ -> lift_from_head(state, expr, remaining),
  }

/// A block in return position: split at the first statement a `?` can be lifted from.
fn return_block(state: TryState, expr: Expr, remaining: Int) -> TryOutput / {abort.raise} =
  match expr {
    BlockExpression(b) -> {
      let split = range(0, b.stmts.len()).fold(
        { state: state, stmts: b.stmts, tail: b.tail, done: false },
        |acc: { state: TryState, stmts: List<Stmt>, tail: Option<Expr>, done: Bool }, i: Int|
          if acc.done { acc } else {
            let o = split_at(acc.state, acc.stmts, acc.tail, i, b.stmts.get(i), remaining);
            match o.split {
              None -> { state: o.state, stmts: o.stmts, tail: acc.tail, done: false },
              Some(t) -> { state: o.state, stmts: o.stmts.take(i), tail: Some(t), done: true },
            }
          },
      );
      if split.done {
        {
          state: split.state,
          expr: BlockExpression({ span: b.span, tail: split.tail, stmts: split.stmts }),
        }
      } else {
        match b.tail {
          None ->
            {
              state: split.state,
              expr: BlockExpression({ span: b.span, tail: None, stmts: split.stmts }),
            },
          Some(t) -> {
            let o = return_position(split.state, t, remaining);
            {
              state: o.state,
              expr: BlockExpression({ span: b.span, tail: Some(o.expr), stmts: split.stmts }),
            }
          },
        }
      }
    },
    _ -> panic("only called on a block"),
  }

type StatementLift = {
  state: TryState,
  stmt: Stmt,
  take: Option<{ operand: Expr, at: Span, pat: Pattern, consumes: Bool }>,
}

/// `st` is `stmts`' `i`th as written: only the ones before it are rewritten yet.
fn split_at(
  state: TryState,
  stmts: List<Stmt>,
  tail: Option<Expr>,
  i: Int,
  st: Stmt,
  remaining: Int,
) -> { state: TryState, stmts: List<Stmt>, split: Option<Expr> } / {abort.raise} = {
  let taken = lift_from_statement(state, st, remaining);
  match taken.take {
    None -> { state: taken.state, stmts: stmts.set(i, taken.stmt), split: None },
    Some(t) -> {
      let kept = stmts.set(i, taken.stmt);
      let rest = kept.drop(if t.consumes { i + 1 } else { i });
      // A consumed statement goes: its binder is now the success arm's pattern.
      let body0 = BlockExpression({ span: made_at(t.at), tail: tail, stmts: rest });
      let body = if remaining <= 0 { panic(lifted_past()) }
      else { return_block(taken.state, body0, remaining - 1) };
      let w = try_match(body.state, t.operand, t.at, t.pat, body.expr);
      { state: w.state, stmts: kept, split: Some(w.expr) }
    },
  }
}

fn lift_from_statement(
  state: TryState,
  stmt: Stmt,
  remaining: Int,
) -> StatementLift / {abort.raise} =
  match stmt {
    // Never consumed, since its pattern is not the success arm's. Its `else` block is the block's
    // value, so it is a return position: expanded once, when no `?` is left in the initializer.
    LetElseStatement(l) -> match l.value {
      PropagateExpression(t) -> {
        let fresh = fresh_binder(state, t.span);
        let o = lift_try(fresh.state, t.operand, t.span, var_pattern(fresh.binder));
        if o.take.consumes {
          {
            state: o.state,
            stmt: LetElseStatement({ ..l, value: var_of(fresh.binder) }),
            take: Some({
              operand: o.take.operand,
              at: o.take.at,
              pat: o.take.pat,
              consumes: false,
            }),
          }
        } else {
          {
            state: o.state,
            stmt: LetElseStatement({
              ..l,
              value: PropagateExpression({ span: t.span, operand: o.remaining_operand }),
            }),
            take: Some(o.take),
          }
        }
      },
      _ -> {
        let o = scan(state, l.value);
        match o.scan {
          ScanFound(lift) ->
            {
              state: o.state,
              stmt: LetElseStatement({ ..l, value: o.expr }),
              take: Some({
                operand: lift.operand,
                at: lift.at,
                pat: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> {
            let f = return_position(o.state, l.fallback, remaining);
            { state: f.state, stmt: LetElseStatement({ ..l, fallback: f.expr }), take: None }
          },
        }
      },
    },
    LetStatement(l) -> match l.value {
      PropagateExpression(t) -> match l.ty {
        // The annotation stays: the `let` now binds the success arm's binder.
        Some(_) -> {
          let fresh = fresh_binder(state, t.span);
          let o = lift_try(fresh.state, t.operand, t.span, var_pattern(fresh.binder));
          if o.take.consumes {
            {
              state: o.state,
              stmt: LetStatement({
                span: l.span,
                pat: l.pat,
                ty: l.ty,
                value: var_of(fresh.binder),
              }),
              take: Some({
                operand: o.take.operand,
                at: o.take.at,
                pat: o.take.pat,
                consumes: false,
              }),
            }
          } else {
            {
              state: o.state,
              stmt: LetStatement({
                span: l.span,
                pat: l.pat,
                ty: l.ty,
                value: PropagateExpression({ span: t.span, operand: o.remaining_operand }),
              }),
              take: Some(o.take),
            }
          }
        },
        None -> {
          let o = lift_try(state, t.operand, t.span, l.pat);
          {
            state: o.state,
            stmt: LetStatement({
              span: l.span,
              pat: l.pat,
              ty: None,
              value: PropagateExpression({ span: t.span, operand: o.remaining_operand }),
            }),
            take: Some(o.take),
          }
        },
      },
      _ -> {
        let o = scan(state, l.value);
        match o.scan {
          ScanFound(lift) ->
            {
              state: o.state,
              stmt: LetStatement({ span: l.span, pat: l.pat, ty: l.ty, value: o.expr }),
              take: Some({
                operand: lift.operand,
                at: lift.at,
                pat: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> { state: o.state, stmt: stmt, take: None },
        }
      },
    },
    AssignmentStatement(a) -> match a.value {
      PropagateExpression(t) -> {
        let fresh = fresh_binder(state, t.span);
        let o = lift_try(fresh.state, t.operand, t.span, var_pattern(fresh.binder));
        if o.take.consumes {
          {
            state: o.state,
            stmt: AssignmentStatement({ ..a, value: var_of(fresh.binder) }),
            take: Some({
              operand: o.take.operand,
              at: o.take.at,
              pat: o.take.pat,
              consumes: false,
            }),
          }
        } else {
          {
            state: o.state,
            stmt: AssignmentStatement({
              ..a,
              value: PropagateExpression({ span: t.span, operand: o.remaining_operand }),
            }),
            take: Some(o.take),
          }
        }
      },
      _ -> {
        let o = scan(state, a.value);
        match o.scan {
          ScanFound(lift) ->
            {
              state: o.state,
              stmt: AssignmentStatement({ ..a, value: o.expr }),
              take: Some({
                operand: lift.operand,
                at: lift.at,
                pat: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> { state: o.state, stmt: stmt, take: None },
        }
      },
    },
    ExpressionStatement(v) -> match v {
      PropagateExpression(t) -> {
        let o = lift_try(state, t.operand, t.span, PatternWildcard({ span: v_span(v) }));
        {
          state: o.state,
          stmt: ExpressionStatement(
            PropagateExpression({ span: t.span, operand: o.remaining_operand }),
          ),
          take: Some(o.take),
        }
      },
      _ -> {
        let o = scan(state, v);
        match o.scan {
          ScanFound(lift) ->
            {
              state: o.state,
              stmt: ExpressionStatement(o.expr),
              take: Some({
                operand: lift.operand,
                at: lift.at,
                pat: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> { state: o.state, stmt: stmt, take: None },
        }
      },
    },
  }

fn v_span(expr: Expr) -> Span = expr_span(expr)

type TryLift = {
  state: TryState,
  remaining_operand: Expr,
  take: { operand: Expr, at: Span, pat: Pattern, consumes: Bool },
}

/// An inner `?` in the operand is lifted first and the statement stays; otherwise the statement is consumed.
fn lift_try(state: TryState, operand: Expr, span: Span, pat: Pattern) -> TryLift / {abort.raise} = {
  let o = scan(state, operand);
  match o.scan {
    ScanFound(lift) ->
      {
        state: o.state,
        remaining_operand: o.expr,
        take: {
          operand: lift.operand,
          at: lift.at,
          pat: var_pattern(lift.binder),
          consumes: false,
        },
      },
    _ ->
      {
        state: o.state,
        remaining_operand: LiteralExpression({ span: made_at(span), lit: LiteralUnit }),
        take: { operand: o.expr, at: span, pat: pat, consumes: true },
      },
  }
}

// --- A `?` inside a `handle` -------------------------------------------------------------------

// Inside a `handle` or a `try`, in a return position of its body, a clause or its `return`, a `?`
// leaves by a raise of the effect its function or typed lambda exits by (`exit_effect`), carrying
// the failure. The outermost `handle` holding such a `?` is written as the operand of a `?` of its
// own, inside a `handle` whose one clause answers the raise with that failure, so the function
// leaves where the `handle` stands, as it would by a `?` written there.

/// `body`, a function's or a typed lambda's, which `?` exits by `state.mode`, with each outermost
/// `handle` or `try` holding a `?` written out to leave through it.
fn lift_exits(state: TryState, body: Expr) -> TryOutput / {abort.raise} =
  exits_in(
    { ..state, exits: state.exits + 1 },
    exit_effect(state.item_start, state.exits),
    true,
    body,
  )

/// `expr` with each `handle` or `try` in it holding a `?` written out to leave by `exit`, wrapped
/// where `outermost`. A lambda's body, a `with_hold`'s, a `simulate`'s and a `parallel` branch are
/// not entered: a `?` there exits no `handle` around them.
fn exits_in(
  state: TryState,
  exit: Bytes,
  outermost: Bool,
  expr: Expr,
) -> TryOutput / {abort.raise} =
  match expr {
    HandleExpression(_) -> handle_exits(state, exit, outermost, expr),
    TryBlockExpression(_) -> handle_exits(state, exit, outermost, expr),
    BinaryExpression(b) -> {
      let l = exits_in(state, exit, outermost, b.lhs);
      let r = exits_in(l.state, exit, outermost, b.rhs);
      { state: r.state, expr: BinaryExpression({ ..b, lhs: l.expr, rhs: r.expr }) }
    },
    UnaryExpression(u) -> {
      let o = exits_in(state, exit, outermost, u.operand);
      { state: o.state, expr: UnaryExpression({ ..u, operand: o.expr }) }
    },
    CallExpression(a) -> {
      let f = exits_in(state, exit, outermost, a.func);
      let args = exits_all(f.state, exit, outermost, a.args);
      let named = a.named.fold(
        { state: args.state, args: [] },
        |acc: { state: TryState, args: List<NamedArg> }, arg: NamedArg| {
          let o = exits_in(acc.state, exit, outermost, arg.value);
          { state: o.state, args: acc.args.push({ ..arg, value: o.expr }) }
        },
      );
      {
        state: named.state,
        expr: CallExpression({ ..a, func: f.expr, args: args.exprs, named: named.args }),
      }
    },
    IfExpression(i) -> {
      let c = exits_in(state, exit, outermost, i.cond);
      let t = exits_in(c.state, exit, outermost, i.then_branch);
      let el = exits_in(t.state, exit, outermost, i.else_branch);
      {
        state: el.state,
        expr: IfExpression({ ..i, cond: c.expr, then_branch: t.expr, else_branch: el.expr }),
      }
    },
    MatchExpression(m) -> {
      let sc = exits_in(state, exit, outermost, m.scrutinee);
      let arms = m.arms.fold(
        { state: sc.state, arms: [] },
        |acc: { state: TryState, arms: List<MatchArm> }, arm: MatchArm| {
          let g = match arm.guard {
            None -> { state: acc.state, expr: None },
            Some(x) -> {
              let o = exits_in(acc.state, exit, outermost, x);
              { state: o.state, expr: Some(o.expr) }
            },
          };
          let b = exits_in(g.state, exit, outermost, arm.body);
          { state: b.state, arms: acc.arms.push({ ..arm, guard: g.expr, body: b.expr }) }
        },
      );
      { state: arms.state, expr: MatchExpression({ ..m, scrutinee: sc.expr, arms: arms.arms }) }
    },
    BlockExpression(b) -> {
      let stmts = b.stmts.fold(
        { state: state, stmts: [] },
        |acc: { state: TryState, stmts: List<Stmt> }, stmt: Stmt|
          match stmt {
            LetStatement(l) -> {
              let o = exits_in(acc.state, exit, outermost, l.value);
              { state: o.state, stmts: acc.stmts.push(LetStatement({ ..l, value: o.expr })) }
            },
            LetElseStatement(l) -> {
              let v = exits_in(acc.state, exit, outermost, l.value);
              let f = exits_in(v.state, exit, outermost, l.fallback);
              {
                state: f.state,
                stmts: acc.stmts.push(LetElseStatement({ ..l, value: v.expr, fallback: f.expr })),
              }
            },
            ExpressionStatement(x) -> {
              let o = exits_in(acc.state, exit, outermost, x);
              { state: o.state, stmts: acc.stmts.push(ExpressionStatement(o.expr)) }
            },
            AssignmentStatement(x) -> {
              let o = exits_in(acc.state, exit, outermost, x.value);
              { state: o.state, stmts: acc.stmts.push(AssignmentStatement({ ..x, value: o.expr })) }
            },
          },
      );
      let tl = match b.tail {
        None -> { state: stmts.state, expr: None },
        Some(t) -> {
          let o = exits_in(stmts.state, exit, outermost, t);
          { state: o.state, expr: Some(o.expr) }
        },
      };
      { state: tl.state, expr: BlockExpression({ ..b, tail: tl.expr, stmts: stmts.stmts }) }
    },
    RecordExpression(r) -> {
      let o = exits_fields(state, exit, outermost, r.fields);
      { state: o.state, expr: RecordExpression({ ..r, fields: o.fields }) }
    },
    RecordUpdateExpression(r) -> {
      let b = exits_in(state, exit, outermost, r.base);
      let o = exits_fields(b.state, exit, outermost, r.fields);
      { state: o.state, expr: RecordUpdateExpression({ ..r, base: b.expr, fields: o.fields }) }
    },
    PropagateExpression(t) -> {
      let o = exits_in(state, exit, outermost, t.operand);
      { state: o.state, expr: PropagateExpression({ ..t, operand: o.expr }) }
    },
    FieldExpression(f) -> {
      let o = exits_in(state, exit, outermost, f.base);
      { state: o.state, expr: FieldExpression({ ..f, base: o.expr }) }
    },
    ListExpression(l) -> {
      let o = exits_all(state, exit, outermost, l.items);
      { state: o.state, expr: ListExpression({ ..l, items: o.exprs }) }
    },
    PerformExpression(p) -> {
      let o = exits_all(state, exit, outermost, p.args);
      { state: o.state, expr: PerformExpression({ ..p, args: o.exprs }) }
    },
    TaggedLiteralExpression(t) -> {
      let o = exits_all(state, exit, outermost, t.holes.map(|h: Hole| h.value));
      { state: o.state, expr: TaggedLiteralExpression(with_hole_values(t, o.exprs)) }
    },
    _ -> { state: state, expr: expr },
  }

fn exits_all(
  state: TryState,
  exit: Bytes,
  outermost: Bool,
  exprs: List<Expr>,
) -> { state: TryState, exprs: List<Expr> } / {abort.raise} =
  exprs.fold(
    { state: state, exprs: [] },
    |acc: { state: TryState, exprs: List<Expr> }, expr: Expr| {
      let o = exits_in(acc.state, exit, outermost, expr);
      { state: o.state, exprs: acc.exprs.push(o.expr) }
    },
  )

fn exits_fields(
  state: TryState,
  exit: Bytes,
  outermost: Bool,
  fields: List<RecordLiteralField>,
) -> { state: TryState, fields: List<RecordLiteralField> } / {abort.raise} =
  fields.fold(
    { state: state, fields: [] },
    |acc: { state: TryState, fields: List<RecordLiteralField> }, field: RecordLiteralField| {
      let o = exits_in(acc.state, exit, outermost, field.value);
      { state: o.state, fields: acc.fields.push({ ..field, value: o.expr }) }
    },
  )

/// `part` of a `handle` or a `try`, its body, a clause's or its `return`'s, with each `?` in it
/// that a return position of it, or of a `handle` inside it, holds leaving by `exit`.
fn exits_through(state: TryState, exit: Bytes, part: Expr) -> TryOutput / {abort.raise} = {
  let nested = exits_in(state, exit, false, part);
  return_position({ ..nested.state, exit: Some(exit) }, nested.expr, tries_in(nested.expr))
}

/// `expr`, a `handle` or a `try`, with each `?` its parts hold leaving by `exit`; the `outermost`
/// one holding any, written as the operand of a `?` around the `handle` that answers the raise.
fn handle_exits(
  state: TryState,
  exit: Bytes,
  outermost: Bool,
  expr: Expr,
) -> TryOutput / {abort.raise} = {
  let parts: TryOutput = match expr {
    HandleExpression(h) -> {
      let b = exits_through(state, exit, h.body);
      let cs = h.clauses.fold(
        { state: b.state, clauses: [] },
        |acc: { state: TryState, clauses: List<HandleClause> }, c: HandleClause| {
          let o = exits_through(acc.state, exit, c.body);
          { state: o.state, clauses: acc.clauses.push({ ..c, body: o.expr }) }
        },
      );
      let r: { state: TryState, ret: Option<ReturnClause> } = match h.ret {
        None -> { state: cs.state, ret: None },
        Some(rc) -> {
          let o = exits_through(cs.state, exit, rc.body);
          { state: o.state, ret: Some({ ..rc, body: o.expr }) }
        },
      };
      {
        state: r.state,
        expr: HandleExpression({ ..h, body: b.expr, clauses: cs.clauses, ret: r.ret }),
      }
    },
    TryBlockExpression(t) -> {
      let b = exits_through(state, exit, t.body);
      { state: b.state, expr: TryBlockExpression({ ..t, body: b.expr }) }
    },
    _ -> { state: state, expr: expr },
  };
  let left = { ..parts.state, exit: state.exit };
  // Each `?` lifted takes a fresh binder, so one that took none holds no `?` that exits through it.
  if parts.state.fresh == state.fresh { { state: left, expr: expr } }
  else if !outermost { { state: left, expr: parts.expr } }
  else { catch_exit(left, exit, parts.expr) }
}

/// The `?` of the `handle` around `h` answering `exit`: its one clause answers the failure the
/// raise carried, and its body `h`'s answer as the success.
fn catch_exit(state: TryState, exit: Bytes, h: Expr) -> TryOutput / {abort.raise} = {
  let span = made_at(expr_span(h));
  let fresh = fresh_binder(state, span);
  let named = |n: Bytes| var_of({ name: n, span: span });
  let called = |n: Bytes, x: Expr|
    CallExpression({ span: span, func: named(n), args: [x], named: [], labels: [] });
  let answered = match state.mode {
    Some(TryOption) -> { ok: called(some_ctor(), h), failed: named(none_ctor()) },
    _ -> { ok: called(ok_ctor(), h), failed: called(err_ctor(), var_of(fresh.binder)) },
  };
  {
    state: fresh.state,
    expr: PropagateExpression({
      span: span,
      operand: HandleExpression({
        span: span,
        body: answered.ok,
        ret: None,
        clauses: [
          {
            effect_name: bare({ name: exit, span: span }),
            op: { name: exit_op(), span: span },
            resource: None,
            every_label: false,
            label_binder: None,
            resume: None,
            body: answered.failed,
            span: span,
            params: [fresh.binder],
          },
        ],
        vars: [],
      }),
    }),
  }
}

/// Whether `operand` is the `handle` `catch_exit` writes around one holding a `?`.
fn catches_exit(operand: Expr) -> Bool =
  match operand {
    HandleExpression(h) -> h.clauses.any(|c: HandleClause| is_exit_effect(c.effect_name.name.name)),
    _ -> false,
  }

/// What a `handle`'s or a `try`'s parts stand behind as `sweep` reads them: no more than `barrier`
/// where a `?` there exits the function or typed lambda through it, else the `handle` too.
fn barrier_for_parts(state: TryState, barrier: Option<Bytes>, what: Bytes) -> Option<Bytes> =
  if state.mode == None { outermost_barrier(barrier, what) } else { barrier }

/// Refuses and unwraps every `?` left in `expr`: `E0118` when `scope` or `barrier` says why, else `E0119`.
fn sweep(
  state: TryState,
  expr: Expr,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
) -> TryOutput / {abort.raise} =
  sweep_within(state, expr, scope, barrier, count_in(expr, is_typed_lambda))

fn is_typed_lambda(e: Expr) -> Bool = match e { LambdaExpression(l) -> l.ret != None, _ -> false }

/// `remaining` is how many lambdas with a written return type are left to sweep: the body of one is swept
/// after `ret` rewrites it, which copies no lambda.
fn sweep_within(
  state: TryState,
  expr: Expr,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  remaining: Int,
) -> TryOutput / {abort.raise} =
  match expr {
    PropagateExpression(t) -> {
      let d = match barrier {
        Some(what) ->
          error_at(
            b"E0118",
            t.span,
            b"this file gives `?` no meaning here",
            b"no `Result` or `Option` to expand this into",
            [
              Bytes::concat_all([
                b"this `?` is inside ",
                what,
                b", which has no written return type of its own. `?` exits the expression it is written in and never a lambda or a region: name a function with a written `->` and call it",
              ]),
            ],
          ),
        None -> match scope {
          Some(why) ->
            error_at(
              b"E0118",
              t.span,
              b"this file gives `?` no meaning here",
              b"no `Result` or `Option` to expand this into",
              [why],
            ),
          None -> if catches_exit(t.operand) {
            error_at(
              b"E0119",
              t.span,
              b"this `handle` holds a `?`, and stands where one could not be expanded from",
              b"a `?` inside it leaves the function from here",
              [
                b"a `?` inside a `handle` leaves the function where the `handle` stands, so the `handle` stands where a `?` could: at the head of a statement or of the return position, with nothing conditional between, and everything evaluated before it pure. Bind it first: `let a = handle { .. } with { .. };`",
              ],
            )
          } else {
            error_at(
              b"E0119",
              t.span,
              b"this `?` is not in a position it can be expanded from",
              b"`?` cannot exit from here",
              [
                b"`?` lifts what it unwraps to the head of the statement, or of the return position, it is written in \xe2\x80\x94 so nothing conditional may sit between the two, and everything evaluated before it must be pure. Bind it first: `let a = e?;`",
              ],
            )
          },
        },
      };
      // The `handle` written around one holding a `?` answers what the `?` would unwrap.
      if catches_exit(t.operand) {
        {
          state: { ..state, diags: state.diags.push(d) },
          expr: InvalidExpression({ span: t.span }),
        }
      } else {
        sweep_inner({ ..state, diags: state.diags.push(d) }, t.operand, scope, barrier, remaining)
      }
    },
    _ -> sweep_inner(state, expr, scope, barrier, remaining),
  }

fn sweep_inner(
  state: TryState,
  expr: Expr,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  remaining: Int,
) -> TryOutput / {abort.raise} =
  match expr {
    PropagateExpression(t) -> {
      let o = sweep_within(state, t.operand, scope, barrier, remaining);
      { state: o.state, expr: PropagateExpression({ span: t.span, operand: o.expr }) }
    },
    BinaryExpression(b) -> {
      let l = sweep_within(state, b.lhs, scope, barrier, remaining);
      let r = sweep_within(l.state, b.rhs, scope, barrier, remaining);
      {
        state: r.state,
        expr: BinaryExpression({ span: b.span, op: b.op, lhs: l.expr, rhs: r.expr }),
      }
    },
    UnaryExpression(u) -> {
      let o = sweep_within(state, u.operand, scope, barrier, remaining);
      { state: o.state, expr: UnaryExpression({ span: u.span, op: u.op, operand: o.expr }) }
    },
    LambdaExpression(l) -> match l.ret {
      None -> {
        let o = sweep_within(
          state,
          l.body,
          scope,
          outermost_barrier(barrier, b"a lambda"),
          remaining,
        );
        {
          state: o.state,
          expr: LambdaExpression({ span: l.span, body: o.expr, params: l.params, ret: None }),
        }
      },
      Some(ty) -> match mode_for(state, Some(ty)) {
        Err(why) -> {
          let o = sweep_within(state, l.body, Some(why), None, remaining);
          {
            state: o.state,
            expr: LambdaExpression({ span: l.span, body: o.expr, params: l.params, ret: Some(ty) }),
          }
        },
        Ok(m) -> {
          let saved = state.mode;
          let ex = lift_exits({ ..state, mode: Some(m) }, l.body);
          let r = return_position(ex.state, ex.expr, tries_in(ex.expr));
          let s: TryOutput = if remaining <= 0 { panic("a lambda swept past the ones written") }
          else { sweep_within(r.state, r.expr, None, None, remaining - 1) };
          {
            state: { ..s.state, mode: saved },
            expr: LambdaExpression({ span: l.span, body: s.expr, params: l.params, ret: Some(ty) }),
          }
        },
      },
    },
    CallExpression(a) -> {
      let f = sweep_within(state, a.func, scope, barrier, remaining);
      let args = sweep_all(f.state, a.args, scope, barrier, remaining);
      let named = a.named.fold(
        { state: args.state, args: [] },
        |acc: { state: TryState, args: List<NamedArg> }, arg: NamedArg| {
          let o = sweep_within(acc.state, arg.value, scope, barrier, remaining);
          { state: o.state, args: acc.args.push({ name: arg.name, value: o.expr, span: arg.span }) }
        },
      );
      {
        state: named.state,
        expr: CallExpression({
          span: a.span,
          func: f.expr,
          named: named.args,
          args: args.exprs,
          labels: a.labels,
        }),
      }
    },
    IfExpression(i) -> {
      let c = sweep_within(state, i.cond, scope, barrier, remaining);
      let t = sweep_within(c.state, i.then_branch, scope, barrier, remaining);
      let el = sweep_within(t.state, i.else_branch, scope, barrier, remaining);
      {
        state: el.state,
        expr: IfExpression({
          span: i.span,
          cond: c.expr,
          then_branch: t.expr,
          else_branch: el.expr,
        }),
      }
    },
    MatchExpression(m) -> {
      let sc = sweep_within(state, m.scrutinee, scope, barrier, remaining);
      let arms = m.arms.fold(
        { state: sc.state, arms: [] },
        |acc: { state: TryState, arms: List<MatchArm> }, arm: MatchArm| {
          let g = match arm.guard {
            None -> { state: acc.state, expr: None },
            Some(x) -> {
              let o = sweep_within(acc.state, x, scope, barrier, remaining);
              { state: o.state, expr: Some(o.expr) }
            },
          };
          let b = sweep_within(g.state, arm.body, scope, barrier, remaining);
          {
            state: b.state,
            arms: acc.arms.push({ pat: arm.pat, guard: g.expr, body: b.expr, span: arm.span }),
          }
        },
      );
      {
        state: arms.state,
        expr: MatchExpression({ span: m.span, scrutinee: sc.expr, arms: arms.arms }),
      }
    },
    BlockExpression(b) -> {
      let stmts = b.stmts.fold(
        { state: state, stmts: [] },
        |acc: { state: TryState, stmts: List<Stmt> }, stmt: Stmt|
          match stmt {
            LetStatement(l) -> {
              let o = sweep_within(acc.state, l.value, scope, barrier, remaining);
              {
                state: o.state,
                stmts: acc.stmts.push(
                  LetStatement({ span: l.span, pat: l.pat, ty: l.ty, value: o.expr }),
                ),
              }
            },
            LetElseStatement(l) -> {
              let v = sweep_within(acc.state, l.value, scope, barrier, remaining);
              let f = sweep_within(v.state, l.fallback, scope, barrier, remaining);
              {
                state: f.state,
                stmts: acc.stmts.push(LetElseStatement({ ..l, value: v.expr, fallback: f.expr })),
              }
            },
            ExpressionStatement(x) -> {
              let o = sweep_within(acc.state, x, scope, barrier, remaining);
              { state: o.state, stmts: acc.stmts.push(ExpressionStatement(o.expr)) }
            },
            AssignmentStatement(x) -> {
              let o = sweep_within(acc.state, x.value, scope, barrier, remaining);
              { state: o.state, stmts: acc.stmts.push(AssignmentStatement({ ..x, value: o.expr })) }
            },
          },
      );
      let tl = match b.tail {
        None -> { state: stmts.state, expr: None },
        Some(t) -> {
          let o = sweep_within(stmts.state, t, scope, barrier, remaining);
          { state: o.state, expr: Some(o.expr) }
        },
      };
      {
        state: tl.state,
        expr: BlockExpression({ span: b.span, tail: tl.expr, stmts: stmts.stmts }),
      }
    },
    RecordExpression(r) -> {
      let o = sweep_fields(state, r.fields, scope, barrier, remaining);
      { state: o.state, expr: RecordExpression({ span: r.span, fields: o.fields }) }
    },
    RecordUpdateExpression(r) -> {
      let b = sweep_within(state, r.base, scope, barrier, remaining);
      let o = sweep_fields(b.state, r.fields, scope, barrier, remaining);
      {
        state: o.state,
        expr: RecordUpdateExpression({ span: r.span, base: b.expr, fields: o.fields }),
      }
    },
    FieldExpression(f) -> {
      let o = sweep_within(state, f.base, scope, barrier, remaining);
      { state: o.state, expr: FieldExpression({ span: f.span, base: o.expr, field: f.field }) }
    },
    ListExpression(l) -> {
      let o = sweep_all(state, l.items, scope, barrier, remaining);
      { state: o.state, expr: ListExpression({ span: l.span, items: o.exprs }) }
    },
    PerformExpression(p) -> {
      let o = sweep_all(state, p.args, scope, barrier, remaining);
      {
        state: o.state,
        expr: PerformExpression({
          span: p.span,
          effect_name: p.effect_name,
          op: p.op,
          resource: p.resource,
          args: o.exprs,
        }),
      }
    },
    HandleExpression(h) -> {
      let vs = h.vars.fold(
        { state: state, vars: [] },
        |acc: { state: TryState, vars: List<HandlerVar> }, v: HandlerVar| {
          let o = sweep_within(acc.state, v.init, scope, barrier, remaining);
          { state: o.state, vars: acc.vars.push({ ..v, init: o.expr }) }
        },
      );
      let b = sweep_within(
        vs.state,
        h.body,
        scope,
        barrier_for_parts(state, barrier, b"a `handle` body"),
        remaining,
      );
      let cs = h.clauses.fold(
        { state: b.state, clauses: [] },
        |acc: { state: TryState, clauses: List<HandleClause> }, c: HandleClause| {
          let o = sweep_within(
            acc.state,
            c.body,
            scope,
            barrier_for_parts(state, barrier, b"a `handle` clause"),
            remaining,
          );
          {
            state: o.state,
            clauses: acc.clauses.push({
              effect_name: c.effect_name,
              op: c.op,
              resource: c.resource,
              every_label: c.every_label,
              label_binder: c.label_binder,
              resume: c.resume,
              body: o.expr,
              span: c.span,
              params: c.params,
            }),
          }
        },
      );
      let r = match h.ret {
        None -> { state: cs.state, ret: None },
        Some(rc) -> {
          let o = sweep_within(
            cs.state,
            rc.body,
            scope,
            barrier_for_parts(state, barrier, b"a `handle` return clause"),
            remaining,
          );
          { state: o.state, ret: Some({ binder: rc.binder, body: o.expr, span: rc.span }) }
        },
      };
      {
        state: r.state,
        expr: HandleExpression({
          span: h.span,
          body: b.expr,
          ret: r.ret,
          clauses: cs.clauses,
          vars: vs.vars,
        }),
      }
    },
    WithHoldExpression(c) -> {
      let a = sweep_within(state, c.acquire, scope, barrier, remaining);
      let r = sweep_within(
        a.state,
        c.release,
        scope,
        outermost_barrier(barrier, b"a `with_hold` release"),
        remaining,
      );
      let b = sweep_within(
        r.state,
        c.body,
        scope,
        outermost_barrier(barrier, b"a `with_hold` body"),
        remaining,
      );
      {
        state: b.state,
        expr: WithHoldExpression({ ..c, acquire: a.expr, release: r.expr, body: b.expr }),
      }
    },
    SimulateExpression(x) -> {
      let o = sweep_within(
        state,
        x.body,
        scope,
        outermost_barrier(barrier, b"a `simulate` body"),
        remaining,
      );
      { state: o.state, expr: SimulateExpression({ span: x.span, body: o.expr }) }
    },
    ParallelExpression(x) -> {
      let o = sweep_all(
        state,
        x.branches,
        scope,
        outermost_barrier(barrier, b"a `parallel` branch"),
        remaining,
      );
      { state: o.state, expr: ParallelExpression({ span: x.span, branches: o.exprs }) }
    },
    TryBlockExpression(x) -> {
      let o = sweep_within(
        state,
        x.body,
        scope,
        barrier_for_parts(state, barrier, b"a `try` body"),
        remaining,
      );
      { state: o.state, expr: TryBlockExpression({ ..x, body: o.expr }) }
    },
    TaggedLiteralExpression(t) -> {
      let filled = t.holes.fold(
        { state: state, holes: [] },
        |acc: { state: TryState, holes: List<Hole> }, h: Hole| {
          let o = sweep_within(acc.state, h.value, scope, barrier, remaining);
          { state: o.state, holes: acc.holes.push({ ..h, value: o.expr }) }
        },
      );
      { state: filled.state, expr: TaggedLiteralExpression({ ..t, holes: filled.holes }) }
    },
    _ -> { state: state, expr: expr },
  }

fn sweep_all(
  state: TryState,
  exprs: List<Expr>,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  remaining: Int,
) -> { state: TryState, exprs: List<Expr> } / {abort.raise} =
  exprs.fold(
    { state: state, exprs: [] },
    |acc: { state: TryState, exprs: List<Expr> }, expr: Expr| {
      let o = sweep_within(acc.state, expr, scope, barrier, remaining);
      { state: o.state, exprs: acc.exprs.push(o.expr) }
    },
  )

fn sweep_fields(
  state: TryState,
  fields: List<RecordLiteralField>,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  remaining: Int,
) -> { state: TryState, fields: List<RecordLiteralField> } / {abort.raise} =
  fields.fold(
    { state: state, fields: [] },
    |acc: { state: TryState, fields: List<RecordLiteralField> }, field: RecordLiteralField| {
      let o = sweep_within(acc.state, field.value, scope, barrier, remaining);
      { state: o.state, fields: acc.fields.push({ name: field.name, value: o.expr }) }
    },
  )

/// Where `item` is written, which names apart the exit effects of the functions in it.
fn item_start(item: Item) -> Int =
  match item {
    FunctionItem(d) -> d.span.start,
    TestItem(d) -> d.span.start,
    LawItem(d) -> d.span.start,
    SchemaItem(d) -> d.name.span.start,
    _ -> 0,
  }

fn expand_item_try(outer: TryState, item: Item) -> { state: TryState, item: Item } / {abort.raise} = {
  let state = { ..outer, fresh: 0, mode: None, exit: None, exits: 0, item_start: item_start(item) };
  match item {
    FunctionItem(d) -> {
      let spec: { state: TryState, clauses: List<SpecClause> } = d.spec.fold(
        { state: state, clauses: [] },
        |acc: { state: TryState, clauses: List<SpecClause> }, clause: SpecClause| {
          let what = match clause.kind {
            RequiresClause -> b"a `requires` clause",
            EnsuresClause -> b"an `ensures` clause",
            CostClause -> b"a `cost` clause",
            SpaceClause -> b"a `space` clause",
          };
          let o = sweep(acc.state, clause.expr, Some(not_in_a_function(what)), None);
          {
            state: o.state,
            clauses: acc.clauses.push({ kind: clause.kind, expr: o.expr, span: clause.span }),
          }
        },
      );
      let measured: { state: TryState, expr: Option<Expr> } = match d.decreases {
        None -> { state: spec.state, expr: None },
        Some(e) -> {
          let o = sweep(spec.state, e, Some(not_in_a_function(b"a `decreases` clause")), None);
          { state: o.state, expr: Some(o.expr) }
        },
      };
      let body = match mode_for(state, d.ret) {
        Err(why) -> sweep(measured.state, d.body, Some(why), None),
        Ok(m) -> {
          let ex = lift_exits({ ..measured.state, mode: Some(m) }, d.body);
          let r = return_position(ex.state, ex.expr, tries_in(ex.expr));
          let s: TryOutput = sweep(r.state, r.expr, None, None);
          { state: { ..s.state, mode: None }, expr: s.expr }
        },
      };
      {
        state: body.state,
        item: FunctionItem({
          visibility: d.visibility,
          name: d.name,
          generics: d.generics,
          params: d.params,
          ret: d.ret,
          effects: d.effects,
          constraints: d.constraints,
          spec: spec.clauses,
          returns: d.returns,
          reuse: d.reuse,
          transparent: d.transparent,
          constant: d.constant,
          decreases: measured.expr,
          body: body.expr,
          doc: d.doc,
          span: d.span,
        }),
      }
    },
    TestItem(d) -> {
      let why = not_in_a_function(b"a `test`");
      let ranged = match d.cases {
        None -> { state: state, cases: None },
        Some(c) -> {
          let table = sweep(state, c.table, Some(why), None);
          let label = sweep(table.state, c.label, Some(why), None);
          { state: label.state, cases: Some({ ..c, table: table.expr, label: label.expr }) }
        },
      };
      let o = sweep(ranged.state, d.body, Some(why), None);
      { state: o.state, item: TestItem({ ..d, cases: ranged.cases, body: o.expr }) }
    },
    LawItem(d) -> {
      let why = not_in_a_function(b"a `law`");
      let g = match d.guard {
        None -> { state: state, expr: None },
        Some(x) -> {
          let o = sweep(state, x, Some(why), None);
          { state: o.state, expr: Some(o.expr) }
        },
      };
      let b = sweep(g.state, d.body, Some(why), None);
      { state: b.state, item: LawItem({ ..d, guard: g.expr, body: b.expr }) }
    },
    SchemaItem(d) -> {
      let why = not_in_a_function(b"a `law schema`");
      let g = match d.guard {
        None -> { state: state, expr: None },
        Some(x) -> {
          let o = sweep(state, x, Some(why), None);
          { state: o.state, expr: Some(o.expr) }
        },
      };
      let b = sweep(g.state, d.body, Some(why), None);
      { state: b.state, item: SchemaItem({ ..d, guard: g.expr, body: b.expr }) }
    },
    _ -> { state: state, item: item },
  }
}

pub fn expand_try(
  module: Module,
  diags: List<ParseDiag>,
) -> { module: Module, diags: List<ParseDiag> } / {abort.raise} = {
  let start = {
    types: collect_types(module),
    shadowed: shadowing_ctor(module),
    diags: diags,
    mode: None,
    fresh: 0,
    exit: None,
    exits: 0,
    item_start: 0,
  };
  let walked = module.items.fold(
    { state: start, items: [] },
    |acc: { state: TryState, items: List<Item> }, item: Item| {
      let o = expand_item_try(acc.state, item);
      { state: o.state, items: acc.items.push(o.item) }
    },
  );
  { module: { ..module, items: walked.items }, diags: walked.state.diags }
}

// --- Running the rewrites --------------------------------------------------------------------

fn tries_in(e: Expr) -> Int =
  count_in(e, |x: Expr| match x { PropagateExpression(_) -> true, _ -> false })
