import std.list
import compiler.syntax.parsing (Span, Identifier, ParseDiagnostic, bare, error_at, is_bare)
import compiler.syntax.type_syntax (TypeExpression, NamedTypeExpression, is_generic)
import compiler.syntax.items (Module, Item, FunctionItem, TestItem, LawItem, SchemaItem,
                              TypeDefinition, AliasBody, SumBody, SpecClause, RequiresClause,
                              EnsuresClause, CostClause, SpaceClause, NominalBody, ExternBody)
import compiler.syntax.expressions (Expression, LiteralExpression, NameExpression, BinaryExpression,
                                    UnaryExpression, LambdaExpression, CallExpression, IfExpression,
                                    MatchExpression, BlockExpression, RecordExpression,
                                    RecordUpdateExpression, PropagateExpression, FieldExpression,
                                    ListExpression, PerformExpression, HandleExpression,
                                    WithScopeExpression, SimulateExpression, ParallelExpression,
                                    InvalidExpression, TryBlockExpression, Statement, LetStatement,
                                    LetElseStatement, ExpressionStatement, AssignmentStatement,
                                    HandlerVar, NamedArg, MatchArm, HandleClause, ReturnClause,
                                    RecordLiteralField, expression_span, TaggedLiteralExpression,
                                    Hole, with_hole_values, exit_effect, is_exit_effect,
                                    exit_operation_name)
import compiler.syntax.patterns (Pattern, PatternWildcard, PatternVariable, PatternConstructor,
                                 LiteralUnit)
import std.bytes (ascii_of_int)
import compiler.expand.rewrite.shared (max_alias_depth, collect_types, find_type, is_pure,
                                       own_binding_among, count_in)
import compiler.check.known (ok_constructor, err_constructor, some_constructor, none_constructor,
                             result_name, option_name)

fn too_deep() -> Bytes =
  Bytes::concat_all([b"more than ", ascii_of_int(max_alias_depth()), b" type aliases deep"])

type TryMode = | TryResult | TryOption

type TryState = {
  types: List<TypeDefinition>,
  shadowed: Option<Bytes>,
  diagnostics: List<ParseDiagnostic>,
  mode: Option<TryMode>,
  fresh: Int,
  exit: Option<Bytes>,
  exits: Int,
  item_start: Int,
}

type FoundTry = { operand: Expression, binder: Identifier, at: Span }

type Scan = | ScanFound(FoundTry) | ScanPure | ScanImpure

type ScanResult = { state: TryState, scan: Scan, expression: Expression }

type TryOutput = { state: TryState, expression: Expression }

fn shadowing_constructor(module: Module) -> Option<Bytes> =
  match own_binding_among(module, [
      ok_constructor(),
      err_constructor(),
      some_constructor(),
      none_constructor(),
    ]) {
    None -> None,
    Some(own) ->
      Some(if own.imported {
        Bytes::concat_all([
          b"this module imports `",
          own.name,
          b"` unqualified, which would capture the `match` `?` expands to; import the module instead and qualify the name, or write the `match` out",
        ])
      } else {
        Bytes::concat_all([
          b"this module declares its own `",
          own.name,
          b"`, which would capture the `match` `?` expands to; rename it, or write the `match` out",
        ])
      }),
  }

fn unreadable_return_message() -> Bytes =
  b"the return type has no head constructor this file can read: a type parameter and a generic alias have none until they are applied"

fn not_result_or_option(head: Bytes) -> Bytes =
  Bytes::concat_all([
    b"this function returns `",
    head,
    b"`; `?` binds a `Result` inside a function returning `Result`, or an `Option` inside one returning `Option`, because those are the constructors it expands to",
  ])

fn no_return_type() -> Bytes =
  b"this function writes no `->`, and `?` reads which constructors to name off the written return type; write one"

fn not_in_a_function(what: Bytes) -> Bytes =
  what.concat(b" has no written return type, and `?` needs one")

fn mode_of(state: TryState, ty: TypeExpression, depth: Int) -> Result<TryMode, Bytes> =
  if depth > max_alias_depth() { Err(too_deep()) } else {
    match ty {
      NamedTypeExpression(c) -> if !is_bare(c.name) {
        Err(
          b"the return type is named through another module, and `?` reads only this file \xe2\x80\x94 a meaning read across a module boundary would go stale in a file that never changed",
        )
      } else if c.name.name.name == result_name() { Ok(TryResult) }
      else if c.name.name.name == option_name() { Ok(TryOption) } else {
        let n = c.name.name.name;
        match find_type(state.types, n) {
          None -> Err(not_result_or_option(n)),
          Some(d) -> if is_generic(d.generics) { Err(unreadable_return_message()) } else {
            match d.body {
              SumBody(_) -> Err(not_result_or_option(n)),
              NominalBody(_) -> Err(not_result_or_option(n)),
              ExternBody -> Err(not_result_or_option(n)),
              AliasBody(inner) -> mode_of(state, inner, depth + 1),
            }
          },
        }
      },
      _ -> Err(unreadable_return_message()),
    }
  }

fn mode_for(state: TryState, return_position: Option<TypeExpression>) -> Result<TryMode, Bytes> =
  match state.shadowed {
    Some(reason) -> Err(reason),
    None -> match return_position {
      None -> Err(no_return_type()),
      Some(ty) -> mode_of(state, ty, 0),
    },
  }

fn outermost_barrier(barrier: Option<Bytes>, what: Bytes) -> Option<Bytes> =
  match barrier { Some(_) -> barrier, None -> Some(what) }

fn made_at(at: Span) -> Span = { ..at, site: 0 }

fn fresh_binder(state: TryState, span: Span) -> { state: TryState, binder: Identifier } =
  {
    state: { ..state, fresh: state.fresh + 1 },
    binder: { name: b"?".concat(Bytes::of_string(state.fresh.to_string())), span: made_at(span) },
  }

pub fn var_of(name: Identifier) -> Expression =
  NameExpression({ span: name.span, name: bare(name) })

pub fn var_pattern(name: Identifier) -> Pattern = PatternVariable({ span: name.span, name: name })

pub fn constructor_pattern(name: Bytes, args: List<Pattern>, span: Span) -> Pattern =
  PatternConstructor({
    span: made_at(span),
    name: bare({ name: name, span: made_at(span) }),
    args: args,
  })

fn failure_span(at: Span) -> Span =
  made_at(if at.end > at.start { { ..at, start: at.end - 1 } } else { at })

fn exit_raise(exit: Bytes, span: Span, value: Expression) -> Expression = {
  let at = failure_span(span);
  PerformExpression({
    span: at,
    effect_name: bare({ name: exit, span: at }),
    op: { name: exit_operation_name(), span: at },
    resource: None,
    args: [value],
  })
}

fn try_match(
  state: TryState,
  operand: Expression,
  span: Span,
  pattern: Pattern,
  body: Expression,
) -> TryOutput / {abort.raise} = {
  let mode = match state.mode {
    Some(m) -> m,
    None -> panic("a mode is established before any lift"),
  };
  match mode {
    TryResult -> {
      let fresh = fresh_binder(state, span);
      let fail_pattern = constructor_pattern(err_constructor(), [var_pattern(fresh.binder)], span);
      let fail_body = match state.exit {
        Some(exit) -> exit_raise(exit, span, var_of(fresh.binder)),
        None ->
          CallExpression({
            span: made_at(span),
            function: var_of({ name: err_constructor(), span: failure_span(span) }),
            args: [var_of(fresh.binder)],
            named: [],
            labels: [],
          }),
      };
      {
        state: fresh.state,
        expression: MatchExpression({
          span: span,
          scrutinee: operand,
          arms: [
            { pattern: fail_pattern, guard: None, body: fail_body, span: made_at(span) },
            {
              pattern: constructor_pattern(ok_constructor(), [pattern], span),
              guard: None,
              body: body,
              span: made_at(span),
            },
          ],
        }),
      }
    },
    TryOption -> {
      let fail_pattern = constructor_pattern(none_constructor(), [], span);
      let fail_body = match state.exit {
        Some(exit) ->
          exit_raise(
            exit,
            span,
            LiteralExpression({ span: failure_span(span), literal: LiteralUnit }),
          ),
        None -> var_of({ name: none_constructor(), span: failure_span(span) }),
      };
      {
        state: state,
        expression: MatchExpression({
          span: span,
          scrutinee: operand,
          arms: [
            { pattern: fail_pattern, guard: None, body: fail_body, span: made_at(span) },
            {
              pattern: constructor_pattern(some_constructor(), [pattern], span),
              guard: None,
              body: body,
              span: made_at(span),
            },
          ],
        }),
      }
    },
  }
}

fn purity(pure: Bool) -> Scan = if pure { ScanPure } else { ScanImpure }

type SequenceResult = { state: TryState, scan: Scan, expressions: List<Expression> }

fn sequence(state: TryState, parts: List<Expression>) -> SequenceResult / {abort.raise} =
  sequence_on({ state: state, scan: ScanPure, expressions: [] }, parts)

fn sequence_on(before: SequenceResult, parts: List<Expression>) -> SequenceResult / {abort.raise} =
  parts.fold(before, |acc: SequenceResult, expression: Expression|
    match acc.scan {
      ScanPure -> {
        let o = scan(acc.state, expression);
        { state: o.state, scan: o.scan, expressions: acc.expressions.push(o.expression) }
      },
      _ -> { ..acc, expressions: acc.expressions.push(expression) },
    })

fn scan(state: TryState, expression: Expression) -> ScanResult / {abort.raise} =
  match expression {
    LiteralExpression(_) -> { state: state, scan: ScanPure, expression: expression },
    NameExpression(_) -> { state: state, scan: ScanPure, expression: expression },
    InvalidExpression(_) -> { state: state, scan: ScanPure, expression: expression },
    PropagateExpression(t) -> {
      let inner = scan(state, t.operand);
      match inner.scan {
        ScanFound(_) ->
          {
            state: inner.state,
            scan: inner.scan,
            expression: PropagateExpression({ span: t.span, operand: inner.expression }),
          },
        _ -> {
          let fresh = fresh_binder(inner.state, t.span);
          {
            state: fresh.state,
            scan: ScanFound({ operand: inner.expression, binder: fresh.binder, at: t.span }),
            expression: var_of(fresh.binder),
          }
        },
      }
    },
    BinaryExpression(b) -> {
      let short = b.op == b"and" || b.op == b"or";
      let l = scan(state, b.lhs);
      match l.scan {
        ScanFound(_) ->
          {
            state: l.state,
            scan: l.scan,
            expression: BinaryExpression({ span: b.span, op: b.op, lhs: l.expression, rhs: b.rhs }),
          },
        ScanImpure -> { state: l.state, scan: ScanImpure, expression: expression },
        ScanPure -> if short {
          { state: l.state, scan: purity(is_pure(b.rhs)), expression: expression }
        } else {
          let r = scan(l.state, b.rhs);
          {
            state: r.state,
            scan: r.scan,
            expression: BinaryExpression({
              span: b.span,
              op: b.op,
              lhs: l.expression,
              rhs: r.expression,
            }),
          }
        },
      }
    },
    UnaryExpression(u) -> {
      let o = scan(state, u.operand);
      {
        state: o.state,
        scan: o.scan,
        expression: UnaryExpression({ span: u.span, op: u.op, operand: o.expression }),
      }
    },
    CallExpression(a) -> {
      let o = sequence_on(
        sequence_on(sequence(state, [a.function]), a.args),
        a.named.map(|n: NamedArg| n.value),
      );
      let function = o.expressions.get(0);
      let args = o.expressions.drop(1).take(a.args.len());
      let nvals = o.expressions.drop(1 + a.args.len());
      let named = range(0, a.named.len()).map(|i: Int| {
        let n = a.named.get(i);
        { name: n.name, value: nvals.get(i), span: n.span }
      });
      let rebuilt = CallExpression({
        span: a.span,
        function: function,
        named: named,
        args: args,
        labels: a.labels,
      });
      match o.scan {
        ScanFound(_) -> { state: o.state, scan: o.scan, expression: rebuilt },
        _ -> { state: o.state, scan: ScanImpure, expression: rebuilt },
      }
    },
    PerformExpression(p) -> {
      let o = sequence(state, p.args);
      let rebuilt = PerformExpression({
        span: p.span,
        effect_name: p.effect_name,
        op: p.op,
        resource: p.resource,
        args: o.expressions,
      });
      match o.scan {
        ScanFound(_) -> { state: o.state, scan: o.scan, expression: rebuilt },
        _ -> { state: o.state, scan: ScanImpure, expression: rebuilt },
      }
    },
    RecordExpression(r) -> {
      let o = sequence(state, r.fields.map(|f: RecordLiteralField| f.value));
      {
        state: o.state,
        scan: o.scan,
        expression: RecordExpression({
          span: r.span,
          fields: range(0, r.fields.len()).map(|i: Int|
            { name: r.fields.get(i).name, value: o.expressions.get(i) }),
        }),
      }
    },
    ListExpression(l) -> {
      let o = sequence(state, l.items);
      {
        state: o.state,
        scan: o.scan,
        expression: ListExpression({ span: l.span, items: o.expressions }),
      }
    },
    FieldExpression(f) -> {
      let o = scan(state, f.base);
      {
        state: o.state,
        scan: o.scan,
        expression: FieldExpression({ span: f.span, base: o.expression, field: f.field }),
      }
    },
    RecordUpdateExpression(r) -> {
      let o = sequence_on(sequence(state, [r.base]), r.fields.map(|f: RecordLiteralField| f.value));
      {
        state: o.state,
        scan: o.scan,
        expression: RecordUpdateExpression({
          span: r.span,
          base: o.expressions.get(0),
          fields: range(0, r.fields.len()).map(|i: Int|
            { name: r.fields.get(i).name, value: o.expressions.get(i + 1) }),
        }),
      }
    },
    IfExpression(i) -> {
      let c = scan(state, i.cond);
      let rebuilt = IfExpression({
        span: i.span,
        cond: c.expression,
        then_branch: i.then_branch,
        else_branch: i.else_branch,
      });
      match c.scan {
        ScanFound(_) -> { state: c.state, scan: c.scan, expression: rebuilt },
        ScanImpure -> { state: c.state, scan: ScanImpure, expression: rebuilt },
        ScanPure ->
          {
            state: c.state,
            scan: purity(is_pure(i.then_branch) && is_pure(i.else_branch)),
            expression: rebuilt,
          },
      }
    },
    MatchExpression(m) -> {
      let sc = scan(state, m.scrutinee);
      let rebuilt = MatchExpression({ span: m.span, scrutinee: sc.expression, arms: m.arms });
      match sc.scan {
        ScanFound(_) -> { state: sc.state, scan: sc.scan, expression: rebuilt },
        ScanImpure -> { state: sc.state, scan: ScanImpure, expression: rebuilt },
        ScanPure ->
          {
            state: sc.state,
            scan: purity(
              m.arms.fold(true, |acc: Bool, arm: MatchArm|
                acc && is_pure(arm.body)
                  && (match arm.guard { None -> true, Some(g) -> is_pure(g) })),
            ),
            expression: rebuilt,
          },
      }
    },
    TaggedLiteralExpression(t) -> {
      let o = sequence(state, t.holes.map(|h: Hole| h.value));
      let rebuilt = TaggedLiteralExpression(with_hole_values(t, o.expressions));
      match o.scan {
        ScanFound(_) -> { state: o.state, scan: o.scan, expression: rebuilt },
        _ -> { state: o.state, scan: purity(t.holes.len() == 0), expression: rebuilt },
      }
    },
    _ -> { state: state, scan: purity(is_pure(expression)), expression: expression },
  }

fn lift_from_head(
  state: TryState,
  expression: Expression,
  remaining: Int,
) -> TryOutput / {abort.raise} = {
  let found = scan_head(state, expression);
  match found.scan {
    ScanFound(l) -> {
      let w = try_match(found.state, l.operand, l.at, var_pattern(l.binder), found.expression);
      match w.expression {
        MatchExpression(m) -> {
          let success = m.arms.get(1);
          let inner = if remaining <= 0 { panic(extra_lift_message()) }
          else { lift_from_head(w.state, success.body, remaining - 1) };
          {
            state: inner.state,
            expression: MatchExpression({
              span: m.span,
              scrutinee: m.scrutinee,
              arms: [
                m.arms.get(0),
                {
                  pattern: success.pattern,
                  guard: None,
                  body: inner.expression,
                  span: success.span,
                },
              ],
            }),
          }
        },
        _ -> w,
      }
    },
    _ -> { state: found.state, expression: found.expression },
  }
}

fn scan_head(state: TryState, expression: Expression) -> ScanResult / {abort.raise} =
  match expression {
    IfExpression(i) -> {
      let c = scan(state, i.cond);
      {
        state: c.state,
        scan: c.scan,
        expression: IfExpression({
          span: i.span,
          cond: c.expression,
          then_branch: i.then_branch,
          else_branch: i.else_branch,
        }),
      }
    },
    MatchExpression(m) -> {
      let sc = scan(state, m.scrutinee);
      {
        state: sc.state,
        scan: sc.scan,
        expression: MatchExpression({ span: m.span, scrutinee: sc.expression, arms: m.arms }),
      }
    },
    _ -> scan(state, expression),
  }

fn extra_lift_message() -> String = "a `?` lifted past the ones written"

fn return_position(
  state: TryState,
  expression: Expression,
  remaining: Int,
) -> TryOutput / {abort.raise} =
  match expression {
    BlockExpression(_) -> return_block(state, expression, remaining),
    IfExpression(i) -> {
      let t = return_position(state, i.then_branch, remaining);
      let el = return_position(t.state, i.else_branch, remaining);
      lift_from_head(
        el.state,
        IfExpression({
          span: i.span,
          cond: i.cond,
          then_branch: t.expression,
          else_branch: el.expression,
        }),
        remaining,
      )
    },
    MatchExpression(m) -> {
      let arms = m.arms.fold(
        { state: state, arms: [] },
        |acc: { state: TryState, arms: List<MatchArm> }, arm: MatchArm| {
          let b = return_position(acc.state, arm.body, remaining);
          {
            state: b.state,
            arms: acc.arms.push({
              pattern: arm.pattern,
              guard: arm.guard,
              body: b.expression,
              span: arm.span,
            }),
          }
        },
      );
      lift_from_head(
        arms.state,
        MatchExpression({ span: m.span, scrutinee: m.scrutinee, arms: arms.arms }),
        remaining,
      )
    },
    _ -> lift_from_head(state, expression, remaining),
  }

fn return_block(
  state: TryState,
  expression: Expression,
  remaining: Int,
) -> TryOutput / {abort.raise} =
  match expression {
    BlockExpression(b) -> {
      let split = range(0, b.statements.len()).fold(
        { state: state, statements: b.statements, tail: b.tail, done: false },
        |acc: { state: TryState, statements: List<Statement>, tail: Option<Expression>, done: Bool }, i: Int|
          if acc.done { acc } else {
            let o = split_at(
              acc.state,
              acc.statements,
              acc.tail,
              i,
              b.statements.get(i),
              remaining,
            );
            match o.split {
              None -> { state: o.state, statements: o.statements, tail: acc.tail, done: false },
              Some(t) ->
                { state: o.state, statements: o.statements.take(i), tail: Some(t), done: true },
            }
          },
      );
      if split.done {
        {
          state: split.state,
          expression: BlockExpression({
            span: b.span,
            tail: split.tail,
            statements: split.statements,
          }),
        }
      } else {
        match b.tail {
          None ->
            {
              state: split.state,
              expression: BlockExpression({
                span: b.span,
                tail: None,
                statements: split.statements,
              }),
            },
          Some(t) -> {
            let o = return_position(split.state, t, remaining);
            {
              state: o.state,
              expression: BlockExpression({
                span: b.span,
                tail: Some(o.expression),
                statements: split.statements,
              }),
            }
          },
        }
      }
    },
    _ -> panic("only called on a block"),
  }

type StatementLift = {
  state: TryState,
  stmt: Statement,
  enclosing_match: Option<{ operand: Expression, at: Span, pattern: Pattern, consumes: Bool }>,
}

fn split_at(
  state: TryState,
  statements: List<Statement>,
  tail: Option<Expression>,
  i: Int,
  st: Statement,
  remaining: Int,
) -> { state: TryState, statements: List<Statement>, split: Option<Expression> } / {abort.raise} = {
  let taken = lift_from_statement(state, st, remaining);
  match taken.enclosing_match {
    None -> { state: taken.state, statements: statements.set(i, taken.stmt), split: None },
    Some(t) -> {
      let kept = statements.set(i, taken.stmt);
      let rest = kept.drop(if t.consumes { i + 1 } else { i });
      let body0 = BlockExpression({ span: made_at(t.at), tail: tail, statements: rest });
      let body = if remaining <= 0 { panic(extra_lift_message()) }
      else { return_block(taken.state, body0, remaining - 1) };
      let w = try_match(body.state, t.operand, t.at, t.pattern, body.expression);
      { state: w.state, statements: kept, split: Some(w.expression) }
    },
  }
}

fn lift_from_statement(
  state: TryState,
  stmt: Statement,
  remaining: Int,
) -> StatementLift / {abort.raise} =
  match stmt {
    LetElseStatement(l) -> match l.value {
      PropagateExpression(t) -> {
        let fresh = fresh_binder(state, t.span);
        let o = lift_try(fresh.state, t.operand, t.span, var_pattern(fresh.binder));
        if o.enclosing_match.consumes {
          {
            state: o.state,
            stmt: LetElseStatement({ ..l, value: var_of(fresh.binder) }),
            enclosing_match: Some({
              operand: o.enclosing_match.operand,
              at: o.enclosing_match.at,
              pattern: o.enclosing_match.pattern,
              consumes: false,
            }),
          }
        } else {
          {
            state: o.state,
            stmt: LetElseStatement({
              ..l,
              value: PropagateExpression({ span: t.span, operand: o.remaining_operand }),
            }),
            enclosing_match: Some(o.enclosing_match),
          }
        }
      },
      _ -> {
        let o = scan(state, l.value);
        match o.scan {
          ScanFound(lift) ->
            {
              state: o.state,
              stmt: LetElseStatement({ ..l, value: o.expression }),
              enclosing_match: Some({
                operand: lift.operand,
                at: lift.at,
                pattern: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> {
            let f = return_position(o.state, l.fallback, remaining);
            {
              state: f.state,
              stmt: LetElseStatement({ ..l, fallback: f.expression }),
              enclosing_match: None,
            }
          },
        }
      },
    },
    LetStatement(l) -> match l.value {
      PropagateExpression(t) -> match l.ty {
        Some(_) -> {
          let fresh = fresh_binder(state, t.span);
          let o = lift_try(fresh.state, t.operand, t.span, var_pattern(fresh.binder));
          if o.enclosing_match.consumes {
            {
              state: o.state,
              stmt: LetStatement({
                span: l.span,
                pattern: l.pattern,
                ty: l.ty,
                value: var_of(fresh.binder),
              }),
              enclosing_match: Some({
                operand: o.enclosing_match.operand,
                at: o.enclosing_match.at,
                pattern: o.enclosing_match.pattern,
                consumes: false,
              }),
            }
          } else {
            {
              state: o.state,
              stmt: LetStatement({
                span: l.span,
                pattern: l.pattern,
                ty: l.ty,
                value: PropagateExpression({ span: t.span, operand: o.remaining_operand }),
              }),
              enclosing_match: Some(o.enclosing_match),
            }
          }
        },
        None -> {
          let o = lift_try(state, t.operand, t.span, l.pattern);
          {
            state: o.state,
            stmt: LetStatement({
              span: l.span,
              pattern: l.pattern,
              ty: None,
              value: PropagateExpression({ span: t.span, operand: o.remaining_operand }),
            }),
            enclosing_match: Some(o.enclosing_match),
          }
        },
      },
      _ -> {
        let o = scan(state, l.value);
        match o.scan {
          ScanFound(lift) ->
            {
              state: o.state,
              stmt: LetStatement({
                span: l.span,
                pattern: l.pattern,
                ty: l.ty,
                value: o.expression,
              }),
              enclosing_match: Some({
                operand: lift.operand,
                at: lift.at,
                pattern: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> { state: o.state, stmt: stmt, enclosing_match: None },
        }
      },
    },
    AssignmentStatement(a) -> match a.value {
      PropagateExpression(t) -> {
        let fresh = fresh_binder(state, t.span);
        let o = lift_try(fresh.state, t.operand, t.span, var_pattern(fresh.binder));
        if o.enclosing_match.consumes {
          {
            state: o.state,
            stmt: AssignmentStatement({ ..a, value: var_of(fresh.binder) }),
            enclosing_match: Some({
              operand: o.enclosing_match.operand,
              at: o.enclosing_match.at,
              pattern: o.enclosing_match.pattern,
              consumes: false,
            }),
          }
        } else {
          {
            state: o.state,
            stmt: AssignmentStatement({
              ..a,
              value: PropagateExpression({ span: t.span, operand: o.remaining_operand }),
            }),
            enclosing_match: Some(o.enclosing_match),
          }
        }
      },
      _ -> {
        let o = scan(state, a.value);
        match o.scan {
          ScanFound(lift) ->
            {
              state: o.state,
              stmt: AssignmentStatement({ ..a, value: o.expression }),
              enclosing_match: Some({
                operand: lift.operand,
                at: lift.at,
                pattern: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> { state: o.state, stmt: stmt, enclosing_match: None },
        }
      },
    },
    ExpressionStatement(v) -> match v {
      PropagateExpression(t) -> {
        let o = lift_try(state, t.operand, t.span, PatternWildcard({ span: expression_span(v) }));
        {
          state: o.state,
          stmt: ExpressionStatement(
            PropagateExpression({ span: t.span, operand: o.remaining_operand }),
          ),
          enclosing_match: Some(o.enclosing_match),
        }
      },
      _ -> {
        let o = scan(state, v);
        match o.scan {
          ScanFound(lift) ->
            {
              state: o.state,
              stmt: ExpressionStatement(o.expression),
              enclosing_match: Some({
                operand: lift.operand,
                at: lift.at,
                pattern: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> { state: o.state, stmt: stmt, enclosing_match: None },
        }
      },
    },
  }

type TryLift = {
  state: TryState,
  remaining_operand: Expression,
  enclosing_match: { operand: Expression, at: Span, pattern: Pattern, consumes: Bool },
}

fn lift_try(
  state: TryState,
  operand: Expression,
  span: Span,
  pattern: Pattern,
) -> TryLift / {abort.raise} = {
  let o = scan(state, operand);
  match o.scan {
    ScanFound(lift) ->
      {
        state: o.state,
        remaining_operand: o.expression,
        enclosing_match: {
          operand: lift.operand,
          at: lift.at,
          pattern: var_pattern(lift.binder),
          consumes: false,
        },
      },
    _ ->
      {
        state: o.state,
        remaining_operand: LiteralExpression({ span: made_at(span), literal: LiteralUnit }),
        enclosing_match: { operand: o.expression, at: span, pattern: pattern, consumes: true },
      },
  }
}

fn lift_exits(state: TryState, body: Expression) -> TryOutput / {abort.raise} =
  exits_in(
    { ..state, exits: state.exits + 1 },
    exit_effect(state.item_start, state.exits),
    true,
    body,
  )

fn exits_in(
  state: TryState,
  exit: Bytes,
  outermost: Bool,
  expression: Expression,
) -> TryOutput / {abort.raise} =
  match expression {
    HandleExpression(_) -> handle_exits(state, exit, outermost, expression),
    TryBlockExpression(_) -> handle_exits(state, exit, outermost, expression),
    BinaryExpression(b) -> {
      let l = exits_in(state, exit, outermost, b.lhs);
      let r = exits_in(l.state, exit, outermost, b.rhs);
      {
        state: r.state,
        expression: BinaryExpression({ ..b, lhs: l.expression, rhs: r.expression }),
      }
    },
    UnaryExpression(u) -> {
      let o = exits_in(state, exit, outermost, u.operand);
      { state: o.state, expression: UnaryExpression({ ..u, operand: o.expression }) }
    },
    CallExpression(a) -> {
      let f = exits_in(state, exit, outermost, a.function);
      let args = exits_all(f.state, exit, outermost, a.args);
      let named = a.named.fold(
        { state: args.state, args: [] },
        |acc: { state: TryState, args: List<NamedArg> }, arg: NamedArg| {
          let o = exits_in(acc.state, exit, outermost, arg.value);
          { state: o.state, args: acc.args.push({ ..arg, value: o.expression }) }
        },
      );
      {
        state: named.state,
        expression: CallExpression({
          ..a,
          function: f.expression,
          args: args.expressions,
          named: named.args,
        }),
      }
    },
    IfExpression(i) -> {
      let c = exits_in(state, exit, outermost, i.cond);
      let t = exits_in(c.state, exit, outermost, i.then_branch);
      let el = exits_in(t.state, exit, outermost, i.else_branch);
      {
        state: el.state,
        expression: IfExpression({
          ..i,
          cond: c.expression,
          then_branch: t.expression,
          else_branch: el.expression,
        }),
      }
    },
    MatchExpression(m) -> {
      let sc = exits_in(state, exit, outermost, m.scrutinee);
      let arms = m.arms.fold(
        { state: sc.state, arms: [] },
        |acc: { state: TryState, arms: List<MatchArm> }, arm: MatchArm| {
          let g = match arm.guard {
            None -> { state: acc.state, expression: None },
            Some(x) -> {
              let o = exits_in(acc.state, exit, outermost, x);
              { state: o.state, expression: Some(o.expression) }
            },
          };
          let b = exits_in(g.state, exit, outermost, arm.body);
          {
            state: b.state,
            arms: acc.arms.push({ ..arm, guard: g.expression, body: b.expression }),
          }
        },
      );
      {
        state: arms.state,
        expression: MatchExpression({ ..m, scrutinee: sc.expression, arms: arms.arms }),
      }
    },
    BlockExpression(b) -> {
      let statements = b.statements.fold(
        { state: state, statements: [] },
        |acc: { state: TryState, statements: List<Statement> }, stmt: Statement|
          match stmt {
            LetStatement(l) -> {
              let o = exits_in(acc.state, exit, outermost, l.value);
              {
                state: o.state,
                statements: acc.statements.push(LetStatement({ ..l, value: o.expression })),
              }
            },
            LetElseStatement(l) -> {
              let v = exits_in(acc.state, exit, outermost, l.value);
              let f = exits_in(v.state, exit, outermost, l.fallback);
              {
                state: f.state,
                statements: acc.statements.push(
                  LetElseStatement({ ..l, value: v.expression, fallback: f.expression }),
                ),
              }
            },
            ExpressionStatement(x) -> {
              let o = exits_in(acc.state, exit, outermost, x);
              { state: o.state, statements: acc.statements.push(ExpressionStatement(o.expression)) }
            },
            AssignmentStatement(x) -> {
              let o = exits_in(acc.state, exit, outermost, x.value);
              {
                state: o.state,
                statements: acc.statements.push(AssignmentStatement({ ..x, value: o.expression })),
              }
            },
          },
      );
      let tl = match b.tail {
        None -> { state: statements.state, expression: None },
        Some(t) -> {
          let o = exits_in(statements.state, exit, outermost, t);
          { state: o.state, expression: Some(o.expression) }
        },
      };
      {
        state: tl.state,
        expression: BlockExpression({
          ..b,
          tail: tl.expression,
          statements: statements.statements,
        }),
      }
    },
    RecordExpression(r) -> {
      let o = exits_fields(state, exit, outermost, r.fields);
      { state: o.state, expression: RecordExpression({ ..r, fields: o.fields }) }
    },
    RecordUpdateExpression(r) -> {
      let b = exits_in(state, exit, outermost, r.base);
      let o = exits_fields(b.state, exit, outermost, r.fields);
      {
        state: o.state,
        expression: RecordUpdateExpression({ ..r, base: b.expression, fields: o.fields }),
      }
    },
    PropagateExpression(t) -> {
      let o = exits_in(state, exit, outermost, t.operand);
      { state: o.state, expression: PropagateExpression({ ..t, operand: o.expression }) }
    },
    FieldExpression(f) -> {
      let o = exits_in(state, exit, outermost, f.base);
      { state: o.state, expression: FieldExpression({ ..f, base: o.expression }) }
    },
    ListExpression(l) -> {
      let o = exits_all(state, exit, outermost, l.items);
      { state: o.state, expression: ListExpression({ ..l, items: o.expressions }) }
    },
    PerformExpression(p) -> {
      let o = exits_all(state, exit, outermost, p.args);
      { state: o.state, expression: PerformExpression({ ..p, args: o.expressions }) }
    },
    TaggedLiteralExpression(t) -> {
      let o = exits_all(state, exit, outermost, t.holes.map(|h: Hole| h.value));
      { state: o.state, expression: TaggedLiteralExpression(with_hole_values(t, o.expressions)) }
    },
    _ -> { state: state, expression: expression },
  }

fn exits_all(
  state: TryState,
  exit: Bytes,
  outermost: Bool,
  expressions: List<Expression>,
) -> { state: TryState, expressions: List<Expression> } / {abort.raise} =
  expressions.fold(
    { state: state, expressions: [] },
    |acc: { state: TryState, expressions: List<Expression> }, expression: Expression| {
      let o = exits_in(acc.state, exit, outermost, expression);
      { state: o.state, expressions: acc.expressions.push(o.expression) }
    },
  )

fn exits_fields(
  state: TryState,
  exit: Bytes,
  outermost: Bool,
  fields: List<RecordLiteralField>,
) -> { state: TryState, fields: List<RecordLiteralField> } / {abort.raise} =
  fields.fold(
    { state: state, fields: [] },
    |acc: { state: TryState, fields: List<RecordLiteralField> }, field: RecordLiteralField| {
      let o = exits_in(acc.state, exit, outermost, field.value);
      { state: o.state, fields: acc.fields.push({ ..field, value: o.expression }) }
    },
  )

fn exits_through(state: TryState, exit: Bytes, part: Expression) -> TryOutput / {abort.raise} = {
  let nested = exits_in(state, exit, false, part);
  return_position(
    { ..nested.state, exit: Some(exit) },
    nested.expression,
    tries_in(nested.expression),
  )
}

fn handle_exits(
  state: TryState,
  exit: Bytes,
  outermost: Bool,
  expression: Expression,
) -> TryOutput / {abort.raise} = {
  let parts: TryOutput = match expression {
    HandleExpression(h) -> {
      let b = exits_through(state, exit, h.body);
      let cs = h.clauses.fold(
        { state: b.state, clauses: [] },
        |acc: { state: TryState, clauses: List<HandleClause> }, c: HandleClause| {
          let o = exits_through(acc.state, exit, c.body);
          { state: o.state, clauses: acc.clauses.push({ ..c, body: o.expression }) }
        },
      );
      let r: { state: TryState, ret: Option<ReturnClause> } = match h.ret {
        None -> { state: cs.state, ret: None },
        Some(rc) -> {
          let o = exits_through(cs.state, exit, rc.body);
          { state: o.state, ret: Some({ ..rc, body: o.expression }) }
        },
      };
      {
        state: r.state,
        expression: HandleExpression({ ..h, body: b.expression, clauses: cs.clauses, ret: r.ret }),
      }
    },
    TryBlockExpression(t) -> {
      let b = exits_through(state, exit, t.body);
      { state: b.state, expression: TryBlockExpression({ ..t, body: b.expression }) }
    },
    _ -> { state: state, expression: expression },
  };
  let left = { ..parts.state, exit: state.exit };
  if parts.state.fresh == state.fresh { { state: left, expression: expression } }
  else if !outermost { { state: left, expression: parts.expression } }
  else { catch_exit(left, exit, parts.expression) }
}

fn catch_exit(state: TryState, exit: Bytes, h: Expression) -> TryOutput = {
  let span = made_at(expression_span(h));
  let fresh = fresh_binder(state, span);
  let named = |n: Bytes| var_of({ name: n, span: span });
  let called = |n: Bytes, x: Expression|
    CallExpression({ span: span, function: named(n), args: [x], named: [], labels: [] });
  let returned = match state.mode {
    Some(TryOption) -> { ok: called(some_constructor(), h), failed: named(none_constructor()) },
    _ ->
      { ok: called(ok_constructor(), h), failed: called(err_constructor(), var_of(fresh.binder)) },
  };
  {
    state: fresh.state,
    expression: PropagateExpression({
      span: span,
      operand: HandleExpression({
        span: span,
        body: returned.ok,
        ret: None,
        clauses: [
          {
            effect_name: bare({ name: exit, span: span }),
            op: { name: exit_operation_name(), span: span },
            resource: None,
            wildcard_label: false,
            label_binder: None,
            resume: None,
            body: returned.failed,
            span: span,
            params: [fresh.binder],
          },
        ],
        vars: [],
      }),
    }),
  }
}

fn catches_exit(operand: Expression) -> Bool =
  match operand {
    HandleExpression(h) -> h.clauses.any(|c: HandleClause| is_exit_effect(c.effect_name.name.name)),
    _ -> false,
  }

fn barrier_for_parts(state: TryState, barrier: Option<Bytes>, what: Bytes) -> Option<Bytes> =
  if state.mode == None { outermost_barrier(barrier, what) } else { barrier }

fn rewrite_tries(
  state: TryState,
  expression: Expression,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
) -> TryOutput / {abort.raise} =
  rewrite_tries_within(state, expression, scope, barrier, count_in(expression, is_typed_lambda))

fn is_typed_lambda(e: Expression) -> Bool =
  match e { LambdaExpression(l) -> l.ret != None, _ -> false }

fn rewrite_tries_within(
  state: TryState,
  expression: Expression,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  remaining: Int,
) -> TryOutput / {abort.raise} =
  match expression {
    PropagateExpression(t) -> {
      let d = match barrier {
        Some(what) ->
          error_at(
            b"E0118",
            t.span,
            b"this file gives `?` no meaning here",
            b"no `Result` or `Option` to expand this into",
            [
              Bytes::concat_all([
                b"this `?` is inside ",
                what,
                b", which has no written return type of its own. `?` exits the expression it is written in and never a lambda or a scope: name a function with a written `->` and call it",
              ]),
            ],
          ),
        None -> match scope {
          Some(reason) ->
            error_at(
              b"E0118",
              t.span,
              b"this file gives `?` no meaning here",
              b"no `Result` or `Option` to expand this into",
              [reason],
            ),
          None -> if catches_exit(t.operand) {
            error_at(
              b"E0119",
              t.span,
              b"this `handle` holds a `?`, and stands where one could not be expanded from",
              b"a `?` inside it leaves the function from here",
              [
                b"a `?` inside a `handle` leaves the function where the `handle` stands, so the `handle` stands where a `?` could: at the head of a statement or of the return position, with nothing conditional between, and everything evaluated before it pure. Bind it first: `let a = handle { .. } with { .. };`",
              ],
            )
          } else {
            error_at(
              b"E0119",
              t.span,
              b"this `?` is not in a position it can be expanded from",
              b"`?` cannot exit from here",
              [
                b"`?` lifts what it unwraps to the head of the statement, or of the return position, it is written in \xe2\x80\x94 so nothing conditional may sit between the two, and everything evaluated before it must be pure. Bind it first: `let a = e?;`",
              ],
            )
          },
        },
      };
      if catches_exit(t.operand) {
        {
          state: { ..state, diagnostics: state.diagnostics.push(d) },
          expression: InvalidExpression({ span: t.span }),
        }
      } else {
        sweep_inner(
          { ..state, diagnostics: state.diagnostics.push(d) },
          t.operand,
          scope,
          barrier,
          remaining,
        )
      }
    },
    _ -> sweep_inner(state, expression, scope, barrier, remaining),
  }

fn sweep_inner(
  state: TryState,
  expression: Expression,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  remaining: Int,
) -> TryOutput / {abort.raise} =
  match expression {
    PropagateExpression(t) -> {
      let o = rewrite_tries_within(state, t.operand, scope, barrier, remaining);
      { state: o.state, expression: PropagateExpression({ span: t.span, operand: o.expression }) }
    },
    BinaryExpression(b) -> {
      let l = rewrite_tries_within(state, b.lhs, scope, barrier, remaining);
      let r = rewrite_tries_within(l.state, b.rhs, scope, barrier, remaining);
      {
        state: r.state,
        expression: BinaryExpression({
          span: b.span,
          op: b.op,
          lhs: l.expression,
          rhs: r.expression,
        }),
      }
    },
    UnaryExpression(u) -> {
      let o = rewrite_tries_within(state, u.operand, scope, barrier, remaining);
      {
        state: o.state,
        expression: UnaryExpression({ span: u.span, op: u.op, operand: o.expression }),
      }
    },
    LambdaExpression(l) -> match l.ret {
      None -> {
        let o = rewrite_tries_within(
          state,
          l.body,
          scope,
          outermost_barrier(barrier, b"a lambda"),
          remaining,
        );
        {
          state: o.state,
          expression: LambdaExpression({
            span: l.span,
            body: o.expression,
            params: l.params,
            ret: None,
          }),
        }
      },
      Some(ty) -> match mode_for(state, Some(ty)) {
        Err(reason) -> {
          let o = rewrite_tries_within(state, l.body, Some(reason), None, remaining);
          {
            state: o.state,
            expression: LambdaExpression({
              span: l.span,
              body: o.expression,
              params: l.params,
              ret: Some(ty),
            }),
          }
        },
        Ok(m) -> {
          let saved = state.mode;
          let ex = lift_exits({ ..state, mode: Some(m) }, l.body);
          let r = return_position(ex.state, ex.expression, tries_in(ex.expression));
          let s: TryOutput = if remaining <= 0 { panic("a lambda swept past the ones written") }
          else { rewrite_tries_within(r.state, r.expression, None, None, remaining - 1) };
          {
            state: { ..s.state, mode: saved },
            expression: LambdaExpression({
              span: l.span,
              body: s.expression,
              params: l.params,
              ret: Some(ty),
            }),
          }
        },
      },
    },
    CallExpression(a) -> {
      let f = rewrite_tries_within(state, a.function, scope, barrier, remaining);
      let args = rewrite_tries_all(f.state, a.args, scope, barrier, remaining);
      let named = a.named.fold(
        { state: args.state, args: [] },
        |acc: { state: TryState, args: List<NamedArg> }, arg: NamedArg| {
          let o = rewrite_tries_within(acc.state, arg.value, scope, barrier, remaining);
          {
            state: o.state,
            args: acc.args.push({ name: arg.name, value: o.expression, span: arg.span }),
          }
        },
      );
      {
        state: named.state,
        expression: CallExpression({
          span: a.span,
          function: f.expression,
          named: named.args,
          args: args.expressions,
          labels: a.labels,
        }),
      }
    },
    IfExpression(i) -> {
      let c = rewrite_tries_within(state, i.cond, scope, barrier, remaining);
      let t = rewrite_tries_within(c.state, i.then_branch, scope, barrier, remaining);
      let el = rewrite_tries_within(t.state, i.else_branch, scope, barrier, remaining);
      {
        state: el.state,
        expression: IfExpression({
          span: i.span,
          cond: c.expression,
          then_branch: t.expression,
          else_branch: el.expression,
        }),
      }
    },
    MatchExpression(m) -> {
      let sc = rewrite_tries_within(state, m.scrutinee, scope, barrier, remaining);
      let arms = m.arms.fold(
        { state: sc.state, arms: [] },
        |acc: { state: TryState, arms: List<MatchArm> }, arm: MatchArm| {
          let g = match arm.guard {
            None -> { state: acc.state, expression: None },
            Some(x) -> {
              let o = rewrite_tries_within(acc.state, x, scope, barrier, remaining);
              { state: o.state, expression: Some(o.expression) }
            },
          };
          let b = rewrite_tries_within(g.state, arm.body, scope, barrier, remaining);
          {
            state: b.state,
            arms: acc.arms.push({
              pattern: arm.pattern,
              guard: g.expression,
              body: b.expression,
              span: arm.span,
            }),
          }
        },
      );
      {
        state: arms.state,
        expression: MatchExpression({ span: m.span, scrutinee: sc.expression, arms: arms.arms }),
      }
    },
    BlockExpression(b) -> {
      let statements = b.statements.fold(
        { state: state, statements: [] },
        |acc: { state: TryState, statements: List<Statement> }, stmt: Statement|
          match stmt {
            LetStatement(l) -> {
              let o = rewrite_tries_within(acc.state, l.value, scope, barrier, remaining);
              {
                state: o.state,
                statements: acc.statements.push(
                  LetStatement({ span: l.span, pattern: l.pattern, ty: l.ty, value: o.expression }),
                ),
              }
            },
            LetElseStatement(l) -> {
              let v = rewrite_tries_within(acc.state, l.value, scope, barrier, remaining);
              let f = rewrite_tries_within(v.state, l.fallback, scope, barrier, remaining);
              {
                state: f.state,
                statements: acc.statements.push(
                  LetElseStatement({ ..l, value: v.expression, fallback: f.expression }),
                ),
              }
            },
            ExpressionStatement(x) -> {
              let o = rewrite_tries_within(acc.state, x, scope, barrier, remaining);
              { state: o.state, statements: acc.statements.push(ExpressionStatement(o.expression)) }
            },
            AssignmentStatement(x) -> {
              let o = rewrite_tries_within(acc.state, x.value, scope, barrier, remaining);
              {
                state: o.state,
                statements: acc.statements.push(AssignmentStatement({ ..x, value: o.expression })),
              }
            },
          },
      );
      let tl = match b.tail {
        None -> { state: statements.state, expression: None },
        Some(t) -> {
          let o = rewrite_tries_within(statements.state, t, scope, barrier, remaining);
          { state: o.state, expression: Some(o.expression) }
        },
      };
      {
        state: tl.state,
        expression: BlockExpression({
          span: b.span,
          tail: tl.expression,
          statements: statements.statements,
        }),
      }
    },
    RecordExpression(r) -> {
      let o = sweep_fields(state, r.fields, scope, barrier, remaining);
      { state: o.state, expression: RecordExpression({ span: r.span, fields: o.fields }) }
    },
    RecordUpdateExpression(r) -> {
      let b = rewrite_tries_within(state, r.base, scope, barrier, remaining);
      let o = sweep_fields(b.state, r.fields, scope, barrier, remaining);
      {
        state: o.state,
        expression: RecordUpdateExpression({ span: r.span, base: b.expression, fields: o.fields }),
      }
    },
    FieldExpression(f) -> {
      let o = rewrite_tries_within(state, f.base, scope, barrier, remaining);
      {
        state: o.state,
        expression: FieldExpression({ span: f.span, base: o.expression, field: f.field }),
      }
    },
    ListExpression(l) -> {
      let o = rewrite_tries_all(state, l.items, scope, barrier, remaining);
      { state: o.state, expression: ListExpression({ span: l.span, items: o.expressions }) }
    },
    PerformExpression(p) -> {
      let o = rewrite_tries_all(state, p.args, scope, barrier, remaining);
      {
        state: o.state,
        expression: PerformExpression({
          span: p.span,
          effect_name: p.effect_name,
          op: p.op,
          resource: p.resource,
          args: o.expressions,
        }),
      }
    },
    HandleExpression(h) -> {
      let vs = h.vars.fold(
        { state: state, vars: [] },
        |acc: { state: TryState, vars: List<HandlerVar> }, v: HandlerVar| {
          let o = rewrite_tries_within(acc.state, v.init, scope, barrier, remaining);
          { state: o.state, vars: acc.vars.push({ ..v, init: o.expression }) }
        },
      );
      let b = rewrite_tries_within(
        vs.state,
        h.body,
        scope,
        barrier_for_parts(state, barrier, b"a `handle` body"),
        remaining,
      );
      let cs = h.clauses.fold(
        { state: b.state, clauses: [] },
        |acc: { state: TryState, clauses: List<HandleClause> }, c: HandleClause| {
          let o = rewrite_tries_within(
            acc.state,
            c.body,
            scope,
            barrier_for_parts(state, barrier, b"a `handle` clause"),
            remaining,
          );
          {
            state: o.state,
            clauses: acc.clauses.push({
              effect_name: c.effect_name,
              op: c.op,
              resource: c.resource,
              wildcard_label: c.wildcard_label,
              label_binder: c.label_binder,
              resume: c.resume,
              body: o.expression,
              span: c.span,
              params: c.params,
            }),
          }
        },
      );
      let r = match h.ret {
        None -> { state: cs.state, ret: None },
        Some(rc) -> {
          let o = rewrite_tries_within(
            cs.state,
            rc.body,
            scope,
            barrier_for_parts(state, barrier, b"a `handle` return clause"),
            remaining,
          );
          { state: o.state, ret: Some({ binder: rc.binder, body: o.expression, span: rc.span }) }
        },
      };
      {
        state: r.state,
        expression: HandleExpression({
          span: h.span,
          body: b.expression,
          ret: r.ret,
          clauses: cs.clauses,
          vars: vs.vars,
        }),
      }
    },
    WithScopeExpression(c) -> {
      let a = rewrite_tries_within(state, c.acquire, scope, barrier, remaining);
      let r = rewrite_tries_within(
        a.state,
        c.release,
        scope,
        outermost_barrier(barrier, b"a `with_scope` release"),
        remaining,
      );
      let b = rewrite_tries_within(
        r.state,
        c.body,
        scope,
        outermost_barrier(barrier, b"a `with_scope` body"),
        remaining,
      );
      {
        state: b.state,
        expression: WithScopeExpression({
          ..c,
          acquire: a.expression,
          release: r.expression,
          body: b.expression,
        }),
      }
    },
    SimulateExpression(x) -> {
      let o = rewrite_tries_within(
        state,
        x.body,
        scope,
        outermost_barrier(barrier, b"a `simulate` body"),
        remaining,
      );
      { state: o.state, expression: SimulateExpression({ span: x.span, body: o.expression }) }
    },
    ParallelExpression(x) -> {
      let o = rewrite_tries_all(
        state,
        x.branches,
        scope,
        outermost_barrier(barrier, b"a `parallel` branch"),
        remaining,
      );
      { state: o.state, expression: ParallelExpression({ span: x.span, branches: o.expressions }) }
    },
    TryBlockExpression(x) -> {
      let o = rewrite_tries_within(
        state,
        x.body,
        scope,
        barrier_for_parts(state, barrier, b"a `try` body"),
        remaining,
      );
      { state: o.state, expression: TryBlockExpression({ ..x, body: o.expression }) }
    },
    TaggedLiteralExpression(t) -> {
      let filled = t.holes.fold(
        { state: state, holes: [] },
        |acc: { state: TryState, holes: List<Hole> }, h: Hole| {
          let o = rewrite_tries_within(acc.state, h.value, scope, barrier, remaining);
          { state: o.state, holes: acc.holes.push({ ..h, value: o.expression }) }
        },
      );
      { state: filled.state, expression: TaggedLiteralExpression({ ..t, holes: filled.holes }) }
    },
    _ -> { state: state, expression: expression },
  }

fn rewrite_tries_all(
  state: TryState,
  expressions: List<Expression>,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  remaining: Int,
) -> { state: TryState, expressions: List<Expression> } / {abort.raise} =
  expressions.fold(
    { state: state, expressions: [] },
    |acc: { state: TryState, expressions: List<Expression> }, expression: Expression| {
      let o = rewrite_tries_within(acc.state, expression, scope, barrier, remaining);
      { state: o.state, expressions: acc.expressions.push(o.expression) }
    },
  )

fn sweep_fields(
  state: TryState,
  fields: List<RecordLiteralField>,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  remaining: Int,
) -> { state: TryState, fields: List<RecordLiteralField> } / {abort.raise} =
  fields.fold(
    { state: state, fields: [] },
    |acc: { state: TryState, fields: List<RecordLiteralField> }, field: RecordLiteralField| {
      let o = rewrite_tries_within(acc.state, field.value, scope, barrier, remaining);
      { state: o.state, fields: acc.fields.push({ name: field.name, value: o.expression }) }
    },
  )

fn item_start(item: Item) -> Int =
  match item {
    FunctionItem(d) -> d.span.start,
    TestItem(d) -> d.span.start,
    LawItem(d) -> d.span.start,
    SchemaItem(d) -> d.name.span.start,
    _ -> 0,
  }

fn expand_item_try(outer: TryState, item: Item) -> { state: TryState, item: Item } / {abort.raise} = {
  let state = { ..outer, fresh: 0, mode: None, exit: None, exits: 0, item_start: item_start(item) };
  match item {
    FunctionItem(d) -> {
      let spec: { state: TryState, clauses: List<SpecClause> } = d.spec.fold(
        { state: state, clauses: [] },
        |acc: { state: TryState, clauses: List<SpecClause> }, clause: SpecClause| {
          let what = match clause.kind {
            RequiresClause -> b"a `requires` clause",
            EnsuresClause -> b"an `ensures` clause",
            CostClause -> b"a `cost` clause",
            SpaceClause -> b"a `space` clause",
          };
          let o = rewrite_tries(acc.state, clause.expression, Some(not_in_a_function(what)), None);
          {
            state: o.state,
            clauses: acc.clauses.push({
              kind: clause.kind,
              expression: o.expression,
              span: clause.span,
            }),
          }
        },
      );
      let measured: { state: TryState, expression: Option<Expression> } = match d.decreases {
        None -> { state: spec.state, expression: None },
        Some(e) -> {
          let o = rewrite_tries(
            spec.state,
            e,
            Some(not_in_a_function(b"a `decreases` clause")),
            None,
          );
          { state: o.state, expression: Some(o.expression) }
        },
      };
      let body = match mode_for(state, d.ret) {
        Err(reason) -> rewrite_tries(measured.state, d.body, Some(reason), None),
        Ok(m) -> {
          let ex = lift_exits({ ..measured.state, mode: Some(m) }, d.body);
          let r = return_position(ex.state, ex.expression, tries_in(ex.expression));
          let s: TryOutput = rewrite_tries(r.state, r.expression, None, None);
          { state: { ..s.state, mode: None }, expression: s.expression }
        },
      };
      {
        state: body.state,
        item: FunctionItem({
          visibility: d.visibility,
          name: d.name,
          generics: d.generics,
          params: d.params,
          ret: d.ret,
          effects: d.effects,
          constraints: d.constraints,
          spec: spec.clauses,
          returns: d.returns,
          reuse: d.reuse,
          transparent: d.transparent,
          constant: d.constant,
          decreases: measured.expression,
          body: body.expression,
          doc: d.doc,
          span: d.span,
        }),
      }
    },
    TestItem(d) -> {
      let reason = not_in_a_function(b"a `test`");
      let ranged = match d.cases {
        None -> { state: state, cases: None },
        Some(c) -> {
          let table = rewrite_tries(state, c.table, Some(reason), None);
          let label = rewrite_tries(table.state, c.label, Some(reason), None);
          {
            state: label.state,
            cases: Some({ ..c, table: table.expression, label: label.expression }),
          }
        },
      };
      let o = rewrite_tries(ranged.state, d.body, Some(reason), None);
      { state: o.state, item: TestItem({ ..d, cases: ranged.cases, body: o.expression }) }
    },
    LawItem(d) -> {
      let reason = not_in_a_function(b"a `law`");
      let g = match d.guard {
        None -> { state: state, expression: None },
        Some(x) -> {
          let o = rewrite_tries(state, x, Some(reason), None);
          { state: o.state, expression: Some(o.expression) }
        },
      };
      let b = rewrite_tries(g.state, d.body, Some(reason), None);
      { state: b.state, item: LawItem({ ..d, guard: g.expression, body: b.expression }) }
    },
    SchemaItem(d) -> {
      let reason = not_in_a_function(b"a `law schema`");
      let g = match d.guard {
        None -> { state: state, expression: None },
        Some(x) -> {
          let o = rewrite_tries(state, x, Some(reason), None);
          { state: o.state, expression: Some(o.expression) }
        },
      };
      let b = rewrite_tries(g.state, d.body, Some(reason), None);
      { state: b.state, item: SchemaItem({ ..d, guard: g.expression, body: b.expression }) }
    },
    _ -> { state: state, item: item },
  }
}

pub fn expand_try(
  module: Module,
  diagnostics: List<ParseDiagnostic>,
) -> { module: Module, diagnostics: List<ParseDiagnostic> } / {abort.raise} = {
  let start = {
    types: collect_types(module),
    shadowed: shadowing_constructor(module),
    diagnostics: diagnostics,
    mode: None,
    fresh: 0,
    exit: None,
    exits: 0,
    item_start: 0,
  };
  let walked = module.items.fold(
    { state: start, items: [] },
    |acc: { state: TryState, items: List<Item> }, item: Item| {
      let o = expand_item_try(acc.state, item);
      { state: o.state, items: acc.items.push(o.item) }
    },
  );
  { module: { ..module, items: walked.items }, diagnostics: walked.state.diagnostics }
}

fn tries_in(e: Expression) -> Int =
  count_in(e, |x: Expression| match x { PropagateExpression(_) -> true, _ -> false })
