import std.list
import compiler.check.known (ok_ctor, err_ctor)
import compiler.syntax.parsing (Span, Ident, ParseDiag, error_at, bare)
import compiler.syntax.patterns (Pattern, PatternVariable)
import compiler.syntax.items (Module, Item, FunctionItem, TypeItem, TestItem, LawItem, SchemaItem,
                              TypeDef, SumBody, VariantDef, SpecClause, ImportDecl, SelectedNames)
import compiler.syntax.exprs (Expr, LiteralExpression, NameExpression, BinaryExpression,
                              UnaryExpression, LambdaExpression, CallExpression, IfExpression,
                              MatchExpression, BlockExpression, RecordExpression,
                              RecordUpdateExpression, PropagateExpression, FieldExpression,
                              ListExpression, PerformExpression, HandleExpression,
                              WithHoldExpression, SimulateExpression, ParallelExpression,
                              InvalidExpression, HoleExpression, TryBlockExpression, Stmt,
                              LetStatement, LetElseStatement, ExpressionStatement,
                              AssignmentStatement, Param, MatchArm, RecordLiteralField, expr_span,
                              TaggedLiteralExpression, TaggedLiteral, expr_nodes_mapped,
                              expr_nodes_folded)

pub fn max_alias_depth() -> Int = 16

pub fn variable_at(name: Bytes, at: Span) -> Expr =
  NameExpression({ span: at, name: bare({ name: name, span: at }) })

pub fn binder_at(name: Bytes, at: Span) -> Pattern =
  PatternVariable({ span: at, name: { name: name, span: at } })

pub fn collect_types(module: Module) -> List<TypeDef> =
  module.items.fold([], |acc: List<TypeDef>, item: Item|
    match item {
      TypeItem(d) -> match find_type(acc, d.name.name) { Some(_) -> acc, None -> acc.push(d) },
      _ -> acc,
    })

pub fn find_type(ts: List<TypeDef>, name: Bytes) -> Option<TypeDef> =
  ts.fold(None, |acc: Option<TypeDef>, type_def: TypeDef|
    match acc {
      Some(_) -> acc,
      None -> if type_def.name.name == name { Some(type_def) } else { None },
    })

pub fn is_pure(e: Expr) -> Bool =
  match e {
    CallExpression(_) -> false,
    PerformExpression(_) -> false,
    HandleExpression(_) -> false,
    WithHoldExpression(_) -> false,
    SimulateExpression(_) -> false,
    ParallelExpression(v) -> v.branches.fold(true, |acc: Bool, x: Expr| acc && is_pure(x)),
    PropagateExpression(_) -> false,
    TryBlockExpression(_) -> false,
    HoleExpression(_) -> false,
    LiteralExpression(_) -> true,
    TaggedLiteralExpression(t) -> t.holes.len() == 0,
    NameExpression(_) -> true,
    InvalidExpression(_) -> true,
    BinaryExpression(b) -> is_pure(b.lhs) && is_pure(b.rhs),
    UnaryExpression(u) -> is_pure(u.operand),
    LambdaExpression(l) -> is_pure(l.body),
    IfExpression(i) -> is_pure(i.cond) && is_pure(i.then_branch) && is_pure(i.else_branch),
    MatchExpression(m) ->
      is_pure(m.scrutinee)
        && m.arms.fold(true, |acc: Bool, arm: MatchArm|
          acc && is_pure(arm.body) && (match arm.guard { None -> true, Some(g) -> is_pure(g) })),
    BlockExpression(b) ->
      b.stmts.fold(true, |acc: Bool, stmt: Stmt|
          acc
            && (match stmt {
              LetStatement(l) -> is_pure(l.value),
              LetElseStatement(l) -> is_pure(l.value) && is_pure(l.fallback),
              ExpressionStatement(x) -> is_pure(x),
              AssignmentStatement(_) -> false,
            }))
        && (match b.tail { None -> true, Some(t) -> is_pure(t) }),
    RecordExpression(r) ->
      r.fields.fold(true, |acc: Bool, f: RecordLiteralField| acc && is_pure(f.value)),
    RecordUpdateExpression(r) ->
      is_pure(r.base)
        && r.fields.fold(true, |acc: Bool, f: RecordLiteralField| acc && is_pure(f.value)),
    FieldExpression(f) -> is_pure(f.base),
    ListExpression(l) -> l.items.fold(true, |acc: Bool, x: Expr| acc && is_pure(x)),
  }

pub fn map_item(item: Item, f: (Expr) -> Expr) -> Item = {
  let go = |x: Expr| expr_nodes_mapped(x, f);
  match item {
    FunctionItem(d) ->
      FunctionItem({
        ..d,
        params: d.params.map(|param: Param|
          { ..param, default: match param.default { None -> None, Some(x) -> Some(go(x)) } }),
        spec: d.spec.map(|clause: SpecClause|
          { kind: clause.kind, expr: go(clause.expr), span: clause.span }),
        body: go(d.body),
      }),
    TestItem(d) ->
      TestItem({
        ..d,
        cases: match d.cases {
          None -> None,
          Some(c) -> Some({ ..c, table: go(c.table), label: go(c.label) }),
        },
        body: go(d.body),
      }),
    LawItem(d) ->
      LawItem({
        ..d,
        guard: match d.guard { None -> None, Some(g) -> Some(go(g)) },
        body: go(d.body),
      }),
    _ -> item,
  }
}

pub fn is_tagged(expr: Expr) -> Bool = match expr { TaggedLiteralExpression(_) -> true, _ -> false }

pub fn tagged_in(module: Module) -> List<TaggedLiteral> =
  expressions_matching(module, is_tagged).fold([], |acc: List<TaggedLiteral>, e: Expr|
    match e { TaggedLiteralExpression(t) -> acc.push(t), _ -> acc })

pub fn expressions_matching(module: Module, predicate: (Expr) -> Bool) -> List<Expr> = {
  let collect_matching = |e: Expr, found: List<Expr>|
    expr_nodes_folded(e, found, |acc: List<Expr>, x: Expr|
      if predicate(x) { acc.push(x) } else { acc });
  module.items.fold([], |acc: List<Expr>, item: Item|
    match item {
      FunctionItem(d) ->
        d.spec.fold(collect_matching(d.body, acc), |out: List<Expr>, clause: SpecClause|
          collect_matching(clause.expr, out)),
      TestItem(d) ->
        collect_matching(d.body, match d.cases {
          None -> acc,
          Some(c) -> collect_matching(c.table, collect_matching(c.label, acc)),
        }),
      LawItem(d) -> {
        let guarded = match ((d.guard, d.of)) {
          (Some(g), None) -> collect_matching(g, acc),
          _ -> acc,
        };
        collect_matching(d.body, guarded)
      },
      _ -> acc,
    })
}

pub fn bare_names_read(e: Expr) -> List<Bytes> =
  expr_nodes_folded(e, [], |acc: List<Bytes>, x: Expr|
    match x {
      NameExpression(v) -> if v.name.module == None { acc.push(v.name.name.name) } else { acc },
      _ -> acc,
    })

pub fn is_try_block(expr: Expr) -> Bool = match expr { TryBlockExpression(_) -> true, _ -> false }

type OwnBinding = { name: Bytes, imported: Bool }

pub fn own_binding_among(module: Module, names: List<Bytes>) -> Option<OwnBinding> = {
  let imported = module.imports.fold(None, |acc: Option<OwnBinding>, d: ImportDecl|
    match acc {
      Some(_) -> acc,
      None -> match d.kind {
        SelectedNames(ns) ->
          ns.fold(None, |b: Option<OwnBinding>, ident: Ident|
            match b {
              Some(_) -> b,
              None -> if names.contains(ident.name) { Some({ name: ident.name, imported: true }) }
              else { None },
            }),
        _ -> None,
      },
    });
  match imported {
    Some(_) -> imported,
    None ->
      module.items.fold(None, |acc: Option<OwnBinding>, item: Item|
        match acc {
          Some(_) -> acc,
          None -> match item {
            TypeItem(d) -> match d.body {
              SumBody(vs) ->
                vs.fold(None, |b: Option<OwnBinding>, variant: VariantDef|
                  match b {
                    Some(_) -> b,
                    None -> if names.contains(variant.name.name) {
                      Some({ name: variant.name.name, imported: false })
                    } else { None },
                  }),
              _ -> None,
            },
            FunctionItem(d) -> if names.contains(d.name.name) {
              Some({ name: d.name.name, imported: false })
            } else { None },
            _ -> None,
          },
        }),
  }
}

fn capture_error(
  span: Span,
  form: Bytes,
  lacks: Bytes,
  own: OwnBinding,
  answers: Bytes,
) -> ParseDiag =
  error_at(
    b"E0118",
    span,
    Bytes::concat_all([b"this file gives ", form, b" no meaning here"]),
    lacks,
    [
      Bytes::concat_all([
        b"this module binds its own `",
        own.name,
        b"`, which would capture ",
        answers,
      ]),
    ],
  )

pub fn report_rebound_constructors(module: Module, diags: List<ParseDiag>) -> List<ParseDiag> = {
  let tried = match own_binding_among(module, [ok_ctor(), err_ctor()]) {
    None -> diags,
    Some(own) ->
      expressions_matching(module, is_try_block).fold(diags, |acc: List<ParseDiag>, e: Expr|
        acc.push(
          capture_error(
            expr_span(e),
            b"`try`",
            b"no `Result` to answer with",
            own,
            b"the `Ok` and `Err` a `try` answers with; rename it or qualify it, or write the `handle` out",
          ),
        )),
  };
  match own_binding_among(module, [ok_ctor()]) {
    None -> tried,
    Some(own) ->
      tagged_in(module).fold(tried, |acc: List<ParseDiag>, t: TaggedLiteral|
        acc.push(
          capture_error(
            t.span,
            b"a tagged literal",
            b"no `Ok` to read it through",
            own,
            b"the `Ok` a tagged literal is read through; rename it or qualify it, or call `literal` and match on what it answers",
          ),
        )),
  }
}

pub fn any_expr(module: Module, p: (Expr) -> Bool) -> Bool =
  module.items.fold(false, |acc: Bool, item: Item|
    acc
      || (match item {
        FunctionItem(d) ->
          count_in(d.body, p) > 0
            || d.spec.fold(false, |b: Bool, clause: SpecClause| b || count_in(clause.expr, p) > 0)
            || d.params.fold(false, |b: Bool, param: Param|
              b || (match param.default { None -> false, Some(v) -> count_in(v, p) > 0 })),
        TestItem(d) ->
          count_in(d.body, p) > 0
            || (match d.cases {
              None -> false,
              Some(c) -> count_in(c.table, p) > 0 || count_in(c.label, p) > 0,
            }),
        LawItem(d) ->
          count_in(d.body, p) > 0
            || (match d.guard { None -> false, Some(g) -> count_in(g, p) > 0 }),
        SchemaItem(d) ->
          count_in(d.body, p) > 0
            || (match d.guard { None -> false, Some(g) -> count_in(g, p) > 0 }),
        _ -> false,
      }))

pub fn count_in(e: Expr, p: (Expr) -> Bool) -> Int =
  expr_nodes_folded(e, 0, |n: Int, x: Expr| if p(x) { n + 1 } else { n })
