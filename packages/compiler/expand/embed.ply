import compiler.syntax.parsing (Span, Ident, ParseDiag, error_at)
import compiler.syntax.exprs (Expr, LiteralExpression, NameExpression, BinaryExpression,
                              UnaryExpression, LambdaExpression, CallExpression, IfExpression,
                              MatchExpression, BlockExpression, RecordExpression,
                              RecordUpdateExpression, PropagateExpression, FieldExpression,
                              ListExpression, PerformExpression, HandleExpression,
                              WithHoldExpression, SimulateExpression, ParallelExpression,
                              InvalidExpression, TryBlockExpression, Stmt, LetStatement,
                              LetElseStatement, ExpressionStatement, AssignmentStatement,
                              HandlerVar, Param, MatchArm, HandleClause, ReturnClause,
                              RecordLiteralField, NamedArg, TaggedLiteralExpression, Hole)
import compiler.syntax.patterns (LiteralString, LiteralEmbedded)
import compiler.syntax.items (Module, Item, FunctionItem, TestItem, LawItem, SchemaItem, ImportDecl,
                              SelectedNames, SpecClause, item_owner)
import std.list
import std.bin
import std.hash (blake3)

pub type EmbedFile = { name: Bytes, digest: Bytes, size: Int }

pub type EmbedResult = Result<List<EmbedFile>, Bytes>

pub type EmbedBytes = { name: Bytes, bytes: Bytes }

pub type EmbedBytesResult = Result<List<EmbedBytes>, Bytes>

pub fn embed_file(name: Bytes, bytes: Bytes) -> EmbedFile =
  { name: name, digest: blake3(bytes), size: bytes.len() }

pub fn with_digests(read: EmbedBytesResult) -> EmbedResult =
  match read {
    Ok(files) -> Ok(files.map(|f: EmbedBytes| embed_file(f.name, f.bytes))),
    Err(why) -> Err(why),
  }

pub type EmbedRequest = { path: Bytes, dir: Bool }

derive bin for EmbedRequest

pub fn embed_key(want: EmbedRequest) -> Bytes =
  Bytes::concat(if want.dir { b"dir:" } else { b"file:" }, want.path)

pub fn request_of_key(key: Bytes) -> EmbedRequest / {abort.raise} =
  if key.starts_with(b"dir:") { { path: key.slice(4, key.len()), dir: true } }
  else { { path: key.slice(5, key.len()), dir: false } }

pub type ModuleEmbed = { module: Bytes, key: Bytes, read: EmbedResult }

derive bin for EmbedFile

pub fn embed_result_bin() -> bin::BinCodec<EmbedResult> =
  bin::result_bin(bin::list_bin(embed_file_bin()), bin::bytes_bin())

derive bin for ModuleEmbed

pub fn embed_tables(embeds: List<ModuleEmbed>) -> Map<Bytes, Map<Bytes, EmbedResult>> =
  embeds.fold(Map::new(), |acc: Map<Bytes, Map<Bytes, EmbedResult>>, embed: ModuleEmbed| {
    let was = match acc.get(embed.module) { Some(t) -> t, None -> Map::new() };
    acc.insert(embed.module, was.insert(embed.key, embed.read))
  })

pub fn inline_embeds_by_name(
  tables: Map<Bytes, Map<Bytes, EmbedResult>>,
  name: Bytes,
  module: Module,
) -> { module: Module, diags: List<ParseDiag> } =
  match tables.get(name) {
    None -> { module: module, diags: [] },
    Some(t) -> inline_embeds(module, t, []),
  }

type EmbedCall = { want: EmbedRequest, span: Span, literal: Bool }

fn own_names(module: Module) -> List<Bytes> = {
  let declared = module.items.fold([], |acc: List<Bytes>, item: Item|
    match item { FunctionItem(d) -> acc.push(d.name.name), _ -> acc });
  module.imports.fold(declared, |acc: List<Bytes>, decl: ImportDecl|
    match decl.kind {
      SelectedNames(names) -> names.fold(acc, |a: List<Bytes>, ident: Ident| a.push(ident.name)),
      _ -> acc,
    })
}

fn embed_call(own: List<Bytes>, expr: Expr) -> Option<EmbedCall> =
  match expr {
    CallExpression(a) -> match a.func {
      NameExpression(v) -> {
        let n = v.name.name.name;
        if v.name.module != None || (n != b"embed" && n != b"embed_dir") || own.contains(n) { None }
        else {
          let path = if a.args.len() == 1 && a.named.len() == 0 {
            match a.args.at(0) {
              Some(arg) -> match arg {
                LiteralExpression(l) -> match l.lit { LiteralString(p) -> Some(p), _ -> None },
                _ -> None,
              },
              None -> None,
            }
          } else { None };
          Some({
            want: { path: match path { Some(p) -> p, None -> b"" }, dir: n == b"embed_dir" },
            span: a.span,
            literal: path != None,
          })
        }
      },
      _ -> None,
    },
    _ -> None,
  }

pub fn embed_requests(module: Module) -> List<EmbedRequest> = {
  let own = own_names(module);
  let found = walk_module(module, { own: own, read: Map::new(), diags: [], wants: [] }, false);
  found.state.wants
}

pub fn requests_in(items: List<ItemEmbeds>) -> List<EmbedRequest> =
  items.fold(
    { own: [], read: Map::new(), diags: [], wants: [] },
    |state: EmbedState, item: ItemEmbeds| item.wants.fold(state, add_request),
  ).wants

pub type ItemEmbeds = { name: Option<Bytes>, wants: List<EmbedRequest> }

derive bin for ItemEmbeds

pub fn requests_by_item(module: Module) -> List<ItemEmbeds> = {
  let own = own_names(module);
  module.items.fold([], |acc: List<ItemEmbeds>, item: Item| {
    let o = walk_item({ own: own, read: Map::new(), diags: [], wants: [] }, item, false);
    if o.state.wants.len() == 0 { acc } else {
      acc.push({
        name: {
          let o = item_owner(item);
          if o.len() == 0 { None } else { Some(o) }
        },
        wants: o.state.wants,
      })
    }
  })
}

pub fn inline_embeds(
  module: Module,
  read: Map<Bytes, EmbedResult>,
  diags: List<ParseDiag>,
) -> { module: Module, diags: List<ParseDiag> } = {
  let walked = walk_module(
    module,
    { own: own_names(module), read: read, diags: diags, wants: [] },
    true,
  );
  { module: walked.module, diags: walked.state.diags }
}

type EmbedState = {
  own: List<Bytes>,
  read: Map<Bytes, EmbedResult>,
  diags: List<ParseDiag>,
  wants: List<EmbedRequest>,
}

fn add_request(state: EmbedState, w: EmbedRequest) -> EmbedState =
  if state.wants.fold(false, |acc: Bool, x: EmbedRequest|
      acc || (x.path == w.path && x.dir == w.dir)) { state }
  else { { ..state, wants: state.wants.push(w) } }

fn inline_call(state: EmbedState, call: EmbedCall) -> { state: EmbedState, expr: Expr } =
  if !call.literal {
    {
      state: {
        ..state,
        diags: state.diags.push(
          error_at(
            b"E0147",
            call.span,
            b"an embed's path is a string literal",
            b"read when the program is loaded, so it cannot be computed",
            [],
          ),
        ),
      },
      expr: InvalidExpression({ span: call.span }),
    }
  } else {
    let unread = |why: Bytes|
      {
        state: {
          ..state,
          diags: state.diags.push(
            error_at(
              b"E0146",
              call.span,
              Bytes::concat_all([b"`", call.want.path, b"` could not be embedded"]),
              why,
              [b"the path is read relative to the module's own file"],
            ),
          ),
        },
        expr: InvalidExpression({ span: call.span }),
      };
    match state.read.get(embed_key(call.want)) {
      None -> unread(b"nothing was read for it"),
      Some(Err(why)) -> unread(why),
      Some(Ok(files)) -> if !call.want.dir {
        match files {
          [file, ..] ->
            {
              state: state,
              expr: LiteralExpression({
                span: call.span,
                lit: LiteralEmbedded(file.digest, file.size),
              }),
            },
          [] -> unread(b"nothing was read for it"),
        }
      } else {
        {
          state: state,
          expr: ListExpression({
            span: call.span,
            items: files.map(|file: EmbedFile|
              RecordExpression({
                span: call.span,
                fields: [
                  {
                    name: { name: b"name", span: call.span },
                    value: LiteralExpression({ span: call.span, lit: LiteralString(file.name) }),
                  },
                  {
                    name: { name: b"bytes", span: call.span },
                    value: LiteralExpression({
                      span: call.span,
                      lit: LiteralEmbedded(file.digest, file.size),
                    }),
                  },
                ],
              })),
          }),
        }
      },
    }
  }

type WalkResult = { state: EmbedState, expr: Expr }

fn walk_module(
  module: Module,
  state: EmbedState,
  inlining: Bool,
) -> { state: EmbedState, module: Module } = {
  let w = module.items.fold(
    { state: state, items: [] },
    |acc: { state: EmbedState, items: List<Item> }, item: Item| {
      let o = walk_item(acc.state, item, inlining);
      { state: o.state, items: acc.items.push(o.item) }
    },
  );
  { state: w.state, module: { ..module, items: w.items } }
}

fn walk_item(state: EmbedState, item: Item, inlining: Bool) -> { state: EmbedState, item: Item } =
  match item {
    FunctionItem(d) -> {
      let b = walk(state, d.body, inlining);
      let s = d.spec.fold(
        { state: b.state, xs: [] },
        |acc: { state: EmbedState, xs: List<SpecClause> }, clause: SpecClause| {
          let o = walk(acc.state, clause.expr, inlining);
          { state: o.state, xs: acc.xs.push({ ..clause, expr: o.expr }) }
        },
      );
      let p = walk_params(s.state, d.params, inlining);
      { state: p.state, item: FunctionItem({ ..d, body: b.expr, spec: s.xs, params: p.xs }) }
    },
    TestItem(d) -> {
      let b = walk(state, d.body, inlining);
      match d.cases {
        None -> { state: b.state, item: TestItem({ ..d, body: b.expr }) },
        Some(c) -> {
          let table = walk(b.state, c.table, inlining);
          let label = walk(table.state, c.label, inlining);
          {
            state: label.state,
            item: TestItem({
              ..d,
              body: b.expr,
              cases: Some({ ..c, table: table.expr, label: label.expr }),
            }),
          }
        },
      }
    },
    LawItem(d) -> {
      let b = walk(state, d.body, inlining);
      match d.guard {
        None -> { state: b.state, item: LawItem({ ..d, body: b.expr }) },
        Some(g) -> {
          let o = walk(b.state, g, inlining);
          { state: o.state, item: LawItem({ ..d, body: b.expr, guard: Some(o.expr) }) }
        },
      }
    },
    SchemaItem(d) -> if inlining { { state: state, item: item } } else {
      let b = walk(state, d.body, inlining);
      match d.guard {
        None -> { state: b.state, item: item },
        Some(g) -> { state: walk(b.state, g, inlining).state, item: item },
      }
    },
    other -> { state: state, item: other },
  }

fn walk_params(
  state: EmbedState,
  params: List<Param>,
  inlining: Bool,
) -> { state: EmbedState, xs: List<Param> } =
  params.fold(
    { state: state, xs: [] },
    |acc: { state: EmbedState, xs: List<Param> }, param: Param|
      match param.default {
        None -> { state: acc.state, xs: acc.xs.push(param) },
        Some(v) -> {
          let o = walk(acc.state, v, inlining);
          { state: o.state, xs: acc.xs.push({ ..param, default: Some(o.expr) }) }
        },
      },
  )

fn walk_all(
  state: EmbedState,
  exprs: List<Expr>,
  inlining: Bool,
) -> { state: EmbedState, xs: List<Expr> } =
  exprs.fold({ state: state, xs: [] }, |acc: { state: EmbedState, xs: List<Expr> }, expr: Expr| {
    let o = walk(acc.state, expr, inlining);
    { state: o.state, xs: acc.xs.push(o.expr) }
  })

fn walk_optional(
  state: EmbedState,
  expr: Option<Expr>,
  inlining: Bool,
) -> { state: EmbedState, x: Option<Expr> } =
  match expr {
    None -> { state: state, x: None },
    Some(v) -> {
      let o = walk(state, v, inlining);
      { state: o.state, x: Some(o.expr) }
    },
  }

fn walk_fields(
  state: EmbedState,
  fields: List<RecordLiteralField>,
  inlining: Bool,
) -> { state: EmbedState, xs: List<RecordLiteralField> } =
  fields.fold(
    { state: state, xs: [] },
    |acc: { state: EmbedState, xs: List<RecordLiteralField> }, field: RecordLiteralField| {
      let o = walk(acc.state, field.value, inlining);
      { state: o.state, xs: acc.xs.push({ ..field, value: o.expr }) }
    },
  )

fn walk(state: EmbedState, expr: Expr, inlining: Bool) -> WalkResult =
  match embed_call(state.own, expr) {
    Some(c) -> if inlining { inline_call(state, c) }
    else { { state: if c.literal { add_request(state, c.want) } else { state }, expr: expr } },
    None -> walk_children(state, expr, inlining),
  }

fn walk_children(state: EmbedState, expr: Expr, inlining: Bool) -> WalkResult =
  match expr {
    BinaryExpression(b) -> {
      let l = walk(state, b.lhs, inlining);
      let r = walk(l.state, b.rhs, inlining);
      { state: r.state, expr: BinaryExpression({ ..b, lhs: l.expr, rhs: r.expr }) }
    },
    UnaryExpression(u) -> {
      let o = walk(state, u.operand, inlining);
      { state: o.state, expr: UnaryExpression({ ..u, operand: o.expr }) }
    },
    LambdaExpression(l) -> {
      let b = walk(state, l.body, inlining);
      let p = walk_params(b.state, l.params, inlining);
      { state: p.state, expr: LambdaExpression({ ..l, body: b.expr, params: p.xs }) }
    },
    CallExpression(a) -> {
      let f = walk(state, a.func, inlining);
      let xs = walk_all(f.state, a.args, inlining);
      let n = a.named.fold(
        { state: xs.state, xs: [] },
        |acc: { state: EmbedState, xs: List<NamedArg> }, x: NamedArg| {
          let o = walk(acc.state, x.value, inlining);
          { state: o.state, xs: acc.xs.push({ ..x, value: o.expr }) }
        },
      );
      { state: n.state, expr: CallExpression({ ..a, func: f.expr, args: xs.xs, named: n.xs }) }
    },
    IfExpression(i) -> {
      let c = walk(state, i.cond, inlining);
      let t = walk(c.state, i.then_branch, inlining);
      let x = walk(t.state, i.else_branch, inlining);
      {
        state: x.state,
        expr: IfExpression({ ..i, cond: c.expr, then_branch: t.expr, else_branch: x.expr }),
      }
    },
    MatchExpression(m) -> {
      let s = walk(state, m.scrutinee, inlining);
      let arms = m.arms.fold(
        { state: s.state, xs: [] },
        |acc: { state: EmbedState, xs: List<MatchArm> }, arm: MatchArm| {
          let g = walk_optional(acc.state, arm.guard, inlining);
          let b = walk(g.state, arm.body, inlining);
          { state: b.state, xs: acc.xs.push({ ..arm, guard: g.x, body: b.expr }) }
        },
      );
      { state: arms.state, expr: MatchExpression({ ..m, scrutinee: s.expr, arms: arms.xs }) }
    },
    BlockExpression(b) -> {
      let stmts = b.stmts.fold(
        { state: state, xs: [] },
        |acc: { state: EmbedState, xs: List<Stmt> }, s: Stmt|
          match s {
            LetStatement(l) -> {
              let o = walk(acc.state, l.value, inlining);
              { state: o.state, xs: acc.xs.push(LetStatement({ ..l, value: o.expr })) }
            },
            LetElseStatement(l) -> {
              let v = walk(acc.state, l.value, inlining);
              let f = walk(v.state, l.fallback, inlining);
              {
                state: f.state,
                xs: acc.xs.push(LetElseStatement({ ..l, value: v.expr, fallback: f.expr })),
              }
            },
            ExpressionStatement(x) -> {
              let o = walk(acc.state, x, inlining);
              { state: o.state, xs: acc.xs.push(ExpressionStatement(o.expr)) }
            },
            AssignmentStatement(x) -> {
              let o = walk(acc.state, x.value, inlining);
              { state: o.state, xs: acc.xs.push(AssignmentStatement({ ..x, value: o.expr })) }
            },
          },
      );
      let t = walk_optional(stmts.state, b.tail, inlining);
      { state: t.state, expr: BlockExpression({ ..b, stmts: stmts.xs, tail: t.x }) }
    },
    RecordExpression(r) -> {
      let f = walk_fields(state, r.fields, inlining);
      { state: f.state, expr: RecordExpression({ ..r, fields: f.xs }) }
    },
    RecordUpdateExpression(r) -> {
      let b = walk(state, r.base, inlining);
      let f = walk_fields(b.state, r.fields, inlining);
      { state: f.state, expr: RecordUpdateExpression({ ..r, base: b.expr, fields: f.xs }) }
    },
    PropagateExpression(t) -> {
      let o = walk(state, t.operand, inlining);
      { state: o.state, expr: PropagateExpression({ ..t, operand: o.expr }) }
    },
    FieldExpression(f) -> {
      let o = walk(state, f.base, inlining);
      { state: o.state, expr: FieldExpression({ ..f, base: o.expr }) }
    },
    ListExpression(l) -> {
      let xs = walk_all(state, l.items, inlining);
      { state: xs.state, expr: ListExpression({ ..l, items: xs.xs }) }
    },
    PerformExpression(p) -> {
      let xs = walk_all(state, p.args, inlining);
      { state: xs.state, expr: PerformExpression({ ..p, args: xs.xs }) }
    },
    HandleExpression(h) -> {
      let vs = h.vars.fold(
        { state: state, xs: [] },
        |acc: { state: EmbedState, xs: List<HandlerVar> }, v: HandlerVar| {
          let o = walk(acc.state, v.init, inlining);
          { state: o.state, xs: acc.xs.push({ ..v, init: o.expr }) }
        },
      );
      let b = walk(vs.state, h.body, inlining);
      let cs = h.clauses.fold(
        { state: b.state, xs: [] },
        |acc: { state: EmbedState, xs: List<HandleClause> }, c: HandleClause| {
          let o = walk(acc.state, c.body, inlining);
          { state: o.state, xs: acc.xs.push({ ..c, body: o.expr }) }
        },
      );
      match h.ret {
        None ->
          {
            state: cs.state,
            expr: HandleExpression({ ..h, body: b.expr, clauses: cs.xs, vars: vs.xs }),
          },
        Some(rc) -> {
          let o = walk(cs.state, rc.body, inlining);
          {
            state: o.state,
            expr: HandleExpression({
              ..h,
              body: b.expr,
              clauses: cs.xs,
              ret: Some({ ..rc, body: o.expr }),
              vars: vs.xs,
            }),
          }
        },
      }
    },
    WithHoldExpression(c) -> {
      let a = walk(state, c.acquire, inlining);
      let r = walk(a.state, c.release, inlining);
      let b = walk(r.state, c.body, inlining);
      {
        state: b.state,
        expr: WithHoldExpression({ ..c, acquire: a.expr, release: r.expr, body: b.expr }),
      }
    },
    SimulateExpression(s) -> {
      let o = walk(state, s.body, inlining);
      { state: o.state, expr: SimulateExpression({ ..s, body: o.expr }) }
    },
    ParallelExpression(p) -> {
      let xs = walk_all(state, p.branches, inlining);
      { state: xs.state, expr: ParallelExpression({ ..p, branches: xs.xs }) }
    },
    TryBlockExpression(t) -> {
      let o = walk(state, t.body, inlining);
      { state: o.state, expr: TryBlockExpression({ ..t, body: o.expr }) }
    },
    TaggedLiteralExpression(t) -> {
      let filled = t.holes.fold(
        { state: state, holes: [] },
        |acc: { state: EmbedState, holes: List<Hole> }, h: Hole| {
          let o = walk(acc.state, h.value, inlining);
          { state: o.state, holes: acc.holes.push({ ..h, value: o.expr }) }
        },
      );
      { state: filled.state, expr: TaggedLiteralExpression({ ..t, holes: filled.holes }) }
    },
    other -> { state: state, expr: other },
  }
