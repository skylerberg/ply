import compiler.syntax.parsing (Span, Identifier, ParseDiagnostic, error_at)
import compiler.syntax.expressions (Expression, LiteralExpression, NameExpression, BinaryExpression,
                                    UnaryExpression, LambdaExpression, CallExpression, IfExpression,
                                    MatchExpression, BlockExpression, RecordExpression,
                                    RecordUpdateExpression, PropagateExpression, FieldExpression,
                                    ListExpression, PerformExpression, HandleExpression,
                                    WithScopeExpression, SimulateExpression, ParallelExpression,
                                    InvalidExpression, TryBlockExpression, Statement, LetStatement,
                                    LetElseStatement, ExpressionStatement, AssignmentStatement,
                                    HandlerStateVariable, Param, MatchArm, HandleClause,
                                    ReturnClause, RecordLiteralField, NamedArg,
                                    TaggedLiteralExpression, Hole)
import compiler.syntax.patterns (LiteralString, LiteralEmbedded)
import compiler.syntax.items (Module, Item, FunctionItem, TestItem, LawItem, SchemaItem,
                              ImportDeclaration, SelectedNames, SpecClause, item_owner)
import std.list
import std.bin
import std.hash (blake3)

pub type EmbedFile = { name: Bytes, digest: Bytes, size: Int }

pub type EmbedResult = Result<List<EmbedFile>, Bytes>

pub type EmbedBytes = { name: Bytes, bytes: Bytes }

pub type EmbedBytesResult = Result<List<EmbedBytes>, Bytes>

pub fn embed_file(name: Bytes, bytes: Bytes) -> EmbedFile =
  { name: name, digest: blake3(bytes), size: bytes.len() }

pub fn with_digests(read: EmbedBytesResult) -> EmbedResult =
  match read {
    Ok(files) -> Ok(files.map(|f: EmbedBytes| embed_file(f.name, f.bytes))),
    Err(reason) -> Err(reason),
  }

pub type EmbedRequest = { path: Bytes, dir: Bool }

derive bin for EmbedRequest

pub fn embed_key(want: EmbedRequest) -> Bytes =
  Bytes::concat(if want.dir { b"dir:" } else { b"file:" }, want.path)

pub fn request_of_key(key: Bytes) -> EmbedRequest / {abort.raise} =
  if key.starts_with(b"dir:") { { path: key.slice(4, key.len()), dir: true } }
  else { { path: key.slice(5, key.len()), dir: false } }

pub type ModuleEmbed = { module: Bytes, key: Bytes, read: EmbedResult }

derive bin for EmbedFile

pub fn embed_result_bin() -> bin::BinCodec<EmbedResult> =
  bin::result_bin(bin::list_bin(embed_file_bin()), bin::bytes_bin())

derive bin for ModuleEmbed

pub fn embed_tables(embeds: List<ModuleEmbed>) -> Map<Bytes, Map<Bytes, EmbedResult>> =
  embeds.fold(Map::new(), |accumulator: Map<Bytes, Map<Bytes, EmbedResult>>, embed: ModuleEmbed| {
    let was = match accumulator.get(embed.module) { Some(t) -> t, None -> Map::new() };
    accumulator.insert(embed.module, was.insert(embed.key, embed.read))
  })

pub fn inline_embeds_by_name(
  tables: Map<Bytes, Map<Bytes, EmbedResult>>,
  name: Bytes,
  module: Module,
) -> { module: Module, diagnostics: List<ParseDiagnostic> } =
  match tables.get(name) {
    None -> { module: module, diagnostics: [] },
    Some(t) -> inline_embeds(module, t, []),
  }

type EmbedCall = { want: EmbedRequest, span: Span, literal: Bool }

fn own_names(module: Module) -> List<Bytes> = {
  let declared = module.items.fold([], |accumulator: List<Bytes>, item: Item|
    match item { FunctionItem(d) -> accumulator.push(d.name.name), _ -> accumulator });
  module.imports.fold(declared, |accumulator: List<Bytes>, declaration: ImportDeclaration|
    match declaration.kind {
      SelectedNames(names) ->
        names.fold(accumulator, |a: List<Bytes>, identifier: Identifier| a.push(identifier.name)),
      _ -> accumulator,
    })
}

fn embed_call(own: List<Bytes>, expression: Expression) -> Option<EmbedCall> =
  match expression {
    CallExpression(a) -> match a.function {
      NameExpression(v) -> {
        let n = v.name.name.name;
        if v.name.module != None || (n != b"embed" && n != b"embed_dir") || own.contains(n) { None }
        else {
          let path = if a.args.len() == 1 && a.named.len() == 0 {
            match a.args.at(0) {
              Some(arg) -> match arg {
                LiteralExpression(l) -> match l.literal { LiteralString(p) -> Some(p), _ -> None },
                _ -> None,
              },
              None -> None,
            }
          } else { None };
          Some({
            want: { path: match path { Some(p) -> p, None -> b"" }, dir: n == b"embed_dir" },
            span: a.span,
            literal: path != None,
          })
        }
      },
      _ -> None,
    },
    _ -> None,
  }

pub fn embed_requests(module: Module) -> List<EmbedRequest> = {
  let own = own_names(module);
  let found = walk_module(
    module,
    { local_names: own, read: Map::new(), diagnostics: [], wants: [] },
    false,
  );
  found.state.wants
}

pub fn requests_in(items: List<ItemEmbeds>) -> List<EmbedRequest> =
  items.fold(
    { local_names: [], read: Map::new(), diagnostics: [], wants: [] },
    |state: EmbedState, item: ItemEmbeds| item.wants.fold(state, add_request),
  ).wants

pub type ItemEmbeds = { name: Option<Bytes>, wants: List<EmbedRequest> }

derive bin for ItemEmbeds

pub fn requests_by_item(module: Module) -> List<ItemEmbeds> = {
  let own = own_names(module);
  module.items.fold([], |accumulator: List<ItemEmbeds>, item: Item| {
    let o = walk_item(
      { local_names: own, read: Map::new(), diagnostics: [], wants: [] },
      item,
      false,
    );
    if o.state.wants.len() == 0 { accumulator } else {
      accumulator.push({
        name: {
          let o = item_owner(item);
          if o.len() == 0 { None } else { Some(o) }
        },
        wants: o.state.wants,
      })
    }
  })
}

pub fn inline_embeds(
  module: Module,
  read: Map<Bytes, EmbedResult>,
  diagnostics: List<ParseDiagnostic>,
) -> { module: Module, diagnostics: List<ParseDiagnostic> } = {
  let walked = walk_module(
    module,
    { local_names: own_names(module), read: read, diagnostics: diagnostics, wants: [] },
    true,
  );
  { module: walked.module, diagnostics: walked.state.diagnostics }
}

type EmbedState = {
  local_names: List<Bytes>,
  read: Map<Bytes, EmbedResult>,
  diagnostics: List<ParseDiagnostic>,
  wants: List<EmbedRequest>,
}

fn add_request(state: EmbedState, w: EmbedRequest) -> EmbedState =
  if state.wants.fold(false, |accumulator: Bool, x: EmbedRequest|
      accumulator || (x.path == w.path && x.dir == w.dir)) { state }
  else { { ..state, wants: state.wants.push(w) } }

fn inline_call(
  state: EmbedState,
  call: EmbedCall,
) -> { state: EmbedState, expression: Expression } =
  if !call.literal {
    {
      state: {
        ..state,
        diagnostics: state.diagnostics.push(
          error_at(
            b"E0147",
            call.span,
            b"an embed's path is a string literal",
            b"read when the program is loaded, so it cannot be computed",
            [],
          ),
        ),
      },
      expression: InvalidExpression({ span: call.span }),
    }
  } else {
    let unread = |reason: Bytes|
      {
        state: {
          ..state,
          diagnostics: state.diagnostics.push(
            error_at(
              b"E0146",
              call.span,
              Bytes::concat_all([b"`", call.want.path, b"` could not be embedded"]),
              reason,
              [b"the path is read relative to the module's own file"],
            ),
          ),
        },
        expression: InvalidExpression({ span: call.span }),
      };
    match state.read.get(embed_key(call.want)) {
      None -> unread(b"nothing was read for it"),
      Some(Err(reason)) -> unread(reason),
      Some(Ok(files)) -> if !call.want.dir {
        match files {
          [file, ..] ->
            {
              state: state,
              expression: LiteralExpression({
                span: call.span,
                literal: LiteralEmbedded(file.digest, file.size),
              }),
            },
          [] -> unread(b"nothing was read for it"),
        }
      } else {
        {
          state: state,
          expression: ListExpression({
            span: call.span,
            items: files.map(|file: EmbedFile|
              RecordExpression({
                span: call.span,
                fields: [
                  {
                    name: { name: b"name", span: call.span },
                    value: LiteralExpression({
                      span: call.span,
                      literal: LiteralString(file.name),
                    }),
                  },
                  {
                    name: { name: b"bytes", span: call.span },
                    value: LiteralExpression({
                      span: call.span,
                      literal: LiteralEmbedded(file.digest, file.size),
                    }),
                  },
                ],
              })),
          }),
        }
      },
    }
  }

type WalkResult = { state: EmbedState, expression: Expression }

fn walk_module(
  module: Module,
  state: EmbedState,
  inlining: Bool,
) -> { state: EmbedState, module: Module } = {
  let w = module.items.fold(
    { state: state, items: [] },
    |accumulator: { state: EmbedState, items: List<Item> }, item: Item| {
      let o = walk_item(accumulator.state, item, inlining);
      { state: o.state, items: accumulator.items.push(o.item) }
    },
  );
  { state: w.state, module: { ..module, items: w.items } }
}

fn walk_item(state: EmbedState, item: Item, inlining: Bool) -> { state: EmbedState, item: Item } =
  match item {
    FunctionItem(d) -> {
      let b = walk(state, d.body, inlining);
      let s = d.spec.fold(
        { state: b.state, xs: [] },
        |accumulator: { state: EmbedState, xs: List<SpecClause> }, clause: SpecClause| {
          let o = walk(accumulator.state, clause.expression, inlining);
          { state: o.state, xs: accumulator.xs.push({ ..clause, expression: o.expression }) }
        },
      );
      let p = walk_params(s.state, d.params, inlining);
      { state: p.state, item: FunctionItem({ ..d, body: b.expression, spec: s.xs, params: p.xs }) }
    },
    TestItem(d) -> {
      let b = walk(state, d.body, inlining);
      match d.cases {
        None -> { state: b.state, item: TestItem({ ..d, body: b.expression }) },
        Some(c) -> {
          let table = walk(b.state, c.table, inlining);
          let label = walk(table.state, c.label, inlining);
          {
            state: label.state,
            item: TestItem({
              ..d,
              body: b.expression,
              cases: Some({ ..c, table: table.expression, label: label.expression }),
            }),
          }
        },
      }
    },
    LawItem(d) -> {
      let b = walk(state, d.body, inlining);
      match d.guard {
        None -> { state: b.state, item: LawItem({ ..d, body: b.expression }) },
        Some(g) -> {
          let o = walk(b.state, g, inlining);
          { state: o.state, item: LawItem({ ..d, body: b.expression, guard: Some(o.expression) }) }
        },
      }
    },
    SchemaItem(d) -> if inlining { { state: state, item: item } } else {
      let b = walk(state, d.body, inlining);
      match d.guard {
        None -> { state: b.state, item: item },
        Some(g) -> { state: walk(b.state, g, inlining).state, item: item },
      }
    },
    other -> { state: state, item: other },
  }

fn walk_params(
  state: EmbedState,
  params: List<Param>,
  inlining: Bool,
) -> { state: EmbedState, xs: List<Param> } =
  params.fold(
    { state: state, xs: [] },
    |accumulator: { state: EmbedState, xs: List<Param> }, param: Param|
      match param.default {
        None -> { state: accumulator.state, xs: accumulator.xs.push(param) },
        Some(v) -> {
          let o = walk(accumulator.state, v, inlining);
          { state: o.state, xs: accumulator.xs.push({ ..param, default: Some(o.expression) }) }
        },
      },
  )

fn walk_all(
  state: EmbedState,
  expressions: List<Expression>,
  inlining: Bool,
) -> { state: EmbedState, xs: List<Expression> } =
  expressions.fold(
    { state: state, xs: [] },
    |accumulator: { state: EmbedState, xs: List<Expression> }, expression: Expression| {
      let o = walk(accumulator.state, expression, inlining);
      { state: o.state, xs: accumulator.xs.push(o.expression) }
    },
  )

fn walk_optional(
  state: EmbedState,
  expression: Option<Expression>,
  inlining: Bool,
) -> { state: EmbedState, x: Option<Expression> } =
  match expression {
    None -> { state: state, x: None },
    Some(v) -> {
      let o = walk(state, v, inlining);
      { state: o.state, x: Some(o.expression) }
    },
  }

fn walk_fields(
  state: EmbedState,
  fields: List<RecordLiteralField>,
  inlining: Bool,
) -> { state: EmbedState, xs: List<RecordLiteralField> } =
  fields.fold(
    { state: state, xs: [] },
    |accumulator: { state: EmbedState, xs: List<RecordLiteralField> }, field: RecordLiteralField| {
      let o = walk(accumulator.state, field.value, inlining);
      { state: o.state, xs: accumulator.xs.push({ ..field, value: o.expression }) }
    },
  )

fn walk(state: EmbedState, expression: Expression, inlining: Bool) -> WalkResult =
  match embed_call(state.local_names, expression) {
    Some(c) -> if inlining { inline_call(state, c) } else {
      { state: if c.literal { add_request(state, c.want) } else { state }, expression: expression }
    },
    None -> walk_children(state, expression, inlining),
  }

fn walk_children(state: EmbedState, expression: Expression, inlining: Bool) -> WalkResult =
  match expression {
    BinaryExpression(b) -> {
      let l = walk(state, b.left_operand, inlining);
      let r = walk(l.state, b.right_operand, inlining);
      {
        state: r.state,
        expression: BinaryExpression({
          ..b,
          left_operand: l.expression,
          right_operand: r.expression,
        }),
      }
    },
    UnaryExpression(u) -> {
      let o = walk(state, u.operand, inlining);
      { state: o.state, expression: UnaryExpression({ ..u, operand: o.expression }) }
    },
    LambdaExpression(l) -> {
      let b = walk(state, l.body, inlining);
      let p = walk_params(b.state, l.params, inlining);
      { state: p.state, expression: LambdaExpression({ ..l, body: b.expression, params: p.xs }) }
    },
    CallExpression(a) -> {
      let f = walk(state, a.function, inlining);
      let xs = walk_all(f.state, a.args, inlining);
      let n = a.named.fold(
        { state: xs.state, xs: [] },
        |accumulator: { state: EmbedState, xs: List<NamedArg> }, x: NamedArg| {
          let o = walk(accumulator.state, x.value, inlining);
          { state: o.state, xs: accumulator.xs.push({ ..x, value: o.expression }) }
        },
      );
      {
        state: n.state,
        expression: CallExpression({ ..a, function: f.expression, args: xs.xs, named: n.xs }),
      }
    },
    IfExpression(i) -> {
      let c = walk(state, i.cond, inlining);
      let t = walk(c.state, i.then_branch, inlining);
      let x = walk(t.state, i.else_branch, inlining);
      {
        state: x.state,
        expression: IfExpression({
          ..i,
          cond: c.expression,
          then_branch: t.expression,
          else_branch: x.expression,
        }),
      }
    },
    MatchExpression(m) -> {
      let s = walk(state, m.scrutinee, inlining);
      let arms = m.arms.fold(
        { state: s.state, xs: [] },
        |accumulator: { state: EmbedState, xs: List<MatchArm> }, arm: MatchArm| {
          let g = walk_optional(accumulator.state, arm.guard, inlining);
          let b = walk(g.state, arm.body, inlining);
          { state: b.state, xs: accumulator.xs.push({ ..arm, guard: g.x, body: b.expression }) }
        },
      );
      {
        state: arms.state,
        expression: MatchExpression({ ..m, scrutinee: s.expression, arms: arms.xs }),
      }
    },
    BlockExpression(b) -> {
      let statements = b.statements.fold(
        { state: state, xs: [] },
        |accumulator: { state: EmbedState, xs: List<Statement> }, s: Statement|
          match s {
            LetStatement(l) -> {
              let o = walk(accumulator.state, l.value, inlining);
              {
                state: o.state,
                xs: accumulator.xs.push(LetStatement({ ..l, value: o.expression })),
              }
            },
            LetElseStatement(l) -> {
              let v = walk(accumulator.state, l.value, inlining);
              let f = walk(v.state, l.fallback, inlining);
              {
                state: f.state,
                xs: accumulator.xs.push(
                  LetElseStatement({ ..l, value: v.expression, fallback: f.expression }),
                ),
              }
            },
            ExpressionStatement(x) -> {
              let o = walk(accumulator.state, x, inlining);
              { state: o.state, xs: accumulator.xs.push(ExpressionStatement(o.expression)) }
            },
            AssignmentStatement(x) -> {
              let o = walk(accumulator.state, x.value, inlining);
              {
                state: o.state,
                xs: accumulator.xs.push(AssignmentStatement({ ..x, value: o.expression })),
              }
            },
          },
      );
      let t = walk_optional(statements.state, b.tail, inlining);
      { state: t.state, expression: BlockExpression({ ..b, statements: statements.xs, tail: t.x }) }
    },
    RecordExpression(r) -> {
      let f = walk_fields(state, r.fields, inlining);
      { state: f.state, expression: RecordExpression({ ..r, fields: f.xs }) }
    },
    RecordUpdateExpression(r) -> {
      let b = walk(state, r.base, inlining);
      let f = walk_fields(b.state, r.fields, inlining);
      {
        state: f.state,
        expression: RecordUpdateExpression({ ..r, base: b.expression, fields: f.xs }),
      }
    },
    PropagateExpression(t) -> {
      let o = walk(state, t.operand, inlining);
      { state: o.state, expression: PropagateExpression({ ..t, operand: o.expression }) }
    },
    FieldExpression(f) -> {
      let o = walk(state, f.base, inlining);
      { state: o.state, expression: FieldExpression({ ..f, base: o.expression }) }
    },
    ListExpression(l) -> {
      let xs = walk_all(state, l.items, inlining);
      { state: xs.state, expression: ListExpression({ ..l, items: xs.xs }) }
    },
    PerformExpression(p) -> {
      let xs = walk_all(state, p.args, inlining);
      { state: xs.state, expression: PerformExpression({ ..p, args: xs.xs }) }
    },
    HandleExpression(h) -> {
      let vs = h.handler_variables.fold(
        { state: state, xs: [] },
        |accumulator: { state: EmbedState, xs: List<HandlerStateVariable> }, v: HandlerStateVariable| {
          let o = walk(accumulator.state, v.init, inlining);
          { state: o.state, xs: accumulator.xs.push({ ..v, init: o.expression }) }
        },
      );
      let b = walk(vs.state, h.body, inlining);
      let cs = h.clauses.fold(
        { state: b.state, xs: [] },
        |accumulator: { state: EmbedState, xs: List<HandleClause> }, c: HandleClause| {
          let o = walk(accumulator.state, c.body, inlining);
          { state: o.state, xs: accumulator.xs.push({ ..c, body: o.expression }) }
        },
      );
      match h.return_clause {
        None ->
          {
            state: cs.state,
            expression: HandleExpression({
              ..h,
              body: b.expression,
              clauses: cs.xs,
              handler_variables: vs.xs,
            }),
          },
        Some(return_clause) -> {
          let o = walk(cs.state, return_clause.body, inlining);
          {
            state: o.state,
            expression: HandleExpression({
              ..h,
              body: b.expression,
              clauses: cs.xs,
              return_clause: Some({ ..return_clause, body: o.expression }),
              handler_variables: vs.xs,
            }),
          }
        },
      }
    },
    WithScopeExpression(c) -> {
      let a = walk(state, c.acquire, inlining);
      let r = walk(a.state, c.release, inlining);
      let b = walk(r.state, c.body, inlining);
      {
        state: b.state,
        expression: WithScopeExpression({
          ..c,
          acquire: a.expression,
          release: r.expression,
          body: b.expression,
        }),
      }
    },
    SimulateExpression(s) -> {
      let o = walk(state, s.body, inlining);
      { state: o.state, expression: SimulateExpression({ ..s, body: o.expression }) }
    },
    ParallelExpression(p) -> {
      let xs = walk_all(state, p.branches, inlining);
      { state: xs.state, expression: ParallelExpression({ ..p, branches: xs.xs }) }
    },
    TryBlockExpression(t) -> {
      let o = walk(state, t.body, inlining);
      { state: o.state, expression: TryBlockExpression({ ..t, body: o.expression }) }
    },
    TaggedLiteralExpression(t) -> {
      let filled = t.holes.fold(
        { state: state, holes: [] },
        |accumulator: { state: EmbedState, holes: List<Hole> }, h: Hole| {
          let o = walk(accumulator.state, h.value, inlining);
          { state: o.state, holes: accumulator.holes.push({ ..h, value: o.expression }) }
        },
      );
      { state: filled.state, expression: TaggedLiteralExpression({ ..t, holes: filled.holes }) }
    },
    other -> { state: state, expression: other },
  }
