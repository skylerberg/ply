import std.bin
import std.list
import compiler.syntax.parsing (Span, Identifier, QName, ParseDiagnostic, span_to, bare,
                                dump_diagnostics, starts_upper, synthetic_span, synthetic_span_at,
                                role_member_receiver, role_member_field, role_member_callee,
                                role_spawn_let, role_spawn_binder, role_spawn_perform,
                                role_spawn_lambda, role_spawn_call, role_spawn_read)
import compiler.syntax.type_syntax (FunctionTypeExpression, WriteMode, nullary)
import compiler.syntax.items (Module, Item, FunctionItem, LawItem, SchemaItem, FnDefinition, Binder,
                              SchemaDefinition, schema_guard_name, parse, dump_module)
import compiler.syntax.calls (slotted, ordered_arguments)
import compiler.syntax.expressions (local, Expression, NameExpression, CallExpression,
                                    BlockExpression, MatchExpression, MatchArm, LambdaExpression,
                                    PropagateExpression, FieldExpression, PerformExpression,
                                    HandleExpression, LetStatement, NamedArg, TaggedLiteral,
                                    HandleClause, is_exit_effect, exit_operation_name)
import compiler.syntax.patterns (Pattern, PatternConstructor, PatternVariable)
import compiler.emit.abi
import compiler.emit.abi (Native, native_named)
import compiler.check.known (int_name, bool_name, float_name, decimal_name, fixed_widths)
import compiler.expand.rewrite.shared (map_item, tagged_in, report_rebound_constructors,
                                       any_expression, binder_at)
import compiler.expand.rewrite.try_operator (expand_try)

pub type Written = {
  qualifier: Bytes,
  name: Bytes,
  names: List<Bytes>,
  defaults: List<Option<Expression>>,
}

pub type MemberCallee = | WrittenOut(Written) | InField

fn member_arguments(
  m: Written,
  at: Span,
  on: Expression,
  args: List<Expression>,
  named: List<NamedArg>,
) -> List<Expression> = {
  let written = [on].concat(args);
  if written.len() > m.names.len() { written } else {
    let s = slotted(m.names, m.defaults, written, named, at);
    if s.missing.len() > 0 { written } else { ordered_arguments(s.slots, written, named) }
  }
}

fn member_name_expression(m: Written, at: Span) -> Expression = {
  let named = { ..at, site: 0 };
  NameExpression({
    span: at,
    name: {
      module: if m.qualifier.len() == 0 { None } else { Some({ name: m.qualifier, span: named }) },
      name: { name: m.name, span: named },
      span: named,
    },
  })
}

fn expand_member_call(sites: Map<Int, MemberCallee>, expression: Expression) -> Expression =
  match expression {
    NameExpression(v) -> match v.name.module {
      None -> expression,
      Some(of) -> if !starts_upper(of.name) { expression } else {
        match sites.get(v.span.site) {
          Some(WrittenOut(m)) -> member_name_expression(m, v.span),
          _ -> expression,
        }
      },
    },
    CallExpression(a) -> match a.function {
      FieldExpression(f) -> match sites.get(a.span.site) {
        Some(WrittenOut(m)) ->
          CallExpression({
            span: a.span,
            function: member_name_expression(m, f.span),
            named: [],
            args: member_arguments(m, a.span, f.base, a.args, a.named),
            labels: a.labels,
          }),
        _ -> expression,
      },
      _ -> expression,
    },
    PerformExpression(p) -> {
      let on = NameExpression({
        span: synthetic_span_at(p.effect_name.span, p.span, role_member_receiver()),
        name: p.effect_name,
      });
      let labels = match p.resource { Some(r) -> [r], None -> [] };
      match sites.get(p.span.site) {
        Some(InField) ->
          CallExpression({
            span: p.span,
            function: FieldExpression({
              span: synthetic_span_at(
                span_to(p.effect_name.span, p.operation.span),
                p.span,
                role_member_field(),
              ),
              base: on,
              field: p.operation,
            }),
            named: [],
            args: p.args,
            labels: labels,
          }),
        Some(WrittenOut(m)) ->
          CallExpression({
            span: p.span,
            function: member_name_expression(
              m,
              synthetic_span_at(p.operation.span, p.span, role_member_callee()),
            ),
            named: [],
            args: member_arguments(m, p.span, on, p.args, []),
            labels: labels,
          }),
        None -> expression,
      }
    },
    _ -> expression,
  }

pub fn expand_function_member_calls(
  definition: FnDefinition,
  sites: Map<Int, MemberCallee>,
) -> FnDefinition =
  if sites.len() == 0 { definition } else {
    match map_item(FunctionItem(definition), |expression: Expression|
        expand_member_call(sites, expression)) {
      FunctionItem(d) -> d,
      _ -> definition,
    }
  }

pub fn witness_code(name: Bytes) -> Int = {
  let widths = fixed_widths().map(|w: { name: Bytes, bits: Int, signed: Bool }| w.name);
  match widths.concat([int_name(), float_name(), decimal_name()]).index_of(name) {
    Some(i) -> i,
    None -> widths.len(),
  }
}

pub fn declared_witness_name() -> Bytes = b"?stated_witness"

pub fn numeric_operators() -> List<Bytes> =
  [
    b"add",
    b"sub",
    b"mul",
    b"div",
    b"rem",
    b"lt",
    b"le",
    b"gt",
    b"ge",
    b"bitand",
    b"bitor",
    b"bitxor",
    b"shl",
    b"shr",
    b"ushr",
  ]

pub fn numeric_operator_code(operator: Bytes) -> Int = {
  let operators = numeric_operators();
  range(0, operators.len()).fold(0 - 1, |accumulator: Int, i: Int|
    if accumulator >= 0 { accumulator }
    else if operators.at(i) == Some(operator) { i }
    else { accumulator })
}

pub type CompilerNative = { name: Bytes, words: Int, results: Bool, raises: Bool }

pub fn compiler_natives() -> List<CompilerNative> =
  elaboration_natives().concat(emitter_natives()).concat(
    abi::natives().map(|n: Native|
      { name: n.name, words: n.params.len(), results: n.result != None, raises: n.raises }),
  )

pub type FloatFunction = { name: Bytes, native: Bytes, operands: Int }

pub fn float_functions() -> List<FloatFunction> =
  [
    { name: b"Float::exp", native: b"?float_exp" },
    { name: b"Float::ln", native: b"?float_ln" },
    { name: b"Float::log2", native: b"?float_log2" },
    { name: b"Float::log10", native: b"?float_log10" },
    { name: b"Float::sin", native: b"?float_sin" },
    { name: b"Float::cos", native: b"?float_cos" },
    { name: b"Float::tan", native: b"?float_tan" },
    { name: b"Float::asin", native: b"?float_asin" },
    { name: b"Float::acos", native: b"?float_acos" },
    { name: b"Float::atan", native: b"?float_atan" },
    { name: b"Float::pow", native: b"?float_pow" },
    { name: b"Float::atan2", native: b"?float_atan2" },
    { name: b"Float::hypot", native: b"?float_hypot" },
  ].map(|f: { name: Bytes, native: Bytes }|
    {
      name: f.name,
      native: f.native,
      operands: match native_named(f.native) { Some(n) -> n.params.len(), None -> 0 },
    })

pub fn float_function(name: Bytes) -> Option<FloatFunction> =
  float_functions().find(|f: FloatFunction| f.name == name)

pub fn float_exact(name: Bytes) -> Option<Bytes> =
  if name == b"Float::floor" { Some(b"floor") }
  else if name == b"Float::ceil" { Some(b"ceil") }
  else if name == b"Float::sqrt" { Some(b"sqrt") }
  else { None }

pub fn elaboration_natives() -> List<CompilerNative> =
  [
    { name: b"?numeric_binary", words: 4, results: true, raises: false },
    { name: b"?numeric_unary", words: 3, results: true, raises: false },
    { name: b"?scope_take", words: 1, results: true, raises: false },
    { name: b"?hold_bracket", words: 3, results: true, raises: false },
    { name: b"?scope_new", words: 1, results: true, raises: false },
    { name: b"?handler_init", words: 2, results: true, raises: false },
    { name: b"?handler_var", words: 1, results: true, raises: false },
    { name: b"?handler_set", words: 2, results: true, raises: false },
  ]

fn emitter_natives() -> List<CompilerNative> =
  [{ name: b"?encoded", words: 1, results: true, raises: false }]

fn has_try(m: Module) -> Bool =
  any_expression(m, |expression: Expression|
    match expression { PropagateExpression(_) -> true, _ -> false })

pub fn expand(
  module: Module,
  diagnostics: List<ParseDiagnostic>,
) -> { module: Module, diagnostics: List<ParseDiagnostic> } / {abort.raise} = {
  let tried = if has_try(module) { expand_try(module, diagnostics) }
  else { { module: module, diagnostics: diagnostics } };
  let function_item = with_schema_functions(wrap_spawned_values(tried.module));
  {
    module: function_item,
    diagnostics: report_rebound_constructors(function_item, tried.diagnostics),
  }
}

fn spawns_value(
  p: { span: Span, effect_name: QName, operation: Identifier, resource: Option<Identifier>, args: List<Expression> },
) -> Bool =
  p.effect_name.module == None && p.effect_name.name.name == b"task" && p.operation.name == b"spawn"
    && (match p.args { [LambdaExpression(_)] -> false, [_] -> true, _ -> false })

fn wrap_spawned_value(expression: Expression) -> Expression =
  match expression {
    PerformExpression(p) -> if !spawns_value(p) { expression } else {
      let at = |role: Int| synthetic_span(p.span, role);
      match p.args {
        [value] ->
          BlockExpression({
            span: p.span,
            statements: [
              LetStatement({
                span: at(role_spawn_let()),
                pattern: binder_at(b"?spawned", at(role_spawn_binder())),
                ty: None,
                value: value,
              }),
            ],
            tail: Some(
              PerformExpression({
                ..p,
                span: at(role_spawn_perform()),
                args: [
                  LambdaExpression({
                    span: at(role_spawn_lambda()),
                    params: [],
                    return_clause: None,
                    body: CallExpression({
                      span: at(role_spawn_call()),
                      function: local(b"?spawned", at(role_spawn_read())),
                      named: [],
                      args: [],
                      labels: [],
                    }),
                  }),
                ],
              }),
            ),
          }),
        _ -> expression,
      }
    },
    _ -> expression,
  }

fn wrap_spawned_values(module: Module) -> Module =
  if !any_expression(module, |e: Expression|
      match e { PerformExpression(p) -> spawns_value(p), _ -> false }) { module }
  else { { ..module, items: module.items.map(|item: Item| map_item(item, wrap_spawned_value)) } }

fn schema_functions(d: SchemaDefinition) -> List<Item> = {
  let at = { ..d.name.span, site: 0 };
  let identifier = |t: Bytes| { name: t, span: at };
  let params = d.params.concat(d.binders).map(|b: Binder|
    {
      name: b.name,
      keep: match b.ty { FunctionTypeExpression(_) -> true, _ -> false },
      ty: Some(b.ty),
      cost: None,
      space: None,
      default: None,
      span: b.span,
    });
  let row = {
    listed: [
      {
        effect_name: bare(identifier(b"abort")),
        mode: WriteMode,
        operation: Some(identifier(b"raise")),
        resource: None,
        resource_wildcard: false,
        bounded: false,
        span: at,
      },
    ],
    aliases: [bare(identifier(b"diverges"))],
    variable: d.generics.effects.at(0),
    variable_bounded: false,
    span: at,
  };
  let function_item = |name: Identifier, body: Expression|
    FunctionItem({
      visibility: d.visibility,
      name: name,
      generics: d.generics,
      params: params,
      return_type: Some(nullary(bare(identifier(bool_name())))),
      effects: Some(row),
      constraints: [],
      spec: [],
      returns: None,
      reuse: None,
      transparent: Some(at),
      constant: None,
      decreases: None,
      body: body,
      doc: d.doc,
      span: d.span,
    });
  match d.guard {
    None -> [function_item(d.name, d.body)],
    Some(g) ->
      [function_item(identifier(schema_guard_name(d.name.name)), g), function_item(d.name, d.body)],
  }
}

fn with_schema_functions(module: Module) -> Module =
  if !module.items.fold(false, |found: Bool, item: Item|
      found || (match item { SchemaItem(_) -> true, _ -> false })) { module } else {
    {
      ..module,
      items: module.items.fold([], |accumulator: List<Item>, item: Item|
        match item {
          SchemaItem(d) -> accumulator.push(item).concat(schema_functions(d)),
          _ -> accumulator.push(item),
        }),
    }
  }

pub fn dump_expanded(source: Bytes) -> String / {abort.raise} = {
  let r = parse(source);
  let x = expand(r.node, r.parser.diagnostics);
  String::of_bytes(dump_module(x.module).concat(dump_diagnostics(x.diagnostics)))
}

fn expanded_function(source: Bytes) -> { body: Expression, codes: List<Bytes> } / {abort.raise} = {
  let r = parse(source);
  let x = expand(r.node, r.parser.diagnostics);
  match x.module.items.at(0) {
    Some(FunctionItem(d)) ->
      { body: d.body, codes: x.diagnostics.map(|d: ParseDiagnostic| d.code) },
    _ -> panic("the source's first item is a function"),
  }
}

fn arms_of(e: Expression) -> List<{ constructor: Bytes, binds: List<Bytes>, body: Expression }> =
  match e {
    MatchExpression(m) ->
      m.arms.map(|a: MatchArm|
        match a.pattern {
          PatternConstructor(c) ->
            {
              constructor: c.name.name.name,
              binds: c.args.fold([], |accumulator: List<Bytes>, p: Pattern|
                match p { PatternVariable(v) -> accumulator.push(v.name.name), _ -> accumulator }),
              body: a.body,
            },
          _ -> { constructor: b"", binds: [], body: a.body },
        }),
    _ -> [],
  }

fn called(e: Expression) -> Bytes =
  match e {
    CallExpression(a) -> match a.function { NameExpression(v) -> v.name.name.name, _ -> b"" },
    _ -> b"",
  }

test "a `?` on a `let` splits the block at that statement into a `match` with the `Err` arm before the `Ok` arm" {
  let x = expanded_function(b"fn f(n: Int) -> Result<Int, Bytes> = { let x = g(n)?; Ok(x + 1) }");
  assert_eq(x.codes, []);
  let tested = match x.body {
    BlockExpression(b) -> if b.statements.len() == 0 { b.tail } else { None },
    _ -> None,
  };
  match tested {
    Some(m) -> {
      assert_eq(match m { MatchExpression(n) -> called(n.scrutinee), _ -> b"" }, b"g");
      let arms = arms_of(m);
      assert_eq(
        arms.map(|a: { constructor: Bytes, binds: List<Bytes>, body: Expression }| a.constructor),
        [b"Err", b"Ok"],
      );
      assert_eq(called(arms.get(0).body), b"Err");
      assert_eq(arms.get(1).binds, [b"x"]);
      let rest = match arms.get(1).body {
        BlockExpression(b) -> match b.tail { Some(t) -> t, None -> arms.get(1).body },
        other -> other,
      };
      assert_eq(called(rest), b"Ok")
    },
    None -> assert(false, Some("the block is the match alone")),
  }
}

test "a `?` inside a return-position expression moves out to a `match` around the whole expression, and in an `Option` function the failure arm is `None`" {
  let x = expanded_function(b"fn f(n: Int) -> Option<Int> = Some(g(n)? + 1)");
  assert_eq(x.codes, []);
  let arms = arms_of(x.body);
  assert_eq(
    arms.map(|a: { constructor: Bytes, binds: List<Bytes>, body: Expression }| a.constructor),
    [b"None", b"Some"],
  );
  assert_eq(match arms.get(0).body { NameExpression(v) -> v.name.name.name, _ -> b"" }, b"None");
  assert_eq(called(arms.get(1).body), b"Some")
}

test "a `?` in a function with no declared return type is an error, and the expanded body is just the call that `?` was applied to" {
  let x = expanded_function(b"fn f(n: Int) = g(n)?");
  assert_eq(x.codes, [b"E0118"]);
  assert_eq(called(x.body), b"g")
}

fn exit_value(e: Expression) -> Option<Expression> =
  match e {
    PerformExpression(p) -> if is_exit_effect(p.effect_name.name.name)
        && p.operation.name == exit_operation_name() { p.args.at(0) }
    else { None },
    _ -> None,
  }

test "a `?` inside a `handle` returns early from the function, and a `handle` added around the function body turns that early return into `Err`" {
  let x = expanded_function(
    b"fn f(n: Int) -> Result<Int, Bytes> = { let r = handle { g(n)? } with { a.b() -> 1 }; Ok(r) }",
  );
  assert_eq(x.codes, []);
  let lifted = match x.body { BlockExpression(b) -> b.tail, _ -> None };
  let around = match lifted { Some(MatchExpression(m)) -> Some(m.scrutinee), _ -> None };
  match around {
    Some(HandleExpression(w)) -> {
      assert_eq(w.clauses.map(|c: HandleClause| is_exit_effect(c.effect_name.name.name)), [true]);
      assert_eq(called(w.clauses.get(0).body), b"Err");
      assert_eq(called(w.body), b"Ok");
      let inner = match w.body {
        CallExpression(a) -> match a.args.at(0) {
          Some(HandleExpression(h)) -> match h.body {
            BlockExpression(b) -> b.tail,
            other -> Some(other),
          },
          _ -> None,
        },
        _ -> None,
      };
      match inner {
        Some(m) -> {
          let arms = arms_of(m);
          assert_eq(
            arms.map(|a: { constructor: Bytes, binds: List<Bytes>, body: Expression }|
              a.constructor),
            [b"Err", b"Ok"],
          );
          assert(exit_value(arms.get(0).body) != None, None)
        },
        None -> assert(false, Some("the written `handle` stands inside the `Ok`")),
      }
    },
    _ -> assert(false, Some("the block ends in the `match` of the written `handle`")),
  }
}

test "a `?` inside a `try`, a handler clause, a `return` clause or a nested `handle` uses the function's single early-return effect" {
  let exits = |source: Bytes| {
    let out = dump_expanded(source);
    assert(
      !out.contains("!E0118") && !out.contains("!E0119") && out.contains("@657869743f"),
      Some(out),
    )
  };
  exits(b"fn f(n: Int) -> Result<Int, Bytes> = { let r = try { g(n)? }; Ok(1) }");
  exits(b"fn f(n: Int) -> Option<Int> = handle { a.b() } with { a.b() -> g(n)? }");
  exits(b"fn f(n: Int) -> Result<Int, Bytes> = handle { a.b() } with { return v -> g(v)? }");
  exits(
    b"fn f(n: Int) -> Result<Int, Bytes> = handle { Ok(handle { g(n)? } with { c.d() -> 1 }) } with { a.b() -> 1 }",
  );
  let named = dump_expanded(
    b"fn f(n: Int) -> Result<Int, Bytes> = { let k = |m: Int| -> Option<Int> { handle { Some(h(m)?) } with { a.b() -> 1 } }; handle { g(n)? } with { a.b() -> 1 } }",
  );
  assert(
    !named.contains("!E0118") && !named.contains("!E0119") && named.contains("@657869743f303f30;")
      && named.contains("@657869743f303f31;"),
    Some(named),
  )
}

test "a `?` inside a lambda or a `simulate` block is an error, though a `handle` that contains a `?` may itself appear where a `?` is allowed" {
  let expand_source = |source: Bytes| dump_expanded(source);
  assert(
    expand_source(
      b"fn f(n: Int) -> Result<Int, Bytes> = handle { let k = || g(n)?; Ok(1) } with { a.b() -> 1 }",
    ).contains(
      "!E0118",
    ),
  );
  assert(
    expand_source(
      b"fn f(n: Int) -> Result<Int, Bytes> = handle { simulate { g(n)? } } with { a.b() -> 1 }",
    ).contains(
      "!E0118",
    ),
  );
  assert(
    expand_source(
      b"fn f(n: Int) -> Option<Int> = with_scope[r](1, free) { h -> Some(positive(n)? + h.get()) }",
    ).contains(
      "!E0118",
    ),
  );
  let placed = expand_source(
    b"fn f(n: Int) -> Result<Int, Bytes> = { let r = if n > 0 { handle { g(n)? } with { a.b() -> 1 } } else { 0 }; Ok(r) }",
  );
  assert(placed.contains("!E0119") && !placed.contains("!E0118"))
}

test "a `try` and a tagged literal are errors when the module defines or imports a name that their expansion uses" {
  let rejected = |source: Bytes| dump_expanded(source).contains("!E0118");
  let tried = b"fn f(b: Int) -> Int = match try { digit(b) } { _ -> 1 }";
  let tagged = b"fn f() -> Int = hex\"00\"";
  assert(!rejected(tried));
  assert(!rejected(tagged));
  assert(rejected(b"type Mine = | Err(Int) | Fine\n".concat(tried)));
  assert(rejected(b"import m (Ok)\n".concat(tried)));
  assert(rejected(b"type Mine = | Ok(Int) | Fine\n".concat(tagged)));
  assert(rejected(b"import m (Ok)\n".concat(tagged)));
  assert(rejected(b"fn Ok(n: Int) -> Int = n\n".concat(tagged)));
  assert(!rejected(b"type Mine = | Err(Int) | Fine\n".concat(tagged)));
  assert(!rejected(b"import m (Mine)\n".concat(tried)))
}

test "a tagged literal and a `try` in a test's label or table are handled the same way as those in the test's body" {
  let over = parse(
    b"test \"t {hex\"01\"}\" for n: Int in [hex\"02\"] { assert(n > hex\"03\") }",
  ).node;
  assert(tagged_in(over).len() > 0);
  assert_eq(tagged_in(over).map(|t: TaggedLiteral| t.text), [b"01", b"02", b"03"]);
  let rejected = |source: Bytes| dump_expanded(source).contains("!E0118");
  let labelled = b"test \"t {hex\"01\"}\" for n: Int in [1] { () }";
  let tabled = b"test \"t {n}\" for n: Int in [try { g(1) }] { () }";
  assert(!rejected(labelled) && !rejected(tabled));
  assert(rejected(b"type Mine = | Ok(Int) | Fine\n".concat(labelled)));
  assert(rejected(b"type Mine = | Err(Int) | Fine\n".concat(tabled)))
}

test "expressions interpolated in a tagged literal are expanded like call arguments, and the literal becomes a call to its tag's `fill`" {
  let interpolated_source = b"fn f(n: Int) -> Result<Int, Bytes> = Ok(List::len(sh\"a {g(n)?} {sh\"b\"} {try { sh\"c {n}\" }}\"))";
  assert_eq(tagged_in(parse(interpolated_source).node).map(|t: TaggedLiteral| t.text), [
    b"a ",
    b"b",
    b"c ",
  ]);
  let out = dump_expanded(interpolated_source);
  assert(!out.contains(":etry;") && out.contains(":emat;"));
  assert(!out.contains("!E0118") && !out.contains("!E0119"));
  let nested = b"type Mine = | Ok(Int) | Fine\nfn f(n: Int) -> Int = sh\"a {sh\"b {n}\"}\"";
  assert_eq(dump_expanded(nested).split("!E0118").len(), 3)
}

test "spawning a value that is not a lambda spawns a new lambda that calls the value, and the value is bound to a name before the spawn" {
  let x = expanded_function(
    b"fn f(work: () -> Int) -> Task<Int> / {task.write} = task.spawn(work)",
  );
  assert_eq(x.codes, []);
  match x.body {
    BlockExpression(b) -> {
      assert_eq(b.statements.len(), 1);
      match b.tail {
        Some(PerformExpression(p)) -> match p.args {
          [LambdaExpression(l)] -> {
            assert_eq(l.params.len(), 0);
            assert_eq(called(l.body), b"?spawned")
          },
          _ -> assert(false, Some("the spawn is handed one lambda")),
        },
        _ -> assert(false, Some("the block ends in the spawn")),
      }
    },
    _ -> assert(false, Some("the spawn is written out as a block")),
  };
  match expanded_function(b"fn g() -> Task<Int> / {task.write} = task.spawn(|| 1)").body {
    PerformExpression(p) -> assert_eq(p.args.len(), 1),
    _ -> assert(false, Some("a lambda's spawn is left")),
  }
}

test "a `?` on a `let` with a written type annotation keeps that annotation on the rewritten binding" {
  let out = dump_expanded(
    b"fn f(n: Int) -> Result<Int, Bytes> = { let x: Int = g(n)?; Ok(x + 1) }",
  );
  assert(!out.contains("!E0119"));
  assert(out.contains("@3f30"))
}

test "a `law schema` expands to the functions that its laws call, and each function is marked `transparent` and copies the schema's doc comment" {
  let x = expand(
    parse(
      b"/// Held.\npub law schema s(f: (Int) -> Int) forall (x: Int) where x > 0 { f(x) == x }\n",
    ).node,
    [],
  );
  let function_item = x.module.items.fold(
    [],
    |accumulator: List<{ name: Bytes, params: Int, read: Bool, doc: Bool }>, item: Item|
      match item {
        FunctionItem(d) ->
          accumulator.push({
            name: d.name.name,
            params: d.params.len(),
            read: d.transparent != None,
            doc: d.doc != None,
          }),
        _ -> accumulator,
      },
  );
  assert_eq(function_item, [
    { name: b"s_where", params: 2, read: true, doc: true },
    { name: b"s", params: 2, read: true, doc: true },
  ])
}

test "a tagged literal or `try` in a `law schema`, or in the arguments a `law` passes to the schema, is expanded exactly once" {
  let schema = b"law schema s(f: (Int) -> Int) forall (x: Int) where x > hex\"01\" { f(x) == hex\"02\" }\n";
  let function_item = b"law \"l\" = s(|n: Int| n + hex\"03\")\n";
  let over = expand(parse(schema.concat(function_item)).node, []).module;
  assert_eq(tagged_in(over).map(|t: TaggedLiteral| t.text), [b"01", b"02", b"03"]);
  let resolved = over.items.map(|item: Item|
    match item { LawItem(d) -> LawItem({ ..d, guard: Some(d.body) }), _ -> item });
  assert_eq(tagged_in({ ..over, items: resolved }).map(|t: TaggedLiteral| t.text), [
    b"01",
    b"02",
    b"03",
  ]);
  let rejected = |source: Bytes| dump_expanded(source).contains("!E0118");
  assert(!rejected(schema) && !rejected(schema.concat(function_item)));
  assert(rejected(b"type Mine = | Ok(Int) | Fine\n".concat(schema)));
  assert(
    rejected(
      b"type Mine = | Ok(Int) | Fine\nlaw schema s(f: (Int) -> Int) forall (x: Int) { f(x) == x }\n".concat(
        function_item,
      ),
    ),
  );
  assert(
    rejected(
      b"type Mine = | Ok(Int) | Err(Int)\nlaw schema s(f: (Int) -> Int) forall (x: Int) { try { f(x) } == Mine::Ok(x) }\n",
    ),
  )
}

test "the emitter's native functions are separate from the elaboration's native functions, and no native function name appears twice" {
  let declared = elaboration_natives().map(|n: CompilerNative| n.name);
  let all = compiler_natives().map(|n: CompilerNative| n.name);
  assert_eq(emitter_natives().filter(|n: CompilerNative| declared.contains(n.name)), []);
  assert_eq(
    all.fold([], |seen: List<Bytes>, n: Bytes| if seen.contains(n) { seen } else { seen.push(n) }),
    all,
  )
}
