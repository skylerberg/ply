//! The rewrites over a parsed module the check reads: the try operator, run with the grammar, a
//! spawn of a value, and a law schema's definitions; and what the lowering writes calls of.

import std.bin
import std.list
import compiler.syntax.parsing (Span, Ident, QName, ParseDiag, span_to, bare, dump_diags,
                                starts_upper, synthetic_span, synthetic_span_at,
                                role_member_receiver, role_member_field, role_member_callee,
                                role_spawn_let, role_spawn_binder, role_spawn_perform,
                                role_spawn_lambda, role_spawn_call, role_spawn_read)
import compiler.syntax.type_syntax (FunctionTypeExpression, WriteMode, nullary)
import compiler.syntax.items (Module, Item, FunctionItem, LawItem, SchemaItem, FnDef, Binder,
                              SchemaDef, schema_guard_name, parse, dump_module)
import compiler.syntax.calls (slotted, ordered_arguments)
import compiler.syntax.exprs (Expr, NameExpression, CallExpression, BlockExpression,
                              MatchExpression, MatchArm, LambdaExpression, PropagateExpression,
                              FieldExpression, PerformExpression, HandleExpression, LetStatement,
                              NamedArg, TaggedLiteral, HandleClause, is_exit_effect, exit_op)
import compiler.syntax.patterns (Pattern, PatternConstructor, PatternVariable)
import compiler.emit.abi
import compiler.emit.abi (Native, native_named)
import compiler.check.known (int_name, bool_name, float_name, decimal_name, fixed_widths)
import compiler.expand.rewrite.shared (map_item, tagged_in, report_rebound_constructors, any_expr,
                                       variable_at, binder_at)
import compiler.expand.rewrite.try_operator (expand_try)

// --- Calls on values --------------------------------------------------------------------------

// `e.name(args)` that the checker resolved to a function of the type of `e` runs as the call of
// that function with `e` first, which is all hashing and lowering see of it.

/// The function a call on a value calls: `qualifier::name`, or the bare `name` where `qualifier`
/// is empty; its parameters' `names`, and the `defaults` a call that leaves one out copies.
pub type Written = {
  qualifier: Bytes,
  name: Bytes,
  names: List<Bytes>,
  defaults: List<Option<Expr>>,
}

pub type MemberCallee = | WrittenOut(Written) | InField

/// The arguments the call at `at` of `m` on `on` passes, `args` and then `named` put where its
/// parameters are; as written where the checker refused the call.
fn member_arguments(
  m: Written,
  at: Span,
  on: Expr,
  args: List<Expr>,
  named: List<NamedArg>,
) -> List<Expr> = {
  let written = [on].concat(args);
  if written.len() > m.names.len() { written } else {
    let s = slotted(m.names, m.defaults, written, named, at);
    if s.missing.len() > 0 { written } else { ordered_arguments(s.slots, written, named) }
  }
}

/// The callee `m` written at `at`, a node whose names, identifiers, have no site.
fn member_var(m: Written, at: Span) -> Expr = {
  let named = { ..at, site: 0 };
  NameExpression({
    span: at,
    name: {
      module: if m.qualifier.len() == 0 { None } else { Some({ name: m.qualifier, span: named }) },
      name: { name: m.name, span: named },
      span: named,
    },
  })
}

fn expand_member_call(sites: Map<Int, MemberCallee>, expr: Expr) -> Expr =
  match expr {
    // A name written through its type. One the parser made (`?show::display` over a hole) can
    // stand at the span of the call it wraps.
    NameExpression(v) -> match v.name.module {
      None -> expr,
      Some(of) -> if !starts_upper(of.name) { expr } else {
        match sites.get(v.span.site) { Some(WrittenOut(m)) -> member_var(m, v.span), _ -> expr }
      },
    },
    CallExpression(a) -> match a.func {
      FieldExpression(f) -> match sites.get(a.span.site) {
        Some(WrittenOut(m)) ->
          CallExpression({
            span: a.span,
            func: member_var(m, f.span),
            named: [],
            args: member_arguments(m, a.span, f.base, a.args, a.named),
            labels: a.labels,
          }),
        _ -> expr,
      },
      _ -> expr,
    },
    PerformExpression(p) -> {
      let on = NameExpression({
        span: synthetic_span_at(p.effect_name.span, p.span, role_member_receiver()),
        name: p.effect_name,
      });
      let labels = match p.resource { Some(r) -> [r], None -> [] };
      match sites.get(p.span.site) {
        Some(InField) ->
          CallExpression({
            span: p.span,
            func: FieldExpression({
              span: synthetic_span_at(
                span_to(p.effect_name.span, p.op.span),
                p.span,
                role_member_field(),
              ),
              base: on,
              field: p.op,
            }),
            named: [],
            args: p.args,
            labels: labels,
          }),
        Some(WrittenOut(m)) ->
          CallExpression({
            span: p.span,
            func: member_var(m, synthetic_span_at(p.op.span, p.span, role_member_callee())),
            named: [],
            args: member_arguments(m, p.span, on, p.args, []),
            labels: labels,
          }),
        None -> expr,
      }
    },
    _ -> expr,
  }

/// `def` with each call on a value in `sites`, by site, written as the call it is.
pub fn expand_function_member_calls(def: FnDef, sites: Map<Int, MemberCallee>) -> FnDef =
  if sites.len() == 0 { def } else {
    match map_item(FunctionItem(def), |expr: Expr| expand_member_call(sites, expr)) {
      FunctionItem(d) -> d,
      _ -> def,
    }
  }

// --- Witnesses -----------------------------------------------------------------------------

// A definition with `numeric(a)` or `integer(a)` takes, ahead of its written parameters, an `Int`
// per such parameter naming the type a call instantiates it at. Its operators over the parameter
// read that witness, and every call of it passes one: a type's number, or the caller's own.

/// The runtime's numbering: its widths in order, then `Int`, `Float` and `Decimal`. Any other name
/// is numbered as `Int`.
pub fn witness_code(name: Bytes) -> Int = {
  let widths = fixed_widths().map(|w: { name: Bytes, bits: Int, signed: Bool }| w.name);
  match widths.concat([int_name(), float_name(), decimal_name()]).index_of(name) {
    Some(i) -> i,
    None -> widths.len(),
  }
}

/// What the elaboration calls for the witness of a type that states its own arithmetic; the
/// emitter writes it, and no runtime holds it.
pub fn declared_witness_name() -> Bytes = b"?stated_witness"

/// The binary operators a witnessed parameter takes, in the elaboration's numbering of them.
pub fn numeric_operators() -> List<Bytes> =
  [
    b"add",
    b"sub",
    b"mul",
    b"div",
    b"rem",
    b"lt",
    b"le",
    b"gt",
    b"ge",
    b"bitand",
    b"bitor",
    b"bitxor",
    b"shl",
    b"shr",
    b"ushr",
  ]

/// The runtime's numbering of the operators a witnessed parameter takes; `-` and `~` are 0 and 1.
pub fn numeric_operator_code(op: Bytes) -> Int = {
  let ops = numeric_operators();
  range(0, ops.len()).fold(0 - 1, |acc: Int, i: Int|
    if acc >= 0 { acc } else if ops.at(i) == Some(op) { i } else { acc })
}

/// A native the compiler writes calls of where no source can: the words each call passes, whether
/// it answers one, and whether a failure of it raises rather than ending the run.
pub type CompilerNative = { name: Bytes, words: Int, results: Bool, raises: Bool }

/// Every native the compiler writes calls of: the elaboration's, then the emitter's, then those
/// the emitted C calls directly over machine words.
pub fn compiler_natives() -> List<CompilerNative> =
  elaboration_natives().concat(emitter_natives()).concat(
    abi::natives().map(|n: Native|
      { name: n.name, words: n.params.len(), results: n.result != None, raises: n.raises }),
  )

/// A `Float` function the runtime answers, correctly rounded: its builtin's name, the native it is
/// called through, and how many operands it takes.
pub type FloatFunction = { name: Bytes, native: Bytes, operands: Int }

/// Every `Float` function the runtime answers, each taking the operands its native does.
pub fn float_functions() -> List<FloatFunction> =
  [
    { name: b"Float::exp", native: b"?float_exp" },
    { name: b"Float::ln", native: b"?float_ln" },
    { name: b"Float::log2", native: b"?float_log2" },
    { name: b"Float::log10", native: b"?float_log10" },
    { name: b"Float::sin", native: b"?float_sin" },
    { name: b"Float::cos", native: b"?float_cos" },
    { name: b"Float::tan", native: b"?float_tan" },
    { name: b"Float::asin", native: b"?float_asin" },
    { name: b"Float::acos", native: b"?float_acos" },
    { name: b"Float::atan", native: b"?float_atan" },
    { name: b"Float::pow", native: b"?float_pow" },
    { name: b"Float::atan2", native: b"?float_atan2" },
    { name: b"Float::hypot", native: b"?float_hypot" },
  ].map(|f: { name: Bytes, native: Bytes }|
    {
      name: f.name,
      native: f.native,
      operands: match native_named(f.native) { Some(n) -> n.params.len(), None -> 0 },
    })

/// The `Float` function builtin `name` is; `None` for any other.
pub fn float_function(name: Bytes) -> Option<FloatFunction> =
  float_functions().find(|f: FloatFunction| f.name == name)

/// The operator compiled code computes `Float` function builtin `name` with, in place: one whose
/// every answer IEEE 754 fixes, so the C library's agrees on every machine. `None` for any other.
pub fn float_exact(name: Bytes) -> Option<Bytes> =
  if name == b"Float::floor" { Some(b"floor") }
  else if name == b"Float::ceil" { Some(b"ceil") }
  else if name == b"Float::sqrt" { Some(b"sqrt") }
  else { None }

/// The natives the elaboration writes calls of.
pub fn elaboration_natives() -> List<CompilerNative> =
  [
    { name: b"?numeric_binary", words: 4, results: true, raises: false },
    { name: b"?numeric_unary", words: 3, results: true, raises: false },
    { name: b"?hold_take", words: 1, results: true, raises: false },
    { name: b"?hold_bracket", words: 3, results: true, raises: false },
    { name: b"?hold_new", words: 1, results: true, raises: false },
    { name: b"?handler_init", words: 2, results: true, raises: false },
    { name: b"?handler_var", words: 1, results: true, raises: false },
    { name: b"?handler_set", words: 2, results: true, raises: false },
  ]

/// The natives the emitter writes calls of over a value's encoding: the runtime's encoding of a
/// value.
fn emitter_natives() -> List<CompilerNative> =
  [{ name: b"?encoded", words: 1, results: true, raises: false }]

// --- Running the rewrites --------------------------------------------------------------------

fn has_try(m: Module) -> Bool =
  any_expr(m, |expr: Expr| match expr { PropagateExpression(_) -> true, _ -> false })

/// Only when the grammar met a `?` or a law schema.
pub fn expand(
  module: Module,
  diags: List<ParseDiag>,
) -> { module: Module, diags: List<ParseDiag> } / {abort.raise} = {
  let tried = if has_try(module) { expand_try(module, diags) }
  else { { module: module, diags: diags } };
  let function_item = with_schema_fns(wrap_spawned_values(tried.module));
  { module: function_item, diags: report_rebound_constructors(function_item, tried.diags) }
}

// --- Spawned values ----------------------------------------------------------------------------

/// Whether `p` spawns a value other than a lambda written there.
fn spawns_value(
  p: { span: Span, effect_name: QName, op: Ident, resource: Option<Ident>, args: List<Expr> },
) -> Bool =
  p.effect_name.module == None && p.effect_name.name.name == b"task" && p.op.name == b"spawn"
    && (match p.args { [LambdaExpression(_)] -> false, [_] -> true, _ -> false })

/// `task.spawn(f)` of a value other than a lambda, as the spawn of a lambda holding it,
/// `{ let ?spawned = f; task.spawn(|| ?spawned()) }`: so what a task runs is a lambda written at
/// its spawn, which holds the words its row takes there.
fn wrap_spawned_value(expr: Expr) -> Expr =
  match expr {
    PerformExpression(p) -> if !spawns_value(p) { expr } else {
      let at = |role: Int| synthetic_span(p.span, role);
      match p.args {
        [value] ->
          BlockExpression({
            span: p.span,
            stmts: [
              LetStatement({
                span: at(role_spawn_let()),
                pat: binder_at(b"?spawned", at(role_spawn_binder())),
                ty: None,
                value: value,
              }),
            ],
            tail: Some(
              PerformExpression({
                ..p,
                span: at(role_spawn_perform()),
                args: [
                  LambdaExpression({
                    span: at(role_spawn_lambda()),
                    params: [],
                    ret: None,
                    body: CallExpression({
                      span: at(role_spawn_call()),
                      func: variable_at(b"?spawned", at(role_spawn_read())),
                      named: [],
                      args: [],
                      labels: [],
                    }),
                  }),
                ],
              }),
            ),
          }),
        _ -> expr,
      }
    },
    _ -> expr,
  }

/// Every spawn of a value other than a lambda in `module` written as `wrap_spawned_value` says.
fn wrap_spawned_values(module: Module) -> Module =
  if !any_expr(module, |e: Expr| match e { PerformExpression(p) -> spawns_value(p), _ -> false }) {
    module
  } else { { ..module, items: module.items.map(|item: Item| map_item(item, wrap_spawned_value)) } }

// --- The law schema ----------------------------------------------------------------------------

/// A schema is also the definitions its instantiations call: its body over its parameters and then
/// its binders, and its guard the same as `<name>_where`. Each is `transparent`, so a claim in
/// another package reads the body it instantiates, and may raise or not return, as a law body may,
/// and perform its row parameter, which an instantiation fills. Both carry the schema's doc. A
/// function among its parameters is kept: the body states what holds of it, wherever it goes.
fn schema_fns(d: SchemaDef) -> List<Item> = {
  let at = { ..d.name.span, site: 0 };
  let ident = |t: Bytes| { name: t, span: at };
  let params = d.params.concat(d.binders).map(|b: Binder|
    {
      name: b.name,
      keep: match b.ty { FunctionTypeExpression(_) -> true, _ -> false },
      ty: Some(b.ty),
      cost: None,
      space: None,
      default: None,
      span: b.span,
    });
  let row = {
    atoms: [
      // As the grammar writes an operation's atom: the checker reads its mode off the declaration.
      {
        effect_name: bare(ident(b"abort")),
        mode: WriteMode,
        op: Some(ident(b"raise")),
        resource: None,
        every: false,
        bounded: false,
        span: at,
      },
    ],
    aliases: [bare(ident(b"diverges"))],
    tail: d.generics.effects.at(0),
    tail_bounded: false,
    span: at,
  };
  let function_item = |name: Ident, body: Expr|
    FunctionItem({
      visibility: d.visibility,
      name: name,
      generics: d.generics,
      params: params,
      ret: Some(nullary(bare(ident(bool_name())))),
      effects: Some(row),
      constraints: [],
      spec: [],
      returns: None,
      reuse: None,
      transparent: Some(at),
      constant: None,
      decreases: None,
      body: body,
      doc: d.doc,
      span: d.span,
    });
  match d.guard {
    None -> [function_item(d.name, d.body)],
    // In the order a schema writes them, which is the order its expressions are walked in.
    Some(g) ->
      [function_item(ident(schema_guard_name(d.name.name)), g), function_item(d.name, d.body)],
  }
}

fn with_schema_fns(module: Module) -> Module =
  if !module.items.fold(false, |found: Bool, item: Item|
      found || (match item { SchemaItem(_) -> true, _ -> false })) { module } else {
    {
      ..module,
      items: module.items.fold([], |acc: List<Item>, item: Item|
        match item { SchemaItem(d) -> acc.push(item).concat(schema_fns(d)), _ -> acc.push(item) }),
    }
  }

pub fn dump_expanded(src: Bytes) -> String / {abort.raise} = {
  let r = parse(src);
  let x = expand(r.node, r.parser.diags);
  String::of_bytes(dump_module(x.module).concat(dump_diags(x.diags)))
}

// --- Tests ------------------------------------------------------------------

/// The body of `src`'s first function once expanded, and the codes the expansion said.
fn expanded_fn(src: Bytes) -> { body: Expr, codes: List<Bytes> } / {abort.raise} = {
  let r = parse(src);
  let x = expand(r.node, r.parser.diags);
  match x.module.items.at(0) {
    Some(FunctionItem(d)) -> { body: d.body, codes: x.diags.map(|d: ParseDiag| d.code) },
    _ -> panic("the source's first item is a function"),
  }
}

/// What a `match` tests: the constructor of each arm in order, its pattern's bound names, and its
/// body; nothing for any other expression.
fn arms_of(e: Expr) -> List<{ ctor: Bytes, binds: List<Bytes>, body: Expr }> =
  match e {
    MatchExpression(m) ->
      m.arms.map(|a: MatchArm|
        match a.pat {
          PatternConstructor(c) ->
            {
              ctor: c.name.name.name,
              binds: c.args.fold([], |acc: List<Bytes>, p: Pattern|
                match p { PatternVariable(v) -> acc.push(v.name.name), _ -> acc }),
              body: a.body,
            },
          _ -> { ctor: b"", binds: [], body: a.body },
        }),
    _ -> [],
  }

/// The constructor or function an application calls, by its bare name.
fn called(e: Expr) -> Bytes =
  match e {
    CallExpression(a) -> match a.func { NameExpression(v) -> v.name.name.name, _ -> b"" },
    _ -> b"",
  }

test "a `?` on a `let` splits the block at that statement, failure arm first" {
  let x = expanded_fn(b"fn f(n: Int) -> Result<Int, Bytes> = { let x = g(n)?; Ok(x + 1) }");
  assert_eq(x.codes, []);
  // The `Ok` arm binds the `let`'s name and runs the statements after it.
  let tested = match x.body {
    BlockExpression(b) -> if b.stmts.len() == 0 { b.tail } else { None },
    _ -> None,
  };
  match tested {
    Some(m) -> {
      assert_eq(match m { MatchExpression(n) -> called(n.scrutinee), _ -> b"" }, b"g");
      let arms = arms_of(m);
      assert_eq(arms.map(|a: { ctor: Bytes, binds: List<Bytes>, body: Expr }| a.ctor), [
        b"Err",
        b"Ok",
      ]);
      assert_eq(called(arms.get(0).body), b"Err");
      assert_eq(arms.get(1).binds, [b"x"]);
      let rest = match arms.get(1).body {
        BlockExpression(b) -> match b.tail { Some(t) -> t, None -> arms.get(1).body },
        other -> other,
      };
      assert_eq(called(rest), b"Ok")
    },
    None -> assert(false, Some("the block is the match alone")),
  }
}

test "a `?` inside a return-position expression lifts to its head, and an `Option` names `None`" {
  let x = expanded_fn(b"fn f(n: Int) -> Option<Int> = Some(g(n)? + 1)");
  assert_eq(x.codes, []);
  let arms = arms_of(x.body);
  assert_eq(arms.map(|a: { ctor: Bytes, binds: List<Bytes>, body: Expr }| a.ctor), [
    b"None",
    b"Some",
  ]);
  assert_eq(match arms.get(0).body { NameExpression(v) -> v.name.name.name, _ -> b"" }, b"None");
  assert_eq(called(arms.get(1).body), b"Some")
}

test "a `?` in a function with no written return type is refused and unwrapped" {
  let x = expanded_fn(b"fn f(n: Int) = g(n)?");
  assert_eq(x.codes, [b"E0118"]);
  assert_eq(called(x.body), b"g")
}

/// What a raise of an exit effect carries, where `e` is one.
fn exit_value(e: Expr) -> Option<Expr> =
  match e {
    PerformExpression(p) -> if is_exit_effect(p.effect_name.name.name) && p.op.name == exit_op() {
      p.args.at(0)
    } else { None },
    _ -> None,
  }

test "a `?` inside a `handle` raises its function's exit, which a `handle` around it answers" {
  let x = expanded_fn(
    b"fn f(n: Int) -> Result<Int, Bytes> = { let r = handle { g(n)? } with { a.b() -> 1 }; Ok(r) }",
  );
  assert_eq(x.codes, []);
  // The `handle` stands where a `?` of its own would: the scrutinee of the block's `match`.
  let lifted = match x.body { BlockExpression(b) -> b.tail, _ -> None };
  let around = match lifted { Some(MatchExpression(m)) -> Some(m.scrutinee), _ -> None };
  match around {
    Some(HandleExpression(w)) -> {
      // Its one clause answers the exit with the failure it carried, and its body is the `Ok`.
      assert_eq(w.clauses.map(|c: HandleClause| is_exit_effect(c.effect_name.name.name)), [true]);
      assert_eq(called(w.clauses.get(0).body), b"Err");
      assert_eq(called(w.body), b"Ok");
      // Inside, the `?`'s failure arm raises the exit with what `Err` held.
      let inner = match w.body {
        CallExpression(a) -> match a.args.at(0) {
          Some(HandleExpression(h)) -> match h.body {
            BlockExpression(b) -> b.tail,
            other -> Some(other),
          },
          _ -> None,
        },
        _ -> None,
      };
      match inner {
        Some(m) -> {
          let arms = arms_of(m);
          assert_eq(arms.map(|a: { ctor: Bytes, binds: List<Bytes>, body: Expr }| a.ctor), [
            b"Err",
            b"Ok",
          ]);
          assert(exit_value(arms.get(0).body) != None, None)
        },
        None -> assert(false, Some("the written `handle` stands inside the `Ok`")),
      }
    },
    _ -> assert(false, Some("the block ends in the `match` of the written `handle`")),
  }
}

test "a `?` inside a `try`, a clause, a `return` or a nested `handle` leaves by one exit" {
  let exits = |src: Bytes| {
    let out = dump_expanded(src);
    assert(
      !out.contains("!E0118") && !out.contains("!E0119") && out.contains("@657869743f"),
      Some(out),
    )
  };
  exits(b"fn f(n: Int) -> Result<Int, Bytes> = { let r = try { g(n)? }; Ok(1) }");
  exits(b"fn f(n: Int) -> Option<Int> = handle { a.b() } with { a.b() -> g(n)? }");
  exits(b"fn f(n: Int) -> Result<Int, Bytes> = handle { a.b() } with { return v -> g(v)? }");
  exits(
    b"fn f(n: Int) -> Result<Int, Bytes> = handle { Ok(handle { g(n)? } with { c.d() -> 1 }) } with { a.b() -> 1 }",
  );
  // One exit for the function, and one of its own for a typed lambda, which its `?` exits.
  let named = dump_expanded(
    b"fn f(n: Int) -> Result<Int, Bytes> = { let k = |m: Int| -> Option<Int> { handle { Some(h(m)?) } with { a.b() -> 1 } }; handle { g(n)? } with { a.b() -> 1 } }",
  );
  // `exit?0?0` and `exit?0?1`: the item written at 0's first and second.
  assert(
    !named.contains("!E0118") && !named.contains("!E0119") && named.contains("@657869743f303f30;")
      && named.contains("@657869743f303f31;"),
    Some(named),
  )
}

test "a `?` inside a lambda or a region inside a `handle` exits nothing, and a `handle` holding one stands where a `?` could" {
  let said = |src: Bytes| dump_expanded(src);
  assert(
    said(
      b"fn f(n: Int) -> Result<Int, Bytes> = handle { let k = || g(n)?; Ok(1) } with { a.b() -> 1 }",
    ).contains(
      "!E0118",
    ),
  );
  assert(
    said(
      b"fn f(n: Int) -> Result<Int, Bytes> = handle { simulate { g(n)? } } with { a.b() -> 1 }",
    ).contains(
      "!E0118",
    ),
  );
  let placed = said(
    b"fn f(n: Int) -> Result<Int, Bytes> = { let r = if n > 0 { handle { g(n)? } with { a.b() -> 1 } } else { 0 }; Ok(r) }",
  );
  assert(placed.contains("!E0119") && !placed.contains("!E0118"))
}

test "a `try` and a tagged literal are refused where the module binds what they are written out with" {
  let refused = |src: Bytes| dump_expanded(src).contains("!E0118");
  let tried = b"fn f(b: Int) -> Int = match try { digit(b) } { _ -> 1 }";
  let tagged = b"fn f() -> Int = hex\"00\"";
  assert(!refused(tried));
  assert(!refused(tagged));
  assert(refused(b"type Mine = | Err(Int) | Fine\n".concat(tried)));
  assert(refused(b"import m (Ok)\n".concat(tried)));
  assert(refused(b"type Mine = | Ok(Int) | Fine\n".concat(tagged)));
  assert(refused(b"import m (Ok)\n".concat(tagged)));
  assert(refused(b"fn Ok(n: Int) -> Int = n\n".concat(tagged)));
  // A tagged literal is read through `Ok` alone.
  assert(!refused(b"type Mine = | Err(Int) | Fine\n".concat(tagged)));
  // A type imported by name brings no constructor with it.
  assert(!refused(b"import m (Mine)\n".concat(tried)))
}

test "a tagged literal and a `try` in a test's label or its table are read as those in its body are" {
  let over = parse(
    b"test \"t {hex\"01\"}\" for n: Int in [hex\"02\"] { assert(n > hex\"03\") }",
  ).node;
  assert(tagged_in(over).len() > 0);
  assert_eq(tagged_in(over).map(|t: TaggedLiteral| t.text), [b"01", b"02", b"03"]);
  let refused = |src: Bytes| dump_expanded(src).contains("!E0118");
  let labelled = b"test \"t {hex\"01\"}\" for n: Int in [1] { () }";
  let tabled = b"test \"t {n}\" for n: Int in [try { g(1) }] { () }";
  assert(!refused(labelled) && !refused(tabled));
  assert(refused(b"type Mine = | Ok(Int) | Fine\n".concat(labelled)));
  assert(refused(b"type Mine = | Err(Int) | Fine\n".concat(tabled)))
}

test "a tagged literal's holes are read as a call's arguments are, and it runs as its tag's `fill`" {
  let holding = b"fn f(n: Int) -> Result<Int, Bytes> = Ok(List::len(sh\"a {g(n)?} {sh\"b\"} {try { sh\"c {n}\" }}\"))";
  // One that holds another is read before it.
  assert_eq(tagged_in(parse(holding).node).map(|t: TaggedLiteral| t.text), [b"a ", b"b", b"c "]);
  // A `?` in a hole is lifted to the head of what holds the literal.
  let out = dump_expanded(holding);
  assert(!out.contains(":etry;") && out.contains(":emat;"));
  assert(!out.contains("!E0118") && !out.contains("!E0119"));
  // Each is read through `Ok`, one inside a hole included.
  let nested = b"type Mine = | Ok(Int) | Fine\nfn f(n: Int) -> Int = sh\"a {sh\"b {n}\"}\"";
  assert_eq(dump_expanded(nested).split("!E0118").len(), 3)
}

test "a spawn of a value other than a lambda spawns a lambda calling it, the value bound first" {
  let x = expanded_fn(b"fn f(work: () -> Int) -> Task<Int> / {task.write} = task.spawn(work)");
  assert_eq(x.codes, []);
  match x.body {
    BlockExpression(b) -> {
      // The value is bound before the spawn, so it is what it was where the spawn is written.
      assert_eq(b.stmts.len(), 1);
      match b.tail {
        Some(PerformExpression(p)) -> match p.args {
          [LambdaExpression(l)] -> {
            assert_eq(l.params.len(), 0);
            assert_eq(called(l.body), b"?spawned")
          },
          _ -> assert(false, Some("the spawn is handed one lambda")),
        },
        _ -> assert(false, Some("the block ends in the spawn")),
      }
    },
    _ -> assert(false, Some("the spawn is written out as a block")),
  };
  // A lambda is spawned as it is written.
  match expanded_fn(b"fn g() -> Task<Int> / {task.write} = task.spawn(|| 1)").body {
    PerformExpression(p) -> assert_eq(p.args.len(), 1),
    _ -> assert(false, Some("a lambda's spawn is left")),
  }
}

test "a `?` on a `let` with a written type keeps the annotation" {
  let out = dump_expanded(
    b"fn f(n: Int) -> Result<Int, Bytes> = { let x: Int = g(n)?; Ok(x + 1) }",
  );
  assert(!out.contains("!E0119"));
  assert(out.contains("@3f30"))
}

test "a schema is also the definitions its instantiations call, `transparent` and under its doc" {
  let x = expand(
    parse(
      b"/// Held.\npub law schema s(f: (Int) -> Int) forall (x: Int) where x > 0 { f(x) == x }\n",
    ).node,
    [],
  );
  let function_item = x.module.items.fold(
    [],
    |acc: List<{ name: Bytes, params: Int, read: Bool, doc: Bool }>, item: Item|
      match item {
        FunctionItem(d) ->
          acc.push({
            name: d.name.name,
            params: d.params.len(),
            read: d.transparent != None,
            doc: d.doc != None,
          }),
        _ -> acc,
      },
  );
  assert_eq(function_item, [
    { name: b"s_where", params: 2, read: true, doc: true },
    { name: b"s", params: 2, read: true, doc: true },
  ])
}

test "a tagged literal and a `try` in a schema or in what a law instantiates one with are read once" {
  let schema = b"law schema s(f: (Int) -> Int) forall (x: Int) where x > hex\"01\" { f(x) == hex\"02\" }\n";
  let function_item = b"law \"l\" = s(|n: Int| n + hex\"03\")\n";
  let over = expand(parse(schema.concat(function_item)).node, []).module;
  assert_eq(tagged_in(over).map(|t: TaggedLiteral| t.text), [b"01", b"02", b"03"]);
  // Once resolved, an instantiation's guard holds the arguments its body does.
  let resolved = over.items.map(|item: Item|
    match item { LawItem(d) -> LawItem({ ..d, guard: Some(d.body) }), _ -> item });
  assert_eq(tagged_in({ ..over, items: resolved }).map(|t: TaggedLiteral| t.text), [
    b"01",
    b"02",
    b"03",
  ]);
  let refused = |src: Bytes| dump_expanded(src).contains("!E0118");
  assert(!refused(schema) && !refused(schema.concat(function_item)));
  assert(refused(b"type Mine = | Ok(Int) | Fine\n".concat(schema)));
  assert(
    refused(
      b"type Mine = | Ok(Int) | Fine\nlaw schema s(f: (Int) -> Int) forall (x: Int) { f(x) == x }\n".concat(
        function_item,
      ),
    ),
  );
  assert(
    refused(
      b"type Mine = | Ok(Int) | Err(Int)\nlaw schema s(f: (Int) -> Int) forall (x: Int) { try { f(x) } == Mine::Ok(x) }\n",
    ),
  )
}

test "the emitter's natives are its own: none is one the lowering writes, and none is named twice" {
  let declared = elaboration_natives().map(|n: CompilerNative| n.name);
  let all = compiler_natives().map(|n: CompilerNative| n.name);
  assert_eq(emitter_natives().filter(|n: CompilerNative| declared.contains(n.name)), []);
  assert_eq(
    all.fold([], |seen: List<Bytes>, n: Bytes| if seen.contains(n) { seen } else { seen.push(n) }),
    all,
  )
}
