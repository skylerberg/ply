//! `derive d for T` becomes ordinary definitions: the module `d` binds is a library deriver, whose
//! `derive` the load runs over `T`'s declaration and whose answer, the source of the functions it
//! derives, the expansion is handed, parsed back and retargeted at the `derive` item.

import compiler.syntax.parsing (Span, Ident, QName, span_to, span_between)
import compiler.syntax.sites (numbered)
import compiler.syntax.type_syntax (TypeExpr, TVar, TCon, TFn, TRecord, TUnit, TBad, RowExpr,
                                    AtomExpr, ty_span)
import compiler.syntax.patterns (Pattern, PWild, PVar, PLit, PRange, PCtor, PRecord, PList, POr,
                                 PBad)
import compiler.syntax.exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock,
                              ERecord, ERecordUpdate, ETry, EField, EList, EPerform, EHandle,
                              EWithHold, ESimulate, EParallel, EBad, EHole, ETryBlock, Stmt, SLet,
                              SLetElse, SExpr, SAssign, HandlerVar, Param, NamedArg, MatchArm,
                              HandleClause, ReturnClause, RecField, hidden_binder, ETagged, Hole,
                              expr_span)
import compiler.syntax.items (Module, Item, IFn, IType, IDerive, FnDef, TypeDef, TDAlias, TDSum,
                              VariantDef, DeriveDef, ImportDecl, IModule, IAlias, INames, Derived,
                              Derivation, parse, TDNominal, TDExtern)
import compiler.expand.rewrite (expand)
import compiler.expand.rewrite.shared (find_type, picked_in)
import compiler.expand.declared (declaration_of)
import compiler.check.resolve.tables (Diag, error_at, error_at_and)
import std.list
import std.string
import std.bin
import std.derive
import std.value

// --- Every node of a generated definition stands at the `derive` item's place -------------------
// Its numbering tells them apart, as it does the nodes of any item.

fn ident_at(ident: Ident, span: Span) -> Ident = { name: ident.name, span: span }

fn qname_at(qname: QName, span: Span) -> QName =
  {
    module: match qname.module { Some(m) -> Some(ident_at(m, span)), None -> None },
    name: ident_at(qname.name, span),
    span: span,
  }

fn opt_ident_at(o: Option<Ident>, span: Span) -> Option<Ident> =
  match o { Some(i) -> Some(ident_at(i, span)), None -> None }

fn retarget_fn(def: FnDef, span: Span) -> FnDef =
  {
    vis: def.vis,
    name: { name: def.name.name, span: span },
    generics: {
      types: def.generics.types.map(|ident: Ident| ident_at(ident, span)),
      effects: def.generics.effects.map(|ident: Ident| ident_at(ident, span)),
      labels: def.generics.labels.map(|ident: Ident| ident_at(ident, span)),
      kept: def.generics.kept.map(|ident: Ident| ident_at(ident, span)),
      multi: def.generics.multi.map(|ident: Ident| ident_at(ident, span)),
    },
    params: def.params.map(|param: Param| retarget_param(param, span)),
    ret: match def.ret { Some(t) -> Some(retarget_ty(t, span)), None -> None },
    effects: match def.effects { Some(r) -> Some(retarget_row(r, span)), None -> None },
    constraints: def.constraints.map(|c: Constraint|
      { deriver: c.deriver, deriver_span: span, param: ident_at(c.param, span), span: span }),
    spec: def.spec.map(|c: SpecClause|
      { kind: c.kind, expr: retarget_expr(c.expr, span), span: span }),
    returns: def.returns,
    reuse: def.reuse,
    transparent: def.transparent,
    baked: def.baked,
    decreases: match def.decreases { Some(e) -> Some(retarget_expr(e, span)), None -> None },
    body: retarget_expr(def.body, span),
    doc: def.doc,
    span: span,
  }

/// A parameter's default is deliberately not retargeted.
fn retarget_param(param: Param, span: Span) -> Param =
  {
    name: ident_at(param.name, span),
    keep: param.keep,
    ty: match param.ty { Some(t) -> Some(retarget_ty(t, span)), None -> None },
    cost: param.cost,
    space: param.space,
    default: param.default,
    span: span,
  }

fn retarget_ty(t: TypeExpr, span: Span) -> TypeExpr =
  match t {
    TVar(i) -> TVar(ident_at(i, span)),
    TCon(c) ->
      TCon({
        span: span,
        name: qname_at(c.name, span),
        args: c.args.map(|a: TypeExpr| retarget_ty(a, span)),
        labels: c.labels.map(|l: Ident| ident_at(l, span)),
        rows: c.rows.map(|r: RowExpr| retarget_row(r, span)),
      }),
    TFn(f) ->
      TFn({
        ..f,
        span: span,
        params: f.params.map(|p: TypeExpr| retarget_ty(p, span)),
        ret: retarget_ty(f.ret, span),
        effects: match f.effects { Some(r) -> Some(retarget_row(r, span)), None -> None },
      }),
    TRecord(r) ->
      TRecord({
        span: span,
        fields: r.fields.map(|f: { name: Ident, ty: TypeExpr }|
          { name: ident_at(f.name, span), ty: retarget_ty(f.ty, span) }),
      }),
    TUnit(_) -> TUnit({ span: span }),
    TBad(_) -> TBad({ span: span }),
  }

fn retarget_row(row: RowExpr, span: Span) -> RowExpr =
  {
    atoms: row.atoms.map(|atom: AtomExpr|
      {
        eff: qname_at(atom.eff, span),
        mode: atom.mode,
        op: opt_ident_at(atom.op, span),
        resource: opt_ident_at(atom.resource, span),
        every: atom.every,
        bounded: atom.bounded,
        span: span,
      }),
    aliases: row.aliases.map(|qname: QName| qname_at(qname, span)),
    tail: opt_ident_at(row.tail, span),
    tail_bounded: row.tail_bounded,
    span: span,
  }

fn retarget_opt_expr(expr: Option<Expr>, span: Span) -> Option<Expr> =
  match expr { Some(e) -> Some(retarget_expr(e, span)), None -> None }

fn retarget_field(field: RecField, span: Span) -> RecField =
  { name: ident_at(field.name, span), value: retarget_expr(field.value, span) }

fn retarget_expr(e: Expr, span: Span) -> Expr =
  match e {
    ELit(l) -> ELit({ span: span, lit: l.lit }),
    EHole(h) -> EHole({ span: span, text: h.text }),
    EVar(v) -> EVar({ span: span, name: qname_at(v.name, span) }),
    EBinary(b) ->
      EBinary({
        span: span,
        op: b.op,
        lhs: retarget_expr(b.lhs, span),
        rhs: retarget_expr(b.rhs, span),
      }),
    EUnary(u) -> EUnary({ span: span, op: u.op, operand: retarget_expr(u.operand, span) }),
    // A lambda's written return type is deliberately not retargeted.
    ELambda(l) ->
      ELambda({
        span: span,
        body: retarget_expr(l.body, span),
        params: l.params.map(|p: Param| retarget_param(p, span)),
        ret: l.ret,
      }),
    EApp(a) ->
      EApp({
        span: span,
        func: retarget_expr(a.func, span),
        named: a.named.map(|arg: NamedArg|
          { name: arg.name, value: retarget_expr(arg.value, span), span: arg.span }),
        args: a.args.map(|x: Expr| retarget_expr(x, span)),
        labels: a.labels.map(|l: Ident| ident_at(l, span)),
      }),
    EIf(i) ->
      EIf({
        span: span,
        cond: retarget_expr(i.cond, span),
        then_branch: retarget_expr(i.then_branch, span),
        else_branch: retarget_expr(i.else_branch, span),
      }),
    EMatch(m) ->
      EMatch({
        span: span,
        scrutinee: retarget_expr(m.scrutinee, span),
        arms: m.arms.map(|arm: MatchArm|
          {
            pat: retarget_pat(arm.pat, span),
            guard: retarget_opt_expr(arm.guard, span),
            body: retarget_expr(arm.body, span),
            span: span,
          }),
      }),
    EBlock(b) ->
      EBlock({
        span: span,
        tail: retarget_opt_expr(b.tail, span),
        stmts: b.stmts.map(|stmt: Stmt|
          match stmt {
            SLet(l) ->
              SLet({
                span: span,
                pat: retarget_pat(l.pat, span),
                ty: match l.ty { Some(t) -> Some(retarget_ty(t, span)), None -> None },
                value: retarget_expr(l.value, span),
              }),
            SLetElse(l) ->
              SLetElse({
                span: span,
                pat: retarget_pat(l.pat, span),
                ty: match l.ty { Some(t) -> Some(retarget_ty(t, span)), None -> None },
                value: retarget_expr(l.value, span),
                fallback: retarget_expr(l.fallback, span),
              }),
            SExpr(x) -> SExpr(retarget_expr(x, span)),
            SAssign(x) ->
              SAssign({
                span: span,
                name: ident_at(x.name, span),
                value: retarget_expr(x.value, span),
              }),
          }),
      }),
    ERecord(r) ->
      ERecord({ span: span, fields: r.fields.map(|f: RecField| retarget_field(f, span)) }),
    ERecordUpdate(r) ->
      ERecordUpdate({
        span: span,
        base: retarget_expr(r.base, span),
        fields: r.fields.map(|f: RecField| retarget_field(f, span)),
      }),
    ETry(t) -> ETry({ span: span, operand: retarget_expr(t.operand, span) }),
    EField(f) ->
      EField({ span: span, base: retarget_expr(f.base, span), field: ident_at(f.field, span) }),
    EList(l) -> EList({ span: span, items: l.items.map(|x: Expr| retarget_expr(x, span)) }),
    EPerform(p) ->
      EPerform({
        span: span,
        eff: qname_at(p.eff, span),
        op: ident_at(p.op, span),
        resource: opt_ident_at(p.resource, span),
        args: p.args.map(|x: Expr| retarget_expr(x, span)),
      }),
    EHandle(h) ->
      EHandle({
        span: span,
        body: retarget_expr(h.body, span),
        ret: match h.ret {
          Some(rc) ->
            Some({
              binder: ident_at(rc.binder, span),
              body: retarget_expr(rc.body, span),
              span: span,
            }),
          None -> None,
        },
        clauses: h.clauses.map(|c: HandleClause|
          {
            eff: qname_at(c.eff, span),
            op: ident_at(c.op, span),
            resource: opt_ident_at(c.resource, span),
            every_label: c.every_label,
            label_binder: opt_ident_at(c.label_binder, span),
            resume: opt_ident_at(c.resume, span),
            body: retarget_expr(c.body, span),
            span: span,
            params: c.params.map(|p: Ident| ident_at(p, span)),
          }),
        vars: h.vars.map(|v: HandlerVar|
          {
            name: ident_at(v.name, span),
            ty: match v.ty { Some(t) -> Some(retarget_ty(t, span)), None -> None },
            init: retarget_expr(v.init, span),
            span: span,
          }),
      }),
    EWithHold(c) ->
      EWithHold({
        span: span,
        resource: ident_at(c.resource, span),
        acquire: retarget_expr(c.acquire, span),
        release: retarget_expr(c.release, span),
        binder: ident_at(c.binder, span),
        body: retarget_expr(c.body, span),
      }),
    ESimulate(x) -> ESimulate({ span: span, body: retarget_expr(x.body, span) }),
    EParallel(x) ->
      EParallel({ span: span, branches: x.branches.map(|b: Expr| retarget_expr(b, span)) }),
    ETagged(t) ->
      ETagged({
        ..t,
        span: span,
        tag: ident_at(t.tag, span),
        quoted: span,
        holes: t.holes.map(|h: Hole|
          { value: retarget_expr(h.value, span), text: h.text, quoted: span }),
      }),
    EBad(_) -> EBad({ span: span }),
    ETryBlock(x) -> ETryBlock({ ..x, span: span, body: retarget_expr(x.body, span) }),
  }

fn retarget_pat(p: Pattern, span: Span) -> Pattern =
  match p {
    PWild(_) -> PWild({ span: span }),
    PVar(v) -> PVar({ span: span, name: ident_at(v.name, span) }),
    PLit(l) -> PLit({ span: span, lit: l.lit }),
    PRange(r) -> PRange({ ..r, span: span }),
    PCtor(c) ->
      PCtor({
        span: span,
        name: qname_at(c.name, span),
        args: c.args.map(|a: Pattern| retarget_pat(a, span)),
      }),
    PRecord(r) ->
      PRecord({
        span: span,
        rest: r.rest,
        fields: r.fields.map(|f: { name: Ident, pat: Pattern }|
          { name: ident_at(f.name, span), pat: retarget_pat(f.pat, span) }),
      }),
    PList(l) ->
      PList({
        span: span,
        rest: match l.rest { Some(r) -> Some(retarget_pat(r, span)), None -> None },
        items: l.items.map(|i: Pattern| retarget_pat(i, span)),
      }),
    POr(o) -> POr({ span: span, alts: o.alts.map(|a: Pattern| retarget_pat(a, span)) }),
    PBad(_) -> PBad({ span: span }),
  }

// --- The expander --------------------------------------------------------------------------------

type Claimed = { name: Bytes, def: DeriveDef }
type Generated = { source: Bytes, defs: List<FnDef>, derived: Derived }

/// A library derivation to run: the deriver's module and the `std.derive` declaration it reads, as
/// `declaration_bytes` writes it.
pub type LibraryAsk = { module: Bytes, declaration: Bytes }

/// Why no library deriver answered: the diagnostic the derivation reports.
pub type Unrun = { code: Bytes, message: Bytes, notes: List<Bytes> }

/// A deriver's `derive::Refused`: why the type has no derivation, the field or variant that blocks
/// it, and notes on what to do instead.
pub type Refusal = { message: Bytes, at: Option<Bytes>, notes: List<Bytes> }

/// What a library derivation answered: the source its deriver wrote, its refusal, or why it did not
/// run.
pub type LibraryAnswer = | Wrote(Bytes) | Declined(Refusal) | Unran(Unrun)

derive bin for LibraryAsk

derive bin for Unrun

derive bin for Refusal

derive bin for LibraryAnswer

/// A declaration as an ask carries it: the arguments its deriver's root is entered with, the list of
/// it alone.
pub fn declaration_bytes(declaration: derive::Declaration) -> Bytes / {abort.raise} =
  match value::encode(value::VList([value::reflect(declaration)])) {
    Some(b) -> b,
    None -> panic("a declaration holds what PLV1 does not write"),
  }

/// The answer to the library derivation of the `derive` item at `span`.
type Answered = { span: Span, answer: LibraryAnswer }

/// `taken` holds what the module's own expansion wrote of the derivations of the part of it being
/// expanded, which are expanded to that; `answers` what each library deriver answered.
type Expander = {
  m: Int,
  path: Bytes,
  module: Module,
  types: List<TypeDef>,
  taken: List<Derivation>,
  answers: List<Answered>,
  claimed: List<Claimed>,
  generated: List<Generated>,
  diags: List<Diag>,
}

pub type Expansion = { module: Module, derived: List<Derived>, diags: List<Diag> }

fn report(expander: Expander, diag: Diag) -> Expander =
  { ..expander, diags: expander.diags.push(diag) }

fn find_claimed(xs: List<Claimed>, name: Bytes) -> Option<DeriveDef> =
  xs.fold(None, |acc: Option<DeriveDef>, claimed: Claimed|
    match acc {
      Some(_) -> acc,
      None -> if claimed.name == name { Some(claimed.def) } else { None },
    })

pub fn dotted(decl: ImportDecl) -> Bytes =
  Bytes::join(decl.path.map(|ident: Ident| ident.name), b".")

/// The hidden import an interpolating module gets has no binder generated source can spell.
fn import_binder(decl: ImportDecl) -> Option<Bytes> / {abort.raise} =
  match decl.kind {
    IModule -> if decl.path.len() == 0 { None }
    else { Some(decl.path.get(decl.path.len() - 1).name) },
    IAlias(a) -> if hidden_binder(a.name) { None } else { Some(a.name) },
    INames(_) -> None,
  }

fn eq_ignore_case(a: Bytes, b: Bytes) -> Bool / {abort.raise} =
  String::of_bytes(a).eq_ignore_ascii_case(String::of_bytes(b))

/// The first type of each name is the one a `derive` names.
fn new_expander(
  m: Int,
  path: Bytes,
  module: Module,
  taken: List<Derivation>,
  answers: List<Answered>,
) -> Expander =
  {
    m: m,
    path: path,
    module: module,
    types: module.items.fold([], |acc: List<TypeDef>, item: Item|
      match item {
        IType(d) -> match find_type(acc, d.name.name) { Some(_) -> acc, None -> acc.push(d) },
        _ -> acc,
      }),
    taken: taken,
    answers: answers,
    claimed: [],
    generated: [],
    diags: [],
  }

fn run_expander(expander: Expander) -> Expander / {abort.raise} =
  expander.module.items.fold(expander, |acc: Expander, item: Item|
    match item { IDerive(def) -> library_one(acc, def), _ -> acc })

// --- Library derivers ----------------------------------------------------------------------------

/// The module `binder` names in `module`'s imports: the deriver a `derive` by that name runs.
pub fn deriver_module(module: Module, binder: Bytes) -> Option<Bytes> / {abort.raise} =
  module.imports.fold(None, |acc: Option<Bytes>, decl: ImportDecl|
    match acc {
      Some(_) -> acc,
      None -> if import_binder(decl) == Some(binder) { Some(dotted(decl)) } else { None },
    })

/// What each library derivation of `module` asks, by its `derive` item, with what `taken` already
/// holds and what names no deriver left out: those the expander reports or expands without one.
fn asked_of(
  path: Bytes,
  module: Module,
  taken: List<Derivation>,
) -> List<{ span: Span, ask: LibraryAsk }> / {abort.raise} =
  module.items.fold([], |acc: List<{ span: Span, ask: LibraryAsk }>, item: Item|
    match item {
      IDerive(d) -> if taken.any(|t: Derivation|
          t.deriver == d.deriver && t.target == d.target.name) { acc } else {
        let declares = module.items.any(|i: Item|
          match i { IType(t) -> t.name.name == d.target.name, _ -> false });
        match if declares { deriver_module(module, d.deriver) } else { None } {
          None -> acc,
          Some(deriver) ->
            acc.push({
              span: d.span,
              ask: {
                module: deriver,
                declaration: declaration_bytes(
                  declaration_of(path, module, d.target.name, d.deriver),
                ),
              },
            }),
        }
      },
      _ -> acc,
    })

/// What a read of a module answers for a library derivation where nothing runs derivers.
fn unrun_alone() -> LibraryAnswer =
  Unran({
    code: b"E0155",
    message: b"a library deriver runs only where a load checks the program",
    notes: [
      b"`ply check`, `ply test`, `ply run` and `ply build` run each deriver a module names; this read of the module ran none",
    ],
  })

fn library_one(expander: Expander, def: DeriveDef) -> Expander / {abort.raise} =
  match find_type(expander.types, def.target.name) {
    None -> orphan(expander, def),
    Some(target) -> match expander.taken.find(|d: Derivation|
        d.deriver == def.deriver && d.target == def.target.name) {
      Some(d) -> library_wrote(expander, def, d.written),
      None -> match expander.answers.find(|a: Answered| a.span == def.span) {
        None -> unknown_deriver(expander, def),
        Some(a) -> match a.answer {
          Wrote(text) -> library_wrote(expander, def, [text]),
          Declined(refused) -> declined(expander, def, target, refused),
          Unran(u) ->
            report(
              expander,
              error_at(u.code, expander.m, def.span, u.message, b"this derivation", u.notes),
            ),
        },
      },
    },
  }

/// `def` expanded to the functions its deriver wrote, each claimed by its name.
fn library_wrote(
  expander: Expander,
  def: DeriveDef,
  written: List<Bytes>,
) -> Expander / {abort.raise} = {
  let source = Bytes::join(written, b"\n");
  let r = parse(source);
  let x = expand(r.node, r.parser.diags);
  let fns = x.module.items.fold([], |acc: List<FnDef>, item: Item|
    match item { IFn(d) -> acc.push(retarget_fn(d, def.span)), _ -> acc });
  if x.diags.len() > 0 || fns.len() != x.module.items.len() || r.node.imports.len() > 0 {
    report(
      expander,
      error_at(
        b"E0155",
        expander.m,
        def.span,
        Bytes::concat_all([
          b"the `",
          def.deriver,
          b"` deriver answered source that is not functions",
        ]),
        b"this derivation",
        [
          b"a deriver answers the functions it derives and nothing else, each read into the module as if written there",
          b"it answered: ".concat(source),
        ],
      ),
    )
  } else {
    let named = fns.fold(
      { ex: expander, clash: false },
      |acc: { ex: Expander, clash: Bool }, f: FnDef|
        match find_claimed(acc.ex.claimed, f.name.name) {
          Some(prev) -> { ex: collision(acc.ex, def, prev, f.name.name), clash: true },
          None ->
            {
              ex: { ..acc.ex, claimed: acc.ex.claimed.push({ name: f.name.name, def: def }) },
              clash: acc.clash,
            },
        },
    );
    if named.clash { named.ex } else {
      {
        ..named.ex,
        generated: named.ex.generated.push({
          source: source,
          defs: fns,
          derived: {
            deriver: def.deriver,
            target: def.target.name,
            span: def.span,
            written: written,
          },
        }),
      }
    }
  }
}

/// Where a refusal that names `at`, a field or a variant of `target`, points: there, else at the
/// type's name.
fn refused_at(target: TypeDef, at: Option<Bytes>) -> Span / {abort.raise} =
  match at {
    None -> target.name.span,
    Some(name) -> {
      let fields = |t: TypeExpr|
        match t {
          TRecord(r) ->
            r.fields.find(|f: { name: Ident, ty: TypeExpr }| f.name.name == name).map(
              |f: { name: Ident, ty: TypeExpr }| span_to(f.name.span, ty_span(f.ty)),
            ),
          _ -> None,
        };
      let found = match target.body {
        TDSum(variants) ->
          variants.find(|v: VariantDef| v.name.name == name).map(|v: VariantDef| v.span),
        TDAlias(t) -> fields(t),
        TDNominal(t) -> fields(t),
        TDExtern -> None,
      };
      match found { Some(span) -> span, None -> target.name.span }
    },
  }

fn declined(
  expander: Expander,
  def: DeriveDef,
  target: TypeDef,
  refused: Refusal,
) -> Expander / {abort.raise} =
  report(
    expander,
    error_at_and(
      b"E0206",
      expander.m,
      refused_at(target, refused.at),
      Bytes::concat_all([b"`", def.deriver, b"` cannot be derived for `", def.target.name, b"`"]),
      refused.message,
      expander.m,
      def.span,
      b"required by this derivation",
      refused.notes,
    ),
  )

fn unknown_deriver(expander: Expander, def: DeriveDef) -> Expander =
  report(
    expander,
    error_at(
      b"E0207",
      expander.m,
      def.deriver_span,
      Bytes::concat_all([b"`", def.deriver, b"` is not a deriver"]),
      b"unknown deriver",
      [
        Bytes::concat_all([
          b"a deriver is a module this file imports as `",
          def.deriver,
          b"`, whose `pub fn derive` writes the derivation: `import std.json` for `derive json`",
        ]),
      ],
    ),
  )

/// What `d` wrote, wherever its item stands.
pub fn derivation_of(d: Derived) -> Derivation =
  { deriver: d.deriver, target: d.target, written: d.written }

fn orphan(expander: Expander, def: DeriveDef) -> Expander / {abort.raise} = {
  let near = expander.types.fold(None, |acc: Option<Bytes>, type_def: TypeDef|
    match acc {
      Some(_) -> acc,
      None -> if eq_ignore_case(type_def.name.name, def.target.name) { Some(type_def.name.name) }
      else { None },
    });
  let notes = [
    b"a `derive` may only name a type its own module declares, so that one type has one canonical encoding rather than one per module that thought of it",
  ];
  report(
    expander,
    error_at(
      b"E0208",
      expander.m,
      def.target.span,
      Bytes::concat_all([b"`", def.target.name, b"` is not a type this module declares"]),
      b"declared in another module, or not at all",
      match near {
        Some(n) -> notes.push(Bytes::concat_all([b"this module declares `", n, b"`"])),
        None -> notes,
      },
    ),
  )
}

fn collision(expander: Expander, def: DeriveDef, prev: DeriveDef, name: Bytes) -> Expander = {
  let note = if prev.target.name == def.target.name {
    Bytes::concat_all([
      b"`derive ",
      def.deriver,
      b" for ",
      def.target.name,
      b"` is already written above; remove one",
    ])
  } else {
    Bytes::concat_all([
      b"`",
      prev.target.name,
      b"` and `",
      def.target.name,
      b"` both name `",
      name,
      b"`; rename one of the types",
    ])
  };
  report(
    expander,
    error_at_and(
      b"E0105",
      expander.m,
      def.span,
      Bytes::concat_all([b"`", name, b"` is generated twice"]),
      b"this derivation generates it",
      expander.m,
      prev.span,
      b"and so does this one",
      [note],
    ),
  )
}

/// Appends the generated definitions; `path` names the module. `module` is part of that module where
/// `taken` holds what the module's expansion wrote of each derivation of the part: each is expanded
/// to that. `library` runs a library derivation; with none, each is reported unrun.
pub fn expand_derives<| e>(
  m: Int,
  path: Bytes,
  module: Module,
  taken: List<Derivation> = [],
  library: Option<(LibraryAsk) -> LibraryAnswer / {abort.raise | e}> = None,
) -> Expansion / {abort.raise | e} =
  if !module.items.any(|item: Item| match item { IDerive(_) -> true, _ -> false }) {
    { module: module, derived: [], diags: [] }
  } else {
    let answers = asked_of(path, module, taken).map(|x: { span: Span, ask: LibraryAsk }|
      { span: x.span, answer: match library { Some(run) -> run(x.ask), None -> unrun_alone() } });
    let ex = run_expander(new_expander(m, path, module, taken, answers));
    {
      module: {
        doc: module.doc,
        imports: module.imports,
        items: ex.generated.fold(module.items, |acc: List<Item>, generated: Generated|
          acc.concat(generated.defs.map(|def: FnDef| IFn(def)))),
      },
      derived: ex.generated.map(|generated: Generated| generated.derived),
      diags: ex.diags,
    }
  }

// --- Tests ------------------------------------------------------------------

fn library_expanded(
  src: Bytes,
  answer: LibraryAnswer,
) -> { expansion: Expansion, asked: List<LibraryAsk> } / {abort.raise} =
  handle {
    let x = expand_derives(
      0,
      b"t",
      parse(src).node,
      library: Some(|ask: LibraryAsk| {
        asks.told(ask);
        answer
      }),
    );
    { expansion: x, asked: [] }
  } with {
    var seen: List<LibraryAsk> = [],
    asks.told(ask) -> {
      seen = seen.push(ask);
    },
    return v -> { ..v, asked: seen },
  }

effect asks {
  write told(ask: LibraryAsk) -> Unit
}

test "a library derivation asks its module's deriver with the module's types, and reads in what it wrote" {
  let src = b"import lib.mapping as mapping\ntype Box<a> = | Box(a, List<a>)\ntype Pair = { left: Int }\nderive mapping for Box\n";
  let x = library_expanded(
    src,
    Wrote(
      b"fn Box::map<a, b | e>(original: Box<a>, a: (a) -> b / e) -> Box<b> / e = match original { Box(x, xs) -> Box(a(x), xs.map(a)) }",
    ),
  );
  assert_eq(x.expansion.diags, []);
  assert_eq(x.asked.map(|a: LibraryAsk| a.module), [b"lib.mapping"]);
  let declaration = declaration_of(b"t", parse(src).node, b"Box", b"mapping");
  assert_eq(x.asked.get(0).declaration, declaration_bytes(declaration));
  assert_eq(declaration.target, "Box");
  assert_eq(declaration.binder, "mapping");
  assert_eq(declaration.derived, ["Box"]);
  assert_eq(declaration.imports, [{ module: "lib.mapping", binder: "mapping" }]);
  assert_eq(declaration.types.map(|t: derive::TypeDeclaration| t.name), ["Box", "Pair"]);
  assert_eq(
    derive::type_text(match derive::target(declaration).body {
      derive::Sum(vs) -> vs.get(0).fields.get(1),
      _ -> derive::Unit,
    }),
    "List<a>",
  );
  let generated = x.expansion.module.items.fold([], |acc: List<Bytes>, item: Item|
    match item { IFn(d) -> acc.push(d.name.name), _ -> acc });
  assert_eq(generated, [b"Box::map"]);
  assert_eq(x.expansion.derived.map(|d: Derived| d.written), [
    [
      b"fn Box::map<a, b | e>(original: Box<a>, a: (a) -> b / e) -> Box<b> / e = match original { Box(x, xs) -> Box(a(x), xs.map(a)) }",
    ],
  ])
}

test "a library deriver's refusal, failure, or text that is not functions each report at the derivation" {
  let src = b"import lib.mapping as mapping\ntype Box<a> = | Box(a) | Empty\nderive mapping for Box\n";
  let codes = |answer: LibraryAnswer|
    library_expanded(src, answer).expansion.diags.map(|d: Diag| d.code);
  let declined = library_expanded(
    src,
    Declined({ message: b"no", at: Some(b"Empty"), notes: [b"why"] }),
  );
  assert_eq(declined.expansion.diags.map(|d: Diag| d.code), [b"E0206"]);
  // The refusal points at the variant it names.
  assert_eq(Some(declined.expansion.diags.get(0).labels.get(0).start), src.index_of(b"Empty"));
  assert_eq(codes(Unran({ code: b"E0155", message: b"raised", notes: [] })), [b"E0155"]);
  assert_eq(codes(Wrote(b"type Wrong = Int")), [b"E0155"]);
  assert_eq(codes(Wrote(b"fn broken( = 1")), [b"E0155"]);
  // A read of the module that runs no deriver says so.
  assert_eq(expand_derives(0, b"t", parse(src).node).diags.map(|d: Diag| d.code), [b"E0155"]);
  // A name no import binds is no deriver, and nothing is asked.
  let unknown = library_expanded(b"type Box<a> = | Box(a)\nderive mapping for Box\n", Wrote(b""));
  assert_eq(unknown.expansion.diags.map(|d: Diag| d.code), [b"E0207"]);
  assert_eq(unknown.asked, [])
}

test "every node of a generated definition stands at the derive item's place, its numbering telling them apart" {
  let src = b"import lib.naming as naming\ntype Order = {id: Int, name: String}\nderive naming for Order";
  let x = library_expanded(
    src,
    Wrote(
      b"fn order_named(o: Order) -> String = if o.id > 0 { o.name } else { \"none\" ++ o.name }",
    ),
  ).expansion;
  assert_eq(x.derived.len(), 1);
  let d = x.derived.get(0);
  assert_eq(d.span, span_between(src.index_of(b"derive").at_or(0), src.len()));
  match numbered(x.module.items.get(x.module.items.len() - 1)) {
    IFn(f) -> {
      assert_eq(f.span, d.span);
      assert_eq(f.name.span, d.span);
      let spans = picked_in({ ..x.module, items: [IFn(f)] }, |_: Expr| true).map(expr_span);
      assert(spans.len() > 4);
      assert_eq(spans.map(|s: Span| span_between(s.start, s.end)), spans.map(|_: Span| d.span));
      assert_eq(spans.map(|s: Span| s.site).unique().len(), spans.len());
      assert_eq(spans.filter(|s: Span| s.site == 0), [])
    },
    _ -> assert(false),
  }
}
