import compiler.syntax.parsing (Span, Identifier, QName, span_to, span_between)
import compiler.syntax.node_ids (numbered)
import compiler.syntax.type_syntax (TypeExpression, VariableTypeExpression, NamedTypeExpression,
                                    FunctionTypeExpression, RecordTypeExpression,
                                    UnitTypeExpression, InvalidTypeExpression, EffectsExpression,
                                    EffectExpression, type_span)
import compiler.syntax.patterns (Pattern, PatternWildcard, PatternVariable, PatternLiteral,
                                 PatternRange, PatternConstructor, PatternRecord, PatternList,
                                 PatternOr, PatternInvalid)
import compiler.syntax.expressions (Expression, LiteralExpression, NameExpression, BinaryExpression,
                                    UnaryExpression, LambdaExpression, CallExpression, IfExpression,
                                    MatchExpression, BlockExpression, RecordExpression,
                                    RecordUpdateExpression, PropagateExpression, FieldExpression,
                                    ListExpression, PerformExpression, HandleExpression,
                                    WithScopeExpression, SimulateExpression, ParallelExpression,
                                    InvalidExpression, HoleExpression, TryBlockExpression,
                                    Statement, LetStatement, LetElseStatement, ExpressionStatement,
                                    AssignmentStatement, HandlerStateVariable, Param, NamedArg,
                                    MatchArm, HandleClause, ReturnClause, RecordLiteralField,
                                    TaggedLiteralExpression, Hole, expression_span)
import compiler.syntax.items (Module, Item, FunctionItem, TypeItem, DeriveItem, FnDefinition,
                              TypeDefinition, AliasBody, SumBody, VariantDefinition,
                              DeriveDefinition, ImportDeclaration, DeriveOrigin, Derivation,
                              Constraint, SpecClause, parse, NominalBody, ExternBody)
import compiler.expand.rewrite (expand)
import compiler.expand.rewrite.shared (find_type, expressions_matching)
import compiler.expand.declarations (declaration_of, import_binder)
import compiler.check.resolve.tables (Diagnostic, error_at, error_at_and)
import std.list
import std.string
import std.bin
import std.derive
import std.value

fn identifier_at(identifier: Identifier, span: Span) -> Identifier =
  { name: identifier.name, span: span }

fn qualified_name_at(qualified_name: QName, span: Span) -> QName =
  {
    module: match qualified_name.module { Some(m) -> Some(identifier_at(m, span)), None -> None },
    name: identifier_at(qualified_name.name, span),
    span: span,
  }

fn optional_identifier_at(o: Option<Identifier>, span: Span) -> Option<Identifier> =
  match o { Some(i) -> Some(identifier_at(i, span)), None -> None }

fn retarget_function(definition: FnDefinition, span: Span) -> FnDefinition =
  {
    visibility: definition.visibility,
    name: { name: definition.name.name, span: span },
    generics: {
      types: definition.generics.types.map(|identifier: Identifier|
        identifier_at(identifier, span)),
      effects: definition.generics.effects.map(|identifier: Identifier|
        identifier_at(identifier, span)),
      labels: definition.generics.labels.map(|identifier: Identifier|
        identifier_at(identifier, span)),
      retained_types: definition.generics.retained_types.map(|identifier: Identifier|
        identifier_at(identifier, span)),
    },
    params: definition.params.map(|param: Param| retarget_param(param, span)),
    return_type: match definition.return_type {
      Some(t) -> Some(retarget_type(t, span)),
      None -> None,
    },
    effects: match definition.effects { Some(r) -> Some(retarget_effects(r, span)), None -> None },
    constraints: definition.constraints.map(|c: Constraint|
      { deriver: c.deriver, deriver_span: span, param: identifier_at(c.param, span), span: span }),
    spec: definition.spec.map(|c: SpecClause|
      { kind: c.kind, expression: retarget_expression(c.expression, span), span: span }),
    returns: definition.returns,
    reuse: definition.reuse,
    transparent: definition.transparent,
    constant: definition.constant,
    decreases: match definition.decreases {
      Some(e) -> Some(retarget_expression(e, span)),
      None -> None,
    },
    body: retarget_expression(definition.body, span),
    doc: definition.doc,
    span: span,
  }

fn retarget_param(param: Param, span: Span) -> Param =
  {
    name: identifier_at(param.name, span),
    keep: param.keep,
    ty: match param.ty { Some(t) -> Some(retarget_type(t, span)), None -> None },
    cost: param.cost,
    space: param.space,
    default: param.default,
    span: span,
  }

fn retarget_type(t: TypeExpression, span: Span) -> TypeExpression =
  match t {
    VariableTypeExpression(i) -> VariableTypeExpression(identifier_at(i, span)),
    NamedTypeExpression(c) ->
      NamedTypeExpression({
        span: span,
        name: qualified_name_at(c.name, span),
        args: c.args.map(|a: TypeExpression| retarget_type(a, span)),
        labels: c.labels.map(|l: Identifier| identifier_at(l, span)),
        effect_arguments: c.effect_arguments.map(|r: EffectsExpression| retarget_effects(r, span)),
      }),
    FunctionTypeExpression(f) ->
      FunctionTypeExpression({
        ..f,
        span: span,
        params: f.params.map(|p: TypeExpression| retarget_type(p, span)),
        return_type: retarget_type(f.return_type, span),
        effects: match f.effects { Some(r) -> Some(retarget_effects(r, span)), None -> None },
      }),
    RecordTypeExpression(r) ->
      RecordTypeExpression({
        span: span,
        fields: r.fields.map(|f: { name: Identifier, ty: TypeExpression }|
          { name: identifier_at(f.name, span), ty: retarget_type(f.ty, span) }),
      }),
    UnitTypeExpression(_) -> UnitTypeExpression({ span: span }),
    InvalidTypeExpression(_) -> InvalidTypeExpression({ span: span }),
  }

fn retarget_effects(effects: EffectsExpression, span: Span) -> EffectsExpression =
  {
    listed: effects.listed.map(|entry: EffectExpression|
      {
        effect_name: qualified_name_at(entry.effect_name, span),
        mode: entry.mode,
        operation: optional_identifier_at(entry.operation, span),
        resource: optional_identifier_at(entry.resource, span),
        resource_wildcard: entry.resource_wildcard,
        bounded: entry.bounded,
        span: span,
      }),
    aliases: effects.aliases.map(|alias: QName| qualified_name_at(alias, span)),
    variable: optional_identifier_at(effects.variable, span),
    variable_bounded: effects.variable_bounded,
    span: span,
  }

fn retarget_optional_expression(expression: Option<Expression>, span: Span) -> Option<Expression> =
  match expression { Some(e) -> Some(retarget_expression(e, span)), None -> None }

fn retarget_field(field: RecordLiteralField, span: Span) -> RecordLiteralField =
  { name: identifier_at(field.name, span), value: retarget_expression(field.value, span) }

fn retarget_expression(e: Expression, span: Span) -> Expression =
  match e {
    LiteralExpression(l) -> LiteralExpression({ span: span, literal: l.literal }),
    HoleExpression(h) -> HoleExpression({ span: span, text: h.text }),
    NameExpression(v) -> NameExpression({ span: span, name: qualified_name_at(v.name, span) }),
    BinaryExpression(b) ->
      BinaryExpression({
        span: span,
        operation: b.operation,
        left_operand: retarget_expression(b.left_operand, span),
        right_operand: retarget_expression(b.right_operand, span),
      }),
    UnaryExpression(u) ->
      UnaryExpression({
        span: span,
        operation: u.operation,
        operand: retarget_expression(u.operand, span),
      }),
    LambdaExpression(l) ->
      LambdaExpression({
        span: span,
        body: retarget_expression(l.body, span),
        params: l.params.map(|p: Param| retarget_param(p, span)),
        return_clause: l.return_clause,
      }),
    CallExpression(a) ->
      CallExpression({
        span: span,
        function: retarget_expression(a.function, span),
        named: a.named.map(|arg: NamedArg|
          { name: arg.name, value: retarget_expression(arg.value, span), span: arg.span }),
        args: a.args.map(|x: Expression| retarget_expression(x, span)),
        labels: a.labels.map(|l: Identifier| identifier_at(l, span)),
      }),
    IfExpression(i) ->
      IfExpression({
        span: span,
        cond: retarget_expression(i.cond, span),
        then_branch: retarget_expression(i.then_branch, span),
        else_branch: retarget_expression(i.else_branch, span),
      }),
    MatchExpression(m) ->
      MatchExpression({
        span: span,
        scrutinee: retarget_expression(m.scrutinee, span),
        arms: m.arms.map(|arm: MatchArm|
          {
            pattern: retarget_pattern(arm.pattern, span),
            guard: retarget_optional_expression(arm.guard, span),
            body: retarget_expression(arm.body, span),
            span: span,
          }),
      }),
    BlockExpression(b) ->
      BlockExpression({
        span: span,
        tail: retarget_optional_expression(b.tail, span),
        statements: b.statements.map(|statement: Statement|
          match statement {
            LetStatement(l) ->
              LetStatement({
                span: span,
                pattern: retarget_pattern(l.pattern, span),
                ty: match l.ty { Some(t) -> Some(retarget_type(t, span)), None -> None },
                value: retarget_expression(l.value, span),
              }),
            LetElseStatement(l) ->
              LetElseStatement({
                span: span,
                pattern: retarget_pattern(l.pattern, span),
                ty: match l.ty { Some(t) -> Some(retarget_type(t, span)), None -> None },
                value: retarget_expression(l.value, span),
                fallback: retarget_expression(l.fallback, span),
              }),
            ExpressionStatement(x) -> ExpressionStatement(retarget_expression(x, span)),
            AssignmentStatement(x) ->
              AssignmentStatement({
                span: span,
                name: identifier_at(x.name, span),
                value: retarget_expression(x.value, span),
              }),
          }),
      }),
    RecordExpression(r) ->
      RecordExpression({
        span: span,
        fields: r.fields.map(|f: RecordLiteralField| retarget_field(f, span)),
      }),
    RecordUpdateExpression(r) ->
      RecordUpdateExpression({
        span: span,
        base: retarget_expression(r.base, span),
        fields: r.fields.map(|f: RecordLiteralField| retarget_field(f, span)),
      }),
    PropagateExpression(t) ->
      PropagateExpression({ span: span, operand: retarget_expression(t.operand, span) }),
    FieldExpression(f) ->
      FieldExpression({
        span: span,
        base: retarget_expression(f.base, span),
        field: identifier_at(f.field, span),
      }),
    ListExpression(l) ->
      ListExpression({
        span: span,
        items: l.items.map(|x: Expression| retarget_expression(x, span)),
      }),
    PerformExpression(p) ->
      PerformExpression({
        span: span,
        effect_name: qualified_name_at(p.effect_name, span),
        operation: identifier_at(p.operation, span),
        resource: optional_identifier_at(p.resource, span),
        args: p.args.map(|x: Expression| retarget_expression(x, span)),
      }),
    HandleExpression(h) ->
      HandleExpression({
        span: span,
        body: retarget_expression(h.body, span),
        return_clause: match h.return_clause {
          Some(return_clause) ->
            Some({
              binder: identifier_at(return_clause.binder, span),
              body: retarget_expression(return_clause.body, span),
              span: span,
            }),
          None -> None,
        },
        clauses: h.clauses.map(|c: HandleClause|
          {
            effect_name: qualified_name_at(c.effect_name, span),
            operation: identifier_at(c.operation, span),
            resource: optional_identifier_at(c.resource, span),
            wildcard_label: c.wildcard_label,
            label_binder: optional_identifier_at(c.label_binder, span),
            resume: optional_identifier_at(c.resume, span),
            body: retarget_expression(c.body, span),
            span: span,
            params: c.params.map(|p: Identifier| identifier_at(p, span)),
          }),
        handler_variables: h.handler_variables.map(|v: HandlerStateVariable|
          {
            name: identifier_at(v.name, span),
            ty: match v.ty { Some(t) -> Some(retarget_type(t, span)), None -> None },
            init: retarget_expression(v.init, span),
            span: span,
          }),
      }),
    WithScopeExpression(c) ->
      WithScopeExpression({
        span: span,
        resource: identifier_at(c.resource, span),
        acquire: retarget_expression(c.acquire, span),
        release: retarget_expression(c.release, span),
        binder: identifier_at(c.binder, span),
        body: retarget_expression(c.body, span),
      }),
    SimulateExpression(x) ->
      SimulateExpression({ span: span, body: retarget_expression(x.body, span) }),
    ParallelExpression(x) ->
      ParallelExpression({
        span: span,
        branches: x.branches.map(|b: Expression| retarget_expression(b, span)),
      }),
    TaggedLiteralExpression(t) ->
      TaggedLiteralExpression({
        ..t,
        span: span,
        tag: identifier_at(t.tag, span),
        quoted: span,
        holes: t.holes.map(|h: Hole|
          { value: retarget_expression(h.value, span), text: h.text, quoted: span }),
      }),
    InvalidExpression(_) -> InvalidExpression({ span: span }),
    TryBlockExpression(x) ->
      TryBlockExpression({ ..x, span: span, body: retarget_expression(x.body, span) }),
  }

fn retarget_pattern(p: Pattern, span: Span) -> Pattern =
  match p {
    PatternWildcard(_) -> PatternWildcard({ span: span }),
    PatternVariable(v) -> PatternVariable({ span: span, name: identifier_at(v.name, span) }),
    PatternLiteral(l) -> PatternLiteral({ span: span, literal: l.literal }),
    PatternRange(r) -> PatternRange({ ..r, span: span }),
    PatternConstructor(c) ->
      PatternConstructor({
        span: span,
        name: qualified_name_at(c.name, span),
        args: c.args.map(|a: Pattern| retarget_pattern(a, span)),
      }),
    PatternRecord(r) ->
      PatternRecord({
        span: span,
        rest: r.rest,
        fields: r.fields.map(|f: { name: Identifier, pattern: Pattern }|
          { name: identifier_at(f.name, span), pattern: retarget_pattern(f.pattern, span) }),
      }),
    PatternList(l) ->
      PatternList({
        span: span,
        rest: match l.rest { Some(r) -> Some(retarget_pattern(r, span)), None -> None },
        items: l.items.map(|i: Pattern| retarget_pattern(i, span)),
      }),
    PatternOr(o) ->
      PatternOr({
        span: span,
        alternatives: o.alternatives.map(|a: Pattern| retarget_pattern(a, span)),
      }),
    PatternInvalid(_) -> PatternInvalid({ span: span }),
  }

type NameClaim = { name: Bytes, definition: DeriveDefinition }
type GeneratedFunctions = { source: Bytes, definitions: List<FnDefinition>, derived: DeriveOrigin }

pub type DeriverRequest = { module: Bytes, declaration: Bytes }

pub type DeriverFailure = { code: Bytes, message: Bytes, notes: List<Bytes> }

pub type Rejection = { message: Bytes, at: Option<Bytes>, notes: List<Bytes> }

pub type DeriverResponse = | Generated(Bytes) | Declined(Rejection) | Failed(DeriverFailure)

derive bin for DeriverRequest

derive bin for DeriverFailure

derive bin for Rejection

derive bin for DeriverResponse

pub fn declaration_bytes(declaration: derive::Declaration) -> Bytes / {abort.raise} =
  match value::encode(value::VList([value::reflect(declaration)])) {
    Some(b) -> b,
    None -> panic("internal error: a declaration contains a value that cannot be written as bytes"),
  }

type ItemResponse = { span: Span, result: DeriverResponse }

type Expander = {
  m: Int,
  path: Bytes,
  module: Module,
  types: List<TypeDefinition>,
  previous_derivations: List<Derivation>,
  results: List<ItemResponse>,
  claimed: List<NameClaim>,
  generated: List<GeneratedFunctions>,
  diagnostics: List<Diagnostic>,
}

pub type Expansion = { module: Module, derived: List<DeriveOrigin>, diagnostics: List<Diagnostic> }

fn report(expander: Expander, diagnostic: Diagnostic) -> Expander =
  { ..expander, diagnostics: expander.diagnostics.push(diagnostic) }

fn find_claim(xs: List<NameClaim>, name: Bytes) -> Option<DeriveDefinition> =
  xs.fold(None, |accumulator: Option<DeriveDefinition>, claimed: NameClaim|
    match accumulator {
      Some(_) -> accumulator,
      None -> if claimed.name == name { Some(claimed.definition) } else { None },
    })

pub fn import_path(declaration: ImportDeclaration) -> Bytes =
  Bytes::join(declaration.path.map(|identifier: Identifier| identifier.name), b".")

fn eq_ignore_case(a: Bytes, b: Bytes) -> Bool / {abort.raise} =
  String::of_bytes(a).eq_ignore_ascii_case(String::of_bytes(b))

fn new_expander(
  m: Int,
  path: Bytes,
  module: Module,
  previous: List<Derivation>,
  results: List<ItemResponse>,
) -> Expander =
  {
    m: m,
    path: path,
    module: module,
    types: module.items.fold([], |accumulator: List<TypeDefinition>, item: Item|
      match item {
        TypeItem(d) -> match find_type(accumulator, d.name.name) {
          Some(_) -> accumulator,
          None -> accumulator.push(d),
        },
        _ -> accumulator,
      }),
    previous_derivations: previous,
    results: results,
    claimed: [],
    generated: [],
    diagnostics: [],
  }

fn run_expander(expander: Expander) -> Expander / {abort.raise} =
  expander.module.items.fold(expander, |accumulator: Expander, item: Item|
    match item { DeriveItem(definition) -> derive_one(accumulator, definition), _ -> accumulator })

pub fn deriver_module(module: Module, binder: Bytes) -> Option<Bytes> =
  module.imports.fold(None, |accumulator: Option<Bytes>, declaration: ImportDeclaration|
    match accumulator {
      Some(_) -> accumulator,
      None -> if import_binder(declaration) == Some(binder) { Some(import_path(declaration)) }
      else { None },
    })

fn deriver_requests(
  path: Bytes,
  module: Module,
  previous: List<Derivation>,
) -> List<{ span: Span, ask: DeriverRequest }> / {abort.raise} =
  module.items.fold([], |accumulator: List<{ span: Span, ask: DeriverRequest }>, item: Item|
    match item {
      DeriveItem(d) -> if previous.any(|t: Derivation|
          t.deriver == d.deriver && t.target == d.target.name) { accumulator } else {
        let declares = module.items.any(|i: Item|
          match i { TypeItem(t) -> t.name.name == d.target.name, _ -> false });
        match if declares { deriver_module(module, d.deriver) } else { None } {
          None -> accumulator,
          Some(deriver) ->
            accumulator.push({
              span: d.span,
              ask: {
                module: deriver,
                declaration: declaration_bytes(
                  declaration_of(path, module, d.target.name, d.deriver),
                ),
              },
            }),
        }
      },
      _ -> accumulator,
    })

const no_runner_failure: DeriverResponse =
  Failed({
    code: b"E0155",
    message: b"a library deriver cannot run here; it runs only during a command that checks the program",
    notes: [
      b"`ply check`, `ply test`, `ply run` and `ply build` run each deriver a module names; this read of the module ran none",
    ],
  })

fn derive_one(expander: Expander, definition: DeriveDefinition) -> Expander / {abort.raise} =
  match find_type(expander.types, definition.target.name) {
    None -> report_undeclared_target(expander, definition),
    Some(target) -> match expander.previous_derivations.find(|d: Derivation|
        d.deriver == definition.deriver && d.target == definition.target.name) {
      Some(d) -> add_generated_source(expander, definition, d.written),
      None -> match expander.results.find(|a: ItemResponse| a.span == definition.span) {
        None -> unknown_deriver(expander, definition),
        Some(a) -> match a.result {
          Generated(text) -> add_generated_source(expander, definition, [text]),
          Declined(rejected) -> report_derive_error(expander, definition, target, rejected),
          Failed(u) ->
            report(
              expander,
              error_at(u.code, expander.m, definition.span, u.message, b"this derivation", u.notes),
            ),
        },
      },
    },
  }

fn add_generated_source(
  expander: Expander,
  definition: DeriveDefinition,
  written: List<Bytes>,
) -> Expander / {abort.raise} = {
  let source = Bytes::join(written, b"\n");
  let r = parse(source);
  let x = expand(r.node, r.parser.diagnostics);
  let functions = x.module.items.fold([], |accumulator: List<FnDefinition>, item: Item|
    match item {
      FunctionItem(d) -> accumulator.push(retarget_function(d, definition.span)),
      _ -> accumulator,
    });
  if x.diagnostics.len() > 0 || functions.len() != x.module.items.len()
      || r.node.imports.len() > 0 {
    report(
      expander,
      error_at(
        b"E0155",
        expander.m,
        definition.span,
        Bytes::concat_all([
          b"the `",
          definition.deriver,
          b"` deriver must return only function definitions, but it returned other source",
        ]),
        b"this derivation",
        [
          b"a deriver returns the functions it derives and nothing else, each read into the module as if written there",
          b"it returned: ".concat(source),
        ],
      ),
    )
  } else {
    let named = functions.fold(
      { ex: expander, clash: false },
      |accumulator: { ex: Expander, clash: Bool }, f: FnDefinition|
        match find_claim(accumulator.ex.claimed, f.name.name) {
          Some(earlier) ->
            { ex: collision(accumulator.ex, definition, earlier, f.name.name), clash: true },
          None ->
            {
              ex: {
                ..accumulator.ex,
                claimed: accumulator.ex.claimed.push({ name: f.name.name, definition: definition }),
              },
              clash: accumulator.clash,
            },
        },
    );
    if named.clash { named.ex } else {
      {
        ..named.ex,
        generated: named.ex.generated.push({
          source: source,
          definitions: functions,
          derived: {
            deriver: definition.deriver,
            target: definition.target.name,
            span: definition.span,
            written: written,
          },
        }),
      }
    }
  }
}

fn derive_error_span(target: TypeDefinition, at: Option<Bytes>) -> Span =
  match at {
    None -> target.name.span,
    Some(name) -> {
      let fields = |t: TypeExpression|
        match t {
          RecordTypeExpression(r) ->
            r.fields.find(|f: { name: Identifier, ty: TypeExpression }| f.name.name == name).map(
              |f: { name: Identifier, ty: TypeExpression }| span_to(f.name.span, type_span(f.ty)),
            ),
          _ -> None,
        };
      let found = match target.body {
        SumBody(variants) ->
          variants.find(|v: VariantDefinition| v.name.name == name).map(|v: VariantDefinition|
            v.span),
        AliasBody(t) -> fields(t),
        NominalBody(t) -> fields(t),
        ExternBody -> None,
      };
      match found { Some(span) -> span, None -> target.name.span }
    },
  }

fn report_derive_error(
  expander: Expander,
  definition: DeriveDefinition,
  target: TypeDefinition,
  rejected: Rejection,
) -> Expander =
  report(
    expander,
    error_at_and(
      b"E0206",
      expander.m,
      derive_error_span(target, rejected.at),
      Bytes::concat_all([
        b"`",
        definition.deriver,
        b"` cannot be derived for `",
        definition.target.name,
        b"`",
      ]),
      rejected.message,
      expander.m,
      definition.span,
      b"required by this derivation",
      rejected.notes,
    ),
  )

fn unknown_deriver(expander: Expander, definition: DeriveDefinition) -> Expander =
  report(
    expander,
    error_at(
      b"E0207",
      expander.m,
      definition.deriver_span,
      Bytes::concat_all([b"`", definition.deriver, b"` is not a deriver"]),
      b"unknown deriver",
      [
        Bytes::concat_all([
          b"a deriver is a module this file imports as `",
          definition.deriver,
          b"`, whose `pub fn derive` writes the derivation: `import std.json` for `derive json`",
        ]),
      ],
    ),
  )

pub fn derivation_of(d: DeriveOrigin) -> Derivation =
  { deriver: d.deriver, target: d.target, written: d.written }

fn report_undeclared_target(
  expander: Expander,
  definition: DeriveDefinition,
) -> Expander / {abort.raise} = {
  let near = expander.types.fold(
    None,
    |accumulator: Option<Bytes>, type_definition: TypeDefinition|
      match accumulator {
        Some(_) -> accumulator,
        None -> if eq_ignore_case(type_definition.name.name, definition.target.name) {
          Some(type_definition.name.name)
        } else { None },
      },
  );
  let notes = [
    b"a `derive` may only name a type declared in its own module, so each type has a single encoding instead of several conflicting ones from different modules",
  ];
  report(
    expander,
    error_at(
      b"E0208",
      expander.m,
      definition.target.span,
      Bytes::concat_all([b"`", definition.target.name, b"` is not a type this module declares"]),
      b"declared in another module, or not at all",
      match near {
        Some(n) -> notes.push(Bytes::concat_all([b"this module declares `", n, b"`"])),
        None -> notes,
      },
    ),
  )
}

fn collision(
  expander: Expander,
  definition: DeriveDefinition,
  earlier: DeriveDefinition,
  name: Bytes,
) -> Expander = {
  let note = if earlier.target.name == definition.target.name {
    Bytes::concat_all([
      b"`derive ",
      definition.deriver,
      b" for ",
      definition.target.name,
      b"` is already written above; remove one",
    ])
  } else {
    Bytes::concat_all([
      b"`",
      earlier.target.name,
      b"` and `",
      definition.target.name,
      b"` both name `",
      name,
      b"`; rename one of the types",
    ])
  };
  report(
    expander,
    error_at_and(
      b"E0105",
      expander.m,
      definition.span,
      Bytes::concat_all([b"`", name, b"` is generated twice"]),
      b"this derivation generates it",
      expander.m,
      earlier.span,
      b"this `derive` also generates that name",
      [note],
    ),
  )
}

pub fn expand_derives<| e>(
  m: Int,
  path: Bytes,
  module: Module,
  previous: List<Derivation> = [],
  library: Option<(DeriverRequest) -> DeriverResponse / {abort.raise | e}> = None,
) -> Expansion / {abort.raise | e} =
  if !module.items.any(|item: Item| match item { DeriveItem(_) -> true, _ -> false }) {
    { module: module, derived: [], diagnostics: [] }
  } else {
    let results = deriver_requests(path, module, previous).map(
      |x: { span: Span, ask: DeriverRequest }|
        {
          span: x.span,
          result: match library { Some(run) -> run(x.ask), None -> no_runner_failure },
        },
    );
    let ex = run_expander(new_expander(m, path, module, previous, results));
    {
      module: {
        doc: module.doc,
        imports: module.imports,
        items: ex.generated.fold(
          module.items,
          |accumulator: List<Item>, generated: GeneratedFunctions|
            accumulator.concat(
              generated.definitions.map(|definition: FnDefinition| FunctionItem(definition)),
            ),
        ),
      },
      derived: ex.generated.map(|generated: GeneratedFunctions| generated.derived),
      diagnostics: ex.diagnostics,
    }
  }

fn expand_with_response(
  source: Bytes,
  result: DeriverResponse,
) -> { expansion: Expansion, requested: List<DeriverRequest> } / {abort.raise} =
  handle {
    let x = expand_derives(
      0,
      b"t",
      parse(source).node,
      library: Some(|ask: DeriverRequest| {
        request_log.record(ask);
        result
      }),
    );
    { expansion: x, requested: [] }
  } with {
    var seen: List<DeriverRequest> = [],
    request_log.record(ask) -> {
      seen = seen.push(ask);
    },
    return v -> { ..v, requested: seen },
  }

effect request_log {
  write record(ask: DeriverRequest) -> Unit
}

test "a `derive` item calls the module's deriver function with the module's type declarations, then adds the function definitions it returns" {
  let source = b"import lib.mapping as mapping\ntype Box<a> = | Box(a, List<a>)\ntype Pair = { left: Int }\nderive mapping for Box\n";
  let x = expand_with_response(
    source,
    Generated(
      b"fn Box::map<a, b | e>(original: Box<a>, a: (a) -> b / e) -> Box<b> / e = match original { Box(x, xs) -> Box(a(x), xs.map(a)) }",
    ),
  );
  assert_eq(x.expansion.diagnostics, []);
  assert_eq(x.requested.map(|a: DeriverRequest| a.module), [b"lib.mapping"]);
  let declaration = declaration_of(b"t", parse(source).node, b"Box", b"mapping");
  assert_eq(x.requested.get(0).declaration, declaration_bytes(declaration));
  assert_eq(declaration.target, "Box");
  assert_eq(declaration.binder, "mapping");
  assert_eq(declaration.derived, ["Box"]);
  assert_eq(declaration.imports, [{ module: "lib.mapping", binder: "mapping" }]);
  assert_eq(declaration.types.map(|t: derive::TypeDeclaration| t.name), ["Box", "Pair"]);
  assert_eq(
    derive::type_text(match derive::target(declaration).body {
      derive::Sum(vs) -> vs.get(0).fields.get(1),
      _ -> derive::Unit,
    }),
    "List<a>",
  );
  let generated = x.expansion.module.items.fold([], |accumulator: List<Bytes>, item: Item|
    match item { FunctionItem(d) -> accumulator.push(d.name.name), _ -> accumulator });
  assert_eq(generated, [b"Box::map"]);
  assert_eq(x.expansion.derived.map(|d: DeriveOrigin| d.written), [
    [
      b"fn Box::map<a, b | e>(original: Box<a>, a: (a) -> b / e) -> Box<b> / e = match original { Box(x, xs) -> Box(a(x), xs.map(a)) }",
    ],
  ])
}

test "a deriver that returns a rejection, fails, or returns text that is not function definitions reports an error at the `derive` item" {
  let source = b"import lib.mapping as mapping\ntype Box<a> = | Box(a) | Empty\nderive mapping for Box\n";
  let codes = |result: DeriverResponse|
    expand_with_response(source, result).expansion.diagnostics.map(|d: Diagnostic| d.code);
  let report_derive_error = expand_with_response(
    source,
    Declined({ message: b"no", at: Some(b"Empty"), notes: [b"why"] }),
  );
  assert_eq(report_derive_error.expansion.diagnostics.map(|d: Diagnostic| d.code), [b"E0206"]);
  assert_eq(
    Some(report_derive_error.expansion.diagnostics.get(0).labels.get(0).start),
    source.index_of(b"Empty"),
  );
  assert_eq(codes(Failed({ code: b"E0155", message: b"raised", notes: [] })), [b"E0155"]);
  assert_eq(codes(Generated(b"type Wrong = Int")), [b"E0155"]);
  assert_eq(codes(Generated(b"fn broken( = 1")), [b"E0155"]);
  assert_eq(expand_derives(0, b"t", parse(source).node).diagnostics.map(|d: Diagnostic| d.code), [
    b"E0155",
  ]);
  let unknown = expand_with_response(
    b"type Box<a> = | Box(a)\nderive mapping for Box\n",
    Generated(b""),
  );
  assert_eq(unknown.expansion.diagnostics.map(|d: Diagnostic| d.code), [b"E0207"]);
  assert_eq(unknown.requested, [])
}

test "every syntax node of a generated definition has the span of the `derive` item, and each node has its own node number" {
  let source = b"import lib.naming as naming\ntype Order = {id: Int, name: String}\nderive naming for Order";
  let x = expand_with_response(
    source,
    Generated(
      b"fn order_named(o: Order) -> String = if o.id > 0 { o.name } else { \"none\" ++ o.name }",
    ),
  ).expansion;
  assert_eq(x.derived.len(), 1);
  let d = x.derived.get(0);
  assert_eq(d.span, span_between(source.index_of(b"derive").unwrap_or(0), source.len()));
  match numbered(x.module.items.get(x.module.items.len() - 1)) {
    FunctionItem(f) -> {
      assert_eq(f.span, d.span);
      assert_eq(span_between(f.name.span.start, f.name.span.end), d.span);
      let spans = expressions_matching(
        { ..x.module, items: [FunctionItem(f)] },
        |_: Expression| true,
      ).map(
        expression_span,
      );
      assert(spans.len() > 4);
      assert_eq(spans.map(|s: Span| span_between(s.start, s.end)), spans.map(|_: Span| d.span));
      assert_eq(spans.map(|s: Span| s.site).unique().len(), spans.len());
      assert_eq(spans.filter(|s: Span| s.site == 0), [])
    },
    _ -> assert(false),
  }
}
