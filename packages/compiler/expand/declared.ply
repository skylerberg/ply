//! A module's types as `std.derive` hands them to a deriver: plain data, each type as it is written.

import compiler.syntax.parsing (Ident, QName, qname_text)
import compiler.syntax.type_syntax (TypeExpr, TVar, TCon, TFn, TRecord, TUnit, TBad, RowExpr,
                                    AtomExpr, mode_text)
import compiler.syntax.items (Module, Item, IType, IDerive, TypeDef, TDAlias, TDSum, TDNominal,
                              TDExtern, VariantDef, VPub, Deriver, deriver_text)
import std.derive
import std.list
import std.string

/// What a deriver reads of `module`, the module `path`, deriving `target` with `deriver`, whose module
/// it writes as `binder`.
pub fn declaration_of(
  path: Bytes,
  module: Module,
  target: Bytes,
  deriver: Deriver,
  binder: Bytes,
) -> derive::Declaration / {abort.raise} =
  {
    target: String::of_bytes(target),
    module: String::of_bytes(path),
    binder: String::of_bytes(binder),
    types: module.items.fold([], |acc: List<derive::TypeDeclaration>, item: Item|
      match item { IType(d) -> acc.push(declared(d)), _ -> acc }),
    derived: module.items.fold([], |acc: List<String>, item: Item|
      match item {
        IDerive(d) -> if deriver_text(d.deriver) == deriver_text(deriver) {
          acc.push(String::of_bytes(d.target.name))
        } else { acc },
        _ -> acc,
      }),
  }

fn declared(d: TypeDef) -> derive::TypeDeclaration / {abort.raise} =
  {
    name: String::of_bytes(d.name.name),
    public: d.vis == VPub,
    types: d.generics.types.map(name_of),
    rows: d.generics.effects.map(name_of),
    labels: d.generics.labels.map(name_of),
    body: match d.body {
      TDAlias(t) -> derive::Alias(written(t)),
      TDNominal(t) -> derive::Nominal(written(t)),
      TDSum(variants) ->
        derive::Sum(
          variants.map(|v: VariantDef|
            { name: String::of_bytes(v.name.name), fields: v.fields.map(written) }),
        ),
      TDExtern -> derive::Extern,
    },
  }

fn name_of(i: Ident) -> String / {abort.raise} = String::of_bytes(i.name)

fn written(t: TypeExpr) -> derive::Type / {abort.raise} =
  match t {
    TVar(i) -> derive::Param(name_of(i)),
    TCon(c) ->
      derive::Applied(
        {
          module: match c.name.module { Some(m) -> Some(name_of(m)), None -> None },
          name: name_of(c.name.name),
        },
        c.args.map(written),
        c.labels.map(name_of),
        c.rows.map(|r: RowExpr| String::of_bytes(row_written(r))),
      ),
    TFn(f) ->
      derive::Function(f.params.map(written), written(f.ret), match f.effects {
        Some(r) -> String::of_bytes(row_written(r)),
        None -> "",
      }),
    TRecord(r) ->
      derive::Record(
        r.fields.map(|f: { name: Ident, ty: TypeExpr }|
          { name: name_of(f.name), ty: written(f.ty) }),
      ),
    TUnit(_) -> derive::Unit,
    TBad(_) -> derive::Unit,
  }

/// A row as it is written: `{a.read, b.op[l] bounded, Set | e bounded}`.
pub fn row_written(row: RowExpr) -> Bytes = {
  let members = row.atoms.map(atom_written).concat(row.aliases.map(qname_text));
  let tail = match row.tail {
    Some(t) ->
      Bytes::concat_all([
        if members.len() == 0 { b"| " } else { b" | " },
        t.name,
        if row.tail_bounded { b" bounded" } else { b"" },
      ]),
    None -> b"",
  };
  Bytes::concat_all([b"{", Bytes::join(members, b", "), tail, b"}"])
}

fn atom_written(atom: AtomExpr) -> Bytes = {
  let resource = if atom.every { b"[*]" }
  else { match atom.resource { Some(r) -> Bytes::concat_all([b"[", r.name, b"]"]), None -> b"" } };
  Bytes::concat_all([
    qname_text(atom.eff),
    b".",
    match atom.op { Some(o) -> o.name, None -> mode_text(atom.mode) },
    resource,
    if atom.bounded { b" bounded" } else { b"" },
  ])
}
