//! How a function calls the function it is handed, where no clause states it yet: one entry for
//! each such function, keyed on its program-wide name, which the termination check, the checker's
//! counts and the ownership report read, and the prover's step and space readers where no `cost`
//! or `space` clause of the function states its steps or its space. An entry for a function
//! `std.prelude` writes in Ply is held to its body by this module's tests; a native's is the
//! runtime's to keep.

import syntax.patterns (PCtor, PVar, LInt)
import syntax.exprs (Expr, ELit, EVar, EBinary, EUnary, EApp, EIf, EMatch, EField, EBlock, EList,
                     EPerform, Param, MatchArm, Stmt, SLet, prelude_module)
import syntax.items (Item, IFn, IExtern, FnDef, parse)
import syntax.type_syntax (TFn)
import std.list
import std.prelude_source

/// How a function calls the function it is handed at `callback`, which takes one parameter for
/// each of `params`: at most as many times as the sizes of its arguments at `over` add up to, or
/// once where `over` is empty. A parameter handed an `Element` is handed each element of the
/// argument at `over`'s first in turn, once each, in order.
pub type Iterates = { callback: Int, over: List<Int>, params: List<Handed>, answer: Answer }

/// What a parameter of the function handed in is handed.
pub type Handed =
  /// An element of the argument at `over`'s first, which goes on holding it: a list's element, or
  /// a map's key or value.
  | Element
  /// The argument at this place on the first call, and what the call before answered on each one
  /// after it.
  | Threaded(Int)
  /// What the argument at this place holds, taken out of it for the call: held as that is.
  | Taken(Int)
  /// A number.
  | Number
  /// A value nothing is said of.
  | Unsaid

/// What the function answers.
pub type Answer =
  /// A list of what each call answered, in order.
  | Mapped
  /// A list of the elements whose call answered `true`, in order.
  | Kept
  /// What the last call answered, or the `Threaded` argument where there was none.
  | Folded
  /// The argument at this place, with what the call answered in it.
  | Updated(Int)
  /// A value nothing is said of.
  | Unstated

/// The entry for the function `name`, a program-wide name.
pub fn iterates(name: Bytes) -> Option<Iterates> = table().get(name)

/// The entry for `name`, a function of `std.prelude` named as the prelude declares it.
pub fn prelude_iterates(name: Bytes) -> Option<Iterates> = table().get(in_prelude(name))

fn in_prelude(name: Bytes) -> Bytes = Bytes::concat_all([prelude_module(), b".", name])

/// Every entry, by program-wide name. Pure and nullary, so it is made once.
fn table() -> Map<Bytes, Iterates> =
  entries().fold(Map::new(), |acc: Map<Bytes, Iterates>, e: Entry| acc.insert(e.name, e.iterates))

type Entry = { name: Bytes, iterates: Iterates }

fn entries() -> List<Entry> =
  [
    {
      name: b"std.prelude.List::map",
      iterates: { callback: 1, over: [0], params: [Element], answer: Mapped },
    },
    {
      name: b"std.prelude.List::filter",
      iterates: { callback: 1, over: [0], params: [Element], answer: Kept },
    },
    {
      name: b"std.prelude.List::fold",
      iterates: { callback: 2, over: [0], params: [Threaded(1), Element], answer: Folded },
    },
    {
      name: b"std.prelude.Map::fold",
      iterates: { callback: 2, over: [0], params: [Threaded(1), Element, Element], answer: Folded },
    },
    {
      name: b"std.prelude.Map::update",
      iterates: { callback: 2, over: [], params: [Taken(0)], answer: Updated(0) },
    },
    // `from` is never negative, so the bytes from it are no more than `b` holds.
    {
      name: b"std.prelude.Bytes::position",
      iterates: { callback: 2, over: [0], params: [Number], answer: Unstated },
    },
    {
      name: b"std.prelude.iterate",
      iterates: { callback: 2, over: [1], params: [Unsaid], answer: Unstated },
    },
    {
      name: b"std.prelude.metered",
      iterates: { callback: 0, over: [], params: [], answer: Unstated },
    },
  ]

// --- Tests ----------------------------------------------------------------------------------------

/// A declaration of the prelude: its parameters, and itself where the prelude writes its body.
type Declared = { params: List<Param>, written: Option<FnDef> }

fn prelude_items() -> List<Item> / {abort.raise} = parse(prelude_source::text()).node.items

fn declared(name: Bytes) -> Option<Declared> / {abort.raise} =
  prelude_items().fold(None, |found: Option<Declared>, item: Item|
    match found {
      Some(_) -> found,
      None -> match item {
        IFn(d) -> if d.name.name == name { Some({ params: d.params, written: Some(d) }) }
        else { None },
        IExtern(d) -> if d.name.name == name { Some({ params: d.params, written: None }) }
        else { None },
        _ -> None,
      },
    })

fn fns_of(items: List<Item>) -> Map<Bytes, FnDef> =
  items.fold(Map::new(), |acc: Map<Bytes, FnDef>, item: Item|
    match item { IFn(d) -> acc.insert(d.name.name, d), _ -> acc })

fn bare(name: Bytes) -> Bytes / {abort.raise} = name.slice(prelude_module().len() + 1, name.len())

/// How many parameters the function a parameter is written to take takes.
fn takes(p: Option<Param>) -> Option<Int> =
  match p {
    Some(x) -> match x.ty { Some(TFn(f)) -> Some(f.params.len()), _ -> None },
    None -> None,
  }

/// Every place an entry names.
fn places(i: Iterates) -> List<Int> =
  i.params.fold(i.over.push(i.callback), |acc: List<Int>, h: Handed|
    match h { Threaded(k) -> acc.push(k), Taken(k) -> acc.push(k), _ -> acc }).concat(
    match i.answer { Updated(k) -> [k], _ -> [] },
  )

test "every entry names a function the prelude declares, and a function parameter it calls" {
  entries().fold((), |u: Unit, e: Entry| {
    let i = e.iterates;
    assert_eq(in_prelude(bare(e.name)), e.name);
    match declared(bare(e.name)) {
      None ->
        panic("`" ++ String::of_bytes_lossy(e.name) ++ "` names nothing the prelude declares"),
      Some(d) -> {
        assert_eq(takes(d.params.at(i.callback)), Some(i.params.len()));
        assert(places(i).fold(true, |ok: Bool, k: Int| ok && k >= 0 && k < d.params.len()));
        assert(!i.over.contains(i.callback));
        assert(i.over.len() > 0 || !i.params.contains(Element))
      },
    }
  })
}

// An entry read off a body the prelude writes: one loop over the positions of the list's items, a
// call back on `p + 1` from 0 below the list's length, which reads the item of the leaf it carries
// at a position the trie holds and the tail's item `p - held` past them; each call back calls the
// function it is handed once, with the item it reads or the accumulator, and hands on the
// accumulator grown by what that call answered. That `ListNode::leaf_at` of the leaf the walk
// carries reads the item at `p`, and `ListNode::tail_at` the tail's item `p - held`, is the
// natives' to keep. A map's fold is one loop over its entries in key order, counting those done up
// to the map's length, and its update takes the value under the key out of its leaf, calls the
// function once on it and puts the answer back; which leaf and slot hold the next entry or the key
// is the natives' and the slot search's to keep.

fn var_name(e: Expr) -> Option<Bytes> =
  match plain(e) {
    EVar(v) -> match v.name.module { None -> Some(v.name.name.name), Some(_) -> None },
    _ -> None,
  }

fn is_var(e: Expr, name: Bytes) -> Bool = var_name(e) == Some(name)

/// `e` without the braces of a block that holds nothing else.
fn plain(e: Expr) -> Expr =
  match e {
    EBlock(b) -> match b.tail {
      Some(t) -> if b.stmts.len() == 0 { plain(t) } else { e },
      None -> e,
    },
    _ -> e,
  }

fn index_of(params: List<Param>, name: Bytes) -> Option<Int> / {abort.raise} =
  range(0, params.len()).fold(None, |found: Option<Int>, k: Int|
    match found {
      Some(_) -> found,
      None -> if params.get(k).name.name == name { Some(k) } else { None },
    })

/// The arguments of a call of `name`, written `Type::f(..)`.
fn called(e: Expr, name: Bytes) -> Option<List<Expr>> =
  match plain(e) {
    EApp(a) -> match a.func {
      EVar(v) -> if Bytes::concat_all([
            match v.name.module { Some(m) -> m.name.concat(b"::"), None -> b"" },
            v.name.name.name,
          ])
          == name { Some(a.args) }
      else { None },
      _ -> None,
    },
    _ -> None,
  }

/// What `List::push(onto, x)` pushes onto what, written either way.
fn pushed(e: Expr) -> Option<{ onto: Expr, x: Expr }> =
  match called(e, b"List::push") {
    Some([onto, x]) -> Some({ onto: onto, x: x }),
    _ -> match plain(e) {
      EApp(a) -> match ((a.func, a.args)) {
        (EField(f), [x]) -> if f.field.name == b"push" { Some({ onto: f.base, x: x }) }
        else { None },
        _ -> None,
      },
      EPerform(p) -> match p.args {
        [x] -> if p.op.name == b"push" && p.resource == None {
          Some({ onto: EVar({ span: p.span, name: p.eff }), x: x })
        } else { None },
        _ -> None,
      },
      _ -> None,
    },
  }

/// A list nothing is in yet.
fn empty_list(e: Expr) -> Bool =
  match plain(e) { EList(l) -> l.items.len() == 0, _ -> called(e, b"List::with_capacity") != None }

fn is_int(e: Expr, n: Int) -> Bool = match plain(e) { ELit(l) -> l.lit == LInt(n), _ -> false }

/// `a op b`.
fn binary(e: Expr, op: Bytes) -> Option<{ lhs: Expr, rhs: Expr }> =
  match plain(e) {
    EBinary(b) -> if b.op == op { Some({ lhs: b.lhs, rhs: b.rhs }) } else { None },
    _ -> None,
  }

/// `name + 1`.
fn next_of(e: Expr, name: Bytes) -> Bool =
  match binary(e, b"add") { Some(b) -> is_var(b.lhs, name) && is_int(b.rhs, 1), None -> false }

/// `name >= bound`, the bound.
fn at_least(e: Expr, name: Bytes) -> Option<Expr> =
  match binary(e, b"ge") {
    Some(b) -> if is_var(b.lhs, name) { Some(b.rhs) } else { None },
    None -> None,
  }

/// A call of `name` on these variables.
fn calls_on(e: Expr, name: Bytes, vars: List<Bytes>) -> Bool =
  match called(e, name) {
    Some(args) -> args.map(var_name) == vars.map(|v: Bytes| Some(v)),
    None -> false,
  }

type Uses = { calls: List<List<Expr>>, reads: Int }

/// The calls of `name` in `e`, and how many times it is read otherwise; any form this reading does
/// not take reads it.
fn uses(e: Expr, name: Bytes) -> Uses =
  match plain(e) {
    EVar(_) -> { calls: [], reads: if is_var(e, name) { 1 } else { 0 } },
    ELit(_) -> { calls: [], reads: 0 },
    EApp(a) ->
      a.args.fold(
        if is_var(a.func, name) { { calls: [a.args], reads: 0 } } else { uses(a.func, name) },
        |acc: Uses, x: Expr| both(acc, uses(x, name)),
      ),
    EField(f) -> uses(f.base, name),
    EPerform(p) ->
      p.args.fold(
        { calls: [], reads: if p.eff.module == None && p.eff.name.name == name { 1 } else { 0 } },
        |acc: Uses, x: Expr| both(acc, uses(x, name)),
      ),
    EBinary(b) -> both(uses(b.lhs, name), uses(b.rhs, name)),
    EUnary(u) -> uses(u.operand, name),
    EIf(i) -> both(uses(i.cond, name), both(uses(i.then_branch, name), uses(i.else_branch, name))),
    EMatch(m) ->
      m.arms.fold(uses(m.scrutinee, name), |acc: Uses, a: MatchArm|
        both(both(acc, uses(a.body, name)), match a.guard {
          Some(g) -> uses(g, name),
          None -> { calls: [], reads: 0 },
        })),
    EBlock(b) -> uses_in(b.stmts, b.tail, name),
    _ -> { calls: [], reads: 1 },
  }

fn both(a: Uses, b: Uses) -> Uses = { calls: a.calls.concat(b.calls), reads: a.reads + b.reads }

/// What a walk does on each call: what each parameter of the function it calls is handed, the
/// accumulator as `Threaded(0)`, and what the walk answers.
type Pass = { params: List<Handed>, answer: Answer }

/// The pass whose call back is `r.back`, a call of `walk` handed back the function at `f` in its own
/// place and the accumulator at `acc` grown; the item is what `read` tells, or `r.bound`.
fn pass(
  walk: FnDef,
  f: Int,
  acc: Int,
  r: Reading,
  read: (Expr) -> Bool,
) -> Option<Pass> / {abort.raise} = {
  let ps = walk.params;
  let fname = ps.get(f).name.name;
  let acc_name = ps.get(acc).name.name;
  let item = |x: Expr| read(x) || (r.bound != None && var_name(x) == r.bound);
  match plain(r.back) {
    EApp(b) -> if !is_var(b.func, walk.name.name) || b.args.len() != ps.len()
        || !is_var(b.args.get(f), fname) { None } else {
      let seen = range(0, ps.len()).fold({ calls: [], reads: 0 }, |u: Uses, k: Int|
        if k == f { u } else { both(u, uses(b.args.get(k), fname)) });
      match ((seen.calls, seen.reads)) {
        ([args], 0) -> {
          let call = |e: Expr|
            match plain(e) { EApp(c) -> is_var(c.func, fname) && c.args == args, _ -> false };
          let params = args.map(|x: Expr|
            if item(x) { Element } else if is_var(x, acc_name) { Threaded(0) } else { Unsaid });
          let next = b.args.get(acc);
          let answer = match pushed(next) {
            Some(p) -> if is_var(p.onto, acc_name) && call(p.x) { Some(Mapped) } else { None },
            None -> match plain(next) {
              EIf(c) -> match pushed(c.then_branch) {
                Some(p) -> if call(c.cond) && is_var(p.onto, acc_name) && item(p.x)
                    && is_var(c.else_branch, acc_name) { Some(Kept) }
                else { None },
                None -> None,
              },
              other -> if call(other) { Some(Folded) } else { None },
            },
          };
          match answer {
            None -> None,
            Some(a) -> if params.contains(Unsaid) || a == Folded != params.contains(Threaded(0)) {
              None
            } else { Some({ params: params, answer: a }) },
          }
        },
        _ -> None,
      }
    },
    _ -> None,
  }
}

/// A pass's call back, and the variable a `let` before it binds the item to.
type Reading = { back: Expr, bound: Option<Bytes> }

/// `{ let x = item; back }` or `back`, where `read` tells the item.
fn reading(body: Expr, read: (Expr) -> Bool) -> Reading =
  match plain(body) {
    EBlock(b) -> match ((b.stmts, b.tail)) {
      ([SLet(l)], Some(t)) -> match l.pat {
        PVar(v) -> if read(l.value) { { back: t, bound: Some(v.name.name) } }
        else { { back: body, bound: None } },
        _ -> { back: body, bound: None },
      },
      _ -> { back: body, bound: None },
    },
    _ -> { back: body, bound: None },
  }

/// Whether `back` calls `walk` back on the next position, with the list, where its trie starts and
/// how many items the trie holds handed on as they came.
fn steps(walk: FnDef, back: Expr) -> Bool / {abort.raise} =
  match ((walk.params, plain(back))) {
    ([xs, start, held, p, _, _, _], EApp(b)) ->
      b.args.len() == 7 && is_var(b.args.get(0), xs.name.name)
        && is_var(b.args.get(1), start.name.name)
        && is_var(b.args.get(2), held.name.name)
        && next_of(b.args.get(3), p.name.name),
    _ -> false,
  }

/// The pass of `walk`, the loop over the positions of the list's items, handed the list, where its
/// trie starts, how many items the trie holds, the position, the leaf, the function and the
/// accumulator: at a position the trie holds it reads the item of the leaf it matched and carries
/// that leaf on, and past them the tail's item, and the two make the same pass.
fn walk_pass(walk: FnDef) -> Option<Pass> / {abort.raise} =
  match walk.params {
    [xs, _, held, p, _, f, acc] -> {
      let xn = xs.name.name;
      let pn = p.name.name;
      let hn = held.name.name;
      let an = acc.name.name;
      let in_tail = |e: Expr|
        match called(e, b"ListNode::tail_at") {
          Some([l, i]) ->
            is_var(l, xn)
              && (match binary(i, b"sub") {
                Some(d) -> is_var(d.lhs, pn) && is_var(d.rhs, hn),
                None -> false,
              }),
          _ -> false,
        };
      match plain(walk.body) {
        EIf(outer) -> match ((at_least(outer.cond, pn), plain(outer.else_branch))) {
          (Some(len), EIf(inner)) -> {
            let guarded = calls_on(len, b"List::len", [xn]) && is_var(outer.then_branch, an)
              && (match at_least(inner.cond, pn) { Some(h) -> is_var(h, hn), None -> false })
              && used(walk.body, f.name.name, 2, 2);
            let tail = reading(inner.then_branch, in_tail);
            match ((guarded && steps(walk, tail.back), plain(inner.else_branch))) {
              (true, EBlock(b)) -> match ((b.stmts.last(), b.tail)) {
                (Some(SLet(l)), Some(EMatch(m))) -> match ((l.pat, m.arms)) {
                  (PVar(leaf), [some, none]) -> match some_arm(some) {
                    None -> None,
                    Some(s) -> if !is_var(m.scrutinee, leaf.name.name) || !none_arm(none, an) {
                      None
                    } else {
                      let in_leaf = |e: Expr|
                        match called(e, b"ListNode::leaf_at") {
                          Some([node, _]) -> is_var(node, s.element),
                          _ -> false,
                        };
                      let r = reading(s.body, in_leaf);
                      let carried = match plain(r.back) {
                        EApp(c) -> c.args.len() == 7 && is_var(c.args.get(4), leaf.name.name),
                        _ -> false,
                      };
                      match ((
                          steps(walk, r.back) && carried,
                          pass(walk, 5, 6, r, in_leaf),
                          pass(walk, 5, 6, tail, in_tail),
                        )) {
                        (true, Some(a), Some(t)) -> if a == t { Some(a) } else { None },
                        _ -> None,
                      }
                    },
                  },
                  _ -> None,
                },
                _ -> None,
              },
              _ -> None,
            }
          },
          _ -> None,
        },
        _ -> None,
      }
    },
    _ -> None,
  }

/// `MapNode::key(node, at)` or `MapNode::value(node, at)`, with the slot as `slot` tells.
fn reads_entry(e: Expr, node: Bytes, slot: (Expr) -> Bool) -> Bool =
  match ((called(e, b"MapNode::key"), called(e, b"MapNode::value"))) {
    (Some([x, s]), _) -> is_var(x, node) && slot(s),
    (_, Some([x, s])) -> is_var(x, node) && slot(s),
    _ -> false,
  }

/// Whether `back` calls the map walk `walk` back on its next entry: the map as it came, the leaf and
/// slot `node` and `slot` tell, and one more entry done.
fn moved(
  walk: FnDef,
  back: Expr,
  node: (Expr) -> Bool,
  slot: (Expr) -> Bool,
) -> Bool / {abort.raise} =
  match ((walk.params, plain(back))) {
    ([m, _, _, done, _, _], EApp(b)) ->
      b.args.len() == 6 && is_var(b.func, walk.name.name) && is_var(b.args.get(0), m.name.name)
        && node(b.args.get(1))
        && slot(b.args.get(2))
        && next_of(b.args.get(3), done.name.name),
    _ -> false,
  }

/// The pass of `walk`, the loop over a map's entries in key order, handed the map, the leaf, the
/// slot, how many entries are done, the accumulator and the function: below the leaf's count it
/// reads the entry at the slot and moves to the next, and past it the first entry of the leaf it
/// matched, moving to its second; both make the same pass, and it stops once every entry is done.
fn map_pass(walk: FnDef) -> Option<Pass> / {abort.raise} =
  match walk.params {
    [m, n, i, done, acc, f] -> {
      let mn = m.name.name;
      let nn = n.name.name;
      let iname = i.name.name;
      let an = acc.name.name;
      let here = |e: Expr| reads_entry(e, nn, |s: Expr| is_var(s, iname));
      match plain(walk.body) {
        EIf(outer) -> match ((at_least(outer.cond, done.name.name), plain(outer.else_branch))) {
          (Some(len), EIf(inner)) -> {
            let guarded = calls_on(len, b"Map::len", [mn]) && is_var(outer.then_branch, an)
              && (match binary(inner.cond, b"lt") {
                Some(c) -> is_var(c.lhs, iname) && calls_on(c.rhs, b"MapNode::count", [nn]),
                None -> false,
              })
              && used(walk.body, f.name.name, 2, 2);
            let on: Reading = { back: inner.then_branch, bound: None };
            let stays = moved(walk, on.back, |x: Expr| is_var(x, nn), |x: Expr| next_of(x, iname));
            match ((guarded && stays, plain(inner.else_branch))) {
              (true, EBlock(b)) -> match ((b.stmts.last(), b.tail)) {
                (Some(SLet(l)), Some(EMatch(mt))) -> match ((l.pat, mt.arms)) {
                  (PVar(next), [none, some]) -> match some_arm(some) {
                    None -> None,
                    Some(s) -> if !is_var(mt.scrutinee, next.name.name) || !none_arm(none, an) {
                      None
                    } else {
                      let first = |e: Expr| reads_entry(e, s.element, is_zero);
                      let r: Reading = { back: s.body, bound: None };
                      match ((
                          moved(walk, s.body, |x: Expr| is_var(x, s.element), |x: Expr|
                            is_int(x, 1)),
                          pass(walk, 5, 4, on, here),
                          pass(walk, 5, 4, r, first),
                        )) {
                        (true, Some(a), Some(t)) -> if a == t { Some(a) } else { None },
                        _ -> None,
                      }
                    },
                  },
                  _ -> None,
                },
                _ -> None,
              },
              _ -> None,
            }
          },
          _ -> None,
        },
        _ -> None,
      }
    },
    _ -> None,
  }

/// The entry a fold over a map's entries earns, where it answers the seed for a map with no root,
/// and otherwise enters its walk at the map's first leaf, its first slot, none done.
fn map_derived(fns: Map<Bytes, FnDef>, def: FnDef) -> Option<Iterates> / {abort.raise} =
  match plain(def.body) {
    EMatch(top) -> match ((called(top.scrutinee, b"MapNode::root"), top.arms)) {
      (Some([mx]), [none, some]) -> match ((var_name(mx), some_arm(some))) {
        (Some(mn), Some(s)) -> match plain(s.body) {
          EApp(a) -> match ((var_name(a.func), a.args)) {
            (Some(w), [m, start, i, done, init, f]) -> match ((
                fns.get(w),
                var_name(init),
                var_name(f),
              )) {
              (Some(walk), Some(seed), Some(fname)) -> {
                let entered = is_var(m, mn) && none_arm(none, seed) && is_zero(i) && is_zero(done)
                  && (match called(start, b"first_leaf") {
                    Some([r, h]) -> is_var(r, s.element) && calls_on(h, b"MapNode::height", [mn]),
                    _ -> false,
                  })
                  && used(def.body, fname, 0, 1);
                match ((
                    entered,
                    map_pass(walk),
                    index_of(def.params, mn),
                    index_of(def.params, fname),
                    index_of(def.params, seed),
                  )) {
                  (true, Some(p), Some(over), Some(callback), Some(k)) -> if p.answer != Folded {
                    None
                  } else {
                    Some({
                      callback: callback,
                      over: [over],
                      params: p.params.map(|h: Handed|
                        match h { Threaded(_) -> Threaded(k), x -> x }),
                      answer: Folded,
                    })
                  },
                  _ -> None,
                }
              },
              _ -> None,
            },
            _ -> None,
          },
          _ -> None,
        },
        _ -> None,
      },
      _ -> None,
    },
    _ -> None,
  }

/// The first `let` among `stmts` whose value calls `callee`: the name it binds and the arguments.
fn bound_by(stmts: List<Stmt>, callee: Bytes) -> Option<{ name: Bytes, args: List<Expr> }> =
  stmts.fold(None, |found: Option<{ name: Bytes, args: List<Expr> }>, s: Stmt|
    match ((found, s)) {
      (None, SLet(l)) -> match ((l.pat, called(l.value, callee))) {
        (PVar(v), Some(args)) -> Some({ name: v.name.name, args: args }),
        _ -> None,
      },
      _ -> found,
    })

/// What `let name = value` among `stmts` binds `name` to.
fn bound_to(stmts: List<Stmt>, name: Bytes) -> Option<Expr> =
  stmts.fold(None, |found: Option<Expr>, s: Stmt|
    match ((found, s)) {
      (None, SLet(l)) -> match l.pat {
        PVar(v) -> if v.name.name == name { Some(l.value) } else { None },
        _ -> None,
      },
      _ -> found,
    })

/// `base.field`.
fn field_of(e: Expr, base: Bytes, field: Bytes) -> Bool =
  match plain(e) { EField(f) -> f.field.name == field && is_var(f.base, base), _ -> false }

/// The calls of `name` in a block's statements and tail, and how many times it is read otherwise.
fn uses_in(stmts: List<Stmt>, tail: Option<Expr>, name: Bytes) -> Uses =
  stmts.fold(
    match tail { Some(t) -> uses(t, name), None -> { calls: [], reads: 0 } },
    |u: Uses, s: Stmt|
      match s {
        SLet(l) -> both(u, uses(l.value, name)),
        _ -> { calls: u.calls, reads: u.reads + 1 },
      },
  )

/// Whether `e`, every statement of its blocks and every value a `let` there binds included, calls
/// `name` exactly `calls` times and reads it otherwise exactly `reads` times.
fn used(e: Expr, name: Bytes, calls: Int, reads: Int) -> Bool = {
  let u = uses(e, name);
  u.calls.len() == calls && u.reads == reads
}

/// Whether `walk`, handed a node, its depth, a key and a function, takes the value out of the slot
/// it finds in the leaf at depth 0 and puts back in that slot what one call of the function answers
/// for it, and above the leaves takes out the kid at the slot it finds, walks it one level down and
/// puts it back there, calling the function nowhere else.
fn takes_and_puts(walk: FnDef) -> Bool =
  match ((walk.params, plain(walk.body))) {
    ([n, depth, key, f], EIf(c)) -> {
      let nn = n.name.name;
      let dn = depth.name.name;
      let fname = f.name.name;
      match ((binary(c.cond, b"le"), plain(c.then_branch), plain(c.else_branch))) {
        (Some(at), EBlock(leaf), EBlock(branch)) -> {
          let put = match ((bound_by(leaf.stmts, b"MapNode::pair_take"), leaf.tail)) {
            (Some(taken), Some(t)) -> match ((taken.args, called(t, b"MapNode::pair_put"))) {
              ([from, i], Some([into, j, k, x])) -> {
                let tn = taken.name;
                let applied = match plain(x) {
                  EApp(call) ->
                    is_var(call.func, fname)
                      && (match call.args { [v] -> field_of(v, tn, b"value"), _ -> false }),
                  _ -> false,
                };
                let u = uses_in(leaf.stmts, leaf.tail, fname);
                is_var(from, nn) && var_name(i) != None && var_name(i) == var_name(j)
                  && field_of(into, tn, b"node")
                  && field_of(k, tn, b"key")
                  && applied
                  && u.calls.len() == 1
                  && u.reads == 0
              },
              _ -> false,
            },
            _ -> false,
          };
          let down = match ((
              bound_by(branch.stmts, b"MapNode::kid_out"),
              bound_by(branch.stmts, walk.name.name),
              branch.tail,
            )) {
            (Some(out), Some(kid), Some(t)) -> match ((
                out.args,
                kid.args,
                called(t, b"MapNode::kid_back"),
              )) {
              ([from, i], [below, lower, k, g], Some([into, j, back, _, _])) -> {
                let u = uses_in(branch.stmts, branch.tail, fname);
                is_var(from, nn) && var_name(i) != None && var_name(i) == var_name(j)
                  && field_of(below, out.name, b"kid")
                  && (match binary(lower, b"sub") {
                    Some(d) -> is_var(d.lhs, dn) && is_int(d.rhs, 1),
                    None -> false,
                  })
                  && is_var(k, key.name.name)
                  && is_var(g, fname)
                  && field_of(into, out.name, b"node")
                  && is_var(back, kid.name)
                  && u.calls.len() == 0
                  && u.reads == 1
              },
              _ -> false,
            },
            _ -> false,
          };
          is_var(at.lhs, dn) && is_zero(at.rhs) && put && down && used(walk.body, fname, 1, 1)
        },
        _ -> false,
      }
    },
    _ -> false,
  }

/// The entry an update of the value under one key earns, where it answers the map as it is when the
/// key is absent, and otherwise takes the root out of the map, walks it down from the map's height,
/// and puts what the walk answers back.
fn updated_derived(fns: Map<Bytes, FnDef>, def: FnDef) -> Option<Iterates> / {abort.raise} =
  match ((def.params, plain(def.body))) {
    ([m, key, f], EIf(c)) -> {
      let mn = m.name.name;
      let fname = f.name.name;
      let absent = match plain(c.cond) {
        EUnary(u) -> u.op == b"not" && calls_on(u.operand, b"Map::contains", [mn, key.name.name]),
        _ -> false,
      };
      match ((absent && is_var(c.then_branch, mn), plain(c.else_branch))) {
        (true, EBlock(b)) -> match ((bound_by(b.stmts, b"MapNode::map_swap"), b.tail)) {
          (Some(taken), Some(EMatch(mt))) -> match ((taken.args, mt.arms)) {
            ([from, nothing, height, len], [none, some]) -> match ((
                some_arm(some),
                var_name(height),
              )) {
              (Some(s), Some(hn)) -> {
                let tn = taken.name;
                let tall = match bound_to(b.stmts, hn) {
                  Some(hv) -> calls_on(hv, b"MapNode::height", [mn]),
                  None -> false,
                };
                let empty = match ((none.guard, none.pat)) {
                  (None, PCtor(p)) ->
                    p.name.name.name == b"None" && field_of(none.body, tn, b"map"),
                  _ -> false,
                };
                let walked = |root: Expr|
                  match plain(root) {
                    EApp(w) -> match ((var_name(w.func), w.args)) {
                      (Some(wn), [r, depth, k, g]) -> match fns.get(wn) {
                        Some(walk) ->
                          is_var(r, s.element) && is_var(depth, hn) && is_var(k, key.name.name)
                            && is_var(g, fname)
                            && takes_and_puts(walk),
                        None -> false,
                      },
                      _ -> false,
                    },
                    _ -> false,
                  };
                let put_back = match plain(s.body) {
                  EField(whole) ->
                    whole.field.name == b"map"
                      && (match called(whole.base, b"MapNode::map_swap") {
                        Some([into, root, h2, l2]) ->
                          field_of(into, tn, b"map") && is_var(h2, hn)
                            && var_name(l2) == var_name(len)
                            && (match called(root, b"Some") { Some([x]) -> walked(x), _ -> false }),
                        _ -> false,
                      }),
                  _ -> false,
                };
                let out = is_var(from, mn) && is_var(nothing, b"None")
                  && field_of(mt.scrutinee, tn, b"old");
                match ((
                    out && tall && empty && put_back && used(def.body, fname, 0, 1),
                    index_of(def.params, fname),
                    index_of(def.params, mn),
                  )) {
                  (true, Some(callback), Some(at)) ->
                    Some({
                      callback: callback,
                      over: [],
                      params: [Taken(at)],
                      answer: Updated(at),
                    }),
                  _ -> None,
                }
              },
              _ -> None,
            },
            _ -> None,
          },
          _ -> None,
        },
        _ -> None,
      }
    },
    _ -> None,
  }

fn is_zero(e: Expr) -> Bool = is_int(e, 0)

/// `Some(m) -> body`: the name and the body.
fn some_arm(a: MatchArm) -> Option<{ element: Bytes, body: Expr }> =
  match ((a.guard, a.pat)) {
    (None, PCtor(c)) -> match c.args {
      [PVar(v)] -> if c.name.name.name == b"Some" { Some({ element: v.name.name, body: a.body }) }
      else { None },
      _ -> None,
    },
    _ -> None,
  }

/// `None -> acc`.
fn none_arm(a: MatchArm, acc: Bytes) -> Bool =
  match ((a.guard, a.pat)) {
    (None, PCtor(c)) -> c.name.name.name == b"None" && c.args.len() == 0 && is_var(a.body, acc),
    _ -> false,
  }

/// The entry a body the prelude writes earns, where it is one of the walks this module reads: over
/// a list's items, over a map's entries, or down a map to the value one key holds.
fn derived(fns: Map<Bytes, FnDef>, def: FnDef) -> Option<Iterates> / {abort.raise} =
  match list_derived(fns, def) {
    Some(e) -> Some(e),
    None -> match map_derived(fns, def) { Some(e) -> Some(e), None -> updated_derived(fns, def) },
  }

/// The entry a walk over a list earns, where it enters the walk with the list, where its trie
/// starts, how many items the trie holds, position 0, no leaf, the function, and an empty list or
/// the seed.
fn list_derived(fns: Map<Bytes, FnDef>, def: FnDef) -> Option<Iterates> / {abort.raise} =
  match plain(def.body) {
    EApp(a) -> match ((var_name(a.func), a.args)) {
      (Some(w), [xs, start, held, p, n, f, init]) -> match ((
          fns.get(w),
          var_name(xs),
          var_name(f),
        )) {
        (Some(walk), Some(xn), Some(fname)) -> {
          let entered = calls_on(start, b"ListNode::start", [xn]) && is_zero(p)
            && is_var(n, b"None")
            && (match binary(held, b"sub") {
              Some(h) ->
                calls_on(h.lhs, b"List::len", [xn]) && calls_on(h.rhs, b"ListNode::tail_len", [xn]),
              None -> false,
            })
            && used(def.body, fname, 0, 1);
          match ((
              entered,
              walk_pass(walk),
              index_of(def.params, xn),
              index_of(def.params, fname),
            )) {
            (true, Some(walked), Some(over), Some(callback)) -> if walked.answer == Folded {
              match var_name(init) {
                Some(seed) -> match index_of(def.params, seed) {
                  Some(k) ->
                    Some({
                      callback: callback,
                      over: [over],
                      params: walked.params.map(|h: Handed|
                        match h { Threaded(_) -> Threaded(k), x -> x }),
                      answer: Folded,
                    }),
                  None -> None,
                },
                None -> None,
              }
            } else if empty_list(init) {
              Some({
                callback: callback,
                over: [over],
                params: walked.params,
                answer: walked.answer,
              })
            } else { None },
            _ -> None,
          }
        },
        _ -> None,
      },
      _ -> None,
    },
    _ -> None,
  }

test "each entry for a function the prelude writes in Ply is what its body does" {
  let fns = fns_of(prelude_items());
  let written = entries().filter(|e: Entry|
    match declared(bare(e.name)) { Some(d) -> d.written != None, None -> false });
  assert(written.len() > 0);
  written.fold((), |u: Unit, e: Entry|
    match fns.get(bare(e.name)) {
      Some(d) -> assert_eq(derived(fns, d), Some(e.iterates)),
      None -> panic("a function the prelude writes"),
    })
}

/// The parts of a map written as the prelude's walk: what it hands on past the trie, its step there,
/// its call and its step at a position the trie holds, what it does before finding the leaf there,
/// and the position it enters at.
type MapWalk = {
  tail_next: Bytes,
  tail_step: Bytes,
  call: Bytes,
  step: Bytes,
  aside: Bytes,
  start: Bytes,
}

fn as_written() -> MapWalk =
  {
    tail_next: b"List::push(out, f(ListNode::tail_at(xs, p - held)))",
    tail_step: b"p + 1",
    call: b"f(ListNode::leaf_at(m, q & 31))",
    step: b"p + 1",
    aside: b"",
    start: b"0",
  }

fn mapped_by(w: MapWalk) -> Option<Iterates> / {abort.raise} = {
  let fns = fns_of(
    parse(
      Bytes::concat_all([
        b"fn mapped_from<a, b | e>(xs: List<a>, start: Int, held: Int, p: Int, n: Option<ListNode<a>>, f: (a) -> b / e, out: List<b>) -> List<b> / e =\n",
        b"  if p >= List::len(xs) { out } else if p >= held { mapped_from(xs, start, held, ",
        w.tail_step,
        b", n, f, ",
        w.tail_next,
        b") } else { let q = start + p; ",
        w.aside,
        b"let leaf = ListNode::leaf_of(xs, q >> 5); match leaf { Some(m) -> mapped_from(xs, start, held, ",
        w.step,
        b", leaf, f, List::push(out, ",
        w.call,
        b")), None -> out } }\n",
        b"pub fn List::map<a, b | e>(xs: List<a>, f: (a) -> b / e) -> List<b> / e =\n",
        b"  mapped_from(xs, ListNode::start(xs), List::len(xs) - ListNode::tail_len(xs), ",
        w.start,
        b", None, f, List::with_capacity(List::len(xs)))\n",
      ]),
    ).node.items,
  );
  match fns.get(b"List::map") { Some(d) -> derived(fns, d), None -> None }
}

test "a walk that skips an item, calls twice or aside, reads no item, steps past one, or starts past the first earns no entry" {
  assert_eq(mapped_by(as_written()), iterates(b"std.prelude.List::map"));
  [
    { ..as_written(), tail_next: b"out" },
    { ..as_written(), tail_next: b"List::push(out, f(ListNode::tail_at(xs, p)))" },
    { ..as_written(), tail_step: b"p + 2" },
    { ..as_written(), step: b"p + 2" },
    { ..as_written(), call: b"f(f(ListNode::leaf_at(m, q & 31)))" },
    { ..as_written(), call: b"f(ListNode::leaf_at(n, q & 31))" },
    {
      ..as_written(),
      aside: b"let _ = List::fold(xs, out, |a: List<b>, x: a| List::push(a, f(x))); ",
    },
    { ..as_written(), start: b"1" },
  ].fold((), |u: Unit, w: MapWalk| assert_eq(mapped_by(w), None))
}

/// The parts of a map's fold written as the prelude's walk: its call and step within a leaf, its
/// count's step, what it does before finding the next leaf, its call and the slot it moves to on
/// that leaf, and the slot it enters at.
type FoldWalk = {
  call: Bytes,
  step: Bytes,
  count: Bytes,
  aside: Bytes,
  next_call: Bytes,
  next_at: Bytes,
  start: Bytes,
}

fn fold_written() -> FoldWalk =
  {
    call: b"f(acc, MapNode::key(n, i), MapNode::value(n, i))",
    step: b"i + 1",
    count: b"done + 1",
    aside: b"",
    next_call: b"f(acc, MapNode::key(leaf, 0), MapNode::value(leaf, 0))",
    next_at: b"1",
    start: b"0",
  }

fn folded_by(w: FoldWalk) -> Option<Iterates> / {abort.raise} = {
  let fns = fns_of(
    parse(
      Bytes::concat_all([
        b"fn map_folded<k, v, c | e>(m: Map<k, v>, n: MapNode<k, v>, i: Int, done: Int, acc: c, f: (c, k, v) -> c / e) -> c / e =\n",
        b"  if done >= Map::len(m) { acc } else if i < MapNode::count(n) { map_folded(m, n, ",
        w.step,
        b", ",
        w.count,
        b", ",
        w.call,
        b", f) } else { ",
        w.aside,
        b"let next = match MapNode::root(m) { None -> None, Some(r) -> leaf_above(r, MapNode::height(m), node_max(n, 0)) }; match next { None -> acc, Some(leaf) -> map_folded(m, leaf, ",
        w.next_at,
        b", done + 1, ",
        w.next_call,
        b", f) } }\n",
        b"pub fn Map::fold<a, b, c | e>(m: Map<a, b>, init: c, f: (c, a, b) -> c / e) -> c / e =\n",
        b"  match MapNode::root(m) { None -> init, Some(r) -> map_folded(m, first_leaf(r, MapNode::height(m)), ",
        w.start,
        b", 0, init, f) }\n",
      ]),
    ).node.items,
  );
  match fns.get(b"Map::fold") { Some(d) -> derived(fns, d), None -> None }
}

test "a map's fold that skips an entry, calls twice or aside, reads past its entry, or starts past the first earns no entry" {
  assert_eq(folded_by(fold_written()), iterates(b"std.prelude.Map::fold"));
  [
    { ..fold_written(), step: b"i + 2" },
    { ..fold_written(), count: b"done + 2" },
    { ..fold_written(), next_at: b"2" },
    { ..fold_written(), next_call: b"acc" },
    {
      ..fold_written(),
      call: b"f(f(acc, MapNode::key(n, i), MapNode::value(n, i)), MapNode::key(n, i), MapNode::value(n, i))",
    },
    { ..fold_written(), call: b"f(acc, MapNode::key(n, i), MapNode::value(n, i + 1))" },
    {
      ..fold_written(),
      aside: b"let _ = List::fold(Map::entries(m), acc, |a: c, e: { key: k, value: v }| f(a, e.key, e.value)); ",
    },
    { ..fold_written(), start: b"1" },
  ].fold((), |u: Unit, w: FoldWalk| assert_eq(folded_by(w), None))
}

/// The parts of a map's update written as the prelude's walk: what the leaf's put answers in the
/// slot, the slot it puts it in, the depth it walks a kid at, and the depth it enters at.
type UpdateWalk = { put: Bytes, put_at: Bytes, below: Bytes, start: Bytes }

fn update_written() -> UpdateWalk =
  { put: b"f(taken.value)", put_at: b"i", below: b"depth - 1", start: b"height" }

fn updated_by(w: UpdateWalk) -> Option<Iterates> / {abort.raise} = {
  let fns = fns_of(
    parse(
      Bytes::concat_all([
        b"fn node_updated<k, v | e>(n: MapNode<k, v>, depth: Int, key: k, f: (v) -> v / e) -> MapNode<k, v> / e =\n",
        b"  if depth <= 0 { let i = leaf_place(n, key, 0, 32); let taken = MapNode::pair_take(n, i); MapNode::pair_put(taken.node, ",
        w.put_at,
        b", taken.key, ",
        w.put,
        b") } else { let i = kid_place(n, key, 0, 32); let size = MapNode::kid_size(n, i); let max = MapNode::kid_max(n, i); let out = MapNode::kid_out(n, i); let kid = node_updated(out.kid, ",
        w.below,
        b", key, f); MapNode::kid_back(out.node, i, kid, max, size) }\n",
        b"pub fn Map::update<a, b | e>(m: Map<a, b>, key: a, f: (b) -> b / e) -> Map<a, b> / e =\n",
        b"  if !Map::contains(m, key) { m } else { let height = MapNode::height(m); let len = Map::len(m); let taken = MapNode::map_swap(m, None, height, len); match taken.old { None -> taken.map, Some(root) -> MapNode::map_swap(taken.map, Some(node_updated(root, ",
        w.start,
        b", key, f)), height, len).map } }\n",
      ]),
    ).node.items,
  );
  match fns.get(b"Map::update") { Some(d) -> derived(fns, d), None -> None }
}

test "a map's update that reads the value in place, puts it elsewhere, calls twice, or walks the wrong depth earns no entry" {
  assert_eq(updated_by(update_written()), iterates(b"std.prelude.Map::update"));
  [
    { ..update_written(), put: b"f(MapNode::value(n, i))" },
    { ..update_written(), put_at: b"i + 1" },
    { ..update_written(), put: b"f(f(taken.value))" },
    { ..update_written(), below: b"depth" },
    { ..update_written(), start: b"0" },
  ].fold((), |u: Unit, w: UpdateWalk| assert_eq(updated_by(w), None))
}
