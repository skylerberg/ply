import compiler.syntax.parsing (Span, dummy_span, span_key)
import compiler.syntax.type_syntax (EffectExpression, mode_text)
import compiler.syntax.items (Item, FunctionItem, FnDefinition, ImportDeclaration, parse,
                              dump_module)
import std.list
import std.bytes (ascii_of_int)
import compiler.check.resolve.tables (Source, ParsedModule, TypeSpace, ValueSpace, Binding,
                                      ModuleBinding, Scope, Label, Diagnostic, ModuleEntry,
                                      no_declarations, lookup, find_module_binding, error_at,
                                      declarations_of, bindings_of)
import compiler.check.resolve.scopes (ScopeBuilder, ResolutionContext, PackageDependencies,
                                      no_packages, index_of, bind_import, target_or_report, Cycle,
                                      traverse, cycle_diagnostic)
import compiler.check.resolve.sets (instantiate_laws, expand_sets, concat_diagnostics)
import compiler.check.resolve.defaults (ResolvedProgram, fill_defaults)
import compiler.syntax.node_ids (numbered_module, numbered_missing)
import compiler.check.resolve.bindings (written, Written, Reference, Refers, Local, Unbound, Member,
                                        MemberKind, FieldName, RecordAt, RecordFields, TypeNamed,
                                        CalledName, ArgumentName, Definition)

pub type ResolveOutcome = | ResolveSucceeded(ResolvedProgram) | ResolveFailed(List<Diagnostic>)

pub fn resolve(sources: List<Source>) -> ResolveOutcome / {abort.raise} =
  resolve_modules(
    sources.map(|source: Source|
      { name: source.name, module: parse(source.source_text).node, derived: [] }),
  )

pub fn resolve_modules(modules: List<ParsedModule>) -> ResolveOutcome / {abort.raise} =
  resolve_with(modules, no_packages(modules))

pub fn resolve_packaged(
  modules: List<ParsedModule>,
  packages: List<PackageDependencies>,
  module_packages: List<Int>,
  std: Int,
  compiler: Int,
  shipped: Int,
) -> ResolveOutcome / {abort.raise} =
  resolve_with(modules, {
    packages: packages,
    module_packages: module_packages,
    std: std,
    compiler: compiler,
    other_shipped_package: shipped,
  })

fn resolve_with(
  written: List<ParsedModule>,
  packages: { packages: List<PackageDependencies>, module_packages: List<Int>, std: Int, compiler: Int, other_shipped_package: Int },
) -> ResolveOutcome / {abort.raise} = {
  let modules = written.map(|m: ParsedModule|
    { ..m, module: { ..m.module, items: m.module.items.map(numbered_missing) } });
  let n = modules.len();
  let indexed = range(0, n).fold(
    { names: [], diagnostics: [] },
    |accumulator: { names: List<ModuleEntry>, diagnostics: List<Diagnostic> }, i: Int| {
      let name = modules.get(i).name;
      match index_of(accumulator.names, name) {
        None -> { ..accumulator, names: accumulator.names.push({ name: name, at: i }) },
        Some(_) -> if name.len() == 0 { accumulator } else {
          {
            ..accumulator,
            diagnostics: accumulator.diagnostics.push(
              error_at(
                b"E0105",
                i,
                dummy_span(),
                Bytes::concat_all([b"two files claim the module name `", name, b"`"]),
                b"loaded a second time under this name",
                [b"one file is one module, and a module name is derived from its path"],
              ),
            ),
          }
        },
      }
    },
  );
  let declarations = modules.map(declarations_of);
  let declared = range(0, n).map(|i: Int| bindings_of(i, declarations.get(i)));
  let w = {
    modules: modules,
    names: indexed.names,
    declarations: declarations,
    declared: declared,
    packages: packages.packages,
    module_packages: packages.module_packages,
    std: packages.std,
    compiler: packages.compiler,
    shipped_package_count: packages.other_shipped_package,
  };
  let built = range(0, n).map(|i: Int| build_scope_reporting(w, i));
  let scopes = built.map(|builder: ScopeBuilder| builder.scope);
  let edges = built.map(|builder: ScopeBuilder| builder.edges);
  let diagnostics1 = built.fold(
    indexed.diagnostics,
    |accumulator: List<Diagnostic>, builder: ScopeBuilder|
      concat_diagnostics(accumulator, builder.diagnostics),
  );
  let dfs = traverse(edges);
  let diagnostics2 = dfs.cycles.fold(diagnostics1, |accumulator: List<Diagnostic>, cycle: Cycle|
    accumulator.push(cycle_diagnostic(modules, cycle)));
  if diagnostics2.len() > 0 { ResolveFailed(diagnostics2) } else {
    let r = {
      names: indexed.names,
      scopes: scopes,
      declarations: declarations,
      declared: declared,
      order: dfs.order,
      imports: edges.map(|es: List<{ from: Int, target: Int, span: Span }>|
        es.map(|e: { from: Int, target: Int, span: Span }| e.target)),
      signatures: Map::new(),
      visible_modules: [],
    };
    let instantiation = instantiate_laws(r, modules);
    let sets = expand_sets(instantiation.resolution, instantiation.modules);
    if instantiation.diagnostics.len() > 0 { ResolveFailed(instantiation.diagnostics) }
    else if sets.diagnostics.len() > 0 { ResolveFailed(sets.diagnostics) } else {
      let x = fill_defaults(sets.resolution, sets.modules, []);
      if x.diagnostics.len() > 0 { ResolveFailed(x.diagnostics) } else { ResolveSucceeded(x) }
    }
  }
}

fn build_scope_reporting(w: ResolutionContext, i: Int) -> ScopeBuilder / {abort.raise} = {
  let m = w.modules.get(i);
  let start = {
    scope: { module: m.name, modules: [], selected_modules: [], bound: w.declared.get(i) },
    local: w.declarations.get(i),
    imported: no_declarations(),
    edges: [],
    diagnostics: [],
  };
  m.module.imports.fold(start, |builder: ScopeBuilder, declaration: ImportDeclaration| {
    let t = target_or_report(w, i, builder, declaration);
    match t.t { None -> t.b, Some(_) -> bind_import(w, i, t.b, declaration) }
  })
}

fn dump_module_binding(tag: Bytes, binding: ModuleBinding) -> Bytes =
  Bytes::concat_all([
    tag,
    b";",
    binding.binder,
    b";",
    ascii_of_int(binding.target),
    b";",
    span_key(binding.span),
    b";",
  ])

fn dump_binding(tag: Bytes, binding: Binding) -> Bytes =
  Bytes::concat_all([
    tag,
    b";",
    binding.name,
    b";",
    binding.qualified,
    b";",
    ascii_of_int(binding.owner),
    b";",
    span_key(binding.span),
    b";",
  ])

fn dump_scope(i: Int, scope: Scope) -> Bytes =
  Bytes::concat_all([
    b"M;",
    ascii_of_int(i),
    b";",
    scope.module,
    b";",
    Bytes::concat_all(scope.modules.map(|mb: ModuleBinding| dump_module_binding(b"B", mb))),
    Bytes::concat_all(
      scope.selected_modules.map(|mb: ModuleBinding| dump_module_binding(b"S", mb)),
    ),
    Bytes::concat_all(scope.bound.values.map(|b: Binding| dump_binding(b"V", b))),
    Bytes::concat_all(scope.bound.types.map(|b: Binding| dump_binding(b"T", b))),
    Bytes::concat_all(scope.bound.effects.map(|b: Binding| dump_binding(b"E", b))),
    Bytes::concat_all(scope.bound.sets.map(|b: Binding| dump_binding(b"R", b))),
  ])

fn dump_order(order: List<Int>) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"O;",
    range(0, order.len()).fold(b"", |accumulator: Bytes, i: Int|
      if i == 0 { ascii_of_int(order.get(i)) }
      else { Bytes::concat_all([accumulator, b",", ascii_of_int(order.get(i))]) }),
    b";",
  ])

fn dump_label(label: Label) -> Bytes =
  Bytes::concat_all([
    b"=",
    ascii_of_int(label.module),
    b":",
    ascii_of_int(label.start),
    b":",
    ascii_of_int(label.end),
    b":",
    if label.primary { b"1" } else { b"0" },
    b";",
  ])

fn dump_diagnostic(diagnostic: Diagnostic) -> Bytes = {
  let primary = diagnostic.labels.fold(None, |accumulator: Option<Label>, l: Label|
    match accumulator { Some(_) -> accumulator, None -> if l.primary { Some(l) } else { None } });
  let head = match primary {
    Some(l) ->
      Bytes::concat_all([
        ascii_of_int(l.module),
        b":",
        ascii_of_int(l.start),
        b":",
        ascii_of_int(l.end),
      ]),
    None -> b"0:0:0",
  };
  Bytes::concat_all([
    b"!",
    diagnostic.code,
    b":",
    head,
    b":",
    ascii_of_int(diagnostic.labels.len()),
    b":",
    ascii_of_int(diagnostic.notes),
    b";",
    Bytes::concat_all(diagnostic.labels.map(dump_label)),
  ])
}

pub fn dump_diagnostics(diagnostics: List<Diagnostic>) -> Bytes =
  Bytes::concat_all([
    b"D;",
    ascii_of_int(diagnostics.len()),
    b";",
    Bytes::concat_all(diagnostics.map(dump_diagnostic)),
  ])

pub fn resolve_dump(sources: List<Source>) -> String / {abort.raise} = {
  let head = Bytes::concat_all([b"R;", ascii_of_int(sources.len()), b";"]);
  let body = match resolve(sources) {
    ResolveFailed(ds) -> b"X;".concat(dump_diagnostics(ds)),
    ResolveSucceeded(x) ->
      Bytes::concat_all([
        Bytes::concat_all(
          range(0, x.resolution.scopes.len()).map(|i: Int|
            dump_scope(i, x.resolution.scopes.get(i))),
        ),
        dump_order(x.resolution.order),
        dump_diagnostics([]),
        Bytes::concat_all(
          range(0, x.modules.len()).map(|i: Int|
            Bytes::concat_all([
              b"P;",
              ascii_of_int(i),
              b";",
              dump_module(x.modules.get(i).module),
              b"#0;",
            ])),
        ),
      ]),
  };
  String::of_bytes(head.concat(body))
}

pub fn has_error(diagnostics: List<Diagnostic>) -> Bool =
  diagnostics.fold(false, |accumulator: Bool, diagnostic: Diagnostic|
    accumulator || diagnostic.severity == b"error")

test "two modules resolve each name to the definition it names, wherever it is written" {
  let dump = resolve_dump([
    { name: b"base", source_text: b"pub fn one() -> Int = 1" },
    { name: b"app", source_text: b"import base (one)\nfn two() -> Int = one() + one()" },
  ]);
  assert(
    ["S;base;0;", "V;two;app.two;1;", "V;one;base.one;0;13:16;", "O;0,1;"].all(|fact: String|
      dump.contains(fact)),
    Some(dump),
  )
}

fn first_effects(expanded: ResolvedProgram, m: Int) -> List<Bytes> / {abort.raise} = {
  let f = expanded.modules.get(m).module.items.fold(
    None,
    |accumulator: Option<FnDefinition>, item: Item|
      match accumulator {
        Some(_) -> accumulator,
        None -> match item { FunctionItem(d) -> Some(d), _ -> None },
      },
  );
  match f {
    None -> panic("the module declares no function"),
    Some(d) -> match d.effects {
      None -> [],
      Some(r) ->
        r.listed.map(|entry: EffectExpression|
          Bytes::concat_all([
            match entry.effect_name.module { Some(b) -> b.name.concat(b"::"), None -> b"" },
            entry.effect_name.name.name,
            b".",
            match entry.operation { Some(o) -> o.name, None -> mode_text(entry.mode) },
            match entry.resource {
              Some(l) -> Bytes::concat_all([b"[", l.name, b"]"]),
              None -> b"",
            },
          ])),
    },
  }
}

fn resolve_or_panic(sources: List<Source>) -> ResolvedProgram / {abort.raise} =
  match resolve(sources) {
    ResolveSucceeded(x) -> x,
    ResolveFailed(ds) -> panic(String::of_bytes(b"rejected: ".concat(dump_diagnostics(ds)))),
  }

test "a module under `std.internal` can be imported by `std` modules, and other modules get E0159" {
  let internal = { name: b"std.internal.shared", source_text: b"pub fn one() -> Int = 1\n" };
  assert_eq(
    error_codes([
      internal,
      {
        name: b"std.user",
        source_text: b"import std.internal.shared\nfn f() -> Int = shared::one()\n",
      },
    ]),
    [],
  );
  assert_eq(
    error_codes([
      internal,
      { name: b"m", source_text: b"import std.internal.shared\nfn f() -> Int = shared::one()\n" },
    ]),
    [b"E0159"],
  )
}

fn error_codes(sources: List<Source>) -> List<Bytes> / {abort.raise} =
  match resolve(sources) {
    ResolveSucceeded(_) -> [],
    ResolveFailed(ds) -> ds.map(|diagnostic: Diagnostic| diagnostic.code),
  }

fn store_base() -> Bytes =
  b"pub effect store { read get[t](k: Int) -> Int }\npub effect set Reads = {store.read[orders], log.write}\nfn own() -> Int / {Reads} = 1\n"

test "a `pub` effect set can be imported by name or used as `module::Name`, and expands to the effects it declares" {
  let by_name = resolve_or_panic([
    { name: b"base", source_text: store_base() },
    { name: b"app", source_text: b"import base (Reads)\nfn f() -> Int / {Reads} = 1" },
  ]);
  assert_eq(first_effects(by_name, 0), [b"store.read[orders]", b"log.write"]);
  assert_eq(first_effects(by_name, 1), [b"@base::store.read[orders]", b"log.write"]);
  assert(find_module_binding(by_name.resolution.scopes.get(1).modules, b"@base") != None);
  let through = resolve_or_panic([
    { name: b"base", source_text: store_base() },
    { name: b"app", source_text: b"import base\nfn f() -> Int / {base::Reads} = 1" },
  ]);
  assert_eq(first_effects(through, 1), [b"@base::store.read[orders]", b"log.write"])
}

test "an effect set that includes an imported effect set can itself be imported, and a function using it gets all the effects" {
  let x = resolve_or_panic([
    { name: b"base", source_text: store_base() },
    { name: b"mid", source_text: b"import base (Reads)\npub effect set All = {Reads, clock.read}" },
    { name: b"app", source_text: b"import mid (All)\nfn f() -> Int / {All} = 1" },
  ]);
  assert_eq(first_effects(x, 2), [b"@base::store.read[orders]", b"clock.read", b"log.write"])
}

test "an effect set is rejected when it is undeclared, private to its module, or defined in terms of itself" {
  assert_eq(error_codes([{ name: b"app", source_text: b"fn f() -> Int / {Nope} = 1" }]), [
    b"E0114",
  ]);
  let hidden = b"effect set Hidden = {log.write}\n";
  assert_eq(
    error_codes([
      { name: b"base", source_text: hidden },
      { name: b"app", source_text: b"import base\nfn f() -> Int / {base::Hidden} = 1" },
    ]),
    [b"E0107"],
  );
  assert_eq(
    error_codes([
      { name: b"base", source_text: hidden },
      { name: b"app", source_text: b"import base (Hidden)\nfn f() -> Int = 1" },
    ]),
    [b"E0107"],
  );
  assert_eq(
    error_codes([
      {
        name: b"app",
        source_text: b"effect set A = {B}\neffect set B = {A}\nfn f() -> Int / {A} = 1",
      },
    ]),
    [b"E0115"],
  );
  assert_eq(
    error_codes([
      {
        name: b"app",
        source_text: b"effect set A = {log.write}\neffect set A = {clock.read}\nfn f() -> Int = 1",
      },
    ]),
    [b"E0105"],
  )
}

fn lib_and_app(lib: Bytes, app: Bytes) -> List<Source> =
  [{ name: b"lib", source_text: lib }, { name: b"app", source_text: app }]

test "a missing module, an import cycle and two modules of one name are rejected" {
  assert_eq(
    error_codes([
      { name: b"app", source_text: b"import nowhere\nimport std.nowhere\nfn f() -> Int = 1" },
    ]),
    [b"E0106", b"E0106"],
  );
  assert_eq(error_codes([{ name: b"me", source_text: b"import me\nfn f() -> Int = 1" }]), [
    b"E0109",
  ]);
  assert_eq(
    error_codes([
      { name: b"a", source_text: b"import b\npub fn fa() -> Int = 1" },
      { name: b"b", source_text: b"import c\npub fn fb() -> Int = 1" },
      { name: b"c", source_text: b"import a\npub fn fc() -> Int = 1" },
    ]),
    [b"E0109"],
  );
  assert_eq(
    error_codes([
      { name: b"twin", source_text: b"pub fn x() -> Int = 1" },
      { name: b"twin", source_text: b"pub fn y() -> Int = 2" },
    ]),
    [b"E0105"],
  )
}

test "an imported name is rejected when it is private or missing in its module, or when the importing module already declares or imports that name" {
  assert_eq(
    error_codes(
      lib_and_app(
        b"fn secret() -> Int = 1\npub fn shown() -> Int = 2",
        b"import lib (secret, shown, absent)\nfn f() -> Int = shown()",
      ),
    ),
    [b"E0107", b"E0101"],
  );
  assert_eq(
    error_codes(
      lib_and_app(
        b"type Hidden = | H1 | H2\npub type Shown = | S1 | S2",
        b"import lib (H1, S1)\nfn f() -> Int = 1",
      ),
    ),
    [b"E0107"],
  );
  assert_eq(
    error_codes(
      lib_and_app(
        b"pub fn place() -> Int = 1\npub type Order = { id: Int }",
        b"import lib (place, Order)\nfn place() -> Int = 2\ntype Order = { id: Bytes }\nfn f() -> Int = place()",
      ),
    ),
    [b"E0108", b"E0108"],
  );
  assert_eq(
    error_codes(
      lib_and_app(
        b"pub fn a() -> Int = 1",
        b"import lib\nimport lib\nimport lib as lib\nfn f() -> Int = lib::a()",
      ),
    ),
    [b"E0110", b"E0110"],
  );
  assert_eq(
    error_codes([
      { name: b"lib", source_text: b"pub fn a() -> Int = 1" },
      { name: b"other", source_text: b"pub fn a() -> Int = 2" },
      { name: b"app", source_text: b"import lib (a)\nimport other (a)\nfn f() -> Int = a()" },
    ]),
    [b"E0110"],
  )
}

test "an opaque sum's constructors stay with its module: the type is imported, and they are not" {
  let lib = b"pub opaque type Tok = | Mint(Int) | Tok\npub fn mint() -> Tok = Mint(1)\npub fn spent(t: Tok) -> Bool = match t { Tok -> true, Mint(_) -> false }";
  let named = match resolve(lib_and_app(lib, b"import lib (Mint)\nfn f() -> Int = 1")) {
    ResolveSucceeded(_) -> [],
    ResolveFailed(ds) -> ds,
  };
  assert_eq(
    named.map(|diagnostic: Diagnostic| { code: diagnostic.code, notes: diagnostic.notes_text }),
    [
      {
        code: b"E0107",
        notes: [
          b"`lib` returns values of this type from `mint`",
          b"`lib` takes values of this type in `spent`",
        ],
      },
    ],
  );
  match resolve(lib_and_app(lib, b"import lib (Tok, mint)\nfn f() -> Tok = mint()")) {
    ResolveSucceeded(x) -> {
      let bound = x.resolution.scopes.get(1).bound;
      assert(lookup(bound, TypeSpace, b"Tok") != None);
      assert_eq(lookup(bound, ValueSpace, b"Tok"), None)
    },
    ResolveFailed(ds) -> panic("a public type is imported"),
  }
}

test "a module can be imported with `import base` and with `import base (one, Shape)` together, and importing a sum type also imports its constructors" {
  assert_eq(
    error_codes([
      {
        name: b"base",
        source_text: b"pub fn one() -> Int = 1\npub type Shape = | Circle(Int) | Square(Int)\npub effect log { write emit(Bytes) -> Unit }\nfn hidden() -> Int = 2",
      },
      {
        name: b"app",
        source_text: b"import base\nimport base (one, Shape, log)\nfn two() -> Int = one() + base::one()\nfn s(x: Shape) -> Int = match x { Circle(r) -> r, Square(w) -> w }",
      },
    ]),
    [],
  )
}

test "an effect operation rejects named arguments, but a method call on a local value accepts them" {
  assert_eq(
    error_codes([
      {
        name: b"m",
        source_text: b"effect d { read op(k: Int) -> Int }\nfn f() -> Int / {d.op} = d.op(k: 1)",
      },
    ]),
    [b"E0123"],
  );
  assert_eq(error_codes([{ name: b"m", source_text: b"fn f(d: Int) -> Int = d.op(k: 1)" }]), [])
}

fn defaults_lib() -> Bytes =
  b"pub type Mode = | Fast | Slow\npub fn greet(name: Bytes = b\"world\", times: Int = 1) -> Bytes = name\npub fn run(m: Mode = Fast, n: Int = 0) -> Int = n\npub fn scale(v: Int, by: Int = 2) -> Int = v * by"

test "a call may omit parameters that have defaults, and a local variable named like a function shadows that function" {
  assert_eq(
    error_codes(
      lib_and_app(
        defaults_lib(),
        b"import lib (greet, scale, run)\nfn a() -> Bytes = greet()\nfn b() -> Bytes = greet(b\"x\")\nfn c() -> Bytes = greet(times: 2)\nfn d() -> Bytes = greet(b\"x\", times: 2)\nfn e() -> Bytes = greet(times: 2, name: b\"y\")\nfn f() -> Int = scale(2)\nfn h() -> Int = run()\nfn i() -> Int = run(n: 4)\nfn j() -> Bool = assert(true)\nfn k() -> Int = { let greet = |x: Int| x; greet(1) }\nfn l() -> Int = { let run = 3; run }",
      ),
    ),
    [],
  )
}

test "a named argument is rejected when it matches no parameter, repeats a parameter, or leaves a required parameter unfilled" {
  assert_eq(
    error_codes(
      lib_and_app(defaults_lib(), b"import lib (greet)\nfn e() -> Bytes = greet(nope: 1)"),
    ),
    [b"E0123"],
  );
  assert_eq(
    error_codes(
      lib_and_app(
        defaults_lib(),
        b"import lib (greet)\nfn d() -> Bytes = greet(b\"x\", times: 2, name: b\"y\")",
      ),
    ),
    [b"E0123"],
  );
  assert_eq(
    error_codes(lib_and_app(defaults_lib(), b"import lib (scale)\nfn g() -> Int = scale(by: 3)")),
    [b"E0125"],
  );
  assert_eq(
    error_codes(
      lib_and_app(
        defaults_lib(),
        b"import lib (scale)\nfn h() -> Int = scale(2, 3, 4)\nfn k() -> Int = Some(x: 1)\nfn j() -> Int = { let scale = |x: Int| x; scale(x: 1) }",
      ),
    ),
    [b"E0123", b"E0123"],
  )
}

test "a default argument is rejected when it calls a function, uses another parameter, or uses a private name of its module" {
  assert_eq(
    error_codes(
      lib_and_app(
        b"pub fn f(n: Int = g(1)) -> Int = n\npub fn g(n: Int) -> Int = n",
        b"import lib (f)\nfn a() -> Int = f()",
      ),
    ),
    [b"E0121"],
  );
  assert_eq(
    error_codes(
      lib_and_app(
        b"pub fn h(n: Int, m: Int = n) -> Int = m",
        b"import lib (h)\nfn b() -> Int = h(1)",
      ),
    ),
    [b"E0121"],
  );
  assert_eq(
    error_codes(
      lib_and_app(
        b"fn helper() -> Int = 3\npub fn leaky(n: Int = helper) -> Int = n",
        b"import lib (leaky)\nfn a() -> Int = leaky()",
      ),
    ),
    [b"E0122"],
  )
}

fn references_of(source: Bytes) -> List<Reference> / {abort.raise} = references_beside(source, [])

fn references_beside(source: Bytes, others: List<Source>) -> List<Reference> / {abort.raise} =
  written_beside(source, others).fold([], |accumulator: List<Reference>, w: Written|
    accumulator.concat(w.references))

fn written_beside(source: Bytes, others: List<Source>) -> List<Written> / {abort.raise} =
  match resolve(others.push({ name: b"m", source_text: source })) {
    ResolveFailed(_) -> panic("a source the test wrote does not resolve"),
    ResolveSucceeded(y) -> {
      let at = range(0, y.modules.len()).find(|i: Int| y.modules.get(i).name == b"m").unwrap_or(0);
      written(y.resolution, at, numbered_module(parse(source).node))
    },
  }

fn place(source: Bytes, text: Bytes, n: Int) -> Int / {abort.raise} =
  range(0, n).fold(source.index_of(text).unwrap_or(-1), |from: Int, k: Int|
    source.index_of_from(text, from + 1).unwrap_or(-1))

fn refers_at(
  refs: List<Reference>,
  source: Bytes,
  text: Bytes,
  n: Int,
) -> Option<Refers> / {abort.raise} = {
  let at = place(source, text, n);
  refs.find(|r: Reference| r.start == at && r.name == text).map(|r: Reference| r.target)
}

test "a local shadows another, and each use refers to the binder in scope where it is written" {
  let source = b"fn f(x: Int) -> Int = { let y = x; let x = y + 1; x }\n\nfn g() -> Int = f(1)\n";
  let refs = references_of(source);
  assert_eq(refers_at(refs, source, b"x", 1), refers_at(refs, source, b"x", 0));
  assert_eq(refers_at(refs, source, b"x", 3), refers_at(refs, source, b"x", 2));
  assert(refers_at(refs, source, b"x", 3) != refers_at(refs, source, b"x", 0));
  let fs = refs.filter(|r: Reference| r.name == b"f").map(|r: Reference| r.target);
  assert_eq(fs.len(), 2);
  assert_eq(fs.get(1), fs.get(0))
}

test "a record field name does not refer to a local of the same name, but the shorthand field `{ held }` in a pattern binds a local" {
  let source = b"type R = { held: Int }\n\nfn f(held: Int) -> R = { held: held }\n\nfn g(r: R) -> Int = match r { { held } -> held }\n\nfn h(r: R) -> Int = r.held\n";
  let refs = references_of(source);
  assert_eq(refers_at(refs, source, b"held", 0), None);
  assert_eq(refers_at(refs, source, b"held", 2), None);
  assert_eq(refers_at(refs, source, b"held", 3), refers_at(refs, source, b"held", 1));
  let shorthand = refs.find(|r: Reference| r.start == place(source, b"held", 4));
  assert_eq(shorthand.map(|r: Reference| r.shorthand), Some(true));
  assert_eq(refers_at(refs, source, b"held", 5), refers_at(refs, source, b"held", 4));
  assert_eq(refers_at(refs, source, b"held", 6), None)
}

test "a record's shorthand field `{ held }` reads the local of that name, and `T::name` refers to the type `T`" {
  let source = b"type R = { held: Int, kept: Int }\n\nfn R::made(held: Int) -> R = { held, kept: held }\n\nfn f() -> R = R::made(1)\n";
  let refs = references_of(source);
  let shorthand = refs.find(|r: Reference| r.start == place(source, b"held", 2));
  assert_eq(shorthand.map(|r: Reference| r.shorthand), Some(true));
  assert_eq(refers_at(refs, source, b"held", 2), refers_at(refs, source, b"held", 1));
  assert_eq(refers_at(refs, source, b"R", 4), refers_at(refs, source, b"R", 0));
  let declared = refs.find(|r: Reference| r.name == b"R::made").map(|r: Reference| r.target);
  assert(declared != None);
  assert_eq(refers_at(refs, source, b"made", 1), declared)
}

test "the resolver labels a record field, a method name in a call and a named argument as different things, each with its own target" {
  let source = b"type R = { held: Int }\n\ntype N = new { held: Int }\n\nfn R::grown(r: R, by: Int) -> R = { held: r.held + by }\n\nfn f(r: R) -> R = r.grown(by: 2)\n\nfn g(r: R) -> R = R::grown(r, by: 1)\n";
  let members = written_beside(source, []).fold([], |accumulator: List<Member>, w: Written|
    accumulator.concat(w.members));
  let kind_at = |text: Bytes, n: Int|
    members.find(|m: Member| m.start == place(source, text, n)).map(|m: Member| m.kind);
  let checked = |kind: Option<MemberKind>|
    match kind { Some(FieldName(RecordAt(_))) -> true, _ -> false };
  assert_eq(kind_at(b"held", 0), Some(FieldName(RecordFields([b"held"]))));
  assert_eq(kind_at(b"held", 1), Some(FieldName(TypeNamed(b"m.N"))));
  assert(checked(kind_at(b"held", 2)));
  assert(checked(kind_at(b"held", 3)));
  assert(match kind_at(b"grown", 1) { Some(CalledName(_)) -> true, _ -> false });
  assert(match kind_at(b"by", 2) { Some(ArgumentName(a)) -> a.callee == Unbound, _ -> false });
  assert(match kind_at(b"by", 3) {
    Some(ArgumentName(a)) -> match a.callee {
      Definition(d) -> d.qualified == b"m.R::grown",
      _ -> false,
    },
    _ -> false,
  })
}

test "tuple elements are not treated as named fields, and tuples create no shorthand field references" {
  let source = b"fn f(a: Int, b: Int) -> (Int, Int) = (a, b)\n\nfn g(p: (Int, Int)) -> Int = match p { (x, y) -> x + y }\n";
  let written = written_beside(source, []);
  let members = written.fold([], |accumulator: List<Member>, w: Written|
    accumulator.concat(w.members));
  let refs = written.fold([], |accumulator: List<Reference>, w: Written|
    accumulator.concat(w.references));
  assert_eq(members.filter(|m: Member| m.name.starts_with(b"_")).len(), 0);
  assert(!refs.any(|r: Reference| r.shorthand));
  assert_eq(refers_at(refs, source, b"a", 1), refers_at(refs, source, b"a", 0));
  assert_eq(refers_at(refs, source, b"x", 1), refers_at(refs, source, b"x", 0))
}

test "in a `key for` declaration, an effect set and an operation, each name refers to the type, function or operation it names, and a parameter name refers to a local" {
  let source = b"effect tally {\n  write count(amount: Int) -> Unit\n}\n\neffect set Counting = {tally.count}\n\ntype Money = { cents: Int }\n\nfn cents_of(m: Money) -> Int = m.cents\n\nkey for Money by cents_of\n";
  let refs = references_of(source);
  assert_eq(refers_at(refs, source, b"Money", 2), refers_at(refs, source, b"Money", 0));
  assert_eq(refers_at(refs, source, b"cents_of", 1), refers_at(refs, source, b"cents_of", 0));
  assert_eq(refers_at(refs, source, b"count", 1), refers_at(refs, source, b"count", 0));
  assert(match refers_at(refs, source, b"amount", 0) { Some(Local(_)) -> true, _ -> false });
  assert(refs.all(|r: Reference| r.identifier_id != 0))
}

test "a type and a variant with the same name refer to different declarations depending on where each is used" {
  let source = b"type Taken = { x: Int }\n\ntype Left = | Taken | Other\n\nfn f(t: Taken) -> Left = Taken\n";
  let refs = references_of(source);
  let as_type = refers_at(refs, source, b"Taken", 2);
  let as_variant = refers_at(refs, source, b"Taken", 3);
  assert_eq(as_type, refers_at(refs, source, b"Taken", 0));
  assert_eq(as_variant, refers_at(refs, source, b"Taken", 1));
  assert(as_type != as_variant)
}

test "a handler's variable, parameter and operation each refer to what declares them" {
  let source = b"effect tally {\n  write count(n: Int) -> Unit\n}\n\nfn f() -> Int = handle {\n  tally.count(2);\n  0\n} with {\n  var total = 0,\n  var twice = total * 2,\n  tally.count(amount) -> {\n    total = total + amount;\n  },\n  return v -> v + total,\n}\n";
  let refs = references_of(source);
  assert_eq(refers_at(refs, source, b"count", 1), refers_at(refs, source, b"count", 0));
  assert_eq(refers_at(refs, source, b"count", 2), refers_at(refs, source, b"count", 0));
  let total = refers_at(refs, source, b"total", 0);
  assert_eq(refers_at(refs, source, b"total", 1), total);
  assert_eq(refers_at(refs, source, b"total", 2), total);
  assert_eq(refers_at(refs, source, b"total", 3), total);
  assert_eq(refers_at(refs, source, b"total", 4), total);
  assert_eq(refers_at(refs, source, b"amount", 1), refers_at(refs, source, b"amount", 0))
}

test "names in an or-pattern refer to the first alternative's names, and `xs.len()` refers to the local `xs`" {
  let source = b"type T = | A(Int) | B(Int)\n\nfn f(t: T, xs: List<Int>) -> Int = match t {\n  A(value) | B(value) -> value + xs.len(),\n}\n";
  let refs = references_of(source);
  assert_eq(refers_at(refs, source, b"value", 1), refers_at(refs, source, b"value", 0));
  assert_eq(refers_at(refs, source, b"value", 2), refers_at(refs, source, b"value", 0));
  assert_eq(refers_at(refs, source, b"xs", 1), refers_at(refs, source, b"xs", 0))
}

test "`ensures` can use `result`, and a `cost` clause can use the cost name that a parameter's function type declares" {
  let source = b"fn f(g: (Int) -> Int cost k, limit: Int = 3) -> Int\n  ensures result >= limit\n  cost k\n= g(limit)\n";
  let refs = references_of(source);
  assert_eq(refers_at(refs, source, b"limit", 1), refers_at(refs, source, b"limit", 0));
  assert_eq(refers_at(refs, source, b"limit", 2), refers_at(refs, source, b"limit", 0));
  assert(match refers_at(refs, source, b"result", 0) { Some(Local(_)) -> true, _ -> false });
  assert_eq(refers_at(refs, source, b"k", 1), refers_at(refs, source, b"k", 0))
}

test "in a test over cases, the case variable used in the body and in the label refers to the variable the test declares" {
  let cases = b"pub type Table<a> = List<a>\n\npub fn chosen<a>(table: List<a>, at: Int, wanted: Bytes) -> a = table.get(at)\n\npub fn listed<a>(table: List<a>, label: (a) -> String) -> List<String> = table.map(label)\n";
  let source = b"test \"case {item}\" for item: Int in [1, 2] { assert(item > 0) }\n";
  let show = b"pub fn display<a>(value: a) -> String = \"\"\n";
  let refs = references_beside(source, [
    { name: b"std.cases", source_text: cases },
    { name: b"std.show", source_text: show },
  ]);
  let binder = refers_at(refs, source, b"item", 1);
  assert(match binder { Some(Local(_)) -> true, _ -> false });
  assert_eq(refers_at(refs, source, b"item", 0), binder);
  assert_eq(refers_at(refs, source, b"item", 2), binder);
  assert_eq(refs.filter(|r: Reference| r.name == b"item").len(), 3)
}

test "each name used in an item is recorded as its own reference with a nonzero identifier id" {
  let source = b"effect tally {\n  write count(n: Int) -> Unit\n}\n\ntype Shape = | Dot | Box(Int)\n\nfn area(s: Shape) -> Int / {tally.count} = match s {\n  Dot -> 0,\n  Box(side) -> { tally.count(side); side * side },\n}\n";
  let refs = references_of(source);
  assert(refs.len() > 8);
  assert(refs.all(|r: Reference| r.identifier_id != 0))
}
