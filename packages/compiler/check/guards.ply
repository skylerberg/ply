import compiler.syntax.parsing (QName, Span, is_bare, qualified_name_text)
import compiler.syntax.expressions (Expression, LiteralExpression, NameExpression, BinaryExpression,
                                    UnaryExpression, CallExpression, FieldExpression,
                                    BlockExpression, PerformExpression)
import compiler.syntax.patterns (Pattern, PatternLiteral, PatternRange, PatternConstructor,
                                 PatternList, PatternOr, LiteralInt, LiteralBool, LiteralString,
                                 LiteralBytes, LiteralEmbedded)
import compiler.check.types (Type, record_fields, field_get)
import compiler.check.known (is_int, some_constructor)
import std.bytes (ascii_of_int)
import std.list
import std.math (gcd, pow)

pub type Scaled = { term: Int, by: Int }

pub type Linear = { terms: List<Scaled>, k: Int }

pub type SymbolicValue = | Number(Linear) | Keyed(Bytes) | UnknownValue

type Rule =
  | Implied({ when: List<Linear>, then: Linear })
  | Bitwise({ term: Int, x: Linear, y: Linear })

type EnsuredResult = { term: Int, fact: Linear }

pub type Guards = {
  terms: Map<Bytes, Int>,
  bound: Map<Int, SymbolicValue>,
  always: List<Linear>,
  rules: List<Rule>,
  results: List<EnsuredResult>,
  assumed: List<Linear>,
  nonzero: List<Linear>,
  returned_terms: List<Int>,
  ranged: Option<{ lo: Linear, hi: Linear }>,
}

pub type Clause = { condition: Expression, text: Bytes }

pub type Contract = {
  params: List<Bytes>,
  requires: List<Clause>,
  ensures: List<Clause>,
  raises: Bool,
  pure: Bool,
  returns_int: Bool,
  number_like_param: Option<Int>,
}

pub type Named = | Local({ binder: Int, ty: Type }) | Given(SymbolicValue) | Elsewhere

pub type Reader = {
  name: (QName) -> Named / {abort.raise},
  head: (Type) -> Type / {abort.raise},
  builtin: (Expression) -> Bytes / {abort.raise},
  on_value: (Span) -> Bytes / {abort.raise},
  contract: (Bytes) -> Option<Contract> / {abort.raise},
}

pub type ReadResult = { guards: Guards, value: SymbolicValue }

pub const no_guards: Guards =
  {
    terms: Map::new(),
    bound: Map::new(),
    always: [],
    rules: [],
    results: [],
    assumed: [],
    nonzero: [],
    returned_terms: [],
    ranged: None,
  }

pub fn restore_assumptions(now: Guards, before: Guards) -> Guards =
  {
    ..now,
    assumed: before.assumed,
    nonzero: before.nonzero,
    returned_terms: before.returned_terms,
    ranged: None,
  }

const limit: Int = 4611686018427387904

fn within(n: Int) -> Bool = n > 0 - limit && n < limit

fn constant(k: Int) -> Linear = { terms: [], k: k }

fn of_term(term: Int) -> Linear = { terms: [{ term: term, by: 1 }], k: 0 }

type Placing = { out: List<Scaled>, done: Bool, ok: Bool }

fn with_term(terms: List<Scaled>, term: Int, by: Int) -> Option<List<Scaled>> = {
  let placed = terms.fold({ out: [], done: false, ok: true }, |accumulator: Placing, x: Scaled|
    if accumulator.done || x.term < term { { ..accumulator, out: accumulator.out.push(x) } }
    else if x.term == term {
      match checked_add(x.by, by) {
        Some(n) -> if !within(n) { { ..accumulator, ok: false } } else {
          {
            out: if n == 0 { accumulator.out } else { accumulator.out.push({ term: term, by: n }) },
            done: true,
            ok: accumulator.ok,
          }
        },
        None -> { ..accumulator, ok: false },
      }
    } else {
      { out: accumulator.out.push({ term: term, by: by }).push(x), done: true, ok: accumulator.ok }
    });
  if !placed.ok { None }
  else if placed.done { Some(placed.out) }
  else { Some(placed.out.push({ term: term, by: by })) }
}

fn plus(a: Linear, b: Linear, by: Int) -> Option<Linear> =
  if by == 0 { Some(a) } else {
    match checked_mul(b.k, by) {
      None -> None,
      Some(scaled) -> match checked_add(a.k, scaled) {
        None -> None,
        Some(k) -> if !within(k) { None } else {
          let terms = b.terms.fold(Some(a.terms), |accumulator: Option<List<Scaled>>, x: Scaled|
            match accumulator {
              None -> None,
              Some(ts) -> match checked_mul(x.by, by) {
                Some(n) -> if within(n) { with_term(ts, x.term, n) } else { None },
                None -> None,
              },
            });
          match terms { Some(ts) -> Some({ terms: ts, k: k }), None -> None }
        },
      },
    }
  }

fn times(a: Linear, by: Int) -> Option<Linear> =
  if by == 0 { Some(constant(0)) } else { plus(constant(0), a, by) }

fn strictly_positive(l: Linear) -> Option<Linear> = plus(l, constant(1), 0 - 1)

fn negation(l: Linear) -> Option<Linear> = plus(constant(0 - 1), l, 0 - 1)

fn floor_div(n: Int, d: Int) -> Int / {abort.raise} = if n % d < 0 { n / d - 1 } else { n / d }

fn tightened(l: Linear) -> Linear / {abort.raise} = {
  let g = l.terms.fold(0, |accumulator: Int, x: Scaled| gcd(accumulator, x.by));
  if g <= 1 { l }
  else { { terms: l.terms.map(|x: Scaled| { term: x.term, by: x.by / g }), k: floor_div(l.k, g) } }
}

fn coefficient(l: Linear, term: Int) -> Int =
  l.terms.fold(0, |accumulator: Int, x: Scaled| if x.term == term { x.by } else { accumulator })

fn refuted(l: Linear) -> Bool = l.terms.len() == 0 && l.k < 0

const max_inequalities: Int = 96

const max_eliminations: Int = 12

fn unsatisfiable(facts: List<Linear>, fuel: Int) -> Bool / {abort.raise} =
  if facts.fold(false, |no: Bool, l: Linear| no || refuted(l)) { true }
  else if fuel <= 0 || facts.len() > max_inequalities { false } else {
    match term_to_eliminate(facts) {
      None -> false,
      Some(term) -> unsatisfiable(eliminated(facts, term), fuel - 1),
    }
  }

fn term_to_eliminate(facts: List<Linear>) -> Option<Int> = {
  let terms = facts.fold([], |accumulator: List<Int>, l: Linear|
    l.terms.fold(accumulator, |a: List<Int>, x: Scaled| a.push_unique(x.term)));
  terms.fold(
    { best: None, cost: 0 },
    |accumulator: { best: Option<Int>, cost: Int }, term: Int| {
      let cost = facts.count(|l: Linear| coefficient(l, term) > 0)
        * facts.count(|l: Linear| coefficient(l, term) < 0);
      if accumulator.best == None || cost < accumulator.cost { { best: Some(term), cost: cost } }
      else { accumulator }
    },
  ).best
}

fn eliminated(facts: List<Linear>, term: Int) -> List<Linear> / {abort.raise} = {
  let above = facts.filter(|l: Linear| coefficient(l, term) > 0);
  let under = facts.filter(|l: Linear| coefficient(l, term) < 0);
  above.fold(
    facts.filter(|l: Linear| coefficient(l, term) == 0),
    |accumulator: List<Linear>, p: Linear|
      under.fold(accumulator, |a: List<Linear>, n: Linear|
        match cancel_term(p, n, term) { Some(l) -> a.push(l), None -> a }),
  )
}

fn cancel_term(p: Linear, n: Linear, term: Int) -> Option<Linear> / {abort.raise} =
  match times(p, 0 - coefficient(n, term)) {
    None -> None,
    Some(scaled) -> match plus(scaled, n, coefficient(p, term)) {
      Some(l) -> Some(tightened(l)),
      None -> None,
    },
  }

fn impossible(facts: List<Linear>, apart: List<Linear>, splits: Int) -> Bool / {abort.raise} =
  if unsatisfiable(facts, max_eliminations) { true }
  else if splits <= 0 { false } else {
    range(0, apart.len()).fold(false, |done: Bool, i: Int|
      done
        || (match apart.at(i) {
          None -> false,
          Some(d) -> {
            let rest = range(0, apart.len()).fold([], |accumulator: List<Linear>, j: Int|
              match apart.at(j) {
                Some(x) -> if j == i { accumulator } else { accumulator.push(x) },
                None -> accumulator,
              });
            one_side(facts, rest, d, 1, splits) && one_side(facts, rest, d, 0 - 1, splits)
          },
        }))
  }

fn one_side(
  facts: List<Linear>,
  rest: List<Linear>,
  d: Linear,
  side: Int,
  splits: Int,
) -> Bool / {abort.raise} =
  if splits <= 0 { false } else {
    match plus(constant(0 - 1), d, side) {
      Some(l) -> impossible(facts.push(l), rest, splits - 1),
      None -> false,
    }
  }

fn terms_of(l: Linear) -> List<Int> = l.terms.map(|x: Scaled| x.term)

fn rule_terms(r: Rule) -> List<Int> =
  match r {
    Implied(i) ->
      i.when.fold(terms_of(i.then), |accumulator: List<Int>, w: Linear|
        w.terms.fold(accumulator, |a: List<Int>, x: Scaled| a.push_unique(x.term))),
    Bitwise(j) -> terms_of(j.x).concat(terms_of(j.y)).push(j.term),
  }

fn connected_terms(edges: List<List<Int>>, terms: List<Int>, fuel: Int) -> List<Int> = {
  let grown = edges.fold(terms, |accumulator: List<Int>, edge: List<Int>|
    if edge.any(|t: Int| accumulator.contains(t)) {
      edge.fold(accumulator, |a: List<Int>, t: Int| a.push_unique(t))
    } else { accumulator });
  if fuel <= 0 || grown.len() == terms.len() { grown }
  else { connected_terms(edges, grown, fuel - 1) }
}

fn least(facts: List<Linear>, term: Int) -> Option<Int> =
  facts.fold(None, |accumulator: Option<Int>, l: Linear|
    match l.terms {
      [x] -> if x.term != term || x.by != 1 { accumulator }
      else { match accumulator { Some(n) -> Some(max(n, 0 - l.k)), None -> Some(0 - l.k) } },
      _ -> accumulator,
    })

fn most(facts: List<Linear>, term: Int) -> Option<Int> =
  facts.fold(None, |accumulator: Option<Int>, l: Linear|
    match l.terms {
      [x] -> if x.term != term || x.by != 0 - 1 { accumulator }
      else { match accumulator { Some(n) -> Some(min(n, l.k)), None -> Some(l.k) } },
      _ -> accumulator,
    })

fn floor_of(facts: List<Linear>, l: Linear) -> Option<Int> =
  l.terms.fold(Some(l.k), |accumulator: Option<Int>, x: Scaled|
    match accumulator {
      None -> None,
      Some(sum) -> match if x.by > 0 { least(facts, x.term) } else { most(facts, x.term) } {
        None -> None,
        Some(bound) -> match checked_mul(x.by, bound) {
          None -> None,
          Some(part) -> match checked_add(sum, part) {
            Some(n) -> if within(n) { Some(n) } else { None },
            None -> None,
          },
        },
      },
    })

fn ceiling_of(facts: List<Linear>, l: Linear) -> Option<Int> =
  match times(l, 0 - 1) {
    None -> None,
    Some(negated) -> match floor_of(facts, negated) { Some(n) -> Some(0 - n), None -> None },
  }

fn evident(facts: List<Linear>, l: Linear) -> Bool / {abort.raise} =
  if l.terms.len() == 0 { l.k >= 0 } else {
    match floor_of(facts, l) { Some(n) -> n >= 0 || shown_by(facts, l), None -> shown_by(facts, l) }
  }

fn shown_by(facts: List<Linear>, l: Linear) -> Bool / {abort.raise} =
  match negation(l) { Some(not) -> unsatisfiable(facts.push(not), max_eliminations), None -> false }

fn ones_mask(n: Int) -> Int =
  range(0, 62).fold(0, |m: Int, _i: Int| if m >= n { m } else { m * 2 + 1 })

fn rule_facts(facts: List<Linear>, rule: Rule) -> List<Linear> / {abort.raise} =
  match rule {
    Implied(i) -> if i.when.all(|w: Linear| evident(facts, w)) { facts.push(i.then) }
    else { facts },
    Bitwise(j) -> match ((floor_of(facts, j.x), floor_of(facts, j.y))) {
      (Some(x), Some(y)) -> if x < 0 || y < 0 { facts } else {
        match ((ceiling_of(facts, j.x), ceiling_of(facts, j.y))) {
          (Some(a), Some(b)) -> {
            let top = ones_mask(max(a, b));
            match plus(constant(top), of_term(j.term), 0 - 1) {
              Some(under) -> facts.push(of_term(j.term)).push(under),
              None -> facts,
            }
          },
          _ -> facts,
        }
      },
      _ -> facts,
    },
  }

type RelevantFacts = { non_negative: List<Linear>, ne: List<Linear> }

fn relevant_facts(g: Guards, l: Linear) -> RelevantFacts / {abort.raise} = {
  let plain = g.results.fold(
    g.always.concat(g.assumed),
    |accumulator: List<Linear>, a: EnsuredResult|
      if g.returned_terms.contains(a.term) { accumulator.push(a.fact) } else { accumulator },
  );
  let edges = plain.map(terms_of).concat(g.nonzero.map(terms_of)).concat(g.rules.map(rule_terms));
  let near = connected_terms(edges, terms_of(l), 24);
  let about = |x: Linear| x.terms.any(|t: Scaled| near.contains(t.term));
  let ne = g.nonzero.filter(about);
  {
    non_negative: g.rules.fold(
      ne.fold(plain.filter(about), sign_bounds),
      |accumulator: List<Linear>, r: Rule|
        if rule_terms(r).any(|t: Int| near.contains(t)) { rule_facts(accumulator, r) }
        else { accumulator },
    ),
    ne: ne,
  }
}

fn sign_bounds(facts: List<Linear>, d: Linear) -> List<Linear> / {abort.raise} =
  match times(d, 0 - 1) {
    None -> facts,
    Some(negated) -> {
      let side = if evident(facts, d) { strictly_positive(d) }
      else if evident(facts, negated) { strictly_positive(negated) }
      else { None };
      match side { Some(l) -> facts.push(l), None -> facts }
    },
  }

fn follows(g: Guards, l: Linear) -> Bool / {abort.raise} =
  if l.terms.len() == 0 { l.k >= 0 } else {
    match negation(l) {
      None -> false,
      Some(not) -> {
        let b = relevant_facts(g, l);
        impossible(b.non_negative.push(not), b.ne, 2)
      },
    }
  }

fn differs(g: Guards, l: Linear) -> Bool / {abort.raise} =
  if l.terms.len() == 0 { l.k != 0 } else {
    match times(l, 0 - 1) {
      None -> false,
      Some(negated) -> {
        let b = relevant_facts(g, l);
        impossible(b.non_negative.push(l).push(negated), b.ne, 2)
      },
    }
  }

type TermLookup = { g: Guards, term: Int, fresh: Bool }

fn term(g: Guards, key: Bytes) -> TermLookup =
  match g.terms.get(key) {
    Some(t) -> { g: g, term: t, fresh: false },
    None -> {
      let t = g.terms.len();
      { g: { ..g, terms: g.terms.insert(key, t) }, term: t, fresh: true }
    },
  }

fn linear_key(l: Linear) -> Bytes =
  Bytes::concat_all(
    l.terms.fold([b"#", ascii_of_int(l.k)], |accumulator: List<Bytes>, x: Scaled|
      accumulator.push(b"+").push(ascii_of_int(x.by)).push(b"t").push(ascii_of_int(x.term))),
  )

fn value_key(v: SymbolicValue) -> Option<Bytes> =
  match v { Number(l) -> Some(linear_key(l)), Keyed(k) -> Some(k), UnknownValue -> None }

fn call_key(name: Bytes, values: List<SymbolicValue>) -> Option<Bytes> = {
  let keys = values.fold(
    Some([name, b"("]),
    |accumulator: Option<List<Bytes>>, v: SymbolicValue|
      match accumulator {
        None -> None,
        Some(ks) -> match value_key(v) { Some(k) -> Some(ks.push(k).push(b",")), None -> None },
      },
  );
  match keys { Some(ks) -> Some(Bytes::concat_all(ks.push(b")"))), None -> None }
}

fn add_fact(g: Guards, l: Linear) -> Guards / {abort.raise} =
  if l.terms.len() == 0 { g } else { { ..g, always: g.always.push(tightened(l)) } }

fn add_rule(g: Guards, when: List<Option<Linear>>, then: Option<Linear>) -> Guards / {abort.raise} =
  match then {
    None -> g,
    Some(t) -> {
      let read = when.fold(Some([]), |accumulator: Option<List<Linear>>, w: Option<Linear>|
        match ((accumulator, w)) { (Some(ws), Some(x)) -> Some(ws.push(x)), _ -> None });
      match read {
        None -> g,
        Some(ws) -> if ws.fold(false, |no: Bool, w: Linear| no || refuted(w)) { g } else {
          match ws.filter(|w: Linear| w.terms.len() > 0) {
            [] -> add_fact(g, t),
            open -> { ..g, rules: g.rules.push(Implied({ when: open, then: tightened(t) })) },
          }
        },
      }
    },
  }

fn unknown_value(g: Guards) -> ReadResult = { guards: g, value: UnknownValue }

fn number(g: Guards, l: Option<Linear>) -> ReadResult =
  match l { Some(x) -> { guards: g, value: Number(x) }, None -> unknown_value(g) }

const depth: Int = 3

pub fn read(reader: Reader, g: Guards, e: Expression) -> ReadResult / {abort.raise} =
  read_within(reader, g, e, depth)

fn read_literal(
  g: Guards,
  kind: Bytes,
  text: Bytes,
  length: Bytes,
  n: Int,
) -> ReadResult / {abort.raise} = {
  let key = Bytes::concat_all([kind, ascii_of_int(text.len()), b":", text]);
  let t = term(g, Bytes::concat_all([length, b"(", key, b",)"]));
  let known = if !t.fresh { t.g } else {
    match plus(of_term(t.term), constant(n), 0 - 1) {
      None -> t.g,
      Some(over) -> match times(over, 0 - 1) {
        Some(under) -> add_fact(add_fact(t.g, over), under),
        None -> t.g,
      },
    }
  };
  { guards: known, value: Keyed(key) }
}

fn read_typed(reader: Reader, g: Guards, key: Bytes, ty: Type) -> ReadResult / {abort.raise} =
  if !is_int((reader.head)(ty)) { { guards: g, value: Keyed(key) } } else {
    let t = term(g, key);
    { guards: t.g, value: Number(of_term(t.term)) }
  }

fn local_term(binder: Int) -> Bytes = b"v".concat(ascii_of_int(binder))

fn path_of(
  reader: Reader,
  g: Guards,
  e: Expression,
) -> Option<{ key: Bytes, ty: Type }> / {abort.raise} =
  match e {
    NameExpression(v) -> match (reader.name)(v.name) {
      Local(b) ->
        Some({
          key: match g.bound.get(b.binder) { Some(Keyed(k)) -> k, _ -> local_term(b.binder) },
          ty: b.ty,
        }),
      _ -> None,
    },
    FieldExpression(f) -> match path_of(reader, g, f.base) {
      None -> None,
      Some(p) -> match record_fields((reader.head)(p.ty)) {
        None -> None,
        Some(fields) -> match field_get(fields, f.field.name) {
          Some(ty) -> Some({ key: Bytes::concat_all([p.key, b".", f.field.name]), ty: ty }),
          None -> None,
        },
      },
    },
    _ -> None,
  }

fn read_within(
  reader: Reader,
  g: Guards,
  e: Expression,
  budget: Int,
) -> ReadResult / {abort.raise} =
  match e {
    LiteralExpression(l) -> match l.literal {
      LiteralInt(k) -> if within(k) { { guards: g, value: Number(constant(k)) } }
      else { unknown_value(g) },
      LiteralString(s) -> read_literal(g, b"s", s, b"String::len", String::of_bytes_lossy(s).len()),
      LiteralBytes(b) -> read_literal(g, b"b", b, b"Bytes::len", b.len()),
      LiteralEmbedded(digest, size) -> read_literal(g, b"e", digest, b"Bytes::len", size),
      _ -> unknown_value(g),
    },
    NameExpression(v) -> read_name(reader, g, v.name),
    FieldExpression(_) -> match path_of(reader, g, e) {
      Some(p) -> read_typed(reader, g, p.key, p.ty),
      None -> unknown_value(g),
    },
    UnaryExpression(u) -> if u.operation != b"neg" { unknown_value(g) } else {
      let o = read_within(reader, g, u.operand, budget);
      match o.value { Number(l) -> number(o.guards, times(l, 0 - 1)), _ -> unknown_value(o.guards) }
    },
    BinaryExpression(b) -> if !arithmetic(b.operation) { unknown_value(g) } else {
      let l = read_within(reader, g, b.left_operand, budget);
      match l.value {
        Number(x) -> {
          let r = read_within(reader, l.guards, b.right_operand, budget);
          match r.value {
            Number(y) -> read_operator(r.guards, b.operation, x, y),
            _ -> unknown_value(r.guards),
          }
        },
        _ -> unknown_value(l.guards),
      }
    },
    CallExpression(a) -> {
      let on = match a.function {
        FieldExpression(f) -> {
          let r = read_within(reader, g, f.base, budget);
          { name: (reader.on_value)(a.span), first: { g: r.guards, values: [r.value] } }
        },
        _ -> { name: (reader.builtin)(a.function), first: { g: g, values: [] } },
      };
      read_call(reader, on.name, on.first, a.args, budget)
    },
    PerformExpression(p) -> {
      let on = read_name(reader, g, p.effect_name);
      read_call(
        reader,
        (reader.on_value)(p.span),
        { g: on.guards, values: [on.value] },
        p.args,
        budget,
      )
    },
    BlockExpression(b) -> if b.statements.len() > 0 { unknown_value(g) } else {
      match b.tail { Some(t) -> read_within(reader, g, t, budget), None -> unknown_value(g) }
    },
    _ -> unknown_value(g),
  }

type Arguments = { g: Guards, values: List<SymbolicValue> }

fn read_name(reader: Reader, g: Guards, name: QName) -> ReadResult / {abort.raise} =
  match (reader.name)(name) {
    Given(value) -> { guards: g, value: value },
    Local(b) -> match g.bound.get(b.binder) {
      Some(Keyed(key)) -> read_typed(reader, g, key, b.ty),
      Some(value) -> { guards: g, value: value },
      None -> read_typed(reader, g, local_term(b.binder), b.ty),
    },
    Elsewhere -> unknown_value(g),
  }

fn read_call(
  reader: Reader,
  name: Bytes,
  first: Arguments,
  rest: List<Expression>,
  budget: Int,
) -> ReadResult / {abort.raise} =
  if name == b"" { unknown_value(first.g) } else {
    match (reader.contract)(name) {
      None -> unknown_value(first.g),
      Some(st) -> if !st.pure || first.values.len() + rest.len() != st.params.len() {
        unknown_value(first.g)
      } else {
        let args = rest.fold(first, |accumulator: Arguments, x: Expression| {
          let r = read_within(reader, accumulator.g, x, budget);
          { g: r.guards, values: accumulator.values.push(r.value) }
        });
        call_result(reader, args.g, name, st, args.values, budget)
      },
    }
  }

fn arithmetic(operator: Bytes) -> Bool =
  operator == b"add" || operator == b"sub" || operator == b"mul" || operator == b"div"
    || operator == b"rem"
    || operator == b"bitand"
    || operator == b"bitor"
    || operator == b"bitxor"
    || operator == b"shl"
    || operator == b"shr"
    || operator == b"ushr"

fn call_result(
  reader: Reader,
  g: Guards,
  name: Bytes,
  st: Contract,
  values: List<SymbolicValue>,
  budget: Int,
) -> ReadResult / {abort.raise} =
  match call_key(name, values) {
    None -> unknown_value(g),
    Some(key) -> {
      let like = match st.number_like_param {
        Some(i) -> match values.at(i) { Some(Number(_)) -> true, _ -> false },
        None -> false,
      };
      if !st.returns_int && !like { { guards: g, value: Keyed(key) } } else {
        let t = term(g, key);
        let result = Number(of_term(t.term));
        let stated = if t.fresh { add_ensures(reader, t.g, st, values, t.term, budget) }
        else { t.g };
        {
          guards: if !st.raises || stated.returned_terms.contains(t.term) { stated }
          else { { ..stated, returned_terms: stated.returned_terms.push(t.term) } },
          value: result,
        }
      }
    },
  }

fn clause_reader(
  reader: Reader,
  st: Contract,
  values: List<SymbolicValue>,
  result: SymbolicValue,
) -> Reader =
  {
    name: |q: QName|
      if !is_bare(q) { Elsewhere }
      else if q.name.name == b"result" { Given(result) } else {
        range(0, st.params.len()).fold(Elsewhere, |accumulator: Named, i: Int|
          match ((st.params.at(i), values.at(i))) {
            (Some(p), Some(v)) -> if p == q.name.name { Given(v) } else { accumulator },
            _ -> accumulator,
          })
      },
    head: reader.head,
    builtin: |f: Expression| match f { NameExpression(v) -> qualified_name_text(v.name), _ -> b"" },
    on_value: |_: Span| b"",
    contract: reader.contract,
  }

fn add_ensures(
  reader: Reader,
  g: Guards,
  st: Contract,
  values: List<SymbolicValue>,
  term: Int,
  budget: Int,
) -> Guards / {abort.raise} =
  if budget <= 0 || st.ensures.len() == 0 { g } else {
    let within_clause = clause_reader(reader, st, values, Number(of_term(term)));
    st.ensures.fold(g, |accumulator: Guards, c: Clause| {
      let s = suppose(within_clause, accumulator, c.condition, true, budget - 1);
      s.non_negative.fold(s.g, |known: Guards, l: Linear|
        if l.terms.len() == 0 { known }
        else if st.raises { { ..known, results: known.results.push({ term: term, fact: l }) } }
        else { add_fact(known, l) })
    })
  }

fn power(k: Int) -> Int = pow(2, k)

fn read_operator(g: Guards, operator: Bytes, x: Linear, y: Linear) -> ReadResult / {abort.raise} =
  if operator == b"add" { number(g, plus(x, y, 1)) }
  else if operator == b"sub" { number(g, plus(x, y, 0 - 1)) }
  else if operator == b"mul" && x.terms.len() == 0 { number(g, times(y, x.k)) }
  else if operator == b"mul" && y.terms.len() == 0 { number(g, times(x, y.k)) }
  else if (operator == b"shr" || operator == b"ushr") && y.terms.len() == 0 && y.k == 0 {
    number(g, Some(x))
  } else {
    let t = term(g, Bytes::concat_all([b"(", linear_key(x), operator, linear_key(y), b")"]));
    let q = of_term(t.term);
    {
      guards: if !t.fresh { t.g }
      else if operator == b"div" { with_quotient(t.g, q, x, y) }
      else if operator == b"rem" { with_remainder(t.g, q, x, y) }
      else if operator == b"bitand" { masked(masked(t.g, q, x), q, y) }
      else if operator == b"bitor" || operator == b"bitxor" {
        { ..t.g, rules: t.g.rules.push(Bitwise({ term: t.term, x: x, y: y })) }
      } else if operator == b"shr" || operator == b"ushr" {
        shifted(t.g, q, x, y, operator == b"ushr")
      } else { t.g },
      value: Number(q),
    }
  }

fn with_quotient(g: Guards, q: Linear, x: Linear, y: Linear) -> Guards / {abort.raise} =
  if y.terms.len() > 0 {
    let positive = [strictly_positive(y), Some(x)];
    add_rule(add_rule(g, positive, Some(q)), positive, plus(x, q, 0 - 1))
  } else if y.k < 1 { g } else {
    let whole = times(q, y.k);
    let slack = constant(y.k - 1);
    let over = match whole { Some(w) -> plus(x, w, 0 - 1), None -> None };
    let under = match whole { Some(w) -> plus(w, x, 0 - 1), None -> None };
    let near = |d: Option<Linear>| match d { Some(l) -> plus(l, slack, 1), None -> None };
    add_rule(
      add_rule(add_rule(add_rule(g, [], near(over)), [], near(under)), [Some(x)], over),
      [times(x, 0 - 1)],
      under,
    )
  }

fn with_remainder(g: Guards, r: Linear, x: Linear, y: Linear) -> Guards / {abort.raise} = {
  let positive = strictly_positive(y);
  let budget = match positive { Some(p) -> plus(p, r, 0 - 1), None -> None };
  let back = match positive { Some(p) -> plus(p, r, 1), None -> None };
  add_rule(
    add_rule(
      add_rule(add_rule(g, [positive], budget), [positive], back),
      [positive, Some(x)],
      Some(r),
    ),
    [positive, times(x, 0 - 1)],
    times(r, 0 - 1),
  )
}

fn masked(g: Guards, m: Linear, y: Linear) -> Guards / {abort.raise} =
  add_rule(add_rule(g, [Some(y)], Some(m)), [Some(y)], plus(y, m, 0 - 1))

fn shifted(g: Guards, s: Linear, x: Linear, y: Linear, logical: Bool) -> Guards / {abort.raise} =
  if y.terms.len() > 0 || y.k < 1 || y.k > 62 { g } else {
    let by = power(y.k);
    let whole = times(s, by);
    let over = match whole { Some(w) -> plus(x, w, 0 - 1), None -> None };
    let under = match whole {
      Some(w) -> match plus(w, x, 0 - 1) { Some(d) -> plus(d, constant(by - 1), 1), None -> None },
      None -> None,
    };
    let when = if logical { [Some(x)] } else { [] };
    let floored = add_rule(add_rule(g, when, over), when, under);
    if !logical { floored } else {
      let top = if y.k < 2 { None } else { plus(constant(power(64 - y.k) - 1), s, 0 - 1) };
      add_rule(add_rule(floored, [], Some(s)), [], top)
    }
  }

type Supposition = { g: Guards, non_negative: List<Linear>, nonzero: List<Linear> }

fn no_supposition(g: Guards) -> Supposition = { g: g, non_negative: [], nonzero: [] }

fn comparison(operator: Bytes) -> Bool =
  operator == b"lt" || operator == b"le" || operator == b"gt" || operator == b"ge"
    || operator == b"eq"
    || operator == b"ne"

fn opposite(operator: Bytes) -> Bytes =
  if operator == b"lt" { b"ge" }
  else if operator == b"le" { b"gt" }
  else if operator == b"gt" { b"le" }
  else if operator == b"ge" { b"lt" }
  else if operator == b"eq" { b"ne" }
  else { b"eq" }

fn suppose(
  reader: Reader,
  g: Guards,
  e: Expression,
  truth: Bool,
  budget: Int,
) -> Supposition / {abort.raise} =
  match e {
    UnaryExpression(u) -> if u.operation == b"not" { suppose(reader, g, u.operand, !truth, budget) }
    else { no_supposition(g) },
    BinaryExpression(b) -> if b.operation == b"and" || b.operation == b"or" {
      if b.operation == b"and" != truth { no_supposition(g) } else {
        let l = suppose(reader, g, b.left_operand, truth, budget);
        let r = suppose(reader, l.g, b.right_operand, truth, budget);
        {
          g: r.g,
          non_negative: l.non_negative.concat(r.non_negative),
          nonzero: l.nonzero.concat(r.nonzero),
        }
      }
    } else if !comparison(b.operation) { no_supposition(g) } else {
      let l = read_within(reader, g, b.left_operand, budget);
      match l.value {
        Number(x) -> {
          let r = read_within(reader, l.guards, b.right_operand, budget);
          match r.value {
            Number(y) ->
              compared(r.guards, if truth { b.operation } else { opposite(b.operation) }, x, y),
            _ -> no_supposition(r.guards),
          }
        },
        _ -> no_supposition(l.guards),
      }
    },
    BlockExpression(b) -> if b.statements.len() > 0 { no_supposition(g) } else {
      match b.tail { Some(t) -> suppose(reader, g, t, truth, budget), None -> no_supposition(g) }
    },
    _ -> no_supposition(g),
  }

fn compared(g: Guards, operator: Bytes, x: Linear, y: Linear) -> Supposition / {abort.raise} = {
  let up = plus(y, x, 0 - 1);
  let down = plus(x, y, 0 - 1);
  let strictly = |d: Option<Linear>| match d { Some(l) -> strictly_positive(l), None -> None };
  let ge = |ds: List<Option<Linear>>|
    {
      g: g,
      non_negative: ds.fold([], |accumulator: List<Linear>, d: Option<Linear>|
        match d { Some(l) -> accumulator.push(tightened(l)), None -> accumulator }),
      nonzero: [],
    };
  if operator == b"lt" { ge([strictly(up)]) }
  else if operator == b"le" { ge([up]) }
  else if operator == b"gt" { ge([strictly(down)]) }
  else if operator == b"ge" { ge([down]) }
  else if operator == b"eq" { ge([up, down]) }
  else { { g: g, non_negative: [], nonzero: match down { Some(l) -> [l], None -> [] } } }
}

pub fn assume(reader: Reader, g: Guards, e: Expression, truth: Bool) -> Guards / {abort.raise} = {
  let s = suppose(reader, g, e, truth, depth);
  with_facts(s.g, s.non_negative, s.nonzero)
}

fn with_facts(g: Guards, ge: List<Linear>, ne: List<Linear>) -> Guards =
  if ge.len() == 0 && ne.len() == 0 { g } else {
    {
      ..g,
      assumed: ge.fold(g.assumed, |accumulator: List<Linear>, l: Linear|
        if l.terms.len() == 0 { accumulator } else { accumulator.push(l) }),
      nonzero: ne.fold(g.nonzero, |accumulator: List<Linear>, l: Linear|
        if l.terms.len() == 0 { accumulator } else { accumulator.push(l) }),
    }
  }

pub type ProofResult = { g: Guards, ok: Bool }

fn prove(
  reader: Reader,
  g: Guards,
  e: Expression,
  truth: Bool,
  budget: Int,
) -> ProofResult / {abort.raise} =
  match e {
    LiteralExpression(l) ->
      { g: g, ok: match l.literal { LiteralBool(v) -> v == truth, _ -> false } },
    UnaryExpression(u) -> if u.operation == b"not" { prove(reader, g, u.operand, !truth, budget) }
    else { { g: g, ok: false } },
    BinaryExpression(b) -> if b.operation == b"and" || b.operation == b"or" {
      let l = prove(reader, g, b.left_operand, truth, budget);
      if l.ok != (b.operation == b"and" == truth) { l }
      else { prove(reader, l.g, b.right_operand, truth, budget) }
    } else if !comparison(b.operation) { { g: g, ok: false } } else {
      let l = read_within(reader, g, b.left_operand, budget);
      match l.value {
        Number(x) -> {
          let r = read_within(reader, l.guards, b.right_operand, budget);
          match r.value {
            Number(y) ->
              {
                g: r.guards,
                ok: comparison_implied(
                  r.guards,
                  if truth { b.operation } else { opposite(b.operation) },
                  x,
                  y,
                ),
              },
            _ -> { g: r.guards, ok: false },
          }
        },
        _ -> { g: l.guards, ok: false },
      }
    },
    BlockExpression(b) -> if b.statements.len() > 0 { { g: g, ok: false } } else {
      match b.tail { Some(t) -> prove(reader, g, t, truth, budget), None -> { g: g, ok: false } }
    },
    _ -> { g: g, ok: false },
  }

fn comparison_implied(g: Guards, operator: Bytes, x: Linear, y: Linear) -> Bool / {abort.raise} = {
  let s = compared(g, operator, x, y);
  if operator == b"ne" { s.nonzero.len() > 0 && s.nonzero.all(|l: Linear| differs(g, l)) } else {
    s.non_negative.len() == (if operator == b"eq" { 2 } else { 1 })
      && s.non_negative.all(|l: Linear| follows(g, l))
  }
}

fn arguments(reader: Reader, g: Guards, args: List<Expression>) -> Arguments / {abort.raise} =
  args.fold({ g: g, values: [] }, |accumulator: Arguments, x: Expression| {
    let r = read(reader, accumulator.g, x);
    { g: r.guards, values: accumulator.values.push(r.value) }
  })

pub fn unproved_requirement(
  reader: Reader,
  g: Guards,
  st: Contract,
  args: List<Expression>,
) -> { g: Guards, needs: Option<Bytes> } / {abort.raise} = {
  let read_args = arguments(reader, g, args);
  let within_clause = clause_reader(reader, st, read_args.values, UnknownValue);
  st.requires.fold(
    { g: read_args.g, needs: None },
    |accumulator: { g: Guards, needs: Option<Bytes> }, c: Clause|
      match accumulator.needs {
        Some(_) -> accumulator,
        None -> {
          let s = prove(within_clause, accumulator.g, c.condition, true, depth);
          { g: s.g, needs: if s.ok { None } else { Some(c.text) } }
        },
      },
  )
}

pub fn nonzero(reader: Reader, g: Guards, divisor: Expression) -> ProofResult / {abort.raise} = {
  let r = read(reader, g, divisor);
  { g: r.guards, ok: match r.value { Number(l) -> differs(r.guards, l), _ -> false } }
}

pub fn at_least(
  reader: Reader,
  g: Guards,
  e: Expression,
  least: Int,
) -> ProofResult / {abort.raise} = {
  let r = read(reader, g, e);
  {
    g: r.guards,
    ok: match r.value {
      Number(l) -> match plus(l, constant(least), 0 - 1) {
        Some(d) -> follows(r.guards, d),
        None -> false,
      },
      _ -> false,
    },
  }
}

pub fn bind(g: Guards, binder: Int, value: SymbolicValue) -> Guards =
  match value { UnknownValue -> g, _ -> { ..g, bound: g.bound.insert(binder, value) } }

pub fn over_range(
  reader: Reader,
  g: Guards,
  lo: Expression,
  hi: Expression,
) -> Guards / {abort.raise} = {
  let l = read(reader, g, lo);
  let h = read(reader, l.guards, hi);
  match ((l.value, h.value)) {
    (Number(from), Number(to)) -> { ..h.guards, ranged: Some({ lo: from, hi: to }) },
    _ -> h.guards,
  }
}

pub fn enter_range_lambda(reader: Reader, g: Guards, last: Named) -> Guards / {abort.raise} =
  match g.ranged {
    None -> g,
    Some(r) -> {
      let cleared = { ..g, ranged: None };
      match last {
        Local(b) -> {
          let p = read_typed(reader, cleared, local_term(b.binder), b.ty);
          match p.value {
            Number(x) -> {
              let from = plus(x, r.lo, 0 - 1);
              let to = match plus(r.hi, x, 0 - 1) { Some(d) -> strictly_positive(d), None -> None };
              with_facts(
                p.guards,
                [from, to].fold([], |accumulator: List<Linear>, d: Option<Linear>|
                  match d { Some(l) -> accumulator.push(tightened(l)), None -> accumulator }),
                [],
              )
            },
            _ -> p.guards,
          }
        },
        _ -> cleared,
      }
    },
  }

fn read_length(reader: Reader, g: Guards, length: Bytes, key: Bytes) -> ReadResult / {abort.raise} =
  match (reader.contract)(length) {
    Some(st) -> call_result(reader, g, length, st, [Keyed(key)], depth),
    None -> unknown_value(g),
  }

fn indexed(
  reader: Reader,
  g: Guards,
  scrutinee: Expression,
) -> { g: Guards, at: Option<{ length: Linear, index: Linear }> } / {abort.raise} =
  match scrutinee {
    CallExpression(a) -> match ((a.function, a.args)) {
      (FieldExpression(f), [i]) ->
        indexed_at(reader, (reader.on_value)(a.span), read(reader, g, f.base), i),
      (FieldExpression(_), _) -> { g: g, at: None },
      (_, [xs, i]) -> indexed_at(reader, (reader.builtin)(a.function), read(reader, g, xs), i),
      _ -> { g: g, at: None },
    },
    PerformExpression(p) -> match p.args {
      [i] -> indexed_at(reader, (reader.on_value)(p.span), read_name(reader, g, p.effect_name), i),
      _ -> { g: g, at: None },
    },
    _ -> { g: g, at: None },
  }

fn indexed_at(
  reader: Reader,
  name: Bytes,
  held_in: ReadResult,
  i: Expression,
) -> { g: Guards, at: Option<{ length: Linear, index: Linear }> } / {abort.raise} = {
  let length = if name == b"List::at" { b"List::len" }
  else if name == b"Array::at" { b"Array::len" }
  else { b"" };
  if length == b"" { { g: held_in.guards, at: None } } else {
    let index = read(reader, held_in.guards, i);
    match ((held_in.value, index.value)) {
      (Keyed(key), Number(at)) -> {
        let n = read_length(reader, index.guards, length, key);
        {
          g: n.guards,
          at: match n.value { Number(l) -> Some({ length: l, index: at }), _ -> None },
        }
      },
      _ -> { g: index.guards, at: None },
    }
  }
}

fn length_of(
  reader: Reader,
  g: Guards,
  scrutinee: Expression,
) -> { g: Guards, length: Option<Linear> } / {abort.raise} = {
  let r = read(reader, g, scrutinee);
  match r.value {
    Keyed(key) -> {
      let n = read_length(reader, r.guards, b"List::len", key);
      { g: n.guards, length: match n.value { Number(l) -> Some(l), _ -> None } }
    },
    _ -> { g: r.guards, length: None },
  }
}

fn tightened_some(ds: List<Option<Linear>>) -> List<Linear> / {abort.raise} =
  ds.fold([], |accumulator: List<Linear>, d: Option<Linear>|
    match d { Some(l) -> accumulator.push(tightened(l)), None -> accumulator })

type Bounds = { lo: Int, hi: Int }

fn bounds(pattern: Pattern) -> Option<Bounds> =
  match pattern {
    PatternLiteral(l) -> match l.literal { LiteralInt(k) -> Some({ lo: k, hi: k }), _ -> None },
    PatternRange(r) -> match ((r.lo, r.hi)) {
      (LiteralInt(lo), LiteralInt(hi)) -> Some({ lo: lo, hi: hi }),
      _ -> None,
    },
    PatternOr(o) -> match o.alternatives {
      [] -> None,
      [first, ..rest] ->
        rest.fold(bounds(first), |accumulator: Option<Bounds>, alt: Pattern|
          match ((accumulator, bounds(alt))) {
            (Some(a), Some(b)) -> Some({ lo: min(a.lo, b.lo), hi: max(a.hi, b.hi) }),
            _ -> None,
          }),
    },
    _ -> None,
  }

fn bounded(reader: Reader, g: Guards, scrutinee: Expression, b: Bounds) -> Guards / {abort.raise} = {
  let r = read(reader, g, scrutinee);
  match r.value {
    Number(x) ->
      with_facts(
        r.guards,
        tightened_some([plus(x, constant(b.lo), 0 - 1), plus(constant(b.hi), x, 0 - 1)]),
        [],
      ),
    _ -> r.guards,
  }
}

pub fn matched(
  reader: Reader,
  g: Guards,
  scrutinee: Expression,
  pattern: Pattern,
) -> Guards / {abort.raise} =
  match pattern {
    PatternLiteral(l) -> match l.literal {
      LiteralBool(b) -> assume(reader, g, scrutinee, b),
      LiteralInt(k) -> bounded(reader, g, scrutinee, { lo: k, hi: k }),
      _ -> g,
    },
    PatternRange(_) -> match bounds(pattern) {
      Some(b) -> bounded(reader, g, scrutinee, b),
      None -> g,
    },
    PatternOr(_) -> match bounds(pattern) {
      Some(b) -> bounded(reader, g, scrutinee, b),
      None -> g,
    },
    PatternConstructor(c) -> if c.name.name.name != some_constructor || c.args.len() != 1 { g }
    else {
      let found = indexed(reader, g, scrutinee);
      match found.at {
        None -> found.g,
        Some(x) ->
          with_facts(
            found.g,
            tightened_some([
              Some(x.index),
              match plus(x.length, x.index, 0 - 1) {
                Some(d) -> strictly_positive(d),
                None -> None,
              },
            ]),
            [],
          ),
      }
    },
    PatternList(l) -> {
      let n = length_of(reader, g, scrutinee);
      match n.length {
        None -> n.g,
        Some(length) -> {
          let over = plus(length, constant(l.items.len()), 0 - 1);
          let under = match l.rest {
            Some(_) -> None,
            None -> match over { Some(d) -> times(d, 0 - 1), None -> None },
          };
          with_facts(n.g, tightened_some([over, under]), [])
        },
      }
    },
    _ -> g,
  }

pub fn unmatched(
  reader: Reader,
  g: Guards,
  scrutinee: Expression,
  pattern: Pattern,
) -> Guards / {abort.raise} =
  match pattern {
    PatternLiteral(l) -> match l.literal {
      LiteralBool(b) -> assume(reader, g, scrutinee, !b),
      LiteralInt(k) -> {
        let r = read(reader, g, scrutinee);
        match r.value {
          Number(x) -> {
            let s = compared(r.guards, b"ne", x, constant(k));
            with_facts(s.g, s.non_negative, s.nonzero)
          },
          _ -> r.guards,
        }
      },
      _ -> g,
    },
    PatternRange(_) -> match bounds(pattern) {
      None -> g,
      Some(b) -> {
        let r = read(reader, g, scrutinee);
        match r.value {
          Number(x) -> {
            let from = plus(x, constant(b.lo), 0 - 1);
            let to = plus(constant(b.hi), x, 0 - 1);
            let shown = |d: Option<Linear>|
              match d { Some(l) -> follows(r.guards, l), None -> false };
            let past = |d: Option<Linear>|
              match d {
                Some(l) -> match times(l, 0 - 1) { Some(n) -> strictly_positive(n), None -> None },
                None -> None,
              };
            if shown(from) { with_facts(r.guards, tightened_some([past(to)]), []) }
            else if shown(to) { with_facts(r.guards, tightened_some([past(from)]), []) }
            else { r.guards }
          },
          _ -> r.guards,
        }
      },
    },
    PatternOr(o) ->
      o.alternatives.fold(g, |accumulator: Guards, alt: Pattern|
        unmatched(reader, accumulator, scrutinee, alt)),
    PatternList(l) -> match l.rest {
      Some(_) -> g,
      None -> if l.items.len() > 0 { g } else {
        let n = length_of(reader, g, scrutinee);
        match n.length {
          Some(length) -> with_facts(n.g, tightened_some([strictly_positive(length)]), []),
          None -> n.g,
        }
      },
    },
    _ -> g,
  }

fn sum(terms: List<Scaled>, k: Int) -> Linear = { terms: terms, k: k }

fn guards_assuming(facts: List<Linear>) -> Guards = { ..no_guards, assumed: facts }

test "`unsatisfiable` is true for bounds with an empty range of integers, such as x >= 11 and x <= 10, and false when one integer fits" {
  let x = { term: 0, by: 1 };
  let under = sum([{ term: 0, by: 0 - 1 }], 10);
  assert(unsatisfiable([sum([x], 0 - 11), under], max_eliminations));
  assert(!unsatisfiable([sum([x], 0 - 10), under], max_eliminations));
  assert(unsatisfiable([sum([], 0 - 1)], max_eliminations));
  assert(!unsatisfiable([], max_eliminations))
}

test "`tightened` rounds an inequality to integer bounds, so 2x >= 1 and 2x <= 1 are together unsatisfiable" {
  let over = sum([{ term: 0, by: 2 }], 0 - 1);
  let under = sum([{ term: 0, by: 0 - 2 }], 1);
  assert_eq(tightened(over), sum([{ term: 0, by: 1 }], 0 - 1));
  assert_eq(tightened(under), sum([{ term: 0, by: 0 - 1 }], 0));
  assert(unsatisfiable([tightened(over), tightened(under)], max_eliminations));
  assert_eq(floor_div(0 - 1, 2), 0 - 1);
  assert_eq(floor_div(255, 16), 15)
}

test "`follows` accepts a sum implied by the assumed bounds that add up to it, and rejects sums those bounds do not imply" {
  let g = guards_assuming([
    sum([{ term: 0, by: 1 }], 0),
    sum([{ term: 1, by: 1 }], 0),
    sum([{ term: 0, by: 0 - 1 }, { term: 1, by: 0 - 1 }, { term: 2, by: 1 }], 0),
  ]);
  let budget = sum([{ term: 0, by: 0 - 1 }, { term: 1, by: 0 - 1 }, { term: 2, by: 1 }], 0);
  assert(follows(g, budget));
  assert(follows(g, sum([{ term: 2, by: 1 }], 0)));
  assert(
    !follows(g, sum([{ term: 0, by: 0 - 1 }, { term: 1, by: 0 - 1 }, { term: 2, by: 1 }], 0 - 1)),
  );
  assert(!follows(g, sum([{ term: 3, by: 1 }], 0)))
}

test "a value known to be nonzero and not below zero is proven to be at least one, but a value not known to be nonzero is not" {
  let n = sum([{ term: 0, by: 1 }], 0);
  let apart = { ..guards_assuming([n]), nonzero: [n] };
  assert(differs(apart, n));
  assert(follows(apart, sum([{ term: 0, by: 1 }], 0 - 1)));
  assert(!follows(guards_assuming([n]), sum([{ term: 0, by: 1 }], 0 - 1)));
  assert(!differs({ ..no_guards, assumed: [], nonzero: [sum([{ term: 1, by: 1 }], 0)] }, n))
}

test "an operator's result is bounded as the operator bounds it" {
  let byte = add_fact(
    add_fact(no_guards, sum([{ term: 0, by: 1 }], 0)),
    sum([{ term: 0, by: 0 - 1 }], 255),
  );
  let x = of_term(0);
  let within_16 = |r: ReadResult|
    match r.value {
      Number(l) -> match plus(constant(15), l, 0 - 1) {
        Some(under) ->
          follows(r.guards, l) && follows(r.guards, under) && !follows(r.guards, minus_one(under)),
        None -> false,
      },
      _ -> false,
    };
  assert(
    within_16(
      read_operator({ ..byte, terms: byte.terms.insert(b"x", 0) }, b"div", x, constant(16)),
    ),
  );
  assert(
    within_16(
      read_operator({ ..byte, terms: byte.terms.insert(b"x", 0) }, b"rem", x, constant(16)),
    ),
  );
  assert(
    within_16(
      read_operator({ ..byte, terms: byte.terms.insert(b"x", 0) }, b"bitand", x, constant(15)),
    ),
  );
  assert(
    within_16(
      read_operator({ ..byte, terms: byte.terms.insert(b"x", 0) }, b"ushr", x, constant(4)),
    ),
  );
  let joined = read_operator({ ..byte, terms: byte.terms.insert(b"x", 0) }, b"bitxor", x, x);
  match joined.value {
    Number(l) -> match plus(constant(255), l, 0 - 1) {
      Some(under) -> assert(follows(joined.guards, l) && follows(joined.guards, under)),
      None -> panic("255 less a term is in range"),
    },
    _ -> panic("an `Int`"),
  }
}

fn minus_one(l: Linear) -> Linear = match strictly_positive(l) { Some(x) -> x, None -> l }

test "a coefficient too big for the arithmetic gives no result, never a wrong one" {
  let big = sum([{ term: 0, by: limit - 1 }], 0);
  assert_eq(plus(big, big, 1), None);
  assert_eq(times(big, 2), None);
  assert_eq(plus(constant(limit - 1), constant(1), 1), None);
  assert(!follows(guards_assuming([big]), sum([{ term: 1, by: 1 }], 0)))
}
