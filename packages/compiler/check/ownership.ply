import compiler.syntax.parsing (Span)
import compiler.check.types (backticked_text, Type, FunctionType, Effects, Field, record_fields,
                             unit_type)
import compiler.check.typed (TypedParam, pattern_binders, TypedPattern, TypedWild, TypedBinder,
                             TypedCase, TypedRecordPattern, TypedListPattern, TypedOr,
                             TypedFieldPattern, Holder, BinderHolder, NodeHolder, ReleasePlace,
                             ReleaseAfter, ReleaseBefore, ReleaseUnwinding, ReleaseMissing,
                             ReleaseFailing, binding_key, holder_key)
import compiler.check.infer.walked (WalkedExpression, WalkedLiteral, WalkedRead, WalkedLocal,
                                    WalkedDefinition, WalkedConstructor, WalkedBuiltin, WalkedUnary,
                                    WalkedBinary, WalkedCall, WalkedIf, WalkedMatch, WalkedBlock,
                                    WalkedList, WalkedRecord, WalkedUpdate, WalkedFieldRead,
                                    WalkedPerform, WalkedLambda, WalkedSimulate, WalkedParallel,
                                    WalkedHandle, WalkedDefault, WalkedArm, WalkedStatement,
                                    WalkedLet, WalkedLetElse, WalkedDo, WalkedAssign, WalkedField,
                                    WalkedThunk, WalkedClause, WalkedReturn, WalkedHandlerVariable,
                                    walked_expression_nodes_folded)
import compiler.check.resolve.tables (Diagnostic, error_at, error_at_and)
import compiler.check.infer.checker (simulated_operations)
import compiler.check.infer.names (simple_name_of)
import std.list
import std.option

pub type Facts = {
  module: Int,
  resource: (Type) -> Bool / {abort.raise},
  resolved: (Type) -> Type / {abort.raise},
  taking: (Bytes) -> Option<ArgumentModes> / {abort.raise},
  operation_consumed_parameters: (Bytes, Bytes) -> List<Int> / {abort.raise},
  opened: (Type) -> Bool / {abort.raise},
}

pub type ArgumentModes = { taken_indices: List<Int>, all: Bool }

fn takes_argument(t: ArgumentModes, i: Int) -> Bool = t.all || t.taken_indices.contains(i)

pub type Param = { name: Bytes, span: Span, ty: Type, keep: Bool }

pub type Release = {
  holder: Holder,
  ty: Type,
  at: Span,
  place: ReleasePlace,
  effects: Option<Effects>,
  returned: List<Bytes>,
}

type ReleaseContext = { effects: Option<Effects>, handled_operations: List<Bytes> }

pub type OwnershipResult = {
  diagnostics: List<Diagnostic>,
  releases: List<Release>,
  owned_values: List<OwnedValue>,
}

pub type OwnedValue = {
  holder: Holder,
  effects: Option<Effects>,
  ty: Type,
  at: Span,
  name: Bytes,
  returned: List<Bytes>,
}

type Usage = | Moved(Bytes) | Borrowed | Read | Discarded | Called

type EnclosingFunction = { span: Span, escapes: Bool, local: Bool }

type Binding = {
  key: Int,
  owning_package: Holder,
  name: Bytes,
  at: Span,
  ty: Type,
  kind: Kind,
  owned: Bool,
  depth: Int,
  frame: Int,
  consumed: Option<Consumption>,
  taken: List<Bytes>,
  borrows: List<Int>,
  captured_resources: List<Int>,
  effects: Option<Effects>,
  returned: List<Bytes>,
}

type Consumption = { at: Span, how: Bytes }

type Kind = | Value | OwningFunction | Continuation

type EnclosingHandle = { operations: List<Bytes>, body: Int }

type OwnershipState = {
  module: Int,
  bindings: Map<Int, Binding>,
  diagnostics: List<Diagnostic>,
  releases: List<Release>,
  captured: Map<Int, Captures>,
  in_flight: List<ReleaseTarget>,
}

type ReleaseTarget = { owning_package: Holder, ty: Type }

type Captures = { consumed: List<Int>, borrows: List<Int> }

type Scope = {
  functions: List<EnclosingFunction>,
  block: List<Int>,
  handles: List<EnclosingHandle>,
  frame: Int,
  body: Int,
  effects: Option<Effects>,
  result: Usage,
}

type ScopedState = { s: Scope, st: OwnershipState }

pub fn check_ownership(
  f: Facts,
  params: List<Param>,
  body: WalkedExpression,
) -> OwnershipResult / {abort.raise} = {
  let start: ScopedState = params.fold(
    {
      s: {
        functions: [],
        block: [],
        handles: [],
        frame: 0,
        body: 0,
        effects: None,
        result: Moved(b"answered"),
      },
      st: {
        module: f.module,
        bindings: Map::new(),
        diagnostics: [],
        releases: [],
        captured: Map::new(),
        in_flight: [],
      },
    },
    |accumulator: ScopedState, p: Param| {
      let t = f.resolved(p.ty);
      bind(accumulator, p.name, p.span, t, f.resource(t), p.keep)
    },
  );
  let walked = release_scope(
    f,
    walk(f, start.s, release_before_last(start.st, start.s, body), body, Moved(b"answered")),
    start.s,
    body,
    body.span,
    Moved(b"answered"),
  );
  {
    diagnostics: walked.diagnostics,
    releases: walked.releases,
    owned_values: walked.releases.fold([], |accumulator: List<OwnedValue>, r: Release| {
      let bind = walked.bindings.get(holder_key(r.holder));
      let x = {
        holder: r.holder,
        effects: r.effects,
        ty: r.ty,
        at: match bind { Some(b) -> b.at, None -> r.at },
        name: match bind { Some(b) -> b.name, None -> b"a value" },
        returned: r.returned,
      };
      if accumulator.contains(x) { accumulator } else { accumulator.push(x) }
    }),
  }
}

pub fn needs_ownership_check(f: Facts, e: WalkedExpression) -> Bool / {abort.raise} =
  walked_expression_nodes_folded(e, false, |found: Bool, x: WalkedExpression|
    found || has_resource_type(f, x) || (match x.node { WalkedHandle(_) -> true, _ -> false }))

fn type_of(f: Facts, e: WalkedExpression) -> Type / {abort.raise} = f.resolved(e.ty)

fn has_resource_type(f: Facts, e: WalkedExpression) -> Bool / {abort.raise} =
  f.resource(type_of(f, e))

fn release_scope(
  f: Facts,
  state: OwnershipState,
  s: Scope,
  last: WalkedExpression,
  at: Span,
  usage: Usage,
) -> OwnershipState / {abort.raise} =
  s.block.reverse().fold(state, |accumulator: OwnershipState, site: Int|
    match accumulator.bindings.get(site) {
      Some(b) -> if !live(b) { accumulator } else {
        let place = release_point(accumulator, b, last);
        release_binding(
          consume(accumulator, b, at, b"let go where its block ends"),
          b,
          place.at,
          place.place,
          owned_result(f, last, place.place, usage),
        )
      },
      None -> accumulator,
    })

fn owned_result(
  f: Facts,
  at: WalkedExpression,
  place: ReleasePlace,
  usage: Usage,
) -> List<ReleaseTarget> / {abort.raise} =
  if place != ReleaseAfter || (match usage { Moved(_) -> false, _ -> true }) { [] } else {
    let t = type_of(f, at);
    if f.resource(t) { [{ owning_package: NodeHolder(at.span.site), ty: t }] } else { [] }
  }

fn release_binding(
  state: OwnershipState,
  b: Binding,
  at: Span,
  place: ReleasePlace,
  value: List<ReleaseTarget>,
) -> OwnershipState = {
  let w = { effects: b.effects, handled_operations: b.returned };
  let released_targets = released_values(state, b);
  let holders = released_targets.map(|x: ReleaseTarget| x.owning_package);
  let check_ownership = state.bindings.fold(
    [],
    |accumulator: List<ReleaseTarget>, key: Int, x: Binding|
      if x.frame == b.frame && key != b.key && !holders.contains(x.owning_package) && live(x) {
        accumulator.concat(released_values(state, x))
      } else { accumulator },
  );
  let around = value.concat(state.in_flight.reverse().concat(check_ownership));
  released_targets.fold(
    { st: add_releases(state, released_targets, at, place, w), later: released_targets },
    |accumulator: { st: OwnershipState, later: List<ReleaseTarget> }, x: ReleaseTarget| {
      let later = accumulator.later.drop(1);
      {
        st: add_releases(
          accumulator.st,
          later.concat(around),
          at,
          ReleaseFailing(x.owning_package),
          w,
        ),
        later: later,
      }
    },
  ).st
}

fn on_failure(p: ReleasePlace) -> Bool =
  match p {
    ReleaseUnwinding -> true,
    ReleaseMissing -> true,
    ReleaseFailing(_) -> true,
    _ -> false,
  }

fn check_borrowed_result(
  f: Facts,
  state: OwnershipState,
  s: Scope,
  last: WalkedExpression,
  usage: Usage,
) -> OwnershipState / {abort.raise} =
  match usage {
    Borrowed -> check_borrowed_bindings(f, state, s.block, last),
    Read -> check_borrowed_bindings(f, state, s.block, last),
    _ -> state,
  }

fn check_borrowed_bindings(
  f: Facts,
  state: OwnershipState,
  sites: List<Int>,
  last: WalkedExpression,
) -> OwnershipState / {abort.raise} =
  if !has_resource_type(f, last) { state } else {
    sites.fold(state, |accumulator: OwnershipState, key: Int|
      match accumulator.bindings.get(key) {
        Some(b) -> if live(b) && may_return_binding(last, b.key) {
          report(accumulator, new_resource_dropped(f, last, Borrowed))
        } else { accumulator },
        None -> accumulator,
      })
  }

fn may_return_binding(e: WalkedExpression, key: Int) -> Bool =
  match e.node {
    WalkedRead(WalkedLocal(l)) -> binding_key(l.binder) == key,
    WalkedFieldRead(x) -> may_return_binding(x.base, key),
    WalkedBlock(b) -> match b.tail { Some(t) -> may_return_binding(t, key), None -> false },
    WalkedIf(i) -> may_return_binding(i.then_branch, key) || may_return_binding(i.else_branch, key),
    WalkedMatch(m) -> m.arms.any(|a: WalkedArm| may_return_binding(a.body, key)),
    WalkedHandle(h) -> may_return_binding(h.body, key),
    _ -> false,
  }

fn release_after(state: OwnershipState, sites: List<Int>, at: Span) -> OwnershipState =
  sites.reverse().fold(state, |accumulator: OwnershipState, key: Int|
    match accumulator.bindings.get(key) {
      Some(b) -> if !live(b) { accumulator } else {
        release_binding(
          consume(accumulator, b, at, b"let go where its block ends"),
          b,
          at,
          ReleaseAfter,
          [],
        )
      },
      None -> accumulator,
    })

fn move_to_frame(state: OwnershipState, keys: List<Int>, frame: Int) -> OwnershipState =
  keys.fold(state, |accumulator: OwnershipState, key: Int|
    match accumulator.bindings.get(key) {
      Some(b) -> store_binding(accumulator, { ..b, frame: frame }),
      None -> accumulator,
    })

fn never_raises(operator: Bytes) -> Bool =
  [
    b"or",
    b"and",
    b"eq",
    b"ne",
    b"lt",
    b"le",
    b"gt",
    b"ge",
    b"bitor",
    b"bitxor",
    b"bitand",
    b"concat",
  ].contains(
    operator,
  )

type Walk = { s: Scope, st: OwnershipState, at: Int }

fn live(b: Binding) -> Bool = b.owned && b.consumed == None && b.taken.len() == 0

fn released_values(state: OwnershipState, b: Binding) -> List<ReleaseTarget> =
  match b.kind {
    Value -> [{ owning_package: b.owning_package, ty: b.ty }],
    OwningFunction ->
      b.captured_resources.fold([], |accumulator: List<ReleaseTarget>, site: Int|
        match state.bindings.get(site) {
          Some(x) -> accumulator.push({ owning_package: x.owning_package, ty: x.ty }),
          None -> accumulator,
        }),
    Continuation -> [],
  }

fn resource_keys(state: OwnershipState, keys: List<Int>) -> List<Int> =
  keys.fold([], |accumulator: List<Int>, key: Int|
    match state.bindings.get(key) {
      Some(x) -> if x.kind == OwningFunction {
        x.captured_resources.fold(accumulator, |ys: List<Int>, k: Int| ys.push_unique(k))
      } else { accumulator.push_unique(key) },
      None -> accumulator,
    })

fn add_releases(
  state: OwnershipState,
  targets: List<ReleaseTarget>,
  at: Span,
  place: ReleasePlace,
  w: ReleaseContext,
) -> OwnershipState =
  {
    ..state,
    releases: targets.fold(state.releases, |accumulator: List<Release>, x: ReleaseTarget|
      accumulator.push({
        holder: x.owning_package,
        ty: x.ty,
        at: at,
        place: place,
        effects: w.effects,
        returned: w.handled_operations,
      })),
  }

fn release_point(
  state: OwnershipState,
  b: Binding,
  last: WalkedExpression,
) -> { at: Span, place: ReleasePlace } =
  {
    at: last.span,
    place: if mentions_binding(state, last, b) { ReleaseAfter } else { ReleaseBefore },
  }

fn mentions_binding(state: OwnershipState, e: WalkedExpression, b: Binding) -> Bool = {
  let keys = state.bindings.fold([b.key], |accumulator: List<Int>, key: Int, x: Binding|
    if x.borrows.contains(b.key) || x.captured_resources.contains(b.key) { accumulator.push(key) }
    else { accumulator });
  walked_expression_nodes_folded(e, false, |found: Bool, x: WalkedExpression|
    found
      || (match x.node {
        WalkedRead(WalkedLocal(l)) -> keys.contains(binding_key(l.binder)),
        _ -> false,
      }))
}

fn release_before_last(state: OwnershipState, s: Scope, last: WalkedExpression) -> OwnershipState =
  s.block.reverse().fold(state, |accumulator: OwnershipState, key: Int|
    match accumulator.bindings.get(key) {
      Some(b) -> if !live(b) || mentions_binding(accumulator, last, b) { accumulator } else {
        release_binding(
          consume(accumulator, b, last.span, b"let go before its block's last expression"),
          b,
          last.span,
          ReleaseBefore,
          [],
        )
      },
      None -> accumulator,
    })

fn release_on_exit(
  f: Facts,
  state: OwnershipState,
  sites: List<Int>,
  at: WalkedExpression,
  usage: Usage,
) -> OwnershipState / {abort.raise} = {
  let value = owned_result(f, at, ReleaseAfter, usage);
  let leaving = sites.reverse().fold(state, |accumulator: OwnershipState, site: Int|
    match accumulator.bindings.get(site) {
      Some(b) -> if !live(b) { accumulator } else {
        release_binding(
          consume(accumulator, b, at.span, b"dropped when control leaves its block early"),
          b,
          at.span,
          ReleaseAfter,
          value,
        )
      },
      None -> accumulator,
    });
  { ..state, releases: leaving.releases }
}

fn release_on_failure(s: Scope, state: OwnershipState, at: Span) -> OwnershipState =
  failing(s, state, at, ReleaseUnwinding)

fn failing(s: Scope, state: OwnershipState, at: Span, place: ReleasePlace) -> OwnershipState = {
  let check_ownership = state.bindings.fold(
    [],
    |accumulator: List<ReleaseTarget>, site: Int, b: Binding|
      if b.frame == s.frame && live(b) { accumulator.concat(released_values(state, b)) }
      else { accumulator },
  );
  add_releases(
    state,
    state.in_flight.reverse().concat(check_ownership),
    at,
    place,
    release_context(s),
  )
}

fn bind(
  b: ScopedState,
  name: Bytes,
  at: Span,
  ty: Type,
  followed: Bool,
  check_ownership: Bool,
) -> ScopedState = bind_as(b, name, at, ty, followed, check_ownership, Value)

fn bind_as(
  b: ScopedState,
  name: Bytes,
  at: Span,
  ty: Type,
  followed: Bool,
  check_ownership: Bool,
  kind: Kind,
) -> ScopedState =
  if !followed { b } else {
    let key = binding_key(at.site);
    let w = release_context(b.s);
    {
      s: { ..b.s, block: b.s.block.push(key) },
      st: store_binding(b.st, {
        key: key,
        owning_package: BinderHolder(at.site),
        name: name,
        at: at,
        ty: ty,
        kind: kind,
        owned: check_ownership,
        depth: b.s.functions.len(),
        frame: b.s.frame,
        consumed: None,
        taken: [],
        borrows: [],
        captured_resources: [],
        effects: w.effects,
        returned: w.handled_operations,
      }),
    }
  }

fn release_context(s: Scope) -> ReleaseContext =
  {
    effects: s.effects,
    handled_operations: s.handles.fold([], |accumulator: List<Bytes>, h: EnclosingHandle|
      if h.body == s.body { accumulator.concat(h.operations) } else { accumulator }),
  }

fn binding_of(state: OwnershipState, l: { name: Bytes, binder: Int }) -> Option<Binding> =
  state.bindings.get(binding_key(l.binder))

fn binding_read(s: Scope, state: OwnershipState, e: WalkedExpression) -> Option<Binding> =
  match e.node { WalkedRead(WalkedLocal(l)) -> binding_of(state, l), _ -> None }

fn store_binding(state: OwnershipState, b: Binding) -> OwnershipState =
  { ..state, bindings: state.bindings.insert(b.key, b) }

fn report(state: OwnershipState, d: Diagnostic) -> OwnershipState =
  { ..state, diagnostics: state.diagnostics.push(d) }

fn consume(state: OwnershipState, b: Binding, span: Span, how: Bytes) -> OwnershipState =
  store_binding(state, { ..b, consumed: Some({ at: span, how: how }) })

fn check_use(
  f: Facts,
  s: Scope,
  state: OwnershipState,
  b: Binding,
  span: Span,
  usage: Usage,
) -> OwnershipState / {abort.raise} = {
  let enclosing_functions = s.functions.drop(b.depth);
  let called = match usage { Called -> true, _ -> false };
  let once = match b.ty { FunctionType(t) -> t.once, _ -> false };
  let use = if !called { usage } else if b.owned || once { Moved(b"called") } else { Borrowed };
  match b.consumed {
    Some(g) -> report(state, used_after_consumed(f, b, span, g)),
    None -> match consumed_borrowed_from(state, b) {
      Some(borrowed_from) -> report(state, borrow_after_consumed(f, b, span, borrowed_from)),
      None -> if b.taken.len() > 0 && use != Read { report(state, partly_moved(f, b, span)) }
      else if b.kind == OwningFunction && b.owned && !called && use != Read && use != Discarded {
        report(state, owning_function_passed(f, b, span))
      } else {
        match use {
          Moved(how) -> if b.kind == OwningFunction && !b.owned {
            report(state, escaping_borrower_error(f, b, span))
          } else if !b.owned { report(state, consumed_borrowed(f, b, span, how)) } else {
            match enclosing_functions.find(|x: EnclosingFunction| !x.local) {
              Some(fun) ->
                report(consume(state, b, span, how), consumed_in_lambda(f, b, span, fun)),
              None -> record_capture(consume(state, b, span, how), enclosing_functions, b, true),
            }
          },
          Borrowed -> match enclosing_functions.find(|x: EnclosingFunction| x.escapes) {
            Some(fun) -> report(state, escaping_borrow_error(f, b, span, fun)),
            None -> record_capture(state, enclosing_functions, b, false),
          },
          Read -> report(state, resource_copied_error(f, b, span)),
          Discarded -> if b.owned { report(state, dropped_binding(f, b, span)) } else { state },
          Called -> state,
        }
      },
    },
  }
}

fn record_capture(
  state: OwnershipState,
  enclosing_functions: List<EnclosingFunction>,
  b: Binding,
  consumed: Bool,
) -> OwnershipState =
  enclosing_functions.fold(state, |accumulator: OwnershipState, fun: EnclosingFunction|
    if !fun.local { accumulator } else {
      let was = match accumulator.captured.get(fun.span.site) {
        Some(c) -> c,
        None -> { consumed: [], borrows: [] },
      };
      let borrowed = b.borrows.fold(was.borrows, |xs: List<Int>, k: Int| xs.push_unique(k));
      let now = if consumed { { consumed: was.consumed.push_unique(b.key), borrows: borrowed } }
      else { { ..was, borrows: borrowed.push_unique(b.key) } };
      { ..accumulator, captured: accumulator.captured.insert(fun.span.site, now) }
    })

fn consumed_borrowed_from(state: OwnershipState, b: Binding) -> Option<Binding> =
  b.borrows.fold(None, |accumulator: Option<Binding>, k: Int|
    match accumulator {
      Some(_) -> accumulator,
      None -> match state.bindings.get(k) {
        Some(x) -> if x.consumed != None || x.taken.len() > 0 { Some(x) } else { None },
        None -> None,
      },
    })

fn walk(
  f: Facts,
  s: Scope,
  state: OwnershipState,
  e: WalkedExpression,
  usage: Usage,
) -> OwnershipState / {abort.raise} =
  match e.node {
    WalkedLiteral(_) -> state,
    WalkedDefault(_) -> state,
    WalkedRead(WalkedLocal(l)) -> match binding_of(state, l) {
      Some(b) -> check_use(f, s, state, b, e.span, usage),
      None -> state,
    },
    WalkedRead(_) -> state,
    WalkedBinary(b) -> {
      let sides = [b.left_operand, b.right_operand].fold(
        { st: state, left: state },
        |accumulator: { st: OwnershipState, left: OwnershipState }, x: WalkedExpression|
          { st: walk(f, s, accumulator.st, x, Read), left: accumulator.st },
      );
      let both = if b.operation == b"and" || b.operation == b"or" {
        check_guard_consumed(
          f,
          sides.left,
          sides.st,
          b.right_operand.span,
          b"the right of `&&` or `||`, which may not run",
        )
      } else { sides.st };
      if never_raises(b.operation) { both } else { release_on_failure(s, both, e.span) }
    },
    WalkedUnary(u) -> {
      let operand = walk(f, s, state, u.operand, Read);
      if u.operation == b"neg" { release_on_failure(s, operand, e.span) } else { operand }
    },
    WalkedLambda(l) ->
      check_new_value(
        f,
        walk_lambda(f, s, state, e, l, enclosing_function_at(e.span, usage), []).st,
        e,
        usage,
      ),
    WalkedCall(c) ->
      check_new_value(
        f,
        arguments_taken(s, state, walk_call(f, s, state, c.callee, c.args), e.span),
        e,
        usage,
      ),
    WalkedIf(i) -> {
      let c = walk(f, s, state, i.cond, Read);
      let branches = [i.then_branch, i.else_branch];
      join_paths(
        f,
        c,
        [c, c],
        branches.map(|x: WalkedExpression| walk(f, s, c, x, usage)),
        branches,
        usage,
      )
    },
    WalkedMatch(m) -> walk_match(f, s, state, e, m.scrutinee, m.arms, usage),
    WalkedBlock(b) -> {
      let last = b.statements.len() - 1;
      let ends_in_statement = (match b.tail { Some(_) -> false, None -> true })
        && (match b.statements.at(last) { Some(WalkedDo(_)) -> true, _ -> false });
      let walked = b.statements.fold(
        { s: { ..s, block: [], result: usage }, st: state, at: 0 },
        |accumulator: Walk, x: WalkedStatement|
          if ends_in_statement && accumulator.at == last { accumulator } else {
            let o = walk_statement(f, { s: accumulator.s, st: accumulator.st }, x);
            { s: o.s, st: o.st, at: accumulator.at + 1 }
          },
      );
      match b.tail {
        Some(t) ->
          release_scope(
            f,
            check_borrowed_result(
              f,
              walk(f, walked.s, release_before_last(walked.st, walked.s, t), t, usage),
              walked.s,
              t,
              usage,
            ),
            walked.s,
            t,
            e.span,
            usage,
          ),
        None -> match b.statements.at(last) {
          Some(WalkedDo(x)) ->
            release_scope(
              f,
              walk(f, walked.s, release_before_last(walked.st, walked.s, x), x, Discarded),
              walked.s,
              x,
              e.span,
              Discarded,
            ),
          _ -> release_after(walked.st, walked.s.block, e.span),
        },
      }
    },
    WalkedRecord(fs) -> {
      let state_with_values = fs.fold(state, |accumulator: OwnershipState, x: WalkedField|
        put_in_flight(
          f,
          s,
          accumulator,
          walk(f, s, accumulator, x.value, stored_in_record),
          x.value,
          stored_in_record,
        ));
      check_new_value(f, { ..state_with_values, in_flight: state.in_flight }, e, usage)
    },
    WalkedUpdate(u) -> {
      let how = if has_resource_type(f, u.base) { Moved(b"updated into a new record") }
      else { Read };
      let base = match binding_read(s, state, u.base) {
        Some(_) -> {
          let checked = check_overwritten_fields(f, s, state, u.base, u.sets);
          match binding_read(s, checked, u.base) {
            Some(b) -> check_use(f, s, checked, b, u.base.span, how),
            None -> checked,
          }
        },
        None -> check_overwritten_fields(f, s, walk(f, s, state, u.base, how), u.base, u.sets),
      };
      let state_with_values = u.sets.fold(
        put_in_flight(f, s, state, base, u.base, how),
        |accumulator: OwnershipState, x: WalkedField|
          put_in_flight(
            f,
            s,
            accumulator,
            walk(f, s, accumulator, x.value, stored_in_record),
            x.value,
            stored_in_record,
          ),
      );
      check_new_value(f, { ..state_with_values, in_flight: state.in_flight }, e, usage)
    },
    WalkedFieldRead(x) ->
      walk_field(
        f,
        s,
        state,
        match x.base.node {
          WalkedRead(WalkedLocal(_)) -> state,
          _ -> walk(f, s, state, x.base, Borrowed),
        },
        e,
        x.base,
        x.field,
        usage,
      ),
    WalkedList(items) -> {
      let how = Moved(b"stored in a list");
      let state_with_values = items.fold(
        state,
        |accumulator: OwnershipState, x: WalkedExpression|
          put_in_flight(f, s, accumulator, walk(f, s, accumulator, x, how), x, how),
      );
      check_new_value(f, { ..state_with_values, in_flight: state.in_flight }, e, usage)
    },
    WalkedPerform(p) -> {
      let consumed_parameters = f.operation_consumed_parameters(p.effect, p.operation);
      let how = Bytes::concat_all([
        b"handed to `",
        simple_name_of(p.effect),
        b".",
        p.operation,
        b"`, which consumes the value",
      ]);
      let args = p.args.fold(
        { st: state, at: 0 },
        |accumulator: { st: OwnershipState, at: Int }, x: WalkedExpression|
          {
            st: {
              let usage = if consumed_parameters.contains(accumulator.at) { Moved(how) }
              else { Borrowed };
              put_in_flight(f, s, accumulator.st, walk(f, s, accumulator.st, x, usage), x, usage)
            },
            at: accumulator.at + 1,
          },
      ).st;
      check_new_value(f, arguments_taken(s, state, args, e.span), e, usage)
    },
    WalkedHandle(h) -> walk_handle(f, s, state, e, h, usage),
    WalkedSimulate(t) ->
      release_on_failure(
        s,
        walk(
          f,
          {
            ..isolated_scope(s, t.body.span),
            handles: s.handles.push({ operations: simulated_operations, body: s.body }),
          },
          { ..state, in_flight: [] },
          t.body,
          usage,
        ),
        e.span,
      ),
    WalkedParallel(ts) -> {
      let how = Moved(b"returned by a branch");
      let state_with_values = ts.fold(state, |accumulator: OwnershipState, t: WalkedThunk|
        {
          ..walk(f, isolated_scope(s, t.body.span), { ..accumulator, in_flight: [] }, t.body, how),
          in_flight: accumulator.in_flight,
        });
      check_new_value(f, release_on_failure(s, state_with_values, e.span), e, usage)
    },
  }

fn isolated_scope(s: Scope, at: Span) -> Scope =
  {
    ..s,
    functions: s.functions.push({ span: at, escapes: false, local: false }),
    frame: 0 - at.site - 1,
  }

fn release_after_handler(
  before: OwnershipState,
  after: OwnershipState,
  at: Span,
  w: ReleaseContext,
) -> OwnershipState = {
  let staying = before.bindings.fold(
    before.in_flight,
    |accumulator: List<ReleaseTarget>, key: Int, b: Binding|
      if !live(b) { accumulator } else {
        match after.bindings.get(key) {
          Some(y) -> if live(y) { accumulator.concat(released_values(after, y)) }
          else { accumulator },
          None -> accumulator,
        }
      },
  );
  let holders = staying.map(|x: ReleaseTarget| x.owning_package);
  add_releases(
    {
      ..after,
      releases: before.releases.concat(
        after.releases.drop(before.releases.len()).filter(|r: Release|
          !on_failure(r.place) || !holders.contains(r.holder)),
      ),
    },
    staying,
    at,
    ReleaseUnwinding,
    w,
  )
}

const stored_in_record: Usage = Moved(b"stored in a record")

fn check_overwritten_fields(
  f: Facts,
  s: Scope,
  state: OwnershipState,
  base: WalkedExpression,
  sets: List<WalkedField>,
) -> OwnershipState / {abort.raise} = {
  let resources = match record_fields(type_of(f, base)) {
    Some(fs) -> fs.filter(|x: Field| f.resource(x.ty)).map(|x: Field| x.name),
    None -> [],
  };
  let written = sets.filter(|x: WalkedField| resources.contains(x.name));
  let record_binding = binding_read(s, state, base);
  let moved = match record_binding { Some(b) -> b.taken, None -> [] };
  let rejected = written.fold(state, |accumulator: OwnershipState, x: WalkedField|
    if moved.contains(x.name) { accumulator }
    else { report(accumulator, written_over(f, x.name, x.value.span)) });
  match record_binding {
    Some(b) -> if moved.len() > 0 && moved.all(|n: Bytes| sets.any(|x: WalkedField| x.name == n)) {
      store_binding(rejected, { ..b, taken: [] })
    } else { rejected },
    None -> rejected,
  }
}

fn put_in_flight(
  f: Facts,
  s: Scope,
  state: OwnershipState,
  walked: OwnershipState,
  x: WalkedExpression,
  usage: Usage,
) -> OwnershipState / {abort.raise} = {
  let flying = |targets: List<ReleaseTarget>|
    { ..walked, in_flight: walked.in_flight.concat(targets) };
  match usage {
    Moved(_) -> match x.node {
      WalkedRead(WalkedLocal(l)) -> match binding_of(state, l) {
        Some(b) -> if live(b) && b.frame == s.frame { flying(released_values(state, b)) }
        else { walked },
        None -> walked,
      },
      _ -> {
        let t = type_of(f, x);
        if f.resource(t) { flying([{ owning_package: NodeHolder(x.span.site), ty: t }]) }
        else { walked }
      },
    },
    _ -> walked,
  }
}

fn arguments_taken(
  s: Scope,
  before: OwnershipState,
  after: OwnershipState,
  at: Span,
) -> OwnershipState = release_on_failure(s, { ..after, in_flight: before.in_flight }, at)

fn check_new_value(
  f: Facts,
  state: OwnershipState,
  e: WalkedExpression,
  usage: Usage,
) -> OwnershipState / {abort.raise} =
  match usage {
    Moved(_) -> state,
    _ -> if has_resource_type(f, e) { report(state, new_resource_dropped(f, e, usage)) }
    else { state },
  }

fn enclosing_function_at(span: Span, usage: Usage) -> EnclosingFunction =
  match usage {
    Borrowed -> { span: span, escapes: false, local: false },
    _ -> { span: span, escapes: true, local: false },
  }

fn walk_call(
  f: Facts,
  s: Scope,
  state: OwnershipState,
  function: WalkedExpression,
  args: List<WalkedExpression>,
) -> OwnershipState / {abort.raise} =
  match function.node {
    WalkedRead(WalkedLocal(l)) -> match binding_of(state, l) {
      Some(b) -> {
        let called = check_use(f, s, state, b, function.span, Called);
        let flying = if b.owned && live(b) && b.frame == s.frame {
          { ..called, in_flight: called.in_flight.concat(released_values(state, b)) }
        } else { called };
        let calling = if b.kind == Continuation { { taking: all_taken, params: [] } }
        else { value_call_modes(f, function) };
        walk_arguments(f, s, flying, calling, args)
      },
      None -> walk_arguments(f, s, state, value_call_modes(f, function), args),
    },
    WalkedRead(WalkedDefinition(d)) -> walk_arguments(f, s, state, named(f, function, d.key), args),
    WalkedRead(WalkedBuiltin(b)) -> walk_arguments(f, s, state, named(f, function, b.name), args),
    WalkedRead(WalkedConstructor(_)) ->
      walk_arguments(f, s, state, { taking: all_taken, params: [] }, args),
    WalkedFieldRead(x) ->
      walk_arguments(
        f,
        s,
        walk(f, s, state, x.base, Borrowed),
        value_call_modes(f, function),
        args,
      ),
    _ ->
      walk_arguments(f, s, walk(f, s, state, function, Read), value_call_modes(f, function), args),
  }

const all_taken: ArgumentModes = { taken_indices: [], all: true }

type CallModes = { taking: ArgumentModes, params: List<Type> }

fn named(f: Facts, function: WalkedExpression, key: Bytes) -> CallModes / {abort.raise} =
  match f.taking(key) {
    Some(t) ->
      {
        taking: t,
        params: match type_of(f, function) { FunctionType(fnt) -> fnt.params, _ -> [] },
      },
    None -> value_call_modes(f, function),
  }

fn value_call_modes(f: Facts, function: WalkedExpression) -> CallModes / {abort.raise} =
  match type_of(f, function) {
    FunctionType(t) ->
      { taking: { taken_indices: t.keep_parameters, all: false }, params: t.params },
    _ -> { taking: { taken_indices: [], all: false }, params: [] },
  }

fn walk_arguments(
  f: Facts,
  s: Scope,
  state: OwnershipState,
  c: CallModes,
  args: List<WalkedExpression>,
) -> OwnershipState / {abort.raise} =
  args.fold(
    { st: state, at: 0 },
    |accumulator: { st: OwnershipState, at: Int }, x: WalkedExpression|
      {
        st: walk_argument(
          f,
          s,
          accumulator.st,
          x,
          takes_argument(c.taking, accumulator.at),
          c.params.at(accumulator.at),
        ),
        at: accumulator.at + 1,
      },
  ).st

fn walk_argument(
  f: Facts,
  s: Scope,
  state: OwnershipState,
  arg: WalkedExpression,
  keep: Bool,
  ty: Option<Type>,
) -> OwnershipState / {abort.raise} = {
  let usage = if keep { Moved(b"passed to a `keep` parameter") } else { Borrowed };
  match arg.node {
    WalkedLambda(l) ->
      walk_lambda(f, s, state, arg, l, enclosing_function_at(arg.span, usage), match ty {
        Some(FunctionType(t)) -> t.keep_parameters,
        _ -> [],
      }).st,
    _ -> put_in_flight(f, s, state, walk(f, s, state, arg, usage), arg, usage),
  }
}

fn walk_field(
  f: Facts,
  s: Scope,
  state: OwnershipState,
  based: OwnershipState,
  e: WalkedExpression,
  base: WalkedExpression,
  name: Bytes,
  usage: Usage,
) -> OwnershipState / {abort.raise} =
  match binding_read(s, state, base) {
    Some(b) -> if !has_resource_type(f, e) {
      if b.consumed != None && b.taken.len() == 0 { check_use(f, s, state, b, base.span, Borrowed) }
      else { state }
    } else {
      match usage {
        Moved(how) -> if b.taken.contains(name) { report(state, field_twice(f, b, name, e.span)) }
        else if !b.owned || b.consumed != None || b.taken.len() > 0 {
          check_use(f, s, state, b, base.span, Moved(how))
        } else if has_other_resources(f, base, name) {
          report(state, field_move_error(f, b, name, e.span))
        } else {
          match s.functions.drop(b.depth).at(0) {
            Some(fun) -> report(state, consumed_in_lambda(f, b, e.span, fun)),
            None -> store_binding(state, { ..b, taken: b.taken.push(name) }),
          }
        },
        _ -> check_use(f, s, state, b, base.span, usage),
      }
    },
    None -> match base.node {
      WalkedRead(WalkedLocal(_)) -> state,
      _ -> match usage {
        Moved(how) -> if !has_resource_type(f, e) { based } else {
          match path_root(s, state, base) {
            Some(b) -> if b.owned { report(based, moved_through(f, b, name, e.span)) }
            else { report(based, consumed_borrowed(f, b, e.span, how)) },
            None -> based,
          }
        },
        _ -> based,
      },
    },
  }

fn path_root(s: Scope, state: OwnershipState, e: WalkedExpression) -> Option<Binding> =
  match e.node {
    WalkedRead(WalkedLocal(l)) -> binding_of(state, l),
    WalkedFieldRead(x) -> path_root(s, state, x.base),
    _ -> None,
  }

fn has_other_resources(f: Facts, base: WalkedExpression, name: Bytes) -> Bool / {abort.raise} =
  match record_fields(type_of(f, base)) {
    Some(fs) -> fs.any(|x: Field| x.name != name && f.resource(x.ty)),
    None -> true,
  }

fn walk_lambda(
  f: Facts,
  s: Scope,
  state: OwnershipState,
  e: WalkedExpression,
  l: { params: List<TypedParam<Type>>, owned_parameters: List<Int>, body: WalkedExpression, effects: Effects },
  fun: EnclosingFunction,
  given: List<Int>,
) -> { st: OwnershipState, captured: Captures } / {abort.raise} = {
  let inner: ScopedState = {
    s: {
      ..s,
      functions: s.functions.push(fun),
      block: [],
      frame: e.span.site,
      body: e.span.site,
      effects: Some(l.effects),
    },
    st: { ..state, in_flight: [] },
  };
  let params = range(0, l.params.len()).fold(inner, |accumulator: ScopedState, i: Int| {
    let p = l.params.get(i);
    let t = f.resolved(p.ty);
    bind(
      accumulator,
      p.name,
      p.span,
      t,
      f.resource(t),
      l.owned_parameters.contains(i) || given.contains(i),
    )
  });
  let body = release_scope(
    f,
    walk(f, params.s, release_before_last(params.st, params.s, l.body), l.body, Moved(b"answered")),
    params.s,
    l.body,
    l.body.span,
    Moved(b"answered"),
  );
  {
    st: { ..body, in_flight: state.in_flight },
    captured: match body.captured.get(e.span.site) {
      Some(c) -> c,
      None -> { consumed: [], borrows: [] },
    },
  }
}

fn walk_statement(f: Facts, b: ScopedState, x: WalkedStatement) -> ScopedState / {abort.raise} =
  match x {
    WalkedLet(l) -> match ((l.value.node, l.pattern)) {
      (WalkedLambda(lam), TypedBinder(v)) -> bind_lambda(f, b, v.name, v.span, l.value, lam),
      _ -> {
        let valued = walk(f, b.s, b.st, l.value, let_usage(f, b, l.pattern, l.value));
        bind_pattern(
          f,
          { ..b, st: release_on_miss(f, b.s, valued, l.pattern, l.value) },
          l.pattern,
          l.value,
        )
      },
    },
    WalkedLetElse(l) -> {
      let valued = walk(f, b.s, b.st, l.value, let_usage(f, b, l.pattern, l.value));
      let missed = add_releases(
        valued,
        missed_value_releases(f, b, l.value),
        l.fallback.span,
        ReleaseBefore,
        release_context(b.s),
      );
      let walked = check_borrowed_result(
        f,
        walk(f, b.s, release_before_last(missed, b.s, l.fallback), l.fallback, b.s.result),
        b.s,
        l.fallback,
        b.s.result,
      );
      let fallback = check_outer_consumed(
        f,
        valued,
        walked,
        release_on_exit(f, walked, b.s.block, l.fallback, b.s.result),
        b.s.block,
        l.fallback.span,
      );
      bind_pattern(
        f,
        { ..b, st: { ..valued, diagnostics: fallback.diagnostics, releases: fallback.releases } },
        l.pattern,
        l.value,
      )
    },
    WalkedDo(e) -> { ..b, st: walk(f, b.s, b.st, e, Discarded) },
    WalkedAssign(a) ->
      { ..b, st: walk(f, b.s, b.st, a.value, Moved(b"assigned to a handler's variable")) },
  }

fn bind_lambda(
  f: Facts,
  b: ScopedState,
  name: Bytes,
  at: Span,
  e: WalkedExpression,
  l: { params: List<TypedParam<Type>>, owned_parameters: List<Int>, body: WalkedExpression, effects: Effects },
) -> ScopedState / {abort.raise} = {
  let local: EnclosingFunction = { span: e.span, escapes: false, local: true };
  let first = walk_lambda(f, b.s, b.st, e, l, local, []);
  let o = if first.captured.consumed.len() == 0 { first } else {
    walk_lambda(f, b.s, move_to_frame(b.st, first.captured.consumed, e.span.site), e, l, local, [])
  };
  let consumed = o.captured.consumed.len() > 0;
  let followed = consumed || o.captured.borrows.len() > 0;
  let out = bind_as({ ..b, st: o.st }, name, at, type_of(f, e), followed, consumed, OwningFunction);
  match out.st.bindings.get(binding_key(at.site)) {
    Some(x) -> if followed {
      {
        ..out,
        st: store_binding(out.st, {
          ..x,
          borrows: o.captured.borrows,
          captured_resources: resource_keys(out.st, o.captured.consumed),
        }),
      }
    } else { out },
    None -> out,
  }
}

fn let_usage(
  f: Facts,
  b: ScopedState,
  pattern: TypedPattern<Type>,
  value: WalkedExpression,
) -> Usage / {abort.raise} =
  if is_borrowed_value(b.s, b.st, value) { Borrowed }
  else if binds_resource(f, pattern) || has_resource_type(f, value) || f.opened(type_of(f, value)) {
    Moved(b"bound by a `let`")
  } else { Read }

fn bind_pattern(
  f: Facts,
  b: ScopedState,
  pattern: TypedPattern<Type>,
  value: WalkedExpression,
) -> ScopedState / {abort.raise} = {
  let check_ownership = !is_borrowed_value(b.s, b.st, value);
  let checked = if check_ownership { check_wildcard_resources(f, b.st, pattern) } else { b.st };
  binders(f, pattern).fold(
    { s: b.s, st: checked },
    |accumulator: ScopedState, p: { name: Bytes, span: Span, ty: Type }|
      bind(accumulator, p.name, p.span, p.ty, f.resource(p.ty), check_ownership),
  )
}

fn missed_value_releases(
  f: Facts,
  b: ScopedState,
  value: WalkedExpression,
) -> List<ReleaseTarget> / {abort.raise} =
  if !has_resource_type(f, value) || is_borrowed_value(b.s, b.st, value) { [] } else {
    match binding_read(b.s, b.st, value) {
      Some(x) -> if live(x) { released_values(b.st, x) } else { [] },
      None -> match value.node {
        WalkedRead(WalkedLocal(_)) -> [],
        _ -> [{ owning_package: NodeHolder(value.span.site), ty: type_of(f, value) }],
      },
    }
  }

fn release_on_miss(
  f: Facts,
  s: Scope,
  state: OwnershipState,
  pattern: TypedPattern<Type>,
  value: WalkedExpression,
) -> OwnershipState / {abort.raise} =
  if !refutable(pattern) { state } else {
    let t = type_of(f, value);
    let whole = if f.resource(t) && !is_borrowed_value(s, state, value) {
      [{ owning_package: NodeHolder(value.span.site), ty: t }]
    } else { [] };
    {
      ..failing(s, { ..state, in_flight: state.in_flight.concat(whole) }, value.span, ReleaseMissing),
      in_flight: state.in_flight,
    }
  }

fn refutable(pattern: TypedPattern<Type>) -> Bool =
  match pattern {
    TypedBinder(_) -> false,
    TypedWild(_) -> false,
    TypedRecordPattern(r) -> r.fields.any(|x: TypedFieldPattern<Type>| refutable(x.pattern)),
    _ -> true,
  }

fn is_borrowed_value(s: Scope, state: OwnershipState, value: WalkedExpression) -> Bool =
  match value.node {
    WalkedRead(WalkedLocal(l)) -> match binding_of(state, l) { Some(b) -> !b.owned, None -> false },
    WalkedFieldRead(x) -> is_borrowed_value(s, state, x.base),
    _ -> false,
  }

fn binders(
  f: Facts,
  pattern: TypedPattern<Type>,
) -> List<{ name: Bytes, span: Span, ty: Type }> / {abort.raise} =
  pattern_binders(pattern).map(|p: TypedParam<Type>| { ..p, ty: f.resolved(p.ty) })

fn binds_resource(f: Facts, pattern: TypedPattern<Type>) -> Bool / {abort.raise} =
  binders(f, pattern).any(|p: { name: Bytes, span: Span, ty: Type }| f.resource(p.ty))

fn check_wildcard_resources(
  f: Facts,
  state: OwnershipState,
  pattern: TypedPattern<Type>,
) -> OwnershipState / {abort.raise} =
  match pattern {
    TypedWild(w) -> if f.resource(f.resolved(w.ty)) { report(state, wildcard_resource(f, w.span)) }
    else { state },
    TypedCase(c) ->
      c.args.fold(state, |accumulator: OwnershipState, a: TypedPattern<Type>|
        check_wildcard_resources(f, accumulator, a)),
    TypedRecordPattern(r) -> {
      let named = r.fields.fold(state, |accumulator: OwnershipState, x: TypedFieldPattern<Type>|
        check_wildcard_resources(f, accumulator, x.pattern));
      if !r.rest { named } else {
        let left = match record_fields(f.resolved(r.ty)) {
          Some(fs) ->
            fs.filter(|x: Field|
              f.resource(x.ty) && !r.fields.any(|y: TypedFieldPattern<Type>| y.name == x.name)),
          None -> [],
        };
        if left.len() == 0 { named } else { report(named, rest_dropped(f, r.span)) }
      }
    },
    TypedListPattern(l) -> {
      let items = l.items.fold(state, |accumulator: OwnershipState, a: TypedPattern<Type>|
        check_wildcard_resources(f, accumulator, a));
      match l.rest {
        Some(TypedWild(w)) -> if f.resource(f.resolved(w.ty)) {
          report(items, rest_dropped(f, w.span))
        } else { items },
        Some(p) -> check_wildcard_resources(f, items, p),
        None -> items,
      }
    },
    TypedOr(alts) ->
      alts.fold(state, |accumulator: OwnershipState, a: TypedPattern<Type>|
        check_wildcard_resources(f, accumulator, a)),
    _ -> state,
  }

fn join_paths(
  f: Facts,
  before: OwnershipState,
  starts: List<OwnershipState>,
  ends: List<OwnershipState>,
  branches: List<WalkedExpression>,
  usage: Usage,
) -> OwnershipState / {abort.raise} = {
  let ending = range(0, ends.len()).map(|i: Int| {
    let branch = branches.get(i);
    let unconsumed = before.bindings.fold([], |accumulator: List<Binding>, key: Int, b: Binding|
      if !live(b)
          || !ends.any(|x: OwnershipState|
            match x.bindings.get(key) { Some(y) -> y.consumed != None, None -> false }) {
        accumulator
      } else {
        match ends.get(i).bindings.get(key) {
          Some(y) -> if y.consumed == None && y.taken.len() == 0 { accumulator.push(b) }
          else { accumulator },
          None -> accumulator,
        }
      });
    let early = unconsumed.filter(|b: Binding|
      release_point(before, b, branch).place == ReleaseBefore);
    let late = unconsumed.filter(|b: Binding|
      release_point(before, b, branch).place == ReleaseAfter);
    let at = branch.span;
    let letting = |from: OwnershipState, bs: List<Binding>, place: ReleasePlace, value: List<ReleaseTarget>|
      bs.fold(from, |x: OwnershipState, b: Binding|
        match x.bindings.get(b.key) {
          Some(z) ->
            release_binding(
              consume(x, z, at, b"dropped in a branch that does not consume it"),
              z,
              at,
              place,
              value,
            ),
          None -> x,
        });
    let first = letting({ ..starts.get(i), releases: [] }, early, ReleaseBefore, []);
    let ended = early.fold({ ..ends.get(i), releases: [] }, |x: OwnershipState, b: Binding|
      match x.bindings.get(b.key) {
        Some(z) -> consume(x, z, at, b"let go before its branch"),
        None -> x,
      });
    let last = letting(ended, late, ReleaseAfter, owned_result(f, branch, ReleaseAfter, usage));
    let borrowed = match usage { Borrowed -> true, Read -> true, _ -> false };
    let rejected = if !borrowed || !has_resource_type(f, branch) { [] } else {
      late.filter(|b: Binding| may_return_binding(branch, b.key)).map(|b: Binding|
        new_resource_dropped(f, branch, usage))
    };
    { first: first.releases, last: last.releases, rejected: rejected }
  });
  let merged = ends.fold(
    { st: before, at: 0 },
    |w: { st: OwnershipState, at: Int }, x: OwnershipState| {
      let accumulator = w.st;
      let mine = ending.get(w.at);
      let first = mine.first.filter(|r: Release| r.place == ReleaseBefore).map(|r: Release|
        r.holder);
      let fails = |r: Release| on_failure(r.place) && first.contains(r.holder);
      {
        st: {
          module: accumulator.module,
          bindings: x.bindings.fold(
            accumulator.bindings,
            |m: Map<Int, Binding>, key: Int, b: Binding|
              match m.get(key) {
                Some(was) -> if was.consumed == None
                    && (b.consumed != None || was.taken.len() < b.taken.len()) { m.insert(key, b) }
                else { m },
                None -> m.insert(key, b),
              },
          ),
          diagnostics: accumulator.diagnostics.concat(
            x.diagnostics.drop(before.diagnostics.len()),
          ).concat(
            mine.rejected,
          ),
          releases: accumulator.releases.concat(mine.first).concat(
            x.releases.drop(before.releases.len()).filter(|r: Release| !fails(r)),
          ).concat(
            mine.last,
          ),
          in_flight: accumulator.in_flight,
          captured: x.captured.fold(
            accumulator.captured,
            |m: Map<Int, Captures>, k: Int, c: Captures|
              match m.get(k) {
                Some(was) ->
                  m.insert(k, {
                    consumed: c.consumed.fold(was.consumed, |xs: List<Int>, i: Int|
                      xs.push_unique(i)),
                    borrows: c.borrows.fold(was.borrows, |bs: List<Int>, i: Int| bs.push_unique(i)),
                  }),
                None -> m.insert(k, c),
              },
          ),
        },
        at: w.at + 1,
      }
    },
  ).st;
  before.bindings.fold(merged, |accumulator: OwnershipState, key: Int, b: Binding| {
    let after = ends.map(|x: OwnershipState| x.bindings.get(key));
    let moved = after.any(|y: Option<Binding>|
      match y { Some(z) -> z.consumed == None && z.taken.len() > 0, None -> false });
    let whole = after.any(|y: Option<Binding>| match y { Some(z) -> live(z), None -> false });
    if live(b) && moved && whole { report(accumulator, moved_on_one_path(accumulator.module, b)) }
    else { accumulator }
  })
}

fn walk_match(
  f: Facts,
  s: Scope,
  state: OwnershipState,
  e: WalkedExpression,
  scrutinee: WalkedExpression,
  arms: List<WalkedArm>,
  usage: Usage,
) -> OwnershipState / {abort.raise} = {
  let at = scrutinee.span;
  let scrutinee_binding = binding_read(s, state, scrutinee);
  let ty = type_of(f, scrutinee);
  let opened = f.opened(ty);
  let through = match scrutinee.node {
    WalkedFieldRead(_) ->
      is_borrowed_value(s, state, scrutinee)
        || (!opened && !arms.any(|a: WalkedArm| binds_resource(f, a.pattern))),
    _ -> false,
  };
  let local = match scrutinee.node { WalkedRead(WalkedLocal(_)) -> true, _ -> false };
  let made = scrutinee_binding == None && !local && !through && f.resource(ty);
  let start: OwnershipState = match scrutinee_binding {
    Some(b) -> check_use(f, s, state, b, at, Borrowed),
    None -> if made {
      store_binding(walk(f, s, state, scrutinee, Moved(b"matched")), {
        key: at.site,
        owning_package: NodeHolder(at.site),
        name: b"the matched value",
        at: at,
        ty: ty,
        kind: Value,
        owned: true,
        depth: s.functions.len(),
        frame: s.frame,
        consumed: None,
        taken: [],
        borrows: [],
        captured_resources: [],
        effects: s.effects,
        returned: release_context(s).handled_operations,
      })
    } else { walk(f, s, state, scrutinee, if through { Borrowed } else { Read }) },
  };
  let key = match scrutinee_binding {
    Some(b) -> if b.owned { Some(b.key) } else { None },
    None -> if made { Some(at.site) } else { None },
  };
  let check_ownership = match scrutinee_binding { Some(b) -> b.owned, None -> made };
  let ends = arms.map(|a: WalkedArm| {
    let binds = opened || binds_resource(f, a.pattern);
    let taken: OwnershipState = match key {
      Some(k) -> if binds {
        match start.bindings.get(k) {
          Some(b) ->
            check_wildcard_resources(
              f,
              consume(start, b, a.pattern_span, b"destructured by a `match` arm"),
              a.pattern,
            ),
          None -> start,
        }
      } else { start },
      None -> start,
    };
    let inner = binders(f, a.pattern).fold(
      { s: { ..s, block: [] }, st: taken },
      |accumulator: ScopedState, p: { name: Bytes, span: Span, ty: Type }|
        bind(accumulator, p.name, p.span, p.ty, f.resource(p.ty), check_ownership),
    );
    let guarded = match a.guard {
      Some(g) ->
        check_guard_consumed(
          f,
          inner.st,
          walk(f, inner.s, inner.st, g, Read),
          g.span,
          b"a guard, which passes the value on to the next arm when the guard fails",
        ),
      None -> inner.st,
    };
    {
      start: guarded,
      end: release_scope(
        f,
        check_borrowed_result(
          f,
          walk(f, inner.s, release_before_last(guarded, inner.s, a.body), a.body, usage),
          inner.s,
          a.body,
          usage,
        ),
        inner.s,
        a.body,
        a.body.span,
        usage,
      ),
    }
  });
  let out = join_paths(
    f,
    start,
    ends.map(|x: { start: OwnershipState, end: OwnershipState }| x.start),
    ends.map(|x: { start: OwnershipState, end: OwnershipState }| x.end),
    arms.map(|a: WalkedArm| a.body),
    usage,
  );
  match if made { out.bindings.get(at.site) } else { None } {
    Some(b) -> if b.consumed != None { out } else {
      consume(
        release_on_exit(f, out, [at.site], e, usage),
        b,
        e.span,
        b"let go where the `match` ends",
      )
    },
    None -> out,
  }
}

fn check_outer_consumed(
  f: Facts,
  before: OwnershipState,
  after: OwnershipState,
  out: OwnershipState,
  block: List<Int>,
  at: Span,
) -> OwnershipState =
  before.bindings.fold(out, |accumulator: OwnershipState, key: Int, b: Binding|
    match after.bindings.get(key) {
      Some(y) -> if live(b) && !live(y) && !block.contains(key) {
        report(accumulator, fallback_consumed(f, b, at))
      } else { accumulator },
      None -> accumulator,
    })

fn check_guard_consumed(
  f: Facts,
  before: OwnershipState,
  after: OwnershipState,
  at: Span,
  what: Bytes,
) -> OwnershipState =
  before.bindings.fold(after, |accumulator: OwnershipState, key: Int, b: Binding|
    match after.bindings.get(key) {
      Some(y) -> if live(b) && !live(y) {
        report(store_binding(accumulator, b), guard_consumed(f, b, at, what))
      } else { accumulator },
      None -> accumulator,
    })

fn walk_handle(
  f: Facts,
  s: Scope,
  state: OwnershipState,
  e: WalkedExpression,
  h: { body: WalkedExpression, effects: Effects, clauses: List<WalkedClause>, return_clause: Option<WalkedReturn>, variables: List<WalkedHandlerVariable> },
  usage: Usage,
) -> OwnershipState / {abort.raise} = {
  let operation_names = h.clauses.map(|c: WalkedClause|
    Bytes::concat_all([c.effect, b".", c.operation]));
  let handler_scope = h.variables.fold(
    { s: s, st: state },
    |accumulator: ScopedState, v: WalkedHandlerVariable| {
      let is_resource = has_resource_type(f, v.init);
      let walked = walk(f, accumulator.s, accumulator.st, v.init, if is_resource {
        Moved(b"stored in a handler's variable")
      } else { Read });
      {
        ..accumulator,
        st: if is_resource { report(walked, handler_variable_resource(f, v)) } else { walked },
      }
    },
  );
  let inside = release_after_handler(
    handler_scope.st,
    walk(
      f,
      { ..s, handles: s.handles.push({ operations: operation_names, body: s.body }) },
      handler_scope.st,
      h.body,
      match h.return_clause { Some(_) -> Moved(b"returned to the `return` clause"), None -> usage },
    ),
    e.span,
    release_context(s),
  );
  let clauses = h.clauses.fold(inside, |accumulator: OwnershipState, c: WalkedClause| {
    let consumed_parameters = f.operation_consumed_parameters(c.effect, c.operation);
    let given = range(0, c.params.len()).fold(
      {
        s: { ..isolated_scope(handler_scope.s, c.span), block: [] },
        st: { ..accumulator, in_flight: [] },
      },
      |x: ScopedState, i: Int| {
        let p = c.params.get(i);
        let t = f.resolved(p.ty);
        bind(x, p.name, p.span, t, f.resource(t), consumed_parameters.contains(i))
      },
    );
    let resumed = match c.continuation {
      Some(k) -> bind_as(given, k.name, k.span, unit_type, true, true, Continuation),
      None -> given,
    };
    let ended = release_scope(
      f,
      check_borrowed_result(
        f,
        walk(f, resumed.s, release_before_last(resumed.st, resumed.s, c.body), c.body, usage),
        resumed.s,
        c.body,
        usage,
      ),
      resumed.s,
      c.body,
      c.body.span,
      usage,
    );
    { ..ended, in_flight: accumulator.in_flight }
  });
  match h.return_clause {
    None -> clauses,
    Some(r) -> {
      let inner: ScopedState = {
        s: { ..isolated_scope(handler_scope.s, r.span), block: [] },
        st: { ..clauses, in_flight: [] },
      };
      let t = type_of(f, h.body);
      let return_scope = bind(inner, r.binder.name, r.binder.span, t, f.resource(t), true);
      let ended = release_scope(
        f,
        check_borrowed_result(
          f,
          walk(
            f,
            return_scope.s,
            release_before_last(return_scope.st, return_scope.s, r.body),
            r.body,
            usage,
          ),
          return_scope.s,
          r.body,
          usage,
        ),
        return_scope.s,
        r.body,
        r.body.span,
        usage,
      );
      { ..ended, in_flight: clauses.in_flight }
    },
  }
}

fn used_after_consumed(f: Facts, b: Binding, span: Span, g: Consumption) -> Diagnostic =
  error_at_and(
    b"E0316",
    f.module,
    span,
    Bytes::concat_all([backticked_text(b.name), b" is used after it was consumed"]),
    b"used here",
    f.module,
    g.at,
    Bytes::concat_all([b"consumed here: ", g.how]),
    [
      b"a resource is never copied, so once it is consumed, nothing else may read it",
      b"read it before it is consumed: a parameter not written `keep` only borrows it",
    ],
  )

fn borrow_after_consumed(f: Facts, b: Binding, span: Span, borrowed: Binding) -> Diagnostic =
  error_at_and(
    b"E0316",
    f.module,
    span,
    Bytes::concat_all([
      backticked_text(b.name),
      b" borrows ",
      backticked_text(borrowed.name),
      b", which was consumed",
    ]),
    b"used here",
    f.module,
    match borrowed.consumed { Some(g) -> g.at, None -> borrowed.at },
    b"consumed here",
    [
      b"a function that borrows a resource can be used only while that resource has not been consumed",
    ],
  )

fn partly_moved(f: Facts, b: Binding, span: Span) -> Diagnostic / {abort.raise} =
  error_at(
    b"E0316",
    f.module,
    span,
    Bytes::concat_all([
      backticked_text(b.name),
      b" is used after its field ",
      backticked_text(b.taken.get(0)),
      b" was moved out",
    ]),
    b"used here",
    [b"its other fields may still be read, but the record as a whole may not be used"],
  )

fn field_twice(f: Facts, b: Binding, name: Bytes, span: Span) -> Diagnostic =
  error_at(
    b"E0316",
    f.module,
    span,
    Bytes::concat_all([
      backticked_text(Bytes::concat_all([b.name, b".", name])),
      b" is moved out twice",
    ]),
    b"moved out again here",
    [b"a resource field is moved out of its record once"],
  )

fn field_move_error(f: Facts, b: Binding, name: Bytes, span: Span) -> Diagnostic =
  error_at(
    b"E0316",
    f.module,
    span,
    Bytes::concat_all([
      b"moving ",
      backticked_text(name),
      b" out of ",
      backticked_text(b.name),
      b", which would leave another resource in the record",
    ]),
    b"moved out here",
    [
      Bytes::concat_all([
        b"take the record apart instead, `let { ",
        name,
        b", .. } = ",
        b.name,
        b";`, binding each resource it holds",
      ]),
    ],
  )

fn consumed_borrowed(f: Facts, b: Binding, span: Span, how: Bytes) -> Diagnostic =
  error_at_and(
    b"E0318",
    f.module,
    span,
    Bytes::concat_all([backticked_text(b.name), b" is borrowed, and cannot be consumed"]),
    how,
    f.module,
    b.at,
    b"borrowed here",
    [
      b"a resource passed to a parameter is borrowed by the call unless the parameter is written `keep`; the function may use a borrowed resource and pass it on as borrowed, and the caller still owns the resource after the call",
      b"write `keep` before the parameter's type to make the function consume the resource",
    ],
  )

fn consumed_in_lambda(f: Facts, b: Binding, span: Span, fun: EnclosingFunction) -> Diagnostic =
  error_at_and(
    b"E0316",
    f.module,
    span,
    Bytes::concat_all([
      backticked_text(b.name),
      b" is consumed by a function that may run more than once",
    ]),
    b"consumed here",
    f.module,
    fun.span,
    b"this function is passed elsewhere, so it may be called more than once or not at all",
    [
      b"a resource is consumed once, so only a function that a `let` binds and calls directly may consume a resource it captured",
    ],
  )

fn owning_function_passed(f: Facts, b: Binding, span: Span) -> Diagnostic =
  error_at_and(
    b"E0316",
    f.module,
    span,
    Bytes::concat_all([
      backticked_text(b.name),
      b" consumes a resource, so it may only be called, not passed elsewhere",
    ]),
    b"passed elsewhere here",
    f.module,
    b.at,
    b"bound here",
    [
      b"calling the function consumes the resource, so the function can be called only once and must not be passed to code that may call it again",
    ],
  )

fn handler_variable_resource(f: Facts, v: WalkedHandlerVariable) -> Diagnostic =
  error_at(
    b"E0322",
    f.module,
    v.span,
    Bytes::concat_all([
      b"the handler's variable ",
      backticked_text(v.name),
      b" is a resource, and nothing would clean it up",
    ]),
    b"nothing cleans up a handler's variable when its `handle` ends",
    [
      b"bind the resource with `let` around the `handle`, and pass it borrowed to the clauses that use it",
    ],
  )

fn moved_through(f: Facts, b: Binding, name: Bytes, span: Span) -> Diagnostic =
  error_at_and(
    b"E0316",
    f.module,
    span,
    Bytes::concat_all([b"`", name, b"` is moved out through a field of ", backticked_text(b.name)]),
    b"moved out here",
    f.module,
    b.at,
    b"record bound here",
    [
      b"a resource can only be moved out of a record through its own field: bind that field first, `let inner = r.inner;`",
    ],
  )

fn written_over(f: Facts, name: Bytes, at: Span) -> Diagnostic =
  error_at(
    b"E0322",
    f.module,
    at,
    Bytes::concat_all([
      b"the record's ",
      backticked_text(name),
      b" would be dropped without being cleaned up",
    ]),
    b"overwritten here",
    [
      Bytes::concat_all([
        b"move the field out first, `let old = r.",
        name,
        b";`, and consume it or let it go with its block",
      ]),
    ],
  )

fn fallback_consumed(f: Facts, b: Binding, at: Span) -> Diagnostic =
  error_at_and(
    b"E0316",
    f.module,
    at,
    Bytes::concat_all([
      backticked_text(b.name),
      b" is consumed by an `else` in a block, but the code after the block still needs it",
    ]),
    b"this `else` leaves its block and consumes the variable",
    f.module,
    b.at,
    b"variable bound here, outside that block",
    [
      b"an `else` returns from the block it is in, but the code after that block still uses every variable bound outside the block: consume the variable after the block",
    ],
  )

fn guard_consumed(f: Facts, b: Binding, at: Span, what: Bytes) -> Diagnostic =
  error_at_and(
    b"E0316",
    f.module,
    at,
    Bytes::concat_all([backticked_text(b.name), b" is consumed by ", what]),
    b"consumed here",
    f.module,
    b.at,
    b"variable bound here",
    [
      b"code that may not run, or may run more than once, can only borrow a variable: consume the variable where the code surely runs exactly once",
    ],
  )

fn escaping_borrower_error(f: Facts, b: Binding, span: Span) -> Diagnostic =
  error_at_and(
    b"E0318",
    f.module,
    span,
    Bytes::concat_all([backticked_text(b.name), b" borrows a resource, and may not outlive it"]),
    b"kept here",
    f.module,
    b.at,
    b"bound here",
    [
      b"a function that borrows a resource can be called, or passed to a call, only while the resource exists: to move the resource into the function instead, consume the resource inside the function",
    ],
  )

fn escaping_borrow_error(f: Facts, b: Binding, span: Span, fun: EnclosingFunction) -> Diagnostic =
  error_at_and(
    b"E0318",
    f.module,
    span,
    Bytes::concat_all([backticked_text(b.name), b" is borrowed by a function that may outlive it"]),
    b"borrowed here",
    f.module,
    fun.span,
    b"this function may be stored, returned or put in a value",
    [
      b"a function that borrows a resource may be called only while the resource exists: consume the resource inside the function to move it in instead",
    ],
  )

fn resource_copied_error(f: Facts, b: Binding, span: Span) -> Diagnostic =
  error_at(
    b"E0317",
    f.module,
    span,
    Bytes::concat_all([backticked_text(b.name), b" is a resource, and would be copied here"]),
    b"read as a copy",
    [
      b"a resource is not data: you cannot compare it, combine it or read it as a value, only pass it to a function that borrows or consumes it",
    ],
  )

fn dropped_binding(f: Facts, b: Binding, span: Span) -> Diagnostic =
  error_at(
    b"E0322",
    f.module,
    span,
    Bytes::concat_all([
      backticked_text(b.name),
      b" would be dropped here without being cleaned up",
    ]),
    b"a statement that does nothing with the resource",
    [
      b"pass the resource to a function that consumes it, or leave it bound: it is cleaned up where its block ends",
    ],
  )

fn new_resource_dropped(f: Facts, e: WalkedExpression, usage: Usage) -> Diagnostic =
  error_at(
    b"E0322",
    f.module,
    e.span,
    b"a resource is created here and not bound to anything",
    match usage {
      Borrowed -> b"only borrowed by a call, which does not store it",
      Read -> b"read as a copy",
      _ -> b"its value is dropped",
    },
    [
      b"bind the resource with `let`, so it is cleaned up where its block ends, or pass it to a function that consumes it",
    ],
  )

fn moved_on_one_path(module: Int, b: Binding) -> Diagnostic =
  error_at(
    b"E0316",
    module,
    b.at,
    Bytes::concat_all([
      b"a field of ",
      backticked_text(b.name),
      b" is moved out on one path but not another",
    ]),
    b"bound here",
    [b"move the field out on every path past the branch, or on none"],
  )

fn rest_dropped(f: Facts, span: Span) -> Diagnostic =
  error_at(
    b"E0322",
    f.module,
    span,
    b"`..` cannot drop a resource",
    b"the fields left out by `..` include a resource, which would be dropped without being cleaned up",
    [
      b"name the field that contains the resource, so it is cleaned up where its block ends, or consume it",
    ],
  )

fn wildcard_resource(f: Facts, span: Span) -> Diagnostic =
  error_at(
    b"E0322",
    f.module,
    span,
    b"`_` cannot bind a resource",
    b"this resource would be dropped without being cleaned up",
    [
      b"name the resource, so it is cleaned up where its block ends, or pass it to its cleanup function to clean it up now",
    ],
  )
