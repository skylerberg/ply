//! The typed tree: a body as the checker found it, written out. Each node holds its type and what
//! the checker resolved there, so nothing that reads the tree looks a node's facts up by its site.

import compiler.syntax.parsing (Span)
import compiler.syntax.patterns (Lit)
import compiler.check.types (Type, Row)
import std.list

/// One node: what it is, where its text stands, and its type.
pub type TypedExpr = { node: TypedNode, span: Span, ty: Type }

pub type TypedNode =
  | TypedLit(Lit)
  | TypedRead(Reading)
  | TypedUnary({ op: Bytes, operand: TypedExpr })
  | TypedBinary({ op: Bytes, lhs: TypedExpr, rhs: TypedExpr })
  /// `args` are in the callee's parameters' order, a default the call leaves out among them.
  | TypedCall({ callee: TypedExpr, args: List<TypedExpr> })
  | TypedIf({ cond: TypedExpr, then_branch: TypedExpr, else_branch: TypedExpr })
  | TypedMatch({ scrutinee: TypedExpr, arms: List<TypedArm> })
  | TypedBlock({ stmts: List<TypedStmt>, tail: Option<TypedExpr> })
  | TypedList(List<TypedExpr>)
  | TypedRecord(List<TypedField>)
  /// `{ ..base, f: e }`: the base's record with the fields `sets` writes replaced, at the node's type.
  | TypedUpdate({ base: TypedExpr, sets: List<TypedField> })
  | TypedFieldRead({ base: TypedExpr, field: Bytes })
  /// `effect` is the effect's name across the program, and `resource` the label as written.
  | TypedPerform({ effect: Bytes, op: Bytes, resource: Option<Bytes>, args: List<TypedExpr> })
  | TypedLambda({ params: List<TypedParam>, body: TypedExpr, row: Row })
  | TypedSimulate(TypedThunk)
  | TypedParallel(List<TypedThunk>)
  /// `row` is what the body performs. `vars` are the handler's variables, made before the body
  /// runs, which its clauses read and assign.
  | TypedHandle({ body: TypedExpr, row: Row, clauses: List<TypedClause>, ret: Option<TypedReturn>, vars: List<TypedHandlerVar> })

/// What a name read as a value is: a binder in scope, a definition at the type arguments the read
/// fills, a constructor of a declared sum, or a builtin.
pub type Reading =
  | ReadLocal(Bytes)
  | ReadDefinition({ full: Bytes, args: List<Type> })
  | ReadConstructor({ sum: Bytes, name: Bytes, case: Int })
  | ReadBuiltin(Bytes)

pub type TypedParam = { name: Bytes, ty: Type, span: Span }

/// A body run as a function of no parameters, and what it performs.
pub type TypedThunk = { body: TypedExpr, row: Row }

pub type TypedField = { name: Bytes, value: TypedExpr }

pub type TypedArm = { pat: TypedPattern, guard: Option<TypedExpr>, body: TypedExpr }

/// A pattern, each binder with the type it binds and each constructor resolved to its case.
pub type TypedPattern =
  | TypedWild
  | TypedBinder({ name: Bytes, ty: Type, span: Span })
  | TypedLitPattern(Lit)
  | TypedRange({ lo: Lit, hi: Lit })
  | TypedCase({ sum: Bytes, name: Bytes, case: Int, args: List<TypedPattern> })
  | TypedRecordPattern({ fields: List<{ name: Bytes, pat: TypedPattern }>, rest: Bool })
  | TypedListPattern({ items: List<TypedPattern>, rest: Option<TypedPattern> })
  | TypedOr(List<TypedPattern>)

pub type TypedStmt =
  | TypedLet({ pat: TypedPattern, value: TypedExpr, span: Span })
  /// `let p = v else { .. };`: where `pat` does not match, `fallback` is the block's value.
  | TypedLetElse({ pat: TypedPattern, value: TypedExpr, fallback: TypedExpr, span: Span })
  | TypedDo(TypedExpr)
  /// `name = value;`: a clause giving its handler's variable a new value.
  | TypedAssign({ name: Bytes, value: TypedExpr, span: Span })

/// A clause of a `handle`: the operation it answers, under the label written or under every label,
/// its parameters, the label it binds where it answers every label, its continuation, and its body.
/// It runs as a closure of type `ty`; `row` is what its body performs and `resumed` what resuming
/// its continuation does.
pub type TypedClause = {
  effect: Bytes,
  op: Bytes,
  resource: Option<Bytes>,
  every_label: Bool,
  params: List<TypedParam>,
  label: Option<TypedParam>,
  resume: Option<TypedParam>,
  body: TypedExpr,
  ty: Type,
  row: Row,
  resumed: Row,
  span: Span,
}

/// A `handle`'s `return` clause, run as a closure of type `ty` on the body's answer; `row` is what
/// it performs.
pub type TypedReturn = { binder: TypedParam, body: TypedExpr, ty: Type, row: Row, span: Span }

/// A variable a `handle` holds: its type, and its first value, which reads the variables above it.
pub type TypedHandlerVar = { name: Bytes, ty: Type, init: TypedExpr, span: Span }

// --- Building nodes --------------------------------------------------------------------------------

// Each builder takes what the check found of a node's parts, none for a part the check reported an
// error in, and makes the node only where every part is there.

pub fn unary_of(op: Bytes, operand: Option<TypedExpr>) -> Option<TypedNode> =
  match operand { Some(x) -> Some(TypedUnary({ op: op, operand: x })), None -> None }

pub fn binary_of(op: Bytes, lhs: Option<TypedExpr>, rhs: Option<TypedExpr>) -> Option<TypedNode> =
  match ((lhs, rhs)) {
    (Some(l), Some(r)) -> Some(TypedBinary({ op: op, lhs: l, rhs: r })),
    _ -> None,
  }

pub fn call_of(callee: Option<TypedExpr>, args: List<Option<TypedExpr>>) -> Option<TypedNode> =
  match ((callee, Option::all(args))) {
    (Some(f), Some(xs)) -> Some(TypedCall({ callee: f, args: xs })),
    _ -> None,
  }

pub fn if_of(
  cond: Option<TypedExpr>,
  then_branch: Option<TypedExpr>,
  else_branch: Option<TypedExpr>,
) -> Option<TypedNode> =
  match ((cond, then_branch, else_branch)) {
    (Some(c), Some(t), Some(e)) -> Some(TypedIf({ cond: c, then_branch: t, else_branch: e })),
    _ -> None,
  }

pub fn list_of(items: List<Option<TypedExpr>>) -> Option<TypedNode> =
  match Option::all(items) { Some(xs) -> Some(TypedList(xs)), None -> None }

pub fn field_read_of(base: Option<TypedExpr>, field: Bytes) -> Option<TypedNode> =
  match base { Some(b) -> Some(TypedFieldRead({ base: b, field: field })), None -> None }

pub fn record_of(fields: List<{ name: Bytes, value: Option<TypedExpr> }>) -> Option<TypedNode> =
  match fields.fold(
      Some([]),
      |acc: Option<List<TypedField>>, f: { name: Bytes, value: Option<TypedExpr> }|
        match ((acc, f.value)) {
          (Some(fs), Some(v)) -> Some(fs.push({ name: f.name, value: v })),
          _ -> None,
        },
    ) {
    Some(fs) -> Some(TypedRecord(fs)),
    None -> None,
  }

pub fn arm_of(
  pat: Option<TypedPattern>,
  guard: Option<Option<TypedExpr>>,
  body: Option<TypedExpr>,
) -> Option<TypedArm> =
  match ((pat, guard, body)) {
    (Some(p), Some(Some(g)), Some(b)) -> Some({ pat: p, guard: Some(g), body: b }),
    (Some(p), None, Some(b)) -> Some({ pat: p, guard: None, body: b }),
    _ -> None,
  }

pub fn match_of(scrutinee: Option<TypedExpr>, arms: List<Option<TypedArm>>) -> Option<TypedNode> =
  match ((scrutinee, Option::all(arms))) {
    (Some(s), Some(xs)) -> Some(TypedMatch({ scrutinee: s, arms: xs })),
    _ -> None,
  }

pub fn do_of(e: Option<TypedExpr>) -> Option<TypedStmt> =
  match e { Some(x) -> Some(TypedDo(x)), None -> None }

pub fn let_of(
  pat: Option<TypedPattern>,
  value: Option<TypedExpr>,
  span: Span,
) -> Option<TypedStmt> =
  match ((pat, value)) {
    (Some(p), Some(v)) -> Some(TypedLet({ pat: p, value: v, span: span })),
    _ -> None,
  }

pub fn let_else_of(
  pat: Option<TypedPattern>,
  value: Option<TypedExpr>,
  fallback: Option<TypedExpr>,
  span: Span,
) -> Option<TypedStmt> =
  match ((pat, value, fallback)) {
    (Some(p), Some(v), Some(f)) ->
      Some(TypedLetElse({ pat: p, value: v, fallback: f, span: span })),
    _ -> None,
  }

pub fn case_pattern_of(
  sum: Bytes,
  name: Bytes,
  case: Int,
  args: List<Option<TypedPattern>>,
) -> Option<TypedPattern> =
  match Option::all(args) {
    Some(ps) -> Some(TypedCase({ sum: sum, name: name, case: case, args: ps })),
    None -> None,
  }

pub fn list_pattern_of(
  items: List<Option<TypedPattern>>,
  rest: Option<Option<TypedPattern>>,
) -> Option<TypedPattern> =
  match ((Option::all(items), rest)) {
    (Some(ps), Some(Some(r))) -> Some(TypedListPattern({ items: ps, rest: Some(r) })),
    (Some(ps), None) -> Some(TypedListPattern({ items: ps, rest: None })),
    _ -> None,
  }

pub fn or_pattern_of(alts: List<Option<TypedPattern>>) -> Option<TypedPattern> =
  match Option::all(alts) { Some(ps) -> Some(TypedOr(ps)), None -> None }

pub fn record_pattern_of(
  fields: List<{ name: Bytes, pat: Option<TypedPattern> }>,
  rest: Bool,
) -> Option<TypedPattern> =
  match fields.fold(
      Some([]),
      |acc: Option<List<{ name: Bytes, pat: TypedPattern }>>, f: { name: Bytes, pat: Option<TypedPattern> }|
        match ((acc, f.pat)) {
          (Some(fs), Some(p)) -> Some(fs.push({ name: f.name, pat: p })),
          _ -> None,
        },
    ) {
    Some(fs) -> Some(TypedRecordPattern({ fields: fs, rest: rest })),
    None -> None,
  }

pub fn perform_of(
  effect_name: Bytes,
  op: Bytes,
  resource: Option<Bytes>,
  args: List<Option<TypedExpr>>,
) -> Option<TypedNode> =
  match Option::all(args) {
    Some(xs) -> Some(TypedPerform({ effect: effect_name, op: op, resource: resource, args: xs })),
    None -> None,
  }

pub fn simulate_of(body: Option<TypedExpr>, row: Row) -> Option<TypedNode> =
  match body { Some(b) -> Some(TypedSimulate({ body: b, row: row })), None -> None }

pub fn parallel_of(branches: List<{ body: Option<TypedExpr>, row: Row }>) -> Option<TypedNode> =
  match branches.fold(
      Some([]),
      |acc: Option<List<TypedThunk>>, b: { body: Option<TypedExpr>, row: Row }|
        match ((acc, b.body)) {
          (Some(ts), Some(x)) -> Some(ts.push({ body: x, row: b.row })),
          _ -> None,
        },
    ) {
    Some(ts) -> Some(TypedParallel(ts)),
    None -> None,
  }

/// The parameters `names` at the types `tys`, place for place; none where the two differ in length.
pub fn params_typed(
  names: List<{ name: Bytes, span: Span }>,
  tys: List<Type>,
) -> Option<List<TypedParam>> =
  match names.zip_strict(tys) {
    Some(ps) ->
      Some(
        ps.map(|p: { first: { name: Bytes, span: Span }, second: Type }|
          { name: p.first.name, ty: p.second, span: p.first.span }),
      ),
    None -> None,
  }

pub fn clause_of(
  head: { effect: Bytes, op: Bytes, resource: Option<Bytes>, every_label: Bool },
  params: Option<List<TypedParam>>,
  label: Option<TypedParam>,
  resume: Option<TypedParam>,
  body: Option<TypedExpr>,
  ty: Type,
  row: Row,
  resumed: Row,
  span: Span,
) -> Option<TypedClause> =
  match ((params, body)) {
    (Some(ps), Some(b)) ->
      Some({
        effect: head.effect,
        op: head.op,
        resource: head.resource,
        every_label: head.every_label,
        params: ps,
        label: label,
        resume: resume,
        body: b,
        ty: ty,
        row: row,
        resumed: resumed,
        span: span,
      }),
    _ -> None,
  }

pub fn return_of(
  binder: TypedParam,
  body: Option<TypedExpr>,
  ty: Type,
  row: Row,
  span: Span,
) -> Option<TypedReturn> =
  match body {
    Some(b) -> Some({ binder: binder, body: b, ty: ty, row: row, span: span }),
    None -> None,
  }

pub fn handler_var_of(
  name: Bytes,
  ty: Type,
  init: Option<TypedExpr>,
  span: Span,
) -> Option<TypedHandlerVar> =
  match init { Some(i) -> Some({ name: name, ty: ty, init: i, span: span }), None -> None }

pub fn handle_of(
  body: Option<TypedExpr>,
  row: Row,
  clauses: List<Option<TypedClause>>,
  ret: Option<Option<TypedReturn>>,
  vars: List<Option<TypedHandlerVar>>,
) -> Option<TypedNode> =
  match ((body, Option::all(clauses), ret, Option::all(vars))) {
    (Some(b), Some(cs), None, Some(vs)) ->
      Some(TypedHandle({ body: b, row: row, clauses: cs, ret: None, vars: vs })),
    (Some(b), Some(cs), Some(Some(r)), Some(vs)) ->
      Some(TypedHandle({ body: b, row: row, clauses: cs, ret: Some(r), vars: vs })),
    _ -> None,
  }

pub fn assign_of(name: Bytes, value: Option<TypedExpr>, span: Span) -> Option<TypedStmt> =
  match value { Some(v) -> Some(TypedAssign({ name: name, value: v, span: span })), None -> None }

pub fn update_of(
  base: Option<TypedExpr>,
  sets: List<{ name: Bytes, value: Option<TypedExpr> }>,
) -> Option<TypedNode> =
  match ((base, record_of(sets))) {
    (Some(b), Some(TypedRecord(fs))) -> Some(TypedUpdate({ base: b, sets: fs })),
    _ -> None,
  }

pub fn lambda_of(params: List<TypedParam>, body: Option<TypedExpr>, row: Row) -> Option<TypedNode> =
  match body { Some(b) -> Some(TypedLambda({ params: params, body: b, row: row })), None -> None }

pub fn block_of(
  stmts: List<Option<TypedStmt>>,
  tail: Option<Option<TypedExpr>>,
) -> Option<TypedNode> =
  match ((Option::all(stmts), tail)) {
    (Some(ss), Some(Some(t))) -> Some(TypedBlock({ stmts: ss, tail: Some(t) })),
    (Some(ss), None) -> Some(TypedBlock({ stmts: ss, tail: None })),
    _ -> None,
  }

// --- Walking the tree ------------------------------------------------------------------------------

/// `e` with each node rewritten by `f` once its parts are.
pub fn rewritten(e: TypedExpr, f: (TypedExpr) -> TypedExpr) -> TypedExpr = {
  let go = |x: TypedExpr| rewritten(x, f);
  let opt = |x: Option<TypedExpr>| match x { Some(y) -> Some(rewritten(y, f)), None -> None };
  f({
    ..e,
    node: match e.node {
      TypedUnary(u) -> TypedUnary({ ..u, operand: go(u.operand) }),
      TypedBinary(b) -> TypedBinary({ ..b, lhs: go(b.lhs), rhs: go(b.rhs) }),
      TypedCall(c) -> TypedCall({ callee: go(c.callee), args: c.args.map(go) }),
      TypedIf(i) ->
        TypedIf({
          cond: go(i.cond),
          then_branch: go(i.then_branch),
          else_branch: go(i.else_branch),
        }),
      TypedMatch(m) ->
        TypedMatch({
          scrutinee: go(m.scrutinee),
          arms: m.arms.map(|a: TypedArm| { pat: a.pat, guard: opt(a.guard), body: go(a.body) }),
        }),
      TypedBlock(b) ->
        TypedBlock({
          stmts: b.stmts.map(|s: TypedStmt|
            match s {
              TypedLet(l) -> TypedLet({ ..l, value: go(l.value) }),
              TypedLetElse(l) ->
                TypedLetElse({ ..l, value: go(l.value), fallback: go(l.fallback) }),
              TypedDo(x) -> TypedDo(go(x)),
              TypedAssign(a) -> TypedAssign({ ..a, value: go(a.value) }),
            }),
          tail: opt(b.tail),
        }),
      TypedList(xs) -> TypedList(xs.map(go)),
      TypedRecord(fs) ->
        TypedRecord(fs.map(|fd: TypedField| { name: fd.name, value: go(fd.value) })),
      TypedUpdate(u) ->
        TypedUpdate({
          base: go(u.base),
          sets: u.sets.map(|fd: TypedField| { name: fd.name, value: go(fd.value) }),
        }),
      TypedFieldRead(r) -> TypedFieldRead({ ..r, base: go(r.base) }),
      TypedPerform(p) -> TypedPerform({ ..p, args: p.args.map(go) }),
      TypedLambda(l) -> TypedLambda({ ..l, body: go(l.body) }),
      TypedSimulate(t) -> TypedSimulate({ ..t, body: go(t.body) }),
      TypedParallel(ts) -> TypedParallel(ts.map(|t: TypedThunk| { ..t, body: go(t.body) })),
      TypedHandle(h) ->
        TypedHandle({
          ..h,
          body: go(h.body),
          clauses: h.clauses.map(|c: TypedClause| { ..c, body: go(c.body) }),
          ret: match h.ret { Some(r) -> Some({ ..r, body: go(r.body) }), None -> None },
          vars: h.vars.map(|v: TypedHandlerVar| { ..v, init: go(v.init) }),
        }),
      TypedLit(l) -> TypedLit(l),
      TypedRead(r) -> TypedRead(r),
    },
  })
}

/// Every node of `e`, each before its parts.
pub fn nodes_of(e: TypedExpr) -> List<TypedExpr> = {
  let all = |xs: List<TypedExpr>|
    xs.fold([], |acc: List<TypedExpr>, x: TypedExpr| acc.concat(nodes_of(x)));
  let opt = |x: Option<TypedExpr>| match x { Some(y) -> nodes_of(y), None -> [] };
  [e].concat(match e.node {
    TypedUnary(u) -> nodes_of(u.operand),
    TypedBinary(b) -> nodes_of(b.lhs).concat(nodes_of(b.rhs)),
    TypedCall(c) -> nodes_of(c.callee).concat(all(c.args)),
    TypedIf(i) -> all([i.cond, i.then_branch, i.else_branch]),
    TypedMatch(m) ->
      nodes_of(m.scrutinee).concat(
        m.arms.fold([], |acc: List<TypedExpr>, a: TypedArm|
          acc.concat(opt(a.guard)).concat(nodes_of(a.body))),
      ),
    TypedBlock(b) ->
      b.stmts.fold([], |acc: List<TypedExpr>, s: TypedStmt|
        acc.concat(match s {
          TypedLet(l) -> nodes_of(l.value),
          TypedLetElse(l) -> nodes_of(l.value).concat(nodes_of(l.fallback)),
          TypedDo(x) -> nodes_of(x),
          TypedAssign(a) -> nodes_of(a.value),
        })).concat(
        opt(b.tail),
      ),
    TypedList(xs) -> all(xs),
    TypedRecord(fs) -> all(fs.map(|fd: TypedField| fd.value)),
    TypedUpdate(u) -> nodes_of(u.base).concat(all(u.sets.map(|fd: TypedField| fd.value))),
    TypedFieldRead(r) -> nodes_of(r.base),
    TypedPerform(p) -> all(p.args),
    TypedLambda(l) -> nodes_of(l.body),
    TypedSimulate(t) -> nodes_of(t.body),
    TypedParallel(ts) -> all(ts.map(|t: TypedThunk| t.body)),
    TypedHandle(h) ->
      all(h.vars.map(|v: TypedHandlerVar| v.init)).concat(nodes_of(h.body)).concat(
        all(h.clauses.map(|c: TypedClause| c.body)),
      ).concat(match h.ret { Some(r) -> nodes_of(r.body), None -> [] }),
    TypedLit(_) -> [],
    TypedRead(_) -> [],
  })
}

// --- Defaults a call on a value copies -------------------------------------------------------------

/// A parameter's default copied into the call at site `call`, typed: the argument at `place`.
pub type PlacedDefault = { call: Int, place: Int, value: Option<TypedExpr> }

/// `e` with each default in `defaults` put in its call's arguments at its place. None where a
/// default is not typed or its call is not one of `e`'s.
pub fn defaults_placed(e: TypedExpr, defaults: List<PlacedDefault>) -> Option<TypedExpr> =
  if defaults.len() == 0 { Some(e) } else {
    let by_call = defaults.fold(Map::new(), |m: Map<Int, List<PlacedDefault>>, d: PlacedDefault|
      m.insert(d.call, match m.get(d.call) { Some(ds) -> ds.push(d), None -> [d] }));
    let calls = nodes_of(e).filter(|x: TypedExpr|
      match x.node { TypedCall(_) -> by_call.contains(x.span.site), _ -> false });
    let untyped = defaults.any(|d: PlacedDefault| match d.value { Some(_) -> false, None -> true });
    if calls.len() != by_call.len() || untyped { None } else {
      Some(
        rewritten(e, |x: TypedExpr|
          match ((x.node, by_call.get(x.span.site))) {
            (TypedCall(c), Some(ds)) ->
              {
                ..x,
                node: TypedCall({
                  callee: c.callee,
                  args: ds.sort_by(|a: PlacedDefault, b: PlacedDefault| a.place <= b.place).fold(
                    c.args,
                    |args: List<TypedExpr>, d: PlacedDefault|
                      match d.value {
                        Some(v) -> args.take(d.place).push(v).concat(args.drop(d.place)),
                        None -> args,
                      },
                  ),
                }),
              },
            _ -> x,
          }),
      )
    }
  }
