//! The typed tree: a body as the checker found it, written out. Each node holds its type and what
//! the checker resolved there, so nothing that reads the tree looks a node's facts up by its site.
//! The tree is generic in how it writes a type: the checker and what lowers a body hold `Type`s,
//! and a body stored with its row names each type by its key in the row's table.

import compiler.syntax.parsing (Span, span_bin)
import compiler.syntax.patterns (Lit, lit_bin)
import compiler.check.types (Type, Row, Atom, row_bin, atom_bin)
import std.bin
import std.list

/// One node: what it is, where its text stands, and its type.
pub type TypedExpr<t> = { node: TypedNode<t>, span: Span, ty: t }

pub type TypedNode<t> =
  | TypedLit(Lit)
  | TypedRead(Reading<t>)
  | TypedUnary({ op: Bytes, operand: TypedExpr<t> })
  | TypedBinary({ op: Bytes, lhs: TypedExpr<t>, rhs: TypedExpr<t> })
  /// `args` are in the callee's parameters' order, a default the call leaves out among them.
  | TypedCall({ callee: TypedExpr<t>, args: List<TypedExpr<t>> })
  | TypedIf({ cond: TypedExpr<t>, then_branch: TypedExpr<t>, else_branch: TypedExpr<t> })
  | TypedMatch({ scrutinee: TypedExpr<t>, arms: List<TypedArm<t>> })
  | TypedBlock({ stmts: List<TypedStmt<t>>, tail: Option<TypedExpr<t>> })
  | TypedList(List<TypedExpr<t>>)
  | TypedRecord(List<TypedField<t>>)
  /// `{ ..base, f: e }`: the base's record with the fields `sets` writes replaced, at the node's type.
  | TypedUpdate({ base: TypedExpr<t>, sets: List<TypedField<t>> })
  | TypedFieldRead({ base: TypedExpr<t>, field: Bytes })
  /// `effect` is the effect's name across the program, `resource` the label as written, and `atom`
  /// what the perform performs.
  | TypedPerform({ effect: Bytes, op: Bytes, resource: Option<Bytes>, atom: Atom, args: List<TypedExpr<t>> })
  | TypedLambda({ params: List<TypedParam<t>>, body: TypedExpr<t>, row: Row })
  | TypedSimulate(TypedThunk<t>)
  | TypedParallel(List<TypedThunk<t>>)
  /// `row` is what the body performs. `vars` are the handler's variables, made before the body
  /// runs, which its clauses read and assign.
  | TypedHandle({ body: TypedExpr<t>, row: Row, clauses: List<TypedClause<t>>, ret: Option<TypedReturn<t>>, vars: List<TypedHandlerVar<t>> })

/// What a name read as a value is: a binder in scope; a definition at the type arguments and rows
/// the read fills, `rows` filling the scheme's row variables `quantified` as the read found them;
/// a constructor of a declared sum at the type arguments it fills; or a builtin at the type
/// arguments and rows it fills, the rows in its own order.
pub type Reading<t> =
  | ReadLocal(Bytes)
  | ReadDefinition({ full: Bytes, args: List<t>, rows: List<Row>, quantified: List<Int> })
  | ReadConstructor({ sum: Bytes, name: Bytes, case: Int, args: List<t> })
  | ReadBuiltin({ name: Bytes, args: List<t>, rows: List<Row> })

pub type TypedParam<t> = { name: Bytes, ty: t, span: Span }

/// A body run as a function of no parameters, and what it performs.
pub type TypedThunk<t> = { body: TypedExpr<t>, row: Row }

pub type TypedField<t> = { name: Bytes, value: TypedExpr<t> }

pub type TypedArm<t> = { pat: TypedPattern<t>, guard: Option<TypedExpr<t>>, body: TypedExpr<t> }

/// A pattern, each binder with the type it binds and each constructor resolved to its case.
pub type TypedPattern<t> =
  | TypedWild
  | TypedBinder({ name: Bytes, ty: t, span: Span })
  | TypedLitPattern(Lit)
  | TypedRange({ lo: Lit, hi: Lit })
  | TypedCase({ sum: Bytes, name: Bytes, case: Int, args: List<TypedPattern<t>> })
  | TypedRecordPattern({ fields: List<TypedFieldPattern<t>>, rest: Bool })
  | TypedListPattern({ items: List<TypedPattern<t>>, rest: Option<TypedPattern<t>> })
  | TypedOr(List<TypedPattern<t>>)

pub type TypedFieldPattern<t> = { name: Bytes, pat: TypedPattern<t> }

pub type TypedStmt<t> =
  | TypedLet({ pat: TypedPattern<t>, value: TypedExpr<t>, span: Span })
  /// `let p = v else { .. };`: where `pat` does not match, `fallback` is the block's value.
  | TypedLetElse({ pat: TypedPattern<t>, value: TypedExpr<t>, fallback: TypedExpr<t>, span: Span })
  | TypedDo(TypedExpr<t>)
  /// `name = value;`: a clause giving its handler's variable a new value.
  | TypedAssign({ name: Bytes, value: TypedExpr<t>, span: Span })

/// A clause of a `handle`: the operation it answers, under the label written or under every label,
/// its parameters, the label it binds where it answers every label, its continuation, and its body.
/// It runs as a closure of type `ty`; `row` is what its body performs and `resumed` what resuming
/// its continuation does.
pub type TypedClause<t> = {
  effect: Bytes,
  op: Bytes,
  resource: Option<Bytes>,
  every_label: Bool,
  params: List<TypedParam<t>>,
  label: Option<TypedParam<t>>,
  resume: Option<TypedParam<t>>,
  body: TypedExpr<t>,
  ty: t,
  row: Row,
  resumed: Row,
  span: Span,
}

/// A `handle`'s `return` clause, run as a closure of type `ty` on the body's answer; `row` is what
/// it performs.
pub type TypedReturn<t> = { binder: TypedParam<t>, body: TypedExpr<t>, ty: t, row: Row, span: Span }

/// A variable a `handle` holds: its type, and its first value, which reads the variables above it.
pub type TypedHandlerVar<t> = { name: Bytes, ty: t, init: TypedExpr<t>, span: Span }

/// Which of its owner's bodies a typed body is: a definition's body, one of its spec clauses by
/// its place among them, or its measure; a test's run or the listing of its cases; a law's guard
/// or the proposition it states.
pub type BodyPart =
  | WholeBody
  | ClauseBody(Int)
  | MeasureBody
  | TestRun
  | CaseListing
  | LawGuard
  | LawBody

/// A body the check walked, typed: what owns it, which of its bodies it is, and its tree.
pub type TypedBody<t> = { owner: Bytes, part: BodyPart, body: TypedExpr<t> }

derive bin for BodyPart

derive bin for TypedBody

derive bin for TypedExpr

derive bin for TypedNode

derive bin for Reading

derive bin for TypedParam

derive bin for TypedThunk

derive bin for TypedField

derive bin for TypedArm

derive bin for TypedPattern

derive bin for TypedFieldPattern

derive bin for TypedStmt

derive bin for TypedClause

derive bin for TypedReturn

derive bin for TypedHandlerVar

// --- Building nodes --------------------------------------------------------------------------------

// Each builder takes what the check found of a node's parts, none for a part the check reported an
// error in, and makes the node only where every part is there.

pub fn unary_of(op: Bytes, operand: Option<TypedExpr<Type>>) -> Option<TypedNode<Type>> =
  match operand { Some(x) -> Some(TypedUnary({ op: op, operand: x })), None -> None }

pub fn binary_of(
  op: Bytes,
  lhs: Option<TypedExpr<Type>>,
  rhs: Option<TypedExpr<Type>>,
) -> Option<TypedNode<Type>> =
  match ((lhs, rhs)) {
    (Some(l), Some(r)) -> Some(TypedBinary({ op: op, lhs: l, rhs: r })),
    _ -> None,
  }

pub fn call_of(
  callee: Option<TypedExpr<Type>>,
  args: List<Option<TypedExpr<Type>>>,
) -> Option<TypedNode<Type>> =
  match ((callee, Option::all(args))) {
    (Some(f), Some(xs)) -> Some(TypedCall({ callee: f, args: xs })),
    _ -> None,
  }

pub fn if_of(
  cond: Option<TypedExpr<Type>>,
  then_branch: Option<TypedExpr<Type>>,
  else_branch: Option<TypedExpr<Type>>,
) -> Option<TypedNode<Type>> =
  match ((cond, then_branch, else_branch)) {
    (Some(c), Some(t), Some(e)) -> Some(TypedIf({ cond: c, then_branch: t, else_branch: e })),
    _ -> None,
  }

pub fn list_of(items: List<Option<TypedExpr<Type>>>) -> Option<TypedNode<Type>> =
  match Option::all(items) { Some(xs) -> Some(TypedList(xs)), None -> None }

pub fn field_read_of(base: Option<TypedExpr<Type>>, field: Bytes) -> Option<TypedNode<Type>> =
  match base { Some(b) -> Some(TypedFieldRead({ base: b, field: field })), None -> None }

pub fn record_of(
  fields: List<{ name: Bytes, value: Option<TypedExpr<Type>> }>,
) -> Option<TypedNode<Type>> =
  match fields.fold(
      Some([]),
      |acc: Option<List<TypedField<Type>>>, f: { name: Bytes, value: Option<TypedExpr<Type>> }|
        match ((acc, f.value)) {
          (Some(fs), Some(v)) -> Some(fs.push({ name: f.name, value: v })),
          _ -> None,
        },
    ) {
    Some(fs) -> Some(TypedRecord(fs)),
    None -> None,
  }

pub fn arm_of(
  pat: Option<TypedPattern<Type>>,
  guard: Option<Option<TypedExpr<Type>>>,
  body: Option<TypedExpr<Type>>,
) -> Option<TypedArm<Type>> =
  match ((pat, guard, body)) {
    (Some(p), Some(Some(g)), Some(b)) -> Some({ pat: p, guard: Some(g), body: b }),
    (Some(p), None, Some(b)) -> Some({ pat: p, guard: None, body: b }),
    _ -> None,
  }

pub fn match_of(
  scrutinee: Option<TypedExpr<Type>>,
  arms: List<Option<TypedArm<Type>>>,
) -> Option<TypedNode<Type>> =
  match ((scrutinee, Option::all(arms))) {
    (Some(s), Some(xs)) -> Some(TypedMatch({ scrutinee: s, arms: xs })),
    _ -> None,
  }

pub fn do_of(e: Option<TypedExpr<Type>>) -> Option<TypedStmt<Type>> =
  match e { Some(x) -> Some(TypedDo(x)), None -> None }

pub fn let_of(
  pat: Option<TypedPattern<Type>>,
  value: Option<TypedExpr<Type>>,
  span: Span,
) -> Option<TypedStmt<Type>> =
  match ((pat, value)) {
    (Some(p), Some(v)) -> Some(TypedLet({ pat: p, value: v, span: span })),
    _ -> None,
  }

pub fn let_else_of(
  pat: Option<TypedPattern<Type>>,
  value: Option<TypedExpr<Type>>,
  fallback: Option<TypedExpr<Type>>,
  span: Span,
) -> Option<TypedStmt<Type>> =
  match ((pat, value, fallback)) {
    (Some(p), Some(v), Some(f)) ->
      Some(TypedLetElse({ pat: p, value: v, fallback: f, span: span })),
    _ -> None,
  }

pub fn case_pattern_of(
  sum: Bytes,
  name: Bytes,
  case: Int,
  args: List<Option<TypedPattern<Type>>>,
) -> Option<TypedPattern<Type>> =
  match Option::all(args) {
    Some(ps) -> Some(TypedCase({ sum: sum, name: name, case: case, args: ps })),
    None -> None,
  }

pub fn list_pattern_of(
  items: List<Option<TypedPattern<Type>>>,
  rest: Option<Option<TypedPattern<Type>>>,
) -> Option<TypedPattern<Type>> =
  match ((Option::all(items), rest)) {
    (Some(ps), Some(Some(r))) -> Some(TypedListPattern({ items: ps, rest: Some(r) })),
    (Some(ps), None) -> Some(TypedListPattern({ items: ps, rest: None })),
    _ -> None,
  }

pub fn or_pattern_of(alts: List<Option<TypedPattern<Type>>>) -> Option<TypedPattern<Type>> =
  match Option::all(alts) { Some(ps) -> Some(TypedOr(ps)), None -> None }

pub fn record_pattern_of(
  fields: List<{ name: Bytes, pat: Option<TypedPattern<Type>> }>,
  rest: Bool,
) -> Option<TypedPattern<Type>> =
  match fields.fold(
      Some([]),
      |acc: Option<List<TypedFieldPattern<Type>>>, f: { name: Bytes, pat: Option<TypedPattern<Type>> }|
        match ((acc, f.pat)) {
          (Some(fs), Some(p)) -> Some(fs.push({ name: f.name, pat: p })),
          _ -> None,
        },
    ) {
    Some(fs) -> Some(TypedRecordPattern({ fields: fs, rest: rest })),
    None -> None,
  }

pub fn perform_of(
  effect_name: Bytes,
  op: Bytes,
  resource: Option<Bytes>,
  atom: Atom,
  args: List<Option<TypedExpr<Type>>>,
) -> Option<TypedNode<Type>> =
  match Option::all(args) {
    Some(xs) ->
      Some(TypedPerform({ effect: effect_name, op: op, resource: resource, atom: atom, args: xs })),
    None -> None,
  }

pub fn simulate_of(body: Option<TypedExpr<Type>>, row: Row) -> Option<TypedNode<Type>> =
  match body { Some(b) -> Some(TypedSimulate({ body: b, row: row })), None -> None }

pub fn parallel_of(
  branches: List<{ body: Option<TypedExpr<Type>>, row: Row }>,
) -> Option<TypedNode<Type>> =
  match branches.fold(
      Some([]),
      |acc: Option<List<TypedThunk<Type>>>, b: { body: Option<TypedExpr<Type>>, row: Row }|
        match ((acc, b.body)) {
          (Some(ts), Some(x)) -> Some(ts.push({ body: x, row: b.row })),
          _ -> None,
        },
    ) {
    Some(ts) -> Some(TypedParallel(ts)),
    None -> None,
  }

/// The parameters `names` at the types `tys`, place for place; none where the two differ in length.
pub fn params_typed(
  names: List<{ name: Bytes, span: Span }>,
  tys: List<Type>,
) -> Option<List<TypedParam<Type>>> =
  match names.zip_strict(tys) {
    Some(ps) ->
      Some(
        ps.map(|p: { first: { name: Bytes, span: Span }, second: Type }|
          { name: p.first.name, ty: p.second, span: p.first.span }),
      ),
    None -> None,
  }

pub fn clause_of(
  head: { effect: Bytes, op: Bytes, resource: Option<Bytes>, every_label: Bool },
  params: Option<List<TypedParam<Type>>>,
  label: Option<TypedParam<Type>>,
  resume: Option<TypedParam<Type>>,
  body: Option<TypedExpr<Type>>,
  ty: Type,
  row: Row,
  resumed: Row,
  span: Span,
) -> Option<TypedClause<Type>> =
  match ((params, body)) {
    (Some(ps), Some(b)) ->
      Some({
        effect: head.effect,
        op: head.op,
        resource: head.resource,
        every_label: head.every_label,
        params: ps,
        label: label,
        resume: resume,
        body: b,
        ty: ty,
        row: row,
        resumed: resumed,
        span: span,
      }),
    _ -> None,
  }

pub fn return_of(
  binder: TypedParam<Type>,
  body: Option<TypedExpr<Type>>,
  ty: Type,
  row: Row,
  span: Span,
) -> Option<TypedReturn<Type>> =
  match body {
    Some(b) -> Some({ binder: binder, body: b, ty: ty, row: row, span: span }),
    None -> None,
  }

pub fn handler_var_of(
  name: Bytes,
  ty: Type,
  init: Option<TypedExpr<Type>>,
  span: Span,
) -> Option<TypedHandlerVar<Type>> =
  match init { Some(i) -> Some({ name: name, ty: ty, init: i, span: span }), None -> None }

pub fn handle_of(
  body: Option<TypedExpr<Type>>,
  row: Row,
  clauses: List<Option<TypedClause<Type>>>,
  ret: Option<Option<TypedReturn<Type>>>,
  vars: List<Option<TypedHandlerVar<Type>>>,
) -> Option<TypedNode<Type>> =
  match ((body, Option::all(clauses), ret, Option::all(vars))) {
    (Some(b), Some(cs), None, Some(vs)) ->
      Some(TypedHandle({ body: b, row: row, clauses: cs, ret: None, vars: vs })),
    (Some(b), Some(cs), Some(Some(r)), Some(vs)) ->
      Some(TypedHandle({ body: b, row: row, clauses: cs, ret: Some(r), vars: vs })),
    _ -> None,
  }

pub fn assign_of(
  name: Bytes,
  value: Option<TypedExpr<Type>>,
  span: Span,
) -> Option<TypedStmt<Type>> =
  match value { Some(v) -> Some(TypedAssign({ name: name, value: v, span: span })), None -> None }

pub fn update_of(
  base: Option<TypedExpr<Type>>,
  sets: List<{ name: Bytes, value: Option<TypedExpr<Type>> }>,
) -> Option<TypedNode<Type>> =
  match ((base, record_of(sets))) {
    (Some(b), Some(TypedRecord(fs))) -> Some(TypedUpdate({ base: b, sets: fs })),
    _ -> None,
  }

pub fn lambda_of(
  params: List<TypedParam<Type>>,
  body: Option<TypedExpr<Type>>,
  row: Row,
) -> Option<TypedNode<Type>> =
  match body { Some(b) -> Some(TypedLambda({ params: params, body: b, row: row })), None -> None }

pub fn block_of(
  stmts: List<Option<TypedStmt<Type>>>,
  tail: Option<Option<TypedExpr<Type>>>,
) -> Option<TypedNode<Type>> =
  match ((Option::all(stmts), tail)) {
    (Some(ss), Some(Some(t))) -> Some(TypedBlock({ stmts: ss, tail: Some(t) })),
    (Some(ss), None) -> Some(TypedBlock({ stmts: ss, tail: None })),
    _ -> None,
  }

// --- Walking the tree ------------------------------------------------------------------------------

/// `e` with each node rewritten by `f` once its parts are.
pub fn rewritten(e: TypedExpr<Type>, f: (TypedExpr<Type>) -> TypedExpr<Type>) -> TypedExpr<Type> = {
  let go = |x: TypedExpr<Type>| rewritten(x, f);
  let opt = |x: Option<TypedExpr<Type>>| match x { Some(y) -> Some(rewritten(y, f)), None -> None };
  f({
    ..e,
    node: match e.node {
      TypedUnary(u) -> TypedUnary({ ..u, operand: go(u.operand) }),
      TypedBinary(b) -> TypedBinary({ ..b, lhs: go(b.lhs), rhs: go(b.rhs) }),
      TypedCall(c) -> TypedCall({ callee: go(c.callee), args: c.args.map(go) }),
      TypedIf(i) ->
        TypedIf({
          cond: go(i.cond),
          then_branch: go(i.then_branch),
          else_branch: go(i.else_branch),
        }),
      TypedMatch(m) ->
        TypedMatch({
          scrutinee: go(m.scrutinee),
          arms: m.arms.map(|a: TypedArm<Type>|
            { pat: a.pat, guard: opt(a.guard), body: go(a.body) }),
        }),
      TypedBlock(b) ->
        TypedBlock({
          stmts: b.stmts.map(|s: TypedStmt<Type>|
            match s {
              TypedLet(l) -> TypedLet({ ..l, value: go(l.value) }),
              TypedLetElse(l) ->
                TypedLetElse({ ..l, value: go(l.value), fallback: go(l.fallback) }),
              TypedDo(x) -> TypedDo(go(x)),
              TypedAssign(a) -> TypedAssign({ ..a, value: go(a.value) }),
            }),
          tail: opt(b.tail),
        }),
      TypedList(xs) -> TypedList(xs.map(go)),
      TypedRecord(fs) ->
        TypedRecord(fs.map(|fd: TypedField<Type>| { name: fd.name, value: go(fd.value) })),
      TypedUpdate(u) ->
        TypedUpdate({
          base: go(u.base),
          sets: u.sets.map(|fd: TypedField<Type>| { name: fd.name, value: go(fd.value) }),
        }),
      TypedFieldRead(r) -> TypedFieldRead({ ..r, base: go(r.base) }),
      TypedPerform(p) -> TypedPerform({ ..p, args: p.args.map(go) }),
      TypedLambda(l) -> TypedLambda({ ..l, body: go(l.body) }),
      TypedSimulate(t) -> TypedSimulate({ ..t, body: go(t.body) }),
      TypedParallel(ts) -> TypedParallel(ts.map(|t: TypedThunk<Type>| { ..t, body: go(t.body) })),
      TypedHandle(h) ->
        TypedHandle({
          ..h,
          body: go(h.body),
          clauses: h.clauses.map(|c: TypedClause<Type>| { ..c, body: go(c.body) }),
          ret: match h.ret { Some(r) -> Some({ ..r, body: go(r.body) }), None -> None },
          vars: h.vars.map(|v: TypedHandlerVar<Type>| { ..v, init: go(v.init) }),
        }),
      TypedLit(l) -> TypedLit(l),
      TypedRead(r) -> TypedRead(r),
    },
  })
}

/// Every node of `e`, each before its parts.
pub fn nodes_of(e: TypedExpr<Type>) -> List<TypedExpr<Type>> = {
  let all = |xs: List<TypedExpr<Type>>|
    xs.fold([], |acc: List<TypedExpr<Type>>, x: TypedExpr<Type>| acc.concat(nodes_of(x)));
  let opt = |x: Option<TypedExpr<Type>>| match x { Some(y) -> nodes_of(y), None -> [] };
  [e].concat(match e.node {
    TypedUnary(u) -> nodes_of(u.operand),
    TypedBinary(b) -> nodes_of(b.lhs).concat(nodes_of(b.rhs)),
    TypedCall(c) -> nodes_of(c.callee).concat(all(c.args)),
    TypedIf(i) -> all([i.cond, i.then_branch, i.else_branch]),
    TypedMatch(m) ->
      nodes_of(m.scrutinee).concat(
        m.arms.fold([], |acc: List<TypedExpr<Type>>, a: TypedArm<Type>|
          acc.concat(opt(a.guard)).concat(nodes_of(a.body))),
      ),
    TypedBlock(b) ->
      b.stmts.fold([], |acc: List<TypedExpr<Type>>, s: TypedStmt<Type>|
        acc.concat(match s {
          TypedLet(l) -> nodes_of(l.value),
          TypedLetElse(l) -> nodes_of(l.value).concat(nodes_of(l.fallback)),
          TypedDo(x) -> nodes_of(x),
          TypedAssign(a) -> nodes_of(a.value),
        })).concat(
        opt(b.tail),
      ),
    TypedList(xs) -> all(xs),
    TypedRecord(fs) -> all(fs.map(|fd: TypedField<Type>| fd.value)),
    TypedUpdate(u) -> nodes_of(u.base).concat(all(u.sets.map(|fd: TypedField<Type>| fd.value))),
    TypedFieldRead(r) -> nodes_of(r.base),
    TypedPerform(p) -> all(p.args),
    TypedLambda(l) -> nodes_of(l.body),
    TypedSimulate(t) -> nodes_of(t.body),
    TypedParallel(ts) -> all(ts.map(|t: TypedThunk<Type>| t.body)),
    TypedHandle(h) ->
      all(h.vars.map(|v: TypedHandlerVar<Type>| v.init)).concat(nodes_of(h.body)).concat(
        all(h.clauses.map(|c: TypedClause<Type>| c.body)),
      ).concat(match h.ret { Some(r) -> nodes_of(r.body), None -> [] }),
    TypedLit(_) -> [],
    TypedRead(_) -> [],
  })
}

// --- Defaults a call on a value copies -------------------------------------------------------------

/// A parameter's default copied into the call at site `call`, typed: the argument at `place`.
pub type PlacedDefault = { call: Int, place: Int, value: Option<TypedExpr<Type>> }

/// `e` with each default in `defaults` put in its call's arguments at its place. None where a
/// default is not typed or its call is not one of `e`'s.
pub fn defaults_placed(
  e: TypedExpr<Type>,
  defaults: List<PlacedDefault>,
) -> Option<TypedExpr<Type>> =
  if defaults.len() == 0 { Some(e) } else {
    let by_call = defaults.fold(Map::new(), |m: Map<Int, List<PlacedDefault>>, d: PlacedDefault|
      m.insert(d.call, match m.get(d.call) { Some(ds) -> ds.push(d), None -> [d] }));
    let calls = nodes_of(e).filter(|x: TypedExpr<Type>|
      match x.node { TypedCall(_) -> by_call.contains(x.span.site), _ -> false });
    let untyped = defaults.any(|d: PlacedDefault| match d.value { Some(_) -> false, None -> true });
    if calls.len() != by_call.len() || untyped { None } else {
      Some(
        rewritten(e, |x: TypedExpr<Type>|
          match ((x.node, by_call.get(x.span.site))) {
            (TypedCall(c), Some(ds)) ->
              {
                ..x,
                node: TypedCall({
                  callee: c.callee,
                  args: ds.sort_by(|a: PlacedDefault, b: PlacedDefault| a.place <= b.place).fold(
                    c.args,
                    |args: List<TypedExpr<Type>>, d: PlacedDefault|
                      match d.value {
                        Some(v) -> args.take(d.place).push(v).concat(args.drop(d.place)),
                        None -> args,
                      },
                  ),
                }),
              },
            _ -> x,
          }),
      )
    }
  }

// --- Writing a tree's types another way ------------------------------------------------------------

/// How `retyped` writes a tree's types: `ty` writes one, threading a state through the types in
/// the order a walk meets them; `row` writes a row and `atom` an atom; `read` settles a read before
/// its types and rows are written.
pub type Retyping<a, b, s> = {
  ty: (a, s) -> { ty: b, state: s } / {abort.raise},
  row: (Row) -> Row / {abort.raise},
  atom: (Atom) -> Atom / {abort.raise},
  read: (Reading<a>) -> Reading<a> / {abort.raise},
}

/// What retyping a part found, and the state after it.
pub type Retyped<x, s> = { out: x, state: s }

/// `e` with every type written as `r` writes it.
pub fn retyped<a, b, s>(
  e: TypedExpr<a>,
  state: s,
  r: Retyping<a, b, s>,
) -> Retyped<TypedExpr<b>, s> / {abort.raise} = {
  let node = retyped_node(e.node, state, r);
  let t = (r.ty)(e.ty, node.state);
  { out: { node: node.out, span: e.span, ty: t.ty }, state: t.state }
}

fn retyped_all<a, b, s>(
  xs: List<TypedExpr<a>>,
  state: s,
  r: Retyping<a, b, s>,
) -> Retyped<List<TypedExpr<b>>, s> / {abort.raise} =
  xs.fold({ out: [], state: state }, |acc: Retyped<List<TypedExpr<b>>, s>, x: TypedExpr<a>| {
    let o = retyped(x, acc.state, r);
    { out: acc.out.push(o.out), state: o.state }
  })

fn retyped_opt<a, b, s>(
  x: Option<TypedExpr<a>>,
  state: s,
  r: Retyping<a, b, s>,
) -> Retyped<Option<TypedExpr<b>>, s> / {abort.raise} =
  match x {
    Some(y) -> {
      let o = retyped(y, state, r);
      { out: Some(o.out), state: o.state }
    },
    None -> { out: None, state: state },
  }

fn retyped_types<a, b, s>(
  tys: List<a>,
  state: s,
  r: Retyping<a, b, s>,
) -> Retyped<List<b>, s> / {abort.raise} =
  tys.fold({ out: [], state: state }, |acc: Retyped<List<b>, s>, t: a| {
    let o = (r.ty)(t, acc.state);
    { out: acc.out.push(o.ty), state: o.state }
  })

fn retyped_param<a, b, s>(
  p: TypedParam<a>,
  state: s,
  r: Retyping<a, b, s>,
) -> Retyped<TypedParam<b>, s> / {abort.raise} = {
  let t = (r.ty)(p.ty, state);
  { out: { name: p.name, ty: t.ty, span: p.span }, state: t.state }
}

fn retyped_params<a, b, s>(
  ps: List<TypedParam<a>>,
  state: s,
  r: Retyping<a, b, s>,
) -> Retyped<List<TypedParam<b>>, s> / {abort.raise} =
  ps.fold({ out: [], state: state }, |acc: Retyped<List<TypedParam<b>>, s>, p: TypedParam<a>| {
    let o = retyped_param(p, acc.state, r);
    { out: acc.out.push(o.out), state: o.state }
  })

fn retyped_param_opt<a, b, s>(
  p: Option<TypedParam<a>>,
  state: s,
  r: Retyping<a, b, s>,
) -> Retyped<Option<TypedParam<b>>, s> / {abort.raise} =
  match p {
    Some(q) -> {
      let o = retyped_param(q, state, r);
      { out: Some(o.out), state: o.state }
    },
    None -> { out: None, state: state },
  }

fn retyped_fields<a, b, s>(
  fs: List<TypedField<a>>,
  state: s,
  r: Retyping<a, b, s>,
) -> Retyped<List<TypedField<b>>, s> / {abort.raise} =
  fs.fold({ out: [], state: state }, |acc: Retyped<List<TypedField<b>>, s>, f: TypedField<a>| {
    let o = retyped(f.value, acc.state, r);
    { out: acc.out.push({ name: f.name, value: o.out }), state: o.state }
  })

fn retyped_thunk<a, b, s>(
  t: TypedThunk<a>,
  state: s,
  r: Retyping<a, b, s>,
) -> Retyped<TypedThunk<b>, s> / {abort.raise} = {
  let o = retyped(t.body, state, r);
  { out: { body: o.out, row: (r.row)(t.row) }, state: o.state }
}

fn retyped_reading<a, b, s>(
  read: Reading<a>,
  state: s,
  r: Retyping<a, b, s>,
) -> Retyped<Reading<b>, s> / {abort.raise} =
  match (r.read)(read) {
    ReadLocal(n) -> { out: ReadLocal(n), state: state },
    ReadDefinition(d) -> {
      let args = retyped_types(d.args, state, r);
      {
        out: ReadDefinition({
          full: d.full,
          args: args.out,
          rows: d.rows.map(r.row),
          quantified: d.quantified,
        }),
        state: args.state,
      }
    },
    ReadConstructor(c) -> {
      let args = retyped_types(c.args, state, r);
      {
        out: ReadConstructor({ sum: c.sum, name: c.name, case: c.case, args: args.out }),
        state: args.state,
      }
    },
    ReadBuiltin(f) -> {
      let args = retyped_types(f.args, state, r);
      {
        out: ReadBuiltin({ name: f.name, args: args.out, rows: f.rows.map(r.row) }),
        state: args.state,
      }
    },
  }

fn retyped_pattern<a, b, s>(
  p: TypedPattern<a>,
  state: s,
  r: Retyping<a, b, s>,
) -> Retyped<TypedPattern<b>, s> / {abort.raise} = {
  let each = |ps: List<TypedPattern<a>>, st: s|
    ps.fold({ out: [], state: st }, |acc: Retyped<List<TypedPattern<b>>, s>, x: TypedPattern<a>| {
      let o = retyped_pattern(x, acc.state, r);
      { out: acc.out.push(o.out), state: o.state }
    });
  match p {
    TypedWild -> { out: TypedWild, state: state },
    TypedBinder(v) -> {
      let t = (r.ty)(v.ty, state);
      { out: TypedBinder({ name: v.name, ty: t.ty, span: v.span }), state: t.state }
    },
    TypedLitPattern(l) -> { out: TypedLitPattern(l), state: state },
    TypedRange(g) -> { out: TypedRange(g), state: state },
    TypedCase(c) -> {
      let args = each(c.args, state);
      {
        out: TypedCase({ sum: c.sum, name: c.name, case: c.case, args: args.out }),
        state: args.state,
      }
    },
    TypedRecordPattern(rp) -> {
      let fields = rp.fields.fold(
        { out: [], state: state },
        |acc: Retyped<List<TypedFieldPattern<b>>, s>, f: TypedFieldPattern<a>| {
          let o = retyped_pattern(f.pat, acc.state, r);
          { out: acc.out.push({ name: f.name, pat: o.out }), state: o.state }
        },
      );
      { out: TypedRecordPattern({ fields: fields.out, rest: rp.rest }), state: fields.state }
    },
    TypedListPattern(lp) -> {
      let items = each(lp.items, state);
      match lp.rest {
        Some(x) -> {
          let o = retyped_pattern(x, items.state, r);
          { out: TypedListPattern({ items: items.out, rest: Some(o.out) }), state: o.state }
        },
        None -> { out: TypedListPattern({ items: items.out, rest: None }), state: items.state },
      }
    },
    TypedOr(alts) -> {
      let o = each(alts, state);
      { out: TypedOr(o.out), state: o.state }
    },
  }
}

fn retyped_stmt<a, b, s>(
  stmt: TypedStmt<a>,
  state: s,
  r: Retyping<a, b, s>,
) -> Retyped<TypedStmt<b>, s> / {abort.raise} =
  match stmt {
    TypedLet(l) -> {
      let p = retyped_pattern(l.pat, state, r);
      let v = retyped(l.value, p.state, r);
      { out: TypedLet({ pat: p.out, value: v.out, span: l.span }), state: v.state }
    },
    TypedLetElse(l) -> {
      let p = retyped_pattern(l.pat, state, r);
      let v = retyped(l.value, p.state, r);
      let f = retyped(l.fallback, v.state, r);
      {
        out: TypedLetElse({ pat: p.out, value: v.out, fallback: f.out, span: l.span }),
        state: f.state,
      }
    },
    TypedDo(x) -> {
      let o = retyped(x, state, r);
      { out: TypedDo(o.out), state: o.state }
    },
    TypedAssign(asg) -> {
      let o = retyped(asg.value, state, r);
      { out: TypedAssign({ name: asg.name, value: o.out, span: asg.span }), state: o.state }
    },
  }

fn retyped_clause<a, b, s>(
  c: TypedClause<a>,
  state: s,
  r: Retyping<a, b, s>,
) -> Retyped<TypedClause<b>, s> / {abort.raise} = {
  let params = retyped_params(c.params, state, r);
  let label = retyped_param_opt(c.label, params.state, r);
  let resume = retyped_param_opt(c.resume, label.state, r);
  let body = retyped(c.body, resume.state, r);
  let t = (r.ty)(c.ty, body.state);
  {
    out: {
      effect: c.effect,
      op: c.op,
      resource: c.resource,
      every_label: c.every_label,
      params: params.out,
      label: label.out,
      resume: resume.out,
      body: body.out,
      ty: t.ty,
      row: (r.row)(c.row),
      resumed: (r.row)(c.resumed),
      span: c.span,
    },
    state: t.state,
  }
}

fn retyped_node<a, b, s>(
  node: TypedNode<a>,
  state: s,
  r: Retyping<a, b, s>,
) -> Retyped<TypedNode<b>, s> / {abort.raise} =
  match node {
    TypedLit(l) -> { out: TypedLit(l), state: state },
    TypedRead(read) -> {
      let o = retyped_reading(read, state, r);
      { out: TypedRead(o.out), state: o.state }
    },
    TypedUnary(u) -> {
      let o = retyped(u.operand, state, r);
      { out: TypedUnary({ op: u.op, operand: o.out }), state: o.state }
    },
    TypedBinary(bin) -> {
      let l = retyped(bin.lhs, state, r);
      let rh = retyped(bin.rhs, l.state, r);
      { out: TypedBinary({ op: bin.op, lhs: l.out, rhs: rh.out }), state: rh.state }
    },
    TypedCall(c) -> {
      let f = retyped(c.callee, state, r);
      let args = retyped_all(c.args, f.state, r);
      { out: TypedCall({ callee: f.out, args: args.out }), state: args.state }
    },
    TypedIf(i) -> {
      let c = retyped(i.cond, state, r);
      let t = retyped(i.then_branch, c.state, r);
      let el = retyped(i.else_branch, t.state, r);
      { out: TypedIf({ cond: c.out, then_branch: t.out, else_branch: el.out }), state: el.state }
    },
    TypedMatch(m) -> {
      let sc = retyped(m.scrutinee, state, r);
      let arms = m.arms.fold(
        { out: [], state: sc.state },
        |acc: Retyped<List<TypedArm<b>>, s>, arm: TypedArm<a>| {
          let p = retyped_pattern(arm.pat, acc.state, r);
          let g = retyped_opt(arm.guard, p.state, r);
          let body = retyped(arm.body, g.state, r);
          { out: acc.out.push({ pat: p.out, guard: g.out, body: body.out }), state: body.state }
        },
      );
      { out: TypedMatch({ scrutinee: sc.out, arms: arms.out }), state: arms.state }
    },
    TypedBlock(blk) -> {
      let stmts = blk.stmts.fold(
        { out: [], state: state },
        |acc: Retyped<List<TypedStmt<b>>, s>, x: TypedStmt<a>| {
          let o = retyped_stmt(x, acc.state, r);
          { out: acc.out.push(o.out), state: o.state }
        },
      );
      let tail = retyped_opt(blk.tail, stmts.state, r);
      { out: TypedBlock({ stmts: stmts.out, tail: tail.out }), state: tail.state }
    },
    TypedList(xs) -> {
      let o = retyped_all(xs, state, r);
      { out: TypedList(o.out), state: o.state }
    },
    TypedRecord(fs) -> {
      let o = retyped_fields(fs, state, r);
      { out: TypedRecord(o.out), state: o.state }
    },
    TypedUpdate(u) -> {
      let base = retyped(u.base, state, r);
      let sets = retyped_fields(u.sets, base.state, r);
      { out: TypedUpdate({ base: base.out, sets: sets.out }), state: sets.state }
    },
    TypedFieldRead(f) -> {
      let base = retyped(f.base, state, r);
      { out: TypedFieldRead({ base: base.out, field: f.field }), state: base.state }
    },
    TypedPerform(p) -> {
      let args = retyped_all(p.args, state, r);
      {
        out: TypedPerform({
          effect: p.effect,
          op: p.op,
          resource: p.resource,
          atom: (r.atom)(p.atom),
          args: args.out,
        }),
        state: args.state,
      }
    },
    TypedLambda(l) -> {
      let params = retyped_params(l.params, state, r);
      let body = retyped(l.body, params.state, r);
      {
        out: TypedLambda({ params: params.out, body: body.out, row: (r.row)(l.row) }),
        state: body.state,
      }
    },
    TypedSimulate(t) -> {
      let o = retyped_thunk(t, state, r);
      { out: TypedSimulate(o.out), state: o.state }
    },
    TypedParallel(ts) -> {
      let o = ts.fold(
        { out: [], state: state },
        |acc: Retyped<List<TypedThunk<b>>, s>, t: TypedThunk<a>| {
          let x = retyped_thunk(t, acc.state, r);
          { out: acc.out.push(x.out), state: x.state }
        },
      );
      { out: TypedParallel(o.out), state: o.state }
    },
    TypedHandle(h) -> {
      let vars = h.vars.fold(
        { out: [], state: state },
        |acc: Retyped<List<TypedHandlerVar<b>>, s>, v: TypedHandlerVar<a>| {
          let init = retyped(v.init, acc.state, r);
          let t = (r.ty)(v.ty, init.state);
          {
            out: acc.out.push({ name: v.name, ty: t.ty, init: init.out, span: v.span }),
            state: t.state,
          }
        },
      );
      let body = retyped(h.body, vars.state, r);
      let clauses = h.clauses.fold(
        { out: [], state: body.state },
        |acc: Retyped<List<TypedClause<b>>, s>, c: TypedClause<a>| {
          let o = retyped_clause(c, acc.state, r);
          { out: acc.out.push(o.out), state: o.state }
        },
      );
      let ret: Retyped<Option<TypedReturn<b>>, s> = match h.ret {
        Some(rc) -> {
          let binder = retyped_param(rc.binder, clauses.state, r);
          let rbody = retyped(rc.body, binder.state, r);
          let t = (r.ty)(rc.ty, rbody.state);
          {
            out: Some({
              binder: binder.out,
              body: rbody.out,
              ty: t.ty,
              row: (r.row)(rc.row),
              span: rc.span,
            }),
            state: t.state,
          }
        },
        None -> { out: None, state: clauses.state },
      };
      {
        out: TypedHandle({
          body: body.out,
          row: (r.row)(h.row),
          clauses: clauses.out,
          ret: ret.out,
          vars: vars.out,
        }),
        state: ret.state,
      }
    },
  }
