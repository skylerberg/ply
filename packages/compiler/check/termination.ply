import compiler.syntax.parsing (Span, Identifier, QName, span_bin, span_between, bare)
import compiler.syntax.patterns (Pattern, binder_names, PatternWildcard, PatternVariable,
                                 PatternLiteral, PatternRange, PatternConstructor, PatternRecord,
                                 PatternList, PatternOr, PatternInvalid, LiteralInt, LiteralFixed,
                                 LiteralWide, LiteralInvalid, LiteralBool)
import compiler.syntax.expressions (Expression, LiteralExpression, NameExpression, BinaryExpression,
                                    UnaryExpression, LambdaExpression, CallExpression, IfExpression,
                                    MatchExpression, BlockExpression, RecordExpression,
                                    RecordUpdateExpression, PropagateExpression, FieldExpression,
                                    ListExpression, PerformExpression, HandleExpression,
                                    WithScopeExpression, SimulateExpression, ParallelExpression,
                                    InvalidExpression, HoleExpression, TryBlockExpression,
                                    Statement, LetStatement, LetElseStatement, ExpressionStatement,
                                    AssignmentStatement, HandlerVar, Param, NamedArg, MatchArm,
                                    HandleClause, RecordLiteralField, expression_span,
                                    TaggedLiteralExpression, TaggedLiteral, Hole, tagged_parser,
                                    tagged_filler)
import compiler.syntax.items (FnDefinition)
import compiler.check.types (Type, VariableType, NamedType, FunctionType, RecordType, NominalType,
                             Field, record_fields)
import compiler.check.known (is_integer_name, bool_name, string_name, bytes_name, float_name,
                             decimal_name, char_name, unit_name, list_item, array_element,
                             columns_row, some_constructor)
import compiler.check.callbacks (CallbackUse, CallbackArgument, Element, Accumulator, Mapped,
                                 Filtered, Folded, callback_use, prelude_callback_use)
import std.bin
import std.graph
import std.list
import std.math (pow)

pub type Callee =
  | GroupMember(Int)
  | BuiltinCallee(Bytes)
  | ConstructorCallee
  | DefinedCallee(Bytes)
  | OtherCallee

pub type Termination =
  | Terminates
  | TerminatesByDecreases
  | Diverges({ at: Site, through: Option<Bytes>, loop: List<Site> })

pub type Site = { caller: Bytes, span: Span }

pub type Place = { param: Int, path: List<Bytes> }

pub type Base =
  | PlaceBase(Place)
  | LengthBase({ name: Bytes, of: Place })
  | QuotientBase({ of: Base, by: Int, op: Bytes })
  | RemainderBase({ by: Base })

pub type Linear = { base: Option<Base>, k: Int }

pub type Term =
  | Exactly(Linear)
  | Below(Place)
  | Inside(Place)
  | PartsOf(Place)
  | RecordTerm({ base: Option<Term>, fields: List<{ name: Bytes, term: Term }> })
  | NoParts
  | Wrapped(Term)
  | SameLength(Place)
  | UnknownTerm
  | PartsOfAny(List<Place>)

pub type Summary = { names: List<Bytes>, params: List<Passing>, result: Term }

pub type Passing = | NotCalled | CalledWith(List<List<Term>>) | Escapes

pub type Group = {
  definitions: List<FnDefinition>,
  names: List<Bytes>,
  params: List<List<Type>>,
  resolve: (Int, QName) -> Callee / {abort.raise},
  binders: List<Map<Int, Int>>,
  stated: (Int, Span) -> List<Callee> / {abort.raise},
  ending_of: (Bytes) -> Termination / {abort.raise},
  summary_of: (Bytes) -> Option<Summary>,
}

pub type Verdict = { endings: List<Termination>, summaries: List<Summary> }

derive bin for Callee
derive bin for Site
derive bin for Termination
derive bin for Place
derive bin for Base
derive bin for Linear
derive bin for Term
derive bin for Passing
derive bin for Summary

pub fn unknown_summary() -> Summary = { names: [], params: [], result: UnknownTerm }

type Fact = { lo: Linear, hi: Linear, strict: Bool }

type Local =
  | KnownTerm(Term)
  | FunctionParam(Int)
  | LetLambda({ params: List<Param>, body: Expression, locals: Map<Int, Local> })

type Scope = { locals: Map<Int, Local>, facts: List<Fact> }

type Call = { callee: Int, args: List<Term>, facts: List<Fact>, span: Span }

type Use = { param: Int, args: Option<List<Term>> }

type ExternalCall = { name: Bytes, span: Span }

type Findings = {
  calls: List<Call>,
  uses: List<Use>,
  outside: List<ExternalCall>,
  lost: Option<Span>,
}

type MemberContext = { group: Group, current: Int, depth: Int, results: List<Option<Term>> }

type Measure =
  | SizeMeasure(Place)
  | ElementMeasure(Place)
  | DifferenceMeasure({ hi: Option<Base>, lo: Option<Base> })
  | StatedMeasure

type Arc = { a: Int, b: Int, strict: Bool }

type Graph = { from: Int, to: Int, arcs: List<Arc>, calls: List<Site> }

pub fn verdict(g: Group) -> Verdict / {abort.raise} = {
  let results = stable_results(g);
  let seen = range(0, g.definitions.len()).map(|i: Int|
    walk_definition({ group: g, current: i, depth: 0, results: results }, g.definitions.get(i)));
  let calls = seen.map(|x: Findings| x.calls);
  let stating = g.definitions.fold(false, |acc: Bool, d: FnDefinition|
    acc || (match d.decreases { Some(_) -> true, None -> false }));
  let lost = range(0, seen.len()).fold(None, |acc: Option<Site>, i: Int|
    match acc {
      Some(_) -> acc,
      None -> match seen.get(i).lost { Some(span) -> Some(site(g, i, span)), None -> None },
    });
  let own = match lost {
    Some(s) -> Diverges({ at: s, through: None, loop: [] }),
    None -> match find_non_decreasing_loop(g, calls, false) {
      None -> Terminates,
      Some(first) -> if !stating { divergence(first) } else {
        match find_non_decreasing_loop(g, calls, true) {
          None -> TerminatesByDecreases,
          Some(again) -> divergence(again),
        }
      },
    },
  };
  let out = |member: Int|
    |e: Termination, o: ExternalCall|
      weaker(e, match (g.ending_of)(o.name) {
        Diverges(_) -> Diverges({ at: site(g, member, o.span), through: Some(o.name), loop: [] }),
        other -> other,
      });
  let settled = match own { Diverges(_) -> Terminates, other -> other };
  {
    endings: range(0, g.definitions.len()).map(|i: Int|
      range(0, seen.len()).fold(
        weaker(seen.get(i).outside.fold(settled, out(i)), own),
        |e: Termination, j: Int| seen.get(j).outside.fold(e, out(j)),
      )),
    summaries: range(0, g.definitions.len()).map(|i: Int|
      summary({ group: g, current: i, depth: 0, results: results }, seen.get(i))),
  }
}

fn stable_results(g: Group) -> List<Option<Term>> / {abort.raise} = {
  let n = g.definitions.len();
  let round = |rs: List<Option<Term>>|
    range(0, n).map(|i: Int| {
      let context = { group: g, current: i, depth: 0, results: rs };
      result_term(context, entry_scope(context, g.definitions.get(i)), g.definitions.get(i).body)
    });
  iterate(
    { rs: range(0, n).map(|i: Int| None), k: 0 },
    max_result_rounds() + 2,
    |st: { rs: List<Option<Term>>, k: Int }|
      if st.k >= max_result_rounds() { Stop(range(0, n).map(|i: Int| Some(UnknownTerm))) } else {
        let next = round(st.rs);
        if next == st.rs { Stop(st.rs) } else { Continue({ rs: next, k: st.k + 1 }) }
      },
  )
}

fn max_result_rounds() -> Int = 6

fn divergence(u: NonDecreasingLoop) -> Termination =
  Diverges({ at: u.at, through: None, loop: u.loop })

type NonDecreasingLoop = { at: Site, loop: List<Site> }

fn site(g: Group, member: Int, span: Span) -> Site / {abort.raise} = {
  let start = g.definitions.get(member).span.start;
  { caller: g.names.get(member), span: span_between(span.start - start, span.end - start) }
}

fn weaker(a: Termination, b: Termination) -> Termination =
  match a {
    Diverges(_) -> a,
    TerminatesByDecreases -> match b { Diverges(_) -> b, _ -> a },
    Terminates -> b,
  }

fn find_non_decreasing_loop(
  g: Group,
  calls: List<List<Call>>,
  stated: Bool,
) -> Option<NonDecreasingLoop> / {abort.raise} = {
  let measures = spread(
    calls,
    range(0, g.definitions.len()).map(|i: Int| measures_of(g, i, calls.get(i), stated)),
  );
  let graphs = range(0, g.definitions.len()).fold([], |acc: List<Graph>, i: Int|
    calls.get(i).fold(acc, |gs: List<Graph>, c: Call|
      add_graph(gs, call_graph(g, measures, i, c))));
  search_loops(g.definitions.len(), deciding(measures, graphs))
}

fn deciding(measures: List<List<Measure>>, graphs: List<Graph>) -> List<Graph> / {abort.raise} = {
  let starts = measures.fold([0], |acc: List<Int>, ms: List<Measure>|
    acc.push(acc.at_or(acc.len() - 1, 0) + ms.len()));
  let node = |member: Int, m: Int| starts.at_or(member, 0) + m;
  let edges = graphs.fold([], |acc: List<graph::Edge>, x: Graph|
    x.arcs.fold(acc, |es: List<graph::Edge>, r: Arc|
      es.push({ from: node(x.from, r.a), target: node(x.to, r.b) })));
  let total = starts.at_or(starts.len() - 1, 0);
  let parts = graph::components(graph::of_edges(total, edges));
  let component = range(0, parts.len()).fold(Map::new(), |m: Map<Int, Int>, i: Int|
    parts.get(i).fold(m, |acc: Map<Int, Int>, v: Int| acc.insert(v, i)));
  let inside = |x: Graph, r: Arc|
    component.get(node(x.from, r.a)) == component.get(node(x.to, r.b));
  let shrinking = graphs.fold(Map::new(), |m: Map<Int, Bool>, x: Graph|
    x.arcs.fold(m, |acc: Map<Int, Bool>, r: Arc|
      if r.strict && inside(x, r) {
        match component.get(node(x.from, r.a)) { Some(c) -> acc.insert(c, true), None -> acc }
      } else { acc }));
  graphs.fold([], |acc: List<Graph>, x: Graph|
    add_graph(acc, {
      ..x,
      arcs: x.arcs.filter(|r: Arc|
        inside(x, r)
          && (match component.get(node(x.from, r.a)) {
            Some(c) -> shrinking.contains(c),
            None -> false,
          })),
    }))
}

fn idempotent(x: Graph) -> Bool / {abort.raise} = same_arcs(composed(x, x).arcs, x.arcs)

fn shrinks(x: Graph) -> Bool =
  x.arcs.fold(false, |acc: Bool, r: Arc| acc || (r.strict && r.a == r.b))

type GraphClosure = {
  buckets: Map<Int, List<Graph>>,
  queue: List<Graph>,
  next: Int,
  bad: Option<NonDecreasingLoop>,
}

fn search_loops(n: Int, calls: List<Graph>) -> Option<NonDecreasingLoop> / {abort.raise} = {
  let from = range(0, n).map(|i: Int| calls.filter(|x: Graph| x.from == i));
  let start = calls.fold(
    { buckets: Map::new(), queue: [], next: 0, bad: None },
    |c: GraphClosure, x: Graph| enqueue(c, n, x),
  );
  iterate(start, max_closure_size() + 2, |c: GraphClosure|
    match c.bad {
      Some(_) -> Stop(c.bad),
      None -> if c.next >= c.queue.len() { Stop(None) } else if c.queue.len() > max_closure_size() {
        Stop(Some({ at: c.queue.get(0).calls.get(0), loop: [] }))
      } else {
        let x = c.queue.get(c.next);
        let grown = from.get(x.to).fold(c, |acc: GraphClosure, y: Graph|
          enqueue(acc, n, composed(x, y)));
        Continue({ ..grown, next: c.next + 1 })
      },
    })
}

fn enqueue(c: GraphClosure, n: Int, x: Graph) -> GraphClosure / {abort.raise} = {
  let key = x.from * n + x.to;
  let bucket = match c.buckets.get(key) { Some(b) -> b, None -> [] };
  if bucket.fold(false, |found: Bool, y: Graph| found || same_arcs(y.arcs, x.arcs)) { c } else {
    {
      ..c,
      buckets: c.buckets.insert(key, bucket.push(x)),
      queue: c.queue.push(x),
      bad: match c.bad {
        Some(_) -> c.bad,
        None -> if x.from == x.to && idempotent(x) && !shrinks(x) {
          Some({ at: x.calls.get(0), loop: x.calls })
        } else { None },
      },
    }
  }
}

fn max_closure_size() -> Int = 10000

fn add_graph(gs: List<Graph>, x: Graph) -> List<Graph> =
  if gs.fold(false, |found: Bool, y: Graph|
      found || (y.from == x.from && y.to == x.to && same_arcs(y.arcs, x.arcs))) { gs }
  else { gs.push(x) }

fn same_arcs(a: List<Arc>, b: List<Arc>) -> Bool =
  a.len() == b.len() && a.fold(true, |ok: Bool, r: Arc| ok && has_arc(b, r))

fn has_arc(xs: List<Arc>, r: Arc) -> Bool = xs.fold(false, |found: Bool, x: Arc| found || x == r)

fn composed(x: Graph, y: Graph) -> Graph / {abort.raise} =
  {
    from: x.from,
    to: y.to,
    arcs: x.arcs.fold([], |acc: List<Arc>, r: Arc|
      y.arcs.fold(acc, |a: List<Arc>, s: Arc|
        if r.b != s.a { a }
        else { with_arc(a, { a: r.a, b: s.b, strict: r.strict || s.strict }) })),
    calls: y.calls.fold(x.calls, |acc: List<Site>, s: Site| acc.push(s)),
  }

fn with_arc(xs: List<Arc>, r: Arc) -> List<Arc> / {abort.raise} =
  match range(0, xs.len()).fold(None, |found: Option<Int>, i: Int|
      match found {
        Some(_) -> found,
        None -> if xs.get(i).a == r.a && xs.get(i).b == r.b { Some(i) } else { None },
      }) {
    None -> xs.push(r),
    Some(i) -> if r.strict { xs.set(i, r) } else { xs },
  }

fn measures_of(
  g: Group,
  member: Int,
  calls: List<Call>,
  stated: Bool,
) -> List<Measure> / {abort.raise} = {
  let sized = range(0, g.definitions.get(member).params.len()).fold(
    [],
    |acc: List<Measure>, i: Int| {
      let p = { param: i, path: [] };
      let size = acc.push(SizeMeasure(p));
      if holds_list(g, member, p) { size.push(ElementMeasure(p)) } else { size }
    },
  );
  let params = match g.definitions.get(member).decreases {
    Some(_) -> if stated { sized.push(StatedMeasure) } else { sized },
    None -> sized,
  };
  let deep = calls.fold(params, |acc: List<Measure>, c: Call|
    c.args.fold(acc, |a: List<Measure>, t: Term| deeper_places(a, t)));
  calls.fold(deep, |acc: List<Measure>, c: Call|
    c.facts.fold(acc, |a: List<Measure>, f: Fact| with_difference(a, f.hi.base, f.lo.base)))
}

fn with_difference(xs: List<Measure>, hi: Option<Base>, lo: Option<Base>) -> List<Measure> =
  if hi == lo || remains(hi) || remains(lo) { xs }
  else { with_measure(xs, DifferenceMeasure({ hi: hi, lo: lo })) }

fn remains(b: Option<Base>) -> Bool = match b { Some(x) -> remainder_in(x), None -> false }

fn remainder_in(b: Base) -> Bool =
  match b { RemainderBase(_) -> true, QuotientBase(q) -> remainder_in(q.of), _ -> false }

fn spread(calls: List<List<Call>>, ms: List<List<Measure>>) -> List<List<Measure>> / {abort.raise} =
  range(0, ms.len()).fold(ms, |acc: List<List<Measure>>, _: Int|
    range(0, acc.len()).map(|i: Int|
      calls.get(i).fold(acc.get(i), |mine: List<Measure>, c: Call|
        acc.get(c.callee).fold(mine, |m: List<Measure>, x: Measure|
          match measure_at_call(c, x) {
            DifferenceValue(v) -> match v.hi {
              Some(hi) -> match v.lo {
                Some(lo) -> with_difference(m, hi.base, lo.base),
                None -> m,
              },
              None -> m,
            },
            SizeValue(Exactly(l)) -> match field_place(l) {
              Some(p) -> with_measure(m, SizeMeasure(p)),
              None -> m,
            },
            _ -> m,
          }))))

fn field_place(l: Linear) -> Option<Place> =
  match l.base {
    Some(PlaceBase(p)) -> if l.k == 0 && p.path.len() > 0 { Some(p) } else { None },
    _ -> None,
  }

fn deeper_places(acc: List<Measure>, t: Term) -> List<Measure> =
  match t {
    Exactly(l) -> match field_place(l) {
      Some(p) -> with_measure(acc, SizeMeasure(p)),
      None -> acc,
    },
    Wrapped(x) -> deeper_places(acc, x),
    Below(p) -> if p.path.len() == 0 { acc } else { with_measure(acc, SizeMeasure(p)) },
    Inside(p) -> if p.path.len() == 0 { acc } else { with_measure(acc, SizeMeasure(p)) },
    RecordTerm(r) -> {
      let based = match r.base { Some(b) -> deeper_places(acc, b), None -> acc };
      r.fields.fold(based, |a: List<Measure>, f: { name: Bytes, term: Term }|
        deeper_places(a, f.term))
    },
    _ -> acc,
  }

fn with_measure(xs: List<Measure>, m: Measure) -> List<Measure> =
  if xs.fold(false, |found: Bool, x: Measure| found || x == m) { xs } else { xs.push(m) }

fn call_graph(
  g: Group,
  measures: List<List<Measure>>,
  member: Int,
  c: Call,
) -> Graph / {abort.raise} = {
  let mine = measures.get(member);
  let theirs = measures.get(c.callee);
  {
    from: member,
    to: c.callee,
    arcs: range(0, theirs.len()).fold([], |acc: List<Arc>, j: Int| {
      let value = measure_at_call(c, theirs.get(j));
      range(0, mine.len()).fold(acc, |a: List<Arc>, i: Int|
        match relation(g, member, c, mine.get(i), value) {
          None -> a,
          Some(strict) -> with_arc(a, { a: i, b: j, strict: strict }),
        })
    }),
    calls: [site(g, member, c.span)],
  }
}

type MeasureValue =
  | SizeValue(Term)
  | ElementValue(Term)
  | DifferenceValue({ hi: Option<Linear>, lo: Option<Linear> })
  | StatedValue

fn measure_at_call(c: Call, m: Measure) -> MeasureValue =
  match m {
    SizeMeasure(q) -> SizeValue(along(arg(c, q.param), q.path)),
    ElementMeasure(q) -> ElementValue(along(arg(c, q.param), q.path)),
    DifferenceMeasure(d) ->
      DifferenceValue({ hi: substituted(c.args, d.hi), lo: substituted(c.args, d.lo) }),
    StatedMeasure -> StatedValue,
  }

fn arg(c: Call, i: Int) -> Term = actual(c.args, i)

fn actual(args: List<Term>, i: Int) -> Term = match args.at(i) { Some(t) -> t, None -> UnknownTerm }

fn along(t: Term, path: List<Bytes>) -> Term = path.fold(t, |x: Term, f: Bytes| project(x, f))

fn substituted(args: List<Term>, b: Option<Base>) -> Option<Linear> =
  match b {
    None -> Some({ base: None, k: 0 }),
    Some(x) -> match base_at(args, x) { Some(Exactly(l)) -> Some(l), _ -> None },
  }

fn base_at(args: List<Term>, b: Base) -> Option<Term> =
  match b {
    PlaceBase(q) -> Some(along(actual(args, q.param), q.path)),
    LengthBase(n) -> match along(actual(args, n.of.param), n.of.path) {
      Exactly(l) -> match l.base {
        Some(PlaceBase(p)) -> if l.k != 0 { None }
        else { Some(Exactly({ base: Some(LengthBase({ name: n.name, of: p })), k: 0 })) },
        _ -> None,
      },
      SameLength(p) -> Some(Exactly({ base: Some(LengthBase({ name: n.name, of: p })), k: 0 })),
      _ -> None,
    },
    QuotientBase(q) -> match base_at(args, q.of) {
      Some(Exactly(l)) -> match l.base {
        Some(x) -> if l.k != 0 { None }
        else { Some(Exactly({ base: Some(QuotientBase({ ..q, of: x })), k: 0 })) },
        None -> None,
      },
      _ -> None,
    },
    RemainderBase(r) -> match base_at(args, r.by) {
      Some(Exactly(l)) -> match l.base {
        Some(x) -> if l.k != 0 { None }
        else { Some(Exactly({ base: Some(RemainderBase({ by: x })), k: 0 })) },
        None -> None,
      },
      _ -> None,
    },
  }

fn relation(
  g: Group,
  member: Int,
  c: Call,
  mine: Measure,
  value: MeasureValue,
) -> Option<Bool> / {abort.raise} =
  match mine {
    SizeMeasure(p) -> match value {
      SizeValue(t) -> size_relation(t, p, place_type(g, member, p)),
      ElementValue(t) -> elements_below(t, p),
      _ -> None,
    },
    ElementMeasure(p) -> match value {
      SizeValue(t) -> match t { Below(q) -> if q == p { Some(false) } else { None }, _ -> None },
      ElementValue(t) -> element_relation(t, p),
      _ -> None,
    },
    DifferenceMeasure(d) -> match value {
      DifferenceValue(v) -> match v.hi {
        None -> None,
        Some(hi) -> match v.lo {
          None -> None,
          Some(lo) -> if lo.base != d.lo { None } else if hi.base == d.hi {
            match checked_sub(hi.k, lo.k) {
              None -> None,
              Some(delta) -> if delta > 0 { None }
              else if delta == 0 { Some(false) }
              else { Some(bounded(c.facts, d.hi, d.lo)) },
            }
          } else { shrunk(c.facts, hi, lo, d.hi, d.lo) },
        },
      },
      _ -> None,
    },
    StatedMeasure -> match value { StatedValue -> Some(true), _ -> None },
  }

fn elements_below(t: Term, p: Place) -> Option<Bool> =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(q)) -> if l.k == 0 && (q == p || within(q, p)) { Some(true) } else { None },
      _ -> None,
    },
    NoParts -> Some(true),
    _ -> match place_of(t) {
      Some(q) -> if q == p || within(q, p) { Some(true) } else { None },
      None -> None,
    },
  }

fn element_relation(t: Term, p: Place) -> Option<Bool> =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(q)) -> if l.k == 0 && q == p { Some(false) } else { None },
      _ -> None,
    },
    Inside(q) -> if q == p { Some(false) } else { None },
    Below(q) -> if q == p { Some(true) } else { None },
    NoParts -> Some(false),
    _ -> None,
  }

fn shrunk(
  facts: List<Fact>,
  hi: Linear,
  lo: Linear,
  was: Option<Base>,
  floor: Option<Base>,
) -> Option<Bool> =
  if floor != None || lo.k != 0 || hi.k > 0 { None } else {
    match was {
      None -> None,
      Some(x) -> match hi.base {
        Some(QuotientBase(q)) -> if q.of == x && at_least_one(facts, x) { Some(true) }
        else { None },
        Some(RemainderBase(r)) -> if r.by == x && at_least_one(facts, x) { Some(true) }
        else { None },
        _ -> None,
      },
    }
  }

fn at_least_one(facts: List<Fact>, x: Base) -> Bool =
  facts.fold(false, |found: Bool, f: Fact|
    found
      || (f.lo.base == None && f.hi.base == Some(x)
      && (match checked_sub(f.lo.k, f.hi.k) {
        Some(d) -> d >= (if f.strict { 0 } else { 1 }),
        None -> false,
      })))

fn bounded(facts: List<Fact>, hi: Option<Base>, lo: Option<Base>) -> Bool =
  facts.fold(false, |found: Bool, f: Fact| found || (f.hi.base == hi && f.lo.base == lo))

fn size_relation(t: Term, p: Place, ty: Option<Type>) -> Option<Bool> =
  match ty { Some(x) -> typed_relation(t, p, x), None -> place_relation(t, p) }

fn typed_relation(t: Term, p: Place, ty: Type) -> Option<Bool> =
  match t {
    RecordTerm(r) -> match record_fields(ty) {
      Some(fs) -> record_relation(r.base, r.fields, fs, p),
      None -> None,
    },
    _ -> place_relation(t, p),
  }

fn place_relation(t: Term, p: Place) -> Option<Bool> =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(q)) -> if l.k != 0 { None }
      else if q == p { Some(false) }
      else if within(q, p) { Some(true) }
      else { None },
      _ -> None,
    },
    Below(q) -> if q == p || within(q, p) { Some(true) } else { None },
    Inside(q) -> if q == p || within(q, p) { Some(true) } else { None },
    NoParts -> Some(false),
    Wrapped(x) -> match x {
      Exactly(l) -> match l.base {
        Some(PlaceBase(q)) -> if l.k == 0 && within(q, p) { Some(false) } else { None },
        _ -> None,
      },
      NoParts -> Some(false),
      _ -> match part_place(x) {
        Some(q) -> if q == p { Some(false) } else if within(q, p) { Some(true) } else { None },
        None -> None,
      },
    },
    _ -> None,
  }

fn record_relation(
  base: Option<Term>,
  written: List<{ name: Bytes, term: Term }>,
  fs: List<Field>,
  p: Place,
) -> Option<Bool> =
  match fs {
    [] -> Some(false),
    [f, ..rest] -> {
      let value = match field_term(written, f.name) {
        Some(x) -> x,
        None -> match base { Some(b) -> project(b, f.name), None -> UnknownTerm },
      };
      let here = match typed_relation(value, { ..p, path: p.path.push(f.name) }, f.ty) {
        Some(s) -> Some(s),
        None -> if atomic(f.ty) { Some(false) } else { None },
      };
      match here {
        None -> None,
        Some(s) -> match record_relation(base, written, rest, p) {
          None -> None,
          Some(more) -> Some(s || more),
        },
      }
    },
  }

fn within(q: Place, p: Place) -> Bool =
  q.param == p.param && q.path.len() > p.path.len() && prefix(p.path, q.path)

fn prefix(a: List<Bytes>, b: List<Bytes>) -> Bool =
  match a {
    [] -> true,
    [x, ..rest] -> match b { [y, ..more] -> x == y && prefix(rest, more), [] -> false },
  }

fn field_term(fs: List<{ name: Bytes, term: Term }>, name: Bytes) -> Option<Term> =
  fs.fold(None, |found: Option<Term>, f: { name: Bytes, term: Term }|
    match found { Some(_) -> found, None -> if f.name == name { Some(f.term) } else { None } })

fn atomic(t: Type) -> Bool =
  match t {
    NamedType(c) ->
      c.args.len() == 0
        && (is_integer_name(c.name)
        || [
          bool_name(),
          string_name(),
          bytes_name(),
          float_name(),
          decimal_name(),
          char_name(),
          unit_name(),
        ].contains(
          c.name,
        )),
    FunctionType(_) -> true,
    RecordType(fs) -> fs.len() == 0,
    NominalType(n) -> n.fields.len() == 0,
    VariableType(_) -> false,
  }

fn place_type(g: Group, member: Int, p: Place) -> Option<Type> / {abort.raise} =
  match g.params.get(member).at(p.param) {
    None -> None,
    Some(t) ->
      p.path.fold(Some(t), |acc: Option<Type>, f: Bytes|
        match acc {
          Some(t) -> match record_fields(t) { Some(fs) -> field_type(fs, f), None -> None },
          None -> None,
        }),
  }

fn field_type(fs: List<Field>, name: Bytes) -> Option<Type> =
  match fs {
    [] -> None,
    [f, ..rest] -> if f.name == name { Some(f.ty) } else { field_type(rest, name) },
  }

fn integer_place(g: Group, member: Int, p: Place) -> Bool / {abort.raise} =
  match place_type(g, member, p) {
    Some(NamedType(c)) -> c.args.len() == 0 && is_integer_name(c.name),
    _ -> false,
  }

fn holds_list(g: Group, member: Int, p: Place) -> Bool / {abort.raise} =
  match place_type(g, member, p) {
    Some(t) -> list_item(t) != None || array_element(t) != None || columns_row(t) != None,
    None -> false,
  }

fn function_param(g: Group, member: Int, i: Int) -> Bool / {abort.raise} =
  match g.params.get(member).at(i) { Some(FunctionType(_)) -> true, _ -> false }

fn project(t: Term, field: Bytes) -> Term =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(p)) -> if l.k != 0 { UnknownTerm }
      else { Exactly({ base: Some(PlaceBase({ ..p, path: p.path.push(field) })), k: 0 }) },
      _ -> UnknownTerm,
    },
    Below(p) -> Below(p),
    Inside(p) -> Below(p),
    PartsOf(p) -> Below(p),
    RecordTerm(r) -> match field_term(r.fields, field) {
      Some(x) -> x,
      None -> match r.base { Some(b) -> project(b, field), None -> UnknownTerm },
    },
    NoParts -> UnknownTerm,
    Wrapped(_) -> UnknownTerm,
    SameLength(_) -> UnknownTerm,
    UnknownTerm -> UnknownTerm,
    PartsOfAny(_) -> UnknownTerm,
  }

fn below(t: Term) -> Term =
  match t {
    Wrapped(x) -> x,
    Exactly(l) -> match l.base {
      Some(PlaceBase(p)) -> if l.k == 0 { Below(p) } else { UnknownTerm },
      _ -> UnknownTerm,
    },
    Below(p) -> Below(p),
    Inside(p) -> Below(p),
    PartsOf(p) -> Below(p),
    _ -> UnknownTerm,
  }

fn tail(t: Term) -> Term =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(p)) -> if l.k == 0 { Inside(p) } else { UnknownTerm },
      _ -> UnknownTerm,
    },
    Below(p) -> Inside(p),
    Inside(p) -> Inside(p),
    PartsOf(p) -> PartsOf(p),
    _ -> UnknownTerm,
  }

fn made_of(t: Term) -> Term =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(p)) -> if l.k == 0 { PartsOf(p) } else { UnknownTerm },
      _ -> UnknownTerm,
    },
    Below(p) -> PartsOf(p),
    Inside(p) -> PartsOf(p),
    PartsOf(p) -> PartsOf(p),
    PartsOfAny(ps) -> PartsOfAny(ps),
    NoParts -> NoParts,
    _ -> UnknownTerm,
  }

fn parts(t: Term) -> Term =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(p)) -> if l.k == 0 { PartsOf(p) } else { UnknownTerm },
      _ -> UnknownTerm,
    },
    Below(p) -> PartsOf(p),
    Inside(p) -> PartsOf(p),
    PartsOf(p) -> PartsOf(p),
    PartsOfAny(ps) -> PartsOfAny(ps),
    NoParts -> NoParts,
    _ -> UnknownTerm,
  }

fn element(context: MemberContext, scope: Scope, list: Expression) -> Term / {abort.raise} =
  match list {
    CallExpression(a) -> match builtin(context, scope, a.function) {
      Some(name) -> if a.args.len() != 1 { below(term(context, scope, list)) }
      else if name == b"Map::keys" || name == b"Map::values" {
        below(term(context, scope, a.args.get(0)))
      } else if name == b"Map::entries" {
        match term(context, scope, a.args.get(0)) { Below(p) -> Below(p), other -> parts(other) }
      } else { below(term(context, scope, list)) },
      None -> below(term(context, scope, list)),
    },
    _ -> below(term(context, scope, list)),
  }

fn parts_of(ts: List<Term>) -> Term =
  if ts.len() == 0 { NoParts } else {
    let widest = ts.fold(None, |acc: Option<Place>, t: Term|
      match part_place(t) {
        Some(p) -> match acc {
          Some(q) -> if within(q, p) { Some(p) } else { acc },
          None -> Some(p),
        },
        None -> acc,
      });
    match widest {
      Some(p) -> if ts.fold(true, |ok: Bool, x: Term| ok && part_of(x, p)) { PartsOf(p) }
      else { UnknownTerm },
      None -> UnknownTerm,
    }
  }

fn with_part(xs: Term, x: Term) -> Term =
  if xs == NoParts { parts_of([x]) } else {
    match parts(xs) {
      PartsOf(p) -> if part_of(x, p) { PartsOf(p) } else {
        match part_place(x) {
          Some(q) -> if within(p, q) { PartsOf(q) }
          else if q.param != p.param { parts_of_places([p, q]) }
          else { UnknownTerm },
          None -> UnknownTerm,
        }
      },
      PartsOfAny(ps) -> match part_place(x) {
        Some(q) -> parts_of_places(ps.push(q)),
        None -> UnknownTerm,
      },
      _ -> UnknownTerm,
    }
  }

fn parts_of_places(places: List<Place>) -> Term = {
  let widest = places.fold([], |acc: List<Place>, p: Place|
    match acc.find(|q: Place| q.param == p.param) {
      Some(q) ->
        acc.map(|r: Place|
          if r.param == p.param { { param: p.param, path: common_prefix(q.path, p.path) } }
          else { r }),
      None -> acc.push(p),
    });
  match widest {
    [] -> NoParts,
    [one] -> PartsOf(one),
    _ -> PartsOfAny(widest.sort_by_key(|q: Place| q.param)),
  }
}

fn iterated_result(
  context: MemberContext,
  scope: Scope,
  it: CallbackUse,
  args: List<Expression>,
) -> Term / {abort.raise} =
  match it.result {
    Mapped -> match callback_lambda(context, scope, it, args, UnknownTerm) {
      Some(inside) -> match result_term(context, inside.scope, inside.body) {
        Some(t) -> parts_of([t]),
        None -> UnknownTerm,
      },
      None -> UnknownTerm,
    },
    Filtered -> match iterated_argument(it, args) {
      Some(xs) -> parts(term(context, scope, xs)),
      None -> UnknownTerm,
    },
    Folded -> fold_result(context, scope, it, args),
    _ -> UnknownTerm,
  }

fn iterated_argument(it: CallbackUse, args: List<Expression>) -> Option<Expression> =
  match it.over.at(0) { Some(k) -> args.at(k), None -> None }

fn callback_lambda(
  context: MemberContext,
  scope: Scope,
  it: CallbackUse,
  args: List<Expression>,
  threaded: Term,
) -> Option<{ scope: Scope, body: Expression }> / {abort.raise} =
  match args.at(it.callback) {
    Some(LambdaExpression(l)) -> if l.params.len() != it.params.len() { None } else {
      let element = match iterated_argument(it, args) {
        Some(xs) -> element(context, scope, xs),
        None -> UnknownTerm,
      };
      Some({
        scope: range(0, l.params.len()).fold(scope, |s: Scope, j: Int|
          bound(s, l.params.get(j).name, match it.params.get(j) {
            Element -> element,
            Accumulator(_) -> threaded,
            _ -> UnknownTerm,
          })),
        body: l.body,
      })
    },
    _ -> None,
  }

fn fold_result(
  context: MemberContext,
  scope: Scope,
  it: CallbackUse,
  args: List<Expression>,
) -> Term / {abort.raise} =
  match it.params.fold(None, |found: Option<Int>, h: CallbackArgument|
      match h { Accumulator(k) -> Some(k), _ -> found }) {
    None -> UnknownTerm,
    Some(k) -> match args.at(k) {
      None -> UnknownTerm,
      Some(init) -> {
        let round = |r: Term|
          match callback_lambda(context, scope, it, args, r) {
            Some(inside) -> match result_term(context, inside.scope, inside.body) {
              Some(t) -> join(r, t),
              None -> r,
            },
            None -> UnknownTerm,
          };
        let once = round(term(context, scope, init));
        if round(once) == once { once } else { UnknownTerm }
      },
    },
  }

fn part_of(t: Term, p: Place) -> Bool =
  match t {
    Exactly(l) -> match l.base { Some(PlaceBase(q)) -> l.k == 0 && within(q, p), _ -> false },
    _ -> match part_place(t) { Some(q) -> q == p || within(q, p), None -> false },
  }

fn part_place(t: Term) -> Option<Place> =
  match t { Below(p) -> Some(p), Inside(p) -> Some(p), _ -> None }

fn binder_of(context: MemberContext, q: QName) -> Option<Int> =
  match q.module {
    Some(_) -> None,
    None -> match context.group.binders.at(context.current) {
      Some(binders) -> binders.get(q.name.span.site),
      None -> None,
    },
  }

fn term(context: MemberContext, scope: Scope, e: Expression) -> Term / {abort.raise} =
  match e {
    LiteralExpression(l) -> match l.literal {
      LiteralInt(k) -> Exactly({ base: None, k: k }),
      LiteralFixed(_, k) -> if k >= 0 { Exactly({ base: None, k: k }) } else { UnknownTerm },
      LiteralWide(_, hi, lo) -> if hi == 0 && lo >= 0 { Exactly({ base: None, k: lo }) }
      else { UnknownTerm },
      LiteralInvalid -> UnknownTerm,
      _ -> NoParts,
    },
    NameExpression(v) -> match local_of(context, scope, v.name) {
      Some(KnownTerm(t)) -> t,
      Some(FunctionParam(i)) -> Exactly({ base: Some(PlaceBase({ param: i, path: [] })), k: 0 }),
      Some(LetLambda(_)) -> UnknownTerm,
      None -> match callee_of(context, scope, v.name) {
        ConstructorCallee -> NoParts,
        _ -> UnknownTerm,
      },
    },
    FieldExpression(f) -> project(term(context, scope, f.base), f.field.name),
    BinaryExpression(b) -> if b.op == b"add" {
      offset(context, term(context, scope, b.lhs), term(context, scope, b.rhs))
    } else if b.op == b"sub" {
      match term(context, scope, b.rhs) {
        Exactly(r) -> match r.base {
          None -> match checked_neg(r.k) {
            Some(k) -> shifted(context, term(context, scope, b.lhs), k),
            None -> UnknownTerm,
          },
          Some(_) -> UnknownTerm,
        },
        _ -> UnknownTerm,
      }
    } else if b.op == b"div" {
      quotient(context, term(context, scope, b.lhs), term(context, scope, b.rhs), b.op)
    } else if b.op == b"shr" || b.op == b"ushr" {
      match term(context, scope, b.rhs) {
        Exactly(r) -> if r.base == None && r.k >= 1 && r.k <= 62 {
          quotient(
            context,
            term(context, scope, b.lhs),
            Exactly({ base: None, k: pow(2, r.k) }),
            b.op,
          )
        } else { UnknownTerm },
        _ -> UnknownTerm,
      }
    } else if b.op == b"rem" { remainder(context, term(context, scope, b.rhs)) }
    else { UnknownTerm },
    RecordExpression(r) ->
      RecordTerm({ base: None, fields: field_terms(context, scope, r.fields) }),
    ListExpression(l) -> parts_of(l.items.map(|x: Expression| term(context, scope, x))),
    RecordUpdateExpression(r) ->
      RecordTerm({
        base: Some(term(context, scope, r.base)),
        fields: field_terms(context, scope, r.fields),
      }),
    CallExpression(a) -> applied_term(context, scope, a.function, a.args, a.named),
    IfExpression(i) -> match branches_of_if(context, scope, i) {
      Some(t) -> t,
      None -> UnknownTerm,
    },
    MatchExpression(m) -> match branches_of_match(context, scope, m) {
      Some(t) -> t,
      None -> UnknownTerm,
    },
    BlockExpression(b) -> {
      let r = block_scope(context, scope, b.statements);
      match b.tail {
        None -> UnknownTerm,
        Some(t) -> match joined(r.falls, Some(term(context, r.s, t))) {
          Some(x) -> x,
          None -> UnknownTerm,
        },
      }
    },
    _ -> UnknownTerm,
  }

fn block_scope(
  context: MemberContext,
  scope: Scope,
  statements: List<Statement>,
) -> { s: Scope, falls: Option<Term> } / {abort.raise} =
  statements.fold(
    { s: scope, falls: None },
    |acc: { s: Scope, falls: Option<Term> }, x: Statement|
      {
        s: statement_scope(context, acc.s, x),
        falls: match x {
          LetElseStatement(l) -> joined(acc.falls, result_term(context, acc.s, l.fallback)),
          _ -> acc.falls,
        },
      },
  )

fn field_terms(
  context: MemberContext,
  scope: Scope,
  fs: List<RecordLiteralField>,
) -> List<{ name: Bytes, term: Term }> / {abort.raise} =
  fs.map(|field: RecordLiteralField|
    { name: field.name.name, term: term(context, scope, field.value) })

fn offset(context: MemberContext, a: Term, b: Term) -> Term / {abort.raise} =
  match b {
    Exactly(r) -> match r.base {
      None -> shifted(context, a, r.k),
      Some(_) -> match a {
        Exactly(l) -> match l.base { None -> shifted(context, b, l.k), Some(_) -> UnknownTerm },
        _ -> UnknownTerm,
      },
    },
    _ -> UnknownTerm,
  }

fn shifted(context: MemberContext, t: Term, k: Int) -> Term / {abort.raise} =
  match t {
    Exactly(l) -> if !integer(context, l) { UnknownTerm }
    else { match checked_add(l.k, k) { Some(n) -> Exactly({ ..l, k: n }), None -> UnknownTerm } },
    _ -> UnknownTerm,
  }

fn quotient(context: MemberContext, a: Term, b: Term, op: Bytes) -> Term / {abort.raise} =
  match a {
    Exactly(l) -> match l.base {
      Some(x) -> if l.k != 0 || !integer(context, l) { UnknownTerm } else {
        match b {
          Exactly(r) -> if r.base == None && r.k >= 2 {
            Exactly({ base: Some(QuotientBase({ of: x, by: r.k, op: op })), k: 0 })
          } else { UnknownTerm },
          _ -> UnknownTerm,
        }
      },
      None -> UnknownTerm,
    },
    _ -> UnknownTerm,
  }

fn remainder(context: MemberContext, b: Term) -> Term / {abort.raise} =
  match b {
    Exactly(l) -> match l.base {
      Some(x) -> if l.k != 0 || !integer(context, l) { UnknownTerm }
      else { Exactly({ base: Some(RemainderBase({ by: x })), k: 0 }) },
      None -> UnknownTerm,
    },
    _ -> UnknownTerm,
  }

fn integer(context: MemberContext, l: Linear) -> Bool / {abort.raise} =
  match l.base { None -> true, Some(x) -> integer_base(context, x) }

fn integer_base(context: MemberContext, b: Base) -> Bool / {abort.raise} =
  match b {
    PlaceBase(p) -> integer_place(context.group, context.current, p),
    LengthBase(_) -> true,
    QuotientBase(q) -> integer_base(context, q.of),
    RemainderBase(r) -> integer_base(context, r.by),
  }

fn length_builtin(name: Bytes) -> Bool =
  name == b"List::len" || name == b"Bytes::len" || name == b"String::len" || name == b"Map::len"
    || name == b"Array::len"

fn applied_term(
  context: MemberContext,
  scope: Scope,
  function: Expression,
  args: List<Expression>,
  named: List<NamedArg>,
) -> Term / {abort.raise} =
  match function {
    NameExpression(v) -> match callee_of(context, scope, v.name) {
      BuiltinCallee(name) -> if args.len() == 0 { UnknownTerm }
      else if length_builtin(name) && args.len() == 1 {
        match term(context, scope, args.get(0)) {
          Exactly(l) -> match l.base {
            Some(PlaceBase(p)) -> if l.k == 0 {
              Exactly({ base: Some(LengthBase({ name: name, of: p })), k: 0 })
            } else { UnknownTerm },
            _ -> UnknownTerm,
          },
          _ -> UnknownTerm,
        }
      } else if name == b"List::at" || name == b"Map::get" {
        parts(term(context, scope, args.get(0)))
      } else if name == b"List::push" && args.len() == 2 {
        with_part(term(context, scope, args.get(0)), term(context, scope, args.get(1)))
      } else if name == b"List::set" && args.len() == 3 {
        let xs = term(context, scope, args.get(0));
        match with_part(xs, term(context, scope, args.get(2))) {
          UnknownTerm -> same_length(xs),
          t -> t,
        }
      } else if name == b"Array::set" && args.len() == 3 {
        same_length(term(context, scope, args.get(0)))
      } else {
        match prelude_callback_use(name) {
          Some(it) -> iterated_result(context, scope, it, args),
          None -> UnknownTerm,
        }
      },
      ConstructorCallee -> if args.len() == 1 { Wrapped(term(context, scope, args.get(0))) }
      else { parts_of(args.map(|x: Expression| term(context, scope, x))) },
      DefinedCallee(n) -> match callback_use(n) {
        Some(it) -> iterated_result(context, scope, it, args),
        None -> match context.group.summary_of(n) {
          Some(sum) ->
            term_at_call(
              context,
              sum.result,
              actual_arguments(context, scope, sum.names, args, named),
            ),
          None -> UnknownTerm,
        },
      },
      GroupMember(t) -> match context.results.at(t) {
        Some(Some(r)) -> term_at_call(context, r, arguments(context, scope, t, args, named)),
        _ -> UnknownTerm,
      },
      _ -> UnknownTerm,
    },
    _ -> UnknownTerm,
  }

fn term_at_call(context: MemberContext, t: Term, args: List<Term>) -> Term / {abort.raise} =
  match t {
    Exactly(l) -> match l.base {
      None -> t,
      Some(b) -> match base_at(args, b) {
        Some(x) -> if l.k == 0 { x } else { shifted(context, x, l.k) },
        None -> UnknownTerm,
      },
    },
    Below(p) -> below(along(actual(args, p.param), p.path)),
    Inside(p) -> tail(along(actual(args, p.param), p.path)),
    PartsOf(p) -> made_of(along(actual(args, p.param), p.path)),
    RecordTerm(r) ->
      RecordTerm({
        base: match r.base { Some(b) -> Some(term_at_call(context, b, args)), None -> None },
        fields: r.fields.map(|f: { name: Bytes, term: Term }|
          { name: f.name, term: term_at_call(context, f.term, args) }),
      }),
    NoParts -> NoParts,
    Wrapped(x) -> Wrapped(term_at_call(context, x, args)),
    SameLength(p) -> same_length(along(actual(args, p.param), p.path)),
    UnknownTerm -> UnknownTerm,
    PartsOfAny(ps) ->
      ps.fold(NoParts, |acc: Term, p: Place|
        join(acc, made_of(along(actual(args, p.param), p.path)))),
  }

fn same_length(t: Term) -> Term =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(p)) -> if l.k == 0 { SameLength(p) } else { UnknownTerm },
      _ -> UnknownTerm,
    },
    SameLength(p) -> SameLength(p),
    _ -> UnknownTerm,
  }

fn linear(context: MemberContext, scope: Scope, e: Expression) -> Option<Linear> / {abort.raise} =
  match term(context, scope, e) {
    Exactly(l) -> if integer(context, l) { Some(l) } else { None },
    _ -> None,
  }

fn result_term(
  context: MemberContext,
  scope: Scope,
  e: Expression,
) -> Option<Term> / {abort.raise} =
  match e {
    IfExpression(i) -> branches_of_if(context, scope, i),
    MatchExpression(m) -> branches_of_match(context, scope, m),
    BlockExpression(b) -> {
      let r = block_scope(context, scope, b.statements);
      joined(r.falls, match b.tail {
        None -> Some(UnknownTerm),
        Some(t) -> result_term(context, r.s, t),
      })
    },
    CallExpression(a) -> match a.function {
      NameExpression(v) -> match callee_of(context, scope, v.name) {
        BuiltinCallee(name) -> if name == b"panic" { None } else { Some(term(context, scope, e)) },
        GroupMember(t) -> match context.results.at(t) {
          Some(None) -> None,
          _ -> Some(term(context, scope, e)),
        },
        _ -> Some(term(context, scope, e)),
      },
      _ -> Some(term(context, scope, e)),
    },
    _ -> Some(term(context, scope, e)),
  }

fn branches_of_if(
  context: MemberContext,
  scope: Scope,
  i: { span: Span, cond: Expression, then_branch: Expression, else_branch: Expression },
) -> Option<Term> / {abort.raise} =
  joined(
    result_term(context, assume(context, scope, i.cond, true), i.then_branch),
    result_term(context, assume(context, scope, i.cond, false), i.else_branch),
  )

fn branches_of_match(
  context: MemberContext,
  scope: Scope,
  m: { span: Span, scrutinee: Expression, arms: List<MatchArm> },
) -> Option<Term> / {abort.raise} = {
  let t = term(context, scope, m.scrutinee);
  m.arms.fold(None, |acc: Option<Term>, arm: MatchArm| {
    let inside = bind(scope, arm.pattern, t);
    joined(
      acc,
      result_term(
        context,
        match arm.guard { Some(g) -> assume(context, inside, g, true), None -> inside },
        arm.body,
      ),
    )
  })
}

fn joined(a: Option<Term>, b: Option<Term>) -> Option<Term> =
  match a { None -> b, Some(x) -> match b { None -> a, Some(y) -> Some(join(x, y)) } }

fn join(a: Term, b: Term) -> Term = joined_within(a, b, join_depth())

fn join_depth() -> Int = 8

fn joined_within(a: Term, b: Term, budget: Int) -> Term =
  if a == b { a }
  else if budget <= 0 { UnknownTerm } else {
    match a {
      Wrapped(x) -> match b {
        Wrapped(y) -> Wrapped(joined_within(x, y, budget - 1)),
        NoParts -> a,
        _ -> UnknownTerm,
      },
      RecordTerm(r) -> match b {
        RecordTerm(q) -> record_join(r, q, budget - 1),
        _ -> match r.base {
          Some(base) -> if base == b { record_join(r, { base: Some(b), fields: [] }, budget - 1) }
          else { UnknownTerm },
          None -> UnknownTerm,
        },
      },
      _ -> match b {
        Wrapped(_) -> if a == NoParts { b } else { UnknownTerm },
        RecordTerm(q) -> match q.base {
          Some(base) -> if base == a { record_join({ base: Some(a), fields: [] }, q, budget - 1) }
          else { UnknownTerm },
          None -> UnknownTerm,
        },
        _ -> joined_parts(a, b),
      },
    }
  }

fn record_join(
  a: { base: Option<Term>, fields: List<{ name: Bytes, term: Term }> },
  b: { base: Option<Term>, fields: List<{ name: Bytes, term: Term }> },
  budget: Int,
) -> Term =
  if a.base != b.base { UnknownTerm } else {
    let named = b.fields.fold(
      a.fields.map(|f: { name: Bytes, term: Term }| f.name),
      |acc: List<Bytes>, f: { name: Bytes, term: Term }|
        if acc.contains(f.name) { acc } else { acc.push(f.name) },
    );
    RecordTerm({
      base: a.base,
      fields: named.map(|n: Bytes|
        {
          name: n,
          term: match record_field(a, n) {
            Some(x) -> match record_field(b, n) {
              Some(y) -> joined_within(x, y, budget),
              None -> UnknownTerm,
            },
            None -> UnknownTerm,
          },
        }),
    })
  }

fn record_field(
  r: { base: Option<Term>, fields: List<{ name: Bytes, term: Term }> },
  name: Bytes,
) -> Option<Term> =
  match field_term(r.fields, name) {
    Some(t) -> Some(t),
    None -> match r.base { Some(b) -> Some(project(b, name)), None -> None },
  }

fn joined_parts(a: Term, b: Term) -> Term =
  if a == NoParts { widened(b) }
  else if b == NoParts { widened(a) } else {
    match place_of(a) {
      Some(p) -> match place_of(b) {
        Some(q) -> if p.param != q.param { parts_of_places([p, q]) } else {
          let c = { param: p.param, path: common_prefix(p.path, q.path) };
          if !(proper_part(a, c) && proper_part(b, c)) { PartsOf(c) }
          else if below_kind(a) && below_kind(b) { Below(c) }
          else { Inside(c) }
        },
        None -> match b { PartsOfAny(qs) -> parts_of_places(qs.push(p)), _ -> UnknownTerm },
      },
      None -> match a {
        PartsOfAny(ps) -> match b {
          PartsOfAny(qs) -> parts_of_places(ps.concat(qs)),
          _ -> match place_of(b) { Some(q) -> parts_of_places(ps.push(q)), None -> UnknownTerm },
        },
        _ -> UnknownTerm,
      },
    }
  }

fn common_prefix(a: List<Bytes>, b: List<Bytes>) -> List<Bytes> =
  range(0, a.len()).fold(
    { same: true, out: [] },
    |acc: { same: Bool, out: List<Bytes> }, i: Int|
      if !acc.same { acc } else {
        match a.at(i) {
          None -> acc,
          Some(x) -> if b.at(i) == Some(x) { { same: true, out: acc.out.push(x) } }
          else { { same: false, out: acc.out } },
        }
      },
  ).out

fn proper_part(t: Term, c: Place) -> Bool =
  match t {
    Exactly(l) -> match l.base { Some(PlaceBase(q)) -> l.k == 0 && within(q, c), _ -> false },
    _ -> match part_place(t) { Some(q) -> q == c || within(q, c), None -> false },
  }

fn below_kind(t: Term) -> Bool = match t { Below(_) -> true, Exactly(_) -> true, _ -> false }

fn widened(t: Term) -> Term =
  match t {
    PartsOfAny(_) -> t,
    _ -> match place_of(t) { Some(p) -> PartsOf(p), None -> UnknownTerm },
  }

fn place_of(t: Term) -> Option<Place> =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(p)) -> if l.k == 0 { Some(p) } else { None },
      _ -> None,
    },
    Below(p) -> Some(p),
    Inside(p) -> Some(p),
    PartsOf(p) -> Some(p),
    _ -> None,
  }

fn entry_scope(context: MemberContext, definition: FnDefinition) -> Scope / {abort.raise} =
  {
    locals: range(0, definition.params.len()).fold(Map::new(), |m: Map<Int, Local>, i: Int|
      m.insert(
        definition.params.get(i).name.span.site,
        if function_param(context.group, context.current, i) { FunctionParam(i) }
        else { KnownTerm(Exactly({ base: Some(PlaceBase({ param: i, path: [] })), k: 0 })) },
      )),
    facts: [],
  }

fn bound(scope: Scope, name: Identifier, t: Term) -> Scope = known(scope, name.span.site, t)

fn known(scope: Scope, binder: Int, t: Term) -> Scope =
  { ..scope, locals: scope.locals.insert(binder, KnownTerm(t)) }

fn unknown_params(s: Scope, ps: List<Param>) -> Scope =
  ps.fold(s, |sc: Scope, p: Param| bound(sc, p.name, UnknownTerm))

fn bind(s: Scope, p: Pattern, t: Term) -> Scope =
  match p {
    PatternWildcard(_) -> s,
    PatternVariable(v) -> bound(s, v.name, t),
    PatternLiteral(_) -> s,
    PatternRange(_) -> s,
    PatternConstructor(k) -> k.args.fold(s, |sc: Scope, x: Pattern| bind(sc, x, below(t))),
    PatternRecord(r) ->
      r.fields.fold(s, |sc: Scope, f: { name: Identifier, pattern: Pattern }|
        bind(sc, f.pattern, project(t, f.name.name))),
    PatternList(l) -> {
      let items = l.items.fold(s, |sc: Scope, x: Pattern| bind(sc, x, below(t)));
      match l.rest {
        Some(r) -> bind(items, r, if l.items.len() > 0 { tail(t) } else { t }),
        None -> items,
      }
    },
    PatternOr(o) -> match o.alternatives {
      [] -> s,
      [first, ..others] -> {
        let one = bind(s, first, t);
        let names = binder_names(first);
        others.fold(one, |sc: Scope, alt: Pattern| {
          let other = bind(s, alt, t);
          let theirs = binder_names(alt);
          names.fold(sc, |acc: Scope, n: Identifier|
            match theirs.find(|m: Identifier| m.name == n.name) {
              Some(m) -> if acc.locals.get(n.span.site) == other.locals.get(m.span.site) { acc }
              else { bound(acc, n, UnknownTerm) },
              None -> bound(acc, n, UnknownTerm),
            })
        })
      },
    },
    PatternInvalid(_) -> s,
  }

fn statement_scope(context: MemberContext, scope: Scope, x: Statement) -> Scope / {abort.raise} =
  match x {
    LetStatement(l) -> match l.pattern {
      PatternVariable(v) -> match l.value {
        LambdaExpression(f) ->
          {
            ..scope,
            locals: scope.locals.insert(
              v.name.span.site,
              LetLambda({ params: f.params, body: f.body, locals: scope.locals }),
            ),
          },
        _ -> bind(scope, l.pattern, term(context, scope, l.value)),
      },
      _ -> bind(scope, l.pattern, term(context, scope, l.value)),
    },
    LetElseStatement(l) -> bind(scope, l.pattern, term(context, scope, l.value)),
    ExpressionStatement(_) -> scope,
    AssignmentStatement(a) -> match binder_of(context, bare(a.name)) {
      Some(b) -> known(scope, b, UnknownTerm),
      None -> scope,
    },
  }

fn assume(
  context: MemberContext,
  scope: Scope,
  e: Expression,
  truth: Bool,
) -> Scope / {abort.raise} =
  match e {
    UnaryExpression(u) -> if u.op == b"not" { assume(context, scope, u.operand, !truth) }
    else { scope },
    BinaryExpression(b) -> if b.op == b"and" {
      if truth { assume(context, assume(context, scope, b.lhs, true), b.rhs, true) } else { scope }
    } else if b.op == b"or" {
      if truth { scope }
      else { assume(context, assume(context, scope, b.lhs, false), b.rhs, false) }
    } else {
      match linear(context, scope, b.lhs) {
        None -> scope,
        Some(l) -> match linear(context, scope, b.rhs) {
          None -> scope,
          Some(r) ->
            { ..scope, facts: append_facts(scope.facts, comparison_facts(b.op, l, r, truth)) },
        },
      }
    },
    BlockExpression(b) -> if b.statements.len() > 0 { scope }
    else { match b.tail { Some(t) -> assume(context, scope, t, truth), None -> scope } },
    _ -> scope,
  }

fn pattern_facts(
  context: MemberContext,
  scope: Scope,
  scrutinee: Expression,
  p: Pattern,
) -> Scope / {abort.raise} =
  match p {
    PatternLiteral(l) -> match l.literal {
      LiteralBool(b) -> assume(context, scope, scrutinee, b),
      _ -> scope,
    },
    PatternConstructor(k) -> if k.name.name.name != some_constructor() { scope } else {
      match scrutinee {
        CallExpression(a) -> match builtin(context, scope, a.function) {
          Some(name) -> if (name != b"List::at" && name != b"Array::at") || a.args.len() != 2 {
            scope
          } else {
            let length = if name == b"List::at" { b"List::len" } else { b"Array::len" };
            match term(context, scope, a.args.get(0)) {
              Exactly(l) -> match l.base {
                Some(PlaceBase(xs)) -> if l.k != 0 { scope } else {
                  match linear(context, scope, a.args.get(1)) {
                    Some(i) ->
                      {
                        ..scope,
                        facts: scope.facts.push({
                          lo: i,
                          hi: { base: Some(LengthBase({ name: length, of: xs })), k: 0 },
                          strict: true,
                        }),
                      },
                    None -> scope,
                  }
                },
                _ -> scope,
              },
              _ -> scope,
            }
          },
          None -> scope,
        },
        _ -> scope,
      }
    },
    _ -> scope,
  }

fn new_facts(before: List<Fact>, after: List<Fact>) -> List<Fact> / {abort.raise} =
  range(before.len(), after.len()).map(|i: Int| after.get(i))

fn irrefutable(p: Pattern) -> Bool =
  match p {
    PatternWildcard(_) -> true,
    PatternVariable(_) -> true,
    PatternRecord(r) ->
      r.fields.fold(true, |ok: Bool, f: { name: Identifier, pattern: Pattern }|
        ok && irrefutable(f.pattern)),
    _ -> false,
  }

fn append_facts(a: List<Fact>, b: List<Fact>) -> List<Fact> =
  b.fold(a, |acc: List<Fact>, f: Fact| acc.push(f))

fn comparison_facts(op: Bytes, l: Linear, r: Linear, truth: Bool) -> List<Fact> = {
  let lt = |a: Linear, b: Linear| { lo: a, hi: b, strict: true };
  let le = |a: Linear, b: Linear| { lo: a, hi: b, strict: false };
  if truth {
    if op == b"lt" { [lt(l, r)] }
    else if op == b"le" { [le(l, r)] }
    else if op == b"gt" { [lt(r, l)] }
    else if op == b"ge" { [le(r, l)] }
    else if op == b"eq" { [le(l, r), le(r, l)] }
    else { [] }
  } else {
    if op == b"lt" { [le(r, l)] }
    else if op == b"le" { [lt(r, l)] }
    else if op == b"gt" { [le(l, r)] }
    else if op == b"ge" { [lt(l, r)] }
    else if op == b"ne" { [le(l, r), le(r, l)] }
    else { [] }
  }
}

fn walk_definition(context: MemberContext, definition: FnDefinition) -> Findings / {abort.raise} = {
  let s = entry_scope(context, definition);
  let defaults = definition.params.fold(
    { calls: [], uses: [], outside: [], lost: None },
    |acc: Findings, p: Param| match p.default { Some(d) -> walk(context, s, acc, d), None -> acc },
  );
  walk(context, s, defaults, definition.body)
}

fn summary(context: MemberContext, x: Findings) -> Summary / {abort.raise} = {
  let definition = context.group.definitions.get(context.current);
  {
    names: definition.params.map(|p: Param| p.name.name),
    params: range(0, definition.params.len()).map(|i: Int|
      if !function_param(context.group, context.current, i) { NotCalled } else {
        let own = x.uses.fold(CalledWith([]), |acc: Passing, u: Use|
          if u.param != i { acc } else {
            match acc {
              CalledWith(cs) -> match u.args { Some(a) -> CalledWith(cs.push(a)), None -> Escapes },
              other -> other,
            }
          });
        match own {
          CalledWith(cs) ->
            recursive_calls(
              context,
              cs,
              x.calls.filter(|c: Call| c.callee == context.current && forwards_parameter(c, i)),
            ),
          other -> other,
        }
      }),
    result: match context.results.at(context.current) { Some(Some(t)) -> t, _ -> UnknownTerm },
  }
}

fn forwards_parameter(c: Call, i: Int) -> Bool =
  match c.args.at(i) {
    Some(Exactly(l)) -> l.k == 0 && l.base == Some(PlaceBase({ param: i, path: [] })),
    _ -> false,
  }

fn recursive_calls(
  context: MemberContext,
  calls: List<List<Term>>,
  selves: List<Call>,
) -> Passing / {abort.raise} =
  if selves.len() == 0 || calls.len() == 0 { CalledWith(calls) } else {
    let unknown = calls.get(0).map(|_: Term| UnknownTerm);
    iterate(
      { known: calls, k: 0 },
      max_recursion_rounds() + 2,
      |st: { known: List<List<Term>>, k: Int }| {
        let next = selves.fold(st.known, |acc: List<List<Term>>, c: Call|
          st.known.fold(acc, |grown: List<List<Term>>, call: List<Term>|
            with_call(grown, call.map(|t: Term| term_at_call(context, t, c.args)))));
        if next.len() == st.known.len() { Stop(CalledWith(st.known)) }
        else if st.k >= max_recursion_rounds() { Stop(CalledWith(with_call(next, unknown))) }
        else { Continue({ known: next, k: st.k + 1 }) }
      },
    )
  }

fn max_recursion_rounds() -> Int = 6

fn with_call(xs: List<List<Term>>, call: List<Term>) -> List<List<Term>> =
  if xs.fold(false, |found: Bool, x: List<Term>| found || x == call) { xs } else { xs.push(call) }

fn add_call(acc: Findings, x: Call) -> Findings = { ..acc, calls: acc.calls.push(x) }

fn add_use(acc: Findings, u: Use) -> Findings = { ..acc, uses: acc.uses.push(u) }

fn add_external_call(acc: Findings, name: Bytes, span: Span) -> Findings =
  { ..acc, outside: acc.outside.push({ name: name, span: span }) }

fn callee_of(context: MemberContext, scope: Scope, q: QName) -> Callee / {abort.raise} =
  match q.module {
    None -> match local_of(context, scope, q) {
      Some(_) -> OtherCallee,
      None -> context.group.resolve(context.current, q),
    },
    Some(_) -> context.group.resolve(context.current, q),
  }

fn builtin(
  context: MemberContext,
  scope: Scope,
  function: Expression,
) -> Option<Bytes> / {abort.raise} =
  match function {
    NameExpression(v) -> match callee_of(context, scope, v.name) {
      BuiltinCallee(n) -> Some(n),
      _ -> None,
    },
    _ -> None,
  }

fn local_of(context: MemberContext, s: Scope, q: QName) -> Option<Local> =
  match binder_of(context, q) { Some(b) -> s.locals.get(b), None -> None }

fn walk(
  context: MemberContext,
  s: Scope,
  acc: Findings,
  e: Expression,
) -> Findings / {abort.raise} =
  match e {
    LiteralExpression(_) -> acc,
    HoleExpression(_) -> acc,
    NameExpression(v) -> match local_of(context, s, v.name) {
      Some(FunctionParam(i)) -> add_use(acc, { param: i, args: None }),
      Some(LetLambda(f)) -> lambda_escapes(context, s, acc, f),
      Some(KnownTerm(_)) -> acc,
      None ->
        walk_implicit_calls(
          context,
          s,
          match callee_of(context, s, v.name) {
            GroupMember(t) -> add_call(acc, { callee: t, args: [], facts: [], span: v.span }),
            DefinedCallee(n) -> add_external_call(acc, n, v.span),
            _ -> acc,
          },
          v.span,
          [],
        ),
    },
    BinaryExpression(b) -> if b.op == b"and" {
      walk(context, assume(context, s, b.lhs, true), walk(context, s, acc, b.lhs), b.rhs)
    } else if b.op == b"or" {
      walk(context, assume(context, s, b.lhs, false), walk(context, s, acc, b.lhs), b.rhs)
    } else {
      walk_implicit_calls(
        context,
        s,
        walk(context, s, walk(context, s, acc, b.lhs), b.rhs),
        expression_span(e),
        [term(context, s, b.lhs), term(context, s, b.rhs)],
      )
    },
    UnaryExpression(u) ->
      walk_implicit_calls(context, s, walk(context, s, acc, u.operand), expression_span(e), [
        term(context, s, u.operand),
      ]),
    LambdaExpression(l) -> walk(context, unknown_params(s, l.params), acc, l.body),
    CallExpression(a) -> {
      let add_call = walk_implicit_calls(
        context,
        s,
        walk_call(context, s, acc, a.function, a.args, a.named, a.span),
        expression_span(a.function),
        [],
      );
      add_call
    },
    IfExpression(i) -> {
      let cond = walk(context, s, acc, i.cond);
      walk(
        context,
        assume(context, s, i.cond, false),
        walk(context, assume(context, s, i.cond, true), cond, i.then_branch),
        i.else_branch,
      )
    },
    MatchExpression(m) -> {
      let t = term(context, s, m.scrutinee);
      let walked = m.arms.fold(
        { seen: walk(context, s, acc, m.scrutinee), failed: [] },
        |a: { seen: Findings, failed: List<Fact> }, arm: MatchArm| {
          let inside = pattern_facts(
            context,
            bind({ ..s, facts: append_facts(s.facts, a.failed) }, arm.pattern, t),
            m.scrutinee,
            arm.pattern,
          );
          match arm.guard {
            None -> { seen: walk(context, inside, a.seen, arm.body), failed: a.failed },
            Some(g) ->
              {
                seen: walk(
                  context,
                  assume(context, inside, g, true),
                  walk(context, inside, a.seen, g),
                  arm.body,
                ),
                failed: if irrefutable(arm.pattern) {
                  append_facts(
                    a.failed,
                    new_facts(inside.facts, assume(context, inside, g, false).facts),
                  )
                } else { a.failed },
              },
          }
        },
      );
      walked.seen
    },
    BlockExpression(b) -> {
      let r = walk_statements(context, s, acc, b.statements);
      match b.tail { Some(t) -> walk(context, r.s, r.acc, t), None -> r.acc }
    },
    RecordExpression(r) ->
      r.fields.fold(acc, |a: Findings, f: RecordLiteralField| walk(context, s, a, f.value)),
    RecordUpdateExpression(r) ->
      r.fields.fold(walk(context, s, acc, r.base), |a: Findings, f: RecordLiteralField|
        walk(context, s, a, f.value)),
    PropagateExpression(t) -> walk(context, s, acc, t.operand),
    FieldExpression(f) -> walk(context, s, acc, f.base),
    ListExpression(l) -> l.items.fold(acc, |a: Findings, x: Expression| walk(context, s, a, x)),
    PerformExpression(p) -> p.args.fold(acc, |a: Findings, x: Expression| walk(context, s, a, x)),
    HandleExpression(h) -> {
      let inits = h.vars.fold(
        { seen: acc, scope: s },
        |a: { seen: Findings, scope: Scope }, v: HandlerVar|
          {
            seen: walk(context, a.scope, a.seen, v.init),
            scope: bound(a.scope, v.name, UnknownTerm),
          },
      );
      let body = walk(context, s, inits.seen, h.body);
      let held = h.vars.fold(s, |sc: Scope, v: HandlerVar| bound(sc, v.name, UnknownTerm));
      let returned = match h.ret {
        Some(r) -> walk(context, bound(held, r.binder, UnknownTerm), body, r.body),
        None -> body,
      };
      h.clauses.fold(returned, |a: Findings, k: HandleClause| {
        let params = k.params.fold(held, |sc: Scope, p: Identifier| bound(sc, p, UnknownTerm));
        let resumed = match k.resume { Some(r) -> bound(params, r, UnknownTerm), None -> params };
        walk(context, resumed, a, k.body)
      })
    },
    WithScopeExpression(w) ->
      walk(
        context,
        bound(s, w.binder, UnknownTerm),
        walk(context, s, walk(context, s, acc, w.acquire), w.release),
        w.body,
      ),
    SimulateExpression(x) -> walk(context, s, acc, x.body),
    ParallelExpression(p) ->
      p.branches.fold(acc, |a: Findings, x: Expression| walk(context, s, a, x)),
    TaggedLiteralExpression(t) -> {
      let held = t.holes.fold(acc, |a: Findings, h: Hole| walk(context, s, a, h.value));
      let parsed = walk_tagged_call(context, s, held, t, tagged_parser(t));
      if t.holes.len() == 0 { parsed }
      else { walk_tagged_call(context, s, parsed, t, tagged_filler(t)) }
    },
    InvalidExpression(_) -> acc,
    TryBlockExpression(t) -> walk(context, s, acc, t.body),
  }

fn walk_implicit_calls(
  context: MemberContext,
  s: Scope,
  acc: Findings,
  span: Span,
  operands: List<Term>,
) -> Findings / {abort.raise} =
  context.group.stated(context.current, span).fold(acc, |seen: Findings, callee: Callee|
    match callee {
      GroupMember(m) -> {
        let params = context.group.definitions.get(m).params;
        let calls = if params.len() == operands.len() { [operands] }
        else if params.len() == 1 && operands.len() > 0 { operands.map(|t: Term| [t]) }
        else { [params.map(|_: Param| UnknownTerm)] };
        calls.fold(seen, |a: Findings, args: List<Term>|
          add_call(a, { callee: m, args: args, facts: s.facts, span: span }))
      },
      DefinedCallee(n) -> add_external_call(seen, n, span),
      _ -> seen,
    })

fn walk_tagged_call(
  context: MemberContext,
  s: Scope,
  acc: Findings,
  t: TaggedLiteral,
  callee: QName,
) -> Findings / {abort.raise} =
  match callee_of(context, s, callee) {
    GroupMember(m) ->
      add_call(acc, {
        callee: m,
        args: context.group.definitions.get(m).params.map(|_: Param| UnknownTerm),
        facts: s.facts,
        span: t.span,
      }),
    DefinedCallee(n) -> add_external_call(acc, n, t.tag.span),
    _ -> acc,
  }

fn walk_statements(
  context: MemberContext,
  scope: Scope,
  acc: Findings,
  statements: List<Statement>,
) -> { s: Scope, acc: Findings } / {abort.raise} =
  statements.fold({ s: scope, acc: acc }, |st: { s: Scope, acc: Findings }, x: Statement|
    match x {
      LetStatement(l) -> match l.pattern {
        PatternVariable(_) -> match l.value {
          LambdaExpression(_) -> { s: statement_scope(context, st.s, x), acc: st.acc },
          _ -> { s: statement_scope(context, st.s, x), acc: walk(context, st.s, st.acc, l.value) },
        },
        _ -> { s: statement_scope(context, st.s, x), acc: walk(context, st.s, st.acc, l.value) },
      },
      LetElseStatement(l) ->
        {
          s: statement_scope(context, st.s, x),
          acc: walk(context, st.s, walk(context, st.s, st.acc, l.value), l.fallback),
        },
      ExpressionStatement(y) -> { s: st.s, acc: walk(context, st.s, st.acc, y) },
      AssignmentStatement(y) ->
        { s: statement_scope(context, st.s, x), acc: walk(context, st.s, st.acc, y.value) },
    })

fn max_inline_depth() -> Int = 8

fn walk_inlined_lambda(
  context: MemberContext,
  s: Scope,
  acc: Findings,
  f: { params: List<Param>, body: Expression, locals: Map<Int, Local> },
  args: List<Term>,
) -> Findings / {abort.raise} =
  if context.depth >= max_inline_depth() { too_deep(acc, f.body) } else {
    let inside = range(0, f.params.len()).fold(
      { locals: f.locals, facts: s.facts },
      |sc: Scope, i: Int| bound(sc, f.params.get(i).name, actual(args, i)),
    );
    walk({ ..context, depth: context.depth + 1 }, inside, acc, f.body)
  }

fn lambda_escapes(
  context: MemberContext,
  scope: Scope,
  acc: Findings,
  f: { params: List<Param>, body: Expression, locals: Map<Int, Local> },
) -> Findings / {abort.raise} =
  if context.depth >= max_inline_depth() { too_deep(acc, f.body) } else {
    walk(
      { ..context, depth: context.depth + 1 },
      unknown_params({ locals: f.locals, facts: scope.facts }, f.params),
      acc,
      f.body,
    )
  }

fn too_deep(acc: Findings, body: Expression) -> Findings =
  match acc.lost { Some(_) -> acc, None -> { ..acc, lost: Some(expression_span(body)) } }

fn walk_call(
  context: MemberContext,
  scope: Scope,
  acc: Findings,
  function: Expression,
  args: List<Expression>,
  named: List<NamedArg>,
  span: Span,
) -> Findings / {abort.raise} = {
  let walk_args = |a: Findings|
    named.fold(
      args.fold(a, |x: Findings, y: Expression| walk(context, scope, x, y)),
      |x: Findings, n: NamedArg| walk(context, scope, x, n.value),
    );
  let own_place = |i: Int, x: Expression|
    match x {
      NameExpression(w) -> match local_of(context, scope, w.name) {
        Some(FunctionParam(j)) -> j == i,
        _ -> false,
      },
      _ -> false,
    };
  let walk_recursion = |a: Findings| {
    let names = context.group.definitions.get(context.current).params.map(|p: Param| p.name.name);
    named.fold(
      range(0, args.len()).fold(a, |x: Findings, i: Int|
        if own_place(i, args.get(i)) { x } else { walk(context, scope, x, args.get(i)) }),
      |x: Findings, n: NamedArg|
        match index_of(names, n.name.name) {
          Some(i) -> if own_place(i, n.value) { x } else { walk(context, scope, x, n.value) },
          None -> walk(context, scope, x, n.value),
        },
    )
  };
  match function {
    NameExpression(v) -> match local_of(context, scope, v.name) {
      Some(LetLambda(f)) ->
        walk_inlined_lambda(
          context,
          scope,
          walk_args(acc),
          f,
          args.map(|x: Expression| term(context, scope, x)),
        ),
      Some(FunctionParam(i)) ->
        add_use(walk_args(acc), {
          param: i,
          args: Some(args.map(|x: Expression| term(context, scope, x))),
        }),
      Some(KnownTerm(_)) -> walk_args(acc),
      None -> match callee_of(context, scope, v.name) {
        GroupMember(t) ->
          add_call(if t == context.current { walk_recursion(acc) } else { walk_args(acc) }, {
            callee: t,
            args: arguments(context, scope, t, args, named),
            facts: scope.facts,
            span: span,
          }),
        BuiltinCallee(name) -> match prelude_callback_use(name) {
          Some(it) -> walk_iterating_call(context, scope, acc, args, named, it),
          None -> walk_args(acc),
        },
        DefinedCallee(n) -> match callback_use(n) {
          Some(it) ->
            walk_iterating_call(context, scope, add_external_call(acc, n, v.span), args, named, it),
          None -> match context.group.summary_of(n) {
            Some(sum) ->
              walk_summarized_call(
                context,
                scope,
                add_external_call(acc, n, v.span),
                sum,
                args,
                named,
              ),
            None -> walk_args(add_external_call(acc, n, v.span)),
          },
        },
        _ -> walk_args(acc),
      },
    },
    _ -> walk(context, scope, walk_args(acc), function),
  }
}

fn arguments(
  context: MemberContext,
  scope: Scope,
  t: Int,
  args: List<Expression>,
  named: List<NamedArg>,
) -> List<Term> / {abort.raise} =
  actual_arguments(
    context,
    scope,
    context.group.definitions.get(t).params.map(|p: Param| p.name.name),
    args,
    named,
  )

fn actual_arguments(
  context: MemberContext,
  scope: Scope,
  names: List<Bytes>,
  args: List<Expression>,
  named: List<NamedArg>,
) -> List<Term> / {abort.raise} =
  range(0, names.len()).map(|i: Int|
    match args.at(i) {
      Some(x) -> term(context, scope, x),
      None ->
        named.fold(UnknownTerm, |found: Term, n: NamedArg|
          if n.name.name == names.get(i) { term(context, scope, n.value) } else { found }),
    })

fn walk_summarized_call(
  context: MemberContext,
  scope: Scope,
  acc: Findings,
  sum: Summary,
  args: List<Expression>,
  named: List<NamedArg>,
) -> Findings / {abort.raise} = {
  let terms = actual_arguments(context, scope, sum.names, args, named);
  let at_param = |i: Int, seen: Findings, x: Expression|
    match sum.params.at(i) {
      Some(CalledWith(calls)) ->
        walk_passed_function(
          context,
          scope,
          seen,
          x,
          calls.map(|call: List<Term>| call.map(|t: Term| term_at_call(context, t, terms))),
        ),
      _ -> walk(context, scope, seen, x),
    };
  let positional = range(0, args.len()).fold(acc, |seen: Findings, i: Int|
    at_param(i, seen, args.get(i)));
  named.fold(positional, |seen: Findings, n: NamedArg|
    match index_of(sum.names, n.name.name) {
      Some(i) -> at_param(i, seen, n.value),
      None -> walk(context, scope, seen, n.value),
    })
}

fn index_of(xs: List<Bytes>, x: Bytes) -> Option<Int> / {abort.raise} =
  range(0, xs.len()).fold(None, |found: Option<Int>, i: Int|
    match found { Some(_) -> found, None -> if xs.get(i) == x { Some(i) } else { None } })

fn walk_passed_function(
  context: MemberContext,
  s: Scope,
  acc: Findings,
  x: Expression,
  calls: List<List<Term>>,
) -> Findings / {abort.raise} =
  match x {
    LambdaExpression(l) ->
      calls.fold(acc, |seen: Findings, call: List<Term>| {
        let inside = range(0, l.params.len()).fold(s, |sc: Scope, j: Int|
          bound(sc, l.params.get(j).name, actual(call, j)));
        walk(context, inside, seen, l.body)
      }),
    NameExpression(v) -> match local_of(context, s, v.name) {
      Some(LetLambda(f)) ->
        calls.fold(acc, |seen: Findings, call: List<Term>|
          walk_inlined_lambda(context, s, seen, f, call)),
      Some(FunctionParam(i)) ->
        calls.fold(acc, |seen: Findings, call: List<Term>|
          add_use(seen, { param: i, args: Some(call) })),
      Some(KnownTerm(_)) -> acc,
      None -> match callee_of(context, s, v.name) {
        GroupMember(t) ->
          calls.fold(acc, |seen: Findings, call: List<Term>|
            add_call(seen, { callee: t, args: call, facts: s.facts, span: v.span })),
        _ -> walk(context, s, acc, x),
      },
    },
    BlockExpression(b) -> {
      let r = walk_statements(context, s, acc, b.statements);
      match b.tail { Some(t) -> walk_passed_function(context, r.s, r.acc, t, calls), None -> r.acc }
    },
    IfExpression(i) ->
      walk_passed_function(
        context,
        assume(context, s, i.cond, false),
        walk_passed_function(
          context,
          assume(context, s, i.cond, true),
          walk(context, s, acc, i.cond),
          i.then_branch,
          calls,
        ),
        i.else_branch,
        calls,
      ),
    MatchExpression(m) -> {
      let t = term(context, s, m.scrutinee);
      m.arms.fold(walk(context, s, acc, m.scrutinee), |seen: Findings, arm: MatchArm| {
        let inside = bind(s, arm.pattern, t);
        match arm.guard {
          None -> walk_passed_function(context, inside, seen, arm.body, calls),
          Some(g) ->
            walk_passed_function(
              context,
              assume(context, inside, g, true),
              walk(context, inside, seen, g),
              arm.body,
              calls,
            ),
        }
      })
    },
    _ -> walk(context, s, acc, x),
  }

fn walk_iterating_call(
  context: MemberContext,
  scope: Scope,
  acc: Findings,
  args: List<Expression>,
  named: List<NamedArg>,
  it: CallbackUse,
) -> Findings / {abort.raise} = {
  let others = named.fold(acc, |seen: Findings, n: NamedArg| walk(context, scope, seen, n.value));
  let element = match iterated_argument(it, args) {
    Some(x) -> element(context, scope, x),
    None -> UnknownTerm,
  };
  let call = it.params.map(|h: CallbackArgument| match h { Element -> element, _ -> UnknownTerm });
  range(0, args.len()).fold(others, |seen: Findings, i: Int| {
    let x = args.get(i);
    if i != it.callback { walk(context, scope, seen, x) }
    else { walk_passed_function(context, scope, seen, x, [call]) }
  })
}
