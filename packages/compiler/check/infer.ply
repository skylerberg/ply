type CheckResult = { checker: Checker, ok: Bool }

pub fn check_program(
  resolved: Resolution,
  modules: List<ParsedModule>,
) -> CheckResult / {abort.raise} = check_program_with(resolved, modules, empty_cache())

pub fn check_diagnostics(
  resolved: Resolution,
  modules: List<ParsedModule>,
) -> List<Diagnostic> / {abort.raise} = {
  let out = check_program(resolved, modules);
  if has_error(out.checker.diagnostics) { dedup_diagnostics(out.checker.diagnostics) } else { [] }
}

pub type CheckOutput = {
  ok: Bool,
  diagnostics: List<Diagnostic>,
  warnings: List<Diagnostic>,
  definitions: List<DefinitionInfo>,
  tests: List<TestInfo>,
  laws: List<LawInfo>,
  effects: List<EffectInfo>,
  constructors: List<ConstructorInfo>,
  seeded: List<Bytes>,
  cached_tests: List<Bytes>,
  facts: EmitFacts,
  cached: List<CachedFacts>,
  instances: List<InstanceInfo>,
  numeric_types: List<NumericInfo>,
}

pub fn check_output_with(
  resolved: Resolution,
  modules: List<ParsedModule>,
  known: CheckCache,
) -> { checked: CheckOutput, bodies: List<CheckedBody> } / {abort.raise} = {
  let out = check_program_with(resolved, modules, known);
  let failed = has_error(out.checker.diagnostics);
  {
    checked: {
      ok: !failed,
      diagnostics: if failed { dedup_diagnostics(out.checker.diagnostics) } else { [] },
      warnings: out.checker.diagnostics.filter(|d: Diagnostic| d.code == b"W0613").concat(
        if failed { [] } else { out.checker.unperformed },
      ),
      definitions: out.checker.definitions.map(canonical_definition),
      tests: out.checker.tests,
      laws: out.checker.laws,
      effects: out.checker.effects,
      constructors: out.checker.constructors,
      seeded: out.checker.seeded,
      cached_tests: out.checker.cached_tests,
      facts: emit_facts(out.checker),
      cached: out.checker.cached,
      instances: out.checker.instances,
      numeric_types: out.checker.numeric_types,
    },
    bodies: out.checker.bodies,
  }
}

fn canonical_definition(d: DefinitionInfo) -> DefinitionInfo / {abort.raise} = {
  let c = canonical_beside(
    d.scheme,
    [d.effects, d.performed, d.scaling, d.promised_bounded].concat(
      d.spec.map(|s: SpecInfo| s.effects),
    ),
  );
  {
    ..d,
    scheme: c.scheme,
    effects: c.effect_lists.get(0),
    performed: c.effect_lists.get(1),
    scaling: c.effect_lists.get(2),
    promised_bounded: c.effect_lists.get(3),
    spec: range(0, d.spec.len()).map(|i: Int|
      { ..d.spec.get(i), effects: c.effect_lists.get(4 + i) }),
  }
}

pub fn is_pure_definition(definition_info: DefinitionInfo) -> Bool =
  without_raises(definition_info.effects).len() == 0 && definition_info.constraints.len() == 0

pub type EmitFacts = {
  pure: List<Bytes>,
  orders: List<WitnessOrder>,
  members: List<MemberSite>,
  types: TypeTable,
  bodies: List<TypedBody<Bytes>>,
}

derive bin for EmitFacts

pub type BodyFacts = { members: List<MemberSite>, types: TypeTable, bodies: List<TypedBody<Bytes>> }

derive bin for BodyFacts

pub fn no_body_facts() -> BodyFacts = { members: [], types: Map::new(), bodies: [] }

pub fn types_named(all: TypeTable, bodies: List<TypedBody<Bytes>>) -> TypeTable / {abort.raise} =
  subtable(all, bodies.fold([], |acc: List<Bytes>, b: TypedBody<Bytes>| acc.concat(keys_in(b))))

fn keys_in(b: TypedBody<Bytes>) -> List<Bytes> / {abort.raise} =
  body_retyped(b, [], {
    ty: |k: Bytes, seen: List<Bytes>| { ty: k, state: seen.push(k) },
    effects: |r: Effects| r,
    entry: |a: Effect| a,
    span: |sp: Span| sp,
  }).state

pub fn types_joined(a: TypeTable, b: TypeTable) -> TypeTable = tables_joined(a, b)

pub fn remap_fact_modules(facts: EmitFacts, moved: (Int) -> Int) -> EmitFacts =
  {
    ..facts,
    orders: facts.orders.map(|x: WitnessOrder| { ..x, module: moved(x.module) }),
    members: facts.members.map(|x: MemberSite| { ..x, module: moved(x.module) }),
    bodies: facts.bodies.map(|x: TypedBody<Bytes>| { ..x, module: moved(x.module) }),
  }

pub fn facts_filtered(
  facts: EmitFacts,
  kept: (Int, Bytes) -> Bool / {abort.raise},
) -> EmitFacts / {abort.raise} = {
  let bodies = facts.bodies.filter(|x: TypedBody<Bytes>| kept(x.module, x.owner));
  {
    ..facts,
    members: facts.members.filter(|x: MemberSite| kept(x.module, x.owner)),
    types: types_named(facts.types, bodies),
    bodies: bodies,
  }
}

pub fn facts_by_owner(facts: EmitFacts) -> Map<Bytes, BodyFacts> = {
  let into = |m: Map<Bytes, BodyFacts>, owner: Bytes, add: (BodyFacts) -> BodyFacts|
    m.insert(
      owner,
      add(match m.get(owner) { Some(f) -> f, None -> { ..no_body_facts(), types: facts.types } }),
    );
  let called = facts.members.fold(Map::new(), |m: Map<Bytes, BodyFacts>, x: MemberSite|
    into(m, x.owner, |f: BodyFacts| { ..f, members: f.members.push(x) }));
  facts.bodies.fold(called, |m: Map<Bytes, BodyFacts>, x: TypedBody<Bytes>|
    into(m, x.owner, |f: BodyFacts| { ..f, bodies: f.bodies.push(x) }))
}

fn with_owner(facts: BodyFacts, module: Int, owner: Bytes) -> BodyFacts =
  {
    members: facts.members.map(|x: MemberSite| { ..x, module: module, owner: owner }),
    types: facts.types,
    bodies: facts.bodies.map(|x: TypedBody<Bytes>| { ..x, module: module, owner: owner }),
  }

fn facts_format() -> Int = 8

type FactsHead = { value: Option<ConstantData> }

derive bin for FactsHead

pub fn whole_body_data(facts: BodyFacts) -> Option<ConstantData> =
  match facts.bodies.find(|b: TypedBody<Bytes>| b.part == WholeBody) {
    Some(b) -> data_of(b.body, facts.types),
    None -> None,
  }

pub fn encode_facts(facts: BodyFacts) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    byte_of_int(facts_format()),
    bin::encode({ value: whole_body_data(facts) }, facts_head_bin()),
    bin::encode(with_owner({ ..facts, types: Map::new() }, 0, b""), body_facts_bin()),
  ])

fn facts_head(recorded: Bytes) -> Option<bin::Taken<FactsHead>> / {abort.raise} =
  if recorded.len() == 0 || recorded.at(0) != facts_format() { None }
  else { match facts_head_bin().take(recorded, 1) { Ok(t) -> Some(t), Err(_) -> None } }

pub fn recorded_data(recorded: Bytes) -> Option<ConstantData> / {abort.raise} =
  match facts_head(recorded) { Some(t) -> t.value.value, None -> None }

pub fn decode_facts(
  recorded: Bytes,
  module: Int,
  owner: Bytes,
) -> Option<BodyFacts> / {abort.raise} =
  match facts_head(recorded) {
    None -> None,
    Some(t) -> match bin::decode(recorded.slice(t.at, recorded.len()), body_facts_bin()) {
      Ok(f) -> Some(with_owner(f, module, owner)),
      Err(_) -> None,
    },
  }

fn restore_owners(checker: Checker) -> Checker =
  {
    ..checker,
    member_sites: checker.member_sites.map(|x: MemberSite|
      match unlowered_of(x.owner) { Some(o) -> { ..x, owner: o }, None -> x }),
  }

fn emit_facts(all: Checker) -> EmitFacts / {abort.raise} = {
  let checker = restore_owners(all);
  let keyed = keyed_bodies(resolved_bodies(checker), checker.known.types);
  let bodies = grouped(keyed.bodies, |x: TypedBody<Bytes>| x.owner);
  {
    pure: checker.definitions.fold([], |acc: List<Bytes>, definition_info: DefinitionInfo|
      if is_pure_definition(definition_info) { acc.push(definition_info.name) } else { acc }),
    orders: checker.witness_orders,
    members: in_body_order(checker.member_sites, bodies),
    types: keyed.types,
    bodies: bodies,
  }
}

fn in_body_order(sites: List<MemberSite>, bodies: List<TypedBody<Bytes>>) -> List<MemberSite> = {
  let by = sites.fold(Map::new(), |acc: Map<Bytes, List<MemberSite>>, x: MemberSite|
    acc.insert(x.owner, match acc.get(x.owner) { Some(ys) -> ys.push(x), None -> [x] }));
  let listed = bodies.fold(
    { out: [], named: Map::new() },
    |acc: { out: List<MemberSite>, named: Map<Bytes, Bool> }, b: TypedBody<Bytes>|
      match by.get(b.owner) {
        Some(ys) -> if acc.named.contains(b.owner) { acc }
        else { { out: acc.out.concat(ys), named: acc.named.insert(b.owner, true) } },
        None -> acc,
      },
  );
  listed.out.concat(
    grouped(sites.filter(|x: MemberSite| !listed.named.contains(x.owner)), |x: MemberSite| x.owner),
  )
}

fn grouped<a>(xs: List<a>, owner: (a) -> Bytes) -> List<a> = {
  let g = xs.fold(
    { order: [], by: Map::new() },
    |acc: { order: List<Bytes>, by: Map<Bytes, List<a>> }, x: a| {
      let o = owner(x);
      match acc.by.get(o) {
        Some(ys) -> { ..acc, by: acc.by.insert(o, ys.push(x)) },
        None -> { order: acc.order.push(o), by: acc.by.insert(o, [x]) },
      }
    },
  );
  g.order.map(|o: Bytes| match g.by.get(o) { Some(ys) -> ys, None -> [] }).flatten()
}

fn resolved_bodies(checker: Checker) -> List<TypedBody<Type>> / {abort.raise} = {
  let sorts = law_variable_numbers(checker);
  let released = checker.release_sites.fold(
    Map::new(),
    |m: Map<Bytes, Map<Int, List<TypedRelease>>>, x: ReleaseSite| {
      let at = match m.get(x.owner) { Some(a) -> a, None -> Map::new() };
      let here = match at.get(x.at) { Some(xs) -> xs.push(x.release), None -> [x.release] };
      m.insert(x.owner, at.insert(x.at, here))
    },
  );
  checker.typed_bodies.fold([], |acc: List<TypedBody<Type>>, b: WalkedTree| {
    let owner = definition_of(checker, b.owner);
    let types = match owner {
      Some(d) -> positions(d.scheme.type_variables),
      None -> match sorts.get(b.owner) { Some(s) -> s, None -> Map::new() },
    };
    let numbering: VariableNumbering = match owner {
      Some(d) ->
        {
          effect_variables: positions(d.scheme.effect_variables),
          labels: positions(d.scheme.label_variables),
        },
      None -> { effect_variables: Map::new(), labels: Map::new() },
    };
    let ty = |t: Type| numbered(resolve(checker, t), types, checker.keep_variables);
    let effects = |r: Effects| effects_numbered(resolve_effects_in(checker, r), numbering);
    let labelled_diagnostics = |sp: Span| moved_by(sp, 0 - b.base);
    let here = match released.get(b.owner) { Some(at) -> at, None -> Map::new() };
    let witnesses = match owner {
      Some(d) ->
        d.scheme.type_variables.fold([], |acc: List<TypedParam<Type>>, v: Int|
          match checker.witnessed.get(v) {
            Some(w) ->
              acc.push({ name: witness_param_name(w.param), ty: int_type(), span: dummy_span() }),
            None -> acc,
          }),
      None -> [],
    };
    let settling = {
      ty: ty,
      witness: |t: Type|
        match resolve(checker, t) {
          VariableType(v) -> match checker.witnessed.get(v) {
            Some(w) -> Some(w.param),
            None -> None,
          },
          _ -> None,
        },
      effects: effects,
      entry: |a: Effect| renumber_effect(resolve_effect(checker.substitution, a), numbering.labels),
      read: |read: WalkedReading|
        match read {
          WalkedLocal(l) -> Some(ReadLocal(l.name)),
          WalkedConstructor(c) ->
            Some(ReadConstructor({ sum: c.sum, name: c.name, case: c.case, args: c.args.map(ty) })),
          WalkedBuiltin(f) -> match witnesses_passed(checker, f.name, f.args) {
            Some(ws) ->
              Some(
                ReadBuiltin({
                  name: f.name,
                  args: f.args.map(ty),
                  effect_arguments: f.effect_arguments.map(effects),
                  witnesses: ws,
                }),
              ),
            None -> None,
          },
          WalkedDefinition(x) -> {
            let scheme = match definition_of(checker, x.key) {
              Some(d) -> Some(d.scheme),
              None -> None,
            };
            let args = if x.args.len() > 0 { x.args }
            else { match scheme { Some(sc) -> sc.type_variables.map(VariableType), None -> [] } };
            let filled = match scheme {
              Some(sc) ->
                sc.effect_variables.map(|v: Int|
                  zip(x.quantified, x.effect_arguments).fold(
                    open_effects(v),
                    |w: Effects, p: { first: Int, second: Effects }|
                      if p.first == v { p.second } else { w },
                  )),
              None -> x.effect_arguments,
            };
            match ((
                labels_resolved(checker, x.labels, numbering.labels),
                witnesses_passed(checker, x.key, args),
              )) {
              (Some(ls), Some(ws)) ->
                Some(
                  ReadDefinition({
                    full: x.full,
                    args: args.map(ty),
                    effect_arguments: filled.map(effects),
                    labels: ls,
                    witnesses: ws,
                  }),
                ),
              _ -> None,
            }
          },
        },
      copied_fields: |base: Type, sets: List<Bytes>|
        match record_fields(base) {
          Some(fs) -> Some(fs.map(|f: Field| f.name).filter(|n: Bytes| !sets.contains(n))),
          None -> None,
        },
      span: labelled_diagnostics,
      released: |site: Int| match here.get(site) { Some(xs) -> xs, None -> [] },
    };
    match resolved(b.body, settling) {
      Some(body) ->
        acc.push({
          owner: b.owner,
          module: b.module,
          part: b.part,
          params: witnesses.concat(
            b.params.map(|p: TypedParam<Type>|
              { ..p, ty: ty(p.ty), span: labelled_diagnostics(p.span) }),
          ),
          body: body,
        }),
      None -> acc,
    }
  })
}

fn witnesses_passed(
  checker: Checker,
  full: Bytes,
  args: List<Type>,
) -> Option<List<NumericWitness>> / {abort.raise} = {
  let cs = match checker.constraints.get(full) { Some(xs) -> xs, None -> [] };
  range(0, args.len()).fold(Some([]), |acc: Option<List<NumericWitness>>, i: Int|
    match acc {
      None -> None,
      Some(ws) -> match cs.find(|c: DefinitionConstraint| c.param == i && is_predicate(c.deriver)) {
        None -> acc,
        Some(c) -> match args.at(i) {
          Some(t) -> match resolved_witness(checker, c.deriver, resolve(checker, t)) {
            Some(w) -> Some(ws.push(w)),
            None -> None,
          },
          None -> None,
        },
      },
    })
}

fn labels_resolved(
  checker: Checker,
  filled: List<Type>,
  labels: Map<Int, Int>,
) -> Option<List<FilledLabel>> / {abort.raise} =
  filled.fold(Some([]), |acc: Option<List<FilledLabel>>, label: Type|
    match acc {
      None -> None,
      Some(ls) -> {
        let t = shallow_resolve(checker.substitution, label);
        match label_of(t) {
          Some(n) -> Some(ls.push(LabelNamed(n))),
          None -> match t {
            VariableType(w) -> match labels.get(w) {
              Some(i) -> Some(ls.push(LabelParam(i))),
              None -> None,
            },
            _ -> None,
          },
        }
      },
    })

fn keyed_bodies(
  bodies: List<TypedBody<Type>>,
  table: TypeTable,
) -> { bodies: List<TypedBody<Bytes>>, types: TypeTable } / {abort.raise} = {
  let keying = {
    ty: |t: Type, s: { table: TypeTable, keyed: Map<Type, Bytes> }| {
      let h = intern_type(s.table, s.keyed, t);
      { ty: h.key, state: { table: h.table, keyed: h.keyed } }
    },
    effects: |r: Effects| r,
    entry: |a: Effect| a,
    span: |sp: Span| sp,
  };
  let out = bodies.fold(
    { bodies: [], state: { table: table, keyed: Map::new() } },
    |acc: { bodies: List<TypedBody<Bytes>>, state: { table: TypeTable, keyed: Map<Type, Bytes> } }, b: TypedBody<Type>| {
      let o = body_retyped(b, acc.state, keying);
      { bodies: acc.bodies.push(o.out), state: o.state }
    },
  );
  { bodies: out.bodies, types: out.state.table }
}

type VariableNumbering = { effect_variables: Map<Int, Int>, labels: Map<Int, Int> }

fn effects_numbered(effects: Effects, numbering: VariableNumbering) -> Effects / {abort.raise} =
  {
    listed: if !effects.listed.fold(false, |found: Bool, a: Effect|
        found || (match a.resource { ResourceVariable(_) -> true, _ -> false })) { effects.listed }
    else { effects_sorted(effects.listed.map(|a: Effect| renumber_effect(a, numbering.labels))) },
    variable: match effects.variable { None -> None, Some(v) -> numbering.effect_variables.get(v) },
  }

fn renumber_effect(entry: Effect, labels: Map<Int, Int>) -> Effect =
  match entry.resource {
    ResourceVariable(v) -> { ..entry, resource: ResourceVariable(index_in_numbering(labels, v)) },
    _ -> entry,
  }

fn index_in_numbering(numbering: Map<Int, Int>, v: Int) -> Int =
  match numbering.get(v) { Some(i) -> i, None -> 0 - 1 }

fn law_variable_numbers(checker: Checker) -> Map<Bytes, Map<Int, Int>> / {abort.raise} =
  checker.laws.fold(Map::new(), |m: Map<Bytes, Map<Int, Int>>, l: LawInfo|
    m.insert(
      law_owner(l.module, l.name),
      positions(variables_in(l.binders.map(|b: LawBinder| resolve(checker, b.ty)))),
    ))

fn intern_type(
  table: TypeTable,
  keyed: Map<Type, Bytes>,
  ty: Type,
) -> { table: TypeTable, keyed: Map<Type, Bytes>, key: Bytes } / {abort.raise} =
  match keyed.get(ty) {
    Some(key) -> { table: table, keyed: keyed, key: key },
    None -> {
      let h = insert_type(table, ty);
      { table: h.table, keyed: keyed.insert(ty, h.key), key: h.key }
    },
  }

fn numbered(ty: Type, numbering: Map<Int, Int>, kept: List<Int>) -> Type =
  if !needs_renumbering(ty) { ty } else {
    let again = |t: Type| numbered(t, numbering, kept);
    match ty {
      VariableType(v) -> match numbering.get(v) {
        Some(i) -> VariableType(i),
        None -> if kept.contains(v) { kept_type() } else { unit_type() },
      },
      NamedType(c) -> NamedType({ ..c, args: c.args.map(again) }),
      FunctionType(f) ->
        FunctionType({
          kept: [],
          once: false,
          params: f.params.map(again),
          ret: again(f.ret),
          effects: no_effects(),
        }),
      RecordType(fs) -> RecordType(fs.map(|f: Field| { ..f, ty: again(f.ty) })),
      NominalType(x) ->
        NominalType({
          ..x,
          args: x.args.map(again),
          fields: x.fields.map(|f: Field| { ..f, ty: again(f.ty) }),
        }),
    }
  }

fn needs_renumbering(ty: Type) -> Bool =
  match ty {
    VariableType(_) -> true,
    NamedType(c) -> c.args.fold(false, |found: Bool, a: Type| found || needs_renumbering(a)),
    FunctionType(f) ->
      f.effects.listed.len() > 0 || f.effects.variable != None
        || f.params.fold(false, |found: Bool, p: Type| found || needs_renumbering(p))
        || needs_renumbering(f.ret),
    RecordType(fs) -> fs.fold(false, |found: Bool, f: Field| found || needs_renumbering(f.ty)),
    NominalType(x) ->
      x.args.fold(false, |found: Bool, a: Type| found || needs_renumbering(a))
        || x.fields.fold(false, |found: Bool, f: Field| found || needs_renumbering(f.ty)),
  }

pub type ElaborationResult = {
  ends: Map<Bytes, Bool>,
  stated: Map<Bytes, Bool>,
  bodies: List<TypedBody<Type>>,
}

pub fn elaborate(
  resolved: Resolution,
  modules: List<ParsedModule>,
) -> Option<ElaborationResult> / {abort.raise} = {
  let out = check_program(resolved, modules);
  if has_error(out.checker.diagnostics) { None } else {
    Some({
      ends: terminating_definitions(out.checker.definitions),
      stated: measured_definitions(out.checker.definitions),
      bodies: resolved_bodies(out.checker),
    })
  }
}

pub fn terminating_definitions(definitions: List<DefinitionInfo>) -> Map<Bytes, Bool> =
  definitions.fold(Map::new(), |acc: Map<Bytes, Bool>, definition_info: DefinitionInfo|
    match definition_info.ending { Terminates -> acc.insert(definition_info.name, true), _ -> acc })

pub fn measured_definitions(definitions: List<DefinitionInfo>) -> Map<Bytes, Bool> =
  definitions.fold(Map::new(), |acc: Map<Bytes, Bool>, definition_info: DefinitionInfo|
    match definition_info.ending {
      TerminatesByDecreases -> acc.insert(definition_info.name, true),
      _ -> acc,
    })

pub fn bodies_with(
  resolved: Resolution,
  modules: List<ParsedModule>,
  known: CheckCache,
) -> Option<List<TypedBody<Type>>> / {abort.raise} = {
  let out = check_program_with(resolved, modules, known);
  if has_error(out.checker.diagnostics) { None } else { Some(resolved_bodies(out.checker)) }
}

pub fn bodies_read(
  bodies: List<TypedBody<Bytes>>,
  types: TypeTable,
) -> List<TypedBody<Type>> / {abort.raise} =
  bodies.fold(
    { out: [], read: Map::new() },
    |acc: { out: List<TypedBody<Type>>, read: Map<Bytes, Type> }, b: TypedBody<Bytes>| {
      let o = body_retyped(b, acc.read, {
        ty: |k: Bytes, seen: Map<Bytes, Type>| {
          let t = type_at(types, k, seen);
          { ty: t.ty, state: t.read }
        },
        effects: |r: Effects| r,
        entry: |a: Effect| a,
        span: |sp: Span| sp,
      });
      { out: acc.out.push(o.out), read: o.state }
    },
  ).out

pub fn item_owner(module: Bytes, item: Item) -> Bytes / {abort.raise} =
  match item {
    FunctionItem(d) -> qualify(module, d.name.name),
    TestItem(d) -> test_owner(module, d.name),
    LawItem(d) -> law_owner(module, d.name),
    _ -> b"",
  }

fn check_label_apps(checker: Checker) -> Checker / {abort.raise} = {
  let out: Checker = checker.label_apps.fold(checker, |c: Checker, a: LabelApplication| {
    let in_module: Checker = { ..c, module: a.module };
    let judged: Checker = if !a.called {
      report_error_at(
        in_module,
        b"E0306",
        a.span,
        Bytes::concat_all([b"`", simple_name_of(a.callee), b"` must be called directly"]),
        b"used as a value",
        [
          b"its effects name a label the caller fills, so it has no meaning until a call says which resource it touches",
        ],
      )
    } else {
      let names = a.vars.fold([], |acc: List<Bytes>, v: Int|
        match label_named(in_module, a, v) { Some(n) -> acc.push(written_label(n)), None -> acc });
      if names.len() < a.vars.len() {
        let unfilled = error_at(
          b"E0306",
          a.module,
          a.span,
          Bytes::concat_all([
            b"this call leaves a label of `",
            simple_name_of(a.callee),
            b"` unfilled",
          ]),
          b"no resource to perform under",
          [
            Bytes::concat_all([
              b"write it at the call, as `",
              simple_name_of(a.callee),
              b"[<label>](..)`, or pass an argument whose effects or type name it",
            ]),
          ],
        );
        report(in_module, match ((a.params.keys(), a.explicit_vars)) {
          ([own], [w]) -> if label_named(in_module, a, w) != None { unfilled } else {
            with_fix(unfilled, Bytes::concat_all([b"pass `", own, b"` along"]), [
              insertion(a.module, a.named, Bytes::concat_all([b"[", own, b"]"])),
            ])
          },
          _ -> unfilled,
        })
      } else { in_module }
    };
    { ..judged, module: c.module }
  });
  { ..out, module: checker.module }
}

fn label_named(checker: Checker, a: LabelApplication, v: Int) -> Option<Bytes> / {abort.raise} =
  if v < 0 { None } else {
    let t = shallow_resolve(checker.substitution, VariableType(v));
    match label_of(t) {
      Some(n) -> Some(n),
      None -> match t { VariableType(w) -> param_named(a.params, w), _ -> None },
    }
  }

fn param_named(params: Map<Bytes, Int>, v: Int) -> Option<Bytes> =
  params.fold(None, |acc: Option<Bytes>, k: Bytes, w: Int|
    match acc { Some(_) -> acc, None -> if w == v { Some(k) } else { None } })

pub fn check_program_with(
  resolved: Resolution,
  modules: List<ParsedModule>,
  known: CheckCache,
) -> CheckResult / {abort.raise} = {
  let c0 = new_checker(resolved, modules, known);
  let declared: Checker = resolved.order.fold(c0, |checker: Checker, i: Int| {
    let m = modules.get(i);
    let c1: Checker = { ..checker, module: i };
    let typed: Checker = collect_nominals(collect_effects(collect_types(c1, m), m), m);
    collect_instances(
      check_value_namespace(reject_irregular(collect_constructors(typed, m), m), m),
      m,
    )
  });
  let declared: Checker = { ..declared, resource_types: resource_types(declared) };
  let signed = resolved.order.fold(
    { checker: with_orders(declared), by: Map::new() },
    |acc: { checker: Checker, by: Map<Int, ModuleSignatures> }, i: Int| {
      let o = bind_signatures({ ..acc.checker, module: i }, modules.get(i));
      { checker: o.checker, by: acc.by.insert(i, o.signed) }
    },
  );
  let read = |i: Int|
    match signed.by.get(i) {
      Some(s) -> s.names.len() > 0 && s.names.all(|n: Bytes| known.definitions.contains(n)),
      None -> false,
    };
  let rank = |i: Int| if read(i) { 0 } else if sees_homes(modules.get(i).name) { 2 } else { 1 };
  let checked: Checker = [0, 1, 2].fold([], |acc: List<Int>, r: Int|
    acc.concat(resolved.order.filter(|i: Int| rank(i) == r))).fold(
    signed.checker,
    |checker: Checker, i: Int| {
      let m = modules.get(i);
      match signed.by.get(i) {
        Some(s) -> check_specs(check_bodies({ ..checker, module: i }, m, s), m),
        None -> panic("a module of the program was not signed"),
      }
    },
  );
  let tested: Checker = range(0, modules.len()).fold(checked, |checker: Checker, i: Int|
    check_laws(
      check_schemas(check_tests({ ..checker, module: i }, modules.get(i)), modules.get(i)),
      modules.get(i),
    ));
  let resolved: Checker = check_columns(
    check_bit_ops(check_numerics(check_concats(check_updates(check_instances(tested))))),
  );
  let constrained: Checker = check_constraints(
    check_map_keys(check_comparisons(check_label_apps(resolved))),
  );
  let solved: Checker = check_parallels(
    check_scopes(check_simulations({ blame_deriver_errors(constrained) })),
  );
  let holed: Checker = hole_reports(solved);
  { checker: holed, ok: !has_error(holed.diagnostics) }
}

fn effects_text(effects: List<Effect>) -> Bytes / {abort.raise} = effect_list_text(effects, b",")

pub fn dump_flag(b: Bool) -> Bytes = if b { b"1" } else { b"0" }

fn dump_definition(definition_info: DefinitionInfo) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"F;",
    definition_info.name,
    b";",
    scheme_text(definition_info.scheme),
    b";",
    effects_text(definition_info.effects),
    b";",
    effects_text(definition_info.performed),
    b";",
    Bytes::join(
      definition_info.constraints.map(|c: DefinitionConstraint|
        deriver_text(c.deriver).concat(ascii_of_int(c.param))),
      b",",
    ),
    b";",
  ])

fn dump_op(op_info: OpInfo) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    op_info.name,
    b":",
    mode_text(op_info.mode),
    b":",
    dump_flag(op_info.resource_param),
    b":",
    Bytes::join(op_info.params.map(type_text), b"+"),
    b":",
    type_text(op_info.ret),
  ])

fn dump_checked(checker: Checker) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    Bytes::concat_all(checker.definitions.map(dump_definition)),
    Bytes::concat_all(
      checker.tests.map(|test_info: TestInfo|
        Bytes::concat_all([
          b"T;",
          test_info.key,
          b";",
          dump_flag(test_info.nondet),
          b";",
          effects_text(test_info.effects),
          b";",
        ])),
    ),
    Bytes::concat_all(
      checker.laws.map(|law_info: LawInfo|
        Bytes::concat_all([
          b"L;",
          law_info.key,
          b";",
          Bytes::join(
            law_info.binders.map(|b: LawBinder| Bytes::concat_all([b.name, b":", type_text(b.ty)])),
            b",",
          ),
          b";",
          dump_flag(law_info.has_guard),
          b";",
          effects_text(law_info.effects),
          b";",
        ])),
    ),
    Bytes::concat_all(
      checker.effects.filter(|effect_info: EffectInfo| effect_info.module.len() > 0).map(
        |effect_info: EffectInfo|
          Bytes::concat_all([
            b"E;",
            effect_info.name,
            b";",
            dump_flag(effect_info.nondet),
            b";",
            Bytes::join(effect_info.operations.map(dump_op), b","),
            b";",
          ]),
      ),
    ),
    Bytes::concat_all(
      checker.constructors.filter(|constructor_info: ConstructorInfo|
        constructor_info.module.len() > 0).map(|constructor_info: ConstructorInfo|
        Bytes::concat_all([
          b"C;",
          constructor_info.name,
          b";",
          constructor_info.type_name,
          b";",
          ascii_of_int(constructor_info.index),
          b";",
          ascii_of_int(constructor_info.arity),
          b";",
          scheme_text(constructor_info.scheme),
          b";",
        ])),
    ),
  ])

fn dedup_diagnostics(diagnostics: List<Diagnostic>) -> List<Diagnostic> =
  diagnostics.fold(
    { seen: Map::new(), unique: [] },
    |acc: { seen: Map<Diagnostic, Bool>, unique: List<Diagnostic> }, diagnostic: Diagnostic|
      if acc.seen.contains(diagnostic) { acc }
      else { { seen: acc.seen.insert(diagnostic, true), unique: acc.unique.push(diagnostic) } },
  ).unique

type ExpandedSource = {
  name: Bytes,
  module: Module,
  derived: List<DeriveOrigin>,
  diagnostics: List<Diagnostic>,
}

fn parsed_all(sources: List<Source>) -> List<ExpandedSource> / {abort.raise} =
  range(0, sources.len()).map(|i: Int| {
    let s = sources.get(i);
    let r = parse(s.src);
    let x = expand(r.node, r.parser.diagnostics);
    let d: Expansion = expand_derives(i, s.name, x.module);
    {
      name: s.name,
      module: inline_embeds_by_name(Map::new(), s.name, d.module).module,
      derived: d.derived,
      diagnostics: d.diagnostics,
    }
  })

fn resolved_all(sources: List<Source>) -> Result<ResolvedProgram, Bytes> / {abort.raise} = {
  let parsed = parsed_all(sources);
  let expansion = parsed.fold([], |acc: List<Diagnostic>, p: ExpandedSource|
    acc.concat(p.diagnostics));
  let modules = parsed.map(|p: ExpandedSource|
    { name: p.name, module: p.module, derived: p.derived });
  if expansion.len() > 0 { Err(b"X;".concat(dump_diagnostics(expansion))) } else {
    match resolve_modules(modules) {
      ResolveFailed(ds) -> Err(b"X;".concat(dump_diagnostics(ds))),
      ResolveSucceeded(x) -> Ok(x),
    }
  }
}

fn dump_head(sources: List<Source>) -> Bytes =
  Bytes::concat_all([b"K;", ascii_of_int(sources.len()), b";"])

pub fn check_dump(sources: List<Source>) -> String / {abort.raise} =
  String::of_bytes(
    dump_head(sources).concat(match resolved_all(sources) {
      Err(rejected) -> rejected,
      Ok(x) -> dump_outcome(check_program(x.resolution, x.modules)),
    }),
  )

fn dump_outcome(out: CheckResult) -> Bytes / {abort.raise} =
  if out.ok { dump_checked(out.checker) }
  else { b"X;".concat(dump_diagnostics(dedup_diagnostics(out.checker.diagnostics))) }

fn cache_of(checker: Checker) -> CheckCache = {
  let definitions = checker.definitions.fold(
    Map::new(),
    |acc: Map<Bytes, CachedDefinition>, definition_info: DefinitionInfo|
      acc.insert(definition_info.name, {
        effects: definition_info.effects,
        performed: definition_info.performed,
        unbounded_effects: definition_info.scaling,
        repeated_parameters: definition_info.repeats,
        ending: definition_info.ending,
        summary: definition_info.summary,
        raises: definition_info.raises,
        ownership_facts: b"",
      }),
  );
  let tests = checker.tests.fold(Map::new(), |acc: Map<Bytes, CachedTest>, t: TestInfo|
    acc.insert(t.key, { effects: t.effects, facts: b"" }));
  {
    ..empty_cache(),
    definitions: definitions,
    tests: tests,
    root: checker.known.root,
    types: checker.known.types,
  }
}

pub type Dumps = { uncached: String, seeded: String }

pub fn check_dumps(sources: List<Source>) -> Dumps / {abort.raise} = {
  let head = dump_head(sources);
  let both = match resolved_all(sources) {
    Err(rejected) -> { uncached: rejected, seeded: rejected },
    Ok(x) -> {
      let first = check_program(x.resolution, x.modules);
      let walked = dump_outcome(first);
      {
        uncached: walked,
        seeded: if !first.ok { walked }
        else { dump_outcome(check_program_with(x.resolution, x.modules, cache_of(first.checker))) },
      }
    },
  };
  {
    uncached: String::of_bytes(head.concat(both.uncached)),
    seeded: String::of_bytes(head.concat(both.seeded)),
  }
}

test "the dump writes each definition, test, law, effect and constructor of a program in its fields" {
  assert_eq(
    check_dump([
      {
        name: b"m",
        src: b"effect log { write emit(Bytes) -> Unit }\ntype Box = | Box(Int)\nfn say<a>(x: a, b: Bytes) -> a / { log.write } where derivable(eq, a) = { log.emit(b); x }\ntest \"says\" { let _ = say(1, b\"x\"); () }\nlaw \"same\" forall (n: Int) where n > 0 { n == n }",
      },
    ]),
    "K;1;F;m.say;<a>(a, Bytes) -> a / {m.log.write};m.log.write;m.log.emit;eq0;T;m.says;0;m.log.write;L;m.same;n:Int;1;;E;m.log;0;emit:write:0:Bytes:Unit;C;m.Box;m.Box;0;1;(Int) -> m.Box;",
  )
}

fn checked_m(src: Bytes) -> CheckResult / {abort.raise} =
  match resolved_all([{ name: b"m", src: src }]) {
    Err(rejected) -> panic("`m` does not resolve: " ++ String::of_bytes_lossy(rejected)),
    Ok(x) -> check_program(x.resolution, x.modules),
  }

fn valid_module_checker(src: Bytes) -> Checker / {abort.raise} = {
  let out = checked_m(src);
  assert(out.ok, Some(String::of_bytes_lossy(dump_outcome(out))));
  out.checker
}

type DefinitionDump = { scheme: Bytes, effects: Bytes, performed: Bytes }

fn info_of(checker: Checker, name: Bytes) -> DefinitionInfo / {abort.raise} =
  match checker.definitions.filter(|d: DefinitionInfo| d.name == name) {
    [d, ..] -> d,
    [] -> panic("no definition is named " ++ String::of_bytes_lossy(name)),
  }

fn defined(checker: Checker, name: Bytes) -> DefinitionDump / {abort.raise} = {
  let d = info_of(checker, name);
  {
    scheme: scheme_text(d.scheme),
    effects: effects_text(d.effects),
    performed: effects_text(d.performed),
  }
}

fn scheme_of(src: Bytes, name: Bytes) -> Bytes / {abort.raise} =
  defined(valid_module_checker(src), name).scheme

fn labelled_diagnostics(src: Bytes) -> List<List<Bytes>> / {abort.raise} =
  dedup_diagnostics(checked_m(src).checker.diagnostics).map(|diagnostic: Diagnostic|
    [diagnostic.code].concat(
      diagnostic.labels.map(|label: Label| src.slice(label.start, label.end)),
    ))

fn resolved_source_bodies(checker: Checker) -> List<TypedBody<Type>> / {abort.raise} = {
  let key = |owner: Bytes, part: BodyPart| Bytes::concat_all([owner, b"#", part_key(part)]);
  let bases = checker.typed_bodies.fold(Map::new(), |m: Map<Bytes, Int>, b: WalkedTree|
    m.insert(key(b.owner, b.part), b.base));
  resolved_bodies(checker).filter(|b: TypedBody<Type>| b.module == 0).map(|b: TypedBody<Type>| {
    let base = match bases.get(key(b.owner, b.part)) { Some(x) -> x, None -> 0 };
    body_retyped(b, (), {
      ty: |t: Type, s: Unit| { ty: t, state: s },
      effects: |r: Effects| r,
      entry: |a: Effect| a,
      span: |sp: Span| moved_by(sp, base),
    }).out
  })
}

fn nodes_where(
  checker: Checker,
  picked: (Span) -> Bool,
) -> List<TypedExpression<Type>> / {abort.raise} =
  resolved_source_bodies(checker).flat_map(|b: TypedBody<Type>|
    typed_expression_nodes(b.body)).filter(|e: TypedExpression<Type>| picked(e.span))

fn covers_source(s: Span, at: Span) -> Bool =
  s.start == at.start && s.end == at.end && s.site > 0 && s.site < node_id_base()

fn written_at(checker: Checker, at: Span) -> List<Bytes> / {abort.raise} =
  nodes_where(checker, |s: Span| covers_source(s, at)).map(|e: TypedExpression<Type>| shown(e.ty))

fn source_expression_at(checker: Checker, at: Span) -> Expression / {abort.raise} =
  match expressions_matching(checker.modules.get(0).module, |e: Expression|
      expression_span(e).start == at.start && expression_span(e).end == at.end) {
    [e, ..] -> e,
    [] -> panic("no node is written there"),
  }

fn shown(t: Type) -> Bytes / {abort.raise} =
  match t {
    FunctionType(f) ->
      Bytes::concat_all([b"(", Bytes::join(f.params.map(shown), b", "), b") -> ", shown(f.ret)]),
    other -> type_text(other),
  }

fn placed_in(src: Bytes, from: Bytes, to: Bytes) -> Span / {abort.raise} =
  match src.index_of(from) {
    None -> span_between(0, 0),
    Some(s) -> match src.slice(s, src.len()).index_of(to) {
      Some(e) -> span_between(s, s + e),
      None -> span_between(s, s),
    },
  }

fn placed_effects_text(effects: Effects) -> Bytes = {
  let listed = Bytes::join(effects.listed.map(effect_placed_text), b", ");
  let tail = match effects.variable {
    None -> b"",
    Some(v) ->
      Bytes::concat_all([if listed.len() == 0 { b"" } else { b" " }, b"| ", place_text(b"e", v)]),
  };
  Bytes::concat_all([b"{", listed, tail, b"}"])
}

fn effect_placed_text(entry: Effect) -> Bytes = {
  let resource = match entry.resource {
    SingletonResource -> b"",
    AnyResource -> b"[*]",
    NamedResource(n) -> Bytes::concat_all([b"[", n, b"]"]),
    ResourceVariable(v) -> Bytes::concat_all([b"[", place_text(b"l", v), b"]"]),
  };
  Bytes::concat_all([
    entry.effect,
    b".",
    match entry.op { Some(op) -> op, None -> mode_text(entry.mode) },
    resource,
  ])
}

fn place_text(letter: Bytes, place: Int) -> Bytes =
  if place < 0 { b"?" } else { letter.concat(ascii_of_int(place)) }

fn effects_of_node(e: TypedExpression<Type>) -> List<Bytes> = {
  let filled = |rows: List<Effects>|
    if rows.len() == 0 { [] }
    else { [Bytes::concat_all([b"[", Bytes::join(rows.map(placed_effects_text), b", "), b"]"])] };
  match e.node {
    TypedRead(ReadDefinition(d)) -> filled(d.effect_arguments),
    TypedRead(ReadBuiltin(f)) -> filled(f.effect_arguments),
    TypedLambda(l) -> [placed_effects_text(l.effects)],
    TypedSimulate(t) -> [placed_effects_text(t.effects)],
    TypedHandle(h) -> [placed_effects_text(h.effects)],
    TypedPerform(p) -> [effect_placed_text(p.entry)],
    TypedCall(c) -> match c.callee.node {
      TypedRead(ReadDefinition(_)) -> [],
      TypedRead(ReadConstructor(_)) -> [],
      TypedRead(ReadBuiltin(_)) -> [],
      _ -> [placed_effects_text(c.effects)],
    },
    _ -> [],
  }
}

fn effects_where(checker: Checker, picked: (Span) -> Bool) -> List<Bytes> / {abort.raise} =
  resolved_source_bodies(checker).flat_map(|b: TypedBody<Type>|
    typed_expression_nodes(b.body)).flat_map(|e: TypedExpression<Type>| {
    let own = if picked(e.span) { effects_of_node(e) } else { [] };
    match e.node {
      TypedHandle(h) ->
        own.concat(
          h.clauses.filter(|c: TypedClause<Type>| picked(c.span)).map(|c: TypedClause<Type>|
            placed_effects_text(c.effects)),
        ).concat(match h.ret {
          Some(r) -> if picked(r.span) { [placed_effects_text(r.effects)] } else { [] },
          None -> [],
        }),
      TypedParallel(ts) ->
        own.concat(
          ts.filter(|t: TypedThunk<Type>| picked(t.body.span)).map(|t: TypedThunk<Type>|
            placed_effects_text(t.effects)),
        ),
      _ -> own,
    }
  })

fn effects_at(checker: Checker, at: Span) -> List<Bytes> / {abort.raise} =
  effects_where(checker, |s: Span| s == at)

fn effects_written_at(checker: Checker, at: Span) -> List<Bytes> / {abort.raise} =
  effects_where(checker, |s: Span| covers_source(s, at))

fn check_resolved_effects(src: Bytes) -> Checker / {abort.raise} = {
  let checker = valid_module_checker(src);
  assert_eq(effects_where(checker, |s: Span| true).filter(|t: Bytes| t.index_of(b"?") != None), []);
  checker
}

test "a clause binding its continuation holds what resuming it performs" {
  let src = Bytes::concat_all([
    b"effect amb {\n  read flip() -> Bool\n}\n",
    b"effect trace {\n  write step() -> Unit\n}\n",
    b"fn traced() -> Int / {trace.write} = handle { let b = amb.flip(); trace.step(); if b { 1 } else { 2 } } with { amb.flip() resume k -> k(true) + 1 }\n",
  ]);
  let resumed = resolved_source_bodies(check_resolved_effects(src)).flat_map(
    |b: TypedBody<Type>| typed_expression_nodes(b.body),
  ).flat_map(|e: TypedExpression<Type>|
    match e.node {
      TypedHandle(h) ->
        h.clauses.map(|c: TypedClause<Type>| placed_effects_text(c.continuation_effects)),
      _ -> [],
    });
  assert_eq(resumed, [b"{m.trace.step}"])
}

fn log_and_link() -> Bytes =
  Bytes::concat_all([
    b"effect log {\n  write note(n: Int) -> Unit\n}\n",
    b"effect link {\n  write send[s](payload: Int) -> Int\n}\n",
    b"fn apply<|e>(f: () -> Int / e) -> Int / e = f()\n",
    b"fn into<|e>(g: () -> Int / {log.note | e}) -> Int / {log.note | e} = g()\n",
  ])

test "a read of a definition generic over effects records what fills each effect variable, a label as the reader's own" {
  let src = log_and_link().concat(
    Bytes::concat_all([
      b"fn logged() -> Int / {log.write} = apply(|| { log.note(1); 2 })\n",
      b"fn sent<[l]>(x: Int) -> Int / {link.send[l]} = apply(|| link.send[l](x))\n",
      b"fn passed<|e>(f: () -> Int / e) -> Int / e = apply(f)\n",
      b"fn mapped(xs: List<Int>) -> List<Int> / {log.write} = xs.map(|x: Int| { log.note(x); x })\n",
      b"fn twice() -> Int / {log.write} = logged() + logged()\n",
    ]),
  );
  let checker = check_resolved_effects(src);
  let at = |from: Bytes, to: Bytes| effects_written_at(checker, placed_in(src, from, to));
  assert_eq(at(b"apply(|| {", b"(|| {"), [b"[{m.log.note}]"]);
  assert_eq(at(b"apply(|| link", b"(|| link"), [b"[{m.link.send[l0]}]"]);
  assert_eq(at(b"apply(f)", b"(f)"), [b"[{| e0}]"]);
  let member = placed_in(src, b"map(|x", b"(|x");
  assert_eq(effects_where(checker, |s: Span| s.start == member.start && s.end == member.end), [
    b"[{m.log.note}]",
  ]);
  assert_eq(at(b"logged() +", b"() +"), [])
}

test "an effect variable nothing resolves closes the effects it is read in" {
  let src = log_and_link().concat(
    Bytes::concat_all([
      b"fn run<|e>(n: Int, hook: Option<() -> Int / e> = None) -> Int / e = match hook { Some(h) -> h() + n, None -> n }\n",
      b"test \"runs\" { assert(run(1) == 1) }\n",
    ]),
  );
  let checker = check_resolved_effects(src);
  assert_eq(effects_written_at(checker, placed_in(src, b"run(1)", b"(1)")), [b"[{}]"])
}

test "a lambda keeps its own effects, however wide the place it is passed to" {
  let src = log_and_link().concat(
    Bytes::concat_all([
      b"fn quiet() -> Int / {log.write} = into(|| 3)\n",
      b"fn noisy() -> Int / {log.write} = into(|| { log.note(4); 5 })\n",
      b"fn opened<|e>(f: () -> Int / e) -> Int / e = apply(|| f())\n",
    ]),
  );
  let checker = check_resolved_effects(src);
  let at = |from: Bytes, to: Bytes| effects_written_at(checker, placed_in(src, from, to));
  assert_eq(at(b"|| 3", b")\n"), [b"{}"]);
  assert_eq(at(b"into(|| 3", b"(|| 3"), [b"[{}]"]);
  assert_eq(at(b"|| { log.note(4)", b")\n"), [b"{m.log.note}"]);
  assert_eq(at(b"|| f()", b")\n"), [b"{| e0}"])
}

test "a call through a function value has the effects of the type it calls through" {
  let src = log_and_link().concat(
    Bytes::concat_all([
      b"effect amb {\n  read flip() -> Bool\n}\n",
      b"type Job = { run: () -> Int / {log.write} }\n",
      b"fn ran(j: Job) -> Int / {log.write} = j.run()\n",
      b"fn both() -> Int = handle { if amb.flip() { 1 } else { 2 } } with { amb.flip() resume k -> k(true) + 1, return v -> v * 10 }\n",
    ]),
  );
  let checker = check_resolved_effects(src);
  let at = |from: Bytes, to: Bytes| effects_written_at(checker, placed_in(src, from, to));
  assert_eq(at(b"f()", b"\n"), [b"{| e0}"]);
  assert_eq(at(b"g()", b"\n"), [b"{m.log.note | e0}"]);
  assert_eq(at(b"j.run()", b"\n"), [b"{m.log.write}"]);
  assert_eq(at(b"k(true)", b" + 1"), [b"{}"])
}

test "a handle has its body's effects as its clauses open them, plus each clause's and its return clause's own" {
  let src = log_and_link().concat(
    Bytes::concat_all([
      b"fn caught() -> Int / {link.send[conn]} = handle { log.note(1); link.send[conn](2) } with { log.note(n) -> { let _ = link.send[conn](n); () }, return v -> v + 1 }\n",
      b"fn guarded<|e>(k: () -> Int / {log.note | e}) -> Int / e = handle { k() } with { log.note(n) -> () }\n",
      b"fn local() -> Int = { let run = |k| handle { k() } with { log.note(n) -> () }; run(|| { log.note(1); 5 }) }\n",
    ]),
  );
  let checker = check_resolved_effects(src);
  let at = |from: Bytes, to: Bytes| effects_written_at(checker, placed_in(src, from, to));
  assert_eq(at(b"handle { log.note(1)", b"\nfn guarded"), [b"{m.link.send[conn], m.log.note}"]);
  assert_eq(at(b"log.note(n) -> {", b", return"), [b"{m.link.send[conn]}"]);
  assert_eq(at(b"return v", b" }\n"), [b"{}"]);
  assert_eq(at(b"handle { k() } with { log.note(n) -> () }\n", b"\n"), [b"{m.log.note | e0}"]);
  assert_eq(at(b"handle { k() } with { log.note(n) -> () };", b";"), [b"{m.log.note}"]);
  assert_eq(at(b"log.note(n) -> () };", b" };"), [b"{}"]);
  assert_eq(at(b"|k| handle", b"; run"), [b"{}"])
}

test "a try has its body's effects, and the clauses it expands to perform nothing" {
  let src = Bytes::concat_all([
    b"effect parse {\n  raise bad(why: String)\n}\n",
    b"effect log {\n  write note(n: Int) -> Unit\n}\n",
    b"fn digit(b: Int) -> Int / {parse.bad, log.write} = if b < 10 { b } else { parse.bad(\"no\") }\n",
    b"fn checked(b: Int) -> Result<Int, String> / {log.write} = try { digit(b) }\n",
  ]);
  let checker = check_resolved_effects(src);
  let one = expression_span(source_expression_at(checker, placed_in(src, b"try { digit", b"\n")));
  let at = try_spans(one);
  assert_eq(effects_at(checker, one), [b"{m.log.write, m.parse.bad}"]);
  assert_eq(effects_at(checker, at.early_return), [b"{}"]);
  assert_eq(effects_at(checker, at.clause), [b"{}"])
}

test "each branch of a `parallel` holds what it performs" {
  let src = Bytes::concat_all([
    b"effect log {\n  write note(n: Int) -> Unit\n}\n",
    b"fn summed(n: Int) -> Int / {log.write} = { let (a, b) = parallel { n + 1, { log.note(n); n } }; a + b }\n",
  ]);
  let checker = check_resolved_effects(src);
  let branch = |text: Bytes| {
    let s = placed_in(src, text, text).start;
    effects_at(
      checker,
      expression_span(source_expression_at(checker, span_between(s, s + text.len()))),
    )
  };
  assert_eq(branch(b"n + 1"), [b"{}"]);
  assert_eq(branch(b"{ log.note(n); n }"), [b"{m.log.note}"])
}

test "a perform has its effect, on a label parameter as its definition's own" {
  let src = log_and_link().concat(
    Bytes::concat_all([
      b"fn forward<[l]>(x: Int) -> Int / {link.send[l]} = link.send[l](x)\n",
      b"fn direct(x: Int) -> Int / {link.send[conn]} = link.send[conn](x)\n",
      b"fn relayed<[l], [n]>(x: Int) -> Int / {link.send[l], link.send[n]} = link.send[l](link.send[n](x))\n",
      b"fn noted() -> Unit / {log.write} = log.note(3)\n",
    ]),
  );
  let checker = check_resolved_effects(src);
  let at = |from: Bytes, to: Bytes| effects_written_at(checker, placed_in(src, from, to));
  assert_eq(at(b"link.send[l](x)", b"\n"), [b"m.link.send[l0]"]);
  assert_eq(at(b"link.send[conn](x)", b"\n"), [b"m.link.send[conn]"]);
  assert_eq(at(b"link.send[l](link", b"\n"), [b"m.link.send[l0]"]);
  assert_eq(at(b"link.send[n](x)", b")\n"), [b"m.link.send[l1]"]);
  assert_eq(at(b"log.note(3)", b"\n"), [b"m.log.note"])
}

test "the constructor a `?` hands its failure on by is read at the `?`, as a written one is" {
  let src = Bytes::concat_all([
    b"fn half(n: Int) -> Result<Int, String> = if n > 0 { Ok(n) } else { Err(\"no\") }\n",
    b"fn quarter(n: Int) -> Result<Int, String> = { let h = half(n)?; half(h) }\n",
  ]);
  let checker = valid_module_checker(src);
  let q = placed_in(src, b"?", b"?").start;
  assert_eq(written_at(checker, span_between(q, q + 1)), [b"(String) -> Result<Int, String>"])
}

test "the parts of the handle a try is written out as stand where the rewrite puts them" {
  let src = Bytes::concat_all([
    b"effect parse {\n  raise bad(why: String)\n  raise missing(key: String, line: Int)\n}\n",
    b"fn digit(b: Int) -> Int / {parse.bad} = if b < 10 { b } else { parse.bad(\"no\") }\n",
    b"fn checked(b: Int) -> Result<Int, String> = try { digit(b) }\n",
    b"fn lookup(key: String) -> Int / {parse.missing} = if key == \"a\" { 1 } else { parse.missing(key, 7) }\n",
    b"fn found(key: String) -> Int = match try { lookup(key) } { Ok(n) -> n, Err(_) -> 0 }\n",
  ]);
  let checker = valid_module_checker(src);
  let typed = |at: Span|
    nodes_where(checker, |s: Span| s == at).map(|e: TypedExpression<Type>| shown(e.ty));
  let one = expression_span(source_expression_at(checker, placed_in(src, b"try { digit", b"\n")));
  let at = try_spans(one);
  let result = b"Result<Int, String>";
  assert_eq(typed(one), [result]);
  assert_eq(typed(at.ok), [b"(Int) -> ".concat(result)]);
  assert_eq(typed(at.err), [b"(String) -> ".concat(result)]);
  assert_eq(typed(at.arguments_record), []);
  let lookup = b"try { lookup(key) }";
  let s = placed_in(src, lookup, lookup).start;
  let several = try_spans(
    expression_span(source_expression_at(checker, span_between(s, s + lookup.len()))),
  );
  assert_eq(typed(several.arguments_record).len(), 1)
}

test "a default a call leaves out is among its arguments, at the call's types" {
  let src = Bytes::concat_all([
    b"type Box = | Box(Int)\n",
    b"fn greet(name: String, title: Option<String> = None) -> Int = match title { Some(_) -> 1, None -> 0 }\n",
    b"fn plain() -> Int = greet(\"a\")\n",
    b"fn pick<a>(x: a, other: Option<a> = None) -> a = match other { Some(o) -> o, None -> x }\n",
    b"fn both() -> Int = { let s = pick(\"s\"); pick(1) }\n",
    b"fn checked(n: Int) -> Int / {abort.raise} = { assert(n > 0); n }\n",
    b"fn Box::size(b: Box, extra: Option<Int> = None) -> Int = match b { Box(v) -> match extra { Some(e) -> v + e, None -> v } }\n",
    b"fn measured(b: Box) -> Int = b.size()\n",
  ]);
  let checker = valid_module_checker(src);
  let last = |call: Bytes| {
    let s = placed_in(src, call, call).start;
    nodes_where(checker, |sp: Span| sp.start == s && sp.end == s + call.len()).fold(
      [],
      |acc: List<Bytes>, e: TypedExpression<Type>|
        match e.node {
          TypedCall(c) -> match c.args.at(c.args.len() - 1) {
            Some(a) -> acc.push(shown(a.ty)),
            None -> acc,
          },
          _ -> acc,
        },
    )
  };
  assert_eq(last(b"greet(\"a\")"), [b"Option<String>"]);
  assert_eq(last(b"pick(\"s\")"), [b"Option<String>"]);
  assert_eq(last(b"pick(1)"), [b"Option<Int>"]);
  assert_eq(last(b"assert(n > 0)"), [b"Option<String>"]);
  assert_eq(last(b"b.size()"), [b"Option<Int>"])
}

test "a definition's scheme is generalized and its effects inferred" {
  let c = valid_module_checker(
    b"pub fn id<a>(x: a) -> a = x\nfn two() -> Int = id(2)\neffect log { write emit(Bytes) -> Unit }\nfn say(b: Bytes) -> Unit / { log.write } = log.emit(b)",
  );
  assert_eq(defined(c, b"m.id"), { scheme: b"<a>(a) -> a", effects: b"", performed: b"" });
  assert_eq(defined(c, b"m.two").scheme, b"() -> Int");
  assert_eq(defined(c, b"m.say"), {
    scheme: b"(Bytes) -> Unit / {m.log.write}",
    effects: b"m.log.write",
    performed: b"m.log.emit",
  })
}

test "a definition may be generic over a resource label, and a call fills it" {
  let c = valid_module_checker(
    b"effect net { write send[r](Bytes) -> Unit }\npub fn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\npub fn go(b: Bytes) -> Unit / {net.send[conn]} = relay[conn](b)",
  );
  assert_eq(defined(c, b"m.relay"), {
    scheme: b"<[l]>(Bytes) -> Unit / {m.net.send[l]}",
    effects: b"<[l]>m.net.send[l]",
    performed: b"<[l]>m.net.send[l]",
  });
  assert_eq(defined(c, b"m.go"), {
    scheme: b"(Bytes) -> Unit / {m.net.send[conn]}",
    effects: b"m.net.send[conn]",
    performed: b"m.net.send[conn]",
  })
}

test "an argument's effects are its call's, and a fold threads the effects of the function it is handed" {
  let c = valid_module_checker(
    b"effect log {\n  write note[out](line: String) -> Unit\n}\nfn quiet(xs: List<Int>) -> Option<Int> = xs.at(0)\nfn loud(xs: List<Int>) -> Option<Int> / {log.write[out]} =\n  xs.at({ log.note[out](\"asked\"); 0 })\nfn shout(m: Map<String, Int>) -> Int / {log.write[out]} =\n  m.fold(0, |acc, k, v| { log.note[out](k); acc + v })\n",
  );
  assert_eq(defined(c, b"m.quiet").effects, b"");
  assert_eq(defined(c, b"m.loud").effects, b"m.log.write[out]");
  assert_eq(defined(c, b"m.shout").effects, b"m.log.write[out]")
}

fn tracing() -> Bytes =
  b"nondet effect trace {\n  write event[c](name: String) -> Unit\n  write enter[c](name: String) -> Int\n  write exit[c](span: Int) -> Unit\n  write count[c](name: String, delta: Int) -> Unit\n}\n"

test "what a body performs names each channel it performs an operation on" {
  let c = valid_module_checker(
    tracing().concat(
      b"fn place_order(sku: String) -> Int / {trace.write[orders]} = {\n  let span = trace.enter[orders](sku);\n  trace.count[orders](\"orders_placed\", 1);\n  trace.exit[orders](span);\n  1\n}\nfn restock(sku: String) -> Int / {trace.write[items]} = {\n  trace.event[items](sku);\n  2\n}\n",
    ),
  );
  assert_eq(
    defined(c, b"m.place_order").performed,
    b"m.trace.count[orders],m.trace.enter[orders],m.trace.exit[orders]",
  );
  assert_eq(defined(c, b"m.restock").performed, b"m.trace.event[items]")
}

test "an argument's effects fill a label the call does not write" {
  let c = valid_module_checker(
    b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(f: () -> Unit / {net.send[l]}) -> Unit / {net.send[l]} = f()\nfn go(f: () -> Unit / {net.send[conn]}) -> Unit / {net.send[conn]} = relay(f)",
  );
  assert_eq(defined(c, b"m.relay"), {
    scheme: b"<[l]>(() -> Unit / {m.net.send[l]}) -> Unit / {m.net.send[l]}",
    effects: b"<[l]>m.net.send[l]",
    performed: b"<[l]>m.net.send[l]",
  });
  assert_eq(defined(c, b"m.go"), {
    scheme: b"(() -> Unit / {m.net.send[conn]}) -> Unit / {m.net.send[conn]}",
    effects: b"m.net.send[conn]",
    performed: b"m.net.send[conn]",
  })
}

test "a clause on a label parameter discharges what the generic body performs" {
  let c = valid_module_checker(
    b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\nfn quiet<[l]>(b: Bytes) -> Unit = handle relay[l](b) with { net.send[l](x) -> () }",
  );
  assert_eq(defined(c, b"m.relay").performed, b"<[l]>m.net.send[l]");
  assert_eq(defined(c, b"m.quiet"), {
    scheme: b"<[l]>(Bytes) -> Unit",
    effects: b"",
    performed: b"",
  })
}

test "an unknown name is told the name in scope a slip of the hand would make it" {
  let with_note_effect = |call: Bytes| {
    let src = b"fn count(n: Int) -> Int = n\nfn go() -> Int = ".concat(call);
    source_diagnostics(src).map(|diagnostic: Diagnostic|
      {
        code: diagnostic.code,
        at: diagnostic.labels.fold(b"", |at: Bytes, label: Label|
          if label.primary { src.slice(label.start, label.end) } else { at }),
        offered: diagnostic.notes_text.any(|note: Bytes| note.index_of(b"count") != None),
      })
  };
  assert_eq(with_note_effect(b"cuont(2)"), [{ code: b"E0101", at: b"cuont", offered: true }]);
  assert_eq(with_note_effect(b"counts(2)"), [{ code: b"E0101", at: b"counts", offered: true }]);
  assert_eq(with_note_effect(b"breadth(2)"), [{ code: b"E0101", at: b"breadth", offered: false }]);
  assert_eq(with_note_effect(b"cnt(2)"), [{ code: b"E0101", at: b"cnt", offered: false }])
}

test "`[*]` on an operation that takes no resource is rejected" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"effect log { write note(line: String) -> Unit }\nfn go() -> Unit = handle { log.note(\"x\") } with { log.note[*](line) -> () }",
    },
  ]);
  assert(dump.contains("E0304"))
}

test "`[*]` in a function's effects on an operation that takes no resource is rejected" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"effect log { write note(line: String) -> Unit }\nfn go() -> Unit / {log.note[*]} = log.note(\"x\")",
    },
  ]);
  assert(dump.contains("E0304"))
}

test "a label a call cannot fill, a count that does not match, and a use as a value" {
  let unfilled = check_dump([
    {
      name: b"m",
      src: b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\nfn go(b: Bytes) -> Unit / {net.send[conn]} = relay(b)",
    },
  ]);
  assert(unfilled.contains("E0306"));
  let counted = check_dump([
    {
      name: b"m",
      src: b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\nfn go(b: Bytes) -> Unit / {net.send[conn]} = relay[conn, other](b)",
    },
  ]);
  assert(counted.contains("E0306"));
  let valued = check_dump([
    {
      name: b"m",
      src: b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\nfn go() -> (Bytes) -> Unit / {net.send[conn]} = relay",
    },
  ]);
  assert(valued.contains("E0306"));
  let plain = check_dump([
    { name: b"m", src: b"fn id(x: Int) -> Int = x\nfn go(n: Int) -> Int = id[conn](n)" },
  ]);
  assert(plain.contains("E0306"))
}

test "two label parameters stay apart, and each names its own effect" {
  let c = valid_module_checker(
    b"effect net { write send[r](Bytes) -> Unit }\nfn pipe<[l, k]>(b: Bytes) -> Unit / {net.send[l], net.send[k]} = { net.send[l](b); net.send[k](b) }",
  );
  assert_eq(defined(c, b"m.pipe"), {
    scheme: b"<[l], [m]>(Bytes) -> Unit / {m.net.send[l], m.net.send[m]}",
    effects: b"<[l],[m]>m.net.send[l],m.net.send[m]",
    performed: b"<[l],[m]>m.net.send[l],m.net.send[m]",
  })
}

test "a call inside a recursive group fills its callee's labels as any call does" {
  let alone = |call: Bytes, effects: Bytes|
    Bytes::concat_all([
      b"effect net { write send[r](Bytes) -> Unit }\n",
      b"fn walk<[l]>(n: Int, b: Bytes) -> Unit / {",
      effects,
      b"} = if n <= 0 { net.send[l](b) } else { ",
      call,
      b" }",
    ]);
  assert_eq(check_codes(alone(b"walk[l](n - 1, b)", b"net.send[l]")), []);
  assert_eq(check_codes(alone(b"walk[conn](n - 1, b)", b"net.send[l], net.send[conn]")), []);
  assert_eq(check_codes(alone(b"walk[conn](n - 1, b)", b"net.send[l]")), [b"E0302"]);
  let bare = alone(b"walk(n - 1, b)", b"net.send[l]");
  let unfilled = source_diagnostics(bare).filter(|diagnostic: Diagnostic|
    diagnostic.code == b"E0306");
  assert_eq(unfilled.map(|diagnostic: Diagnostic| diagnostic.message), [
    b"this call leaves a label of `walk` unfilled",
  ]);
  assert_eq(fixes_of(unfilled).map(|fix: Fix| fix.title), [b"pass `l` along"]);
  assert_eq(fixes_of(unfilled).map(|fix: Fix| fixed_by(bare, fix)), [
    alone(b"walk[l](n - 1, b)", b"net.send[l]"),
  ]);
  let pair = Bytes::concat_all([
    b"effect net { write send[r](Bytes) -> Unit }\n",
    b"fn ping<[l]>(n: Int, b: Bytes) -> Unit / {net.send[l]} = if n <= 0 { net.send[l](b) } else { pong[l](n - 1, b) }\n",
    b"fn pong<[k]>(n: Int, b: Bytes) -> Unit / {net.send[k]} = ping[k](n - 1, b)",
  ]);
  assert_eq(check_codes(pair), []);
  let uneven = Bytes::concat_all([
    b"effect net { write send[r](Bytes) -> Unit }\n",
    b"fn ping<[l, k]>(n: Int, b: Bytes) -> Unit / {net.send[l], net.send[k]} = if n <= 0 { net.send[l](b) } else { pong[k](n - 1, b) }\n",
    b"fn pong<[l]>(n: Int, b: Bytes) -> Unit / {net.send[l]} = if n <= 0 { net.send[l](b) } else { ping[l, l](n - 1, b) }",
  ]);
  assert_eq(check_codes(uneven), [])
}

test "a call inside a recursive group fills its callee's effects as any call does" {
  let alone = |effects: Bytes, handed: Bytes|
    Bytes::concat_all([
      b"effect tick { write now() -> Unit }\n",
      b"fn each<|e>(n: Int, f: () -> Unit / e) -> Unit / ",
      effects,
      b" = if n <= 0 { f() } else { each(n - 1, ",
      handed,
      b") }",
    ]);
  assert_eq(check_codes(alone(b"e", b"f")), []);
  assert_eq(check_codes(alone(b"{tick.now | e}", b"|| tick.now()")), []);
  assert_eq(check_codes(alone(b"e", b"|| tick.now()")), [b"E0302"]);
  let pair = Bytes::concat_all([
    b"fn ping<|e>(n: Int, f: () -> Unit / e) -> Unit / e = if n <= 0 { f() } else { pong(n - 1, f) }\n",
    b"fn pong<|t>(n: Int, f: () -> Unit / t) -> Unit / t = ping(n - 1, f)",
  ]);
  assert_eq(check_codes(pair), []);
  let mixed = Bytes::concat_all([
    b"fn each<|e>(n: Int, f: () -> Unit / e) -> Unit / e = if n <= 0 { f() } else { plain(n - 1) }\n",
    b"fn plain(n: Int) -> Unit = if n <= 0 { () } else { each(n - 1, || ()) }",
  ]);
  assert_eq(check_codes(mixed), [])
}

test "two callbacks that perform different things fill one effect variable with both" {
  let src = Bytes::concat_all([
    b"effect a { write x() -> Unit }\n",
    b"effect b { write y() -> Unit }\n",
    b"fn both<|e>(f: () -> Unit / e, g: () -> Unit / e) -> Unit / e = { f(); g() }\n",
    b"fn fa() -> Unit / {a.x} = a.x()\n",
    b"fn go() -> Unit / {a.x, b.y} = both(|| a.x(), || b.y())\n",
    b"fn named() -> Unit / {a.x} = both(fa, || ())\n",
    b"fn apart() -> (Unit, Unit) / {a.x, b.y} = parallel { both(|| a.x(), || a.x()), b.y() }",
  ]);
  assert_eq(check_codes(src), []);
  let c = valid_module_checker(src);
  assert_eq(defined(c, b"m.go").scheme, b"() -> Unit / {m.a.x, m.b.y}");
  assert_eq(defined(c, b"m.named").scheme, b"() -> Unit / {m.a.x}");
  assert_eq(defined(c, b"m.apart").scheme, b"() -> (Unit, Unit) / {m.a.x, m.b.y}");
  let clash = Bytes::concat_all([
    b"effect a { write x() -> Unit }\n",
    b"effect b { write y() -> Unit }\n",
    b"fn both<|e>(f: () -> Unit / e, g: () -> Unit / e) -> Unit / e = { f(); g() }\n",
    b"fn shared() -> (Unit, Unit) / {a.x, b.y} = parallel { both(|| a.x(), || b.y()), b.y() }",
  ]);
  assert_eq(check_codes(clash), [b"E0309"])
}

test "a callback may perform less than its parameter's effects permit, and nothing they do not permit" {
  let ops = b"effect a { write x() -> Unit\n write z() -> Unit }\n";
  let run = ops.concat(b"fn run(k: () -> Unit / {a.x, a.z}) -> Unit / {a.x, a.z} = k()\n");
  assert_eq(check_codes(run.concat(b"fn go() -> Unit / {a.x, a.z} = run(|| a.x())")), []);
  assert_eq(check_codes(run.concat(b"fn go() -> Unit / {a.x, a.z} = run(|| ())")), []);
  let narrow = ops.concat(
    b"fn run(k: () -> Unit / {a.x}) -> Unit / {a.x} = k()\nfn go() -> Unit / {a.x} = run(|| a.z())",
  );
  let diagnostics = source_diagnostics(narrow);
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0302"]);
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.labels.get(0).text), [
    b"expected {m.a.x}, found {m.a.z}",
  ]);
  let held = |body: Bytes|
    Bytes::concat_all([
      ops,
      b"fn go<|e>(k: (() -> Unit / {a.x | e}) -> Unit / {a.x | e}) -> Unit / {a.x | e} = k(",
      body,
      b")",
    ]);
  assert_eq(check_codes(held(b"|| a.x()")), []);
  assert_eq(check_codes(held(b"|| a.z()")), [b"E0302"]);
  let handed = ops.concat(
    b"effect ctl { write run(k: () -> Unit / {a.x, a.z}) -> Unit }\nfn go() -> Unit / {ctl.write} = ctl.run(|| a.x())",
  );
  assert_eq(check_codes(handed), [])
}

test "recorded facts hold a body's data ahead of the body, and decode as they were encoded" {
  let of_literal = |l: SourceLiteral| {
    let body = {
      owner: b"m.kept",
      module: 0,
      part: WholeBody,
      params: [],
      body: { node: TypedLiteral(l), span: dummy_span(), ty: b"", releases: [] },
    };
    encode_facts({ ..no_body_facts(), bodies: [body] })
  };
  let literal = LiteralInt(300);
  assert_eq(recorded_data(of_literal(literal)), Some(LiteralData(literal)));
  assert_eq(recorded_data(of_literal(LiteralEmbedded(b"digest", 1))), None);
  assert_eq(recorded_data(encode_facts(no_body_facts())), None);
  let decoded = |recorded: Bytes|
    decode_facts(recorded, 0, b"m.kept").map(|f: BodyFacts| f.bodies.len());
  assert_eq(decoded(of_literal(literal)), Some(1));
  assert_eq(decoded(encode_facts(no_body_facts())), Some(0))
}

test "a claim may pass a pure callback to a function generic over its effects" {
  assert_eq(
    check_codes(
      Bytes::concat_all([
        b"fn total(xs: List<Int>) -> Int\n",
        b"  requires xs.fold(0, |s: Int, x: Int| s + x) < 100\n",
        b"= xs.fold(0, |s: Int, x: Int| s + x)\n",
        b"law \"a fold over nothing is its seed\" { [].fold(7, |s: Int, x: Int| s + x) == 7 }",
      ]),
    ),
    [],
  )
}

test "a list, a branch, a return, an annotation and a value's fields take functions that perform less" {
  let src = Bytes::concat_all([
    b"effect a { write x() -> Unit\n write z() -> Unit }\n",
    b"effect b { write y() -> Unit }\n",
    b"fn each<|e>(fs: List<() -> Unit / e>) -> Unit / e = ()\n",
    b"fn pair<|e>(h: { ok: () -> Unit / e, err: () -> Unit / e }) -> Unit / e = ()\n",
    b"fn listed() -> Unit / {a.x, b.y} = each([|| a.x(), || b.y()])\n",
    b"fn paired() -> Unit / {a.x, b.y} = pair({ ok: || a.x(), err: || b.y() })\n",
    b"fn branched(c: Bool) -> () -> Unit / {a.x, b.y} = if c { || a.x() } else { || b.y() }\n",
    b"fn matched(n: Int) -> () -> Unit / {a.x, b.y} = match n { 0 -> || a.x(), _ -> || b.y() }\n",
    b"fn fell(o: Option<Int>) -> () -> Unit / {a.x, b.y} = { let Some(_) = o else { || b.y() }; || a.x() }\n",
    b"fn returned() -> () -> Unit / {a.x, a.z} = || a.x()\n",
    b"fn annotated() -> Unit / {a.x, a.z} = { let f: () -> Unit / {a.x, a.z} = || a.x(); f() }\n",
    b"fn held() -> Option<() -> Unit / {a.x, a.z}> = Some(|| a.x())",
  ]);
  assert_eq(check_codes(src), []);
  let c = valid_module_checker(src);
  assert_eq(defined(c, b"m.listed").scheme, b"() -> Unit / {m.a.x, m.b.y}");
  assert_eq(defined(c, b"m.paired").scheme, b"() -> Unit / {m.a.x, m.b.y}")
}

test "a function's parameter and a declared type keep their effects exactly" {
  let net = b"effect net { write send[s](p: Bytes) -> Unit\n write recv[s](n: Int) -> Bytes }\n";
  let escaping = Bytes::concat_all([
    net,
    b"fn sender(f: () -> Unit / {net.send[x]}) -> Unit = handle { f() } with { net.send[x](p) -> () }\n",
    b"fn run(k: (() -> Unit / {net.write[x]}) -> Unit) -> Unit = k(|| { let _ = net.recv[x](1); () })\n",
    b"fn go() -> Unit = run(sender)",
  ]);
  assert_eq(check_codes(escaping), [b"E0302"]);
  let boxed = Bytes::concat_all([
    net,
    b"type Box<a> = Box(a)\n",
    b"fn open(b: Box<() -> Unit / {net.write[x]}>) -> Unit / {net.write[x]} = match b { Box(f) -> f() }\n",
    b"fn go(f: keep () -> Unit / {net.send[x]}) -> Unit / {net.write[x]} = open(Box(f))",
  ]);
  assert_eq(check_codes(boxed), [b"E0302"])
}

test "a call inside a recursive group fills its callee's type parameters, and may not grow one" {
  let concrete = Bytes::concat_all([
    b"fn ping<a>(n: Int, x: a) -> Int = if n <= 0 { 0 } else { pong(n - 1) }\n",
    b"fn pong(n: Int) -> Int = ping(n - 1, 0)",
  ]);
  assert_eq(check_codes(concrete), []);
  let crossed = Bytes::concat_all([
    b"fn even<a>(xs: List<a>, n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1, 0, xs) }\n",
    b"fn odd<k, b>(n: Int, key: k, xs: List<b>) -> Bool = if n <= 0 { false } else { even(xs, n - 1) }",
  ]);
  assert_eq(check_codes(crossed), []);
  let both = Bytes::concat_all([
    b"fn ping<a>(n: Int, x: a) -> Int = if n <= 0 { 0 } else { pong(n - 1, [x]) }\n",
    b"fn pong<b>(n: Int, xs: List<b>) -> Int = ping(n - 1, xs)",
  ]);
  let diagnostics = source_diagnostics(both);
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0308"]);
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.message), [
    b"a call to `ping` inside its own recursive group gives `a` a type that grows",
  ]);
  assert_eq(diagnostics.get(0).labels.map(|label: Label| label.text), [
    b"`a` would be `List<b>` here",
  ]);
  assert_eq(
    diagnostics.get(0).notes_text.get(0),
    b"each time round the recursion `ping` would be called at a larger type, so no finite set of copies of it serves the group: that is polymorphic recursion",
  );
  assert_eq(
    source_diagnostics(
      b"fn grow<a>(x: a, n: Int) -> Int = if n <= 0 { 0 } else { grow([x], n - 1) }",
    ).map(|diagnostic: Diagnostic| diagnostic.message),
    [b"a call to `grow` inside its own recursive group gives `a` a type that grows"],
  )
}

test "a call inside a recursive group accounts for its callee's constraints as any call does" {
  let cycle = |up: Bytes|
    Bytes::concat_all([
      b"fn up<a>(x: a, n: Int) -> a",
      up,
      b" = if n <= 0 { x } else { down(n - 1, x) }\n",
      b"fn down<b>(n: Int, x: b) -> b where numeric(b) = if n <= 0 { x } else { up(x + x, n - 1) }\n",
      b"fn go() -> U8 = up(1u8, 3)",
    ]);
  let checker = checked_context(cycle(b" where numeric(a)"));
  let passed = passed_numeric_witnesses(checker);
  assert_eq(passed.len(), 3);
  let passes = |w: NumericWitness|
    passed.fold(false, |b: Bool, ws: List<NumericWitness>| b || ws == [w]);
  assert(passes(ParamWitness(b"a")));
  assert(passes(ParamWitness(b"b")));
  assert(passes(ConcreteWitness(b"U8")));
  assert_eq(check_codes(cycle(b"")), [b"E0201"])
}

test "a unit pattern covers its type" {
  assert_eq(scheme_of(b"fn f(u: Unit) -> Int = match u { () -> 1 }", b"m.f"), b"(Unit) -> Int")
}

test "a numeric constraint is rejected where no call could pass its type" {
  assert_eq(check_codes(b"fn twice<a>(x: a) -> a where numeric(a) = x + x"), []);
  let phantom = source_diagnostics(b"fn f<a>(n: Int) -> Int where numeric(a) = n");
  assert_eq(phantom.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0310"]);
  assert_eq(phantom.map(|diagnostic: Diagnostic| diagnostic.message), [
    b"`a` appears in no parameter or result of `f`",
  ]);
  assert_eq(
    check_codes(b"fn twice<a>(x: a) -> a where numeric(a) = x + x\nfn g() -> (Int) -> Int = twice"),
    [b"E0310"],
  );
  assert_eq(
    check_codes(
      b"fn d<a>(x: a, n: Int) -> a / {diverges} where numeric(a) = if n <= 0 { x } else { let f = d; f(x, n - 1) }",
    ),
    [b"E0310"],
  );
  assert_eq(
    check_codes(
      Bytes::concat_all([
        b"fn ping<b>(n: Int) -> b where numeric(b) =\n",
        b"  if n <= 0 { numeric_of_int(0) } else { let _ = pong(n - 1); numeric_of_int(1) }\n",
        b"fn pong(n: Int) -> Int = { let _ = ping(n); n }",
      ]),
    ),
    [b"E0210"],
  )
}

test "a definition's witnesses take its scheme's order, which its calls pass them in" {
  let checker = checked_context(
    Bytes::concat_all([
      b"fn mixed<a, b>(x: a, y: b) -> a where numeric(b), numeric(a) = x\n",
      b"fn deep<a>(x: a, n: Int) -> a where numeric(a) = if n == 0 { x } else { deep(x, n - 1) }\n",
      b"fn go() -> U8 = mixed(1u8, 2.5)",
    ]),
  );
  assert_eq(checker.witness_orders.map(|o: WitnessOrder| { name: o.name, params: o.params }), [
    { name: b"mixed", params: [b"a", b"b"] },
    { name: b"deep", params: [b"a"] },
  ]);
  let passed = passed_numeric_witnesses(checker);
  assert_eq(passed.len(), 2);
  assert(
    passed.fold(false, |b: Bool, ws: List<NumericWitness>|
      b || ws == [ConcreteWitness(b"U8"), ConcreteWitness(b"Float")]),
  );
  assert(passed.fold(false, |b: Bool, ws: List<NumericWitness>| b || ws == [ParamWitness(b"a")]))
}

fn passed_numeric_witnesses(checker: Checker) -> List<List<NumericWitness>> / {abort.raise} =
  resolved_bodies(checker).filter(|b: TypedBody<Type>| b.module == 0).flat_map(
    |b: TypedBody<Type>|
      typed_expression_nodes(b.body).fold(
        [],
        |acc: List<List<NumericWitness>>, e: TypedExpression<Type>|
          match e.node {
            TypedRead(ReadDefinition(d)) -> if d.witnesses.len() == 0 { acc }
            else { acc.push(d.witnesses) },
            _ -> acc,
          },
      ),
  )

fn checked_context(src: Bytes) -> Checker / {abort.raise} = {
  let r = parse(src);
  let x = expand(r.node, r.parser.diagnostics);
  let d: Expansion = expand_derives(0, b"m", x.module);
  match resolve_modules([{ name: b"m", module: d.module, derived: d.derived }]) {
    ResolveFailed(_) -> panic("a source the test wrote does not resolve"),
    ResolveSucceeded(y) -> check_program(y.resolution, y.modules).checker,
  }
}

fn with_io_effect(body: Bytes) -> Bytes =
  b"effect io {\n  write open(n: Int) -> Int\n  write close(h: Int) -> Unit\n  write pull(h: Int) -> Int\n}\n".concat(
    body,
  )

test "a scoped value is read inside its scope, whose effects are its acquire's, its release's and its body's" {
  assert_eq(
    check_codes(
      with_io_effect(
        b"fn f() -> Int / {io.open, io.close, io.pull} = with_scope[file](io.open(1), |h: Int| io.close(h)) { h -> io.pull(h.get()) }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      with_io_effect(
        b"fn f() -> Int / {io.open, io.pull} = with_scope[file](io.open(1), |h: Int| io.close(h)) { h -> io.pull(h.get()) }",
      ),
    ),
    [b"E0302"],
  );
  assert_eq(
    check_codes(b"fn f() -> Int = with_scope[file](1, |h: String| ()) { h -> h.get() }"),
    [b"E0201"],
  );
  assert_eq(check_codes(b"fn f() -> Int = with_scope[file](1, |h: Int| h) { h -> h.get() }"), [
    b"E0201",
  ])
}

test "a function passed a scoped value reads it under its scope's label, which the scope handles" {
  let peek = b"fn peek<[r]>(h: Scoped<Int, [r]>) -> Int / {scoped.read[r]} = h.get()\n";
  assert_eq(
    check_codes(
      peek.concat(b"fn f() -> Int = with_scope[file](1, |x: Int| ()) { h -> peek(h) + peek(h) }"),
    ),
    [],
  );
  assert_eq(check_codes(b"fn peek<[r]>(h: Scoped<Int, [r]>) -> Int = h.get()"), [b"E0302"]);
  assert_eq(check_codes(b"fn kept(h: Scoped<Int>) -> Int = 0"), [b"E0202"]);
  assert_eq(
    rejections(
      b"fn f() -> Int = { let k = with_scope[outer](41, |x: Int| ()) { h -> || with_scope[inner](1, |x: Int| ()) { g -> h.get() + g.get() } }; 0 }",
    ),
    [
      [
        b"E0446",
        b"a scoped value escapes its `with_scope[outer]` scope",
        b"|| with_scope[inner](1, |x: Int| ()) { g -> h.get() + g.get() }",
      ],
    ],
  );
  assert_eq(check_codes(b"fn f() -> Unit / {scoped.read} = scoped.read()"), [b"E0103"]);
  assert_eq(check_codes(b"effect scoped { read get() -> Int }"), [b"E0105"])
}

test "the labels a call writes fill those that name no scope, and the scoped value passed fills the one that does" {
  let with_note_effect = b"effect log { write say[l](n: Int) -> Unit }\nfn noted<[l], [r]>(h: Scoped<Int, [r]>) -> Unit / {log.write[l], scoped.read[r]} = log.say[l](h.get())\n";
  let inside = |call: Bytes|
    Bytes::concat_all([
      with_note_effect,
      b"fn f() -> Unit / {log.write[out]} = with_scope[file](1, |x: Int| ()) { h -> ",
      call,
      b" }",
    ]);
  assert_eq(check_codes(inside(b"noted[out](h)")), []);
  assert(
    rejected_with(
      inside(b"noted[out, file](h)"),
      b"E0306",
      b"`noted` takes 1 label parameter, but 2 are written",
    ),
  );
  assert(
    rejected_with(inside(b"noted(h)"), b"E0306", b"this call leaves a label of `noted` unfilled"),
  );
  let peek = b"fn peek<[r]>(h: Scoped<Int, [r]>) -> Int / {scoped.read[r]} = h.get()\n";
  assert(
    rejected_with(
      peek.concat(b"fn f() -> Int = with_scope[file](1, |x: Int| ()) { h -> peek[file](h) }"),
      b"E0306",
      b"`peek` takes no label a call writes",
    ),
  );
  let through = b"fn through<[l], [r] | e>(k: () -> Int / {scoped.read[r] | e}) -> Unit / {log.write[l], scoped.read[r] | e} = log.say[l](k())\n";
  assert_eq(
    check_codes(
      Bytes::concat_all([
        with_note_effect,
        through,
        b"fn f() -> Unit / {log.write[out]} = with_scope[file](1, |x: Int| ()) { h -> through[out](|| h.get()) }",
      ]),
    ),
    [],
  )
}

test "a scoped value that leaves its scope is rejected where it leaves" {
  assert_eq(
    rejections(b"fn f() -> Int = { let k = with_scope[r](1, |x: Int| ()) { h -> h }; 0 }"),
    [[b"E0446", b"a scoped value escapes its `with_scope[r]` scope", b"h"]],
  );
  assert_eq(
    rejections(b"fn f() -> Int = { let k = with_scope[r](1, |x: Int| ()) { h -> || h.get() }; 0 }"),
    [[b"E0446", b"a scoped value escapes its `with_scope[r]` scope", b"|| h.get()"]],
  );
  assert_eq(
    check_codes(
      b"fn later<[l]>(h: Scoped<Int, [l]>) -> () -> Int / {scoped.read[l]} = || h.get()\nfn f() -> Int = { let k = with_scope[r](1, |x: Int| ()) { h -> later(h) }; 0 }",
    ),
    [b"E0446"],
  );
  assert_eq(check_codes(b"fn later<[l]>(h: Scoped<Int, [l]>) -> () -> Int = || h.get()"), [
    b"E0302",
  ])
}

test "a scoped value passed to an operation, or to a task its scope's scheduler outlives, is rejected" {
  assert_eq(
    check_codes(
      b"effect box { write put<a>(x: a) -> Unit }\nfn f() -> Unit / {box.put} = with_scope[r](1, |x: Int| ()) { h -> box.put(h) }",
    ),
    [b"E0446"],
  );
  assert_eq(
    check_codes(
      b"fn f() -> Int / {task.spawn} = with_scope[r](1, |x: Int| ()) { h -> { let t = task.spawn(|| h.get()); 0 } }",
    ),
    [b"E0446"],
  );
  assert_eq(
    check_codes(
      b"fn f() -> Int / {sim.read, abort.raise} = with_scope[r](1, |x: Int| ()) { h -> simulate { task.join(task.spawn(|| h.get())) } }",
    ),
    [],
  );
  assert(
    rejected_with(
      b"fn f() -> Int / {sim.read, abort.raise} = simulate { with_scope[r](1, |x: Int| ()) { h -> { let t = task.spawn(|| h.get()); task.join(t) } } }",
      b"E0446",
      b"sent to another task",
    ),
  );
  assert_eq(
    check_codes(
      b"fn f() -> Int / {sim.read, abort.raise} = simulate { with_scope[r](1, |x: Int| ()) { h -> { let t = task.spawn(|| 1); h.get() + task.join(t) } } }",
    ),
    [],
  )
}

test "a scoped value's scope is its own: it reuses no name that is open" {
  let nested = |outer: Bytes, inner: Bytes|
    check_codes(
      Bytes::concat_all([b"fn f() -> Int = ", outer, b" { a -> ", inner, b" { b -> 0 } }"]),
    );
  assert_eq(nested(b"with_scope[r](1, |x: Int| ())", b"with_scope[r](2, |x: Int| ())"), [b"E0330"]);
  assert_eq(nested(b"with_scope[r](1, |x: Int| ())", b"with_scope[s](2, |x: Int| ())"), [])
}

test "a scope's label is its own: effects another definition writes name no scope" {
  let wrap = b"fn wrap(k: () -> Int / {scoped.read[work]}) -> () -> Int = || with_scope[work](0, |x: Int| ()) { d -> d.get() + k() }\n";
  let leak = b"fn leak() -> Int = with_scope[work](41, |x: Int| ()) { c -> wrap(|| c.get()) }";
  assert(check_codes(wrap).contains(b"E0302"));
  let asked = b"fn wrap(k: () -> Int / {scoped.read[work]}) -> Int = 0\n".concat(leak);
  assert_eq(
    source_diagnostics(asked).filter(|diagnostic: Diagnostic| diagnostic.code == b"E0302").map(
      |diagnostic: Diagnostic| diagnostic.notes_text.at(1),
    ),
    [
      Some(
        b"one `work` is the scope `with_scope[work]` opens and the other is the resource of that name, which is all effects written outside the scope name",
      ),
    ],
  );
  let generic = Bytes::concat_all([
    b"fn each<| e>(k: () -> Int / e) -> Int / e = with_scope[work](0, |x: Int| ()) { d -> d.get() + k() }\n",
    b"fn held() -> Int = with_scope[work](41, |x: Int| ()) { c -> each(|| c.get()) }",
  ]);
  assert_eq(check_codes(generic), []);
  assert_eq(
    check_codes(
      b"fn f() -> Int = with_scope[a](40, |x: Int| ()) { h -> { let k = with_scope[b](2, |x: Int| ()) { g -> { let n = g.get(); || h.get() + n } }; k() } }",
    ),
    [],
  );
  let other = Bytes::concat_all([
    b"effect tally { write note[r](n: Int) -> Unit }\n",
    b"fn noted(n: Int) -> Unit / {tally.write[log]} = tally.note[log](n)\n",
    b"fn held(n: Int) -> Int = with_scope[log](0, |x: Int| ()) { c -> handle { noted(n); c.get() } with { tally.note[log](what) -> () } }",
  ]);
  assert_eq(check_codes(other), [])
}

test "a declaration that mentions a `Scoped`, or a function that reads one, is rejected" {
  assert_eq(rejections(b"type Kept<[r]> = Kept(Scoped<Int, [r]>)"), [
    [b"E0446", b"`Kept`'s field 1 mentions a `Scoped`", b"Scoped<Int, [r]>"],
  ]);
  assert_eq(check_codes(b"effect io { write put[r](h: Scoped<Int, [r]>) -> Unit }"), [b"E0446"]);
  assert_eq(check_codes(b"type Hidden<[r]> = Hidden(() -> Int / {scoped.read[r]})"), [b"E0446"])
}

test "a constructor does not launder a scoped value inside the closure it holds" {
  let diagnostics = source_diagnostics(
    b"type Boxed = Empty | Wrap(() -> Int)\nfn boxed() -> Boxed = with_scope[log](41, |x: Int| ()) { c -> Wrap(|| c.get()) }\n",
  );
  match diagnostics.filter(|diagnostic: Diagnostic| diagnostic.code == b"E0302") {
    [] -> panic("the constructor's own effects check rejects it"),
    [d, ..] ->
      assert(
        d.message.index_of(b"log") != None
          || d.notes_text.filter(|n: Bytes| n.index_of(b"log") != None).len() > 0,
        Some(String::of_bytes_lossy(d.message)),
      ),
  }
}

test "a law cannot quantify over a record that reaches a scope" {
  assert(
    check_codes(b"law \"no\" forall (r: {h: Scoped<Int, [x]>}) { true }\n").contains(b"E0418"),
    None,
  )
}

test "a secret of bytes is no more ordered, keyed or digested than one of a string" {
  [
    b"fn f(a: Secret<Bytes>, b: Secret<Bytes>) -> Ordering = compare(a, b)\n",
    b"fn f(m: Map<Secret<Bytes>, Int>) -> Int = m.len()\n",
    b"fn f(s: Secret<Bytes>) -> Bytes = digest(s)\n",
  ].fold((), |u: Unit, src: Bytes|
    assert(check_codes(src).contains(b"E0206"), Some(String::of_bytes_lossy(src))))
}

fn displaying() -> Source =
  { name: b"std.show", src: b"pub fn display<a>(x: a) -> String where derivable(show, a) = \"\"\n" }

test "a secret of bytes or of a string is not interpolated" {
  [b"Secret<Bytes>", b"Secret<String>"].fold((), |u: Unit, t: Bytes| {
    let src = Bytes::concat_all([b"fn f(s: ", t, b") -> String = f\"{s}\"\n"]);
    assert(
      codes_across([displaying(), { name: b"m", src: src }]).contains(b"E0206"),
      Some(String::of_bytes_lossy(src)),
    )
  })
}

test "a secret is no text, so a constructor of text rejects one" {
  let diagnostics = source_diagnostics(
    b"type Field = | FText(String)\nfn login(password: Secret<String>) -> Field = FText(password)\n",
  );
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0201"]);
  assert(told(diagnostics).contains("Secret<String>"), Some(told(diagnostics)))
}

fn told(diagnostics: List<Diagnostic>) -> String =
  match diagnostics {
    [] -> "",
    [diagnostic, ..] ->
      String::of_bytes_lossy(
        Bytes::join(
          [diagnostic.message].concat(diagnostic.labels.map(|label: Label| label.text)).concat(
            diagnostic.notes_text,
          ),
          b" ",
        ),
      ),
  }

test "a record with an opaque record's field is no value of it, and only its module builds one" {
  let uuid = {
    name: b"std.uuid",
    src: b"pub opaque type Uuid = new { octets: Bytes }\npub fn uuid_of_octets(octets: Bytes) -> Option<Uuid> = Some({ octets: octets })\npub fn uuid_render(u: Uuid) -> String = \"\"\n",
  };
  let rendering = |annotation: Bytes|
    {
      name: b"app",
      src: Bytes::concat_all([
        b"import std.uuid (Uuid, uuid_render)\npub fn shown(b: Bytes) -> String = {\n  let u",
        annotation,
        b" = { octets: b };\n  uuid_render(u)\n}\n",
      ]),
    };
  let closed = errors_across([uuid, rendering(b": Uuid")]);
  assert_eq(closed.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0220"]);
  assert(told(closed).contains("uuid_of_octets"), Some(told(closed)));
  let plain = errors_across([uuid, rendering(b"")]);
  assert_eq(plain.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0201"]);
  assert(told(plain).contains("std.uuid.Uuid"), Some(told(plain)));
  assert_eq(
    codes_across([
      uuid,
      {
        name: b"app",
        src: b"import std.uuid (uuid_of_octets, uuid_render)\npub fn shown(b: Bytes) -> Option<String> =\n  match uuid_of_octets(b) { Some(u) -> Some(uuid_render(u)), None -> None }\n",
      },
    ]),
    [],
  )
}

test "a clause may not handle a polymorphic operation with a type of its choosing" {
  let laundering = source_diagnostics(
    b"effect vault { read fetch[k]<a>(s: Secret<String>) -> a }\nfn launder(s: Secret<String>) -> String / {vault.read[k]} = vault.fetch[k](s)\ntest \"launder\" {\n  handle {\n    assert_eq(launder(Secret::of_string(\"hunter2\")).len(), 7)\n  } with {\n    vault.fetch[k](s) -> s,\n  }\n}\n",
  );
  assert(
    laundering.filter(|diagnostic: Diagnostic|
        diagnostic.code == b"E0201"
          && diagnostic.notes_text.filter(|n: Bytes|
            n.index_of(b"every type a perform site could ask for") != None).len(
          )
          > 0).len(
      )
      > 0,
    Some("the mismatch says why a clause cannot pick"),
  );
  assert(
    check_codes(
      b"effect box { read take[k]<a>() -> a }\nfn as_string() -> String / {box.read[k]} = box.take[k]()\ntest \"confuse\" {\n  handle {\n    assert_eq(as_string().len(), 1)\n  } with {\n    box.take[k]() -> 7,\n  }\n}\n",
    ).contains(
      b"E0201",
    ),
    Some("a wrong type"),
  )
}

fn rejected_with(src: Bytes, code: Bytes, said: Bytes) -> Bool / {abort.raise} =
  source_diagnostics(src).filter(|diagnostic: Diagnostic|
      diagnostic.code == code && diagnostic.message.index_of(said) != None).len(
    )
    > 0

test "every carrier of a scoped value out of its scope is rejected before it can dangle" {
  [
    b"[c]",
    b"Map::new().insert(1, c)",
    b"{held: c}",
    b"B(c)",
    b"[{held: [c]}]",
    b"|| c.get()",
    b"{get: || c.get(), twice: || c.get() * 2}",
  ].fold((), |u: Unit, body: Bytes| {
    let src = Bytes::concat_all([
      b"type Box<a> = | B(a)\nfn leak() = with_scope[k](0, |x: Int| ()) { c -> ",
      body,
      b" }\n",
    ]);
    assert(
      rejected_with(src, b"E0446", b"a scoped value escapes its `with_scope[k]` scope"),
      Some(String::of_bytes_lossy(src)),
    )
  })
}

test "a scope in a law's body reports its escape" {
  assert(
    rejected_with(
      b"law \"leak\" forall (n: Int) { with_scope[r](n, |x: Int| ()) { c -> || c.get() }() == 0 }\n",
      b"E0446",
      b"escapes its `with_scope[r]` scope",
    ),
    None,
  )
}

test "a specification can never perform, so it never reaches the host" {
  let net = b"nondet effect net {\n  write send[s](payload: Int) -> Int\n}\n";
  assert(
    check_codes(
      net.concat(b"law \"sends agree\" forall (n: Int) {\n  net.send[socket](n) == n\n}\n"),
    ).contains(
      b"E0417",
    ),
    Some("a law"),
  );
  assert(
    check_codes(
      net.concat(
        b"fn relay(n: Int) -> Int / {net.write[socket]}\n  ensures result == net.send[socket](n)\n= net.send[socket](n)\n",
      ),
    ).contains(
      b"E0417",
    ),
    Some("an ensures clause"),
  )
}

test "a bracket's closures run as one, so a body generic over its effects admits the release's" {
  let effect_io = b"effect io { write close(h: Int) -> Unit }\n";
  assert_eq(
    check_codes(
      effect_io.concat(
        b"fn served<| e>(h: Int, app: () -> Unit / e) -> Unit / {io.close | e} = bracket(|| h, |x: Int| io.close(x), |x: Int| app())",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      effect_io.concat(
        b"fn served<| e>(h: Int, app: () -> Unit / e) -> Unit / e = bracket(|| h, |x: Int| io.close(x), |x: Int| app())",
      ),
    ),
    [b"E0302"],
  )
}

fn source_diagnostics(src: Bytes) -> List<Diagnostic> / {abort.raise} =
  module_diagnostics(b"m", src)

fn module_diagnostics(name: Bytes, src: Bytes) -> List<Diagnostic> / {abort.raise} = {
  let r = parse(src);
  let x = expand(r.node, r.parser.diagnostics);
  let d: Expansion = expand_derives(0, name, x.module);
  match resolve_modules([{ name: name, module: d.module, derived: d.derived }]) {
    ResolveFailed(ds) -> ds,
    ResolveSucceeded(y) ->
      dedup_diagnostics(check_program(y.resolution, y.modules).checker.diagnostics),
  }
}

fn check_codes(src: Bytes) -> List<Bytes> / {abort.raise} =
  source_diagnostics(src).map(|diagnostic: Diagnostic| diagnostic.code)

test "a declared type is closed: a label in it is its own parameter or a resource, never a user's binder" {
  let uses = |declaration: Bytes, t: Bytes|
    Bytes::concat_all([
      b"effect net { write send[r](Bytes) -> Unit }\n",
      declaration,
      b"\npub fn plain(f: ",
      t,
      b") -> Int = 1\npub fn relay<[l]>(f: ",
      t,
      b") -> Int = 1",
    ]);
  let alias = valid_module_checker(
    uses(b"type Sender = (Bytes) -> Unit / {net.send[l]}", b"Sender"),
  );
  assert_eq(defined(alias, b"m.plain"), {
    scheme: b"((Bytes) -> Unit / {m.net.send[l]}) -> Int",
    effects: b"",
    performed: b"",
  });
  assert_eq(defined(alias, b"m.relay"), {
    scheme: b"<[m]>((Bytes) -> Unit / {m.net.send[l]}) -> Int",
    effects: b"",
    performed: b"",
  });
  let own = valid_module_checker(
    uses(b"type Sender<[k]> = (Bytes) -> Unit / {net.send[k]}", b"Sender<[l]>"),
  );
  assert_eq(defined(own, b"m.plain").scheme, b"((Bytes) -> Unit / {m.net.send[l]}) -> Int");
  assert_eq(defined(own, b"m.relay").scheme, b"<[l]>((Bytes) -> Unit / {m.net.send[l]}) -> Int");
  assert_eq(check_codes(b"type Cb = () -> Unit / e\nfn run<| e>(c: Cb) -> Unit / e = c()"), [
    b"E0301",
  ])
}

test "a sum is printed with the labels and effects it is given, and its constructor binds them" {
  let c = valid_module_checker(
    b"effect net { write send[r](Bytes) -> Unit }\npub type Sink<a, [l] | e> = | Sink((a) -> Unit / {net.send[l] | e})\npub fn held<[l] | e>(s: Sink<Int, [l] | {net.send[conn] | e}>) -> Sink<Int, [l] | {net.send[conn] | e}> = s\npub fn kept(s: Sink<Int, [conn] | {}>) -> Sink<Int, [conn] | {}> = s",
  );
  assert_eq(defined(c, b"m.held"), {
    scheme: b"<[l] | e>(m.Sink<Int, [l] | {m.net.send[conn] | e}>) -> m.Sink<Int, [l] | {m.net.send[conn] | e}>",
    effects: b"",
    performed: b"",
  });
  assert_eq(defined(c, b"m.kept"), {
    scheme: b"(m.Sink<Int, [conn] | {}>) -> m.Sink<Int, [conn] | {}>",
    effects: b"",
    performed: b"",
  });
  assert_eq(
    c.constructors.filter(|ctor: ConstructorInfo| ctor.name == b"m.Sink").map(
      |ctor: ConstructorInfo| scheme_text(ctor.scheme),
    ),
    [b"<a, [l] | e>((a) -> Unit / {m.net.send[l] | e}) -> m.Sink<a, [l] | e>"],
  )
}

test "a sum's effects argument is exact, and an alias's lands in a function type a narrower one meets" {
  let net = b"effect net { write send[s](p: Bytes) -> Unit\n write recv[s](n: Int) -> Bytes }\n";
  let boxed = |made: Bytes|
    Bytes::concat_all([
      net,
      b"type Box<| e> = | Box(() -> Unit / e)\n",
      b"fn open(b: Box<| {net.write[x]}>) -> Unit / {net.write[x]} = match b { Box(f) -> f() }\n",
      b"fn go(f: keep () -> Unit / {net.send[x]}) -> Unit / {net.write[x]} = ",
      made,
    ]);
  assert_eq(check_codes(boxed(b"open(Box(f))")), [b"E0302"]);
  assert_eq(check_codes(boxed(b"{ let g: () -> Unit / {net.write[x]} = f; open(Box(g)) }")), []);
  let aliased = Bytes::concat_all([
    net,
    b"type Thunk<| e> = () -> Unit / e\n",
    b"fn open(f: Thunk<| {net.write[x]}>) -> Unit / {net.write[x]} = f()\n",
    b"fn go(f: Thunk<| {net.send[x]}>) -> Unit / {net.write[x]} = open(f)",
  ]);
  assert_eq(check_codes(aliased), []);
  let labelled = Bytes::concat_all([
    net,
    b"type Sink<[l]> = | Sink((Bytes) -> Unit / {net.send[l]})\n",
    b"fn to(s: Sink<[a]>) -> Int = 1\n",
    b"fn go(s: Sink<[b]>) -> Int = to(s)",
  ]);
  assert_eq(
    source_diagnostics(labelled).map(|diagnostic: Diagnostic|
      { code: diagnostic.code, text: diagnostic.text }),
    [{ code: b"E0201", text: b"argument type|[a]|[b]" }],
  )
}

test "a use fills as many labels and effects as its type binds, and a declaration's effect variable is its own" {
  let declarations = b"effect net { write send[s](p: Bytes) -> Unit }\ntype Box<| e> = | Box(() -> Unit / e)\ntype Sink<[l]> = | Sink(() -> Unit / {net.send[l]})\ntype Thunk<| e> = () -> Unit / e\n";
  let used = |ty: Bytes| Bytes::concat_all([declarations, b"fn f(x: ", ty, b") -> Int = 1"]);
  let messages = |ty: Bytes|
    source_diagnostics(used(ty)).map(|diagnostic: Diagnostic| diagnostic.message);
  assert_eq(messages(b"Box"), [b"`Box` takes 1 effects argument, but 0 were supplied"]);
  assert_eq(messages(b"Thunk"), [b"`Thunk` takes 1 effects argument, but 0 were supplied"]);
  assert_eq(messages(b"Box<| {}, {}>"), [b"`Box` takes 1 effects argument, but 2 were supplied"]);
  assert_eq(messages(b"Sink"), [b"`Sink` takes 1 label argument, but 0 were supplied"]);
  assert_eq(messages(b"Sink<[a, b]>"), [b"`Sink` takes 1 label argument, but 2 were supplied"]);
  assert_eq(messages(b"List<Int | {}>"), [b"`List` takes 0 effects arguments, but 1 was supplied"]);
  assert_eq(check_codes(used(b"Box<| {}, {}>")), [b"E0202"]);
  assert_eq(check_codes(used(b"Box<| {net.send[x] | e}>")), [b"E0301"]);
  assert_eq(check_codes(b"type Bad<a> = | Bad((a) -> Unit / e)"), [b"E0301"]);
  assert_eq(check_codes(b"type Bad<a, e> = | Bad((a) -> Unit / e)"), [b"E0301"]);
  assert_eq(check_codes(used(b"Box<| {net.send[x] bounded}>")), [b"E0466"])
}

test "effects a declared field writes may not reach a scope or a simulation, and effects the type is given are seen leaving" {
  let hidden = source_diagnostics(b"type Hidden = | Hidden(Int, () -> Int / {scoped.read[work]})");
  assert_eq(hidden.map(|diagnostic: Diagnostic| [diagnostic.code, diagnostic.message]), [
    [b"E0446", b"`Hidden`'s field 2 holds a function whose effects reach a `Scoped`"],
  ]);
  assert_eq(check_codes(b"type Joined<| e> = | Joined(() -> Int / {task.join | e})"), [b"E0446"]);
  assert_eq(
    rejections(b"effect keep { write put(f: () -> Int / {task.join, abort.raise}) -> Unit }"),
    [
      [
        b"E0446",
        b"`put`'s parameter 1 holds a function whose effects reach a `Task` or a `Chan`",
        b"() -> Int / {task.join, abort.raise}",
      ],
    ],
  );
  assert_eq(check_codes(b"effect keep { write put<| e>(f: () -> Int / e) -> Unit }"), []);
  assert_eq(
    check_codes(
      b"type Box<| e> = | Box(() -> Int / e)\ntype Hidden = | Hidden(Box<| {scoped.read[work]}>)",
    ),
    [b"E0446"],
  );
  let given = b"type Box<| e> = | Box(() -> Int / e)\n";
  assert_eq(
    check_codes(
      given.concat(
        b"fn leak() -> Box<| {scoped.read[work]}> = with_scope[work](7, |x: Int| ()) { c -> Box(|| c.get()) }",
      ),
    ),
    [b"E0446"],
  );
  assert_eq(
    check_codes(
      given.concat(
        b"fn kept() -> Int = with_scope[work](7, |x: Int| ()) { c -> match Box(|| c.get()) { Box(f) -> f() } }",
      ),
    ),
    [],
  )
}

test "a law does not quantify over a sum whose function performs the type's effect variable" {
  let src = |binder: Bytes|
    Bytes::concat_all([
      b"type Box<| e> = | Box(() -> Int / e)\ntype Thunk<| e> = () -> Int / e\n",
      b"effect log { write note() -> Unit }\n",
      b"law \"held\" forall (b: ",
      binder,
      b") { true }",
    ]);
  assert_eq(check_codes(src(b"Box<| {}>")), [b"E0418"]);
  assert_eq(check_codes(src(b"Box<| {log.note}>")), [b"E0418"]);
  assert_eq(check_codes(src(b"Thunk<| {log.note}>")), [b"E0418"]);
  assert_eq(check_codes(src(b"Thunk<| {}>")), [])
}

test "a `Map` key an alias leaves unordered is rejected at every signature naming the alias" {
  let src = b"type Keyed = Map<(Int) -> Int, Int>\nfn first(m: Keyed) -> Int = m.len()\nfn second(m: Keyed) -> Int = m.len()";
  let primary = |diagnostic: Diagnostic|
    diagnostic.labels.fold(b"", |acc: Bytes, label: Label|
      if label.primary { src.slice(label.start, label.end) } else { acc });
  assert_eq(source_diagnostics(src).map(primary), [b"Keyed", b"Keyed"])
}

fn fixes_of(diagnostics: List<Diagnostic>) -> List<Fix> =
  diagnostics.fold([], |acc: List<Fix>, diagnostic: Diagnostic| acc.concat(diagnostic.fixes))

fn fixed_by(src: Bytes, fix: Fix) -> Bytes / {abort.raise} = {
  let n = fix.edits.len();
  range(0, n).fold(src, |s: Bytes, i: Int| {
    let e = fix.edits.get(n - 1 - i);
    Bytes::concat_all([s.slice(0, e.start), e.text, s.slice(e.end, s.len())])
  })
}

fn rejects_a_value(form: Bytes) -> Unit / {abort.raise} = {
  let src = |body: Bytes| Bytes::concat_all([form, b" \"t\" { ", body, b" }"]);
  let start = form.len() + 7;
  assert_eq(check_codes(src(b"assert(true)")), []);
  assert_eq(check_codes(src(b"let x = 1; ()")), []);
  let valued = source_diagnostics(src(b"1"));
  assert_eq(valued.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0201"]);
  assert_eq(valued.map(|diagnostic: Diagnostic| diagnostic.message), [
    b"type mismatch: the body of test `t`",
  ]);
  assert_eq(valued.map(|diagnostic: Diagnostic| diagnostic.labels), [
    [
      {
        module: 0,
        start: start,
        end: start + 1,
        primary: true,
        text: b"expected `Unit`, found `Int`",
      },
    ],
  ]);
  assert_eq(fixes_of(valued).map(|fix: Fix| fix.title), [b"end the body with `()`"]);
  assert_eq(fixes_of(valued).map(|fix: Fix| fixed_by(src(b"1"), fix)), [src(b"1; ()")]);
  assert_eq(check_codes(src(b"1; ()")), []);
  let compared = source_diagnostics(src(b"let x = 1; x == 2"));
  assert_eq(
    compared.map(|diagnostic: Diagnostic|
      diagnostic.labels.map(|label: Label| (label.start, label.end, label.text))),
    [[(start + 11, start + 17, b"expected `Unit`, found `Bool`")]],
  );
  assert_eq(fixes_of(compared).map(|fix: Fix| fix.title), [b"wrap it in `assert`"]);
  assert_eq(fixes_of(compared).map(|fix: Fix| fixed_by(src(b"let x = 1; x == 2"), fix)), [
    src(b"let x = 1; assert(x == 2)"),
  ]);
  assert_eq(check_codes(src(b"let x = 1; assert(x == 2)")), [])
}

test "a test body is `Unit`, so one that ends on a value is rejected with a fix that makes it check" {
  rejects_a_value(b"test");
  rejects_a_value(b"test/nondet")
}

fn declaring_net_effect(rest: Bytes) -> Bytes =
  b"effect net { write send[s](payload: Bytes) -> Unit\n write recv[s](max: Int) -> Bytes\n write close[s]() -> Unit\n read peek[s]() -> Int }\n".concat(
    rest,
  )

fn rejected_at(
  src: Bytes,
  name: Bytes,
) -> List<{ code: Bytes, message: Bytes, on_name: Bool }> / {abort.raise} = {
  let start = match src.index_of(name) {
    Some(i) -> i,
    None -> panic("the source names what it is rejected for"),
  };
  source_diagnostics(src).map(|diagnostic: Diagnostic| {
    let l: Label = diagnostic.labels.get(0);
    {
      code: diagnostic.code,
      message: diagnostic.message,
      on_name: l.start == start && l.end == start + name.len(),
    }
  })
}

test "an operation naming a type nothing declares is rejected at the name" {
  let unknown = [{ code: b"E0102", message: b"unknown type `Frnt`", on_name: true }];
  assert_eq(
    rejected_at(b"effect prover { write configure(front: Frnt) -> Unit }", b"Frnt"),
    unknown,
  );
  assert_eq(rejected_at(b"effect prover { read collected() -> Frnt }", b"Frnt"), unknown);
  assert_eq(rejected_at(b"effect prover { read collected() -> List<Frnt> }", b"Frnt"), unknown)
}

test "an unknown type in an operation is the error it is in a function's signature" {
  let unlabelled = |diagnostics: List<Diagnostic>|
    diagnostics.map(|diagnostic: Diagnostic| { ..diagnostic, labels: [] });
  assert_eq(
    unlabelled(source_diagnostics(b"effect e { write put(x: Frnt) -> Unit }")),
    unlabelled(source_diagnostics(b"fn put(x: Frnt) -> Unit = ()")),
  )
}

test "an operation's type variables are the ones its own list declares" {
  assert_eq(rejected_at(b"effect box { read take[k]() -> elem }", b"elem"), [
    { code: b"E0102", message: b"unknown type variable `elem`", on_name: true },
  ]);
  assert_eq(
    check_codes(
      b"effect box { read take[k]<elem>(xs: List<elem>) -> elem }\nfn first(xs: List<Int>) -> Int / {box.read[k]} = box.take[k](xs)\nfn named(xs: List<String>) -> String / {box.read[k]} = box.take[k](xs)",
    ),
    [],
  )
}

test "a `cost` clause bounds a definition that ends and only raises, by an `Int` over its parameters" {
  assert_eq(
    check_codes(b"fn f(xs: List<Int>) -> Int cost xs.len() * (xs.len() + 1) = xs.len()"),
    [],
  );
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int / {abort.raise} cost 1 = 100 / xs.len()"), []);
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int cost xs.len() > 0 = 0"), [b"E0201"]);
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int cost result = 0"), [b"E0101"]);
  assert_eq(check_codes(b"fn f(n: Int) -> Int / {diverges} cost n = f(n + 1)"), [b"E0468"]);
  assert_eq(
    check_codes(
      b"effect tally { write bump() -> Unit }\nfn f(xs: List<Int>) -> Unit / {tally.bump} cost xs.len() = tally.bump()",
    ),
    [b"E0463"],
  );
  assert_eq(check_codes(b"fn f<| e>(g: () -> Int / e cost k) -> Int / e cost k = g()"), []);
  assert_eq(
    check_codes(b"fn f(g: (Int) -> Int cost k, xs: List<Int>) -> Int cost xs.len() * k = 0"),
    [],
  );
  assert_eq(check_codes(b"fn f(g: (Int) -> Int cost k) -> Int requires k > 0 = 0"), [b"E0101"]);
  assert_eq(check_codes(b"fn f(g: (Int) -> Int cost k) -> Int = k"), [b"E0101"]);
  assert_eq(check_codes(b"fn f(g: (Int) -> Int cost g) -> Int cost g = 0"), [b"E0105"]);
  assert_eq(check_codes(b"fn f(g: () -> Int cost k, h: () -> Int cost k) -> Int cost k = 0"), [
    b"E0105",
  ])
}

test "a space name is an `Int` a `space` clause reads, and no other clause or body" {
  assert_eq(
    check_codes(
      b"fn f(g: (Int) -> Int cost k space s, xs: List<Int>) -> Int cost xs.len() * k space xs.len() * s = 0",
    ),
    [],
  );
  assert_eq(check_codes(b"fn f(g: (Int) -> Int space s) -> Int cost s = 0"), [b"E0101"]);
  assert_eq(check_codes(b"fn f(g: (Int) -> Int cost k) -> Int space k = 0"), [b"E0101"]);
  assert_eq(check_codes(b"fn f(g: (Int) -> Int space s) -> Int = s"), [b"E0101"]);
  assert_eq(check_codes(b"fn f(g: (Int) -> Int space g) -> Int space g = 0"), [b"E0105"]);
  assert_eq(check_codes(b"fn f(g: () -> Int space s, h: () -> Int space s) -> Int space s = 0"), [
    b"E0105",
  ]);
  assert_eq(check_codes(b"fn f(g: () -> Int cost n space n) -> Int cost n space n = 0"), [])
}

test "a law binder naming a type nothing declares is rejected, and a lowercase one is a variable" {
  assert_eq(rejected_at(b"law \"l\" forall (x: Acount) { true }", b"Acount"), [
    { code: b"E0102", message: b"unknown type `Acount`", on_name: true },
  ]);
  assert_eq(check_codes(b"law \"l\" forall (x: a, y: List<a>) { true }"), [])
}

test "an instantiation is checked where it is written: what it is given, and what its schema quantifies there" {
  let over = |law: Bytes|
    b"law schema same<a>(f: (a) -> a) forall (x: a) where x == x { f(x) == x }\nfn id(n: Int) -> Int = n\nfn show(n: Int) -> String = n.to_string()\nfn held(t: Task<Int>) -> Task<Int> = t\nfn x(n: Int) -> Int = n\n".concat(
      law,
    );
  assert_eq(check_codes(over(b"law \"l\" = same(id)")), []);
  assert_eq(check_codes(over(b"law \"l\" = same(|v| v)")), []);
  assert_eq(check_codes(over(b"law \"l\" = same(x)")), []);
  assert_eq(check_codes(over(b"law \"l\" = same(show)")), [b"E0201"]);
  assert_eq(rejected_at(over(b"law \"l\" = same(held)"), b"same(held)"), [
    { code: b"E0418", message: b"`forall` cannot quantify over `x`", on_name: true },
  ]);
  assert_eq(check_codes(over(b"law \"l\" = sam(id)")).at(0), Some(b"E0101"))
}

test "a schema's guard and body are a law's: pure but for a raise, over binders a law could quantify" {
  let logged = |schema: Bytes|
    b"effect log { write emit(Bytes) -> Unit }\nfn noisy(n: Int) -> Int / {log.write} = { log.emit(b\"x\"); n }\nfn spin(n: Int) -> Int / {diverges} = spin(n + 1)\n".concat(
      schema,
    );
  let messages = |src: Bytes|
    source_diagnostics(src).map(|diagnostic: Diagnostic| diagnostic.message);
  assert_eq(
    messages(logged(b"law schema s(f: (Int) -> Int) forall (x: Int) { noisy(f(x)) == x }")),
    [b"a law schema's body cannot perform an effect"],
  );
  assert_eq(
    messages(
      logged(b"law schema s(f: (Int) -> Int) forall (x: Int) where noisy(x) > 0 { f(x) == x }"),
    ),
    [b"a `where` guard cannot perform an effect"],
  );
  assert_eq(
    check_codes(
      logged(b"law schema s(f: (Int) -> Int / {log.write}) forall (x: Int) { f(x) == x }"),
    ),
    [b"E0417"],
  );
  assert_eq(
    check_codes(
      logged(
        b"law schema s(f: (Int) -> Int / {abort.raise}) forall (x: Int) { f(x) / x == spin(x) }",
      ),
    ),
    [],
  );
  assert_eq(check_codes(b"law schema s(f: (Int) -> Int) forall (t: Task<Int>) { f(1) == 1 }"), [
    b"E0418",
  ]);
  assert_eq(messages(b"law schema s(f: (Int) -> Int) forall (x: Int) { f(x) }"), [
    b"type mismatch: a law states a proposition",
  ])
}

test "a schema's effect variable is what it is given may raise: any raise fills it, and nothing else" {
  let over = |law: Bytes|
    b"effect reader { raise rejected(at: Int) }\neffect log { write emit(Bytes) -> Unit }\nlaw schema settles<a | e>(f: (a) -> a / e) forall (x: a) { f(f(x)) == f(x) }\nfn digit(n: Int) -> Int / {reader.rejected} = if n < 0 { reader.rejected(n) } else { n % 10 }\nfn half(n: Int) -> Int / {abort.raise} = 10 / n\nfn noisy(n: Int) -> Int / {log.emit} = { log.emit(b\"x\"); n }\nfn clamp(n: Int) -> Int = if n > 9 { 9 } else { n }\n".concat(
      law,
    );
  assert_eq(check_codes(over(b"law \"l\" = settles(clamp)")), []);
  assert_eq(check_codes(over(b"law \"l\" = settles(half)")), []);
  assert_eq(check_codes(over(b"law \"l\" = settles(digit)")), []);
  assert_eq(rejected_at(over(b"law \"l\" = settles(noisy)"), b"settles(noisy)"), [
    { code: b"E0417", message: b"a law body cannot perform an effect", on_name: true },
  ]);
  let fixed = |law: Bytes|
    over(
      b"law schema reads(f: (Int) -> Int / {reader.rejected}) forall (x: Int) { f(x) == f(x) }\n".concat(
        law,
      ),
    );
  assert_eq(check_codes(fixed(b"law \"l\" = reads(digit)")), []);
  assert_eq(check_codes(fixed(b"law \"l\" = reads(half)")), [b"E0302"]);
  assert_eq(
    check_codes(
      b"law schema fixed<a | e>(unit: a) forall (x: a) where x == unit { x == unit }\nlaw \"l\" = fixed(0)",
    ),
    [],
  )
}

test "an instantiation's binder resolves to the `new` record the functions it is given take" {
  let src = b"type Sign = new { negative: Bool }\ntype Bare = { negative: Bool }\nfn shown(s: Sign) -> String = if s.negative { \"-\" } else { \"+\" }\nfn read(t: String) -> Option<Sign> = if t == \"-\" { Some({ negative: true }) } else { Some({ negative: false }) }\nfn plain(t: String) -> Option<Bare> = Some({ negative: t == \"-\" })\nlaw schema reads_back<a>(f: (a) -> String, g: (String) -> Option<a>) forall (x: a) { g(f(x)) == Some(x) }\n";
  let c = checked_context(src.concat(b"law \"l\" = reads_back(shown, read)"));
  assert_eq(c.diagnostics, []);
  assert_eq(
    c.laws.map(|l: LawInfo|
      l.binders.map(|b: LawBinder| match b.ty { NominalType(n) -> n.name, _ -> b"" })),
    [[b"m.Sign"]],
  );
  assert_eq(check_codes(src.concat(b"law \"l\" = reads_back(shown, plain)")), [b"E0201"])
}

fn variables_of(ty: Type) -> List<Int> =
  match ty {
    VariableType(v) -> [v],
    NamedType(c) ->
      c.args.fold([], |acc: List<Int>, a: Type|
        acc.concat(variables_of(a).filter(|v: Int| !acc.contains(v)))),
    _ -> [],
  }

test "a law carries the variables its `where identity(a)` names, as its binders' types hold them" {
  let c = checked_context(
    b"law \"l\" forall (xs: List<a>, y: b) where identity(a), xs.len() > 0 { xs == xs }\n",
  );
  assert_eq(c.diagnostics, []);
  let law = c.laws.get(0);
  assert_eq(law.identities, variables_of(law.binders.get(0).ty));
  assert(
    law.identities.len() == 1
      && !law.identities.contains(variables_of(law.binders.get(1).ty).get(0)),
  );
  assert_eq(
    checked_context(b"law \"l\" forall (x: a) { x == x }\n").laws.map(|l: LawInfo| l.identities),
    [[]],
  )
}

test "an instantiation resolves a type parameter its schema constrains `identity` only to a type whose `==` is" {
  let over = |law: Bytes|
    b"law schema twice<a>(f: (a) -> a) forall (x: a) where identity(a) { f(f(x)) == x }\ntype N = | N(Int)\nfn k(n: N) -> Int = 0\nkey for N by k\nfn neg(n: Int) -> Int = 0 - n\nfn swap(p: (Int, String)) -> (Int, String) = p\nfn maybe(o: Option<List<Char>>) -> Option<List<Char>> = o\nfn same<t>(x: t) -> t = x\nfn halve(x: Float) -> Float = x * 2.0\nfn scale(d: Decimal) -> Decimal = d\nfn halves(xs: List<Float>) -> List<Float> = xs\nfn keyed(n: N) -> N = n\n".concat(
      law,
    );
  assert_eq(check_codes(over(b"law \"l\" = twice(neg)")), []);
  assert_eq(check_codes(over(b"law \"l\" = twice(swap)")), []);
  assert_eq(check_codes(over(b"law \"l\" = twice(maybe)")), []);
  assert_eq(rejected_at(over(b"law \"l\" = twice(halve)"), b"twice(halve)"), [
    {
      code: b"E0479",
      message: b"the schema `twice` claims `==` is identity at `a`, and `==` at `Float` is not",
      on_name: true,
    },
  ]);
  assert_eq(check_codes(over(b"law \"l\" = twice(scale)")), [b"E0479"]);
  assert_eq(check_codes(over(b"law \"l\" = twice(halves)")), [b"E0479"]);
  assert_eq(check_codes(over(b"law \"l\" = twice(keyed)")), [b"E0479"]);
  let with_note_effect = |law: Bytes, said: Bytes|
    source_diagnostics(over(law)).any(|d: Diagnostic|
      d.notes_text.any(|n: Bytes| n.contains(said)));
  assert(with_note_effect(b"law \"l\" = twice(halve)", b"`NaN != NaN`"));
  assert(with_note_effect(b"law \"l\" = twice(halves)", b"`List<Float>` holds `Float`"));
  assert(with_note_effect(b"law \"l\" = twice(keyed)", b"`N` states a `key`"));
  let generic = checked_context(over(b"law \"l\" = twice(same)"));
  assert_eq(generic.diagnostics, []);
  let law = generic.laws.get(0);
  assert_eq(law.identities, variables_of(law.binders.get(0).ty));
  assert_eq(law.identities.len(), 1);
  let halve = b"fn halve(x: Float) -> Float = x * 2.0\nlaw \"l\" = s(halve)\n";
  let unwritten = |constrained: Bytes|
    check_codes(
      Bytes::concat_all([
        b"law schema s<t, a>(f: (a) -> a) forall (x: a) where identity(",
        constrained,
        b") { f(f(x)) == x }\n",
        halve,
      ]),
    );
  assert_eq(unwritten(b"a"), [b"E0479"]);
  assert_eq(unwritten(b"t"), [])
}

test "a handle must have a clause for every operation its body performs on an effect it handles" {
  assert_eq(
    check_codes(
      declaring_net_effect(
        b"fn f() -> Bytes = handle { net.send[c](b\"x\"); net.recv[c](4) } with { net.recv[c](n) -> b\"\" }",
      ),
    ),
    [b"E0305"],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        b"fn f() -> Bytes = handle { net.send[c](b\"x\"); net.recv[c](4) } with { net.recv[c](n) -> b\"\", net.send[c](p) -> () }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        b"fn f() -> Int / {net.write[c]} = handle { net.send[c](b\"x\"); net.peek[c]() } with { net.peek[c]() -> 1 }",
      ),
    ),
    [],
  )
}

test "the operations a called definition performs count, through any number of calls" {
  let calls = b"fn push_all(p: Bytes) -> Unit / {net.send[c]} = net.send[c](p)\nfn relay(p: Bytes) -> Unit / {net.send[c]} = push_all(p)\n";
  assert_eq(
    check_codes(
      declaring_net_effect(
        calls.concat(b"fn f() -> Unit = handle { relay(b\"x\") } with { net.recv[c](n) -> b\"\" }"),
      ),
    ),
    [b"E0305"],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        calls.concat(b"fn f() -> Unit = handle { relay(b\"x\") } with { net.send[c](p) -> () }"),
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        calls.concat(
          b"fn g() -> Unit / {net.send[c]} = relay(b\"y\")\nfn f() -> Unit = handle { g() } with { net.close[c]() -> () }",
        ),
      ),
    ),
    [b"E0305"],
  );
  let diagnostics = source_diagnostics(
    declaring_net_effect(
      calls.concat(b"fn f() -> Unit = handle { relay(b\"x\") } with { net.recv[c](n) -> b\"\" }"),
    ),
  );
  assert_eq(
    diagnostics.map(|diagnostic: Diagnostic| diagnostic.labels.map(|label: Label| label.text)),
    [
      [
        b"reaches `net.send[c]` through `relay`",
        b"handles `m.net.write[c]` here, so the operation would run past it",
      ],
    ],
  )
}

test "an operation a definition handles itself does not reach its callers' handles" {
  let src = declaring_net_effect(
    b"fn quiet() -> Unit / {net.close[c]} = { handle { net.send[c](b\"x\") } with { net.send[c](p) -> () }; net.close[c]() }\nfn f() -> Unit = handle { quiet() } with { net.close[c]() -> () }",
  );
  assert_eq(check_codes(src), [])
}

test "a handle over a function value or a lambda is judged by its type" {
  let all = b"net.send[c](p) -> (), net.recv[c](n) -> b\"\", net.close[c]() -> ()";
  assert_eq(
    check_codes(
      declaring_net_effect(
        b"fn run(f: () -> Unit / {net.write[c]}) -> Unit = handle { f() } with { net.recv[c](n) -> b\"\" }",
      ),
    ),
    [b"E0305"],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        Bytes::concat_all([
          b"fn run(f: () -> Unit / {net.write[c]}) -> Unit = handle { f() } with { ",
          all,
          b" }",
        ]),
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        b"fn run(f: () -> Unit / {net.send[c]}) -> Unit = handle { f() } with { net.send[c](p) -> () }",
      ),
    ),
    [],
  );
  let folded = b"fn f() -> Int = handle { [1, 2].fold(0, |acc: Int, x: Int| { net.send[c](b\"x\"); acc + x }) } with { ";
  assert_eq(check_codes(declaring_net_effect(folded.concat(b"net.recv[c](n) -> b\"\" }"))), [
    b"E0305",
  ]);
  assert_eq(check_codes(declaring_net_effect(folded.concat(b"net.send[c](p) -> () }"))), []);
  let diagnostics = source_diagnostics(
    declaring_net_effect(folded.concat(b"net.recv[c](n) -> b\"\" }")),
  );
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.message), [
    b"this `handle` has no clause for `net.send[c]`, which its body performs",
  ]);
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.labels.get(0).text), [
    b"performs `net.send[c]`",
  ])
}

test "a handle handles what the effects it holds come to, even where those effects are solved after it" {
  let log = b"effect log { write note(s: Int) -> Unit }\n";
  assert_eq(
    check_codes(
      log.concat(
        b"fn later() -> Int = { let run = |k| handle { k() } with { log.note(s) -> () }; run(|| { log.note(1); 5 }) }\n",
      ),
    ),
    [],
  );
  let quiet = log.concat(
    b"fn quiet<| e>(f: () -> Int / e) -> Int / e = handle { f() } with { log.note(s) -> () }\n",
  );
  assert_eq(check_codes(quiet), []);
  assert_eq(check_codes(quiet.concat(b"fn loud() -> Int = quiet(|| { log.note(1); 2 })\n")), [
    b"E0302",
  ])
}

test "a callee written with a mode effect may perform any of its operations, so every one needs a clause" {
  let calls = b"fn relay(p: Bytes) -> Unit / {net.write[c]} = net.send[c](p)\n";
  let diagnostics = source_diagnostics(
    declaring_net_effect(
      calls.concat(b"fn f() -> Unit = handle { relay(b\"x\") } with { net.send[c](p) -> () }"),
    ),
  );
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0305"]);
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.message), [
    b"this `handle` has no clause for `net.write[c]`, which its body performs",
  ]);
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.labels.get(0).text), [
    b"reaches `net.write[c]` through `relay`",
  ]);
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.notes_text), [
    [
      b"`relay` may perform any `write` operation of `net`; a clause for each of them discharges `net.write[c]`",
    ],
  ]);
  assert_eq(fixes_of(diagnostics).map(|fix: Fix| fix.title), [
    b"add a clause for `net.recv[c]`",
    b"add a clause for `net.close[c]`",
  ]);
  assert_eq(
    check_codes(
      declaring_net_effect(
        calls.concat(
          b"fn f() -> Unit = handle { relay(b\"x\") } with { net.send[c](p) -> (), net.recv[c](n) -> b\"\", net.close[c]() -> () }",
        ),
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        calls.concat(
          b"fn f() -> Unit / {net.write[c]} = handle { relay(b\"x\") } with { net.send[c](p) -> () }",
        ),
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        calls.concat(
          b"fn f() -> Int / {net.write[c]} = handle { relay(b\"x\"); 1 } with { net.peek[c]() -> 1 }",
        ),
      ),
    ),
    [],
  )
}

test "an operation the written effects keep is forwarded rather than missing" {
  assert_eq(
    check_codes(
      declaring_net_effect(
        b"fn f() -> Unit / {net.write[c]} = handle { net.send[c](b\"x\"); net.close[c]() } with { net.send[c](p) -> () }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        b"fn f() -> Unit / {net.read[c]} = handle { net.send[c](b\"x\"); net.close[c]() } with { net.send[c](p) -> () }",
      ),
    ),
    [b"E0305"],
  )
}

test "the missing clause is named as the module would write it" {
  let src = declaring_net_effect(
    b"fn f() -> Unit = handle { net.send[c](b\"x\"); net.close[c]() } with { net.recv[c](n) -> b\"\" }",
  );
  let diagnostics = source_diagnostics(src);
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.message), [
    b"this `handle` has no clause for `net.close[c]` and `net.send[c]`, which its body performs",
  ]);
  let fixes = fixes_of(diagnostics);
  assert_eq(fixes.map(|fix: Fix| fix.title), [
    b"add a clause for `net.close[c]`",
    b"add a clause for `net.send[c]`",
  ]);
  assert_eq(fixes.map(|fix: Fix| fix.edits.map(|edit: Edit| edit.text)), [
    [b", net.close[c]() -> panic(\"net.close[c] is not handled here\")"],
    [b", net.send[c](a0) -> panic(\"net.send[c] is not handled here\")"],
  ]);
  assert_eq(
    fixes.map(|fix: Fix| fix.edits.map(|edit: Edit| src.slice(edit.start - 1, edit.end))),
    [[b"\""], [b"\""]],
  )
}

test "written effects may name an operation, which permits that operation alone" {
  assert_eq(
    check_codes(declaring_net_effect(b"fn f() -> Unit / {net.send[c]} = net.send[c](b\"x\")")),
    [],
  );
  assert_eq(
    check_codes(declaring_net_effect(b"fn f() -> Bytes / {net.send[c]} = net.recv[c](4)")),
    [b"E0302"],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        b"fn f() -> Bytes / {net.write[c]} = { net.send[c](b\"x\"); net.recv[c](4) }",
      ),
    ),
    [],
  );
  assert_eq(check_codes(declaring_net_effect(b"fn f() -> Int / {net.peek[c]} = net.peek[c]()")), [
  ]);
  assert_eq(check_codes(declaring_net_effect(b"fn f() -> Unit / {net.emit[c]} = ()")), [b"E0104"])
}

test "an operation the written effects do not name is rejected by name, with the effect to add" {
  let src = declaring_net_effect(b"fn f() -> Bytes / {net.send[c]} = net.recv[c](4)");
  let diagnostics = source_diagnostics(src);
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.message), [
    b"effect not permitted by the signature of `f`: `m.net.recv[c]`",
  ]);
  assert_eq(
    diagnostics.map(|diagnostic: Diagnostic| diagnostic.labels.map(|label: Label| label.text)),
    [[b"performs `m.net.recv[c]`", b"declared effects are {m.net.send[c]}"]],
  );
  let fixes = fixes_of(diagnostics);
  assert_eq(fixes.map(|fix: Fix| fix.title), [b"add `net.recv[c]` to the effects"]);
  assert_eq(fixes.map(|fix: Fix| fix.edits.map(|edit: Edit| edit.text)), [[b", net.recv[c]"]]);
  assert_eq(
    fixes.map(|fix: Fix| fix.edits.map(|edit: Edit| src.slice(edit.start, edit.end + 1))),
    [[b"}"]],
  )
}

test "a function that writes no `/` performs nothing, and one whose body does is given its effects" {
  let src = declaring_net_effect(b"fn f() -> Bytes = net.recv[c](4)");
  let diagnostics = source_diagnostics(src);
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.message), [
    b"`f` writes no `/`, so its effects are empty, and its body performs effects",
  ]);
  let fixes = fixes_of(diagnostics);
  assert_eq(fixes.map(|fix: Fix| fix.title), [b"write the effects `/ {net.recv[c]}`"]);
  let written = declaring_net_effect(b"fn f() -> Bytes / {net.recv[c]} = net.recv[c](4)");
  assert_eq(fixes.map(|fix: Fix| fixed_by(src, fix)), [written]);
  assert_eq(check_codes(written), []);
  let forwards = b"fn apply<| e>(f: () -> Int / e) -> Int = f()";
  let forwarded = source_diagnostics(forwards);
  assert_eq(forwarded.map(|diagnostic: Diagnostic| diagnostic.message), [
    b"`apply` writes no `/`, so its effects are empty, and its body forwards effects",
  ]);
  assert_eq(fixes_of(forwarded).map(|fix: Fix| fixed_by(forwards, fix)), [
    b"fn apply<| e>(f: () -> Int / e) -> Int / e = f()",
  ])
}

test "the effects a fix writes name a set wherever they hold the whole of it" {
  let src = declaring_net_effect(
    b"effect set Io = {net.send[c], net.peek[c]}\nfn a() -> Int / {Io} = 1\nfn b() -> Int = a()\nfn c() -> Int = net.peek[c]()",
  );
  assert_eq(fixes_of(source_diagnostics(src)).map(|fix: Fix| fix.title), [
    b"write the effects `/ {Io}`",
    b"write the effects `/ {net.peek[c]}`",
  ]);
  let modes = declaring_net_effect(
    b"effect set Wire = {net.write[c], net.read[c]}\nfn a() -> Int / {Wire} = 1\nfn b() -> Int = { net.send[c](b\"x\"); a() }",
  );
  assert_eq(fixes_of(source_diagnostics(modes)).map(|fix: Fix| fix.title), [
    b"write the effects `/ {Wire}`",
  ]);
  let covered = declaring_net_effect(
    b"fn a() -> Int / {net.write[c]} = 1\nfn b() -> Int = { net.send[c](b\"x\"); a() }",
  );
  assert_eq(fixes_of(source_diagnostics(covered)).map(|fix: Fix| fix.title), [
    b"write the effects `/ {net.write[c]}`",
  ])
}

test "an effect variable nothing constrains closes on unwritten effects, and only a parameter is forwarded" {
  assert_eq(check_codes(b"fn two(x: Int) -> Int = one(x) + 1"), [b"E0101"]);
  assert_eq(check_codes(b"fn h() -> Int = { let f = |x: Int| x; f(1) }"), [])
}

test "a caller is checked against what an overrunning body performs, so one diagnostic names each function's effects" {
  let src = declaring_net_effect(
    b"fn leaf() -> Bytes = net.recv[c](4)\nfn mid() -> Bytes = leaf()\nfn top() -> Bytes / {net.recv[c]} = mid()",
  );
  let diagnostics = source_diagnostics(src);
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.message), [
    b"`leaf` writes no `/`, so its effects are empty, and its body performs effects",
    b"`mid` writes no `/`, so its effects are empty, and its body performs effects",
  ]);
  let fixes = fixes_of(diagnostics);
  let n = fixes.len();
  assert_eq(
    check_codes(range(0, n).fold(src, |s: Bytes, i: Int| fixed_by(s, fixes.get(n - 1 - i)))),
    [],
  )
}

test "a caller's mode effect covers a callee's operation effect, and not the reverse" {
  let narrow = b"fn f() -> Unit / {net.send[c]} = net.send[c](b\"x\")\n";
  let wide = b"fn f() -> Unit / {net.write[c]} = net.send[c](b\"x\")\n";
  assert_eq(
    check_codes(declaring_net_effect(narrow.concat(b"fn g() -> Unit / {net.write[c]} = f()"))),
    [],
  );
  assert_eq(
    check_codes(declaring_net_effect(narrow.concat(b"fn g() -> Unit / {net.send[c]} = f()"))),
    [],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        narrow.concat(
          b"fn g() -> Unit / {net.send[c]} = f()\nfn h() -> Unit / {net.write[c]} = g()",
        ),
      ),
    ),
    [],
  );
  let diagnostics = source_diagnostics(
    declaring_net_effect(wide.concat(b"fn g() -> Unit / {net.send[c]} = f()")),
  );
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0302"]);
  assert_eq(
    diagnostics.map(|diagnostic: Diagnostic| diagnostic.labels.map(|label: Label| label.text)),
    [
      [
        b"reaches `m.net.write[c]` through `f`, which may perform any of its operations; these effects name only `m.net.send[c]`",
        b"declared effects are {m.net.send[c]}",
      ],
    ],
  );
  assert_eq(fixes_of(diagnostics).map(|fix: Fix| fix.title), [b"add `net.write[c]` to the effects"])
}

test "a clause for an operation discharges that operation's effect" {
  let narrow = b"fn f() -> Unit / {net.send[c]} = net.send[c](b\"x\")\n";
  assert_eq(
    check_codes(
      declaring_net_effect(
        narrow.concat(b"fn g() -> Unit / {} = handle { f() } with { net.send[c](p) -> () }"),
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        narrow.concat(b"fn g() -> Unit / {} = handle { f() } with { net.recv[c](n) -> b\"\" }"),
      ),
    ),
    [b"E0305"],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        b"fn f() -> Unit / {net.send[c]} = handle { net.send[c](b\"x\"); net.close[c]() } with { net.close[c]() -> () }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        b"fn f() -> Unit / {net.close[c]} = handle { net.send[c](b\"x\"); net.close[c]() } with { net.close[c]() -> () }",
      ),
    ),
    [b"E0305"],
  )
}

test "a clause is unreachable only behind another for its own operation, which the warning names" {
  let touch = b"fn touch() -> Bytes / {net.recv[conn]} = net.recv[conn](16)\n";
  let three = source_diagnostics(
    declaring_net_effect(
      touch.concat(
        b"fn g() -> Bytes / {} = handle { touch() } with {\n  net.recv[conn](n) -> b\"\",\n  net.send[conn](p) -> (),\n  net.close[conn]() -> (),\n}\n",
      ),
    ),
  );
  assert_eq(
    three.filter(|diagnostic: Diagnostic|
      diagnostic.code == b"E0105" || diagnostic.severity == b"error"),
    [],
  );
  let twice = source_diagnostics(
    declaring_net_effect(
      touch.concat(
        b"fn g() -> Bytes / {} = handle { touch() } with {\n  net.recv[conn](n) -> b\"\",\n  net.recv[conn](n) -> b\"x\",\n}\n",
      ),
    ),
  );
  assert_eq(twice.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0105"]);
  assert(
    twice.get(0).message.index_of(b"net.recv[conn]") != None,
    Some(String::of_bytes_lossy(twice.get(0).message)),
  )
}

test "a clause for `abort.raise` returns the result of the whole `handle`, and binds no `resume`" {
  let raises = b"fn digit(b: Int) -> Int / {abort.raise} = if b >= 48 && b <= 57 { b - 48 } else { abort.raise(\"not a digit\") }\n";
  assert_eq(
    check_codes(
      raises.concat(
        b"fn digit_or(b: Int) -> Result<Int, String> / {} = handle { digit(b) } with { abort.raise(m) -> Err(m), return v -> Ok(v) }",
      ),
    ),
    [],
  );
  assert_eq(check_codes(b"fn f() -> Int / {} = handle { 1 } with { abort.raise(m) -> m }"), [
    b"E0201",
  ]);
  assert_eq(
    check_codes(
      b"fn f() -> Int / {} = handle { abort.raise(\"x\") } with { abort.raise(m) resume k -> 0 }",
    ),
    [b"E0201"],
  )
}

test "a clause reads what its continuation returns at the type the `handle`'s body returns" {
  let ask = b"effect ask { read get() -> Int }\ntype Pair = { left: Int, right: String }\n";
  assert_eq(
    check_codes(
      ask.concat(
        b"fn f(n: Int) -> Option<String> / {} = handle { if ask.get() > n { Some(\"long\") } else { None } } with { ask.get() resume k -> match k(2) { Some(s) -> Some(s.concat(\"er\")), None -> None } }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      ask.concat(
        b"fn g(n: Int) -> Pair / {} = handle { { left: ask.get() + n, right: \"r\" } } with { ask.get() resume k -> { let p = k(1); { left: p.left * 10, right: p.right } } }",
      ),
    ),
    [],
  )
}

fn raise_codes(rest: Bytes) -> List<Bytes> / {abort.raise} =
  check_codes(
    b"effect p { raise bad(n: Int) raise eof() read get() -> Int }\nfn digit(b: Int) -> Int / {p.bad} = if b < 48 { p.bad(b) } else { b - 48 }\nfn end() -> Int / {p.eof} = p.eof()\n".concat(
      rest,
    ),
  )

test "a `raise` operation is in the effects, and its clause returns the result of the whole `handle`" {
  assert_eq(raise_codes(b"fn f(b: Int) -> Int / {} = digit(b)"), [b"E0302"]);
  assert_eq(raise_codes(b"fn f(b: Int) -> Int / {p.read} = digit(b)"), [b"E0302"]);
  assert_eq(
    raise_codes(
      b"fn f(b: Int) -> Result<Int, Int> / {} = handle { digit(b) } with { p.bad(n) -> Err(n), return v -> Ok(v) }",
    ),
    [],
  );
  assert_eq(
    raise_codes(b"fn f(b: Int) -> Int / {} = handle { digit(b) } with { p.bad(n) -> \"x\" }"),
    [b"E0201"],
  );
  assert_eq(
    raise_codes(b"fn f(b: Int) -> Int / {} = handle { digit(b) } with { p.bad(n) resume k -> 0 }"),
    [b"E0201"],
  );
  assert_eq(raise_codes(b"fn f() -> String / {p.eof} = p.eof()"), [])
}

test "a clause for one raise leaves the effect's other operations in the effects" {
  assert_eq(
    raise_codes(
      b"fn f(b: Int) -> Int / {p.eof} = handle { digit(b) + end() } with { p.bad(n) -> n }",
    ),
    [],
  );
  assert_eq(
    raise_codes(
      b"fn f(b: Int) -> Int / {p.bad} = handle { digit(b) + p.get() } with { p.get() -> 1 }",
    ),
    [],
  );
  assert_eq(
    raise_codes(b"fn f(b: Int) -> Int / {} = handle { digit(b) + end() } with { p.bad(n) -> n }"),
    [b"E0302"],
  )
}

test "a `try` handles the one raise its body's effects name, as an `Err` of what it carried" {
  assert_eq(raise_codes(b"fn f(b: Int) -> Result<Int, Int> / {} = try { digit(b) }"), []);
  assert_eq(raise_codes(b"fn f() -> Result<Int, Unit> / {} = try { end() }"), []);
  assert_eq(raise_codes(b"fn f(b: Int) -> Result<Int, String> / {} = try { digit(b) }"), [
    b"E0201",
  ]);
  assert_eq(raise_codes(b"fn f() -> Result<Int, Int> / {} = try { 1 }"), [b"E0311"]);
  assert_eq(
    raise_codes(
      b"fn f(xs: List<Int>) -> Result<Int, String> / {abort.raise} = try { 1 / xs.len() }",
    ),
    [b"E0311"],
  );
  assert_eq(
    raise_codes(
      b"fn f(xs: List<Int>) -> Result<Int, String> / {} = try[abort.raise] { 1 / xs.len() }",
    ),
    [],
  );
  assert_eq(
    raise_codes(b"fn f(b: Int) -> Result<Int, Int> / {abort.raise} = try { digit(b) / b }"),
    [],
  )
}

test "a `?` inside a `handle` leaves the function with the failure it unwraps, held to what the function returns" {
  let parsed = b"fn parsed(b: Int) -> Result<Int, Int> = if b < 48 { Err(b) } else { Ok(b - 48) }\n";
  let at = |rest: Bytes| raise_codes(parsed.concat(rest));
  assert_eq(
    at(
      b"fn f(b: Int) -> Result<Int, Int> / {} = { let n = handle { parsed(b)? + p.get() } with { p.get() -> 1 }; Ok(n) }",
    ),
    [],
  );
  assert(
    at(
      b"fn f(b: Int) -> Result<Int, String> / {} = { let n = handle { parsed(b)? + p.get() } with { p.get() -> 1 }; Ok(n) }",
    ).contains(
      b"E0201",
    ),
    None,
  );
  assert_eq(
    at(
      b"fn f(b: Int) -> Result<Result<Int, Int>, Int> / {} = { let n = try { parsed(b)? + digit(b) }; Ok(n) }",
    ),
    [],
  )
}

test "a named `try` handles a raise its body's effects name, and never what an effect variable carries" {
  assert_eq(
    raise_codes(b"fn f<| e>(g: () -> Int / e) -> Result<Int, Unit> / e = try[p.eof] { g() }"),
    [b"E0311"],
  );
  assert_eq(
    raise_codes(
      b"fn f<| e>(g: () -> Int / {p.eof | e}) -> Result<Int, Unit> / e = try[p.eof] { g() }",
    ),
    [],
  );
  assert_eq(
    raise_codes(
      b"fn f() -> Result<Int, Unit> / {} = { let run = |g| try[p.eof] { g() }; run(|| end()) }",
    ),
    [],
  )
}

fn tally_codes(rest: Bytes) -> List<Bytes> / {abort.raise} =
  check_codes(
    b"effect tally { write add(n: Int) -> Unit read total() -> Int }\nfn run(xs: List<Int>) -> Int / {tally.add, tally.total} = { xs.fold((), |u: Unit, x: Int| tally.add(x)); tally.total() }\n".concat(
      rest,
    ),
  )

test "a handler's variables are typed by their first values, and a clause assigns them in its branches" {
  assert_eq(
    tally_codes(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, var big: Bool = false, tally.add(n) -> { sum = sum + n; if n > 9 { big = true } }, tally.total() -> if big { 0 } else { sum } }",
    ),
    [],
  );
  assert_eq(
    tally_codes(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, tally.add(n) -> { sum = \"no\" }, tally.total() -> sum }",
    ),
    [b"E0201"],
  );
  assert_eq(
    tally_codes(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum: Int = \"no\", tally.add(n) -> (), tally.total() -> sum }",
    ),
    [b"E0201"],
  );
  assert_eq(
    tally_codes(
      b"fn f(xs: List<Int>) -> Int / {} = handle { run(xs) } with { var sum = tally.total(), tally.add(n) -> (), tally.total() -> sum }",
    ),
    [b"E0302"],
  );
  assert_eq(
    tally_codes(
      b"fn f(n: Bool) -> Int = handle { run([]) } with { var n = 10, var m = n + 1, tally.add(k) -> (), tally.total() -> m }",
    ),
    [],
  );
  assert_eq(
    tally_codes(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var n = 0, var n = 1, tally.add(k) -> (), tally.total() -> n }",
    ),
    [b"E0105"],
  )
}

test "only a variable of the handler whose clause it is in is assigned" {
  assert(
    tally_codes(
      b"fn f(xs: List<Int>) -> Int = handle { sum = 1; run(xs) } with { var sum = 0, tally.add(n) -> (), tally.total() -> sum }",
    ).contains(
      b"E0314",
    ),
  );
  assert_eq(
    tally_codes(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var n = 0, tally.add(n) -> { n = 1 }, tally.total() -> n }",
    ),
    [b"E0314"],
  );
  assert_eq(
    tally_codes(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, tally.add(n) -> { let sum = 2; sum = n }, tally.total() -> sum }",
    ),
    [b"E0314"],
  );
  assert_eq(
    tally_codes(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, tally.add(n) -> { handle { run([n]) } with { var m = 0, tally.add(k) -> { sum = k }, tally.total() -> m }; () }, tally.total() -> sum }",
    ),
    [b"E0314"],
  );
  assert_eq(tally_codes(b"fn f(n: Int) -> Int = { n = 2; n }"), [b"E0314"])
}

test "a clause does not assign its handler's variables where what runs may run after it returns" {
  assert_eq(
    tally_codes(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, tally.add(n) -> { let g = || { sum = n }; g() }, tally.total() -> sum }",
    ),
    [b"E0315"],
  );
  assert_eq(
    tally_codes(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, tally.add(n) -> { handle { sum = n; run([n]) } with { tally.add(k) -> (), tally.total() -> 0 }; () }, tally.total() -> sum }",
    ),
    [b"E0315"],
  );
  assert_eq(
    tally_codes(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, tally.add(n) -> (), tally.total() -> sum, return x -> { sum = x; sum } }",
    ),
    [b"E0315"],
  );
  assert_eq(
    tally_codes(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, tally.add(n) -> { let g = || sum + n; sum = g() }, tally.total() -> sum }",
    ),
    [],
  )
}

test "a `try` over several raises names the one it handles, and the others stay in the effects" {
  assert_eq(raise_codes(b"fn f(b: Int) -> Result<Int, Int> / {} = try { digit(b) + end() }"), [
    b"E0312",
  ]);
  assert_eq(
    raise_codes(b"fn f(b: Int) -> Result<Int, Int> / {p.eof} = try[p.bad] { digit(b) + end() }"),
    [],
  );
  assert_eq(
    raise_codes(b"fn f(b: Int) -> Result<Int, Int> / {} = try[p.bad] { digit(b) + end() }"),
    [b"E0302"],
  );
  assert_eq(raise_codes(b"fn f() -> Result<Int, Int> / {p.get} = try[p.get] { p.get() }"), [
    b"E0313",
  ]);
  assert_eq(raise_codes(b"fn f() -> Result<Int, Int> / {} = try[p.nope] { 1 }"), [b"E0104"])
}

test "a raise is in the effects, and a clause for it discharges it" {
  assert_eq(check_codes(b"fn f() -> Int / {} = abort.raise(\"x\")"), [b"E0302"]);
  assert_eq(
    check_codes(b"fn f() -> Int / {} = handle { abort.raise(\"x\") } with { abort.raise(m) -> 0 }"),
    [],
  )
}

test "a spec may raise, and a function type that only raises can be generated" {
  assert_eq(
    check_codes(
      b"fn safe(n: Int) -> Int / {abort.raise} = if n < 0 { abort.raise(\"negative\") } else { n }\nfn f(n: Int) -> Int requires safe(n) >= 0 = n\nlaw \"applies\" forall (g: (Int) -> Int / {abort.raise}) { g(1) == g(1) }",
    ),
    [],
  )
}

test "a partial builtin, a division that may meet zero and a refutable let raise" {
  assert_eq(check_codes(b"fn f() -> Int / {} = panic(\"no\")"), [b"E0302"]);
  assert_eq(check_codes(b"fn f(b: Bytes) -> Int / {} = b.at(0)"), [b"E0302"]);
  assert_eq(check_codes(b"fn f(a: Int, b: Int) -> Int / {} = a / b"), [b"E0302"]);
  assert_eq(check_codes(b"fn f(a: Int) -> Int / {} = a % 0"), [b"E0302"]);
  assert_eq(check_codes(b"fn f(a: U8, b: U8) -> U8 / {} = a % b"), [b"E0302"]);
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int / {} = { let [x, ..] = xs; x }"), [b"E0302"]);
  assert_eq(check_codes(b"fn f(n: Int) -> U8 / {} = U8::of_int(n)"), [b"E0302"])
}

test "a narrowing of a literal its type holds does not raise, and one of any other value does" {
  assert_eq(check_codes(b"fn f() -> U8 / {} = U8::of_int(200)"), []);
  assert_eq(check_codes(b"fn f() -> I8 / {} = I8::of_int(-128)"), []);
  assert_eq(check_codes(b"fn f() -> U8 / {} = U8::of_int(300)"), [b"E0302"]);
  assert_eq(check_codes(b"fn f() -> U16 / {} = U16::of_int(-1)"), [b"E0302"]);
  assert_eq(check_codes(b"fn f<a>(x: a) -> a / {} where numeric(a) = x + numeric_of_int(1)"), []);
  assert_eq(check_codes(b"fn f<a>(x: a) -> a / {} where numeric(a) = x + numeric_of_int(128)"), [
    b"E0302",
  ])
}

fn total(bodies: List<Bytes>) -> List<Bool> / {abort.raise} =
  bodies.map(|body: Bytes|
    check_codes(
        b"fn f(b: Bytes, s: String, xs: List<Int>, a: Array<Int>, i: Int, j: Int, n: Int) -> Int / {} = ".concat(
          body,
        ),
      )
      == [])

test "an indexed read on the far side of both of its bounds does not raise" {
  assert_eq(
    total([
      b"if i < 0 || i >= b.len() { 0 } else { b.at(i) }",
      b"if i >= 0 && i < b.len() { b.at(i) } else { 0 }",
      b"if 0 <= i && i + 3 < b.len() { b.at(i) + b.at(i + 3) } else { 0 }",
      b"if i < 0 || i > b.len() - 4 { 0 } else { Int::of_u32(b.u32_le(i)) }",
      b"if 0 <= i && i < a.len() { a.get(i) } else { 0 }",
      b"if 0 <= i && i < a.len() { a.set(i, 1).len() } else { 0 }",
      b"if 0 <= i && i < xs.len() { xs.set(i, 1).len() } else { 0 }",
      b"{ let size = b.len(); if i >= 0 && i < size { b.at(i) } else { 0 } }",
      b"match i { k if k >= 0 && k < b.len() -> b.at(k), _ -> 0 }",
      b"if (0 <= i && i < b.len()) && b.at(i) == 0 { 1 } else { 0 }",
      b"if i < 0 || i >= b.len() || b.at(i) == 0 { 1 } else { 0 }",
    ]),
    [true, true, true, true, true, true, true, true, true, true, true],
  );
  assert_eq(
    total([
      b"b.at(i)",
      b"if i < b.len() { b.at(i) } else { 0 }",
      b"if i >= 0 { b.at(i) } else { 0 }",
      b"if i >= 0 && i <= b.len() { b.at(i) } else { 0 }",
      b"if i >= 0 && i < b.len() { b.at(i + 1) } else { 0 }",
      b"if i >= 0 && i < b.len() { 0 } else { b.at(i) }",
      b"if i >= 0 && i < s.len() { b.at(i) } else { 0 }",
      b"if i >= 0 || i < b.len() { b.at(i) } else { 0 }",
      b"if 0 <= i && i < a.len() { a.get(j) } else { 0 }",
      b"if 0 <= i && i < xs.len() { xs.set(i + n, 1).len() } else { 0 }",
      b"{ let ok = if i >= 0 && i < b.len() { 1 } else { 0 }; b.at(i) + ok }",
    ]),
    [false, false, false, false, false, false, false, false, false, false, false],
  )
}

test "a slice whose ends a condition holds in order and inside the value does not raise" {
  assert_eq(
    total([
      b"if i < 0 || n < 0 || i > b.len() || n > b.len() - i { 0 } else { b.slice(i, i + n).len() }",
      b"if 0 <= i && i <= j && j <= s.len() { s.slice(i, j).len() } else { 0 }",
      b"{ let size = s.len(); if size == 0 { 0 } else { s.slice(size - 1, size).len() } }",
      b"if n < 0 || n > 15 { 0 } else { \"0123456789abcdef\".slice(n, n + 1).len() }",
      b"{ let digits = b\"0123456789\"; if 0 <= n && n < 10 { digits.slice(n, n + 1).len() } else { 0 } }",
      b"if 0 <= i && i <= b.len() { b.slice(b.scan(i, b\" \", b.len()), b.len()).len() } else { 0 }",
      b"s.split(\",\").len() + b.split(b\"\\r\\n\").len()",
    ]),
    [true, true, true, true, true, true, true],
  );
  assert_eq(
    total([
      b"s.slice(i, j).len()",
      b"if 0 <= i && j <= s.len() { s.slice(i, j).len() } else { 0 }",
      b"if n < 0 || n > 16 { 0 } else { \"0123456789abcdef\".slice(n, n + 1).len() }",
      b"b.slice(b.scan(i, b\" \", b.len()), b.len()).len()",
      b"s.split(s).len()",
      b"b.split(b\"\").len()",
    ]),
    [false, false, false, false, false, false],
  )
}

test "a lambda called with each element of a range reads within the range's bounds" {
  assert_eq(
    total([
      b"range(0, b.len()).fold(0, |acc: Int, k: Int| acc + b.at(k))",
      b"range(0, b.len()).map(|k: Int| b.at(k)).len()",
      b"range(0, a.len()).filter(|k: Int| a.get(k) > 0).len()",
      b"range(0, b.len() / 4).fold(0, |acc: Int, k: Int| acc + b.at(k * 4 + 3))",
      b"range(0, min(b.len(), n)).fold(0, |acc: Int, k: Int| acc + b.at(k))",
      b"range(1, b.len()).fold(0, |acc: Int, k: Int| acc + b.at(k - 1))",
    ]),
    [true, true, true, true, true, true],
  );
  assert_eq(
    total([
      b"range(0, n).fold(0, |acc: Int, k: Int| acc + b.at(k))",
      b"range(0, b.len()).fold(0, |acc: Int, k: Int| acc + b.at(acc))",
      b"range(0, b.len() + 1).fold(0, |acc: Int, k: Int| acc + b.at(k))",
      b"range(0 - 1, b.len()).fold(0, |acc: Int, k: Int| acc + b.at(k))",
      b"range(0, b.len()).fold(0, |acc: Int, k: Int| [k + 1].fold(acc, |x: Int, k: Int| x + b.at(k)))",
      b"xs.fold(0, |acc: Int, k: Int| acc + b.at(k))",
    ]),
    [false, false, false, false, false, false],
  )
}

test "a narrowing of a value its type is shown to hold does not raise" {
  assert_eq(
    total([
      b"byte_of_int(n & 0xFF).len()",
      b"byte_of_int(n >>> 24 & 0xFF).len()",
      b"byte_of_int(n >>> 56).len()",
      b"Int::of_u16(U16::of_int(n & 0xFFFF)) + Int::of_u32(U32::of_int(n & 0xFFFF_FFFF))",
      b"if 0 <= n && n < 256 { Int::of_u8(U8::of_int(n)) } else { 0 }",
      b"if i < 0 || i >= b.len() { 0 } else { byte_of_int(b.at(i)).len() }",
      b"if 0 <= i && i < b.len() && 0 <= j && j < b.len() { byte_of_int(b.at(i) ^ b.at(j)).len() } else { 0 }",
      b"if n < 0 { 0 } else { byte_of_int(n % 256).len() + byte_of_int(128 + n % 64).len() }",
      b"if 0 <= n && n < 2048 { byte_of_int(192 + n / 64).len() } else { 0 }",
      b"Int::of_i8(I8::of_int(-128)) + byte_of_int(Int::of_u8(U8::of_int(7))).len()",
    ]),
    [true, true, true, true, true, true, true, true, true, true],
  );
  assert_eq(
    total([
      b"byte_of_int(n).len()",
      b"byte_of_int(n & 0x1FF).len()",
      b"byte_of_int(n >>> 55).len()",
      b"byte_of_int(n >> 56).len()",
      b"byte_of_int(n % 256).len()",
      b"if 0 <= n && n <= 256 { Int::of_u8(U8::of_int(n)) } else { 0 }",
      b"if 0 <= i && i < b.len() { byte_of_int(b.at(i) ^ n).len() } else { 0 }",
      b"if 0 <= n && n < 2048 { byte_of_int(225 + n / 64).len() } else { 0 }",
      b"Int::of_u64(U64::of_int(n))",
    ]),
    [false, false, false, false, false, false, false, false, false],
  )
}

test "a division by a divisor a condition holds off zero does not raise" {
  assert_eq(
    total([
      b"if n == 0 { 0 } else { i / n }",
      b"if n != 0 { i % n } else { 0 }",
      b"if n > 0 { i / n + i % n } else { 0 }",
      b"match n { 0 -> 0, _ -> i / n }",
      b"if xs.len() == 0 { 0 } else { i / xs.len() }",
      b"match xs { [] -> 0, _ -> i % xs.len() }",
      b"i / (b.len() + 1)",
      b"if 0 <= i && xs.len() > 0 { xs.set(i % xs.len(), 0).len() } else { 0 }",
      b"if i < 0 || xs.len() == 0 { 0 } else { xs.set(i % xs.len(), 0).len() }",
    ]),
    [true, true, true, true, true, true, true, true, true],
  );
  assert_eq(
    total([
      b"i / n",
      b"if i != 0 { i / n } else { 0 }",
      b"if n >= 0 { i / n } else { 0 }",
      b"match n { 1 -> 0, _ -> i / n }",
      b"i / b.len()",
      b"if xs.len() > 0 { xs.set(i % xs.len(), 0).len() } else { 0 }",
    ]),
    [false, false, false, false, false, false],
  )
}

test "a pattern that matched says what a condition would" {
  assert_eq(
    total([
      b"match xs.at(i) { Some(_) -> xs.set(i, 0).len(), None -> 0 }",
      b"match a.at(i) { Some(_) -> a.get(i), None -> 0 }",
      b"match xs { [_, _, ..] -> xs.set(1, 0).len(), _ -> 0 }",
      b"match xs { [] -> 0, _ -> xs.set(0, 0).len() }",
      b"match i >= 0 && i < b.len() { true -> b.at(i), false -> 0 }",
      b"{ let Some(_) = xs.at(i) else { 0 }; xs.set(i, 0).len() }",
    ]),
    [true, true, true, true, true, true],
  );
  assert_eq(
    total([
      b"match xs.at(i) { Some(_) -> xs.set(i + 1, 0).len(), None -> 0 }",
      b"match xs.at(i) { Some(_) -> 0, None -> xs.set(i, 0).len() }",
      b"match xs { [_, ..] -> xs.set(1, 0).len(), _ -> 0 }",
      b"match xs { [_] -> 0, _ -> xs.set(0, 0).len() }",
      b"match i >= 0 && i < b.len() { true -> 0, false -> b.at(i) }",
      b"{ let _ = { let Some(_) = xs.at(i) else { 0 }; 1 }; xs.set(i, 0).len() }",
    ]),
    [false, false, false, false, false, false],
  )
}

test "a range pattern holds an integer between its ends, and alternatives between the least and greatest" {
  assert_eq(
    total([
      b"match n { 0..=9 -> byte_of_int(n + 48).len(), _ -> 0 }",
      b"match n { b'0'..=b'9' -> \"0123456789\".slice(n - 48, n - 47).len(), _ -> 0 }",
      b"match n { b'a'..=b'f' | b'A'..=b'F' -> byte_of_int(n).len(), _ -> 0 }",
      b"match n { b'-' | b'0'..=b'9' -> 255 / n, _ -> 0 }",
      b"if i < 0 || i >= b.len() { 0 } else { match b.at(i) { b'a'..=b'z' -> byte_of_int(b.at(i) - 32).len(), _ -> 0 } }",
      b"if n < 0 { 0 } else { match n { 0..=9 -> 0, _ -> 100 / (n - 9) } }",
      b"if n > 9 { 0 } else { match n { 0..=9 -> 0, _ -> 100 / n } }",
      b"match n { 0 | 1 -> 0, _ -> 10 / n + 10 / (n - 1) }",
    ]),
    [true, true, true, true, true, true, true, true],
  );
  assert_eq(
    total([
      b"match n { 0..=9 -> byte_of_int(n + 247).len(), _ -> 0 }",
      b"match n { b'0'..=b'9' -> 0, _ -> byte_of_int(n).len() }",
      b"match n { b'a'..=b'f' | b'A'..=b'F' -> byte_of_int(n + 154).len(), _ -> 0 }",
      b"match n { 0..=9 -> 0, _ -> 100 / (n - 9) }",
      b"match n { 0 | 2 -> 0, _ -> 10 / (n - 1) }",
      b"match i { 0..=9 -> byte_of_int(n).len(), _ -> 0 }",
    ]),
    [false, false, false, false, false, false],
  )
}

test "a name bound again is not the one a condition read" {
  assert_eq(
    total([
      b"if i >= 0 && i < b.len() { let i = i + 1; b.at(i) } else { 0 }",
      b"if i >= 0 && i < b.len() { [j].map(|i: Int| b.at(i)).len() } else { 0 }",
      b"if i >= 0 && i < b.len() { match j { i -> b.at(i) } } else { 0 }",
      b"if i >= 0 && i < b.len() { let b = b\"\"; b.at(i) } else { 0 }",
      b"if i >= 0 && i < b.len() { handle { 0 } with { return i -> b.at(i) } } else { 0 }",
      b"{ let k = i; let i = j; if k >= 0 && k < b.len() { b.at(i) } else { 0 } }",
    ]),
    [false, false, false, false, false, false],
  );
  assert_eq(
    total([
      b"{ let k = i; if k >= 0 && k < b.len() { b.at(i) } else { 0 } }",
      b"{ let c = b; if i >= 0 && i < c.len() { b.at(i) } else { 0 } }",
      b"if i >= 0 && i < b.len() { let i = i; b.at(i) } else { 0 }",
    ]),
    [true, true, true],
  )
}

test "a field read through records is one value wherever it is read" {
  let over = |body: Bytes|
    check_codes(
      b"type Cursor = { src: Bytes, at: Int }\nfn f(c: Cursor, d: Cursor) -> Int / {} = ".concat(
        body,
      ),
    );
  assert_eq(over(b"if c.at >= 0 && c.at < c.src.len() { c.src.at(c.at) } else { 0 }"), []);
  assert_eq(over(b"if c.at >= 0 && c.at < c.src.len() { d.src.at(c.at) } else { 0 }"), [b"E0302"]);
  assert_eq(over(b"if c.at >= 0 && c.at < c.src.len() { c.src.at(d.at) } else { 0 }"), [b"E0302"])
}

test "what a call that can raise ensures of its result holds only after the call" {
  let unshown = |body: Bytes|
    match definition_of(
        checked_context(b"fn f(b: Bytes, i: Int, n: Int) -> Int / {abort.raise} = ".concat(body)),
        b"m.f",
      ) {
      Some(d) -> d.raises.map(|r: Raise| r.reason),
      None -> [],
    };
  assert_eq(
    unshown(
      b"if n > 0 { let stop = b.scan(i, b\" \", 0); stop } else if i >= 0 { b.slice(i, b.len()).len() } else { 0 }",
    ),
    [
      RequirementNotShown({ callee: b"Bytes::scan", needs: b"0 <= from" }),
      RequirementNotShown({ callee: b"Bytes::slice", needs: b"start <= end" }),
    ],
  );
  assert_eq(
    unshown(
      b"if i < 0 { 0 } else { let stop = b.scan(i, b\" \", 0); b.slice(i, stop).len() + b.slice(i, b.len()).len() }",
    ),
    [RequirementNotShown({ callee: b"Bytes::scan", needs: b"from <= Bytes::len(hay)" })],
  )
}

test "a body's raises are recorded with why each was kept, and a group that raises only by recursing has none" {
  let out = checked_context(
    b"fn at(b: Bytes, i: Int) -> Int / {abort.raise} = if i < b.len() { b.at(i) } else { 0 }\nfn both(b: Bytes, n: Int) -> Int / {abort.raise} = at(b, n) + at(b, 0) + 7 / n + panic(\"no\")\nfn walk(b: Bytes, i: Int) -> Int / {abort.raise} = if i < 0 || i >= b.len() { 0 } else { b.at(i) + walk(b, i + 1) }\nfn each(b: Bytes, f: (Int) -> Int / {abort.raise}) -> Int / {abort.raise} = range(0, b.len()).fold(0, |acc: Int, k: Int| acc + f(b.at(k)))\n",
  );
  let raises = |name: Bytes|
    match definition_of(out, name) { Some(d) -> d.raises.map(|r: Raise| r.reason), None -> [] };
  assert_eq(raises(b"m.at"), [RequirementNotShown({ callee: b"Bytes::at", needs: b"0 <= i" })]);
  assert_eq(raises(b"m.both"), [RaisingCall(b"m.at"), ZeroDivisor, UnguardedBuiltin(b"panic")]);
  assert_eq(raises(b"m.walk"), []);
  assert_eq(raises(b"m.each"), [RaisingFunctionValue]);
  let performed = |name: Bytes|
    match definition_of(out, name) { Some(d) -> d.performed.len(), None -> 0 - 1 };
  assert_eq(performed(b"m.walk"), 0);
  assert_eq(performed(b"m.at"), 1);
  match definition_of(out, b"m.at") {
    Some(d) -> assert_eq(d.raises.map(|r: Raise| r.span), [span_between(66, 73)]),
    None -> panic("`at` is defined"),
  }
}

test "a channel's capacity and a draw's bound raise, unless a literal or a condition holds them in range" {
  assert_eq(
    check_codes(b"fn f(n: Int) -> Int / {sim.read} = simulate { let _ = task.channel(n); 0 }"),
    [b"E0302"],
  );
  assert_eq(
    check_codes(b"fn f() -> Int / {sim.read} = simulate { let _ = task.channel(0); 0 }"),
    [],
  );
  assert_eq(check_codes(b"fn f(n: Int) -> Int / {sim.read} = simulate { random.below(n) }"), [
    b"E0302",
  ]);
  assert_eq(check_codes(b"fn f() -> Int / {sim.read} = simulate { random.below(0) }"), [b"E0302"]);
  assert_eq(check_codes(b"fn f() -> Int / {sim.read} = simulate { random.below(6) }"), []);
  assert_eq(
    check_codes(
      b"fn f(n: Int) -> Int / {sim.read} = simulate { if n > 0 { random.below(n) } else { 0 } }",
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"fn f(n: Int) -> Int / {sim.read} = simulate { if n >= 0 { random.below(n) } else { 0 } }",
    ),
    [b"E0302"],
  )
}

test "what cannot fail does not raise, and overflow is the machine's limit" {
  assert_eq(
    check_codes(b"fn f(a: Int, b: U8) -> Int / {} = a / 2 + a % -3 + Int::of_u8(b % 7u8)"),
    [],
  );
  assert_eq(check_codes(b"fn f(a: Float, b: Float) -> Float / {} = a / b"), []);
  assert_eq(check_codes(b"fn f(a: Int, b: Int) -> Int / {} = a * b + a - b"), []);
  assert_eq(check_codes(b"fn f(a: Int, n: Int) -> Int / {} = a << n"), []);
  assert_eq(check_codes(b"fn f(p: { a: Int }) -> Int / {} = { let { a } = p; a }"), []);
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Option<Int> / {} = xs.at(0)"), [])
}

test "a raise the effects admit, or a clause handles, is not an error" {
  assert_eq(check_codes(b"fn f(b: Bytes) -> Int / {abort.raise} = b.at(0)"), []);
  assert_eq(
    check_codes(
      b"fn f(b: Bytes) -> Int / {} = handle { b.at(0) } with { abort.raise(m) -> 0 - 1 }",
    ),
    [],
  )
}

test "a raise through a builtin is reported at the call, naming the builtin" {
  let diagnostics = source_diagnostics(b"fn f(b: Bytes) -> Int / {} = b.at(0)");
  assert_eq(diagnostics.map(|dg: Diagnostic| dg.code), [b"E0302"]);
  assert(
    diagnostics.get(0).labels.fold(false, |found: Bool, l: Label|
      found || l.text == b"reaches `abort.raise` through `Bytes::at`"),
  )
}

test "a callback that raises meets a parameter only where the parameter's effects admit it" {
  let caller = b"\nfn g(b: Bytes) -> Int / {abort.raise} = run(|| b.at(0))";
  assert_eq(check_codes(b"fn run(f: () -> Int) -> Int = f()".concat(caller)), [b"E0302"]);
  assert_eq(check_codes(b"fn run<| e>(f: () -> Int / e) -> Int / e = f()".concat(caller)), [])
}

test "a binder named like a definition reads the binder, so it ties no definitions into a group" {
  assert_eq(
    check_codes(
      b"fn words(xs: List<String>) -> Int / {abort.raise} = match xs { [] -> 0, [w, ..rest] -> joined([w.slice(0, 1)]).len() + words(rest) }\nfn joined(words: List<String>) -> String = List::fold(words, \"\", |acc: String, w: String| acc ++ w)",
    ),
    [],
  )
}

test "a `const fn` takes nothing, binds nothing and writes no effects" {
  assert_eq(check_codes(b"const fn table() -> List<Int> = [1, 2]"), []);
  assert_eq(check_codes(b"const fn table(n: Int) -> List<Int> = [n]"), [b"E0156"]);
  assert_eq(check_codes(b"const fn table<a>() -> List<a> = []"), [b"E0156"]);
  assert_eq(check_codes(b"const fn table() -> Int / {abort.raise} = 1"), [b"E0156"])
}

test "a `const fn` may raise, and its callers read no raise of it" {
  let halved = |head: Bytes|
    check_codes(
      Bytes::concat_all([
        head,
        b" half() -> Int = 10 / zero()\nfn zero() -> Int = 0\nfn twice() -> Int = half() + half()",
      ]),
    );
  assert_eq(halved(b"const fn"), []);
  assert_eq(halved(b"fn"), [b"E0302", b"E0302"])
}

test "a `const fn` files no place it can raise" {
  let out = checked_context(
    b"const fn third() -> Int = 10 / zero()\nfn zero() -> Int = 3\nfn plain() -> Int / {abort.raise} = 10 / zero()",
  );
  let raises = |name: Bytes|
    match definition_of(out, name) { Some(d) -> d.raises.len(), None -> 0 - 1 };
  assert_eq(raises(b"m.third"), 0);
  assert_eq(raises(b"m.plain"), 1)
}

test "a `const fn` performs nothing but a raise, and ends" {
  assert_eq(
    check_codes(
      b"effect log { write emit(Bytes) -> Unit }\nconst fn noisy() -> Int = { log.emit(b\"x\"); 1 }",
    ),
    [b"E0156"],
  );
  assert_eq(
    check_codes(
      b"fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\nconst fn never() -> Int = spin(0)",
    ),
    [b"E0156"],
  );
  assert_eq(check_codes(b"const fn never() -> Int = never()"), [b"E0156"])
}

test "a `const fn` returns a value a process can keep" {
  assert_eq(check_codes(b"const fn f() -> (Int) -> Int = |x: Int| x"), [b"E0156"]);
  assert_eq(
    check_codes(
      b"type Held = | Held((Int) -> Int)\nconst fn f() -> List<Held> = [Held(|x: Int| x)]",
    ),
    [b"E0156"],
  );
  assert_eq(check_codes(b"const fn f() -> Option<Secret<String>> = None"), [b"E0156"]);
  assert_eq(
    check_codes(
      b"type Row = { name: String, at: Int }\nconst fn rows() -> Array<Row> = Array::of_list([{ name: \"a\", at: 1 }])",
    ),
    [],
  )
}

test "a `const` is read by its name, and is no function to call" {
  assert_eq(check_codes(b"const limit: Int = 40\nfn f() -> Int = limit + 1"), []);
  assert_eq(check_codes(b"fn f() -> Int = limit + 1\nconst limit: Int = 40"), []);
  assert_eq(check_codes(b"const limit: Int = 40\nconst twice: Int = limit * 2"), []);
  assert_eq(check_codes(b"const limit: Int = 40\nfn f() -> Int = limit()"), [b"E0204"])
}

test "a parameter or a local of a `const`'s name hides it" {
  assert_eq(check_codes(b"const limit: Int = 40\nfn f(limit: Bool) -> Bool = limit"), []);
  assert_eq(check_codes(b"const limit: Int = 40\nfn f() -> Bool = { let limit = true; limit }"), [
  ]);
  assert_eq(
    check_codes(
      b"const limit: Int = 40\nfn f(xs: List<Bool>) -> List<Bool> = xs.map(|limit: Bool| limit)",
    ),
    [],
  )
}

test "a method of a `const` runs on its value, and an effect of its name stays an effect" {
  assert_eq(check_codes(b"const names: List<Int> = [1]\nfn f() -> Int = names.len()"), []);
  assert_eq(check_codes(b"type P = { x: Int }\nconst p: P = { x: 1 }\nfn f() -> Int = p.x"), []);
  assert_eq(
    check_codes(
      b"effect names { write beat() -> Unit }\nconst names: Int = 1\nfn f() -> Unit / {names.write} = names.beat()",
    ),
    [],
  )
}

test "a `const` is imported and read as a function is, through its module or by name" {
  let lib = { name: b"lib", src: b"pub const limit: Int = 40\nconst hidden: Int = 1\n" };
  assert_eq(codes_of([lib, { name: b"m", src: b"import lib (limit)\nfn f() -> Int = limit" }]), []);
  assert_eq(codes_of([lib, { name: b"m", src: b"import lib\nfn f() -> Int = lib::limit" }]), []);
  assert_eq(codes_of([lib, { name: b"m", src: b"import lib\nfn f() -> Int = lib::hidden" }]), [
    b"E0107",
  ])
}

test "a parameter's default may read a `const`, and a `pub fn`'s only one it exports" {
  assert_eq(
    check_codes(b"const limit: Int = 40\nfn f(n: Int = limit) -> Int = n\nfn g() -> Int = f()"),
    [],
  );
  assert_eq(check_codes(b"const limit: Int = 40\npub fn f(n: Int = limit) -> Int = n"), [b"E0122"]);
  let lib = {
    name: b"lib",
    src: b"pub const limit: Int = 40\npub fn f(n: Int = limit) -> Int = n\n",
  };
  assert_eq(codes_of([lib, { name: b"m", src: b"import lib (f)\nfn g() -> Int = f()" }]), [])
}

test "a `const` follows the rules of a `const fn`" {
  assert_eq(check_codes(b"const limit: Int = true"), [b"E0201"]);
  assert_eq(check_codes(b"const f: (Int) -> Int = |x: Int| x"), [b"E0156"]);
  assert_eq(check_codes(b"const never: Int = never + 1"), [b"E0156"]);
  assert_eq(
    check_codes(
      b"effect log { write emit(Bytes) -> Unit }\nconst noisy: Int = { log.emit(b\"x\"); 1 }",
    ),
    [b"E0156"],
  );
  assert_eq(
    check_codes(b"fn zero() -> Int = 0\nconst third: Int = 10 / zero()\nfn f() -> Int = third"),
    [],
  )
}

test "a body that performs more than its signature permits is rejected" {
  assert_eq(
    labelled_diagnostics(
      b"effect log { write emit(Bytes) -> Unit }\nfn quiet() -> Unit / {} = log.emit(b\"x\")",
    ),
    [[b"E0302", b"log.emit(b\"x\")", b"{}"]],
  )
}

test "a function that performs is rejected where a pure one is expected" {
  assert_eq(
    labelled_diagnostics(
      b"effect log { write emit(Bytes) -> Unit }\nfn noisy(x: Int) -> Int / { log.write } = { log.emit(b\"x\"); x }\nfn apply(f: (Int) -> Int) -> Int = f(1)\nfn go() -> Int = apply(noisy)",
    ),
    [[b"E0302", b"noisy"]],
  )
}

test "an operator over a lambda parameter nothing types is rejected" {
  assert_eq(labelled_diagnostics(b"fn f() -> Bool = { let g = |x| x + x; true }"), [
    [b"E0210", b"x + x"],
  ])
}

test "a test's effects include the effects of what it calls and the operation it performs itself" {
  let c = valid_module_checker(
    b"effect log { write emit(Bytes) -> Unit }\nfn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\ntest \"a test performs through a call\" { say(b\"x\") }\ntest \"a test performs directly\" { log.emit(b\"y\") }",
  );
  assert_eq(c.tests.map(|t: TestInfo| [t.key, effects_text(t.effects)]), [
    [b"m.a test performs through a call", b"m.log.write"],
    [b"m.a test performs directly", b"m.log.emit"],
  ])
}

test "a function parameter's types and effects generalize" {
  let c = valid_module_checker(
    b"pub fn twice<a, b>(f: (a) -> b, x: a) -> b = f(x)\npub fn each<a | e>(f: (a) -> Unit / e, xs: List<a>) -> Unit / e = xs.fold((), |acc: Unit, x: a| f(x))",
  );
  assert_eq(defined(c, b"m.twice").scheme, b"<a, b>((a) -> b, a) -> b");
  assert_eq(defined(c, b"m.each").scheme, b"<a | e>((a) -> Unit / e, List<a>) -> Unit / e")
}

fn constraints_of(c: Checker, name: Bytes) -> List<Bytes> / {abort.raise} =
  info_of(c, name).constraints.map(|d: DefinitionConstraint|
    deriver_text(d.deriver).concat(ascii_of_int(d.param)))

test "a derivable constraint is published on the type parameter it names" {
  let c = valid_module_checker(
    b"pub fn show<a>(x: a) -> Int where derivable(eq, a) = 1\npub fn keyed<k, v>(m: Map<k, v>) -> Int where derivable(ord, k) = m.len()\nfn used() -> Int = show(2) + keyed(Map::new())",
  );
  assert_eq(constraints_of(c, b"m.show"), [b"eq0"]);
  assert_eq(constraints_of(c, b"m.keyed"), [b"ord0"]);
  assert_eq(constraints_of(c, b"m.used"), []);
  assert_eq(
    constraints_of(
      valid_module_checker(b"pub fn keyed<k, v>(m: Map<k, v>) -> Int = m.len()"),
      b"m.keyed",
    ),
    [b"ord0"],
  )
}

test "an effect listed twice is published once" {
  let c = valid_module_checker(
    b"effect log { write emit(Bytes) -> Unit }\neffect audit { write note(Bytes) -> Unit }\nfn twice() -> Unit / { log.write, log.write } = log.emit(b\"x\")\nfn both() -> Unit / { audit.write, log.write, audit.write } = { log.emit(b\"x\"); audit.note(b\"y\") }",
  );
  assert_eq(defined(c, b"m.twice"), {
    scheme: b"() -> Unit / {m.log.write}",
    effects: b"m.log.write",
    performed: b"m.log.emit",
  });
  assert_eq(defined(c, b"m.both"), {
    scheme: b"() -> Unit / {m.audit.write, m.log.write}",
    effects: b"m.audit.write,m.log.write",
    performed: b"m.audit.note,m.log.emit",
  })
}

test "a program checked from its own published interfaces publishes the same thing" {
  let src = [
    {
      name: b"m",
      src: b"pub fn id<a>(x: a) -> a = x\nfn two() -> Int = id(2)\neffect log { write emit(Bytes) -> Unit }\nfn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\nfn show<a>(x: a) -> Int where derivable(eq, a) = 1\ntest \"says\" { say(b\"x\") }",
    },
  ];
  let dumps = check_dumps(src);
  assert_eq(dumps.seeded, dumps.uncached);
  assert_eq(dumps.uncached, check_dump(src))
}

test "a spec clause that reaches an effect through a call is rejected at the call" {
  assert_eq(
    labelled_diagnostics(
      b"effect log { write emit(Bytes) -> Unit }\nfn noisy() -> Bool / { log.write } = { log.emit(b\"x\"); true }\nfn f(x: Int) -> Int requires noisy() = x",
    ),
    [[b"E0417", b"noisy()", b"requires noisy()"]],
  )
}

test "functions cannot be compared and a Float cannot key a Map, judged once the module is solved" {
  assert_eq(
    labelled_diagnostics(
      b"fn keyed() -> Map<Float, Int> = Map::new()\nfn same(f: (Int) -> Int, g: (Int) -> Int) -> Bool = f == g",
    ),
    [[b"E0201", b"f == g"], [b"E0206", b"Map<Float, Int>"]],
  )
}

fn rejections(src: Bytes) -> List<List<Bytes>> / {abort.raise} =
  source_diagnostics(src).map(|diagnostic: Diagnostic|
    [
      diagnostic.code,
      diagnostic.message,
      diagnostic.labels.fold(b"", |acc: Bytes, label: Label|
        if label.primary { src.slice(label.start, label.end) } else { acc }),
    ])

fn label_rejections(src: Bytes) -> List<Bytes> / {abort.raise} =
  match resolved_all([
      { name: b"m", src: src },
      {
        name: b"std.cases",
        src: b"pub type Table<a> = List<a>\npub fn listed<a | e>(t: List<a>, l: (a) -> String / e) -> List<{ label: String, identity: Bytes }> / e where derivable(hash, a) = t.map(|c: a| { label: l(c), identity: b\"\" })\npub fn chosen<a>(t: List<a>, at: Int, d: Bytes) -> a / {abort.raise} where derivable(hash, a) = panic(\"\")\n",
      },
      { name: b"std.show", src: b"pub fn display<a>(x: a) -> String = \"\"\n" },
    ]) {
    Err(dump) -> [dump],
    Ok(x) ->
      dedup_diagnostics(check_program(x.resolution, x.modules).checker.diagnostics).filter(
        |d: Diagnostic| d.code == b"E0105",
      ).map(|d: Diagnostic| d.message),
  }

test "tests over cases may share a label with holes, but not over one table, and not with any other test" {
  let over = |label: Bytes, table: Bytes|
    Bytes::concat_all([b"test \"", label, b"\" for n: Int in ", table, b" { assert(n > 0) }\n"]);
  let plain = |label: Bytes| Bytes::concat_all([b"test \"", label, b"\" { () }\n"]);
  assert_eq(label_rejections(over(b"a {n}", b"[1]").concat(over(b"a {n}", b"[2]"))), []);
  assert_eq(label_rejections(over(b"a {n}", b"[1, 2]").concat(over(b"a {n}", b"[1,\n  2]"))), [
    b"two tests over the same table are labelled \"a {n}\"",
  ]);
  assert_eq(label_rejections(plain(b"a").concat(over(b"a", b"[1]"))), [
    b"two tests are labelled \"a\"",
  ]);
  assert_eq(label_rejections(over(b"a", b"[1]").concat(over(b"a", b"[2]"))), [
    b"two tests are labelled \"a\"",
  ]);
  assert_eq(label_rejections(plain(b"a {n}").concat(over(b"a {n}", b"[1]"))), [
    b"two tests are labelled \"a {n}\"",
  ])
}

test "a plain test, like a law, is identified by its label, so a second one with that label is rejected" {
  let prefix = b"fn one() -> Int = 1\n";
  assert_eq(
    rejections(
      prefix.concat(
        b"test \"one is one\" { assert_eq(one(), 1) }\ntest \"one is one\" { assert(one() > 0) }",
      ),
    ),
    [[b"E0105", b"two tests are labelled \"one is one\"", b"\"one is one\""]],
  );
  assert_eq(
    rejections(
      prefix.concat(
        b"law \"alike\" forall (n: Int) { one() + n == n + 1 }\nlaw \"alike\" forall (b: Bool) { b || !b }",
      ),
    ),
    [[b"E0105", b"two laws are labelled \"alike\"", b"\"alike\""]],
  );
  assert_eq(
    rejections(
      prefix.concat(
        b"test \"one is one\" { assert_eq(one(), 1) }\ntest \"one is positive\" { assert(one() > 0) }\nlaw \"one is one\" forall (n: Int) { one() + n == n + 1 }",
      ),
    ),
    [],
  )
}

test "a declaration that mentions a `Task` is rejected at the type that mentions it" {
  assert_eq(rejections(b"type Held = Held(Task<Int>)"), [
    [b"E0446", b"`Held`'s field 1 mentions a `Task`", b"Task<Int>"],
  ]);
  assert_eq(rejections(b"type Pool = Idle | Busy(Int, List<Task<Unit>>)"), [
    [b"E0446", b"`Busy`'s field 2 mentions a `Task`", b"List<Task<Unit>>"],
  ]);
  assert_eq(rejections(b"type Box<a> = Box(a)\ntype Held = Held(Box<Task<Int>>)"), [
    [b"E0446", b"`Held`'s field 1 mentions a `Task`", b"Box<Task<Int>>"],
  ]);
  assert_eq(rejections(b"type Pending = Task<Int>\ntype Held = Held(Pending)"), [
    [b"E0446", b"`Held`'s field 1 mentions a `Task`", b"Pending"],
  ]);
  assert_eq(
    rejections(b"effect pool { write give(t: Task<Int>) -> Unit\n write take() -> Task<Int> }"),
    [
      [b"E0446", b"`give`'s parameter 1 mentions a `Task`", b"Task<Int>"],
      [b"E0446", b"`take`'s result mentions a `Task`", b"Task<Int>"],
    ],
  )
}

test "a `Task` in a parameter or a type argument is left to the escape check" {
  assert_eq(check_codes(b"fn serve(running: List<Task<Unit>>) -> Int = running.len()"), []);
  assert_eq(
    check_codes(b"type Box<a> = Box(a)\nfn boxed(t: Task<Int>) -> Box<Task<Int>> = Box(t)"),
    [],
  );
  assert_eq(
    check_codes(
      b"type Box<a> = Box(a)\nfn spawned() -> Box<Task<Int>> / {sim.read} = simulate { Box(task.spawn(|| 1)) }",
    ),
    [b"E0413"],
  )
}

test "a closure that captured a task leaves its `simulate` block by its effects, and not otherwise" {
  assert_eq(
    rejections(
      b"fn spawned() -> () -> Int / {task.join, abort.raise} / {sim.read} = simulate { let t = task.spawn(|| 1); || task.join(t) }",
    ),
    [[b"E0413", b"a task escapes the simulation that spawned it", b"|| task.join(t)"]],
  );
  assert_eq(
    rejections(
      b"fn later() -> () -> Int / {sim.read, abort.raise} / {sim.read} = simulate { let t = task.spawn(|| 1); || simulate { task.join(t) } }",
    ),
    [
      [b"E0413", b"a task enters a simulation that did not spawn it", b"t"],
      [b"E0413", b"a task escapes the simulation that spawned it", b"|| simulate { task.join(t) }"],
    ],
  );
  assert_eq(
    check_codes(
      b"fn joined() -> Int / {sim.read, abort.raise} = simulate { let t = task.spawn(|| 1); let f = || task.join(t); f() }",
    ),
    [],
  )
}

test "a channel stays in its `simulate` block as a task does" {
  assert_eq(rejections(b"fn made() -> Chan<Int> / {sim.read} = simulate { task.channel(1) }"), [
    [b"E0413", b"a channel escapes the simulation that made it", b"task.channel(1)"],
  ]);
  assert_eq(
    rejections(
      b"fn sender() -> (Int) -> Bool / {task.send} / {sim.read} = simulate { let c = task.channel(1); |x: Int| task.send(c, x) }",
    ),
    [[b"E0413", b"a channel escapes the simulation that made it", b"|x: Int| task.send(c, x)"]],
  );
  assert_eq(
    rejections(b"fn taken(c: Chan<Int>) -> Option<Int> / {sim.read} = simulate { task.recv(c) }"),
    [[b"E0413", b"a channel enters a simulation that did not make it", b"c"]],
  );
  assert_eq(rejections(b"type Mailbox = Mailbox(Chan<Int>)"), [
    [b"E0446", b"`Mailbox`'s field 1 mentions a `Chan`", b"Chan<Int>"],
  ]);
  assert_eq(
    check_codes(
      b"fn own() -> Option<Int> / {sim.read} = simulate { let c = task.channel(1); task.send(c, 1); task.recv(c) }",
    ),
    [],
  );
  assert_eq(check_codes(b"fn keyed(m: Map<Chan<Int>, Int>) -> Int = m.len()"), [b"E0206"])
}

test "a task from outside a `simulate` block is rejected where the simulation names it or reads it" {
  assert_eq(
    rejections(
      b"fn joined(t: Task<Int>) -> Int / {sim.read, abort.raise} = simulate { task.join(t) }",
    ),
    [[b"E0413", b"a task enters a simulation that did not spawn it", b"t"]],
  );
  assert_eq(
    check_codes(
      b"fn captured(t: Task<Int>) -> Int / {sim.read, abort.raise} = simulate { let wait = || task.join(t); wait() }",
    ),
    [b"E0413"],
  );
  assert_eq(
    check_codes(
      b"fn listed(ts: List<Task<Int>>) -> Int / {sim.read, abort.raise} = simulate { ts.fold(0, |n: Int, t: Task<Int>| n + task.join(t)) }",
    ),
    [b"E0413"],
  )
}

test "a `simulate` block keeps its own tasks, a name it shadows, and a function that only takes one" {
  assert_eq(
    check_codes(
      b"fn own() -> Int / {sim.read, abort.raise} = simulate { let t = task.spawn(|| 1); task.join(t) }",
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"fn shadowed(t: Task<Int>) -> Int / {sim.read, task.join, abort.raise} = task.join(t) + simulate { let t = task.spawn(|| 1); task.join(t) }",
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"fn handed(wait: (Task<Int>) -> Int / {task.join}) -> Int / {sim.read} = simulate { wait(task.spawn(|| 1)) }",
    ),
    [],
  )
}

fn with_note_effect(body: Bytes) -> Bytes =
  b"effect note { read say() -> Int }\nfn work() -> Int / {note.read} = note.say()\n".concat(body)

test "a task reaching a younger scope's scoped value through a handler around its spawn is rejected" {
  let leak = with_note_effect(
    b"fn leak() -> Task<Int> / {task.write} = with_scope[s](5, |x: Int| ()) { c -> handle { task.spawn(|| work()) } with { note.say() -> c.get() } }",
  );
  assert_eq(rejections(leak), [
    [
      b"E0446",
      b"a value of scope `s` reaches another task through a handler around its spawn",
      b"|| work()",
    ],
  ]);
  assert_eq(
    check_codes(
      with_note_effect(
        b"fn cycle() -> Int / {sim.read, abort.raise} = simulate { with_scope[s](5, |x: Int| ()) { c -> handle { task.join(task.spawn(|| work())) } with { note.say() -> c.get() } } }",
      ),
    ),
    [b"E0446"],
  )
}

test "a handler around a spawn may handle operations with a scoped value the task cannot outlive, or for the spawner alone" {
  assert_eq(
    check_codes(
      with_note_effect(
        b"fn kept() -> Task<Int> / {task.write} = with_scope[s](5, |x: Int| ()) { c -> handle { task.spawn(|| work()) } with { note.say() -> 7 } }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      with_note_effect(
        b"fn root() -> Int / {task.write, abort.raise} = with_scope[s](5, |x: Int| ()) { c -> handle { let t = task.spawn(|| 1); note.say() + task.join(t) } with { note.say() -> c.get() } }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      with_note_effect(
        b"fn inside() -> Int / {sim.read, abort.raise} = with_scope[s](5, |x: Int| ()) { c -> simulate { handle { task.join(task.spawn(|| work())) } with { note.say() -> c.get() } } }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      with_note_effect(
        b"fn spawned(n: Int, running: List<Task<Int>>) -> List<Task<Int>> / {task.write, note.read} = if n <= 0 { running } else { spawned(n - 1, running.push(task.spawn(|| work()))) }\nfn joined(ts: List<Task<Int>>) -> Int / {task.write, abort.raise} = ts.fold(0, |n: Int, t: Task<Int>| n + task.join(t))\nfn serve() -> Int / {task.write, abort.raise} = with_scope[store](1, |x: Int| ()) { c -> handle { joined(spawned(2, [])) } with { note.say() -> c.get() } }",
      ),
    ),
    [],
  )
}

test "a call instantiating a constrained parameter with a function is rejected at the call" {
  let src = b"fn show<a>(x: a) -> String where derivable(hash, a) = \"\"\nfn bad() -> String = show(|y: Int| y)";
  assert_eq(labelled_diagnostics(src), [[b"E0206", b"show", src.slice(0, 56)]])
}

fn errors_across(
  sources: List<Source>,
  library: Option<(DeriverRequest) -> DeriverResponse / {abort.raise}> = None,
) -> List<Diagnostic> / {abort.raise} = {
  let parsed = range(0, sources.len()).map(|i: Int| {
    let s = sources.get(i);
    let r = parse(s.src);
    let x = expand(r.node, r.parser.diagnostics);
    let d: Expansion = expand_derives(i, s.name, x.module, library: library);
    { name: s.name, module: d.module, derived: d.derived, diagnostics: d.diagnostics }
  });
  let early = parsed.fold([], |acc: List<Diagnostic>, p: ExpandedSource| acc.concat(p.diagnostics));
  if early.len() > 0 { early } else {
    match resolve_modules(
        parsed.map(|p: ExpandedSource| { name: p.name, module: p.module, derived: p.derived }),
      ) {
      ResolveFailed(ds) -> ds,
      ResolveSucceeded(x) ->
        dedup_diagnostics(check_program(x.resolution, x.modules).checker.diagnostics).filter(
          |diagnostic: Diagnostic| diagnostic.severity == b"error",
        ),
    }
  }
}

fn codes_across(sources: List<Source>) -> List<Bytes> / {abort.raise} =
  errors_across(sources).map(|diagnostic: Diagnostic| diagnostic.code)

test "an effect rejected in one module rejects nothing written at the same place in another" {
  assert_eq(
    codes_across([
      { name: b"a", src: b"fn sender(f: () -> Unit / {net.send[x]}) -> Unit = f()\n" },
      { name: b"b", src: b"fn digit(b: Int) -> Int / {abort.raise} = abort.raise(\"x\")\n" },
    ]),
    [b"E0103"],
  )
}

test "a fix that braces a bare effect variable keeps its `bounded` inside the braces" {
  let src = b"fn f<| e>(g: () -> Int / e) -> Int / e bounded = g() / g()";
  let ds = source_diagnostics(src);
  assert_eq(ds.map(|dg: Diagnostic| dg.code), [b"E0302"]);
  let fixed = fixed_by(src, fixes_of(ds).get(0));
  assert(fixed.index_of(b"/ {abort.raise | e bounded} =") != None, Some(String::of_bytes(fixed)));
  assert_eq(check_codes(fixed), [])
}

test "a fix spells only what the module can name, so effects it cannot write get none" {
  let ds = errors_across([
    {
      name: b"base",
      src: b"pub effect net { write send[c](p: Bytes) -> Unit }\npub fn push() -> Unit / {net.send[c]} = net.send[c](b\"x\")\n",
    },
    {
      name: b"app",
      src: b"import base (push)\nfn run() -> Unit / {clock.read} = push()\nfn quiet() -> Unit = push()",
    },
  ]);
  assert_eq(ds.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0302", b"E0302"]);
  assert_eq(fixes_of(ds), [])
}

test "a record update takes its shape from the base's inferred type, not from where it was written" {
  let p = b"type P = { a: Int, b: Int }\nfn mk() -> P = { a: 1, b: 2 }\n";
  assert_eq(
    codes_across([{ name: b"m", src: p.concat(b"fn f() -> P = { let q = mk(); {..q, b: 3} }") }]),
    [],
  );
  assert_eq(
    codes_across([
      {
        name: b"m",
        src: p.concat(
          b"fn g(ps: List<P>) -> P = match ps.at(0) { Some(q) -> {..q, b: 3}, None -> mk() }",
        ),
      },
    ]),
    [],
  );
  assert_eq(
    codes_across([
      {
        name: b"m",
        src: p.concat(b"fn h(xs: List<Int>) -> P = xs.fold(mk(), |acc, x| {..acc, a: x})"),
      },
    ]),
    [],
  )
}

test "a record update may name a record type another module declares" {
  assert_eq(
    codes_across([
      {
        name: b"shapes",
        src: b"pub type P = { a: Int, b: Int }\npub fn mk() -> P = { a: 1, b: 2 }",
      },
      {
        name: b"m",
        src: b"import shapes\nfn f() -> shapes::P = { let q = shapes::mk(); {..q, b: 3} }",
      },
    ]),
    [],
  )
}

test "a record update is rejected where the base is not a record, or where nothing says what it is" {
  let p = b"type P = { a: Int, b: Int }\n";
  assert_eq(
    codes_across([
      { name: b"m", src: p.concat(b"fn f(n: Int) -> Int = { let q = {..n, a: 1}; 0 }") },
    ]),
    [b"E0116"],
  );
  assert_eq(
    codes_across([
      { name: b"m", src: p.concat(b"fn f() -> Int = { let g = |s| {..s, a: 1}; 0 }") },
    ]),
    [b"E0116"],
  );
  assert_eq(codes_across([{ name: b"m", src: p.concat(b"fn f(q: P) -> P = {..q, c: 1}") }]), [
    b"E0117",
  ])
}

test "`++` joins two Strings or two Bytes, and rejects one of each" {
  assert_eq(
    codes_across([{ name: b"m", src: b"fn f(a: String, b: String) -> String = a ++ b" }]),
    [],
  );
  assert_eq(codes_across([{ name: b"m", src: b"fn f(a: Bytes, b: Bytes) -> Bytes = a ++ b" }]), []);
  assert_eq(
    codes_across([
      {
        name: b"m",
        src: b"fn f(xs: List<Bytes>) -> Bytes = xs.fold(b\"\", |acc: Bytes, x: Bytes| acc ++ x)",
      },
    ]),
    [],
  );
  assert_eq(
    codes_across([{ name: b"m", src: b"fn f(a: String, b: Bytes) -> String = a ++ b" }]),
    [b"E0201"],
  );
  assert_eq(codes_across([{ name: b"m", src: b"fn f(a: Int, b: Int) -> Int = a ++ b" }]), [
    b"E0201",
  ]);
  assert_eq(codes_across([{ name: b"m", src: b"fn f() -> Int = { let g = |a, b| a ++ b; 0 }" }]), [
    b"E0210",
  ])
}

fn not_covered(src: Bytes) -> List<Bytes> / {abort.raise} = {
  let r = parse(src);
  let x = expand(r.node, r.parser.diagnostics);
  let d: Expansion = expand_derives(0, b"m", x.module);
  match resolve_modules([{ name: b"m", module: d.module, derived: d.derived }]) {
    ResolveFailed(_) -> [b"does not resolve"],
    ResolveSucceeded(ok) ->
      check_program(ok.resolution, ok.modules).checker.diagnostics.filter(
        |diagnostic: Diagnostic| diagnostic.code == b"E0205",
      ).map(|diagnostic: Diagnostic| diagnostic.labels.get(0).text),
  }
}

fn labels_of(src: Bytes, code: Bytes) -> List<Bytes> / {abort.raise} =
  source_diagnostics(src).filter(|diagnostic: Diagnostic| diagnostic.code == code).map(
    |diagnostic: Diagnostic| diagnostic.labels.get(0).text,
  )

test "an or-pattern's alternatives bind the same names at one type" {
  let t = b"type T = | A(Int) | B(Int) | C(String) | D\n";
  assert_eq(check_codes(t.concat(b"fn f(x: T) -> Int = match x { A(n) | B(n) -> n, _ -> 0 }")), []);
  assert_eq(
    labels_of(t.concat(b"fn f(x: T) -> Int = match x { A(n) | D -> n, _ -> 0 }"), b"E0212"),
    [b"does not bind `n`, which the first alternative does"],
  );
  assert_eq(
    labels_of(t.concat(b"fn f(x: T) -> Int = match x { D | A(n) -> 0, _ -> 1 }"), b"E0212"),
    [b"binds `n`, which the first alternative does not"],
  );
  assert_eq(
    labels_of(t.concat(b"fn f(x: T) -> Int = match x { A(n) | B(m) -> 0, _ -> 1 }"), b"E0212"),
    [b"binds `m` where the first alternative binds `n`"],
  );
  assert_eq(check_codes(t.concat(b"fn f(x: T) -> Int = match x { A(n) | C(n) -> 0, _ -> 1 }")), [
    b"E0201",
  ])
}

test "a match is exhausted through its or-patterns, nested ones included" {
  let t = b"type T = | A | B | C\n";
  assert_eq(not_covered(t.concat(b"fn f(x: T) -> Int = match x { A | B -> 1, C -> 2 }")), []);
  assert_eq(not_covered(t.concat(b"fn f(x: T) -> Int = match x { A | B -> 1 }")), [
    b"not covered: `C`",
  ]);
  assert_eq(
    not_covered(t.concat(b"fn f(o: Option<T>) -> Int = match o { Some(A | C) -> 1, None -> 2 }")),
    [b"not covered: `Some(B)`"],
  );
  assert_eq(
    not_covered(
      t.concat(b"fn f(p: (T, Bool)) -> Int = match p { (A | B, _) -> 1, (C, true | false) -> 2 }"),
    ),
    [],
  )
}

test "a plain `let` whose or-pattern can fail is rejected, and one that covers its type is not" {
  assert_eq(check_codes(b"fn f(r: Result<Int, Int>) -> Int = { let Ok(v) | Err(v) = r; v }"), []);
  assert_eq(
    labels_of(
      b"fn f(r: Option<Int>) -> Int / {abort.raise} = { let Some(1) | Some(2) = r; 0 }",
      b"E0213",
    ),
    [b"not covered: `None`, `Some(_)`"],
  );
  assert_eq(check_codes(b"fn f(r: Option<Int>) -> Int / {abort.raise} = { let Some(v) = r; v }"), [
  ])
}

test "literals and ranges exhaust an unsigned width they cover, and a match names what they miss" {
  assert_eq(
    not_covered(b"fn f(b: U8) -> Int = match b { 0u8..=127u8 -> 0, 128u8..=255u8 -> 1 }"),
    [],
  );
  assert_eq(
    not_covered(b"fn f(b: U8) -> Int = match b { 0u8..=200u8 -> 0, 100u8..=255u8 -> 1 }"),
    [],
  );
  assert_eq(not_covered(b"fn f(b: U8) -> Int = match b { 0u8..=9u8 -> 0, 20u8..=255u8 -> 1 }"), [
    b"not covered: `10u8..=19u8`",
  ]);
  assert_eq(
    not_covered(b"fn f(b: U8) -> Int = match b { 0u8..=9u8 -> 0, 10u8 -> 1, 12u8..=255u8 -> 2 }"),
    [b"not covered: `11u8`"],
  );
  assert_eq(not_covered(b"fn f(c: Int) -> Int = match c { 0..=9 -> 1, 5..=20 -> 2, _ -> 0 }"), []);
  assert_eq(
    not_covered(b"fn f(o: Option<U8>) -> Int = match o { Some(0u8..=254u8) -> 0, None -> 1 }"),
    [b"not covered: `Some(255u8)`"],
  );
  assert_eq(
    not_covered(
      b"fn f(p: (U8, Bool)) -> Int = match p { (0u8..=9u8, true) -> 0, (_, false) -> 1 }",
    ),
    [b"not covered: `(10u8..=255u8, true)`"],
  );
  assert_eq(not_covered(b"fn f(c: Int) -> Int = match c { b'0'..=b'9' -> 1 }"), [
    b"not covered: `_`",
  ]);
  assert_eq(not_covered(b"fn f(t: I8) -> Int = match t { -127i8..=127i8 -> 1 }"), [
    b"not covered: `_`",
  ]);
  assert_eq(
    not_covered(b"fn f(n: U64) -> Int = match n { 0u64..=0xFFFF_FFFF_FFFF_FFFFu64 -> 0 }"),
    [b"not covered: `_`"],
  )
}

test "a range pattern's bounds are integer literals of one type, the first no greater" {
  assert_eq(check_codes(b"fn f(n: Int) -> Int = match n { 0..=9 -> 1, 7..=7 -> 2, _ -> 0 }"), []);
  assert_eq(check_codes(b"fn f(n: Int) -> Int = match n { 9..=0 -> 1, _ -> 0 }"), [b"E0222"]);
  assert_eq(check_codes(b"fn f(n: Int) -> Int = match n { 0..=9u8 -> 1, _ -> 0 }"), [b"E0222"]);
  assert_eq(check_codes(b"fn f(c: Char) -> Int = match c { 'a'..='z' -> 1, _ -> 0 }"), [b"E0222"]);
  assert_eq(check_codes(b"fn f(s: String) -> Int = match s { \"a\"..=\"z\" -> 1, _ -> 0 }"), [
    b"E0222",
  ]);
  assert_eq(check_codes(b"fn f(n: U8) -> Int = match n { 0..=9 -> 1, _ -> 0 }"), [b"E0201"]);
  assert_eq(
    check_codes(b"fn f(n: U64) -> Int = match n { 0xFFFF_FFFF_FFFF_FFFFu64..=1u64 -> 1, _ -> 0 }"),
    [b"E0222"],
  );
  assert_eq(
    check_codes(b"fn f(n: U64) -> Int = match n { 1u64..=0xFFFF_FFFF_FFFF_FFFFu64 -> 1, _ -> 0 }"),
    [],
  );
  assert_eq(
    check_codes(
      b"fn f(n: I128) -> Int = match n { -1i128..=1i128 -> 1, 2i128..=1i128 -> 2, _ -> 0 }",
    ),
    [b"E0222"],
  )
}

test "a `let ... else` checks its `else` against its block's value, without the pattern's names" {
  assert_eq(check_codes(b"fn f(o: Option<Int>) -> Int = { let Some(v) = o else { 0 }; v }"), []);
  assert_eq(
    check_codes(b"fn f(o: Option<Int>) -> Int = { let Some(v) = o else { \"none\" }; v }"),
    [b"E0201"],
  );
  assert_eq(check_codes(b"fn f(o: Option<Int>) -> Int = { let Some(v) = o else { v }; v }"), [
    b"E0101",
  ]);
  assert_eq(check_codes(b"fn f(o: Option<Int>) -> Unit = { let Some(v) = o else { () }; }"), [])
}

test "a match is exhaustive through nested constructors, and names the inner case it misses" {
  let t = b"type T = | A | B\n";
  assert_eq(
    not_covered(
      t.concat(b"fn f(o: Option<T>) -> Int = match o { Some(A) -> 1, Some(B) -> 2, None -> 3 }"),
    ),
    [],
  );
  assert_eq(
    not_covered(t.concat(b"fn f(o: Option<T>) -> Int = match o { Some(A) -> 1, None -> 3 }")),
    [b"not covered: `Some(B)`"],
  );
  assert_eq(
    not_covered(
      t.concat(
        b"fn f(r: Result<Option<T>, T>) -> Int = match r { Ok(Some(A)) -> 1, Ok(None) -> 2, Err(_) -> 3 }",
      ),
    ),
    [b"not covered: `Ok(Some(B))`"],
  );
  assert_eq(not_covered(t.concat(b"fn f(r: Result<T, T>) -> Int = match r { Ok(A) -> 1 }")), [
    b"not covered: `Ok(B)`, `Err(_)`",
  ])
}

test "a guarded arm covers nothing, and a constructor that does not resolve covers nothing" {
  let t = b"type T = | A | B\n";
  assert_eq(
    not_covered(
      t.concat(
        b"fn f(o: Option<T>, n: Int) -> Int = match o { Some(A) if n > 0 -> 1, Some(B) -> 2, None -> 3 }",
      ),
    ),
    [b"not covered: `Some(A)`"],
  );
  assert_eq(
    not_covered(
      t.concat(
        b"fn f(o: Option<T>, n: Int) -> Int = match o { Some(A) if n > 0 -> 1, Some(_) -> 2, None -> 3 }",
      ),
    ),
    [],
  );
  assert_eq(
    not_covered(t.concat(b"fn f(o: Option<T>) -> Int = match o { Some(C) -> 1, None -> 3 }")),
    [b"not covered: `Some(_)`"],
  )
}

test "booleans are exhausted by both literals, a unit by its one, and other literals never" {
  assert_eq(
    not_covered(
      b"fn f(p: (Bool, Bool)) -> Int = match p { (true, _) -> 1, (_, true) -> 2, (false, false) -> 3 }",
    ),
    [],
  );
  assert_eq(
    not_covered(b"fn f(p: (Bool, Bool)) -> Int = match p { (true, _) -> 1, (false, true) -> 2 }"),
    [b"not covered: `(false, false)`"],
  );
  assert_eq(not_covered(b"fn f(u: Unit) -> Int = match u { () -> 1 }"), []);
  assert_eq(not_covered(b"fn f(n: Int) -> Int = match n { 0 -> 1, 1 -> 2 }"), [
    b"not covered: `_`",
  ]);
  assert_eq(not_covered(b"fn f(o: Option<Int>) -> Int = match o { Some(0) -> 1, None -> 2 }"), [
    b"not covered: `Some(_)`",
  ])
}

test "list patterns are exhausted by exact lengths and prefixes, element patterns included" {
  assert_eq(
    not_covered(
      b"fn f(xs: List<Int>) -> Int = match xs { [] -> 0, [x] -> x, [x, y, ..rest] -> x + y }",
    ),
    [],
  );
  assert_eq(
    not_covered(b"fn f(xs: List<Int>) -> Int = match xs { [] -> 0, [x, y, ..rest] -> x + y }"),
    [b"not covered: `[_]`"],
  );
  assert_eq(not_covered(b"fn f(xs: List<Int>) -> Int = match xs { [x, ..rest] -> x }"), [
    b"not covered: `[]`",
  ]);
  assert_eq(
    not_covered(
      b"fn f(xs: List<Option<Int>>) -> Int = match xs { [] -> 0, [None, ..] -> 1, [Some(x), ..rest] -> x }",
    ),
    [],
  );
  assert_eq(
    not_covered(
      b"fn f(xs: List<Option<Int>>) -> Int = match xs { [] -> 0, [Some(x), ..rest] -> x }",
    ),
    [b"not covered: `[None, ..]`"],
  )
}

test "record patterns are exhausted field by field" {
  let t = b"type T = | A | B\n";
  assert_eq(
    not_covered(
      t.concat(b"fn f(p: { t: T, n: Int }) -> Int = match p { {t: A, n} -> n, {t: B, ..} -> 0 }"),
    ),
    [],
  );
  assert_eq(
    not_covered(t.concat(b"fn f(p: { t: T, n: Int }) -> Int = match p { {t: A, n} -> n }")),
    [b"not covered: `{t: B, ..}`"],
  )
}

test "a `parallel` block is the tuple of its branches, and branches may share what none of them writes" {
  assert_eq(check_codes(b"fn f(n: Int) -> (Int, Bool) = parallel { n + 1, n > 0 }"), []);
  assert_eq(check_codes(b"fn f(n: Int) -> (Int, Int, Int) = parallel { n, n, n }"), []);
  assert_eq(check_codes(b"fn f(n: Int) -> (Bool, Int) = parallel { n + 1, n > 0 }"), [b"E0201"]);
  assert_eq(
    check_codes(
      declaring_net_effect(
        b"fn f() -> (Int, Int) / {net.read[c]} = parallel { net.peek[c](), net.peek[c]() }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        b"fn f() -> (Unit, Int) / {net.write[c], net.read[d]} = parallel { net.close[c](), net.peek[d]() }",
      ),
    ),
    [],
  )
}

test "two branches that touch one resource where either writes are rejected" {
  let diagnostics = source_diagnostics(
    declaring_net_effect(
      b"fn f() -> (Unit, Int) / {net.write[c], net.read[c]} = parallel { net.close[c](), net.peek[c]() }",
    ),
  );
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0309"]);
  assert(
    diagnostics.fold(false, |b: Bool, diagnostic: Diagnostic|
      b
        || diagnostic.labels.fold(false, |c: Bool, label: Label|
          c || label.text.index_of(b"net.close[c]") != None)),
  );
  assert_eq(
    check_codes(
      declaring_net_effect(
        b"fn f<[l]>() -> (Unit, Int) / {net.write[l], net.read[c]} = parallel { net.close[l](), net.peek[c]() }",
      ),
    ),
    [b"E0309"],
  );
  assert_eq(
    check_codes(
      b"fn f() -> Int = with_scope[w](0, |x: Int| ()) { c -> { let p = parallel { c.get(), c.get() }; p._1 } }",
    ),
    [],
  )
}

test "a branch whose effects are open may perform anything, so it shares with no branch that performs" {
  assert_eq(check_codes(b"fn f<| e>(g: () -> Int / e) -> (Int, Int) / e = parallel { g(), 1 }"), [
  ]);
  assert_eq(
    check_codes(b"fn f<| e>(g: () -> Int / e) -> (Int, Int) / e = parallel { g(), g() }"),
    [b"E0309"],
  )
}

test "a branch may not open a `simulate` block, whose schedule is its entry's, nor spawn a task" {
  assert_eq(check_codes(b"fn f() -> (Int, Int) / {sim.read} = parallel { simulate { 1 }, 2 }"), [
    b"E0309",
  ]);
  assert_eq(
    check_codes(
      b"fn f() -> (Int, Int) / {task.write, abort.raise} = parallel { task.join(task.spawn(|| 1)), 2 }",
    ),
    [b"E0309"],
  )
}

fn with_db_effect(body: Bytes) -> Bytes =
  b"effect db { read query[c](sql: Bytes) -> Int }\nfn lookup(id: Int) -> Int / {db.query[conn]} = db.query[conn](b\"one\")\n".concat(
    body,
  )

fn counted(src: Bytes, name: Bytes) -> { scaling: Bool, repeats: List<Int> } / {abort.raise} =
  match definition_of(checked_context(src), b"m.".concat(name)) {
    Some(d) -> { scaling: d.scaling.len() > 0, repeats: d.repeats },
    None -> panic("the definition the test names"),
  }

test "a lookup performs its query a bounded number of times, and the same lookup mapped over its input scales" {
  assert_eq(counted(with_db_effect(b""), b"lookup"), { scaling: false, repeats: [] });
  let mapped = with_db_effect(
    b"fn all(ids: List<Int>) -> List<Int> / {db.query[conn]} = ids.map(lookup)\n",
  );
  assert_eq(counted(mapped, b"all"), { scaling: true, repeats: [] });
  let lambda = with_db_effect(
    b"fn all(ids: List<Int>) -> List<Int> / {db.query[conn]} = ids.map(|id: Int| lookup(id))\n",
  );
  assert_eq(counted(lambda, b"all"), { scaling: true, repeats: [] });
  let three = with_db_effect(
    b"fn three() -> List<Int> / {db.query[conn]} = [1, 2, 3].map(|id: Int| lookup(id))\n",
  );
  assert_eq(counted(three, b"three"), { scaling: false, repeats: [] });
  let once = with_db_effect(
    b"fn first(ids: List<Int>) -> List<Int> / {db.query[conn]} = { let n = lookup(0); ids.map(|id: Int| id + n) }\n",
  );
  assert_eq(counted(once, b"first"), { scaling: false, repeats: [] })
}

test "recursion repeats everything its body performs, and a callback's count composes through its caller" {
  let walked = with_db_effect(
    b"fn walk(ids: List<Int>) -> Int / {db.query[conn]} = match ids { [] -> 0, [id, ..rest] -> lookup(id) + walk(rest) }\n",
  );
  assert_eq(counted(walked, b"walk"), { scaling: true, repeats: [] });
  let each = with_db_effect(
    b"fn each<a | e>(xs: List<a>, f: (a) -> Unit / e) -> Unit / e = xs.fold((), |u: Unit, x: a| f(x))\nfn once<a | e>(f: () -> a / e) -> a / e = f()\nfn looked(ids: List<Int>) -> Unit / {db.query[conn]} = each(ids, |id: Int| { lookup(id); () })\nfn one() -> Int / {db.query[conn]} = once(|| lookup(1))\n",
  );
  assert_eq(counted(each, b"each"), { scaling: false, repeats: [1] });
  assert_eq(counted(each, b"once"), { scaling: false, repeats: [] });
  assert_eq(counted(each, b"looked"), { scaling: true, repeats: [] });
  assert_eq(counted(each, b"one"), { scaling: false, repeats: [] })
}

test "a `bounded` promise in the effects is held to the body, and only a definition's own effects make one" {
  assert_eq(
    check_codes(
      with_db_effect(
        b"fn batched(ids: List<Int>) -> Int / {db.query[conn] bounded} = db.query[conn](b\"in\")\n",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      with_db_effect(
        b"fn per_item(ids: List<Int>) -> Int / {db.query[conn] bounded} = ids.fold(0, |n: Int, id: Int| n + lookup(id))\n",
      ),
    ),
    [b"E0465"],
  );
  assert_eq(
    check_codes(
      b"fn each<a | e>(xs: List<a>, f: (a) -> Unit / e) -> Unit / e bounded = xs.fold((), |u: Unit, x: a| f(x))\n",
    ),
    [b"E0465"],
  );
  assert_eq(
    check_codes(
      with_db_effect(
        b"fn take(f: () -> Int / {db.query[conn] bounded}) -> Int / {db.query[conn]} = f()\n",
      ),
    ),
    [b"E0466"],
  )
}

fn diverges(src: Bytes, name: Bytes) -> Bool / {abort.raise} =
  match definition_of(checked_context(src), b"m.".concat(name)) {
    Some(d) -> match d.ending { Diverges(_) -> true, _ -> false },
    None -> panic("the definition the test names"),
  }

test "a definition that may not return writes `diverges`, which its callers inherit and a fix writes for them" {
  let root = source_diagnostics(b"fn spin(n: Int) -> Int = spin(n + 1)\n");
  assert_eq(root.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0302"]);
  assert_eq(root.map(|diagnostic: Diagnostic| diagnostic.message), [
    b"`spin` may not return, and its effects do not say so",
  ]);
  assert_eq(root.map(|diagnostic: Diagnostic| diagnostic.fixes.len()), [0]);
  assert_eq(check_codes(b"fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\n"), []);
  let caller = source_diagnostics(
    b"fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\nfn wait(n: Int) -> Int = spin(n)\n",
  );
  assert_eq(caller.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0302"]);
  assert_eq(caller.map(|diagnostic: Diagnostic| diagnostic.notes_text), [
    [
      b"a call that may not return makes `wait` one too: write `/ {diverges}` after the return type, or call only what ends",
    ],
  ]);
  assert_eq(caller.map(|diagnostic: Diagnostic| diagnostic.fixes.len()), [1]);
  assert_eq(
    check_codes(
      b"fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\nfn wait(n: Int) -> Int / {diverges} = spin(n)\n",
    ),
    [],
  );
  assert_eq(
    check_codes(b"fn down(n: Int) -> Int / {diverges} = if n <= 0 { 0 } else { down(n - 1) }\n"),
    [],
  );
  assert_eq(
    check_codes(
      b"fn climb(a: Int, b: Int) -> Int decreases a + b = if a + b <= 0 { 0 } else { climb(a + 1, b - 2) }\n",
    ),
    [],
  )
}

test "a test or law that may not return supplies nothing for it: its steps bound it" {
  let src = b"fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\ntest \"spins\" { assert_eq(spin(0), 0) }\nlaw \"spins too\" forall (n: Int) { spin(n) == spin(n) }\n";
  assert_eq(check_codes(src), []);
  let c = checked_context(src);
  assert_eq(c.tests.map(|t: TestInfo| t.effects.len()), [0]);
  assert_eq(c.laws.map(|l: LawInfo| l.effects.len()), [0])
}

test "recursion on a part of an argument terminates, and recursion on the argument itself may not" {
  assert(
    !diverges(
      b"fn count(xs: List<Int>) -> Int = match xs { [] -> 0, [x, ..rest] -> 1 + count(rest) }\n",
      b"count",
    ),
  );
  let tree = b"type T = | Leaf | Node(T, Int, T)\n";
  assert(
    !diverges(
      tree.concat(
        b"fn size(t: T) -> Int = match t { Leaf -> 0, Node(l, v, r) -> size(l) + 1 + size(r) }\n",
      ),
      b"size",
    ),
  );
  assert(diverges(b"fn spin(n: Int) -> Int = spin(n)\n", b"spin"));
  assert(
    diverges(
      b"fn keep(xs: List<Int>) -> Int = match xs { [] -> 0, [x, ..rest] -> keep(xs) }\n",
      b"keep",
    ),
  );
  assert(
    !diverges(
      b"fn drain(s: { todo: List<Int>, done: List<Int> }) -> List<Int> = match s.todo { [] -> s.done, [x, ..rest] -> drain({ todo: rest, done: s.done.push(x) }) }\n",
      b"drain",
    ),
  )
}

test "an integer terminates descending toward a bound a guard holds it above" {
  assert(!diverges(b"fn down(n: Int) -> Int = if n <= 0 { 0 } else { down(n - 1) }\n", b"down"));
  assert(diverges(b"fn down(n: Int) -> Int = if n == 0 { 0 } else { down(n - 1) }\n", b"down"));
  assert(
    !diverges(
      b"fn walk(xs: List<Int>, i: Int) -> Int = if i >= xs.len() { 0 } else { walk(xs, i + 1) }\n",
      b"walk",
    ),
  );
  assert(
    diverges(
      b"fn climb(xs: List<Int>, i: Int) -> Int = if i >= xs.len() { 0 } else { climb(xs.push(i), i + 1) }\n",
      b"climb",
    ),
  );
  assert(
    !diverges(
      b"fn ack(m: Int, n: Int) -> Int = if m <= 0 { n + 1 } else if n <= 0 { ack(m - 1, 1) } else { ack(m - 1, ack(m, n - 1)) }\n",
      b"ack",
    ),
  )
}

test "a recursion through `map`, `filter` and `fold` ends by the elements their entries hand on" {
  let rose = b"type Rose = | Rose(Int, List<Rose>)\nfn size(t: Rose) -> Int = match t { Rose(_, kids) -> 1 + kids.map(|k: Rose| size(k)).fold(0, |a: Int, n: Int| a + n) }\nfn deep(t: Rose) -> Int = match t { Rose(v, kids) -> kids.filter(|k: Rose| true).fold(v, |a: Int, k: Rose| a + deep(k)) }\n";
  assert(!diverges(rose, b"size"));
  assert(!diverges(rose, b"deep"));
  assert(
    diverges(
      b"type Rose = | Rose(Int, List<Rose>)\nfn again(t: Rose) -> Int = match t { Rose(_, kids) -> kids.fold(0, |a: Int, k: Rose| a + again(t)) }\n",
      b"again",
    ),
  )
}

test "a group terminates when every loop through it descends, through a callback too" {
  let src = b"type T = | Node(Int, List<T>)\nfn size(t: T) -> Int = match t { Node(v, kids) -> v + total(sizes(kids)) }\nfn sizes(ts: List<T>) -> List<Int> = ts.map(size)\nfn total(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + x)\nfn deep(t: T) -> Int = match t { Node(v, kids) -> kids.fold(v, |a: Int, k: T| a + deep(k)) }\n";
  assert(!diverges(src, b"size"));
  assert(!diverges(src, b"sizes"));
  assert(!diverges(src, b"deep"));
  let doc = b"type J = | Leaf | Obj(Map<String, J>)\nfn count(j: J) -> Int = match j { Leaf -> 1, Obj(m) -> m.entries().fold(0, |n: Int, e: { key: String, value: J }| n + count(e.value)) }\n";
  assert(!diverges(doc, b"count"));
  assert(
    diverges(
      b"fn twice(f: (Int) -> Int, n: Int) -> Int = f(f(n))\nfn down(n: Int) -> Int = if n <= 0 { 0 } else { twice(down, n - 1) }\n",
      b"down",
    ),
  );
  assert(
    diverges(
      b"fn ping(n: Int) -> Int = pong(n)\nfn pong(n: Int) -> Int = if n <= 0 { 0 } else { ping(n) }\n",
      b"ping",
    ),
  )
}

test "a callback a recursion hands on in its own place is called as that recursion calls it" {
  let tree = b"type T = | Node(Int, List<T>)\n";
  let trav = b"fn trav(xs: List<T>, f: (T) -> Option<Int>, done: List<Int>) -> Option<List<Int>> = match xs { [] -> Some(done), [x, ..rest] -> match f(x) { None -> None, Some(y) -> trav(rest, f, done.push(y)) } }\n";
  let total = b"fn total(t: T) -> Option<Int> = match t { Node(v, kids) -> match trav(kids, |k: T| total(k), []) { None -> None, Some(ys) -> Some(ys.fold(v, |a: Int, y: Int| a + y)) } }\n";
  let src = Bytes::concat_all([tree, trav, total]);
  assert(!diverges(src, b"trav"));
  assert(!diverges(src, b"total"));
  let grown = b"fn grown(xs: List<T>, ys: List<T>, f: (T) -> Int, n: Int) -> Int = if n <= 0 { 0 } else { match ys { [] -> 0, [y, ..] -> f(y) + grown(xs, xs.fold(ys, |acc: List<T>, x: T| acc.push(x)), f, n - 1) } }\nfn through(t: T) -> Int = match t { Node(v, kids) -> v + grown(kids, kids, |k: T| through(k), 2) }\n";
  assert(diverges(tree.concat(grown), b"through"));
  let swapped = b"fn swapped(xs: List<T>, f: (T) -> Int, g: (T) -> Int) -> Int = match xs { [] -> 0, [x, ..rest] -> f(x) + swapped(rest, g, f) }\nfn through(t: T) -> Int = match t { Node(v, kids) -> v + swapped(kids, |k: T| through(k), |k: T| 0) }\n";
  assert(diverges(tree.concat(swapped), b"through"));
  assert(
    diverges(
      b"fn counted(i: Int, n: Int, f: (Int) -> Int) -> Int = if i >= n { 0 } else { f(i) + counted(i + 1, n, f) }\nfn down(n: Int) -> Int = if n <= 0 { 0 } else { counted(0, n, |i: Int| down(i)) }\n",
      b"down",
    ),
  )
}

test "a guard an earlier arm failed, an index found, and a write that keeps the length bound a walk" {
  assert(
    !diverges(
      b"fn down(p: { left: Int, seen: Int }) -> Int = match p { { left, seen } if left <= 0 -> seen, { left, seen } -> down({ left: left - 1, seen: seen + 1 }) }\n",
      b"down",
    ),
  );
  assert(
    diverges(
      b"fn down(p: { left: Int, seen: Int }) -> Int = match p { { left, seen } if left > 9 -> seen, { left, seen } -> down({ left: left - 1, seen: seen + 1 }) }\n",
      b"down",
    ),
  );
  assert(
    !diverges(
      b"fn last(xs: List<Int>, i: Int, seen: Option<Int>) -> Option<Int> = match xs.at(i) { None -> seen, Some(x) -> last(xs, i + 1, Some(x)) }\n",
      b"last",
    ),
  );
  assert(
    !diverges(
      b"fn fill(a: Array<Int>, i: Int) -> Array<Int> = if i >= a.len() { a } else { fill(a.set(i, i * 2), i + 1) }\n",
      b"fill",
    ),
  );
  assert(
    !diverges(
      b"fn zero(xs: List<Int>, i: Int) -> List<Int> = if i >= xs.len() { xs } else { zero(xs.set(i, 0), i + 1) }\n",
      b"zero",
    ),
  )
}

fn declared_as(name: Bytes) -> Builtin / {abort.raise} =
  match builtin_named(name) {
    Some(b) -> b,
    None -> panic("the prelude declares `" ++ String::of_bytes(name) ++ "`"),
  }

test "a builtin is what the prelude declares: its scheme, its parameters' names and its doc" {
  let slice = declared_as(b"Bytes::slice");
  assert_eq(slice.params.map(|p: ParameterMode| p.name), [b"b", b"start", b"end"]);
  assert_eq(slice.doc, [b"Raises out of range."]);
  assert_eq(declared_as(b"List::map").params, [
    { name: b"xs", borrowed: false, keep: false },
    { name: b"f", borrowed: true, keep: false },
  ]);
  match parse(b"extern fn hold<a>(f: keep (a) -> a, g: (a) -> a) -> Unit\n").node.items {
    [ExternItem(d)] ->
      assert_eq(builtin_of_extern(b"scoped", Map::new(), d, Map::new()).params, [
        { name: b"f", borrowed: false, keep: true },
        { name: b"g", borrowed: true, keep: false },
      ]),
    _ -> panic("one `extern fn`"),
  };
  assert_eq(slice.scheme, {
    type_variables: [],
    effect_variables: [],
    keep_variables: [],
    label_variables: [],
    ty: fn_type(
      [bytes_type(), int_type(), int_type()],
      bytes_type(),
      single_effect(abort_effect()),
    ),
  });
  assert_eq(declared_as(b"List::len").doc, [b"The number of items in the list."])
}

test "a declaration's generic list is its scheme's variables, numbered from zero" {
  assert_eq(declared_as(b"List::map").scheme, {
    type_variables: [0, 1],
    effect_variables: [0],
    keep_variables: [],
    label_variables: [],
    ty: fn_type(
      [list_type(VariableType(0)), fn_type([VariableType(0)], VariableType(1), open_effects(0))],
      list_type(VariableType(1)),
      open_effects(0),
    ),
  });
  assert_eq(
    declared_as(b"iterate").scheme.ty,
    fn_type(
      [
        VariableType(0),
        int_type(),
        fn_type([VariableType(0)], iter_type(VariableType(0), VariableType(1)), open_effects(0)),
      ],
      VariableType(1),
      { listed: [abort_effect()], variable: Some(0) },
    ),
  )
}

test "a declaration's `where` is what a call must show, by the parameter's place" {
  assert_eq(declared_as(b"compare").constraints, [{ deriver: OrdDeriver, param: 0 }]);
  assert_eq(declared_as(b"numeric_of_int").constraints, [{ deriver: NumericDeriver, param: 0 }]);
  assert_eq(declared_as(b"List::push").constraints, [])
}

test "every builtin is in reach of a module that imports nothing" {
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int = xs.push(1).len()\n"), [])
}

test "an `extern fn` outside a shipped module is rejected" {
  assert_eq(check_codes(b"extern fn secret(x: Int) -> Int\nfn f() -> Int = 1\n"), [b"E0151"]);
  assert_eq(codes_of([{ name: b"tools.native", src: b"pub extern fn secret(x: Int) -> Int\n" }]), [
    b"E0151",
  ])
}

test "a shipped module's extern is called as its module's, and a private one only there" {
  let native = {
    name: b"std.native",
    src: b"pub type Pair<a> = | Pair(a, a)\npub extern fn doubled(x: Int) -> Int\nextern fn hidden(x: Int) -> Int\npub fn twice(x: Int) -> Int = hidden(x) + hidden(x)\npub extern fn first<a>(p: Pair<a>) -> a\n",
  };
  assert_eq(
    codes_of([
      native,
      {
        name: b"m",
        src: b"import std.native (doubled)\nimport std.native as n\nfn f() -> Int = doubled(2) + n::doubled(3) + n::twice(4)\n",
      },
    ]),
    [],
  );
  assert_eq(
    codes_of([
      native,
      { name: b"m", src: b"import std.native (hidden)\nfn f() -> Int = hidden(1)\n" },
    ]),
    [b"E0107"],
  );
  assert_eq(
    codes_of([
      native,
      { name: b"m", src: b"import std.native (doubled)\nfn f() -> Int = doubled(true)\n" },
    ]),
    [b"E0201"],
  );
  let pairs = |src: Bytes| codes_of([native, { name: b"m", src: src }]);
  assert_eq(
    pairs(b"import std.native (Pair, first)\nfn f(p: Pair<String>) -> String = first(p)\n"),
    [],
  );
  assert_eq(pairs(b"import std.native (Pair, first)\nfn f(p: Pair<String>) -> Int = first(p)\n"), [
    b"E0201",
  ])
}

test "a shipped module's extern spelled with an alias of its own takes and returns the type it names" {
  let native = {
    name: b"std.native",
    src: b"pub type Pid = Int\npub type Pair = { pid: Pid, n: Int }\npub extern fn pid() -> Pid\npub extern fn first(p: Pair) -> Int\npub fn f() -> Int = pid()\npub fn g() -> Pid = first({ pid: pid(), n: 2 })\n",
  };
  assert_eq(codes_of([native, { name: b"m", src: b"fn h() -> Int = 1\n" }]), [])
}

test "a shipped module's extern performs a mode of an effect it imports, as its callers then do" {
  let with_ask_effect = { name: b"std.asking", src: b"pub nondet effect asked {}\n" };
  let native = {
    name: b"std.native",
    src: b"import std.asking (asked)\npub extern fn size() -> Int / {asked.read}\n",
  };
  let codes = |src: Bytes| codes_of([with_ask_effect, native, { name: b"m", src: src }]);
  assert_eq(
    codes(
      b"import std.asking (asked)\nimport std.native (size)\nfn f() -> Int / {asked.read} = size()\n",
    ),
    [],
  );
  assert_eq(codes(b"import std.native (size)\ntest \"t\" { assert(size() == 1) }\n"), [b"E0412"]);
  assert_eq(
    codes_of([
      {
        name: b"std.native",
        src: b"pub nondet effect waits {}\npub extern fn wait() -> Int / {waits.read}\n",
      },
      {
        name: b"m",
        src: b"import std.native (waits, wait)\nfn f() -> Int / {waits.read} = wait()\n",
      },
    ]),
    [],
  );
  let told = { name: b"std.asking", src: b"pub nondet effect told {\n  read get() -> Int\n}\n" };
  let asks = {
    name: b"std.native",
    src: b"import std.asking (told)\npub extern fn size() -> Int / {told.read}\n",
  };
  match try[abort.raise] { codes_of([told, asks, { name: b"m", src: b"fn f() -> Int = 1\n" }]) } {
    Ok(codes) -> assert(false, Some("checked, with " ++ codes.len().to_string() ++ " codes")),
    Err(reason) -> assert(reason.contains("names a mode of `std.asking.told`"), Some(reason)),
  }
}

test "an `extern type` is its shipped module's, typed by its parameters, and nothing compares it" {
  assert_eq(check_codes(b"extern type Node<a>\nfn f() -> Int = 1\n"), [b"E0151"]);
  let native = {
    name: b"std.native",
    src: b"pub extern type Node<a>\nextern type Hidden\npub extern fn node_of<a>(x: a) -> Node<a>\npub extern fn value_of<a>(n: Node<a>) -> a\n",
  };
  let codes = |src: Bytes| codes_of([native, { name: b"m", src: src }]);
  assert_eq(
    codes(
      b"import std.native (Node, node_of, value_of)\nfn f() -> Int = value_of(node_of(1))\nfn g(n: Node<String>) -> String = value_of(n)\n",
    ),
    [],
  );
  assert_eq(codes(b"import std.native (Node, node_of)\nfn f() -> Node<Int> = node_of(\"s\")\n"), [
    b"E0201",
  ]);
  assert_eq(codes(b"import std.native (Hidden)\nfn f(h: Hidden) -> Int = 1\n"), [b"E0107"]);
  assert_eq(
    codes(b"import std.native (Node, node_of)\nfn f() -> Bool = node_of(1) == node_of(1)\n"),
    [b"E0201"],
  );
  assert_eq(
    codes(
      b"import std.native (Node, node_of)\ntype Held = | Held(Node<Int>)\nfn f() -> Bool = Held(node_of(1)) == Held(node_of(2))\n",
    ),
    [b"E0201"],
  );
  assert_eq(codes(b"import std.native (Node)\nfn f(m: Map<Node<Int>, Int>) -> Int = m.len()\n"), [
    b"E0206",
  ]);
  assert_eq(
    codes_of([
      {
        name: b"std.native",
        src: b"extern type Node\nextern fn rank(n: Node) -> Int\nkey for Node by rank\n",
      },
      { name: b"m", src: b"fn f() -> Int = 1\n" },
    ]),
    [b"E0217"],
  );
  let measured_definitions = |item: Bytes|
    codes_of([
      {
        name: b"std.native",
        src: Bytes::concat_all([b"extern type Node\nextern fn rank(n: Node) -> Int\n", item]),
      },
      { name: b"m", src: b"fn f() -> Int = 1\n" },
    ]);
  assert_eq(
    measured_definitions(
      b"fn shown_node(n: Node) -> String = \"n\"\nshow for Node by shown_node\n",
    ),
    [b"E0217"],
  );
  assert_eq(
    measured_definitions(
      b"numeric for Node by { of_int: of_int }\nextern fn of_int(n: Int) -> Node\n",
    ),
    [b"E0217"],
  );
  assert_eq(
    codes(
      b"import std.native (Node)\ntype Held = | Held(Node<Int>)\nfn size(h: Held) -> Int = 1\nkey for Held by size\nfn f(a: Held, b: Held) -> Bool = a == b\n",
    ),
    [],
  );
  assert_eq(
    codes(
      b"import std.native (Node)\ntype Tag<a> = | Tag(Int)\nfn f(a: Tag<Node<Int>>, b: Tag<Node<Int>>) -> Bool = a == b\n",
    ),
    [],
  );
  let chain = range(0, 30).fold(b"import std.native (Node)\n", |acc: Bytes, k: Int| {
    let next = if k == 29 { b"Node<Int>" }
    else { b"T".concat(Bytes::of_string((k + 1).to_string())) };
    acc.concat(
      Bytes::concat_all([
        b"type T",
        Bytes::of_string(k.to_string()),
        b" = | A",
        Bytes::of_string(k.to_string()),
        b"(",
        next,
        b", ",
        next,
        b") | B",
        Bytes::of_string(k.to_string()),
        b"\n",
      ]),
    )
  });
  assert_eq(codes(chain.concat(b"fn f(a: T0, b: T0) -> Bool = a == b\n")), [b"E0201"])
}

test "the prelude's functions of its own types are the externs the emitter writes in place and a native that reads a list's leaves, no builtin" {
  let text = prelude_source::text();
  let declared = externs_of(prelude_module(), parse(text).node).map(|b: Builtin| b.name);
  let of_a_list = |n: Bytes| n.starts_with(qualify(prelude_module(), b"ListNode::"));
  let own = declared.filter(|n: Bytes| !of_a_list(n));
  assert_eq(own.sort(), intrinsics().map(|i: { name: Bytes, op: Intrinsic }| i.name).sort());
  assert_eq(
    builtins().filter(|b: Builtin| own.contains(qualify(prelude_module(), b.name))).map(
      |b: Builtin| b.name,
    ),
    [],
  );
  assert_eq(
    externs_in(prelude_module(), text).map(|e: Extern| qualify(e.module, e.name)).sort(),
    declared.filter(of_a_list).sort(),
  );
  let prelude = { name: prelude_module(), src: text };
  let user = |src: Bytes| codes_of([prelude, { name: b"m", src: src }]);
  assert_eq(user(b"fn f(xs: List<Int>) -> Int = ListNode::start(xs)\n"), [b"E0101"]);
  assert_eq(user(b"fn f(n: ListNode<Int>) -> Int = 1\n"), [b"E0102"]);
  assert_eq(user(b"import std.prelude (ListNode)\nfn f(n: ListNode<Int>) -> Int = 1\n"), [
    b"E0107",
  ]);
  assert_eq(user(b"fn f(m: Map<Int, Int>) -> Int = MapNode::height(m)\n"), [b"E0101"]);
  assert_eq(user(b"fn f(xs: List<Int>) -> Int = xs.tail_len()\n"), [b"E0101"]);
  assert_eq(
    user(
      b"type ListNode = | Leaf(Int)\nfn ListNode::start(l: ListNode) -> Int = match l { Leaf(n) -> n }\nfn f() -> Int = ListNode::start(Leaf(1))\n",
    ),
    [],
  )
}

test "a constant past Int's range leaves the termination check unsure rather than broken" {
  assert_eq(
    check_codes(
      b"fn up() -> Int = 9223372036854775807 + 1\nfn down() -> Int = 0 - 9223372036854775807 - 1 - 1\n",
    ),
    [],
  );
  assert(
    diverges(
      b"fn far(n: Int) -> Int = if n <= 0 { 0 } else { far(n + 9223372036854775807 + 1) }\n",
      b"far",
    ),
  )
}

test "a bound one member of a group guards holds for the loops through the others" {
  let src = b"fn nest(n: Int, d: Int) -> Int = if d >= 10 { 0 } else { inner(n, d + 1) }\nfn inner(n: Int, d: Int) -> Int = nest(n, d) + 1\n";
  assert(!diverges(src, b"nest"));
  assert(!diverges(src, b"inner"));
  assert(
    diverges(
      b"fn nest(n: Int, d: Int) -> Int = if d >= 10 { 0 } else { inner(n, d + 1) }\nfn inner(n: Int, d: Int) -> Int = nest(n, d - 1)\n",
      b"nest",
    ),
  )
}

test "a lookup folded to the part it finds returns a part, even though the start holds nothing" {
  let src = |found: Bytes|
    Bytes::concat_all([
      b"type T = | Leaf | Node(List<{ key: Int, kid: T }>)\n",
      b"fn find(fs: List<{ key: Int, kid: T }>, k: Int) -> Option<T> =\n  fs.fold(None, |acc: Option<T>, f: { key: Int, kid: T }| if f.key == k { Some(",
      found,
      b") } else { acc })\n",
      b"fn depth(t: T) -> Int = match t { Leaf -> 0, Node(fs) -> match find(fs, 0) { Some(kid) -> 1 + depth(kid), None -> 0 } }\n",
    ]);
  assert(!diverges(src(b"f.kid"), b"depth"));
  assert(diverges(src(b"Node(fs)"), b"depth"))
}

test "a list written of parts, pushed or filtered or mapped to parts, is made of parts" {
  let tree = b"type T = | Leaf | Node(T, T) | Many(List<T>) | Named(List<{ name: String, value: T }>)\n";
  let walked = |name: Bytes, arms: Bytes|
    Bytes::concat_all([
      tree,
      b"fn ",
      name,
      b"(t: T) -> Bool = {\n  let any = |xs: List<T>| xs.fold(false, |acc: Bool, x: T| acc || ",
      name,
      b"(x));\n  match t { Leaf -> true, ",
      arms,
      b" }\n}\n",
    ]);
  assert(!diverges(walked(b"listed", b"Node(l, r) -> any([l, r]), _ -> false"), b"listed"));
  assert(!diverges(walked(b"pushed", b"Node(l, r) -> any([l].push(r)), _ -> false"), b"pushed"));
  assert(
    !diverges(walked(b"kept", b"Many(xs) -> any(xs.filter(|x: T| true)), _ -> false"), b"kept"),
  );
  assert(
    !diverges(
      walked(
        b"projected",
        b"Named(fs) -> any(fs.map(|f: { name: String, value: T }| f.value)), _ -> false",
      ),
      b"projected",
    ),
  );
  assert(diverges(walked(b"again", b"Many(xs) -> any(xs.push(t)), _ -> false"), b"again"))
}

test "a list joined of several places' parts is made of the parts a call hands it" {
  let tree = b"type T = | Leaf | Node(T, T) | Many(List<T>)\nfn join(xs: List<T>, ys: List<T>) -> List<T> = ys.fold(xs, |acc: List<T>, y: T| acc.push(y))\n";
  let sized = |kids: Bytes|
    Bytes::concat_all([
      tree,
      b"fn kids(t: T) -> List<T> = match t { ",
      kids,
      b", Leaf -> [] }\n",
      b"fn size(t: T) -> Int = 1 + kids(t).fold(0, |n: Int, k: T| n + size(k))\n",
    ]);
  assert(!diverges(sized(b"Node(l, r) -> join([l], [r]), Many(xs) -> join(xs, [])"), b"size"));
  assert(diverges(sized(b"Node(l, r) -> join([l], [t]), Many(xs) -> xs"), b"size"));
  assert(
    !diverges(
      tree.concat(
        b"fn flat(xs: List<T>, f: (T) -> List<T>) -> List<T> = xs.fold([], |acc: List<T>, x: T| join(acc, f(x)))\nfn kids(t: T) -> List<T> = match t { Node(l, r) -> [l, r], Many(xs) -> xs, Leaf -> [] }\nfn all(t: T) -> List<T> = join([t], flat(kids(t), all))\n",
      ),
      b"all",
    ),
  )
}

test "a group whose calls reorder what never shrinks ends as its one shrinking measure says" {
  let src = b"type T = | Leaf | Node(T, T)\nfn spin(t: T, a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int) -> Int = match t { Leaf -> a, Node(l, r) -> spin(l, b, a, c, d, e, f, g, h) + spin(r, b, c, d, e, f, g, h, a) }\n";
  assert(!diverges(src, b"spin"));
  assert(
    diverges(
      b"type T = | Leaf | Node(T, T)\nfn spin(t: T, a: Int, b: Int) -> Int = match t { Leaf -> a, Node(l, r) -> spin(l, b, a) + spin(t, a, b) }\n",
      b"spin",
    ),
  )
}

fn offset_of(context: Checker, s: Site) -> Int / {abort.raise} =
  match definition_of(context, s.caller) {
    Some(d) -> d.at.span.start + s.span.start,
    None -> panic("the definition the site names"),
  }

fn diverging_at(src: Bytes, name: Bytes) -> Option<Int> / {abort.raise} = {
  let context = checked_context(src);
  match definition_of(context, b"m.".concat(name)) {
    Some(d) -> match d.ending { Diverges(x) -> Some(offset_of(context, x.at)), _ -> None },
    None -> panic("the definition the test names"),
  }
}

test "a member of a group that may not return is told first by its own call out" {
  let src = b"fn spin(n: Int) -> Int = spin(n)\nfn a(n: Int) -> Int = if n <= 0 { spin(n) } else { b(n - 1) }\nfn b(n: Int) -> Int = if n <= 0 { a(n) } else { c(n) }\nfn c(n: Int) -> Int = b(n)\n";
  assert_eq(diverging_at(src, b"a"), src.index_of(b"spin(n) }"));
  assert(diverging_at(src, b"b") != diverging_at(src, b"a"));
  assert_eq(diverging_at(src, b"b"), diverging_at(src, b"c"))
}

test "a list rebuilt of parts, a fallback a block takes, and a failure `?` passes on are no smaller" {
  assert(
    diverges(
      b"fn copies(xs: List<List<Int>>) -> Int = match xs { [h, ..] -> match range(0, 100).map(|i: Int| h) { [_, ..rest] -> copies(rest), [] -> 0 }, [] -> 0 }\n",
      b"copies",
    ),
  );
  let second = b"fn second(xs: List<List<Int>>) -> List<List<Int>> / {abort.raise} = match xs { [_, ..r] -> r, [] -> panic(\"empty\") }\n";
  assert(
    diverges(
      second.concat(
        b"fn copies(xs: List<List<Int>>) -> Int / {abort.raise} = match xs { [h, ..] -> copies(second(range(0, 100).map(|i: Int| h))), [] -> 0 }\n",
      ),
      b"copies",
    ),
  );
  assert(
    !diverges(
      second.concat(
        b"fn walk(xs: List<List<Int>>) -> Int / {abort.raise} = match xs { [] -> 0, [_, ..] -> walk(second(xs)) }\n",
      ),
      b"walk",
    ),
  );
  assert(
    diverges(
      b"fn skip(xs: List<Int>) -> Int = if xs.len() == 0 { 0 } else { skip({ let [_, _, ..rest] = xs else { xs }; rest }) }\n",
      b"skip",
    ),
  );
  assert(
    diverges(
      b"fn drop2(xs: List<Int>) -> List<Int> = { let [_, _, ..rest] = xs else { xs }; rest }\nfn skip(xs: List<Int>) -> Int = if xs.len() == 0 { 0 } else { skip(drop2(xs)) }\n",
      b"skip",
    ),
  );
  assert(
    !diverges(
      b"fn drop2(xs: List<Int>) -> List<Int> / {abort.raise} = { let [_, _, ..rest] = xs else { panic(\"short\") }; rest }\nfn skip(xs: List<Int>) -> Int / {abort.raise} = if xs.len() < 2 { 0 } else { skip(drop2(xs)) }\n",
      b"skip",
    ),
  );
  assert(
    diverges(
      b"fn pick(r: Result<Int, List<Int>>, xs: List<Int>) -> Result<Int, List<Int>> / {abort.raise} = { let _ = r?; match xs { [_, ..rest] -> Err(rest), [] -> panic(\"empty\") } }\nfn spin(xs: List<Int>) -> Int / {abort.raise} = match pick(Err(xs), xs) { Err(e) -> spin(e), Ok(_) -> 0 }\n",
      b"spin",
    ),
  );
  assert(
    diverges(
      b"fn slide(a: Int, m: Int, n: Int) -> Int / {abort.raise} = if a % m < n { slide(a - 1, m, n - 1) } else { 0 }\n",
      b"slide",
    ),
  )
}

test "a value an `if` chooses, an element a helper finds, and a list made of parts descend" {
  let tree = b"type T = | Leaf | Node(T, T) | Many(List<T>)\n";
  assert(
    !diverges(
      tree.concat(
        b"fn left(t: T) -> Int = match t { Node(l, r) -> left(if l == Leaf { r } else { l }), _ -> 0 }\n",
      ),
      b"left",
    ),
  );
  let pick = b"fn pick(xs: List<T>, i: Int) -> T / {abort.raise} = match xs.at(i) { Some(x) -> x, None -> panic(\"none\") }\n";
  assert(
    !diverges(
      Bytes::concat_all([
        tree,
        pick,
        b"fn first(t: T) -> Int / {abort.raise} = match t { Many(kids) -> if kids.len() == 0 { 0 } else { first(pick(kids.map(|k: T| k), 0)) }, _ -> 0 }\n",
      ]),
      b"first",
    ),
  );
  let shapes = b"fn shape(t: T) -> Int = match t { Leaf -> 1, Node(a, b) -> shapes([a, b]), Many(ts) -> shapes(ts.map(|x: T| x)) }\nfn shapes(ts: List<T>) -> Int = ts.fold(0, |n: Int, x: T| n + shape(x))\n";
  assert(!diverges(tree.concat(shapes), b"shape"));
  assert(!diverges(tree.concat(shapes), b"shapes"));
  assert(
    diverges(
      tree.concat(
        b"fn shape(t: T) -> Int = match t { Leaf -> 1, Node(a, b) -> shapes([a, t]), Many(ts) -> shapes(ts) }\nfn shapes(ts: List<T>) -> Int = ts.fold(0, |n: Int, x: T| n + shape(x))\n",
      ),
      b"shape",
    ),
  )
}

test "a map's keys and values handed to `Map::fold`'s callback are parts of the map" {
  let tree = b"type T = | Leaf | Node(Map<Int, T>)\n";
  assert(
    !diverges(
      tree.concat(
        b"fn size(t: T) -> Int = match t { Node(kids) -> kids.fold(1, |n: Int, k: Int, c: T| n + size(c)), Leaf -> 1 }\n",
      ),
      b"size",
    ),
  );
  assert(
    diverges(
      tree.concat(
        b"fn worse(t: T) -> Int = match t { Node(kids) -> kids.fold(0, |n: Int, k: Int, c: T| n + worse(t)), Leaf -> 0 }\n",
      ),
      b"worse",
    ),
  )
}

test "lambdas bound by `let` are read where they are called, so many deep and no deeper" {
  let chain = |n: Int|
    Bytes::concat_all([
      b"fn down(n: Int) -> Int = {\n  let l0 = |x: Int| down(x);\n",
      Bytes::concat_all(
        range(1, n).map(|i: Int|
          Bytes::concat_all([
            b"  let l",
            ascii_of_int(i),
            b" = |x: Int| l",
            ascii_of_int(i - 1),
            b"(x);\n",
          ])),
      ),
      b"  if n <= 0 { 0 } else { l",
      ascii_of_int(n - 1),
      b"(n - 1) }\n}\n",
    ]);
  assert(!diverges(chain(8), b"down"));
  assert(diverges(chain(9), b"down"))
}

test "a function an `if` chooses is handed on as each branch is, and a loop that does not descend is told by its calls" {
  let each = b"type In = { room: Int }\nfn each(i: In, n: Int, f: (In, Int) -> Int) -> Int = range(0, n).fold(0, |acc: Int, k: Int| acc + f(i, k))\nfn top(i: In, k: Int) -> Int = if i.room <= 0 { 0 } else { inner({ ..i, room: i.room - 1 }, k) }\n";
  assert(
    !diverges(
      each.concat(
        b"fn inner(i: In, k: Int) -> Int = each(i, 3, if k > 1 { top } else { other })\nfn other(i: In, k: Int) -> Int = top(i, k)\n",
      ),
      b"top",
    ),
  );
  let src = b"fn ping(n: Int) -> Int = pong(n)\nfn pong(n: Int) -> Int = if n <= 0 { 0 } else { ping(n) }\n";
  let context = checked_context(src);
  match definition_of(context, b"m.ping") {
    Some(d) -> match d.ending {
      Diverges(x) ->
        assert_eq(x.loop.map(|s: Site| offset_of(context, s)), [
          match src.index_of(b"pong(n)\n") { Some(i) -> i, None -> -1 },
          match src.index_of(b"ping(n) }") { Some(i) -> i, None -> -1 },
        ]),
      _ -> assert(false),
    },
    None -> assert(false),
  }
}

test "a value with no parts is no larger than any" {
  assert(
    !diverges(
      b"type T = | Leaf | Node(T, T)\nfn walk(t: T) -> Int = match t { Node(l, r) -> step(l, None), Leaf -> 0 }\nfn step(t: T, extra: Option<T>) -> Int = match extra { Some(e) -> walk(e), None -> walk(t) }\n",
      b"walk",
    ),
  )
}

test "a constructor of one field around a part is no larger than what that is a part of" {
  let tree = b"type T = | Leaf | Node(List<T>)\n";
  assert(
    !diverges(
      tree.concat(
        b"fn kind(t: Option<T>) -> Int = match t { Some(Node(ts)) -> kinds(ts), _ -> 0 }\nfn kinds(ts: List<T>) -> Int = ts.fold(0, |n: Int, x: T| n + kind(Some(x)))\n",
      ),
      b"kind",
    ),
  );
  assert(
    diverges(
      tree.concat(
        b"fn grow(t: Option<T>) -> Int = match t { Some(x) -> grow(Some(Node([x]))), None -> 0 }\n",
      ),
      b"grow",
    ),
  )
}

test "what a recursive definition returns is read to a fixed point over its group" {
  let tree = b"type T = | Leaf | Node(List<T>)\nfn last(xs: List<T>) -> T / {abort.raise} = match xs { [x] -> x, [_, ..rest] -> last(rest), [] -> panic(\"empty\") }\n";
  assert(
    !diverges(
      tree.concat(
        b"fn depth(t: T) -> Int / {abort.raise} = match t { Node(kids) -> if kids.len() == 0 { 0 } else { 1 + depth(last(kids)) }, Leaf -> 0 }\n",
      ),
      b"depth",
    ),
  );
  assert(
    diverges(
      b"type T = | Leaf | Node(List<T>)\nfn same(t: T, n: Int) -> T = if n <= 0 { t } else { same(t, n - 1) }\nfn spin(t: T) -> Int = match t { Node(_) -> spin(same(t, 3)), Leaf -> 0 }\n",
      b"spin",
    ),
  )
}

test "effects may include diverges, the effect of a call that may not return" {
  assert_eq(check_codes(b"fn spin(n: Int) -> Int / {diverges} = spin(n)\n"), []);
  assert_eq(
    check_codes(
      b"fn spin(n: Int) -> Int / {diverges} = spin(n)\nfn use(n: Int) -> Int / {diverges} = spin(n)\n",
    ),
    [],
  );
  assert_eq(check_codes(b"fn spin(n: Int) -> Int / {div} = spin(n)\n"), [b"E0114"])
}

test "a numeric names a total function of its own sum for each operation, once" {
  let ops = b"fn add(a: N, b: N) -> N = a\nfn neg(a: N) -> N = a\nfn of(n: Int) -> N = N(n)\nfn bad(a: N, b: N) -> N / {abort.raise} = panic(\"no\")\n";
  let measured_definitions = |record: Bytes|
    check_codes(
      Bytes::concat_all([b"type N = | N(Int)\n", ops, b"numeric for N by ", record, b"\n"]),
    );
  let all = b"{ add: add, sub: add, mul: add, neg: neg, of_int: of }";
  assert_eq(measured_definitions(all), []);
  assert_eq(measured_definitions(Bytes::concat_all([all, b"\nnumeric for N by ", all])), [
    b"E0105",
  ]);
  assert_eq(measured_definitions(b"{ add: add, sub: add, mul: add, neg: neg }"), [b"E0215"]);
  assert_eq(
    measured_definitions(b"{ add: add, sub: add, mul: add, neg: neg, of_int: of, div: add }"),
    [b"E0215"],
  );
  assert_eq(
    measured_definitions(b"{ add: add, add: add, sub: add, mul: add, neg: neg, of_int: of }"),
    [b"E0215"],
  );
  assert_eq(measured_definitions(b"{ add: add, sub: add, mul: add, neg: neg, of_int: gone }"), [
    b"E0101",
  ]);
  assert_eq(measured_definitions(b"{ add: neg, sub: add, mul: add, neg: neg, of_int: of }"), [
    b"E0218",
  ]);
  assert_eq(measured_definitions(b"{ add: add, sub: add, mul: add, neg: neg, of_int: neg }"), [
    b"E0218",
  ]);
  assert_eq(measured_definitions(b"{ add: bad, sub: add, mul: add, neg: neg, of_int: of }"), [
    b"E0218",
  ]);
  assert_eq(check_codes(b"numeric for Option by { add: f }\n"), [b"E0208"]);
  assert_eq(check_codes(b"type N = Int\nnumeric for N by { add: f }\n"), [b"E0217"]);
  assert_eq(check_codes(b"type N = new { n: Int }\nnumeric for N by { add: f }\n"), [b"E0217"]);
  assert_eq(check_codes(b"type N<a> = | N(a)\nnumeric for N by { add: f }\n"), [b"E0216"])
}

test "an operator at a type that states numeric is its function, and what it does not state is rejected" {
  let n = b"type N = | N(Int)\nfn add(a: N, b: N) -> N = a\nfn neg(a: N) -> N = a\nfn of(n: Int) -> N = N(n)\nnumeric for N by { add: add, sub: add, mul: add, neg: neg, of_int: of }\n";
  let keyed = n.concat(b"fn k(a: N) -> Int = 0\nkey for N by k\n");
  let over = |src: Bytes, body: Bytes| check_codes(src.concat(body));
  assert_eq(over(n, b"fn f(a: N, b: N) -> N = a + b * a - -b"), []);
  assert_eq(over(n, b"fn f(a: N, b: N) -> N / {abort.raise} = a / b"), [b"E0201"]);
  assert_eq(over(n, b"fn f(a: N, b: N) -> N / {abort.raise} = a % b"), [b"E0201"]);
  assert_eq(over(n, b"fn f(a: N, b: N) -> Bool = a < b"), [b"E0201"]);
  assert_eq(over(keyed, b"fn f(a: N, b: N) -> Bool = a < b && a >= b"), []);
  assert_eq(over(n, b"fn f(a: N) -> N = a + 1"), [b"E0201"]);
  let sum = b"fn sum<a>(xs: List<a>) -> a where numeric(a) = xs.fold(numeric_of_int(0), |s: a, x: a| s + x)\n";
  assert_eq(over(keyed.concat(sum), b"fn f(xs: List<N>) -> N = sum(xs)"), []);
  assert_eq(over(n.concat(sum), b"fn f(xs: List<N>) -> N = sum(xs)"), [b"E0201"]);
  assert_eq(
    over(
      keyed,
      b"fn half<a>(x: a) -> a / {abort.raise} where integer(a) = x / numeric_of_int(2)\nfn f(a: N) -> N / {abort.raise} = half(a)",
    ),
    [b"E0201"],
  );
  assert_eq(check_codes(b"fn f<a>(x: a) -> a / {abort.raise} where numeric(a) = x % x"), [
    b"E0209",
  ]);
  assert_eq(check_codes(b"fn f<a>(x: a) -> a / {abort.raise} where integer(a) = x % x"), [])
}

test "a decimal is not divided by `/`, and the rejection says how to divide instead" {
  let diagnostics = source_diagnostics(
    b"pub fn unit(total: Decimal, count: Decimal) -> Decimal / {abort.raise} = total / count\n",
  );
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0209"]);
  assert(told(diagnostics).contains("Decimal::div"), Some(told(diagnostics)));
  assert(told(diagnostics).contains("rounding nobody wrote down"), Some(told(diagnostics)))
}

test "a wrapping or saturating operator is its builtin, over a builtin integer type and no other" {
  assert_eq(check_codes(b"fn f(a: U8, b: U8) -> U8 = a +% b *| a -| b -% a *% b +| a"), []);
  assert_eq(check_codes(b"fn f(a: Int, b: Int) -> Int = a +| b *% a"), []);
  assert_eq(check_codes(b"fn f(a: U8, b: U16) -> U8 = a +% b"), [b"E0201"]);
  assert_eq(
    source_diagnostics(b"fn f(a: Float, b: Float) -> Float = a +% b").map(
      |diagnostic: Diagnostic| diagnostic.message,
    ),
    [b"`+%` is not defined on `Float`"],
  );
  assert_eq(
    source_diagnostics(b"fn f(a: Float, b: Float) -> Float = wrap_add(a, b)").map(
      |diagnostic: Diagnostic| diagnostic.message,
    ),
    [b"`wrap_add` is not defined on `Float`"],
  );
  assert_eq(check_codes(b"fn f<a>(x: a, y: a) -> a where integer(a) = x *| y"), [b"E0210"]);
  assert_eq(
    source_diagnostics(b"fn f(a: Float, b: Float) -> Float = { let g = wrap_add; g(a, b) }").map(
      |diagnostic: Diagnostic| diagnostic.message,
    ),
    [b"`wrap_add` is not defined on `Float`"],
  );
  assert_eq(
    check_codes(b"fn f<a>(x: a) -> Option<a> where integer(a) = { let g = checked_neg; g(x) }"),
    [b"E0210"],
  );
  assert_eq(check_codes(b"fn f(xs: List<U8>) -> U8 = xs.fold(0u8, saturating_add)"), []);
  let n = b"type N = | N(Int)\nfn add(a: N, b: N) -> N = a\nfn neg(a: N) -> N = a\nfn of(n: Int) -> N = N(n)\nnumeric for N by { add: add, sub: add, mul: add, neg: neg, of_int: of }\n";
  let over = |body: Bytes| check_codes(n.concat(body));
  assert_eq(over(b"fn f(a: N, b: N) -> N = a +% b"), [b"E0223"]);
  assert_eq(over(b"fn f(a: N, b: N) -> N = a -| b"), [b"E0223"]);
  assert_eq(over(b"fn f(a: N, b: N) -> N = wrap_mul(a, b)"), [b"E0223"]);
  assert_eq(over(b"fn f(a: N, b: N) -> Option<N> = checked_add(a, b)"), [b"E0223"]);
  assert_eq(over(b"fn f(a: N) -> N = rotl(a, 1)"), [b"E0223"]);
  assert_eq(over(b"fn f(a: N, b: N) -> N = a & b"), [b"E0201", b"E0201"])
}

test "the builtins the operators are written in belong to no module and no binding around one" {
  assert_eq(check_codes(b"fn wrap_add(a: Int, b: Int) -> Int = 0"), [b"E0105"]);
  assert_eq(check_codes(b"fn saturating_mul(a: Int, b: Int) -> Int = 0"), [b"E0105"]);
  assert_eq(
    check_codes(b"fn rotl(a: Int, b: Int) -> Int = 0\nfn checked_add(a: Int) -> Int = a"),
    [],
  );
  let hidden = b"fn f(wrap_add: (Int, Int) -> Int, a: Int) -> Int = ";
  assert_eq(check_codes(hidden.concat(b"a +% a")), [b"E0105"]);
  assert_eq(check_codes(hidden.concat(b"wrap_add(a, a)")), []);
  assert_eq(check_codes(hidden.concat(b"a -% a")), []);
  assert_eq(
    check_codes(b"fn f(a: Int) -> Int = { let saturating_sub = 1; a -| saturating_sub }"),
    [b"E0105", b"E0204"],
  )
}

test "to_int reads any integer type, and no other" {
  assert_eq(
    check_codes(
      b"fn f(a: U8, b: I128, c: Int) -> List<Option<Int>> = [to_int(a), to_int(b), to_int(c)]",
    ),
    [],
  );
  assert_eq(check_codes(b"fn f<a>(x: a) -> Option<Int> where integer(a) = to_int(x)"), []);
  assert_eq(check_codes(b"fn f(a: Float) -> Option<Int> = to_int(a)"), [b"E0201"]);
  assert_eq(check_codes(b"fn f<a>(x: a) -> Option<Int> where numeric(a) = to_int(x)"), [b"E0201"]);
  assert_eq(check_codes(b"fn f<a>(x: a) -> Option<Int> = to_int(x)"), [b"E0201"])
}

test "a key is stated once, by its type's own module, for a sum" {
  let box = b"type Box = | Box(Int, Int)\nfn area(b: Box) -> Int = match b { Box(w, h) -> w * h }\n";
  assert_eq(check_codes(box.concat(b"key for Box by area\n")), []);
  assert_eq(check_codes(box.concat(b"key for Box by area\nkey for Box by area\n")), [b"E0105"]);
  assert_eq(check_codes(box.concat(b"key for Box by size\n")), [b"E0101"]);
  assert_eq(check_codes(b"fn f(o: Option<Int>) -> Int = 0\nkey for Option by f\n"), [b"E0208"]);
  assert_eq(check_codes(b"fn f(n: Int) -> Int = n\ntype Id = Int\nkey for Id by f\n"), [b"E0217"]);
  assert_eq(check_codes(b"type P = { x: Int }\nfn f(p: P) -> Int = p.x\nshow for P by f\n"), [
    b"E0217",
  ]);
  let record = b"type P = new { x: Int }\nfn f(p: P) -> Int = p.x\nfn g(p: P) -> String = \"p\"\n";
  assert_eq(check_codes(record.concat(b"key for P by f\n")), [b"E0217"]);
  assert_eq(check_codes(record.concat(b"show for P by g\n")), [b"E0217"]);
  assert_eq(
    check_codes(
      box.concat(
        b"fn text(b: Box) -> String = \"box\"\nkey for Box by area\nshow for Box by text\n",
      ),
    ),
    [],
  )
}

test "the function a key or a show names takes the value alone and only returns" {
  let over = |f: Bytes, measured_definitions: Bytes|
    check_codes(
      Bytes::concat_all([b"type Box<a> = | Box(a, Int)\n", f, b"\n", measured_definitions, b"\n"]),
    );
  assert_eq(
    over(b"fn k<a>(b: Box<a>) -> Int = match b { Box(_, n) -> n }", b"key for Box by k"),
    [],
  );
  assert_eq(
    over(b"fn k<a>(b: Box<a>) -> List<a> = match b { Box(x, _) -> [x] }", b"key for Box by k"),
    [],
  );
  assert_eq(over(b"fn k<a>(b: Box<a>, n: Int) -> Int = n", b"key for Box by k"), [b"E0218"]);
  assert_eq(over(b"fn k(b: Box<Int>) -> Int = 0", b"key for Box by k"), [b"E0218"]);
  assert_eq(over(b"fn k<a>(b: List<a>) -> Int = 0", b"key for Box by k"), [b"E0218"]);
  assert_eq(over(b"fn k<a, b>(x: Box<a>) -> List<b> = []", b"key for Box by k"), [b"E0218"]);
  assert_eq(
    over(b"fn k<a>(b: Box<a>) -> Int / {abort.raise} = panic(\"no\")", b"key for Box by k"),
    [b"E0218"],
  );
  assert_eq(over(b"fn k<a>(b: Box<a>) -> Int / {diverges} = k(b)", b"key for Box by k"), [
    b"E0218",
  ]);
  assert_eq(
    over(
      b"effect odd {\n  raise found(n: Int)\n}\nfn k<a>(b: Box<a>) -> Int / {odd.found} = match b { Box(_, n) -> if n > 0 { n } else { odd.found(n) } }",
      b"key for Box by k",
    ),
    [b"E0218"],
  );
  assert_eq(
    over(
      b"fn k<a>(b: Box<a>) -> a where numeric(a) = match b { Box(x, _) -> x + x }",
      b"key for Box by k",
    ),
    [b"E0218"],
  );
  assert_eq(over(b"fn s<a>(b: Box<a>) -> String = \"box\"", b"show for Box by s"), []);
  assert_eq(over(b"fn s<a>(b: Box<a>) -> Int = 0", b"show for Box by s"), [b"E0218"])
}

test "an invariant is stated once, by the module that alone builds its sum, of a function returning `Bool`" {
  let balance = b"pub opaque type Balance = | Balance(Int)\npub fn open() -> Balance = Balance(0)\n";
  let measured_definitions = |f: Bytes, more: Bytes|
    check_codes(Bytes::concat_all([balance, f, b"\ninvariant for Balance by valid\n", more]));
  let valid = b"fn valid(b: Balance) -> Bool = match b { Balance(n) -> n >= 0 }";
  assert_eq(measured_definitions(valid, b""), []);
  let c = checked_context(
    Bytes::concat_all([balance, valid, b"\ninvariant for Balance by valid\n"]),
  );
  assert_eq(
    c.instances.map(|x: InstanceInfo| (x.type_name, x.kind == InvariantInstance, x.by, x.results)),
    [(b"m.Balance", true, b"m.valid", bool_type())],
  );
  assert_eq(measured_definitions(valid, b"invariant for Balance by valid\n"), [b"E0105"]);
  assert_eq(
    measured_definitions(valid, b"fn ok(b: Balance) -> Int = 0\nkey for Balance by ok\n"),
    [],
  );
  assert_eq(c.keyed_names, []);
  assert_eq(measured_definitions(valid, b"fn same(a: Balance, b: Balance) -> Bool = a == b\n"), []);
  assert_eq(measured_definitions(b"fn valid(b: Balance) -> Int = 0", b""), [b"E0218"]);
  assert_eq(measured_definitions(b"fn valid(b: Balance, n: Int) -> Bool = n > 0", b""), [b"E0218"]);
  assert_eq(
    measured_definitions(b"fn valid(b: Balance) -> Bool / {abort.raise} = panic(\"no\")", b""),
    [b"E0218"],
  );
  assert_eq(measured_definitions(b"fn valid(b: Balance) -> Bool / {diverges} = valid(b)", b""), [
    b"E0218",
  ]);
  assert_eq(
    check_codes(b"fn valid(o: Option<Int>) -> Bool = true\ninvariant for Option by valid\n"),
    [b"E0208"],
  );
  let record = source_diagnostics(
    b"type P = new { x: Int }\nfn valid(p: P) -> Bool = p.x > 0\ninvariant for P by valid\n",
  );
  assert_eq(record.map(|d: Diagnostic| (d.code, d.message)), [
    (b"E0217", b"`P` is a `new` record, which cannot state an `invariant` yet"),
  ]);
  assert(
    record.any(|d: Diagnostic|
      d.notes_text.any(|n: Bytes| n.contains(b"where a constructor of the type is applied"))),
  );
  let shown = b"pub type Balance = | Balance(Int)\nfn valid(b: Balance) -> Bool = true\ninvariant for Balance by valid\n";
  assert_eq(rejected_at(shown, b"invariant for Balance by valid"), [
    {
      code: b"E0480",
      message: b"an invariant for `Balance`, a type other modules build",
      on_name: true,
    },
  ]);
  let unexported = b"type Balance = | Balance(Int)\nfn valid(b: Balance) -> Bool = true\ninvariant for Balance by valid\n";
  assert_eq(check_codes(unexported), [])
}

test "a default names no constructor of a type that states an invariant: each call that omits it builds the value" {
  let defaulted = |param: Bytes|
    Bytes::concat_all([
      b"opaque type Balance = | Balance(Int)\nfn valid(b: Balance) -> Bool = true\ninvariant for Balance by valid\nfn pay(",
      param,
      b") -> Int = 0\n",
    ]);
  assert_eq(rejected_at(defaulted(b"b: Balance = Balance(5)"), b"Balance(5)"), [
    {
      code: b"E0480",
      message: b"a parameter default cannot build `Balance`, which states an invariant",
      on_name: true,
    },
  ]);
  assert_eq(check_codes(defaulted(b"o: Option<Balance> = Some(Balance(1))")), [b"E0480"]);
  assert_eq(check_codes(defaulted(b"f: (Int) -> Balance = Balance")), [b"E0480"]);
  assert_eq(check_codes(defaulted(b"bs: List<Balance> = []")), [])
}

test "a key's function is at the type's own effects, and a type that binds a label states none" {
  let keyed = |ty: Bytes, f: Bytes|
    check_codes(Bytes::concat_all([ty, b"\n", f, b"\nkey for T by k\n"]));
  let hook = b"type T<a | e> = | T(Int, (a) -> Unit / e)";
  assert_eq(keyed(hook, b"fn k<a | e>(t: T<a | e>) -> Int = match t { T(n, _) -> n }"), []);
  assert_eq(keyed(hook, b"fn k<a>(t: T<a | {}>) -> Int = 0"), [b"E0218"]);
  let pipe = b"type T<| e, f> = | T(() -> Unit / e, () -> Unit / f)";
  assert_eq(keyed(pipe, b"fn k<| e, f>(t: T<| e, f>) -> Int = 0"), []);
  assert_eq(keyed(pipe, b"fn k<| e>(t: T<| e, e>) -> Int = 0"), [b"E0218"]);
  let sink = b"effect log {\n  write note[l](line: String) -> Unit\n}\ntype T<[l]> = | T((String) -> Unit / {log.note[l]}) | Quiet";
  assert_eq(keyed(sink, b"fn k<[l]>(t: T<[l]>) -> Int = 0"), [b"E0218"]);
  assert_eq(keyed(sink, b"fn k(t: T<[app]>) -> Int = 0"), [b"E0218"])
}

test "a declared type that keys a `Map` by its parameter carries the parameter's order into each signature naming it" {
  let bag = b"type Bag<a> = | Bag(Map<a, Int>)\n";
  assert_eq(
    check_codes(bag.concat(b"fn size<a>(b: Bag<a>) -> Int = match b { Bag(m) -> m.len() }\n")),
    [],
  );
  assert_eq(
    check_codes(
      bag.concat(b"fn none<a>() -> Bag<a> = Bag(Map::new())\nfn floats() -> Bag<Float> = none()\n"),
    ),
    [b"E0206"],
  );
  assert_eq(
    check_codes(
      b"type Ranked<a> = new { by: Map<a, Int> }\ntype Held<a> = | Held(List<Ranked<a>>)\nfn first<a>(h: Held<a>) -> Int = match h { Held(rs) -> match rs.at(0) { Some(r) -> r.by.len(), None -> 0 } }\n",
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"type Box<a> = | Box(a)\nfn keyed<a>(b: Box<a>, x: a) -> Ordering = compare(x, x)\n",
    ),
    [b"E0206"],
  );
  assert_eq(
    check_codes(
      bag.concat(
        b"key for Bag by items\nshow for Bag by shown\nfn items<a>(b: Bag<a>) -> Map<a, Int> = match b { Bag(m) -> m }\nfn shown<a>(b: Bag<a>) -> String = items(b).len().to_string()\n",
      ),
    ),
    [],
  )
}

test "a signature that names a `Map` keyed by its parameter implies the parameter's order" {
  let size = b"fn size<k>(m: Map<k, Int>) -> Int = m.len()\n";
  let empty = b"fn empty<k>() -> Map<k, Int> = Map::new()\n";
  assert_eq(check_codes(size.concat(empty)), []);
  assert_eq(
    check_codes(b"fn size<k>(m: Map<k, Int>) -> Int where derivable(ord, k) = m.len()\n"),
    [],
  );
  assert_eq(check_codes(b"fn c<k>(m: Map<k, Int>, a: k, b: k) -> Ordering = compare(a, b)\n"), []);
  assert_eq(check_codes(b"fn c<k>(a: k, b: k) -> Ordering = compare(a, b)\n"), [b"E0206"]);
  assert_eq(
    check_codes(size.concat(b"fn floats(x: Float) -> Int = size(Map::new().insert(x, 1))\n")),
    [b"E0206"],
  );
  assert_eq(
    check_codes(empty.concat(b"fn floats(x: Float) -> Int = empty().insert(x, 1).len()\n")),
    [b"E0206"],
  )
}

test "a `key` or a `show` names no function constrained beyond the order its type carries" {
  let t = b"type T<a> = | T(List<a>)\n";
  let counted = b"fn counted<a>(t: T<a>) -> Map<a, Int> = match t { T(xs) -> xs.fold(Map::new(), |m: Map<a, Int>, x: a| m.insert(x, 1)) }\n";
  assert_eq(
    check_codes(
      Bytes::concat_all([
        t,
        b"key for T by counted\n",
        counted,
        b"fn bad() -> Bool = T([1.5]) == T([2.5])\n",
      ]),
    ),
    [b"E0218"],
  );
  assert_eq(
    check_codes(
      t.concat(
        b"show for T by shown\nfn shown<a>(t: T<a>) -> String where derivable(ord, a) = \"t\"\n",
      ),
    ),
    [b"E0218"],
  );
  let bag = b"type Bag<a> = | Bag(Map<a, Int>)\n";
  assert_eq(
    check_codes(
      Bytes::concat_all([
        t,
        bag,
        b"key for T by bagged\nfn bagged<a>(t: T<a>) -> Bag<a> = Bag(Map::new())\n",
      ]),
    ),
    [b"E0218"],
  );
  assert_eq(
    check_codes(
      bag.concat(
        b"key for Bag by items\nfn items<a>(b: Bag<a>) -> Map<a, Int> where derivable(ord, a) = match b { Bag(m) -> m }\n",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      bag.concat(
        b"key for Bag by items\nfn items<a>(b: Bag<a>) -> List<a> where derivable(eq, a) = match b { Bag(m) -> m.keys() }\n",
      ),
    ),
    [b"E0218"],
  )
}

test "an effect that declares no operation is named by its mode, which nothing performs or handles" {
  let asked = b"nondet effect asked {}\nfn f() -> Int / {asked.read} = 1\n";
  assert_eq(check_codes(asked), []);
  assert_eq(check_codes(asked.concat(b"test \"t\" { assert(f() == 1) }\n")), [b"E0412"]);
  assert_eq(check_codes(b"effect asked {}\nfn f() -> Int / {asked.ask} = 1\n"), [b"E0104"])
}

fn host_handler_sources(rest: Bytes) -> List<Source> =
  [
    {
      name: b"std.fact",
      src: Bytes::concat_all([
        b"pub effect fact {\n  read get() -> Int\n  write put[r](x: Int) -> Unit\n  raise lost(why: String)\n}\n",
        rest,
      ]),
    },
    { name: b"m", src: b"import std.fact (fact)\nfn main() -> Int / {fact.get} = fact.get()\n" },
  ]

fn host_handler_source(go: Bytes, result: Bytes, body: Bytes) -> Bytes =
  Bytes::concat_all([
    b"host for fact by served\nfn served<a | e>(go: () -> a / ",
    go,
    b") -> ",
    result,
    b" = ",
    body,
    b"\n",
  ])

fn handled_body() -> Bytes = b"handle { go() } with { fact.get() -> 7, fact.put[*](x) -> () }"

test "an effect's host handler handles every read and write of it on every label, and only its module's toolchain declares one" {
  let whole = b"{fact.get, fact.put[*] | e}";
  assert_eq(
    codes_of(host_handler_sources(host_handler_source(whole, b"a / e", handled_body()))),
    [],
  );
  assert_eq(
    codes_of(
      host_handler_sources(host_handler_source(whole, b"a / {fact.lost | e}", handled_body())),
    ),
    [],
  );
  assert_eq(
    codes_of([
      {
        name: b"tools.fact",
        src: Bytes::concat_all([
          b"pub effect fact {\n  read get() -> Int\n}\n",
          b"host for fact by served\nfn served<a | e>(go: () -> a / {fact.get | e}) -> a / e = handle { go() } with { fact.get() -> 7 }\n",
        ]),
      },
    ]),
    [b"E0161"],
  );
  assert_eq(
    codes_of(host_handler_sources(b"host for other by served\nfn served() -> Int = 1\n")),
    [b"E0162"],
  );
  assert_eq(
    codes_of(
      host_handler_sources(
        host_handler_source(whole, b"a / e", handled_body()).concat(b"host for fact by served\n"),
      ),
    ),
    [b"E0163"],
  );
  assert_eq(codes_of(host_handler_sources(b"host for fact by absent\n")), [b"E0164"]);
  let unfit = |go: Bytes, result: Bytes, body: Bytes|
    codes_of(host_handler_sources(host_handler_source(go, result, body)));
  assert_eq(unfit(b"{fact.get | e}", b"a / e", b"handle { go() } with { fact.get() -> 7 }"), [
    b"E0164",
  ]);
  assert_eq(unfit(b"{fact.get, fact.put[here] | e}", b"a / e", handled_body()), [b"E0164"]);
  assert_eq(unfit(whole, b"Option<a> / e", b"Some(".concat(handled_body()).concat(b")")), [
    b"E0164",
  ]);
  assert_eq(unfit(whole, b"a / {fact.get, fact.put[*] | e}", b"go()"), [b"E0164"]);
  assert_eq(
    codes_of(
      host_handler_sources(
        b"host for fact by served\nfn served<a | e>(n: Int, go: () -> a / {fact.get, fact.put[*] | e}) -> a / e = handle { go() } with { fact.get() -> n, fact.put[*](x) -> () }\n",
      ),
    ),
    [b"E0164"],
  );
  assert_eq(
    codes_of(
      host_handler_sources(
        b"host for fact by served\nfn served<a | e>(go: () -> a / {fact.get, fact.put[*] | e}) -> a / e where derivable(eq, a) = handle { go() } with { fact.get() -> 7, fact.put[*](x) -> () }\n",
      ),
    ),
    [b"E0164"],
  );
  let other = {
    name: b"std.clock",
    src: b"pub effect tick {\n  read now() -> Int\n}\nhost for tick by ticked\nfn ticked<a | e>(go: () -> a / {tick.now | e}) -> a / e = handle { go() } with { tick.now() -> 0 }\n",
  };
  let ticking = {
    name: b"std.fact",
    src: b"import std.clock (tick)\npub effect fact {\n  read get() -> Int\n}\nhost for fact by served\nfn served<a | e>(go: () -> a / {fact.get | e}) -> a / {tick.now | e} = handle { go() } with { fact.get() -> tick.now() }\n",
  };
  assert_eq(codes_of([other, ticking]), [b"E0164"])
}

test "a type that keys a `Map` by its parameter is ordered wherever it is written or built" {
  let opt = b"type Opt<a> = | Plain(a) | Keyed(Map<a, Int>)\n";
  assert_eq(
    check_codes(
      opt.concat(
        b"key for Opt by k\nfn k<a>(o: Opt<a>) -> Int = match o { Plain(x) -> Map::new().insert(x, 1).len(), Keyed(m) -> m.len() }\nfn bad() -> Bool = Plain(1.5) == Plain(2.5)\n",
      ),
    ),
    [b"E0206"],
  );
  assert_eq(check_codes(opt.concat(b"fn floats() -> Opt<Float> = Keyed(Map::new())\n")), [
    b"E0206",
  ]);
  assert_eq(check_codes(opt.concat(b"fn ints() -> Bool = Plain(1) == Plain(2)\n")), []);
  assert_eq(
    check_codes(
      b"type S<a> = | S(List<Map<a, Int>>) | P(a)\nshow for S by shown\nfn shown<a>(s: S<a>) -> String = match s { P(x) -> Map::new().insert(x, 1).len().to_string(), S(_) -> \"s\" }\nfn bad() -> String = shown(P(1.5))\n",
    ),
    [b"E0206"],
  );
  let nested = b"type Opt2<a> = | N | S(Map<a, Int>)\ntype T<a> = | T(Opt2<a>, a)\n";
  assert_eq(check_codes(nested.concat(b"fn bad() -> Int = { let _ = T(N, 1.5); 0 }\n")), [
    b"E0206",
  ]);
  assert_eq(check_codes(nested.concat(b"fn good() -> Int = { let _ = T(N, 1); 0 }\n")), []);
  assert_eq(check_codes(opt.concat(b"type W = | W(Opt<Float>)\n")), [b"E0206"]);
  assert_eq(check_codes(opt.concat(b"type R = new { o: Opt<(Int) -> Int> }\n")), [b"E0206"]);
  assert_eq(check_codes(opt.concat(b"type W<a> = | W(Opt<a>)\n")), []);
  assert_eq(check_codes(opt.concat(b"fn wrap<a>(x: a) -> Int = { let _ = Plain(x); 0 }\n")), [
    b"E0206",
  ]);
  assert_eq(check_codes(opt.concat(b"fn wrap<a>(x: a) -> Opt<a> = Plain(x)\n")), [])
}

test "a type that carries an order is judged once, where it is written, and calls nothing" {
  let opt = b"type Opt<a> = | Plain(a) | Keyed(Map<a, Int>)\n";
  assert_eq(
    check_codes(
      opt.concat(
        b"type T = | T(Int)\nkey for T by k\nfn k(t: T) -> Int = match t { T(n) -> { let _ = Plain(t); n } }\n",
      ),
    ),
    [],
  );
  assert_eq(check_codes(opt.concat(b"fn f(o: Opt<Float>) -> Int = 0\n")), [b"E0206"]);
  assert_eq(check_codes(opt.concat(b"type A = Opt<Float>\nfn f(o: A) -> Int = 0\n")), [b"E0206"]);
  assert_eq(
    check_codes(opt.concat(b"fn f() -> Int = { let o: Option<Opt<Float>> = None; 0 }\n")),
    [b"E0206"],
  );
  assert_eq(check_codes(opt.concat(b"law \"l\" forall (o: Opt<Float>) { true }\n")), [b"E0206"]);
  assert_eq(
    check_codes(
      b"type Bag<a> = new { m: Map<a, Int> }\ntype B = Bag<Float>\ntype S = | S(B)\nfn f(b: B) -> Int = 0\n",
    ),
    [b"E0206", b"E0206"],
  );
  assert_eq(check_codes(opt.concat(b"fn f(m: Map<Opt<Float>, Int>) -> Int = m.len()\n")), [
    b"E0206",
  ]);
  assert_eq(
    check_codes(
      opt.concat(b"type W = | W(Opt<Float>)\nfn g() -> Int = { let _ = W; let _ = W; 0 }\n"),
    ),
    [b"E0206"],
  )
}

test "a part of a type nothing pinned hides no other part a constraint rejects" {
  let needs = b"fn needs<a>(x: a) -> Int where derivable(ord, a) = Map::new().insert(x, 1).len()\n";
  assert_eq(check_codes(needs.concat(b"fn f() -> Int = needs(([], 1.5))\n")), [b"E0206"]);
  assert_eq(check_codes(needs.concat(b"fn f() -> Int = needs(([], 1))\n")), []);
  assert_eq(
    check_codes(
      b"type Bag<a> = | Bag(Map<a, Int>)\nfn f<a>(b: Option<Bag<a>>, x: a) -> Int = Map::new().insert(x, 1).len()\nfn g() -> Int = f(None, ([], 1.5))\n",
    ),
    [b"E0206"],
  )
}

test "an implied order is what ordering the key reads, not every parameter the key writes" {
  let id = b"type Id<a> = | Id(Int)\n";
  assert_eq(
    check_codes(
      id.concat(
        b"fn lookup<a>(m: Map<Id<a>, a>, id: Id<a>) -> Option<a> = m.get(id)\nfn f() -> Option<(Int) -> Int> = lookup(Map::new(), Id(1))\n",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(id.concat(b"fn c<a>(m: Map<Id<a>, Int>, x: a) -> Ordering = compare(x, x)\n")),
    [b"E0206"],
  );
  assert_eq(
    check_codes(
      id.concat(
        b"type ById<a> = Map<Id<a>, a>\nfn size<a>(m: ById<a>) -> Int = m.len()\nfn f(m: ById<(Int) -> Int>) -> Int = size(m)\n",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      id.concat(
        b"type Tagged<a> = | Tagged(Map<Id<a>, Int>)\nfn size<a>(t: Tagged<a>) -> Int = match t { Tagged(m) -> m.len() }\nfn f(t: Tagged<(Int) -> Int>) -> Int = size(t)\n",
      ),
    ),
    [],
  );
  let k = b"type K<a> = | K(a, Int)\nkey for K by kk\n";
  assert_eq(
    check_codes(
      k.concat(
        b"fn kk<a>(k: K<a>) -> Int = match k { K(_, n) -> n }\nfn size<a>(m: Map<K<a>, Int>) -> Int = m.len()\nfn f(m: Map<K<(Int) -> Int>, Int>) -> Int = size(m)\n",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      k.concat(
        b"fn kk<a>(k: K<a>) -> List<a> = match k { K(x, _) -> [x] }\nfn c<a>(m: Map<K<a>, Int>, x: a) -> Ordering = compare(x, x)\n",
      ),
    ),
    [],
  )
}

test "a part of a `Map` key nothing pinned hides no other part that has no order" {
  let pair = b"fn pair<j, k>(m: Map<(j, k), Int>, x: k, y: k) -> Ordering where derivable(ord, j), derivable(ord, k) = compare(x, y)\n";
  assert_eq(check_codes(pair.concat(b"fn f() -> Ordering = pair(Map::new(), 1.5, 2.5)\n")), [
    b"E0206",
  ]);
  assert_eq(check_codes(pair.concat(b"fn f() -> Ordering = pair(Map::new(), 1, 2)\n")), []);
  assert_eq(check_codes(b"fn f(x: Float) -> Int = Map::new().insert(([], x), 1).len()\n"), [
    b"E0206",
  ]);
  assert_eq(check_codes(b"fn f() -> Int = Map::new().len()\n"), [])
}

test "a deterministic test that reaches a nondeterministic operation on a channel is rejected" {
  assert_eq(
    check_codes(
      tracing().concat(
        b"test \"this cannot be deterministic\" {\n  trace.event[orders](\"x\")\n}\n",
      ),
    ),
    [b"E0412"],
  )
}

fn needs_order() -> Bytes = b"fn needs<a>(x: a) -> Int where derivable(ord, a) = 1\n"

test "a constraint nothing can satisfy is rejected at the boundary it crosses, however it travels" {
  let needs = needs_order();
  [
    needs.concat(b"fn go() -> Int = needs(1.5)"),
    b"fn needs<a>(xs: List<a>) -> Int where derivable(ord, a) = 1\nfn go() -> Int = needs([1.5])",
    needs.concat(
      b"fn apply(f: (Float) -> Int, x: Float) -> Int = f(x)\nfn go() -> Int = apply(needs, 1.5)",
    ),
    needs.concat(b"fn go() -> Int = { let f = |x: Float| needs(x); f(1.5) }"),
    needs.concat(b"fn caller<a>(x: a) -> Int where derivable(eq, a) = needs(x)"),
    Bytes::concat_all([
      b"type Money = Cents(Float)\n",
      needs,
      b"fn go() -> Int = needs(Cents(1.5))",
    ]),
    Bytes::concat_all([
      b"type Chain = Nil | Link(Float, Chain)\n",
      needs,
      b"fn go() -> Int = needs(Nil)",
    ]),
    Bytes::concat_all([b"type Box<a> = B(a)\n", needs, b"fn go() -> Int = needs(B(1.5))"]),
    b"type Money = Cents(Float)\nfn inner<a>(x: a) -> Int where derivable(ord, a) = 1\nfn outer<a>(x: a) -> Int where derivable(ord, a) = inner(x)\nfn go() -> Int = outer(Cents(1.5))",
  ].fold((), |u: Unit, src: Bytes|
    assert(check_codes(src).contains(b"E0206"), Some(String::of_bytes_lossy(src))))
}

test "a constraint a call can satisfy is assumed inside the body" {
  [
    needs_order().concat(b"fn go() -> Int = needs(1)"),
    b"fn keyed<k>(x: k) -> Map<k, Int> where derivable(ord, k) = Map::new().insert(x, 1)\nfn go() -> Int = keyed(\"a\").len()",
    b"fn inner<a>(x: a) -> Int where derivable(ord, a) = 1\nfn outer<a>(x: a) -> Int where derivable(ord, a) = inner(x)\nfn go() -> Int = outer(1)",
    Bytes::concat_all([
      b"type Money = Cents(Decimal)\n",
      needs_order(),
      b"fn go() -> Int = needs(Cents(1.5m))",
    ]),
  ].fold((), |u: Unit, src: Bytes|
    assert(check_codes(src) == [], Some(String::of_bytes_lossy(src))))
}

test "a map key the check infers is held to an order as a written one is" {
  [
    b"fn go() -> Int = Map::new().insert(1.5, 1).len()",
    b"type Money = Cents(Float)\nfn go() -> Int = Map::new().insert(Cents(1.5), 1).len()",
    b"fn go() -> Int = Map::of_entries([{key: 1.5, value: 1}]).len()",
    b"fn go() -> Int = Map::new().insert({rate: 1.5}, 1).len()",
    b"fn go() -> Int = Map::new().insert([1.5], 1).len()",
  ].fold((), |u: Unit, src: Bytes|
    assert(check_codes(src).contains(b"E0206"), Some(String::of_bytes_lossy(src))));
  assert_eq(check_codes(b"fn go() -> Int = Map::new().insert(\"k\", 1.5).len()"), [])
}

test "an alias keyed by its parameter is rejected where a use names it at a key with no order" {
  let alias = b"pub type Set<a> = Map<a, Unit>\n";
  assert_eq(check_codes(alias.concat(b"pub fn size<a>(s: Set<a>) -> Int = s.len()")), []);
  let diagnostics = source_diagnostics(
    alias.concat(b"pub fn size(s: Set<Float>) -> Int = s.len()"),
  );
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0206"]);
  assert(diagnostics.get(0).labels.get(0).start >= alias.len(), Some(told(diagnostics)))
}

fn sets() -> Source =
  {
    name: b"std.set",
    src: b"pub opaque type Set<a> = | Set(Map<a, Unit>)\npub fn Set::empty<a>() -> Set<a> = Set(Map::new())\npub fn Set::of_list<a>(xs: List<a>) -> Set<a> = Set(Map::new())\npub fn Set::min<a>(s: Set<a>) -> Option<a> = None\n",
  }

test "a set literal is `std.set`'s set, whose type carries its elements' order" {
  let checked = |src: Bytes| codes_across([sets(), { name: b"m", src: src }]);
  assert_eq(
    checked(
      b"import std.set\nimport std.set (Set)\npub fn least<a>(s: Set<a>) -> Option<a> = s.min()\npub fn two() -> Set<Int> = #[2, 1]\n",
    ),
    [],
  );
  assert(
    checked(
      b"import std.set\nimport std.set (Set)\npub fn floats() -> Set<Float> = Set::empty()\n",
    ).contains(
      b"E0206",
    ),
    None,
  );
  assert(checked(b"pub fn m() -> Map<Int, Unit> = #[1]\n").contains(b"E0201"), None)
}

fn game() -> Bytes = b"pub type Game<a> where derivable(eq, a) = { same: (a, a) -> Bool }\n"

fn same_of_game() -> Bytes = b"pub fn same<a>(g: Game<a>, x: a, y: a) -> Bool = x == y\n"

test "a type's `where` is assumed by a signature that names the type, and met by its callers" {
  assert_eq(check_codes(game().concat(same_of_game())), []);
  let rejected = source_diagnostics(
    Bytes::concat_all([
      game(),
      same_of_game(),
      b"fn go() -> Bool = same({ same: |f: (Int) -> Int, g: (Int) -> Int| true }, |a: Int| a, |b: Int| b)\n",
    ]),
  );
  assert_eq(rejected.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0206"]);
  assert(told(rejected).contains("requires `derivable(eq, ·)`"), Some(told(rejected)));
  assert_eq(
    check_codes(
      game().concat(
        b"pub fn same<a>(g: Game<a>, x: a, y: a) -> Bool where derivable(eq, a) = x == y\n",
      ),
    ),
    [],
  )
}

test "a type's `where` is met wherever the type is named at a type that cannot meet it" {
  [
    game().concat(b"fn bad(g: Game<(Int) -> Int>) -> Int = 1\n"),
    game().concat(
      b"pub fn perfect<a>(same: keep (a, a) -> Bool) -> Game<a> = { same: same }\nfn go() -> Game<(Int) -> Int> = perfect(|x: Int, y: Int| x == y)\n",
    ),
  ].fold((), |u: Unit, src: Bytes|
    assert(check_codes(src).contains(b"E0206"), Some(String::of_bytes_lossy(src))))
}

test "a declaration whose field names a constrained type at its parameter carries the constraint" {
  let node = game().concat(b"pub opaque type Node<a> = | Node(Game<a>, List<Node<a>>)\n");
  let find = b"pub fn find<a>(n: Node<a>, x: a, y: a) -> Bool = x == y\n";
  assert_eq(check_codes(node.concat(find)), []);
  assert(
    check_codes(
      Bytes::concat_all([
        node,
        find,
        b"fn go() -> Bool = find(Node({ same: |f: (Int) -> Int, g: (Int) -> Int| true }, []), |a: Int| a, |b: Int| b)\n",
      ]),
    ).contains(
      b"E0206",
    ),
    None,
  );
  assert_eq(
    check_codes(
      game().concat(
        b"pub type Boxed<a> = new { game: Game<a> }\npub fn find<a>(b: Boxed<a>, x: a, y: a) -> Bool = x == y\n",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"pub opaque type Node<a> where derivable(eq, a) = | Node(List<Node<a>>, a)\npub fn has<a>(n: Node<a>, x: a) -> Bool = match n { Node(_, here) -> here == x }\n",
    ),
    [],
  )
}

test "a `key` may need what its type's `where` states, and no more" {
  let node = b"pub opaque type Node<a> where derivable(eq, a) = | Node(a, List<Node<a>>)\n";
  assert_eq(
    check_codes(
      node.concat(
        b"pub fn head<a>(n: Node<a>) -> a = match n { Node(x, _) -> x }\nkey for Node by head\n",
      ),
    ),
    [],
  );
  assert(
    check_codes(
      node.concat(
        b"pub fn head<a>(n: Node<a>) -> a where derivable(ord, a) = match n { Node(x, _) -> x }\nkey for Node by head\n",
      ),
    ).contains(
      b"E0218",
    ),
    None,
  )
}

test "a type's `where` names its own parameters, and no predicate" {
  assert(check_codes(b"type X<a> where derivable(eq, b) = a").contains(b"E0102"), None);
  assert(check_codes(b"type X<a> where numeric(a) = a").contains(b"E0102"), None)
}

test "no route lets a float become a map key" {
  let src = b"import n\nfn a() -> Map<n::Wrapper, Int> = Map::new()\nfn b() -> Map<n::Recursive, Int> = Map::new()\nfn c() -> Map<n::Box<Float>, Int> = Map::new()\nfn d() -> Map<n::Alias, Int> = Map::new()\nfn e() -> Map<{x: Float}, Int> = Map::new()\nfn f() -> Map<Option<Float>, Int> = Map::new()\nfn g() -> Map<Map<n::Wrapper, Int>, Int> = Map::new()\nfn keyed<k>(x: k) -> Map<k, Int> = Map::new().insert(x, 1)\nfn h() -> Bool = { let _ = keyed(1.0); true }\nfn needs<a>(x: a) -> Int where derivable(ord, a) = 1\nfn i() -> Int = needs(1.0)\n";
  let diagnostics = errors_across([
    {
      name: b"n",
      src: b"pub type Wrapper = W(Float)\npub type Recursive = Nil | Cons(Float, Recursive)\npub type Box<a> = { v: a }\npub type Alias = Float\n",
    },
    { name: b"m", src: src },
  ]);
  let said = diagnostics.map(|diagnostic: Diagnostic| told([diagnostic]));
  [
    "`n.Wrapper`",
    "`n.Recursive`",
    "`{v: Float}`",
    "`{x: Float}`",
    "`Option<Float>`",
    "`Map<n.Wrapper, Int>`",
    "`Float` cannot be derived for `ord`",
  ].fold((), |u: Unit, named: String|
    assert(
      said.any(|s: String| s.contains(named)),
      Some(named ++ ": " ++ String::join(said, "\n")),
    ));
  let rejected_on = |line: Bytes| {
    let start = src.index_of(line).unwrap_or(0);
    let end = start + src.slice(start, src.len()).index_of(b"\n").unwrap_or(0);
    diagnostics.any(|diagnostic: Diagnostic|
      diagnostic.code == b"E0206"
        && diagnostic.labels.any(|label: Label|
          label.module == 1 && label.start >= start && label.start < end))
  };
  assert_eq(
    [
      b"fn a()",
      b"fn b()",
      b"fn c()",
      b"fn d()",
      b"fn e()",
      b"fn f()",
      b"fn g()",
      b"fn h()",
      b"fn i()",
    ].filter(|line: Bytes| !rejected_on(line)),
    [],
  )
}

test "a derived body naming a codec its module does not import is rejected once, naming the import" {
  let diagnostics = errors_across(
    [
      { name: b"lib.bin", src: b"pub fn derive(n: Int) -> Int = n\n" },
      { name: b"kinds", src: b"pub type Mode = | Read | Write\npub fn mode_bin() -> Int = 1\n" },
      {
        name: b"m",
        src: b"import lib.bin as bin\nimport kinds (Mode)\npub type Atom = { mode: Mode, n: Int }\nderive bin for Atom\n",
      },
    ],
    library: Some(|ask: DeriverRequest| Generated(b"pub fn atom_bin() -> Int = mode_bin() + 1")),
  );
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0206"]);
  assert(told(diagnostics).contains("add `import kinds (mode_bin)`"), Some(told(diagnostics)))
}

test "an operation's `Map` key implies its order, which each perform meets and each handler assumes" {
  let store = b"effect store { write keyed<a>(x: a) -> Map<a, Int> }\n";
  assert_eq(check_codes(store), []);
  assert_eq(
    check_codes(
      store.concat(
        b"fn go() -> Int = handle { store.keyed(1).len() } with { store.keyed(x) -> Map::new().insert(x, 1) }\n",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      store.concat(b"fn go(x: Float) -> Bool / {store.keyed} = { let _ = store.keyed(x); true }\n"),
    ),
    [b"E0206"],
  );
  assert_eq(check_codes(b"effect store { write floats(x: Int) -> Map<Float, Int> }\n"), [b"E0206"]);
  let bad = b"effect bad { raise oops(m: Map<Float, Int>) }\n";
  assert_eq(
    check_codes(
      bad.concat(
        b"fn f(m: Map<Float, Int>) -> Int / {bad.oops} = if m.len() > 0 { bad.oops(m) } else { bad.oops(m) }\n",
      ),
    ),
    check_codes(bad.concat(b"fn f(m: Map<Float, Int>) -> Int = 0\n")),
  );
  let wrap = b"type Wrap<a> = new { m: Map<a, Int> }\ntype Box<a> = | Box(a)\n";
  assert_eq(
    check_codes(
      wrap.concat(
        b"effect cmp { write same<a>(w: Wrap<a>, x: a) -> Ordering }\nfn empty<a>() -> Wrap<a> = { m: Map::new() }\nfn go() -> Ordering = handle { cmp.same(empty(), 1) } with { cmp.same(w, x) -> compare(x, x) }\n",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      wrap.concat(
        b"effect cmp { write same<a>(w: Box<a>, x: a) -> Ordering }\nfn go() -> Ordering = handle { cmp.same(Box(1), 1) } with { cmp.same(w, x) -> compare(x, x) }\n",
      ),
    ),
    [b"E0206"],
  );
  assert_eq(
    check_codes(
      wrap.concat(
        b"effect cmp { write same<a>(w: Wrap<a>, x: a) -> Ordering }\nfn go(w: Wrap<Float>) -> Ordering / {cmp.same} = cmp.same(w, 1.5)\n",
      ),
    ),
    [b"E0206"],
  );
  assert_eq(check_codes(wrap.concat(b"effect e { write put(w: Wrap<Float>) -> Unit }\n")), [
    b"E0206",
  ]);
  assert_eq(
    check_codes(wrap.concat(b"effect e { write put<a>(w: Wrap<(a, Float)>, x: a) -> Unit }\n")),
    [b"E0206"],
  );
  assert_eq(
    check_codes(wrap.concat(b"effect e { write put<a>(w: Wrap<(a, Int)>, x: a) -> Unit }\n")),
    [],
  );
  let rejected = source_diagnostics(
    b"effect e { write put<a>(m: Map<(a, Int), Int>) -> Unit }\nfn f() -> Unit / {e.put} = e.put(Map::new().insert((1.5, 1), 1))\n",
  ).filter(|d: Diagnostic| d.code == b"E0206");
  assert_eq(
    rejected.map(|d: Diagnostic|
      d.labels.fold(b"", |t: Bytes, l: Label| if l.primary { l.text } else { t })),
    [b"this map's key type is `(Float, Int)`"],
  )
}

test "a clause for a shipped effect's operation generic in its own type parameters sees each value of one kept, and only a shipped module writes one" {
  let codes = |name: Bytes, src: Bytes|
    module_diagnostics(name, src).map(|diagnostic: Diagnostic| diagnostic.code);
  let send = b"fn f(c: Chan<Int>) -> Bool = handle { task.send(c, 1) } with { task.send(c, x) -> true }\n";
  assert_eq(codes(b"m", send), [b"E0165"]);
  assert_eq(codes(b"std.m", send), []);
  let recv = b"fn f(c: Chan<Int>) -> Option<Int> = handle { task.recv(c) } with { task.recv(c) -> Some(1) }\n";
  assert_eq(codes(b"std.m", recv), [b"E0201"]);
  let raised = b"fn f() -> Int = handle { abort.raise(\"no\") } with { abort.raise(m) -> 0 }\n";
  assert_eq(codes(b"m", raised), []);
  let put = b"effect box { write put<a>(x: a) -> Unit }\nfn f() -> Int = handle { box.put(1); 2 } with { box.put(x) -> () }\n";
  assert_eq(codes(b"m", put), [])
}

test "a `Map` implies its key's order wherever its signature names it" {
  let assumes = |held: Bytes|
    check_codes(
      Bytes::concat_all([b"fn c<k>(held: ", held, b", a: k, b: k) -> Ordering = compare(a, b)\n"]),
    );
  assert_eq(assumes(b"List<Map<k, Int>>"), []);
  assert_eq(assumes(b"{ by: Map<k, Int> }"), []);
  assert_eq(assumes(b"(Map<k, Int>) -> Int"), []);
  assert_eq(assumes(b"Map<(k, Int), Int>"), []);
  assert_eq(assumes(b"Map<Int, k>"), [b"E0206"]);
  assert_eq(
    check_codes(
      b"fn c<k>(a: k, b: k) -> { o: Ordering, by: Option<Map<k, Int>> } = { o: compare(a, b), by: None }\n",
    ),
    [],
  )
}

test "a signature that names an alias of a `Map` implies the order its expansion needs" {
  let index = b"type Index<a> = Map<a, Int>\n";
  assert_eq(
    check_codes(
      index.concat(
        b"fn size<k>(m: Index<k>) -> Int = m.len()\nfn empty<k>() -> Index<k> = Map::new()\n",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      index.concat(
        b"fn size<k>(m: Index<k>) -> Int = m.len()\nfn floats(x: Float) -> Int = size(Map::new().insert(x, 1))\n",
      ),
    ),
    [b"E0206"],
  );
  assert_eq(check_codes(index.concat(b"fn floats(m: Index<Float>) -> Int = m.len()\n")), [
    b"E0206",
  ]);
  assert_eq(
    check_codes(
      index.concat(
        b"type Indices<a> = List<Index<a>>\nfn c<k>(i: Indices<k>, a: k, b: k) -> Ordering = compare(a, b)\n",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"type Counts<a> = Map<Int, a>\nfn c<v>(m: Counts<v>, a: v, b: v) -> Ordering = compare(a, b)\n",
    ),
    [b"E0206"],
  );
  let sack = b"type Bag<a> = | Bag(Map<a, Int>)\ntype Sack<a> = Bag<a>\nfn none<a>() -> Sack<a> = Bag(Map::new())\n";
  assert_eq(check_codes(sack), []);
  assert_eq(check_codes(sack.concat(b"fn floats() -> Sack<Float> = none()\n")), [b"E0206"])
}

test "a generic caller meets the order its callee's `Map` implies" {
  let size = b"fn size<k>(m: Map<k, Int>) -> Int = m.len()\n";
  assert_eq(
    check_codes(
      size.concat(b"fn both<j>(a: Map<j, Int>, b: Map<j, Int>) -> Int = size(a) + size(b)\n"),
    ),
    [],
  );
  assert_eq(
    check_codes(size.concat(b"fn one<j>(x: j) -> Int = size(Map::new().insert(x, 1))\n")),
    [b"E0206"],
  );
  assert_eq(
    check_codes(
      size.concat(
        b"fn one<j>(x: j) -> Int where derivable(ord, j) = size(Map::new().insert(x, 1))\n",
      ),
    ),
    [],
  )
}

test "an unordered key reaching an implied `Map` order is reported once, at the `Map`" {
  let over = |callee: Bytes, caller: Bytes|
    check_codes(
      Bytes::concat_all([b"type Node = | Node((Int) -> Int)\n", callee, b"\n", caller, b"\n"]),
    );
  let size = b"fn size<k>(m: Map<k, Int>) -> Int = m.len()";
  assert_eq(over(size, b"fn f(x: Float) -> Int = size(Map::new().insert(x, 1))"), [b"E0206"]);
  assert_eq(over(size, b"fn f(n: Node) -> Int = size(Map::new().insert(n, 1))"), [b"E0206"]);
  assert_eq(over(size, b"fn f(m: Map<Float, Int>) -> Int = size(m)"), [b"E0206"]);
  assert_eq(
    over(
      b"fn size<k>(m: Map<k, Int>) -> Int where derivable(ord, k) = m.len()",
      b"fn f(x: Float) -> Int = size(Map::new().insert(x, 1))",
    ),
    [b"E0206"],
  );
  assert_eq(
    over(
      b"fn size<k>(m: Map<(k, Int), Int>) -> Int = m.len()",
      b"fn f(x: Float) -> Int = size(Map::new().insert((x, 1), 1))",
    ),
    [b"E0206"],
  );
  assert_eq(
    over(
      b"type Pair<a> = | Pair(a, a)\nfn size<a>(m: Map<Pair<a>, Int>) -> Int = m.len()",
      b"fn f(x: Float) -> Int = size(Map::new().insert(Pair(x, x), 1))",
    ),
    [b"E0206"],
  );
  assert_eq(
    over(
      b"type Bag<a> = | Bag(Map<a, Int>)\nfn size<a>(b: Bag<a>) -> Int = 0",
      b"fn f(b: Bag<Float>) -> Int = size(b)",
    ),
    [b"E0206"],
  )
}

test "a shipped module's extern that names a `Map` implies its key's order" {
  assert_eq(declared_as(b"Map::new").constraints, [{ deriver: OrdDeriver, param: 0 }]);
  assert_eq(declared_as(b"Map::len").constraints, [{ deriver: OrdDeriver, param: 0 }]);
  let native = { name: b"std.native", src: b"pub extern fn size<k>(m: Map<k, Int>) -> Int\n" };
  let calls = |src: Bytes|
    codes_of([native, { name: b"m", src: b"import std.native (size)\n".concat(src) }]);
  assert_eq(calls(b"fn twice<j>(m: Map<j, Int>) -> Int = size(m) + size(m)\n"), []);
  assert_eq(calls(b"fn floats(x: Float) -> Int = size(Map::new().insert(x, 1))\n"), [b"E0206"])
}

test "a sum holding itself at a type grown from its own parameters is rejected, through other sums too" {
  assert_eq(check_codes(b"type Nest<a> = | Leaf(a) | Deeper(Nest<List<a>>)\n"), [b"E0477"]);
  assert_eq(check_codes(b"type A<a> = | A(B<a>) | AN\ntype B<b> = | B(A<List<b>>) | BN\n"), [
    b"E0477",
    b"E0477",
  ]);
  assert_eq(
    check_codes(
      Bytes::concat_all([
        b"type Tree<a> = | Leaf | Node(Tree<a>, a, Tree<a>)\n",
        b"type Rose<a> = | Rose(a, List<Rose<a>>)\n",
        b"type Odd<a> = | Odd(Odd<Int>) | Done(a)\n",
        b"type Later<a> = | Later((Later<List<a>>) -> Int) | Now(a)\n",
      ]),
    ),
    [],
  )
}

test "a key returns a type that is ordered and hashed, and that does not hold its own" {
  let keyed = |ret: Bytes, body: Bytes|
    check_codes(
      Bytes::concat_all([
        b"type T = | T(Int)\ntype Holder = | Holder(T)\nfn k(t: T) -> ",
        ret,
        b" = ",
        body,
        b"\nkey for T by k\n",
      ]),
    );
  assert_eq(keyed(b"Int", b"0"), []);
  assert_eq(keyed(b"Float", b"0.0"), [b"E0206"]);
  assert_eq(keyed(b"(Int) -> Int", b"|n: Int| n"), [b"E0206"]);
  assert_eq(keyed(b"T", b"t"), [b"E0219"]);
  assert_eq(keyed(b"List<Holder>", b"[Holder(t)]"), [b"E0219"]);
  assert_eq(
    check_codes(
      b"type A = | A(Int)\ntype B = | B(Int)\nfn a(x: A) -> B = B(0)\nfn b(x: B) -> A = A(0)\nkey for A by a\nkey for B by b\n",
    ),
    [b"E0219", b"E0219"],
  );
  assert_eq(
    check_codes(
      b"type T = | T(Int)\ntype Kept = new { t: T }\nfn k(t: T) -> Kept = { t: t }\nkey for T by k\n",
    ),
    [b"E0219"],
  );
  assert_eq(
    check_codes(
      b"type A = | A(Int)\ntype B = | B(A)\nfn a(x: A) -> Int = 0\nfn b(x: B) -> A = A(0)\nkey for A by a\nkey for B by b\n",
    ),
    [],
  )
}

test "a type that states a key is ordered, hashed and derived as its key is, whatever it holds" {
  let held = |measured_definitions: Bytes, used: Bytes|
    check_codes(
      Bytes::concat_all([
        b"type Reading = | Reading(Float, Int)\nfn tick(r: Reading) -> Int = match r { Reading(_, n) -> n }\n",
        measured_definitions,
        b"\n",
        used,
        b"\n",
      ]),
    );
  let keyed = b"key for Reading by tick";
  assert_eq(held(b"", b"fn m(r: Reading) -> Map<Reading, Int> = #{r: 1}"), [b"E0206"]);
  assert_eq(held(keyed, b"fn m(r: Reading) -> Map<Reading, Int> = #{r: 1}"), []);
  assert_eq(held(b"", b"fn c(r: Reading) -> Ordering = compare(r, r)"), [b"E0206"]);
  assert_eq(held(keyed, b"fn c(r: Reading) -> Ordering = compare(r, r)"), []);
  assert_eq(held(keyed, b"fn d(r: Reading) -> Bytes = digest([Some(r)])"), []);
  assert_eq(
    held(
      b"fn text(r: Reading) -> String = \"r\"\nshow for Reading by text",
      b"fn c(r: Reading) -> Ordering = compare(r, r)",
    ),
    [b"E0206"],
  )
}

test "a `forall` ranges over an opaque type another module declares" {
  let vault = {
    name: b"vault",
    src: b"pub opaque type Coin = | Heads | Tails\npub opaque type Purse<a> = | Purse(List<a>)\n",
  };
  let over = |law: Bytes|
    codes_across([vault, { name: b"app", src: b"import vault (Coin, Purse)\n".concat(law) }]);
  assert_eq(over(b"law \"l\" forall (c: Coin, cs: List<Coin>) { c == c }"), []);
  assert_eq(over(b"law \"l\" forall (p: Purse<Coin>) { p == p }"), []);
  assert_eq(over(b"law \"l\" forall (c: Coin) { c == Heads }"), [b"E0107"])
}

test "a `forall` never ranges over a `Scoped`, alone or inside another type" {
  assert_eq(check_codes(b"law \"l\" forall (h: Scoped<Int, [r]>) { true }"), [b"E0418"]);
  assert_eq(check_codes(b"law \"l\" forall (hs: List<Scoped<Int, [r]>>) { hs.len() >= 0 }"), [
    b"E0418",
  ]);
  assert_eq(
    check_codes(b"type Kept<t> = | Kept(t)\nlaw \"l\" forall (k: Kept<Scoped<Int, [r]>>) { true }"),
    [b"E0418"],
  )
}

test "a scoped opaque value is read where the value's module is called, and released by it" {
  let over = |app: Bytes|
    codes_across([
      {
        name: b"vault",
        src: b"pub opaque type Token = | Token(Int)\npub fn mint(n: Int) -> Token = Token(n)\npub fn spend(t: Token) -> Unit = ()\npub fn worth(t: Token) -> Int = match t { Token(n) -> n }\n",
      },
      { name: b"app", src: b"import vault (Token, mint, spend, worth)\n".concat(app) },
    ]);
  assert_eq(
    over(b"fn spent(n: Int) -> Int = with_scope[t](mint(n), spend) { h -> worth(h.get()) }"),
    [],
  );
  assert_eq(
    over(b"fn peek<[r]>(h: Scoped<Token, [r]>) -> Int / {scoped.read[r]} = worth(h.get())"),
    [],
  );
  assert_eq(
    over(
      b"fn opened(n: Int) -> Int = with_scope[t](mint(n), spend) { h -> match h.get() { Token(k) -> k } }",
    ),
    [b"E0107"],
  );
  assert_eq(over(b"fn kept(n: Int) -> Token = with_scope[t](mint(n), spend) { h -> h.get() }"), [])
}

test "a `Columns` holds a record type of at least one field wherever its type resolves" {
  assert_eq(
    check_codes(
      b"type P = { x: Float, y: Float }\nfn f(xs: List<P>) -> Columns<P> = Columns::of_list(xs)\n",
    ),
    [],
  );
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Columns<Int> = Columns::of_list(xs)\n"), [
    b"E0224",
  ]);
  assert_eq(check_codes(b"fn f(xs: List<{}>) -> Columns<{}> = Columns::of_list(xs)\n"), [b"E0224"]);
  let generic = b"fn f<a>(xs: List<a>) -> Columns<a> = Columns::of_list(xs)\n";
  assert_eq(check_codes(generic), []);
  assert_eq(check_codes(generic.concat(b"fn g(xs: List<Int>) -> Int = f(xs).len()\n")), [b"E0224"])
}

fn with_numeric_add(add: Bytes, rest: Bytes) -> Bytes =
  Bytes::concat_all([
    b"type N = | Z | S(N)\nfn add(a: N, b: N) -> N = ",
    add,
    b"\nfn neg(a: N) -> N = a\nfn of(n: Int) -> N = Z\nnumeric for N by { add: add, sub: add, mul: add, neg: neg, of_int: of }\n",
    rest,
  ])

test "an operator at a type that states its arithmetic is a call of the function it states" {
  assert_eq(check_codes(with_numeric_add(b"match a { Z -> b, S(m) -> S(m + b) }", b"")), []);
  assert_eq(check_codes(with_numeric_add(b"match a { Z -> b, S(m) -> S(add(m, b)) }", b"")), []);
  assert(
    rejected_with(
      with_numeric_add(b"a + b", b""),
      b"E0302",
      b"`add` may not return, and its effects do not say so",
    ),
  );
  assert_eq(check_codes(with_numeric_add(b"a - b", b"")), [b"E0302"]);
  assert_eq(check_codes(with_numeric_add(b"match a { Z -> -b, S(m) -> m }", b"")), [])
}

test "a comparison, a `Map` and a constrained parameter at a type that states a key or a show call it" {
  let keyed = |k: Bytes|
    check_codes(
      Bytes::concat_all([b"type T = | T(Int)\nfn k(t: T) -> Int = ", k, b"\nkey for T by k\n"]),
    );
  assert_eq(keyed(b"match t { T(n) -> n }"), []);
  assert_eq(keyed(b"if t == t { 1 } else { 0 }"), [b"E0302"]);
  assert_eq(keyed(b"if [t] == [t] { 1 } else { 0 }"), [b"E0302"]);
  assert_eq(keyed(b"match compare(t, t) { Equal -> 1, _ -> 0 }"), [b"E0302"]);
  assert_eq(keyed(b"Map::new().insert(t, 1).len()"), [b"E0302"]);
  let shown = |s: Bytes|
    check_codes(
      Bytes::concat_all([
        b"type T = | T(Int)\nfn written<a>(x: a) -> String where derivable(show, a) = \"\"\nfn s(t: T) -> String = ",
        s,
        b"\nshow for T by s\n",
      ]),
    );
  assert_eq(shown(b"match t { T(n) -> written(n) }"), []);
  assert_eq(shown(b"written([t])"), [b"E0302"]);
  assert_eq(
    check_codes(
      b"type T = | T(Int)\nfn k(t: T) -> Int = 0\nkey for T by k\nfn same(a: T, b: T) -> Bool = a == b\n",
    ),
    [],
  )
}

test "a body in a recursion through an operator performs everything again there" {
  let through = with_db_effect(
    with_numeric_add(
      b"match a { Z -> b, S(m) -> handle { noted(m, b) } with { db.query[conn](sql) -> 0 } }",
      b"fn noted(a: N, b: N) -> N / {db.query[conn] bounded} = { lookup(1); a + b }\n",
    ),
  );
  assert_eq(check_codes(through), [b"E0465"]);
  let named = with_db_effect(
    with_numeric_add(
      b"match a { Z -> b, S(m) -> handle { noted(m, b) } with { db.query[conn](sql) -> 0 } }",
      b"fn noted(a: N, b: N) -> N / {db.query[conn] bounded} = { lookup(1); add(a, b) }\n",
    ),
  );
  assert_eq(check_codes(named), [b"E0465"])
}

fn with_stack(rest: Bytes) -> Bytes =
  b"type Stack = | Stack(List<Int>)\nfn Stack::size(s: Stack) -> Int = match s { Stack(xs) -> xs.len() }\nfn Stack::of(xs: List<Int>) -> Stack = Stack(xs)\n".concat(
    rest,
  )

test "a function of a type is declared `fn T::name` and named through the type" {
  assert_eq(check_codes(with_stack(b"fn f() -> Int = Stack::size(Stack::of([1, 2]))")), []);
  assert_eq(check_codes(with_stack(b"fn f() -> Int = Stack::depth(Stack([1]))")), [b"E0101"]);
  assert_eq(check_codes(with_stack(b"fn f() -> Int = size(Stack([1]))")), [b"E0101"])
}

test "a call on a value is a call of its type's function with the value first" {
  assert_eq(check_codes(with_stack(b"fn f() -> Int = Stack([1, 2]).size()")), []);
  assert_eq(check_codes(with_stack(b"fn f() -> Int = { let s = Stack([1, 2]); s.size() }")), []);
  assert_eq(
    check_codes(with_stack(b"fn f(s: Stack) -> Int = s.size() + Stack::of([3]).size()")),
    [],
  );
  assert_eq(check_codes(with_stack(b"fn f(s: Stack) -> Int = s.depth()")), [b"E0101"]);
  assert_eq(check_codes(with_stack(b"fn f(s: Stack) -> Int = s.size(1)")), [b"E0202"])
}

test "a function of a type is declared by the type's module, for a sum or a `new` record" {
  assert_eq(check_codes(b"fn Option::size(o: Option<Int>) -> Int = 0"), [b"E0208"]);
  assert_eq(check_codes(b"fn Missing::size(n: Int) -> Int = n"), [b"E0208"]);
  assert_eq(check_codes(b"fn List::map(xs: List<Int>, n: Int) -> List<Int> = xs"), [b"E0208"]);
  assert_eq(
    check_codes(b"type Pair = { a: Int, b: Int }\nfn Pair::sum(p: Pair) -> Int = p.a + p.b"),
    [b"E0217"],
  );
  let date = b"type Date = new { year: Int, day: Int }\n";
  assert_eq(
    check_codes(
      date.concat(
        b"fn Date::next(d: Date) -> Date = { year: d.year, day: d.day + 1 }\nfn f(d: Date) -> Int = d.next().day",
      ),
    ),
    [],
  );
  assert(
    rejected_with(
      date.concat(b"fn Date::year(d: Date) -> Int = d.year"),
      b"E0105",
      b"`Date` has a field `year` and a function of that name",
    ),
  )
}

test "a binding and an effect of one name are rejected once, where the effect has no such operation" {
  assert_eq(
    check_codes(
      b"effect log { write say(n: Int) -> Unit }\nfn f(log: List<Int>) -> Int / {log.say} = log.len()",
    ),
    [b"E0105"],
  )
}

test "a free name is read with no import, where the module declares and imports none of it" {
  let console = { name: b"std.console", src: b"pub fn print(text: String) -> Int = text.len()\n" };
  assert_eq(codes_of([console, { name: b"m", src: b"fn f() -> Int = print(\"x\")\n" }]), []);
  assert_eq(
    codes_of([
      console,
      { name: b"m", src: b"fn print(n: Int) -> Int = n\nfn f() -> Int = print(1)\n" },
    ]),
    [],
  );
  assert_eq(
    codes_of([
      console,
      { name: b"other", src: b"pub fn print(b: Bool) -> Bool = b\n" },
      { name: b"m", src: b"import other (print)\nfn f() -> Bool = print(true)\n" },
    ]),
    [],
  )
}

test "a function of a type another module declares is named through that module" {
  let shapes = {
    name: b"shapes",
    src: b"pub type Shape = | Sq(Int)\npub fn Shape::make(n: Int) -> Shape = Sq(n)\npub fn Shape::area(s: Shape) -> Int = match s { Sq(n) -> n * n }\n",
  };
  assert_eq(
    codes_of([
      shapes,
      {
        name: b"m",
        src: b"import shapes\nfn f(n: Int) -> Int = shapes::Shape::make(n).area() + shapes::Shape::make(n).shapes::Shape::area()\n",
      },
    ]),
    [],
  );
  assert_eq(
    codes_of([
      shapes,
      { name: b"m", src: b"import shapes\nfn f(n: Int) -> Int = shapes::Shape::nope(n)\n" },
    ]),
    [b"E0101"],
  );
  assert(parse(b"fn f() -> Int = a::b::c()").parser.diagnostics.len() > 0, None)
}

test "a call on a value reads a record's field, a binding before an effect, and a known type" {
  assert_eq(check_codes(b"fn f(codec: { decode: (Int) -> Int }) -> Int = codec.decode(1)"), []);
  assert(
    rejected_with(
      with_stack(b"effect s { read size() -> Int }\nfn f(s: Stack) -> Int = s.size()"),
      b"E0105",
      b"`s` is a binding here and an effect",
    ),
  );
  assert_eq(
    check_codes(
      with_stack(
        b"effect log { write say(n: Int) -> Unit }\nfn f(s: Stack) -> Unit / {log.say} = log.say(s.size())",
      ),
    ),
    [],
  );
  assert(
    rejected_with(
      with_stack(b"fn f<a>(x: a) -> Int = x.size()"),
      b"E0201",
      b"cannot call `size` on this value",
    ),
  )
}

test "a call on a value names its arguments and leaves the rest to their defaults" {
  let grown = |rest: Bytes|
    check_codes(
      with_stack(
        b"type Mode = | Fast | Slow\nfn Stack::grown(s: Stack, by: Int = 1, mode: Mode = Fast) -> Stack = s\n".concat(
          rest,
        ),
      ),
    );
  assert_eq(grown(b"fn f(s: Stack) -> Int = s.grown().size() + s.grown(2).size()"), []);
  assert_eq(grown(b"fn f(s: Stack) -> Int = s.grown(mode: Slow).size()"), []);
  assert_eq(grown(b"fn f() -> Int = Stack([1]).grown(mode: Slow, by: 3).size()"), []);
  assert_eq(grown(b"fn f(s: Stack) -> Int = s.grown(depth: 1).size()"), [b"E0123"]);
  assert_eq(grown(b"fn f(s: Stack) -> Int = s.grown(2, by: 3).size()"), [b"E0123"]);
  assert_eq(grown(b"fn f(s: Stack) -> Int = s.grown(by: true).size()"), [b"E0201"]);
  assert_eq(check_codes(b"fn f(codec: { decode: (Int) -> Int }) -> Int = codec.decode(from: 1)"), [
    b"E0123",
  ])
}

test "`value.m::f(..)` calls the function it names with the value first" {
  assert_eq(
    check_codes(
      with_stack(
        b"fn deep(s: Stack, by: Int) -> Int = by\nfn f(s: Stack) -> Int = s.Stack::size() + Stack([1]).Stack::size()",
      ),
    ),
    [],
  );
  assert_eq(check_codes(with_stack(b"fn f(s: Stack) -> Int = s.Stack::depth()")), [b"E0101"])
}

test "a lambda's unwritten parameter is what the arguments before it resolve" {
  assert_eq(
    check_codes(
      with_stack(
        b"type P = { side: Int }\nfn sides(ps: List<P>) -> List<Int> = ps.map(|p| p.side)\nfn sizes(ss: List<Stack>) -> List<Int> = ss.map(|s| s.size())",
      ),
    ),
    [],
  );
  assert_eq(check_codes(b"type P = { side: Int }\nfn f() -> Int = { let g = |p| p.side; 1 }"), [
    b"E0201",
  ])
}

test "a builtin the prelude declares under a type is a function of that type" {
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int = xs.len() + xs.push(1).len()"), []);
  assert_eq(check_codes(b"fn f(m: Map<Int, Int>) -> Option<Int> = m.get(1)"), []);
  assert_eq(check_codes(b"fn f(b: Bytes, s: String) -> Int = b.len() + s.trim().len()"), []);
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> List<Int> = xs.map(|x| x + 1)"), []);
  assert_eq(check_codes(b"fn f(b: Bytes) -> Bytes = b.of_string()"), [b"E0101"]);
  assert_eq(
    check_codes(
      b"fn f(s: String) -> Int = Bytes::len(Bytes::of_string(s)) + Map::len(Map::insert(Map::new(), 1, s))",
    ),
    [],
  );
  assert_eq(check_codes(b"fn f(s: String) -> Int = Bytes::size(s)"), [b"E0101"]);
  assert_eq(check_codes(b"fn f(n: U8) -> Bytes = byte_of_int(Int::of_u8(n))"), []);
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int = len(xs)"), [b"E0101"]);
  assert_eq(
    check_codes(
      b"fn len(n: Int) -> Int = n\nfn f(xs: List<Int>) -> Int = len(xs.len()) + List::len(xs)",
    ),
    [],
  );
  assert_eq(check_codes(b"fn f(n: Int) -> List<Int> = range(0, n)"), []);
  assert_eq(check_codes(b"fn f(s: String) -> Int = s.panic()"), [b"E0101"])
}

test "a guard written on a value's own length lets a builtin that needs it raise nothing" {
  assert_eq(
    check_codes(b"fn f(b: Bytes) -> Bytes = if b.len() >= 1 { b.slice(0, 1) } else { b }"),
    [],
  );
  assert_eq(check_codes(b"fn f(b: Bytes) -> Bytes = b.slice(0, 1)"), [b"E0302"])
}

fn codes_of(sources: List<Source>) -> List<Bytes> / {abort.raise} =
  match resolve_modules(
      sources.map(|source: Source|
        { name: source.name, module: parse(source.src).node, derived: [] }),
    ) {
    ResolveFailed(ds) -> ds.map(|diagnostic: Diagnostic| diagnostic.code),
    ResolveSucceeded(y) ->
      dedup_diagnostics(check_program(y.resolution, y.modules).checker.diagnostics).map(
        |diagnostic: Diagnostic| diagnostic.code,
      ),
  }

test "a language type's other functions are its home module's, which every module sees but those beneath the homes" {
  let home = {
    name: b"std.list",
    src: b"pub fn List::second<a>(xs: List<a>) -> Option<a> = xs.at(1)\n",
  };
  let calls = b"fn f(xs: List<Int>) -> Option<Int> = xs.second()\nfn g(xs: List<Int>) -> Option<Int> = List::second(xs)\n";
  assert_eq(codes_of([home, { name: b"m", src: b"import std.list\n".concat(calls) }]), []);
  assert_eq(
    codes_of([
      home,
      { name: b"mid", src: b"import std.list\npub fn one() -> Int = 1\n" },
      { name: b"m", src: b"import mid\n".concat(calls) },
    ]),
    [],
  );
  assert_eq(codes_of([home, { name: b"m", src: calls }]), []);
  assert_eq(codes_of([home, { name: b"std.other", src: calls }]), []);
  assert_eq(codes_of([home, { name: b"std.gen", src: calls }]), [b"E0101", b"E0101"]);
  assert_eq(
    codes_of([{ name: b"std.list", src: b"pub fn List::len<a>(xs: List<a>) -> Int = 0\n" }]),
    [b"E0105"],
  )
}

test "every way a function of a type is written calls it, a declared type's or a language type's alike" {
  let home = {
    name: b"std.list",
    src: b"pub fn List::second<a>(xs: List<a>) -> Option<a> = xs.at(1)\n",
  };
  let kinds = [
    { ty: b"Box", f: b"Box::size", result: b"Int" },
    { ty: b"String", f: b"String::len", result: b"Int" },
    { ty: b"List<Int>", f: b"List::second", result: b"Option<Int>" },
  ];
  let forms = |f: Bytes|
    [
      Bytes::concat_all([b"x.", f.slice(f.index_of(b"::").unwrap_or(0) + 2, f.len()), b"()"]),
      Bytes::concat_all([f, b"(x)"]),
      Bytes::concat_all([b"x.", f, b"()"]),
      Bytes::concat_all([b"pass(x).", f, b"()"]),
      Bytes::concat_all([b"{ let g = ", f, b"; g(x) }"]),
    ];
  let module = |body: Bytes|
    [
      home,
      {
        name: b"m",
        src: Bytes::concat_all([
          b"import std.list\ntype Box = | Box(Int)\nfn Box::size(b: Box) -> Int = match b { Box(n) -> n }\n",
          b"fn pass<a>(v: a) -> a = v\n",
          body,
        ]),
      },
    ];
  kinds.fold((), |_: Unit, k: { ty: Bytes, f: Bytes, result: Bytes }|
    forms(k.f).fold((), |_: Unit, form: Bytes| {
      let fine = Bytes::concat_all([b"fn f(x: ", k.ty, b") -> ", k.result, b" = ", form, b"\n"]);
      assert(codes_of(module(fine)) == [], Some(String::of_bytes_lossy(fine)));
      let wrong = Bytes::concat_all([b"fn f(x: ", k.ty, b") -> Bool = ", form, b"\n"]);
      assert(codes_of(module(wrong)) == [b"E0201"], Some(String::of_bytes_lossy(wrong)))
    }));
  kinds.fold((), |_: Unit, k: { ty: Bytes, f: Bytes, result: Bytes }| {
    let extra = Bytes::concat_all([b"fn f(x: ", k.ty, b") -> ", k.result, b" = x.", k.f, b"(1)\n"]);
    assert(codes_of(module(extra)) != [], Some(String::of_bytes_lossy(extra)))
  });
  assert_eq(codes_of(module(b"fn f(s: String) -> Int = s.String::nope()\n")), [b"E0101"]);
  assert_eq(codes_of(module(b"fn f(s: String) -> Int = s.Nowhere::len()\n")), [b"E0101"])
}

test "a recursion a builtin called on a value bounds, or runs a lambda of, is seen to end" {
  assert_eq(
    check_codes(
      b"fn f(xs: List<Int>, i: Int) -> Int = if i >= xs.len() { 0 } else { match xs.at(i) { Some(x) -> x + f(xs, i + 1), None -> 0 } }",
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"type Tree = | Leaf(Int) | Node(List<Tree>)\nfn total(t: Tree) -> Int = match t { Leaf(n) -> n, Node(ts) -> ts.fold(0, |acc, c| acc + total(c)) }",
    ),
    [],
  );
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int = if xs.len() == 0 { 0 } else { f(xs) }"), [
    b"E0302",
  ])
}

test "a recursion through a call on a value is a recursion, and a type states its own functions" {
  let list = b"type Chain = | End | Link(Int, Chain)\nfn Chain::len(c: Chain) -> Int = match c { End -> 0, Link(_, rest) -> 1 + rest.len() }\n";
  assert_eq(check_codes(list), []);
  assert_eq(
    check_codes(
      b"type Chain = | End | Link(Int, Chain)\nfn Chain::len(c: Chain) -> Int = 1 + c.len()\n",
    ),
    [b"E0302"],
  );
  assert_eq(
    check_codes(
      list.concat(b"key for Chain by Chain::len\nfn same(a: Chain, b: Chain) -> Bool = a == b\n"),
    ),
    [],
  )
}

test "a borrowed function parameter may be called, passed on borrowed, captured by a lambda borrowed in turn, and read in a `parallel` branch or a scope" {
  let borrowed = [
    b"fn f(g: (Int) -> Int) -> Int = g(1)",
    b"fn twice(h: (Int) -> Int, x: Int) -> Int = h(h(x))\nfn f(g: (Int) -> Int) -> Int = twice(g, 1)",
    b"fn f(g: (Int) -> Int) -> List<Int> = [1, 2].map(g)",
    b"fn f(g: (Int) -> Int) -> List<Int> = [1, 2].map(|x: Int| g(x) + 1)",
    b"fn f(g: (Int) -> Int) -> Int = { let h = |x: Int| g(x); let k = h; k(1) + [1].fold(0, |a: Int, x: Int| a + h(x)) }",
    b"fn f(g: (Int) -> Int, n: Int) -> Int = if n <= 0 { g(0) } else { f(g, n - 1) }",
    b"fn f(g: (Int) -> Int) -> (Int, Int) = parallel { g(1), g(2) }",
    b"fn f(g: (Int) -> Int) -> Int = with_scope[r](1, |x: Int| ()) { h -> g(1) }",
    b"effect ask { read get() -> Int }\nfn f(g: (Int) -> Int) -> Int = handle { g(ask.get()) } with { ask.get() resume k -> k(1) + 1 }",
    b"fn f() -> ((Int) -> Int) -> (Int) -> Int = |h: (Int) -> Int| h",
  ];
  assert_eq(borrowed.filter(|src: Bytes| check_codes(src) != []), [])
}

fn bodies_storing_parameter(param: Bytes) -> List<Bytes> = {
  let f = |rest: Bytes| Bytes::concat_all([b"fn f(", param, rest]);
  [
    f(b") -> (Int) -> Int = g"),
    f(b") -> { h: (Int) -> Int } = { h: g }"),
    f(b") -> List<(Int) -> Int> = [g]"),
    f(b") -> Option<(Int) -> Int> = Some(g)"),
    b"effect sink { write put((Int) -> Int) -> Unit }\n".concat(
      f(b") -> Unit / {sink.put} = sink.put(g)"),
    ),
    b"fn hold(h: keep (Int) -> Int) -> Int = 0\n".concat(f(b") -> Int = hold(g)")),
    b"fn id<a>(x: a) -> a = x\n".concat(f(b") -> Int = id(g)(1)")),
    f(b") -> Int = { let apply = |h: (Int) -> Int| h(1); apply(g) }"),
    f(b") -> () -> Int = || g(1)"),
    f(b") -> (Int) -> Int = { let h = g; h }"),
    f(b", c: Bool) -> (Int) -> Int = if c { g } else { |x: Int| x }"),
    b"effect ask { read get() -> Int }\nfn forget(x: keep once (Int) -> Int) -> Unit = ()\n".concat(
      f(b") -> Int = handle { g(ask.get()) } with { ask.get() resume k -> { forget(k); 0 } }"),
    ),
  ]
}

test "a borrowed function parameter held past the call is rejected, and `keep` lets the function hold it" {
  let borrowed = bodies_storing_parameter(b"g: (Int) -> Int");
  assert_eq(borrowed.map(check_codes), borrowed.map(|_: Bytes| [b"E0475"]));
  assert_eq(
    bodies_storing_parameter(b"g: keep (Int) -> Int").filter(|src: Bytes| check_codes(src) != []),
    [],
  )
}

test "the error for a borrowed parameter names the place that holds it and offers `keep`" {
  let src = b"fn f(g: (Int) -> Int) -> Option<(Int) -> Int> = Some(g)";
  let diagnostics = source_diagnostics(src);
  assert_eq(diagnostics.map(|d: Diagnostic| d.message), [
    b"`g` is borrowed by `f`, and would be kept past its call",
  ]);
  match fixes_of(diagnostics) {
    [fix] -> {
      let fixed = fixed_by(src, fix);
      assert_eq(fixed, b"fn f(g: keep (Int) -> Int) -> Option<(Int) -> Int> = Some(g)");
      assert_eq(check_codes(fixed), [])
    },
    _ -> panic("one fix"),
  }
}

test "a call reads `keep` off its callee's signature, in another module or through a type" {
  let lib = {
    name: b"lib",
    src: b"pub fn hold(h: keep (Int) -> Int) -> Int = 0\npub fn lend(h: (Int) -> Int) -> Int = h(0)\n",
  };
  let calling = |call: Bytes|
    codes_of([
      lib,
      {
        name: b"m",
        src: Bytes::concat_all([b"import lib\nfn f(g: (Int) -> Int) -> Int = ", call, b"\n"]),
      },
    ]);
  assert_eq(calling(b"lib::lend(g)"), []);
  assert_eq(calling(b"lib::hold(g)"), [b"E0475"]);
  let boxed = |call: Bytes|
    check_codes(
      Bytes::concat_all([
        b"type Box = | Box(Int)\nfn Box::hold(b: Box, h: keep (Int) -> Int) -> Int = 0\nfn Box::lend(b: Box, h: (Int) -> Int) -> Int = h(0)\nfn f(g: (Int) -> Int, b: Box) -> Int = ",
        call,
      ]),
    );
  assert_eq(boxed(b"b.lend(g) + Box::lend(b, g) + b.lend(h: g)"), []);
  assert_eq(boxed(b"b.hold(g)"), [b"E0475"]);
  assert_eq(boxed(b"b.hold(h: g)"), [b"E0475"])
}

test "a pattern binds every name it takes from a borrowed value to that value" {
  assert_eq(check_codes(b"fn f(g: (Int) -> Int) -> (Int) -> Int = match g { h -> h }"), [b"E0475"]);
  assert_eq(check_codes(b"fn f(g: (Int) -> Int) -> (Int) -> Int = match g { h | h -> h }"), [
    b"E0475",
  ]);
  assert_eq(check_codes(b"fn f(g: (Int) -> Int) -> (Int) -> Int = { let h | h = g; h }"), [
    b"E0475",
  ])
}

fn with_ask_effect(param: Bytes, rest: Bytes) -> Bytes =
  Bytes::concat_all([
    b"effect ask { read get() -> Int }\neffect sink { write put((Int) -> Int) -> Unit }\n",
    b"type Step = | Done(Int) | Wait(once (Int) -> Step)\n",
    b"fn apply(h: keep once (Int) -> (Int) -> Int, x: Int) -> (Int) -> Int = h(x)\n",
    b"fn peek(h: once (Int) -> Int) -> Int = 0\n",
    b"fn f(g: ",
    param,
    rest,
  ])

test "a continuation holds what its handler reads, and a call of it returns what its `handle` may" {
  let held = [
    b") -> Step = handle { ask.get() } with { return n -> Done(g(n)), ask.get() resume k -> Wait(k) }",
    b") -> Unit / {sink.put} = { handle { let _ = ask.get(); g } with { ask.get() resume k -> { sink.put(k(0)); g } }; () }",
    b") -> Int = { let r = handle { let _ = ask.get(); g } with { ask.get() resume k -> apply(k, 0) }; r(1) }",
  ];
  assert_eq(
    held.map(|rest: Bytes| check_codes(with_ask_effect(b"(Int) -> Int", rest))),
    held.map(|_: Bytes| [b"E0475"]),
  );
  assert_eq(
    held.filter(|rest: Bytes| check_codes(with_ask_effect(b"keep (Int) -> Int", rest)) != []),
    [],
  );
  assert_eq(
    check_codes(
      with_ask_effect(
        b"(Int) -> Int",
        b") -> Int = handle { g(ask.get()) } with { ask.get() resume k -> peek(k) }",
      ),
    ),
    [],
  )
}

test "a function of a language type written through the type is its home module's, borrowed or kept as it says" {
  let home = |param: Bytes|
    {
      name: b"std.list",
      src: Bytes::concat_all([
        b"pub fn List::ordered<a>(xs: List<a>, before: ",
        param,
        b") -> List<a> = xs\n",
      ]),
    };
  let calls = {
    name: b"m",
    src: b"import std.list\nfn f(xs: List<Int>, g: (Int, Int) -> Bool) -> List<Int> = List::ordered(xs, g)\nfn h(xs: List<Int>, g: (Int, Int) -> Bool) -> List<Int> = xs.ordered(g)\n",
  };
  assert_eq(codes_of([home(b"(a, a) -> Bool"), calls]), []);
  assert_eq(codes_of([home(b"keep (a, a) -> Bool"), calls]), [b"E0475", b"E0475"])
}

test "a borrowed parameter is held by a lambda returning it, an `else`, a scope, a handler's variable, a `try`, a `parallel` and a tagged literal" {
  let held = [
    b"fn f(g: (Int) -> Int) -> List<(Int) -> Int> = [1].map(|x: Int| g)",
    b"fn f(g: (Int) -> Int, o: Option<Int>) -> (Int) -> Int = { let Some(_) = o else { g }; |x: Int| x }",
    b"fn f(g: (Int) -> Int) -> Int = with_scope[r](g, |h: (Int) -> Int| ()) { h -> 1 }",
    b"effect tally { write add(n: Int) -> Unit }\nfn f(g: (Int) -> Int) -> Int = handle { tally.add(1) } with { var h: (Int) -> Int = g, tally.add(n) -> (), return u -> 0 }",
    b"effect tally { write add(n: Int) -> Unit }\nfn f(g: (Int) -> Int) -> Int = handle { tally.add(1) } with { var h: (Int) -> Int = |x: Int| x, tally.add(n) -> { h = g; }, return u -> 0 }",
    b"fn f(g: (Int) -> Int) -> Result<(Int) -> Int, String> = try[abort.raise] { g }",
    b"fn f(g: (Int) -> Int) -> ((Int) -> Int, Int) = parallel { g, 1 }",
  ];
  assert_eq(held.map(check_codes), held.map(|_: Bytes| [b"E0475"]));
  assert_eq(check_codes(b"fn f(g: (Int) -> Unit) -> Int = with_scope[r](1, g) { h -> 2 }"), []);
  let marks = {
    name: b"marks",
    src: b"pub fn compile(parts: List<String>) -> Result<Int, { message: String, offset: Int, part: Int }> = Ok(1)\npub fn fill(c: Int, holes: List<(Int) -> Int>) -> Int = c\n",
  };
  assert_eq(
    codes_of([
      marks,
      { name: b"m", src: b"import marks\nfn f(g: (Int) -> Int) -> Int = marks\"a{g}b\"\n" },
    ]),
    [b"E0475"],
  )
}

fn tagged(literal: Bytes) -> List<Source> =
  [
    { name: b"tag", src: literal },
    { name: b"m", src: b"import tag\n\nfn main() -> Int = tag\"abc\"\n" },
  ]

fn rejection_type() -> Bytes = b"Result<Int, { message: String, offset: Int }>"

fn returning_rejection(head: Bytes, rest: Bytes) -> Bytes =
  Bytes::concat_all([head, b" -> ", rejection_type(), rest])

test "a tagged literal performs nothing where it is written, whatever its parser could raise" {
  assert_eq(
    codes_across([
      {
        name: b"hex",
        src: returning_rejection(
          b"pub fn literal(text: String)",
          b" / {abort.raise} = Ok(text.len())\n",
        ),
      },
      { name: b"m", src: b"import hex\n\nfn main() -> Int = hex\"ff\" + hex\"0a\"\n" },
    ]),
    [],
  )
}

test "a tag's `literal` is rejected where a literal calls it, unless a check can run it" {
  let shaped = errors_across(tagged(b"pub fn literal(text: String) -> Option<Int> = Some(1)\n"));
  assert_eq(shaped.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0152"]);
  assert(told(shaped).contains("(String) -> Option<Int>"), Some(told(shaped)));
  let performing = errors_across([
    {
      name: b"tag",
      src: returning_rejection(
        b"pub effect ticks { read now() -> Int }\n\npub fn literal(text: String)",
        b" / {ticks.now} =\n  Ok(ticks.now())\n",
      ),
    },
    { name: b"m", src: b"import tag\n\nfn main() -> Int / {tag::ticks.now} = tag\"abc\"\n" },
  ]);
  assert_eq(performing.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0152"]);
  assert(told(performing).contains("performs `{tag.ticks.now}`"), Some(told(performing)));
  let generic = errors_across(
    tagged(
      b"pub fn literal<a>(text: String) -> Result<List<a>, { message: String, offset: Int }> = Ok([])\n",
    ),
  );
  assert(told(generic).contains("parameters of its own"), Some(told(generic)));
  assert_eq(
    codes_across(
      tagged(
        returning_rejection(b"pub fn literal(text: String, strict: Bool = false)", b" = Ok(1)\n"),
      ),
    ),
    [b"E0152"],
  )
}

test "a tag is a module binder, and its `literal` a public function of that module" {
  assert_eq(codes_across(tagged(b"pub fn other() -> Int = 1\n")), [b"E0101"]);
  assert_eq(
    codes_across(tagged(returning_rejection(b"fn literal(text: String)", b" = Ok(1)\n"))),
    [b"E0107"],
  );
  assert_eq(codes_across([{ name: b"m", src: b"fn main() -> Int = tag\"abc\"\n" }]), [b"E0106"])
}

fn counting(hole: Bytes) -> Source =
  {
    name: b"count",
    src: Bytes::concat_all([
      b"pub fn compile(parts: List<String>) -> Result<List<String>, { message: String, offset: Int, part: Int }> = Ok(parts)\n\npub fn fill(parts: List<String>, holes: List<",
      hole,
      b">) -> Int = parts.len() + holes.len()\n",
    ]),
  }

test "a hole of another type than its tag takes is rejected at the hole" {
  let src = b"import count\n\nfn main() -> Int = count\"a {1} b{\"two\"}\"\n";
  let diagnostics = errors_across([counting(b"Int"), { name: b"m", src: src }]);
  assert_eq(diagnostics.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0201"]);
  let label = diagnostics.get(0).labels.get(0);
  assert_eq(src.slice(label.start, label.end), b"\"two\"")
}

test "a tag with holes declares a `compile` and a `fill` a literal can call" {
  let lone = |text: Bytes|
    errors_across([
      { name: b"count", src: text },
      { name: b"m", src: b"import count\n\nfn main() -> Int = count\"a {1}\"\n" },
    ]);
  let codes = |text: Bytes| lone(text).map(|diagnostic: Diagnostic| diagnostic.code);
  let compiling = b"pub fn compile(parts: List<String>) -> Result<Int, { message: String, offset: Int, part: Int }> = Ok(1)\n";
  assert_eq(codes(returning_rejection(b"pub fn literal(text: String)", b" = Ok(1)\n")), [b"E0101"]);
  assert_eq(codes(compiling), [b"E0101"]);
  let misfilled = lone(compiling.concat(b"pub fn fill(c: String, holes: List<Int>) -> Int = 1\n"));
  assert_eq(misfilled.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0152"]);
  assert(told(misfilled).contains("`count::fill` has type"), Some(told(misfilled)));
  let unplaced = lone(
    returning_rejection(b"pub fn compile(parts: List<String>)", b" = Ok(1)\n").concat(
      b"pub fn fill(c: Int, holes: List<Int>) -> Int = c\n",
    ),
  );
  assert_eq(unplaced.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0152"]);
  assert(told(unplaced).contains("`count::compile` has type"), Some(told(unplaced)));
  let performing = lone(
    compiling.concat(
      b"pub effect ticks { read now() -> Int }\npub fn fill(c: Int, holes: List<Int>) -> Int / {ticks.now} = ticks.now()\n",
    ),
  );
  assert_eq(performing.map(|diagnostic: Diagnostic| diagnostic.code), [b"E0152"]);
  assert(told(performing).contains("`count::fill` performs"), Some(told(performing)));
  let generic = lone(compiling.concat(b"pub fn fill<a>(c: Int, holes: List<a>) -> Int = c\n"));
  assert(told(generic).contains("parameters of its own"), Some(told(generic)))
}

test "a law schema's function parameters are kept" {
  assert_eq(
    check_codes(
      b"fn hold(h: keep (Int) -> Int) -> Int = 0\nlaw schema held_once(f: (Int) -> Int) forall (x: Int) { hold(f) == x - x }\n",
    ),
    [],
  )
}

test "a borrowed parameter held at several places is offered `keep` once" {
  let diagnostics = source_diagnostics(b"fn f(g: (Int) -> Int) -> List<(Int) -> Int> = [g, g]");
  assert_eq(diagnostics.map(|d: Diagnostic| d.code), [b"E0475", b"E0475"]);
  assert_eq(fixes_of(diagnostics).len(), 1)
}

test "a named argument is held as the parameter it names takes it, and a constructor takes none" {
  let named = b"fn hold(n: Int, h: keep (Int) -> Int) -> Int = n\nfn lend(n: Int, h: (Int) -> Int) -> Int = h(n)\n";
  assert_eq(check_codes(named.concat(b"fn f(g: (Int) -> Int) -> Int = hold(h: g, n: 1)")), [
    b"E0475",
  ]);
  assert_eq(check_codes(named.concat(b"fn f(g: (Int) -> Int) -> Int = lend(h: g, n: 1)")), []);
  assert_eq(check_codes(b"fn f(g: (Int) -> Int) -> Option<(Int) -> Int> = Some(value: g)"), [
    b"E0123",
  ])
}

fn hole_diagnostics(src: Bytes) -> List<Diagnostic> / {abort.raise} =
  source_diagnostics(src).filter(|d: Diagnostic| d.code == b"W0613")

test "a hole checks as the expected type and performs nothing, so a pure signature keeps its effects" {
  assert_eq(check_codes(b"pub fn f(x: Int) -> Int = ???"), [b"W0613"]);
  assert_eq(check_codes(b"pub fn f(x: Int) -> Int = .."), [b"W0613"]);
  let c = valid_module_checker(b"pub fn f(x: Int) -> Int = ???");
  assert_eq(defined(c, b"m.f"), { scheme: b"(Int) -> Int", effects: b"", performed: b"" });
  assert_eq(check_codes(b"pub fn f() -> Int / {} = ???"), [b"W0613"]);
  assert_eq(check_codes(b"pub fn f() -> Int / {} = panic(\"todo\")"), [b"E0302"])
}

test "a hole reports its expected type, its effects and the in-scope names of that type" {
  let ds = hole_diagnostics(
    b"fn base(x: Int) -> Int = x\npub fn f(x: Int) -> Int = { let y = x; ??? }",
  );
  assert_eq(ds.len(), 1);
  let d = ds.get(0);
  assert_eq(d.severity, b"warning");
  assert_eq(d.labels.len(), 1);
  assert_eq(d.labels.get(0).text, b"expected `Int`");
  assert_eq(d.notes_text, [
    b"no effects are written where the hole stands; what the filling performs is inferred",
    b"in scope of that type: `x: Int`, `y: Int`",
    b"a run that reaches the hole raises `abort.raise`",
  ])
}

test "a hole under written effects reports what it may perform" {
  let src = b"effect net { write send(Bytes) -> Unit }\npub fn f(b: Bytes) -> Unit / { net.send, abort.raise } = { net.send(b); ??? }\n";
  let ds = hole_diagnostics(src);
  assert_eq(ds.len(), 1);
  assert_eq(
    ds.get(0).notes_text.at(0),
    Some(
      b"the hole may perform `abort.raise`, `m.net.send`; the rest of the body already performs `m.net.send`",
    ),
  );
  assert_eq(
    hole_diagnostics(b"pub fn f() -> Int / {} = ???").get(0).notes_text.at(0),
    Some(b"the effects written where the hole stands are empty: it may perform nothing"),
  )
}

test "a hole nothing constrains says so, and names no candidates" {
  let ds = hole_diagnostics(b"pub fn f() -> Int = { let x = ???; 1 }");
  assert_eq(ds.len(), 1);
  let d = ds.get(0);
  assert_eq(d.labels.get(0).text, b"its type is unconstrained here");
  assert_eq(d.notes_text, [
    b"no effects are written where the hole stands; what the filling performs is inferred",
    b"a run that reaches the hole raises `abort.raise`",
  ])
}

test "a hole in a test or a law is reported as one" {
  assert_eq(hole_diagnostics(b"test \"t\" { assert_eq(???, 1) }").len(), 1);
  assert_eq(hole_diagnostics(b"law \"l\" forall (n: Int) { ??? }").len(), 1)
}

fn with_effects(row_and_body: Bytes) -> Bytes =
  Bytes::concat_all([
    b"effect log { write emit(Bytes) -> Unit }\n",
    b"effect net { read recv[r]() -> Int }\n",
    b"effect tick { read now() -> Int }\n",
    row_and_body,
  ])

fn unperformed_in(src: Bytes) -> List<Bytes> / {abort.raise} =
  valid_module_checker(src).unperformed.flat_map(|d: Diagnostic| d.labels).map(|l: Label|
    src.slice(l.start, l.end))

fn narrowed(src: Bytes) -> Bytes / {abort.raise} =
  match fixes_of(valid_module_checker(src).unperformed) {
    [fix] -> {
      let fixed = fixed_by(src, fix);
      assert_eq(unperformed_in(fixed), []);
      fixed
    },
    _ -> panic("expected one fix"),
  }

test "an effect the body never performs is named, and the fix removes only that" {
  let performing = b"{ log.emit(b\"x\"); 1 }";
  let at = |row: Bytes, body: Bytes|
    with_effects(Bytes::concat_all([b"pub fn f() -> Int", row, b" = ", body]));
  assert_eq(unperformed_in(at(b" / {log.emit, tick.now}", performing)), [b"tick.now"]);
  assert_eq(narrowed(at(b" / {log.emit, tick.now}", performing)), at(b" / {log.emit}", performing));
  assert_eq(narrowed(at(b" / {tick.now, log.emit}", performing)), at(b" / {log.emit}", performing));
  assert_eq(
    narrowed(at(b" / {abort.raise, log.emit, tick.now}", performing)),
    at(b" / {log.emit}", performing),
  );
  assert_eq(narrowed(at(b" / {log.emit, tick.now}", b"1")), at(b"", b"1"));
  assert_eq(unperformed_in(at(b" / {log.emit}", performing)), [])
}

test "narrowing keeps an effect variable" {
  let at = |row: Bytes|
    with_effects(Bytes::concat_all([b"pub fn f<| e>(g: () -> Int / e) -> Int / ", row, b" = g()"]));
  assert_eq(narrowed(at(b"{log.emit | e}")), at(b"e"));
  assert_eq(narrowed(at(b"{log.emit, tick.now | e}")), at(b"e"))
}

test "an effect set counts as performed when any of its members is" {
  let set = b"effect set Both = {log.emit, tick.now}\n";
  let partly = with_effects(set.concat(b"pub fn f() -> Int / {Both} = { log.emit(b\"x\"); 1 }"));
  assert_eq(unperformed_in(partly), []);
  let idle = with_effects(set.concat(b"pub fn f() -> Int / {Both, abort.raise} = 1"));
  assert_eq(unperformed_in(idle), [b"abort.raise", b"Both"])
}

fn unperformed_beside_a_module(src: Bytes) -> List<Bytes> / {abort.raise} =
  match resolved_all([
      {
        name: b"base",
        src: b"pub effect log { write emit(Bytes) -> Unit }\npub effect tick { read now() -> Int }\npub effect set Both = {log.emit, tick.now}\n",
      },
      { name: b"m", src: src },
    ]) {
    Err(rejected) -> panic(String::of_bytes_lossy(rejected)),
    Ok(x) ->
      check_program(x.resolution, x.modules).checker.unperformed.flat_map(|d: Diagnostic|
        d.labels).map(|l: Label| src.slice(l.start, l.end)),
  }

test "a set from another module is judged the same way" {
  assert_eq(
    unperformed_beside_a_module(
      b"import base (Both, log)\npub fn f() -> Int / {Both} = { log.emit(b\"x\"); 1 }",
    ),
    [],
  );
  assert_eq(unperformed_beside_a_module(b"import base (Both)\npub fn f() -> Int / {Both} = 1"), [
    b"Both",
  ])
}

test "a function that performs less may be a parameter's default, as it may be an argument" {
  assert_eq(
    check_codes(
      b"pub fn nothing(ask: Bytes) -> Option<Bytes> = None\npub fn f(derived: (Bytes) -> Option<Bytes> / {abort.raise} = nothing) -> Bool / {abort.raise} = derived(b\"x\") == None",
    ),
    [],
  )
}

test "a raise reached only by a call back into the group is not performed" {
  let src = b"pub fn f(n: Int) -> Int / {abort.raise} = if n <= 0 { 0 } else { f(n - 1) }";
  assert_eq(unperformed_in(src), [b"abort.raise"])
}

test "a label the signature binds is the label the body performs on" {
  let at = |body: Bytes|
    with_effects(Bytes::concat_all([b"pub fn f<[c]>() -> Int / {net.recv[c]} = ", body]));
  assert_eq(unperformed_in(at(b"net.recv[c]()")), []);
  assert_eq(unperformed_in(at(b"1")), [b"net.recv[c]"])
}

test "no one wrote the effects of a law schema, so none is reported" {
  assert_eq(
    unperformed_in(
      b"pub law schema settles<a | e>(f: (a) -> a / e) forall (x: a) { f(f(x)) == f(x) }",
    ),
    [],
  )
}

fn connections() -> String =
  \\pub opaque type Conn = | Conn(Int)
  \\
  \\release for Conn by close
  \\
  \\pub fn close(c: keep Conn) -> Unit = match c { Conn(n) -> () }
  \\
  \\pub fn open() -> Conn = Conn(1)
  \\
  \\pub fn send(c: Conn, n: Int) -> Int = n
  \\

fn owned_codes(body: Bytes) -> List<Bytes> / {abort.raise} =
  check_codes(Bytes::of_string(connections()).concat(body))

test "a resource is consumed once: a use after its consumer, a second release, is rejected" {
  assert_eq(owned_codes(b"fn f() -> Unit = { let c = open(); close(c) }"), []);
  assert_eq(owned_codes(b"fn f() -> Unit = { let c = open(); close(c); close(c) }"), [b"E0316"]);
  assert_eq(owned_codes(b"fn f() -> Int = { let c = open(); close(c); send(c, 1) }"), [b"E0316"]);
  assert_eq(owned_codes(b"fn f() -> Int = { let c = open(); send(c, 1) + send(c, 2) }"), [])
}

test "a parameter borrows its resource unless it is written `keep`" {
  assert_eq(owned_codes(b"fn f(c: Conn) -> Unit = close(c)"), [b"E0318"]);
  assert_eq(owned_codes(b"fn f(c: keep Conn) -> Unit = close(c)"), []);
  assert_eq(owned_codes(b"fn f(c: Conn) -> Int = send(c, 1)"), [])
}

test "a resource nothing holds is rejected where it is made, and `_` holds none" {
  assert_eq(owned_codes(b"fn f() -> Unit = { open(); () }"), [b"E0322"]);
  assert_eq(owned_codes(b"fn f() -> Int = send(open(), 1)"), [b"E0322"]);
  assert_eq(owned_codes(b"fn f() -> Unit = { let _ = open(); () }"), [b"E0322"])
}

test "a branch that consumes a resource leaves it consumed past the join" {
  assert_eq(
    owned_codes(b"fn f(b: Bool) -> Unit = { let c = open(); if b { close(c) } else { () } }"),
    [],
  );
  assert_eq(
    owned_codes(
      b"fn f(b: Bool) -> Int = { let c = open(); if b { close(c) } else { () }; send(c, 1) }",
    ),
    [b"E0316"],
  )
}

fn release_place_names(body: Bytes) -> List<Bytes> / {abort.raise} =
  valid_module_checker(Bytes::of_string(connections()).concat(body)).release_sites.fold(
    [],
    |acc: List<Bytes>, r: ReleaseSite|
      match r.release.place {
        ReleaseAfter -> acc.push(b"after"),
        ReleaseBefore -> acc.push(b"before"),
        ReleaseUnwinding -> acc.push(b"unwinding"),
        ReleaseMissing -> acc.push(b"missing"),
        ReleaseFailing(_) -> acc,
      },
  )

fn failing_places(body: Bytes) -> List<Int> / {abort.raise} = {
  let sites = valid_module_checker(Bytes::of_string(connections()).concat(body)).release_sites;
  sites.fold([], |acc: List<Int>, r: ReleaseSite|
    if r.release.place != ReleaseAfter && r.release.place != ReleaseBefore { acc } else {
      let n = sites.filter(|x: ReleaseSite|
        x.at == r.at && x.release.place == ReleaseFailing(r.release.holder)).len(
      );
      if n == 0 { acc } else { acc.push(n) }
    })
}

test "a resource is let go where its block ends: before a last expression that does not name it" {
  assert_eq(release_place_names(b"fn f() -> Int = { let c = open(); let n = 1; n }"), [b"before"]);
  assert_eq(release_place_names(b"fn f() -> Int = { let c = open(); send(c, 1) }"), [
    b"unwinding",
    b"after",
  ]);
  assert_eq(release_place_names(b"fn f() -> Unit = { let c = open(); close(c) }"), [])
}

test "a failure lets go what the body owns, and what a call took before a later argument failed" {
  let src = |body: Bytes|
    Bytes::concat_all([
      b"fn g() -> Int / {abort.raise} = 1\nfn take(c: keep Conn, n: Int) -> Unit = close(c)\n",
      body,
    ]);
  assert_eq(
    release_place_names(src(b"fn f() -> Unit / {abort.raise} = { let c = open(); take(c, g()) }")),
    [b"unwinding"],
  );
  assert_eq(
    release_place_names(src(b"fn f() -> Int / {abort.raise} = { let c = open(); send(c, g()) }")),
    [b"unwinding", b"unwinding", b"after"],
  );
  assert_eq(
    release_place_names(
      src(
        b"effect ask { read get() -> Int }\nfn f() -> Int / {abort.raise} = { let c = open(); let n = handle { ask.get() } with { ask.get() resume k -> k(g()) }; n + send(c, 1) }",
      ),
    ),
    [b"unwinding", b"unwinding", b"unwinding", b"after"],
  );
  assert_eq(release_place_names(src(b"fn f() -> Int / {abort.raise} = { let c = open(); g() }")), [
    b"before",
  ])
}

test "a handled failure lets go past the handler only what the handled body did not take" {
  let src = |body: Bytes| Bytes::concat_all([b"fn g() -> Int / {abort.raise} = 1\n", body]);
  assert_eq(
    release_place_names(
      src(
        b"fn f() -> Int = { let c = open(); let n = handle { g() } with { abort.raise(m) -> 0 }; send(c, n) }",
      ),
    ),
    [b"unwinding", b"unwinding", b"after"],
  )
}

test "a clause or a `return` clause borrows what is bound outside it, and consumes none of it" {
  assert_eq(
    owned_codes(
      b"effect ask { read get() -> Int }\nfn f() -> Int = { let c = open(); handle { ask.get() } with { ask.get() resume k -> { close(c); k(1) } } }",
    ),
    [b"E0316"],
  );
  assert_eq(
    owned_codes(
      b"fn f() -> Int = { let c = open(); let n = handle { 1 } with { return v -> { close(c); v } }; n }",
    ),
    [b"E0316"],
  );
  assert_eq(
    owned_codes(
      b"effect ask { read get() -> Int }\nfn f() -> Int = { let c = open(); handle { ask.get() } with { ask.get() resume k -> k(send(c, 1)) } }",
    ),
    [],
  )
}

test "a clause's parameter the operation takes is the clause's to let go" {
  assert_eq(
    release_place_names(
      b"effect sink { write give(c: keep Conn) -> Unit\n write count(n: Int) -> Unit }\nfn f() -> Unit = handle { sink.give(open()) } with { sink.give(c) resume k -> k(()), sink.count(n) resume k -> k(()) }",
    ),
    [b"before"],
  )
}

test "a `let ... else` runs its value before its `else`, and a borrowed value's parts are borrowed too" {
  assert_eq(
    release_place_names(
      b"fn upgrade(c: keep Conn) -> Option<Conn> = Some(c)\nfn f() -> Int = { let c = open(); let Some(d) = upgrade(c) else { 0 }; send(d, 1) }",
    ),
    [b"before", b"unwinding", b"after"],
  );
  assert_eq(
    owned_codes(b"fn f(r: { conn: Conn, n: Int }) -> Int = { let { conn, n } = r; send(conn, n) }"),
    [],
  )
}

test "a field is moved out on every path past a branch or on none, and never inside a function" {
  assert_eq(
    owned_codes(
      b"fn f(b: Bool, r: keep { a: Conn, n: Int }) -> Unit = if b { close(r.a) } else { () }",
    ),
    [b"E0316"],
  );
  assert_eq(
    owned_codes(
      b"fn f(xs: List<Int>, r: keep { a: Conn, n: Int }) -> List<Int> = xs.map(|x: Int| { close(r.a); x })",
    ),
    [b"E0316"],
  )
}

test "a block that ends in a statement lets go after it, and a call of what took a resource holds it" {
  assert_eq(release_place_names(b"fn f() -> Unit = { let c = open(); send(c, 1); }"), [
    b"unwinding",
    b"after",
  ]);
  assert_eq(
    release_place_names(
      b"fn h() -> Int / {abort.raise} = 1\nfn f() -> Int / {abort.raise} = { let c = open(); let g = |n: Int| { close(c); n }; g(h()) }",
    ),
    [b"unwinding"],
  )
}

test "a function that consumed what it captured is only called, and letting it go lets that go" {
  assert_eq(
    release_place_names(b"fn f() -> Unit = { let c = open(); let g = || close(c); () }"),
    [b"before"],
  );
  assert_eq(
    owned_codes(
      b"fn run(g: keep once () -> Unit) -> Unit = g()\nfn f() -> Unit = { let c = open(); run(|| close(c)) }",
    ),
    [b"E0316"],
  );
  assert_eq(
    owned_codes(
      b"fn run(g: () -> Unit) -> Unit = g()\nfn f() -> Unit = { let c = open(); let g = || close(c); run(g) }",
    ),
    [b"E0316"],
  )
}

test "a function may consume what it captures only where it runs once" {
  assert_eq(
    owned_codes(
      b"fn f(xs: List<Int>) -> List<Int> = { let c = open(); xs.map(|x: Int| { close(c); x }) }",
    ),
    [b"E0316"],
  );
  assert_eq(
    owned_codes(
      b"fn f(xs: List<Int>) -> List<Int> = { let c = open(); xs.map(|x: Int| send(c, x)) }",
    ),
    [],
  );
  assert_eq(owned_codes(b"fn f() -> Unit = { let c = open(); let g = || close(c); g(); g() }"), [
    b"E0316",
  ]);
  assert_eq(
    owned_codes(b"fn f() -> Int = { let c = open(); let g = || send(c, 1); close(c); g() }"),
    [b"E0316"],
  )
}

test "a type's own module takes a resource apart, which consumes it" {
  assert_eq(owned_codes(b"fn f() -> Int = { let c = open(); match c { Conn(n) -> n } }"), []);
  assert_eq(owned_codes(b"fn f() -> Int = { let c = open(); let Conn(n) = c; n + send(c, 1) }"), [
    b"E0316",
  ])
}

test "a release performs within the effects of what lets its value go" {
  let src = |body: Bytes|
    Bytes::concat_all([
      b"effect wire { write shut() -> Unit }\n",
      b"pub opaque type Sock = | Sock(Int)\nrelease for Sock by shut_sock\n",
      b"pub fn shut_sock(s: keep Sock) -> Unit / {wire.shut} = match s { Sock(n) -> wire.shut() }\n",
      b"pub fn sock() -> Sock = Sock(1)\n",
      body,
    ]);
  assert_eq(check_codes(src(b"fn holds() -> Unit = { let s = sock(); () }")), [b"E0302"]);
  assert_eq(check_codes(src(b"fn holds() -> Unit / {wire.shut} = { let s = sock(); () }")), [])
}

test "a `release` is stated for an opaque type of the module's own, by a function that takes it" {
  assert_eq(
    check_codes(
      b"pub type T = | T(Int)\nrelease for T by drop\npub fn drop(t: keep T) -> Unit = match t { T(n) -> () }\n",
    ),
    [b"E0225"],
  );
  assert_eq(
    check_codes(
      b"pub opaque type T = | T(Int)\nrelease for T by drop\npub fn drop(t: T) -> Unit = ()\n",
    ),
    [b"E0218"],
  );
  assert_eq(
    check_codes(
      b"pub opaque type T = | T(Int)\nrelease for T by drop\npub fn drop(t: keep T) -> Int = match t { T(n) -> n }\n",
    ),
    [b"E0218"],
  )
}

test "`keep` is written only where something is taken, and a resource fills only a kept type parameter" {
  assert_eq(owned_codes(b"fn f(n: keep Int) -> Int = n"), [b"E0323"]);
  assert_eq(owned_codes(b"fn id<a>(x: a) -> a = x\nfn f() -> Conn = { let c = open(); id(c) }"), [
    b"E0317",
  ]);
  assert_eq(owned_codes(b"fn id<keep a>(x: keep a) -> a = x\nfn f() -> Conn = id(open())"), []);
  assert_eq(owned_codes(b"fn twice<keep a>(x: keep a) -> (a, a) = (x, x)"), [b"E0316"])
}

test "a type that holds a `once` function is a resource where no type states a `release`" {
  let step = b"type Step = | Done | More(once (Unit) -> Step)\n";
  assert_eq(
    check_codes(
      step.concat(
        b"fn next(s: keep Step) -> Step = match s { More(rest) -> rest(()), Done -> Done }\n",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      step.concat(b"fn next(s: Step) -> Step = match s { More(rest) -> rest(()), Done -> Done }\n"),
    ),
    [b"E0318"],
  )
}

test "a clause calls its continuation at most once" {
  assert_eq(
    check_codes(
      b"effect ask { read get() -> Int }\nfn f() -> Int = handle { ask.get() } with { ask.get() resume k -> k(1) + k(2) }\n",
    ),
    [b"E0316"],
  )
}

test "a continuation kept in a value is a `once` function there, called at most once" {
  let parked = |field: Bytes, rest: Bytes|
    check_codes(
      Bytes::concat_all([
        b"effect amb { read flip() -> Bool }\ntype Saved = | Done(Int) | Parked(",
        field,
        b"(Bool) -> Saved)\nfn parked() -> Saved = handle { Done(if amb.flip() { 1 } else { 2 }) } with { amb.flip() resume k -> Parked(k) }\n",
        rest,
      ]),
    );
  let done = b"fn done(s: keep Saved) -> Int = match s { Done(n) -> n, Parked(later) -> 0 }\n";
  assert_eq(parked(b"", b""), [b"E0201"]);
  assert_eq(
    parked(
      b"once ",
      done.concat(
        b"fn later() -> Int = match parked() { Parked(k) -> done(k(true)), Done(n) -> n }\n",
      ),
    ),
    [],
  );
  assert_eq(
    parked(
      b"once ",
      done.concat(
        b"fn twice() -> Int = match parked() { Parked(k) -> done(k(true)) + done(k(false)), Done(n) -> n }\n",
      ),
    ),
    [b"E0316"],
  )
}

test "a `once` function stands only where its type is written `once`, and a function that may be called again stands for one" {
  assert_eq(
    check_codes(
      b"type Plain = | Plain((Int) -> Int)\nfn park(f: keep once (Int) -> Int) -> Plain = Plain(f)\n",
    ),
    [b"E0201"],
  );
  assert_eq(
    check_codes(b"fn run(f: keep once () -> Int) -> Int = f()\nfn g() -> Int = run(|| 1)\n"),
    [],
  );
  assert_eq(
    check_codes(
      b"fn apply(h: (once () -> Int) -> Int) -> Int = h(|| 0)\nfn plain(g: () -> Int) -> Int = g() + g()\nfn f() -> Int = apply(plain)\n",
    ),
    [b"E0201"],
  )
}

test "a function that calls one that borrows a resource borrows it too, and neither outlives it" {
  assert_eq(
    owned_codes(
      b"fn f() -> Int = { let c = open(); let g = || send(c, 1); let h = || g(); close(c); h() }",
    ),
    [b"E0316"],
  );
  assert_eq(
    owned_codes(b"fn f() -> Int = { let c = open(); let g = || send(c, 1); let h = || g(); h() }"),
    [],
  );
  assert_eq(owned_codes(b"fn mk(c: Conn) -> () -> Int = { let h = || send(c, 1); h }"), [b"E0318"]);
  assert_eq(
    owned_codes(
      b"fn run(g: () -> Int) -> Int = g()\nfn f(c: Conn) -> Int = { let h = || send(c, 1); run(h) }",
    ),
    [],
  )
}

test "a function that took one that took a resource lets the resource go where its block ends" {
  assert_eq(
    release_place_names(
      b"fn f() -> Unit = { let c = open(); let g = || close(c); let h = || g(); () }",
    ),
    [b"before"],
  );
  assert_eq(
    release_place_names(
      b"fn f() -> Unit = { let c = open(); let g = || close(c); let h = || g(); h() }",
    ),
    [],
  )
}

test "a guard borrows: one that would consume is rejected" {
  assert_eq(
    owned_codes(
      b"fn done(c: keep Conn) -> Bool = { close(c); false }\nfn f(n: Int) -> Int = { let c = open(); match n { 1 if done(c) -> 0, _ -> send(c, 1) } }",
    ),
    [b"E0316"],
  );
  assert_eq(
    owned_codes(
      b"fn f(n: Int) -> Int = { let c = open(); match n { 1 if send(c, 1) > 0 -> 0, _ -> send(c, 2) } }",
    ),
    [],
  )
}

test "a block passed borrowed as a whole lets nothing it binds go under the call it is passed to" {
  assert_eq(owned_codes(b"fn f() -> Int = send({ let c = open(); c }, 1)"), [b"E0322"]);
  assert_eq(
    owned_codes(
      b"fn f(o: keep Option<Conn>, d: Conn) -> Int = send(match o { Some(c) -> c, None -> d }, 1)",
    ),
    [b"E0322"],
  );
  assert_eq(
    owned_codes(b"fn f(b: Bool, x: Conn, y: Conn) -> Int = send(if b { x } else { y }, 1)"),
    [],
  )
}

test "an update writes over a resource field only once it is moved out" {
  assert_eq(
    owned_codes(
      b"fn swap(r: keep { conn: Conn, n: Int }, d: keep Conn) -> { conn: Conn, n: Int } = { ..r, conn: d }",
    ),
    [b"E0322"],
  );
  assert_eq(
    owned_codes(
      b"fn swap(r: keep { conn: Conn, n: Int }, d: keep Conn) -> { conn: Conn, n: Int } = { let old = r.conn; close(old); { ..r, conn: d } }",
    ),
    [],
  )
}

test "a resource is moved out of a record one field at a time" {
  assert_eq(
    owned_codes(b"fn f(r: keep { inner: { conn: Conn } }) -> Unit = close(r.inner.conn)"),
    [b"E0316"],
  );
  assert_eq(owned_codes(b"fn f(r: { inner: { conn: Conn } }) -> Unit = close(r.inner.conn)"), [
    b"E0318",
  ]);
  assert_eq(
    owned_codes(
      b"fn f(r: keep { inner: { conn: Conn } }) -> Unit = { let inner = r.inner; close(inner.conn) }",
    ),
    [],
  );
  assert_eq(
    owned_codes(
      b"fn f(r: { c: Option<Conn> }) -> Int = match r.c { Some(x) -> send(x, 1), None -> 0 }",
    ),
    [],
  );
  assert_eq(owned_codes(b"fn f(r: { c: Conn }) -> Int = { let x = r.c; send(x, 1) }"), [])
}

test "`..` and an alternative's `_` drop no resource" {
  assert_eq(
    owned_codes(b"fn f(r: keep { a: Conn, b: Conn }) -> Unit = { let { a, .. } = r; close(a) }"),
    [b"E0322"],
  );
  assert_eq(
    owned_codes(b"fn f(r: keep { a: Conn, n: Int }) -> Unit = { let { a, .. } = r; close(a) }"),
    [],
  );
  assert_eq(
    owned_codes(b"fn f(xs: keep List<Conn>) -> Unit = match xs { [x, ..] -> close(x), [] -> () }"),
    [b"E0322"],
  );
  assert_eq(
    owned_codes(
      b"type Two = | A(Conn, Conn) | B(Conn, Conn)\nfn f(t: keep Two) -> Unit = match t { A(c, _) | B(c, _) -> close(c) }",
    ),
    [b"E0322", b"E0322"],
  )
}

test "a handler's variable reads what is above it, hides what it names, and holds no resource" {
  let ask = |body: Bytes|
    Bytes::of_string(connections()).concat(b"effect ask { read get() -> Int }\n").concat(body);
  assert_eq(
    check_codes(
      ask(
        b"fn f() -> Int = handle { ask.get() } with { var c = open(), ask.get() resume k -> k(1) }",
      ),
    ),
    [b"E0322"],
  );
  assert_eq(
    check_codes(
      ask(
        b"fn f() -> Int = { let c = open(); handle { ask.get() } with { var c = 0, ask.get() resume k -> { c = c + 1; k(c) } } }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      ask(
        b"fn f() -> Int = { let c = open(); handle { ask.get() } with { var n = { close(c); 0 }, ask.get() resume k -> k(n) } + send(c, 1) }",
      ),
    ),
    [b"E0316"],
  )
}

test "a `once` function is called once, by what owns it" {
  assert_eq(owned_codes(b"fn run(f: once () -> Unit) -> Unit = f()"), [b"E0318"]);
  assert_eq(owned_codes(b"fn run(f: keep once () -> Unit) -> Unit = f()"), []);
  assert_eq(owned_codes(b"fn run(f: keep once () -> Unit) -> Unit = { f(); f() }"), [b"E0316"])
}

test "a release that fails lets go of what is still owned where it runs" {
  assert_eq(failing_places(b"fn f() -> Unit = { let a = open(); let b = open(); () }"), [1]);
  assert_eq(failing_places(b"fn f() -> Unit = { let a = open(); () }"), []);
  assert_eq(failing_places(b"fn f() -> Conn = { let c = open(); let d = open(); d }"), [1]);
  assert_eq(
    failing_places(
      b"fn wrap(c: Conn) -> Conn = open()\nfn f() -> Conn = { let c = open(); wrap(c) }",
    ),
    [1],
  )
}

test "a `let` whose pattern misses lets go of what the body owns, and of the value" {
  assert_eq(
    release_place_names(
      b"fn maybe() -> Option<Int> = None\nfn f() -> Int / {abort.raise} = { let c = open(); let Some(n) = maybe(); send(c, n) }",
    ),
    [b"unwinding", b"missing", b"unwinding", b"after"],
  );
  assert_eq(
    release_place_names(b"fn f() -> Int = { let c = open(); let (n, m) = (1, 2); send(c, n + m) }"),
    [b"unwinding", b"unwinding", b"after"],
  )
}

test "a test's body is judged as a function's is, and lets go of what it owns" {
  assert_eq(owned_codes(b"test \"t\" { let c = open(); close(c); close(c) }"), [b"E0316"]);
  assert_eq(release_place_names(b"test \"t\" { let c = open(); () }"), [b"before"])
}

test "a block passed borrowed as a whole is rejected only where it may return what it binds" {
  assert_eq(
    owned_codes(
      b"fn f(x: Conn, y: Conn) -> Int = send({ let c = open(); if send(c, 0) > 0 { x } else { y } }, 1)",
    ),
    [],
  )
}

test "a function that takes one that borrows borrows what it does" {
  assert_eq(
    owned_codes(
      b"fn f() -> Int = { let c = open(); let d = open(); let g = || { close(c); send(d, 1) }; let h = || g(); close(d); h() }",
    ),
    [b"E0316"],
  );
  assert_eq(
    owned_codes(
      b"fn f() -> Int = { let c = open(); let d = open(); let g = || { close(c); send(d, 1) }; let h = || g(); h() }",
    ),
    [],
  )
}

test "a release performs what the effects of the body letting it go name, or a `handle` around it handles" {
  let logged = |body: Bytes|
    Bytes::concat_all([
      b"effect log { write note(s: String) -> Unit }\nopaque type R = | R(Int)\nrelease for R by shut\nfn shut(r: keep R) -> Unit / {log.write} = match r { R(_) -> log.note(\"x\") }\nfn run(g: () -> Int) -> Int = g()\n",
      body,
    ]);
  assert_eq(check_codes(logged(b"fn f() -> Int = run(|| { let r = R(1); 1 })")), [b"E0302"]);
  assert_eq(
    check_codes(
      logged(
        b"fn f() -> Int = run(|| handle { let r = R(1); 1 } with { log.note(s) resume k -> k(()) })",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      logged(b"fn f() -> Int = handle { let r = R(1); 1 } with { log.note(s) resume k -> k(()) }"),
    ),
    [],
  );
  assert_eq(check_codes(logged(b"fn f() -> Int = { let r = R(1); 1 }")), [b"E0302"])
}

test "a release's effects are those of the body it runs in, less what a `handle` around it handles there" {
  let logged = |body: Bytes|
    Bytes::concat_all([
      b"effect log { write note(s: String) -> Unit }\neffect ask { read get() -> Int }\nopaque type R = | R(Int)\nrelease for R by shut\nfn shut(r: keep R) -> Unit / {log.write} = match r { R(_) -> log.note(\"x\") }\ntype Box = | Box(R, Int)\nfn wrap(r: keep R, n: Int) -> Box = Box(r, n)\nfn zero() -> Int = 0\n",
      body,
    ]);
  assert_eq(
    check_codes(
      logged(
        b"fn run(g: () -> Int / {log.write}) -> Int / {log.write} = g()\nfn f() -> Int / {log.write} = run(|| { log.note(\"y\"); let r = R(1); 1 })",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      logged(
        b"fn f() -> Int = handle { handle { ask.get() } with { ask.get() resume k -> { let r = R(1); k(1) } } } with { log.note(s) resume k -> k(()) }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(logged(b"fn f() -> Int = { let r = R(1); let g = || { shut(r); 1 }; 0 }")),
    [b"E0302"],
  );
  assert_eq(check_codes(logged(b"fn f() -> Box / {abort.raise} = wrap(R(1), 10 / zero())")), [
    b"E0302",
  ])
}

test "a failing release lets go of what the node returns only where the node's value is taken" {
  assert_eq(
    failing_places(
      b"fn peek(c: Conn) -> Bool = true\nfn f(x: Conn) -> Int = send({ let c = open(); if peek(c) { x } else { x } }, 1)",
    ),
    [],
  )
}

test "an `else` consumes only what its block binds, and a branch passed borrowed returns nothing let go after it" {
  assert_eq(
    owned_codes(
      b"fn f(o: Option<Int>) -> Int = { let c = open(); let n = { let Some(x) = o else { close(c); 0 }; x }; n }",
    ),
    [b"E0316"],
  );
  assert_eq(
    owned_codes(
      b"fn f(o: Option<Int>) -> Int = { let c = open(); let Some(x) = o else { close(c); 0 }; x }",
    ),
    [],
  );
  assert_eq(
    owned_codes(
      b"fn f(b: Bool, d: Conn) -> Int = { let c = open(); send(if b { close(c); d } else { c }, 1) }",
    ),
    [b"E0322"],
  )
}

test "an `else` returns as its block does, and a `simulate` block returns what it simulates" {
  assert_eq(
    failing_places(
      b"fn pick(c: Conn) -> Conn = open()\nfn f(o: keep Option<Conn>) -> Conn = { let c = open(); let Some(x) = o else { pick(c) }; close(c); x }",
    ),
    [1],
  );
  assert_eq(
    owned_codes(
      b"type Box = { conn: Conn, n: Int }\nfn shut_box(p: keep Box) -> Unit = close(p.conn)\nfn f(b: Bool, p: keep Box) -> Int = { let k = if b { shut_box(p); 0 } else { p.n }; k }",
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"opaque type T = | T(Int)\nrelease for T by stop\nfn stop(t: keep T) -> Unit / {clock.now} = match t { T(_) -> { let n = clock.now(); () } }\nfn f() -> Int / {abort.raise, sim.read} = simulate { let t = T(1); 1 }",
    ),
    [],
  )
}

test "a continuation takes what the clause resumes the body with" {
  let pool = |clause: Bytes|
    Bytes::concat_all([
      b"effect pool { write get() -> Conn }\nfn f() -> Unit = handle { let c = pool.get(); close(c) } with { pool.get() resume k -> ",
      clause,
      b" }",
    ]);
  assert_eq(owned_codes(pool(b"k(open())")), []);
  assert_eq(release_place_names(pool(b"{ let d = open(); k(d) }")), [])
}

test "a `return` clause owns what the body returns, however the `handle`'s value is used" {
  assert_eq(
    owned_codes(
      b"fn f() -> Int = { let n = handle { open() } with { return v -> send(v, 1) }; n }",
    ),
    [],
  )
}

test "a `return` clause returns as its `handle` does" {
  assert_eq(owned_codes(b"fn f() -> Int = send(handle { 1 } with { return v -> open() }, 1)"), [
    b"E0322",
  ])
}

test "an `else` returns as its block does: one passed borrowed holds nothing it makes" {
  assert_eq(
    owned_codes(b"fn f(o: Option<Conn>) -> Int = send({ let Some(x) = o else { open() }; x }, 1)"),
    [b"E0322"],
  )
}

test "a `let` whose pattern misses into its `else` lets go of the value it missed" {
  let src = |body: Bytes|
    Bytes::concat_all([
      b"effect wire { write shut() -> Unit }\n",
      b"pub opaque type Sock = | Sock(Int)\nrelease for Sock by shut_sock\n",
      b"pub fn shut_sock(s: keep Sock) -> Unit / {wire.shut} = match s { Sock(n) -> wire.shut() }\n",
      b"type Two = | A(Int) | B(Sock)\n",
      body,
    ]);
  assert_eq(check_codes(src(b"fn f(t: keep Two) -> Int = { let A(n) = t else { 0 }; n }")), [
    b"E0302",
  ]);
  assert_eq(
    check_codes(src(b"fn f(t: keep Two) -> Int / {wire.shut} = { let A(n) = t else { 0 }; n }")),
    [],
  )
}

test "a `try` handles what a release inside it raises, as the `handle` it is" {
  assert_eq(
    check_codes(
      b"effect toml { raise syntax(e: Int) }\nopaque type T = | T(Int)\nrelease for T by stop\nfn stop(t: keep T) -> Unit / {toml.syntax} = match t { T(n) -> toml.syntax(n) }\nfn f() -> Result<Int, Int> = try { let t = T(1); toml.syntax(2) }",
    ),
    [],
  )
}

test "the right of `&&` and `||` may not run, so it only borrows" {
  assert_eq(
    owned_codes(
      b"fn took(c: keep Conn) -> Bool = { close(c); true }\nfn f(b: Bool) -> Bool = { let c = open(); b && took(c) }",
    ),
    [b"E0316"],
  );
  assert_eq(owned_codes(b"fn f(b: Bool) -> Bool = { let c = open(); b && send(c, 1) > 0 }"), [])
}

test "a function that borrows a record's field is used only while the record holds it" {
  assert_eq(
    owned_codes(
      b"fn f(r: keep { a: Conn, n: Int }) -> Int = { let g = || send(r.a, 1); close(r.a); g() }",
    ),
    [b"E0316"],
  )
}

fn resolved_of(src: Bytes) -> List<TypedBody<Type>> / {abort.raise} =
  resolved_bodies(valid_module_checker(src))

fn whole_body(src: Bytes, owner: Bytes) -> List<TypedExpression<Type>> / {abort.raise} =
  resolved_of(src).filter(|b: TypedBody<Type>| b.owner == owner && b.part == WholeBody).map(
    |b: TypedBody<Type>| b.body,
  )

test "every body a check walks resolves, recorded under its owner and part" {
  let c = valid_module_checker(
    Bytes::concat_all([
      b"type Shape = | Circle(Int) | Square(Int)\n",
      b"fn area(s: Shape, scale: Int = 1) -> Int = match s { Circle(r) -> 3 * r * r * scale, Square(w) -> w * w * scale }\n",
      b"fn twice(x: Int) -> Int requires x > 0 = area(Circle(x)) + area(Square(x), scale: 2)\n",
      b"test \"areas\" { assert_eq(twice(1), 7) }\n",
      b"law \"square\" forall (n: Int) where n > 0 { area(Square(n)) == n * n }\n",
    ]),
  );
  let resolved = resolved_bodies(c);
  assert_eq(resolved.len(), c.typed_bodies.len());
  assert_eq(
    resolved.map(|b: TypedBody<Type>| part_key(b.part)).sort_by(|a: Bytes, b: Bytes|
      compare(a, b) != Greater),
    [b"body", b"body", b"clause 0", b"guard", b"law", b"run"],
  )
}

test "a read inside its own recursive group resolves at its definition's own variables" {
  let reads = whole_body(
    b"fn len<a>(xs: List<a>) -> Int = match xs { [] -> 0, [_, ..rest] -> 1 + len(rest) }",
    b"m.len",
  ).flat_map(
    typed_expression_nodes,
  ).fold([], |acc: List<List<Type>>, e: TypedExpression<Type>|
    match e.node {
      TypedRead(ReadDefinition(d)) -> if d.full == b"m.len" { acc.push(d.args) } else { acc },
      _ -> acc,
    });
  assert_eq(reads, [[VariableType(0)]])
}

test "an update resolves with the fields it copies from its base" {
  let copies = whole_body(
    b"fn moved(p: {x: Int, y: Int}) -> {x: Int, y: Int} = { ..p, x: 1 }",
    b"m.moved",
  ).flat_map(
    typed_expression_nodes,
  ).fold([], |acc: List<List<Bytes>>, e: TypedExpression<Type>|
    match e.node { TypedUpdate(u) -> acc.push(u.copied_fields), _ -> acc });
  assert_eq(copies, [[b"y"]])
}
