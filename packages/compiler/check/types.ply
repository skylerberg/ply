import compiler.syntax.type_syntax (Mode, ReadMode, WriteMode, InvalidMode, RaiseMode, is_raise,
                                    mode_text, angled, mode_bin)
import compiler.syntax.lexer (is_identifier_continue)
import compiler.syntax.parsing (Identifier)
import std.bin
import std.list
import std.bytes (ascii_of_int)
import std.option

pub type Resource = | NamedResource(Bytes) | SingletonResource | ResourceVariable(Int) | AnyResource

pub type Effect = { effect: Bytes, resource: Resource, mode: Mode, op: Option<Bytes> }

derive bin for Resource

derive bin for Effect

pub type Effects = { listed: List<Effect>, variable: Option<Int> }

fn resource_lt(a: Resource, b: Resource) -> Bool =
  match a {
    NamedResource(x) -> match b {
      NamedResource(y) -> compare(x, y) == Less,
      ResourceVariable(_) -> true,
      SingletonResource -> true,
      AnyResource -> false,
    },
    ResourceVariable(x) -> match b {
      NamedResource(_) -> false,
      ResourceVariable(y) -> x < y,
      SingletonResource -> true,
      AnyResource -> false,
    },
    SingletonResource -> false,
    AnyResource -> false,
  }

pub fn resource_covers(a: Resource, b: Resource) -> Bool =
  match a {
    AnyResource -> true,
    NamedResource(x) -> match b { NamedResource(y) -> x == y, _ -> false },
    ResourceVariable(x) -> match b { ResourceVariable(y) -> x == y, _ -> false },
    SingletonResource -> match b { SingletonResource -> true, _ -> false },
  }

fn mode_rank(mode: Mode) -> Int =
  match mode { ReadMode -> 0, WriteMode -> 1, InvalidMode -> 2, RaiseMode -> 3 }

fn op_lt(a: Option<Bytes>, b: Option<Bytes>) -> Bool =
  match a {
    None -> match b { Some(_) -> true, None -> false },
    Some(x) -> match b { Some(y) -> compare(x, y) == Less, None -> false },
  }

pub fn effect_lt(a: Effect, b: Effect) -> Bool =
  compare(a.effect, b.effect) == Less
    || (a.effect == b.effect
    && (resource_lt(a.resource, b.resource)
    || (a.resource == b.resource
    && (mode_rank(a.mode) < mode_rank(b.mode)
    || (mode_rank(a.mode) == mode_rank(b.mode) && op_lt(a.op, b.op))))))

pub fn effect_covers(a: Effect, b: Effect) -> Bool =
  a.effect == b.effect && resource_covers(a.resource, b.resource)
    && (a == b
    || (match a.op { None -> mode_rank(a.mode) == mode_rank(b.mode), Some(_) -> a.op == b.op }))

pub fn effects_cover(effects: List<Effect>, x: Effect) -> Bool =
  effects.fold(false, |acc: Bool, y: Effect| acc || effect_covers(y, x))

fn is_permissive(entry: Effect) -> Bool =
  match entry.resource {
    AnyResource -> true,
    _ -> match entry.op { None -> true, Some(_) -> false },
  }

pub fn effect_allowed(found: List<Effect>, entry: Effect) -> Bool =
  effects_cover(found, entry) || is_permissive(entry)

pub fn effects_conflict(a: Effect, b: Effect) -> Bool =
  a.effect == b.effect && a.resource == b.resource
    && (mode_rank(a.mode) == 1 || mode_rank(b.mode) == 1)

pub fn effects_insert(effects: List<Effect>, entry: Effect) -> List<Effect> / {abort.raise} = {
  let n = effects.len();
  let i = range(0, n).fold(n, |acc: Int, j: Int|
    if acc < n { acc }
    else if effect_lt(entry, effects.get(j)) || effects.get(j) == entry { j }
    else { acc });
  if i < n && effects.get(i) == entry { effects }
  else { effects.take(i).push(entry).concat(effects.drop(i)) }
}

pub fn effects_union(a: List<Effect>, b: List<Effect>) -> List<Effect> / {abort.raise} =
  b.fold(a, |acc: List<Effect>, entry: Effect| effects_insert(acc, entry))

pub fn effects_sorted(effects: List<Effect>) -> List<Effect> / {abort.raise} =
  iterate(effects.map(|a: Effect| [a]), effects.len() + 1, |runs: List<List<Effect>>|
    match runs {
      [] -> Stop([]),
      [run] -> Stop(run),
      _ ->
        Continue(
          range(0, (runs.len() + 1) / 2).map(|i: Int|
            if 2 * i + 1 < runs.len() { effects_merged(runs.get(2 * i), runs.get(2 * i + 1)) }
            else { runs.get(2 * i) }),
        ),
    })

fn effects_merged(a: List<Effect>, b: List<Effect>) -> List<Effect> / {abort.raise} = {
  let last = |out: List<Effect>, entry: Effect|
    if out.len() > 0 && out.get(out.len() - 1) == entry { out } else { out.push(entry) };
  iterate(
    { i: 0, j: 0, out: [] },
    a.len() + b.len() + 1,
    |s: { i: Int, j: Int, out: List<Effect> }|
      if s.i >= a.len() {
        Stop(range(s.j, b.len()).fold(s.out, |out: List<Effect>, k: Int| last(out, b.get(k))))
      } else if s.j >= b.len() {
        Stop(range(s.i, a.len()).fold(s.out, |out: List<Effect>, k: Int| last(out, a.get(k))))
      } else if effect_lt(b.get(s.j), a.get(s.i)) {
        Continue({ ..s, j: s.j + 1, out: last(s.out, b.get(s.j)) })
      } else { Continue({ ..s, i: s.i + 1, out: last(s.out, a.get(s.i)) }) },
  )
}

pub fn effects_difference(a: List<Effect>, b: List<Effect>) -> List<Effect> =
  a.filter(|entry: Effect| !b.contains(entry))

pub fn no_effects() -> Effects = { listed: [], variable: None }
pub fn open_effects(v: Int) -> Effects = { listed: [], variable: Some(v) }
pub fn closed_effects(effects: List<Effect>) -> Effects / {abort.raise} =
  {
    listed: effects.fold([], |acc: List<Effect>, entry: Effect| effects_insert(acc, entry)),
    variable: None,
  }
pub fn single_effect(entry: Effect) -> Effects = { listed: [entry], variable: None }
pub fn is_pure(effects: Effects) -> Bool =
  effects.listed.len() == 0 && (match effects.variable { None -> true, Some(_) -> false })

pub fn without_raises(effects: List<Effect>) -> List<Effect> =
  effects.filter(|entry: Effect| !is_raise(entry.mode))

pub fn diverges_effect() -> Effect =
  { effect: b"diverges", resource: SingletonResource, mode: ReadMode, op: None }

pub fn is_diverges(entry: Effect) -> Bool = entry.effect == b"diverges"

pub fn run_needs(effects: List<Effect>) -> List<Effect> =
  effects.filter(|entry: Effect| !is_raise(entry.mode) && !is_diverges(entry))

pub fn is_pure_but_raise(effects: Effects) -> Bool =
  is_pure({ ..effects, listed: without_raises(effects.listed) })

pub fn combined_effects(a: Effects, b: Effects) -> Effects / {abort.raise} =
  {
    listed: effects_union(a.listed, b.listed),
    variable: match a.variable { Some(_) -> a.variable, None -> b.variable },
  }

pub fn effects_without(effects: Effects, removed: List<Effect>) -> Effects =
  { listed: effects_difference(effects.listed, removed), variable: effects.variable }

pub fn effects_without_covered(effects: Effects, removed: List<Effect>) -> Effects =
  {
    listed: effects.listed.filter(|entry: Effect| !effects_cover(removed, entry)),
    variable: effects.variable,
  }

pub type Field = { name: Bytes, ty: Type }

pub type Type =
  | VariableType(Int)
  | NamedType({ name: Bytes, args: List<Type> })
  | FunctionType(FunctionSignature)
  | RecordType(List<Field>)
  | NominalType({ name: Bytes, args: List<Type>, fields: List<Field> })

pub type FunctionSignature = {
  params: List<Type>,
  kept: List<Int>,
  once: Bool,
  ret: Type,
  effects: Effects,
}

pub type Scheme = {
  type_variables: List<Int>,
  effect_variables: List<Int>,
  keep_variables: List<Int>,
  label_variables: List<Int>,
  ty: Type,
}

derive bin for Effects

derive bin for Field

derive bin for FunctionSignature

derive bin for Type

derive bin for Scheme

pub fn named_type(name: Bytes) -> Type = NamedType({ name: name, args: [] })
pub fn applied_type(name: Bytes, ty: Type) -> Type = NamedType({ name: name, args: [ty] })
pub fn int_type() -> Type = named_type(b"Int")
pub fn bool_type() -> Type = named_type(b"Bool")
pub fn string_type() -> Type = named_type(b"String")
pub fn bytes_type() -> Type = named_type(b"Bytes")
pub fn float_type() -> Type = named_type(b"Float")
pub fn decimal_type() -> Type = named_type(b"Decimal")
pub fn unit_type() -> Type = named_type(b"Unit")
pub fn list_type(ty: Type) -> Type = applied_type(b"List", ty)
pub fn option_type(ty: Type) -> Type = applied_type(b"Option", ty)
pub fn map_type(k: Type, v: Type) -> Type = NamedType({ name: b"Map", args: [k, v] })
pub fn iter_type(s: Type, r: Type) -> Type = NamedType({ name: b"Iter", args: [s, r] })
pub fn secret_type(ty: Type) -> Type = applied_type(b"Secret", ty)
pub fn fn_type(params: List<Type>, ret: Type, effects: Effects) -> Type =
  FunctionType({ params: params, kept: [], once: false, ret: ret, effects: effects })

pub fn owning_fn_type(
  params: List<Type>,
  kept: List<Int>,
  once: Bool,
  ret: Type,
  effects: Effects,
) -> Type = FunctionType({ params: params, kept: kept, once: once, ret: ret, effects: effects })
pub fn monomorphic(ty: Type) -> Scheme =
  { type_variables: [], effect_variables: [], keep_variables: [], label_variables: [], ty: ty }

pub fn fields_sorted(fields: List<Field>) -> List<Field> / {abort.raise} =
  fields.fold([], |acc: List<Field>, field: Field| field_insert(acc, field))

fn field_insert(sorted: List<Field>, field: Field) -> List<Field> / {abort.raise} = {
  let n = sorted.len();
  let i = range(0, n).fold(n, |acc: Int, j: Int|
    if acc < n { acc }
    else if !(compare(sorted.get(j).name, field.name) == Less) { j }
    else { acc });
  if i < n && sorted.get(i).name == field.name { sorted.set(i, field) }
  else { sorted.take(i).push(field).concat(sorted.drop(i)) }
}

pub fn field_get(fields: List<Field>, name: Bytes) -> Option<Type> =
  fields.fold(None, |acc: Option<Type>, field: Field|
    match acc { Some(_) -> acc, None -> if field.name == name { Some(field.ty) } else { None } })

pub fn record_fields(ty: Type) -> Option<List<Field>> =
  match ty { RecordType(fs) -> Some(fs), NominalType(n) -> Some(n.fields), _ -> None }

pub fn tuple_arity(fields: List<Field>) -> Option<Int> = {
  let n = fields.len();
  if n < 2 { None } else {
    let all = range(0, n).fold(true, |acc: Bool, i: Int|
      acc
        && (match field_get(fields, b"_".concat(Bytes::of_string(i.to_string()))) {
          Some(_) -> true,
          None -> false,
        }));
    if all { Some(n) } else { None }
  }
}

pub fn ints_insert(xs: List<Int>, v: Int) -> List<Int> / {abort.raise} = {
  let n = xs.len();
  let i = range(0, n).fold(n, |acc: Int, j: Int|
    if acc < n { acc } else if xs.get(j) >= v { j } else { acc });
  if i < n && xs.get(i) == v { xs } else { xs.take(i).push(v).concat(xs.drop(i)) }
}

pub fn ints_union(a: List<Int>, b: List<Int>) -> List<Int> / {abort.raise} =
  b.fold(a, |acc: List<Int>, v: Int| ints_insert(acc, v))

pub fn ints_difference(a: List<Int>, b: List<Int>) -> List<Int> = a.filter(|v: Int| !b.contains(v))

pub type Fresh = { next_type: Int, next_effect_variable: Int }

pub fn fresh_new() -> Fresh = { next_type: 0, next_effect_variable: 0 }

pub fn fresh_type_var(fresh: Fresh) -> { fresh: Fresh, var: Int } =
  {
    fresh: { next_type: fresh.next_type + 1, next_effect_variable: fresh.next_effect_variable },
    var: fresh.next_type,
  }
pub fn fresh_type(fresh: Fresh) -> { fresh: Fresh, ty: Type } = {
  let o = fresh_type_var(fresh);
  { fresh: o.fresh, ty: VariableType(o.var) }
}
pub fn fresh_effect_variable(fresh: Fresh) -> { fresh: Fresh, var: Int } =
  {
    fresh: { next_type: fresh.next_type, next_effect_variable: fresh.next_effect_variable + 1 },
    var: fresh.next_effect_variable,
  }
pub fn fresh_effects(fresh: Fresh) -> { fresh: Fresh, effects: Effects } = {
  let o = fresh_effect_variable(fresh);
  { fresh: o.fresh, effects: open_effects(o.var) }
}

pub type Substitution = {
  ty: Map<Int, Type>,
  effects: Map<Int, Effects>,
  rigid_type: Map<Int, Bool>,
  rigid_effects: Map<Int, Bool>,
}

pub fn substitution_new() -> Substitution =
  { ty: Map::new(), effects: Map::new(), rigid_type: Map::new(), rigid_effects: Map::new() }

pub fn mark_rigid_type(substitution: Substitution, v: Int) -> Substitution =
  {
    ty: substitution.ty,
    effects: substitution.effects,
    rigid_type: substitution.rigid_type.insert(v, true),
    rigid_effects: substitution.rigid_effects,
  }
pub fn mark_rigid_effects(substitution: Substitution, v: Int) -> Substitution =
  {
    ty: substitution.ty,
    effects: substitution.effects,
    rigid_type: substitution.rigid_type,
    rigid_effects: substitution.rigid_effects.insert(v, true),
  }
pub fn is_rigid_type(substitution: Substitution, v: Int) -> Bool =
  substitution.rigid_type.contains(v)
pub fn is_rigid_effects(substitution: Substitution, v: Int) -> Bool =
  substitution.rigid_effects.contains(v)

pub fn shallow_resolve(substitution: Substitution, ty: Type) -> Type / {abort.raise} =
  iterate(ty, substitution.ty.len() + 2, |cur: Type|
    match cur {
      VariableType(v) -> match substitution.ty.get(v) {
        Some(next) -> Continue(next),
        None -> Stop(cur),
      },
      _ -> Stop(cur),
    })

pub fn resolve_type(substitution: Substitution, t: Type) -> Type / {abort.raise} =
  if has_bound_variable(substitution, t) {
    rebuild_resolved(substitution, t, substitution.ty.len())
  } else { t }

fn has_bound_variable(substitution: Substitution, t: Type) -> Bool =
  match t {
    VariableType(v) -> substitution.ty.contains(v),
    NamedType(c) ->
      c.args.fold(false, |found: Bool, a: Type| found || has_bound_variable(substitution, a)),
    FunctionType(f) ->
      f.params.fold(false, |found: Bool, p: Type| found || has_bound_variable(substitution, p))
        || has_bound_variable(substitution, f.ret)
        || effects_may_change(substitution, f.effects),
    RecordType(fs) ->
      fs.fold(false, |found: Bool, f: Field| found || has_bound_variable(substitution, f.ty)),
    NominalType(n) ->
      n.args.fold(false, |found: Bool, a: Type| found || has_bound_variable(substitution, a)),
  }

fn rebuild_resolved(substitution: Substitution, t: Type, budget: Int) -> Type / {abort.raise} =
  match t {
    VariableType(v) -> match substitution.ty.get(v) {
      None -> t,
      Some(bound) -> if budget <= 0 { panic("a type bound to itself") }
      else if has_bound_variable(substitution, bound) {
        rebuild_resolved(substitution, bound, budget - 1)
      } else { bound },
    },
    NamedType(c) ->
      NamedType({
        name: c.name,
        args: c.args.map(|a: Type|
          if has_bound_variable(substitution, a) { rebuild_resolved(substitution, a, budget) }
          else { a }),
      }),
    FunctionType(f) ->
      FunctionType({
        ..f,
        params: f.params.map(|p: Type|
          if has_bound_variable(substitution, p) { rebuild_resolved(substitution, p, budget) }
          else { p }),
        ret: if has_bound_variable(substitution, f.ret) {
          rebuild_resolved(substitution, f.ret, budget)
        } else { f.ret },
        effects: if effects_may_change(substitution, f.effects) {
          resolve_effects(substitution, f.effects)
        } else { f.effects },
      }),
    RecordType(fs) ->
      RecordType(
        fs.map(|f: Field|
          if has_bound_variable(substitution, f.ty) {
            { name: f.name, ty: rebuild_resolved(substitution, f.ty, budget) }
          } else { f }),
      ),
    NominalType(n) ->
      NominalType({
        name: n.name,
        args: n.args.map(|a: Type|
          if has_bound_variable(substitution, a) { rebuild_resolved(substitution, a, budget) }
          else { a }),
        fields: n.fields.map(|f: Field|
          if has_bound_variable(substitution, f.ty) {
            { name: f.name, ty: rebuild_resolved(substitution, f.ty, budget) }
          } else { f }),
      }),
  }

fn effects_may_change(substitution: Substitution, effects: Effects) -> Bool =
  (match effects.variable { Some(v) -> substitution.effects.contains(v), None -> false })
    || effects.listed.fold(false, |found: Bool, entry: Effect|
      found || (match entry.resource { ResourceVariable(_) -> true, _ -> false }))

pub fn resolved_variable(
  substitution: Substitution,
  effects: Effects,
) -> Option<Int> / {abort.raise} = {
  let bound = substitution.effects.len();
  iterate({ tail: effects.variable, hops: 0 }, bound + 2, |st: { tail: Option<Int>, hops: Int }|
    match st.tail {
      None -> Stop(None),
      Some(v) -> match substitution.effects.get(v) {
        Some(next) -> if next.variable == Some(v) { Stop(Some(v)) }
        else if st.hops + 1 > bound { Stop(next.variable) }
        else { Continue({ tail: next.variable, hops: st.hops + 1 }) },
        None -> Stop(Some(v)),
      },
    })
}

pub fn resolve_effects(substitution: Substitution, effects: Effects) -> Effects / {abort.raise} = {
  let bound = substitution.effects.len();
  let walked = iterate(
    { listed: effects.listed, variable: effects.variable, seen: [] },
    bound + 2,
    |st: { listed: List<Effect>, variable: Option<Int>, seen: List<Int> }|
      match st.variable {
        None -> Stop({ listed: st.listed, variable: None }),
        Some(v) -> if st.seen.contains(v) { Stop({ listed: st.listed, variable: st.variable }) }
        else {
          match substitution.effects.get(v) {
            Some(next) ->
              Continue({
                listed: effects_union(st.listed, next.listed),
                variable: next.variable,
                seen: st.seen.push(v),
              }),
            None -> Stop({ listed: st.listed, variable: st.variable }),
          }
        },
      },
  );
  if !walked.listed.fold(false, |acc: Bool, entry: Effect|
      acc || (match entry.resource { ResourceVariable(_) -> true, _ -> false })) { walked } else {
    {
      listed: walked.listed.fold([], |acc: List<Effect>, entry: Effect|
        effects_insert(acc, resolve_effect(substitution, entry))),
      variable: walked.variable,
    }
  }
}

pub fn label_prefix() -> Bytes = b"#label:"

pub fn label_type(name: Bytes) -> Type = named_type(label_prefix().concat(name))

pub fn label_of(ty: Type) -> Option<Bytes> / {abort.raise} =
  match ty {
    NamedType(c) -> if c.args.len() == 0 && c.name.starts_with(label_prefix()) {
      Some(c.name.slice(label_prefix().len(), c.name.len()))
    } else { None },
    _ -> None,
  }

fn label_arg(label: Type) -> Type = applied_type(b"#label", label)

fn effects_arg(effects: Effects) -> Type = fn_type([], named_type(b"#effects"), effects)

pub fn arg_label(ty: Type) -> Option<Type> =
  match ty { NamedType(c) -> if c.name == b"#label" { c.args.at(0) } else { None }, _ -> None }

pub fn arg_effects(ty: Type) -> Option<Effects> =
  match ty {
    FunctionType(f) -> match f.ret {
      NamedType(c) -> if c.name == b"#effects" { Some(f.effects) } else { None },
      _ -> None,
    },
    _ -> None,
  }

pub fn applied_args(
  types: List<Type>,
  labels: List<Type>,
  effect_arguments: List<Effects>,
) -> List<Type> =
  if labels.len() == 0 && effect_arguments.len() == 0 { types }
  else { types.concat(labels.map(label_arg)).concat(effect_arguments.map(effects_arg)) }

pub fn is_label_or_effects(ty: Type) -> Bool =
  match ty {
    NamedType(c) -> c.name == b"#label",
    FunctionType(f) -> match f.ret { NamedType(c) -> c.name == b"#effects", _ -> false },
    _ -> false,
  }

pub fn type_args(args: List<Type>) -> List<Type> = args.filter(|a: Type| !is_label_or_effects(a))

pub fn resolve_effect(substitution: Substitution, entry: Effect) -> Effect / {abort.raise} =
  match entry.resource {
    ResourceVariable(v) ->
      {
        effect: entry.effect,
        resource: resource_of(shallow_resolve(substitution, VariableType(v)), v),
        mode: entry.mode,
        op: entry.op,
      },
    _ -> entry,
  }

fn resource_of(ty: Type, v: Int) -> Resource / {abort.raise} =
  match label_of(ty) {
    Some(n) -> NamedResource(n),
    None -> match ty { VariableType(w) -> ResourceVariable(w), _ -> ResourceVariable(v) },
  }

pub fn occurs_type(v: Int, t: Type) -> Bool =
  match t {
    VariableType(w) -> w == v,
    NamedType(c) -> c.args.fold(false, |acc: Bool, a: Type| acc || occurs_type(v, a)),
    FunctionType(f) ->
      f.params.fold(false, |acc: Bool, p: Type| acc || occurs_type(v, p)) || occurs_type(v, f.ret),
    RecordType(fs) -> fs.fold(false, |acc: Bool, f: Field| acc || occurs_type(v, f.ty)),
    NominalType(n) -> n.args.fold(false, |acc: Bool, a: Type| acc || occurs_type(v, a)),
  }

pub type UnifyError =
  | Mismatch({ expected: Type, found: Type })
  | Arity({ expected: Int, found: Int })
  | OccursType({ v: Int, ty: Type })
  | OccursInEffects({ v: Int, effects: Effects })
  | EffectsMismatch({ expected: Effects, found: Effects })

pub type UnifyResult = { substitution: Substitution, fresh: Fresh, error: Option<UnifyError> }

fn unify_succeeded(substitution: Substitution, fresh: Fresh) -> UnifyResult =
  { substitution: substitution, fresh: fresh, error: None }
fn unify_failed(substitution: Substitution, fresh: Fresh, error: UnifyError) -> UnifyResult =
  { substitution: substitution, fresh: fresh, error: Some(error) }

fn bind_type(
  substitution: Substitution,
  fresh: Fresh,
  v: Int,
  ty: Type,
) -> UnifyResult / {abort.raise} = {
  let r = resolve_type(substitution, ty);
  if r == VariableType(v) { unify_succeeded(substitution, fresh) }
  else if occurs_type(v, r) { unify_failed(substitution, fresh, OccursType({ v: v, ty: r })) }
  else {
    unify_succeeded(
      {
        ty: substitution.ty.insert(v, r),
        effects: substitution.effects,
        rigid_type: substitution.rigid_type,
        rigid_effects: substitution.rigid_effects,
      },
      fresh,
    )
  }
}

fn bind_effects(substitution: Substitution, fresh: Fresh, v: Int, effects: Effects) -> UnifyResult =
  if effects.listed.len() == 0 && effects.variable == Some(v) {
    unify_succeeded(substitution, fresh)
  } else if effects.variable == Some(v) {
    unify_failed(substitution, fresh, OccursInEffects({ v: v, effects: effects }))
  } else {
    unify_succeeded(
      {
        ty: substitution.ty,
        effects: substitution.effects.insert(v, effects),
        rigid_type: substitution.rigid_type,
        rigid_effects: substitution.rigid_effects,
      },
      fresh,
    )
  }

pub fn solve_continuation_effects(
  substitution: Substitution,
  v: Int,
  effects: Effects,
) -> Substitution / {abort.raise} =
  if substitution.effects.contains(v) { substitution } else {
    let solved = resolve_effects(substitution, effects);
    let closed = if solved.variable == Some(v) { { listed: solved.listed, variable: None } }
    else { solved };
    {
      ty: substitution.ty,
      effects: substitution.effects.insert(v, closed),
      rigid_type: substitution.rigid_type,
      rigid_effects: substitution.rigid_effects,
    }
  }

pub fn variables_in(types: List<Type>) -> List<Int> = types.fold([], variables_of)

fn variables_of(seen: List<Int>, ty: Type) -> List<Int> =
  match ty {
    VariableType(v) -> if seen.contains(v) { seen } else { seen.push(v) },
    NamedType(c) -> c.args.fold(seen, variables_of),
    FunctionType(f) -> variables_of(f.params.fold(seen, variables_of), f.ret),
    RecordType(fs) -> fs.fold(seen, |acc: List<Int>, f: Field| variables_of(acc, f.ty)),
    NominalType(n) -> n.args.fold(seen, variables_of),
  }

pub type FreeVariables = { types: List<Int>, effect_variables: List<Int> }

pub fn free_variables(
  substitution: Substitution,
  ty: Type,
  acc: FreeVariables,
) -> FreeVariables / {abort.raise} =
  free_variables_within(substitution, ty, acc, substitution.ty.len())

fn free_variables_within(
  substitution: Substitution,
  ty: Type,
  acc: FreeVariables,
  budget: Int,
) -> FreeVariables / {abort.raise} =
  match ty {
    VariableType(v) -> match substitution.ty.get(v) {
      None -> { types: ints_insert(acc.types, v), effect_variables: acc.effect_variables },
      Some(bound) -> if budget <= 0 { panic("a type bound to itself") }
      else { free_variables_within(substitution, bound, acc, budget - 1) },
    },
    NamedType(c) ->
      c.args.fold(acc, |a: FreeVariables, x: Type|
        free_variables_within(substitution, x, a, budget)),
    FunctionType(fn_) -> {
      let ps = fn_.params.fold(acc, |a: FreeVariables, x: Type|
        free_variables_within(substitution, x, a, budget));
      let r = free_variables_within(substitution, fn_.ret, ps, budget);
      let effects = resolve_effects(substitution, fn_.effects);
      let ls = effects.listed.fold(r, |a: FreeVariables, x: Effect|
        match x.resource {
          ResourceVariable(v) ->
            { types: ints_insert(a.types, v), effect_variables: a.effect_variables },
          _ -> a,
        });
      match effects.variable {
        Some(v) -> { types: ls.types, effect_variables: ints_insert(ls.effect_variables, v) },
        None -> ls,
      }
    },
    RecordType(fs) ->
      fs.fold(acc, |a: FreeVariables, field: Field|
        free_variables_within(substitution, field.ty, a, budget)),
    NominalType(n) ->
      n.args.fold(acc, |a: FreeVariables, x: Type|
        free_variables_within(substitution, x, a, budget)),
  }

pub fn is_covariant_container(name: Bytes) -> Bool =
  name == b"List" || name == b"Array" || name == b"Columns" || name == b"Option"
    || name == b"Result"
    || name == b"Map"
    || name == b"Iter"
    || name == b"Scoped"

pub fn unify(
  substitution: Substitution,
  fresh: Fresh,
  expected: Type,
  found: Type,
) -> UnifyResult / {abort.raise} =
  unify_at(substitution, fresh, expected, found, false, unify_budget(), 1)

fn unify_at(
  substitution: Substitution,
  fresh: Fresh,
  expected: Type,
  found: Type,
  exact: Bool,
  budget: Int,
  tries: Int,
) -> UnifyResult / {abort.raise} = {
  let a = shallow_resolve(substitution, expected);
  let b = shallow_resolve(substitution, found);
  match a {
    VariableType(x) -> match b {
      VariableType(y) -> if x == y { unify_succeeded(substitution, fresh) }
      else if !is_rigid_type(substitution, x) { bind_type(substitution, fresh, x, b) }
      else if !is_rigid_type(substitution, y) { bind_type(substitution, fresh, y, a) }
      else { unify_failed(substitution, fresh, Mismatch({ expected: a, found: b })) },
      _ -> if !is_rigid_type(substitution, x) { bind_type(substitution, fresh, x, b) }
      else { unify_failed(substitution, fresh, Mismatch({ expected: a, found: b })) },
    },
    _ -> match b {
      VariableType(y) -> if !is_rigid_type(substitution, y) { bind_type(substitution, fresh, y, a) }
      else { unify_failed(substitution, fresh, Mismatch({ expected: a, found: b })) },
      _ -> if budget > 0 { unify_structural(substitution, fresh, a, b, exact, budget - 1, tries) }
      else if tries > 0 {
        let parts = type_size(resolve_type(substitution, a))
          + type_size(resolve_type(substitution, b));
        unify_at(substitution, fresh, a, b, exact, parts, tries - 1)
      } else { panic("a unification deeper than the types it unifies") },
    },
  }
}

fn unify_budget() -> Int = 64

fn type_size(t: Type) -> Int =
  match t {
    VariableType(_) -> 1,
    NamedType(c) -> c.args.fold(1, |n: Int, a: Type| n + type_size(a)),
    FunctionType(f) -> f.params.fold(1 + type_size(f.ret), |n: Int, p: Type| n + type_size(p)),
    RecordType(fs) -> fs.fold(1, |n: Int, f: Field| n + type_size(f.ty)),
    NominalType(x) -> x.args.fold(1, |n: Int, a: Type| n + type_size(a)),
  }

fn unify_structural(
  substitution: Substitution,
  fresh: Fresh,
  a: Type,
  b: Type,
  exact: Bool,
  budget: Int,
  tries: Int,
) -> UnifyResult / {abort.raise} =
  match a {
    NamedType(c1) -> match b {
      NamedType(c2) -> if c1.name != c2.name || c1.args.len() != c2.args.len() {
        unify_failed(substitution, fresh, Mismatch({ expected: a, found: b }))
      } else if c1.args.len() == 0 { unify_succeeded(substitution, fresh) } else {
        let u = unify_all(
          substitution,
          fresh,
          c1.args,
          c2.args,
          exact || !is_covariant_container(c1.name),
          budget,
          tries,
        );
        match u.error {
          None -> u,
          Some(_) -> if !is_label_or_effects(a) { u }
          else { unify_failed(u.substitution, u.fresh, Mismatch({ expected: a, found: b })) },
        }
      },
      _ -> unify_failed(substitution, fresh, Mismatch({ expected: a, found: b })),
    },
    FunctionType(f1) -> match b {
      FunctionType(f2) -> if f1.params.len() != f2.params.len() {
        unify_failed(
          substitution,
          fresh,
          Arity({ expected: f1.params.len(), found: f2.params.len() }),
        )
      } else if (f2.once && !f1.once) || (exact && f1.once != f2.once) {
        unify_failed(substitution, fresh, Mismatch({ expected: a, found: b }))
      } else {
        let ps = unify_all(substitution, fresh, f1.params, f2.params, true, budget, tries);
        match ps.error {
          Some(_) -> ps,
          None -> {
            let r = unify_at(ps.substitution, ps.fresh, f1.ret, f2.ret, exact, budget, tries);
            match r.error {
              Some(_) -> r,
              None -> unify_effects_at(r.substitution, r.fresh, f1.effects, f2.effects, exact),
            }
          },
        }
      },
      _ -> unify_failed(substitution, fresh, Mismatch({ expected: a, found: b })),
    },
    RecordType(fs1) -> match b {
      RecordType(fs2) -> if fs1.len() != fs2.len()
          || fs1.map(|field: Field| field.name) != fs2.map(|field: Field| field.name) {
        unify_failed(substitution, fresh, Mismatch({ expected: a, found: b }))
      } else {
        unify_all(
          substitution,
          fresh,
          fs1.map(|field: Field| field.ty),
          fs2.map(|field: Field| field.ty),
          exact,
          budget,
          tries,
        )
      },
      _ -> unify_failed(substitution, fresh, Mismatch({ expected: a, found: b })),
    },
    NominalType(n1) -> match b {
      NominalType(n2) -> if n1.name != n2.name || n1.args.len() != n2.args.len() {
        unify_failed(substitution, fresh, Mismatch({ expected: a, found: b }))
      } else if n1.args.len() == 0 { unify_succeeded(substitution, fresh) }
      else { unify_all(substitution, fresh, n1.args, n2.args, true, budget, tries) },
      _ -> unify_failed(substitution, fresh, Mismatch({ expected: a, found: b })),
    },
    VariableType(_) -> unify_failed(substitution, fresh, Mismatch({ expected: a, found: b })),
  }

fn unify_all(
  substitution: Substitution,
  fresh: Fresh,
  xs: List<Type>,
  ys: List<Type>,
  exact: Bool,
  budget: Int,
  tries: Int,
) -> UnifyResult / {abort.raise} =
  range(0, xs.len()).fold(unify_succeeded(substitution, fresh), |acc: UnifyResult, i: Int|
    match acc.error {
      Some(_) -> acc,
      None -> unify_at(acc.substitution, acc.fresh, xs.get(i), ys.get(i), exact, budget, tries),
    })

fn bind_labels(
  substitution: Substitution,
  xs: List<Effect>,
  ys: List<Effect>,
) -> Substitution / {abort.raise} =
  xs.fold(substitution, |acc: Substitution, entry: Effect| {
    let a = resolve_effect(acc, entry);
    match a.resource {
      ResourceVariable(v) -> if is_rigid_type(acc, v) { acc } else {
        match matching_label(acc, ys, a, v) {
          None -> acc,
          Some(t) ->
            {
              ty: acc.ty.insert(v, t),
              effects: acc.effects,
              rigid_type: acc.rigid_type,
              rigid_effects: acc.rigid_effects,
            },
        }
      },
      _ -> acc,
    }
  })

fn matching_label(
  substitution: Substitution,
  effects: List<Effect>,
  x: Effect,
  v: Int,
) -> Option<Type> / {abort.raise} =
  effects.fold(None, |acc: Option<Type>, y: Effect|
    match acc {
      Some(_) -> acc,
      None -> {
        let b = resolve_effect(substitution, y);
        if b.effect == x.effect && mode_rank(b.mode) == mode_rank(x.mode) && b.op == x.op {
          match b.resource {
            NamedResource(n) -> Some(label_type(n)),
            ResourceVariable(w) -> if w == v { None } else { Some(VariableType(w)) },
            SingletonResource -> None,
            AnyResource -> None,
          }
        } else { None }
      },
    })

pub fn unify_effects(
  substitution: Substitution,
  fresh: Fresh,
  expected: Effects,
  found: Effects,
) -> UnifyResult / {abort.raise} = unify_effects_at(substitution, fresh, expected, found, false)

fn unify_effects_at(
  substitution: Substitution,
  fresh: Fresh,
  expected: Effects,
  found: Effects,
  exact: Bool,
) -> UnifyResult / {abort.raise} = {
  let x = resolve_effects(substitution, expected);
  let y = resolve_effects(substitution, found);
  let s = bind_labels(bind_labels(substitution, x.listed, y.listed), y.listed, x.listed);
  let moved = s.ty.len() != substitution.ty.len();
  let a = if moved { resolve_effects(s, x) } else { x };
  let b = if moved { resolve_effects(s, y) } else { y };
  let only_a = a.listed.filter(|x: Effect|
    !(if exact { effects_cover(b.listed, x) } else { effect_allowed(b.listed, x) }));
  let only_b = b.listed.filter(|x: Effect| !effects_cover(a.listed, x));
  let bad = EffectsMismatch({ expected: a, found: b });
  match a.variable {
    None -> match b.variable {
      None -> if only_a.len() == 0 && only_b.len() == 0 { unify_succeeded(s, fresh) }
      else { unify_failed(s, fresh, bad) },
      Some(v) -> if only_b.len() > 0 || is_rigid_effects(s, v) { unify_failed(s, fresh, bad) }
      else { bind_effects(s, fresh, v, closed_effects(only_a)) },
    },
    Some(v1) -> match b.variable {
      None -> if only_a.len() > 0 || is_rigid_effects(s, v1) { unify_failed(s, fresh, bad) }
      else { bind_effects(s, fresh, v1, closed_effects(only_b)) },
      Some(v2) -> if v1 == v2 {
        if only_a.len() == 0 && only_b.len() == 0 { unify_succeeded(s, fresh) }
        else if is_rigid_effects(s, v1) { unify_failed(s, fresh, bad) } else {
          let nv = fresh_effect_variable(fresh);
          bind_effects(s, nv.fresh, v1, {
            listed: effects_union(only_a, only_b),
            variable: Some(nv.var),
          })
        }
      } else {
        let r1 = is_rigid_effects(s, v1);
        let r2 = is_rigid_effects(s, v2);
        if r1 && r2 { unify_failed(s, fresh, bad) } else if r1 {
          if only_b.len() > 0 { unify_failed(s, fresh, bad) }
          else { bind_effects(s, fresh, v2, { listed: only_a, variable: Some(v1) }) }
        } else if r2 {
          if only_a.len() > 0 { unify_failed(s, fresh, bad) }
          else { bind_effects(s, fresh, v1, { listed: only_b, variable: Some(v2) }) }
        } else {
          let nv = fresh_effect_variable(fresh);
          let first = bind_effects(s, nv.fresh, v1, { listed: only_b, variable: Some(nv.var) });
          match first.error {
            Some(_) -> first,
            None ->
              bind_effects(first.substitution, first.fresh, v2, {
                listed: only_a,
                variable: Some(nv.var),
              }),
          }
        }
      },
    },
  }
}

pub type Scope = { locals: Map<Int, Scheme>, names: Map<Bytes, Int>, ungeneralized: List<Int> }

pub type TypeEnv = { globals: Map<Bytes, Scheme>, open: List<Bytes>, scopes: List<Scope> }

pub type InScope = { binder: Int, name: Bytes, sc: Scheme }

fn scope_new() -> Scope = { locals: Map::new(), names: Map::new(), ungeneralized: [] }

pub fn env_new() -> TypeEnv = { globals: Map::new(), open: [], scopes: [] }
pub fn env_push(env: TypeEnv) -> TypeEnv = { ..env, scopes: env.scopes.push(scope_new()) }
pub fn env_pop(env: TypeEnv) -> TypeEnv =
  if env.scopes.len() > 0 { { ..env, scopes: env.scopes.take(env.scopes.len() - 1) } } else { env }

pub fn env_depth(env: TypeEnv) -> Int = env.scopes.len() + 1

pub fn env_bind(env: TypeEnv, name: Identifier, scheme: Scheme) -> TypeEnv / {abort.raise} = {
  let binder = name.span.site;
  let last = env.scopes.len() - 1;
  let s = env.scopes.get(last);
  {
    ..env,
    scopes: env.scopes.set(last, {
      locals: s.locals.insert(binder, scheme),
      names: s.names.insert(name.name, binder),
      ungeneralized: s.ungeneralized.push(binder),
    }),
  }
}

pub fn env_bind_global(env: TypeEnv, name: Bytes, scheme: Scheme) -> TypeEnv =
  { ..env, globals: env.globals.insert(name, scheme), open: env.open.push(name) }

pub fn env_remove_global(env: TypeEnv, name: Bytes) -> TypeEnv =
  { ..env, globals: env.globals.remove(name), open: env.open.filter(|n: Bytes| n != name) }

pub fn env_lookup(env: TypeEnv, name: Bytes) -> Option<Scheme> = env.globals.get(name)

pub fn env_local(
  env: TypeEnv,
  binder: Int,
) -> Option<{ scheme: Scheme, depth: Int }> / {abort.raise} =
  range(0, env.scopes.len()).fold(None, |acc: Option<{ scheme: Scheme, depth: Int }>, i: Int|
    match env.scopes.get(i).locals.get(binder) {
      Some(scheme) -> Some({ scheme: scheme, depth: i + 1 }),
      None -> acc,
    })

pub fn env_locals(env: TypeEnv) -> List<InScope> / {abort.raise} = {
  let n = env.scopes.len();
  range(0, n).fold([], |acc: List<InScope>, i: Int| {
    let scope = env.scopes.get(i);
    scope.names.fold(acc, |found: List<InScope>, name: Bytes, binder: Int|
      if range(i + 1, n).any(|j: Int| env.scopes.get(j).names.contains(name)) { found } else {
        match scope.locals.get(binder) {
          Some(sc) -> found.push({ binder: binder, name: name, sc: sc }),
          None -> found,
        }
      })
  })
}

fn scheme_free(substitution: Substitution, scheme: Scheme) -> FreeVariables / {abort.raise} = {
  let fv = free_variables(substitution, scheme.ty, { types: [], effect_variables: [] });
  {
    types: ints_difference(
      ints_difference(fv.types, scheme.type_variables),
      scheme.label_variables,
    ),
    effect_variables: ints_difference(fv.effect_variables, scheme.effect_variables),
  }
}

pub fn env_free_variables(
  substitution: Substitution,
  env: TypeEnv,
) -> { e: TypeEnv, free: FreeVariables } / {abort.raise} = {
  let globals = still_open(substitution, env.open, |name: Bytes| env.globals.get(name), {
    types: [],
    effect_variables: [],
  });
  let walked = env.scopes.fold(
    { scopes: [], free: globals.free },
    |acc: { scopes: List<Scope>, free: FreeVariables }, scope: Scope| {
      let kept = still_open(
        substitution,
        scope.ungeneralized,
        |binder: Int| scope.locals.get(binder),
        acc.free,
      );
      { scopes: acc.scopes.push({ ..scope, ungeneralized: kept.open }), free: kept.free }
    },
  );
  { e: { ..env, open: globals.open, scopes: walked.scopes }, free: walked.free }
}

fn still_open<k>(
  substitution: Substitution,
  open: List<k>,
  scheme_of: (k) -> Option<Scheme>,
  free: FreeVariables,
) -> { open: List<k>, free: FreeVariables } / {abort.raise} =
  open.fold({ open: [], free: free }, |a: { open: List<k>, free: FreeVariables }, key: k|
    match scheme_of(key) {
      None -> a,
      Some(scheme) -> {
        let fv = scheme_free(substitution, scheme);
        if fv.types.len() == 0 && fv.effect_variables.len() == 0 { a } else {
          {
            open: a.open.push(key),
            free: {
              types: ints_union(a.free.types, fv.types),
              effect_variables: ints_union(a.free.effect_variables, fv.effect_variables),
            },
          }
        }
      },
    })

fn rename(t: Type, types: Map<Int, Type>, effect_variables: Map<Int, Int>) -> Type / {abort.raise} =
  match t {
    VariableType(v) -> match types.get(v) { Some(x) -> x, None -> t },
    NamedType(c) ->
      NamedType({ name: c.name, args: c.args.map(|a: Type| rename(a, types, effect_variables)) }),
    FunctionType(f) ->
      FunctionType({
        ..f,
        params: f.params.map(|p: Type| rename(p, types, effect_variables)),
        ret: rename(f.ret, types, effect_variables),
        effects: {
          listed: f.effects.listed.fold([], |acc: List<Effect>, a: Effect|
            effects_insert(acc, rename_effect(a, types))),
          variable: match f.effects.variable {
            None -> None,
            Some(v) -> Some(match effect_variables.get(v) { Some(w) -> w, None -> v }),
          },
        },
      }),
    RecordType(fs) ->
      RecordType(fs.map(|x: Field| { name: x.name, ty: rename(x.ty, types, effect_variables) })),
    NominalType(n) -> if n.args.len() == 0 { t } else {
      NominalType({
        name: n.name,
        args: n.args.map(|a: Type| rename(a, types, effect_variables)),
        fields: n.fields.map(|x: Field|
          { name: x.name, ty: rename(x.ty, types, effect_variables) }),
      })
    },
  }

fn rename_effect(entry: Effect, types: Map<Int, Type>) -> Effect / {abort.raise} =
  match entry.resource {
    ResourceVariable(v) -> match types.get(v) {
      Some(t) ->
        { effect: entry.effect, resource: resource_of(t, v), mode: entry.mode, op: entry.op },
      None -> entry,
    },
    _ -> entry,
  }

fn substituted(
  t: Type,
  types: Map<Int, Type>,
  effect_substitution: Map<Int, Effects>,
) -> Type / {abort.raise} =
  match t {
    VariableType(v) -> match types.get(v) { Some(x) -> x, None -> t },
    NamedType(c) ->
      NamedType({
        name: c.name,
        args: c.args.map(|a: Type| substituted(a, types, effect_substitution)),
      }),
    FunctionType(f) -> {
      let effects = f.effects.listed.fold([], |acc: List<Effect>, a: Effect|
        effects_insert(acc, rename_effect(a, types)));
      let filled = match f.effects.variable { None -> None, Some(v) -> effect_substitution.get(v) };
      FunctionType({
        ..f,
        params: f.params.map(|p: Type| substituted(p, types, effect_substitution)),
        ret: substituted(f.ret, types, effect_substitution),
        effects: match filled {
          Some(found) -> { listed: effects_union(effects, found.listed), variable: found.variable },
          None -> { listed: effects, variable: f.effects.variable },
        },
      })
    },
    RecordType(fs) ->
      RecordType(
        fs.map(|x: Field| { name: x.name, ty: substituted(x.ty, types, effect_substitution) }),
      ),
    NominalType(n) -> if n.args.len() == 0 { t } else {
      NominalType({
        name: n.name,
        args: n.args.map(|a: Type| substituted(a, types, effect_substitution)),
        fields: n.fields.map(|x: Field|
          { name: x.name, ty: substituted(x.ty, types, effect_substitution) }),
      })
    },
  }

pub fn apply_arguments(
  ty: Type,
  type_variables: List<Int>,
  effect_variables: List<Int>,
  args: List<Type>,
) -> Type / {abort.raise} = {
  let types = range(0, type_variables.len()).fold(Map::new(), |m: Map<Int, Type>, i: Int|
    match args.at(i) {
      Some(a) -> m.insert(type_variables.get(i), match arg_label(a) { Some(l) -> l, None -> a }),
      None -> m,
    });
  let effect_substitution = range(0, effect_variables.len()).fold(
    Map::new(),
    |m: Map<Int, Effects>, i: Int|
      match args.at(type_variables.len() + i) {
        Some(a) -> match arg_effects(a) {
          Some(r) -> m.insert(effect_variables.get(i), r),
          None -> m,
        },
        None -> m,
      },
  );
  substituted(ty, types, effect_substitution)
}

pub type SchemeInstance = {
  fresh: Fresh,
  ty: Type,
  args: List<Type>,
  labels: List<Type>,
  effect_variables: List<Int>,
}

pub fn instantiate_with(scheme: Scheme, fresh: Fresh) -> SchemeInstance / {abort.raise} =
  if scheme.type_variables.len() == 0 && scheme.effect_variables.len() == 0
      && scheme.label_variables.len() == 0 {
    { fresh: fresh, ty: scheme.ty, args: [], labels: [], effect_variables: [] }
  } else {
    let types = scheme.type_variables.fold(
      { f: fresh, m: Map::new(), args: [] },
      |acc: { f: Fresh, m: Map<Int, Type>, args: List<Type> }, v: Int| {
        let o = fresh_type(acc.f);
        { f: o.fresh, m: acc.m.insert(v, o.ty), args: acc.args.push(o.ty) }
      },
    );
    let labels = scheme.label_variables.fold(
      { f: types.f, m: types.m, args: [] },
      |acc: { f: Fresh, m: Map<Int, Type>, args: List<Type> }, v: Int| {
        let o = fresh_type(acc.f);
        { f: o.fresh, m: acc.m.insert(v, o.ty), args: acc.args.push(o.ty) }
      },
    );
    let effects = scheme.effect_variables.fold(
      { f: labels.f, m: Map::new(), vars: [] },
      |acc: { f: Fresh, m: Map<Int, Int>, vars: List<Int> }, v: Int| {
        let o = fresh_effect_variable(acc.f);
        { f: o.fresh, m: acc.m.insert(v, o.var), vars: acc.vars.push(o.var) }
      },
    );
    {
      fresh: effects.f,
      ty: rename(scheme.ty, labels.m, effects.m),
      args: types.args,
      labels: labels.args,
      effect_variables: effects.vars,
    }
  }

pub fn instantiate(scheme: Scheme, fresh: Fresh) -> { fresh: Fresh, ty: Type } / {abort.raise} = {
  let o = instantiate_with(scheme, fresh);
  { fresh: o.fresh, ty: o.ty }
}

pub fn rename_scheme(
  scheme: Scheme,
  type_variables: List<Int>,
  effect_variables: List<Int>,
  label_variables: List<Int>,
) -> Type / {abort.raise} = {
  let types = range(0, scheme.type_variables.len()).fold(Map::new(), |m: Map<Int, Type>, i: Int|
    m.insert(scheme.type_variables.get(i), VariableType(type_variables.get(i))));
  let both = range(0, scheme.label_variables.len()).fold(types, |m: Map<Int, Type>, i: Int|
    m.insert(scheme.label_variables.get(i), VariableType(label_variables.get(i))));
  let effect_renaming = range(0, scheme.effect_variables.len()).fold(
    Map::new(),
    |m: Map<Int, Int>, i: Int| m.insert(scheme.effect_variables.get(i), effect_variables.get(i)),
  );
  rename(scheme.ty, both, effect_renaming)
}

pub fn generalize(
  substitution: Substitution,
  e: TypeEnv,
  t: Type,
) -> { env: TypeEnv, scheme: Scheme } / {abort.raise} = {
  let ty = resolve_type(substitution, t);
  let env = env_free_variables(substitution, e);
  let fv = free_variables(substitution, ty, { types: [], effect_variables: [] });
  {
    env: env.e,
    scheme: {
      type_variables: ints_difference(fv.types, env.free.types),
      effect_variables: ints_difference(fv.effect_variables, env.free.effect_variables),
      keep_variables: [],
      label_variables: [],
      ty: ty,
    },
  }
}

pub type TypeNode =
  | NodeVariable(Int)
  | NodeNamed({ name: Bytes, args: List<Bytes> })
  | NodeFunction({ params: List<Bytes>, kept: List<Int>, once: Bool, ret: Bytes })
  | NodeRecord(List<NodeField>)
  | NodeNominal({ name: Bytes, args: List<Bytes>, fields: List<NodeField> })

pub type NodeField = { name: Bytes, ty: Bytes }

derive bin for NodeField

derive bin for TypeNode

pub type TypeTable = Map<Bytes, TypeNode>

derive bin for TypeTable

fn node_key(node: TypeNode) -> Bytes / {abort.raise} =
  bin::encode(node, type_node_bin()).blake3().slice(0, 16)

type InsertedParts = { table: TypeTable, keys: List<Bytes> }
type InsertedFields = { table: TypeTable, fields: List<NodeField> }

fn insert_parts(table: TypeTable, types: List<Type>) -> InsertedParts / {abort.raise} =
  types.fold({ table: table, keys: [] }, |acc: InsertedParts, ty: Type| {
    let h = insert_type(acc.table, ty);
    { table: h.table, keys: acc.keys.push(h.key) }
  })

fn insert_fields(table: TypeTable, fs: List<Field>) -> InsertedFields / {abort.raise} =
  fs.fold({ table: table, fields: [] }, |acc: InsertedFields, f: Field| {
    let h = insert_type(acc.table, f.ty);
    { table: h.table, fields: acc.fields.push({ name: f.name, ty: h.key }) }
  })

pub fn insert_type(table: TypeTable, ty: Type) -> { table: TypeTable, key: Bytes } / {abort.raise} = {
  let made = match ty {
    VariableType(v) -> { table: table, node: NodeVariable(v) },
    NamedType(c) -> {
      let p = insert_parts(table, c.args);
      { table: p.table, node: NodeNamed({ name: c.name, args: p.keys }) }
    },
    FunctionType(f) -> {
      let p = insert_parts(table, f.params);
      let r = insert_type(p.table, f.ret);
      {
        table: r.table,
        node: NodeFunction({ params: p.keys, kept: f.kept, once: f.once, ret: r.key }),
      }
    },
    RecordType(fs) -> {
      let p = insert_fields(table, fs);
      { table: p.table, node: NodeRecord(p.fields) }
    },
    NominalType(x) -> {
      let a = insert_parts(table, x.args);
      let p = insert_fields(a.table, x.fields);
      { table: p.table, node: NodeNominal({ name: x.name, args: a.keys, fields: p.fields }) }
    },
  };
  let key = node_key(made.node);
  {
    table: if made.table.contains(key) { made.table } else { made.table.insert(key, made.node) },
    key: key,
  }
}

fn node_parts(node: TypeNode) -> List<Bytes> =
  match node {
    NodeVariable(_) -> [],
    NodeNamed(c) -> c.args,
    NodeFunction(f) -> f.params.push(f.ret),
    NodeRecord(fs) -> fs.map(|f: NodeField| f.ty),
    NodeNominal(x) -> x.args.concat(x.fields.map(|f: NodeField| f.ty)),
  }

pub fn subtable(table: TypeTable, keys: List<Bytes>) -> TypeTable =
  keys.fold(Map::new(), |acc: TypeTable, k: Bytes| reached_nodes(table, k, acc, table.len()))

fn reached_nodes(table: TypeTable, key: Bytes, acc: TypeTable, budget: Int) -> TypeTable =
  if budget <= 0 || acc.contains(key) { acc } else {
    match table.get(key) {
      None -> acc,
      Some(node) ->
        node_parts(node).fold(acc.insert(key, node), |a: TypeTable, k: Bytes|
          reached_nodes(table, k, a, budget - 1)),
    }
  }

pub fn tables_joined(a: TypeTable, b: TypeTable) -> TypeTable =
  b.fold(a, |acc: TypeTable, k: Bytes, node: TypeNode| acc.insert(k, node))

type ReadTypes = { types: List<Type>, read: Map<Bytes, Type> }

pub fn type_at(
  table: TypeTable,
  key: Bytes,
  read: Map<Bytes, Type>,
) -> { ty: Type, read: Map<Bytes, Type> } = type_within(table, key, read, table.len())

fn type_within(
  table: TypeTable,
  key: Bytes,
  read: Map<Bytes, Type>,
  budget: Int,
) -> { ty: Type, read: Map<Bytes, Type> } =
  match read.get(key) {
    Some(t) -> { ty: t, read: read },
    None -> if budget <= 0 { { ty: VariableType(0 - 1), read: read } } else {
      let made = match table.get(key) {
        None -> { ty: VariableType(0 - 1), read: read },
        Some(node) -> type_of_node(table, node, read, budget - 1),
      };
      { ty: made.ty, read: made.read.insert(key, made.ty) }
    },
  }

fn types_within(
  table: TypeTable,
  keys: List<Bytes>,
  read: Map<Bytes, Type>,
  budget: Int,
) -> ReadTypes =
  keys.fold({ types: [], read: read }, |acc: ReadTypes, k: Bytes| {
    let t = type_within(table, k, acc.read, budget);
    { types: acc.types.push(t.ty), read: t.read }
  })

fn fields_within(
  table: TypeTable,
  fs: List<NodeField>,
  read: Map<Bytes, Type>,
  budget: Int,
) -> { fields: List<Field>, read: Map<Bytes, Type> } = {
  let r = types_within(table, fs.map(|f: NodeField| f.ty), read, budget);
  {
    fields: range(0, fs.len()).map(|i: Int|
      {
        name: match fs.at(i) { Some(f) -> f.name, None -> b"" },
        ty: match r.types.at(i) { Some(t) -> t, None -> VariableType(0 - 1) },
      }),
    read: r.read,
  }
}

fn type_of_node(
  table: TypeTable,
  node: TypeNode,
  read: Map<Bytes, Type>,
  budget: Int,
) -> { ty: Type, read: Map<Bytes, Type> } =
  match node {
    NodeVariable(v) -> { ty: VariableType(v), read: read },
    NodeNamed(c) -> {
      let r = types_within(table, c.args, read, budget);
      { ty: NamedType({ name: c.name, args: r.types }), read: r.read }
    },
    NodeFunction(f) -> {
      let p = types_within(table, f.params, read, budget);
      let r = type_within(table, f.ret, p.read, budget);
      { ty: owning_fn_type(p.types, f.kept, f.once, r.ty, no_effects()), read: r.read }
    },
    NodeRecord(fs) -> {
      let r = fields_within(table, fs, read, budget);
      { ty: RecordType(r.fields), read: r.read }
    },
    NodeNominal(x) -> {
      let a = types_within(table, x.args, read, budget);
      let r = fields_within(table, x.fields, a.read, budget);
      { ty: NominalType({ name: x.name, args: a.types, fields: r.fields }), read: r.read }
    },
  }

pub type InternedType =
  | InternedVariable(Int)
  | InternedNamed({ name: Bytes, args: List<Int> })
  | InternedFunction({ params: List<Int>, kept: List<Int>, once: Bool, ret: Int, effects: Effects })
  | InternedRecord(List<InternedField>)
  | InternedNominal({ name: Bytes, args: List<Int>, fields: List<InternedField> })

pub type InternedField = { name: Bytes, ty: Int }

derive bin for InternedField

derive bin for InternedType

pub type TypeInterner = {
  nodes: List<InternedType>,
  index_by_node: Map<Bytes, Int>,
  index_by_type: Map<Bytes, Int>,
}

pub fn empty_interner() -> TypeInterner =
  { nodes: [], index_by_node: Map::new(), index_by_type: Map::new() }

type InternedPositions = { h: TypeInterner, at: List<Int> }

fn intern_parts(h: TypeInterner, types: List<Type>) -> InternedPositions / {abort.raise} =
  types.fold({ h: h, at: [] }, |acc: InternedPositions, ty: Type| {
    let p = intern_type(acc.h, ty);
    { h: p.h, at: acc.at.push(p.at) }
  })

fn intern_fields(
  h: TypeInterner,
  fs: List<Field>,
) -> { h: TypeInterner, fields: List<InternedField> } / {abort.raise} =
  fs.fold({ h: h, fields: [] }, |acc: { h: TypeInterner, fields: List<InternedField> }, f: Field| {
    let p = intern_type(acc.h, f.ty);
    { h: p.h, fields: acc.fields.push({ name: f.name, ty: p.at }) }
  })

fn intern_type(h: TypeInterner, ty: Type) -> { h: TypeInterner, at: Int } / {abort.raise} =
  match ty {
    VariableType(v) -> intern_node(h, InternedVariable(v)),
    NamedType(c) -> {
      let p = intern_parts(h, c.args);
      intern_node(p.h, InternedNamed({ name: c.name, args: p.at }))
    },
    FunctionType(f) -> {
      let p = intern_parts(h, f.params);
      let r = intern_type(p.h, f.ret);
      intern_node(
        r.h,
        InternedFunction({
          params: p.at,
          kept: f.kept,
          once: f.once,
          ret: r.at,
          effects: f.effects,
        }),
      )
    },
    RecordType(fs) -> {
      let p = intern_fields(h, fs);
      intern_node(p.h, InternedRecord(p.fields))
    },
    NominalType(x) -> {
      let whole = bin::encode(ty, type_bin()).blake3();
      match h.index_by_type.get(whole) {
        Some(at) -> { h: h, at: at },
        None -> {
          let a = intern_parts(h, x.args);
          let p = intern_fields(a.h, x.fields);
          let n = intern_node(p.h, InternedNominal({ name: x.name, args: a.at, fields: p.fields }));
          { h: { ..n.h, index_by_type: n.h.index_by_type.insert(whole, n.at) }, at: n.at }
        },
      }
    },
  }

fn intern_node(
  h: TypeInterner,
  node: InternedType,
) -> { h: TypeInterner, at: Int } / {abort.raise} = {
  let key = bin::encode(node, interned_type_bin());
  match h.index_by_node.get(key) {
    Some(at) -> { h: h, at: at },
    None -> {
      let at = h.nodes.len();
      {
        h: { ..h, nodes: h.nodes.push(node), index_by_node: h.index_by_node.insert(key, at) },
        at: at,
      }
    },
  }
}

pub fn intern_more_types(
  h: TypeInterner,
  types: List<Type>,
) -> { h: TypeInterner, at: List<Int> } / {abort.raise} = intern_parts(h, types)

pub fn intern_types(
  types: List<Type>,
) -> { labels: List<InternedType>, at: List<Int> } / {abort.raise} = {
  let p = intern_parts(empty_interner(), types);
  { labels: p.h.nodes, at: p.at }
}

fn interned_parts_of(node: InternedType) -> List<Int> =
  match node {
    InternedVariable(_) -> [],
    InternedNamed(c) -> c.args,
    InternedFunction(f) -> f.params.push(f.ret),
    InternedRecord(fs) -> fs.map(|f: InternedField| f.ty),
    InternedNominal(x) -> x.fields.fold(x.args, |acc: List<Int>, f: InternedField| acc.push(f.ty)),
  }

fn renumbered(node: InternedType, to: Map<Int, Int>) -> InternedType / {abort.raise} = {
  let part = |i: Int|
    match to.get(i) { Some(n) -> n, None -> panic("a type's part is laid out before it") };
  let fields = |fs: List<InternedField>|
    fs.map(|f: InternedField| { name: f.name, ty: part(f.ty) });
  match node {
    InternedVariable(v) -> InternedVariable(v),
    InternedNamed(c) -> InternedNamed({ name: c.name, args: c.args.map(part) }),
    InternedFunction(f) -> InternedFunction({ ..f, params: f.params.map(part), ret: part(f.ret) }),
    InternedRecord(fs) -> InternedRecord(fields(fs)),
    InternedNominal(x) ->
      InternedNominal({ name: x.name, args: x.args.map(part), fields: fields(x.fields) }),
  }
}

type Numbering = { numbered: Map<Int, Int>, out: List<InternedType> }

fn numbered_from(
  held: List<InternedType>,
  s: Numbering,
  place: Int,
  budget: Int,
) -> Numbering / {abort.raise} =
  if budget <= 0 || s.numbered.contains(place) { s } else {
    let node = held.get(place);
    let below = interned_parts_of(node).fold(s, |acc: Numbering, p: Int|
      numbered_from(held, acc, p, budget - 1));
    {
      numbered: below.numbered.insert(place, below.out.len()),
      out: below.out.push(renumbered(node, below.numbered)),
    }
  }

pub fn interned_subset(
  h: TypeInterner,
  places: List<Int>,
) -> { labels: List<InternedType>, at: List<Int> } / {abort.raise} = {
  let n = places.fold({ numbered: Map::new(), out: [] }, |acc: Numbering, p: Int|
    numbered_from(h.nodes, acc, p, h.nodes.len()));
  {
    labels: n.out,
    at: places.map(|p: Int|
      match n.numbered.get(p) { Some(i) -> i, None -> panic("a type stored has a place") }),
  }
}

pub fn types_of(held: List<InternedType>) -> List<Type> / {abort.raise} =
  held.fold([], |built: List<Type>, node: InternedType| {
    let part = |i: Int| built.get(i);
    let fields = |fs: List<InternedField>|
      fs.map(|f: InternedField| { name: f.name, ty: part(f.ty) });
    built.push(match node {
      InternedVariable(v) -> VariableType(v),
      InternedNamed(c) -> NamedType({ name: c.name, args: c.args.map(part) }),
      InternedFunction(f) ->
        owning_fn_type(f.params.map(part), f.kept, f.once, part(f.ret), f.effects),
      InternedRecord(fs) -> RecordType(fields(fs)),
      InternedNominal(x) ->
        NominalType({ name: x.name, args: x.args.map(part), fields: fields(x.fields) }),
    })
  })

type VariableRenaming = { types: Map<Int, Int>, effect_variables: Map<Int, Int> }

fn no_naming() -> VariableRenaming = { types: Map::new(), effect_variables: Map::new() }

fn name_type(naming: VariableRenaming, v: Int) -> VariableRenaming =
  if naming.types.contains(v) { naming }
  else { { ..naming, types: naming.types.insert(v, naming.types.len()) } }

fn name_effect_variable(naming: VariableRenaming, v: Int) -> VariableRenaming =
  if naming.effect_variables.contains(v) { naming } else {
    { ..naming, effect_variables: naming.effect_variables.insert(v, naming.effect_variables.len()) }
  }

fn name_effects(n: VariableRenaming, effects: List<Effect>) -> VariableRenaming =
  effects.fold(n, |m: VariableRenaming, entry: Effect|
    match entry.resource { ResourceVariable(v) -> name_type(m, v), _ -> m })

fn name_in(n: VariableRenaming, ty: Type) -> VariableRenaming =
  match ty {
    VariableType(v) -> name_type(n, v),
    NamedType(c) -> c.args.fold(n, name_in),
    FunctionType(f) -> {
      let m = name_effects(name_in(f.params.fold(n, name_in), f.ret), f.effects.listed);
      match f.effects.variable { Some(v) -> name_effect_variable(m, v), None -> m }
    },
    RecordType(fs) -> fs.fold(n, |m: VariableRenaming, field: Field| name_in(m, field.ty)),
    NominalType(x) -> x.args.fold(n, name_in),
  }

fn as_types(naming: VariableRenaming) -> Map<Int, Type> =
  naming.types.fold(Map::new(), |m: Map<Int, Type>, k: Int, v: Int| m.insert(k, VariableType(v)))

fn renamed(m: Map<Int, Int>, v: Int) -> Int = match m.get(v) { Some(w) -> w, None -> v }

pub fn canonical_type(ty: Type) -> Type / {abort.raise} = {
  let n = name_in(no_naming(), ty);
  rename(ty, as_types(n), n.effect_variables)
}

pub fn canonical_effects(effects: List<Effect>) -> List<Effect> / {abort.raise} = {
  let types = as_types(name_effects(no_naming(), effects));
  effects_sorted(effects.map(|entry: Effect| rename_effect(entry, types)))
}

pub fn canonical_scheme(scheme: Scheme) -> Scheme / {abort.raise} =
  canonical_beside(scheme, []).scheme

pub fn canonical_beside(
  scheme: Scheme,
  effect_lists: List<List<Effect>>,
) -> { scheme: Scheme, effect_lists: List<List<Effect>> } / {abort.raise} = {
  let head = scheme.effect_variables.fold(
    scheme.label_variables.fold(scheme.type_variables.fold(no_naming(), name_type), name_type),
    name_effect_variable,
  );
  let n = effect_lists.fold(name_in(head, scheme.ty), name_effects);
  let types = as_types(n);
  {
    scheme: {
      type_variables: scheme.type_variables.map(|v: Int| renamed(n.types, v)),
      effect_variables: scheme.effect_variables.map(|v: Int| renamed(n.effect_variables, v)),
      keep_variables: scheme.keep_variables.map(|v: Int| renamed(n.types, v)),
      label_variables: scheme.label_variables.map(|v: Int| renamed(n.types, v)),
      ty: rename(scheme.ty, types, n.effect_variables),
    },
    effect_lists: effect_lists.map(|effects: List<Effect>|
      effects_sorted(effects.map(|entry: Effect| rename_effect(entry, types)))),
  }
}

pub type Printer = {
  type_names: Map<Int, Bytes>,
  effect_variable_names: Map<Int, Bytes>,
  label_names: Map<Int, Bytes>,
  taken: Map<Bytes, Bool>,
}

pub fn printer_new() -> Printer =
  {
    type_names: Map::new(),
    effect_variable_names: Map::new(),
    label_names: Map::new(),
    taken: Map::new(),
  }

pub fn printer_naming(printer: Printer, v: Int, name: Bytes) -> Printer =
  { ..printer, type_names: printer.type_names.insert(v, name) }

fn type_letters() -> Bytes = b"abcdghijklmnopqrsuvwxyz"
fn effect_variable_letters() -> Bytes = b"eft"
fn label_letters() -> Bytes = b"lmn"

fn letter_name(letters: Bytes, i: Int) -> Bytes / {abort.raise} = {
  let n = letters.len();
  let letter = letters.slice(i % n, i % n + 1);
  if i < n { letter } else { letter.concat(Bytes::of_string(Int::to_string(i / n))) }
}

pub fn type_letter(i: Int) -> Bytes / {abort.raise} = letter_name(type_letters(), i)

fn type_name(printer: Printer, v: Int) -> { printer: Printer, name: Bytes } / {abort.raise} =
  match printer.type_names.get(v) {
    Some(n) -> { printer: printer, name: n },
    None -> {
      let name = letter_name(type_letters(), printer.type_names.len());
      { printer: { ..printer, type_names: printer.type_names.insert(v, name) }, name: name }
    },
  }

fn effect_variable_name(
  printer: Printer,
  v: Int,
) -> { printer: Printer, name: Bytes } / {abort.raise} =
  match printer.effect_variable_names.get(v) {
    Some(n) -> { printer: printer, name: n },
    None -> {
      let name = letter_name(effect_variable_letters(), printer.effect_variable_names.len());
      {
        printer: {
          ..printer,
          effect_variable_names: printer.effect_variable_names.insert(v, name),
        },
        name: name,
      }
    },
  }

fn label_name(printer: Printer, v: Int) -> { printer: Printer, name: Bytes } / {abort.raise} =
  match printer.label_names.get(v) {
    Some(n) -> { printer: printer, name: n },
    None -> {
      let name = free_label(printer);
      { printer: { ..printer, label_names: printer.label_names.insert(v, name) }, name: name }
    },
  }

fn free_label(printer: Printer) -> Bytes / {abort.raise} =
  iterate(0, printer.taken.len() + printer.label_names.len() + 1, |i: Int| {
    let name = letter_name(label_letters(), i);
    if printer.taken.contains(name) || label_in_use(printer.label_names, name) { Continue(i + 1) }
    else { Stop(name) }
  })

fn label_in_use(names: Map<Int, Bytes>, name: Bytes) -> Bool =
  names.fold(false, |acc: Bool, v: Int, held: Bytes| acc || held == name)

fn reserve_resource(printer: Printer, resource: Resource) -> Printer =
  match resource {
    NamedResource(n) -> { ..printer, taken: printer.taken.insert(n, true) },
    _ -> printer,
  }

pub fn reserve_effects(printer: Printer, effects: List<Effect>) -> Printer =
  effects.fold(printer, |acc: Printer, entry: Effect| reserve_resource(acc, entry.resource))

fn reserve_type(printer: Printer, t: Type) -> Printer / {abort.raise} =
  match t {
    VariableType(_) -> printer,
    NamedType(c) -> match arg_label(t) {
      Some(l) -> match label_of(l) {
        Some(n) -> reserve_resource(printer, NamedResource(n)),
        None -> printer,
      },
      None -> c.args.fold(printer, |acc: Printer, a: Type| reserve_type(acc, a)),
    },
    FunctionType(f) ->
      reserve_effects(
        reserve_type(f.params.fold(printer, |acc: Printer, x: Type| reserve_type(acc, x)), f.ret),
        f.effects.listed,
      ),
    RecordType(fs) -> fs.fold(printer, |acc: Printer, f: Field| reserve_type(acc, f.ty)),
    NominalType(n) -> n.args.fold(printer, |acc: Printer, a: Type| reserve_type(acc, a)),
  }

pub fn label_scope_separator() -> Bytes = b"@"

pub fn written_label(label: Bytes) -> Bytes / {abort.raise} =
  match label.index_of(label_scope_separator()) { Some(i) -> label.slice(0, i), None -> label }

fn effects_with_written_labels(
  effects: Effects,
  closed: (Bytes) -> Bool,
) -> Effects / {abort.raise} =
  {
    listed: effects.listed.fold([], |acc: List<Effect>, entry: Effect|
      effects_insert(acc, match entry.resource {
        NamedResource(n) -> if closed(n) { { ..entry, resource: NamedResource(written_label(n)) } }
        else { entry },
        _ -> entry,
      })),
    variable: effects.variable,
  }

fn type_with_written_labels(ty: Type, closed: (Bytes) -> Bool) -> Type / {abort.raise} =
  match ty {
    VariableType(_) -> ty,
    NamedType(c) -> match label_of(ty) {
      Some(l) -> if closed(l) { label_type(written_label(l)) } else { ty },
      None -> NamedType({ ..c, args: c.args.map(|a: Type| type_with_written_labels(a, closed)) }),
    },
    FunctionType(f) ->
      FunctionType({
        ..f,
        params: f.params.map(|p: Type| type_with_written_labels(p, closed)),
        ret: type_with_written_labels(f.ret, closed),
        effects: effects_with_written_labels(f.effects, closed),
      }),
    RecordType(fs) ->
      RecordType(fs.map(|f: Field| { ..f, ty: type_with_written_labels(f.ty, closed) })),
    NominalType(n) ->
      NominalType({
        ..n,
        args: n.args.map(|a: Type| type_with_written_labels(a, closed)),
        fields: n.fields.map(|f: Field| { ..f, ty: type_with_written_labels(f.ty, closed) }),
      }),
  }

pub fn effects_outside_definition(effects: Effects) -> Effects / {abort.raise} =
  effects_with_written_labels(effects, |_: Bytes| true)

pub fn type_after_scope(ty: Type, label: Bytes) -> Type / {abort.raise} =
  type_with_written_labels(ty, |l: Bytes| l == label)

pub fn print_resource(
  printer: Printer,
  resource: Resource,
) -> { printer: Printer, text: Bytes } / {abort.raise} =
  match resource {
    NamedResource(n) ->
      { printer: printer, text: Bytes::concat_all([b"[", written_label(n), b"]"]) },
    ResourceVariable(v) -> {
      let o = label_name(printer, v);
      { printer: o.printer, text: Bytes::concat_all([b"[", o.name, b"]"]) }
    },
    SingletonResource -> { printer: printer, text: b"" },
    AnyResource -> { printer: printer, text: b"[*]" },
  }

pub fn print_effect(
  printer: Printer,
  entry: Effect,
) -> { printer: Printer, text: Bytes } / {abort.raise} =
  if is_diverges(entry) { { printer: printer, text: b"diverges" } } else {
    let r = print_resource(printer, entry.resource);
    {
      printer: r.printer,
      text: Bytes::concat_all([
        entry.effect,
        b".",
        match entry.op { Some(op) -> op, None -> mode_text(entry.mode) },
        r.text,
      ]),
    }
  }

pub fn effect_text(entry: Effect) -> Bytes / {abort.raise} = print_effect(printer_new(), entry).text

pub fn resource_text(resource: Resource) -> Bytes / {abort.raise} =
  print_resource(printer_new(), resource).text

pub fn print_type(printer: Printer, ty: Type) -> { printer: Printer, text: Bytes } / {abort.raise} =
  printed(reserve_type(printer, ty), ty)

fn label_text(printer: Printer, label: Type) -> { printer: Printer, text: Bytes } / {abort.raise} =
  match label_of(label) {
    Some(n) -> { printer: printer, text: written_label(n) },
    None -> match label {
      VariableType(v) -> {
        let o = label_name(printer, v);
        { printer: o.printer, text: o.name }
      },
      _ -> printed(printer, label),
    },
  }

fn printed(printer: Printer, ty: Type) -> { printer: Printer, text: Bytes } / {abort.raise} =
  match ty {
    VariableType(v) -> {
      let o = type_name(printer, v);
      { printer: o.printer, text: o.name }
    },
    NamedType(c) -> if c.name == b"Scoped" && c.args.len() == 2 {
      let elem = printed(printer, c.args.get(1));
      let label = label_text(elem.printer, c.args.get(0));
      {
        printer: label.printer,
        text: Bytes::concat_all([b"Scoped<", elem.text, b", [", label.text, b"]>"]),
      }
    } else if c.args.len() > 0 && is_label_or_effects(ty) {
      let o = label_text(printer, c.args.get(0));
      { printer: o.printer, text: Bytes::concat_all([b"[", o.text, b"]"]) }
    } else { print_applied(printer, c.name, c.args) },
    FunctionType(f) -> match arg_effects(ty) {
      Some(effects) -> print_effects(printer, effects),
      None -> {
        let ps = print_types(printer, f.params);
        let r = printed(ps.printer, f.ret);
        let params = range(0, ps.texts.len()).map(|i: Int|
          if f.kept.contains(i) { b"keep ".concat(ps.texts.get(i)) } else { ps.texts.get(i) });
        let head = Bytes::concat_all([
          if f.once { b"once (" } else { b"(" },
          Bytes::join(params, b", "),
          b") -> ",
          r.text,
        ]);
        if is_pure(f.effects) { { printer: r.printer, text: head } } else {
          let effects = print_effects(r.printer, f.effects);
          { printer: effects.printer, text: Bytes::concat_all([head, b" / ", effects.text]) }
        }
      },
    },
    RecordType(fs) -> match tuple_arity(fs) {
      Some(n) -> {
        let ts = print_types(
          printer,
          range(0, n).map(|i: Int|
            match field_get(fs, b"_".concat(Bytes::of_string(i.to_string()))) {
              Some(x) -> x,
              None -> panic("a tuple field"),
            }),
        );
        { printer: ts.printer, text: Bytes::concat_all([b"(", Bytes::join(ts.texts, b", "), b")"]) }
      },
      None -> {
        let out = fs.fold(
          { printer: printer, texts: [] },
          |acc: { printer: Printer, texts: List<Bytes> }, f: Field| {
            let v = printed(acc.printer, f.ty);
            {
              printer: v.printer,
              texts: acc.texts.push(Bytes::concat_all([f.name, b": ", v.text])),
            }
          },
        );
        {
          printer: out.printer,
          text: Bytes::concat_all([b"{", Bytes::join(out.texts, b", "), b"}"]),
        }
      },
    },
    NominalType(n) -> print_applied(printer, n.name, n.args),
  }

fn print_applied(
  printer: Printer,
  name: Bytes,
  args: List<Type>,
) -> { printer: Printer, text: Bytes } / {abort.raise} =
  if args.len() == 0 { { printer: printer, text: name } }
  else if args.fold(false, |any: Bool, a: Type| any || is_label_or_effects(a)) {
    print_with_labels_and_effects(printer, name, args)
  } else {
    let shown = print_types(printer, args);
    {
      printer: shown.printer,
      text: Bytes::concat_all([name, b"<", Bytes::join(shown.texts, b", "), b">"]),
    }
  }

fn print_with_labels_and_effects(
  printer: Printer,
  name: Bytes,
  args: List<Type>,
) -> { printer: Printer, text: Bytes } / {abort.raise} = {
  let types = print_types(printer, type_args(args));
  let labels = args.fold(
    { printer: types.printer, texts: [] },
    |acc: { printer: Printer, texts: List<Bytes> }, a: Type|
      match arg_label(a) {
        Some(l) -> {
          let o = label_text(acc.printer, l);
          { printer: o.printer, texts: acc.texts.push(o.text) }
        },
        None -> acc,
      },
  );
  let effects = args.fold(
    { printer: labels.printer, texts: [] },
    |acc: { printer: Printer, texts: List<Bytes> }, a: Type|
      match arg_effects(a) {
        Some(r) -> {
          let o = print_effects(acc.printer, r);
          { printer: o.printer, texts: acc.texts.push(o.text) }
        },
        None -> acc,
      },
  );
  { printer: effects.printer, text: name.concat(angled(types.texts, labels.texts, effects.texts)) }
}

fn print_types(
  printer: Printer,
  types: List<Type>,
) -> { printer: Printer, texts: List<Bytes> } / {abort.raise} =
  types.fold(
    { printer: printer, texts: [] },
    |acc: { printer: Printer, texts: List<Bytes> }, ty: Type| {
      let o = printed(acc.printer, ty);
      { printer: o.printer, texts: acc.texts.push(o.text) }
    },
  )

pub fn print_effect_list(
  printer: Printer,
  effects: List<Effect>,
) -> { printer: Printer, texts: List<Bytes> } / {abort.raise} = {
  let p = reserve_effects(printer, effects);
  effects.fold(
    { printer: p, texts: [] },
    |acc: { printer: Printer, texts: List<Bytes> }, entry: Effect| {
      let o = print_effect(acc.printer, entry);
      { printer: o.printer, texts: acc.texts.push(o.text) }
    },
  )
}

pub fn print_effect_list_text(
  printer: Printer,
  effects: List<Effect>,
  sep: Bytes,
) -> { printer: Printer, text: Bytes } / {abort.raise} = {
  let out = print_effect_list(printer, effects);
  { printer: out.printer, text: Bytes::join(out.texts, sep) }
}

pub fn effect_list_text(effects: List<Effect>, sep: Bytes) -> Bytes / {abort.raise} = {
  let out = print_effect_list_text(printer_new(), effects, sep);
  let vars = effects.fold([], |acc: List<Int>, entry: Effect|
    match entry.resource {
      ResourceVariable(v) -> if acc.contains(v) { acc } else { acc.push(v) },
      _ -> acc,
    });
  if vars.len() == 0 { out.text } else {
    let head = vars.fold(
      { printer: out.printer, texts: [] },
      |acc: { printer: Printer, texts: List<Bytes> }, v: Int| {
        let o = label_name(acc.printer, v);
        { printer: o.printer, texts: acc.texts.push(Bytes::concat_all([b"[", o.name, b"]"])) }
      },
    );
    Bytes::concat_all([b"<", Bytes::join(head.texts, sep), b">", out.text])
  }
}

pub fn last_dot(b: Bytes) -> Int =
  range(0, b.len()).fold(0 - 1, |acc: Int, i: Int| if b.at(i) == 46 { i } else { acc })

type Split = { name: Bytes, resource: Resource }

fn read_effect(text: Bytes) -> Option<Effect> / {abort.raise} =
  if text == b"diverges" { Some(diverges_effect()) } else {
    let n = text.len();
    let split: Option<Split> = match text.index_of(b"[") {
      None -> Some({ name: text, resource: SingletonResource }),
      Some(i) -> if n == 0 || text.at(n - 1) != 93 || i == 0 { None }
      else { Some({ name: text.slice(0, i), resource: NamedResource(text.slice(i + 1, n - 1)) }) },
    };
    match split {
      None -> None,
      Some(s) -> {
        let d = last_dot(s.name);
        if d <= 0 || d >= s.name.len() - 1 { None } else {
          let eff = s.name.slice(0, d);
          let access = s.name.slice(d + 1, s.name.len());
          if access == b"read" {
            Some({ effect: eff, resource: s.resource, mode: ReadMode, op: None })
          } else if access == b"write" {
            Some({ effect: eff, resource: s.resource, mode: WriteMode, op: None })
          } else { Some({ effect: eff, resource: s.resource, mode: WriteMode, op: Some(access) }) }
        }
      },
    }
  }

pub fn read_effects(text: Bytes) -> Option<List<Effect>> / {abort.raise} =
  if text.len() == 0 { Some([]) }
  else if text.at(0) == 60 { None }
  else { Option::traverse(text.split(b","), read_effect) }

fn label_position_name(i: Int) -> Bytes = b"#".concat(ascii_of_int(i))

pub fn positional_effects_text(effects: List<Effect>, labels: List<Int>) -> Bytes / {abort.raise} =
  effect_list_text(positional_effects(effects, labels), b",")

pub fn positional_effects(effects: List<Effect>, labels: List<Int>) -> List<Effect> =
  effects.map(|entry: Effect|
    match entry.resource {
      ResourceVariable(v) -> match labels.index_of(v) {
        Some(i) -> { ..entry, resource: NamedResource(label_position_name(i)) },
        None -> entry,
      },
      _ -> entry,
    })

pub fn effects_with_label_variables(
  effects: List<Effect>,
  labels: List<Int>,
) -> Option<List<Effect>> / {abort.raise} =
  Option::traverse(effects, |entry: Effect|
    match entry.resource {
      NamedResource(n) -> if !n.starts_with(b"#") { Some(entry) } else {
        match range(0, labels.len()).find(|i: Int| label_position_name(i) == n) {
          Some(i) -> Some({ ..entry, resource: ResourceVariable(labels.get(i)) }),
          None -> None,
        }
      },
      _ -> Some(entry),
    })

pub fn print_effects(
  printer: Printer,
  effects: Effects,
) -> { printer: Printer, text: Bytes } / {abort.raise} = {
  let out = print_effect_list_text(printer, effects.listed, b", ");
  match effects.variable {
    None -> { printer: out.printer, text: Bytes::concat_all([b"{", out.text, b"}"]) },
    Some(v) -> {
      let n = effect_variable_name(out.printer, v);
      if effects.listed.len() == 0 { { printer: n.printer, text: n.name } } else {
        { printer: n.printer, text: Bytes::concat_all([b"{", out.text, b" | ", n.name, b"}"]) }
      }
    },
  }
}

pub fn print_scheme(
  printer: Printer,
  scheme: Scheme,
) -> { printer: Printer, text: Bytes } / {abort.raise} = {
  let p = reserve_type(printer, scheme.ty);
  let body = printed(
    scheme.label_variables.fold(p, |acc: Printer, v: Int| label_name(acc, v).printer),
    scheme.ty,
  );
  if scheme.type_variables.len() == 0 && scheme.effect_variables.len() == 0
      && scheme.label_variables.len() == 0 { body } else {
    let types = scheme.type_variables.fold(
      { printer: body.printer, texts: [] },
      |acc: { printer: Printer, texts: List<Bytes> }, v: Int| {
        let o = type_name(acc.printer, v);
        let named = if scheme.keep_variables.contains(v) { b"keep ".concat(o.name) }
        else { o.name };
        { printer: o.printer, texts: acc.texts.push(named) }
      },
    );
    let labels = scheme.label_variables.fold(
      types,
      |acc: { printer: Printer, texts: List<Bytes> }, v: Int| {
        let o = label_name(acc.printer, v);
        { printer: o.printer, texts: acc.texts.push(Bytes::concat_all([b"[", o.name, b"]"])) }
      },
    );
    let effects = scheme.effect_variables.fold(
      { printer: labels.printer, texts: [] },
      |acc: { printer: Printer, texts: List<Bytes> }, v: Int| {
        let o = effect_variable_name(acc.printer, v);
        { printer: o.printer, texts: acc.texts.push(o.name) }
      },
    );
    let head = if labels.texts.len() > 0 && effects.texts.len() > 0 {
      Bytes::concat_all([
        b"<",
        Bytes::join(labels.texts, b", "),
        b" | ",
        Bytes::join(effects.texts, b", "),
        b">",
      ])
    } else if labels.texts.len() > 0 {
      Bytes::concat_all([b"<", Bytes::join(labels.texts, b", "), b">"])
    } else { Bytes::concat_all([b"<| ", Bytes::join(effects.texts, b", "), b">"]) };
    { printer: effects.printer, text: head.concat(body.text) }
  }
}

pub fn scheme_text(scheme: Scheme) -> Bytes / {abort.raise} =
  print_scheme(printer_new(), scheme).text
pub fn type_text(ty: Type) -> Bytes / {abort.raise} = print_type(printer_new(), ty).text
pub fn effects_text(effects: Effects) -> Bytes / {abort.raise} =
  print_effects(printer_new(), effects).text

pub fn backticked_text(x: Bytes) -> Bytes = Bytes::concat_all([b"`", x, b"`"])

test "unification binds a variable once and rejects the occurs case" {
  let f0 = fresh_new();
  let a = fresh_type(f0);
  let u = unify(substitution_new(), a.fresh, a.ty, list_type(int_type()));
  assert_eq(type_text(resolve_type(u.substitution, a.ty)), b"List<Int>");
  let bad = unify(u.substitution, u.fresh, a.ty, list_type(a.ty));
  assert_eq(match bad.error { Some(Mismatch(_)) -> 1, Some(_) -> 2, None -> 0 }, 1)
}

test "a unification deeper than its first room counts the types and goes on, through bindings" {
  let nested = |inner: Type| range(0, 200).fold(inner, |t: Type, _i: Int| list_type(t));
  let vars = range(0, 201).fold(
    { fresh: fresh_new(), types: [] },
    |acc: { fresh: Fresh, types: List<Type> }, _i: Int| {
      let v = fresh_type(acc.fresh);
      { fresh: v.fresh, types: acc.types.push(v.ty) }
    },
  );
  let chained = range(0, 200).fold(
    unify_succeeded(substitution_new(), vars.fresh),
    |u: UnifyResult, i: Int|
      unify(u.substitution, u.fresh, vars.types.get(i), list_type(vars.types.get(i + 1))),
  );
  let u = unify(chained.substitution, chained.fresh, vars.types.get(0), nested(int_type()));
  assert(u.error == None);
  assert(resolve_type(u.substitution, vars.types.get(0)) == nested(int_type()));
  let bad = unify(u.substitution, u.fresh, nested(bool_type()), vars.types.get(0));
  assert(match bad.error {
    Some(Mismatch(m)) -> m.expected == bool_type() && m.found == int_type(),
    _ -> false,
  })
}

test "effects unify one effect at a time, and closed effects reject what they lack" {
  let db = { effect: b"db", resource: NamedResource(b"users"), mode: ReadMode, op: None };
  let f0 = fresh_new();
  let e = fresh_effects(f0);
  let u = unify_effects(substitution_new(), e.fresh, e.effects, single_effect(db));
  assert_eq(effects_text(resolve_effects(u.substitution, e.effects)), b"{db.read[users]}");
  let bad = unify_effects(u.substitution, u.fresh, no_effects(), single_effect(db));
  assert(match bad.error { Some(EffectsMismatch(_)) -> true, _ -> false })
}

test "an operation effect sorts after its mode effect, which covers it" {
  let wr = { effect: b"net", resource: NamedResource(b"conn"), mode: WriteMode, op: None };
  let send = {
    effect: b"net",
    resource: NamedResource(b"conn"),
    mode: WriteMode,
    op: Some(b"send"),
  };
  let recv = {
    effect: b"net",
    resource: NamedResource(b"conn"),
    mode: WriteMode,
    op: Some(b"recv"),
  };
  let rd = { effect: b"net", resource: NamedResource(b"conn"), mode: ReadMode, op: None };
  assert(effect_lt(wr, send));
  assert(!effect_lt(send, wr));
  assert(effect_lt(recv, send));
  assert_eq(
    effects_text(closed_effects([send, wr, recv])),
    b"{net.write[conn], net.recv[conn], net.send[conn]}",
  );
  assert(effect_covers(wr, send));
  assert(effect_covers(send, send));
  assert(!effect_covers(send, wr));
  assert(!effect_covers(rd, send));
  assert(effects_cover([rd, wr], send));
  assert(!effects_cover([rd], send));
  assert_eq(
    effects_text(effects_without_covered(closed_effects([send, wr, recv, rd]), [wr])),
    b"{net.read[conn]}",
  );
  assert_eq(
    effects_text(effects_without_covered(closed_effects([send, recv, rd]), [send])),
    b"{net.read[conn], net.recv[conn]}",
  )
}

test "effects read back as the effects they were printed from" {
  let rd = { effect: b"m.db", resource: NamedResource(b"users"), mode: ReadMode, op: None };
  let wr = { effect: b"m.net", resource: SingletonResource, mode: WriteMode, op: None };
  let send = {
    effect: b"m.net",
    resource: NamedResource(b"conn"),
    mode: WriteMode,
    op: Some(b"send"),
  };
  assert_eq(read_effects(b""), Some([]));
  assert_eq(read_effects(effect_list_text([rd], b",")), Some([rd]));
  assert_eq(read_effects(effect_list_text([rd, wr], b",")), Some([rd, wr]));
  assert_eq(read_effects(effect_list_text([send], b",")), Some([send]));
  assert_eq(
    read_effects(
      effect_list_text(
        [{ effect: b"m.net", resource: ResourceVariable(4), mode: WriteMode, op: Some(b"send") }],
        b",",
      ),
    ),
    None,
  );
  assert_eq(read_effects(b"db"), None);
  assert_eq(read_effects(b".read"), None);
  assert_eq(read_effects(b"m.db."), None);
  assert_eq(read_effects(b"m.db.read[users"), None)
}

test "recorded effects name a label parameter by its place, read back as that parameter's current variable" {
  let send = |r: Resource| { effect: b"m.net", resource: r, mode: WriteMode, op: Some(b"send") };
  let rd = { effect: b"m.db", resource: NamedResource(b"users"), mode: ReadMode, op: None };
  let recorded = positional_effects_text(
    [send(ResourceVariable(7)), rd, send(ResourceVariable(4))],
    [4, 7],
  );
  assert_eq(recorded, b"m.net.send[#1],m.db.read[users],m.net.send[#0]");
  match read_effects(recorded) {
    None -> panic("a recorded row reads as nothing"),
    Some(effects) -> {
      assert_eq(
        effects_with_label_variables(effects, [12, 30]),
        Some([send(ResourceVariable(30)), rd, send(ResourceVariable(12))]),
      );
      assert_eq(effects_with_label_variables(effects, [12]), None)
    },
  };
  assert_eq(read_effects(positional_effects_text([send(ResourceVariable(9))], [4])), None)
}

test "the printer names variables in the order it meets them, effect variables apart" {
  let sc = {
    type_variables: [7, 3],
    effect_variables: [2],
    keep_variables: [],
    label_variables: [],
    ty: fn_type([VariableType(3), VariableType(7)], list_type(VariableType(3)), open_effects(2)),
  };
  assert_eq(scheme_text(sc), b"<b, a | e>(a, b) -> List<a> / e");
  assert_eq(
    type_text(
      RecordType(
        fields_sorted([{ name: b"_1", ty: int_type() }, { name: b"_0", ty: bool_type() }]),
      ),
    ),
    b"(Bool, Int)",
  )
}

test "two schemes alike but for how their variables are numbered are one scheme renamed" {
  let send = |v: Int|
    { effect: b"net", resource: ResourceVariable(v), mode: WriteMode, op: Some(b"send") };
  let one = {
    type_variables: [7, 3],
    effect_variables: [12],
    keep_variables: [],
    label_variables: [5],
    ty: fn_type([VariableType(3), list_type(VariableType(7))], VariableType(3), {
      listed: [send(5)],
      variable: Some(12),
    }),
  };
  let two = {
    type_variables: [40, 21],
    effect_variables: [2],
    keep_variables: [],
    label_variables: [9],
    ty: fn_type([VariableType(21), list_type(VariableType(40))], VariableType(21), {
      listed: [send(9)],
      variable: Some(2),
    }),
  };
  assert(one != two);
  assert_eq(canonical_scheme(one), canonical_scheme(two));
  assert_eq(canonical_scheme(one), {
    type_variables: [0, 1],
    effect_variables: [0],
    keep_variables: [],
    label_variables: [2],
    ty: fn_type([VariableType(1), list_type(VariableType(0))], VariableType(1), {
      listed: [send(2)],
      variable: Some(0),
    }),
  });
  assert_eq(scheme_text(canonical_scheme(one)), scheme_text(one));
  assert_eq(canonical_type(list_type(VariableType(8))), list_type(VariableType(0)));
  let recv = { ..send(30), op: Some(b"recv") };
  assert_eq(canonical_effects([send(12), recv]), [send(0), { ..send(1), op: Some(b"recv") }])
}

test "a label variable sorts between a name and the singleton, and resolves to what it binds" {
  let named = {
    effect: b"net",
    resource: NamedResource(b"conn"),
    mode: WriteMode,
    op: Some(b"send"),
  };
  let var_ = { effect: b"net", resource: ResourceVariable(4), mode: WriteMode, op: Some(b"send") };
  let single = { effect: b"net", resource: SingletonResource, mode: WriteMode, op: Some(b"send") };
  assert(effect_lt(named, var_));
  assert(effect_lt(var_, single));
  assert_eq(
    effects_text(closed_effects([single, var_, named])),
    b"{net.send[conn], net.send[l], net.send}",
  );
  let s = {
    ty: Map::new().insert(4, label_type(b"conn")),
    effects: Map::new(),
    rigid_type: Map::new(),
    rigid_effects: Map::new(),
  };
  assert_eq(effect_text(resolve_effect(s, var_)), b"net.send[conn]");
  assert_eq(effects_text(resolve_effects(s, closed_effects([var_, named]))), b"{net.send[conn]}")
}

test "the text of a function's effects binds the labels they name" {
  let named = {
    effect: b"net",
    resource: NamedResource(b"conn"),
    mode: WriteMode,
    op: Some(b"send"),
  };
  let first = { effect: b"net", resource: ResourceVariable(4), mode: WriteMode, op: Some(b"recv") };
  let second = {
    effect: b"net",
    resource: ResourceVariable(9),
    mode: WriteMode,
    op: Some(b"send"),
  };
  assert_eq(effect_list_text([named], b","), b"net.send[conn]");
  assert_eq(effect_list_text([], b","), b"");
  assert_eq(
    effect_list_text([first, second, first], b","),
    b"<[l],[m]>net.recv[l],net.send[m],net.recv[l]",
  );
  assert_eq(effect_list_text([named, second], b","), b"<[l]>net.send[conn],net.send[l]")
}

test "a label variable steps past a resource of its name" {
  let named = { effect: b"net", resource: NamedResource(b"l"), mode: WriteMode, op: Some(b"send") };
  let var_ = { effect: b"net", resource: ResourceVariable(4), mode: WriteMode, op: Some(b"recv") };
  assert_eq(effect_list_text([named, var_], b","), b"<[m]>net.send[l],net.recv[m]");
  assert_eq(effects_text(closed_effects([named, var_])), b"{net.send[l], net.recv[m]}");
  let same_op = {
    effect: b"net",
    resource: ResourceVariable(4),
    mode: WriteMode,
    op: Some(b"send"),
  };
  assert_eq(effect_list_text([named, same_op], b","), b"<[m]>net.send[l],net.send[m]");
  let sc = {
    type_variables: [],
    effect_variables: [],
    keep_variables: [],
    label_variables: [4],
    ty: fn_type([], unit_type(), closed_effects([named, var_])),
  };
  assert_eq(scheme_text(sc), b"<[m]>() -> Unit / {net.send[l], net.recv[m]}");
  let held = { effect: b"net", resource: NamedResource(b"m"), mode: WriteMode, op: Some(b"close") };
  assert_eq(
    effect_list_text([named, held, var_], b","),
    b"<[n]>net.send[l],net.close[m],net.recv[n]",
  );
  let last = {
    effect: b"net",
    resource: NamedResource(b"n"),
    mode: WriteMode,
    op: Some(b"connect"),
  };
  assert_eq(
    effect_list_text([named, held, last, var_], b","),
    b"<[l1]>net.send[l],net.close[m],net.connect[n],net.recv[l1]",
  )
}

test "a free label variable takes the resource the other effects name for its operation" {
  let f0 = fresh_new();
  let v = fresh_type_var(f0);
  let generic = closed_effects([
    { effect: b"net", resource: ResourceVariable(v.var), mode: WriteMode, op: Some(b"send") },
  ]);
  let concrete = closed_effects([
    { effect: b"net", resource: NamedResource(b"conn"), mode: WriteMode, op: Some(b"send") },
  ]);
  let u = unify_effects(substitution_new(), v.fresh, generic, concrete);
  assert(match u.error { None -> true, Some(_) -> false });
  assert_eq(effects_text(resolve_effects(u.substitution, generic)), b"{net.send[conn]}");
  let bad = unify_effects(mark_rigid_type(substitution_new(), v.var), v.fresh, generic, concrete);
  assert(match bad.error { Some(EffectsMismatch(_)) -> true, _ -> false })
}

test "a scheme prints its label parameters bracketed, among the type parameters" {
  let entry = { effect: b"net", resource: ResourceVariable(5), mode: WriteMode, op: Some(b"send") };
  let sc = {
    type_variables: [1],
    effect_variables: [2],
    keep_variables: [],
    label_variables: [5],
    ty: fn_type([VariableType(1)], unit_type(), { listed: [entry], variable: Some(2) }),
  };
  assert_eq(scheme_text(sc), b"<a, [l] | e>(a) -> Unit / {net.send[l] | e}");
  let other = {
    type_variables: [1],
    effect_variables: [2],
    keep_variables: [],
    label_variables: [9],
    ty: fn_type([VariableType(1)], unit_type(), {
      listed: [
        { effect: b"net", resource: ResourceVariable(9), mode: WriteMode, op: Some(b"send") },
      ],
      variable: Some(2),
    }),
  };
  assert_eq(scheme_text(other), scheme_text(sc))
}

test "instantiating a scheme freshens its label parameters and hands them back" {
  let entry = { effect: b"net", resource: ResourceVariable(5), mode: WriteMode, op: Some(b"send") };
  let sc = {
    type_variables: [],
    effect_variables: [],
    keep_variables: [],
    label_variables: [5],
    ty: fn_type([], unit_type(), closed_effects([entry])),
  };
  let inst = instantiate_with(sc, fresh_new());
  assert_eq(inst.labels.len(), 1);
  let bound = match inst.labels.get(0) { VariableType(v) -> v, _ -> 0 - 1 };
  assert(bound >= 0);
  let s = {
    ty: Map::new().insert(bound, label_type(b"conn")),
    effects: Map::new(),
    rigid_type: Map::new(),
    rigid_effects: Map::new(),
  };
  assert_eq(type_text(resolve_type(s, inst.ty)), b"() -> Unit / {net.send[conn]}")
}

test "a declared type's labels and effects print in their places, unify as arguments and fill its fields" {
  let send = |r: Resource| { effect: b"net", resource: r, mode: WriteMode, op: Some(b"send") };
  let held = |label: Type, effects: Effects|
    NamedType({ name: b"m.Sink", args: applied_args([int_type()], [label], [effects]) });
  let open = held(VariableType(1), open_effects(2));
  let conn = held(label_type(b"conn"), single_effect(send(NamedResource(b"conn"))));
  assert_eq(type_text(open), b"m.Sink<Int, [l] | e>");
  assert_eq(type_text(conn), b"m.Sink<Int, [conn] | {net.send[conn]}>");
  assert_eq(
    type_text(NamedType({ name: b"m.Box", args: applied_args([], [], [no_effects()]) })),
    b"m.Box<| {}>",
  );
  let fresh = { next_type: 3, next_effect_variable: 3 };
  let u = unify(substitution_new(), fresh, open, conn);
  assert(u.error == None);
  assert_eq(type_text(resolve_type(u.substitution, open)), type_text(conn));
  let narrower = unify(substitution_new(), fresh, conn, held(label_type(b"conn"), no_effects()));
  assert(match narrower.error { Some(EffectsMismatch(_)) -> true, _ -> false });
  let elsewhere = unify(
    substitution_new(),
    fresh,
    conn,
    held(label_type(b"peer"), open_effects(2)),
  );
  assert(match elsewhere.error {
    Some(Mismatch(m)) -> type_text(m.expected) == b"[conn]" && type_text(m.found) == b"[peer]",
    _ -> false,
  });
  let field = fn_type([VariableType(0)], open, {
    listed: [send(ResourceVariable(1))],
    variable: Some(2),
  });
  assert_eq(
    type_text(
      apply_arguments(
        field,
        [0, 1],
        [2],
        applied_args([VariableType(5)], [label_type(b"conn")], [
          { listed: [send(ResourceVariable(1))], variable: Some(2) },
        ]),
      ),
    ),
    b"(a) -> m.Sink<Int, [conn] | {net.send[l] | e}> / {net.send[conn], net.send[l] | e}",
  )
}

test "a `new` record's labels and effects print, unify and fill its fields as a sum's do" {
  let send = |r: Resource| { effect: b"net", resource: r, mode: WriteMode, op: Some(b"send") };
  let held = |label: Type, effects: Effects|
    NominalType({
      name: b"m.Feed",
      args: applied_args([int_type()], [label], [effects]),
      fields: [{ name: b"send", ty: fn_type([int_type()], unit_type(), effects) }],
    });
  let open = held(VariableType(1), { listed: [send(ResourceVariable(1))], variable: Some(2) });
  let conn = held(label_type(b"conn"), single_effect(send(NamedResource(b"conn"))));
  assert_eq(type_text(open), b"m.Feed<Int, [l] | {net.send[l] | e}>");
  let used = apply_arguments(
    held(VariableType(1), open_effects(2)),
    [1],
    [2],
    applied_args([], [label_type(b"conn")], [single_effect(send(NamedResource(b"conn")))]),
  );
  assert_eq(type_text(used), b"m.Feed<Int, [conn] | {net.send[conn]}>");
  assert_eq(match used { NominalType(n) -> n.fields.map(|f: Field| type_text(f.ty)), _ -> [] }, [
    b"(Int) -> Unit / {net.send[conn]}",
  ]);
  let fresh = { next_type: 3, next_effect_variable: 3 };
  assert(unify(substitution_new(), fresh, used, conn).error == None);
  let narrower = unify(substitution_new(), fresh, conn, held(label_type(b"conn"), no_effects()));
  assert(match narrower.error { Some(EffectsMismatch(_)) -> true, _ -> false });
  let elsewhere = unify(
    substitution_new(),
    fresh,
    conn,
    held(label_type(b"peer"), open_effects(2)),
  );
  assert(match elsewhere.error { Some(Mismatch(_)) -> true, _ -> false })
}

test "generalization skips what the environment still reaches" {
  let f0 = fresh_new();
  let a = fresh_type(f0);
  let b = fresh_type(a.fresh);
  let env = env_bind_global(env_new(), b"outer", monomorphic(a.ty));
  let g = generalize(substitution_new(), env, fn_type([a.ty], b.ty, no_effects()));
  assert_eq(g.scheme.type_variables.len(), 1)
}

test "types stored once read back as they were, each part they share stored once" {
  let span = RecordType([{ name: b"end", ty: int_type() }, { name: b"start", ty: int_type() }]);
  let point = NominalType({ name: b"m.Point", args: [], fields: [{ name: b"x", ty: int_type() }] });
  let types = [
    fn_type([span, list_type(span)], span, no_effects()),
    RecordType([{ name: b"at", ty: span }, { name: b"name", ty: bytes_type() }]),
    VariableType(3),
    span,
    list_type(point),
    point,
    NominalType({ name: b"m.Point", args: [], fields: [] }),
  ];
  let h = intern_types(types);
  let back = types_of(h.labels);
  assert_eq(h.at.map(|i: Int| back.get(i)), types);
  assert_eq(h.labels.len(), 10)
}

test "a type table reads back each type stored in it, and stores a type met again once" {
  let span = RecordType([{ name: b"end", ty: int_type() }, { name: b"start", ty: int_type() }]);
  let point = NominalType({ name: b"m.Point", args: [], fields: [{ name: b"at", ty: span }] });
  let types = [
    fn_type([span, point], list_type(point), no_effects()),
    point,
    VariableType(2),
    span,
  ];
  let held = types.fold(
    { table: Map::new(), keys: [] },
    |acc: { table: TypeTable, keys: List<Bytes> }, ty: Type| {
      let h = insert_type(acc.table, ty);
      { table: h.table, keys: acc.keys.push(h.key) }
    },
  );
  assert_eq(held.keys.map(|k: Bytes| type_at(held.table, k, Map::new()).ty), types);
  let again = insert_type(held.table, point);
  assert_eq(again.key, insert_type(Map::new(), point).key);
  assert_eq(again.table, held.table);
  assert_eq(held.table.len(), 6)
}

test "a part of what many types store together is those types stored alone" {
  let span = RecordType([{ name: b"end", ty: int_type() }, { name: b"start", ty: int_type() }]);
  let point = NominalType({ name: b"m.Point", args: [], fields: [{ name: b"x", ty: span }] });
  let first = [list_type(point), bytes_type()];
  let second = [fn_type([span, point], int_type(), no_effects()), point, list_type(point)];
  let a = intern_more_types(empty_interner(), first);
  let b = intern_more_types(a.h, second);
  assert_eq(interned_subset(b.h, b.at), intern_types(second));
  assert_eq(interned_subset(b.h, a.at), intern_types(first))
}

pub fn encode_type(ty: Type) -> Bytes =
  match ty {
    VariableType(v) -> if v < 0 { b"?" } else { b"'".concat(ascii_of_int(v)) },
    NamedType(c) -> encode_named_type(c.name, c.args),
    RecordType(fs) -> encode_fields(fs),
    NominalType(x) -> encode_named_type(x.name, x.args).concat(encode_fields(x.fields)),
    FunctionType(_) -> b"_",
  }

fn encode_named_type(name: Bytes, args: List<Type>) -> Bytes = {
  let n = if [b",", b"<", b">", b"{", b"}", b":", b"|", b"@", b"?", b"'", b"#", b" "].fold(
      false,
      |marked: Bool, d: Bytes| marked || name.index_of(d) != None,
    ) { Bytes::concat_all([b"\"", name, b"\""]) }
  else { name };
  if args.len() == 0 { n }
  else { Bytes::concat_all([n, b"<", Bytes::join(args.map(encode_type), b","), b">"]) }
}

fn type_name_byte(c: Int) -> Bool = is_identifier_continue(c) || c == 46

fn encode_fields(fs: List<Field>) -> Bytes =
  Bytes::concat_all([
    b"{",
    Bytes::join(fs.map(|f: Field| Bytes::concat_all([f.name, b":", encode_type(f.ty)])), b","),
    b"}",
  ])

pub fn decode_type(s: Bytes) -> Option<Type> / {abort.raise} =
  match read_type(s, 0, 2 * s.len() + 2) {
    Some(r) -> if r.at == s.len() { Some(r.ty) } else { None },
    None -> None,
  }

fn read_type(s: Bytes, at: Int, budget: Int) -> Option<{ ty: Type, at: Int }> / {abort.raise} =
  if budget <= 0 || at >= s.len() { None }
  else if s.at(at) == 63 { Some({ ty: VariableType(0 - 1), at: at + 1 }) } else if s.at(at) == 39 {
    let end = digits_end(s, at + 1);
    if end == at + 1 { None }
    else { Some({ ty: VariableType(digits(s.slice(at + 1, end))), at: end }) }
  } else if s.at(at) == 123 {
    match read_fields(s, at + 1, [], budget - 1) {
      Some(r) -> Some({ ty: RecordType(r.fields), at: r.at }),
      None -> None,
    }
  } else {
    let quoted = s.at(at) == 34;
    let end = if quoted {
      match s.slice(at + 1, s.len()).index_of(b"\"") { Some(k) -> at + 2 + k, None -> at }
    } else { type_name_end(s, at) };
    let name = if quoted { s.slice(at + 1, end - 1) } else { s.slice(at, end) };
    if end == at || name.len() == 0 { None } else {
      match if end < s.len() && s.at(end) == 60 { read_args(s, end + 1, [], budget - 1) }
        else { Some({ args: [], at: end }) } {
        None -> None,
        Some(r) -> if r.at < s.len() && s.at(r.at) == 123 {
          match read_fields(s, r.at + 1, [], budget - 1) {
            Some(f) ->
              Some({ ty: NominalType({ name: name, args: r.args, fields: f.fields }), at: f.at }),
            None -> None,
          }
        } else { Some({ ty: NamedType({ name: name, args: r.args }), at: r.at }) },
      }
    }
  }

fn type_name_end(s: Bytes, at: Int) -> Int / {abort.raise} =
  if at < s.len() && type_name_byte(s.at(at)) { type_name_end(s, at + 1) } else { at }

fn read_args(
  s: Bytes,
  at: Int,
  acc: List<Type>,
  budget: Int,
) -> Option<{ args: List<Type>, at: Int }> / {abort.raise} =
  if budget <= 0 { None } else {
    match read_type(s, at, budget - 1) {
      None -> None,
      Some(r) -> if r.at >= s.len() { None }
      else if s.at(r.at) == 44 { read_args(s, r.at + 1, acc.push(r.ty), budget - 1) }
      else if s.at(r.at) == 62 { Some({ args: acc.push(r.ty), at: r.at + 1 }) }
      else { None },
    }
  }

fn read_fields(
  s: Bytes,
  at: Int,
  acc: List<Field>,
  budget: Int,
) -> Option<{ fields: List<Field>, at: Int }> / {abort.raise} =
  if budget <= 0 { None }
  else if at < s.len() && s.at(at) == 125 && acc.len() == 0 { Some({ fields: acc, at: at + 1 }) }
  else {
    let end = name_end(s, at);
    if end == at || end >= s.len() || s.at(end) != 58 { None } else {
      match read_type(s, end + 1, budget - 1) {
        None -> None,
        Some(r) -> {
          let fields = acc.push({ name: s.slice(at, end), ty: r.ty });
          if r.at >= s.len() { None }
          else if s.at(r.at) == 44 { read_fields(s, r.at + 1, fields, budget - 1) }
          else if s.at(r.at) == 125 { Some({ fields: fields, at: r.at + 1 }) }
          else { None }
        },
      }
    }
  }

fn digits_end(s: Bytes, at: Int) -> Int / {abort.raise} =
  if at < s.len() && s.at(at) >= 48 && s.at(at) <= 57 { digits_end(s, at + 1) } else { at }

fn name_end(s: Bytes, at: Int) -> Int / {abort.raise} =
  if at < s.len() && is_identifier_continue(s.at(at)) { name_end(s, at + 1) } else { at }

pub fn digits(b: Bytes) -> Int =
  range(0, b.len()).fold(0, |acc: Int, i: Int| acc * 10 + b.at(i) - 48)
