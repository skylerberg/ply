//! The types and constructors the compiler names: the language's built-in types, the prelude's
//! node types and the constructors of the built-in sums. Each type has a constructor that builds it
//! and a recogniser that returns its parts, so no other module spells their names.

import compiler.check.types (Type, VariableType, NamedType, FunctionType, RecordType, NominalType,
                             Field, named_type, applied_type, label_type, is_covariant_container,
                             type_text, int_type, bool_type, string_type, bytes_type, float_type,
                             decimal_type, unit_type, list_type, option_type, map_type, iter_type,
                             secret_type)
import compiler.check.resolve.tables (qualify)
import compiler.syntax.exprs (prelude_module)
import compiler.syntax.items (Item, TypeItem, ExternBody, parse)
import std.prelude_source

// --- Names ---------------------------------------------------------------------------------------

/// The name of a type `check/types.ply` builds, read off its constructor so it is spelled once.
fn name_of(ty: Type) -> Bytes = match ty { NamedType(c) -> c.name, _ -> b"" }

pub fn int_name() -> Bytes = name_of(int_type())
pub fn bool_name() -> Bytes = name_of(bool_type())
pub fn string_name() -> Bytes = name_of(string_type())
pub fn bytes_name() -> Bytes = name_of(bytes_type())
pub fn float_name() -> Bytes = name_of(float_type())
pub fn decimal_name() -> Bytes = name_of(decimal_type())
pub fn unit_name() -> Bytes = name_of(unit_type())
pub fn list_name() -> Bytes = name_of(list_type(unit_type()))
pub fn option_name() -> Bytes = name_of(option_type(unit_type()))
pub fn map_name() -> Bytes = name_of(map_type(unit_type(), unit_type()))
pub fn iter_name() -> Bytes = name_of(iter_type(unit_type(), unit_type()))
pub fn secret_name() -> Bytes = name_of(secret_type(unit_type()))
pub fn char_name() -> Bytes = b"Char"
pub fn ordering_name() -> Bytes = b"Ordering"
pub fn rounding_name() -> Bytes = b"Rounding"
pub fn instant_name() -> Bytes = b"Instant"
pub fn duration_name() -> Bytes = b"Duration"
pub fn array_name() -> Bytes = b"Array"
pub fn columns_name() -> Bytes = b"Columns"
pub fn hold_name() -> Bytes = b"Hold"
pub fn task_name() -> Bytes = b"Task"
pub fn chan_name() -> Bytes = b"Chan"
pub fn result_name() -> Bytes = b"Result"

/// The fixed-width integer types, in the runtime's numbering of widths.
pub fn fixed_widths() -> List<{ name: Bytes, bits: Int, signed: Bool }> =
  [
    { name: b"U8", bits: 8, signed: false },
    { name: b"U16", bits: 16, signed: false },
    { name: b"U32", bits: 32, signed: false },
    { name: b"U64", bits: 64, signed: false },
    { name: b"I8", bits: 8, signed: true },
    { name: b"I16", bits: 16, signed: true },
    { name: b"I32", bits: 32, signed: true },
    { name: b"I64", bits: 64, signed: true },
    { name: b"U128", bits: 128, signed: false },
    { name: b"I128", bits: 128, signed: true },
  ]

/// Whether `name` is a fixed-width integer type's.
pub fn is_fixed_width_name(name: Bytes) -> Bool =
  fixed_widths().any(|w: { name: Bytes, bits: Int, signed: Bool }| w.name == name)

/// `Int` and the fixed widths: the integer types, the only ones the bit operators are defined at.
pub fn is_integer_name(name: Bytes) -> Bool = name == int_name() || is_fixed_width_name(name)

/// The name the checker gives a type the prelude declares: a program's own type of the bare name is
/// another type.
fn prelude_type_name(bare: Bytes) -> Bytes = qualify(prelude_module(), bare)

/// A node of a list's trie, an extern type the prelude declares.
pub fn list_node_name() -> Bytes = prelude_type_name(b"ListNode")

/// A node of a map's tree, an extern type the prelude declares.
pub fn map_node_name() -> Bytes = prelude_type_name(b"MapNode")

// --- What the checker declares -------------------------------------------------------------------

/// The language's own types, each with how many type arguments it takes. A label is no type
/// argument: a `Hold`'s region label rides before the one type it takes.
pub fn builtin_types() -> List<{ name: Bytes, arity: Int }> =
  [
    { name: int_name(), arity: 0 },
    { name: bool_name(), arity: 0 },
    { name: string_name(), arity: 0 },
    { name: bytes_name(), arity: 0 },
  ].concat(
    fixed_widths().map(|w: { name: Bytes, bits: Int, signed: Bool }| { name: w.name, arity: 0 }),
  ).concat([
    { name: float_name(), arity: 0 },
    { name: decimal_name(), arity: 0 },
    { name: char_name(), arity: 0 },
    { name: unit_name(), arity: 0 },
    { name: list_name(), arity: 1 },
    { name: array_name(), arity: 1 },
    { name: columns_name(), arity: 1 },
    { name: map_name(), arity: 2 },
    { name: hold_name(), arity: 1 },
    { name: secret_name(), arity: 1 },
    { name: task_name(), arity: 1 },
    { name: chan_name(), arity: 1 },
    { name: option_name(), arity: 1 },
    { name: result_name(), arity: 2 },
    { name: ordering_name(), arity: 0 },
    { name: rounding_name(), arity: 0 },
    { name: iter_name(), arity: 2 },
    { name: instant_name(), arity: 0 },
    { name: duration_name(), arity: 0 },
  ])

pub fn some_ctor() -> Bytes = b"Some"
pub fn none_ctor() -> Bytes = b"None"
pub fn ok_ctor() -> Bytes = b"Ok"
pub fn err_ctor() -> Bytes = b"Err"
pub fn less_ctor() -> Bytes = b"Less"
pub fn equal_ctor() -> Bytes = b"Equal"
pub fn greater_ctor() -> Bytes = b"Greater"
pub fn continue_ctor() -> Bytes = b"Continue"
pub fn stop_ctor() -> Bytes = b"Stop"

/// A sum the language builds in. A field names one of `params`, or else a built-in type.
pub type BuiltinSum = {
  name: Bytes,
  params: List<Bytes>,
  variants: List<{ name: Bytes, fields: List<Bytes> }>,
}

/// The built-in sums, each constructor in the order its index numbers it.
pub fn builtin_sums() -> List<BuiltinSum> =
  [
    {
      name: option_name(),
      params: [b"a"],
      variants: [{ name: none_ctor(), fields: [] }, { name: some_ctor(), fields: [b"a"] }],
    },
    {
      name: result_name(),
      params: [b"a", b"e"],
      variants: [{ name: ok_ctor(), fields: [b"a"] }, { name: err_ctor(), fields: [b"e"] }],
    },
    {
      name: ordering_name(),
      params: [],
      variants: [
        { name: less_ctor(), fields: [] },
        { name: equal_ctor(), fields: [] },
        { name: greater_ctor(), fields: [] },
      ],
    },
    {
      name: rounding_name(),
      params: [],
      variants: [
        { name: b"HalfEven", fields: [] },
        { name: b"HalfUp", fields: [] },
        { name: b"Down", fields: [] },
        { name: b"Up", fields: [] },
        { name: b"Ceiling", fields: [] },
        { name: b"Floor", fields: [] },
      ],
    },
    {
      name: iter_name(),
      params: [b"s", b"r"],
      variants: [{ name: continue_ctor(), fields: [b"s"] }, { name: stop_ctor(), fields: [b"r"] }],
    },
    // Nanoseconds: a point on a clock, and a span between two points, kept apart by their types.
    {
      name: instant_name(),
      params: [],
      variants: [{ name: instant_name(), fields: [int_name()] }],
    },
    {
      name: duration_name(),
      params: [],
      variants: [{ name: duration_name(), fields: [int_name()] }],
    },
  ]

/// The built-in sum constructor `name` belongs to, and its place among the sum's; none for a name
/// no built-in sum holds.
pub fn builtin_ctor_at(name: Bytes) -> Option<{ sum: Bytes, case: Int }> =
  builtin_sums().fold(None, |acc: Option<{ sum: Bytes, case: Int }>, s: BuiltinSum|
    match acc {
      Some(_) -> acc,
      None -> match range(0, s.variants.len()).find(|i: Int|
          match s.variants.at(i) { Some(v) -> v.name == name, None -> false }) {
        Some(i) -> Some({ sum: s.name, case: i }),
        None -> None,
      },
    })

// --- Constructors --------------------------------------------------------------------------------

pub fn char_type() -> Type = named_type(char_name())
pub fn ordering_type() -> Type = named_type(ordering_name())
pub fn instant_type() -> Type = named_type(instant_name())
pub fn duration_type() -> Type = named_type(duration_name())
pub fn array_type(element: Type) -> Type = applied_type(array_name(), element)

/// `row` is the record each entry is.
pub fn columns_type(row: Type) -> Type = applied_type(columns_name(), row)

/// `label` is the region's label type, which the checker lays before the type held.
pub fn hold_type(label: Type, held: Type) -> Type =
  NamedType({ name: hold_name(), args: [label, held] })
pub fn task_type(answer: Type) -> Type = applied_type(task_name(), answer)
pub fn chan_type(item: Type) -> Type = applied_type(chan_name(), item)
pub fn result_type(ok: Type, error: Type) -> Type =
  NamedType({ name: result_name(), args: [ok, error] })
pub fn list_node_type(item: Type) -> Type = applied_type(list_node_name(), item)
pub fn map_node_type(key: Type, value: Type) -> Type =
  NamedType({ name: map_node_name(), args: [key, value] })

/// Raises where no fixed-width type is `width` wide.
pub fn width_type(width: { bits: Int, signed: Bool }) -> Type / {abort.raise} =
  match width_named(width) { Some(n) -> named_type(n), None -> panic("a fixed width") }

/// The fixed-width type `width` wide, where one is.
pub fn width_named(width: { bits: Int, signed: Bool }) -> Option<Bytes> =
  match fixed_widths().find(|w: { name: Bytes, bits: Int, signed: Bool }|
      w.bits == width.bits && w.signed == width.signed) {
    Some(w) -> Some(w.name),
    None -> None,
  }

// --- Recognisers ---------------------------------------------------------------------------------

/// The arguments of `ty` where it is the type named `name`, and none otherwise.
fn args_named(ty: Type, name: Bytes) -> List<Type> =
  match ty { NamedType(c) -> if c.name == name { c.args } else { [] }, _ -> [] }

fn only_arg(ty: Type, name: Bytes) -> Option<Type> =
  match args_named(ty, name) { [t] -> Some(t), _ -> None }

fn is_named(ty: Type, name: Bytes) -> Bool =
  match ty { NamedType(c) -> c.name == name && c.args.len() == 0, _ -> false }

pub fn is_int(ty: Type) -> Bool = is_named(ty, int_name())
pub fn is_bool(ty: Type) -> Bool = is_named(ty, bool_name())
pub fn is_string(ty: Type) -> Bool = is_named(ty, string_name())
pub fn is_bytes(ty: Type) -> Bool = is_named(ty, bytes_name())
pub fn is_float(ty: Type) -> Bool = is_named(ty, float_name())
pub fn is_decimal(ty: Type) -> Bool = is_named(ty, decimal_name())
pub fn is_char(ty: Type) -> Bool = is_named(ty, char_name())
pub fn is_unit(ty: Type) -> Bool = is_named(ty, unit_name())

pub fn list_item(ty: Type) -> Option<Type> = only_arg(ty, list_name())
pub fn array_element(ty: Type) -> Option<Type> = only_arg(ty, array_name())
pub fn columns_row(ty: Type) -> Option<Type> = only_arg(ty, columns_name())
pub fn option_item(ty: Type) -> Option<Type> = only_arg(ty, option_name())
pub fn secret_item(ty: Type) -> Option<Type> = only_arg(ty, secret_name())
pub fn task_answer(ty: Type) -> Option<Type> = only_arg(ty, task_name())
pub fn chan_item(ty: Type) -> Option<Type> = only_arg(ty, chan_name())
pub fn list_node_item(ty: Type) -> Option<Type> = only_arg(ty, list_node_name())

pub fn hold_parts(ty: Type) -> Option<{ label: Type, held: Type }> =
  match args_named(ty, hold_name()) { [l, h] -> Some({ label: l, held: h }), _ -> None }

pub fn map_parts(ty: Type) -> Option<{ key: Type, value: Type }> =
  match args_named(ty, map_name()) { [k, v] -> Some({ key: k, value: v }), _ -> None }

pub fn map_node_parts(ty: Type) -> Option<{ key: Type, value: Type }> =
  match args_named(ty, map_node_name()) { [k, v] -> Some({ key: k, value: v }), _ -> None }

pub fn result_parts(ty: Type) -> Option<{ ok: Type, error: Type }> =
  match args_named(ty, result_name()) { [o, e] -> Some({ ok: o, error: e }), _ -> None }

pub fn iter_parts(ty: Type) -> Option<{ state: Type, result: Type }> =
  match args_named(ty, iter_name()) { [s, r] -> Some({ state: s, result: r }), _ -> None }

/// Whether `ty` names a `Secret` anywhere in it.
pub fn mentions_secret(ty: Type) -> Bool =
  match ty {
    NamedType(c) ->
      c.name == secret_name() || c.args.fold(false, |acc: Bool, a: Type| acc || mentions_secret(a)),
    FunctionType(f) ->
      f.params.fold(false, |acc: Bool, p: Type| acc || mentions_secret(p))
        || mentions_secret(f.ret),
    RecordType(fs) -> fs.fold(false, |acc: Bool, f: Field| acc || mentions_secret(f.ty)),
    NominalType(n) -> n.fields.fold(false, |acc: Bool, f: Field| acc || mentions_secret(f.ty)),
    VariableType(_) -> false,
  }

// --- Tests ---------------------------------------------------------------------------------------

/// One type of each kind this module and `check/types.ply` build.
fn built() -> List<Type> / {abort.raise} = {
  let a = VariableType(0);
  let b = VariableType(1);
  [
    int_type(),
    bool_type(),
    string_type(),
    bytes_type(),
    float_type(),
    decimal_type(),
    unit_type(),
    char_type(),
    ordering_type(),
    instant_type(),
    duration_type(),
    list_type(a),
    option_type(a),
    map_type(a, b),
    iter_type(a, b),
    secret_type(a),
    array_type(a),
    columns_type(a),
    hold_type(label_type(b"l"), a),
    task_type(a),
    chan_type(a),
    result_type(a, b),
    list_node_type(a),
    map_node_type(a, b),
  ].concat(
    fixed_widths().map(|w: { name: Bytes, bits: Int, signed: Bool }|
      width_type({ bits: w.bits, signed: w.signed })),
  )
}

fn arity_declared(declared: List<{ name: Bytes, arity: Int }>, name: Bytes) -> Option<Int> =
  declared.find_map(|d: { name: Bytes, arity: Int }|
    if d.name == name { Some(d.arity) } else { None })

/// The `extern type`s the prelude source declares, each with how many type parameters it takes.
fn prelude_externs() -> List<{ name: Bytes, arity: Int }> / {abort.raise} =
  parse(prelude_source::text()).node.items.fold(
    [],
    |acc: List<{ name: Bytes, arity: Int }>, item: Item|
      match item {
        TypeItem(d) -> match d.body {
          ExternBody -> acc.push({ name: d.name.name, arity: d.generics.types.len() }),
          _ -> acc,
        },
        _ -> acc,
      },
  )

test "each type built is one the checker or the prelude declares, at the arity it is built at" {
  let prelude = prelude_externs().map(|e: { name: Bytes, arity: Int }|
    { name: prelude_type_name(e.name), arity: e.arity });
  let declared = builtin_types().concat(prelude);
  // A hold's region label is no type argument.
  let labels = |t: Type| match hold_parts(t) { Some(_) -> 1, None -> 0 };
  let undeclared = built().filter(|t: Type|
    match t {
      NamedType(c) -> arity_declared(declared, c.name) != Some(c.args.len() - labels(t)),
      _ -> true,
    });
  assert_eq(undeclared.map(type_text), [])
}

test "each recogniser returns the parts its constructor built" {
  let a = int_type();
  let b = string_type();
  let l = label_type(b"l");
  assert_eq(list_item(list_type(a)), Some(a));
  assert_eq(array_element(array_type(a)), Some(a));
  assert_eq(columns_row(columns_type(a)), Some(a));
  assert_eq(option_item(option_type(a)), Some(a));
  assert_eq(secret_item(secret_type(a)), Some(a));
  assert_eq(task_answer(task_type(a)), Some(a));
  assert_eq(chan_item(chan_type(a)), Some(a));
  assert_eq(list_node_item(list_node_type(a)), Some(a));
  assert_eq(hold_parts(hold_type(l, a)), Some({ label: l, held: a }));
  assert_eq(map_parts(map_type(a, b)), Some({ key: a, value: b }));
  assert_eq(map_node_parts(map_node_type(a, b)), Some({ key: a, value: b }));
  assert_eq(result_parts(result_type(a, b)), Some({ ok: a, error: b }));
  assert_eq(iter_parts(iter_type(a, b)), Some({ state: a, result: b }));
  assert_eq(list_item(array_type(a)), None);
  assert(is_char(char_type()) && !is_char(list_type(char_type())), None);
  assert_eq(
    fixed_widths().map(|w: { name: Bytes, bits: Int, signed: Bool }|
      name_of(width_type({ bits: w.bits, signed: w.signed }))),
    fixed_widths().map(|w: { name: Bytes, bits: Int, signed: Bool }| w.name),
  )
}

test "the containers check/types.ply unifies covariantly and prints are the ones built here" {
  let a = int_type();
  let hold = hold_type(label_type(b"l"), a);
  let containers = [
    list_type(a),
    array_type(a),
    columns_type(a),
    option_type(a),
    result_type(a, a),
    map_type(a, a),
    iter_type(a, a),
    hold,
  ];
  assert_eq(containers.filter(|t: Type| !is_covariant_container(name_of(t))).map(type_text), []);
  assert(type_text(hold).starts_with(b"Hold<Int, ["), None)
}
