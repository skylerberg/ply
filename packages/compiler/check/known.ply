import compiler.check.types (Type, VariableType, NamedType, FunctionType, RecordType, NominalType,
                             Field, named_type, applied_type, label_type, is_covariant_container,
                             type_text, int_type, bool_type, string_type, bytes_type, float_type,
                             decimal_type, unit_type, list_type, option_type, map_type, iter_type,
                             secret_type)
import compiler.check.resolve.tables (qualify)
import compiler.syntax.expressions (prelude_module)
import compiler.syntax.items (Item, TypeItem, ExternBody, parse)
import compiler.prelude_source

pub fn name_of(ty: Type) -> Bytes = match ty { NamedType(c) -> c.name, _ -> b"" }

pub const int_name: Bytes = name_of(int_type)
pub const bool_name: Bytes = name_of(bool_type)
pub const string_name: Bytes = name_of(string_type)
pub const bytes_name: Bytes = name_of(bytes_type)
pub const float_name: Bytes = name_of(float_type)
pub const decimal_name: Bytes = name_of(decimal_type)
pub const unit_name: Bytes = name_of(unit_type)
pub const list_name: Bytes = name_of(list_type(unit_type))
pub const option_name: Bytes = name_of(option_type(unit_type))
pub const map_name: Bytes = name_of(map_type(unit_type, unit_type))
pub const iterator_name: Bytes = name_of(iter_type(unit_type, unit_type))
pub const secret_name: Bytes = name_of(secret_type(unit_type))
pub const char_name: Bytes = b"Char"
pub const ordering_name: Bytes = b"Ordering"
pub const rounding_name: Bytes = b"Rounding"
pub const instant_name: Bytes = b"Instant"
pub const duration_name: Bytes = b"Duration"
pub const array_name: Bytes = b"Array"
pub const columns_name: Bytes = b"Columns"
pub const scoped_name: Bytes = b"Scoped"
pub const task_name: Bytes = b"Task"
pub const builtin_channel_name: Bytes = b"Chan"
pub const result_name: Bytes = b"Result"

pub const fixed_widths: List<{ name: Bytes, bits: Int, signed: Bool }> =
  [
    { name: b"U8", bits: 8, signed: false },
    { name: b"U16", bits: 16, signed: false },
    { name: b"U32", bits: 32, signed: false },
    { name: b"U64", bits: 64, signed: false },
    { name: b"I8", bits: 8, signed: true },
    { name: b"I16", bits: 16, signed: true },
    { name: b"I32", bits: 32, signed: true },
    { name: b"I64", bits: 64, signed: true },
    { name: b"U128", bits: 128, signed: false },
    { name: b"I128", bits: 128, signed: true },
  ]

pub fn is_fixed_width_name(name: Bytes) -> Bool =
  fixed_widths.any(|w: { name: Bytes, bits: Int, signed: Bool }| w.name == name)

pub fn is_integer_name(name: Bytes) -> Bool = name == int_name || is_fixed_width_name(name)

pub fn prelude_type_name(bare: Bytes) -> Bytes = qualify(prelude_module, bare)

pub const map_node_name: Bytes = prelude_type_name(b"MapNode")

pub const builtin_types: List<{ name: Bytes, arity: Int }> =
  [
    { name: int_name, arity: 0 },
    { name: bool_name, arity: 0 },
    { name: string_name, arity: 0 },
    { name: bytes_name, arity: 0 },
  ].concat(
    fixed_widths.map(|w: { name: Bytes, bits: Int, signed: Bool }| { name: w.name, arity: 0 }),
  ).concat([
    { name: float_name, arity: 0 },
    { name: decimal_name, arity: 0 },
    { name: char_name, arity: 0 },
    { name: unit_name, arity: 0 },
    { name: list_name, arity: 1 },
    { name: array_name, arity: 1 },
    { name: columns_name, arity: 1 },
    { name: map_name, arity: 2 },
    { name: scoped_name, arity: 1 },
    { name: secret_name, arity: 1 },
    { name: task_name, arity: 1 },
    { name: builtin_channel_name, arity: 1 },
    { name: option_name, arity: 1 },
    { name: result_name, arity: 2 },
    { name: ordering_name, arity: 0 },
    { name: rounding_name, arity: 0 },
    { name: iterator_name, arity: 2 },
    { name: instant_name, arity: 0 },
    { name: duration_name, arity: 0 },
  ])

pub const some_constructor: Bytes = b"Some"
pub const none_constructor: Bytes = b"None"
pub const ok_constructor: Bytes = b"Ok"
pub const err_constructor: Bytes = b"Err"
pub const less_constructor: Bytes = b"Less"
pub const equal_constructor: Bytes = b"Equal"
pub const greater_constructor: Bytes = b"Greater"
pub const continue_constructor: Bytes = b"Continue"
pub const stop_constructor: Bytes = b"Stop"

pub type BuiltinSum = {
  name: Bytes,
  params: List<Bytes>,
  variants: List<{ name: Bytes, fields: List<Bytes> }>,
}

pub const builtin_sums: List<BuiltinSum> =
  [
    {
      name: option_name,
      params: [b"a"],
      variants: [
        { name: none_constructor, fields: [] },
        { name: some_constructor, fields: [b"a"] },
      ],
    },
    {
      name: result_name,
      params: [b"a", b"e"],
      variants: [
        { name: ok_constructor, fields: [b"a"] },
        { name: err_constructor, fields: [b"e"] },
      ],
    },
    {
      name: ordering_name,
      params: [],
      variants: [
        { name: less_constructor, fields: [] },
        { name: equal_constructor, fields: [] },
        { name: greater_constructor, fields: [] },
      ],
    },
    {
      name: rounding_name,
      params: [],
      variants: [
        { name: b"HalfEven", fields: [] },
        { name: b"HalfUp", fields: [] },
        { name: b"Down", fields: [] },
        { name: b"Up", fields: [] },
        { name: b"Ceiling", fields: [] },
        { name: b"Floor", fields: [] },
      ],
    },
    {
      name: iterator_name,
      params: [b"s", b"r"],
      variants: [
        { name: continue_constructor, fields: [b"s"] },
        { name: stop_constructor, fields: [b"r"] },
      ],
    },
    { name: instant_name, params: [], variants: [{ name: instant_name, fields: [int_name] }] },
    { name: duration_name, params: [], variants: [{ name: duration_name, fields: [int_name] }] },
  ]

pub fn builtin_constructor_at(name: Bytes) -> Option<{ sum: Bytes, case: Int }> =
  builtin_sums.fold(None, |accumulator: Option<{ sum: Bytes, case: Int }>, s: BuiltinSum|
    match accumulator {
      Some(_) -> accumulator,
      None -> match range(0, s.variants.len()).find(|i: Int|
          match s.variants.at(i) { Some(v) -> v.name == name, None -> false }) {
        Some(i) -> Some({ sum: s.name, case: i }),
        None -> None,
      },
    })

pub const char_type: Type = named_type(char_name)
pub const ordering_type: Type = named_type(ordering_name)
pub const instant_type: Type = named_type(instant_name)
pub const duration_type: Type = named_type(duration_name)
pub fn array_type(element: Type) -> Type = applied_type(array_name, element)

pub fn columns_type(row: Type) -> Type = applied_type(columns_name, row)

pub fn scoped_type(label: Type, contents: Type) -> Type =
  NamedType({ name: scoped_name, args: [label, contents] })
pub fn task_type(result: Type) -> Type = applied_type(task_name, result)
pub fn chan_type(item: Type) -> Type = applied_type(builtin_channel_name, item)
pub fn result_type(ok: Type, error: Type) -> Type =
  NamedType({ name: result_name, args: [ok, error] })
pub fn map_node_type(key: Type, value: Type) -> Type =
  NamedType({ name: map_node_name, args: [key, value] })

pub fn width_type(width: { bits: Int, signed: Bool }) -> Type / {abort.raise} =
  match width_named(width) { Some(n) -> named_type(n), None -> panic("a fixed width") }

pub fn width_named(width: { bits: Int, signed: Bool }) -> Option<Bytes> =
  match List::find(fixed_widths, |w: { name: Bytes, bits: Int, signed: Bool }|
      w.bits == width.bits && w.signed == width.signed) {
    Some(w) -> Some(w.name),
    None -> None,
  }

fn args_named(ty: Type, name: Bytes) -> List<Type> =
  match ty { NamedType(c) -> if c.name == name { c.args } else { [] }, _ -> [] }

fn only_arg(ty: Type, name: Bytes) -> Option<Type> =
  match args_named(ty, name) { [t] -> Some(t), _ -> None }

fn is_named(ty: Type, name: Bytes) -> Bool =
  match ty { NamedType(c) -> c.name == name && c.args.len() == 0, _ -> false }

pub fn is_int(ty: Type) -> Bool = is_named(ty, int_name)
pub fn is_bool(ty: Type) -> Bool = is_named(ty, bool_name)
pub fn is_string(ty: Type) -> Bool = is_named(ty, string_name)
pub fn is_bytes(ty: Type) -> Bool = is_named(ty, bytes_name)
pub fn is_float(ty: Type) -> Bool = is_named(ty, float_name)
pub fn is_decimal(ty: Type) -> Bool = is_named(ty, decimal_name)
pub fn is_char(ty: Type) -> Bool = is_named(ty, char_name)
pub fn is_unit(ty: Type) -> Bool = is_named(ty, unit_name)

pub fn list_item(ty: Type) -> Option<Type> = only_arg(ty, list_name)
pub fn array_element(ty: Type) -> Option<Type> = only_arg(ty, array_name)
pub fn columns_row(ty: Type) -> Option<Type> = only_arg(ty, columns_name)
pub fn option_item(ty: Type) -> Option<Type> = only_arg(ty, option_name)
pub fn secret_item(ty: Type) -> Option<Type> = only_arg(ty, secret_name)
pub fn task_result(ty: Type) -> Option<Type> = only_arg(ty, task_name)
pub fn chan_item(ty: Type) -> Option<Type> = only_arg(ty, builtin_channel_name)

pub fn scoped_parts(ty: Type) -> Option<{ label: Type, held: Type }> =
  match args_named(ty, scoped_name) { [l, h] -> Some({ label: l, held: h }), _ -> None }

pub fn map_parts(ty: Type) -> Option<{ key: Type, value: Type }> =
  match args_named(ty, map_name) { [k, v] -> Some({ key: k, value: v }), _ -> None }

pub fn map_node_parts(ty: Type) -> Option<{ key: Type, value: Type }> =
  match args_named(ty, map_node_name) { [k, v] -> Some({ key: k, value: v }), _ -> None }

pub fn result_parts(ty: Type) -> Option<{ ok: Type, error: Type }> =
  match args_named(ty, result_name) { [o, e] -> Some({ ok: o, error: e }), _ -> None }

pub fn iterator_parts(ty: Type) -> Option<{ state: Type, result: Type }> =
  match args_named(ty, iterator_name) { [s, r] -> Some({ state: s, result: r }), _ -> None }

pub fn mentions_secret(ty: Type) -> Bool =
  match ty {
    NamedType(c) ->
      c.name == secret_name
        || c.args.fold(false, |accumulator: Bool, a: Type| accumulator || mentions_secret(a)),
    FunctionType(f) ->
      f.params.fold(false, |accumulator: Bool, p: Type| accumulator || mentions_secret(p))
        || mentions_secret(f.return_type),
    RecordType(fs) ->
      fs.fold(false, |accumulator: Bool, f: Field| accumulator || mentions_secret(f.ty)),
    NominalType(n) ->
      n.fields.fold(false, |accumulator: Bool, f: Field| accumulator || mentions_secret(f.ty)),
    VariableType(_) -> false,
  }

const built: List<Type> = {
  let a = VariableType(0);
  let b = VariableType(1);
  [
    int_type,
    bool_type,
    string_type,
    bytes_type,
    float_type,
    decimal_type,
    unit_type,
    char_type,
    ordering_type,
    instant_type,
    duration_type,
    list_type(a),
    option_type(a),
    map_type(a, b),
    iter_type(a, b),
    secret_type(a),
    array_type(a),
    columns_type(a),
    scoped_type(label_type(b"l"), a),
    task_type(a),
    chan_type(a),
    result_type(a, b),
    map_node_type(a, b),
  ].concat(
    fixed_widths.map(|w: { name: Bytes, bits: Int, signed: Bool }|
      width_type({ bits: w.bits, signed: w.signed })),
  )
}

fn arity_declared(declared: List<{ name: Bytes, arity: Int }>, name: Bytes) -> Option<Int> =
  declared.find_map(|d: { name: Bytes, arity: Int }|
    if d.name == name { Some(d.arity) } else { None })

const prelude_externs: List<{ name: Bytes, arity: Int }> =
  parse(prelude_source::text).node.items.fold(
    [],
    |accumulator: List<{ name: Bytes, arity: Int }>, item: Item|
      match item {
        TypeItem(d) -> match d.body {
          ExternBody -> accumulator.push({ name: d.name.name, arity: d.generics.types.len() }),
          _ -> accumulator,
        },
        _ -> accumulator,
      },
  )

test "every type the compiler constructs is declared by the checker or the prelude, with the number of arguments it is constructed with" {
  let prelude = prelude_externs.map(|e: { name: Bytes, arity: Int }|
    { name: prelude_type_name(e.name), arity: e.arity });
  let declared = builtin_types.concat(prelude);
  let labels = |t: Type| match scoped_parts(t) { Some(_) -> 1, None -> 0 };
  let undeclared = built.filter(|t: Type|
    match t {
      NamedType(c) -> arity_declared(declared, c.name) != Some(c.args.len() - labels(t)),
      _ -> true,
    });
  assert_eq(undeclared.map(type_text), [])
}

test "each type accessor, such as `list_item`, returns the components its type constructor was given" {
  let a = int_type;
  let b = string_type;
  let l = label_type(b"l");
  assert_eq(list_item(list_type(a)), Some(a));
  assert_eq(array_element(array_type(a)), Some(a));
  assert_eq(columns_row(columns_type(a)), Some(a));
  assert_eq(option_item(option_type(a)), Some(a));
  assert_eq(secret_item(secret_type(a)), Some(a));
  assert_eq(task_result(task_type(a)), Some(a));
  assert_eq(chan_item(chan_type(a)), Some(a));
  assert_eq(scoped_parts(scoped_type(l, a)), Some({ label: l, held: a }));
  assert_eq(map_parts(map_type(a, b)), Some({ key: a, value: b }));
  assert_eq(map_node_parts(map_node_type(a, b)), Some({ key: a, value: b }));
  assert_eq(result_parts(result_type(a, b)), Some({ ok: a, error: b }));
  assert_eq(iterator_parts(iter_type(a, b)), Some({ state: a, result: b }));
  assert_eq(list_item(array_type(a)), None);
  assert(is_char(char_type) && !is_char(list_type(char_type)), None);
  assert_eq(
    fixed_widths.map(|w: { name: Bytes, bits: Int, signed: Bool }|
      name_of(width_type({ bits: w.bits, signed: w.signed }))),
    fixed_widths.map(|w: { name: Bytes, bits: Int, signed: Bool }| w.name),
  )
}

test "every container type built by the constructors is treated as covariant by `check/types.ply`, and a scoped type prints starting with `Scoped<Int, [`" {
  let a = int_type;
  let hold = scoped_type(label_type(b"l"), a);
  let containers = [
    list_type(a),
    array_type(a),
    columns_type(a),
    option_type(a),
    result_type(a, a),
    map_type(a, a),
    iter_type(a, a),
    hold,
  ];
  assert_eq(containers.filter(|t: Type| !is_covariant_container(name_of(t))).map(type_text), []);
  assert(type_text(hold).starts_with(b"Scoped<Int, ["), None)
}
