import std.list
import compiler.check.types (Atom, Scheme, Type, VariableType, InScope, unify, instantiate,
                             atoms_text, scheme_text, type_text)
import compiler.check.resolve.tables (Diagnostic, label_at)
import compiler.check.infer.checker (Checker, HoleSite, DefinitionInfo, report, resolve,
                                     module_name)

fn candidate_limit() -> Int = 8

fn global_scan_limit() -> Int = 512

pub fn hole_reports(checker: Checker) -> Checker / {abort.raise} =
  checker.holes.fold(checker, |c: Checker, site: HoleSite| report(c, hole_diagnostic(c, site)))

fn display_name(checker: Checker, site: HoleSite, d: DefinitionInfo) -> Bytes / {abort.raise} =
  if d.module == module_name(checker, site.module) || d.module == b"std.prelude" { d.simple_name }
  else { Bytes::concat_all([d.module, b"::", d.simple_name]) }

fn fits(checker: Checker, ty: Type, sc: Scheme) -> Bool / {abort.raise} = {
  let i = instantiate(sc, checker.fresh);
  unify(checker.substitution, i.fresh, ty, i.ty).error == None
}

fn candidates(checker: Checker, ty: Type, site: HoleSite) -> List<Bytes> / {abort.raise} = {
  let local = site.locals.fold([], |acc: List<Bytes>, l: InScope|
    if acc.len() >= candidate_limit() { acc } else if fits(checker, ty, l.sc) {
      acc.push(Bytes::concat_all([b"`", l.name, b": ", type_text(l.sc.ty), b"`"]))
    } else { acc });
  let out = checker.definitions.fold(
    { found: local, read: 0 },
    |acc: { found: List<Bytes>, read: Int }, d: DefinitionInfo|
      if acc.found.len() >= candidate_limit() || acc.read >= global_scan_limit() { acc } else {
        {
          found: if fits(checker, ty, d.scheme) {
            acc.found.push(
              Bytes::concat_all([
                b"`",
                display_name(checker, site, d),
                b": ",
                scheme_text(d.scheme),
                b"`",
              ]),
            )
          } else { acc.found },
          read: acc.read + 1,
        }
      },
  );
  out.found
}

fn row_note(checker: Checker, site: HoleSite) -> Bytes / {abort.raise} =
  match site.declared {
    None -> b"no effects are written where the hole stands; what the filling performs is inferred",
    Some(written) -> {
      let performed = match checker.definitions.find(|d: DefinitionInfo| d.name == site.owner) {
        Some(d) -> d.performed,
        None -> [],
      };
      if written.len() == 0 {
        b"the effects written where the hole stands are empty: it may perform nothing"
      } else {
        let already = written.filter(|a: Atom| performed.contains(a));
        Bytes::concat_all([
          b"the hole may perform `",
          atoms_text(written, b"`, `"),
          b"`",
          if already.len() == 0 { b"" } else {
            Bytes::concat_all([
              b"; the rest of the body already performs `",
              atoms_text(already, b"`, `"),
              b"`",
            ])
          },
        ])
      }
    },
  }

fn hole_diagnostic(checker: Checker, site: HoleSite) -> Diagnostic / {abort.raise} = {
  let ty = resolve(checker, VariableType(site.var));
  let label = match ty {
    VariableType(_) -> b"its type is unconstrained here",
    _ -> Bytes::concat_all([b"expected `", type_text(ty), b"`"]),
  };
  let found = match ty { VariableType(_) -> [], _ -> candidates(checker, ty, site) };
  let notes = [row_note(checker, site)].concat(if found.len() == 0 { [] }
  else { [Bytes::concat_all([b"in scope of that type: ", Bytes::join(found, b", ")])] }).concat([
    b"a run that reaches the hole raises `abort.raise`",
  ]);
  {
    code: b"W0613",
    notes: notes.len(),
    labels: [label_at(site.module, site.span, true, label)],
    text: b"",
    message: b"unfilled hole",
    notes_text: notes,
    severity: b"warning",
    fixes: [],
  }
}
