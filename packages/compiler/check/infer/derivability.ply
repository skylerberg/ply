import compiler.syntax.items (Deriver, EqDeriver, OrderingDeriver, ShowDeriver, HashDeriver,
                              NumericDeriver, IntegerDeriver, ConstantDeriver)
import compiler.check.known (int_name, bool_name, string_name, bytes_name, unit_name, decimal_name,
                             char_name, float_name, list_name, array_name, columns_name,
                             option_name, map_name, result_name, ordering_name, rounding_name,
                             instant_name, duration_name, iterator_name, scoped_name, task_name,
                             builtin_channel_name, secret_name, is_fixed_width_name)

pub type DeriveRejection =
  | ContainsFunction
  | ContainsHandle
  | ContainsFloat
  | Unconstrained(Int)
  | ContainsSecret
  | ContainsNative

pub type ConstructorShape = | Leaf | Structural | Rejected(DeriveRejection) | Nominal

fn leaf_types() -> List<Bytes> =
  [int_name(), bool_name(), string_name(), bytes_name(), unit_name(), decimal_name(), char_name()]

fn structural_types() -> List<Bytes> =
  [
    list_name(),
    array_name(),
    columns_name(),
    option_name(),
    map_name(),
    result_name(),
    ordering_name(),
    rounding_name(),
    instant_name(),
    duration_name(),
  ]

pub fn constructor_shape(deriver: Deriver, name: Bytes) -> ConstructorShape =
  if leaf_types().contains(name) { Leaf } else if name == float_name() {
    match deriver {
      OrderingDeriver -> Rejected(ContainsFloat),
      HashDeriver -> Rejected(ContainsFloat),
      _ -> Leaf,
    }
  } else if structural_types().contains(name) { Structural }
  else if deriver == ConstantDeriver && is_fixed_width_name(name) { Leaf }
  else if deriver == ConstantDeriver && name == iterator_name() { Structural }
  else if [scoped_name(), task_name(), builtin_channel_name()].contains(name) {
    Rejected(ContainsHandle)
  } else if name == secret_name() {
    match deriver { EqDeriver -> Leaf, _ -> Rejected(ContainsSecret) }
  } else { Nominal }

pub fn rejection_reason(w: DeriveRejection, deriver: Deriver, simple: Bytes) -> Bytes =
  match w {
    ContainsFloat -> float_reason(deriver),
    ContainsHandle ->
      Bytes::concat_all([b"a `", simple, b"` names a location rather than a value"]),
    ContainsSecret -> secret_reason(deriver),
    ContainsNative -> Bytes::concat_all([b"a `", simple, b"` is laid out by the toolchain"]),
    _ -> b"",
  }

pub fn float_reason(deriver: Deriver) -> Bytes =
  match deriver {
    HashDeriver ->
      b"`Float` has no hash that agrees with `==`: `NaN != NaN`, and `0.0 == -0.0` in different bits",
    _ -> b"`Float` is not ordered: `NaN != NaN`",
  }

pub fn secret_reason(deriver: Deriver) -> Bytes =
  match deriver {
    OrderingDeriver -> b"a credential has no order",
    EqDeriver -> b"a credential has no structural equality to derive",
    ShowDeriver -> b"a rendering would write the credential out",
    HashDeriver -> b"a hash of a credential is something to test guesses against",
    NumericDeriver -> b"a credential is not a number",
    IntegerDeriver -> b"a credential is not an integer",
    ConstantDeriver -> b"a build would write the credential into the binary",
  }

pub fn rejection_note(w: DeriveRejection, deriver: Deriver) -> Option<Bytes> =
  match w {
    ContainsSecret -> match deriver {
      OrderingDeriver ->
        Some(
          b"an ordering over a credential leaks a bit of position per comparison and recovers the value in calls proportional to its length; `==` compares two, and `Secret::verify` is the check a program actually wants",
        ),
      ShowDeriver ->
        Some(
          b"a credential is never shown, in an interpolated string or anywhere else; show what the `Secret` guards or names instead",
        ),
      HashDeriver ->
        Some(
          b"hash what the `Secret` guards or names instead; a password wants `std.password`, not a content hash",
        ),
      _ -> None,
    },
    _ -> None,
  }
