//! What `derivable(D, t)` reads of a type constructor, and why one refuses: the table the checker's
//! `derivable` walks a type by.

import compiler.syntax.items (Deriver, EqDeriver, OrdDeriver, ShowDeriver, HashDeriver,
                              NumericDeriver, IntegerDeriver, ConstantDeriver)
import compiler.check.known (int_name, bool_name, string_name, bytes_name, unit_name, decimal_name,
                             char_name, float_name, list_name, array_name, columns_name,
                             option_name, map_name, result_name, ordering_name, rounding_name,
                             instant_name, duration_name, iter_name, hold_name, task_name,
                             chan_name, secret_name, is_fixed_width_name)

/// Why a type is not derivable for a deriver.
pub type DeriveRefusal =
  | HoldsFunction
  | HoldsHandle
  | HoldsFloat
  | Unconstrained(Int)
  | HoldsSecret
  | HoldsNative

/// How `derivable` reads a type constructor: as a leaf, through its arguments, not at all and why,
/// or through the declared type it names.
pub type ConstructorShape = | Leaf | Structural | Refused(DeriveRefusal) | Nominal

/// The built-in types every deriver reads as a leaf.
fn leaf_types() -> List<Bytes> =
  [int_name(), bool_name(), string_name(), bytes_name(), unit_name(), decimal_name(), char_name()]

/// The built-in types every deriver reads through their arguments.
fn structural_types() -> List<Bytes> =
  [
    list_name(),
    array_name(),
    columns_name(),
    option_name(),
    map_name(),
    result_name(),
    ordering_name(),
    rounding_name(),
    instant_name(),
    duration_name(),
  ]

pub fn constructor_shape(deriver: Deriver, name: Bytes) -> ConstructorShape =
  if leaf_types().contains(name) { Leaf } else if name == float_name() {
    match deriver {
      OrdDeriver -> Refused(HoldsFloat),
      HashDeriver -> Refused(HoldsFloat),
      _ -> Leaf,
    }
  } else if structural_types().contains(name) { Structural }
  else if deriver == ConstantDeriver && is_fixed_width_name(name) { Leaf }
  else if deriver == ConstantDeriver && name == iter_name() { Structural }
  else if [hold_name(), task_name(), chan_name()].contains(name) { Refused(HoldsHandle) }
  else if name == secret_name() { match deriver { EqDeriver -> Leaf, _ -> Refused(HoldsSecret) } }
  else { Nominal }

pub fn refusal_reason(w: DeriveRefusal, deriver: Deriver, simple: Bytes) -> Bytes =
  match w {
    HoldsFloat -> float_reason(deriver),
    HoldsHandle -> Bytes::concat_all([b"a `", simple, b"` names a location rather than a value"]),
    HoldsSecret -> secret_reason(deriver),
    HoldsNative -> Bytes::concat_all([b"a `", simple, b"` is laid out by the toolchain"]),
    _ -> b"",
  }

pub fn float_reason(deriver: Deriver) -> Bytes =
  match deriver {
    HashDeriver ->
      b"`Float` has no hash that agrees with `==`: `NaN != NaN`, and `0.0 == -0.0` in different bits",
    _ -> b"`Float` is not ordered: `NaN != NaN`",
  }

pub fn secret_reason(deriver: Deriver) -> Bytes =
  match deriver {
    OrdDeriver -> b"a credential has no order",
    EqDeriver -> b"a credential has no structural equality to derive",
    ShowDeriver -> b"a rendering would write the credential out",
    HashDeriver -> b"a hash of a credential is something to test guesses against",
    NumericDeriver -> b"a credential is not a number",
    IntegerDeriver -> b"a credential is not an integer",
    ConstantDeriver -> b"a build would write the credential into the binary",
  }

pub fn refusal_note(w: DeriveRefusal, deriver: Deriver) -> Option<Bytes> =
  match w {
    HoldsSecret -> match deriver {
      OrdDeriver ->
        Some(
          b"an ordering over a credential leaks a bit of position per comparison and recovers the value in calls proportional to its length; `==` compares two, and `Secret::verify` is the check a program actually wants",
        ),
      ShowDeriver ->
        Some(
          b"a credential is never shown, in an interpolated string or anywhere else; show what the `Secret` guards or names instead",
        ),
      HashDeriver ->
        Some(
          b"hash what the `Secret` guards or names instead; a password wants `std.password`, not a content hash",
        ),
      _ -> None,
    },
    _ -> None,
  }
