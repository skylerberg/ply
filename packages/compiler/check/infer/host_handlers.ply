import compiler.syntax.parsing (Span)
import compiler.syntax.type_syntax (RaiseMode)
import compiler.syntax.items (Item, FunctionItem, InstanceItem, InstanceDefinition, HostInstance,
                              is_shipped)
import compiler.check.types (Effect, Effects, VariableType, FunctionType, AnyResource,
                             SingletonResource, effects_cover, effect_text, effects_text, type_text)
import compiler.check.resolve.tables (ParsedModule, qualify, label_at)
import compiler.check.infer.checker (Checker, DefinitionInfo, EffectInfo, OperationInfo,
                                     report_error_at, report_error_at_and, report_error_with_labels,
                                     resolve, definition_of, effect_of)
import std.bytes

pub fn hosted_effects(checker: Checker) -> List<Bytes> =
  checker.modules.fold([], |accumulator: List<Bytes>, m: ParsedModule|
    m.module.items.fold(accumulator, |a: List<Bytes>, item: Item|
      match item {
        InstanceItem(d) -> if d.kind == HostInstance { a.push(qualify(m.name, d.target.name)) }
        else { a },
        _ -> a,
      }))

pub fn checked_host_handler(
  checker: Checker,
  m: ParsedModule,
  definition: InstanceDefinition,
  hosted: List<Bytes>,
) -> Checker / {abort.raise} = {
  if !is_shipped(m.name) {
    report_error_at(
      checker,
      b"E0161",
      definition.span,
      Bytes::concat_all([b"`host for ", definition.target.name, b"` declares a host handler"]),
      b"only modules shipped with the toolchain can declare a host handler",
      [
        b"a host handler implements an effect using the machine the program runs on, not code in the program, so only the toolchain's own modules declare one",
        b"handle the effect with a `handle` where the program performs it",
      ],
    )
  } else {
    match effect_of(checker, qualify(m.name, definition.target.name)) {
      None ->
        report_error_at(
          checker,
          b"E0162",
          definition.target.span,
          Bytes::concat_all([
            b"`",
            definition.target.name,
            b"` is not an effect this module declares",
          ]),
          b"the effect is declared in another module, or not declared at all",
          [
            b"a `host` must be in the module that declares the effect, so that every program that performs the effect uses the same host handler",
          ],
        ),
      Some(info) -> match earlier_host(m, definition) {
        Some(first) ->
          report_error_at_and(
            checker,
            b"E0163",
            definition.span,
            Bytes::concat_all([b"`", definition.target.name, b"` states its host handler twice"]),
            b"stated again here",
            { module: checker.module, span: first },
            b"first stated here",
            [b"an effect has one, so that a root runs under one handler of it; remove one"],
          ),
        None -> match definition_of(checker, qualify(m.name, definition.function.name)) {
          None ->
            report_error_at(
              checker,
              b"E0164",
              definition.function.span,
              Bytes::concat_all([
                b"`",
                definition.function.name,
                b"` is not a function this module declares",
              ]),
              b"a `host` names a function of its effect's own module",
              [],
            ),
          Some(f) -> match host_handler_rejection(checker, m, info, f, hosted) {
            None -> checker,
            Some(reason) ->
              report_error_with_labels(
                checker,
                b"E0164",
                Bytes::concat_all([
                  b"`",
                  definition.function.name,
                  b"` cannot be the host handler of `",
                  definition.target.name,
                  b"`",
                ]),
                [
                  label_at(checker.module, definition.function.span, true, reason),
                  label_at(f.at.module, f.at.span, false, b"the function it names"),
                ],
                [
                  Bytes::concat_all([
                    b"a host handler of `",
                    definition.target.name,
                    b"` is `fn f<a | r>(go: () -> a / {",
                    Bytes::join(
                      info.operations.filter(served_operation).map(|o: OperationInfo|
                        written_effect(info, o)),
                      b", ",
                    ),
                    b" | r}) -> a / r`: it answers what `go()` answers, every operation of the effect discharged, and its effects add only raises and effects no host handler serves",
                  ]),
                ],
              ),
          },
        },
      },
    }
  }
}

fn earlier_host(m: ParsedModule, definition: InstanceDefinition) -> Option<Span> =
  m.module.items.fold(None, |found: Option<Span>, item: Item|
    match found {
      Some(_) -> found,
      None -> match item {
        InstanceItem(d) -> if d.kind == HostInstance && d.target.name == definition.target.name
            && d.span.start < definition.span.start { Some(d.span) }
        else { None },
        _ -> None,
      },
    })

fn served_operation(o: OperationInfo) -> Bool = o.mode != RaiseMode

fn host_handled_effect(info: EffectInfo, o: OperationInfo) -> Effect =
  {
    effect: info.name,
    resource: if o.resource_param { AnyResource } else { SingletonResource },
    mode: o.mode,
    operation: Some(o.name),
  }

fn written_effect(info: EffectInfo, o: OperationInfo) -> Bytes =
  Bytes::concat_all([info.simple_name, b".", o.name, if o.resource_param { b"[*]" } else { b"" }])

fn host_handler_rejection(
  checker: Checker,
  m: ParsedModule,
  info: EffectInfo,
  f: DefinitionInfo,
  hosted: List<Bytes>,
) -> Option<Bytes> / {abort.raise} =
  if is_const_function(m, f.simple_name) {
    Some(
      b"this function is a constant, whose value is computed once and shared by the whole process",
    )
  } else if f.scheme.label_variables.len() > 0 {
    Some(b"this function takes a resource label as a type parameter")
  } else if f.constraints.len() > 0 {
    Some(b"this function has constraints on its type parameters")
  } else {
    let shape = Bytes::concat_all([
      b"this function's type is `",
      type_text(resolve(checker, f.scheme.ty)),
      b"`",
    ]);
    match ((f.scheme.type_variables, f.scheme.effect_variables, resolve(checker, f.scheme.ty))) {
      ([a], [r], FunctionType(sig)) -> match sig.params {
        [FunctionType(go)] -> if go.params.len() > 0 || go.return_type != VariableType(a)
            || sig.return_type != VariableType(a)
            || go.effects.variable != Some(r)
            || sig.effects.variable != Some(r) { Some(shape) } else {
          match info.operations.filter(served_operation).find(|o: OperationInfo|
              !effects_cover(go.effects.listed, host_handled_effect(info, o))) {
            Some(o) ->
              Some(
                Bytes::concat_all([
                  b"the function passed to it may not perform `",
                  effect_text(host_handled_effect(info, o)),
                  b"`",
                ]),
              ),
            None -> result_effects_reason(sig.effects, info, hosted),
          }
        },
        _ -> Some(shape),
      },
      _ -> Some(shape),
    }
  }

fn result_effects_reason(
  effects: Effects,
  info: EffectInfo,
  hosted: List<Bytes>,
) -> Option<Bytes> / {abort.raise} =
  match effects.listed.find(|x: Effect|
      x.mode != RaiseMode && (x.effect == info.name || hosted.contains(x.effect))) {
    None -> None,
    Some(x) ->
      Some(
        Bytes::concat_all([
          b"this function's effects are `",
          effects_text(effects),
          b"`, which ",
          if x.effect == info.name { b"include the effect this host handler implements" }
          else { b"include an effect that a host handler implements" },
        ]),
      ),
  }

fn is_const_function(m: ParsedModule, name: Bytes) -> Bool =
  m.module.items.any(|item: Item|
    match item { FunctionItem(d) -> d.name.name == name && d.constant != None, _ -> false })
