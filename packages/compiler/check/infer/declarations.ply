                                     WithName, WithTys, WithAtom, hold, is_region_effect,
                                     location_of, module_name, scope_of, report_error_at,
                                     report_error_at_and, supplied, new_ty, new_ty_var, new_row,
                                     new_row_var, resolve, is_prelude_effect, seed_atom,
