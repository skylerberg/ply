fn type_param(checker: Checker, ident: Identifier) -> { checker: Checker, ty: Type } =
  match checker.type_params.get(ident.name) {
    Some(t) -> { checker: checker, ty: t },
    None -> if checker.auto_type_params {
      let o: WithType = new_type(checker);
      {
        checker: { ..o.checker, type_params: o.checker.type_params.insert(ident.name, o.ty) },
        ty: o.ty,
      }
    } else {
      let o: WithType = new_type(
        report_error_at(
          checker,
          b"E0102",
          ident.span,
          Bytes::concat_all([b"unknown type variable `", ident.name, b"`"]),
          b"not declared",
          [
            Bytes::concat_all([
              b"add `",
              ident.name,
              b"` to the generic list, e.g. `fn f<",
              ident.name,
              b">(..)`",
            ]),
          ],
        ),
      );
      o
    },
  }

pub fn convert_type(
  checker: Checker,
  ty: TypeExpression,
) -> { checker: Checker, ty: Type } / {abort.raise} =
  convert_type_within(checker, ty, alias_depth_limit(checker))

fn alias_depth_limit(checker: Checker) -> Int = checker.types.len() - checker.alias_stack.len()

fn convert_type_within(
  checker: Checker,
  ty: TypeExpression,
  room: Int,
) -> { checker: Checker, ty: Type } / {abort.raise} =
  match ty {
    VariableTypeExpression(id) -> type_param(checker, id),
    UnitTypeExpression(_) -> { checker: checker, ty: unit_type() },
    InvalidTypeExpression(_) -> new_type(checker),
    RecordTypeExpression(r) -> {
      let fs = r.fields.fold(
        { checker: checker, fs: [] },
        |acc: { checker: Checker, fs: List<Field> }, f: { name: Identifier, ty: TypeExpression }| {
          let o: WithType = convert_type_within(acc.checker, f.ty, room);
          { checker: o.checker, fs: acc.fs.push({ name: f.name.name, ty: o.ty }) }
        },
      );
      { checker: fs.checker, ty: RecordType(fields_sorted(fs.fs)) }
    },
    FunctionTypeExpression(f) -> {
      let ps: WithTypes = convert_types_within(checker, f.params, room);
      let r: WithType = convert_type_within(ps.checker, f.ret, room);
      let eff = match f.effects {
        Some(effects) -> convert_effects(r.checker, effects),
        None -> { checker: r.checker, effects: no_effects() },
      };
      { checker: eff.checker, ty: owning_fn_type(ps.types, f.kept, f.once, r.ty, eff.effects) }
    },
    NamedTypeExpression(c) ->
      convert_constructor(checker, c.name, c.args, c.labels, c.effect_arguments, c.span, room),
  }

type LabelAndEffectsArguments = { labels: List<Type>, effect_arguments: List<Effects> }

fn convert_label_and_effects_arguments(
  checker: Checker,
  labels: List<Identifier>,
  written: List<EffectsExpression>,
) -> { checker: Checker, over: LabelAndEffectsArguments } / {abort.raise} = {
  let converted = written.fold(
    { checker: checker, effect_arguments: [] },
    |acc: { checker: Checker, effect_arguments: List<Effects> }, effects: EffectsExpression| {
      let o = convert_effects(acc.checker, effects);
      { checker: o.checker, effect_arguments: acc.effect_arguments.push(o.effects) }
    },
  );
  {
    checker: converted.checker,
    over: {
      labels: labels.map(|label: Identifier|
        match checker.label_params.get(label.name) {
          Some(v) -> VariableType(v),
          None -> label_type(label.name),
        }),
      effect_arguments: converted.effect_arguments,
    },
  }
}

fn bind_declaration_params(
  checker: Checker,
  declaration: TypeDeclaration,
) -> { checker: Checker, labels: List<Int>, effect_params: List<Int> } = {
  let closed: Checker = { ..checker, label_params: Map::new(), effect_params: Map::new() };
  let labels = declaration.labels.fold(
    { checker: closed, vars: [] },
    |acc: { checker: Checker, vars: List<Int> }, name: Bytes| {
      let o: WithVar = new_type_var(acc.checker);
      {
        checker: { ..o.checker, label_params: o.checker.label_params.insert(name, o.var) },
        vars: acc.vars.push(o.var),
      }
    },
  );
  let effects = declaration.effect_params.fold(
    { checker: labels.checker, vars: [] },
    |acc: { checker: Checker, vars: List<Int> }, name: Bytes| {
      let o: WithVar = new_effect_variable(acc.checker);
      {
        checker: { ..o.checker, effect_params: o.checker.effect_params.insert(name, o.var) },
        vars: acc.vars.push(o.var),
      }
    },
  );
  { checker: effects.checker, labels: labels.vars, effect_params: effects.vars }
}

fn convert_types(
  checker: Checker,
  types: List<TypeExpression>,
) -> { checker: Checker, types: List<Type> } / {abort.raise} =
  convert_types_within(checker, types, alias_depth_limit(checker))

fn convert_types_within(
  checker: Checker,
  types: List<TypeExpression>,
  room: Int,
) -> { checker: Checker, types: List<Type> } / {abort.raise} =
  types.fold(
    { checker: checker, types: [] },
    |acc: { checker: Checker, types: List<Type> }, ty: TypeExpression| {
      let o: WithType = convert_type_within(acc.checker, ty, room);
      { checker: o.checker, types: acc.types.push(o.ty) }
    },
  )

fn arity_error(
  checker: Checker,
  span: Span,
  name: Bytes,
  expected: Int,
  found: Int,
  what: Bytes,
  notes: List<Bytes>,
) -> Checker / {abort.raise} = {
  let w = if expected == 1 { what.slice(0, what.len() - 1) } else { what };
  report_error_at(
    checker,
    b"E0202",
    span,
    Bytes::concat_all([
      b"`",
      name,
      b"` takes ",
      ascii_of_int(expected),
      b" ",
      w,
      b", but ",
      supplied(found),
    ]),
    Bytes::concat_all([b"expected ", ascii_of_int(expected), b", found ", ascii_of_int(found)]),
    notes,
  )
}

fn reject_label_and_effects_count(
  checker: Checker,
  span: Span,
  name: Bytes,
  labels: Int,
  effects: Int,
  over: LabelAndEffectsArguments,
) -> Checker / {abort.raise} =
  if over.labels.len() != labels {
    arity_error(checker, span, name, labels, over.labels.len(), b"label arguments", [
      b"a label argument is bracketed among the type arguments, where a binder writes `[l]`: `T<a, [conn]>`",
    ])
  } else {
    arity_error(checker, span, name, effects, over.effect_arguments.len(), b"effects arguments", [
      b"an effects argument follows `|`, where a binder writes its effect variable: `T<a | {}>` holds functions that perform nothing",
    ])
  }

fn convert_constructor(
  checker: Checker,
  name: QName,
  args: List<TypeExpression>,
  labels: List<Identifier>,
  effect_arguments: List<EffectsExpression>,
  span: Span,
  room: Int,
) -> { checker: Checker, ty: Type } / {abort.raise} =
  if is_bare(name) && args.len() == 0 && labels.len() == 0 && effect_arguments.len() == 0
      && checker.type_params.contains(name.name.name) {
    {
      checker: checker,
      ty: match checker.type_params.get(name.name.name) { Some(t) -> t, None -> unit_type() },
    }
  } else {
    let converted: WithTypes = convert_types_within(checker, args, room);
    let written = convert_label_and_effects_arguments(converted.checker, labels, effect_arguments);
    let c: Checker = written.checker;
    let over: LabelAndEffectsArguments = written.over;
    match if is_bare(name) { builtin_type_arity(name.name.name) } else { None } {
      Some(arity) -> if converted.types.len() != arity {
        new_type(
          arity_error(c, span, name.name.name, arity, converted.types.len(), b"type arguments", []),
        )
      } else if name.name.name == scoped_name() {
        if over.labels.len() != 1 || over.effect_arguments.len() != 0 {
          new_type(reject_label_and_effects_count(c, span, name.name.name, 1, 0, over))
        } else {
          let label = match c.label_params.get(labels.get(0).name) {
            Some(v) -> VariableType(v),
            None -> label_type(scope_label_for(c, scoped_effect(), labels.get(0).name)),
          };
          { checker: c, ty: scoped_type(label, converted.types.get(0)) }
        }
      } else if labels.len() > 0 || effect_arguments.len() > 0 {
        new_type(reject_label_and_effects_count(c, span, name.name.name, 0, 0, over))
      } else {
        let built = NamedType({ name: name.name.name, args: converted.types });
        { checker: note_parts(c, span, own_parts(c.ordered_parameters, built, [])), ty: built }
      },
      None -> {
        let g: WithName = global(c, TypeSpace, name);
        match g.name {
          None -> if is_bare(name) { new_type(unknown_type(g.checker, name)) }
          else { new_type(g.checker) },
          Some(qualified) -> match g.checker.types.get(qualified) {
            None -> new_type(g.checker),
            Some(declaration) -> if converted.types.len() != declaration.params.len() {
              new_type(
                arity_error(
                  g.checker,
                  span,
                  name.name.name,
                  declaration.params.len(),
                  converted.types.len(),
                  b"type arguments",
                  [],
                ),
              )
            } else if over.labels.len() != declaration.labels.len()
                || over.effect_arguments.len() != declaration.effect_params.len() {
              new_type(
                reject_label_and_effects_count(
                  g.checker,
                  span,
                  name.name.name,
                  declaration.labels.len(),
                  declaration.effect_params.len(),
                  over,
                ),
              )
            } else {
              match declaration.declared {
                DeclaredSum -> {
                  let built = NamedType({
                    name: qualified,
                    args: applied_args(converted.types, over.labels, over.effect_arguments),
                  });
                  {
                    checker: note_type_constraints(
                      note_parts(
                        g.checker,
                        span,
                        own_parts(g.checker.ordered_parameters, built, []),
                      ),
                      span,
                      qualified,
                      converted.types,
                    ),
                    ty: built,
                  }
                },
                DeclaredExtern ->
                  {
                    checker: note_type_constraints(g.checker, span, qualified, converted.types),
                    ty: NamedType({
                      name: qualified,
                      args: applied_args(converted.types, over.labels, over.effect_arguments),
                    }),
                  },
                DeclaredRecord(body) -> {
                  let o = declared_record(g.checker, name.name, qualified, declaration, body, room);
                  match o.record {
                    None -> new_type(o.checker),
                    Some(r) -> {
                      let built = apply_arguments(
                        r.ty,
                        r.type_variables,
                        r.effect_variables,
                        applied_args(converted.types, over.labels, over.effect_arguments),
                      );
                      {
                        checker: note_type_constraints(
                          note_parts(
                            o.checker,
                            span,
                            own_parts(o.checker.ordered_parameters, built, []),
                          ),
                          span,
                          qualified,
                          converted.types,
                        ),
                        ty: built,
                      }
                    },
                  }
                },
                DeclaredAlias(alias) -> if g.checker.alias_stack.contains(qualified) {
                  new_type(
                    report_error_at(
                      g.checker,
                      b"E0102",
                      name.span,
                      Bytes::concat_all([
                        b"type alias `",
                        name.name.name,
                        b"` expands into itself",
                      ]),
                      b"cyclic alias",
                      [b"break the cycle, or make this a `type` with variants"],
                    ),
                  )
                } else if room <= 0 { panic("an alias expanded past the aliases there are") } else {
                  let g1 = note_alias_constraints(
                    note_type_constraints(g.checker, span, qualified, converted.types),
                    qualified,
                    converted.types,
                  );
                  let g: WithName = { ..g, checker: g1 };
                  let outermost = g.checker.alias_stack.len() == 0;
                  let before = g.checker.map_keys.len();
                  let placed = |sites: List<MapKeySite>|
                    if outermost {
                      relocated_keys(sites, before, g.checker.module, span, name.name.name)
                    } else { sites };
                  let memo = declaration.params.len() == 0 && declaration.labels.len() == 0
                    && declaration.effect_params.len() == 0;
                  match if memo { g.checker.aliases.get(qualified) } else { None } {
                    Some(m) -> {
                      let assumed = assumed_for(g.checker, OrdDeriver);
                      let keys = m.keys.map(|s: MapKeySite|
                        { ..s, scope: g.checker.scope, assumed: assumed });
                      {
                        checker: { ..g.checker, map_keys: placed(g.checker.map_keys.concat(keys)) },
                        ty: m.t,
                      }
                    },
                    None -> {
                      let saved = g.checker.type_params;
                      let bound: Map<Bytes, Type> = range(0, declaration.params.len()).fold(
                        Map::new(),
                        |m: Map<Bytes, Type>, i: Int|
                          m.insert(declaration.params.get(i), converted.types.get(i)),
                      );
                      let own = bind_declaration_params(
                        {
                          ..g.checker,
                          type_params: bound,
                          alias_stack: g.checker.alias_stack.push(qualified),
                          module: declaration.owner,
                        },
                        declaration,
                      );
                      let body: WithType = convert_type_within(own.checker, alias, room - 1);
                      let o: WithType = if own.labels.len() == 0 && own.effect_params.len() == 0 {
                        body
                      } else {
                        {
                          checker: body.checker,
                          ty: apply_arguments(
                            body.ty,
                            own.labels,
                            own.effect_params,
                            applied_args([], over.labels, over.effect_arguments),
                          ),
                        }
                      };
                      let kept = memo && o.checker.fresh == g.checker.fresh
                        && o.checker.diagnostics.len() == g.checker.diagnostics.len()
                        && o.checker.rejected_effects.len() == g.checker.rejected_effects.len();
                      {
                        checker: {
                          ..o.checker,
                          type_params: saved,
                          effect_params: g.checker.effect_params,
                          label_params: g.checker.label_params,
                          alias_stack: o.checker.alias_stack.take(o.checker.alias_stack.len() - 1),
                          module: g.checker.module,
                          map_keys: placed(o.checker.map_keys),
                          aliases: if kept {
                            o.checker.aliases.insert(qualified, {
                              t: o.ty,
                              keys: sites_from(o.checker.map_keys, before),
                            })
                          } else { o.checker.aliases },
                        },
                        ty: o.ty,
                      }
                    },
                  }
                },
              }
            },
          },
        }
      },
    }
  }

fn declared_record(
  checker: Checker,
  named: Identifier,
  qualified: Bytes,
  declaration: TypeDeclaration,
  body: TypeExpression,
  room: Int,
) -> { checker: Checker, record: Option<RecordDeclaration> } / {abort.raise} =
  match checker.nominals.get(qualified) {
    Some(r) -> { checker: checker, record: Some(r) },
    None -> if checker.alias_stack.contains(qualified) {
      {
        checker: report_error_at(
          checker,
          b"E0214",
          named.span,
          Bytes::concat_all([b"`", simple_name_of(qualified), b"` holds itself"]),
          b"this field's type reaches the record it is a field of",
          [
            b"what reads a `new` record's shape reads its fields whole, as it reads an alias's, so the declaration cannot reach itself",
            b"a sum can hold itself: put the recursion in one, as `type T = | Leaf | Node(..)`",
          ],
        ),
        record: None,
      }
    } else if room <= 0 { panic("a declaration expanded past the declarations there are") } else {
      let vars: { checker: Checker, vars: List<Int>, params: Map<Bytes, Type> } = declaration.params.fold(
        { checker: checker, vars: [], params: Map::new() },
        |acc: { checker: Checker, vars: List<Int>, params: Map<Bytes, Type> }, p: Bytes| {
          let o: WithVar = new_type_var(acc.checker);
          {
            checker: o.checker,
            vars: acc.vars.push(o.var),
            params: acc.params.insert(p, VariableType(o.var)),
          }
        },
      );
      let own = bind_declaration_params(
        {
          ..vars.checker,
          type_params: vars.params,
          alias_stack: checker.alias_stack.push(qualified),
          module: declaration.owner,
          declaring_type: qualified,
        },
        declaration,
      );
      let o: WithType = convert_type_within(own.checker, body, room - 1);
      let fields = match o.ty { RecordType(fs) -> fs, _ -> [] };
      let written = match body { RecordTypeExpression(r) -> r.fields, _ -> [] };
      let checked: Checker = written.fold(
        o.checker,
        |c: Checker, f: { name: Identifier, ty: TypeExpression }|
          match field_get(fields, f.name.name) {
            Some(t) ->
              reject_scoped_type(
                c,
                t,
                type_span(f.ty),
                simple_name_of(qualified),
                Bytes::concat_all([b"field `", f.name.name, b"`"]),
              ),
            None -> c,
          },
      );
      let record = {
        ty: NominalType({
          name: qualified,
          args: applied_args(
            vars.vars.map(|v: Int| VariableType(v)),
            own.labels.map(|v: Int| VariableType(v)),
            own.effect_params.map(open_effects),
          ),
          fields: fields,
        }),
        type_variables: vars.vars.concat(own.labels),
        effect_variables: own.effect_params,
      };
      {
        checker: {
          ..checked,
          type_params: checker.type_params,
          effect_params: checker.effect_params,
          label_params: checker.label_params,
          alias_stack: checker.alias_stack,
          module: checker.module,
          declaring_type: checker.declaring_type,
          nominals: checked.nominals.insert(qualified, record),
        },
        record: Some(record),
      }
    },
  }

pub fn collect_nominals(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} =
  parsed.module.items.fold(checker, |c: Checker, item: Item|
    match item {
      TypeItem(definition) -> {
        let qualified = qualify(parsed.name, definition.name.name);
        match c.types.get(qualified) {
          Some(declaration) -> match declaration.declared {
            DeclaredRecord(body) ->
              declared_record(
                c,
                definition.name,
                qualified,
                declaration,
                body,
                alias_depth_limit(c),
              ).checker,
            _ -> c,
          },
          None -> c,
        }
      },
      _ -> c,
    })

fn unknown_type(checker: Checker, qname: QName) -> Checker / {abort.raise} =
  match checker.derived {
    Some(_) -> unresolved_in_derived(checker, qname, b"type"),
    None -> {
      let n = qname.name.name;
      let notes = [b"declare it with `type`, or check the spelling"];
      let exported = if is_bare(qname) {
        match exporter(checker, TypeSpace, n) {
          Some(i) ->
            notes.push(
              Bytes::concat_all([
                b"module `",
                module_name(checker, i),
                b"` exports it: `import ",
                module_name(checker, i),
                b" (",
                n,
                b")`",
              ]),
            ),
          None -> notes,
        }
      } else { notes };
      report_error_at(
        checker,
        b"E0102",
        qname.span,
        Bytes::concat_all([b"unknown type `", n, b"`"]),
        b"not found",
        exported,
      )
    },
  }

fn effect_param(checker: Checker, ident: Identifier) -> { checker: Checker, v: Option<Int> } =
  match checker.effect_params.get(ident.name) {
    Some(v) -> { checker: checker, v: Some(v) },
    None ->
      {
        checker: report_error_at(
          checker,
          b"E0301",
          ident.span,
          Bytes::concat_all([b"unknown effect variable `", ident.name, b"`"]),
          b"not declared",
          [
            Bytes::concat_all([
              b"declare it after `|` in the generic list of the `fn` or `type` that writes these effects: `<| ",
              ident.name,
              b">`",
            ]),
          ],
        ),
        v: None,
      },
  }

fn convert_effects(
  checker: Checker,
  effects: EffectsExpression,
) -> { checker: Checker, effects: Effects } / {abort.raise} = {
  let o = convert_bounded_effects(checker, effects);
  { checker: reject_marks(o.checker, effects), effects: o.r }
}

fn convert_bounded_effects(
  checker: Checker,
  effects: EffectsExpression,
) -> { checker: Checker, r: Effects, bounded: List<Effect> } / {abort.raise} = {
  let converted = effects.listed.fold(
    { checker: checker, listed: [], bounded: [] },
    |acc: { checker: Checker, listed: List<Effect>, bounded: List<Effect> }, entry: EffectExpression| {
      let o: WithEffect = convert_effect(acc.checker, entry);
      match o.entry {
        Some(x) ->
          {
            checker: o.checker,
            listed: effects_insert(acc.listed, x),
            bounded: if entry.bounded { effects_insert(acc.bounded, x) } else { acc.bounded },
          },
        None -> { ..acc, checker: o.checker },
      }
    },
  );
  let tail = match effects.variable {
    Some(t) -> effect_param(converted.checker, t),
    None -> { checker: converted.checker, v: None },
  };
  {
    checker: tail.checker,
    r: { listed: converted.listed, variable: tail.v },
    bounded: converted.bounded,
  }
}

fn reject_marks(checker: Checker, effects: EffectsExpression) -> Checker = {
  let marked = effects.listed.fold(checker, |c: Checker, entry: EffectExpression|
    if entry.bounded { reject_bounded(c, entry.span) } else { c });
  if effects.variable_bounded { reject_bounded(marked, effects.span) } else { marked }
}

fn reject_bounded(checker: Checker, span: Span) -> Checker =
  report_error_at(
    checker,
    b"E0466",
    span,
    b"`bounded` is a promise a definition makes of its own effects",
    b"these effects belong to a type, not to a definition",
    [
      b"write `bounded` in the effects after a `fn` signature's `->`, where the body is checked against it",
    ],
  )

fn is_rejected_effect(checker: Checker, s: Span) -> Bool =
  checker.rejected_effects.fold(false, |acc: Bool, x: Location|
    acc || (x.module == checker.module && x.span == s))

fn mark_rejected_effect(checker: Checker, s: Span) -> Checker =
  {
    ..checker,
    rejected_effects: checker.rejected_effects.push({ module: checker.module, span: s }),
  }

fn reject_any_label(
  checker: Checker,
  span: Span,
  eff: Bytes,
  op: Bytes,
  location: Location,
) -> Checker = {
  let reported: Checker = report_error_at_and(
    checker,
    b"E0304",
    span,
    Bytes::concat_all([b"`", eff, b".", op, b"` is not resource-parameterized"]),
    b"`[*]` names no label",
    location,
    b"declared without `[r]`",
    [],
  );
  mark_rejected_effect(reported, span)
}

pub fn convert_effect(
  checker: Checker,
  a: EffectExpression,
) -> { checker: Checker, entry: Option<Effect> } / {abort.raise} =
  if is_rejected_effect(checker, a.span) { { checker: checker, entry: None } } else {
    let e: WithName = effect_name(checker, a.effect_name);
    match e.name {
      None -> { checker: mark_rejected_effect(e.checker, a.span), entry: None },
      Some(eff) -> {
        let resource = if a.resource_wildcard { AnyResource } else {
          match a.resource {
            Some(r) -> match checker.label_params.get(r.name) {
              Some(v) -> ResourceVariable(v),
              None -> NamedResource(scope_label_for(checker, eff, r.name)),
            },
            None -> SingletonResource,
          }
        };
        let info = effect_of(e.checker, eff);
        let label_less: { checker: Checker, rejected: Bool } = match a.op {
          Some(op) -> match info {
            Some(i) -> match op_named(i, op.name) {
              Some(o) -> if a.resource_wildcard && !o.resource_param {
                { checker: reject_any_label(e.checker, a.span, eff, o.name, o.at), rejected: true }
              } else { { checker: e.checker, rejected: false } },
              None -> { checker: e.checker, rejected: false },
            },
            None -> { checker: e.checker, rejected: false },
          },
          None -> { checker: e.checker, rejected: false },
        };
        let named_context: Checker = label_less.checker;
        let entry: Option<Effect> = if label_less.rejected { None } else {
          match a.op {
            Some(op) -> match info {
              Some(i) -> match op_named(i, op.name) {
                Some(o) ->
                  Some({ effect: eff, resource: resource, mode: o.mode, op: Some(o.name) }),
                None -> None,
              },
              None -> None,
            },
            None -> {
              let declares_mode = eff == b"diverges"
                || (match info {
                  Some(i) ->
                    i.operations.len() == 0
                      || i.operations.fold(false, |acc: Bool, o: OpInfo|
                        acc || mode_eq(o.mode, a.mode)),
                  None -> true,
                });
              if declares_mode { Some({ effect: eff, resource: resource, mode: a.mode, op: None }) }
              else { None }
            },
          }
        };
        match entry {
          Some(_) -> { checker: named_context, entry: entry },
          None -> {
            let known = match info {
              Some(i) -> match a.op {
                Some(_) -> effect_modes(i).concat(effect_moded_ops(i)),
                None -> effect_modes(i),
              },
              None -> [],
            };
            let help = if known.len() == 0 { [] } else {
              [Bytes::concat_all([b"`", eff, b"` can perform: ", Bytes::join(known, b", ")])]
            };
            let (message, label) = match a.op {
              Some(op) ->
                (
                  Bytes::concat_all([
                    b"effect `",
                    eff,
                    b"` declares no operation `",
                    op.name,
                    b"`",
                  ]),
                  b"no such operation",
                ),
              None ->
                (
                  Bytes::concat_all([
                    b"effect `",
                    eff,
                    b"` declares no `",
                    mode_text(a.mode),
                    b"` operation",
                  ]),
                  Bytes::concat_all([b"no `", mode_text(a.mode), b"` operation to perform"]),
                ),
            };
            let reported: Checker = report_error_at(
              named_context,
              b"E0104",
              a.span,
              message,
              label,
              help,
            );
            { checker: mark_rejected_effect(reported, a.span), entry: None }
          },
        }
      },
    }
  }

fn effect_modes(info: EffectInfo) -> List<Bytes> =
  info.operations.fold([], |acc: List<Bytes>, op_info: OpInfo| {
    let k = Bytes::concat_all([
      info.simple_name,
      b".",
      if is_raise(op_info.mode) { op_info.name } else { mode_text(op_info.mode) },
    ]);
    if acc.contains(k) { acc } else { acc.push(k) }
  })

fn effect_moded_ops(info: EffectInfo) -> List<Bytes> =
  effect_ops({
    ..info,
    operations: info.operations.filter(|op_info: OpInfo| !is_raise(op_info.mode)),
  })

fn effect_ops(info: EffectInfo) -> List<Bytes> =
  info.operations.map(|op_info: OpInfo| Bytes::concat_all([info.simple_name, b".", op_info.name]))

pub fn op_named(info: EffectInfo, name: Bytes) -> Option<OpInfo> =
  info.operations.fold(None, |acc: Option<OpInfo>, op_info: OpInfo|
    match acc { Some(_) -> acc, None -> if op_info.name == name { Some(op_info) } else { None } })

pub fn effect_name(
  checker: Checker,
  qname: QName,
) -> { checker: Checker, name: Option<Bytes> } / {abort.raise} =
  if is_bare(qname) && is_scoped_effect(qname.name.name) {
    { checker: checker, name: Some(qname.name.name) }
  } else {
    let g: WithName = global(checker, EffectSpace, qname);
    match g.name {
      Some(n) -> match effect_of(g.checker, n) {
        Some(_) -> { checker: g.checker, name: Some(n) },
        None -> { checker: g.checker, name: None },
      },
      None -> if is_bare(qname) && is_prelude_effect(qname.name.name) {
        { checker: g.checker, name: Some(qname.name.name) }
      } else if is_bare(qname) { { checker: unknown_effect(g.checker, qname), name: None } }
      else { { checker: g.checker, name: None } },
    }
  }

fn unknown_effect(checker: Checker, qname: QName) -> Checker / {abort.raise} = {
  let n = qname.name.name;
  let message = Bytes::concat_all([b"unknown effect `", n, b"`"]);
  if is_bare(qname)
      && (env_lookup(checker.env, n) != None
      || env_locals(checker.env).any(|l: InScope| l.name == n)) {
    report_error_at(checker, b"E0103", qname.span, message, b"not declared", [
      Bytes::concat_all([
        b"`",
        n,
        b"` is a value in scope, so this looks like a field call rather than a perform: write `(",
        n,
        b".<field>)(..)` to call a function stored in a record",
      ]),
      b"`a.b(c)` is an effect operation; parentheses make it a field access",
    ])
  } else {
    let known = scope_of(checker).bound.effects.map(|binding: Binding| binding.name);
    let first = if known.len() == 0 { b"declare it with `effect <name> { .. }`" }
    else { b"effects in scope: ".concat(backticked(known, b", ")) };
    let notes = match exporter(checker, EffectSpace, n) {
      Some(i) ->
        [
          first,
          Bytes::concat_all([
            b"module `",
            module_name(checker, i),
            b"` declares it: `import ",
            module_name(checker, i),
            b"` and write `",
            default_binder(module_name(checker, i)),
            b"::",
            n,
            b"`",
          ]),
        ],
      None -> [first],
    };
    report_error_at(checker, b"E0103", qname.span, message, b"not declared", notes)
  }
}

pub fn duplicate(checker: Checker, name: Identifier, prev: Location, what: Bytes) -> Checker =
  report_error_at_and(
    checker,
    b"E0105",
    name.span,
    Bytes::concat_all([what, b" `", name.name, b"` is defined more than once"]),
    b"redefined here",
    prev,
    b"first defined here",
    [b"rename one of them"],
  )

fn record_type(
  checker: Checker,
  parsed: ParsedModule,
  definition: TypeDefinition,
) -> Checker / {abort.raise} = {
  let name = qualify(parsed.name, definition.name.name);
  match checker.types.get(name) {
    Some(prev) ->
      duplicate(checker, definition.name, { module: prev.owner, span: prev.span }, b"type"),
    None -> match builtin_type_arity(definition.name.name) {
      Some(_) ->
        report_error_at(
          checker,
          b"E0105",
          definition.name.span,
          Bytes::concat_all([b"`", definition.name.name, b"` is a builtin type"]),
          b"cannot be redefined",
          [b"choose a different name for this type"],
        ),
      None -> {
        let declared = match definition.body {
          AliasBody(t) -> DeclaredAlias(t),
          NominalBody(t) -> DeclaredRecord(t),
          SumBody(_) -> DeclaredSum,
          ExternBody -> DeclaredExtern,
        };
        let s = declared_constraints(checker, definition);
        {
          ..s.checker,
          types: s.checker.types.insert(name, {
            params: identifier_names(definition.generics.types),
            labels: identifier_names(definition.generics.labels),
            effect_params: identifier_names(definition.generics.effects),
            constraints: dedup_constraints(s.constraints),
            declared: declared,
            opaque: definition.opaque,
            owner: checker.module,
            span: definition.span,
          }),
          stated: if s.constraints.len() == 0 { s.checker.stated }
          else { s.checker.stated.insert(name, dedup_constraints(s.constraints)) },
        }
      },
    },
  }
}

fn declared_constraints(
  checker: Checker,
  definition: TypeDefinition,
) -> { checker: Checker, constraints: List<DefinitionConstraint> } / {abort.raise} =
  definition.constraints.fold(
    { checker: checker, constraints: [] },
    |acc: { checker: Checker, constraints: List<DefinitionConstraint> }, c: Constraint| {
      let position = match definition.generics.types.find_index(|ident: Identifier|
          ident.name == c.param.name) {
        Some(i) -> i,
        None -> 0 - 1,
      };
      if position < 0 {
        {
          checker: report_error_at(
            acc.checker,
            b"E0102",
            c.param.span,
            Bytes::concat_all([b"`", c.param.name, b"` is not a type parameter of this type"]),
            b"not bound by the generic list",
            [
              if definition.generics.types.len() == 0 {
                Bytes::concat_all([
                  b"`",
                  definition.name.name,
                  b"` takes no type parameters, and a constraint on a concrete type is either already true or already an error",
                ])
              } else {
                b"this type binds ".concat(
                  backticked(definition.generics.types.map(|ident: Identifier| ident.name), b", "),
                )
              },
            ],
          ),
          constraints: acc.constraints,
        }
      } else if is_predicate(c.deriver) {
        {
          checker: report_error_at(
            acc.checker,
            b"E0102",
            c.span,
            Bytes::concat_all([
              b"`",
              constraint_written(c.deriver, c.param.name),
              b"` is a constraint only a `fn` writes",
            ]),
            b"a predicate cannot state of a type",
            [
              b"a predicate's witness is an argument each call passes, and a type is written and built with no call to pass one",
              b"the constraints a type takes are `derivable` of `json`, `eq`, `ord`, `bin`, `show` and `hash`",
            ],
          ),
          constraints: acc.constraints,
        }
      } else {
        {
          checker: acc.checker,
          constraints: insert_constraint(acc.constraints, { deriver: c.deriver, param: position }),
        }
      }
    },
  )

pub fn collect_types(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} =
  parsed.module.items.fold(checker, |c: Checker, item: Item|
    match item { TypeItem(d) -> record_type(c, parsed, d), _ -> c })

fn scope_brand(ty: Type) -> Option<Bytes> =
  match ty {
    NamedType(c) -> if c.name == scoped_name() || is_scheduler_handle(c.name) { Some(c.name) }
    else { first_reason(c.args, scope_brand) },
    FunctionType(f) -> match first_reason(f.params, scope_brand) {
      Some(b) -> Some(b),
      None -> scope_brand(f.ret),
    },
    RecordType(fs) -> first_reason(fs, |f: Field| scope_brand(f.ty)),
    NominalType(n) -> first_reason(n.fields, |f: Field| scope_brand(f.ty)),
    VariableType(_) -> None,
  }

fn reject_scoped_type(
  checker: Checker,
  ty: Type,
  span: Span,
  owner: Bytes,
  what: Bytes,
) -> Checker =
  match scope_brand(ty) {
    None -> checker,
    Some(brand) ->
      report_error_at(
        checker,
        b"E0446",
        span,
        Bytes::concat_all([b"`", owner, b"`'s ", what, b" mentions a `", brand, b"`"]),
        b"a declaration is outside every scope there is",
        [
          Bytes::concat_all([
            b"a declaration is fixed once for the whole program, so it cannot say which scope a `",
            brand,
            b"` in it came from, and no later check could tell that the `",
            brand,
            b"` had outlived its scope",
          ]),
          Bytes::concat_all([
            b"take the `",
            brand,
            b"` as a type parameter instead, so it stays in the type argument, where the escape check can see it",
          ]),
        ],
      ),
  }

fn first_scoped_effect(ty: Type) -> Option<Bytes> =
  match ty {
    VariableType(_) -> None,
    NamedType(c) -> first_reason(c.args, first_scoped_effect),
    RecordType(fs) -> first_reason(fs, |f: Field| first_scoped_effect(f.ty)),
    NominalType(n) -> first_reason(n.fields, |f: Field| first_scoped_effect(f.ty)),
    FunctionType(f) -> if f.effects.listed.fold(false, |b: Bool, entry: Effect|
        b || entry.effect == scoped_effect()) { Some(b"`Scoped`") }
    else if effects_include_brand(f.effects, Tasks) { Some(b"`Task` or a `Chan`") } else {
      match first_reason(f.params, first_scoped_effect) {
        Some(b) -> Some(b),
        None -> first_scoped_effect(f.ret),
      }
    },
  }

fn reject_scoped_effect(
  checker: Checker,
  ty: Type,
  span: Span,
  owner: Bytes,
  what: Bytes,
  notes: List<Bytes>,
) -> Checker =
  match first_scoped_effect(ty) {
    None -> checker,
    Some(reached) ->
      report_error_at(
        checker,
        b"E0446",
        span,
        Bytes::concat_all([
          b"`",
          owner,
          b"`'s ",
          what,
          b" holds a function whose effects reach a ",
          reached,
        ]),
        b"a declaration is outside every scope there is",
        notes,
      ),
  }

fn variant_scoped_notes() -> List<Bytes> =
  [
    b"a declared type hides the effects of the functions it holds, so no later check could tell that this one had outlived the scope it reaches",
    b"take the effects as an effect variable instead, `type T<| e> = ..`, so it stays in the type argument, where the escape check can see it",
  ]

fn operation_scoped_notes() -> List<Bytes> =
  [
    b"an operation's handler may be installed anywhere, and may keep what it is handed in a variable that outlives the scope the function reaches",
    b"take the effects as an effect variable of the operation, `write put<| e>(f: () -> Int / e) -> Unit`, which no clause can keep a function of",
  ]

pub fn collect_effects(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} =
  parsed.module.items.fold(checker, |c: Checker, item: Item|
    match item {
      EffectItem(definition) -> {
        let name = qualify(parsed.name, definition.name.name);
        if is_scoped_effect(definition.name.name) {
          report_error_at(
            c,
            b"E0105",
            definition.name.span,
            Bytes::concat_all([b"`", definition.name.name, b"` is a builtin effect"]),
            Bytes::concat_all([b"reserved for `with_", definition.name.name, b"` scopes"]),
            [b"rename this effect"],
          )
        } else if is_prelude_effect(name) {
          report_error_at(
            c,
            b"E0105",
            definition.name.span,
            Bytes::concat_all([b"`", name, b"` is a prelude effect"]),
            b"declared by the language",
            [
              b"the language declares `task`, `clock`, `random`, `sim` and `abort`; `simulate { .. }` handles the first three",
              Bytes::concat_all([
                b"rename this effect, or put it in a named module, where its program-wide name would be `<module>.",
                definition.name.name,
                b"` and would shadow the prelude",
              ]),
            ],
          )
        } else {
          match effect_of(c, name) {
            Some(prev) -> duplicate(c, definition.name, prev.at, b"effect"),
            None -> {
              let ops = definition.operations.fold(
                { checker: c, operations: [] },
                |acc: { checker: Checker, operations: List<OpInfo> }, op: OpDefinition|
                  if acc.operations.fold(false, |b: Bool, op_info: OpInfo|
                      b || op_info.name == op.name.name) {
                    let prev = acc.operations.fold(dummy_span(), |span: Span, op_info: OpInfo|
                      if op_info.name == op.name.name { op_info.at.span } else { span });
                    {
                      checker: duplicate(
                        acc.checker,
                        op.name,
                        { module: acc.checker.module, span: prev },
                        b"operation",
                      ),
                      operations: acc.operations,
                    }
                  } else {
                    let bound: Checker = bind_type_params(
                      { ..acc.checker, type_params: Map::new() },
                      op.type_params,
                    );
                    let c1: Checker = {
                      ..bound,
                      assumed: bound.type_params.fold(
                        bound.assumed,
                        |xs: List<Assumption>, k: Bytes, t: Type|
                          match t { VariableType(v) -> assume(xs, OrdDeriver, v), _ -> xs },
                      ),
                    };
                    let ps: WithTypes = convert_types(c1, op.params);
                    let r: WithType = if is_raise(op.mode) { new_type(ps.checker) }
                    else { convert_type(ps.checker, op.ret) };
                    let c2: Checker = {
                      ..r.checker,
                      type_params: Map::new(),
                      assumed: acc.checker.assumed,
                    };
                    let c3: Checker = range(0, ps.types.len()).fold(c2, |cc: Checker, i: Int| {
                      let what = b"parameter ".concat(ascii_of_int(i + 1));
                      let at = type_span(op.params.get(i));
                      reject_scoped_effect(
                        reject_scoped_type(cc, ps.types.get(i), at, op.name.name, what),
                        ps.types.get(i),
                        at,
                        op.name.name,
                        what,
                        operation_scoped_notes(),
                      )
                    });
                    let c4 = reject_scoped_effect(
                      reject_scoped_type(c3, r.ty, type_span(op.ret), op.name.name, b"result"),
                      r.ty,
                      type_span(op.ret),
                      op.name.name,
                      b"result",
                      operation_scoped_notes(),
                    );
                    {
                      checker: c4,
                      operations: acc.operations.push({
                        name: op.name.name,
                        mode: op.mode,
                        resource_param: op.resource_param,
                        params: ps.types,
                        kept: op.kept,
                        ret: r.ty,
                        at: location_of(c4, op.span),
                        scheme: None,
                      }),
                    }
                  },
              );
              add_effect(ops.checker, {
                name: name,
                module: parsed.name,
                simple_name: definition.name.name,
                nondet: definition.is_nondet,
                operations: ops.operations,
                at: location_of(ops.checker, definition.span),
              })
            },
          }
        }
      },
      _ -> c,
    })

pub fn collect_constructors(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} =
  parsed.module.items.fold(checker, |c: Checker, item: Item|
    match item {
      TypeItem(definition) -> match definition.body {
        AliasBody(_) -> c,
        NominalBody(_) -> c,
        ExternBody -> c,
        SumBody(variants) -> {
          let type_name = qualify(parsed.name, definition.name.name);
          match c.types.get(type_name) {
            None -> c,
            Some(declaration) -> {
              let vars: { checker: Checker, vars: List<Int>, params: Map<Bytes, Type> } = declaration.params.fold(
                { checker: c, vars: [], params: Map::new() },
                |acc: { checker: Checker, vars: List<Int>, params: Map<Bytes, Type> }, p: Bytes| {
                  let o: WithVar = new_type_var(acc.checker);
                  {
                    checker: o.checker,
                    vars: acc.vars.push(o.var),
                    params: acc.params.insert(p, VariableType(o.var)),
                  }
                },
              );
              let own = bind_declaration_params(
                { ..vars.checker, type_params: vars.params },
                declaration,
              );
              let c1: Checker = { ..own.checker, declaring_type: type_name };
              let result = NamedType({
                name: type_name,
                args: applied_args(
                  vars.vars.map(|v: Int| VariableType(v)),
                  own.labels.map(|v: Int| VariableType(v)),
                  own.effect_params.map(open_effects),
                ),
              });
              let walked: Checker = range(0, variants.len()).fold(c1, |cc: Checker, index: Int| {
                let variant = variants.get(index);
                let ctor = qualify(parsed.name, variant.name.name);
                match constructor_of(cc, ctor) {
                  Some(prev) -> duplicate(cc, variant.name, prev.at, b"constructor"),
                  None -> {
                    let fs: WithTypes = convert_types(cc, variant.fields);
                    let checked: Checker = range(0, fs.types.len()).fold(
                      fs.checker,
                      |c3: Checker, i: Int|
                        reject_scoped_effect(
                          reject_scoped_type(
                            c3,
                            fs.types.get(i),
                            type_span(variant.fields.get(i)),
                            variant.name.name,
                            b"field ".concat(ascii_of_int(i + 1)),
                          ),
                          fs.types.get(i),
                          type_span(variant.fields.get(i)),
                          variant.name.name,
                          b"field ".concat(ascii_of_int(i + 1)),
                          variant_scoped_notes(),
                        ),
                    );
                    let ty = if fs.types.len() == 0 { result }
                    else { fn_type(fs.types, result, no_effects()) };
                    let sc = {
                      type_variables: vars.vars,
                      effect_variables: own.effect_params,
                      keep_variables: [],
                      label_variables: own.labels,
                      ty: ty,
                    };
                    add_constructor({ ..checked, env: env_bind_global(checked.env, ctor, sc) }, {
                      name: ctor,
                      module: parsed.name,
                      simple_name: variant.name.name,
                      type_name: type_name,
                      index: index,
                      arity: fs.types.len(),
                      fields: fs.types,
                      scheme: sc,
                      at: location_of(checked, variant.span),
                    })
                  },
                }
              });
              {
                ..walked,
                type_params: Map::new(),
                effect_params: Map::new(),
                label_params: Map::new(),
                declaring_type: c.declaring_type,
              }
            },
          }
        },
      },
      _ -> c,
    })

pub fn reject_irregular(checker: Checker, parsed: ParsedModule) -> Checker = {
  let generic = parsed.module.items.fold([], |acc: List<TypeDefinition>, item: Item|
    match item {
      TypeItem(definition) -> match definition.body {
        SumBody(_) -> if definition.generics.types.len() > 0 { acc.push(definition) } else { acc },
        _ -> acc,
      },
      _ -> acc,
    });
  if generic.len() == 0 { checker } else {
    let sums = checker.constructors.fold(
      Map::new(),
      |m: Map<Bytes, List<SumCase>>, c: ConstructorInfo| {
        let had = match m.get(c.type_name) { Some(cs) -> cs, None -> [] };
        m.insert(c.type_name, had.push({ fields: c.fields, params: c.scheme.type_variables }))
      },
    );
    generic.fold(checker, |c: Checker, definition: TypeDefinition|
      if !grows_itself(sums, qualify(parsed.name, definition.name.name)) { c } else {
        report_error_at(
          c,
          b"E0477",
          definition.name.span,
          Bytes::concat_all([
            b"sum `",
            definition.name.name,
            b"` holds itself at a type grown from its own parameters",
          ]),
          b"declared here",
          [b"a sum may contain itself at its own parameters, or through a function"],
        )
      })
  }
}

type SumCase = { fields: List<Type>, params: List<Int> }

type ParamStep = { from: Bytes, to: Bytes, grown: Bool }

fn grows_itself(sums: Map<Bytes, List<SumCase>>, name: Bytes) -> Bool = {
  let steps = sums_reached(sums, name).fold([], |acc: List<ParamStep>, s: Bytes|
    acc.concat(param_steps(sums, s)));
  let from = |p: Bytes| positions_reached(steps, p).push(p);
  let own = steps.fold([], |acc: List<Bytes>, s: ParamStep|
    if s.from.starts_with(name.concat(b"#")) && !acc.contains(s.from) { acc.push(s.from) }
    else { acc });
  steps.any(|s: ParamStep|
    s.grown && own.any(|p: Bytes| from(s.to).contains(p) && from(p).contains(s.from)))
}

fn sums_reached(sums: Map<Bytes, List<SumCase>>, name: Bytes) -> List<Bytes> =
  range(0, sums.len()).fold(
    { seen: [name], at: 0 },
    |s: { seen: List<Bytes>, at: Int }, _: Int|
      match s.seen.at(s.at) {
        None -> s,
        Some(n) -> {
          let held = match sums.get(n) {
            None -> [],
            Some(cs) ->
              cs.fold([], |acc: List<Bytes>, c: SumCase|
                c.fields.fold(acc, |a: List<Bytes>, f: Type|
                  a.concat(sums_in(sums, f).map(|o: { name: Bytes, args: List<Type> }| o.name)))),
          };
          {
            seen: held.fold(s.seen, |acc: List<Bytes>, o: Bytes|
              if acc.contains(o) { acc } else { acc.push(o) }),
            at: s.at + 1,
          }
        },
      },
  ).seen

fn param_steps(sums: Map<Bytes, List<SumCase>>, s: Bytes) -> List<ParamStep> =
  match sums.get(s) {
    None -> [],
    Some(cs) ->
      cs.fold([], |acc: List<ParamStep>, c: SumCase|
        c.fields.fold(acc, |a: List<ParamStep>, f: Type|
          sums_in(sums, f).fold(a, |b: List<ParamStep>, o: { name: Bytes, args: List<Type> }|
            range(0, o.args.len()).fold(b, |d: List<ParamStep>, j: Int|
              range(0, c.params.len()).fold(d, |e: List<ParamStep>, i: Int|
                match c.params.at(i) {
                  None -> e,
                  Some(p) -> match o.args.at(j) {
                    None -> e,
                    Some(arg) -> {
                      let step = |grown: Bool|
                        e.push({
                          from: s.concat(b"#").concat(ascii_of_int(i)),
                          to: o.name.concat(b"#").concat(ascii_of_int(j)),
                          grown: grown,
                        });
                      if arg == VariableType(p) { step(false) }
                      else if variables_of(arg).contains(p) { step(true) }
                      else { e }
                    },
                  },
                }))))),
  }

fn sums_in(sums: Map<Bytes, List<SumCase>>, t: Type) -> List<{ name: Bytes, args: List<Type> }> =
  match t {
    VariableType(_) -> [],
    FunctionType(_) -> [],
    NamedType(k) -> {
      let inner = k.args.fold([], |acc: List<{ name: Bytes, args: List<Type> }>, a: Type|
        acc.concat(sums_in(sums, a)));
      if sums.contains(k.name) { inner.push({ name: k.name, args: k.args }) } else { inner }
    },
    RecordType(fs) ->
      fs.fold([], |acc: List<{ name: Bytes, args: List<Type> }>, f: Field|
        acc.concat(sums_in(sums, f.ty))),
    NominalType(x) ->
      x.fields.fold(
        x.args.fold([], |acc: List<{ name: Bytes, args: List<Type> }>, a: Type|
          acc.concat(sums_in(sums, a))),
        |acc: List<{ name: Bytes, args: List<Type> }>, f: Field| acc.concat(sums_in(sums, f.ty)),
      ),
  }

fn variables_of(t: Type) -> List<Int> =
  match t {
    VariableType(v) -> [v],
    FunctionType(_) -> [],
    NamedType(k) -> k.args.fold([], |acc: List<Int>, a: Type| acc.concat(variables_of(a))),
    RecordType(fs) -> fs.fold([], |acc: List<Int>, f: Field| acc.concat(variables_of(f.ty))),
    NominalType(x) -> x.args.fold([], |acc: List<Int>, a: Type| acc.concat(variables_of(a))),
  }

fn positions_reached(steps: List<ParamStep>, from: Bytes) -> List<Bytes> = {
  let next = |n: Bytes| steps.filter(|s: ParamStep| s.from == n).map(|s: ParamStep| s.to);
  range(0, steps.len()).fold(next(from), |seen: List<Bytes>, _: Int|
    seen.fold(seen, |acc: List<Bytes>, n: Bytes|
      next(n).fold(acc, |more: List<Bytes>, m: Bytes|
        if more.contains(m) { more } else { more.push(m) })))
}

pub fn check_value_namespace(checker: Checker, parsed: ParsedModule) -> Checker = {
  let walked = parsed.module.items.fold(
    { checker: checker, seen: [] },
    |acc: { checker: Checker, seen: List<{ name: Bytes, span: Span, is_fn: Bool }> }, item: Item| {
      let declared = match item {
        FunctionItem(d) -> [{ name: d.name, is_fn: true }],
        TypeItem(d) -> match d.body {
          SumBody(vs) -> vs.map(|variant: VariantDefinition| { name: variant.name, is_fn: false }),
          AliasBody(_) -> [],
          NominalBody(_) -> [],
          ExternBody -> [],
        },
        _ -> [],
      };
      declared.fold(
        acc,
        |a: { checker: Checker, seen: List<{ name: Bytes, span: Span, is_fn: Bool }> }, x: { name: Identifier, is_fn: Bool }| {
          let prev = a.seen.fold(
            None,
            |p: Option<{ name: Bytes, span: Span, is_fn: Bool }>, s: { name: Bytes, span: Span, is_fn: Bool }|
              match p { Some(_) -> p, None -> if s.name == x.name.name { Some(s) } else { None } },
          );
          match prev {
            None ->
              { ..a, seen: a.seen.push({ name: x.name.name, span: x.name.span, is_fn: x.is_fn }) },
            Some(first) -> if first.is_fn == x.is_fn { a } else {
              let later = if x.is_fn { b"function" } else { b"constructor" };
              let earlier = if x.is_fn { b"constructor" } else { b"function" };
              let where_ = if parsed.name.len() == 0 { b"" }
              else { Bytes::concat_all([b" in module `", parsed.name, b"`"]) };
              {
                ..a,
                checker: report_error_at_and(
                  a.checker,
                  b"E0105",
                  x.name.span,
                  Bytes::concat_all([b"`", x.name.name, b"` is defined twice", where_]),
                  Bytes::concat_all([b"redefined here as a ", later]),
                  { module: a.checker.module, span: first.span },
                  Bytes::concat_all([b"first defined here as a ", earlier]),
                  [
                    Bytes::concat_all([
                      b"functions and constructors share one namespace: nothing written `",
                      x.name.name,
                      b"` could say which of the two it means",
                    ]),
                    b"rename one of them",
                  ],
                ),
              }
            },
          }
        },
      )
    },
  );
  walked.checker
}

pub fn constraints_in_force(
  checker: Checker,
  cs: List<Constraint>,
) -> List<Assumption> / {abort.raise} =
  cs.fold([], |acc: List<Assumption>, c: Constraint|
    match checker.type_params.get(c.param.name) {
      Some(VariableType(v)) -> assume(acc, c.deriver, v),
      _ -> acc,
    })

pub fn assume(xs: List<Assumption>, deriver: Deriver, v: Int) -> List<Assumption> / {abort.raise} = {
  let hit = range(0, xs.len()).fold(None, |acc: Option<Int>, i: Int|
    match acc {
      Some(_) -> acc,
      None -> if xs.get(i).deriver == deriver { Some(i) } else { None },
    });
  match hit {
    Some(i) -> {
      let x = xs.get(i);
      xs.set(i, { deriver: x.deriver, vars: ints_insert(x.vars, v) })
    },
    None -> xs.push({ deriver: deriver, vars: [v] }),
  }
}

fn check_where(checker: Checker, definition: FnDefinition) -> Checker / {abort.raise} =
  definition.constraints.fold(checker, |c: Checker, k: Constraint|
    if c.type_params.contains(k.param.name) { c } else {
      let bound = definition.generics.types.map(|ident: Identifier| ident.name);
      report_error_at(
        c,
        b"E0102",
        k.param.span,
        Bytes::concat_all([b"`", k.param.name, b"` is not a type parameter of this signature"]),
        b"not bound by the generic list",
        [
          if bound.len() == 0 {
            Bytes::concat_all([
              b"`",
              definition.name.name,
              b"` takes no type parameters, and a constraint on a concrete type is either already true or already an error",
            ])
          } else { b"this signature binds ".concat(backticked(bound, b", ")) },
        ],
      )
    })

fn bind_type_params(checker: Checker, names: List<Identifier>) -> Checker =
  names.fold(checker, |c: Checker, ident: Identifier| {
    let o: WithVar = new_type_var(c);
    {
      ..o.checker,
      substitution: mark_rigid_type(o.checker.substitution, o.var),
      type_params: o.checker.type_params.insert(ident.name, VariableType(o.var)),
    }
  })

pub fn member_scheme(
  checker: Checker,
  definition: FnDefinition,
  sig: Signature,
) -> Scheme / {abort.raise} = {
  let free = free_variables(checker.substitution, sig.fn_type, { types: [], effect_variables: [] });
  {
    type_variables: definition.generics.types.fold([], |vs: List<Int>, ident: Identifier|
      match sig.type_params.get(ident.name) {
        Some(VariableType(v)) -> if free.types.contains(v) { vs.push(v) } else { vs },
        _ -> vs,
      }),
    effect_variables: definition.generics.effects.fold([], |vs: List<Int>, ident: Identifier|
      match sig.effect_params.get(ident.name) {
        Some(v) -> if free.effect_variables.contains(v) { vs.push(v) } else { vs },
        None -> vs,
      }),
    keep_variables: definition.generics.kept.fold([], |vs: List<Int>, ident: Identifier|
      match sig.type_params.get(ident.name) {
        Some(VariableType(v)) -> if free.types.contains(v) { vs.push(v) } else { vs },
        _ -> vs,
      }),
    label_variables: definition.generics.labels.fold([], |vs: List<Int>, ident: Identifier|
      match sig.label_params.get(ident.name) { Some(v) -> vs.push(v), None -> vs }),
    ty: sig.fn_type,
  }
}

pub fn written_signature(
  outer: Checker,
  definition: FnDefinition,
) -> { checker: Checker, sig: Signature } / {abort.raise} = {
  let checker: Checker = {
    ..outer,
    scope: outer.scope + 1,
    type_params: Map::new(),
    effect_params: Map::new(),
    label_params: Map::new(),
  };
  let types: Checker = bind_type_params(checker, definition.generics.types);
  let with_effects: Checker = definition.generics.effects.fold(
    types,
    |c: Checker, p: Identifier| {
      let o: WithVar = new_effect_variable(c);
      {
        ..o.checker,
        substitution: mark_rigid_effects(o.checker.substitution, o.var),
        effect_params: o.checker.effect_params.insert(p.name, o.var),
      }
    },
  );
  let labels: Checker = definition.generics.labels.fold(
    with_effects,
    |c: Checker, p: Identifier| {
      let o: WithVar = new_type_var(c);
      {
        ..o.checker,
        substitution: mark_rigid_type(o.checker.substitution, o.var),
        label_params: o.checker.label_params.insert(p.name, o.var),
      }
    },
  );
  let assumed: Checker = note_witness_params(
    { ..labels, assumed: constraints_in_force(labels, definition.constraints) },
    definition.constraints,
  );
  let checked: Checker = check_where(assumed, definition);
  let params = definition.params.fold(
    { checker: checked, types: [] },
    |acc: { checker: Checker, types: List<Type> }, p: Param|
      match p.ty {
        Some(t) -> {
          let o: WithType = convert_type(acc.checker, t);
          { checker: check_scoped_placement(o.checker, t, o.ty, true), types: acc.types.push(o.ty) }
        },
        None -> {
          let o: WithType = new_type(acc.checker);
          { checker: o.checker, types: acc.types.push(o.ty) }
        },
      },
  );
  let ret: WithType = match definition.ret {
    Some(t) -> {
      let o: WithType = convert_type(params.checker, t);
      { checker: check_scoped_placement(o.checker, t, o.ty, false), ty: o.ty }
    },
    None -> new_type(params.checker),
  };
  let declared: { checker: Checker, r: Option<Effects>, bounded: List<Effect> } = match definition.effects {
    Some(r) -> {
      let o = convert_bounded_effects(ret.checker, r);
      { checker: o.checker, r: Some(o.r), bounded: o.bounded }
    },
    None -> { checker: ret.checker, r: Some(no_effects()), bounded: [] },
  };
  let effects: WithEffects = match declared.r {
    Some(r) -> { checker: declared.checker, effects: r },
    None -> new_effects(declared.checker),
  };
  let c: Checker = effects.checker;
  {
    checker: { ..c, type_params: Map::new(), effect_params: Map::new(), label_params: Map::new() },
    sig: {
      type_params: c.type_params,
      effect_params: c.effect_params,
      label_params: c.label_params,
      fn_type: owning_fn_type(
        params.types,
        range(0, definition.params.len()).filter(|i: Int| definition.params.get(i).keep),
        false,
        ret.ty,
        effects.effects,
      ),
      params: params.types,
      ret: ret.ty,
      declared: declared.r,
      published_effects: effects.effects,
      promised_bounded: declared.bounded,
      variable_bounded: match definition.effects { Some(r) -> r.variable_bounded, None -> false },
      scope: c.scope,
    },
  }
}

fn keeps_scoped(ty: Type, passed: Bool) -> Bool =
  match ty {
    VariableType(_) -> false,
    NamedType(c) ->
      (c.name == scoped_name() && !passed)
        || c.args.fold(false, |b: Bool, a: Type| b || keeps_scoped(a, false)),
    FunctionType(f) ->
      f.params.fold(false, |b: Bool, p: Type| b || keeps_scoped(p, true))
        || keeps_scoped(f.ret, false),
    RecordType(fs) -> fs.fold(false, |b: Bool, f: Field| b || keeps_scoped(f.ty, false)),
    NominalType(n) -> n.args.fold(false, |b: Bool, a: Type| b || keeps_scoped(a, false)),
  }

pub fn check_scoped_placement(
  checker: Checker,
  written: TypeExpression,
  ty: Type,
  passed: Bool,
) -> Checker / {abort.raise} =
  if !keeps_scoped(resolve(checker, ty), passed) { checker } else {
    report_error_at(
      checker,
      b"E0446",
      type_span(written),
      b"a `Scoped` is written where it would be kept",
      b"a scoped value is passed down, never kept",
      [
        b"a scoped value is a parameter of a definition, a lambda or a function type: it is not returned, stored in another value or bound by an annotation",
        b"read it where it is passed, with `Scoped::get`, and keep what the read answers",
      ],
    )
  }

pub fn open_scope_named(checker: Checker, name: Bytes) -> Option<OpenScope> =
  checker.open_scopes.fold(None, |acc: Option<OpenScope>, scope: OpenScope|
    if scope.name == name { Some(scope) } else { acc })

fn scope_label_for(checker: Checker, eff: Bytes, name: Bytes) -> Bytes =
  if !is_scoped_effect(eff) { name }
  else { match open_scope_named(checker, name) { Some(scope) -> scope.label, None -> name } }

pub fn first_reason<a | e>(xs: List<a>, f: (a) -> Option<Bytes> / e) -> Option<Bytes> / e =
  xs.fold(None, |acc: Option<Bytes>, x: a| match acc { Some(_) -> acc, None -> f(x) })

pub fn rigid_params(checker: Checker) -> List<RigidParam> =
  checker.type_params.fold([], |acc: List<RigidParam>, k: Bytes, ty: Type|
    match ty { VariableType(v) -> acc.push({ name: k, var: v }), _ -> acc })

pub fn assumed_for(checker: Checker, deriver: Deriver) -> List<Int> / {abort.raise} =
  checker.assumed.fold([], |acc: List<Int>, a: Assumption|
    if a.deriver == deriver || (deriver == NumericDeriver && a.deriver == IntegerDeriver) {
      a.vars.fold(acc, |b: List<Int>, v: Int| ints_insert(b, v))
    } else { acc })

pub type OrderedPart = { key: Type, container: Option<Type> }

pub fn own_parts(
  carrying: Map<Bytes, List<Int>>,
  t: Type,
  out: List<OrderedPart>,
) -> List<OrderedPart> = {
  let carried = |name: Bytes, args: List<Type>|
    if carrying.len() == 0 { out } else {
      match carrying.get(name) {
        None -> out,
        Some(ps) ->
          ps.fold(out, |acc: List<OrderedPart>, j: Int|
            match args.at(j) { Some(a) -> acc.push({ key: a, container: Some(t) }), None -> acc }),
      }
    };
  match t {
    NamedType(c) -> match map_parts(t) {
      Some(p) -> out.push({ key: p.key, container: None }),
      None -> if builtin_type_arity(c.name) != None { out } else { carried(c.name, c.args) },
    },
    NominalType(n) -> carried(n.name, n.args),
    _ -> out,
  }
}

pub fn note_type_constraints(
  checker: Checker,
  span: Span,
  name: Bytes,
  args: List<Type>,
) -> Checker / {abort.raise} =
  if checker.declaring_type != b"" { checker } else {
    match checker.stated.get(name) {
      None -> checker,
      Some(cs) ->
        cs.fold(checker, |c: Checker, dc: DefinitionConstraint|
          match args.at(dc.param) {
            None -> c,
            Some(ty) ->
              note_type_constraint(c, span, dc.deriver, ty, name, match c.types.get(name) {
                Some(declaration) ->
                  declaration.constraints.any(|w: DefinitionConstraint|
                    w.param == dc.param && w.deriver == dc.deriver),
                None -> false,
              }),
          }),
    }
  }

pub fn note_type_constraint(
  checker: Checker,
  span: Span,
  deriver: Deriver,
  ty: Type,
  callee: Bytes,
  written: Bool,
) -> Checker / {abort.raise} = {
  let callee_at = match checker.types.get(callee) {
    Some(declaration) -> { module: declaration.owner, span: declaration.span },
    None -> { module: checker.module, span: span },
  };
  {
    ..checker,
    constrained_uses: checker.constrained_uses.push({
      module: checker.module,
      span: span,
      deriver: deriver,
      param: 0,
      ty: ty,
      callee: callee,
      callee_at: callee_at,
      assumed: assumed_for(checker, deriver),
      params: rigid_params(checker),
      called: true,
      owner: checker.current_definition,
      written_on_type: Some(written),
    }),
  }
}

fn note_alias_constraints(checker: Checker, name: Bytes, args: List<Type>) -> Checker =
  if checker.declaring_type == b"" { checker } else {
    match checker.stated.get(name) {
      None -> checker,
      Some(cs) ->
        cs.fold(checker, |c: Checker, dc: DefinitionConstraint|
          match args.at(dc.param) {
            None -> c,
            Some(ty) ->
              {
                ..c,
                alias_constraints: c.alias_constraints.push({
                  type_name: c.declaring_type,
                  from: name,
                  deriver: dc.deriver,
                  ty: ty,
                }),
              },
          }),
    }
  }

pub fn note_parts(
  checker: Checker,
  span: Span,
  found: List<OrderedPart>,
) -> Checker / {abort.raise} =
  note_map_key_sites(
    checker,
    span,
    found.map(|p: OrderedPart| { key: p.key, whole_key: p.key, container: p.container }),
  )

pub type OrderedKey = { key: Type, whole_key: Type, container: Option<Type> }

pub fn note_map_key_sites(
  checker: Checker,
  span: Span,
  found: List<OrderedKey>,
) -> Checker / {abort.raise} =
  if found.len() == 0 { checker } else {
    let assumed = assumed_for(checker, OrdDeriver);
    let params = rigid_params(checker);
    {
      ..checker,
      map_keys: checker.map_keys.concat(
        found.map(|j: OrderedKey|
          {
            module: checker.module,
            span: span,
            scope: checker.scope,
            key: j.key,
            whole: j.whole_key,
            carrier: j.container,
            assumed: assumed,
            params: params,
            via: b"",
          }),
      ),
    }
  }

fn sites_from(sites: List<MapKeySite>, from: Int) -> List<MapKeySite> / {abort.raise} =
  range(from, sites.len()).fold([], |acc: List<MapKeySite>, i: Int| acc.push(sites.get(i)))

fn relocated_keys(
  sites: List<MapKeySite>,
  from: Int,
  module: Int,
  span: Span,
  alias: Bytes,
) -> List<MapKeySite> / {abort.raise} =
  range(from, sites.len()).fold(sites, |acc: List<MapKeySite>, i: Int| {
    let s = acc.get(i);
    acc.set(i, { ..s, module: module, span: span, via: alias })
  })

pub fn note_witness_params(checker: Checker, cs: List<Constraint>) -> Checker =
  cs.fold(checker, |c: Checker, k: Constraint|
    if !is_predicate(k.deriver) { c } else {
      match c.type_params.get(k.param.name) {
        Some(VariableType(v)) -> {
          let integer = k.deriver == IntegerDeriver
            || (match c.witnessed.get(v) { Some(w) -> w.integer, None -> false });
          { ..c, witnessed: c.witnessed.insert(v, { param: k.param.name, integer: integer }) }
        },
        _ -> c,
      }
    })

pub fn is_scheduler_handle(name: Bytes) -> Bool =
  name == task_name() || name == builtin_channel_name()

pub fn task_op(op: Bytes) -> Effect =
  { effect: b"task", resource: SingletonResource, mode: WriteMode, op: Some(op) }

pub fn effects_include_brand(effects: Effects, brand: ScopedValueKind) -> Bool =
  match brand {
    ScopedLabel(r) ->
      effects.listed.fold(false, |b: Bool, entry: Effect|
        b || (entry.effect == scoped_effect() && entry.resource == NamedResource(r))),
    Tasks ->
      [b"join", b"await", b"cancel"].concat(channel_ops()).fold(
        effects_cover(effects.listed, seed_effect()),
        |b: Bool, op: Bytes| b || effects_cover(effects.listed, task_op(op)),
      ),
  }
