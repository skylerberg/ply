//! The tree a check's walk builds of a body: each node with its type as the walk found it, under
//! the substitution so far, and what only settling the check decides still open: which scheme
//! variables a read filled, the labels it fills as variables, and which fields an update copies.
//! Settling makes the typed tree of it (`compiler.check.typed`).

import compiler.syntax.parsing (Span)
import compiler.syntax.patterns (Lit)
import compiler.check.types (Type, Row, Atom)
import compiler.check.typed (BodyPart, TypedPattern, TypedParam, TypedFieldPattern, TypedWild,
                             TypedBinder, TypedLitPattern, TypedRange, TypedCase,
                             TypedRecordPattern, TypedListPattern, TypedOr, TypedExpr, TypedNode,
                             TypedField, TypedArm, TypedStmt, TypedThunk, TypedClause, TypedReturn,
                             TypedHandlerVar, Reading, TypedLit, TypedRead, TypedUnary, TypedBinary,
                             TypedCall, TypedIf, TypedMatch, TypedBlock, TypedList, TypedRecord,
                             TypedUpdate, TypedFieldRead, TypedPerform, TypedLambda, TypedSimulate,
                             TypedParallel, TypedHandle, TypedLet, TypedLetElse, TypedDo,
                             TypedAssign, TypedRelease, release_placed)
import std.list

/// One node: what it is, where its text stands, and its type.
pub type Walked = { node: WalkedNode, span: Span, ty: Type }

pub type WalkedNode =
  | WalkedLit(Lit)
  | WalkedRead(WalkedReading)
  | WalkedUnary({ op: Bytes, operand: Walked })
  | WalkedBinary({ op: Bytes, lhs: Walked, rhs: Walked })
  /// `args` are in the callee's parameters' order, a default the call leaves out among them. `row`
  /// is what a call of a function value performs, as the type it calls through says; empty for a
  /// call of a definition, a constructor or a builtin, whose read says it.
  | WalkedCall({ callee: Walked, args: List<Walked>, row: Row })
  | WalkedIf({ cond: Walked, then_branch: Walked, else_branch: Walked })
  | WalkedMatch({ scrutinee: Walked, arms: List<WalkedArm> })
  | WalkedBlock({ stmts: List<WalkedStmt>, tail: Option<Walked> })
  | WalkedList(List<Walked>)
  | WalkedRecord(List<WalkedField>)
  /// `{ ..base, f: e }`: the fields the base supplies are its type's, which settling reads.
  | WalkedUpdate({ base: Walked, sets: List<WalkedField> })
  | WalkedFieldRead({ base: Walked, field: Bytes })
  /// `effect` is the effect's name across the program, `resource` the label as written, and `atom`
  /// what the perform performs.
  | WalkedPerform({ effect: Bytes, op: Bytes, resource: Option<Bytes>, atom: Atom, args: List<Walked> })
  /// `kept` are the places of the parameters written `keep`.
  | WalkedLambda({ params: List<TypedParam<Type>>, kept: List<Int>, body: Walked, row: Row })
  | WalkedSimulate(WalkedThunk)
  | WalkedParallel(List<WalkedThunk>)
  /// `row` is what the body performs. `vars` are the handler's variables, made before the body
  /// runs, which its clauses read and assign.
  | WalkedHandle({ body: Walked, row: Row, clauses: List<WalkedClause>, ret: Option<WalkedReturn>, vars: List<WalkedHandlerVar> })
  /// A default a call on a value copies, typed once the walk ends: its place among the walk's
  /// copies, where `defaults_filled` finds it.
  | WalkedDefault(Int)

/// What a name read as a value is, as the walk found it: a binder in scope; a definition, its
/// scheme's type variables filled by `args` and its row variables `quantified` by `rows`, where the
/// read instantiated the scheme, and the labels it fills, as types; a constructor of a declared sum
/// at the type arguments it fills; or a builtin at the type arguments and rows it fills, in its own
/// order. A read of a definition whose group the walk is inferring instantiates nothing: the group
/// shares its variables. A definition's `key` is the name the check holds its scheme under, which
/// for the prelude's functions is not `full`.
pub type WalkedReading =
  | WalkedLocal(Bytes)
  | WalkedDefinition({ full: Bytes, key: Bytes, args: List<Type>, rows: List<Row>, quantified: List<Int>, labels: List<Type> })
  | WalkedConstructor({ sum: Bytes, name: Bytes, case: Int, args: List<Type> })
  | WalkedBuiltin({ name: Bytes, args: List<Type>, rows: List<Row> })

/// A body run as a function of no parameters, and what it performs.
pub type WalkedThunk = { body: Walked, row: Row }

pub type WalkedField = { name: Bytes, value: Walked }

/// An arm, `pat_span` where its pattern is written.
pub type WalkedArm = {
  pat: TypedPattern<Type>,
  pat_span: Span,
  guard: Option<Walked>,
  body: Walked,
}

pub type WalkedStmt =
  | WalkedLet({ pat: TypedPattern<Type>, value: Walked, span: Span })
  /// `let p = v else { .. };`: where `pat` does not match, `fallback` is the block's value.
  | WalkedLetElse({ pat: TypedPattern<Type>, value: Walked, fallback: Walked, span: Span })
  | WalkedDo(Walked)
  /// `name = value;`: a clause giving its handler's variable a new value.
  | WalkedAssign({ name: Bytes, value: Walked, span: Span })

/// A clause of a `handle`, as `TypedClause` says.
pub type WalkedClause = {
  effect: Bytes,
  op: Bytes,
  resource: Option<Bytes>,
  every_label: Bool,
  params: List<TypedParam<Type>>,
  label: Option<TypedParam<Type>>,
  resume: Option<TypedParam<Type>>,
  body: Walked,
  row: Row,
  resumed: Row,
  span: Span,
}

/// A `handle`'s `return` clause, as `TypedReturn` says.
pub type WalkedReturn = { binder: TypedParam<Type>, body: Walked, row: Row, span: Span }

/// A variable a `handle` holds, as `TypedHandlerVar` says.
pub type WalkedHandlerVar = { name: Bytes, ty: Type, init: Walked, span: Span }

/// A body the walk typed: what owns it, which of its bodies it is, where its item's text starts,
/// the parameters it binds, and its tree.
pub type WalkedTree = {
  owner: Bytes,
  part: BodyPart,
  module: Int,
  base: Int,
  params: List<TypedParam<Type>>,
  body: Walked,
}

// --- Building nodes --------------------------------------------------------------------------------

// Each builder takes what the check found of a node's parts, none for a part the check reported an
// error in, and makes the node only where every part is there.

pub fn unary_of(op: Bytes, operand: Option<Walked>) -> Option<WalkedNode> =
  match operand { Some(x) -> Some(WalkedUnary({ op: op, operand: x })), None -> None }

pub fn binary_of(op: Bytes, lhs: Option<Walked>, rhs: Option<Walked>) -> Option<WalkedNode> =
  match ((lhs, rhs)) {
    (Some(l), Some(r)) -> Some(WalkedBinary({ op: op, lhs: l, rhs: r })),
    _ -> None,
  }

pub fn call_of(callee: Option<Walked>, args: List<Option<Walked>>, row: Row) -> Option<WalkedNode> =
  match ((callee, Option::all(args))) {
    (Some(f), Some(xs)) -> Some(WalkedCall({ callee: f, args: xs, row: row })),
    _ -> None,
  }

pub fn if_of(
  cond: Option<Walked>,
  then_branch: Option<Walked>,
  else_branch: Option<Walked>,
) -> Option<WalkedNode> =
  match ((cond, then_branch, else_branch)) {
    (Some(c), Some(t), Some(e)) -> Some(WalkedIf({ cond: c, then_branch: t, else_branch: e })),
    _ -> None,
  }

pub fn list_of(items: List<Option<Walked>>) -> Option<WalkedNode> =
  match Option::all(items) { Some(xs) -> Some(WalkedList(xs)), None -> None }

pub fn field_read_of(base: Option<Walked>, field: Bytes) -> Option<WalkedNode> =
  match base { Some(b) -> Some(WalkedFieldRead({ base: b, field: field })), None -> None }

pub fn record_of(fields: List<{ name: Bytes, value: Option<Walked> }>) -> Option<WalkedNode> =
  match fields.fold(
      Some([]),
      |acc: Option<List<WalkedField>>, f: { name: Bytes, value: Option<Walked> }|
        match ((acc, f.value)) {
          (Some(fs), Some(v)) -> Some(fs.push({ name: f.name, value: v })),
          _ -> None,
        },
    ) {
    Some(fs) -> Some(WalkedRecord(fs)),
    None -> None,
  }

pub fn arm_of(
  pat: Option<TypedPattern<Type>>,
  pat_span: Span,
  guard: Option<Option<Walked>>,
  body: Option<Walked>,
) -> Option<WalkedArm> =
  match ((pat, guard, body)) {
    (Some(p), Some(Some(g)), Some(b)) ->
      Some({ pat: p, pat_span: pat_span, guard: Some(g), body: b }),
    (Some(p), None, Some(b)) -> Some({ pat: p, pat_span: pat_span, guard: None, body: b }),
    _ -> None,
  }

pub fn match_of(scrutinee: Option<Walked>, arms: List<Option<WalkedArm>>) -> Option<WalkedNode> =
  match ((scrutinee, Option::all(arms))) {
    (Some(s), Some(xs)) -> Some(WalkedMatch({ scrutinee: s, arms: xs })),
    _ -> None,
  }

pub fn do_of(e: Option<Walked>) -> Option<WalkedStmt> =
  match e { Some(x) -> Some(WalkedDo(x)), None -> None }

pub fn let_of(
  pat: Option<TypedPattern<Type>>,
  value: Option<Walked>,
  span: Span,
) -> Option<WalkedStmt> =
  match ((pat, value)) {
    (Some(p), Some(v)) -> Some(WalkedLet({ pat: p, value: v, span: span })),
    _ -> None,
  }

pub fn let_else_of(
  pat: Option<TypedPattern<Type>>,
  value: Option<Walked>,
  fallback: Option<Walked>,
  span: Span,
) -> Option<WalkedStmt> =
  match ((pat, value, fallback)) {
    (Some(p), Some(v), Some(f)) ->
      Some(WalkedLetElse({ pat: p, value: v, fallback: f, span: span })),
    _ -> None,
  }

pub fn case_pattern_of(
  sum: Bytes,
  name: Bytes,
  case: Int,
  args: List<Option<TypedPattern<Type>>>,
) -> Option<TypedPattern<Type>> =
  match Option::all(args) {
    Some(ps) -> Some(TypedCase({ sum: sum, name: name, case: case, args: ps })),
    None -> None,
  }

pub fn list_pattern_of(
  items: List<Option<TypedPattern<Type>>>,
  rest: Option<Option<TypedPattern<Type>>>,
) -> Option<TypedPattern<Type>> =
  match ((Option::all(items), rest)) {
    (Some(ps), Some(Some(r))) -> Some(TypedListPattern({ items: ps, rest: Some(r) })),
    (Some(ps), None) -> Some(TypedListPattern({ items: ps, rest: None })),
    _ -> None,
  }

pub fn or_pattern_of(alts: List<Option<TypedPattern<Type>>>) -> Option<TypedPattern<Type>> =
  match Option::all(alts) { Some(ps) -> Some(TypedOr(ps)), None -> None }

pub fn record_pattern_of(
  fields: List<{ name: Bytes, pat: Option<TypedPattern<Type>> }>,
  rest: Option<{ span: Span, ty: Type }>,
) -> Option<TypedPattern<Type>> =
  match fields.fold(
      Some([]),
      |acc: Option<List<TypedFieldPattern<Type>>>, f: { name: Bytes, pat: Option<TypedPattern<Type>> }|
        match ((acc, f.pat)) {
          (Some(fs), Some(p)) -> Some(fs.push({ name: f.name, pat: p })),
          _ -> None,
        },
    ) {
    Some(fs) -> Some(TypedRecordPattern({ fields: fs, rest: rest })),
    None -> None,
  }

pub fn perform_of(
  effect_name: Bytes,
  op: Bytes,
  resource: Option<Bytes>,
  atom: Atom,
  args: List<Option<Walked>>,
) -> Option<WalkedNode> =
  match Option::all(args) {
    Some(xs) ->
      Some(
        WalkedPerform({ effect: effect_name, op: op, resource: resource, atom: atom, args: xs }),
      ),
    None -> None,
  }

pub fn simulate_of(body: Option<Walked>, row: Row) -> Option<WalkedNode> =
  match body { Some(b) -> Some(WalkedSimulate({ body: b, row: row })), None -> None }

pub fn parallel_of(branches: List<{ body: Option<Walked>, row: Row }>) -> Option<WalkedNode> =
  match branches.fold(
      Some([]),
      |acc: Option<List<WalkedThunk>>, b: { body: Option<Walked>, row: Row }|
        match ((acc, b.body)) {
          (Some(ts), Some(x)) -> Some(ts.push({ body: x, row: b.row })),
          _ -> None,
        },
    ) {
    Some(ts) -> Some(WalkedParallel(ts)),
    None -> None,
  }

/// The parameters `names` at the types `tys`, place for place; none where the two differ in length.
pub fn params_typed(
  names: List<{ name: Bytes, span: Span }>,
  tys: List<Type>,
) -> Option<List<TypedParam<Type>>> =
  match names.zip_strict(tys) {
    Some(ps) ->
      Some(
        ps.map(|p: { first: { name: Bytes, span: Span }, second: Type }|
          { name: p.first.name, ty: p.second, span: p.first.span }),
      ),
    None -> None,
  }

pub fn clause_of(
  head: { effect: Bytes, op: Bytes, resource: Option<Bytes>, every_label: Bool },
  params: Option<List<TypedParam<Type>>>,
  label: Option<TypedParam<Type>>,
  resume: Option<TypedParam<Type>>,
  body: Option<Walked>,
  row: Row,
  resumed: Row,
  span: Span,
) -> Option<WalkedClause> =
  match ((params, body)) {
    (Some(ps), Some(b)) ->
      Some({
        effect: head.effect,
        op: head.op,
        resource: head.resource,
        every_label: head.every_label,
        params: ps,
        label: label,
        resume: resume,
        body: b,
        row: row,
        resumed: resumed,
        span: span,
      }),
    _ -> None,
  }

pub fn return_of(
  binder: TypedParam<Type>,
  body: Option<Walked>,
  row: Row,
  span: Span,
) -> Option<WalkedReturn> =
  match body { Some(b) -> Some({ binder: binder, body: b, row: row, span: span }), None -> None }

pub fn handler_var_of(
  name: Bytes,
  ty: Type,
  init: Option<Walked>,
  span: Span,
) -> Option<WalkedHandlerVar> =
  match init { Some(i) -> Some({ name: name, ty: ty, init: i, span: span }), None -> None }

pub fn handle_of(
  body: Option<Walked>,
  row: Row,
  clauses: List<Option<WalkedClause>>,
  ret: Option<Option<WalkedReturn>>,
  vars: List<Option<WalkedHandlerVar>>,
) -> Option<WalkedNode> =
  match ((body, Option::all(clauses), ret, Option::all(vars))) {
    (Some(b), Some(cs), None, Some(vs)) ->
      Some(WalkedHandle({ body: b, row: row, clauses: cs, ret: None, vars: vs })),
    (Some(b), Some(cs), Some(Some(r)), Some(vs)) ->
      Some(WalkedHandle({ body: b, row: row, clauses: cs, ret: Some(r), vars: vs })),
    _ -> None,
  }

pub fn assign_of(name: Bytes, value: Option<Walked>, span: Span) -> Option<WalkedStmt> =
  match value { Some(v) -> Some(WalkedAssign({ name: name, value: v, span: span })), None -> None }

pub fn update_of(
  base: Option<Walked>,
  sets: List<{ name: Bytes, value: Option<Walked> }>,
) -> Option<WalkedNode> =
  match ((base, record_of(sets))) {
    (Some(b), Some(WalkedRecord(fs))) -> Some(WalkedUpdate({ base: b, sets: fs })),
    _ -> None,
  }

pub fn lambda_of(
  params: List<TypedParam<Type>>,
  kept: List<Int>,
  body: Option<Walked>,
  row: Row,
) -> Option<WalkedNode> =
  match body {
    Some(b) -> Some(WalkedLambda({ params: params, kept: kept, body: b, row: row })),
    None -> None,
  }

pub fn block_of(
  stmts: List<Option<WalkedStmt>>,
  tail: Option<Option<Walked>>,
) -> Option<WalkedNode> =
  match ((Option::all(stmts), tail)) {
    (Some(ss), Some(Some(t))) -> Some(WalkedBlock({ stmts: ss, tail: Some(t) })),
    (Some(ss), None) -> Some(WalkedBlock({ stmts: ss, tail: None })),
    _ -> None,
  }

// --- Walking the tree ------------------------------------------------------------------------------

/// `e` with each node rewritten by `f` once its parts are.
pub fn rewritten(e: Walked, f: (Walked) -> Walked) -> Walked = {
  let go = |x: Walked| rewritten(x, f);
  let opt = |x: Option<Walked>| match x { Some(y) -> Some(rewritten(y, f)), None -> None };
  f({
    ..e,
    node: match e.node {
      WalkedUnary(u) -> WalkedUnary({ ..u, operand: go(u.operand) }),
      WalkedBinary(b) -> WalkedBinary({ ..b, lhs: go(b.lhs), rhs: go(b.rhs) }),
      WalkedCall(c) -> WalkedCall({ ..c, callee: go(c.callee), args: c.args.map(go) }),
      WalkedIf(i) ->
        WalkedIf({
          cond: go(i.cond),
          then_branch: go(i.then_branch),
          else_branch: go(i.else_branch),
        }),
      WalkedMatch(m) ->
        WalkedMatch({
          scrutinee: go(m.scrutinee),
          arms: m.arms.map(|a: WalkedArm| { ..a, guard: opt(a.guard), body: go(a.body) }),
        }),
      WalkedBlock(b) ->
        WalkedBlock({
          stmts: b.stmts.map(|s: WalkedStmt|
            match s {
              WalkedLet(l) -> WalkedLet({ ..l, value: go(l.value) }),
              WalkedLetElse(l) ->
                WalkedLetElse({ ..l, value: go(l.value), fallback: go(l.fallback) }),
              WalkedDo(x) -> WalkedDo(go(x)),
              WalkedAssign(a) -> WalkedAssign({ ..a, value: go(a.value) }),
            }),
          tail: opt(b.tail),
        }),
      WalkedList(xs) -> WalkedList(xs.map(go)),
      WalkedRecord(fs) ->
        WalkedRecord(fs.map(|fd: WalkedField| { name: fd.name, value: go(fd.value) })),
      WalkedUpdate(u) ->
        WalkedUpdate({
          base: go(u.base),
          sets: u.sets.map(|fd: WalkedField| { name: fd.name, value: go(fd.value) }),
        }),
      WalkedFieldRead(r) -> WalkedFieldRead({ ..r, base: go(r.base) }),
      WalkedPerform(p) -> WalkedPerform({ ..p, args: p.args.map(go) }),
      WalkedLambda(l) -> WalkedLambda({ ..l, body: go(l.body) }),
      WalkedSimulate(t) -> WalkedSimulate({ ..t, body: go(t.body) }),
      WalkedParallel(ts) -> WalkedParallel(ts.map(|t: WalkedThunk| { ..t, body: go(t.body) })),
      WalkedHandle(h) ->
        WalkedHandle({
          ..h,
          body: go(h.body),
          clauses: h.clauses.map(|c: WalkedClause| { ..c, body: go(c.body) }),
          ret: match h.ret { Some(r) -> Some({ ..r, body: go(r.body) }), None -> None },
          vars: h.vars.map(|v: WalkedHandlerVar| { ..v, init: go(v.init) }),
        }),
      WalkedLit(l) -> WalkedLit(l),
      WalkedRead(r) -> WalkedRead(r),
      WalkedDefault(n) -> WalkedDefault(n),
    },
  })
}

// --- Defaults a call on a value copies -------------------------------------------------------------

/// `e` with each default a call on a value copied at its place, `copies` the typed copies in the
/// order they were made; none where one is not typed.
pub fn defaults_filled(e: Walked, copies: List<Option<Walked>>) -> Option<Walked> =
  if copies.any(|c: Option<Walked>| match c { Some(_) -> false, None -> true }) { None } else {
    Some(
      rewritten(e, |x: Walked|
        match x.node {
          WalkedDefault(n) -> match copies.at(n) { Some(Some(c)) -> c, _ -> x },
          _ -> x,
        }),
    )
  }

/// Every node of `e`, each before its parts.
pub fn walked_nodes(e: Walked) -> List<Walked> = {
  let all = |xs: List<Walked>|
    xs.fold([], |acc: List<Walked>, x: Walked| acc.concat(walked_nodes(x)));
  let opt = |x: Option<Walked>| match x { Some(y) -> walked_nodes(y), None -> [] };
  [e].concat(match e.node {
    WalkedLit(_) -> [],
    WalkedRead(_) -> [],
    WalkedDefault(_) -> [],
    WalkedUnary(u) -> walked_nodes(u.operand),
    WalkedBinary(b) -> walked_nodes(b.lhs).concat(walked_nodes(b.rhs)),
    WalkedCall(c) -> walked_nodes(c.callee).concat(all(c.args)),
    WalkedIf(i) -> all([i.cond, i.then_branch, i.else_branch]),
    WalkedMatch(m) ->
      walked_nodes(m.scrutinee).concat(
        m.arms.fold([], |acc: List<Walked>, a: WalkedArm|
          acc.concat(opt(a.guard)).concat(walked_nodes(a.body))),
      ),
    WalkedBlock(b) ->
      b.stmts.fold([], |acc: List<Walked>, s: WalkedStmt|
        acc.concat(match s {
          WalkedLet(l) -> walked_nodes(l.value),
          WalkedLetElse(l) -> walked_nodes(l.value).concat(walked_nodes(l.fallback)),
          WalkedDo(x) -> walked_nodes(x),
          WalkedAssign(a) -> walked_nodes(a.value),
        })).concat(
        opt(b.tail),
      ),
    WalkedList(xs) -> all(xs),
    WalkedRecord(fs) -> all(fs.map(|f: WalkedField| f.value)),
    WalkedUpdate(u) -> walked_nodes(u.base).concat(all(u.sets.map(|f: WalkedField| f.value))),
    WalkedFieldRead(r) -> walked_nodes(r.base),
    WalkedPerform(p) -> all(p.args),
    WalkedLambda(l) -> walked_nodes(l.body),
    WalkedSimulate(t) -> walked_nodes(t.body),
    WalkedParallel(ts) -> all(ts.map(|t: WalkedThunk| t.body)),
    WalkedHandle(h) ->
      all(h.vars.map(|v: WalkedHandlerVar| v.init)).concat(walked_nodes(h.body)).concat(
        all(h.clauses.map(|c: WalkedClause| c.body)),
      ).concat(match h.ret { Some(r) -> walked_nodes(r.body), None -> [] }),
  })
}

// --- Settling ------------------------------------------------------------------------------------------

/// How `settled` makes the typed tree of a walk's: `ty` settles a type, `row` a row and `atom` an
/// atom; `read` settles a read, none where it cannot be; `witness` names the type parameter whose
/// witness does an operator over an operand of a type, none where no constraint makes one; `copies`
/// reads the fields an update of a base of the settled type copies, those `sets` writes left out,
/// none where the type is no record's; `span` counts a place from where the body's item starts; and
/// `released` reads what the ownership walk lets go at the node at a site.
pub type Settling = {
  ty: (Type) -> Type / {abort.raise},
  witness: (Type) -> Option<Bytes> / {abort.raise},
  row: (Row) -> Row / {abort.raise},
  atom: (Atom) -> Atom / {abort.raise},
  read: (WalkedReading) -> Option<Reading<Type>> / {abort.raise},
  copies: (Type, List<Bytes>) -> Option<List<Bytes>> / {abort.raise},
  span: (Span) -> Span,
  released: (Int) -> List<TypedRelease>,
}

/// The typed tree of `e`, settled as `s` settles it; none where a part cannot be.
pub fn settled(e: Walked, s: Settling) -> Option<TypedExpr<Type>> / {abort.raise} =
  match settled_node(e.node, s) {
    Some(n) ->
      Some({
        node: n,
        span: (s.span)(e.span),
        ty: (s.ty)(e.ty),
        releases: (s.released)(e.span.site).map(|x: TypedRelease| release_placed(x, s.span)),
      }),
    None -> None,
  }

fn settled_all(xs: List<Walked>, s: Settling) -> Option<List<TypedExpr<Type>>> / {abort.raise} =
  xs.fold(Some([]), |acc: Option<List<TypedExpr<Type>>>, x: Walked|
    match acc {
      Some(ys) -> match settled(x, s) { Some(y) -> Some(ys.push(y)), None -> None },
      None -> None,
    })

fn settled_param(p: TypedParam<Type>, s: Settling) -> TypedParam<Type> / {abort.raise} =
  { name: p.name, ty: (s.ty)(p.ty), span: (s.span)(p.span) }

fn settled_param_opt(
  p: Option<TypedParam<Type>>,
  s: Settling,
) -> Option<TypedParam<Type>> / {abort.raise} =
  match p { Some(q) -> Some(settled_param(q, s)), None -> None }

fn settled_fields(
  fs: List<WalkedField>,
  s: Settling,
) -> Option<List<TypedField<Type>>> / {abort.raise} =
  fs.fold(Some([]), |acc: Option<List<TypedField<Type>>>, f: WalkedField|
    match acc {
      Some(ys) -> match settled(f.value, s) {
        Some(v) -> Some(ys.push({ name: f.name, value: v })),
        None -> None,
      },
      None -> None,
    })

fn settled_thunk(t: WalkedThunk, s: Settling) -> Option<TypedThunk<Type>> / {abort.raise} =
  match settled(t.body, s) { Some(b) -> Some({ body: b, row: (s.row)(t.row) }), None -> None }

fn settled_pattern(p: TypedPattern<Type>, s: Settling) -> TypedPattern<Type> / {abort.raise} =
  match p {
    TypedWild(w) -> TypedWild({ span: (s.span)(w.span), ty: (s.ty)(w.ty) }),
    TypedBinder(v) -> TypedBinder({ name: v.name, ty: (s.ty)(v.ty), span: (s.span)(v.span) }),
    TypedLitPattern(l) -> TypedLitPattern(l),
    TypedRange(g) -> TypedRange(g),
    TypedCase(c) ->
      TypedCase({ ..c, args: c.args.map(|x: TypedPattern<Type>| settled_pattern(x, s)) }),
    TypedRecordPattern(rp) ->
      TypedRecordPattern({
        fields: rp.fields.map(|f: TypedFieldPattern<Type>|
          { name: f.name, pat: settled_pattern(f.pat, s) }),
        rest: match rp.rest {
          Some(at) -> Some({ span: (s.span)(at.span), ty: (s.ty)(at.ty) }),
          None -> None,
        },
      }),
    TypedListPattern(lp) ->
      TypedListPattern({
        items: lp.items.map(|x: TypedPattern<Type>| settled_pattern(x, s)),
        rest: match lp.rest { Some(x) -> Some(settled_pattern(x, s)), None -> None },
      }),
    TypedOr(alts) -> TypedOr(alts.map(|x: TypedPattern<Type>| settled_pattern(x, s))),
  }

fn settled_stmt(stmt: WalkedStmt, s: Settling) -> Option<TypedStmt<Type>> / {abort.raise} =
  match stmt {
    WalkedLet(l) -> match settled(l.value, s) {
      Some(v) ->
        Some(TypedLet({ pat: settled_pattern(l.pat, s), value: v, span: (s.span)(l.span) })),
      None -> None,
    },
    WalkedLetElse(l) -> match ((settled(l.value, s), settled(l.fallback, s))) {
      (Some(v), Some(f)) ->
        Some(
          TypedLetElse({
            pat: settled_pattern(l.pat, s),
            value: v,
            fallback: f,
            span: (s.span)(l.span),
          }),
        ),
      _ -> None,
    },
    WalkedDo(x) -> match settled(x, s) { Some(y) -> Some(TypedDo(y)), None -> None },
    WalkedAssign(a) -> match settled(a.value, s) {
      Some(v) -> Some(TypedAssign({ name: a.name, value: v, span: (s.span)(a.span) })),
      None -> None,
    },
  }

fn settled_clause(c: WalkedClause, s: Settling) -> Option<TypedClause<Type>> / {abort.raise} =
  match settled(c.body, s) {
    Some(b) ->
      Some({
        effect: c.effect,
        op: c.op,
        resource: c.resource,
        every_label: c.every_label,
        params: c.params.map(|p: TypedParam<Type>| settled_param(p, s)),
        label: settled_param_opt(c.label, s),
        resume: settled_param_opt(c.resume, s),
        body: b,
        row: (s.row)(c.row),
        resumed: (s.row)(c.resumed),
        span: (s.span)(c.span),
      }),
    None -> None,
  }

fn settled_node(node: WalkedNode, s: Settling) -> Option<TypedNode<Type>> / {abort.raise} =
  match node {
    WalkedLit(l) -> Some(TypedLit(l)),
    WalkedRead(read) -> match (s.read)(read) { Some(r) -> Some(TypedRead(r)), None -> None },
    WalkedUnary(u) -> match settled(u.operand, s) {
      Some(x) ->
        Some(
          TypedUnary({
            op: u.op,
            operand: x,
            witness: if u.op == b"neg" || u.op == b"bitnot" { (s.witness)(u.operand.ty) }
            else { None },
          }),
        ),
      None -> None,
    },
    // A logical operator and a concatenation take no witness, and an equality compares as the
    // type's own.
    WalkedBinary(b) -> match ((settled(b.lhs, s), settled(b.rhs, s))) {
      (Some(l), Some(r)) ->
        Some(
          TypedBinary({
            op: b.op,
            lhs: l,
            rhs: r,
            witness: if [b"and", b"or", b"concat", b"eq", b"ne"].contains(b.op) { None }
            else { (s.witness)(b.lhs.ty) },
          }),
        ),
      _ -> None,
    },
    WalkedCall(c) -> match ((settled(c.callee, s), settled_all(c.args, s))) {
      (Some(f), Some(xs)) -> Some(TypedCall({ callee: f, args: xs, row: (s.row)(c.row) })),
      _ -> None,
    },
    WalkedIf(i) -> match ((
        settled(i.cond, s),
        settled(i.then_branch, s),
        settled(i.else_branch, s),
      )) {
      (Some(c), Some(t), Some(e)) -> Some(TypedIf({ cond: c, then_branch: t, else_branch: e })),
      _ -> None,
    },
    WalkedMatch(m) -> {
      let arms = m.arms.fold(Some([]), |acc: Option<List<TypedArm<Type>>>, a: WalkedArm|
        match acc {
          Some(ys) -> match ((settled(a.body, s), a.guard)) {
            (Some(b), None) ->
              Some(ys.push({ pat: settled_pattern(a.pat, s), guard: None, body: b })),
            (Some(b), Some(g)) -> match settled(g, s) {
              Some(gg) ->
                Some(ys.push({ pat: settled_pattern(a.pat, s), guard: Some(gg), body: b })),
              None -> None,
            },
            _ -> None,
          },
          None -> None,
        });
      match ((settled(m.scrutinee, s), arms)) {
        (Some(sc), Some(xs)) -> Some(TypedMatch({ scrutinee: sc, arms: xs })),
        _ -> None,
      }
    },
    WalkedBlock(b) -> {
      let stmts = b.stmts.fold(Some([]), |acc: Option<List<TypedStmt<Type>>>, x: WalkedStmt|
        match acc {
          Some(ys) -> match settled_stmt(x, s) { Some(y) -> Some(ys.push(y)), None -> None },
          None -> None,
        });
      match ((stmts, b.tail)) {
        (Some(ss), None) -> Some(TypedBlock({ stmts: ss, tail: None })),
        (Some(ss), Some(t)) -> match settled(t, s) {
          Some(tt) -> Some(TypedBlock({ stmts: ss, tail: Some(tt) })),
          None -> None,
        },
        _ -> None,
      }
    },
    WalkedList(xs) -> match settled_all(xs, s) { Some(ys) -> Some(TypedList(ys)), None -> None },
    WalkedRecord(fs) -> match settled_fields(fs, s) {
      Some(ys) -> Some(TypedRecord(ys)),
      None -> None,
    },
    WalkedUpdate(u) -> match ((settled(u.base, s), settled_fields(u.sets, s))) {
      (Some(base), Some(sets)) -> match (s.copies)(
          base.ty,
          sets.map(|f: TypedField<Type>| f.name),
        ) {
        Some(copies) -> Some(TypedUpdate({ base: base, sets: sets, copies: copies })),
        None -> None,
      },
      _ -> None,
    },
    WalkedFieldRead(f) -> match settled(f.base, s) {
      Some(b) -> Some(TypedFieldRead({ base: b, field: f.field })),
      None -> None,
    },
    WalkedPerform(p) -> match settled_all(p.args, s) {
      Some(xs) ->
        Some(
          TypedPerform({
            effect: p.effect,
            op: p.op,
            resource: p.resource,
            atom: (s.atom)(p.atom),
            args: xs,
          }),
        ),
      None -> None,
    },
    WalkedLambda(l) -> match settled(l.body, s) {
      Some(b) ->
        Some(
          TypedLambda({
            params: l.params.map(|p: TypedParam<Type>| settled_param(p, s)),
            body: b,
            row: (s.row)(l.row),
          }),
        ),
      None -> None,
    },
    WalkedSimulate(t) -> match settled_thunk(t, s) {
      Some(x) -> Some(TypedSimulate(x)),
      None -> None,
    },
    WalkedParallel(ts) -> match ts.fold(
        Some([]),
        |acc: Option<List<TypedThunk<Type>>>, t: WalkedThunk|
          match acc {
            Some(ys) -> match settled_thunk(t, s) { Some(y) -> Some(ys.push(y)), None -> None },
            None -> None,
          },
      ) {
      Some(ys) -> Some(TypedParallel(ys)),
      None -> None,
    },
    WalkedHandle(h) -> {
      let vars = h.vars.fold(
        Some([]),
        |acc: Option<List<TypedHandlerVar<Type>>>, v: WalkedHandlerVar|
          match acc {
            Some(ys) -> match settled(v.init, s) {
              Some(i) ->
                Some(ys.push({ name: v.name, ty: (s.ty)(v.ty), init: i, span: (s.span)(v.span) })),
              None -> None,
            },
            None -> None,
          },
      );
      let clauses = h.clauses.fold(
        Some([]),
        |acc: Option<List<TypedClause<Type>>>, c: WalkedClause|
          match acc {
            Some(ys) -> match settled_clause(c, s) { Some(y) -> Some(ys.push(y)), None -> None },
            None -> None,
          },
      );
      let ret: Option<Option<TypedReturn<Type>>> = match h.ret {
        None -> Some(None),
        Some(r) -> match settled(r.body, s) {
          Some(b) ->
            Some(
              Some({
                binder: settled_param(r.binder, s),
                body: b,
                row: (s.row)(r.row),
                span: (s.span)(r.span),
              }),
            ),
          None -> None,
        },
      };
      match ((settled(h.body, s), vars, clauses, ret)) {
        (Some(b), Some(vs), Some(cs), Some(rc)) ->
          Some(TypedHandle({ body: b, row: (s.row)(h.row), clauses: cs, ret: rc, vars: vs })),
        _ -> None,
      }
    },
    // A copy the walk's end did not fill: its default did not type, which the check reported.
    WalkedDefault(_) -> None,
  }
