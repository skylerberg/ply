import compiler.syntax.parsing (Span)
import compiler.syntax.patterns (SourceLiteral)
import compiler.check.types (Type, Effects, Effect)
import compiler.check.typed (BodyPart, TypedPattern, TypedParam, TypedFieldPattern, TypedWild,
                             TypedBinder, TypedLiteralPattern, TypedRange, TypedCase,
                             TypedRecordPattern, TypedListPattern, TypedOr, TypedExpression,
                             TypedNode, TypedField, TypedArm, TypedStatement, TypedThunk,
                             TypedClause, TypedReturn, TypedHandlerVar, NameRead, TypedLiteral,
                             TypedRead, TypedUnary, TypedBinary, TypedCall, TypedIf, TypedMatch,
                             TypedBlock, TypedList, TypedRecord, TypedUpdate, TypedFieldRead,
                             TypedPerform, TypedLambda, TypedSimulate, TypedParallel, TypedHandle,
                             TypedLet, TypedLetElse, TypedDo, TypedAssign, TypedRelease)
import std.derive.children
import std.list

pub type WalkedExpression = { node: WalkedNode, span: Span, ty: Type }

derive children for WalkedExpression

pub type WalkedNode =
  | WalkedLiteral(SourceLiteral)
  | WalkedRead(WalkedReading)
  | WalkedUnary({ op: Bytes, operand: WalkedExpression })
  | WalkedBinary({ op: Bytes, lhs: WalkedExpression, rhs: WalkedExpression })
  | WalkedCall({ callee: WalkedExpression, args: List<WalkedExpression>, effects: Effects })
  | WalkedIf({ cond: WalkedExpression, then_branch: WalkedExpression, else_branch: WalkedExpression })
  | WalkedMatch({ scrutinee: WalkedExpression, arms: List<WalkedArm> })
  | WalkedBlock({ statements: List<WalkedStatement>, tail: Option<WalkedExpression> })
  | WalkedList(List<WalkedExpression>)
  | WalkedRecord(List<WalkedField>)
  | WalkedUpdate({ base: WalkedExpression, sets: List<WalkedField> })
  | WalkedFieldRead({ base: WalkedExpression, field: Bytes })
  | WalkedPerform({ effect: Bytes, op: Bytes, resource: Option<Bytes>, entry: Effect, args: List<WalkedExpression> })
  | WalkedLambda({ params: List<TypedParam<Type>>, kept: List<Int>, body: WalkedExpression, effects: Effects })
  | WalkedSimulate(WalkedThunk)
  | WalkedParallel(List<WalkedThunk>)
  | WalkedHandle({ body: WalkedExpression, effects: Effects, clauses: List<WalkedClause>, ret: Option<WalkedReturn>, vars: List<WalkedHandlerVar> })
  | WalkedDefault(Int)

pub type WalkedReading =
  | WalkedLocal({ name: Bytes, binder: Int })
  | WalkedDefinition({ full: Bytes, key: Bytes, args: List<Type>, effect_arguments: List<Effects>, quantified: List<Int>, labels: List<Type> })
  | WalkedConstructor({ sum: Bytes, name: Bytes, case: Int, args: List<Type> })
  | WalkedBuiltin({ name: Bytes, args: List<Type>, effect_arguments: List<Effects> })

pub type WalkedThunk = { body: WalkedExpression, effects: Effects }

pub type WalkedField = { name: Bytes, value: WalkedExpression }

pub type WalkedArm = {
  pattern: TypedPattern<Type>,
  pattern_span: Span,
  guard: Option<WalkedExpression>,
  body: WalkedExpression,
}

pub type WalkedStatement =
  | WalkedLet({ pattern: TypedPattern<Type>, value: WalkedExpression, span: Span })
  | WalkedLetElse({ pattern: TypedPattern<Type>, value: WalkedExpression, fallback: WalkedExpression, span: Span })
  | WalkedDo(WalkedExpression)
  | WalkedAssign({ name: Bytes, value: WalkedExpression, span: Span })

pub type WalkedClause = {
  effect: Bytes,
  op: Bytes,
  resource: Option<Bytes>,
  every_label: Bool,
  params: List<TypedParam<Type>>,
  label: Option<TypedParam<Type>>,
  continuation: Option<TypedParam<Type>>,
  body: WalkedExpression,
  effects: Effects,
  continuation_effects: Effects,
  span: Span,
}

pub type WalkedReturn = {
  binder: TypedParam<Type>,
  body: WalkedExpression,
  effects: Effects,
  span: Span,
}

pub type WalkedHandlerVar = { name: Bytes, ty: Type, init: WalkedExpression, span: Span }

pub type WalkedTree = {
  owner: Bytes,
  part: BodyPart,
  module: Int,
  base: Int,
  params: List<TypedParam<Type>>,
  body: WalkedExpression,
}

pub fn unary_of(op: Bytes, operand: Option<WalkedExpression>) -> Option<WalkedNode> =
  match operand { Some(x) -> Some(WalkedUnary({ op: op, operand: x })), None -> None }

pub fn binary_of(
  op: Bytes,
  lhs: Option<WalkedExpression>,
  rhs: Option<WalkedExpression>,
) -> Option<WalkedNode> =
  match ((lhs, rhs)) {
    (Some(l), Some(r)) -> Some(WalkedBinary({ op: op, lhs: l, rhs: r })),
    _ -> None,
  }

pub fn call_of(
  callee: Option<WalkedExpression>,
  args: List<Option<WalkedExpression>>,
  effects: Effects,
) -> Option<WalkedNode> =
  match ((callee, Option::all(args))) {
    (Some(f), Some(xs)) -> Some(WalkedCall({ callee: f, args: xs, effects: effects })),
    _ -> None,
  }

pub fn if_of(
  cond: Option<WalkedExpression>,
  then_branch: Option<WalkedExpression>,
  else_branch: Option<WalkedExpression>,
) -> Option<WalkedNode> =
  match ((cond, then_branch, else_branch)) {
    (Some(c), Some(t), Some(e)) -> Some(WalkedIf({ cond: c, then_branch: t, else_branch: e })),
    _ -> None,
  }

pub fn list_of(items: List<Option<WalkedExpression>>) -> Option<WalkedNode> =
  match Option::all(items) { Some(xs) -> Some(WalkedList(xs)), None -> None }

pub fn field_read_of(base: Option<WalkedExpression>, field: Bytes) -> Option<WalkedNode> =
  match base { Some(b) -> Some(WalkedFieldRead({ base: b, field: field })), None -> None }

pub fn record_of(
  fields: List<{ name: Bytes, value: Option<WalkedExpression> }>,
) -> Option<WalkedNode> =
  match fields.fold(
      Some([]),
      |accumulator: Option<List<WalkedField>>, f: { name: Bytes, value: Option<WalkedExpression> }|
        match ((accumulator, f.value)) {
          (Some(fs), Some(v)) -> Some(fs.push({ name: f.name, value: v })),
          _ -> None,
        },
    ) {
    Some(fs) -> Some(WalkedRecord(fs)),
    None -> None,
  }

pub fn arm_of(
  pattern: Option<TypedPattern<Type>>,
  pattern_span: Span,
  guard: Option<Option<WalkedExpression>>,
  body: Option<WalkedExpression>,
) -> Option<WalkedArm> =
  match ((pattern, guard, body)) {
    (Some(p), Some(Some(g)), Some(b)) ->
      Some({ pattern: p, pattern_span: pattern_span, guard: Some(g), body: b }),
    (Some(p), None, Some(b)) ->
      Some({ pattern: p, pattern_span: pattern_span, guard: None, body: b }),
    _ -> None,
  }

pub fn match_of(
  scrutinee: Option<WalkedExpression>,
  arms: List<Option<WalkedArm>>,
) -> Option<WalkedNode> =
  match ((scrutinee, Option::all(arms))) {
    (Some(s), Some(xs)) -> Some(WalkedMatch({ scrutinee: s, arms: xs })),
    _ -> None,
  }

pub fn do_of(e: Option<WalkedExpression>) -> Option<WalkedStatement> =
  match e { Some(x) -> Some(WalkedDo(x)), None -> None }

pub fn let_of(
  pattern: Option<TypedPattern<Type>>,
  value: Option<WalkedExpression>,
  span: Span,
) -> Option<WalkedStatement> =
  match ((pattern, value)) {
    (Some(p), Some(v)) -> Some(WalkedLet({ pattern: p, value: v, span: span })),
    _ -> None,
  }

pub fn let_else_of(
  pattern: Option<TypedPattern<Type>>,
  value: Option<WalkedExpression>,
  fallback: Option<WalkedExpression>,
  span: Span,
) -> Option<WalkedStatement> =
  match ((pattern, value, fallback)) {
    (Some(p), Some(v), Some(f)) ->
      Some(WalkedLetElse({ pattern: p, value: v, fallback: f, span: span })),
    _ -> None,
  }

pub fn case_pattern_of(
  sum: Bytes,
  name: Bytes,
  case: Int,
  args: List<Option<TypedPattern<Type>>>,
) -> Option<TypedPattern<Type>> =
  match Option::all(args) {
    Some(ps) -> Some(TypedCase({ sum: sum, name: name, case: case, args: ps })),
    None -> None,
  }

pub fn list_pattern_of(
  items: List<Option<TypedPattern<Type>>>,
  rest: Option<Option<TypedPattern<Type>>>,
) -> Option<TypedPattern<Type>> =
  match ((Option::all(items), rest)) {
    (Some(ps), Some(Some(r))) -> Some(TypedListPattern({ items: ps, rest: Some(r) })),
    (Some(ps), None) -> Some(TypedListPattern({ items: ps, rest: None })),
    _ -> None,
  }

pub fn or_pattern_of(alts: List<Option<TypedPattern<Type>>>) -> Option<TypedPattern<Type>> =
  match Option::all(alts) { Some(ps) -> Some(TypedOr(ps)), None -> None }

pub fn record_pattern_of(
  fields: List<{ name: Bytes, pattern: Option<TypedPattern<Type>> }>,
  rest: Bool,
  span: Span,
  ty: Type,
) -> Option<TypedPattern<Type>> =
  match fields.fold(
      Some([]),
      |accumulator: Option<List<TypedFieldPattern<Type>>>, f: { name: Bytes, pattern: Option<TypedPattern<Type>> }|
        match ((accumulator, f.pattern)) {
          (Some(fs), Some(p)) -> Some(fs.push({ name: f.name, pattern: p })),
          _ -> None,
        },
    ) {
    Some(fs) -> Some(TypedRecordPattern({ fields: fs, rest: rest, span: span, ty: ty })),
    None -> None,
  }

pub fn perform_of(
  effect_name: Bytes,
  op: Bytes,
  resource: Option<Bytes>,
  entry: Effect,
  args: List<Option<WalkedExpression>>,
) -> Option<WalkedNode> =
  match Option::all(args) {
    Some(xs) ->
      Some(
        WalkedPerform({ effect: effect_name, op: op, resource: resource, entry: entry, args: xs }),
      ),
    None -> None,
  }

pub fn simulate_of(body: Option<WalkedExpression>, effects: Effects) -> Option<WalkedNode> =
  match body { Some(b) -> Some(WalkedSimulate({ body: b, effects: effects })), None -> None }

pub fn parallel_of(
  branches: List<{ body: Option<WalkedExpression>, effects: Effects }>,
) -> Option<WalkedNode> =
  match branches.fold(
      Some([]),
      |accumulator: Option<List<WalkedThunk>>, b: { body: Option<WalkedExpression>, effects: Effects }|
        match ((accumulator, b.body)) {
          (Some(ts), Some(x)) -> Some(ts.push({ body: x, effects: b.effects })),
          _ -> None,
        },
    ) {
    Some(ts) -> Some(WalkedParallel(ts)),
    None -> None,
  }

pub fn params_typed(
  names: List<{ name: Bytes, span: Span }>,
  types: List<Type>,
) -> Option<List<TypedParam<Type>>> =
  match names.zip_strict(types) {
    Some(ps) ->
      Some(
        ps.map(|p: { first: { name: Bytes, span: Span }, second: Type }|
          { name: p.first.name, ty: p.second, span: p.first.span }),
      ),
    None -> None,
  }

pub fn clause_of(
  head: { effect: Bytes, op: Bytes, resource: Option<Bytes>, every_label: Bool },
  params: Option<List<TypedParam<Type>>>,
  label: Option<TypedParam<Type>>,
  resume: Option<TypedParam<Type>>,
  body: Option<WalkedExpression>,
  effects: Effects,
  resumed: Effects,
  span: Span,
) -> Option<WalkedClause> =
  match ((params, body)) {
    (Some(ps), Some(b)) ->
      Some({
        effect: head.effect,
        op: head.op,
        resource: head.resource,
        every_label: head.every_label,
        params: ps,
        label: label,
        continuation: resume,
        body: b,
        effects: effects,
        continuation_effects: resumed,
        span: span,
      }),
    _ -> None,
  }

pub fn return_of(
  binder: TypedParam<Type>,
  body: Option<WalkedExpression>,
  effects: Effects,
  span: Span,
) -> Option<WalkedReturn> =
  match body {
    Some(b) -> Some({ binder: binder, body: b, effects: effects, span: span }),
    None -> None,
  }

pub fn handler_var_of(
  name: Bytes,
  ty: Type,
  init: Option<WalkedExpression>,
  span: Span,
) -> Option<WalkedHandlerVar> =
  match init { Some(i) -> Some({ name: name, ty: ty, init: i, span: span }), None -> None }

pub fn handle_of(
  body: Option<WalkedExpression>,
  effects: Effects,
  clauses: List<Option<WalkedClause>>,
  ret: Option<Option<WalkedReturn>>,
  vars: List<Option<WalkedHandlerVar>>,
) -> Option<WalkedNode> =
  match ((body, Option::all(clauses), ret, Option::all(vars))) {
    (Some(b), Some(cs), None, Some(vs)) ->
      Some(WalkedHandle({ body: b, effects: effects, clauses: cs, ret: None, vars: vs })),
    (Some(b), Some(cs), Some(Some(r)), Some(vs)) ->
      Some(WalkedHandle({ body: b, effects: effects, clauses: cs, ret: Some(r), vars: vs })),
    _ -> None,
  }

pub fn assign_of(
  name: Bytes,
  value: Option<WalkedExpression>,
  span: Span,
) -> Option<WalkedStatement> =
  match value { Some(v) -> Some(WalkedAssign({ name: name, value: v, span: span })), None -> None }

pub fn update_of(
  base: Option<WalkedExpression>,
  sets: List<{ name: Bytes, value: Option<WalkedExpression> }>,
) -> Option<WalkedNode> =
  match ((base, record_of(sets))) {
    (Some(b), Some(WalkedRecord(fs))) -> Some(WalkedUpdate({ base: b, sets: fs })),
    _ -> None,
  }

pub fn lambda_of(
  params: List<TypedParam<Type>>,
  kept: List<Int>,
  body: Option<WalkedExpression>,
  effects: Effects,
) -> Option<WalkedNode> =
  match body {
    Some(b) -> Some(WalkedLambda({ params: params, kept: kept, body: b, effects: effects })),
    None -> None,
  }

pub fn block_of(
  statements: List<Option<WalkedStatement>>,
  tail: Option<Option<WalkedExpression>>,
) -> Option<WalkedNode> =
  match ((Option::all(statements), tail)) {
    (Some(ss), Some(Some(t))) -> Some(WalkedBlock({ statements: ss, tail: Some(t) })),
    (Some(ss), None) -> Some(WalkedBlock({ statements: ss, tail: None })),
    _ -> None,
  }

pub fn rewritten(
  e: WalkedExpression,
  f: (WalkedExpression) -> WalkedExpression,
) -> WalkedExpression = {
  let go = |x: WalkedExpression| rewritten(x, f);
  let opt = |x: Option<WalkedExpression>|
    match x { Some(y) -> Some(rewritten(y, f)), None -> None };
  f({
    ..e,
    node: match e.node {
      WalkedUnary(u) -> WalkedUnary({ ..u, operand: go(u.operand) }),
      WalkedBinary(b) -> WalkedBinary({ ..b, lhs: go(b.lhs), rhs: go(b.rhs) }),
      WalkedCall(c) -> WalkedCall({ ..c, callee: go(c.callee), args: c.args.map(go) }),
      WalkedIf(i) ->
        WalkedIf({
          cond: go(i.cond),
          then_branch: go(i.then_branch),
          else_branch: go(i.else_branch),
        }),
      WalkedMatch(m) ->
        WalkedMatch({
          scrutinee: go(m.scrutinee),
          arms: m.arms.map(|a: WalkedArm| { ..a, guard: opt(a.guard), body: go(a.body) }),
        }),
      WalkedBlock(b) ->
        WalkedBlock({
          statements: b.statements.map(|s: WalkedStatement|
            match s {
              WalkedLet(l) -> WalkedLet({ ..l, value: go(l.value) }),
              WalkedLetElse(l) ->
                WalkedLetElse({ ..l, value: go(l.value), fallback: go(l.fallback) }),
              WalkedDo(x) -> WalkedDo(go(x)),
              WalkedAssign(a) -> WalkedAssign({ ..a, value: go(a.value) }),
            }),
          tail: opt(b.tail),
        }),
      WalkedList(xs) -> WalkedList(xs.map(go)),
      WalkedRecord(fs) ->
        WalkedRecord(fs.map(|fd: WalkedField| { name: fd.name, value: go(fd.value) })),
      WalkedUpdate(u) ->
        WalkedUpdate({
          base: go(u.base),
          sets: u.sets.map(|fd: WalkedField| { name: fd.name, value: go(fd.value) }),
        }),
      WalkedFieldRead(r) -> WalkedFieldRead({ ..r, base: go(r.base) }),
      WalkedPerform(p) -> WalkedPerform({ ..p, args: p.args.map(go) }),
      WalkedLambda(l) -> WalkedLambda({ ..l, body: go(l.body) }),
      WalkedSimulate(t) -> WalkedSimulate({ ..t, body: go(t.body) }),
      WalkedParallel(ts) -> WalkedParallel(ts.map(|t: WalkedThunk| { ..t, body: go(t.body) })),
      WalkedHandle(h) ->
        WalkedHandle({
          ..h,
          body: go(h.body),
          clauses: h.clauses.map(|c: WalkedClause| { ..c, body: go(c.body) }),
          ret: match h.ret { Some(r) -> Some({ ..r, body: go(r.body) }), None -> None },
          vars: h.vars.map(|v: WalkedHandlerVar| { ..v, init: go(v.init) }),
        }),
      WalkedLiteral(l) -> WalkedLiteral(l),
      WalkedRead(r) -> WalkedRead(r),
      WalkedDefault(n) -> WalkedDefault(n),
    },
  })
}

pub fn defaults_filled(
  e: WalkedExpression,
  copies: List<Option<WalkedExpression>>,
) -> Option<WalkedExpression> =
  if copies.any(|c: Option<WalkedExpression>| match c { Some(_) -> false, None -> true }) { None }
  else {
    Some(
      rewritten(e, |x: WalkedExpression|
        match x.node {
          WalkedDefault(n) -> match copies.at(n) { Some(Some(c)) -> c, _ -> x },
          _ -> x,
        }),
    )
  }

pub type Resolver = {
  ty: (Type) -> Type / {abort.raise},
  witness: (Type) -> Option<Bytes> / {abort.raise},
  effects: (Effects) -> Effects / {abort.raise},
  entry: (Effect) -> Effect / {abort.raise},
  read: (WalkedReading) -> Option<NameRead<Type>> / {abort.raise},
  copied_fields: (Type, List<Bytes>) -> Option<List<Bytes>> / {abort.raise},
  span: (Span) -> Span,
  released: (Int) -> List<TypedRelease>,
}

pub fn resolved(e: WalkedExpression, s: Resolver) -> Option<TypedExpression<Type>> / {abort.raise} =
  match resolved_node(e.node, s) {
    Some(n) ->
      Some({
        node: n,
        span: (s.span)(e.span),
        ty: (s.ty)(e.ty),
        releases: (s.released)(e.span.site),
      }),
    None -> None,
  }

fn resolved_all(
  xs: List<WalkedExpression>,
  s: Resolver,
) -> Option<List<TypedExpression<Type>>> / {abort.raise} =
  xs.fold(Some([]), |accumulator: Option<List<TypedExpression<Type>>>, x: WalkedExpression|
    match accumulator {
      Some(ys) -> match resolved(x, s) { Some(y) -> Some(ys.push(y)), None -> None },
      None -> None,
    })

fn resolved_param(p: TypedParam<Type>, s: Resolver) -> TypedParam<Type> / {abort.raise} =
  { name: p.name, ty: (s.ty)(p.ty), span: (s.span)(p.span) }

fn resolved_param_opt(
  p: Option<TypedParam<Type>>,
  s: Resolver,
) -> Option<TypedParam<Type>> / {abort.raise} =
  match p { Some(q) -> Some(resolved_param(q, s)), None -> None }

fn resolved_fields(
  fs: List<WalkedField>,
  s: Resolver,
) -> Option<List<TypedField<Type>>> / {abort.raise} =
  fs.fold(Some([]), |accumulator: Option<List<TypedField<Type>>>, f: WalkedField|
    match accumulator {
      Some(ys) -> match resolved(f.value, s) {
        Some(v) -> Some(ys.push({ name: f.name, value: v })),
        None -> None,
      },
      None -> None,
    })

fn resolved_thunk(t: WalkedThunk, s: Resolver) -> Option<TypedThunk<Type>> / {abort.raise} =
  match resolved(t.body, s) {
    Some(b) -> Some({ body: b, effects: (s.effects)(t.effects) }),
    None -> None,
  }

fn resolved_pattern(p: TypedPattern<Type>, s: Resolver) -> TypedPattern<Type> / {abort.raise} =
  match p {
    TypedWild(w) -> TypedWild({ span: (s.span)(w.span), ty: (s.ty)(w.ty) }),
    TypedBinder(v) -> TypedBinder({ name: v.name, ty: (s.ty)(v.ty), span: (s.span)(v.span) }),
    TypedLiteralPattern(l) -> TypedLiteralPattern(l),
    TypedRange(g) -> TypedRange(g),
    TypedCase(c) ->
      TypedCase({ ..c, args: c.args.map(|x: TypedPattern<Type>| resolved_pattern(x, s)) }),
    TypedRecordPattern(rp) ->
      TypedRecordPattern({
        fields: rp.fields.map(|f: TypedFieldPattern<Type>|
          { name: f.name, pattern: resolved_pattern(f.pattern, s) }),
        rest: rp.rest,
        span: (s.span)(rp.span),
        ty: (s.ty)(rp.ty),
      }),
    TypedListPattern(lp) ->
      TypedListPattern({
        items: lp.items.map(|x: TypedPattern<Type>| resolved_pattern(x, s)),
        rest: match lp.rest { Some(x) -> Some(resolved_pattern(x, s)), None -> None },
      }),
    TypedOr(alts) -> TypedOr(alts.map(|x: TypedPattern<Type>| resolved_pattern(x, s))),
  }

fn resolved_statement(
  stmt: WalkedStatement,
  s: Resolver,
) -> Option<TypedStatement<Type>> / {abort.raise} =
  match stmt {
    WalkedLet(l) -> match resolved(l.value, s) {
      Some(v) ->
        Some(
          TypedLet({ pattern: resolved_pattern(l.pattern, s), value: v, span: (s.span)(l.span) }),
        ),
      None -> None,
    },
    WalkedLetElse(l) -> match ((resolved(l.value, s), resolved(l.fallback, s))) {
      (Some(v), Some(f)) ->
        Some(
          TypedLetElse({
            pattern: resolved_pattern(l.pattern, s),
            value: v,
            fallback: f,
            span: (s.span)(l.span),
          }),
        ),
      _ -> None,
    },
    WalkedDo(x) -> match resolved(x, s) { Some(y) -> Some(TypedDo(y)), None -> None },
    WalkedAssign(a) -> match resolved(a.value, s) {
      Some(v) -> Some(TypedAssign({ name: a.name, value: v, span: (s.span)(a.span) })),
      None -> None,
    },
  }

fn resolved_clause(c: WalkedClause, s: Resolver) -> Option<TypedClause<Type>> / {abort.raise} =
  match resolved(c.body, s) {
    Some(b) ->
      Some({
        effect: c.effect,
        op: c.op,
        resource: c.resource,
        every_label: c.every_label,
        params: c.params.map(|p: TypedParam<Type>| resolved_param(p, s)),
        label: resolved_param_opt(c.label, s),
        continuation: resolved_param_opt(c.continuation, s),
        body: b,
        effects: (s.effects)(c.effects),
        continuation_effects: (s.effects)(c.continuation_effects),
        span: (s.span)(c.span),
      }),
    None -> None,
  }

fn resolved_node(node: WalkedNode, s: Resolver) -> Option<TypedNode<Type>> / {abort.raise} =
  match node {
    WalkedLiteral(l) -> Some(TypedLiteral(l)),
    WalkedRead(read) -> match (s.read)(read) { Some(r) -> Some(TypedRead(r)), None -> None },
    WalkedUnary(u) -> match resolved(u.operand, s) {
      Some(x) ->
        Some(
          TypedUnary({
            op: u.op,
            operand: x,
            witness: if u.op == b"neg" || u.op == b"bitnot" { (s.witness)(u.operand.ty) }
            else { None },
          }),
        ),
      None -> None,
    },
    WalkedBinary(b) -> match ((resolved(b.lhs, s), resolved(b.rhs, s))) {
      (Some(l), Some(r)) ->
        Some(
          TypedBinary({
            op: b.op,
            lhs: l,
            rhs: r,
            witness: if [b"and", b"or", b"concat", b"eq", b"ne"].contains(b.op) { None }
            else { (s.witness)(b.lhs.ty) },
          }),
        ),
      _ -> None,
    },
    WalkedCall(c) -> match ((resolved(c.callee, s), resolved_all(c.args, s))) {
      (Some(f), Some(xs)) ->
        Some(TypedCall({ callee: f, args: xs, effects: (s.effects)(c.effects) })),
      _ -> None,
    },
    WalkedIf(i) -> match ((
        resolved(i.cond, s),
        resolved(i.then_branch, s),
        resolved(i.else_branch, s),
      )) {
      (Some(c), Some(t), Some(e)) -> Some(TypedIf({ cond: c, then_branch: t, else_branch: e })),
      _ -> None,
    },
    WalkedMatch(m) -> {
      let arms = m.arms.fold(Some([]), |accumulator: Option<List<TypedArm<Type>>>, a: WalkedArm|
        match accumulator {
          Some(ys) -> match ((resolved(a.body, s), a.guard)) {
            (Some(b), None) ->
              Some(ys.push({ pattern: resolved_pattern(a.pattern, s), guard: None, body: b })),
            (Some(b), Some(g)) -> match resolved(g, s) {
              Some(gg) ->
                Some(
                  ys.push({ pattern: resolved_pattern(a.pattern, s), guard: Some(gg), body: b }),
                ),
              None -> None,
            },
            _ -> None,
          },
          None -> None,
        });
      match ((resolved(m.scrutinee, s), arms)) {
        (Some(sc), Some(xs)) -> Some(TypedMatch({ scrutinee: sc, arms: xs })),
        _ -> None,
      }
    },
    WalkedBlock(b) -> {
      let statements = b.statements.fold(
        Some([]),
        |accumulator: Option<List<TypedStatement<Type>>>, x: WalkedStatement|
          match accumulator {
            Some(ys) -> match resolved_statement(x, s) {
              Some(y) -> Some(ys.push(y)),
              None -> None,
            },
            None -> None,
          },
      );
      match ((statements, b.tail)) {
        (Some(ss), None) -> Some(TypedBlock({ statements: ss, tail: None })),
        (Some(ss), Some(t)) -> match resolved(t, s) {
          Some(tt) -> Some(TypedBlock({ statements: ss, tail: Some(tt) })),
          None -> None,
        },
        _ -> None,
      }
    },
    WalkedList(xs) -> match resolved_all(xs, s) { Some(ys) -> Some(TypedList(ys)), None -> None },
    WalkedRecord(fs) -> match resolved_fields(fs, s) {
      Some(ys) -> Some(TypedRecord(ys)),
      None -> None,
    },
    WalkedUpdate(u) -> match ((resolved(u.base, s), resolved_fields(u.sets, s))) {
      (Some(base), Some(sets)) -> match (s.copied_fields)(
          base.ty,
          sets.map(|f: TypedField<Type>| f.name),
        ) {
        Some(copies) -> Some(TypedUpdate({ base: base, sets: sets, copied_fields: copies })),
        None -> None,
      },
      _ -> None,
    },
    WalkedFieldRead(f) -> match resolved(f.base, s) {
      Some(b) -> Some(TypedFieldRead({ base: b, field: f.field })),
      None -> None,
    },
    WalkedPerform(p) -> match resolved_all(p.args, s) {
      Some(xs) ->
        Some(
          TypedPerform({
            effect: p.effect,
            op: p.op,
            resource: p.resource,
            entry: (s.entry)(p.entry),
            args: xs,
          }),
        ),
      None -> None,
    },
    WalkedLambda(l) -> match resolved(l.body, s) {
      Some(b) ->
        Some(
          TypedLambda({
            params: l.params.map(|p: TypedParam<Type>| resolved_param(p, s)),
            body: b,
            effects: (s.effects)(l.effects),
          }),
        ),
      None -> None,
    },
    WalkedSimulate(t) -> match resolved_thunk(t, s) {
      Some(x) -> Some(TypedSimulate(x)),
      None -> None,
    },
    WalkedParallel(ts) -> match ts.fold(
        Some([]),
        |accumulator: Option<List<TypedThunk<Type>>>, t: WalkedThunk|
          match accumulator {
            Some(ys) -> match resolved_thunk(t, s) { Some(y) -> Some(ys.push(y)), None -> None },
            None -> None,
          },
      ) {
      Some(ys) -> Some(TypedParallel(ys)),
      None -> None,
    },
    WalkedHandle(h) -> {
      let vars = h.vars.fold(
        Some([]),
        |accumulator: Option<List<TypedHandlerVar<Type>>>, v: WalkedHandlerVar|
          match accumulator {
            Some(ys) -> match resolved(v.init, s) {
              Some(i) ->
                Some(ys.push({ name: v.name, ty: (s.ty)(v.ty), init: i, span: (s.span)(v.span) })),
              None -> None,
            },
            None -> None,
          },
      );
      let clauses = h.clauses.fold(
        Some([]),
        |accumulator: Option<List<TypedClause<Type>>>, c: WalkedClause|
          match accumulator {
            Some(ys) -> match resolved_clause(c, s) { Some(y) -> Some(ys.push(y)), None -> None },
            None -> None,
          },
      );
      let ret: Option<Option<TypedReturn<Type>>> = match h.ret {
        None -> Some(None),
        Some(r) -> match resolved(r.body, s) {
          Some(b) ->
            Some(
              Some({
                binder: resolved_param(r.binder, s),
                body: b,
                effects: (s.effects)(r.effects),
                span: (s.span)(r.span),
              }),
            ),
          None -> None,
        },
      };
      match ((resolved(h.body, s), vars, clauses, ret)) {
        (Some(b), Some(vs), Some(cs), Some(rc)) ->
          Some(
            TypedHandle({
              body: b,
              effects: (s.effects)(h.effects),
              clauses: cs,
              ret: rc,
              vars: vs,
            }),
          ),
        _ -> None,
      }
    },
    WalkedDefault(_) -> None,
  }
