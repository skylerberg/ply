fn reader_of(checker: Checker) -> Reader =
  {
    name: |q: QName|
      match local_at(checker, q) {
        Some(binder) -> match env_local(checker.env, binder) {
          Some(l) -> Local({ binder: binder, ty: l.scheme.ty }),
          None -> Elsewhere,
        },
        None -> Elsewhere,
      },
    head: |ty: Type| shallow_resolve(checker.substitution, ty),
    builtin: |f: Expression| prelude_name_of(checker, f),
    on_value: |span: Span|
      match checker.member_builtins.get(builtin_key(checker, span)) {
        Some(name) -> name,
        None -> b"",
      },
    contract: |name: Bytes| checker.contracts.get(name),
  }

fn builtin_key(checker: Checker, at: Span) -> Bytes =
  Bytes::concat_all([checker.current_definition, b"#", ascii_of_int(at.site)])

fn assume_condition(checker: Checker, cond: Expression, truth: Bool) -> Checker / {abort.raise} =
  { ..checker, guards: guards::assume(reader_of(checker), checker.guards, cond, truth) }

fn restore_guards(checker: Checker, before: Guards) -> Checker =
  { ..checker, guards: guards::restore_assumptions(checker.guards, before) }

fn bind_guarded_value(
  before: Checker,
  bound: Checker,
  pattern: Pattern,
  value: Expression,
) -> Checker / {abort.raise} =
  match pattern {
    PatternVariable(v) -> match env_local(bound.env, v.name.span.site) {
      None -> bound,
      Some(_) -> {
        let r = guards::read(
          { ..reader_of(before), on_value: reader_of(bound).on_value },
          bound.guards,
          value,
        );
        { ..bound, guards: guards::bind(r.guards, v.name.span.site, r.value) }
      },
    },
    _ -> bound,
  }

type RangeArgument = { at: Int, lo: Expression, hi: Expression }

fn ranged_lambda(
  checker: Checker,
  builtin: Bytes,
  args: List<Expression>,
) -> Option<RangeArgument> / {abort.raise} =
  match prelude_callback_use(builtin) {
    None -> None,
    Some(it) -> match ((it.iterated_parameters, it.params.last())) {
      ([k], Some(Element)) -> match args.at(k) {
        Some(CallExpression(r)) -> match r.args {
          [lo, hi] -> if prelude_name_of(checker, r.function) != b"range" { None }
          else { Some({ at: it.callback, lo: lo, hi: hi }) },
          _ -> None,
        },
        _ -> None,
      },
      _ -> None,
    },
  }

fn note_raise(checker: Checker, span: Span, reason: RaiseReason) -> Checker =
  { ..checker, raise_notes: checker.raise_notes.push({ span: span, reason: reason }) }

fn requires_shown(
  checker: Checker,
  builtin: Bytes,
  args: List<Expression>,
  span: Span,
) -> { checker: Checker, shown: Bool } / {abort.raise} =
  match checker.contracts.get(builtin) {
    None -> { checker: checker, shown: false },
    Some(st) -> if st.requires.len() == 0 { { checker: checker, shown: false } } else {
      let o = guards::unproved_requirement(reader_of(checker), checker.guards, st, args);
      let read: Checker = { ..checker, guards: o.g };
      match o.needs {
        None -> { checker: read, shown: true },
        Some(needs) ->
          {
            checker: note_raise(read, span, RequirementNotShown({ callee: builtin, needs: needs })),
            shown: false,
          },
      }
    },
  }

fn callee_source(checker: Checker, function: Expression) -> PerformSource / {abort.raise} =
  match function {
    NameExpression(v) -> if local_at(checker, v.name) != None { PerformViaFunctionValue } else {
      match declared_value(checker, v.name) {
        Some(n) -> PerformViaCall(n),
        None -> if is_bare(v.name) && env_lookup(checker.env, v.name.name.name) != None {
          PerformViaCall(v.name.name.name)
        } else { PerformViaArguments },
      }
    },
    _ -> PerformViaFunctionValue,
  }

fn discharge(
  checker: Checker,
  mark: Int,
  until: Int,
  handled: List<Effect>,
) -> Checker / {abort.raise} = {
  let kept = checker.performs.drop(mark).take(until - mark).filter(|site: PerformSite|
    !effects_cover(handled, resolve_effect(checker.substitution, site.entry)));
  {
    ..checker,
    performs: checker.performs.take(mark).concat(kept).concat(checker.performs.drop(until)),
  }
}

fn opened_to_clauses(
  checker: Checker,
  effects: Effects,
  returned: List<Effect>,
) -> Checker / {abort.raise} =
  returned.fold(checker, |c: Checker, a: Effect| {
    let r = resolve_effects_in(c, effects);
    match r.variable {
      None -> c,
      Some(v) -> if is_rigid_effects(c.substitution, v) || effects_cover(r.listed, a) { c } else {
        let o = new_effect_variable(c);
        with_unified(
          o.checker,
          unify_effects(o.checker.substitution, o.checker.fresh, open_effects(v), {
            listed: [a],
            variable: Some(o.var),
          }),
        )
      },
    }
  })

fn key_named(keys: List<OpKey>, entry: Effect) -> Bool =
  keys.fold(false, |acc: Bool, k: OpKey|
    acc
      || (k.effect == entry.effect && resource_covers(k.resource, entry.resource)
      && Some(k.op) == entry.op))

fn mode_ops(checker: Checker, entry: Effect) -> List<Effect> / {abort.raise} = {
  let named = match entry.resource {
    NamedResource(_) -> true,
    ResourceVariable(_) -> true,
    SingletonResource -> false,
    AnyResource -> true,
  };
  match effect_of(checker, entry.effect) {
    Some(info) ->
      info.operations.fold([], |acc: List<Effect>, op_info: OpInfo|
        if mode_eq(op_info.mode, entry.mode) && op_info.resource_param == named {
          acc.push({
            effect: entry.effect,
            resource: entry.resource,
            mode: entry.mode,
            op: Some(op_info.name),
          })
        } else { acc }),
    None -> [],
  }
}

fn clause_discharges(
  checker: Checker,
  handled: List<Effect>,
  keys: List<OpKey>,
  a: Effect,
) -> Bool / {abort.raise} =
  match a.op {
    Some(_) -> key_named(keys, a),
    None ->
      effects_cover(handled, a)
        && mode_ops(checker, a).fold(true, |acc: Bool, o: Effect| acc && key_named(keys, o)),
  }

pub fn site_for(checker: Checker, entry: Effect) -> Option<PerformSite> / {abort.raise} =
  site_among(resolved_sites(checker.substitution, checker.performs), entry)

pub fn resolved_sites(
  substitution: Substitution,
  sites: List<PerformSite>,
) -> List<PerformSite> / {abort.raise} =
  sites.map(|site: PerformSite| { ..site, entry: resolve_effect(substitution, site.entry) })

pub fn site_among(sites: List<PerformSite>, entry: Effect) -> Option<PerformSite> =
  sites.fold(None, |acc: Option<PerformSite>, site: PerformSite|
    match acc { Some(_) -> acc, None -> if site.entry == entry { Some(site) } else { None } })

fn join(
  checker: Checker,
  span: Span,
  a: Effects,
  b: Effects,
) -> { checker: Checker, effects: Effects } / {abort.raise} =
  match a.variable {
    Some(x) -> match b.variable {
      Some(y) -> if x != y {
        let u = unify_effects(
          checker.substitution,
          checker.fresh,
          open_effects(x),
          open_effects(y),
        );
        let c = with_unified(checker, u);
        match u.error {
          Some(e) ->
            {
              checker: report_unify(c, e, span, b"this expression combines two effect variables"),
              effects: combined_effects(a, b),
            },
          None -> { checker: c, effects: combined_effects(a, b) },
        }
      } else { { checker: checker, effects: combined_effects(a, b) } },
      None -> { checker: checker, effects: combined_effects(a, b) },
    },
    None -> { checker: checker, effects: combined_effects(a, b) },
  }

pub fn report_unify(
  checker: Checker,
  error: UnifyError,
  span: Span,
  context: Bytes,
) -> Checker / {abort.raise} =
  match error {
    Mismatch(m) -> {
      let expected = resolve(checker, m.expected);
      let found = resolve(checker, m.found);
      let pe = print_type(printer_new(), expected);
      let pf = print_type(pe.printer, found);
      report_text(
        checker,
        b"E0201",
        span,
        Bytes::concat_all([context, b"|", pe.text, b"|", pf.text]),
        b"type mismatch: ".concat(context),
        Bytes::concat_all([b"expected `", pe.text, b"`, found `", pf.text, b"`"]),
        nominal_mismatch_notes(checker, expected, found),
      )
    },
    Arity(a) ->
      report_text(
        checker,
        b"E0202",
        span,
        Bytes::concat_all([context, b"|", ascii_of_int(a.expected), b"|", ascii_of_int(a.found)]),
        b"function arity mismatch: ".concat(context),
        Bytes::concat_all([
          b"expected ",
          ascii_of_int(a.expected),
          b" parameter(s), found ",
          ascii_of_int(a.found),
        ]),
        [],
      ),
    OccursType(o) -> {
      let pv = print_type(printer_new(), VariableType(o.v));
      let pt = print_type(pv.printer, o.ty);
      report_text(
        checker,
        b"E0203",
        span,
        Bytes::concat_all([context, b"|", pv.text, b"|", pt.text]),
        b"infinite type: ".concat(context),
        Bytes::concat_all([b"`", pv.text, b"` would have to equal `", pt.text, b"`"]),
        [b"this usually means a recursive value is missing a constructor"],
      )
    },
    OccursInEffects(o) -> {
      let pv = print_effects(printer_new(), open_effects(o.v));
      let pr = print_effects(pv.printer, o.effects);
      report_text(
        checker,
        b"E0203",
        span,
        Bytes::concat_all([context, b"|", pv.text, b"|", pr.text]),
        b"infinite effects: ".concat(context),
        Bytes::concat_all([b"`", pv.text, b"` would have to equal `", pr.text, b"`"]),
        [b"a list of effects cannot contain itself"],
      )
    },
    EffectsMismatch(m) -> {
      let expected = resolve_effects_in(checker, m.expected);
      let found = resolve_effects_in(checker, m.found);
      let extra = effects_difference(found.listed, expected.listed);
      let pe = print_effects(printer_new(), expected);
      let pf = print_effects(pe.printer, found);
      report_text(
        checker,
        b"E0302",
        span,
        Bytes::concat_all([context, b"|", pe.text, b"|", pf.text]),
        b"effects mismatch: ".concat(context),
        Bytes::concat_all([b"expected ", pe.text, b", found ", pf.text]),
        List::concat(
          if extra.len() > 0 {
            [b"not permitted here: ".concat(backticked(extra.map(effect_text), b", "))]
          } else { [] },
          scope_mismatch_notes(expected, found),
        ),
      )
    },
  }

fn scope_counterpart(effects: Effects, other: Effects) -> Option<Effect> / {abort.raise} =
  effects.listed.fold(None, |acc: Option<Effect>, a: Effect|
    match acc {
      Some(_) -> acc,
      None -> match a.resource {
        NamedResource(n) -> if written_label(n) != n
            && other.listed.contains({ ..a, resource: NamedResource(written_label(n)) }) { Some(a) }
        else { None },
        _ -> None,
      },
    })

fn scope_mismatch_notes(expected: Effects, found: Effects) -> List<Bytes> / {abort.raise} =
  match match scope_counterpart(found, expected) {
      Some(a) -> Some(a),
      None -> scope_counterpart(expected, found),
    } {
    None -> [],
    Some(a) -> {
      let name = match a.resource { NamedResource(n) -> written_label(n), _ -> b"" };
      [
        Bytes::concat_all([
          b"one `",
          name,
          b"` is the scope `with_scope[",
          name,
          b"]` opens and the other is the resource of that name, which is all effects written outside the scope name",
        ]),
        b"take the scoped value with its scope as a label parameter, `<[r]>(h: Scoped<T, [r]>)`, or what reads it through an effect variable, `<| e>`",
      ]
    },
  }

fn opaque_owner(
  checker: Checker,
  name: Bytes,
) -> Option<{ home: Bytes, opaque: Opaque }> / {abort.raise} =
  match checker.types.get(name) {
    None -> None,
    Some(declaration) -> match declaration.opaque {
      None -> None,
      Some(opaque) -> if declaration.owner == checker.module { None }
      else { Some({ home: module_name(checker, declaration.owner), opaque: opaque }) },
    },
  }

fn nominal_mismatch_notes(
  checker: Checker,
  expected: Type,
  found: Type,
) -> List<Bytes> / {abort.raise} = {
  let apart = |name: Bytes|
    Bytes::concat_all([
      b"`",
      name,
      b"` is declared with `new`, so no other record is one whatever its fields",
    ]);
  let note = |name: Bytes|
    match opaque_owner(checker, name) {
      Some(closed) ->
        prepend(
          Bytes::concat_all([
            apart(name),
            b", and it is opaque, so only `",
            closed.home,
            b"` builds one",
          ]),
          opaque_notes(closed.home, closed.opaque),
        ),
      None ->
        [
          Bytes::concat_all([
            apart(name),
            b"; a record literal is one where a `",
            name,
            b"` is expected",
          ]),
        ],
    };
  match expected {
    NominalType(n) -> match found { RecordType(_) -> note(n.name), _ -> [] },
    RecordType(_) -> match found { NominalType(n) -> note(n.name), _ -> [] },
    FunctionType(e) -> match found {
      FunctionType(f) -> if e.once == f.once { [] } else {
        [
          b"a `once` function, such as a clause's continuation, is called at most once, so it goes only where its type is written `once`",
        ]
      },
      _ -> [],
    },
    _ -> [],
  }
}

fn report_text(
  checker: Checker,
  code: Bytes,
  span: Span,
  text: Bytes,
  message: Bytes,
  label: Bytes,
  notes: List<Bytes>,
) -> Checker =
  report(checker, {
    code: code,
    notes: notes.len(),
    labels: [label_at(checker.module, span, true, label)],
    text: text,
    message: message,
    notes_text: notes,
    severity: b"error",
    fixes: [],
  })

fn bits_text(op: Bytes) -> Bytes =
  if op == b"bitand" { b"&" }
  else if op == b"bitor" { b"|" }
  else if op == b"bitxor" { b"^" }
  else if op == b"shl" { b"<<" }
  else if op == b"shr" { b">>" }
  else { b">>>" }

pub fn expect(
  checker: Checker,
  span: Span,
  expected: Type,
  found: Type,
  context: Bytes,
) -> { checker: Checker, ok: Bool } / {abort.raise} = {
  let u = unify(checker.substitution, checker.fresh, expected, found);
  let c = with_unified(checker, u);
  match u.error {
    Some(e) -> { checker: report_unify(c, e, span, context), ok: false },
    None -> { checker: c, ok: true },
  }
}

fn note_bits(checker: Checker, span: Span, found: Type, what: Bytes) -> Checker =
  {
    ..checker,
    bit_ops: checker.bit_ops.push({ span: span, what: what, ty: found, builtin: false }),
  }

pub fn check_bit_ops(checker: Checker) -> Checker / {abort.raise} = {
  let entries = checker.bit_ops;
  entries.fold({ ..checker, bit_ops: [] }, |c: Checker, entry: BitOp| {
    let ty = resolve(c, entry.ty);
    let witnessed = match ty {
      VariableType(v) -> match c.witnessed.get(v) {
        Some(w) -> w.integer && !entry.builtin,
        None -> false,
      },
      _ -> false,
    };
    if witnessed { c } else {
      match ty {
        VariableType(_) ->
          report_error_at(
            c,
            b"E0210",
            entry.span,
            Bytes::concat_all([b"the integer type of ", entry.what, b" is not determined"]),
            b"nothing here says which integer type this is",
            [
              b"`Int` and the eight fixed-width types are the integer types",
              b"annotate the operand, or write a literal that pins it",
              if entry.builtin {
                b"a builtin over an integer type needs the type written where it is called, not a type parameter"
              } else { b"a type parameter takes the bit operators under `where integer(a)`" },
            ],
          ),
        NamedType(k) -> if k.args.len() == 0 && is_integer_name(k.name) { c }
        else { bits_mismatch(c, entry, ty) },
        _ -> bits_mismatch(c, entry, ty),
      }
    }
  })
}

fn bits_mismatch(checker: Checker, entry: BitOp, ty: Type) -> Checker / {abort.raise} = {
  let name = type_text(ty);
  let notes = [b"`Int` and the eight fixed-width types are the integer types"];
  let stated = match ty {
    NamedType(k) -> match numeric_of(checker.numeric_types, k.name) {
      Some(_) -> true,
      None -> false,
    },
    _ -> false,
  };
  if entry.builtin && stated {
    report_error_at(
      checker,
      b"E0223",
      entry.span,
      Bytes::concat_all([
        entry.what,
        b" is the builtin integers', and `",
        name,
        b"` states its own arithmetic",
      ]),
      Bytes::concat_all([b"has type `", name, b"`"]),
      [
        b"wrapping, saturating and checked arithmetic and the rotations act at a width, which a type that states `numeric` has not",
        b"its `numeric` gives it `+`, `-`, `*` and unary `-`; its module has a function for anything else",
      ],
    )
  } else {
    report_error_at(
      checker,
      b"E0201",
      entry.span,
      Bytes::concat_all([entry.what, b" is not defined on `", name, b"`"]),
      Bytes::concat_all([b"has type `", name, b"`"]),
      if name == bool_name() { notes.push(bool_bits_note()) } else { notes },
    )
  }
}

fn bool_bits_note() -> Bytes = b"`Bool` has `&&`, `||` and `!`; the bit operators are integers only"

pub fn check_concats(checker: Checker) -> Checker / {abort.raise} = {
  let entries = checker.concats;
  entries.fold({ ..checker, concats: [] }, |c: Checker, entry: ConcatSite| {
    let in_module: Checker = { ..c, module: entry.module };
    let ty = resolve(in_module, entry.ty);
    let judged: Checker = match concat_name(ty) {
      Some(_) -> in_module,
      None -> match ty {
        VariableType(_) ->
          report_error_at(
            in_module,
            b"E0210",
            entry.span,
            b"the type of this `++` is not determined",
            b"nothing here says whether this joins `String`s or `Bytes`",
            [b"annotate an operand, or write a literal that pins it"],
          ),
        other ->
          report_error_at(
            in_module,
            b"E0201",
            entry.span,
            Bytes::concat_all([b"`++` is not defined on `", type_text(other), b"`"]),
            b"joined here",
            [b"`++` joins two `String`s or two `Bytes`"],
          ),
      },
    };
    { ..judged, module: c.module }
  })
}

fn mentions_columns(ty: Type) -> Bool =
  match ty {
    VariableType(_) -> false,
    NamedType(c) ->
      c.name == columns_name()
        || c.args.fold(false, |any: Bool, a: Type| any || mentions_columns(a)),
    FunctionType(f) ->
      mentions_columns(f.ret)
        || f.params.fold(false, |any: Bool, p: Type| any || mentions_columns(p)),
    RecordType(fs) -> fs.fold(false, |any: Bool, f: Field| any || mentions_columns(f.ty)),
    NominalType(x) -> x.args.fold(false, |any: Bool, a: Type| any || mentions_columns(a)),
  }

fn columns_elements(ty: Type) -> List<Type> =
  match ty {
    VariableType(_) -> [],
    NamedType(c) ->
      c.args.fold(columns_row(ty).to_list(), |acc: List<Type>, a: Type|
        acc.concat(columns_elements(a))),
    FunctionType(f) ->
      f.params.fold(columns_elements(f.ret), |acc: List<Type>, p: Type|
        acc.concat(columns_elements(p))),
    RecordType(fs) -> fs.fold([], |acc: List<Type>, f: Field| acc.concat(columns_elements(f.ty))),
    NominalType(x) -> x.args.fold([], |acc: List<Type>, a: Type| acc.concat(columns_elements(a))),
  }

pub fn check_columns(checker: Checker) -> Checker / {abort.raise} = {
  let entries = checker.columns;
  entries.fold({ ..checker, columns: [] }, |c: Checker, entry: ColumnsSite| {
    let in_module: Checker = { ..c, module: entry.module };
    let judged: Checker = columns_elements(resolve(in_module, entry.ty)).fold(
      in_module,
      |k: Checker, elem: Type|
        match elem {
          VariableType(_) -> k,
          RecordType(fs) -> if fs.len() > 0 { k } else {
            columns_rejected(k, entry.span, b"a record of no fields has no column to count it by")
          },
          NominalType(x) -> if x.fields.len() > 0 { k } else {
            columns_rejected(
              k,
              entry.span,
              Bytes::concat_all([b"`", type_text(elem), b"` is not a record of fields"]),
            )
          },
          other ->
            columns_rejected(
              k,
              entry.span,
              Bytes::concat_all([b"`", type_text(other), b"` is not a record"]),
            ),
        },
    );
    { ..judged, module: c.module }
  })
}

fn columns_rejected(checker: Checker, span: Span, reason: Bytes) -> Checker =
  report_error_at(
    checker,
    b"E0224",
    span,
    b"a `Columns` holds records, each field apart",
    reason,
    [
      b"a `Columns<T>` lays out every field of `T` as an array of its own; `T` is a record type of at least one field",
      b"an `Array<T>` holds any type",
    ],
  )

fn bind_all(checker: Checker, bindings: List<Binder>) -> Checker / {abort.raise} =
  bindings.fold(checker, |c: Checker, b: Binder|
    { ..c, env: env_bind(c.env, b.name, monomorphic(b.ty)) })

type Hint = { ty: Type, met: Equations }

type Equations = | NoEquations | Equation({ expected: Type, found: Type, before: Equations })

pub fn hint_of(ty: Type) -> Option<Hint> = Some({ ty: ty, met: NoEquations })

fn hint_after(hint: Option<Hint>, earlier: Type) -> Option<Hint> =
  match hint {
    Some(h) -> Some({ ty: h.ty, met: Equation({ expected: h.ty, found: earlier, before: h.met }) }),
    None -> hint_of(earlier),
  }

fn equations_of(hint: Option<Hint>) -> Equations =
  match hint { Some(h) -> h.met, None -> NoEquations }

fn hint_type(checker: Checker, hint: Option<Hint>) -> Option<Type> / {abort.raise} =
  match hint {
    None -> None,
    Some(h) -> match shallow_resolve(checker.substitution, h.ty) {
      VariableType(v) -> found_for(checker, h.met, [v]),
      t -> Some(t),
    },
  }

fn hint_depth_limit() -> Int = 16

fn found_for(checker: Checker, met: Equations, wanted: List<Int>) -> Option<Type> / {abort.raise} =
  match met {
    NoEquations -> None,
    Equation(m) -> match counterpart_of(checker, m.expected, m.found, wanted, hint_depth_limit()) {
      Some(VariableType(w)) -> found_for(checker, m.before, wanted.push(w)),
      None -> found_for(checker, m.before, wanted),
      found -> found,
    },
  }

fn counterpart_of(
  checker: Checker,
  expected: Type,
  found: Type,
  wanted: List<Int>,
  room: Int,
) -> Option<Type> / {abort.raise} =
  if room <= 0 { None } else {
    match shallow_resolve(checker.substitution, expected) {
      VariableType(v) -> if wanted.contains(v) {
        Some(shallow_resolve(checker.substitution, found))
      } else { None },
      NamedType(e) -> match shallow_resolve(checker.substitution, found) {
        NamedType(f) -> if e.name != f.name { None }
        else { counterparts_of(checker, e.args, f.args, wanted, room - 1) },
        _ -> None,
      },
      NominalType(e) -> match shallow_resolve(checker.substitution, found) {
        NominalType(f) -> if e.name != f.name { None }
        else { counterparts_of(checker, e.args, f.args, wanted, room - 1) },
        _ -> None,
      },
      FunctionType(e) -> match shallow_resolve(checker.substitution, found) {
        FunctionType(f) ->
          counterparts_of(checker, e.params.push(e.ret), f.params.push(f.ret), wanted, room - 1),
        _ -> None,
      },
      RecordType(es) -> match shallow_resolve(checker.substitution, found) {
        RecordType(fs) ->
          es.fold(None, |got: Option<Type>, field: Field|
            match got {
              Some(_) -> got,
              None -> match field_get(fs, field.name) {
                Some(t) -> counterpart_of(checker, field.ty, t, wanted, room - 1),
                None -> None,
              },
            }),
        _ -> None,
      },
    }
  }

fn counterparts_of(
  checker: Checker,
  expected: List<Type>,
  found: List<Type>,
  wanted: List<Int>,
  room: Int,
) -> Option<Type> / {abort.raise} =
  expected.fold({ at: 0, got: None }, |acc: { at: Int, got: Option<Type> }, e: Type|
    {
      at: acc.at + 1,
      got: match acc.got {
        Some(_) -> acc.got,
        None -> match found.at(acc.at) {
          Some(f) -> counterpart_of(checker, e, f, wanted, room),
          None -> None,
        },
      },
    }).got

fn field_hint(fields: List<Field>, name: Bytes, met: Equations) -> Option<Hint> =
  match field_get(fields, name) { Some(t) -> Some({ ty: t, met: met }), None -> None }

fn infer_args(
  checker: Checker,
  expressions: List<Expression>,
  span: Span,
  repeats: List<Int>,
  waits: Option<Bytes>,
  params: List<Type>,
  met: Equations,
  ranged: Option<RangeArgument>,
  first: Option<Type> = None,
) -> { checker: Checker, types: List<Type>, effects: Effects, nodes: List<Option<WalkedExpression>> } / {abort.raise} = {
  let before = match first { Some(_) -> 1, None -> 0 };
  let walked = range(before, before + expressions.len()).fold(
    {
      checker: checker,
      types: match first { Some(ty) -> [ty], None -> [] },
      effects: no_effects(),
      met: match ((first, params.at(0))) {
        (Some(ty), Some(p)) -> Equation({ expected: p, found: ty, before: met }),
        _ -> met,
      },
      nodes: [],
    },
    |acc: { checker: Checker, types: List<Type>, effects: Effects, met: Equations, nodes: List<Option<WalkedExpression>> }, i: Int| {
      let x = expressions.get(i - before);
      let param = params.at(i);
      let hint = match param { Some(p) -> Some({ ty: p, met: acc.met }), None -> None };
      let lambda = match x { LambdaExpression(_) -> true, _ -> false };
      let looped = repeats.contains(i) && lambda;
      let ranging: Checker = match ranged {
        Some(r) -> if r.at != i || !lambda { acc.checker } else {
          {
            ..acc.checker,
            guards: guards::over_range(reader_of(acc.checker), acc.checker.guards, r.lo, r.hi),
          }
        },
        None -> acc.checker,
      };
      let o: Inference = if looped {
        let inner: Inference = infer(
          { ..ranging, over: Some(span), pending_iterations: [] },
          x,
          hint,
        );
        {
          ..inner,
          checker: {
            ..inner.checker,
            over: acc.checker.over,
            pending_iterations: acc.checker.pending_iterations,
          },
        }
      } else {
        match waits {
          Some(g) -> if !lambda { infer(ranging, x, hint) } else {
            let inner: Inference = infer(
              {
                ..ranging,
                pending_iterations: [{ callee: g, param: Some(i), span: span }].concat(
                  ranging.pending_iterations,
                ),
              },
              x,
              hint,
            );
            {
              ..inner,
              checker: { ..inner.checker, pending_iterations: acc.checker.pending_iterations },
            }
          },
          None -> infer(ranging, x, hint),
        }
      };
      let j: WithEffects = join(o.checker, span, acc.effects, o.effects);
      {
        checker: j.checker,
        types: acc.types.push(o.ty),
        effects: j.effects,
        met: match param {
          Some(p) -> Equation({ expected: p, found: o.ty, before: acc.met }),
          None -> acc.met,
        },
        nodes: acc.nodes.push(typed_at(o, expression_span(x))),
      }
    },
  );
  { checker: walked.checker, types: walked.types, effects: walked.effects, nodes: walked.nodes }
}

pub fn infer_whole(
  checker: Checker,
  expression: Expression,
  hint: Option<Hint> = None,
) -> Inference / {abort.raise} = {
  let o: Inference = infer(checker, expression, hint);
  let typed = o.checker.copied_defaults.fold(
    { checker: { ..o.checker, copied_defaults: [] }, copied_fields: [] },
    |acc: { checker: Checker, copied_fields: List<Option<WalkedExpression>> }, d: { expression: Expression, ty: Type }| {
      let t: Inference = infer(acc.checker, d.expression, hint_of(d.ty));
      {
        checker: expect_or_widen(
          t.checker,
          expression_span(d.expression),
          d.ty,
          t.ty,
          b"a parameter's default",
        ),
        copied_fields: acc.copied_fields.push(typed_at(t, expression_span(d.expression))),
      }
    },
  );
  let whole = match typed_at(o, expression_span(expression)) {
    Some(e) -> if typed.checker.copied_defaults.len() > 0 { None }
    else { defaults_filled(e, typed.copied_fields) },
    None -> None,
  };
  {
    ..o,
    checker: { ..typed.checker, copied_defaults: [] },
    node: match whole { Some(e) -> Some(e.node), None -> None },
  }
}

fn callee_repeats(
  checker: Checker,
  function: Expression,
  args: List<Expression>,
) -> { params: List<Int>, waits: Option<Bytes> } / {abort.raise} = {
  let builtin = prelude_name_of(checker, function);
  if builtin != b"" {
    {
      params: match prelude_callback_use(builtin) {
        None -> [],
        Some(it) -> if it.iterated_parameters.len() == 0 { [] }
        else if it.iterated_parameters.fold(true, |all: Bool, k: Int|
            all && (match args.at(k) { Some(x) -> fixed_size(checker, x), None -> false })) { [] }
        else { [it.callback] },
      },
      waits: None,
    }
  } else {
    match callee_source(checker, function) {
      PerformViaCall(name) -> { params: [], waits: Some(name) },
      PerformViaFunctionValue -> { params: range(0, args.len()), waits: None },
      _ -> { params: [], waits: None },
    }
  }
}

fn callback_parameters_of(
  checker: Checker,
  name: Bytes,
) -> { checker: Checker, params: List<Int> } / {abort.raise} =
  match checker.function_parameters.get(name) {
    Some(params) -> { checker: checker, params: params },
    None -> {
      let params = match env_lookup(checker.env, name) {
        Some(scheme) -> match scheme.ty {
          FunctionType(f) ->
            range(0, f.params.len()).filter(|i: Int| contains_function(f.params.get(i))),
          _ -> [],
        },
        None -> [],
      };
      {
        checker: {
          ..checker,
          function_parameters: checker.function_parameters.insert(name, params),
        },
        params: params,
      }
    },
  }

fn fixed_size(checker: Checker, e: Expression) -> Bool / {abort.raise} =
  match e {
    LiteralExpression(_) -> true,
    ListExpression(_) -> true,
    CallExpression(a) ->
      prelude_name_of(checker, a.function) == b"range"
        && a.args.fold(true, |ok: Bool, x: Expression|
          ok && (match x { LiteralExpression(_) -> true, _ -> false })),
    _ -> false,
  }

fn repeated_effects(
  checker: Checker,
  params: List<Type>,
  repeats: List<Int>,
) -> { listed: List<Effect>, vars: List<Int> } / {abort.raise} =
  repeats.fold({ listed: [], vars: [] }, |acc: { listed: List<Effect>, vars: List<Int> }, i: Int|
    match params.at(i) { Some(t) -> effects_in(checker, t, acc), None -> acc })

pub fn effects_in(
  checker: Checker,
  t: Type,
  acc: { listed: List<Effect>, vars: List<Int> },
) -> { listed: List<Effect>, vars: List<Int> } / {abort.raise} =
  effects_of(checker, resolve(checker, t), acc)

fn effects_of(
  checker: Checker,
  t: Type,
  acc: { listed: List<Effect>, vars: List<Int> },
) -> { listed: List<Effect>, vars: List<Int> } / {abort.raise} =
  match t {
    FunctionType(f) -> {
      let r = resolve_effects_in(checker, f.effects);
      let own = {
        listed: acc.listed.concat(r.listed),
        vars: match r.variable { Some(v) -> acc.vars.push(v), None -> acc.vars },
      };
      f.params.fold(
        effects_of(checker, f.ret, own),
        |a: { listed: List<Effect>, vars: List<Int> }, p: Type| effects_of(checker, p, a),
      )
    },
    NamedType(c) ->
      c.args.fold(acc, |a: { listed: List<Effect>, vars: List<Int> }, x: Type|
        effects_of(checker, x, a)),
    RecordType(fs) ->
      fs.fold(acc, |a: { listed: List<Effect>, vars: List<Int> }, f: Field|
        effects_of(checker, f.ty, a)),
    NominalType(n) ->
      n.fields.fold(acc, |a: { listed: List<Effect>, vars: List<Int> }, f: Field|
        effects_of(checker, f.ty, a)),
    VariableType(_) -> acc,
  }

pub fn repeated_effects_include(scales: List<Effect>, a: Effect) -> Bool =
  scales.fold(false, |found: Bool, s: Effect|
    found
      || (s.effect == a.effect && mode_eq(s.mode, a.mode) && s.op == a.op
      && (s.resource == a.resource
      || (match s.resource { ResourceVariable(_) -> true, _ -> false }))))

fn record_repeated_variable(
  checker: Checker,
  variable: Option<Int>,
  vars: List<Int>,
  maybe: List<PendingIteration>,
  span: Span,
) -> Checker =
  match variable {
    None -> checker,
    Some(v) -> if vars.contains(v) {
      {
        ..checker,
        repeated_variables: checker.repeated_variables.push({
          var: v,
          over: Some(span),
          pending_iterations: [],
        }),
      }
    } else {
      let waits = maybe.concat(checker.pending_iterations);
      if checker.over == None && waits.len() == 0 { checker } else {
        {
          ..checker,
          repeated_variables: checker.repeated_variables.push({
            var: v,
            over: checker.over,
            pending_iterations: waits,
          }),
        }
      }
    },
  }

fn infer_all(
  checker: Checker,
  expressions: List<Expression>,
  span: Span,
) -> { checker: Checker, types: List<Type>, effects: Effects } / {abort.raise} =
  expressions.fold(
    { checker: checker, types: [], effects: no_effects() },
    |acc: { checker: Checker, types: List<Type>, effects: Effects }, expression: Expression| {
      let o: Inference = infer(acc.checker, expression);
      let j: WithEffects = join(o.checker, span, acc.effects, o.effects);
      { checker: j.checker, types: acc.types.push(o.ty), effects: j.effects }
    },
  )

pub fn body_recorded(
  checker: Checker,
  owner: Bytes,
  part: BodyPart,
  base: Int,
  params: List<TypedParam<Type>>,
  o: Inference,
  expression: Expression,
) -> Checker =
  match typed_at(o, expression_span(expression)) {
    Some(b) ->
      {
        ..checker,
        typed_bodies: checker.typed_bodies.push({
          owner: owner,
          part: part,
          module: checker.module,
          base: base,
          params: params,
          body: b,
        }),
      },
    None -> checker,
  }

fn typed_at(o: Inference, at: Span) -> Option<WalkedExpression> =
  match o.node { Some(n) -> Some({ node: n, span: at, ty: o.ty }), None -> None }

fn infer(
  checker: Checker,
  expression: Expression,
  hint: Option<Hint> = None,
) -> Inference / {abort.raise} = infer_here(checker, expression, hint)

fn infer_here(
  checker: Checker,
  expression: Expression,
  hint: Option<Hint>,
) -> Inference / {abort.raise} =
  match expression {
    LiteralExpression(l) ->
      {
        checker: checker,
        ty: literal_type(l.literal),
        effects: no_effects(),
        node: Some(WalkedLiteral(l.literal)),
      },
    InvalidExpression(_) -> {
      let o: WithType = new_type(checker);
      { checker: o.checker, ty: o.ty, effects: no_effects(), node: None }
    },
    HoleExpression(h) -> {
      let o: WithVar = new_type_var(checker);
      {
        checker: {
          ..o.checker,
          holes: o.checker.holes.push({
            module: checker.module,
            span: h.span,
            var: o.var,
            locals: env_locals(checker.env),
            declared: if checker.effects_written { Some(checker.declared_effects) } else { None },
            owner: checker.current_definition,
            text: h.text,
          }),
        },
        ty: VariableType(o.var),
        effects: no_effects(),
        node: Some(
          WalkedPerform({
            effect: b"abort",
            op: b"raise",
            resource: None,
            entry: abort_effect(),
            args: [
              {
                node: WalkedLiteral(LiteralString(b"unfilled hole")),
                span: h.span,
                ty: string_type(),
              },
            ],
          }),
        ),
      }
    },
    NameExpression(v) -> {
      let o: Inference = infer_var(checker, v.name, v.span);
      if !is_int_builtin(expression) { o } else {
        match o.ty {
          FunctionType(f) -> match f.params.at(0) {
            Some(t) -> {
              let bit_op = {
                span: v.span,
                what: int_builtin_text(expression, []),
                ty: t,
                builtin: true,
              };
              {
                checker: if prelude_name_of(o.checker, expression) == b"" { o.checker }
                else { { ..o.checker, bit_ops: o.checker.bit_ops.push(bit_op) } },
                ty: o.ty,
                effects: o.effects,
                node: o.node,
              }
            },
            None -> o,
          },
          _ -> o,
        }
      }
    },
    UnaryExpression(u) -> {
      let o: Inference = infer(checker, u.operand);
      let node = unary_of(u.op, typed_at(o, expression_span(u.operand)));
      if u.op == b"neg" {
        {
          checker: {
            ..o.checker,
            numerics: o.checker.numerics.push({ span: u.span, op: b"neg", ty: o.ty }),
          },
          ty: o.ty,
          effects: o.effects,
          node: node,
        }
      } else if u.op == b"bitnot" {
        {
          checker: note_bits(o.checker, expression_span(u.operand), o.ty, b"the operand of `~`"),
          ty: o.ty,
          effects: o.effects,
          node: node,
        }
      } else {
        let x: ExpectResult = expect(
          o.checker,
          expression_span(u.operand),
          bool_type(),
          o.ty,
          b"operand of a unary operator",
        );
        { checker: x.checker, ty: bool_type(), effects: o.effects, node: node }
      }
    },
    BinaryExpression(b) -> infer_binary(checker, b.span, b.op, b.lhs, b.rhs),
    LambdaExpression(l) -> {
      let outer = checker;
      let checker = forbid_assignment(outer, b"a lambda");
      let pushed: Checker = { ..checker, env: env_push(checker.env) };
      let expected = match hint_type(checker, hint) { Some(FunctionType(f)) -> f.params, _ -> [] };
      let ps = l.params.fold(
        { checker: pushed, types: [], params: [] },
        |acc: { checker: Checker, types: List<Type>, params: List<TypedParam<Type>> }, p: Param| {
          let t: WithType = match p.ty {
            Some(te) -> {
              let o: WithType = convert_type(acc.checker, te);
              { checker: check_scoped_placement(o.checker, te, o.ty, true), ty: o.ty }
            },
            None -> match expected.at(acc.types.len()) {
              Some(e) -> match hint_type(acc.checker, Some({ ty: e, met: equations_of(hint) })) {
                Some(resolved) -> { checker: acc.checker, ty: resolved },
                None -> new_type(acc.checker),
              },
              None -> new_type(acc.checker),
            },
          };
          {
            checker: { ..t.checker, env: env_bind(t.checker.env, p.name, monomorphic(t.ty)) },
            types: acc.types.push(t.ty),
            params: acc.params.push({ name: p.name.name, ty: t.ty, span: p.name.span }),
          }
        },
      );
      let entered: Checker = match ps.checker.guards.ranged {
        None -> ps.checker,
        Some(_) -> {
          let reader = reader_of(ps.checker);
          {
            ..ps.checker,
            guards: guards::enter_range_lambda(
              reader,
              ps.checker.guards,
              match l.params.at(l.params.len() - 1) {
                Some(p) -> (reader.name)(bare(p.name)),
                None -> Elsewhere,
              },
            ),
          }
        },
      };
      let written: { checker: Checker, ty: Option<Type> } = match l.ret {
        Some(te) -> {
          let w: WithType = convert_type(entered, te);
          { checker: check_scoped_placement(w.checker, te, w.ty, false), ty: Some(w.ty) }
        },
        None -> { checker: entered, ty: None },
      };
      let result = match written.ty {
        Some(t) -> hint_of(t),
        None -> match hint_type(written.checker, hint) {
          Some(FunctionType(f)) -> Some({ ty: f.ret, met: equations_of(hint) }),
          _ -> None,
        },
      };
      let body: Inference = infer(written.checker, l.body, result);
      let checked: Checker = match written.ty {
        Some(t) ->
          expect_or_widen(
            body.checker,
            expression_span(l.body),
            t,
            body.ty,
            b"the lambda's written return type",
          ),
        None -> body.checker,
      };
      let made: Inference = {
        checker: restore_guards({ ..checked, env: env_pop(checked.env) }, checker.guards),
        ty: fn_type(ps.types, body.ty, body.effects),
        effects: no_effects(),
        node: lambda_of(
          ps.params,
          range(0, l.params.len()).filter(|i: Int| l.params.get(i).keep),
          typed_at(body, expression_span(l.body)),
          body.effects,
        ),
      };
      restore_assignable(outer, made)
    },
    CallExpression(a) -> match a.function {
      FieldExpression(f) -> {
        let b: Inference = infer(checker, f.base);
        let d = member_target(a.span, f.span, b, f.base, f.field, a.args, a.named, a.labels);
        let taken: TrailingArguments = range(0, d.rest.len()).fold(
          { checker: d.checker, rest: [], effects: no_effects() },
          |acc: TrailingArguments, k: Int|
            match d.rest.get(k) {
              FromName(j) -> {
                let x = a.named.get(j).value;
                let i = d.parameter_offset + a.args.len() + k;
                let expected = match d.params.at(i) {
                  Some(p) -> Some({ ty: p, met: d.equations }),
                  None -> None,
                };
                let o: Inference = match ((d.waits, x)) {
                  (Some(g), LambdaExpression(_)) -> {
                    let inner: Inference = infer(
                      {
                        ..acc.checker,
                        pending_iterations: [{ callee: g, param: Some(i), span: a.span }].concat(
                          acc.checker.pending_iterations,
                        ),
                      },
                      x,
                      expected,
                    );
                    {
                      ..inner,
                      checker: {
                        ..inner.checker,
                        pending_iterations: acc.checker.pending_iterations,
                      },
                    }
                  },
                  _ -> infer(acc.checker, x, expected),
                };
                let j1: WithEffects = join(o.checker, a.span, acc.effects, o.effects);
                {
                  checker: j1.checker,
                  rest: acc.rest.push(
                    NamedValue({ written: x, ty: o.ty, node: typed_at(o, expression_span(x)) }),
                  ),
                  effects: j1.effects,
                }
              },
              FromDefault(copied) -> { ..acc, rest: acc.rest.push(CopiedDefault(copied)) },
              _ -> acc,
            },
        );
        infer_member_call(a.span, d, taken, b, f.base, f.field, a.args, a.labels, hint, false)
      },
      _ -> infer_app(checker, a.span, a.function, a.args, a.labels, hint),
    },
    IfExpression(i) -> {
      let c: Inference = infer(checker, i.cond);
      let cc: Checker = expect(
        c.checker,
        expression_span(i.cond),
        bool_type(),
        c.ty,
        b"condition of `if`",
      ).checker;
      let t: Inference = infer(assume_condition(cc, i.cond, true), i.then_branch, hint);
      let el: Inference = infer(
        assume_condition(restore_guards(t.checker, cc.guards), i.cond, false),
        i.else_branch,
        hint_after(hint, t.ty),
      );
      let agreed: { checker: Checker, ty: Type } = agree(
        restore_guards(el.checker, cc.guards),
        expression_span(i.else_branch),
        t.ty,
        el.ty,
        b"branches of `if` must agree",
      );
      let j1: WithEffects = join(agreed.checker, i.span, c.effects, t.effects);
      let j2: WithEffects = join(j1.checker, i.span, j1.effects, el.effects);
      {
        checker: j2.checker,
        ty: agreed.ty,
        effects: j2.effects,
        node: if_of(
          typed_at(c, expression_span(i.cond)),
          typed_at(t, expression_span(i.then_branch)),
          typed_at(el, expression_span(i.else_branch)),
        ),
      }
    },
    MatchExpression(m) -> infer_match(checker, m.span, m.scrutinee, m.arms, hint),
    BlockExpression(b) -> {
      let pushed: Checker = { ..checker, env: env_push(checker.env) };
      let statements = b.statements.fold(
        { checker: pushed, effects: no_effects(), fallbacks: [], nodes: [] },
        |acc: { checker: Checker, effects: Effects, fallbacks: List<LetElse>, nodes: List<Option<WalkedStatement>> }, s: Statement| {
          let o: StatementResult = infer_statement(acc.checker, s, hint);
          let j: WithEffects = join(o.checker, b.span, acc.effects, o.effects);
          {
            checker: j.checker,
            effects: j.effects,
            fallbacks: match o.fallback { Some(f) -> acc.fallbacks.push(f), None -> acc.fallbacks },
            nodes: acc.nodes.push(o.node),
          }
        },
      );
      let tail: { checker: Checker, ty: Type, effects: Effects, node: Option<Option<WalkedExpression>> } = match b.tail {
        Some(t) -> {
          let o: Inference = infer(statements.checker, t, hint);
          let j: WithEffects = join(o.checker, b.span, statements.effects, o.effects);
          {
            checker: j.checker,
            ty: o.ty,
            effects: j.effects,
            node: Some(typed_at(o, expression_span(t))),
          }
        },
        None ->
          { checker: statements.checker, ty: unit_type(), effects: statements.effects, node: None },
      };
      let agreed: Joined = statements.fallbacks.fold(
        { checker: tail.checker, ty: tail.ty, variables: [] },
        |acc: Joined, f: LetElse|
          join_type_into(acc, f.span, f.ty, b"the `else` of a `let ... else` is its block's value"),
      );
      let closed: Checker = close_effect_variables(agreed.checker, agreed.variables);
      {
        checker: restore_guards({ ..closed, env: env_pop(closed.env) }, checker.guards),
        ty: agreed.ty,
        effects: tail.effects,
        node: block_of(statements.nodes, tail.node),
      }
    },
    RecordExpression(r) -> {
      let met = equations_of(hint);
      match hint_type(checker, hint) {
        Some(NominalType(n)) if !is_misplaced_tuple(r.fields, n.fields) -> match reject_opaque_record(
            checker,
            r.span,
            n.name,
            b"this literal would be one",
          ) {
          Some(rejected) -> {
            let values = infer_all(rejected, r.fields.map(|f: RecordLiteralField| f.value), r.span);
            { checker: values.checker, ty: NominalType(n), effects: values.effects, node: None }
          },
          None -> infer_nominal(checker, r.span, r.fields, n, met),
        },
        expected -> {
          let known = match expected { Some(RecordType(fs)) -> fs, _ -> [] };
          let fs = r.fields.fold(
            { checker: checker, fs: [], effects: no_effects(), values: [] },
            |acc: { checker: Checker, fs: List<Field>, effects: Effects, values: List<{ name: Bytes, value: Option<WalkedExpression> }> }, f: RecordLiteralField| {
              let o: Inference = infer(acc.checker, f.value, field_hint(known, f.name.name, met));
              let j: WithEffects = join(o.checker, r.span, acc.effects, o.effects);
              {
                checker: j.checker,
                fs: acc.fs.push({ name: f.name.name, ty: o.ty }),
                effects: j.effects,
                values: acc.values.push({
                  name: f.name.name,
                  value: typed_at(o, expression_span(f.value)),
                }),
              }
            },
          );
          {
            checker: fs.checker,
            ty: RecordType(fields_sorted(fs.fs)),
            effects: fs.effects,
            node: record_of(fs.values),
          }
        },
      }
    },
    RecordUpdateExpression(r) -> infer_record_update(checker, r.span, r.base, r.fields),
    PropagateExpression(_) -> panic("`e?` is expanded away before the checker runs"),
    FieldExpression(f) -> {
      let b: Inference = infer(checker, f.base);
      let base = resolve(b.checker, b.ty);
      match record_fields(base) {
        Some(fs) -> match field_get(fs, f.field.name) {
          Some(t) ->
            {
              checker: b.checker,
              ty: t,
              effects: b.effects,
              node: field_read_of(typed_at(b, expression_span(f.base)), f.field.name),
            },
          None -> {
            let known = fs.map(|x: Field| x.name);
            let o: WithType = new_type(
              report_error_at(
                b.checker,
                b"E0101",
                f.field.span,
                Bytes::concat_all([b"no field `", f.field.name, b"` on this record"]),
                b"unknown field",
                [
                  if known.len() == 0 { b"the record has no fields" }
                  else { b"available fields: ".concat(backticked(known, b", ")) },
                ],
              ),
            );
            { checker: o.checker, ty: o.ty, effects: b.effects, node: None }
          },
        },
        None -> {
          let o: WithType = new_type(
            report_error_at(
              b.checker,
              b"E0201",
              expression_span(f.base),
              Bytes::concat_all([b"cannot read field `", f.field.name, b"` here"]),
              Bytes::concat_all([b"this has type `", type_text(base), b"`, not a record"]),
              [b"annotate the value so its record type is known"],
            ),
          );
          { checker: o.checker, ty: o.ty, effects: b.effects, node: None }
        },
      }
    },
    ListExpression(l) -> {
      let elem: WithType = new_type(checker);
      let each = match hint_type(checker, hint) {
        Some(h) -> match list_item(h) {
          Some(t) -> Some({ ty: t, met: equations_of(hint) }),
          None -> None,
        },
        None -> None,
      };
      let items = l.items.fold(
        { checker: elem.checker, effects: no_effects(), ty: elem.ty, variables: [], nodes: [] },
        |acc: { checker: Checker, effects: Effects, ty: Type, variables: List<Int>, nodes: List<Option<WalkedExpression>> }, x: Expression| {
          let o: Inference = infer(acc.checker, x, hint_after(each, acc.ty));
          let j: WithEffects = join(o.checker, l.span, acc.effects, o.effects);
          let n: Joined = join_type_into(
            { checker: j.checker, ty: acc.ty, variables: acc.variables },
            expression_span(x),
            o.ty,
            b"list elements must agree",
          );
          {
            checker: n.checker,
            effects: j.effects,
            ty: n.ty,
            variables: n.variables,
            nodes: acc.nodes.push(typed_at(o, expression_span(x))),
          }
        },
      );
      let closed: Checker = close_effect_variables(items.checker, items.variables);
      {
        checker: closed,
        ty: list_type(items.ty),
        effects: items.effects,
        node: list_of(items.nodes),
      }
    },
    PerformExpression(p) -> if !is_local_receiver(checker, p.effect_name) {
      infer_perform(checker, p.span, p.effect_name, p.op, p.resource, p.args)
    } else if names_effect(checker, p.effect_name) {
      let said = reject_local_effect_clash(checker, p.effect_name);
      match resolve_op(said, p.effect_name, p.op).hit {
        Some(_) -> infer_perform(said, p.span, p.effect_name, p.op, p.resource, p.args),
        None -> {
          let o: WithType = new_type(said);
          { checker: o.checker, ty: o.ty, effects: no_effects(), node: None }
        },
      }
    } else {
      let at = synthetic_span_at(p.effect_name.span, p.span, role_member_receiver());
      let b: Inference = infer_var(checker, p.effect_name, at);
      let on = NameExpression({ span: at, name: p.effect_name });
      let labels = match p.resource { Some(r) -> [r], None -> [] };
      let d = member_target(
        p.span,
        synthetic_span_at(p.op.span, p.span, role_member_callee()),
        b,
        on,
        p.op,
        p.args,
        [],
        labels,
      );
      infer_member_call(p.span, d, default_arguments(d), b, on, p.op, p.args, labels, hint, true)
    },
    HandleExpression(h) -> infer_handle(checker, h.span, h.body, h.clauses, h.ret, h.vars, hint),
    WithScopeExpression(c) ->
      restore_assignable(
        checker,
        infer_with_scope(
          forbid_assignment(checker, b"a `with_scope` scope"),
          c.span,
          c.resource,
          c.acquire,
          c.release,
          c.binder,
          c.body,
          hint,
        ),
      ),
    SimulateExpression(s) ->
      restore_assignable(
        checker,
        infer_simulate(forbid_assignment(checker, b"a `simulate` body"), s.span, s.body, hint),
      ),
    ParallelExpression(v) ->
      restore_assignable(
        checker,
        infer_parallel(forbid_assignment(checker, b"a `parallel` branch"), v.span, v.branches),
      ),
    TryBlockExpression(t) ->
      restore_assignable(
        checker,
        infer_try_block(forbid_assignment(checker, b"a `try` body"), t.span, t.raise, t.body, hint),
      ),
    TaggedLiteralExpression(t) -> infer_tagged(checker, t),
  }

fn rejection_type(holed: Bool) -> Type / {abort.raise} = {
  let said = [{ name: b"message", ty: string_type() }, { name: b"offset", ty: int_type() }];
  RecordType(fields_sorted(if holed { said.push({ name: b"part", ty: int_type() }) } else { said }))
}

pub fn tag_rule(t: TaggedLiteral) -> Bytes =
  if t.holes.len() == 0 {
    Bytes::concat_all([
      b"`",
      t.tag.name,
      b"\"..\"` is the call `",
      t.tag.name,
      b"::literal(\"..\")`, which the check runs: a function of one `String` answering `Result<T, {message: String, offset: Int}>`, with no parameters of its own and effects that are only raises",
    ])
  } else {
    Bytes::concat_all([
      b"`",
      t.tag.name,
      b"\"..{h}..\"` is the call `",
      t.tag.name,
      b"::fill(c, [h])` of what `",
      t.tag.name,
      b"::compile([\"..\", \"..\"])` answered the check: `compile` a function of one `List<String>` answering `Result<C, {message: String, offset: Int, part: Int}>` and `fill` one of a `C` and a `List<H>`, each with no parameters of its own and effects that are only raises",
    ])
  }

fn not_a_tag(
  checker: Checker,
  t: TaggedLiteral,
  callee: QName,
  message: Bytes,
  label: Bytes,
) -> Checker =
  report_error_at(
    checker,
    b"E0152",
    t.tag.span,
    Bytes::concat_all([b"`", t.tag.name, b"::", callee.name.name, b"` ", message]),
    label,
    [tag_rule(t)],
  )

fn tag_fn(
  checker: Checker,
  t: TaggedLiteral,
  callee: QName,
  takes: List<Type>,
  results: Type,
) -> { checker: Checker, effects: Effects, name: Bytes, callee: Option<WalkedExpression> } / {abort.raise} = {
  let f: Inference = infer_var(checker, callee, callee.span);
  let named: Checker = mark_called(f.checker, callee.span);
  match declared_value(named, callee) {
    None -> { checker: named, effects: no_effects(), name: b"", callee: None },
    Some(name) -> {
      let rejected = |cc: Checker, message: Bytes, label: Bytes|
        {
          checker: not_a_tag(cc, t, callee, message, label),
          effects: no_effects(),
          name: name,
          callee: None,
        };
      let generic = match env_lookup(named.env, name) {
        Some(sc) ->
          sc.type_variables.len() + sc.effect_variables.len() + sc.label_variables.len() > 0,
        None -> false,
      };
      let c: Checker = if !named.own_functions.contains(name) { named } else {
        {
          ..named,
          tag_uses: named.tag_uses.push({
            owner: named.current_definition,
            name: name,
            literal: t,
            callee: callee,
          }),
        }
      };
      match resolve(c, f.ty) {
        FunctionType(fn_) -> {
          let unified = unify(c.substitution, c.fresh, fn_type(takes, results, fn_.effects), f.ty);
          let u: Checker = with_unified(c, unified);
          let effects = resolve_effects_in(u, fn_.effects);
          if generic { rejected(u, b"takes parameters of its own", b"a literal gives it none") }
          else if unified.error != None {
            rejected(
              u,
              Bytes::concat_all([b"has type `", type_text(resolve(u, f.ty)), b"`"]),
              b"not what a tagged literal calls",
            )
          } else if !is_pure_but_raise(effects) {
            rejected(
              u,
              Bytes::concat_all([b"performs `", effects_text(effects), b"`"]),
              b"a tag's function only raises",
            )
          } else { { checker: u, effects: effects, name: name, callee: typed_at(f, callee.span) } }
        },
        other ->
          rejected(
            c,
            Bytes::concat_all([b"has type `", type_text(other), b"`"]),
            b"not what a tagged literal calls",
          ),
      }
    },
  }
}

fn infer_tagged(checker: Checker, t: TaggedLiteral) -> Inference / {abort.raise} = {
  let holed = t.holes.len() > 0;
  let value: WithType = new_type(checker);
  let parsed = tag_fn(
    value.checker,
    t,
    tagged_parser(t),
    [if holed { list_type(string_type()) } else { string_type() }],
    result_type(value.ty, rejection_type(holed)),
  );
  let result = NamedType({ name: b"Result", args: [value.ty, rejection_type(holed)] });
  if !holed {
    {
      checker: parsed.checker,
      ty: value.ty,
      effects: no_effects(),
      node: tagged_literal_node(parsed.checker, t, parsed.callee, result, value.ty, None),
    }
  } else {
    let hole: WithType = new_type(parsed.checker);
    let returned: WithType = new_type(hole.checker);
    let filled = if parsed.name == b"" {
      { checker: returned.checker, effects: no_effects(), name: b"", callee: None }
    } else {
      tag_fn(returned.checker, t, tagged_filler(t), [value.ty, list_type(hole.ty)], returned.ty)
    };
    let held = t.holes.fold(
      { checker: filled.checker, effects: no_effects(), nodes: [] },
      |acc: { checker: Checker, effects: Effects, nodes: List<Option<WalkedExpression>> }, h: Hole| {
        let o: Inference = infer(acc.checker, h.value, hint_of(hole.ty));
        let met: Checker = expect_or_widen(
          o.checker,
          expression_span(h.value),
          hole.ty,
          o.ty,
          b"a hole of a tagged literal",
        );
        let j: WithEffects = join(met, t.span, acc.effects, o.effects);
        {
          checker: j.checker,
          effects: j.effects,
          nodes: acc.nodes.push(typed_at(o, expression_span(h.value))),
        }
      },
    );
    let recorded: Checker = filled.effects.listed.fold(
      held.checker,
      |cc: Checker, entry: Effect| record_perform(cc, entry, t.span, PerformViaCall(filled.name)),
    );
    let j: WithEffects = join(recorded, t.span, held.effects, filled.effects);
    {
      checker: j.checker,
      ty: returned.ty,
      effects: j.effects,
      node: tagged_literal_node(
        j.checker,
        t,
        parsed.callee,
        result,
        value.ty,
        Some({ callee: filled.callee, holes: held.nodes, hole: hole.ty, result: returned.ty }),
      ),
    }
  }
}

fn tagged_literal_node(
  checker: Checker,
  t: TaggedLiteral,
  parser: Option<WalkedExpression>,
  result: Type,
  value: Type,
  fill: Option<{ callee: Option<WalkedExpression>, holes: List<Option<WalkedExpression>>, hole: Type, result: Type }>,
) -> Option<WalkedNode> =
  match ((parser, constructor_of(checker, b"Ok"))) {
    (Some(parse), Some(ok)) -> {
      let at = |role: Int| synthetic_span(t.span, role);
      let texts = tagged_parts(t).map(|part: TaggedPart|
        { node: WalkedLiteral(LiteralString(part.text)), span: part.quoted, ty: string_type() });
      let call = |callee: WalkedExpression, args: List<WalkedExpression>, ret: Type, place: Span|
        {
          node: WalkedCall({ callee: callee, args: args, effects: no_effects() }),
          span: place,
          ty: ret,
        };
      let parsed = call(
        parse,
        match fill {
          None -> texts,
          Some(_) ->
            [{ node: WalkedList(texts), span: at(role_tag_texts()), ty: list_type(string_type()) }],
        },
        result,
        at(role_tag_parse()),
      );
      let read = {
        node: WalkedRead(WalkedLocal({ name: b"?literal", binder: at(role_tag_binder()).site })),
        span: at(role_tag_read()),
        ty: value,
      };
      let tail: Option<WalkedExpression> = match fill {
        None -> Some(read),
        Some(f) -> match ((f.callee, Option::all(f.holes))) {
          (Some(filler), Some(holes)) ->
            Some(
              call(
                filler,
                [
                  read,
                  { node: WalkedList(holes), span: at(role_tag_holes()), ty: list_type(f.hole) },
                ],
                f.result,
                at(role_tag_fill()),
              ),
            ),
          _ -> None,
        },
      };
      match tail {
        Some(x) ->
          Some(
            WalkedBlock({
              statements: [
                WalkedLet({
                  pattern: TypedCase({
                    sum: ok.type_name,
                    name: ok.name,
                    case: ok.index,
                    args: [
                      TypedBinder({ name: b"?literal", ty: value, span: at(role_tag_binder()) }),
                    ],
                  }),
                  value: parsed,
                  span: at(role_tag_let()),
                }),
              ],
              tail: Some(x),
            }),
          ),
        None -> None,
      }
    },
    _ -> None,
  }

fn infer_parallel(
  checker: Checker,
  span: Span,
  branches: List<Expression>,
) -> Inference / {abort.raise} = {
  let out = range(0, branches.len()).fold(
    { checker: checker, fs: [], effects: no_effects(), branch_effects: [], branches: [] },
    |acc: { checker: Checker, fs: List<Field>, effects: Effects, branch_effects: List<{ span: Span, effects: Effects }>, branches: List<{ body: Option<WalkedExpression>, effects: Effects }> }, i: Int| {
      let b = branches.get(i);
      let o: Inference = infer(acc.checker, b);
      let j: WithEffects = join(o.checker, span, acc.effects, o.effects);
      {
        checker: j.checker,
        fs: acc.fs.push({ name: b"_".concat(ascii_of_int(i)), ty: o.ty }),
        effects: j.effects,
        branch_effects: acc.branch_effects.push({ span: expression_span(b), effects: o.effects }),
        branches: acc.branches.push({ body: typed_at(o, expression_span(b)), effects: o.effects }),
      }
    },
  );
  let site = { module: out.checker.module, span: span, branches: out.branch_effects };
  {
    checker: { ..out.checker, parallels: out.checker.parallels.push(site) },
    ty: RecordType(fields_sorted(out.fs)),
    effects: out.effects,
    node: parallel_of(out.branches),
  }
}

fn is_misplaced_tuple(written: List<RecordLiteralField>, fields: List<Field>) -> Bool =
  match written {
    [first, ..] -> first.name.name == b"_0" && field_get(fields, b"_0") == None,
    [] -> false,
  }

fn reject_opaque_record(
  checker: Checker,
  span: Span,
  name: Bytes,
  how: Bytes,
) -> Option<Checker> / {abort.raise} =
  match checker.types.get(name) {
    None -> None,
    Some(declaration) -> match declaration.opaque {
      None -> None,
      Some(opaque) -> if declaration.owner != checker.module {
        let home = module_name(checker, declaration.owner);
        Some(
          report_error_at_and(
            checker,
            b"E0220",
            span,
            Bytes::concat_all([b"only `", home, b"` builds a `", name, b"`"]),
            how,
            { module: declaration.owner, span: opaque.span },
            b"declared `opaque` here",
            opaque_notes(home, opaque),
          ),
        )
      } else if checker.copied {
        Some(
          report_error_at(
            checker,
            b"E0122",
            span,
            Bytes::concat_all([
              b"a default on a `pub fn` cannot build `",
              simple_name_of(name),
              b"`",
            ]),
            b"an opaque type, built only in this module",
            [
              b"the default is copied into every call site that omits the argument, and a caller in another module may not build one",
            ],
          ),
        )
      } else { None },
    },
  }

fn infer_nominal(
  checker: Checker,
  span: Span,
  written: List<RecordLiteralField>,
  n: { name: Bytes, args: List<Type>, fields: List<Field> },
  met: Equations,
) -> Inference / {abort.raise} = {
  let known = backticked(n.fields.map(|field: Field| field.name), b", ");
  let walked = written.fold(
    { checker: checker, effects: no_effects(), values: [] },
    |acc: { checker: Checker, effects: Effects, values: List<{ name: Bytes, value: Option<WalkedExpression> }> }, f: RecordLiteralField| {
      let o: Inference = infer(acc.checker, f.value, field_hint(n.fields, f.name.name, met));
      let met: Checker = match field_get(n.fields, f.name.name) {
        Some(t) ->
          expect_or_widen(
            o.checker,
            expression_span(f.value),
            t,
            o.ty,
            b"a field of a `new` record",
          ),
        None ->
          report_error_at(
            o.checker,
            b"E0101",
            f.name.span,
            Bytes::concat_all([b"no field `", f.name.name, b"` on `", n.name, b"`"]),
            b"unknown field",
            [
              Bytes::concat_all([
                b"a `",
                n.name,
                b"` is expected here, and its fields are ",
                known,
              ]),
            ],
          ),
      };
      let j: WithEffects = join(met, span, acc.effects, o.effects);
      {
        checker: j.checker,
        effects: j.effects,
        values: acc.values.push({
          name: f.name.name,
          value: typed_at(o, expression_span(f.value)),
        }),
      }
    },
  );
  let named = written.map(|f: RecordLiteralField| f.name.name);
  let omitted = n.fields.filter(|field: Field| !named.contains(field.name));
  let whole: Checker = if omitted.len() == 0 { walked.checker } else {
    report_error_at(
      walked.checker,
      b"E0201",
      span,
      Bytes::concat_all([b"this record does not name every field of `", n.name, b"`"]),
      b"missing: ".concat(backticked(omitted.map(|field: Field| field.name), b", ")),
      [
        Bytes::concat_all([
          b"a `",
          n.name,
          b"` is expected here; write every field, or change some of one you have with `{ ..base, field: value }`",
        ]),
      ],
    )
  };
  let keyed: Checker = if n.args.len() == 0 { whole }
  else { n.fields.fold(whole, |c: Checker, field: Field| note_map_keys(c, span, field.ty)) };
  {
    checker: note_type_constraints_in(keyed, span, NominalType(n)),
    ty: NominalType(n),
    effects: walked.effects,
    node: record_of(walked.values),
  }
}

fn infer_record_update(
  checker: Checker,
  span: Span,
  base: Expression,
  written: List<RecordLiteralField>,
) -> Inference / {abort.raise} = {
  let b: Inference = infer(checker, base);
  let known = match record_fields(shallow_resolve(b.checker.substitution, b.ty)) {
    Some(fs) -> fs,
    None -> [],
  };
  let fs = written.fold(
    { checker: b.checker, fs: [], effects: b.effects, values: [] },
    |acc: { checker: Checker, fs: List<UpdateField>, effects: Effects, values: List<{ name: Bytes, value: Option<WalkedExpression> }> }, field: RecordLiteralField| {
      let o: Inference = infer(
        acc.checker,
        field.value,
        field_hint(known, field.name.name, NoEquations),
      );
      let j: WithEffects = join(o.checker, span, acc.effects, o.effects);
      {
        checker: j.checker,
        fs: acc.fs.push({ name: field.name.name, span: field.name.span, ty: o.ty }),
        effects: j.effects,
        values: acc.values.push({
          name: field.name.name,
          value: typed_at(o, expression_span(field.value)),
        }),
      }
    },
  );
  let base_span = expression_span(base);
  let node = update_of(typed_at(b, base_span), fs.values);
  match resolve(fs.checker, b.ty) {
    VariableType(_) -> {
      let t: WithType = new_type(fs.checker);
      let c: Checker = t.checker;
      {
        checker: {
          ..c,
          updates: c.updates.push({
            module: c.module,
            span: span,
            base_span: base_span,
            base: b.ty,
            written: fs.fs,
            result: t.ty,
            owner: c.current_definition,
          }),
        },
        ty: t.ty,
        effects: fs.effects,
        node: node,
      }
    },
    shape -> {
      let o: WithType = update_shape(fs.checker, span, base_span, shape, fs.fs);
      { checker: o.checker, ty: o.ty, effects: fs.effects, node: node }
    },
  }
}

fn update_fields(
  checker: Checker,
  base_span: Span,
  fs: List<Field>,
  written: List<UpdateField>,
  kept: Bool,
) -> Checker / {abort.raise} = {
  let known = backticked(fs.map(|field: Field| field.name), b", ");
  written.fold(checker, |c: Checker, w: UpdateField|
    match field_get(fs, w.name) {
      Some(t) -> if !kept { c }
      else { expect_or_widen(c, w.span, t, w.ty, b"an updated field of a `new` record") },
      None ->
        report_error_at_and(
          c,
          b"E0117",
          w.span,
          Bytes::concat_all([b"the record being updated has no field `", w.name, b"`"]),
          b"not a field of the base",
          location_of(c, base_span),
          b"this is the record being updated",
          [b"an update replaces fields, it does not add them; available fields: ".concat(known)],
        ),
    })
}

fn update_shape(
  checker: Checker,
  span: Span,
  base_span: Span,
  base: Type,
  written: List<UpdateField>,
) -> WithType / {abort.raise} =
  match base {
    RecordType(fs) -> {
      let checked: Checker = update_fields(checker, base_span, fs, written, false);
      let kept = written.filter(|w: UpdateField|
        match field_get(fs, w.name) { Some(_) -> true, None -> false });
      {
        checker: checked,
        ty: RecordType(
          fields_sorted(fs.concat(kept.map(|w: UpdateField| { name: w.name, ty: w.ty }))),
        ),
      }
    },
    NominalType(n) ->
      {
        checker: match reject_opaque_record(
            checker,
            span,
            n.name,
            b"this update would return a new one",
          ) {
          Some(rejected) -> rejected,
          None -> update_fields(checker, base_span, n.fields, written, true),
        },
        ty: base,
      },
    VariableType(_) ->
      new_type(
        report_error_at(
          checker,
          b"E0116",
          base_span,
          b"the type of the record being updated is not known here",
          b"nothing here says which record this is",
          [b"annotate the binder, the lambda parameter or the function this call returns from"],
        ),
      ),
    other ->
      new_type(
        report_error_at(
          checker,
          b"E0116",
          base_span,
          b"the value being updated is not a record",
          Bytes::concat_all([b"this has type `", type_text(other), b"`"]),
          [b"`{..b, f: e}` replaces fields of a record, and only a record has fields"],
        ),
      ),
  }

pub fn check_updates(checker: Checker) -> Checker / {abort.raise} = {
  let entries = checker.updates;
  entries.fold({ ..checker, updates: [] }, |c: Checker, entry: UpdateSite| {
    let in_module: Checker = { ..c, module: entry.module, current_definition: entry.owner };
    let o: WithType = update_shape(
      in_module,
      entry.span,
      entry.base_span,
      resolve(in_module, entry.base),
      entry.written,
    );
    let unified: Checker = expect(
      o.checker,
      entry.span,
      entry.result,
      o.ty,
      b"record update",
    ).checker;
    { ..unified, module: c.module, current_definition: c.current_definition }
  })
}

fn infer_var(checker: Checker, qname: QName, at: Span) -> Inference / {abort.raise} = {
  let k: WithKey = value_key(checker, qname);
  match k.key {
    None -> unknown_read(k.checker),
    Some(LocalKey(binder)) -> match env_local(k.checker.env, binder) {
      Some(l) -> read_local(k.checker, qname, at, binder, l.scheme),
      None -> unknown_read(unknown_name(k.checker, qname)),
    },
    Some(GlobalKey(g)) -> match env_lookup(k.checker.env, g.name) {
      Some(sc) -> read_global(k.checker, qname, at, g, sc),
      None -> unknown_read(unknown_name(k.checker, qname)),
    },
  }
}

fn unknown_read(checker: Checker) -> Inference = {
  let o: WithType = new_type(checker);
  { checker: o.checker, ty: o.ty, effects: no_effects(), node: None }
}

fn read_local(
  checker: Checker,
  qname: QName,
  at: Span,
  binder: Int,
  sc: Scheme,
) -> Inference / {abort.raise} = {
  let inst = instantiate_with(sc, checker.fresh);
  let c: Checker = record_marshalling(
    { ..checker, fresh: inst.fresh },
    binder,
    qname.name.name,
    at,
  );
  let noted: Checker = record_columns(note_instance(c, at, inst.ty), at, inst.ty);
  {
    checker: noted,
    ty: inst.ty,
    effects: no_effects(),
    node: Some(WalkedRead(WalkedLocal({ name: qname.name.name, binder: binder }))),
  }
}

fn read_global(
  checker: Checker,
  qname: QName,
  at: Span,
  g: { name: Bytes, prelude: Bool },
  sc: Scheme,
) -> Inference / {abort.raise} = {
  let inst = instantiate_with(sc, checker.fresh);
  let c: Checker = { ..checker, fresh: inst.fresh };
  let constrained: Checker = note_constraints(
    note_instance(c, at, inst.ty),
    at,
    g.name,
    inst.args,
    inst.ty,
  );
  let own = constrained.own_functions.contains(g.name);
  let through = match qname.module {
    Some(binder) -> if method_binder_module(binder.name) != None
        || find_module_binding(scope_of(constrained).modules, binder.name) != None { None }
    else { locate_type(constrained.resolved, constrained.module, binder.name) },
    None -> None,
  };
  let named: Checker = match through {
    None -> if is_bare(qname) { constrained } else if !g.prelude {
      match look_up_language_type(constrained, qname) {
        Found(m) -> if m.qname.module == None { constrained } else {
          {
            ..constrained,
            member_sites: constrained.member_sites.push({
              imported_modules: [],
              named: [],
              module: constrained.module,
              site: at.site,
              qualifier: match m.qname.module { Some(q) -> q.name, None -> b"" },
              name: m.qname.name.name,
              callee: TypePath,
              owner: constrained.current_definition,
            }),
          }
        },
        _ -> constrained,
      }
    } else { constrained },
    Some(t) ->
      {
        ..constrained,
        member_sites: constrained.member_sites.push({
          imported_modules: [],
          named: [],
          module: constrained.module,
          site: at.site,
          qualifier: method_binder(constrained.resolved.scopes.get(t.owner).module),
          name: member_name(t.simple, qname.name.name),
          callee: TypePath,
          owner: constrained.current_definition,
        }),
      },
  };
  let referred: Checker = if !own { named } else { { ..named, refs: named.refs.push(g.name) } };
  let noted: Checker = if inst.args.len() == 0 || !own { referred } else {
    {
      ..referred,
      group_fills: referred.group_fills.push({
        module: referred.module,
        span: at,
        callee: g.name,
        args: inst.args,
      }),
    }
  };
  let ls = if inst.labels.len() > 0 && noted.constructor_index.contains(g.name) { [] }
  else { inst.labels };
  let typed: Checker = record_columns(noted, at, inst.ty);
  let rows = inst.effect_variables.map(open_effects);
  let reading = match constructor_of(typed, g.name) {
    Some(ctor) ->
      WalkedConstructor({ sum: ctor.type_name, name: g.name, case: ctor.index, args: inst.args }),
    None -> if typed.prelude_functions.contains(g.name) {
      WalkedDefinition({
        full: qualify(prelude_module(), g.name),
        key: g.name,
        args: inst.args,
        effect_arguments: rows,
        quantified: sc.effect_variables,
        labels: ls,
      })
    } else if g.prelude || typed.contracts.contains(g.name) {
      WalkedBuiltin({ name: g.name, args: inst.args, effect_arguments: rows })
    } else {
      WalkedDefinition({
        full: g.name,
        key: g.name,
        args: inst.args,
        effect_arguments: rows,
        quantified: sc.effect_variables,
        labels: ls,
      })
    },
  };
  {
    checker: note_labels(typed, at, g.name, ls, inst.ty),
    ty: inst.ty,
    effects: no_effects(),
    node: Some(WalkedRead(reading)),
  }
}

fn record_columns(checker: Checker, at: Span, ty: Type) -> Checker = {
  let made = match ty { FunctionType(f) -> f.ret, other -> other };
  if !mentions_columns(made) { checker } else {
    { ..checker, columns: checker.columns.push({ module: checker.module, span: at, ty: made }) }
  }
}

fn record_marshalling(
  checker: Checker,
  binder: Int,
  name: Bytes,
  span: Span,
) -> Checker / {abort.raise} =
  if checker.simulation_scope == 0 { checker } else {
    match env_local(checker.env, binder) {
      Some(l) -> if l.depth < checker.simulation_scope {
        {
          ..checker,
          captured_locals: checker.captured_locals.push({ binder: binder, name: name, span: span }),
        }
      } else { checker },
      None -> checker,
    }
  }

fn divides_by_zero(
  checker: Checker,
  op: Bytes,
  ty: Type,
  divisor: Expression,
) -> Bool / {abort.raise} =
  (op == b"div" || op == b"rem") && !nonzero_literal(divisor) && !is_float(resolve(checker, ty))

fn nonzero_literal(e: Expression) -> Bool =
  match e {
    LiteralExpression(l) -> match l.literal {
      LiteralInt(v) -> v != 0,
      LiteralFixed(_, v) -> v != 0,
      LiteralWide(_, hi, lo) -> hi != 0 || lo != 0,
      _ -> false,
    },
    UnaryExpression(u) -> u.op == b"neg" && nonzero_literal(u.operand),
    _ -> false,
  }

fn is_bits(op: Bytes) -> Bool =
  op == b"bitand" || op == b"bitor" || op == b"bitxor" || op == b"shl" || op == b"shr"
    || op == b"ushr"

fn concat_name(ty: Type) -> Option<Bytes> =
  match ty {
    NamedType(k) -> if is_string(ty) || is_bytes(ty) { Some(k.name) } else { None },
    _ -> None,
  }

fn mixed_concat(checker: Checker, lspan: Span, lt: Type, rspan: Span, rt: Type) -> Option<Checker> =
  match concat_name(lt) {
    None -> None,
    Some(ln) -> match concat_name(rt) {
      None -> None,
      Some(rn) -> if ln == rn { None } else {
        Some(
          report_error_with_labels(
            checker,
            b"E0201",
            Bytes::concat_all([b"`++` cannot join `", ln, b"` and `", rn, b"`"]),
            [
              label_at(checker.module, lspan, true, Bytes::concat_all([b"this is a `", ln, b"`"])),
              label_at(checker.module, rspan, false, Bytes::concat_all([b"this is a `", rn, b"`"])),
            ],
            [b"there is no coercion between them: `Bytes::of_string` and `String::of_bytes` cross"],
          ),
        )
      },
    },
  }

fn infer_binary(
  checker: Checker,
  span: Span,
  op: Bytes,
  lhs: Expression,
  rhs: Expression,
) -> Inference / {abort.raise} = {
  let l: Inference = infer(checker, lhs);
  let r: Inference = if op == b"and" || op == b"or" {
    let o: Inference = infer(assume_condition(l.checker, lhs, op == b"and"), rhs, hint_of(l.ty));
    { ..o, checker: restore_guards(o.checker, l.checker.guards) }
  } else { infer(l.checker, rhs, hint_of(l.ty)) };
  let j: WithEffects = join(r.checker, span, l.effects, r.effects);
  let node = binary_of(op, typed_at(l, expression_span(lhs)), typed_at(r, expression_span(rhs)));
  let c: Checker = j.checker;
  if is_arithmetic(op) || is_order_comparison(op) {
    let x: ExpectResult = expect(
      c,
      expression_span(rhs),
      l.ty,
      r.ty,
      b"both sides of a comparison must have one type",
    );
    let noted: Checker = if x.ok {
      { ..x.checker, numerics: x.checker.numerics.push({ span: span, op: op, ty: l.ty }) }
    } else { x.checker };
    let divisor: { checker: Checker, zero: Bool } = if !divides_by_zero(noted, op, l.ty, rhs) {
      { checker: noted, zero: false }
    } else {
      let o = guards::nonzero(reader_of(noted), noted.guards, rhs);
      { checker: { ..noted, guards: o.g }, zero: !o.ok }
    };
    if divisor.zero {
      {
        checker: record_perform(
          note_raise(divisor.checker, span, ZeroDivisor),
          abort_effect(),
          span,
          DirectPerform,
        ),
        ty: l.ty,
        effects: { ..j.effects, listed: effects_insert(j.effects.listed, abort_effect()) },
        node: node,
      }
    } else {
      {
        checker: divisor.checker,
        ty: if is_arithmetic(op) { l.ty } else { bool_type() },
        effects: j.effects,
        node: node,
      }
    }
  } else if is_bits(op) {
    let shifting = op == b"shl" || op == b"shr" || op == b"ushr";
    let c1: Checker = note_bits(
      c,
      expression_span(lhs),
      l.ty,
      Bytes::concat_all([b"the left operand of `", bits_text(op), b"`"]),
    );
    let c2: Checker = if shifting {
      expect(
        c1,
        expression_span(rhs),
        int_type(),
        r.ty,
        Bytes::concat_all([b"the count of a `", bits_text(op), b"` is an `Int`"]),
      ).checker
    } else {
      let c1b: Checker = note_bits(
        c1,
        expression_span(rhs),
        r.ty,
        Bytes::concat_all([b"the right operand of `", bits_text(op), b"`"]),
      );
      expect(
        c1b,
        expression_span(rhs),
        l.ty,
        r.ty,
        Bytes::concat_all([b"both operands of `", bits_text(op), b"` have one type"]),
      ).checker
    };
    { checker: c2, ty: l.ty, effects: j.effects, node: node }
  } else if op == b"and" || op == b"or" {
    let c1: Checker = expect(c, expression_span(lhs), bool_type(), l.ty, b"left operand").checker;
    let c2: Checker = expect(c1, expression_span(rhs), bool_type(), r.ty, b"right operand").checker;
    { checker: c2, ty: bool_type(), effects: j.effects, node: node }
  } else if op == b"concat" {
    match mixed_concat(
        c,
        expression_span(lhs),
        resolve(c, l.ty),
        expression_span(rhs),
        resolve(c, r.ty),
      ) {
      Some(reported) -> { checker: reported, ty: l.ty, effects: j.effects, node: node },
      None -> {
        let x: ExpectResult = expect(
          c,
          expression_span(rhs),
          l.ty,
          r.ty,
          b"both operands of `++` have one type",
        );
        let noted: Checker = if x.ok {
          {
            ..x.checker,
            concats: x.checker.concats.push({ module: x.checker.module, span: span, ty: l.ty }),
          }
        } else { x.checker };
        { checker: noted, ty: l.ty, effects: j.effects, node: node }
      },
    }
  } else {
    let c1: Checker = expect(
      c,
      expression_span(rhs),
      l.ty,
      r.ty,
      b"both sides of a comparison must have one type",
    ).checker;
    {
      checker: {
        ..c1,
        comparisons: c1.comparisons.push({ module: c1.module, span: span, ty: l.ty }),
      },
      ty: bool_type(),
      effects: j.effects,
      node: node,
    }
  }
}

type LetElse = { span: Span, ty: Type }

type StatementResult = {
  checker: Checker,
  effects: Effects,
  fallback: Option<LetElse>,
  node: Option<WalkedStatement>,
}

fn infer_statement(
  checker: Checker,
  stmt: Statement,
  hint: Option<Hint>,
) -> StatementResult / {abort.raise} =
  match stmt {
    ExpressionStatement(e) -> {
      let o: Inference = infer(checker, e);
      {
        checker: o.checker,
        effects: o.effects,
        fallback: None,
        node: do_of(typed_at(o, expression_span(e))),
      }
    },
    LetStatement(l) -> {
      let b: LetBinding = let_bound(checker, l.pattern, l.ty, l.value);
      let bound: Checker = bind_guarded_value(
        b.checker,
        bind_all(or_let_covers(b.checker, l.pattern), b.out),
        l.pattern,
        l.value,
      );
      if refutable(b.checker, l.pattern) {
        let matched: Checker = {
          ..bound,
          guards: guards::matched(reader_of(b.checker), bound.guards, l.value, l.pattern),
        };
        {
          checker: record_perform(
            note_raise(matched, pattern_span(l.pattern), RefutableLet),
            abort_effect(),
            pattern_span(l.pattern),
            DirectPerform,
          ),
          effects: { ..b.effects, listed: effects_insert(b.effects.listed, abort_effect()) },
          fallback: None,
          node: let_of(b.pattern, b.value, l.span),
        }
      } else {
        {
          checker: bound,
          effects: b.effects,
          fallback: None,
          node: let_of(b.pattern, b.value, l.span),
        }
      }
    },
    AssignmentStatement(a) -> {
      let target = match local_at(checker, bare(a.name)) {
        Some(binder) -> checker.assignable.vars.find(|v: HandlerVariable| v.binder == binder),
        None -> None,
      };
      match target {
        None -> {
          let o: Inference = infer(checker, a.value);
          {
            checker: report_error_at(
              o.checker,
              b"E0314",
              a.name.span,
              Bytes::concat_all([
                b"`",
                a.name.name,
                b"` is not a variable of the handler whose clause this is",
              ]),
              b"assigned here",
              [
                b"a handler declares its variables with `var` in its `with` block, and only its clauses assign them; bind a new name with `let` instead",
              ],
            ),
            effects: o.effects,
            fallback: None,
            node: None,
          }
        },
        Some(v) -> match checker.assignable.assignment_forbidden_in {
          Some(place) -> {
            let o: Inference = infer(checker, a.value, hint_of(v.ty));
            {
              checker: report_error_at(
                o.checker,
                b"E0315",
                a.span,
                Bytes::concat_all([b"`", a.name.name, b"` is assigned in ", place]),
                b"assigned here",
                [
                  b"what runs there may run after the clause has returned: assign the variable in the clause's own blocks, from the value this returns",
                ],
              ),
              effects: o.effects,
              fallback: None,
              node: None,
            }
          },
          None -> {
            let o: Inference = infer(checker, a.value, hint_of(v.ty));
            {
              checker: expect(
                o.checker,
                expression_span(a.value),
                v.ty,
                o.ty,
                b"a handler's variable keeps the type it was declared with",
              ).checker,
              effects: o.effects,
              fallback: None,
              node: assign_of(a.name.name, typed_at(o, expression_span(a.value)), a.span),
            }
          },
        },
      }
    },
    LetElseStatement(l) -> {
      let b: LetBinding = let_bound(checker, l.pattern, l.ty, l.value);
      let f: Inference = infer(b.checker, l.fallback, hint);
      let j: WithEffects = join(f.checker, expression_span(l.fallback), b.effects, f.effects);
      let bound: Checker = bind_all(j.checker, b.out);
      {
        checker: {
          ..bound,
          guards: guards::matched(reader_of(b.checker), bound.guards, l.value, l.pattern),
        },
        effects: j.effects,
        fallback: Some({ span: expression_span(l.fallback), ty: f.ty }),
        node: let_else_of(b.pattern, b.value, typed_at(f, expression_span(l.fallback)), l.span),
      }
    },
  }

type LetBinding = {
  checker: Checker,
  effects: Effects,
  out: List<Binder>,
  pattern: Option<TypedPattern<Type>>,
  value: Option<WalkedExpression>,
}

fn refutable(checker: Checker, pattern: Pattern) -> Bool / {abort.raise} =
  uncovered(checker, [[coverage_pattern(checker, pattern)]], 1).len() > 0

fn or_let_covers(checker: Checker, pattern: Pattern) -> Checker / {abort.raise} =
  if !has_or(pattern) { checker } else {
    let missing = uncovered(checker, [[coverage_pattern(checker, pattern)]], 1);
    if missing.len() == 0 { checker } else {
      report_error_at(
        checker,
        b"E0213",
        pattern_span(pattern),
        b"a `let` whose or-pattern can fail needs an `else`",
        b"not covered: ".concat(
          Bytes::join(
            missing.map(|patterns: List<CoveragePattern>|
              backticked_text(pattern_text(patterns.get(0)))),
            b", ",
          ),
        ),
        [
          b"write `let <pattern> = <value> else { .. };` to say what happens when no alternative matches",
        ],
      )
    }
  }

fn let_bound(
  checker: Checker,
  pattern: Pattern,
  annotation: Option<TypeExpression>,
  value: Expression,
) -> LetBinding / {abort.raise} = {
  let annotated: { checker: Checker, ty: Type, effects: Effects, value: Option<WalkedExpression> } = match annotation {
    Some(te) -> {
      let w: WithType = convert_type(checker, te);
      let v: Inference = infer(
        check_scoped_placement(w.checker, te, w.ty, false),
        value,
        hint_of(w.ty),
      );
      {
        checker: expect_or_widen(
          v.checker,
          expression_span(value),
          w.ty,
          v.ty,
          b"`let` annotation",
        ),
        ty: w.ty,
        effects: v.effects,
        value: typed_at(v, expression_span(value)),
      }
    },
    None -> {
      let v: Inference = infer(checker, value);
      {
        checker: v.checker,
        ty: v.ty,
        effects: v.effects,
        value: typed_at(v, expression_span(value)),
      }
    },
  };
  let b: PatternBindings = bind_pattern(annotated.checker, pattern, annotated.ty, []);
  {
    checker: b.checker,
    effects: annotated.effects,
    out: b.out,
    pattern: b.pattern,
    value: annotated.value,
  }
}

fn infer_app(
  checker: Checker,
  span: Span,
  function: Expression,
  args: List<Expression>,
  labels: List<Identifier>,
  hint: Option<Hint>,
) -> Inference / {abort.raise} =
  match function {
    NameExpression(_) ->
      infer_app_general(
        reject_shadowed_operator(checker, function, args),
        span,
        function,
        args,
        labels,
        hint,
      ),
    _ -> infer_app_general(checker, span, function, args, labels, hint),
  }

fn written_function(name: Identifier) -> Option<QName> / {abort.raise} =
  match member_of(name.name) {
    None -> None,
    Some(m) ->
      Some({
        module: Some({ name: m.of, span: name.span }),
        name: { name: m.member, span: name.span },
        span: name.span,
      }),
  }

fn through_module(checker: Checker, q: QName) -> QName / {abort.raise} =
  match q.module {
    None -> q,
    Some(binder) -> if method_binder_module(binder.name) != None
        || find_module_binding(scope_of(checker).modules, binder.name) != None { q } else {
      match locate_type(checker.resolved, checker.module, binder.name) {
        None -> q,
        Some(t) ->
          {
            module: Some({
              name: method_binder(checker.resolved.scopes.get(t.owner).module),
              span: binder.span,
            }),
            name: { name: member_name(t.simple, q.name.name), span: q.name.span },
            span: q.span,
          },
      }
    },
  }

fn member_function(
  checker: Checker,
  of: Bytes,
  name: Identifier,
) -> Option<{ qname: QName, callee: Bytes }> / {abort.raise} =
  match ((
      find_method(checker.resolved, checker.module, of, name.name),
      locate_type(checker.resolved, checker.module, of),
    )) {
    (Some(b), Some(t)) ->
      Some({
        qname: {
          module: Some({
            name: method_binder(checker.resolved.scopes.get(t.owner).module),
            span: name.span,
          }),
          name: { name: member_name(t.simple, name.name), span: name.span },
          span: name.span,
        },
        callee: b.qualified,
      }),
    _ -> if module_declares(checker, of) { None }
    else { language_function(checker, of, name, true) },
  }

fn member_args(
  checker: Checker,
  span: Span,
  callee: Bytes,
  base: Expression,
  args: List<Expression>,
  named: List<NamedArg>,
) -> { checker: Checker, rest: List<Slot>, reaches: List<Bytes> } / {abort.raise} =
  match checker.resolved.signatures.get(callee) {
    None -> { checker: reject_named_arguments(checker, named), rest: [], reaches: [] },
    Some(signature) -> if 1 + args.len() > signature.params.len() {
      { checker: checker, rest: [], reaches: [] }
    } else {
      let filled = place_arguments(checker.module, span, signature, [base].concat(args), named);
      {
        checker: filled.diagnostics.fold(checker, report),
        rest: filled.slots.drop(1 + args.len()),
        reaches: filled.imports.map(|b: ModuleBinding|
          checker.resolved.scopes.get(b.target).module),
      }
    },
  }

fn reject_named_arguments(checker: Checker, named: List<NamedArg>) -> Checker =
  named.fold(checker, |c: Checker, arg: NamedArg|
    report_error_at(
      c,
      b"E0123",
      arg.name.span,
      Bytes::concat_all([b"`", arg.name.name, b"` names no parameter here"]),
      b"no signature to match this against",
      [
        b"a named argument needs a callee reached by name or by the type of the value it is called on; a call through a value, a lambda or a constructor is positional",
      ],
    ))

type MemberTarget =
  | FieldFunction(Type)
  | TypeFunction({ qname: QName, callee: Bytes, ty: Type, effects: Effects, labelled: Bool, node: Option<WalkedNode> })
  | NoCallee(Diagnostic)

type MemberCall = {
  checker: Checker,
  callee: MemberTarget,
  at: Span,
  params: List<Type>,
  parameter_offset: Int,
  equations: Equations,
  waits: Option<Bytes>,
  rest: List<Slot>,
  imported_modules: List<Bytes>,
}

type TrailingArguments = { checker: Checker, rest: List<TrailingArgument>, effects: Effects }

fn default_arguments(d: MemberCall) -> TrailingArguments =
  {
    checker: d.checker,
    rest: d.rest.fold([], |acc: List<TrailingArgument>, slot: Slot|
      match slot { FromDefault(copied) -> acc.push(CopiedDefault(copied)), _ -> acc }),
    effects: no_effects(),
  }

fn member_target(
  span: Span,
  callee: Span,
  b: Inference,
  base: Expression,
  name: Identifier,
  args: List<Expression>,
  named: List<NamedArg>,
  labels: List<Identifier>,
) -> MemberCall / {abort.raise} = {
  let ty = resolve(b.checker, b.ty);
  let none = |c: Checker, d: MemberTarget|
    {
      checker: c,
      callee: d,
      at: callee,
      params: [],
      parameter_offset: 0,
      equations: NoEquations,
      waits: None,
      rest: [],
      imported_modules: [],
    };
  let of_type = |m: { qname: QName, callee: Bytes }| {
    let filled = member_args(b.checker, span, m.callee, base, args, named);
    let function = NameExpression({ span: callee, name: m.qname });
    let f0: Inference = infer_var(filled.checker, m.qname, callee);
    let params = match shallow_resolve(f0.checker.substitution, f0.ty) {
      FunctionType(fn_) -> fn_.params,
      _ -> [],
    };
    let names = filled.rest.fold(false, |any: Bool, slot: Slot|
      any || (match slot { FromName(_) -> true, _ -> false }));
    let ready: Checker = if !names { f0.checker } else {
      fill_labels(mark_called(f0.checker, callee), span, labels, callee_labels(f0.checker, callee))
    };
    {
      checker: ready,
      callee: TypeFunction({
        qname: m.qname,
        callee: m.callee,
        ty: f0.ty,
        effects: f0.effects,
        labelled: names,
        node: f0.node,
      }),
      at: callee,
      params: params,
      parameter_offset: 1,
      equations: match params.at(0) {
        Some(p) -> Equation({ expected: p, found: b.ty, before: NoEquations }),
        None -> NoEquations,
      },
      waits: if names { callee_repeats(ready, function, [base].concat(args)).waits } else { None },
      rest: filled.rest,
      imported_modules: filled.reaches,
    }
  };
  let field = match record_fields(ty) { Some(fs) -> field_get(fs, name.name), None -> None };
  match ((written_function(name), field)) {
    (Some(q), _) -> match find(b.checker.resolved, b.checker.module, ValueSpace, q) {
      Some(found) -> of_type({ qname: through_module(b.checker, q), callee: found.qualified }),
      None -> match look_up_language_type(b.checker, q) {
        Found(m) -> of_type(m),
        NoLanguageFunction(of) ->
          none(b.checker, NoCallee(no_function_diagnostic(b.checker, of.name, q.name))),
        NotLanguageType -> none(b.checker, NoCallee(unknown_name_diagnostic(b.checker, q))),
      },
    },
    (None, Some(held)) ->
      {
        ..none(reject_named_arguments(b.checker, named), FieldFunction(held)),
        params: match shallow_resolve(b.checker.substitution, held) {
          FunctionType(fn_) -> fn_.params,
          _ -> [],
        },
        rest: range(0, named.len()).map(|j: Int| FromName(j)),
      },
    (None, None) -> {
      let head = match ty {
        NamedType(c) -> Some(c.name),
        NominalType(n) -> Some(n.name),
        _ -> None,
      };
      match head {
        None ->
          none(
            b.checker,
            NoCallee(
              error_at(
                b"E0201",
                b.checker.module,
                expression_span(base),
                Bytes::concat_all([b"cannot call `", name.name, b"` on this value"]),
                Bytes::concat_all([b"this has type `", type_text(ty), b"`"]),
                [
                  b"`value.name(..)` calls the function `name` of the value's type, or a function a record holds in a field `name`: a type parameter, a function and a record with no such field have neither",
                  b"annotate the value where its type is not yet known",
                ],
              ),
            ),
          ),
        Some(of) -> match member_function(b.checker, of, name) {
          None -> none(b.checker, NoCallee(no_function_diagnostic(b.checker, of, name))),
          Some(m) -> of_type(m),
        },
      }
    },
  }
}

fn infer_member_call(
  span: Span,
  d: MemberCall,
  taken: TrailingArguments,
  b: Inference,
  base: Expression,
  name: Identifier,
  args: List<Expression>,
  labels: List<Identifier>,
  hint: Option<Hint>,
  performed: Bool,
) -> Inference / {abort.raise} = {
  let returned = |o: Inference, noted: Checker| {
    let j: WithEffects = join(noted, span, b.effects, o.effects);
    let k: WithEffects = join(j.checker, span, j.effects, taken.effects);
    { checker: k.checker, ty: o.ty, effects: k.effects, node: o.node }
  };
  match d.callee {
    NoCallee(said) -> {
      let o: WithType = new_type(report(taken.checker, said));
      { checker: o.checker, ty: o.ty, effects: b.effects, node: None }
    },
    FieldFunction(held) -> {
      let o: Inference = applied_call(
        span,
        FieldExpression({
          span: span_to(expression_span(base), name.span),
          base: base,
          field: name,
        }),
        {
          checker: taken.checker,
          ty: held,
          effects: no_effects(),
          node: field_read_of(typed_at(b, expression_span(base)), name.name),
        },
        None,
        args,
        labels,
        hint,
        rest: taken.rest,
      );
      returned(o, if !performed { o.checker } else {
        {
          ..o.checker,
          member_sites: o.checker.member_sites.push({
            module: o.checker.module,
            site: span.site,
            qualifier: b"",
            name: b"",
            callee: CallsField,
            owner: o.checker.current_definition,
            imported_modules: [],
            named: [],
          }),
        }
      })
    },
    TypeFunction(m) -> {
      let o: Inference = applied_call(
        span,
        NameExpression({ span: d.at, name: m.qname }),
        { checker: taken.checker, ty: m.ty, effects: m.effects, node: m.node },
        Some({ written: base, ty: b.ty, node: typed_at(b, expression_span(base)) }),
        args,
        if m.labelled { [] } else { labels },
        hint,
        rest: taken.rest,
      );
      returned(o, {
        ..o.checker,
        member_sites: o.checker.member_sites.push({
          module: o.checker.module,
          site: span.site,
          qualifier: match m.qname.module { Some(q) -> q.name, None -> prelude_binder() },
          name: m.qname.name.name,
          callee: CallsFunction(m.callee),
          owner: o.checker.current_definition,
          imported_modules: d.imported_modules,
          named: range(0, d.rest.len()).fold(
            [],
            |acc: List<{ arg: Int, at: Int }>, k: Int|
              match d.rest.get(k) {
                FromName(j) -> acc.push({ arg: j, at: 1 + args.len() + k }),
                _ -> acc,
              },
          ).sort_by(|a: { arg: Int, at: Int }, b: { arg: Int, at: Int }| a.arg <= b.arg).map(
            |x: { arg: Int, at: Int }| x.at,
          ),
        }),
        member_calls: o.checker.member_calls.push({ callee: m.callee, span: span }),
        member_builtins: if m.qname.module != None { o.checker.member_builtins }
        else { o.checker.member_builtins.insert(builtin_key(o.checker, span), m.qname.name.name) },
      })
    },
  }
}

fn prelude_name_of(checker: Checker, function: Expression) -> Bytes / {abort.raise} =
  match function {
    NameExpression(v) -> if !is_bare(v.name) {
      match look_up_language_type(checker, v.name) {
        Found(m) -> if m.qname.module == None { m.callee } else { b"" },
        _ -> b"",
      }
    } else {
      match value_key(checker, v.name).key {
        Some(GlobalKey(g)) -> if g.prelude { g.name } else { b"" },
        _ -> b"",
      }
    },
    _ -> b"",
  }

fn joined_callbacks(
  checker: Checker,
  span: Span,
  types: List<Type>,
) -> { checker: Checker, types: List<Type> } / {abort.raise} = {
  let j: WithEffects = types.fold(
    { checker: checker, effects: no_effects() },
    |acc: WithEffects, ty: Type|
      match resolve(acc.checker, ty) {
        FunctionType(f) -> join(acc.checker, span, acc.effects, f.effects),
        _ -> acc,
      },
  );
  {
    checker: j.checker,
    types: types.map(|ty: Type|
      match resolve(j.checker, ty) {
        FunctionType(f) -> FunctionType({ ..f, effects: j.effects }),
        _ -> ty,
      }),
  }
}

pub fn is_group_member(checker: Checker, name: Bytes) -> Bool =
  checker.group_definitions.fold(false, |acc: Bool, g: GroupDefinition| acc || g.name == name)

fn note_labels(
  checker: Checker,
  span: Span,
  callee: Bytes,
  labels: List<Type>,
  ty: Type,
) -> Checker / {abort.raise} =
  if labels.len() == 0 { checker } else {
    let vars = labels.map(|l: Type| match l { VariableType(v) -> v, _ -> 0 - 1 });
    let scopes = scope_labels(ty, []);
    {
      ..checker,
      label_apps: checker.label_apps.push({
        module: checker.module,
        span: span,
        named: span.end,
        callee: callee,
        vars: vars,
        explicit_vars: vars.filter(|v: Int| !scopes.contains(v)),
        params: checker.label_params,
        called: false,
        owner: checker.current_definition,
      }),
    }
  }

fn scope_labels(ty: Type, acc: List<Int>) -> List<Int> / {abort.raise} =
  match ty {
    VariableType(_) -> acc,
    NamedType(c) -> {
      let own = match scoped_parts(ty) {
        Some(p) -> match p.label { VariableType(v) -> ints_insert(acc, v), _ -> acc },
        None -> acc,
      };
      c.args.fold(own, |a: List<Int>, x: Type| scope_labels(x, a))
    },
    FunctionType(f) ->
      f.effects.listed.fold(
        f.params.fold(scope_labels(f.ret, acc), |a: List<Int>, p: Type| scope_labels(p, a)),
        |a: List<Int>, entry: Effect|
          match entry.resource {
            ResourceVariable(v) -> if is_scoped_effect(entry.effect) { ints_insert(a, v) }
            else { a },
            _ -> a,
          },
      ),
    RecordType(fs) -> fs.fold(acc, |a: List<Int>, f: Field| scope_labels(f.ty, a)),
    NominalType(n) -> n.args.fold(acc, |a: List<Int>, x: Type| scope_labels(x, a)),
  }

fn callee_labels(checker: Checker, span: Span) -> Option<LabelApplication> =
  match checker.label_apps.at(checker.label_apps.len() - 1) {
    Some(a) -> if a.module == checker.module && a.span == span { Some(a) } else { None },
    None -> None,
  }

fn fill_labels(
  checker: Checker,
  span: Span,
  labels: List<Identifier>,
  app: Option<LabelApplication>,
) -> Checker / {abort.raise} =
  match app {
    None -> if labels.len() == 0 { checker } else { wrong_labels(checker, labels, None, 0, 0) },
    Some(a) -> if labels.len() > 0 && labels.len() != a.explicit_vars.len() {
      wrong_labels(
        { ..checker, label_apps: checker.label_apps.take(checker.label_apps.len() - 1) },
        labels,
        Some(a.callee),
        a.explicit_vars.len(),
        a.vars.len() - a.explicit_vars.len(),
      )
    } else {
      let marked: Checker = {
        ..checker,
        label_apps: checker.label_apps.set(checker.label_apps.len() - 1, {
          ..a,
          span: span,
          called: true,
        }),
      };
      range(0, labels.len()).fold(marked, |c: Checker, i: Int| {
        let want = match c.label_params.get(labels.get(i).name) {
          Some(w) -> VariableType(w),
          None -> label_type(labels.get(i).name),
        };
        with_unified(c, unify(c.substitution, c.fresh, VariableType(a.explicit_vars.get(i)), want))
      })
    },
  }

fn wrong_labels(
  checker: Checker,
  labels: List<Identifier>,
  callee: Option<Bytes>,
  want: Int,
  scopes: Int,
) -> Checker / {abort.raise} = {
  let span = span_to(labels.get(0).span, labels.get(labels.len() - 1).span);
  let who = match callee {
    Some(n) -> Bytes::concat_all([b"`", simple_name_of(n), b"`"]),
    None -> b"this callee",
  };
  let message = if want == 0 {
    Bytes::concat_all([
      who,
      if scopes == 0 { b" takes no label parameters" } else { b" takes no label a call writes" },
    ])
  } else {
    Bytes::concat_all([
      who,
      b" takes ",
      ascii_of_int(want),
      b" label parameter",
      plural(want),
      b", but ",
      ascii_of_int(labels.len()),
      b" ",
      if labels.len() == 1 { b"is" } else { b"are" },
      b" written",
    ])
  };
  let help = [
    b"the labels at a call fill the `[l]` binders of the definition's generic list, left to right",
  ].concat(if scopes == 0 { [] } else {
    [
      b"a binder that names a scoped value's scope is filled by the argument that carries the scope, and is not written",
    ]
  });
  match callee {
    Some(n) -> match definition_of(checker, n) {
      Some(d) ->
        report_error_at_and(
          checker,
          b"E0306",
          span,
          message,
          b"label instantiation",
          d.at,
          b"declared here",
          help,
        ),
      None -> report_error_at(checker, b"E0306", span, message, b"label instantiation", help),
    },
    None -> report_error_at(checker, b"E0306", span, message, b"label instantiation", help),
  }
}

fn int_builtin_name(function: Expression) -> Bytes =
  match function {
    NameExpression(v) -> if is_bare(v.name) { v.name.name.name } else { b"" },
    _ -> b"",
  }

fn is_int_builtin(function: Expression) -> Bool = {
  let n = int_builtin_name(function);
  n == b"wrap_add" || n == b"wrap_sub" || n == b"wrap_mul" || n == b"rotr" || n == b"rotl"
    || n == b"checked_add"
    || n == b"checked_sub"
    || n == b"checked_mul"
    || n == b"checked_neg"
    || call_operator(n) != None
}

fn int_builtin_text(function: Expression, args: List<Expression>) -> Bytes =
  Bytes::concat_all([
    b"`",
    match written_operator(function, args) {
      Some(o) -> o.text,
      None -> int_builtin_name(function),
    },
    b"`",
  ])

fn reject_shadowed_operator(
  checker: Checker,
  function: Expression,
  args: List<Expression>,
) -> Checker =
  match ((function, written_operator(function, args))) {
    (NameExpression(v), Some(o)) -> if local_at(checker, v.name) == None { checker } else {
      report_error_at(
        checker,
        b"E0105",
        v.span,
        Bytes::concat_all([
          b"`",
          o.text,
          b"` is the builtin `",
          o.name,
          b"`, which a binding here hides",
        ]),
        Bytes::concat_all([b"this would call the local `", o.name, b"`"]),
        [
          Bytes::concat_all([
            b"`a ",
            o.text,
            b" b` is written in the name `",
            o.name,
            b"`; give the binding another name",
          ]),
        ],
      )
    },
    _ -> checker,
  }

type WidenedVariables = { checker: Checker, variables: List<Int> }

type Widened = { checker: Checker, ty: Type, variables: List<Int> }

type WidenedItems<a> = { checker: Checker, items: List<a>, variables: List<Int> }

fn unwidened(checker: Checker, ty: Type) -> Widened = { checker: checker, ty: ty, variables: [] }

fn widen_fn(
  r: Widened,
  ty: Type,
  g: { params: List<Type>, kept: List<Int>, once: Bool, ret: Type, effects: Effects },
) -> Widened / {abort.raise} = {
  let effects = resolve_effects_in(r.checker, g.effects);
  match effects.variable {
    Some(_) -> if r.variables.len() == 0 { unwidened(r.checker, ty) }
    else { { checker: r.checker, ty: FunctionType({ ..g, ret: r.ty }), variables: r.variables } },
    None -> {
      let v: WithVar = new_effect_variable(r.checker);
      {
        checker: v.checker,
        ty: FunctionType({
          ..g,
          ret: r.ty,
          effects: { listed: effects.listed, variable: Some(v.var) },
        }),
        variables: r.variables.push(v.var),
      }
    },
  }
}

fn widened_effects(checker: Checker, ty: Type) -> Widened / {abort.raise} =
  widened_to_depth(checker, ty, checker.substitution.ty.len())

fn widened_to_depth(checker: Checker, ty: Type, room: Int) -> Widened / {abort.raise} =
  match ty {
    VariableType(v) -> match checker.substitution.ty.get(v) {
      None -> unwidened(checker, ty),
      Some(bound) -> if room <= 0 { panic("a type bound to itself") } else {
        let w: Widened = widened_to_depth(checker, bound, room - 1);
        if w.variables.len() == 0 { unwidened(w.checker, ty) } else { w }
      },
    },
    FunctionType(g) -> widen_fn(widened_to_depth(checker, g.ret, room), ty, g),
    RecordType(fs) -> {
      let o: WidenedItems<Field> = range(0, fs.len()).fold(
        { checker: checker, items: fs, variables: [] },
        |acc: WidenedItems<Field>, i: Int| {
          let x = fs.get(i);
          let w: Widened = widened_to_depth(acc.checker, x.ty, room);
          if w.variables.len() == 0 { acc } else {
            {
              checker: w.checker,
              items: acc.items.set(i, { name: x.name, ty: w.ty }),
              variables: acc.variables.concat(w.variables),
            }
          }
        },
      );
      if o.variables.len() == 0 { unwidened(checker, ty) }
      else { { checker: o.checker, ty: RecordType(o.items), variables: o.variables } }
    },
    NominalType(_) -> unwidened(checker, ty),
    NamedType(c) -> if !is_covariant_container(c.name) { unwidened(checker, ty) } else {
      let o: WidenedItems<Type> = range(0, c.args.len()).fold(
        { checker: checker, items: c.args, variables: [] },
        |acc: WidenedItems<Type>, i: Int| {
          let w: Widened = widened_to_depth(acc.checker, c.args.get(i), room);
          if w.variables.len() == 0 { acc } else {
            {
              checker: w.checker,
              items: acc.items.set(i, w.ty),
              variables: acc.variables.concat(w.variables),
            }
          }
        },
      );
      if o.variables.len() == 0 { unwidened(checker, ty) } else {
        {
          checker: o.checker,
          ty: NamedType({ name: c.name, args: o.items }),
          variables: o.variables,
        }
      }
    },
  }

pub fn expect_or_widen(
  checker: Checker,
  span: Span,
  expected: Type,
  found: Type,
  context: Bytes,
) -> Checker / {abort.raise} = {
  let u = unify(checker.substitution, checker.fresh, expected, found);
  match u.error {
    None -> with_unified(checker, u),
    Some(_) -> {
      let o: Widened = widened_effects(checker, found);
      let w = unify(o.checker.substitution, o.checker.fresh, expected, o.ty);
      match w.error {
        None -> close_effect_variables(with_unified(o.checker, w), o.variables),
        Some(_) -> expect(checker, span, expected, found, context).checker,
      }
    },
  }
}

type Joined = { checker: Checker, ty: Type, variables: List<Int> }

fn join_type_into(acc: Joined, span: Span, found: Type, context: Bytes) -> Joined / {abort.raise} = {
  let u = unify(acc.checker.substitution, acc.checker.fresh, acc.ty, found);
  match u.error {
    None -> { checker: with_unified(acc.checker, u), ty: acc.ty, variables: acc.variables },
    Some(_) -> {
      let a: Widened = widened_effects(acc.checker, acc.ty);
      let b: Widened = widened_effects(a.checker, found);
      let w = unify(b.checker.substitution, b.checker.fresh, a.ty, b.ty);
      match w.error {
        None ->
          {
            checker: with_unified(b.checker, w),
            ty: a.ty,
            variables: acc.variables.concat(a.variables.concat(b.variables)),
          },
        Some(_) ->
          {
            checker: expect(
              close_effect_variables(acc.checker, acc.variables),
              span,
              acc.ty,
              found,
              context,
            ).checker,
            ty: acc.ty,
            variables: [],
          },
      }
    },
  }
}

fn agree(
  checker: Checker,
  span: Span,
  first: Type,
  second: Type,
  context: Bytes,
) -> { checker: Checker, ty: Type } / {abort.raise} = {
  let j: Joined = join_type_into(
    { checker: checker, ty: first, variables: [] },
    span,
    second,
    context,
  );
  { checker: close_effect_variables(j.checker, j.variables), ty: j.ty }
}

fn expect_arguments<| e>(
  checker: Checker,
  params: List<Type>,
  found: List<Type>,
  expect_one: (Checker, Int) -> Checker / e,
) -> Checker / {abort.raise | e} = {
  let written: Checker = range(0, params.len()).fold(checker, |c: Checker, i: Int|
    expect_one(c, i));
  if written.diagnostics.len() == checker.diagnostics.len() { written }
  else { match arguments_widened(checker, params, found) { Some(c) -> c, None -> written } }
}

fn arguments_widened(
  checker: Checker,
  params: List<Type>,
  found: List<Type>,
) -> Option<Checker> / {abort.raise} = {
  let m: Option<WidenedVariables> = range(0, params.len()).fold(
    Some({ checker: checker, variables: [] }),
    |acc: Option<WidenedVariables>, i: Int|
      match acc {
        None -> None,
        Some(a) -> {
          let o: Widened = widened_effects(a.checker, found.get(i));
          let u = unify(o.checker.substitution, o.checker.fresh, params.get(i), o.ty);
          match u.error {
            None ->
              Some({
                checker: with_unified(o.checker, u),
                variables: a.variables.concat(o.variables),
              }),
            Some(_) -> None,
          }
        },
      },
  );
  match m { None -> None, Some(a) -> Some(close_effect_variables(a.checker, a.variables)) }
}

fn close_effect_variables(checker: Checker, variables: List<Int>) -> Checker / {abort.raise} =
  variables.fold(checker, close_effect_variable)

fn close_effect_variable(checker: Checker, tail: Int) -> Checker / {abort.raise} =
  match resolved_variable(checker.substitution, open_effects(tail)) {
    Some(v) -> if is_rigid_effects(checker.substitution, v) { checker } else {
      with_unified(
        checker,
        unify_effects(checker.substitution, checker.fresh, no_effects(), open_effects(v)),
      )
    },
    None -> checker,
  }

fn expect_argument(
  checker: Checker,
  span: Span,
  expected: Type,
  found: Type,
) -> Checker / {abort.raise} = {
  let u = unify(checker.substitution, checker.fresh, expected, found);
  let c: Checker = with_unified(checker, u);
  match u.error { None -> c, Some(e) -> report_unify(c, e, span, b"argument type") }
}

pub fn reject_growth(
  checker: Checker,
  members: List<GroupDefinition>,
  fills: List<Instantiation>,
) -> Checker / {abort.raise} =
  fills.fold(checker, |c: Checker, f: Instantiation|
    match members.fold(None, |acc: Option<List<RigidParam>>, g: GroupDefinition|
        if g.name == f.callee { Some(g.types) } else { acc }) {
      None -> c,
      Some(params) ->
        f.grows.fold(c, |inner: Checker, grown: { param: Int, ty: Bytes }|
          match params.at(grown.param) {
            None -> inner,
            Some(p) -> {
              let name = simple_name_of(f.callee);
              let rejected = report_error_at(
                { ..inner, module: f.module },
                b"E0308",
                f.span,
                Bytes::concat_all([
                  b"a call to `",
                  name,
                  b"` inside its own recursive group gives `",
                  p.name,
                  b"` a type that grows",
                ]),
                Bytes::concat_all([b"`", p.name, b"` would be `", grown.ty, b"` here"]),
                [
                  Bytes::concat_all([
                    b"each time round the recursion `",
                    name,
                    b"` would be called at a larger type, so no finite set of copies of it serves the group: that is polymorphic recursion",
                  ]),
                  Bytes::concat_all([
                    b"pass a type parameter along as it is, or a type that names none; or break the cycle so `",
                    name,
                    b"` is checked on its own before this call",
                  ]),
                ],
              );
              { ..rejected, module: inner.module }
            },
          }),
    })

fn infer_app_general(
  checker: Checker,
  span: Span,
  function: Expression,
  args: List<Expression>,
  labels: List<Identifier>,
  hint: Option<Hint>,
) -> Inference / {abort.raise} =
  applied_call(span, function, infer(checker, function), None, args, labels, hint)

pub type TrailingArgument =
  | NamedValue({ written: Expression, ty: Type, node: Option<WalkedExpression> })
  | CopiedDefault(Expression)

fn applied_call(
  span: Span,
  function: Expression,
  f0: Inference,
  on: Option<{ written: Expression, ty: Type, node: Option<WalkedExpression> }>,
  given: List<Expression>,
  labels: List<Identifier>,
  hint: Option<Hint>,
  rest: List<TrailingArgument> = [],
) -> Inference / {abort.raise} = {
  let args = List::concat(
    match on { Some(x) -> [x.written].concat(given), None -> given },
    rest.map(|t: TrailingArgument| match t { NamedValue(x) -> x.written, CopiedDefault(d) -> d }),
  );
  let f: Inference = {
    checker: fill_labels(
      mark_called(f0.checker, expression_span(function)),
      span,
      labels,
      callee_labels(f0.checker, expression_span(function)),
    ),
    ty: f0.ty,
    effects: f0.effects,
    node: f0.node,
  };
  let repeats = callee_repeats(f.checker, function, args);
  let mark_called: { params: List<Type>, met: Equations } = match shallow_resolve(
      f.checker.substitution,
      f.ty,
    ) {
    FunctionType(fn_) ->
      {
        params: fn_.params,
        met: match hint {
          Some(h) ->
            Equation({
              expected: fn_.ret,
              found: match hint_type(f.checker, hint) { Some(t) -> t, None -> h.ty },
              before: h.met,
            }),
          None -> NoEquations,
        },
      },
    _ -> { params: [], met: NoEquations },
  };
  let builtin = prelude_name_of(f.checker, function);
  let written = infer_args(
    f.checker,
    given,
    span,
    repeats.params,
    repeats.waits,
    mark_called.params,
    mark_called.met,
    ranged_lambda(f.checker, builtin, args),
    first: match on { Some(x) -> Some(x.ty), None -> None },
  );
  let as_ = range(0, rest.len()).fold(
    {
      checker: written.checker,
      types: written.types,
      effects: written.effects,
      nodes: match on { Some(x) -> [x.node].concat(written.nodes), None -> written.nodes },
    },
    |acc: { checker: Checker, types: List<Type>, effects: Effects, nodes: List<Option<WalkedExpression>> }, k: Int|
      match ((rest.get(k), mark_called.params.at(written.types.len() + k))) {
        (NamedValue(x), _) -> { ..acc, types: acc.types.push(x.ty), nodes: acc.nodes.push(x.node) },
        (CopiedDefault(d), Some(p)) ->
          {
            ..acc,
            checker: {
              ..acc.checker,
              copied_defaults: acc.checker.copied_defaults.push({ expression: d, ty: p }),
            },
            types: acc.types.push(p),
            nodes: acc.nodes.push(
              Some({
                node: WalkedDefault(acc.checker.copied_defaults.len()),
                span: expression_span(d),
                ty: p,
              }),
            ),
          },
        _ -> { ..acc, nodes: acc.nodes.push(None) },
      },
  );
  let through = match callee_source(f.checker, function) {
    PerformViaFunctionValue -> true,
    _ -> false,
  };
  let mark_called = |effects: Effects|
    call_of(typed_at(f0, expression_span(function)), as_.nodes, if through { effects }
    else { no_effects() });
  let j0: WithEffects = join(as_.checker, span, f.effects, as_.effects);
  let c: Checker = j0.checker;
  match resolve(c, f.ty) {
    FunctionType(fn_) -> if fn_.params.len() != args.len() {
      let n = fn_.params.len();
      let reported: Checker = report_error_with_labels(
        c,
        b"E0202",
        Bytes::concat_all([
          b"this function takes ",
          ascii_of_int(n),
          b" argument",
          plural(n),
          b", but ",
          supplied(args.len()),
        ]),
        [
          label_at(
            c.module,
            span,
            true,
            Bytes::concat_all([
              b"expected ",
              ascii_of_int(n),
              b", found ",
              ascii_of_int(args.len()),
            ]),
          ),
          label_at(
            c.module,
            expression_span(function),
            false,
            b"this is the function being called",
          ),
        ],
        [],
      );
      let j: WithEffects = join(reported, span, j0.effects, fn_.effects);
      { checker: j.checker, ty: fn_.ret, effects: j.effects, node: None }
    } else {
      let source = callee_source(c, function);
      let handed: { checker: Checker, types: List<Type> } = if builtin == b"bracket" {
        joined_callbacks(c, span, as_.types)
      } else { { checker: c, types: as_.types } };
      let checked: Checker = expect_arguments(
        handed.checker,
        fn_.params,
        handed.types,
        |cc: Checker, i: Int|
          expect_argument(cc, expression_span(args.get(i)), fn_.params.get(i), handed.types.get(i)),
      );
      let noted: Checker = if is_int_builtin(function) && fn_.params.len() > 0 {
        {
          ..checked,
          bit_ops: checked.bit_ops.filter(|b: BitOp| b.span != expression_span(function)).push({
            span: span,
            what: int_builtin_text(function, args),
            ty: fn_.params.get(0),
            builtin: true,
          }),
        }
      } else { checked };
      let resolved = resolve_effects_in(noted, fn_.effects);
      let required: { checker: Checker, shown: Bool } = if builtin == b""
          || !resolved.listed.contains(abort_effect()) { { checker: noted, shown: false } }
      else { requires_shown(noted, builtin, args, span) };
      let obliged: Checker = required.checker;
      let effects = if required.shown { { ..resolved, listed: without_raises(resolved.listed) } }
      else { resolved };
      let scaled = repeated_effects(obliged, fn_.params, repeats.params);
      let holding: { checker: Checker, params: List<Int> } = match repeats.waits {
        Some(g) -> if effects.listed.len() == 0 && effects.variable == None {
          { checker: obliged, params: [] }
        } else { callback_parameters_of(obliged, g) },
        None -> { checker: obliged, params: [] },
      };
      let held = holding.params.map(|i: Int|
        {
          param: i,
          effects: match fn_.params.at(i) {
            Some(p) -> effects_in(holding.checker, p, { listed: [], vars: [] }),
            None -> { listed: [], vars: [] },
          },
        });
      let waiting = |g: Bytes, has: ({ listed: List<Effect>, vars: List<Int> }) -> Bool|
        held.fold(
          [],
          |acc: List<PendingIteration>, h: { param: Int, effects: { listed: List<Effect>, vars: List<Int> } }|
            if has(h.effects) { acc.push({ callee: g, param: Some(h.param), span: span }) }
            else { acc },
        );
      let entered: Checker = match repeats.waits {
        Some(g) -> if !holding.checker.own_functions.contains(g) { holding.checker } else {
          { ..holding.checker, calls: holding.checker.calls.push({ callee: g, span: span }) }
        },
        None -> holding.checker,
      };
      let recorded: Checker = effects.listed.fold(entered, |cc: Checker, entry: Effect|
        if scaled.listed.contains(entry) {
          record_perform_under(cc, entry, span, source, Some(span), [])
        } else {
          let own = match repeats.waits {
            None -> [],
            Some(g) ->
              [{ callee: g, param: None, span: span }].concat(
                waiting(g, |h: { listed: List<Effect>, vars: List<Int> }| h.listed.contains(entry)),
              ),
          };
          record_perform_under(cc, entry, span, source, cc.over, own.concat(cc.pending_iterations))
        });
      let variable_waits = match ((repeats.waits, effects.variable)) {
        (Some(g), Some(v)) ->
          waiting(g, |h: { listed: List<Effect>, vars: List<Int> }| h.vars.contains(v)),
        _ -> [],
      };
      let j: WithEffects = join(
        record_repeated_variable(recorded, effects.variable, scaled.vars, variable_waits, span),
        span,
        j0.effects,
        effects,
      );
      { checker: j.checker, ty: fn_.ret, effects: j.effects, node: mark_called(fn_.effects) }
    },
    VariableType(_) -> {
      let ret: WithType = new_type(c);
      let eff: WithEffects = new_effects(ret.checker);
      let want = fn_type(as_.types, ret.ty, eff.effects);
      let x: ExpectResult = expect(
        eff.checker,
        expression_span(function),
        want,
        f.ty,
        b"callee type",
      );
      let j: WithEffects = join(
        record_repeated_variable(x.checker, eff.effects.variable, [], [], span),
        span,
        j0.effects,
        eff.effects,
      );
      { checker: j.checker, ty: ret.ty, effects: j.effects, node: mark_called(eff.effects) }
    },
    other -> {
      let o: WithType = new_type(
        report_error_at(
          c,
          b"E0204",
          expression_span(function),
          b"this is not a function",
          Bytes::concat_all([b"has type `", type_text(other), b"`"]),
          [b"only function values can be applied"],
        ),
      );
      { checker: o.checker, ty: o.ty, effects: j0.effects, node: None }
    },
  }
}

type Binder = { name: Identifier, ty: Type }

type PatternBindings = { checker: Checker, out: List<Binder>, pattern: Option<TypedPattern<Type>> }

type BoundEach = { checker: Checker, out: List<Binder>, pats: List<Option<TypedPattern<Type>>> }

fn bind_private_constructor(
  checker: Checker,
  name: QName,
  args: List<Pattern>,
  closed: Diagnostic,
  out: List<Binder>,
) -> PatternBindings / {abort.raise} = {
  let bound = args.fold(
    { checker: if is_bare(name) { report(checker, closed) } else { checker }, out: out },
    |acc: { checker: Checker, out: List<Binder> }, arg: Pattern| {
      let t: WithType = new_type(acc.checker);
      let b: PatternBindings = bind_pattern(t.checker, arg, t.ty, acc.out);
      { checker: b.checker, out: b.out }
    },
  );
  { checker: bound.checker, out: bound.out, pattern: None }
}

fn bind_pattern(
  checker: Checker,
  p: Pattern,
  scrutinee: Type,
  out: List<Binder>,
) -> PatternBindings / {abort.raise} =
  match p {
    PatternWildcard(w) ->
      { checker: checker, out: out, pattern: Some(TypedWild({ span: w.span, ty: scrutinee })) },
    PatternInvalid(_) -> { checker: checker, out: out, pattern: None },
    PatternVariable(v) ->
      {
        checker: checker,
        out: out.push({ name: v.name, ty: scrutinee }),
        pattern: Some(TypedBinder({ name: v.name.name, ty: scrutinee, span: v.span })),
      },
    PatternLiteral(l) ->
      {
        checker: expect(
          checker,
          l.span,
          scrutinee,
          literal_type(l.literal),
          b"pattern literal",
        ).checker,
        out: out,
        pattern: Some(TypedLiteralPattern(l.literal)),
      },
    PatternRange(r) ->
      {
        checker: bind_range(checker, r.span, r.lo, r.hi, scrutinee),
        out: out,
        pattern: Some(TypedRange({ lo: r.lo, hi: r.hi })),
      },
    PatternConstructor(c) -> {
      let n: WithName = constructor_name(checker, c.name);
      let info = match n.name { Some(q) -> constructor_of(n.checker, q), None -> None };
      let kept = match info { Some(_) -> None, None -> private_name_diagnostic(n.checker, c.name) };
      match ((info, kept)) {
        (None, Some(closed)) -> bind_private_constructor(n.checker, c.name, c.args, closed, out),
        (None, None) -> if is_bare(c.name)
            || (match declared_value(n.checker, c.name) { Some(_) -> true, None -> false }) {
          let nm = c.name.name.name;
          let base = [b"constructors come from a `type` declaration with variants"];
          let notes = match builtin_type_arity(nm) {
            None -> base,
            Some(_) -> {
              let with_builtin = base.push(
                Bytes::concat_all([b"`", nm, b"` is a builtin type and declares none"]),
              );
              if nm == secret_name() {
                with_builtin.push(
                  b"that is deliberate: a pattern binding the payload would be a one-line escape from every guarantee `Secret` makes",
                ).push(
                  b"use `Secret::verify` to check a candidate, `Secret::is_empty` to check presence, or hand the whole `Secret` to a handler clause",
                )
              } else { with_builtin }
            },
          };
          {
            checker: report_error_at(
              n.checker,
              b"E0101",
              c.name.span,
              Bytes::concat_all([b"unknown constructor `", nm, b"`"]),
              b"not found",
              notes,
            ),
            out: out,
            pattern: None,
          }
        } else { { checker: n.checker, out: out, pattern: None } },
        (Some(ci), _) -> {
          let inst = instantiate(ci.scheme, n.checker.fresh);
          let c1: Checker = { ..n.checker, fresh: inst.fresh };
          let shape = match inst.ty {
            FunctionType(f) -> { fields: f.params, result: f.ret },
            other -> { fields: [], result: other },
          };
          let c2: Checker = expect(
            c1,
            c.span,
            scrutinee,
            shape.result,
            b"pattern constructor",
          ).checker;
          let nf = shape.fields.len();
          if nf != c.args.len() {
            {
              checker: report_error_at_and(
                c2,
                b"E0202",
                c.span,
                Bytes::concat_all([
                  b"constructor `",
                  ci.name,
                  b"` takes ",
                  ascii_of_int(nf),
                  b" field",
                  plural(nf),
                  b", but the pattern binds ",
                  ascii_of_int(c.args.len()),
                ]),
                Bytes::concat_all([b"expected ", ascii_of_int(nf), b" fields"]),
                ci.at,
                b"declared here",
                [],
              ),
              out: out,
              pattern: None,
            }
          } else {
            let each = c.args.fold(
              { checker: c2, out: out, pats: [] },
              |acc: BoundEach, arg: Pattern|
                match shape.fields.at(acc.pats.len()) {
                  Some(field) -> {
                    let b: PatternBindings = bind_pattern(acc.checker, arg, field, acc.out);
                    { checker: b.checker, out: b.out, pats: acc.pats.push(b.pattern) }
                  },
                  None -> { ..acc, pats: acc.pats.push(None) },
                },
            );
            {
              checker: each.checker,
              out: each.out,
              pattern: case_pattern_of(ci.type_name, ci.name, ci.index, each.pats),
            }
          }
        },
      }
    },
    PatternList(l) -> {
      let elem: WithType = new_type(checker);
      let c1: Checker = expect(
        elem.checker,
        l.span,
        scrutinee,
        list_type(elem.ty),
        b"list pattern",
      ).checker;
      let items = l.items.fold({ checker: c1, out: out, pats: [] }, |acc: BoundEach, x: Pattern| {
        let b: PatternBindings = bind_pattern(acc.checker, x, elem.ty, acc.out);
        { checker: b.checker, out: b.out, pats: acc.pats.push(b.pattern) }
      });
      match l.rest {
        Some(r) -> {
          let b: PatternBindings = bind_pattern(items.checker, r, list_type(elem.ty), items.out);
          { checker: b.checker, out: b.out, pattern: list_pattern_of(items.pats, Some(b.pattern)) }
        },
        None ->
          { checker: items.checker, out: items.out, pattern: list_pattern_of(items.pats, None) },
      }
    },
    PatternOr(o) -> match o.alternatives {
      [] -> panic("an or-pattern with no alternatives"),
      [head, ..rest] -> {
        let first: PatternBindings = bind_pattern(checker, head, scrutinee, []);
        let agreed = rest.fold(
          { checker: first.checker, pats: [first.pattern] },
          |acc: { checker: Checker, pats: List<Option<TypedPattern<Type>>> }, alt: Pattern| {
            let b: PatternBindings = bind_pattern(acc.checker, alt, scrutinee, []);
            {
              checker: same_binders(b.checker, pattern_span(alt), first.out, b.out),
              pats: acc.pats.push(b.pattern),
            }
          },
        );
        { checker: agreed.checker, out: out.concat(first.out), pattern: or_pattern_of(agreed.pats) }
      },
    },
    PatternRecord(r) -> match record_fields(resolve(checker, scrutinee)) {
      Some(known) -> {
        let bound = r.fields.fold(
          { checker: checker, out: out, fields: [] },
          |acc: { checker: Checker, out: List<Binder>, fields: List<{ name: Bytes, pattern: Option<TypedPattern<Type>> }> }, f: { name: Identifier, pattern: Pattern }|
            match field_get(known, f.name.name) {
              Some(t) -> {
                let b: PatternBindings = bind_pattern(acc.checker, f.pattern, t, acc.out);
                {
                  checker: b.checker,
                  out: b.out,
                  fields: acc.fields.push({ name: f.name.name, pattern: b.pattern }),
                }
              },
              None ->
                {
                  checker: report_error_at(
                    acc.checker,
                    b"E0101",
                    f.name.span,
                    Bytes::concat_all([b"no field `", f.name.name, b"` on this record"]),
                    b"unknown field",
                    [],
                  ),
                  out: acc.out,
                  fields: acc.fields.push({ name: f.name.name, pattern: None }),
                },
            },
        );
        let pattern = record_pattern_of(bound.fields, r.rest, r.span, scrutinee);
        if r.rest { { checker: bound.checker, out: bound.out, pattern: pattern } } else {
          let named = r.fields.map(|f: { name: Identifier, pattern: Pattern }| f.name.name);
          let omitted = known.filter(|field: Field| !named.contains(field.name));
          if omitted.len() > 0 {
            {
              checker: report_error_at(
                bound.checker,
                b"E0201",
                r.span,
                b"record pattern does not name every field",
                b"missing: ".concat(backticked(omitted.map(|field: Field| field.name), b", ")),
                [b"add the missing fields, or end the pattern with `..`"],
              ),
              out: bound.out,
              pattern: None,
            }
          } else { { checker: bound.checker, out: bound.out, pattern: pattern } }
        }
      },
      None -> if r.rest {
        {
          checker: report_error_at(
            checker,
            b"E0201",
            r.span,
            b"cannot infer the record type of this pattern",
            b"a `..` pattern needs the record type to be known",
            [b"annotate the matched value"],
          ),
          out: out,
          pattern: None,
        }
      } else {
        let fs = r.fields.fold(
          { checker: checker, fs: [], out: out, fields: [] },
          |acc: { checker: Checker, fs: List<Field>, out: List<Binder>, fields: List<{ name: Bytes, pattern: Option<TypedPattern<Type>> }> }, f: { name: Identifier, pattern: Pattern }| {
            let t: WithType = new_type(acc.checker);
            let b: PatternBindings = bind_pattern(t.checker, f.pattern, t.ty, acc.out);
            {
              checker: b.checker,
              fs: acc.fs.push({ name: f.name.name, ty: t.ty }),
              out: b.out,
              fields: acc.fields.push({ name: f.name.name, pattern: b.pattern }),
            }
          },
        );
        {
          checker: expect(
            fs.checker,
            r.span,
            scrutinee,
            RecordType(fields_sorted(fs.fs)),
            b"record pattern",
          ).checker,
          out: fs.out,
          pattern: record_pattern_of(fs.fields, false, r.span, scrutinee),
        }
      },
    },
  }

fn same_binders(
  checker: Checker,
  span: Span,
  want: List<Binder>,
  got: List<Binder>,
) -> Checker / {abort.raise} = {
  let wanted = want.map(|w: Binder| w.name.name);
  let found = got.map(|g: Binder| g.name.name);
  let missing = wanted.filter(|n: Bytes| !found.contains(n));
  let extra = found.filter(|n: Bytes| !wanted.contains(n));
  let typed = got.fold(checker, |c: Checker, g: Binder|
    match binder_type(want, g.name.name) {
      Some(t) -> expect(c, span, t, g.ty, b"an or-pattern binds each name at one type").checker,
      None -> c,
    });
  if missing.len() == 0 && extra.len() == 0 { typed } else {
    let label = if extra.len() == 0 {
      Bytes::concat_all([
        b"does not bind ",
        backticked(missing, b", "),
        b", which the first alternative does",
      ])
    } else if missing.len() == 0 {
      Bytes::concat_all([
        b"binds ",
        backticked(extra, b", "),
        b", which the first alternative does not",
      ])
    } else {
      Bytes::concat_all([
        b"binds ",
        backticked(extra, b", "),
        b" where the first alternative binds ",
        backticked(missing, b", "),
      ])
    };
    report_error_at(
      typed,
      b"E0212",
      span,
      b"the alternatives of an or-pattern bind different names",
      label,
      [b"every alternative binds the same names, so the arm can use each whichever one matched"],
    )
  }
}

fn unsigned_le(a: Int, b: Int) -> Bool = {
  let top = 0 - 9223372036854775807 - 1;
  a ^ top <= b ^ top
}

fn literal_le(ty: Bytes, lo: SourceLiteral, hi: SourceLiteral) -> Bool = {
  let unsigned = fixed_widths().any(|w: { name: Bytes, bits: Int, signed: Bool }|
    w.name == ty && !w.signed);
  match ((lo, hi)) {
    (LiteralInt(a), LiteralInt(b)) -> a <= b,
    (LiteralFixed(_, a), LiteralFixed(_, b)) -> if unsigned { unsigned_le(a, b) } else { a <= b },
    (LiteralWide(_, ah, al), LiteralWide(_, bh, bl)) -> if ah == bh { unsigned_le(al, bl) }
    else if unsigned { unsigned_le(ah, bh) }
    else { ah <= bh },
    _ -> false,
  }
}

fn bind_range(
  checker: Checker,
  span: Span,
  lo: SourceLiteral,
  hi: SourceLiteral,
  scrutinee: Type,
) -> Checker / {abort.raise} = {
  let form = [
    b"a range is written `lo..=hi`, as in `0..=9` or `b'a'..=b'z'`, and holds both bounds",
  ];
  match ((integer_of(lo), integer_of(hi))) {
    (Some(a), Some(b)) -> if a != b {
      report_error_at(
        checker,
        b"E0222",
        span,
        b"a range pattern's bounds are of one integer type",
        Bytes::concat_all([b"from a `", a, b"` to a `", b, b"`"]),
        form,
      )
    } else {
      let typed: Checker = expect(
        checker,
        span,
        scrutinee,
        literal_type(lo),
        b"pattern literal",
      ).checker;
      if literal_le(a, lo, hi) { typed } else {
        report_error_at(
          typed,
          b"E0222",
          span,
          b"a range pattern's first bound is greater than its second",
          b"no value is in this range",
          form,
        )
      }
    },
    _ ->
      report_error_at(
        checker,
        b"E0222",
        span,
        b"a range pattern's bounds are integer literals",
        b"one of these is not an integer",
        form,
      ),
  }
}

fn binder_type(bs: List<Binder>, name: Bytes) -> Option<Type> =
  bs.fold(None, |acc: Option<Type>, b: Binder|
    match acc { Some(_) -> acc, None -> if b.name.name == name { Some(b.ty) } else { None } })

fn infer_match(
  checker: Checker,
  span: Span,
  scrutinee: Expression,
  arms: List<MatchArm>,
  hint: Option<Hint>,
) -> Inference / {abort.raise} = {
  let s: Inference = infer(checker, scrutinee);
  let result: WithType = new_type(s.checker);
  let walked = arms.fold(
    { checker: result.checker, effects: s.effects, ty: result.ty, variables: [], arms: [] },
    |acc: { checker: Checker, effects: Effects, ty: Type, variables: List<Int>, arms: List<Option<WalkedArm>> }, arm: MatchArm| {
      let outside = reader_of(acc.checker);
      let pushed: Checker = { ..acc.checker, env: env_push(acc.checker.env) };
      let b: PatternBindings = bind_pattern(pushed, arm.pattern, s.ty, []);
      let bound: Checker = bind_all(b.checker, b.out);
      let inside: Checker = {
        ..bound,
        guards: guards::matched(outside, bound.guards, scrutinee, arm.pattern),
      };
      let guarded: { checker: Checker, effects: Effects, node: Option<Option<WalkedExpression>> } = match arm.guard {
        Some(g) -> {
          let o: Inference = infer(inside, g);
          let c: Checker = expect(
            o.checker,
            expression_span(g),
            bool_type(),
            o.ty,
            b"match guard",
          ).checker;
          let j: WithEffects = join(c, span, acc.effects, o.effects);
          {
            checker: assume_condition(j.checker, g, true),
            effects: j.effects,
            node: Some(typed_at(o, expression_span(g))),
          }
        },
        None -> { checker: inside, effects: acc.effects, node: None },
      };
      let body: Inference = infer(guarded.checker, arm.body, hint_after(hint, acc.ty));
      let j: WithEffects = join(body.checker, span, guarded.effects, body.effects);
      let left: Checker = restore_guards(j.checker, acc.checker.guards);
      let missed: Checker = match arm.guard {
        None -> { ..left, guards: guards::unmatched(outside, left.guards, scrutinee, arm.pattern) },
        Some(_) -> left,
      };
      let popped: Checker = { ..missed, env: env_pop(missed.env) };
      let n: Joined = join_type_into(
        { checker: popped, ty: acc.ty, variables: acc.variables },
        expression_span(arm.body),
        body.ty,
        b"match arms must agree",
      );
      {
        checker: n.checker,
        effects: j.effects,
        ty: n.ty,
        variables: n.variables,
        arms: acc.arms.push(
          arm_of(
            b.pattern,
            pattern_span(arm.pattern),
            guarded.node,
            typed_at(body, expression_span(arm.body)),
          ),
        ),
      }
    },
  );
  {
    checker: check_exhaustive(
      close_effect_variables(restore_guards(walked.checker, s.checker.guards), walked.variables),
      span,
      arms,
    ),
    ty: walked.ty,
    effects: walked.effects,
    node: match_of(typed_at(s, expression_span(scrutinee)), walked.arms),
  }
}

pub fn resolve_op(
  checker: Checker,
  eff: QName,
  ident: Identifier,
) -> { checker: Checker, hit: Option<{ info: EffectInfo, op: OpInfo }> } / {abort.raise} =
  if is_exit_effect(eff.name.name) { resolve_exit_raise(checker, eff) }
  else { declared_op(checker, eff, ident) }

fn resolve_exit_raise(checker: Checker, eff: QName) -> WithOperation = {
  let key = Bytes::concat_all([ascii_of_int(checker.module), b" ", eff.name.name]);
  let carried: WithType = match checker.exit_types.get(key) {
    Some(t) -> { checker: checker, ty: t },
    None -> {
      let o: WithType = new_type(checker);
      { checker: { ..o.checker, exit_types: o.checker.exit_types.insert(key, o.ty) }, ty: o.ty }
    },
  };
  let result: WithVar = new_type_var(carried.checker);
  let at = { module: checker.module, span: eff.span };
  let op = {
    name: exit_operation_name(),
    mode: RaiseMode,
    resource_param: false,
    params: [carried.ty],
    kept: [],
    ret: VariableType(result.var),
    at: at,
    scheme: Some({
      type_variables: [result.var],
      effect_variables: [],
      keep_variables: [],
      label_variables: [],
      ty: fn_type([carried.ty], VariableType(result.var), no_effects()),
    }),
  };
  {
    checker: result.checker,
    hit: Some({
      info: {
        name: eff.name.name,
        module: b"",
        simple_name: eff.name.name,
        nondet: false,
        operations: [op],
        at: at,
      },
      op: op,
    }),
  }
}

fn declared_op(
  checker: Checker,
  eff: QName,
  ident: Identifier,
) -> { checker: Checker, hit: Option<{ info: EffectInfo, op: OpInfo }> } / {abort.raise} = {
  let e: WithName = effect_name(checker, eff);
  match e.name {
    None -> { checker: e.checker, hit: None },
    Some(name) -> match effect_of(e.checker, name) {
      None -> if name == scoped_effect() {
        {
          checker: report_error_at(
            e.checker,
            b"E0103",
            eff.span,
            b"`scoped` is a builtin effect and cannot be performed directly",
            b"not a declared effect",
            [
              b"read a scoped value with `h.get()`, inside `with_scope[r](..) { h -> .. }` or in a function it hands the value to",
            ],
          ),
          hit: None,
        }
      } else { { checker: e.checker, hit: None } },
      Some(info) -> match op_named(info, ident.name) {
        Some(o) -> { checker: e.checker, hit: Some({ info: info, op: o }) },
        None -> {
          let known = info.operations.map(|o: OpInfo| o.name);
          {
            checker: report_error_at_and(
              e.checker,
              b"E0104",
              ident.span,
              Bytes::concat_all([
                b"effect `",
                eff.name.name,
                b"` has no operation `",
                ident.name,
                b"`",
              ]),
              b"not declared",
              info.at,
              Bytes::concat_all([b"`", info.name, b"` is declared here"]),
              [
                if known.len() == 0 {
                  Bytes::concat_all([b"`", info.name, b"` declares no operations"])
                } else {
                  Bytes::concat_all([
                    b"operations of `",
                    info.name,
                    b"`: ",
                    backticked(known, b", "),
                  ])
                },
              ],
            ),
            hit: None,
          }
        },
      },
    },
  }
}

pub fn written_as(checker: Checker, eff: Bytes) -> Option<Bytes> / {abort.raise} =
  if is_prelude_effect(eff) || is_scoped_effect(eff) { Some(eff) } else {
    let scope = scope_of(checker);
    match scope.bound.effects.fold(None, |acc: Option<Bytes>, b: Binding|
        match acc {
          Some(_) -> acc,
          None -> if b.qualified == eff { Some(b.name) } else { None },
        }) {
      Some(n) -> Some(n),
      None -> {
        let simple = match effect_of(checker, eff) { Some(info) -> info.simple_name, None -> eff };
        scope.modules.filter(is_explicit_binding).fold(
          None,
          |acc: Option<Bytes>, mb: ModuleBinding|
            match acc {
              Some(_) -> acc,
              None -> match lookup_declared(
                  checker.resolved.declarations.get(mb.target),
                  EffectSpace,
                  simple,
                ) {
                Some(d) -> if d.qualified == eff {
                  Some(Bytes::concat_all([mb.binder, b"::", simple]))
                } else { None },
                None -> None,
              },
            },
        )
      },
    }
  }

pub fn as_written(checker: Checker, eff: Bytes) -> Bytes / {abort.raise} =
  match written_as(checker, eff) {
    Some(w) -> w,
    None -> match effect_of(checker, eff) { Some(info) -> info.simple_name, None -> eff },
  }

fn resource_for(
  checker: Checker,
  info: EffectInfo,
  op_info: OpInfo,
  resource: Option<Identifier>,
  span: Span,
) -> WithResource / {abort.raise} =
  match resource {
    Some(r) -> if op_info.resource_param {
      {
        checker: checker,
        resource: Some(match checker.label_params.get(r.name) {
          Some(v) -> ResourceVariable(v),
          None -> NamedResource(r.name),
        }),
      }
    } else {
      {
        checker: report_error_at_and(
          checker,
          b"E0304",
          r.span,
          Bytes::concat_all([
            b"`",
            info.name,
            b".",
            op_info.name,
            b"` is not resource-parameterized",
          ]),
          b"unexpected resource label",
          op_info.at,
          b"declared without `[r]`",
          [
            Bytes::concat_all([
              b"drop the label, or declare it as `",
              mode_text(op_info.mode),
              b" ",
              op_info.name,
              b"[r](..)`",
            ]),
          ],
        ),
        resource: None,
      }
    },
    None -> if op_info.resource_param {
      {
        checker: report_error_at_and(
          checker,
          b"E0304",
          span,
          Bytes::concat_all([
            b"`",
            info.name,
            b".",
            op_info.name,
            b"` is declared with a resource parameter",
          ]),
          b"missing the `[resource]` label",
          op_info.at,
          Bytes::concat_all([b"declared as `", op_info.name, b"[r](..)`"]),
          [
            Bytes::concat_all([
              b"write `",
              as_written(checker, info.name),
              b".",
              op_info.name,
              b"[<resource>](..)`; the label is what lets two tests be scheduled together",
            ]),
          ],
        ),
        resource: None,
      }
    } else { { checker: checker, resource: Some(SingletonResource) } },
  }

fn clause_resource_for(
  checker: Checker,
  info: EffectInfo,
  op_info: OpInfo,
  clause: HandleClause,
  span: Span,
) -> WithResource / {abort.raise} =
  if !clause.wildcard_label { resource_for(checker, info, op_info, clause.resource, span) }
  else if op_info.resource_param { { checker: checker, resource: Some(AnyResource) } } else {
    {
      checker: report_error_at_and(
        checker,
        b"E0304",
        span,
        Bytes::concat_all([
          b"`",
          info.name,
          b".",
          op_info.name,
          b"` is not resource-parameterized",
        ]),
        b"`[*]` names no label",
        op_info.at,
        b"declared without `[r]`",
        [
          Bytes::concat_all([
            b"drop it, or declare it as `",
            mode_text(op_info.mode),
            b" ",
            op_info.name,
            b"[r](..)`",
          ]),
        ],
      ),
      resource: None,
    }
  }

pub fn op_free_variables(op_info: OpInfo) -> List<Int> / {abort.raise} = {
  let fv = op_info.params.fold(
    { types: [], effect_variables: [] },
    |acc: FreeVariables, ty: Type| free_variables(substitution_new(), ty, acc),
  );
  free_variables(substitution_new(), op_info.ret, fv).types
}

fn op_scheme(op_info: OpInfo) -> Scheme / {abort.raise} =
  match op_info.scheme {
    Some(sc) -> sc,
    None ->
      {
        type_variables: op_free_variables(op_info),
        effect_variables: [],
        keep_variables: [],
        label_variables: [],
        ty: fn_type(op_info.params, op_info.ret, no_effects()),
      },
  }

type OperationType = { checker: Checker, params: List<Type>, ret: Type, effects: Effects }

fn instantiate_op(checker: Checker, op_info: OpInfo) -> OperationType / {abort.raise} = {
  let inst = instantiate(op_scheme(op_info), checker.fresh);
  let c: Checker = { ..checker, fresh: inst.fresh };
  match inst.ty {
    FunctionType(f) -> { checker: c, params: f.params, ret: f.ret, effects: f.effects },
    _ -> panic("operation schemes are function types"),
  }
}

fn record_operation_instance(
  shape: OperationType,
  span: Span,
  op_info: OpInfo,
) -> OperationType / {abort.raise} =
  if op_free_variables(op_info).len() == 0 { shape }
  else { { ..shape, checker: note_instance(shape.checker, span, op_type(shape)) } }

fn clause_ordered(op_info: OpInfo, shape: OperationType) -> List<Int> / {abort.raise} =
  if op_free_variables(op_info).len() == 0 { [] }
  else { ordered_variables(shape.checker, op_type(shape)) }

fn op_type(shape: OperationType) -> Type = fn_type(shape.params, shape.ret, no_effects())

pub fn kept_type() -> Type = NamedType({ name: b"std.internal.schedule.Kept", args: [] })

pub fn is_shipped_effect(info: EffectInfo) -> Bool = info.module == b"" || is_shipped(info.module)

pub fn marshalling_variables(op_info: OpInfo) -> List<Int> / {abort.raise} = {
  let sc = op_scheme(op_info);
  let named = variables_in_signature(op_info.params, op_info.ret, op_info.mode, sc.type_variables);
  range(0, sc.type_variables.len()).filter(|i: Int| named.contains(sc.type_variables.get(i)))
}

pub fn variables_in_signature(
  params: List<Type>,
  ret: Type,
  mode: Mode,
  own: List<Int>,
) -> List<Int> / {abort.raise} = {
  let fv = params.fold({ types: [], effect_variables: [] }, |acc: FreeVariables, ty: Type|
    free_variables(substitution_new(), ty, acc));
  let named = if is_raise(mode) { fv } else { free_variables(substitution_new(), ret, fv) };
  own.filter(|v: Int| named.types.contains(v))
}

fn instantiate_op_for_clause(
  checker: Checker,
  info: EffectInfo,
  op_info: OpInfo,
) -> OperationType / {abort.raise} = {
  let sc = op_scheme(op_info);
  let types: { checker: Checker, vs: List<Int> } = sc.type_variables.fold(
    { checker: checker, vs: [] },
    |acc: { checker: Checker, vs: List<Int> }, v: Int| {
      let o: WithVar = new_type_var(acc.checker);
      {
        checker: { ..o.checker, substitution: mark_rigid_type(o.checker.substitution, o.var) },
        vs: acc.vs.push(o.var),
      }
    },
  );
  let rows: { checker: Checker, vs: List<Int> } = sc.effect_variables.fold(
    { checker: types.checker, vs: [] },
    |acc: { checker: Checker, vs: List<Int> }, v: Int| {
      let o: WithVar = new_effect_variable(acc.checker);
      {
        checker: { ..o.checker, substitution: mark_rigid_effects(o.checker.substitution, o.var) },
        vs: acc.vs.push(o.var),
      }
    },
  );
  let marshalling = marshalling_variables(op_info).map(|i: Int| types.vs.get(i));
  let shipped = is_shipped_effect(info);
  let erased = if shipped { marshalling } else { [] };
  let c = if shipped { rows.checker }
  else { { ..rows.checker, keep_variables: rows.checker.keep_variables.concat(marshalling) } };
  match apply_arguments(
      rename_scheme(sc, types.vs, rows.vs, []),
      erased,
      [],
      erased.map(|_: Int| kept_type()),
    ) {
    FunctionType(f) -> { checker: c, params: f.params, ret: f.ret, effects: f.effects },
    _ -> panic("operation schemes are function types"),
  }
}

fn marshalling_rejected(
  checker: Checker,
  info: EffectInfo,
  op_info: OpInfo,
  span: Span,
) -> Checker / {abort.raise} =
  if !is_shipped_effect(info) || is_shipped(module_name(checker, checker.module))
      || marshalling_variables(op_info).len() == 0 { checker } else {
    report_error_at(
      checker,
      b"E0165",
      span,
      Bytes::concat_all([
        b"`",
        as_written(checker, info.name),
        b".",
        op_info.name,
        b"` is the toolchain's and generic in its own type parameters, so only a module the toolchain ships handles it",
      ]),
      b"a clause for it",
      [
        b"a value of such a parameter crosses to the clause kept with its type, which only the toolchain's own modules read",
      ],
    )
  }

fn is_local_receiver(checker: Checker, x: QName) -> Bool = local_at(checker, x) != None

fn names_effect(checker: Checker, x: QName) -> Bool / {abort.raise} =
  lookup(scope_of(checker).bound, EffectSpace, x.name.name) != None

fn reject_local_effect_clash(checker: Checker, x: QName) -> Checker =
  report_error_at(
    checker,
    b"E0105",
    x.span,
    Bytes::concat_all([b"`", x.name.name, b"` is a binding here and an effect"]),
    b"a call on the binding, or a perform of the effect",
    [
      b"`x.name(..)` calls a function on the value `x` where `x` is a binding, and performs an operation of the effect `x` otherwise; give the binding another name",
    ],
  )

fn infer_perform(
  checker: Checker,
  span: Span,
  eff: QName,
  ident: Identifier,
  resource: Option<Identifier>,
  args: List<Expression>,
) -> Inference / {abort.raise} = {
  let wanted = if is_exit_effect(eff.name.name) { [] }
  else { match resolve_op(checker, eff, ident).hit { Some(hit) -> hit.op.params, None -> [] } };
  let as_ = infer_args(checker, args, span, [], None, wanted, NoEquations, None);
  let r: WithOperation = resolve_op(as_.checker, eff, ident);
  match r.hit {
    None -> {
      let o: WithType = new_type(r.checker);
      { checker: o.checker, ty: o.ty, effects: as_.effects, node: None }
    },
    Some(hit) -> {
      let res: WithResource = resource_for(r.checker, hit.info, hit.op, resource, span);
      match res.resource {
        None -> {
          let o: WithType = new_type(res.checker);
          { checker: o.checker, ty: o.ty, effects: as_.effects, node: None }
        },
        Some(resource_) -> {
          let shape: OperationType = record_operation_instance(
            instantiate_op(res.checker, hit.op),
            span,
            hit.op,
          );
          if shape.params.len() != args.len() {
            let n = shape.params.len();
            {
              checker: report_error_at_and(
                shape.checker,
                b"E0202",
                span,
                Bytes::concat_all([
                  b"`",
                  hit.info.simple_name,
                  b".",
                  hit.op.name,
                  b"` takes ",
                  ascii_of_int(n),
                  b" argument",
                  plural(n),
                  b", but ",
                  supplied(args.len()),
                ]),
                Bytes::concat_all([
                  b"expected ",
                  ascii_of_int(n),
                  b", found ",
                  ascii_of_int(args.len()),
                ]),
                hit.op.at,
                b"declared here",
                [],
              ),
              ty: shape.ret,
              effects: as_.effects,
              node: None,
            }
          } else {
            let checked: Checker = expect_arguments(
              shape.checker,
              shape.params,
              as_.types,
              |c: Checker, i: Int|
                expect(
                  c,
                  expression_span(args.get(i)),
                  shape.params.get(i),
                  as_.types.get(i),
                  b"operation argument",
                ).checker,
            );
            let entry = {
              effect: hit.info.name,
              resource: resource_,
              mode: hit.op.mode,
              op: Some(hit.op.name),
            };
            let noted: Checker = note_handoff(
              note_spawn(checked, hit.info, hit.op, args, as_.types),
              hit.info,
              hit.op,
              args,
              as_.types,
            );
            let c1: Checker = record_perform(noted, entry, span, DirectPerform);
            let operation_effects = resolve_effects_in(c1, shape.effects);
            let c2: Checker = operation_effects.listed.fold(c1, |c: Checker, a: Effect|
              record_perform(c, a, span, PerformViaArguments));
            let j1: WithEffects = join(c2, span, as_.effects, operation_effects);
            let j2: WithEffects = join(j1.checker, span, j1.effects, single_effect(entry));
            let taken: { checker: Checker, short: Bool } = match ((
                least_argument(hit.info, hit.op),
                args.at(0),
              )) {
              (Some(least), Some(a)) -> {
                let o = guards::at_least(reader_of(j2.checker), j2.checker.guards, a, least);
                { checker: { ..j2.checker, guards: o.g }, short: !o.ok }
              },
              _ -> { checker: j2.checker, short: false },
            };
            let typed = taken.checker;
            let node = perform_of(
              hit.info.name,
              hit.op.name,
              match resource { Some(r) -> Some(r.name), None -> None },
              entry,
              as_.nodes,
            );
            if taken.short {
              {
                checker: record_perform(typed, abort_effect(), span, DirectPerform),
                ty: shape.ret,
                effects: {
                  ..j2.effects,
                  listed: effects_insert(j2.effects.listed, abort_effect()),
                },
                node: node,
              }
            } else { { checker: typed, ty: shape.ret, effects: j2.effects, node: node } }
          }
        },
      }
    },
  }
}

fn least_argument(info: EffectInfo, op: OpInfo) -> Option<Int> =
  if info.module != b"" { None }
  else if info.name == b"task" && op.name == b"channel" { Some(0) }
  else if info.name == b"random" && op.name == b"below" { Some(1) }
  else { None }

type HandleClauses = {
  checker: Checker,
  handled: List<Effect>,
  selected: List<OpKey>,
  clause_effects: Effects,
  around: List<ClauseSite>,
  clauses: List<Option<WalkedClause>>,
}

fn spawn_counts(checker: Checker) -> List<Int> =
  checker.open_scopes.map(|region: OpenScope| region.spawns.len())

fn handles_raise(checker: Checker, clause: HandleClause) -> Bool / {abort.raise} =
  match resolve_op(checker, clause.effect_name, clause.op).hit {
    Some(hit) -> is_raise(hit.op.mode),
    None -> false,
  }

type HandlerVariables = {
  checker: Checker,
  effects: Effects,
  vars: List<{ name: Identifier, ty: Type }>,
  nodes: List<Option<WalkedHandlerVar>>,
}

fn infer_handler_variables(
  checker: Checker,
  vars: List<HandlerVar>,
) -> HandlerVariables / {abort.raise} = {
  let pushed: Checker = { ..checker, env: env_push(checker.env) };
  let made = vars.fold(
    { checker: pushed, effects: no_effects(), vars: [], nodes: [] },
    |acc: HandlerVariables, v: HandlerVar| {
      let written: { checker: Checker, ty: Option<Type> } = match v.ty {
        Some(te) -> {
          let w: WithType = convert_type(acc.checker, te);
          { checker: check_scoped_placement(w.checker, te, w.ty, false), ty: Some(w.ty) }
        },
        None -> { checker: acc.checker, ty: None },
      };
      let o: Inference = infer(written.checker, v.init, match written.ty {
        Some(t) -> hint_of(t),
        None -> None,
      });
      let ty = match written.ty { Some(t) -> t, None -> o.ty };
      let checked: Checker = match written.ty {
        Some(t) ->
          expect(
            o.checker,
            expression_span(v.init),
            t,
            o.ty,
            b"the variable's written type",
          ).checker,
        None -> o.checker,
      };
      let j: WithEffects = join(checked, v.span, acc.effects, o.effects);
      let once: Checker = match acc.vars.filter(|x: { name: Identifier, ty: Type }|
          x.name.name == v.name.name) {
        [first, ..] ->
          duplicate(j.checker, v.name, location_of(j.checker, first.name.span), b"variable"),
        [] -> j.checker,
      };
      {
        checker: { ..once, env: env_bind(once.env, v.name, monomorphic(ty)) },
        effects: j.effects,
        vars: acc.vars.push({ name: v.name, ty: ty }),
        nodes: acc.nodes.push(
          handler_var_of(v.name.name, ty, typed_at(o, expression_span(v.init)), v.span),
        ),
      }
    },
  );
  { ..made, checker: { ..made.checker, env: env_pop(made.checker.env) } }
}

fn with_handler_variables(
  checker: Checker,
  vars: List<{ name: Identifier, ty: Type }>,
  barred: Option<Bytes>,
) -> Checker / {abort.raise} = {
  let pushed: Checker = { ..checker, env: env_push(checker.env) };
  let bound = vars.fold(
    { checker: pushed, vars: [] },
    |acc: { checker: Checker, vars: List<HandlerVariable> }, v: { name: Identifier, ty: Type }|
      {
        checker: { ..acc.checker, env: env_bind(acc.checker.env, v.name, monomorphic(v.ty)) },
        vars: acc.vars.push({ binder: v.name.span.site, name: v.name.name, ty: v.ty }),
      },
  );
  {
    ..bound.checker,
    assignable: {
      vars: bound.vars,
      assignment_forbidden_in: barred,
      frame: env_depth(checker.env),
    },
  }
}

fn infer_handle(
  checker: Checker,
  span: Span,
  body: Expression,
  clauses: List<HandleClause>,
  ret: Option<ReturnClause>,
  vars: List<HandlerVar>,
  hint: Option<Hint>,
) -> Inference / {abort.raise} = {
  let made: HandlerVariables = infer_handler_variables(checker, vars);
  let around: Assignable = checker.assignable;
  let mark = made.checker.performs.len();
  let b: Inference = restore_assignable(
    made.checker,
    infer(
      forbid_assignment(made.checker, b"the body of a `handle` inside the clause"),
      body,
      match ret { Some(_) -> None, None -> hint },
    ),
  );
  let spawned = { before: spawn_counts(made.checker), after: spawn_counts(b.checker) };
  let general = clauses.fold(false, |acc: Bool, c: HandleClause|
    acc || (match c.resume { Some(_) -> true, None -> false }));
  let escapes = clauses.fold(general, |acc: Bool, c: HandleClause|
    acc || handles_raise(checker, c));
  let cont: { checker: Checker, v: Option<Int> } = if general {
    let o: WithVar = new_effect_variable(b.checker);
    { checker: o.checker, v: Some(o.var) }
  } else { { checker: b.checker, v: None } };
  let result_var: { checker: Checker, t: Option<Type> } = if !escapes {
    { checker: cont.checker, t: None }
  } else {
    match ret {
      None -> { checker: cont.checker, t: Some(b.ty) },
      Some(_) -> {
        let o: WithType = new_type(cont.checker);
        { checker: o.checker, t: Some(o.ty) }
      },
    }
  };
  let walked: HandleClauses = clauses.fold(
    {
      checker: result_var.checker,
      handled: [],
      selected: [],
      clause_effects: no_effects(),
      around: [],
      clauses: [],
    },
    |acc: HandleClauses, clause: HandleClause| {
      let r: WithOperation = resolve_op(acc.checker, clause.effect_name, clause.op);
      match r.hit {
        None -> { ..acc, checker: r.checker, clauses: acc.clauses.push(None) },
        Some(hit) -> {
          let res: WithResource = clause_resource_for(
            r.checker,
            hit.info,
            hit.op,
            clause,
            clause.span,
          );
          match res.resource {
            None -> { ..acc, checker: res.checker, clauses: acc.clauses.push(None) },
            Some(resource_) -> {
              let shape: OperationType = instantiate_op_for_clause(
                marshalling_rejected(res.checker, hit.info, hit.op, clause.span),
                hit.info,
                hit.op,
              );
              if shape.params.len() != clause.params.len() {
                let bound = clause.params.len();
                {
                  ..acc,
                  clauses: acc.clauses.push(None),
                  checker: report_error_at_and(
                    shape.checker,
                    b"E0202",
                    clause.span,
                    Bytes::concat_all([
                      b"the clause for `",
                      hit.info.name,
                      b".",
                      hit.op.name,
                      b"` binds ",
                      ascii_of_int(bound),
                      b" parameter",
                      plural(bound),
                      b", but the operation takes ",
                      ascii_of_int(shape.params.len()),
                    ]),
                    Bytes::concat_all([
                      b"expected ",
                      ascii_of_int(shape.params.len()),
                      b" parameters",
                    ]),
                    hit.op.at,
                    b"declared here",
                    [],
                  ),
                }
              } else {
                let entry = {
                  effect: hit.info.name,
                  resource: resource_,
                  mode: hit.op.mode,
                  op: None,
                };
                let key = { effect: hit.info.name, op: hit.op.name, resource: resource_ };
                let dup = acc.selected.fold(false, |d: Bool, k: OpKey| d || k == key);
                let c0: Checker = if dup {
                  let res_text = match clause.resource {
                    Some(r) -> Bytes::concat_all([b"[", r.name, b"]"]),
                    None -> b"",
                  };
                  report(shape.checker, {
                    code: b"E0105",
                    notes: 1,
                    labels: [
                      label_at(
                        shape.checker.module,
                        clause.span,
                        true,
                        b"this clause is unreachable",
                      ),
                    ],
                    text: b"",
                    message: Bytes::concat_all([
                      b"`",
                      hit.info.name,
                      b".",
                      hit.op.name,
                      res_text,
                      b"` is handled more than once",
                    ]),
                    notes_text: [b"the first matching clause wins at run time"],
                    severity: b"warning",
                    fixes: [],
                  })
                } else { shape.checker };
                let raise = is_raise(hit.op.mode);
                let whole = raise || (match clause.resume { Some(_) -> true, None -> false });
                let result = match result_var.t { Some(t) -> t, None -> shape.ret };
                let resumed = match cont.v { Some(v) -> open_effects(v), None -> no_effects() };
                let continuation = owning_fn_type([shape.ret], [], true, result, resumed);
                let closed = fn_type(
                  shape.params.concat(match clause.label_binder {
                    Some(_) -> [string_type()],
                    None -> [],
                  }).concat(match clause.resume { Some(_) -> [continuation], None -> [] }),
                  if whole { result } else { shape.ret },
                  no_effects(),
                );
                let pushed: Checker = with_handler_variables(c0, made.vars, None);
                let bound: Checker = range(0, clause.params.len()).fold(
                  pushed,
                  |c: Checker, i: Int| {
                    let at = clause.params.get(i).span;
                    {
                      ..c,
                      env: env_bind(c.env, clause.params.get(i), monomorphic(shape.params.get(i))),
                    }
                  },
                );
                let with_label: Checker = match clause.label_binder {
                  Some(t) -> { ..bound, env: env_bind(bound.env, t, monomorphic(string_type())) },
                  None -> bound,
                };
                let raised = Bytes::concat_all([
                  b"`",
                  as_written(with_label, hit.info.name),
                  b".",
                  hit.op.name,
                  b"`",
                ]);
                let with_resume: Checker = match clause.resume {
                  Some(k) -> {
                    let bound_k: Checker = {
                      ..with_label,
                      env: env_bind(with_label.env, k, monomorphic(continuation)),
                    };
                    if !raise { bound_k } else {
                      report_error_at(
                        bound_k,
                        b"E0201",
                        k.span,
                        Bytes::concat_all([b"a clause for ", raised, b" cannot bind `resume`"]),
                        b"a raise does not come back to be resumed",
                        [b"drop `resume`: the clause's value is the `handle`'s"],
                      )
                    }
                  },
                  None -> with_label,
                };
                let result = if !whole { hint_of(shape.ret) }
                else { match ret { Some(_) -> hint, None -> hint_after(hint, b.ty) } };
                let ordered: Checker = {
                  ..with_resume,
                  assumed: clause_ordered(hit.op, shape).fold(
                    with_resume.assumed,
                    |xs: List<Assumption>, v: Int| assume(xs, OrdDeriver, v),
                  ),
                };
                let body_: Inference = infer(ordered, clause.body, result);
                let popped: Checker = {
                  ..body_.checker,
                  env: env_pop(body_.checker.env),
                  assignable: around,
                  assumed: with_resume.assumed,
                };
                let checked: Checker = match clause.resume {
                  Some(_) ->
                    expect(
                      popped,
                      expression_span(clause.body),
                      match result_var.t { Some(t) -> t, None -> shape.ret },
                      body_.ty,
                      b"a clause that binds a continuation returns the `handle`'s result",
                    ).checker,
                  None -> if raise {
                    expect(
                      popped,
                      expression_span(clause.body),
                      match result_var.t { Some(t) -> t, None -> shape.ret },
                      body_.ty,
                      Bytes::concat_all([
                        b"a clause for ",
                        raised,
                        b" handles it for the whole `handle`",
                      ]),
                    ).checker
                  } else {
                    let x: ExpectResult = expect(
                      popped,
                      expression_span(clause.body),
                      shape.ret,
                      body_.ty,
                      b"a handler clause returns the operation's result",
                    );
                    if !x.ok && !is_shipped_effect(hit.info)
                        && op_free_variables(hit.op).len() > 0 {
                      note_universal_clause(x.checker, hit.info, hit.op)
                    } else { x.checker }
                  },
                };
                let j: WithEffects = join(checked, span, acc.clause_effects, body_.effects);
                {
                  checker: j.checker,
                  handled: if raise { acc.handled } else { effects_insert(acc.handled, entry) },
                  selected: acc.selected.push(key),
                  clauses: acc.clauses.push(
                    clause_of(
                      {
                        effect: hit.info.name,
                        op: hit.op.name,
                        resource: match clause.resource { Some(r) -> Some(r.name), None -> None },
                        every_label: clause.wildcard_label,
                      },
                      params_typed(
                        clause.params.map(|i: Identifier| { name: i.name, span: i.span }),
                        shape.params,
                      ),
                      match clause.label_binder {
                        Some(t) -> Some({ name: t.name, ty: string_type(), span: t.span }),
                        None -> None,
                      },
                      match clause.resume {
                        Some(k) -> Some({ name: k.name, ty: continuation, span: k.span }),
                        None -> None,
                      },
                      typed_at(body_, expression_span(clause.body)),
                      body_.effects,
                      resumed,
                      clause.span,
                    ),
                  ),
                  clause_effects: j.effects,
                  around: acc.around.push({
                    span: clause.span,
                    op: { ..entry, op: Some(hit.op.name) },
                    ty: fn_type(shape.params, shape.ret, body_.effects),
                  }),
                }
              }
            },
          }
        },
      }
    },
  );
  let body_mark = b.checker.performs.len();
  let under: Checker = spawned_under(walked.checker, spawned.before, spawned.after, walked.around);
  let returned = match ret {
    Some(rc) -> {
      let pushed: Checker = with_handler_variables(under, made.vars, Some(b"the `return` clause"));
      let bound: Checker = { ..pushed, env: env_bind(pushed.env, rc.binder, monomorphic(b.ty)) };
      let o: Inference = infer(bound, rc.body, hint);
      {
        checker: { ..o.checker, env: env_pop(o.checker.env), assignable: around },
        ty: o.ty,
        effects: o.effects,
        clause: Some(
          return_of(
            { name: rc.binder.name, ty: b.ty, span: rc.binder.span },
            typed_at(o, expression_span(rc.body)),
            o.effects,
            rc.span,
          ),
        ),
      }
    },
    None -> { checker: under, ty: b.ty, effects: no_effects(), clause: None },
  };
  let agreed: Checker = match result_var.t {
    Some(t) ->
      expect(
        returned.checker,
        span,
        t,
        returned.ty,
        b"every clause of a `handle` produces its result",
      ).checker,
    None -> returned.checker,
  };
  let widened_to_depth = opened_to_clauses(
    agreed,
    b.effects,
    walked.around.map(|c: ClauseSite| c.op),
  );
  let body_effects = resolve_effects_in(widened_to_depth, b.effects);
  let remaining = body_effects.listed.filter(|a: Effect|
    !clause_discharges(widened_to_depth, walked.handled, walked.selected, a));
  let missing = remaining.filter(|a: Effect|
    effects_cover(walked.handled, a) && !effects_cover(widened_to_depth.declared_effects, a));
  let sites = resolved_sites(
    widened_to_depth.substitution,
    widened_to_depth.performs.drop(mark).take(body_mark - mark),
  );
  let after = clauses.fold(span.start, |acc: Int, cl: HandleClause|
    max(acc, expression_span(cl.body).end));
  let judged: Checker = if missing.len() == 0 { widened_to_depth } else {
    report_incomplete_handling(
      widened_to_depth,
      span,
      after,
      sites,
      walked.handled,
      walked.selected,
      missing,
    )
  };
  let kept = effects_difference(remaining, missing);
  let discharged: Checker = discharge(
    judged,
    mark,
    body_mark,
    effects_difference(body_effects.listed, kept),
  );
  let j1: WithEffects = join(
    discharged,
    span,
    { listed: kept, variable: body_effects.variable },
    walked.clause_effects,
  );
  let j2: WithEffects = join(j1.checker, span, j1.effects, returned.effects);
  let solved = match cont.v {
    Some(v) ->
      {
        ..j2.checker,
        substitution: solve_continuation_effects(j2.checker.substitution, v, j2.effects),
      },
    None -> j2.checker,
  };
  let j3: WithEffects = join(solved, span, j2.effects, made.effects);
  let typed = j3.checker;
  {
    checker: typed,
    ty: returned.ty,
    effects: j3.effects,
    node: handle_of(
      typed_at(b, expression_span(body)),
      b.effects,
      walked.clauses,
      returned.clause,
      made.nodes,
    ),
  }
}

fn named_raise(checker: Checker, name: RaiseName) -> WithOperation / {abort.raise} = {
  let r: WithOperation = resolve_op(checker, name.effect_name, name.op);
  match r.hit {
    None -> r,
    Some(hit) -> if is_raise(hit.op.mode) { r } else {
      {
        checker: report_error_at_and(
          r.checker,
          b"E0313",
          span_to(name.effect_name.span, name.op.span),
          Bytes::concat_all([
            b"`",
            qualified_name_text(name.effect_name),
            b".",
            name.op.name,
            b"` is not a `raise` operation",
          ]),
          b"a `try` handles a raise",
          hit.op.at,
          Bytes::concat_all([b"declared `", mode_text(hit.op.mode), b"` here"]),
          [
            b"a `read` or `write` operation comes back to where it was performed, so there is nothing for a `try` to turn into an `Err`: handle it with a `handle` clause",
          ],
        ),
        hit: None,
      }
    },
  }
}

fn one_raise(checker: Checker, span: Span, effects: Effects) -> WithOperation / {abort.raise} = {
  let raises = effects.listed.filter(try_handles);
  let found = |a: Effect|
    match effect_of(checker, a.effect) {
      None -> None,
      Some(info) -> match a.op {
        None -> None,
        Some(op) -> match op_named(info, op) {
          Some(o) -> Some({ info: info, op: o }),
          None -> None,
        },
      },
    };
  match raises {
    [one] -> { checker: checker, hit: found(one) },
    [] -> {
      let aborts = effects.listed.contains(abort_effect());
      let notes = List::concat(
        if aborts {
          [
            b"what can fail on a value raises `abort.raise`, so a `try` handles it only by name: `try[abort.raise] { .. }`",
          ]
        } else { [] },
        match effects.variable {
          Some(_) ->
            [
              b"what an effect variable carries is the caller's to handle, so it passes through: to handle a raise here, name it in the effects the body is given",
            ],
          None -> [],
        },
      );
      {
        checker: report_error_at(
          checker,
          b"E0311",
          span,
          b"this `try` has no raise to handle",
          b"its body names no `raise` operation",
          if notes.len() == 0 { [b"drop the `try`, or raise in its body"] } else { notes },
        ),
        hit: None,
      }
    },
    _ -> {
      let names = raises.map(|a: Effect| backticked_text(written_effect_text(checker, a)));
      let d = error_with_labels(
        b"E0312",
        Bytes::concat_all([
          b"this `try` could handle ",
          Bytes::join(names.take(names.len() - 1), b", "),
          b" or ",
          names.get(names.len() - 1),
        ]),
        [
          label_at(
            checker.module,
            span,
            true,
            Bytes::concat_all([
              b"its body names ",
              ascii_of_int(raises.len()),
              b" `raise` operations",
            ]),
          ),
        ],
        [b"name the one to answer, `try[effect.op] { .. }`; the others pass through"],
      );
      let fixed = raises.fold(d, |acc: Diagnostic, a: Effect|
        match written_as(checker, a.effect) {
          None -> acc,
          Some(_) -> {
            let written = written_effect_text(checker, a);
            with_fix(acc, b"handle ".concat(backticked_text(written)), [
              insertion(checker.module, span.start + 3, Bytes::concat_all([b"[", written, b"]"])),
            ])
          },
        });
      { checker: report(checker, fixed), hit: None }
    },
  }
}

fn reject_passed_raise(
  checker: Checker,
  span: Span,
  effects: Effects,
  entry: Effect,
) -> Checker / {abort.raise} =
  match effects.variable {
    Some(v) -> if effects_cover(effects.listed, entry)
        || !is_rigid_effects(checker.substitution, v) { checker } else {
      let written = written_effect_text(checker, entry);
      report_error_at(
        checker,
        b"E0311",
        span,
        Bytes::concat_all([b"this `try` handles `", written, b"`, which its body does not raise"]),
        b"what its body's effect variable carries is the caller's to handle",
        [
          Bytes::concat_all([
            b"to handle it here, name it in the effects the body is given: `/ {",
            written,
            b" | e}`",
          ]),
        ],
      )
    },
    None -> checker,
  }

fn try_handles(a: Effect) -> Bool =
  is_raise(a.mode) && a != abort_effect() && !is_exit_effect(a.effect)

fn parameters_as_type(params: List<Type>) -> Type / {abort.raise} =
  match params {
    [] -> unit_type(),
    [one] -> one,
    _ ->
      RecordType(
        fields_sorted(
          range(0, params.len()).map(|i: Int|
            { name: b"_".concat(ascii_of_int(i)), ty: params.get(i) }),
        ),
      ),
  }

fn infer_try_block(
  checker: Checker,
  span: Span,
  raise: Option<RaiseName>,
  body: Expression,
  hint: Option<Hint>,
) -> Inference / {abort.raise} = {
  let mark = checker.performs.len();
  let result = match hint_type(checker, hint) {
    Some(h) -> match result_parts(h) {
      Some(p) -> Some({ ty: p.ok, met: equations_of(hint) }),
      None -> None,
    },
    None -> None,
  };
  let b: Inference = infer(checker, body, result);
  let body_mark = b.checker.performs.len();
  let body_effects = resolve_effects_in(b.checker, b.effects);
  let chosen: WithOperation = match raise {
    Some(name) -> named_raise(b.checker, name),
    None -> one_raise(b.checker, span, body_effects),
  };
  match chosen.hit {
    None -> {
      let o: WithType = new_type(chosen.checker);
      let might = match raise { Some(_) -> [], None -> body_effects.listed.filter(try_handles) };
      {
        checker: discharge(o.checker, mark, body_mark, might),
        ty: result_type(b.ty, o.ty),
        effects: {
          listed: effects_difference(body_effects.listed, might),
          variable: body_effects.variable,
        },
        node: None,
      }
    },
    Some(hit) -> {
      let entry = {
        effect: hit.info.name,
        resource: SingletonResource,
        mode: hit.op.mode,
        op: Some(hit.op.name),
      };
      let widened_to_depth = opened_to_clauses(chosen.checker, b.effects, [entry]);
      let returned_effects = resolve_effects_in(widened_to_depth, b.effects);
      let c: Checker = reject_passed_raise(widened_to_depth, span, returned_effects, entry);
      let carried = parameters_as_type(hit.op.params);
      let result = result_type(b.ty, carried);
      {
        checker: discharge(c, mark, body_mark, [entry]),
        ty: result,
        effects: {
          listed: returned_effects.listed.filter(|a: Effect| a != entry),
          variable: returned_effects.variable,
        },
        node: try_block_node(
          c,
          span,
          typed_at(b, expression_span(body)),
          b.effects,
          { effect: hit.info.name, op: hit.op.name, params: hit.op.params },
          carried,
          result,
        ),
      }
    },
  }
}

fn try_block_node(
  checker: Checker,
  span: Span,
  body: Option<WalkedExpression>,
  body_effects: Effects,
  raised: { effect: Bytes, op: Bytes, params: List<Type> },
  carried: Type,
  result: Type,
) -> Option<WalkedNode> =
  match ((body, constructor_of(checker, b"Ok"), constructor_of(checker, b"Err"))) {
    (Some(value), Some(ok), Some(err)) -> {
      let at = try_spans(span);
      let raised_at = |i: Int| synthetic_span(span, role_try_raised(i));
      let value_at = synthetic_span(span, role_try_value_binder());
      let read = |name: Bytes, binder: Span, ty: Type, place: Span|
        { node: WalkedRead(WalkedLocal({ name: name, binder: binder.site })), span: place, ty: ty };
      let returned = |c: ConstructorInfo, of: Type, arg: WalkedExpression, call: Span, callee: Span|
        {
          node: WalkedCall({
            callee: {
              node: WalkedRead(
                WalkedConstructor({
                  sum: c.type_name,
                  name: c.name,
                  case: c.index,
                  args: [value.ty, carried],
                }),
              ),
              span: callee,
              ty: fn_type([of], result, no_effects()),
            },
            args: [arg],
            effects: no_effects(),
          }),
          span: call,
          ty: result,
        };
      let binders = range(0, raised.params.len()).map(|i: Int|
        { name: b"?r".concat(ascii_of_int(i)), span: raised_at(i) });
      let reads = range(0, raised.params.len()).fold([], |acc: List<WalkedExpression>, i: Int|
        match raised.params.at(i) {
          Some(t) ->
            acc.push(
              read(
                b"?r".concat(ascii_of_int(i)),
                raised_at(i),
                t,
                synthetic_span(span, role_try_arg(i)),
              ),
            ),
          None -> acc,
        });
      let carried_value: WalkedExpression = match reads {
        [] ->
          {
            node: WalkedLiteral(LiteralUnit),
            span: synthetic_span(span, role_try_unit()),
            ty: unit_type(),
          },
        [one] -> one,
        _ ->
          {
            node: WalkedRecord(
              range(0, reads.len()).fold([], |acc: List<WalkedField>, i: Int|
                match reads.at(i) {
                  Some(x) -> acc.push({ name: b"_".concat(ascii_of_int(i)), value: x }),
                  None -> acc,
                }),
            ),
            span: at.arguments_record,
            ty: carried,
          },
      };
      match params_typed(binders, raised.params) {
        None -> None,
        Some(params) ->
          Some(
            WalkedHandle({
              body: value,
              effects: body_effects,
              clauses: [
                {
                  effect: raised.effect,
                  op: raised.op,
                  resource: None,
                  every_label: false,
                  params: params,
                  label: None,
                  continuation: None,
                  body: returned(
                    err,
                    carried,
                    carried_value,
                    synthetic_span(span, role_try_err_call()),
                    at.err,
                  ),
                  effects: no_effects(),
                  continuation_effects: no_effects(),
                  span: at.clause,
                },
              ],
              ret: Some({
                binder: { name: b"?v", ty: value.ty, span: value_at },
                body: returned(
                  ok,
                  value.ty,
                  read(b"?v", value_at, value.ty, synthetic_span(span, role_try_value())),
                  synthetic_span(span, role_try_ok_call()),
                  at.ok,
                ),
                effects: no_effects(),
                span: at.early_return,
              }),
              vars: [],
            }),
          ),
      }
    },
    _ -> None,
  }

fn perform_site_label(checker: Checker, site: PerformSite) -> Bytes / {abort.raise} = {
  let a = backticked_text(written_effect_text(checker, site.entry));
  match site.source {
    DirectPerform -> b"performs ".concat(a),
    PerformViaCall(name) ->
      Bytes::concat_all([b"reaches ", a, b" through ", backticked_text(simple_name_of(name))]),
    PerformViaFunctionValue -> Bytes::concat_all([b"reaches ", a, b" through a function value"]),
    PerformViaArguments -> b"reaches ".concat(a),
  }
}

fn report_incomplete_handling(
  checker: Checker,
  span: Span,
  after: Int,
  sites: List<PerformSite>,
  handled: List<Effect>,
  keys: List<OpKey>,
  missing: List<Effect>,
) -> Checker / {abort.raise} = {
  let names = missing.map(|a: Effect| backticked_text(written_effect_text(checker, a)));
  let listed = if names.len() == 1 { names.get(0) } else {
    Bytes::concat_all([
      Bytes::join(names.take(names.len() - 1), b", "),
      b" and ",
      names.get(names.len() - 1),
    ])
  };
  let labels = missing.fold([], |acc: List<Label>, a: Effect|
    match site_among(sites, a) {
      Some(s) -> acc.push(label_at(s.module, s.span, true, perform_site_label(checker, s))),
      None -> acc,
    });
  let notes = missing.fold([], |acc: List<Bytes>, a: Effect|
    match a.op {
      Some(_) -> acc,
      None -> {
        let through = match site_among(sites, a) {
          Some(s) -> match s.source {
            PerformViaCall(name) -> backticked_text(simple_name_of(name)),
            PerformViaFunctionValue -> b"a function value",
            _ -> b"the body",
          },
          None -> b"the body",
        };
        acc.push(
          Bytes::concat_all([
            through,
            b" may perform any `",
            mode_text(a.mode),
            b"` operation of `",
            as_written(checker, a.effect),
            b"`; a clause for each of them discharges ",
            backticked_text(written_effect_text(checker, a)),
          ]),
        )
      },
    });
  let handled_text = Bytes::join(handled.map(|a: Effect| backticked_text(effect_text(a))), b", ");
  let d = error_with_labels(
    b"E0305",
    Bytes::concat_all([b"this `handle` has no clause for ", listed, b", which its body performs"]),
    labels.push(
      label_at(
        checker.module,
        span,
        false,
        Bytes::concat_all([
          b"handles ",
          handled_text,
          b" here, so the operation would run past it",
        ]),
      ),
    ),
    notes,
  );
  let wanted = missing.fold([], |acc: List<Effect>, a: Effect|
    match a.op {
      Some(_) -> acc.push(a),
      None -> acc.concat(mode_ops(checker, a).filter(|o: Effect| !key_named(keys, o))),
    });
  let fixed = wanted.fold(d, |acc: Diagnostic, a: Effect|
    with_fix(
      acc,
      Bytes::concat_all([b"add a clause for ", backticked_text(written_effect_text(checker, a))]),
      [insertion(checker.module, after, b", ".concat(clause_for(checker, a)))],
    ));
  report(checker, fixed)
}

fn clause_for(checker: Checker, entry: Effect) -> Bytes / {abort.raise} = {
  let written = written_effect_text(checker, entry);
  let params = match effect_of(checker, entry.effect) {
    Some(info) -> match entry.op {
      Some(op) -> match op_named(info, op) { Some(o) -> o.params.len(), None -> 0 },
      None -> 0,
    },
    None -> 0,
  };
  Bytes::concat_all([
    written,
    b"(",
    Bytes::join(range(0, params).map(|i: Int| b"a".concat(ascii_of_int(i))), b", "),
    b") -> panic(\"",
    written,
    b" is not handled here\")",
  ])
}

fn note_universal_clause(
  checker: Checker,
  info: EffectInfo,
  op_info: OpInfo,
) -> Checker / {abort.raise} = {
  let n = checker.diagnostics.len();
  if n == 0 { checker } else {
    let last: Diagnostic = checker.diagnostics.get(n - 1);
    let notes = [
      Bytes::concat_all([
        b"`",
        as_written(checker, info.name),
        b".",
        op_info.name,
        b"` is declared with a type variable, so a clause for it has to return every type a perform site could ask for",
      ]),
      b"effects carry no types, so the `handle` cannot see which type a perform site picked \xe2\x80\x94 returning a concrete one would be a value of a type the caller never asked for",
      b"declare the operation at the type it actually returns, or produce the result from one of the clause's own parameters",
    ];
    {
      ..checker,
      diagnostics: checker.diagnostics.set(n - 1, {
        code: last.code,
        notes: last.notes + 3,
        labels: last.labels.push(
          label_at(op_info.at.module, op_info.at.span, false, b"declared here"),
        ),
        text: last.text,
        message: last.message,
        notes_text: last.notes_text.concat(notes),
        severity: last.severity,
        fixes: last.fixes,
      }),
    }
  }
}

fn reject_reopened_scope(checker: Checker, resource: Identifier, outer: OpenScope) -> Checker =
  report_error_with_labels(
    checker,
    b"E0330",
    Bytes::concat_all([
      b"`with_scope[",
      resource.name,
      b"]` opens a scope named `",
      resource.name,
      b"` inside one of that name",
    ]),
    [
      label_at(checker.module, resource.span, true, b"this name is already a scope's"),
      label_at(
        checker.module,
        outer.span,
        false,
        Bytes::concat_all([b"`", resource.name, b"` opens here and is still open"]),
      ),
    ],
    [
      b"a scoped value is released at the `}` of the `with_scope` that made it, so the scope that brands it has to be that one and no other",
      b"give this scope a name no scope around it has",
    ],
  )

fn scope_label(checker: Checker, name: Bytes) -> Bytes =
  Bytes::concat_all([name, label_scope_separator(), checker.current_definition])

fn open_scope(checker: Checker, name: Bytes, label: Bytes, span: Span) -> Checker =
  {
    ..checker,
    open_scopes: checker.open_scopes.push({
      name: name,
      label: label,
      span: span,
      simulate_depth: checker.simulate_depth,
      spawns: [],
      handoffs: [],
    }),
  }

type ClosedScope = { checker: Checker, spawns: List<SpawnSite>, handoffs: List<HandoffSite> }

fn close_scope(checker: Checker) -> ClosedScope / {abort.raise} = {
  let n = checker.open_scopes.len();
  let last = checker.open_scopes.get(n - 1);
  {
    checker: { ..checker, open_scopes: checker.open_scopes.take(n - 1) },
    spawns: last.spawns,
    handoffs: last.handoffs,
  }
}

fn spawn_sites_of(args: List<Expression>, types: List<Type>) -> List<SpawnSite> / {abort.raise} =
  range(0, args.len()).map(|i: Int|
    { span: expression_span(args.get(i)), ty: types.get(i), enclosing_clauses: [] })

fn spawned_under(
  checker: Checker,
  before: List<Int>,
  after: List<Int>,
  clauses: List<ClauseSite>,
) -> Checker / {abort.raise} =
  if clauses.len() == 0 || before == after { checker } else {
    {
      ..checker,
      open_scopes: range(0, checker.open_scopes.len()).map(|i: Int| {
        let r = checker.open_scopes.get(i);
        {
          ..r,
          spawns: range(0, r.spawns.len()).map(|j: Int| {
            let s = r.spawns.get(j);
            if j >= before.get(i) && j < after.get(i) {
              { ..s, enclosing_clauses: s.enclosing_clauses.concat(clauses) }
            } else { s }
          }),
        }
      }),
    }
  }

fn note_spawn(
  checker: Checker,
  info: EffectInfo,
  op_info: OpInfo,
  args: List<Expression>,
  types: List<Type>,
) -> Checker / {abort.raise} =
  if info.name != b"task" || op_info.name != b"spawn" { checker } else {
    {
      ..checker,
      open_scopes: checker.open_scopes.map(|region: OpenScope|
        if region.simulate_depth < checker.simulate_depth { region }
        else { { ..region, spawns: region.spawns.concat(spawn_sites_of(args, types)) } }),
    }
  }

fn note_handoff(
  checker: Checker,
  info: EffectInfo,
  op_info: OpInfo,
  args: List<Expression>,
  types: List<Type>,
) -> Checker / {abort.raise} =
  if info.name == b"task" || checker.open_scopes.len() == 0 { checker } else {
    let name = Bytes::concat_all([info.simple_name, b".", op_info.name]);
    let sites = range(0, args.len()).map(|i: Int|
      { span: expression_span(args.get(i)), ty: types.get(i), op: name });
    {
      ..checker,
      open_scopes: checker.open_scopes.map(|region: OpenScope|
        { ..region, handoffs: region.handoffs.concat(sites) }),
    }
  }

fn scope_exits(expression: Expression, out: List<Span>) -> List<Span> =
  match expression {
    BlockExpression(b) -> match b.tail { Some(t) -> scope_exits(t, out), None -> out },
    IfExpression(i) -> scope_exits(i.else_branch, scope_exits(i.then_branch, out)),
    MatchExpression(m) ->
      m.arms.fold(out, |acc: List<Span>, arm: MatchArm| scope_exits(arm.body, acc)),
    WithScopeExpression(c) -> scope_exits(c.body, out),
    SimulateExpression(s) -> scope_exits(s.body, out),
    HandleExpression(h) -> {
      let through = match h.ret {
        Some(rc) -> scope_exits(rc.body, out),
        None -> scope_exits(h.body, out),
      };
      h.clauses.fold(through, |acc: List<Span>, c: HandleClause|
        match c.resume { Some(_) -> scope_exits(c.body, acc), None -> acc })
    },
    _ -> out.push(expression_span(expression)),
  }

fn infer_with_scope(
  checker: Checker,
  span: Span,
  resource: Identifier,
  acquire: Expression,
  release: Expression,
  binder: Identifier,
  body: Expression,
  hint: Option<Hint>,
) -> Inference / {abort.raise} = {
  let a: Inference = infer(checker, acquire);
  let r: Inference = infer(a.checker, release);
  let eff: WithEffects = new_effects(r.checker);
  let typed: Checker = expect(
    eff.checker,
    expression_span(release),
    fn_type([a.ty], unit_type(), eff.effects),
    r.ty,
    b"function that releases what the scope acquired",
  ).checker;
  let let_go = resolve_effects_in(typed, eff.effects);
  let source = callee_source(typed, release);
  let performed: Checker = let_go.listed.fold(typed, |c: Checker, entry: Effect|
    record_perform(c, entry, expression_span(release), source));
  let before: WithEffects = join(performed, span, a.effects, r.effects);
  let entering: WithEffects = join(before.checker, span, before.effects, let_go);
  let label = scope_label(entering.checker, resource.name);
  let hold_type = scoped_type(label_type(label), a.ty);
  match open_scope_named(entering.checker, resource.name) {
    Some(around) -> {
      let rejected: Checker = reject_reopened_scope(entering.checker, resource, around);
      let b: Inference = infer(
        { ..rejected, env: env_bind(env_push(rejected.env), binder, monomorphic(hold_type)) },
        body,
        hint,
      );
      let j: WithEffects = join(
        { ..b.checker, env: env_pop(b.checker.env) },
        span,
        entering.effects,
        b.effects,
      );
      {
        checker: j.checker,
        ty: b.ty,
        effects: j.effects,
        node: scoped_node(
          span,
          {
            acquire: typed_at(a, expression_span(acquire)),
            release: typed_at(r, expression_span(release)),
          },
          {
            name: binder.name,
            span: synthetic_span_at(binder.span, span, role_scope_body_param()),
          },
          typed_at(b, expression_span(body)),
          { held: a.ty, pending_key_token: hold_type, result: b.ty },
          { acquired: a.effects, released: entering.effects, body: b.effects, all: j.effects },
        ),
      }
    },
    None -> {
      let widened_to_depth: Checker = open_scope(
        entering.checker,
        resource.name,
        label,
        resource.span,
      );
      let mark = widened_to_depth.performs.len();
      let b: Inference = infer(
        {
          ..widened_to_depth,
          env: env_bind(env_push(widened_to_depth.env), binder, monomorphic(hold_type)),
        },
        body,
        hint,
      );
      let closed: ClosedScope = close_scope({ ..b.checker, env: env_pop(b.checker.env) });
      let handled = [scoped_read(NamedResource(label))];
      let discharged: Checker = discharge(
        closed.checker,
        mark,
        closed.checker.performs.len(),
        handled,
      );
      let site: ScopeSite = {
        module: discharged.module,
        name: resource.name,
        label: label,
        span: resource.span,
        body_span: expression_span(body),
        body_type: b.ty,
        exits: scope_exits(body, []),
        spawns: closed.spawns,
        handoffs: closed.handoffs,
      };
      let recorded: Checker = { ..discharged, scopes: discharged.scopes.push(site) };
      let j: WithEffects = join(
        recorded,
        span,
        entering.effects,
        effects_without_covered(resolve_effects_in(recorded, b.effects), handled),
      );
      {
        checker: j.checker,
        ty: type_after_scope(resolve(j.checker, b.ty), label),
        effects: j.effects,
        node: scoped_node(
          span,
          {
            acquire: typed_at(a, expression_span(acquire)),
            release: typed_at(r, expression_span(release)),
          },
          {
            name: binder.name,
            span: synthetic_span_at(binder.span, span, role_scope_body_param()),
          },
          typed_at(b, expression_span(body)),
          { held: a.ty, pending_key_token: hold_type, result: b.ty },
          { acquired: a.effects, released: entering.effects, body: b.effects, all: j.effects },
        ),
      }
    },
  }
}

fn scoped_node(
  span: Span,
  given: { acquire: Option<WalkedExpression>, release: Option<WalkedExpression> },
  binder: { name: Bytes, span: Span },
  body: Option<WalkedExpression>,
  types: { held: Type, pending_key_token: Type, result: Type },
  effects: { acquired: Effects, released: Effects, body: Effects, all: Effects },
) -> Option<WalkedNode> =
  match ((given.acquire, given.release, body)) {
    (Some(acquire), Some(release), Some(region)) -> {
      let at = |role: Int| synthetic_span(span, role);
      let fn_of = |params: List<Type>, ret: Type| fn_type(params, ret, no_effects());
      let acquire_type = fn_of([], types.held);
      let release_type = fn_of([types.held], unit_type());
      let read = |name: Bytes, binder: Int, ty: Type, place: Span|
        {
          node: WalkedRead(WalkedLocal({ name: name, binder: synthetic_span(span, binder).site })),
          span: place,
          ty: ty,
        };
      let builtin = |name: Bytes, ty: Type, place: Span, filled: List<Effects>|
        {
          node: WalkedRead(WalkedBuiltin({ name: name, args: [], effect_arguments: filled })),
          span: place,
          ty: ty,
        };
      let call = |callee: WalkedExpression, args: List<WalkedExpression>, ret: Type, place: Span, effects: Effects|
        {
          node: WalkedCall({ callee: callee, args: args, effects: effects }),
          span: place,
          ty: ret,
        };
      let lambda = |params: List<TypedParam<Type>>, inner: WalkedExpression, effects: Effects, place: Span|
        {
          node: WalkedLambda({ params: params, kept: [], body: inner, effects: effects }),
          span: place,
          ty: fn_type(params.map(|q: TypedParam<Type>| q.ty), inner.ty, effects),
        };
      let widened_to_depth = lambda(
        [],
        call(
          builtin(
            b"?scope_new",
            fn_of([types.held], types.pending_key_token),
            at(role_scope_new_callee()),
            [],
          ),
          [
            call(
              read(
                b"?acquire",
                role_scope_acquire_binder(),
                acquire_type,
                at(role_scope_acquire_read()),
              ),
              [],
              types.held,
              at(role_scope_acquired()),
              effects.acquired,
            ),
          ],
          types.pending_key_token,
          at(role_scope_new()),
          no_effects(),
        ),
        effects.acquired,
        at(role_scope_open()),
      );
      let closed = lambda(
        [{ name: b"?held", ty: types.pending_key_token, span: at(role_scope_close_param()) }],
        call(
          read(
            b"?release",
            role_scope_release_binder(),
            release_type,
            at(role_scope_release_read()),
          ),
          [
            call(
              builtin(
                b"?scope_take",
                fn_of([types.pending_key_token], types.held),
                at(role_scope_take_callee()),
                [],
              ),
              [
                read(
                  b"?held",
                  role_scope_close_param(),
                  types.pending_key_token,
                  at(role_scope_take_scoped_read()),
                ),
              ],
              types.held,
              at(role_scope_take()),
              no_effects(),
            ),
          ],
          unit_type(),
          at(role_scope_close_call()),
          effects.released,
        ),
        effects.released,
        at(role_scope_close()),
      );
      let ran = lambda(
        [{ name: binder.name, ty: types.pending_key_token, span: binder.span }],
        region,
        effects.body,
        at(role_scope_body()),
      );
      let bound = |name: Bytes, value: WalkedExpression, binder_role: Int, let_role: Int|
        WalkedLet({
          pattern: TypedBinder({ name: name, ty: value.ty, span: at(binder_role) }),
          value: value,
          span: at(let_role),
        });
      Some(
        WalkedBlock({
          statements: [
            bound(
              b"?acquire",
              lambda([], acquire, effects.acquired, at(role_scope_acquire())),
              role_scope_acquire_binder(),
              role_scope_acquire_let(),
            ),
            bound(
              b"?release",
              lambda(
                [{ name: b"?held", ty: types.held, span: at(role_scope_release_param()) }],
                call(
                  release,
                  [
                    read(
                      b"?held",
                      role_scope_release_param(),
                      types.held,
                      at(role_scope_release_scoped_read()),
                    ),
                  ],
                  unit_type(),
                  at(role_scope_release_call()),
                  effects.released,
                ),
                effects.released,
                at(role_scope_release()),
              ),
              role_scope_release_binder(),
              role_scope_release_let(),
            ),
          ],
          tail: Some(
            call(
              builtin(
                b"?hold_bracket",
                fn_of([widened_to_depth.ty, closed.ty, ran.ty], types.result),
                at(role_scope_bracket_callee()),
                [effects.all],
              ),
              [widened_to_depth, closed, ran],
              types.result,
              at(role_scope_bracket()),
              no_effects(),
            ),
          ),
        }),
      )
    },
    _ -> None,
  }

fn task_carriers(checker: Checker) -> List<{ binder: Int, ty: Type }> / {abort.raise} =
  env_locals(checker.env).fold([], |acc: List<{ binder: Int, ty: Type }>, l: InScope| {
    let ty = resolve(checker, l.sc.ty);
    if contains_task(ty) { acc.push({ binder: l.binder, ty: ty }) } else { acc }
  })

fn captured_task_locals(
  xs: List<CapturedLocal>,
  carriers: List<{ binder: Int, ty: Type }>,
) -> List<{ name: Bytes, span: Span, ty: Type }> =
  xs.fold([], |acc: List<CapturedLocal>, x: CapturedLocal|
    if acc.any(|y: CapturedLocal| y.binder == x.binder) { acc } else { acc.push(x) }).fold(
    [],
    |acc: List<{ name: Bytes, span: Span, ty: Type }>, x: CapturedLocal|
      match carriers.find(|c: { binder: Int, ty: Type }| c.binder == x.binder) {
        Some(c) -> acc.push({ name: x.name, span: x.span, ty: c.ty }),
        None -> acc,
      },
  )

fn infer_simulate(
  checker: Checker,
  span: Span,
  body: Expression,
  hint: Option<Hint>,
) -> Inference / {abort.raise} = {
  let mark = checker.performs.len();
  let crossed_at = checker.captured_locals.len();
  let carriers = task_carriers(checker);
  let b: Inference = infer(
    {
      ..checker,
      simulate_depth: checker.simulate_depth + 1,
      simulation_scope: env_depth(checker.env),
    },
    body,
    hint,
  );
  let c: Checker = {
    ..b.checker,
    simulate_depth: b.checker.simulate_depth - 1,
    simulation_scope: checker.simulation_scope,
    captured_locals: b.checker.captured_locals.take(crossed_at),
  };
  let handled = simulated_effects();
  let discharged: Checker = discharge(c, mark, c.performs.len(), handled);
  let noted: Checker = {
    ..discharged,
    simulations: discharged.simulations.push({
      module: discharged.module,
      span: span,
      body_span: expression_span(body),
      body_type: b.ty,
      body_effects: b.effects,
      exits: scope_exits(body, []),
      entering: captured_task_locals(b.checker.captured_locals.drop(crossed_at), carriers),
    }),
  };
  let seed = seed_effect();
  let recorded: Checker = record_perform(noted, seed, span, DirectPerform);
  let j: WithEffects = join(
    recorded,
    span,
    effects_without_covered(resolve_effects_in(recorded, b.effects), handled),
    single_effect(seed),
  );
  {
    checker: j.checker,
    ty: b.ty,
    effects: j.effects,
    node: simulate_of(typed_at(b, expression_span(body)), b.effects),
  }
}

pub fn contains_function(t: Type) -> Bool =
  match t {
    FunctionType(_) -> true,
    NamedType(c) -> c.args.fold(false, |b: Bool, x: Type| b || contains_function(x)),
    RecordType(fs) -> fs.fold(false, |b: Bool, field: Field| b || contains_function(field.ty)),
    NominalType(n) ->
      n.fields.fold(false, |b: Bool, field: Field| b || contains_function(field.ty)),
    VariableType(_) -> false,
  }

pub fn written_effect_text(checker: Checker, entry: Effect) -> Bytes / {abort.raise} =
  if is_diverges(entry) { b"diverges" } else {
    Bytes::concat_all([
      as_written(checker, entry.effect),
      b".",
      match entry.op { Some(op) -> op, None -> mode_text(entry.mode) },
      resource_text(entry.resource),
    ])
  }

pub fn numeric_of(stated: List<NumericInfo>, type_name: Bytes) -> Option<NumericInfo> =
  stated.fold(None, |acc: Option<NumericInfo>, x: NumericInfo|
    match acc { Some(_) -> acc, None -> if x.type_name == type_name { Some(x) } else { None } })

pub fn ordered_parts(
  carrying: Map<Bytes, List<Int>>,
  t: Type,
  out: List<OrderedPart>,
) -> List<OrderedPart> / {abort.raise} = {
  let within = |types: List<Type>|
    types.fold(own_parts(carrying, t, out), |acc: List<OrderedPart>, a: Type|
      ordered_parts(carrying, a, acc));
  match t {
    NamedType(c) -> within(c.args),
    NominalType(n) -> within(n.args),
    RecordType(fs) -> within(fs.map(|f: Field| f.ty)),
    FunctionType(f) -> within(f.params.push(f.ret)),
    VariableType(_) -> out,
  }
}

pub fn ordered_variables(checker: Checker, t: Type) -> List<Int> / {abort.raise} =
  ordered_parts(checker.ordered_parameters, t, []).fold([], |acc: List<Int>, p: OrderedPart|
    ints_union(acc, order_needs(p.key, checker.type_shapes)))

fn note_map_keys(checker: Checker, span: Span, ty: Type) -> Checker / {abort.raise} =
  note_parts(checker, span, ordered_parts(checker.ordered_parameters, ty, []))

fn note_instance(checker: Checker, span: Span, ty: Type) -> Checker / {abort.raise} =
  note_type_constraints_in(
    note_map_key_sites(
      checker,
      span,
      ordered_parts(checker.ordered_parameters, ty, []).fold(
        [],
        |acc: List<OrderedKey>, p: OrderedPart|
          order_needs(p.key, checker.type_shapes).fold(acc, |b: List<OrderedKey>, v: Int|
            b.push({ key: VariableType(v), whole_key: p.key, container: p.container })),
      ),
    ),
    span,
    ty,
  )

pub fn note_type_constraints_in(checker: Checker, span: Span, ty: Type) -> Checker / {abort.raise} =
  if checker.stated.len() == 0 { checker } else {
    let within = |c: Checker, types: List<Type>|
      types.fold(c, |cc: Checker, t: Type| note_type_constraints_in(cc, span, t));
    match ty {
      NamedType(c) -> within(note_type_constraints(checker, span, c.name, c.args), c.args),
      NominalType(n) -> within(note_type_constraints(checker, span, n.name, n.args), n.args),
      RecordType(fs) -> within(checker, fs.map(|f: Field| f.ty)),
      FunctionType(f) -> within(checker, f.params.push(f.ret)),
      VariableType(_) -> checker,
    }
  }

fn note_constraints(
  checker: Checker,
  span: Span,
  callee: Bytes,
  args: List<Type>,
  ty: Type,
) -> Checker / {abort.raise} =
  match checker.constraints.get(callee) {
    None -> checker,
    Some(cs) -> if cs.len() == 0 { checker } else {
      let callee_at = match definition_of(checker, callee) {
        Some(d) -> d.at,
        None -> { module: checker.module, span: span },
      };
      let params = rigid_params(checker);
      let keyed = ordered_variables(checker, ty);
      let sites = cs.fold([], |acc: List<ConstraintSite>, c: DefinitionConstraint|
        if c.param >= args.len()
            || (c.deriver == OrdDeriver
            && (match args.get(c.param) { VariableType(v) -> keyed.contains(v), _ -> false })) {
          acc
        } else {
          acc.push({
            module: checker.module,
            span: span,
            deriver: c.deriver,
            param: c.param,
            ty: args.get(c.param),
            callee: callee,
            callee_at: callee_at,
            assumed: assumed_for(checker, c.deriver),
            params: params,
            called: false,
            owner: checker.current_definition,
            written_on_type: None,
          })
        });
      { ..checker, constrained_uses: checker.constrained_uses.concat(sites) }
    },
  }

fn mark_called(checker: Checker, span: Span) -> Checker / {abort.raise} = {
  let n = checker.constrained_uses.len();
  let marked = iterate(
    { i: n - 1, uses: checker.constrained_uses },
    n + 1,
    |s: { i: Int, uses: List<ConstraintSite> }|
      match s.uses.at(s.i) {
        Some(u) -> if u.module == checker.module && u.span == span {
          Continue({ i: s.i - 1, uses: s.uses.set(s.i, { ..u, called: true }) })
        } else { Stop(s) },
        None -> Stop(s),
      },
  );
  { ..checker, constrained_uses: marked.uses }
}

fn contains_task(t: Type) -> Bool =
  match t {
    NamedType(c) ->
      is_scheduler_handle(c.name) || c.args.fold(false, |b: Bool, a: Type| b || contains_task(a)),
    RecordType(fs) -> fs.fold(false, |b: Bool, field: Field| b || contains_task(field.ty)),
    NominalType(n) -> n.fields.fold(false, |b: Bool, field: Field| b || contains_task(field.ty)),
    FunctionType(_) -> false,
    VariableType(_) -> false,
  }
