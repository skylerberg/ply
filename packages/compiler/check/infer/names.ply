import compiler.syntax.parsing (Span, Identifier, QName, is_bare, qualified_name_text, starts_upper)
import compiler.syntax.items (deriver_text, RequiresClause, CostClause, SpaceClause, member_name,
                              result_name)
import compiler.syntax.expressions (sees_homes, prelude_module)
import compiler.check.types (NamedType, FunctionType, env_lookup, NominalType)
import compiler.check.resolve.tables (Binding, ModuleBinding, Declaration, ModuleEntry, Diagnostic,
                                      Namespace, ValueSpace, TypeSpace, lookup, lookup_declared,
                                      declarations_in, qualify, default_binder, error_at, label_at,
                                      backticked, describe_namespace, find_module_binding)
import compiler.check.resolve.scopes (find, private_name_error, opaque_constructor_error,
                                      locate_type, method_binder, method_binder_module)
import std.bytes
import std.option
import std.string
import std.text (closest)
import compiler.check.infer.checker (Checker, WithName, module_name, scope_of, report,
                                     report_error_at, report_error_with_labels, constructor_of,
                                     ValueKey, LocalKey, GlobalKey)

pub fn global(
  checker: Checker,
  namespace: Namespace,
  qualified_name: QName,
) -> { checker: Checker, name: Option<Bytes> } / {abort.raise} =
  if is_bare(qualified_name) {
    match lookup(scope_of(checker).bound, namespace, qualified_name.name.name) {
      Some(b) -> { checker: checker, name: Some(b.qualified) },
      None -> { checker: checker, name: None },
    }
  } else {
    match find(checker.resolved, checker.module, namespace, qualified_name) {
      Some(b) -> { checker: checker, name: Some(b.qualified) },
      None ->
        {
          checker: match checker.derived {
            Some(_) ->
              unresolved_in_derived(checker, qualified_name, match namespace {
                TypeSpace -> b"type",
                _ -> b"definition",
              }),
            None -> lookup_failure(checker, namespace, qualified_name),
          },
          name: None,
        },
    }
  }

pub fn unresolved_in_derived(
  checker: Checker,
  qualified_name: QName,
  what: Bytes,
) -> Checker / {abort.raise} = report(checker, derived_unresolved(checker, qualified_name, what))

fn derived_unresolved(
  checker: Checker,
  qualified_name: QName,
  what: Bytes,
) -> Diagnostic / {abort.raise} = {
  let d = match checker.derived {
    Some(d) -> d,
    None ->
      panic(
        "this runs only while checking a generated body, but no generated body is being checked",
      ),
  };
  let dv = d.deriver;
  let n = qualified_name_text(qualified_name);
  let exported = if is_bare(qualified_name) {
    exporter(checker, ValueSpace, qualified_name.name.name)
  } else { None };
  error_at(
    b"E0206",
    checker.module,
    qualified_name.span,
    Bytes::concat_all([b"`", dv, b"` cannot be derived for `", d.target, b"`"]),
    Bytes::concat_all([
      b"the generated body needs the ",
      what,
      b" `",
      n,
      b"`, which is not in scope",
    ]),
    match exported {
      Some(i) ->
        [
          Bytes::concat_all([
            b"module `",
            module_name(checker, i),
            b"` exports it: add `import ",
            module_name(checker, i),
            b" (",
            n,
            b")`",
          ]),
        ],
      None ->
        [
          Bytes::concat_all([
            b"a derivation calls the `derive` of each named field type, so every field type needs `derive ",
            dv,
            b" for` in the module that declares it",
          ]),
          Bytes::concat_all([
            b"`",
            n,
            b"` is the function that `derive ",
            dv,
            b" for <that type>` generates",
          ]),
        ],
    },
  )
}

fn lookup_failure(
  checker: Checker,
  namespace: Namespace,
  qualified_name: QName,
) -> Checker / {abort.raise} =
  match qualified_name.module {
    None -> checker,
    Some(binder) -> if namespace == ValueSpace
        && locate_type(checker.resolved, checker.module, binder.name) != None {
      no_function_of(checker, binder.name, qualified_name.name)
    } else {
      let scope = scope_of(checker);
      match scope.modules.fold(
          None,
          |accumulator: Option<Int>, binding: { binder: Bytes, target: Int, span: Span }|
            match accumulator {
              Some(_) -> accumulator,
              None -> if binding.binder == binder.name { Some(binding.target) } else { None },
            },
        ) {
        None -> {
          let selective = scope.selected_modules.fold(
            None,
            |accumulator: Option<{ binder: Bytes, target: Int, span: Span }>, binding: { binder: Bytes, target: Int, span: Span }|
              match accumulator {
                Some(_) -> accumulator,
                None -> if binding.binder == binder.name { Some(binding) } else { None },
              },
          );
          let message = Bytes::concat_all([b"no module is imported as `", binder.name, b"`"]);
          let label = b"not a module imported by this file";
          match selective {
            Some(sel) -> {
              let module = checker.resolved.scopes.get(sel.target).module;
              report_error_with_labels(
                checker,
                b"E0106",
                message,
                [
                  label_at(checker.module, binder.span, true, label),
                  label_at(
                    checker.module,
                    sel.span,
                    false,
                    Bytes::concat_all([b"this import brings in names from `", module, b"`"]),
                  ),
                ],
                [
                  Bytes::concat_all([
                    b"a selective import binds no module name: add `import ",
                    module,
                    b"` as well, or write `",
                    qualified_name.name.name,
                    b"` unqualified",
                  ]),
                ],
              )
            },
            None -> {
              let candidate = checker.resolved.names.fold(
                None,
                |accumulator: Option<Bytes>, e: ModuleEntry|
                  match accumulator {
                    Some(_) -> accumulator,
                    None -> if e.name == binder.name || default_binder(e.name) == binder.name {
                      Some(e.name)
                    } else { None },
                  },
              );
              let note = match candidate {
                Some(name) ->
                  Bytes::concat_all([
                    b"`",
                    name,
                    b"` is a module in this program: add `import ",
                    name,
                    b"` above the first item",
                  ]),
                None -> {
                  let imported = scope.modules.filter(is_explicit_binding);
                  if imported.len() == 0 {
                    Bytes::concat_all([
                      b"`",
                      scope.module,
                      b"` imports no modules; add `import <module>` above the first item",
                    ])
                  } else {
                    b"modules imported here: ".concat(
                      backticked(imported.map(|binding: ModuleBinding| binding.binder), b", "),
                    )
                  }
                },
              };
              report_error_at(checker, b"E0106", binder.span, message, label, [note])
            },
          }
        },
        Some(owner) -> {
          let declarations = checker.resolved.declarations.get(owner);
          let module = checker.resolved.scopes.get(owner).module;
          match lookup_declared(declarations, namespace, qualified_name.name.name) {
            None -> {
              let exported = declarations_in(declarations, namespace).fold(
                [],
                |accumulator: List<Bytes>, declared: Declaration|
                  if declared.public { accumulator.push(declared.name) } else { accumulator },
              );
              report_error_at(
                checker,
                b"E0101",
                qualified_name.span,
                Bytes::concat_all([
                  b"module `",
                  module,
                  b"` has no ",
                  describe_namespace(namespace),
                  b" `",
                  qualified_name.name.name,
                  b"`",
                ]),
                Bytes::concat_all([b"not declared in `", module, b"`"]),
                [
                  if exported.len() == 0 {
                    Bytes::concat_all([
                      b"`",
                      module,
                      b"` exports no ",
                      describe_namespace(namespace),
                      b"s",
                    ])
                  } else {
                    Bytes::concat_all([b"`", module, b"` exports: ", backticked(exported, b", ")])
                  },
                ],
              )
            },
            Some(d) -> if !d.public {
              report(
                checker,
                match private_constructor_diagnostic(checker, namespace, qualified_name, [owner]) {
                  Some(closed) -> closed,
                  None ->
                    private_name_error(
                      checker.module,
                      qualified_name.span,
                      owner,
                      d.span,
                      namespace,
                      qualified_name.name.name,
                      module,
                    ),
                },
              )
            } else { checker },
          }
        },
      }
    },
  }

pub fn local_at(checker: Checker, qualified_name: QName) -> Option<Int> =
  if is_bare(qualified_name) { checker.binders.get(qualified_name.name.span.site) } else { None }

pub fn value_key(
  checker: Checker,
  qualified_name: QName,
) -> { checker: Checker, key: Option<ValueKey> } / {abort.raise} =
  if !is_bare(qualified_name) {
    match look_up_language_type(checker, qualified_name) {
      Found(m) ->
        {
          checker: checker,
          key: Some(GlobalKey({ name: m.callee, prelude: m.qualified_name.module == None })),
        },
      NoLanguageFunction(of) ->
        { checker: no_function_of(checker, of.name, qualified_name.name), key: None },
      NotLanguageType -> {
        let g: WithName = global(checker, ValueSpace, qualified_name);
        match g.name {
          Some(n) -> { checker: g.checker, key: Some(GlobalKey({ name: n, prelude: false })) },
          None -> { checker: g.checker, key: None },
        }
      },
    }
  } else {
    match local_at(checker, qualified_name) {
      Some(binder) -> { checker: checker, key: Some(LocalKey(binder)) },
      None -> value_key_global(checker, qualified_name),
    }
  }

pub type LanguageTypeLookup =
  | Found({ qualified_name: QName, callee: Bytes })
  | NoLanguageFunction(Identifier)
  | NotLanguageType

pub fn look_up_language_type(
  checker: Checker,
  qualified_name: QName,
) -> LanguageTypeLookup / {abort.raise} =
  match qualified_name.module {
    None -> NotLanguageType,
    Some(of) -> if !starts_upper(of.name) || method_binder_module(of.name) != None
        || find_module_binding(scope_of(checker).modules, of.name) != None
        || locate_type(checker.resolved, checker.module, of.name) != None { NotLanguageType } else {
      match language_function(checker, of.name, qualified_name.name, false) {
        Some(m) -> Found(m),
        None -> NoLanguageFunction(of),
      }
    },
  }

fn value_key_global(
  checker: Checker,
  qualified_name: QName,
) -> { checker: Checker, key: Option<ValueKey> } / {abort.raise} = {
  let name = qualified_name.name.name;
  match lookup(scope_of(checker).bound, ValueSpace, name) {
    Some(b) -> { checker: checker, key: Some(GlobalKey({ name: b.qualified, prelude: false })) },
    None -> match env_lookup(checker.env, name) {
      Some(_) -> { checker: checker, key: Some(GlobalKey({ name: name, prelude: true })) },
      None -> { checker: unknown_name(checker, qualified_name), key: None },
    },
  }
}

pub fn declared_value(checker: Checker, qualified_name: QName) -> Option<Bytes> / {abort.raise} =
  if is_bare(qualified_name) {
    match lookup(scope_of(checker).bound, ValueSpace, qualified_name.name.name) {
      Some(b) -> Some(b.qualified),
      None -> None,
    }
  } else {
    match find(checker.resolved, checker.module, ValueSpace, qualified_name) {
      Some(b) -> Some(b.qualified),
      None -> None,
    }
  }

fn prelude_constructor(checker: Checker, qualified_name: QName) -> Option<Bytes> =
  if is_bare(qualified_name) {
    match constructor_of(checker, qualified_name.name.name) {
      Some(_) -> Some(qualified_name.name.name),
      None -> None,
    }
  } else { None }

pub fn constructor_name(
  checker: Checker,
  qualified_name: QName,
) -> { checker: Checker, name: Option<Bytes> } / {abort.raise} = {
  let g: WithName = global(checker, ValueSpace, qualified_name);
  match g.name {
    Some(n) -> g,
    None -> { checker: g.checker, name: prelude_constructor(g.checker, qualified_name) },
  }
}

pub fn covered_constructor(
  checker: Checker,
  qualified_name: QName,
) -> Option<Bytes> / {abort.raise} =
  match declared_value(checker, qualified_name) {
    Some(n) -> Some(n),
    None -> prelude_constructor(checker, qualified_name),
  }

pub fn exporter(
  checker: Checker,
  namespace: Namespace,
  name: Bytes,
) -> Option<Int> / {abort.raise} =
  range(0, checker.resolved.declarations.len()).fold(None, |accumulator: Option<Int>, i: Int|
    match accumulator {
      Some(_) -> accumulator,
      None -> if i == checker.module { None } else {
        match lookup_declared(checker.resolved.declarations.get(i), namespace, name) {
          Some(d) -> if d.public { Some(i) } else { None },
          None -> None,
        }
      },
    })

fn nearest_name(checker: Checker, name: Bytes) -> Option<Bytes> / {abort.raise} = {
  let written = String::of_bytes_lossy(name);
  let others = scope_of(checker).bound.values.map(|binding: Binding|
    String::of_bytes_lossy(binding.name)).filter(|other: String| other != written);
  match closest(written, others, name.len() / 3) {
    Some(near) -> Some(Bytes::of_string(near)),
    None -> None,
  }
}

fn imported(checker: Checker) -> List<Int> / {abort.raise} = {
  let scope = scope_of(checker);
  scope.selected_modules.concat(scope.modules).map(|binding: ModuleBinding| binding.target)
}

fn private_constructor_diagnostic(
  checker: Checker,
  namespace: Namespace,
  qualified_name: QName,
  owners: List<Int>,
) -> Option<Diagnostic> / {abort.raise} =
  match namespace {
    ValueSpace ->
      owners.fold(None, |found: Option<Diagnostic>, owner: Int|
        match found {
          Some(_) -> found,
          None -> if owner == checker.module { None } else {
            opaque_constructor_error(
              checker.modules,
              checker.module,
              qualified_name.span,
              owner,
              qualified_name.name.name,
            )
          },
        }),
    _ -> None,
  }

pub fn unknown_name(checker: Checker, qualified_name: QName) -> Checker / {abort.raise} =
  report(checker, unknown_name_diagnostic(checker, qualified_name))

pub fn unknown_name_diagnostic(
  checker: Checker,
  qualified_name: QName,
) -> Diagnostic / {abort.raise} =
  match checker.derived {
    Some(_) -> derived_unresolved(checker, qualified_name, b"definition"),
    None -> match private_name_diagnostic(checker, qualified_name) {
      Some(closed) -> closed,
      None -> unknown_name_here(checker, qualified_name),
    },
  }

pub fn private_name_diagnostic(
  checker: Checker,
  qualified_name: QName,
) -> Option<Diagnostic> / {abort.raise} =
  match qualified_name.module {
    None -> private_constructor_diagnostic(checker, ValueSpace, qualified_name, imported(checker)),
    Some(binder) -> match find_module_binding(scope_of(checker).modules, binder.name) {
      Some(binding) ->
        private_constructor_diagnostic(checker, ValueSpace, qualified_name, [binding.target]),
      None -> None,
    },
  }

fn unknown_name_here(checker: Checker, qualified_name: QName) -> Diagnostic / {abort.raise} = {
  let n = qualified_name.name.name;
  let result = if !is_bare(qualified_name) || n != result_name() { [] } else {
    match checker.spec_kind {
      Some(RequiresClause) ->
        [
          b"`result` is bound only in an `ensures`: a precondition that could name the result would be a claim about a value the call has not produced yet",
        ],
      Some(CostClause) ->
        [
          b"`result` is bound only in an `ensures`: a `cost` bound is over the parameters a call is given",
        ],
      Some(SpaceClause) ->
        [
          b"`result` is bound only in an `ensures`: a `space` bound is over the parameters a call is given",
        ],
      _ -> [],
    }
  };
  let near = match nearest_name(checker, n) {
    Some(x) -> result.push(Bytes::concat_all([b"a name in scope looks similar: `", x, b"`"])),
    None -> result,
  };
  let exported = if is_bare(qualified_name) {
    match exporter(checker, ValueSpace, n) {
      Some(i) ->
        near.push(
          Bytes::concat_all([
            b"module `",
            module_name(checker, i),
            b"` exports it: add `import ",
            module_name(checker, i),
            b" (",
            n,
            b")`",
          ]),
        ),
      None -> near,
    }
  } else { near };
  error_at(
    b"E0101",
    checker.module,
    qualified_name.span,
    Bytes::concat_all([b"unknown name `", n, b"`"]),
    b"not found in this scope",
    exported,
  )
}

pub fn language_function(
  checker: Checker,
  of: Bytes,
  name: Identifier,
  on_value: Bool,
) -> Option<{ qualified_name: QName, callee: Bytes }> / {abort.raise} = {
  let declared = member_name(of, name.name);
  match lookup(scope_of(checker).bound, ValueSpace, declared) {
    Some(own) -> if own.qualified == qualify(prelude_module(), declared)
        && checker.contracts.contains(declared) {
      Some({
        qualified_name: {
          module: None,
          name: { name: declared, span: name.span },
          span: name.span,
        },
        callee: declared,
      })
    } else {
      Some({
        qualified_name: {
          module: Some({ name: method_binder(scope_of(checker).module), span: name.span }),
          name: { name: declared, span: name.span },
          span: name.span,
        },
        callee: own.qualified,
      })
    },
    None -> builtin_or_home(checker, of, name, on_value, declared),
  }
}

fn builtin_or_home(
  checker: Checker,
  of: Bytes,
  name: Identifier,
  on_value: Bool,
  declared: Bytes,
) -> Option<{ qualified_name: QName, callee: Bytes }> / {abort.raise} = {
  let takes = !on_value
    || (match env_lookup(checker.env, declared) {
      Some(scheme) -> match scheme.ty {
        FunctionType(f) -> match f.params.at(0) {
          Some(NamedType(c)) -> c.name == of,
          Some(NominalType(n)) -> n.name == of,
          _ -> false,
        },
        _ -> false,
      },
      None -> false,
    });
  if takes && env_lookup(checker.env, declared) != None {
    Some({
      qualified_name: { module: None, name: { name: declared, span: name.span }, span: name.span },
      callee: declared,
    })
  } else { home_function(checker, of, name) }
}

fn home_function(
  checker: Checker,
  of: Bytes,
  name: Identifier,
) -> Option<{ qualified_name: QName, callee: Bytes }> / {abort.raise} = {
  let home = home_module(of);
  let seen = match checker.resolved.visible_modules.at(checker.module) {
    Some(ks) -> ks,
    None -> [],
  };
  if !seen.fold(false, |found: Bool, k: Int|
      found || checker.resolved.scopes.get(k).module == home) { None } else {
    let qualified_name = {
      module: Some({ name: method_binder(home), span: name.span }),
      name: { name: member_name(of, name.name), span: name.span },
      span: name.span,
    };
    match find(checker.resolved, checker.module, ValueSpace, qualified_name) {
      Some(b) -> Some({ qualified_name: qualified_name, callee: b.qualified }),
      None -> None,
    }
  }
}

pub fn module_declares(checker: Checker, of: Bytes) -> Bool =
  checker.types.contains(of) || checker.nominals.contains(of)

fn no_function_of(checker: Checker, of: Bytes, name: Identifier) -> Checker / {abort.raise} =
  report(checker, no_function_diagnostic(checker, of, name))

pub fn no_function_diagnostic(
  checker: Checker,
  of: Bytes,
  name: Identifier,
) -> Diagnostic / {abort.raise} =
  error_at(
    b"E0101",
    checker.module,
    name.span,
    Bytes::concat_all([b"`", simple_name_of(of), b"` has no function `", name.name, b"`"]),
    b"not a function of the type",
    [
      if module_declares(checker, of) {
        Bytes::concat_all([
          b"a function of a type is declared `fn ",
          simple_name_of(of),
          b"::",
          name.name,
          b"(..)` in the module that declares the type",
        ])
      } else {
        Bytes::concat_all([
          b"`",
          of,
          b"` has the builtins named for it, and the functions `",
          home_module(of),
          if sees_homes(checker.resolved.scopes.get(checker.module).module) {
            b"` declares as functions of the type"
          } else {
            b"` declares as functions of the type, but only where this module imports the module just named, directly or through another module"
          },
        ])
      },
    ],
  )

pub fn is_explicit_binding(binding: ModuleBinding) -> Bool = binding.span.end > binding.span.start

pub fn simple_name_of(name: Bytes) -> Bytes / {abort.raise} =
  match range(0, name.len()).fold(None, |accumulator: Option<Int>, i: Int|
      if name.at(i) == 46 { Some(i) } else { accumulator }) {
    Some(i) -> name.slice(i + 1, name.len()),
    None -> name,
  }

pub fn home_module(of: Bytes) -> Bytes / {abort.raise} =
  b"std.".concat(Bytes::of_string(String::of_bytes(of).ascii_lower()))
