import compiler.check.types (Type, VariableType, NamedType, FunctionType, RecordType, NominalType,
                             Field, Row, Atom, Scheme, is_label_or_row, type_args, instantiate,
                             unify, resolve_row, substitution_new, row_empty, atoms_union)
import compiler.check.infer.checker (Checker, ConstructorInfo, resolve, definition_of)
import std.list

pub fn resource_types(checker: Checker) -> List<Bytes> / {abort.raise} =
  iterate(
    checker.released.fold([], |acc: List<Bytes>, name: Bytes, by: Bytes| acc.push(name)),
    checker.constructors.len() + 1,
    |known: List<Bytes>| {
      let more = checker.constructors.fold(known, |acc: List<Bytes>, x: ConstructorInfo|
        if acc.contains(x.type_name) { acc }
        else if x.fields.any(|t: Type| names_resource(known, t)) { acc.push(x.type_name) }
        else { acc });
      if more.len() == known.len() { Stop(known) } else { Continue(more) }
    },
  )

fn names_resource(known: List<Bytes>, ty: Type) -> Bool =
  match ty {
    VariableType(_) -> false,
    NamedType(c) -> known.contains(c.name) || c.args.any(|a: Type| names_resource(known, a)),
    FunctionType(f) -> f.once,
    RecordType(fs) -> fs.any(|x: Field| names_resource(known, x.ty)),
    NominalType(n) ->
      known.contains(n.name) || n.fields.any(|x: Field| names_resource(known, x.ty)),
  }

pub fn is_resource_type(checker: Checker, kept: List<Int>, ty: Type) -> Bool / {abort.raise} =
  holds_resource(checker, kept, resolve(checker, ty))

fn holds_resource(checker: Checker, kept: List<Int>, ty: Type) -> Bool =
  match ty {
    VariableType(v) -> kept.contains(v),
    NamedType(c) ->
      !is_label_or_row(ty)
        && (checker.resource_types.contains(c.name)
        || c.args.any(|a: Type| holds_resource(checker, kept, a))),
    FunctionType(f) -> f.once,
    RecordType(fs) -> fs.any(|x: Field| holds_resource(checker, kept, x.ty)),
    NominalType(n) ->
      checker.resource_types.contains(n.name)
        || n.fields.any(|x: Field| holds_resource(checker, kept, x.ty)),
  }

pub fn release_atoms(checker: Checker, ty: Type) -> List<Atom> / {abort.raise} =
  iterate(
    { todo: [resolve(checker, ty)], seen: [], atoms: [] },
    checker.constructors.fold(256, |n: Int, x: ConstructorInfo| n + 4 * (x.fields.len() + 1)),
    |w: ReleaseSearch|
      match w.todo {
        [] -> Stop(w.atoms),
        [t, ..rest] -> Continue(release_search_step(checker, { ..w, todo: rest }, t)),
      },
  )

type ReleaseSearch = { todo: List<Type>, seen: List<Bytes>, atoms: List<Atom> }

fn release_search_step(
  checker: Checker,
  w: ReleaseSearch,
  ty: Type,
) -> ReleaseSearch / {abort.raise} = {
  let own = |name: Bytes|
    match checker.released.get(name) {
      None -> None,
      Some(by) -> match definition_of(checker, by) {
        None -> Some([]),
        Some(f) -> Some(release_row(checker, f.scheme, ty).atoms),
      },
    };
  let reading = |xs: List<Type>| { ..w, todo: w.todo.concat(xs) };
  let stated = |atoms: List<Atom>| { ..w, atoms: atoms_union(w.atoms, atoms) };
  match ty {
    NamedType(c) -> match own(c.name) {
      Some(atoms) -> stated(atoms),
      None -> if is_label_or_row(ty) || w.seen.contains(c.name)
          || !checker.resource_types.contains(c.name) { reading(type_args(c.args)) } else {
        let fields = checker.constructors.filter(|x: ConstructorInfo| x.type_name == c.name).fold(
          [],
          |acc: List<Type>, x: ConstructorInfo| acc.concat(x.fields),
        );
        { ..reading(type_args(c.args).concat(fields)), seen: w.seen.push(c.name) }
      },
    },
    NominalType(n) -> match own(n.name) {
      Some(atoms) -> stated(atoms),
      None -> reading(n.fields.map(|x: Field| x.ty)),
    },
    RecordType(fs) -> reading(fs.map(|x: Field| x.ty)),
    _ -> w,
  }
}

fn release_row(checker: Checker, scheme: Scheme, held: Type) -> Row / {abort.raise} = {
  let o = instantiate(scheme, checker.fresh);
  match o.ty {
    FunctionType(f) -> match f.params.at(0) {
      Some(p) -> {
        let u = unify(substitution_new(), o.fresh, p, held);
        match u.error { Some(_) -> row_empty(), None -> resolve_row(u.substitution, f.effects) }
      },
      None -> row_empty(),
    },
    _ -> row_empty(),
  }
}
