//! Resources: a value of a type that states a `release`, a value holding one, and a function its
//! call consumes. A value of any other type may be copied.

import compiler.check.types (Type, TyVar, TyCon, TyFn, TyRecord, TyNominal, Field, Row, Atom,
                             Scheme, over_arg, type_args, instantiate, unify, resolve_row,
                             subst_new, row_empty, atoms_union)
import compiler.check.infer.checker (Checker, CtorInfo, resolve, def_of)
import std.list

/// Every declared type that is a resource: one that states a `release`, or one whose constructors
/// hold a value of such a type, read until a round adds none.
pub fn resourceful_types(checker: Checker) -> List<Bytes> / {abort.raise} =
  if checker.released.len() == 0 { [] } else {
    iterate(
      checker.released.fold([], |acc: List<Bytes>, name: Bytes, by: Bytes| acc.push(name)),
      checker.ctors.len() + 1,
      |known: List<Bytes>| {
        let more = checker.ctors.fold(known, |acc: List<Bytes>, x: CtorInfo|
          if acc.contains(x.type_name) { acc }
          else if x.fields.any(|t: Type| names_resource(known, t)) { acc.push(x.type_name) }
          else { acc });
        if more.len() == known.len() { Stop(known) } else { Continue(more) }
      },
    )
  }

/// Whether `ty`, as a declaration writes it, holds a value of one of the `known` types.
fn names_resource(known: List<Bytes>, ty: Type) -> Bool =
  match ty {
    TyVar(_) -> false,
    TyCon(c) -> known.contains(c.name) || c.args.any(|a: Type| names_resource(known, a)),
    TyFn(f) -> f.once,
    TyRecord(fs) -> fs.any(|x: Field| names_resource(known, x.ty)),
    TyNominal(n) -> known.contains(n.name) || n.fields.any(|x: Field| names_resource(known, x.ty)),
  }

/// Whether a value of `ty` is a resource, where `kept` are the type variables written `keep` of
/// the definition it stands in, which a resource may fill.
pub fn resource_type(checker: Checker, kept: List<Int>, ty: Type) -> Bool / {abort.raise} =
  holds_resource(checker, kept, resolve(checker, ty))

/// Whether `ty`, which binds no variable the check has solved, holds a resource.
fn holds_resource(checker: Checker, kept: List<Int>, ty: Type) -> Bool =
  match ty {
    TyVar(v) -> kept.contains(v),
    TyCon(c) ->
      !over_arg(ty)
        && (checker.resourceful.contains(c.name)
        || c.args.any(|a: Type| holds_resource(checker, kept, a))),
    TyFn(f) -> f.once,
    TyRecord(fs) -> fs.any(|x: Field| holds_resource(checker, kept, x.ty)),
    TyNominal(n) ->
      checker.resourceful.contains(n.name)
        || n.fields.any(|x: Field| holds_resource(checker, kept, x.ty)),
  }

/// The atoms letting go of a value of `ty` may perform: its type's release, at the type's arguments,
/// or else the releases of the resources it holds, each declared type's constructors read once.
pub fn release_atoms(checker: Checker, ty: Type) -> List<Atom> / {abort.raise} =
  iterate(
    { todo: [resolve(checker, ty)], seen: [], atoms: [] },
    checker.ctors.fold(256, |n: Int, x: CtorInfo| n + 4 * (x.fields.len() + 1)),
    |w: Gathering|
      match w.todo {
        [] -> Stop(w.atoms),
        [t, ..rest] -> Continue(gathered(checker, { ..w, todo: rest }, t)),
      },
  )

/// The types left to read, the declared types whose constructors were read, and the atoms so far.
type Gathering = { todo: List<Type>, seen: List<Bytes>, atoms: List<Atom> }

/// `w` past `ty`: its own release's atoms, or the parts it holds to read.
fn gathered(checker: Checker, w: Gathering, ty: Type) -> Gathering / {abort.raise} = {
  let own = |name: Bytes|
    match checker.released.get(name) {
      None -> None,
      Some(by) -> match def_of(checker, by) {
        None -> Some([]),
        Some(f) -> Some(filled_row(checker, f.scheme, ty).atoms),
      },
    };
  let reading = |xs: List<Type>| { ..w, todo: w.todo.concat(xs) };
  let stated = |atoms: List<Atom>| { ..w, atoms: atoms_union(w.atoms, atoms) };
  match ty {
    TyCon(c) -> match own(c.name) {
      Some(atoms) -> stated(atoms),
      None -> if over_arg(ty) || w.seen.contains(c.name) || !checker.resourceful.contains(c.name) {
        reading(type_args(c.args))
      } else {
        let fields = checker.ctors.filter(|x: CtorInfo| x.type_name == c.name).fold(
          [],
          |acc: List<Type>, x: CtorInfo| acc.concat(x.fields),
        );
        { ..reading(type_args(c.args).concat(fields)), seen: w.seen.push(c.name) }
      },
    },
    TyNominal(n) -> match own(n.name) {
      Some(atoms) -> stated(atoms),
      None -> reading(n.fields.map(|x: Field| x.ty)),
    },
    TyRecord(fs) -> reading(fs.map(|x: Field| x.ty)),
    _ -> w,
  }
}

/// The row of a release whose scheme is `scheme`, its parameter filled by the value `held`.
fn filled_row(checker: Checker, scheme: Scheme, held: Type) -> Row / {abort.raise} = {
  let o = instantiate(scheme, checker.fresh);
  match o.ty {
    TyFn(f) -> match f.params.at(0) {
      Some(p) -> {
        let u = unify(subst_new(), o.fresh, p, held);
        match u.error { Some(_) -> row_empty(), None -> resolve_row(u.subst, f.effects) }
      },
      None -> row_empty(),
    },
    _ -> row_empty(),
  }
}
