import compiler.check.resolve.tables (other_modules)
import compiler.check.borrowing (mode_facts)
import compiler.check.termination (termination_facts)
import compiler.check.infer.checker (elsewhere)
import compiler.check.infer.checker (release_function_of, declared_resource)
import compiler.check.types (Type, VariableType, NamedType, FunctionType, RecordType, NominalType,
                             Field, Effects, Effect, Scheme, is_label_or_effects, type_args,
                             instantiate, unify, resolve_effects, substitution_new, no_effects,
                             effects_union)
import compiler.check.infer.checker (Checker, ConstructorInfo, resolve, definition_of)
import std.list
import std.graph (Visit, traverse)

pub fn resource_types(checker: Checker) -> List<Bytes> / {abort.raise, elsewhere.read} =
  iterate(
    checker.release_functions.fold([], |accumulator: List<Bytes>, name: Bytes, by: Bytes|
      accumulator.push(name)),
    checker.constructors.len() + 1,
    |known: List<Bytes>| {
      let more = checker.constructors.fold(known, |accumulator: List<Bytes>, x: ConstructorInfo|
        if accumulator.contains(x.type_name) { accumulator }
        else if x.fields.any(|t: Type| names_resource(checker, known, t)) {
          accumulator.push(x.type_name)
        } else { accumulator });
      if more.len() == known.len() { Stop(known) } else { Continue(more) }
    },
  )

fn names_resource(checker: Checker, known: List<Bytes>, ty: Type) -> Bool / {elsewhere.read} =
  match ty {
    VariableType(_) -> false,
    NamedType(c) ->
      known.contains(c.name) || declared_resource(checker, c.name)
        || c.args.any(|a: Type| names_resource(checker, known, a)),
    FunctionType(f) -> f.once,
    RecordType(fs) -> fs.any(|x: Field| names_resource(checker, known, x.ty)),
    NominalType(n) ->
      known.contains(n.name) || declared_resource(checker, n.name)
        || n.fields.any(|x: Field| names_resource(checker, known, x.ty)),
  }

pub fn is_resource_type(
  checker: Checker,
  resource_variables: List<Int>,
  ty: Type,
) -> Bool / {abort.raise, elsewhere.read} =
  contains_resource(checker, resource_variables, resolve(checker, ty))

fn contains_resource(
  checker: Checker,
  resource_variables: List<Int>,
  ty: Type,
) -> Bool / {elsewhere.read} =
  match ty {
    VariableType(v) -> resource_variables.contains(v),
    NamedType(c) ->
      !is_label_or_effects(ty)
        && (declared_resource(checker, c.name)
        || c.args.any(|a: Type| contains_resource(checker, resource_variables, a))),
    FunctionType(f) -> f.once,
    RecordType(fs) -> fs.any(|x: Field| contains_resource(checker, resource_variables, x.ty)),
    NominalType(n) ->
      declared_resource(checker, n.name)
        || n.fields.any(|x: Field| contains_resource(checker, resource_variables, x.ty)),
  }

pub fn release_effect_list(
  checker: Checker,
  ty: Type,
) -> List<Effect> / {abort.raise, elsewhere.read} =
  traverse([resolve(checker, ty)], |t: Type| released_within(checker, t)).fold(
    [],
    |listed: List<Effect>, v: Visit<Type, List<Effect>>| effects_union(listed, v.value),
  )

fn released_within(
  checker: Checker,
  ty: Type,
) -> { value: List<Effect>, next: List<Type> } / {abort.raise, elsewhere.read} = {
  let own = |name: Bytes|
    match release_function_of(checker, name) {
      None -> None,
      Some(by) -> match definition_of(checker, by) {
        None -> Some([]),
        Some(f) -> Some(release_effects(checker, f.scheme, ty).listed),
      },
    };
  let reading = |xs: List<Type>| { value: [], next: xs };
  match ty {
    NamedType(c) -> match own(c.name) {
      Some(effects) -> { value: effects, next: [] },
      None -> if is_label_or_effects(ty) || !declared_resource(checker, c.name) {
        reading(type_args(c.args))
      } else {
        let fields = checker.constructors.filter(|x: ConstructorInfo| x.type_name == c.name).fold(
          [],
          |accumulator: List<Type>, x: ConstructorInfo| accumulator.concat(x.fields),
        );
        reading(type_args(c.args).concat(fields))
      },
    },
    NominalType(n) -> match own(n.name) {
      Some(effects) -> { value: effects, next: [] },
      None -> reading(n.fields.map(|x: Field| x.ty)),
    },
    RecordType(fs) -> reading(fs.map(|x: Field| x.ty)),
    _ -> reading([]),
  }
}

fn release_effects(
  checker: Checker,
  scheme: Scheme,
  released_type: Type,
) -> Effects / {abort.raise} = {
  let o = instantiate(scheme, checker.fresh);
  match o.ty {
    FunctionType(f) -> match f.params.at(0) {
      Some(p) -> {
        let u = unify(substitution_new, o.fresh, p, released_type);
        match u.error { Some(_) -> no_effects, None -> resolve_effects(u.substitution, f.effects) }
      },
      None -> no_effects,
    },
    _ -> no_effects,
  }
}
