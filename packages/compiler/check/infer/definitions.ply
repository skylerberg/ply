fn names_read(definition: FnDefinition) -> List<QName> =
  expressions_matching(
    { doc: None, imports: [], items: [FunctionItem(definition)] },
    |e: Expression|
      match e { NameExpression(_) -> true, TaggedLiteralExpression(_) -> true, _ -> false },
  ).fold([], |accumulator: List<QName>, e: Expression|
    match e {
      NameExpression(v) -> accumulator.push(v.name),
      TaggedLiteralExpression(t) -> if t.holes.len() == 0 { accumulator.push(tagged_parser(t)) }
      else { accumulator.push(tagged_parser(t)).push(tagged_filler(t)) },
      _ -> accumulator,
    })

pub type ModuleSignatures = {
  functions: List<FnDefinition>,
  names: List<Bytes>,
  sigs: List<Signature>,
  members: List<GroupDefinition>,
}

pub fn bind_signatures(
  checker: Checker,
  parsed: ParsedModule,
) -> { checker: Checker, signed: ModuleSignatures } / {abort.raise} = {
  let collected = parsed.module.items.fold(
    { checker: reject_externs(checker, parsed), functions: [], names: [] },
    |accumulator: { checker: Checker, functions: List<FnDefinition>, names: List<Bytes> }, item: Item|
      match item {
        FunctionItem(definition) -> if accumulator.names.contains(definition.name.name) {
          let earlier_span = accumulator.functions.fold(
            dummy_span,
            |span: Span, f: FnDefinition|
              if f.name.name == definition.name.name { f.name.span } else { span },
          );
          {
            ..accumulator,
            checker: duplicate(
              accumulator.checker,
              definition.name,
              { module: accumulator.checker.module, span: earlier_span },
              b"function",
            ),
          }
        } else if definition.name.name == compare_values_name {
          {
            ..accumulator,
            checker: report_error_at(
              accumulator.checker,
              b"E0105",
              definition.name.span,
              b"`compare_values` is a builtin",
              b"cannot be redefined",
              [
                b"it is the order `Map` iterates in, and `derive ord` generates comparison code that depends on it \xe2\x80\x94 if a module could redefine it, one type would have two orders",
                b"`compare` does the same and can be shadowed",
              ],
            ),
          }
        } else if call_operator(definition.name.name) != None {
          {
            ..accumulator,
            checker: report_error_at(
              accumulator.checker,
              b"E0105",
              definition.name.span,
              Bytes::concat_all([b"`", definition.name.name, b"` is a builtin"]),
              b"cannot be redefined",
              [
                Bytes::concat_all([
                  b"the operator `",
                  match call_operator(definition.name.name) { Some(o) -> o.text, None -> b"" },
                  b"` is the operator's own function name, so a module that redefined it would change what the operator means",
                ]),
              ],
            ),
          }
        } else {
          {
            checker: accumulator.checker,
            functions: accumulator.functions.push(definition),
            names: accumulator.names.push(definition.name.name),
          }
        },
        _ -> accumulator,
      },
  );
  let functions = with_implied_orders(collected.checker, collected.functions);
  let names = functions.map(|d: FnDefinition| qualify(parsed.name, d.name.name));
  let placed: Checker = functions.fold(collected.checker, |c: Checker, d: FnDefinition|
    check_member_declaration(c, parsed, d));
  let signed: BoundSignatures = range(0, functions.len()).fold(
    { checker: placed, sigs: [], members: [] },
    |accumulator: BoundSignatures, i: Int|
      bind_signature(accumulator, parsed, functions.get(i), names.get(i)),
  );
  {
    checker: bind_externs(signed.checker, parsed),
    signed: { functions: functions, names: names, sigs: signed.sigs, members: signed.members },
  }
}

fn bind_externs(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} =
  if !is_shipped(parsed.name) { checker } else {
    externs_of(parsed.name, parsed.module).fold(checker, |c: Checker, b: Builtin|
      bind_builtin(c, checked_native_modes(c, b)))
  }

fn checked_native_modes(c: Checker, b: Builtin) -> Builtin / {abort.raise} = {
  let modes = match b.scheme.ty {
    FunctionType(f) ->
      f.effects.listed.filter(|a: Effect| a.operation == None && a.effect != scoped_effect),
    _ -> [],
  };
  match modes.find(|a: Effect|
      match effect_of(c, a.effect) { Some(info) -> info.operations.len() > 0, None -> true }) {
    None -> b,
    Some(a) ->
      panic(
        "the shipped `extern fn " ++ String::of_bytes_lossy(b.name) ++ "` lists the effect `"
          ++ String::of_bytes_lossy(a.effect)
          ++ "` as a mode, but a mode must be an effect that declares no operations",
      ),
  }
}

pub fn externs_of(name: Bytes, module: Module) -> List<Builtin> / {abort.raise} = {
  let own = module.items.fold(
    prelude_imports(module.imports),
    |accumulator: Map<Bytes, Bytes>, item: Item|
      match item {
        TypeItem(t) -> accumulator.insert(t.name.name, qualify(name, t.name.name)),
        EffectItem(e) -> accumulator.insert(e.name.name, qualify(name, e.name.name)),
        _ -> accumulator,
      },
  );
  let aliases = module.items.fold(
    Map::new(),
    |accumulator: Map<Bytes, TypeExpression>, item: Item|
      match item {
        TypeItem(t) -> match t.body {
          AliasBody(body) -> if t.generics != no_generics { accumulator }
          else { accumulator.insert(t.name.name, body) },
          _ -> accumulator,
        },
        _ -> accumulator,
      },
  );
  module.items.fold([], |accumulator: List<Builtin>, item: Item|
    match item {
      ExternItem(definition) -> if is_builtin(name, module, definition) { accumulator } else {
        accumulator.push(
          builtin_of_extern(qualify(name, definition.name.name), own, definition, aliases),
        )
      },
      _ -> accumulator,
    })
}

pub fn natives_of(
  name: Bytes,
  module: Module,
) -> List<{ own: Bytes, builtin: Builtin }> / {abort.raise} =
  if !is_shipped(name) { [] } else {
    externs_of(name, module).filter(|b: Builtin| intrinsic_named(b.name) == None).map(
      |b: Builtin| { own: b.name.slice(name.len() + 1, b.name.len()), builtin: b },
    )
  }

pub type Extern = {
  module: Bytes,
  name: Bytes,
  words: Int,
  raises: Bool,
  call: Option<MachineCall>,
}

pub type MachineValue =
  | MachineInt(Type)
  | MachineFloat
  | MachineText(Type)
  | MachineSecret(Type)
  | MachineObject(Type)
  | MachineTypeVariable(Int)
  | MachineFunction(Int)
  | MachineUnit

pub type MachineCall = { params: List<MachineValue>, result: MachineValue }

pub fn runtime_value(t: Type, scheme: Scheme, objects: List<Bytes>) -> Option<MachineValue> =
  match t {
    VariableType(v) -> position_of(scheme.type_variables, v).map(MachineTypeVariable),
    FunctionType(f) -> match f.effects.variable {
      Some(r) -> if f.effects.listed.len() > 0 { None }
      else { position_of(scheme.effect_variables, r).map(MachineFunction) },
      None -> None,
    },
    NamedType(c) -> if secret_item(t) != None { Some(MachineSecret(t)) }
    else if task_result(t) != None || chan_item(t) != None || objects.contains(c.name) {
      Some(MachineObject(t))
    } else if c.args.len() > 0 { None }
    else if is_int(t) || is_bool(t) || is_char(t) { Some(MachineInt(t)) }
    else if is_float(t) { Some(MachineFloat) }
    else if is_string(t) || is_bytes(t) { Some(MachineText(t)) }
    else if is_unit(t) { Some(MachineUnit) } else {
      match width_named(c.name) {
        Some(w) -> if w.bits <= 64 { Some(MachineInt(t)) } else { None },
        None -> None,
      }
    },
    _ -> None,
  }

pub fn machine_call(module: Bytes, b: Builtin, objects: List<Bytes>) -> Option<MachineCall> =
  if module == prelude_module || b.scheme.label_variables.len() > 0 || b.constraints.len() > 0
      || b.contract.raises { None } else {
    match b.scheme.ty {
      FunctionType(f) -> {
        let marshalling = |t: Type| runtime_value(t, b.scheme, objects);
        let params = f.params.map(marshalling);
        match if f.params.push(f.return_type).any(layout_depends_on_variable) { None }
          else { marshalling(f.return_type) } {
          None -> None,
          Some(MachineFunction(_)) -> None,
          Some(result) -> if params.any(|p: Option<MachineValue>|
              p == None || p == Some(MachineUnit)) { None } else {
            Some({
              params: params.fold([], |accumulator: List<MachineValue>, p: Option<MachineValue>|
                match p { Some(v) -> accumulator.push(v), None -> accumulator }),
              result: result,
            })
          },
        }
      },
      _ -> None,
    }
  }

pub fn machine_words(c: MachineCall) -> Int =
  c.params.fold(match c.result { MachineTypeVariable(_) -> 1, _ -> 0 }, |n: Int, v: MachineValue|
    match v {
      MachineText(_) -> n + 2,
      MachineTypeVariable(_) -> n + 2,
      MachineFunction(_) -> n + 3,
      _ -> n + 1,
    })

fn layout_depends_on_variable(t: Type) -> Bool =
  match t {
    VariableType(_) -> false,
    FunctionType(_) -> false,
    NamedType(c) -> !is_scheduler_handle(c.name) && c.args.any(contains_variable),
    _ -> contains_variable(t),
  }

fn position_of(xs: List<Int>, x: Int) -> Option<Int> =
  range(0, xs.len()).find(|i: Int| xs.at(i) == Some(x))

fn contains_variable(t: Type) -> Bool =
  match t {
    VariableType(_) -> true,
    NamedType(c) -> c.args.any(contains_variable),
    FunctionType(f) -> f.params.any(contains_variable) || contains_variable(f.return_type),
    RecordType(fs) -> fs.any(|f: Field| contains_variable(f.ty)),
    NominalType(x) -> x.fields.any(|f: Field| contains_variable(f.ty)),
  }

fn extern_types(name: Bytes, module: Module) -> List<Bytes> =
  module.items.fold([], |accumulator: List<Bytes>, item: Item|
    match item {
      TypeItem(t) -> match t.body {
        ExternBody -> accumulator.push(qualify(name, t.name.name)),
        _ -> accumulator,
      },
      _ -> accumulator,
    })

fn extern_of(module: Bytes, name: Bytes, b: Builtin, objects: List<Bytes>) -> Extern = {
  let call = machine_call(module, b, objects);
  {
    module: module,
    name: name,
    words: match call {
      Some(c) -> machine_words(c),
      None -> witness_params(b.constraints).len() + b.params.len(),
    },
    raises: b.contract.raises,
    call: call,
  }
}

pub const prelude_externs: List<Extern> =
  builtins.filter(|b: Builtin| !b.body).map(|b: Builtin| extern_of(prelude_module, b.name, b, []))

pub fn externs_in(name: Bytes, text: Bytes) -> List<Extern> / {abort.raise} =
  if text.index_of(b"extern") == None { [] } else { module_externs(name, parse(text).node) }

pub fn module_externs(name: Bytes, module: Module) -> List<Extern> / {abort.raise} = {
  let objects = extern_types(name, module);
  natives_of(name, module).map(|e: { own: Bytes, builtin: Builtin }|
    extern_of(name, e.own, e.builtin, objects))
}

pub const declared_natives: List<Extern> =
  prelude_externs.concat(
    compiler_natives.map(|n: CompilerNative|
      { module: b"", name: n.name, words: n.words, raises: n.raises, call: None }),
  )

pub fn program_natives(
  modules: List<{ name: Bytes, text: Bytes }>,
) -> List<Extern> / {abort.raise} =
  natives_beside(
    declared_natives,
    modules.map(|m: { name: Bytes, text: Bytes }| externs_in(m.name, m.text)),
  )

pub fn parsed_natives(modules: List<ParsedModule>) -> List<Extern> / {abort.raise} =
  natives_beside(declared_natives, modules.map(|m: ParsedModule| module_externs(m.name, m.module)))

pub fn machine_calls(natives: List<Extern>) -> Map<Bytes, MachineCall> =
  natives.fold(Map::new(), |accumulator: Map<Bytes, MachineCall>, e: Extern|
    match e.call { Some(c) -> accumulator.insert(e.name, c), None -> accumulator })

pub fn natives_beside(
  own: List<Extern>,
  modules: List<List<Extern>>,
) -> List<Extern> / {abort.raise} =
  [externs_in(prelude_module, prelude_source::text)].concat(modules).fold(
    {
      seen: own.fold(Map::new(), |m: Map<Bytes, Bool>, e: Extern| m.insert(e.name, true)),
      all: own,
    },
    |accumulator: { seen: Map<Bytes, Bool>, all: List<Extern> }, es: List<Extern>|
      es.fold(accumulator, |a: { seen: Map<Bytes, Bool>, all: List<Extern> }, e: Extern|
        if a.seen.contains(e.name) { a }
        else { { seen: a.seen.insert(e.name, true), all: a.all.push(e) } }),
  ).all

pub fn check_bodies(
  checker: Checker,
  parsed: ParsedModule,
  signed: ModuleSignatures,
) -> Checker / {abort.raise} = {
  let functions = signed.functions;
  let names = signed.names;
  let own = range(0, names.len()).fold(Map::new(), |m: Map<Bytes, Int>, i: Int|
    m.insert(names.get(i), i));
  let stated = instance_functions_of(parsed);
  let results = |f: Bytes|
    match own.get(f) { Some(i) -> Some(signed.sigs.get(i).return_type), None -> None };
  let walked = check_order_indices(functions).fold(
    { checker: { ..checker, own_functions: own }, bodies: Map::new(), signed: Map::new() },
    |accumulator: { checker: Checker, bodies: Map<Int, ClosedBody>, signed: Map<Int, Bool> }, i: Int| {
      let o = check_function(
        accumulator.checker,
        parsed,
        functions.get(i),
        names.get(i),
        signed.sigs.get(i),
        signed.members.get(i),
        stated,
        results,
      );
      {
        checker: if o.left != BodyChecked { o.checker } else {
          {
            ..o.checker,
            bodies: o.checker.bodies.push(
              checked_body_of(names.get(i), signed.members.get(i).labels, o.body),
            ),
          }
        },
        bodies: accumulator.bodies.insert(i, o.body),
        signed: if o.left == FromSignature { accumulator.signed.insert(i, true) }
        else { accumulator.signed },
      }
    },
  );
  let bodies = range(0, functions.len()).map(|i: Int|
    match walked.bodies.get(i) {
      Some(b) -> b,
      None -> panic("the checker did not visit every function of the module"),
    });
  let out = bodies.map(|b: ClosedBody|
    b.refs.concat(b.calls.concat(b.stated).map(|c: OwnCall| c.callee)).fold(
      [],
      |accumulator: List<Int>, n: Bytes|
        match own.get(n) {
          Some(i) -> if accumulator.contains(i) { accumulator } else { accumulator.push(i) },
          None -> accumulator,
        },
    ));
  let module: ModuleFunctions = {
    functions: functions,
    names: names,
    members: signed.members,
    bodies: bodies,
    written: members_in(
      walked.checker.member_sites,
      walked.checker.module,
      walked.checker.resolved.signatures,
    ),
  };
  let done: Checker = { ..walked.checker, own_functions: Map::new() };
  match checker.known.body_checking {
    CheckOnly(_) -> done,
    _ ->
      graph::components({ out: out }).fold(done, |c: Checker, comp: List<Int>|
        if comp.any(|i: Int| walked.signed.contains(i)) { c } else {
          comp.fold((), |_: Unit, i: Int|
            if out.get(i).any(|k: Int| walked.signed.contains(k)) {
              panic(
                "a group is resolved before a function it calls: "
                  ++ String::of_bytes_lossy(names.get(i)),
              )
            });
          finish_group(c, module, comp)
        }),
  }
}

fn checks_body(checker: Checker, name: Bytes) -> Bool =
  match checker.known.body_checking {
    CheckEvery -> true,
    CheckOnly(names) -> names.contains(name),
    ReuseBodies(_, _) -> false,
  }

fn reused_body(checker: Checker, name: Bytes) -> Option<ReusedBody> =
  match checker.known.body_checking { ReuseBodies(bodies, _) -> bodies.get(name), _ -> None }

fn checked_body_of(name: Bytes, labels: List<Int>, body: ClosedBody) -> CheckedBody =
  {
    name: name,
    listed: positional_effects(body.effects.listed, labels),
    has_effect_variable: body.effects.variable != None,
    performs: body.performs.map(|s: PerformSite|
      { ..s, entry: List::at_or(positional_effects([s.entry], labels), 0, s.entry) }),
    repeated: body.repeated,
    raise_notes: body.raise_notes,
    refs: body.refs,
    calls: body.calls,
    stated: body.stated,
    tags: body.tags,
    instantiations: body.fills,
    names: body.names,
  }

fn check_member_declaration(
  checker: Checker,
  parsed: ParsedModule,
  definition: FnDefinition,
) -> Checker / {abort.raise} =
  match if parsed.name == prelude_module { None } else { member_of(definition.name.name) } {
    None -> checker,
    Some(m) -> {
      let type_name = qualify(parsed.name, m.of);
      match checker.types.get(type_name) {
        None -> if builtin_type_arity(m.of) != None && home_module(m.of) == parsed.name {
          if env_lookup(checker.env, definition.name.name) == None { checker } else {
            report_error_at(
              checker,
              b"E0105",
              definition.name.span,
              Bytes::concat_all([b"`", definition.name.name, b"` is a builtin"]),
              b"cannot be redefined",
              [
                b"the prelude already declares a function with this name for this type, and a type can have only one function of each name",
              ],
            )
          }
        } else {
          report_error_at(
            checker,
            b"E0208",
            definition.name.span,
            Bytes::concat_all([b"`", m.of, b"` is not a type this module declares"]),
            b"declared in another module, or not at all",
            [
              b"a function of a type is found by the type alone, with no search, so only the module that declares the type declares one",
            ],
          )
        },
        Some(declaration) -> match declaration.declared {
          DeclaredAlias(_) ->
            report_error_at_and(
              checker,
              b"E0217",
              definition.name.span,
              Bytes::concat_all([
                b"`",
                m.of,
                b"` is an alias, and a function of a type is of a sum or a `new` record",
              ]),
              b"no type of its own",
              { module: declaration.owner, span: declaration.span },
              b"declared here",
              [
                b"an alias is only another name for its type, so a function declared on the alias would apply to every value of that type",
              ],
            ),
          DeclaredRecord(_) -> match checker.nominals.get(type_name) {
            Some(r) -> match record_fields(r.ty) {
              Some(fs) -> if field_get(fs, m.member) == None { checker } else {
                report_error_at_and(
                  checker,
                  b"E0105",
                  definition.name.span,
                  Bytes::concat_all([
                    b"`",
                    m.of,
                    b"` has a field `",
                    m.member,
                    b"` and a function of that name",
                  ]),
                  b"declared again here",
                  { module: declaration.owner, span: declaration.span },
                  b"the field is declared here",
                  [
                    b"`value.name` reads a record's field and `value.name(..)` calls it, so a function of the record under the same name could never be called on a value; rename one",
                  ],
                )
              },
              None -> checker,
            },
            None -> checker,
          },
          DeclaredSum -> checker,
          DeclaredExtern -> checker,
        },
      }
    },
  }

fn check_order_indices(functions: List<FnDefinition>) -> List<Int> / {abort.raise} = {
  let index = range(0, functions.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
    accumulator.insert(functions.get(i).name.name, i));
  let adj = functions.map(|d: FnDefinition|
    names_read(d).fold([], |accumulator: List<Int>, qualified_name: QName|
      if !is_bare(qualified_name) { accumulator } else {
        match index.get(qualified_name.name.name) {
          Some(i) -> if accumulator.contains(i) { accumulator } else { accumulator.push(i) },
          None -> accumulator,
        }
      }));
  graph::components({ out: adj }).fold([], |accumulator: List<Int>, comp: List<Int>|
    accumulator.concat(comp))
}

pub fn checked_functions(parsed: ParsedModule) -> List<Bytes> =
  checked_definitions(parsed).map(|d: FnDefinition| qualify(parsed.name, d.name.name))

pub fn check_order(parsed: ParsedModule) -> List<Bytes> / {abort.raise} = {
  let definitions = checked_definitions(parsed);
  check_order_indices(definitions).map(|i: Int| qualify(parsed.name, definitions.get(i).name.name))
}

fn checked_definitions(parsed: ParsedModule) -> List<FnDefinition> =
  parsed.module.items.fold([], |accumulator: List<FnDefinition>, item: Item|
    match item {
      FunctionItem(definition) -> if accumulator.any(|d: FnDefinition|
            d.name.name == definition.name.name)
          || definition.name.name == compare_values_name
          || call_operator(definition.name.name) != None { accumulator }
      else { accumulator.push(definition) },
      _ -> accumulator,
    })

fn instance_functions_of(parsed: ParsedModule) -> Map<Bytes, InstanceFunctions> = {
  let none: InstanceFunctions = { key: None, show: None, numeric: [] };
  let of = |m: Map<Bytes, InstanceFunctions>, target: Identifier|
    match m.get(qualify(parsed.name, target.name)) { Some(x) -> x, None -> none };
  parsed.module.items.fold(Map::new(), |accumulator: Map<Bytes, InstanceFunctions>, item: Item|
    match item {
      InstanceItem(definition) -> {
        let by = Some(qualify(parsed.name, definition.function.name));
        let was = of(accumulator, definition.target);
        let at = qualify(parsed.name, definition.target.name);
        match definition.kind {
          KeyInstance -> accumulator.insert(at, { ..was, key: by }),
          ShowInstance -> accumulator.insert(at, { ..was, show: by }),
          InvariantInstance -> accumulator,
          HostInstance -> accumulator,
          ReleaseInstance -> accumulator,
        }
      },
      NumericItem(definition) ->
        accumulator.insert(qualify(parsed.name, definition.target.name), {
          ..of(accumulator, definition.target),
          numeric: numeric_operations.map(|operation: Bytes|
            match numeric_by(definition, operation) {
              Some(by) -> qualify(parsed.name, by.name),
              None -> b"",
            }),
        }),
      _ -> accumulator,
    })
}

fn instance_calls_in(
  checker: Checker,
  stated: Map<Bytes, InstanceFunctions>,
  results: (Bytes) -> Option<Type> / {abort.raise},
  ty: Type,
  key: Bool,
  room: Int,
  accumulator: InstanceCalls,
) -> InstanceCalls / {abort.raise} =
  match ty {
    VariableType(_) -> accumulator,
    FunctionType(_) -> accumulator,
    RecordType(fs) ->
      fs.fold(accumulator, |a: InstanceCalls, f: Field|
        instance_calls_in(checker, stated, results, f.ty, key, room, a)),
    NominalType(n) ->
      n.fields.fold(accumulator, |a: InstanceCalls, f: Field|
        instance_calls_in(checker, stated, results, f.ty, key, room, a)),
    NamedType(c) -> {
      let args = c.args.fold(accumulator, |a: InstanceCalls, x: Type|
        instance_calls_in(checker, stated, results, x, key, room, a));
      if room <= 0 || args.seen.contains(c.name) { args } else {
        let within: InstanceCalls = { seen: args.seen.push(c.name), functions: args.functions };
        let stated_function = match stated.get(c.name) {
          Some(x) -> if key { x.key } else { x.show },
          None -> None,
        };
        match stated_function {
          Some(f) -> {
            let called: InstanceCalls = {
              seen: within.seen,
              functions: if within.functions.contains(f) { within.functions }
              else { within.functions.push(f) },
            };
            match ((key, results(f))) {
              (true, Some(t)) ->
                instance_calls_in(
                  checker,
                  stated,
                  results,
                  resolve(checker, t),
                  key,
                  room - 1,
                  called,
                ),
              _ -> called,
            }
          },
          None ->
            checker.constructors.filter(|k: ConstructorInfo| k.type_name == c.name).fold(
              within,
              |a: InstanceCalls, k: ConstructorInfo|
                k.fields.fold(a, |b: InstanceCalls, f: Type|
                  instance_calls_in(checker, stated, results, f, key, room - 1, b)),
            ),
        }
      }
    },
  }

fn instance_calls(
  checker: Checker,
  stated: Map<Bytes, InstanceFunctions>,
  results: (Bytes) -> Option<Type> / {abort.raise},
  body: DeferredSites,
) -> List<OwnCall> / {abort.raise} = {
  let called_functions = |ty: Type, key: Bool|
    instance_calls_in(
      checker,
      stated,
      results,
      resolve(checker, ty),
      key,
      declaration_depth_limit(checker),
      { seen: [], functions: [] },
    ).functions;
  let arithmetic = |ty: Type|
    match resolve(checker, ty) {
      NamedType(c) -> match stated.get(c.name) { Some(x) -> x.numeric, None -> [] },
      _ -> [],
    };
  let at_ = |accumulator: List<OwnCall>, span: Span, functions: List<Bytes>|
    functions.fold(accumulator, |a: List<OwnCall>, f: Bytes|
      if f == b"" { a } else { a.push({ callee: f, span: span }) });
  let operators = body.numerics.fold([], |accumulator: List<OwnCall>, n: NumericOperation|
    at_(accumulator, n.span, if is_order_comparison(n.operation) { called_functions(n.ty, true) }
    else {
      match numeric_slot(n.operation) {
        Some(i) -> match arithmetic(n.ty).at(i) { Some(f) -> [f], None -> [] },
        None -> [],
      }
    }));
  let compared = body.comparisons.fold(
    operators,
    |accumulator: List<OwnCall>, x: { module: Int, span: Span, ty: Type }|
      at_(accumulator, x.span, called_functions(x.ty, true)),
  );
  let keyed = body.map_keys.fold(compared, |accumulator: List<OwnCall>, x: MapKeySite|
    match x.carrier {
      Some(_) -> accumulator,
      None -> at_(accumulator, x.span, called_functions(x.whole, true)),
    });
  body.constrained.fold(keyed, |accumulator: List<OwnCall>, x: ConstraintSite|
    at_(accumulator, x.span, match x.deriver {
      ShowDeriver -> called_functions(x.ty, false),
      EqDeriver -> called_functions(x.ty, true),
      OrderingDeriver -> called_functions(x.ty, true),
      HashDeriver -> called_functions(x.ty, true),
      NumericDeriver -> arithmetic(x.ty).concat(called_functions(x.ty, true)),
      IntegerDeriver -> arithmetic(x.ty).concat(called_functions(x.ty, true)),
      _ -> [],
    }))
}

fn with_declared_mode(checker: Checker, entry: Effect) -> Effect / {abort.raise} =
  match entry.operation {
    None -> entry,
    Some(name) -> match effect_of(checker, entry.effect) {
      None -> entry,
      Some(info) -> match operation_named(info, name) {
        Some(o) -> { ..entry, mode: o.mode },
        None -> entry,
      },
    },
  }

fn effects_of_cached(checker: Checker, effects: List<Effect>) -> Effects / {abort.raise} =
  {
    listed: effects_sorted(effects.map(|entry: Effect| with_declared_mode(checker, entry))),
    variable: None,
  }

fn cached_rows(checker: Checker, name: Bytes) -> Option<CachedDefinition> =
  checker.known.definitions.get(name)

fn group_callee_kind(
  checker: Checker,
  qualified: List<Bytes>,
  qualified_name: QName,
) -> Callee / {abort.raise} =
  if starts_upper(qualified_name.name.name) { ConstructorCallee } else {
    match declared_value(checker, qualified_name) {
      Some(n) ->
        range(0, qualified.len()).fold(DefinedCallee(n), |accumulator: Callee, i: Int|
          if qualified.get(i) == n { GroupMember(i) } else { accumulator }),
      None -> match look_up_language_type(checker, qualified_name) {
        Found(m) -> if m.qualified_name.module == None { BuiltinCallee(m.callee) }
        else { OtherCallee },
        _ -> if is_bare(qualified_name)
            && env_lookup(checker.env, qualified_name.name.name) != None {
          BuiltinCallee(qualified_name.name.name)
        } else { OtherCallee },
      },
    }
  }

fn numeric_slot(operation: Bytes) -> Option<Int> / {abort.raise} =
  range(0, numeric_operations.len()).fold(None, |found: Option<Int>, i: Int|
    match found {
      Some(_) -> found,
      None -> if numeric_operations.get(i) == operation { Some(i) } else { None },
    })

fn bind_signature(
  accumulator: BoundSignatures,
  parsed: ParsedModule,
  definition: FnDefinition,
  name: Bytes,
) -> BoundSignatures / {abort.raise} = {
  let s: WithSignature = written_signature(
    { ..accumulator.checker, derived: derived_of(parsed, definition) },
    definition,
  );
  let scheme = member_scheme(s.checker, definition, s.sig);
  let labels = definition.generics.labels.fold([], |vs: List<Int>, label_parameter: Identifier|
    match s.sig.label_params.get(label_parameter.name) { Some(v) -> vs.push(v), None -> vs });
  let types = definition.generics.types.fold(
    [],
    |ps: List<RigidParam>, type_parameter: Identifier|
      match s.sig.type_params.get(type_parameter.name) {
        Some(VariableType(v)) -> if scheme.type_variables.contains(v) {
          ps.push({ name: type_parameter.name, var: v })
        } else { ps },
        _ -> ps,
      },
  );
  let constraints = definition_constraints(
    { ..s.checker, type_params: s.sig.type_params },
    definition,
    scheme,
  );
  let bound: Checker = {
    ..s.checker,
    derived: None,
    env: env_bind_global(s.checker.env, name, scheme),
    constraints: s.checker.constraints.insert(name, constraints),
    parameter_modes: s.checker.parameter_modes.insert(name, {
      name: definition.name.name,
      params: definition.params.map(parameter_mode),
    }),
  };
  {
    checker: set_definition(bound, {
      name: name,
      module: parsed.name,
      simple_name: definition.name.name,
      scheme: scheme,
      effects: resolve_effects_in(bound, s.sig.published_effects).listed,
      performed: [],
      scaling: [],
      repeats: [],
      promised_bounded: s.sig.promised_bounded.map(|a: Effect|
        resolve_effect(bound.substitution, a)),
      variable_bounded: s.sig.variable_bounded,
      ending: Terminates,
      summary: unknown_summary,
      raises: [],
      effect_aliases: effect_aliases(definition),
      constraints: constraints,
      spec: [],
      at: location_of(bound, definition.span),
    }),
    sigs: accumulator.sigs.push(s.sig),
    members: accumulator.members.push({ name: name, labels: labels, types: types }),
  }
}

type BodySource = | BodyChecked | Taken | FromSignature

fn check_function(
  checker: Checker,
  parsed: ParsedModule,
  definition: FnDefinition,
  name: Bytes,
  sig: Signature,
  member: GroupDefinition,
  stated: Map<Bytes, InstanceFunctions>,
  results: (Bytes) -> Option<Type> / {abort.raise},
) -> { checker: Checker, body: ClosedBody, left: BodySource } / {abort.raise} =
  match reused_body(checker, name) {
    Some(reused) -> {
      let o = reused_function(checker, parsed, definition, name, sig, member, reused);
      { checker: o.checker, body: o.body, left: Taken }
    },
    None -> if !checks_body(checker, name) && cached_rows(checker, name) == None {
      let recorded: Checker = {
        ..checker,
        seeded: checker.seeded.push(name),
        cached: checker.cached.push({ name: name, facts: b"" }),
      };
      let p = record_function(
        recorded,
        parsed,
        definition,
        name,
        sig,
        resolve_effects_in(recorded, sig.published_effects),
      );
      {
        checker: p.checker,
        body: body_of_signature(p.checker, sig, p.effects, p.written),
        left: FromSignature,
      }
    } else { checked_or_cached(checker, parsed, definition, name, sig, member, stated, results) },
  }

fn reused_function(
  checker: Checker,
  parsed: ParsedModule,
  definition: FnDefinition,
  name: Bytes,
  sig: Signature,
  member: GroupDefinition,
  reused: ReusedBody,
) -> { checker: Checker, body: ClosedBody } / {abort.raise} =
  match ((
      effects_with_label_variables(reused.body.listed, member.labels),
      effects_with_label_variables(
        reused.body.performs.map(|s: PerformSite| s.entry),
        member.labels,
      ),
    )) {
    (Some(effects), Some(performed)) -> {
      let recorded: Checker = {
        ..checker,
        seeded: checker.seeded.push(name),
        cached: checker.cached.push({ name: name, facts: reused.facts }),
      };
      let effects = {
        ..effects_of_cached(recorded, effects),
        variable: if reused.body.has_effect_variable {
          resolve_effects_in(recorded, sig.published_effects).variable
        } else { None },
      };
      let p = record_function(recorded, parsed, definition, name, sig, effects);
      {
        checker: p.checker,
        body: {
          ..body_of_signature(p.checker, sig, p.effects, p.written),
          performs: range(0, performed.len()).map(|i: Int|
            { ..reused.body.performs.get(i), entry: performed.get(i) }),
          repeated: reused.body.repeated,
          raise_notes: reused.body.raise_notes,
          refs: reused.body.refs,
          calls: reused.body.calls,
          stated: reused.body.stated,
          tags: reused.body.tags,
          fills: reused.body.instantiations,
          names: reused.body.names,
        },
      }
    },
    _ -> panic("the checked function body refers to a label that its definition does not declare"),
  }

fn checked_or_cached(
  checker: Checker,
  parsed: ParsedModule,
  definition: FnDefinition,
  name: Bytes,
  sig: Signature,
  member: GroupDefinition,
  stated: Map<Bytes, InstanceFunctions>,
  results: (Bytes) -> Option<Type> / {abort.raise},
) -> { checker: Checker, body: ClosedBody, left: BodySource } / {abort.raise} = {
  let cached_definition = cached_rows(checker, name);
  let taken: Option<{ checker: Checker, effects: Effects, count: Count }> = match cached_definition {
    None -> None,
    Some(rows) -> match ((
        effects_with_label_variables(rows.effects, member.labels),
        effects_with_label_variables(rows.performed, member.labels),
        effects_with_label_variables(rows.unbounded_effects, member.labels),
      )) {
      (Some(effects), Some(performed), Some(scaling)) -> {
        let u = unify_effects(checker.substitution, checker.fresh, sig.published_effects, {
          ..effects_of_cached(checker, effects),
          variable: resolve_effects_in(checker, sig.published_effects).variable,
        });
        match u.error {
          Some(_) -> None,
          None -> {
            let c: Checker = with_unified(checker, u);
            Some({
              checker: c,
              effects: effects_of_cached(c, performed),
              count: {
                repeated_effects: effects_of_cached(c, scaling).listed,
                sites: [],
                repeats: rows.repeated_parameters,
                variable_over: None,
                recursed: None,
                raises: rows.raises,
              },
            })
          },
        }
      },
      _ -> None,
    },
  };
  let stepped: { checker: Checker, body: ClosedBody } = match taken {
    Some(x) -> {
      let recorded: Checker = {
        ..x.checker,
        seeded: x.checker.seeded.push(name),
        cached: x.checker.cached.push({
          name: name,
          facts: match cached_definition { Some(rows) -> rows.ownership_facts, None -> b"" },
        }),
      };
      let p = record_function(recorded, parsed, definition, name, sig, x.effects);
      {
        checker: p.checker,
        body: {
          ..body_of_signature(p.checker, sig, p.effects, p.written),
          recorded: cached_definition,
          count: Some(x.count),
        },
      }
    },
    None -> {
      let o: InferredBody = check_function_body(
        { ..checker, derived: derived_of(parsed, definition), current_definition: name },
        definition,
        sig,
      );
      let walked: Checker = { ..o.checker, derived: None, current_definition: b"" };
      let members = walked.member_calls.drop(checker.member_calls.len());
      let calls = if stated.len() == 0 { members } else {
        members.concat(
          instance_calls(walked, stated, results, {
            numerics: walked.numerics.drop(checker.numerics.len()),
            comparisons: walked.comparisons.drop(checker.comparisons.len()),
            map_keys: walked.map_keys.drop(checker.map_keys.len()),
            constrained: walked.constrained_uses.drop(checker.constrained_uses.len()),
          }),
        )
      };
      let resolved: Checker = check_columns(
        check_bit_operations(check_numerics(check_concats(check_updates(walked)))),
      );
      let tree = typed_body(walked, checker.typed_bodies.len(), name, WholeBody);
      let ownership_result = ownership_errors(
        check_borrowed_functions(
          close_unreachable_effects(
            check_bounded_effects(
              require_written_signature(resolved, definition, sig),
              definition,
              sig,
            ),
            sig,
          ),
          definition,
          tree,
        ),
        definition,
        name,
        sig,
        tree,
      );
      let effects = ownership_result.released.fold(o.effects, |r: Effects, a: Effect|
        { ..r, listed: effects_insert(r.listed, a) });
      let p = record_function(ownership_result.checker, parsed, definition, name, sig, effects);
      let c = p.checker;
      let published = resolve_effects_in(c, sig.published_effects);
      let parameter_effect_variables = sig.params.map(|ty: Type|
        effects_in(c, ty, { listed: [], vars: [] }).vars);
      let own = member.types.map(|t: RigidParam| t.var);
      let naming = member.types.fold(printer_new, |printer: Printer, t: RigidParam|
        printer_naming(printer, t.var, t.name));
      {
        checker: c,
        body: {
          ..body_of_signature(c, sig, p.effects, p.written),
          performs: o.performs.map(|site: PerformSite|
            { ..site, entry: resolve_effect(c.substitution, site.entry) }),
          repeated: o.repeated_variables.map(|r: RepeatedEffectVariable| {
            let v = match resolve_effects_in(c, open_effects(r.var)).variable {
              Some(v) -> v,
              None -> r.var,
            };
            {
              params: range(0, parameter_effect_variables.len()).filter(|i: Int|
                parameter_effect_variables.get(i).contains(v)),
              variable: published.variable == Some(v),
              iteration_span: r.over,
              pending_iterations: r.pending_iterations,
            }
          }),
          raise_notes: o.raise_notes,
          refs: o.refs,
          calls: o.calls,
          stated: calls,
          tags: o.tag_uses.map(|u: TagUse|
            {
              name: u.name,
              rejection: error_at(
                b"E0152",
                c.module,
                u.literal.tag.span,
                Bytes::concat_all([
                  b"`",
                  u.literal.tag.name,
                  b"::",
                  u.callee.name.name,
                  b"` is part of a cycle with the function that contains the tag value",
                ]),
                b"a tag must be fully checked before any value of that tag is checked",
                [tag_rule(u.literal)],
              ),
            }),
          fills: o.fills.map(|f: GroupInstantiation|
            {
              module: f.module,
              span: f.span,
              callee: f.callee,
              grows: range(0, f.args.len()).fold(
                [],
                |accumulator: List<GrowingArgument>, i: Int| {
                  let ty = resolve(c, f.args.get(i));
                  let grows = match ty {
                    VariableType(_) -> false,
                    _ ->
                      free_variables(c.substitution, ty, {
                        types: [],
                        effect_variables: [],
                      }).types.fold(false, |b: Bool, v: Int| b || own.contains(v)),
                  };
                  if grows { accumulator.push({ param: i, ty: print_type(naming, ty).text }) }
                  else { accumulator }
                },
              ),
            }),
          names: named_callees(c, definition),
        },
      }
    },
  };
  {
    checker: record_spec_env(stepped.checker, definition, name, sig),
    body: stepped.body,
    left: match taken { None -> BodyChecked, Some(_) -> Taken },
  }
}

fn check_borrowed_functions(
  checker: Checker,
  definition: FnDefinition,
  body: Option<WalkedExpression>,
) -> Checker / {abort.raise} =
  match body {
    Some(b) -> if !borrowing::has_borrowed_parameter(definition) { checker } else {
      borrowing::escape_diagnostics(checker.module, definition, b, {
        takes: |n: Bytes| checker.parameter_modes.get(n),
      }).fold(
        checker,
        report,
      )
    },
    None -> checker,
  }

fn ownership_errors(
  checker: Checker,
  definition: FnDefinition,
  name: Bytes,
  sig: Signature,
  body: Option<WalkedExpression>,
) -> { checker: Checker, released: List<Effect> } / {abort.raise} = {
  let keep_variables = definition.generics.retained_types.fold(
    [],
    |accumulator: List<Int>, identifier: Identifier|
      match sig.type_params.get(identifier.name) {
        Some(VariableType(v)) -> accumulator.push(v),
        _ -> accumulator,
      },
  );
  let resource = |t: Type| is_resource_type(checker, keep_variables, t);
  let params = zip(definition.params, sig.params).map(|p: { first: Param, second: Type }|
    { name: p.first.name.name, span: p.first.name.span, ty: p.second, keep: p.first.keep });
  let j = check_body_ownership(
    check_keep_params(checker, definition, sig, resource),
    { resource: resource, owner: name },
    params,
    body,
  );
  let effects_checked = check_release_effects(j.checker, definition, sig, j.held);
  { checker: effects_checked, released: unhandled_release_effects(effects_checked, j.held) }
}

fn typed_body(
  checker: Checker,
  from: Int,
  owner: Bytes,
  part: BodyPart,
) -> Option<WalkedExpression> =
  match checker.typed_bodies.drop(from).find(|t: WalkedTree| t.owner == owner && t.part == part) {
    Some(t) -> Some(t.body),
    None -> None,
  }

fn unhandled_release_effects(
  checker: Checker,
  owned_values: List<ownership::OwnedValue>,
) -> List<Effect> / {abort.raise} =
  owned_values.fold([], |accumulator: List<Effect>, x: ownership::OwnedValue|
    unhandled_effects(checker, x).fold(accumulator, |xs: List<Effect>, a: Effect|
      effects_insert(xs, a)))

type OwnershipRules = { resource: (Type) -> Bool / {abort.raise}, owner: Bytes }

fn check_body_ownership(
  checker: Checker,
  j: OwnershipRules,
  params: List<ownership::Param>,
  body: Option<WalkedExpression>,
) -> { checker: Checker, held: List<ownership::OwnedValue> } / {abort.raise} =
  match body {
    None -> { checker: checker, held: [] },
    Some(b) -> {
      let facts: ownership::Facts = {
        module: checker.module,
        resource: j.resource,
        resolved: |t: Type| resolve(checker, t),
        taking: |key: Bytes|
          match checker.parameter_modes.get(key) {
            Some(t) -> Some({ taken_indices: keep_parameter_indexes(t.params), all: false }),
            None -> None,
          },
        operation_consumed_parameters: |name: Bytes, operation: Bytes|
          match effect_info(checker, name) {
            Some(e) -> match e.operations.find(|o: OperationInfo| o.name == operation) {
              Some(o) -> o.keep_indices,
              None -> [],
            },
            None -> [],
          },
        opened: |t: Type|
          match resolve(checker, t) {
            NamedType(c) -> checker.release_functions.contains(c.name),
            NominalType(n) -> checker.release_functions.contains(n.name),
            _ -> false,
          },
      };
      if !params.any(|p: ownership::Param| j.resource(p.ty))
          && !ownership::needs_ownership_check(facts, b) { { checker: checker, held: [] } } else {
        let o = ownership::check_ownership(facts, params, b);
        let rejected = o.diagnostics.fold(
          {
            ..checker,
            release_sites: checker.release_sites.concat(
              o.releases.map(|r: ownership::Release|
                {
                  module: checker.module,
                  owner: j.owner,
                  at: r.at.site,
                  release: { holder: r.holder, place: r.place },
                }),
            ),
          },
          report,
        );
        {
          checker: check_lambda_release_effects(
            check_resource_copies(rejected, b, j.resource),
            o.owned_values,
          ),
          held: o.owned_values.filter(|x: ownership::OwnedValue| x.effects == None),
        }
      }
    },
  }

fn keep_parameter_indexes(params: List<ParameterMode>) -> List<Int> =
  params.fold(
    { at: 0, retained: [] },
    |accumulator: { at: Int, retained: List<Int> }, p: ParameterMode|
      {
        at: accumulator.at + 1,
        retained: if p.keep { accumulator.retained.push(accumulator.at) }
        else { accumulator.retained },
      },
  ).retained

fn check_keep_params(
  checker: Checker,
  definition: FnDefinition,
  sig: Signature,
  resource: (Type) -> Bool / {abort.raise},
) -> Checker / {abort.raise} =
  range(0, definition.params.len()).fold(checker, |c: Checker, i: Int| {
    let p = definition.params.get(i);
    match sig.params.at(i) {
      Some(t) -> if !p.keep || resource(t)
          || (match resolve(c, t) { FunctionType(_) -> true, _ -> false }) { c } else {
        report_error_at(
          c,
          b"E0323",
          p.name.span,
          Bytes::concat_all([
            b"`",
            p.name.name,
            b"` is declared `keep`, but values of its type are copied anyway",
          ]),
          Bytes::concat_all([b"a `", type_text(resolve(c, t)), b"` is not a resource"]),
          [
            b"`keep` means the called function takes ownership of the argument, so it is only for a resource, a function the callee may store, or a type parameter declared `keep` (which may be given a resource)",
            b"remove `keep`",
          ],
        )
      },
      None -> c,
    }
  })

fn check_resource_copies(
  checker: Checker,
  e: WalkedExpression,
  resource: (Type) -> Bool / {abort.raise},
) -> Checker / {abort.raise} =
  walked_expression_nodes_folded(e, checker, |c: Checker, x: WalkedExpression|
    match x.node {
      WalkedRead(WalkedDefinition(d)) -> match definition_of(c, d.key) {
        None -> c,
        Some(info) ->
          zip(info.scheme.type_variables, d.args).fold(
            c,
            |cc: Checker, v: { first: Int, second: Type }|
              if info.scheme.keep_variables.contains(v.first) || !resource(v.second) { cc } else {
                report_error_at(
                  cc,
                  b"E0317",
                  x.span,
                  Bytes::concat_all([
                    b"`",
                    simple_name_of(d.full),
                    b"` may copy what it is handed, and `",
                    type_text(resolve(cc, v.second)),
                    b"` is a resource",
                  ]),
                  b"a type parameter not declared `keep` is given a resource here",
                  [
                    b"a definition may copy values of a type parameter unless the parameter is declared `keep`, as in `<keep a>`, which allows the body to use each value only once",
                  ],
                )
              },
          ),
      },
      _ -> c,
    })

fn effect_info(checker: Checker, name: Bytes) -> Option<EffectInfo> =
  checker.effects.find(|e: EffectInfo| e.name == name)

fn check_release_effects(
  checker: Checker,
  definition: FnDefinition,
  sig: Signature,
  owned_values: List<ownership::OwnedValue>,
) -> Checker / {abort.raise} =
  match sig.declared {
    None -> checker,
    Some(written) -> {
      let declared = resolve_effects_in(checker, written).listed;
      owned_values.fold(checker, |c: Checker, x: ownership::OwnedValue| {
        let t = x.ty;
        unhandled_effects(c, x).fold(c, |cc: Checker, a: Effect|
          if effects_cover(declared, a) { cc } else {
            report_error_at(
              cc,
              b"E0302",
              definition.name.span,
              Bytes::concat_all([
                b"`",
                definition.name.name,
                b"` lets go of a `",
                type_text(t),
                b"`, whose release performs `",
                effect_text(a),
                b"`, which its effects do not name",
              ]),
              b"a value it owns is let go here or where its block ends",
              [
                b"a value of a type that states a `release` is let go by it wherever nothing consumed it, a raise or a cancel included, so effects that contain one include what the release does",
                Bytes::concat_all([b"add `", effect_text(a), b"` to the effects"]),
              ],
            )
          })
      })
    },
  }

fn unhandled_effects(checker: Checker, x: ownership::OwnedValue) -> List<Effect> / {abort.raise} =
  release_effect_list(checker, x.ty).fold([], |accumulator: List<Effect>, a: Effect|
    accumulator.concat(operation_effects(checker, a))).filter(|a: Effect|
    match a.operation {
      Some(o) -> !x.returned.contains(Bytes::concat_all([a.effect, b".", o])),
      None -> true,
    })

fn operation_effects(checker: Checker, a: Effect) -> List<Effect> =
  match a.operation {
    Some(_) -> [a],
    None -> match effect_info(checker, a.effect) {
      Some(e) -> {
        let operations = e.operations.filter(|o: OperationInfo| o.mode == a.mode);
        if operations.len() == 0 { [a] }
        else { operations.map(|o: OperationInfo| { ..a, operation: Some(o.name) }) }
      },
      None -> [a],
    },
  }

fn check_lambda_release_effects(
  checker: Checker,
  owned_values: List<ownership::OwnedValue>,
) -> Checker / {abort.raise} =
  owned_values.fold(checker, |c: Checker, x: ownership::OwnedValue|
    match x.effects {
      None -> c,
      Some(r) -> {
        let effects = resolve_effects_in(c, r).listed;
        unhandled_effects(c, x).fold(c, |cc: Checker, a: Effect|
          if effects_cover(effects, a) { cc } else {
            report_error_at(
              cc,
              b"E0302",
              x.at,
              Bytes::concat_all([
                b"`",
                x.name,
                b"` is let go in a function whose effects do not name `",
                effect_text(a),
                b"`, which the release of this value performs",
              ]),
              b"this function owns the value, and releases it where its block ends or when a raise or cancel exits the block early",
              [
                b"add that effect to the function's effects, or wrap the value in a `handle` that handles the effect",
              ],
            )
          })
      },
    })

fn record_function(
  checker: Checker,
  parsed: ParsedModule,
  definition: FnDefinition,
  name: Bytes,
  sig: Signature,
  effects: Effects,
) -> { checker: Checker, effects: Effects, written: { scaling: List<Effect>, repeats: List<Int> } } / {abort.raise} = {
  let c: Checker = { ..checker, env: env_remove_global(checker.env, name) };
  let body_effects = resolve_effects_in(c, effects);
  let overran = match definition.effects {
    Some(_) -> false,
    None ->
      definition.constant == None
        && (body_effects.listed.len() > 0 || body_effects.variable != None),
  };
  let fn_type = if overran { function_type(sig.params, sig.return_type, body_effects) }
  else { sig.fn_type };
  let g: Generalization = generalize(c.substitution, c.env, fn_type);
  let scheme: Scheme = split_labels(g.scheme, definition, sig);
  let effects = if overran { body_effects } else { resolve_effects_in(c, sig.published_effects) };
  let bounded = sig.promised_bounded.map(|a: Effect| resolve_effect(c.substitution, a));
  let bound: Checker = {
    ..c,
    env: env_bind_global(g.env, name, scheme),
    type_params: sig.type_params,
  };
  let constraints = definition_constraints(bound, definition, scheme);
  let ordered: Checker = witness_order(bound, definition, scheme);
  {
    checker: set_definition(
      {
        ..ordered,
        type_params: Map::new(),
        constraints: ordered.constraints.insert(name, constraints),
      },
      {
        name: name,
        module: parsed.name,
        simple_name: definition.name.name,
        scheme: scheme,
        effects: effects.listed,
        performed: body_effects.listed,
        scaling: [],
        repeats: [],
        promised_bounded: bounded,
        variable_bounded: sig.variable_bounded,
        ending: Terminates,
        summary: unknown_summary,
        raises: [],
        effect_aliases: effect_aliases(definition),
        constraints: constraints,
        spec: [],
        at: location_of(bound, definition.span),
      },
    ),
    effects: body_effects,
    written: written_counts(fn_type, effects.listed, bounded, sig.variable_bounded),
  }
}

fn body_of_signature(
  checker: Checker,
  sig: Signature,
  effects: Effects,
  written: { scaling: List<Effect>, repeats: List<Int> },
) -> ClosedBody / {abort.raise} = {
  let published = resolve_effects_in(checker, sig.published_effects);
  {
    effects: effects,
    label_params: sig.label_params,
    recorded: None,
    count: None,
    params: sig.params.map(|ty: Type| resolve(checker, ty)),
    variable: published.variable,
    promised_bounded: sig.promised_bounded.map(|a: Effect| {
      let entry = resolve_effect(checker.substitution, a);
      { entry: entry, written: written_effect_text(checker, entry) }
    }),
    variable_bounded: sig.variable_bounded,
    variable_name: match published.variable {
      Some(v) ->
        sig.effect_params.fold(None, |found: Option<Bytes>, n: Bytes, w: Int|
          match found { Some(_) -> found, None -> if w == v { Some(n) } else { None } }),
      None -> None,
    },
    says_diverges: published.listed.fold(false, |found: Bool, a: Effect| found || is_diverges(a)),
    written: written,
    performs: [],
    repeated: [],
    raise_notes: [],
    refs: [],
    calls: [],
    stated: [],
    tags: [],
    fills: [],
    names: [],
  }
}

fn named_callees(checker: Checker, definition: FnDefinition) -> List<NamedCallee> / {abort.raise} =
  names_read(definition).fold([], |accumulator: List<NamedCallee>, q: QName|
    if local_at(checker, q) != None { accumulator } else {
      accumulator.push({ site: q.name.span.site, callee: group_callee_kind(checker, [], q) })
    })

fn member_or(qualified: List<Bytes>, callee: Callee) -> Callee / {abort.raise} =
  match callee {
    DefinedCallee(n) ->
      range(0, qualified.len()).fold(callee, |kind: Callee, i: Int|
        if qualified.get(i) == n { GroupMember(i) } else { kind }),
    other -> other,
  }

fn finish_group(checker: Checker, m: ModuleFunctions, comp: List<Int>) -> Checker / {abort.raise} = {
  let qualified = comp.map(|i: Int| m.names.get(i));
  let definitions = comp.map(|i: Int| m.functions.get(i));
  let members = comp.map(|i: Int| m.members.get(i));
  let bodies = comp.map(|i: Int| m.bodies.get(i));
  let grouped: Checker = { ..checker, group_definitions: members };
  let tagged: Checker = bodies.fold(grouped, |c: Checker, b: ClosedBody|
    b.tags.fold(c, |cc: Checker, u: TagRejection|
      if qualified.contains(u.name) { report(cc, u.rejection) } else { cc }));
  let counts = range(0, comp.len()).map(|slot: Int|
    match bodies.get(slot).count {
      Some(count) -> count,
      None -> body_effect_count(tagged, definitions.get(slot), bodies.get(slot)),
    });
  let recorded = bodies.map(|b: ClosedBody| b.recorded);
  let walked = recorded.fold(false, |any: Bool, k: Option<CachedDefinition>| any || k == None);
  let names = bodies.map(|b: ClosedBody|
    b.names.fold(Map::new(), |callees_by_site: Map<Int, Callee>, x: NamedCallee|
      callees_by_site.insert(x.site, member_or(qualified, x.callee))));
  let named = |slot: Int, qualified_name: QName| {
    let through = match qualified_name.module { Some(x) -> x.name, None -> b"" };
    if through == prelude_binder { BuiltinCallee(qualified_name.name.name) } else {
      match method_binder_module(through) {
        Some(home) -> member_or(qualified, DefinedCallee(qualify(home, qualified_name.name.name))),
        None -> match names.at(slot) {
          Some(read) -> match read.get(qualified_name.name.span.site) {
            Some(callee) -> callee,
            None -> OtherCallee,
          },
          None -> OtherCallee,
        },
      }
    }
  };
  let stated = bodies.map(|b: ClosedBody|
    b.stated.fold(Map::new(), |calls_by_site: Map<Int, List<Callee>>, call: OwnCall| {
      let key = call.span.site;
      calls_by_site.insert(
        key,
        List::push(
          match calls_by_site.get(key) { Some(cs) -> cs, None -> [] },
          member_or(qualified, DefinedCallee(call.callee)),
        ),
      )
    }));
  let read: Verdict = if !walked { { endings: [], summaries: [] } } else {
    verdict({
      definitions: range(0, definitions.len()).map(|slot: Int|
        expand_function_member_calls(
          definitions.get(slot),
          match m.written.get(qualified.get(slot)) { Some(w) -> w, None -> Map::new() },
        )),
      names: qualified,
      params: bodies.map(|b: ClosedBody| b.params),
      resolve: named,
      binders: definitions.map(|d: FnDefinition|
        item_binders(tagged.resolved, tagged.module, FunctionItem(d))),
      implicit_callees: |slot: Int, span: Span|
        match stated.at(slot) {
          Some(s) -> match s.get(span.site) { Some(cs) -> cs, None -> [] },
          None -> [],
        },
      ending_of: |n: Bytes|
        match definition_of(tagged, n) { Some(d) -> d.ending, None -> Terminates },
      summary_of: |n: Bytes| tagged.summaries.get(n),
    })
  };
  let ending_of = |slot: Int|
    match recorded.get(slot) { Some(k) -> k.ending, None -> read.endings.get(slot) };
  let summary_of = |slot: Int|
    match recorded.get(slot) { Some(k) -> k.summary, None -> read.summaries.get(slot) };
  let summarized: Checker = {
    ..tagged,
    summaries: range(0, comp.len()).fold(
      tagged.summaries,
      |accumulator: Map<Bytes, Summary>, slot: Int|
        accumulator.insert(qualified.get(slot), summary_of(slot)),
    ),
  };
  let grown: Checker = bodies.fold(summarized, |c: Checker, b: ClosedBody|
    reject_growth(c, members, b.fills));
  let divergence_checked: Checker = range(0, comp.len()).fold(grown, |c: Checker, slot: Int|
    require_declared_divergence(
      if c.module >= c.known.root { c }
      else { check_bounded_promises(c, bodies.get(slot), counts.get(slot)) },
      definitions.get(slot),
      bodies.get(slot).says_diverges,
      ending_of(slot),
      |caller: Bytes|
        range(0, comp.len()).fold(0, |start: Int, k: Int|
          if qualified.get(k) == caller { definitions.get(k).span.start } else { start }),
    ));
  let raised_inside = counts.fold(false, |any: Bool, count: Count| any || count.raises.len() > 0)
    && counts.fold(true, |inside: Bool, count: Count|
      inside && count.raises.fold(true, |ok: Bool, r: Raise| ok && raised_within(qualified, r)));
  let published: Checker = range(0, comp.len()).fold(divergence_checked, |c: Checker, slot: Int|
    match definition_of(c, qualified.get(slot)) {
      None -> c,
      Some(info) -> {
        let definition = definitions.get(slot);
        let count = counts.get(slot);
        let performed = if raised_inside { info.performed.filter(|a: Effect| !is_abort(a)) }
        else { info.performed };
        let counted = if c.module >= c.known.root { bodies.get(slot).written } else {
          {
            scaling: info.effects.fold([], |accumulator: List<Effect>, w: Effect|
              if count.repeated_effects.fold(false, |b: Bool, a: Effect|
                  b || effects_cover([w], a)) { accumulator.push(w) }
              else { accumulator }),
            repeats: count.repeats,
          }
        };
        set_definition(noted_unperformed(c, definition, bodies.get(slot), performed), {
          ..info,
          performed: performed,
          scaling: counted.scaling,
          repeats: counted.repeats,
          ending: ending_of(slot),
          summary: summary_of(slot),
          raises: if raised_inside || definition.constant != None { [] } else { count.raises },
        })
      },
    });
  { ..published, group_definitions: [] }
}

type WrittenEffects = { span: Span, bounded: Bool, effects: List<Effect> }

fn written_entry(
  checker: Checker,
  body: ClosedBody,
  entry: EffectExpression,
) -> List<Effect> / {abort.raise} =
  match convert_effect({ ..checker, label_params: body.label_params }, entry).entry {
    Some(a) -> [resolve_effect(checker.substitution, a)],
    None -> [],
  }

fn written_effects(
  checker: Checker,
  row: EffectsExpression,
  body: ClosedBody,
) -> List<WrittenEffects> / {abort.raise} = {
  let sets = if row.aliases.len() == 0 { [] } else { named_sets(checker) };
  let written_in_row = |a: EffectExpression|
    a.span.start >= row.span.start && a.span.end <= row.span.end;
  let from_set = |a: EffectExpression| row.aliases.any(|set: QName| set.span.start == a.span.start);
  row.listed.filter(|a: EffectExpression| written_in_row(a) && !from_set(a)).map(
    |a: EffectExpression|
      { span: a.span, bounded: a.bounded, effects: written_entry(checker, body, a) },
  ).concat(
    row.aliases.map(|set: QName|
      {
        span: set.span,
        bounded: false,
        effects: sets.filter(|s: NamedSet| s.name == set.name.name).flat_map(
          |s: NamedSet| s.listed,
        ).concat(
          row.listed.filter(|a: EffectExpression| a.span.start == set.span.start).flat_map(
            |a: EffectExpression| written_entry(checker, body, a),
          ),
        ),
      }),
  )
}

fn narrowing_edits(
  checker: Checker,
  definition: FnDefinition,
  row: EffectsExpression,
  items: List<WrittenEffects>,
  unused: List<WrittenEffects>,
) -> Option<List<Edit>> / {abort.raise} = {
  let spans = items.map(|item: WrittenEffects| item.span).sort_by(|a: Span, b: Span|
    a.start < b.start);
  let idle = |s: Span| unused.any(|item: WrittenEffects| item.span.start == s.start);
  let removed = |text: Bytes|
    { module: checker.module, start: row.span.start, end: row.span.end, text: text };
  if unused.any(|item: WrittenEffects| item.bounded) { None } else if unused.len() < spans.len() {
    Some(
      range(0, spans.len()).filter(|i: Int| idle(spans.get(i))).map(|i: Int|
        if range(i + 1, spans.len()).any(|k: Int| !idle(spans.get(k))) {
          { ..removed(b""), start: spans.get(i).start, end: spans.get(i + 1).start }
        } else { { ..removed(b""), start: spans.get(i - 1).end, end: spans.get(i).end } }),
    )
  } else {
    match ((row.variable, definition.return_type)) {
      (Some(t), _) -> if row.variable_bounded { None } else { Some([removed(t.name)]) },
      (None, Some(return_type)) -> Some([{ ..removed(b""), start: type_span(return_type).end }]),
      (None, None) -> None,
    }
  }
}

fn noted_unperformed(
  checker: Checker,
  definition: FnDefinition,
  body: ClosedBody,
  performed: List<Effect>,
) -> Checker / {abort.raise} = {
  let parsed = checker.modules.get(checker.module);
  match definition.effects {
    None -> checker,
    Some(row) -> if checker.module >= checker.known.root || derived_of(parsed, definition) != None
        || schema_of(parsed.module, definition) != None { checker } else {
      let items = written_effects(checker, row, body);
      let unused = items.filter(|item: WrittenEffects|
        item.effects.len() > 0 && !performed.any(|a: Effect| effects_cover(item.effects, a)));
      if unused.len() == 0 { checker } else {
        let warning: Diagnostic = {
          code: b"W0614",
          notes: 0,
          labels: unused.map(|item: WrittenEffects|
            label_at(checker.module, item.span, true, b"never performed")),
          text: b"",
          message: Bytes::concat_all([
            b"`",
            definition.name.name,
            b"` declares effects its body never performs",
          ]),
          notes_text: [],
          severity: b"warning",
          fixes: [],
        };
        {
          ..checker,
          unperformed: checker.unperformed.push(
            match narrowing_edits(checker, definition, row, items, unused) {
              Some(edits) -> with_fix(warning, b"remove them from the effects", edits),
              None -> warning,
            },
          ),
        }
      }
    },
  }
}

fn split_labels(scheme: Scheme, definition: FnDefinition, signature: Signature) -> Scheme = {
  let ids = definition.generics.labels.fold([], |accumulator: List<Int>, identifier: Identifier|
    match signature.label_params.get(identifier.name) {
      Some(v) -> accumulator.push(v),
      None -> accumulator,
    });
  let keep_variables = definition.generics.retained_types.fold(
    [],
    |accumulator: List<Int>, identifier: Identifier|
      match signature.type_params.get(identifier.name) {
        Some(VariableType(v)) -> accumulator.push(v),
        _ -> accumulator,
      },
  );
  {
    type_variables: ints_difference(scheme.type_variables, ids),
    effect_variables: scheme.effect_variables,
    keep_variables: keep_variables.filter(|v: Int| scheme.type_variables.contains(v)),
    label_variables: if ids.len() == 0 { scheme.label_variables } else { ids },
    ty: scheme.ty,
  }
}

fn derived_of(parsed: ParsedModule, definition: FnDefinition) -> Option<DeriveOrigin> =
  parsed.derived.fold(None, |accumulator: Option<DeriveOrigin>, d: DeriveOrigin|
    match accumulator {
      Some(_) -> accumulator,
      None -> if d.span == definition.span { Some(d) } else { None },
    })

fn definition_constraints(
  checker: Checker,
  definition: FnDefinition,
  scheme: Scheme,
) -> List<DefinitionConstraint> / {abort.raise} = {
  let found = definition.constraints.fold(
    [],
    |accumulator: List<DefinitionConstraint>, c: Constraint|
      match checker.type_params.get(c.param.name) {
        Some(VariableType(v)) -> {
          let param = range(0, scheme.type_variables.len()).fold(0 - 1, |p: Int, i: Int|
            if p >= 0 { p } else if scheme.type_variables.get(i) == v { i } else { p });
          if param < 0 { accumulator }
          else { accumulator.push({ deriver: c.deriver, param: param }) }
        },
        _ -> accumulator,
      },
  );
  dedup_constraints(
    found.fold([], |accumulator: List<DefinitionConstraint>, c: DefinitionConstraint|
      insert_constraint(accumulator, c)),
  )
}

fn witness_order(
  checker: Checker,
  definition: FnDefinition,
  scheme: Scheme,
) -> Checker / {abort.raise} = {
  let found = definition.constraints.fold(
    { checker: checker, ranked: [] },
    |accumulator: { checker: Checker, ranked: List<{ at: Int, name: Bytes }> }, c: Constraint|
      if !is_predicate(c.deriver)
          || accumulator.ranked.fold(false, |b: Bool, r: { at: Int, name: Bytes }|
            b || r.name == c.param.name) { accumulator } else {
        match accumulator.checker.type_params.get(c.param.name) {
          Some(VariableType(v)) -> {
            let position = range(0, scheme.type_variables.len()).fold(0 - 1, |p: Int, i: Int|
              if p >= 0 { p } else if scheme.type_variables.get(i) == v { i } else { p });
            if position >= 0 {
              let n = accumulator.ranked.len();
              let i = range(0, n).fold(n, |k: Int, j: Int|
                if k < n { k } else if position < accumulator.ranked.get(j).at { j } else { k });
              {
                checker: accumulator.checker,
                ranked: accumulator.ranked.take(i).push({
                  at: position,
                  name: c.param.name,
                }).concat(
                  accumulator.ranked.drop(i),
                ),
              }
            } else {
              {
                checker: report_error_at(
                  accumulator.checker,
                  b"E0310",
                  c.param.span,
                  Bytes::concat_all([
                    b"`",
                    c.param.name,
                    b"` appears in no parameter or result of `",
                    definition.name.name,
                    b"`",
                  ]),
                  Bytes::concat_all([
                    b"`",
                    deriver_text(c.deriver),
                    b"` needs a type that each call chooses",
                  ]),
                  [
                    b"a call infers the parameter's type from its arguments or result, and no argument or result here determines that type",
                  ],
                ),
                ranked: accumulator.ranked,
              }
            }
          },
          _ -> accumulator,
        }
      },
  );
  if found.ranked.len() == 0 { found.checker } else {
    {
      ..found.checker,
      witness_orders: found.checker.witness_orders.push({
        module: found.checker.module,
        name: definition.name.name,
        params: found.ranked.map(|r: { at: Int, name: Bytes }| r.name),
      }),
    }
  }
}

fn check_function_body(
  outer: Checker,
  definition: FnDefinition,
  signature: Signature,
) -> InferredBody / {abort.raise} = {
  let checker: Checker = {
    ..outer,
    binders: item_binders(outer.resolved, outer.module, FunctionItem(definition)),
    scope: signature.scope,
    type_params: signature.type_params,
    effect_params: signature.effect_params,
    label_params: signature.label_params,
    performs: [],
    over: None,
    pending_iterations: [],
    repeated_variables: [],
    recursed: None,
    refs: [],
    calls: [],
    tag_uses: [],
    group_fills: [],
    declared_effects: match signature.declared {
      Some(r) -> resolve_effects_in(outer, r).listed,
      None -> [],
    },
    effects_written: match definition.effects { Some(_) -> true, None -> false },
    guards: guards::no_guards,
    raise_notes: [],
  };
  let assumed: Checker = note_witness_params(
    { ..checker, assumed: constraints_in_force(checker, definition.constraints) },
    definition.constraints,
  );
  let defaults: Checker = range(0, definition.params.len()).fold(assumed, |c: Checker, i: Int|
    match definition.params.get(i).default {
      None -> c,
      Some(d) -> {
        let o: Inference = infer_whole(
          { ..c, copied: is_pub(definition.visibility) },
          d,
          hint_of(signature.params.get(i)),
        );
        expect_or_widen(
          { ..o.checker, copied: false },
          expression_span(d),
          signature.params.get(i),
          o.ty,
          b"parameter default",
        )
      },
    });
  let pushed: Checker = { ..defaults, env: env_push(defaults.env) };
  let bound: Checker = range(0, definition.params.len()).fold(pushed, |c: Checker, i: Int|
    {
      ..c,
      env: env_bind(c.env, definition.params.get(i).name, monomorphic(signature.params.get(i))),
    });
  let walked: Inference = infer_whole(bound, definition.body, hint_of(signature.return_type));
  let body: Inference = {
    ..walked,
    checker: body_recorded(
      walked.checker,
      bound.current_definition,
      WholeBody,
      definition.span.start,
      params_typed_as(definition.params, signature.params),
      walked,
      definition.body,
    ),
  };
  let checked: Checker = expect_or_widen(
    body.checker,
    expression_span(definition.body),
    signature.return_type,
    body.ty,
    match schema_of(bound.modules.get(bound.module).module, definition) {
      Some(schema) -> if definition.name.name == schema.name.name {
        b"the body of a law must have type `Bool`"
      } else { b"a `where` guard must have type `Bool`" },
      None -> b"function body type",
    },
  );
  let popped: Checker = { ..checked, env: env_pop(checked.env) };
  let shaped: Checker = match definition.constant {
    Some(at) -> check_const_data(popped, definition, at, signature),
    None -> popped,
  };
  let left = effects_outside_definition(resolve_effects_in(shaped, body.effects));
  let effects_checked: Checker = match signature.declared {
    Some(declared) -> check_upper_bound(shaped, definition, declared, left),
    None -> {
      let u = unify_effects(shaped.substitution, shaped.fresh, signature.published_effects, left);
      let c = with_unified(shaped, u);
      match u.error {
        Some(e) -> report_unify(c, e, expression_span(definition.body), b"inferred effects"),
        None -> c,
      }
    },
  };
  {
    checker: {
      ..effects_checked,
      type_params: Map::new(),
      effect_params: Map::new(),
      label_params: Map::new(),
      assumed: [],
      over: None,
      pending_iterations: [],
      repeated_variables: [],
      guards: guards::no_guards,
      raise_notes: [],
      refs: [],
      calls: [],
      tag_uses: [],
      group_fills: [],
    },
    effects: left,
    performs: effects_checked.performs,
    repeated_variables: effects_checked.repeated_variables,
    raise_notes: effects_checked.raise_notes,
    refs: effects_checked.refs,
    calls: effects_checked.calls,
    tag_uses: effects_checked.tag_uses,
    fills: effects_checked.group_fills,
  }
}

fn iteration(
  checker: Checker,
  entry: Effect,
  over: Option<Span>,
  maybe: List<PendingIteration>,
) -> Option<Span> =
  match maybe.fold(None, |found: Option<Span>, m: PendingIteration|
      match found {
        Some(_) -> found,
        None -> if is_group_member(checker, m.callee) { None } else {
          match definition_of(checker, m.callee) {
            None -> None,
            Some(d) -> if match m.param {
                Some(i) -> d.repeats.contains(i),
                None -> repeated_effects_include(d.scaling, entry),
              } { Some(m.span) }
            else { None },
          }
        },
      }) {
    Some(span) -> Some(span),
    None -> over,
  }

fn body_effect_count(
  checker: Checker,
  definition: FnDefinition,
  body: ClosedBody,
) -> Count / {abort.raise} = {
  let again = body.calls.concat(body.stated).fold(
    None,
    |accumulator: Option<Span>, call: OwnCall|
      match accumulator {
        Some(_) -> accumulator,
        None -> if is_group_member(checker, call.callee) { Some(call.span) } else { None },
      },
  );
  let view: Checker = {
    ..checker,
    performs: body.performs.map(|site: PerformSite|
      {
        ..site,
        iteration_span: iteration(
          checker,
          site.entry,
          site.iteration_span,
          site.pending_iterations,
        ),
        pending_iterations: [],
      }),
    raise_notes: body.raise_notes,
    recursed: again,
  };
  let repeated = body.repeated.fold([], |accumulator: List<RepeatedEffects>, r: RepeatedEffects|
    match iteration(checker, no_effect, r.iteration_span, r.pending_iterations) {
      Some(o) -> accumulator.push({ ..r, iteration_span: Some(o), pending_iterations: [] }),
      None -> accumulator,
    });
  let counted = counts_of(view, body.params, body.variable != None, body.effects, repeated);
  {
    repeated_effects: counted.scaling.map(|site: PerformSite| site.entry),
    sites: counted.scaling,
    repeats: counted.repeats,
    variable_over: counted.variable_over,
    recursed: again,
    raises: raises_of(view, definition.span.start),
  }
}

fn is_abort(a: Effect) -> Bool = a.effect == b"abort" && a.operation == Some(b"raise")

fn raise_reason(checker: Checker, name: Bytes) -> RaiseReason =
  if is_group_member(checker, name) { RaisingCall(name) } else {
    match checker.contracts.get(name) {
      Some(c) -> if c.raises { UnguardedBuiltin(name) } else { RaisingFunctionValue },
      None -> match definition_of(checker, name) {
        Some(d) -> if d.effects.fold(false, |any: Bool, a: Effect| any || is_abort(a)) {
          RaisingCall(name)
        } else { RaisingFunctionValue },
        None -> RaisingCall(name),
      },
    }
  }

fn raises_of(checker: Checker, start: Int) -> List<Raise> = {
  let found = checker.performs.fold(
    { out: [], called: [] },
    |accumulator: { out: List<Raise>, called: List<Bytes> }, site: PerformSite|
      if !is_abort(site.entry) || site.module != checker.module { accumulator } else {
        let noted = checker.raise_notes.fold(None, |known: Option<RaiseReason>, n: RaiseNote|
          match known {
            Some(_) -> known,
            None -> if n.span == site.span { Some(n.reason) } else { None },
          });
        let reason = match noted {
          Some(w) -> w,
          None -> match site.source {
            PerformViaCall(name) -> raise_reason(checker, name),
            DirectPerform -> RaisingOperation,
            _ -> RaisingFunctionValue,
          },
        };
        let raise = {
          span: span_between(site.span.start - start, site.span.end - start),
          reason: reason,
        };
        match reason {
          RaisingCall(name) -> if accumulator.called.contains(name) { accumulator }
          else { { out: accumulator.out.push(raise), called: accumulator.called.push(name) } },
          _ -> { ..accumulator, out: accumulator.out.push(raise) },
        }
      },
  ).out;
  found.filter(|r: Raise|
    match r.reason {
      RaisingFunctionValue ->
        !found.fold(false, |inside: Bool, other: Raise|
          inside
            || (other.span != r.span && other.span.start >= r.span.start
            && other.span.end <= r.span.end)),
      _ -> true,
    })
}

fn raised_within(names: List<Bytes>, raise: Raise) -> Bool =
  match raise.reason { RaisingCall(name) -> names.contains(name), _ -> false }

fn counts_of(
  checker: Checker,
  params: List<Type>,
  tailed: Bool,
  body: Effects,
  repeated: List<RepeatedEffects>,
) -> { scaling: List<PerformSite>, repeats: List<Int>, variable_over: Option<Span> } / {abort.raise} = {
  let effects = resolve_effects_in(checker, body);
  let sites = resolved_sites(checker.substitution, checker.performs);
  let scaling = match checker.recursed {
    Some(again) ->
      effects.listed.fold([], |accumulator: List<PerformSite>, entry: Effect| {
        let s = match site_among(sites, entry) {
          Some(x) -> x,
          None ->
            {
              entry: entry,
              module: checker.module,
              span: again,
              source: DirectPerform,
              iteration_span: None,
              pending_iterations: [],
            },
        };
        accumulator.push({ ..s, iteration_span: Some(again) })
      }),
    None ->
      effects.listed.fold([], |accumulator: List<PerformSite>, entry: Effect|
        match sites.fold(None, |found: Option<PerformSite>, s: PerformSite|
            match found {
              Some(_) -> found,
              None -> if s.entry == entry && s.iteration_span != None { Some(s) } else { None },
            }) {
          Some(s) -> accumulator.push(s),
          None -> accumulator,
        }),
  };
  let repeats = range(0, params.len()).fold([], |accumulator: List<Int>, i: Int| {
    let called = match checker.recursed {
      Some(_) -> {
        let parameter_effects = effects_in(checker, params.get(i), { listed: [], vars: [] });
        parameter_effects.vars.len() > 0 || parameter_effects.listed.len() > 0
      },
      None -> repeated.fold(false, |b: Bool, r: RepeatedEffects| b || r.params.contains(i)),
    };
    if called { accumulator.push(i) } else { accumulator }
  });
  let variable_over = if !tailed { None } else {
    match checker.recursed {
      Some(again) -> Some(again),
      None ->
        repeated.fold(None, |found: Option<Span>, r: RepeatedEffects|
          match found {
            Some(_) -> found,
            None -> if r.variable { r.iteration_span } else { None },
          }),
    }
  };
  { scaling: scaling, repeats: repeats, variable_over: variable_over }
}

fn check_bounded_promises(
  checker: Checker,
  body: ClosedBody,
  count: Count,
) -> Checker / {abort.raise} = {
  let effects: Checker = body.promised_bounded.fold(
    checker,
    |c: Checker, w: { entry: Effect, written: Bytes }|
      match count.sites.fold(None, |found: Option<PerformSite>, s: PerformSite|
          match found {
            Some(_) -> found,
            None -> if effects_cover([w.entry], s.entry) { Some(s) } else { None },
          }) {
        None -> c,
        Some(s) -> report_exceeds_bound(c, backticked_text(w.written), s, count.recursed),
      },
  );
  if !body.variable_bounded { effects } else {
    match count.variable_over {
      None -> effects,
      Some(over) ->
        report_exceeds_bound(
          effects,
          match body.variable_name {
            Some(n) -> backticked_text(n).concat(b"'s operations"),
            None -> b"the effect variable",
          },
          {
            entry: no_effect,
            module: effects.module,
            span: over,
            source: PerformViaArguments,
            iteration_span: Some(over),
            pending_iterations: [],
          },
          count.recursed,
        ),
    }
  }
}

const no_effect: Effect =
  { effect: b"", resource: SingletonResource, mode: ReadMode, operation: None }

pub fn written_counts(
  fn_type: Type,
  effects: List<Effect>,
  bounded: List<Effect>,
  variable_bounded: Bool,
) -> { scaling: List<Effect>, repeats: List<Int> } / {abort.raise} =
  {
    scaling: effects.filter(|entry: Effect| !effects_cover(bounded, entry)),
    repeats: if variable_bounded { [] } else {
      match fn_type {
        FunctionType(f) ->
          range(0, f.params.len()).fold([], |accumulator: List<Int>, i: Int|
            if contains_function(f.params.get(i)) { accumulator.push(i) } else { accumulator }),
        _ -> [],
      }
    },
  }

fn report_exceeds_bound(
  checker: Checker,
  what: Bytes,
  site: PerformSite,
  recursed: Option<Span>,
) -> Checker / {abort.raise} = {
  let again = site.iteration_span != None && site.iteration_span == recursed;
  let here = if again { b"the effect is performed here, and again at each recursive call" }
  else if site.iteration_span != Some(site.span) { b"performed here" } else {
    match site.source {
      PerformViaCall(name) ->
        Bytes::concat_all([
          backticked_text(simple_name_of(name)),
          b" performs it once per element of its input",
        ]),
      _ -> b"performed once for each element this iterates over",
    }
  };
  let iteration = match site.iteration_span {
    Some(o) -> if o == site.span || again { [] }
    else { [label_at(site.module, o, false, b"once for each element this iterates over")] },
    None -> [],
  };
  report_error_with_labels(
    checker,
    b"E0465",
    Bytes::concat_all([
      what,
      if what.ends_with(b"operations") {
        b" grow with the input, and the signature promises them `bounded`"
      } else { b" grows with the input, and the signature promises it `bounded`" },
    ]),
    [label_at(site.module, site.span, true, here)].concat(iteration),
    [
      b"a `bounded` operation must run a fixed number of times, not a number that depends on the input",
      b"batch the operation over the whole input into one, or move it out of the iteration",
    ],
  )
}

type Offence = { entry: Effect, site: Option<PerformSite> }

fn offences(
  checker: Checker,
  declared_effects: List<Effect>,
  inf: List<Effect>,
) -> List<Offence> / {abort.raise} =
  inf.fold([], |accumulator: List<Offence>, entry: Effect|
    if effects_cover(declared_effects, entry) { accumulator }
    else { accumulator.push({ entry: entry, site: site_for(checker, entry) }) })

fn named_for(declared_effects: List<Effect>, a: Effect) -> List<Effect> =
  declared_effects.filter(|d: Effect| d.effect == a.effect && d.resource == a.resource)

fn narrowed_site(declared_effects: List<Effect>, site: PerformSite) -> Bool =
  !is_direct(site)
    && (match site.entry.operation {
      None -> named_for(declared_effects, site.entry).len() > 0,
      Some(_) -> false,
    })

fn site_label(declared_effects: List<Effect>, site: PerformSite) -> Bytes / {abort.raise} = {
  let a = effect_text(site.entry);
  let through = match site.source {
    PerformViaCall(name) -> backticked_text(simple_name_of(name)),
    PerformViaFunctionValue -> b"a function value",
    _ -> b"its arguments",
  };
  match site.source {
    DirectPerform -> Bytes::concat_all([b"performs `", a, b"`"]),
    PerformViaArguments -> Bytes::concat_all([b"reaches `", a, b"`"]),
    _ -> if narrowed_site(declared_effects, site) {
      Bytes::concat_all([
        b"reaches `",
        a,
        b"` through ",
        through,
        b", which may perform any of its operations; these effects name only ",
        backticked(named_for(declared_effects, site.entry).map(effect_text), b", "),
      ])
    } else { Bytes::concat_all([b"reaches `", a, b"` through ", through]) },
  }
}

fn narrowed_by_effects(declared_effects: List<Effect>, o: Offence) -> Bool =
  match o.site { Some(s) -> narrowed_site(declared_effects, s), None -> false }

fn effects_edit(checker: Checker, effects: EffectsExpression, text: Bytes) -> Edit =
  match effects.variable {
    None ->
      insertion(
        checker.module,
        effects.span.end - 1,
        if effects.listed.len() + effects.aliases.len() == 0 { text } else { b", ".concat(text) },
      ),
    Some(t) -> if t.span.start == effects.span.start {
      {
        module: checker.module,
        start: effects.span.start,
        end: effects.span.end,
        text: Bytes::concat_all([
          b"{",
          text,
          b" | ",
          t.name,
          if effects.variable_bounded { b" bounded" } else { b"" },
          b"}",
        ]),
      }
    } else { insertion(checker.module, effects.span.start + 1, text.concat(b", ")) },
  }

fn check_upper_bound(
  checker: Checker,
  definition: FnDefinition,
  declared: Effects,
  inferred: Effects,
) -> Checker / {abort.raise} =
  match definition.effects {
    None -> match definition.constant {
      Some(at) -> check_const_effects(checker, definition, at, inferred),
      None -> require_written_effects(checker, definition, inferred),
    },
    Some(_) -> match schema_of(checker.modules.get(checker.module).module, definition) {
      None -> check_written(checker, definition, declared, inferred),
      Some(schema) -> {
        let effects = resolve_effects_in(checker, inferred);
        check_written(
          check_spec_purity(
            checker,
            if definition.name.name == schema.name.name { InSchemaBody } else { InWhere },
            [],
            expression_span(definition.body),
            { listed: effects.listed, variable: None },
          ),
          definition,
          declared,
          { listed: [], variable: effects.variable },
        )
      },
    },
  }

fn effect_param_named(checker: Checker, v: Int) -> Option<Bytes> =
  checker.effect_params.fold(None, |found: Option<Bytes>, name: Bytes, w: Int|
    match found { Some(_) -> found, None -> if w == v { Some(name) } else { None } })

type NamedSet = { name: Bytes, listed: List<Effect> }

fn set_effects_of(
  checker: Checker,
  owner: Int,
  name: Bytes,
) -> Option<List<Effect>> / {abort.raise} =
  match checker.modules.at(owner) {
    None -> None,
    Some(md) ->
      md.module.items.fold(None, |found: Option<List<Effect>>, item: Item|
        match found {
          Some(_) -> found,
          None -> match item {
            EffectSetItem(d) -> if d.name.name == name {
              let there: Checker = {
                ..checker,
                module: owner,
                label_params: Map::new(),
                diagnostics: [],
              };
              Option::traverse(d.expansion, |a: EffectExpression| convert_effect(there, a).entry)
            } else { None },
            _ -> None,
          },
        }),
  }

fn named_sets(checker: Checker) -> List<NamedSet> / {abort.raise} = {
  let scope = scope_of(checker);
  let bound = scope.bound.sets.fold([], |accumulator: List<NamedSet>, b: Binding|
    match set_effects_of(checker, b.owner, b.name) {
      Some(xs) -> accumulator.push({ name: b.name, listed: xs }),
      None -> accumulator,
    });
  scope.modules.filter(is_explicit_binding).fold(
    bound,
    |accumulator: List<NamedSet>, mb: ModuleBinding|
      checker.resolved.declarations.get(mb.target).sets.fold(
        accumulator,
        |a: List<NamedSet>, declared: Declaration|
          if !declared.public { a } else {
            match set_effects_of(checker, mb.target, declared.name) {
              Some(xs) ->
                a.push({ name: Bytes::concat_all([mb.binder, b"::", declared.name]), listed: xs }),
              None -> a,
            }
          },
      ),
  )
}

fn set_before(a: NamedSet, b: NamedSet) -> Bool =
  a.listed.len() > b.listed.len()
    || (a.listed.len() == b.listed.len()
    && (match compare(a.name, b.name) { Less -> true, _ -> false }))

fn folded_into_sets(
  checker: Checker,
  effects: List<Effect>,
) -> { sets: List<Bytes>, rest: List<Effect> } / {abort.raise} = {
  let fits = named_sets(checker).filter(|c: NamedSet|
    c.listed.len() > 0 && c.listed.fold(true, |all: Bool, a: Effect| all && effects.contains(a)));
  let sorted = fits.fold([], |accumulator: List<NamedSet>, c: NamedSet| {
    let n = accumulator.len();
    let i = range(0, n).fold(n, |found: Int, j: Int|
      if found < n { found } else if set_before(c, accumulator.get(j)) { j } else { found });
    range(i, n).fold(accumulator.take(i).push(c), |out: List<NamedSet>, j: Int|
      out.push(accumulator.get(j)))
  });
  let picked = sorted.fold(
    { sets: [], covered: [] },
    |accumulator: { sets: List<Bytes>, covered: List<Effect> }, c: NamedSet|
      if c.listed.fold(true, |all: Bool, a: Effect| all && effects_cover(accumulator.covered, a)) {
        accumulator
      } else {
        { sets: accumulator.sets.push(c.name), covered: accumulator.covered.concat(c.listed) }
      },
  );
  let rest = effects.filter(|a: Effect| !effects_cover(picked.covered, a));
  {
    sets: picked.sets,
    rest: rest.filter(|a: Effect|
      !rest.fold(false, |hit: Bool, x: Effect| hit || (x != a && effect_covers(x, a)))),
  }
}

fn const_rejected(
  checker: Checker,
  definition: FnDefinition,
  at: Span,
  what: Bytes,
  primary: Label,
  notes: List<Bytes>,
) -> Checker =
  report_error_with_labels(
    checker,
    b"E0156",
    Bytes::concat_all([b"`", definition.name.name, b"` is `const`, and ", what]),
    [primary, label_at(checker.module, at, false, b"evaluated once, at its first read")],
    notes,
  )

fn check_const_data(
  checker: Checker,
  definition: FnDefinition,
  at: Span,
  sig: Signature,
) -> Checker / {abort.raise} =
  match derivable(
      ConstantDeriver,
      resolve(checker, sig.return_type),
      algebraic_shapes(checker),
      [],
    ) {
    None -> checker,
    Some(b) -> match b.reason {
      Unconstrained(_) -> checker,
      reason ->
        const_rejected(
          checker,
          definition,
          at,
          b"returns a value that is not data",
          label_at(
            checker.module,
            match definition.return_type { Some(t) -> type_span(t), None -> definition.name.span },
            true,
            Bytes::concat_all([
              b"holds `",
              print_type(printer_new, b.ty).text,
              b"`, ",
              match reason {
                ContainsFunction -> b"a function",
                ContainsHandle -> b"which names a location rather than a value",
                ContainsSecret -> b"a credential",
                _ -> b"which has no stored form",
              },
            ]),
          ),
          [
            b"a constant's value is stored for the whole process as data, and a function, a `Scoped`, a `Task`, a `Chan` and a `Secret` are not data",
          ],
        ),
    },
  }

fn check_const_effects(
  unclosed: Checker,
  definition: FnDefinition,
  at: Span,
  inferred: Effects,
) -> Checker / {abort.raise} = {
  let checker: Checker = match resolve_effects_in(unclosed, inferred).variable {
    None -> unclosed,
    Some(v) -> {
      let u = unify_effects(unclosed.substitution, unclosed.fresh, no_effects, open_effects(v));
      match u.error { Some(_) -> unclosed, None -> with_unified(unclosed, u) }
    },
  };
  resolve_effects_in(checker, inferred).listed.filter(|entry: Effect| !is_raise(entry.mode)).fold(
    checker,
    |c: Checker, entry: Effect| {
      let site = site_for(c, entry);
      let (module, span) = match site {
        Some(s) -> (s.module, s.span),
        None -> (c.module, expression_span(definition.body)),
      };
      if is_diverges(entry) {
        const_rejected(
          c,
          definition,
          at,
          b"may not return",
          label_at(module, span, true, b"this call may not return"),
          [b"a constant is computed with no step budget, so it must end: call only what ends"],
        )
      } else {
        const_rejected(
          c,
          definition,
          at,
          Bytes::concat_all([b"its body performs `", effect_text(entry), b"`"]),
          label_at(module, span, true, match site {
            Some(s) -> site_label([], s),
            None -> b"performed in this body",
          }),
          [
            b"a constant is computed where nothing handles an effect: its body may raise, and performs nothing else",
            b"read a file with `embed`, and handle any other effect inside the body",
          ],
        )
      }
    },
  )
}

fn require_written_effects(
  unclosed: Checker,
  definition: FnDefinition,
  inferred: Effects,
) -> Checker / {abort.raise} = {
  let unclosed_effects = resolve_effects_in(unclosed, inferred);
  let closed: { checker: Checker, forwarded: Bool } = match unclosed_effects.variable {
    None -> { checker: unclosed, forwarded: false },
    Some(v) -> {
      let u = unify_effects(unclosed.substitution, unclosed.fresh, no_effects, open_effects(v));
      match u.error {
        Some(_) -> { checker: unclosed, forwarded: true },
        None -> { checker: with_unified(unclosed, u), forwarded: false },
      }
    },
  };
  let checker = closed.checker;
  let inferred_effects = resolve_effects_in(checker, inferred);
  let forwarded = closed.forwarded;
  if inferred_effects.listed.len() == 0 && !forwarded { checker } else {
    let grouped = folded_into_sets(checker, inferred_effects.listed);
    let effects = grouped.sets.concat(
      grouped.rest.map(|entry: Effect| written_effect_text(checker, entry)),
    );
    let variable: Option<Bytes> = match inferred_effects.variable {
      None -> None,
      Some(v) -> effect_param_named(checker, v),
    };
    let suggested = if effects.len() == 0 { match variable { Some(name) -> name, None -> b"e" } }
    else {
      Bytes::concat_all([
        b"{",
        Bytes::join(effects, b", "),
        match variable { Some(name) -> b" | ".concat(name), None -> b"" },
        b"}",
      ])
    };
    let sites = offences(checker, [], inferred_effects.listed).fold(
      [],
      |accumulator: List<Label>, o: Offence|
        match o.site {
          Some(s) -> accumulator.push(label_at(s.module, s.span, true, site_label([], s))),
          None -> accumulator,
        },
    );
    let primaries = if sites.len() == 0 {
      [
        label_at(
          checker.module,
          expression_span(definition.body),
          true,
          b"body has effects ".concat(effects_text(inferred_effects)),
        ),
      ]
    } else { sites };
    let d: Diagnostic = error_with_labels(
      b"E0302",
      Bytes::concat_all([
        b"`",
        definition.name.name,
        b"` has no `/` effects annotation, so its effects are empty, and its body ",
        if forwarded && effects.len() == 0 { b"forwards effects" } else { b"performs effects" },
      ]),
      primaries.push(
        label_at(
          checker.module,
          definition.name.span,
          false,
          b"no `/` written: the effects are empty",
        ),
      ),
      [
        if inferred_effects.listed.len() > 0 && inferred_effects.variable == None
            && inferred_effects.listed.fold(true, |all: Bool, a: Effect| all && is_diverges(a)) {
          Bytes::concat_all([
            b"a call that may not return makes `",
            definition.name.name,
            b"` one too: write `/ ",
            suggested,
            b"` after the return type, or call only what ends",
          ])
        } else {
          Bytes::concat_all([
            b"a function may perform only the effects its signature declares: write `/ ",
            suggested,
            b"` after the return type, or handle the effects inside `",
            definition.name.name,
            b"`",
          ])
        },
      ],
    );
    let nameable = grouped.rest.fold(true, |all: Bool, entry: Effect|
      all && written_as(checker, entry.effect) != None);
    let fixable = nameable && (!forwarded || variable != None);
    let fixed: Diagnostic = match definition.return_type {
      Some(t) -> if fixable {
        with_fix(d, Bytes::concat_all([b"write the effects `/ ", suggested, b"`"]), [
          insertion(checker.module, type_span(t).end, b" / ".concat(suggested)),
        ])
      } else { d },
      None -> d,
    };
    report(checker, fixed)
  }
}

fn check_bounded_effects(
  checker: Checker,
  definition: FnDefinition,
  sig: Signature,
) -> Checker / {abort.raise} = {
  let effects = resolve_effects_in(checker, sig.published_effects);
  let diverges = effects.listed.fold(false, |found: Bool, a: Effect| found || is_diverges(a));
  let performs = run_needs(effects.listed).len() > 0;
  let written = match definition.effects { Some(r) -> r.span, None -> definition.name.span };
  definition.spec.filter(|c: SpecClause| c.kind == CostClause || c.kind == SpaceClause).fold(
    checker,
    |c: Checker, clause: SpecClause| {
      let what = if clause.kind == CostClause { b"steps" } else { b"space" };
      if diverges && clause.kind == CostClause {
        report(
          c,
          error_with_labels(
            b"E0468",
            Bytes::concat_all([
              b"`",
              definition.name.name,
              b"` bounds its steps, and its effects say it may not return",
            ]),
            [
              label_at(c.module, clause.span, true, b"this bound says every call ends"),
              label_at(c.module, written, false, b"`diverges` is written here"),
            ],
            [b"make its recursion descend and drop `diverges`, or drop the bound"],
          ),
        )
      } else if performs {
        report(
          c,
          error_with_labels(
            b"E0463",
            Bytes::concat_all([
              b"`",
              definition.name.name,
              b"` bounds its ",
              what,
              b", and performs more than a raise",
            ]),
            [
              label_at(c.module, clause.span, true, b"this bound is proved from the body alone"),
              label_at(c.module, written, false, b"its effects are written here"),
            ],
            [
              Bytes::concat_all([
                b"a handler could change the ",
                what,
                b" a call takes, so only a definition that performs nothing but raises states a bound",
              ]),
            ],
          ),
        )
      } else { c }
    },
  )
}

fn require_declared_divergence(
  checker: Checker,
  definition: FnDefinition,
  says_diverges: Bool,
  ending: Termination,
  start_of: (Bytes) -> Int / {abort.raise},
) -> Checker / {abort.raise} =
  match ending {
    Diverges(d) -> if d.through != None || says_diverges { checker }
    else if definition.constant != None {
      const_rejected(
        checker,
        definition,
        match definition.constant { Some(at) -> at, None -> definition.name.span },
        b"may not return",
        label_at(
          checker.module,
          span_between(
            start_of(d.at.caller) + d.at.span.start,
            start_of(d.at.caller) + d.at.span.end,
          ),
          true,
          b"this call back into its group is not seen to descend",
        ),
        [b"a constant is computed with no step budget, so it must end: call only what ends"],
      )
    } else {
      report(
        checker,
        error_with_labels(
          b"E0302",
          Bytes::concat_all([
            b"`",
            definition.name.name,
            b"` may not return, and its effects do not say so",
          ]),
          [
            label_at(
              checker.module,
              span_between(
                start_of(d.at.caller) + d.at.span.start,
                start_of(d.at.caller) + d.at.span.end,
              ),
              true,
              if d.loop.len() > 0 { b"the checker cannot show that this recursive call terminates" }
              else { b"the termination check cannot analyze this recursion" },
            ),
            label_at(
              checker.module,
              match definition.effects { Some(r) -> r.span, None -> definition.name.span },
              false,
              b"no `diverges` written",
            ),
          ],
          [
            b"a recursive call is known to terminate when it passes a smaller part of one of its arguments, or an `Int` that moves toward a bound, provided a guard on the path ensures the `Int` has not reached the bound",
            b"a loop without such a measure can use `iterate`, which limits the number of steps, or state a `decreases` expression that a proof shows gets smaller",
            b"write `diverges` in the effects only of a loop that waits on something outside the program, such as a stream or a peer",
          ],
        ),
      )
    },
    _ -> checker,
  }

fn check_written(
  checker: Checker,
  definition: FnDefinition,
  declared: Effects,
  inferred: Effects,
) -> Checker / {abort.raise} = {
  let ann_span = match definition.effects { Some(r) -> r.span, None -> definition.span };
  let inf = resolve_effects_in(checker, inferred);
  let resolved_declared = resolve_effects_in(checker, declared);
  let extra = offences(checker, resolved_declared.listed, inf.listed);
  let c1: Checker = if extra.len() == 0 { checker } else {
    let names = backticked(extra.map(|o: Offence| effect_text(o.entry)), b", ");
    let sites = extra.fold([], |accumulator: List<Label>, o: Offence|
      match o.site {
        Some(s) ->
          accumulator.push(
            label_at(s.module, s.span, true, site_label(resolved_declared.listed, s)),
          ),
        None -> accumulator,
      });
    let primaries = if sites.len() == 0 {
      [
        label_at(
          checker.module,
          expression_span(definition.body),
          true,
          b"this body performs more than it declares",
        ),
      ]
    } else { sites };
    let notes = if extra.fold(true, |all: Bool, o: Offence| all && is_diverges(o.entry)) {
      [
        Bytes::concat_all([
          b"a call that may not return makes `",
          definition.name.name,
          b"` may not return either: add `diverges` to its effects, or call only functions that return",
        ]),
      ]
    } else {
      [
        Bytes::concat_all([
          b"add ",
          names,
          b" to the `/ {..}` annotation, or handle ",
          if extra.len() == 1 { b"it" } else { b"them" },
          b" inside `",
          definition.name.name,
          b"`",
        ]),
      ]
    };
    let narrowed = extra.fold(false, |accumulator: Bool, o: Offence|
      accumulator || narrowed_by_effects(resolved_declared.listed, o));
    let d: Diagnostic = error_with_labels(
      b"E0302",
      Bytes::concat_all([
        b"effect",
        plural(extra.len()),
        b" not permitted by the signature of `",
        definition.name.name,
        b"`: ",
        names,
      ]),
      primaries.push(
        label_at(
          checker.module,
          ann_span,
          false,
          b"declared effects are ".concat(effects_text(resolved_declared)),
        ),
      ),
      if narrowed {
        notes.push(
          b"when the declared effects list specific operations, a call is allowed only if the called function's effects list the same operations: declare the whole effect without listing operations, or list those operations in the called function's effects",
        )
      } else { notes },
    );
    let fixed: Diagnostic = match definition.effects {
      Some(r) ->
        extra.fold(d, |accumulator: Diagnostic, o: Offence|
          if written_as(checker, o.entry.effect) == None { accumulator } else {
            let text = written_effect_text(checker, o.entry);
            with_fix(accumulator, Bytes::concat_all([b"add `", text, b"` to the effects"]), [
              effects_edit(checker, r, text),
            ])
          }),
      None -> d,
    };
    report(checker, fixed)
  };
  match inf.variable {
    None -> c1,
    Some(v) -> if resolved_declared.variable == Some(v) { c1 } else {
      let u = unify_effects(
        c1.substitution,
        c1.fresh,
        { listed: [], variable: resolved_declared.variable },
        open_effects(v),
      );
      let c2: Checker = with_unified(c1, u);
      match u.error {
        Some(_) ->
          report_error_with_labels(
            c2,
            b"E0302",
            Bytes::concat_all([
              b"the signature of `",
              definition.name.name,
              b"` does not allow all the effects of its body",
            ]),
            [
              label_at(
                c2.module,
                expression_span(definition.body),
                true,
                b"body has effects ".concat(effects_text(inf)),
              ),
              label_at(
                c2.module,
                ann_span,
                false,
                b"the declared effects do not include the effects of the body",
              ),
            ],
            [
              b"add an effect variable to the type parameters, or add the missing effects to the annotation",
            ],
          ),
        None -> c2,
      }
    },
  }
}

pub fn check_numerics(checker: Checker) -> Checker / {abort.raise} = {
  let entries = checker.numerics;
  entries.fold({ ..checker, numerics: [] }, |c: Checker, entry: NumericOperation| {
    let ty = resolve(c, entry.ty);
    let what = if is_order_comparison(entry.operation) { b"ordered comparison" }
    else { b"arithmetic" };
    match ty {
      VariableType(v) -> match c.witnessed.get(v) {
        Some(w) -> if (entry.operation == b"div" || entry.operation == b"rem") && !w.integer {
          report_error_at(
            c,
            b"E0209",
            entry.span,
            Bytes::concat_all([
              b"`",
              operation_text(entry.operation),
              b"` is not defined on every `numeric` type, so not on `",
              w.param,
              b"`",
            ]),
            if entry.operation == b"div" { b"divided here" } else { b"the remainder taken here" },
            [
              Bytes::concat_all([
                b"`integer(",
                w.param,
                b")` admits `/` and `%`; a `Decimal` has no `/`, since its exact quotient is not a decimal, and a type that states its own arithmetic has neither",
              ]),
            ],
          )
        } else { c },
        None ->
          report_error_at(
            c,
            b"E0210",
            entry.span,
            Bytes::concat_all([b"the numeric type of this ", what, b" is not determined"]),
            b"nothing here says which numeric type this is",
            [
              b"the numeric types are `Int`, the eight fixed-width integers, `Float` and `Decimal`, and none of them converts to another automatically",
              b"annotate the operand, or write a literal of one specific type (`1`, `1.0`, `1m`)",
              b"a type parameter supports `+`, `-` and `*` if it is declared `where numeric(a)`, and also `/`, `%` and the bitwise operators if it is declared `where integer(a)`",
            ],
          ),
      },
      NamedType(k) -> if k.args.len() != 0 { numeric_mismatch(c, entry, ty, what) }
      else if is_integer_name(k.name) || k.name == float_name { c }
      else if k.name == char_name && is_order_comparison(entry.operation) { c }
      else if k.name == decimal_name {
        if entry.operation == b"div" {
          report_error_at(
            c,
            b"E0209",
            entry.span,
            b"`/` is not defined on `Decimal`",
            b"the exact quotient of two decimals is not a decimal",
            [
              b"`/` would have to round the result without being asked, and `Decimal` exists to prevent silent rounding",
              b"call `Decimal::div(a, b, 2, HalfEven)` and say how to round",
            ],
          )
        } else { c }
      } else {
        match numeric_of(c.numeric_types, k.name) {
          Some(_) -> instance_operator(c, entry, ty, k.name),
          None -> numeric_mismatch(c, entry, ty, what),
        }
      },
      _ -> numeric_mismatch(c, entry, ty, what),
    }
  })
}

fn instance_operator(
  checker: Checker,
  entry: NumericOperation,
  ty: Type,
  type_name: Bytes,
) -> Checker / {abort.raise} =
  if entry.operation == b"add" || entry.operation == b"sub" || entry.operation == b"mul"
      || entry.operation == b"neg" { checker } else if is_order_comparison(entry.operation) {
    if checker.keyed_names.contains(type_name) { checker } else {
      report_error_at(
        checker,
        b"E0201",
        entry.span,
        Bytes::concat_all([
          b"`",
          operation_text(entry.operation),
          b"` is not defined on `",
          type_text(ty),
          b"`",
        ]),
        b"ordered comparison here",
        [
          Bytes::concat_all([
            b"`",
            simple_name_of(type_name),
            b"` states `numeric` and no `key`, and a type is ordered by its `key`",
          ]),
        ],
      )
    }
  } else {
    report_error_at(
      checker,
      b"E0201",
      entry.span,
      Bytes::concat_all([
        b"`",
        operation_text(entry.operation),
        b"` is not defined on `",
        type_text(ty),
        b"`",
      ]),
      b"arithmetic here",
      [
        Bytes::concat_all([
          b"a type that states `numeric` takes `+`, `-`, `*` and unary `-`; `",
          operation_text(entry.operation),
          b"` has no result for some pairs of values, so the type's module defines a function for it instead",
        ]),
      ],
    )
  }

fn operation_text(operation: Bytes) -> Bytes =
  if operation == b"add" { b"+" }
  else if operation == b"sub" || operation == b"neg" { b"-" }
  else if operation == b"mul" { b"*" }
  else if operation == b"div" { b"/" }
  else if operation == b"rem" { b"%" }
  else if operation == b"lt" { b"<" }
  else if operation == b"le" { b"<=" }
  else if operation == b"gt" { b">" }
  else if operation == b"ge" { b">=" }
  else { operation }

fn numeric_mismatch(
  checker: Checker,
  entry: NumericOperation,
  ty: Type,
  what: Bytes,
) -> Checker / {abort.raise} =
  report_error_at(
    checker,
    b"E0201",
    entry.span,
    Bytes::concat_all([
      b"`",
      operation_text(entry.operation),
      b"` is not defined on `",
      type_text(ty),
      b"`",
    ]),
    what.concat(b" here"),
    [
      b"the numeric types are `Int`, the eight fixed-width integers, `Float` and `Decimal`, and a type whose module states `numeric` for it takes `+`, `-` and `*`",
    ],
  )

fn signature_type_text(
  checker: Checker,
  signature: Signature,
  t: Type,
) -> Option<Bytes> / {abort.raise} = {
  let resolved = resolve(checker, t);
  let bound = signature.type_params.fold([], |accumulator: List<Int>, k: Bytes, p: Type|
    match resolve(checker, p) { VariableType(v) -> accumulator.push(v), _ -> accumulator });
  let found = free_variables(substitution_new, resolved, { types: [], effect_variables: [] }).types;
  if found.fold(false, |b: Bool, v: Int| b || !bound.contains(v)) { None }
  else { Some(type_text(resolved)) }
}

fn require_written_signature(
  checker: Checker,
  definition: FnDefinition,
  signature: Signature,
) -> Checker / {abort.raise} = {
  let reason = b"a signature is a claim about what a definition means, so it is written rather than inferred; the effects are the exception and stays inferred";
  let params = range(0, definition.params.len()).fold(checker, |c: Checker, i: Int| {
    let p = definition.params.get(i);
    match p.ty {
      Some(_) -> c,
      None -> {
        let label = match signature_type_text(c, signature, signature.params.get(i)) {
          Some(shown) -> Bytes::concat_all([b"write `", p.name.name, b": ", shown, b"`"]),
          None -> b"write a type here",
        };
        report_error_at(
          c,
          b"E0126",
          p.span,
          Bytes::concat_all([b"parameter `", p.name.name, b"` has no written type"]),
          label,
          [reason],
        )
      },
    }
  });
  match definition.return_type {
    Some(_) -> params,
    None -> {
      let label = match signature_type_text(params, signature, signature.return_type) {
        Some(shown) -> Bytes::concat_all([b"write `-> ", shown, b"`"]),
        None -> b"write a return type here",
      };
      report_error_at(
        params,
        b"E0126",
        definition.name.span,
        Bytes::concat_all([b"`", definition.name.name, b"` has no written return type"]),
        label,
        [reason],
      )
    },
  }
}

fn close_unreachable_effects(checker: Checker, signature: Signature) -> Checker / {abort.raise} =
  match resolve(checker, signature.fn_type) {
    FunctionType(f) -> match f.effects.variable {
      None -> checker,
      Some(variable) -> if is_rigid_effects(checker.substitution, variable) { checker } else {
        let fv = f.params.fold(
          { types: [], effect_variables: [] },
          |accumulator: FreeVariables, ty: Type|
            free_variables(checker.substitution, ty, accumulator),
        );
        let all = free_variables(checker.substitution, f.return_type, fv);
        if all.effect_variables.contains(variable) { checker } else {
          let u = unify_effects(
            checker.substitution,
            checker.fresh,
            no_effects,
            open_effects(variable),
          );
          with_unified(checker, u)
        }
      },
    },
    _ -> checker,
  }

fn labelled(labels: List<{ name: Bytes, span: Span }>, name: Bytes) -> Option<Span> =
  labels.fold(None, |span: Option<Span>, l: { name: Bytes, span: Span }|
    match span { Some(_) -> span, None -> if l.name == name { Some(l.span) } else { None } })

type TestLabel = { label: Bytes, span: Span, form: Option<Bytes> }

fn shared_label(earlier: List<TestLabel>, later: TestLabel) -> Option<TestLabel> =
  earlier.fold(None, |found: Option<TestLabel>, e: TestLabel|
    match found {
      Some(_) -> found,
      None -> if e.label != later.label { None } else {
        match ((e.form, later.form)) {
          (Some(a), Some(b)) -> if a != b { None } else { Some(e) },
          _ -> Some(e),
        }
      },
    })

fn reject_shared_label(checker: Checker, later: TestLabel, first: TestLabel) -> Checker = {
  let over_one_table = first.form != None && later.form != None;
  report_error_at_and(
    checker,
    b"E0105",
    later.span,
    Bytes::concat_all([
      if over_one_table { b"two tests over the same table are labelled " }
      else { b"two tests are labelled " },
      debug_quoted(later.label),
    ]),
    b"relabelled here",
    { module: checker.module, span: first.span },
    b"first labelled here",
    [
      if over_one_table { b"every case of these tests would get the same label" } else {
        b"two tests may share a label only if both run over a table of cases and the label has placeholders, because each case is named by the label with its values filled in"
      },
    ],
  )
}

pub fn check_tests(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} = {
  let walked = parsed.module.items.fold(
    { checker: checker, labels: [] },
    |accumulator: { checker: Checker, labels: List<TestLabel> }, item: Item|
      match item {
        TestItem(definition) -> {
          let written: TestLabel = {
            label: definition.label,
            span: definition.label_span,
            form: match definition.cases { Some(c) -> cases_form(c), None -> None },
          };
          let seen: Checker = match shared_label(accumulator.labels, written) {
            None -> accumulator.checker,
            Some(first) -> reject_shared_label(accumulator.checker, written, first),
          };
          let c: Checker = {
            ..seen,
            scope: seen.scope + 1,
            binders: item_binders(seen.resolved, seen.module, item),
          };
          let owner = test_owner(parsed.name, definition.name);
          let effects: WithEffectList = match c.known.tests.get(
              qualify(parsed.name, definition.name),
            ) {
            Some(cached) ->
              {
                checker: {
                  ..c,
                  cached_tests: c.cached_tests.push(qualify(parsed.name, definition.name)),
                  cached: c.cached.push({ name: owner, facts: cached.facts }),
                },
                listed: effects_of_cached(c, cached.effects).listed,
              },
            None -> {
              let c1: Checker = {
                ..c,
                type_params: Map::new(),
                effect_params: Map::new(),
                label_params: Map::new(),
                performs: [],
                declared_effects: [],
                effects_written: false,
                guards: guards::no_guards,
                raise_notes: [],
                current_definition: owner,
              };
              let pushed: Checker = { ..c1, env: env_push(c1.env) };
              let entered: Checker = match definition.cases {
                None -> pushed,
                Some(cases) ->
                  case_params(cases).fold(
                    pushed,
                    |c: Checker, p: { name: Identifier, ty: TypeExpression }| {
                      let t: WithType = convert_type(c, p.ty);
                      { ..t.checker, env: env_bind(t.checker.env, p.name, monomorphic(t.ty)) }
                    },
                  ),
              };
              let ran: Inference = infer_whole(entered, test_run(definition), hint_of(unit_type));
              let o: Inference = {
                ..ran,
                checker: body_recorded(
                  ran.checker,
                  owner,
                  TestRun,
                  definition.span.start,
                  match definition.cases {
                    None -> [],
                    Some(_) ->
                      [
                        { name: case_index_binder, ty: int_type, span: dummy_span },
                        { name: case_identity, ty: bytes_type, span: dummy_span },
                      ],
                  },
                  ran,
                  test_run(definition),
                ),
              };
              let ownership = check_body_ownership(
                o.checker,
                { resource: |t: Type| is_resource_type(o.checker, [], t), owner: owner },
                [],
                typed_body(o.checker, entered.typed_bodies.len(), owner, TestRun),
              );
              let returned: Checker = check_test_result(ownership.checker, definition, o.ty);
              let listed: Checker = match definition.cases {
                None -> returned,
                Some(cases) -> check_listing(returned, definition, cases),
              };
              let popped: Checker = { ..listed, env: env_pop(listed.env) };
              let effects = unhandled_release_effects(popped, ownership.held).fold(
                effects_outside_definition(resolve_effects_in(popped, o.effects)).listed,
                |xs: List<Effect>, a: Effect| effects_insert(xs, a),
              );
              let unlisted = listed.diagnostics.len() > returned.diagnostics.len();
              {
                checker: if definition.is_nondet || unlisted { popped }
                else { check_determinism(popped, definition, effects) },
                listed: run_needs(effects),
              }
            },
          };
          let checked: Checker = effects.checker;
          {
            checker: {
              ..checked,
              tests: checked.tests.push({
                name: definition.name,
                module: parsed.name,
                key: qualify(parsed.name, definition.name),
                index: checked.tests.len(),
                nondet: definition.is_nondet,
                cases: definition.cases != None,
                effects: effects.listed,
                at: location_of(checked, definition.span),
              }),
              current_definition: b"",
            },
            labels: accumulator.labels.push(written),
          }
        },
        _ -> accumulator,
      },
  );
  walked.checker
}

fn check_test_result(
  checker: Checker,
  definition: TestDefinition,
  ty: Type,
) -> Checker / {abort.raise} = {
  let u = unify(checker.substitution, checker.fresh, unit_type, ty);
  let c = with_unified(checker, u);
  match u.error {
    None -> c,
    Some(_) -> {
      let span = expression_span(tail_value(definition.body));
      let found = resolve(c, ty);
      let shown = print_type(printer_new, found).text;
      let d = error_at(
        b"E0201",
        c.module,
        span,
        Bytes::concat_all([b"type mismatch: the body of test `", definition.name, b"`"]),
        Bytes::concat_all([b"expected `Unit`, found `", shown, b"`"]),
        [
          b"a test passes when its body finishes, so the value of the last expression in the body is ignored",
        ],
      );
      report(c, if found == bool_type {
        with_fix(d, b"wrap it in `assert`", [
          insertion(c.module, span.start, b"assert("),
          insertion(c.module, span.end, b")"),
        ])
      } else { with_fix(d, b"end the body with `()`", [insertion(c.module, span.end, b"; ()")]) })
    },
  }
}

fn tail_value(expression: Expression) -> Expression =
  match expression {
    BlockExpression(b) -> match b.tail { Some(t) -> tail_value(t), None -> expression },
    _ -> expression,
  }

fn check_listing(
  checker: Checker,
  definition: TestDefinition,
  cases: Cases,
) -> Checker / {abort.raise} = {
  let o: Inference = infer_whole(checker, test_listing(cases), hint_of(listing_type));
  let c = body_recorded(
    o.checker,
    checker.current_definition,
    CaseListing,
    definition.span.start,
    [],
    o,
    test_listing(cases),
  );
  match run_needs(resolve_effects_in(c, o.effects).listed).at(0) {
    None -> c,
    Some(entry) ->
      report_error_with_labels(
        c,
        b"E0469",
        Bytes::concat_all([
          b"the cases of test `",
          definition.name,
          b"` perform `",
          effect_text(entry),
          b"`",
        ]),
        [
          label_at(
            c.module,
            match site_for(c, entry) { Some(s) -> s.span, None -> expression_span(cases.table) },
            true,
            b"performed while the cases are listed",
          ),
        ],
        [
          b"the cases of a test are listed before any test runs, to decide which cases run, so the table and the label may perform only the `raise` effect",
          b"handle the effect inside the table, or build the table from what `embed_dir` reads",
        ],
      ),
  }
}

type WithEffectList = { checker: Checker, listed: List<Effect> }

fn check_determinism(
  checker: Checker,
  definition: TestDefinition,
  effects: List<Effect>,
) -> Checker / {abort.raise} =
  effects.fold(checker, |c: Checker, entry: Effect|
    match effect_of(c, entry.effect) {
      None -> c,
      Some(info) -> if !info.nondet { c } else {
        let site = site_for(c, entry);
        let (span, direct) = match site {
          Some(s) -> (s.span, is_direct(s)),
          None -> (expression_span(definition.body), false),
        };
        let a = effect_text(entry);
        let remedy = if simulated_effect_names.contains(entry.effect) {
          b"handle it here, e.g. `simulate { <body> }`"
        } else {
          Bytes::concat_all([
            b"handle it here, e.g. `handle <body> with { ",
            example_clause(c, info, entry),
            b" }`",
          ])
        };
        let indirect = if direct { [] } else {
          [Bytes::concat_all([b"`", a, b"` is performed inside something this expression calls"])]
        };
        report_error_with_labels(
          c,
          b"E0412",
          b"nondeterministic effect in a deterministic test",
          [
            label_at(
              c.module,
              span,
              true,
              Bytes::concat_all([
                if direct { b"performs `" } else { b"reaches `" },
                a,
                b"`, and `",
                entry.effect,
                b"` is declared `nondet`",
              ]),
            ),
            label_at(
              c.module,
              definition.label_span,
              false,
              Bytes::concat_all([b"test `", definition.label, b"` is deterministic"]),
            ),
          ],
          indirect.concat([
            remedy,
            b"or declare this `test/nondet`, which opts out of the cache and re-runs every time",
          ]),
        )
      },
    })

fn example_clause(checker: Checker, info: EffectInfo, entry: Effect) -> Bytes / {abort.raise} = {
  let written = as_written(checker, info.name);
  let named = match entry.resource {
    NamedResource(_) -> true,
    ResourceVariable(_) -> true,
    SingletonResource -> false,
    AnyResource -> true,
  };
  let first = |ok: (OperationInfo) -> Bool|
    info.operations.fold(None, |accumulator: Option<OperationInfo>, o: OperationInfo|
      match accumulator { Some(_) -> accumulator, None -> if ok(o) { Some(o) } else { None } });
  let operation = match entry.operation {
    Some(name) -> operation_named(info, name),
    None -> match first(|o: OperationInfo|
        mode_eq(o.mode, entry.mode) && named == o.resource_param) {
      Some(o) -> Some(o),
      None -> match first(|o: OperationInfo| mode_eq(o.mode, entry.mode)) {
        Some(o) -> Some(o),
        None -> info.operations.at(0),
      },
    },
  };
  match operation {
    Some(o) -> {
      let resource = if o.resource_param { resource_text(entry.resource) } else { b"" };
      let args = Bytes::join(
        range(0, o.params.len()).map(|i: Int| b"a".concat(ascii_of_int(i))),
        b", ",
      );
      Bytes::concat_all([written, b".", o.name, resource, b"(", args, b") -> <value>"])
    },
    None -> written.concat(b".<op>() -> <value>"),
  }
}

pub fn check_laws(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} = {
  let walked = parsed.module.items.fold(
    { checker: checker, labels: [] },
    |accumulator: { checker: Checker, labels: List<{ name: Bytes, span: Span }> }, item: Item|
      match item {
        LawItem(definition) -> {
          let c: Checker = { ..accumulator.checker, scope: accumulator.checker.scope + 1 };
          match labelled(accumulator.labels, definition.name) {
            Some(first) ->
              {
                ..accumulator,
                checker: report_error_at_and(
                  c,
                  b"E0105",
                  definition.name_span,
                  Bytes::concat_all([b"two laws are labelled ", debug_quoted(definition.name)]),
                  b"relabelled here",
                  { module: c.module, span: first },
                  b"first labelled here",
                  [b"a law is keyed `<module>.<label>`, so one label names one claim"],
                ),
              },
            None ->
              {
                checker: check_law(c, parsed, definition),
                labels: accumulator.labels.push({
                  name: definition.name,
                  span: definition.name_span,
                }),
              },
          }
        },
        _ -> accumulator,
      },
  );
  walked.checker
}

fn debug_quoted(s: Bytes) -> Bytes =
  Bytes::concat_all([
    b"\"",
    Bytes::concat_all(
      range(0, s.len()).map(|i: Int| {
        let c = s.at(i);
        if c == 34 { b"\\\"" }
        else if c == 92 { b"\\\\" }
        else if c == 10 { b"\\n" }
        else if c == 9 { b"\\t" }
        else { s.slice(i, i + 1) }
      }),
    ),
    b"\"",
  ])

fn check_law(
  outer: Checker,
  parsed: ParsedModule,
  definition: LawDefinition,
) -> Checker / {abort.raise} = {
  let checker: Checker = {
    ..outer,
    type_params: Map::new(),
    effect_params: Map::new(),
    label_params: Map::new(),
    performs: [],
    declared_effects: [],
    effects_written: false,
    guards: guards::no_guards,
    raise_notes: [],
    auto_type_params: true,
    current_definition: law_owner(parsed.name, definition.name),
    binders: item_binders(outer.resolved, outer.module, LawItem(definition)),
  };
  let types: WithTypes = definition.binders.fold(
    { checker: checker, types: [] },
    |accumulator: { checker: Checker, types: List<Type> }, b: Binder| {
      let o: WithType = if definition.of != None { new_type(accumulator.checker) }
      else { law_binder(accumulator.checker, b) };
      { checker: o.checker, types: accumulator.types.push(o.ty) }
    },
  );
  let c1: Checker = { ..types.checker, auto_type_params: false };
  let sorts = c1.type_params.fold([], |accumulator: List<Int>, k: Bytes, ty: Type|
    match ty { VariableType(v) -> accumulator.push(v), _ -> accumulator });
  let rigid: Checker = sorts.fold(c1, |c: Checker, v: Int|
    { ..c, substitution: mark_rigid_type(c.substitution, v) });
  let pushed: Checker = { ..rigid, env: env_push(rigid.env) };
  let bound: Checker = range(0, definition.binders.len()).fold(pushed, |c: Checker, i: Int|
    { ..c, env: env_bind(c.env, definition.binders.get(i).name, monomorphic(types.types.get(i))) });
  let binders_typed = zip(definition.binders, types.types).map(
    |b: { first: Binder, second: Type }|
      { name: b.first.name.name, ty: b.second, span: b.first.name.span },
  );
  let guarded: Checker = match definition.guard {
    Some(g) -> {
      let walked: Inference = infer_whole({ ..bound, performs: [] }, g);
      let o: Inference = {
        ..walked,
        checker: body_recorded(
          walked.checker,
          bound.current_definition,
          LawGuard,
          definition.span.start,
          binders_typed,
          walked,
          g,
        ),
      };
      let c: Checker = default_no_effects(
        expect(
          o.checker,
          expression_span(g),
          bool_type,
          o.ty,
          b"a `where` guard must have type `Bool`",
        ).checker,
        definition,
        o.effects,
      );
      check_spec_purity(c, InWhere, [], expression_span(g), resolve_effects_in(c, o.effects))
    },
    None -> bound,
  };
  let walked: Inference = infer_whole({ ..guarded, performs: [] }, definition.body);
  let body: Inference = {
    ..walked,
    checker: body_recorded(
      walked.checker,
      guarded.current_definition,
      LawBody,
      definition.span.start,
      binders_typed,
      walked,
      definition.body,
    ),
  };
  let stated: Checker = expect(
    body.checker,
    expression_span(definition.body),
    bool_type,
    body.ty,
    b"the body of a law must have type `Bool`",
  ).checker;
  let c2: Checker = default_no_effects(stated, definition, body.effects);
  let effects = resolve_effects_in(c2, body.effects);
  let c3: Checker = check_spec_purity(
    c2,
    InLawBody,
    [seed_effect],
    expression_span(definition.body),
    effects,
  );
  let closed: Checker = { ..c3, env: env_pop(c3.env) };
  let shown = |i: Int|
    match definition.of {
      Some(u) -> match u.argument_names.at(i) {
        Some(n) -> n,
        None -> definition.binders.get(i).name.name,
      },
      None -> definition.binders.get(i).name.name,
    };
  let popped: Checker = match definition.of {
    None -> closed,
    Some(u) -> if closed.diagnostics.len() != outer.diagnostics.len() { closed } else {
      range(0, definition.binders.len()).fold(closed, |c: Checker, i: Int|
        instantiable(c, u, shown(i), resolve(c, types.types.get(i))))
    },
  };
  let identified: IdentityVariables = match definition.of {
    None ->
      {
        checker: popped,
        identity_variables: written_identities(definition.identities, c1.type_params),
      },
    Some(u) -> if popped.diagnostics.len() != outer.diagnostics.len() {
      { checker: popped, identity_variables: [] }
    } else { instance_identities(popped, u, schema_arguments(walked.node)) },
  };
  let binders = range(0, definition.binders.len()).map(|i: Int|
    {
      name: shown(i),
      ty: resolve(identified.checker, types.types.get(i)),
      span: definition.binders.get(i).span,
    });
  let last: Checker = identified.checker;
  {
    ..last,
    type_params: Map::new(),
    effect_params: Map::new(),
    current_definition: outer.current_definition,
    laws: last.laws.push({
      name: definition.name,
      module: parsed.name,
      key: qualify(parsed.name, definition.name),
      index: last.laws.len(),
      binders: binders,
      identities: identified.identity_variables,
      has_guard: match definition.guard { Some(_) -> true, None -> false },
      effects: run_needs(effects.listed),
      at: location_of(last, definition.span),
    }),
  }
}

type IdentityVariables = { checker: Checker, identity_variables: List<Int> }

fn written_identities(
  identities: List<Identifier>,
  params: Map<Bytes, Type>,
) -> List<Int> / {abort.raise} =
  identities.fold([], |variables: List<Int>, identity: Identifier|
    match params.get(identity.name) {
      Some(VariableType(v)) -> ints_union(variables, [v]),
      _ -> variables,
    })

fn schema_arguments(body: Option<WalkedNode>) -> List<Type> =
  match body {
    Some(WalkedCall(c)) -> match c.callee.node {
      WalkedRead(WalkedDefinition(x)) -> x.args,
      _ -> [],
    },
    _ -> [],
  }

fn instance_identities(
  checker: Checker,
  of: SchemaInstance,
  args: List<Type>,
) -> IdentityVariables / {abort.raise} =
  if of.identities.len() == 0 { { checker: checker, identity_variables: [] } } else {
    let shapes = algebraic_shapes(checker);
    of.identities.fold(
      { checker: checker, identity_variables: [] },
      |accumulator: IdentityVariables, x: SchemaIdentity|
        match args.at(x.position) {
          None -> accumulator,
          Some(arg) -> {
            let resolved = resolve(accumulator.checker, arg);
            let variables = variables_of_type(resolved);
            match not_identity(shapes, accumulator.checker.keyed_names, resolved, variables) {
              None ->
                {
                  ..accumulator,
                  identity_variables: ints_union(accumulator.identity_variables, variables),
                },
              Some(rejection) ->
                {
                  ..accumulator,
                  checker: identity_failure_at(
                    accumulator.checker,
                    of,
                    x.name,
                    resolved,
                    rejection,
                  ),
                },
            }
          },
        },
    )
  }

fn identity_failure_at(
  checker: Checker,
  of: SchemaInstance,
  param: Bytes,
  resolved: Type,
  rejection: IdentityFailure,
) -> Checker / {abort.raise} = {
  let schema = of.schema.name.name;
  let shown = type_text(resolved);
  let part = type_text(rejection.part);
  report_error_at(
    checker,
    b"E0479",
    of.span,
    Bytes::concat_all([
      b"the schema `",
      schema,
      b"` claims `==` is identity at `",
      param,
      b"`, and `==` at `",
      shown,
      b"` is not",
    ]),
    Bytes::concat_all([b"`", param, b"` is `", shown, b"` here"]),
    [
      if part == shown { rejection.reason }
      else { Bytes::concat_all([b"`", shown, b"` holds `", part, b"`: ", rejection.reason]) },
      Bytes::concat_all([
        b"`",
        schema,
        b"` states `where identity(",
        param,
        b")`: its claim holds only where two values are `==` exactly when they are the same value",
      ]),
    ],
  )
}

fn default_no_effects(
  checker: Checker,
  definition: LawDefinition,
  effects: Effects,
) -> Checker / {abort.raise} =
  match ((definition.of, resolve_effects_in(checker, effects).variable)) {
    (Some(_), Some(v)) -> {
      let u = unify_effects(checker.substitution, checker.fresh, no_effects, open_effects(v));
      match u.error { Some(_) -> checker, None -> with_unified(checker, u) }
    },
    _ -> checker,
  }

fn instantiable(
  checker: Checker,
  of: SchemaInstance,
  binder: Bytes,
  ty: Type,
) -> Checker / {abort.raise} =
  match ungeneratable(checker, ty) {
    None -> checker,
    Some(reason) ->
      report_error_at(
        checker,
        b"E0418",
        of.span,
        Bytes::concat_all([b"`forall` cannot quantify over `", binder, b"`"]),
        reason,
        [
          Bytes::concat_all([
            b"the schema `",
            of.schema.name.name,
            b"` binds `",
            binder,
            b"`, which is a `",
            type_text(ty),
            b"` here",
          ]),
          b"a law over a type whose values cannot be generated can never be checked, so it is rejected here instead of being reported as unproved later",
        ],
      ),
  }

pub fn check_schemas(outer: Checker, parsed: ParsedModule) -> Checker / {abort.raise} =
  parsed.module.items.fold(outer, |accumulator: Checker, item: Item|
    match item {
      SchemaItem(d) -> {
        let typed: Checker = d.binders.fold(
          { ..accumulator, type_params: Map::new(), auto_type_params: true },
          |c: Checker, b: Binder| law_binder(c, b).checker,
        );
        {
          ..typed,
          type_params: accumulator.type_params,
          auto_type_params: accumulator.auto_type_params,
          diagnostics: accumulator.diagnostics.concat(
            typed.diagnostics.drop(accumulator.diagnostics.len()).filter(
              |diagnostic: Diagnostic| diagnostic.code == b"E0418",
            ),
          ),
        }
      },
      _ -> accumulator,
    })

fn law_binder(checker: Checker, binder: Binder) -> { checker: Checker, ty: Type } / {abort.raise} =
  match undeclared_handler_span(checker, binder.ty) {
    Some(span) ->
      new_type(
        report_error_at(
          checker,
          b"E0418",
          span,
          b"`forall` cannot quantify over a handler",
          b"a handler is syntax, not a value",
          [
            b"`handle body with { .. }` is an expression: no type describes a handler, so a binder has no handler values to choose from",
            b"a law over handlers would need a handler type, a handler value in the prover and a way to compare handlers, and the laws this allows are not worth that cost",
            b"quantify over the values the handler would return instead",
          ],
        ),
      ),
    None -> match written_effects_reason(binder.ty) {
      Some(reason) -> new_type(unquantifiable(checker, binder, reason)),
      None -> {
        let o: WithType = convert_type(checker, binder.ty);
        match ungeneratable(o.checker, o.ty) {
          Some(reason) -> { checker: unquantifiable(o.checker, binder, reason), ty: o.ty },
          None -> o,
        }
      },
    },
  }

fn unquantifiable(checker: Checker, binder: Binder, reason: Bytes) -> Checker =
  report_error_at(
    checker,
    b"E0418",
    type_span(binder.ty),
    Bytes::concat_all([b"`forall` cannot quantify over `", binder.name.name, b"`"]),
    reason,
    [
      b"a law over a type whose values cannot be generated can never be checked, so it is rejected here instead of being reported as unproved later",
    ],
  )

fn effects_display(effects: Effects) -> Bytes / {abort.raise} = {
  let listed = Bytes::join(effects.listed.map(effect_text), b", ");
  match effects.variable {
    None -> Bytes::concat_all([b"{", listed, b"}"]),
    Some(v) -> if effects.listed.len() == 0 { Bytes::concat_all([b"{| e", ascii_of_int(v), b"}"]) }
    else { Bytes::concat_all([b"{", listed, b" | e", ascii_of_int(v), b"}"]) },
  }
}

fn handler_named(checker: Checker, name: Bytes, span: Span) -> Option<Span> / {abort.raise} = {
  let is_handler = name == b"Handler" || name == b"handler";
  let declared = match find(checker.resolved, checker.module, TypeSpace, {
      module: None,
      name: { name: name, span: span },
      span: span,
    }) {
    Some(_) -> true,
    None -> false,
  };
  if is_handler && !declared { Some(span) } else { None }
}

fn undeclared_handler_span(checker: Checker, ty: TypeExpression) -> Option<Span> / {abort.raise} =
  match ty {
    UnitTypeExpression(_) -> None,
    InvalidTypeExpression(_) -> None,
    VariableTypeExpression(id) -> handler_named(checker, id.name, id.span),
    NamedTypeExpression(c) -> {
      let own = if is_bare(c.name) { handler_named(checker, c.name.name.name, c.span) }
      else { None };
      match own { Some(_) -> own, None -> first_handler_mention(checker, c.args) }
    },
    FunctionTypeExpression(f) -> match first_handler_mention(checker, f.params) {
      Some(s) -> Some(s),
      None -> undeclared_handler_span(checker, f.return_type),
    },
    RecordTypeExpression(r) ->
      r.fields.fold(
        None,
        |accumulator: Option<Span>, f: { name: Identifier, ty: TypeExpression }|
          match accumulator {
            Some(_) -> accumulator,
            None -> undeclared_handler_span(checker, f.ty),
          },
      ),
  }

fn first_handler_mention(
  checker: Checker,
  types: List<TypeExpression>,
) -> Option<Span> / {abort.raise} =
  types.fold(None, |accumulator: Option<Span>, ty: TypeExpression|
    match accumulator { Some(_) -> accumulator, None -> undeclared_handler_span(checker, ty) })

fn raises(entry: EffectExpression) -> Bool =
  is_bare(entry.effect_name) && entry.effect_name.name.name == b"abort"

fn law_effects_reason(effects: EffectsExpression) -> Option<Bytes> =
  match effects.variable {
    Some(_) ->
      Some(
        b"an effect variable has no binder here, and a law quantifies over values rather than over effects",
      ),
    None -> match effects.listed.filter(|a: EffectExpression| !raises(a)).at(0) {
      Some(a) ->
        Some(
          Bytes::concat_all([
            b"applying this inside the body would perform `",
            qualified_name_text(a.effect_name),
            b"`, and a law body is pure",
          ]),
        ),
      None -> None,
    },
  }

fn written_effects_reason(ty: TypeExpression) -> Option<Bytes> =
  match ty {
    VariableTypeExpression(_) -> None,
    UnitTypeExpression(_) -> None,
    InvalidTypeExpression(_) -> None,
    NamedTypeExpression(c) -> match first_reason(c.effect_arguments, law_effects_reason) {
      Some(r) -> Some(r),
      None -> first_reason(c.args, written_effects_reason),
    },
    RecordTypeExpression(r) ->
      first_reason(r.fields, |f: { name: Identifier, ty: TypeExpression }|
        written_effects_reason(f.ty)),
    FunctionTypeExpression(f) -> {
      let own = match f.effects { Some(effects) -> law_effects_reason(effects), None -> None };
      match own {
        Some(_) -> own,
        None -> match first_reason(f.params, written_effects_reason) {
          Some(r) -> Some(r),
          None -> written_effects_reason(f.return_type),
        },
      }
    },
  }

fn ungeneratable(checker: Checker, ty: Type) -> Option<Bytes> / {abort.raise} =
  ungeneratable_within(checker, ty, [], checker.constructors.len())

fn ungeneratable_within(
  checker: Checker,
  ty: Type,
  seen: List<Bytes>,
  room: Int,
) -> Option<Bytes> / {abort.raise} =
  match ty {
    VariableType(_) -> None,
    NamedType(c) -> if c.name == scoped_name {
      Some(b"a `Scoped` is created by `with_scope` and exists only inside its scope")
    } else if c.name == task_name {
      Some(
        b"a `Task` identifies a task of the simulation that spawned it, so a generated one would refer to nothing",
      )
    } else if c.name == builtin_channel_name {
      Some(
        b"a `Chan` identifies a channel of the simulation that created it, so a generated one would refer to nothing",
      )
    } else if c.name == secret_name {
      Some(
        b"a `Secret` is a credential: quantifying over one would generate credentials and print them in counterexamples",
      )
    } else {
      match first_reason(c.args, |a: Type| ungeneratable_within(checker, a, seen, room)) {
        Some(r) -> Some(r),
        None -> if seen.contains(c.name) { None } else {
          let constructors = checker.constructors.filter(|constructor_info: ConstructorInfo|
            constructor_info.type_name == c.name);
          if constructors.len() == 0 { None }
          else if room <= 0 { panic("internal error: the check visited a type twice on one path") }
          else {
            let inner = seen.push(c.name);
            first_reason(constructors, |constructor_info: ConstructorInfo|
              first_reason(constructor_info.fields, |f: Type|
                ungeneratable_within(checker, f, inner, room - 1)))
          }
        },
      }
    },
    FunctionType(f) -> if f.effects.variable != None {
      Some(
        b"a function type with an effect variable cannot be generated, whatever effects the type is given",
      )
    } else if !is_pure_but_raise(f.effects) {
      Some(
        Bytes::concat_all([
          b"a function with effects ",
          effects_display(f.effects),
          b" cannot be applied inside a pure body",
        ]),
      )
    } else {
      match first_reason(f.params, |p: Type| ungeneratable_within(checker, p, seen, room)) {
        Some(r) -> Some(r),
        None -> ungeneratable_within(checker, f.return_type, seen, room),
      }
    },
    RecordType(fs) -> first_reason(fs, |f: Field| ungeneratable_within(checker, f.ty, seen, room)),
    NominalType(n) ->
      first_reason(n.fields, |f: Field| ungeneratable_within(checker, f.ty, seen, room)),
  }

pub type IdentityFailure = { part: Type, reason: Bytes }

pub fn not_identity(
  shapes: Shapes,
  keyed: List<Bytes>,
  ty: Type,
  assumed: List<Int>,
) -> Option<IdentityFailure> / {abort.raise} =
  not_identity_within(shapes, keyed, ty, assumed, [], shapes.len())

fn compares_by_value(name: Bytes) -> Bool =
  is_integer_name(name) || [bool_name, char_name, string_name, bytes_name, unit_name].contains(name)

fn is_collection_name(name: Bytes) -> Bool =
  [list_name, array_name, columns_name, map_name].contains(name)

fn extern_type_note(name: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"`",
    simple_name_of(name),
    b"` is an `extern type`: the toolchain lays out its values and compares them",
  ])

fn not_identity_within(
  shapes: Shapes,
  keyed: List<Bytes>,
  ty: Type,
  assumed: List<Int>,
  visiting: List<Bytes>,
  room: Int,
) -> Option<IdentityFailure> / {abort.raise} = {
  let within = |types: List<Type>, inside: List<Bytes>, left: Int|
    types.fold(None, |accumulator: Option<IdentityFailure>, t: Type|
      match accumulator {
        Some(_) -> accumulator,
        None -> not_identity_within(shapes, keyed, t, assumed, inside, left),
      });
  let rejected = |reason: Bytes| Some({ part: ty, reason: reason });
  let stated = |name: Bytes|
    if !keyed.contains(name) { None } else {
      rejected(
        Bytes::concat_all([
          b"`",
          simple_name_of(name),
          b"` states a `key`: two of its values are `==` when their keys are, whatever else they contain",
        ]),
      )
    };
  match ty {
    VariableType(v) -> if assumed.contains(v) { None } else {
      rejected(
        b"a type variable without an `identity` constraint may be `Float`, whose `NaN` is not `==` to itself",
      )
    },
    FunctionType(_) -> rejected(b"a function has no `==`"),
    RecordType(fs) -> within(fs.map(|f: Field| f.ty), visiting, room),
    NominalType(n) -> match stated(n.name) {
      Some(x) -> Some(x),
      None -> within(n.fields.map(|f: Field| f.ty), visiting, room),
    },
    NamedType(c) -> match stated(c.name) {
      Some(x) -> Some(x),
      None -> if compares_by_value(c.name) { None } else if c.name == float_name {
        rejected(
          b"`Float`'s `==` is IEEE 754's: `NaN != NaN`, and `0.0 == -0.0` though the two are different values",
        )
      } else if c.name == decimal_name {
        rejected(
          b"a `Decimal` records its scale: `1.5m == 1.50m`, though the two print differently",
        )
      } else if is_collection_name(c.name) { within(c.args, visiting, room) }
      else if visiting.contains(c.name) { within(c.args, visiting, room) } else {
        match shapes.get(c.name) {
          Some(shape) -> if shape.native { rejected(extern_type_note(c.name)) }
          else if room <= 0 { panic("internal error: the check visited a type twice on one path") }
          else {
            within(
              shape.fields.map(|f: Type|
                apply_arguments(f, shape.params, shape.effect_params, c.args)),
              visiting.push(c.name),
              room - 1,
            )
          },
          None ->
            rejected(if c.name == scoped_name || is_scheduler_handle(c.name) {
              Bytes::concat_all([b"a `", c.name, b"` names a location rather than a value"])
            } else if c.name == secret_name {
              b"a `Secret` contains a credential that no Ply code can read"
            } else { extern_type_note(c.name) }),
        }
      },
    },
  }
}

type SpecPosition =
  | InRequires
  | InEnsures
  | InCost
  | InSpace
  | InDecreases
  | InWhere
  | InLawBody
  | InSchemaBody

fn site_phrase(s: SpecPosition) -> Bytes =
  match s {
    InRequires -> b"a `requires` clause",
    InEnsures -> b"an `ensures` clause",
    InCost -> b"a `cost` bound",
    InSpace -> b"a `space` bound",
    InDecreases -> b"a `decreases` measure",
    InWhere -> b"a `where` guard",
    InLawBody -> b"a law body",
    InSchemaBody -> b"a law schema's body",
  }

fn site_short(s: SpecPosition) -> Bytes =
  match s {
    InRequires -> b"`requires`",
    InEnsures -> b"`ensures`",
    InCost -> b"`cost` bound",
    InSpace -> b"`space` bound",
    InDecreases -> b"`decreases` measure",
    InWhere -> b"`where` guard",
    InLawBody -> b"law body",
    InSchemaBody -> b"schema body",
  }

fn check_spec_purity(
  checker: Checker,
  site: SpecPosition,
  allowed: List<Effect>,
  body_span: Span,
  effects: Effects,
) -> Checker / {abort.raise} = {
  let law_body = match site { InLawBody -> true, _ -> false };
  let c1: Checker = run_needs(effects.listed).filter(|a: Effect| !effects_cover(allowed, a)).fold(
    checker,
    |c: Checker, entry: Effect| {
      let found = site_for(c, entry);
      let (span, direct) = match found {
        Some(s) -> (s.span, is_direct(s)),
        None -> (body_span, false),
      };
      let fixed = [
        b"a law can perform an effect that changes the state it checks: a law that writes to a resource then compares against the state its own write produced",
        b"and the prover runs each law hundreds of times, starting from state that no code in your program set up",
      ];
      let with_implied_orders = allowed.fold(fixed, |accumulator: List<Bytes>, a: Effect|
        accumulator.push(
          Bytes::concat_all([
            b"a law body may use only `",
            effect_text(a),
            b"`, the effect that supplies the random seed for a simulation",
          ]),
        ));
      let hosted = if law_body {
        with_implied_orders.push(
          b"a proof cannot check code that reads or changes anything outside the program: check it in a test that installs handlers for its effects or runs it on the real host",
        )
      } else { with_implied_orders };
      report_error_with_labels(
        c,
        b"E0417",
        site_phrase(site).concat(b" cannot perform an effect"),
        [
          label_at(
            c.module,
            span,
            true,
            Bytes::concat_all([
              if direct { b"performs `" } else { b"reaches `" },
              effect_text(entry),
              b"`",
            ]),
          ),
          label_at(
            c.module,
            body_span,
            false,
            Bytes::concat_all([b"this ", site_short(site), b" must be pure"]),
          ),
        ],
        hosted.push(
          Bytes::concat_all([
            b"compute this with a pure function, or handle `",
            entry.effect,
            b"` inside the definition and state a claim about its result",
          ]),
        ),
      )
    },
  );
  match effects.variable {
    Some(_) ->
      report_error_at(
        c1,
        b"E0417",
        body_span,
        Bytes::concat_all([
          b"the effects of this ",
          site_short(site),
          b" is not known to be empty",
        ]),
        b"has effects ".concat(effects_text(effects)),
        [
          b"an effect variable stands for effects that are not yet known, so it can be empty for some types and not empty for others, and a law must be pure for every type it is used with",
          b"call only functions whose effects are fully known and empty here",
        ],
      ),
    None -> c1,
  }
}

fn has_spec(definition: FnDefinition) -> Bool =
  definition.spec.len() > 0 || (match definition.decreases { Some(_) -> true, None -> false })

fn record_spec_env(
  checker: Checker,
  definition: FnDefinition,
  name: Bytes,
  signature: Signature,
) -> Checker =
  if !has_spec(definition) { checker } else {
    {
      ..checker,
      spec_envs: checker.spec_envs.push({
        name: name,
        type_params: signature.type_params,
        effect_params: signature.effect_params,
        params: signature.params,
        return_type: signature.return_type,
      }),
    }
  }

fn spec_env_of(checker: Checker, name: Bytes) -> Option<SpecEnv> =
  checker.spec_envs.fold(None, |accumulator: Option<SpecEnv>, e: SpecEnv|
    match accumulator {
      Some(_) -> accumulator,
      None -> if e.name == name { Some(e) } else { None },
    })

pub fn check_specs(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} = {
  let walked: Checker = parsed.module.items.fold(checker, |c: Checker, item: Item|
    match item {
      FunctionItem(definition) -> if !has_spec(definition) { c } else {
        let name = qualify(parsed.name, definition.name.name);
        match spec_env_of(c, name) {
          None -> c,
          Some(env) -> {
            let shadowed: Checker = check_cost_names(
              check_result_shadow(
                { ..c, binders: item_binders(c.resolved, c.module, item) },
                definition,
              ),
              definition,
            );
            let walked = range(0, definition.spec.len()).fold(
              { checker: shadowed, specs: [] },
              |accumulator: { checker: Checker, specs: List<SpecInfo> }, i: Int| {
                let clause = definition.spec.get(i);
                let o: WithEffectList = check_clause(
                  accumulator.checker,
                  definition,
                  clause,
                  i,
                  env,
                );
                {
                  checker: o.checker,
                  specs: accumulator.specs.push({
                    kind: clause.kind,
                    index: i,
                    effects: o.listed,
                    span: clause.span,
                  }),
                }
              },
            );
            let measured: Checker = match definition.decreases {
              Some(e) -> check_measure(walked.checker, definition, e, env),
              None -> walked.checker,
            };
            match definition_of(measured, name) {
              Some(d) -> {
                let info: DefinitionInfo = d;
                set_definition(measured, { ..info, spec: walked.specs })
              },
              None -> measured,
            }
          },
        }
      },
      _ -> c,
    });
  { ..walked, type_params: Map::new(), effect_params: Map::new() }
}

fn spec_scope(checker: Checker, written: FnDefinition, env: SpecEnv) -> Checker / {abort.raise} = {
  let definition = with_implied_orders(checker, [written]).get(0);
  let c0: Checker = {
    ..checker,
    type_params: env.type_params,
    effect_params: env.effect_params,
    performs: [],
    declared_effects: [],
    effects_written: false,
    guards: guards::no_guards,
    raise_notes: [],
  };
  let assumed: Checker = note_witness_params(
    { ..c0, assumed: constraints_in_force(c0, definition.constraints) },
    definition.constraints,
  );
  let pushed: Checker = { ..assumed, env: env_push(assumed.env) };
  range(0, definition.params.len()).fold(pushed, |c: Checker, i: Int|
    if i >= env.params.len() { c } else {
      { ..c, env: env_bind(c.env, definition.params.get(i).name, monomorphic(env.params.get(i))) }
    })
}

fn params_typed_as(params: List<Param>, types: List<Type>) -> List<TypedParam<Type>> =
  zip(params, types).map(|p: { first: Param, second: Type }|
    { name: p.first.name.name, ty: p.second, span: p.first.name.span })

fn check_measure(
  checker: Checker,
  definition: FnDefinition,
  expression: Expression,
  env: SpecEnv,
) -> Checker / {abort.raise} = {
  let walked: Inference = infer_whole(
    { ..spec_scope(checker, definition, env), current_definition: body_walking_name(env.name) },
    expression,
  );
  let o: Inference = {
    ..walked,
    checker: body_recorded(
      walked.checker,
      env.name,
      MeasureBody,
      definition.span.start,
      params_typed_as(definition.params, env.params),
      walked,
      expression,
    ),
  };
  let popped: Checker = {
    ..o.checker,
    env: env_pop(o.checker.env),
    current_definition: checker.current_definition,
  };
  let c1: Checker = expect(
    popped,
    expression_span(expression),
    int_type,
    o.ty,
    b"a `decreases` measure is an `Int`",
  ).checker;
  check_spec_purity(
    { ..c1, assumed: checker.assumed },
    InDecreases,
    [],
    expression_span(expression),
    resolve_effects_in(c1, o.effects),
  )
}

fn check_clause(
  checker: Checker,
  definition: FnDefinition,
  clause: SpecClause,
  index: Int,
  env: SpecEnv,
) -> WithEffectList / {abort.raise} = {
  let bound: Checker = spec_scope(checker, definition, env);
  let named = |names: List<Option<Identifier>>|
    names.fold(bound, |c: Checker, name: Option<Identifier>|
      match name { Some(k) -> { ..c, env: env_bind(c.env, k, monomorphic(int_type)) }, None -> c });
  let with_result: Checker = match clause.kind {
    EnsuresClause ->
      {
        ..bound,
        env: env_bind(
          bound.env,
          { name: result_name, span: clause.span },
          monomorphic(env.return_type),
        ),
      },
    RequiresClause -> bound,
    SpaceClause -> named(definition.params.map(|param: Param| param.space)),
    CostClause -> named(definition.params.map(|param: Param| param.cost)),
  };
  let ints = |names: List<Option<Identifier>>|
    names.fold([], |accumulator: List<TypedParam<Type>>, name: Option<Identifier>|
      match name {
        Some(k) -> accumulator.push({ name: k.name, ty: int_type, span: k.span }),
        None -> accumulator,
      });
  let clause_params = params_typed_as(definition.params, env.params).concat(match clause.kind {
    EnsuresClause -> [{ name: result_name, ty: env.return_type, span: dummy_span }],
    RequiresClause -> [],
    SpaceClause -> ints(definition.params.map(|param: Param| param.space)),
    CostClause -> ints(definition.params.map(|param: Param| param.cost)),
  });
  let outer = with_result.spec_kind;
  let walked: Inference = infer_whole(
    {
      ..with_result,
      spec_kind: Some(clause.kind),
      current_definition: if clause.kind == CostClause || clause.kind == SpaceClause {
        body_walking_name(env.name)
      } else { env.name },
    },
    clause.expression,
  );
  let o: Inference = {
    ..walked,
    checker: body_recorded(
      walked.checker,
      env.name,
      ClauseBody(index),
      definition.span.start,
      clause_params,
      walked,
      clause.expression,
    ),
  };
  let popped: Checker = {
    ..o.checker,
    spec_kind: outer,
    current_definition: with_result.current_definition,
    env: env_pop(o.checker.env),
  };
  let c1: Checker = match clause.kind {
    CostClause ->
      expect(
        popped,
        expression_span(clause.expression),
        int_type,
        o.ty,
        b"a `cost` bound is an `Int`",
      ).checker,
    SpaceClause ->
      expect(
        popped,
        expression_span(clause.expression),
        int_type,
        o.ty,
        b"a `space` bound is an `Int`",
      ).checker,
    _ ->
      expect(
        popped,
        expression_span(clause.expression),
        bool_type,
        o.ty,
        b"a spec clause states a proposition",
      ).checker,
  };
  let effects = resolve_effects_in(c1, o.effects);
  {
    checker: check_spec_purity(
      { ..c1, assumed: checker.assumed },
      match clause.kind {
        RequiresClause -> InRequires,
        EnsuresClause -> InEnsures,
        CostClause -> InCost,
        SpaceClause -> InSpace,
      },
      [],
      clause.span,
      effects,
    ),
    listed: run_needs(effects.listed),
  }
}

fn check_cost_names(checker: Checker, definition: FnDefinition) -> Checker / {abort.raise} =
  check_names(
    check_names(checker, definition, definition.params.map(|param: Param| param.cost), b"cost"),
    definition,
    definition.params.map(|param: Param| param.space),
    b"space",
  )

fn check_names(
  checker: Checker,
  definition: FnDefinition,
  names: List<Option<Identifier>>,
  word: Bytes,
) -> Checker / {abort.raise} =
  range(0, definition.params.len()).fold(checker, |c: Checker, i: Int|
    match names.get(i) {
      None -> c,
      Some(k) -> match range(0, definition.params.len()).fold(
          None,
          |found: Option<Span>, j: Int|
            match found {
              Some(_) -> found,
              None -> {
                let other = definition.params.get(j);
                if other.name.name == k.name { Some(other.name.span) }
                else if j < i
                    && (match names.get(j) { Some(o) -> o.name == k.name, None -> false }) {
                  match names.get(j) { Some(o) -> Some(o.span), None -> None }
                } else { None }
              },
            },
        ) {
        None -> c,
        Some(first) ->
          report_error_with_labels(
            c,
            b"E0105",
            Bytes::concat_all([b"`", k.name, b"` is bound twice on `", definition.name.name, b"`"]),
            [
              label_at(
                c.module,
                k.span,
                true,
                Bytes::concat_all([b"this names a parameter's ", word]),
              ),
              label_at(c.module, first, false, b"and this uses the same name"),
            ],
            [
              Bytes::concat_all([
                b"a `",
                word,
                b"` clause refers to parameters and ",
                word,
                b" by name, so each needs a different name",
              ]),
            ],
          ),
      },
    })

fn check_result_shadow(checker: Checker, definition: FnDefinition) -> Checker =
  match definition.spec.fold(None, |accumulator: Option<Span>, c: SpecClause|
      match accumulator {
        Some(_) -> accumulator,
        None -> match c.kind { EnsuresClause -> Some(c.span), _ -> None },
      }) {
    None -> checker,
    Some(ensures) ->
      definition.params.fold(checker, |c: Checker, param: Param|
        if param.name.name != result_name { c } else {
          report_error_with_labels(
            c,
            b"E0105",
            Bytes::concat_all([b"`result` is bound twice on `", definition.name.name, b"`"]),
            [
              label_at(c.module, param.name.span, true, b"this parameter is named `result`"),
              label_at(c.module, ensures, false, b"`ensures` binds `result` to the return value"),
            ],
            [b"rename the parameter; a definition with no `ensures` may still call one `result`"],
          )
        }),
  }

pub fn algebraic_shapes(checker: Checker) -> Shapes =
  checker.types.fold(
    sum_shapes(checker.constructors),
    |accumulator: Shapes, name: Bytes, declaration: TypeDeclaration|
      match declaration.declared {
        DeclaredExtern ->
          accumulator.insert(name, {
            name: name,
            params: [],
            effect_params: [],
            fields: [],
            native: true,
          }),
        _ -> accumulator,
      },
  )

pub fn sum_shapes(constructors: List<ConstructorInfo>) -> Shapes =
  constructors.fold(Map::new(), |accumulator: Shapes, constructor_info: ConstructorInfo|
    match accumulator.get(constructor_info.type_name) {
      None -> {
        let scheme = constructor_info.scheme;
        accumulator.insert(constructor_info.type_name, {
          name: constructor_info.type_name,
          params: if scheme.label_variables.len() == 0 { scheme.type_variables }
          else { scheme.type_variables.concat(scheme.label_variables) },
          effect_params: scheme.effect_variables,
          fields: constructor_info.fields,
          native: false,
        })
      },
      Some(a) ->
        accumulator.insert(constructor_info.type_name, {
          ..a,
          fields: a.fields.concat(constructor_info.fields),
        }),
    })

fn with_implied_orders(
  checker: Checker,
  definitions: List<FnDefinition>,
) -> List<FnDefinition> / {abort.raise} =
  definitions.map(|d: FnDefinition|
    if may_need_order(d) { with_implied_order(checker, d) } else { d })

fn with_implied_order(checker: Checker, definition: FnDefinition) -> FnDefinition / {abort.raise} = {
  let before = checker.constrained_uses.len();
  let s = written_signature(checker, definition);
  let implied = range(before, s.checker.constrained_uses.len()).fold(
    [],
    |accumulator: List<{ deriver: Deriver, var: Int }>, i: Int| {
      let site = s.checker.constrained_uses.get(i);
      variables_of_type(site.ty).fold(
        accumulator,
        |b: List<{ deriver: Deriver, var: Int }>, v: Int|
          if b.any(|x: { deriver: Deriver, var: Int }| x.var == v && x.deriver == site.deriver) {
            b
          } else { b.push({ deriver: site.deriver, var: v }) },
      )
    },
  );
  let needed = s.sig.params.push(s.sig.return_type).fold([], |accumulator: List<Int>, t: Type|
    ints_union(accumulator, ordered_variables(checker, t)));
  definition.generics.types.fold(definition, |d: FnDefinition, g: Identifier|
    match s.sig.type_params.get(g.name) {
      Some(VariableType(v)) -> {
        let ordered: FnDefinition = if !needed.contains(v)
            || d.constraints.any(|c: Constraint|
              c.param.name == g.name && c.deriver == OrderingDeriver) { d } else {
          {
            ..d,
            constraints: d.constraints.push({
              deriver: OrderingDeriver,
              deriver_span: g.span,
              param: g,
              span: g.span,
            }),
          }
        };
        implied.fold(ordered, |dd: FnDefinition, x: { deriver: Deriver, var: Int }|
          if x.var != v
              || dd.constraints.any(|c: Constraint|
                c.param.name == g.name && c.deriver == x.deriver) { dd } else {
            {
              ..dd,
              constraints: dd.constraints.push({
                deriver: x.deriver,
                deriver_span: g.span,
                param: g,
                span: g.span,
              }),
            }
          })
      },
      _ -> d,
    })
}

fn may_need_order(definition: FnDefinition) -> Bool = {
  let names = definition.generics.types.map(|g: Identifier| g.name);
  let carries = |t: TypeExpression| type_may_need_order(t, names);
  names.len() > 0
    && (definition.params.any(|p: Param| match p.ty { Some(t) -> carries(t), None -> false })
    || (match definition.return_type { Some(t) -> carries(t), None -> false }))
}

fn type_may_need_order(t: TypeExpression, names: List<Bytes>) -> Bool =
  match t {
    NamedTypeExpression(c) ->
      ((!is_bare(c.name) || c.name.name.name == map_name
        || (builtin_type_arity(c.name.name.name) == None && !names.contains(c.name.name.name)))
        && c.args.any(|a: TypeExpression| writes_param(a, names)))
        || c.args.any(|a: TypeExpression| type_may_need_order(a, names)),
    FunctionTypeExpression(f) ->
      type_may_need_order(f.return_type, names)
        || f.params.any(|p: TypeExpression| type_may_need_order(p, names)),
    RecordTypeExpression(r) ->
      r.fields.any(|f: { name: Identifier, ty: TypeExpression }| type_may_need_order(f.ty, names)),
    _ -> false,
  }

fn writes_param(t: TypeExpression, names: List<Bytes>) -> Bool =
  match t {
    VariableTypeExpression(id) -> names.contains(id.name),
    NamedTypeExpression(c) ->
      (is_bare(c.name) && c.args.len() == 0 && names.contains(c.name.name.name))
        || c.args.any(|a: TypeExpression| writes_param(a, names)),
    FunctionTypeExpression(f) ->
      writes_param(f.return_type, names)
        || f.params.any(|p: TypeExpression| writes_param(p, names)),
    RecordTypeExpression(r) ->
      r.fields.any(|f: { name: Identifier, ty: TypeExpression }| writes_param(f.ty, names)),
    _ -> false,
  }

fn declaration_depth_limit(checker: Checker) -> Int =
  checker.constructors.len() + checker.nominals.len() + 1

pub fn is_key(kind: InstanceKind) -> Bool =
  match kind {
    KeyInstance -> true,
    ShowInstance -> false,
    InvariantInstance -> false,
    HostInstance -> false,
    ReleaseInstance -> false,
  }

pub fn body_walking_name(owner: Bytes) -> Bytes = owner.concat(b"#")

pub fn unlowered_of(walked: Bytes) -> Option<Bytes> =
  if walked.ends_with(b"#") { walked.slice_at(0, walked.len() - 1) } else { None }

pub fn members_in(
  all: List<MemberSite>,
  module: Int,
  signatures: Map<Bytes, Parameters>,
) -> Map<Bytes, Map<Int, MemberCallee>> =
  all.fold(Map::new(), |accumulator: Map<Bytes, Map<Int, MemberCallee>>, s: MemberSite|
    if s.module != module { accumulator } else {
      let params = match s.callee {
        CallsFunction(n) -> match signatures.get(n) { Some(g) -> g.params, None -> [] },
        _ -> [],
      };
      let sites = match accumulator.get(s.owner) { Some(m) -> m, None -> Map::new() };
      accumulator.insert(
        s.owner,
        sites.insert(s.site, match s.callee {
          CallsField -> InField,
          _ ->
            WrittenOut({
              qualifier: s.qualifier,
              name: s.name,
              names: params.map(|p: ParamInfo| p.name),
              defaults: params.map(|p: ParamInfo| p.default),
            }),
        }),
      )
    })

test "an extern records how many machine words a call passes, with extra words for its `where` constraints, and whether it can raise" {
  let named = |name: Bytes|
    prelude_externs.filter(|e: Extern| e.name == name).map(|e: Extern|
      { words: e.words, raises: e.raises });
  assert_eq(named(b"List::len"), [{ words: 1, raises: false }]);
  assert_eq(named(b"numeric_of_int"), [{ words: 2, raises: true }]);
  assert_eq(
    externs_in(
      b"std.native",
      b"  extern  fn spaced<a, b>(x: a, y: b) -> a\n  where numeric(a), integer(a), numeric(b)\n\n/// Doubled.\npub extern fn doubled<a>(x: a) -> a / {abort.raise}\n  where numeric(a)\n\nfn not_one() -> Bytes = b\"extern fn one()\"\n",
    ),
    [
      { module: b"std.native", name: b"spaced", words: 4, raises: false, call: None },
      { module: b"std.native", name: b"doubled", words: 2, raises: true, call: None },
    ],
  );
  assert_eq(externs_in(b"m", b"extern fn doubled(x: Int) -> Int\n"), [])
}

test "a standard-library extern over only machine types records its parameter and result types, and any other extern records no types" {
  let call = |source: Bytes|
    externs_in(b"std.native", source).map(|e: Extern| { words: e.words, call: e.call });
  let int = int_type;
  let text = string_type;
  assert_eq(call(b"extern fn named(id: Int, sep: String) -> Bytes\n"), [
    {
      words: 3,
      call: Some({ params: [MachineInt(int), MachineText(text)], result: MachineText(bytes_type) }),
    },
  ]);
  assert_eq(
    call(b"extern fn told(on: Bool, x: Float, c: Char, w: U64) -> Unit\n").map(
      |c: { words: Int, call: Option<MachineCall> }| c.words,
    ),
    [4],
  );
  assert_eq(call(b"type Pid = Int\nextern fn pid() -> Pid\n"), [
    { words: 0, call: Some({ params: [], result: MachineInt(int) }) },
  ]);
  assert_eq(call(b"extern fn sealed(s: Secret<Bytes>) -> Secret<String>\n"), [
    {
      words: 1,
      call: Some({
        params: [MachineSecret(secret_type(bytes_type))],
        result: MachineSecret(secret_type(text)),
      }),
    },
  ]);
  let object_type = NamedType({ name: b"std.native.Kept", args: [] });
  assert_eq(
    call(b"extern type Kept\nextern fn keep<a>(x: a) -> Kept\nextern fn open<a>(k: Kept) -> a\n"),
    [
      {
        words: 2,
        call: Some({ params: [MachineTypeVariable(0)], result: MachineObject(object_type) }),
      },
      {
        words: 2,
        call: Some({ params: [MachineObject(object_type)], result: MachineTypeVariable(0) }),
      },
    ],
  );
  let task = task_type(VariableType(0));
  assert_eq(call(b"extern fn started<a | e>(t: Task<a>, body: () -> Unit / e) -> Int\n"), [
    {
      words: 4,
      call: Some({ params: [MachineObject(task), MachineFunction(0)], result: MachineInt(int) }),
    },
  ]);
  [
    b"extern fn wide(x: U128) -> Int\n",
    b"extern fn listed(xs: List<Int>) -> Int\n",
    b"extern fn any<a>(xs: List<a>) -> Int\n",
    b"extern fn raised(x: Int) -> Int / {abort.raise}\n",
    b"extern fn nothing(u: Unit) -> Int\n",
  ].fold((), |_: Unit, source: Bytes|
    assert_eq(call(source).map(|c: { words: Int, call: Option<MachineCall> }| c.call), [None]));
  assert(prelude_externs.all(|e: Extern| e.call == None), None)
}
