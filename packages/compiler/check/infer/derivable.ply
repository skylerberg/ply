import compiler.syntax.parsing (Span)
import compiler.syntax.items (Item, FunctionItem, FnDefinition, Deriver, EqDeriver, OrderingDeriver,
                              ShowDeriver, HashDeriver, NumericDeriver, IntegerDeriver,
                              is_predicate, deriver_text, deriver_tag, InstanceItem, InstanceKind,
                              KeyInstance, ShowInstance)
import compiler.check.types (Type, VariableType, NamedType, RecordType, FunctionType, Field,
                             ints_insert, ints_union, is_rigid_type, type_text, printer_new,
                             print_type, NominalType, arg_label, arg_effects)
import compiler.check.resolve.tables (Diagnostic, Label, qualify, default_binder, error_at,
                                      label_at)
import compiler.check.typed (NumericWitness, ConcreteWitness, ParamWitness, StatedWitness)
import compiler.check.infer.derivability (DeriveRejection, ContainsFunction, ContainsHandle,
                                          ContainsFloat, Unconstrained, ContainsSecret,
                                          ContainsNative, rejection_note, secret_reason,
                                          float_reason)
import std.bytes
import std.option
import std.string
import compiler.check.infer.checker (RecordDeclaration, OperationInfo, EffectInfo, InstanceInfo,
                                     Assumption, RigidParam, MapKeySite, ConstraintSite,
                                     DefinitionConstraint, AliasConstraint, insert_constraint,
                                     Checker, report, report_error_at, report_error_with_labels,
                                     deriver_description, resolve, Blocker, AlgebraicShape, Shapes,
                                     derivable, order_needs, variables_of_type)
import compiler.check.infer.names (simple_name_of)
import compiler.check.infer.declarations (assume, written_signature, OrderedPart, note_parts,
                                          note_type_constraint)
import compiler.check.infer.expression (operation_free_variables, numeric_of, ordered_parts,
                                        note_type_constraints_in)
import compiler.check.known (name_of, is_integer_name, is_float, is_decimal)
import compiler.check.infer.definitions (algebraic_shapes, is_key)

fn with_flexible(checker: Checker, ty: Type, assumed: List<Int>) -> List<Int> / {abort.raise} =
  variables_of_type(ty).fold(assumed, |vs: List<Int>, v: Int|
    if is_rigid_type(checker.substitution, v) { vs } else { ints_insert(vs, v) })

pub fn native_notes(blocker: Bytes, deriver: Deriver) -> List<Bytes> =
  [
    Bytes::concat_all([
      b"`",
      blocker,
      b"` is an `extern type`: the toolchain lays out its values, and gives them no ",
      deriver_description(deriver),
    ]),
  ]

pub fn secret_rejection_notes(deriver: Deriver) -> List<Bytes> =
  match rejection_note(ContainsSecret, deriver) {
    Some(n) -> [secret_reason(deriver), n],
    None -> [secret_reason(deriver)],
  }

fn param_name(params: List<RigidParam>, v: Int, fallback: Bytes) -> Bytes =
  params.fold(fallback, |accumulator: Bytes, p: RigidParam|
    if p.var == v { p.name } else { accumulator })

fn reason_notes_for_map_key(
  w: DeriveRejection,
  b: Blocker,
  blocker: Bytes,
  params: List<RigidParam>,
) -> List<Bytes> =
  match w {
    ContainsFloat ->
      [
        b"`Float` has no total order: `NaN` is not equal to itself, so the `Map` could not reliably find a key it stored",
        b"use `Decimal` for exact numbers, or use a different key type",
      ],
    ContainsFunction -> [b"a function has no order to sort keys by"],
    ContainsHandle ->
      [
        Bytes::concat_all([
          b"a `",
          name_of(b.ty),
          b"` names a location rather than a value, so two of them have no order",
        ]),
      ],
    ContainsSecret -> secret_rejection_notes(OrderingDeriver),
    ContainsNative -> native_notes(blocker, OrderingDeriver),
    Unconstrained(v) ->
      [
        Bytes::concat_all([
          b"add `where derivable(ord, ",
          param_name(params, v, blocker),
          b")` to this signature; the body may then assume it",
        ]),
      ],
  }

fn reason_notes_for_constraint(
  w: DeriveRejection,
  deriver: Deriver,
  b: Blocker,
  blocker: Bytes,
  params: List<RigidParam>,
) -> List<Bytes> =
  match w {
    ContainsFunction ->
      [
        Bytes::concat_all([
          b"`",
          blocker,
          b"` is a function, and a function has no ",
          deriver_description(deriver),
        ]),
      ],
    ContainsHandle ->
      [
        Bytes::concat_all([
          b"a `",
          name_of(b.ty),
          b"` names a location rather than a value, so it has no encoding",
        ]),
      ],
    ContainsFloat -> [float_reason(deriver), b"use `Decimal` for exact numbers"],
    ContainsSecret -> secret_rejection_notes(deriver),
    ContainsNative -> native_notes(blocker, deriver),
    Unconstrained(v) ->
      [
        Bytes::concat_all([
          b"add `where derivable(",
          deriver_text(deriver),
          b", ",
          param_name(params, v, blocker),
          b")` to the signature this call sits in; the body may then assume it",
        ]),
      ],
  }

fn comparison_shapes(checker: Checker) -> Shapes / {abort.raise} =
  if checker.keyed_names.len() == 0 { algebraic_shapes(checker) } else {
    range(0, checker.modules.len()).fold(algebraic_shapes(checker), |accumulator: Shapes, i: Int| {
      let m = checker.modules.get(i);
      m.module.items.fold(accumulator, |shapes: Shapes, item: Item|
        match item {
          InstanceItem(definition) -> if !is_key(definition.kind) { shapes } else {
            let type_name = qualify(m.name, definition.target.name);
            match shapes.get(type_name) {
              None -> shapes,
              Some(shape) -> {
                let by = m.module.items.fold(None, |found: Option<FnDefinition>, it: Item|
                  match found {
                    Some(_) -> found,
                    None -> match it {
                      FunctionItem(f) -> if f.name.name == definition.function.name { Some(f) }
                      else { None },
                      _ -> None,
                    },
                  });
                let returned = match by {
                  None -> None,
                  Some(f) -> {
                    let s = written_signature({ ..checker, module: i }, f);
                    match s.sig.params.at(0) {
                      None -> None,
                      Some(p) -> match own_params(p, type_name) {
                        Some(own) -> if variables_of_type(s.sig.return_type).all(|v: Int|
                            own.params.contains(v)) {
                          Some({
                            params: own.params,
                            effect_params: own.effect_params,
                            result: s.sig.return_type,
                          })
                        } else { None },
                        None -> None,
                      },
                    }
                  },
                };
                shapes.insert(type_name, match returned {
                  Some(a) ->
                    {
                      ..shape,
                      params: a.params,
                      effect_params: a.effect_params,
                      fields: [a.result],
                    },
                  None -> { ..shape, fields: [] },
                })
              },
            }
          },
          _ -> shapes,
        })
    })
  }

pub fn with_orders(checker: Checker) -> Checker / {abort.raise} = {
  let ordering = comparison_shapes(checker);
  let sums = algebraic_shapes(checker).fold(
    [],
    |accumulator: List<TypeContents>, name: Bytes, s: AlgebraicShape|
      accumulator.push({ name: name, params: s.params, fields: s.fields }),
  );
  let type_contents = checker.nominals.fold(
    sums,
    |accumulator: List<TypeContents>, name: Bytes, r: RecordDeclaration|
      match r.ty {
        NominalType(n) ->
          accumulator.push({
            name: name,
            params: r.type_variables,
            fields: n.fields.map(|f: Field| f.ty),
          }),
        _ -> accumulator,
      },
  );
  let carrying = ordered_params_of(
    type_contents.filter(|h: TypeContents| h.params.len() > 0),
    ordering,
  );
  let stated = declared_type_constraints(type_contents, checker.stated, checker.alias_constraints);
  let declared: Checker = type_contents.fold(
    { ..checker, stated: stated },
    |c: Checker, h: TypeContents|
      match c.types.get(h.name) {
        None -> c,
        Some(declaration) -> {
          let noted = h.fields.fold({ ..c, module: declaration.owner }, |cc: Checker, f: Type|
            note_type_constraints_in(cc, declaration.span, f));
          let hinted = c.alias_constraints.fold(noted, |cc: Checker, hint: AliasConstraint|
            if hint.type_name != h.name { cc } else {
              note_type_constraint(cc, declaration.span, hint.deriver, hint.ty, hint.from, true)
            });
          { ..hinted, module: c.module }
        },
      },
  );
  let carried_in = |types: List<Type>|
    types.fold([], |ps: List<OrderedPart>, t: Type| ordered_parts(carrying, t, ps)).filter(
      |p: OrderedPart| match p.container { Some(_) -> true, None -> false },
    );
  let typed = type_contents.fold(
    { ..declared, type_shapes: ordering, ordered_parameters: carrying, aliases: Map::new() },
    |c: Checker, h: TypeContents|
      match c.types.get(h.name) {
        None -> c,
        Some(declaration) ->
          note_parts_at(c, declaration.owner, declaration.span, h.params, carried_in(h.fields)),
      },
  );
  typed.effects.fold(typed, |c: Checker, e: EffectInfo|
    e.operations.fold(c, |cc: Checker, operation: OperationInfo|
      note_parts_at(
        cc,
        operation.at.module,
        operation.at.span,
        operation_free_variables(operation),
        carried_in(operation.params.push(operation.return_type)),
      )))
}

fn note_parts_at(
  checker: Checker,
  module: Int,
  span: Span,
  params: List<Int>,
  parts: List<OrderedPart>,
) -> Checker / {abort.raise} =
  if parts.len() == 0 { checker } else {
    let noted = note_parts(
      {
        ..checker,
        module: module,
        assumed: params.fold([], |xs: List<Assumption>, v: Int| assume(xs, OrderingDeriver, v)),
      },
      span,
      parts,
    );
    { ..noted, module: checker.module, assumed: checker.assumed }
  }

type TypeContents = { name: Bytes, params: List<Int>, fields: List<Type> }

type VariableConstraint = { deriver: Deriver, var: Int }

fn push_constraint(
  xs: List<VariableConstraint>,
  deriver: Deriver,
  v: Int,
) -> List<VariableConstraint> =
  if xs.any(|x: VariableConstraint| x.var == v && x.deriver == deriver) { xs }
  else { xs.push({ deriver: deriver, var: v }) }

fn variable_constraints(
  table: Map<Bytes, List<DefinitionConstraint>>,
  t: Type,
  out: List<VariableConstraint>,
) -> List<VariableConstraint> / {abort.raise} = {
  let carried = |name: Bytes, args: List<Type>|
    match table.get(name) {
      None -> out,
      Some(cs) ->
        cs.fold(out, |accumulator: List<VariableConstraint>, dc: DefinitionConstraint|
          match args.at(dc.param) {
            None -> accumulator,
            Some(a) ->
              variables_of_type(a).fold(accumulator, |b: List<VariableConstraint>, v: Int|
                push_constraint(b, dc.deriver, v)),
          }),
    };
  let within = |types: List<Type>, accumulator: List<VariableConstraint>|
    types.fold(accumulator, |a: List<VariableConstraint>, ty: Type|
      variable_constraints(table, ty, a));
  match t {
    NamedType(c) -> within(c.args, carried(c.name, c.args)),
    NominalType(n) -> within(n.args, carried(n.name, n.args)),
    RecordType(fs) -> within(fs.map(|f: Field| f.ty), out),
    FunctionType(f) -> within(f.params.push(f.return_type), out),
    VariableType(_) -> out,
  }
}

fn declared_type_constraints(
  type_contents: List<TypeContents>,
  seeds: Map<Bytes, List<DefinitionConstraint>>,
  hints: List<AliasConstraint>,
) -> Map<Bytes, List<DefinitionConstraint>> / {abort.raise} = {
  let room = type_contents.fold(2, |n: Int, h: TypeContents| n + h.params.len());
  iterate(seeds, room, |table: Map<Bytes, List<DefinitionConstraint>>| {
    let next = type_contents.fold(
      { table: table, grew: false },
      |accumulator: { table: Map<Bytes, List<DefinitionConstraint>>, grew: Bool }, h: TypeContents| {
        let needed = h.fields.fold([], |vs: List<VariableConstraint>, f: Type|
          variable_constraints(accumulator.table, f, vs));
        let all = hints.fold(needed, |vs: List<VariableConstraint>, hint: AliasConstraint|
          if hint.type_name != h.name { vs } else {
            variables_of_type(hint.ty).fold(vs, |b: List<VariableConstraint>, v: Int|
              push_constraint(b, hint.deriver, v))
          });
        let had = match accumulator.table.get(h.name) { Some(xs) -> xs, None -> [] };
        let added = all.fold(had, |cs: List<DefinitionConstraint>, x: VariableConstraint|
          match h.params.find_index(|p: Int| p == x.var) {
            None -> cs,
            Some(i) -> if cs.any(|c: DefinitionConstraint| c.param == i && c.deriver == x.deriver) {
              cs
            } else { insert_constraint(cs, { deriver: x.deriver, param: i }) },
          });
        if added.len() == had.len() { accumulator }
        else { { table: accumulator.table.insert(h.name, added), grew: true } }
      },
    );
    if next.grew { Continue(next.table) } else { Stop(next.table) }
  })
}

fn ordered_params_of(
  type_contents: List<TypeContents>,
  ordering: Shapes,
) -> Map<Bytes, List<Int>> / {abort.raise} = {
  let room = type_contents.fold(2, |n: Int, h: TypeContents| n + h.params.len());
  iterate(Map::new(), room, |table: Map<Bytes, List<Int>>| {
    let next = type_contents.fold(
      { table: table, grew: false },
      |accumulator: { table: Map<Bytes, List<Int>>, grew: Bool }, h: TypeContents| {
        let needed = h.fields.fold([], |vs: List<Int>, f: Type|
          ordered_parts(accumulator.table, f, []).fold(vs, |ws: List<Int>, p: OrderedPart|
            ints_union(ws, order_needs(p.key, ordering))));
        let ps = positions_among(h.params, needed);
        let had = match accumulator.table.get(h.name) { Some(xs) -> xs, None -> [] };
        if ps.len() == had.len() { accumulator }
        else { { table: accumulator.table.insert(h.name, ps), grew: true } }
      },
    );
    if next.grew { Continue(next.table) } else { Stop(next.table) }
  })
}

fn positions_among(variables: List<Int>, keyed: List<Int>) -> List<Int> =
  range(0, variables.len()).filter(|i: Int|
    match variables.at(i) { Some(v) -> keyed.contains(v), None -> false })

pub fn check_map_keys(checker: Checker) -> Checker / {abort.raise} = {
  let ordered = instance_shapes(checker.instances, algebraic_shapes(checker), OrderingDeriver);
  let walked = checker.map_keys.fold(
    { checker: { ..checker, map_keys: [] }, seen: [] },
    |accumulator: { checker: Checker, seen: List<SeenKey> }, site: MapKeySite| {
      let key = resolve(accumulator.checker, site.key);
      match derivable(
          OrderingDeriver,
          key,
          ordered,
          with_flexible(accumulator.checker, key, site.assumed),
        ) {
        None -> accumulator,
        Some(blocked) -> {
          let printed = print_type(printer_new(), resolve(accumulator.checker, site.whole));
          let rendered = printed.text;
          let blocker = print_type(printed.printer, blocked.ty).text;
          let carried = match site.carrier { Some(_) -> true, None -> false };
          let dup = accumulator.seen.fold(false, |b: Bool, s: SeenKey|
            b
              || (s.scope == site.scope
              && (s.text == rendered || (s.blocker == blocker && (s.has_carrier || carried)))));
          if dup { accumulator } else {
            {
              checker: report(
                accumulator.checker,
                error_at(
                  b"E0206",
                  site.module,
                  site.span,
                  Bytes::concat_all([
                    b"`",
                    blocker,
                    b"` is not an ordered type, so it cannot be a `Map` key",
                  ]),
                  match site.carrier {
                    None -> Bytes::concat_all([b"this map's key type is `", rendered, b"`"]),
                    Some(t) ->
                      Bytes::concat_all([
                        b"`",
                        type_text(resolve(accumulator.checker, t)),
                        b"` keys a `Map` by `",
                        rendered,
                        b"`",
                      ]),
                  },
                  with_alias_note(
                    reason_notes_for_map_key(blocked.reason, blocked, blocker, site.params),
                    site.via,
                  ).concat(match site.carrier {
                    None -> [],
                    Some(_) ->
                      [
                        b"a type that uses a parameter as a `Map` key requires that parameter to support ordering: add an `ordered` constraint to the parameter everywhere the type is written or constructed",
                      ],
                  }),
                ),
              ),
              seen: accumulator.seen.push({
                scope: site.scope,
                text: rendered,
                blocker: blocker,
                has_carrier: carried,
              }),
            }
          }
        },
      }
    },
  );
  walked.checker
}

type SeenKey = { scope: Int, text: Bytes, blocker: Bytes, has_carrier: Bool }

fn with_alias_note(notes: List<Bytes>, via: Bytes) -> List<Bytes> =
  if via == b"" { notes } else {
    notes.push(
      Bytes::concat_all([
        b"`",
        via,
        b"` is a type alias, and the `Map` key is in the type it stands for",
      ]),
    )
  }

fn is_case_constraint(site: ConstraintSite) -> Bool =
  site.callee == b"std.cases.listed" || site.callee == b"std.cases.chosen"

pub fn check_constraints(checker: Checker) -> Checker / {abort.raise} = {
  let adts = algebraic_shapes(checker);
  let shapes = deriver_shapes(checker.instances, adts);
  let walked = checker.constrained_uses.fold(
    { checker: { ..checker, constrained_uses: [] }, seen: [] },
    |accumulator: { checker: Checker, seen: List<{ module: Int, span: Span, text: Bytes, tag: Int }> }, site: ConstraintSite| {
      let ty = resolve(accumulator.checker, site.ty);
      if is_predicate(site.deriver) {
        { checker: check_predicate(accumulator.checker, site, ty), seen: accumulator.seen }
      } else {
        let through = shapes_for(shapes, site.deriver);
        let assumed = with_flexible(accumulator.checker, ty, site.assumed);
        match derivable(
            site.deriver,
            ty,
            if is_case_constraint(site) { adts } else { through },
            assumed,
          ) {
          None -> accumulator,
          Some(blocked) -> {
            let printed = print_type(printer_new(), ty);
            let rendered = printed.text;
            let tag = deriver_tag(site.deriver);
            let dup = accumulator.seen.fold(
              false,
              |b: Bool, s: { module: Int, span: Span, text: Bytes, tag: Int }|
                b
                  || (s.module == site.module && s.span.start == site.span.start
                  && s.span.end == site.span.end
                  && s.text == rendered
                  && s.tag == tag),
            );
            if dup { accumulator } else {
              let blocker = print_type(printed.printer, blocked.ty).text;
              let callee = default_binder(site.callee);
              let dv = deriver_text(site.deriver);
              {
                checker: report_error_with_labels(
                  accumulator.checker,
                  b"E0206",
                  Bytes::concat_all([b"`", rendered, b"` cannot be derived for `", dv, b"`"]),
                  [
                    label_at(
                      site.module,
                      site.span,
                      true,
                      Bytes::concat_all([
                        b"`",
                        callee,
                        b"` requires `derivable(",
                        dv,
                        b", \xc2\xb7)` here",
                      ]),
                    ),
                    label_at(
                      site.callee_at.module,
                      site.callee_at.span,
                      false,
                      Bytes::concat_all([
                        b"`",
                        callee,
                        match site.written_on_type {
                          None -> b"` declares the constraint on its signature",
                          Some(written) -> if written {
                            b"` states the constraint on its declaration"
                          } else { b"` gets the constraint from the types it contains" },
                        },
                      ]),
                    ),
                  ],
                  reason_notes_for_constraint(
                    blocked.reason,
                    site.deriver,
                    blocked,
                    blocker,
                    site.params,
                  ).concat(
                    if is_case_constraint(site)
                        && derivable(site.deriver, ty, through, assumed) == None {
                      [
                        b"cases are distinguished by their payload types, so a `key` constraint on another type does not replace the constraint on the type that declares the case",
                      ]
                    } else { [] },
                  ),
                ),
                seen: accumulator.seen.push({
                  module: site.module,
                  span: site.span,
                  text: rendered,
                  tag: tag,
                }),
              }
            }
          },
        }
      }
    },
  );
  walked.checker
}

pub fn resolved_witness(checker: Checker, deriver: Deriver, ty: Type) -> Option<NumericWitness> =
  match ty {
    VariableType(v) -> match checker.witnessed.get(v) {
      Some(w) -> Some(ParamWitness(w.param)),
      None -> None,
    },
    _ -> concrete_witness(checker, deriver, ty),
  }

fn concrete_witness(checker: Checker, deriver: Deriver, ty: Type) -> Option<NumericWitness> =
  match ty {
    NamedType(k) -> if k.args.len() != 0 { None }
    else if is_integer_name(k.name) { Some(ConcreteWitness(k.name)) }
    else if deriver == NumericDeriver && (is_float(ty) || is_decimal(ty)) {
      Some(ConcreteWitness(k.name))
    } else if deriver == NumericDeriver {
      match numeric_of(checker.numeric_types, k.name) {
        Some(x) -> match instance_of(checker.instances, k.name, KeyInstance) {
          Some(_) -> Some(StatedWitness(x.constructor)),
          None -> None,
        },
        None -> None,
      }
    } else { None },
    _ -> None,
  }

fn predicate_witness(checker: Checker, site: ConstraintSite, ty: Type) -> Option<NumericWitness> =
  match ty {
    VariableType(v) -> if !site.assumed.contains(v) { None } else {
      match site.params.fold(None, |accumulator: Option<Bytes>, r: RigidParam|
          if r.var == v { Some(r.name) } else { accumulator }) {
        Some(name) -> Some(ParamWitness(name)),
        None -> None,
      }
    },
    _ -> concrete_witness(checker, site.deriver, ty),
  }

fn check_predicate(checker: Checker, site: ConstraintSite, ty: Type) -> Checker / {abort.raise} = {
  let callee = default_binder(site.callee);
  let dv = deriver_text(site.deriver);
  if !site.called {
    if checker.diagnostics.fold(false, |b: Bool, diagnostic: Diagnostic|
        b || (diagnostic.code == b"E0310" && has_primary_at(diagnostic, site))) { checker } else {
      report_error_at(
        { ..checker, module: site.module },
        b"E0310",
        site.span,
        Bytes::concat_all([b"`", callee, b"` must be called directly"]),
        b"used as a value",
        [
          Bytes::concat_all([
            b"`",
            callee,
            b"` takes the type its `",
            dv,
            b"` constraint is about as a hidden argument each call fills",
          ]),
          b"wrap it in a lambda that calls it",
        ],
      )
    }
  } else {
    match predicate_witness(checker, site, ty) {
      Some(_) -> checker,
      None -> match ty {
        VariableType(v) -> if is_rigid_type(checker.substitution, v) {
          report_error_at(
            { ..checker, module: site.module },
            b"E0201",
            site.span,
            Bytes::concat_all([
              b"`",
              callee,
              b"` needs `",
              dv,
              b"(\xc2\xb7)` of a type parameter that has none",
            ]),
            Bytes::concat_all([b"`", callee, b"` requires `", dv, b"(\xc2\xb7)` here"]),
            [b"add the constraint to this signature's `where`; the body may then assume it"],
          )
        } else {
          report_error_at(
            { ..checker, module: site.module },
            b"E0210",
            site.span,
            Bytes::concat_all([
              b"the numeric type that `",
              callee,
              b"` is called with is not determined",
            ]),
            b"nothing here says which numeric type this is",
            [b"annotate an argument, or write a literal that pins it (`1`, `1.0`, `1m`)"],
          )
        },
        _ ->
          report_error_at(
            { ..checker, module: site.module },
            b"E0201",
            site.span,
            Bytes::concat_all([
              b"`",
              type_text(ty),
              if site.deriver == IntegerDeriver { b"` is not an integer type" }
              else { b"` is not a numeric type" },
            ]),
            Bytes::concat_all([b"`", callee, b"` requires `", dv, b"(\xc2\xb7)` here"]),
            if site.deriver == IntegerDeriver {
              [b"the integer types are `Int` and the eight fixed-width integers"]
            } else {
              [
                b"the numeric types are `Int`, the eight fixed-width integers, `Float`, `Decimal`, and a type that states `numeric` and a `key`",
              ].concat(match ty {
                NamedType(k) -> match numeric_of(checker.numeric_types, k.name) {
                  Some(_) ->
                    [
                      Bytes::concat_all([
                        b"`",
                        simple_name_of(k.name),
                        b"` states `numeric` and no `key`: `numeric(\xc2\xb7)` holds `<` and the rest, which a type takes from its `key`",
                      ]),
                    ],
                  None -> [],
                },
                _ -> [],
              })
            },
          ),
      },
    }
  }
}

fn has_primary_at(diagnostic: Diagnostic, site: ConstraintSite) -> Bool =
  diagnostic.labels.fold(false, |b: Bool, label: Label|
    b
      || (label.primary && label.module == site.module && label.start == site.span.start
      && label.end == site.span.end))

pub fn instance_of(
  instances: List<InstanceInfo>,
  type_name: Bytes,
  kind: InstanceKind,
) -> Option<InstanceInfo> =
  instances.fold(None, |accumulator: Option<InstanceInfo>, x: InstanceInfo|
    match accumulator {
      Some(_) -> accumulator,
      None -> if x.type_name == type_name && x.kind == kind { Some(x) } else { None },
    })

fn compares_through_key(deriver: Deriver) -> Bool =
  deriver == EqDeriver || deriver == OrderingDeriver || deriver == HashDeriver

fn instances_by_type(
  instances: List<InstanceInfo>,
  kind: InstanceKind,
) -> Map<Bytes, InstanceInfo> =
  instances.fold(Map::new(), |accumulator: Map<Bytes, InstanceInfo>, x: InstanceInfo|
    if x.kind != kind || accumulator.contains(x.type_name) { accumulator }
    else { accumulator.insert(x.type_name, x) })

pub fn instance_shapes(instances: List<InstanceInfo>, adts: Shapes, deriver: Deriver) -> Shapes =
  if instances.len() == 0 { adts } else {
    let keyed = compares_through_key(deriver);
    if !keyed && !(deriver == ShowDeriver) { adts } else {
      let stated = instances_by_type(instances, if keyed { KeyInstance } else { ShowInstance });
      adts.fold(adts, |accumulator: Shapes, name: Bytes, shape: AlgebraicShape|
        match stated.get(name) {
          Some(x) ->
            accumulator.insert(name, {
              ..shape,
              params: x.params,
              effect_params: x.effect_params,
              fields: if keyed { [x.results] } else { [] },
            }),
          None -> accumulator,
        })
    }
  }

type DeriverShapes = { plain: Shapes, comparison: Shapes, shown: Shapes }

pub fn deriver_shapes(instances: List<InstanceInfo>, adts: Shapes) -> DeriverShapes =
  {
    plain: adts,
    comparison: instance_shapes(instances, adts, EqDeriver),
    shown: instance_shapes(instances, adts, ShowDeriver),
  }

pub fn shapes_for(shapes: DeriverShapes, deriver: Deriver) -> Shapes =
  if compares_through_key(deriver) { shapes.comparison }
  else if deriver == ShowDeriver { shapes.shown }
  else { shapes.plain }

pub type OwnParams = { params: List<Int>, effect_params: List<Int> }

pub fn own_params(ty: Type, type_name: Bytes) -> Option<OwnParams> =
  match ty {
    NamedType(c) -> if c.name != type_name { None } else {
      c.args.fold(
        Some({ params: [], effect_params: [] }),
        |accumulator: Option<OwnParams>, a: Type|
          match accumulator {
            None -> None,
            Some(own) -> match arg_effects(a) {
              Some(found) -> match found.variable {
                Some(v) -> if found.listed.len() > 0 || own.effect_params.contains(v) { None }
                else { Some({ ..own, effect_params: own.effect_params.push(v) }) },
                None -> None,
              },
              None -> match arg_label(a) {
                Some(_) -> None,
                None -> match a {
                  VariableType(v) -> if own.params.contains(v) { None }
                  else { Some({ ..own, params: own.params.push(v) }) },
                  _ -> None,
                },
              },
            },
          },
      )
    },
    _ -> None,
  }
