fn reason_notes_for_key(
  w: DeriveRejection,
  deriver: Deriver,
  b: Blocker,
  blocker: Bytes,
) -> List<Bytes> =
  match w {
    ContainsFloat -> [float_reason(deriver)],
    ContainsFunction ->
      [b"a function cannot be ordered (compared with `<` or `>`) and has no content to hash"],
    ContainsHandle ->
      [
        Bytes::concat_all([
          b"a `",
          name_of(b.ty),
          b"` is a reference to a storage location rather than a value, so its values cannot be compared with `<` or `>`",
        ]),
      ],
    ContainsSecret -> secret_rejection_notes(deriver),
    ContainsNative -> native_notes(blocker, deriver),
    Unconstrained(_) -> [],
  }

fn report_unfit_instance(
  checker: Checker,
  definition: InstanceDefinition,
  f: DefinitionInfo,
  reason: Bytes,
  note: Bytes,
) -> Checker =
  report_error_with_labels(
    checker,
    b"E0218",
    Bytes::concat_all([
      b"`",
      definition.function.name,
      b"` cannot be the `",
      instance_text(definition.kind),
      b"` of `",
      definition.target.name,
      b"`",
    ]),
    [
      label_at(checker.module, definition.function.span, true, reason),
      label_at(f.at.module, f.at.span, false, b"the function it names"),
    ],
    [
      note,
      match definition.kind {
        KeyInstance ->
          Bytes::concat_all([
            b"a `key` takes one `",
            definition.target.name,
            b"` and returns what `==`, `compare`, `digest` and a `Map` read in its place",
          ]),
        ShowInstance ->
          Bytes::concat_all([
            b"a `show` takes one `",
            definition.target.name,
            b"` and returns the `String` that `show` and string interpolation produce",
          ]),
        InvariantInstance ->
          Bytes::concat_all([
            b"an `invariant` takes one `",
            definition.target.name,
            b"` and returns the `Bool` every value of it satisfies",
          ]),
        HostInstance -> b"",
        ReleaseInstance ->
          Bytes::concat_all([
            b"a `release` takes one `",
            definition.target.name,
            b"`, marked `keep`, and runs when a value of that type is discarded without being used",
          ]),
      },
    ],
  )

fn check_instance(
  checker: Checker,
  m: ParsedModule,
  definition: InstanceDefinition,
) -> Checker / {abort.raise} =
  if definition.kind == ReleaseInstance { check_release(checker, m, definition) }
  else { check_declared_instance(checker, m, definition) }

fn check_release(
  checker: Checker,
  m: ParsedModule,
  definition: InstanceDefinition,
) -> Checker / {abort.raise} = {
  let type_name = qualify(m.name, definition.target.name);
  match checker.types.get(type_name) {
    None ->
      report_error_at(
        checker,
        b"E0208",
        definition.target.span,
        Bytes::concat_all([b"`", definition.target.name, b"` is not a type this module declares"]),
        b"declared in another module, or not at all",
        [
          b"a `release` may only name a type declared in its own module, so that a single function releases every value of that type",
        ],
      ),
    Some(declaration) -> match declaration.declared {
      DeclaredAlias(_) ->
        not_a_sum(
          checker,
          definition.target,
          declaration,
          Bytes::concat_all([
            b"`",
            definition.target.name,
            b"` is an alias, which states no `release`",
          ]),
          b"an alias is the type it names, so a `release` for an alias would make every value of the aliased type a resource",
        ),
      DeclaredExtern ->
        not_a_sum(
          checker,
          definition.target,
          declaration,
          Bytes::concat_all([
            b"`",
            definition.target.name,
            b"` is an `extern type`, which states no `release`",
          ]),
          b"the toolchain controls how its values are stored and frees them itself",
        ),
      DeclaredRecord(_) ->
        not_a_sum(
          checker,
          definition.target,
          declaration,
          Bytes::concat_all([
            b"`",
            definition.target.name,
            b"` is a record, which states no `release`",
          ]),
          b"a resource is an `opaque` sum type, so only its own module can create its values and match on them",
        ),
      _ -> if declaration.opaque == None {
        report_error_at_and(
          checker,
          b"E0225",
          definition.span,
          Bytes::concat_all([
            b"`",
            definition.target.name,
            b"` states a `release` but is not `opaque`",
          ]),
          b"this makes it a resource",
          { module: declaration.owner, span: declaration.span },
          b"declared here",
          [
            b"only the declaring module may build, match on or read a resource; another module could otherwise copy it or take it apart without releasing it",
            Bytes::concat_all([b"write `opaque type ", definition.target.name, b"`"]),
          ],
        )
      } else {
        match instance_of(checker.instances, type_name, ReleaseInstance) {
          Some(first) ->
            report_error_at_and(
              checker,
              b"E0105",
              definition.span,
              Bytes::concat_all([b"`", definition.target.name, b"` states its `release` twice"]),
              b"stated again here",
              first.at,
              b"first stated here",
              [b"a value is let go one way; remove one"],
            ),
          None -> match definition_of(checker, qualify(m.name, definition.function.name)) {
            None ->
              report_error_at(
                checker,
                b"E0101",
                definition.function.span,
                Bytes::concat_all([
                  b"`",
                  definition.function.name,
                  b"` is not a function this module declares",
                ]),
                b"a `release` names a function of its type's own module",
                [],
              ),
            Some(f) -> check_release_signature(checker, definition, type_name, f),
          },
        }
      },
    },
  }
}

fn check_release_signature(
  checker: Checker,
  definition: InstanceDefinition,
  type_name: Bytes,
  f: DefinitionInfo,
) -> Checker / {abort.raise} =
  match resolve(checker, f.scheme.ty) {
    FunctionType(sig) -> if sig.params.len() != 1 {
      report_unfit_instance(
        checker,
        definition,
        f,
        Bytes::concat_all([
          b"this function takes ",
          ascii_of_int(sig.params.len()),
          b" parameters",
        ]),
        b"a `release` is called with the value as its only argument",
      )
    } else if sig.keep_parameters != [0] {
      report_unfit_instance(
        checker,
        definition,
        f,
        b"this function borrows the value",
        Bytes::concat_all([
          b"a `release` takes ownership of the value it releases: write its parameter `keep ",
          type_text(sig.params.get(0)),
          b"`",
        ]),
      )
    } else {
      match released_params(sig.params.get(0), type_name) {
        None ->
          report_unfit_instance(
            checker,
            definition,
            f,
            Bytes::concat_all([b"this function takes `", type_text(sig.params.get(0)), b"`"]),
            Bytes::concat_all([
              b"its parameter is `",
              definition.target.name,
              b"` at the type's own parameters and labels, so it lets go of every `",
              definition.target.name,
              b"` there is",
            ]),
          ),
        Some(own) -> if sig.return_type != unit_type {
          report_unfit_instance(
            checker,
            definition,
            f,
            Bytes::concat_all([b"this function returns `", type_text(sig.return_type), b"`"]),
            b"a `release` runs when a value is discarded, and nothing uses its return value",
          )
        } else {
          {
            ..checker,
            instances: checker.instances.push({
              type_name: type_name,
              kind: ReleaseInstance,
              by: f.name,
              params: own.params,
              effect_params: own.effect_params,
              results: sig.return_type,
              at: { module: checker.module, span: definition.span },
            }),
          }
        },
      }
    },
    _ -> checker,
  }

fn released_params(ty: Type, type_name: Bytes) -> Option<OwnParams> = {
  let args = match ty {
    NamedType(c) -> if c.name == type_name { Some(c.args) } else { None },
    NominalType(n) -> if n.name == type_name { Some(n.args) } else { None },
    _ -> None,
  };
  match args {
    None -> None,
    Some(xs) ->
      xs.fold(Some({ params: [], effect_params: [] }), |accumulator: Option<OwnParams>, a: Type|
        match accumulator {
          None -> None,
          Some(own) -> match arg_effects(a) {
            Some(effects) -> match effects.variable {
              Some(v) -> if effects.listed.len() > 0 || own.effect_params.contains(v) { None }
              else { Some({ ..own, effect_params: own.effect_params.push(v) }) },
              None -> None,
            },
            None -> match match arg_label(a) { Some(l) -> l, None -> a } {
              VariableType(v) -> if own.params.contains(v) { None }
              else { Some({ ..own, params: own.params.push(v) }) },
              _ -> None,
            },
          },
        }),
  }
}

fn check_declared_instance(
  checker: Checker,
  m: ParsedModule,
  definition: InstanceDefinition,
) -> Checker / {abort.raise} = {
  let what = instance_text(definition.kind);
  let one = instance_kind_phrase(definition.kind);
  let type_name = qualify(m.name, definition.target.name);
  match checker.types.get(type_name) {
    None ->
      report_error_at(
        checker,
        b"E0208",
        definition.target.span,
        Bytes::concat_all([b"`", definition.target.name, b"` is not a type this module declares"]),
        b"declared in another module, or not at all",
        [
          Bytes::concat_all([
            one,
            match definition.kind {
              InvariantInstance ->
                b" may only name a type its own module declares, the module that builds every value of it",
              _ ->
                b" may only name a type its own module declares, so that a type means one thing wherever its values are compared or shown",
            },
          ]),
        ],
      ),
    Some(declaration) -> {
      match declaration.declared {
        DeclaredAlias(_) ->
          not_a_sum(
            checker,
            definition.target,
            declaration,
            Bytes::concat_all([
              b"`",
              definition.target.name,
              b"` is not a sum, and ",
              one,
              b" can only be stated for a sum",
            ]),
            Bytes::concat_all([
              b"an alias is the type it names, so ",
              one,
              b" for an alias would apply to every value of the named type",
            ]),
          ),
        DeclaredRecord(_) ->
          not_a_sum(
            checker,
            definition.target,
            declaration,
            Bytes::concat_all([
              b"`",
              definition.target.name,
              b"` is a `new` record, which cannot have ",
              one,
              b" yet",
            ]),
            match definition.kind {
              InvariantInstance ->
                b"the prover checks an invariant wherever a constructor of the type is applied, and a `new` record has no constructor: it is built with a record literal",
              _ ->
                b"a `new` record is stored as a plain record without its type name, so a value cannot tell which type it belongs to when it is compared or shown",
            },
          ),
        DeclaredExtern ->
          not_a_sum(
            checker,
            definition.target,
            declaration,
            Bytes::concat_all([
              b"`",
              definition.target.name,
              b"` is an `extern type`, which states no `",
              what,
              b"`",
            ]),
            match definition.kind {
              InvariantInstance ->
                b"the toolchain creates its values, and no constructor in the program builds a value of this type",
              _ ->
                b"the toolchain decides how its values are stored, so nothing in the program can compare or show them",
            },
          ),
        DeclaredSum -> match instance_of(checker.instances, type_name, definition.kind) {
          Some(first) ->
            report_error_at_and(
              checker,
              b"E0105",
              definition.span,
              Bytes::concat_all([
                b"`",
                definition.target.name,
                b"` states its `",
                what,
                b"` twice",
              ]),
              b"stated again here",
              first.at,
              b"first stated here",
              [b"a type has one, so that nothing has to choose between two; remove one"],
            ),
          None -> if definition.kind == InvariantInstance && declaration.opaque == None
              && is_declared_public(m, definition.target.name) {
            reject_public_invariant(checker, definition, declaration)
          } else {
            match definition_of(checker, qualify(m.name, definition.function.name)) {
              None ->
                report_error_at(
                  checker,
                  b"E0101",
                  definition.function.span,
                  Bytes::concat_all([
                    b"`",
                    definition.function.name,
                    b"` is not a function this module declares",
                  ]),
                  Bytes::concat_all([
                    one,
                    b" must name a function declared in the same module as its type",
                  ]),
                  [],
                ),
              Some(f) -> check_instance_signature(checker, definition, type_name, f),
            }
          },
        },
      }
    },
  }
}

fn instance_kind_phrase(kind: InstanceKind) -> Bytes =
  match kind {
    InvariantInstance -> b"an `invariant`",
    _ -> Bytes::concat_all([b"a `", instance_text(kind), b"`"]),
  }

fn is_declared_public(m: ParsedModule, name: Bytes) -> Bool =
  m.module.items.any(|item: Item|
    match item { TypeItem(t) -> t.name.name == name && is_pub(t.visibility), _ -> false })

fn reject_public_invariant(
  checker: Checker,
  definition: InstanceDefinition,
  declaration: TypeDeclaration,
) -> Checker =
  report_error_at_and(
    checker,
    b"E0480",
    definition.span,
    Bytes::concat_all([
      b"an invariant for `",
      definition.target.name,
      b"`, a type other modules build",
    ]),
    Bytes::concat_all([b"`", definition.target.name, b"` is `pub` and not `opaque`"]),
    { module: declaration.owner, span: declaration.span },
    b"declared here",
    [
      b"a value another module makes would not be checked against it: the prover checks the invariant only where a constructor is applied in the type's own module, and every other use of the type assumes the invariant holds",
      Bytes::concat_all([
        b"declare it `opaque`, as `pub opaque type ",
        definition.target.name,
        b" = | ..`, or drop its `pub`, so that its own module builds every value of it",
      ]),
    ],
  )

fn invariant_defaults(checker: Checker, x: InstanceInfo) -> Checker / {abort.raise} = {
  let constructors = checker.constructors.filter(|k: ConstructorInfo|
    k.type_name == x.type_name).map(|k: ConstructorInfo| k.simple_name);
  checker.modules.get(x.at.module).module.items.fold(
    { ..checker, module: x.at.module },
    |c: Checker, item: Item|
      match item {
        FunctionItem(definition) ->
          definition.params.fold(c, |cc: Checker, p: Param|
            match p.default {
              None -> cc,
              Some(d) -> match bare_names_read(d).find(|n: Bytes| constructors.contains(n)) {
                None -> cc,
                Some(constructor_name) -> reject_default_constructor(cc, x, constructor_name, d),
              },
            }),
        _ -> c,
      },
  )
}

fn reject_default_constructor(
  checker: Checker,
  x: InstanceInfo,
  constructor_name: Bytes,
  default: Expression,
) -> Checker / {abort.raise} = {
  let simple = simple_name_of(x.type_name);
  report_error_at_and(
    checker,
    b"E0480",
    expression_span(default),
    Bytes::concat_all([
      b"a parameter default cannot build `",
      simple,
      b"`, which states an invariant",
    ]),
    Bytes::concat_all([b"this names `", constructor_name, b"`"]),
    x.at,
    b"the invariant is stated here",
    [
      Bytes::concat_all([
        b"every call that omits the argument fills the default in, so the caller would build a `",
        simple,
        b"` without checking its invariant",
      ]),
      Bytes::concat_all([
        b"drop the default, and pass each call a `",
        simple,
        b"` that a function of its module returns",
      ]),
    ],
  )
}

fn not_a_sum(
  checker: Checker,
  target: Identifier,
  declaration: TypeDeclaration,
  message: Bytes,
  reason: Bytes,
) -> Checker =
  report_error_at_and(
    checker,
    b"E0217",
    target.span,
    message,
    b"this type has no constructor",
    { module: declaration.owner, span: declaration.span },
    b"declared here",
    [
      reason,
      Bytes::concat_all([
        b"declare a sum, as `type ",
        target.name,
        b" = | ",
        target.name,
        b"(..)`, whose constructor a value carries",
      ]),
    ],
  )

fn check_instance_signature(
  checker: Checker,
  definition: InstanceDefinition,
  type_name: Bytes,
  f: DefinitionInfo,
) -> Checker / {abort.raise} =
  match resolve(checker, f.scheme.ty) {
    FunctionType(sig) -> if sig.params.len() != 1 {
      report_unfit_instance(
        checker,
        definition,
        f,
        Bytes::concat_all([
          b"this function takes ",
          ascii_of_int(sig.params.len()),
          b" parameters",
        ]),
        b"it is called with the value alone",
      )
    } else if f.scheme.label_variables.len() > 0 {
      report_unfit_instance(
        checker,
        definition,
        f,
        b"this function has a resource label as a type parameter",
        b"it is called with the value alone, and a value does not record its type's resource label, so a type with a resource label parameter cannot declare `key`, `show` or `invariant`",
      )
    } else {
      match own_params(sig.params.get(0), type_name) {
        None ->
          report_unfit_instance(
            checker,
            definition,
            f,
            Bytes::concat_all([b"this function takes `", type_text(sig.params.get(0)), b"`"]),
            Bytes::concat_all([
              b"its parameter is `",
              definition.target.name,
              b"` at the type's own parameters, so it reads every `",
              definition.target.name,
              b"` there is",
            ]),
          ),
        Some(own) -> if constrained_beyond_type(checker, type_name, f, own) {
          report_unfit_instance(
            checker,
            definition,
            f,
            Bytes::concat_all([
              b"this function is constrained beyond what `",
              definition.target.name,
              b"` carries",
            ]),
            match definition.kind {
              InvariantInstance ->
                b"it is called with each value alone, so no caller can satisfy an extra constraint; the signature may require only what the type itself requires, the ordering a `Map` key needs from the types it contains, or a constraint in the type's `where` clause",
              _ ->
                b"it is called with only the values being compared or shown, so no caller can satisfy an extra constraint; the signature may require only what the type itself requires, the ordering a `Map` key needs from the types it contains, or a constraint in the type's `where` clause",
            },
          )
        } else if !is_pure(sig.effects) {
          report_unfit_instance(
            checker,
            definition,
            f,
            Bytes::concat_all([b"this function's effects are `", effects_text(sig.effects), b"`"]),
            match definition.kind {
              InvariantInstance ->
                b"an invariant is a fact about every value, so the function must have no effects, must not raise an error and must always return a value",
              _ ->
                b"`==`, `compare` and `show` have no effects, cannot raise an error and always return a value, so the function they call must do the same",
            },
          )
        } else if !result_over_own_params(
            free_variables(checker.substitution, sig.return_type, {
              types: [],
              effect_variables: [],
            }),
            own,
          ) {
          report_unfit_instance(
            checker,
            definition,
            f,
            Bytes::concat_all([b"this function returns `", type_text(sig.return_type), b"`"]),
            b"the return type may use only the type parameters of the type being declared, and no others",
          )
        } else if definition.kind == ShowInstance && sig.return_type != string_type {
          report_unfit_instance(
            checker,
            definition,
            f,
            Bytes::concat_all([b"this function returns `", type_text(sig.return_type), b"`"]),
            b"what is shown is text",
          )
        } else if definition.kind == InvariantInstance && sig.return_type != bool_type {
          report_unfit_instance(
            checker,
            definition,
            f,
            Bytes::concat_all([b"this function returns `", type_text(sig.return_type), b"`"]),
            b"an invariant returns `Bool`: whether a value is one the type may contain",
          )
        } else {
          {
            ..checker,
            instances: checker.instances.push({
              type_name: type_name,
              kind: definition.kind,
              by: f.name,
              params: own.params,
              effect_params: own.effect_params,
              results: sig.return_type,
              at: { module: checker.module, span: definition.span },
            }),
          }
        },
      }
    },
    _ -> checker,
  }

fn constrained_beyond_type(
  checker: Checker,
  type_name: Bytes,
  f: DefinitionInfo,
  own: OwnParams,
) -> Bool =
  if f.constraints.len() == 0 { false } else {
    let positions = match checker.ordered_parameters.get(type_name) { Some(ps) -> ps, None -> [] };
    let carried = positions.fold([], |accumulator: List<Int>, j: Int|
      match own.params.at(j) { Some(v) -> accumulator.push(v), None -> accumulator });
    let stated = match checker.stated.get(type_name) { Some(cs) -> cs, None -> [] };
    f.constraints.any(|c: DefinitionConstraint|
      match f.scheme.type_variables.at(c.param) {
        None -> true,
        Some(v) ->
          !(c.deriver == OrderingDeriver && carried.contains(v))
            && !stated.any(|s: DefinitionConstraint|
              s.deriver == c.deriver
                && (match own.params.at(s.param) { Some(w) -> w == v, None -> false })),
      })
  }

fn result_over_own_params(free: FreeVariables, own: OwnParams) -> Bool =
  free.types.fold(true, |all: Bool, v: Int| all && own.params.contains(v))
    && free.effect_variables.fold(true, |all: Bool, v: Int| all && own.effect_params.contains(v))

pub fn collect_instances(checker: Checker, parsed: ParsedModule) -> Checker =
  parsed.module.items.fold(checker, |c: Checker, item: Item|
    match item {
      InstanceItem(definition) -> match definition.kind {
        KeyInstance ->
          { ..c, keyed_names: c.keyed_names.push(qualify(parsed.name, definition.target.name)) },
        ShowInstance -> c,
        InvariantInstance -> c,
        HostInstance -> c,
        ReleaseInstance ->
          {
            ..c,
            release_functions: c.release_functions.insert(
              qualify(parsed.name, definition.target.name),
              qualify(parsed.name, definition.function.name),
            ),
          },
      },
      NumericItem(definition) -> {
        let type_name = qualify(parsed.name, definition.target.name);
        match numeric_of(c.numeric_types, type_name) {
          Some(_) -> c,
          None ->
            {
              ..c,
              numeric_types: c.numeric_types.push({
                type_name: type_name,
                constructor: c.constructors.fold(b"", |found: Bytes, k: ConstructorInfo|
                  if found.len() == 0 && k.type_name == type_name { k.name } else { found }),
                functions: numeric_operations.map(|operation: Bytes|
                  match numeric_by(definition, operation) {
                    Some(by) -> qualify(parsed.name, by.name),
                    None -> b"",
                  }),
                at: { module: c.module, span: definition.span },
              }),
            },
        }
      },
      _ -> c,
    })

fn check_numeric(
  checker: Checker,
  m: ParsedModule,
  definition: NumericDefinition,
) -> Checker / {abort.raise} = {
  let type_name = qualify(m.name, definition.target.name);
  let named = |text: Bytes| Bytes::concat_all([b"`", definition.target.name, text]);
  match checker.types.get(type_name) {
    None ->
      report_error_at(
        checker,
        b"E0208",
        definition.target.span,
        named(b"` is not a type this module declares"),
        b"declared in another module, or not at all",
        [
          b"a `numeric` may only name a type its own module declares, so that an operator means one thing wherever the type's values meet it",
        ],
      ),
    Some(declaration) -> match declaration.declared {
      DeclaredAlias(_) ->
        not_a_sum(
          checker,
          definition.target,
          declaration,
          named(b"` is not a sum, and a `numeric` must be a sum"),
          b"an alias is the type it names, so a `numeric` for an alias would apply to every value of the aliased type",
        ),
      DeclaredRecord(_) ->
        not_a_sum(
          checker,
          definition.target,
          declaration,
          named(b"` is a `new` record, which cannot state a `numeric` yet"),
          b"a `new` record has the same representation as the record it wraps, so a value does not show which type's arithmetic an operator should use",
        ),
      DeclaredExtern ->
        not_a_sum(
          checker,
          definition.target,
          declaration,
          named(b"` is an `extern type`, which states no `numeric`"),
          b"the toolchain lays out its values, and no operator reads one",
        ),
      DeclaredSum -> if declaration.params.len() + declaration.labels.len()
          + declaration.effect_params.len()
          > 0 {
        report_error_at_and(
          checker,
          b"E0216",
          definition.target.span,
          named(b"` takes parameters, and a `numeric` is for a type that takes none"),
          b"a type with parameters",
          { module: declaration.owner, span: declaration.span },
          b"declared here",
          [
            b"an operator calls the type's functions with only the values, and calls `numeric_of_int` with no type arguments, so the call cannot supply a type parameter or a constraint for the function",
          ],
        )
      } else {
        match numeric_of(checker.numeric_types, type_name) {
          Some(first) -> if first.at.span != definition.span {
            report_error_at_and(
              checker,
              b"E0105",
              definition.span,
              named(b"` states its `numeric` twice"),
              b"stated again here",
              first.at,
              b"first stated here",
              [b"a type has one, so that nothing has to choose between two; remove one"],
            )
          } else {
            let listed: Checker = check_numeric_operations(checker, definition);
            if listed.diagnostics.len() > checker.diagnostics.len() { listed } else {
              definition.operations.fold(listed, |c: Checker, x: NumericOperation|
                check_numeric_signature(c, m, definition, type_name, x))
            }
          },
          None -> checker,
        }
      },
    },
  }
}

fn check_numeric_operations(
  checker: Checker,
  definition: NumericDefinition,
) -> Checker / {abort.raise} = {
  let reason = b"a `numeric` names a function for each of `add`, `sub`, `mul`, `neg` and `of_int`, once: `+`, binary `-`, `*`, unary `-`, and what `numeric_of_int` calls";
  let named = range(0, definition.operations.len()).fold(checker, |c: Checker, i: Int| {
    let x = definition.operations.get(i);
    if !numeric_operations.contains(x.operation.name) {
      report_error_at(
        c,
        b"E0215",
        x.operation.span,
        Bytes::concat_all([b"`", x.operation.name, b"` is no operation a `numeric` states"]),
        b"a `numeric` names only `add`, `sub`, `mul`, `neg` and `of_int`",
        [reason],
      )
    } else if range(0, i).fold(false, |seen: Bool, j: Int|
        seen || definition.operations.get(j).operation.name == x.operation.name) {
      report_error_at(
        c,
        b"E0215",
        x.operation.span,
        Bytes::concat_all([b"this `numeric` names `", x.operation.name, b"` twice"]),
        b"named again here",
        [reason],
      )
    } else { c }
  });
  let missing = numeric_operations.filter(|operation: Bytes|
    numeric_by(definition, operation) == None);
  if missing.len() == 0 { named } else {
    report_error_at(
      named,
      b"E0215",
      definition.span,
      Bytes::concat_all([
        b"this `numeric` names no function for ",
        Bytes::join(missing.map(backticked_text), b", "),
      ]),
      b"an operation is missing",
      [reason],
    )
  }
}

fn check_numeric_signature(
  checker: Checker,
  m: ParsedModule,
  definition: NumericDefinition,
  type_name: Bytes,
  x: NumericOperation,
) -> Checker / {abort.raise} =
  match definition_of(checker, qualify(m.name, x.by.name)) {
    None ->
      report_error_at(
        checker,
        b"E0101",
        x.by.span,
        Bytes::concat_all([b"`", x.by.name, b"` is not a function this module declares"]),
        b"a `numeric` must name functions declared in the same module as its type",
        [],
      ),
    Some(f) -> {
      let own = named_type(type_name);
      let takes = if x.operation.name == b"of_int" { [int_type] }
      else if x.operation.name == b"neg" { [own] }
      else { [own, own] };
      let report_unfit_instance = |reason: Bytes, note: Bytes|
        report_error_with_labels(
          checker,
          b"E0218",
          Bytes::concat_all([
            b"`",
            x.by.name,
            b"` cannot be the `",
            x.operation.name,
            b"` of `",
            definition.target.name,
            b"`",
          ]),
          [
            label_at(checker.module, x.by.span, true, reason),
            label_at(f.at.module, f.at.span, false, b"the function it names"),
          ],
          [
            note,
            Bytes::concat_all([
              b"`",
              x.operation.name,
              b"` is `",
              type_text(
                FunctionType({
                  keep_parameters: [],
                  once: false,
                  params: takes,
                  return_type: own,
                  effects: no_effects,
                }),
              ),
              b"`",
            ]),
          ],
        );
      match resolve(checker, f.scheme.ty) {
        FunctionType(sig) -> if f.constraints.len() > 0 || f.scheme.type_variables.len() > 0
            || f.scheme.effect_variables.len() > 0
            || f.scheme.label_variables.len() > 0 {
          report_unfit_instance(
            b"this function declares a type, effects, a label or a constraint as a parameter of its own",
            b"an operator calls it with only the values, so the call cannot supply a type, effects, a label or a constraint",
          )
        } else if sig.params != takes || sig.return_type != own {
          report_unfit_instance(
            Bytes::concat_all([
              b"this function is `",
              type_text(resolve(checker, f.scheme.ty)),
              b"`",
            ]),
            b"an operator takes and returns values of the `numeric` type itself",
          )
        } else if !is_pure(sig.effects) {
          report_unfit_instance(
            Bytes::concat_all([b"this function's effects are `", effects_text(sig.effects), b"`"]),
            b"an operator on a number type performs no effects, cannot raise and always returns, as `+` does on `Int`, so `a + b` must not add effects",
          )
        } else { checker },
        _ -> checker,
      }
    },
  }

fn first_key_loop(
  types: List<Type>,
  instances: List<InstanceInfo>,
  adts: Shapes,
  path: List<Bytes>,
  room: Int,
) -> Option<List<Bytes>> / {abort.raise} =
  types.fold(None, |accumulator: Option<List<Bytes>>, ty: Type|
    match accumulator { Some(_) -> accumulator, None -> key_loop(ty, instances, adts, path, room) })

fn key_loop(
  ty: Type,
  instances: List<InstanceInfo>,
  adts: Shapes,
  path: List<Bytes>,
  room: Int,
) -> Option<List<Bytes>> / {abort.raise} =
  match ty {
    VariableType(_) -> None,
    FunctionType(_) -> None,
    RecordType(fs) -> first_key_loop(fs.map(|f: Field| f.ty), instances, adts, path, room),
    NominalType(n) -> first_key_loop(n.fields.map(|f: Field| f.ty), instances, adts, path, room),
    NamedType(c) -> match instance_of(instances, c.name, KeyInstance) {
      Some(x) -> if path.contains(c.name) { Some(path.push(c.name)) } else {
        if room <= 0 { None } else {
          key_loop(
            apply_arguments(x.results, x.params, x.effect_params, c.args),
            instances,
            adts,
            path.push(c.name),
            room - 1,
          )
        }
      },
      None -> match find_adt(adts, c.name) {
        None -> first_key_loop(c.args, instances, adts, path, room),
        Some(adt) -> if path.contains(c.name) { None } else {
          if room <= 0 { None } else {
            first_key_loop(
              adt.fields.map(|f: Type| apply_arguments(f, adt.params, adt.effect_params, c.args)),
              instances,
              adts,
              path.push(c.name),
              room - 1,
            )
          }
        },
      },
    },
  }

pub fn check_instances(checker: Checker) -> Checker / {abort.raise} = {
  let hosted = hosted_effects(checker);
  let collected: Checker = range(0, checker.modules.len()).fold(checker, |c: Checker, i: Int| {
    let m = c.modules.get(i);
    m.module.items.fold(c, |cc: Checker, item: Item|
      match item {
        InstanceItem(definition) -> if definition.kind == HostInstance {
          checked_host_handler({ ..cc, module: i }, m, definition, hosted)
        } else { check_instance({ ..cc, module: i }, m, definition) },
        NumericItem(definition) -> check_numeric({ ..cc, module: i }, m, definition),
        _ -> cc,
      })
  });
  let stated: Checker = collected.instances.fold(collected, |c: Checker, x: InstanceInfo|
    if x.kind == InvariantInstance { invariant_defaults(c, x) } else { c });
  if stated.instances.len() == 0 { { ..stated, module: checker.module } } else {
    let adts = algebraic_shapes(stated);
    let shapes = deriver_shapes(stated.instances, adts);
    let checked: Checker = stated.instances.fold(stated, |c: Checker, x: InstanceInfo|
      if !is_key(x.kind) { c } else {
        let simple = simple_name_of(x.type_name);
        match key_loop(x.results, stated.instances, adts, [x.type_name], adts.len() + 1) {
          Some(path) ->
            report(
              c,
              error_at(
                b"E0219",
                x.at.module,
                x.at.span,
                Bytes::concat_all([
                  b"`",
                  simple,
                  b"` is compared through a key that holds `",
                  simple,
                  b"`",
                ]),
                Bytes::concat_all([b"this key returns `", type_text(x.results), b"`"]),
                [
                  Bytes::concat_all([
                    b"comparing two values of this type would compare ",
                    Bytes::join(
                      path.map(|n: Bytes| backticked_text(simple_name_of(n))),
                      b", then ",
                    ),
                    b", and so never ends",
                  ]),
                  Bytes::concat_all([b"return a type that contains no `", simple, b"`"]),
                ],
              ),
            ),
          None ->
            [OrderingDeriver, HashDeriver].fold(c, |cc: Checker, deriver: Deriver|
              if cc.diagnostics.len() > c.diagnostics.len() { cc } else {
                match derivable(deriver, x.results, shapes_for(shapes, deriver), x.params) {
                  None -> cc,
                  Some(blocked) -> {
                    let blocker = type_text(blocked.ty);
                    report(
                      cc,
                      error_at(
                        b"E0206",
                        x.at.module,
                        x.at.span,
                        Bytes::concat_all([
                          b"`",
                          blocker,
                          b"` has no ",
                          deriver_description(deriver),
                          b", so it cannot be the key of `",
                          simple,
                          b"`",
                        ]),
                        Bytes::concat_all([b"this key returns `", type_text(x.results), b"`"]),
                        reason_notes_for_key(blocked.reason, deriver, blocked, blocker).push(
                          b"the key decides `==`, `compare`, `digest` and the order of a `Map`, so the type it returns must be ordered and hashable",
                        ),
                      ),
                    )
                  },
                }
              }),
        }
      });
    { ..checked, module: checker.module }
  }
}

pub fn blame_deriver_errors(checker: Checker) -> Checker / {abort.raise} = {
  let spans = range(0, checker.modules.len()).fold(
    [],
    |accumulator: List<LabelLocation>, i: Int|
      checker.modules.get(i).derived.fold(
        accumulator,
        |places: List<LabelLocation>, d: DeriveOrigin|
          places.push({ module: i, start: d.span.start, end: d.span.end }),
      ),
  );
  let derived_at = |d: Diagnostic|
    match d.labels.fold(None, |accumulator: Option<Label>, l: Label|
        match accumulator {
          Some(_) -> accumulator,
          None -> if l.primary { Some(l) } else { None },
        }) {
      Some(p) -> {
        let at = { module: p.module, start: p.start, end: p.end };
        if spans.contains(at) { Some(at) } else { None }
      },
      None -> None,
    };
  let unseen = checker.diagnostics.fold([], |accumulator: List<LabelLocation>, d: Diagnostic|
    if d.code != b"E0206" { accumulator }
    else { match derived_at(d) { Some(at) -> accumulator.push(at), None -> accumulator } });
  {
    ..checker,
    diagnostics: checker.diagnostics.fold([], |accumulator: List<Diagnostic>, d: Diagnostic|
      match derived_at(d) {
        None -> accumulator.push(d),
        Some(at) -> if d.code == b"E0206" { accumulator.push(d) }
        else if unseen.contains(at) { accumulator }
        else { accumulator.push(blamed_on_deriver(d)) },
      }),
  }
}

type LabelLocation = { module: Int, start: Int, end: Int }

fn blamed_on_deriver(d: Diagnostic) -> Diagnostic =
  {
    code: b"E0155",
    notes: d.notes + 2,
    labels: d.labels,
    text: d.text,
    message: b"a generated definition does not typecheck",
    notes_text: push_front_bytes(b"it fails with: ".concat(d.message), d.notes_text).push(
      b"a deriver writes definitions that check; this is a fault in the deriver's module",
    ),
    severity: d.severity,
    fixes: d.fixes,
  }

fn contains_function(t: Type) -> Bool =
  match t {
    FunctionType(_) -> !is_label_or_effects(t),
    NamedType(c) -> c.args.fold(false, |b: Bool, a: Type| b || contains_function(a)),
    RecordType(fs) -> fs.fold(false, |b: Bool, field: Field| b || contains_function(field.ty)),
    NominalType(n) ->
      n.fields.fold(false, |b: Bool, field: Field| b || contains_function(field.ty)),
    VariableType(_) -> false,
  }

fn push_front_bytes(x: Bytes, xs: List<Bytes>) -> List<Bytes> =
  xs.fold([x], |accumulator: List<Bytes>, y: Bytes| accumulator.push(y))

type NativeReach = { native_types: Map<Bytes, Bool>, uses: Map<Bytes, List<Int>> }

fn native_reach(shapes: Shapes) -> NativeReach / {abort.raise} = {
  let uses = shapes.fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Int>>, name: Bytes, shape: AlgebraicShape|
      accumulator.insert(
        name,
        range(0, shape.params.len()).filter(|i: Int|
          shape.fields.any(|f: Type| occurs_type(shape.params.get(i), f))),
      ),
  );
  let natives = shapes.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bool>, name: Bytes, shape: AlgebraicShape|
      if shape.native { accumulator.insert(name, true) } else { accumulator },
  );
  let native_types = iterate(natives, shapes.len() + 1, |found: Map<Bytes, Bool>| {
    let next = shapes.fold(
      found,
      |accumulator: Map<Bytes, Bool>, name: Bytes, shape: AlgebraicShape|
        if accumulator.contains(name) { accumulator }
        else if shape.fields.any(|f: Type|
            contains_native_type({ native_types: accumulator, uses: uses }, f)) {
          accumulator.insert(name, true)
        } else { accumulator },
    );
    if next.len() == found.len() { Stop(next) } else { Continue(next) }
  });
  { native_types: native_types, uses: uses }
}

fn contains_native_type(reach: NativeReach, ty: Type) -> Bool / {abort.raise} =
  match ty {
    NamedType(c) ->
      reach.native_types.contains(c.name)
        || (match reach.uses.get(c.name) {
          Some(at) ->
            at.any(|i: Int|
              match c.args.at(i) { Some(a) -> contains_native_type(reach, a), None -> false }),
          None -> c.args.any(|a: Type| contains_native_type(reach, a)),
        }),
    RecordType(fs) -> fs.any(|f: Field| contains_native_type(reach, f.ty)),
    NominalType(n) -> n.fields.any(|f: Field| contains_native_type(reach, f.ty)),
    FunctionType(_) -> false,
    VariableType(_) -> false,
  }

pub fn check_comparisons(checker: Checker) -> Checker / {abort.raise} = {
  let reach = native_reach(
    instance_shapes(checker.instances, algebraic_shapes(checker), EqDeriver),
  );
  checker.comparisons.fold(
    { ..checker, comparisons: [] },
    |c: Checker, site: { module: Int, span: Span, ty: Type }| {
      let resolved = resolve(c, site.ty);
      if contains_function(resolved) {
        report(
          c,
          error_at(
            b"E0201",
            site.module,
            site.span,
            b"functions cannot be compared for equality",
            Bytes::concat_all([b"both sides have type `", type_text(resolved), b"`"]),
            [b"compare the results of calling them instead"],
          ),
        )
      } else if contains_type_named(resolved, scoped_name) {
        report(
          c,
          error_at(
            b"E0201",
            site.module,
            site.span,
            b"a scoped value cannot be compared for equality",
            Bytes::concat_all([b"both sides have type `", type_text(resolved), b"`"]),
            [
              b"a scoped value refers to a value its scope will release, and is not the value itself: compare the results of `Scoped::get` on each instead",
            ],
          ),
        )
      } else if contains_native_type(reach, resolved) {
        report(
          c,
          error_at(
            b"E0201",
            site.module,
            site.span,
            b"a value of an `extern type` cannot be compared for equality",
            Bytes::concat_all([b"both sides have type `", type_text(resolved), b"`"]),
            [b"the toolchain lays out an `extern type`'s values, and nothing compares one"],
          ),
        )
      } else { c }
    },
  )
}

fn is_dummy(span: Span) -> Bool = span.start == 0 && span.end == 0

fn encloses(outer: Span, inner: Span) -> Bool =
  !is_dummy(outer) && !is_dummy(inner) && outer.start <= inner.start && inner.end <= outer.end

pub fn check_parallels(checker: Checker) -> Checker / {abort.raise} =
  checker.parallels.fold({ ..checker, parallels: [] }, |c: Checker, site: ParallelSite| {
    let rows = site.branches.map(|b: { span: Span, effects: Effects }|
      { span: b.span, effects: resolve_effects_in(c, b.effects) });
    match parallel_rejection(rows) {
      None -> c,
      Some(r) ->
        report_error_with_labels(
          c,
          b"E0309",
          r.message,
          r.labels.map(|l: { span: Span, primary: Bool, text: Bytes }|
            label_at(site.module, l.span, l.primary, l.text)),
          r.notes,
        ),
    }
  })

type Rejection = {
  message: Bytes,
  labels: List<{ span: Span, primary: Bool, text: Bytes }>,
  notes: List<Bytes>,
}

fn parallel_rejection(rows: List<Branch>) -> Option<Rejection> / {abort.raise} = {
  let seed = seed_effect;
  let performing = |pick: (Effect) -> Bool|
    rows.fold(None, |accumulator: Option<{ branch: Branch, entry: Effect }>, b: Branch|
      match accumulator {
        Some(_) -> accumulator,
        None -> match b.effects.listed.filter(pick) {
          [entry, ..] -> Some({ branch: b, entry: entry }),
          [] -> None,
        },
      });
  let one = |p: { branch: Branch, entry: Effect }, message: Bytes, reason: Bytes|
    Some({
      message: message,
      labels: [
        {
          span: p.branch.span,
          primary: true,
          text: b"this branch performs ".concat(backticked_text(effect_text(p.entry))),
        },
      ],
      notes: [reason],
    });
  match performing(|entry: Effect| entry == seed) {
    Some(p) ->
      one(
        p,
        b"a `parallel` branch may not start a `simulate` simulation",
        b"a simulation chooses its schedule from a seed, and the result depends on the order in which simulations start; branches running at the same time start in no fixed order",
      ),
    None -> match performing(|entry: Effect| entry.effect == b"task") {
      Some(p) ->
        one(
          p,
          b"a `parallel` branch may not spawn, join or yield a task",
          b"a task is scheduled by the thread that spawned it, and a branch may run on another; spawn the tasks outside the block",
        ),
      None -> {
        let n = rows.len();
        let found = range(0, n).fold(None, |accumulator: Option<Clash>, j: Int|
          range(0, j).fold(accumulator, |inner: Option<Clash>, i: Int|
            match inner { Some(_) -> inner, None -> clash(rows.get(i), rows.get(j)) }));
        match found {
          None -> None,
          Some(k) ->
            Some({
              message: b"two branches of this `parallel` block may touch one resource",
              labels: [
                {
                  span: k.later.span,
                  primary: true,
                  text: b"this branch performs ".concat(k.later_does),
                },
                {
                  span: k.earlier.span,
                  primary: false,
                  text: b"and this one performs ".concat(k.earlier_does),
                },
              ],
              notes: [
                b"branches run at the same time, so two branches may not use the same resource through the same effect if either branch performs a `write`",
                b"bind the branches with `let` in the order they must run, or move the shared resource out of the block",
              ],
            }),
        }
      },
    },
  }
}

type Branch = { span: Span, effects: Effects }

type Clash = { earlier: Branch, earlier_does: Bytes, later: Branch, later_does: Bytes }

fn may_alias(a: Resource, b: Resource) -> Bool =
  a == b || (match a { ResourceVariable(_) -> true, AnyResource -> true, _ -> false })
    || (match b { ResourceVariable(_) -> true, AnyResource -> true, _ -> false })

fn clash(x: Branch, y: Branch) -> Option<Clash> / {abort.raise} = {
  let effects = x.effects.listed.fold(None, |accumulator: Option<Clash>, a: Effect|
    y.effects.listed.fold(accumulator, |inner: Option<Clash>, b: Effect|
      match inner {
        Some(_) -> inner,
        None -> if effects_conflict({ ..a, resource: b.resource }, b)
            && may_alias(a.resource, b.resource) {
          Some({
            earlier: x,
            earlier_does: backticked_text(effect_text(a)),
            later: y,
            later_does: backticked_text(effect_text(b)),
          })
        } else { None },
      }));
  match effects {
    Some(_) -> effects,
    None -> {
      let open = |effects: Effects| effects.variable != None;
      let busy = |effects: Effects| effects.listed.len() > 0 || effects.variable != None;
      if (open(x.effects) && busy(y.effects)) || (open(y.effects) && busy(x.effects)) {
        Some({
          earlier: x,
          earlier_does: backticked_text(effects_text(x.effects)),
          later: y,
          later_does: backticked_text(effects_text(y.effects)),
        })
      } else { None }
    },
  }
}

pub fn check_simulations(checker: Checker) -> Checker / {abort.raise} = {
  let seed = seed_effect;
  let sites = checker.simulations;
  sites.fold({ ..checker, simulations: [] }, |c: Checker, site: Simulation| {
    let nested: Checker = if resolve_effects_in(c, site.body_effects).listed.contains(seed) {
      check_nested_simulation(c, site, sites)
    } else { c };
    check_entering(check_simulation_exits(nested, site), site)
  })
}

type SchedulerKeyText = { noun: Bytes, created_verb: Bytes, explanation: Bytes, suggestion: Bytes }

fn scheduler_key_text(ty: Type) -> SchedulerKeyText =
  if contains_type_named(ty, task_name) || !contains_type_named(ty, builtin_channel_name) {
    {
      noun: b"task",
      created_verb: b"spawned",
      explanation: b"a `Task` identifies a task in the scheduler that spawned it, and this simulation's scheduler numbers its own tasks, so the `Task` would identify a different task or none",
      suggestion: b"`join` the task inside the simulation and return its value instead",
    }
  } else {
    {
      noun: b"channel",
      created_verb: b"made",
      explanation: b"a `Chan` identifies a channel in the scheduler that made it, and this simulation's scheduler numbers its own channels, so the `Chan` would identify a different channel or none",
      suggestion: b"receive from the channel inside the simulation and return what it received instead",
    }
  }

fn contains_type_named(t: Type, name: Bytes) -> Bool =
  match t {
    NamedType(c) ->
      c.name == name || c.args.fold(false, |b: Bool, a: Type| b || contains_type_named(a, name)),
    RecordType(fs) -> fs.fold(false, |b: Bool, f: Field| b || contains_type_named(f.ty, name)),
    NominalType(n) ->
      n.fields.fold(false, |b: Bool, f: Field| b || contains_type_named(f.ty, name)),
    FunctionType(f) ->
      List::fold(
        if name == task_name { [b"join", b"await", b"cancel"] } else { channel_operations },
        f.params.fold(contains_type_named(f.return_type, name), |b: Bool, p: Type|
          b || contains_type_named(p, name)),
        |b: Bool, operation: Bytes| b || effects_cover(f.effects.listed, task_operation(operation)),
      ),
    VariableType(_) -> false,
  }

fn entered_message(ty: Type) -> Bytes = {
  let k = scheduler_key_text(ty);
  Bytes::concat_all([
    b"a ",
    k.noun,
    b" enters a simulation that did not ",
    creation_verb(k),
    b" it",
  ])
}

fn creation_verb(k: SchedulerKeyText) -> Bytes = if k.noun == b"task" { b"spawn" } else { b"make" }

fn own_scheduler_label(site: Simulation) -> Label =
  label_at(
    site.module,
    site.span,
    false,
    b"the simulation starts here, with a scheduler of its own",
  )

fn check_entering(checker: Checker, site: Simulation) -> Checker / {abort.raise} =
  site.entering.fold(checker, |c: Checker, x: { name: Bytes, span: Span, ty: Type }|
    report_error_with_labels(
      c,
      b"E0413",
      entered_message(x.ty),
      [
        label_at(
          site.module,
          x.span,
          true,
          Bytes::concat_all([
            b"`",
            x.name,
            b"` has type `",
            type_text(x.ty),
            b"`, and it was bound outside the simulation",
          ]),
        ),
        own_scheduler_label(site),
      ],
      [
        scheduler_key_text(x.ty).explanation,
        if scheduler_key_text(x.ty).noun == b"task" {
          b"spawn the task inside the simulation, or join it where it was spawned and pass in its result"
        } else { b"make the channel inside the simulation, or pass in what was received from it" },
      ],
    ))

fn check_simulation_exits(checker: Checker, site: Simulation) -> Checker / {abort.raise} = {
  let ty = resolve(checker, site.body_type);
  if !brand_in(ty, Tasks) { checker } else {
    let k = scheduler_key_text(ty);
    let key = if k.noun == b"task" {
      b"a `Task` identifies a task in the simulation's scheduler, and the scheduler ends with the simulation"
    } else {
      b"a `Chan` identifies a channel in the simulation's scheduler, and the scheduler ends with the simulation"
    };
    let fix = k.suggestion;
    report_error_with_labels(
      checker,
      b"E0413",
      Bytes::concat_all([b"a ", k.noun, b" escapes the simulation that ", k.created_verb, b" it"]),
      exit_labels(site.module, site.exits, site.body_span, ty),
      if carries_brand_in_effects(ty, Tasks) {
        [
          key,
          b"the closure's effects still include a `task` operation or `sim.read`, so calling the closure after the simulation ends would use a scheduler that no longer exists",
          fix,
        ]
      } else { [key, fix] },
    )
  }
}

fn exit_labels(
  module: Int,
  exits: List<Span>,
  body_span: Span,
  ty: Type,
) -> List<Label> / {abort.raise} = {
  let shown = type_text(ty);
  List::map(if exits.len() == 0 { [body_span] } else { exits }, |span: Span|
    label_at(module, span, true, Bytes::concat_all([b"this has type `", shown, b"`"])))
}

fn check_nested_simulation(checker: Checker, site: Simulation, sites: List<Simulation>) -> Checker = {
  let inner = sites.fold(None, |accumulator: Option<Simulation>, other: Simulation|
    match accumulator {
      Some(_) -> accumulator,
      None -> if other.module == site.module && other.span != site.span
          && encloses(site.body_span, other.span) { Some(other) }
      else { None },
    });
  let message = b"a simulation inside another simulation";
  let primary = label_at(
    site.module,
    site.span,
    true,
    b"this simulation's body performs `sim.read`, directly or through a function it calls",
  );
  let tail = [
    b"two schedulers would each decide which tasks are `runnable`, and a task in the inner simulation could block the outer simulation",
    b"move the inner simulation out of the outer simulation, or remove the inner simulation and let the outer simulation schedule the tasks",
  ];
  match inner {
    Some(o) ->
      report_error_with_labels(
        checker,
        b"E0416",
        message,
        [primary, label_at(o.module, o.span, false, b"the inner simulation is here")],
        tail,
      ),
    None ->
      report(
        checker,
        error_with_labels(
          b"E0416",
          message,
          [primary],
          push_front_bytes(
            b"something this body calls performs `sim.read`, so it starts a simulation too",
            tail,
          ),
        ),
      ),
  }
}

fn brand_in(t: Type, brand: ScopedValueKind) -> Bool / {abort.raise} =
  match t {
    VariableType(_) -> false,
    NamedType(c) ->
      (match brand {
          ScopedLabel(r) -> label_of(t) == Some(r),
          Tasks -> is_scheduler_handle(c.name),
        })
        || c.args.fold(false, |b: Bool, a: Type| b || brand_in(a, brand)),
    FunctionType(f) ->
      effects_include_brand(f.effects, brand)
        || f.params.fold(false, |b: Bool, p: Type| b || brand_in(p, brand))
        || brand_in(f.return_type, brand),
    RecordType(fs) -> fs.fold(false, |b: Bool, f: Field| b || brand_in(f.ty, brand)),
    NominalType(n) -> n.fields.fold(false, |b: Bool, f: Field| b || brand_in(f.ty, brand)),
  }

fn carries_brand_in_effects(t: Type, brand: ScopedValueKind) -> Bool =
  match t {
    VariableType(_) -> false,
    NamedType(c) -> c.args.fold(false, |b: Bool, a: Type| b || carries_brand_in_effects(a, brand)),
    FunctionType(f) ->
      effects_include_brand(f.effects, brand)
        || f.params.fold(false, |b: Bool, p: Type| b || carries_brand_in_effects(p, brand))
        || carries_brand_in_effects(f.return_type, brand),
    RecordType(fs) ->
      fs.fold(false, |b: Bool, f: Field| b || carries_brand_in_effects(f.ty, brand)),
    NominalType(n) ->
      n.fields.fold(false, |b: Bool, f: Field| b || carries_brand_in_effects(f.ty, brand)),
  }

pub fn check_scopes(checker: Checker) -> Checker / {abort.raise} =
  checker.scopes.fold({ ..checker, scopes: [] }, |c: Checker, site: ScopeSite|
    check_scope_handoffs(check_scope_spawns(check_scope_exits(c, site), site), site))

fn scope_brand(site: ScopeSite) -> ScopedValueKind = ScopedLabel(site.label)

fn check_scope_exits(checker: Checker, site: ScopeSite) -> Checker / {abort.raise} = {
  let ty = resolve(checker, site.body_type);
  let n = site.name;
  if !brand_in(ty, scope_brand(site)) { checker } else {
    report_error_with_labels(
      checker,
      b"E0446",
      Bytes::concat_all([b"a scoped value escapes its `with_scope[", n, b"]` scope"]),
      exit_labels(site.module, site.exits, site.body_span, ty),
      if carries_brand_in_effects(ty, scope_brand(site)) {
        [
          b"the closure's effects still include `scoped.read`, so calling the closure after the scope ends reads a value that no longer exists",
          b"call the closure inside the scope and return its result instead",
        ]
      } else {
        [
          Bytes::concat_all([
            b"the scope ends at its `}`, and the scoped value cannot be used after that",
          ]),
          b"use the value inside the scope and return a result computed from it instead",
        ]
      },
    )
  }
}

fn opens_here_text(n: Bytes) -> Bytes =
  Bytes::concat_all([b"`", n, b"` opens here and releases its value at its `}`"])

const outliving_task_notes: List<Bytes> =
  [
    b"the task is run by a scheduler that is installed outside the scope, so the task can still be running after the scope ends",
    b"a `join` inside the scope is not enough, because the types do not record that the task was joined, and a task that is never joined continues to run after the scope's `}`",
  ]

fn check_scope_spawns(checker: Checker, site: ScopeSite) -> Checker / {abort.raise} =
  site.spawns.fold(checker, |c: Checker, s: SpawnSite| {
    let ty = resolve(c, s.ty);
    if brand_in(ty, scope_brand(site)) {
      report_error_with_labels(
        c,
        b"E0446",
        Bytes::concat_all([b"a value of scope `", site.name, b"` is sent to another task"]),
        [
          label_at(
            site.module,
            s.span,
            true,
            Bytes::concat_all([b"this has type `", type_text(ty), b"`"]),
          ),
          label_at(site.module, site.span, false, opens_here_text(site.name)),
        ],
        outliving_task_notes.push(
          Bytes::concat_all([
            b"start the simulation inside `with_scope[",
            site.name,
            b"]`, or pass the task something that does not mention `",
            site.name,
            b"`",
          ]),
        ),
      )
    } else {
      match enclosing_branded_clause(c, ty, s.enclosing_clauses, scope_brand(site)) {
        None -> c,
        Some(enclosing_clause) -> {
          let operation = backticked_text(
            Bytes::concat_all([
              as_written({ ..c, module: site.module }, enclosing_clause.operation.effect),
              b".",
              match enclosing_clause.operation.operation {
                Some(o) -> o,
                None -> mode_text(enclosing_clause.operation.mode),
              },
            ]),
          );
          report_error_with_labels(
            c,
            b"E0446",
            Bytes::concat_all([
              b"a value of scope `",
              site.name,
              b"` is passed to another task by a handler that wraps the task's `task.spawn`",
            ]),
            [
              label_at(
                site.module,
                s.span,
                true,
                Bytes::concat_all([
                  b"this task performs ",
                  operation,
                  b", which a handler around the spawn handles",
                ]),
              ),
              label_at(
                site.module,
                enclosing_clause.span,
                false,
                Bytes::concat_all([
                  b"this clause handles the operation, and a value of scope `",
                  site.name,
                  b"` is passed to it",
                ]),
              ),
              label_at(site.module, site.span, false, opens_here_text(site.name)),
            ],
            [
              b"the handlers around the task's `task.spawn` handle the task's operations, so this clause runs each time the task performs the operation",
            ].concat(
              outliving_task_notes.push(
                Bytes::concat_all([
                  b"start the simulation inside `with_scope[",
                  site.name,
                  b"]`, or handle ",
                  operation,
                  b" without touching `",
                  site.name,
                  b"`",
                ]),
              ),
            ),
          )
        },
      }
    }
  })

fn enclosing_branded_clause(
  checker: Checker,
  task: Type,
  around: List<ClauseSite>,
  brand: ScopedValueKind,
) -> Option<ClauseSite> / {abort.raise} =
  around.fold(None, |accumulator: Option<ClauseSite>, clause: ClauseSite|
    match accumulator {
      Some(_) -> accumulator,
      None -> if may_perform(task, clause.operation)
          && brand_in(resolve(checker, clause.ty), brand) { Some(clause) }
      else { None },
    })

fn may_perform(task: Type, operation: Effect) -> Bool =
  match task {
    FunctionType(f) ->
      f.effects.variable != None
        || f.effects.listed.fold(false, |b: Bool, a: Effect|
          b
            || (a.effect == operation.effect
            && (a.operation == operation.operation
            || (a.operation == None && mode_eq(a.mode, operation.mode))))),
    _ -> true,
  }

fn check_scope_handoffs(checker: Checker, site: ScopeSite) -> Checker / {abort.raise} =
  site.handoffs.fold(checker, |c: Checker, h: HandoffSite| {
    let ty = resolve(c, h.ty);
    if !brand_in(ty, scope_brand(site)) { c } else {
      let n = site.name;
      let carries = if carries_brand_in_effects(ty, scope_brand(site)) {
        [
          b"the closure's effects still include `scoped.read`, so whoever handles the operation can read a value after its scope has ended",
        ]
      } else { [] };
      report_error_with_labels(
        c,
        b"E0446",
        Bytes::concat_all([b"a value of scope `", n, b"` is passed to `", h.operation, b"`"]),
        [
          label_at(
            site.module,
            h.span,
            true,
            Bytes::concat_all([b"this has type `", type_text(ty), b"`"]),
          ),
          label_at(site.module, site.span, false, opens_here_text(n)),
        ],
        carries.concat([
          Bytes::concat_all([
            b"`",
            h.operation,
            b"` is declared outside every scope, so its type cannot say the value belongs to `",
            n,
            b"`, and a handler can be installed anywhere and can outlive the scope, so the handler receives the value as a type variable that names no scope",
          ]),
          Bytes::concat_all([
            b"read the value inside the scope and perform the operation with a value that does not belong to `",
            n,
            b"`",
          ]),
        ]),
      )
    }
  })

pub const prelude_tables: { effects: List<EffectInfo>, constructors: List<ConstructorInfo> } = {
  let c = new_checker(
    {
      names: [],
      scopes: [],
      declarations: [],
      declared: [],
      order: [],
      imports: [],
      signatures: Map::new(),
      visible_modules: [],
    },
    [],
    empty_cache,
  );
  { effects: c.effects, constructors: c.constructors }
}

pub fn new_checker(
  resolved: Resolution,
  modules: List<ParsedModule>,
  known: CheckCache,
) -> Checker / {abort.raise} =
  install_prelude({
    resolved: resolved,
    modules: modules,
    module: 0,
    substitution: substitution_new,
    fresh: fresh_new,
    env: env_new,
    diagnostics: [],
    types: Map::new(),
    effects: [],
    effect_index: Map::new(),
    constructors: [],
    constructor_index: Map::new(),
    definitions: [],
    definition_index: Map::new(),
    tests: [],
    laws: [],
    type_params: Map::new(),
    effect_params: Map::new(),
    label_params: Map::new(),
    label_apps: [],
    group_definitions: [],
    own_functions: Map::new(),
    refs: [],
    calls: [],
    tag_uses: [],
    function_parameters: Map::new(),
    parameter_modes: Map::new(),
    auto_type_params: false,
    alias_stack: [],
    aliases: Map::new(),
    nominals: Map::new(),
    rejected_effects: [],
    performs: [],
    over: None,
    pending_iterations: [],
    repeated_variables: [],
    recursed: None,
    declared_effects: [],
    effects_written: false,
    guards: guards::no_guards,
    contracts: Map::new(),
    prelude_functions: Map::new(),
    typed_bodies: [],
    raise_notes: [],
    comparisons: [],
    scope: 0,
    constraints: Map::new(),
    numerics: [],
    bit_ops: [],
    witnessed: Map::new(),
    witness_orders: [],
    group_fills: [],
    summaries: Map::new(),
    concats: [],
    columns: [],
    updates: [],
    exit_types: Map::new(),
    release_sites: [],
    holes: [],
    unperformed: [],
    member_sites: match known.body_checking { ReuseBodies(_, sites) -> sites, _ -> [] },
    member_calls: [],
    copied_defaults: [],
    member_builtins: Map::new(),
    simulate_depth: 0,
    simulation_scope: 0,
    captured_locals: [],
    open_scopes: [],
    scopes: [],
    simulations: [],
    parallels: [],
    map_keys: [],
    constrained_uses: [],
    spec_kind: None,
    spec_envs: [],
    derived: None,
    known: known,
    seeded: [],
    cached_tests: [],
    current_definition: b"",
    binders: Map::new(),
    cached: [],
    keep_variables: [],
    bodies: [],
    assumed: [],
    instances: [],
    numeric_types: [],
    keyed_names: [],
    release_functions: Map::new(),
    resource_types: [],
    type_shapes: Map::new(),
    ordered_parameters: Map::new(),
    stated: Map::new(),
    alias_constraints: [],
    declaring_type: b"",
    copied: false,
    assignable: { variables: [], assignment_forbidden_in: None, frame: 0 },
  })
