pub type InstanceFunctions = { key: Option<Bytes>, show: Option<Bytes>, numeric: List<Bytes> }

pub type InstanceCalls = { seen: List<Bytes>, functions: List<Bytes> }

pub type Count = {
  repeated_effects: List<Effect>,
