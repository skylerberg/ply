}

pub type TypeFacts = {
  declaration: TypeDeclaration,
  constructors: List<ConstructorInfo>,
  alias: Option<AliasFacts>,
  record: Option<RecordDeclaration>,
  stated: Option<List<DefinitionConstraint>>,
  ordered_parameters: Option<List<Int>>,
  numeric: Option<NumericInfo>,
  instances: List<InstanceInfo>,
  keyed: Bool,
  release_function: Option<Bytes>,
  resource: Bool,
  shape: Option<AlgebraicShape>,
  compared: Option<AlgebraicShape>,
  shown: Option<AlgebraicShape>,
}

pub type StatedReturn = | StatedFresh | StatedParameter(Int)

pub type CallShape = {
  constant: Bool,
  witnesses: Int,
  arity: Int,
  borrowed: List<Int>,
  returned: Option<StatedReturn>,
}

fn stated_return(d: FnDefinition, witnesses: Int) -> Option<StatedReturn> =
  match d.returns {
    None -> None,
    Some(ReturnsFresh(_)) -> Some(StatedFresh),
    Some(ReturnsParam(x)) ->
      Some(
        StatedParameter(
          witnesses
            + range(0, d.params.len()).fold(0, |found: Int, k: Int|
              match d.params.at(k) {
                Some(p) -> if p.name.name == x.name { k } else { found },
                None -> found,
              }),
        ),
      ),
  }

pub fn call_shape(d: FnDefinition) -> CallShape = {
  let witnesses = d.constraints.fold([], |found: List<Bytes>, c: Constraint|
    if !is_predicate(c.deriver) || found.contains(c.param.name) { found }
    else { found.push(c.param.name) }).len(
  );
  {
    constant: d.constant != None,
    witnesses: witnesses,
    arity: witnesses + d.params.len() + d.generics.labels.len(),
    borrowed: range(0, d.params.len()).filter(|i: Int|
      match d.params.at(i) { Some(p) -> parameter_mode(p).borrowed, None -> false }).map(
      |i: Int| i + witnesses,
    ),
    returned: stated_return(d, witnesses),
  }
}

pub type Implementation =
  | ExternFunction
  | UncheckedBuiltin(CallShape)
  | Checked(DefinitionInfo, Option<CallShape>)

pub type DefinitionFacts = {
  scheme: Scheme,
  implementation: Implementation,
  pure: Bool,
  contract: Option<Contract>,
  constraints: Option<List<DefinitionConstraint>>,
  parameters: Option<List<Int>>,
  modes: Option<ParameterModes>,
  summary: Option<Summary>,
}

pub type StoredDeclarations = {
  types: Map<Bytes, TypeFacts>,
  effects: Map<Bytes, EffectInfo>,
  constructors: Map<Bytes, ConstructorInfo>,
  definitions: Map<Bytes, DefinitionFacts>,
  sets: Map<Bytes, EffectSetDefinition>,
  schemas: Map<Bytes, SchemaDefinition>,
  parameters: Map<Bytes, Parameters>,
}

pub const no_stored_declarations: StoredDeclarations =
  {
    types: Map::new(),
    effects: Map::new(),
    constructors: Map::new(),
    definitions: Map::new(),
    sets: Map::new(),
    schemas: Map::new(),
    parameters: Map::new(),
  }

fn located_elsewhere(at: Location) -> Location = { module: module_elsewhere, span: generated_span }

fn site_elsewhere(site: Site) -> Site = { ..site, span: generated_span }

fn definition_elsewhere(d: DefinitionInfo) -> DefinitionInfo =
  {
    ..d,
    at: located_elsewhere(d.at),
    raises: d.raises.map(|r: Raise| { ..r, span: generated_span }),
    spec: d.spec.map(|s: SpecInfo| { ..s, span: generated_span }),
    ending: match d.ending {
      Diverges(x) ->
        Diverges({
          at: site_elsewhere(x.at),
          reason: match x.reason {
            NoDescent(sites) -> NoDescent(sites.map(site_elsewhere)),
            other -> other,
          },
        }),
      other -> other,
    },
  }

fn type_elsewhere(d: TypeDeclaration) -> TypeDeclaration =
  {
    ..d,
    owner: module_elsewhere,
    span: generated_span,
    opaque: match d.opaque { Some(o) -> Some({ ..o, span: generated_span }), None -> None },
  }

fn constructor_elsewhere(c: ConstructorInfo) -> ConstructorInfo =
  { ..c, at: located_elsewhere(c.at) }

fn effect_elsewhere(e: EffectInfo) -> EffectInfo =
  {
    ..e,
    at: located_elsewhere(e.at),
    operations: e.operations.map(|o: OperationInfo| { ..o, at: located_elsewhere(o.at) }),
  }

pub fn declarations_checked(
  checker: Checker,
  parsed: ParsedModule,
  pure: List<Bytes>,
) -> StoredDeclarations = {
  let module = parsed.name;
  let shapes = parsed.module.items.fold(Map::new(), |found: Map<Bytes, CallShape>, item: Item|
    match item {
      FunctionItem(f) -> found.insert(qualify(module, f.name.name), call_shape(f)),
      _ -> found,
    });
  let own = |name: Bytes| name.starts_with(module.concat(b"."));
  let plain_shapes = algebraic_shapes(checker);
  let compared_shapes = instance_shapes(checker.instances, plain_shapes, EqDeriver);
  let shown_shapes = instance_shapes(checker.instances, plain_shapes, ShowDeriver);
  {
    types: checker.types.fold(
      Map::new(),
      |found: Map<Bytes, TypeFacts>, name: Bytes, d: TypeDeclaration|
        if !own(name) { found } else {
          found.insert(name, {
            declaration: type_elsewhere(d),
            constructors: checker.constructors.filter(|c: ConstructorInfo| c.type_name == name).map(
              constructor_elsewhere,
            ),
            alias: checker.aliases.get(name),
            record: checker.nominals.get(name),
            stated: checker.stated.get(name),
            ordered_parameters: checker.ordered_parameters.get(name),
            numeric: checker.numeric_types.find(|n: NumericInfo| n.type_name == name),
            instances: checker.instances.filter(|i: InstanceInfo| i.type_name == name).map(
              |i: InstanceInfo| { ..i, at: located_elsewhere(i.at) },
            ),
            keyed: checker.keyed_names.contains(name),
            release_function: checker.release_functions.get(name),
            resource: checker.resource_types.contains(name),
            shape: plain_shapes.get(name),
            compared: compared_shapes.get(name),
            shown: shown_shapes.get(name),
          })
        },
    ),
    effects: checker.effects.fold(Map::new(), |found: Map<Bytes, EffectInfo>, e: EffectInfo|
      if e.module == module { found.insert(e.name, effect_elsewhere(e)) } else { found }),
    constructors: checker.constructors.fold(
      Map::new(),
      |found: Map<Bytes, ConstructorInfo>, c: ConstructorInfo|
        if c.module == module { found.insert(c.name, constructor_elsewhere(c)) } else { found },
    ),
    definitions: checker.definitions.fold(
      parsed.module.items.fold(Map::new(), |found: Map<Bytes, DefinitionFacts>, item: Item|
        match item {
          ExternItem(e) -> {
            let name = qualify(module, e.name.name);
            match env_lookup(checker.env, name) {
              Some(scheme) ->
                found.insert(name, {
                  scheme: scheme,
                  implementation: ExternFunction,
                  pure: false,
                  contract: checker.contracts.get(name),
                  constraints: checker.constraints.get(name),
                  parameters: checker.function_parameters.get(name),
                  modes: checker.parameter_modes.get(name),
                  summary: checker.summaries.get(name),
                }),
              None -> found,
            }
          },
          FunctionItem(f) -> {
            let name = qualify(module, f.name.name);
            match env_lookup(checker.env, name) {
              Some(scheme) ->
                found.insert(name, {
                  scheme: scheme,
                  implementation: UncheckedBuiltin(call_shape(f)),
                  pure: pure.contains(name),
                  contract: checker.contracts.get(name),
                  constraints: checker.constraints.get(name),
                  parameters: checker.function_parameters.get(name),
                  modes: checker.parameter_modes.get(name),
                  summary: checker.summaries.get(name),
                }),
              None -> found,
            }
          },
          _ -> found,
        }),
      |found: Map<Bytes, DefinitionFacts>, d: DefinitionInfo|
        if d.module != module { found } else {
          found.insert(d.name, {
            scheme: d.scheme,
            implementation: Checked(definition_elsewhere(d), shapes.get(d.name)),
            pure: pure.contains(d.name),
            contract: checker.contracts.get(d.name),
            constraints: checker.constraints.get(d.name),
            parameters: checker.function_parameters.get(d.name),
            modes: checker.parameter_modes.get(d.name),
            summary: checker.summaries.get(d.name),
          })
        },
    ),
    sets: parsed.module.items.fold(
      Map::new(),
      |found: Map<Bytes, EffectSetDefinition>, item: Item|
        match item {
          EffectSetItem(d) -> found.insert(qualify(module, d.name.name), d),
          _ -> found,
        },
    ),
    schemas: parsed.module.items.fold(
      Map::new(),
      |found: Map<Bytes, SchemaDefinition>, item: Item|
        match item { SchemaItem(d) -> found.insert(qualify(module, d.name.name), d), _ -> found },
    ),
    parameters: checker.resolved.signatures.fold(
      Map::new(),
      |found: Map<Bytes, Parameters>, name: Bytes, p: Parameters|
        if own(name) { found.insert(name, p) } else { found },
    ),
  }
}

pub fn declarations_joined(a: StoredDeclarations, b: StoredDeclarations) -> StoredDeclarations =
  {
    types: a.types.merge(b.types),
    effects: a.effects.merge(b.effects),
    constructors: a.constructors.merge(b.constructors),
    definitions: a.definitions.merge(b.definitions),
    sets: a.sets.merge(b.sets),
    schemas: a.schemas.merge(b.schemas),
    parameters: a.parameters.merge(b.parameters),
  }

