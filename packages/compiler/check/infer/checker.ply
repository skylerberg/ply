pub const empty_cache: CheckCache = { types: Map::new(), body_plan: CheckEvery }

pub type Role = | Own | Dependency

pub type GroupModule = { parsed: ParsedModule, role: Role }

pub fn own_module(parsed: ParsedModule) -> GroupModule = { parsed: parsed, role: Own }

pub fn dependency_module(parsed: ParsedModule) -> GroupModule = { parsed: parsed, role: Dependency }

pub type BodyPlan =
  | CheckEvery
  | CheckOnly(List<Bytes>)
