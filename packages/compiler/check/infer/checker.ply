pub fn relocated_body(b: CheckedBody, module: Int, by: (Int) -> Int) -> CheckedBody = {
  let at = |s: Span| mapped_span(s, by);
  let over = |o: Option<Span>| match o { Some(s) -> Some(at(s)), None -> None };
  let waits = |ms: List<PendingIteration>| ms.map(|m: PendingIteration| { ..m, span: at(m.span) });
  let call = |c: OwnCall| { ..c, span: at(c.span) };
  {
    ..b,
    performs: b.performs.map(|s: PerformSite|
      {
        ..s,
        module: module,
        span: at(s.span),
        iteration_span: over(s.iteration_span),
        pending_iterations: waits(s.pending_iterations),
      }),
    repeated: b.repeated.map(|r: RepeatedEffects|
      {
        ..r,
        iteration_span: over(r.iteration_span),
        pending_iterations: waits(r.pending_iterations),
      }),
    raise_notes: b.raise_notes.map(|n: RaiseNote| { ..n, span: at(n.span) }),
    calls: b.calls.map(call),
    stated: b.stated.map(call),
    tags: b.tags.map(|t: TagRejection|
      {
        ..t,
        rejection: {
          ..t.rejection,
          labels: t.rejection.labels.map(|l: Label|
            { ..l, place: mapped_place(l.place, module, by) }),
        },
      }),
    instantiations: b.instantiations.map(|f: Instantiation|
      { ..f, module: module, span: at(f.span) }),
  }
}

