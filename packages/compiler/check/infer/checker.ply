pub type BodyFacts = { members: List<MemberSite>, types: TypeTable, bodies: List<TypedBody<Bytes>> }

derive bin for BodyFacts

pub const no_body_facts: BodyFacts = { members: [], types: Map::new(), bodies: [] }

pub opaque type RecordedFacts = | RecordedFacts(Bytes)

derive bin for RecordedFacts

type FactsHead = { value: Option<ConstantData> }

derive bin for FactsHead

fn with_owner(facts: BodyFacts, module: Int, owner: Bytes) -> BodyFacts =
  {
    members: facts.members.map(|x: MemberSite| { ..x, module: module, owner: owner }),
    types: facts.types,
    bodies: facts.bodies.map(|x: TypedBody<Bytes>| { ..x, module: module, owner: owner }),
  }

pub fn whole_body_data(facts: BodyFacts) -> Option<ConstantData> / {abort.raise} =
  match facts.bodies.find(|b: TypedBody<Bytes>| b.part == WholeBody) {
    Some(b) -> data_of(b.body, facts.types),
    None -> None,
  }

pub fn encode_facts(facts: BodyFacts) -> RecordedFacts / {abort.raise} =
  RecordedFacts(
    bin::encode({ value: whole_body_data(facts) }, facts_head_bin()).concat(
      bin::encode(with_owner({ ..facts, types: Map::new() }, 0, b""), body_facts_bin()),
    ),
  )

fn facts_head(recorded: Bytes) -> bin::Taken<FactsHead> / {abort.raise} =
  match facts_head_bin().take(recorded, 0) {
    Ok(t) -> t,
    Err(_) -> panic("recorded facts whose head does not decode"),
  }

pub fn recorded_data(recorded: RecordedFacts) -> Option<ConstantData> / {abort.raise} =
  match recorded { RecordedFacts(b) -> facts_head(b).value.value }

pub fn decode_facts(
  recorded: RecordedFacts,
  module: Int,
  owner: Bytes,
) -> BodyFacts / {abort.raise} =
  match recorded {
    RecordedFacts(b) -> {
      let head = facts_head(b);
      match bin::decode(b.slice(head.at, b.len()), body_facts_bin()) {
        Ok(f) -> with_owner(f, module, owner),
        Err(_) -> panic("recorded facts whose bodies do not decode"),
      }
    },
  }

pub type BodyRecord = | RecordedHere(RecordedFacts) | CheckedElsewhere

derive bin for BodyRecord

pub type CachedFacts = { name: Bytes, facts: BodyRecord }

