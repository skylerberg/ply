pub effect set CheckReads = {elsewhere.read, other_modules.read, mode_facts.read, termination_facts.read}

pub effect elsewhere {
  read look_up_type(name: Bytes) -> Option<TypeFacts>
  read look_up_effect(name: Bytes) -> Option<EffectInfo>
  read look_up_constructor(name: Bytes) -> Option<ConstructorInfo>
  read look_up_definition(name: Bytes) -> Option<DefinitionFacts>
}

pub fn with_no_other_definitions<a | e>(
  body: () -> a / {other_modules.read, elsewhere.read, mode_facts.read, termination_facts.read | e},
) -> a / e =
  handle {
    with_no_other_modules(body)
  } with {
    elsewhere.look_up_type(name) -> None,
    elsewhere.look_up_effect(name) -> None,
    elsewhere.look_up_constructor(name) -> None,
    elsewhere.look_up_definition(name) -> None,
    mode_facts.look_up_modes(name) -> None,
    termination_facts.look_up_summary(name) -> None,
    termination_facts.look_up_ending(name) -> None,
  }

