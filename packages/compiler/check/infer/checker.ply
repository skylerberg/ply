pub type Location = { module: Int, span: Span }

pub type Declaration =
  | DeclaredAlias(TypeExpression)
  | DeclaredRecord(TypeExpression)
  | DeclaredSum
  | DeclaredExtern

pub type TypeDeclaration = {
  params: List<Bytes>,
  labels: List<Bytes>,
  effect_params: List<Bytes>,
  constraints: List<DefinitionConstraint>,
  declared: Declaration,
  opaque: Option<Opaque>,
  owner: Int,
  span: Span,
}

pub type RecordDeclaration = { ty: Type, type_variables: List<Int>, effect_variables: List<Int> }

pub type OperationInfo = {
  name: Bytes,
  mode: Mode,
  resource_param: Bool,
  params: List<Type>,
  keep_indices: List<Int>,
  return_type: Type,
  at: Location,
  scheme: Option<Scheme>,
}

pub type EffectInfo = {
  name: Bytes,
  module: Bytes,
  simple_name: Bytes,
  nondet: Bool,
  operations: List<OperationInfo>,
  at: Location,
}

pub type ConstructorInfo = {
  name: Bytes,
  module: Bytes,
  simple_name: Bytes,
  type_name: Bytes,
  index: Int,
  arity: Int,
  fields: List<Type>,
  scheme: Scheme,
  at: Location,
}

pub type DefinitionConstraint = { deriver: Deriver, param: Int }

pub type AliasConstraint = { type_name: Bytes, from: Bytes, deriver: Deriver, ty: Type }

pub fn witness_params(constraints: List<DefinitionConstraint>) -> List<Int> =
  constraints.fold([], |accumulator: List<Int>, c: DefinitionConstraint|
    if !is_predicate(c.deriver) || accumulator.contains(c.param) { accumulator }
    else { accumulator.push(c.param) })

pub type InstanceInfo = {
  type_name: Bytes,
  kind: InstanceKind,
  by: Bytes,
  params: List<Int>,
  effect_params: List<Int>,
  results: Type,
  at: Location,
}

pub type NumericInfo = {
  type_name: Bytes,
  constructor: Bytes,
  functions: List<Bytes>,
  at: Location,
}

pub type SpecInfo = { kind: SpecKind, index: Int, effects: List<Effect>, span: Span }

pub type DefinitionInfo = {
  name: Bytes,
  module: Bytes,
  simple_name: Bytes,
  scheme: Scheme,
  effects: List<Effect>,
  performed: List<Effect>,
  scaling: List<Effect>,
  repeats: List<Int>,
  promised_bounded: List<Effect>,
  variable_bounded: Bool,
  ending: Termination,
  summary: Summary,
  raises: List<Raise>,
  effect_aliases: List<Bytes>,
  constraints: List<DefinitionConstraint>,
  spec: List<SpecInfo>,
  at: Location,
}

pub type RaiseReason =
  | RequirementNotShown({ callee: Bytes, needs: Bytes })
  | UnguardedBuiltin(Bytes)
  | RaisingCall(Bytes)
  | ZeroDivisor
  | RefutableLet
  | RaisingOperation
  | RaisingFunctionValue

pub type Raise = { span: Span, reason: RaiseReason }

derive bin for RaiseReason

derive bin for Raise

pub type RaiseNote = { span: Span, reason: RaiseReason }

pub type TestInfo = {
  name: Bytes,
  module: Bytes,
  key: Bytes,
  index: Int,
  nondet: Bool,
  cases: Bool,
  effects: List<Effect>,
  at: Location,
}

pub type LawBinder = { name: Bytes, ty: Type, span: Span }

pub type LawInfo = {
  name: Bytes,
  module: Bytes,
  key: Bytes,
  index: Int,
  binders: List<LawBinder>,
  identities: List<Int>,
  has_guard: Bool,
  effects: List<Effect>,
