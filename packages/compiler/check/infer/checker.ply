pub fn listing_type() -> Type / {abort.raise} =
  list_type(
    RecordType(
      fields_sorted([
        { name: b"identity", ty: bytes_type() },
        { name: b"label", ty: string_type() },
      ]),
    ),
  )

pub type CheckCache = {
