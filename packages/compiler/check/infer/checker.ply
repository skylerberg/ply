pub type Generalization = { env: TypeEnv, scheme: Scheme }

pub fn scoped_effect() -> Bytes = b"scoped"

pub fn scoped_read(resource: Resource) -> Effect =
  { effect: scoped_effect(), resource: resource, mode: ReadMode, operation: None }

pub fn is_scoped_effect(name: Bytes) -> Bool = name == scoped_effect()

pub fn compare_values_name() -> Bytes = b"compare_values"

pub fn location_of(checker: Checker, span: Span) -> Location =
  { module: checker.module, span: span }

pub fn module_name(checker: Checker, i: Int) -> Bytes / {abort.raise} = checker.modules.get(i).name

pub fn scope_of(checker: Checker) -> Scope / {abort.raise} =
  checker.resolved.scopes.get(checker.module)

pub fn report(checker: Checker, diagnostic: Diagnostic) -> Checker =
  { ..checker, diagnostics: checker.diagnostics.push(diagnostic) }

pub fn report_error_at(
  checker: Checker,
  code: Bytes,
  span: Span,
  message: Bytes,
  label: Bytes,
  notes: List<Bytes>,
) -> Checker = report(checker, error_at(code, checker.module, span, message, label, notes))

pub fn report_error_at_and(
  checker: Checker,
  code: Bytes,
  span: Span,
  message: Bytes,
  label: Bytes,
  also: Location,
  also_text: Bytes,
  notes: List<Bytes>,
) -> Checker =
  report(
    checker,
    error_at_and(
      code,
      checker.module,
      span,
      message,
      label,
      also.module,
      also.span,
      also_text,
      notes,
    ),
  )

pub fn report_error_with_labels(
  checker: Checker,
  code: Bytes,
  message: Bytes,
  labels: List<Label>,
  notes: List<Bytes>,
) -> Checker = report(checker, error_with_labels(code, message, labels, notes))

pub fn plural(n: Int) -> Bytes = if n == 1 { b"" } else { b"s" }

pub fn supplied(n: Int) -> Bytes =
  if n == 1 { b"1 was supplied" } else { ascii_of_int(n).concat(b" were supplied") }

pub fn deriver_description(deriver: Deriver) -> Bytes =
  match deriver {
    EqDeriver -> b"structural equality",
    OrderingDeriver -> b"order",
    ShowDeriver -> b"rendering",
    HashDeriver -> b"content hash",
    NumericDeriver -> b"arithmetic",
    IntegerDeriver -> b"integer arithmetic",
    ConstantDeriver -> b"constant value for the whole process",
  }

pub fn effect_aliases(definition: FnDefinition) -> List<Bytes> =
  match definition.effects {
    Some(r) -> r.aliases.map(|qualified_name: QName| qualified_name.name.name),
    None -> [],
  }

pub fn new_type(checker: Checker) -> { checker: Checker, ty: Type } = {
  let o = fresh_type(checker.fresh);
  { checker: { ..checker, fresh: o.fresh }, ty: o.ty }
}

pub fn new_type_variable(checker: Checker) -> { checker: Checker, var: Int } = {
  let o = fresh_type_variable(checker.fresh);
  { checker: { ..checker, fresh: o.fresh }, var: o.var }
}

pub fn new_effects(checker: Checker) -> { checker: Checker, effects: Effects } = {
  let o = fresh_effects(checker.fresh);
  { checker: { ..checker, fresh: o.fresh }, effects: o.effects }
}

pub fn new_effect_variable(checker: Checker) -> { checker: Checker, var: Int } = {
  let o = fresh_effect_variable(checker.fresh);
  { checker: { ..checker, fresh: o.fresh }, var: o.var }
}

pub fn resolve(checker: Checker, ty: Type) -> Type / {abort.raise} =
  resolve_type(checker.substitution, ty)

pub fn resolve_effects_in(checker: Checker, effects: Effects) -> Effects / {abort.raise} =
  resolve_effects(checker.substitution, effects)

pub fn with_unified(checker: Checker, unified: UnifyResult) -> Checker =
  { ..checker, substitution: unified.substitution, fresh: unified.fresh }

fn prelude_effect_names() -> List<Bytes> =
  [b"task", b"clock", b"random", b"sim", b"abort", b"diverges"]

pub fn is_prelude_effect(name: Bytes) -> Bool = prelude_effect_names().contains(name)

pub fn simulated_effect_names() -> List<Bytes> = [b"task", b"clock", b"random"]

pub fn seed_effect() -> Effect =
  { effect: b"sim", resource: SingletonResource, mode: ReadMode, operation: None }

pub fn abort_effect() -> Effect =
  { effect: b"abort", resource: SingletonResource, mode: RaiseMode, operation: Some(b"raise") }

fn abort_effects() -> Effects = single_effect(abort_effect())

fn builtin_type_arity_map() -> Map<Bytes, Int> =
  builtin_types().fold(Map::new(), |accumulator: Map<Bytes, Int>, x: { name: Bytes, arity: Int }|
    if accumulator.contains(x.name) { accumulator } else { accumulator.insert(x.name, x.arity) })

pub fn builtin_type_arity(name: Bytes) -> Option<Int> = builtin_type_arity_map().get(name)

fn index_of_bytes(xs: List<Bytes>, v: Bytes) -> Int / {abort.raise} =
  range(0, xs.len()).fold(0 - 1, |accumulator: Int, i: Int|
    if accumulator >= 0 { accumulator } else if xs.get(i) == v { i } else { accumulator })

fn install_prelude_adts(checker: Checker) -> Checker / {abort.raise} =
  builtin_sums().fold(checker, |c: Checker, adt: BuiltinSum| {
    let type_variables = range(0, adt.params.len());
    let result = NamedType({ name: adt.name, args: type_variables.map(|v: Int| VariableType(v)) });
    range(0, adt.variants.len()).fold(c, |c2: Checker, index: Int| {
      let v = adt.variants.get(index);
      let fields = v.fields.map(|p: Bytes| {
        let at = index_of_bytes(adt.params, p);
        if at >= 0 { VariableType(at) } else { named_type(p) }
      });
      let ty = if fields.len() == 0 { result } else { function_type(fields, result, no_effects()) };
      let scheme = {
        type_variables: type_variables,
        effect_variables: [],
        keep_variables: [],
        label_variables: [],
        ty: ty,
      };
      add_constructor({ ..c2, env: env_bind_global(c2.env, v.name, scheme) }, {
        name: v.name,
        module: b"",
        simple_name: v.name,
        type_name: adt.name,
        index: index,
        arity: fields.len(),
        fields: fields,
        scheme: scheme,
        at: { module: 0, span: dummy_span() },
      })
    })
  })

pub fn add_constructor(checker: Checker, info: ConstructorInfo) -> Checker =
  {
    ..checker,
    constructors: checker.constructors.push(info),
    constructor_index: checker.constructor_index.insert(info.name, checker.constructors.len()),
  }

pub fn constructor_of(checker: Checker, name: Bytes) -> Option<ConstructorInfo> =
  match checker.constructor_index.get(name) { Some(i) -> checker.constructors.at(i), None -> None }

pub fn add_effect(checker: Checker, info: EffectInfo) -> Checker =
  {
    ..checker,
    effects: checker.effects.push(info),
    effect_index: checker.effect_index.insert(info.name, checker.effects.len()),
  }

pub fn effect_of(checker: Checker, name: Bytes) -> Option<EffectInfo> / {abort.raise} =
  match checker.effect_index.get(name) { Some(i) -> Some(checker.effects.get(i)), None -> None }

pub fn definition_of(checker: Checker, name: Bytes) -> Option<DefinitionInfo> =
  match checker.definition_index.get(name) { Some(i) -> checker.definitions.at(i), None -> None }

pub fn set_definition(checker: Checker, info: DefinitionInfo) -> Checker / {abort.raise} =
  match checker.definition_index.get(info.name) {
    Some(i) -> { ..checker, definitions: checker.definitions.set(i, info) },
    None ->
      {
        ..checker,
        definitions: checker.definitions.push(info),
        definition_index: checker.definition_index.insert(info.name, checker.definitions.len()),
      },
  }

fn prelude_operation(
  name: Bytes,
  mode: Mode,
  type_variables: List<Int>,
  effect_variables: List<Int>,
  params: List<Type>,
  return_type: Type,
  effects: Effects,
) -> OperationInfo =
  {
    name: name,
    mode: mode,
    resource_param: false,
    params: params,
    keep_indices: [],
    return_type: return_type,
    at: { module: 0, span: dummy_span() },
    scheme: Some({
      type_variables: type_variables,
      effect_variables: effect_variables,
      keep_variables: [],
      label_variables: [],
      ty: function_type(params, return_type, effects),
    }),
  }

fn pair_type(first: Type, second: Type) -> Type =
  RecordType([{ name: b"_0", ty: first }, { name: b"_1", ty: second }])

pub fn channel_operations() -> List<Bytes> = [b"send", b"recv", b"close", b"select"]

pub fn prelude_effects() -> List<EffectInfo> = {
  let ta = VariableType(0);
  let body = function_type([], ta, open_effects(0));
  let task = task_type(ta);
  let chan = chan_type(ta);
  let none = { module: 0, span: dummy_span() };
  [
    {
      name: b"task",
      module: b"",
      simple_name: b"task",
      nondet: true,
      at: none,
      operations: [
        prelude_operation(b"spawn", WriteMode, [0], [0], [body], task, open_effects(0)),
        prelude_operation(b"join", WriteMode, [0], [], [task], ta, abort_effects()),
        prelude_operation(b"yield", WriteMode, [], [], [], unit_type(), no_effects()),
        prelude_operation(b"cancel", WriteMode, [0], [], [task], bool_type(), no_effects()),
        prelude_operation(b"await", WriteMode, [0], [], [task], option_type(ta), no_effects()),
        prelude_operation(b"channel", WriteMode, [0], [], [int_type()], chan, no_effects()),
        prelude_operation(b"send", WriteMode, [0], [], [chan, ta], bool_type(), no_effects()),
        prelude_operation(b"recv", WriteMode, [0], [], [chan], option_type(ta), no_effects()),
        prelude_operation(b"close", WriteMode, [0], [], [chan], unit_type(), no_effects()),
        prelude_operation(
          b"select",
          WriteMode,
          [0],
          [],
          [list_type(pair_type(chan, option_type(ta))), bool_type()],
          option_type(pair_type(int_type(), option_type(ta))),
          no_effects(),
        ),
      ],
    },
    {
      name: b"clock",
      module: b"",
      simple_name: b"clock",
      nondet: true,
      at: none,
      operations: [
        prelude_operation(b"now", ReadMode, [], [], [], instant_type(), no_effects()),
        prelude_operation(
          b"sleep",
          WriteMode,
          [],
          [],
          [duration_type()],
          unit_type(),
          no_effects(),
        ),
      ],
    },
    {
      name: b"random",
      module: b"",
      simple_name: b"random",
      nondet: true,
      at: none,
      operations: [
        prelude_operation(b"next", WriteMode, [], [], [], int_type(), no_effects()),
        prelude_operation(b"below", WriteMode, [], [], [int_type()], int_type(), no_effects()),
      ],
    },
    {
      name: b"sim",
      module: b"",
      simple_name: b"sim",
      nondet: false,
      at: none,
      operations: [prelude_operation(b"seed", ReadMode, [], [], [], int_type(), no_effects())],
    },
    {
      name: b"abort",
      module: b"",
      simple_name: b"abort",
      nondet: false,
      at: none,
      operations: [
        prelude_operation(b"raise", RaiseMode, [0], [], [string_type()], ta, no_effects()),
      ],
    },
    {
      name: b"diverges",
      module: b"",
      simple_name: b"diverges",
      nondet: false,
      at: none,
      operations: [],
    },
  ]
}

pub fn simulated_effects() -> List<Effect> / {abort.raise} =
  prelude_effects().fold([], |accumulator: List<Effect>, effect_info: EffectInfo|
    if simulated_effect_names().contains(effect_info.name) {
      effect_info.operations.fold(accumulator, |effects: List<Effect>, op_info: OperationInfo|
        effects_insert(effects, {
          effect: effect_info.name,
          resource: SingletonResource,
          mode: op_info.mode,
          operation: None,
        }))
    } else { accumulator })

pub fn simulated_operations() -> List<Bytes> =
  prelude_effects().fold([], |accumulator: List<Bytes>, effect_info: EffectInfo|
    if !simulated_effect_names().contains(effect_info.name) { accumulator } else {
      effect_info.operations.fold(accumulator, |operations: List<Bytes>, op_info: OperationInfo|
        operations.push(Bytes::concat_all([effect_info.name, b".", op_info.name])))
    })

pub type Builtin = {
  name: Bytes,
  scheme: Scheme,
  params: List<ParameterMode>,
  doc: List<Bytes>,
  constraints: List<DefinitionConstraint>,
  clauses: List<Bytes>,
  contract: Contract,
  body: Bool,
}

type DeclarationScope = {
  fresh: Fresh,
  types: Map<Bytes, Type>,
  labels: Map<Bytes, Type>,
  effect_variables: Map<Bytes, Int>,
  imported: Map<Bytes, Bytes>,
  aliases: Map<Bytes, TypeExpression>,
}

fn misdeclared(what: Bytes, name: Bytes) -> String =
  "the prelude " ++ String::of_bytes_lossy(what) ++ ": `" ++ String::of_bytes_lossy(name) ++ "`"

fn declared_types(
  d: DeclarationScope,
  types: List<TypeExpression>,
  room: Int,
) -> { d: DeclarationScope, types: List<Type> } / {abort.raise} =
  types.fold(
    { d: d, types: [] },
    |accumulator: { d: DeclarationScope, types: List<Type> }, ty: TypeExpression| {
      let o = declared_type(accumulator.d, ty, room);
      { d: o.d, types: accumulator.types.push(o.ty) }
    },
  )

fn declared_type(
  d: DeclarationScope,
  ty: TypeExpression,
  room: Int,
) -> { d: DeclarationScope, ty: Type } / {abort.raise} =
  match ty {
    VariableTypeExpression(id) -> match d.types.get(id.name) {
      Some(t) -> { d: d, ty: t },
      None -> panic(misdeclared(b"names a type variable no generic list binds", id.name)),
    },
    UnitTypeExpression(_) -> { d: d, ty: unit_type() },
    InvalidTypeExpression(_) -> panic("the prelude does not parse"),
    RecordTypeExpression(r) -> {
      let fs = r.fields.fold(
        { d: d, fs: [] },
        |accumulator: { d: DeclarationScope, fs: List<Field> }, f: { name: Identifier, ty: TypeExpression }| {
          let o = declared_type(accumulator.d, f.ty, room);
          { d: o.d, fs: accumulator.fs.push({ name: f.name.name, ty: o.ty }) }
        },
      );
      { d: fs.d, ty: RecordType(fields_sorted(fs.fs)) }
    },
    FunctionTypeExpression(f) -> {
      let ps = declared_types(d, f.params, room);
      let r = declared_type(ps.d, f.return_type, room);
      {
        d: r.d,
        ty: owning_function_type(
          ps.types,
          f.keep_indices,
          f.once,
          r.ty,
          declared_effects(r.d, f.effects),
        ),
      }
    },
    NamedTypeExpression(c) -> {
      let name = c.name.name.name;
      match d.types.get(name) {
        Some(t) -> { d: d, ty: t },
        None -> match if c.args.len() == 0 { d.aliases.get(name) } else { None } {
          Some(body) -> if room <= 0 {
            panic("alias expansion did not end, so an alias refers to itself")
          } else {
            let o = declared_type({ ..d, aliases: d.aliases.remove(name) }, body, room - 1);
            { d: { ..o.d, aliases: d.aliases }, ty: o.ty }
          },
          None -> match d.imported.get(name) {
            Some(full) -> {
              let args = declared_types(d, c.args, room);
              { d: args.d, ty: NamedType({ name: full, args: args.types }) }
            },
            None -> {
              let args = declared_types(d, c.args, room);
              if builtin_type_arity(name) != Some(args.types.len()) {
                panic(
                  misdeclared(
                    b"names a built-in type that does not exist with this number of type arguments",
                    name,
                  ),
                )
              } else if name == scoped_name() {
                match c.labels {
                  [l] -> match args.d.labels.get(l.name) {
                    Some(label) -> { d: args.d, ty: scoped_type(label, args.types.get(0)) },
                    None -> panic(misdeclared(b"names a label no generic list binds", l.name)),
                  },
                  _ -> panic(misdeclared(b"names a scoped value without its scope's label", name)),
                }
              } else { { d: args.d, ty: NamedType({ name: name, args: args.types }) } }
            },
          },
        },
      }
    },
  }

fn declared_effects(
  d: DeclarationScope,
  effects: Option<EffectsExpression>,
) -> Effects / {abort.raise} =
  match effects {
    None -> no_effects(),
    Some(r) ->
      {
        listed: r.listed.fold([], |accumulator: List<Effect>, a: EffectExpression|
          if is_bare(a.effect_name) && a.effect_name.name.name == b"abort"
              && (match a.operation {
                Some(operation) -> operation.name == b"raise",
                None -> false,
              }) { effects_insert(accumulator, abort_effect()) }
          else if is_bare(a.effect_name) && a.effect_name.name.name == scoped_effect()
              && (match a.operation { Some(_) -> false, None -> mode_eq(a.mode, ReadMode) }) {
            match a.resource {
              Some(l) -> match d.labels.get(l.name) {
                Some(VariableType(v)) ->
                  effects_insert(accumulator, scoped_read(ResourceVariable(v))),
                _ ->
                  panic(
                    misdeclared(
                      b"reads a scoped value under a label no generic list binds",
                      l.name,
                    ),
                  ),
              },
              None ->
                panic(
                  misdeclared(b"reads a scoped value without its scope's label", scoped_effect()),
                ),
            }
          } else {
            match if is_bare(a.effect_name) && a.operation == None && a.resource == None {
                d.imported.get(a.effect_name.name.name)
              } else { None } {
              Some(imported) ->
                effects_insert(accumulator, {
                  effect: imported,
                  resource: SingletonResource,
                  mode: a.mode,
                  operation: None,
                }),
              None ->
                panic(
                  misdeclared(
                    b"performs an effect other than `abort.raise`, `scoped.read` or an effect the function declares",
                    a.effect_name.name.name,
                  ),
                ),
            }
          }),
        variable: match r.variable {
          None -> None,
          Some(v) -> match d.effect_variables.get(v.name) {
            Some(var) -> Some(var),
            None -> panic(misdeclared(b"names an effect variable no generic list binds", v.name)),
          },
        },
      },
  }

pub fn prelude_imports(imports: List<ImportDeclaration>) -> Map<Bytes, Bytes> =
  imports.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, declaration: ImportDeclaration|
    match declaration.kind {
      SelectedNames(names) -> {
        let module = declaration.path.fold(b"", |path: Bytes, segment: Identifier|
          Bytes::concat_all([path, segment.name, b"."]));
        names.fold(accumulator, |m: Map<Bytes, Bytes>, n: Identifier|
          m.insert(n.name, module.concat(n.name)))
      },
      _ -> accumulator,
    })

fn conjuncts(definition: ExternDefinition, e: Expression) -> List<Clause> / {abort.raise} =
  match e {
    BinaryExpression(b) -> if b.operation != b"and" { [written_clause(definition, e)] }
    else { conjuncts(definition, b.left_operand).concat(conjuncts(definition, b.right_operand)) },
    _ -> [written_clause(definition, e)],
  }

fn written_clause(definition: ExternDefinition, e: Expression) -> Clause / {abort.raise} =
  { condition: e, text: written_at(definition, expression_span(e)) }

fn written_at(definition: ExternDefinition, span: Span) -> Bytes / {abort.raise} =
  definition.written.slice(span.start - definition.span.start, span.end - definition.span.start)

fn has_no_function_params(params: List<Type>) -> Bool =
  params.fold(true, |ok: Bool, ty: Type| ok && (match ty { FunctionType(_) -> false, _ -> true }))

fn contract_of(
  definition: ExternDefinition,
  params: List<Type>,
  return_type: Type,
  effects: Effects,
) -> Contract / {abort.raise} =
  {
    params: definition.params.map(|p: Param| p.name.name),
    requires: definition.spec.fold([], |accumulator: List<Clause>, c: SpecClause|
      match c.kind {
        RequiresClause -> accumulator.concat(conjuncts(definition, c.expression)),
        EnsuresClause -> accumulator,
        CostClause -> panic(misdeclared(b"states a `cost`", definition.name.name)),
        SpaceClause -> panic(misdeclared(b"states a `space`", definition.name.name)),
      }),
    ensures: definition.spec.fold([], |accumulator: List<Clause>, c: SpecClause|
      match c.kind {
        EnsuresClause -> accumulator.push(written_clause(definition, c.expression)),
        _ -> accumulator,
      }),
    raises: effects.listed.contains(abort_effect()),
    pure: has_no_function_params(params),
    returns_int: return_type == int_type(),
    number_like_param: match return_type {
      VariableType(v) ->
        range(0, params.len()).fold(None, |accumulator: Option<Int>, i: Int|
          match accumulator {
            Some(_) -> accumulator,
            None -> if params.get(i) == VariableType(v) { Some(i) } else { None },
          }),
      _ -> None,
    },
  }

pub fn builtin_of_extern(
  name: Bytes,
  imported: Map<Bytes, Bytes>,
  definition: ExternDefinition,
  aliases: Map<Bytes, TypeExpression>,
) -> Builtin / {abort.raise} = {
  let types = definition.generics.types.fold(
    { fresh: fresh_new(), types: Map::new() },
    |accumulator: { fresh: Fresh, types: Map<Bytes, Type> }, p: Identifier| {
      let o = fresh_type(accumulator.fresh);
      { fresh: o.fresh, types: accumulator.types.insert(p.name, o.ty) }
    },
  );
  let labels = definition.generics.labels.fold(
    { fresh: types.fresh, types: Map::new() },
    |accumulator: { fresh: Fresh, types: Map<Bytes, Type> }, p: Identifier| {
      let o = fresh_type(accumulator.fresh);
      { fresh: o.fresh, types: accumulator.types.insert(p.name, o.ty) }
    },
  );
  let effect_params = definition.generics.effects.fold(
    { fresh: labels.fresh, effect_variables: Map::new() },
    |accumulator: { fresh: Fresh, effect_variables: Map<Bytes, Int> }, p: Identifier| {
      let o = fresh_effect_variable(accumulator.fresh);
      { fresh: o.fresh, effect_variables: accumulator.effect_variables.insert(p.name, o.var) }
    },
  );
  let params = declared_types(
    {
      fresh: effect_params.fresh,
      types: types.types,
      labels: labels.types,
      effect_variables: effect_params.effect_variables,
      imported: imported,
      aliases: aliases,
    },
    definition.params.map(|p: Param|
      match p.ty {
        Some(t) -> t,
        None -> panic(misdeclared(b"leaves a parameter untyped", p.name.name)),
      }),
    aliases.len(),
  );
  let return_type = declared_type(params.d, definition.return_type, aliases.len());
  let effects = declared_effects(return_type.d, definition.effects);
  let written = definition.constraints.fold(
    [],
    |accumulator: List<DefinitionConstraint>, c: Constraint| {
      let param = range(0, definition.generics.types.len()).fold(0 - 1, |p: Int, i: Int|
        if p >= 0 { p }
        else if definition.generics.types.get(i).name == c.param.name { i }
        else { p });
      if param < 0 { panic(misdeclared(b"constrains what no generic list binds", c.param.name)) }
      else { insert_constraint(accumulator, { deriver: c.deriver, param: param }) }
    },
  );
  let keyed = params.types.push(return_type.ty).fold([], |accumulator: List<Type>, t: Type|
    map_key_types(t, accumulator)).fold([], |accumulator: List<Int>, k: Type|
    ints_union(accumulator, order_needs(k, Map::new())));
  let found = range(0, definition.generics.types.len()).fold(
    written,
    |accumulator: List<DefinitionConstraint>, i: Int|
      match types.types.get(definition.generics.types.get(i).name) {
        Some(VariableType(v)) -> if keyed.contains(v) {
          insert_constraint(accumulator, { deriver: OrderingDeriver, param: i })
        } else { accumulator },
        _ -> accumulator,
      },
  );
  {
    name: name,
    scheme: {
      type_variables: range(0, return_type.d.fresh.next_type),
      effect_variables: range(0, return_type.d.fresh.next_effect_variable),
      keep_variables: definition.generics.retained_types.fold([], |vs: List<Int>, p: Identifier|
        match types.types.get(p.name) { Some(VariableType(v)) -> vs.push(v), _ -> vs }),
      label_variables: [],
      ty: owning_function_type(
        params.types,
        range(0, definition.params.len()).filter(|i: Int| definition.params.get(i).keep),
        false,
        return_type.ty,
        effects,
      ),
    },
    params: definition.params.map(parameter_mode),
    doc: match definition.doc { Some(d) -> d.lines, None -> [] },
    constraints: dedup_constraints(found),
    clauses: definition.spec.map(|c: SpecClause| written_at(definition, c.span)),
    contract: contract_of(definition, params.types, return_type.ty, effects),
    body: false,
  }
}

fn extern_of_signature(source: Bytes, d: FnDefinition) -> ExternDefinition / {abort.raise} =
  {
    visibility: d.visibility,
    name: d.name,
    generics: d.generics,
    params: d.params,
    return_type: match d.return_type {
      Some(t) -> t,
      None -> panic(misdeclared(b"declares no result type", d.name.name)),
    },
    effects: d.effects,
    constraints: d.constraints,
    spec: d.spec,
    doc: d.doc,
    span: d.span,
    written: source.slice(d.span.start, d.span.end),
  }

pub fn builtins() -> List<Builtin> / {abort.raise} = {
  let source = prelude_source::text();
  let parsed = parse(source);
  if parsed.parser.diagnostics.len() > 0 { panic("the prelude does not parse") } else {
    let imported = prelude_imports(parsed.node.imports);
    parsed.node.items.fold([], |accumulator: List<Builtin>, item: Item|
      match item {
        ExternItem(definition) -> if is_builtin(prelude_module(), parsed.node, definition) {
          accumulator.push(
            builtin_of_extern(definition.name.name, imported, definition, Map::new()),
          )
        } else { accumulator },
        FunctionItem(d) -> if !is_pub(d.visibility) { accumulator } else {
          let whole = extern_of_signature(source, d);
          let called = {
            ..whole,
            spec: whole.spec.filter(|c: SpecClause|
              c.kind == RequiresClause || c.kind == EnsuresClause),
          };
          accumulator.push({
            ..builtin_of_extern(d.name.name, imported, called, Map::new()),
            clauses: whole.spec.map(|c: SpecClause| written_at(whole, c.span)),
            body: true,
          })
        },
        _ -> accumulator,
      })
  }
}

pub fn builtin_named(name: Bytes) -> Option<Builtin> / {abort.raise} =
  builtins().fold(None, |accumulator: Option<Builtin>, b: Builtin|
    match accumulator {
      Some(_) -> accumulator,
      None -> if b.name == name { Some(b) } else { None },
    })

pub fn install_prelude(bare: Checker) -> Checker / {abort.raise} = {
  let bound: Checker = builtins().fold(install_prelude_adts(bare), bind_builtin);
  prelude_effects().fold(bound, |c2: Checker, effect_info: EffectInfo| add_effect(c2, effect_info))
}

pub fn reject_externs(checker: Checker, parsed: ParsedModule) -> Checker =
  List::fold(
    if is_shipped(parsed.name) { [] } else { parsed.module.items },
    checker,
    |c: Checker, item: Item|
      match item {
        ExternItem(definition) ->
          report_error_at(
            c,
            b"E0151",
            definition.name.span,
            Bytes::concat_all([
              b"`extern fn ",
              definition.name.name,
              b"` declares a function the runtime implements",
            ]),
            b"only a module shipped with the toolchain can declare one",
            [
              b"the toolchain implements only the functions declared by its own modules, so a function declared here would have no implementation",
              b"write the function's body, or use an `effect` and let a handler perform the work",
            ],
          ),
        TypeItem(definition) -> match definition.body {
          ExternBody ->
            report_error_at(
              c,
              b"E0151",
              definition.name.span,
              Bytes::concat_all([
                b"`extern type ",
                definition.name.name,
                b"` declares a type whose layout the toolchain defines",
              ]),
              b"only a module shipped with the toolchain can declare one",
              [
                b"the toolchain defines the layout only of types declared in its own modules, so a type declared here has no layout",
                b"declare a `type` with the fields or the variants its values contain",
              ],
            ),
          _ -> c,
        },
        _ -> c,
      },
  )

pub type ValueKey = | LocalKey(Int) | GlobalKey({ name: Bytes, prelude: Bool })

pub fn mode_eq(a: Mode, b: Mode) -> Bool =
  match a {
    ReadMode -> match b { ReadMode -> true, _ -> false },
    WriteMode -> match b { WriteMode -> true, _ -> false },
    InvalidMode -> false,
    RaiseMode -> is_raise(b),
  }

pub fn literal_type(literal: SourceLiteral) -> Type / {abort.raise} =
  match literal {
    LiteralInt(_) -> int_type(),
    LiteralFixed(ty, _) -> named_type(Bytes::of_string(String::of_bytes(ty).ascii_upper())),
    LiteralWide(ty, _, _) -> named_type(Bytes::of_string(String::of_bytes(ty).ascii_upper())),
    LiteralBool(_) -> bool_type(),
    LiteralString(_) -> string_type(),
    LiteralBytes(_) -> bytes_type(),
    LiteralEmbedded(_, _) -> bytes_type(),
    LiteralFloat(_) -> float_type(),
    LiteralDecimal(_) -> decimal_type(),
    LiteralChar(_) -> char_type(),
    _ -> unit_type(),
  }

pub fn record_perform(
  checker: Checker,
  entry: Effect,
  span: Span,
  source: PerformSource,
) -> Checker =
  record_perform_under(checker, entry, span, source, checker.over, checker.pending_iterations)

pub fn record_perform_under(
  checker: Checker,
  entry: Effect,
  span: Span,
  source: PerformSource,
  over: Option<Span>,
  maybe: List<PendingIteration>,
) -> Checker =
  if span.start == 0 && span.end == 0 { checker } else {
    {
      ..checker,
      performs: checker.performs.push({
        entry: entry,
        module: checker.module,
        span: span,
        source: source,
        iteration_span: over,
        pending_iterations: maybe,
      }),
    }
  }

pub fn is_direct(site: PerformSite) -> Bool =
  match site.source { DirectPerform -> true, _ -> false }

pub fn bind_builtin(c: Checker, b: Builtin) -> Checker =
  {
    ..c,
    env: env_bind_global(c.env, b.name, b.scheme),
    constraints: if b.constraints.len() == 0 { c.constraints }
    else { c.constraints.insert(b.name, b.constraints) },
    contracts: c.contracts.insert(b.name, b.contract),
    prelude_functions: if b.body { c.prelude_functions.insert(b.name, true) }
    else { c.prelude_functions },
    parameter_modes: c.parameter_modes.insert(b.name, { name: b.name, params: b.params }),
    fresh: {
      next_type: max(c.fresh.next_type, b.scheme.type_variables.len()),
      next_effect_variable: max(c.fresh.next_effect_variable, b.scheme.effect_variables.len()),
    },
  }

fn constraint_lt(a: DefinitionConstraint, b: DefinitionConstraint) -> Bool =
  a.param < b.param || (a.param == b.param && deriver_tag(a.deriver) < deriver_tag(b.deriver))

pub fn insert_constraint(
  sorted: List<DefinitionConstraint>,
  c: DefinitionConstraint,
) -> List<DefinitionConstraint> / {abort.raise} = {
  let n = sorted.len();
  let i = range(0, n).fold(n, |accumulator: Int, j: Int|
    if accumulator < n { accumulator }
    else if constraint_lt(c, sorted.get(j)) { j }
    else { accumulator });
  sorted.take(i).push(c).concat(sorted.drop(i))
}

pub fn dedup_constraints(
  xs: List<DefinitionConstraint>,
) -> List<DefinitionConstraint> / {abort.raise} =
  xs.fold([], |accumulator: List<DefinitionConstraint>, c: DefinitionConstraint|
    if accumulator.len() > 0 && accumulator.get(accumulator.len() - 1).param == c.param
        && accumulator.get(accumulator.len() - 1).deriver == c.deriver { accumulator }
    else { accumulator.push(c) })

pub type Blocker = { ty: Type, reason: DeriveRejection }

pub type AlgebraicShape = {
  name: Bytes,
  params: List<Int>,
  effect_params: List<Int>,
  fields: List<Type>,
  native: Bool,
}

pub type Shapes = Map<Bytes, AlgebraicShape>

pub fn find_adt(adts: Shapes, name: Bytes) -> Option<AlgebraicShape> = adts.get(name)

pub fn derivable(
  deriver: Deriver,
  ty: Type,
  adts: Shapes,
  assumed: List<Int>,
) -> Option<Blocker> / {abort.raise} = derivable_within(deriver, ty, adts, assumed, [], adts.len())

fn first_blocked(
  deriver: Deriver,
  types: List<Type>,
  adts: Shapes,
  assumed: List<Int>,
  visiting: List<Bytes>,
  room: Int,
) -> Option<Blocker> / {abort.raise} =
  types.fold(None, |accumulator: Option<Blocker>, ty: Type|
    match accumulator {
      Some(_) -> accumulator,
      None -> derivable_within(deriver, ty, adts, assumed, visiting, room),
    })

fn derivable_within(
  deriver: Deriver,
  ty: Type,
  adts: Shapes,
  assumed: List<Int>,
  visiting: List<Bytes>,
  room: Int,
) -> Option<Blocker> / {abort.raise} =
  match ty {
    VariableType(v) -> if assumed.contains(v) { None }
    else { Some({ ty: ty, reason: Unconstrained(v) }) },
    FunctionType(_) -> Some({ ty: ty, reason: ContainsFunction }),
    RecordType(fs) ->
      first_blocked(deriver, fs.map(|f: Field| f.ty), adts, assumed, visiting, room),
    NominalType(n) ->
      first_blocked(deriver, n.fields.map(|f: Field| f.ty), adts, assumed, visiting, room),
    NamedType(c) -> match constructor_shape(deriver, c.name) {
      Leaf -> None,
      Rejected(reason) -> Some({ ty: ty, reason: reason }),
      Structural -> first_blocked(deriver, c.args, adts, assumed, visiting, room),
      Nominal -> if visiting.contains(c.name) { None } else {
        match find_adt(adts, c.name) {
          None -> None,
          Some(adt) -> if adt.native { Some({ ty: ty, reason: ContainsNative }) }
          else if room <= 0 { panic("the search visited a type more than once on one path") } else {
            first_blocked(
              deriver,
              adt.fields.map(|f: Type| apply_arguments(f, adt.params, adt.effect_params, c.args)),
              adts,
              assumed,
              visiting.push(c.name),
              room - 1,
            )
          },
        }
      },
    },
  }

pub fn order_needs(ty: Type, shapes: Shapes) -> List<Int> / {abort.raise} =
  iterate([], variables_of_type(ty).len() + 2, |found: List<Int>|
    match derivable(OrderingDeriver, ty, shapes, found) {
      Some(b) -> match b.reason {
        Unconstrained(v) -> Continue(ints_insert(found, v)),
        _ -> Stop(found),
      },
      None -> Stop(found),
    })

pub fn variables_of_type(t: Type) -> List<Int> / {abort.raise} =
  free_variables(substitution_new(), t, { types: [], effect_variables: [] }).types

fn map_key_types(t: Type, out: List<Type>) -> List<Type> / {abort.raise} =
  match t {
    NamedType(c) -> {
      let own = match map_parts(t) { Some(p) -> out.push(p.key), None -> out };
      c.args.fold(own, |accumulator: List<Type>, a: Type| map_key_types(a, accumulator))
    },
    FunctionType(f) ->
      map_key_types(
        f.return_type,
        f.params.fold(out, |accumulator: List<Type>, p: Type| map_key_types(p, accumulator)),
      ),
    RecordType(fs) ->
      fs.fold(out, |accumulator: List<Type>, f: Field| map_key_types(f.ty, accumulator)),
    NominalType(n) ->
      n.args.fold(out, |accumulator: List<Type>, a: Type| map_key_types(a, accumulator)),
    VariableType(_) -> out,
  }

derive bin for MemberSite

derive bin for WitnessOrder

test "the clock and randomness declare exactly the operations a simulation handles itself" {
  let ops_of = |name: Bytes|
    match prelude_effects().filter(|e: EffectInfo| e.name == name) {
      [e, ..] -> e.operations.map(|o: OperationInfo| o.name),
      [] -> [],
    };
  assert_eq(ops_of(b"clock"), [b"now", b"sleep"]);
  assert_eq(ops_of(b"random"), [b"next", b"below"])
}

test "the prelude's effect names are the effects it declares" {
  assert_eq(
    prelude_effect_names(),
    prelude_effects().map(|effect_info: EffectInfo| effect_info.name),
  )
}

test "every function the prelude declares has a doc" {
  assert_eq(builtins().filter(|b: Builtin| b.doc.len() == 0).map(|b: Builtin| b.name), [])
}
