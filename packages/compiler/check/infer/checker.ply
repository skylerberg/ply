pub type Assignable = {
  variables: List<HandlerVariable>,
  assignment_forbidden_in: Option<Bytes>,
  frame: Int,
}

pub type HandlerVariable = { binder: Int, name: Bytes, ty: Type }

pub fn forbid_assignment(checker: Checker, place: Bytes) -> Checker =
  {
    ..checker,
    assignable: {
      ..checker.assignable,
      assignment_forbidden_in: Some(place),
      frame: env_depth(checker.env),
    },
  }

pub fn restore_assignable(outer: Checker, o: Inference) -> Inference =
  { ..o, checker: { ..o.checker, assignable: outer.assignable } }

