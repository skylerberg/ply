import compiler.syntax.parsing (Span, Identifier)
import std.list (prepend)
import compiler.syntax.expressions (MatchArm)
import compiler.syntax.patterns (Pattern, PatternWildcard, PatternVariable, PatternLiteral,
                                 PatternRange, PatternConstructor, PatternRecord, PatternList,
                                 PatternOr, PatternInvalid, SourceLiteral, LiteralInt, LiteralFixed,
                                 LiteralWide, LiteralBool, LiteralUnit)
import std.bytes
import std.bytes (ascii_of_int)
import std.option
import std.string
import std.math (pow)
import compiler.check.infer.checker (ConstructorInfo, Checker, report_error_at, constructor_of)
import compiler.check.known (int_name, fixed_widths)
import compiler.check.infer.names (covered_constructor, private_name_diagnostic)
import compiler.check.types (backticked_text)

pub fn integer_of(literal: SourceLiteral) -> Option<Bytes> / {abort.raise} =
  match literal {
    LiteralInt(_) -> Some(int_name),
    LiteralFixed(ty, _) -> Some(Bytes::of_string(String::of_bytes(ty).ascii_upper())),
    LiteralWide(ty, _, _) -> Some(Bytes::of_string(String::of_bytes(ty).ascii_upper())),
    _ -> None,
  }

pub type CoveragePattern =
  | CoverAny
  | CoverNothing
  | CoverConstructor({ family: Bytes, key: Bytes, name: Bytes, args: List<CoveragePattern> })
  | CoverRecord(List<{ name: Bytes, pattern: CoveragePattern }>)
  | CoverSpan({ family: Bytes, lo: Int, hi: Int })
  | CoverEither(List<CoveragePattern>)

type CoverageConstructor = { key: Bytes, name: Bytes, arity: Int, lo: Int, hi: Int }

pub fn check_exhaustive(
  checker: Checker,
  span: Span,
  arms: List<MatchArm>,
) -> Checker / {abort.raise} = {
  let rows = arms.fold([], |accumulator: List<List<CoveragePattern>>, arm: MatchArm|
    match arm.guard {
      None -> accumulator.push([coverage_pattern(checker, arm.pattern)]),
      Some(_) -> accumulator,
    });
  let missing = uncovered(checker, rows, 1);
  if missing.len() == 0 { checker } else {
    report_error_at(
      checker,
      b"E0205",
      span,
      b"match does not cover every case",
      b"not covered: ".concat(
        Bytes::join(
          missing.map(|patterns: List<CoveragePattern>|
            backticked_text(pattern_text(patterns.get(0)))),
          b", ",
        ),
      ),
      [b"add the missing arms, or a `_` arm"],
    )
  }
}

pub fn coverage_pattern(checker: Checker, p: Pattern) -> CoveragePattern / {abort.raise} =
  match p {
    PatternConstructor(c) -> {
      let info = match covered_constructor(checker, c.name) {
        Some(q) -> constructor_of(checker, q),
        None -> None,
      };
      match info {
        Some(k) ->
          CoverConstructor({
            family: k.type_name,
            key: k.name,
            name: k.simple_name,
            args: c.args.map(|a: Pattern| coverage_pattern(checker, a)),
          }),
        None -> match private_name_diagnostic(checker, c.name) {
          Some(_) -> CoverAny,
          None -> CoverNothing,
        },
      }
    },
    PatternLiteral(l) -> match l.literal {
      LiteralBool(b) -> {
        let k = if b { b"true" } else { b"false" };
        CoverConstructor({ family: b"#bool", key: k, name: k, args: [] })
      },
      LiteralUnit -> CoverConstructor({ family: b"#unit", key: b"()", name: b"()", args: [] }),
      other -> cover_span(other, other),
    },
    PatternRange(r) -> cover_span(r.lo, r.hi),
    PatternList(l) -> {
      let n = l.items.len();
      let last = match l.rest {
        Some(r) -> coverage_pattern(checker, r),
        None -> list_constructor(b"[]", []),
      };
      range(0, n).fold(last, |tail: CoveragePattern, i: Int|
        list_constructor(b"::", [coverage_pattern(checker, l.items.get(n - 1 - i)), tail]))
    },
    PatternRecord(r) ->
      CoverRecord(
        r.fields.map(|f: { name: Identifier, pattern: Pattern }|
          { name: f.name.name, pattern: coverage_pattern(checker, f.pattern) }),
      ),
    PatternOr(o) -> CoverEither(o.alternatives.map(|a: Pattern| coverage_pattern(checker, a))),
    PatternWildcard(_) -> CoverAny,
    PatternVariable(_) -> CoverAny,
    PatternInvalid(_) -> CoverAny,
  }

fn cover_span(lo: SourceLiteral, hi: SourceLiteral) -> CoveragePattern / {abort.raise} = {
  let literal = CoverConstructor({ family: b"#lit", key: b"", name: b"", args: [] });
  match ((lo, hi)) {
    (LiteralFixed(_, a), LiteralFixed(_, b)) -> match ((integer_of(lo), integer_of(hi))) {
      (Some(ty), Some(other)) -> if ty != other { CoverNothing }
      else if unsigned_type_max(ty) == None { literal }
      else if a > b { CoverNothing }
      else { CoverSpan({ family: integer_column_prefix.concat(ty), lo: a, hi: b }) },
      _ -> literal,
    },
    _ -> literal,
  }
}

const integer_column_prefix: Bytes = b"#int:"

fn unsigned_type_max(ty: Bytes) -> Option<Int> =
  fixed_widths.find_map(|w: { name: Bytes, bits: Int, signed: Bool }|
    if w.name == ty && !w.signed && w.bits < 64 { Some(pow(2, w.bits) - 1) } else { None })

fn integer_column_max(family: Bytes) -> Int / {abort.raise} =
  match unsigned_type_max(family.slice(integer_column_prefix.len(), family.len())) {
    Some(top) -> top,
    None -> panic("the matched integer type is not an unsigned type narrower than 64 bits"),
  }

fn span_text(family: Bytes, lo: Int, hi: Int) -> Bytes / {abort.raise} = {
  let suffix = Bytes::of_string(
    String::of_bytes(family.slice(integer_column_prefix.len(), family.len())).ascii_lower(),
  );
  if lo == hi { ascii_of_int(lo).concat(suffix) }
  else { Bytes::concat_all([ascii_of_int(lo), suffix, b"..=", ascii_of_int(hi), suffix]) }
}

fn int_cells(
  rows: List<List<CoveragePattern>>,
  family: Bytes,
) -> List<CoverageConstructor> / {abort.raise} = {
  let top = integer_column_max(family);
  let starts = rows.fold([0], |accumulator: List<Int>, r: List<CoveragePattern>|
    match r.get(0) {
      CoverSpan(s) -> if s.family != family { accumulator } else {
        let from = accumulator.push_unique(s.lo);
        if s.hi < top { from.push_unique(s.hi + 1) } else { from }
      },
      _ -> accumulator,
    }).sort(
  );
  range(0, starts.len()).map(|i: Int| {
    let lo = starts.get(i);
    let hi = if i + 1 < starts.len() { starts.get(i + 1) - 1 } else { top };
    let text = span_text(family, lo, hi);
    { key: text, name: text, arity: 0, lo: lo, hi: hi }
  })
}

fn matches_constructor(pattern: CoveragePattern, family: Bytes, k: CoverageConstructor) -> Bool =
  match pattern {
    CoverConstructor(c) -> c.family == family && c.key == k.key,
    CoverSpan(s) -> s.family == family && s.lo <= k.lo && k.hi <= s.hi,
    _ -> false,
  }

fn list_constructor(key: Bytes, args: List<CoveragePattern>) -> CoveragePattern =
  CoverConstructor({ family: b"#list", key: key, name: key, args: args })

fn wildcards(n: Int) -> List<CoveragePattern> = range(0, n).map(|_: Int| CoverAny)

fn family_of(pattern: CoveragePattern) -> Bytes =
  match pattern {
    CoverConstructor(c) -> c.family,
    CoverSpan(s) -> s.family,
    CoverRecord(_) -> b"#rec",
    _ -> b"",
  }

fn any_row_matches_constructor(
  rows: List<List<CoveragePattern>>,
  family: Bytes,
  k: CoverageConstructor,
) -> Bool / {abort.raise} =
  rows.fold(false, |b: Bool, r: List<CoveragePattern>|
    b || matches_constructor(r.get(0), family, k))

fn family_constructors(
  checker: Checker,
  rows: List<List<CoveragePattern>>,
  family: Bytes,
) -> Option<List<CoverageConstructor>> / {abort.raise} = {
  let named = |key: Bytes, arity: Int| { key: key, name: key, arity: arity, lo: 0, hi: 0 };
  if family == b"#bool" { Some([named(b"true", 0), named(b"false", 0)]) }
  else if family == b"#unit" { Some([named(b"()", 0)]) }
  else if family == b"#list" { Some([named(b"[]", 0), named(b"::", 2)]) }
  else if family == b"#lit" || family == b"" { None }
  else if family.starts_with(integer_column_prefix) { Some(int_cells(rows, family)) } else {
    Some(
      checker.constructors.filter(|constructor_info: ConstructorInfo|
        constructor_info.type_name == family).map(|constructor_info: ConstructorInfo|
        {
          key: constructor_info.name,
          name: constructor_info.simple_name,
          arity: constructor_info.arity,
          lo: 0,
          hi: 0,
        }),
    )
  }
}

pub fn uncovered(
  checker: Checker,
  rows: List<List<CoveragePattern>>,
  n: Int,
) -> List<List<CoveragePattern>> / {abort.raise} =
  uncovered_within(checker, rows, n, search_depth_limit(checker, rows, n))

fn search_depth_limit(checker: Checker, rows: List<List<CoveragePattern>>, n: Int) -> Int = {
  let most = checker.constructors.fold(2, |m: Int, c: ConstructorInfo|
    if c.arity > m { c.arity } else { m });
  rows.fold(n + 1, |accumulator: Int, r: List<CoveragePattern>|
    r.fold(accumulator, |a: Int, p: CoveragePattern| a + columns_added(p, most)))
}

fn columns_added(p: CoveragePattern, most: Int) -> Int =
  match p {
    CoverAny -> 0,
    CoverNothing -> 0,
    CoverConstructor(c) ->
      c.args.fold(most, |n: Int, a: CoveragePattern| n + columns_added(a, most)),
    CoverSpan(_) -> 0,
    CoverRecord(fs) ->
      fs.fold(fs.len(), |n: Int, f: { name: Bytes, pattern: CoveragePattern }|
        n + columns_added(f.pattern, most)),
    CoverEither(alts) -> alts.fold(0, |n: Int, a: CoveragePattern| n + columns_added(a, most)),
  }

fn uncovered_within(
  checker: Checker,
  rows: List<List<CoveragePattern>>,
  n: Int,
  room: Int,
) -> List<List<CoveragePattern>> / {abort.raise} =
  if room <= 0 { panic("the check for unmatched cases exceeded its limit on pattern splits") }
  else {
    uncovered_split(
      checker,
      rows.fold([], |accumulator: List<List<CoveragePattern>>, patterns: List<CoveragePattern>|
        accumulator.concat(split_or(patterns))),
      n,
      room - 1,
    )
  }

fn split_or(patterns: List<CoveragePattern>) -> List<List<CoveragePattern>> =
  match patterns {
    [CoverEither(alts), ..rest] ->
      alternatives(CoverEither(alts)).map(|pattern: CoveragePattern| prepend(pattern, rest)),
    _ -> [patterns],
  }

fn alternatives(pattern: CoveragePattern) -> List<CoveragePattern> =
  match pattern {
    CoverEither(alts) ->
      alts.fold([], |accumulator: List<CoveragePattern>, alt: CoveragePattern|
        accumulator.concat(alternatives(alt))),
    _ -> [pattern],
  }

fn uncovered_split(
  checker: Checker,
  rows: List<List<CoveragePattern>>,
  n: Int,
  room: Int,
) -> List<List<CoveragePattern>> / {abort.raise} =
  if rows.len() == 0 { [wildcards(n)] }
  else if n == 0 { [] } else {
    let family = rows.fold(b"", |accumulator: Bytes, r: List<CoveragePattern>|
      if accumulator.len() > 0 { accumulator } else { family_of(r.get(0)) });
    if family == b"#rec" { uncovered_record(checker, rows, n, room) } else {
      match family_constructors(checker, rows, family) {
        None ->
          uncovered_within(checker, default_rows(rows, family), n - 1, room).map(
            |w: List<CoveragePattern>| prepend(CoverAny, w),
          ),
        Some(all) -> if all.fold(true, |b: Bool, k: CoverageConstructor|
            b && any_row_matches_constructor(rows, family, k)) {
          all.fold([], |accumulator: List<List<CoveragePattern>>, k: CoverageConstructor|
            accumulator.concat(uncovered_after_constructor(checker, rows, n, family, k, room)))
        } else {
          match uncovered_within(checker, default_rows(rows, family), n - 1, room).at(0) {
            None -> [],
            Some(w) ->
              all.fold([], |accumulator: List<List<CoveragePattern>>, k: CoverageConstructor|
                if any_row_matches_constructor(rows, family, k) {
                  accumulator.concat(uncovered_after_constructor(checker, rows, n, family, k, room))
                } else {
                  accumulator.push(
                    prepend(
                      CoverConstructor({
                        family: family,
                        key: k.key,
                        name: k.name,
                        args: wildcards(k.arity),
                      }),
                      w,
                    ),
                  )
                }),
          }
        },
      }
    }
  }

fn uncovered_after_constructor(
  checker: Checker,
  rows: List<List<CoveragePattern>>,
  n: Int,
  family: Bytes,
  k: CoverageConstructor,
  room: Int,
) -> List<List<CoveragePattern>> / {abort.raise} =
  uncovered_within(checker, specialize(rows, family, k), k.arity + n - 1, room).map(
    |patterns: List<CoveragePattern>|
      prepend(
        CoverConstructor({
          family: family,
          key: k.key,
          name: k.name,
          args: patterns.take(k.arity),
        }),
        patterns.drop(k.arity),
      ),
  )

fn specialize(
  rows: List<List<CoveragePattern>>,
  family: Bytes,
  k: CoverageConstructor,
) -> List<List<CoveragePattern>> / {abort.raise} =
  rows.fold([], |accumulator: List<List<CoveragePattern>>, patterns: List<CoveragePattern>|
    match patterns.get(0) {
      CoverNothing -> accumulator,
      CoverConstructor(c) -> if c.family != family {
        accumulator.push(wildcards(k.arity).concat(patterns.drop(1)))
      } else if c.key != k.key { accumulator }
      else if c.args.len() == k.arity { accumulator.push(c.args.concat(patterns.drop(1))) }
      else { accumulator.push(wildcards(k.arity).concat(patterns.drop(1))) },
      CoverSpan(s) -> if s.family == family && !matches_constructor(patterns.get(0), family, k) {
        accumulator
      } else { accumulator.push(wildcards(k.arity).concat(patterns.drop(1))) },
      _ -> accumulator.push(wildcards(k.arity).concat(patterns.drop(1))),
    })

fn default_rows(
  rows: List<List<CoveragePattern>>,
  family: Bytes,
) -> List<List<CoveragePattern>> / {abort.raise} =
  rows.fold([], |accumulator: List<List<CoveragePattern>>, patterns: List<CoveragePattern>|
    match patterns.get(0) {
      CoverNothing -> accumulator,
      CoverConstructor(c) -> if c.family == family { accumulator }
      else { accumulator.push(patterns.drop(1)) },
      CoverSpan(s) -> if s.family == family { accumulator }
      else { accumulator.push(patterns.drop(1)) },
      _ -> accumulator.push(patterns.drop(1)),
    })

fn uncovered_record(
  checker: Checker,
  rows: List<List<CoveragePattern>>,
  n: Int,
  room: Int,
) -> List<List<CoveragePattern>> / {abort.raise} = {
  let names = rows.fold([], |accumulator: List<Bytes>, r: List<CoveragePattern>|
    match r.get(0) {
      CoverRecord(fs) ->
        fs.fold(accumulator, |a: List<Bytes>, f: { name: Bytes, pattern: CoveragePattern }|
          if a.contains(f.name) { a } else { a.push(f.name) }),
      _ -> accumulator,
    });
  let k = names.len();
  let spread = rows.fold(
    [],
    |accumulator: List<List<CoveragePattern>>, r: List<CoveragePattern>|
      match r.get(0) {
        CoverNothing -> accumulator,
        CoverRecord(fs) ->
          accumulator.push(names.map(|nm: Bytes| field_pattern(fs, nm)).concat(r.drop(1))),
        _ -> accumulator.push(wildcards(k).concat(r.drop(1))),
      },
  );
  uncovered_within(checker, spread, k + n - 1, room).map(|w: List<CoveragePattern>|
    prepend(
      CoverRecord(range(0, k).map(|i: Int| { name: names.get(i), pattern: w.get(i) })),
      w.drop(k),
    ))
}

fn field_pattern(
  fs: List<{ name: Bytes, pattern: CoveragePattern }>,
  name: Bytes,
) -> CoveragePattern =
  fs.fold(CoverAny, |accumulator: CoveragePattern, f: { name: Bytes, pattern: CoveragePattern }|
    if f.name == name { f.pattern } else { accumulator })

pub fn pattern_text(x: CoveragePattern) -> Bytes / {abort.raise} =
  match x {
    CoverConstructor(c) -> if c.family == b"#list" { list_pattern_text(x, []) }
    else if c.args.len() == 0 { c.name } else {
      Bytes::concat_all([
        c.name,
        b"(",
        Bytes::join(c.args.map(|a: CoveragePattern| pattern_text(a)), b", "),
        b")",
      ])
    },
    CoverRecord(fs) -> record_pattern_text(fs),
    _ -> b"_",
  }

fn list_pattern_text(pattern: CoveragePattern, items: List<Bytes>) -> Bytes / {abort.raise} =
  match pattern {
    CoverConstructor(c) -> if c.key == b"::" && c.args.len() == 2 {
      list_pattern_text(c.args.get(1), items.push(pattern_text(c.args.get(0))))
    } else { Bytes::concat_all([b"[", Bytes::join(items, b", "), b"]"]) },
    _ -> Bytes::concat_all([b"[", Bytes::join(items.push(b".."), b", "), b"]"]),
  }

fn record_pattern_text(
  fs: List<{ name: Bytes, pattern: CoveragePattern }>,
) -> Bytes / {abort.raise} = {
  let parts = fs.map(|f: { name: Bytes, pattern: CoveragePattern }| pattern_text(f.pattern));
  let tuple = fs.len() > 1
    && range(0, fs.len()).fold(true, |b: Bool, i: Int|
      b && fs.get(i).name == b"_".concat(ascii_of_int(i)));
  if !parts.fold(false, |b: Bool, t: Bytes| b || t != b"_") { b"_" }
  else if tuple { Bytes::concat_all([b"(", Bytes::join(parts, b", "), b")"]) } else {
    let named = range(0, fs.len()).filter(|i: Int| parts.get(i) != b"_");
    Bytes::concat_all([
      b"{",
      Bytes::join(
        named.map(|i: Int| Bytes::concat_all([fs.get(i).name, b": ", parts.get(i)])).push(b".."),
        b", ",
      ),
      b"}",
    ])
  }
}
