import compiler.syntax.parsing (Error)
import compiler.syntax.parsing (span_bin, span_between, is_generated, generated_span)
import compiler.syntax.expressions (expression_bin)
import compiler.syntax.parsing (Span, Identifier, QName, Severity, severity_bin, span_to)
import compiler.syntax.items (Module, Item, FunctionItem, ExternItem, TypeItem, EffectItem,
                              EffectSetItem, SumBody, AliasBody, VariantDefinition, Visibility,
                              Private, ImportDeclaration, WholeModule, ModuleAlias, SelectedNames,
                              DeriveOrigin, is_pub, NominalBody, ExternBody, is_builtin,
                              EffectSetDefinition, Opaque, opaque_bin, SchemaDefinition, is_shipped)
import compiler.syntax.expressions (Expression)
import std.list
import std.bin
import std.bytes (ascii_of_int)
import compiler.check.types (last_dot)

pub type Source = { name: Bytes, source_text: Bytes }

pub type ParsedModule = { name: Bytes, module: Module, derived: List<DeriveOrigin> }

pub type Namespace = | ValueSpace | TypeSpace | EffectSpace | SetSpace

pub type ClosedBy = { type_name: Bytes, opaque: Opaque }

pub type Declaration = {
  name: Bytes,
  qualified: Bytes,
  public: Bool,
  span: Span,
  closed_by: Option<ClosedBy>,
  constant: Bool,
}

pub type Declarations = {
  values: List<Declaration>,
  types: List<Declaration>,
  effects: List<Declaration>,
  sets: List<Declaration>,
  by_value: Map<Bytes, Declaration>,
  by_type: Map<Bytes, Declaration>,
  by_effect: Map<Bytes, Declaration>,
  by_set: Map<Bytes, Declaration>,
}

pub type Binding = { name: Bytes, qualified: Bytes, owner: Bytes, span: Span }

pub type Bindings = {
  values: List<Binding>,
  types: List<Binding>,
  effects: List<Binding>,
  sets: List<Binding>,
  by_value: Map<Bytes, Binding>,
  by_type: Map<Bytes, Binding>,
  by_effect: Map<Bytes, Binding>,
  by_set: Map<Bytes, Binding>,
}

pub type ModuleBinding = { binder: Bytes, target: Bytes, span: Span }

pub type Scope = {
  module: Bytes,
  modules: List<ModuleBinding>,
  selected_modules: List<ModuleBinding>,
  bound: Bindings,
  failed: List<Bytes>,
}

pub fn bound_by_failed_import(scope: Scope, name: QName) -> Bool =
  match name.module {
    None -> scope.failed.contains(name.name.name),
    Some(binder) -> scope.failed.contains(binder.name),
  }

pub type Place = | InSource({ module: Int, start: Int, end: Int }) | WholeFile(Int) | Unplaced

pub type Label = { place: Place, primary: Bool, text: Bytes }

pub type Edit = { module: Int, start: Int, end: Int, text: Bytes }

pub type AddedEffects = { function: Bytes, effects: List<Bytes>, calls: List<Bytes> }

pub type Fix = { title: Bytes, edits: List<Edit>, adds: Option<AddedEffects> }

pub type Diagnostic = {
  code: Bytes,
  labels: List<Label>,
  text: Bytes,
  message: Bytes,
  notes_text: List<Bytes>,
  severity: Severity,
  fixes: List<Fix>,
}

pub fn placed_in(d: Diagnostic, module: Int) -> Diagnostic =
  {
    ..d,
    labels: d.labels.map(|l: Label| { ..l, place: in_module(l.place, module) }),
    fixes: d.fixes.map(|f: Fix| { ..f, edits: f.edits.map(|e: Edit| { ..e, module: module }) }),
  }

derive bin for Source

derive bin for Place

derive bin for Label

derive bin for Edit

derive bin for AddedEffects

derive bin for Fix

derive bin for Diagnostic

derive bin for ClosedBy

derive bin for Declaration

derive bin for Binding

derive bin for Declarations

derive bin for ModuleBinding

derive bin for Bindings

derive bin for Scope

pub type Edge = { from: Int, target: Int, span: Span }

pub type ModuleEntry = { name: Bytes, at: Int }

pub type Resolution = {
  names: List<ModuleEntry>,
  scopes: List<Scope>,
  declarations: List<Declarations>,
  declared: List<Bindings>,
  order: List<Int>,
  imports: List<List<Int>>,
  signatures: Map<Bytes, Parameters>,
  visible_modules: List<List<Int>>,
  positions: Map<Bytes, Int>,
}

pub effect other_modules {
  read look_up_declaration(module: Bytes, namespace: Namespace, name: Bytes) -> Option<Declaration>
  read look_up_declarations(module: Bytes) -> Option<Declarations>
  read look_up_effect_set(module: Bytes, name: Bytes) -> Option<EffectSetDefinition>
  read look_up_schema(module: Bytes, name: Bytes) -> Option<SchemaDefinition>
  read look_up_package(module: Bytes) -> Option<Int>
  read look_up_module_scope(module: Bytes) -> Option<Scope>
  read look_up_parameters(name: Bytes) -> Option<Parameters>
  read list_visible_modules(module: Bytes) -> List<Bytes>
  read list_modules() -> List<Bytes>
  read list_shipped_modules() -> List<Bytes>
}

pub type LoadedModules = { declarations: Map<Bytes, Declarations>, packages: Map<Bytes, Int> }

pub fn with_no_other_modules<a | e>(body: () -> a / {other_modules.read | e}) -> a / e =
  with_modules({ declarations: Map::new(), packages: Map::new() }, body)

pub fn with_modules<a | e>(
  loaded: LoadedModules,
  body: () -> a / {other_modules.read | e},
) -> a / e =
  handle {
    body()
  } with {
    other_modules.look_up_declaration(module, namespace, name) -> match loaded.declarations.get(module) {
      Some(d) -> lookup_declared(d, namespace, name),
      None -> None,
    },
    other_modules.look_up_declarations(module) -> loaded.declarations.get(module),
    other_modules.look_up_effect_set(module, name) -> None,
    other_modules.look_up_schema(module, name) -> None,
    other_modules.look_up_package(module) -> loaded.packages.get(module),
    other_modules.look_up_module_scope(module) -> None,
    other_modules.look_up_parameters(name) -> None,
    other_modules.list_visible_modules(module) -> [],
    other_modules.list_modules() -> loaded.packages.keys(),
    other_modules.list_shipped_modules() -> loaded.packages.keys().filter(is_shipped),
  }

pub fn declared_in(
  resolved: Resolution,
  module: Bytes,
  namespace: Namespace,
  name: Bytes,
) -> Option<Declaration> / {other_modules.read} =
  match match resolved.positions.get(module) {
      Some(i) -> match resolved.declarations.at(i) {
        Some(d) -> lookup_declared(d, namespace, name),
        None -> None,
      },
      None -> None,
    } {
    Some(d) -> Some(d),
    None -> other_modules.look_up_declaration(module, namespace, name),
  }

pub fn declarations_named(
  resolved: Resolution,
  module: Bytes,
) -> Option<Declarations> / {other_modules.read} =
  match other_modules.look_up_declarations(module) {
    Some(d) -> Some(d),
    None -> match resolved.positions.get(module) {
      Some(i) -> resolved.declarations.at(i),
      None -> None,
    },
  }

pub fn bound_in(
  scope: Scope,
  namespace: Namespace,
  name: Bytes,
) -> Option<Binding> / {other_modules.read} =
  match lookup(scope.bound, namespace, name) {
    Some(b) -> Some(b),
    None -> match other_modules.look_up_declaration(scope.module, namespace, name) {
      Some(d) -> Some(binding_of(d, scope.module)),
      None -> None,
    },
  }

pub fn implicit_binder(module: Bytes) -> Bytes = b"@".concat(module)

pub fn implicit_target(binder: Bytes) -> Option<Bytes> / {abort.raise} =
  if binder.starts_with(b"@") { Some(binder.slice(1, binder.len())) } else { None }

pub fn module_binding_in(scope: Scope, binder: Bytes) -> Option<ModuleBinding> / {abort.raise} =
  match find_module_binding(scope.modules, binder) {
    Some(m) -> Some(m),
    None -> match implicit_target(binder) {
      Some(target) -> Some({ binder: binder, target: target, span: generated_span }),
      None -> None,
    },
  }

fn bindings_of_space(bound: Bindings, namespace: Namespace) -> List<Binding> =
  match namespace {
    ValueSpace -> bound.values,
    TypeSpace -> bound.types,
    EffectSpace -> bound.effects,
    SetSpace -> bound.sets,
  }

pub fn scope_bindings(scope: Scope, namespace: Namespace) -> List<Binding> / {other_modules.read} = {
  let own = match other_modules.look_up_declarations(scope.module) {
    Some(d) ->
      declarations_in(d, namespace).map(|declared: Declaration| binding_of(declared, scope.module)),
    None -> [],
  };
  let imported = match other_modules.look_up_module_scope(scope.module) {
    Some(s) -> bindings_of_space(s.bound, namespace),
    None -> [],
  };
  own.concat(imported).fold(
    bindings_of_space(scope.bound, namespace),
    |found: List<Binding>, b: Binding|
      if found.any(|x: Binding| x.name == b.name) { found } else { found.push(b) },
  )
}

pub fn scope_modules(scope: Scope) -> List<ModuleBinding> / {other_modules.read} =
  match other_modules.look_up_module_scope(scope.module) {
    Some(s) -> s.modules,
    None -> scope.modules,
  }

pub fn effect_set_declared(
  modules: List<ParsedModule>,
  resolved: Resolution,
  owner: Bytes,
  name: Bytes,
) -> Option<EffectSetDefinition> / {other_modules.read, abort.raise} = {
  let loaded = match resolved.positions.get(owner) {
    Some(i) ->
      modules.get(i).module.items.fold(None, |found: Option<EffectSetDefinition>, item: Item|
        match item {
          EffectSetItem(d) -> if d.name.name == name { Some(d) } else { found },
          _ -> found,
        }),
    None -> None,
  };
  match loaded { Some(d) -> Some(d), None -> other_modules.look_up_effect_set(owner, name) }
}

pub fn parameters_named(
  resolved: Resolution,
  name: Bytes,
) -> Option<Parameters> / {other_modules.read} =
  match resolved.signatures.get(name) {
    Some(p) -> Some(p),
    None -> other_modules.look_up_parameters(name),
  }

pub const module_elsewhere: Int = -1

pub fn module_index(resolved: Resolution, name: Bytes) -> Int =
  match resolved.positions.get(name) { Some(i) -> i, None -> module_elsewhere }

pub fn binding_of(declared: Declaration, owner: Bytes) -> Binding =
  { name: declared.name, qualified: declared.qualified, owner: owner, span: declared.span }

pub const no_declarations: Declarations =
  {
    values: [],
    types: [],
    effects: [],
    sets: [],
    by_value: Map::new(),
    by_type: Map::new(),
    by_effect: Map::new(),
    by_set: Map::new(),
  }

pub const no_bindings: Bindings =
  {
    values: [],
    types: [],
    effects: [],
    sets: [],
    by_value: Map::new(),
    by_type: Map::new(),
    by_effect: Map::new(),
    by_set: Map::new(),
  }

pub const namespaces: List<Namespace> = [ValueSpace, TypeSpace, EffectSpace, SetSpace]

pub fn declarations_in(declarations: Declarations, namespace: Namespace) -> List<Declaration> =
  match namespace {
    ValueSpace -> declarations.values,
    TypeSpace -> declarations.types,
    EffectSpace -> declarations.effects,
    SetSpace -> declarations.sets,
  }

fn first_declared(m: Map<Bytes, Declaration>, declared: Declaration) -> Map<Bytes, Declaration> =
  if m.contains(declared.name) { m } else { m.insert(declared.name, declared) }

fn insert_first_binding(m: Map<Bytes, Binding>, binding: Binding) -> Map<Bytes, Binding> =
  if m.contains(binding.name) { m } else { m.insert(binding.name, binding) }

pub fn push_declared(
  declarations: Declarations,
  namespace: Namespace,
  declared: Declaration,
) -> Declarations =
  match namespace {
    ValueSpace ->
      {
        ..declarations,
        values: declarations.values.push(declared),
        by_value: first_declared(declarations.by_value, declared),
      },
    TypeSpace ->
      {
        ..declarations,
        types: declarations.types.push(declared),
        by_type: first_declared(declarations.by_type, declared),
      },
    EffectSpace ->
      {
        ..declarations,
        effects: declarations.effects.push(declared),
        by_effect: first_declared(declarations.by_effect, declared),
      },
    SetSpace ->
      {
        ..declarations,
        sets: declarations.sets.push(declared),
        by_set: first_declared(declarations.by_set, declared),
      },
  }

pub fn lookup_declared(
  declarations: Declarations,
  namespace: Namespace,
  name: Bytes,
) -> Option<Declaration> =
  Map::get(
    match namespace {
      ValueSpace -> declarations.by_value,
      TypeSpace -> declarations.by_type,
      EffectSpace -> declarations.by_effect,
      SetSpace -> declarations.by_set,
    },
    name,
  )

fn with_space_bindings(b: Bindings, namespace: Namespace, xs: List<Binding>) -> Bindings = {
  let by = xs.fold(Map::new(), |m: Map<Bytes, Binding>, binding: Binding|
    insert_first_binding(m, binding));
  match namespace {
    ValueSpace -> { ..b, values: xs, by_value: by },
    TypeSpace -> { ..b, types: xs, by_type: by },
    EffectSpace -> { ..b, effects: xs, by_effect: by },
    SetSpace -> { ..b, sets: xs, by_set: by },
  }
}

pub fn push_binding(bindings: Bindings, namespace: Namespace, binding: Binding) -> Bindings =
  match namespace {
    ValueSpace ->
      {
        ..bindings,
        values: bindings.values.push(binding),
        by_value: insert_first_binding(bindings.by_value, binding),
      },
    TypeSpace ->
      {
        ..bindings,
        types: bindings.types.push(binding),
        by_type: insert_first_binding(bindings.by_type, binding),
      },
    EffectSpace ->
      {
        ..bindings,
        effects: bindings.effects.push(binding),
        by_effect: insert_first_binding(bindings.by_effect, binding),
      },
    SetSpace ->
      {
        ..bindings,
        sets: bindings.sets.push(binding),
        by_set: insert_first_binding(bindings.by_set, binding),
      },
  }

pub fn bindings_in(bindings: Bindings, namespace: Namespace) -> List<Binding> =
  match namespace {
    ValueSpace -> bindings.values,
    TypeSpace -> bindings.types,
    EffectSpace -> bindings.effects,
    SetSpace -> bindings.sets,
  }

pub fn lookup(bindings: Bindings, namespace: Namespace, name: Bytes) -> Option<Binding> =
  Map::get(
    match namespace {
      ValueSpace -> bindings.by_value,
      TypeSpace -> bindings.by_type,
      EffectSpace -> bindings.by_effect,
      SetSpace -> bindings.by_set,
    },
    name,
  )

pub fn find_module_binding(bindings: List<ModuleBinding>, binder: Bytes) -> Option<ModuleBinding> =
  bindings.fold(None, |accumulator: Option<ModuleBinding>, binding: ModuleBinding|
    match accumulator {
      Some(_) -> accumulator,
      None -> if binding.binder == binder { Some(binding) } else { None },
    })

pub fn position(xs: List<Int>, v: Int) -> Option<Int> / {abort.raise} =
  range(0, xs.len()).fold(None, |accumulator: Option<Int>, i: Int|
    match accumulator {
      Some(_) -> accumulator,
      None -> if xs.get(i) == v { Some(i) } else { None },
    })

pub fn default_binder(name: Bytes) -> Bytes / {abort.raise} =
  name.slice(last_dot(name) + 1, name.len())

pub fn module_of_name(name: Bytes) -> Bytes = {
  let dot = last_dot(name);
  if dot < 0 { b"" } else { match name.slice_at(0, dot) { Some(m) -> m, None -> b"" } }
}

pub fn qualify(module: Bytes, name: Bytes) -> Bytes =
  if module.len() == 0 { name } else { Bytes::concat_all([module, b".", name]) }

pub fn import_module_name(declaration: ImportDeclaration) -> Bytes / {abort.raise} =
  range(0, declaration.path.len()).fold(b"", |accumulator: Bytes, i: Int|
    if i == 0 { declaration.path.get(i).name }
    else { Bytes::concat_all([accumulator, b".", declaration.path.get(i).name]) })

pub fn path_span(declaration: ImportDeclaration) -> Span / {abort.raise} =
  if declaration.path.len() == 0 { declaration.span } else {
    span_to(declaration.path.get(0).span, declaration.path.get(declaration.path.len() - 1).span)
  }

pub fn import_binder(declaration: ImportDeclaration) -> Option<Bytes> / {abort.raise} =
  match declaration.kind {
    WholeModule -> if declaration.path.len() == 0 { None }
    else { Some(declaration.path.get(declaration.path.len() - 1).name) },
    ModuleAlias(a) -> Some(a.name),
    SelectedNames(_) -> None,
  }

pub fn binder_span(declaration: ImportDeclaration) -> Span / {abort.raise} =
  match declaration.kind {
    WholeModule -> if declaration.path.len() == 0 { declaration.span }
    else { declaration.path.get(declaration.path.len() - 1).span },
    ModuleAlias(a) -> a.span,
    SelectedNames(_) -> declaration.span,
  }

pub fn place_of(m: Int, span: Span) -> Place =
  if m == module_elsewhere || is_generated(span) { Unplaced }
  else { InSource({ module: m, start: span.start, end: span.end }) }

pub fn source_span(label: Label) -> Option<{ module: Int, start: Int, end: Int }> =
  match label.place { InSource(s) -> Some(s), _ -> None }

pub fn labelled_text(source: Bytes, label: Label) -> Option<Bytes> / {abort.raise} =
  match source_span(label) { Some(s) -> Some(source.slice(s.start, s.end)), None -> None }

pub fn place_module(place: Place) -> Option<Int> =
  match place { InSource(s) -> Some(s.module), WholeFile(m) -> Some(m), Unplaced -> None }

pub fn place_text(place: Place) -> Bytes =
  match place {
    InSource(s) ->
      Bytes::concat_all([
        ascii_of_int(s.module),
        b":",
        ascii_of_int(s.start),
        b":",
        ascii_of_int(s.end),
      ]),
    WholeFile(m) -> ascii_of_int(m).concat(b":file"),
    Unplaced -> b"unplaced",
  }

pub fn mapped_place(place: Place, module: Int, by: (Int) -> Int) -> Place =
  match place {
    InSource(s) -> InSource({ module: module, start: by(s.start), end: by(s.end) }),
    WholeFile(_) -> WholeFile(module),
    Unplaced -> Unplaced,
  }

pub fn in_module(place: Place, module: Int) -> Place =
  match place {
    InSource(s) -> InSource({ ..s, module: module }),
    WholeFile(_) -> WholeFile(module),
    Unplaced -> Unplaced,
  }

pub fn label_at(m: Int, span: Span, primary: Bool, text: Bytes) -> Label =
  { place: place_of(m, span), primary: primary, text: text }

pub fn error_unplaced(code: Bytes, message: Bytes, label: Bytes, notes: List<Bytes>) -> Diagnostic =
  error_with_labels(code, message, [{ place: Unplaced, primary: true, text: label }], notes)

pub fn error_in_file(
  code: Bytes,
  m: Int,
  message: Bytes,
  label: Bytes,
  notes: List<Bytes>,
) -> Diagnostic =
  error_with_labels(code, message, [{ place: WholeFile(m), primary: true, text: label }], notes)

pub fn error_with_labels(
  code: Bytes,
  message: Bytes,
  labels: List<Label>,
  notes: List<Bytes>,
) -> Diagnostic =
  {
    code: code,
    labels: labels,
    text: b"",
    message: message,
    notes_text: notes,
    severity: Error,
    fixes: [],
  }

pub fn with_fix(diagnostic: Diagnostic, title: Bytes, edits: List<Edit>) -> Diagnostic =
  { ..diagnostic, fixes: diagnostic.fixes.push({ title: title, edits: edits, adds: None }) }

pub fn with_added_effects(
  diagnostic: Diagnostic,
  title: Bytes,
  edits: List<Edit>,
  adds: AddedEffects,
) -> Diagnostic =
  { ..diagnostic, fixes: diagnostic.fixes.push({ title: title, edits: edits, adds: Some(adds) }) }

pub fn insertion(m: Int, at: Int, text: Bytes) -> Edit =
  { module: m, start: at, end: at, text: text }

pub fn error_at(
  code: Bytes,
  m: Int,
  span: Span,
  message: Bytes,
  label: Bytes,
  notes: List<Bytes>,
) -> Diagnostic = error_with_labels(code, message, [label_at(m, span, true, label)], notes)

pub fn error_at_and(
  code: Bytes,
  m: Int,
  span: Span,
  message: Bytes,
  label: Bytes,
  m2: Int,
  also: Span,
  also_text: Bytes,
  notes: List<Bytes>,
) -> Diagnostic =
  error_with_labels(
    code,
    message,
    [label_at(m, span, true, label), label_at(m2, also, false, also_text)],
    notes,
  )

pub fn backticked(xs: List<Bytes>, sep: Bytes) -> Bytes / {abort.raise} =
  range(0, xs.len()).fold(b"", |accumulator: Bytes, i: Int| {
    let x = Bytes::concat_all([b"`", xs.get(i), b"`"]);
    if i == 0 { x } else { Bytes::concat_all([accumulator, sep, x]) }
  })

pub fn list_names(xs: List<Bytes>) -> Bytes / {abort.raise} =
  if xs.len() == 0 { b"nothing" } else {
    range(0, xs.len()).fold(b"", |accumulator: Bytes, i: Int| {
      let x = Bytes::concat_all([b"`", xs.get(i), b"`"]);
      if i == 0 { x }
      else { Bytes::concat_all([accumulator, if i + 1 == xs.len() { b" and " } else { b", " }, x]) }
    })
  }

pub fn describe_namespace(namespace: Namespace) -> Bytes =
  match namespace {
    ValueSpace -> b"definition",
    TypeSpace -> b"type",
    EffectSpace -> b"effect",
    SetSpace -> b"effect set",
  }

pub fn namespace_keyword(namespace: Namespace) -> Bytes =
  match namespace {
    ValueSpace -> b"fn",
    TypeSpace -> b"type",
    EffectSpace -> b"effect",
    SetSpace -> b"effect set",
  }

pub fn exported_names(declarations: Declarations) -> List<Bytes> =
  namespaces.fold([], |accumulator: List<Bytes>, namespace: Namespace|
    declarations_in(declarations, namespace).fold(
      accumulator,
      |a: List<Bytes>, declared: Declaration|
        if declared.public { a.push(declared.name) } else { a },
    ))

pub fn declarations_of(parsed: ParsedModule) -> Declarations =
  parsed.module.items.fold(no_declarations, |declarations: Declarations, item: Item|
    match item {
      FunctionItem(f) ->
        declare(
          declarations,
          ValueSpace,
          parsed.name,
          f.name,
          f.visibility,
          constant: f.constant != None,
        ),
      ExternItem(f) -> if is_builtin(parsed.name, parsed.module, f) { declarations }
      else { declare(declarations, ValueSpace, parsed.name, f.name, f.visibility) },
      EffectItem(e) -> declare(declarations, EffectSpace, parsed.name, e.name, e.visibility),
      EffectSetItem(e) -> declare(declarations, SetSpace, parsed.name, e.name, e.visibility),
      TypeItem(t) -> {
        let d2 = declare(
          declarations,
          TypeSpace,
          parsed.name,
          t.name,
          t.visibility,
          match t.opaque { Some(o) -> Some({ type_name: t.name.name, opaque: o }), None -> None },
        );
        match t.body {
          SumBody(vs) ->
            vs.fold(d2, |accumulator: Declarations, variant: VariantDefinition|
              declare(
                accumulator,
                ValueSpace,
                parsed.name,
                variant.name,
                match t.opaque { Some(_) -> Private, None -> t.visibility },
                match t.opaque {
                  Some(o) -> Some({ type_name: t.name.name, opaque: o }),
                  None -> None,
                },
              )),
          AliasBody(_) -> d2,
          NominalBody(_) -> d2,
          ExternBody -> d2,
        }
      },
      _ -> declarations,
    })

pub fn unplaced_declarations(declarations: Declarations) -> Declarations = {
  let unplaced = |d: Declaration|
    {
      ..d,
      span: generated_span,
      closed_by: match d.closed_by {
        Some(c) -> Some({ ..c, opaque: { ..c.opaque, span: generated_span } }),
        None -> None,
      },
    };
  namespaces.fold(no_declarations, |found: Declarations, namespace: Namespace|
    declarations_in(declarations, namespace).fold(found, |d: Declarations, x: Declaration|
      push_declared(d, namespace, unplaced(x))))
}

fn declare(
  declarations: Declarations,
  namespace: Namespace,
  module: Bytes,
  name: Identifier,
  vis: Visibility,
  closed_by: Option<ClosedBy> = None,
  constant: Bool = false,
) -> Declarations =
  match lookup_declared(declarations, namespace, name.name) {
    Some(_) -> declarations,
    None ->
      push_declared(declarations, namespace, {
        name: name.name,
        qualified: qualify(module, name.name),
        public: is_pub(vis),
        span: name.span,
        closed_by: closed_by,
        constant: constant,
      }),
  }

pub fn bindings_of(owner: Bytes, declarations: Declarations) -> Bindings =
  namespaces.fold(no_bindings, |bindings: Bindings, namespace: Namespace|
    with_space_bindings(
      bindings,
      namespace,
      declarations_in(declarations, namespace).map(|declared: Declaration|
        binding_of(declared, owner)),
    ))

pub type ParamInfo = { name: Bytes, default: Option<Expression>, imports: List<ModuleBinding> }

pub type Parameters = { name: Bytes, params: List<ParamInfo> }

derive bin for ParamInfo

derive bin for Parameters

test "a module name prefixes the names of its declarations, and its last segment is the default import name" {
  assert_eq(default_binder(b"std.db"), b"db");
  assert_eq(default_binder(b"app"), b"app");
  assert_eq(qualify(b"store.orders", b"place"), b"store.orders.place");
  assert_eq(qualify(b"", b"place"), b"place");
  assert_eq(module_of_name(b"store.orders.place"), b"store.orders");
  assert_eq(module_of_name(b"std.prelude.List::map"), b"std.prelude");
  assert_eq(module_of_name(b"place"), b"")
}

test "a diagnostic placed in a module moves its labels and the edits of its fixes there" {
  let d = with_fix(
    error_at(b"E0101", 0, span_between(4, 9), b"unknown", b"here", []),
    b"rename",
    [{ module: 0, start: 1, end: 2, text: b"x" }],
  );
  let placed = placed_in(d, 3);
  assert_eq(placed.labels.map(|l: Label| l.place), [InSource({ module: 3, start: 4, end: 9 })]);
  assert_eq(placed.fixes.flat_map(|f: Fix| f.edits.map(|e: Edit| e.module)), [3])
}
