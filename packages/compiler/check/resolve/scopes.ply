import compiler.syntax.parsing (Span, Identifier, QName, dummy_span)
import compiler.syntax.items (Module, Item, is_shipped, TypeItem, SumBody, VariantDefinition,
                              ImportDeclaration, ModuleAlias, SelectedNames, member_name, Opaque)
import compiler.syntax.expressions (implicitly_imported_by)
import std.list
import compiler.check.resolve.tables (ParsedModule, Namespace, TypeSpace, ValueSpace, Declarations,
                                      Binding, Bindings, Scope, Diagnostic, Edge, ModuleEntry,
                                      Resolution, namespaces, push_declared, lookup_declared,
                                      push_binding, lookup, find_module_binding, position,
                                      default_binder, qualify, import_module_name, path_span,
                                      import_binder, binder_span, error_at, error_at_and,
                                      backticked, list_names, describe_namespace, namespace_keyword,
                                      exported_names)

pub type ScopeBuilder = {
  scope: Scope,
  local: Declarations,
  imported: Declarations,
  edges: List<Edge>,
  diagnostics: List<Diagnostic>,
}

pub type ResolutionContext = {
  modules: List<ParsedModule>,
  names: List<ModuleEntry>,
  declarations: List<Declarations>,
  declared: List<Bindings>,
  packages: List<PackageDependencies>,
  module_packages: List<Int>,
  std: Int,
  compiler: Int,
  shipped_package_count: Int,
}

pub type PackageDependencies = { prefix: Bytes, dependencies: List<Bytes> }

pub fn no_packages(
  modules: List<ParsedModule>,
) -> { packages: List<PackageDependencies>, module_packages: List<Int>, std: Int, compiler: Int, other_shipped_package: Int } =
  {
    packages: [{ prefix: b"", dependencies: [] }],
    module_packages: modules.map(|parsed: ParsedModule| 0),
    std: 1,
    compiler: 2,
    other_shipped_package: 3,
  }

pub fn index_of(names: List<ModuleEntry>, name: Bytes) -> Option<Int> =
  names.fold(None, |accumulator: Option<Int>, e: ModuleEntry|
    match accumulator {
      Some(_) -> accumulator,
      None -> if e.name == name { Some(e.at) } else { None },
    })

pub fn bind_import(
  w: ResolutionContext,
  i: Int,
  builder: ScopeBuilder,
  declaration: ImportDeclaration,
) -> ScopeBuilder / {abort.raise} =
  match import_target(w, i, builder, declaration) {
    Found(t) -> {
      let b2: ScopeBuilder = {
        ..builder,
        edges: builder.edges.push({ from: i, target: t, span: path_span(declaration) }),
      };
      match declaration.kind {
        SelectedNames(names) -> {
          let key = default_binder(import_module_name(declaration));
          let sel = match find_module_binding(b2.scope.selected_modules, key) {
            Some(_) -> b2.scope.selected_modules,
            None ->
              b2.scope.selected_modules.push({
                binder: key,
                target: t,
                span: path_span(declaration),
              }),
          };
          let b3: ScopeBuilder = { ..b2, scope: { ..b2.scope, selected_modules: sel } };
          names.fold(b3, |accumulator: ScopeBuilder, identifier: Identifier|
            bind_name(w, i, accumulator, t, identifier))
        },
        ModuleAlias(a) ->
          implicitly_imported_by(a.name).fold(
            bind_module(w, i, b2, declaration, t),
            |accumulator: ScopeBuilder, n: Bytes|
              if namespaces.any(|namespace: Namespace|
                    lookup(accumulator.scope.bound, namespace, n) != None)
                  || !namespaces.any(|namespace: Namespace|
                    lookup_declared(w.declarations.get(t), namespace, n) != None) { accumulator }
              else { bind_name(w, i, accumulator, t, { name: n, span: path_span(declaration) }) },
          ),
        _ -> bind_module(w, i, b2, declaration, t),
      }
    },
    _ -> builder,
  }

type ImportTarget = | Found(Int) | Missing | Undeclared({ importer: Int, owning_package: Int })

fn import_target(
  w: ResolutionContext,
  i: Int,
  builder: ScopeBuilder,
  declaration: ImportDeclaration,
) -> ImportTarget / {abort.raise} = {
  let name = import_module_name(declaration);
  if name.len() == 0 { Missing } else {
    let p = w.module_packages.get(i);
    if 0 < p && p < w.shipped_package_count && p < w.packages.len() && name.index_of(b".") == None {
      sibling(w, i, name)
    } else {
      match sibling(w, i, name) {
        Found(t) -> Found(t),
        _ -> match index_of(w.names, name) {
          Some(t) -> if w.modules.get(t).name.len() == 0 { Missing }
          else { allowed_target(w, i, t) },
          None -> Missing,
        },
      }
    }
  }
}

fn sibling(w: ResolutionContext, i: Int, name: Bytes) -> ImportTarget / {abort.raise} = {
  let p = w.module_packages.get(i);
  if p == 0 || p >= w.shipped_package_count || p >= w.packages.len() { Missing } else {
    let prefix = w.packages.get(p).prefix;
    if name.starts_with(prefix.concat(b".")) { Missing } else {
      match index_of(w.names, Bytes::concat_all([prefix, b".", name])) {
        Some(t) -> if w.modules.get(t).name.len() == 0 { Missing } else { Found(t) },
        None -> Missing,
      }
    }
  }
}

fn allowed_target(w: ResolutionContext, i: Int, t: Int) -> ImportTarget / {abort.raise} = {
  let p = w.module_packages.get(i);
  let q = w.module_packages.get(t);
  if q == p || q == w.std || q == w.compiler || q >= w.shipped_package_count
      || p >= w.shipped_package_count { Found(t) } else {
    let prefix = w.packages.get(q).prefix;
    if w.packages.get(p).dependencies.contains(prefix) { Found(t) }
    else { Undeclared({ importer: p, owning_package: q }) }
  }
}

fn internal_import(w: ResolutionContext, i: Int, t: Int) -> Bool / {abort.raise} = {
  let module_name = w.modules.get(t).name;
  (module_name == b"std.internal" || module_name.starts_with(b"std.internal."))
    && !is_shipped(w.modules.get(i).name)
}

pub fn target_or_report(
  w: ResolutionContext,
  i: Int,
  builder: ScopeBuilder,
  declaration: ImportDeclaration,
) -> { b: ScopeBuilder, t: Option<Int> } / {abort.raise} =
  match import_target(w, i, builder, declaration) {
    Found(t) -> if internal_import(w, i, t) {
      {
        b: {
          ..builder,
          diagnostics: builder.diagnostics.push(
            error_at(
              b"E0159",
              i,
              path_span(declaration),
              Bytes::concat_all([
                b"`",
                w.modules.get(t).name,
                b"` is internal to the toolchain, and only the modules that ship with it can import it",
              ]),
              b"not importable here",
              [
                b"a module below `std.internal` contains code the standard library shares between its own modules, not code it offers to programs",
              ],
            ),
          ),
        },
        t: None,
      }
    } else { { b: builder, t: Some(t) } },
    Undeclared(u) -> {
      let name = import_module_name(declaration);
      let message = if u.owning_package == 0 {
        Bytes::concat_all([
          b"`",
          name,
          b"` belongs to the package being loaded; a dependency may not reach back into it",
        ])
      } else {
        Bytes::concat_all([
          b"`",
          name,
          b"` belongs to the package `",
          w.packages.get(u.owning_package).prefix,
          b"`, which `",
          w.packages.get(u.importer).prefix,
          b"` does not declare as a dependency",
        ])
      };
      {
        b: {
          ..builder,
          diagnostics: builder.diagnostics.push(
            error_at(b"E0132", i, path_span(declaration), message, b"not a declared dependency", [
              b"add it to that package's ply.pkg dependencies to import it",
            ]),
          ),
        },
        t: None,
      }
    },
    Missing -> {
      let name = import_module_name(declaration);
      let near = w.names.fold([], |accumulator: List<Bytes>, e: ModuleEntry|
        if e.name.len() > 0 && e.name.ends_with(default_binder(name)) { accumulator.push(e.name) }
        else { accumulator });
      let note = if near.len() == 0 {
        b"a module is a file: `store/orders.ply` is `store.orders`, relative to the project root"
      } else { b"modules with that last segment: ".concat(backticked(near, b", ")) };
      {
        b: {
          ..builder,
          diagnostics: builder.diagnostics.push(
            error_at(
              b"E0106",
              i,
              path_span(declaration),
              Bytes::concat_all([b"no module named `", name, b"` in this program"]),
              b"not found",
              [note],
            ),
          ),
        },
        t: None,
      }
    },
  }

fn bind_module(
  w: ResolutionContext,
  i: Int,
  builder: ScopeBuilder,
  declaration: ImportDeclaration,
  t: Int,
) -> ScopeBuilder / {abort.raise} =
  match import_binder(declaration) {
    None -> builder,
    Some(binder) -> {
      let s = binder_span(declaration);
      match find_module_binding(builder.scope.modules, binder) {
        Some(first) -> {
          let name = import_module_name(declaration);
          {
            ..builder,
            diagnostics: builder.diagnostics.push(
              error_at_and(
                b"E0110",
                i,
                s,
                Bytes::concat_all([b"two imports bind the module name `", binder, b"`"]),
                Bytes::concat_all([b"`", name, b"` would also be `", binder, b"`"]),
                i,
                first.span,
                Bytes::concat_all([
                  b"`",
                  w.modules.get(first.target).name,
                  b"` is already bound as `",
                  binder,
                  b"`",
                ]),
                [Bytes::concat_all([b"rename one of them: `import ", name, b" as <other>`"])],
              ),
            ),
          }
        },
        None ->
          {
            ..builder,
            scope: {
              ..builder.scope,
              modules: builder.scope.modules.push({ binder: binder, target: t, span: s }),
            },
          },
      }
    },
  }

fn bind_name(
  w: ResolutionContext,
  i: Int,
  builder: ScopeBuilder,
  t: Int,
  name: Identifier,
) -> ScopeBuilder / {abort.raise} = {
  let declarations = w.declarations.get(t);
  let module = w.modules.get(t).name;
  let found = namespaces.filter(|namespace: Namespace|
    match lookup_declared(declarations, namespace, name.name) { Some(_) -> true, None -> false });
  if found.len() == 0 {
    let exported = exported_names(declarations);
    let note = if exported.len() == 0 {
      Bytes::concat_all([b"`", module, b"` exports nothing; mark an item `pub` to export it"])
    } else { Bytes::concat_all([b"`", module, b"` exports: ", backticked(exported, b", ")]) };
    {
      ..builder,
      diagnostics: builder.diagnostics.push(
        error_at(
          b"E0101",
          i,
          name.span,
          Bytes::concat_all([b"module `", module, b"` declares no `", name.name, b"`"]),
          Bytes::concat_all([b"not found in `", module, b"`"]),
          [note],
        ),
      ),
    }
  } else {
    let public = found.filter(|namespace: Namespace|
      match lookup_declared(declarations, namespace, name.name) {
        Some(x) -> x.public,
        None -> false,
      });
    if public.len() == 0 {
      let allowed_target = match lookup_declared(declarations, found.get(0), name.name) {
        Some(x) -> x,
        None -> panic("just found"),
      };
      {
        ..builder,
        diagnostics: builder.diagnostics.push(
          match opaque_constructor_error(w.modules, i, name.span, t, name.name) {
            Some(closed) -> closed,
            None ->
              private_name_error(
                i,
                name.span,
                t,
                allowed_target.span,
                found.get(0),
                name.name,
                module,
              ),
          },
        ),
      }
    } else {
      public.fold(builder, |accumulator: ScopeBuilder, namespace: Namespace|
        bind_one(w, i, accumulator, t, name, namespace))
    }
  }
}

pub fn private_name_error(
  m: Int,
  span: Span,
  owner: Int,
  allowed_target: Span,
  namespace: Namespace,
  name: Bytes,
  module: Bytes,
) -> Diagnostic =
  error_at_and(
    b"E0107",
    m,
    span,
    Bytes::concat_all([b"`", name, b"` is private to module `", module, b"`"]),
    b"not exported",
    owner,
    allowed_target,
    b"declared here, without `pub`",
    [
      Bytes::concat_all([
        b"write `pub ",
        namespace_keyword(namespace),
        b" ",
        name,
        b"` in `",
        module,
        b"` to export it",
      ]),
      b"items are private by default",
    ],
  )

pub fn opaque_notes(module: Bytes, opaque: Opaque) -> List<Bytes> / {abort.raise} = {
  let returned = if opaque.result.len() == 0 { [] } else {
    [
      Bytes::concat_all([
        b"`",
        module,
        b"` returns values of this type from ",
        list_names(opaque.result),
      ]),
    ]
  };
  if opaque.take.len() == 0 {
    if returned.len() > 0 { returned } else {
      [
        Bytes::concat_all([
          b"`",
          module,
          b"` has no function that returns or takes a value of this type",
        ]),
      ]
    }
  } else {
    returned.push(
      Bytes::concat_all([
        b"`",
        module,
        b"` takes values of this type in ",
        list_names(opaque.take),
      ]),
    )
  }
}

fn opaque_sum(module: Module, name: Bytes) -> Option<{ name: Bytes, opaque: Opaque }> =
  module.items.fold(None, |found: Option<{ name: Bytes, opaque: Opaque }>, item: Item|
    match found {
      Some(_) -> found,
      None -> match item {
        TypeItem(d) -> match ((d.opaque, d.body)) {
          (Some(o), SumBody(vs)) -> if vs.fold(false, |has_variant: Bool, v: VariantDefinition|
              has_variant || v.name.name == name) { Some({ name: d.name.name, opaque: o }) }
          else { None },
          _ -> None,
        },
        _ -> None,
      },
    })

pub fn opaque_constructor_error(
  modules: List<ParsedModule>,
  m: Int,
  span: Span,
  owner: Int,
  name: Bytes,
) -> Option<Diagnostic> / {abort.raise} = {
  let parsed = modules.get(owner);
  match opaque_sum(parsed.module, name) {
    None -> None,
    Some(closed) ->
      Some(
        error_at_and(
          b"E0107",
          m,
          span,
          Bytes::concat_all([
            b"`",
            name,
            b"` is a constructor of the opaque type `",
            qualify(parsed.name, closed.name),
            b"`",
          ]),
          Bytes::concat_all([b"only `", parsed.name, b"` can build or match values of this type"]),
          owner,
          closed.opaque.span,
          b"declared `opaque` here",
          opaque_notes(parsed.name, closed.opaque),
        ),
      ),
  }
}

fn bind_one(
  w: ResolutionContext,
  i: Int,
  builder: ScopeBuilder,
  t: Int,
  name: Identifier,
  namespace: Namespace,
) -> ScopeBuilder / {abort.raise} = {
  let binding = match lookup(w.declared.get(t), namespace, name.name) {
    Some(x) -> x,
    None -> panic("a public declaration always has a binding"),
  };
  let module = w.modules.get(t).name;
  match lookup_declared(builder.local, namespace, name.name) {
    Some(local_definition) ->
      {
        ..builder,
        diagnostics: builder.diagnostics.push(
          error_at_and(
            b"E0108",
            i,
            name.span,
            Bytes::concat_all([
              b"the ",
              describe_namespace(namespace),
              b" `",
              name.name,
              b"` is both imported and defined in `",
              builder.scope.module,
              b"`",
            ]),
            Bytes::concat_all([b"imported from `", module, b"` here"]),
            i,
            local_definition.span,
            Bytes::concat_all([b"`", name.name, b"` is also defined here"]),
            [
              Bytes::concat_all([
                b"remove the name from the import list, write `import ",
                module,
                b"`, then `",
                default_binder(module),
                b"::",
                name.name,
                b"` where you mean the imported definition",
              ]),
              b"neither definition wins silently, because a call site would then change which definition it calls",
            ],
          ),
        ),
      },
    None -> match lookup_declared(builder.imported, namespace, name.name) {
      Some(earlier_import) ->
        {
          ..builder,
          diagnostics: builder.diagnostics.push(
            error_at_and(
              b"E0110",
              i,
              name.span,
              Bytes::concat_all([
                b"the ",
                describe_namespace(namespace),
                b" `",
                name.name,
                b"` is imported twice",
              ]),
              b"imported again here",
              i,
              earlier_import.span,
              b"first imported here",
              [
                Bytes::concat_all([
                  b"remove one import, or import the module and write `<module>::",
                  name.name,
                  b"`",
                ]),
              ],
            ),
          ),
        },
      None -> {
        let imported = push_declared(builder.imported, namespace, {
          name: name.name,
          qualified: binding.qualified,
          public: true,
          span: name.span,
        });
        let bound = push_binding(builder.scope.bound, namespace, {
          name: name.name,
          qualified: binding.qualified,
          owner: t,
          span: name.span,
        });
        { ..builder, imported: imported, scope: { ..builder.scope, bound: bound } }
      },
    },
  }
}

pub type Cycle = { nodes: List<Int>, closing: Edge }

type OrderSearch = {
  color: List<Int>,
  order: List<Int>,
  cycles: List<Cycle>,
  found: List<List<Int>>,
  path: List<Int>,
  stack: List<{ v: Int, edge: Int }>,
}

pub fn traverse(edges: List<List<Edge>>) -> OrderSearch / {abort.raise} = {
  let n = edges.len();
  let steps = edges.fold(0, |accumulator: Int, es: List<Edge>| accumulator + es.len());
  let start = {
    color: range(0, n).map(|i: Int| 0),
    order: [],
    cycles: [],
    found: [],
    path: [],
    stack: [],
  };
  range(0, n).fold(start, |s: OrderSearch, root: Int|
    if s.color.get(root) != 0 { s } else {
      let opened: OrderSearch = {
        ..s,
        color: s.color.set(root, 1),
        path: s.path.push(root),
        stack: [{ v: root, edge: 0 }],
      };
      iterate(opened, 2 * (n + steps) + 4, |d: OrderSearch|
        if d.stack.len() == 0 { Stop(d) } else { Continue(order_step(edges, d)) })
    })
}

pub fn post_order(targets: List<List<Int>>) -> List<Int> / {abort.raise} =
  traverse(
    range(0, targets.len()).map(|i: Int|
      targets.get(i).map(|t: Int| { from: i, target: t, span: dummy_span })),
  ).order

fn order_step(edges: List<List<Edge>>, d: OrderSearch) -> OrderSearch / {abort.raise} = {
  let top = d.stack.get(d.stack.len() - 1);
  let popped = range(0, d.stack.len() - 1).map(|i: Int| d.stack.get(i));
  let out = edges.get(top.v);
  if top.edge < out.len() {
    let again = popped.push({ v: top.v, edge: top.edge + 1 });
    let e = out.get(top.edge);
    let w = e.target;
    let c = d.color.get(w);
    if c == 0 {
      { ..d, stack: again.push({ v: w, edge: 0 }), color: d.color.set(w, 1), path: d.path.push(w) }
    } else if c == 1 {
      let st = match position(d.path, w) { Some(p) -> p, None -> 0 };
      let nodes = d.path.drop(st);
      let key = canonical(nodes);
      if contains_key(d.found, key) { { ..d, stack: again } } else {
        {
          ..d,
          stack: again,
          found: d.found.push(key),
          cycles: d.cycles.push({ nodes: nodes, closing: e }),
        }
      }
    } else { { ..d, stack: again } }
  } else {
    {
      ..d,
      stack: popped,
      color: d.color.set(top.v, 2),
      path: d.path.take(d.path.len() - 1),
      order: d.order.push(top.v),
    }
  }
}

fn contains_key(keys: List<List<Int>>, key: List<Int>) -> Bool =
  keys.fold(false, |accumulator: Bool, k: List<Int>| accumulator || k == key)

fn canonical(nodes: List<Int>) -> List<Int> / {abort.raise} =
  if nodes.len() == 0 { [] } else {
    let least = range(0, nodes.len()).fold(0, |best: Int, i: Int|
      if nodes.get(i) < nodes.get(best) { i } else { best });
    range(0, nodes.len()).map(|i: Int| nodes.get((least + i) % nodes.len()))
  }

pub fn cycle_diagnostic(modules: List<ParsedModule>, cycle: Cycle) -> Diagnostic / {abort.raise} = {
  let names = cycle.nodes.map(|i: Int| modules.get(i).name);
  let first = if names.len() == 0 { b"" } else { names.get(0) };
  if cycle.nodes.len() == 1 {
    error_at(
      b"E0109",
      cycle.closing.from,
      cycle.closing.span,
      Bytes::concat_all([b"module `", first, b"` imports itself"]),
      b"a module cannot import itself",
      [b"every name a module declares is already in scope in its own file"],
    )
  } else {
    error_at(
      b"E0109",
      cycle.closing.from,
      cycle.closing.span,
      Bytes::concat_all([b"module cycle: ", backticked(names, b" -> "), b" -> `", first, b"`"]),
      b"this import closes the cycle",
      [
        b"each of these has to be checked before the next, and the last before the first, so there is no order to check them in",
        b"move what they share into a module that all of them import",
      ],
    )
  }
}

pub fn find(
  resolved: Resolution,
  module: Int,
  namespace: Namespace,
  qualified_name: QName,
) -> Option<Binding> / {abort.raise} = {
  let scope = resolved.scopes.get(module);
  match qualified_name.module {
    None -> lookup(scope.bound, namespace, qualified_name.name.name),
    Some(binder) -> match find_module_binding(scope.modules, binder.name) {
      None -> match namespace {
        ValueSpace -> match method_binder_module(binder.name) {
          Some(home) -> find_in_module(resolved, module, home, qualified_name.name.name),
          None -> find_method(resolved, module, binder.name, qualified_name.name.name),
        },
        _ -> None,
      },
      Some(mb) -> match lookup_declared(
          resolved.declarations.get(mb.target),
          namespace,
          qualified_name.name.name,
        ) {
        None -> None,
        Some(d) -> if !d.public && mb.target != module { None }
        else { lookup(resolved.declared.get(mb.target), namespace, qualified_name.name.name) },
      },
    },
  }
}

pub fn method_binder(home: Bytes) -> Bytes = b"?of.".concat(home)

pub fn method_binder_module(binder: Bytes) -> Option<Bytes> =
  if binder.len() > 4 && binder.slice(0, 4) == b"?of." { Some(binder.slice(4, binder.len())) }
  else { None }

fn find_in_module(
  resolved: Resolution,
  module: Int,
  home: Bytes,
  name: Bytes,
) -> Option<Binding> / {abort.raise} =
  range(0, resolved.scopes.len()).fold(None, |found: Option<Binding>, k: Int|
    match found {
      Some(_) -> found,
      None -> if resolved.scopes.get(k).module != home { None } else {
        match lookup_declared(resolved.declarations.get(k), ValueSpace, name) {
          None -> None,
          Some(d) -> if !d.public && k != module { None }
          else { lookup(resolved.declared.get(k), ValueSpace, name) },
        }
      },
    })

pub fn find_method(
  resolved: Resolution,
  module: Int,
  of: Bytes,
  name: Bytes,
) -> Option<Binding> / {abort.raise} =
  match locate_type(resolved, module, of) {
    None -> None,
    Some(t) -> {
      let member = member_name(t.simple, name);
      match lookup_declared(resolved.declarations.get(t.owner), ValueSpace, member) {
        None -> None,
        Some(d) -> if !d.public && t.owner != module { None }
        else { lookup(resolved.declared.get(t.owner), ValueSpace, member) },
      }
    },
  }

pub fn locate_type(
  resolved: Resolution,
  module: Int,
  of: Bytes,
) -> Option<{ owner: Int, simple: Bytes }> / {abort.raise} = {
  let split = |qualified: Bytes|
    range(0, qualified.len()).fold(None, |last: Option<Int>, i: Int|
      if qualified.at(i) == 46 { Some(i) } else { last });
  match lookup(resolved.scopes.get(module).bound, TypeSpace, of) {
    Some(b) ->
      Some({
        owner: b.owner,
        simple: match split(b.qualified) {
          Some(i) -> b.qualified.slice(i + 1, b.qualified.len()),
          None -> b.qualified,
        },
      }),
    None -> match split(of) {
      None -> None,
      Some(i) -> {
        let home = of.slice(0, i);
        range(0, resolved.scopes.len()).fold(
          None,
          |found: Option<{ owner: Int, simple: Bytes }>, k: Int|
            match found {
              Some(_) -> found,
              None -> if resolved.scopes.get(k).module == home {
                Some({ owner: k, simple: of.slice(i + 1, of.len()) })
              } else { None },
            },
        )
      },
    },
  }
}

test "`canonical` rotates a cycle to start at its smallest index, whichever node the traversal started from" {
  assert_eq(canonical([2, 0, 1]), [0, 1, 2]);
  assert_eq(canonical([1, 2]), [1, 2]);
  assert_eq(canonical([]), [])
}

test "`traverse` returns nodes in dependency-first order and reports each cycle once" {
  let e: Edge = { from: 0, target: 0, span: dummy_span };
  let acyclic = traverse([[{ ..e, from: 0, target: 1 }], [{ ..e, from: 1, target: 2 }], [], []]);
  assert_eq(acyclic.order, [2, 1, 0, 3]);
  assert_eq(acyclic.cycles.len(), 0);
  let ring = traverse([[{ ..e, from: 0, target: 1 }], [{ ..e, from: 1, target: 0 }]]);
  assert_eq(ring.cycles.len(), 1);
  assert_eq(ring.cycles.get(0).closing.from, 1)
}
