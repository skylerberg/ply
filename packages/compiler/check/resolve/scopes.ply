import compiler.codes (unknown_name_code)
import compiler.syntax.parsing (Span, Identifier, QName, generated_span)
import compiler.syntax.items (is_explicit_import, Module, Item, is_shipped, is_std, TypeItem,
                              SumBody, VariantDefinition, ImportDeclaration, ModuleAlias,
                              SelectedNames, member_name, Opaque)
import compiler.syntax.expressions (implicitly_imported_by)
import std.list
import compiler.check.resolve.tables (no_declarations, module_elsewhere, other_modules, declared_in,
                                      bound_in, module_binding_in, binding_of, ParsedModule,
                                      Namespace, TypeSpace, ValueSpace, Declaration, Declarations,
                                      Binding, Bindings, Scope, Diagnostic, Edge, ModuleEntry,
                                      Resolution, namespaces, push_declared, lookup_declared,
                                      push_binding, lookup, find_module_binding, position,
                                      default_binder, qualify, import_module_name, path_span,
                                      import_binder, binder_span, error_at, error_at_and,
                                      backticked, list_names, describe_namespace, namespace_keyword,
                                      exported_names)

pub type ImportEdge = { target: Bytes, span: Span }

pub type ScopeBuilder = {
  scope: Scope,
  imported: Declarations,
  edges: List<ImportEdge>,
  diagnostics: List<Diagnostic>,
}

pub type ImportContext = {
  at: Int,
  package: Int,
  packages: List<PackageDependencies>,
  std: Int,
  compiler: Int,
  shipped_package_count: Int,
  places: Map<Bytes, Int>,
}

pub type PackageDependencies = { prefix: Bytes, dependencies: List<Bytes> }

pub fn no_packages(
  modules: List<ParsedModule>,
) -> { packages: List<PackageDependencies>, module_packages: List<Int>, std: Int, compiler: Int, other_shipped_package: Int } =
  {
    packages: [{ prefix: b"", dependencies: [] }],
    module_packages: modules.map(|parsed: ParsedModule| 0),
    std: 1,
    compiler: 2,
    other_shipped_package: 3,
  }

pub fn index_of(names: List<ModuleEntry>, name: Bytes) -> Option<Int> =
  names.fold(None, |accumulator: Option<Int>, e: ModuleEntry|
    match accumulator {
      Some(_) -> accumulator,
      None -> if e.name == name { Some(e.at) } else { None },
    })

pub fn module_scope(
  own: ParsedModule,
  bound: Bindings,
  w: ImportContext,
) -> ScopeBuilder / {abort.raise, other_modules.read} =
  own.module.imports.fold(
    {
      scope: { module: own.name, modules: [], selected_modules: [], bound: bound, failed: [] },
      imported: no_declarations,
      edges: [],
      diagnostics: [],
    },
    |builder: ScopeBuilder, declaration: ImportDeclaration| bind_import(w, builder, declaration),
  )

fn place_of(w: ImportContext, module: Bytes) -> Int =
  match w.places.get(module) { Some(i) -> i, None -> module_elsewhere }

fn bind_found(
  w: ImportContext,
  builder: ScopeBuilder,
  declaration: ImportDeclaration,
  target: Bytes,
) -> ScopeBuilder / {abort.raise, other_modules.read} = {
  let b2: ScopeBuilder = {
    ..builder,
    edges: builder.edges.push({ target: target, span: path_span(declaration) }),
  };
  match declaration.kind {
    SelectedNames(names) -> {
      let key = default_binder(import_module_name(declaration));
      let sel = match find_module_binding(b2.scope.selected_modules, key) {
        Some(_) -> b2.scope.selected_modules,
        None ->
          b2.scope.selected_modules.push({
            binder: key,
            target: target,
            span: path_span(declaration),
          }),
      };
      let b3: ScopeBuilder = { ..b2, scope: { ..b2.scope, selected_modules: sel } };
      names.fold(b3, |accumulator: ScopeBuilder, identifier: Identifier|
        bind_name(w, accumulator, target, identifier))
    },
    ModuleAlias(a) ->
      implicitly_imported_by(a.name).fold(
        bind_module(w, b2, declaration, target),
        |accumulator: ScopeBuilder, n: Bytes|
          if namespaces.any(|namespace: Namespace|
                bound_in(accumulator.scope, namespace, n) != None)
              || !namespaces.any(|namespace: Namespace|
                other_modules.look_up_declaration(target, namespace, n) != None) { accumulator }
          else { bind_name(w, accumulator, target, { name: n, span: path_span(declaration) }) },
      ),
    _ -> bind_module(w, b2, declaration, target),
  }
}

type ImportTarget = | Found(Bytes) | Missing | Undeclared({ importer: Int, owning_package: Int })

fn import_target(
  w: ImportContext,
  name: Bytes,
) -> ImportTarget / {abort.raise, other_modules.read} =
  if name.len() == 0 { Missing } else {
    let p = w.package;
    if 0 < p && p < w.shipped_package_count && p < w.packages.len() && name.index_of(b".") == None {
      sibling(w, name)
    } else {
      match sibling(w, name) {
        Found(t) -> Found(t),
        _ -> match other_modules.look_up_package(name) {
          Some(q) -> allowed_target(w, name, q),
          None -> Missing,
        },
      }
    }
  }

fn sibling(w: ImportContext, name: Bytes) -> ImportTarget / {abort.raise, other_modules.read} = {
  let p = w.package;
  if p == 0 || p >= w.shipped_package_count || p >= w.packages.len() { Missing } else {
    let prefix = w.packages.get(p).prefix;
    if name.starts_with(prefix.concat(b".")) { Missing } else {
      let full = Bytes::concat_all([prefix, b".", name]);
      match other_modules.look_up_package(full) { Some(_) -> Found(full), None -> Missing }
    }
  }
}

fn allowed_target(w: ImportContext, name: Bytes, q: Int) -> ImportTarget / {abort.raise} = {
  let p = w.package;
  if q == p || q == w.std || q == w.compiler || q >= w.shipped_package_count
      || p >= w.shipped_package_count { Found(name) } else {
    let prefix = w.packages.get(q).prefix;
    if w.packages.get(p).dependencies.contains(prefix) { Found(name) }
    else { Undeclared({ importer: p, owning_package: q }) }
  }
}

fn internal_import(importer: Bytes, target: Bytes) -> Bool =
  (target == b"std.internal" || target.starts_with(b"std.internal.")) && !is_shipped(importer)

fn reported(builder: ScopeBuilder, diagnostic: Diagnostic) -> ScopeBuilder =
  { ..builder, diagnostics: builder.diagnostics.push(diagnostic) }

fn failed_import(
  builder: ScopeBuilder,
  declaration: ImportDeclaration,
  diagnostic: Diagnostic,
) -> ScopeBuilder / {abort.raise} = {
  let names = match declaration.kind {
    SelectedNames(selected) -> selected.map(|n: Identifier| n.name),
    _ -> match import_binder(declaration) { Some(binder) -> [binder], None -> [] },
  };
  let reporting = reported(builder, diagnostic);
  { ..reporting, scope: { ..reporting.scope, failed: reporting.scope.failed.concat(names) } }
}

fn failed_name(builder: ScopeBuilder, name: Identifier, diagnostic: Diagnostic) -> ScopeBuilder = {
  let reporting = reported(builder, diagnostic);
  { ..reporting, scope: { ..reporting.scope, failed: reporting.scope.failed.push(name.name) } }
}

fn bind_import(
  w: ImportContext,
  builder: ScopeBuilder,
  declaration: ImportDeclaration,
) -> ScopeBuilder / {abort.raise, other_modules.read} =
  match import_target(w, import_module_name(declaration)) {
    Found(target) -> if internal_import(builder.scope.module, target) {
      failed_import(
        builder,
        declaration,
        error_at(
          b"E0159",
          w.at,
          path_span(declaration),
          Bytes::concat_all([
            b"`",
            target,
            b"` is internal to the toolchain, and only the modules that ship with it can import it",
          ]),
          b"not importable here",
          [
            b"a module below `std.internal` contains code the standard library shares between its own modules, not code it offers to programs",
          ],
        ),
      )
    } else { bind_found(w, builder, declaration, target) },
    Undeclared(u) -> {
      let name = import_module_name(declaration);
      let message = if u.owning_package == 0 {
        Bytes::concat_all([
          b"`",
          name,
          b"` belongs to the package being loaded; a dependency may not reach back into it",
        ])
      } else {
        Bytes::concat_all([
          b"`",
          name,
          b"` belongs to the package `",
          w.packages.get(u.owning_package).prefix,
          b"`, which `",
          w.packages.get(u.importer).prefix,
          b"` does not declare as a dependency",
        ])
      };
      failed_import(
        builder,
        declaration,
        error_at(b"E0132", w.at, path_span(declaration), message, b"not a declared dependency", [
          b"add it to that package's ply.pkg dependencies to import it",
        ]),
      )
    },
    Missing -> if !is_explicit_import(declaration) { builder }
    else if is_shipped(import_module_name(declaration)) {
      failed_import(
        builder,
        declaration,
        unknown_shipped(
          w.at,
          path_span(declaration),
          import_module_name(declaration),
          other_modules.list_shipped_modules(),
        ),
      )
    } else {
      let name = import_module_name(declaration);
      let near = other_modules.list_modules().filter(|known: Bytes|
        known.len() > 0 && known.ends_with(default_binder(name)));
      let note = if near.len() == 0 {
        b"a module is a file: `store/orders.ply` is `store.orders`, relative to the project root"
      } else { b"modules with that last segment: ".concat(backticked(near, b", ")) };
      failed_import(
        builder,
        declaration,
        error_at(
          b"E0106",
          w.at,
          path_span(declaration),
          Bytes::concat_all([b"no module named `", name, b"` in this program"]),
          b"not found",
          [note],
        ),
      )
    },
  }

pub fn unknown_shipped(
  m: Int,
  span: Span,
  name: Bytes,
  listed: List<Bytes>,
) -> Diagnostic / {abort.raise} =
  error_at(
    b"E0106",
    m,
    span,
    Bytes::concat_all([b"no module named `", name, b"` ships with this compiler"]),
    b"not found",
    [
      b"the standard library contains: ".concat(backticked(listed.filter(is_std), b", ")),
      b"`ply std` lists them with the hash of the library sources this binary was built from",
    ],
  )

fn bind_module(
  w: ImportContext,
  builder: ScopeBuilder,
  declaration: ImportDeclaration,
  target: Bytes,
) -> ScopeBuilder / {abort.raise} =
  match import_binder(declaration) {
    None -> builder,
    Some(binder) -> {
      let s = binder_span(declaration);
      match find_module_binding(builder.scope.modules, binder) {
        Some(first) -> {
          let name = import_module_name(declaration);
          reported(
            builder,
            error_at_and(
              b"E0110",
              w.at,
              s,
              Bytes::concat_all([b"two imports bind the module name `", binder, b"`"]),
              Bytes::concat_all([b"`", name, b"` would also be `", binder, b"`"]),
              w.at,
              first.span,
              Bytes::concat_all([b"`", first.target, b"` is already bound as `", binder, b"`"]),
              [Bytes::concat_all([b"rename one of them: `import ", name, b" as <other>`"])],
            ),
          )
        },
        None ->
          {
            ..builder,
            scope: {
              ..builder.scope,
              modules: builder.scope.modules.push({ binder: binder, target: target, span: s }),
            },
          },
      }
    },
  }

fn bind_name(
  w: ImportContext,
  builder: ScopeBuilder,
  target: Bytes,
  name: Identifier,
) -> ScopeBuilder / {abort.raise, other_modules.read} = {
  let found = namespaces.filter(|namespace: Namespace|
    other_modules.look_up_declaration(target, namespace, name.name) != None);
  if found.len() == 0 {
    let exported = match other_modules.look_up_declarations(target) {
      Some(d) -> exported_names(d),
      None -> [],
    };
    let note = if exported.len() == 0 {
      Bytes::concat_all([b"`", target, b"` exports nothing; mark an item `pub` to export it"])
    } else { Bytes::concat_all([b"`", target, b"` exports: ", backticked(exported, b", ")]) };
    failed_name(
      builder,
      name,
      error_at(
        unknown_name_code,
        w.at,
        name.span,
        Bytes::concat_all([b"module `", target, b"` declares no `", name.name, b"`"]),
        Bytes::concat_all([b"not found in `", target, b"`"]),
        [note],
      ),
    )
  } else {
    let public = found.filter(|namespace: Namespace|
      match other_modules.look_up_declaration(target, namespace, name.name) {
        Some(x) -> x.public,
        None -> false,
      });
    if public.len() == 0 {
      let private = match other_modules.look_up_declaration(target, found.get(0), name.name) {
        Some(x) -> x,
        None -> panic("just found"),
      };
      failed_name(
        builder,
        name,
        match match other_modules.look_up_declaration(target, ValueSpace, name.name) {
            Some(d) -> opaque_constructor_error(w.at, name.span, place_of(w, target), target, d),
            None -> None,
          } {
          Some(closed) -> closed,
          None ->
            private_name_error(
              w.at,
              name.span,
              place_of(w, target),
              private.span,
              found.get(0),
              name.name,
              target,
            ),
        },
      )
    } else {
      public.fold(builder, |accumulator: ScopeBuilder, namespace: Namespace|
        bind_one(w, accumulator, target, name, namespace))
    }
  }
}

pub fn private_name_error(
  m: Int,
  span: Span,
  owner: Int,
  allowed_target: Span,
  namespace: Namespace,
  name: Bytes,
  module: Bytes,
) -> Diagnostic =
  error_at_and(
    b"E0107",
    m,
    span,
    Bytes::concat_all([b"`", name, b"` is private to module `", module, b"`"]),
    b"not exported",
    owner,
    allowed_target,
    b"declared here, without `pub`",
    [
      Bytes::concat_all([
        b"write `pub ",
        namespace_keyword(namespace),
        b" ",
        name,
        b"` in `",
        module,
        b"` to export it",
      ]),
      b"items are private by default",
    ],
  )

pub fn opaque_notes(module: Bytes, opaque: Opaque) -> List<Bytes> / {abort.raise} = {
  let returned = if opaque.result.len() == 0 { [] } else {
    [
      Bytes::concat_all([
        b"`",
        module,
        b"` returns values of this type from ",
        list_names(opaque.result),
      ]),
    ]
  };
  if opaque.take.len() == 0 {
    if returned.len() > 0 { returned } else {
      [
        Bytes::concat_all([
          b"`",
          module,
          b"` has no function that returns or takes a value of this type",
        ]),
      ]
    }
  } else {
    returned.push(
      Bytes::concat_all([
        b"`",
        module,
        b"` takes values of this type in ",
        list_names(opaque.take),
      ]),
    )
  }
}

pub fn opaque_constructor_error(
  m: Int,
  span: Span,
  owner: Int,
  module: Bytes,
  declared: Declaration,
) -> Option<Diagnostic> / {abort.raise} =
  match declared.closed_by {
    None -> None,
    Some(closed) ->
      Some(
        error_at_and(
          b"E0107",
          m,
          span,
          Bytes::concat_all([
            b"`",
            declared.name,
            b"` is a constructor of the opaque type `",
            qualify(module, closed.type_name),
            b"`",
          ]),
          Bytes::concat_all([b"only `", module, b"` can build or match values of this type"]),
          owner,
          closed.opaque.span,
          b"declared `opaque` here",
          opaque_notes(module, closed.opaque),
        ),
      ),
  }

fn bind_one(
  w: ImportContext,
  builder: ScopeBuilder,
  target: Bytes,
  name: Identifier,
  namespace: Namespace,
) -> ScopeBuilder / {abort.raise, other_modules.read} = {
  let declared = match other_modules.look_up_declaration(target, namespace, name.name) {
    Some(x) -> x,
    None -> panic("a public declaration always has a binding"),
  };
  match other_modules.look_up_declaration(builder.scope.module, namespace, name.name) {
    Some(local_definition) ->
      reported(
        builder,
        error_at_and(
          b"E0108",
          w.at,
          name.span,
          Bytes::concat_all([
            b"the ",
            describe_namespace(namespace),
            b" `",
            name.name,
            b"` is both imported and defined in `",
            builder.scope.module,
            b"`",
          ]),
          Bytes::concat_all([b"imported from `", target, b"` here"]),
          w.at,
          local_definition.span,
          Bytes::concat_all([b"`", name.name, b"` is also defined here"]),
          [
            Bytes::concat_all([
              b"remove the name from the import list, write `import ",
              target,
              b"`, then `",
              default_binder(target),
              b"::",
              name.name,
              b"` where you mean the imported definition",
            ]),
            b"neither definition wins silently, because a call site would then change which definition it calls",
          ],
        ),
      ),
    None -> match lookup_declared(builder.imported, namespace, name.name) {
      Some(earlier_import) ->
        reported(
          builder,
          error_at_and(
            b"E0110",
            w.at,
            name.span,
            Bytes::concat_all([
              b"the ",
              describe_namespace(namespace),
              b" `",
              name.name,
              b"` is imported twice",
            ]),
            b"imported again here",
            w.at,
            earlier_import.span,
            b"first imported here",
            [
              Bytes::concat_all([
                b"remove one import, or import the module and write `<module>::",
                name.name,
                b"`",
              ]),
            ],
          ),
        ),
      None ->
        {
          ..builder,
          imported: push_declared(builder.imported, namespace, {
            name: name.name,
            qualified: declared.qualified,
            public: true,
            span: name.span,
            closed_by: None,
            constant: false,
          }),
          scope: {
            ..builder.scope,
            bound: push_binding(builder.scope.bound, namespace, {
              name: name.name,
              qualified: declared.qualified,
              owner: target,
              span: name.span,
            }),
          },
        },
    },
  }
}

pub type Cycle = { nodes: List<Int>, closing: Edge }

type OrderSearch = {
  color: List<Int>,
  order: List<Int>,
  cycles: List<Cycle>,
  found: List<List<Int>>,
  path: List<Int>,
  stack: List<{ v: Int, edge: Int }>,
}

pub fn traverse(edges: List<List<Edge>>) -> OrderSearch / {abort.raise} = {
  let n = edges.len();
  let steps = edges.fold(0, |accumulator: Int, es: List<Edge>| accumulator + es.len());
  let start = {
    color: range(0, n).map(|i: Int| 0),
    order: [],
    cycles: [],
    found: [],
    path: [],
    stack: [],
  };
  range(0, n).fold(start, |s: OrderSearch, root: Int|
    if s.color.get(root) != 0 { s } else {
      let opened: OrderSearch = {
        ..s,
        color: s.color.set(root, 1),
        path: s.path.push(root),
        stack: [{ v: root, edge: 0 }],
      };
      iterate(opened, 2 * (n + steps) + 4, |d: OrderSearch|
        if d.stack.len() == 0 { Stop(d) } else { Continue(order_step(edges, d)) })
    })
}

pub fn post_order(targets: List<List<Int>>) -> List<Int> / {abort.raise} =
  traverse(
    range(0, targets.len()).map(|i: Int|
      targets.get(i).map(|t: Int| { from: i, target: t, span: generated_span })),
  ).order

fn order_step(edges: List<List<Edge>>, d: OrderSearch) -> OrderSearch / {abort.raise} = {
  let top = d.stack.get(d.stack.len() - 1);
  let popped = range(0, d.stack.len() - 1).map(|i: Int| d.stack.get(i));
  let out = edges.get(top.v);
  if top.edge < out.len() {
    let again = popped.push({ v: top.v, edge: top.edge + 1 });
    let e = out.get(top.edge);
    let w = e.target;
    let c = d.color.get(w);
    if c == 0 {
      { ..d, stack: again.push({ v: w, edge: 0 }), color: d.color.set(w, 1), path: d.path.push(w) }
    } else if c == 1 {
      let st = match position(d.path, w) { Some(p) -> p, None -> 0 };
      let nodes = d.path.drop(st);
      let key = canonical(nodes);
      if contains_key(d.found, key) { { ..d, stack: again } } else {
        {
          ..d,
          stack: again,
          found: d.found.push(key),
          cycles: d.cycles.push({ nodes: nodes, closing: e }),
        }
      }
    } else { { ..d, stack: again } }
  } else {
    {
      ..d,
      stack: popped,
      color: d.color.set(top.v, 2),
      path: d.path.take(d.path.len() - 1),
      order: d.order.push(top.v),
    }
  }
}

fn contains_key(keys: List<List<Int>>, key: List<Int>) -> Bool =
  keys.fold(false, |accumulator: Bool, k: List<Int>| accumulator || k == key)

fn canonical(nodes: List<Int>) -> List<Int> / {abort.raise} =
  if nodes.len() == 0 { [] } else {
    let least = range(0, nodes.len()).fold(0, |best: Int, i: Int|
      if nodes.get(i) < nodes.get(best) { i } else { best });
    range(0, nodes.len()).map(|i: Int| nodes.get((least + i) % nodes.len()))
  }

pub fn cycle_diagnostic(modules: List<ParsedModule>, cycle: Cycle) -> Diagnostic / {abort.raise} = {
  let names = cycle.nodes.map(|i: Int| modules.get(i).name);
  let first = if names.len() == 0 { b"" } else { names.get(0) };
  if cycle.nodes.len() == 1 {
    error_at(
      b"E0109",
      cycle.closing.from,
      cycle.closing.span,
      Bytes::concat_all([b"module `", first, b"` imports itself"]),
      b"a module cannot import itself",
      [b"every name a module declares is already in scope in its own file"],
    )
  } else {
    error_at(
      b"E0109",
      cycle.closing.from,
      cycle.closing.span,
      Bytes::concat_all([b"module cycle: ", backticked(names, b" -> "), b" -> `", first, b"`"]),
      b"this import closes the cycle",
      [
        b"each of these has to be checked before the next, and the last before the first, so there is no order to check them in",
        b"move what they share into a module that all of them import",
      ],
    )
  }
}

pub fn find(
  resolved: Resolution,
  module: Int,
  namespace: Namespace,
  qualified_name: QName,
) -> Option<Binding> / {abort.raise, other_modules.read} = {
  let scope = resolved.scopes.get(module);
  let name = qualified_name.name.name;
  match qualified_name.module {
    None -> bound_in(scope, namespace, name),
    Some(binder) -> match module_binding_in(scope, binder.name) {
      None -> match namespace {
        ValueSpace -> match method_binder_module(binder.name) {
          Some(home) -> find_in_module(resolved, scope, home, namespace, name),
          None -> find_method(resolved, module, binder.name, name),
        },
        _ -> None,
      },
      Some(mb) -> find_in_module(resolved, scope, mb.target, namespace, name),
    },
  }
}

pub fn method_binder(home: Bytes) -> Bytes = b"?of.".concat(home)

pub fn method_binder_module(binder: Bytes) -> Option<Bytes> =
  if binder.len() > 4 && binder.slice(0, 4) == b"?of." { Some(binder.slice(4, binder.len())) }
  else { None }

fn find_in_module(
  resolved: Resolution,
  scope: Scope,
  home: Bytes,
  namespace: Namespace,
  name: Bytes,
) -> Option<Binding> / {other_modules.read} =
  match declared_in(resolved, home, namespace, name) {
    None -> None,
    Some(d) -> if !d.public && home != scope.module { None } else { Some(binding_of(d, home)) },
  }

pub fn find_method(
  resolved: Resolution,
  module: Int,
  of: Bytes,
  name: Bytes,
) -> Option<Binding> / {abort.raise, other_modules.read} =
  match locate_type(resolved, module, of) {
    None -> None,
    Some(t) ->
      find_in_module(
        resolved,
        resolved.scopes.get(module),
        t.owner,
        ValueSpace,
        member_name(t.simple, name),
      ),
  }

pub fn locate_type(
  resolved: Resolution,
  module: Int,
  of: Bytes,
) -> Option<{ owner: Bytes, simple: Bytes }> / {abort.raise, other_modules.read} = {
  let split = |qualified: Bytes|
    range(0, qualified.len()).fold(None, |last: Option<Int>, i: Int|
      if qualified.at(i) == 46 { Some(i) } else { last });
  match bound_in(resolved.scopes.get(module), TypeSpace, of) {
    Some(b) ->
      Some({
        owner: b.owner,
        simple: match split(b.qualified) {
          Some(i) -> b.qualified.slice(i + 1, b.qualified.len()),
          None -> b.qualified,
        },
      }),
    None -> match split(of) {
      None -> None,
      Some(i) -> {
        let home = of.slice(0, i);
        if resolved.positions.contains(home) || other_modules.list_modules().contains(home) {
          Some({ owner: home, simple: of.slice(i + 1, of.len()) })
        } else { None }
      },
    },
  }
}

test "`canonical` rotates a cycle to start at its smallest index, whichever node the traversal started from" {
  assert_eq(canonical([2, 0, 1]), [0, 1, 2]);
  assert_eq(canonical([1, 2]), [1, 2]);
  assert_eq(canonical([]), [])
}

test "`traverse` returns nodes in dependency-first order and reports each cycle once" {
  let e: Edge = { from: 0, target: 0, span: generated_span };
  let acyclic = traverse([[{ ..e, from: 0, target: 1 }], [{ ..e, from: 1, target: 2 }], [], []]);
  assert_eq(acyclic.order, [2, 1, 0, 3]);
  assert_eq(acyclic.cycles.len(), 0);
  let ring = traverse([[{ ..e, from: 0, target: 1 }], [{ ..e, from: 1, target: 0 }]]);
  assert_eq(ring.cycles.len(), 1);
  assert_eq(ring.cycles.get(0).closing.from, 1)
}
