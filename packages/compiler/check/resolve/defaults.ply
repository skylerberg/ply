import compiler.syntax.parsing (Span, Identifier, QName, dummy_span, is_bare, span_to, starts_upper,
                                synthetic_span, synthetic_span_at, role_constant_read,
                                role_member_field, role_member_receiver)
import compiler.syntax.items (Item, FunctionItem, TestItem, LawItem, FnDefinition, SpecClause,
                              Binder, parse, is_pub)
import compiler.syntax.expressions (Expression, LiteralExpression, NameExpression, BinaryExpression,
                                    UnaryExpression, LambdaExpression, CallExpression, IfExpression,
                                    MatchExpression, BlockExpression, RecordExpression,
                                    RecordUpdateExpression, PropagateExpression, FieldExpression,
                                    ListExpression, PerformExpression, HandleExpression,
                                    WithScopeExpression, SimulateExpression, ParallelExpression,
                                    InvalidExpression, HoleExpression, TryBlockExpression,
                                    Statement, LetStatement, LetElseStatement, ExpressionStatement,
                                    AssignmentStatement, Param, NamedArg, MatchArm, HandleClause,
                                    ReturnClause, HandlerStateVariable, RecordLiteralField,
                                    expression_span, TaggedLiteralExpression, Hole, home_modules,
                                    sees_homes)
import compiler.syntax.calls (slotted, ordered_arguments, Slot, FromDefault, UnmatchedReason,
                              NoSuchParameter, FilledByPosition)
import std.list
import compiler.check.known (none_constructor)
import compiler.check.resolve.tables (ParsedModule, ValueSpace, EffectSpace, ModuleBinding, Scope,
                                      Diagnostic, Resolution, lookup_declared, find_module_binding,
                                      qualify, error_at, list_names, ParamInfo, Parameters)
import compiler.check.resolve.scopes (find, method_binder)
import compiler.check.resolve.sets (add_module_binding, concat_diagnostics)
import compiler.check.resolve.bindings (item_binders)

type Qualifier = {
  owner: Int,
  public: Bool,
  binders: Map<Int, Int>,
  params: List<Int>,
  imports: List<ModuleBinding>,
  diagnostics: List<Diagnostic>,
  rejected: Bool,
  constants: Map<Bytes, Bool>,
}

fn rejected(qualifier: Qualifier, span: Span) -> Qualifier =
  {
    ..qualifier,
    rejected: true,
    diagnostics: qualifier.diagnostics.push(
      error_at(
        b"E0121",
        qualifier.owner,
        span,
        b"a parameter default must be a pure constant value, not a computation",
        b"this expression runs code instead of being a plain value",
        [
          b"the default is copied into every call that omits the argument, so a call or a `perform` in it would run at the caller, not where the default is written",
          b"a literal, a `const`, a constructor applied to these, a record or a list is fine",
        ],
      ),
    ),
  }

fn constant_read(span: Span, name: QName) -> Expression =
  CallExpression({
    span: synthetic_span(span, role_constant_read()),
    function: NameExpression({ span: span, name: name }),
    named: [],
    args: [],
    labels: [],
  })

fn names_constant(
  r: Resolution,
  constants: Map<Bytes, Bool>,
  module: Int,
  name: QName,
) -> Bool / {abort.raise} =
  match find(r, module, ValueSpace, name) {
    Some(b) -> constants.contains(b.qualified),
    None -> false,
  }

type QualifyResult = { q: Qualifier, e: Expression }

fn qualify_expression(
  resolved: Resolution,
  qualifier: Qualifier,
  expression: Expression,
) -> QualifyResult / {abort.raise} =
  match expression {
    HoleExpression(_) -> { q: qualifier, e: expression },
    NameExpression(v) -> if !is_bare(v.name) {
      if names_constant(resolved, qualifier.constants, qualifier.owner, v.name) {
        { q: qualifier, e: constant_read(v.span, v.name) }
      } else { { q: qualifier, e: expression } }
    } else {
      match qualifier.binders.get(v.name.name.span.site) {
        Some(binder) -> if !qualifier.params.contains(binder) { { q: qualifier, e: expression } }
        else {
          {
            q: {
              ..qualifier,
              rejected: true,
              diagnostics: qualifier.diagnostics.push(
                error_at(
                  b"E0121",
                  qualifier.owner,
                  v.span,
                  Bytes::concat_all([
                    b"a parameter default cannot mention `",
                    v.name.name.name,
                    b"`",
                  ]),
                  b"names a parameter of this same signature",
                  [b"a call site has no such binding for the default to be copied into"],
                ),
              ),
            },
            e: expression,
          }
        },
        None -> match find(resolved, qualifier.owner, ValueSpace, v.name) {
          None -> { q: qualifier, e: expression },
          Some(b) -> if b.owner == qualifier.owner && qualifier.public
              && !declaration_public(resolved, qualifier.owner, v.name.name.name) {
            {
              q: {
                ..qualifier,
                diagnostics: qualifier.diagnostics.push(
                  error_at(
                    b"E0122",
                    qualifier.owner,
                    v.name.span,
                    Bytes::concat_all([
                      b"a default on a `pub fn` cannot mention `",
                      v.name.name.name,
                      b"`",
                    ]),
                    b"not exported by this module",
                    [
                      b"the default is copied into every call site that omits the argument, and a caller in another module may not name this",
                    ],
                  ),
                ),
              },
              e: expression,
            }
          } else {
            let module = method_binder(resolved.scopes.get(b.owner).module);
            let imports = match find_module_binding(qualifier.imports, module) {
              Some(_) -> qualifier.imports,
              None ->
                qualifier.imports.push({ binder: module, target: b.owner, span: dummy_span() }),
            };
            let name = {
              module: Some({ name: module, span: v.name.span }),
              name: v.name.name,
              span: v.name.span,
            };
            {
              q: { ..qualifier, imports: imports },
              e: if qualifier.constants.contains(b.qualified) { constant_read(v.span, name) }
              else { NameExpression({ span: v.span, name: name }) },
            }
          },
        },
      }
    },
    LambdaExpression(l) -> {
      let o: QualifyResult = qualify_expression(resolved, qualifier, l.body);
      {
        q: o.q,
        e: LambdaExpression({
          span: l.span,
          body: o.e,
          params: l.params,
          return_clause: l.return_clause,
        }),
      }
    },
    CallExpression(a) -> if a.named.len() > 0
        || !(match a.function { NameExpression(v) -> starts_upper(v.name.name.name), _ -> false }) {
      { q: rejected(qualifier, a.span), e: expression }
    } else {
      let f = qualify_expression(resolved, qualifier, a.function);
      let args = qualify_expressions(resolved, f.q, a.args);
      let named = a.named.fold(
        { q: args.q, xs: [] },
        |accumulator: { q: Qualifier, xs: List<NamedArg> }, arg: NamedArg| {
          let o = qualify_expression(resolved, accumulator.q, arg.value);
          { q: o.q, xs: accumulator.xs.push({ name: arg.name, value: o.e, span: arg.span }) }
        },
      );
      {
        q: named.q,
        e: CallExpression({
          span: a.span,
          function: f.e,
          named: named.xs,
          args: args.xs,
          labels: a.labels,
        }),
      }
    },
    MatchExpression(m) -> {
      let s: QualifyResult = qualify_expression(resolved, qualifier, m.scrutinee);
      let arms = m.arms.fold(
        { q: s.q, xs: [] },
        |accumulator: { q: Qualifier, xs: List<MatchArm> }, arm: MatchArm| {
          let g: { q: Qualifier, e: Option<Expression> } = match arm.guard {
            None -> { q: accumulator.q, e: None },
            Some(x) -> {
              let o: QualifyResult = qualify_expression(resolved, accumulator.q, x);
              { q: o.q, e: Some(o.e) }
            },
          };
          let body: QualifyResult = qualify_expression(resolved, g.q, arm.body);
          {
            q: body.q,
            xs: accumulator.xs.push({
              pattern: arm.pattern,
              guard: g.e,
              body: body.e,
              span: arm.span,
            }),
          }
        },
      );
      { q: arms.q, e: MatchExpression({ span: m.span, scrutinee: s.e, arms: arms.xs }) }
    },
    BlockExpression(b) -> {
      let statements: { q: Qualifier, xs: List<Statement> } = b.statements.fold(
        { q: qualifier, xs: [] },
        |accumulator: { q: Qualifier, xs: List<Statement> }, s: Statement|
          match s {
            LetStatement(l) -> {
              let o: QualifyResult = qualify_expression(resolved, accumulator.q, l.value);
              {
                q: o.q,
                xs: accumulator.xs.push(
                  LetStatement({ span: l.span, pattern: l.pattern, ty: l.ty, value: o.e }),
                ),
              }
            },
            LetElseStatement(l) -> {
              let o: QualifyResult = qualify_expression(resolved, accumulator.q, l.value);
              let fb: QualifyResult = qualify_expression(resolved, o.q, l.fallback);
              {
                q: fb.q,
                xs: accumulator.xs.push(LetElseStatement({ ..l, value: o.e, fallback: fb.e })),
              }
            },
            ExpressionStatement(x) -> {
              let o: QualifyResult = qualify_expression(resolved, accumulator.q, x);
              { q: o.q, xs: accumulator.xs.push(ExpressionStatement(o.e)) }
            },
            AssignmentStatement(x) ->
              { q: rejected(accumulator.q, x.span), xs: accumulator.xs.push(s) },
          },
      );
      let tail: { q: Qualifier, e: Option<Expression> } = match b.tail {
        None -> { q: statements.q, e: None },
        Some(t) -> {
          let o: QualifyResult = qualify_expression(resolved, statements.q, t);
          { q: o.q, e: Some(o.e) }
        },
      };
      { q: tail.q, e: BlockExpression({ span: b.span, tail: tail.e, statements: statements.xs }) }
    },
    BinaryExpression(b) -> {
      let l = qualify_expression(resolved, qualifier, b.left_operand);
      let rr = qualify_expression(resolved, l.q, b.right_operand);
      {
        q: rr.q,
        e: BinaryExpression({
          span: b.span,
          operation: b.operation,
          left_operand: l.e,
          right_operand: rr.e,
        }),
      }
    },
    UnaryExpression(u) -> {
      let o: QualifyResult = qualify_expression(resolved, qualifier, u.operand);
      { q: o.q, e: UnaryExpression({ span: u.span, operation: u.operation, operand: o.e }) }
    },
    IfExpression(i) -> {
      let c = qualify_expression(resolved, qualifier, i.cond);
      let t = qualify_expression(resolved, c.q, i.then_branch);
      let el = qualify_expression(resolved, t.q, i.else_branch);
      { q: el.q, e: IfExpression({ span: i.span, cond: c.e, then_branch: t.e, else_branch: el.e }) }
    },
    RecordExpression(record) -> {
      let o = qualify_fields(resolved, qualifier, record.fields);
      { q: o.q, e: RecordExpression({ span: record.span, fields: o.xs }) }
    },
    RecordUpdateExpression(record) -> {
      let b = qualify_expression(resolved, qualifier, record.base);
      let o = qualify_fields(resolved, b.q, record.fields);
      { q: o.q, e: RecordUpdateExpression({ span: record.span, base: b.e, fields: o.xs }) }
    },
    FieldExpression(f) -> {
      let o: QualifyResult = qualify_expression(resolved, qualifier, f.base);
      { q: o.q, e: FieldExpression({ span: f.span, base: o.e, field: f.field }) }
    },
    ListExpression(l) -> {
      let o = qualify_expressions(resolved, qualifier, l.items);
      { q: o.q, e: ListExpression({ span: l.span, items: o.xs }) }
    },
    LiteralExpression(_) -> { q: qualifier, e: expression },
    InvalidExpression(_) -> { q: qualifier, e: expression },
    _ -> { q: rejected(qualifier, expression_span(expression)), e: expression },
  }

fn qualify_expressions(
  resolved: Resolution,
  qualifier: Qualifier,
  expressions: List<Expression>,
) -> { q: Qualifier, xs: List<Expression> } / {abort.raise} =
  expressions.fold(
    { q: qualifier, xs: [] },
    |accumulator: { q: Qualifier, xs: List<Expression> }, expression: Expression| {
      let o = qualify_expression(resolved, accumulator.q, expression);
      { q: o.q, xs: accumulator.xs.push(o.e) }
    },
  )

fn qualify_fields(
  resolved: Resolution,
  qualifier: Qualifier,
  fields: List<RecordLiteralField>,
) -> { q: Qualifier, xs: List<RecordLiteralField> } / {abort.raise} =
  fields.fold(
    { q: qualifier, xs: [] },
    |accumulator: { q: Qualifier, xs: List<RecordLiteralField> }, field: RecordLiteralField| {
      let o = qualify_expression(resolved, accumulator.q, field.value);
      { q: o.q, xs: accumulator.xs.push({ name: field.name, value: o.e }) }
    },
  )

fn declaration_public(resolved: Resolution, owner: Int, name: Bytes) -> Bool / {abort.raise} =
  match lookup_declared(resolved.declarations.get(owner), ValueSpace, name) {
    Some(d) -> d.public,
    None -> false,
  }

type SignatureCollection = {
  sigs: List<Parameters>,
  owner_imports: List<{ module: Int, binder: Bytes, target: Int }>,
  diagnostics: List<Diagnostic>,
}

fn collect_signatures(
  resolved: Resolution,
  modules: List<ParsedModule>,
  constants: Map<Bytes, Bool>,
) -> SignatureCollection / {abort.raise} =
  range(0, modules.len()).fold(
    { sigs: [], owner_imports: [], diagnostics: [] },
    |accumulator: SignatureCollection, m: Int|
      modules.get(m).module.items.fold(accumulator, |c: SignatureCollection, item: Item|
        match item {
          FunctionItem(f) -> collect_signature(resolved, modules, m, c, f, constants),
          _ -> c,
        }),
  )

fn collect_signature(
  resolved: Resolution,
  modules: List<ParsedModule>,
  m: Int,
  c: SignatureCollection,
  definition: FnDefinition,
  constants: Map<Bytes, Bool>,
) -> SignatureCollection / {abort.raise} = {
  let binders = if definition.params.any(|param: Param| param.default != None) {
    item_binders(resolved, m, FunctionItem(definition))
  } else { Map::new() };
  let params = definition.params.map(|param: Param| param.name.span.site);
  let walked: { c: SignatureCollection, params: List<ParamInfo> } = definition.params.fold(
    { c: c, params: [] },
    |accumulator: { c: SignatureCollection, params: List<ParamInfo> }, param: Param|
      match param.default {
        None ->
          {
            ..accumulator,
            params: accumulator.params.push({ name: param.name.name, default: None, imports: [] }),
          },
        Some(d) -> {
          let o = qualify_expression(
            resolved,
            {
              owner: m,
              public: is_pub(definition.visibility),
              binders: binders,
              params: params,
              imports: [],
              diagnostics: accumulator.c.diagnostics,
              rejected: false,
              constants: constants,
            },
            d,
          );
          if o.q.rejected {
            {
              c: { ..accumulator.c, diagnostics: o.q.diagnostics },
              params: accumulator.params.push({
                name: param.name.name,
                default: None,
                imports: [],
              }),
            }
          } else {
            let owner_imports = o.q.imports.fold(
              accumulator.c.owner_imports,
              |oi: List<{ module: Int, binder: Bytes, target: Int }>, binding: ModuleBinding|
                oi.push({ module: m, binder: binding.binder, target: binding.target }),
            );
            {
              c: { ..accumulator.c, diagnostics: o.q.diagnostics, owner_imports: owner_imports },
              params: accumulator.params.push({
                name: param.name.name,
                default: Some(o.e),
                imports: o.q.imports,
              }),
            }
          }
        },
      },
  );
  {
    ..walked.c,
    sigs: walked.c.sigs.push({
      name: qualify(modules.get(m).name, definition.name.name),
      params: walked.params,
    }),
  }
}

fn builtin_signature(name: Bytes) -> Option<Parameters> =
  if name == b"assert" {
    Some({
      name: b"assert",
      params: [
        { name: b"cond", default: None, imports: [] },
        {
          name: b"message",
          default: Some(
            NameExpression({
              span: dummy_span(),
              name: {
                module: None,
                name: { name: none_constructor(), span: dummy_span() },
                span: dummy_span(),
              },
            }),
          ),
          imports: [],
        },
      ],
    })
  } else { None }

type Filler = {
  module: Int,
  binders: Map<Int, Int>,
  implicit: List<ModuleBinding>,
  diagnostics: List<Diagnostic>,
}

type FillResult = { filler: Filler, expression: Expression }

type FillContext = { r: Resolution, index: Map<Bytes, Parameters>, constants: Map<Bytes, Bool> }

fn is_local(filler: Filler, name: QName) -> Bool =
  is_bare(name) && filler.binders.contains(name.name.span.site)

fn reads_constant(f: FillContext, filler: Filler, name: QName) -> Bool / {abort.raise} =
  !is_local(filler, name) && names_constant(f.r, f.constants, filler.module, name)

type Perform = {
  span: Span,
  effect_name: QName,
  operation: Identifier,
  resource: Option<Identifier>,
  args: List<Expression>,
}

fn method_of_constant(p: Perform, args: List<Expression>) -> Expression =
  CallExpression({
    span: p.span,
    function: FieldExpression({
      span: synthetic_span_at(
        span_to(p.effect_name.span, p.operation.span),
        p.span,
        role_member_field(),
      ),
      base: constant_read(
        synthetic_span_at(p.effect_name.span, p.span, role_member_receiver()),
        p.effect_name,
      ),
      field: p.operation,
    }),
    named: [],
    args: args,
    labels: match p.resource { Some(r) -> [r], None -> [] },
  })

fn fill_expression(
  f: FillContext,
  filler: Filler,
  expression: Expression,
) -> FillResult / {abort.raise} = {
  let o = fill_children(f, filler, expression);
  match o.expression { CallExpression(a) -> fill_call(f, o.filler, a), _ -> o }
}

fn fill_children(
  f: FillContext,
  filler: Filler,
  expression: Expression,
) -> FillResult / {abort.raise} =
  match expression {
    LiteralExpression(_) -> { filler: filler, expression: expression },
    TaggedLiteralExpression(t) -> {
      let filled = t.holes.fold(
        { filler: filler, holes: [] },
        |accumulator: { filler: Filler, holes: List<Hole> }, h: Hole| {
          let o: FillResult = fill_expression(f, accumulator.filler, h.value);
          { filler: o.filler, holes: accumulator.holes.push({ ..h, value: o.expression }) }
        },
      );
      { filler: filled.filler, expression: TaggedLiteralExpression({ ..t, holes: filled.holes }) }
    },
    NameExpression(v) ->
      {
        filler: filler,
        expression: if reads_constant(f, filler, v.name) { constant_read(v.span, v.name) }
        else { expression },
      },
    HoleExpression(_) -> { filler: filler, expression: expression },
    InvalidExpression(_) -> { filler: filler, expression: expression },
    BinaryExpression(b) -> {
      let l = fill_expression(f, filler, b.left_operand);
      let rr = fill_expression(f, l.filler, b.right_operand);
      {
        filler: rr.filler,
        expression: BinaryExpression({
          span: b.span,
          operation: b.operation,
          left_operand: l.expression,
          right_operand: rr.expression,
        }),
      }
    },
    UnaryExpression(u) -> {
      let o: FillResult = fill_expression(f, filler, u.operand);
      {
        filler: o.filler,
        expression: UnaryExpression({
          span: u.span,
          operation: u.operation,
          operand: o.expression,
        }),
      }
    },
    LambdaExpression(l) -> {
      let o: FillResult = fill_expression(f, filler, l.body);
      {
        filler: o.filler,
        expression: LambdaExpression({
          span: l.span,
          body: o.expression,
          params: l.params,
          return_clause: l.return_clause,
        }),
      }
    },
    CallExpression(a) -> {
      let fn_ = fill_expression(f, filler, a.function);
      let args = fill_expressions(f, fn_.filler, a.args);
      let named = a.named.fold(
        { filler: args.filler, xs: [] },
        |accumulator: { filler: Filler, xs: List<NamedArg> }, arg: NamedArg| {
          let o = fill_expression(f, accumulator.filler, arg.value);
          {
            filler: o.filler,
            xs: accumulator.xs.push({ name: arg.name, value: o.expression, span: arg.span }),
          }
        },
      );
      {
        filler: named.filler,
        expression: CallExpression({
          span: a.span,
          function: fn_.expression,
          named: named.xs,
          args: args.xs,
          labels: a.labels,
        }),
      }
    },
    IfExpression(i) -> {
      let c = fill_expression(f, filler, i.cond);
      let t = fill_expression(f, c.filler, i.then_branch);
      let el = fill_expression(f, t.filler, i.else_branch);
      {
        filler: el.filler,
        expression: IfExpression({
          span: i.span,
          cond: c.expression,
          then_branch: t.expression,
          else_branch: el.expression,
        }),
      }
    },
    MatchExpression(m) -> {
      let s = fill_expression(f, filler, m.scrutinee);
      let arms = m.arms.fold(
        { filler: s.filler, xs: [] },
        |accumulator: { filler: Filler, xs: List<MatchArm> }, arm: MatchArm| {
          let g: { filler: Filler, expression: Option<Expression> } = match arm.guard {
            None -> { filler: accumulator.filler, expression: None },
            Some(x) -> {
              let o: FillResult = fill_expression(f, accumulator.filler, x);
              { filler: o.filler, expression: Some(o.expression) }
            },
          };
          let body: FillResult = fill_expression(f, g.filler, arm.body);
          {
            filler: body.filler,
            xs: accumulator.xs.push({
              pattern: arm.pattern,
              guard: g.expression,
              body: body.expression,
              span: arm.span,
            }),
          }
        },
      );
      {
        filler: arms.filler,
        expression: MatchExpression({ span: m.span, scrutinee: s.expression, arms: arms.xs }),
      }
    },
    BlockExpression(b) -> {
      let statements: { filler: Filler, xs: List<Statement> } = b.statements.fold(
        { filler: filler, xs: [] },
        |accumulator: { filler: Filler, xs: List<Statement> }, s: Statement|
          match s {
            LetStatement(l) -> {
              let o: FillResult = fill_expression(f, accumulator.filler, l.value);
              {
                filler: o.filler,
                xs: accumulator.xs.push(
                  LetStatement({ span: l.span, pattern: l.pattern, ty: l.ty, value: o.expression }),
                ),
              }
            },
            LetElseStatement(l) -> {
              let o: FillResult = fill_expression(f, accumulator.filler, l.value);
              let fb: FillResult = fill_expression(f, o.filler, l.fallback);
              {
                filler: fb.filler,
                xs: accumulator.xs.push(
                  LetElseStatement({ ..l, value: o.expression, fallback: fb.expression }),
                ),
              }
            },
            ExpressionStatement(x) -> {
              let o: FillResult = fill_expression(f, accumulator.filler, x);
              { filler: o.filler, xs: accumulator.xs.push(ExpressionStatement(o.expression)) }
            },
            AssignmentStatement(x) -> {
              let o: FillResult = fill_expression(f, accumulator.filler, x.value);
              {
                filler: o.filler,
                xs: accumulator.xs.push(AssignmentStatement({ ..x, value: o.expression })),
              }
            },
          },
      );
      let tail: { filler: Filler, expression: Option<Expression> } = match b.tail {
        None -> { filler: statements.filler, expression: None },
        Some(t) -> {
          let o: FillResult = fill_expression(f, statements.filler, t);
          { filler: o.filler, expression: Some(o.expression) }
        },
      };
      {
        filler: tail.filler,
        expression: BlockExpression({
          span: b.span,
          tail: tail.expression,
          statements: statements.xs,
        }),
      }
    },
    RecordExpression(record) -> {
      let o = fill_fields(f, filler, record.fields);
      { filler: o.filler, expression: RecordExpression({ span: record.span, fields: o.xs }) }
    },
    RecordUpdateExpression(update) -> {
      let b = fill_expression(f, filler, update.base);
      let o = fill_fields(f, b.filler, update.fields);
      {
        filler: o.filler,
        expression: RecordUpdateExpression({ span: update.span, base: b.expression, fields: o.xs }),
      }
    },
    FieldExpression(fl) -> {
      let o: FillResult = fill_expression(f, filler, fl.base);
      {
        filler: o.filler,
        expression: FieldExpression({ span: fl.span, base: o.expression, field: fl.field }),
      }
    },
    ListExpression(l) -> {
      let o = fill_expressions(f, filler, l.items);
      { filler: o.filler, expression: ListExpression({ span: l.span, items: o.xs }) }
    },
    PropagateExpression(t) -> {
      let o: FillResult = fill_expression(f, filler, t.operand);
      { filler: o.filler, expression: PropagateExpression({ span: t.span, operand: o.expression }) }
    },
    PerformExpression(p) -> {
      let o = fill_expressions(f, filler, p.args);
      let declared = find(f.r, filler.module, EffectSpace, p.effect_name);
      {
        filler: o.filler,
        expression: if declared == None && reads_constant(f, filler, p.effect_name) {
          method_of_constant(p, o.xs)
        } else { PerformExpression({ ..p, args: o.xs }) },
      }
    },
    HandleExpression(h) -> {
      let variables: { filler: Filler, xs: List<HandlerStateVariable> } = h.handler_variables.fold(
        { filler: filler, xs: [] },
        |accumulator: { filler: Filler, xs: List<HandlerStateVariable> }, v: HandlerStateVariable| {
          let o: FillResult = fill_expression(f, accumulator.filler, v.init);
          { filler: o.filler, xs: accumulator.xs.push({ ..v, init: o.expression }) }
        },
      );
      let body: FillResult = fill_expression(f, variables.filler, h.body);
      let clauses: { filler: Filler, xs: List<HandleClause> } = h.clauses.fold(
        { filler: body.filler, xs: [] },
        |accumulator: { filler: Filler, xs: List<HandleClause> }, c: HandleClause| {
          let o: FillResult = fill_expression(f, accumulator.filler, c.body);
          {
            filler: o.filler,
            xs: accumulator.xs.push({
              effect_name: c.effect_name,
              operation: c.operation,
              resource: c.resource,
              wildcard_label: c.wildcard_label,
              label_binder: c.label_binder,
              resume: c.resume,
              body: o.expression,
              span: c.span,
              params: c.params,
            }),
          }
        },
      );
      let return_clause: { filler: Filler, expression: Option<ReturnClause> } = match h.return_clause {
        None -> { filler: clauses.filler, expression: None },
        Some(clause) -> {
          let o: FillResult = fill_expression(f, clauses.filler, clause.body);
          {
            filler: o.filler,
            expression: Some({ binder: clause.binder, body: o.expression, span: clause.span }),
          }
        },
      };
      {
        filler: return_clause.filler,
        expression: HandleExpression({
          span: h.span,
          body: body.expression,
          return_clause: return_clause.expression,
          clauses: clauses.xs,
          handler_variables: variables.xs,
        }),
      }
    },
    WithScopeExpression(c) -> {
      let acquire: FillResult = fill_expression(f, filler, c.acquire);
      let release: FillResult = fill_expression(f, acquire.filler, c.release);
      let o: FillResult = fill_expression(f, release.filler, c.body);
      {
        filler: o.filler,
        expression: WithScopeExpression({
          ..c,
          acquire: acquire.expression,
          release: release.expression,
          body: o.expression,
        }),
      }
    },
    SimulateExpression(s) -> {
      let o: FillResult = fill_expression(f, filler, s.body);
      { filler: o.filler, expression: SimulateExpression({ span: s.span, body: o.expression }) }
    },
    TryBlockExpression(t) -> {
      let o: FillResult = fill_expression(f, filler, t.body);
      { filler: o.filler, expression: TryBlockExpression({ ..t, body: o.expression }) }
    },
    ParallelExpression(v) -> {
      let o = fill_expressions(f, filler, v.branches);
      { filler: o.filler, expression: ParallelExpression({ span: v.span, branches: o.xs }) }
    },
  }

fn fill_expressions(
  f: FillContext,
  filler: Filler,
  expressions: List<Expression>,
) -> { filler: Filler, xs: List<Expression> } / {abort.raise} =
  expressions.fold(
    { filler: filler, xs: [] },
    |accumulator: { filler: Filler, xs: List<Expression> }, expression: Expression| {
      let o = fill_expression(f, accumulator.filler, expression);
      { filler: o.filler, xs: accumulator.xs.push(o.expression) }
    },
  )

fn fill_fields(
  f: FillContext,
  filler: Filler,
  fields: List<RecordLiteralField>,
) -> { filler: Filler, xs: List<RecordLiteralField> } / {abort.raise} =
  fields.fold(
    { filler: filler, xs: [] },
    |accumulator: { filler: Filler, xs: List<RecordLiteralField> }, field: RecordLiteralField| {
      let o = fill_expression(f, accumulator.filler, field.value);
      { filler: o.filler, xs: accumulator.xs.push({ name: field.name, value: o.expression }) }
    },
  )

fn signature_of(
  f: FillContext,
  filler: Filler,
  function: Expression,
) -> Option<Parameters> / {abort.raise} =
  match function {
    NameExpression(v) -> if is_bare(v.name) && starts_upper(v.name.name.name) { None }
    else if is_bare(v.name) && filler.binders.contains(v.name.name.span.site) { None } else {
      match find(f.r, filler.module, ValueSpace, v.name) {
        Some(b) -> f.index.get(b.qualified),
        None -> if is_bare(v.name) { builtin_signature(v.name.name.name) } else { None },
      }
    },
    _ -> None,
  }

type Call = {
  span: Span,
  function: Expression,
  named: List<NamedArg>,
  args: List<Expression>,
  labels: List<Identifier>,
}

fn as_perform(
  filler: Filler,
  call: Call,
  on: Expression,
  operation: Identifier,
) -> Option<FillResult> =
  match on {
    NameExpression(v) -> if call.named.len() == 0
        || (is_bare(v.name) && filler.binders.contains(v.name.name.span.site)) { None } else {
      let written = match v.name.module {
        Some(m) -> Bytes::concat_all([m.name, b"::", v.name.name.name]),
        None -> v.name.name.name,
      };
      Some({
        filler: {
          ..filler,
          diagnostics: call.named.fold(filler.diagnostics, |ds: List<Diagnostic>, arg: NamedArg|
            ds.push(
              error_at(
                b"E0123",
                filler.module,
                arg.span,
                Bytes::concat_all([
                  b"`",
                  written,
                  b".",
                  operation.name,
                  b"` takes no named arguments",
                ]),
                b"named",
                [b"an effect operation's arguments are positional"],
              ),
            )),
        },
        expression: PerformExpression({
          span: call.span,
          effect_name: v.name,
          operation: operation,
          resource: call.labels.at(0),
          args: call.args,
        }),
      })
    },
    _ -> None,
  }

fn fill_call(f: FillContext, filler: Filler, call: Call) -> FillResult / {abort.raise} =
  match call.function {
    FieldExpression(on) -> match as_perform(filler, call, on.base, on.field) {
      Some(p) -> p,
      None -> { filler: filler, expression: CallExpression(call) },
    },
    _ -> fill_by_signature(f, filler, call),
  }

fn fill_by_signature(f: FillContext, filler: Filler, call: Call) -> FillResult / {abort.raise} =
  match signature_of(f, filler, call.function) {
    None -> {
      let diagnostics = call.named.fold(
        filler.diagnostics,
        |ds: List<Diagnostic>, arg: NamedArg|
          ds.push(
            error_at(
              b"E0123",
              filler.module,
              arg.name.span,
              Bytes::concat_all([b"`", arg.name.name, b"` names no parameter here"]),
              b"no signature to match this against",
              [
                b"a named argument needs a callee reached by name; a call through a value, a lambda or a constructor is positional",
              ],
            ),
          ),
      );
      {
        filler: { ..filler, diagnostics: diagnostics },
        expression: CallExpression({ ..call, named: [] }),
      }
    },
    Some(sig) -> if call.args.len() > sig.params.len() {
      { filler: filler, expression: CallExpression({ ..call, named: [] }) }
    } else { fill_slots(filler, call, sig) },
  }

pub type PlacedArguments = {
  args: List<Expression>,
  slots: List<Slot>,
  diagnostics: List<Diagnostic>,
  imports: List<ModuleBinding>,
}

pub fn place_arguments(
  module: Int,
  span: Span,
  signature: Parameters,
  args: List<Expression>,
  named: List<NamedArg>,
) -> PlacedArguments / {abort.raise} = {
  let s = slotted(
    signature.params.map(|p: ParamInfo| p.name),
    signature.params.map(|p: ParamInfo| p.default),
    args,
    named,
    span,
  );
  let unplaced = s.unplaced.map(|u: { arg: NamedArg, reason: UnmatchedReason }|
    match u.reason {
      NoSuchParameter ->
        error_at(
          b"E0123",
          module,
          u.arg.name.span,
          Bytes::concat_all([b"`", u.arg.name.name, b"` names no parameter of this function"]),
          b"not a parameter",
          [b"the parameters are ".concat(list_names(signature.params.map(|p: ParamInfo| p.name)))],
        ),
      reason ->
        error_at(
          b"E0123",
          module,
          u.arg.name.span,
          Bytes::concat_all([
            b"`",
            u.arg.name.name,
            b"` is ",
            if reason == FilledByPosition { b"already filled by a positional argument" }
            else { b"already given by name" },
          ]),
          b"given twice",
          [],
        ),
    });
  {
    args: if s.missing.len() > 0 { args } else { ordered_arguments(s.slots, args, named) },
    slots: if s.missing.len() > 0 { [] } else { s.slots },
    diagnostics: if s.missing.len() == 0 || named.len() == 0 { unplaced } else {
      unplaced.push(
        error_at(
          b"E0125",
          module,
          span,
          Bytes::concat_all([b"this call leaves ", list_names(s.missing), b" unfilled"]),
          b"no argument and no default",
          [b"pass it positionally, or by name as `<parameter>: <value>`"],
        ),
      )
    },
    imports: range(0, s.slots.len()).fold([], |bindings: List<ModuleBinding>, i: Int|
      match s.slots.get(i) {
        FromDefault(_) ->
          signature.params.get(i).imports.fold(
            bindings,
            |accumulator: List<ModuleBinding>, binding: ModuleBinding|
              match find_module_binding(accumulator, binding.binder) {
                Some(_) -> accumulator,
                None -> accumulator.push(binding),
              },
          ),
        _ -> bindings,
      }),
  }
}

fn fill_slots(filler: Filler, call: Call, signature: Parameters) -> FillResult / {abort.raise} = {
  let filled = place_arguments(filler.module, call.span, signature, call.args, call.named);
  {
    filler: {
      ..filler,
      diagnostics: filler.diagnostics.concat(filled.diagnostics),
      implicit: filled.imports.fold(
        filler.implicit,
        |bindings: List<ModuleBinding>, b: ModuleBinding|
          match find_module_binding(bindings, b.binder) {
            Some(_) -> bindings,
            None -> bindings.push(b),
          },
      ),
    },
    expression: CallExpression({ ..call, args: filled.args, named: [] }),
  }
}

fn fill_params(
  f: FillContext,
  filler: Filler,
  params: List<Param>,
) -> { filler: Filler, xs: List<Param> } / {abort.raise} =
  params.fold(
    { filler: filler, xs: [] },
    |accumulator: { filler: Filler, xs: List<Param> }, param: Param|
      match param.default {
        None -> { ..accumulator, xs: accumulator.xs.push(param) },
        Some(d) -> {
          let o = fill_expression(f, accumulator.filler, d);
          { filler: o.filler, xs: accumulator.xs.push({ ..param, default: Some(o.expression) }) }
        },
      },
  )

fn fill_item(
  f: FillContext,
  filler: Filler,
  item: Item,
) -> { filler: Filler, it: Item } / {abort.raise} =
  match item {
    FunctionItem(d) -> {
      let params = fill_params(f, filler, d.params);
      let spec: { filler: Filler, xs: List<SpecClause> } = d.spec.fold(
        { filler: params.filler, xs: [] },
        |accumulator: { filler: Filler, xs: List<SpecClause> }, clause: SpecClause| {
          let o = fill_expression(f, accumulator.filler, clause.expression);
          { filler: o.filler, xs: accumulator.xs.push({ ..clause, expression: o.expression }) }
        },
      );
      let measured: { filler: Filler, expression: Option<Expression> } = match d.decreases {
        None -> { filler: spec.filler, expression: None },
        Some(e) -> {
          let o = fill_expression(f, spec.filler, e);
          { filler: o.filler, expression: Some(o.expression) }
        },
      };
      let body: FillResult = fill_expression(f, measured.filler, d.body);
      {
        filler: body.filler,
        it: FunctionItem({
          visibility: d.visibility,
          name: d.name,
          generics: d.generics,
          params: params.xs,
          return_type: d.return_type,
          effects: d.effects,
          constraints: d.constraints,
          spec: spec.xs,
          returns: d.returns,
          reuse: d.reuse,
          transparent: d.transparent,
          constant: d.constant,
          decreases: measured.expression,
          body: body.expression,
          doc: d.doc,
          span: d.span,
        }),
      }
    },
    TestItem(d) -> match d.cases {
      None -> {
        let o: FillResult = fill_expression(f, filler, d.body);
        { filler: o.filler, it: TestItem({ ..d, body: o.expression }) }
      },
      Some(c) -> {
        let table: FillResult = fill_expression(f, filler, c.table);
        let label: FillResult = fill_expression(f, table.filler, c.label);
        let body: FillResult = fill_expression(f, label.filler, d.body);
        {
          filler: body.filler,
          it: TestItem({
            ..d,
            cases: Some({ ..c, table: table.expression, label: label.expression }),
            body: body.expression,
          }),
        }
      },
    },
    LawItem(d) -> {
      let g = match d.guard {
        None -> { filler: filler, expression: None },
        Some(x) -> {
          let o: FillResult = fill_expression(f, filler, x);
          { filler: o.filler, expression: Some(o.expression) }
        },
      };
      let body: FillResult = fill_expression(f, g.filler, d.body);
      { filler: body.filler, it: LawItem({ ..d, guard: g.expression, body: body.expression }) }
    },
    _ -> { filler: filler, it: item },
  }

pub type ResolvedProgram = {
  resolution: Resolution,
  modules: List<ParsedModule>,
  diagnostics: List<Diagnostic>,
}

fn constants_read_by_name(modules: List<ParsedModule>) -> Map<Bytes, Bool> =
  modules.fold(Map::new(), |found: Map<Bytes, Bool>, m: ParsedModule|
    m.module.items.fold(found, |accumulator: Map<Bytes, Bool>, item: Item|
      match item {
        FunctionItem(d) -> match d.constant {
          Some(c) -> if c.read_by_name { accumulator.insert(qualify(m.name, d.name.name), true) }
          else { accumulator },
          None -> accumulator,
        },
        _ -> accumulator,
      }))

pub fn fill_defaults(
  r: Resolution,
  modules: List<ParsedModule>,
  diagnostics: List<Diagnostic>,
) -> ResolvedProgram / {abort.raise} = {
  let constants = constants_read_by_name(modules);
  let c = collect_signatures(r, modules, constants);
  let r2 = c.owner_imports.fold(
    r,
    |accumulator: Resolution, oi: { module: Int, binder: Bytes, target: Int }|
      add_module_binding(accumulator, oi.module, oi.binder, oi.target),
  );
  let f = {
    r: r2,
    index: c.sigs.fold(Map::new(), |accumulator: Map<Bytes, Parameters>, signature: Parameters|
      match accumulator.get(signature.name) {
        Some(_) -> accumulator,
        None -> accumulator.insert(signature.name, signature),
      }),
    constants: constants,
  };
  let walked = range(0, modules.len()).fold(
    { resolution: r2, modules: [], diagnostics: concat_diagnostics(diagnostics, c.diagnostics) },
    |accumulator: ResolvedProgram, m: Int| {
      let mod: ParsedModule = modules.get(m);
      let items: { filler: Filler, xs: List<Item> } = mod.module.items.fold(
        {
          filler: {
            module: m,
            binders: Map::new(),
            implicit: [],
            diagnostics: accumulator.diagnostics,
          },
          xs: [],
        },
        |ia: { filler: Filler, xs: List<Item> }, item: Item| {
          let o = fill_item(f, { ..ia.filler, binders: item_binders(f.r, m, item) }, item);
          { filler: o.filler, xs: ia.xs.push(o.it) }
        },
      );
      let updated_resolution = items.filler.implicit.fold(
        accumulator.resolution,
        |rr: Resolution, binding: ModuleBinding|
          add_module_binding(rr, m, binding.binder, binding.target),
      );
      {
        resolution: updated_resolution,
        modules: accumulator.modules.push({
          name: mod.name,
          module: { ..mod.module, items: items.xs },
          derived: mod.derived,
        }),
        diagnostics: items.filler.diagnostics,
      }
    },
  );
  {
    ..walked,
    resolution: {
      ..walked.resolution,
      signatures: f.index,
      visible_modules: range(0, modules.len()).map(|m: Int| {
        let seen = transitive_imports(walked.resolution.imports, m);
        if !sees_homes(modules.get(m).name) { seen } else {
          range(0, modules.len()).fold(seen, |accumulator: List<Int>, k: Int|
            if !accumulator.contains(k) && home_modules().contains(modules.get(k).name) {
              accumulator.push(k)
            } else { accumulator })
        }
      }),
    },
  }
}

fn transitive_imports(imports: List<List<Int>>, m: Int) -> List<Int> / {abort.raise} =
  iterate({ seen: [m], work: [m] }, 1000000, |s: { seen: List<Int>, work: List<Int> }|
    match s.work {
      [] -> Stop(s.seen),
      [k, ..rest] ->
        Continue(
          List::fold(
            match imports.at(k) { Some(ts) -> ts, None -> [] },
            { seen: s.seen, work: rest },
            |accumulator: { seen: List<Int>, work: List<Int> }, t: Int|
              if accumulator.seen.contains(t) { accumulator }
              else { { seen: accumulator.seen.push(t), work: accumulator.work.push(t) } },
          ),
        ),
    })

pub fn make_all_visible(r: Resolution) -> Resolution =
  { ..r, visible_modules: r.scopes.map(|_: Scope| range(0, r.scopes.len())) }
