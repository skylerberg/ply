//! Parameter defaults: what one may be, qualified against the module that wrote it, and filled into every call.

import compiler.syntax.parsing (Span, Ident, dummy_span, is_bare, starts_upper)
import compiler.syntax.items (Item, FunctionItem, TestItem, LawItem, FnDef, SpecClause, Binder,
                              parse, is_pub)
import compiler.syntax.exprs (Expr, LiteralExpression, NameExpression, BinaryExpression,
                              UnaryExpression, LambdaExpression, CallExpression, IfExpression,
                              MatchExpression, BlockExpression, RecordExpression,
                              RecordUpdateExpression, PropagateExpression, FieldExpression,
                              ListExpression, PerformExpression, HandleExpression,
                              WithHoldExpression, SimulateExpression, ParallelExpression,
                              InvalidExpression, HoleExpression, TryBlockExpression, Stmt,
                              LetStatement, LetElseStatement, ExpressionStatement,
                              AssignmentStatement, Param, NamedArg, MatchArm, HandleClause,
                              ReturnClause, HandlerVar, RecordLiteralField, expr_span,
                              TaggedLiteralExpression, Hole, home_modules, sees_homes)
import compiler.syntax.calls (slotted, ordered_arguments, Slot, FromDefault, UnmatchedReason,
                              NoSuchParameter, FilledByPosition)
import std.list
import compiler.check.known (none_ctor)
import compiler.check.resolve.tables (ParsedModule, ValueSpace, ModuleBinding, Scope, Diag,
                                      Resolution, lookup_declared, find_module_binding, qualify,
                                      error_at, list_names, ParamInfo, Parameters)
import compiler.check.resolve.scopes (find, method_binder)
import compiler.check.resolve.sets (add_module_binding, concat_diagnostics)
import compiler.check.resolve.bindings (item_binders)

// --- Defaults: qualifying one against the module that wrote it -----------------------------

type Qualifier = {
  owner: Int,
  public: Bool,
  binders: Map<Int, Int>,
  params: List<Int>,
  imports: List<ModuleBinding>,
  diags: List<Diag>,
  refused: Bool,
}

fn refused(qualifier: Qualifier, span: Span) -> Qualifier =
  {
    ..qualifier,
    refused: true,
    diags: qualifier.diags.push(
      error_at(
        b"E0121",
        qualifier.owner,
        span,
        b"a parameter default must be a pure, closed expression",
        b"this runs, rather than being a value",
        [
          b"the default is copied into every call that omits the argument, so a call or a `perform` in it would run at the caller and not here",
          b"a literal, a constructor applied to literals, a record or a list is fine",
        ],
      ),
    ),
  }

type QualifyResult = { q: Qualifier, e: Expr }

fn qualify_expr(
  resolved: Resolution,
  qualifier: Qualifier,
  expr: Expr,
) -> QualifyResult / {abort.raise} =
  match expr {
    HoleExpression(_) -> { q: qualifier, e: expr },
    NameExpression(v) -> if !is_bare(v.name) { { q: qualifier, e: expr } } else {
      match qualifier.binders.get(v.name.name.span.site) {
        Some(binder) -> if !qualifier.params.contains(binder) { { q: qualifier, e: expr } } else {
          {
            q: {
              ..qualifier,
              refused: true,
              diags: qualifier.diags.push(
                error_at(
                  b"E0121",
                  qualifier.owner,
                  v.span,
                  Bytes::concat_all([
                    b"a parameter default cannot mention `",
                    v.name.name.name,
                    b"`",
                  ]),
                  b"names a parameter of this same signature",
                  [b"a call site has no such binding for the default to be copied into"],
                ),
              ),
            },
            e: expr,
          }
        },
        None -> match find(resolved, qualifier.owner, ValueSpace, v.name) {
          None -> { q: qualifier, e: expr },
          Some(b) -> if b.owner == qualifier.owner && qualifier.public
              && !decl_public(resolved, qualifier.owner, v.name.name.name) {
            {
              q: {
                ..qualifier,
                diags: qualifier.diags.push(
                  error_at(
                    b"E0122",
                    qualifier.owner,
                    v.name.span,
                    Bytes::concat_all([
                      b"a default on a `pub fn` cannot mention `",
                      v.name.name.name,
                      b"`",
                    ]),
                    b"not exported by this module",
                    [
                      b"the default is copied into every call site that omits the argument, and a caller in another module may not name this",
                    ],
                  ),
                ),
              },
              e: expr,
            }
          } else {
            let module = method_binder(resolved.scopes.get(b.owner).module);
            let imports = match find_module_binding(qualifier.imports, module) {
              Some(_) -> qualifier.imports,
              None ->
                qualifier.imports.push({ binder: module, target: b.owner, span: dummy_span() }),
            };
            {
              q: { ..qualifier, imports: imports },
              e: NameExpression({
                span: v.span,
                name: {
                  module: Some({ name: module, span: v.name.span }),
                  name: v.name.name,
                  span: v.name.span,
                },
              }),
            }
          },
        },
      }
    },
    LambdaExpression(l) -> {
      let o: QualifyResult = qualify_expr(resolved, qualifier, l.body);
      { q: o.q, e: LambdaExpression({ span: l.span, body: o.e, params: l.params, ret: l.ret }) }
    },
    CallExpression(a) -> if a.named.len() > 0
        || !(match a.func { NameExpression(v) -> starts_upper(v.name.name.name), _ -> false }) {
      { q: refused(qualifier, a.span), e: expr }
    } else {
      let f = qualify_expr(resolved, qualifier, a.func);
      let args = qualify_exprs(resolved, f.q, a.args);
      let named = a.named.fold(
        { q: args.q, xs: [] },
        |acc: { q: Qualifier, xs: List<NamedArg> }, arg: NamedArg| {
          let o = qualify_expr(resolved, acc.q, arg.value);
          { q: o.q, xs: acc.xs.push({ name: arg.name, value: o.e, span: arg.span }) }
        },
      );
      {
        q: named.q,
        e: CallExpression({
          span: a.span,
          func: f.e,
          named: named.xs,
          args: args.xs,
          labels: a.labels,
        }),
      }
    },
    MatchExpression(m) -> {
      let s: QualifyResult = qualify_expr(resolved, qualifier, m.scrutinee);
      let arms = m.arms.fold(
        { q: s.q, xs: [] },
        |acc: { q: Qualifier, xs: List<MatchArm> }, arm: MatchArm| {
          let g: { q: Qualifier, e: Option<Expr> } = match arm.guard {
            None -> { q: acc.q, e: None },
            Some(x) -> {
              let o: QualifyResult = qualify_expr(resolved, acc.q, x);
              { q: o.q, e: Some(o.e) }
            },
          };
          let body: QualifyResult = qualify_expr(resolved, g.q, arm.body);
          { q: body.q, xs: acc.xs.push({ pat: arm.pat, guard: g.e, body: body.e, span: arm.span }) }
        },
      );
      { q: arms.q, e: MatchExpression({ span: m.span, scrutinee: s.e, arms: arms.xs }) }
    },
    BlockExpression(b) -> {
      let stmts: { q: Qualifier, xs: List<Stmt> } = b.stmts.fold(
        { q: qualifier, xs: [] },
        |acc: { q: Qualifier, xs: List<Stmt> }, s: Stmt|
          match s {
            LetStatement(l) -> {
              let o: QualifyResult = qualify_expr(resolved, acc.q, l.value);
              {
                q: o.q,
                xs: acc.xs.push(LetStatement({ span: l.span, pat: l.pat, ty: l.ty, value: o.e })),
              }
            },
            LetElseStatement(l) -> {
              let o: QualifyResult = qualify_expr(resolved, acc.q, l.value);
              let fb: QualifyResult = qualify_expr(resolved, o.q, l.fallback);
              { q: fb.q, xs: acc.xs.push(LetElseStatement({ ..l, value: o.e, fallback: fb.e })) }
            },
            ExpressionStatement(x) -> {
              let o: QualifyResult = qualify_expr(resolved, acc.q, x);
              { q: o.q, xs: acc.xs.push(ExpressionStatement(o.e)) }
            },
            AssignmentStatement(x) -> { q: refused(acc.q, x.span), xs: acc.xs.push(s) },
          },
      );
      let tail: { q: Qualifier, e: Option<Expr> } = match b.tail {
        None -> { q: stmts.q, e: None },
        Some(t) -> {
          let o: QualifyResult = qualify_expr(resolved, stmts.q, t);
          { q: o.q, e: Some(o.e) }
        },
      };
      { q: tail.q, e: BlockExpression({ span: b.span, tail: tail.e, stmts: stmts.xs }) }
    },
    BinaryExpression(b) -> {
      let l = qualify_expr(resolved, qualifier, b.lhs);
      let rr = qualify_expr(resolved, l.q, b.rhs);
      { q: rr.q, e: BinaryExpression({ span: b.span, op: b.op, lhs: l.e, rhs: rr.e }) }
    },
    UnaryExpression(u) -> {
      let o: QualifyResult = qualify_expr(resolved, qualifier, u.operand);
      { q: o.q, e: UnaryExpression({ span: u.span, op: u.op, operand: o.e }) }
    },
    IfExpression(i) -> {
      let c = qualify_expr(resolved, qualifier, i.cond);
      let t = qualify_expr(resolved, c.q, i.then_branch);
      let el = qualify_expr(resolved, t.q, i.else_branch);
      { q: el.q, e: IfExpression({ span: i.span, cond: c.e, then_branch: t.e, else_branch: el.e }) }
    },
    RecordExpression(rec) -> {
      let o = qualify_fields(resolved, qualifier, rec.fields);
      { q: o.q, e: RecordExpression({ span: rec.span, fields: o.xs }) }
    },
    RecordUpdateExpression(rec) -> {
      let b = qualify_expr(resolved, qualifier, rec.base);
      let o = qualify_fields(resolved, b.q, rec.fields);
      { q: o.q, e: RecordUpdateExpression({ span: rec.span, base: b.e, fields: o.xs }) }
    },
    FieldExpression(f) -> {
      let o: QualifyResult = qualify_expr(resolved, qualifier, f.base);
      { q: o.q, e: FieldExpression({ span: f.span, base: o.e, field: f.field }) }
    },
    ListExpression(l) -> {
      let o = qualify_exprs(resolved, qualifier, l.items);
      { q: o.q, e: ListExpression({ span: l.span, items: o.xs }) }
    },
    LiteralExpression(_) -> { q: qualifier, e: expr },
    InvalidExpression(_) -> { q: qualifier, e: expr },
    _ -> { q: refused(qualifier, expr_span(expr)), e: expr },
  }

fn qualify_exprs(
  resolved: Resolution,
  qualifier: Qualifier,
  exprs: List<Expr>,
) -> { q: Qualifier, xs: List<Expr> } / {abort.raise} =
  exprs.fold({ q: qualifier, xs: [] }, |acc: { q: Qualifier, xs: List<Expr> }, expr: Expr| {
    let o = qualify_expr(resolved, acc.q, expr);
    { q: o.q, xs: acc.xs.push(o.e) }
  })

fn qualify_fields(
  resolved: Resolution,
  qualifier: Qualifier,
  fields: List<RecordLiteralField>,
) -> { q: Qualifier, xs: List<RecordLiteralField> } / {abort.raise} =
  fields.fold(
    { q: qualifier, xs: [] },
    |acc: { q: Qualifier, xs: List<RecordLiteralField> }, field: RecordLiteralField| {
      let o = qualify_expr(resolved, acc.q, field.value);
      { q: o.q, xs: acc.xs.push({ name: field.name, value: o.e }) }
    },
  )

fn decl_public(resolved: Resolution, owner: Int, name: Bytes) -> Bool / {abort.raise} =
  match lookup_declared(resolved.declarations.get(owner), ValueSpace, name) {
    Some(d) -> d.public,
    None -> false,
  }

// --- Defaults: the signatures ---------------------------------------------------------------

type SignatureCollection = {
  sigs: List<Parameters>,
  owner_imports: List<{ module: Int, binder: Bytes, target: Int }>,
  diags: List<Diag>,
}

fn collect_signatures(
  resolved: Resolution,
  mods: List<ParsedModule>,
) -> SignatureCollection / {abort.raise} =
  range(0, mods.len()).fold(
    { sigs: [], owner_imports: [], diags: [] },
    |acc: SignatureCollection, m: Int|
      mods.get(m).module.items.fold(acc, |c: SignatureCollection, item: Item|
        match item { FunctionItem(f) -> collect_signature(resolved, mods, m, c, f), _ -> c }),
  )

fn collect_signature(
  resolved: Resolution,
  mods: List<ParsedModule>,
  m: Int,
  c: SignatureCollection,
  def: FnDef,
) -> SignatureCollection / {abort.raise} = {
  let binders = if def.params.any(|param: Param| param.default != None) {
    item_binders(resolved, m, FunctionItem(def))
  } else { Map::new() };
  let params = def.params.map(|param: Param| param.name.span.site);
  let walked: { c: SignatureCollection, params: List<ParamInfo> } = def.params.fold(
    { c: c, params: [] },
    |acc: { c: SignatureCollection, params: List<ParamInfo> }, param: Param|
      match param.default {
        None ->
          { ..acc, params: acc.params.push({ name: param.name.name, default: None, imports: [] }) },
        Some(d) -> {
          let o = qualify_expr(
            resolved,
            {
              owner: m,
              public: is_pub(def.visibility),
              binders: binders,
              params: params,
              imports: [],
              diags: acc.c.diags,
              refused: false,
            },
            d,
          );
          if o.q.refused {
            {
              c: { ..acc.c, diags: o.q.diags },
              params: acc.params.push({ name: param.name.name, default: None, imports: [] }),
            }
          } else {
            // The writing module needs the binder as much as any caller does.
            let owner_imports = o.q.imports.fold(
              acc.c.owner_imports,
              |oi: List<{ module: Int, binder: Bytes, target: Int }>, binding: ModuleBinding|
                oi.push({ module: m, binder: binding.binder, target: binding.target }),
            );
            {
              c: { ..acc.c, diags: o.q.diags, owner_imports: owner_imports },
              params: acc.params.push({
                name: param.name.name,
                default: Some(o.e),
                imports: o.q.imports,
              }),
            }
          }
        },
      },
  );
  {
    ..walked.c,
    sigs: walked.c.sigs.push({
      name: qualify(mods.get(m).name, def.name.name),
      params: walked.params,
    }),
  }
}

/// The builtins that carry a default: `assert(cond, message: None)`.
fn builtin_signature(name: Bytes) -> Option<Parameters> =
  if name == b"assert" {
    Some({
      name: b"assert",
      params: [
        { name: b"cond", default: None, imports: [] },
        {
          name: b"message",
          default: Some(
            NameExpression({
              span: dummy_span(),
              name: {
                module: None,
                name: { name: none_ctor(), span: dummy_span() },
                span: dummy_span(),
              },
            }),
          ),
          imports: [],
        },
      ],
    })
  } else { None }

// --- Defaults: filling every call --------------------------------------------------------

type Filler = {
  module: Int,
  binders: Map<Int, Int>,
  implicit: List<ModuleBinding>,
  diags: List<Diag>,
}

type FillResult = { filler: Filler, expr: Expr }

type FillContext = { r: Resolution, index: Map<Bytes, Parameters> }

fn fill_expr(f: FillContext, filler: Filler, expr: Expr) -> FillResult / {abort.raise} = {
  // Children first, so a nested call is filled before the outer one copies it.
  let o = fill_children(f, filler, expr);
  match o.expr { CallExpression(a) -> fill_call(f, o.filler, a), _ -> o }
}

fn fill_children(f: FillContext, filler: Filler, expr: Expr) -> FillResult / {abort.raise} =
  match expr {
    LiteralExpression(_) -> { filler: filler, expr: expr },
    TaggedLiteralExpression(t) -> {
      let filled = t.holes.fold(
        { filler: filler, holes: [] },
        |acc: { filler: Filler, holes: List<Hole> }, h: Hole| {
          let o: FillResult = fill_expr(f, acc.filler, h.value);
          { filler: o.filler, holes: acc.holes.push({ ..h, value: o.expr }) }
        },
      );
      { filler: filled.filler, expr: TaggedLiteralExpression({ ..t, holes: filled.holes }) }
    },
    NameExpression(_) -> { filler: filler, expr: expr },
    HoleExpression(_) -> { filler: filler, expr: expr },
    InvalidExpression(_) -> { filler: filler, expr: expr },
    BinaryExpression(b) -> {
      let l = fill_expr(f, filler, b.lhs);
      let rr = fill_expr(f, l.filler, b.rhs);
      {
        filler: rr.filler,
        expr: BinaryExpression({ span: b.span, op: b.op, lhs: l.expr, rhs: rr.expr }),
      }
    },
    UnaryExpression(u) -> {
      let o: FillResult = fill_expr(f, filler, u.operand);
      { filler: o.filler, expr: UnaryExpression({ span: u.span, op: u.op, operand: o.expr }) }
    },
    LambdaExpression(l) -> {
      let o: FillResult = fill_expr(f, filler, l.body);
      {
        filler: o.filler,
        expr: LambdaExpression({ span: l.span, body: o.expr, params: l.params, ret: l.ret }),
      }
    },
    CallExpression(a) -> {
      let fn_ = fill_expr(f, filler, a.func);
      let args = fill_exprs(f, fn_.filler, a.args);
      let named = a.named.fold(
        { filler: args.filler, xs: [] },
        |acc: { filler: Filler, xs: List<NamedArg> }, arg: NamedArg| {
          let o = fill_expr(f, acc.filler, arg.value);
          { filler: o.filler, xs: acc.xs.push({ name: arg.name, value: o.expr, span: arg.span }) }
        },
      );
      {
        filler: named.filler,
        expr: CallExpression({
          span: a.span,
          func: fn_.expr,
          named: named.xs,
          args: args.xs,
          labels: a.labels,
        }),
      }
    },
    IfExpression(i) -> {
      let c = fill_expr(f, filler, i.cond);
      let t = fill_expr(f, c.filler, i.then_branch);
      let el = fill_expr(f, t.filler, i.else_branch);
      {
        filler: el.filler,
        expr: IfExpression({
          span: i.span,
          cond: c.expr,
          then_branch: t.expr,
          else_branch: el.expr,
        }),
      }
    },
    MatchExpression(m) -> {
      let s = fill_expr(f, filler, m.scrutinee);
      let arms = m.arms.fold(
        { filler: s.filler, xs: [] },
        |acc: { filler: Filler, xs: List<MatchArm> }, arm: MatchArm| {
          let g: { filler: Filler, expr: Option<Expr> } = match arm.guard {
            None -> { filler: acc.filler, expr: None },
            Some(x) -> {
              let o: FillResult = fill_expr(f, acc.filler, x);
              { filler: o.filler, expr: Some(o.expr) }
            },
          };
          let body: FillResult = fill_expr(f, g.filler, arm.body);
          {
            filler: body.filler,
            xs: acc.xs.push({ pat: arm.pat, guard: g.expr, body: body.expr, span: arm.span }),
          }
        },
      );
      {
        filler: arms.filler,
        expr: MatchExpression({ span: m.span, scrutinee: s.expr, arms: arms.xs }),
      }
    },
    BlockExpression(b) -> {
      let stmts: { filler: Filler, xs: List<Stmt> } = b.stmts.fold(
        { filler: filler, xs: [] },
        |acc: { filler: Filler, xs: List<Stmt> }, s: Stmt|
          match s {
            LetStatement(l) -> {
              let o: FillResult = fill_expr(f, acc.filler, l.value);
              {
                filler: o.filler,
                xs: acc.xs.push(
                  LetStatement({ span: l.span, pat: l.pat, ty: l.ty, value: o.expr }),
                ),
              }
            },
            LetElseStatement(l) -> {
              let o: FillResult = fill_expr(f, acc.filler, l.value);
              let fb: FillResult = fill_expr(f, o.filler, l.fallback);
              {
                filler: fb.filler,
                xs: acc.xs.push(LetElseStatement({ ..l, value: o.expr, fallback: fb.expr })),
              }
            },
            ExpressionStatement(x) -> {
              let o: FillResult = fill_expr(f, acc.filler, x);
              { filler: o.filler, xs: acc.xs.push(ExpressionStatement(o.expr)) }
            },
            AssignmentStatement(x) -> {
              let o: FillResult = fill_expr(f, acc.filler, x.value);
              { filler: o.filler, xs: acc.xs.push(AssignmentStatement({ ..x, value: o.expr })) }
            },
          },
      );
      let tail: { filler: Filler, expr: Option<Expr> } = match b.tail {
        None -> { filler: stmts.filler, expr: None },
        Some(t) -> {
          let o: FillResult = fill_expr(f, stmts.filler, t);
          { filler: o.filler, expr: Some(o.expr) }
        },
      };
      {
        filler: tail.filler,
        expr: BlockExpression({ span: b.span, tail: tail.expr, stmts: stmts.xs }),
      }
    },
    RecordExpression(rec) -> {
      let o = fill_fields(f, filler, rec.fields);
      { filler: o.filler, expr: RecordExpression({ span: rec.span, fields: o.xs }) }
    },
    RecordUpdateExpression(rec) -> {
      let b = fill_expr(f, filler, rec.base);
      let o = fill_fields(f, b.filler, rec.fields);
      {
        filler: o.filler,
        expr: RecordUpdateExpression({ span: rec.span, base: b.expr, fields: o.xs }),
      }
    },
    FieldExpression(fl) -> {
      let o: FillResult = fill_expr(f, filler, fl.base);
      { filler: o.filler, expr: FieldExpression({ span: fl.span, base: o.expr, field: fl.field }) }
    },
    ListExpression(l) -> {
      let o = fill_exprs(f, filler, l.items);
      { filler: o.filler, expr: ListExpression({ span: l.span, items: o.xs }) }
    },
    PropagateExpression(t) -> {
      let o: FillResult = fill_expr(f, filler, t.operand);
      { filler: o.filler, expr: PropagateExpression({ span: t.span, operand: o.expr }) }
    },
    PerformExpression(p) -> {
      let o = fill_exprs(f, filler, p.args);
      {
        filler: o.filler,
        expr: PerformExpression({
          span: p.span,
          effect_name: p.effect_name,
          op: p.op,
          resource: p.resource,
          args: o.xs,
        }),
      }
    },
    HandleExpression(h) -> {
      // The variables' first values are made before the body, where the `handle` stands.
      let vars: { filler: Filler, xs: List<HandlerVar> } = h.vars.fold(
        { filler: filler, xs: [] },
        |acc: { filler: Filler, xs: List<HandlerVar> }, v: HandlerVar| {
          let o: FillResult = fill_expr(f, acc.filler, v.init);
          { filler: o.filler, xs: acc.xs.push({ ..v, init: o.expr }) }
        },
      );
      let body: FillResult = fill_expr(f, vars.filler, h.body);
      let clauses: { filler: Filler, xs: List<HandleClause> } = h.clauses.fold(
        { filler: body.filler, xs: [] },
        |acc: { filler: Filler, xs: List<HandleClause> }, c: HandleClause| {
          let o: FillResult = fill_expr(f, acc.filler, c.body);
          {
            filler: o.filler,
            xs: acc.xs.push({
              effect_name: c.effect_name,
              op: c.op,
              resource: c.resource,
              every_label: c.every_label,
              label_binder: c.label_binder,
              resume: c.resume,
              body: o.expr,
              span: c.span,
              params: c.params,
            }),
          }
        },
      );
      let ret: { filler: Filler, expr: Option<ReturnClause> } = match h.ret {
        None -> { filler: clauses.filler, expr: None },
        Some(rc) -> {
          let o: FillResult = fill_expr(f, clauses.filler, rc.body);
          { filler: o.filler, expr: Some({ binder: rc.binder, body: o.expr, span: rc.span }) }
        },
      };
      {
        filler: ret.filler,
        expr: HandleExpression({
          span: h.span,
          body: body.expr,
          ret: ret.expr,
          clauses: clauses.xs,
          vars: vars.xs,
        }),
      }
    },
    WithHoldExpression(c) -> {
      let acquire: FillResult = fill_expr(f, filler, c.acquire);
      let release: FillResult = fill_expr(f, acquire.filler, c.release);
      let o: FillResult = fill_expr(f, release.filler, c.body);
      {
        filler: o.filler,
        expr: WithHoldExpression({
          ..c,
          acquire: acquire.expr,
          release: release.expr,
          body: o.expr,
        }),
      }
    },
    SimulateExpression(s) -> {
      let o: FillResult = fill_expr(f, filler, s.body);
      { filler: o.filler, expr: SimulateExpression({ span: s.span, body: o.expr }) }
    },
    TryBlockExpression(t) -> {
      let o: FillResult = fill_expr(f, filler, t.body);
      { filler: o.filler, expr: TryBlockExpression({ ..t, body: o.expr }) }
    },
    ParallelExpression(v) -> {
      let o = fill_exprs(f, filler, v.branches);
      { filler: o.filler, expr: ParallelExpression({ span: v.span, branches: o.xs }) }
    },
  }

fn fill_exprs(
  f: FillContext,
  filler: Filler,
  exprs: List<Expr>,
) -> { filler: Filler, xs: List<Expr> } / {abort.raise} =
  exprs.fold({ filler: filler, xs: [] }, |acc: { filler: Filler, xs: List<Expr> }, expr: Expr| {
    let o = fill_expr(f, acc.filler, expr);
    { filler: o.filler, xs: acc.xs.push(o.expr) }
  })

fn fill_fields(
  f: FillContext,
  filler: Filler,
  fields: List<RecordLiteralField>,
) -> { filler: Filler, xs: List<RecordLiteralField> } / {abort.raise} =
  fields.fold(
    { filler: filler, xs: [] },
    |acc: { filler: Filler, xs: List<RecordLiteralField> }, field: RecordLiteralField| {
      let o = fill_expr(f, acc.filler, field.value);
      { filler: o.filler, xs: acc.xs.push({ name: field.name, value: o.expr }) }
    },
  )

fn signature_of(f: FillContext, filler: Filler, func: Expr) -> Option<Parameters> / {abort.raise} =
  match func {
    NameExpression(v) ->      // Constructors carry no defaults; a local binder shadows everything, making this a call through a value.
      if is_bare(v.name) && starts_upper(v.name.name.name) { None }
      else if is_bare(v.name) && filler.binders.contains(v.name.name.span.site) { None } else {
        match find(f.r, filler.module, ValueSpace, v.name) {
          Some(b) -> f.index.get(b.qualified),
          None -> if is_bare(v.name) { builtin_signature(v.name.name.name) } else { None },
        }
      },
    _ -> None,
  }

type Call = { span: Span, func: Expr, named: List<NamedArg>, args: List<Expr>, labels: List<Ident> }

/// The perform `call` is, where it is written on a bare name nothing binds and names an
/// argument: an operation takes none by name, so each is refused and dropped.
fn as_perform(filler: Filler, call: Call, on: Expr, op: Ident) -> Option<FillResult> =
  match on {
    NameExpression(v) -> if call.named.len() == 0
        || (is_bare(v.name) && filler.binders.contains(v.name.name.span.site)) { None } else {
      let written = match v.name.module {
        Some(m) -> Bytes::concat_all([m.name, b"::", v.name.name.name]),
        None -> v.name.name.name,
      };
      Some({
        filler: {
          ..filler,
          diags: call.named.fold(filler.diags, |ds: List<Diag>, arg: NamedArg|
            ds.push(
              error_at(
                b"E0123",
                filler.module,
                arg.span,
                Bytes::concat_all([b"`", written, b".", op.name, b"` takes no named arguments"]),
                b"named",
                [b"an effect operation's arguments are positional"],
              ),
            )),
        },
        expr: PerformExpression({
          span: call.span,
          effect_name: v.name,
          op: op,
          resource: call.labels.at(0),
          args: call.args,
        }),
      })
    },
    _ -> None,
  }

fn fill_call(f: FillContext, filler: Filler, call: Call) -> FillResult / {abort.raise} =
  match call.func {
    // A call on a value: the checker finds its callee by the value's type, and fills it then.
    FieldExpression(on) -> match as_perform(filler, call, on.base, on.field) {
      Some(p) -> p,
      None -> { filler: filler, expr: CallExpression(call) },
    },
    _ -> fill_by_signature(f, filler, call),
  }

fn fill_by_signature(f: FillContext, filler: Filler, call: Call) -> FillResult / {abort.raise} =
  match signature_of(f, filler, call.func) {
    None -> {
      // No signature: a call through a value, a constructor or an unresolved name, so a named argument names no parameter.
      let diags = call.named.fold(filler.diags, |ds: List<Diag>, arg: NamedArg|
        ds.push(
          error_at(
            b"E0123",
            filler.module,
            arg.name.span,
            Bytes::concat_all([b"`", arg.name.name, b"` names no parameter here"]),
            b"no signature to match this against",
            [
              b"a named argument needs a callee reached by name; a call through a value, a lambda or a constructor is positional",
            ],
          ),
        ));
      { filler: { ..filler, diags: diags }, expr: CallExpression({ ..call, named: [] }) }
    },
    Some(sig) ->      // Over-application is `E0202`'s to report, with the callee's own type in hand.
      if call.args.len() > sig.params.len() {
        { filler: filler, expr: CallExpression({ ..call, named: [] }) }
      } else { fill_slots(filler, call, sig) },
  }

/// What a call of `signature` at `span` in `module` passes, `args` and then `named` put where its
/// parameters are: the arguments in order, as written where one is left unfilled, and where each
/// comes from, nothing where one is; what the call gets wrong; and the modules the defaults it
/// copied name.
pub type PlacedArguments = {
  args: List<Expr>,
  slots: List<Slot>,
  diags: List<Diag>,
  imports: List<ModuleBinding>,
}

pub fn place_arguments(
  module: Int,
  span: Span,
  signature: Parameters,
  args: List<Expr>,
  named: List<NamedArg>,
) -> PlacedArguments / {abort.raise} = {
  let s = slotted(
    signature.params.map(|p: ParamInfo| p.name),
    signature.params.map(|p: ParamInfo| p.default),
    args,
    named,
    span,
  );
  let unplaced = s.unplaced.map(|u: { arg: NamedArg, reason: UnmatchedReason }|
    match u.reason {
      NoSuchParameter ->
        error_at(
          b"E0123",
          module,
          u.arg.name.span,
          Bytes::concat_all([b"`", u.arg.name.name, b"` names no parameter of this function"]),
          b"not a parameter",
          [b"the parameters are ".concat(list_names(signature.params.map(|p: ParamInfo| p.name)))],
        ),
      why ->
        error_at(
          b"E0123",
          module,
          u.arg.name.span,
          Bytes::concat_all([
            b"`",
            u.arg.name.name,
            b"` is ",
            if why == FilledByPosition { b"already filled by a positional argument" }
            else { b"already given by name" },
          ]),
          b"given twice",
          [],
        ),
    });
  {
    args: if s.missing.len() > 0 { args } else { ordered_arguments(s.slots, args, named) },
    slots: if s.missing.len() > 0 { [] } else { s.slots },
    // A call with no names in it that leaves a hole is under-applied, which is `E0202`'s.
    diags: if s.missing.len() == 0 || named.len() == 0 { unplaced } else {
      unplaced.push(
        error_at(
          b"E0125",
          module,
          span,
          Bytes::concat_all([b"this call leaves ", list_names(s.missing), b" unfilled"]),
          b"no argument and no default",
          [b"pass it positionally, or by name as `<parameter>: <value>`"],
        ),
      )
    },
    // The default may name something in its own module, which this one may never have imported.
    imports: range(0, s.slots.len()).fold([], |im: List<ModuleBinding>, i: Int|
      match s.slots.get(i) {
        FromDefault(_) ->
          signature.params.get(i).imports.fold(
            im,
            |acc: List<ModuleBinding>, binding: ModuleBinding|
              match find_module_binding(acc, binding.binder) {
                Some(_) -> acc,
                None -> acc.push(binding),
              },
          ),
        _ -> im,
      }),
  }
}

fn fill_slots(filler: Filler, call: Call, signature: Parameters) -> FillResult / {abort.raise} = {
  let filled = place_arguments(filler.module, call.span, signature, call.args, call.named);
  {
    filler: {
      ..filler,
      diags: filler.diags.concat(filled.diags),
      implicit: filled.imports.fold(filler.implicit, |im: List<ModuleBinding>, b: ModuleBinding|
        match find_module_binding(im, b.binder) { Some(_) -> im, None -> im.push(b) }),
    },
    expr: CallExpression({ ..call, args: filled.args, named: [] }),
  }
}

fn fill_item(
  f: FillContext,
  filler: Filler,
  item: Item,
) -> { filler: Filler, it: Item } / {abort.raise} =
  match item {
    FunctionItem(d) -> {
      // A default is not walked here: it was qualified against this module in `collect_signatures`.
      let spec: { filler: Filler, xs: List<SpecClause> } = d.spec.fold(
        { filler: filler, xs: [] },
        |acc: { filler: Filler, xs: List<SpecClause> }, clause: SpecClause| {
          let o = fill_expr(f, acc.filler, clause.expr);
          { filler: o.filler, xs: acc.xs.push({ ..clause, expr: o.expr }) }
        },
      );
      let measured: { filler: Filler, expr: Option<Expr> } = match d.decreases {
        None -> { filler: spec.filler, expr: None },
        Some(e) -> {
          let o = fill_expr(f, spec.filler, e);
          { filler: o.filler, expr: Some(o.expr) }
        },
      };
      let body: FillResult = fill_expr(f, measured.filler, d.body);
      {
        filler: body.filler,
        it: FunctionItem({
          visibility: d.visibility,
          name: d.name,
          generics: d.generics,
          params: d.params,
          ret: d.ret,
          effects: d.effects,
          constraints: d.constraints,
          spec: spec.xs,
          returns: d.returns,
          reuse: d.reuse,
          transparent: d.transparent,
          constant: d.constant,
          decreases: measured.expr,
          body: body.expr,
          doc: d.doc,
          span: d.span,
        }),
      }
    },
    TestItem(d) -> match d.cases {
      None -> {
        let o: FillResult = fill_expr(f, filler, d.body);
        { filler: o.filler, it: TestItem({ ..d, body: o.expr }) }
      },
      Some(c) -> {
        let table: FillResult = fill_expr(f, filler, c.table);
        let label: FillResult = fill_expr(f, table.filler, c.label);
        let body: FillResult = fill_expr(f, label.filler, d.body);
        {
          filler: body.filler,
          it: TestItem({
            ..d,
            cases: Some({ ..c, table: table.expr, label: label.expr }),
            body: body.expr,
          }),
        }
      },
    },
    LawItem(d) -> {
      let g = match d.guard {
        None -> { filler: filler, expr: None },
        Some(x) -> {
          let o: FillResult = fill_expr(f, filler, x);
          { filler: o.filler, expr: Some(o.expr) }
        },
      };
      let body: FillResult = fill_expr(f, g.filler, d.body);
      { filler: body.filler, it: LawItem({ ..d, guard: g.expr, body: body.expr }) }
    },
    _ -> { filler: filler, it: item },
  }

pub type ResolvedProgram = { r: Resolution, mods: List<ParsedModule>, diags: List<Diag> }

/// The signatures, then every module's calls, then the modules a spliced default made each one reference.
pub fn fill_defaults(
  r: Resolution,
  mods: List<ParsedModule>,
  diags: List<Diag>,
) -> ResolvedProgram / {abort.raise} = {
  let c = collect_signatures(r, mods);
  let r2 = c.owner_imports.fold(
    r,
    |acc: Resolution, oi: { module: Int, binder: Bytes, target: Int }|
      add_module_binding(acc, oi.module, oi.binder, oi.target),
  );
  // Indexed once: a list lookup per call is quadratic in the program. First writer wins.
  let f = {
    r: r2,
    index: c.sigs.fold(Map::new(), |acc: Map<Bytes, Parameters>, signature: Parameters|
      match acc.get(signature.name) {
        Some(_) -> acc,
        None -> acc.insert(signature.name, signature),
      }),
  };
  let walked = range(0, mods.len()).fold(
    { r: r2, mods: [], diags: concat_diagnostics(diags, c.diags) },
    |acc: ResolvedProgram, m: Int| {
      let mod: ParsedModule = mods.get(m);
      let items: { filler: Filler, xs: List<Item> } = mod.module.items.fold(
        { filler: { module: m, binders: Map::new(), implicit: [], diags: acc.diags }, xs: [] },
        |ia: { filler: Filler, xs: List<Item> }, item: Item| {
          let o = fill_item(f, { ..ia.filler, binders: item_binders(f.r, m, item) }, item);
          { filler: o.filler, xs: ia.xs.push(o.it) }
        },
      );
      let reached = items.filler.implicit.fold(acc.r, |rr: Resolution, binding: ModuleBinding|
        add_module_binding(rr, m, binding.binder, binding.target));
      {
        r: reached,
        mods: acc.mods.push({
          name: mod.name,
          module: { ..mod.module, items: items.xs },
          derived: mod.derived,
        }),
        diags: items.filler.diags,
      }
    },
  );
  {
    ..walked,
    r: {
      ..walked.r,
      signatures: f.index,
      visible_modules: range(0, mods.len()).map(|m: Int| {
        let seen = transitive_imports(walked.r.imports, m);
        if !sees_homes(mods.get(m).name) { seen } else {
          range(0, mods.len()).fold(seen, |acc: List<Int>, k: Int|
            if !acc.contains(k) && home_modules().contains(mods.get(k).name) { acc.push(k) }
            else { acc })
        }
      }),
    },
  }
}

fn transitive_imports(imports: List<List<Int>>, m: Int) -> List<Int> / {abort.raise} =
  iterate({ seen: [m], work: [m] }, 1000000, |s: { seen: List<Int>, work: List<Int> }|
    match s.work {
      [] -> Stop(s.seen),
      [k, ..rest] ->
        Continue(
          List::fold(
            match imports.at(k) { Some(ts) -> ts, None -> [] },
            { seen: s.seen, work: rest },
            |acc: { seen: List<Int>, work: List<Int> }, t: Int|
              if acc.seen.contains(t) { acc }
              else { { seen: acc.seen.push(t), work: acc.work.push(t) } },
          ),
        ),
    })

/// `r` as a check against entries reads it. Every module of one is there because the module
/// checked reads it, and each that stands in for another holds what was named of it, a transparent
/// function's body among that, under imports cut to fewer than the body's calls were found
/// through. So each sees them all.
pub fn make_all_visible(r: Resolution) -> Resolution =
  { ..r, visible_modules: r.scopes.map(|_: Scope| range(0, r.scopes.len())) }

// --- Tests ------------------------------------------------------------------
