//! Effect sets and law schemas: what a set holds and what an instantiation of a schema states.

import compiler.syntax.parsing (Span, Ident, QName, dummy_span, is_bare, span_between)
import compiler.syntax.type_syntax (TypeExpr, TVar, TCon, TFn, TRecord, RowExpr, AtomExpr, MRead, mode_text)
import compiler.syntax.items (Module, Item, IFn, IType, IEffect, ITest, ILaw, IEffectSet, Cases, TDSum,
                     TDAlias, VariantDef, SpecClause, Binder, EffectSetDef, OpDef, LawDef, OfSchema,
                     SchemaDef, SchemaIdentity, schema_named, schema_guard_name, law_type_variables,
                     TDNominal, TDExtern)
import compiler.syntax.exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord,
                     ERecordUpdate, ETry, EField, EList, EPerform, EHandle, EWithHold, ESimulate,
                     EParallel, EBad, EHole, ETryBlock, Stmt, SLet, SLetElse, SExpr, SAssign, Param,
                     NamedArg, MatchArm, HandleClause, HandlerVar, RecField, ETagged, Hole)
import compiler.syntax.patterns (Pattern, PWild, PVar, PLit, PRange, PCtor, PRecord, PList, POr, PBad)
import std.list
import std.bytes (ascii_of_int)
import compiler.check.resolve.tables (ParsedModule, EffectSpace, SetSpace, ValueSpace, Declared,
                                      Binding, ModuleBinding, Scope, Label, Diag, Resolved,
                                      lookup_declared, lookup, find_module_binding, position,
                                      qualify, label_at, error_with_labels, error_at, error_at_and,
                                      backticked)
import compiler.check.resolve.scopes (private_name, find)

// --- Defaults: what a default may be -----------------------------------------------------

pub fn pattern_binders(p: Pattern, out: List<Bytes>) -> List<Bytes> =
  match p {
    PVar(v) -> out.push(v.name.name),
    PCtor(c) -> c.args.fold(out, |acc: List<Bytes>, a: Pattern| pattern_binders(a, acc)),
    PRecord(r) ->
      r.fields.fold(out, |acc: List<Bytes>, f: { name: Ident, pat: Pattern }|
        pattern_binders(f.pat, acc)),
    PList(l) -> {
      let items = l.items.fold(out, |acc: List<Bytes>, x: Pattern| pattern_binders(x, acc));
      match l.rest { None -> items, Some(r) -> pattern_binders(r, items) }
    },
    POr(o) -> o.alts.fold(out, |acc: List<Bytes>, a: Pattern| pattern_binders(a, acc)),
    PWild(_) -> out,
    PLit(_) -> out,
    PRange(_) -> out,
    PBad(_) -> out,
  }

/// Which of `params` the expression names free, in evaluation order.
pub fn mentions(e: Expr, params: List<Bytes>, bound: List<Bytes>, out: List<Bytes>) -> List<Bytes> =
  match e {
    EHole(_) -> out,
    EVar(v) -> if is_bare(v.name) && !bound.contains(v.name.name.name)
        && params.contains(v.name.name.name) { out.push(v.name.name.name) }
    else { out },
    ELambda(l) ->
      mentions(
        l.body,
        params,
        l.params.fold(bound, |acc: List<Bytes>, p: Param| acc.push(p.name.name)),
        out,
      ),
    EApp(a) -> {
      let o1 = mentions(a.func, params, bound, out);
      let o2 = a.args.fold(o1, |acc: List<Bytes>, x: Expr| mentions(x, params, bound, acc));
      a.named.fold(o2, |acc: List<Bytes>, arg: NamedArg| mentions(arg.value, params, bound, acc))
    },
    EBinary(b) -> mentions(b.rhs, params, bound, mentions(b.lhs, params, bound, out)),
    EUnary(u) -> mentions(u.operand, params, bound, out),
    EIf(i) ->
      mentions(
        i.else_branch,
        params,
        bound,
        mentions(i.then_branch, params, bound, mentions(i.cond, params, bound, out)),
      ),
    EMatch(m) ->
      m.arms.fold(mentions(m.scrutinee, params, bound, out), |acc: List<Bytes>, arm: MatchArm| {
        let inner = pattern_binders(arm.pat, bound);
        let g = match arm.guard { None -> acc, Some(x) -> mentions(x, params, inner, acc) };
        mentions(arm.body, params, inner, g)
      }),
    EBlock(b) -> {
      let walked = b.stmts.fold(
        { bound: bound, out: out },
        |acc: { bound: List<Bytes>, out: List<Bytes> }, s: Stmt|
          match s {
            SLet(l) ->
              {
                bound: pattern_binders(l.pat, acc.bound),
                out: mentions(l.value, params, acc.bound, acc.out),
              },
            // The `else` block runs where the pattern bound nothing.
            SLetElse(l) ->
              {
                bound: pattern_binders(l.pat, acc.bound),
                out: mentions(
                  l.fallback,
                  params,
                  acc.bound,
                  mentions(l.value, params, acc.bound, acc.out),
                ),
              },
            SExpr(x) -> { ..acc, out: mentions(x, params, acc.bound, acc.out) },
            SAssign(x) -> { ..acc, out: mentions(x.value, params, acc.bound, acc.out) },
          },
      );
      match b.tail { None -> walked.out, Some(t) -> mentions(t, params, walked.bound, walked.out) }
    },
    ERecord(r) ->
      r.fields.fold(out, |acc: List<Bytes>, f: RecField| mentions(f.value, params, bound, acc)),
    ERecordUpdate(r) ->
      r.fields.fold(mentions(r.base, params, bound, out), |acc: List<Bytes>, f: RecField|
        mentions(f.value, params, bound, acc)),
    EField(f) -> mentions(f.base, params, bound, out),
    EList(l) -> l.items.fold(out, |acc: List<Bytes>, x: Expr| mentions(x, params, bound, acc)),
    ETry(t) -> mentions(t.operand, params, bound, out),
    EPerform(p) -> p.args.fold(out, |acc: List<Bytes>, x: Expr| mentions(x, params, bound, acc)),
    EHandle(h) ->
      mentions(
        h.body,
        params,
        bound,
        h.vars.fold(
          { out: out, bound: bound },
          |acc: { out: List<Bytes>, bound: List<Bytes> }, v: HandlerVar|
            {
              out: mentions(v.init, params, acc.bound, acc.out),
              bound: acc.bound.push(v.name.name),
            },
        ).out,
      ),
    EWithHold(c) ->
      mentions(
        c.body,
        params,
        bound,
        mentions(c.release, params, bound, mentions(c.acquire, params, bound, out)),
      ),
    ESimulate(s) -> mentions(s.body, params, bound, out),
    ETryBlock(t) -> mentions(t.body, params, bound, out),
    EParallel(v) ->
      v.branches.fold(out, |acc: List<Bytes>, x: Expr| mentions(x, params, bound, acc)),
    ELit(_) -> out,
    ETagged(_) -> out,
    EBad(_) -> out,
  }

// --- Effect sets ---------------------------------------------------------------------------

// A set stands for its atoms, each meaning what it means in the module that wrote it. A row of that
// module gets them as written; a row anywhere else gets them through the module that declares the
// effect, which the row's module then reaches under a binder no import can write, so no import of
// its own can stand in for it.

pub fn reached_binder(module: Bytes) -> Bytes = b"@".concat(module)

/// One atom a set stands for, and the module whose scope wrote it.
type Member = { atom: AtomExpr, home: Int }

/// A set of the program: its item and module, the sets it includes, whether it lies on a cycle, and
/// once expanded every atom it stands for.
type SetNode = {
  def: EffectSetDef,
  module: Int,
  includes: List<Option<Int>>,
  cyclic: Bool,
  members: List<Member>,
}

/// Each module's sets by name; the first declaration of a name is the set.
type SetTable = { nodes: List<SetNode>, by_module: List<Map<Bytes, Int>>, diags: List<Diag> }

fn set_table(mods: List<ParsedModule>) -> SetTable / {abort.raise} =
  range(0, mods.len()).fold({ nodes: [], by_module: [], diags: [] }, |table: SetTable, m: Int|
    mods.get(m).module.items.fold(
      { ..table, by_module: table.by_module.push(Map::new()) },
      |acc: SetTable, item: Item|
        match item {
          IEffectSet(d) -> {
            let mine = acc.by_module.get(m);
            match mine.get(d.name.name) {
              Some(first) ->
                {
                  ..acc,
                  diags: acc.diags.push(
                    error_at_and(
                      b"E0105",
                      m,
                      d.name.span,
                      Bytes::concat_all([b"duplicate effect set `", d.name.name, b"`"]),
                      b"redefined here",
                      m,
                      acc.nodes.get(first).def.name.span,
                      b"first defined here",
                      [b"rename one of them; every effect set in a module needs a distinct name"],
                    ),
                  ),
                },
              None ->
                {
                  ..acc,
                  by_module: acc.by_module.set(m, mine.insert(d.name.name, acc.nodes.len())),
                  nodes: acc.nodes.push({
                    def: d,
                    module: m,
                    includes: [],
                    cyclic: false,
                    members: [],
                  }),
                },
            }
          },
          _ -> acc,
        },
    ))

fn unknown_set(resolved: Resolved, m: Int, qname: QName) -> Diag / {abort.raise} = {
  let scope = resolved.scopes.get(m);
  let n = qname.name.name;
  let effect_notes = match lookup(scope.bound, EffectSpace, n) {
    Some(_) ->
      [
        Bytes::concat_all([
          b"`",
          n,
          b"` is an effect, and a member of a set is an atom: write `",
          n,
          b".read[..]` or `",
          n,
          b".write[..]`",
        ]),
        b"a whole effect is every resource label anywhere in the program, so naming one would let an unrelated module change this row and therefore this definition's hash",
      ],
    None -> [],
  };
  let named = scope.bound.sets.map(|binding: Binding| binding.name);
  let known = if named.len() == 0 {
    b"this module names no `effect set`: declare one, or import one by name from the module that declares it `pub`"
  } else { b"the sets this module names: ".concat(backticked(named, b", ")) };
  error_at(
    b"E0114",
    m,
    qname.span,
    Bytes::concat_all([b"no `effect set` named `", n, b"` here"]),
    b"neither declared nor imported here",
    effect_notes.push(known),
  )
}

/// `diverges` in a row is an atom with no operation to name, rather than a set.
fn is_diverges_name(qname: QName) -> Bool = qname.module == None && qname.name.name == b"diverges"

fn diverges_expr(qname: QName) -> AtomExpr =
  {
    eff: qname,
    mode: MRead,
    op: None,
    resource: None,
    every: false,
    bounded: false,
    span: qname.span,
  }

/// The set `qname` names in module `m`: one it declares or imports by name, or one a module binder reaches.
fn set_named(
  resolved: Resolved,
  table: SetTable,
  m: Int,
  qname: QName,
) -> Result<Int, Diag> / {abort.raise} = {
  let scope = resolved.scopes.get(m);
  let name = qname.name.name;
  match qname.module {
    None -> match lookup(scope.bound, SetSpace, name) {
      Some(b) -> match table.by_module.get(b.owner).get(name) {
        Some(id) -> Ok(id),
        None -> Err(unknown_set(resolved, m, qname)),
      },
      None -> Err(unknown_set(resolved, m, qname)),
    },
    Some(binder) -> match find_module_binding(scope.modules, binder.name) {
      None ->
        Err(
          error_at(
            b"E0114",
            m,
            qname.span,
            Bytes::concat_all([b"no module is imported as `", binder.name, b"`"]),
            b"not a module imported by this file",
            [b"import the module that declares the set, or import the set by name"],
          ),
        ),
      Some(mb) -> {
        let module = resolved.scopes.get(mb.target).module;
        match lookup_declared(resolved.declarations.get(mb.target), SetSpace, name) {
          None -> {
            let exported = resolved.declarations.get(mb.target).sets.filter(|d: Declared|
              d.public).map(|d: Declared| d.name);
            Err(
              error_at(
                b"E0114",
                m,
                qname.span,
                Bytes::concat_all([
                  b"module `",
                  module,
                  b"` declares no `effect set` named `",
                  name,
                  b"`",
                ]),
                Bytes::concat_all([b"not found in `", module, b"`"]),
                [
                  if exported.len() == 0 {
                    Bytes::concat_all([b"`", module, b"` exports no effect set"])
                  } else {
                    Bytes::concat_all([b"`", module, b"` exports ", backticked(exported, b", ")])
                  },
                ],
              ),
            )
          },
          Some(d) -> if !d.public && mb.target != m {
            Err(private_name(m, qname.span, mb.target, d.span, SetSpace, name, module))
          } else {
            match table.by_module.get(mb.target).get(name) {
              Some(id) -> Ok(id),
              None -> Err(unknown_set(resolved, m, qname)),
            }
          },
        }
      },
    },
  }
}

fn set_includes(resolved: Resolved, table: SetTable) -> SetTable / {abort.raise} =
  range(0, table.nodes.len()).fold(table, |acc: SetTable, id: Int| {
    let node = acc.nodes.get(id);
    let walked = node.def.includes.fold(
      { diags: acc.diags, xs: [] },
      |w: { diags: List<Diag>, xs: List<Option<Int>> }, qname: QName|
        match set_named(resolved, acc, node.module, qname) {
          Ok(i) -> { ..w, xs: w.xs.push(Some(i)) },
          Err(d) -> { diags: w.diags.push(d), xs: w.xs.push(None) },
        },
    );
    { ..acc, diags: walked.diags, nodes: acc.nodes.set(id, { ..node, includes: walked.xs }) }
  })

type SetSearch = {
  color: List<Int>,
  path: List<Int>,
  work: List<{ node: Int, next: Int }>,
  t: SetTable,
}

fn set_cycles(table: SetTable) -> SetTable / {abort.raise} = {
  let n = table.nodes.len();
  let steps = table.nodes.fold(0, |acc: Int, node: SetNode| acc + node.includes.len());
  let start: SetSearch = { color: range(0, n).map(|i: Int| 0), path: [], work: [], t: table };
  let done = range(0, n).fold(start, |d: SetSearch, root: Int|
    if d.color.get(root) != 0 { d } else {
      let opened: SetSearch = {
        ..d,
        color: d.color.set(root, 1),
        path: d.path.push(root),
        work: [{ node: root, next: 0 }],
      };
      iterate(opened, 2 * (n + steps) + 4, |x: SetSearch|
        if x.work.len() == 0 { Stop(x) } else { Continue(set_search_step(x)) })
    });
  done.t
}

fn set_search_step(d: SetSearch) -> SetSearch / {abort.raise} = {
  let top = d.work.get(d.work.len() - 1);
  let rest = d.work.take(d.work.len() - 1);
  let out = d.t.nodes.get(top.node).includes;
  if top.next >= out.len() {
    { ..d, color: d.color.set(top.node, 2), work: rest, path: d.path.take(d.path.len() - 1) }
  } else {
    let advanced = rest.push({ node: top.node, next: top.next + 1 });
    match out.get(top.next) {
      None -> { ..d, work: advanced },
      Some(target) -> {
        let c = d.color.get(target);
        if c == 0 {
          {
            ..d,
            work: advanced.push({ node: target, next: 0 }),
            color: d.color.set(target, 1),
            path: d.path.push(target),
          }
        } else if c == 1 {
          let st = match position(d.path, target) { Some(p) -> p, None -> 0 };
          let cycle = d.path.drop(st);
          let t2 = {
            ..d.t,
            diags: d.t.diags.push(set_cycle(d.t, cycle)),
            nodes: cycle.fold(d.t.nodes, |ns: List<SetNode>, i: Int|
              ns.set(i, { ..ns.get(i), cyclic: true })),
          };
          { ..d, work: advanced, t: t2 }
        } else { { ..d, work: advanced } }
      },
    }
  }
}

fn set_cycle(table: SetTable, cycle: List<Int>) -> Diag / {abort.raise} = {
  let head = table.nodes.get(cycle.get(0));
  let others = cycle.drop(1);
  let names = cycle.map(|i: Int| table.nodes.get(i).def.name.name).push(head.def.name.name);
  let primary = if cycle.len() == 1 { b"this set names itself" } else {
    Bytes::concat_all([
      b"expands through ",
      backticked(others.map(|i: Int| table.nodes.get(i).def.name.name), b", "),
      b" and back",
    ])
  };
  error_with_labels(
    b"E0115",
    Bytes::concat_all([b"effect set `", head.def.name.name, b"` contains itself"]),
    others.fold(
      [label_at(head.module, head.def.name.span, true, primary)],
      |labels: List<Label>, i: Int|
        labels.push(
          label_at(
            table.nodes.get(i).module,
            table.nodes.get(i).def.name.span,
            false,
            b"on the cycle",
          ),
        ),
    ),
    [
      b"the cycle is ".concat(backticked(names, b" -> ")),
      b"expansion is a fixed point, and a cycle has none: break it by inlining the atoms one of these sets needs",
    ],
  )
}

/// The module that declares the effect `qname` names in `home`, and its name there: none for a prelude
/// effect, or one nothing declares.
fn effect_owner(
  resolved: Resolved,
  home: Int,
  qname: QName,
) -> Option<{ target: Int, name: Bytes }> / {abort.raise} = {
  let scope = resolved.scopes.get(home);
  match qname.module {
    Some(b) -> match find_module_binding(scope.modules, b.name) {
      Some(mb) -> match lookup_declared(
          resolved.declarations.get(mb.target),
          EffectSpace,
          qname.name.name,
        ) {
        Some(_) -> Some({ target: mb.target, name: qname.name.name }),
        None -> None,
      },
      None -> None,
    },
    None -> match lookup(scope.bound, EffectSpace, qname.name.name) {
      Some(b) -> Some({ target: b.owner, name: b.name }),
      None -> None,
    },
  }
}

/// What an atom names, wherever it was written: its effect's program-wide name, mode, operation and label.
fn member_key(resolved: Resolved, member: Member) -> Bytes / {abort.raise} = {
  let a = member.atom;
  let eff = match effect_owner(resolved, member.home, a.eff) {
    Some(o) -> qualify(resolved.scopes.get(o.target).module, o.name),
    None -> match a.eff.module {
      Some(b) -> Bytes::concat_all([b.name, b"::", a.eff.name.name]),
      None -> a.eff.name.name,
    },
  };
  Bytes::concat_all([
    eff,
    b" ",
    mode_text(a.mode),
    b" ",
    match a.op { Some(o) -> o.name, None -> b"" },
    b" ",
    if a.every { b"*" } else { match a.resource { Some(x) -> x.name, None -> b"" } },
  ])
}

type KeyedMember = { key: Bytes, member: Member }

fn insert_keyed(sorted: List<KeyedMember>, k: KeyedMember) -> List<KeyedMember> / {abort.raise} = {
  let n = sorted.len();
  let i = range(0, n).fold(n, |acc: Int, j: Int|
    if acc < n { acc } else if compare(k.key, sorted.get(j).key) == Less { j } else { acc });
  sorted.drop(i).fold(sorted.take(i).push(k), |acc: List<KeyedMember>, x: KeyedMember| acc.push(x))
}

/// Ordered by what each atom names; of two that name the same, the first written is kept.
fn canonical_members(resolved: Resolved, xs: List<Member>) -> List<Member> / {abort.raise} = {
  let sorted = xs.fold([], |acc: List<KeyedMember>, member: Member|
    insert_keyed(acc, { key: member_key(resolved, member), member: member }));
  sorted.fold([], |acc: List<KeyedMember>, keyed: KeyedMember|
    if acc.len() > 0 && acc.get(acc.len() - 1).key == keyed.key { acc }
    else { acc.push(keyed) }).map(|keyed: KeyedMember| keyed.member)
}

type SetWork = { t: SetTable, done: List<Bool>, work: List<{ node: Int, visited: Bool }> }

fn set_expand_all(resolved: Resolved, table: SetTable) -> SetTable / {abort.raise} = {
  let n = table.nodes.len();
  let steps = table.nodes.fold(0, |acc: Int, node: SetNode| acc + node.includes.len());
  let start: SetWork = { t: table, done: range(0, n).map(|i: Int| false), work: [] };
  let finished = range(0, n).fold(start, |x: SetWork, root: Int|
    if x.done.get(root) || x.t.nodes.get(root).cyclic { x } else {
      iterate({ ..x, work: [{ node: root, visited: false }] }, 4 * (n + steps) + 4, |y: SetWork|
        if y.work.len() == 0 { Stop(y) } else { Continue(set_expand_step(resolved, y)) })
    });
  finished.t
}

fn set_expand_step(resolved: Resolved, x: SetWork) -> SetWork / {abort.raise} = {
  let top = x.work.get(x.work.len() - 1);
  let rest = x.work.take(x.work.len() - 1);
  let node = x.t.nodes.get(top.node);
  if x.done.get(top.node) || node.cyclic { { ..x, work: rest } } else if !top.visited {
    let pushed = node.includes.fold(
      rest.push({ node: top.node, visited: true }),
      |w: List<{ node: Int, visited: Bool }>, e: Option<Int>|
        match e {
          Some(i) -> if !x.done.get(i) && !x.t.nodes.get(i).cyclic {
            w.push({ node: i, visited: false })
          } else { w },
          None -> w,
        },
    );
    { ..x, work: pushed }
  } else {
    let own = node.def.atoms.map(|atom: AtomExpr| { atom: atom, home: node.module });
    let all = node.includes.fold(own, |acc: List<Member>, e: Option<Int>|
      match e {
        Some(i) ->
          x.t.nodes.get(i).members.fold(acc, |ms: List<Member>, member: Member| ms.push(member)),
        None -> acc,
      });
    {
      ..x,
      work: rest,
      done: x.done.set(top.node, true),
      t: {
        ..x.t,
        nodes: x.t.nodes.set(top.node, { ..node, members: canonical_members(resolved, all) }),
      },
    }
  }
}

fn moved_to(atom: AtomExpr, span: Span) -> AtomExpr =
  {
    eff: {
      module: match atom.eff.module { Some(b) -> Some({ name: b.name, span: span }), None -> None },
      name: { name: atom.eff.name.name, span: span },
      span: span,
    },
    mode: atom.mode,
    op: match atom.op { Some(o) -> Some({ name: o.name, span: span }), None -> None },
    resource: match atom.resource { Some(x) -> Some({ name: x.name, span: span }), None -> None },
    every: atom.every,
    bounded: atom.bounded,
    span: span,
  }

type Usable = { atom: AtomExpr, bind: Option<ModuleBinding> }

/// A member as module `m` writes it at `span`: as written in its own module, and through the module
/// that declares its effect anywhere else. An effect that resolves to no module, a prelude one or a
/// misspelling, keeps its written name, and the checker answers for it where the set is named.
fn usable(resolved: Resolved, m: Int, member: Member, span: Span) -> Usable / {abort.raise} =
  if member.home == m { { atom: member.atom, bind: None } } else {
    let moved = moved_to(member.atom, span);
    match effect_owner(resolved, member.home, member.atom.eff) {
      None -> { atom: moved, bind: None },
      Some(o) -> {
        let module = resolved.scopes.get(o.target).module;
        if module.len() == 0 { { atom: moved, bind: None } } else {
          let binder = reached_binder(module);
          {
            atom: {
              ..moved,
              eff: {
                module: Some({ name: binder, span: span }),
                name: { name: o.name, span: span },
                span: span,
              },
            },
            bind: Some({ binder: binder, target: o.target, span: dummy_span() }),
          }
        }
      },
    }
  }

fn with_reach(xs: List<ModuleBinding>, b: Option<ModuleBinding>) -> List<ModuleBinding> =
  match b {
    None -> xs,
    Some(x) -> match find_module_binding(xs, x.binder) { Some(_) -> xs, None -> xs.push(x) },
  }

type RowExpander = {
  resolved: Resolved,
  table: SetTable,
  module: Int,
  reached: List<ModuleBinding>,
  diags: List<Diag>,
}

type ExpandedRow = { expander: RowExpander, r: RowExpr }

fn row_with_sets(expander: RowExpander, row: RowExpr) -> ExpandedRow / {abort.raise} =
  if row.aliases.len() == 0 { { expander: expander, r: row } } else {
    let o = row.aliases.fold(
      { expander: expander, atoms: row.atoms },
      |acc: { expander: RowExpander, atoms: List<AtomExpr> }, qname: QName|
        if is_diverges_name(qname) { { ..acc, atoms: acc.atoms.push(diverges_expr(qname)) } } else {
          match set_named(acc.expander.resolved, acc.expander.table, acc.expander.module, qname) {
            Err(d) -> { ..acc, expander: { ..acc.expander, diags: acc.expander.diags.push(d) } },
            Ok(id) ->
              acc.expander.table.nodes.get(id).members.fold(
                acc,
                |a: { expander: RowExpander, atoms: List<AtomExpr> }, member: Member| {
                  let u = usable(a.expander.resolved, a.expander.module, member, qname.span);
                  {
                    expander: { ..a.expander, reached: with_reach(a.expander.reached, u.bind) },
                    atoms: a.atoms.push(u.atom),
                  }
                },
              ),
          }
        },
    );
    {
      expander: o.expander,
      r: {
        atoms: o.atoms,
        aliases: row.aliases,
        tail: row.tail,
        tail_bounded: row.tail_bounded,
        span: row.span,
      },
    }
  }

/// Each row of the module with every set it names expanded; each set's own item with all it stands for.
fn module_sets(
  resolved: Resolved,
  table: SetTable,
  m: Int,
  parsed: ParsedModule,
) -> { module: ParsedModule, expander: RowExpander } / {abort.raise} = {
  let start: RowExpander = { resolved: resolved, table: table, module: m, reached: [], diags: [] };
  let walked = parsed.module.items.fold(
    { expander: start, items: [] },
    |acc: { expander: RowExpander, items: List<Item> }, item: Item|
      match item {
        IEffectSet(d) -> match table.by_module.get(m).get(d.name.name) {
          Some(id) -> if table.nodes.get(id).def.span == d.span {
            let us = table.nodes.get(id).members.map(|member: Member|
              usable(resolved, m, member, d.name.span));
            {
              expander: {
                ..acc.expander,
                reached: us.fold(
                  acc.expander.reached,
                  |bindings: List<ModuleBinding>, u: Usable| with_reach(bindings, u.bind),
                ),
              },
              items: acc.items.push(IEffectSet({ ..d, expansion: us.map(|u: Usable| u.atom) })),
            }
          } else { { ..acc, items: acc.items.push(item) } },
          None -> { ..acc, items: acc.items.push(item) },
        },
        _ -> {
          let o = rows_item(acc.expander, item);
          { expander: o.expander, items: acc.items.push(o.it) }
        },
      },
  );
  {
    module: {
      name: parsed.name,
      module: { ..parsed.module, items: walked.items },
      derived: parsed.derived,
    },
    expander: walked.expander,
  }
}

// Every row an item writes, with the sets it names expanded. Rows are walked on lambda parameter
// types and `let` annotations, never on a lambda's return type.

fn rows_opt(
  expander: RowExpander,
  r: Option<RowExpr>,
) -> { expander: RowExpander, r: Option<RowExpr> } / {abort.raise} =
  match r {
    None -> { expander: expander, r: None },
    Some(x) -> {
      let o = row_with_sets(expander, x);
      { expander: o.expander, r: Some(o.r) }
    },
  }

fn rows_ty(
  expander: RowExpander,
  ty: TypeExpr,
) -> { expander: RowExpander, t: TypeExpr } / {abort.raise} =
  match ty {
    TCon(c) -> {
      let o = rows_tys(expander, c.args);
      let rows = c.rows.fold(
        { expander: o.expander, rs: [] },
        |acc: { expander: RowExpander, rs: List<RowExpr> }, row: RowExpr| {
          let r = row_with_sets(acc.expander, row);
          { expander: r.expander, rs: acc.rs.push(r.r) }
        },
      );
      { expander: rows.expander, t: TCon({ ..c, args: o.ts, rows: rows.rs }) }
    },
    TFn(ft) -> {
      let ps = rows_tys(expander, ft.params);
      let r = rows_ty(ps.expander, ft.ret);
      let e = rows_opt(r.expander, ft.effects);
      { expander: e.expander, t: TFn({ span: ft.span, params: ps.ts, ret: r.t, effects: e.r }) }
    },
    TRecord(r) -> {
      let fs = r.fields.fold(
        { expander: expander, fs: [] },
        |acc: { expander: RowExpander, fs: List<{ name: Ident, ty: TypeExpr }> }, fd: { name: Ident, ty: TypeExpr }| {
          let o = rows_ty(acc.expander, fd.ty);
          { expander: o.expander, fs: acc.fs.push({ name: fd.name, ty: o.t }) }
        },
      );
      { expander: fs.expander, t: TRecord({ span: r.span, fields: fs.fs }) }
    },
    _ -> { expander: expander, t: ty },
  }

fn rows_tys(
  expander: RowExpander,
  tys: List<TypeExpr>,
) -> { expander: RowExpander, ts: List<TypeExpr> } / {abort.raise} =
  tys.fold(
    { expander: expander, ts: [] },
    |acc: { expander: RowExpander, ts: List<TypeExpr> }, ty: TypeExpr| {
      let o = rows_ty(acc.expander, ty);
      { expander: o.expander, ts: acc.ts.push(o.t) }
    },
  )

fn rows_opt_ty(
  expander: RowExpander,
  ty: Option<TypeExpr>,
) -> { expander: RowExpander, t: Option<TypeExpr> } / {abort.raise} =
  match ty {
    None -> { expander: expander, t: None },
    Some(x) -> {
      let o = rows_ty(expander, x);
      { expander: o.expander, t: Some(o.t) }
    },
  }

fn rows_params(
  expander: RowExpander,
  params: List<Param>,
) -> { expander: RowExpander, ps: List<Param> } / {abort.raise} =
  params.fold(
    { expander: expander, ps: [] },
    |acc: { expander: RowExpander, ps: List<Param> }, param: Param| {
      let o = rows_opt_ty(acc.expander, param.ty);
      { expander: o.expander, ps: acc.ps.push({ ..param, ty: o.t }) }
    },
  )

fn rows_exprs(
  expander: RowExpander,
  exprs: List<Expr>,
) -> { expander: RowExpander, xs: List<Expr> } / {abort.raise} =
  exprs.fold(
    { expander: expander, xs: [] },
    |acc: { expander: RowExpander, xs: List<Expr> }, expr: Expr| {
      let o = rows_expr(acc.expander, expr);
      { expander: o.expander, xs: acc.xs.push(o.e) }
    },
  )

fn rows_fields(
  expander: RowExpander,
  fields: List<RecField>,
) -> { expander: RowExpander, fs: List<RecField> } / {abort.raise} =
  fields.fold(
    { expander: expander, fs: [] },
    |acc: { expander: RowExpander, fs: List<RecField> }, field: RecField| {
      let o = rows_expr(acc.expander, field.value);
      { expander: o.expander, fs: acc.fs.push({ name: field.name, value: o.e }) }
    },
  )

fn rows_opt_expr(
  expander: RowExpander,
  expr: Option<Expr>,
) -> { expander: RowExpander, e: Option<Expr> } / {abort.raise} =
  match expr {
    None -> { expander: expander, e: None },
    Some(x) -> {
      let o = rows_expr(expander, x);
      { expander: o.expander, e: Some(o.e) }
    },
  }

fn rows_expr(
  expander: RowExpander,
  expr: Expr,
) -> { expander: RowExpander, e: Expr } / {abort.raise} =
  match expr {
    EBinary(b) -> {
      let l = rows_expr(expander, b.lhs);
      let r = rows_expr(l.expander, b.rhs);
      { expander: r.expander, e: EBinary({ span: b.span, op: b.op, lhs: l.e, rhs: r.e }) }
    },
    EUnary(u) -> {
      let o = rows_expr(expander, u.operand);
      { expander: o.expander, e: EUnary({ span: u.span, op: u.op, operand: o.e }) }
    },
    ELambda(l) -> {
      let ps = rows_params(expander, l.params);
      let b = rows_expr(ps.expander, l.body);
      { expander: b.expander, e: ELambda({ span: l.span, body: b.e, params: ps.ps, ret: l.ret }) }
    },
    EApp(a) -> {
      let callee = rows_expr(expander, a.func);
      let args = rows_exprs(callee.expander, a.args);
      let named = a.named.fold(
        { expander: args.expander, ns: [] },
        |acc: { expander: RowExpander, ns: List<NamedArg> }, arg: NamedArg| {
          let o = rows_expr(acc.expander, arg.value);
          { expander: o.expander, ns: acc.ns.push({ name: arg.name, value: o.e, span: arg.span }) }
        },
      );
      {
        expander: named.expander,
        e: EApp({ span: a.span, func: callee.e, named: named.ns, args: args.xs, labels: a.labels }),
      }
    },
    EIf(i) -> {
      let c = rows_expr(expander, i.cond);
      let t = rows_expr(c.expander, i.then_branch);
      let el = rows_expr(t.expander, i.else_branch);
      {
        expander: el.expander,
        e: EIf({ span: i.span, cond: c.e, then_branch: t.e, else_branch: el.e }),
      }
    },
    EMatch(m) -> {
      let sc = rows_expr(expander, m.scrutinee);
      let arms = m.arms.fold(
        { expander: sc.expander, arms: [] },
        |acc: { expander: RowExpander, arms: List<MatchArm> }, arm: MatchArm| {
          let g = rows_opt_expr(acc.expander, arm.guard);
          let b = rows_expr(g.expander, arm.body);
          {
            expander: b.expander,
            arms: acc.arms.push({ pat: arm.pat, guard: g.e, body: b.e, span: arm.span }),
          }
        },
      );
      { expander: arms.expander, e: EMatch({ span: m.span, scrutinee: sc.e, arms: arms.arms }) }
    },
    EBlock(b) -> {
      let stmts = b.stmts.fold(
        { expander: expander, ss: [] },
        |acc: { expander: RowExpander, ss: List<Stmt> }, stmt: Stmt|
          match stmt {
            SLet(l) -> {
              let t = rows_opt_ty(acc.expander, l.ty);
              let v = rows_expr(t.expander, l.value);
              {
                expander: v.expander,
                ss: acc.ss.push(SLet({ span: l.span, pat: l.pat, ty: t.t, value: v.e })),
              }
            },
            SLetElse(l) -> {
              let t = rows_opt_ty(acc.expander, l.ty);
              let v = rows_expr(t.expander, l.value);
              let fb = rows_expr(v.expander, l.fallback);
              {
                expander: fb.expander,
                ss: acc.ss.push(
                  SLetElse({ span: l.span, pat: l.pat, ty: t.t, value: v.e, fallback: fb.e }),
                ),
              }
            },
            SExpr(x) -> {
              let o = rows_expr(acc.expander, x);
              { expander: o.expander, ss: acc.ss.push(SExpr(o.e)) }
            },
            SAssign(x) -> {
              let o = rows_expr(acc.expander, x.value);
              { expander: o.expander, ss: acc.ss.push(SAssign({ ..x, value: o.e })) }
            },
          },
      );
      let tl = rows_opt_expr(stmts.expander, b.tail);
      { expander: tl.expander, e: EBlock({ span: b.span, tail: tl.e, stmts: stmts.ss }) }
    },
    ERecord(r) -> {
      let o = rows_fields(expander, r.fields);
      { expander: o.expander, e: ERecord({ span: r.span, fields: o.fs }) }
    },
    ERecordUpdate(r) -> {
      let b = rows_expr(expander, r.base);
      let o = rows_fields(b.expander, r.fields);
      { expander: o.expander, e: ERecordUpdate({ span: r.span, base: b.e, fields: o.fs }) }
    },
    EField(fd) -> {
      let o = rows_expr(expander, fd.base);
      { expander: o.expander, e: EField({ span: fd.span, base: o.e, field: fd.field }) }
    },
    ETry(t) -> {
      let o = rows_expr(expander, t.operand);
      { expander: o.expander, e: ETry({ span: t.span, operand: o.e }) }
    },
    EList(l) -> {
      let o = rows_exprs(expander, l.items);
      { expander: o.expander, e: EList({ span: l.span, items: o.xs }) }
    },
    EPerform(p) -> {
      let o = rows_exprs(expander, p.args);
      {
        expander: o.expander,
        e: EPerform({ span: p.span, eff: p.eff, op: p.op, resource: p.resource, args: o.xs }),
      }
    },
    EHandle(h) -> {
      let vs = h.vars.fold(
        { expander: expander, vs: [] },
        |acc: { expander: RowExpander, vs: List<HandlerVar> }, v: HandlerVar| {
          let t = rows_opt_ty(acc.expander, v.ty);
          let i = rows_expr(t.expander, v.init);
          { expander: i.expander, vs: acc.vs.push({ ..v, ty: t.t, init: i.e }) }
        },
      );
      let b = rows_expr(vs.expander, h.body);
      let cs = h.clauses.fold(
        { expander: b.expander, cs: [] },
        |acc: { expander: RowExpander, cs: List<HandleClause> }, c: HandleClause| {
          let o = rows_expr(acc.expander, c.body);
          {
            expander: o.expander,
            cs: acc.cs.push({
              eff: c.eff,
              op: c.op,
              resource: c.resource,
              every_label: c.every_label,
              label_binder: c.label_binder,
              resume: c.resume,
              body: o.e,
              span: c.span,
              params: c.params,
            }),
          }
        },
      );
      let r = match h.ret {
        None -> { expander: cs.expander, r: None },
        Some(rc) -> {
          let o = rows_expr(cs.expander, rc.body);
          { expander: o.expander, r: Some({ binder: rc.binder, body: o.e, span: rc.span }) }
        },
      };
      {
        expander: r.expander,
        e: EHandle({ span: h.span, body: b.e, ret: r.r, clauses: cs.cs, vars: vs.vs }),
      }
    },
    EWithHold(c) -> {
      let a = rows_expr(expander, c.acquire);
      let r = rows_expr(a.expander, c.release);
      let b = rows_expr(r.expander, c.body);
      { expander: b.expander, e: EWithHold({ ..c, acquire: a.e, release: r.e, body: b.e }) }
    },
    ESimulate(x) -> {
      let o = rows_expr(expander, x.body);
      { expander: o.expander, e: ESimulate({ span: x.span, body: o.e }) }
    },
    ETryBlock(x) -> {
      let o = rows_expr(expander, x.body);
      { expander: o.expander, e: ETryBlock({ ..x, body: o.e }) }
    },
    EParallel(x) -> {
      let o = rows_exprs(expander, x.branches);
      { expander: o.expander, e: EParallel({ span: x.span, branches: o.xs }) }
    },
    ETagged(t) -> {
      let filled = t.holes.fold(
        { expander: expander, holes: [] },
        |acc: { expander: RowExpander, holes: List<Hole> }, h: Hole| {
          let o = rows_expr(acc.expander, h.value);
          { expander: o.expander, holes: acc.holes.push({ ..h, value: o.e }) }
        },
      );
      { expander: filled.expander, e: ETagged({ ..t, holes: filled.holes }) }
    },
    _ -> { expander: expander, e: expr },
  }

fn rows_item(
  expander: RowExpander,
  item: Item,
) -> { expander: RowExpander, it: Item } / {abort.raise} =
  match item {
    IFn(d) -> {
      let ps = rows_params(expander, d.params);
      let r = rows_opt_ty(ps.expander, d.ret);
      let ef = rows_opt(r.expander, d.effects);
      let spec = d.spec.fold(
        { expander: ef.expander, xs: [] },
        |acc: { expander: RowExpander, xs: List<SpecClause> }, clause: SpecClause| {
          let o = rows_expr(acc.expander, clause.expr);
          {
            expander: o.expander,
            xs: acc.xs.push({ kind: clause.kind, expr: o.e, span: clause.span }),
          }
        },
      );
      let measured: { expander: RowExpander, e: Option<Expr> } = match d.decreases {
        None -> { expander: spec.expander, e: None },
        Some(e) -> {
          let o = rows_expr(spec.expander, e);
          { expander: o.expander, e: Some(o.e) }
        },
      };
      let b = rows_expr(measured.expander, d.body);
      {
        expander: b.expander,
        it: IFn({
          vis: d.vis,
          name: d.name,
          generics: d.generics,
          params: ps.ps,
          ret: r.t,
          effects: ef.r,
          constraints: d.constraints,
          spec: spec.xs,
          returns: d.returns,
          reuse: d.reuse,
          transparent: d.transparent,
          baked: d.baked,
          decreases: measured.e,
          body: b.e,
          doc: d.doc,
          span: d.span,
        }),
      }
    },
    IType(d) -> match d.body {
      TDAlias(t) -> {
        let o = rows_ty(expander, t);
        { expander: o.expander, it: IType({ ..d, body: TDAlias(o.t) }) }
      },
      TDNominal(t) -> {
        let o = rows_ty(expander, t);
        { expander: o.expander, it: IType({ ..d, body: TDNominal(o.t) }) }
      },
      TDExtern -> { expander: expander, it: item },
      TDSum(vs) -> {
        let out = vs.fold(
          { expander: expander, vs: [] },
          |acc: { expander: RowExpander, vs: List<VariantDef> }, variant: VariantDef| {
            let o = rows_tys(acc.expander, variant.fields);
            { expander: o.expander, vs: acc.vs.push({ ..variant, fields: o.ts }) }
          },
        );
        { expander: out.expander, it: IType({ ..d, body: TDSum(out.vs) }) }
      },
    },
    IEffect(d) -> {
      let ops = d.ops.fold(
        { expander: expander, ops: [] },
        |acc: { expander: RowExpander, ops: List<OpDef> }, op: OpDef| {
          let ps = rows_tys(acc.expander, op.params);
          let r = rows_ty(ps.expander, op.ret);
          { expander: r.expander, ops: acc.ops.push({ ..op, params: ps.ts, ret: r.t }) }
        },
      );
      { expander: ops.expander, it: IEffect({ ..d, ops: ops.ops }) }
    },
    ITest(d) -> {
      let ranged: { expander: RowExpander, cases: Option<Cases> } = match d.cases {
        None -> { expander: expander, cases: None },
        Some(c) -> {
          let t = rows_ty(expander, c.ty);
          let table = rows_expr(t.expander, c.table);
          let label = rows_expr(table.expander, c.label);
          {
            expander: label.expander,
            cases: Some({ ..c, ty: t.t, table: table.e, label: label.e }),
          }
        },
      };
      let o = rows_expr(ranged.expander, d.body);
      { expander: o.expander, it: ITest({ ..d, cases: ranged.cases, body: o.e }) }
    },
    ILaw(d) -> {
      let bs = d.binders.fold(
        { expander: expander, binders: [] },
        |acc: { expander: RowExpander, binders: List<Binder> }, b: Binder| {
          let o = rows_ty(acc.expander, b.ty);
          {
            expander: o.expander,
            binders: acc.binders.push({ name: b.name, ty: o.t, span: b.span }),
          }
        },
      );
      let g = rows_opt_expr(bs.expander, d.guard);
      let b = rows_expr(g.expander, d.body);
      { expander: b.expander, it: ILaw({ ..d, binders: bs.binders, guard: g.e, body: b.e }) }
    },
    _ -> { expander: expander, it: item },
  }

// --- Law schemas: what an instantiation states -------------------------------------------------

fn has_instance(module: Module) -> Bool =
  module.items.fold(false, |found: Bool, item: Item|
    found || (match item { ILaw(d) -> d.of != None, _ -> false }))

/// The schema's name for a binder, with `_` after it until nothing the arguments name, and no binder
/// before it, is called that: an argument written here never reads a binder.
fn apart(name: Bytes, args: List<Expr>, taken: List<Bytes>, room: Int) -> Bytes / {abort.raise} =
  iterate(name, room, |n: Bytes|
    if !taken.contains(n)
        && args.fold(true, |free: Bool, x: Expr| free && mentions(x, [n], [], []).len() == 0) {
      Stop(n)
    } else { Continue(n.concat(b"_")) })

/// Each type parameter `schema`'s `where identity(a)` constrains, by its place among the type
/// arguments its definitions are called at: the type parameters its parameters' and binders' types
/// write, in the order it declares them. One that none of those types writes constrains nothing.
fn schema_identities(schema: SchemaDef) -> List<SchemaIdentity> = {
  let written = law_type_variables(schema.params.concat(schema.binders));
  let arguments = schema.generics.types.filter(|g: Ident| written.contains(g.name));
  schema.identities.fold([], |acc: List<SchemaIdentity>, ident: Ident|
    match arguments.find_index(|g: Ident| g.name == ident.name) {
      Some(position) -> acc.push({ name: ident.name, position: position }),
      None -> acc,
    })
}

type Instantiation = { r: Resolved, law: LawDef, diags: List<Diag> }

/// `law "label" = schema(f, g)` as the law it is: over the schema's binders, its guard and body
/// the schema's definitions called with what it was given and then the binders. A name that
/// resolves to nothing is left as written, for the checker to say what is in reach.
fn instance(
  r: Resolved,
  mods: List<ParsedModule>,
  m: Int,
  d: LawDef,
  i: OfSchema,
  diags: List<Diag>,
) -> Instantiation / {abort.raise} =
  match find(r, m, ValueSpace, i.schema) {
    None -> { r: r, law: d, diags: diags },
    Some(b) -> {
      let name = i.schema.name.name;
      let home = mods.get(b.owner);
      let args = match d.body { EApp(a) -> a.args, _ -> [] };
      match schema_named(home.module, name) {
        None ->
          {
            r: r,
            law: d,
            diags: diags.push(
              error_at_and(
                b"E0472",
                m,
                i.schema.span,
                Bytes::concat_all([b"`", name, b"` is not a law schema"]),
                b"a law instantiates a schema",
                b.owner,
                b.span,
                b"declared here",
                [
                  b"a schema is declared `law schema name(f: (A) -> B) forall (x: A) { .. }`, and a law over a definition that is not one writes its own binders and body",
                ],
              ),
            ),
          },
        Some(schema) -> if args.len() != schema.params.len() {
          {
            r: r,
            law: d,
            diags: diags.push(
              error_at_and(
                b"E0202",
                m,
                i.span,
                Bytes::concat_all([
                  b"the schema `",
                  name,
                  b"` takes ",
                  counted(schema.params.len(), b"argument"),
                  b", but ",
                  ascii_of_int(args.len()),
                  if args.len() == 1 { b" was supplied" } else { b" were supplied" },
                ]),
                Bytes::concat_all([
                  b"expected ",
                  ascii_of_int(schema.params.len()),
                  b", found ",
                  ascii_of_int(args.len()),
                ]),
                b.owner,
                schema.name.span,
                b"this is the schema being instantiated",
                [],
              ),
            ),
          }
        } else {
          let through = { name: reached_binder(home.name), span: i.schema.span };
          let end = span_between(i.span.end, i.span.end);
          let names = schema.binders.fold([], |acc: List<Bytes>, binder: Binder|
            acc.push(
              apart(binder.name.name, args, acc, i.span.end - i.span.start + acc.len() + 2),
            ));
          let given = args.concat(
            names.map(|n: Bytes|
              EVar({ span: end, name: { module: None, name: { name: n, span: end }, span: end } })),
          );
          let call = |callee: Bytes, at: Span|
            EApp({
              span: at,
              func: EVar({
                span: i.schema.span,
                name: {
                  module: Some(through),
                  name: { name: callee, span: i.schema.name.span },
                  span: i.schema.span,
                },
              }),
              named: [],
              args: given,
              labels: [],
            });
          {
            r: reach(r, m, through.name, b.owner),
            law: {
              ..d,
              binders: names.map(|n: Bytes|
                {
                  name: { name: n, span: i.span },
                  ty: TVar({ name: n, span: i.span }),
                  span: i.span,
                }),
              guard: match schema.guard {
                Some(_) -> Some(call(schema_guard_name(name), i.schema.span)),
                None -> None,
              },
              of: Some({
                ..i,
                home: Some(home.name),
                shown: schema.binders.map(|binder: Binder| binder.name.name),
                identities: schema_identities(schema),
              }),
              body: call(name, i.span),
            },
            diags: diags,
          }
        },
      }
    },
  }

fn counted(n: Int, what: Bytes) -> Bytes =
  Bytes::concat_all([ascii_of_int(n), b" ", what, if n == 1 { b"" } else { b"s" }])

type Instantiated = { r: Resolved, mods: List<ParsedModule>, diags: List<Diag> }

pub fn instantiated(r: Resolved, mods: List<ParsedModule>) -> Instantiated / {abort.raise} =
  range(0, mods.len()).fold({ r: r, mods: [], diags: [] }, |acc: Instantiated, m: Int| {
    let mod: ParsedModule = mods.get(m);
    if !has_instance(mod.module) { { ..acc, mods: acc.mods.push(mod) } } else {
      let walked = mod.module.items.fold(
        { r: acc.r, items: [], diags: acc.diags },
        |w: { r: Resolved, items: List<Item>, diags: List<Diag> }, item: Item|
          match item {
            ILaw(d) -> match d.of {
              None -> { ..w, items: w.items.push(item) },
              Some(i) -> {
                let o = instance(w.r, mods, m, d, i, w.diags);
                { r: o.r, items: w.items.push(ILaw(o.law)), diags: o.diags }
              },
            },
            _ -> { ..w, items: w.items.push(item) },
          },
      );
      {
        r: walked.r,
        mods: acc.mods.push({ ..mod, module: { ..mod.module, items: walked.items } }),
        diags: walked.diags,
      }
    }
  })

type SetsExpanded = { r: Resolved, mods: List<ParsedModule>, diags: List<Diag> }

pub fn expand_sets(r: Resolved, mods: List<ParsedModule>) -> SetsExpanded / {abort.raise} = {
  let t = set_expand_all(r, set_cycles(set_includes(r, set_table(mods))));
  range(0, mods.len()).fold({ r: r, mods: [], diags: t.diags }, |acc: SetsExpanded, m: Int| {
    let o = module_sets(r, t, m, mods.get(m));
    {
      r: o.expander.reached.fold(acc.r, |rr: Resolved, binding: ModuleBinding|
        reach(rr, m, binding.binder, binding.target)),
      mods: acc.mods.push(o.module),
      diags: bytes_concat_diags(acc.diags, o.expander.diags),
    }
  })
}

// --- Defaults: the signatures ---------------------------------------------------------------

/// The module now reaches `target` under `binder`, with no span.
pub fn reach(
  resolved: Resolved,
  module: Int,
  binder: Bytes,
  target: Int,
) -> Resolved / {abort.raise} = {
  let scope: Scope = resolved.scopes.get(module);
  match find_module_binding(scope.modules, binder) {
    Some(_) -> resolved,
    None ->
      {
        ..resolved,
        scopes: resolved.scopes.set(module, {
          ..scope,
          modules: scope.modules.push({ binder: binder, target: target, span: dummy_span() }),
        }),
      },
  }
}

// --- Defaults: filling every call --------------------------------------------------------

pub fn bytes_concat_diags(a: List<Diag>, b: List<Diag>) -> List<Diag> =
  b.fold(a, |acc: List<Diag>, diag: Diag| acc.push(diag))
