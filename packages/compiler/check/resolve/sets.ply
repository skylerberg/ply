import compiler.expand.rewrite.shared (bare_names_read)

pub fn implicit_binder(module: Bytes) -> Bytes = b"@".concat(module)

type Member = { entry: EffectExpression, home: Int }

type SetNode = {
  definition: EffectSetDefinition,
  module: Int,
  includes: List<Option<Int>>,
  cyclic: Bool,
  members: List<Member>,
}

type SetTable = {
  nodes: List<SetNode>,
  by_module: List<Map<Bytes, Int>>,
  diagnostics: List<Diagnostic>,
}

fn set_table(modules: List<ParsedModule>) -> SetTable / {abort.raise} =
  range(0, modules.len()).fold(
    { nodes: [], by_module: [], diagnostics: [] },
    |table: SetTable, m: Int|
      modules.get(m).module.items.fold(
        { ..table, by_module: table.by_module.push(Map::new()) },
        |acc: SetTable, item: Item|
          match item {
            EffectSetItem(d) -> {
              let mine = acc.by_module.get(m);
              match mine.get(d.name.name) {
                Some(first) ->
                  {
                    ..acc,
                    diagnostics: acc.diagnostics.push(
                      error_at_and(
                        b"E0105",
                        m,
                        d.name.span,
                        Bytes::concat_all([b"duplicate effect set `", d.name.name, b"`"]),
                        b"redefined here",
                        m,
                        acc.nodes.get(first).definition.name.span,
                        b"first defined here",
                        [b"rename one of them; every effect set in a module needs a distinct name"],
                      ),
                    ),
                  },
                None ->
                  {
                    ..acc,
                    by_module: acc.by_module.set(m, mine.insert(d.name.name, acc.nodes.len())),
                    nodes: acc.nodes.push({
                      definition: d,
                      module: m,
                      includes: [],
                      cyclic: false,
                      members: [],
                    }),
                  },
              }
            },
            _ -> acc,
          },
      ),
  )

fn unknown_set(resolved: Resolution, m: Int, qname: QName) -> Diagnostic / {abort.raise} = {
  let scope = resolved.scopes.get(m);
  let n = qname.name.name;
  let effect_notes = match lookup(scope.bound, EffectSpace, n) {
    Some(_) ->
      [
        Bytes::concat_all([
          b"`",
          n,
          b"` is a whole effect, and a member of a set names one mode or operation: write `",
          n,
          b".read[..]` or `",
          n,
          b".write[..]`",
        ]),
        b"a whole effect is every resource label anywhere in the program, so naming one would let an unrelated module change these effects and therefore this definition's hash",
      ],
    None -> [],
  };
  let named = scope.bound.sets.map(|binding: Binding| binding.name);
  let known = if named.len() == 0 {
    b"this module names no `effect set`: declare one, or import one by name from the module that declares it `pub`"
  } else { b"the sets this module names: ".concat(backticked(named, b", ")) };
  error_at(
    b"E0114",
    m,
    qname.span,
    Bytes::concat_all([b"no `effect set` named `", n, b"` here"]),
    b"neither declared nor imported here",
    effect_notes.push(known),
  )
}

fn is_diverges_name(qname: QName) -> Bool = qname.module == None && qname.name.name == b"diverges"

fn diverges_expression(qname: QName) -> EffectExpression =
  {
    effect_name: qname,
    mode: ReadMode,
    op: None,
    resource: None,
    every: false,
    bounded: false,
    span: qname.span,
  }

fn set_named(
  resolved: Resolution,
  table: SetTable,
  m: Int,
  qname: QName,
) -> Result<Int, Diagnostic> / {abort.raise} = {
  let scope = resolved.scopes.get(m);
  let name = qname.name.name;
  match qname.module {
    None -> match lookup(scope.bound, SetSpace, name) {
      Some(b) -> match table.by_module.get(b.owner).get(name) {
        Some(id) -> Ok(id),
        None -> Err(unknown_set(resolved, m, qname)),
      },
      None -> Err(unknown_set(resolved, m, qname)),
    },
    Some(binder) -> match find_module_binding(scope.modules, binder.name) {
      None ->
        Err(
          error_at(
            b"E0114",
            m,
            qname.span,
            Bytes::concat_all([b"no module is imported as `", binder.name, b"`"]),
            b"not a module imported by this file",
            [b"import the module that declares the set, or import the set by name"],
          ),
        ),
      Some(mb) -> {
        let module = resolved.scopes.get(mb.target).module;
        match lookup_declared(resolved.declarations.get(mb.target), SetSpace, name) {
          None -> {
            let exported = resolved.declarations.get(mb.target).sets.filter(|d: Declaration|
              d.public).map(|d: Declaration| d.name);
            Err(
              error_at(
                b"E0114",
                m,
                qname.span,
                Bytes::concat_all([
                  b"module `",
                  module,
                  b"` declares no `effect set` named `",
                  name,
                  b"`",
                ]),
                Bytes::concat_all([b"not found in `", module, b"`"]),
                [
                  if exported.len() == 0 {
                    Bytes::concat_all([b"`", module, b"` exports no effect set"])
                  } else {
                    Bytes::concat_all([b"`", module, b"` exports ", backticked(exported, b", ")])
                  },
                ],
              ),
            )
          },
          Some(d) -> if !d.public && mb.target != m {
            Err(private_name_error(m, qname.span, mb.target, d.span, SetSpace, name, module))
          } else {
            match table.by_module.get(mb.target).get(name) {
              Some(id) -> Ok(id),
              None -> Err(unknown_set(resolved, m, qname)),
            }
          },
        }
      },
    },
  }
}

fn set_includes(resolved: Resolution, table: SetTable) -> SetTable / {abort.raise} =
  range(0, table.nodes.len()).fold(table, |acc: SetTable, id: Int| {
    let node = acc.nodes.get(id);
    let walked = node.definition.includes.fold(
      { diagnostics: acc.diagnostics, xs: [] },
      |w: { diagnostics: List<Diagnostic>, xs: List<Option<Int>> }, qname: QName|
        match set_named(resolved, acc, node.module, qname) {
          Ok(i) -> { ..w, xs: w.xs.push(Some(i)) },
          Err(d) -> { diagnostics: w.diagnostics.push(d), xs: w.xs.push(None) },
        },
    );
    {
      ..acc,
      diagnostics: walked.diagnostics,
      nodes: acc.nodes.set(id, { ..node, includes: walked.xs }),
    }
  })

type SetSearch = {
  color: List<Int>,
  path: List<Int>,
  work: List<{ node: Int, next: Int }>,
  t: SetTable,
}

fn set_cycles(table: SetTable) -> SetTable / {abort.raise} = {
  let n = table.nodes.len();
  let steps = table.nodes.fold(0, |acc: Int, node: SetNode| acc + node.includes.len());
  let start: SetSearch = { color: range(0, n).map(|i: Int| 0), path: [], work: [], t: table };
  let done = range(0, n).fold(start, |d: SetSearch, root: Int|
    if d.color.get(root) != 0 { d } else {
      let opened: SetSearch = {
        ..d,
        color: d.color.set(root, 1),
        path: d.path.push(root),
        work: [{ node: root, next: 0 }],
      };
      iterate(opened, 2 * (n + steps) + 4, |x: SetSearch|
        if x.work.len() == 0 { Stop(x) } else { Continue(set_search_step(x)) })
    });
  done.t
}

fn set_search_step(d: SetSearch) -> SetSearch / {abort.raise} = {
  let top = d.work.get(d.work.len() - 1);
  let rest = d.work.take(d.work.len() - 1);
  let out = d.t.nodes.get(top.node).includes;
  if top.next >= out.len() {
    { ..d, color: d.color.set(top.node, 2), work: rest, path: d.path.take(d.path.len() - 1) }
  } else {
    let advanced = rest.push({ node: top.node, next: top.next + 1 });
    match out.get(top.next) {
      None -> { ..d, work: advanced },
      Some(target) -> {
        let c = d.color.get(target);
        if c == 0 {
          {
            ..d,
            work: advanced.push({ node: target, next: 0 }),
            color: d.color.set(target, 1),
            path: d.path.push(target),
          }
        } else if c == 1 {
          let st = match position(d.path, target) { Some(p) -> p, None -> 0 };
          let cycle = d.path.drop(st);
          let t2 = {
            ..d.t,
            diagnostics: d.t.diagnostics.push(set_cycle(d.t, cycle)),
            nodes: cycle.fold(d.t.nodes, |ns: List<SetNode>, i: Int|
              ns.set(i, { ..ns.get(i), cyclic: true })),
          };
          { ..d, work: advanced, t: t2 }
        } else { { ..d, work: advanced } }
      },
    }
  }
}

fn set_cycle(table: SetTable, cycle: List<Int>) -> Diagnostic / {abort.raise} = {
  let head = table.nodes.get(cycle.get(0));
  let others = cycle.drop(1);
  let names = cycle.map(|i: Int| table.nodes.get(i).definition.name.name).push(
    head.definition.name.name,
  );
  let primary = if cycle.len() == 1 { b"this set names itself" } else {
    Bytes::concat_all([
      b"expands through ",
      backticked(others.map(|i: Int| table.nodes.get(i).definition.name.name), b", "),
      b" and back",
    ])
  };
  error_with_labels(
    b"E0115",
    Bytes::concat_all([b"effect set `", head.definition.name.name, b"` contains itself"]),
    others.fold(
      [label_at(head.module, head.definition.name.span, true, primary)],
      |labels: List<Label>, i: Int|
        labels.push(
          label_at(
            table.nodes.get(i).module,
            table.nodes.get(i).definition.name.span,
            false,
            b"on the cycle",
          ),
        ),
    ),
    [
      b"the cycle is ".concat(backticked(names, b" -> ")),
      b"expansion is a fixed point, and a cycle has none: break it by inlining the effects one of these sets needs",
    ],
  )
}

fn effect_owner(
  resolved: Resolution,
  home: Int,
  qname: QName,
) -> Option<{ target: Int, name: Bytes }> / {abort.raise} = {
  let scope = resolved.scopes.get(home);
  match qname.module {
    Some(b) -> match find_module_binding(scope.modules, b.name) {
      Some(mb) -> match lookup_declared(
          resolved.declarations.get(mb.target),
          EffectSpace,
          qname.name.name,
        ) {
        Some(_) -> Some({ target: mb.target, name: qname.name.name }),
        None -> None,
      },
      None -> None,
    },
    None -> match lookup(scope.bound, EffectSpace, qname.name.name) {
      Some(b) -> Some({ target: b.owner, name: b.name }),
      None -> None,
    },
  }
}

fn member_key(resolved: Resolution, member: Member) -> Bytes / {abort.raise} = {
  let a = member.entry;
  let eff = match effect_owner(resolved, member.home, a.effect_name) {
    Some(o) -> qualify(resolved.scopes.get(o.target).module, o.name),
    None -> match a.effect_name.module {
      Some(b) -> Bytes::concat_all([b.name, b"::", a.effect_name.name.name]),
      None -> a.effect_name.name.name,
    },
  };
  Bytes::concat_all([
    eff,
    b" ",
    mode_text(a.mode),
    b" ",
    match a.op { Some(o) -> o.name, None -> b"" },
    b" ",
    if a.every { b"*" } else { match a.resource { Some(x) -> x.name, None -> b"" } },
  ])
}

type KeyedMember = { key: Bytes, member: Member }

fn insert_keyed(sorted: List<KeyedMember>, k: KeyedMember) -> List<KeyedMember> / {abort.raise} = {
  let n = sorted.len();
  let i = range(0, n).fold(n, |acc: Int, j: Int|
    if acc < n { acc } else if compare(k.key, sorted.get(j).key) == Less { j } else { acc });
  sorted.drop(i).fold(sorted.take(i).push(k), |acc: List<KeyedMember>, x: KeyedMember| acc.push(x))
}

fn canonical_members(resolved: Resolution, xs: List<Member>) -> List<Member> / {abort.raise} = {
  let sorted = xs.fold([], |acc: List<KeyedMember>, member: Member|
    insert_keyed(acc, { key: member_key(resolved, member), member: member }));
  sorted.fold([], |acc: List<KeyedMember>, keyed: KeyedMember|
    if acc.len() > 0 && acc.get(acc.len() - 1).key == keyed.key { acc }
    else { acc.push(keyed) }).map(|keyed: KeyedMember| keyed.member)
}

type SetWork = { t: SetTable, done: List<Bool>, work: List<{ node: Int, visited: Bool }> }

fn set_expand_all(resolved: Resolution, table: SetTable) -> SetTable / {abort.raise} = {
  let n = table.nodes.len();
  let steps = table.nodes.fold(0, |acc: Int, node: SetNode| acc + node.includes.len());
  let start: SetWork = { t: table, done: range(0, n).map(|i: Int| false), work: [] };
  let finished = range(0, n).fold(start, |x: SetWork, root: Int|
    if x.done.get(root) || x.t.nodes.get(root).cyclic { x } else {
      iterate({ ..x, work: [{ node: root, visited: false }] }, 4 * (n + steps) + 4, |y: SetWork|
        if y.work.len() == 0 { Stop(y) } else { Continue(set_expand_step(resolved, y)) })
    });
  finished.t
}

fn set_expand_step(resolved: Resolution, x: SetWork) -> SetWork / {abort.raise} = {
  let top = x.work.get(x.work.len() - 1);
  let rest = x.work.take(x.work.len() - 1);
  let node = x.t.nodes.get(top.node);
  if x.done.get(top.node) || node.cyclic { { ..x, work: rest } } else if !top.visited {
    let pushed = node.includes.fold(
      rest.push({ node: top.node, visited: true }),
      |w: List<{ node: Int, visited: Bool }>, e: Option<Int>|
        match e {
          Some(i) -> if !x.done.get(i) && !x.t.nodes.get(i).cyclic {
            w.push({ node: i, visited: false })
          } else { w },
          None -> w,
        },
    );
    { ..x, work: pushed }
  } else {
    let own = node.definition.listed.map(|entry: EffectExpression|
      { entry: entry, home: node.module });
    let all = node.includes.fold(own, |acc: List<Member>, e: Option<Int>|
      match e {
        Some(i) ->
          x.t.nodes.get(i).members.fold(acc, |ms: List<Member>, member: Member| ms.push(member)),
        None -> acc,
      });
    {
      ..x,
      work: rest,
      done: x.done.set(top.node, true),
      t: {
        ..x.t,
        nodes: x.t.nodes.set(top.node, { ..node, members: canonical_members(resolved, all) }),
      },
    }
  }
}

fn effect_with_span(entry: EffectExpression, span: Span) -> EffectExpression =
  {
    effect_name: {
      module: match entry.effect_name.module {
        Some(b) -> Some({ name: b.name, span: span }),
        None -> None,
      },
      name: { name: entry.effect_name.name.name, span: span },
      span: span,
    },
    mode: entry.mode,
    op: match entry.op { Some(o) -> Some({ name: o.name, span: span }), None -> None },
    resource: match entry.resource { Some(x) -> Some({ name: x.name, span: span }), None -> None },
    every: entry.every,
    bounded: entry.bounded,
    span: span,
  }

type LocalizedEffect = { entry: EffectExpression, bind: Option<ModuleBinding> }

fn localize_member(
  resolved: Resolution,
  m: Int,
  member: Member,
  span: Span,
) -> LocalizedEffect / {abort.raise} =
  if member.home == m { { entry: member.entry, bind: None } } else {
    let moved = effect_with_span(member.entry, span);
    match effect_owner(resolved, member.home, member.entry.effect_name) {
      None -> { entry: moved, bind: None },
      Some(o) -> {
        let module = resolved.scopes.get(o.target).module;
        if module.len() == 0 { { entry: moved, bind: None } } else {
          let binder = implicit_binder(module);
          {
            entry: {
              ..moved,
              effect_name: {
                module: Some({ name: binder, span: span }),
                name: { name: o.name, span: span },
                span: span,
              },
            },
            bind: Some({ binder: binder, target: o.target, span: dummy_span() }),
          }
        }
      },
    }
  }

fn add_binding_once(xs: List<ModuleBinding>, b: Option<ModuleBinding>) -> List<ModuleBinding> =
  match b {
    None -> xs,
    Some(x) -> match find_module_binding(xs, x.binder) { Some(_) -> xs, None -> xs.push(x) },
  }

type EffectsExpander = {
  resolved: Resolution,
  table: SetTable,
  module: Int,
  reached: List<ModuleBinding>,
  diagnostics: List<Diagnostic>,
  rows: Int,
}

fn without_node_ids(a: EffectExpression) -> EffectExpression =
  {
    ..a,
    effect_name: {
      module: match a.effect_name.module {
        Some(m) -> Some({ ..m, span: { ..m.span, site: 0 } }),
        None -> None,
      },
      name: { ..a.effect_name.name, span: { ..a.effect_name.name.span, site: 0 } },
      span: { ..a.effect_name.span, site: 0 },
    },
    op: match a.op { Some(o) -> Some({ ..o, span: { ..o.span, site: 0 } }), None -> None },
  }

type ExpandedEffects = { expander: EffectsExpander, r: EffectsExpression }

fn expand_effects(
  expander: EffectsExpander,
  effects: EffectsExpression,
) -> ExpandedEffects / {abort.raise} =
  if effects.aliases.len() == 0 { { expander: expander, r: effects } } else {
    let o = effects.aliases.fold(
      { expander: expander, listed: effects.listed },
      |acc: { expander: EffectsExpander, listed: List<EffectExpression> }, qname: QName|
        if is_diverges_name(qname) {
          { ..acc, listed: acc.listed.push(without_node_ids(diverges_expression(qname))) }
        } else {
          match set_named(acc.expander.resolved, acc.expander.table, acc.expander.module, qname) {
            Err(d) ->
              {
                ..acc,
                expander: { ..acc.expander, diagnostics: acc.expander.diagnostics.push(d) },
              },
            Ok(id) ->
              acc.expander.table.nodes.get(id).members.fold(
                acc,
                |a: { expander: EffectsExpander, listed: List<EffectExpression> }, member: Member| {
                  let u = localize_member(
                    a.expander.resolved,
                    a.expander.module,
                    member,
                    qname.span,
                  );
                  {
                    expander: {
                      ..a.expander,
                      reached: add_binding_once(a.expander.reached, u.bind),
                    },
                    listed: a.listed.push(without_node_ids(u.entry)),
                  }
                },
              ),
          }
        },
    );
    {
      expander: { ..o.expander, rows: o.expander.rows + 1 },
      r: {
        listed: o.listed,
        aliases: effects.aliases,
        variable: effects.variable,
        variable_bounded: effects.variable_bounded,
        span: effects.span,
      },
    }
  }

fn expand_module_sets(
  resolved: Resolution,
  table: SetTable,
  m: Int,
  parsed: ParsedModule,
) -> { module: ParsedModule, expander: EffectsExpander } / {abort.raise} = {
  let start: EffectsExpander = {
    resolved: resolved,
    table: table,
    module: m,
    reached: [],
    diagnostics: [],
    rows: 0,
  };
  let walked = parsed.module.items.fold(
    { expander: start, items: [] },
    |acc: { expander: EffectsExpander, items: List<Item> }, item: Item|
      match item {
        EffectSetItem(d) -> match table.by_module.get(m).get(d.name.name) {
          Some(id) -> if table.nodes.get(id).definition.span == d.span {
            let us = table.nodes.get(id).members.map(|member: Member|
              localize_member(resolved, m, member, d.name.span));
            {
              expander: {
                ..acc.expander,
                reached: us.fold(
                  acc.expander.reached,
                  |bindings: List<ModuleBinding>, u: LocalizedEffect|
                    add_binding_once(bindings, u.bind),
                ),
              },
              items: acc.items.push(
                EffectSetItem({ ..d, expansion: us.map(|u: LocalizedEffect| u.entry) }),
              ),
            }
          } else { { ..acc, items: acc.items.push(item) } },
          None -> { ..acc, items: acc.items.push(item) },
        },
        _ -> {
          let o = expand_effects_in_item(acc.expander, item);
          {
            expander: o.expander,
            items: acc.items.push(if o.expander.rows == acc.expander.rows { o.it }
            else { numbered_missing(o.it) }),
          }
        },
      },
  );
  {
    module: {
      name: parsed.name,
      module: { ..parsed.module, items: walked.items },
      derived: parsed.derived,
    },
    expander: walked.expander,
  }
}

fn expand_optional_effects(
  expander: EffectsExpander,
  r: Option<EffectsExpression>,
) -> { expander: EffectsExpander, r: Option<EffectsExpression> } / {abort.raise} =
  match r {
    None -> { expander: expander, r: None },
    Some(x) -> {
      let o = expand_effects(expander, x);
      { expander: o.expander, r: Some(o.r) }
    },
  }

fn expand_effects_in_type(
  expander: EffectsExpander,
  ty: TypeExpression,
) -> { expander: EffectsExpander, t: TypeExpression } / {abort.raise} =
  match ty {
    NamedTypeExpression(c) -> {
      let o = expand_effects_in_types(expander, c.args);
      let rows = c.effect_arguments.fold(
        { expander: o.expander, rs: [] },
        |acc: { expander: EffectsExpander, rs: List<EffectsExpression> }, effects: EffectsExpression| {
          let r = expand_effects(acc.expander, effects);
          { expander: r.expander, rs: acc.rs.push(r.r) }
        },
      );
      {
        expander: rows.expander,
        t: NamedTypeExpression({ ..c, args: o.ts, effect_arguments: rows.rs }),
      }
    },
    FunctionTypeExpression(ft) -> {
      let ps = expand_effects_in_types(expander, ft.params);
      let r = expand_effects_in_type(ps.expander, ft.ret);
      let e = expand_optional_effects(r.expander, ft.effects);
      {
        expander: e.expander,
        t: FunctionTypeExpression({ ..ft, params: ps.ts, ret: r.t, effects: e.r }),
      }
    },
    RecordTypeExpression(r) -> {
      let fs = r.fields.fold(
        { expander: expander, fs: [] },
        |acc: { expander: EffectsExpander, fs: List<{ name: Identifier, ty: TypeExpression }> }, fd: { name: Identifier, ty: TypeExpression }| {
          let o = expand_effects_in_type(acc.expander, fd.ty);
          { expander: o.expander, fs: acc.fs.push({ name: fd.name, ty: o.t }) }
        },
      );
      { expander: fs.expander, t: RecordTypeExpression({ span: r.span, fields: fs.fs }) }
    },
    _ -> { expander: expander, t: ty },
  }

fn expand_effects_in_types(
  expander: EffectsExpander,
  types: List<TypeExpression>,
) -> { expander: EffectsExpander, ts: List<TypeExpression> } / {abort.raise} =
  types.fold(
    { expander: expander, ts: [] },
    |acc: { expander: EffectsExpander, ts: List<TypeExpression> }, ty: TypeExpression| {
      let o = expand_effects_in_type(acc.expander, ty);
      { expander: o.expander, ts: acc.ts.push(o.t) }
    },
  )

fn expand_effects_in_optional_type(
  expander: EffectsExpander,
  ty: Option<TypeExpression>,
) -> { expander: EffectsExpander, t: Option<TypeExpression> } / {abort.raise} =
  match ty {
    None -> { expander: expander, t: None },
    Some(x) -> {
      let o = expand_effects_in_type(expander, x);
      { expander: o.expander, t: Some(o.t) }
    },
  }

fn expand_effects_in_parameters(
  expander: EffectsExpander,
  params: List<Param>,
) -> { expander: EffectsExpander, ps: List<Param> } / {abort.raise} =
  params.fold(
    { expander: expander, ps: [] },
    |acc: { expander: EffectsExpander, ps: List<Param> }, param: Param| {
      let o = expand_effects_in_optional_type(acc.expander, param.ty);
      { expander: o.expander, ps: acc.ps.push({ ..param, ty: o.t }) }
    },
  )

fn expand_effects_in_expressions(
  expander: EffectsExpander,
  expressions: List<Expression>,
) -> { expander: EffectsExpander, xs: List<Expression> } / {abort.raise} =
  expressions.fold(
    { expander: expander, xs: [] },
    |acc: { expander: EffectsExpander, xs: List<Expression> }, expression: Expression| {
      let o = expand_effects_in_expression(acc.expander, expression);
      { expander: o.expander, xs: acc.xs.push(o.e) }
    },
  )

fn expand_effects_in_fields(
  expander: EffectsExpander,
  fields: List<RecordLiteralField>,
) -> { expander: EffectsExpander, fs: List<RecordLiteralField> } / {abort.raise} =
  fields.fold(
    { expander: expander, fs: [] },
    |acc: { expander: EffectsExpander, fs: List<RecordLiteralField> }, field: RecordLiteralField| {
      let o = expand_effects_in_expression(acc.expander, field.value);
      { expander: o.expander, fs: acc.fs.push({ name: field.name, value: o.e }) }
    },
  )

fn expand_effects_in_optional_expression(
  expander: EffectsExpander,
  expression: Option<Expression>,
) -> { expander: EffectsExpander, e: Option<Expression> } / {abort.raise} =
  match expression {
    None -> { expander: expander, e: None },
    Some(x) -> {
      let o = expand_effects_in_expression(expander, x);
      { expander: o.expander, e: Some(o.e) }
    },
  }

fn expand_effects_in_expression(
  expander: EffectsExpander,
  expression: Expression,
) -> { expander: EffectsExpander, e: Expression } / {abort.raise} =
  match expression {
    BinaryExpression(b) -> {
      let l = expand_effects_in_expression(expander, b.lhs);
      let r = expand_effects_in_expression(l.expander, b.rhs);
      { expander: r.expander, e: BinaryExpression({ span: b.span, op: b.op, lhs: l.e, rhs: r.e }) }
    },
    UnaryExpression(u) -> {
      let o = expand_effects_in_expression(expander, u.operand);
      { expander: o.expander, e: UnaryExpression({ span: u.span, op: u.op, operand: o.e }) }
    },
    LambdaExpression(l) -> {
      let ps = expand_effects_in_parameters(expander, l.params);
      let b = expand_effects_in_expression(ps.expander, l.body);
      {
        expander: b.expander,
        e: LambdaExpression({ span: l.span, body: b.e, params: ps.ps, ret: l.ret }),
      }
    },
    CallExpression(a) -> {
      let callee = expand_effects_in_expression(expander, a.function);
      let args = expand_effects_in_expressions(callee.expander, a.args);
      let named = a.named.fold(
        { expander: args.expander, ns: [] },
        |acc: { expander: EffectsExpander, ns: List<NamedArg> }, arg: NamedArg| {
          let o = expand_effects_in_expression(acc.expander, arg.value);
          { expander: o.expander, ns: acc.ns.push({ name: arg.name, value: o.e, span: arg.span }) }
        },
      );
      {
        expander: named.expander,
        e: CallExpression({
          span: a.span,
          function: callee.e,
          named: named.ns,
          args: args.xs,
          labels: a.labels,
        }),
      }
    },
    IfExpression(i) -> {
      let c = expand_effects_in_expression(expander, i.cond);
      let t = expand_effects_in_expression(c.expander, i.then_branch);
      let el = expand_effects_in_expression(t.expander, i.else_branch);
      {
        expander: el.expander,
        e: IfExpression({ span: i.span, cond: c.e, then_branch: t.e, else_branch: el.e }),
      }
    },
    MatchExpression(m) -> {
      let sc = expand_effects_in_expression(expander, m.scrutinee);
      let arms = m.arms.fold(
        { expander: sc.expander, arms: [] },
        |acc: { expander: EffectsExpander, arms: List<MatchArm> }, arm: MatchArm| {
          let g = expand_effects_in_optional_expression(acc.expander, arm.guard);
          let b = expand_effects_in_expression(g.expander, arm.body);
          {
            expander: b.expander,
            arms: acc.arms.push({ pattern: arm.pattern, guard: g.e, body: b.e, span: arm.span }),
          }
        },
      );
      {
        expander: arms.expander,
        e: MatchExpression({ span: m.span, scrutinee: sc.e, arms: arms.arms }),
      }
    },
    BlockExpression(b) -> {
      let statements = b.statements.fold(
        { expander: expander, ss: [] },
        |acc: { expander: EffectsExpander, ss: List<Statement> }, stmt: Statement|
          match stmt {
            LetStatement(l) -> {
              let t = expand_effects_in_optional_type(acc.expander, l.ty);
              let v = expand_effects_in_expression(t.expander, l.value);
              {
                expander: v.expander,
                ss: acc.ss.push(
                  LetStatement({ span: l.span, pattern: l.pattern, ty: t.t, value: v.e }),
                ),
              }
            },
            LetElseStatement(l) -> {
              let t = expand_effects_in_optional_type(acc.expander, l.ty);
              let v = expand_effects_in_expression(t.expander, l.value);
              let fb = expand_effects_in_expression(v.expander, l.fallback);
              {
                expander: fb.expander,
                ss: acc.ss.push(
                  LetElseStatement({
                    span: l.span,
                    pattern: l.pattern,
                    ty: t.t,
                    value: v.e,
                    fallback: fb.e,
                  }),
                ),
              }
            },
            ExpressionStatement(x) -> {
              let o = expand_effects_in_expression(acc.expander, x);
              { expander: o.expander, ss: acc.ss.push(ExpressionStatement(o.e)) }
            },
            AssignmentStatement(x) -> {
              let o = expand_effects_in_expression(acc.expander, x.value);
              { expander: o.expander, ss: acc.ss.push(AssignmentStatement({ ..x, value: o.e })) }
            },
          },
      );
      let tl = expand_effects_in_optional_expression(statements.expander, b.tail);
      {
        expander: tl.expander,
        e: BlockExpression({ span: b.span, tail: tl.e, statements: statements.ss }),
      }
    },
    RecordExpression(r) -> {
      let o = expand_effects_in_fields(expander, r.fields);
      { expander: o.expander, e: RecordExpression({ span: r.span, fields: o.fs }) }
    },
    RecordUpdateExpression(r) -> {
      let b = expand_effects_in_expression(expander, r.base);
      let o = expand_effects_in_fields(b.expander, r.fields);
      { expander: o.expander, e: RecordUpdateExpression({ span: r.span, base: b.e, fields: o.fs }) }
    },
    FieldExpression(fd) -> {
      let o = expand_effects_in_expression(expander, fd.base);
      { expander: o.expander, e: FieldExpression({ span: fd.span, base: o.e, field: fd.field }) }
    },
    PropagateExpression(t) -> {
      let o = expand_effects_in_expression(expander, t.operand);
      { expander: o.expander, e: PropagateExpression({ span: t.span, operand: o.e }) }
    },
    ListExpression(l) -> {
      let o = expand_effects_in_expressions(expander, l.items);
      { expander: o.expander, e: ListExpression({ span: l.span, items: o.xs }) }
    },
    PerformExpression(p) -> {
      let o = expand_effects_in_expressions(expander, p.args);
      {
        expander: o.expander,
        e: PerformExpression({
          span: p.span,
          effect_name: p.effect_name,
          op: p.op,
          resource: p.resource,
          args: o.xs,
        }),
      }
    },
    HandleExpression(h) -> {
      let vs = h.vars.fold(
        { expander: expander, vs: [] },
        |acc: { expander: EffectsExpander, vs: List<HandlerVar> }, v: HandlerVar| {
          let t = expand_effects_in_optional_type(acc.expander, v.ty);
          let i = expand_effects_in_expression(t.expander, v.init);
          { expander: i.expander, vs: acc.vs.push({ ..v, ty: t.t, init: i.e }) }
        },
      );
      let b = expand_effects_in_expression(vs.expander, h.body);
      let cs = h.clauses.fold(
        { expander: b.expander, classes: [] },
        |acc: { expander: EffectsExpander, classes: List<HandleClause> }, c: HandleClause| {
          let o = expand_effects_in_expression(acc.expander, c.body);
          {
            expander: o.expander,
            classes: acc.classes.push({
              effect_name: c.effect_name,
              op: c.op,
              resource: c.resource,
              every_label: c.every_label,
              label_binder: c.label_binder,
              resume: c.resume,
              body: o.e,
              span: c.span,
              params: c.params,
            }),
          }
        },
      );
      let r = match h.ret {
        None -> { expander: cs.expander, r: None },
        Some(rc) -> {
          let o = expand_effects_in_expression(cs.expander, rc.body);
          { expander: o.expander, r: Some({ binder: rc.binder, body: o.e, span: rc.span }) }
        },
      };
      {
        expander: r.expander,
        e: HandleExpression({ span: h.span, body: b.e, ret: r.r, clauses: cs.classes, vars: vs.vs }),
      }
    },
    WithScopeExpression(c) -> {
      let a = expand_effects_in_expression(expander, c.acquire);
      let r = expand_effects_in_expression(a.expander, c.release);
      let b = expand_effects_in_expression(r.expander, c.body);
      {
        expander: b.expander,
        e: WithScopeExpression({ ..c, acquire: a.e, release: r.e, body: b.e }),
      }
    },
    SimulateExpression(x) -> {
      let o = expand_effects_in_expression(expander, x.body);
      { expander: o.expander, e: SimulateExpression({ span: x.span, body: o.e }) }
    },
    TryBlockExpression(x) -> {
      let o = expand_effects_in_expression(expander, x.body);
      { expander: o.expander, e: TryBlockExpression({ ..x, body: o.e }) }
    },
    ParallelExpression(x) -> {
      let o = expand_effects_in_expressions(expander, x.branches);
      { expander: o.expander, e: ParallelExpression({ span: x.span, branches: o.xs }) }
    },
    TaggedLiteralExpression(t) -> {
      let filled = t.holes.fold(
        { expander: expander, holes: [] },
        |acc: { expander: EffectsExpander, holes: List<Hole> }, h: Hole| {
          let o = expand_effects_in_expression(acc.expander, h.value);
          { expander: o.expander, holes: acc.holes.push({ ..h, value: o.e }) }
        },
      );
      { expander: filled.expander, e: TaggedLiteralExpression({ ..t, holes: filled.holes }) }
    },
    _ -> { expander: expander, e: expression },
  }

fn expand_effects_in_item(
  expander: EffectsExpander,
  item: Item,
) -> { expander: EffectsExpander, it: Item } / {abort.raise} =
  match item {
    FunctionItem(d) -> {
      let ps = expand_effects_in_parameters(expander, d.params);
      let r = expand_effects_in_optional_type(ps.expander, d.ret);
      let ef = expand_optional_effects(r.expander, d.effects);
      let spec = d.spec.fold(
        { expander: ef.expander, xs: [] },
        |acc: { expander: EffectsExpander, xs: List<SpecClause> }, clause: SpecClause| {
          let o = expand_effects_in_expression(acc.expander, clause.expression);
          {
            expander: o.expander,
            xs: acc.xs.push({ kind: clause.kind, expression: o.e, span: clause.span }),
          }
        },
      );
      let measured: { expander: EffectsExpander, e: Option<Expression> } = match d.decreases {
        None -> { expander: spec.expander, e: None },
        Some(e) -> {
          let o = expand_effects_in_expression(spec.expander, e);
          { expander: o.expander, e: Some(o.e) }
        },
      };
      let b = expand_effects_in_expression(measured.expander, d.body);
      {
        expander: b.expander,
        it: FunctionItem({
          visibility: d.visibility,
          name: d.name,
          generics: d.generics,
          params: ps.ps,
          ret: r.t,
          effects: ef.r,
          constraints: d.constraints,
          spec: spec.xs,
          returns: d.returns,
          reuse: d.reuse,
          transparent: d.transparent,
          constant: d.constant,
          decreases: measured.e,
          body: b.e,
          doc: d.doc,
          span: d.span,
        }),
      }
    },
    TypeItem(d) -> match d.body {
      AliasBody(t) -> {
        let o = expand_effects_in_type(expander, t);
        { expander: o.expander, it: TypeItem({ ..d, body: AliasBody(o.t) }) }
      },
      NominalBody(t) -> {
        let o = expand_effects_in_type(expander, t);
        { expander: o.expander, it: TypeItem({ ..d, body: NominalBody(o.t) }) }
      },
      ExternBody -> { expander: expander, it: item },
      SumBody(vs) -> {
        let out = vs.fold(
          { expander: expander, vs: [] },
          |acc: { expander: EffectsExpander, vs: List<VariantDefinition> }, variant: VariantDefinition| {
            let o = expand_effects_in_types(acc.expander, variant.fields);
            { expander: o.expander, vs: acc.vs.push({ ..variant, fields: o.ts }) }
          },
        );
        { expander: out.expander, it: TypeItem({ ..d, body: SumBody(out.vs) }) }
      },
    },
    EffectItem(d) -> {
      let ops = d.operations.fold(
        { expander: expander, operations: [] },
        |acc: { expander: EffectsExpander, operations: List<OpDefinition> }, op: OpDefinition| {
          let ps = expand_effects_in_types(acc.expander, op.params);
          let r = expand_effects_in_type(ps.expander, op.ret);
          {
            expander: r.expander,
            operations: acc.operations.push({ ..op, params: ps.ts, ret: r.t }),
          }
        },
      );
      { expander: ops.expander, it: EffectItem({ ..d, operations: ops.operations }) }
    },
    TestItem(d) -> {
      let ranged: { expander: EffectsExpander, cases: Option<Cases> } = match d.cases {
        None -> { expander: expander, cases: None },
        Some(c) -> {
          let t = expand_effects_in_type(expander, c.ty);
          let table = expand_effects_in_expression(t.expander, c.table);
          let label = expand_effects_in_expression(table.expander, c.label);
          {
            expander: label.expander,
            cases: Some({ ..c, ty: t.t, table: table.e, label: label.e }),
          }
        },
      };
      let o = expand_effects_in_expression(ranged.expander, d.body);
      { expander: o.expander, it: TestItem({ ..d, cases: ranged.cases, body: o.e }) }
    },
    LawItem(d) -> {
      let bs = d.binders.fold(
        { expander: expander, binders: [] },
        |acc: { expander: EffectsExpander, binders: List<Binder> }, b: Binder| {
          let o = expand_effects_in_type(acc.expander, b.ty);
          {
            expander: o.expander,
            binders: acc.binders.push({ name: b.name, ty: o.t, span: b.span }),
          }
        },
      );
      let g = expand_effects_in_optional_expression(bs.expander, d.guard);
      let b = expand_effects_in_expression(g.expander, d.body);
      { expander: b.expander, it: LawItem({ ..d, binders: bs.binders, guard: g.e, body: b.e }) }
    },
    _ -> { expander: expander, it: item },
  }

fn has_schema_law(module: Module) -> Bool =
  module.items.fold(false, |found: Bool, item: Item|
    found || (match item { LawItem(d) -> d.of != None, _ -> false }))

fn fresh_name(
  name: Bytes,
  args: List<Expression>,
  taken: List<Bytes>,
  budget: Int,
) -> Bytes / {abort.raise} =
  iterate(name, budget, |n: Bytes|
    if !taken.contains(n) && !args.any(|x: Expression| bare_names_read(x).contains(n)) { Stop(n) }
    else { Continue(n.concat(b"_")) })

fn schema_identities(schema: SchemaDefinition) -> List<SchemaIdentity> = {
  let written = law_type_variables(schema.params.concat(schema.binders));
  let arguments = schema.generics.types.filter(|g: Identifier| written.contains(g.name));
  schema.identities.fold([], |acc: List<SchemaIdentity>, ident: Identifier|
    match arguments.find_index(|g: Identifier| g.name == ident.name) {
      Some(position) -> acc.push({ name: ident.name, position: position }),
      None -> acc,
    })
}

type Instantiation = { r: Resolution, law: LawDefinition, diagnostics: List<Diagnostic> }

fn instantiate_law(
  r: Resolution,
  modules: List<ParsedModule>,
  m: Int,
  d: LawDefinition,
  i: SchemaInstance,
  diagnostics: List<Diagnostic>,
) -> Instantiation / {abort.raise} =
  match find(r, m, ValueSpace, i.schema) {
    None -> { r: r, law: d, diagnostics: diagnostics },
    Some(b) -> {
      let name = i.schema.name.name;
      let home = modules.get(b.owner);
      let args = match d.body { CallExpression(a) -> a.args, _ -> [] };
      match schema_named(home.module, name) {
        None ->
          {
            r: r,
            law: d,
            diagnostics: diagnostics.push(
              error_at_and(
                b"E0472",
                m,
                i.schema.span,
                Bytes::concat_all([b"`", name, b"` is not a law schema"]),
                b"a law instantiates a schema",
                b.owner,
                b.span,
                b"declared here",
                [
                  b"a schema is declared `law schema name(f: (A) -> B) forall (x: A) { .. }`, and a law over a definition that is not one writes its own binders and body",
                ],
              ),
            ),
          },
        Some(schema) -> if args.len() != schema.params.len() {
          {
            r: r,
            law: d,
            diagnostics: diagnostics.push(
              error_at_and(
                b"E0202",
                m,
                i.span,
                Bytes::concat_all([
                  b"the schema `",
                  name,
                  b"` takes ",
                  plural_count(schema.params.len(), b"argument"),
                  b", but ",
                  ascii_of_int(args.len()),
                  if args.len() == 1 { b" was supplied" } else { b" were supplied" },
                ]),
                Bytes::concat_all([
                  b"expected ",
                  ascii_of_int(schema.params.len()),
                  b", found ",
                  ascii_of_int(args.len()),
                ]),
                b.owner,
                schema.name.span,
                b"this is the schema being instantiated",
                [],
              ),
            ),
          }
        } else {
          let at = { ..i.span, site: 0 };
          let schema_at = { ..i.schema.span, site: 0 };
          let through = { name: implicit_binder(home.name), span: schema_at };
          let end = span_between(i.span.end, i.span.end);
          let names = schema.binders.fold([], |acc: List<Bytes>, binder: Binder|
            acc.push(
              fresh_name(binder.name.name, args, acc, i.span.end - i.span.start + acc.len() + 2),
            ));
          let given = args.concat(
            names.map(|n: Bytes|
              NameExpression({
                span: end,
                name: { module: None, name: { name: n, span: end }, span: end },
              })),
          );
          let call = |callee: Bytes, made: Span|
            CallExpression({
              span: made,
              function: NameExpression({
                span: schema_at,
                name: {
                  module: Some(through),
                  name: { name: callee, span: { ..i.schema.name.span, site: 0 } },
                  span: schema_at,
                },
              }),
              named: [],
              args: given,
              labels: [],
            });
          {
            r: add_module_binding(r, m, through.name, b.owner),
            law: {
              ..d,
              binders: names.map(|n: Bytes|
                {
                  name: { name: n, span: at },
                  ty: VariableTypeExpression({ name: n, span: at }),
                  span: at,
                }),
              guard: match schema.guard {
                Some(_) -> Some(call(schema_guard_name(name), schema_at)),
                None -> None,
              },
              of: Some({
                ..i,
                home: Some(home.name),
                shown: schema.binders.map(|binder: Binder| binder.name.name),
                identities: schema_identities(schema),
              }),
              body: call(name, at),
            },
            diagnostics: diagnostics,
          }
        },
      }
    },
  }

fn plural_count(n: Int, what: Bytes) -> Bytes =
  Bytes::concat_all([ascii_of_int(n), b" ", what, if n == 1 { b"" } else { b"s" }])

type LawInstantiation = {
  r: Resolution,
  modules: List<ParsedModule>,
  diagnostics: List<Diagnostic>,
}

pub fn instantiate_laws(
  r: Resolution,
  modules: List<ParsedModule>,
) -> LawInstantiation / {abort.raise} =
  range(0, modules.len()).fold(
    { r: r, modules: [], diagnostics: [] },
    |acc: LawInstantiation, m: Int| {
      let mod: ParsedModule = modules.get(m);
      if !has_schema_law(mod.module) { { ..acc, modules: acc.modules.push(mod) } } else {
        let walked = mod.module.items.fold(
          { r: acc.r, items: [], diagnostics: acc.diagnostics },
          |w: { r: Resolution, items: List<Item>, diagnostics: List<Diagnostic> }, item: Item|
            match item {
              LawItem(d) -> match d.of {
                None -> { ..w, items: w.items.push(item) },
                Some(i) -> {
                  let o = instantiate_law(w.r, modules, m, d, i, w.diagnostics);
                  {
                    r: o.r,
                    items: w.items.push(numbered_missing(LawItem(o.law))),
                    diagnostics: o.diagnostics,
                  }
                },
              },
              _ -> { ..w, items: w.items.push(item) },
            },
        );
        {
          r: walked.r,
          modules: acc.modules.push({ ..mod, module: { ..mod.module, items: walked.items } }),
          diagnostics: walked.diagnostics,
        }
      }
    },
  )

type SetExpansion = { r: Resolution, modules: List<ParsedModule>, diagnostics: List<Diagnostic> }

pub fn expand_sets(r: Resolution, modules: List<ParsedModule>) -> SetExpansion / {abort.raise} = {
  let t = set_expand_all(r, set_cycles(set_includes(r, set_table(modules))));
  range(0, modules.len()).fold(
    { r: r, modules: [], diagnostics: t.diagnostics },
    |acc: SetExpansion, m: Int| {
      let o = expand_module_sets(r, t, m, modules.get(m));
      {
        r: o.expander.reached.fold(acc.r, |rr: Resolution, binding: ModuleBinding|
          add_module_binding(rr, m, binding.binder, binding.target)),
        modules: acc.modules.push(o.module),
        diagnostics: concat_diagnostics(acc.diagnostics, o.expander.diagnostics),
      }
    },
  )
}

pub fn add_module_binding(
  resolved: Resolution,
  module: Int,
  binder: Bytes,
  target: Int,
) -> Resolution / {abort.raise} = {
  let scope: Scope = resolved.scopes.get(module);
  match find_module_binding(scope.modules, binder) {
    Some(_) -> resolved,
    None ->
      {
        ..resolved,
        scopes: resolved.scopes.set(module, {
          ..scope,
          modules: scope.modules.push({ binder: binder, target: target, span: dummy_span() }),
        }),
      },
  }
}

pub fn concat_diagnostics(a: List<Diagnostic>, b: List<Diagnostic>) -> List<Diagnostic> =
  b.fold(a, |acc: List<Diagnostic>, diagnostic: Diagnostic| acc.push(diagnostic))
