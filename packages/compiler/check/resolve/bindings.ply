//! What each name written in a module refers to, by where it was written: the name resolution the
//! checker and the tools that read or rewrite code share. A name only types settle, a field's or a
//! call on a value's, is told apart from the rest as what it is written as.

import compiler.syntax.parsing (Span, Ident, QName)
import compiler.syntax.exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock,
                              ERecord, ERecordUpdate, ETry, EField, EList, EPerform, EHandle,
                              EWithHold, ESimulate, EParallel, ETagged, EHole, EBad, ETryBlock,
                              Stmt, SLet, SLetElse, SExpr, SAssign, Param, MatchArm, HandleClause,
                              RecField, NamedArg, Hole, HandlerVar, ReturnClause, tagged_parser,
                              expr_span)
import compiler.syntax.patterns (Pattern, PWild, PVar, PLit, PRange, PCtor, PRecord, PList, POr,
                                 pat_span)
import compiler.syntax.type_syntax (TypeExpr, TVar, TCon, TFn, TRecord, TUnit, TBad, RowExpr,
                                    AtomExpr, ty_span)
import compiler.syntax.items (Module, Item, IFn, IType, IEffect, ITest, ILaw, ISchema, IExtern,
                              IDerive, IInstance, INumeric, IEffectSet, NHost, NumericOp, FnDef,
                              TypeDef, TDAlias, TDSum, TDNominal, VariantDef, EffectDef, OpDef,
                              TestDef, LawDef, SpecClause, SRequires, SEnsures, SCost, SSpace,
                              ReturnsParam, Binder, ImportDecl, INames, result_name, test_run,
                              test_listing, case_params)
import compiler.check.resolve.tables (Resolved, Namespace, ValueSpace, TypeSpace, EffectSpace,
                                      SetSpace, Binding, find_module_binding, lookup_declared,
                                      namespaces)
import compiler.check.resolve.scopes (find)
import std.list

/// What a written name refers to: a local, by the site of the name that binds it, which is unique in
/// its item; a definition, by its program-wide name and namespace; an effect's operation; a
/// module, by its index; or nothing the module binds, such as a builtin.
pub type Refers =
  | Local(Int)
  | Definition({ qualified: Bytes, namespace: Namespace })
  | Operation({ effect: Bytes, name: Bytes })
  | Module(Int)
  | Unbound

/// A name as written: the site of its node, where its text starts and ends, the text, and what it
/// refers to. `shorthand` is a record's or a record pattern's field written by its name alone,
/// `{ x }`, where one name is both the field and what it reads or binds.
pub type Reference = {
  site: Int,
  start: Int,
  end: Int,
  name: Bytes,
  refers: Refers,
  shorthand: Bool,
}

/// A name only types settle, as written: a record's field, by its name alone, since records are
/// structural; the function or field a call on a value names, which the checker's member site at
/// the call's site settles; or a named argument, the parameter of what the call at `call` calls,
/// `callee` where the call names it rather than calling on a value.
pub type Member = { start: Int, end: Int, name: Bytes, kind: MemberKind }

pub type MemberKind = | FieldName | CalledName(Int) | ArgumentName({ call: Int, callee: Refers })

/// What one item, or a module's imports, writes: each name with what it refers to, and each name
/// only types settle.
pub type Written = { references: List<Reference>, members: List<Member> }

/// `found` holds each name by its site, and `members` each member by where it starts: the trees an
/// item is read as may share a name. `members` is `None` for a walk that only wants the references.
/// `find` is what a name the walk does not bind names, and `module_named` the module a qualifier
/// names; a walk of code no resolution reads finds neither, and so binds its locals alone.
type Walk = {
  find: (Namespace, QName) -> Option<Binding> / {abort.raise},
  module_named: (Bytes) -> Option<Int> / {abort.raise},
  scopes: List<Map<Bytes, Refers>>,
  found: Map<Int, Reference>,
  members: Option<Map<Int, Member>>,
}

fn walk_of(resolved: Resolved, index: Int) -> Walk =
  {
    find: |namespace: Namespace, qname: QName| find(resolved, index, namespace, qname),
    module_named: |name: Bytes|
      match find_module_binding(resolved.scopes.get(index).modules, name) {
        Some(m) -> Some(m.target),
        None -> None,
      },
    scopes: [Map::new()],
    found: Map::new(),
    members: None,
  }

fn unresolved() -> Walk =
  {
    find: |_: Namespace, _: QName| None,
    module_named: |_: Bytes| None,
    scopes: [Map::new()],
    found: Map::new(),
    members: None,
  }

fn reference(name: Ident, refers: Refers, shorthand: Bool) -> Reference =
  {
    site: name.span.site,
    start: name.span.start,
    end: name.span.end,
    name: name.name,
    refers: refers,
    shorthand: shorthand,
  }

fn noted(w: Walk, name: Ident, refers: Refers, shorthand: Bool) -> Walk =
  { ..w, found: w.found.insert(name.span.site, reference(name, refers, shorthand)) }

fn member(w: Walk, name: Ident, kind: MemberKind) -> Walk =
  match w.members {
    None -> w,
    Some(m) ->
      {
        ..w,
        members: Some(
          m.insert(name.span.start, {
            start: name.span.start,
            end: name.span.end,
            name: name.name,
            kind: kind,
          }),
        ),
      },
  }

fn refers_of(w: Walk, name: Ident) -> Refers =
  match w.found.get(name.span.site) { Some(r) -> r.refers, None -> Unbound }

fn pushed(w: Walk) -> Walk = { ..w, scopes: w.scopes.push(Map::new()) }

fn popped(w: Walk) -> Walk =
  if w.scopes.len() > 0 { { ..w, scopes: w.scopes.take(w.scopes.len() - 1) } } else { w }

fn scoped(w: Walk, name: Bytes, refers: Refers) -> Walk / {abort.raise} = {
  let inner = w.scopes.at(w.scopes.len() - 1).unwrap_or(Map::new());
  { ..w, scopes: w.scopes.take(w.scopes.len() - 1).push(inner.insert(name, refers)) }
}

fn local(w: Walk, name: Bytes) -> Option<Refers> =
  w.scopes.fold(None, |found: Option<Refers>, scope: Map<Bytes, Refers>|
    match scope.get(name) { Some(r) -> Some(r), None -> found })

fn bound(w: Walk, name: Ident) -> Walk / {abort.raise} = binder(w, name, false, false)

/// `name` binding a local in the innermost scope, the local its site names; or, in an or-pattern's
/// alternative after the first (`again`), naming the local the first alternative bound.
fn binder(w: Walk, name: Ident, shorthand: Bool, again: Bool) -> Walk / {abort.raise} =
  if again { noted(w, name, local(w, name.name).unwrap_or(Unbound), shorthand) } else {
    let site = name.span.site;
    noted(scoped(w, name.name, Local(site)), name, Local(site), shorthand)
  }

fn bare(name: Ident) -> QName = { module: None, name: name, span: name.span }

fn definition(w: Walk, namespace: Namespace, qname: QName) -> Refers / {abort.raise} =
  match (w.find)(namespace, qname) {
    Some(b) -> Definition({ qualified: b.qualified, namespace: namespace }),
    None -> Unbound,
  }

/// What `qname`'s qualifier names: a module, or a type whose function `qname` is.
fn qualifier(w: Walk, qname: QName) -> Walk / {abort.raise} =
  match qname.module {
    None -> w,
    Some(q) -> match (w.module_named)(q.name) {
      Some(m) -> noted(w, q, Module(m), false),
      None -> match definition(w, TypeSpace, bare(q)) {
        Unbound -> w,
        type_named -> noted(w, q, type_named, false),
      },
    },
  }

fn value_named(w: Walk, qname: QName, shorthand: Bool) -> Walk / {abort.raise} = {
  let refers = match qname.module {
    None -> match local(w, qname.name.name) {
      Some(r) -> r,
      None -> definition(w, ValueSpace, qname),
    },
    Some(_) -> definition(w, ValueSpace, qname),
  };
  noted(qualifier(w, qname), qname.name, refers, shorthand)
}

/// A field's name the parser made rather than read, as a tuple's `_0`: it stands where its element
/// does.
fn made_field(name: Ident, at: Span) -> Bool =
  name.span.start == at.start && name.span.end == at.end

/// Whether a field is written by its name alone, `{ x }`: one name, written once, is the field and
/// the local.
fn pun(field: Ident, name: Ident) -> Bool =
  name.name == field.name && name.span.start == field.span.start

fn labelled(w: Walk, field: Ident, punned: Bool, at: Span) -> Walk =
  if !punned && made_field(field, at) { w } else { member(w, field, FieldName) }

fn walk_field(w: Walk, field: RecField) -> Walk / {abort.raise} =
  match field.value {
    EVar(v) -> {
      let punned = v.name.module == None && pun(field.name, v.name.name);
      value_named(labelled(w, field.name, punned, v.span), v.name, punned)
    },
    _ -> walk_expr(labelled(w, field.name, false, expr_span(field.value)), field.value),
  }

fn named_in(w: Walk, namespace: Namespace, qname: QName) -> Walk / {abort.raise} =
  noted(qualifier(w, qname), qname.name, definition(w, namespace, qname), false)

fn effect_of(w: Walk, eff: QName) -> Bytes / {abort.raise} =
  match (w.find)(EffectSpace, eff) { Some(b) -> b.qualified, None -> eff.name.name }

fn operation(w: Walk, eff: QName, op: Ident) -> Walk / {abort.raise} =
  noted(
    named_in(w, EffectSpace, eff),
    op,
    Operation({ effect: effect_of(w, eff), name: op.name }),
    false,
  )

fn walk_type(w: Walk, t: TypeExpr) -> Walk / {abort.raise} =
  match t {
    TCon(c) -> c.rows.fold(c.args.fold(named_in(w, TypeSpace, c.name), walk_type), walk_row),
    TFn(f) -> walk_effects(walk_type(f.params.fold(w, walk_type), f.ret), f.effects),
    TRecord(r) ->
      r.fields.fold(w, |acc: Walk, field: { name: Ident, ty: TypeExpr }|
        walk_type(labelled(acc, field.name, false, ty_span(field.ty)), field.ty)),
    _ -> w,
  }

fn walk_row(w: Walk, r: RowExpr) -> Walk / {abort.raise} = walk_atoms(w, r.atoms, r.aliases)

/// The effects and operations a row or an effect set names, then the sets it takes in.
fn walk_atoms(w: Walk, atoms: List<AtomExpr>, sets: List<QName>) -> Walk / {abort.raise} =
  sets.fold(
    atoms.fold(w, |acc: Walk, a: AtomExpr|
      match a.op {
        Some(op) -> operation(acc, a.eff, op),
        None -> named_in(acc, EffectSpace, a.eff),
      }),
    |acc: Walk, set: QName| named_in(acc, SetSpace, set),
  )

fn walk_effects(w: Walk, r: Option<RowExpr>) -> Walk / {abort.raise} =
  match r { Some(x) -> walk_row(w, x), None -> w }

fn walk_optional_type(w: Walk, t: Option<TypeExpr>) -> Walk / {abort.raise} =
  match t { Some(x) -> walk_type(w, x), None -> w }

/// The constructors a pattern names, then the locals it binds, in the innermost scope. `again` is
/// an or-pattern's alternative after the first, whose names are the first one's locals.
fn walk_pattern(w: Walk, p: Pattern, again: Bool) -> Walk / {abort.raise} =
  match p {
    PVar(v) -> binder(w, v.name, false, again),
    PCtor(c) ->
      c.args.fold(named_in(w, ValueSpace, c.name), |acc: Walk, x: Pattern|
        walk_pattern(acc, x, again)),
    PRecord(r) ->
      r.fields.fold(w, |acc: Walk, field: { name: Ident, pat: Pattern }|
        match field.pat {
          PVar(v) -> {
            let punned = pun(field.name, v.name);
            binder(labelled(acc, field.name, punned, v.span), v.name, punned, again)
          },
          _ ->
            walk_pattern(labelled(acc, field.name, false, pat_span(field.pat)), field.pat, again),
        }),
    PList(l) -> {
      let items = l.items.fold(w, |acc: Walk, x: Pattern| walk_pattern(acc, x, again));
      match l.rest { Some(rest) -> walk_pattern(items, rest, again), None -> items }
    },
    POr(o) -> match o.alts {
      [head, ..rest] ->
        rest.fold(walk_pattern(w, head, again), |acc: Walk, alt: Pattern|
          walk_pattern(acc, alt, true)),
      [] -> w,
    },
    _ -> w,
  }

/// A scope binding the parameters, then each one's type and default.
fn walk_params(w: Walk, ps: List<Param>) -> Walk / {abort.raise} =
  ps.fold(ps.fold(pushed(w), |acc: Walk, p: Param| bound(acc, p.name)), |acc: Walk, p: Param| {
    let typed = walk_optional_type(acc, p.ty);
    match p.default { Some(d) -> walk_expr(typed, d), None -> typed }
  })

/// A clause in its definition's scope: an `ensures` also binds `result`, the clause its binder, and
/// a `cost` or `space` clause the name each parameter gives its steps or what it holds.
fn walk_spec(w: Walk, ps: List<Param>, s: SpecClause) -> Walk / {abort.raise} = {
  let named = |of: (Param) -> Option<Ident>|
    ps.fold(pushed(w), |acc: Walk, p: Param| match of(p) { Some(k) -> bound(acc, k), None -> acc });
  let scope = match s.kind {
    SEnsures -> scoped(pushed(w), result_name(), Local(s.span.site)),
    SCost -> named(|p: Param| p.cost),
    SSpace -> named(|p: Param| p.space),
    SRequires -> pushed(w),
  };
  popped(walk_expr(scope, s.expr))
}

fn walk_stmt(w: Walk, s: Stmt) -> Walk / {abort.raise} =
  match s {
    SLet(l) -> walk_pattern(walk_optional_type(walk_expr(w, l.value), l.ty), l.pat, false),
    SLetElse(l) ->
      walk_pattern(
        walk_optional_type(walk_expr(walk_expr(w, l.value), l.fallback), l.ty),
        l.pat,
        false,
      ),
    SExpr(e) -> walk_expr(w, e),
    SAssign(a) ->
      walk_expr(noted(w, a.name, local(w, a.name.name).unwrap_or(Unbound), false), a.value),
  }

/// A handler's variables in scope, as the clauses and the `return` clause see them.
fn in_scope(w: Walk, vars: List<HandlerVar>) -> Walk / {abort.raise} =
  vars.fold(pushed(w), |acc: Walk, v: HandlerVar| scoped(acc, v.name.name, Local(v.name.span.site)))

fn walk_clause(w: Walk, vars: List<HandlerVar>, c: HandleClause) -> Walk / {abort.raise} = {
  let with_params = c.params.fold(in_scope(operation(w, c.eff, c.op), vars), bound);
  let with_label = match c.label_binder { Some(l) -> bound(with_params, l), None -> with_params };
  let with_resume = match c.resume { Some(k) -> bound(with_label, k), None -> with_label };
  popped(walk_expr(with_resume, c.body))
}

fn walk_expr(w: Walk, e: Expr) -> Walk / {abort.raise} =
  match e {
    EVar(v) -> value_named(w, v.name, false),
    EBinary(b) -> walk_expr(walk_expr(w, b.lhs), b.rhs),
    EUnary(u) -> walk_expr(w, u.operand),
    ELambda(l) -> popped(walk_expr(walk_optional_type(walk_params(w, l.params), l.ret), l.body)),
    EApp(a) -> {
      let called = match a.func {
        EField(f) -> member(walk_expr(w, f.base), f.field, CalledName(a.span.site)),
        _ -> walk_expr(w, a.func),
      };
      let callee = match a.func { EVar(v) -> refers_of(called, v.name.name), _ -> Unbound };
      a.args.fold(
        a.named.fold(called, |acc: Walk, n: NamedArg|
          walk_expr(
            member(acc, n.name, ArgumentName({ call: a.span.site, callee: callee })),
            n.value,
          )),
        walk_expr,
      )
    },
    EIf(i) -> walk_expr(walk_expr(walk_expr(w, i.cond), i.then_branch), i.else_branch),
    EMatch(m) ->
      m.arms.fold(walk_expr(w, m.scrutinee), |acc: Walk, arm: MatchArm| {
        let bound_arm = walk_pattern(pushed(acc), arm.pat, false);
        let guarded = match arm.guard { Some(g) -> walk_expr(bound_arm, g), None -> bound_arm };
        popped(walk_expr(guarded, arm.body))
      }),
    EBlock(b) -> {
      let stmts = b.stmts.fold(pushed(w), walk_stmt);
      popped(match b.tail { Some(t) -> walk_expr(stmts, t), None -> stmts })
    },
    ERecord(r) -> r.fields.fold(w, walk_field),
    ERecordUpdate(u) -> u.fields.fold(walk_expr(w, u.base), walk_field),
    ETry(t) -> walk_expr(w, t.operand),
    EField(f) -> member(walk_expr(w, f.base), f.field, FieldName),
    EList(l) -> l.items.fold(w, walk_expr),
    EPerform(p) -> match if p.eff.module == None { local(w, p.eff.name.name) } else { None } {
      Some(Local(b)) ->
        p.args.fold(
          member(noted(w, p.eff.name, Local(b), false), p.op, CalledName(p.span.site)),
          walk_expr,
        ),
      _ -> p.args.fold(operation(w, p.eff, p.op), walk_expr),
    },
    EHandle(h) -> {
      let made = h.vars.fold(pushed(w), |acc: Walk, v: HandlerVar|
        bound(walk_expr(walk_optional_type(acc, v.ty), v.init), v.name));
      let clauses = h.clauses.fold(walk_expr(popped(made), h.body), |acc: Walk, c: HandleClause|
        walk_clause(acc, h.vars, c));
      match h.ret {
        Some(r) -> popped(walk_expr(bound(in_scope(clauses, h.vars), r.binder), r.body)),
        None -> clauses,
      }
    },
    EWithHold(h) -> {
      let around = walk_expr(walk_expr(w, h.acquire), h.release);
      popped(walk_expr(bound(pushed(around), h.binder), h.body))
    },
    ESimulate(s) -> walk_expr(w, s.body),
    EParallel(p) -> p.branches.fold(w, walk_expr),
    ETagged(t) ->
      t.holes.fold(qualifier(w, tagged_parser(t)), |acc: Walk, hole: Hole|
        walk_expr(acc, hole.value)),
    ETryBlock(t) -> {
      let raised = match t.raise { Some(r) -> operation(w, r.eff, r.op), None -> w };
      walk_expr(raised, t.body)
    },
    _ -> w,
  }

fn walk_fn(w: Walk, f: FnDef) -> Walk / {abort.raise} = {
  let params = walk_params(named_in(w, ValueSpace, bare(f.name)), f.params);
  let typed = walk_effects(walk_optional_type(params, f.ret), f.effects);
  let returned = match f.returns {
    Some(ReturnsParam(p)) -> noted(typed, p, local(typed, p.name).unwrap_or(Unbound), false),
    _ -> typed,
  };
  let specs = f.spec.fold(returned, |acc: Walk, s: SpecClause| walk_spec(acc, f.params, s));
  let measured = match f.decreases { Some(d) -> walk_expr(specs, d), None -> specs };
  popped(walk_expr(measured, f.body))
}

/// A law's or a schema's binders, then its guard and its body, the binders in scope.
fn walk_quantified(
  w: Walk,
  binders: List<Binder>,
  guard: Option<Expr>,
  body: Expr,
) -> Walk / {abort.raise} = {
  let bound_all = binders.fold(pushed(w), |acc: Walk, b: Binder|
    bound(walk_type(acc, b.ty), b.name));
  let guarded = match guard { Some(g) -> walk_expr(bound_all, g), None -> bound_all };
  popped(walk_expr(guarded, body))
}

fn walk_item(w: Walk, item: Item) -> Walk / {abort.raise} =
  match item {
    IFn(f) -> walk_fn(w, f),
    IExtern(x) -> {
      let params = walk_params(named_in(w, ValueSpace, bare(x.name)), x.params);
      let typed = walk_effects(walk_type(params, x.ret), x.effects);
      popped(x.spec.fold(typed, |acc: Walk, s: SpecClause| walk_spec(acc, x.params, s)))
    },
    IType(t) -> {
      let declared = named_in(w, TypeSpace, bare(t.name));
      match t.body {
        TDAlias(x) -> walk_type(declared, x),
        TDNominal(x) -> walk_type(declared, x),
        TDSum(variants) ->
          variants.fold(declared, |acc: Walk, v: VariantDef|
            v.fields.fold(named_in(acc, ValueSpace, bare(v.name)), walk_type)),
        _ -> declared,
      }
    },
    IEffect(eff) -> {
      let qualified = effect_of(w, bare(eff.name));
      eff.ops.fold(named_in(w, EffectSpace, bare(eff.name)), |acc: Walk, op: OpDef| {
        let declared = noted(
          acc,
          op.name,
          Operation({ effect: qualified, name: op.name.name }),
          false,
        );
        let typed = walk_type(op.params.fold(declared, walk_type), op.ret);
        popped(op.param_names.fold(pushed(typed), bound))
      })
    },
    ITest(t) -> match t.cases {
      Some(c) -> {
        let entered = case_params(c).fold(
          pushed(w),
          |acc: Walk, p: { name: Ident, ty: TypeExpr }| bound(walk_type(acc, p.ty), p.name),
        );
        popped(walk_expr(walk_expr(entered, test_run(t)), test_listing(c)))
      },
      None -> walk_expr(w, t.body),
    },
    ILaw(l) -> walk_quantified(w, l.binders, l.guard, l.body),
    ISchema(s) -> walk_quantified(w, s.params.concat(s.binders), s.guard, s.body),
    IDerive(d) -> named_in(w, TypeSpace, bare(d.target)),
    IInstance(d) ->
      named_in(
        named_in(w, if d.kind == NHost { EffectSpace } else { TypeSpace }, bare(d.target)),
        ValueSpace,
        bare(d.by),
      ),
    INumeric(d) ->
      d.ops.fold(named_in(w, TypeSpace, bare(d.target)), |acc: Walk, x: NumericOp|
        named_in(acc, ValueSpace, bare(x.by))),
    IEffectSet(d) -> walk_atoms(named_in(w, SetSpace, bare(d.name)), d.atoms, d.includes),
  }

/// What each name `module`'s imports bind refers to: what the module each import names declares
/// under it. An import has no item, so its names no site.
fn import_references(
  resolved: Resolved,
  index: Int,
  module: Module,
) -> List<Reference> / {abort.raise} = {
  let targets = resolved.imports.get(index);
  range(0, module.imports.len()).fold([], |acc: List<Reference>, k: Int|
    match ((module.imports.get(k).kind, targets.at(k))) {
      (INames(names), Some(target)) ->
        names.fold(acc, |found: List<Reference>, n: Ident|
          found.push(reference(n, declared_in(resolved, target, n.name), false))),
      _ -> acc,
    })
}

fn declared_in(resolved: Resolved, module: Int, name: Bytes) -> Refers / {abort.raise} =
  namespaces().fold(Unbound, |r: Refers, namespace: Namespace|
    match r {
      Unbound -> match lookup_declared(resolved.declarations.get(module), namespace, name) {
        Some(d) -> Definition({ qualified: d.qualified, namespace: namespace }),
        None -> Unbound,
      },
      _ -> r,
    })

/// The binder of each local `item` names, by the site of the name: how a check of the item finds
/// its locals.
pub fn item_binders(resolved: Resolved, index: Int, item: Item) -> Map<Int, Int> / {abort.raise} =
  binders_of(walk_item(walk_of(resolved, index), item).found)

/// The binder of each local `expr`, written in the module at `index`, names, by the site of the name.
pub fn expression_binders(
  resolved: Resolved,
  index: Int,
  expr: Expr,
) -> Map<Int, Int> / {abort.raise} = binders_of(walk_expr(walk_of(resolved, index), expr).found)

/// The binder of each local `body` names, with `params` bound around it, by the site of the name:
/// how code made after the check, which no resolution reads, finds its locals.
pub fn body_binders(params: List<Ident>, body: Expr) -> Map<Int, Int> / {abort.raise} =
  binders_of(walk_expr(params.fold(pushed(unresolved()), bound), body).found)

/// The binder of each local `item` names, by the site of the name, with nothing resolved: how a
/// walk that reads the item as written, as hashing does, finds its locals.
pub fn item_locals(item: Item) -> Map<Int, Int> / {abort.raise} =
  binders_of(walk_item(unresolved(), item).found)

fn binders_of(found: Map<Int, Reference>) -> Map<Int, Int> =
  found.fold(Map::new(), |binders: Map<Int, Int>, site: Int, r: Reference|
    match r.refers { Local(b) -> binders.insert(site, b), _ -> binders })

/// What `module`, the module at index `index` of `resolved` as its text is written and numbered,
/// writes: its imports' names, then each item's, in order. A name's site is unique within its item,
/// not its module, and is the site the check files what it found of the name under.
pub fn written(resolved: Resolved, index: Int, module: Module) -> List<Written> / {abort.raise} =
  module.items.fold(
    [{ references: import_references(resolved, index, module), members: [] }],
    |acc: List<Written>, item: Item| {
      let w = walk_item({ ..walk_of(resolved, index), members: Some(Map::new()) }, item);
      acc.push({
        references: w.found.values(),
        members: match w.members { Some(m) -> m.values(), None -> [] },
      })
    },
  )
