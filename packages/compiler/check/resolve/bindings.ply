import compiler.syntax.parsing (bare, Span, Identifier, QName)
import compiler.syntax.expressions (Expression, LiteralExpression, NameExpression, BinaryExpression,
                                    UnaryExpression, LambdaExpression, CallExpression, IfExpression,
                                    MatchExpression, BlockExpression, RecordExpression,
                                    RecordUpdateExpression, PropagateExpression, FieldExpression,
                                    ListExpression, PerformExpression, HandleExpression,
                                    WithScopeExpression, SimulateExpression, ParallelExpression,
                                    TaggedLiteralExpression, HoleExpression, InvalidExpression,
                                    TryBlockExpression, Statement, LetStatement, LetElseStatement,
                                    ExpressionStatement, AssignmentStatement, Param, MatchArm,
                                    HandleClause, RecordLiteralField, NamedArg, Hole, HandlerVar,
                                    ReturnClause, tagged_parser, expression_span)
import compiler.syntax.patterns (Pattern, PatternWildcard, PatternVariable, PatternLiteral,
                                 PatternRange, PatternConstructor, PatternRecord, PatternList,
                                 PatternOr, pattern_span)
import compiler.syntax.type_syntax (TypeExpression, VariableTypeExpression, NamedTypeExpression,
                                    FunctionTypeExpression, RecordTypeExpression,
                                    UnitTypeExpression, InvalidTypeExpression, EffectsExpression,
                                    EffectExpression, type_span)
import compiler.syntax.items (Module, Item, FunctionItem, TypeItem, EffectItem, TestItem, LawItem,
                              SchemaItem, ExternItem, DeriveItem, InstanceItem, NumericItem,
                              EffectSetItem, HostInstance, NumericOp, FnDefinition, TypeDefinition,
                              AliasBody, SumBody, NominalBody, VariantDefinition, EffectDefinition,
                              OpDefinition, TestDefinition, LawDefinition, SpecClause,
                              RequiresClause, EnsuresClause, CostClause, SpaceClause, ReturnsParam,
                              Binder, ImportDeclaration, SelectedNames, result_name, test_run,
                              test_listing, case_params)
import compiler.check.resolve.tables (Resolution, Namespace, ValueSpace, TypeSpace, EffectSpace,
                                      SetSpace, Binding, find_module_binding, lookup_declared,
                                      namespaces)
import compiler.check.resolve.scopes (find)
import std.list

pub type Refers =
  | Local(Int)
  | Definition({ qualified: Bytes, namespace: Namespace })
  | Operation({ effect: Bytes, name: Bytes })
  | ModuleQualifier(Int)
  | Unbound

pub type Reference = {
  identifier_id: Int,
  start: Int,
  end: Int,
  name: Bytes,
  target: Refers,
  shorthand: Bool,
}

pub type Member = { start: Int, end: Int, name: Bytes, kind: MemberKind }

pub type MemberKind =
  | FieldName(FieldOf)
  | CalledName(Int)
  | ArgumentName({ call: Int, callee: Refers })

pub type FieldOf = | RecordAt(Int) | RecordFields(List<Bytes>) | TypeNamed(Bytes)

pub type Written = { references: List<Reference>, members: List<Member> }

type Walk = {
  find: (Namespace, QName) -> Option<Binding> / {abort.raise},
  module_named: (Bytes) -> Option<Int> / {abort.raise},
  scopes: List<Map<Bytes, Refers>>,
  found: Map<Int, Reference>,
  members: Option<Map<Int, Member>>,
}

fn walk_of(resolved: Resolution, index: Int) -> Walk =
  {
    find: |namespace: Namespace, qname: QName| find(resolved, index, namespace, qname),
    module_named: |name: Bytes|
      match find_module_binding(resolved.scopes.get(index).modules, name) {
        Some(m) -> Some(m.target),
        None -> None,
      },
    scopes: [Map::new()],
    found: Map::new(),
    members: None,
  }

fn empty_walk() -> Walk =
  {
    find: |_: Namespace, _: QName| None,
    module_named: |_: Bytes| None,
    scopes: [Map::new()],
    found: Map::new(),
    members: None,
  }

fn reference(name: Identifier, refers: Refers, shorthand: Bool) -> Reference =
  {
    identifier_id: name.span.site,
    start: name.span.start,
    end: name.span.end,
    name: name.name,
    target: refers,
    shorthand: shorthand,
  }

fn record_reference(w: Walk, name: Identifier, refers: Refers, shorthand: Bool) -> Walk =
  { ..w, found: w.found.insert(name.span.site, reference(name, refers, shorthand)) }

fn member(w: Walk, name: Identifier, kind: MemberKind) -> Walk =
  match w.members {
    None -> w,
    Some(m) ->
      {
        ..w,
        members: Some(
          m.insert(name.span.start, {
            start: name.span.start,
            end: name.span.end,
            name: name.name,
            kind: kind,
          }),
        ),
      },
  }

fn refers_of(w: Walk, name: Identifier) -> Refers =
  match w.found.get(name.span.site) { Some(r) -> r.target, None -> Unbound }

fn pushed(w: Walk) -> Walk = { ..w, scopes: w.scopes.push(Map::new()) }

fn popped(w: Walk) -> Walk =
  if w.scopes.len() > 0 { { ..w, scopes: w.scopes.take(w.scopes.len() - 1) } } else { w }

fn scoped(w: Walk, name: Bytes, refers: Refers) -> Walk = {
  let inner = w.scopes.at(w.scopes.len() - 1).unwrap_or(Map::new());
  { ..w, scopes: w.scopes.take(w.scopes.len() - 1).push(inner.insert(name, refers)) }
}

fn find_local(w: Walk, name: Bytes) -> Option<Refers> =
  w.scopes.fold(None, |found: Option<Refers>, scope: Map<Bytes, Refers>|
    match scope.get(name) { Some(r) -> Some(r), None -> found })

fn bound(w: Walk, name: Identifier) -> Walk / {abort.raise} = binder(w, name, false, false)

fn binder(w: Walk, name: Identifier, shorthand: Bool, again: Bool) -> Walk / {abort.raise} =
  if name.span.site == 0 {
    panic(
      "a binder has no site: numbering gives every written one a site, and a maker mints one for each it makes",
    )
  } else if again {
    record_reference(w, name, find_local(w, name.name).unwrap_or(Unbound), shorthand)
  } else {
    let site = name.span.site;
    record_reference(scoped(w, name.name, Local(site)), name, Local(site), shorthand)
  }

fn definition(w: Walk, namespace: Namespace, qname: QName) -> Refers / {abort.raise} =
  match (w.find)(namespace, qname) {
    Some(b) -> Definition({ qualified: b.qualified, namespace: namespace }),
    None -> Unbound,
  }

fn qualifier(w: Walk, qname: QName) -> Walk / {abort.raise} =
  match qname.module {
    None -> w,
    Some(q) -> match (w.module_named)(q.name) {
      Some(m) -> record_reference(w, q, ModuleQualifier(m), false),
      None -> match definition(w, TypeSpace, bare(q)) {
        Unbound -> w,
        type_named -> record_reference(w, q, type_named, false),
      },
    },
  }

fn value_named(w: Walk, qname: QName, shorthand: Bool) -> Walk / {abort.raise} = {
  let refers = match qname.module {
    None -> match find_local(w, qname.name.name) {
      Some(r) -> r,
      None -> definition(w, ValueSpace, qname),
    },
    Some(_) -> definition(w, ValueSpace, qname),
  };
  record_reference(qualifier(w, qname), qname.name, refers, shorthand)
}

fn made_field(name: Identifier, at: Span) -> Bool =
  name.span.start == at.start && name.span.end == at.end

fn pun(field: Identifier, name: Identifier) -> Bool =
  name.name == field.name && name.span.start == field.span.start

fn labelled(w: Walk, field: Identifier, punned: Bool, at: Span, of: FieldOf) -> Walk =
  if !punned && made_field(field, at) { w } else { member(w, field, FieldName(of)) }

fn walk_fields(w: Walk, fields: List<RecordLiteralField>, of: FieldOf) -> Walk / {abort.raise} =
  fields.fold(w, |acc: Walk, field: RecordLiteralField|
    match field.value {
      NameExpression(v) -> {
        let punned = v.name.module == None && pun(field.name, v.name.name);
        value_named(labelled(acc, field.name, punned, v.span, of), v.name, punned)
      },
      _ ->
        walk_expression(
          labelled(acc, field.name, false, expression_span(field.value), of),
          field.value,
        ),
    })

fn named_in(w: Walk, namespace: Namespace, qname: QName) -> Walk / {abort.raise} =
  record_reference(qualifier(w, qname), qname.name, definition(w, namespace, qname), false)

fn receives_value(w: Walk, name: QName) -> Bool / {abort.raise} =
  (w.find)(EffectSpace, name) == None && (w.find)(ValueSpace, name) != None

fn effect_of(w: Walk, eff: QName) -> Bytes / {abort.raise} =
  match (w.find)(EffectSpace, eff) { Some(b) -> b.qualified, None -> eff.name.name }

fn operation(w: Walk, eff: QName, op: Identifier) -> Walk / {abort.raise} =
  record_reference(
    named_in(w, EffectSpace, eff),
    op,
    Operation({ effect: effect_of(w, eff), name: op.name }),
    false,
  )

fn walk_type(w: Walk, t: TypeExpression) -> Walk / {abort.raise} =
  match t {
    NamedTypeExpression(c) ->
      c.effect_arguments.fold(c.args.fold(named_in(w, TypeSpace, c.name), walk_type), walk_effects),
    FunctionTypeExpression(f) ->
      walk_optional_effects(walk_type(f.params.fold(w, walk_type), f.ret), f.effects),
    RecordTypeExpression(r) ->
      walk_record_type(
        w,
        r.fields,
        RecordFields(
          r.fields.map(|field: { name: Identifier, ty: TypeExpression }| field.name.name),
        ),
      ),
    _ -> w,
  }

fn walk_record_type(
  w: Walk,
  fields: List<{ name: Identifier, ty: TypeExpression }>,
  of: FieldOf,
) -> Walk / {abort.raise} =
  fields.fold(w, |acc: Walk, field: { name: Identifier, ty: TypeExpression }|
    walk_type(labelled(acc, field.name, false, type_span(field.ty), of), field.ty))

fn walk_effects(w: Walk, r: EffectsExpression) -> Walk / {abort.raise} =
  walk_effect_list(w, r.listed, r.aliases)

fn walk_effect_list(
  w: Walk,
  effects: List<EffectExpression>,
  sets: List<QName>,
) -> Walk / {abort.raise} =
  sets.fold(
    effects.fold(w, |acc: Walk, a: EffectExpression|
      match a.op {
        Some(op) -> operation(acc, a.effect_name, op),
        None -> named_in(acc, EffectSpace, a.effect_name),
      }),
    |acc: Walk, set: QName| named_in(acc, SetSpace, set),
  )

fn walk_optional_effects(w: Walk, r: Option<EffectsExpression>) -> Walk / {abort.raise} =
  match r { Some(x) -> walk_effects(w, x), None -> w }

fn walk_optional_type(w: Walk, t: Option<TypeExpression>) -> Walk / {abort.raise} =
  match t { Some(x) -> walk_type(w, x), None -> w }

fn walk_pattern(w: Walk, p: Pattern, again: Bool) -> Walk / {abort.raise} =
  match p {
    PatternVariable(v) -> binder(w, v.name, false, again),
    PatternConstructor(c) ->
      c.args.fold(named_in(w, ValueSpace, c.name), |acc: Walk, x: Pattern|
        walk_pattern(acc, x, again)),
    PatternRecord(r) ->
      r.fields.fold(w, |acc: Walk, field: { name: Identifier, pattern: Pattern }|
        match field.pattern {
          PatternVariable(v) -> {
            let punned = pun(field.name, v.name);
            binder(
              labelled(acc, field.name, punned, v.span, RecordAt(r.span.site)),
              v.name,
              punned,
              again,
            )
          },
          _ ->
            walk_pattern(
              labelled(acc, field.name, false, pattern_span(field.pattern), RecordAt(r.span.site)),
              field.pattern,
              again,
            ),
        }),
    PatternList(l) -> {
      let items = l.items.fold(w, |acc: Walk, x: Pattern| walk_pattern(acc, x, again));
      match l.rest { Some(rest) -> walk_pattern(items, rest, again), None -> items }
    },
    PatternOr(o) -> match o.alternatives {
      [head, ..rest] ->
        rest.fold(walk_pattern(w, head, again), |acc: Walk, alt: Pattern|
          walk_pattern(acc, alt, true)),
      [] -> w,
    },
    _ -> w,
  }

fn walk_params(w: Walk, ps: List<Param>) -> Walk / {abort.raise} =
  ps.fold(ps.fold(pushed(w), |acc: Walk, p: Param| bound(acc, p.name)), |acc: Walk, p: Param| {
    let typed = walk_optional_type(acc, p.ty);
    match p.default { Some(d) -> walk_default(typed, d, p.ty), None -> typed }
  })

fn walk_default(w: Walk, default: Expression, ty: Option<TypeExpression>) -> Walk / {abort.raise} =
  match ((default, ty)) {
    (RecordExpression(r), Some(RecordTypeExpression(t))) ->
      walk_fields(
        w,
        r.fields,
        RecordFields(t.fields.map(|f: { name: Identifier, ty: TypeExpression }| f.name.name)),
      ),
    (RecordExpression(r), Some(NamedTypeExpression(n))) -> match (w.find)(TypeSpace, n.name) {
      Some(b) -> walk_fields(w, r.fields, TypeNamed(b.qualified)),
      None -> walk_expression(w, default),
    },
    _ -> walk_expression(w, default),
  }

fn walk_spec(w: Walk, ps: List<Param>, s: SpecClause) -> Walk / {abort.raise} = {
  let named = |of: (Param) -> Option<Identifier>|
    ps.fold(pushed(w), |acc: Walk, p: Param| match of(p) { Some(k) -> bound(acc, k), None -> acc });
  let scope = match s.kind {
    EnsuresClause -> scoped(pushed(w), result_name(), Local(s.span.site)),
    CostClause -> named(|p: Param| p.cost),
    SpaceClause -> named(|p: Param| p.space),
    RequiresClause -> pushed(w),
  };
  popped(walk_expression(scope, s.expression))
}

fn walk_statement(w: Walk, s: Statement) -> Walk / {abort.raise} =
  match s {
    LetStatement(l) ->
      walk_pattern(walk_optional_type(walk_expression(w, l.value), l.ty), l.pattern, false),
    LetElseStatement(l) ->
      walk_pattern(
        walk_optional_type(walk_expression(walk_expression(w, l.value), l.fallback), l.ty),
        l.pattern,
        false,
      ),
    ExpressionStatement(e) -> walk_expression(w, e),
    AssignmentStatement(a) ->
      walk_expression(
        record_reference(w, a.name, find_local(w, a.name.name).unwrap_or(Unbound), false),
        a.value,
      ),
  }

fn in_scope(w: Walk, vars: List<HandlerVar>) -> Walk =
  vars.fold(pushed(w), |acc: Walk, v: HandlerVar| scoped(acc, v.name.name, Local(v.name.span.site)))

fn walk_clause(w: Walk, vars: List<HandlerVar>, c: HandleClause) -> Walk / {abort.raise} = {
  let with_params = c.params.fold(in_scope(operation(w, c.effect_name, c.op), vars), bound);
  let with_label = match c.label_binder { Some(l) -> bound(with_params, l), None -> with_params };
  let with_resume = match c.resume { Some(k) -> bound(with_label, k), None -> with_label };
  popped(walk_expression(with_resume, c.body))
}

fn walk_expression(w: Walk, e: Expression) -> Walk / {abort.raise} =
  match e {
    NameExpression(v) -> value_named(w, v.name, false),
    BinaryExpression(b) -> walk_expression(walk_expression(w, b.lhs), b.rhs),
    UnaryExpression(u) -> walk_expression(w, u.operand),
    LambdaExpression(l) ->
      popped(walk_expression(walk_optional_type(walk_params(w, l.params), l.ret), l.body)),
    CallExpression(a) -> {
      let called = match a.function {
        FieldExpression(f) -> member(walk_expression(w, f.base), f.field, CalledName(a.span.site)),
        _ -> walk_expression(w, a.function),
      };
      let callee = match a.function {
        NameExpression(v) -> refers_of(called, v.name.name),
        _ -> Unbound,
      };
      a.args.fold(
        a.named.fold(called, |acc: Walk, n: NamedArg|
          walk_expression(
            member(acc, n.name, ArgumentName({ call: a.span.site, callee: callee })),
            n.value,
          )),
        walk_expression,
      )
    },
    IfExpression(i) ->
      walk_expression(walk_expression(walk_expression(w, i.cond), i.then_branch), i.else_branch),
    MatchExpression(m) ->
      m.arms.fold(walk_expression(w, m.scrutinee), |acc: Walk, arm: MatchArm| {
        let bound_arm = walk_pattern(pushed(acc), arm.pattern, false);
        let guarded = match arm.guard {
          Some(g) -> walk_expression(bound_arm, g),
          None -> bound_arm,
        };
        popped(walk_expression(guarded, arm.body))
      }),
    BlockExpression(b) -> {
      let statements = b.statements.fold(pushed(w), walk_statement);
      popped(match b.tail { Some(t) -> walk_expression(statements, t), None -> statements })
    },
    RecordExpression(r) -> walk_fields(w, r.fields, RecordAt(r.span.site)),
    RecordUpdateExpression(u) ->
      walk_fields(walk_expression(w, u.base), u.fields, RecordAt(u.span.site)),
    PropagateExpression(t) -> walk_expression(w, t.operand),
    FieldExpression(f) ->
      member(walk_expression(w, f.base), f.field, FieldName(RecordAt(f.span.site))),
    ListExpression(l) -> l.items.fold(w, walk_expression),
    PerformExpression(p) -> match if p.effect_name.module == None {
        find_local(w, p.effect_name.name.name)
      } else { None } {
      Some(Local(b)) ->
        p.args.fold(
          member(
            record_reference(w, p.effect_name.name, Local(b), false),
            p.op,
            CalledName(p.span.site),
          ),
          walk_expression,
        ),
      _ -> if receives_value(w, p.effect_name) {
        p.args.fold(
          member(value_named(w, p.effect_name, false), p.op, CalledName(p.span.site)),
          walk_expression,
        )
      } else { p.args.fold(operation(w, p.effect_name, p.op), walk_expression) },
    },
    HandleExpression(h) -> {
      let made = h.vars.fold(pushed(w), |acc: Walk, v: HandlerVar|
        bound(walk_expression(walk_optional_type(acc, v.ty), v.init), v.name));
      let clauses = h.clauses.fold(
        walk_expression(popped(made), h.body),
        |acc: Walk, c: HandleClause| walk_clause(acc, h.vars, c),
      );
      match h.ret {
        Some(r) -> popped(walk_expression(bound(in_scope(clauses, h.vars), r.binder), r.body)),
        None -> clauses,
      }
    },
    WithScopeExpression(h) -> {
      let around = walk_expression(walk_expression(w, h.acquire), h.release);
      popped(walk_expression(bound(pushed(around), h.binder), h.body))
    },
    SimulateExpression(s) -> walk_expression(w, s.body),
    ParallelExpression(p) -> p.branches.fold(w, walk_expression),
    TaggedLiteralExpression(t) ->
      t.holes.fold(qualifier(w, tagged_parser(t)), |acc: Walk, hole: Hole|
        walk_expression(acc, hole.value)),
    TryBlockExpression(t) -> {
      let raised = match t.raise { Some(r) -> operation(w, r.effect_name, r.op), None -> w };
      walk_expression(raised, t.body)
    },
    _ -> w,
  }

fn walk_fn(w: Walk, f: FnDefinition) -> Walk / {abort.raise} = {
  let params = walk_params(named_in(w, ValueSpace, bare(f.name)), f.params);
  let typed = walk_optional_effects(walk_optional_type(params, f.ret), f.effects);
  let returned = match f.returns {
    Some(ReturnsParam(p)) ->
      record_reference(typed, p, find_local(typed, p.name).unwrap_or(Unbound), false),
    _ -> typed,
  };
  let specs = f.spec.fold(returned, |acc: Walk, s: SpecClause| walk_spec(acc, f.params, s));
  let measured = match f.decreases { Some(d) -> walk_expression(specs, d), None -> specs };
  popped(walk_expression(measured, f.body))
}

fn walk_quantified(
  w: Walk,
  binders: List<Binder>,
  guard: Option<Expression>,
  body: Expression,
) -> Walk / {abort.raise} = {
  let bound_all = binders.fold(pushed(w), |acc: Walk, b: Binder|
    bound(walk_type(acc, b.ty), b.name));
  let guarded = match guard { Some(g) -> walk_expression(bound_all, g), None -> bound_all };
  popped(walk_expression(guarded, body))
}

fn walk_item(w: Walk, item: Item) -> Walk / {abort.raise} =
  match item {
    FunctionItem(f) -> walk_fn(w, f),
    ExternItem(x) -> {
      let params = walk_params(named_in(w, ValueSpace, bare(x.name)), x.params);
      let typed = walk_optional_effects(walk_type(params, x.ret), x.effects);
      popped(x.spec.fold(typed, |acc: Walk, s: SpecClause| walk_spec(acc, x.params, s)))
    },
    TypeItem(t) -> {
      let declared = named_in(w, TypeSpace, bare(t.name));
      match t.body {
        AliasBody(x) -> walk_type(declared, x),
        NominalBody(RecordTypeExpression(r)) ->
          walk_record_type(
            declared,
            r.fields,
            TypeNamed(match (w.find)(TypeSpace, bare(t.name)) {
              Some(b) -> b.qualified,
              None -> t.name.name,
            }),
          ),
        NominalBody(x) -> walk_type(declared, x),
        SumBody(variants) ->
          variants.fold(declared, |acc: Walk, v: VariantDefinition|
            v.fields.fold(named_in(acc, ValueSpace, bare(v.name)), walk_type)),
        _ -> declared,
      }
    },
    EffectItem(eff) -> {
      let qualified = effect_of(w, bare(eff.name));
      eff.operations.fold(named_in(w, EffectSpace, bare(eff.name)), |acc: Walk, op: OpDefinition| {
        let declared = record_reference(
          acc,
          op.name,
          Operation({ effect: qualified, name: op.name.name }),
          false,
        );
        let typed = walk_type(op.params.fold(declared, walk_type), op.ret);
        popped(op.param_names.fold(pushed(typed), bound))
      })
    },
    TestItem(t) -> match t.cases {
      Some(c) -> {
        let entered = case_params(c).fold(
          pushed(w),
          |acc: Walk, p: { name: Identifier, ty: TypeExpression }|
            bound(walk_type(acc, p.ty), p.name),
        );
        popped(walk_expression(walk_expression(entered, test_run(t)), test_listing(c)))
      },
      None -> walk_expression(w, t.body),
    },
    LawItem(l) -> walk_quantified(w, l.binders, l.guard, l.body),
    SchemaItem(s) -> walk_quantified(w, s.params.concat(s.binders), s.guard, s.body),
    DeriveItem(d) -> named_in(w, TypeSpace, bare(d.target)),
    InstanceItem(d) ->
      named_in(
        named_in(w, if d.kind == HostInstance { EffectSpace } else { TypeSpace }, bare(d.target)),
        ValueSpace,
        bare(d.function),
      ),
    NumericItem(d) ->
      d.operations.fold(named_in(w, TypeSpace, bare(d.target)), |acc: Walk, x: NumericOp|
        named_in(acc, ValueSpace, bare(x.by))),
    EffectSetItem(d) -> walk_effect_list(named_in(w, SetSpace, bare(d.name)), d.listed, d.includes),
  }

fn import_references(
  resolved: Resolution,
  index: Int,
  module: Module,
) -> List<Reference> / {abort.raise} = {
  let targets = resolved.imports.get(index);
  range(0, module.imports.len()).fold([], |acc: List<Reference>, k: Int|
    match ((module.imports.get(k).kind, targets.at(k))) {
      (SelectedNames(names), Some(target)) ->
        names.fold(acc, |found: List<Reference>, n: Identifier|
          found.push(reference(n, declared_in(resolved, target, n.name), false))),
      _ -> acc,
    })
}

fn declared_in(resolved: Resolution, module: Int, name: Bytes) -> Refers / {abort.raise} =
  namespaces().fold(Unbound, |r: Refers, namespace: Namespace|
    match r {
      Unbound -> match lookup_declared(resolved.declarations.get(module), namespace, name) {
        Some(d) -> Definition({ qualified: d.qualified, namespace: namespace }),
        None -> Unbound,
      },
      _ -> r,
    })

pub fn item_binders(resolved: Resolution, index: Int, item: Item) -> Map<Int, Int> / {abort.raise} =
  binders_of(walk_item(walk_of(resolved, index), item).found)

pub fn expression_binders(
  resolved: Resolution,
  index: Int,
  expression: Expression,
) -> Map<Int, Int> / {abort.raise} =
  binders_of(walk_expression(walk_of(resolved, index), expression).found)

pub fn body_binders(params: List<Identifier>, body: Expression) -> Map<Int, Int> / {abort.raise} =
  binders_of(walk_expression(params.fold(pushed(empty_walk()), bound), body).found)

pub fn item_locals(item: Item) -> Map<Int, Int> / {abort.raise} =
  binders_of(walk_item(empty_walk(), item).found)

fn binders_of(found: Map<Int, Reference>) -> Map<Int, Int> =
  found.fold(Map::new(), |binders: Map<Int, Int>, site: Int, r: Reference|
    match r.target { Local(b) -> binders.insert(site, b), _ -> binders })

pub fn written(resolved: Resolution, index: Int, module: Module) -> List<Written> / {abort.raise} =
  module.items.fold(
    [{ references: import_references(resolved, index, module), members: [] }],
    |acc: List<Written>, item: Item| {
      let w = walk_item({ ..walk_of(resolved, index), members: Some(Map::new()) }, item);
      acc.push({
        references: w.found.values(),
        members: match w.members { Some(m) -> m.values(), None -> [] },
      })
    },
  )
