import progress
import compiler.check.resolve.tables (error_unplaced)
import sources (ProjectFiles)
import compiler.load (Derives)
import compiler.cc (toolchain)
import compiler.unit (shipped)
import std.random (entropy)
import std.time (time)
import args (Flags, style_of, root_of)
import builder (builder)
import lock
import paths (ResolvedPath, here)
import program (places_of, pins_of, session)
import report (CommandOutput, indent, ok_code, count_of, rejected, reported)
import sources (Project, index_path, dependency_dir)
import std.term (Style, green)
import compiler.front.checking.groups (ProgramSummary)
import compiler.front.checking.view (Modules)
import compiler.front.pkg (LockedPackage, PackageSources, closure)
import compiler.check.resolve.tables (Diagnostic, Source)
import diagnostic (SourceText)
import std.fs (fs, Listed, Dir, File)
import std.json (Json, Array, Bool, Number, Str, object)
import std.path (join, parent, strip_root)
import std.list

fn not_vendored(path: String, reason: String) -> Diagnostic =
  error_unplaced(
    b"E0502",
    Bytes::of_string(reason),
    Bytes::of_string("`" ++ path ++ "` was not vendored"),
    [
      b"fix the problem named above and run `ply vendor` again: files already copied stay in place, so running it again is safe",
    ],
  )

fn files_under(
  dir: String,
  rel: String,
  depth: Int,
) -> List<String> / {fs.list_dir[abs], abort.raise} =
  if depth > 16 { [] } else {
    let position = if rel == "" { dir } else { join(dir, rel) };
    match fs.list_dir[abs](strip_root(position)) {
      None -> [],
      Some(listed) ->
        listed.fold([], |accumulator: List<String>, l: Listed| {
          let child = if rel == "" { l.name } else { rel ++ "/" ++ l.name };
          if l.name == ".git" { accumulator } else {
            match l.kind {
              File -> accumulator.push(child),
              Dir -> accumulator.concat(files_under(dir, child, depth + 1)),
              _ -> accumulator,
            }
          }
        }),
    }
  }

fn copy(
  from: String,
  to: String,
) -> Result<Unit, String> / {fs.create_dir[abs], fs.list_dir[abs], fs.read_file[abs], fs.write_file[abs], abort.raise} =
  if !fs.create_dir[abs](strip_root(to)) { Err("could not make `" ++ to ++ "`") }
  else { copy_all(from, to, files_under(from, "", 0)) }

fn copy_all(
  from: String,
  to: String,
  files: List<String>,
) -> Result<Unit, String> / {fs.create_dir[abs], fs.read_file[abs], fs.write_file[abs], abort.raise} =
  files.fold(Ok(()), |accumulator: Result<Unit, String>, rel: String|
    match accumulator { Err(reason) -> Err(reason), Ok(_) -> copy_one(from, to, rel) })

fn copy_one(
  from: String,
  to: String,
  rel: String,
) -> Result<Unit, String> / {fs.create_dir[abs], fs.read_file[abs], fs.write_file[abs], abort.raise} =
  match fs.read_file[abs](strip_root(join(from, rel))) {
    None -> Err("could not read `" ++ join(from, rel) ++ "`"),
    Some(text) -> if !fs.create_dir[abs](strip_root(parent(join(to, rel)))) {
      Err("could not make the directory of `" ++ join(to, rel) ++ "`")
    } else if fs.write_file[abs](strip_root(join(to, rel)), text) { Ok(()) }
    else { Err("could not write `" ++ join(to, rel) ++ "`") },
  }

pub fn index_text(rows: List<{ requirement: String, dir: String }>) -> String / {abort.raise} =
  sorted(rows).fold("", |accumulator: String, r: { requirement: String, dir: String }|
    accumulator ++ r.requirement ++ "\t" ++ r.dir ++ "\n")

fn sorted(
  rows: List<{ requirement: String, dir: String }>,
) -> List<{ requirement: String, dir: String }> / {abort.raise} =
  rows.fold(
    [],
    |accumulator: List<{ requirement: String, dir: String }>, r: { requirement: String, dir: String }| {
      let n = accumulator.len();
      let position = range(0, n).fold(n, |i: Int, j: Int|
        if i < n { i }
        else if compare(r.requirement, accumulator.get(j).requirement) == Less { j }
        else { i });
      inserted(accumulator, position, r)
    },
  )

fn inserted(
  rows: List<{ requirement: String, dir: String }>,
  position: Int,
  r: { requirement: String, dir: String },
) -> List<{ requirement: String, dir: String }> / {abort.raise} = {
  let before = range(0, position).fold(
    [],
    |accumulator: List<{ requirement: String, dir: String }>, j: Int| accumulator.push(rows.get(j)),
  );
  let after = range(position, rows.len()).fold(
    [],
    |accumulator: List<{ requirement: String, dir: String }>, j: Int| accumulator.push(rows.get(j)),
  );
  after.fold(
    before.push(r),
    |accumulator: List<{ requirement: String, dir: String }>, x: { requirement: String, dir: String }|
      accumulator.push(x),
  )
}

pub fn run(
  flags: Flags,
) -> CommandOutput / {time.elapsed_ms, shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], ProjectFiles, fs.create_dir[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.write_file[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], Derives, abort.raise, diverges, shipped.report_view_used} = {
  let s: Style = style_of(flags);
  let r = root_of(flags);
  match progress::silently(||
      session(flags.paths, flags.verify_dependencies, |_: Modules, _: ProgramSummary| ())) {
    Err(refused) -> rejected(s, "vendor", refused.diagnostics, refused.places),
    Ok(opened) -> match pins_of(opened.project) {
      Err(refused) -> rejected(s, "vendor", refused.diagnostics, refused.places),
      Ok(pinned) -> match lock_mismatch_error(
          r,
          pinned.pins,
          lock::committed_packages(pinned.packages),
        ) {
        Some(d) -> reported(s, "vendor", [d], places_of(opened)),
        None -> vendor_output(s, flags, r, opened.project, pinned.packages, places_of(opened)),
      },
    },
  }
}

fn lock_mismatch_error(
  resolved: ResolvedPath,
  pins: List<LockedPackage>,
  committed: List<String>,
) -> Option<Diagnostic> / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match lock::read(resolved) {
    Err(reason) -> Some(lock::unreadable_lock(resolved, reason)),
    Ok(None) -> None,
    Ok(Some(existing)) -> match lock::verify(
        resolved,
        existing,
        lock::from_front(pins),
        committed,
      ) {
      Ok(_) -> None,
      Err(d) -> Some(d),
    },
  }

fn vendor_output(
  style: Style,
  flags: Flags,
  resolved: ResolvedPath,
  project: Project,
  packages: PackageSources,
  places: List<SourceText>,
) -> CommandOutput / {builder.git[vcs], fs.create_dir[abs], fs.list_dir[abs], fs.read_file[abs], fs.write_file[abs], abort.raise} =
  match vendor_packages(resolved, vendor_directories(project, packages)) {
    Err(reason) -> reported(style, "vendor", [not_vendored(resolved.display, reason)], places),
    Ok(rows) ->
      {
        json: json_of(rows, resolved.display, ok_code),
        lines: if flags.json { [] } else { vendored_lines(style, resolved, rows) },
        errs: [],
        code: ok_code,
      },
  }

fn vendor_directories(
  project: Project,
  packages: PackageSources,
) -> List<{ requirement: String, dir: String }> / {abort.raise} = {
  let closed = closure(packages, project.sources.map(|s: Source| s.name)).packages;
  range(1, packages.supplied.len() + 1).fold(
    [],
    |accumulator: List<{ requirement: String, dir: String }>, i: Int| {
      let want = match packages.supplied.at(i - 1) {
        None -> "",
        Some(s) -> String::of_bytes_lossy(s.root),
      };
      accumulator.push({
        requirement: want,
        dir: join("vendor", String::of_bytes_lossy(closed.get(i).prefix)),
      })
    },
  )
}

fn vendor_packages(
  resolved: ResolvedPath,
  rows: List<{ requirement: String, dir: String }>,
) -> Result<List<{ requirement: String, dir: String }>, String> / {builder.git[vcs], fs.create_dir[abs], fs.list_dir[abs], fs.read_file[abs], fs.write_file[abs], abort.raise} =
  match copy_each(resolved, rows) {
    Err(reason) -> Err(reason),
    Ok(_) -> {
      let path = index_path(resolved.absolute);
      if !fs.create_dir[abs](strip_root(parent(path))) {
        Err("could not make `" ++ parent(path) ++ "`")
      } else if fs.write_file[abs](strip_root(path), Bytes::of_string(index_text(rows))) {
        Ok(rows)
      } else { Err("could not write `" ++ path ++ "`") }
    },
  }

fn copy_each(
  resolved: ResolvedPath,
  rows: List<{ requirement: String, dir: String }>,
) -> Result<Unit, String> / {builder.git[vcs], fs.create_dir[abs], fs.list_dir[abs], fs.read_file[abs], fs.write_file[abs], abort.raise} =
  rows.fold(
    Ok(()),
    |accumulator: Result<Unit, String>, row: { requirement: String, dir: String }|
      match accumulator {
        Err(reason) -> Err(reason),
        Ok(_) -> copy(source_dir(resolved, row.requirement), join(resolved.absolute, row.dir)),
      },
  )

fn source_dir(resolved: ResolvedPath, want: String) -> String / {builder.git[vcs]} =
  match dependency_dir(resolved.absolute, [], Bytes::of_string(want)) {
    Some(dir) -> dir,
    None -> join(resolved.absolute, join("vendor", want)),
  }

fn vendored_lines(
  style: Style,
  resolved: ResolvedPath,
  rows: List<{ requirement: String, dir: String }>,
) -> List<String> / {abort.raise} = {
  let head = [
    indent ++ green(style, "vendored") ++ " " ++ count_of(rows.len(), "package") ++ " · "
      ++ join(resolved.display, "vendor"),
  ];
  rows.fold(head, |accumulator: List<String>, row: { requirement: String, dir: String }|
    accumulator.push(indent ++ "  " ++ row.dir))
}

fn json_of(rows: List<{ requirement: String, dir: String }>, root: String, code: Int) -> Json =
  object([
    { key: "command", value: Str("vendor") },
    { key: "ok", value: Bool(code == ok_code) },
    { key: "exit_code", value: Number(Decimal::of_int(code)) },
    { key: "root", value: Str(root) },
    { key: "packages", value: Number(Decimal::of_int(rows.len())) },
    {
      key: "vendored",
      value: Array(
        rows.map(|row: { requirement: String, dir: String }|
          object([
            { key: "want", value: Str(row.requirement) },
            { key: "dir", value: Str(row.dir) },
          ])),
      ),
    },
  ])

test "a vendor index has one line per package, sorted by the package's requirement" {
  let rows = [
    { requirement: "/x/z", dir: "vendor/z" },
    { requirement: "git+https://example.com/a@deadbeef", dir: "vendor/a" },
  ];
  assert_eq(index_text(rows), "/x/z\tvendor/z\ngit+https://example.com/a@deadbeef\tvendor/a\n")
}

test "a project with no dependencies vendors nothing, and says so" { assert_eq(index_text([]), "") }
