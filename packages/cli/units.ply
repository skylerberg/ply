import compiler.load (Derives, entry_roots, every_root, LoadedAnalysis)
import compiler.expand.embed (ModuleEmbed)
import compiler.front.checking.view (NamedRollup)
import compiler.front.rows (ModuleSpan)
import entries
import machine
import module_queries
import compiler.check.resolve.tables (Diagnostic, error_at)
import compiler.cc
import compiler.cc (compilers, toolchain, WrittenPart)
import compiler.syntax.parsing (no_module, dummy_span)
import compiler.unit
import compiler.unit (Emission, LevelTally, UnitContents, WholeLowering, shipped, shipped_runtime,
                      results_store, emitted, emitter_identity, unit_parts, cache_parts,
                      code_rejections, entry_rejections, lowered_whole)
import compiler.store.records (Record, record_store, with_record_store)
import compiler.emit.keys (RootKey, Named, EntryPoint)
import compiler.front.checking (LoadInputs)
import compiler.front.checking.units (Entries, PartCode, ProgramCode, codes_of_part, decoded_code,
                                      encoded_code, part_text, program_code, root_enters,
                                      whole_lowering_pays)
import compiler.front.checking.world (decode_cache)
import compiler.store.memo (memo)
import compiler.store.memo_files
import compiler.front.facts (CheckedProgram)
import program (ProgramPlace, Session, TimedLoad, in_program_store, loaded_analysis, store_of,
                whole_front)
import std.env (env)
import sources
import std.fs (fs)
import std.process (process)
import std.random (entropy)
import std.time (time)
import std.path (strip_root)
import proof.obligation (plural)
import report (indent)

pub type WholeUnit = { sources: List<cc::Source>, contents: UnitContents }

pub type CodeProgram = {
  place: ProgramPlace,
  inputs: Map<Bytes, Bytes>,
  roots: Map<Bytes, ModuleSpan>,
}

pub type Emitted = {
  code: ProgramCode,
  held: Map<Bytes, Bytes>,
  place: ProgramPlace,
  inputs: Map<Bytes, Bytes>,
}

pub effect emit {
  read unit(front: LoadedAnalysis, offered: List<RootKey>, entered: Option<List<RootKey>>) -> Result<WholeUnit, List<Diagnostic>>
  read code(program: CodeProgram, roots: List<RootKey>) -> Result<Emitted, List<Diagnostic>>
  read compiled(sources: List<cc::Source>, profile: cc::Profile) -> Result<String, List<Diagnostic>>
  read libraries(emitted: Emitted, profile: cc::Profile) -> Result<String, List<Diagnostic>>
}

fn emitted_of(
  front: LoadedAnalysis,
  emission: Result<Emission, Bytes>,
) -> Result<WholeUnit, List<Diagnostic>> / {toolchain.read, toolchain.write, abort.raise} =
  match unit_parts(front.dump, emission) {
    Err(diagnostics) -> Err(diagnostics),
    Ok(parts) -> match cache_parts(parts) {
      Err(reason) -> Err([unbuildable(reason)]),
      Ok(sources) ->
        Ok({
          sources: sources,
          contents: match emission {
            Ok(e) -> e.produced.made,
            Err(_) -> { bodies: [], requested: [], named: Map::new() },
          },
        }),
    },
  }

pub effect set Emits = {shipped.runtime, shipped.definitions, toolchain.bodies_dir, env.variable, fs.read[abs], fs.write[abs], entropy.next, time.now_ms, time.elapsed_ms, process.err[proc], compilers.read[cc], compilers.write[cc], compilers.read[tcc], compilers.write[tcc], toolchain.read, toolchain.write, shipped.read_pack, toolchain.reuse_dir, fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.report_view_used, Derives}

fn cache_dir() -> String / {toolchain.bodies_dir, abort.raise} = strip_root(toolchain.bodies_dir())

fn texts(front: LoadedAnalysis) -> List<Bytes> =
  front.files.map(|f: { path: String, name: String, text: Bytes }| f.text)

fn report_emission(
  emission: Result<Emission, Bytes>,
  identity: Bytes,
  ms: Int,
) -> Unit / {env.variable, process.err[proc], abort.raise} =
  match emission {
    Err(_) -> (),
    Ok(e) -> if env.variable("PLY_C_PHASES") != None {
      let parts = e.produced.parts;
      process.err[proc](
        "phases: emitter " ++ String::of_bytes(identity) ++ ", " ++ e.cached.to_string()
          ++ " cached results reused, "
          ++ e.emitter_requests.to_string()
          ++ " results requested in total, "
          ++ parts.filter(|w: WrittenPart| w.text == None).len().to_string()
          ++ " of "
          ++ parts.len().to_string()
          ++ " parts taken back, "
          ++ ms.to_string()
          ++ "ms",
      )
    },
  }

fn level_line(level: LevelTally) -> Option<String> / {abort.raise} =
  if level.emitter_requests == 0 { None } else {
    Some(
      indent ++ "generated C for " ++ level.emitter_requests.to_string() ++ " "
        ++ plural(level.emitter_requests, "function")
        ++ ", level "
        ++ (level.place + 1).to_string()
        ++ " of "
        ++ level.places.to_string(),
    )
  }

fn report_level(level: LevelTally) -> Unit / {process.err[proc], abort.raise} =
  match level_line(level) { Some(line) -> process.err[proc](line), None -> () }

fn unit_of(
  front: LoadedAnalysis,
  offered: List<RootKey>,
  entered: Option<List<RootKey>>,
  reports_levels: Bool,
) -> Result<WholeUnit, List<Diagnostic>> / {shipped.runtime, shipped.definitions, toolchain.bodies_dir, env.variable, fs.read[abs], fs.write[abs], time.elapsed_ms, process.err[proc], toolchain.read, toolchain.write, abort.raise} = {
  let identity = emitter_identity(shipped.definitions());
  let runtime = shipped_runtime();
  let started = time.elapsed_ms();
  let emission = with_record_store[abs, ans](results_store(cache_dir(), runtime, identity), ||
    emitted(
      runtime,
      front.dump,
      texts(front),
      front.inputs,
      offered,
      |key: Bytes| record_store.get[ans](key),
      |rs: List<Record>| record_store.put[ans](rs),
      phases: if reports_levels { Some({ now: || time.elapsed_ms(), outcome: report_level }) }
      else { None },
      entered: entered,
      source_cached: Some(|digest: String| cc::is_source_cached(digest)),
    ));
  report_emission(emission, identity, time.elapsed_ms() - started);
  emitted_of(front, emission)
}

pub fn text_of(
  r: Result<WholeUnit, List<Diagnostic>>,
) -> Result<Bytes, List<Diagnostic>> / {toolchain.read, abort.raise} =
  match r {
    Err(diagnostics) -> Err(diagnostics),
    Ok(e) -> match unit::read_back(e.sources) {
      Err(reason) -> Err([unbuildable(reason)]),
      Ok(text) -> Ok(text),
    },
  }

pub effect set EmbeddedFiles = {fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs]}

pub fn code_program(timed: TimedLoad, view: CheckedProgram) -> CodeProgram / {abort.raise} = {
  let front = loaded_analysis(timed, view);
  { place: timed.program.place, inputs: front.inputs, roots: machine::roots_of(front.dump) }
}

pub fn code_program_of<a>(
  s: Session<a>,
  rollups: List<NamedRollup>,
) -> Result<CodeProgram, List<Diagnostic>> / {EmbeddedFiles, abort.raise} =
  match module_queries::embed_inputs(
      s.project,
      s.inputs,
      rollups.fold([], |found: List<ModuleEmbed>, r: NamedRollup| found.concat(r.rollup.embeds)),
      s.seen,
    ) {
    Err(diagnostics) -> Err(diagnostics),
    Ok(inputs) ->
      Ok({
        place: s.place,
        inputs: inputs,
        roots: entries::roots_of(entries::runnable_from_rollups(rollups)),
      }),
  }

fn entries_of(roots: List<RootKey>) -> Entries / {memo.read, abort.raise} =
  {
    roots: roots.concat(roots.filter(|k: RootKey| root_enters(k, false)).map(EntryPoint)),
    tested: false,
  }

pub fn library_of(
  emitted: Option<Emitted>,
  profile: cc::Profile,
) -> Result<Option<String>, List<Diagnostic>> / {emit.libraries} =
  match emitted {
    None -> Ok(None),
    Some(e) -> match emit.libraries(e, profile) {
      Ok(l) -> Ok(Some(l)),
      Err(diagnostics) -> Err(diagnostics),
    },
  }

pub fn emitting<a | e>(
  reports_levels: Bool,
  body: () -> a / {emit.unit, emit.code, emit.compiled, emit.libraries | e},
) -> a / {abort.raise, Emits | e} =
  handle {
    body()
  } with {
    emit.unit(front, offered, entered) -> unit_of(front, offered, entered, reports_levels),
    emit.code(program, roots) -> code_of(program, roots),
    emit.compiled(sources, profile) -> compiled_of(sources, profile),
    emit.libraries(emitted, profile) -> if by_tcc(profile) { part_libraries[tcc](emitted, profile) }
    else { part_libraries[cc](emitted, profile) },
  }

pub fn library(
  sources: List<cc::Source>,
  profile: cc::Profile,
) -> Result<String, List<Diagnostic>> / {emit.compiled} = emit.compiled(sources, profile)

pub fn library_over(
  r: Result<Emitted, List<Diagnostic>>,
  profile: cc::Profile,
) -> Result<String, List<Diagnostic>> / {emit.libraries} =
  match r { Ok(e) -> emit.libraries(e, profile), Err(diagnostics) -> Err(diagnostics) }

pub fn cached_library(
  text: Bytes,
  profile: cc::Profile,
) -> Result<String, List<Diagnostic>> / {emit.compiled, toolchain.read, toolchain.write, abort.raise} =
  match cc::cache_text(text) {
    Err(reason) -> Err([unbuildable(reason)]),
    Ok(sources) -> library(sources, profile),
  }

fn whole_lowering(
  place: ProgramPlace,
  entries: Entries,
) -> Result<WholeLowering, List<Diagnostic>> / {Emits, abort.raise} = {
  let whole = whole_front(place);
  let front = whole.front;
  let named = entries.roots.fold([], |found: List<Bytes>, k: RootKey|
    match k { Named(n) -> found.push(n), _ -> found });
  let only_named = entries.roots.all(|k: RootKey|
    match k { Named(_) -> true, EntryPoint(_) -> true, _ -> false });
  match entry_rejections(front.dump) {
    [] ->
      Ok(
        lowered_whole(
          front.dump,
          texts(front),
          if only_named { entry_roots(front, whole.hashes, named) } else { every_root(front) },
          Some(entered_of(entries)),
        ),
      ),
    rejected -> Err(rejected),
  }
}

fn entered_of(entries: Entries) -> List<RootKey> =
  entries.roots.fold([], |found: List<RootKey>, k: RootKey|
    match k { EntryPoint(e) -> found.push(e), _ -> found })

fn with_codes(
  code: ProgramCode,
  held: Bool,
) -> { code: ProgramCode, held: Map<Bytes, Bytes> } / {memo.read, abort.raise} =
  {
    code: code,
    held: if !held { Map::new() } else {
      code.parts.fold(Map::new(), |found: Map<Bytes, Bytes>, p: PartCode| {
        let codes = codes_of_part(p.part);
        range(0, codes.len()).fold(found, |m: Map<Bytes, Bytes>, i: Int|
          m.insert(p.made.codes.get(i), encoded_code(codes.get(i))))
      })
    },
  }

fn code_of(
  program: CodeProgram,
  roots: List<RootKey>,
) -> Result<Emitted, List<Diagnostic>> / {Emits, abort.raise} = {
  let held = program.place.store == None;
  let ready = in_program_store(program.place, |_: LoadInputs| {
    let entries = entries_of(roots);
    if whole_lowering_pays(entries) { { entries: entries, built: None } }
    else { { entries: entries, built: Some(with_codes(program_code(entries), held)) } }
  }).value;
  match ready.built {
    Some(found) ->
      Ok({ code: found.code, held: found.held, place: program.place, inputs: program.inputs }),
    None -> match whole_lowering(program.place, ready.entries) {
      Err(rejected) -> Err(rejected),
      Ok(whole) -> {
        let found = in_program_store(program.place, |_: LoadInputs| {
          decode_cache.cache_whole_lowering(whole);
          with_codes(program_code(ready.entries), held)
        }).value;
        Ok({ code: found.code, held: found.held, place: program.place, inputs: program.inputs })
      },
    },
  }
}

fn stored_codes(
  e: Emitted,
  digests: List<Bytes>,
) -> Map<Bytes, Bytes> / {fs.read[cwd], fs.read[abs], abort.raise} =
  match e.place.store {
    None -> e.held,
    Some(r) -> if r.label == "cwd" { memo_files::outputs_by_digest[cwd](store_of(r), digests) }
    else { memo_files::outputs_by_digest[abs](store_of(r), digests) },
  }

type KnownPart = { part: PartCode, library: Option<String> }

fn part_sources(
  e: Emitted,
  stored: Map<Bytes, Bytes>,
  p: PartCode,
) -> Result<List<cc::Source>, String> / {toolchain.read, toolchain.write, abort.raise} =
  cache_parts(
    part_text(
      p.made,
      p.made.codes.map(|digest: Bytes|
        match stored.get(digest) {
          Some(b) -> decoded_code(b),
          None -> panic("a part's code is missing from the database that listed it"),
        }),
      e.inputs,
    ),
  )

fn set_of_libraries(
  paths: List<String>,
) -> Result<String, List<Diagnostic>> / {toolchain.read, toolchain.write, abort.raise} =
  match cc::library_set(paths) { Ok(set) -> Ok(set), Err(reason) -> Err([unbuildable(reason)]) }

fn part_libraries<[c]>(
  e: Emitted,
  profile: cc::Profile,
) -> Result<String, List<Diagnostic>> / {compilers.read[c], compilers.write[c], toolchain.read, toolchain.write, shipped.runtime, fs.read[cwd], fs.read[abs], abort.raise} = {
  let known = e.code.parts.map(|p: PartCode|
    { part: p, library: cc::known_part_library[c](profile, p.made.identity) });
  let missing = known.filter(|k: KnownPart| k.library == None).map(|k: KnownPart| k.part);
  if missing.len() == 0 {
    set_of_libraries(
      known.fold([], |paths: List<String>, k: KnownPart|
        match k.library { Some(l) -> paths.push(l), None -> paths }),
    )
  } else {
    let digests = missing.fold([], |all: List<Bytes>, p: PartCode| all.concat(p.made.codes));
    let stored = stored_codes(e, digests);
    match code_rejections(shipped_runtime(), stored.values().map(decoded_code)) {
      [] -> {
        let sources = missing.fold(
          Ok([]),
          |done: Result<List<List<cc::Source>>, String>, p: PartCode|
            match done {
              Err(reason) -> Err(reason),
              Ok(sets) -> match part_sources(e, stored, p) {
                Err(reason) -> Err(reason),
                Ok(s) -> Ok(sets.push(s)),
              },
            },
        );
        match sources {
          Err(reason) -> Err([unbuildable(reason)]),
          Ok(sets) -> match cc::libraries[c](profile, sets) {
            Err(reason) -> Err([unbuildable(reason)]),
            Ok(paths) -> {
              let made = range(0, missing.len()).fold(
                Map::new(),
                |m: Map<Bytes, String>, i: Int| {
                  let identity = missing.get(i).made.identity;
                  cc::remember_part_library[c](profile, identity, paths.get(i));
                  m.insert(identity, paths.get(i))
                },
              );
              set_of_libraries(
                known.map(|k: KnownPart|
                  match k.library {
                    Some(l) -> l,
                    None -> match made.get(k.part.made.identity) { Some(l) -> l, None -> "" },
                  }),
              )
            },
          },
        }
      },
      rejected -> Err(rejected),
    }
  }
}

fn by_tcc(
  profile: cc::Profile,
) -> Bool / {compilers.find[tcc], compilers.write[tcc], toolchain.read, toolchain.write, env.variable} =
  profile.tcc && env.variable("PLY_CC") == None && compilers.find[tcc]() != None
    && cc::targets_x86_64_linux[tcc]()

fn unbuildable(reason: String) -> Diagnostic =
  error_at(b"E0450", no_module, dummy_span, Bytes::of_string(reason), b"", [
    b"the C backend shells out to `cc`; `PLY_CC` names another compiler",
  ])

fn compiled_of(
  sources: List<cc::Source>,
  profile: cc::Profile,
) -> Result<String, List<Diagnostic>> / {compilers.read[cc], compilers.write[cc], compilers.read[tcc], compilers.write[tcc], toolchain.read, toolchain.write, env.variable, abort.raise} = {
  let built = if by_tcc(profile) { cc::library[tcc](profile, sources) }
  else { cc::library[cc](profile, sources) };
  match built { Ok(path) -> Ok(path), Err(reason) -> Err([unbuildable(reason)]) }
}

test "a level with no emitter work prints nothing, and any other level prints the run's progress" {
  let level = {
    place: 2,
    places: 5,
    roots: 4,
    cached: 1,
    emitter_requests: 3,
    steps: 9,
    began: 0,
    ended: 1,
  };
  assert(level_line(level).unwrap_or("").ends_with("level 3 of 5"), None);
  assert(level_line({ ..level, emitter_requests: 0 }) == None, None)
}
