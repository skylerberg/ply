import compiler.load (every_root, LoadedAnalysis)
import compiler.check.resolve.tables (Diagnostic, error_at)
import compiler.cc
import compiler.cc (compilers, toolchain)
import compiler.syntax.parsing (no_module, dummy_span)
import compiler.unit (Emission, UnitContents, shipped, shipped_runtime, results_store, emitted,
                      emitter_identity, held)
import compiler.store.records (Record, record_store, with_record_store)
import compiler.emit.keys (RootKey)
import std.env (env)
import sources
import std.fs (fs)
import std.process (process)
import std.random (entropy)
import std.time (time)
import std.path (strip_root)

pub type Emitted = { text: Bytes, made: UnitContents }

pub effect emit {
  read unit(front: LoadedAnalysis, offered: List<RootKey>) -> Result<Emitted, List<Diagnostic>>
  read compiled(text: Bytes, profile: cc::Profile) -> Result<String, List<Diagnostic>>
}

fn emitted_of(
  front: LoadedAnalysis,
  emission: Result<Emission, Bytes>,
) -> Result<Emitted, List<Diagnostic>> / {abort.raise} =
  match held(front.dump, emission) {
    Err(diagnostics) -> Err(diagnostics),
    Ok(text) ->
      Ok({
        text: text,
        made: match emission { Ok(e) -> e.produced.made, Err(_) -> { bodies: [], offered: [] } },
      }),
  }

pub effect set Emits = {shipped.runtime, shipped.definitions, toolchain.bodies_dir, env.variable, fs.read[abs], fs.write[abs], entropy.next, time.now_ms, time.elapsed_ms, process.err[proc], compilers.read[cc], compilers.write[cc], compilers.read[tcc], compilers.write[tcc], toolchain.read, toolchain.write}

fn cache_dir() -> String / {toolchain.bodies_dir, abort.raise} = strip_root(toolchain.bodies_dir())

fn texts(front: LoadedAnalysis) -> List<Bytes> =
  front.files.map(|f: { path: String, name: String, text: Bytes }| f.text)

fn report_emission(
  emission: Result<Emission, Bytes>,
  identity: Bytes,
  ms: Int,
) -> Unit / {env.variable, process.err[proc], abort.raise} =
  match emission {
    Err(_) -> (),
    Ok(e) -> if env.variable("PLY_C_PHASES") != None {
      process.err[proc](
        "phases: emitter " ++ String::of_bytes(identity) ++ ", " ++ e.kept.to_string()
          ++ " answers read back, "
          ++ e.asked.to_string()
          ++ " asked of it, "
          ++ ms.to_string()
          ++ "ms",
      )
    },
  }

fn unit_of(
  front: LoadedAnalysis,
  offered: List<RootKey>,
) -> Result<Emitted, List<Diagnostic>> / {shipped.runtime, shipped.definitions, toolchain.bodies_dir, env.variable, fs.read[abs], fs.write[abs], entropy.next, time.now_ms, time.elapsed_ms, process.err[proc], abort.raise} = {
  let identity = emitter_identity(shipped.definitions());
  let runtime = shipped_runtime();
  let started = time.elapsed_ms();
  let emission = with_record_store[abs, ans](results_store(cache_dir(), runtime, identity), ||
    emitted(
      runtime,
      front.dump,
      texts(front),
      front.inputs,
      offered,
      |key: Bytes| record_store.get[ans](key),
      |rs: List<Record>| record_store.put[ans](rs),
    ));
  report_emission(emission, identity, time.elapsed_ms() - started);
  emitted_of(front, emission)
}

pub fn text_of(r: Result<Emitted, List<Diagnostic>>) -> Result<Bytes, List<Diagnostic>> =
  match r { Ok(e) -> Ok(e.text), Err(diagnostics) -> Err(diagnostics) }

pub fn whole_emitted(
  front: LoadedAnalysis,
) -> Result<Emitted, List<Diagnostic>> / {emit.unit, abort.raise} =
  emit.unit(front, every_root(front))

pub fn whole_text(
  front: LoadedAnalysis,
) -> Result<Bytes, List<Diagnostic>> / {emit.unit, abort.raise} = text_of(whole_emitted(front))

pub fn wanted_library(
  front: LoadedAnalysis,
  build: Bool,
  profile: cc::Profile,
) -> Result<Option<String>, List<Diagnostic>> / {emit.unit, emit.compiled, abort.raise} =
  if !build { Ok(None) } else {
    match whole_text(front) {
      Err(diagnostics) -> Err(diagnostics),
      Ok(text) -> match library(text, profile) {
        Ok(l) -> Ok(Some(l)),
        Err(diagnostics) -> Err(diagnostics),
      },
    }
  }

pub fn library_of(
  text: Option<Bytes>,
  profile: cc::Profile,
) -> Result<Option<String>, List<Diagnostic>> / {emit.compiled} =
  match text {
    None -> Ok(None),
    Some(t) -> match library(t, profile) {
      Ok(l) -> Ok(Some(l)),
      Err(diagnostics) -> Err(diagnostics),
    },
  }

pub fn emitting<a | e>(
  body: () -> a / {emit.unit, emit.compiled | e},
) -> a / {abort.raise, Emits | e} =
  handle {
    body()
  } with {
    emit.unit(front, offered) -> unit_of(front, offered),
    emit.compiled(text, profile) -> compiled_of(text, profile),
  }

pub fn library(
  text: Bytes,
  profile: cc::Profile,
) -> Result<String, List<Diagnostic>> / {emit.compiled} = emit.compiled(text, profile)

pub fn library_over(
  r: Result<Emitted, List<Diagnostic>>,
  profile: cc::Profile,
) -> Result<String, List<Diagnostic>> / {emit.compiled} =
  match r { Ok(e) -> library(e.text, profile), Err(diagnostics) -> Err(diagnostics) }

fn by_tcc(
  profile: cc::Profile,
) -> Bool / {compilers.find[tcc], compilers.write[tcc], toolchain.read, toolchain.write, env.variable, abort.raise} =
  profile.tcc && env.variable("PLY_CC") == None && compilers.find[tcc]() != None
    && cc::targets_x86_64_linux[tcc]()

fn unbuildable(why: String) -> Diagnostic =
  error_at(b"E0450", no_module(), dummy_span(), Bytes::of_string(why), b"", [
    b"the C backend shells out to `cc`; `PLY_CC` names another compiler",
  ])

fn compiled_of(
  text: Bytes,
  profile: cc::Profile,
) -> Result<String, List<Diagnostic>> / {compilers.read[cc], compilers.write[cc], compilers.read[tcc], compilers.write[tcc], toolchain.read, toolchain.write, env.variable, abort.raise} = {
  let built = if by_tcc(profile) { cc::library[tcc](profile, text) }
  else { cc::library[cc](profile, text) };
  match built { Ok(path) -> Ok(path), Err(why) -> Err([unbuildable(why)]) }
}
