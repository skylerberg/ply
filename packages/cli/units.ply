pub type CodeProgram = { place: ProgramPlace, inputs: Map<Bytes, Bytes>, roots: Map<Bytes, Place> }

pub type CodeSource =
  | HeldInMemory(Map<Bytes, Bytes>)
  | InDatabase({ place: DatabasePlace, opening: Opening })

pub type Emitted = {
  code: ProgramCode,
  source: CodeSource,
  place: ProgramPlace,
  inputs: Map<Bytes, Bytes>,
}

pub effect emit {
  read code(program: CodeProgram, roots: List<RootKey>) -> Emitted
  read compiled(owner: String, text: Bytes, profile: cc::Profile) -> Result<String, List<Diagnostic>>
  read libraries(emitted: Emitted, profile: cc::Profile) -> Result<List<String>, List<Diagnostic>>
  read codes(emitted: Emitted, digests: List<Bytes>) -> Map<Bytes, Bytes>
}

pub effect set Emits = {shipped.runtime, shipped.definitions, toolchain.bodies_dir, env.variable, fs.read[abs], fs.write[abs], entropy.next, time.now_ms, time.elapsed_ms, process.err[proc], compilers.read[cc], compilers.write[cc], compilers.read[tcc], compilers.write[tcc], toolchain.read, toolchain.write, shipped.read_pack, toolchain.reuse_dir, fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], Loads}

pub effect set EmbeddedFiles = {fs.read_file[shipped], ProjectFiles}

pub fn code_program_over(place: ProgramPlace, front: LoadedAnalysis) -> CodeProgram =
  { place: place, inputs: front.inputs, roots: machine::roots_of(front.dump) }

pub fn code_program_of<a>(
  s: Session<a>,
  rollup: ProgramRollup,
) -> Result<CodeProgram, List<Diagnostic>> / {EmbeddedFiles, abort.raise} =
  match module_queries::embed_inputs(s.project, s.inputs, rollup.embeds) {
    Err(diagnostics) -> Err(diagnostics),
    Ok(inputs) -> Ok({ place: s.place, inputs: inputs, roots: entries::roots_of(rollup.roots) }),
  }

pub fn library_of(
  emitted: Option<Emitted>,
  profile: cc::Profile,
) -> Result<Option<List<String>>, List<Diagnostic>> / {emit.libraries} =
  match emitted {
    None -> Ok(None),
    Some(e) -> match emit.libraries(e, profile) {
      Ok(l) -> Ok(Some(l)),
      Err(diagnostics) -> Err(diagnostics),
    },
  }

pub fn emitting<a | e>(
  body: () -> a / {emit.code, emit.codes, emit.compiled, emit.libraries | e},
) -> a / {abort.raise, Emits, EmbedSnapshot, Databases | e} =
  handle {
    body()
  } with {
    emit.code(program, roots) -> code_of(program, roots),
    emit.compiled(owner, text, profile) -> if by_tcc(profile) {
      library_of_text[tcc](owner, text, profile)
    } else { library_of_text[cc](owner, text, profile) },
    emit.libraries(emitted, profile) -> if by_tcc(profile) { part_libraries[tcc](emitted, profile) }
    else { part_libraries[cc](emitted, profile) },
    emit.codes(emitted, digests) -> codes_for(emitted, digests),
  }

pub fn artifact_library(
  path: String,
  text: Bytes,
  profile: cc::Profile,
) -> Result<String, List<Diagnostic>> / {emit.compiled, abort.raise} =
  emit.compiled(
    profile.name ++ "/artifacts/" ++ blake3(Bytes::of_string(path)).slice(0, 8).hex_of(),
    text,
    profile,
  )

fn library_of_text<[c]>(
  owner: String,
  text: Bytes,
  profile: cc::Profile,
) -> Result<String, List<Diagnostic>> / {compilers.read[c], compilers.write[c], toolchain.read, toolchain.write, abort.raise} =
  match cc::library[c](profile, owner, cc::split(text)) {
    Err(reason) -> Err([unbuildable(reason)]),
    Ok(path) -> Ok(path),
  }

fn with_codes(
  code: ProgramCode,
  held: Bool,
) -> { code: ProgramCode, held: Map<Bytes, Bytes> } / {memo.read, abort.raise} =
  {
    code: code,
    held: if !held { Map::new() } else {
      code.parts.fold(Map::new(), |found: Map<Bytes, Bytes>, p: PartCode| {
        let codes = codes_of_part(p.part);
        range(0, codes.len()).fold(found, |m: Map<Bytes, Bytes>, i: Int|
          m.insert(p.made.codes.get(i), encoded_code(codes.get(i))))
      })
    },
  }

fn code_of(
  program: CodeProgram,
  roots: List<RootKey>,
) -> Emitted / {Emits, EmbedSnapshot, Databases, abort.raise} = {
  let found = progress::silently(||
    in_program_store(program.place, |_: LoadInputs|
      with_codes(program_code(entries_of(roots)), program.place.store == None))).value;
  {
    code: found.code,
    source: match program.place.store {
      None -> HeldInMemory(found.held),
      Some(r) -> {
        let place = database_place(r);
        InDatabase({ place: place, opening: databases.open(place) })
      },
    },
    place: program.place,
    inputs: program.inputs,
  }
}

fn codes_for(
  e: Emitted,
  digests: List<Bytes>,
) -> Map<Bytes, Bytes> / {Emits, EmbedSnapshot, Databases, abort.raise} =
  match e.source {
    HeldInMemory(held) -> held,
    InDatabase(stored) -> {
      let outputs = match stored.place {
        InWorkingDirectory(_) ->
          database::outputs_by_digest[cwd](stored.opening, pack_frame, digests),
        AtAbsolutePath(_) -> database::outputs_by_digest[abs](stored.opening, pack_frame, digests),
      };
      let stored_codes = outputs.fold(
        Map::new(),
        |found: Map<Bytes, Bytes>, digest: Bytes, o: database::StoredOutput|
          match o { Stored(code) -> found.insert(digest, code), NotKept -> found },
      );
      if stored_codes.len() == digests.len() { stored_codes } else {
        let missing = Set::of_list(digests.filter(|d: Bytes| !stored_codes.contains(d)));
        let parts = e.code.parts.filter(|p: PartCode|
          p.made.codes.any(|d: Bytes| missing.contains(d)));
        progress::silently(||
          in_program_store(e.place, |_: LoadInputs|
            with_codes({ ..e.code, parts: parts }, true))).value.held.fold(
          stored_codes,
          |found: Map<Bytes, Bytes>, digest: Bytes, code: Bytes| found.insert(digest, code),
        )
      }
    },
  }

pub type WholeProgram = { code: CodeProgram, constructors: List<Bytes>, modules: Int }

pub fn whole_program(code: CodeProgram, listing: ProgramListing) -> WholeProgram =
  {
    code: code,
    constructors: listing.checked.constructors.fold(
      Map::new(),
      |found: Map<Bytes, Bytes>, c: ConstructorInfo|
        found.insert(Bytes::concat_all([c.type_name, b"\x00", u32_be(c.index)]), c.name),
    ).values(
    ),
    modules: listing.outlines.len(),
  }

pub fn whole_text(
  program: WholeProgram,
  roots: List<RootKey>,
) -> Result<Bytes, List<Diagnostic>> / {emit.code, emit.codes, emit.codes, shipped.runtime, abort.raise} = {
  let e = emit.code(program.code, roots);
  let digests = reached_digests(e.code);
  let stored = emit.codes(e, digests);
  let codes = reached_only(
    e.code,
    digests.map(|digest: Bytes|
      match stored.get(digest) {
        Some(b) -> decoded_code(b),
        None -> panic("a part's code is missing from the database that listed it"),
      }),
  );
  match code_failures(e.code).concat(code_rejections(shipped_runtime(), codes)) {
    [] -> Ok(whole_program_text(codes, program.constructors, program.modules, e.inputs)),
    rejected -> Err(rejected),
  }
}

fn shipped_part(p: PartMembers) -> Bool =
  p.units.fold(true, |all: Bool, u: CodeUnit|
    all && (match u { OfGroup(g) -> g.shipped && !g.tested, _ -> false }))

fn part_owner(profile: cc::Profile, p: PartMembers) -> String / {abort.raise} =
  profile.name ++ "/" ++ String::of_bytes_lossy(p.module) ++ "/"
    ++ blake3(p.label).slice(0, 8).hex_of()

fn codes_of(e: Emitted, stored: Map<Bytes, Bytes>, p: PartCode) -> List<UnitCode> / {abort.raise} =
  p.made.codes.map(|digest: Bytes|
    match stored.get(digest) {
      Some(b) -> decoded_code(b),
      None -> panic("a part's code is missing from the database that listed it"),
    })

fn libraries_of_parts<[c]>(
  e: Emitted,
  profile: cc::Profile,
  parts: List<PartCode>,
) -> Result<List<String>, List<Diagnostic>> / {compilers.read[c], compilers.write[c], Emits, EmbedSnapshot, Databases, abort.raise} = {
  let wanted = parts.map(|p: PartCode|
    { owner: part_owner(profile, p.part), key: p.made.identity });
  match cc::found_libraries[c](profile, wanted) {
    Err(reason) -> Err([unbuildable(reason)]),
    Ok(found) -> {
      let paths = found.map(|k: cc::FoundLibrary| k.path);
      let missing = range(0, parts.len()).filter(|i: Int| !found.get(i).built);
      if missing.len() == 0 { Ok(paths) } else {
        let stored = codes_for(
          e,
          missing.fold([], |all: List<Bytes>, i: Int| all.concat(parts.get(i).made.codes)),
        );
        match code_failures(e.code).concat(
            code_rejections(shipped_runtime(), stored.values().map(decoded_code)),
          ) {
          [] -> match cc::built_libraries[c](
              profile,
              missing.map(|i: Int|
                {
                  wanted: wanted.get(i),
                  c: generated_c(
                    part_text(parts.get(i).made, codes_of(e, stored, parts.get(i)), e.inputs),
                  ),
                }),
            ) {
            Err(reason) -> Err([unbuildable(reason)]),
            Ok(_) -> Ok(paths),
          },
          rejected -> Err(rejected),
        }
      }
    },
  }
}

fn part_libraries<[c]>(
  e: Emitted,
  profile: cc::Profile,
) -> Result<List<String>, List<Diagnostic>> / {compilers.read[c], compilers.write[c], Emits, EmbedSnapshot, Databases, abort.raise} = {
  let shipped_parts = e.code.parts.filter(|p: PartCode| shipped_part(p.part));
  let own_parts = e.code.parts.filter(|p: PartCode| !shipped_part(p.part));
  let own = || libraries_of_parts[c](e, profile, own_parts);
  let built = match libraries_of_parts[c](e, profile, shipped_parts) {
    Err(diagnostics) -> Err(diagnostics),
    Ok(shipped) -> match match e.place.store {
        None -> own(),
        Some(r) -> {
          let dir = paths::in_root(r, ".ply-cache/c").path;
          match r.label {
            paths::WorkingDirectory -> cc::products_in[cwd](dir, own),
            paths::Absolute -> cc::products_in[abs](dir, own),
          }
        },
      } {
      Err(diagnostics) -> Err(diagnostics),
      Ok(project) -> Ok({ shipped: shipped, project: project }),
    },
  };
  match built { Err(diagnostics) -> Err(diagnostics), Ok(b) -> Ok(b.shipped.concat(b.project)) }
}

fn by_tcc(
  profile: cc::Profile,
) -> Bool / {compilers.find[tcc], compilers.write[tcc], toolchain.read, toolchain.write, env.variable} =
  profile.tcc && env.variable("PLY_CC") == None && compilers.find[tcc]() != None
    && cc::targets_x86_64_linux[tcc]()

fn unbuildable(reason: String) -> Diagnostic =
  error_unplaced(b"E0450", Bytes::of_string(reason), b"", [
    b"the C backend shells out to `cc`; `PLY_CC` names another compiler",
  ])
