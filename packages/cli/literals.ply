//! What a load enters before anything runs: its tagged literals' parsers and its statements.
//! `tag"text"` is the call `tag::evaluation("text")`, and one with holes the call of `tag::compile` on
//! the texts around them, and a load that checked has not yet run either: here each one the run's
//! own modules hold is entered on a machine of its own, stopped by the clock past
//! `entered_timeout_ms`, and what its parser answers is the literal's verdict. A verdict is a
//! function of the parser and the texts, so it is kept under the hash of all the parser reaches and
//! the texts, in the toolchain's cache; one the clock stopped is not, and is never kept. A
//! statement a call runs is computed the same way and judged by `statements`.

import compiler.syntax.exprs (TaggedPart)
import compiler.front.facts (CheckedProgram, Frame, TaggedSite)
import compiler.front.seam (TestRunScope)
import compiler.store.hash.forms (FunctionNamed, reach)
import compiler.store.hash.encoding (hex)
import compiler.front.interface (length_prefixed)
import compiler.syntax.lexer (utf8_len)
import compiler.load (every_root, LoadedAnalysis)
import compiler.emit.keys (RootKey, Named)
import compiler.syntax.parsing (Span, span_between)
import compiler.check.resolve.tables (Diag, error_at)
import compiler.unit (shipped, shipped_runtime, compiler_roots, entered_timeout_ms, identity_of)
import compiler.store.records (Record, record_store, with_record_store)
import diagnostic (SourceText, diag_of, shown)
import compiler.cc
import compiler.cc (toolchain)
import machine
import machine (CallResult)
import std.machine as entering
import program (TimedLoad, loaded_analysis, program_view, runs_statements)
import sources
import statements
import statements (CheckSite, CheckResult, Unchecked, check_sites, check_statements,
                   check_result_key, check_result_bin, misfits, schemas_refused)
import std.bin
import std.fs (fs)
import std.hash (blake3)
import std.list
import std.random (entropy)
import std.time (time)
import std.value (Value, VCtor, VInt, VList, VRecord, VStr, render, field_named)
import units
import units (emit)
import std.path (strip_root)

/// What a parser said of its texts. `Rejected` is its own `Err`: which text, where in it in
/// characters, and why. `Raised` is a parser that raised instead of answering, and `Abandoned` one
/// the clock stopped (`W0612`).
pub type Verdict =
  | Accepted
  | Rejected({ part: Int, offset: Int, message: String })
  | Raised(String)
  | Abandoned

derive bin for Verdict

/// A parser, by its program-wide name and the hash of all it reaches, and what to hand it: one
/// text as it is, or the several around a literal's holes as a list.
pub type EvaluationRequest = { callee: Bytes, hash: Bytes, parts: List<Bytes> }

/// What a command asks of its tagged literals' parsers and its statements.
/// What answers is `with_evaluation_cache`, which `main` runs every command under, or a handler of the asker's
/// own. A verdict is a function of what is asked, so the effect is a deterministic one, whatever
/// the answering keeps.
pub effect evaluation {
  /// In `asked`'s order; or what kept the definitions from being entered at all.
  read verdicts(timed: TimedLoad, frame: Frame, asked: List<EvaluationRequest>) -> Result<List<Verdict>, List<Diag>>
  /// Each statement of `asked` judged against the schema it is held to, in `asked`'s order; or what
  /// kept the definitions from being entered at all.
  read statements(timed: TimedLoad, frame: Frame, asked: List<statements::StatementCheck>) -> Result<List<CheckResult>, List<Diag>>
}

// --- Asking -----------------------------------------------------------------------

fn request_of(site: TaggedSite) -> EvaluationRequest =
  { callee: site.callee, hash: site.hash, parts: site.parts.map(|part: TaggedPart| part.text) }

fn distinct_requests(sites: List<TaggedSite>) -> List<EvaluationRequest> =
  sites.fold([], |acc: List<EvaluationRequest>, site: TaggedSite|
    if acc.contains(request_of(site)) { acc } else { acc.push(request_of(site)) })

fn verdict_for(
  asked: List<EvaluationRequest>,
  verdicts: List<Verdict>,
  site: TaggedSite,
) -> Option<Verdict> =
  range(0, asked.len()).fold(None, |found: Option<Verdict>, i: Int|
    match found {
      Some(_) -> found,
      None -> if asked.at(i) == Some(request_of(site)) { verdicts.at(i) } else { None },
    })

/// How many bytes of `src` spell the character at `i`: an escape is one character, and so is a
/// brace, which a tagged literal's text writes twice.
fn source_width(src: Bytes, i: Int, end: Int) -> Int / {abort.raise} =
  if i + 1 >= end { utf8_len(src.at(i)) }
  else if src.at(i) == 123 || src.at(i) == 125 { 2 }
  else if src.at(i) != 92 { utf8_len(src.at(i)) }
  else if src.at(i + 1) != 117 { 2 } else {
    iterate(i + 2, end - i, |j: Int|
      if j >= end { Stop(end - i) }
      else if src.at(j) == 125 { Stop(j + 1 - i) }
      else { Continue(j + 1) })
  }

/// Where character `offset` of a text of a tagged literal is written: `quoted` is the text with
/// what opens and closes it, a quote or the brace of a hole, and the character past the last is
/// what closes it. Nowhere for an offset the text does not have.
pub fn source_span_at(src: Bytes, quoted: Span, offset: Int) -> Option<Span> / {abort.raise} = {
  let end = quoted.end - 1;
  if offset < 0 || quoted.start + 1 > end || quoted.end > src.len() { None } else {
    iterate(
      { i: quoted.start + 1, left: offset },
      end - quoted.start + 1,
      |s: { i: Int, left: Int }|
        if s.i >= end { Stop(if s.left == 0 { Some(span_between(end, end + 1)) } else { None }) }
        else {
          let width = source_width(src, s.i, end);
          if s.left == 0 { Stop(Some(span_between(s.i, s.i + width))) }
          else { Continue({ i: s.i + width, left: s.left - 1 }) }
        },
    )
  }
}

fn has_holes(site: TaggedSite) -> Bool = site.parts.len() > 1

fn parser_name(site: TaggedSite) -> Bytes =
  Bytes::concat_all([b"`", site.tag, if has_holes(site) { b"::compile`" } else { b"::literal`" }])

fn call_note(site: TaggedSite) -> Bytes =
  if has_holes(site) {
    Bytes::concat_all([
      b"the check ran `",
      site.callee,
      b"` on the texts around the holes, as every `",
      site.tag,
      b"\"..{h}..\"` here is `",
      site.tag,
      b"::fill` called on what `",
      site.tag,
      b"::compile([\"..\", \"..\"])` answers and on its holes",
    ])
  } else {
    Bytes::concat_all([
      b"the check ran `",
      site.callee,
      b"` on the text, as every `",
      site.tag,
      b"\"..\"` here is the call `",
      site.tag,
      b"::literal(\"..\")`",
    ])
  }

/// The literal's string, quotes included.
fn string_span(site: TaggedSite) -> Span =
  match ((site.parts.at(0), site.parts.at(site.parts.len() - 1))) {
    (Some(first), Some(last)) -> span_between(first.quoted.start, last.quoted.end),
    _ -> site.span,
  }

/// Where a parser's refusal lands: the character it names in the text it names, the whole hole
/// for the offset just past a text a hole follows, and the whole string for a place it has not.
fn rejection_span(src: Bytes, site: TaggedSite, part: Int, offset: Int) -> Span / {abort.raise} =
  match site.parts.at(part) {
    None -> string_span(site),
    Some(text) -> match source_span_at(src, text.quoted, offset) {
      None -> string_span(site),
      Some(span) -> match site.parts.at(part + 1) {
        Some(next) -> if span.start != text.quoted.end - 1 { span }
        else { span_between(span.start, next.quoted.start + 1) },
        None -> span,
      },
    },
  }

fn literal_error(
  places: List<SourceText>,
  site: TaggedSite,
  verdict: Verdict,
) -> Option<Diag> / {abort.raise} =
  match verdict {
    Accepted -> None,
    Rejected(why) -> {
      let src = match places.at(site.module) { Some(place) -> place.text, None -> b"" };
      Some(
        error_at(
          b"E0153",
          site.module,
          rejection_span(src, site, why.part, why.offset),
          parser_name(site).concat(b" refuses this literal"),
          Bytes::of_string(why.message),
          [call_note(site)],
        ),
      )
    },
    Raised(message) ->
      Some(
        error_at(
          b"E0154",
          site.module,
          site.span,
          Bytes::concat_all([
            parser_name(site),
            b" raised on this literal: ",
            Bytes::of_string(message),
          ]),
          b"its parser gave no answer",
          [call_note(site), b"a parser answers `Err` of a text it refuses, saying where and why"],
        ),
      ),
    Abandoned ->
      Some(
        error_at(
          b"E0154",
          site.module,
          site.span,
          Bytes::concat_all([parser_name(site), b" did not finish this literal in time"]),
          b"its parser gave no answer",
          [call_note(site), time_given(b"a check gives each literal's parser")],
        ),
      ),
  }

/// The note that `whose` gives what it enters `entered_timeout_ms` of wall clock.
fn time_given(whose: Bytes) -> Bytes =
  Bytes::concat_all([
    whose,
    b" ",
    Bytes::of_string(entered_timeout_ms().to_string()),
    b" ms of wall clock, and stops it there",
  ])

/// What refuses a load before anything of it runs: each tagged literal of the run's own modules its
/// parser does not accept, at the place in its text the parser names, and what the check finds
/// wrong with each statement the run's own modules run. Nothing at all, and nothing asked, where
/// the program writes neither.
pub fn evaluation_errors(
  timed: TimedLoad,
  frame: Frame,
) -> List<Diag> / {evaluation.verdicts, evaluation.statements, abort.raise} =
  literal_errors(timed, frame).concat(statement_errors(timed, frame))

/// Only a program one of whose own modules runs a statement asks after any.
fn statement_errors(
  timed: TimedLoad,
  frame: Frame,
) -> List<Diag> / {evaluation.statements, abort.raise} =
  if !runs_statements(timed.program, frame) { [] } else {
    let asks = check_sites(frame).filter(|a: CheckSite| a.site.module < timed.program.files.len());
    let refused = schemas_refused(asks);
    if asks.len() == 0 { refused } else {
      match evaluation.statements(timed, frame, asks.map(|a: CheckSite| a.asked)) {
        Err(diags) -> refused.concat(diags),
        Ok(judgements) ->
          range(0, asks.len()).fold(refused, |acc: List<Diag>, i: Int|
            match judgements.at(i) { Some(j) -> acc.concat(misfits(asks.get(i), j)), None -> acc }),
      }
    }
  }

fn literal_errors(
  timed: TimedLoad,
  frame: Frame,
) -> List<Diag> / {evaluation.verdicts, abort.raise} = {
  let sites = frame.tagged.filter(|site: TaggedSite| site.module < timed.program.files.len());
  if sites.len() == 0 { [] } else {
    let parsers = distinct_requests(sites);
    match evaluation.verdicts(timed, frame, parsers) {
      Err(diags) -> diags,
      Ok(verdicts) ->
        sites.fold([], |acc: List<Diag>, site: TaggedSite|
          match verdict_for(parsers, verdicts, site) {
            None -> acc,
            Some(verdict) -> match literal_error(timed.program.places, site, verdict) {
              Some(diag) -> acc.push(diag),
              None -> acc,
            },
          }),
    }
  }
}

// --- Answering --------------------------------------------------------------------

fn verdict_of(called: CallResult) -> Verdict / {abort.raise} =
  match called.result {
    Err(raised) -> {
      let diag = shown(raised);
      if machine::is_abandoned(diag.code) { Abandoned }
      else { Raised(String::of_bytes_lossy(diag.message)) }
    },
    Ok(value) -> match value {
      VCtor(name, args) -> if name == "Ok" { Accepted } else {
        match args.at(0) {
          Some(VRecord(fields)) -> match ((
              field_named(fields, "offset"),
              field_named(fields, "message"),
            )) {
            (Some(VInt(offset)), Some(VStr(message))) ->
              Rejected({
                part: match field_named(fields, "part") { Some(VInt(part)) -> part, _ -> 0 },
                offset: offset,
                message: message,
              }),
            _ -> Raised("it answered " ++ render(value)),
          },
          _ -> Raised("it answered " ++ render(value)),
        }
      },
      _ -> Raised("it answered " ++ render(value)),
    },
  }

fn argument_of(a: EvaluationRequest) -> Value = {
  let texts = a.parts.map(|text: Bytes| VStr(String::of_bytes_lossy(text)));
  match texts { [text] -> text, _ -> VList(texts) }
}

/// What entering the definitions `names` enters of the program: all they reach.
fn entering(frame: Frame, names: List<Bytes>) -> TestRunScope / {abort.raise} =
  { owners: reach(frame.hashes, names.map(|n: Bytes| FunctionNamed(n))).fns, tests: Map::new() }

fn callees(asked: List<EvaluationRequest>) -> List<Bytes> =
  asked.fold([], |acc: List<Bytes>, a: EvaluationRequest|
    if acc.contains(a.callee) { acc } else { acc.push(a.callee) })

/// `asked` entered on a unit of the parsers they name and all those reach, each handed its texts
/// as a check enters one (`machine::evaluation_run`).
fn evaluate(
  front: LoadedAnalysis,
  frame: Frame,
  asked: List<EvaluationRequest>,
) -> Result<List<Verdict>, List<Diag>> / {emit.unit, emit.compiled, entering::machine.open, entering::machine.enter, entering::machine.close, abort.raise} =
  if asked.len() == 0 { Ok([]) } else {
    let names = callees(asked);
    let reached = reach(frame.hashes, names.map(|n: Bytes| FunctionNamed(n))).fns;
    let offered = every_root(front).filter(|k: RootKey|
      match k { Named(d) -> reached.contains(d), _ -> false });
    match units::library_over(emit.unit(front, offered), cc::development()) {
      Err(diags) -> Err(diags),
      Ok(library) -> match entering::machine.open(library) {
        Err(why) -> Err([machine::unit_load_error(why)]),
        Ok(opened) -> {
          let roots = machine::roots_of(front.dump);
          let call = |name: Bytes, args: List<Value>|
            machine::machine_call(
              opened.unit,
              roots,
              String::of_bytes_lossy(name),
              args,
              machine::evaluation_run(),
            );
          let answered = asked.map(|a: EvaluationRequest|
            verdict_of(call(a.callee, [argument_of(a)])));
          entering::machine.close(opened.unit);
          Ok(answered)
        },
      },
    }
  }

/// What a verdict is a function of: the toolchain that entered the definition, the definition by
/// the hash of all it reaches, and the texts.
fn verdict_key(toolchain: Bytes, a: EvaluationRequest) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all([
        length_prefixed(b"ply literal verdict 3"),
        length_prefixed(hex(bin::shape_digest(verdict_bin()))),
        length_prefixed(toolchain),
        length_prefixed(a.hash),
        length_prefixed(Bytes::of_string(a.parts.len().to_string())),
        Bytes::concat_all(a.parts.map(length_prefixed)),
      ]),
    ),
  )

/// What a verdict or a judgement is a function of on the toolchain's side: the runtime, the binary,
/// what the program's hashes mean, and the code that analyses, emits and judges, by the hash of all
/// it reaches. No shipped module is part of it: what a definition reaches of one is in its hash.
fn toolchain_key(definitions: Bytes, runtime: Bytes, version: String) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all([
        length_prefixed(b"ply literal toolchain 1"),
        length_prefixed(runtime),
        length_prefixed(Bytes::of_string(version)),
        length_prefixed(identity_of(definitions, toolchain_roots())),
      ]),
    ),
  )

/// The definitions a verdict or a judgement is a function of besides what it is asked over.
fn toolchain_roots() -> List<Bytes> = compiler_roots().push(b"literals.with_evaluation_cache")

/// A verdict asked after, the key it is kept under, and the verdict kept there.
type KeyedRequest = { asked: EvaluationRequest, key: Bytes, kept: Option<Verdict> }

/// `body` with every verdict it asks for read from the toolchain's cache, and the parsers of the
/// rest entered once, on one machine, and their verdicts kept there.
pub fn with_evaluation_cache<a | e>(
  body: () -> a / {evaluation.verdicts, evaluation.statements | e},
) -> a / {emit.unit, emit.compiled, entering::machine.open, entering::machine.enter, entering::machine.close, shipped.runtime, shipped.definitions, toolchain.bodies_dir, shipped.version, fs.read[abs], fs.write[abs], abort.raise | e} =
  handle {
    body()
  } with {
    // A command that settles nothing reads neither the toolchain nor its cache.
    evaluation.statements(timed, frame, asked) -> {
      let bodies = strip_root(toolchain.bodies_dir());
      let toolchain = toolchain_key(
        shipped.definitions(),
        shipped_runtime().identity,
        shipped.version(),
      );
      with_record_store[abs, lit](literals_store(bodies, toolchain), ||
        judgements(toolchain, timed, frame, asked))
    },
    evaluation.verdicts(timed, frame, asked) -> {
      let bodies = strip_root(toolchain.bodies_dir());
      let toolchain = toolchain_key(
        shipped.definitions(),
        shipped_runtime().identity,
        shipped.version(),
      );
      with_record_store[abs, lit](literals_store(bodies, toolchain), || {
        let sought = asked.map(|a: EvaluationRequest| {
          let key = verdict_key(toolchain, a);
          {
            asked: a,
            key: key,
            kept: match record_store.get[lit](key) {
              None -> None,
              Some(bytes) -> match bin::decode(bytes, verdict_bin()) {
                Ok(v) -> Some(v),
                Err(_) -> None,
              },
            },
          }
        });
        let open = sought.filter(|s: KeyedRequest| s.kept == None);
        if open.len() == 0 { Ok(merge_verdicts(sought, [])) } else {
          // What is entered is the only verdict that reads the check's tables.
          match program_view(timed.program) {
            None -> Err(timed.program.diags),
            Some(view) -> evaluate_and_cache(timed, view, sought, open),
          }
        }
      })
    },
  }

/// The store of verdicts and judgements a toolchain judging as `toolchain` keeps under `bodies`.
fn literals_store(bodies: String, toolchain: Bytes) -> String / {abort.raise} =
  bodies ++ "/literals-" ++ blake3(toolchain).slice(0, 8).hex_of()

/// The verdicts `sought` holds, `open` among them entered on a machine loaded over `view`, and each
/// `cacheable` one they answered kept in the store of verdicts.
fn evaluate_and_cache(
  timed: TimedLoad,
  view: CheckedProgram,
  sought: List<KeyedRequest>,
  open: List<KeyedRequest>,
) -> Result<List<Verdict>, List<Diag>> / {emit.unit, emit.compiled, entering::machine.open, entering::machine.enter, entering::machine.close, record_store.put[lit], abort.raise} = {
  let asked = open.map(|s: KeyedRequest| s.asked);
  let front = loaded_analysis(timed, view, Some(entering(view.frame, callees(asked))));
  match evaluate(front, view.frame, asked) {
    Err(diags) -> Err(diags),
    Ok(found) -> {
      record_store.put[lit](
        range(0, open.len()).fold([], |acc: List<Record>, i: Int|
          match found.at(i) {
            Some(v) -> if cacheable(v) {
              acc.push({ key: open.get(i).key, bytes: bin::encode(v, verdict_bin()) })
            } else { acc },
            None -> acc,
          }),
      );
      Ok(merge_verdicts(sought, found))
    },
  }
}

/// Whether a verdict is a function of the parser and its texts alone, which the cache may keep:
/// the clock is this machine's.
fn cacheable(v: Verdict) -> Bool = match v { Abandoned -> false, _ -> true }

/// A statement asked after, the key its judgement is kept under, and the judgement kept there.
type KeyedStatement = { asked: statements::StatementCheck, key: Bytes, kept: Option<CheckResult> }

/// Each statement's judgement: the one kept for it, or the one the statements not kept were judged
/// to, in their order. One the clock stopped is `Unchecked`, and is not kept.
fn judgements(
  toolchain: Bytes,
  timed: TimedLoad,
  frame: Frame,
  asked: List<statements::StatementCheck>,
) -> Result<List<CheckResult>, List<Diag>> / {emit.unit, emit.compiled, entering::machine.open, entering::machine.enter, entering::machine.close, record_store.get[lit], record_store.put[lit], abort.raise} = {
  let keyed = asked.map(|a: statements::StatementCheck| {
    let key = check_result_key(toolchain, a);
    {
      asked: a,
      key: key,
      kept: match record_store.get[lit](key) {
        None -> None,
        Some(bytes) -> match bin::decode(bytes, check_result_bin()) {
          Ok(j) -> Some(j),
          Err(_) -> None,
        },
      },
    }
  });
  let open = keyed.filter(|k: KeyedStatement| k.kept == None);
  if open.len() == 0 {
    Ok(keyed.map(|k: KeyedStatement| match k.kept { Some(j) -> j, None -> Unchecked }))
  } else {
    match match program_view(timed.program) {
        None -> Err(timed.program.diags),
        Some(view) ->
          check_statements(
            |within: TestRunScope| loaded_analysis(timed, view, Some(within)),
            frame,
            open.map(|k: KeyedStatement| k.asked),
          ),
      } {
      Err(diags) -> Err(diags),
      Ok(found) -> {
        record_store.put[lit](
          range(0, open.len()).fold([], |acc: List<Record>, i: Int|
            match found.at(i) {
              Some(Some(j)) ->
                acc.push({ key: open.get(i).key, bytes: bin::encode(j, check_result_bin()) }),
              _ -> acc,
            }),
        );
        Ok(
          keyed.fold(
            { out: [], next: 0 },
            |acc: { out: List<CheckResult>, next: Int }, k: KeyedStatement|
              match k.kept {
                Some(j) -> { out: acc.out.push(j), next: acc.next },
                None ->
                  {
                    out: acc.out.push(match found.at(acc.next) {
                      Some(Some(j)) -> j,
                      _ -> Unchecked,
                    }),
                    next: acc.next + 1,
                  },
              },
          ).out,
        )
      },
    }
  }
}

/// Each verdict sought, in order: the one kept, or the next of `found`, which holds the rest's.
fn merge_verdicts(sought: List<KeyedRequest>, found: List<Verdict>) -> List<Verdict> =
  sought.fold({ out: [], next: 0 }, |acc: { out: List<Verdict>, next: Int }, s: KeyedRequest|
    match s.kept {
      Some(v) -> { out: acc.out.push(v), next: acc.next },
      None ->
        {
          out: match found.at(acc.next) { Some(v) -> acc.out.push(v), None -> acc.out },
          next: acc.next + 1,
        },
    }).out

// --- Tests ------------------------------------------------------------------

fn a_site(text: Bytes) -> TaggedSite =
  {
    module: 0,
    span: span_between(0, 5 + text.len()),
    tag: b"hex",
    parts: [{ text: text, quoted: span_between(3, 5 + text.len()) }],
    callee: b"hex.literal",
    hash: b"h",
  }

test "a character of a literal's text is placed where its source spells it" {
  let src = b"hex\"a\\n\\u{e9}\xc3\xa9z\"";
  let quoted = span_between(3, src.len());
  assert_eq(source_span_at(src, quoted, 0), Some(span_between(4, 5)));
  assert_eq(source_span_at(src, quoted, 1), Some(span_between(5, 7)));
  assert_eq(source_span_at(src, quoted, 2), Some(span_between(7, 13)));
  assert_eq(source_span_at(src, quoted, 3), Some(span_between(13, 15)));
  assert_eq(source_span_at(src, quoted, 4), Some(span_between(15, 16)));
  // One past the text is its closing quote, where a text that ends too soon is refused.
  assert_eq(source_span_at(src, quoted, 5), Some(span_between(16, 17)));
  assert_eq(source_span_at(src, quoted, 6), None);
  assert_eq(source_span_at(src, quoted, 0 - 1), None);
  // A brace of the text is written twice, and is one character of it.
  let braced = b"hex\"a{{}}z\"";
  let all = span_between(3, braced.len());
  assert_eq(source_span_at(braced, all, 1), Some(span_between(5, 7)));
  assert_eq(source_span_at(braced, all, 2), Some(span_between(7, 9)));
  assert_eq(source_span_at(braced, all, 3), Some(span_between(9, 10)))
}

test "a parser's answer is read as its verdict, and the clock stopping it is told from a raise" {
  let answered = |v: Value| verdict_of({ result: Ok(v), warnings: [] });
  let failed = |code: String|
    verdict_of({
      result: Err({ diag: diag_of("error", code, "m", [], []), values: [] }),
      warnings: [],
    });
  assert_eq(failed("W0612"), Abandoned);
  assert_eq(failed("E0502"), Raised("m"));
  assert_eq(answered(VCtor("Ok", [VInt(1)])), Accepted);
  assert_eq(
    answered(
      VCtor("Err", [
        VRecord([{ name: "message", value: VStr("odd") }, { name: "offset", value: VInt(2) }]),
      ]),
    ),
    Rejected({ part: 0, offset: 2, message: "odd" }),
  );
  assert_eq(
    answered(
      VCtor("Err", [
        VRecord([
          { name: "message", value: VStr("odd") },
          { name: "offset", value: VInt(2) },
          { name: "part", value: VInt(1) },
        ]),
      ]),
    ),
    Rejected({ part: 1, offset: 2, message: "odd" }),
  );
  assert_eq(answered(VInt(1)), Raised("it answered 1"))
}

test "a refused literal is placed inside its text, and one past it at the whole literal" {
  let site = a_site(b"abz");
  let places = [{ path: "main.ply", text: b"hex\"abz\"" }];
  let labelled = |verdict: Verdict|
    match literal_error(places, site, verdict) {
      Some(d) -> match d.labels.at(0) {
        Some(l) -> Some({ code: d.code, start: l.start, end: l.end }),
        None -> None,
      },
      None -> None,
    };
  assert_eq(labelled(Accepted), None);
  assert_eq(
    labelled(Rejected({ part: 0, offset: 2, message: "not a hex digit" })),
    Some({ code: b"E0153", start: 6, end: 7 }),
  );
  assert_eq(
    labelled(Rejected({ part: 0, offset: 40, message: "too short" })),
    Some({ code: b"E0153", start: 3, end: 8 }),
  );
  assert_eq(labelled(Abandoned), Some({ code: b"E0154", start: 0, end: 8 }));
  assert_eq(labelled(Raised("boom")), Some({ code: b"E0154", start: 0, end: 8 }))
}

test "a refusal of a literal with holes is placed in the text it names, or on the hole after it" {
  let src = b"sh\"ab {x} cd{y}\"";
  let site = {
    module: 0,
    span: span_between(0, src.len()),
    tag: b"sh",
    parts: [
      { text: b"ab ", quoted: span_between(2, 7) },
      { text: b" cd", quoted: span_between(8, 13) },
      { text: b"", quoted: span_between(14, 16) },
    ],
    callee: b"sh.compile",
    hash: b"h",
  };
  assert_eq(rejection_span(src, site, 0, 1), span_between(4, 5));
  assert_eq(rejection_span(src, site, 1, 2), span_between(11, 12));
  // Just past a text is the hole that follows it, braces and all, or the closing quote.
  assert_eq(rejection_span(src, site, 0, 3), span_between(6, 9));
  assert_eq(rejection_span(src, site, 1, 3), span_between(12, 15));
  assert_eq(rejection_span(src, site, 2, 0), span_between(15, 16));
  // A text or a character the literal has not is the whole string.
  assert_eq(rejection_span(src, site, 3, 0), span_between(2, 16));
  assert_eq(rejection_span(src, site, 1, 9), span_between(2, 16));
  assert_eq(argument_of(request_of(site)), VList([VStr("ab "), VStr(" cd"), VStr("")]));
  assert_eq(argument_of(request_of(a_site(b"ab"))), VStr("ab"))
}

test "verdicts kept come back in the order they were sought, the rest from what was found" {
  let a: EvaluationRequest = { callee: b"m.literal", hash: b"h", parts: [b"a"] };
  let sought = [
    { asked: a, key: b"1", kept: None },
    { asked: a, key: b"2", kept: Some(Accepted) },
    { asked: a, key: b"3", kept: None },
  ];
  assert_eq(merge_verdicts(sought, [Abandoned, Raised("x")]), [Abandoned, Accepted, Raised("x")])
}

test "a verdict the clock decided is never kept" {
  assert(!cacheable(Abandoned));
  assert(cacheable(Raised("m")));
  assert(cacheable(Rejected({ part: 0, offset: 1, message: "m" })));
  assert(cacheable(Accepted))
}

test "a verdict is kept under the toolchain, the parser's hash and the text" {
  let a: EvaluationRequest = { callee: b"m.literal", hash: b"h", parts: [b"a"] };
  let key = verdict_key(b"t", a);
  assert_eq(verdict_key(b"t", { ..a, callee: b"n.literal" }), key);
  assert(verdict_key(b"u", a) != key);
  assert(verdict_key(b"t", { ..a, hash: b"g" }) != key);
  assert(verdict_key(b"t", { ..a, parts: [b"b"] }) != key);
  // The texts around a hole are not the one text they would join to.
  assert(
    verdict_key(b"t", { ..a, parts: [b"a", b"b"] }) != verdict_key(b"t", { ..a, parts: [b"ab"] }),
  );
  assert(
    verdict_key(b"t", { ..a, parts: [b"a", b"b"] })
      != verdict_key(b"t", { ..a, parts: [b"ab", b""] }),
  )
}

test "the toolchain a verdict is kept under moves with the code that judges it, and with no shipped module" {
  let held = |with_evaluation_cache: Bytes, other: Bytes|
    Bytes::concat_all(
      toolchain_roots().push(b"std.result.unreached").map(|name: Bytes|
        Bytes::concat_all([
          name,
          b" ",
          if name == b"literals.with_evaluation_cache" { with_evaluation_cache }
          else if name == b"std.result.unreached" { other }
          else { b"aa" },
          b"\n",
        ])),
    );
  let toolchain = toolchain_key(held(b"s1", b"o1"), b"runtime", "0.1.0");
  assert_eq(toolchain_key(held(b"s1", b"o2"), b"runtime", "0.1.0"), toolchain);
  assert(toolchain_key(held(b"s2", b"o1"), b"runtime", "0.1.0") != toolchain);
  assert(toolchain_key(held(b"s1", b"o1"), b"other runtime", "0.1.0") != toolchain);
  assert(toolchain_key(held(b"s1", b"o1"), b"runtime", "0.2.0") != toolchain)
}
