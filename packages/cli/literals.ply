pub type Verdict =
  | Accepted
  | Rejected({ part: Int, offset: Int, message: String })
  | Raised(String)
  | TimedOut

derive bin for Verdict

pub type EvaluationRequest = { callee: Bytes, hash: Bytes, parts: List<Bytes> }

pub type StoredJudgements = { verdicts: List<Verdict>, statements: List<CheckResult> }

pub effect evaluation {
  read verdicts(program: CodeProgram, requests: List<EvaluationRequest>) -> Result<List<Verdict>, List<Diagnostic>>
  read statements(program: CodeProgram, requests: List<statements::StatementCheck>) -> Result<List<CheckResult>, List<Diagnostic>>
  read stored(place: ProgramPlace, requests: List<EvaluationRequest>, checks: List<statements::StatementCheck>) -> Option<StoredJudgements>
}

pub type SiteCheck = | Settled(List<Diagnostic>) | Unsettled

fn request_of(site: TaggedSite) -> EvaluationRequest =
  { callee: site.callee, hash: site.hash, parts: site.parts.map(|part: TaggedPart| part.text) }

fn request_identity(a: EvaluationRequest) -> Bytes / {abort.raise} = verdict_key(b"", a)

fn distinct_requests(sites: List<TaggedSite>) -> List<EvaluationRequest> / {abort.raise} =
  sites.fold(Map::new(), |found: Map<Bytes, EvaluationRequest>, site: TaggedSite|
    found.insert(request_identity(request_of(site)), request_of(site))).values(
  )

fn source_width(source: Bytes, i: Int, end: Int) -> Int / {abort.raise} =
  if i + 1 >= end { utf8_len(source.at(i)) }
  else if source.at(i) == 123 || source.at(i) == 125 { 2 }
  else if source.at(i) != 92 { utf8_len(source.at(i)) }
  else if source.at(i + 1) != 117 { 2 } else {
    iterate(i + 2, end - i, |j: Int|
      if j >= end { Stop(end - i) }
      else if source.at(j) == 125 { Stop(j + 1 - i) }
      else { Continue(j + 1) })
  }

pub fn source_span_at(source: Bytes, quoted: Span, offset: Int) -> Option<Span> / {abort.raise} = {
  let end = quoted.end - 1;
  if offset < 0 || quoted.start + 1 > end || quoted.end > source.len() { None } else {
    iterate(
      { i: quoted.start + 1, left: offset },
      end - quoted.start + 1,
      |s: { i: Int, left: Int }|
        if s.i >= end { Stop(if s.left == 0 { Some(span_between(end, end + 1)) } else { None }) }
        else {
          let width = source_width(source, s.i, end);
          if s.left == 0 { Stop(Some(span_between(s.i, s.i + width))) }
          else { Continue({ i: s.i + width, left: s.left - 1 }) }
        },
    )
  }
}

fn has_holes(site: TaggedSite) -> Bool = site.parts.len() > 1

fn parser_name(site: TaggedSite) -> Bytes =
  Bytes::concat_all([b"`", site.tag, if has_holes(site) { b"::compile`" } else { b"::literal`" }])

fn call_note(site: TaggedSite) -> Bytes =
  if has_holes(site) {
    Bytes::concat_all([
      b"the check ran `",
      site.callee,
      b"` on the texts around the holes, as every `",
      site.tag,
      b"\"..{h}..\"` here is `",
      site.tag,
      b"::fill` called on what `",
      site.tag,
      b"::compile([\"..\", \"..\"])` answers and on its holes",
    ])
  } else {
    Bytes::concat_all([
      b"the check ran `",
      site.callee,
      b"` on the text, as every `",
      site.tag,
      b"\"..\"` here is the call `",
      site.tag,
      b"::literal(\"..\")`",
    ])
  }

fn string_span(site: TaggedSite) -> Span =
  match ((site.parts.at(0), site.parts.at(site.parts.len() - 1))) {
    (Some(first), Some(last)) -> span_between(first.quoted.start, last.quoted.end),
    _ -> site.span,
  }

fn rejection_span(source: Bytes, site: TaggedSite, part: Int, offset: Int) -> Span / {abort.raise} =
  match site.parts.at(part) {
    None -> string_span(site),
    Some(text) -> match source_span_at(source, text.quoted, offset) {
      None -> string_span(site),
      Some(span) -> match site.parts.at(part + 1) {
        Some(next) -> if span.start != text.quoted.end - 1 { span }
        else { span_between(span.start, next.quoted.start + 1) },
        None -> span,
      },
    },
  }

fn literal_error(
  places: List<SourceText>,
  site: TaggedSite,
  verdict: Verdict,
) -> Option<Diagnostic> / {abort.raise} =
  match verdict {
    Accepted -> None,
    Rejected(reason) -> {
      let source = match places.at(site.module) { Some(place) -> place.text, None -> b"" };
      Some(
        error_at(
          b"E0153",
          site.module,
          rejection_span(source, site, reason.part, reason.offset),
          parser_name(site).concat(b" rejects this literal"),
          Bytes::of_string(reason.message),
          [call_note(site)],
        ),
      )
    },
    Raised(message) ->
      Some(
        error_at(
          b"E0154",
          site.module,
          site.span,
          Bytes::concat_all([
            parser_name(site),
            b" raised on this literal: ",
            Bytes::of_string(message),
          ]),
          b"its parser returned no result",
          [call_note(site), b"a parser returns `Err` of a text it rejects, saying where and why"],
        ),
      ),
    TimedOut ->
      Some(
        error_at(
          b"E0154",
          site.module,
          site.span,
          Bytes::concat_all([parser_name(site), b" did not finish this literal in time"]),
          b"its parser returned no result",
          [call_note(site), timeout_note(b"a check gives each literal's parser")],
        ),
      ),
  }

fn timeout_note(whose: Bytes) -> Bytes =
  Bytes::concat_all([
    whose,
    b" ",
    Bytes::of_string(entered_timeout_ms.to_string()),
    b" ms of wall clock, and stops it there",
  ])

pub fn site_errors<a>(
  s: Session<a>,
  later: LaterReading,
  places: List<SourceText>,
) -> List<Diagnostic> / {evaluation.verdicts, evaluation.statements, EmbeddedFiles, abort.raise} =
  if later.sites.tagged.len() + later.sites.statements.len() == 0 { [] } else {
    match units::code_program_of(s, later.rollup) {
      Err(diagnostics) -> diagnostics,
      Ok(program) -> evaluation_errors(program, later.sites, places),
    }
  }

pub fn later_errors<a>(
  s: Session<a>,
  later: LaterChecks,
  places: List<SourceText>,
) -> List<Diagnostic> / {cost_checker.report, evaluation.verdicts, evaluation.statements, EmbeddedFiles, abort.raise} =
  match reuse_violations(s, later.facts) {
    [] -> site_errors(s, later.reading, places),
    broken -> broken,
  }

pub fn stored_site_check(
  place: ProgramPlace,
  sites: ProgramSites,
  places: List<SourceText>,
) -> SiteCheck / {evaluation.stored, abort.raise} = {
  let parsers = distinct_requests(sites.tagged);
  let checks = check_sites(sites);
  if parsers.len() + checks.len() == 0 { Settled(schemas_rejected(checks)) } else {
    match evaluation.stored(place, parsers, checks.map(|a: CheckSite| a.check)) {
      None -> Unsettled,
      Some(found) ->
        Settled(
          verdict_errors(sites.tagged, places, parsers, found.verdicts).concat(
            judged_errors(checks, found.statements),
          ),
        ),
    }
  }
}

pub fn evaluation_errors(
  program: CodeProgram,
  sites: ProgramSites,
  places: List<SourceText>,
) -> List<Diagnostic> / {evaluation.verdicts, evaluation.statements, abort.raise} =
  literal_errors(program, sites.tagged, places).concat(statement_errors(program, sites))

fn statement_errors(
  program: CodeProgram,
  sites: ProgramSites,
) -> List<Diagnostic> / {evaluation.statements, abort.raise} = {
  let checks = check_sites(sites);
  let rejected = schemas_rejected(checks);
  if checks.len() == 0 { rejected } else {
    match evaluation.statements(program, checks.map(|a: CheckSite| a.check)) {
      Err(diagnostics) -> rejected.concat(diagnostics),
      Ok(judgements) -> judged_errors(checks, judgements),
    }
  }
}

fn judged_errors(checks: List<CheckSite>, judgements: List<CheckResult>) -> List<Diagnostic> / {abort.raise} =
  range(0, checks.len()).fold(schemas_rejected(checks), |accumulator: List<Diagnostic>, i: Int|
    match judgements.at(i) {
      Some(j) -> accumulator.concat(check_diagnostics(checks.get(i), j)),
      None -> accumulator,
    })

fn literal_errors(
  program: CodeProgram,
  sites: List<TaggedSite>,
  places: List<SourceText>,
) -> List<Diagnostic> / {evaluation.verdicts, abort.raise} =
  if sites.len() == 0 { [] } else {
    let parsers = distinct_requests(sites);
    match evaluation.verdicts(program, parsers) {
      Err(diagnostics) -> diagnostics,
      Ok(verdicts) -> verdict_errors(sites, places, parsers, verdicts),
    }
  }

fn verdict_errors(
  sites: List<TaggedSite>,
  places: List<SourceText>,
  parsers: List<EvaluationRequest>,
  verdicts: List<Verdict>,
) -> List<Diagnostic> / {abort.raise} = {
  let by_identity = range(0, parsers.len()).fold(Map::new(), |found: Map<Bytes, Verdict>, i: Int|
    match verdicts.at(i) {
      Some(v) -> found.insert(request_identity(parsers.get(i)), v),
      None -> found,
    });
  sites.fold([], |accumulator: List<Diagnostic>, site: TaggedSite|
    match by_identity.get(request_identity(request_of(site))) {
      None -> accumulator,
      Some(verdict) -> match literal_error(places, site, verdict) {
        Some(diagnostic) -> accumulator.push(diagnostic),
        None -> accumulator,
      },
    })
}

fn verdict_of(called: CallResult) -> Verdict / {abort.raise} =
  match called.result {
    Err(raised) -> {
      let diagnostic = shown(raised);
      if machine::is_timed_out(diagnostic.code) { TimedOut }
      else { Raised(String::of_bytes_lossy(diagnostic.message)) }
    },
    Ok(value) -> match value {
      VCtor(name, args) -> if name == "Ok" { Accepted } else {
        match args.at(0) {
          Some(VRecord(fields)) -> match ((
              field_named(fields, "offset"),
              field_named(fields, "message"),
            )) {
            (Some(VInt(offset)), Some(VStr(message))) ->
              Rejected({
                part: match field_named(fields, "part") { Some(VInt(part)) -> part, _ -> 0 },
                offset: offset,
                message: message,
              }),
            _ -> Raised("it returned " ++ render(value)),
          },
          _ -> Raised("it returned " ++ render(value)),
        }
      },
      _ -> Raised("it returned " ++ render(value)),
    },
  }

fn argument_of(a: EvaluationRequest) -> Value = {
  let texts = a.parts.map(|text: Bytes| VStr(String::of_bytes_lossy(text)));
  match texts { [text] -> text, _ -> VList(texts) }
}

fn callees(requests: List<EvaluationRequest>) -> List<Bytes> =
  requests.fold([], |accumulator: List<Bytes>, a: EvaluationRequest|
    if accumulator.contains(a.callee) { accumulator } else { accumulator.push(a.callee) })

fn evaluate(
  program: CodeProgram,
  requests: List<EvaluationRequest>,
) -> Result<List<Verdict>, List<Diagnostic>> / {emit.code, emit.libraries, entering::machine.open, entering::machine.enter, entering::machine.close, abort.raise} =
  if requests.len() == 0 { Ok([]) } else {
    match emit.libraries(emit.code(program, callees(requests).map(Named)), cc::development()) {
      Err(diagnostics) -> Err(diagnostics),
      Ok(library) -> match entering::machine.open(library) {
        Err(reason) -> Err([machine::unit_load_error(reason)]),
        Ok(opened) -> {
          let call = |name: Bytes, args: List<Value>|
            machine::machine_call(
              opened.unit,
              program.roots,
              String::of_bytes_lossy(name),
              args,
              machine::evaluation_limits,
            );
          let returned = requests.map(|a: EvaluationRequest|
            verdict_of(call(a.callee, [argument_of(a)])));
          entering::machine.close(opened.unit);
          Ok(returned)
        },
      },
    }
  }

fn verdict_key(toolchain: Bytes, a: EvaluationRequest) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all([
        length_prefixed(b"ply literal verdict 3"),
        length_prefixed(hex(bin::shape_digest(verdict_bin()))),
        length_prefixed(toolchain),
        length_prefixed(a.hash),
        length_prefixed(Bytes::of_string(a.parts.len().to_string())),
        Bytes::concat_all(a.parts.map(length_prefixed)),
      ]),
    ),
  )

fn toolchain_key(definitions: Bytes, runtime: Bytes, version: String) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all([
        length_prefixed(b"ply literal toolchain 1"),
        length_prefixed(runtime),
        length_prefixed(Bytes::of_string(version)),
        length_prefixed(identity_of(definitions, toolchain_roots)),
      ]),
    ),
  )

const toolchain_roots: List<Bytes> = compiler_roots.push(b"literals.with_evaluation_cache")

type KeyedRequest = { request: EvaluationRequest, key: Bytes, cached: Option<Verdict> }

type Judging = { cache: Option<tables::Cache>, label: String }

fn judging_store(
  place: ProgramPlace,
) -> Judging / {fs.read[cwd], fs.read[abs], fs.read_file[shipped], semantics.cached, abort.raise} =
  match place.store {
    None -> { cache: None, label: "" },
    Some(r) -> {
      let dir = paths::in_root(r, ".ply-cache").path;
      let stamps = project_store::shipped_stamps();
      {
        cache: Some(if r.label == "cwd" { tables::open_cache[cwd](dir, stamps) }
        else { tables::open_cache[abs](dir, stamps) }),
        label: r.label,
      }
    },
  }

fn judgement_of(j: Judging, kind: tables::Judged, key: Bytes) -> Option<Bytes> / {abort.raise} =
  match j.cache { Some(c) -> tables::judgement(c, kind, key), None -> None }

fn stored_verdict(j: Judging, key: Bytes) -> Option<Verdict> / {abort.raise} =
  match judgement_of(j, tables::Verdicts, key) {
    None -> None,
    Some(bytes) -> match bin::decode(bytes, verdict_bin()) { Ok(v) -> Some(v), Err(_) -> None },
  }

fn stored_statement(j: Judging, key: Bytes) -> Option<CheckResult> / {abort.raise} =
  match judgement_of(j, tables::StatementChecks, key) {
    None -> None,
    Some(bytes) -> match bin::decode(bytes, check_result_bin()) { Ok(r) -> Some(r), Err(_) -> None },
  }

fn all_stored<a>(found: List<Option<a>>) -> Option<List<a>> =
  found.fold(Some([]), |all: Option<List<a>>, one: Option<a>|
    match ((all, one)) { (Some(xs), Some(x)) -> Some(xs.push(x)), _ -> None })

fn judgements_stored(
  j: Judging,
  kind: tables::Judged,
  judgements: Map<Bytes, Bytes>,
) -> Unit / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], abort.raise} =
  match j.cache {
    None -> (),
    Some(c) -> {
      let replaced = tables::judgements_replaced(c, kind, judgements);
      if j.label == "cwd" { tables::flush_cache[cwd](replaced) }
      else { tables::flush_cache[abs](replaced) };
      ()
    },
  }

fn toolchain_now() -> Bytes / {shipped.definitions, shipped.runtime, shipped.version, abort.raise} =
  toolchain_key(shipped.definitions(), shipped_runtime().identity, shipped.version())

pub fn with_evaluation_cache<a | e>(
  body: () -> a / {evaluation.verdicts, evaluation.statements, evaluation.stored | e},
) -> a / {emit.code, emit.libraries, entering::machine.open, entering::machine.enter, entering::machine.close, shipped.runtime, shipped.definitions, shipped.version, semantics.cached, fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], abort.raise | e} =
  handle {
    body()
  } with {
    evaluation.statements(program, checks) ->
      judgements(toolchain_now(), judging_store(program.place), program, checks),
    evaluation.stored(place, requests, checks) -> {
      let toolchain = toolchain_now();
      let j = judging_store(place);
      match ((
          all_stored(requests.map(|a: EvaluationRequest| stored_verdict(j, verdict_key(toolchain, a)))),
          all_stored(checks.map(|a: statements::StatementCheck|
            stored_statement(j, check_result_key(toolchain, a)))),
        )) {
        (Some(verdicts), Some(statements)) -> Some({ verdicts: verdicts, statements: statements }),
        _ -> None,
      }
    },
    evaluation.verdicts(program, requests) -> {
      let toolchain = toolchain_now();
      let j = judging_store(program.place);
      let sought = requests.map(|a: EvaluationRequest| {
        let key = verdict_key(toolchain, a);
        {
          request: a,
          key: key,
          cached: stored_verdict(j, key),
        }
      });
      let open = sought.filter(|s: KeyedRequest| s.cached == None);
      match if open.len() == 0 { Ok([]) }
        else { evaluate(program, open.map(|s: KeyedRequest| s.request)) } {
        Err(diagnostics) -> Err(diagnostics),
        Ok(found) -> {
          let cached = sought.fold(Map::new(), |stored: Map<Bytes, Bytes>, s: KeyedRequest|
            match s.cached {
              Some(v) -> stored.insert(s.key, bin::encode(v, verdict_bin())),
              None -> stored,
            });
          judgements_stored(
            j,
            tables::Verdicts,
            range(0, open.len()).fold(cached, |stored: Map<Bytes, Bytes>, i: Int|
              match found.at(i) {
                Some(v) -> if cacheable(v) {
                  stored.insert(open.get(i).key, bin::encode(v, verdict_bin()))
                } else { stored },
                None -> stored,
              }),
          );
          Ok(merge_verdicts(sought, found))
        },
      }
    },
  }

fn cacheable(v: Verdict) -> Bool = match v { TimedOut -> false, _ -> true }

type KeyedStatement = {
  request: statements::StatementCheck,
  key: Bytes,
  cached: Option<CheckResult>,
}

fn judgements(
  toolchain: Bytes,
  j: Judging,
  program: CodeProgram,
  checks: List<statements::StatementCheck>,
) -> Result<List<CheckResult>, List<Diagnostic>> / {emit.code, emit.libraries, entering::machine.open, entering::machine.enter, entering::machine.close, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], abort.raise} = {
  let keyed = checks.map(|a: statements::StatementCheck| {
    let key = check_result_key(toolchain, a);
    {
      request: a,
      key: key,
      cached: stored_statement(j, key),
    }
  });
  let open = keyed.filter(|k: KeyedStatement| k.cached == None);
  match if open.len() == 0 { Ok([]) }
    else { check_statements(program, open.map(|k: KeyedStatement| k.request)) } {
    Err(diagnostics) -> Err(diagnostics),
    Ok(checked) -> {
      let cached = keyed.fold(Map::new(), |found: Map<Bytes, Bytes>, k: KeyedStatement|
        match k.cached {
          Some(r) -> found.insert(k.key, bin::encode(r, check_result_bin())),
          None -> found,
        });
      judgements_stored(
        j,
        tables::StatementChecks,
        range(0, open.len()).fold(cached, |found: Map<Bytes, Bytes>, i: Int|
          match checked.at(i) {
            Some(Some(r)) -> found.insert(open.get(i).key, bin::encode(r, check_result_bin())),
            _ -> found,
          }),
      );
      Ok(
        keyed.fold(
          { out: [], next: 0 },
          |accumulator: { out: List<CheckResult>, next: Int }, k: KeyedStatement|
            match k.cached {
              Some(r) -> { out: accumulator.out.push(r), next: accumulator.next },
              None ->
                {
                  out: accumulator.out.push(match checked.at(accumulator.next) {
                    Some(Some(r)) -> r,
                    _ -> Unchecked,
                  }),
                  next: accumulator.next + 1,
                },
            },
        ).out,
      )
    },
  }
}

fn merge_verdicts(sought: List<KeyedRequest>, found: List<Verdict>) -> List<Verdict> =
  sought.fold(
    { out: [], next: 0 },
    |accumulator: { out: List<Verdict>, next: Int }, s: KeyedRequest|
      match s.cached {
        Some(v) -> { out: accumulator.out.push(v), next: accumulator.next },
        None ->
          {
            out: match found.at(accumulator.next) {
              Some(v) -> accumulator.out.push(v),
              None -> accumulator.out,
            },
            next: accumulator.next + 1,
          },
      },
  ).out

fn a_site(text: Bytes) -> TaggedSite =
  {
    module: 0,
    span: span_between(0, 5 + text.len()),
    tag: b"hex",
    parts: [{ text: text, quoted: span_between(3, 5 + text.len()) }],
    callee: b"hex.literal",
    hash: b"h",
  }

test "`source_span_at` returns the source range of each character of a literal's text, including escapes, and `None` out of range" {
  let source = b"hex\"a\\n\\u{e9}\xc3\xa9z\"";
  let quoted = span_between(3, source.len());
  assert_eq(source_span_at(source, quoted, 0), Some(span_between(4, 5)));
  assert_eq(source_span_at(source, quoted, 1), Some(span_between(5, 7)));
  assert_eq(source_span_at(source, quoted, 2), Some(span_between(7, 13)));
  assert_eq(source_span_at(source, quoted, 3), Some(span_between(13, 15)));
  assert_eq(source_span_at(source, quoted, 4), Some(span_between(15, 16)));
  assert_eq(source_span_at(source, quoted, 5), Some(span_between(16, 17)));
  assert_eq(source_span_at(source, quoted, 6), None);
  assert_eq(source_span_at(source, quoted, 0 - 1), None);
  let braced = b"hex\"a{{}}z\"";
  let all = span_between(3, braced.len());
  assert_eq(source_span_at(braced, all, 1), Some(span_between(5, 7)));
  assert_eq(source_span_at(braced, all, 2), Some(span_between(7, 9)));
  assert_eq(source_span_at(braced, all, 3), Some(span_between(9, 10)))
}

test "`verdict_of` turns a literal parser's result into accepted, rejected, timed out or failed, and treats a timeout as different from other errors" {
  let returned = |v: Value| verdict_of({ result: Ok(v), warnings: [] });
  let failed = |code: Bytes|
    verdict_of({
      result: Err({ diagnostic: diagnostic_of(Error, code, "m", [], []), values: [] }),
      warnings: [],
    });
  assert_eq(failed(b"W0612"), TimedOut);
  assert_eq(failed(b"E0502"), Raised("m"));
  assert_eq(returned(VCtor("Ok", [VInt(1)])), Accepted);
  assert_eq(
    returned(
      VCtor("Err", [
        VRecord([{ name: "message", value: VStr("odd") }, { name: "offset", value: VInt(2) }]),
      ]),
    ),
    Rejected({ part: 0, offset: 2, message: "odd" }),
  );
  assert_eq(
    returned(
      VCtor("Err", [
        VRecord([
          { name: "message", value: VStr("odd") },
          { name: "offset", value: VInt(2) },
          { name: "part", value: VInt(1) },
        ]),
      ]),
    ),
    Rejected({ part: 1, offset: 2, message: "odd" }),
  );
  assert_eq(returned(VInt(1)), Raised("it returned 1"))
}

test "`literal_error` points a rejected literal's error at the bad character, or at the whole literal text when the offset is past the end" {
  let site = a_site(b"abz");
  let places = [{ path: "main.ply", text: b"hex\"abz\"" }];
  let labelled = |verdict: Verdict|
    match literal_error(places, site, verdict) {
      Some(d) -> match d.labels.at(0) {
        Some(l) -> match source_span(l) {
          Some(s) -> Some({ code: d.code, start: s.start, end: s.end }),
          None -> None,
        },
        None -> None,
      },
      None -> None,
    };
  assert_eq(labelled(Accepted), None);
  assert_eq(
    labelled(Rejected({ part: 0, offset: 2, message: "not a hex digit" })),
    Some({ code: b"E0153", start: 6, end: 7 }),
  );
  assert_eq(
    labelled(Rejected({ part: 0, offset: 40, message: "too short" })),
    Some({ code: b"E0153", start: 3, end: 8 }),
  );
  assert_eq(labelled(TimedOut), Some({ code: b"E0154", start: 0, end: 8 }));
  assert_eq(labelled(Raised("boom")), Some({ code: b"E0154", start: 0, end: 8 }))
}

test "for a literal with `{}` interpolations, `rejection_span` points at the character at the given offset in the given text part, or at the interpolation after that part when the offset is past its end" {
  let source = b"sh\"ab {x} cd{y}\"";
  let site = {
    module: 0,
    span: span_between(0, source.len()),
    tag: b"sh",
    parts: [
      { text: b"ab ", quoted: span_between(2, 7) },
      { text: b" cd", quoted: span_between(8, 13) },
      { text: b"", quoted: span_between(14, 16) },
    ],
    callee: b"sh.compile",
    hash: b"h",
  };
  assert_eq(rejection_span(source, site, 0, 1), span_between(4, 5));
  assert_eq(rejection_span(source, site, 1, 2), span_between(11, 12));
  assert_eq(rejection_span(source, site, 0, 3), span_between(6, 9));
  assert_eq(rejection_span(source, site, 1, 3), span_between(12, 15));
  assert_eq(rejection_span(source, site, 2, 0), span_between(15, 16));
  assert_eq(rejection_span(source, site, 3, 0), span_between(2, 16));
  assert_eq(rejection_span(source, site, 1, 9), span_between(2, 16));
  assert_eq(argument_of(request_of(site)), VList([VStr("ab "), VStr(" cd"), VStr("")]));
  assert_eq(argument_of(request_of(a_site(b"ab"))), VStr("ab"))
}

test "`merge_verdicts` returns cached verdicts and newly computed verdicts in the order the requests were made" {
  let a: EvaluationRequest = { callee: b"m.literal", hash: b"h", parts: [b"a"] };
  let sought = [
    { request: a, key: b"1", cached: None },
    { request: a, key: b"2", cached: Some(Accepted) },
    { request: a, key: b"3", cached: None },
  ];
  assert_eq(merge_verdicts(sought, [TimedOut, Raised("x")]), [TimedOut, Accepted, Raised("x")])
}

test "`cacheable` is false for a timed-out verdict and true for accepted, rejected and failed verdicts" {
  assert(!cacheable(TimedOut));
  assert(cacheable(Raised("m")));
  assert(cacheable(Rejected({ part: 0, offset: 1, message: "m" })));
  assert(cacheable(Accepted))
}

test "`verdict_key` depends on the toolchain, the parser's hash and the literal's text parts, but not on the parser's module name" {
  let a: EvaluationRequest = { callee: b"m.literal", hash: b"h", parts: [b"a"] };
  let key = verdict_key(b"t", a);
  assert_eq(verdict_key(b"t", { ..a, callee: b"n.literal" }), key);
  assert(verdict_key(b"u", a) != key);
  assert(verdict_key(b"t", { ..a, hash: b"g" }) != key);
  assert(verdict_key(b"t", { ..a, parts: [b"b"] }) != key);
  assert(
    verdict_key(b"t", { ..a, parts: [b"a", b"b"] }) != verdict_key(b"t", { ..a, parts: [b"ab"] }),
  );
  assert(
    verdict_key(b"t", { ..a, parts: [b"a", b"b"] })
      != verdict_key(b"t", { ..a, parts: [b"ab", b""] }),
  )
}

test "`toolchain_key` changes with the code that checks literals, the runtime and the version, but not with an unrelated shipped module" {
  let definition_hashes = |with_evaluation_cache: Bytes, other: Bytes|
    Bytes::concat_all(
      toolchain_roots.push(b"std.result.unreached").map(|name: Bytes|
        Bytes::concat_all([
          name,
          b" ",
          if name == b"literals.with_evaluation_cache" { with_evaluation_cache }
          else if name == b"std.result.unreached" { other }
          else { b"aa" },
          b"\n",
        ])),
    );
  let toolchain = toolchain_key(definition_hashes(b"s1", b"o1"), b"runtime", "0.1.0");
  assert_eq(toolchain_key(definition_hashes(b"s1", b"o2"), b"runtime", "0.1.0"), toolchain);
  assert(toolchain_key(definition_hashes(b"s2", b"o1"), b"runtime", "0.1.0") != toolchain);
  assert(toolchain_key(definition_hashes(b"s1", b"o1"), b"other runtime", "0.1.0") != toolchain);
  assert(toolchain_key(definition_hashes(b"s1", b"o1"), b"runtime", "0.2.0") != toolchain)
}
