import compiler.front.rows (ModuleSpan)
import compiler.front.emitter_input (no_module_span)
import compiler.check.resolve.tables (Diagnostic, Label, error_with_labels)
import report (count_of)
import std.string

pub type Main = { name: String, module: String, path: String, at: ModuleSpan }

pub type Module = { name: String, path: String, at: ModuleSpan }

pub fn span_label(at: ModuleSpan, primary: Bool, text: Bytes) -> Label =
  { module: at.module, start: at.start, end: at.end, primary: primary, text: text }

fn advice() -> Bytes = b"`ply test` runs the tests; `ply run` runs `main`"

fn add_main_note(module: String) -> Bytes =
  Bytes::of_string("add `fn main() -> Unit = ...` to `" ++ module ++ "`")

fn no_main_in_module(only: Module) -> Diagnostic =
  error_with_labels(
    b"E0101",
    b"no `main` to run",
    [span_label(only.at, true, Bytes::of_string("`" ++ only.name ++ "` declares no entry point"))],
    [advice(), add_main_note(only.name)],
  )

fn no_main_in_modules(modules: List<Module>) -> Diagnostic =
  error_with_labels(b"E0101", b"no `main` to run", [], [
    advice(),
    b"add `fn main() -> Unit = ...` to one of the loaded modules",
    Bytes::of_string(
      "modules loaded: " ++ String::join(modules.map(|module: Module| module.name), ", "),
    ),
  ])

fn no_main(modules: List<Module>) -> Diagnostic =
  match modules.at(0) {
    Some(only) -> if modules.len() == 1 { no_main_in_module(only) }
    else { no_main_in_modules(modules) },
    None -> no_main_in_modules(modules),
  }

fn declarations(mains: List<Main>) -> List<Label> =
  mains.fold([], |accumulator: List<Label>, m: Main|
    accumulator.push(
      span_label(
        m.at,
        accumulator.len() == 0,
        Bytes::of_string("`" ++ m.module ++ "` declares `main` here"),
      ),
    ))

fn ambiguous_main(mains: List<Main>) -> Diagnostic / {abort.raise} =
  error_with_labels(
    b"E0112",
    Bytes::of_string(count_of(mains.len(), "module") ++ " declare `main`"),
    declarations(mains),
    mains.map(|m: Main| Bytes::of_string("run it with `ply run " ++ m.path ++ "`")).push(
      b"a directory is a whole program, so `ply run` will not pick one for you",
    ),
  )

pub fn entry_point(
  mains: List<Main>,
  modules: List<Module>,
) -> Result<Main, Diagnostic> / {abort.raise} =
  match mains.at(0) {
    None -> Err(no_main(modules)),
    Some(only) -> if mains.len() == 1 { Ok(only) } else { Err(ambiguous_main(mains)) },
  }

fn a_main(module: String) -> Main =
  {
    name: module ++ ".main",
    module: module,
    path: module ++ ".ply",
    at: { module: 0, start: 3, end: 7 },
  }

fn a_module(name: String, index: Int, end: Int) -> Module =
  { name: name, path: name ++ ".ply", at: { module: index, start: end, end: end } }

fn first_label(diagnostic: Diagnostic) -> Label =
  match diagnostic.labels.at(0) { Some(l) -> l, None -> span_label(no_module_span(), false, b"") }

test "the one `main` a program declares is its entry point" {
  let one = [a_main("app")];
  assert_eq(entry_point(one, [a_module("app", 0, 40)]), Ok(a_main("app")))
}

test "a program with no `main` gets an error whose label is at the end of its only file" {
  match entry_point([], [a_module("m", 0, 40)]) {
    Ok(_) -> panic("no definition named `main` is no entry point"),
    Err(d) -> {
      assert_eq(d.code, b"E0101");
      assert_eq(d.message, b"no `main` to run");
      assert_eq(d.labels.len(), 1);
      assert_eq(first_label(d).start, 40);
      assert_eq(first_label(d).end, 40);
      assert_eq(d.notes_text, [
        b"`ply test` runs the tests; `ply run` runs `main`",
        b"add `fn main() -> Unit = ...` to `m`",
      ])
    },
  }
}

test "`entry_point` fails with E0101 for several modules without `main`, listing every module name in a note" {
  match entry_point([], [a_module("a", 0, 18), a_module("b", 1, 18)]) {
    Ok(_) -> panic("no definition named `main` is no entry point"),
    Err(d) -> {
      assert_eq(d.code, b"E0101");
      assert_eq(d.labels, []);
      assert_eq(d.notes_text, [
        b"`ply test` runs the tests; `ply run` runs `main`",
        b"add `fn main() -> Unit = ...` to one of the loaded modules",
        b"modules loaded: a, b",
      ])
    },
  }
}

test "two modules that declare `main` are reported rather than resolved by load order" {
  let both = [a_main("one"), a_main("two")];
  match entry_point(both, [a_module("one", 0, 20), a_module("two", 1, 20)]) {
    Ok(_) -> panic("two definitions named `main` is not one entry point"),
    Err(d) -> {
      assert_eq(d.code, b"E0112");
      assert_eq(d.message, b"2 modules declare `main`");
      assert_eq(d.labels.len(), 2);
      assert_eq(first_label(d).primary, true);
      assert_eq(d.notes_text, [
        b"run it with `ply run one.ply`",
        b"run it with `ply run two.ply`",
        b"a directory is a whole program, so `ply run` will not pick one for you",
      ])
    },
  }
}
