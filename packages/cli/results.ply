pub type OpenStore = { place: project_store::StoreLocation, cache: tables::Cache }

pub fn store_for(
  paths: List<paths::ResolvedPath>,
  no_cache: Bool,
) -> Option<OpenStore> / {semantics.cached, fs.read[cwd], fs.read[abs], fs.read_file[shipped], abort.raise} =
  if no_cache { None } else { Some(open_store(paths, project_store::shipped_stamps())) }

pub fn open_store(
  paths: List<paths::ResolvedPath>,
  stamps: tables::Stamps,
) -> OpenStore / {fs.read[cwd], fs.read[abs], abort.raise} = {
  let place = project_store::store_location_of(paths, stamps);
  {
    place: place,
    cache: if place.label == "cwd" { tables::open_cache[cwd](place.dir, stamps) }
    else { tables::open_cache[abs](place.dir, stamps) },
  }
}

type StoreRead<a> = { value: a, cache: tables::Cache }

fn read_pass_traces(
  c0: tables::Cache,
  keys: List<Bytes>,
) -> StoreRead<List<Option<Bytes>>> / {abort.raise} =
  keys.fold({ value: [], cache: c0 }, |accumulator: StoreRead<List<Option<Bytes>>>, key: Bytes| {
    let got = tables::pass_trace(accumulator.cache, key);
    { value: accumulator.value.push(got.value), cache: got.cache }
  })

fn code_passes_over(
  c0: tables::Cache,
  keys: List<Bytes>,
) -> StoreRead<List<Option<Bytes>>> / {abort.raise} =
  keys.fold({ value: [], cache: c0 }, |accumulator: StoreRead<List<Option<Bytes>>>, key: Bytes| {
    let got = tables::code_pass_trace(accumulator.cache, key);
    { value: accumulator.value.push(got.value), cache: got.cache }
  })

fn snapshot_over(
  c0: tables::Cache,
  digest: Bytes,
) -> StoreRead<Option<RecordedGraph>> / {abort.raise} = {
  let got = tables::snapshot(c0, digest);
  match got.value {
    None -> { value: None, cache: got.cache },
    Some(modules) -> {
      let read = modules.fold(
        { value: Some([]), cache: got.cache },
        |accumulator: StoreRead<Option<List<ModuleRecord>>>, m: Bytes|
          match accumulator.value {
            None -> accumulator,
            Some(rs) -> {
              let got = tables::module_record(accumulator.cache, m);
              {
                value: match got.value { Some(x) -> Some(rs.push(x)), None -> None },
                cache: got.cache,
              }
            },
          },
      );
      {
        value: match read.value { Some(rs) -> Some(recorded_graph(rs)), None -> None },
        cache: read.cache,
      }
    },
  }
}

fn last_passes_over(
  c0: tables::Cache,
  keys: List<Bytes>,
) -> StoreRead<List<Option<LastPass>>> / {abort.raise} = {
  let records = keys.fold(
    { value: [], cache: c0 },
    |accumulator: StoreRead<List<Option<tables::PassRecord>>>, key: Bytes| {
      let got = tables::pass_record(accumulator.cache, key);
      { value: accumulator.value.push(got.value), cache: got.cache }
    },
  );
  let eras = records.value.fold(
    { value: Map::new(), cache: records.cache },
    |accumulator: StoreRead<Map<Bytes, Option<RecordedGraph>>>, recorded_pass: Option<tables::PassRecord>|
      match recorded_pass {
        Some(p) -> if accumulator.value.contains(p.era) { accumulator } else {
          let got = snapshot_over(accumulator.cache, p.era);
          { value: accumulator.value.insert(p.era, got.value), cache: got.cache }
        },
        None -> accumulator,
      },
  );
  {
    value: records.value.map(|recorded_pass: Option<tables::PassRecord>|
      match recorded_pass {
        None -> None,
        Some(p) -> match eras.value.get(p.era) {
          Some(Some(g)) -> match recorded_reachable_hashes(g, p.walk_start, p.case) {
            Some(reachable_hashes) -> Some({ test: p.test_hash, reachable: reachable_hashes }),
            None -> None,
          },
          _ -> None,
        },
      }),
    cache: eras.cache,
  }
}

fn read_texts(
  c0: tables::Cache,
  hashes: List<Bytes>,
) -> StoreRead<List<Option<Bytes>>> / {abort.raise} =
  hashes.fold({ value: [], cache: c0 }, |accumulator: StoreRead<List<Option<Bytes>>>, h: Bytes| {
    let got = tables::text(accumulator.cache, h);
    { value: accumulator.value.push(got.value), cache: got.cache }
  })

pub fn unstored_in(cache: tables::Cache, hashes: List<Bytes>) -> List<Bytes> / {abort.raise} =
  hashes.filter(|h: Bytes| !tables::has_text(cache, h))

pub fn store_pass(
  c0: tables::Cache,
  texts: List<{ hash: Bytes, text: Bytes }>,
  modules: List<ModuleHashes>,
  snapshot: List<Bytes>,
) -> tables::Cache / {abort.raise} = {
  let with_texts = texts.fold(c0, |c: tables::Cache, t: { hash: Bytes, text: Bytes }|
    tables::put_text(c, t.hash, t.text));
  let with_records = modules.fold(with_texts, |c: tables::Cache, m: ModuleHashes|
    if tables::has_module_record(c, m.record) { c }
    else { tables::put_module_record(c, module_record(m.cached)) });
  if snapshot.len() == 0 { with_records }
  else { tables::put_snapshot(with_records, snapshot.sort()) }
}

pub fn snapshot_digest_of(records: List<Bytes>) -> Bytes = tables::snapshot_digest(records.sort())

pub fn put_update(
  c0: tables::Cache,
  f: StoreUpdate,
  seen: List<Bytes>,
) -> tables::Cache / {abort.raise} = {
  let c1 = f.code_passes.fold(
    f.passes.fold(c0, |c: tables::Cache, p: Pass| {
      let store_state = tables::pass_trace(c, p.key);
      if store_state.value == Some(p.trace) { store_state.cache }
      else { tables::put_passed(store_state.cache, p.key, p.trace) }
    }),
    |c: tables::Cache, p: Pass| {
      let store_state = tables::code_pass_trace(c, p.key);
      if store_state.value == Some(p.trace) { store_state.cache }
      else { tables::put_passed_code(store_state.cache, p.key, p.trace) }
    },
  );
  let c2 = f.records.fold(c1, |c: tables::Cache, e: { key: Bytes, record: PassRecord }|
    tables::put_code_record(
      tables::put_pass_record(c, e.key, {
        test_hash: e.record.test,
        era: e.record.era,
        walk_start: e.record.start,
        case: e.record.case,
        passes: e.record.passes,
      }),
      e.key,
      e.record.codes,
    ));
  seen.fold(c2, |c: tables::Cache, hash: Bytes|
    if tables::knows_definition(c, hash) { c } else { tables::observe_definition(c, hash) })
}

fn flush_update<[r]>(
  cache: tables::Cache,
  f: StoreUpdate,
  seen: List<Bytes>,
) -> tables::Cache / {fs.read[r], fs.write[r], abort.raise} =
  tables::flush_cache[r](put_update(cache, f, seen))

fn without_warnings(k: OpenStore) -> OpenStore =
  { ..k, cache: { ..k.cache, store: { ..k.cache.store, warnings: [] } } }

fn cache_warnings(cache: tables::Cache) -> List<Diagnostic> =
  project_store::diagnostics_of(tables::warnings(cache))

pub fn with_result_cache<a | e>(
  opened_store: Option<OpenStore>,
  go: () -> a / {result_cache.open_warnings, result_cache.passes, result_cache.code_passes, result_cache.known, result_cache.baselines, result_cache.texts, result_cache.unstored, result_cache.has_records, result_cache.history, result_cache.store_results, result_cache.listings, result_cache.keep_listings | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs] | e} =
  handle {
    go()
  } with {
    var store_state = opened_store,
    result_cache.open_warnings() -> match store_state {
      None -> [],
      Some(k) -> {
        store_state = Some(without_warnings(k));
        cache_warnings(k.cache)
      },
    },
    result_cache.passes(keys) -> match store_state {
      None -> keys.map(|key: Bytes| None),
      Some(k) -> {
        let o = read_pass_traces(k.cache, keys);
        store_state = Some({ ..k, cache: o.cache });
        o.value
      },
    },
    result_cache.code_passes(keys) -> match store_state {
      None -> keys.map(|key: Bytes| None),
      Some(k) -> {
        let o = code_passes_over(k.cache, keys);
        store_state = Some({ ..k, cache: o.cache });
        o.value
      },
    },
    result_cache.known(hashes) -> match store_state {
      None -> hashes.map(|h: Bytes| false),
      Some(k) -> hashes.map(|h: Bytes| tables::knows_definition(k.cache, h)),
    },
    result_cache.baselines(keys) -> match store_state {
      None -> keys.map(|key: Bytes| None),
      Some(k) -> {
        let o = last_passes_over(k.cache, keys);
        store_state = Some({ ..k, cache: o.cache });
        o.value
      },
    },
    result_cache.texts(hashes) -> match store_state {
      None -> hashes.map(|h: Bytes| None),
      Some(k) -> {
        let o = read_texts(k.cache, hashes);
        store_state = Some({ ..k, cache: o.cache });
        o.value
      },
    },
    result_cache.unstored(hashes) -> match store_state {
      None -> [],
      Some(k) -> unstored_in(k.cache, hashes),
    },
    result_cache.has_records(records) -> match store_state {
      None -> records.map(|r: Bytes| true),
      Some(k) -> records.map(|r: Bytes| tables::has_module_record(k.cache, r)),
    },
    result_cache.history(texts, modules, snapshot) -> match store_state {
      None -> (),
      Some(k) -> {
        store_state = Some({ ..k, cache: store_pass(k.cache, texts, modules, snapshot) });
      },
    },
    result_cache.store_results(f, seen) -> match store_state {
      None -> { unflushed: None, warnings: [] },
      Some(k) -> {
        let c = if k.place.label == "cwd" { flush_update[cwd](k.cache, f, seen) }
        else { flush_update[abs](k.cache, f, seen) };
        store_state = Some(without_warnings({ ..k, cache: c }));
        { unflushed: None, warnings: cache_warnings(c) }
      },
    },
    result_cache.listings(requests) -> match store_state {
      None -> requests.map(|r: ListingRequest| None),
      Some(k) -> {
        let o = listings_over(k.cache, requests);
        store_state = Some({ ..k, cache: o.cache });
        o.value
      },
    },
    result_cache.keep_listings(listed) -> match store_state {
      None -> (),
      Some(k) -> {
        store_state = Some({
          ..k,
          cache: listed.fold(k.cache, |c: tables::Cache, l: CasesListed|
            tables::put_case_listing(c, l.test, {
              listing: l.listing,
              cases: bin::encode(l.cases, bin::list_bin(listed_case_bin())),
            })),
        });
      },
    },
  }

fn listings_over(
  c0: tables::Cache,
  requests: List<ListingRequest>,
) -> StoreRead<List<Option<List<ListedCase>>>> / {abort.raise} =
  requests.fold(
    { value: [], cache: c0 },
    |read: StoreRead<List<Option<List<ListedCase>>>>, r: ListingRequest| {
      let got = tables::case_listing(read.cache, r.test);
      let cases = match got.value {
        Some(l) -> if l.listing != r.listing { None } else {
          match bin::decode(l.cases, bin::list_bin(listed_case_bin())) {
            Ok(listed) -> Some(listed),
            Err(_) -> None,
          }
        },
        None -> None,
      };
      { value: read.value.push(cases), cache: got.cache }
    },
  )

fn cached_over(cache: tables::Cache, keys: List<String>) -> List<Option<Bytes>> / {abort.raise} =
  keys.map(|key: String| tables::evidence(cache, Bytes::of_hex(key)).value)

fn cached_of(
  opened_store: Option<OpenStore>,
  keys: List<String>,
) -> List<Option<Bytes>> / {abort.raise} =
  match opened_store { None -> keys.map(|k: String| None), Some(k) -> cached_over(k.cache, keys) }

type StoreWrite = { store: Option<OpenStore>, diagnostics: List<Diagnostic> }

fn after_write(k: OpenStore, cache: tables::Cache) -> StoreWrite =
  {
    store: Some({ ..k, cache: { ..cache, store: { ..cache.store, warnings: [] } } }),
    diagnostics: project_store::diagnostics_of(tables::warnings(cache)),
  }

fn flushed(
  k: OpenStore,
  cache: tables::Cache,
) -> StoreWrite / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], abort.raise} =
  after_write(k, if k.place.label == "cwd" { tables::flush_cache[cwd](cache) }
  else { tables::flush_cache[abs](cache) })

fn record_evidence(
  opened_store: Option<OpenStore>,
  entries: List<{ key: String, evidence: Bytes }>,
) -> StoreWrite / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], abort.raise} =
  match opened_store {
    None -> { store: None, diagnostics: [] },
    Some(k) ->
      flushed(
        k,
        entries.fold(k.cache, |cache: tables::Cache, e: { key: String, evidence: Bytes }|
          tables::put_evidence(cache, Bytes::of_hex(e.key), e.evidence)),
      ),
  }

fn claims_of(
  opened_store: Option<OpenStore>,
  module: Bytes,
  identity: Bytes,
) -> Option<Bytes> / {abort.raise} =
  match opened_store {
    None -> None,
    Some(k) -> match tables::module_claims(k.cache, module).value {
      Some(c) -> if c.identity == identity { Some(c.claims) } else { None },
      None -> None,
    },
  }

fn record_claims(
  opened_store: Option<OpenStore>,
  entries: List<ClaimsEntry>,
) -> StoreWrite / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], abort.raise} =
  match opened_store {
    None -> { store: None, diagnostics: [] },
    Some(k) ->
      flushed(
        k,
        entries.fold(k.cache, |cache: tables::Cache, e: ClaimsEntry|
          tables::put_module_claims(cache, e.module, {
            identity: e.identity,
            claims: e.claims,
            evidence: e.evidence,
          })),
      ),
  }

fn baselines_over(
  cache: tables::Cache,
  names: List<String>,
) -> List<{ name: String, record: ClaimSnapshot }> / {abort.raise} =
  names.fold([], |accumulator: List<{ name: String, record: ClaimSnapshot }>, name: String|
    match tables::review(cache, Bytes::of_string(name)).value {
      None -> accumulator,
      Some(rv) ->
        accumulator.push({
          name: name,
          record: { definition_hash: rv.definition.hex_of(), specs: rv.specs.map(Bytes::hex_of) },
        }),
    })

fn baselines_of(
  opened_store: Option<OpenStore>,
  names: List<String>,
) -> List<{ name: String, record: ClaimSnapshot }> / {abort.raise} =
  match opened_store { None -> [], Some(k) -> baselines_over(k.cache, names) }

fn accepted_of(
  opened_store: Option<OpenStore>,
  records: List<{ name: String, record: ClaimSnapshot }>,
) -> { store: Option<OpenStore>, accepted: AcceptResult } / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], abort.raise} =
  match opened_store {
    None -> { store: None, accepted: { definitions: records.len(), stored: false, warnings: [] } },
    Some(k) -> {
      let w = flushed(
        k,
        records.fold(k.cache, |cache: tables::Cache, r: { name: String, record: ClaimSnapshot }|
          tables::put_review(cache, Bytes::of_string(r.name), {
            definition: Bytes::of_hex(r.record.definition_hash),
            specs: r.record.specs.map(Bytes::of_hex),
          })),
      );
      {
        store: w.store,
        accepted: {
          definitions: records.len(),
          stored: !w.diagnostics.fold(false, |hit: Bool, diagnostic: Diagnostic|
            hit || diagnostic.code == b"W0601"),
          warnings: w.diagnostics,
        },
      }
    },
  }

pub fn with_evidence<a | e>(
  opened_store: Option<OpenStore>,
  go: () -> a / {proof_store.cached, proof_store.record, proof_store.module_claims, proof_store.record_claims | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs] | e} =
  handle {
    go()
  } with {
    var store_state = opened_store,
    proof_store.cached(keys) -> cached_of(store_state, keys),
    proof_store.record(entries) -> {
      let w = record_evidence(store_state, entries);
      store_state = w.store;
      w.diagnostics
    },
    proof_store.module_claims(module, identity) -> claims_of(store_state, module, identity),
    proof_store.record_claims(entries) -> {
      let w = record_claims(store_state, entries);
      store_state = w.store;
      w.diagnostics
    },
  }

pub fn with_review<a | e>(
  opened_store: Option<OpenStore>,
  go: () -> a / {proof_store.cached, proof_store.record, proof_store.module_claims, proof_store.record_claims, proof_store.baselines, proof_store.accepted | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs] | e} =
  handle {
    go()
  } with {
    var store_state = opened_store,
    proof_store.cached(keys) -> cached_of(store_state, keys),
    proof_store.record(entries) -> {
      let w = record_evidence(store_state, entries);
      store_state = w.store;
      w.diagnostics
    },
    proof_store.module_claims(module, identity) -> claims_of(store_state, module, identity),
    proof_store.record_claims(entries) -> {
      let w = record_claims(store_state, entries);
      store_state = w.store;
      w.diagnostics
    },
    proof_store.baselines(names) -> baselines_of(store_state, names),
    proof_store.accepted(records) -> {
      let a = accepted_of(store_state, records);
      store_state = a.store;
      a.accepted
    },
  }

fn hashed(s: String) -> Bytes = blake3(Bytes::of_string(s))

fn fixed(name: Bytes, edges: List<NodeRef>) -> CachedNode =
  {
    name: name,
    declaration: false,
    hash: blake3(name),
    own: None,
    specs: [],
    spec_texts: [],
    spec_checks: [],
    contract: b"",
    check: b"",
    body: b"",
    edges: edges,
    effects: [],
    clauses: [],
  }

const a_module: ModuleHashes = {
  let fixing = {
    nodes: [fixed(b"m.f", [{ name: b"m.g", declaration: false }]), fixed(b"m.g", [])],
    tests: [
      {
        key: b"m.t",
        hash: hashed("t"),
        body: b"",
        text: b"",
        refs: [{ name: b"m.f", declaration: false }],
        runs: [],
        listing: [],
        listing_hash: b"",
      },
    ],
    laws: [],
  };
  { record: record_digest(module_record(fixing)), cached: fixing }
}

const an_update: StoreUpdate =
  {
    passes: [{ key: hashed("t key"), trace: b"file\tcwd\ta\td\n" }],
    code_passes: [{ key: hashed("t code"), trace: b"" }],
    records: [
      {
        key: b"m.t",
        record: {
          test: hashed("t"),
          era: snapshot_digest_of([a_module.record]),
          start: b"m.t",
          case: false,
          passes: [hashed("t key")],
          codes: [hashed("t code")],
        },
      },
    ],
  }

const some_stamps: tables::Stamps = { runtime_digest: "runtime", code: "code" }

const original_definition: { hash: Bytes, text: Bytes } =
  { hash: blake3(b"m.f"), text: b"fn f() -> Int = 1\n" }

fn read_back(
  f: StoreUpdate,
  seen: List<Bytes>,
) -> { passes: List<Option<Bytes>>, codes: List<Option<Bytes>>, moved: List<Option<Bytes>>, seen: List<Bool>, baselines: List<Option<LastPass>>, texts: List<Option<Bytes>> } / {abort.raise} =
  run_in_memory(mem_empty(), || {
    let c0 = store_pass(
      tables::open_cache[mem]("cache", some_stamps),
      [original_definition],
      [a_module],
      [a_module.record],
    );
    let c1 = tables::flush_cache[mem](put_update(c0, f, seen));
    let r = tables::open_cache[mem]("cache", some_stamps);
    let moved = tables::open_cache[mem]("cache", { ..some_stamps, runtime_digest: "another" });
    {
      passes: read_pass_traces(r, [hashed("t key"), hashed("other")]).value,
      codes: code_passes_over(r, [hashed("t code"), hashed("t key")]).value,
      moved: code_passes_over(moved, [hashed("t code")]).value.fold(
        read_pass_traces(moved, [hashed("t key")]).value,
        |accumulator: List<Option<Bytes>>, o: Option<Bytes>| accumulator.push(o),
      ),
      seen: [hashed("f"), hashed("g")].map(|h: Bytes| tables::knows_definition(r, h)),
      baselines: last_passes_over(r, [b"m.t", b"m.u"]).value,
      texts: read_texts(r, [original_definition.hash, hashed("missing")]).value,
    }
  }).value

test "a stored run reads back its passing results, baselines and whether each test ran, and each baseline reads back with its definition text" {
  let back = read_back(an_update, [hashed("f")]);
  assert_eq(back.passes, [Some(b"file\tcwd\ta\td\n"), None]);
  assert_eq(back.codes, [Some(b""), None]);
  assert_eq(back.moved, [None, Some(b"")]);
  assert_eq(back.seen, [true, false]);
  assert_eq(back.baselines, [
    Some({
      test: hashed("t"),
      reachable: {
        functions: Map::new().insert(b"m.f", blake3(b"m.f")).insert(b"m.g", blake3(b"m.g")),
        declarations: Map::new(),
      },
    }),
    None,
  ]);
  assert_eq(back.texts, [Some(original_definition.text), None])
}

test "a baseline is not returned when the module record it was made from is missing from the cache" {
  let back = run_in_memory(mem_empty(), || {
    let c = put_update(tables::open_cache[mem]("cache", some_stamps), an_update, []);
    last_passes_over(tables::put_snapshot(c, [a_module.record]), [b"m.t"]).value
  }).value;
  assert_eq(back, [None])
}

test "opening the cache under a different runtime digest drops the stored baselines and passing results but still returns the definition texts" {
  let back = run_in_memory(mem_empty(), || {
    let recorded = store_pass(
      tables::open_cache[mem]("cache", some_stamps),
      [original_definition],
      [a_module],
      [a_module.record],
    );
    let c1 = tables::flush_cache[mem](put_update(recorded, an_update, []));
    let moved = tables::open_cache[mem]("cache", { ..some_stamps, runtime_digest: "another" });
    {
      baselines: last_passes_over(moved, [b"m.t"]).value,
      texts: read_texts(moved, [original_definition.hash]).value,
    }
  }).value;
  assert_eq(back.baselines, [None]);
  assert_eq(back.texts, [Some(original_definition.text)])
}

test "storing a run with no results reads back no passing results, no ran-test flags and no baselines" {
  let back = read_back({ passes: [], code_passes: [], records: [] }, []);
  assert_eq(back.passes, [None, None]);
  assert_eq(back.seen, [false, false]);
  assert_eq(back.baselines, [None, None])
}
