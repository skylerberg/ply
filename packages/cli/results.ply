//! What a command keeps in the store between runs and reads back: for `ply test` the keys passes are
//! filed under, each test's baseline, the definitions seen pass, and the bodies and interfaces a
//! failure's diagnosis reads; for `ply prove` and `ply review` evidence and accepted baselines.

import std.bin
import std.fs
import std.fs (fs, mem_empty)
import std.hash (blake3)
import std.random (entropy)
import std.time (time)
import std.bytes
import std.prelude_source
import compiler.front.checking.world (Answering)
import compiler.front.checking.groups (queries)
import compiler.front.published (FiledBody, FiledDef, body_encoding, filed_bodies)
import compiler.store.hash.forms (Fixed, ModuleHashed, ModuleRecord, NodeRef, RecordedGraph,
                                  module_record, record_digest, recorded_graph, recorded_reach)
import compiler.front.seam (Analysed)
import compiler.store.hash (body_key)
import compiler.store.hash.encoding (hex)
import compiler.load (analysed, answers_afresh, assembled, deriving_nothing, prepared)
import compiler.check.resolve.tables (Diag)
import compiler.unit (shipped)
import loads
import paths
import store.tables
import store.twin (on_twin)
import store.engine (Warning)
import testing.conclude (Filing, PassRecord, ReachedHashes)
import testing.select (Pass)
import claims (proofs, Accepted)
import env (env)
import proof.obligation (Record)
import tester (ledger, LastPass, Filed)
import sources
import std.path (below_root)

/// The upstream `PLY_CACHE_UPSTREAM` names, as an absolute path read under `abs`.
pub type Upstream = { root: String, publish: Bool }

/// The store a run reads its results from and files them in.
pub type OpenStore = { place: loads::Place, cache: tables::Cache }

/// The store a command reads and files in: none under `--no-cache`, which also ignores the upstream.
pub fn store_for(
  paths: List<paths::Resolved>,
  no_cache: Bool,
) -> Option<OpenStore> / {fs.read[cwd], fs.read[abs], env.var[sys], env.pwd[sys], fs.read_file[shipped], abort.raise} =
  if no_cache { None } else { Some(open_store(paths, upstream_of_env(), loads::shipped_stamps())) }

fn upstream_of_env() -> Option<Upstream> / {env.var[sys], env.pwd[sys]} =
  match env.var[sys]("PLY_CACHE_UPSTREAM") {
    None -> None,
    Some(root) -> if root == "" { None } else {
      {
        let absolute = if root.starts_with("/") { root } else { env.pwd[sys]() ++ "/" ++ root };
        Some({ root: absolute, publish: env.var[sys]("PLY_CACHE_UPSTREAM_READONLY") == None })
      }
    },
  }

pub fn open_store(
  paths: List<paths::Resolved>,
  upstream: Option<Upstream>,
  stamps: tables::Stamps,
) -> OpenStore / {fs.read[cwd], fs.read[abs], abort.raise} = {
  let place = loads::place_of(paths, stamps);
  let c = if place.label == "cwd" { tables::open_cache[cwd](place.dir, stamps) }
  else { tables::open_cache[abs](place.dir, stamps) };
  {
    place: place,
    cache: match upstream {
      Some(up) -> tables::with_upstream[abs](c, below_root(up.root), up.publish),
      None -> c,
    },
  }
}

// --- The tests' -------------------------------------------------------------

/// An answer read from the store, and the store as reading it left it.
type StoreRead<a> = { value: a, cache: tables::Cache }

fn passes_over<[r], [u]>(
  c0: tables::Cache,
  keys: List<Bytes>,
) -> StoreRead<List<Option<Bytes>>> / {fs.read[r], fs.read[u], abort.raise} =
  keys.fold({ value: [], cache: c0 }, |acc: StoreRead<List<Option<Bytes>>>, key: Bytes| {
    let got = tables::pass_trace[r, u](acc.cache, key);
    { value: acc.value.push(got.value), cache: got.cache }
  })

fn code_passes_over<[r], [u]>(
  c0: tables::Cache,
  keys: List<Bytes>,
) -> StoreRead<List<Option<Bytes>>> / {fs.read[r], fs.read[u], abort.raise} =
  keys.fold({ value: [], cache: c0 }, |acc: StoreRead<List<Option<Bytes>>>, key: Bytes| {
    let got = tables::code_pass_trace[r, u](acc.cache, key);
    { value: acc.value.push(got.value), cache: got.cache }
  })

/// The module records of the era `digest`, read as one graph: none where the store lacks the era or
/// any record of it, since a walk over part of a program would answer a closure short of the one
/// the test passed against.
fn era_over<[r]>(
  c0: tables::Cache,
  digest: Bytes,
) -> StoreRead<Option<RecordedGraph>> / {fs.read[r], abort.raise} = {
  let got = tables::era[r](c0, digest);
  match got.value {
    None -> { value: None, cache: got.cache },
    Some(modules) -> {
      let read = modules.fold(
        { value: Some([]), cache: got.cache },
        |acc: StoreRead<Option<List<ModuleRecord>>>, m: Bytes|
          match acc.value {
            None -> acc,
            Some(rs) -> {
              let got = tables::module_record[r](acc.cache, m);
              {
                value: match got.value { Some(x) -> Some(rs.push(x)), None -> None },
                cache: got.cache,
              }
            },
          },
      );
      {
        value: match read.value { Some(rs) -> Some(recorded_graph(rs)), None -> None },
        cache: read.cache,
      }
    },
  }
}

/// Each test's baseline, walked from its pass record over the era it passed in; each era is read
/// once however many tests passed in it.
fn last_passes_over<[r]>(
  c0: tables::Cache,
  keys: List<Bytes>,
) -> StoreRead<List<Option<LastPass>>> / {fs.read[r], abort.raise} = {
  let records = keys.fold(
    { value: [], cache: c0 },
    |acc: StoreRead<List<Option<tables::PassRecord>>>, key: Bytes| {
      let got = tables::pass_record[r](acc.cache, key);
      { value: acc.value.push(got.value), cache: got.cache }
    },
  );
  let eras = records.value.fold(
    { value: Map::new(), cache: records.cache },
    |acc: StoreRead<Map<Bytes, Option<RecordedGraph>>>, rec: Option<tables::PassRecord>|
      match rec {
        Some(p) -> if acc.value.contains(p.era) { acc } else {
          let got = era_over[r](acc.cache, p.era);
          { value: acc.value.insert(p.era, got.value), cache: got.cache }
        },
        None -> acc,
      },
  );
  {
    value: records.value.map(|rec: Option<tables::PassRecord>|
      match rec {
        None -> None,
        Some(p) -> match eras.value.get(p.era) {
          Some(Some(g)) -> match recorded_reach(g, p.of, p.case) {
            Some(reached) -> Some({ test: p.test_hash, reached: reached }),
            None -> None,
          },
          _ -> None,
        },
      }),
    cache: eras.cache,
  }
}

/// A body filed under another encoding is not one this compiler reads.
fn bodies_over<[r]>(
  c0: tables::Cache,
  hashes: List<Bytes>,
) -> StoreRead<List<Option<Bytes>>> / {fs.read[r], abort.raise} =
  hashes.fold({ value: [], cache: c0 }, |acc: StoreRead<List<Option<Bytes>>>, h: Bytes| {
    let got = tables::body[r](acc.cache, h);
    {
      value: acc.value.push(match got.value {
        Some(b) -> if b.encoding == body_encoding() { Some(b.bytes) } else { None },
        None -> None,
      }),
      cache: got.cache,
    }
  })

fn interfaces_over<[r]>(
  c0: tables::Cache,
  hashes: List<Bytes>,
) -> StoreRead<List<Option<Bytes>>> / {fs.read[r], abort.raise} =
  hashes.fold({ value: [], cache: c0 }, |acc: StoreRead<List<Option<Bytes>>>, h: Bytes| {
    let got = tables::def_of[r](acc.cache, h);
    { value: acc.value.push(got.value), cache: got.cache }
  })

/// Of `reached`, each function the store holds no interface or no body of, and each declaration it
/// holds no body of, read from the index alone.
pub fn unfiled_in(cache: tables::Cache, reached: ReachedHashes) -> ReachedHashes / {abort.raise} =
  {
    fns: reached.fns.filter(|h: Bytes|
      !tables::holds_def(cache, h) || !tables::holds_body(cache, h)),
    decls: reached.decls.filter(|h: Bytes| !tables::holds_body(cache, h)),
  }

/// What a pass ran, each interface and body under its hash, and the era of `modules`: its record of
/// each module, made only for one the store does not hold.
pub fn kept_over<[r]>(
  c0: tables::Cache,
  defs: List<FiledDef>,
  bodies: List<FiledBody>,
  modules: List<ModuleHashed>,
) -> tables::Cache / {fs.read[r], abort.raise} = {
  let held = bodies.fold(
    defs.fold(c0, |c: tables::Cache, d: FiledDef| tables::put_def[r](c, d.hash, d.interface)),
    |c: tables::Cache, b: FiledBody|
      tables::put_body[r](c, b.hash, { encoding: body_encoding(), bytes: b.body }),
  );
  if modules.len() == 0 { held } else {
    let recorded = modules.fold(held, |c: tables::Cache, m: ModuleHashed|
      if tables::holds_module_record(c, m.record) { c }
      else { tables::put_module_record(c, module_record(m.fixing)) });
    tables::put_era(recorded, era_of(modules))
  }
}

/// The digests an era of `modules` lists: in one order whatever order a load asked them in.
fn era_of(modules: List<ModuleHashed>) -> List<Bytes> =
  modules.map(|m: ModuleHashed| m.record).sort()

/// What the era of `modules`, one load's, is filed under, which its passes' records name.
pub fn era_digest_of(modules: List<ModuleHashed>) -> Bytes = tables::era_digest(era_of(modules))

/// What a filing puts, before anything is flushed: a pass already kept on the same trace, or a
/// sighting already kept, is not put again.
pub fn noted<[r], [u]>(
  c0: tables::Cache,
  f: Filing,
) -> tables::Cache / {fs.read[r], fs.read[u], abort.raise} = {
  let c1 = f.codes.fold(
    f.passes.fold(c0, |c: tables::Cache, p: Pass| {
      let held = tables::pass_trace[r, u](c, p.key);
      if held.value == Some(p.trace) { held.cache }
      else { tables::put_passed(held.cache, p.key, p.trace) }
    }),
    |c: tables::Cache, p: Pass| {
      let held = tables::code_pass_trace[r, u](c, p.key);
      if held.value == Some(p.trace) { held.cache }
      else { tables::put_passed_code(held.cache, p.key, p.trace) }
    },
  );
  let c2 = f.records.fold(c1, |c: tables::Cache, e: { key: Bytes, record: PassRecord }|
    tables::put_pass_record[r](c, e.key, {
      test_hash: e.record.test,
      era: e.record.era,
      of: e.record.of,
      case: e.record.case,
    }));
  f.seen.fold(c2, |c: tables::Cache, hash: Bytes|
    if tables::knows_definition(c, hash) { c } else { tables::observe_definition(c, hash) })
}

fn filed_over<[r]>(
  cache: tables::Cache,
  f: Filing,
) -> tables::Cache / {fs.read[r], fs.write[r], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  tables::flush_shared[r, abs](noted[r, abs](cache, f))

/// The store with what it had to say taken.
fn quiet(k: OpenStore) -> OpenStore =
  { ..k, cache: { ..k.cache, store: { ..k.cache.store, warnings: [] } } }

fn said(cache: tables::Cache) -> List<Diag> = loads::diags_of(tables::warnings(cache))

/// `ply test`'s reads and writes, over the store a run opened, each said once.
pub fn with_ledger<a | e>(
  kept: Option<OpenStore>,
  go: () -> a / {ledger.opened, ledger.passes, ledger.code_passes, ledger.seen, ledger.baselines, ledger.bodies, ledger.interfaces, ledger.unfiled, ledger.history, ledger.filed | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms | e} =
  handle {
    go()
  } with {
    var held = kept,
    ledger.opened() -> match held {
      None -> [],
      Some(k) -> {
        held = Some(quiet(k));
        said(k.cache)
      },
    },
    ledger.passes(keys) -> match held {
      None -> keys.map(|key: Bytes| None),
      Some(k) -> {
        let o = if k.place.label == "cwd" { passes_over[cwd, abs](k.cache, keys) }
        else { passes_over[abs, abs](k.cache, keys) };
        held = Some({ ..k, cache: o.cache });
        o.value
      },
    },
    ledger.code_passes(keys) -> match held {
      None -> keys.map(|key: Bytes| None),
      Some(k) -> {
        let o = if k.place.label == "cwd" { code_passes_over[cwd, abs](k.cache, keys) }
        else { code_passes_over[abs, abs](k.cache, keys) };
        held = Some({ ..k, cache: o.cache });
        o.value
      },
    },
    ledger.seen(hashes) -> match held {
      None -> hashes.map(|h: Bytes| false),
      Some(k) -> hashes.map(|h: Bytes| tables::knows_definition(k.cache, h)),
    },
    ledger.baselines(keys) -> match held {
      None -> keys.map(|key: Bytes| None),
      Some(k) -> {
        let o = if k.place.label == "cwd" { last_passes_over[cwd](k.cache, keys) }
        else { last_passes_over[abs](k.cache, keys) };
        held = Some({ ..k, cache: o.cache });
        o.value
      },
    },
    ledger.bodies(hashes) -> match held {
      None -> hashes.map(|h: Bytes| None),
      Some(k) -> {
        let o = if k.place.label == "cwd" { bodies_over[cwd](k.cache, hashes) }
        else { bodies_over[abs](k.cache, hashes) };
        held = Some({ ..k, cache: o.cache });
        o.value
      },
    },
    ledger.interfaces(hashes) -> match held {
      None -> hashes.map(|h: Bytes| None),
      Some(k) -> {
        let o = if k.place.label == "cwd" { interfaces_over[cwd](k.cache, hashes) }
        else { interfaces_over[abs](k.cache, hashes) };
        held = Some({ ..k, cache: o.cache });
        o.value
      },
    },
    ledger.unfiled(reached) -> match held {
      None -> { fns: [], decls: [] },
      Some(k) -> unfiled_in(k.cache, reached),
    },
    ledger.history(defs, bodies, modules) -> match held {
      None -> (),
      Some(k) -> {
        let c = if k.place.label == "cwd" { kept_over[cwd](k.cache, defs, bodies, modules) }
        else { kept_over[abs](k.cache, defs, bodies, modules) };
        held = Some({ ..k, cache: c });
      },
    },
    ledger.filed(f) -> match held {
      None -> { unflushed: None, warnings: [] },
      Some(k) -> {
        let c = if k.place.label == "cwd" { filed_over[cwd](k.cache, f) }
        else { filed_over[abs](k.cache, f) };
        held = Some(quiet({ ..k, cache: c }));
        { unflushed: None, warnings: said(c) }
      },
    },
  }

// --- The prover's -----------------------------------------------------------

fn cached_over<[r]>(
  cache: tables::Cache,
  keys: List<String>,
) -> List<Option<Bytes>> / {fs.read[r], fs.read[abs], abort.raise} =
  keys.map(|key: String| tables::evidence_shared[r, abs](cache, Bytes::of_hex(key)).value)

fn cached_of(
  kept: Option<OpenStore>,
  keys: List<String>,
) -> List<Option<Bytes>> / {fs.read[cwd], fs.read[abs], abort.raise} =
  match kept {
    None -> keys.map(|k: String| None),
    Some(k) -> if k.place.label == "cwd" { cached_over[cwd](k.cache, keys) }
    else { cached_over[abs](k.cache, keys) },
  }

type StoreWrite = { kept: Option<OpenStore>, diags: List<Diag> }

/// The store after a write, its warnings said once.
fn wrote(k: OpenStore, cache: tables::Cache) -> StoreWrite =
  {
    kept: Some({ ..k, cache: { ..cache, store: { ..cache.store, warnings: [] } } }),
    diags: loads::diags_of(tables::warnings(cache)),
  }

fn flushed(
  k: OpenStore,
  cache: tables::Cache,
) -> StoreWrite / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  wrote(k, if k.place.label == "cwd" { tables::flush_shared[cwd, abs](cache) }
  else { tables::flush_shared[abs, abs](cache) })

fn recorded(
  kept: Option<OpenStore>,
  entries: List<{ key: String, evidence: Bytes }>,
) -> StoreWrite / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  match kept {
    None -> { kept: None, diags: [] },
    Some(k) ->
      flushed(
        k,
        entries.fold(k.cache, |cache: tables::Cache, e: { key: String, evidence: Bytes }|
          tables::put_evidence(cache, Bytes::of_hex(e.key), e.evidence)),
      ),
  }

fn baselines_over<[r]>(
  cache: tables::Cache,
  names: List<String>,
) -> List<{ name: String, record: Record }> / {fs.read[r], abort.raise} =
  names.fold([], |acc: List<{ name: String, record: Record }>, name: String|
    match tables::review[r](cache, Bytes::of_string(name)).value {
      None -> acc,
      Some(rv) ->
        acc.push({
          name: name,
          record: { def_hash: rv.def.hex_of(), specs: rv.specs.map(Bytes::hex_of) },
        }),
    })

fn baselines_of(
  kept: Option<OpenStore>,
  names: List<String>,
) -> List<{ name: String, record: Record }> / {fs.read[cwd], fs.read[abs], abort.raise} =
  match kept {
    None -> [],
    Some(k) -> if k.place.label == "cwd" { baselines_over[cwd](k.cache, names) }
    else { baselines_over[abs](k.cache, names) },
  }

fn accepted_of(
  kept: Option<OpenStore>,
  records: List<{ name: String, record: Record }>,
) -> { kept: Option<OpenStore>, accepted: Accepted } / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  match kept {
    None -> { kept: None, accepted: { definitions: records.len(), stored: false, warnings: [] } },
    Some(k) -> {
      let w = flushed(
        k,
        records.fold(k.cache, |cache: tables::Cache, r: { name: String, record: Record }|
          tables::put_review(cache, Bytes::of_string(r.name), {
            def: Bytes::of_hex(r.record.def_hash),
            specs: r.record.specs.map(Bytes::of_hex),
          })),
      );
      {
        kept: w.kept,
        accepted: {
          definitions: records.len(),
          stored: !w.diags.fold(false, |hit: Bool, diag: Diag| hit || diag.code == b"W0601"),
          warnings: w.diags,
        },
      }
    },
  }

/// The prover's reads and writes, over the store a run opened: evidence by key, its own or the
/// upstream's.
pub fn with_evidence<a | e>(
  kept: Option<OpenStore>,
  go: () -> a / {proofs.cached, proofs.record | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms | e} =
  handle {
    go()
  } with {
    var held = kept,
    proofs.cached(keys) -> cached_of(held, keys),
    proofs.record(entries) -> {
      let w = recorded(held, entries);
      held = w.kept;
      w.diags
    },
  }

/// The same, and the baseline a reader accepted for each definition.
pub fn with_review<a | e>(
  kept: Option<OpenStore>,
  go: () -> a / {proofs.cached, proofs.record, proofs.baselines, proofs.accepted | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms | e} =
  handle {
    go()
  } with {
    var held = kept,
    proofs.cached(keys) -> cached_of(held, keys),
    proofs.record(entries) -> {
      let w = recorded(held, entries);
      held = w.kept;
      w.diags
    },
    proofs.baselines(names) -> baselines_of(held, names),
    proofs.accepted(records) -> {
      let a = accepted_of(held, records);
      held = a.kept;
      a.accepted
    },
  }

// --- Tests ------------------------------------------------------------------

fn hashed(s: String) -> Bytes = blake3(Bytes::of_string(s))

/// A body that is its own component, filed under the hash of its payload.
fn solo(payload: String) -> { hash: Bytes, body: Bytes } / {abort.raise} = {
  let body = byte_of_int(0) ++ b"\x00\x00\x00\x00" ++ Bytes::of_string(payload);
  { hash: match body_key(body) { Some(k) -> k, None -> b"" }, body: body }
}

/// A function as hashing fixes it, under the hash its name keys, referencing `edges`.
fn fixed(name: Bytes, edges: List<NodeRef>) -> Fixed =
  {
    name: name,
    decl: false,
    hash: blake3(name),
    own: None,
    specs: [],
    spec_texts: [],
    spec_checks: [],
    contract: b"",
    check: b"",
    body: b"",
    edges: edges,
    effects: [],
    clauses: [],
  }

/// One module whose test `m.t` reaches `m.f`, which reaches `m.g`.
fn a_module() -> ModuleHashed / {abort.raise} = {
  let fixing = {
    nodes: [fixed(b"m.f", [{ name: b"m.g", decl: false }]), fixed(b"m.g", [])],
    tests: [
      {
        key: b"m.t",
        hash: hashed("t"),
        body: b"",
        text: b"",
        refs: [{ name: b"m.f", decl: false }],
        runs: [],
        listing: [],
      },
    ],
    laws: [],
  };
  { record: record_digest(module_record(fixing)), fixing: fixing }
}

fn a_filing() -> Filing / {abort.raise} =
  {
    passes: [{ key: hashed("t key"), trace: b"file\tcwd\ta\td\n" }],
    codes: [{ key: hashed("t code"), trace: b"" }],
    records: [
      {
        key: b"m.t",
        record: { test: hashed("t"), era: era_digest_of([a_module()]), of: b"m.t", case: false },
      },
    ],
    seen: [hashed("f")],
    reached: { fns: [], decls: [] },
  }

fn built() -> tables::Stamps = { runtime: "runtime", code: "code" }

/// What a later run reads back of a filing over the era of `a_module`, beside a body filed before
/// it, and what one whose runtime stamp moved reads of its code keys.
fn read_back(
  f: Filing,
) -> { passes: List<Option<Bytes>>, codes: List<Option<Bytes>>, moved: List<Option<Bytes>>, seen: List<Bool>, baselines: List<Option<LastPass>>, bodies: List<Option<Bytes>> } / {abort.raise} = {
  let b = solo("old f");
  on_twin(mem_empty(), || {
    let c0 = kept_over[mem](
      tables::open_cache[mem]("cache", built()),
      [],
      [{ hash: b.hash, body: b.body }],
      [a_module()],
    );
    let c1 = tables::flush_cache[mem](noted[mem, mem](c0, f));
    let r = tables::open_cache[mem]("cache", built());
    let moved = tables::open_cache[mem]("cache", { ..built(), runtime: "another" });
    {
      passes: passes_over[mem, mem](r, [hashed("t key"), hashed("other")]).value,
      codes: code_passes_over[mem, mem](r, [hashed("t code"), hashed("t key")]).value,
      moved: code_passes_over[mem, mem](moved, [hashed("t code")]).value.fold(
        passes_over[mem, mem](moved, [hashed("t key")]).value,
        |acc: List<Option<Bytes>>, o: Option<Bytes>| acc.push(o),
      ),
      seen: [hashed("f"), hashed("g")].map(|h: Bytes| tables::knows_definition(r, h)),
      baselines: last_passes_over[mem](r, [b"m.t", b"m.u"]).value,
      bodies: bodies_over[mem](r, [b.hash, hashed("missing")]).value,
    }
  }).value
}

test "a run's passes, baselines and sightings are kept, and a baseline is walked from its era" {
  let back = read_back(a_filing());
  assert_eq(back.passes, [Some(b"file\tcwd\ta\td\n"), None]);
  assert_eq(back.codes, [Some(b""), None]);
  // Another runtime stamp drops the passes keyed by test, and keeps the ones keyed by code.
  assert_eq(back.moved, [None, Some(b"")]);
  assert_eq(back.seen, [true, false]);
  assert_eq(back.baselines, [
    Some({
      test: hashed("t"),
      reached: {
        fns: Map::new().insert(b"m.f", blake3(b"m.f")).insert(b"m.g", blake3(b"m.g")),
        decls: Map::new(),
      },
    }),
    None,
  ]);
  assert_eq(back.bodies, [Some(solo("old f").body), None])
}

test "a baseline whose era lost a module record is no baseline" {
  let back = on_twin(mem_empty(), || {
    let c = noted[mem, mem](tables::open_cache[mem]("cache", built()), a_filing());
    // The era alone, its module's record never filed.
    last_passes_over[mem](tables::put_era(c, [a_module().record]), [b"m.t"]).value
  }).value;
  assert_eq(back, [None])
}

// Bodies outlive a build: what keeps an older build's from being read is that its baselines do not.
test "another build's baselines are dropped with its passes, and a body under another encoding is not read" {
  let mine = solo("f as this build stores it");
  let theirs = solo("f as another stored it");
  let back = on_twin(mem_empty(), || {
    let filed = tables::put_body[mem](
      kept_over[mem](
        tables::open_cache[mem]("cache", built()),
        [],
        [{ hash: mine.hash, body: mine.body }],
        [a_module()],
      ),
      theirs.hash,
      { encoding: body_encoding() + 1, bytes: theirs.body },
    );
    let c1 = tables::flush_cache[mem](noted[mem, mem](filed, a_filing()));
    let moved = tables::open_cache[mem]("cache", { ..built(), runtime: "another" });
    {
      baselines: last_passes_over[mem](moved, [b"m.t"]).value,
      bodies: bodies_over[mem](moved, [mine.hash, theirs.hash]).value,
    }
  }).value;
  assert_eq(back.baselines, [None]);
  assert_eq(back.bodies, [Some(mine.body), None])
}

test "a filing of nothing keeps nothing" {
  let back = read_back({
    passes: [],
    codes: [],
    records: [],
    seen: [],
    reached: { fns: [], decls: [] },
  });
  assert_eq(back.passes, [None, None]);
  assert_eq(back.seen, [false, false]);
  assert_eq(back.baselines, [None, None])
}

/// Calls on values: of a module's own type, and of a type another module declares, naming an
/// argument, where a check of the caller against its imports places that module first.
fn calling_on_values() -> List<{ path: String, body: Bytes }> =
  [
    {
      path: "p/low.ply",
      body: b"pub type T = | T(Int)\npub fn T::size(t: T) -> Int = match t { T(n) -> n }\npub fn T::scaled(t: T, by: Int = 2, plus: Int = 0) -> Int = t.size() * by + plus\n",
    },
    { path: "p/m.ply", body: b"import low\npub fn f(t: low::T) -> Int = t.scaled(plus: 3)\n" },
    {
      path: "p/solo.ply",
      body: b"pub type U = | U(Int)\nfn U::size(u: U) -> Int = match u { U(n) -> n }\npub fn g(u: U) -> Int = u.size()\n",
    },
  ]

test "a program filed read whole and filed from its modules' answers keeps one body under each hash" {
  let tree = fs::mem_of(calling_on_values());
  let listed = Bytes::concat_all(
    queries().map(
      |q: { name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {Answering, abort.raise} }|
        Bytes::concat_all([q.definition, b" ", hex(blake3(q.definition)), b"\n"]),
    ),
  );
  let filed = handle {
    match prepared[t]("p") {
      Err(_) -> panic("the program is read"),
      Ok(p) -> match ((
          deriving_nothing(|| assembled[t](p, answers_afresh[t](p), true)),
          analysed(p.own.files, Map::new()).out,
        )) {
        (Ok(c), Analysed(w)) -> { answered: filed_bodies(c.hashes), whole: filed_bodies(w.hashes) },
        _ -> panic("the program checks"),
      },
    }
  } with {
    fs.list_dir[t](path) -> fs::mem_list(tree, path),
    fs.kind[t](path) -> fs::mem_kind(tree, path),
    fs.read_file[t](path) -> fs::mem_read(tree, path),
    // Every toolchain ships `std.prelude`, which every module imports.
    shipped.names() -> ["std.prelude"],
    shipped.module(name) -> if name == "std.prelude" { Some(prelude_source::text()) } else { None },
    shipped.reached(view, pulled) -> (),
    shipped.answer(path, offset, len) -> None,
    shipped.definitions() -> listed,
    shipped.stamps() -> "",
    shipped.runtime() -> panic("the program names no library deriver"),
  };
  let hashes = |bodies: List<FiledBody>|
    bodies.fold(Map::new(), |acc: Map<Bytes, Bool>, b: FiledBody| acc.insert(b.hash, true)).keys();
  assert(filed.whole.len() > 0);
  assert_eq(hashes(filed.answered), hashes(filed.whole));
  let warned = on_twin(mem_empty(), || {
    let c = kept_over[mem](
      kept_over[mem](tables::open_cache[mem]("cache", built()), [], filed.answered, []),
      [],
      filed.whole,
      [],
    );
    tables::warnings(c).map(|w: Warning| w.message)
  }).value;
  assert_eq(warned, [])
}
