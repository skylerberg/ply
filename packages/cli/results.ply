pub type OpenStore = { place: project_store::StoreLocation, cache: tables::Cache }

pub fn store_for(
  paths: List<paths::ResolvedPath>,
) -> OpenStore / {databases.open, semantics.cached, fs.read[cwd], fs.read[abs], fs.read_file[shipped], abort.raise} =
  open_store(paths, project_store::shipped_stamps())

pub fn open_store(
  paths: List<paths::ResolvedPath>,
  stamps: tables::Stamps,
) -> OpenStore / {databases.open, fs.read[cwd], fs.read[abs], abort.raise} = {
  let place = project_store::store_location_of(paths, stamps);
  let database = project_store::database_place_of(place);
  let opening = databases.open(database);
  {
    place: place,
    cache: match database {
      InWorkingDirectory(_) -> tables::open_cache[cwd](opening, stamps),
      AtAbsolutePath(_) -> tables::open_cache[abs](opening, stamps),
    },
  }
}

type StoreRead<a> = { value: a, cache: tables::Cache }

fn read_pass_traces(
  c0: tables::Cache,
  keys: List<Bytes>,
) -> StoreRead<List<Option<Bytes>>> / {abort.raise} =
  keys.fold({ value: [], cache: c0 }, |accumulator: StoreRead<List<Option<Bytes>>>, key: Bytes| {
    let got = tables::pass_trace(accumulator.cache, key);
    { value: accumulator.value.push(got.value), cache: got.cache }
  })

fn code_passes_over(
  c0: tables::Cache,
  keys: List<Bytes>,
) -> StoreRead<List<Option<Bytes>>> / {abort.raise} =
  keys.fold({ value: [], cache: c0 }, |accumulator: StoreRead<List<Option<Bytes>>>, key: Bytes| {
    let got = tables::code_pass_trace(accumulator.cache, key);
    { value: accumulator.value.push(got.value), cache: got.cache }
  })

fn snapshot_over(
  c0: tables::Cache,
  digest: Bytes,
) -> StoreRead<Option<RecordedGraph>> / {abort.raise} = {
  let got = tables::snapshot(c0, digest);
  match got.value {
    None -> { value: None, cache: got.cache },
    Some(modules) -> {
      let read = modules.fold(
        { value: Some([]), cache: got.cache },
        |accumulator: StoreRead<Option<List<ModuleRecord>>>, m: Bytes|
          match accumulator.value {
            None -> accumulator,
            Some(rs) -> {
              let got = tables::module_record(accumulator.cache, m);
              {
                value: match got.value { Some(x) -> Some(rs.push(x)), None -> None },
                cache: got.cache,
              }
            },
          },
      );
      {
        value: match read.value { Some(rs) -> Some(recorded_graph(rs)), None -> None },
        cache: read.cache,
      }
    },
  }
}

fn last_passes_over(
  c0: tables::Cache,
  keys: List<Bytes>,
) -> StoreRead<List<Option<LastPass>>> / {abort.raise} = {
  let records = keys.fold(
    { value: [], cache: c0 },
    |accumulator: StoreRead<List<Option<tables::PassRecord>>>, key: Bytes| {
      let got = tables::pass_record(accumulator.cache, key);
      { value: accumulator.value.push(got.value), cache: got.cache }
    },
  );
  let eras = records.value.fold(
    { value: Map::new(), cache: records.cache },
    |accumulator: StoreRead<Map<Bytes, Option<RecordedGraph>>>, recorded_pass: Option<tables::PassRecord>|
      match recorded_pass {
        Some(p) -> if accumulator.value.contains(p.era) { accumulator } else {
          let got = snapshot_over(accumulator.cache, p.era);
          { value: accumulator.value.insert(p.era, got.value), cache: got.cache }
        },
        None -> accumulator,
      },
  );
  {
    value: records.value.map(|recorded_pass: Option<tables::PassRecord>|
      match recorded_pass {
        None -> None,
        Some(p) -> match eras.value.get(p.era) {
          Some(Some(g)) -> match recorded_reachable_hashes(g, p.walk_start, p.case) {
            Some(reachable_hashes) -> Some({ test: p.test_hash, reachable: reachable_hashes }),
            None -> None,
          },
          _ -> None,
        },
      }),
    cache: eras.cache,
  }
}

fn read_texts(
  c0: tables::Cache,
  hashes: List<Bytes>,
) -> StoreRead<List<Option<Bytes>>> / {abort.raise} =
  hashes.fold({ value: [], cache: c0 }, |accumulator: StoreRead<List<Option<Bytes>>>, h: Bytes| {
    let got = tables::text(accumulator.cache, h);
    { value: accumulator.value.push(got.value), cache: got.cache }
  })

pub fn unstored_in(cache: tables::Cache, hashes: List<Bytes>) -> List<Bytes> / {abort.raise} =
  hashes.filter(|h: Bytes| !tables::has_text(cache, h))

pub fn store_pass(
  c0: tables::Cache,
  texts: List<{ hash: Bytes, text: Bytes }>,
  modules: List<ModuleHashes>,
  snapshot: List<Bytes>,
) -> tables::Cache / {abort.raise} = {
  let with_texts = texts.fold(c0, |c: tables::Cache, t: { hash: Bytes, text: Bytes }|
    tables::put_text(c, t.hash, t.text));
  let with_records = modules.fold(with_texts, |c: tables::Cache, m: ModuleHashes|
    if tables::has_module_record(c, m.record) { c }
    else { tables::put_module_record(c, module_record(m.own)) });
  if snapshot.len() == 0 { with_records }
  else { tables::put_snapshot(with_records, snapshot.sort()) }
}

pub fn snapshot_digest_of(records: List<Bytes>) -> Bytes = tables::snapshot_digest(records.sort())

pub fn put_update(
  c0: tables::Cache,
  f: StoreUpdate,
  seen: List<Bytes>,
) -> tables::Cache / {abort.raise} = {
  let c1 = f.code_passes.fold(
    f.passes.fold(c0, |c: tables::Cache, p: Pass| {
      let store_state = tables::pass_trace(c, p.key);
      if store_state.value == Some(p.trace) { store_state.cache }
      else { tables::put_passed(store_state.cache, p.key, p.trace) }
    }),
    |c: tables::Cache, p: Pass| {
      let store_state = tables::code_pass_trace(c, p.key);
      if store_state.value == Some(p.trace) { store_state.cache }
      else { tables::put_passed_code(store_state.cache, p.key, p.trace) }
    },
  );
  let c2 = f.records.fold(c1, |c: tables::Cache, e: { key: Bytes, record: PassRecord }|
    tables::put_code_record(
      tables::put_pass_record(c, e.key, {
        test_hash: e.record.test,
        era: e.record.era,
        walk_start: e.record.start,
        case: e.record.case,
        passes: e.record.passes,
      }),
      e.key,
      e.record.codes,
    ));
  seen.fold(c2, |c: tables::Cache, hash: Bytes|
    if tables::knows_definition(c, hash) { c } else { tables::observe_definition(c, hash) })
}

fn flush_update<[r]>(
  cache: tables::Cache,
  f: StoreUpdate,
  seen: List<Bytes>,
) -> tables::Cache / {fs.read[r], fs.write[r], abort.raise} =
  tables::flush_cache[r](put_update(cache, f, seen))

fn without_warnings(k: OpenStore) -> OpenStore =
  { ..k, cache: { ..k.cache, store: { ..k.cache.store, warnings: [] } } }

fn cache_warnings(cache: tables::Cache) -> List<Diagnostic> =
  project_store::diagnostics_of(tables::warnings(cache))

type JournalHeader = { runtime_digest: String, code: String }

type JournalRow = { slot: Bytes, payload: Bytes }

type JournalMark = { key: Bytes, hash: Bytes }

type JournalRows = { key: Bytes, rows: List<JournalRow> }

type JournalEntry = | Began(JournalHeader) | Started(JournalMark) | Finished(JournalRows)

derive bin for JournalHeader
derive bin for JournalRow
derive bin for JournalMark
derive bin for JournalRows
derive bin for JournalEntry

type Journal = { label: String, path: String, base: tables::Cache }

fn journal_of(k: OpenStore) -> Journal =
  { label: k.place.label, path: k.place.dir ++ "/test-journal", base: k.cache }

fn header_of(stamps: tables::Stamps) -> JournalHeader =
  { runtime_digest: stamps.runtime_digest, code: stamps.code }

fn framed(entry: JournalEntry) -> Bytes / {abort.raise} =
  bin::put_bytes(b"", bin::encode(entry, journal_entry_bin()))

fn journal_entries(bytes: Bytes) -> List<JournalEntry> / {abort.raise} =
  iterate({ at: 0, found: [] }, bytes.len() + 1, |s: { at: Int, found: List<JournalEntry> }|
    if s.at >= bytes.len() { Stop(s.found) } else {
      match bin::take_bytes(bytes, s.at) {
        Err(_) -> Stop(s.found),
        Ok(frame) -> match bin::decode(frame.value, journal_entry_bin()) {
          Err(_) -> Stop(s.found),
          Ok(entry) -> Continue({ at: frame.at, found: s.found.push(entry) }),
        },
      }
    })

type Recovery = { rows: List<JournalRow>, interrupted: List<StartedTest> }

fn recovery_of(entries: List<JournalEntry>, stamps: tables::Stamps) -> Recovery =
  match entries.at(0) {
    Some(Began(header)) -> if header != header_of(stamps) { { rows: [], interrupted: [] } } else {
      let finished = entries.fold(Set::empty(), |found: Set<Bytes>, e: JournalEntry|
        match e { Finished(f) -> found.insert(f.key), _ -> found });
      entries.fold({ rows: [], interrupted: [] }, |r: Recovery, e: JournalEntry|
        match e {
          Finished(f) -> { ..r, rows: r.rows.concat(f.rows) },
          Started(m) -> if finished.contains(m.key)
              || r.interrupted.any(|t: StartedTest| t.key == m.key) { r }
          else { { ..r, interrupted: r.interrupted.push({ key: m.key, hash: m.hash }) } },
          Began(_) -> r,
        })
    },
    _ -> { rows: [], interrupted: [] },
  }

fn read_journal<[r]>(j: Journal) -> List<JournalEntry> / {fs.read[r], abort.raise} =
  match fs.read_file[r](j.path) { Some(bytes) -> journal_entries(bytes), None -> [] }

fn begun_journal<[r]>(
  k: OpenStore,
  j: Journal,
) -> { store: OpenStore, interrupted: List<StartedTest> } / {fs.read[r], fs.write[r], abort.raise} = {
  let found = recovery_of(read_journal[r](j), k.cache.stamps);
  let cache = if found.rows.len() == 0 { k.cache }
  else { tables::flush_cache[r](tables::with_written_rows(k.cache, found.rows)) };
  let _ = fs.create_dir[r](k.place.dir);
  let _ = fs.write_file[r](j.path, framed(Began(header_of(k.cache.stamps))));
  { store: { ..k, cache: cache }, interrupted: found.interrupted }
}

fn appended(
  journal: Journal,
  entry: JournalEntry,
) -> Unit / {fs.write[cwd], fs.write[abs], abort.raise} = {
  let _ = if journal.label == "cwd" { fs.append[cwd](journal.path, framed(entry)) }
  else { fs.append[abs](journal.path, framed(entry)) };
  ()
}

fn ended_journal(journal: Journal) -> Unit / {fs.write[cwd], fs.write[abs]} = {
  let _ = if journal.label == "cwd" { fs.remove[cwd](journal.path) }
  else { fs.remove[abs](journal.path) };
  ()
}

fn finished_rows(journal: Journal, update: StoreUpdate) -> List<JournalRow> / {abort.raise} =
  tables::rows_written(journal.base, |c: tables::Cache| put_update(c, update, []))

pub fn with_result_cache<a | e>(
  opened_store: OpenStore,
  go: () -> a / {result_cache.open_warnings, result_cache.passes, result_cache.code_passes, result_cache.known, result_cache.baselines, result_cache.texts, result_cache.unstored, result_cache.has_records, result_cache.history, result_cache.store_results, result_cache.listings, result_cache.keep_listings, result_cache.interrupted, result_cache.started, result_cache.finished | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs] | e} = {
  let begun = if opened_store.place.label == "cwd" {
    begun_journal[cwd](opened_store, journal_of(opened_store))
  } else { begun_journal[abs](opened_store, journal_of(opened_store)) };
  let journal = journal_of(begun.store);
  let result = journaled(begun.store, begun.interrupted, journal, go);
  ended_journal(journal);
  result
}

fn journaled<a | e>(
  opened_store: OpenStore,
  interrupted: List<StartedTest>,
  journal: Journal,
  go: () -> a / {result_cache.open_warnings, result_cache.passes, result_cache.code_passes, result_cache.known, result_cache.baselines, result_cache.texts, result_cache.unstored, result_cache.has_records, result_cache.history, result_cache.store_results, result_cache.listings, result_cache.keep_listings, result_cache.interrupted, result_cache.started, result_cache.finished | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs] | e} =
  handle {
    go()
  } with {
    var store_state = opened_store,
    result_cache.interrupted() -> interrupted,
    result_cache.started(running) ->
      appended(journal, Started({ key: running.key, hash: running.hash })),
    result_cache.finished(key, update) ->
      appended(journal, Finished({ key: key, rows: finished_rows(journal, update) })),
    result_cache.open_warnings() -> {
      let warnings = cache_warnings(store_state.cache);
      store_state = without_warnings(store_state);
      warnings
    },
    result_cache.passes(keys) -> {
      let o = read_pass_traces(store_state.cache, keys);
      store_state = { ..store_state, cache: o.cache };
      o.value
    },
    result_cache.code_passes(keys) -> {
      let o = code_passes_over(store_state.cache, keys);
      store_state = { ..store_state, cache: o.cache };
      o.value
    },
    result_cache.known(hashes) ->
      hashes.map(|h: Bytes| tables::knows_definition(store_state.cache, h)),
    result_cache.baselines(keys) -> {
      let o = last_passes_over(store_state.cache, keys);
      store_state = { ..store_state, cache: o.cache };
      o.value
    },
    result_cache.texts(hashes) -> {
      let o = read_texts(store_state.cache, hashes);
      store_state = { ..store_state, cache: o.cache };
      o.value
    },
    result_cache.unstored(hashes) -> unstored_in(store_state.cache, hashes),
    result_cache.has_records(records) ->
      records.map(|r: Bytes| tables::has_module_record(store_state.cache, r)),
    result_cache.history(texts, modules, snapshot) -> {
      store_state = {
        ..store_state,
        cache: store_pass(store_state.cache, texts, modules, snapshot),
      };
    },
    result_cache.store_results(f, seen) -> {
      let c = if store_state.place.label == "cwd" { flush_update[cwd](store_state.cache, f, seen) }
      else { flush_update[abs](store_state.cache, f, seen) };
      store_state = without_warnings({ ..store_state, cache: c });
      cache_warnings(c)
    },
    result_cache.listings(requests) -> {
      let o = listings_over(store_state.cache, requests);
      store_state = { ..store_state, cache: o.cache };
      o.value
    },
    result_cache.keep_listings(listed) -> {
      store_state = {
        ..store_state,
        cache: listed.fold(store_state.cache, |c: tables::Cache, l: CasesListed|
          tables::put_case_listing(c, l.test, {
            listing: l.listing,
            cases: bin::encode(l.cases, bin::list_bin(listed_case_bin())),
          })),
      };
    },
  }

fn listings_over(
  c0: tables::Cache,
  requests: List<ListingRequest>,
) -> StoreRead<List<Option<List<ListedCase>>>> / {abort.raise} =
  requests.fold(
    { value: [], cache: c0 },
    |read: StoreRead<List<Option<List<ListedCase>>>>, r: ListingRequest| {
      let got = tables::case_listing(read.cache, r.test);
      let cases = match got.value {
        Some(l) -> if l.listing != r.listing { None } else {
          match bin::decode(l.cases, bin::list_bin(listed_case_bin())) {
            Ok(listed) -> Some(listed),
            Err(_) -> None,
          }
        },
        None -> None,
      };
      { value: read.value.push(cases), cache: got.cache }
    },
  )

fn cached_over(cache: tables::Cache, keys: List<String>) -> List<Option<Bytes>> / {abort.raise} =
  keys.map(|key: String| tables::evidence(cache, Bytes::of_hex(key)).value)

type StoreWrite = { store: OpenStore, diagnostics: List<Diagnostic> }

fn after_write(k: OpenStore, cache: tables::Cache) -> StoreWrite =
  {
    store: { ..k, cache: { ..cache, store: { ..cache.store, warnings: [] } } },
    diagnostics: project_store::diagnostics_of(tables::warnings(cache)),
  }

fn flushed(
  k: OpenStore,
  cache: tables::Cache,
) -> StoreWrite / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], abort.raise} =
  after_write(k, if k.place.label == "cwd" { tables::flush_cache[cwd](cache) }
  else { tables::flush_cache[abs](cache) })

fn record_evidence(
  k: OpenStore,
  entries: List<{ key: String, evidence: Bytes }>,
) -> StoreWrite / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], abort.raise} =
  flushed(
    k,
    entries.fold(k.cache, |cache: tables::Cache, e: { key: String, evidence: Bytes }|
      tables::put_evidence(cache, Bytes::of_hex(e.key), e.evidence)),
  )

fn claims_of(k: OpenStore, module: Bytes, identity: Bytes) -> Option<Bytes> / {abort.raise} =
  match tables::module_claims(k.cache, module).value {
    Some(c) -> if c.identity == identity { Some(c.claims) } else { None },
    None -> None,
  }

fn record_claims(
  k: OpenStore,
  entries: List<ClaimsEntry>,
) -> StoreWrite / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], abort.raise} =
  flushed(
    k,
    entries.fold(k.cache, |cache: tables::Cache, e: ClaimsEntry|
      tables::put_module_claims(cache, e.module, {
        identity: e.identity,
        claims: e.claims,
        evidence: e.evidence,
      })),
  )

fn baselines_of(
  cache: tables::Cache,
  names: List<String>,
) -> List<{ name: String, record: ClaimSnapshot }> / {abort.raise} =
  names.fold([], |accumulator: List<{ name: String, record: ClaimSnapshot }>, name: String|
    match tables::review(cache, Bytes::of_string(name)).value {
      None -> accumulator,
      Some(rv) ->
        accumulator.push({
          name: name,
          record: { definition_hash: rv.definition.hex_of(), specs: rv.specs.map(Bytes::hex_of) },
        }),
    })

fn accepted_of(
  k: OpenStore,
  records: List<{ name: String, record: ClaimSnapshot }>,
) -> { store: OpenStore, accepted: AcceptResult } / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], abort.raise} = {
  let w = flushed(
    k,
    records.fold(k.cache, |cache: tables::Cache, r: { name: String, record: ClaimSnapshot }|
      tables::put_review(cache, Bytes::of_string(r.name), {
        definition: Bytes::of_hex(r.record.definition_hash),
        specs: r.record.specs.map(Bytes::of_hex),
      })),
  );
  {
    store: w.store,
    accepted: {
      definitions: records.len(),
      stored: !w.diagnostics.fold(false, |hit: Bool, diagnostic: Diagnostic|
        hit || diagnostic.code == cache_unreadable_code),
      warnings: w.diagnostics,
    },
  }
}

pub fn with_evidence<a | e>(
  opened_store: OpenStore,
  go: () -> a / {proof_store.cached, proof_store.record, proof_store.module_claims, proof_store.record_claims | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs] | e} =
  handle {
    go()
  } with {
    var store_state = opened_store,
    proof_store.cached(keys) -> cached_over(store_state.cache, keys),
    proof_store.record(entries) -> {
      let w = record_evidence(store_state, entries);
      store_state = w.store;
      w.diagnostics
    },
    proof_store.module_claims(module, identity) -> claims_of(store_state, module, identity),
    proof_store.record_claims(entries) -> {
      let w = record_claims(store_state, entries);
      store_state = w.store;
      w.diagnostics
    },
  }

pub fn with_review<a | e>(
  opened_store: OpenStore,
  go: () -> a / {proof_store.cached, proof_store.record, proof_store.module_claims, proof_store.record_claims, proof_store.baselines, proof_store.accepted | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs] | e} =
  handle {
    go()
  } with {
    var store_state = opened_store,
    proof_store.cached(keys) -> cached_over(store_state.cache, keys),
    proof_store.record(entries) -> {
      let w = record_evidence(store_state, entries);
      store_state = w.store;
      w.diagnostics
    },
    proof_store.module_claims(module, identity) -> claims_of(store_state, module, identity),
    proof_store.record_claims(entries) -> {
      let w = record_claims(store_state, entries);
      store_state = w.store;
      w.diagnostics
    },
    proof_store.baselines(names) -> baselines_of(store_state.cache, names),
    proof_store.accepted(records) -> {
      let a = accepted_of(store_state, records);
      store_state = a.store;
      a.accepted
    },
  }

fn hashed(s: String) -> Bytes = blake3(Bytes::of_string(s))

fn defined(name: Bytes, uses: List<NodeRef>) -> DefinitionHash =
  {
    name: name,
    kind: HeldValue,
    hash: blake3(name),
    body: b"",
    contract: blake3(name),
    clauses: [],
    uses: uses,
    clause_uses: [],
    contract_uses: [],
  }

const a_module: ModuleHashes = {
  let own = {
    definitions: [defined(b"m.f", [{ name: b"m.g", kind: HeldValue }]), defined(b"m.g", [])],
    tests: [
      {
        key: b"m.t",
        hash: hashed("t"),
        body: b"",
        uses: [{ name: b"m.f", kind: HeldValue }],
        listing: None,
      },
    ],
    laws: [],
  };
  { record: record_digest(module_record(own)), own: own }
}

const an_update: StoreUpdate =
  {
    passes: [{ key: hashed("t key"), trace: b"file\tcwd\ta\td\n" }],
    code_passes: [{ key: hashed("t code"), trace: b"" }],
    records: [
      {
        key: b"m.t",
        record: {
          test: hashed("t"),
          era: snapshot_digest_of([a_module.record]),
          start: b"m.t",
          case: false,
          passes: [hashed("t key")],
          codes: [hashed("t code")],
        },
      },
    ],
  }

const some_stamps: tables::Stamps = { runtime_digest: "runtime", code: "code" }

fn cache_database() -> Opening / {fs.write[mem]} = open_database[mem](database_in("cache"))

const original_definition: { hash: Bytes, text: Bytes } =
  { hash: blake3(b"m.f"), text: b"fn f() -> Int = 1\n" }

fn read_back(
  f: StoreUpdate,
  seen: List<Bytes>,
) -> { passes: List<Option<Bytes>>, codes: List<Option<Bytes>>, moved: List<Option<Bytes>>, seen: List<Bool>, baselines: List<Option<LastPass>>, texts: List<Option<Bytes>> } / {abort.raise} =
  run_in_memory(mem_empty(), || {
    let c0 = store_pass(
      tables::open_cache[mem](cache_database(), some_stamps),
      [original_definition],
      [a_module],
      [a_module.record],
    );
    let c1 = tables::flush_cache[mem](put_update(c0, f, seen));
    let r = tables::open_cache[mem](cache_database(), some_stamps);
    let moved = tables::open_cache[mem](cache_database(), {
      ..some_stamps,
      runtime_digest: "another",
    });
    {
      passes: read_pass_traces(r, [hashed("t key"), hashed("other")]).value,
      codes: code_passes_over(r, [hashed("t code"), hashed("t key")]).value,
      moved: code_passes_over(moved, [hashed("t code")]).value.fold(
        read_pass_traces(moved, [hashed("t key")]).value,
        |accumulator: List<Option<Bytes>>, o: Option<Bytes>| accumulator.push(o),
      ),
      seen: [blake3(b"m.f"), hashed("g")].map(|h: Bytes| tables::knows_definition(r, h)),
      baselines: last_passes_over(r, [b"m.t", b"m.u"]).value,
      texts: read_texts(r, [original_definition.hash, hashed("missing")]).value,
    }
  }).value

test "a stored run reads back its passing results, baselines and whether each test ran, and each baseline reads back with its definition text" {
  let back = read_back(an_update, [blake3(b"m.f")]);
  assert_eq(back.passes, [Some(b"file\tcwd\ta\td\n"), None]);
  assert_eq(back.codes, [Some(b""), None]);
  assert_eq(back.moved, [None, Some(b"")]);
  assert_eq(back.seen, [true, false]);
  assert_eq(back.baselines, [
    Some({
      test: hashed("t"),
      reachable: {
        functions: Map::new().insert(b"m.f", blake3(b"m.f")).insert(b"m.g", blake3(b"m.g")),
        declarations: Map::new(),
      },
    }),
    None,
  ]);
  assert_eq(back.texts, [Some(original_definition.text), None])
}

test "a baseline is not returned when the module record it was made from is missing from the cache" {
  let back = run_in_memory(mem_empty(), || {
    let c = put_update(tables::open_cache[mem](cache_database(), some_stamps), an_update, []);
    last_passes_over(tables::put_snapshot(c, [a_module.record]), [b"m.t"]).value
  }).value;
  assert_eq(back, [None])
}

test "opening the cache under a different runtime digest drops the stored baselines and passing results but still returns the definition texts" {
  let back = run_in_memory(mem_empty(), || {
    let recorded = store_pass(
      tables::open_cache[mem](cache_database(), some_stamps),
      [original_definition],
      [a_module],
      [a_module.record],
    );
    let c1 = tables::flush_cache[mem](put_update(recorded, an_update, []));
    let moved = tables::open_cache[mem](cache_database(), {
      ..some_stamps,
      runtime_digest: "another",
    });
    {
      baselines: last_passes_over(moved, [b"m.t"]).value,
      texts: read_texts(moved, [original_definition.hash]).value,
    }
  }).value;
  assert_eq(back.baselines, [None]);
  assert_eq(back.texts, [Some(original_definition.text)])
}

test "a journal names the tests it saw start but not finish, returns the rows of the finished ones, ignores a torn last entry, and counts for nothing under other stamps" {
  let row = { slot: b"\x05" ++ hashed("pass"), payload: b"" };
  let journal = Bytes::concat_all([
    framed(Began(header_of(some_stamps))),
    framed(Started({ key: b"m.passes", hash: b"p" })),
    framed(Started({ key: b"m.crashes", hash: b"c" })),
    framed(Finished({ key: b"m.passes", rows: [row] })),
  ]);
  let torn = framed(Finished({ key: b"m.crashes", rows: [] }));
  let read = recovery_of(journal_entries(journal ++ torn.slice(0, torn.len() - 1)), some_stamps);
  assert_eq(read.interrupted, [{ key: b"m.crashes", hash: b"c" }]);
  assert_eq(read.rows, [row]);
  assert_eq(recovery_of(journal_entries(journal), { ..some_stamps, code: "another" }), {
    rows: [],
    interrupted: [],
  })
}

test "a run after a crash stores the passes its journal finished, returns the tests it left running, and starts a new journal" {
  let back = run_in_memory(mem_empty(), || {
    let opened = {
      place: { label: "mem", dir: "cache", root: "", stamps: some_stamps },
      cache: tables::open_cache[mem](cache_database(), some_stamps),
    };
    let j = journal_of(opened);
    let rows = tables::rows_written(opened.cache, |c: tables::Cache| put_update(c, an_update, []));
    let _ = fs.create_dir[mem]("cache");
    let _ = fs.write_file[mem](
      j.path,
      Bytes::concat_all([
        framed(Began(header_of(some_stamps))),
        framed(Started({ key: b"m.t", hash: b"" })),
        framed(Finished({ key: b"m.t", rows: rows })),
        framed(Started({ key: b"m.crashes", hash: b"c" })),
      ]),
    );
    let begun = begun_journal[mem](opened, j);
    {
      interrupted: begun.interrupted,
      passes: read_pass_traces(tables::open_cache[mem](cache_database(), some_stamps), [
        hashed("t key"),
      ]).value,
      left: recovery_of(read_journal[mem](j), some_stamps),
    }
  }).value;
  assert_eq(back.interrupted, [{ key: b"m.crashes", hash: b"c" }]);
  assert_eq(back.passes, [Some(b"file\tcwd\ta\td\n")]);
  assert_eq(back.left, { rows: [], interrupted: [] })
}

test "storing a run with no results reads back no passing results, no ran-test flags and no baselines" {
  let back = read_back({ passes: [], code_passes: [], records: [] }, []);
  assert_eq(back.passes, [None, None]);
  assert_eq(back.seen, [false, false]);
  assert_eq(back.baselines, [None, None])
}
