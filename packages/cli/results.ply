import std.bin
import std.fs (fs, mem_empty)
import std.hash (blake3)
import std.random (entropy)
import std.time (time)
import std.bytes
import compiler.store.hash.forms (CachedNode, ModuleHashes, ModuleRecord, NodeRef, RecordedGraph,
                                  module_record, record_digest, recorded_graph,
                                  recorded_reachable_hashes)
import compiler.check.resolve.tables (Diagnostic)
import project_store
import paths
import store.tables
import store.fake (run_in_memory)
import testing.conclude (Filing, PassRecord)
import testing.select (Pass)
import claims (proof_store, AcceptResult)
import std.env (env)
import proof.obligation (ClaimSnapshot)
import tester (result_cache, LastPass, StoreResult)
import sources
import std.path (strip_root)
import semantics (semantics)

pub type Upstream = { root: String, publish: Bool }

pub type OpenStore = { place: project_store::StoreLocation, cache: tables::Cache }

pub fn store_for(
  paths: List<paths::ResolvedPath>,
  no_cache: Bool,
) -> Option<OpenStore> / {semantics.cached, fs.read[cwd], fs.read[abs], env.variable, env.working_directory, fs.read_file[shipped], abort.raise} =
  if no_cache { None }
  else { Some(open_store(paths, upstream_of_env(), project_store::shipped_stamps())) }

fn upstream_of_env() -> Option<Upstream> / {env.variable, env.working_directory} =
  match env.variable("PLY_CACHE_UPSTREAM") {
    None -> None,
    Some(root) -> if root == "" { None } else {
      {
        let absolute = if root.starts_with("/") { root }
        else { env.working_directory() ++ "/" ++ root };
        Some({ root: absolute, publish: env.variable("PLY_CACHE_UPSTREAM_READONLY") == None })
      }
    },
  }

pub fn open_store(
  paths: List<paths::ResolvedPath>,
  upstream: Option<Upstream>,
  stamps: tables::Stamps,
) -> OpenStore / {fs.read[cwd], fs.read[abs], abort.raise} = {
  let place = project_store::store_location_of(paths, stamps);
  let c = if place.label == "cwd" { tables::open_cache[cwd](place.dir, stamps) }
  else { tables::open_cache[abs](place.dir, stamps) };
  {
    place: place,
    cache: match upstream {
      Some(up) -> tables::with_upstream[abs](c, strip_root(up.root), up.publish),
      None -> c,
    },
  }
}

type StoreRead<a> = { value: a, cache: tables::Cache }

fn read_pass_traces<[r], [u]>(
  c0: tables::Cache,
  keys: List<Bytes>,
) -> StoreRead<List<Option<Bytes>>> / {fs.read[r], fs.read[u], abort.raise} =
  keys.fold({ value: [], cache: c0 }, |accumulator: StoreRead<List<Option<Bytes>>>, key: Bytes| {
    let got = tables::pass_trace[r, u](accumulator.cache, key);
    { value: accumulator.value.push(got.value), cache: got.cache }
  })

fn code_passes_over<[r], [u]>(
  c0: tables::Cache,
  keys: List<Bytes>,
) -> StoreRead<List<Option<Bytes>>> / {fs.read[r], fs.read[u], abort.raise} =
  keys.fold({ value: [], cache: c0 }, |accumulator: StoreRead<List<Option<Bytes>>>, key: Bytes| {
    let got = tables::code_pass_trace[r, u](accumulator.cache, key);
    { value: accumulator.value.push(got.value), cache: got.cache }
  })

fn snapshot_over<[r]>(
  c0: tables::Cache,
  digest: Bytes,
) -> StoreRead<Option<RecordedGraph>> / {fs.read[r], abort.raise} = {
  let got = tables::snapshot[r](c0, digest);
  match got.value {
    None -> { value: None, cache: got.cache },
    Some(modules) -> {
      let read = modules.fold(
        { value: Some([]), cache: got.cache },
        |accumulator: StoreRead<Option<List<ModuleRecord>>>, m: Bytes|
          match accumulator.value {
            None -> accumulator,
            Some(rs) -> {
              let got = tables::module_record[r](accumulator.cache, m);
              {
                value: match got.value { Some(x) -> Some(rs.push(x)), None -> None },
                cache: got.cache,
              }
            },
          },
      );
      {
        value: match read.value { Some(rs) -> Some(recorded_graph(rs)), None -> None },
        cache: read.cache,
      }
    },
  }
}

fn last_passes_over<[r]>(
  c0: tables::Cache,
  keys: List<Bytes>,
) -> StoreRead<List<Option<LastPass>>> / {fs.read[r], abort.raise} = {
  let records = keys.fold(
    { value: [], cache: c0 },
    |accumulator: StoreRead<List<Option<tables::PassRecord>>>, key: Bytes| {
      let got = tables::pass_record[r](accumulator.cache, key);
      { value: accumulator.value.push(got.value), cache: got.cache }
    },
  );
  let eras = records.value.fold(
    { value: Map::new(), cache: records.cache },
    |accumulator: StoreRead<Map<Bytes, Option<RecordedGraph>>>, recorded_pass: Option<tables::PassRecord>|
      match recorded_pass {
        Some(p) -> if accumulator.value.contains(p.era) { accumulator } else {
          let got = snapshot_over[r](accumulator.cache, p.era);
          { value: accumulator.value.insert(p.era, got.value), cache: got.cache }
        },
        None -> accumulator,
      },
  );
  {
    value: records.value.map(|recorded_pass: Option<tables::PassRecord>|
      match recorded_pass {
        None -> None,
        Some(p) -> match eras.value.get(p.era) {
          Some(Some(g)) -> match recorded_reachable_hashes(g, p.walk_start, p.case) {
            Some(reachable_hashes) -> Some({ test: p.test_hash, reachable: reachable_hashes }),
            None -> None,
          },
          _ -> None,
        },
      }),
    cache: eras.cache,
  }
}

fn read_texts<[r]>(
  c0: tables::Cache,
  hashes: List<Bytes>,
) -> StoreRead<List<Option<Bytes>>> / {fs.read[r], abort.raise} =
  hashes.fold({ value: [], cache: c0 }, |accumulator: StoreRead<List<Option<Bytes>>>, h: Bytes| {
    let got = tables::text[r](accumulator.cache, h);
    { value: accumulator.value.push(got.value), cache: got.cache }
  })

pub fn unstored_in(cache: tables::Cache, hashes: List<Bytes>) -> List<Bytes> / {abort.raise} =
  hashes.filter(|h: Bytes| !tables::has_text(cache, h))

pub fn store_pass(
  c0: tables::Cache,
  texts: List<{ hash: Bytes, text: Bytes }>,
  modules: List<ModuleHashes>,
) -> tables::Cache / {abort.raise} = {
  let store_state = texts.fold(c0, |c: tables::Cache, t: { hash: Bytes, text: Bytes }|
    tables::put_text(c, t.hash, t.text));
  if modules.len() == 0 { store_state } else {
    let record_evidence = modules.fold(store_state, |c: tables::Cache, m: ModuleHashes|
      if tables::has_module_record(c, m.record) { c }
      else { tables::put_module_record(c, module_record(m.cached)) });
    tables::put_snapshot(record_evidence, snapshot_of(modules))
  }
}

fn snapshot_of(modules: List<ModuleHashes>) -> List<Bytes> =
  modules.map(|m: ModuleHashes| m.record).sort()

pub fn snapshot_digest_of(modules: List<ModuleHashes>) -> Bytes =
  tables::snapshot_digest(snapshot_of(modules))

pub fn put_filing<[r], [u]>(
  c0: tables::Cache,
  f: Filing,
) -> tables::Cache / {fs.read[r], fs.read[u], abort.raise} = {
  let c1 = f.code_passes.fold(
    f.passes.fold(c0, |c: tables::Cache, p: Pass| {
      let store_state = tables::pass_trace[r, u](c, p.key);
      if store_state.value == Some(p.trace) { store_state.cache }
      else { tables::put_passed(store_state.cache, p.key, p.trace) }
    }),
    |c: tables::Cache, p: Pass| {
      let store_state = tables::code_pass_trace[r, u](c, p.key);
      if store_state.value == Some(p.trace) { store_state.cache }
      else { tables::put_passed_code(store_state.cache, p.key, p.trace) }
    },
  );
  let c2 = f.records.fold(c1, |c: tables::Cache, e: { key: Bytes, record: PassRecord }|
    tables::put_pass_record[r](c, e.key, {
      test_hash: e.record.test,
      era: e.record.era,
      walk_start: e.record.start,
      case: e.record.case,
    }));
  f.seen.fold(c2, |c: tables::Cache, hash: Bytes|
    if tables::knows_definition(c, hash) { c } else { tables::observe_definition(c, hash) })
}

fn flush_filing<[r]>(
  cache: tables::Cache,
  f: Filing,
) -> tables::Cache / {fs.read[r], fs.write[r], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  tables::flush_shared[r, abs](put_filing[r, abs](cache, f))

fn without_warnings(k: OpenStore) -> OpenStore =
  { ..k, cache: { ..k.cache, store: { ..k.cache.store, warnings: [] } } }

fn cache_warnings(cache: tables::Cache) -> List<Diagnostic> =
  project_store::diagnostics_of(tables::warnings(cache))

pub fn with_result_cache<a | e>(
  opened_store: Option<OpenStore>,
  go: () -> a / {result_cache.open_warnings, result_cache.passes, result_cache.code_passes, result_cache.known, result_cache.baselines, result_cache.texts, result_cache.unstored, result_cache.history, result_cache.store_filing | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms | e} =
  handle {
    go()
  } with {
    var store_state = opened_store,
    result_cache.open_warnings() -> match store_state {
      None -> [],
      Some(k) -> {
        store_state = Some(without_warnings(k));
        cache_warnings(k.cache)
      },
    },
    result_cache.passes(keys) -> match store_state {
      None -> keys.map(|key: Bytes| None),
      Some(k) -> {
        let o = if k.place.label == "cwd" { read_pass_traces[cwd, abs](k.cache, keys) }
        else { read_pass_traces[abs, abs](k.cache, keys) };
        store_state = Some({ ..k, cache: o.cache });
        o.value
      },
    },
    result_cache.code_passes(keys) -> match store_state {
      None -> keys.map(|key: Bytes| None),
      Some(k) -> {
        let o = if k.place.label == "cwd" { code_passes_over[cwd, abs](k.cache, keys) }
        else { code_passes_over[abs, abs](k.cache, keys) };
        store_state = Some({ ..k, cache: o.cache });
        o.value
      },
    },
    result_cache.known(hashes) -> match store_state {
      None -> hashes.map(|h: Bytes| false),
      Some(k) -> hashes.map(|h: Bytes| tables::knows_definition(k.cache, h)),
    },
    result_cache.baselines(keys) -> match store_state {
      None -> keys.map(|key: Bytes| None),
      Some(k) -> {
        let o = if k.place.label == "cwd" { last_passes_over[cwd](k.cache, keys) }
        else { last_passes_over[abs](k.cache, keys) };
        store_state = Some({ ..k, cache: o.cache });
        o.value
      },
    },
    result_cache.texts(hashes) -> match store_state {
      None -> hashes.map(|h: Bytes| None),
      Some(k) -> {
        let o = if k.place.label == "cwd" { read_texts[cwd](k.cache, hashes) }
        else { read_texts[abs](k.cache, hashes) };
        store_state = Some({ ..k, cache: o.cache });
        o.value
      },
    },
    result_cache.unstored(hashes) -> match store_state {
      None -> [],
      Some(k) -> unstored_in(k.cache, hashes),
    },
    result_cache.history(texts, modules) -> match store_state {
      None -> (),
      Some(k) -> {
        store_state = Some({ ..k, cache: store_pass(k.cache, texts, modules) });
      },
    },
    result_cache.store_filing(f) -> match store_state {
      None -> { unflushed: None, warnings: [] },
      Some(k) -> {
        let c = if k.place.label == "cwd" { flush_filing[cwd](k.cache, f) }
        else { flush_filing[abs](k.cache, f) };
        store_state = Some(without_warnings({ ..k, cache: c }));
        { unflushed: None, warnings: cache_warnings(c) }
      },
    },
  }

fn cached_over<[r]>(
  cache: tables::Cache,
  keys: List<String>,
) -> List<Option<Bytes>> / {fs.read[r], fs.read[abs], abort.raise} =
  keys.map(|key: String| tables::evidence_shared[r, abs](cache, Bytes::of_hex(key)).value)

fn cached_of(
  opened_store: Option<OpenStore>,
  keys: List<String>,
) -> List<Option<Bytes>> / {fs.read[cwd], fs.read[abs], abort.raise} =
  match opened_store {
    None -> keys.map(|k: String| None),
    Some(k) -> if k.place.label == "cwd" { cached_over[cwd](k.cache, keys) }
    else { cached_over[abs](k.cache, keys) },
  }

type StoreWrite = { store: Option<OpenStore>, diagnostics: List<Diagnostic> }

fn after_write(k: OpenStore, cache: tables::Cache) -> StoreWrite =
  {
    store: Some({ ..k, cache: { ..cache, store: { ..cache.store, warnings: [] } } }),
    diagnostics: project_store::diagnostics_of(tables::warnings(cache)),
  }

fn flushed(
  k: OpenStore,
  cache: tables::Cache,
) -> StoreWrite / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  after_write(k, if k.place.label == "cwd" { tables::flush_shared[cwd, abs](cache) }
  else { tables::flush_shared[abs, abs](cache) })

fn record_evidence(
  opened_store: Option<OpenStore>,
  entries: List<{ key: String, evidence: Bytes }>,
) -> StoreWrite / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  match opened_store {
    None -> { store: None, diagnostics: [] },
    Some(k) ->
      flushed(
        k,
        entries.fold(k.cache, |cache: tables::Cache, e: { key: String, evidence: Bytes }|
          tables::put_evidence(cache, Bytes::of_hex(e.key), e.evidence)),
      ),
  }

fn baselines_over<[r]>(
  cache: tables::Cache,
  names: List<String>,
) -> List<{ name: String, record: ClaimSnapshot }> / {fs.read[r], abort.raise} =
  names.fold([], |accumulator: List<{ name: String, record: ClaimSnapshot }>, name: String|
    match tables::review[r](cache, Bytes::of_string(name)).value {
      None -> accumulator,
      Some(rv) ->
        accumulator.push({
          name: name,
          record: { definition_hash: rv.definition.hex_of(), specs: rv.specs.map(Bytes::hex_of) },
        }),
    })

fn baselines_of(
  opened_store: Option<OpenStore>,
  names: List<String>,
) -> List<{ name: String, record: ClaimSnapshot }> / {fs.read[cwd], fs.read[abs], abort.raise} =
  match opened_store {
    None -> [],
    Some(k) -> if k.place.label == "cwd" { baselines_over[cwd](k.cache, names) }
    else { baselines_over[abs](k.cache, names) },
  }

fn accepted_of(
  opened_store: Option<OpenStore>,
  records: List<{ name: String, record: ClaimSnapshot }>,
) -> { store: Option<OpenStore>, accepted: AcceptResult } / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  match opened_store {
    None -> { store: None, accepted: { definitions: records.len(), stored: false, warnings: [] } },
    Some(k) -> {
      let w = flushed(
        k,
        records.fold(k.cache, |cache: tables::Cache, r: { name: String, record: ClaimSnapshot }|
          tables::put_review(cache, Bytes::of_string(r.name), {
            definition: Bytes::of_hex(r.record.definition_hash),
            specs: r.record.specs.map(Bytes::of_hex),
          })),
      );
      {
        store: w.store,
        accepted: {
          definitions: records.len(),
          stored: !w.diagnostics.fold(false, |hit: Bool, diagnostic: Diagnostic|
            hit || diagnostic.code == b"W0601"),
          warnings: w.diagnostics,
        },
      }
    },
  }

pub fn with_evidence<a | e>(
  opened_store: Option<OpenStore>,
  go: () -> a / {proof_store.cached, proof_store.record | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms | e} =
  handle {
    go()
  } with {
    var store_state = opened_store,
    proof_store.cached(keys) -> cached_of(store_state, keys),
    proof_store.record(entries) -> {
      let w = record_evidence(store_state, entries);
      store_state = w.store;
      w.diagnostics
    },
  }

pub fn with_review<a | e>(
  opened_store: Option<OpenStore>,
  go: () -> a / {proof_store.cached, proof_store.record, proof_store.baselines, proof_store.accepted | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms | e} =
  handle {
    go()
  } with {
    var store_state = opened_store,
    proof_store.cached(keys) -> cached_of(store_state, keys),
    proof_store.record(entries) -> {
      let w = record_evidence(store_state, entries);
      store_state = w.store;
      w.diagnostics
    },
    proof_store.baselines(names) -> baselines_of(store_state, names),
    proof_store.accepted(records) -> {
      let a = accepted_of(store_state, records);
      store_state = a.store;
      a.accepted
    },
  }

fn hashed(s: String) -> Bytes = blake3(Bytes::of_string(s))

fn fixed(name: Bytes, edges: List<NodeRef>) -> CachedNode =
  {
    name: name,
    declaration: false,
    hash: blake3(name),
    own: None,
    specs: [],
    spec_texts: [],
    spec_checks: [],
    contract: b"",
    check: b"",
    body: b"",
    edges: edges,
    effects: [],
    clauses: [],
  }

const a_module: ModuleHashes = {
  let fixing = {
    nodes: [fixed(b"m.f", [{ name: b"m.g", declaration: false }]), fixed(b"m.g", [])],
    tests: [
      {
        key: b"m.t",
        hash: hashed("t"),
        body: b"",
        text: b"",
        refs: [{ name: b"m.f", declaration: false }],
        runs: [],
        listing: [],
      },
    ],
    laws: [],
  };
  { record: record_digest(module_record(fixing)), cached: fixing }
}

const a_filing: Filing =
  {
    passes: [{ key: hashed("t key"), trace: b"file\tcwd\ta\td\n" }],
    code_passes: [{ key: hashed("t code"), trace: b"" }],
    records: [
      {
        key: b"m.t",
        record: {
          test: hashed("t"),
          era: snapshot_digest_of([a_module]),
          start: b"m.t",
          case: false,
        },
      },
    ],
    seen: [hashed("f")],
    reachable: { functions: [], declarations: [] },
  }

const some_stamps: tables::Stamps = { runtime_digest: "runtime", code: "code" }

const original_definition: { hash: Bytes, text: Bytes } =
  { hash: hashed("old f"), text: b"fn f() -> Int = 1\n" }

fn read_back(
  f: Filing,
) -> { passes: List<Option<Bytes>>, codes: List<Option<Bytes>>, moved: List<Option<Bytes>>, seen: List<Bool>, baselines: List<Option<LastPass>>, texts: List<Option<Bytes>> } / {abort.raise} =
  run_in_memory(mem_empty(), || {
    let c0 = store_pass(tables::open_cache[mem]("cache", some_stamps), [original_definition], [
      a_module,
    ]);
    let c1 = tables::flush_cache[mem](put_filing[mem, mem](c0, f));
    let r = tables::open_cache[mem]("cache", some_stamps);
    let moved = tables::open_cache[mem]("cache", { ..some_stamps, runtime_digest: "another" });
    {
      passes: read_pass_traces[mem, mem](r, [hashed("t key"), hashed("other")]).value,
      codes: code_passes_over[mem, mem](r, [hashed("t code"), hashed("t key")]).value,
      moved: code_passes_over[mem, mem](moved, [hashed("t code")]).value.fold(
        read_pass_traces[mem, mem](moved, [hashed("t key")]).value,
        |accumulator: List<Option<Bytes>>, o: Option<Bytes>| accumulator.push(o),
      ),
      seen: [hashed("f"), hashed("g")].map(|h: Bytes| tables::knows_definition(r, h)),
      baselines: last_passes_over[mem](r, [b"m.t", b"m.u"]).value,
      texts: read_texts[mem](r, [original_definition.hash, hashed("missing")]).value,
    }
  }).value

test "a stored run reads back its passing results, baselines and whether each test ran, and each baseline reads back with its definition text" {
  let back = read_back(a_filing);
  assert_eq(back.passes, [Some(b"file\tcwd\ta\td\n"), None]);
  assert_eq(back.codes, [Some(b""), None]);
  assert_eq(back.moved, [None, Some(b"")]);
  assert_eq(back.seen, [true, false]);
  assert_eq(back.baselines, [
    Some({
      test: hashed("t"),
      reachable: {
        functions: Map::new().insert(b"m.f", blake3(b"m.f")).insert(b"m.g", blake3(b"m.g")),
        declarations: Map::new(),
      },
    }),
    None,
  ]);
  assert_eq(back.texts, [Some(original_definition.text), None])
}

test "a baseline is not returned when the module record it was made from is missing from the cache" {
  let back = run_in_memory(mem_empty(), || {
    let c = put_filing[mem, mem](tables::open_cache[mem]("cache", some_stamps), a_filing);
    last_passes_over[mem](tables::put_snapshot(c, [a_module.record]), [b"m.t"]).value
  }).value;
  assert_eq(back, [None])
}

test "opening the cache under a different runtime digest drops the stored baselines and passing results but still returns the definition texts" {
  let back = run_in_memory(mem_empty(), || {
    let recorded = store_pass(
      tables::open_cache[mem]("cache", some_stamps),
      [original_definition],
      [a_module],
    );
    let c1 = tables::flush_cache[mem](put_filing[mem, mem](recorded, a_filing));
    let moved = tables::open_cache[mem]("cache", { ..some_stamps, runtime_digest: "another" });
    {
      baselines: last_passes_over[mem](moved, [b"m.t"]).value,
      texts: read_texts[mem](moved, [original_definition.hash]).value,
    }
  }).value;
  assert_eq(back.baselines, [None]);
  assert_eq(back.texts, [Some(original_definition.text)])
}

test "storing a run with no results reads back no passing results, no ran-test flags and no baselines" {
  let back = read_back({
    passes: [],
    code_passes: [],
    records: [],
    seen: [],
    reachable: { functions: [], declarations: [] },
  });
  assert_eq(back.passes, [None, None]);
  assert_eq(back.seen, [false, false]);
  assert_eq(back.baselines, [None, None])
}
