import compiler.emit.costs (Report, Costed, Site, ReturnMismatch, placed_span, report_of)
import compiler.front.checking.promises (BodyProgram, MeasureEntry, body_program_checked,
                                         cost_walk_query)
import compiler.front.emitter_input (Analysed, Rejected)
import compiler.front.exports (InRoot)
import compiler.front.published (checked_bodies)
import compiler.store.hash.encoding (hex)
import compiler.check.resolve.tables (Source, Diagnostic, error_at, error_at_and)
import compiler.syntax.parsing (Span, no_module, dummy_span, span_between)
import compiler.unit (identity_of, shipped)
import compiler.store.records (record_store, with_record_store)
import compiler.load (Derives)
import diagnostic (SourceText, position_of)
import compiler.cc (toolchain)
import program (ProgramPlace, Session, in_program_store)
import module_queries (PromiseFacts, promise_facts, body_programs)
import compiler.front.checking (LoadInputs, fresh_registry, inputs_alone, lookup_input_alone,
                                over_decoding, prelude_files, prelude_frames)
import compiler.store.memo (QueryStats, Run, empty_memory_store, in_session, reading)
import proof.static_prover (UnprovedMeasure, unproved_measures)
import report (indent)
import std.term (Style, bold, dim, red, green, yellow, plain)
import std.bin
import std.fs (fs)
import std.hash (blake3)
import std.string
import std.list
import proof.obligation (plural)
import std.path (strip_root)

const location_width: Int = 22

pub type PromiseRead = { facts: PromiseFacts, walked: Int }

pub type PromiseAsk = {
  place: ProgramPlace,
  costs: Bool,
  measures: Bool,
  read: Option<PromiseRead>,
}

pub type Promises = { report: Option<Report>, walked: Int, unproved: List<Diagnostic> }

pub effect cost_checker {
  read report(ask: PromiseAsk) -> Promises
}

pub const no_promises: Promises = { report: None, walked: 0, unproved: [] }

pub fn promises_of(
  place: ProgramPlace,
  costs: Bool,
  measures: Bool,
) -> Promises / {cost_checker.report, abort.raise} =
  if !costs && !measures { no_promises }
  else { cost_checker.report({ place: place, costs: costs, measures: measures, read: None }) }

fn walks_in(tallies: List<QueryStats>) -> Int =
  tallies.fold(0, |n: Int, t: QueryStats| if t.query == cost_walk_query { n + t.ran } else { n })

pub fn promises_read<a>(
  s: Session<a>,
  facts: PromiseFacts,
  costs: Bool,
) -> Promises / {cost_checker.report, abort.raise} =
  if !costs && !s.summary.measures { no_promises } else {
    cost_checker.report({
      place: s.place,
      costs: costs,
      measures: s.summary.measures,
      read: Some({ facts: facts, walked: walks_in(s.tallies) }),
    })
  }

pub fn report_violations(r: Report) -> List<Diagnostic> =
  if !r.ok { [unresolved] } else {
    r.return_mismatches.fold(
      report_reuse_violations(r),
      |accumulator: List<Diagnostic>, u: ReturnMismatch| accumulator.push(broken_returns_clause(u)),
    )
  }

pub fn promise_errors(promises: Promises) -> List<Diagnostic> =
  if promises.unproved.len() > 0 { promises.unproved }
  else { match promises.report { None -> [], Some(r) -> report_violations(r) } }

pub fn reuse_violations<a>(
  s: Session<a>,
  facts: PromiseFacts,
) -> List<Diagnostic> / {cost_checker.report, abort.raise} =
  promise_errors(promises_read(s, facts, s.summary.promises))

pub fn measure_errors(
  place: ProgramPlace,
) -> List<Diagnostic> / {cost_checker.report, abort.raise} =
  promises_of(place, false, true).unproved

type MeasureFailure = { owner: Bytes, start: Int, end: Int, reason: List<String>, descends: Bool }

derive bin for MeasureFailure

fn measure_failures(p: BodyProgram) -> List<MeasureFailure> / {abort.raise} = {
  let own_module = p.source.source.name;
  let owned = |m: Bytes| m == own_module || p.places.get(m) == Some(InRoot);
  let c = body_program_checked(p);
  match c.pulled.out {
    Rejected(ds) ->
      p.measured.map(|name: Bytes|
        {
          owner: name,
          start: 0,
          end: 0,
          reason: ds.map(|d: Diagnostic| String::of_bytes_lossy(d.message)),
          descends: false,
        }),
    Analysed(w) ->
      unproved_measures(w, owned, Some(checked_bodies(w)), Some(p.measured)).map(
        |u: UnprovedMeasure|
          {
            owner: Bytes::of_string(u.measure.owner),
            start: u.measure.at.start - p.source.offset,
            end: u.measure.at.end - p.source.offset,
            reason: u.reason,
            descends: u.descends,
          },
      ),
  }
}

fn measure_diagnostic(e: MeasureEntry, module: Int, f: MeasureFailure) -> Diagnostic =
  error_at(
    b"E0467",
    module,
    placed_span(e.items, span_between(f.start, f.end)),
    Bytes::concat_all([
      b"the measure of `",
      f.owner,
      b"` is not proved to decrease at every recursive call, including calls between definitions that call each other",
    ]),
    b"the checker cannot prove that this `measure` decreases",
    f.reason.map(Bytes::of_string).push(if f.descends {
      b"the checker can see that the definition ends without the measure, so remove the `measure` clause"
    } else {
      b"a definition is read as ending on its measure only once a proof shows it; restructure it so the checker sees it descend, or state a measure a proof can follow"
    }),
  )

const prover_roots: List<Bytes> = [b"update_costs.with_cost_cache"]

fn verdict_key(prover: Bytes, program: Bytes) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all([
        b"ply.measure.1\x00",
        hex(bin::shape_digest(bin::list_bin(measure_failure_bin()))),
        b"\x00",
        prover,
        b"\x00",
        program,
      ]),
    ),
  )

type KnownVerdict = { entry: MeasureEntry, key: Bytes, failures: Option<List<MeasureFailure>> }

fn decoded_verdict(bytes: Option<Bytes>) -> Option<List<MeasureFailure>> / {abort.raise} =
  match bytes {
    None -> None,
    Some(b) -> match bin::decode(b, bin::list_bin(measure_failure_bin())) {
      Ok(failures) -> Some(failures),
      Err(_) -> None,
    },
  }

fn measures_settled(
  place: ProgramPlace,
  modules: List<Bytes>,
  entries: List<MeasureEntry>,
) -> List<Diagnostic> / {shipped.definitions, toolchain.bodies_dir, fs.read[abs], fs.write[abs], toolchain.read, fs.list_dir[shipped], fs.read[cwd], fs.write[cwd], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} = {
  let prover = identity_of(shipped.definitions(), prover_roots);
  let store = strip_root(toolchain.bodies_dir()) ++ "/measures-"
    ++ String::of_bytes(prover.slice(0, 16));
  with_record_store[abs, proofs](store, || {
    let known = entries.map(|e: MeasureEntry| {
      let key = verdict_key(prover, e.program);
      { entry: e, key: key, failures: decoded_verdict(record_store.get[proofs](key)) }
    });
    let open = known.filter(|k: KnownVerdict| k.failures == None);
    let proved = if open.len() == 0 { [] } else {
      in_program_store(place, |_: LoadInputs|
        body_programs(open.map(|k: KnownVerdict| k.entry.unit))).value.map(
        measure_failures,
      )
    };
    if open.len() > 0 {
      record_store.put[proofs](
        range(0, open.len()).map(|i: Int|
          {
            key: open.get(i).key,
            bytes: bin::encode(proved.get(i), bin::list_bin(measure_failure_bin())),
          }),
      )
    };
    let by_key = range(0, open.len()).fold(
      Map::new(),
      |accumulator: Map<Bytes, List<MeasureFailure>>, i: Int|
        accumulator.insert(open.get(i).key, proved.get(i)),
    );
    known.fold([], |accumulator: List<Diagnostic>, k: KnownVerdict| {
      let module = range(0, modules.len()).fold(0, |found: Int, i: Int|
        if modules.get(i) == k.entry.unit.module { i } else { found });
      let failures = match k.failures {
        Some(fs) -> fs,
        None -> match by_key.get(k.key) { Some(fs) -> fs, None -> [] },
      };
      accumulator.concat(failures.map(|f: MeasureFailure| measure_diagnostic(k.entry, module, f)))
    })
  })
}

fn at_module(index: Int, m: Report) -> Report =
  {
    ..m,
    definitions: m.definitions.map(|d: Costed| { ..d, module: index }),
    return_mismatches: m.return_mismatches.map(|u: ReturnMismatch| { ..u, module: index }),
  }

pub fn with_cost_cache<a | e>(
  body: () -> a / {cost_checker.report | e},
) -> a / {shipped.definitions, toolchain.bodies_dir, fs.read[abs], fs.write[abs], toolchain.read, fs.list_dir[shipped], fs.read[cwd], fs.write[cwd], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise | e} =
  handle {
    body()
  } with {
    cost_checker.report(ask) -> {
      let modules = ask.place.project.sources.map(|s: Source| s.name);
      let read = match ask.read {
        Some(r) -> r,
        None -> {
          let opened = in_program_store(ask.place, |_: LoadInputs|
            promise_facts(modules, ask.costs, ask.measures));
          { facts: opened.value, walked: walks_in(opened.tallies) }
        },
      };
      let facts = read.facts;
      {
        report: if !ask.costs { None } else {
          Some(
            report_of(range(0, facts.costs.len()).map(|i: Int| at_module(i, facts.costs.get(i)))),
          )
        },
        walked: read.walked,
        unproved: if facts.measures.len() == 0 { [] }
        else { measures_settled(ask.place, modules, facts.measures) },
      }
    },
  }

fn broken_returns_clause(u: ReturnMismatch) -> Diagnostic =
  error_at(
    b"E0148",
    u.module,
    span_between(u.start, u.end),
    Bytes::concat_all([
      b"`",
      u.name,
      b"` says it returns ",
      u.declared,
      b", and its body returns ",
      u.actual,
    ]),
    b"the clause",
    [
      b"a caller in another package reads this clause in place of the body: write what the body returns, or change the body",
    ],
  )

fn basename(path: String) -> String = {
  let parts = path.split("/");
  match parts.at(parts.len() - 1) { Some(last) -> last, None -> path }
}

fn location_text(places: List<SourceText>, module: Int, offset: Int) -> String / {abort.raise} =
  match places.at(module) {
    None -> "<unknown>",
    Some(example_sources) -> {
      let spot = position_of(example_sources.text, offset);
      basename(example_sources.path) ++ ":" ++ spot.line.to_string() ++ ":"
        ++ spot.column.to_string()
    },
  }

fn count_verdict(d: Costed, verdict: Bytes) -> Int =
  d.sites.fold(0, |accumulator: Int, s: Site|
    if s.verdict == verdict { accumulator + 1 } else { accumulator })

fn append_count(n: Int, word: String, summary: String) -> String =
  if n == 0 { summary }
  else if summary == "" { n.to_string() ++ " " ++ word }
  else { summary ++ ", " ++ n.to_string() ++ " " ++ word }

fn tally(d: Costed) -> String =
  append_count(
    count_verdict(d, b"unknown"),
    "unknown",
    append_count(
      count_verdict(d, b"copies"),
      "COPIES",
      append_count(count_verdict(d, b"reuses"), "reuses", ""),
    ),
  )

fn kind_of(d: Costed) -> String =
  if d.item_kind == b"test" { " (test)" } else if d.item_kind == b"law" { " (law)" } else { "" }

fn colored_verdict(style: Style, verdict: Bytes) -> String =
  if verdict == b"reuses" { green(style, "reuses ") }
  else if verdict == b"copies" { red(style, "COPIES ") }
  else { yellow(style, "unknown") }

fn site_lines(
  style: Style,
  places: List<SourceText>,
  d: Costed,
  lines: List<String>,
  site: Site,
) -> List<String> / {abort.raise} = {
  let at = location_text(places, d.module, site.start);
  let pad = if at.len() >= location_width { 0 } else { location_width - at.len() };
  let output_lines = lines.push(
    "    " ++ at ++ " ".repeat(pad) ++ "  " ++ colored_verdict(style, site.verdict) ++ "  "
      ++ String::of_bytes_lossy(site.reason),
  );
  if site.suggestion.len() == 0 { output_lines } else {
    output_lines.push(
      "    " ++ " ".repeat(location_width) ++ "  " ++ " ".repeat(7) ++ "  "
        ++ dim(style, "fix: " ++ String::of_bytes_lossy(site.suggestion)),
    )
  }
}

fn definition_lines(
  style: Style,
  places: List<SourceText>,
  lines: List<String>,
  d: Costed,
) -> List<String> / {abort.raise} = {
  let head = lines.push("").push(
    "  " ++ bold(style, String::of_bytes_lossy(d.label)) ++ dim(style, kind_of(d)) ++ "  "
      ++ dim(style, tally(d)),
  );
  d.sites.fold(head, |accumulator: List<String>, site: Site|
    site_lines(style, places, d, accumulator, site))
}

fn total(report: Report, verdict: Bytes) -> Int =
  report.definitions.fold(0, |accumulator: Int, d: Costed| accumulator + count_verdict(d, verdict))

fn summary(report: Report) -> String / {abort.raise} = {
  let reuses = total(report, b"reuses");
  let copies = total(report, b"copies");
  let undecided = total(report, b"unknown");
  Int::to_string(reuses + copies + undecided) ++ " updates: " ++ reuses.to_string() ++ " reuse, "
    ++ copies.to_string()
    ++ " copy, "
    ++ undecided.to_string()
    ++ " undecided — "
    ++ report.rounds.to_string()
    ++ " "
    ++ plural(report.rounds, "round")
}

pub fn report_lines(
  style: Style,
  places: List<SourceText>,
  report: Report,
) -> List<String> / {abort.raise} =
  if report.definitions.len() == 0 {
    ["", indent ++ dim(style, "no `update` functions found: there are no copy costs to report")]
  } else {
    report.definitions.fold([""], |accumulator: List<String>, d: Costed|
      definition_lines(style, places, accumulator, d)).push(
      "",
    ).push(
      "  " ++ dim(style, summary(report)),
    )
  }

pub const unresolved: Diagnostic =
  error_at(
    b"E0505",
    no_module,
    dummy_span,
    b"the compiler could not determine which `update` calls in this program copy a list or array: the analysis did not finish",
    b"no `update` call was analyzed, so no `reuse` annotation was checked",
    [b"this is Ply's fault: the compiler's own `costs.ply` is what failed here"],
  )

fn reuse_violation(d: Costed, promise: Span, site: Site) -> Diagnostic = {
  let collection = if site.operation == b"Array::set" { b"array" } else { b"list" };
  let what = if site.verdict == b"copies" { b"copies its ".concat(collection) }
  else { b"cannot be shown to reuse the same ".concat(collection) };
  let note = if site.suggestion.len() == 0 {
    b"no edit inside this body removes the copy; the promise cannot be kept as written, so either restructure the update or drop `reuse`"
  } else { b"fix: ".concat(site.suggestion) };
  error_at_and(
    b"E0127",
    d.module,
    span_between(site.start, site.end),
    Bytes::concat_all([
      b"`",
      d.name,
      b"` is a `reuse fn`, and this `",
      site.operation,
      b"` ",
      what,
      b": ",
      site.reason,
    ]),
    b"this update",
    d.module,
    promise,
    b"the promise",
    [note],
  )
}

pub fn report_reuse_violations(report: Report) -> List<Diagnostic> =
  report.definitions.fold([], |accumulator: List<Diagnostic>, d: Costed|
    match d.reuse_keyword {
      None -> accumulator,
      Some(promise) ->
        d.sites.fold(accumulator, |diagnostics: List<Diagnostic>, site: Site|
          if site.verdict == b"reuses" || site.param >= 0 { diagnostics }
          else { diagnostics.push(reuse_violation(d, promise, site)) }),
    })

fn failures_over(sources: List<Source>) -> List<MeasureFailure> / {abort.raise} = {
  let w = inputs_alone(sources);
  let qs = fresh_registry();
  over_decoding(
    empty_memory_store,
    prelude_frames,
    prelude_files,
    |kind: Bytes, at: Bytes| lookup_input_alone(w, kind, at),
    ||
      in_session(qs, |run: Run|
        reading(qs, run, || {
          let listed = promise_facts(sources.map(|s: Source| s.name), false, true);
          body_programs(listed.measures.map(|e: MeasureEntry| e.unit))
        })),
  ).value.fold([], |accumulator: List<MeasureFailure>, p: BodyProgram|
    accumulator.concat(measure_failures(p)))
}

fn measure_failures_in(source: Bytes) -> List<MeasureFailure> / {abort.raise} =
  failures_over([{ name: b"m", source_text: source }])

fn failed_measures(source: Bytes) -> List<Bytes> / {abort.raise} =
  measure_failures_in(source).map(|f: MeasureFailure| f.owner)

test "a measure is proved from its function's own program, which holds the bodies it calls" {
  assert_eq(
    failed_measures(
      b"fn is_small(n: Int) -> Bool = n <= 0\nfn lowered(n: Int) -> Int decreases n = if is_small(n) { 0 } else { lowered(n - 1) + 1 }\n",
    ),
    [],
  )
}

test "a measure proof reads the body of a callee in another module of the package" {
  assert_eq(
    failures_over([
      { name: b"util", source_text: b"pub fn is_small(n: Int) -> Bool = n <= 0\n" },
      {
        name: b"m",
        source_text: b"import util (is_small)\n\nfn lowered(n: Int) -> Int decreases n = if is_small(n) { 0 } else { lowered(n - 1) + 1 }\n",
      },
    ]).map(|f: MeasureFailure| f.owner),
    [],
  )
}

test "a measure proof covers each function of a cycle, and a measure that does not fall fails" {
  assert_eq(
    failed_measures(
      b"fn up(a: Int, b: Int) -> Int decreases a + b = if a + b <= 0 { 0 } else { across(a + 1, b - 2) }\nfn across(a: Int, b: Int) -> Int decreases a + b = if a + b <= 0 { 0 } else { up(a - 2, b + 1) }\n",
    ),
    [],
  );
  assert_eq(
    failed_measures(b"fn stall(n: Int) -> Int decreases n = if n <= 0 { 0 } else { stall(n) }\n"),
    [b"m.stall"],
  )
}

test "a failed measure is placed at its clause, relative to the text of its unit" {
  let source = b"fn stall(n: Int) -> Int decreases n + 1 = if n <= 0 { 0 } else { stall(n) }\n";
  let f = measure_failures_in(source).get(0);
  assert_eq(source.slice(f.start, f.end), b"n + 1")
}

fn example_sources() -> List<SourceText> =
  [{ path: "src/m.ply", text: b"fn f() -> Int = 1\nfn g() -> Int = 2\n" }]

fn site(verdict: Bytes, reason: Bytes, fix: Bytes, param: Int) -> Site =
  {
    start: 18,
    end: 29,
    operation: b"List::push",
    verdict: verdict,
    reason: reason,
    suggestion: fix,
    param: param,
  }

fn costed(kind: Bytes, sites: List<Site>, reuse: Option<Span>) -> Costed =
  {
    item_kind: kind,
    module: 0,
    module_name: b"m",
    name: b"grow",
    label: b"m.grow",
    reuse_keyword: reuse,
    sites: sites,
  }

test "a definition's tally names only the verdicts it has, in one order" {
  assert_eq(tally(costed(b"fn", [site(b"reuses", b"", b"", 0 - 1)], None)), "1 reuses");
  assert_eq(
    tally(
      costed(
        b"fn",
        [
          site(b"reuses", b"", b"", 0 - 1),
          site(b"copies", b"", b"", 0 - 1),
          site(b"unknown", b"", b"", 0 - 1),
        ],
        None,
      ),
    ),
    "1 reuses, 1 COPIES, 1 unknown",
  );
  assert_eq(tally(costed(b"fn", [], None)), "")
}

test "a program that updates nothing is told so on one line" {
  assert_eq(
    report_lines(plain, example_sources(), {
      ok: true,
      rounds: 1,
      definitions: [],
      return_mismatches: [],
    }),
    ["", "   no `update` functions found: there are no copy costs to report"],
  )
}

test "an update-cost report names each copying site by its file's base name and keeps the verdict column in the same place" {
  let r: Report = {
    ok: true,
    rounds: 2,
    definitions: [costed(b"fn", [site(b"copies", b"read again", b"bind it first", 0 - 1)], None)],
    return_mismatches: [],
  };
  assert_eq(report_lines(plain, example_sources(), r), [
    "",
    "",
    "  m.grow  1 COPIES",
    "    m.ply:2:1               COPIES   read again",
    "                                     fix: bind it first",
    "",
    "  1 updates: 0 reuse, 1 copy, 0 undecided — 2 rounds",
  ])
}

test "a `reuse fn` is rejected when its own body copies a value, but not when only a caller copies it" {
  let promise = Some(span_between(0, 5));
  let clean_report: Report = {
    ok: true,
    rounds: 1,
    definitions: [costed(b"fn", [site(b"reuses", b"fine", b"", 0 - 1)], promise)],
    return_mismatches: [],
  };
  assert_eq(report_reuse_violations(clean_report), []);
  let caller: Report = {
    ok: true,
    rounds: 1,
    definitions: [costed(b"fn", [site(b"copies", b"a caller keeps it", b"", 0)], promise)],
    return_mismatches: [],
  };
  assert_eq(report_reuse_violations(caller), []);
  let broken: Report = {
    ok: true,
    rounds: 1,
    definitions: [
      costed(b"fn", [site(b"copies", b"read again", b"`Map::update`", 0 - 1)], promise),
    ],
    return_mismatches: [],
  };
  let raised = report_reuse_violations(broken);
  assert_eq(raised.len(), 1);
  let d = match raised.at(0) { Some(x) -> x, None -> panic("one diagnostic") };
  assert_eq(d.code, b"E0127");
  assert_eq(
    d.message,
    b"`grow` is a `reuse fn`, and this `List::push` copies its list: read again",
  );
  assert_eq(d.notes_text, [b"fix: `Map::update`"]);
  assert_eq(d.labels.len(), 2);
  let hopeless: Report = {
    ok: true,
    rounds: 1,
    definitions: [costed(b"fn", [site(b"unknown", b"a call", b"", 0 - 1)], promise)],
    return_mismatches: [],
  };
  assert_eq(report_reuse_violations(hopeless).map(|x: Diagnostic| x.message), [
    b"`grow` is a `reuse fn`, and this `List::push` cannot be shown to reuse the same list: a call",
  ]);
  let array: Report = {
    ok: true,
    rounds: 1,
    definitions: [
      costed(
        b"fn",
        [{ ..site(b"copies", b"read again", b"", 0 - 1), operation: b"Array::set" }],
        promise,
      ),
    ],
    return_mismatches: [],
  };
  assert_eq(report_reuse_violations(array).map(|x: Diagnostic| x.message), [
    b"`grow` is a `reuse fn`, and this `Array::set` copies its array: read again",
  ])
}

test "a function without a `reuse` annotation is never rejected, even when the report shows it copies a value" {
  let r: Report = {
    ok: true,
    rounds: 1,
    definitions: [costed(b"fn", [site(b"copies", b"read again", b"", 0 - 1)], None)],
    return_mismatches: [],
  };
  assert_eq(report_reuse_violations(r), [])
}

test "a `returns` clause that the function body does not satisfy is rejected at the place where the clause is written" {
  let d = broken_returns_clause({
    module: 0,
    module_name: b"m",
    name: b"m.pick",
    start: 40,
    end: 42,
    declared: b"its parameter `ys`",
    actual: b"its parameter `xs`",
  });
  assert_eq(d.code, b"E0148");
  assert_eq(
    d.message,
    b"`m.pick` says it returns its parameter `ys`, and its body returns its parameter `xs`",
  )
}
