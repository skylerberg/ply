const location_width: Int = 22

pub effect cost_checker {
  read report(p: CostInput) -> Costing
}

pub fn costs_of(
  program: Program,
  analysis: Analysis,
) -> Costing / {cost_checker.report, abort.raise} = {
  let sources = range(0, analysis.modules.len()).map(|i: Int|
    match program.source_texts.at(i) {
      Some(example_sources) -> example_sources.text,
      None -> b"",
    });
  let c = cost_checker.report(cost_input_of(analysis, sources));
  {
    ..c,
    report: {
      ..c.report,
      definitions: c.report.definitions.filter(|d: Costed| d.module < program.files.len()),
    },
  }
}

pub fn reuse_violations(
  program: Program,
  frame: Frame,
) -> List<Diagnostic> / {cost_checker.report, abort.raise} =
  if !has_promises(program, frame) { [] } else {
    match whole_of(program) {
      Err(ds) -> ds,
      Ok(w) -> {
        let r = costs_of(program, w).report;
        if !r.ok { [unresolved] } else {
          r.return_mismatches.fold(
            report_reuse_violations(r),
            |accumulator: List<Diagnostic>, u: ReturnMismatch|
              accumulator.push(broken_returns_clause(u)),
          )
        }
      },
    }
  }

const checker_roots: List<Bytes> =
  [
    b"compiler.emit.costs.costs",
    b"compiler.emit.costs.cost_keys",
    b"compiler.front.analyse_pulling_std_with",
  ]

fn costs_key(
  identity: Bytes,
  names: List<Bytes>,
  sources: List<Bytes>,
  packages: List<PackageDependencies>,
  module_packages: List<Int>,
  shipped: Int,
  embeds: List<ModuleEmbed>,
) -> Bytes / {abort.raise} = {
  let n = |i: Int| Bytes::of_string(i.to_string());
  let read = |e: ModuleEmbed|
    match e.read {
      Ok(files) ->
        Bytes::concat_all(files.map(|f: EmbedFile| Bytes::concat_all([f.name, b"\x00", f.digest]))),
      Err(reason) -> b"!".concat(reason),
    };
  hex(
    blake3(
      Bytes::concat_all([
        b"ply.costs.1\x00",
        hex(bin::shape_digest(report_bin())),
        b"\x00",
        identity,
        b"\x00",
        Bytes::concat_all(
          range(0, names.len()).map(|i: Int|
            Bytes::concat_all([
              match names.at(i) { Some(x) -> x, None -> b"" },
              b"\x00",
              match sources.at(i) { Some(x) -> blake3(x), None -> b"" },
            ])),
        ),
        b"\x00",
        Bytes::concat_all(
          packages.map(|p: PackageDependencies|
            Bytes::concat_all([
              p.prefix,
              b"(",
              Bytes::concat_all(p.dependencies.map(|d: Bytes| d.concat(b","))),
              b")",
            ])),
        ),
        b"\x00",
        Bytes::concat_all(module_packages.map(|k: Int| n(k).concat(b","))),
        b"\x00",
        n(shipped),
        b"\x00",
        Bytes::concat_all(
          embeds.map(|e: ModuleEmbed|
            Bytes::concat_all([e.module, b"\x00", e.key, b"\x00", read(e), b"\x00"])),
        ),
      ]),
    ),
  )
}

fn keyed_sources(a: Analysis, sources: List<Bytes>) -> List<Bytes> / {abort.raise} = {
  let owner = |name: Bytes| {
    let dot = range(0, name.len()).fold(0 - 1, |accumulator: Int, i: Int|
      if name.at(i) == 46 { i } else { accumulator });
    if dot < 0 { b"" } else { name.slice(0, dot) }
  };
  let module_lines = a.hashes.definitions.concat(a.hashes.declarations).fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Bytes>>, d: { name: Bytes, hash: Bytes }| {
      let m = owner(d.name);
      accumulator.insert(
        m,
        List::push(
          match accumulator.get(m) { Some(xs) -> xs, None -> [] },
          Bytes::concat_all([d.name, b" ", d.hash, b"\n"]),
        ),
      )
    },
  );
  range(0, a.modules.len()).map(|i: Int| {
    let m = a.modules.get(i);
    let source = match sources.at(i) { Some(x) -> x, None -> b"" };
    if !is_shipped_module(a.packages, a.module_packages, i) { source } else {
      Bytes::concat_all(
        [b"shipped\x00", module_form_digest(m.module, source), b"\x00"].concat(
          match module_lines.get(m.name) { Some(xs) -> xs, None -> [] },
        ),
      )
    }
  })
}

pub fn with_cost_cache<a | e>(
  body: () -> a / {cost_checker.report | e},
) -> a / {abort.raise, shipped.definitions, toolchain.bodies_dir, fs.read[abs], fs.write[abs] | e} =
  handle {
    body()
  } with {
    cost_checker.report(p) -> {
      let identity = identity_of(shipped.definitions(), checker_roots);
      let store = strip_root(toolchain.bodies_dir()) ++ "/costs-"
        ++ String::of_bytes(identity.slice(0, 16));
      with_record_store[abs, reports](store, || {
        let a = p.analysis;
        let key = costs_key(
          identity,
          a.modules.map(|m: ParsedModule| m.name),
          keyed_sources(a, p.sources),
          a.packages,
          a.module_packages,
          a.packages.len(),
          a.embeds,
        );
        let cached_report = match record_store.get[reports](key) {
          Some(bytes) -> match bin::decode(bytes, report_bin()) {
            Ok(r) -> Some(r),
            Err(_) -> None,
          },
          None -> None,
        };
        match cached_report {
          Some(r) -> { report: r, cached: [], walked_modules: 0, lowered: 0 },
          None -> {
            let keys = cost_keys(p, identity);
            let c = costs(
              p,
              keys.map(|k: Bytes| if k.len() == 0 { None } else { record_store.get[reports](k) }),
            );
            record_store.put[reports](
              range(0, keys.len()).fold([], |accumulator: List<Record>, i: Int|
                match ((c.cached.at(i), keys.at(i))) {
                  (Some(Some(bytes)), Some(k)) -> accumulator.push({ key: k, bytes: bytes }),
                  _ -> accumulator,
                }).push({ key: key, bytes: bin::encode(c.report, report_bin()) }),
            );
            { ..c, cached: [] }
          },
        }
      })
    },
  }

pub fn has_promises(program: Program, frame: Frame) -> Bool =
  frame.outlines.take(program.files.len()).fold(false, |any: Bool, o: Outline|
    any
      || o.items.fold(false, |a: Bool, it: OutlineItem|
        a || (match it { OutlinedFunction(f) -> f.reuse || f.returns, _ -> false })))

fn broken_returns_clause(u: ReturnMismatch) -> Diagnostic =
  error_at(
    b"E0148",
    u.module,
    span_between(u.start, u.end),
    Bytes::concat_all([
      b"`",
      u.name,
      b"` says it returns ",
      u.declared,
      b", and its body returns ",
      u.actual,
    ]),
    b"the clause",
    [
      b"a caller in another package reads this clause in place of the body: write what the body returns, or change the body",
    ],
  )

fn basename(path: String) -> String = {
  let parts = path.split("/");
  match parts.at(parts.len() - 1) { Some(last) -> last, None -> path }
}

fn location_text(places: List<SourceText>, module: Int, offset: Int) -> String / {abort.raise} =
  match places.at(module) {
    None -> "<unknown>",
    Some(example_sources) -> {
      let spot = position_of(example_sources.text, offset);
      basename(example_sources.path) ++ ":" ++ spot.line.to_string() ++ ":"
        ++ spot.column.to_string()
    },
  }

fn count_verdict(d: Costed, verdict: Bytes) -> Int =
  d.sites.fold(0, |accumulator: Int, s: Site|
    if s.verdict == verdict { accumulator + 1 } else { accumulator })

fn append_count(n: Int, word: String, summary: String) -> String =
  if n == 0 { summary }
  else if summary == "" { n.to_string() ++ " " ++ word }
  else { summary ++ ", " ++ n.to_string() ++ " " ++ word }

fn tally(d: Costed) -> String =
  append_count(
    count_verdict(d, b"unknown"),
    "unknown",
    append_count(
      count_verdict(d, b"copies"),
      "COPIES",
      append_count(count_verdict(d, b"reuses"), "reuses", ""),
    ),
  )

fn kind_of(d: Costed) -> String =
  if d.item_kind == b"test" { " (test)" } else if d.item_kind == b"law" { " (law)" } else { "" }

fn colored_verdict(style: Style, verdict: Bytes) -> String =
  if verdict == b"reuses" { green(style, "reuses ") }
  else if verdict == b"copies" { red(style, "COPIES ") }
  else { yellow(style, "unknown") }

fn site_lines(
  style: Style,
  places: List<SourceText>,
  d: Costed,
  lines: List<String>,
  site: Site,
) -> List<String> / {abort.raise} = {
  let at = location_text(places, d.module, site.start);
  let pad = if at.len() >= location_width { 0 } else { location_width - at.len() };
  let output_lines = lines.push(
    "    " ++ at ++ " ".repeat(pad) ++ "  " ++ colored_verdict(style, site.verdict) ++ "  "
      ++ String::of_bytes_lossy(site.reason),
  );
  if site.suggestion.len() == 0 { output_lines } else {
    output_lines.push(
      "    " ++ " ".repeat(location_width) ++ "  " ++ " ".repeat(7) ++ "  "
        ++ dim(style, "fix: " ++ String::of_bytes_lossy(site.suggestion)),
    )
  }
}

fn definition_lines(
  style: Style,
  places: List<SourceText>,
  lines: List<String>,
  d: Costed,
) -> List<String> / {abort.raise} = {
  let head = lines.push("").push(
    "  " ++ bold(style, String::of_bytes_lossy(d.label)) ++ dim(style, kind_of(d)) ++ "  "
      ++ dim(style, tally(d)),
  );
  d.sites.fold(head, |accumulator: List<String>, site: Site|
    site_lines(style, places, d, accumulator, site))
}

fn total(report: Report, verdict: Bytes) -> Int =
  report.definitions.fold(0, |accumulator: Int, d: Costed| accumulator + count_verdict(d, verdict))

fn summary(report: Report) -> String / {abort.raise} = {
  let reuses = total(report, b"reuses");
  let copies = total(report, b"copies");
  let undecided = total(report, b"unknown");
  Int::to_string(reuses + copies + undecided) ++ " updates: " ++ reuses.to_string() ++ " reuse, "
    ++ copies.to_string()
    ++ " copy, "
    ++ undecided.to_string()
    ++ " undecided — "
    ++ report.rounds.to_string()
    ++ " "
    ++ plural(report.rounds, "round")
}

pub fn report_lines(
  style: Style,
  places: List<SourceText>,
  report: Report,
) -> List<String> / {abort.raise} =
  if report.definitions.len() == 0 {
    ["", indent ++ dim(style, "no `update` functions found: there are no copy costs to report")]
  } else {
    report.definitions.fold([""], |accumulator: List<String>, d: Costed|
      definition_lines(style, places, accumulator, d)).push(
      "",
    ).push(
      "  " ++ dim(style, summary(report)),
    )
  }

pub const unresolved: Diagnostic =
  error_at(
    b"E0505",
    no_module,
    dummy_span,
    b"the compiler could not determine which `update` calls in this program copy a list or array: the analysis did not finish",
    b"no `update` call was analyzed, so no `reuse` annotation was checked",
    [b"this is Ply's fault: the compiler's own `costs.ply` is what failed here"],
  )

fn reuse_violation(d: Costed, promise: Span, site: Site) -> Diagnostic = {
  let collection = if site.operation == b"Array::set" { b"array" } else { b"list" };
  let what = if site.verdict == b"copies" { b"copies its ".concat(collection) }
  else { b"cannot be shown to reuse the same ".concat(collection) };
  let note = if site.suggestion.len() == 0 {
    b"no edit inside this body removes the copy; the promise cannot be kept as written, so either restructure the update or drop `reuse`"
  } else { b"fix: ".concat(site.suggestion) };
  error_at_and(
    b"E0127",
    d.module,
    span_between(site.start, site.end),
    Bytes::concat_all([
      b"`",
      d.name,
      b"` is a `reuse fn`, and this `",
      site.operation,
      b"` ",
      what,
      b": ",
      site.reason,
    ]),
    b"this update",
    d.module,
    promise,
    b"the promise",
    [note],
  )
}

pub fn report_reuse_violations(report: Report) -> List<Diagnostic> =
  report.definitions.fold([], |accumulator: List<Diagnostic>, d: Costed|
    match d.reuse_keyword {
      None -> accumulator,
      Some(promise) ->
        d.sites.fold(accumulator, |diagnostics: List<Diagnostic>, site: Site|
          if site.verdict == b"reuses" || site.param >= 0 { diagnostics }
          else { diagnostics.push(reuse_violation(d, promise, site)) }),
    })

test "the cache key of an update-cost report changes with the checker, any module's text, the module-to-package mapping or an embedded file" {
  let sources = [b"fn f() -> Int = 1", b"fn g() -> Int = 2"];
  let embedded = |bytes: Bytes|
    [{ module: b"m", key: b"file:x", read: Ok([embed_file(b"", bytes)]) }];
  let key = |identity: Bytes, texts: List<Bytes>, module_packages: List<Int>, embeds: List<ModuleEmbed>|
    costs_key(identity, [b"m", b"n"], texts, [], module_packages, 1, embeds);
  let base = key(b"c", sources, [0, 0], []);
  assert_eq(key(b"c", sources, [0, 0], []), base);
  assert(key(b"d", sources, [0, 0], []) != base, None);
  assert(key(b"c", [b"fn f() -> Int = 1", b"fn g() -> Int = 3"], [0, 0], []) != base, None);
  assert(key(b"c", sources, [0, 1], []) != base, None);
  assert(
    key(b"c", sources, [0, 0], embedded(b"1")) != key(b"c", sources, [0, 0], embedded(b"2")),
    None,
  )
}

test "the cache key of an update-cost report ignores an unused function added to a standard library module, but changes when a used function changes" {
  let user: Source = { name: b"m", source_text: b"import std.x (f)\npub fn use() -> Int = f()\n" };
  let keyed = |x: Bytes|
    match analyse_pulling_std_with([user], [{ name: b"std.x", source_text: x }], no_rows).out {
      Analysed(a) ->
        keyed_sources(
          a,
          a.modules.map(|m: ParsedModule| if m.name == b"std.x" { x } else { user.source_text }),
        ),
      Rejected(_) -> panic("the test program fails to check"),
    };
  let base = keyed(b"pub fn f() -> Int = 1\n");
  assert_eq(keyed(b"pub fn f() -> Int = 1\n\npub fn g() -> Int = 2\n"), base);
  assert(keyed(b"pub fn f() -> Int = 2\n") != base, Some("what the program reaches moved"))
}

fn example_sources() -> List<SourceText> =
  [{ path: "src/m.ply", text: b"fn f() -> Int = 1\nfn g() -> Int = 2\n" }]

fn site(verdict: Bytes, reason: Bytes, fix: Bytes, param: Int) -> Site =
  {
    start: 18,
    end: 29,
    operation: b"List::push",
    verdict: verdict,
    reason: reason,
    suggestion: fix,
    param: param,
  }

fn costed(kind: Bytes, sites: List<Site>, reuse: Option<Span>) -> Costed =
  {
    item_kind: kind,
    module: 0,
    module_name: b"m",
    name: b"grow",
    label: b"m.grow",
    reuse_keyword: reuse,
    sites: sites,
  }

test "a definition's tally names only the verdicts it has, in one order" {
  assert_eq(tally(costed(b"fn", [site(b"reuses", b"", b"", 0 - 1)], None)), "1 reuses");
  assert_eq(
    tally(
      costed(
        b"fn",
        [
          site(b"reuses", b"", b"", 0 - 1),
          site(b"copies", b"", b"", 0 - 1),
          site(b"unknown", b"", b"", 0 - 1),
        ],
        None,
      ),
    ),
    "1 reuses, 1 COPIES, 1 unknown",
  );
  assert_eq(tally(costed(b"fn", [], None)), "")
}

test "a program that updates nothing is told so on one line" {
  assert_eq(
    report_lines(plain, example_sources(), {
      ok: true,
      rounds: 1,
      definitions: [],
      return_mismatches: [],
    }),
    ["", "   no `update` functions found: there are no copy costs to report"],
  )
}

test "an update-cost report names each copying site by its file's base name and keeps the verdict column in the same place" {
  let r: Report = {
    ok: true,
    rounds: 2,
    definitions: [costed(b"fn", [site(b"copies", b"read again", b"bind it first", 0 - 1)], None)],
    return_mismatches: [],
  };
  assert_eq(report_lines(plain, example_sources(), r), [
    "",
    "",
    "  m.grow  1 COPIES",
    "    m.ply:2:1               COPIES   read again",
    "                                     fix: bind it first",
    "",
    "  1 updates: 0 reuse, 1 copy, 0 undecided — 2 rounds",
  ])
}

test "a `reuse fn` is rejected when its own body copies a value, but not when only a caller copies it" {
  let promise = Some(span_between(0, 5));
  let clean_report: Report = {
    ok: true,
    rounds: 1,
    definitions: [costed(b"fn", [site(b"reuses", b"fine", b"", 0 - 1)], promise)],
    return_mismatches: [],
  };
  assert_eq(report_reuse_violations(clean_report), []);
  let caller: Report = {
    ok: true,
    rounds: 1,
    definitions: [costed(b"fn", [site(b"copies", b"a caller keeps it", b"", 0)], promise)],
    return_mismatches: [],
  };
  assert_eq(report_reuse_violations(caller), []);
  let broken: Report = {
    ok: true,
    rounds: 1,
    definitions: [
      costed(b"fn", [site(b"copies", b"read again", b"`Map::update`", 0 - 1)], promise),
    ],
    return_mismatches: [],
  };
  let raised = report_reuse_violations(broken);
  assert_eq(raised.len(), 1);
  let d = match raised.at(0) { Some(x) -> x, None -> panic("one diagnostic") };
  assert_eq(d.code, b"E0127");
  assert_eq(
    d.message,
    b"`grow` is a `reuse fn`, and this `List::push` copies its list: read again",
  );
  assert_eq(d.notes_text, [b"fix: `Map::update`"]);
  assert_eq(d.labels.len(), 2);
  let hopeless: Report = {
    ok: true,
    rounds: 1,
    definitions: [costed(b"fn", [site(b"unknown", b"a call", b"", 0 - 1)], promise)],
    return_mismatches: [],
  };
  assert_eq(report_reuse_violations(hopeless).map(|x: Diagnostic| x.message), [
    b"`grow` is a `reuse fn`, and this `List::push` cannot be shown to reuse the same list: a call",
  ]);
  let array: Report = {
    ok: true,
    rounds: 1,
    definitions: [
      costed(
        b"fn",
        [{ ..site(b"copies", b"read again", b"", 0 - 1), operation: b"Array::set" }],
        promise,
      ),
    ],
    return_mismatches: [],
  };
  assert_eq(report_reuse_violations(array).map(|x: Diagnostic| x.message), [
    b"`grow` is a `reuse fn`, and this `Array::set` copies its array: read again",
  ])
}

test "a function without a `reuse` annotation is never rejected, even when the report shows it copies a value" {
  let r: Report = {
    ok: true,
    rounds: 1,
    definitions: [costed(b"fn", [site(b"copies", b"read again", b"", 0 - 1)], None)],
    return_mismatches: [],
  };
  assert_eq(report_reuse_violations(r), [])
}

test "a `returns` clause that the function body does not satisfy is rejected at the place where the clause is written" {
  let d = broken_returns_clause({
    module: 0,
    module_name: b"m",
    name: b"m.pick",
    start: 40,
    end: 42,
    declared: b"its parameter `ys`",
    actual: b"its parameter `xs`",
  });
  assert_eq(d.code, b"E0148");
  assert_eq(
    d.message,
    b"`m.pick` says it returns its parameter `ys`, and its body returns its parameter `xs`",
  )
}
