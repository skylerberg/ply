import compiler.store.packs
import compiler.syntax.parsing (no_module, dummy_span)
import std.path (strip_root)
import std.process (process)
import std.time (time)

pub type DataFile = { name: String, bytes: Int }

pub type Row = {
  name: String,
  definitions: Int,
  tests: Int,
  bytes: Int,
  data: List<DataFile>,
  summary: String,
}

fn shipped() -> List<Source> / {fs.list_dir[shipped], fs.read_file[shipped], abort.raise} =
  shipped_modules().filter(|source: Source| is_std(source.name)).sort_by_key(|source: Source|
    String::of_bytes_lossy(source.name))

fn declared(parsed: ParsedModule) -> Int =
  parsed.module.items.fold(0, |n: Int, item: Item|
    match item {
      FunctionItem(_) -> n + 1,
      ExternItem(_) -> n + 1,
      TypeItem(_) -> n + 1,
      EffectItem(_) -> n + 1,
      _ -> n,
    })

fn tested(parsed: ParsedModule) -> Int =
  parsed.module.items.fold(0, |n: Int, item: Item| match item { TestItem(_) -> n + 1, _ -> n })

fn data_files_of(source: Source, data: List<ShippedData>) -> List<DataFile> / {abort.raise} =
  shipped_data_wanted(source).fold([], |accumulator: List<DataFile>, name: Bytes|
    data.fold(accumulator, |a: List<DataFile>, d: ShippedData|
      if d.name == name { a.push({ name: String::of_bytes_lossy(name), bytes: d.bytes.len() }) }
      else { a }))

fn row_of(parsed: ParsedModule, source: Source, data: List<ShippedData>) -> Row / {abort.raise} =
  {
    name: String::of_bytes_lossy(source.name),
    definitions: declared(parsed),
    tests: tested(parsed),
    bytes: source.source_text.len(),
    data: data_files_of(source, data),
    summary: match parsed.module.doc {
      Some(d) -> summary_of(d.lines.map(|l: Bytes| String::of_bytes_lossy(l))),
      None -> "",
    },
  }

fn rows_of(sources: List<Source>, data: List<ShippedData>) -> List<Row> / {abort.raise} = {
  let parsed = parse_shipped(sources, sources, data);
  range(0, sources.len()).map(|i: Int| row_of(parsed.get(i).module, sources.get(i), data))
}

const headers: List<String> = ["MODULE", "DEFINITIONS", "TESTS", "BYTES", "DATA", "SUMMARY"]

fn data_bytes(row: Row) -> Int =
  row.data.fold(0, |accumulator: Int, data_file: DataFile| accumulator + data_file.bytes)

fn cells_of(row: Row) -> List<String> =
  [
    row.name,
    row.definitions.to_string(),
    row.tests.to_string(),
    row.bytes.to_string(),
    data_bytes(row).to_string(),
    row.summary,
  ]

fn grid_of(rows: List<Row>) -> List<List<String>> =
  rows.fold([headers], |accumulator: List<List<String>>, row: Row| accumulator.push(cells_of(row)))

fn table(rows: List<Row>) -> List<String> = text::table(grid_of(rows))

fn total(rows: List<Row>) -> Int =
  rows.fold(0, |accumulator: Int, row: Row| accumulator + row.definitions)

pub fn listing(rows: List<Row>, digest: String) -> List<String> / {abort.raise} = {
  let head = [
    count_of(rows.len(), "module") ++ " · " ++ count_of(total(rows), "definition")
      ++ " · shipped with this compiler",
    "",
  ];
  let body = if rows.len() == 0 { ["this build ships no stdlib module"] } else { table(rows) };
  head.concat(body).concat(embedded(rows)).concat([
    "",
    "`import std.<name>` to use one; `ply doc std.<name>` documents it and `ply std --show <name>` prints its source, or a data file by its name",
    "",
    "digest: " ++ digest,
  ])
}

fn embedded(rows: List<Row>) -> List<String> / {abort.raise} = {
  let lines = rows.fold([], |accumulator: List<String>, row: Row|
    row.data.fold(accumulator, |a: List<String>, data_file: DataFile|
      a.push(
        data_file.name ++ " · " ++ count_of(data_file.bytes, "byte") ++ " · embedded by "
          ++ row.name,
      )));
  if lines.len() == 0 { [] } else { [""].concat(lines) }
}

fn row_json(row: Row) -> Json =
  object([
    { key: "module", value: Str(row.name) },
    { key: "definitions", value: Number(Decimal::of_int(row.definitions)) },
    { key: "tests", value: Number(Decimal::of_int(row.tests)) },
    { key: "bytes", value: Number(Decimal::of_int(row.bytes)) },
    {
      key: "data",
      value: Array(
        row.data.map(|data_file: DataFile|
          object([
            { key: "name", value: Str(data_file.name) },
            { key: "bytes", value: Number(Decimal::of_int(data_file.bytes)) },
          ])),
      ),
    },
    { key: "summary", value: Str(row.summary) },
  ])

fn listing_json(rows: List<Row>, digest: String) -> Json =
  object([
    { key: "command", value: Str("std") },
    { key: "schema_version", value: Number(Decimal::of_int(schema_version)) },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: Number(Decimal::of_int(ok_code)) },
    { key: "modules", value: Array(rows.map(row_json)) },
    { key: "definitions", value: Number(Decimal::of_int(total(rows))) },
    { key: "digest", value: Str(digest) },
    { key: "diagnostics", value: Array([]) },
  ])

fn listing_output(rows: List<Row>, digest: String) -> CommandOutput / {abort.raise} =
  {
    json: listing_json(rows, digest),
    lines: [""].concat(indented(listing(rows, digest))),
    errs: [],
    code: ok_code,
  }

fn digest_output(digest: String) -> CommandOutput =
  {
    json: object([
      { key: "command", value: Str("std") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version)) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code)) },
      { key: "digest", value: Str(digest) },
    ]),
    lines: [digest],
    errs: [],
    code: ok_code,
  }

fn source_output(kind: String, name: String, text: Bytes) -> CommandOutput = {
  let source = String::of_bytes_lossy(text);
  {
    json: object([
      { key: "command", value: Str("std") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version)) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code)) },
      { key: kind, value: Str(name) },
      { key: "source", value: Str(source) },
    ]),
    lines: source_lines(source),
    errs: [],
    code: ok_code,
  }
}

fn every_source(sources: List<Source>) -> CommandOutput = {
  let text = String::of_bytes_lossy(
    Bytes::concat_all(sources.map(|source: Source| source.source_text)),
  );
  {
    json: object([
      { key: "command", value: Str("std") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version)) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code)) },
      {
        key: "sources",
        value: Array(
          sources.map(|source: Source|
            object([
              { key: "module", value: Str(String::of_bytes_lossy(source.name)) },
              { key: "source", value: Str(String::of_bytes_lossy(source.source_text)) },
            ])),
        ),
      },
      { key: "diagnostics", value: Array([]) },
    ]),
    lines: source_lines(text),
    errs: [],
    code: ok_code,
  }
}

fn stopped(style: Style, diagnostic: Diagnostic) -> CommandOutput / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("std") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version)) },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: Number(Decimal::of_int(compile_error)) },
      { key: "diagnostics", value: all_to_json([diagnostic], []) },
    ]),
    lines: [],
    errs: all_to_text(style, [diagnostic], []),
    code: compile_error,
  }

pub fn unknown_module(query: String, names: List<String>, data: List<String>) -> Diagnostic = {
  let ticked = |entries: List<String>| String::join(entries.map(|n: String| "`" ++ n ++ "`"), ", ");
  let also = if data.len() == 0 { [] }
  else { [Bytes::of_string("and the data files its modules embed: " ++ ticked(data))] };
  error_at(
    b"E0106",
    no_module,
    dummy_span,
    Bytes::of_string("no module named `" ++ query ++ "` ships with this compiler"),
    b"not found",
    [Bytes::of_string("the standard library contains: " ++ ticked(names))].concat(also).concat([
      b"`ply std` lists them, with a hash of the sources this binary was built from",
    ]),
  )
}

fn show_output(
  style: Style,
  query: String,
  sources: List<Source>,
  data: List<ShippedData>,
) -> CommandOutput / {abort.raise} =
  match sources.filter(|source: Source| String::of_bytes_lossy(source.name) == query) {
    [source, ..] -> source_output("module", query, source.source_text),
    [] -> match data.filter(|d: ShippedData| String::of_bytes_lossy(d.name) == query) {
      [d, ..] -> source_output("data", query, d.bytes),
      [] ->
        stopped(
          style,
          unknown_module(
            query,
            sources.map(|source: Source| String::of_bytes_lossy(source.name)),
            data.map(|data_file: ShippedData| String::of_bytes_lossy(data_file.name)),
          ),
        ),
    },
  }

fn count_output(sources: List<Source>, data: List<ShippedData>) -> CommandOutput / {abort.raise} =
  listing_output(rows_of(sources, data), shipped_digest_of(sources, data))

const shipped_results_roots: List<Bytes> = [b"stdlib.pack_shipped_results"]

pub fn shipped_results_digest() -> CommandOutput / {shipped.definitions, abort.raise} = {
  let identity = String::of_bytes_lossy(identity_of(shipped.definitions(), shipped_results_roots));
  {
    json: object([
      { key: "command", value: Str("std") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version)) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code)) },
      { key: "answering", value: Str(identity) },
    ]),
    lines: [identity],
    errs: [],
    code: ok_code,
  }
}

pub fn pack_shipped_results(
  dir: String,
  reused: String,
  phases: Bool,
) -> CommandOutput / {fs.list_dir[shipped], fs.read_file[shipped], fs.read[abs], fs.write[abs], process.err[proc], time.elapsed_ms, Derives, abort.raise} = {
  let names = shipped_modules().map(|s: Source| s.name);
  let work = strip_root(shipped_store_dir(reused));
  let started = time.elapsed_ms();
  let check_outcome = module_queries::shipped_results[abs](work, names);
  timed(phases, "checked the shipped modules", started);
  match check_outcome.rejected {
    [] -> packed_results(dir, work, names.len(), check_outcome.keys, phases),
    rejected -> stopped(plain, shipped_rejected(rejected)),
  }
}

fn shipped_rejected(rejected: List<CheckedModule>) -> Diagnostic =
  error_at(
    b"E0505",
    no_module,
    dummy_span,
    Bytes::concat_all([
      b"shipped modules do not check: ",
      Bytes::join(rejected.map(|a: CheckedModule| a.module), b", "),
    ]),
    b"so the pack of check results for the shipped modules was not written",
    rejected.map(|a: CheckedModule|
      match a.result.rejected {
        [d, ..] -> Bytes::concat_all([a.module, b": ", d.code, b" ", d.message]),
        [] -> a.module,
      }),
  )

fn packed_results(
  dir: String,
  work: String,
  modules: Int,
  keys: List<Bytes>,
  phases: Bool,
) -> CommandOutput / {fs.read[abs], fs.write[abs], fs.read_file[shipped], process.err[proc], time.elapsed_ms, abort.raise} = {
  let returned = time.elapsed_ms();
  let pack = module_queries::write_shipped_pack[abs](work, keys);
  timed(phases, "compressed the pack", returned);
  let packed = time.elapsed_ms();
  let to = strip_root(dir) ++ "/pack";
  let claimed = fs.create_dir[abs](to) && fs.write_file[abs](strip_root(dir) ++ "/standing", b"");
  let wrote = claimed && fs.write_file[abs](to ++ "/" ++ packs::store_file, pack.written.store)
    && fs.write_file[abs](to ++ "/" ++ packs::index_file, pack.written.index);
  timed(phases, "wrote the pack", packed);
  if !wrote {
    stopped(
      plain,
      error_at(
        b"E0502",
        no_module,
        dummy_span,
        Bytes::of_string("could not write `" ++ dir ++ "/pack`"),
        b"the shipped modules were checked but not packed",
        [],
      ),
    )
  } else {
    {
      json: object([
        { key: "schema_version", value: Number(Decimal::of_int(schema_version)) },
        { key: "modules", value: Number(Decimal::of_int(modules)) },
        { key: "records", value: Number(Decimal::of_int(pack.records)) },
      ]),
      lines: [
        indent ++ "checked " ++ count_of(modules, "shipped module") ++ " into "
          ++ count_of(pack.records, "record")
          ++ " at "
          ++ dir,
      ],
      errs: [],
      code: ok_code,
    }
  }
}

pub fn run(
  flags: Flags,
) -> CommandOutput / {fs.list_dir[shipped], fs.read_file[shipped], abort.raise} = {
  let s = style_of(flags);
  let sources = shipped();
  if flags.query == "*" && !flags.digest { every_source(sources) } else {
    let data = shipped_data(sources);
    if flags.digest { digest_output(shipped_digest_of(sources, data)) }
    else if flags.query != "" { show_output(s, flags.query, sources, data) }
    else { count_output(sources, data) }
  }
}

const two_rows: List<Row> =
  [
    {
      name: "std.bytes",
      definitions: 12,
      tests: 4,
      bytes: 3100,
      data: [],
      summary: "Integers in bytes.",
    },
    {
      name: "std.json",
      definitions: 130,
      tests: 40,
      bytes: 29000,
      data: [{ name: "std/json/escapes.txt", bytes: 96 }, { name: "std/json/words.txt", bytes: 4 }],
      summary: "",
    },
  ]

test "the listing starts with a summary line, then lays out the table columns, and ends with the digest line" {
  let lines = listing(two_rows, "b3:1f2e3d4c5b6a");
  assert_eq(
    match lines.at(0) { Some(l) -> l, None -> "" },
    "2 modules · 142 definitions · shipped with this compiler",
  );
  assert_eq(match lines.at(1) { Some(l) -> l, None -> "" }, "");
  assert_eq(
    match lines.at(2) { Some(l) -> l, None -> "" },
    "MODULE     DEFINITIONS  TESTS  BYTES  DATA  SUMMARY",
  );
  assert_eq(
    match lines.at(3) { Some(l) -> l, None -> "" },
    "std.bytes  12           4      3100   0     Integers in bytes.",
  );
  assert_eq(
    match lines.at(4) { Some(l) -> l, None -> "" },
    "std.json   130          40     29000  100",
  );
  assert_eq(match lines.at(lines.len() - 1) { Some(l) -> l, None -> "" }, "digest: b3:1f2e3d4c5b6a")
}

test "the listing names each data file a module embeds, and names no data files when no module embeds any" {
  assert_eq(embedded(two_rows), [
    "",
    "std/json/escapes.txt · 96 bytes · embedded by std.json",
    "std/json/words.txt · 4 bytes · embedded by std.json",
  ]);
  assert_eq(embedded([]), [])
}

test "`--show` prints a data file by the name the listing gives it, and prints a module by its module name" {
  let sources = [
    { name: b"std.m", source_text: b"pub fn list() -> Bytes = embed(\"m/list.txt\")\n" },
  ];
  let data = [{ name: b"std/m/list.txt", bytes: b"one\ntwo\n" }];
  assert_eq(show_output(plain, "std/m/list.txt", sources, data).lines, ["one", "two"]);
  assert_eq(show_output(plain, "std.m", sources, data).lines, [
    "pub fn list() -> Bytes = embed(\"m/list.txt\")",
  ]);
  assert_eq(show_output(plain, "std/m/gone.txt", sources, data).code, 2);
  assert_eq(rows_of(sources, data).map(|row: Row| row.data), [
    [{ name: "std/m/list.txt", bytes: 8 }],
  ])
}

test "a build that ships nothing says so instead of laying out an empty table" {
  let lines = listing([], "b3:000000000000");
  assert_eq(
    match lines.at(0) { Some(l) -> l, None -> "" },
    "0 modules · 0 definitions · shipped with this compiler",
  );
  assert_eq(match lines.at(2) { Some(l) -> l, None -> "" }, "this build ships no stdlib module")
}

test "`--digest` prints only the digest line, which a CI check can compare against a fixed value" {
  let result = digest_output("b3:1f2e3d4c5b6a");
  assert_eq(result.lines, ["b3:1f2e3d4c5b6a"]);
  assert_eq(result.errs, []);
  assert_eq(result.code, 0)
}

test "`--show` with no argument prints every source one after another, in name order" {
  let result = every_source([
    { name: Bytes::of_string("std.bytes"), source_text: b"fn a() -> Int = 1\n" },
    { name: Bytes::of_string("std.json"), source_text: b"fn b() -> Int = 2\n" },
  ]);
  assert_eq(result.lines, ["fn a() -> Int = 1", "fn b() -> Int = 2"]);
  assert_eq(result.errs, []);
  assert_eq(result.code, 0)
}

test "a module name that is not shipped is `E0106`, and the error lists the module names that are shipped" {
  let d = unknown_module("std.nope", ["std.bytes", "std.json"], []);
  assert_eq(d.code, b"E0106");
  assert_eq(d.message, b"no module named `std.nope` ships with this compiler");
  assert_eq(
    match d.notes_text.at(0) { Some(n) -> n, None -> b"" },
    b"the standard library contains: `std.bytes`, `std.json`",
  );
  assert_eq(d.notes_text.len(), 2);
  assert_eq(
    unknown_module("std/m/gone.txt", ["std.m"], ["std/m/list.txt"]).notes_text.at(1),
    Some(b"and the data files its modules embed: `std/m/list.txt`"),
  )
}

test "a module's source is printed as separate lines, one per line of the source" {
  let result = source_output("module", "std.m", b"pub fn one() -> Int = 1\n");
  assert_eq(result.lines, ["pub fn one() -> Int = 1"]);
  assert_eq(result.code, 0)
}
