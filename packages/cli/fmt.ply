import std.fs (fs, mem_empty, mem_of, mem_read, mem_kind, mem_list, mem_write, MemFs, WriteResult)
import std.json (Json, Str, Bool, Number, Array, object, to_string)
import std.list
import args (Flags, from_argv)
import paths (ResolvedPath, RootedPath, displayed, read_file, write_file, at_abs)
import report (CommandOutput, schema_version, ok_code, compile_error)
import walk (Failure, WalkResult, walk_paths)
import compiler.syntax.fmt (fmt_source)

type Outcome = { path: String, changed: Bool }

type Report = { files: List<Outcome>, errors: List<Failure> }

fn record_file(report: Report, path: String, changed: Bool) -> Report =
  { ..report, files: report.files.push({ path: path, changed: changed }) }

fn record_error(report: Report, path: String, reason: String) -> Report =
  { ..report, errors: report.errors.push({ path: path, reason: reason }) }

fn format_one(
  report: Report,
  check: Bool,
  rooted: RootedPath,
) -> Report / {fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], abort.raise} = {
  let path = displayed(rooted);
  match read_file(rooted) {
    None -> record_error(report, path, "could not read"),
    Some(source) -> match fmt_source(source) {
      Err(reason) -> record_error(report, path, String::of_bytes_lossy(reason)),
      Ok(out) -> if out == source { record_file(report, path, false) }
      else if check { record_file(report, path, true) }
      else if write_file(rooted, out) { record_file(report, path, true) }
      else { record_error(report, path, "could not write") },
    },
  }
}

fn format_all(
  flags: Flags,
) -> Report / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], abort.raise} = {
  let found: WalkResult = walk_paths(flags.paths);
  let start: Report = { files: [], errors: found.errors };
  found.files.values().fold(start, |accumulator: Report, rooted: RootedPath|
    format_one(accumulator, flags.check, rooted))
}

fn changed_files(report: Report) -> List<Outcome> =
  report.files.filter(|outcome: Outcome| outcome.changed)

fn exit_code(report: Report, check: Bool) -> Int =
  if report.errors.len() > 0 { compile_error }
  else if check && changed_files(report).len() > 0 { 1 }
  else { ok_code }

fn json_report(report: Report, code: Int) -> Json =
  object([
    { key: "command", value: Str("fmt") },
    { key: "schema_version", value: Number(Decimal::of_int(schema_version)) },
    { key: "ok", value: Bool(code == 0) },
    { key: "exit_code", value: Number(Decimal::of_int(code)) },
    {
      key: "files",
      value: Array(
        report.files.map(|outcome: Outcome|
          object([
            { key: "path", value: Str(outcome.path) },
            { key: "changed", value: Bool(outcome.changed) },
          ])),
      ),
    },
    {
      key: "errors",
      value: Array(
        report.errors.map(|e: Failure|
          object([{ key: "path", value: Str(e.path) }, { key: "error", value: Str(e.reason) }])),
      ),
    },
  ])

fn fmt_output(report: Report, flags: Flags) -> CommandOutput = {
  let code = exit_code(report, flags.check);
  let verb = if flags.check { "would format " } else { "formatted " };
  {
    json: json_report(report, code),
    lines: changed_files(report).map(|outcome: Outcome| verb ++ outcome.path),
    errs: report.errors.map(|e: Failure| "error: " ++ e.path ++ ": " ++ e.reason),
    code: code,
  }
}

pub fn run(
  flags: Flags,
) -> CommandOutput / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], abort.raise} =
  fmt_output(format_all(flags), flags)

type FormatRun = { here: MemFs, root: MemFs, result: CommandOutput }

const unformatted: Bytes = b"fn  add(a: Int,b: Int)->Int = a+b\n"

fn run_in(here: MemFs, root: MemFs, flags: Flags) -> FormatRun / {abort.raise} =
  handle {
    run(flags)
  } with {
    var h = here,
    var a = root,
    fs.kind[cwd](p) -> mem_kind(h, p),
    fs.kind[abs](p) -> mem_kind(a, p),
    fs.list_dir[cwd](p) -> mem_list(h, p),
    fs.list_dir[abs](p) -> mem_list(a, p),
    fs.read_file[cwd](p) -> mem_read(h, p),
    fs.read_file[abs](p) -> mem_read(a, p),
    fs.write_file[cwd](p, body) -> {
      let written: WriteResult = mem_write(h, p, body);
      h = written.fs;
      written.ok
    },
    fs.write_file[abs](p, body) -> {
      let written: WriteResult = mem_write(a, p, body);
      a = written.fs;
      written.ok
    },
    return result -> { here: h, root: a, result: result },
  }

fn run_over(
  files: List<{ path: String, body: Bytes }>,
  argv: List<String>,
) -> FormatRun / {abort.raise} = run_in(mem_of(files), mem_empty(), from_argv("fmt", argv))

test "a file is rewritten once, and a second run over the result changes nothing" {
  let once = run_over([{ path: "m.ply", body: unformatted }], []);
  assert_eq(once.result.lines, ["formatted m.ply"]);
  assert_eq(once.result.errs, []);
  assert_eq(once.result.code, 0);
  match mem_read(once.here, "m.ply") {
    None -> panic("the file was written back"),
    Some(body) -> {
      assert(body != unformatted);
      let twice = run_over([{ path: "m.ply", body: body }], []);
      assert_eq(twice.result.lines, []);
      assert_eq(twice.result.code, 0);
      assert_eq(mem_read(twice.here, "m.ply"), Some(body))
    },
  }
}

test "`--check` names what would change, writes nothing and exits 1" {
  let run = run_over([{ path: "m.ply", body: unformatted }], ["--check"]);
  assert_eq(run.result.lines, ["would format m.ply"]);
  assert_eq(run.result.code, 1);
  assert_eq(mem_read(run.here, "m.ply"), Some(unformatted))
}

test "`ply fmt` reads and rewrites a directory outside the working directory by its absolute path, and reports that path" {
  let root = mem_of([{ path: "srv/app/m.ply", body: unformatted }]);
  let checked = run_in(mem_empty(), root, {
    ..from_argv("fmt", ["--check"]),
    paths: [at_abs("srv/app")],
  });
  assert_eq(checked.result.errs, []);
  assert_eq(checked.result.lines, ["would format /srv/app/m.ply"]);
  assert_eq(checked.result.code, 1);
  let formatted = run_in(mem_empty(), root, { ..from_argv("fmt", []), paths: [at_abs("srv/app")] });
  assert_eq(formatted.result.errs, []);
  assert_eq(formatted.result.lines, ["formatted /srv/app/m.ply"]);
  assert_eq(formatted.result.code, 0);
  assert(mem_read(formatted.root, "srv/app/m.ply") != Some(unformatted));
  assert_eq(mem_read(formatted.here, "srv/app/m.ply"), None)
}

test "a file that does not parse is reported with its diagnostic and left as it was" {
  let broken = b"fn f( = 1\n";
  let run = run_over([{ path: "m.ply", body: broken }], []);
  assert_eq(run.result.lines, []);
  assert_eq(run.result.code, 2);
  assert_eq(mem_read(run.here, "m.ply"), Some(broken));
  assert_eq(run.result.errs.len(), 1);
  assert(run.result.errs.at_or(0, "").starts_with("error: m.ply: "));
  assert(run.result.errs.at_or(0, "").contains("E0001"))
}

test "a path that names nothing is an error, and the run exits 2" {
  let run = run_over([{ path: "m.ply", body: unformatted }], ["absent.ply"]);
  assert_eq(run.result.lines, []);
  assert_eq(run.result.errs, ["error: absent.ply: could not read"]);
  assert_eq(run.result.code, 2);
  assert_eq(mem_read(run.here, "m.ply"), Some(unformatted))
}

test "`ply fmt --check` fails on a file it found but could not read, instead of skipping it" {
  let tree = mem_of([{ path: "m.ply", body: unformatted }]);
  let result = handle {
    run(from_argv("fmt", ["--check"]))
  } with {
    fs.kind[cwd](p) -> mem_kind(tree, p),
    fs.kind[abs](p) -> panic("nothing here leaves the working directory"),
    fs.list_dir[cwd](p) -> mem_list(tree, p),
    fs.list_dir[abs](p) -> panic("nothing here leaves the working directory"),
    fs.read_file[cwd](p) -> None,
    fs.read_file[abs](p) -> panic("nothing here leaves the working directory"),
    fs.write_file[cwd](p, body) -> panic("`--check` writes nothing"),
    fs.write_file[abs](p, body) -> panic("`--check` writes nothing"),
  };
  assert_eq(result.lines, []);
  assert_eq(result.errs, ["error: m.ply: could not read"]);
  assert_eq(result.code, 2)
}

test "a file that could not be written back fails the run" {
  let tree = mem_of([{ path: "m.ply", body: unformatted }]);
  let result = handle {
    run(from_argv("fmt", []))
  } with {
    fs.kind[cwd](p) -> mem_kind(tree, p),
    fs.kind[abs](p) -> panic("nothing here leaves the working directory"),
    fs.list_dir[cwd](p) -> mem_list(tree, p),
    fs.list_dir[abs](p) -> panic("nothing here leaves the working directory"),
    fs.read_file[cwd](p) -> mem_read(tree, p),
    fs.read_file[abs](p) -> panic("nothing here leaves the working directory"),
    fs.write_file[cwd](p, body) -> false,
    fs.write_file[abs](p, body) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(result.lines, []);
  assert_eq(result.errs, ["error: m.ply: could not write"]);
  assert_eq(result.code, 2)
}

test "the JSON document is one object, its keys in order, and nothing else is written" {
  let run = run_over([{ path: "m.ply", body: unformatted }], ["--json", "--check"]);
  assert_eq(run.result.errs, []);
  assert_eq(run.result.code, 1);
  assert_eq(
    Bytes::of_string(to_string(run.result.json)),
    b"{\"command\":\"fmt\",\"errors\":[],\"exit_code\":1,\"files\":[{\"changed\":true,\"path\":\"m.ply\"}],\"ok\":false,\"schema_version\":1}",
  )
}

test "the exit code is 2 for an error, 1 for `--check` when a file would change, and 0 otherwise" {
  let clean: Report = { files: [{ path: "a.ply", changed: false }], errors: [] };
  let moved: Report = { files: [{ path: "a.ply", changed: true }], errors: [] };
  let broken: Report = { files: [], errors: [{ path: "a.ply", reason: "could not read" }] };
  assert_eq(exit_code(clean, false), 0);
  assert_eq(exit_code(clean, true), 0);
  assert_eq(exit_code(moved, false), 0);
  assert_eq(exit_code(moved, true), 1);
  assert_eq(exit_code(broken, false), 2);
  assert_eq(exit_code(broken, true), 2)
}
