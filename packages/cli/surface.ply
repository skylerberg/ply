import compiler.cc
import sim.plan
import std.cli (Choice, Command, Flag, Help, Nat, Outcome, Parsed, Positive, Positional, Failed,
                Run, Spec, Text, Version, with_bare_value, body, with_check, command, conflicting,
                defaulted, required_unless, faults, has, help, many, parse, parse_nat, positional,
                error_text, repeated, requiring, switch, value, valued, values_of, version_line,
                with_default, with_extra, with_positionals, with_short, with_subs, with_trailing)
import std.list
import std.string

fn seed_ok(text: String) -> Result<Unit, String> / {abort.raise} =
  match plan::parse_seed(text) {
    Some(_) -> Ok(()),
    None ->
      Err(
        "`" ++ text
          ++ "` is not a seed; a seed is `7`, which searches with seed 7, or `7:3.0.2`, which replays one interleaving of concurrent tasks; copy the seed from the failure output",
      ),
  }

fn digit_char(c: String) -> Bool = at_least(c, "0") && at_most(c, "9")

fn at_least(a: String, b: String) -> Bool = match compare(a, b) { Less -> false, _ -> true }

fn at_most(a: String, b: String) -> Bool = match compare(a, b) { Greater -> false, _ -> true }

fn label_char(c: String) -> Bool =
  digit_char(c) || (at_least(c, "a") && at_most(c, "z")) || (at_least(c, "A") && at_most(c, "Z"))
    || c == "_"

fn label_chars(name: String, at: Int) -> Bool / {abort.raise} =
  if at >= name.len() { true }
  else { label_char(name.slice(at, at + 1)) && label_chars(name, at + 1) }

fn is_label(name: String) -> Bool / {abort.raise} =
  name.len() > 0 && !digit_char(name.slice(0, 1)) && label_chars(name, 0)

fn credential_ok(text: String) -> Result<Unit, String> / {abort.raise} =
  match text.split_once("=") {
    None -> Err(credential_err(text, "there is no `=`")),
    Some(pair) -> match pair.tail.split_once(",") {
      None -> Err(credential_err(text, "there is no `,` between the certificate and the key")),
      Some(paths) -> if pair.head == "" { Err(credential_err(text, "the credential has no name")) }
      else if paths.head == "" || paths.tail == "" { Err(credential_err(text, "a path is empty")) }
      else { Ok(()) },
    },
  }

fn credential_err(text: String, reason: String) -> String =
  "`" ++ text ++ "` is not a TLS credential: " ++ reason ++ "; write `--tls NAME=CERT.pem,KEY.pem`"

fn root_ok(text: String) -> Result<Unit, String> / {abort.raise} =
  match text.split_once("=") {
    None -> Err(root_err(text, "there is no `=`")),
    Some(pair) -> if pair.head == "" { Err(root_err(text, "the root has no name")) }
    else if pair.tail == "" { Err(root_err(text, "the path is empty")) }
    else if !is_label(pair.head) { Err(root_err(text, label_rule("a root's"))) }
    else { Ok(()) },
  }

fn root_err(text: String, reason: String) -> String =
  "`" ++ text ++ "` is not a filesystem root: " ++ reason ++ "; write `--fs NAME=PATH`"

fn executable_ok(text: String) -> Result<Unit, String> / {abort.raise} =
  match text.split_once("=") {
    None -> Err(executable_err(text, "there is no `=`")),
    Some(pair) -> if pair.head == "" { Err(executable_err(text, "the executable has no name")) }
    else if pair.tail == "" { Err(executable_err(text, "the path is empty")) }
    else if !is_label(pair.head) { Err(executable_err(text, label_rule("an executable's"))) }
    else { Ok(()) },
  }

fn executable_err(text: String, reason: String) -> String =
  "`" ++ text ++ "` is not an executable: " ++ reason ++ "; write `--exec NAME=PATH`"

fn label_rule(whose: String) -> String =
  whose ++ " name must be an identifier: letters, digits and `_`, not starting with a digit"

fn json_flag() -> Flag =
  switch(
    "json",
    "Emit one JSON object on stdout; what the command prints as it runs goes to stderr.",
  )

fn optional(name: String, help: String) -> Positional = {
  let base: Positional = positional(name, help);
  { ..base, required: false }
}

const path_positional: Positional =
  optional(
    "PATH",
    "A `.ply` file or a directory: the package that contains it, or the path itself when it is not in a package. Defaults to the package of the working directory.",
  )

fn filter_flag(help: String) -> Flag = valued("filter", "SUBSTRING", Text, help)

fn jobs_flag() -> Flag =
  with_short(valued("jobs", "N", Positive, "Worker threads. Defaults to one per core."), "j")

pub const default_timeout_ms: Int = 60000

fn timeout_flag(help: String) -> Flag =
  with_default(valued("timeout", "MS", Nat, help), default_timeout_ms.to_string())

fn profile_flag(help: String) -> Flag =
  with_default(
    valued("profile", "PROFILE", Choice(cc::profiles.map(|p: cc::Profile| p.name)), help),
    cc::development().name,
  )

pub fn profile_of(p: Parsed) -> cc::Profile =
  match List::find(cc::profiles, |named: cc::Profile| value(p, "profile") == Some(named.name)) {
    Some(named) -> named,
    None -> cc::development(),
  }

fn simulation_flags() -> List<Flag> =
  [
    conflicting(seed_flag(), ["sim", "seeds", "seed-range", "sim-budget"]),
    with_default(
      valued(
        "sim",
        "MODE",
        Choice(["once", "random", "dpor"]),
        "Which search each simulated test runs.",
      ),
      "dpor",
    ),
    valued(
      "seeds",
      "N",
      Positive,
      "Seeds per simulated test, from 0. Defaults to 1 under `dpor` and 64 under `random`.",
    ),
    conflicting(
      with_check(
        valued(
          "seed-range",
          "FROM..TO",
          Text,
          "Search only the seeds from FROM up to but not including TO, rather than the number given by `--seeds`: `5..6` searches seed 5 alone.",
        ),
        seed_range_ok,
      ),
      ["seeds"],
    ),
    valued(
      "sim-budget",
      "N",
      Positive,
      "The maximum number of task orderings to try for each seed. Only the `dpor` strategy (dynamic partial-order reduction) tries more than one.",
    ),
    valued(
      "sim-steps",
      "N",
      Positive,
      "Scheduling steps one interleaving may take before it reports no progress.",
    ),
    switch(
      "measure-reduction",
      "Also run the search twice more, once without skipping orderings that are equivalent to ones already tried and once without using the ordering that spawning and joining tasks already fixes, and report how much work each run did.",
    ),
  ]

pub fn range_of(text: String) -> Option<{ from: Int, to: Int }> / {abort.raise} =
  match text.split_once("..") {
    None -> None,
    Some(cut) -> match parse_nat(cut.head) {
      None -> None,
      Some(from) -> match parse_nat(cut.tail) {
        None -> None,
        Some(to) -> if from < to { Some({ from: from, to: to }) } else { None },
      },
    },
  }

fn seed_range_ok(text: String) -> Result<Unit, String> / {abort.raise} =
  match range_of(text) {
    Some(_) -> Ok(()),
    None ->
      Err(
        "`" ++ text
          ++ "` is not a range of seeds; write `FROM..TO` with FROM below TO, as in `5..6` for seed 5",
      ),
  }

pub type Shard = { index: Int, count: Int }

pub fn shard_of(text: String) -> Option<Shard> / {abort.raise} =
  match text.split_once("/") {
    None -> None,
    Some(cut) -> match parse_nat(cut.head) {
      None -> None,
      Some(index) -> match parse_nat(cut.tail) {
        None -> None,
        Some(count) -> if 1 <= index && index <= count { Some({ index: index, count: count }) }
        else { None },
      },
    },
  }

fn shard_ok(text: String) -> Result<Unit, String> / {abort.raise} =
  match shard_of(text) {
    Some(_) -> Ok(()),
    None ->
      Err(
        "`" ++ text
          ++ "` is not a part of a run; write `K/N` with K from 1 to N, as in `2/3` for the second of three",
      ),
  }

fn seed_flag() -> Flag =
  with_check(
    valued(
      "seed",
      "SEED",
      Text,
      "Replay exactly one interleaving: `7`, or `7:3.0.2`. Implies `--sim once`.",
    ),
    seed_ok,
  )

fn tls_flags() -> List<Flag> =
  [
    repeated(
      with_check(
        valued(
          "tls",
          "NAME=CERT,KEY",
          Text,
          "TLS credential: `--tls api=certs/api.pem,certs/api.key`. Repeatable, one per listener.",
        ),
        credential_ok,
      ),
    ),
    repeated(
      valued(
        "trust",
        "CERT.pem",
        Text,
        "A certificate that `net.connect_tls` trusts in addition to the built-in roots, and that a listener uses to verify client certificates. Repeatable.",
      ),
    ),
    repeated(
      valued(
        "mtls",
        "NAME",
        Text,
        "Require clients of this `--tls` listener to present a certificate that `--trust` verifies. Repeatable.",
      ),
    ),
  ]

fn fs_flags() -> List<Flag> =
  [
    repeated(
      with_check(
        valued(
          "fs",
          "NAME=PATH",
          Text,
          "Directory that the program may use as a filesystem, for example `--fs src=./crates` gives the name `src` the directory `./crates`. Repeat the flag to give each NAME its own directory.",
        ),
        root_ok,
      ),
    ),
  ]

fn exec_flags() -> List<Flag> =
  [
    repeated(
      with_check(
        valued(
          "exec",
          "NAME=PATH",
          Text,
          "Program that `process.spawn` or `process.start` may start under the name NAME: `--exec cc=/usr/bin/cc`. Repeatable.",
        ),
        executable_ok,
      ),
    ),
  ]

fn allow_flags() -> List<Flag> =
  [
    repeated(
      with_check(
        valued(
          "allow",
          "NAME",
          Text,
          "Grant a privileged permission that the program declares by name: `machine`, `shipped` or `toolchain`. Repeatable.",
        ),
        family_ok,
      ),
    ),
  ]

fn family_ok(text: String) -> Result<Unit, String> / {abort.raise} =
  if text == "" { Err("a family needs a name") }
  else if Bytes::of_string(text).at(0) < 97 || Bytes::of_string(text).at(0) > 122 {
    Err("a family name is lower-case letters and `_`")
  } else { Ok(()) }

fn config_flags() -> List<Flag> =
  [
    repeated(
      valued(
        "set",
        "KEY=VALUE",
        Text,
        "A configuration value: `--set SERVICE_REGION=eu`. Repeatable; highest precedence, last wins.",
      ),
    ),
    repeated(
      valued(
        "config",
        "PATH",
        Text,
        "A `KEY=VALUE` file, one pair per line, no quoting. Repeatable; a later file wins.",
      ),
    ),
    valued(
      "config-schema",
      "MODULE.FN",
      Text,
      "`<module>.<fn>`: a pure function with no parameters that returns a `ConfigSpec`, checked at start-up.",
    ),
  ]

fn trace_flags() -> List<Flag> =
  [
    with_default(
      valued(
        "trace",
        "SINK",
        Choice(["json", "text", "off"]),
        "Where a `trace` record goes: `json` lines or `text` lines on stderr, or `off`.",
      ),
      "json",
    ),
    with_default(
      valued(
        "trace-level",
        "LEVEL",
        Choice(["debug", "info", "warn", "error"]),
        "The lowest level the sink writes; spans and metrics are `info`.",
      ),
      "info",
    ),
  ]

fn shutdown_flags() -> List<Flag> =
  [
    with_default(
      valued(
        "drain-ms",
        "MS",
        Nat,
        "How long in-flight requests have to finish after accepting stops (else `W0608`, exit 3).",
      ),
      "30000",
    ),
    with_default(
      valued(
        "drain-lead-ms",
        "MS",
        Nat,
        "How long the server keeps accepting new connections after the shutdown signal arrives. During this time a health check route can return `503`, which tells the load balancer to stop sending requests.",
      ),
      "0",
    ),
  ]

fn prove_flags() -> List<Flag> =
  [
    valued(
      "prove-budget",
      "N",
      Positive,
      "Static inference steps per obligation; one whose budget runs out is left unproved.",
    ),
    timeout_flag(
      "Wall clock for each entry a claim's evaluation makes, in milliseconds; past it the evaluation stops, proves nothing and is not cached. 0 is no clock.",
    ),
  ]

fn flat(xss: List<List<Flag>>) -> List<Flag> =
  xss.fold([], |accumulator: List<Flag>, xs: List<Flag>|
    xs.fold(accumulator, |a: List<Flag>, flag: Flag| a.push(flag)))

fn sim_conflict(parsed: Parsed) -> Result<Unit, String> =
  if value(parsed, "sim") == Some("random") && has(parsed, "sim-budget") {
    Err(
      "`--sim-budget` has no meaning under `--sim random`, which runs one interleaving per seed; widen the search with `--seeds N`, or use `--sim dpor` to spend a budget per seed",
    )
  } else { Ok(()) }

fn new_command() -> Command =
  with_positionals(
    command("new", "Start a package: a `ply.pkg`, a first module and a first test.", [
      valued("name", "NAME", Text, "The package's name; the last segment of the path when absent."),
      switch("lib", "A library: no `main`, and a `pub` definition to import."),
      json_flag(),
    ]),
    [positional("PATH", "The directory to make the package in; its last segment names it.")],
  )

fn workspace_flag() -> Flag =
  switch(
    "workspace",
    "Also run every package this one depends on by path, each on its own, dependencies first.",
  )

fn verify_dependencies_flag() -> Flag =
  switch(
    "verify-dependencies",
    "Read every dependency from source, and reject one whose published interface does not re-derive from it (E0149).",
  )

fn check_command() -> Command =
  with_positionals(
    command("check", "Typecheck a file or directory.", [
      switch("types", "Print the inferred signature and effects of every definition."),
      switch(
        "costs",
        "Print, for every `List::push`, `List::set` and `Array::set`, whether it updates in place or copies.",
      ),
      json_flag(),
      switch(
        "explain",
        "Report where the front end's time went, and where every result came from.",
      ),
      workspace_flag(),
      verify_dependencies_flag(),
    ]),
    [path_positional],
  )

fn test_command() -> Command =
  with_extra(
    with_positionals(
      command(
        "test",
        "Select, schedule and run the tests.",
        flat([
          [
            json_flag(),
            switch(
              "explain",
              "Show why each test was selected or skipped, and how concurrency groups formed.",
            ),
            switch("no-cache", "Neither read nor write the result cache: every test runs."),
            repeated(
              filter_flag(
                "Only consider tests whose `<module>.<label>` key contains this substring; one naming a module (`std.ascii85.`) matches from a key's module on, never inside a label. Repeatable: a test any of them matches runs.",
              ),
            ),
            with_check(
              valued(
                "shard",
                "K/N",
                Text,
                "Run part K of N of the tests the other options select. Each test, and each case of a test with cases, goes to a part by a hash of its key, so it is in the same part every run.",
              ),
              shard_ok,
            ),
            jobs_flag(),
            timeout_flag(
              "Wall clock per test, in milliseconds; past it the run times out rather than being judged, and nothing it did is recorded. 0 is no clock.",
            ),
            switch(
              "coverage",
              "Report which tests run each definition, and the definitions that no test runs.",
            ),
            profile_flag(
              "C toolchain: `development` (`tcc` on x86-64 Linux, else `cc -O0`) or `release` (`cc -O2`).",
            ),
            switch(
              "watch",
              "Stay running: re-select and re-run whenever a `.ply` file under the path changes.",
            ),
            conflicting(workspace_flag(), ["watch"]),
            verify_dependencies_flag(),
          ],
          tls_flags(),
          fs_flags(),
          exec_flags(),
          allow_flags(),
          config_flags(),
          simulation_flags(),
        ]),
      ),
      [path_positional],
    ),
    sim_conflict,
  )

fn prove_command() -> Command =
  with_extra(
    with_positionals(
      command(
        "prove",
        "Prove every property the program declares, and fail on any property that is not proved.",
        flat([
          [
            json_flag(),
            switch(
              "explain",
              "Show where each result came from: the cache, or a proof made in this run.",
            ),
            switch(
              "static-prover",
              "Also run the static prover alone on every obligation, cached or not, and report what it decided and where it stopped (`--json`).",
            ),
            switch(
              "no-cache",
              "Neither read nor write the proof cache: every property is proved again.",
            ),
            repeated(
              filter_flag(
                "Only consider properties of definitions whose name contains this substring. Repeatable: a property is considered if any of them matches.",
              ),
            ),
            jobs_flag(),
            switch("no-incremental", "Check every module afresh, reusing nothing."),
            workspace_flag(),
            verify_dependencies_flag(),
          ],
          prove_flags(),
          simulation_flags(),
        ]),
      ),
      [path_positional],
    ),
    sim_conflict,
  )

fn review_command() -> Command =
  with_extra(
    with_positionals(
      command(
        "review",
        "Report what changed and whether its specification and obligations still hold.",
        flat([
          [
            switch(
              "changed",
              "Report only what moved since the last accepted review (the default).",
            ),
            conflicting(
              switch(
                "accept",
                "Record the current definitions and specifications as reviewed, keyed by name.",
              ),
              ["changed"],
            ),
            json_flag(),
            switch("no-cache", "Neither read nor write the obligation cache."),
            switch("no-incremental", "Check every module afresh, reusing nothing."),
          ],
          prove_flags(),
          simulation_flags(),
        ]),
      ),
      [path_positional],
    ),
    sim_conflict,
  )

fn run_command() -> Command =
  with_trailing(
    with_positionals(
      command(
        "run",
        "Evaluate `main` (a directory must contain exactly one), or run a built `.plyx`. Standard output contains only what the program writes.",
        flat([
          [
            json_flag(),
            switch(
              "explain",
              "Print to standard error whether the front end ran or reused an earlier result, how long loading took and what the program may access. After the run, also print how the program finished.",
            ),
            with_default(
              valued(
                "timeout",
                "MS",
                Nat,
                "Wall clock for the entry point, in milliseconds; past it the run times out rather than being judged. 0 is no clock, which is the default: an entry that serves forever is a program, not a runaway.",
              ),
              "0",
            ),
            with_check(
              valued(
                "seed",
                "SEED",
                Text,
                "The order in which a simulation runs concurrent tasks, given as a seed: `7`, or `7:3.0.2`.",
              ),
              seed_ok,
            ),
            profile_flag(
              "C toolchain: `development` (`tcc` on x86-64 Linux, else `cc -O0`) or `release` (`cc -O2`).",
            ),
            repeated(
              valued(
                "require-signer",
                "KEY",
                Text,
                "Run a built artifact only when the public key file KEY signed it. Repeatable: any of them may.",
              ),
            ),
          ],
          tls_flags(),
          fs_flags(),
          exec_flags(),
          allow_flags(),
          config_flags(),
          trace_flags(),
          shutdown_flags(),
        ]),
      ),
      [path_positional],
    ),
  )

fn build_command() -> Command =
  with_positionals(
    command(
      "build",
      "Write a deployable artifact containing one entry point and everything it uses.",
      [
        with_short(
          valued(
            "output",
            "FILE",
            Text,
            "Where to write the artifact. Defaults to `<entry module>.plyx` in the working directory.",
          ),
          "o",
        ),
        valued(
          "entry",
          "NAME",
          Text,
          "The definition to ship together with everything it uses: a qualified name such as `app.serve`, or a name without a module prefix. Defaults to `main`.",
        ),
        valued(
          "config-schema",
          "MODULE.FN",
          Text,
          "Also ship this `--config-schema` function and everything it uses, so the artifact takes the same flag.",
        ),
        conflicting(
          switch(
            "digest",
            "Print the artifact's digest `b3:...` and nothing else, for a deployment to check against. Writes no file.",
          ),
          ["json", "diff", "output"],
        ),
        conflicting(
          valued(
            "diff",
            "OLD.plyx",
            Text,
            "Report what this build changes relative to a deployed artifact. Writes no file.",
          ),
          ["output"],
        ),
        conflicting(
          valued(
            "sign",
            "KEY",
            Text,
            "Sign what the build writes with the secret key file KEY (`ply keygen`), in `<artifact>.sig` beside it.",
          ),
          ["digest", "diff", "verify"],
        ),
        conflicting(
          switch(
            "verify",
            "Check that the artifact file named by `-o`, and the `.sig` signature files stored next to it, match what these sources build. Writes no file.",
          ),
          ["digest", "diff"],
        ),
        json_flag(),
      ],
    ),
    [path_positional],
  )

fn attest_command() -> Command =
  with_positionals(
    command(
      "attest",
      "Run a published version's tests, claims and promises over what the registry serves; with `--sign`, send the signed result to the registry.",
      [
        valued(
          "sign",
          "KEY",
          Text,
          "Sign the result with the secret key file KEY and send it to `PLY_REGISTRY`, which stores one signed result for each signing key.",
        ),
        json_flag(),
      ],
    ),
    [
      positional("NAME", "The package's name."),
      positional("VERSION", "The published version, such as `0.2.0`."),
    ],
  )

fn keygen_command() -> Command =
  with_positionals(
    command(
      "keygen",
      "Write an Ed25519 key pair to sign builds with: the secret key at PATH, its public key at PATH.pub.",
      [json_flag()],
    ),
    [positional("PATH", "Where the secret key is written; it is never written over.")],
  )

fn hosts_command() -> Command =
  with_positionals(
    command(
      "hosts",
      "List every built-in implementation of file, network and process access that this binary contains: the code you must trust.",
      flat([
        [
          conflicting(json_flag(), ["digest"]),
          switch(
            "digest",
            "Print only `b3:...`, the digest a CI check compares with an expected value.",
          ),
        ],
        tls_flags(),
        fs_flags(),
        config_flags(),
        trace_flags(),
        shutdown_flags(),
      ]),
    ),
    [path_positional],
  )

fn std_command() -> Command =
  command("std", "List the modules that ship with this compiler, and the digest over them.", [
    conflicting(json_flag(), ["digest", "answers", "answering"]),
    conflicting(switch("digest", "Print `b3:...` and nothing else: the line a CI check pins."), [
      "answers",
      "answering",
    ]),
    conflicting(
      switch(
        "answering",
        "Print the key that a bootstrap stores this `ply`'s check results for the shipped modules under, and nothing else.",
      ),
      ["answers", "show"],
    ),
    conflicting(
      valued(
        "answers",
        "DIR",
        Text,
        "Check every shipped module and write the results to a pack in DIR/pack, using the cache under the stage root. A bootstrap packs this into the `ply` it builds.",
      ),
      ["show"],
    ),
    with_bare_value(
      valued(
        "show",
        "MODULE",
        Text,
        "Print a module's source, or a data file one embeds by the name the listing gives it; written bare, prints every module's source.",
      ),
      "*",
    ),
  ])

fn explain_command() -> Command =
  with_positionals(
    command("explain", "What a diagnostic code means; `--all` lists every code.", [
      switch("all", "List every code with its meaning."),
      json_flag(),
    ]),
    [required_unless(positional("CODE", "A code such as `E0302` or `W0611`."), "all")],
  )

fn doc_command() -> Command =
  with_positionals(
    command(
      "doc",
      "A definition or builtin: its signature with parameter names, the comment above it, and the file and line where it is defined.",
      [json_flag()],
    ),
    [
      positional(
        "NAME",
        "A program-wide name (`store.orders.place`), a simple name unique in the program, or a builtin.",
      ),
      path_positional,
    ],
  )

fn fmt_command() -> Command =
  with_positionals(
    command(
      "fmt",
      "Rewrite `.ply` files in the canonical layout; a file that does not parse is left alone.",
      [
        switch(
          "check",
          "Write nothing; list the files that would change and exit 1 if there are any.",
        ),
        requiring(json_flag(), ["check"]),
      ],
    ),
    [
      many(
        optional(
          "PATHS",
          "`.ply` files, or directories whose `*.ply` files are formatted (a hidden directory, one named `target`, and a symlink are passed over). Left off, the package the working directory is part of.",
        ),
      ),
    ],
  )

fn rename_command() -> Command =
  with_positionals(
    command(
      "rename",
      "Rename definitions, locals, operations, fields and modules in `.ply` files, using a file that lists each old name and its new name.",
      [
        valued(
          "map",
          "FILE",
          Text,
          "One rename per line: the old name, a space, and the new name.",
        ),
        switch(
          "words",
          "Rename words inside names: `ty type` changes `ty_vars` to `type_vars` and `TyCon` to `TypeCon`.",
        ),
        switch("check", "Write nothing; list what would change and exit 1 if anything would."),
        requiring(json_flag(), ["check"]),
      ],
    ),
    [
      many(
        optional(
          "PATHS",
          "`.ply` files, or directories to search for them. The default is the package the working directory is in.",
        ),
      ),
    ],
  )

fn show_command() -> Command =
  with_positionals(
    command(
      "show",
      "One `fn` or `type` as its file has it: the comment lines above it, `pub`, and the body.",
      [json_flag()],
    ),
    [
      positional(
        "NAME",
        "A program-wide name (`store.orders.place`) or a simple name unique in the program: a `fn` or a `type`.",
      ),
      path_positional,
    ],
  )

fn replace_command() -> Command =
  with_positionals(
    command(
      "replace",
      "Rewrite one `fn` or `type` from a file or stdin, formatted, leaving every other byte of the file alone.",
      [
        valued("with", "FILE", Text, "The file holding the new definition; stdin when absent."),
        switch("check", "Write nothing; report whether the file would change."),
        json_flag(),
      ],
    ),
    [
      positional(
        "NAME",
        "A program-wide name (`store.orders.place`) or a simple name unique in the program: a `fn` or a `type`.",
      ),
      path_positional,
    ],
  )

fn hash_command() -> Command =
  with_positionals(
    command("hash", "Print the content hash of every definition.", [
      switch(
        "dependencies",
        "Also print each definition's direct references and transitive closure.",
      ),
      json_flag(),
    ]),
    [path_positional],
  )

fn resolve_command() -> Command =
  with_positionals(
    command(
      "resolve",
      "Write the lockfile listing every package this project depends on, directly or indirectly.",
      [json_flag()],
    ),
    [path_positional],
  )

fn vendor_command() -> Command =
  with_positionals(
    command(
      "vendor",
      "Copy this project's dependencies into `vendor/`, so it builds with no cache and no network.",
      [json_flag()],
    ),
    [path_positional],
  )

fn publish_command() -> Command =
  with_positionals(
    command(
      "publish",
      "Upload this library's `.plyz` to the registry `PLY_REGISTRY` names, under `PLY_REGISTRY_TOKEN`.",
      [json_flag()],
    ),
    [path_positional],
  )

fn yank_command() -> Command =
  with_positionals(
    command(
      "yank",
      "Mark a published version as yanked: new dependency resolution skips it, but a lockfile that already lists that version still uses it.",
      [json_flag()],
    ),
    [
      positional("NAME", "The package's name, as its `ply.pkg` declares it."),
      positional("VERSION", "The version to yank, such as `0.2.0`."),
    ],
  )

fn contracts_command() -> Command =
  with_positionals(
    command(
      "contracts",
      "List how each public definition of a registry package changed between two versions, and which version bump those changes require.",
      [json_flag()],
    ),
    [
      positional("NAME", "The package's name, as its `ply.pkg` declares it."),
      positional("FROM", "The earlier version, such as `0.1.0`."),
      positional("TO", "The later version, such as `0.2.0`."),
    ],
  )

fn reason_command() -> Command =
  with_positionals(
    command(
      "why",
      "Show why a package is in this project's dependencies by listing the packages that depend on it.",
      [json_flag()],
    ),
    [positional("NAME", "A package's name, as `ply.pkg` declares it."), path_positional],
  )

fn definitions_command() -> Command =
  with_positionals(
    command(
      "definitions",
      "Every definition with its file and line, hash, signature and effects.",
      [
        filter_flag("Only definitions whose program-wide name contains this substring."),
        json_flag(),
      ],
    ),
    [path_positional],
  )

fn unused_command() -> Command =
  with_positionals(
    command(
      "unused",
      "Definitions nothing uses, and those only tests and laws use. In a package with `main`, `pub` does not count as a use.",
      [
        json_flag(),
        switch(
          "workspace",
          "Judge every package `ply.work` names together: a `pub` definition counts as used only where a package reaches it. The standard library is left out.",
        ),
      ],
    ),
    [path_positional],
  )

fn callers_command() -> Command =
  with_positionals(
    command(
      "callers",
      "List what refers to a definition, directly or through calls: other definitions, tests and laws.",
      [json_flag()],
    ),
    [
      positional(
        "DEF",
        "A program-wide name (`store.orders.place`) or a simple name unique in the program.",
      ),
      path_positional,
    ],
  )

fn work_command() -> Command =
  with_positionals(
    command(
      "work",
      "Print the location of each package and each component of `ply` (compiler, standard library, command-line program, runtime) declared in the `ply.work` file found in a directory or its parent directories.",
      [
        conflicting(
          switch(
            "identity",
            "Print what names the compiler and the runtime of this `ply`, and nothing else: two that print the same build every checkout alike.",
          ),
          ["json"],
        ),
        json_flag(),
      ],
    ),
    [defaulted("PATH", "A directory of the repository.", ".")],
  )

const cache_path: Positional =
  optional(
    "PATH",
    "The project whose `.ply-cache` to use: the package that contains the path, or the path's directory when the path is in no package. Defaults to the package of the working directory.",
  )

fn cache_scope(name: String, about: String) -> Command =
  with_positionals(command(name, about, [json_flag()]), [cache_path])

fn cache_command() -> Command =
  with_subs(command("cache", "Read, reclaim or discard what the caches contain.", []), [
    cache_scope("clear", "Discard every cached result, so the next run checks everything again."),
    cache_scope(
      "stats",
      "Report where the cache lives, how much it holds, and what is reclaimable.",
    ),
    cache_scope("compact", "Reclaim the space nothing points at any more."),
    with_positionals(
      command("inspect", "Print what the cache contains for one definition, in readable form.", [
        json_flag(),
      ]),
      [
        positional(
          "DEF",
          "A program-wide name, a name as its module wrote it, or a hash prefix of 4+ hex digits.",
        ),
        cache_path,
      ],
    ),
  ])

pub fn spec(version: String) -> Spec = {
  let root = command("", "Ply — a language that makes checking and testing a program fast", [
    with_default(
      valued(
        "color",
        "COLOR",
        Choice(["auto", "always", "never"]),
        "Colour and the ✓/✗ marks; `auto` uses them only on a terminal with NO_COLOR unset.",
      ),
      "auto",
    ),
  ]);
  {
    bin: "ply",
    version: version,
    root: with_subs(root, [
      new_command(),
      check_command(),
      test_command(),
      prove_command(),
      review_command(),
      run_command(),
      build_command(),
      hosts_command(),
      std_command(),
      explain_command(),
      doc_command(),
      fmt_command(),
      rename_command(),
      show_command(),
      replace_command(),
      hash_command(),
      definitions_command(),
      resolve_command(),
      vendor_command(),
      reason_command(),
      publish_command(),
      yank_command(),
      contracts_command(),
      keygen_command(),
      attest_command(),
      callers_command(),
      unused_command(),
      work_command(),
      cache_command(),
    ]),
  }
}

pub fn parsed(argv: List<String>) -> Parsed / {abort.raise} =
  match parse(spec("0.0.0-test"), argv) { Run(p) -> p, _ -> panic("the line parses") }

fn ply_parse(argv: List<String>) -> Outcome<Parsed> / {abort.raise} =
  parse(spec("0.0.0-test"), argv)

fn parsed_run(argv: List<String>) -> Parsed / {abort.raise} =
  match ply_parse(argv) { Run(p) -> p, _ -> panic("the line was rejected, not run") }

fn rejection(argv: List<String>) -> String / {abort.raise} =
  match ply_parse(argv) {
    Failed(rejected) -> error_text(spec("0.0.0-test"), rejected),
    Run(p) -> panic("the line ran"),
    Help(_) -> panic("the line was help"),
    Version -> panic("the line was the version"),
  }

test "every command and flag the CLI declares can be parsed by the CLI's own argument parser" {
  assert_eq(faults(spec("0.0.0-test")), [])
}

test "a range of seeds is two naturals, the first below the second" {
  assert_eq(range_of("5..6"), Some({ from: 5, to: 6 }));
  assert_eq(range_of("0..64"), Some({ from: 0, to: 64 }));
  assert_eq(range_of("6..5"), None);
  assert_eq(range_of("5..5"), None);
  assert_eq(range_of("5"), None);
  assert_eq(range_of("-1..5"), None);
  assert_eq(range_of("a..b"), None)
}

test "a shard is written `K/N` with K counted from 1, and any other form is rejected with a message showing `K/N`" {
  assert_eq(shard_of("2/3"), Some({ index: 2, count: 3 }));
  assert_eq(shard_of("1/1"), Some({ index: 1, count: 1 }));
  assert_eq(shard_of("0/3"), None);
  assert_eq(shard_of("4/3"), None);
  assert_eq(shard_of("3"), None);
  assert_eq(shard_of("a/b"), None);
  assert_eq(value(parsed_run(["test", "--shard", "2/3"]), "shard"), Some("2/3"));
  assert(rejection(["test", "--shard", "3/0"]).contains("write `K/N` with K from 1 to N"))
}

test "a proof run's `--filter` repeats, as a test run's does" {
  assert_eq(values_of(parsed_run(["prove", "--filter", "a.", "--filter", "b."]), "filter"), [
    "a.",
    "b.",
  ])
}

test "a path omitted from the command line is not added to the parsed arguments, except for `bootstrap`, which defaults to `.`" {
  assert_eq(parsed_run(["test"]).positionals, []);
  assert_eq(parsed_run(["fmt", "--check"]).positionals, []);
  assert_eq(parsed_run(["cache", "stats"]).positionals, []);
  assert_eq(parsed_run(["doc", "std.json"]).positionals, ["std.json"]);
  assert_eq(parsed_run(["doc", "std.json", "."]).positionals, ["std.json", "."])
}

test "colour is accepted after the subcommand as well as before it" {
  assert_eq(value(parsed_run(["test", "--color", "always"]), "color"), Some("always"));
  assert_eq(value(parsed_run(["--color=never", "test"]), "color"), Some("never"))
}

test "zero jobs is rejected rather than silently meaning auto" {
  assert(rejection(["test", "--jobs", "0"]).contains("invalid value '0' for '--jobs <N>'"));
  assert_eq(value(parsed_run(["test", "-j", "4"]), "jobs"), Some("4"))
}

test "cache requires an action" {
  assert(rejection(["cache"]).contains("requires a subcommand"));
  assert_eq(parsed_run(["cache", "stats"]).path, ["cache", "stats"]);
  assert_eq(parsed_run(["cache", "clear"]).path, ["cache", "clear"]);
  assert_eq(parsed_run(["cache", "compact"]).path, ["cache", "compact"])
}

test "inspect needs something to look up" {
  assert(rejection(["cache", "inspect"]).contains("<DEF>"));
  let p = parsed_run(["cache", "inspect", "9f2c", "src"]);
  assert_eq(p.positionals, ["9f2c", "src"])
}

test "a TLS credential parses into its name and its two files, and the option may be repeated on the command line" {
  let p = parsed_run([
    "run",
    "--tls",
    "api=certs/api.pem,certs/api.key",
    "--tls",
    "admin=certs/admin.pem,certs/admin.key",
  ]);
  assert_eq(values_of(p, "tls"), [
    "api=certs/api.pem,certs/api.key",
    "admin=certs/admin.pem,certs/admin.key",
  ])
}

test "a `--tls` credential that is not in the form `name=cert,key` is rejected" {
  assert_credentials_rejected(["api", "api=only.pem", "=a.pem,b.key", "api=,b.key"])
}

fn assert_credentials_rejected(bads: List<String>) -> Unit / {abort.raise} =
  match bads {
    [] -> (),
    [bad, ..rest] -> {
      let text = rejection(["run", "--tls", bad]);
      assert(text.contains("--tls NAME=CERT.pem,KEY.pem"));
      assert_credentials_rejected(rest)
    },
  }

test "`run`, `test` and `hosts` all accept the `--tls` credentials that the program uses" {
  ["run", "test", "hosts"].fold((), |u: Unit, command: String|
    assert_eq(
      value(parsed_run([command, "--tls", "api=a.pem,b.key"]), "tls"),
      Some("api=a.pem,b.key"),
    ))
}

test "the simulation flags conflict with a seed" {
  let text = rejection(["test", "--seed", "7", "--sim", "random"]);
  assert(text.contains("'--seed <SEED>' cannot be used with '--sim'"))
}

test "`--sim-budget` is rejected with `--sim random` but accepted with `--sim dpor`" {
  let text = rejection(["test", "--sim", "random", "--sim-budget", "10"]);
  assert(text.contains("`--sim-budget` has no meaning under `--sim random`"));
  assert(has(parsed_run(["test", "--sim", "dpor", "--sim-budget", "10"]), "sim-budget"))
}

test "`test --seed` accepts a number, or a number and `:` plus the choice numbers to replay, and rejects other values" {
  assert(has(parsed_run(["test", "--seed", "7"]), "seed"));
  assert(has(parsed_run(["test", "--seed", "7:3.0.2"]), "seed"));
  assert(has(parsed_run(["test", "--seed", "0x1F"]), "seed"));
  assert(rejection(["test", "--seed", "7:"]).contains("is not a seed"));
  assert(rejection(["test", "--seed", "7:65536"]).contains("is not a seed"));
  assert(rejection(["test", "--seed", "not-a-seed"]).contains("is not a seed"))
}

test "`--digest` writes no file, so it conflicts with everything that does" {
  assert(rejection(["build", "--digest", "--json"]).contains("cannot be used with"));
  assert(rejection(["build", "--digest", "--diff", "old.plyx"]).contains("cannot be used with"));
  assert(rejection(["build", "--digest", "-o", "x.plyx"]).contains("cannot be used with"));
  assert(rejection(["hosts", "--digest", "--json"]).contains("cannot be used with"));
  assert(rejection(["std", "--digest", "--json"]).contains("cannot be used with"))
}

test "`review --accept` and `review --changed` cannot be used together" {
  assert(
    rejection(["review", "--accept", "--changed"]).contains(
      "'--accept' cannot be used with '--changed'",
    ),
  )
}

test "`explain` requires a code or `--all`, and the error names the missing `<CODE>`" {
  assert(rejection(["explain"]).contains("<CODE>"));
  assert(has(parsed_run(["explain", "--all"]), "all"));
  assert_eq(parsed_run(["explain", "E0302"]).positionals, ["E0302"])
}

test "`std --show` with no module shows all modules, represented as `*`" {
  assert_eq(value(parsed_run(["std", "--show"]), "show"), Some("*"));
  assert_eq(value(parsed_run(["std", "--show", "std.json"]), "show"), Some("std.json"))
}

test "arguments after `--` in `run` are passed to the program, not parsed as `run` options" {
  let p = parsed_run(["run", "app.plyx", "--", "--port", "8080"]);
  assert_eq(p.positionals, ["app.plyx"]);
  assert_eq(p.argv, ["--port", "8080"])
}

test "an unknown subcommand is rejected" {
  assert(rejection(["frobnicate"]).contains("unrecognized subcommand 'frobnicate'"))
}

test "every command handles help" {
  assert_help_usage([
    "new",
    "check",
    "test",
    "prove",
    "review",
    "run",
    "build",
    "hosts",
    "std",
    "explain",
    "doc",
    "fmt",
    "rename",
    "show",
    "replace",
    "hash",
    "definitions",
    "resolve",
    "vendor",
    "why",
    "publish",
    "yank",
    "contracts",
    "keygen",
    "attest",
    "callers",
    "unused",
    "work",
    "cache",
  ])
}

fn assert_help_usage(cmds: List<String>) -> Unit / {abort.raise} =
  match cmds {
    [] -> (),
    [command, ..rest] -> {
      match ply_parse([command, "--help"]) {
        Help(path) -> {
          let text = help(spec("0.0.0-test"), path);
          assert(text.contains("Usage: ply " ++ command ++ " "));
          assert(text.contains("Print help"))
        },
        _ -> panic("`--help` is help"),
      };
      assert_help_usage(rest)
    },
  }

test "the version flag works at the top and under a command" {
  assert_eq(ply_parse(["--version"]), Version);
  assert_eq(ply_parse(["cache", "stats", "--version"]), Version);
  assert_eq(version_line(spec("0.0.0-test")), "ply 0.0.0-test")
}

test "the top-level help lists every command, the one-line description of Ply and the global flag" {
  match ply_parse(["--help"]) {
    Help(path) -> {
      let text = help(spec("0.0.0-test"), path);
      assert(text.contains("Ply — a language that makes checking and testing a program fast"));
      assert(text.contains("Usage: ply [OPTIONS] <COMMAND>"));
      assert(text.contains("check"));
      assert(text.contains("cache"));
      assert(text.contains("--color <COLOR>"));
      assert(text.contains("[possible values: auto, always, never]"))
    },
    _ -> panic("top-level --help is help"),
  }
}

test "`test` accepts `--profile`, and `run` accepts `--fs`, `--drain-ms` and `--trace`, each with a value" {
  assert(has(parsed_run(["test", "--profile", "release"]), "profile"));
  assert(has(parsed_run(["run", "--fs", "src=./crates"]), "fs"));
  assert_eq(value(parsed_run(["run", "--drain-ms", "5000"]), "drain-ms"), Some("5000"));
  assert_eq(value(parsed_run(["run", "--trace", "text"]), "trace"), Some("text"))
}

test "`--profile` accepts only `development` or `release`, and defaults to `development` when omitted" {
  assert_eq(profile_of(parsed_run(["test", "--profile", "release"])), cc::release());
  assert_eq(profile_of(parsed_run(["run"])), cc::development());
  assert_eq(profile_of(parsed_run(["check"])), cc::development());
  assert(
    rejection(["test", "--profile", "debug"]).contains("[possible values: development, release]"),
  )
}

test "`contracts` takes a name and two versions and no path" {
  assert_eq(parsed_run(["contracts", "orders", "0.1.0", "0.2.0"]).positionals, [
    "orders",
    "0.1.0",
    "0.2.0",
  ]);
  assert(rejection(["contracts", "orders", "0.1.0"]).contains("<TO>"))
}

test "`attest` takes a name and a version and no path" {
  assert_eq(parsed_run(["attest", "orders", "0.1.0", "--sign", "k"]).positionals, [
    "orders",
    "0.1.0",
  ]);
  assert(rejection(["attest", "orders"]).contains("<VERSION>"))
}

test "`yank` takes a package name and a version and no path, while `publish` takes no arguments" {
  let p = parsed_run(["yank", "orders", "0.2.0"]);
  assert_eq(p.positionals, ["orders", "0.2.0"]);
  assert(rejection(["yank", "orders"]).contains("<VERSION>"));
  assert_eq(parsed_run(["publish"]).positionals, [])
}

test "`--fs` and `--exec` reject a malformed name or path with an error describing the expected format" {
  assert(rejection(["run", "--fs", "9bad=./x"]).contains("an identifier"));
  assert(rejection(["run", "--fs", "src="]).contains("the path is empty"));
  assert(rejection(["run", "--exec", "cc"]).contains("there is no `=`"));
  assert(has(parsed_run(["run", "--fs", "src=./crates", "--exec", "cc=/usr/bin/cc"]), "exec"))
}

test "`test` accepts `--exec` and `--allow` but rejects `--trace`" {
  let p = parsed_run(["test", "--exec", "ply=/usr/bin/ply", "--allow", "machine"]);
  assert(has(p, "exec"));
  assert_eq(values_of(p, "allow"), ["machine"]);
  assert(rejection(["test", "--trace", "auto"]).contains("--trace"))
}

test "`prove` parses `--static-prover` only when it is given, and `review` rejects that flag" {
  assert(has(parsed_run(["prove", "--json", "--static-prover"]), "static-prover"));
  assert(!has(parsed_run(["prove", "--json"]), "static-prover"));
  assert(rejection(["review", "--static-prover"]).contains("--static-prover"))
}
