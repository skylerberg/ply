pub type ClaimReading = { later: LaterReading, summaries: List<HashSummary> }

pub fn claim_reading(modules: Modules) -> ClaimReading / {memo.read, abort.raise} =
  { later: view::later_reading(modules), summaries: view::hash_summaries(modules) }

pub fn discharge_claims(
  s: Session<ClaimReading>,
  collection: Collection,
  runs: List<Int>,
  resolved: List<StaticResult>,
) -> Result<DischargeResult, Rejection> / {entering::machine.open, entering::machine.enter, entering::machine.close, time.elapsed_ms, emit.code, emit.libraries, discharging.decided, EmbeddedFiles, abort.raise} =
  match units::code_program_of(s, s.value.later.rollups) {
    Err(diagnostics) -> Err(NotCompiled({ diagnostics: diagnostics, places: collection.places })),
    Ok(program) ->
      discharge_library(program, laws_by_key(s.value.later.rollups), collection, runs, resolved),
  }

pub type ClaimView = { analysis: Analysis }

pub type ClaimedProgram = { mine: OwnClaims, statics: StaticProver }

pub type ModuleClaims = {
  claims: List<Claim>,
  laws: List<WrittenLaw>,
  warnings: List<Diagnostic>,
  definitions: List<Definition>,
}

derive bin for ModuleClaims

fn claims_in_outline(o: Outline) -> List<Subject> =
  o.items.fold([], |found: List<Subject>, item: OutlineItem|
    match item {
      OutlinedFunction(f) -> if f.spec.len() == 0 { found }
      else { found.push(FunctionNamed(qualify(o.name, f.name))) },
      OutlinedLaw(l) -> found.push(ItemKeyed(qualify(o.name, l.name))),
      _ -> found,
    })

fn every_function(o: Outline) -> List<Subject> =
  o.items.fold([], |found: List<Subject>, item: OutlineItem|
    match item {
      OutlinedFunction(f) -> found.push(FunctionNamed(qualify(o.name, f.name))),
      _ -> found,
    })

fn imported_closure(frame: Frame, start: List<Bytes>) -> Map<Bytes, Bool> / {abort.raise} = {
  let imports = range(0, frame.outlines.len()).fold(
    Map::new(),
    |found: Map<Bytes, List<Bytes>>, i: Int|
      found.insert(frame.outlines.get(i).name, frame.imports.at_or(i, [])),
  );
  iterate(
    { seen: Map::new(), work: start },
    1000000,
    |s: { seen: Map<Bytes, Bool>, work: List<Bytes> }|
      match s.work {
        [] -> Stop(s.seen),
        [m, ..rest] -> if s.seen.contains(m) { Continue({ ..s, work: rest }) } else {
          Continue({
            seen: s.seen.insert(m, true),
            work: rest.concat(match imports.get(m) { Some(ms) -> ms, None -> [] }),
          })
        },
      },
  )
}

fn without_unreached_bodies(
  s: Source,
  outlines: Map<Bytes, Outline>,
  reached: Map<Bytes, Bool>,
) -> Source / {abort.raise} =
  match outlines.get(s.name) {
    None -> s,
    Some(o) ->
      {
        ..s,
        source_text: blank_cuts(
          s.source_text,
          o.cuts.filter(|c: Cut| c.name.len() > 0 && !reached.contains(c.name)),
        ),
      },
  }

fn rows_outside(program: Program, dropped: Map<Bytes, Bool>) -> Rows / {abort.raise} =
  program.returned.fold(no_rows(), |accumulator: Rows, name: Bytes, a: ModuleResult|
    if dropped.contains(name) { accumulator } else {
      let rows = rows_of_result(a);
      {
        definitions: accumulator.definitions.concat(rows.definitions),
        tests: accumulator.tests.concat(rows.tests),
        types: tables_joined(accumulator.types, rows.types),
      }
    })

pub fn claim_view(
  program: Program,
  v: CheckedProgram,
  open: List<Bytes>,
) -> Result<ClaimView, List<Diagnostic>> / {abort.raise} = {
  let frame = v.frame;
  let own = frame.outlines.take(program.files.len());
  let outlines_asked_for = own.filter(|o: Outline| open.contains(o.name));
  let stated = outlines_asked_for.fold([], |found: List<Subject>, o: Outline|
    found.concat(claims_in_outline(o)));
  let subjects = if invariants_of(v.checked.instances).len() == 0 { stated } else {
    outlines_asked_for.fold(stated, |found: List<Subject>, o: Outline|
      found.concat(every_function(o)))
  };
  let bearing = outlines_asked_for.filter(|o: Outline|
    claims_in_outline(o).len() > 0 || o.schemas.len() > 0 || subjects.len() > stated.len()).map(
    |o: Outline| o.name,
  );
  let included = imported_closure(frame, if bearing.len() > 0 { bearing }
  else { program.sources.map(|s: Source| s.name).take(1) });
  let reached = reachable_functions(frame.hashes, subjects);
  let outlines = own.fold(Map::new(), |found: Map<Bytes, Outline>, o: Outline|
    found.insert(o.name, o));
  let dropped = program.sources.fold(Map::new(), |found: Map<Bytes, Bool>, s: Source|
    if included.contains(s.name) { found } else { found.insert(s.name, true) });
  match front_end(
      program.sources.map(|s: Source|
        if included.contains(s.name) { without_unreached_bodies(s, outlines, reached) }
        else { { ..s, source_text: b"" } }),
      program.shipping,
      rows_outside(program, dropped),
      program.packages,
      program.embeds.filter(|e: Embed| !dropped.contains(e.embedded.module)),
      program.prune_unreached,
      joined_cached_hashes(program.modules),
      module_derivations(program).filter(|m: ModuleDerivations| !dropped.contains(m.module)),
    ).out {
    Rejected(ds) -> Err(ds),
    Analysed(w) -> Ok({ analysis: { ..w, warnings: frame.warnings } }),
  }
}

type KnownModule = { name: Bytes, index: Int, path: String, claims: Option<ModuleClaims> }

pub type ClaimInputs = { names: List<Bytes>, records: List<Bytes>, texts: List<Bytes> }

fn known_module(
  identity: Bytes,
  inputs: ClaimInputs,
  index: Int,
) -> KnownModule / {toolchain.read_file, abort.raise} = {
  let path = "claims/"
    ++ blake3(
      Bytes::concat_all([identity, inputs.records.get(index), inputs.texts.get(index)]),
    ).hex_of(
    );
  {
    name: inputs.names.get(index),
    index: index,
    path: path,
    claims: match toolchain.read_file(path) {
      None -> None,
      Some(bytes) -> match bin::decode(bytes, module_claims_bin()) {
        Ok(c) -> Some(placed_claims(c, index)),
        Err(_) -> None,
      },
    },
  }
}

fn placed_claims(c: ModuleClaims, index: Int) -> ModuleClaims =
  {
    ..c,
    claims: c.claims.map(|claim: Claim| { ..claim, at: { ..claim.at, module: index } }),
    warnings: c.warnings.map(|d: Diagnostic|
      { ..d, labels: d.labels.map(|l: Label| { ..l, module: index }) }),
  }

fn wants_view(
  known: KnownModule,
  use_cache: Bool,
  every_module: Bool,
) -> Bool / {proof_store.cached, abort.raise} =
  every_module || !use_cache
    || (match known.claims { None -> true, Some(c) -> c.claims.any(lacks_proof) })

type WorldClaim = { claim: Claim, obligation: Obligation }

fn placeholder_obligation(c: Claim) -> Obligation =
  {
    key: c.key,
    run_key: c.run_key,
    owner: c.owner,
    kind: c.kind,
    at: c.at,
    binders: [],
    result: None,
    variables: [],
    guards: [],
    literals: [],
    effects: None,
    frame: c.frame,
    strategy: Static(Unhandled("")),
    identities: [],
  }

fn kind_rank(k: Kind) -> Int = match k { Law(_) -> 2, Builds(_) -> 1, _ -> 0 }

fn comes_first(a: WorldClaim, b: WorldClaim) -> Bool = {
  let x = { rank: kind_rank(a.claim.kind), module: a.claim.at.module, start: a.claim.at.start };
  let y = { rank: kind_rank(b.claim.kind), module: b.claim.at.module, start: b.claim.at.start };
  x.rank < y.rank
    || (x.rank == y.rank && (x.module < y.module || (x.module == y.module && x.start <= y.start)))
}

fn belongs_to(names: List<Bytes>, module: Bytes, key: String) -> Bool = {
  let within = |m: Bytes| key.starts_with(String::of_bytes_lossy(m) ++ ".");
  within(module) && !names.any(|m: Bytes| m.len() > module.len() && within(m))
}

fn labelled_at(d: Diagnostic, index: Int) -> Bool = d.labels.any(|l: Label| l.module == index)

fn fresh_claims(
  fresh: OwnClaims,
  v: CheckedProgram,
  names: List<Bytes>,
  known: KnownModule,
) -> ModuleClaims / {abort.raise} =
  {
    claims: fresh.claims.filter(|c: Claim| c.at.module == known.index),
    laws: fresh.laws.filter(|l: WrittenLaw| belongs_to(names, known.name, l.key)),
    warnings: fresh.warnings.filter(|d: Diagnostic| labelled_at(d, known.index)),
    definitions: defined(
      v.checked.definitions.filter(|d: DefinitionInfo| d.module == known.name),
      v.frame.hashes,
    ),
  }

fn claims_of_program(
  names: List<Bytes>,
  world: ProverInput,
  held: List<ModuleClaims>,
  fresh: List<WorldClaim>,
) -> OwnClaims / {abort.raise} = {
  let stored = held.fold([], |found: List<WorldClaim>, c: ModuleClaims|
    found.concat(
      c.claims.map(|claim: Claim| { claim: claim, obligation: placeholder_obligation(claim) }),
    ));
  let all = stored.concat(fresh).sort_by(comes_first);
  {
    claims: all.map(|w: WorldClaim| w.claim),
    definitions: held.fold([], |found: List<Definition>, c: ModuleClaims|
      found.concat(c.definitions)),
    laws: held.fold([], |found: List<WrittenLaw>, c: ModuleClaims| found.concat(c.laws)),
    warnings: held.fold([], |found: List<Diagnostic>, c: ModuleClaims| found.concat(c.warnings)),
    world: { ..world, obligations: all.map(|w: WorldClaim| w.obligation) },
    modules: names,
  }
}

fn claimed_with_view(
  program: Program,
  v: CheckedProgram,
  names: List<Bytes>,
  known: List<KnownModule>,
  open: List<KnownModule>,
) -> Result<ClaimedProgram, List<Diagnostic>> / {toolchain.write_file, abort.raise} =
  match claim_view(program, v, open.map(|k: KnownModule| k.name)) {
    Err(diagnostics) -> Err(diagnostics),
    Ok(view) -> {
      let w = view.analysis;
      let owned = in_root_package(v.frame);
      let built = prover_input_of(w, owned);
      let fresh = own_claims(w, built);
      let open_at = open.map(|k: KnownModule| k.index);
      let current = known.fold([], |found: List<ModuleClaims>, k: KnownModule|
        if open_at.contains(k.index) {
          let c = fresh_claims(fresh, v, names, k);
          toolchain.write_file(k.path, bin::encode(c, module_claims_bin()));
          found.push({ ..c, claims: [] })
        } else { match k.claims { Some(c) -> found.push(c), None -> found } });
      let pairs = range(0, fresh.claims.len()).fold([], |found: List<WorldClaim>, i: Int| {
        let c = fresh.claims.get(i);
        if open_at.contains(c.at.module) {
          found.push({ claim: c, obligation: built.world.obligations.get(i) })
        } else { found }
      });
      let mine = claims_of_program(names, built.world, current, pairs);
      Ok({ mine: mine, statics: static_prover_of(w, mine.world, owned) })
    },
  }

pub type WholeClaims = { program: Program, view: CheckedProgram }

pub fn claimed_modules<| e>(
  inputs: ClaimInputs,
  use_cache: Bool,
  every_module: Bool,
  whole: () -> Result<WholeClaims, List<Diagnostic>> / {abort.raise | e},
) -> Result<ClaimedProgram, List<Diagnostic>> / {shipped.definitions, toolchain.read_file, toolchain.write_file, proof_store.cached, abort.raise | e} = {
  let identity = identity_of(shipped.definitions(), [b"claims.own_claims"]);
  let known = range(0, inputs.names.len()).map(|i: Int| known_module(identity, inputs, i));
  let open = known.filter(|k: KnownModule| wants_view(k, use_cache, every_module));
  if open.len() == 0 {
    Ok({
      mine: claims_of_program(
        inputs.names,
        empty_prover_input(),
        known.fold([], |found: List<ModuleClaims>, k: KnownModule|
          match k.claims { Some(c) -> found.push(c), None -> found }),
        [],
      ),
      statics: no_static_prover(None),
    })
  } else {
    match whole() {
      Err(diagnostics) -> Err(diagnostics),
      Ok(w) -> claimed_with_view(w.program, w.view, inputs.names, known, open),
    }
  }
}

pub fn claim_inputs(s: Session<ClaimReading>) -> ClaimInputs / {abort.raise} =
  {
    names: s.modules.own.take(s.modules.root),
    records: s.value.summaries.take(s.modules.root).map(|h: HashSummary| h.record),
    texts: s.project.files.map(|f: File| f.text.blake3()),
  }

pub fn whole_claims(
  s: Session<ClaimReading>,
  from_nothing: Bool,
) -> Result<WholeClaims, List<Diagnostic>> / {ProgramStore, shipped.read_pack, toolchain.reuse_dir, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[abs], fs.write[abs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], entropy.next, time.now_ms, Derives, abort.raise} = {
  let results = in_program_store(s.place, |_: LoadInputs|
    if from_nothing { module_results(s.modules.own) } else { listed_results(s.modules.own) }).value;
  let t = timed_of(s, results, false, from_nothing);
  match program_view(t.program) {
    Some(v) -> Ok({ program: t.program, view: v }),
    None -> Err(t.program.diagnostics),
  }
}

fn program_over(
  sources: List<Source>,
) -> { program: Program, view: CheckedProgram } / {abort.raise} = {
  let done = queried_results(fresh_registry(), empty_memory_store(), sources);
  let names = sources.map(|s: Source| s.name);
  let packages = { root: b"", manifest: None, supplied: [] };
  let loaded = assembled_load(
    names,
    packages,
    done.results.fold(Map::new(), |found: Map<Bytes, ModuleShape>, a: CheckedModule|
      found.insert(a.module, a.result.shape)),
    done.fixing,
    done.results.drop(sources.len()).map(|a: CheckedModule| a.module),
    [],
    Map::new(),
    true,
    false,
    [],
  );
  let returned = done.results.fold(
    Map::new(),
    |found: Map<Bytes, ModuleResult>, a: CheckedModule| found.insert(a.module, a.result),
  );
  {
    program: {
      ..no_program(),
      files: sources.map(|s: Source|
        {
          path: String::of_bytes_lossy(s.name),
          module: String::of_bytes_lossy(s.name),
          text: s.source_text,
          at: { label: "cwd", path: String::of_bytes_lossy(s.name) },
        }),
      sources: sources,
      source_texts: sources.map(|s: Source|
        { path: String::of_bytes_lossy(s.name), text: s.source_text }),
      frame: Some(loaded.frame),
      returned: returned,
      reads: loaded.reads,
      packages: packages,
      modules: [{ record: b"", cached: done.fixing }],
      prune_unreached: false,
    },
    view: checked_program_from_results(loaded.frame, loaded.reads, returned),
  }
}

fn claimed_sources() -> List<Source> =
  [
    {
      name: b"app",
      source_text: b"import lib (quad, twice)\n\npub fn four(n: Int) -> Int requires n > 0 && n < 1000 ensures result == quad(n) = twice(twice(n))\n\npub fn apart(n: Int) -> Int = n + 1\n\nlaw \"twice doubles\" forall (n: Int) where n > 0 && n < 1000 { twice(n) == n + n }\n",
    },
    {
      name: b"lib",
      source_text: b"pub fn twice(n: Int) -> Int = n + n\n\npub fn quad(n: Int) -> Int = n + n + n + n\n",
    },
    { name: b"other", source_text: b"pub fn unrelated(n: Int) -> Int = n * 3\n" },
  ]

fn claim_keys(w: Analysis) -> List<String> / {abort.raise} =
  prover_input_of(w, |m: Bytes| true).world.obligations.map(|o: Obligation| o.key)

fn proved_claims(w: Analysis) -> List<String> / {abort.raise} = {
  let owned = |m: Bytes| [b"app", b"lib", b"other"].contains(m);
  let world = prover_input_of(w, owned).world;
  let p = prover_of(
    claims_for(w, modules_of(w, world.obligations), owned),
    world,
    default_prove_budget(),
  );
  world.obligations.filter(|o: Obligation|
    match diagnosis_of(p, o) {
      Some(d) -> match d.decision { Proved(_) -> true, _ -> false },
      None -> false,
    }).map(|o: Obligation| o.owner)
}

test "a claim view holds the claims of the whole program under the same keys, and no module they do not reach" {
  let loaded = program_over(claimed_sources());
  let whole = match front_end(
      loaded.program.sources,
      loaded.program.shipping,
      rows_outside(loaded.program, Map::new()),
      loaded.program.packages,
      [],
      false,
      joined_cached_hashes(loaded.program.modules),
      [],
    ).out {
    Analysed(w) -> w,
    Rejected(_) -> panic("the fixture program was rejected by the checker"),
  };
  match claim_view(loaded.program, loaded.view, [b"app", b"lib", b"other"]) {
    Err(_) -> panic("the claim view of a checked program was rejected"),
    Ok(v) -> {
      assert(
        v.analysis.modules.all(|m: ParsedModule| m.name != b"other" || m.module.items.len() == 0),
      );
      assert_eq(claim_keys(v.analysis), claim_keys(whole));
      assert(proved_claims(whole).contains("app.four"));
      assert_eq(proved_claims(v.analysis), proved_claims(whole));
      assert_eq(v.analysis.modules.map(|m: ParsedModule| m.name).take(3), [
        b"app",
        b"lib",
        b"other",
      ])
    },
  }
}

test "a body that no claim reaches is blanked in place, and a body that a claim reaches is kept" {
  let source = claimed_sources().get(0);
  let outlines = program_over(claimed_sources()).view.frame.outlines.fold(
    Map::new(),
    |found: Map<Bytes, Outline>, o: Outline| found.insert(o.name, o),
  );
  let viewed = without_unreached_bodies(
    source,
    outlines,
    Map::new().insert(b"app.four", true),
  ).source_text;
  assert(viewed.index_of(b"twice(twice(n))") != None);
  assert(viewed.index_of(b"= n + 1") == None);
  assert_eq(viewed.len(), source.source_text.len())
}

fn modules_with_claims(size: Int, edited: Bytes) -> List<Source> =
  range(0, size).map(|i: Int| {
    let body = if i == 0 { edited } else { b"n + 1" };
    {
      name: b"m".concat(Bytes::of_string(i.to_string())),
      source_text: Bytes::concat_all([
        b"pub fn step(n: Int) -> Int requires n > 0 ensures result > 0 = ",
        body,
        b"\n",
      ]),
    }
  })

fn records_written(
  sources: List<Source>,
  stored: Map<String, Bytes>,
) -> Map<String, Bytes> / {abort.raise} = {
  let loaded = program_over(sources);
  let inputs = {
    names: sources.map(|s: Source| s.name),
    records: sources.map(|s: Source| b""),
    texts: sources.map(|s: Source| s.source_text.blake3()),
  };
  handle {
    claimed_modules(inputs, true, false, || Ok(loaded));
    ()
  } with {
    var written = Map::new(),
    shipped.definitions() -> b"claims.own_claims 00\n",
    toolchain.read_file(path) -> match written.get(path) {
      Some(b) -> Some(b),
      None -> stored.get(path),
    },
    toolchain.write_file(path, bytes) -> {
      written = written.insert(path, bytes);
      true
    },
    proof_store.cached(keys) -> keys.map(|k: String| Some(b"")),
    return unused_value -> written,
  }
}

test "an edit records the claims of one module again, however many modules have claims" {
  let rewritten = |size: Int| {
    let first = records_written(modules_with_claims(size, b"n + 1"), Map::new());
    records_written(modules_with_claims(size, b"n + 2"), first).len()
  };
  assert_eq(rewritten(2), rewritten(6))
}
