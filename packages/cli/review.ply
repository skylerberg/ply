fn change_word(m: ChangeState) -> String =
  match m { Unchanged -> "unchanged", Changed -> "changed", Never -> "never reviewed" }

fn row_of(change: Change) -> String =
  match change.implementation {
    Never -> change.name ++ " · never reviewed",
    _ -> {
      let spec = if has_obligations(change) { "spec " ++ change_word(change.spec) }
      else { "no spec" };
      change.name ++ " · implementation " ++ change_word(change.implementation) ++ " · " ++ spec
    },
  }

fn never_accepted() -> String = "never accepted: review the spec and the implementation once"

fn review_both() -> String = "review both; what is proved says how much the machine already checked"

fn advice(change: Change) -> String =
  if !is_specified(change) {
    if has_obligations(change) {
      "no obligation on this definition holds: read the implementation, line by line"
    } else { "read the implementation, line by line, exactly as today" }
  } else {
    match change.implementation {
      Never -> never_accepted(),
      Changed -> match change.spec {
        Never -> never_accepted(),
        Unchanged -> "review the obligations, not the diff",
        Changed -> review_both(),
      },
      Unchanged -> match change.spec {
        Never -> never_accepted(),
        Changed -> "review the spec diff; the implementation did not move",
        Unchanged -> review_both(),
      },
    }
  }

fn specified_of(changes: Changes) -> Int =
  changes.changed.filter(|change: Change| is_specified(change)).len()

fn unspecified_of(changes: Changes) -> Int = changes.changed.len() - specified_of(changes)

fn were(n: Int) -> String = if n == 1 { "was" } else { "were" }

fn claim_of(changes: Changes) -> String / {abort.raise} =
  if changes.broken > 0 && changes.broken == changes.undischarged {
    changes.broken.to_string() ++ " " ++ plural(changes.broken, "obligation")
      ++ " on a changed definition "
      ++ were(changes.broken)
      ++ " not proved, so nothing here was established"
  } else if changes.broken > 0 {
    changes.broken.to_string() ++ " " ++ plural(changes.broken, "obligation")
      ++ " on a changed definition no longer hold"
  } else if specified_of(changes) == 0 { "no specified behaviour changed" } else {
    "no specified behaviour changed: every obligation on the " ++ specified_of(changes).to_string()
      ++ " specified of them still holds"
  }

pub fn headline_of(changes: Changes) -> String / {abort.raise} =
  if changes.changed.len() == 0 { "no definition changed since the last accepted review" } else {
    let unspecified = unspecified_of(changes);
    if unspecified == 0 { claim_of(changes) } else {
      let count = if unspecified == changes.changed.len() {
        "all " ++ changes.changed.len().to_string() ++ " of them"
      } else { unspecified.to_string() ++ " of " ++ changes.changed.len().to_string() };
      claim_of(changes) ++ " · " ++ count
        ++ " carry no obligation that holds, so this run says nothing about whether their behaviour changed"
    }
  }

fn detail_line(style: Style, row: Row, places: List<SourceText>) -> String / {abort.raise} = {
  let detail = match row.outcome { Refuted(_) -> "no longer holds", _ -> detail_of(row, places) };
  indent() ++ "  " ++ mark_of(style, row.outcome) ++ " "
    ++ outcome_label(row.outcome).pad_right(14, " ")
    ++ " "
    ++ label_of(row.claim).pad_right(40, " ")
    ++ " "
    ++ dim(style, detail)
}

fn entry_lines(
  style: Style,
  change: Change,
  rows: List<Row>,
  places: List<SourceText>,
) -> List<String> / {abort.raise} = {
  let head = [indent() ++ bold(style, row_of(change))];
  let listed = change.obligations.fold(head, |acc: List<String>, index: Int|
    match rows.at(index) { None -> acc, Some(r) -> acc.push(detail_line(style, r, places)) });
  listed.push(indent() ++ "  " ++ dim(style, "→ " ++ advice(change))).push("")
}

fn changed_line(changes: Changes, cov: Coverage) -> String / {abort.raise} =
  indent() ++ changes.changed.len().to_string() ++ " of " ++ count_of(cov.definitions, "definition")
    ++ " changed since the last accepted review · "
    ++ changes.reviewed.to_string()
    ++ " of them have a baseline"

fn noted_lines(style: Style, warnings: List<Diagnostic>) -> List<String> =
  if warnings.len() == 0 { [] } else { warning_lines(style, warnings).concat([""]) }

fn headline_line(style: Style, changes: Changes) -> String / {abort.raise} = {
  let headline = headline_of(changes);
  indent() ++ (if changes.broken > 0 { red(style, headline) } else { headline })
}

fn lines_of(
  style: Style,
  collection: Collection,
  v: Verdicts,
  changes: Changes,
  rows: List<Row>,
  warnings: List<Diagnostic>,
) -> List<String> / {abort.raise} = {
  let head = coverage_lines(style, v.coverage, v.specified, false).concat([
    changed_line(changes, v.coverage),
  ]).concat([""]);
  let listed = changes.changed.fold(head, |acc: List<String>, change: Change|
    acc.concat(entry_lines(style, change, rows, collection.places)));
  listed.concat(noted_lines(style, warnings)).concat([headline_line(style, changes)])
}

fn spec_word(change: Change) -> String =
  if has_obligations(change) { change_word(change.spec) } else { "none" }

fn change_json(change: Change, rows: List<Row>, places: List<SourceText>) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(change.name) },
    { key: "implementation", value: Str(change_word(change.implementation)) },
    { key: "spec", value: Str(spec_word(change)) },
    { key: "specified", value: Bool(is_specified(change)) },
    { key: "advice", value: Str(advice(change)) },
    {
      key: "obligations",
      value: Array(
        change.obligations.fold([], |acc: List<Json>, index: Int|
          match rows.at(index) {
            None -> acc,
            Some(r) -> acc.push(obligation_json(r, places, false)),
          }),
      ),
    },
  ])

fn document(
  collection: Collection,
  v: Verdicts,
  changes: Changes,
  rows: List<Row>,
  code: Int,
  warnings: List<Diagnostic>,
) -> Json / {abort.raise} =
  object([
    { key: "schema_version", value: int(schema_version()) },
    { key: "command", value: Str("review") },
    { key: "action", value: Str("changed") },
    { key: "ok", value: Bool(code == ok_code()) },
    { key: "exit_code", value: int(code) },
    { key: "definitions", value: int(v.coverage.definitions) },
    { key: "specified", value: int(v.specified) },
    { key: "reviewed", value: int(changes.reviewed) },
    { key: "coverage", value: coverage_json(v.coverage) },
    { key: "plan", value: plan_json(collection.plan) },
    { key: "duration_ms", value: Number(v.duration_ms) },
    { key: "headline", value: Str(headline_of(changes)) },
    { key: "specified_changed", value: int(specified_of(changes)) },
    { key: "unspecified_changed", value: int(unspecified_of(changes)) },
    { key: "broken", value: int(changes.broken) },
    { key: "undischarged", value: int(changes.undischarged) },
    {
      key: "changed",
      value: Array(
        changes.changed.map(|change: Change| change_json(change, rows, collection.places)),
      ),
    },
    { key: "diagnostics", value: all_to_json(diagnostics_of(rows), collection.places) },
    { key: "warnings", value: all_to_json(warnings, collection.places) },
  ])

fn accepted_document(
  warnings: List<Diagnostic>,
  definitions: Int,
  code: Int,
  places: List<SourceText>,
) -> Json / {abort.raise} =
  object([
    { key: "schema_version", value: int(schema_version()) },
    { key: "command", value: Str("review") },
    { key: "action", value: Str("accept") },
    { key: "ok", value: Bool(code == ok_code()) },
    { key: "exit_code", value: int(code) },
    { key: "accepted", value: int(definitions) },
    { key: "warnings", value: all_to_json(warnings, places) },
  ])

fn accepted_lines(
  style: Style,
  warnings: List<Diagnostic>,
  definitions: Int,
) -> List<String> / {abort.raise} =
  [
    indent() ++ count_of(definitions, "definition") ++ " accepted as reviewed",
    indent()
      ++ dim(
        style,
        "the baseline is keyed by name, so renaming one loses its baseline and reports it as unreviewed",
      ),
  ].concat(
    warning_lines(style, warnings),
  )

fn accepted_output(
  style: Style,
  collection: Collection,
  a: AcceptResult,
) -> CommandOutput / {abort.raise} = {
  let warnings = once_each(collection.warnings.concat(a.warnings));
  let code = if a.stored { ok_code() } else { failure_code() };
  {
    json: accepted_document(warnings, a.definitions, code, collection.places),
    lines: accepted_lines(style, warnings, a.definitions),
    errs: [],
    code: code,
  }
}

fn review_output(
  style: Style,
  collection: Collection,
  v: Verdicts,
  changes: Changes,
  rows: List<Row>,
) -> CommandOutput / {abort.raise} = {
  let warnings = once_each(collection.warnings.concat(v.warnings));
  let code = exit_code_of(rows);
  {
    json: document(collection, v, changes, rows, code, warnings),
    lines: lines_of(style, collection, v, changes, rows, warnings),
    errs: [],
    code: code,
  }
}

fn all_of(claims: List<Claim>) -> List<Int> = range(0, claims.len())

fn review_changes<| e>(
  style: Style,
  collection: Collection,
  use_cache: Bool,
  statics: StaticProver,
  discharge: (Collection, List<Int>, List<StaticResult>) -> Result<DischargeResult, Refusal> / {discharging.decided | e},
) -> CommandOutput / {abort.raise, proof_store.record, proof_store.baselines, proof_store.cached | e} = {
  let wanted = all_of(collection.claims);
  let ran = handle {
    decide_claims(
      collection,
      wanted,
      use_cache,
      statics,
      false,
      |runs: List<Int>, settled: List<StaticResult>| discharge(collection, runs, settled),
    )
  } with {
    decisions.known(_row) -> (),
  };
  match ran {
    Err(why) -> failure_output(style, "review", why),
    Ok(v) -> {
      let laws = laws_in(collection);
      let ch = review(
        collection.definitions.map(|definition: Definition| definition.name),
        laws,
        snapshot_map(claim_snapshots(collection.definitions, laws)),
        snapshot_map(
          proof_store.baselines(
            collection.definitions.map(|definition: Definition| definition.name),
          ),
        ),
        claim_rows(collection, wanted, v.outcomes),
      );
      review_output(style, collection, v, ch, rows_of(collection.claims, wanted, v))
    },
  }
}

pub fn run(
  flags: Flags,
  options: Options,
) -> CommandOutput / {semantics.cached, shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, env.variable, env.working_directory, entering::machine.open, entering::machine.enter, entering::machine.close, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, emit.unit, emit.compiled, Derives, abort.raise, diverges, shipped.report_reached} = {
  let s: Style = style_of(flags);
  let t: TimedLoad = if options.no_incremental {
    timed_uncached(flags.paths, flags.verify_dependencies)
  } else { timed_load(flags.paths, flags.verify_dependencies) };
  let broken = |diagnostics: List<Diagnostic>|
    failure_output(
      s,
      "review",
      NotCompiled({ diagnostics: diagnostics, places: t.program.places }),
    );
  match program_view(t.program) {
    None -> broken(t.program.diagnostics),
    Some(v) -> match whole_of(t.program) {
      Err(diagnostics) -> broken(diagnostics),
      Ok(w) -> {
        let owned = in_root_package(v.frame);
        let built: ProverInputResult = prover_input_of(w, owned);
        results::with_review(results::store_for(flags.paths, flags.no_cache), ||
          review_over(
            s,
            flags,
            options,
            { places: t.program.places, warnings: own_diagnostics(t.program.diagnostics, v.frame) },
            own_claims(w, built),
            static_prover_of(w, built.world, owned),
            |collection: Collection, runs: List<Int>, settled: List<StaticResult>|
              claims::discharge_on_unit(loaded_analysis(t, v), collection, runs, settled),
          ))
      },
    },
  }
}

fn review_over<| e>(
  style: Style,
  flags: Flags,
  options: Options,
  got: LoadResult,
  mine: OwnClaims,
  statics: StaticProver,
  discharge: (Collection, List<Int>, List<StaticResult>) -> Result<DischargeResult, Refusal> / {discharging.decided | e},
) -> CommandOutput / {abort.raise, proof_store.record, proof_store.baselines, proof_store.accepted, proof_store.cached | e} = {
  let c = collection_of(got, mine, options);
  if flags.action == "accept" {
    accepted_output(style, c, proof_store.accepted(claim_snapshots(c.definitions, laws_in(c))))
  } else { review_changes(style, c, !flags.no_cache, statics, discharge) }
}

fn covering(definitions: Int) -> Coverage = { definitions: definitions, covered: 0, uncovered: [] }

fn verdicts(outcomes: List<Outcome>, definitions: Int) -> Verdicts =
  {
    outcomes: outcomes,
    reaches: None,
    reasons: outcomes.map(|outcome: Outcome| Fresh),
    coverage: covering(definitions),
    cached: 0,
    specified: outcomes.len(),
    duration_ms: Decimal::of_int(0),
    warnings: [],
  }

fn no_changes() -> Changes = { reviewed: 0, changed: [], broken: 0, undischarged: 0 }

fn a_change(
  name: String,
  implementation: ChangeState,
  spec: ChangeState,
  obligations: List<Int>,
  holding: Int,
) -> Change =
  {
    name: name,
    implementation: implementation,
    spec: spec,
    obligations: obligations,
    holding: holding,
  }

fn reviewed_over(
  flags: Flags,
  collection: Collection,
  v: Verdicts,
  changes: Changes,
  a: AcceptResult,
) -> CommandOutput / {abort.raise} =
  if flags.action == "accept" { accepted_over(flags, collection, a) } else {
    review_output(
      style_of(flags),
      collection,
      v,
      changes,
      rows_of(collection.claims, all_of(collection.claims), v),
    )
  }

fn review_fixture(
  flags: Flags,
  c: Collection,
  d: DischargeResult,
  baselines: List<{ name: String, record: ClaimSnapshot }>,
  a: AcceptResult,
) -> CommandOutput / {abort.raise} =
  handle {
    review_over(
      style_of(flags),
      flags,
      claims::no_options(),
      collected_part(c),
      claimed_part(c),
      no_static_prover(None),
      |_c: Collection, runs: List<Int>, _settled: List<StaticResult>|
        Ok({
          ..d,
          outcomes: runs.fold([], |out: List<Outcome>, i: Int|
            match d.outcomes.at(i) { Some(o) -> out.push(o), None -> out }),
        }),
    )
  } with {
    proof_store.cached(keys) -> keys.map(|_k: String| None),
    proof_store.record(entries) -> [],
    proof_store.baselines(names) -> baselines,
    proof_store.accepted(records) -> { ..a, definitions: records.len() },
  }

fn accepted_over(
  flags: Flags,
  collection: Collection,
  a: AcceptResult,
) -> CommandOutput / {abort.raise} =
  review_fixture(
    flags,
    collection,
    { outcomes: [], duration_ms: Decimal::of_int(0), warnings: [] },
    [],
    a,
  )

fn nothing_accepted() -> AcceptResult = { definitions: 0, stored: true, warnings: [] }

fn changed_flags() -> Flags / {abort.raise} = from_argv("review", [])

fn one_claim() -> List<Claim> = [a_claim("m.double", Ensures(0))]

test "a definition that carries no obligation that holds is reported as unread, not as checked" {
  let ch: Changes = {
    ..no_changes(),
    reviewed: 3,
    changed: [a_change("m.double", Changed, Never, [], 0)],
  };
  let answer = reviewed_over(
    changed_flags(),
    a_collection([]),
    verdicts([], 3),
    ch,
    nothing_accepted(),
  );
  assert_eq(answer.code, 0);
  assert_eq(
    answer.lines.at_or(1, ""),
    "   1 of 3 definitions changed since the last accepted review · 3 of them have a baseline",
  );
  assert_eq(answer.lines.at_or(3, ""), "   m.double · implementation changed · no spec");
  assert_eq(
    answer.lines.at_or(4, ""),
    "     → read the implementation, line by line, exactly as today",
  );
  assert(
    answer.lines.at_or(answer.lines.len() - 1, "").contains(
      "carry no obligation that holds, so this run says nothing about whether their behaviour changed",
    ),
  )
}

test "nothing changed is said outright, so a quiet run is not read as an empty one" {
  let answer = reviewed_over(
    changed_flags(),
    a_collection([]),
    verdicts([], 2),
    no_changes(),
    nothing_accepted(),
  );
  assert_eq(
    answer.lines.at_or(answer.lines.len() - 1, ""),
    "   no definition changed since the last accepted review",
  )
}

test "an unproved obligation on a changed definition says nothing was established, and fails the run" {
  let ch: Changes = {
    ..no_changes(),
    reviewed: 1,
    broken: 1,
    undischarged: 1,
    changed: [a_change("m.stored", Changed, Unchanged, [0], 0)],
  };
  let gap = Unproved(UnhandledEffect(Some("{db.read[rows]}")));
  let answer = reviewed_over(
    changed_flags(),
    a_collection(one_claim()),
    verdicts([gap], 1),
    ch,
    nothing_accepted(),
  );
  let headline = answer.lines.at_or(answer.lines.len() - 1, "");
  assert(headline.contains("1 obligation on a changed definition was not proved"));
  assert(!headline.contains("no longer hold"));
  assert_eq(answer.lines.at_or(3, ""), "   m.stored · implementation changed · spec unchanged");
  assert(answer.lines.at_or(4, "").contains("unproved"));
  assert_eq(answer.code, failure_code())
}

test "an obligation Ply failed on under a changed definition was not proved, and fails the run" {
  let c = {
    ..a_collection(one_claim()),
    definitions: [{ name: "m.double", hash: Some("h2"), specs: [] }],
  };
  let answer = review_fixture(
    changed_flags(),
    c,
    { outcomes: [InternalError(a_fault())], duration_ms: Decimal::of_int(0), warnings: [] },
    [{ name: "m.double", record: { definition_hash: "h1", specs: [] } }],
    nothing_accepted(),
  );
  assert_eq(answer.code, 1);
  let headline = answer.lines.at_or(answer.lines.len() - 1, "");
  assert(headline.contains("1 obligation on a changed definition was not proved"));
  assert(!headline.contains("no longer hold"));
  assert(answer.lines.filter(|l: String| l.contains("! internal error")).len() == 1)
}

test "a refuted obligation under a changed definition is exit 1 and says it no longer holds" {
  let ch: Changes = {
    ..no_changes(),
    reviewed: 1,
    broken: 1,
    changed: [a_change("m.double", Changed, Unchanged, [0], 0)],
  };
  let answer = reviewed_over(
    changed_flags(),
    a_collection(one_claim()),
    verdicts([Refuted(a_counter())], 1),
    ch,
    nothing_accepted(),
  );
  assert_eq(answer.code, 1);
  assert(answer.lines.at_or(4, "").contains("no longer holds"));
  assert(
    answer.lines.at_or(answer.lines.len() - 1, "").contains(
      "1 obligation on a changed definition no longer hold",
    ),
  )
}

test "what a reader is left to do depends on which half moved" {
  assert_eq(
    advice(a_change("m.a", Changed, Unchanged, [0], 1)),
    "review the obligations, not the diff",
  );
  assert_eq(
    advice(a_change("m.a", Unchanged, Changed, [0], 1)),
    "review the spec diff; the implementation did not move",
  );
  assert_eq(
    advice(a_change("m.a", Never, Never, [0], 1)),
    "never accepted: review the spec and the implementation once",
  );
  assert_eq(
    advice(a_change("m.a", Changed, Changed, [0], 1)),
    "review both; what is proved says how much the machine already checked",
  );
  assert_eq(
    advice(a_change("m.a", Changed, Changed, [0], 0)),
    "no obligation on this definition holds: read the implementation, line by line",
  )
}

test "the object names what moved, what it covers and the sentence to act on" {
  let ch: Changes = {
    ..no_changes(),
    reviewed: 3,
    changed: [a_change("m.double", Changed, Never, [0], 1)],
  };
  let answer = reviewed_over(
    from_argv("review", ["--json"]),
    a_collection(one_claim()),
    verdicts([proved([], 1)], 3),
    ch,
    nothing_accepted(),
  );
  let text = to_string(answer.json);
  assert(text.contains("\"command\":\"review\""));
  assert(text.contains("\"action\":\"changed\""));
  assert(text.contains("\"definitions\":3"));
  assert(text.contains("\"specified_changed\":1"));
  assert(text.contains("\"unspecified_changed\":0"));
  assert(text.contains("\"implementation\":\"changed\""));
  assert(text.contains("\"spec\":\"never reviewed\""));
  assert(text.contains("\"outcome\":\"proved\""))
}

test "a definition with no obligation at all reports `none` rather than a spec that never moved" {
  let e = a_change("m.double", Changed, Never, [], 0);
  assert_eq(spec_word(e), "none");
  assert_eq(row_of(e), "m.double · implementation changed · no spec");
  assert_eq(row_of(a_change("m.new", Never, Never, [], 0)), "m.new · never reviewed")
}

fn three_claims() -> Collection =
  a_collection([a_claim("m.a", Ensures(0)), a_claim("m.b", Ensures(0)), a_claim("m.c", Ensures(0))])

test "`--accept` records a baseline and says what a name change costs" {
  let accepted: AcceptResult = { definitions: 0, stored: true, warnings: [] };
  let answer = reviewed_over(
    from_argv("review", ["--accept"]),
    three_claims(),
    verdicts([], 3),
    no_changes(),
    accepted,
  );
  assert_eq(answer.code, 0);
  assert_eq(answer.lines, [
    "   3 definitions accepted as reviewed",
    "   the baseline is keyed by name, so renaming one loses its baseline and reports it as unreviewed",
  ]);
  assert(to_string(answer.json).contains("\"action\":\"accept\""));
  assert(to_string(answer.json).contains("\"accepted\":3"))
}

test "a baseline that could not be stored is exit 1 and says so" {
  let e: Diagnostic = {
    code: b"W0304",
    notes: 0,
    labels: [],
    text: b"",
    message: b"the cache would not flush",
    notes_text: [],
    severity: b"error",
    fixes: [],
  };
  let accepted: AcceptResult = { definitions: 0, stored: false, warnings: [e] };
  let answer = reviewed_over(
    from_argv("review", ["--accept"]),
    three_claims(),
    verdicts([], 3),
    no_changes(),
    accepted,
  );
  assert_eq(answer.code, 1);
  assert_eq(answer.lines.at_or(2, ""), "   error: the cache would not flush");
  assert(to_string(answer.json).contains("\"ok\":false"))
}

test "a review decides what moved from the baselines the runtime holds" {
  let c = {
    ..a_collection([]),
    definitions: [
      { name: "m.double", hash: Some("h2"), specs: [] },
      { name: "m.same", hash: Some("h1"), specs: [] },
    ],
  };
  let answer = review_fixture(
    changed_flags(),
    c,
    { outcomes: [], duration_ms: Decimal::of_int(0), warnings: [] },
    [
      { name: "m.double", record: { definition_hash: "h1", specs: [] } },
      { name: "m.same", record: { definition_hash: "h1", specs: [] } },
    ],
    nothing_accepted(),
  );
  assert_eq(answer.lines.at_or(0, ""), "   2 definitions · 0 carry an obligation · 2 do not");
  assert_eq(answer.lines.at_or(1, ""), "   2 not covered by a claim that holds: m.double, m.same");
  assert_eq(
    answer.lines.at_or(2, ""),
    "   1 of 2 definitions changed since the last accepted review · 2 of them have a baseline",
  );
  assert_eq(answer.lines.at_or(4, ""), "   m.double · implementation changed · no spec")
}
