import compiler.load (Derives)
import compiler.cc (toolchain)
import compiler.unit (shipped)
import std.random (entropy)
import std.time (time)
import builder (builder)
import args (Flags, style_of)
import lock (Pin, from_front)
import program (Program, load_program)
import report (CommandOutput, indent, ok_code, rejected, reported)
import std.term (Style)
import compiler.check.resolve.tables (Diagnostic, error_at)
import compiler.check.resolve.scopes (PackageDependencies)
import std.fs (fs)
import std.json (Json, Array, Bool, Null, Number, Str, object, to_string)
import std.list
import std.string
import compiler.syntax.parsing (no_module, dummy_span)

fn unknown(name: String) -> Diagnostic =
  error_at(
    b"E0101",
    no_module(),
    dummy_span(),
    Bytes::of_string("`" ++ name ++ "` is not a package in this project's dependencies"),
    b"nothing in this project depends on it",
    [b"`ply resolve` lists every package this project depends on, one per line"],
  )

fn index_of(packages: List<PackageDependencies>, name: Bytes) -> Option<Int> / {abort.raise} =
  find_prefix(packages, name, 0)

fn find_prefix(
  packages: List<PackageDependencies>,
  name: Bytes,
  i: Int,
) -> Option<Int> / {abort.raise} =
  if i >= packages.len() { None }
  else if packages.get(i).prefix == name { Some(i) }
  else { find_prefix(packages, name, i + 1) }

fn prepended(path: List<Int>, x: Int) -> List<Int> =
  path.fold([x], |accumulator: List<Int>, y: Int| accumulator.push(y))

fn chain(
  packages: List<PackageDependencies>,
  start: Int,
  wanted: Int,
  seen: List<Int>,
) -> Option<List<Int>> / {abort.raise} =
  find_chain(packages, start, wanted, seen, packages.len() + 1)

fn find_chain(
  packages: List<PackageDependencies>,
  start: Int,
  wanted: Int,
  seen: List<Int>,
  depth_left: Int,
) -> Option<List<Int>> / {abort.raise} =
  if start == wanted { Some([start]) }
  else if seen.contains(start) || depth_left <= 0 { None } else {
    let seen = seen.push(start);
    match search_dependencies(
        packages,
        packages.get(start).dependencies,
        wanted,
        seen,
        depth_left - 1,
      ) {
      None -> None,
      Some(path) -> Some(prepended(path, start)),
    }
  }

fn search_dependencies(
  packages: List<PackageDependencies>,
  names: List<Bytes>,
  wanted: Int,
  seen: List<Int>,
  depth_left: Int,
) -> Option<List<Int>> / {abort.raise} =
  match names {
    [] -> None,
    [name, ..rest] -> match index_of(packages, name) {
      None -> search_dependencies(packages, rest, wanted, seen, depth_left),
      Some(j) -> match find_chain(packages, j, wanted, seen, depth_left) {
        Some(path) -> Some(path),
        None -> search_dependencies(packages, rest, wanted, seen, depth_left),
      },
    },
  }

fn pin_of(pins: List<Pin>, name: String) -> Option<Pin> =
  pins.fold(None, |found: Option<Pin>, pin: Pin|
    match found { Some(_) -> found, None -> if pin.name == name { Some(pin) } else { None } })

fn names_of(packages: List<PackageDependencies>, path: List<Int>) -> List<String> / {abort.raise} =
  path.map(|i: Int| String::of_bytes_lossy(packages.get(i).prefix))

fn json_of(names: List<String>, pins: List<Pin>, name: String, root: Bool, code: Int) -> Json = {
  let pin = pin_of(pins, name);
  object([
    { key: "command", value: Str("why") },
    { key: "ok", value: Bool(code == ok_code()) },
    { key: "exit_code", value: Number(Decimal::of_int(code)) },
    { key: "package", value: Str(name) },
    { key: "root", value: Bool(root) },
    { key: "path", value: Array(names.map(|n: String| Str(n))) },
    { key: "version", value: match pin { Some(p) -> Str(p.version), None -> Null } },
    { key: "digest", value: match pin { Some(p) -> Str(p.digest), None -> Null } },
  ])
}

fn reason_lines(names: List<String>, pins: List<Pin>) -> List<String> = {
  let last = match names.at(names.len() - 1) { Some(n) -> n, None -> "" };
  let path = [indent() ++ String::join(names, " -> ")];
  match pin_of(pins, last) {
    None -> path,
    Some(p) -> path.push(indent() ++ "  " ++ p.version ++ " · " ++ p.digest),
  }
}

pub fn run(
  flags: Flags,
) -> CommandOutput / {shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, Derives, abort.raise, diverges, shipped.report_view_used} = {
  let s: Style = style_of(flags);
  let loaded: Program = load_program(flags.paths, flags.verify_dependencies);
  match loaded.frame {
    None -> rejected(s, "why", loaded.diagnostics, loaded.source_texts),
    Some(w) -> {
      let query = flags.query;
      match index_of(w.packages, Bytes::of_string(query)) {
        None -> reported(s, "why", [unknown(query)], loaded.source_texts),
        Some(i) -> {
          let path = chain(w.packages, 0, i, []);
          match path {
            None -> reported(s, "why", [unknown(query)], loaded.source_texts),
            Some(indices) -> {
              let names = names_of(w.packages, indices);
              {
                json: json_of(names, from_front(w.pins), query, i == 0, ok_code()),
                lines: if flags.json { [] } else if i == 0 {
                  [indent() ++ "this is the root package: the project's own sources"]
                } else { reason_lines(names, from_front(w.pins)) },
                errs: [],
                code: ok_code(),
              }
            },
          }
        },
      }
    },
  }
}

test "`reason_lines` prints the dependency path from the root package, then the locked version and digest" {
  let names = ["app", "left", "shared"];
  let pins = [{ name: "shared", version: "0.3.0", digest: "b3:ab" }];
  assert_eq(reason_lines(names, pins), ["   app -> left -> shared", "     0.3.0 · b3:ab"]);
  assert_eq(reason_lines(["app"], []), ["   app"])
}

test "`chain` returns the declared dependency path between two packages, and `None` when there is no path" {
  let packages: List<PackageDependencies> = [
    { prefix: b"app", dependencies: [b"left", b"right"] },
    { prefix: b"left", dependencies: [b"shared"] },
    { prefix: b"right", dependencies: [] },
    { prefix: b"shared", dependencies: [] },
  ];
  assert_eq(chain(packages, 0, 3, []), Some([0, 1, 3]));
  assert_eq(chain(packages, 0, 2, []), Some([0, 2]));
  assert_eq(chain(packages, 0, 0, []), Some([0]));
  assert_eq(chain(packages, 1, 2, []), None)
}

test "the json result carries the path, the pin, and whether it is the root" {
  let text = to_string(
    json_of(
      ["app", "lib"],
      [{ name: "lib", version: "0.1.0", digest: "b3:1f" }],
      "lib",
      false,
      ok_code(),
    ),
  );
  assert(text.contains("\"command\":\"why\""));
  assert(text.contains("\"path\":[\"app\",\"lib\"]"));
  assert(text.contains("\"version\":\"0.1.0\""));
  assert(text.contains("\"digest\":\"b3:1f\""));
  assert(text.contains("\"root\":false"))
}
