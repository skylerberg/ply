import std.bin
import std.bytes
import std.ed25519
import std.fs (fs, Dir, File, MemFs, mem_kind, mem_of, mem_read, mem_read_secret, mem_framed_secret,
               on_mem)
import std.path (resolve, strip_root)
import std.random (entropy)
import std.string
import compiler.check.resolve.tables (Diagnostic, error_at)
import paths
import sources
import compiler.syntax.parsing (no_module, dummy_span)

const secret_word: String = "ply-ed25519-secret"

const public_word: String = "ply-ed25519-public"

const secret_head: Bytes = Bytes::of_string(secret_word ++ " ")

pub fn write_seed(
  p: paths::RootedPath,
  seed: Secret<Bytes>,
) -> Bool / {fs.write_secret[cwd], fs.write_secret[abs]} =
  paths::write_secret(p, secret_head, seed, "hex", b"\n")

pub fn public_text(public: Bytes) -> String / {abort.raise} =
  public_word ++ " " ++ public.hex_of() ++ "\n"

fn is_hex(text: String) -> Bool =
  text.chars().fold(true, |ok: Bool, c: Char|
    ok && ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))

fn key_of(text: String, word: String) -> Result<Bytes, String> / {abort.raise} =
  match text.trim().split(" ") {
    [w, hex] -> if w != word { Err("it is not a `" ++ word ++ "` key") }
    else if hex.len() != 64 || !is_hex(hex) { Err("its key is not 64 lower-case hex digits") }
    else { Ok(Bytes::of_hex(hex)) },
    _ -> Err("it is not one `" ++ word ++ " <hex>` line"),
  }

pub fn read_seed(
  path: String,
) -> Result<Secret<Bytes>, Diagnostic> / {fs.read_secret[cwd], fs.read_secret[abs], abort.raise} = {
  let at = paths::rooted_path(path);
  let line = match paths::read_secret(at, secret_head, "hex", b"\n") {
    Some(seed) -> Some(seed),
    None -> paths::read_secret(at, secret_head, "hex", b""),
  };
  match line {
    Some(seed) -> if seed.len() == 32 { Ok(seed) } else {
      Err(unreadable_key(path, "does not contain a secret key: its key is not 64 hex digits"))
    },
    None -> if paths::read_secret(at, Bytes::of_string(public_word ++ " "), "raw", b"") != None {
      Err(
        unreadable_key(path, "does not contain a secret key: it is a `" ++ public_word ++ "` key"),
      )
    } else {
      Err(unreadable_key(path, "is not there, or not one `" ++ secret_word ++ " <hex>` line"))
    },
  }
}

pub fn public_of(text: String) -> Result<Bytes, String> / {abort.raise} = key_of(text, public_word)

pub fn fresh_seed() -> Secret<Bytes> / {entropy.secret} = entropy.secret(32)

pub fn unreadable_key(path: String, reason: String) -> Diagnostic =
  error_at(
    b"E0462",
    no_module,
    dummy_span,
    Bytes::of_string("the key file `" ++ path ++ "` " ++ reason),
    b"a key file is one line `ply keygen` writes",
    [b"`ply keygen PATH` writes a secret key to PATH and its public key to PATH.pub"],
  )

pub type Provenance = {
  kind: String,
  name: String,
  digest: String,
  builder: String,
  semantics: String,
  commit: String,
}

derive bin for Provenance

pub fn provenance_bytes(p: Provenance) -> Bytes / {abort.raise} = bin::encode(p, provenance_bin())

pub fn provenance_of(b: Bytes) -> Option<Provenance> / {abort.raise} =
  match bin::decode(b, provenance_bin()) { Ok(p) -> Some(p), Err(_) -> None }

pub fn signatures_path(artifact: String) -> String = artifact ++ ".sig"

fn text_at(path: String) -> Option<String> / {fs.read_file[abs], abort.raise} =
  match fs.read_file[abs](strip_root(path)) {
    Some(b) -> Some(String::of_bytes_lossy(b).trim()),
    None -> None,
  }

type Repo = { git: String, common_directory: String }

fn repo_of(dir: String) -> Option<Repo> / {fs.kind[abs], fs.read_file[abs], abort.raise} =
  match paths::checkout_of(dir) {
    None -> None,
    Some(tree) -> {
      let dot = tree ++ "/.git";
      match fs.kind[abs](strip_root(dot)) {
        Dir -> Some({ git: dot, common_directory: dot }),
        File -> match text_at(dot) {
          Some(line) -> if !line.starts_with("gitdir: ") { None } else {
            let git = resolve(tree, line.slice(8, line.len()));
            let common = match text_at(git ++ "/commondir") {
              None -> git,
              Some(c) -> resolve(git, c),
            };
            Some({ git: git, common_directory: common })
          },
          None -> None,
        },
        _ -> None,
      }
    },
  }

fn packed_ref(common: String, name: String) -> Option<String> / {fs.read_file[abs], abort.raise} =
  match text_at(common ++ "/packed-refs") {
    None -> None,
    Some(text) ->
      text.split("\n").fold(None, |found: Option<String>, line: String|
        match found {
          Some(_) -> found,
          None -> match line.split(" ") {
            [hash, n] -> if n == name { Some(hash) } else { None },
            _ -> None,
          },
        }),
  }

pub fn head_commit(dir: String) -> String / {fs.kind[abs], fs.read_file[abs], abort.raise} =
  match repo_of(dir) {
    None -> "",
    Some(r) -> match text_at(r.git ++ "/HEAD") {
      None -> "",
      Some(head) -> if !head.starts_with("ref: ") { head } else {
        let name = head.slice(5, head.len());
        match text_at(r.git ++ "/" ++ name) {
          Some(hash) -> hash,
          None -> match text_at(r.common_directory ++ "/" ++ name) {
            Some(hash) -> hash,
            None -> match packed_ref(r.common_directory, name) { Some(hash) -> hash, None -> "" },
          },
        }
      },
    },
  }

pub fn a_seed(n: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(range(0, 32).map(|i: Int| byte_of_int((i + n) % 256)))

test "`read_seed` accepts a file containing a secret seed line and rejects a public key or other text" {
  let seed = a_seed(7);
  let line = "ply-ed25519-secret " ++ seed.hex_of();
  let public = ed25519::public_key(Secret::of_bytes(seed));
  let disk = mem_of([
    { path: "keys/line", body: Bytes::of_string(line ++ "\n") },
    { path: "keys/bare", body: Bytes::of_string(line) },
    { path: "keys/public", body: Bytes::of_string(public_text(public)) },
    { path: "keys/short", body: b"ply-ed25519-secret 00\n" },
    {
      path: "keys/upper",
      body: Bytes::of_string(secret_word ++ " " ++ seed.hex_of().ascii_upper()),
    },
    { path: "keys/other", body: b"a seed\n" },
  ]);
  let read = |path: String|
    handle {
      match read_seed(path) {
        Ok(seed) -> Ok(seed),
        Err(d) -> Err(String::of_bytes_lossy(d.message)),
      }
    } with {
      fs.read_secret[cwd](p, before, encoding, after) ->
        mem_read_secret(disk, p, before, encoding, after),
      fs.read_secret[abs](p, before, encoding, after) -> None,
    };
  assert(read("keys/line") == Ok(Secret::of_bytes(seed)));
  assert(read("keys/bare") == Ok(Secret::of_bytes(seed)));
  assert_eq(public_of(public_text(public)), Ok(public));
  assert(match public_of(line) { Err(_) -> true, Ok(_) -> false });
  let rejected = |path: String, reason: String|
    read(path) == Err("the key file `" ++ path ++ "` " ++ reason);
  assert(
    rejected("keys/public", "does not contain a secret key: it is a `ply-ed25519-public` key"),
  );
  assert(rejected("keys/short", "does not contain a secret key: its key is not 64 hex digits"));
  let unread = "is not there, or not one `ply-ed25519-secret <hex>` line";
  assert(rejected("keys/upper", unread) && rejected("keys/other", unread));
  assert(rejected("keys/none", unread))
}

test "`write_seed` writes the seed as one line that only the file's owner can read, and `read_seed` returns the same seed" {
  let seed = Secret::of_bytes(a_seed(9));
  let written = handle {
    on_mem[cwd](mem_of([]), || {
      let wrote = write_seed(paths::rooted_path("release.key"), seed);
      let back = match read_seed("release.key") { Ok(s) -> Some(s), Err(_) -> None };
      { wrote: wrote, back: back }
    })
  } with {
    fs.read_secret[abs](p, before, encoding, after) -> None,
    fs.write_secret[abs](p, before, secret, encoding, after) -> false,
  };
  assert(written.value.wrote && written.value.back == Some(seed));
  assert(
    mem_framed_secret(written.tree, "release.key")
      == Some({ before: b"ply-ed25519-secret ", secret: seed, encoding: "hex", after: b"\n" }),
  );
  assert_eq(mem_read(written.tree, "release.key"), None)
}

test "`fresh_seed` requests thirty-two bytes from the secret entropy source" {
  let drawn = handle {
    fresh_seed()
  } with {
    var requested_bytes = 0,
    entropy.secret(n) -> {
      requested_bytes = n;
      Secret::of_bytes(a_seed(n))
    },
    return seed -> { seed: seed, requested: requested_bytes },
  };
  assert(drawn.seed == Secret::of_bytes(a_seed(32)));
  assert_eq(drawn.requested, 32)
}

fn commit_on(disk: MemFs, dir: String) -> String / {abort.raise} =
  handle {
    head_commit(dir)
  } with {
    fs.kind[abs](p) -> mem_kind(disk, p),
    fs.read_file[abs](p) -> mem_read(disk, p),
  }

test "a linked worktree's commit is read from the repository its commondir names" {
  let disk = mem_of([
    { path: "repo/.git/HEAD", body: b"ref: refs/heads/main\n" },
    { path: "repo/.git/refs/heads/main", body: b"1111\n" },
    { path: "repo/.git/refs/heads/topic", body: b"2222\n" },
    { path: "repo/.git/worktrees/topic/HEAD", body: b"ref: refs/heads/topic\n" },
    { path: "repo/.git/worktrees/topic/commondir", body: b"../..\n" },
    { path: "trees/topic/.git", body: b"gitdir: /repo/.git/worktrees/topic\n" },
  ]);
  assert_eq(commit_on(disk, "/repo"), "1111");
  assert_eq(commit_on(disk, "/trees/topic"), "2222");
  assert_eq(commit_on(disk, "/trees"), "")
}

test "a relative gitdir is read from the checkout that names it" {
  let disk = mem_of([
    { path: "app/.git/modules/lib/HEAD", body: b"3333\n" },
    { path: "app/lib/.git", body: b"gitdir: ../.git/modules/lib\n" },
  ]);
  assert_eq(commit_on(disk, "/app/lib/src"), "3333")
}
