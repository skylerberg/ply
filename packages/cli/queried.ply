//! A project's modules answered through the memo store: the world the compiler's queries read, as
//! the walk and the toolchain's shipped modules hold it.

import std.fs (fs)
import compiler.store.memo
import compiler.store.memo (Read, Record, Run, Tally, asked_reads, digest_of, reached, recorded,
                            lost_in, standing, started, tallies, vouched_to)
import compiler.store.memo_files
import compiler.store.packs
import compiler.unit (shipped, pack_frame)
import compiler.front.checking (Answered, OwnFile, OwnPackage, World, asked_all, declaring_in,
                                documented_all, evaluator_of, hashed_all, looked, nothing_derived,
                                refused_first, registry, shipped_all, shipped_covers,
                                shipped_queries, walked_covers, wanted_all, world_of, world_placing)
import compiler.front.checking.world (CheckQuery, Driving, Named, decoding_once)
import compiler.load (Derives, derived_at)
import compiler.front.pages (Pages)
import compiler.front (ShippedWants, inputs_of, shipped_bytes)
import compiler.store.hash.forms (ModuleHashed)
import sources (Project, File, DepPackage, Embed, embed_now, embed_of)
import compiler.check.resolve.tables (Diag, diag_bin)
import interfaces
import std.bin
import std.hash (blake3)
import std.zstd
import std.list
import compiler.front.interface (sized)
import compiler.expand.embed (BytesRead, EmbedAt, EmbedBytes, EmbedFile, EmbedRead, EmbedWant,
                              want_of_key)

fn own_file(f: File) -> OwnFile = { module: Bytes::of_string(f.module), text: f.text }

/// The world a load of `project` reads.
fn world(project: Project) -> World / {abort.raise} =
  world_of(
    {
      root: Bytes::of_string(project.root_key),
      manifest: match project.manifest { None -> None, Some(f) -> Some(f.text) },
      files: project.files.map(own_file),
    },
    project.packages.map(|p: DepPackage|
      { root: Bytes::of_string(p.root), manifest: p.manifest, files: p.files.map(own_file) }),
  )

/// The modules a load of `project` that followed a file's imports looked for and did not find.
fn absent_of(project: Project) -> List<Bytes> =
  project.absent.map(|name: String| Bytes::of_string(name))

/// The walk, as a place: the path and name of each module it found, and what it refused, which a
/// command's answer reads beside its modules' texts.
fn walk_kind() -> Bytes = b"walk"

/// What each registry dependency's slot holds, as a place.
fn published_kind() -> Bytes = b"published"

fn walked_of(project: Project) -> Bytes / {abort.raise} =
  bin::encode(
    {
      files: project.files.map(|f: File| { path: f.path, module: f.module }),
      diags: project.diags,
    },
    walked_bin(),
  )

type Walked = { files: List<{ path: String, module: String }>, diags: List<Diag> }

derive bin for Walked

/// What each registry dependency's slot of `project` holds.
fn published_of(project: Project) -> Bytes / {fs.read_file[abs], abort.raise} =
  bin::encode(
    interfaces::slots(project.root_key, project.packages.map(|p: DepPackage| p.root)).map(
      |slot: String| { slot: slot, held: interfaces::slot_read(slot) },
    ),
    bin::list_bin(published_bin()),
  )

type Published = { slot: String, held: Option<Bytes> }

derive bin for Published

/// What the world of `project`, whose queries read `w`, holds at `at` as `kind` reads it, what a
/// module of it embeds read through `read`, and what each library deriver it names answers.
fn project_look<| e>(
  project: Project,
  w: World,
  read: (Int, Bytes, EmbedWant) -> BytesRead / {fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise | e},
  kind: Bytes,
  at: Bytes,
) -> Option<Bytes> / {fs.list_dir[shipped], fs.read_file[shipped], fs.read_file[abs], Derives, abort.raise | e} =
  if kind == walk_kind() { Some(walked_of(project)) }
  else if kind == published_kind() { Some(published_of(project)) } else {
    looked(
      w,
      |name: Bytes| shipped_module(name),
      |name: Bytes| shipped_data(name),
      || shipped_names(),
      read,
      |ask: Bytes| derived_at(w, ask),
      kind,
      at,
    )
  }

/// The files a load reads of what its own modules embed, as it reads them.
effect embedded {
  write seen(files: List<EmbedBytes>) -> Unit
}

/// What module `module` of package `k` of `project` embeds as `want` asks, read beside its file and
/// told to `embedded`.
fn embed_seen(
  project: Project,
  k: Int,
  module: Bytes,
  want: EmbedWant,
) -> BytesRead / {embedded.seen, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} = {
  let read = embed_now(project, k, module, want);
  match read { Ok(files) -> embedded.seen(files), Err(_) -> () };
  read
}

/// What `go` answers, beside the bytes of each file it told `embedded` it read, by digest.
fn seeing<a | e>(
  go: () -> a / {embedded.seen, abort.raise | e},
) -> { value: a, seen: Map<Bytes, Bytes> } / {abort.raise | e} =
  handle {
    go()
  } with {
    var seen: Map<Bytes, Bytes> = Map::new(),
    embedded.seen(files) -> {
      seen = files.fold(seen, |m: Map<Bytes, Bytes>, f: EmbedBytes|
        m.insert(blake3(f.bytes), f.bytes));
    },
    return v -> { value: v, seen: seen },
  }

/// The files `read` names, as `seen` holds them by digest: none where it lacks one of them.
fn seen_files(seen: Map<Bytes, Bytes>, read: EmbedRead) -> Option<List<EmbedBytes>> =
  match read {
    Err(_) -> None,
    Ok(files) ->
      files.fold(Some([]), |acc: Option<List<EmbedBytes>>, f: EmbedFile|
        match ((acc, seen.get(f.digest))) {
          (Some(xs), Some(b)) -> Some(xs.push({ name: f.name, bytes: b })),
          _ -> None,
        }),
  }

/// The bytes of each file `answers` say the load's modules embed, by digest: as the run read it where
/// `seen` holds it, else read again beside its module's file, or off the binary for a shipped module.
/// `Err` refuses one that reads otherwise now.
fn inputs_answered(
  project: Project,
  w: World,
  answers: List<Answered>,
  seen: Map<Bytes, Bytes>,
) -> Result<Map<Bytes, Bytes>, List<Diag>> / {fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  inputs_of(
    answers.fold([], |acc: List<EmbedAt>, a: Answered|
      acc.concat(a.answer.shape.embeds.map(|e: EmbedAt| { ..e, module: a.module }))),
    |e: EmbedAt|
      match world_placing(w, e.module) {
        Some(p) -> match seen_files(seen, e.read) {
          Some(files) -> Ok(files),
          None -> embed_now(project, p.package, p.relative, want_of_key(e.key)),
        },
        None -> shipped_bytes(e.module, e.key, shipped_module, shipped_data),
      },
  )

/// What `answers` say the load's own modules embed, each beside its module's file.
fn embeds_answered(
  project: Project,
  w: World,
  answers: List<Answered>,
) -> List<Embed> / {abort.raise} =
  answers.fold([], |acc: List<Embed>, a: Answered|
    match world_placing(w, a.module) {
      None -> acc,
      Some(p) ->
        a.answer.shape.embeds.fold(acc, |es: List<Embed>, e: EmbedAt|
          match embed_of(project, p.package, p.relative, want_of_key(e.key), e.read) {
            Some(x) -> es.push(x),
            None -> es,
          }),
    })

fn shipped_module(name: Bytes) -> Option<Bytes> / {fs.read_file[shipped]} =
  fs.read_file[shipped](String::of_bytes_lossy(name) ++ ".ply")

fn shipped_data(name: Bytes) -> Option<Bytes> / {fs.read_file[shipped]} =
  fs.read_file[shipped](String::of_bytes_lossy(name))

fn shipped_names() -> List<Bytes> / {fs.list_dir[shipped], abort.raise} =
  match fs.list_dir[shipped](".") {
    None -> [],
    Some(names) ->
      names.fold([], |acc: List<Bytes>, n: String|
        if n.ends_with(".ply") { acc.push(Bytes::of_string(n.slice(0, n.len() - 4))) }
        else { acc }),
  }

/// The queries, each under the hash the program running gives its definition and the evaluator it
/// runs on, which the toolchain ships beside its modules.
fn running() -> Map<Bytes, CheckQuery> / {fs.read_file[shipped], abort.raise} =
  match ((fs.read_file[shipped]("definitions"), fs.read_file[shipped]("stamps"))) {
    (Some(d), Some(stamps)) -> registry(d, evaluator_of(stamps)),
    _ -> panic("the toolchain ships no `definitions` or no `stamps`"),
  }

/// What each module of a load answered, the shipped modules it pulled in the order it pulled them
/// and what each embeds of the shipped modules, what hashing fixed of each where none refuses, the
/// bytes of each file the load embeds by digest, or what refuses one that moved, and what the run
/// did of each query to answer them, whether the store vouched for any record to it, and how many
/// answers it made again that a standing record named and no store held.
pub type Queried = {
  answers: List<Answered>,
  pulled: List<Bytes>,
  wants: Map<Bytes, ShippedWants>,
  /// What hashing fixed of each module, the load's own first, where none refuses.
  modules: List<ModuleHashed>,
  embeds: List<Embed>,
  inputs: Result<Map<Bytes, Bytes>, List<Diag>>,
  asked: List<Read>,
  tallies: List<Tally>,
  vouched: Bool,
  lost: Int,
}

/// What a load with no modules to answer answers.
pub fn nothing() -> Queried =
  {
    answers: [],
    pulled: [],
    wants: Map::new(),
    modules: [],
    embeds: [],
    inputs: Ok(Map::new()),
    asked: [],
    tallies: [],
    vouched: false,
    lost: 0,
  }

type Asked = {
  answers: List<Answered>,
  pulled: List<Bytes>,
  wants: Map<Bytes, ShippedWants>,
  modules: List<ModuleHashed>,
}

/// What `own` and each shipped module they pull answer over `run`, and what hashing fixed of each
/// where none refuses.
fn asked(
  qs: Map<Bytes, CheckQuery>,
  own: List<Bytes>,
  run: Run,
) -> { run: Run, value: Asked } / {Driving, abort.raise} = {
  let all = asked_all(qs, own, [], false, run);
  let answers = all.value.answers;
  let pulled = all.value.pulled;
  let wanted = wanted_all(qs, pulled, false, all.run);
  if refused_first(answers).len() > 0 {
    {
      run: wanted.run,
      value: { answers: answers, pulled: pulled, wants: wanted.value, modules: [] },
    }
  } else {
    let fixed = hashed_all(qs, own, pulled, false, wanted.run);
    {
      run: fixed.run,
      value: { answers: answers, pulled: pulled, wants: wanted.value, modules: fixed.value },
    }
  }
}

/// What each module of `project`'s own packages answers, and each shipped module they pull, through
/// the memo store in `dir`, with what the toolchain ships answered for its shipped modules beside it.
/// `whole` is whether the walk read its root package whole rather than one file of it and what that
/// imports.
pub fn answered<[r]>(
  dir: String,
  project: Project,
  whole: Bool,
) -> Queried / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.answer, Derives, abort.raise} = {
  let qs = running();
  let w = world(project);
  let ran = seeing(||
    memo_files::kept[r](
      dir,
      pack_frame,
      shipped_files(),
      |kind: Bytes, at: Bytes|
        project_look(
          project,
          w,
          |k: Int, m: Bytes, want: EmbedWant| embed_seen(project, k, m, want),
          kind,
          at,
        ),
      || decoding_once(|| asked(qs, w.own, started(qs))),
      covers: |kind: Bytes, at: Bytes| whole || walked_covers(w, absent_of(project), kind, at),
      commands: [program()],
    ));
  let done = ran.value;
  {
    answers: done.value.answers,
    pulled: done.value.pulled,
    wants: done.value.wants,
    modules: done.value.modules,
    embeds: embeds_answered(project, w, done.value.answers),
    inputs: inputs_answered(project, w, done.value.answers, ran.seen),
    asked: asked_reads(done.run),
    tallies: tallies(done.run),
    vouched: vouched_to(done.run),
    lost: lost_in(done.run),
  }
}

/// The `ply` program running and the runtime it runs on: what its definitions hash to and the
/// runtime's stamps, which leave out every shipped definition the program does not reach.
pub fn program() -> Bytes / {fs.read_file[shipped]} =
  blake3(
    Bytes::concat_all([
      sized(match fs.read_file[shipped]("definitions") { Some(b) -> b, None -> b"" }),
      sized(match fs.read_file[shipped]("stamps") { Some(b) -> b, None -> b"" }),
    ]),
  )

/// What a command's answer is kept under: what names the `ply` that answered, and `asked`, what names
/// the command and its line.
pub fn command_key(program: Bytes, asked: Bytes) -> Bytes =
  blake3(Bytes::concat_all([b"ply command answer\x00", program, b"\x00", blake3(asked)]))

/// The answer kept under `key` in the memo store in `dir` for a command over `project`, where it
/// stands; beside the marks found on it, which keeping it again removes, and what the run that
/// settled the store's marks to find out did: every query a later load would have run, it ran.
/// `whole` is whether the walk read its root package whole.
pub fn command_kept<[r]>(
  dir: String,
  project: Project,
  key: Bytes,
  whole: Bool,
) -> { output: Option<Bytes>, marks: List<Bytes>, tallies: List<Tally>, lost: Int } / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.answer, Derives, abort.raise} = {
  let qs = running();
  let w = world(project);
  let kept = memo_files::kept[r](
    dir,
    pack_frame,
    shipped_files(),
    |kind: Bytes, at: Bytes|
      project_look(
        project,
        w,
        |k: Int, m: Bytes, want: EmbedWant| embed_now(project, k, m, want),
        kind,
        at,
      ),
    || decoding_once(|| standing(qs, started(qs), key)),
    covers: |kind: Bytes, at: Bytes| whole || walked_covers(w, absent_of(project), kind, at),
    commands: [program()],
  );
  { output: kept.output, marks: kept.marks, tallies: tallies(kept.run), lost: lost_in(kept.run) }
}

/// `output` kept under `key` in the memo store in `dir` as a command's answer over `project` made by
/// the `ply` `program` names: a function of `asked`, what its load asked, and of the walk and what
/// each registry slot holds. `marks` are the marks [`command_kept`] found on it. Whether the store
/// holds it now.
pub fn keep_command<[r]>(
  dir: String,
  project: Project,
  key: Bytes,
  program: Bytes,
  asked: List<Read>,
  output: Bytes,
  marks: List<Bytes>,
) -> Bool / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.answer, Derives, abort.raise} = {
  let qs = running();
  let w = world(project);
  let reads = asked.concat([
    memo::World(walk_kind(), b"", digest_of(Some(walked_of(project)))),
    memo::World(published_kind(), b"", digest_of(Some(published_of(project)))),
  ]);
  memo_files::kept[r](
    dir,
    pack_frame,
    shipped_files(),
    |kind: Bytes, at: Bytes|
      project_look(
        project,
        w,
        |k: Int, m: Bytes, want: EmbedWant| embed_now(project, k, m, want),
        kind,
        at,
      ),
    || recorded(qs, key, program, reads, output, marks),
    commands: [program],
  );
  // Read back once the run has written what it kept, which a store it cannot write never holds.
  match memo_files::record_at[r](dir, key) {
    Some(rec) -> rec.output == digest_of(Some(output)),
    None -> false,
  }
}

/// The records of what each of `shipped`, the shipped modules, answers to each query a load cannot
/// cheaply answer again, answered through the memo store in `work`: what [`shipped_pack`] packs;
/// beside them, the answer of each shipped module that refuses. The run reads no project, so what a
/// load of one kept in `work` it neither looks at nor names.
pub fn shipped_answers<[r]>(
  work: String,
  shipped: List<Bytes>,
) -> { keys: List<Bytes>, refused: List<Answered> } / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], Derives, abort.raise} = {
  let qs = running();
  let nowhere = world_of({ root: b"", manifest: None, files: [] }, []);
  let wanted = shipped_queries().fold(Map::new(), |acc: Map<Bytes, Bool>, name: Bytes|
    match qs.get(name) { Some(q) -> acc.insert(q.hash, true), None -> acc });
  memo_files::kept[r](
    work,
    packs::no_pack,
    b"",
    |kind: Bytes, at: Bytes|
      looked(
        nowhere,
        shipped_module,
        shipped_data,
        shipped_names,
        |k: Int, m: Bytes, want: EmbedWant| Err(b"no file is there"),
        |ask: Bytes| derived_at(nowhere, ask),
        kind,
        at,
      ),
    ||
      decoding_once(|| {
        let all = shipped_all(qs, shipped, started(qs));
        { keys: reached(qs, wanted, all.run), refused: all.refused }
      }),
    covers: |kind: Bytes, _: Bytes| shipped_covers(kind),
  )
}

/// The pack of the records `keys` names in the store `work`, as [`shipped_answers`] names them: made
/// under this `ply`'s queries over the shipped files it reads, each frame one Zstandard frame. How
/// many records it holds.
pub fn shipped_pack<[r]>(
  work: String,
  keys: List<Bytes>,
) -> { written: packs::Written, records: Int } / {fs.read[r], fs.read_file[shipped], abort.raise} =
  memo_files::packed[r](
    work,
    keys,
    |b: Bytes| zstd::compress(b, zstd::Fast),
    memo::stamp_of(running()),
    shipped_files(),
  )

/// The shipped files this run reads, as the binary lists them (`digests`): a packed record stands as
/// it is only for the very files it was answered over.
fn shipped_files() -> Bytes / {fs.read_file[shipped]} =
  match fs.read_file[shipped]("digests") { Some(b) -> b, None -> b"" }

/// The store a toolchain's own shipped modules are answered through, beside the stage of reused
/// answers `reused` names: a bootstrap's builder checks `ply` through it and `ply std --answers`
/// answers every shipped module through it, so what one answered the other takes, and so does a
/// later bootstrap, whichever `ply` answers.
pub fn shipped_work(reused: String) -> String / {abort.raise} = {
  let cut = range(0, reused.len()).fold(0 - 1, |acc: Int, i: Int|
    if reused.slice(i, i + 1) == "/" { i } else { acc });
  if cut < 0 { "memo-std" } else { reused.slice(0, cut) ++ "/memo-std" }
}

/// [`answered`] with no store of the project's: what the toolchain ships answered for the shipped
/// modules is read, the rest is answered afresh, and nothing is kept.
pub fn answered_afresh(
  project: Project,
) -> Queried / {fs.list_dir[shipped], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.answer, Derives, abort.raise} = {
  let qs = running();
  let w = world(project);
  let ran = seeing(||
    memo::fresh(
      pack_frame,
      shipped_files(),
      |kind: Bytes, at: Bytes|
        looked(
          w,
          shipped_module,
          shipped_data,
          shipped_names,
          |k: Int, m: Bytes, want: EmbedWant| embed_seen(project, k, m, want),
          |ask: Bytes| derived_at(w, ask),
          kind,
          at,
        ),
      || decoding_once(|| asked(qs, w.own, started(qs))),
    ));
  let done = ran.value;
  {
    answers: done.value.answers,
    pulled: done.value.pulled,
    wants: done.value.wants,
    modules: done.value.modules,
    embeds: embeds_answered(project, w, done.value.answers),
    inputs: inputs_answered(project, w, done.value.answers, ran.seen),
    asked: asked_reads(done.run),
    tallies: tallies(done.run),
    vouched: vouched_to(done.run),
    lost: lost_in(done.run),
  }
}

/// What each of `asked`, modules of a load of `project`, documents, through the memo store in `dir`
/// with what the toolchain ships answered beside it. `whole` is whether the walk read its root
/// package whole.
pub fn documented<[r]>(
  dir: String,
  project: Project,
  asked: List<Named>,
  whole: Bool,
) -> List<Pages> / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.answer, Derives, abort.raise} = {
  let qs = running();
  let w = world(project);
  memo_files::kept[r](
    dir,
    pack_frame,
    shipped_files(),
    |kind: Bytes, at: Bytes|
      project_look(
        project,
        w,
        |k: Int, m: Bytes, want: EmbedWant| embed_now(project, k, m, want),
        kind,
        at,
      ),
    || decoding_once(|| documented_all(qs, asked, started(qs)).value),
    covers: |kind: Bytes, at: Bytes| whole || walked_covers(w, absent_of(project), kind, at),
    commands: [program()],
  )
}

/// What `asked` answers of the shipped modules, as the toolchain's own answers hold them: no
/// project is read and nothing is kept.
fn of_shipped<a>(
  asked: (Map<Bytes, CheckQuery>, Run) -> a / {Driving, abort.raise},
) -> a / {fs.list_dir[shipped], fs.read_file[shipped], shipped.answer, abort.raise} = {
  let qs = running();
  let nowhere = world_of({ root: b"", manifest: None, files: [] }, []);
  memo::fresh(
    pack_frame,
    shipped_files(),
    |kind: Bytes, at: Bytes|
      looked(
        nowhere,
        shipped_module,
        shipped_data,
        shipped_names,
        |k: Int, m: Bytes, want: EmbedWant| Err(b"no file is there"),
        nothing_derived,
        kind,
        at,
      ),
    || decoding_once(|| asked(qs, started(qs))),
  )
}

/// What each of `modules`, shipped modules, documents.
pub fn shipped_documented(
  modules: List<Bytes>,
) -> List<Pages> / {fs.list_dir[shipped], fs.read_file[shipped], shipped.answer, abort.raise} =
  of_shipped(|qs: Map<Bytes, CheckQuery>, run: Run|
    documented_all(
      qs,
      modules.map(|m: Bytes| { module: m, shipped: true, tested: false }),
      run,
    ).value)

/// The modules of the standard library that declare each simple name.
pub fn shipped_declaring() -> Map<Bytes, List<Bytes>> / {fs.list_dir[shipped], fs.read_file[shipped], shipped.answer, abort.raise} =
  of_shipped(|qs: Map<Bytes, CheckQuery>, run: Run| declaring_in(qs, b"std", run).value)

/// The hash each query has now, and what names this `ply`, which a command's answer is kept under: a
/// record of any other will never be asked by again.
pub fn current() -> Map<Bytes, Bool> / {fs.read_file[shipped], abort.raise} =
  running().fold(
    Map::new().insert(program(), true),
    |acc: Map<Bytes, Bool>, _: Bytes, q: CheckQuery| acc.insert(q.hash, true),
  )
