import std.fs (fs, Kind, Listed, File, Dir, Missing)
import std.json (Bool)
import paths (ResolvedPath, absolute, child, displayed, kind, read_file)
import library
import walk (Failure)
import program (load_program_with_store, whole_of)
import diagnostic (errors_text)
import builder (builder)
import std.random (entropy)
import std.time (time)
import compiler.cc (toolchain)
import compiler.load (Derives)
import compiler.unit (shipped)
import compiler.front.facts (Analysis)
import compiler.check.resolve.tables (Source, ParsedModule, ValueSpace, EffectSpace)
import compiler.check.resolve.bindings (Reference, Refers, Local, Definition, Operation, Module,
                                        Unbound)
import compiler.check.member (MemberTarget, CallsFunction)
import compiler.syntax.items (parse, Module)
import compiler.syntax.parsing (is_made)
import compiler.syntax.node_ids (numbered_module)
import rename.lines (renamed, shown)
import rename.strings (line_at)
import rename.programs (Entry, Loaded, Read, DefinitionKey, calls_by_module, entries_of, indices_of,
                        key_of)
import rename.edits (Renaming, move_of, moved_name, qualified_after)

fn modules_after(rn: Renaming, l: Loaded, after: Analysis) -> Map<Bytes, Int> / {abort.raise} = {
  let index = indices_of(after.mods.map(|m: ParsedModule| m.name));
  range(0, l.names.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int| {
    let old = l.names.get(i);
    match index.get(moved_name(old, move_of(rn, l, i))) {
      Some(j) -> acc.insert(old, j),
      None -> acc,
    }
  })
}

fn mapped(
  rn: Renaming,
  l: Loaded,
  modules: Map<Bytes, Int>,
  refers: Refers,
) -> Refers / {abort.raise} =
  match refers {
    Local(b) -> Local(b),
    Definition(d) ->
      Definition({
        qualified: qualified_after(rn, l, d.namespace, d.qualified),
        namespace: d.namespace,
      }),
    Operation(o) ->
      Operation({
        effect: qualified_after(rn, l, EffectSpace, o.effect),
        name: match key_of(l, o.effect).and_then(|k: DefinitionKey| rn.operations.get(k)) {
          Some(ops) -> ops.get(o.name).unwrap_or(o.name),
          None -> o.name,
        },
      }),
    Module(i) -> match l.names.at(i) {
      Some(name) -> match modules.get(name) { Some(j) -> Module(j), None -> Unbound },
      None -> Unbound,
    },
    Unbound -> Unbound,
  }

fn moved_failure(r: Read, x: Reference) -> Failure / {abort.raise} =
  {
    path: displayed(r.file.at) ++ ":" ++ line_at(r.file.text, x.start).to_string(),
    reason: shown(x.name) ++ " would refer to something else after the renames",
  }

fn entry_failures(
  rn: Renaming,
  l: Loaded,
  modules: Map<Bytes, Int>,
  r: Read,
  imports: Bool,
  before: Entry,
  now: Entry,
  calls: Map<Bytes, Map<Int, MemberTarget>>,
) -> List<Failure> / {abort.raise} = {
  let refs = before.names.references;
  let wrong = if imports {
    range(0, refs.len()).filter(|i: Int|
      now.names.references.at(i).map(|y: Reference| y.refers)
        != Some(mapped(rn, l, modules, refs.get(i).refers))).map(|i: Int| refs.get(i))
  } else {
    let by_site = now.names.references.fold(Map::new(), |acc: Map<Int, Refers>, y: Reference|
      acc.insert(y.site, y.refers));
    refs.filter(|x: Reference|
      !is_made(x.site) && by_site.get(x.site) != Some(mapped(rn, l, modules, x.refers)))
  };
  let was = r.calls.get(before.owner).unwrap_or(Map::new());
  let is = calls.get(now.owner).unwrap_or(Map::new());
  let retargeted = was.fold(0, |n: Int, site: Int, target: MemberTarget| {
    let expected = match target {
      CallsFunction(c) -> CallsFunction(qualified_after(rn, l, ValueSpace, c)),
      other -> other,
    };
    if is.get(site) == Some(expected) { n } else { n + 1 }
  });
  wrong.map(|x: Reference| moved_failure(r, x)).concat(if retargeted == 0 { [] } else {
    [
      {
        path: displayed(r.file.at),
        reason: "a call on a value in `" ++ String::of_bytes_lossy(before.owner)
          ++ "` would call another function after the renames",
      },
    ]
  })
}

fn compared(
  rn: Renaming,
  l: Loaded,
  after: Analysis,
  texts: Map<String, Bytes>,
) -> List<Failure> / {abort.raise} = {
  let modules = modules_after(rn, l, after);
  let calls_after = calls_by_module(after);
  l.reads.fold([], |acc: List<Failure>, r: Read|
    match ((modules.get(r.name), texts.get(absolute(rn.pwd, r.file.at)))) {
      (Some(j), Some(text)) -> {
        let now = entries_of(
          after,
          j,
          moved_name(r.name, rn.modules.get(absolute(rn.pwd, r.file.at))),
          numbered_module(parse(text).node),
        );
        let calls = calls_after.get(j).unwrap_or(Map::new());
        if now.len() != r.entries.len() {
          acc.push({ path: displayed(r.file.at), reason: "would no longer parse as it did" })
        } else {
          range(0, now.len()).fold(acc, |found: List<Failure>, k: Int|
            found.concat(
              entry_failures(rn, l, modules, r, k == 0, r.entries.get(k), now.get(k), calls),
            ))
        }
      },
      _ -> acc,
    })
}

pub type Renamed = { pwd: String, texts: Map<String, Bytes>, gone: Map<String, Bool> }

pub fn key(r: Renamed, label: String, path: String) -> String / {abort.raise} =
  absolute(r.pwd, { label: label, path: path })

fn renamed_kind(r: Renamed, label: String, path: String, was: Kind) -> Kind / {abort.raise} =
  kind_renamed(r, key(r, label, path), was)

/// What the path keyed `at` names once the rename is written, where it named `was`.
fn kind_renamed(r: Renamed, at: String, was: Kind) -> Kind =
  if r.texts.contains(at) { File }
  else if r.gone.contains(at) { Missing }
  else if was == Missing && r.texts.keys().any(|k: String| k.starts_with(at ++ "/")) { Dir }
  else { was }

fn renamed_read(r: Renamed, label: String, path: String) -> Option<Option<Bytes>> / {abort.raise} =
  match r.texts.get(key(r, label, path)) {
    Some(text) -> Some(Some(text)),
    None -> if r.gone.contains(key(r, label, path)) { Some(None) } else { None },
  }

fn renamed_listing(
  r: Renamed,
  label: String,
  dir: String,
  was: Option<List<Listed>>,
) -> Option<List<Listed>> / {abort.raise} = {
  let at = key(r, label, dir);
  let prefix = if at.ends_with("/") { at } else { at ++ "/" };
  let child = |k: String| k.slice(prefix.len(), k.len()).split("/").get(0);
  let came = r.texts.keys().filter(|k: String| k.starts_with(prefix)).map(child);
  let went = r.gone.keys().filter(|k: String|
    k.starts_with(prefix) && !k.slice(prefix.len(), k.len()).contains("/")).map(
    child,
  );
  let kept = was.unwrap_or([]).filter(|l: Listed| !went.contains(l.name));
  let all = came.fold(kept, |listed: List<Listed>, n: String|
    if listed.any(|l: Listed| l.name == n) { listed }
    else { listed.push({ name: n, kind: Missing }) });
  if was == None && came.len() == 0 { None }
  else { Some(all.map(|l: Listed| { ..l, kind: kind_renamed(r, prefix ++ l.name, l.kind) })) }
}

fn over_renamed<a | e>(
  r: Renamed,
  body: () -> a / {fs.read_file[cwd], fs.read_file[abs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], abort.raise | e},
) -> a / {fs.read_file[cwd], fs.read_file[abs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], abort.raise | e} = {
  handle {
    body()
  } with {
    fs.read_file[cwd](p) -> match renamed_read(r, "cwd", p) {
      Some(decided) -> decided,
      None -> fs.read_file[cwd](p),
    },
    fs.read_file[abs](p) -> match renamed_read(r, "abs", p) {
      Some(decided) -> decided,
      None -> fs.read_file[abs](p),
    },
    fs.kind[cwd](p) -> renamed_kind(r, "cwd", p, fs.kind[cwd](p)),
    fs.kind[abs](p) -> renamed_kind(r, "abs", p, fs.kind[abs](p)),
    fs.list_dir[cwd](p) -> renamed_listing(r, "cwd", p, fs.list_dir[cwd](p)),
    fs.list_dir[abs](p) -> renamed_listing(r, "abs", p, fs.list_dir[abs](p)),
  }
}

fn renamed_library(
  path: ResolvedPath,
  texts: Map<Bytes, Source>,
) -> Option<List<library::ShippedFile>> / {fs.resolved_kind[abs], fs.read_file[abs], fs.read[abs], abort.raise} =
  match library::enclosing_checkout(path.absolute) {
    None -> None,
    Some(c) ->
      Some(
        library::shipped_files(c).map(|f: library::ShippedFile|
          if !f.name.ends_with(".ply") { f } else {
            match texts.get(Bytes::of_string(f.name.slice(0, f.name.len() - 4))) {
              Some(t) -> { ..f, name: String::of_bytes_lossy(t.name) ++ ".ply", bytes: t.src },
              None -> f,
            }
          }),
      ),
  }

pub fn verified(
  store: Option<ResolvedPath>,
  rn: Renaming,
  l: Loaded,
  library: Map<Bytes, Source>,
  texts: Map<String, Bytes>,
  renamed: Renamed,
) -> List<Failure> / {shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, Derives, abort.raise, diverges} = {
  let checked = ||
    over_renamed(renamed, || {
      match whole_of(load_program_with_store(store, [l.path], false)) {
        Err(ds) ->
          [{ path: l.root, reason: "would not check after the renames: " ++ errors_text(ds) }],
        Ok(after) -> compared(rn, l, after, texts),
      }
    });
  match renamed_library(l.path, library) {
    Some(files) -> library::with_shipped_files(files, checked),
    None -> checked(),
  }
}
