fn mapped(renaming: Renaming, l: Loaded, refers: Refers) -> Refers / {abort.raise} =
  match refers {
    Local(b) -> Local(b),
    Definition(d) ->
      Definition({
        qualified: qualified_after(renaming, l, d.namespace, d.qualified),
        namespace: d.namespace,
      }),
    Operation(o) ->
      Operation({
        effect: qualified_after(renaming, l, EffectSpace, o.effect),
        name: match key_of(l, o.effect).and_then(|k: DefinitionKey| renaming.operations.get(k)) {
          Some(operations) -> operations.get(o.name).unwrap_or(o.name),
          None -> o.name,
        },
      }),
    ModuleQualifier(name) -> ModuleQualifier(moved_name(name, move_of(renaming, l, name))),
    Unbound -> Unbound,
  }

fn moved_failure(r: Read, x: Reference) -> Failure / {abort.raise} =
  {
    path: displayed(r.file.at) ++ ":" ++ line_at(r.file.text, x.start).to_string(),
    reason: shown(x.name) ++ " would refer to something else after the renames",
  }

fn entry_failures(
  renaming: Renaming,
  l: Loaded,
  r: Read,
  imports: Bool,
  before: Entry,
  now: Entry,
) -> List<Failure> / {abort.raise} = {
  let refs = before.names.references;
  let wrong = if imports {
    range(0, refs.len()).filter(|i: Int|
      now.names.references.at(i).map(|y: Reference| y.target)
        != Some(mapped(renaming, l, refs.get(i).target))).map(|i: Int| refs.get(i))
  } else {
    let by_site = now.names.references.fold(
      Map::new(),
      |accumulator: Map<Int, Refers>, y: Reference| accumulator.insert(y.identifier_id, y.target),
    );
    refs.filter(|x: Reference|
      !is_synthetic_site(x.identifier_id)
        && by_site.get(x.identifier_id) != Some(mapped(renaming, l, x.target)))
  };
  wrong.map(|x: Reference| moved_failure(r, x))
}

pub type Checked = { failures: List<Failure>, derived: Map<DefinitionKey, Bytes> }

fn derived_renames(
  renaming: Renaming,
  r: Read,
  after: List<DeriveOrigin>,
) -> Map<DefinitionKey, Bytes> / {abort.raise} =
  if after.len() != r.derived.len() { Map::new() } else {
    range(0, after.len()).fold(Map::new(), |accumulator: Map<DefinitionKey, Bytes>, k: Int| {
      let old = derived_names(r.derived.get(k));
      let new = derived_names(after.get(k));
      if old.len() != new.len() { accumulator } else {
        range(0, old.len()).fold(accumulator, |into: Map<DefinitionKey, Bytes>, i: Int|
          if old.get(i) == new.get(i) { into } else {
            into.insert({ file: absolute(renaming.pwd, r.file.at), name: old.get(i) }, new.get(i))
          })
      }
    })
  }

fn unbound_failures(r: Read, after: ResolvedModule) -> List<Failure> / {abort.raise} =
  derived_unbound(after.resolution, 0, after.parsed.derived).elements().filter(|name: Bytes|
    !r.derived_unbound.contains(name)).map(|name: Bytes|
    {
      path: displayed(r.file.at),
      reason: "a definition a `derive` writes would refer to " ++ shown(name)
        ++ ", which nothing declares after the renames",
    })

fn retargeted_calls(
  renaming: Renaming,
  l: Loaded,
  r: Read,
  now: List<Entry>,
  after: Map<Bytes, Map<Int, MemberTarget>>,
) -> List<Failure> / {abort.raise} = {
  let owners = range(0, now.len()).fold(Map::new(), |m: Map<Bytes, Bytes>, k: Int|
    m.insert(r.entries.get(k).owner, now.get(k).owner));
  r.calls.fold([], |found: List<Failure>, owner: Bytes, sites: Map<Int, MemberTarget>| {
    let later = after.get(owners.get(owner).unwrap_or(owner)).unwrap_or(Map::new());
    let moved = sites.fold(false, |any: Bool, site: Int, target: MemberTarget|
      any
        || (match target {
          CallsFunction(c) ->
            later.get(site) != Some(CallsFunction(qualified_after(renaming, l, ValueSpace, c))),
          _ -> false,
        }));
    if !moved { found } else {
      found.push({
        path: displayed(r.file.at),
        reason: "a call on a value in `" ++ String::of_bytes_lossy(owner)
          ++ "` could call another function after the renames",
      })
    }
  })
}

fn compared(
  renaming: Renaming,
  l: Loaded,
  r: Read,
  after: ResolvedModule,
  calls: Map<Bytes, Map<Int, MemberTarget>>,
) -> List<Failure> / {abort.raise} = {
  let now = entries_of(
    moved_name(r.name, renaming.modules.get(absolute(renaming.pwd, r.file.at))),
    after,
  );
  let unbound = unbound_failures(r, after);
  if now.len() != r.entries.len() {
    unbound.push({ path: displayed(r.file.at), reason: "would no longer parse as it did" })
  } else {
    range(0, now.len()).fold(unbound, |found: List<Failure>, k: Int|
      found.concat(entry_failures(renaming, l, r, k == 0, r.entries.get(k), now.get(k)))).concat(
      retargeted_calls(renaming, l, r, now, calls),
    )
  }
}

fn read_after(
  renaming: Renaming,
  l: Loaded,
  texts: Map<String, Bytes>,
  r: Read,
) -> Checked / {memo.read, abort.raise} = {
  let file = absolute(renaming.pwd, r.file.at);
  let key = own_key(moved_name(r.name, renaming.modules.get(file)));
  match resolved_module(key, texts.get(file).unwrap_or(r.file.text)) {
    Err(diagnostics) ->
      {
        failures: diagnostic_failures(
          diagnostics,
          |_: Int|
            Some({ path: displayed(r.file.at), text: texts.get(file).unwrap_or(r.file.text) }),
          displayed(r.file.at),
        ),
        derived: Map::new(),
      },
    Ok(after) ->
      {
        failures: compared(renaming, l, r, after, calls_of(view::checked_owners(key))),
        derived: derived_renames(renaming, r, after.parsed.derived),
      },
  }
}

fn checked_after(
  renaming: Renaming,
  l: Loaded,
  texts: Map<String, Bytes>,
) -> Checked / {memo.read, abort.raise} = {
  let renamed = l.reads.fold({ failures: [], derived: Map::new() }, |checked: Checked, r: Read| {
    let read = read_after(renaming, l, texts, r);
    {
      failures: checked.failures.concat(read.failures),
      derived: read.derived.fold(
        checked.derived,
        |m: Map<DefinitionKey, Bytes>, key: DefinitionKey, new: Bytes| m.insert(key, new),
      ),
    }
  });
  l.unrenamed.fold(renamed, |checked: Checked, r: Read|
    { ..checked, failures: checked.failures.concat(read_after(renaming, l, texts, r).failures) })
}

pub type Renamed = { pwd: String, texts: Map<String, Bytes>, gone: Set<String> }

pub fn key(r: Renamed, label: PathLabel, path: String) -> String =
  absolute(r.pwd, { label: label, path: path })

fn renamed_kind(r: Renamed, label: PathLabel, path: String, was: Kind) -> Kind =
  kind_renamed(r, key(r, label, path), was)

fn kind_renamed(r: Renamed, at: String, was: Kind) -> Kind =
  if r.texts.contains(at) { File }
  else if r.gone.contains(at) { Missing }
  else if was == Missing && r.texts.keys().any(|k: String| k.starts_with(at ++ "/")) { Dir }
  else { was }

fn renamed_read(r: Renamed, label: PathLabel, path: String) -> Option<Option<Bytes>> =
  match r.texts.get(key(r, label, path)) {
    Some(text) -> Some(Some(text)),
    None -> if r.gone.contains(key(r, label, path)) { Some(None) } else { None },
  }

fn renamed_listing(
  r: Renamed,
  label: PathLabel,
  dir: String,
  was: Option<List<Listed>>,
) -> Option<List<Listed>> / {abort.raise} = {
  let at = key(r, label, dir);
  let prefix = if at.ends_with("/") { at } else { at ++ "/" };
  let child = |k: String| k.slice(prefix.len(), k.len()).split("/").get(0);
  let came = r.texts.keys().filter(|k: String| k.starts_with(prefix)).map(child);
  let went = r.gone.elements().filter(|k: String|
    k.starts_with(prefix) && !k.slice(prefix.len(), k.len()).contains("/")).map(
    child,
  );
  let surviving_entries = was.unwrap_or([]).filter(|l: Listed| !went.contains(l.name));
  let all = came.fold(surviving_entries, |listed: List<Listed>, n: String|
    if listed.any(|l: Listed| l.name == n) { listed }
    else { listed.push({ name: n, kind: Missing }) });
  if was == None && came.len() == 0 { None }
  else { Some(all.map(|l: Listed| { ..l, kind: kind_renamed(r, prefix ++ l.name, l.kind) })) }
}

fn over_renamed<a | e>(
  r: Renamed,
  body: () -> a / {ProjectFiles, abort.raise | e},
) -> a / {ProjectFiles, abort.raise | e} = {
  handle {
    body()
  } with {
    fs.read_file[cwd](p) -> match renamed_read(r, WorkingDirectory, p) {
      Some(decided) -> decided,
      None -> fs.read_file[cwd](p),
    },
    fs.read_file[abs](p) -> match renamed_read(r, Absolute, p) {
      Some(decided) -> decided,
      None -> fs.read_file[abs](p),
    },
    fs.kind[cwd](p) -> renamed_kind(r, WorkingDirectory, p, fs.kind[cwd](p)),
    fs.kind[abs](p) -> renamed_kind(r, Absolute, p, fs.kind[abs](p)),
    fs.list_dir[cwd](p) -> renamed_listing(r, WorkingDirectory, p, fs.list_dir[cwd](p)),
    fs.list_dir[abs](p) -> renamed_listing(r, Absolute, p, fs.list_dir[abs](p)),
  }
}

fn renamed_library(
  path: ResolvedPath,
  texts: Map<Bytes, Source>,
) -> Option<List<ShippedFile>> / {fs.resolved_kind[abs], fs.read_file[abs], fs.read[abs], abort.raise} =
  match library::enclosing_checkout(path.absolute) {
    None -> None,
    Some(c) ->
      Some(
        shipped_files(c).map(|f: ShippedFile|
          if !f.name.ends_with(".ply") { f } else {
            match texts.get(Bytes::of_string(f.name.slice(0, f.name.len() - 4))) {
              Some(t) ->
                { ..f, name: String::of_bytes_lossy(t.name) ++ ".ply", bytes: t.source_text },
              None -> f,
            }
          }),
      ),
  }

fn diagnostic_failures(
  diagnostics: List<Diagnostic>,
  place_of: (Int) -> Option<SourceText>,
  unplaced: String,
) -> List<Failure> / {abort.raise} =
  diagnostics.filter(|d: Diagnostic| d.severity == Error).map(|d: Diagnostic| {
    let place = d.labels.find(|x: Label| x.primary).and_then(source_span).and_then(
      |x: { module: Int, start: Int, end: Int }|
        place_of(x.module).map(|p: SourceText|
          p.path ++ ":" ++ line_at(p.text, x.start).to_string()),
    );
    {
      path: place.unwrap_or(unplaced),
      reason: errors_text([d])
        ++ String::join(d.notes_text.map(|note: Bytes| "; " ++ String::of_bytes_lossy(note)), ""),
    }
  })

pub fn verified(
  renaming: Renaming,
  l: Loaded,
  library: Map<Bytes, Source>,
  texts: Map<String, Bytes>,
  renamed: Renamed,
) -> Checked / {project_store::Databases, time.elapsed_ms, shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], ProjectFiles, fs.resolved_kind[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], Derives, abort.raise, diverges} = {
  let files = renamed_library(l.path, library);
  let checked = ||
    over_renamed(renamed, || {
      let project = load_resolved([l.path]);
      if project.diagnostics.len() > 0 {
        {
          failures: diagnostic_failures(project.diagnostics, |_: Int| None, l.root),
          derived: Map::new(),
        }
      } else {
        let compared = progress::silently(||
          in_program_store({ project: project, store: Some(l.path) }, |_: LoadInputs|
            checked_after(renaming, l, texts))).value;
        match needs_of(renaming.renames) {
          NeedsNames -> compared,
          NeedsTypes -> if compared.failures.len() > 0 { compared } else {
            match progress::silently(||
                session_over(
                  [l.path],
                  project,
                  time.elapsed_ms(),
                  false,
                  |_: Modules, _: ProgramSummary| (),
                )) {
              Err(refusal) ->
                {
                  ..compared,
                  failures: diagnostic_failures(
                    refusal.diagnostics,
                    |module: Int| refusal.places.at(module),
                    l.root,
                  ),
                },
              Ok(_) -> compared,
            }
          },
        }
      }
    });
  match files { Some(listed) -> library::with_shipped_files(listed, checked), None -> checked() }
}
