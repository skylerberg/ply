import std.list (positions)

fn modules_after(
  rn: Renaming,
  l: Loaded,
  after: ResolvedProgram,
) -> Map<Bytes, Int> / {abort.raise} = {
  let index = positions(after.modules.map(|m: ParsedModule| m.name));
  range(0, l.names.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int| {
    let old = l.names.get(i);
    match index.get(moved_name(old, move_of(rn, l, i))) {
      Some(j) -> acc.insert(old, j),
      None -> acc,
    }
  })
}

fn mapped(
  rn: Renaming,
  l: Loaded,
  modules: Map<Bytes, Int>,
  refers: Refers,
) -> Refers / {abort.raise} =
  match refers {
    Local(b) -> Local(b),
    Definition(d) ->
      Definition({
        qualified: qualified_after(rn, l, d.namespace, d.qualified),
        namespace: d.namespace,
      }),
    Operation(o) ->
      Operation({
        effect: qualified_after(rn, l, EffectSpace, o.effect),
        name: match key_of(l, o.effect).and_then(|k: DefinitionKey| rn.operations.get(k)) {
          Some(ops) -> ops.get(o.name).unwrap_or(o.name),
          None -> o.name,
        },
      }),
    ModuleQualifier(i) -> match l.names.at(i) {
      Some(name) -> match modules.get(name) { Some(j) -> ModuleQualifier(j), None -> Unbound },
      None -> Unbound,
    },
    Unbound -> Unbound,
  }

fn moved_failure(r: Read, x: Reference) -> Failure / {abort.raise} =
  {
    path: displayed(r.file.at) ++ ":" ++ line_at(r.file.text, x.start).to_string(),
    reason: shown(x.name) ++ " would refer to something else after the renames",
  }

fn entry_failures(
  rn: Renaming,
  l: Loaded,
  modules: Map<Bytes, Int>,
  r: Read,
  imports: Bool,
  before: Entry,
  now: Entry,
) -> List<Failure> / {abort.raise} = {
  let refs = before.names.references;
  let wrong = if imports {
    range(0, refs.len()).filter(|i: Int|
      now.names.references.at(i).map(|y: Reference| y.target)
        != Some(mapped(rn, l, modules, refs.get(i).target))).map(|i: Int| refs.get(i))
  } else {
    let by_site = now.names.references.fold(Map::new(), |acc: Map<Int, Refers>, y: Reference|
      acc.insert(y.identifier_id, y.target));
    refs.filter(|x: Reference|
      !is_synthetic_site(x.identifier_id)
        && by_site.get(x.identifier_id) != Some(mapped(rn, l, modules, x.target)))
  };
  wrong.map(|x: Reference| moved_failure(r, x))
}

pub type Checked = { failures: List<Failure>, derived: Map<DefinitionKey, Bytes> }

fn derived_renames(
  rn: Renaming,
  r: Read,
  after: List<DeriveOrigin>,
) -> Map<DefinitionKey, Bytes> / {abort.raise} =
  if after.len() != r.derived.len() { Map::new() } else {
    range(0, after.len()).fold(Map::new(), |acc: Map<DefinitionKey, Bytes>, k: Int| {
      let old = derived_names(r.derived.get(k));
      let new = derived_names(after.get(k));
      if old.len() != new.len() { acc } else {
        range(0, old.len()).fold(acc, |into: Map<DefinitionKey, Bytes>, i: Int|
          if old.get(i) == new.get(i) { into }
          else { into.insert({ file: absolute(rn.pwd, r.file.at), name: old.get(i) }, new.get(i)) })
      }
    })
  }

fn unbound_failures(r: Read, after: ResolvedProgram, j: Int) -> List<Failure> / {abort.raise} =
  derived_unbound(after.resolution, j, after.modules.get(j).derived).keys().filter(
    |name: Bytes| !r.derived_unbound.contains(name),
  ).map(|name: Bytes|
    {
      path: displayed(r.file.at),
      reason: "a definition a `derive` writes would refer to " ++ shown(name)
        ++ ", which nothing declares after the renames",
    })

fn compared(
  rn: Renaming,
  l: Loaded,
  after: ResolvedProgram,
  texts: Map<String, Bytes>,
) -> List<Failure> / {abort.raise} = {
  let modules = modules_after(rn, l, after);
  l.reads.concat(l.unrenamed).fold([], |failures: List<Failure>, r: Read|
    match modules.get(r.name) {
      None -> failures,
      Some(j) -> {
        let acc = failures.concat(unbound_failures(r, after, j));
        let text = texts.get(absolute(rn.pwd, r.file.at)).unwrap_or(r.file.text);
        let now = entries_of(
          after.resolution,
          j,
          moved_name(r.name, rn.modules.get(absolute(rn.pwd, r.file.at))),
          numbered_module(parse(text).node),
        );
        if now.len() != r.entries.len() {
          acc.push({ path: displayed(r.file.at), reason: "would no longer parse as it did" })
        } else {
          range(0, now.len()).fold(acc, |found: List<Failure>, k: Int|
            found.concat(entry_failures(rn, l, modules, r, k == 0, r.entries.get(k), now.get(k))))
        }
      },
    })
}

pub type Renamed = { pwd: String, texts: Map<String, Bytes>, gone: Map<String, Bool> }

pub fn key(r: Renamed, label: String, path: String) -> String =
  absolute(r.pwd, { label: label, path: path })

fn renamed_kind(r: Renamed, label: String, path: String, was: Kind) -> Kind =
  kind_renamed(r, key(r, label, path), was)

fn kind_renamed(r: Renamed, at: String, was: Kind) -> Kind =
  if r.texts.contains(at) { File }
  else if r.gone.contains(at) { Missing }
  else if was == Missing && r.texts.keys().any(|k: String| k.starts_with(at ++ "/")) { Dir }
  else { was }

fn renamed_read(r: Renamed, label: String, path: String) -> Option<Option<Bytes>> =
  match r.texts.get(key(r, label, path)) {
    Some(text) -> Some(Some(text)),
    None -> if r.gone.contains(key(r, label, path)) { Some(None) } else { None },
  }

fn renamed_listing(
  r: Renamed,
  label: String,
  dir: String,
  was: Option<List<Listed>>,
) -> Option<List<Listed>> / {abort.raise} = {
  let at = key(r, label, dir);
  let prefix = if at.ends_with("/") { at } else { at ++ "/" };
  let child = |k: String| k.slice(prefix.len(), k.len()).split("/").get(0);
  let came = r.texts.keys().filter(|k: String| k.starts_with(prefix)).map(child);
  let went = r.gone.keys().filter(|k: String|
    k.starts_with(prefix) && !k.slice(prefix.len(), k.len()).contains("/")).map(
    child,
  );
  let kept = was.unwrap_or([]).filter(|l: Listed| !went.contains(l.name));
  let all = came.fold(kept, |listed: List<Listed>, n: String|
    if listed.any(|l: Listed| l.name == n) { listed }
    else { listed.push({ name: n, kind: Missing }) });
  if was == None && came.len() == 0 { None }
  else { Some(all.map(|l: Listed| { ..l, kind: kind_renamed(r, prefix ++ l.name, l.kind) })) }
}

fn over_renamed<a | e>(
  r: Renamed,
  body: () -> a / {fs.read_file[cwd], fs.read_file[abs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], abort.raise | e},
) -> a / {fs.read_file[cwd], fs.read_file[abs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], abort.raise | e} = {
  handle {
    body()
  } with {
    fs.read_file[cwd](p) -> match renamed_read(r, "cwd", p) {
      Some(decided) -> decided,
      None -> fs.read_file[cwd](p),
    },
    fs.read_file[abs](p) -> match renamed_read(r, "abs", p) {
      Some(decided) -> decided,
      None -> fs.read_file[abs](p),
    },
    fs.kind[cwd](p) -> renamed_kind(r, "cwd", p, fs.kind[cwd](p)),
    fs.kind[abs](p) -> renamed_kind(r, "abs", p, fs.kind[abs](p)),
    fs.list_dir[cwd](p) -> renamed_listing(r, "cwd", p, fs.list_dir[cwd](p)),
    fs.list_dir[abs](p) -> renamed_listing(r, "abs", p, fs.list_dir[abs](p)),
  }
}

fn renamed_library(
  path: ResolvedPath,
  texts: Map<Bytes, Source>,
) -> Option<List<ShippedFile>> / {fs.resolved_kind[abs], fs.read_file[abs], fs.read[abs], abort.raise} =
  match library::enclosing_checkout(path.absolute) {
    None -> None,
    Some(c) ->
      Some(
        shipped_files(c).map(|f: ShippedFile|
          if !f.name.ends_with(".ply") { f } else {
            match texts.get(Bytes::of_string(f.name.slice(0, f.name.len() - 4))) {
              Some(t) -> { ..f, name: String::of_bytes_lossy(t.name) ++ ".ply", bytes: t.src },
              None -> f,
            }
          }),
      ),
  }

fn by_new_name(
  rn: Renaming,
  l: Loaded,
) -> Map<Bytes, List<{ module: Int, old: Bytes }>> / {abort.raise} =
  range(0, l.declarations.len()).fold(
    Map::new(),
    |acc: Map<Bytes, List<{ module: Int, old: Bytes }>>, j: Int|
      declarations_in(l.declarations.get(j), ValueSpace).fold(
        acc,
        |into: Map<Bytes, List<{ module: Int, old: Bytes }>>, d: Declaration| {
          let new = match l.module_files.at(j) {
            Some(Some(file)) ->
              rn.definitions.values.get({ file: file, name: d.name }).unwrap_or(d.name),
            _ -> d.name,
          };
          into.insert(new, into.get(new).unwrap_or([]).push({ module: j, old: d.name }))
        },
      ),
  )

pub fn retargeted_calls(rn: Renaming, loads: List<Loaded>) -> List<Failure> / {abort.raise} =
  loads.fold([], |acc: List<Failure>, l: Loaded| {
    let named = by_new_name(rn, l);
    let captured = |seen: Map<Int, Bool>, target: MemberTarget|
      match target {
        CallsFunction(c) -> {
          let old = name_in_module(module_of_name(c), c);
          let new = key_of(l, c).and_then(|k: DefinitionKey|
            rn.definitions.values.get(k)).unwrap_or(
            old,
          );
          named.get(new).unwrap_or([]).any(|d: { module: Int, old: Bytes }|
            d.old != old && seen.contains(d.module))
        },
        _ -> false,
      };
    l.reads.concat(l.unrenamed).fold(acc, |found: List<Failure>, r: Read| {
      let seen = l.visible_modules.get(r.index).fold(Map::new(), |m: Map<Int, Bool>, j: Int|
        m.insert(j, true));
      r.calls.fold(found, |f: List<Failure>, owner: Bytes, sites: Map<Int, MemberTarget>|
        if sites.values().any(|t: MemberTarget| captured(seen, t)) {
          f.push({
            path: displayed(r.file.at),
            reason: "a call on a value in `" ++ String::of_bytes_lossy(owner)
              ++ "` could call another function after the renames",
          })
        } else { f })
    })
  })

fn unresolved_failures(rn: Renaming, l: Loaded, u: Unresolved) -> List<Failure> / {abort.raise} = {
  let paths = l.reads.concat(l.unrenamed).fold(Map::new(), |acc: Map<Bytes, String>, r: Read| {
    let move = rn.modules.get(absolute(rn.pwd, r.file.at));
    acc.insert(
      moved_name(r.name, move),
      displayed(match move { Some(m) -> m.to, None -> r.file.at }),
    )
  });
  u.diagnostics.filter(|d: Diagnostic| d.severity == b"error").map(|d: Diagnostic| {
    let place = d.labels.find(|x: Label| x.primary).and_then(|x: Label|
      u.modules.at(x.module).map(|m: Source|
        paths.get(m.name).unwrap_or(String::of_bytes_lossy(m.name)) ++ ":"
          ++ line_at(m.src, x.start).to_string()));
    {
      path: place.unwrap_or(l.root),
      reason: errors_text([d])
        ++ String::join(d.notes_text.map(|note: Bytes| "; " ++ String::of_bytes_lossy(note)), ""),
    }
  })
}

fn renamed_shipping(
  l: Loaded,
  library: Map<Bytes, Source>,
  files: Option<List<ShippedFile>>,
) -> ShippedInputs / {abort.raise} =
  {
    sources: match files {
      None -> l.shipping.sources,
      Some(listed) ->
        listed.filter(|f: ShippedFile| f.name.ends_with(".ply")).map(|f: ShippedFile|
          { name: Bytes::of_string(f.name.slice(0, f.name.len() - 4)), src: f.bytes }),
    },
    unread: [],
    data: l.shipping.data,
    asked: l.shipping.asked.map(|name: Bytes|
      match library.get(name) { Some(s) -> s.name, None -> name }),
    dependencies: [],
  }

pub fn verified(
  rn: Renaming,
  l: Loaded,
  library: Map<Bytes, Source>,
  texts: Map<String, Bytes>,
  renamed: Renamed,
  parses: ParsedSources,
) -> { checked: Checked, parses: ParsedSources } / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.read[abs], Derives, abort.raise, diverges} = {
  let files = renamed_library(l.path, library);
  let checked = ||
    over_renamed(renamed, || {
      let after = renamed_resolution([l.path], renamed_shipping(l, library, files), parses);
      {
        checked: {
          failures: match after.resolved {
            Err(u) -> unresolved_failures(rn, l, u),
            Ok(program) -> compared(rn, l, program, texts),
          },
          derived: l.reads.fold(Map::new(), |acc: Map<DefinitionKey, Bytes>, r: Read|
            match after.parses.get(
                moved_name(r.name, rn.modules.get(absolute(rn.pwd, r.file.at))),
              ) {
              Some(p) ->
                derived_renames(rn, r, p.module.derived).fold(
                  acc,
                  |m: Map<DefinitionKey, Bytes>, key: DefinitionKey, new: Bytes| m.insert(key, new),
                ),
              None -> acc,
            }),
        },
        parses: after.parses,
      }
    });
  match files { Some(listed) -> library::with_shipped_files(listed, checked), None -> checked() }
}
