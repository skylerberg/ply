pub type Library = { root: RootedPath, name: String }

pub fn module_path(file: RootedPath, package: RootedPath) -> String / {abort.raise} =
  file.path.slice(if package.path == "" { 0 } else { package.path.len() + 1 }, file.path.len() - 4)

pub fn root_relative(path: String, at: RootedPath) -> String / {abort.raise} =
  if at.label == "abs" && path.starts_with("/") { path.slice(1, path.len()) } else { path }

pub fn package_of(
  file: RootedPath,
  libraries: List<Library>,
) -> Option<RootedPath> / {fs.kind[cwd], fs.kind[abs]} = {
  let parts = file.path.split("/");
  match range(0, parts.len()).map(|k: Int| parts.len() - 1 - k).map(|k: Int|
      { label: file.label, path: String::join(parts.take(k), "/") }).find(|dir: RootedPath|
      kind(child(dir, "ply.pkg")) == File) {
    Some(package) -> Some(package),
    None ->
      libraries.find(|l: Library|
        l.root.label == file.label && file.path.starts_with(l.root.path ++ "/")).map(
        |l: Library| l.root,
      ),
  }
}

pub fn libraries_of(
  given: List<ResolvedPath>,
) -> List<Library> / {fs.resolved_kind[abs], fs.read_file[abs], abort.raise} =
  given.fold([], |accumulator: List<Library>, r: ResolvedPath|
    match library::part_of(r.absolute) {
      Some(part) -> if normalize(r.absolute) == part.dir {
        accumulator.push({ root: rooted(r), name: part.prefix })
      } else { accumulator },
      None -> accumulator,
    })

pub type Entry = { owner: Bytes, names: Written }

pub type Record = | PlainRecord(List<Bytes>) | NewRecordType(Bytes)

pub fn plain_record(fields: List<Bytes>) -> Record = PlainRecord(fields.sort())

pub type DeclaredRecord = { name: Bytes, record: Record, fields: List<Bytes> }

pub type Read = {
  file: sources::File,
  index: Int,
  name: Bytes,
  entries: List<Entry>,
  calls: Map<Bytes, Map<Int, MemberTarget>>,
  imports: List<{ declaration: ImportDeclaration, target: Int }>,
  externs: Set<Bytes>,
  effects: List<{ name: Bytes, operations: List<Bytes> }>,
  sums: List<{ name: Bytes, variants: List<Bytes> }>,
  records: List<DeclaredRecord>,
  typed_records: Map<Bytes, Map<Int, Record>>,
  derived: List<DeriveOrigin>,
  derived_unbound: Set<Bytes>,
}

pub fn derived_names(origin: DeriveOrigin) -> List<Bytes> / {abort.raise} =
  origin.written.fold([], |accumulator: List<Bytes>, text: Bytes|
    parse(text).node.items.fold(accumulator, |names: List<Bytes>, item: Item|
      match item { FunctionItem(d) -> names.push(d.name.name), _ -> names }))

pub fn derived_unbound(
  resolution: Resolution,
  index: Int,
  origins: List<DeriveOrigin>,
) -> Set<Bytes> / {abort.raise} =
  origins.fold(Set::empty(), |accumulator: Set<Bytes>, origin: DeriveOrigin|
    origin.written.fold(accumulator, |found: Set<Bytes>, text: Bytes|
      with_no_other_modules(|| written(resolution, index, numbered_module(parse(text).node))).fold(
        found,
        |into: Set<Bytes>, w: Written|
          w.references.fold(into, |names: Set<Bytes>, x: Reference|
            if x.target == Unbound { names.insert(x.name) } else { names }),
      )))

pub type Loaded = {
  path: ResolvedPath,
  root: String,
  files: List<RootedPath>,
  names: List<Bytes>,
  indices: Map<Bytes, Int>,
  module_files: List<Option<String>>,
  declarations: List<Declarations>,
  scopes: List<Scope>,
  visible_modules: List<List<Int>>,
  shipping: ShippedInputs,
  reads: List<Read>,
  unrenamed: List<Read>,
}

pub type DefinitionKey = { file: String, name: Bytes }

pub fn key_of(l: Loaded, qualified: Bytes) -> Option<DefinitionKey> / {abort.raise} = {
  let module = module_of_name(qualified);
  match l.indices.get(module).and_then(|i: Int| l.module_files.at(i)) {
    Some(Some(file)) -> Some({ file: file, name: name_in_module(module, qualified) }),
    _ -> None,
  }
}

fn file_of(pwd: String, files: Map<String, String>, at: RootedPath) -> Option<String> =
  if at.label == "shipped" { files.get(at.path) } else { Some(absolute(pwd, at)) }

fn shipped_files(
  path: ResolvedPath,
) -> Map<String, String> / {fs.resolved_kind[abs], fs.read_file[abs], fs.read[abs], abort.raise} =
  match library::enclosing_checkout(path.absolute) {
    Some(c) -> module_files(c),
    None -> Map::new(),
  }

fn calls_of(owners: List<CheckedOwner>) -> Map<Bytes, Map<Int, MemberTarget>> =
  owners.fold(Map::new(), |found: Map<Bytes, Map<Int, MemberTarget>>, o: CheckedOwner|
    o.facts.members.fold(found, |into: Map<Bytes, Map<Int, MemberTarget>>, s: MemberSite|
      into.insert(s.owner, into.get(s.owner).unwrap_or(Map::new()).insert(s.site, s.callee))))

fn record_in(types: TypeTable, key: Bytes) -> Option<Record> =
  match types.get(key) {
    Some(NodeRecord(fields)) -> Some(plain_record(fields.map(|f: NodeField| f.name))),
    Some(NodeNominal(n)) -> Some(NewRecordType(n.name)),
    _ -> None,
  }

fn with_record(
  sites: Map<Int, Record>,
  types: TypeTable,
  site: Int,
  key: Bytes,
) -> Map<Int, Record> =
  match record_in(types, key) { Some(r) -> sites.insert(site, r), None -> sites }

fn pattern_records(
  sites: Map<Int, Record>,
  types: TypeTable,
  pattern: TypedPattern<Bytes>,
) -> Map<Int, Record> / {abort.raise} = {
  let each = |into: Map<Int, Record>, p: TypedPattern<Bytes>| pattern_records(into, types, p);
  match pattern {
    TypedRecordPattern(r) ->
      r.fields.fold(
        with_record(sites, types, r.span.site, r.ty),
        |into: Map<Int, Record>, f: TypedFieldPattern<Bytes>| each(into, f.pattern),
      ),
    TypedCase(c) -> c.args.fold(sites, each),
    TypedListPattern(l) -> {
      let items = l.items.fold(sites, each);
      match l.rest { Some(rest) -> each(items, rest), None -> items }
    },
    TypedOr(alternatives) -> alternatives.fold(sites, each),
    _ -> sites,
  }
}

fn body_records(
  sites: Map<Int, Record>,
  types: TypeTable,
  body: TypedBody<Bytes>,
) -> Map<Int, Record> / {abort.raise} =
  typed_expression_nodes(body.body).fold(
    sites,
    |accumulator: Map<Int, Record>, e: TypedExpression<Bytes>|
      match e.node {
        TypedFieldRead(f) -> with_record(accumulator, types, e.span.site, f.base.ty),
        TypedRecord(_) -> with_record(accumulator, types, e.span.site, e.ty),
        TypedUpdate(_) -> with_record(accumulator, types, e.span.site, e.ty),
        TypedCall(c) -> match c.callee.node {
          TypedFieldRead(f) -> with_record(accumulator, types, e.span.site, f.base.ty),
          _ -> accumulator,
        },
        TypedMatch(m) ->
          m.arms.fold(accumulator, |into: Map<Int, Record>, arm: TypedArm<Bytes>|
            pattern_records(into, types, arm.pattern)),
        TypedBlock(b) ->
          b.statements.fold(
            accumulator,
            |into: Map<Int, Record>, statement: TypedStatement<Bytes>|
              match statement {
                TypedLet(l) -> pattern_records(into, types, l.pattern),
                TypedLetElse(l) -> pattern_records(into, types, l.pattern),
                _ -> into,
              },
          ),
        _ -> accumulator,
      },
  )

fn records_of(owners: List<CheckedOwner>) -> Map<Bytes, Map<Int, Record>> / {abort.raise} = {
  let with_body = |found: Map<Bytes, Map<Int, Record>>, types: TypeTable, owner: Bytes, body: TypedBody<Bytes>|
    found.insert(owner, body_records(found.get(owner).unwrap_or(Map::new()), types, body));
  owners.fold(Map::new(), |found: Map<Bytes, Map<Int, Record>>, o: CheckedOwner|
    o.cached.fold(
      o.facts.bodies.fold(found, |into: Map<Bytes, Map<Int, Record>>, b: TypedBody<Bytes>|
        with_body(into, o.facts.types, b.owner, b)),
      |into: Map<Bytes, Map<Int, Record>>, k: CachedFacts|
        match k.facts {
          Some(recorded) -> {
            let f = decode_facts(recorded, 0, k.name);
            f.bodies.fold(into, |all: Map<Bytes, Map<Int, Record>>, b: TypedBody<Bytes>|
              with_body(all, f.types, k.name, b))
          },
          None -> into,
        },
    ))
}

fn variant_records(name: Bytes, variants: List<VariantDefinition>) -> List<DeclaredRecord> =
  variants.fold([], |found: List<DeclaredRecord>, v: VariantDefinition|
    v.fields.fold(found, |records: List<DeclaredRecord>, payload: TypeExpression|
      match payload {
        RecordTypeExpression(r) -> {
          let fields = r.fields.map(|f: { name: Identifier, ty: TypeExpression }| f.name.name);
          records.push({ name: name, record: plain_record(fields), fields: fields })
        },
        _ -> records,
      }))

fn declared_records(module: Bytes, tree: Module) -> List<DeclaredRecord> =
  tree.items.fold([], |accumulator: List<DeclaredRecord>, item: Item|
    match item {
      TypeItem(t) -> match t.body {
        AliasBody(RecordTypeExpression(r)) -> {
          let fields = r.fields.map(|f: { name: Identifier, ty: TypeExpression }| f.name.name);
          accumulator.push({ name: t.name.name, record: plain_record(fields), fields: fields })
        },
        NominalBody(RecordTypeExpression(r)) ->
          accumulator.push({
            name: t.name.name,
            record: NewRecordType(qualify(module, t.name.name)),
            fields: r.fields.map(|f: { name: Identifier, ty: TypeExpression }| f.name.name),
          }),
        SumBody(variants) -> accumulator.concat(variant_records(t.name.name, variants)),
        _ -> accumulator,
      },
      _ -> accumulator,
    })

pub fn entries_of(
  r: Resolution,
  index: Int,
  name: Bytes,
  tree: Module,
) -> List<Entry> / {abort.raise} = {
  let names = with_no_other_modules(|| written(r, index, tree));
  range(0, names.len()).map(|k: Int|
    {
      owner: if k == 0 { b"" } else { item_owner(name, tree.items.get(k - 1)) },
      names: names.get(k),
    })
}

fn read_of(
  resolved: ResolvedProgram,
  calls: Map<Bytes, Map<Bytes, Map<Int, MemberTarget>>>,
  owner_records: Map<Bytes, Map<Int, Record>>,
  file: sources::File,
) -> Option<Read> / {abort.raise} = {
  let name = Bytes::of_string(file.module);
  match range(0, resolved.modules.len()).find(|i: Int| resolved.modules.get(i).name == name) {
    None -> None,
    Some(index) -> {
      let parsed = resolved.modules.get(index);
      let tree = numbered_module(parse(file.text).node);
      let targets = resolved.resolution.imports.get(index);
      let entries = entries_of(resolved.resolution, index, name, tree);
      Some({
        file: file,
        index: index,
        name: name,
        entries: entries,
        calls: calls.get(name).unwrap_or(Map::new()),
        imports: range(0, tree.imports.len()).fold(
          [],
          |accumulator: List<{ declaration: ImportDeclaration, target: Int }>, k: Int|
            match targets.at(k) {
              Some(t) -> accumulator.push({ declaration: tree.imports.get(k), target: t }),
              None -> accumulator,
            },
        ),
        externs: tree.items.fold(Set::empty(), |accumulator: Set<Bytes>, item: Item|
          match item { ExternItem(x) -> accumulator.insert(x.name.name), _ -> accumulator }),
        effects: tree.items.fold(
          [],
          |accumulator: List<{ name: Bytes, operations: List<Bytes> }>, item: Item|
            match item {
              EffectItem(e) ->
                accumulator.push({
                  name: e.name.name,
                  operations: e.operations.map(|operation: OperationDefinition|
                    operation.name.name),
                }),
              _ -> accumulator,
            },
        ),
        sums: tree.items.fold(
          [],
          |accumulator: List<{ name: Bytes, variants: List<Bytes> }>, item: Item|
            match item {
              TypeItem(t) -> match t.body {
                SumBody(variants) ->
                  accumulator.push({
                    name: t.name.name,
                    variants: variants.map(|v: VariantDefinition| v.name.name),
                  }),
                _ -> accumulator,
              },
              _ -> accumulator,
            },
        ),
        records: declared_records(name, tree),
        derived: parsed.derived,
        derived_unbound: derived_unbound(resolved.resolution, index, parsed.derived),
        typed_records: entries.fold(
          Map::new(),
          |accumulator: Map<Bytes, Map<Int, Record>>, e: Entry|
            match owner_records.get(e.owner) {
              Some(sites) -> accumulator.insert(e.owner, sites),
              None -> accumulator,
            },
        ),
      })
    },
  }
}

fn under(at: RootedPath, root: RootedPath) -> Bool =
  at.label == root.label
    && (root.path == "" || root.path == "." || at.path == root.path
    || at.path.starts_with(root.path ++ "/"))

type ProgramLoad = {
  files: List<sources::File>,
  read_at: List<RootedPath>,
  shipping: ShippedInputs,
  resolved: Result<ResolvedProgram, List<Diagnostic>>,
  parses: ParsedSources,
  calls: Map<Bytes, Map<Bytes, Map<Int, MemberTarget>>>,
  owner_records: Map<Bytes, Map<Int, Record>>,
}

type RenameReading = {
  included: Set<Bytes>,
  calls: Map<Bytes, Map<Bytes, Map<Int, MemberTarget>>>,
  owner_records: Map<Bytes, Map<Int, Record>>,
}

fn rename_reading(
  project: sources::Project,
  modules: Modules,
  mentions: (sources::File) -> Bool / {abort.raise},
) -> RenameReading / {memo.read, abort.raise} = {
  let start = project.files.filter(mentions).map(|f: sources::File| Bytes::of_string(f.module));
  let included = names_reached(
    names_of(modules),
    view::program_imports(modules),
    if start.len() > 0 { start } else { modules.own.take(1) },
  );
  let checked = modules_within(modules, included).fold(
    Map::new(),
    |found: Map<Bytes, List<CheckedOwner>>, m: Bytes|
      found.insert(m, view::checked_owners({ module: m, shipped: false, tested: false })),
  );
  {
    included: included,
    calls: checked.fold(
      Map::new(),
      |found: Map<Bytes, Map<Bytes, Map<Int, MemberTarget>>>, m: Bytes, owners: List<CheckedOwner>|
        found.insert(m, calls_of(owners)),
    ),
    owner_records: checked.fold(
      Map::new(),
      |found: Map<Bytes, Map<Int, Record>>, _: Bytes, owners: List<CheckedOwner>|
        records_of(owners).fold(
          found,
          |all: Map<Bytes, Map<Int, Record>>, owner: Bytes, sites: Map<Int, Record>|
            all.insert(owner, sites),
        ),
    ),
  }
}

fn resolved_load(
  project: sources::Project,
  pulled: List<Bytes>,
  shipping: ShippedInputs,
  parses: ParsedSources,
  included: Option<Set<Bytes>>,
) -> ProgramLoad / {ProjectFiles, Derives, abort.raise} = {
  let narrowed = match included {
    Some(names) -> narrowed_project(project, names),
    None -> project,
  };
  let resolution = renamed_resolution(narrowed, shipping, parses);
  {
    files: narrowed.files,
    read_at: read_paths(narrowed).concat(pulled.map(sources::shipped_path)),
    shipping: shipping,
    resolved: match resolution.resolved {
      Ok(resolved) -> Ok(resolved),
      Err(u) -> Err(u.diagnostics),
    },
    parses: resolution.parses,
    calls: Map::new(),
    owner_records: Map::new(),
  }
}

fn checked_load(
  path: ResolvedPath,
  parses: ParsedSources,
  mentions: (sources::File) -> Bool / {abort.raise},
) -> ProgramLoad / {time.elapsed_ms, shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], ProjectFiles, fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], Derives, abort.raise, diverges} = {
  let project = sources::load_resolved([path]);
  match progress::silently(||
      session_over(
        [path],
        project,
        time.elapsed_ms(),
        false,
        |modules: Modules, _: ProgramSummary| rename_reading(project, modules, mentions),
      )) {
    Err(r) ->
      {
        ..resolved_load(project, [], sources::shipping_of([]), parses, None),
        resolved: Err(r.diagnostics),
      },
    Ok(s) ->
      {
        ..resolved_load(project, s.modules.pulled, sources::shipping_of(s.modules.pulled), parses, Some(s.value.included)),
        calls: s.value.calls,
        owner_records: s.value.owner_records,
      },
  }
}

fn unchecked_load(
  path: ResolvedPath,
  shipping: ShippedInputs,
  parses: ParsedSources,
) -> ProgramLoad / {builder.git[vcs], ProjectFiles, Derives, abort.raise, diverges} =
  resolved_load(sources::load_resolved([path]), [], shipping, parses, None)

pub fn loads_of(
  given: List<ResolvedPath>,
  pwd: String,
  checked: Bool,
  mentions: (sources::File) -> Bool / {abort.raise},
) -> { loads: List<Loaded>, failures: List<Failure> } / {time.elapsed_ms, fs.resolved_kind[abs], shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], ProjectFiles, fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], Derives, abort.raise, diverges} = {
  let roots = given.map(rooted);
  let shipping = sources::shipping_of(if checked { [] } else { sources::shipped_names() });
  let done = given.fold(
    { loads: [], failures: [], parses: Map::new() },
    |accumulator: { loads: List<Loaded>, failures: List<Failure>, parses: ParsedSources }, path: ResolvedPath| {
      let root = rooted(path);
      if accumulator.loads.any(|l: Loaded| l.files.any(|f: RootedPath| under(f, root))) {
        accumulator
      } else {
        let load = if checked { checked_load(path, accumulator.parses, mentions) }
        else { unchecked_load(path, shipping, accumulator.parses) };
        let library_files = shipped_files(path);
        match load.resolved {
          Err(ds) ->
            {
              ..accumulator,
              failures: accumulator.failures.push({
                path: displayed(root),
                reason: "does not check: " ++ errors_text(ds),
              }),
            },
          Ok(resolved) -> {
            let read_before = accumulator.loads.fold(Set::empty(), |m: Set<String>, l: Loaded|
              l.reads.fold(m, |into: Set<String>, r: Read| into.insert(absolute(pwd, r.file.at))));
            {
              loads: accumulator.loads.push({
                path: path,
                root: displayed(root),
                files: load.files.map(|f: sources::File| f.at),
                names: resolved.modules.map(|m: ParsedModule| m.name),
                indices: positions(resolved.modules.map(|m: ParsedModule| m.name)),
                module_files: load.read_at.map(|at: RootedPath| file_of(pwd, library_files, at)),
                declarations: resolved.resolution.declarations,
                scopes: resolved.resolution.scopes,
                visible_modules: resolved.resolution.visible_modules,
                shipping: load.shipping,
                reads: load.files.filter(|f: sources::File|
                  roots.any(|r: RootedPath| under(f.at, r))
                    && !read_before.contains(absolute(pwd, f.at))).fold(
                  [],
                  |reads: List<Read>, f: sources::File|
                    match read_of(resolved, load.calls, load.owner_records, f) {
                      Some(r) -> reads.push(r),
                      None -> reads,
                    },
                ),
                unrenamed: load.files.filter(|f: sources::File|
                  !roots.any(|r: RootedPath| under(f.at, r))).fold(
                  [],
                  |reads: List<Read>, f: sources::File|
                    match read_of(resolved, load.calls, load.owner_records, f) {
                      Some(r) -> reads.push(r),
                      None -> reads,
                    },
                ),
              }),
              failures: accumulator.failures,
              parses: load.parses,
            }
          },
        }
      }
    },
  );
  { loads: done.loads, failures: done.failures }
}
