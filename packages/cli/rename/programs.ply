import std.fs (fs, File)
import std.json (Bool)
import paths (RootedPath, ResolvedPath, absolute, child, displayed, kind, read_file, rooted)
import library
import std.path (normalize)
import walk (Failure)
import sources
import program (ParsedSources, load_program, program_view, resolution_of)
import diagnostic (errors_text)
import builder (builder)
import std.random (entropy)
import std.time (time)
import compiler.cc (toolchain)
import compiler.load (Derives)
import compiler.unit (shipped)
import compiler.front.facts (CheckedProgram)
import compiler.front (ShippedInputs)
import compiler.check.resolve.defaults (ResolvedProgram)
import compiler.check.resolve.tables (ParsedModule, Diagnostic, Declarations, Resolution, Scope,
                                      module_of_name)
import compiler.check.resolve.bindings (written, Written, ModuleQualifier)
import compiler.check.infer (item_owner)
import compiler.check.infer.checker (MemberSite)
import compiler.check.member (MemberTarget)
import compiler.syntax.items (parse, Module, ImportDeclaration, Item, EffectItem, ExternItem,
                              TypeItem, SumBody, VariantDefinition, OpDefinition)
import compiler.syntax.node_ids (numbered_module)

pub type Library = { root: RootedPath, name: String }

pub fn module_path(file: RootedPath, package: RootedPath) -> String / {abort.raise} =
  file.path.slice(if package.path == "" { 0 } else { package.path.len() + 1 }, file.path.len() - 4)

pub fn root_relative(path: String, at: RootedPath) -> String / {abort.raise} =
  if at.label == "abs" && path.starts_with("/") { path.slice(1, path.len()) } else { path }

pub fn package_of(
  file: RootedPath,
  libraries: List<Library>,
) -> Option<RootedPath> / {fs.kind[cwd], fs.kind[abs], abort.raise} = {
  let parts = file.path.split("/");
  match range(0, parts.len()).map(|k: Int| parts.len() - 1 - k).map(|k: Int|
      { label: file.label, path: String::join(parts.take(k), "/") }).find(|dir: RootedPath|
      kind(child(dir, "ply.pkg")) == File) {
    Some(package) -> Some(package),
    None ->
      libraries.find(|l: Library|
        l.root.label == file.label && file.path.starts_with(l.root.path ++ "/")).map(
        |l: Library| l.root,
      ),
  }
}

pub fn libraries_of(
  given: List<ResolvedPath>,
) -> List<Library> / {fs.resolved_kind[abs], fs.read_file[abs], abort.raise} =
  given.fold([], |acc: List<Library>, r: ResolvedPath|
    match library::part_of(r.absolute) {
      Some(part) -> if normalize(r.absolute) == part.dir {
        acc.push({ root: rooted(r), name: part.prefix })
      } else { acc },
      None -> acc,
    })

pub type Entry = { owner: Bytes, names: Written }

pub type Read = {
  file: sources::File,
  index: Int,
  name: Bytes,
  entries: List<Entry>,
  calls: Map<Bytes, Map<Int, MemberTarget>>,
  imports: List<{ declaration: ImportDeclaration, target: Int }>,
  externs: Map<Bytes, Bool>,
  effects: List<{ name: Bytes, operations: List<Bytes> }>,
  sums: List<{ name: Bytes, variants: List<Bytes> }>,
}

pub type Loaded = {
  path: ResolvedPath,
  root: String,
  files: List<RootedPath>,
  names: List<Bytes>,
  indices: Map<Bytes, Int>,
  module_files: List<Option<String>>,
  declarations: List<Declarations>,
  scopes: List<Scope>,
  visible_modules: List<List<Int>>,
  shipping: ShippedInputs,
  reads: List<Read>,
  unrenamed: List<Read>,
}

pub fn indices_of(names: List<Bytes>) -> Map<Bytes, Int> / {abort.raise} =
  range(0, names.len()).fold(Map::new(), |m: Map<Bytes, Int>, i: Int| m.insert(names.get(i), i))

pub type DefinitionKey = { file: String, name: Bytes }

pub fn name_in(module: Bytes, qualified: Bytes) -> Bytes / {abort.raise} =
  if module.len() == 0 { qualified } else { qualified.slice(module.len() + 1, qualified.len()) }

pub fn key_of(l: Loaded, qualified: Bytes) -> Option<DefinitionKey> / {abort.raise} = {
  let module = module_of_name(qualified);
  match l.indices.get(module).and_then(|i: Int| l.module_files.at(i)) {
    Some(Some(file)) -> Some({ file: file, name: name_in(module, qualified) }),
    _ -> None,
  }
}

fn file_of(pwd: String, files: Map<String, String>, at: RootedPath) -> Option<String> =
  if at.label == "shipped" { files.get(at.path) } else { Some(absolute(pwd, at)) }

fn shipped_files(
  path: ResolvedPath,
) -> Map<String, String> / {fs.resolved_kind[abs], fs.read_file[abs], fs.read[abs], abort.raise} =
  match library::enclosing_checkout(path.absolute) {
    Some(c) -> library::module_files(c),
    None -> Map::new(),
  }

fn calls_by_module(
  view: CheckedProgram,
) -> Map<Bytes, Map<Bytes, Map<Int, MemberTarget>>> / {abort.raise} =
  view.checked.facts.members.fold(
    Map::new(),
    |acc: Map<Bytes, Map<Bytes, Map<Int, MemberTarget>>>, s: MemberSite| {
      let name = view.frame.outlines.get(s.module).name;
      let module = acc.get(name).unwrap_or(Map::new());
      acc.insert(
        name,
        module.insert(s.owner, module.get(s.owner).unwrap_or(Map::new()).insert(s.site, s.callee)),
      )
    },
  )

pub fn entries_of(
  r: Resolution,
  index: Int,
  name: Bytes,
  tree: Module,
) -> List<Entry> / {abort.raise} = {
  let names = written(r, index, tree);
  range(0, names.len()).map(|k: Int|
    {
      owner: if k == 0 { b"" } else { item_owner(name, tree.items.get(k - 1)) },
      names: names.get(k),
    })
}

fn read_of(
  resolved: ResolvedProgram,
  calls: Map<Bytes, Map<Bytes, Map<Int, MemberTarget>>>,
  file: sources::File,
) -> Option<Read> / {abort.raise} = {
  let name = Bytes::of_string(file.module);
  match range(0, resolved.modules.len()).find(|i: Int| resolved.modules.get(i).name == name) {
    None -> None,
    Some(index) -> {
      let tree = numbered_module(parse(file.text).node);
      let targets = resolved.r.imports.get(index);
      Some({
        file: file,
        index: index,
        name: name,
        entries: entries_of(resolved.r, index, name, tree),
        calls: calls.get(name).unwrap_or(Map::new()),
        imports: range(0, tree.imports.len()).fold(
          [],
          |acc: List<{ declaration: ImportDeclaration, target: Int }>, k: Int|
            match targets.at(k) {
              Some(t) -> acc.push({ declaration: tree.imports.get(k), target: t }),
              None -> acc,
            },
        ),
        externs: tree.items.fold(Map::new(), |acc: Map<Bytes, Bool>, item: Item|
          match item { ExternItem(x) -> acc.insert(x.name.name, true), _ -> acc }),
        effects: tree.items.fold(
          [],
          |acc: List<{ name: Bytes, operations: List<Bytes> }>, item: Item|
            match item {
              EffectItem(e) ->
                acc.push({
                  name: e.name.name,
                  operations: e.operations.map(|op: OpDefinition| op.name.name),
                }),
              _ -> acc,
            },
        ),
        sums: tree.items.fold(
          [],
          |acc: List<{ name: Bytes, variants: List<Bytes> }>, item: Item|
            match item {
              TypeItem(t) -> match t.body {
                SumBody(variants) ->
                  acc.push({
                    name: t.name.name,
                    variants: variants.map(|v: VariantDefinition| v.name.name),
                  }),
                _ -> acc,
              },
              _ -> acc,
            },
        ),
      })
    },
  }
}

fn under(at: RootedPath, root: RootedPath) -> Bool =
  at.label == root.label
    && (root.path == "" || root.path == "." || at.path == root.path
    || at.path.starts_with(root.path ++ "/"))

pub fn loads_of(
  given: List<ResolvedPath>,
  pwd: String,
) -> { loads: List<Loaded>, failures: List<Failure> } / {fs.resolved_kind[abs], shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, Derives, abort.raise, diverges} = {
  let roots = given.map(rooted);
  let done = given.fold(
    { loads: [], failures: [], parses: Map::new() },
    |acc: { loads: List<Loaded>, failures: List<Failure>, parses: ParsedSources }, path: ResolvedPath| {
      let root = rooted(path);
      if acc.loads.any(|l: Loaded| l.files.any(|f: RootedPath| under(f, root))) { acc } else {
        let program = load_program([path], false);
        let library_files = shipped_files(path);
        let resolution = resolution_of(program, acc.parses);
        let rejected = |ds: List<Diagnostic>|
          {
            ..acc,
            failures: acc.failures.push({
              path: displayed(root),
              reason: "does not check: " ++ errors_text(ds),
            }),
          };
        match ((resolution.resolved, program_view(program))) {
          (Err(ds), _) -> rejected(ds),
          (_, None) -> rejected(program.diagnostics),
          (Ok(resolved), Some(view)) -> {
            let calls = calls_by_module(view);
            let read_before = acc.loads.fold(Map::new(), |m: Map<String, Bool>, l: Loaded|
              l.reads.fold(m, |into: Map<String, Bool>, r: Read|
                into.insert(absolute(pwd, r.file.at), true)));
            {
              loads: acc.loads.push({
                path: path,
                root: displayed(root),
                files: program.files.map(|f: sources::File| f.at),
                names: resolved.modules.map(|m: ParsedModule| m.name),
                indices: indices_of(resolved.modules.map(|m: ParsedModule| m.name)),
                module_files: program.read_at.map(|at: RootedPath| file_of(pwd, library_files, at)),
                declarations: resolved.r.declarations,
                scopes: resolved.r.scopes,
                visible_modules: resolved.r.visible_modules,
                shipping: program.shipping,
                reads: program.files.filter(|f: sources::File|
                  roots.any(|r: RootedPath| under(f.at, r))
                    && !read_before.contains(absolute(pwd, f.at))).fold(
                  [],
                  |reads: List<Read>, f: sources::File|
                    match read_of(resolved, calls, f) { Some(r) -> reads.push(r), None -> reads },
                ),
                unrenamed: program.files.filter(|f: sources::File|
                  !roots.any(|r: RootedPath| under(f.at, r))).fold(
                  [],
                  |reads: List<Read>, f: sources::File|
                    match read_of(resolved, calls, f) { Some(r) -> reads.push(r), None -> reads },
                ),
              }),
              failures: acc.failures,
              parses: resolution.parses,
            }
          },
        }
      }
    },
  );
  { loads: done.loads, failures: done.failures }
}
