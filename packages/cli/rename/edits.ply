import std.fs (fs)
import std.json (Bool)
import paths (RootedPath, absolute, child, displayed, kind)
import walk (Failure)
import compiler.check.resolve.tables (Declarations, Declaration, Namespace, ValueSpace, TypeSpace,
                                      EffectSpace, SetSpace, Binding, declarations_in, namespaces,
                                      bindings_in, qualify, module_of_name)
import compiler.check.resolve.bindings (written, Reference, Member, Local, Definition, Operation,
                                        ModuleQualifier, Unbound, FieldName, CalledName,
                                        ArgumentName, FieldOf, RecordAt, RecordFields, TypeNamed)
import compiler.check.member (MemberTarget, CallsFunction)
import compiler.syntax.lexer (lex, Token, Comment, Identifier)
import compiler.syntax.items (Module, ImportDeclaration, ModuleAlias, member_of, member_name)
import compiler.syntax.parsing (is_synthetic_site)
import rename.lines (LocalLine, Moved, MemberLine, Renames, field_name, joined, renamed, shown)
import rename.strings (line_at)
import rename.programs (Entry, Library, Loaded, Read, DefinitionKey, Record, PlainRecord,
                        NewRecordType, DeclaredRecord, plain_record, root_relative, key_of,
                        module_path, package_of)
import compiler.emit.keys (name_in_module)

type Applying = { at: Int, parts: List<Bytes> }

pub fn applied(text: Bytes, edits: List<Edit>) -> Bytes / {abort.raise} = {
  let done = edits.sort_by_key(|e: Edit| e.start).fold(
    { at: 0, parts: [] },
    |s: Applying, e: Edit|
      { at: e.end, parts: s.parts.push(text.slice(s.at, e.start)).push(e.text) },
  );
  Bytes::concat_all(done.parts.push(text.slice(done.at, text.len())))
}

type Spaces = {
  values: Map<DefinitionKey, Bytes>,
  types: Map<DefinitionKey, Bytes>,
  effects: Map<DefinitionKey, Bytes>,
  effect_sets: Map<DefinitionKey, Bytes>,
}

const no_spaces: Spaces =
  { values: Map::new(), types: Map::new(), effects: Map::new(), effect_sets: Map::new() }

fn names_in_namespace(s: Spaces, namespace: Namespace) -> Map<DefinitionKey, Bytes> =
  match namespace {
    ValueSpace -> s.values,
    TypeSpace -> s.types,
    EffectSpace -> s.effects,
    SetSpace -> s.effect_sets,
  }

fn with_entry(s: Spaces, namespace: Namespace, key: DefinitionKey, value: Bytes) -> Spaces =
  match namespace {
    ValueSpace -> { ..s, values: s.values.insert(key, value) },
    TypeSpace -> { ..s, types: s.types.insert(key, value) },
    EffectSpace -> { ..s, effects: s.effects.insert(key, value) },
    SetSpace -> { ..s, effect_sets: s.effect_sets.insert(key, value) },
  }

pub type ModuleMove = { to: RootedPath, before: List<Bytes>, new_parts: List<Bytes> }

pub type RecordRenames = { path: String, declared: DeclaredRecord, renamed: Map<Bytes, Bytes> }

pub type Renaming = {
  pwd: String,
  renames: Renames,
  definitions: Spaces,
  operations: Map<DefinitionKey, Map<Bytes, Bytes>>,
  records: Map<Record, RecordRenames>,
  declared_records: Map<Bytes, Record>,
  modules: Map<String, ModuleMove>,
  declared: Map<DefinitionKey, String>,
  locals: Map<Bytes, Map<Int, Bytes>>,
  parameters: Map<Bytes, Map<Bytes, Bytes>>,
  rejections: List<Failure>,
}

pub type LocalBinder = { owner: Bytes, site: Int, first: Bool }

pub fn local_binders(r: Read, line: LocalLine) -> List<LocalBinder> / {abort.raise} =
  r.entries.fold([], |found: List<LocalBinder>, e: Entry| {
    let binders = e.names.references.filter(|x: Reference|
      x.name == line.old && x.target == Local(x.identifier_id)
        && !is_synthetic_site(x.identifier_id));
    range(0, binders.len()).fold(found, |all: List<LocalBinder>, k: Int|
      if line_at(r.file.text, binders.get(k).start) != line.line { all }
      else { all.push({ owner: e.owner, site: binders.get(k).identifier_id, first: k == 0 }) })
  })

fn local_key(path: String, owner: Bytes) -> Bytes =
  Bytes::concat_all([Bytes::of_string(path), b"\x00", owner])

fn with_local_lines(renaming: Renaming, r: Read) -> Renaming / {abort.raise} = {
  let path = displayed(r.file.at);
  renaming.renames.locals.filter(|line: LocalLine| line.file == path).fold(
    renaming,
    |named: Renaming, line: LocalLine|
      local_binders(r, line).fold(named, |done: Renaming, b: LocalBinder| {
        let key = local_key(path, b.owner);
        let sites = done.locals.get(key).unwrap_or(Map::new());
        let parameters = done.parameters.get(b.owner).unwrap_or(Map::new());
        {
          ..done,
          locals: done.locals.insert(key, sites.insert(b.site, line.new)),
          parameters: if b.first {
            done.parameters.insert(b.owner, parameters.insert(line.old, line.new))
          } else { done.parameters },
        }
      }),
  )
}

fn simple_name(renames: Renames, file: String, name: Bytes) -> Bytes / {abort.raise} =
  match renames.defined.get(name).and_then(|files: Map<String, Bytes>| files.get(file)) {
    Some(new) -> new,
    None -> renamed(renames, name),
  }

fn declared_name(
  renames: Renames,
  file: String,
  declarations: Declarations,
  name: Bytes,
) -> Bytes / {abort.raise} =
  match member_of(name) {
    Some(m) ->
      member_name(
        if declarations_in(declarations, TypeSpace).any(|d: Declaration| d.name == m.of) {
          simple_name(renames, file, m.of)
        } else { m.of },
        simple_name(renames, file, m.member),
      ),
    None -> simple_name(renames, file, name),
  }

pub fn unqualified_name(name: Bytes) -> Bytes / {abort.raise} =
  match member_of(name) { Some(m) -> m.member, None -> name }

fn extern_rejection(path: String, name: Bytes) -> Failure / {abort.raise} =
  {
    path: path,
    reason: shown(unqualified_name(name))
      ++ " is declared with `extern`, so code outside Ply uses that name",
  }

fn with_definitions(
  renaming: Renaming,
  r: Read,
  declarations: Declarations,
) -> Renaming / {abort.raise} = {
  let path = displayed(r.file.at);
  let file = absolute(renaming.pwd, r.file.at);
  namespaces.fold(renaming, |accumulator: Renaming, namespace: Namespace|
    declarations_in(declarations, namespace).fold(accumulator, |into: Renaming, d: Declaration| {
      let new = declared_name(renaming.renames, path, declarations, d.name);
      let seen = if namespace == ValueSpace {
        into.declared.insert({ file: file, name: d.name }, path)
      } else { into.declared };
      if new == d.name { { ..into, declared: seen } } else if r.externs.contains(d.name) {
        { ..into, declared: seen, rejections: into.rejections.push(extern_rejection(path, d.name)) }
      } else {
        {
          ..into,
          declared: seen,
          definitions: with_entry(into.definitions, namespace, { file: file, name: d.name }, new),
        }
      }
    }))
}

fn with_operations(
  renaming: Renaming,
  r: Read,
  declarations: Declarations,
) -> Renaming / {abort.raise} = {
  let path = displayed(r.file.at);
  r.effects.fold(renaming, |accumulator: Renaming, e: { name: Bytes, operations: List<Bytes> }|
    match declarations_in(declarations, EffectSpace).find(|d: Declaration| d.name == e.name) {
      None -> accumulator,
      Some(declared) -> {
        let effect_key = { file: absolute(renaming.pwd, r.file.at), name: declared.name };
        e.operations.fold(accumulator, |into: Renaming, op: Bytes| {
          let new = match renaming.renames.members.find(|m: MemberLine|
              m.file == path && m.of == e.name && m.member == op) {
            Some(m) -> m.new,
            None -> renamed(renaming.renames, op),
          };
          if new == op { into } else {
            {
              ..into,
              operations: into.operations.insert(
                effect_key,
                into.operations.get(effect_key).unwrap_or(Map::new()).insert(op, new),
              ),
            }
          }
        })
      },
    })
}

fn with_record_field(
  renaming: Renaming,
  path: String,
  line: MemberLine,
  d: DeclaredRecord,
) -> Renaming = {
  let before = renaming.records.get(d.record).unwrap_or({
    path: path,
    declared: d,
    renamed: Map::new(),
  });
  match before.renamed.get(line.member) {
    Some(other) -> if other == line.new { renaming } else {
      {
        ..renaming,
        rejections: renaming.rejections.push({
          path: path,
          reason: shown(line.of) ++ " has the same fields as " ++ shown(before.declared.name)
            ++ ", so renaming the field "
            ++ shown(line.member)
            ++ " on one type also renames it on the other, and it cannot be renamed to two different names",
        }),
      }
    },
    None ->
      {
        ..renaming,
        records: renaming.records.insert(d.record, {
          ..before,
          renamed: before.renamed.insert(line.member, line.new),
        }),
      },
  }
}

fn with_record_fields(renaming: Renaming, r: Read) -> Renaming = {
  let path = displayed(r.file.at);
  renaming.renames.members.filter(|m: MemberLine| m.file == path).fold(
    renaming,
    |named: Renaming, m: MemberLine|
      r.records.filter(|d: DeclaredRecord| d.name == m.of && d.fields.contains(m.member)).fold(
        named,
        |done: Renaming, d: DeclaredRecord| with_record_field(done, path, m, d),
      ),
  )
}

fn with_move(renaming: Renaming, r: Read, package: RootedPath) -> Renaming / {abort.raise} = {
  let at = r.file.at;
  let parts = module_path(at, package).split("/");
  let base = if package.path == "" { "" } else { package.path ++ "/" };
  let lined = renaming.renames.modules.fold(parts, |accumulator: List<String>, m: Moved| {
    let path = root_relative(m.path, at);
    let index = if !path.ends_with("/") { if path == at.path { parts.len() - 1 } else { -1 } }
    else if at.path.starts_with(path) && path.starts_with(base) {
      path.slice(base.len(), path.len() - 1).split("/").len() - 1
    } else { -1 };
    if index < 0 { accumulator } else {
      accumulator.take(index).push(String::of_bytes_lossy(m.new)).concat(
        accumulator.drop(index + 1),
      )
    }
  });
  let new = lined.map(|part: String|
    String::of_bytes_lossy(renamed(renaming.renames, Bytes::of_string(part))));
  let named = r.name.split(b".");
  let prefix_length = named.len() - parts.len();
  if new == parts { renaming }
  else if prefix_length < 0 || named.drop(prefix_length) != parts.map(Bytes::of_string) {
    {
      ..renaming,
      rejections: renaming.rejections.push({
        path: displayed(at),
        reason: "its module's name, " ++ shown(r.name) ++ ", does not follow its file's path",
      }),
    }
  } else {
    {
      ..renaming,
      modules: renaming.modules.insert(absolute(renaming.pwd, at), {
        to: child(package, String::join(new, "/") ++ ".ply"),
        before: parts.map(Bytes::of_string),
        new_parts: new.map(Bytes::of_string),
      }),
    }
  }
}

pub fn move_of(renaming: Renaming, l: Loaded, module: Int) -> Option<ModuleMove> =
  match l.module_files.at(module) { Some(Some(file)) -> renaming.modules.get(file), _ -> None }

pub fn moved_name(name: Bytes, move: Option<ModuleMove>) -> Bytes =
  match move {
    None -> name,
    Some(m) -> {
      let named = name.split(b".");
      let prefix_length = named.len() - m.before.len();
      if prefix_length < 0 || named.drop(prefix_length) != m.before { name }
      else { joined(named.take(prefix_length).concat(m.new_parts), b".") }
    },
  }

pub fn qualified_renames(
  renaming: Renaming,
  reads: List<Read>,
) -> Map<Bytes, Bytes> / {abort.raise} = {
  let modules = reads.fold(Map::new(), |accumulator: Map<String, Bytes>, r: Read|
    accumulator.insert(absolute(renaming.pwd, r.file.at), r.name));
  let moved = modules.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, file: String, module: Bytes|
      match renaming.modules.get(file) {
        Some(m) -> accumulator.insert(module, moved_name(module, Some(m))),
        None -> accumulator,
      },
  );
  namespaces.fold(moved, |accumulator: Map<Bytes, Bytes>, namespace: Namespace|
    names_in_namespace(renaming.definitions, namespace).fold(
      accumulator,
      |into: Map<Bytes, Bytes>, key: DefinitionKey, new: Bytes|
        match modules.get(key.file) {
          Some(module) -> if member_of(key.name) != None { into } else {
            into.insert(
              joined([module, key.name], b"."),
              joined([moved_name(module, renaming.modules.get(key.file)), new], b"."),
            )
          },
          None -> into,
        },
    ))
}

pub fn renaming_of(
  pwd: String,
  renames: Renames,
  loads: List<Loaded>,
  libraries: List<Library>,
) -> Renaming / {fs.kind[cwd], fs.kind[abs], abort.raise} =
  loads.fold(
    {
      pwd: pwd,
      renames: renames,
      definitions: no_spaces,
      operations: Map::new(),
      records: Map::new(),
      declared_records: loads.fold(Map::new(), |accumulator: Map<Bytes, Record>, l: Loaded|
        l.reads.concat(l.unrenamed).fold(accumulator, |into: Map<Bytes, Record>, r: Read|
          r.records.fold(into, |m: Map<Bytes, Record>, d: DeclaredRecord|
            m.insert(qualify(r.name, d.name), d.record)))),
      modules: Map::new(),
      declared: Map::new(),
      locals: Map::new(),
      parameters: Map::new(),
      rejections: [],
    },
    |accumulator: Renaming, l: Loaded|
      l.reads.fold(accumulator, |renaming: Renaming, r: Read| {
        let declarations = l.declarations.get(r.index);
        let named = with_record_fields(
          with_operations(with_definitions(renaming, r, declarations), r, declarations),
          r,
        );
        with_local_lines(
          match package_of(r.file.at, libraries) {
            Some(package) -> with_move(named, r, package),
            None -> named,
          },
          r,
        )
      }),
  )

pub fn qualified_after(
  renaming: Renaming,
  l: Loaded,
  namespace: Namespace,
  qualified: Bytes,
) -> Bytes / {abort.raise} = {
  let module = module_of_name(qualified);
  match l.indices.get(module) {
    None -> qualified,
    Some(i) ->
      qualify(
        moved_name(module, move_of(renaming, l, i)),
        key_of(l, qualified).and_then(|k: DefinitionKey|
          names_in_namespace(renaming.definitions, namespace).get(k)).unwrap_or(
          name_in_module(module, qualified),
        ),
      ),
  }
}

pub type Edit = { start: Int, end: Int, text: Bytes, names: List<Bytes> }

pub type Edited = {
  edits: List<Edit>,
  renamed: Map<Bytes, List<Bytes>>,
  unchanged: Map<Bytes, Bool>,
  failures: List<Failure>,
}

fn qualifier_new(renaming: Renaming, l: Loaded, r: Read, text: Bytes, m: Int) -> Bytes =
  match move_of(renaming, l, m) {
    None -> text,
    Some(move) -> if r.imports.any(|i: { declaration: ImportDeclaration, target: Int }|
        match i.declaration.kind { ModuleAlias(a) -> a.name == text, _ -> false }) { text }
    else { move.new_parts.at(move.new_parts.len() - 1).unwrap_or(text) },
  }

fn definition_new(
  renaming: Renaming,
  l: Loaded,
  namespace: Namespace,
  qualified: Bytes,
  written: Bytes,
) -> Bytes / {abort.raise} =
  match key_of(l, qualified).and_then(|k: DefinitionKey|
      names_in_namespace(renaming.definitions, namespace).get(k)) {
    Some(n) -> if member_of(written) != None { n } else { unqualified_name(n) },
    None -> written,
  }

pub type SharedName = { path: String, line: Int, old: Bytes, new: Bytes, other: Namespace }

pub fn shared_names(renaming: Renaming, loads: List<Loaded>) -> List<SharedName> / {abort.raise} =
  loads.fold([], |accumulator: List<SharedName>, l: Loaded|
    l.reads.fold(accumulator, |found: List<SharedName>, r: Read| {
      let file = absolute(renaming.pwd, r.file.at);
      let bound = l.scopes.get(r.index).bound;
      let after = namespaces.map(|namespace: Namespace|
        {
          namespace: namespace,
          names: bindings_in(bound, namespace).fold(
            Map::new(),
            |names: Map<Bytes, Bool>, b: Binding|
              names.insert(definition_new(renaming, l, namespace, b.qualified, b.name), true),
          ),
        });
      namespaces.fold(found, |f: List<SharedName>, namespace: Namespace|
        declarations_in(l.declarations.get(r.index), namespace).fold(
          f,
          |into: List<SharedName>, d: Declaration| {
            let new = names_in_namespace(renaming.definitions, namespace).get({
              file: file,
              name: d.name,
            }).unwrap_or(
              d.name,
            );
            let declarations = l.declarations.get(r.index);
            if new == d.name { into } else {
              match after.find(|a: { namespace: Namespace, names: Map<Bytes, Bool> }|
                  a.namespace != namespace && a.names.contains(new)
                    && !declarations_in(declarations, a.namespace).any(|o: Declaration|
                      o.name == d.name)) {
                Some(a) ->
                  into.push({
                    path: displayed(r.file.at),
                    line: line_at(r.file.text, d.span.start),
                    old: d.name,
                    new: new,
                    other: a.namespace,
                  }),
                None -> into,
              }
            }
          },
        ))
    }))

fn reference_new(
  renaming: Renaming,
  l: Loaded,
  r: Read,
  owner: Bytes,
  x: Reference,
) -> Bytes / {abort.raise} =
  match x.target {
    Local(binder) -> match renaming.locals.get(local_key(displayed(r.file.at), owner)).and_then(
        |sites: Map<Int, Bytes>| sites.get(binder),
      ) {
      Some(new) -> new,
      None -> simple_name(renaming.renames, displayed(r.file.at), x.name),
    },
    Definition(d) -> definition_new(renaming, l, d.namespace, d.qualified, x.name),
    Operation(o) -> match key_of(l, o.effect).and_then(|k: DefinitionKey|
        renaming.operations.get(k)) {
      Some(ops) -> ops.get(o.name).unwrap_or(x.name),
      None -> x.name,
    },
    ModuleQualifier(m) -> qualifier_new(renaming, l, r, x.name, m),
    Unbound -> x.name,
  }

fn typed_record(r: Read, owner: Bytes, site: Int) -> Option<Record> =
  r.typed_records.get(owner).and_then(|sites: Map<Int, Record>| sites.get(site))

fn record_of(renaming: Renaming, r: Read, owner: Bytes, of: FieldOf) -> Option<Record> =
  match of {
    RecordAt(site) -> typed_record(r, owner, site),
    RecordFields(fields) -> Some(plain_record(fields)),
    TypeNamed(name) -> renaming.declared_records.get(name),
  }

fn field_new(renaming: Renaming, record: Option<Record>, name: Bytes) -> Bytes / {abort.raise} =
  match record.and_then(|x: Record| renaming.records.get(x)).and_then(|x: RecordRenames|
      x.renamed.get(name)) {
    Some(new) -> new,
    None -> field_name(renaming.renames, name),
  }

fn record_unknown(renaming: Renaming, r: Read, owner: Bytes, m: Member) -> Bool =
  renaming.records.values().any(|x: RecordRenames| x.renamed.contains(m.name))
    && (match m.kind {
      FieldName(of) -> record_of(renaming, r, owner, of) == None,
      CalledName(call) -> match r.calls.get(owner).and_then(|calls: Map<Int, MemberTarget>|
          calls.get(call)) {
        Some(CallsFunction(_)) -> false,
        _ -> typed_record(r, owner, call) == None,
      },
      ArgumentName(_) -> false,
    })

fn member_new(
  renaming: Renaming,
  l: Loaded,
  r: Read,
  owner: Bytes,
  m: Member,
) -> Bytes / {abort.raise} = {
  let calls = r.calls.get(owner).unwrap_or(Map::new());
  match m.kind {
    FieldName(of) -> field_new(renaming, record_of(renaming, r, owner, of), m.name),
    CalledName(call) -> match calls.get(call) {
      Some(CallsFunction(callee)) -> match key_of(l, callee).and_then(|k: DefinitionKey|
          renaming.definitions.values.get(k)) {
        None -> m.name,
        Some(n) -> match member_of(m.name) {
          Some(w) -> member_name(w.of, unqualified_name(n)),
          None -> unqualified_name(n),
        },
      },
      _ -> field_new(renaming, typed_record(r, owner, call), m.name),
    },
    ArgumentName(a) -> {
      let callee = match calls.get(a.call) {
        Some(CallsFunction(c)) -> Some(c),
        Some(_) -> None,
        None -> match a.callee { Definition(d) -> Some(d.qualified), _ -> None },
      };
      match callee.and_then(|c: Bytes| renaming.parameters.get(c)).and_then(
          |names: Map<Bytes, Bytes>| names.get(m.name),
        ) {
        Some(new) -> new,
        None -> match callee.and_then(|c: Bytes| key_of(l, c)).and_then(|k: DefinitionKey|
            renaming.declared.get(k)) {
          Some(file) -> simple_name(renaming.renames, file, m.name),
          None -> m.name,
        },
      }
    },
  }
}

fn parts_of(name: Bytes) -> List<Bytes> / {abort.raise} =
  match member_of(name) { Some(m) -> [m.of, m.member], None -> [name] }

fn noted_edit(
  edited: Edited,
  text: Bytes,
  path: String,
  start: Int,
  end: Int,
  name: Bytes,
  new: Bytes,
) -> Edited / {abort.raise} =
  if new == name { { ..edited, unchanged: edited.unchanged.insert(name, true) } }
  else if text.slice(start, end) != name {
    {
      ..edited,
      failures: edited.failures.push({
        path: path ++ ":" ++ line_at(text, start).to_string(),
        reason: shown(name)
          ++ " does not appear in the source text at the position the checker reported",
      }),
    }
  } else {
    let olds = edited.renamed.get(name).unwrap_or([]);
    {
      ..edited,
      edits: edited.edits.push({ start: start, end: end, text: new, names: parts_of(new) }),
      renamed: edited.renamed.insert(name, if olds.contains(new) { olds } else { olds.push(new) }),
    }
  }

fn import_edits(renaming: Renaming, l: Loaded, r: Read) -> List<Edit> / {abort.raise} =
  r.imports.fold(
    [],
    |accumulator: List<Edit>, i: { declaration: ImportDeclaration, target: Int }|
      match move_of(renaming, l, i.target) {
        Some(move) -> {
          let offset = i.declaration.path.len() - move.before.len();
          range(0, move.before.len()).fold(accumulator, |edits: List<Edit>, j: Int|
            match i.declaration.path.at(offset + j) {
              Some(part) -> if part.name != move.before.get(j)
                  || move.before.get(j) == move.new_parts.get(j) { edits } else {
                edits.push({
                  start: part.span.start,
                  end: part.span.end,
                  text: move.new_parts.get(j),
                  names: [move.new_parts.get(j)],
                })
              },
              None -> edits,
            })
        },
        _ -> accumulator,
      },
  )

pub fn uses_renamed(renaming: Renaming, l: Loaded, r: Read) -> Bool / {abort.raise} =
  import_edits(renaming, l, r).len() > 0
    || r.entries.any(|e: Entry|
      e.names.references.any(|x: Reference|
          match x.target {
            Local(_) -> false,
            _ ->
              !is_synthetic_site(x.identifier_id)
                && reference_new(renaming, l, r, e.owner, x) != x.name,
          })
        || e.names.members.any(|m: Member| member_new(renaming, l, r, e.owner, m) != m.name))

pub fn edited_of(renaming: Renaming, l: Loaded, r: Read) -> Edited / {abort.raise} = {
  let text = r.file.text;
  let path = displayed(r.file.at);
  r.entries.fold(
    {
      edits: import_edits(renaming, l, r),
      renamed: Map::new(),
      unchanged: Map::new(),
      failures: [],
    },
    |accumulator: Edited, e: Entry| {
      let fields = e.names.members.fold(Map::new(), |m: Map<Int, Bytes>, x: Member|
        match x.kind {
          FieldName(_) -> m.insert(x.start, member_new(renaming, l, r, e.owner, x)),
          _ -> m,
        });
      let known = e.names.members.fold(accumulator, |done: Edited, x: Member|
        if !record_unknown(renaming, r, e.owner, x) { done } else {
          {
            ..done,
            failures: done.failures.push({
              path: path ++ ":" ++ line_at(text, x.start).to_string(),
              reason: "cannot tell which record type has the field " ++ shown(x.name) ++ " here",
            }),
          }
        });
      let shorthands = e.names.references.fold(Map::new(), |m: Map<Int, Bool>, x: Reference|
        if x.shorthand { m.insert(x.start, true) } else { m });
      let referred = e.names.references.fold(known, |done: Edited, x: Reference|
        if is_synthetic_site(x.identifier_id) { done } else {
          let new = reference_new(renaming, l, r, e.owner, x);
          let field = fields.get(x.start).unwrap_or(x.name);
          if x.shorthand && field != new {
            {
              ..done,
              unchanged: done.unchanged.insert(x.name, true),
              edits: done.edits.push({
                start: x.start,
                end: x.end,
                text: Bytes::concat_all([field, b": ", new]),
                names: [field, new],
              }),
            }
          } else { noted_edit(done, text, path, x.start, x.end, x.name, new) }
        });
      e.names.members.fold(referred, |done: Edited, x: Member|
        if shorthands.contains(x.start) { done } else {
          noted_edit(
            done,
            text,
            path,
            x.start,
            x.end,
            x.name,
            member_new(renaming, l, r, e.owner, x),
          )
        })
    },
  )
}

pub fn comment_edits(
  text: Bytes,
  comments: List<Comment>,
  edited: Edited,
) -> List<Edit> / {abort.raise} =
  comments.fold([], |accumulator: List<Edit>, c: Comment| {
    let body = text.slice(c.start, c.end);
    let ticks = range(0, body.len()).filter(|i: Int| body.at(i) == 96);
    range(0, ticks.len() / 2).fold(accumulator, |edits: List<Edit>, k: Int| {
      let from = c.start + ticks.get(2 * k) + 1;
      let lexed = lex(text.slice(from, c.start + ticks.get(2 * k + 1)));
      if lexed.diagnostics.len() > 0 { edits } else {
        lexed.tokens.fold(edits, |done: List<Edit>, t: Token|
          match t.kind {
            Identifier(n) -> match edited.renamed.get(n) {
              Some([new]) -> if edited.unchanged.contains(n) { done } else {
                done.push({ start: from + t.start, end: from + t.end, text: new, names: [] })
              },
              _ -> done,
            },
            _ -> done,
          })
      }
    })
  })

pub type SplitName = { path: String, line: Int, old: Bytes, new: Bytes, sum: Bytes }

pub fn split_names(renaming: Renaming, loads: List<Loaded>) -> List<SplitName> / {abort.raise} =
  loads.fold([], |accumulator: List<SplitName>, l: Loaded|
    l.reads.fold(accumulator, |found: List<SplitName>, r: Read| {
      let file = absolute(renaming.pwd, r.file.at);
      declarations_in(l.declarations.get(r.index), TypeSpace).fold(
        found,
        |into: List<SplitName>, t: Declaration| {
          let new = names_in_namespace(renaming.definitions, TypeSpace).get({
            file: file,
            name: t.name,
          }).unwrap_or(
            t.name,
          );
          if new == t.name { into } else {
            match r.sums.find(|sum: { name: Bytes, variants: List<Bytes> }|
                sum.name != t.name && sum.variants.contains(t.name)) {
              Some(sum) ->
                into.push({
                  path: displayed(r.file.at),
                  line: line_at(r.file.text, t.span.start),
                  old: t.name,
                  new: new,
                  sum: sum.name,
                }),
              None -> into,
            }
          }
        },
      )
    }))

pub fn record_clashes(renaming: Renaming, loads: List<Loaded>) -> List<Failure> = {
  let plain = loads.fold(Map::new(), |accumulator: Map<Record, Bool>, l: Loaded|
    l.reads.concat(l.unrenamed).fold(accumulator, |into: Map<Record, Bool>, r: Read| {
      let typed = r.typed_records.values().fold(
        into,
        |m: Map<Record, Bool>, sites: Map<Int, Record>|
          sites.values().fold(m, |found: Map<Record, Bool>, x: Record| found.insert(x, true)),
      );
      let declared = r.records.fold(typed, |m: Map<Record, Bool>, d: DeclaredRecord|
        m.insert(d.record, true));
      r.entries.fold(declared, |m: Map<Record, Bool>, e: Entry|
        e.names.members.fold(m, |found: Map<Record, Bool>, x: Member|
          match x.kind {
            FieldName(RecordFields(fields)) -> found.insert(plain_record(fields), true),
            _ -> found,
          }))
    }));
  let unnamed = loads.fold([], |accumulator: List<Failure>, l: Loaded|
    l.reads.fold(accumulator, |found: List<Failure>, r: Read| {
      let path = displayed(r.file.at);
      r.records.fold(found, |into: List<Failure>, d: DeclaredRecord|
        match renaming.records.get(d.record) {
          None -> into,
          Some(x) ->
            x.renamed.fold(into, |missing: List<Failure>, field: Bytes, new: Bytes|
              if renaming.renames.members.any(|m: MemberLine|
                  m.file == path && m.of == d.name && m.member == field && m.new == new) { missing }
              else {
                missing.push({
                  path: path,
                  reason: shown(d.name) ++ " has the same fields as " ++ shown(x.declared.name)
                    ++ ", so it is the same record type: rename the field in both, with the line `"
                    ++ path
                    ++ " "
                    ++ String::of_bytes_lossy(Bytes::concat_all([d.name, b".", field, b" ", new]))
                    ++ "`",
                })
              }),
        })
    }));
  renaming.records.fold(unnamed, |accumulator: List<Failure>, record: Record, x: RecordRenames| {
    let after = x.declared.fields.map(|f: Bytes| x.renamed.get(f).unwrap_or(f));
    let named = |reason: String|
      {
        path: x.path,
        reason: "renaming the fields of " ++ shown(x.declared.name) ++ " " ++ reason,
      };
    match after.find(|f: Bytes| after.filter(|g: Bytes| g == f).len() > 1) {
      Some(twice) -> accumulator.push(named("gives it two fields named " ++ shown(twice))),
      None -> match record {
        PlainRecord(_) -> if !plain.contains(plain_record(after)) { accumulator } else {
          accumulator.push(named("makes it the same type as another record with the same fields"))
        },
        NewRecordType(_) -> accumulator,
      },
    }
  })
}

pub fn with_derived(renaming: Renaming, derived: Map<DefinitionKey, Bytes>) -> Renaming =
  {
    ..renaming,
    definitions: {
      ..renaming.definitions,
      values: derived.fold(
        renaming.definitions.values,
        |m: Map<DefinitionKey, Bytes>, key: DefinitionKey, new: Bytes| m.insert(key, new),
      ),
    },
  }

pub fn renames_derived(renaming: Renaming, derived: Map<DefinitionKey, Bytes>) -> Bool =
  derived.fold(true, |all: Bool, key: DefinitionKey, new: Bytes|
    all && renaming.definitions.values.get(key) == Some(new))
