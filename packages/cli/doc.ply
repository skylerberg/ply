pub type LocatedPage = { page: Page, module: Option<String>, location: Option<String> }

fn unlocated_page(page: Page) -> LocatedPage = { page: page, module: None, location: None }

pub fn summary_of(doc: List<String>) -> String / {abort.raise} = {
  let first = doc.fold(
    { done: false, text: "" },
    |accumulator: { done: Bool, text: String }, l: String|
      if accumulator.done { accumulator }
      else if l == "" { { done: true, text: accumulator.text } } else {
        { done: false, text: if accumulator.text == "" { l } else { accumulator.text ++ " " ++ l } }
      },
  );
  match first.text.index_of(". ") { Some(i) -> first.text.slice(0, i + 1), None -> first.text }
}

fn builtin_signature(found: Builtin) -> PrintedSignature / {abort.raise} =
  signature("", String::of_bytes_lossy(found.name), found.scheme, found.params)

fn natives() -> List<Builtin> / {abort.raise} = builtins().filter(|b: Builtin| !b.body)

fn builtin_page(query: String) -> Option<Page> / {abort.raise} =
  match builtin_named(Bytes::of_string(query)) {
    None -> None,
    Some(found) -> if found.body { None } else {
      let signed: PrintedSignature = builtin_signature(found);
      Some({
        ..bare_page("builtin", String::of_bytes_lossy(found.name), signed.text),
        ty: String::of_bytes_lossy(scheme_text(found.scheme)),
        params: signed.params,
        doc: found.doc.map(|l: Bytes| String::of_bytes_lossy(l)),
        clauses: found.clauses.map(|c: Bytes| String::of_bytes_lossy(c)),
      })
    },
  }

fn with_natives(found: Lookup) -> Lookup / {abort.raise} =
  match found {
    Found(p) ->
      Found({
        ..p,
        page: { ..p.page, members: natives().map(builtin_member).concat(p.page.members) },
      }),
    other -> other,
  }

fn unknown_name(query: String, names: List<String>) -> Diagnostic = {
  let d: Diagnostic = unknown_definition(query, names);
  if names.len() > 0 { d }
  else { with_note(d, b"a builtin is named as the prelude declares it, as in `ply doc List::len`") }
}

type ModulePage = { module: Bytes, page: Page }

type Lookup = | Found(LocatedPage) | Ambiguous(List<String>) | NotFound

fn modules_enclosing(modules: List<Bytes>, q: Bytes) -> List<Bytes> =
  modules.filter(|m: Bytes| q == m || q.starts_with(m.concat(b".")))

fn pages_of(modules: List<Bytes>, documented: List<Pages>) -> List<ModulePage> =
  range(0, modules.len()).fold([], |accumulator: List<ModulePage>, i: Int|
    match ((modules.at(i), documented.at(i))) {
      (Some(m), Some(d)) ->
        d.pages.fold(accumulator, |module_pages: List<ModulePage>, page: Page|
          module_pages.push({ module: m, page: page })),
      _ -> accumulator,
    })

fn label(h: ModulePage) -> String =
  if h.page.kind == "definition" { h.page.name } else { h.page.name ++ " (" ++ h.page.kind ++ ")" }

fn find_page(module_pages: List<ModulePage>, query: String) -> Result<ModulePage, List<String>> =
  match module_pages.find(|h: ModulePage| h.page.name == query) {
    Some(h) -> Ok(h),
    None -> match module_pages.filter(|h: ModulePage| h.page.simple == query) {
      [] -> Err([]),
      [only] -> Ok(only),
      many -> Err(many.map(label)),
    },
  }

fn location_in(path: String, text: Bytes, at: Int) -> String / {abort.raise} = {
  let spot = position_of(text, at);
  path ++ ":" ++ spot.line.to_string() ++ ":" ++ spot.column.to_string()
}

fn locate_page(h: ModulePage, path: String, text: Bytes) -> LocatedPage / {abort.raise} =
  if h.page.kind == "module" { { page: h.page, module: None, location: Some(path) } } else {
    {
      page: h.page,
      module: Some(String::of_bytes_lossy(h.module)),
      location: Some(location_in(path, text, h.page.at)),
    }
  }

fn lookup_of<| e>(
  found: Result<ModulePage, List<String>>,
  place: (ModulePage) -> LocatedPage / {abort.raise | e},
) -> Lookup / {abort.raise | e} =
  match found {
    Ok(h) -> Found(place(h)),
    Err(names) -> if names.len() > 0 { Ambiguous(names) } else { NotFound },
  }

fn first_word(q: Bytes) -> Bytes / {abort.raise} =
  match q.index_of(b".") { Some(i) -> q.slice(0, i), None -> q }

fn find_shipped(
  query: String,
) -> Lookup / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} = {
  let q = Bytes::of_string(query);
  let under = modules_enclosing(shipped_names().filter(is_shipped), q);
  let candidate_modules = if under.len() > 0 { under }
  else { match shipped_declarations().get(q) { Some(modules) -> modules, None -> [] } };
  lookup_of(
    find_page(pages_of(candidate_modules, shipped_doc_pages(candidate_modules)), query),
    |h: ModulePage| {
      let module = String::of_bytes_lossy(h.module);
      locate_page(h, pseudo_path(module), match sources::shipped_text(Bytes::of_string(module)) {
        Some(text) -> text,
        None -> b"",
      })
    },
  )
}

fn builtin_member(b: Builtin) -> Member / {abort.raise} =
  {
    kind: "builtin",
    name: String::of_bytes_lossy(b.name),
    signature: builtin_signature(b).text,
    doc: b.doc.map(|l: Bytes| String::of_bytes_lossy(l)),
  }

fn language_type_page(
  query: String,
) -> Option<Page> / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} = {
  let under = query ++ "::";
  let declared = natives().filter(|b: Builtin| b.name.starts_with(Bytes::of_string(under)));
  let names = shipped_names();
  let homes = [prelude_module(), Bytes::of_string("std." ++ query.ascii_lower())].filter(
    |n: Bytes| names.contains(n),
  );
  let own = pages_of(homes, shipped_doc_pages(homes)).fold(
    [],
    |accumulator: List<Member>, h: ModulePage|
      if h.page.kind != "module" { accumulator }
      else { accumulator.concat(h.page.members.filter(|m: Member| m.name.starts_with(under))) },
  );
  if declared.len() == 0 && own.len() == 0 { None } else {
    Some({ ..bare_page("type", query, query), members: declared.map(builtin_member).concat(own) })
  }
}

fn outside_program(
  query: String,
) -> Lookup / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} = {
  let prelude = String::of_bytes_lossy(prelude_module());
  if query == prelude { with_natives(find_shipped(query)) } else {
    match builtin_page(query) {
      Some(page) -> Found(unlocated_page(page)),
      None -> match builtin_named(Bytes::of_string(query)) {
        Some(_) -> find_shipped(prelude ++ "." ++ query),
        None -> match language_type_page(query) {
          Some(page) -> Found(unlocated_page(page)),
          None -> find_shipped(query),
        },
      },
    }
  }
}

fn could_declare(o: Outline, head: Bytes) -> Bool =
  o.set_texts.len() > 0 || o.declared.contains(qualify(o.name, head))

fn lookup_in_program(
  flags: Flags,
  project: sources::Project,
  loaded: Program,
  frame: Frame,
) -> Lookup / {fs.list_dir[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} = {
  let q = Bytes::of_string(flags.query);
  let under = modules_enclosing(frame.outlines.map(|o: Outline| o.name), q);
  let candidate_modules = if under.len() > 0 { under } else {
    let head = first_word(q);
    frame.outlines.filter(|o: Outline| could_declare(o, head)).map(|o: Outline| o.name)
  };
  let pulled = program::pulled_modules(frame);
  let documented = program::doc_pages(
    flags.paths,
    project,
    candidate_modules.map(|m: Bytes| { module: m, shipped: pulled.contains(m), tested: false }),
  );
  lookup_of(find_page(pages_of(candidate_modules, documented), flags.query), |h: ModulePage| {
    let at = range(0, frame.outlines.len()).fold(None, |found: Option<SourceText>, i: Int|
      match found {
        Some(_) -> found,
        None -> match frame.outlines.at(i) {
          Some(o) -> if o.name == h.module { loaded.source_texts.at(i) } else { None },
          None -> None,
        },
      });
    match at {
      Some(place) -> locate_page(h, place.path, place.text),
      None -> { page: h.page, module: Some(String::of_bytes_lossy(h.module)), location: None },
    }
  })
}

fn joined_lines(lines: List<String>) -> String =
  range(0, lines.len()).fold("", |accumulator: String, i: Int|
    match lines.at(i) {
      Some(l) -> if i == 0 { l } else { accumulator ++ "\n" ++ l },
      None -> accumulator,
    })

fn member_json(m: Member) -> Json / {abort.raise} =
  object([
    { key: "kind", value: Str(m.kind) },
    { key: "name", value: Str(m.name) },
    { key: "signature", value: Str(m.signature) },
    { key: "doc", value: Str(joined_lines(m.doc)) },
    { key: "summary", value: Str(summary_of(m.doc)) },
  ])

fn page_json(p: LocatedPage) -> Json / {abort.raise} = {
  let page = p.page;
  object([
    { key: "command", value: Str("doc") },
    { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: Number(Decimal::of_int(ok_code())) },
    { key: "kind", value: Str(page.kind) },
    { key: "name", value: Str(page.name) },
    { key: "signature", value: Str(page.signature) },
    { key: "type", value: Str(page.ty) },
    {
      key: "params",
      value: Array(
        page.params.map(|named: TypedParameter|
          object([{ key: "name", value: Str(named.name) }, { key: "type", value: Str(named.ty) }])),
      ),
    },
    { key: "doc", value: Str(joined_lines(page.doc)) },
    { key: "summary", value: Str(summary_of(page.doc)) },
    { key: "clauses", value: strings(page.clauses) },
    { key: "members", value: Array(page.members.map(member_json)) },
    { key: "module", value: string_or_null(p.module) },
    { key: "location", value: string_or_null(p.location) },
    { key: "hash", value: string_or_null(page.hash) },
    { key: "effects", value: strings_or_null(page.effects) },
    { key: "laws", value: strings(page.laws) },
  ])
}

fn with_field(
  style: Style,
  label: String,
  value: Option<String>,
  lines: List<String>,
) -> List<String> =
  match value { None -> lines, Some(v) -> lines.push(indent() ++ dim(style, label) ++ " " ++ v) }

fn with_names(
  style: Style,
  label: String,
  names: List<String>,
  lines: List<String>,
) -> List<String> =
  if names.len() == 0 { lines } else {
    lines.push(
      indent() ++ dim(style, label) ++ " "
        ++ String::join(names.map(|n: String| "\"" ++ n ++ "\""), ", "),
    )
  }

fn member_lines(whole: Bool, m: Member, lines: List<String>) -> List<String> / {abort.raise} = {
  let head = lines.push("").push(indent() ++ m.signature);
  let words = if whole { m.doc } else {
    let s = summary_of(m.doc);
    if s == "" { [] } else { [s] }
  };
  words.fold(head, |accumulator: List<String>, l: String| accumulator.push(doc_line(l)))
}

fn doc_line(l: String) -> String = if l == "" { "" } else { indent() ++ indent() ++ l }

pub fn page_text(style: Style, p: LocatedPage) -> List<String> / {abort.raise} = {
  let page = p.page;
  let head = page.doc.fold(
    ["", indent() ++ bold(style, page.signature)],
    |accumulator: List<String>, l: String| accumulator.push(doc_line(l)),
  );
  let clauses = page.clauses.fold(head, |accumulator: List<String>, c: String|
    accumulator.push(indent() ++ indent() ++ dim(style, c)));
  let members = page.members.fold(clauses, |accumulator: List<String>, m: Member|
    member_lines(page.kind != "module", m, accumulator));
  let stood = with_field(style, "at", p.location, members.push(""));
  let touched = with_field(style, "effects", page.effects.map(braced), stood);
  let hashed = with_field(style, "hash", page.hash, touched);
  let lawed = with_names(style, "laws", page.laws, hashed);
  let kinded = match p.location {
    Some(_) -> lawed,
    None -> lawed.push(indent() ++ dim(style, "kind") ++ " " ++ page.kind),
  };
  kinded.push("")
}

fn page_output(style: Style, p: LocatedPage) -> CommandOutput / {abort.raise} =
  { json: page_json(p), lines: page_text(style, p), errs: [], code: ok_code() }

fn lookup_outside_program(
  style: Style,
  query: String,
  places: List<SourceText>,
  fallback: List<Diagnostic>,
  more: List<Diagnostic>,
) -> CommandOutput / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} =
  match outside_program(query) {
    Found(p) -> page_output(style, p),
    Ambiguous(names) -> reported(style, "doc", [unknown_name(query, names)], places),
    NotFound -> if fallback.len() > 0 { rejected(style, "doc", fallback, places) }
    else { reported(style, "doc", [unknown_name(query, [])].concat(more), places) },
  }

pub fn without_project(
  flags: Flags,
  nowhere: Diagnostic,
) -> CommandOutput / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} =
  lookup_outside_program(style_of(flags), flags.query, [], [], [nowhere])

pub fn run(
  flags: Flags,
) -> CommandOutput / {shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, time.elapsed_ms, Derives, abort.raise, diverges, shipped.report_view_used} = {
  let s = style_of(flags);
  if is_shipped(Bytes::of_string(flags.query)) {
    lookup_outside_program(s, flags.query, [], [], [])
  } else {
    let project = load_resolved(flags.paths);
    let loaded: Program = timed_over(
      flags.paths,
      project,
      time.elapsed_ms(),
      flags.verify_dependencies,
    ).program;
    match loaded.frame {
      None -> lookup_outside_program(s, flags.query, loaded.source_texts, loaded.diagnostics, []),
      Some(frame) -> match lookup_in_program(flags, project, loaded, frame) {
        Found(p) -> page_output(s, p),
        Ambiguous(names) ->
          reported(s, "doc", [unknown_name(flags.query, names)], loaded.source_texts),
        NotFound -> lookup_outside_program(s, flags.query, loaded.source_texts, [], []),
      },
    }
  }
}

test "a doc comment's summary is its first sentence, taken from its first paragraph with the lines joined into one" {
  assert_eq(
    summary_of(["The bound a fresh server starts with.", "It is positive."]),
    "The bound a fresh server starts with.",
  );
  assert_eq(
    summary_of(["One line that runs on", "to a second, and stops", "", "Then more."]),
    "One line that runs on to a second, and stops",
  );
  assert_eq(summary_of(["`1.5` is not `1.50`. Equal, though."]), "`1.5` is not `1.50`.");
  assert_eq(summary_of([]), "")
}

test "a builtin prints with the parameter names and the doc the prelude declares" {
  match builtin_page("Array::of_list") {
    None -> panic("`Array::of_list` is a builtin"),
    Some(page) -> {
      assert_eq(page.kind, "builtin");
      assert_eq(page.signature, "Array::of_list<a>(xs: List<a>) -> Array<a>")
    },
  };
  assert_eq(
    ["List::map", "List::at", "List::push"].map(|n: String|
      match builtin_page(n) { Some(_) -> true, None -> false }),
    [false, false, false],
  );
  match builtin_page("Array::at") {
    None -> panic("`Array::at` is a builtin"),
    Some(page) -> assert_eq(page.doc, ["`None` if `i` is negative or past the end."]),
  };
  match builtin_page("List::len") {
    None -> panic("`List::len` is a builtin"),
    Some(page) -> assert_eq(page.signature, "List::len<a>(xs: List<a>) -> Int"),
  };
  match builtin_page("Bytes::at") {
    None -> panic("`Bytes::at` is a builtin"),
    Some(page) ->
      assert_eq(page.clauses, [
        "requires 0 <= i && i < Bytes::len(b)",
        "ensures 0 <= result && result <= 255",
      ]),
  };
  assert_eq(match builtin_page("nothing_here") { Some(_) -> true, None -> false }, false)
}

test "a name nothing declares is `E0101`, and an ambiguous one says which" {
  assert_eq(unknown_name("nothing_here", []).code, b"E0101");
  let many = unknown_name("total", ["a.total", "b.total (effect)"]);
  assert_eq(many.message, b"`total` names 2 definitions");
  assert_eq(many.notes_text, [b"one of: a.total, b.total (effect)"])
}

fn two_modules() -> List<ModulePage> =
  pages_of([b"a", b"b"], [
    {
      pages: [
        bare_page("module", "a", "a"),
        { ..bare_page("definition", "a.total", "fn total() -> Int"), simple: "total" },
        {
          ..bare_page("operation", "a.ledger.record", "write record() -> Unit"),
          simple: "ledger.record",
        },
      ],
    },
    {
      pages: [
        bare_page("module", "b", "b"),
        { ..bare_page("effect", "b.total", "effect total"), simple: "total" },
      ],
    },
  ])

test "a query finds a page by its full name, or by a short name that only one page has" {
  let named = |query: String|
    match find_page(two_modules(), query) { Ok(h) -> [h.page.name], Err(names) -> names };
  assert_eq(named("a.total"), ["a.total"]);
  assert_eq(named("b"), ["b"]);
  assert_eq(named("ledger.record"), ["a.ledger.record"]);
  assert_eq(named("total"), ["a.total", "b.total (effect)"]);
  assert_eq(named("nothing_here"), []);
  assert_eq(modules_enclosing([b"a", b"ab", b"a.b"], b"a.b.c"), [b"a", b"a.b"])
}

test "a page with no source location prints its kind instead of a location" {
  let page: Page = {
    ..bare_page("builtin", "List::len", "List::len<a>(xs: List<a>) -> Int"),
    ty: "<a>(List<a>) -> Int",
    params: [{ name: "xs", ty: "List<a>" }],
  };
  assert_eq(page_text(plain(), unlocated_page(page)), [
    "",
    "   List::len<a>(xs: List<a>) -> Int",
    "",
    "   kind builtin",
    "",
  ])
}

test "a module lists each member by summary, and a type gives each member its whole doc" {
  let members = [
    { kind: "definition", name: "one", signature: "pub fn one() -> Int", doc: ["One. And more."] },
  ];
  assert_eq(
    page_text(plain(), {
      page: { ..bare_page("module", "m", "m"), members: members },
      module: None,
      location: Some("m.ply"),
    }),
    ["", "   m", "", "   pub fn one() -> Int", "      One.", "", "   at m.ply", ""],
  );
  assert_eq(
    page_text(plain(), {
      page: { ..bare_page("type", "m.T", "type T"), members: members },
      module: Some("m"),
      location: Some("m.ply:1:1"),
    }),
    [
      "",
      "   type T",
      "",
      "   pub fn one() -> Int",
      "      One. And more.",
      "",
      "   at m.ply:1:1",
      "",
    ],
  )
}

test "a page shows its `laws` and its source location as file, line and column" {
  let h: ModulePage = {
    module: b"m",
    page: {
      ..bare_page("definition", "m.twice", "pub fn twice(n: Int) -> Int"),
      simple: "twice",
      at: 12,
      laws: ["twice doubles"],
    },
  };
  let p = locate_page(h, "m.ply", b"// a line\n  fn twice");
  assert_eq(p.module, Some("m"));
  assert_eq(p.location, Some("m.ply:2:3"));
  assert_eq(page_text(plain(), p), [
    "",
    "   pub fn twice(n: Int) -> Int",
    "",
    "   at m.ply:2:3",
    "   laws \"twice doubles\"",
    "",
  ])
}

test "the prelude's page lists every builtin function, followed by the members defined in Ply source" {
  let own = { kind: "definition", name: "List::map", signature: "pub fn List::map", doc: [] };
  match with_natives(
      Found(
        unlocated_page({ ..bare_page("module", "std.prelude", "std.prelude"), members: [own] }),
      ),
    ) {
    Found(p) -> {
      let kinds = p.page.members.map(|m: Member| m.kind);
      assert_eq(kinds.filter(|k: String| k == "builtin").len(), natives().len());
      assert_eq(p.page.members.at(p.page.members.len() - 1), Some(own));
      let at = p.page.members.filter(|m: Member| m.name == "Array::at");
      assert_eq(at.map(|m: Member| m.doc), [["`None` if `i` is negative or past the end."]])
    },
    _ -> panic("the prelude's page is found"),
  }
}
