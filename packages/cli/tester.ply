//! What `ply test` asks of the runtime, over the capability `std.machine` lends: a unit per program
//! its tests run in, the binding over the run, the cases a test ranges over, and one test or one
//! interleaving of one, on whichever thread asks. Which root a test is, what it is handed, what its
//! answer or its failure means and how a report classes it are this module's; the runtime enters a
//! root and says how the entry ended. The run's state is values a run holds, so its lanes share
//! nothing and run at once.

import compiler.load (LoadedAnalysis)
import compiler.front.rows (Dump, EmitterRoot, ModuleSpan, TestRow)
import compiler.store.hash.forms (ModuleHashes, ReachableHashes)
import compiler.emit.keys (TestCases, root_name, root_text, test_key)
import compiler.check.resolve.tables (Diag, Label)
import diagnostic (RuntimeDiagnostic, diag_of)
import host_listing
import host_listing (Listing, no_disclosures)
import machine
import sim.plan (Seed)
import sim.recording (Interleaving, Passed, Failed)
import std.bin
import std.json (Json, Bool, Number, Object, Str, object, int)
import std.list
import std.machine as entering
import std.value (Value, VUnit, VInt, VBytes, VRecord, VStr, VList, field_named)
import std.value
import testing.conclude (Filing)
import std.cli (Parsed, has, parse_nat, value)
import surface
import surface (Shard, parsed)
import units
import units (emit)

/// What a run of tests is configured with beyond the shared flags: what the run selects, how it
/// searches and reports, and in `machine` the clock, the profile and what of the host each test is
/// lent.
pub type Options = {
  /// `--shard K/N`: of the tests the rest selects, those whose key hashes into part K.
  shard: Option<Shard>,
  jobs: Option<Int>,
  coverage: Bool,
  mutate: Option<String>,
  mutate_budget: Int,
  machine: machine::Options,
  sim: machine::SimulationOptions,
}

/// The options record, built from the parsed line.
pub fn options_from(p: Parsed) -> Options / {abort.raise} = {
  let count = |long: String, default: Int|
    match value(p, long) {
      Some(v) -> match parse_nat(v) { Some(n) -> n, None -> 0 },
      None -> default,
    };
  {
    shard: match value(p, "shard") { Some(v) -> surface::shard_of(v), None -> None },
    jobs: match value(p, "jobs") { Some(v) -> parse_nat(v), None -> None },
    coverage: has(p, "coverage"),
    mutate: value(p, "mutate"),
    mutate_budget: count("mutate-budget", 64),
    machine: machine::options_from(p),
    sim: machine::sim_options_from(p),
  }
}

/// A run of tests: its options, the binding its hosted units run under (0 until it is bound), and
/// the operations the binding serves against the program.
pub type TestRun = { options: Options, binding: Int, listing: Listing }

/// A program tests run in: its unit, none for a run that executes nothing; the run it belongs to;
/// whether its tests reach the binding; its tests; and where each root it is entered at is written,
/// which a failure's sites are offsets from.
pub type TestUnit = {
  opened: Option<entering::LoadedUnit>,
  testing: TestRun,
  hosted: Bool,
  tests: List<TestRow>,
  roots: Map<Bytes, ModuleSpan>,
}

/// A run begun over `options`, bound to nothing yet.
pub fn start_run(options: Options) -> TestRun =
  { options: options, binding: 0, listing: { rows: [], handlers: 0 } }

/// A unit that opens nothing, for a run that runs no test.
pub fn no_unit(testing: TestRun) -> TestUnit =
  { opened: None, testing: testing, hosted: false, tests: [], roots: Map::new() }

/// A unit tests run in, from a front end the program ran: its C emitted and compiled here under
/// the run's profile and opened.
pub fn unit_over(
  testing: TestRun,
  front: LoadedAnalysis,
) -> Result<TestUnit, List<Diag>> / {entering::machine.open, emit.unit, emit.compiled, abort.raise} =
  match units::wanted_library(front, true, testing.options.machine.profile) {
    Err(diags) -> Err(diags),
    Ok(library) -> unit_of(testing, front, library, true),
  }

/// A unit tests run in, from a front end and the library its unit was compiled into, if any.
pub fn unit_of(
  testing: TestRun,
  front: LoadedAnalysis,
  library: Option<String>,
  hosted: Bool,
) -> Result<TestUnit, List<Diag>> / {entering::machine.open, abort.raise} = {
  let made = |opened: Option<entering::LoadedUnit>|
    {
      opened: opened,
      testing: testing,
      hosted: hosted,
      tests: front.dump.tests,
      roots: machine::roots_of(front.dump),
    };
  match library {
    None -> Ok(made(None)),
    Some(path) -> match entering::machine.open(path) {
      Ok(opened) -> Ok(made(Some(opened))),
      Err(why) -> Err([machine::unit_load_error(why)]),
    },
  }
}

/// The binding over the run's tests, answering `config` as the program resolved it.
pub fn bound(
  testing: TestRun,
  d: Dump,
  config: machine::RunConfiguration,
) -> Result<TestRun, List<Diag>> / {entering::machine.bind, entering::machine.hosting, abort.raise} = {
  let grants = grants_of(testing.options.machine, config);
  let declared = host_listing::declared_of(d);
  match host_listing::allow_error(grants.allow, declared) {
    Some(refused) -> Err([refused]),
    None -> {
      let hosting = entering::machine.hosting(grants);
      if hosting.refusals.len() > 0 { Err(hosting.refusals.map(machine::unplaced)) } else {
        match entering::machine.bind(grants) {
          Ok(binding) ->
            Ok({
              ..testing,
              binding: binding,
              listing: host_listing::listing_of(declared, host_listing::performed_atoms(d)),
            }),
          Err(refused) -> Err(refused.map(machine::unplaced)),
        }
      }
    },
  }
}

/// `unit` goes; no test runs in it again.
pub fn close_unit(unit: TestUnit) -> Unit / {entering::machine.close} =
  match unit.opened { Some(o) -> entering::machine.close(o.unit), None -> () }

/// The first read a pass's trace holds that no longer answers as it did, as a person reads it: a
/// configuration key against `supplied`.
pub fn stale_read(
  options: Options,
  supplied: machine::RunConfiguration,
  trace: Bytes,
) -> Option<String> / {entering::machine.changed_read, abort.raise} =
  entering::machine.changed_read(grants_of(options.machine, supplied), trace)

/// What a test is lent: its roots, the programs it may start, its credentials, its configuration
/// and the families `--allow` names, never the command line, and of `process` only what starts a
/// program `--exec` names, since a test is no process.
pub fn grants_of(o: machine::Options, config: machine::RunConfiguration) -> entering::Grants =
  {
    ..entering::no_grants(),
    fs: o.fs.map(machine::granted_path),
    exec: o.exec.map(machine::granted_path),
    allow: o.allow,
    spawning: true,
    given: machine::given_of(o.tls, o.trust, o.mtls, config).push({
      name: "trace",
      fields: ["off", "info"],
    }),
  }

/// How a test of `unit` is entered: as a test's run, under the run's clock, its reads recorded
/// for its pass. A unit no test of reaches the binding, such as a mutant's, files no pass, so
/// nothing records what it read.
fn run_of(unit: TestUnit, seed: Option<entering::Seed>, re_executed: Bool) -> entering::Run =
  {
    ..entering::unbounded(),
    binding: if unit.hosted { unit.testing.binding } else { 0 },
    hosted: unit.hosted,
    timeout_ms: unit.testing.options.machine.timeout,
    seed: seed,
    re_executed: re_executed,
    observe: unit.hosted,
    measure: true,
    tested: true,
  }

/// The cases a test of the unit ranges over, in its table's order, or why they could not be listed.
/// A listing performs nothing, so it reaches no binding and reads nothing a pass stands on.
pub fn cases(
  unit: TestUnit,
  index: Int,
) -> Result<List<ListedCase>, ListingFailure> / {entering::machine.enter, abort.raise} =
  match ((unit.opened, unit.tests.at(index))) {
    (None, _) -> Err({ status: "panicked", failure: nothing_built() }),
    (_, None) -> Err({ status: "panicked", failure: no_test(index, unit.tests.len()) }),
    (Some(o), Some(t)) -> {
      let listing = String::of_bytes_lossy(
        root_text(root_name(TestCases(test_key(t.module, t.name)))),
      );
      let outcome = entering::machine.enter(o.unit, listing, machine::arguments_of([]), {
        ..entering::unbounded(),
        timeout_ms: unit.testing.options.machine.timeout,
      });
      match outcome.ended {
        entering::Returned(bytes) -> match decoded_cases(bytes) {
          Some(listed) -> Ok(listed),
          None -> Err({ status: "panicked", failure: unexpected_result(listing, bytes) }),
        },
        other -> {
          let fell = ended_failure(unit, other, listing, index);
          Err({ status: fell.status, failure: fell.failure })
        },
      }
    },
  }

/// A test run once: over cases, the one `case` names.
pub fn execute(
  unit: TestUnit,
  index: Int,
  case: Option<SelectedCase>,
) -> ExecutionResult / {entering::machine.enter, abort.raise} =
  match entered(unit, index, case, None, false) {
    Err(refused) -> { status: "panicked", failure: Some(refused), usage: no_usage(), trace: None },
    Ok(e) -> {
      let fell = failure_of(unit, e.outcome, e.root, index);
      {
        status: match fell { Some(f) -> f.status, None -> "passed" },
        failure: match fell { Some(f) -> Some(f.failure), None -> None },
        usage: usage_of(unit, e.outcome),
        trace: e.outcome.trace,
      }
    },
  }

/// One interleaving of a seeded test, the one `seed` names: over cases, of the one `case` names.
pub fn run_interleaving(
  unit: TestUnit,
  index: Int,
  case: Option<SelectedCase>,
  seed: Seed,
  steps: Int,
  re_executed: Bool,
) -> InterleavingRun / {entering::machine.enter, abort.raise} = {
  let seeded = { root: seed.root, path: seed.path, steps: max(steps, 1) };
  match entered(unit, index, case, Some(seeded), re_executed) {
    Err(refused) ->
      {
        run: {
          steps: [],
          verdict: Failed({ status: "panicked", failure: refused }),
          virtual_time: 0,
        },
        observed: false,
        usage: no_usage(),
        trace: None,
      },
    Ok(e) -> {
      let verdict = match failure_of(unit, e.outcome, e.root, index) {
        Some(f) -> Failed(f),
        None -> Passed,
      };
      {
        run: match e.outcome.interleaving {
          Some(i) ->
            {
              steps: i.steps.map(|s: entering::Step| machine::step_of(s, unit.roots)),
              verdict: verdict,
              virtual_time: i.virtual_time,
            },
          None -> { steps: [], verdict: verdict, virtual_time: 0 },
        },
        observed: e.outcome.interleaving != None,
        usage: usage_of(unit, e.outcome),
        trace: e.outcome.trace,
      }
    },
  }
}

/// A test's entry: its root and what the entry came to, or why nothing could be entered.
fn entered(
  unit: TestUnit,
  index: Int,
  case: Option<SelectedCase>,
  seed: Option<entering::Seed>,
  re_executed: Bool,
) -> Result<{ root: String, outcome: entering::Outcome }, RuntimeDiagnostic> / {entering::machine.enter, abort.raise} =
  match ((unit.opened, unit.tests.at(index))) {
    (None, _) -> Err(nothing_built()),
    (_, None) -> Err(no_test(index, unit.tests.len())),
    (Some(o), Some(t)) -> {
      let root = String::of_bytes_lossy(root_text(root_name(test_key(t.module, t.name))));
      let arguments = match case {
        None -> machine::arguments_of([]),
        Some(c) -> machine::arguments_of([VInt(c.at), VBytes(c.identity)]),
      };
      let run = run_of(unit, seed, re_executed);
      Ok({ root: root, outcome: entering::machine.enter(o.unit, root, arguments, run) })
    },
  }

/// How a run of a test fell, where it did not pass: a test answers `()` and leaves no object of its
/// own live, and any other answer, an object left live, a root the unit is not entered at or a
/// Rust unwind is Ply's defect at the test's source.
fn failure_of(
  unit: TestUnit,
  o: entering::Outcome,
  root: String,
  index: Int,
) -> Option<InterleavingFailure> / {abort.raise} =
  match o.ended {
    entering::Returned(bytes) -> if bytes != encoded_unit() {
      Some({ status: "panicked", failure: unexpected_result(root, bytes) })
    } else if o.usage.live > 0 {
      Some({ status: "panicked", failure: leaked(unit, index, o.usage.live) })
    } else { None },
    other -> Some(ended_failure(unit, other, root, index)),
  }

fn ended_failure(
  unit: TestUnit,
  ended: entering::Termination,
  root: String,
  index: Int,
) -> InterleavingFailure / {abort.raise} =
  match ended {
    entering::Failed(f) -> {
      let raised = machine::locate_failure(f, unit.roots, root);
      { status: status_of(raised.diag), failure: raised }
    },
    entering::Panicked(message) -> { status: "panicked", failure: panicked(unit, index, message) },
    entering::NoRoot -> { status: "panicked", failure: not_compiled(root) },
    entering::UnencodableResult(why) ->
      { status: "panicked", failure: unexpected_result(root, Bytes::of_string(why)) },
    entering::Returned(bytes) -> { status: "panicked", failure: unexpected_result(root, bytes) },
  }

/// How a report classes a run that ended with `diag`.
pub fn status_of(diag: Diag) -> String =
  if machine::is_abandoned(diag.code) { "abandoned" }
  else if machine::is_defect(diag.code) { "panicked" }
  else { "failed" }

fn usage_of(unit: TestUnit, o: entering::Outcome) -> Usage / {abort.raise} =
  {
    duration_us: o.usage.nanos / 1000,
    host: o.usage.host,
    entries: match o.ended { entering::NoRoot -> 0, _ -> 1 },
    performs: o.usage.performs,
    teardown: machine::warnings_of(o, unit.roots),
  }

/// What a test answers: the PLV1 of `()`.
fn encoded_unit() -> Bytes = match value::encode(VUnit) { Some(b) -> b, None -> b"" }

/// The cases a listing answered: each case's label and identity, in its table's order.
fn decoded_cases(bytes: Bytes) -> Option<List<ListedCase>> / {abort.raise} =
  match value::decode(bytes) {
    Some(VList(items)) ->
      items.fold(Some([]), |acc: Option<List<ListedCase>>, item: Value|
        match ((acc, item)) {
          (Some(xs), VRecord(fields)) -> match ((
              field_named(fields, "label"),
              field_named(fields, "identity"),
            )) {
            (Some(VStr(label)), Some(VBytes(identity))) ->
              Some(xs.push({ label: label, identity: identity })),
            _ -> None,
          },
          _ -> None,
        }),
    _ -> None,
  }

/// The binding torn down once the run's hosted tests ran: the TLS handshakes it made, as a run
/// prints them.
pub fn unbind(testing: TestRun) -> List<String> / {entering::machine.unbind, abort.raise} =
  if testing.binding == 0 { [] }
  else { host_listing::handshake_lines(entering::machine.unbind(testing.binding)) }

/// What the binding and the run's unit came to.
pub fn binding_report_of(testing: TestRun, unit: TestUnit) -> BindingReport / {abort.raise} = {
  let disclosures = no_disclosures();
  let digest = host_listing::digest_of(testing.listing, disclosures);
  {
    operations: testing.listing.rows.len(),
    digest: digest,
    hosts: object([
      { key: "handlers", value: int(testing.listing.handlers) },
      { key: "operations", value: int(testing.listing.rows.len()) },
      { key: "digest", value: Str(digest) },
    ]),
    reaches: range(0, unit.tests.len()).filter(|i: Int|
      match unit.tests.at(i) {
        Some(t) -> host_listing::reaches_host(testing.listing, t.footprint),
        None -> false,
      }),
    cores: match unit.opened { Some(o) -> o.threads, None -> 1 },
    backend: {
      name: "c",
      fragment: match unit.opened { Some(o) -> o.roots, None -> 0 },
      units: match unit.opened { Some(_) -> Some(1), None -> None },
      load_nanos: match unit.opened { Some(o) -> Some(o.nanos), None -> None },
    },
  }
}

/// The result cache, which whoever opened it handles: what opening it degraded past, the pass filed
/// under each key and each code key as the trace its run read, whether each definition was ever
/// seen, what each test reached when it last passed, and the text of each definition it reached.
pub effect result_cache {
  read open_warnings() -> List<Diag>
  read passes(keys: List<Bytes>) -> List<Option<Bytes>>
  read code_passes(keys: List<Bytes>) -> List<Option<Bytes>>
  read known(hashes: List<Bytes>) -> List<Bool>
  read baselines(keys: List<Bytes>) -> List<Option<LastPass>>
  /// The text of each definition or test, by its hash, as it read when it was filed.
  read texts(hashes: List<Bytes>) -> List<Option<Bytes>>
  /// Of `hashes`, those the store holds no text of.
  read unstored(hashes: List<Bytes>) -> List<Bytes>
  /// What a filed pass ran, as a later failure reads it: each text by its hash, and the era of
  /// `modules`, each module's record among it.
  write history(texts: List<{ hash: Bytes, text: Bytes }>, modules: List<ModuleHashes>) -> Unit
  write store_filing(filing: Filing) -> StoreResult
}

/// What a test last passed against: its hash then, and each definition it reached then by name with
/// its hash then.
pub type LastPass = { test: Bytes, reached: ReachableHashes }

/// What running a test, or one interleaving of it, cost and reached, whatever it decided. `host` is
/// whether it reached a host handler, so that running it again acts on the world again.
pub type Usage = {
  duration_us: Int,
  host: Bool,
  /// Roots the unit was entered at.
  entries: Int,
  /// The operations it performed, handled ones included.
  performs: Int,
  /// The warnings the entry ended with.
  teardown: List<Diag>,
}

/// How one run of a test ended: `passed`, `failed`, `panicked` or `abandoned`; and what it read,
/// which its pass is filed with, `None` when no trace stands in for the run.
pub type ExecutionResult = {
  status: String,
  failure: Option<RuntimeDiagnostic>,
  usage: Usage,
  trace: Option<Bytes>,
}

/// A case as its test lists it: the label it is reported under, and BLAKE3 of its value as built.
pub type ListedCase = { label: String, identity: Bytes }

derive bin for ListedCase

/// A case as a run names it: its place in the table, and the identity the table is held to there.
pub type SelectedCase = { at: Int, identity: Bytes }

/// Why a test's cases could not be listed, and how a report classes it: `status` is `failed`,
/// `panicked` or `abandoned`.
pub type ListingFailure = { status: String, failure: RuntimeDiagnostic }

/// A failing interleaving's failure, and how a report classes it.
pub type InterleavingFailure = { status: String, failure: RuntimeDiagnostic }

/// `observed` is whether the test entered a `simulate` region, and so had a schedule to vary.
pub type InterleavingRun = {
  run: Interleaving<InterleavingFailure>,
  observed: Bool,
  usage: Usage,
  trace: Option<Bytes>,
}

/// The first unit the run's tests ran in: how many roots it is entered at, and where a clock read
/// it, how many units were opened and the nanoseconds that took.
pub type CompiledUnit = { name: String, fragment: Int, units: Option<Int>, load_nanos: Option<Int> }

/// The binding a run had, and the tests of the first unit it reaches.
pub type BindingReport = {
  operations: Int,
  digest: String,
  hosts: Json,
  reaches: List<Int>,
  cores: Int,
  backend: CompiledUnit,
}

/// Why writing to the store failed, when it did, and what the store had to say.
pub type StoreResult = { unflushed: Option<String>, warnings: List<Diag> }

pub fn no_usage() -> Usage = { duration_us: 0, host: false, entries: 0, performs: 0, teardown: [] }

/// What two runs of one test read between them: every line of either, sorted, as a trace is. `None`
/// when either has no trace to stand in for it.
pub fn joined_trace(a: Option<Bytes>, b: Option<Bytes>) -> Option<Bytes> =
  match ((a, b)) {
    (Some(x), Some(y)) -> if x == y { Some(x) } else {
      let held = |m: Map<String, Bool>, t: Bytes|
        String::of_bytes_lossy(t).split("\n").fold(m, |n: Map<String, Bool>, line: String|
          if line == "" { n } else { n.insert(line, true) });
      let lines = held(held(Map::new(), x), y);
      Some(Bytes::of_string(lines.keys().fold("", |acc: String, line: String| acc ++ line ++ "\n")))
    },
    _ -> None,
  }

/// Two runs' costs, as one test that ran both.
pub fn sum_usage(a: Usage, b: Usage) -> Usage =
  {
    duration_us: a.duration_us + b.duration_us,
    host: a.host || b.host,
    entries: a.entries + b.entries,
    performs: a.performs + b.performs,
    teardown: b.teardown.fold(a.teardown, |acc: List<Diag>, diag: Diag| acc.push(diag)),
  }

// --- What a failure says -----------------------------------------------------------

fn defect(message: String, labels: List<Label>, notes: List<String>) -> RuntimeDiagnostic =
  { diag: diag_of("error", "E0505", message, labels, notes), values: [] }

fn nothing_built() -> RuntimeDiagnostic =
  defect("a test was run in a unit built to run nothing, so no backend was compiled for it", [], [
    "this is Ply's fault: the run named no test to run and the program ran one anyway",
  ])

fn no_test(index: Int, tests: Int) -> RuntimeDiagnostic =
  defect(
    "no test at index " ++ index.to_string() ++ "; the program defines " ++ tests.to_string(),
    [],
    ["this is Ply's fault, not the program's"],
  )

fn not_compiled(root: String) -> RuntimeDiagnostic =
  defect("the unit is entered at no `" ++ root ++ "`", [], [
    "a unit holds every root it is offered, so this is the seam rather than the body",
    "this is Ply's fault, not the program's",
  ])

/// A root that answered what it never answers: a test answers `()`, and a listing its cases.
fn unexpected_result(root: String, bytes: Bytes) -> RuntimeDiagnostic / {abort.raise} =
  {
    diag: diag_of(
      "error",
      "E0505",
      "`" ++ root ++ "` answered `" ++ String::of_bytes_lossy(b"\x010\x02") ++ "`",
      [],
      [
        "the checker refuses a test whose body is not `Unit` with E0201, so no test can answer one",
        "this is Ply's fault, not the program's",
      ],
    ),
    values: match value::decode(bytes) { Some(v) -> [v], None -> [VBytes(bytes)] },
  }

/// The test at `index` answered and left `n` objects of its own live: a defect in Ply, which lets go
/// of every value once nothing holds it, placed at the test.
fn leaked(unit: TestUnit, index: Int, n: Int) -> RuntimeDiagnostic = {
  let left = n.to_string() ++ (if n == 1 { " object" } else { " objects" }) ++ " live as it ended";
  match unit.tests.at(index) {
    Some(t) ->
      defect(
        "test `" ++ String::of_bytes_lossy(t.key) ++ "` left " ++ left,
        [
          {
            module: t.at.module,
            start: t.at.start,
            end: t.at.end,
            primary: true,
            text: b"what this test made was not all let go",
          },
        ],
        [
          "Ply lets go of every value once nothing holds it, so a value left live leaked",
          "this is Ply's fault, not the program's",
        ],
      ),
    None -> defect("test " ++ index.to_string() ++ " left " ++ left, [], []),
  }
}

/// The runtime unwound running the test at `index`: a defect in Ply, placed at the test.
fn panicked(unit: TestUnit, index: Int, message: String) -> RuntimeDiagnostic =
  match unit.tests.at(index) {
    Some(t) ->
      defect(
        "test `" ++ String::of_bytes_lossy(t.key) ++ "` panicked: " ++ message,
        [
          {
            module: t.at.module,
            start: t.at.start,
            end: t.at.end,
            primary: true,
            text: b"Ply panicked while running this test",
          },
        ],
        [
          "a panic is a defect in Ply itself, not in the test; please report it with this source",
          "the other tests still ran, and this one was not cached",
        ],
      ),
    None -> defect("test " ++ index.to_string() ++ " panicked: " ++ message, [], []),
  }

// --- Tests ------------------------------------------------------------------

test "two runs' traces join into every line either read, in a trace's order" {
  assert_eq(joined_trace(Some(b"b\ty\n"), Some(b"a\tx\nb\ty\n")), Some(b"a\tx\nb\ty\n"));
  assert_eq(joined_trace(Some(b""), Some(b"")), Some(b""));
  assert_eq(joined_trace(Some(b"a\tx\n"), None), None)
}

test "a run is abandoned by its clock, panics by Ply's defect, and fails by the program's" {
  let d = |code: String| diag_of("error", code, "x", [], []);
  assert_eq(status_of(d("W0612")), "abandoned");
  assert_eq(status_of(d("E0505")), "panicked");
  assert_eq(status_of(d("E0415")), "panicked");
  assert_eq(status_of(d("E0502")), "failed")
}

test "a test is lent its roots, its programs and no command line" {
  let o = options_from(parsed(["test", "--allow", "machine", "--fs", "cwd=."])).machine;
  let lent = grants_of(o, machine::empty_configuration());
  assert(lent.spawning);
  assert_eq(lent.fs, [{ name: "cwd", path: "." }]);
  assert_eq(lent.allow, ["machine"]);
  assert_eq(lent.argv, None)
}

/// A test's run that answered `()` and left `live` objects of its own live.
fn returned_leaving(live: Int) -> entering::Outcome =
  {
    ended: entering::Returned(encoded_unit()),
    exit: None,
    usage: {
      nanos: 0,
      host: false,
      performs: 0,
      native_objects: 0,
      scheduled: 0,
      task_stacks: 0,
      frame_tables: 0,
      updates: 0,
      updates_in_place: 0,
      live: live,
    },
    warnings: [],
    interleaving: None,
    trace: None,
  }

test "a test that answered but left objects of its own live is Ply's defect, saying how many" {
  let unit = no_unit(start_run(options_from(parsed(["test"]))));
  assert_eq(failure_of(unit, returned_leaving(0), "m.t", 0), None);
  match failure_of(unit, returned_leaving(2), "m.t", 0) {
    Some(f) -> {
      assert_eq([f.status, String::of_bytes_lossy(f.failure.diag.code)], ["panicked", "E0505"]);
      assert(String::of_bytes_lossy(f.failure.diag.message).contains("left 2 objects live"), None)
    },
    None -> assert(false, Some("a test that leaked passed")),
  }
}

test "a listing's answer reads as its cases, and anything else as none" {
  let listed = VList([
    VRecord([
      { name: "identity", value: VBytes(b"one") },
      { name: "label", value: VStr("holds 1") },
    ]),
  ]);
  let bytes = match value::encode(listed) { Some(b) -> b, None -> b"" };
  assert_eq(decoded_cases(bytes), Some([{ label: "holds 1", identity: b"one" }]));
  assert_eq(decoded_cases(match value::encode(VInt(1)) { Some(b) -> b, None -> b"" }), None)
}
