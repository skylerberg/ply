import compiler.load (LoadedAnalysis)
import compiler.front.rows (Dump, EmitterRoot, ModuleSpan, TestRow)
import compiler.store.hash.forms (ModuleHashes, ReachableHashes)
import compiler.emit.keys (TestCases, root_name, root_text, test_key)
import compiler.check.resolve.tables (Diagnostic, Label)
import diagnostic (RuntimeDiagnostic, diagnostic_of)
import host_listing
import host_listing (Listing, no_disclosures)
import machine
import sim.plan (Seed)
import sim.recording (Interleaving, Passed, Failed)
import std.bin
import std.json (Json, Bool, Number, Object, Str, object, int)
import std.list
import std.machine as entering
import std.value (Value, VUnit, VInt, VBytes, VRecord, VStr, VList, field_named)
import std.value
import testing.conclude (Filing)
import std.cli (Parsed, has, parse_nat, value)
import surface
import surface (Shard, parsed)

pub type Options = {
  shard: Option<Shard>,
  jobs: Option<Int>,
  coverage: Bool,
  machine: machine::Options,
  sim: machine::SimulationOptions,
}

pub fn options_from(p: Parsed) -> Options / {abort.raise} =
  {
    shard: match value(p, "shard") { Some(v) -> surface::shard_of(v), None -> None },
    jobs: match value(p, "jobs") { Some(v) -> parse_nat(v), None -> None },
    coverage: has(p, "coverage"),
    machine: machine::options_from(p),
    sim: machine::sim_options_from(p),
  }

pub type TestRun = { options: Options, binding: Int, listing: Listing }

pub type TestUnit = {
  opened: Option<entering::LoadedUnit>,
  testing: TestRun,
  hosted: Bool,
  tests: List<TestRow>,
  roots: Map<Bytes, ModuleSpan>,
}

pub fn start_run(options: Options) -> TestRun =
  { options: options, binding: 0, listing: { rows: [], handlers: 0 } }

pub fn empty_test_unit(testing: TestRun) -> TestUnit =
  { opened: None, testing: testing, hosted: false, tests: [], roots: Map::new() }

pub fn unit_of(
  testing: TestRun,
  front: LoadedAnalysis,
  library: Option<String>,
  hosted: Bool,
) -> Result<TestUnit, List<Diagnostic>> / {entering::machine.open} = {
  let made = |opened: Option<entering::LoadedUnit>|
    {
      opened: opened,
      testing: testing,
      hosted: hosted,
      tests: front.dump.tests,
      roots: machine::roots_of(front.dump),
    };
  match library {
    None -> Ok(made(None)),
    Some(path) -> match entering::machine.open(path) {
      Ok(opened) -> Ok(made(Some(opened))),
      Err(reason) -> Err([machine::unit_load_error(reason)]),
    },
  }
}

pub fn bind_test_run(
  testing: TestRun,
  d: Dump,
  config: machine::RunConfiguration,
) -> Result<TestRun, List<Diagnostic>> / {entering::machine.bind, entering::machine.hosting, abort.raise} = {
  let grants = grants_of(testing.options.machine, config);
  let declared = host_listing::declared_of(d);
  match host_listing::allow_error(grants.allow, declared) {
    Some(rejected) -> Err([rejected]),
    None -> {
      let hosting = entering::machine.hosting(grants);
      if hosting.rejections.len() > 0 { Err(hosting.rejections.map(machine::unplaced)) } else {
        match entering::machine.bind(grants) {
          Ok(binding) ->
            Ok({
              ..testing,
              binding: binding,
              listing: host_listing::listing_of(declared, host_listing::performed_effects(d)),
            }),
          Err(rejected) -> Err(rejected.map(machine::unplaced)),
        }
      }
    },
  }
}

pub fn close_unit(unit: TestUnit) -> Unit / {entering::machine.close} =
  match unit.opened { Some(o) -> entering::machine.close(o.unit), None -> () }

pub fn stale_read(
  options: Options,
  supplied: machine::RunConfiguration,
  trace: Bytes,
) -> Option<String> / {entering::machine.changed_read} =
  entering::machine.changed_read(grants_of(options.machine, supplied), trace)

pub fn grants_of(o: machine::Options, config: machine::RunConfiguration) -> entering::Grants =
  {
    ..entering::no_grants(),
    fs: o.fs.map(machine::granted_path),
    exec: o.exec.map(machine::granted_path),
    allow: o.allow,
    spawning: true,
    given: machine::grant_entries(o.tls, o.trust, o.mtls, config).push({
      name: "trace",
      fields: ["off", "info"],
    }),
  }

fn run_of(
  unit: TestUnit,
  seed: Option<entering::Seed>,
  re_executed: Bool,
  label: String,
) -> entering::Run =
  {
    ..entering::unbounded(),
    binding: if unit.hosted { unit.testing.binding } else { 0 },
    hosted: unit.hosted,
    timeout_ms: unit.testing.options.machine.timeout,
    seed: seed,
    re_executed: re_executed,
    observe: unit.hosted,
    measure: true,
    tested: true,
    label: label,
  }

pub fn cases(
  unit: TestUnit,
  index: Int,
) -> Result<List<ListedCase>, ListingFailure> / {entering::machine.enter, abort.raise} =
  match ((unit.opened, unit.tests.at(index))) {
    (None, _) -> Err({ status: "panicked", failure: nothing_built() }),
    (_, None) -> Err({ status: "panicked", failure: no_test(index, unit.tests.len()) }),
    (Some(o), Some(t)) -> {
      let listing = String::of_bytes_lossy(
        root_text(root_name(TestCases(test_key(t.module, t.name)))),
      );
      let outcome = entering::machine.enter(o.unit, listing, machine::arguments_of([]), {
        ..entering::unbounded(),
        timeout_ms: unit.testing.options.machine.timeout,
      });
      match outcome.ended {
        entering::Returned(bytes) -> match decoded_cases(bytes) {
          Some(listed) -> Ok(listed),
          None -> Err({ status: "panicked", failure: unexpected_result(listing, bytes) }),
        },
        other -> {
          let fell = ended_failure(unit, other, listing, index);
          Err({ status: fell.status, failure: fell.failure })
        },
      }
    },
  }

pub fn execute(
  unit: TestUnit,
  index: Int,
  case: Option<SelectedCase>,
) -> ExecutionResult / {entering::machine.enter, abort.raise} =
  match entered(unit, index, case, None, false) {
    Err(rejected) ->
      { status: "panicked", failure: Some(rejected), usage: no_usage(), trace: None },
    Ok(e) -> {
      let fell = failure_of(unit, e.outcome, e.root, index);
      {
        status: match fell { Some(f) -> f.status, None -> "passed" },
        failure: match fell { Some(f) -> Some(f.failure), None -> None },
        usage: usage_of(unit, e.outcome),
        trace: e.outcome.trace,
      }
    },
  }

pub fn run_interleaving(
  unit: TestUnit,
  index: Int,
  case: Option<SelectedCase>,
  seed: Seed,
  steps: Int,
  re_executed: Bool,
) -> InterleavingRun / {entering::machine.enter, abort.raise} = {
  let seeded = { root: seed.root, path: seed.path, steps: max(steps, 1) };
  match entered(unit, index, case, Some(seeded), re_executed) {
    Err(rejected) ->
      {
        run: {
          steps: [],
          verdict: Failed({ status: "panicked", failure: rejected }),
          virtual_time: 0,
        },
        observed: false,
        usage: no_usage(),
        trace: None,
      },
    Ok(e) -> {
      let verdict = match failure_of(unit, e.outcome, e.root, index) {
        Some(f) -> Failed(f),
        None -> Passed,
      };
      {
        run: match e.outcome.interleaving {
          Some(i) ->
            {
              steps: i.steps.map(|s: entering::Step| machine::step_of(s, unit.roots)),
              verdict: verdict,
              virtual_time: i.virtual_time,
            },
          None -> { steps: [], verdict: verdict, virtual_time: 0 },
        },
        observed: e.outcome.interleaving != None,
        usage: usage_of(unit, e.outcome),
        trace: e.outcome.trace,
      }
    },
  }
}

fn entered(
  unit: TestUnit,
  index: Int,
  case: Option<SelectedCase>,
  seed: Option<entering::Seed>,
  re_executed: Bool,
) -> Result<{ root: String, outcome: entering::Outcome }, RuntimeDiagnostic> / {entering::machine.enter, abort.raise} =
  match ((unit.opened, unit.tests.at(index))) {
    (None, _) -> Err(nothing_built()),
    (_, None) -> Err(no_test(index, unit.tests.len())),
    (Some(o), Some(t)) -> {
      let root = String::of_bytes_lossy(root_text(root_name(test_key(t.module, t.name))));
      let arguments = match case {
        None -> machine::arguments_of([]),
        Some(c) -> machine::arguments_of([VInt(c.at), VBytes(c.identity)]),
      };
      let run = run_of(
        unit,
        seed,
        re_executed,
        String::of_bytes_lossy(Bytes::concat_all([t.module, b".", t.name])),
      );
      Ok({ root: root, outcome: entering::machine.enter(o.unit, root, arguments, run) })
    },
  }

fn failure_of(
  unit: TestUnit,
  o: entering::Outcome,
  root: String,
  index: Int,
) -> Option<InterleavingFailure> / {abort.raise} =
  match o.ended {
    entering::Returned(bytes) -> if bytes != encoded_unit() {
      Some({ status: "panicked", failure: unexpected_result(root, bytes) })
    } else if o.usage.live > 0 {
      Some({ status: "panicked", failure: leaked(unit, index, o.usage.live) })
    } else { None },
    other -> Some(ended_failure(unit, other, root, index)),
  }

fn ended_failure(
  unit: TestUnit,
  ended: entering::Termination,
  root: String,
  index: Int,
) -> InterleavingFailure / {abort.raise} =
  match ended {
    entering::Failed(f) -> {
      let raised = machine::locate_failure(f, unit.roots, root);
      { status: status_of(raised.diagnostic), failure: raised }
    },
    entering::Panicked(message) -> { status: "panicked", failure: panicked(unit, index, message) },
    entering::NoRoot -> { status: "panicked", failure: not_compiled(root) },
    entering::UnencodableResult(reason) ->
      { status: "panicked", failure: unexpected_result(root, Bytes::of_string(reason)) },
    entering::Returned(bytes) -> { status: "panicked", failure: unexpected_result(root, bytes) },
  }

pub fn status_of(diagnostic: Diagnostic) -> String =
  if machine::is_timed_out(diagnostic.code) { "timed_out" }
  else if machine::is_internal_error(diagnostic.code) { "panicked" }
  else { "failed" }

fn usage_of(unit: TestUnit, o: entering::Outcome) -> Usage / {abort.raise} =
  {
    duration_us: o.usage.nanos / 1000,
    used_host: o.usage.host,
    entries: match o.ended { entering::NoRoot -> 0, _ -> 1 },
    performs: o.usage.performs,
    teardown: machine::warnings_of(o, unit.roots),
  }

fn encoded_unit() -> Bytes = match value::encode(VUnit) { Some(b) -> b, None -> b"" }

fn decoded_cases(bytes: Bytes) -> Option<List<ListedCase>> =
  match value::decode(bytes) {
    Some(VList(items)) ->
      items.fold(Some([]), |accumulator: Option<List<ListedCase>>, item: Value|
        match ((accumulator, item)) {
          (Some(xs), VRecord(fields)) -> match ((
              field_named(fields, "label"),
              field_named(fields, "identity"),
            )) {
            (Some(VStr(label)), Some(VBytes(identity))) ->
              Some(xs.push({ label: label, identity: identity })),
            _ -> None,
          },
          _ -> None,
        }),
    _ -> None,
  }

pub fn unbind(testing: TestRun) -> List<String> / {entering::machine.unbind, abort.raise} =
  if testing.binding == 0 { [] }
  else { host_listing::handshake_lines(entering::machine.unbind(testing.binding)) }

pub fn binding_report_of(testing: TestRun, unit: TestUnit) -> BindingReport / {abort.raise} = {
  let disclosures = no_disclosures();
  let digest = host_listing::digest_of(testing.listing, disclosures);
  {
    operations: testing.listing.rows.len(),
    digest: digest,
    hosts: object([
      { key: "handlers", value: int(testing.listing.handlers) },
      { key: "operations", value: int(testing.listing.rows.len()) },
      { key: "digest", value: Str(digest) },
    ]),
    host_test_indices: range(0, unit.tests.len()).filter(|i: Int|
      match unit.tests.at(i) {
        Some(t) -> host_listing::uses_host(testing.listing, t.effects),
        None -> false,
      }),
    cores: match unit.opened { Some(o) -> o.threads, None -> 1 },
    backend: {
      name: "c",
      fragment: match unit.opened { Some(o) -> o.root_count, None -> 0 },
      units: match unit.opened { Some(_) -> Some(1), None -> None },
      load_nanos: match unit.opened { Some(o) -> Some(o.nanos), None -> None },
    },
  }
}

pub effect result_cache {
  read open_warnings() -> List<Diagnostic>
  read passes(keys: List<Bytes>) -> List<Option<Bytes>>
  read code_passes(keys: List<Bytes>) -> List<Option<Bytes>>
  read known(hashes: List<Bytes>) -> List<Bool>
  read baselines(keys: List<Bytes>) -> List<Option<LastPass>>
  read texts(hashes: List<Bytes>) -> List<Option<Bytes>>
  read unstored(hashes: List<Bytes>) -> List<Bytes>
  write history(texts: List<{ hash: Bytes, text: Bytes }>, modules: List<ModuleHashes>) -> Unit
  write store_filing(filing: Filing) -> StoreResult
}

pub type LastPass = { test: Bytes, reachable: ReachableHashes }

pub type Usage = {
  duration_us: Int,
  used_host: Bool,
  entries: Int,
  performs: Int,
  teardown: List<Diagnostic>,
}

pub type ExecutionResult = {
  status: String,
  failure: Option<RuntimeDiagnostic>,
  usage: Usage,
  trace: Option<Bytes>,
}

pub type ListedCase = { label: String, identity: Bytes }

derive bin for ListedCase

pub type SelectedCase = { at: Int, identity: Bytes }

pub type ListingFailure = { status: String, failure: RuntimeDiagnostic }

pub type InterleavingFailure = { status: String, failure: RuntimeDiagnostic }

pub type InterleavingRun = {
  run: Interleaving<InterleavingFailure>,
  observed: Bool,
  usage: Usage,
  trace: Option<Bytes>,
}

pub type CompiledUnit = { name: String, fragment: Int, units: Option<Int>, load_nanos: Option<Int> }

pub type BindingReport = {
  operations: Int,
  digest: String,
  hosts: Json,
  host_test_indices: List<Int>,
  cores: Int,
  backend: CompiledUnit,
}

pub type StoreResult = { unflushed: Option<String>, warnings: List<Diagnostic> }

pub fn no_usage() -> Usage =
  { duration_us: 0, used_host: false, entries: 0, performs: 0, teardown: [] }

pub fn joined_trace(a: Option<Bytes>, b: Option<Bytes>) -> Option<Bytes> =
  match ((a, b)) {
    (Some(x), Some(y)) -> if x == y { Some(x) } else {
      let add_lines = |m: Map<String, Bool>, t: Bytes|
        String::of_bytes_lossy(t).split("\n").fold(m, |n: Map<String, Bool>, line: String|
          if line == "" { n } else { n.insert(line, true) });
      let lines = add_lines(add_lines(Map::new(), x), y);
      Some(
        Bytes::of_string(
          lines.keys().fold("", |accumulator: String, line: String| accumulator ++ line ++ "\n"),
        ),
      )
    },
    _ -> None,
  }

pub fn sum_usage(a: Usage, b: Usage) -> Usage =
  {
    duration_us: a.duration_us + b.duration_us,
    used_host: a.used_host || b.used_host,
    entries: a.entries + b.entries,
    performs: a.performs + b.performs,
    teardown: b.teardown.fold(
      a.teardown,
      |accumulator: List<Diagnostic>, diagnostic: Diagnostic| accumulator.push(diagnostic),
    ),
  }

fn internal_error(message: String, labels: List<Label>, notes: List<String>) -> RuntimeDiagnostic =
  { diagnostic: diagnostic_of("error", "E0505", message, labels, notes), values: [] }

fn nothing_built() -> RuntimeDiagnostic =
  internal_error(
    "a test was run, but the program was built without any code for running tests",
    [],
    ["this is Ply's fault: the run named no test, yet the program ran a test anyway"],
  )

fn no_test(index: Int, tests: Int) -> RuntimeDiagnostic =
  internal_error(
    "no test at index " ++ index.to_string() ++ "; the number of tests in the program is "
      ++ tests.to_string(),
    [],
    ["this is Ply's fault, not the program's"],
  )

fn not_compiled(root: String) -> RuntimeDiagnostic =
  internal_error("the compiled program has no entry point `" ++ root ++ "`", [], [
    "a compiled program contains every entry point it is asked for, so this is a bug in Ply's test runner, not in the test",
    "this is Ply's fault, not the program's",
  ])

fn unexpected_result(root: String, bytes: Bytes) -> RuntimeDiagnostic =
  {
    diagnostic: diagnostic_of(
      "error",
      "E0505",
      "`" ++ root ++ "` returned `" ++ String::of_bytes_lossy(b"\x010\x02") ++ "`",
      [],
      [
        "the checker rejects a test whose body is not `Unit` with E0201, so no test can return one",
        "this is Ply's fault, not the program's",
      ],
    ),
    values: match value::decode(bytes) { Some(v) -> [v], None -> [VBytes(bytes)] },
  }

fn leaked(unit: TestUnit, index: Int, n: Int) -> RuntimeDiagnostic = {
  let left = n.to_string() ++ (if n == 1 { " object" } else { " objects" })
    ++ " not freed by the end of the test";
  match unit.tests.at(index) {
    Some(t) ->
      internal_error(
        "test `" ++ String::of_bytes_lossy(t.key) ++ "` left " ++ left,
        [
          {
            module: t.at.module,
            start: t.at.start,
            end: t.at.end,
            primary: true,
            text: b"this test did not free everything it created",
          },
        ],
        [
          "Ply frees every value once nothing refers to it, so a value that was not freed is a leak",
          "this is Ply's fault, not the program's",
        ],
      ),
    None -> internal_error("test " ++ index.to_string() ++ " left " ++ left, [], []),
  }
}

fn panicked(unit: TestUnit, index: Int, message: String) -> RuntimeDiagnostic =
  match unit.tests.at(index) {
    Some(t) ->
      internal_error(
        "test `" ++ String::of_bytes_lossy(t.key) ++ "` panicked: " ++ message,
        [
          {
            module: t.at.module,
            start: t.at.start,
            end: t.at.end,
            primary: true,
            text: b"Ply panicked while running this test",
          },
        ],
        [
          "a panic is an internal error in Ply itself, not in the test; please report it with this source",
          "the other tests still ran, and this one was not cached",
        ],
      ),
    None -> internal_error("test " ++ index.to_string() ++ " panicked: " ++ message, [], []),
  }

test "`joined_trace` merges the trace lines of two runs, sorted and without duplicates, and gives `None` if either trace is missing" {
  assert_eq(joined_trace(Some(b"b\ty\n"), Some(b"a\tx\nb\ty\n")), Some(b"a\tx\nb\ty\n"));
  assert_eq(joined_trace(Some(b""), Some(b"")), Some(b""));
  assert_eq(joined_trace(Some(b"a\tx\n"), None), None)
}

test "`status_of` maps a timeout diagnostic to `timed_out`, internal-error diagnostics to `panicked`, and program errors to `failed`" {
  let d = |code: String| diagnostic_of("error", code, "x", [], []);
  assert_eq(status_of(d("W0612")), "timed_out");
  assert_eq(status_of(d("E0505")), "panicked");
  assert_eq(status_of(d("E0415")), "panicked");
  assert_eq(status_of(d("E0502")), "failed")
}

test "a test gets the `--allow` and `--fs` permissions from its command line, but no program arguments" {
  let o = options_from(parsed(["test", "--allow", "machine", "--fs", "cwd=."])).machine;
  let borrowed = grants_of(o, machine::empty_configuration());
  assert(borrowed.spawning);
  assert_eq(borrowed.fs, [{ name: "cwd", path: "." }]);
  assert_eq(borrowed.allow, ["machine"]);
  assert_eq(borrowed.argv, None)
}

fn returned_leaving(live: Int) -> entering::Outcome =
  {
    ended: entering::Returned(encoded_unit()),
    exit: None,
    usage: {
      nanos: 0,
      host: false,
      performs: 0,
      native_objects: 0,
      scheduled: 0,
      task_stacks: 0,
      frame_tables: 0,
      runtime_blocks: 0,
      live: live,
    },
    warnings: [],
    interleaving: None,
    trace: None,
  }

test "a test that returns while still leaving objects allocated is reported as an internal error that gives the number of leaked objects" {
  let unit = empty_test_unit(start_run(options_from(parsed(["test"]))));
  assert_eq(failure_of(unit, returned_leaving(0), "m.t", 0), None);
  match failure_of(unit, returned_leaving(2), "m.t", 0) {
    Some(f) -> {
      assert_eq([f.status, String::of_bytes_lossy(f.failure.diagnostic.code)], [
        "panicked",
        "E0505",
      ]);
      assert(
        String::of_bytes_lossy(f.failure.diagnostic.message).contains(
          "left 2 objects not freed by the end of the test",
        ),
        None,
      )
    },
    None -> assert(false, Some("a test that leaked passed")),
  }
}

test "`decoded_cases` returns the cases from a test-listing result, and `None` for any other value" {
  let listed = VList([
    VRecord([
      { name: "identity", value: VBytes(b"one") },
      { name: "label", value: VStr("holds 1") },
    ]),
  ]);
  let bytes = match value::encode(listed) { Some(b) -> b, None -> b"" };
  assert_eq(decoded_cases(bytes), Some([{ label: "holds 1", identity: b"one" }]));
  assert_eq(decoded_cases(match value::encode(VInt(1)) { Some(b) -> b, None -> b"" }), None)
}
