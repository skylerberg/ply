pub type SealedArtifact = { bytes: Bytes, digest: String, full: Bytes }

fn seal(container: Bytes) -> Result<SealedArtifact, Rejection> / {abort.raise} =
  seal_in_domain(container, domain)

fn seal_in_domain(
  container: Bytes,
  into: Bytes,
) -> Result<SealedArtifact, Rejection> / {abort.raise} =
  match digest_of(into, container) {
    None ->
      Err({
        diagnostics: [
          error_with_labels(
            b"E0443",
            Bytes::of_string(
              "a program file of " ++ container.len().to_string()
                ++ " bytes is too small to contain a digest",
            ),
            [],
            [],
          ),
        ],
        places: [],
      }),
    Some(d) -> {
      let at = offset_digest;
      Ok({
        bytes: Bytes::concat_all([
          container.slice(0, at),
          d,
          container.slice(at + 32, container.len()),
        ]),
        digest: digest_text(d).slice(0, 15),
        full: d,
      })
    },
  }

fn human_size(n: Int) -> String = size(n, rounding: HalfUp)

const max_listed: Int = 8

fn abbreviated_list(all: List<String>) -> String = {
  let n = all.len();
  let listed_count = if n < max_listed { n } else { max_listed };
  let head = String::join(range(0, listed_count).map(|i: Int| all.at_or(i, "")), ", ");
  if n <= max_listed { head } else { head ++ ", and " ++ Int::to_string(n - max_listed) ++ " more" }
}

fn default_output(entry: String) -> String = {
  let parts = entry.split(".");
  if parts.len() < 2 { entry ++ ".plyx" } else { parts.at_or(parts.len() - 2, entry) ++ ".plyx" }
}

pub type Definition = { name: String, simple: String, module: String, at: ModuleSpan, arity: Int }

fn definition_of(definition_info: DefinitionInfo) -> Definition =
  {
    name: String::of_bytes_lossy(definition_info.name),
    simple: String::of_bytes_lossy(definition_info.simple_name),
    module: String::of_bytes_lossy(definition_info.module),
    at: {
      module: definition_info.at.module,
      start: definition_info.at.span.start,
      end: definition_info.at.span.end,
    },
    arity: match definition_info.scheme.ty { FunctionType(f) -> f.params.len(), _ -> 0 },
  }

pub fn definitions_of(view: CheckedProgram) -> List<Definition> =
  view.checked.definitions.filter(|definition_info: DefinitionInfo|
    !is_shipped_module(
      view.frame.packages,
      view.frame.module_packages,
      definition_info.at.module,
    )).map(
    definition_of,
  ).sort_by(|a: Definition, b: Definition|
    a.at.module < b.at.module || (a.at.module == b.at.module && a.at.start <= b.at.start))

fn matching(definitions: List<Definition>, named: String) -> List<Definition> =
  definitions.filter(|definition: Definition|
    definition.name == named || definition.simple == named)

fn declarations(ds: List<Definition>) -> List<Label> =
  ds.fold([], |accumulator: List<Label>, definition: Definition|
    accumulator.push(
      span_label(
        definition.at,
        accumulator.len() == 0,
        Bytes::of_string("`" ++ definition.module ++ "` declares it here"),
      ),
    ))

fn ambiguous(named: String, ds: List<Definition>) -> Diagnostic / {abort.raise} =
  error_with_labels(
    b"E0112",
    Bytes::of_string(count_of(ds.len(), "definition") ++ " are named `" ++ named ++ "`"),
    declarations(ds),
    [b"name it in full, as `<module>.<name>`"],
  )

fn entry_arguments_error(definition: Definition) -> Diagnostic / {abort.raise} =
  error_with_labels(
    b"E0201",
    Bytes::of_string(
      "`" ++ definition.name ++ "` takes " ++ count_of(definition.arity, "argument")
        ++ ", and a deployed artifact is started with none",
    ),
    [span_label(definition.at, true, b"this cannot be an entry point")],
    [b"wrap it in a nullary function and name that instead"],
  )

fn no_entry(named: String) -> Diagnostic =
  error_at(
    b"E0101",
    no_module,
    dummy_span,
    Bytes::of_string("no definition named `" ++ named ++ "`"),
    b"the build needs an existing definition as its entry point",
    [b"`--entry` takes a program-wide name (`app.serve`) or a simple one"],
  )

fn entry_named(
  definitions: List<Definition>,
  named: String,
) -> Result<String, Diagnostic> / {abort.raise} = {
  let hits = matching(definitions, named);
  match hits {
    [] -> Err(no_entry(named)),
    [only, ..rest] -> if rest.len() > 0 { Err(ambiguous(named, hits)) }
    else if only.arity > 0 { Err(entry_arguments_error(only)) }
    else { Ok(only.name) },
  }
}

fn entry_of(
  loaded: LoadedProgram,
  definitions: List<Definition>,
  flags: Flags,
) -> Result<String, Diagnostic> / {abort.raise} =
  match flags.entry {
    None -> {
      let offered = entries::narrowed_to(
        { mains: loaded.mains, modules: loaded.modules },
        flags.paths,
      );
      match entry_point(offered.mains, offered.modules) { Ok(m) -> Ok(m.name), Err(d) -> Err(d) }
    },
    Some(named) -> entry_named(definitions, named),
  }

fn startup_of(
  view: CheckedProgram,
  schema: Option<String>,
) -> Result<List<String>, Diagnostic> / {abort.raise} =
  match schema {
    None -> Ok([]),
    Some(named) -> match config_schema::resolve_schema(view, named) {
      Err(d) -> Err(d),
      Ok(name) -> Ok([name]),
    },
  }

pub type Diff = {
  added: List<String>,
  changed: List<String>,
  dropped: List<String>,
  unchanged: Int,
  affected: List<String>,
}

fn name_at(ns: List<Named>, i: Int) -> String = match ns.at(i) { Some(n) -> n.name, None -> "" }

fn distinct(ns: List<Named>) -> List<String> =
  range(0, ns.len()).fold([], |accumulator: List<String>, i: Int|
    if i > 0 && name_at(ns, i - 1) == name_at(ns, i) { accumulator }
    else { accumulator.push(name_at(ns, i)) })

fn hashes_of(ns: List<Named>, wanted: String) -> List<String> =
  ns.filter(|named: Named| named.name == wanted).map(|named: Named| named.hash)

fn diff_of(before: List<Named>, after: List<Named>, closures: List<Dependencies>) -> Diff = {
  let was = distinct(before);
  let now = distinct(after);
  let added = now.filter(|nm: String| !was.contains(nm));
  let common_names = now.filter(|nm: String| was.contains(nm));
  let changed = common_names.filter(|nm: String| hashes_of(after, nm) != hashes_of(before, nm));
  let moved = added.concat(changed);
  {
    added: added,
    changed: changed,
    dropped: was.filter(|nm: String| !now.contains(nm)),
    unchanged: common_names.len() - changed.len(),
    affected: closures.filter(|r: Dependencies|
      r.dependencies.filter(|n: String| moved.contains(n)).len() > 0).map(|r: Dependencies| r.name),
  }
}

fn row(label: String, ns: List<String>) -> String / {abort.raise} = {
  let head = indent ++ label.pad_right(11, " ") ++ count_of(ns.len(), "definition");
  if ns.len() == 0 { head } else { head ++ "   " ++ abbreviated_list(ns) }
}

fn diff_lines(
  style: Style,
  entry: String,
  was: String,
  now: String,
  d: Diff,
) -> List<String> / {abort.raise} = {
  let rows = [indent ++ bold(style, entry) ++ " " ++ was ++ " → " ++ now, ""].concat([
    row(green(style, "added"), d.added),
    row(bold(style, "changed"), d.changed),
    row(red(style, "dropped"), d.dropped),
    indent ++ "unchanged".pad_right(11, " ") ++ count_of(d.unchanged, "definition"),
  ]);
  if d.affected.len() == 0 { rows } else {
    rows.concat([
      "",
      indent ++ "depending on a changed definition: " ++ count_of(d.affected.len(), "definition"),
      indent ++ "  " ++ abbreviated_list(d.affected),
    ])
  }
}

fn diff_json(
  entry: String,
  against: String,
  was: String,
  now: String,
  d: Diff,
  bytes: Int,
  binary: Option<Int>,
) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("build") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code) },
    { key: "entry", value: Str(entry) },
    { key: "against", value: Str(against) },
    { key: "was", value: Str(was) },
    { key: "now", value: Str(now) },
    { key: "added", value: strings(d.added) },
    { key: "changed", value: strings(d.changed) },
    { key: "dropped", value: strings(d.dropped) },
    { key: "unchanged", value: int(d.unchanged) },
    { key: "reached", value: strings(d.affected) },
    { key: "artifact_bytes", value: int(bytes) },
    { key: "binary_bytes", value: int_or_null(binary) },
    { key: "diagnostics", value: all_to_json([], []) },
  ])

fn binary_line(style: Style, loaded: LoadedProgram) -> String =
  match loaded.binary_bytes {
    Some(n) ->
      indent ++ bold(style, "binary") ++ " ply " ++ loaded.version ++ " · " ++ human_size(n),
    None -> indent ++ bold(style, "binary") ++ " ply " ++ loaded.version ++ " · size unavailable",
  }

fn startup_line(style: Style, roots: List<String>) -> String =
  if roots.len() == 0 {
    indent ++ bold(style, "startup")
      ++ " none — this artifact has no startup entry point, so it cannot be run with `--config-schema`"
  } else { indent ++ bold(style, "startup") ++ " " ++ String::join(roots, " · ") }

fn built_lines(
  style: Style,
  loaded: LoadedProgram,
  made: BuiltArtifact,
  sealed: SealedArtifact,
  out: String,
) -> List<String> / {abort.raise} =
  [
    indent ++ green(style, "built") ++ " " ++ made.entry ++ " · " ++ sealed.digest,
    indent ++ bold(style, "artifact") ++ " " ++ made.definitions.to_string() ++ " "
      ++ plural(made.definitions, "definition")
      ++ " · "
      ++ human_size(sealed.bytes.len())
      ++ " · "
      ++ out,
    binary_line(style, loaded),
    startup_line(style, made.startup),
  ]

fn built_json(
  loaded: LoadedProgram,
  made: BuiltArtifact,
  sealed: SealedArtifact,
  out: String,
  signer: Option<String>,
) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("build") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code) },
    { key: "root", value: Str(loaded.root) },
    { key: "entry", value: Str(made.entry) },
    { key: "entry_hash", value: Str(made.entry_hash) },
    { key: "startup", value: strings(made.startup) },
    { key: "artifact", value: Str(out) },
    { key: "digest", value: Str(sealed.digest) },
    { key: "format", value: int(format_version) },
    { key: "definitions", value: int(made.definitions) },
    { key: "names", value: int(made.names.len()) },
    { key: "unit", value: Bool(true) },
    { key: "artifact_bytes", value: int(sealed.bytes.len()) },
    { key: "binary_bytes", value: int_or_null(loaded.binary_bytes) },
    { key: "signed_by", value: string_or_null(signer) },
    { key: "diagnostics", value: all_to_json([], loaded.places) },
  ])

fn digest_json(made: BuiltArtifact, sealed: SealedArtifact) -> Json =
  object([
    { key: "command", value: Str("build") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code) },
    { key: "entry", value: Str(made.entry) },
    { key: "digest", value: Str(sealed.digest) },
  ])

fn signing_key(
  flags: Flags,
) -> Result<Option<Secret<Bytes>>, Diagnostic> / {fs.read_secret[cwd], fs.read_secret[abs], abort.raise} =
  match flags.sign {
    None -> Ok(None),
    Some(path) -> match read_seed(path) { Ok(seed) -> Ok(Some(seed)), Err(reason) -> Err(reason) },
  }

fn built_provenance(
  flags: Flags,
  loaded: LoadedProgram,
  kind: String,
  name: String,
  sealed: SealedArtifact,
) -> Provenance / {fs.kind[abs], fs.read_file[abs], abort.raise} =
  {
    kind: kind,
    name: name,
    digest: digest_text(sealed.full),
    builder: "ply " ++ loaded.version,
    semantics: semantics::version,
    commit: head_commit(root_of(flags).absolute),
  }

fn write_signature(
  seed: Option<Secret<Bytes>>,
  out: String,
  what: Provenance,
) -> Result<Option<String>, Diagnostic> / {fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], abort.raise} =
  match seed {
    None -> Ok(None),
    Some(key) -> {
      let at = paths::rooted_path(signatures_path(out));
      let payload = provenance_bytes(what);
      let on_disk = match paths::read_file(at) {
        None -> None,
        Some(b) -> match decode_signed(b) {
          Some(x) -> if x.payload == payload { Some(x) } else { None },
          None -> None,
        },
      };
      let next = countersigned(
        match on_disk { Some(x) -> x, None -> { payload: payload, signatures: [] } },
        key,
      );
      if write_file(at, encode_signed(next)) {
        Ok(
          Some(
            Bytes::hex_of(match next.signatures.at(next.signatures.len() - 1) {
              Some(g) -> g.signer,
              None -> b"",
            }),
          ),
        )
      } else { Err(write_error(signatures_path(out))) }
    },
  }

fn signer_lines(style: Style, signer: Option<String>) -> List<String> =
  match signer { Some(h) -> [indent ++ bold(style, "signed") ++ " " ++ h], None -> [] }

fn verify_error(path: String, reason: String) -> Diagnostic =
  error_at(
    b"E0461",
    no_module,
    dummy_span,
    Bytes::of_string("`" ++ path ++ "` " ++ reason),
    b"not what these sources build",
    [b"`ply build --verify` builds in memory and writes nothing; `ply build` writes what it built"],
  )

fn verify_artifact(
  style: Style,
  loaded: LoadedProgram,
  out: String,
  x: SealedArtifact,
  into: Bytes,
) -> CommandOutput / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match paths::read_file(paths::rooted_path(out)) {
    None -> reported(style, "build", [verify_error(out, "cannot be read")], loaded.places),
    Some(on_disk) -> if on_disk != x.bytes {
      let sealed = match digest_of(into, on_disk) {
        Some(d) -> digest_text(d),
        None -> "no digest",
      };
      reported(
        style,
        "build",
        [
          verify_error(
            out,
            "seals " ++ sealed ++ ", and these sources build " ++ digest_text(x.full),
          ),
        ],
        loaded.places,
      )
    } else {
      let sig = signatures_path(out);
      match paths::read_file(paths::rooted_path(sig)) {
        None -> verified_output(style, out, x, [], None),
        Some(b) -> match decode_signed(b) {
          None ->
            reported(
              style,
              "build",
              [verify_error(sig, "is not a valid signature file")],
              loaded.places,
            ),
          Some(g) -> match provenance_of(g.payload) {
            None ->
              reported(
                style,
                "build",
                [verify_error(sig, "does not say which build it signs")],
                loaded.places,
              ),
            Some(what) -> if what.digest != digest_text(x.full) {
              reported(
                style,
                "build",
                [verify_error(sig, "vouches for " ++ what.digest)],
                loaded.places,
              )
            } else {
              match g.signatures.filter(|one: Signature|
                  !signed::signature_matches(one, g.payload)) {
                [] ->
                  verified_output(
                    style,
                    out,
                    x,
                    g.signatures.map(|one: Signature| one.signer.hex_of()),
                    Some(what),
                  ),
                [bad, ..] ->
                  reported(
                    style,
                    "build",
                    [
                      verify_error(
                        sig,
                        "contains a signature by " ++ bad.signer.hex_of()
                          ++ " that fails verification",
                      ),
                    ],
                    loaded.places,
                  ),
              }
            },
          },
        },
      }
    },
  }

fn verified_output(
  style: Style,
  out: String,
  sealed: SealedArtifact,
  signers: List<String>,
  what: Option<Provenance>,
) -> CommandOutput / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("build") },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: int(ok_code) },
      { key: "verified", value: Bool(true) },
      { key: "artifact", value: Str(out) },
      { key: "digest", value: Str(digest_text(sealed.full)) },
      { key: "signers", value: strings(signers) },
      {
        key: "provenance",
        value: match what {
          None -> Null,
          Some(v) ->
            object([
              { key: "kind", value: Str(v.kind) },
              { key: "name", value: Str(v.name) },
              { key: "builder", value: Str(v.builder) },
              { key: "semantics", value: Str(v.semantics) },
              { key: "commit", value: Str(v.commit) },
            ]),
        },
      },
    ]),
    lines: signers.map(|h: String| indent ++ "  " ++ bold(style, "signed") ++ " " ++ h).fold(
      [
        indent ++ green(style, "verified") ++ " " ++ out ++ " · " ++ sealed.digest ++ " · "
          ++ (if signers.len() == 0 { "unsigned" } else { count_of(signers.len(), "signature") }),
      ],
      |accumulator: List<String>, l: String| accumulator.push(l),
    ),
    errs: [],
    code: ok_code,
  }

fn write_error(path: String) -> Diagnostic =
  error_at(
    b"E0502",
    no_module,
    dummy_span,
    Bytes::of_string("could not write `" ++ path ++ "`"),
    b"the artifact was built but not stored",
    [],
  )

fn store_artifact(
  out: String,
  body: Bytes,
) -> Result<Unit, Rejection> / {fs.create_dir[cwd], fs.create_dir[abs], fs.write_file[cwd], fs.write_file[abs], abort.raise} = {
  let at = paths::rooted_path(out);
  let has_directory = match paths::parent_of(at) {
    Some(dir) -> paths::create_dir(dir),
    None -> true,
  };
  if has_directory && write_file(at, body) { Ok(()) }
  else { Err({ diagnostics: [write_error(out)], places: [] }) }
}

fn write_artifact(
  style: Style,
  flags: Flags,
  loaded: LoadedProgram,
  made: BuiltArtifact,
  sealed: SealedArtifact,
) -> CommandOutput / {fs.create_dir[cwd], fs.create_dir[abs], fs.write_file[cwd], fs.write_file[abs], fs.kind[abs], fs.read_file[cwd], fs.read_file[abs], fs.read_secret[cwd], fs.read_secret[abs], abort.raise} = {
  let out = match flags.out { Some(v) -> v, None -> default_output(made.entry) };
  match signing_key(flags) {
    Err(d) -> reported(style, "build", [d], loaded.places),
    Ok(seed) -> match store_artifact(out, sealed.bytes) {
      Err(reason) -> reported(style, "build", reason.diagnostics, loaded.places),
      Ok(_) -> match write_signature(
          seed,
          out,
          built_provenance(flags, loaded, "program", made.entry, sealed),
        ) {
        Err(d) -> reported(style, "build", [d], loaded.places),
        Ok(signer) ->
          {
            json: built_json(loaded, made, sealed, out, signer),
            lines: signer_lines(style, signer).fold(
              built_lines(style, loaded, made, sealed, out),
              |accumulator: List<String>, l: String| accumulator.push(l),
            ),
            errs: [],
            code: ok_code,
          },
      },
    },
  }
}

fn diff_output(
  style: Style,
  loaded: LoadedProgram,
  made: BuiltArtifact,
  sealed: SealedArtifact,
  old: String,
) -> CommandOutput / {artifacts.previous, fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match artifacts.previous(old, paths::read_file(paths::rooted_path(old))) {
    Err(reason) -> reported(style, "build", reason.diagnostics, reason.places),
    Ok(was) -> {
      let d = diff_of(was.names, made.names, made.closures);
      {
        json: diff_json(
          made.entry,
          old,
          was.digest,
          sealed.digest,
          d,
          sealed.bytes.len(),
          loaded.binary_bytes,
        ),
        lines: diff_lines(style, made.entry, was.digest, sealed.digest, d),
        errs: [],
        code: ok_code,
      }
    },
  }

fn deliver(
  style: Style,
  flags: Flags,
  loaded: LoadedProgram,
  made: BuiltArtifact,
  sealed: SealedArtifact,
) -> CommandOutput / {artifacts.previous, fs.read_file[cwd], fs.read_file[abs], fs.read_secret[cwd], fs.read_secret[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.write_file[cwd], fs.write_file[abs], fs.kind[abs], abort.raise} =
  match flags.diff {
    Some(old) -> diff_output(style, loaded, made, sealed, old),
    None -> if flags.digest {
      { json: digest_json(made, sealed), lines: [sealed.digest], errs: [], code: ok_code }
    } else if flags.action == "verify" {
      verify_artifact(
        style,
        loaded,
        match flags.out { Some(v) -> v, None -> default_output(made.entry) },
        sealed,
        domain,
      )
    } else { write_artifact(style, flags, loaded, made, sealed) },
  }

fn has_diff(flags: Flags) -> Bool = match flags.diff { Some(_) -> true, None -> false }

fn assemble(
  style: Style,
  flags: Flags,
  loaded: LoadedProgram,
  front: LoadedAnalysis,
  hashes: HashOutput,
  entry: String,
  startup: List<String>,
) -> CommandOutput / {artifacts.made, artifacts.previous, fs.read_file[cwd], fs.read_file[abs], fs.read_secret[cwd], fs.read_secret[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.write_file[cwd], fs.write_file[abs], fs.kind[abs], abort.raise} =
  match artifacts.made(front, hashes, entry, startup, has_diff(flags)) {
    Err(reason) -> reported(style, "build", reason.diagnostics, loaded.places),
    Ok(m) -> match seal(encode(m.head, m.sections)) {
      Err(reason) -> reported(style, "build", reason.diagnostics, loaded.places),
      Ok(x) -> deliver(style, flags, loaded, m, x),
    },
  }

fn build_entry(
  style: Style,
  flags: Flags,
  loaded: Program,
  p: LoadedProgram,
  front: LoadedAnalysis,
  hashes: HashOutput,
  definitions: List<Definition>,
  startup: Result<List<String>, Diagnostic>,
) -> CommandOutput / {artifacts.made, artifacts.previous, fs.read_file[cwd], fs.read_file[abs], fs.read_secret[cwd], fs.read_secret[abs], fs.create_dir[cwd], fs.create_dir[abs], artifacts.unit, fs.write_file[cwd], fs.write_file[abs], fs.kind[abs], abort.raise} =
  match entry_of(p, definitions, flags) {
    Err(d) -> if flags.entry == None && p.mains.len() == 0 {
      build_library(style, flags, loaded, p, front, definitions, d)
    } else { reported(style, "build", [d], p.places) },
    Ok(entry) -> match startup {
      Err(d) -> reported(style, "build", [d], p.places),
      Ok(roots) -> assemble(style, flags, p, front, hashes, entry, roots),
    },
  }

pub fn run(
  flags: Flags,
  schema: Option<String>,
) -> CommandOutput / {shipped.read_pack, builder.git[vcs], builder.loaded[build], emit.unit, shipped.names, shipped.module, shipped.definitions, shipped.runtime, fs.read_file[cwd], fs.read_file[abs], fs.read_secret[cwd], fs.read_secret[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.write_file[cwd], fs.write_file[abs], time.elapsed_ms, evaluation.verdicts, evaluation.statements, Derives, abort.raise, diverges, shipped.report_view_used} = {
  let s: Style = style_of(flags);
  let t: TimedLoad = timed_uncached(flags.paths, flags.verify_dependencies);
  match program_view(t.program) {
    None -> rejected(s, "build", t.program.diagnostics, t.program.source_texts),
    Some(w) -> match evaluation_errors(t, w.frame) {
      [] ->
        with_artifacts(||
          build_program(
            s,
            flags,
            t.program,
            definitions_of(w),
            startup_of(w, schema),
            loaded_analysis(t, w),
            w.frame.hashes,
          )),
      literals -> rejected(s, "build", literals, t.program.source_texts),
    },
  }
}

pub fn with_read_back<a | e>(
  body: () -> a / {builder.loaded[build] | e},
) -> a / {shipped.binary_size, shipped.version, abort.raise | e} =
  handle { body() } with { builder.loaded[build](root, front) -> Ok(read_back(root, front)) }

fn read_back(
  root: String,
  front: LoadedAnalysis,
) -> LoadedProgram / {shipped.binary_size, shipped.version, abort.raise} =
  {
    root: normalize(root),
    mains: entries::mains_of(front),
    modules: entries::modules_of(front),
    places: front.files.map(|file: SourceFile| { path: file.path, text: file.text }),
    pins: lock::from_front(front.dump.pins),
    binary_bytes: shipped.binary_size(),
    version: shipped.version(),
  }

fn build_program(
  style: Style,
  flags: Flags,
  loaded: Program,
  definitions: List<Definition>,
  startup: Result<List<String>, Diagnostic>,
  front: LoadedAnalysis,
  hashes: HashOutput,
) -> CommandOutput / {builder.loaded[build], artifacts.made, artifacts.previous, fs.read_file[cwd], fs.read_file[abs], fs.read_secret[cwd], fs.read_secret[abs], fs.create_dir[cwd], fs.create_dir[abs], artifacts.unit, fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.kind[abs], abort.raise} = {
  let r = root_of(flags);
  let locked: Result<Option<lock::Lock>, String> = lock::read(r);
  match builder.loaded[build](root_of(flags).machine, front) {
    Err(reason) -> rejected(style, "build", reason.diagnostics, reason.places),
    Ok(p) -> match locked {
      Err(reason) -> reported(style, "build", [lock::unreadable_lock(r, reason)], p.places),
      Ok(existing) -> {
        let committed = lock::committed_packages(loaded.packages);
        match lock_rejection(r, existing, p, committed) {
          Some(d) -> reported(style, "build", [d], p.places),
          None -> {
            let result = build_entry(style, flags, loaded, p, front, hashes, definitions, startup);
            if result.code == ok_code { write_lock_file(r, existing, p, committed) };
            result
          },
        }
      },
    },
  }
}

fn write_lock_file(
  resolved: ResolvedPath,
  existing: Option<lock::Lock>,
  loaded: LoadedProgram,
  committed: List<String>,
) -> Unit / {fs.write_file[cwd], fs.write_file[abs], abort.raise} =
  if existing == Some(lock::updated_lock(existing, loaded.pins, [], committed)) { () } else {
    write_file(
      lock::path_of(resolved),
      Bytes::of_string(lock::text(existing, loaded.pins, [], committed)),
    );
    ()
  }

fn library_name(manifest: Manifest) -> String =
  manifest.name ++ " " ++ render_version(manifest.version)

fn library_output(flags: Flags, name: String) -> String =
  match flags.out { Some(v) -> v, None -> name ++ ".plyz" }

fn build_library(
  style: Style,
  flags: Flags,
  loaded: Program,
  p: LoadedProgram,
  front: LoadedAnalysis,
  definitions: List<Definition>,
  rejected: Diagnostic,
) -> CommandOutput / {fs.create_dir[cwd], fs.create_dir[abs], artifacts.unit, fs.write_file[cwd], fs.write_file[abs], fs.kind[abs], fs.read_file[cwd], fs.read_file[abs], fs.read_secret[cwd], fs.read_secret[abs], abort.raise} =
  match loaded.frame {
    None -> reported(style, "build", [rejected], p.places),
    Some(v) -> match v.manifest {
      None -> reported(style, "build", [rejected], p.places),
      Some(m) -> if m.entry != None { reported(style, "build", [rejected], p.places) }
      else { write_library(style, flags, p, loaded, front, definitions, m) },
    },
  }

pub type LibraryArchive = { own: List<Definition>, unit: LibraryUnit, sealed: SealedArtifact }

pub fn pack_library(
  front: LoadedAnalysis,
  loaded: Program,
  definitions: List<Definition>,
) -> Result<LibraryArchive, Rejection> / {artifacts.unit, abort.raise} = {
  let owned = loaded.files.map(|file: File| file.module);
  let own = definitions.filter(|definition: Definition| owned.contains(definition.module));
  match artifacts.unit(front, own.map(|definition: Definition| definition.name)) {
    Err(reason) -> Err(reason),
    Ok(compiled) -> {
      let manifest = match loaded.packages.manifest { Some(text) -> text, None -> b"" };
      let container = encode_named(
        library_magic,
        compiled.head,
        plyz::sections(loaded.files, manifest, compiled),
      );
      match seal_in_domain(container, library_domain) {
        Err(reason) -> Err(reason),
        Ok(x) -> Ok({ own: own, unit: compiled, sealed: x }),
      }
    },
  }
}

fn write_library(
  style: Style,
  flags: Flags,
  p: LoadedProgram,
  loaded: Program,
  front: LoadedAnalysis,
  definitions: List<Definition>,
  manifest: Manifest,
) -> CommandOutput / {fs.create_dir[cwd], fs.create_dir[abs], artifacts.unit, fs.write_file[cwd], fs.write_file[abs], fs.kind[abs], fs.read_file[cwd], fs.read_file[abs], fs.read_secret[cwd], fs.read_secret[abs], abort.raise} =
  match pack_library(front, loaded, definitions) {
    Err(reason) -> reported(style, "build", reason.diagnostics, p.places),
    Ok(k) -> {
      let out = library_output(flags, manifest.name);
      if flags.action == "verify" { verify_artifact(style, p, out, k.sealed, library_domain) }
      else {
        match signing_key(flags) {
          Err(d) -> reported(style, "build", [d], p.places),
          Ok(seed) -> match store_artifact(out, k.sealed.bytes) {
            Err(reason) -> reported(style, "build", reason.diagnostics, p.places),
            Ok(_) -> match write_signature(
                seed,
                out,
                built_provenance(flags, p, "library", library_name(manifest), k.sealed),
              ) {
              Err(d) -> reported(style, "build", [d], p.places),
              Ok(signer) ->
                {
                  json: library_json(p, manifest, k.own, k.unit, k.sealed, out, signer),
                  lines: signer_lines(style, signer).fold(
                    library_lines(
                      style,
                      manifest,
                      loaded.files.len(),
                      k.own,
                      k.unit,
                      k.sealed,
                      out,
                    ),
                    |accumulator: List<String>, l: String| accumulator.push(l),
                  ),
                  errs: [],
                  code: ok_code,
                },
            },
          },
        }
      }
    },
  }

fn library_lines(
  style: Style,
  manifest: Manifest,
  modules: Int,
  own: List<Definition>,
  unit: LibraryUnit,
  sealed: SealedArtifact,
  out: String,
) -> List<String> / {abort.raise} =
  [
    indent ++ green(style, "built") ++ " " ++ library_name(manifest) ++ " · " ++ sealed.digest,
    indent ++ bold(style, "library") ++ " " ++ count_of(modules, "module") ++ " · "
      ++ count_of(sealed.bytes.len(), "byte")
      ++ " · "
      ++ out,
    indent ++ bold(style, "unit") ++ " " ++ count_of(own.len(), "definition") ++ " compiled",
  ]

fn library_json(
  loaded: LoadedProgram,
  manifest: Manifest,
  own: List<Definition>,
  unit: LibraryUnit,
  sealed: SealedArtifact,
  out: String,
  signer: Option<String>,
) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("build") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code) },
    { key: "library", value: Bool(true) },
    { key: "root", value: Str(loaded.root) },
    { key: "name", value: Str(manifest.name) },
    { key: "version", value: Str(render_version(manifest.version)) },
    { key: "definitions", value: int(own.len()) },
    { key: "artifact", value: Str(out) },
    { key: "digest", value: Str(sealed.digest) },
    { key: "format", value: int(format_version) },
    { key: "unit", value: Bool(unit.payload.len() > 0) },
    { key: "artifact_bytes", value: int(sealed.bytes.len()) },
    { key: "signed_by", value: string_or_null(signer) },
    { key: "diagnostics", value: all_to_json([], loaded.places) },
  ])

pub fn lock_rejection(
  r: ResolvedPath,
  existing: Option<lock::Lock>,
  loaded: LoadedProgram,
  committed: List<String>,
) -> Option<Diagnostic> =
  match existing {
    None -> None,
    Some(lock) -> match lock::verify(r, lock, loaded.pins, committed) {
      Ok(_) -> None,
      Err(d) -> Some(d),
    },
  }

fn a_definition(name: String, simple: String, module: String, arity: Int) -> Definition =
  { name: name, simple: simple, module: module, at: no_module_span, arity: arity }

const some_definitions: List<Definition> =
  [
    a_definition("m.main", "main", "m", 0),
    a_definition("m.serve", "serve", "m", 1),
    a_definition("m.spec", "spec", "m", 0),
    a_definition("left.util", "util", "left", 0),
    a_definition("right.util", "util", "right", 0),
  ]

const a_main: Main = { name: "m.main", module: "m", path: "m.ply", at: no_module_span }

const a_load: LoadedProgram =
  {
    root: "/p",
    mains: [a_main],
    modules: [{ name: "m", path: "m.ply", at: no_module_span }],
    places: [],
    pins: [],
    binary_bytes: Some(12582912),
    version: "0.16.0",
  }

const a_head: Header = { frontend: b"", runtime: b"", entry: b"" }

const an_artifact: BuiltArtifact =
  {
    entry: "m.main",
    entry_hash: "9f2c1a4e",
    startup: [],
    head: a_head,
    sections: [{ name: b"bodies", count: 1, payload: b"AA" }],
    definitions: 1,
    names: [{ name: "m.main", hash: "aa" }],
    closures: [],
  }

fn flags_of(json: Bool) -> Flags = { ..no_flags, json: json }

test "`human_size` shows bytes exactly and larger sizes in KiB or MiB with one decimal place" {
  assert_eq(human_size(0), "0 B");
  assert_eq(human_size(512), "512 B");
  assert_eq(human_size(2048), "2.0 KiB");
  assert_eq(human_size(3145728), "3.0 MiB")
}

test "a long list is counted rather than printed whole" {
  let many = range(0, 20).map(|i: Int| "m.d" ++ i.to_string());
  assert(abbreviated_list(many).ends_with("and 12 more"));
  assert_eq(abbreviated_list(["m.a", "m.b", "m.c"]), "m.a, m.b, m.c");
  assert_eq(abbreviated_list([]), "")
}

test "the default output is named after the entry point's module" {
  assert_eq(default_output("service.run"), "service.plyx");
  assert_eq(default_output("store.orders.main"), "orders.plyx");
  assert_eq(default_output("main"), "main.plyx")
}

test "`--entry` takes a program-wide name or a simple one" {
  assert_eq(entry_named(some_definitions, "m.main"), Ok("m.main"));
  assert_eq(entry_named(some_definitions, "spec"), Ok("m.spec"))
}

test "an entry point that takes an argument is rejected, and so is a name nothing declares" {
  match entry_named(some_definitions, "serve") {
    Ok(_) -> panic("a definition that takes an argument cannot be an entry point"),
    Err(d) -> {
      assert_eq(d.code, b"E0201");
      assert(String::of_bytes_lossy(d.message).contains("takes 1 argument"))
    },
  };
  match entry_named(some_definitions, "absent") {
    Ok(_) -> panic("a name nothing declares is not an entry point"),
    Err(d) -> assert_eq(d.code, b"E0101"),
  }
}

test "a simple name two modules declare says which two" {
  match entry_named(some_definitions, "util") {
    Ok(_) -> panic("two definitions named `util` is not one entry point"),
    Err(d) -> {
      assert_eq(d.code, b"E0112");
      assert_eq(d.message, b"2 definitions are named `util`");
      assert_eq(d.labels.len(), 2);
      assert_eq(d.labels.at_or(0, span_label(no_module_span, false, b"")).primary, true);
      assert_eq(d.labels.at_or(1, span_label(no_module_span, true, b"")).primary, false)
    },
  }
}

const a_view: CheckedProgram = {
  let source = b"type Key = { name: String }\ntype ConfigSpec = { keys: List<Key> }\npub fn spec() -> ConfigSpec = { keys: [] }\nfn main() -> Int = 1\nfn serve(port: Int) -> Int = port\n";
  match analyse(parse_all([{ name: b"m", source_text: source }])) {
    Rejected(_) -> panic("the fixture checks"),
    Analysed(w) -> checked_program_of(w),
  }
}

test "the definitions `--entry` may name are the program's own, as written, with their arity" {
  assert_eq(
    definitions_of(a_view).map(|definition: Definition|
      (definition.name, definition.simple, definition.module, definition.arity)),
    [("m.spec", "spec", "m", 0), ("m.main", "main", "m", 0), ("m.serve", "serve", "m", 1)],
  )
}

test "`--config-schema` must name a program-wide definition that takes no argument, as `ply run` requires, or the build fails" {
  match startup_of(a_view, Some("m.absent")) {
    Ok(_) -> panic("a schema nothing declares cannot ship"),
    Err(d) -> {
      assert_eq(d.code, b"E0440");
      assert_eq(d.message, b"`--config-schema m.absent` names no definition in this program");
      assert_eq(d.notes_text, [b"this program has: m.spec"])
    },
  };
  match startup_of(a_view, Some("spec")) {
    Ok(_) -> panic("a simple name is not the name a run takes"),
    Err(d) -> assert_eq(d.code, b"E0440"),
  };
  match startup_of(a_view, Some("m.serve")) {
    Ok(_) -> panic("a function that takes an argument is no schema"),
    Err(d) -> assert_eq(d.code, b"E0440"),
  };
  assert_eq(startup_of(a_view, Some("m.spec")), Ok(["m.spec"]));
  assert_eq(startup_of(a_view, None), Ok([]))
}

test "a rename adds a name and drops one without changing a body" {
  let was = [{ name: "m.helper", hash: "aa" }, { name: "m.main", hash: "bb" }];
  let now = [{ name: "m.assistant", hash: "aa" }, { name: "m.main", hash: "bb" }];
  let d = diff_of(was, now, []);
  assert_eq(d.added, ["m.assistant"]);
  assert_eq(d.dropped, ["m.helper"]);
  assert_eq(d.changed, []);
  assert_eq(d.unchanged, 1)
}

test "a changed callee marks its caller as changed, and the diff lists every definition affected by a change" {
  let was = [{ name: "m.main", hash: "aa" }, { name: "m.shade", hash: "bb" }];
  let now = [
    { name: "m.main", hash: "a1" },
    { name: "m.other", hash: "cc" },
    { name: "m.shade", hash: "b1" },
  ];
  let closures = [
    { name: "m.Colour", dependencies: ["m.Colour"] },
    { name: "m.main", dependencies: ["m.main", "m.shade"] },
    { name: "m.shade", dependencies: ["m.shade"] },
  ];
  let d = diff_of(was, now, closures);
  assert_eq(d.added, ["m.other"]);
  assert_eq(d.changed, ["m.main", "m.shade"]);
  assert_eq(d.dropped, []);
  assert_eq(d.unchanged, 0);
  assert_eq(d.affected, ["m.main", "m.shade"])
}

test "a name recorded with two hashes is listed once by `distinct`, and `diff_of` counts it as one unchanged name when both sides are the same" {
  let twice = [{ name: "m.main", hash: "aa" }, { name: "m.main", hash: "bb" }];
  assert_eq(distinct(twice), ["m.main"]);
  assert_eq(diff_of(twice, twice, []).unchanged, 1);
  assert_eq(diff_of([{ name: "m.main", hash: "aa" }], twice, []).changed, ["m.main"])
}

test "`diff_lines` prints added, changed and dropped rows, the unchanged count, and the definitions affected by a change" {
  let d: Diff = {
    added: ["m.other"],
    changed: ["m.main"],
    dropped: [],
    unchanged: 2,
    affected: ["m.main"],
  };
  assert_eq(diff_lines(plain, "m.main", "b3:aaa", "b3:bbb", d), [
    "   m.main b3:aaa → b3:bbb",
    "",
    "   added      1 definition   m.other",
    "   changed    1 definition   m.main",
    "   dropped    0 definitions",
    "   unchanged  2 definitions",
    "",
    "   depending on a changed definition: 1 definition",
    "     m.main",
  ])
}

fn build_with(
  flags: Flags,
  p: Result<LoadedProgram, Rejection>,
  m: Result<BuiltArtifact, Rejection>,
  was: Result<PreviousArtifact, Rejection>,
  stores: Bool,
) -> CommandOutput / {abort.raise} =
  handle {
    build_program(
      style_of(flags),
      flags,
      no_program,
      some_definitions,
      Ok([]),
      no_loaded_analysis,
      no_hashes,
    )
  } with {
    builder.loaded[build](root, front) -> p,
    artifacts.made(front, hashes, entry, startup, reachable) -> m,
    artifacts.previous(path, bytes) -> was,
    fs.read_file[cwd](path) -> lockfile(path),
    fs.read_file[abs](path) -> lockfile(path),
    fs.read_secret[cwd](path, before, encoding, after) -> None,
    fs.read_secret[abs](path, before, encoding, after) -> None,
    fs.create_dir[cwd](path) -> stores,
    fs.create_dir[abs](path) -> stores,
    fs.write_file[cwd](path, body) -> stores || path.ends_with("ply.lock"),
    fs.write_file[abs](path, body) -> stores || path.ends_with("ply.lock"),
    fs.kind[abs](path) -> Missing,
    artifacts.unit(front, names) -> no_unit,
  }

const no_unit: Result<LibraryUnit, Rejection> = Err({ diagnostics: [], places: [] })

fn lockfile(path: String) -> Option<Bytes> = None

const no_rejection: Rejection = { diagnostics: [], places: [] }

fn a_build(flags: Flags) -> CommandOutput / {abort.raise} =
  build_with(flags, Ok(a_load), Ok(an_artifact), Err(no_rejection), true)

test "a build prints the entry and digest, the artifact's path and size, and the `ply` binary's version and size" {
  let result = a_build(flags_of(false));
  assert_eq(result.code, 0);
  assert_eq(result.errs, []);
  assert_eq(result.lines, [
    "   built m.main · b3:f5769a2fa8e5",
    "   artifact 1 definition · 178 B · m.plyx",
    "   binary ply 0.16.0 · 12.0 MiB",
    "   startup none — this artifact has no startup entry point, so it cannot be run with `--config-schema`",
  ])
}

test "`ply build --json` output contains `command` and `exit_code`, and the entry, digest and path of the artifact it wrote" {
  let text = to_string(a_build(flags_of(true)).json);
  assert(text.contains("\"command\":\"build\""));
  assert(text.contains("\"exit_code\":0"));
  assert(text.contains("\"entry\":\"m.main\""));
  assert(text.contains("\"artifact\":\"m.plyx\""));
  assert(text.contains("\"digest\":\"b3:f5769a2fa8e5\""));
  assert(text.contains("\"definitions\":1"));
  assert(text.contains("\"names\":1"));
  assert(text.contains("\"unit\":true"));
  assert(text.contains("\"artifact_bytes\":178"));
  assert(text.contains("\"root\":\"/p\""));
  assert(text.contains("\"format\":" ++ format_version.to_string()))
}

test "`-o` names the file, and the entry's module names it otherwise" {
  let result = a_build({ ..no_flags, out: Some("dist/app.plyx") });
  assert_eq(result.lines.at_or(1, ""), "   artifact 1 definition · 178 B · dist/app.plyx")
}

test "`--digest` writes the one line a deployment pins and nothing else" {
  let result = build_with(
    { ..no_flags, digest: true },
    Ok(a_load),
    Ok(an_artifact),
    Err(no_rejection),
    false,
  );
  assert_eq(result.lines, ["b3:f5769a2fa8e5"]);
  assert_eq(result.errs, []);
  assert_eq(result.code, 0)
}

test "`--diff` reports against a deployed artifact and writes no file" {
  let was: PreviousArtifact = {
    digest: "b3:000000000000",
    names: [{ name: "m.helper", hash: "cc" }],
  };
  let result = build_with(
    { ..no_flags, diff: Some("old.plyx"), json: true },
    Ok(a_load),
    Ok(an_artifact),
    Ok(was),
    false,
  );
  assert_eq(result.code, 0);
  let text = to_string(result.json);
  assert(text.contains("\"against\":\"old.plyx\""));
  assert(text.contains("\"was\":\"b3:000000000000\""));
  assert(text.contains("\"now\":\"b3:f5769a2fa8e5\""));
  assert(text.contains("\"added\":[\"m.main\"]"));
  assert(text.contains("\"dropped\":[\"m.helper\"]"))
}

test "a program that fails to load reports the load's own errors and the error count, and the build exits with code 2" {
  let reason: Rejection = {
    diagnostics: [
      {
        code: b"E0201",
        notes: 0,
        labels: [],
        text: b"",
        message: b"type mismatch",
        notes_text: [],
        severity: b"error",
        fixes: [],
      },
    ],
    places: [],
  };
  let result = build_with(
    flags_of(false),
    Err(reason),
    Err(no_rejection),
    Err(no_rejection),
    false,
  );
  assert_eq(result.code, 2);
  assert_eq(result.lines, []);
  assert_eq(result.errs, ["Error[E0201]: type mismatch", indent ++ "compilation failed (1 error)"])
}

test "an artifact that cannot be written is exit 2 with no tally" {
  let result = build_with(
    { ..flags_of(false), out: Some("dist/m.plyx") },
    Ok(a_load),
    Ok(an_artifact),
    Err(no_rejection),
    false,
  );
  assert_eq(result.code, 2);
  assert_eq(result.lines, []);
  assert_eq(result.errs, ["Error[E0502]: could not write `dist/m.plyx`"])
}

test "a build fails with exit code 2 before writing anything when `--entry` names a definition that takes an argument" {
  let result = build_with(
    { ..no_flags, entry: Some("serve") },
    Ok(a_load),
    Err(no_rejection),
    Err(no_rejection),
    false,
  );
  assert_eq(result.code, 2);
  assert_eq(
    result.errs.at_or(0, ""),
    "Error[E0201]: `m.serve` takes 1 argument, and a deployed artifact is started with none",
  )
}
