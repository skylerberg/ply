import args (Flags, from_argv, no_flags, style_of)
import report (CommandOutput, schema_version, ok_code, compile_error)
import std.term (Style, bold, red)
import std.json (Json, Str, Bool, Number, Array, object)
import std.string

pub type Meaning = { code: String, meaning: String }

fn meaning_of(code: String, meaning: String) -> Meaning = { code: code, meaning: meaning }

