//! `ply explain` — what a diagnostic code means. `meanings()` is the registry of codes, held to
//! one row per code the workspace raises by the gates in
//! `crates/ply-core-tests/tests/suite/armed.rs`.

import args (Flags, from_argv, no_flags, style_of)
import report (Answer, schema_version, ok_code, compile_error)
import std.term (Style, bold, red)
import std.json (Json, Str, Bool, Number, Array, object)
import std.string

pub type Meaning = { code: String, meaning: String }

fn meaning_of(code: String, meaning: String) -> Meaning = { code: code, meaning: meaning }

pub fn meanings() -> List<Meaning> =
  [
    meaning_of("E0001", "unexpected token"),
    meaning_of("E0002", "unterminated string or byte-string literal"),
