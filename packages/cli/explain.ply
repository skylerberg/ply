pub fn severity_of(code: String) -> String = if code.starts_with("W") { "warning" } else { "error" }

pub fn find(code: String) -> Option<Meaning> =
  meanings().fold(None, |acc: Option<Meaning>, row: Meaning|
    match acc { Some(_) -> acc, None -> if row.code == code { Some(row) } else { None } })

fn row_json(row: Meaning) -> Json =
  object([
    { key: "code", value: Str(row.code) },
    { key: "severity", value: Str(severity_of(row.code)) },
    { key: "meaning", value: Str(row.meaning) },
  ])

fn header_members(ok: Bool, code: Int) -> List<{ key: String, value: Json }> =
  [
    { key: "command", value: Str("explain") },
    { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
    { key: "ok", value: Bool(ok) },
    { key: "exit_code", value: Number(Decimal::of_int(code)) },
  ]

fn all_codes_output(style: Style) -> CommandOutput =
  {
    json: object(
      header_members(true, ok_code()).push({
        key: "codes",
        value: Array(meanings().map(row_json)),
      }),
    ),
    lines: meanings().map(|row: Meaning| bold(style, row.code) ++ " " ++ row.meaning),
    errs: [],
    code: ok_code(),
  }

fn code_output(style: Style, row: Meaning) -> CommandOutput =
  {
    json: object(
      header_members(true, ok_code()).push({ key: "code", value: Str(row.code) }).push({
        key: "severity",
        value: Str(severity_of(row.code)),
      }).push({ key: "meaning", value: Str(row.meaning) }),
    ),
    lines: [bold(style, row.code) ++ " " ++ row.meaning],
    errs: [],
    code: ok_code(),
  }

fn unknown_code_output(style: Style, code: String) -> CommandOutput = {
  let message = "`" ++ code
    ++ "` is not a code this compiler raises; `ply explain --all` lists them";
  {
    json: object(
      header_members(false, compile_error()).push({ key: "code", value: Str(code) }).push({
        key: "error",
        value: Str(message),
      }),
    ),
    lines: [],
    errs: [red(style, "error") ++ ": " ++ message],
    code: compile_error(),
  }
}

pub fn run(flags: Flags) -> CommandOutput = {
  let s = style_of(flags);
  if flags.all { all_codes_output(s) } else {
    let code = flags.query.ascii_upper();
    match find(code) { Some(row) -> code_output(s, row), None -> unknown_code_output(s, code) }
  }
}

test "a code is one line, and its own document under `--json`" {
  let result = run({ ..no_flags(), query: "e0302" });
  assert_eq(result.code, 0);
  assert_eq(result.lines, ["E0302 effect that the written signature does not list"]);
  assert_eq(result.errs, [])
}

test "a code nothing raises is exit 2 and points at the list" {
  let result = run({ ..no_flags(), query: "E9999" });
  assert_eq(result.code, 2);
  assert_eq(result.lines, []);
  assert_eq(result.errs, [
    "error: `E9999` is not a code this compiler raises; `ply explain --all` lists them",
  ])
}

test "`--all` lists every row, warnings among them, in the table's order" {
  let result = run(from_argv("explain", ["--all"]));
  assert_eq(result.code, 0);
  assert_eq(result.lines.len(), meanings().len());
  assert_eq(match result.lines.at(0) { Some(l) -> l, None -> "" }, "E0001 unexpected token");
  assert_eq(severity_of("W0611"), "warning");
  assert_eq(severity_of("E0001"), "error")
}

test "no code is explained twice" {
  let seen = meanings().fold(Map::new(), |acc: Map<String, Bool>, row: Meaning|
    acc.insert(row.code, true));
  assert_eq(seen.len(), meanings().len())
}
