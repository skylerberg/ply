import compiler.front.pkg (Package, closure)
import compiler.check.resolve.tables (Source)
import sources (Project, DependencyPackage)
import program (packages_of)
import report (CommandOutput, indent, schema_version)
import std.term (Style, bold, plain)
import std.json (Json, Str, Bool, Number, Array, object)

fn in_place(package: DependencyPackage) -> Bool =
  package.dir == package.root && !package.root.starts_with("git+")
    && !package.root.contains("/.ply-cache/registry/")

fn index_of(packages: List<Package>, prefix: Bytes) -> Option<Int> =
  range(0, packages.len()).fold(None, |found: Option<Int>, i: Int|
    match found {
      Some(_) -> found,
      None -> match packages.at(i) {
        Some(p) -> if p.prefix == prefix && i > 0 { Some(i) } else { None },
        None -> None,
      },
    })

type Order = { seen: Map<Int, Bool>, out: List<Int> }

fn visited(packages: List<Package>, o: Order, i: Int, depth_left: Int) -> Order =
  if o.seen.contains(i) || depth_left <= 0 { o } else {
    let marked = { ..o, seen: o.seen.insert(i, true) };
    let below = match packages.at(i) {
      None -> marked,
      Some(p) ->
        p.dependencies.fold(marked, |accumulator: Order, prefix: Bytes|
          match index_of(packages, prefix) {
            Some(j) -> visited(packages, accumulator, j, depth_left - 1),
            None -> accumulator,
          }),
    };
    { ..below, out: below.out.push(i) }
  }

pub fn path_packages(project: Project) -> List<String> / {abort.raise} = {
  let clo = closure(packages_of(project), project.sources.map(|source: Source| source.name));
  let order = visited(clo.packages, { seen: Map::new(), out: [] }, 0, clo.packages.len() + 1).out;
  let by_root = project.packages.fold(
    Map::new(),
    |accumulator: Map<String, DependencyPackage>, d: DependencyPackage|
      accumulator.insert(d.root, d),
  );
  order.fold([], |accumulator: List<String>, i: Int|
    if i == 0 { accumulator } else {
      match clo.packages.at(i) {
        None -> accumulator,
        Some(p) -> match by_root.get(String::of_bytes_lossy(p.root)) {
          Some(d) -> if in_place(d) { accumulator.push(d.dir) } else { accumulator },
          None -> accumulator,
        },
      }
    })
}

pub type Run = { display: String, result: CommandOutput }

fn worst(runs: List<Run>) -> Int =
  runs.fold(0, |accumulator: Int, r: Run| max(accumulator, r.result.code))

pub fn heading(style: Style, i: Int, display: String) -> List<String> =
  List::push(if i == 0 { [] } else { [""] }, indent() ++ bold(style, display))

pub fn combined(command: String, runs: List<Run>) -> CommandOutput = {
  let code = worst(runs);
  {
    json: object([
      { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
      { key: "command", value: Str(command) },
      { key: "workspace", value: Bool(true) },
      { key: "ok", value: Bool(code == 0) },
      { key: "exit_code", value: Number(Decimal::of_int(code)) },
      {
        key: "packages",
        value: Array(
          runs.map(|r: Run|
            object([
              { key: "root", value: Str(r.display) },
              { key: "answer", value: r.result.json },
            ])),
        ),
      },
    ]),
    lines: [],
    errs: runs.fold([], |accumulator: List<String>, r: Run|
      r.result.errs.fold(accumulator, |out: List<String>, l: String| out.push(l))),
    code: code,
  }
}

fn an_output(code: Int, line: String) -> CommandOutput =
  {
    json: object([{ key: "code", value: Number(Decimal::of_int(code)) }]),
    lines: [line],
    errs: [],
    code: code,
  }

test "a workspace run returns the highest exit code of its packages and prints a heading for each package" {
  let a = combined("check", [
    { display: "../lib", result: an_output(0, "lib's report") },
    { display: ".", result: an_output(2, "app's report") },
  ]);
  assert_eq(a.code, 2);
  assert_eq(a.lines, []);
  assert_eq(heading(plain(), 0, "../lib"), ["   ../lib"]);
  assert_eq(heading(plain(), 1, "."), ["", "   ."])
}

test "a package is run in place only when the walk read it from the directory it names" {
  let d: DependencyPackage = { root: "/x/lib", dir: "/x/lib", manifest: None, files: [] };
  assert(in_place(d));
  assert(!in_place({ ..d, dir: "/x/app/vendor/lib" }));
  assert(!in_place({ ..d, root: "git+https://h/lib@v1", dir: "/x/app/.ply-cache/git/lib" }));
  assert(
    !in_place({
      ..d,
      root: "/x/app/.ply-cache/registry/lib",
      dir: "/x/app/.ply-cache/registry/lib",
    }),
  )
}
