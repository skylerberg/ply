//! What a definition's hashes, its checked answer and a claim's verdict mean, as one version. What a
//! package publishes about its definitions, its interface and its attestations, is keyed by it, so two
//! builds that agree on it read each other's, and a build that changes what one of them means reads
//! none of the other's.

import std.bytes
import compiler.cc (toolchain)
import compiler.unit (shipped, identity_of, read_cached_file, write_cached_file)
import fingerprint (sample_program, fingerprint)
import std.fs
import std.fs (fs)
import std.path (strip_root)
import std.random (entropy)
import std.time (time)

/// The version, the head of what the meanings come to over the fingerprint's specimen: it moves with
/// every change to one of them the specimen reaches. Working it out analyses the specimen from
/// nothing, so a command that reads it in every run asks `semantics.cached` instead.
pub const fn version() -> String = fingerprint(sample_program()).slice(0, 8).hex_of()

/// What a command asks of the version where every run reads it. What answers is `caching`, which
/// `main` runs every command under. The answer is `version()`, so the effect is a deterministic one.
pub effect semantics {
  read cached() -> String
}

/// `body` with `semantics.cached` answered from the toolchain's cache, where the version is kept
/// under the identity of the code that works it out: worked out by the first process of a binary to
/// ask, and read back by every later one.
pub fn caching<a | e>(
  body: () -> a / {semantics.cached | e},
) -> a / {shipped.definitions, toolchain.bodies_dir, fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise | e} =
  handle {
    body()
  } with {
    var known: Option<String> = None,
    semantics.cached() -> match known {
      Some(v) -> v,
      None -> {
        let dir = strip_root(toolchain.bodies_dir()) ++ "/semantics";
        let key = identity_of(shipped.definitions(), [b"semantics.version"]);
        let v = match read_cached_file[abs](dir, key) {
          Some(bytes) -> String::of_bytes_lossy(bytes),
          None -> {
            let worked_out = version();
            write_cached_file[abs](dir, key, Bytes::of_string(worked_out));
            worked_out
          },
        };
        known = Some(v);
        v
      },
    },
  }

// A version the cache holds for this code is what every later process reads, worked out by none.
test "the version is read back from the toolchain's cache, under the identity of the code that works it out" {
  let definitions = b"semantics.version abc\n";
  let key = String::of_bytes(identity_of(definitions, [b"semantics.version"]));
  let tree = fs::mem_of([{ path: strip_root("/bodies") ++ "/semantics/" ++ key, body: b"cached" }]);
  let read = fs::on_mem[abs](tree, ||
    handle {
      caching(|| [semantics.cached(), semantics.cached()])
    } with {
      shipped.definitions() -> definitions,
      toolchain.bodies_dir() -> "/bodies",
      entropy.next() -> 0,
      time.now_ms() -> 0,
    });
  assert_eq(read.value, ["cached", "cached"])
}
