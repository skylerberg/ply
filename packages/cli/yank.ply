import args (Flags, no_flags, style_of)
import std.cli (Parsed)
import std.env (env)
import registry (base_of, exchange, post, rejected_by, response_message, token_variable,
                 registry_unreachable, unset, rejected_package, url_variable, yank_target)
import report (CommandOutput, indent, ok_code, reported)
import std.term (green)
import compiler.front.pkg (is_dotted_path)
import compiler.check.resolve.tables (Diagnostic)
import std.json (Json, Bool, Number, Str, object)
import std.net (net)
import std.pkg (parse_version)
import std.list

pub type Options = { name: String, version: String }

pub fn options_from(parsed: Parsed) -> Options =
  { name: parsed.positionals.at_or(0, ""), version: parsed.positionals.at_or(1, "") }

pub fn malformed(opts: Options) -> Option<Diagnostic> / {abort.raise} =
  if !is_dotted_path(opts.name) {
    Some(
      rejected_package("`" ++ opts.name ++ "` is not a package name", [
        b"a package name is lower-case identifier segments joined by dots",
      ]),
    )
  } else {
    match parse_version(opts.version) {
      None ->
        Some(
          rejected_package("`" ++ opts.version ++ "` is not a version", [
            b"a version reads like `0.2.0`",
          ]),
        ),
      Some(_) -> None,
    }
  }

pub fn run(
  flags: Flags,
  opts: Options,
) -> CommandOutput / {env.variable, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], abort.raise} = {
  let s = style_of(flags);
  match malformed(opts) {
    Some(d) -> reported(s, "yank", [d], []),
    None -> match env.variable(url_variable()) {
      None ->
        reported(s, "yank", [unset(url_variable(), "a yank needs the registry to send it to")], []),
      Some(text) -> match base_of(text) {
        Err(reason) -> reported(s, "yank", [registry_unreachable(reason, [])], []),
        Ok(base) -> match env.variable(token_variable) {
          None -> reported(s, "yank", [unset(token_variable, "a yank is made under a token")], []),
          Some(token) -> {
            let target = yank_target(base, opts.name, opts.version);
            match exchange(base, post(base, target, token)) {
              Err(d) -> reported(s, "yank", [d], []),
              Ok(result) -> if result.status == 200 {
                {
                  json: json_of(opts, base.url),
                  lines: [
                    indent ++ green(s, "yanked") ++ " " ++ opts.name ++ " " ++ opts.version
                      ++ " · "
                      ++ base.url,
                  ],
                  errs: [],
                  code: ok_code,
                }
              } else {
                reported(
                  s,
                  "yank",
                  [
                    rejected_by(
                      "yank `" ++ opts.name ++ "` " ++ opts.version,
                      result.status,
                      response_message(result),
                    ),
                  ],
                  [],
                )
              },
            }
          },
        },
      },
    },
  }
}

fn json_of(opts: Options, url: String) -> Json =
  object([
    { key: "command", value: Str("yank") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: Number(Decimal::of_int(ok_code)) },
    { key: "name", value: Str(opts.name) },
    { key: "version", value: Str(opts.version) },
    { key: "registry", value: Str(url) },
  ])

test "a yank accepts a package name and a version, and rejects any name that would escape the registry's path" {
  assert_eq(malformed({ name: "orders", version: "0.2.0" }), None);
  assert_eq(malformed({ name: "acme.billing", version: "10.0.1" }), None);
  match malformed({ name: "../orders", version: "0.2.0" }) {
    None -> panic("a name that climbs out of the registry's path was taken"),
    Some(d) -> assert_eq(d.code, b"E0145"),
  };
  match malformed({ name: "orders", version: "latest" }) {
    None -> panic("`latest` was taken for a version"),
    Some(d) -> assert(String::of_bytes_lossy(d.message).contains("is not a version")),
  }
}

test "an unset registry is rejected before anything is sent" {
  let result = handle {
    run(no_flags, { name: "orders", version: "0.2.0" })
  } with {
    env.variable(name) -> None,
    net.connect[registry](host, port, timeout_ms) -> panic("nothing may be sent"),
    net.connect_tls[registry](host, port, timeout_ms) -> panic("nothing may be sent"),
    net.handshake[registry](c) -> panic("nothing may be sent"),
    net.send[registry](c, payload, timeout_ms) -> panic("nothing may be sent"),
    net.recv[registry](c, max, timeout_ms) -> panic("nothing may be sent"),
    net.close[registry](c) -> panic("nothing may be sent"),
  };
  assert_eq(result.code, 2);
  assert(String::contains(match result.errs.at(0) { Some(l) -> l, None -> "" }, "E0141"))
}
