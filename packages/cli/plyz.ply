import artifact_builder (LibraryUnit)
import sources (File)
import compiler.front.rows (module_of)
import compiler.store.plyx (SectionLocation, Section, decode_library, digest_of, library_domain)
import std.bytes
import std.list
import std.string
import artifact_builder

pub fn source_frame(file: File) -> Bytes =
  Bytes::concat_all([
    b"module ",
    Bytes::of_string(file.module),
    b" ",
    Bytes::of_string(file.text.len().to_string()),
    b"\n",
    file.text,
  ])

pub fn sections(files: List<File>, manifest: Bytes, unit: LibraryUnit) -> List<Section> =
  [
    { name: b"sources", count: files.len(), payload: Bytes::concat_all(files.map(source_frame)) },
    { name: b"manifest", count: 1, payload: manifest },
    { name: b"unit", count: unit.count, payload: unit.payload },
  ]

pub type Module = { name: String, path: String, text: Bytes }

pub type ArchiveContents = { digest: Bytes, manifest: Bytes, modules: List<Module> }

pub fn unpack(b: Bytes) -> Result<ArchiveContents, String> / {abort.raise} =
  match decode_library(b) {
    Err(r) -> Err(String::of_bytes_lossy(r.message)),
    Ok(x) -> match digest_of(library_domain, b) {
      None -> Err("the archive is too short to contain a digest"),
      Some(d) -> if d != x.digest {
        Err("the archive's digest field is not the digest of its bytes")
      } else {
        match section_named(x.sections, b"manifest") {
          None -> Err("the archive contains no manifest"),
          Some(m) -> match section_named(x.sections, b"sources") {
            None -> Err("the archive contains no sources"),
            Some(s) -> match read_frames(
                artifact_builder::payload(b, s),
                s.count,
                0,
                [],
                s.count + 1,
              ) {
              Err(reason) -> Err(reason),
              Ok(modules) ->
                Ok({ digest: d, manifest: artifact_builder::payload(b, m), modules: modules }),
            },
          },
        }
      },
    },
  }

fn section_named(sections: List<SectionLocation>, name: Bytes) -> Option<SectionLocation> =
  sections.fold(None, |found: Option<SectionLocation>, p: SectionLocation|
    match found { Some(_) -> found, None -> if p.name == name { Some(p) } else { None } })

fn read_frames(
  section: Bytes,
  count: Int,
  at: Int,
  out: List<Module>,
  left: Int,
) -> Result<List<Module>, String> / {abort.raise} =
  if left <= 0 { panic("more frames than asked for") } else {
    if out.len() == count {
      if at == section.len() { Ok(out) }
      else { Err("the sources section runs on past its last module") }
    } else {
      match frame_at(section, at) {
        Err(reason) -> Err(reason),
        Ok(f) -> read_frames(section, count, f.next, out.push(f.module), left - 1),
      }
    }
  }

fn frame_at(
  section: Bytes,
  at: Int,
) -> Result<{ module: Module, next: Int }, String> / {abort.raise} =
  if !section.slice(at, section.len()).starts_with(b"module ") {
    Err("a module in the sources section is not framed `module <name> <length>`")
  } else {
    match section.index_of_from(b"\n", at) {
      None -> Err("a module's frame in the sources section never ends"),
      Some(nl) -> {
        let head = String::of_bytes_lossy(section.slice(at + 7, nl));
        match head.split(" ") {
          [name, size] -> match length_of(size) {
            None -> Err("the module `" ++ name ++ "` is framed with no length"),
            Some(n) -> if nl + 1 + n > section.len() {
              Err("the module `" ++ name ++ "` runs past the end of the sources section")
            } else {
              match path_of(name) {
                Err(reason) -> Err(reason),
                Ok(path) ->
                  Ok({
                    module: { name: name, path: path, text: section.slice(nl + 1, nl + 1 + n) },
                    next: nl + 1 + n,
                  }),
              }
            },
          },
          _ -> Err("a module in the sources section is not framed `module <name> <length>`"),
        }
      },
    }
  }

fn path_of(name: String) -> Result<String, String> / {abort.raise} = {
  let path = slashed(name) ++ ".ply";
  match module_of(path) {
    Ok(back) -> if back == name { Ok(path) }
    else { Err("`" ++ name ++ "` is not a module name a package can contain") },
    Err(reason) -> Err("`" ++ name ++ "` is not a module name a package can contain: " ++ reason),
  }
}

fn slashed(name: String) -> String =
  name.split(".").fold("", |accumulator: String, part: String|
    if accumulator == "" { part } else { accumulator ++ "/" ++ part })

fn length_of(text: String) -> Option<Int> / {abort.raise} =
  if text.len() > 12 || text.starts_with("-") { None } else { text.int_of_string() }

fn a_file(module: String, text: Bytes) -> File = {
  let path = slashed(module) ++ ".ply";
  { path: path, module: module, text: text, at: { label: "cwd", path: path } }
}

const nothing_compiled: LibraryUnit =
  { head: { frontend: b"", runtime: b"", entry: b"" }, count: 0, payload: b"" }

test "a library archive stores each module's source text preceded by a header with the module's name and length" {
  let first = a_file("core", b"pub fn double(n: Int) -> Int = n * 2\n");
  assert_eq(
    source_frame(first),
    Bytes::concat_all([b"module core 37\n", b"pub fn double(n: Int) -> Int = n * 2\n"]),
  );
  let parts = sections([first, a_file("math", b"pub fn half(n: Int) -> Int = n / 2\n")], b"m", {
    ..nothing_compiled,
    count: 1,
    payload: b"unit",
  });
  assert_eq(parts.map(|x: Section| x.name), [b"sources", b"manifest", b"unit"]);
  assert_eq(parts.get(0).count, 2);
  assert_eq(parts.get(1).payload, b"m");
  assert_eq(parts.get(2).payload, b"unit")
}

test "reading the stored module sources gives back each module's name, file path and text" {
  let files = [a_file("core", b"pub fn one() -> Int = 1\n"), a_file("util.math", b"")];
  let section = Bytes::concat_all(files.map(source_frame));
  match read_frames(section, 2, 0, [], 3) {
    Err(reason) -> panic(reason),
    Ok(modules) -> {
      assert_eq(modules.map(|module: Module| module.name), ["core", "util.math"]);
      assert_eq(modules.map(|module: Module| module.path), ["core.ply", "util/math.ply"]);
      assert_eq(modules.get(0).text, b"pub fn one() -> Int = 1\n");
      assert_eq(modules.get(1).text, b"")
    },
  }
}

test "reading stored module sources fails on a wrong length, an invalid module name or a wrong module count" {
  let one = source_frame(a_file("core", b"x"));
  assert(read_frames(one.concat(b"junk"), 1, 0, [], 2) != Ok([]));
  match read_frames(b"module core 99\nx", 1, 0, [], 2) {
    Ok(_) -> panic("a length past the end was believed"),
    Err(reason) -> assert(reason.contains("runs past the end")),
  };
  match read_frames(b"module ..evil 1\nx", 1, 0, [], 2) {
    Ok(_) -> panic("a name that leaves the package was believed"),
    Err(reason) -> assert(reason.contains("is not a module name")),
  };
  match read_frames(one, 2, 0, [], 3) {
    Ok(_) -> panic("a count the section does not contain was believed"),
    Err(_) -> (),
  }
}
