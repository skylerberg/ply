//! What a command answers with: one JSON document for `--json`, the lines it would print instead,
//! and the code the run exits with. One shape for every command, so an agent can key off `command`
//! and `exit_code`.

import compiler.check.resolve.tables (Diag)
import diagnostic (Place, all_to_json, all_to_text, errors_of)
import std.json (Json, Member, Object, Str, Bool, Number, Array, object, int)
import compiler.store.memo (Tally)
import std.term (Style, plain, dim, red, yellow)
import std.process (process)
import std.time (time)
import proof.obligation (plural)

/// Lines for stdout, lines for stderr, and the code. None of them end in a newline.
pub type Answer = { json: Json, lines: List<String>, errs: List<String>, code: Int }

pub fn indent() -> String = "   "

/// What a document's `front_end` says of the memo run that answered its load: each query it asked
/// with the answers it took as kept and the bodies it ran, whether the store vouched for any
/// record to this `ply` when the load opened it, and how many answers the load made again that a
/// standing record named and no store held.
pub fn reuse_members(tallies: List<Tally>, vouched: Bool, lost: Int) -> List<Member> =
  tally_members(tallies, lost).push({ key: "vouched", value: Bool(vouched) })

/// Each query a memo run asked, with the answers it took as kept, the bodies it ran and of those the
/// answers it made again because no store held them, and that last count over every query.
pub fn tally_members(tallies: List<Tally>, lost: Int) -> List<Member> =
  [
    {
      key: "queries",
      value: Array(
        tallies.map(|t: Tally|
          object([
            { key: "query", value: Str(String::of_bytes_lossy(t.query)) },
            { key: "taken", value: int(t.took) },
            { key: "run", value: int(t.ran) },
            { key: "lost", value: int(t.lost) },
          ])),
      ),
    },
    { key: "lost", value: int(lost) },
  ]

/// `a` with `members` under its document's `front_end`, beside what that holds.
pub fn with_front_end(a: Answer, members: List<Member>) -> Answer =
  match a.json {
    Object(held) -> {
      let front = match held.get("front_end") { Some(Object(f)) -> f, _ -> Map::new() };
      {
        ..a,
        json: Object(
          held.insert(
            "front_end",
            Object(
              members.fold(front, |acc: Map<String, Json>, m: Member| acc.insert(m.key, m.value)),
            ),
          ),
        ),
      }
    },
    _ -> a,
  }

pub fn schema_version() -> Int = 1

pub fn ok_code() -> Int = 0

pub fn compile_error() -> Int = 2

pub fn count_of(n: Int, word: String) -> String / {abort.raise} =
  n.to_string() ++ " " ++ plural(n, word)

fn severity_label(style: Style, severity: Bytes) -> String =
  if severity == b"error" { red(style, "error") }
  else if severity == b"warning" { yellow(style, "warning") }
  else { dim(style, "note") }

/// Cache and scheduling trouble is one indented line each, not a full report.
pub fn warning_lines(style: Style, diags: List<Diag>) -> List<String> =
  diags.fold([], |acc: List<String>, diag: Diag|
    diag.notes_text.fold(
      acc.push(
        indent() ++ severity_label(style, diag.severity) ++ ": "
          ++ String::of_bytes_lossy(diag.message),
      ),
      |a: List<String>, n: Bytes|
        a.push(indent() ++ "  " ++ dim(style, "=") ++ " " ++ String::of_bytes_lossy(n)),
    ))

/// The same lines set apart under the rest of a report by a blank one, or nothing when there are
/// none.
pub fn warned_lines(style: Style, diags: List<Diag>) -> List<String> =
  if diags.len() == 0 { [] }
  else { warning_lines(style, diags).fold([""], |acc: List<String>, l: String| acc.push(l)) }

/// Diagnostics in the command's own shape, and always exit 2.
pub fn reported(
  style: Style,
  command: String,
  diags: List<Diag>,
  places: List<Place>,
) -> Answer / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str(command) },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: Number(Decimal::of_int(compile_error())) },
      { key: "diagnostics", value: all_to_json(diags, places) },
    ]),
    lines: [],
    errs: all_to_text(style, diags, places),
    code: compile_error(),
  }

/// A program that did not load: the same, with the tally the load prints under it.
pub fn refused(
  style: Style,
  command: String,
  diags: List<Diag>,
  places: List<Place>,
) -> Answer / {abort.raise} = {
  let answer: Answer = reported(style, command, diags, places);
  let errors = errors_of(diags).len();
  let tally = indent() ++ red(style, "compilation failed") ++ " (" ++ count_of(errors, "error")
    ++ ")";
  { ..answer, errs: answer.errs.push(tally) }
}

pub fn printed(lines: List<String>) -> Unit / {process.out[proc]} =
  lines.fold((), |_: Unit, line: String| process.out[proc](line))

/// Prints to standard error how long `step` took since `since`, when `phases` is on. Each step
/// prints as it finishes, so a long run shows its progress and a failed one shows how far it got.
pub fn timed(
  phases: Bool,
  step: String,
  since: Int,
) -> Unit / {process.err[proc], time.elapsed_ms} =
  if phases {
    process.err[proc]("phases: " ++ step ++ " " ++ (time.elapsed_ms() - since).to_string() ++ "ms")
  } else { () }

// --- Tests ------------------------------------------------------------------

test "a step's time prints when it finishes if phases are on, and not otherwise" {
  let told = |phases: Bool|
    handle {
      timed(phases, "built `ply`", 10)
    } with {
      var lines: List<String> = [],
      process.err[proc](line) -> {
        lines = lines.push(line);
        ()
      },
      time.elapsed_ms() -> 35,
      return _done -> lines,
    };
  assert_eq(told(true), ["phases: built `ply` 25ms"]);
  assert_eq(told(false), [])
}

test "a plural is the word for one and the word plus `s` otherwise, with `y` becoming `ies`" {
  assert_eq(plural(1, "definition"), "definition");
  assert_eq(plural(2, "definition"), "definitions");
  assert_eq(plural(0, "module"), "modules");
  assert_eq(plural(2, "entry"), "entries");
  assert_eq(plural(2, "day"), "days");
  assert_eq(count_of(1, "error"), "1 error");
  assert_eq(count_of(3, "test"), "3 tests")
}

test "a refusal is exit 2, one JSON document, and the count on the last line" {
  let d: Diag = {
    code: b"E0201",
    notes: 0,
    labels: [],
    text: b"",
    message: b"type mismatch",
    notes_text: [],
    severity: b"error",
    fixes: [],
  };
  let answer = refused(plain(), "defs", [d], []);
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, []);
  assert_eq(answer.errs, ["Error[E0201]: type mismatch", "   compilation failed (1 error)"])
}

test "a warning is one indented line, and each note one under it" {
  let d: Diag = {
    code: b"W0611",
    notes: 1,
    labels: [],
    text: b"",
    message: b"fn `m.dead` is never used",
    notes_text: [b"delete it or export it"],
    severity: b"warning",
    fixes: [],
  };
  assert_eq(warning_lines(plain(), [d]), [
    "   warning: fn `m.dead` is never used",
    "     = delete it or export it",
  ])
}

test "warnings set apart are a blank line and then each warning's own, and no warning is nothing" {
  let d: Diag = {
    code: b"W0609",
    notes: 0,
    labels: [],
    text: b"",
    message: b"1 span was still open when its task or the entry point ended: `a` on `c`",
    notes_text: [],
    severity: b"warning",
    fixes: [],
  };
  assert_eq(warned_lines(plain(), [d]), [
    "",
    "   warning: 1 span was still open when its task or the entry point ended: `a` on `c`",
  ]);
  assert_eq(warned_lines(plain(), []), [])
}
