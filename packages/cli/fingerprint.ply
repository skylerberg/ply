import std.bin
import std.bytes
import std.list
import compiler.front.published (no_rows, PublishedInterface, interfaces_of, rows_of)
import compiler.front.emitter_input (Analysed, Rejected)
import compiler.front.facts (Analysis)
import compiler.front (EmbedRecord, analyse_pulling_std_with)
import compiler.front.rows (KnownTestRow, known_test_row_bin)
import compiler.front.interface (interface_of, interface_bin)
import compiler.expand.embed (embed_file)
import compiler.check.resolve.tables (Source)
import proof.decide (Certified, GuardRefuted, StaticResult, Undecided, Unwitnessed)
import proof.goal (default_prove_budget)
import proof.static_prover (claims_for, modules_of, prover_of, static_result)
import proof.prover_input (Every, NotEnumerable, Bounded, Interleave, Obligation, Points, Run,
                           Static, Strategy, Unhandled, prover_input_of)

pub fn sample_program() -> List<Source> =
  [
    { name: b"shapes", source_text: Bytes::of_string(shapes()) },
    { name: b"store", source_text: Bytes::of_string(store_source()) },
    { name: b"raises", source_text: Bytes::of_string(raises_source()) },
    { name: b"holds", source_text: Bytes::of_string(scoped_source()) },
    { name: b"words", source_text: b"pub fn words() -> Bytes = embed(\"words.txt\")\n" },
    { name: b"pulls", source_text: b"import std.fp (used)\npub fn through() -> Int = used()\n" },
  ]

fn sample_library_sources() -> List<Source> =
  [
    {
      name: b"std.fp",
      source_text: Bytes::of_string(
        \\pub fn used() -> Int = spare() + 1
        \\
        \\fn spare() -> Int = 1
        \\
        \\pub fn unused() -> Int = 2
        \\
        \\test "used is two" {
        \\  assert_eq(used(), 2)
        \\}
        \\
        \\law "unused is positive" forall (n: Int) { unused() > 0 }
        \\
      ),
    },
  ]

fn shapes() -> String =
  \\pub type Shape = | Circle(Int) | Rect(Int, Int)
  \\
  \\pub type Point = { x: Int, y: Int }
  \\
  \\pub type Stamp = new { at: Int }
  \\
  \\pub fn stamped(n: Int) -> Stamp = { at: n }
  \\
  \\pub fn area(s: Shape) -> Int = match s { Circle(r) -> 3 * r * r, Rect(w, h) -> w * h }
  \\
  \\pub fn side(s: Shape) -> Int = match s { Circle(n) | Rect(_, n) -> n }
  \\
  \\pub fn spread(a: Int, b: Int) -> Int = {
  \\  let w = a + 0;
  \\  let h = b + 0;
  \\  let hw = w / 2;
  \\  let hh = h / 2;
  \\  hw - hh
  \\}
  \\
  \\pub fn moved(p: Point, dx: Int) -> Point = { ..p, x: p.x + dx }
  \\
  \\pub fn total(xs: List<Int>) -> Int
  \\  cost xs.len()
  \\= xs.fold(0, |acc: Int, x: Int| acc + x)
  \\
  \\pub fn ratio(a: Int, b: Int) -> Int / {abort.raise} = a / b
  \\
  \\pub fn apply<a, b | e>(x: a, f: (a) -> b / e) -> b / e = f(x)
  \\
  \\pub fn count(xs: List<Int>) -> Int = match xs { [] -> 0, [_, ..rest] -> 1 + count(rest) }
  \\
  \\pub fn spin(n: Int) -> Int / {diverges} = spin(n)
  \\
  \\pub fn shrink(n: Int) -> Int
  \\  decreases n
  \\= if n <= 1 { 0 } else { 1 + shrink(n * 2 / 3) }
  \\
  \\pub fn waits(n: Int) -> Int / {diverges} = spin(n)
  \\
  \\pub fn rest(xs: List<Int>) -> List<Int> / {abort.raise} = match xs { [_, ..r] -> r, [] -> panic("empty") }
  \\
  \\pub fn nonempty(xs: List<List<Int>>) -> List<List<Int>> = xs.filter(|x: List<Int>| x.len() > 0)
  \\
  \\pub fn nothing() -> List<Int> = []
  \\
  \\pub fn zeroed(a: Array<Int>) -> Array<Int> / {abort.raise} = a.set(0, 0)
  \\
  \\pub fn size(xs: List<Int>) -> Int = xs.len()
  \\
  \\pub fn half(n: Int) -> Int = n / 2
  \\
  \\pub fn wrapped(n: Int, m: Int) -> Int / {abort.raise} = n % m
  \\
  \\pub fn held(f: keep (Int) -> Int) -> List<(Int) -> Int> = [f]
  \\
  \\pub fn bump(x: Int) -> Int
  \\  requires x < 100
  \\  ensures result > x
  \\= x + 1
  \\
  \\pub fn same(x: Int) -> Int ensures result == x = x
  \\
  \\pub transparent fn double(x: Int) -> Int = x + x
  \\
  \\pub fn digits(n: Int) -> List<Int>
  \\  returns fresh
  \\= range(0, n)
  \\
  \\pub fn kept(xs: List<Int>) -> List<Int>
  \\  returns xs
  \\= xs
  \\
  \\pub type Span = | Span(Int, Int)
  \\
  \\key for Span by length
  \\
  \\show for Span by written
  \\
  \\pub fn length(s: Span) -> Int = match s { Span(a, b) -> b - a }
  \\
  \\pub fn written(s: Span) -> String = "span"
  \\
  \\numeric for Span by { add: joined, sub: joined, mul: joined, neg: turned, of_int: reach }
  \\
  \\pub fn joined(a: Span, b: Span) -> Span = a
  \\
  \\pub fn turned(s: Span) -> Span = s
  \\
  \\pub fn reach(n: Int) -> Span = Span(0, n)
  \\
  \\law "a span joined to another keeps its length" forall (a: Int) where a > 0 && a < 9 { Span(0, a) + Span(2, 9) == Span(1, a + 1) }
  \\
  \\law "spans of one length are equal" forall (a: Int) where a > 0 && a < 9 { Span(0, a) == Span(1, a + 1) }
  \\
  \\test "area" { assert_eq(area(Rect(2, 3)), 6) }
  \\
  \\law "bump grows" forall (x: Int) where x < 100 { bump(x) > x }
  \\
  \\law "a small total" forall (b: Bool) { total(if b { [1] } else { [] }) <= 1 }
  \\

fn store_source() -> String =
  \\import shapes
  \\
  \\pub effect db {
  \\  read get[t](k: Int) -> Int
  \\  write put[t](k: Int, v: Int) -> Unit
  \\}
  \\
  \\pub effect set Users = {db.read[users], db.write[users]}
  \\
  \\pub fn lookup(k: Int) -> Int / {db.get[users] bounded} = db.get[users](k)
  \\
  \\pub fn stored(k: Int, v: Int) -> Unit / {Users} = db.put[users](k, v)
  \\
  \\pub fn relay<[l]>(k: Int) -> Int / {db.get[l]} = db.get[l](k)
  \\
  \\pub type Held<a, [l] | e> = | Held((a) -> Int / {db.get[l] | e})
  \\
  \\pub type Getter<[l]> = (Int) -> Int / {db.get[l]}
  \\
  \\pub fn opened<[l] | e>(h: Held<Int, [l] | e>, k: Int) -> Int / {db.get[l] | e} = match h { Held(f) -> f(k) }
  \\
  \\pub fn got<[l]>(g: Getter<[l]>, k: Int) -> Int / {db.get[l]} = g(k)
  \\
  \\pub fn handled(k: Int) -> Int =
  \\  handle { lookup(k) } with { db.get[users](q) -> q + shapes::bump(1) }
  \\

fn raises_source() -> String =
  \\pub effect parse {
  \\  raise bad(at: Int)
  \\  raise eof()
  \\}
  \\
  \\pub fn digit(b: Int) -> Int / {parse.bad} = if b < 48 { parse.bad(b) } else { b - 48 }
  \\
  \\pub fn checked(b: Int) -> Result<Int, Int> = try { digit(b) }
  \\
  \\pub fn ended(b: Int) -> Result<Int, Unit> / {parse.bad} =
  \\  try[parse.eof] { if b == 0 { parse.eof() } else { digit(b) } }
  \\

fn scoped_source() -> String =
  \\pub effect io {
  \\  write close(n: Int) -> Unit
  \\}
  \\
  \\pub fn peek<[r]>(h: Scoped<Int, [r]>) -> Int / {scoped.read[r]} = h.get()
  \\
  \\pub fn held(n: Int) -> Int / {io.close} =
  \\  with_scope[file](n, |x: Int| io.close(x)) { h -> peek(h) }
  \\

fn embedded() -> List<EmbedRecord> =
  [
    {
      root: b"",
      module: b"words",
      want: { path: b"words.txt", dir: false },
      read: Ok([embed_file(b"", b"one two\n")]),
    },
  ]

fn line(parts: List<Bytes>) -> Bytes =
  parts.fold(b"", |accumulator: Bytes, p: Bytes|
    if accumulator.len() == 0 { p } else { Bytes::concat_all([accumulator, b" ", p]) }).concat(
    b"\n",
  )

fn hex(b: Bytes) -> Bytes / {abort.raise} = Bytes::of_string(b.hex_of())

fn stored_interfaces(w: Analysis) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    interfaces_of(w.checked, w.hashes).map(|d: PublishedInterface|
      line([b"def", d.name, hex(d.hash), hex(d.interface)])),
  ).concat(
    Bytes::concat_all(
      rows_of(w).tests.map(|t: KnownTestRow|
        line([b"test", t.key, hex(t.hash), hex(bin::encode(t, known_test_row_bin()))])),
    ),
  )

fn points_word(p: Points) -> Bytes =
  match p { Every(_, what) -> Bytes::of_string(what), NotEnumerable -> b"unwalked" }

fn strategy_word(s: Strategy) -> Bytes =
  match s {
    Interleave(p) -> b"interleave:".concat(points_word(p)),
    Static(Unhandled(row)) -> b"static:unhandled:".concat(Bytes::of_string(row)),
    Static(Run(p)) -> b"static:run:".concat(points_word(p)),
    Bounded -> b"bounded",
  }

fn verdict_word(s: StaticResult) -> Bytes =
  match s {
    Certified(_) -> b"certified",
    Unwitnessed(_) -> b"unwitnessed",
    GuardRefuted -> b"guard-refuted",
    Undecided(_) -> b"undecided",
  }

fn verdicts(analysis: Analysis) -> Bytes / {abort.raise} = {
  let built = prover_input_of(analysis, |m: Bytes| true);
  let os = built.world.obligations;
  let p = prover_of(
    claims_for(analysis, modules_of(analysis, os)),
    built.world,
    default_prove_budget(),
  );
  Bytes::concat_all(
    os.map(|o: Obligation|
      line([
        Bytes::of_string(o.owner),
        Bytes::of_string(o.key),
        Bytes::of_string(o.run_key),
        strategy_word(o.strategy),
        verdict_word(static_result(p, o)),
      ])),
  )
}

pub fn fingerprint(sources: List<Source>) -> Bytes / {abort.raise} =
  match analyse_pulling_std_with(
      sources,
      sample_library_sources(),
      no_rows(),
      { root: b"", manifest: None, supplied: [] },
      embedded(),
    ).out {
    Rejected(_) ->
      panic(
        "the built-in sample program used to compute the interface checksum does not pass the checker",
      ),
    Analysed(w) ->
      Bytes::concat_all([
        stored_interfaces(w),
        Bytes::concat_all(w.hashes.laws.values().map(|h: Bytes| line([b"law", hex(h)]))),
        Bytes::concat_all(
          w.hashes.specs.map(|source: { name: Bytes, hashes: List<Bytes> }|
            line(source.hashes.map(hex).push(source.name))),
        ),
        bin::encode(
          interface_of(
            w,
            sources.concat(sample_library_sources()),
            sources.concat(sample_library_sources()).map(|source: Source| source.name),
          ),
          interface_bin(),
        ),
        verdicts(w),
      ]).blake3(
      ),
  }

fn replace_once(source: Bytes, was: Bytes, now: Bytes) -> Bytes / {abort.raise} =
  match source.index_of(was) {
    Some(i) ->
      Bytes::concat_all([source.slice(0, i), now, source.slice(i + was.len(), source.len())]),
    None -> panic("the sample program does not contain the text the edit should replace"),
  }

test "a program's fingerprint changes when the code of a function body changes" {
  let moved = sample_program().map(|source: Source|
    if source.name == b"shapes" {
      { ..source, source_text: replace_once(source.source_text, b"x + 1", b"x + 2") }
    } else { source });
  assert(fingerprint(moved) != fingerprint(sample_program()))
}
