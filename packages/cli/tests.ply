fn a_source_texts() -> List<SourceText> =
  [{ path: "m.ply", text: b"test \"two is two\" { assert_eq(1 + 1, 2) }\n" }]

fn no_phases() -> Phases = { read_us: 0, front_end_us: 0, write_back_us: 0 }

fn a_hash() -> String = "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"

fn a_key(index: Int, label: String, returned: Bool, seeded: Bool, unstable: Bool) -> select::Case =
  {
    index: index,
    label: label,
    name: "m." ++ label,
    module: "m",
    hash: Some(b"\xab".repeat(32)),
    cache_key: Some(b"\xab".repeat(32)),
    seeded: seeded,
    nondet: unstable,
    cached: if returned { Some(Passing) } else { None },
    pending_seeds: None,
  }

fn a_search() -> Search = { mode: "dpor", roots: [0], budget: 256, steps: 100000, path: [] }

fn a_case(index: Int, name: String) -> Case =
  {
    index: index,
    entry: entry_of(index, Bytes::of_string("m." ++ name)),
    key: "m." ++ name,
    name: name,
    module: "m",
    nondet: false,
    hash: Some(a_hash()),
    effects: "{}",
    listed: [],
    seeded: false,
  }

fn a_decided(program: Program, keys: List<select::Case>) -> RunDecision / {abort.raise} = {
  let decisions = decide(keys);
  let classes = classes_of(program, to_run(decisions));
  run_decision_of(
    program,
    decisions,
    a_search(),
    Null,
    classes.map(|class: List<Int>| { tests: class, effects: "{}" }),
    classes,
  )
}

fn an_opening() -> Opening = { operations: 0, digest: "", tests_using_host: [], workers: 4 }

fn a_test_run() -> TestRun / {abort.raise} = tester::start_run(options_from(parsed(["test"])))

fn scoped(w: CheckedProgram, argv: List<String>) -> Scope / {abort.raise} =
  scope_of(
    w,
    from_argv("test", argv).filters,
    options_from(parsed(["test"].concat(argv))).shard,
    None,
  )

fn selected_case_indices(
  w: CheckedProgram,
  argv: List<String>,
  named: Option<List<String>>,
) -> List<Int> / {abort.raise} = over_cases(w, from_argv("test", argv).filters, named)

fn a_program(cases: List<Case>) -> Program / {abort.raise} =
  {
    root: "/p",
    files: ["m.ply"],
    places: a_source_texts(),
    modules: [{ name: "m", file: "m.ply" }],
    loaded_from_cache: true,
    phases: no_phases(),
    reused_members: [],
    declared: cases.len(),
    cases: cases,
    positions: placed_cases(cases),
    filtered_out: 0,
    warnings: [],
    options: Null,
    cache_stamp: Some("aabbccddeeff00112233"),
    unit: tester::empty_test_unit(a_test_run()),
  }

fn an_outcome(index: Int, name: String, status: String) -> Outcome =
  {
    index: index,
    name: name,
    hash: None,
    duration_us: 1500,
    status: status,
    diagnostic: None,
    search: None,
    cached: Some(true),
    performs: 0,
  }

fn a_run(results: List<Outcome>, failed: Int) -> RunReport =
  {
    operations: 0,
    digest: "",
    handshakes: [],
    hosts: Null,
    tests_using_host: [],
    workers: 4,
    backend: None,
    results: results,
    failures: [],
    summary: {
      passed: results.filter(|outcome: Outcome| outcome.status == "passed").len(),
      failed: failed,
      timed_out: results.filter(|outcome: Outcome| outcome.status == "timed_out").len(),
      cached: 0,
      duration_us: 20000,
    },
    simulation: {
      simulated: 0,
      total: results.len(),
      seeds: 0,
      interleavings: 0,
      exhaustive: 0,
      exhausted: 0,
      failed: 0,
    },
    unbound_pass_diagnostics: [],
    warnings: [],
    coverage: None,
    spent: no_time_spent(),
  }

fn a_fault() -> Fault =
  {
    key: "m.two is two",
    name: "two is two",
    diagnostic: {
      diagnostic: error_with_labels(b"E0502", b"assertion failed", [], []),
      values: [],
    },
    internal_error: false,
    changes: [],
    unchanged: false,
    seed: None,
    race: None,
    replay: None,
    module: Some("m"),
    test_hash: None,
    nondet: Some(false),
    status: Some("failed"),
    declared: None,
  }

fn a_change(name: String) -> RankedChange =
  { name: name, hash: None, before: None, change: None, test: false }

fn a_failed() -> Failed =
  {
    key: "m.two is two",
    name: "two is two",
    diagnostic: {
      diagnostic: error_with_labels(b"E0501", b"assertion failed", [], []),
      values: [],
    },
    internal_error: false,
    changes: [{ name: "m.b", hash: Some("b2") }, { name: "m.a", hash: Some("a2") }],
    unchanged: false,
    seed: None,
    race: None,
    module: Some("m"),
    test_hash: None,
    nondet: Some(false),
    status: Some("failed"),
    declared: None,
  }

test "a passing run exits with 0, and before the tests run it prints how many tests were selected out of the total" {
  let p = a_program([a_case(0, "one"), a_case(1, "two")]);
  let keys = [a_key(0, "one", false, false, false), a_key(1, "two", true, false, false)];
  let opening = opening_lines(plain(), from_argv("test", []), p, a_decided(p, keys), an_opening());
  assert_eq(opening, [
    "   selected 1 of 2 (1 cached)",
    "   1 group · 4 workers",
    "   2 of 2 tests are isolated",
    "",
  ]);
  let result = test_output(
    plain(),
    from_argv("test", []),
    p,
    a_run([an_outcome(0, "one", "passed")], 0),
    [],
    [],
    a_decided(p, keys),
  );
  assert_eq(result.code, 0);
  assert(!result.lines.contains("   selected 1 of 2 (1 cached)"));
  assert_eq(result.lines.filter(|l: String| l.starts_with("   ok ")), []);
  assert_eq(result.errs, [])
}

test "a failing run exits with 1, and each changed definition that a failure names is printed once after all the failures" {
  let p = a_program([a_case(0, "two is two"), a_case(1, "three is three")]);
  let keys = [
    a_key(0, "two is two", false, false, false),
    a_key(1, "three is three", false, false, false),
  ];
  let suspected = { ..a_fault(), changes: [{ ..a_change("m.total"), change: Some(Edited) }] };
  let total = {
    name: "m.total",
    change: Edited,
    at: None,
    diff: Some(
      "--- m.total\n+++ m.total\n@@ -1 +1 @@\n-fn total() -> Int = 1\n+fn total() -> Int = 2\n",
    ),
  };
  let result = test_output(
    plain(),
    from_argv("test", []),
    p,
    a_run([an_outcome(0, "two is two", "failed"), an_outcome(1, "three is three", "failed")], 2),
    [suspected, { ..suspected, key: "m.three is three", name: "three is three" }],
    [total, { ..total, name: "m.gone", diff: None }],
    a_decided(p, keys),
  );
  assert_eq(result.code, 1);
  assert(result.lines.contains("   m.two is two"));
  assert(result.lines.contains("     assertion failed"));
  assert_eq(result.lines.filter(|l: String| l == "     changes: m.total (edited)").len(), 2);
  let from = match result.lines.index_of("   changed since the failing tests last passed:") {
    Some(i) -> i,
    None -> panic("the changes follow the failures"),
  };
  assert_eq(result.lines.drop(from + 1), [
    "     m.total (edited)",
    "       @@ -1 +1 @@",
    "       -fn total() -> Int = 1",
    "       +fn total() -> Int = 2",
    "     m.gone (edited)",
    "       its text from when the test last passed is not stored",
  ])
}

test "the JSON output contains the full diff of each changed definition once, next to the failures that name it" {
  let p = a_program([a_case(0, "two is two")]);
  let keys = [a_key(0, "two is two", false, false, false)];
  let text = to_string(
    test_output(
      plain(),
      from_argv("test", ["--json"]),
      p,
      a_run([an_outcome(0, "two is two", "failed")], 1),
      [{ ..a_fault(), changes: [{ ..a_change("m.total"), change: Some(Edited) }] }],
      [{ name: "m.total", change: Edited, at: None, diff: Some("--- m.total\n+++ m.total\n") }],
      a_decided(p, keys),
    ).json,
  );
  assert(
    text.contains(
      "\"diffs\":[{\"change\":\"edited\",\"diff\":\"--- m.total\\n+++ m.total\\n\",\"location\":null,\"name\":\"m.total\"}]",
    ),
    Some(text),
  )
}

test "a long diff is cut, and says how much was left out" {
  let p = a_program([a_case(0, "two is two")]);
  let keys = [a_key(0, "two is two", false, false, false)];
  let long = range(0, 50).fold("--- m.big\n+++ m.big\n", |accumulator: String, i: Int|
    accumulator ++ "+line " ++ i.to_string() ++ "\n");
  let result = test_output(
    plain(),
    from_argv("test", []),
    p,
    a_run([an_outcome(0, "two is two", "failed")], 1),
    [a_fault()],
    [{ name: "m.big", change: Edited, at: None, diff: Some(long) }],
    a_decided(p, keys),
  );
  assert(result.lines.contains("       +line 39"));
  assert(!result.lines.contains("       +line 40"));
  assert(result.lines.contains("       … 10 more lines"))
}

test "a failure's changes lead with the edits since its test last passed" {
  let d = {
    own: None,
    changes: [edited("m.b", "b1", "b2"), derived("m.a", "a1", "a2"), edited("m.c", "c1", "c2")],
  };
  assert_eq(fault_of(a_failed(), Some(d)).changes.map(change_text), [
    "m.b (edited)",
    "m.c (edited)",
    "m.a (derived)",
  ]);
  assert_eq(fault_of(a_failed(), None).changes.map(change_text), ["m.a", "m.b"])
}

test "a test stopped by the timeout is reported as timed out rather than failed, and the run does not succeed" {
  let p = a_program([a_case(0, "slow")]);
  let keys = [a_key(0, "slow", false, false, false)];
  let stopped = {
    ..an_outcome(0, "slow", "timed_out"),
    diagnostic: Some({
      diagnostic: error_with_labels(b"E0504", b"the run timed out", [], [b"raise the clock"]),
      values: [],
    }),
  };
  let result = test_output(
    plain(),
    from_argv("test", []),
    p,
    a_run([stopped], 0),
    [],
    [],
    a_decided(p, keys),
  );
  assert_eq(result.code, 1);
  assert(result.lines.contains("   slow timed out"));
  assert(result.lines.contains("     the run timed out"));
  assert(result.lines.contains("     = raise the clock"))
}

test "`test` exits with code 1 when a cached passing result could reach the host, even if every test passes" {
  let p = a_program([a_case(0, "one")]);
  let keys = [a_key(0, "one", false, false, false)];
  let escaped = {
    ..a_run([an_outcome(0, "one", "passed")], 0),
    unbound_pass_diagnostics: [
      error_with_labels(b"E0001", b"`m.one` can reach the host binding", [], []),
    ],
  };
  assert_eq(
    test_output(plain(), from_argv("test", []), p, escaped, [], [], a_decided(p, keys)).code,
    1,
  )
}

test "a result line pads the test name to the column width and shows the duration with one decimal" {
  let p = a_program([a_case(0, "two is two")]);
  let keys = [a_key(0, "two is two", false, false, false)];
  assert_eq(
    result_line(plain(), p, an_outcome(0, "two is two", "passed"), 24),
    "   ok      two is two                    1.5ms",
  )
}

test "a test that did not pass prints its reason under its result line, and that output appears when the test's group of tests finishes" {
  let p = a_program([a_case(0, "two is two")]);
  let failed = {
    ..an_outcome(0, "two is two", "failed"),
    diagnostic: Some({
      diagnostic: error_with_labels(
        b"E0501",
        b"assertion failed: expected 2, found 3",
        [{ module: 0, start: 20, end: 29, primary: true, text: b"" }],
        [],
      ),
      values: [],
    }),
  };
  assert_eq(result_lines(plain(), p, [failed], 24), [
    "   FAIL    two is two                    1.5ms",
    "       assertion failed: expected 2, found 3",
    "       at m.ply:1:21",
  ]);
  assert_eq(result_lines(plain(), p, [an_outcome(0, "two is two", "passed")], 24).len(), 1)
}

test "the name column is as wide as the longest name of a test that will run, with a minimum of 24 and a maximum of 64" {
  let column = |names: List<String>| {
    let p = a_program(range(0, names.len()).map(|i: Int| a_case(i, names.at_or(i, ""))));
    name_column(
      p,
      a_decided(
        p,
        range(0, names.len()).map(|i: Int| a_key(i, names.at_or(i, ""), false, false, false)),
      ),
    )
  };
  assert_eq(column([]), 24);
  assert_eq(column(["short", "x".repeat(30)]), 30);
  assert_eq(column(["x".repeat(90)]), 64);
  let p = a_program([a_case(0, "x".repeat(40)), a_case(1, "two")]);
  let cached_long = a_decided(p, [
    a_key(0, "x".repeat(40), true, false, false),
    a_key(1, "two", false, false, false),
  ]);
  assert_eq(name_column(p, cached_long), 24)
}

test "the summary line shows failed, passed and cached counts and the duration, and adds a count of tests that use the host" {
  let p = a_program([a_case(0, "one")]);
  let r = a_run([an_outcome(0, "one", "passed")], 0);
  assert_eq(
    summary_line(plain(), r, counts_of(p, r.tests_using_host)),
    "   0 failed, 1 passed, 0 cached (0.02s)",
  );
  let hosted = { ..r, tests_using_host: [0] };
  assert(
    summary_line(plain(), hosted, counts_of(p, hosted.tests_using_host)).contains(
      "1 used the host",
    ),
  )
}

test "`--explain` prints why each test ran or was skipped, and lists the concurrency groups the tests were placed in" {
  let p = a_program([a_case(0, "one"), a_case(1, "two")]);
  let keys = [a_key(0, "one", false, false, false), a_key(1, "two", true, false, false)];
  let lines = explain_lines(plain(), p, [], a_decided(p, keys));
  assert(lines.at_or(1, "").contains("run  abcdef012345 new "));
  assert(lines.at_or(1, "").contains("isolation: isolated"));
  assert(lines.at_or(2, "").contains("skip abcdef012345 cached "));
  assert(lines.contains("   why"));
  assert(lines.contains("   concurrency groups"));
  assert(lines.contains("     group 0 · 1 test · {}"));
  assert(lines.contains("       one"))
}

test "`--explain` shows the cache key a passing result is stored under, and what file changed for a test whose cached result was invalidated" {
  let p = a_program([a_case(0, "one"), a_case(1, "two")]);
  let keys = [
    { ..a_key(0, "one", false, false, false), cached: Some(Moved("the file `a.ply` under `cwd`")) },
    a_key(1, "two", false, false, false),
  ];
  let lines = explain_lines(plain(), p, [], a_decided(p, keys));
  assert(lines.at_or(1, "").contains(" changed "));
  assert(lines.at_or(1, "").contains(" · moved: the file `a.ply` under `cwd`"));
  assert(!lines.at_or(2, "").contains("moved"));
  assert(lines.contains("   key"));
  assert(
    lines.contains(
      "     a result is cached under the test's hash and the runtime version aabbccddeeff, and under the code the test ran together with the values it read from the system",
    ),
  );
  let uncached = explain_lines(plain(), { ..p, cache_stamp: None }, [], a_decided(p, keys));
  assert(
    uncached.contains("     nothing is cached: `--no-cache` reads and writes no cache entries"),
  );
  let text = to_string(
    test_output(
      plain(),
      from_argv("test", ["--json"]),
      p,
      a_run([], 0),
      [],
      [],
      a_decided(p, keys),
    ).json,
  );
  assert(text.contains("\"recorded_under\":\"aabbccddeeff00112233\""));
  assert(text.contains("\"changed_input\":\"the file `a.ply` under `cwd`\""))
}

test "the JSON output contains `command`, `exit_code` and `schema_version` fields, plus the project root, durations and run reasons" {
  let p = a_program([a_case(0, "one")]);
  let keys = [a_key(0, "one", false, false, false)];
  let text = to_string(
    test_output(
      plain(),
      from_argv("test", ["--json"]),
      p,
      a_run([an_outcome(0, "one", "passed")], 0),
      [],
      [],
      a_decided(p, keys),
    ).json,
  );
  assert(text.contains("\"command\":\"test\""));
  assert(text.contains("\"exit_code\":0"));
  assert(text.contains("\"schema_version\":8"));
  assert(text.contains("\"root\":\"/p\""));
  assert(text.contains("\"duration_ms\":1.5"));
  assert(text.contains("\"reason\":\"new\""))
}

test "a test's JSON entry lists its conflicting effects, both structured and as text, and whether the test uses a seed" {
  let c = {
    ..a_case(0, "one"),
    listed: [
      {
        entry: { effect: "db", resource: "users", writes: true, nondet: true },
        text: "db.write[users]",
      },
      { entry: { effect: "sim", resource: "", writes: false, nondet: false }, text: "sim.read" },
    ],
    seeded: true,
  };
  let text = to_string(
    case_json(a_run([], 0), c, a_decided(a_program([c]), [a_key(0, "one", false, false, false)])),
  );
  assert(
    text.contains("\"contends\":[{\"effect\":\"db\",\"resource\":\"users\",\"writes\":true}]"),
  );
  assert(text.contains("\"seeded\":true"));
  assert(text.contains("\"shared_effects\":[\"db.write[users]\"]"))
}

test "a failure's JSON entry contains its name, status, replay command, race details and the definitions that changed" {
  let p = a_program([a_case(0, "two is two")]);
  let site = { task: "t1", definition: Some("m.bump"), access: "write", at: None };
  let raced = {
    ..a_fault(),
    seed: Some("0:1.0"),
    replay: replay_of("0:1.0", "two is two"),
    race: Some({ left: site, right: { ..site, task: "t2" }, step: 3 }),
    changes: [{ ..a_change("m.bump"), change: Some(Edited) }],
  };
  let text = to_string(fault_json(p, raced));
  assert(text.contains("\"key\":\"m.two is two\""));
  assert(text.contains("\"name\":\"two is two\""));
  assert(text.contains("\"internal_error\":false"));
  assert(text.contains("\"module\":\"m\""));
  assert(text.contains("\"status\":\"failed\""));
  assert(text.contains("\"nondet\":false"));
  assert(text.contains("\"replay\":\"ply test --seed 0:1.0 --filter 'two is two'\""));
  assert(text.contains("\"at\":3"));
  assert(text.contains("\"task\":\"t2\""));
  assert(text.contains("\"change\":\"edited\""));
  assert(text.contains("\"test\":false"));
  let plain_fault = to_string(fault_json(p, a_fault()));
  assert(plain_fault.contains("\"replay\":null"));
  assert(plain_fault.contains("\"race\":null"))
}

test "`test --json` output contains the full text of a long value from a failed test, in the test result and in the fault" {
  let p = a_program([a_case(0, "two is two")]);
  let keys = [a_key(0, "two is two", false, false, false)];
  let long = VList(range(0, shown_characters()).map(|i: Int| VInt(i)));
  let raised = {
    diagnostic: error_with_labels(
      b"E0501",
      Bytes::of_string("found " ++ String::of_bytes(b"\x010\x02")),
      [],
      [],
    ),
    values: [long],
  };
  let text = to_string(
    test_output(
      plain(),
      from_argv("test", ["--json"]),
      p,
      a_run([{ ..an_outcome(0, "two is two", "failed"), diagnostic: Some(raised) }], 1),
      [{ ..a_fault(), diagnostic: raised }],
      [],
      a_decided(p, keys),
    ).json,
  );
  assert_eq(text.split("\"values\":[\"" ++ render_all(long) ++ "\"]").len(), 3)
}

test "a program with no tests prints that it has none, and a `--filter` that matches no test prints a different message" {
  let empty = { ..a_program([]), declared: 0 };
  assert(
    test_output(
      plain(),
      from_argv("test", []),
      empty,
      a_run([], 0),
      [],
      [],
      a_decided(empty, []),
    ).lines.contains(
      "   no `test` items in this program",
    ),
  );
  let hidden = { ..a_program([]), declared: 3, filtered_out: 3 };
  assert(
    test_output(
      plain(),
      from_argv("test", ["--filter=none"]),
      hidden,
      a_run([], 0),
      [],
      [],
      a_decided(hidden, []),
    ).lines.contains(
      "   no test key contains a `--filter` substring; nothing was verified",
    ),
  )
}

test "`change_text` prints a changed definition's name, followed by the kind of change such as `(edited)` when known" {
  assert_eq(change_text(a_change("m.total")), "m.total");
  assert_eq(change_text({ ..a_change("m.total"), change: Some(Edited) }), "m.total (edited)")
}

test "the repro is a seed and the command that replays it" {
  let f = { ..a_fault(), seed: Some("0:0.1.0.2"), replay: replay_of("0:0.1.0.2", "two is two") };
  assert_eq(seed_lines(plain(), a_source_texts(), f), [
    "  seed: 0:0.1.0.2",
    "  replay: ply test --seed 0:0.1.0.2 --filter 'two is two'",
  ])
}

test "the simulation line counts the simulated tests and interleavings, and says when the search budget ran out" {
  let quiet = a_run([], 0);
  assert_eq(simulation_line(plain(), quiet), []);
  let counted = {
    simulated: 3,
    total: 47,
    seeds: 3,
    interleavings: 61,
    exhaustive: 3,
    exhausted: 0,
    failed: 0,
  };
  assert_eq(simulation_line(plain(), { ..quiet, simulation: counted }), [
    indent() ++ "simulated: 3 of 47 · 61 interleavings · 3 exhaustive",
  ]);
  let spent = {
    ..counted,
    simulated: 1,
    total: 1,
    interleavings: 256,
    exhaustive: 0,
    exhausted: 1,
  };
  assert_eq(simulation_line(plain(), { ..quiet, simulation: spent }), [
    indent() ++ "simulated: 1 of 1 · 256 interleavings · 1 budget spent, not cached",
  ])
}

test "front-end phase timings print in milliseconds with two decimals, longest phase first" {
  assert_eq(phase_lines(plain(), { ..no_phases(), read_us: 2000, front_end_us: 98000 }), [
    "",
    "   front-end time",
    "     front          98.00ms  98.0%",
    "     read            2.00ms   2.0%",
    "     write back      0.00ms   0.0%",
    "     total         100.00ms",
  ])
}

test "a run's total time is the front-end load plus every later phase, and the phases print longest first" {
  let load = { ..no_phases(), front_end_us: 2000 };
  let spent = { ..no_time_spent(), before_us: 1000, handoff_us: 5000, tests_us: 2000 };
  assert_eq(run_total(load, spent), 10000);
  assert_eq(run_phase_lines(plain(), load, spent), [
    "",
    "   run time",
    "     handoff         5.00ms  50.0%",
    "     load            2.00ms  20.0%",
    "     tests           2.00ms  20.0%",
    "     before          1.00ms  10.0%",
    "     promises        0.00ms   0.0%",
    "     store           0.00ms   0.0%",
    "     selection       0.00ms   0.0%",
    "     unit            0.00ms   0.0%",
    "     bind            0.00ms   0.0%",
    "     conclude        0.00ms   0.0%",
    "     total          10.00ms",
  ])
}

test "`isolated_as` returns `host` for a test that can reach the host, `shared` for one with conflicting effects, else `isolated`" {
  let c = a_case(0, "one");
  let unreached = a_run([], 0);
  assert_eq(isolated_as(unreached.tests_using_host, c), "isolated");
  assert_eq(isolated_as([0], c), "host");
  let fs_write = {
    entry: { effect: "fs", resource: "/tmp/x", writes: true, nondet: true },
    text: "fs.write[/tmp/x]",
  };
  let seed = {
    entry: { effect: "sim", resource: "", writes: false, nondet: false },
    text: "sim.read",
  };
  assert_eq(isolated_as(unreached.tests_using_host, { ..c, listed: [seed] }), "isolated");
  assert_eq(isolated_as(unreached.tests_using_host, { ..c, listed: [seed, fs_write] }), "shared");
  assert_eq(conflicting_effects_text({ ..c, listed: [seed, fs_write] }), "{fs.write[/tmp/x]}")
}

test "`binding_lines` prints how many tests use the host, with its operation count and digest, and `handshake_lines` prints the handshake results" {
  let o = { ..an_opening(), operations: 7, digest: "b3:aabbccddeeff" };
  let c = { total: 3, isolated: 1, shared: 0, host: 2 };
  assert_eq(binding_lines(plain(), o, c), [
    "   2 of 3 tests use the host · each result is cached with what the test read from the host",
    "   host: 7 operations · b3:aabbccddeeff",
  ]);
  assert_eq(binding_lines(plain(), an_opening(), c), []);
  let bound = { ..a_run([], 0), handshakes: ["handshakes: 1 completed, 0 rejected"] };
  assert_eq(handshake_lines(plain(), bound), ["   handshakes: 1 completed, 0 rejected"]);
  assert_eq(handshake_lines(plain(), a_run([], 0)), [])
}

test "a test label has no module prefix in a single-module run, and gets the module name prefix when several modules run" {
  let one = a_program([a_case(0, "same")]);
  let c = one.cases.at_or(0, a_case(0, ""));
  assert_eq(display_of(one, c), "same");
  let two = {
    ..one,
    modules: [{ name: "alpha", file: "alpha.ply" }, { name: "beta", file: "beta.ply" }],
  };
  assert_eq(display_of(two, c), "m.same")
}

test "a failure's secondary labels are printed under it, each with its own file, line and column" {
  let d = error_with_labels(
    b"E0414",
    b"these tasks are deadlocked",
    [
      { module: 0, start: 0, end: 4, primary: true, text: b"here" },
      { module: 0, start: 5, end: 16, primary: false, text: b"waits on `b`" },
    ],
    [],
  );
  assert_eq(at_lines(plain(), a_source_texts(), d), ["    at m.ply:1:1"]);
  assert_eq(secondary_lines(plain(), a_source_texts(), d), ["    waits on `b`   m.ply:1:6"])
}

test "a seeded test searches only the seeds not yet searched, and a test without a seed runs once" {
  let p = a_program([a_case(0, "plain"), { ..a_case(1, "seeded"), seeded: true }]);
  let searching = plan::random(4);
  assert_eq(job_of(p, 0, [], searching), {
    unit: p.unit,
    test: 0,
    name: "plain",
    entry: entry_of(0, b"m.plain"),
    search: None,
  });
  assert_eq(job_of(p, 1, [], searching).search, Some(searching));
  assert_eq(job_of(p, 1, [{ index: 1, roots: [2, 3] }], searching), {
    unit: p.unit,
    test: 1,
    name: "seeded",
    entry: entry_of(1, b"m.seeded"),
    search: Some({ ..searching, roots: [2u64, 3u64] }),
  })
}

fn analysed_as(name: String, source: String) -> CheckedProgram / {abort.raise} =
  match analyse(
      parse_all([{ name: Bytes::of_string(name), source_text: Bytes::of_string(source) }]),
    ) {
    Analysed(w) -> checked_program_of(w),
    Rejected(_) -> panic("the fixture checks"),
  }

fn analysed(source: String) -> CheckedProgram / {abort.raise} = analysed_as("", source)

fn cases_of_whole(analysis: CheckedProgram) -> List<Case> / {abort.raise} = {
  let declared = declared_effects(analysis);
  range(0, analysis.checked.tests.len()).fold([], |accumulator: List<Case>, i: Int|
    match test_at(analysis, i) {
      Some(t) -> accumulator.push(case_view(analysis, declared, i, t)),
      None -> accumulator,
    })
}

fn coloured(analysis: CheckedProgram) -> List<List<Int>> / {abort.raise} = {
  let cases = cases_of_whole(analysis);
  classes_of(a_program(cases), cases.map(|case: Case| case.index))
}

fn texts_of_case(analysis: CheckedProgram, i: Int) -> List<String> / {abort.raise} =
  match cases_of_whole(analysis).at(i) {
    Some(c) -> c.listed.map(|printed: PrintedEffect| printed.text),
    None -> [],
  }

fn a_store() -> String =
  "nondet effect store {\n  read  all[r]() -> Int\n  write save[r](n: Int) -> Unit\n}\n"

fn precise() -> String =
  a_store()
    ++ "fn list_items() -> Int / {store.read[items]} = store.all[items]()\nfn place_order() -> Int / {store.write[orders]} = { store.save[orders](1); 2 }\ntest/nondet \"items\" { assert_eq(list_items(), 0) }\ntest/nondet \"orders\" { assert_eq(place_order(), 2) }\n"

fn aliased() -> String =
  a_store()
    ++ "effect set Service = {store.read[items], store.write[orders]}\nfn list_items() -> Int / {Service} = store.all[items]()\nfn place_order() -> Int / {Service} = { store.save[orders](1); 2 }\ntest/nondet \"items\" { assert_eq(list_items(), 0) }\ntest/nondet \"orders\" { assert_eq(place_order(), 2) }\n"

fn deterministic(source: String) -> String =
  String::join(
    String::join(source.split("nondet effect "), "effect ").split("test/nondet "),
    "test ",
  )

test "two endpoints with precise effects share one group, but with a broad effect set they get separate groups" {
  assert_eq(coloured(analysed(precise())), [[0, 1]]);
  assert_eq(coloured(analysed(aliased())), [[0], [1]]);
  assert_eq(coloured(analysed(deterministic(aliased()))), [[0, 1]])
}

test "a broad effect set expands to the effects it contains, and always includes every effect listed precisely" {
  let broad = texts_of_case(analysed(aliased()), 0);
  let narrow = texts_of_case(analysed(precise()), 0);
  assert(broad.filter(|t: String| t.ends_with("store.write[orders]")).len() > 0);
  assert(broad.filter(|t: String| t.contains("Service")).len() == 0);
  assert(narrow.filter(|t: String| t.ends_with("store.write[orders]")).len() == 0);
  assert(narrow.fold(true, |ok: Bool, t: String| ok && broad.contains(t)))
}

test "an effect named `holds` is treated as a real resource, so two tests that write to it are put in separate groups" {
  let w = analysed(
    "nondet effect holds {\n  write put[rows](v: Int) -> Unit\n}\ntest/nondet \"one\" { holds.put[rows](1) }\ntest/nondet \"two\" { holds.put[rows](2) }\n",
  );
  assert_eq(texts_of_case(w, 0), ["holds.put[rows]"]);
  assert_eq(coloured(w), [[0], [1]])
}

test "a test that calls `scoped.read` and also writes with `db.put` still reports `db.put[users]` as a write" {
  let w = analysed(
    "nondet effect db {\n  read  get[users]() -> Int\n  write put[users](v: Int) -> Unit\n}\nfn touches(n: Int) -> Int / {scoped.read[table]} = n\ntest \"hold only\" { let seen = with_scope[table](1, |x: Int| ()) { c -> c.get() }; assert_eq(touches(seen), 1) }\ntest/nondet \"hold and a real write\" { let seen = with_scope[table](1, |x: Int| ()) { c -> c.get() }; db.put[users](touches(seen)) }\ntest/nondet \"a real read\" { assert_eq(db.get[users](), 0) }\n",
  );
  assert_eq(texts_of_case(w, 1), ["db.put[users]", "scoped.read[table]"]);
  assert_eq(coloured(w), [[0, 1], [2]])
}

test "tests that only use scoped values have no effects, so they can all run together" {
  let w = analysed(
    "test \"users hold\" { with_scope[users](1, |x: Int| ()) { c -> assert_eq(c.get(), 1) } }\ntest \"orders hold\" { with_scope[orders](2, |x: Int| ()) { c -> assert_eq(c.get(), 2) } }\ntest \"pure\" { assert_eq(1, 1) }\n",
  );
  assert_eq(cases_of_whole(w).map(|case: Case| case.effects), ["{}", "{}", "{}"]);
  assert_eq(coloured(w), [[0, 1, 2]])
}

test "a test that uses `simulate` is run over many schedules, and a test that does not is run once" {
  let w = analysed(
    "test \"once\" { assert_eq(1, 1) }\ntest \"searched\" { let n = simulate { task.join(task.spawn(|| 1)) }; assert_eq(n, 1) }\n",
  );
  assert_eq(cases_of_whole(w).map(|case: Case| case.seeded), [false, true]);
  assert_eq(rows_of(w).map(|row: Row| row.seeded), [false, true])
}

test "a run reports only the tests that match `--filter`, and counts the tests it excluded" {
  let w = analysed_as(
    "m",
    "test \"alpha\" { assert_eq(1, 1) }\ntest \"beta\" { assert_eq(2, 2) }\ntest \"gamma\" { assert_eq(3, 3) }\n",
  );
  let scope = scoped(w, ["--filter", "alpha"]);
  assert_eq(scope.visible, [0]);
  assert_eq(scope.filtered_out, 2);
  assert_eq(scope.out, []);
  assert_eq(scoped(w, ["--filter", "m.gam", "--filter", "alpha"]).visible, [0, 2]);
  assert_eq(scoped(w, []).visible, [0, 1, 2])
}

test "`--shard` puts each test and each case in exactly one shard, even when `--filter` is also given" {
  let whole = program_with_cases();
  let over = expand_cases(
    whole,
    Map::new().insert(
      1,
      Ok(
        range(0, 12).map(|n: Int|
          { label: "holds " ++ n.to_string(), identity: Bytes::of_string(n.to_string()) }),
      ),
    ),
  );
  let part = |k: Int, more: List<String>|
    scoped(over.analysis, ["--shard", k.to_string() ++ "/3"].concat(more));
  let parts = [1, 2, 3].map(|k: Int| part(k, []).visible);
  assert(parts.all(|shard_indices: List<Int>| shard_indices.len() > 0));
  assert(
    range(0, 13).all(|i: Int|
      parts.filter(|shard_indices: List<Int>| shard_indices.contains(i)).len() == 1),
  );
  assert_eq(part(2, []).filtered_out, 13 - parts.at_or(1, []).len());
  assert(
    [1, 2, 3].all(|k: Int|
      part(k, ["--filter", "holds 1"]).visible
        == parts.at_or(k - 1, []).filter(|i: Int| i == 2 || i >= 11)),
  );
  assert_eq(scoped(over.analysis, ["--shard", "1/1"]).visible, range(0, 13));
  assert_eq(selected_case_indices(whole, ["--shard", "3/3"], None), [1])
}

test "a run lists a test with cases only when a filter could match one of its cases" {
  let whole = program_with_cases();
  let listing = |filter: String| selected_case_indices(whole, ["--filter", filter], None);
  assert_eq(listing("std.show."), []);
  assert_eq(listing("m."), [1]);
  assert_eq(listing("holds 1"), [1]);
  assert_eq(selected_case_indices(whole, [], Some(["n"])), [])
}

fn program_with_cases() -> CheckedProgram / {abort.raise} =
  checked_program(
    b"fn table() -> List<Int> = [1, 2]\nfn held(n: Int) -> Bool = n > 0\ntest \"plain\" { assert(held(1)) }\ntest \"holds {n}\" for n: Int in table() { assert(held(n)) }\n",
  )

fn checked_program(source: Bytes) -> CheckedProgram / {abort.raise} =
  match analyse_pulling_std_with(
      [{ name: b"m", source_text: source }],
      [
        {
          name: b"std.cases",
          source_text: b"pub type Table<a> = List<a>\npub fn listed<a | e>(t: List<a>, l: (a) -> String / e) -> List<{ label: String, identity: Bytes }> / e where derivable(hash, a) = t.map(|c: a| { label: l(c), identity: b\"\" })\npub fn chosen<a>(t: List<a>, at: Int, d: Bytes) -> a / {abort.raise} where derivable(hash, a) = panic(\"\")\n",
        },
        { name: b"std.show", source_text: b"pub fn display<a>(x: a) -> String = \"\"\n" },
      ],
      no_rows(),
    ).out {
    Analysed(w) -> checked_program_of(w),
    Rejected(_) -> panic("the fixture checks"),
  }

test "`expand_cases` turns each case into its own test keyed by its label, and the case-generating code is not run" {
  let whole = program_with_cases();
  let over = expand_cases(
    whole,
    Map::new().insert(
      1,
      Ok([{ label: "holds 1", identity: b"one" }, { label: "holds 2", identity: b"two" }]),
    ),
  );
  assert_eq(over.analysis.checked.tests.map(|t: TestInfo| t.key), [
    b"m.plain",
    b"m.holds 1",
    b"m.holds 2",
  ]);
  assert_eq(over.analysis.checked.tests.map(|t: TestInfo| t.index), [0, 1, 2]);
  assert_eq(over.entries.map(|e: Entry| e.test), [0, 1, 1]);
  assert_eq(over.entries.map(|e: Entry| e.key), [b"m.plain", b"m.holds {n}", b"m.holds {n}"]);
  assert_eq(over.entries.map(|e: Entry| e.case), [
    None,
    Some({ at: 0, identity: b"one" }),
    Some({ at: 1, identity: b"two" }),
  ]);
  let hashes = over.analysis.frame.hashes.tests;
  let of_whole = |key: Bytes| whole.frame.hashes.tests.get(key);
  assert_eq(hashes.get(b"m.plain"), of_whole(b"m.plain"));
  assert_eq(hashes.get(b"m.holds 1"), match of_whole(b"m.holds {n}") {
    Some(h) -> Some(case_hash(h, b"one")),
    None -> None,
  });
  assert(hashes.get(b"m.holds 1") != hashes.get(b"m.holds 2"), None);
  let reachable_functions = |a: CheckedProgram|
    reach(a.frame.hashes, [ItemKeyed(b"m.holds 1")]).functions.keys();
  assert(
    reachable_functions(over.analysis).contains(b"m.table")
      && reachable_functions(over.analysis).contains(b"m.held"),
  );
  assert(
    !reachable_functions(over.run_analysis).contains(b"m.table")
      && reachable_functions(over.run_analysis).contains(b"m.held"),
  )
}

fn listing(labels: List<String>) -> Result<List<ListedCase>, ListingFailure> =
  Ok(labels.map(|l: String| { label: l, identity: Bytes::of_string(l) }))

fn entry_descriptions(over: ExpandedTests) -> List<String> =
  over.entries.map(|e: Entry|
    String::of_bytes_lossy(e.key)
      ++ (match e.unlisted {
        Some(reason) -> ": " ++ String::of_bytes_lossy(reason.failure.diagnostic.message),
        None -> "",
      }))

test "tests over cases may share a label, but each case in a module needs its own label" {
  let source = b"test \"plain\" { () }\ntest \"holds {n}\" for n: Int in [1, 2] { () }\ntest \"holds {n}\" for n: Int in [3] { () }\n";
  let whole = checked_program(source);
  assert_eq(whole.checked.tests.map(|t: TestInfo| t.key), [
    b"m.plain",
    b"m.holds {n}",
    b"m.holds {n} (2)",
  ]);
  let apart = expand_cases(
    whole,
    Map::new().insert(1, listing(["holds 1", "holds 2"])).insert(2, listing(["holds 3"])),
  );
  assert_eq(apart.analysis.checked.tests.map(|t: TestInfo| t.key), [
    b"m.plain",
    b"m.holds 1",
    b"m.holds 2",
    b"m.holds 3",
  ]);
  assert_eq(entry_descriptions(apart), [
    "m.plain",
    "m.holds {n}",
    "m.holds {n}",
    "m.holds {n} (2)",
  ]);
  let clashed = expand_cases(
    whole,
    Map::new().insert(1, listing(["holds 1", "plain"])).insert(2, listing(["holds 3"])),
  );
  assert_eq(entry_descriptions(clashed), [
    "m.plain",
    "m.holds {n}: the case at position 1 of the table has the label \"plain\", which is the name of another test",
    "m.holds {n} (2)",
  ]);
  match match clashed.entries.at(1) { Some(e) -> e.unlisted, None -> None } {
    Some(reason) -> {
      assert_eq(reason.failure.diagnostic.code, b"E0105");
      assert_eq(reason.failure.diagnostic.labels.map(|l: Label| source.slice(l.start, l.end)), [
        b"\"holds {n}\"",
        b"\"plain\"",
      ])
    },
    None -> panic("the first test over cases fails as a whole"),
  };
  assert_eq(
    entry_descriptions(
      expand_cases(
        whole,
        Map::new().insert(1, listing(["holds 1", "holds 2"])).insert(2, listing(["holds 2"])),
      ),
    ),
    [
      "m.plain",
      "m.holds {n}: the case at position 1 of the table has the label \"holds 2\", which a case of another test also has",
      "m.holds {n} (2): the case at position 0 of the table has the label \"holds 2\", which a case of another test also has",
    ],
  );
  assert_eq(
    entry_descriptions(
      expand_cases(
        whole,
        Map::new().insert(1, listing(["a", "b", "a", "a", "a", "a"])).insert(2, listing(["c"])),
      ),
    ),
    [
      "m.plain",
      "m.holds {n}: the cases at positions 0, 2, 3 and 2 more of the table have the same label, \"a\"",
      "m.holds {n} (2)",
    ],
  )
}

test "running a test compiles the code it uses, and listing cases compiles only the code that generates the cases" {
  let whole = program_with_cases();
  let over = expand_cases(
    whole,
    Map::new().insert(1, Ok([{ label: "holds 1", identity: b"one" }])),
  );
  let plain = run_within(over, [0]);
  assert(plain.owners.contains(b"m.held") && !plain.owners.contains(b"m.table"));
  assert_eq(plain.tests.keys(), [b"m.plain"]);
  let case = run_within(over, [1]);
  assert(case.owners.contains(b"m.held") && case.owners.contains(b"m.table"));
  assert_eq(case.tests.keys(), [b"m.holds {n}"]);
  let keyed = view_dump(whole, Some(case)).keys.map(|k: KeyRow| k.root);
  let cases_test = test_key(b"m", b"holds {n}");
  assert(
    keyed.contains(root_text(root_name(cases_test)))
      && keyed.contains(root_text(root_name(TestCases(cases_test)))),
  );
  assert(!keyed.contains(test_owner(b"m", b"plain")));
  let listing = scope_for_listing(whole, [1]);
  assert(listing.owners.contains(b"m.table") && !listing.owners.contains(b"m.held"));
  assert_eq(listing.tests.keys(), [b"m.holds {n}"]);
  let idle = run_within(over, []);
  assert_eq(idle.owners.len() + idle.tests.len(), 0);
  assert_eq(view_dump(whole, Some(idle)).keys, []);
  let rooted = view_dump(whole, Some(idle)).emitter_roots.map(|r: EmitterRoot| r.root);
  assert(rooted.contains(test_owner(b"m", b"plain")));
  assert(rooted.contains(test_owner(b"m", b"holds {n}")))
}

test "a test whose cases could not be listed stays one test, and fails with the error from the listing" {
  let whole = program_with_cases();
  let reason = {
    status: "failed",
    failure: {
      diagnostic: diagnostic_of("error", "E0502", "division by zero", [], []),
      values: [],
    },
  };
  let over = expand_cases(whole, Map::new().insert(1, Err(reason)));
  assert_eq(over.analysis.checked.tests.map(|t: TestInfo| t.key), [b"m.plain", b"m.holds {n}"]);
  assert_eq(over.analysis.frame.hashes.tests, whole.frame.hashes.tests);
  let p = a_program(
    cases_of_whole(over.analysis).map(|case: Case|
      { ..case, entry: over.entries.at_or(case.index, case.entry) }),
  );
  let ended = handle {
    run_job(job_of(p, 1, [], plan::random(1)), false)
  } with {
    entering::machine.enter(unit, root, arguments, run) -> panic("a test with no cases was run"),
  };
  assert_eq(ended.status, "failed");
  assert_eq(ended.failure, Some(reason.failure));
  assert_eq(expand_cases(whole, Map::new()).entries, [
    entry_of(0, b"m.plain"),
    entry_of(1, b"m.holds {n}"),
  ])
}
