import std.fs
import std.fs (fs)
import std.hash (blake3)
import std.list
import compiler.prelude_source
import compiler.store.hash.encoding (hex)
import compiler.load (Derives, forbid_derivers)
import compiler.unit (shipped)
import compiler.front.checking.world (QueryEffects)
import compiler.front.checking.groups (queries)
import compiler.store.memo (QueryStats)
import builder (builder)
import module_queries
import sources
import sources (Project)
import paths
import compiler.front.pkg (a_manifest)

const listed: Bytes =
  Bytes::concat_all(
    queries().map(
      |q: { name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {QueryEffects, abort.raise} }|
        Bytes::concat_all([q.definition, b" ", hex(blake3(q.definition)), b"\n"]),
    ),
  )

fn shipped_file(name: String) -> Option<Bytes> =
  if name == "definitions" { Some(listed) }
  else if name == "stamps" { Some(b"evaluator e1\n") }
  else if name == "std.prelude.ply" { Some(prelude_source::text) }
  else { None }

fn over<a>(
  tree: fs::MemFs,
  go: () -> a / {fs.read[abs], fs.write[abs], fs.read[cwd], fs.write[cwd], fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, builder.git[vcs], Derives, abort.raise, diverges},
) -> fs::MemResult<a> / {abort.raise, diverges} =
  fs::on_mem[abs](tree, ||
    fs::on_mem[cwd](fs::mem_empty(), ||
      forbid_derivers(||
        handle {
          go()
        } with {
          fs.list_dir[shipped](p) -> Some([{ name: "std.prelude.ply", kind: fs::File }]),
          fs.read_file[shipped](p) -> shipped_file(p),
          shipped.read_pack(path, offset, len) -> None,
          shipped.names() -> ["std.prelude"],
          shipped.module(name) -> if name == "std.prelude" { Some(prelude_source::text) }
          else { None },
          shipped.report_view_used(view, pulled) -> (),
          shipped.definitions() -> listed,
          shipped.runtime() ->
            panic(
              "loading a test package must not run library code that generates derived functions",
            ),
          shipped.digests() -> b"",
          shipped.run_root(library, root, arguments, timeout_ms) ->
            panic(
              "loading a test package must not run library code that generates derived functions",
            ),
          builder.git[vcs](root, key) -> None,
        })).value)

fn dependency(name: String, path: String) -> String =
  "{name: \"" ++ name ++ "\", prefix: None, min: {major: 0, minor: 0, patch: 0}, source: Path(\""
    ++ path
    ++ "\")}"

fn packages(lib: String) -> List<{ path: String, body: Bytes }> =
  [
    { path: "app/ply.pkg", body: a_manifest("app", [dependency("lib", "../" ++ lib)]) },
    { path: "app/main.ply", body: b"pub fn two() -> Int = 2\n" },
    { path: lib ++ "/ply.pkg", body: a_manifest("lib", []) },
    { path: lib ++ "/util.ply", body: b"pub fn one() -> Int = 1\n" },
  ]

const store: String = "app/.ply-cache/memo"

fn load() -> Project / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise, diverges} =
  sources::load_resolved([paths::at_abs("app")])

fn ran_of(tallies: List<QueryStats>) -> Int = tallies.fold(0, |n: Int, t: QueryStats| n + t.ran)

fn store_bytes(tree: fs::MemFs) -> Int / {abort.raise} =
  (match fs::listed_names(fs::mem_list(tree, store)) { Some(names) -> names, None -> [] }).fold(
    0,
    |n: Int, name: String|
      if !name.starts_with("seg-") { n } else {
        n + (match fs::mem_read(tree, store ++ "/" ++ name) { Some(b) -> b.len(), None -> 0 })
      },
  )

test "a command's cached result is not reused after a file that the command's program load depends on changes" {
  let command_output = b"lib.one  /lib1/util.ply:1:1";
  let recorded = over(fs::mem_of(packages("lib1")), || {
    let project = load();
    let q = module_queries::query_through_store[abs](store, project);
    {
      retained: module_queries::cache_command[abs](
        store,
        project,
        module_queries::command_key(module_queries::program_digest(), b"definitions"),
        module_queries::program_digest(),
        q.requested_dependencies,
        q.looked_up,
        command_output,
      ),
      walk: [project.packages.len(), project.diagnostics.len()],
    }
  });
  assert_eq(recorded.value.walk, [1, 0]);
  assert(recorded.value.retained);
  let taken = |tree: fs::MemFs|
    over(tree, ||
      module_queries::cached_command[abs](
        store,
        load(),
        module_queries::command_key(module_queries::program_digest(), b"definitions"),
      )).value;
  assert_eq(taken(recorded.tree), Some(command_output));
  let moved = packages("lib2").fold(
    fs::mem_create_dir(
      ["lib1/ply.pkg", "lib1/util.ply"].fold(recorded.tree, |t: fs::MemFs, path: String|
        fs::mem_remove(t, path).fs),
      "lib2",
    ).fs,
    |t: fs::MemFs, f: { path: String, body: Bytes }| fs::mem_write(t, f.path, f.body).fs,
  );
  assert_eq(fs::mem_read(moved, "lib2/util.ply"), Some(b"pub fn one() -> Int = 1\n"));
  assert_eq(taken(moved), None)
}

test "caching a command's output does not discard the cached query results from loading the program, so loading it again runs no queries" {
  let first = over(fs::mem_of(packages("lib")), || {
    let q = module_queries::query_through_store[abs](store, load());
    { requested: q.requested_dependencies, looked: q.looked_up, ran: ran_of(q.tallies) }
  });
  assert(first.value.ran > 0);
  assert_eq(
    over(first.tree, ||
      ran_of(module_queries::query_through_store[abs](store, load()).tallies)).value,
    0,
  );
  let command_output = b"x".repeat(store_bytes(first.tree) * 51 / 100);
  let recorded = over(first.tree, ||
    module_queries::cache_command[abs](
      store,
      load(),
      module_queries::command_key(module_queries::program_digest(), b"run"),
      module_queries::program_digest(),
      first.value.requested,
      first.value.looked,
      command_output,
    ));
  assert(recorded.value);
  assert_eq(
    over(recorded.tree, ||
      ran_of(module_queries::query_through_store[abs](store, load()).tallies)).value,
    0,
  )
}
