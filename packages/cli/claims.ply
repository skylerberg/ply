pub type Options = {
  no_incremental: Bool,
  jobs: Option<Int>,
  prove: ProveOptions,
  sim: machine::SimulationOptions,
}

pub type ProveOptions = { budget: Option<Int>, timeout: Option<Int> }

pub effect proof_store {
  read cached(keys: List<String>) -> List<Option<Bytes>>
  write record(entries: List<{ key: String, evidence: Bytes }>) -> List<Diagnostic>
  read baselines(names: List<String>) -> List<{ name: String, record: ClaimSnapshot }>
  write accepted(records: List<{ name: String, record: ClaimSnapshot }>) -> AcceptResult
}

pub fn options_from(p: Parsed) -> Options / {abort.raise} =
  {
    no_incremental: has(p, "no-incremental"),
    jobs: match value(p, "jobs") { Some(v) -> parse_nat(v), None -> None },
    prove: { budget: nat_value(p, "prove-budget"), timeout: nat_value(p, "timeout") },
    sim: machine::sim_options_from(p),
  }

pub type Rejected = { diagnostics: List<Diagnostic>, places: List<SourceText> }

pub type Rejection = | NotCompiled(Rejected) | CacheUnavailable(Rejected)

pub type Claim = {
  key: String,
  run_key: String,
  owner: String,
  kind: Kind,
  guarded: Bool,
  frame: Frame,
  at: ModuleSpan,
  unused_effects: List<String>,
  schema: Option<String>,
}

pub type Plan = { prove_budget: Int, timeout_ms: Int, sim: plan::Plan }

pub type LoadResult = { places: List<SourceText>, warnings: List<Diagnostic> }

pub type OwnClaims = {
  claims: List<Claim>,
  definitions: List<Definition>,
  laws: List<WrittenLaw>,
  warnings: List<Diagnostic>,
  world: ProverInput,
  modules: List<Bytes>,
}

pub type Collection = {
  places: List<SourceText>,
  warnings: List<Diagnostic>,
  claims: List<Claim>,
  definitions: List<Definition>,
  laws: List<WrittenLaw>,
  plan: Plan,
  world: ProverInput,
  modules: List<Bytes>,
  lanes: Option<Int>,
}

pub fn plan_of(options: Options) -> Plan / {abort.raise} =
  {
    prove_budget: or_else(options.prove.budget, 10000),
    timeout_ms: or_else(options.prove.timeout, surface::default_timeout_ms),
    sim: machine::sim_plan_of(options.sim),
  }

fn or_else(v: Option<Int>, spare: Int) -> Int = match v { Some(n) -> n, None -> spare }

pub fn collection_of(
  got: LoadResult,
  mine: OwnClaims,
  options: Options,
) -> Collection / {abort.raise} =
  {
    places: got.places,
    warnings: got.warnings.concat(mine.warnings),
    claims: mine.claims,
    definitions: mine.definitions,
    laws: mine.laws,
    plan: plan_of(options),
    world: mine.world,
    modules: mine.modules,
    lanes: match options.jobs { Some(n) -> if n > 0 { Some(n) } else { None }, None -> None },
  }

pub fn own_claims(analysis: Analysis, built: ProverInputResult) -> OwnClaims / {abort.raise} = {
  let definitions = analysis.checked.definitions.fold(
    Map::new(),
    |accumulator: Map<String, DefinitionInfo>, d: DefinitionInfo|
      accumulator.insert(String::of_bytes_lossy(d.name), d),
  );
  let schemas = schemas_instantiated(analysis.modules);
  {
    claims: built.world.obligations.map(|o: Obligation|
      {
        key: o.key,
        run_key: o.run_key,
        owner: o.owner,
        kind: o.kind,
        guarded: o.guards.len() > 0,
        frame: o.frame,
        at: o.at,
        unused_effects: match o.kind {
          Ensures(_) -> match definitions.get(o.owner) {
            Some(d) -> provenance(d).unused_effects,
            None -> [],
          },
          _ -> [],
        },
        schema: match schemas.get(Bytes::of_string(o.owner)) {
          Some(name) -> Some(String::of_bytes_lossy(name)),
          None -> None,
        },
      }),
    definitions: built.definitions,
    laws: built.laws,
    warnings: built.warnings,
    world: built.world,
    modules: range(0, analysis.modules.len()).map(|i: Int| analysis.modules.get(i).name),
  }
}

pub type DischargeResult = {
  outcomes: List<Outcome>,
  duration_ms: Decimal,
  warnings: List<Diagnostic>,
}

pub type StaticProverResult = {
  decision: String,
  steps: Int,
  blockers: List<{ kind: String, about: Option<String> }>,
}

pub type StaticResults = {
  resolved: List<StaticResult>,
  static_prover_results: Option<List<Option<StaticProverResult>>>,
}

pub type StaticProver = {
  result: (List<Int>, List<Int>, Bool, Int) -> StaticResults / {abort.raise},
}

pub fn static_prover_of(
  analysis: Analysis,
  world: ProverInput,
  owned: keep (Bytes) -> Bool,
) -> StaticProver =
  {
    result: |wanted: List<Int>, runs: List<Int>, static_prover: Bool, budget: Int| {
      let obligation = |i: Int| world.obligations.at(i);
      let obligations = somes(List::map(if static_prover { wanted } else { runs }, obligation));
      if obligations.len() == 0 {
        {
          resolved: runs.map(|_i: Int| not_attempted),
          static_prover_results: if static_prover { Some(wanted.map(|_i: Int| None)) }
          else { None },
        }
      } else {
        let p: Prover = prover_of(
          claims_for(analysis, modules_of(analysis, obligations), owned),
          world,
          budget,
        );
        if !static_prover {
          {
            resolved: runs.map(|i: Int|
              match obligation(i) { Some(o) -> static_result(p, o), None -> not_attempted }),
            static_prover_results: None,
          }
        } else {
          let found = wanted.map(|i: Int|
            match obligation(i) { Some(o) -> Some({ o: o, d: diagnosis_of(p, o) }), None -> None });
          let by_index = range(0, wanted.len()).fold(
            Map::new(),
            |accumulator: Map<Int, Option<Diagnosis>>, k: Int|
              match found.at(k) {
                Some(Some(f)) ->
                  accumulator.insert(match wanted.at(k) { Some(i) -> i, None -> -1 }, f.d),
                _ -> accumulator,
              },
          );
          {
            resolved: runs.map(|i: Int|
              match obligation(i) {
                Some(o) ->
                  static_result_for(o, match by_index.get(i) { Some(d) -> d, None -> None }),
                None -> not_attempted,
              }),
            static_prover_results: Some(
              found.map(|f: Option<{ o: Obligation, d: Option<Diagnosis> }>|
                match f {
                  Some(x) -> match x.d {
                    Some(d) -> Some(static_prover_result_of(d)),
                    None -> None,
                  },
                  None -> None,
                }),
            ),
          }
        }
      }
    },
  }

pub fn no_static_prover(static_prover: Option<StaticProverResult>) -> StaticProver =
  {
    result: |wanted: List<Int>, runs: List<Int>, include_results: Bool, budget: Int|
      {
        resolved: runs.map(|_i: Int| not_attempted),
        static_prover_results: if include_results { Some(wanted.map(|_i: Int| static_prover)) }
        else { None },
      },
  }

fn static_prover_result_of(d: Diagnosis) -> StaticProverResult =
  {
    decision: decision_word(d.decision),
    steps: steps_of(d.decision),
    blockers: d.blockers.map(|b: Blocker| {
      let parts = blocker_parts(b);
      { kind: parts.kind, about: parts.detail }
    }),
  }

pub type Verdicts = {
  outcomes: List<Outcome>,
  static_prover_results: Option<List<Option<StaticProverResult>>>,
  reasons: List<CacheStatus>,
  coverage: Coverage,
  cached: Int,
  specified: Int,
  duration_ms: Decimal,
  warnings: List<Diagnostic>,
}

pub type AcceptResult = { definitions: Int, stored: Bool, warnings: List<Diagnostic> }

pub type Row = {
  claim: Claim,
  outcome: Outcome,
  reason: CacheStatus,
  static_prover: Option<StaticProverResult>,
}

pub fn seconds(ms: Decimal) -> String / {abort.raise} = ms.div(1000m, 2, HalfUp).to_string()

pub fn once_each(diagnostics: List<Diagnostic>) -> List<Diagnostic> =
  diagnostics.fold([], |accumulator: List<Diagnostic>, d: Diagnostic|
    if accumulator.fold(false, |seen: Bool, k: Diagnostic|
        seen || (k.code == d.code && k.message == d.message)) { accumulator }
    else { accumulator.push(d) })

pub fn location_text(places: List<SourceText>, at: ModuleSpan) -> Option<String> / {abort.raise} =
  if at.module == no_module { None } else {
    match places.at(at.module) {
      None -> None,
      Some(p) -> {
        let spot: Position = position_of(p.text, at.start);
        Some(p.path ++ ":" ++ spot.line.to_string() ++ ":" ++ spot.column.to_string())
      },
    }
  }

fn escaped(text: String) -> String =
  text.split("\\").fold("", |accumulator: String, part: String|
    if accumulator == "" { part } else { accumulator ++ "\\\\" ++ part })

pub fn quoted(text: String) -> String = {
  let parts = escaped(text).split("\"");
  "\""
    ++ range(0, parts.len()).fold("", |accumulator: String, i: Int|
      if i == 0 { parts.at_or(i, "") } else { accumulator ++ "\\\"" ++ parts.at_or(i, "") })
    ++ "\""
}

pub fn label_of(claim: Claim) -> String =
  match claim.kind {
    Ensures(index) -> claim.owner ++ " ensures #" ++ index.to_string(),
    Cost(index) -> claim.owner ++ " cost #" ++ index.to_string(),
    Space(index) -> claim.owner ++ " space #" ++ index.to_string(),
    Builds(type_name) -> claim.owner ++ " builds " ++ type_name,
    Law(named) -> match named {
      Some(label) -> "law " ++ quoted(label),
      None -> "law " ++ claim.owner,
    },
  }

pub fn kind_word(claim: Claim) -> String =
  match claim.kind {
    Ensures(_) -> "ensures",
    Cost(_) -> "cost",
    Space(_) -> "space",
    Builds(_) -> "builds",
    Law(_) -> "law",
  }

pub fn outcome_word(outcome: Outcome) -> String =
  match outcome {
    Proved(_) -> "proved",
    Refuted(_) -> "refuted",
    Vacuous(_) -> "vacuous",
    Unproved(_) -> "unproved",
    InternalError(_) -> "internal_error",
  }

pub fn outcome_label(outcome: Outcome) -> String =
  match outcome { InternalError(_) -> "internal error", _ -> outcome_word(outcome) }

pub fn bindings_text(bindings: List<Binding>) -> String =
  String::join(bindings.map(|b: Binding| b.name ++ " = " ++ render(b.value)), ", ")

pub fn quantifier(claim: Claim, bindings: List<Binding>) -> String =
  if bindings.len() == 0 { "no binders" } else {
    "forall (" ++ String::join(bindings.map(|b: Binding| b.name ++ ": " ++ b.ty), ", ") ++ ")"
  }

pub fn detail_of(row: Row, places: List<SourceText>) -> String / {abort.raise} =
  match row.outcome {
    Proved(c) -> certificate_summary(c),
    Unproved(reason) -> reason_summary(reason),
    Vacuous(_) -> vacuity_summary,
    Refuted(_) -> match location_text(places, row.claim.at) { Some(at) -> at, None -> "" },
    InternalError(f) -> fault_summary(f),
  }

pub fn mark_of(style: Style, outcome: Outcome) -> String =
  match outcome {
    Proved(_) -> green(style, "✓"),
    InternalError(_) -> yellow(style, "!"),
    _ -> red(style, "✗"),
  }

pub fn count_where(rows: List<Row>, want: (Outcome) -> Bool) -> Int =
  rows.filter(|row: Row| want(row.outcome)).len()

pub fn count_refuted(rows: List<Row>) -> Int =
  count_where(rows, |outcome: Outcome| match outcome { Refuted(_) -> true, _ -> false })

pub fn count_vacuous(rows: List<Row>) -> Int =
  count_where(rows, |outcome: Outcome| match outcome { Vacuous(_) -> true, _ -> false })

pub fn count_unproved(rows: List<Row>) -> Int =
  count_where(rows, |outcome: Outcome| match outcome { Unproved(_) -> true, _ -> false })

pub fn count_internal_errors(rows: List<Row>) -> Int =
  count_where(rows, |outcome: Outcome| match outcome { InternalError(_) -> true, _ -> false })

pub fn count_proved(rows: List<Row>) -> Int = count_where(rows, is_proved)

pub fn any_unproved(rows: List<Row>) -> Bool = count_proved(rows) < rows.len()

pub const failure_code: Int = 1

pub fn exit_code_of(rows: List<Row>) -> Int =
  if any_unproved(rows) { failure_code } else { ok_code }

pub fn rows_of(claims: List<Claim>, wanted: List<Int>, verdicts: Verdicts) -> List<Row> =
  range(0, wanted.len()).fold([], |accumulator: List<Row>, i: Int|
    match claims.at(match wanted.at(i) { Some(k) -> k, None -> -1 }) {
      None -> accumulator,
      Some(c) -> match verdicts.outcomes.at(i) {
        None -> accumulator,
        Some(o) ->
          accumulator.push({
            claim: c,
            outcome: o,
            reason: match verdicts.reasons.at(i) { Some(r) -> r, None -> Fresh },
            static_prover: match verdicts.static_prover_results {
              Some(prover_results) -> match prover_results.at(i) { Some(r) -> r, None -> None },
              None -> None,
            },
          }),
      },
    })

pub fn laws_in(collection: Collection) -> Laws =
  laws_of(collection.definitions.map(|definition: Definition| definition.name), collection.laws)

fn rejection_warning(text: String) -> Diagnostic = {
  let d: Diagnostic = error_with_labels(b"W0602", Bytes::of_string(text), [], [
    b"the proof was checked again and rejected, so this claim is not counted as proved",
    b"run `ply cache clear` if it happens again",
  ]);
  { ..d, severity: b"warning" }
}

fn claim_row(claim: Claim, outcome: Outcome) -> ClaimRow =
  {
    owner: claim.owner,
    kind: claim.kind,
    proved: is_proved(outcome),
    discharged: match outcome { Unproved(_) -> false, InternalError(_) -> false, _ -> true },
  }

pub fn claim_rows(
  collection: Collection,
  wanted: List<Int>,
  outcomes: List<Outcome>,
) -> List<ClaimRow> =
  range(0, wanted.len()).fold([], |accumulator: List<ClaimRow>, i: Int|
    match collection.claims.at(match wanted.at(i) { Some(k) -> k, None -> -1 }) {
      None -> accumulator,
      Some(claim) -> match outcomes.at(i) {
        None -> accumulator,
        Some(o) -> accumulator.push(claim_row(claim, o)),
      },
    })

pub fn count_specified(collection: Collection) -> Int =
  specified_count(
    collection.definitions.map(|definition: Definition| definition.name),
    laws_in(collection),
    collection.claims.map(|claim: Claim| { owner: claim.owner, kind: claim.kind }),
  )

pub fn decide_claims<| e>(
  collection: Collection,
  wanted: List<Int>,
  use_cache: Bool,
  statics: StaticProver,
  static_prover: Bool,
  discharge: (List<Int>, List<StaticResult>) -> Result<DischargeResult, Rejection> / {discharging.decided | e},
) -> Result<Verdicts, Rejection> / {abort.raise, proof_store.cached, proof_store.record, decisions.known | e} = {
  let selected_claims = wanted.map(|i: Int| claim_at(collection.claims, i));
  let keys = selected_claims.map(|claim: Claim|
    {
      bare: claim_key(Bytes::of_hex(claim.key)).hex_of(),
      ran: run_key(Bytes::of_hex(claim.run_key)).hex_of(),
    });
  let cached_texts = keys.map(|k: { bare: String, ran: String }|
    proof_store.cached([k.bare, k.ran]));
  let results = range(0, keys.len()).map(|i: Int| {
    let k = keys_at(keys, i);
    let h = match cached_texts.at(i) { Some(texts) -> texts, None -> [] };
    verdict_of(k.bare, k.ran, evidence_kind(cached_at(h, 0)), evidence_kind(cached_at(h, 1)))
  });
  let selection = select(results, use_cache);
  let runs = selection.to_discharge.map(|at: Int| match wanted.at(at) { Some(i) -> i, None -> -1 });
  let static_results = (statics.result)(wanted, runs, static_prover, collection.plan.prove_budget);
  let row_at = |at: Int, outcome: Outcome|
    {
      claim: claim_at(selected_claims, at),
      outcome: outcome,
      reason: match selection.reasons.at(at) { Some(r) -> r, None -> Fresh },
      static_prover: match static_results.static_prover_results {
        Some(prover_results) -> match prover_results.at(at) { Some(r) -> r, None -> None },
        None -> None,
      },
    };
  let cached_outcomes = range(0, selection.from.len()).fold(
    Map::new(),
    |accumulator: Map<Int, Outcome>, at: Int|
      match selection.from.at(at) {
        Some(Some(key)) -> {
          let h = match cached_texts.at(at) { Some(texts) -> texts, None -> [] };
          let text = if key == keys_at(keys, at).bare { cached_at(h, 0) } else { cached_at(h, 1) };
          accumulator.insert(at, match text {
            Some(t) -> match evidence_of(t) {
              Ok(c) -> Proved(c),
              Err(_) -> missing_outcome(claim_at(selected_claims, at)),
            },
            None -> missing_outcome(claim_at(selected_claims, at)),
          })
        },
        _ -> accumulator,
      },
  );
  cached_outcomes.fold((), |_: Unit, at: Int, outcome: Outcome|
    decisions.known(row_at(at, outcome)));
  let place_of = range(0, runs.len()).fold(Map::new(), |accumulator: Map<Int, Int>, k: Int|
    accumulator.insert(runs.at_or(k, -1), selection.to_discharge.at_or(k, -1)));
  let ran = handle {
    discharge(runs, static_results.resolved)
  } with {
    discharging.decided(claim, outcome) ->
      decisions.known(row_at(place_of.get_or(claim, -1), outcome)),
  };
  match ran {
    Err(reason) -> Err(reason),
    Ok(d) -> {
      let all = merge_outcomes(
        selected_claims,
        cached_outcomes,
        selection.to_discharge,
        d.outcomes,
      );
      range(d.outcomes.len(), selection.to_discharge.len()).fold((), |_: Unit, k: Int| {
        let at = selection.to_discharge.at_or(k, -1);
        decisions.known(row_at(at, all.at_or(at, missing_outcome(claim_at(selected_claims, at)))))
      });
      let recorded = cache_writes(
        keys,
        all.map(|o: Outcome| match o { Proved(c) -> Some(c.ran), _ -> None }),
        selection.to_discharge,
        use_cache,
      );
      let stored = if recorded.len() == 0 { [] } else {
        proof_store.record(
          recorded.fold(
            [],
            |accumulator: List<{ key: String, evidence: Bytes }>, f: { at: Int, key: String }|
              match all.at(f.at) {
                Some(Proved(c)) -> accumulator.push({ key: f.key, evidence: evidence_bytes(c) }),
                _ -> accumulator,
              },
          ),
        )
      };
      Ok({
        outcomes: all,
        static_prover_results: static_results.static_prover_results,
        reasons: selection.reasons,
        coverage: coverage(
          collection.definitions.map(|definition: Definition| definition.name),
          laws_in(collection),
          claim_rows(collection, wanted, all),
        ),
        cached: cache_hit_count(selection),
        specified: count_specified(collection),
        duration_ms: d.duration_ms,
        warnings: selection.warnings.map(rejection_warning).concat(d.warnings).concat(stored),
      })
    },
  }
}

fn keys_at(keys: List<{ bare: String, ran: String }>, i: Int) -> { bare: String, ran: String } =
  match keys.at(i) { Some(k) -> k, None -> { bare: "", ran: "" } }

fn evidence_kind(text: Option<Bytes>) -> Option<String> / {abort.raise} =
  match text {
    None -> None,
    Some(t) ->
      Some(match evidence_of(t) {
        Ok(c) -> if c.ran { "run" } else { "proof" },
        Err(_) -> "other",
      }),
  }

fn merge_outcomes(
  claims: List<Claim>,
  cached_outcomes: Map<Int, Outcome>,
  to_discharge: List<Int>,
  discharged: List<Outcome>,
) -> List<Outcome> = {
  let place = range(0, to_discharge.len()).fold(Map::new(), |accumulator: Map<Int, Int>, k: Int|
    accumulator.insert(to_discharge.at_or(k, -1), k));
  range(0, claims.len()).map(|at: Int|
    match cached_outcomes.get(at) {
      Some(o) -> o,
      None -> match discharged.at(place.get_or(at, -1)) {
        Some(o) -> o,
        None -> missing_outcome(claim_at(claims, at)),
      },
    })
}

fn missing_outcome(claim: Claim) -> Outcome =
  InternalError({
    code: "E0505",
    message: "no proof result was found in the cache or produced for `" ++ claim.owner ++ "`",
    notes: [
      "the program chose what the cache returned from the store this run reads; this is Ply's fault",
    ],
    values: [],
    bindings: [],
  })

pub effect discharging {
  write decided(claim: Int, outcome: Outcome) -> Unit
}

pub effect decisions {
  write known(row: Row) -> Unit
}

pub fn discharge_library(
  front: LoadedAnalysis,
  collection: Collection,
  runs: List<Int>,
  resolved: List<StaticResult>,
) -> Result<DischargeResult, Rejection> / {entering::machine.open, entering::machine.enter, entering::machine.close, time.elapsed_ms, emit.unit, emit.compiled, discharging.decided, abort.raise} =
  if runs.len() == 0 { Ok({ outcomes: [], duration_ms: Decimal::of_int(0), warnings: [] }) } else {
    let broken = |diagnostics: List<Diagnostic>|
      Err(NotCompiled({ diagnostics: diagnostics, places: collection.places }));
    match units::whole_library(front, cc::development()) {
      Err(diagnostics) -> broken(diagnostics),
      Ok(library) -> match entering::machine.open(library) {
        Err(reason) -> broken([machine::unit_load_error(reason)]),
        Ok(o) -> {
          let p = proof_context_of(o.unit, front, collection);
          let d = discharge_runs(collection, p, runs, resolved);
          entering::machine.close(o.unit);
          Ok(d)
        },
      },
    }
  }

pub fn discharge_runs(
  collection: Collection,
  p: ProofContext,
  runs: List<Int>,
  resolved: List<StaticResult>,
) -> DischargeResult / {entering::machine.enter, time.elapsed_ms, discharging.decided, abort.raise} = {
  let started = time.elapsed_ms();
  let claims_to_discharge = range(0, runs.len()).fold(
    [],
    |accumulator: List<ClaimToDischarge>, k: Int|
      match ((runs.at(k), resolved.at(k))) {
        (Some(i), Some(s)) -> match collection.world.obligations.at(i) {
          Some(o) -> accumulator.push({ claim: i, obligation: o, resolved: s }),
          None -> accumulator,
        },
        _ -> accumulator,
      },
  );
  let ran = handle {
    discharged(
      claims_to_discharge,
      collection.world,
      collection.plan.sim,
      |q: RuntimeRequest|
        match q {
          JudgePoints(batches) -> {
            let j = judge_parallel(p, batches, collection.lanes);
            entry_warnings.ended(j.warnings);
            Judgements(j.each)
          },
          RunInterleaving(claim, point, seed, steps) -> {
            let r = run_interleaving(p, claim, point, seed, steps);
            entry_warnings.ended(r.warnings);
            Interleaved(r.run)
          },
        },
      |claim: Int, outcome: Outcome| discharging.decided(claim, outcome),
    )
  } with {
    var warnings: List<Diagnostic> = [],
    entry_warnings.ended(ws) -> {
      warnings = warnings.concat(ws);
    },
    return outcomes -> { outcomes: outcomes, warnings: warnings },
  };
  {
    outcomes: ran.outcomes,
    duration_ms: Decimal::of_int(time.elapsed_ms() - started),
    warnings: once_each(ran.warnings),
  }
}

effect entry_warnings {
  write ended(warnings: List<Diagnostic>) -> Unit
}

fn judge_parallel(
  p: ProofContext,
  batches: List<Batch>,
  lanes: Option<Int>,
) -> { each: List<List<Judgement>>, warnings: List<Diagnostic> } / {entering::machine.enter, abort.raise} = {
  let dealt = machine::split_into_lanes(batches, lanes);
  let judge_batch = judge_lanes(p, dealt, 0, dealt.len(), 64);
  {
    each: machine::merge_lanes(
      judge_batch.map(|lane: List<BatchResult>| lane.map(|j: BatchResult| j.each)),
    ),
    warnings: judge_batch.fold([], |accumulator: List<Diagnostic>, lane: List<BatchResult>|
      lane.fold(accumulator, |into: List<Diagnostic>, j: BatchResult| into.concat(j.warnings))),
  }
}

fn judge_lanes(
  p: ProofContext,
  lanes: List<List<Batch>>,
  lo: Int,
  hi: Int,
  depth_left: Int,
) -> List<List<BatchResult>> / {entering::machine.enter, abort.raise} =
  if hi - lo <= 0 { [] } else if hi - lo == 1 || depth_left <= 0 {
    range(lo, hi).fold([], |out: List<List<BatchResult>>, i: Int|
      match lanes.at(i) {
        Some(lane) -> out.push(lane.map(|b: Batch| judge_batch(p, b))),
        None -> out,
      })
  } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      judge_lanes(p, lanes, lo, mid, depth_left - 1),
      judge_lanes(p, lanes, mid, hi, depth_left - 1),
    };
    halves._0.concat(halves._1)
  }

pub type ProofContext = {
  unit_id: Int,
  obligations: List<Obligation>,
  laws: Map<String, { module: Bytes, label: Bytes }>,
  roots: Map<Bytes, ModuleSpan>,
  timeout_ms: Int,
}

pub fn proof_context_of(unit: Int, front: LoadedAnalysis, collection: Collection) -> ProofContext =
  {
    unit_id: unit,
    obligations: collection.world.obligations,
    laws: front.dump.laws.fold(
      Map::new(),
      |accumulator: Map<String, { module: Bytes, label: Bytes }>, l: LawRow|
        accumulator.insert(String::of_bytes_lossy(l.key), { module: l.module, label: l.name }),
    ),
    roots: machine::roots_of(front.dump),
    timeout_ms: collection.plan.timeout_ms,
  }

pub type BatchResult = { each: List<Judgement>, warnings: List<Diagnostic> }

type ClaimRoots = { guards: List<String>, body: String, call: Option<String> }

type EntryResult = { result: Result<Value, Judgement>, warnings: List<Diagnostic> }

pub fn judge_batch(
  p: ProofContext,
  batch: Batch,
) -> BatchResult / {entering::machine.enter, abort.raise} =
  match roots_of(p, batch.claim_index) {
    Err(fault) -> { each: [fault], warnings: [] },
    Ok(r) -> {
      let done = batch.points.fold(
        { each: [], warnings: [], over: false },
        |accumulator: { each: List<Judgement>, warnings: List<Diagnostic>, over: Bool }, point: List<Value>|
          if accumulator.over { accumulator } else {
            let one = match batch.mode {
              WholeClaim -> judge_point(p, r, point),
              _ -> {
                let g = guard(p, r, point);
                {
                  result: match g.result {
                    Ok(true) -> PointPassed,
                    Ok(false) -> PointRejected,
                    Err(j) -> j,
                  },
                  warnings: g.warnings,
                }
              },
            };
            {
              each: accumulator.each.push(one.result),
              warnings: accumulator.warnings.concat(one.warnings),
              over: ends_batch(batch.mode, one.result),
            }
          },
      );
      { each: done.each, warnings: done.warnings }
    },
  }

fn ends_batch(mode: JudgeMode, j: Judgement) -> Bool =
  match ((mode, j)) {
    (_, PointFaulted(_)) -> true,
    (WholeClaim, PointFailed) -> true,
    (WholeClaim, PointRaised(_)) -> true,
    (WitnessSearch, PointPassed) -> true,
    (GuardFilter, PointRaised(_)) -> true,
    _ -> false,
  }

fn judge_point(
  p: ProofContext,
  r: ClaimRoots,
  point: List<Value>,
) -> { result: Judgement, warnings: List<Diagnostic> } / {entering::machine.enter, abort.raise} = {
  let g = guard(p, r, point);
  match g.result {
    Err(j) -> { result: j, warnings: g.warnings },
    Ok(false) -> { result: PointRejected, warnings: g.warnings },
    Ok(true) -> {
      let b = evaluate_proposition(p, r, point);
      {
        result: match b.result { Err(j) -> j, Ok(true) -> PointPassed, Ok(false) -> PointFailed },
        warnings: g.warnings.concat(b.warnings),
      }
    },
  }
}

fn guard(
  p: ProofContext,
  r: ClaimRoots,
  point: List<Value>,
) -> { result: Result<Bool, Judgement>, warnings: List<Diagnostic> } / {entering::machine.enter, abort.raise} =
  r.guards.fold(
    { result: Ok(true), warnings: [] },
    |accumulator: { result: Result<Bool, Judgement>, warnings: List<Diagnostic> }, root: String|
      match accumulator.result {
        Ok(true) -> {
          let e = enter_root(p, root, point);
          { result: as_boolean(e.result), warnings: accumulator.warnings.concat(e.warnings) }
        },
        _ -> accumulator,
      },
  )

fn evaluate_proposition(
  p: ProofContext,
  r: ClaimRoots,
  point: List<Value>,
) -> { result: Result<Bool, Judgement>, warnings: List<Diagnostic> } / {entering::machine.enter, abort.raise} =
  match r.call {
    None -> {
      let e = enter_root(p, r.body, point);
      { result: as_boolean(e.result), warnings: e.warnings }
    },
    Some(owner) -> {
      let called = enter_root(p, owner, point);
      match called.result {
        Err(j) -> { result: Err(j), warnings: called.warnings },
        Ok(result) -> {
          let e = enter_root(p, r.body, point.push(result));
          { result: as_boolean(e.result), warnings: called.warnings.concat(e.warnings) }
        },
      }
    },
  }

fn as_boolean(result: Result<Value, Judgement>) -> Result<Bool, Judgement> =
  match result {
    Ok(VBool(b)) -> Ok(b),
    Ok(other) ->
      Err(
        PointFaulted({
          code: "E0505",
          message: "a spec expression evaluated to `" ++ String::of_bytes_lossy(b"\x010\x02")
            ++ "` instead of a Boolean",
          notes: [
            "the type checker rejects a clause that is not `Bool` with E0201, so reaching this is a bug in Ply",
          ],
          values: [other],
        }),
      ),
    Err(j) -> Err(j),
  }

fn enter_root(
  p: ProofContext,
  root: String,
  args: List<Value>,
) -> EntryResult / {entering::machine.enter, abort.raise} = {
  let o = entering::machine.enter(p.unit_id, root, machine::arguments_of(args), {
    ..entering::unbounded,
    timeout_ms: p.timeout_ms,
  });
  { result: root_value(o.ended, root), warnings: machine::warnings_of(o, p.roots) }
}

fn root_value(
  ended: entering::Termination,
  root: String,
) -> Result<Value, Judgement> / {abort.raise} =
  match ended {
    entering::Returned(bytes) -> match value::decode(bytes) {
      Some(v) -> Ok(v),
      None -> Err(ply_fault("`" ++ root ++ "` returned bytes that cannot be decoded as a value")),
    },
    entering::Failed(f) -> if machine::is_internal_error(Bytes::of_string(f.code)) {
      Err(
        PointFaulted({
          code: f.code,
          message: f.message,
          notes: f.notes,
          values: f.values.map(entering::value_of),
        }),
      )
    } else { Err(PointRaised({ message: f.message, values: f.values.map(entering::value_of) })) },
    entering::Panicked(message) -> Err(ply_fault("`" ++ root ++ "` panicked: " ++ message)),
    entering::NoRoot -> Err(ply_fault("the compiled program has no entry point `" ++ root ++ "`")),
    entering::UnencodableResult(reason) ->
      Err(ply_fault("`" ++ root ++ "` returned, and " ++ reason)),
  }

fn ply_fault(message: String) -> Judgement =
  PointFaulted({
    code: "E0505",
    message: message,
    notes: ["this is Ply's fault, not the program's"],
    values: [],
  })

fn roots_of(p: ProofContext, claim: Int) -> Result<ClaimRoots, Judgement> / {abort.raise} =
  match p.obligations.at(claim) {
    None ->
      Err(
        ply_fault(
          "no claim at index " ++ claim.to_string() ++ "; the run has only this many claims: "
            ++ p.obligations.len().to_string(),
        ),
      ),
    Some(o) -> {
      let owner = Bytes::of_string(o.owner);
      let clause = |kind: ClauseKind, n: Int|
        String::of_bytes_lossy(
          root_text(root_name(Clause({ definition: Named(owner), kind: kind, n: n }))),
        );
      let law = |at: { module: Bytes, label: Bytes }, part: LawPart|
        String::of_bytes_lossy(root_text(root_name(law_key(at.module, at.label, part))));
      match o.kind {
        Ensures(index) ->
          Ok({
            guards: range(0, o.guards.len()).map(|k: Int| clause(Requires, k)),
            body: clause(root_keys::Ensures, index),
            call: if o.result != None { Some(o.owner) } else { None },
          }),
        Law(_) -> match p.laws.get(o.owner) {
          Some(at) ->
            Ok({
              guards: o.guards.map(|g: { module: Int, start: Int, end: Int }| law(at, LawGuard)),
              body: law(at, LawBody),
              call: None,
            }),
          None -> Err(missing_claim(o)),
        },
        _ -> Err(missing_claim(o)),
      }
    },
  }

fn missing_claim(o: Obligation) -> Judgement =
  PointFaulted({
    code: "E0505",
    message: "Ply has no claim recorded for `" ++ o.owner ++ "`",
    notes: [
      "`proof.world` and the front end's claims are read from one program; this is Ply's fault",
    ],
    values: [],
  })

pub fn run_interleaving(
  p: ProofContext,
  claim: Int,
  point: List<Value>,
  seed: Seed,
  steps: Int,
) -> { run: LawRun, warnings: List<Diagnostic> } / {entering::machine.enter, abort.raise} =
  match roots_of(p, claim) {
    Err(fault) ->
      {
        run: {
          interleaving: { steps: [], verdict: Failed(fault), virtual_time: 0 },
          observed: false,
        },
        warnings: [],
      },
    Ok(r) -> {
      let o = entering::machine.enter(p.unit_id, r.body, machine::arguments_of(point), {
        ..entering::unbounded,
        timeout_ms: p.timeout_ms,
        seed: Some({ root: seed.root, path: seed.path, steps: max(steps, 1) }),
      });
      let verdict = match as_boolean(root_value(o.ended, r.body)) {
        Ok(true) -> Passed,
        Ok(false) -> Failed(PointFailed),
        Err(j) -> Failed(j),
      };
      {
        run: match o.interleaving {
          Some(i) ->
            {
              interleaving: {
                steps: i.steps.map(|s: entering::Step| machine::step_of(s, p.roots)),
                verdict: verdict,
                virtual_time: i.virtual_time,
              },
              observed: true,
            },
          None ->
            { interleaving: { steps: [], verdict: verdict, virtual_time: 0 }, observed: false },
        },
        warnings: machine::warnings_of(o, p.roots),
      }
    },
  }

fn cached_at(texts: List<Option<Bytes>>, i: Int) -> Option<Bytes> =
  match texts.at(i) { Some(x) -> x, None -> None }

pub fn claim_at(claims: List<Claim>, i: Int) -> Claim =
  match claims.at(i) {
    Some(c) -> c,
    None ->
      {
        key: "",
        run_key: "",
        owner: "",
        kind: Ensures(0),
        guarded: false,
        frame: NoWrites,
        at: { module: 0, start: 0, end: 0 },
        unused_effects: [],
        schema: None,
      },
  }

pub fn coverage_lines(
  style: Style,
  cov: Coverage,
  carried: Int,
  explain: Bool,
) -> List<String> / {abort.raise} =
  [coverage_head(cov.definitions, carried)].concat(uncovered_lines(style, cov, explain))

pub fn coverage_head(definitions: Int, carried: Int) -> String / {abort.raise} = {
  let unspecified = if definitions > carried { definitions - carried } else { 0 };
  indent ++ count_of(definitions, "definition") ++ " · " ++ carried.to_string()
    ++ " of them have a claim · "
    ++ unspecified.to_string()
    ++ " do not"
}

pub fn uncovered_lines(style: Style, cov: Coverage, explain: Bool) -> List<String> =
  if cov.uncovered.len() == 0 { [] } else {
    let shown = if explain || cov.uncovered.len() < 6 { cov.uncovered.len() } else { 6 };
    let rest = cov.uncovered.len() - shown;
    let tail = if rest > 0 { ", and " ++ rest.to_string() ++ " more (`--explain` for all)" }
    else { "" };
    let names = String::join(range(0, shown).map(|i: Int| cov.uncovered.at_or(i, "")), ", ");
    [
      indent
        ++ dim(
          style,
          cov.uncovered.len().to_string() ++ " definitions have no proved claim: " ++ names ++ tail,
        ),
    ]
  }

pub fn row_head(style: Style, row: Row, places: List<SourceText>) -> String / {abort.raise} = {
  let detail = detail_of(row, places);
  let painted = match row.outcome { Vacuous(_) -> detail, _ -> dim(style, detail) };
  indent ++ mark_of(style, row.outcome) ++ " " ++ outcome_label(row.outcome).pad_right(14, " ")
    ++ " "
    ++ label_of(row.claim).pad_right(40, " ")
    ++ " "
    ++ painted
}

pub const detail_indent: String = indent ++ "    "

pub fn bindings_json(bindings: List<Binding>) -> Json =
  Array(
    bindings.map(|b: Binding|
      object([
        { key: "name", value: Str(b.name) },
        { key: "type", value: Str(b.ty) },
        { key: "value", value: Str(render(b.value)) },
      ])),
  )

fn certificate_json(c: Certificate) -> Json / {abort.raise} =
  object([
    { key: "rules", value: rules_json(c.rules) },
    { key: "steps", value: int(c.steps) },
    { key: "guard_satisfiable", value: Bool(c.guard_satisfiable) },
    { key: "sorts", value: strings(c.sorts) },
    { key: "ran", value: Bool(c.ran) },
    { key: "summary", value: Str(certificate_summary(c)) },
  ])

fn counterexample_json(context: Counterexample) -> Json =
  object([
    { key: "bindings", value: bindings_json(context.bindings) },
    { key: "seed", value: match context.seed { Some(text) -> Str(text), None -> Null } },
  ])

fn stopped_json(stopped: List<Stopped>) -> Json =
  Array(
    stopped.map(|s: Stopped|
      object([
        { key: "kind", value: Str(s.kind) },
        { key: "about", value: match s.about { Some(a) -> Str(a), None -> Null } },
      ])),
  )

fn outcome_members(outcome: Outcome) -> List<Member> / {abort.raise} =
  match outcome {
    Proved(c) -> [{ key: "certificate", value: certificate_json(c) }],
    Refuted(context) -> [{ key: "counterexample", value: counterexample_json(context) }],
    Vacuous(_) -> [{ key: "vacuity", value: Str(vacuity_summary) }],
    Unproved(reason) ->
      [
        { key: "reason", value: Str(reason_summary(reason)) },
        { key: "reason_kind", value: Str(reason_word(reason)) },
      ].concat(match reason {
        Raised(r) ->
          [{ key: "values", value: values_json(r.values) }].concat(if r.bindings.len() == 0 { [] }
          else { [{ key: "raised_at", value: bindings_json(r.bindings) }] }),
        Open(o) -> [{ key: "stopped_at", value: stopped_json(o.stopped) }],
        _ -> [],
      }),
    InternalError(f) -> [{ key: "internal_error", value: fault_json(f) }],
  }

fn fault_json(fault: Fault) -> Json / {abort.raise} =
  object([
    { key: "code", value: Str(fault.code) },
    { key: "message", value: Str(fault_message(fault)) },
    { key: "values", value: values_json(fault.values) },
    { key: "bindings", value: bindings_json(fault.bindings) },
    { key: "summary", value: Str(fault_summary(fault)) },
  ])

fn kind_members(claim: Claim) -> List<Member> =
  match claim.kind {
    Ensures(index) -> [{ key: "index", value: int(index) }],
    Cost(index) -> [{ key: "index", value: int(index) }],
    Space(index) -> [{ key: "index", value: int(index) }],
    Builds(type_name) -> [{ key: "type", value: Str(type_name) }],
    Law(_) -> match claim.schema {
      Some(name) -> [{ key: "schema", value: Str(name) }],
      None -> [],
    },
  }

pub fn obligation_json(
  row: Row,
  places: List<SourceText>,
  include_static_prover: Bool,
) -> Json / {abort.raise} =
  object(
    [
      { key: "key", value: Str(row.claim.key) },
      { key: "owner", value: Str(row.claim.owner) },
      { key: "label", value: Str(label_of(row.claim)) },
      { key: "kind", value: Str(kind_word(row.claim)) },
      { key: "guarded", value: Bool(row.claim.guarded) },
      { key: "frame", value: Str(frame_summary(row.claim.frame)) },
      {
        key: "location",
        value: match location_text(places, row.claim.at) { Some(at) -> Str(at), None -> Null },
      },
      { key: "outcome", value: Str(outcome_word(row.outcome)) },
    ].concat(if include_static_prover {
      [{ key: "static_prover", value: static_prover_json(row.static_prover) }]
    } else { [] }).concat(
      kind_members(row.claim),
    ).concat(
      outcome_members(row.outcome),
    ),
  )

fn static_prover_json(v: Option<StaticProverResult>) -> Json =
  match v {
    None -> Null,
    Some(static_prover) ->
      object([
        { key: "decision", value: Str(static_prover.decision) },
        { key: "steps", value: int(static_prover.steps) },
        {
          key: "blockers",
          value: Array(
            static_prover.blockers.map(|b: { kind: String, about: Option<String> }|
              object([
                { key: "kind", value: Str(b.kind) },
                { key: "about", value: match b.about { Some(a) -> Str(a), None -> Null } },
              ])),
          ),
        },
      ]),
  }

pub fn coverage_json(cov: Coverage) -> Json =
  object([
    { key: "definitions", value: int(cov.definitions) },
    { key: "covered", value: int(cov.covered) },
    { key: "uncovered", value: strings(cov.uncovered) },
  ])

fn sim_json(s: plan::Plan) -> Json / {abort.raise} =
  object([
    { key: "mode", value: Str(plan::mode_word(s.mode)) },
    { key: "roots", value: Array(s.roots.map(|r: U64| int(Int::of_u64(r)))) },
    { key: "budget", value: int(s.budget) },
    { key: "steps", value: int(s.steps) },
  ])

pub fn plan_json(p: Plan) -> Json / {abort.raise} =
  object([
    { key: "prove_budget", value: int(p.prove_budget) },
    { key: "timeout_ms", value: int(p.timeout_ms) },
    { key: "sim", value: sim_json(p.sim) },
  ])

fn span_of(at: ModuleSpan) -> Span = span_between(at.start, at.end)

fn refutation(row: Row, context: Counterexample) -> Diagnostic = {
  let notes = [Bytes::of_string(quantifier(row.claim, context.bindings))];
  error_at(
    b"E0419",
    row.claim.at.module,
    span_of(row.claim.at),
    Bytes::of_string(label_of(row.claim) ++ " is false at " ++ bindings_text(context.bindings)),
    b"this claim does not hold",
    match context.seed {
      Some(seed) -> notes.push(Bytes::of_string("replay with `--seed " ++ seed ++ "`")),
      None -> notes,
    },
  )
}

fn vacuity(row: Row, guard: ModuleSpan) -> Diagnostic =
  error_at(
    b"E0420",
    guard.module,
    span_of(guard),
    Bytes::of_string(label_of(row.claim) ++ " is vacuous: " ++ vacuity_summary),
    b"this guard admits nothing",
    [
      b"an obligation over an empty domain is trivially valid and says nothing",
      b"widen the guard, or delete the claim",
    ],
  )

fn unproved(row: Row, reason: Reason) -> Diagnostic / {abort.raise} =
  error_at(
    b"E0474",
    row.claim.at.module,
    span_of(row.claim.at),
    Bytes::of_string(label_of(row.claim) ++ " is not proved: " ++ reason_summary(reason)),
    b"nothing proves this claim",
    List::concat(
      match reason {
        Raised(raise) -> if raise.bindings.len() == 0 { [] }
        else { [Bytes::of_string("the claim fails at " ++ bindings_text(raise.bindings))] },
        Open(o) -> o.stopped.map(|s: Stopped| Bytes::of_string(stopped_summary(s))),
        _ -> [],
      },
      [
        b"only proved claims count: rewrite the claim so Ply can prove it, or check it in a test and delete the claim",
      ],
    ),
  )

fn internal_error(row: Row, fault: Fault) -> Diagnostic / {abort.raise} = {
  let at = if fault.bindings.len() == 0 { [] }
  else { [Bytes::of_string("at " ++ bindings_text(fault.bindings))] };
  error_at(
    Bytes::of_string(fault.code),
    row.claim.at.module,
    span_of(row.claim.at),
    Bytes::of_string(label_of(row.claim) ++ " is not proved: " ++ fault_summary(fault)),
    b"Ply hit an internal error while trying to prove this",
    fault_notes(fault).map(Bytes::of_string).concat(at),
  )
}

pub fn diagnostics_of(rows: List<Row>) -> List<Diagnostic> / {abort.raise} =
  rows.fold([], |accumulator: List<Diagnostic>, row: Row|
    match row.outcome {
      Proved(_) -> accumulator,
      Refuted(context) -> accumulator.push(refutation(row, context)),
      Vacuous(v) -> accumulator.push(vacuity(row, v.guard)),
      Unproved(reason) -> accumulator.push(unproved(row, reason)),
      InternalError(f) -> accumulator.push(internal_error(row, f)),
    })

pub fn failure_output(
  style: Style,
  command: String,
  reason: Rejection,
) -> CommandOutput / {abort.raise} =
  match reason {
    NotCompiled(r) -> rejected(style, command, r.diagnostics, r.places),
    CacheUnavailable(r) -> reported(style, command, r.diagnostics, r.places),
  }

pub const a_span: ModuleSpan = { module: 0, start: 3, end: 7 }

pub fn a_claim(owner: String, kind: Kind) -> Claim =
  {
    key: "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
    run_key: "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
    owner: owner,
    kind: kind,
    guarded: false,
    frame: NoWrites,
    at: a_span,
    unused_effects: [],
    schema: None,
  }

pub const a_place: SourceText = { path: "m.ply", text: b"fn f() -> Int = 1\nfn g() -> Int = 2\n" }

pub const a_plan: Plan =
  { prove_budget: 10000, timeout_ms: surface::default_timeout_ms, sim: plan::default_plan }

pub fn proved(rules: List<Rule>, steps: Int) -> Outcome =
  Proved({ rules: rules, steps: steps, guard_satisfiable: true, sorts: [], ran: false })

pub const a_counter: Counterexample =
  { bindings: [{ name: "xs", ty: "List<Int>", value: VList([VInt(0), VInt(0)]) }], seed: None }

test "`label_of` names a claim by its function, kind (ensures, cost) and index, or by the text of its law (a stated property) when it has one" {
  assert_eq(label_of(a_claim("m.one", Ensures(0))), "m.one ensures #0");
  assert_eq(
    label_of(a_claim("m.short", Law(Some("a batch is small")))),
    "law \"a batch is small\"",
  );
  assert_eq(label_of(a_claim("m.nameless", Law(None))), "law m.nameless");
  assert_eq(label_of(a_claim("m.one", Cost(1))), "m.one cost #1");
  assert_eq(kind_word(a_claim("m.one", Ensures(0))), "ensures");
  assert_eq(kind_word(a_claim("m.one", Cost(0))), "cost");
  assert_eq(kind_word(a_claim("m.one", Law(None))), "law")
}

test "a label is quoted as Rust quotes it, with a quote and a backslash escaped" {
  assert_eq(quoted("plain"), "\"plain\"");
  assert_eq(quoted("say \"hi\""), "\"say \\\"hi\\\"\"");
  assert_eq(quoted("a\\b"), "\"a\\\\b\"")
}

test "a proof certificate summary lists each rule once, counts function unfoldings, and ends with the step count" {
  let rules = [
    Propositional,
    LinearArithmetic,
    Propositional,
    Unfold({ definition: "m.double", depth: 1 }),
  ];
  assert_eq(
    certificate_summary({
      rules: rules,
      steps: 179,
      guard_satisfiable: true,
      sorts: [],
      ran: false,
    }),
    "propositional · linear arithmetic · 1 unfolding · 179 steps",
  );
  let none = [];
  assert_eq(
    certificate_summary({
      rules: none,
      steps: 1,
      guard_satisfiable: true,
      sorts: ["a"],
      ran: false,
    }),
    "uninterpreted a · 1 steps",
  )
}

test "`certificate_summary` prints an exhaustive-enumeration rule as its point count and type, and a case-split rule as its type and arm count" {
  let enumerated = [ExhaustiveEnumeration({ domain: "Bool", points: 2 })];
  assert_eq(
    certificate_summary({
      rules: enumerated,
      steps: 2,
      guard_satisfiable: true,
      sorts: [],
      ran: false,
    }),
    "exhaustive over 2 points of Bool · 2 steps",
  );
  let split = [CaseSplit({ ty: "Colour", arms: 3 })];
  assert_eq(
    certificate_summary({ rules: split, steps: 4, guard_satisfiable: true, sorts: [], ran: false }),
    "case analysis over Colour (3 arms) · 4 steps",
  )
}

test "an unproved claim's reason says what blocks the proof, and a vacuous claim says its guard admits no value" {
  assert_eq(reason_summary(UnhandledEffect(None)), "an effect is performed with no handler");
  assert_eq(
    reason_summary(UnhandledEffect(Some("{db.read[rows]}"))),
    "performs {db.read[rows]}: no handler",
  );
  assert_eq(reason_summary(Open({ spent: false, stopped: [] })), "no proof");
  assert_eq(vacuity_summary, "no value satisfies the law's condition")
}

test "a row is the outcome, the claim and what it rests on, in fixed columns" {
  let r: Row = {
    claim: a_claim("m.one", Ensures(0)),
    outcome: proved([Congruence], 2),
    reason: Fresh,
    static_prover: None,
  };
  assert_eq(
    row_head(plain, r, [a_place]),
    "   ✓ proved         m.one ensures #0                         congruence · 2 steps",
  )
}

test "a refuted claim reports E0419 and an unproved claim reports E0474, both at the claim's source location" {
  let refuted: Row = {
    claim: a_claim("m.short", Law(Some("a batch is small"))),
    outcome: Refuted(a_counter),
    reason: Fresh,
    static_prover: None,
  };
  let ds = diagnostics_of([refuted]);
  assert_eq(ds.len(), 1);
  let d: Diagnostic = match ds.at(0) { Some(x) -> x, None -> panic("one diagnostic") };
  assert_eq(d.code, b"E0419");
  assert_eq(d.severity, b"error");
  assert_eq(d.message, b"law \"a batch is small\" is false at xs = [0, 0]");
  assert_eq(d.notes_text, [b"forall (xs: List<Int>)"]);
  let raced = diagnostics_of([
    { ..refuted, outcome: Refuted({ ..a_counter, seed: Some("7:0.1") }) },
  ]);
  assert_eq(match raced { [x] -> x.notes_text, _ -> [] }, [
    b"forall (xs: List<Int>)",
    b"replay with `--seed 7:0.1`",
  ]);
  let reason: Row = {
    claim: a_claim("m.stored", Ensures(0)),
    outcome: Unproved(UnhandledEffect(Some("{db.read[rows]}"))),
    reason: Fresh,
    static_prover: None,
  };
  let e: Diagnostic = match diagnostics_of([reason]) { [x] -> x, _ -> panic("one diagnostic") };
  assert_eq(e.code, b"E0474");
  assert_eq(e.severity, b"error");
  assert_eq(e.message, b"m.stored ensures #0 is not proved: performs {db.read[rows]}: no handler");
  assert_eq(exit_code_of([reason]), failure_code);
  assert(
    row_head(plain, reason, [a_place]).starts_with("   ✗ unproved       m.stored ensures #0"),
  )
}

test "an unproved claim's E0474 error notes the construct where the prover stopped and why the cost bound could not be proved" {
  let open: Row = {
    claim: a_claim("m.total", Cost(0)),
    outcome: Unproved(
      Open({
        spent: false,
        stopped: [
          { kind: "lambda", about: None },
          { kind: "unbounded", about: Some("its steps outgrow the bound") },
        ],
      }),
    ),
    reason: Fresh,
    static_prover: None,
  };
  let d: Diagnostic = match diagnostics_of([open]) { [x] -> x, _ -> panic("one diagnostic") };
  assert_eq(d.code, b"E0474");
  assert_eq(d.message, b"m.total cost #0 is not proved: no proof");
  assert_eq(d.notes_text, [
    b"the prover stopped at lambda",
    b"its steps outgrow the bound",
    b"only proved claims count: rewrite the claim so Ply can prove it, or check it in a test and delete the claim",
  ]);
  let row: ClaimRow = match claim_rows(a_collection_of([open.claim]), [0], [open.outcome]) {
    [x] -> x,
    _ -> panic("one row"),
  };
  assert_eq(row.proved, false);
  assert_eq(row.discharged, false)
}

pub const a_fault: Fault =
  {
    code: "E0505",
    message: "the compiled program has no entry point `m.law`",
    notes: ["this is Ply's fault, not the program's"],
    values: [],
    bindings: [{ name: "b", ty: "Bool", value: VBool(true) }],
  }

test "an internal prover failure reports error E0505 at the claim, separate from an unproved claim, and is counted as an internal error" {
  let r: Row = {
    claim: a_claim("m.one", Ensures(0)),
    outcome: InternalError(a_fault),
    reason: Fresh,
    static_prover: None,
  };
  let d: Diagnostic = match diagnostics_of([r]) { [x] -> x, _ -> panic("one diagnostic") };
  assert_eq(d.code, b"E0505");
  assert_eq(d.severity, b"error");
  assert_eq(
    d.message,
    b"m.one ensures #0 is not proved: this is a bug in Ply, not in your program: the compiled program has no entry point `m.law`",
  );
  assert_eq(d.notes_text, [b"this is Ply's fault, not the program's", b"at b = true"]);
  assert_eq(count_unproved([r]), 0);
  assert_eq(count_internal_errors([r]), 1);
  assert_eq(exit_code_of([r]), failure_code);
  assert(
    row_head(plain, r, [a_place]).starts_with(
      "   ! internal error m.one ensures #0                         this is a bug in Ply, not in your program",
    ),
  );
  let row: ClaimRow = match claim_rows(a_collection_of([r.claim]), [0], [r.outcome]) {
    [x] -> x,
    _ -> panic("one row"),
  };
  assert_eq(row.proved, false);
  assert_eq(row.discharged, false)
}

test "a claim whose run raised an error lists the values named in the error as strings in its JSON document" {
  let raised: Row = {
    claim: a_claim("m.one", Ensures(0)),
    outcome: Unproved(Raised({ message: "raised", values: [VInt(3)], bindings: [] })),
    reason: Fresh,
    static_prover: None,
  };
  let internal_error = { ..raised, outcome: InternalError({ ..a_fault, values: [VInt(4)] }) };
  let texts = [raised, internal_error].map(|r: Row|
    to_string(obligation_json(r, [a_place], false)));
  assert(texts.at_or(0, "").contains("\"values\":[\"3\"]"));
  assert(texts.at_or(1, "").contains("\"values\":[\"4\"]"))
}

fn a_collection_of(claims: List<Claim>) -> Collection =
  {
    places: [a_place],
    warnings: [],
    claims: claims,
    definitions: [],
    laws: [],
    plan: a_plan,
    world: empty_prover_input,
    modules: [],
    lanes: None,
  }

test "a proved claim produces no diagnostics" {
  let proved_row: Row = {
    claim: a_claim("m.one", Ensures(0)),
    outcome: proved([], 1),
    reason: FromProof,
    static_prover: None,
  };
  assert_eq(diagnostics_of([proved_row]).len(), 0)
}

test "the coverage lines start with the definition and obligation counts, then list the definitions no proved claim covers" {
  let cov: Coverage = { definitions: 3, covered: 0, uncovered: ["m.double", "m.main", "m.triple"] };
  assert_eq(coverage_lines(plain, cov, 0, false), [
    "   3 definitions · 0 of them have a claim · 3 do not",
    "   3 definitions have no proved claim: m.double, m.main, m.triple",
  ])
}

test "past six uncovered definitions the rest are counted rather than listed" {
  let names = range(0, 8).map(|i: Int| "m.d" ++ i.to_string());
  let cov: Coverage = { definitions: 8, covered: 0, uncovered: names };
  let lines = coverage_lines(plain, cov, 0, false);
  assert(lines.at_or(1, "").contains("and 2 more (`--explain` for all)"));
  assert(!lines.at_or(1, "").contains("m.d6"));
  assert(coverage_lines(plain, cov, 0, true).at_or(1, "").contains("m.d7"))
}

test "`seconds` prints a time in milliseconds as seconds with two decimal places" {
  assert_eq(seconds(0.974m), "0.00");
  assert_eq(seconds(1500m), "1.50");
  assert_eq(seconds(12345.6m), "12.35");
  assert_eq(seconds(Decimal::of_int(0)), "0.00")
}

test "a claim's run time limit is the `--timeout` value in milliseconds, and the default when the flag is absent" {
  let timeout = |line: List<String>| plan_of(options_from(surface::parsed(line))).timeout_ms;
  assert_eq(timeout(["prove", "--timeout", "250"]), 250);
  assert_eq(timeout(["review", "--timeout", "0"]), 0);
  assert_eq(timeout(["prove"]), surface::default_timeout_ms);
  assert_eq(plan_of(no_options).timeout_ms, surface::default_timeout_ms)
}

pub const no_options: Options =
  {
    no_incremental: false,
    jobs: None,
    prove: { budget: None, timeout: None },
    sim: machine::no_sim_options,
  }

pub fn collected_part(collection: Collection) -> LoadResult =
  { places: collection.places, warnings: collection.warnings }

pub fn claimed_part(collection: Collection) -> OwnClaims =
  {
    claims: collection.claims,
    definitions: collection.definitions,
    laws: collection.laws,
    warnings: [],
    world: collection.world,
    modules: collection.modules,
  }
