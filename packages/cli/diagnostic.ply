//! A front-end diagnostic as an agent and as a person read it: JSON, and text in one shape whichever
//! command raised it, painted or plain — the heading, one block per label it can place, the notes.

import compiler.check.resolve.tables (Diag, Label, Fix, Edit)
import std.json (Json, Member, Object, Null, Str, Bool, Number, Array, object)
import compiler.syntax.lexer
import std.bytes
import std.value (Value, VBytes, VInt, VList, filled, render, render_all, shown_characters)
import std.term (Style, plain, dim, red, yellow, ansi)
import std.list (somes)
import std.string
import compiler.syntax.parsing (no_module)

/// A module the label indices point into: the program's files, then the shipped modules it pulled.
pub type Place = { path: String, text: Bytes }

/// A diagnostic the runtime raised, beside the values its text names: `shown` writes them into its
/// text, and `raised_json` beside it whole.
pub type Raised = { diag: Diag, values: List<Value> }

/// The diagnostic with each value it names rendered in place.
pub fn shown(raised: Raised) -> Diag / {abort.raise} = {
  let fill = |b: Bytes| Bytes::of_string(filled(String::of_bytes_lossy(b), raised.values));
  {
    ..raised.diag,
    message: fill(raised.diag.message),
    notes_text: raised.diag.notes_text.map(fill),
    labels: raised.diag.labels.map(|label: Label| { ..label, text: fill(label.text) }),
  }
}

/// A diagnostic this program raises of its own, with its notes in order.
pub fn diag_of(
  severity: String,
  code: String,
  message: String,
  labels: List<Label>,
  notes: List<String>,
) -> Diag =
  {
    code: Bytes::of_string(code),
    notes: notes.len(),
    labels: labels,
    text: b"",
    message: Bytes::of_string(message),
    notes_text: notes.map(Bytes::of_string),
    severity: Bytes::of_string(severity),
    fixes: [],
  }

/// The primary label of a diagnostic that points at nothing in any module.
pub fn placeless(text: String) -> Label =
  { module: no_module(), start: 0, end: 0, primary: true, text: Bytes::of_string(text) }

/// The same diagnostic, with more notes after its own.
pub fn noted(diag: Diag, notes: List<String>) -> Diag =
  {
    ..diag,
    notes: diag.notes + notes.len(),
    notes_text: notes.fold(diag.notes_text, |acc: List<Bytes>, n: String|
      acc.push(Bytes::of_string(n))),
  }

// The module index a span outside every module carries.

fn place_at(places: List<Place>, module: Int) -> Option<Place> =
  if module == no_module() { None } else { places.at(module) }

// --- Lines and columns ---------------------------------------------------------
// One-based, with the column counted in characters, as `SourceFile::line_col` counts it.

pub type Spot = { line: Int, col: Int, offset: Int }

fn is_continuation(c: Int) -> Bool = c / 64 == 2

fn chars_between(text: Bytes, from: Int, to: Int) -> Int / {abort.raise} =
  range(from, to).fold(0, |n: Int, i: Int| if is_continuation(text.at(i)) { n } else { n + 1 })

/// Where the line `offset` sits on starts, and its number, found a newline at a time: a command
/// placing every definition pays this once each.
fn line_of(text: Bytes, offset: Int) -> { start: Int, line: Int } / {abort.raise} =
  iterate({ start: 0, line: 1 }, offset + 2, |s: { start: Int, line: Int }|
    match text.index_of_from(b"\n", s.start) {
      Some(i) -> if i < offset { Continue({ start: i + 1, line: s.line + 1 }) } else { Stop(s) },
      None -> Stop(s),
    })

fn line_start(text: Bytes, offset: Int) -> Int / {abort.raise} = line_of(text, offset).start

pub fn spot_of(text: Bytes, offset: Int) -> Spot / {abort.raise} = {
  let at_line = line_of(text, offset);
  { line: at_line.line, col: chars_between(text, at_line.start, offset) + 1, offset: offset }
}

/// The bytes a span covers, or nothing when it is not a range of this text.
fn slice_of(text: Bytes, start: Int, end: Int) -> Option<Bytes> =
  if start < 0 || end < start || end > text.len() { None } else { Some(text.slice(start, end)) }

// --- JSON -----------------------------------------------------------------------

fn spot_json(spot: Spot) -> Json =
  object([
    { key: "line", value: Number(Decimal::of_int(spot.line)) },
    { key: "col", value: Number(Decimal::of_int(spot.col)) },
    { key: "offset", value: Number(Decimal::of_int(spot.offset)) },
  ])

/// A label whose span is not a range of its module's text is dropped, as the text drops it.
fn label_json(places: List<Place>, label: Label) -> Option<Json> / {abort.raise} =
  match place_at(places, label.module) {
    None -> None,
    Some(p) -> match slice_of(p.text, label.start, label.end) {
      None -> None,
      Some(text) ->
        Some(
          object([
            { key: "file", value: Str(p.path) },
            { key: "start", value: spot_json(spot_of(p.text, label.start)) },
            { key: "end", value: spot_json(spot_of(p.text, label.end)) },
            { key: "message", value: Str(String::of_bytes_lossy(label.text)) },
            { key: "primary", value: Bool(label.primary) },
            { key: "snippet", value: Str(String::of_bytes_lossy(text)) },
          ]),
        ),
    },
  }

fn edit_json(places: List<Place>, e: Edit) -> Option<Json> / {abort.raise} =
  match place_at(places, e.module) {
    None -> None,
    Some(p) -> match slice_of(p.text, e.start, e.end) {
      None -> None,
      Some(_) ->
        Some(
          object([
            { key: "file", value: Str(p.path) },
            { key: "start", value: spot_json(spot_of(p.text, e.start)) },
            { key: "end", value: spot_json(spot_of(p.text, e.end)) },
            { key: "text", value: Str(String::of_bytes_lossy(e.text)) },
          ]),
        ),
    },
  }

fn fix_json(places: List<Place>, f: Fix) -> Json / {abort.raise} =
  object([
    { key: "title", value: Str(String::of_bytes_lossy(f.title)) },
    { key: "edits", value: Array(somes(f.edits.map(|e: Edit| edit_json(places, e)))) },
  ])

pub fn to_json(diag: Diag, places: List<Place>) -> Json / {abort.raise} =
  object(members(diag, places))

/// The diagnostic as `to_json` writes it once `shown`, with `values`: each value its text names, by
/// slot, written whole where the text may show it cut.
pub fn raised_json(raised: Raised, places: List<Place>) -> Json / {abort.raise} =
  object(members(shown(raised), places).push({ key: "values", value: values_json(raised.values) }))

/// Each value as `render_all` writes it, in order.
pub fn values_json(values: List<Value>) -> Json = Array(values.map(|v: Value| Str(render_all(v))))

fn members(diag: Diag, places: List<Place>) -> List<Member> / {abort.raise} =
  [
    { key: "severity", value: Str(String::of_bytes_lossy(diag.severity)) },
    { key: "code", value: Str(String::of_bytes_lossy(diag.code)) },
    { key: "message", value: Str(String::of_bytes_lossy(diag.message)) },
    {
      key: "labels",
      value: Array(somes(diag.labels.map(|label: Label| label_json(places, label)))),
    },
    { key: "notes", value: Array(diag.notes_text.map(|n: Bytes| Str(String::of_bytes_lossy(n)))) },
    { key: "fixes", value: Array(diag.fixes.map(|f: Fix| fix_json(places, f))) },
  ]

pub fn all_to_json(diags: List<Diag>, places: List<Place>) -> Json / {abort.raise} =
  Array(diags.map(|diag: Diag| to_json(diag, places)))

/// Line and column rather than byte offsets, for editors.
pub fn place_json(
  places: List<Place>,
  a: { module: Int, start: Int, end: Int },
) -> Json / {abort.raise} =
  match place_at(places, a.module) {
    None -> Null,
    Some(place) -> {
      let from: Spot = spot_of(place.text, a.start);
      let to: Spot = spot_of(place.text, a.end);
      object([
        { key: "file", value: Str(place.path) },
        { key: "line", value: Number(Decimal::of_int(from.line)) },
        { key: "column", value: Number(Decimal::of_int(from.col)) },
        { key: "end_line", value: Number(Decimal::of_int(to.line)) },
        { key: "end_column", value: Number(Decimal::of_int(to.col)) },
      ])
    },
  }

// --- Text -----------------------------------------------------------------------

fn titled(severity: Bytes) -> String =
  if severity == b"error" { "Error" }
  else if severity == b"warning" { "Warning" }
  else if severity == b"note" { "Note" }
  else { String::of_bytes_lossy(severity) }

/// Colour is paint on the shape and nothing else: strip the escapes and a styled render is the
/// plain one, byte for byte.
fn painted(style: Style, severity: Bytes, text: String) -> String =
  if severity == b"error" { red(style, text) }
  else if severity == b"warning" { yellow(style, text) }
  else if severity == b"note" { dim(style, text) }
  else { text }

pub fn end_of_line(text: Bytes, from: Int) -> Int / {abort.raise} =
  match text.index_of_from(b"\n", from) { Some(i) -> i, None -> text.len() }

/// The line `offset` sits on, without its newline.
fn line_text(text: Bytes, offset: Int) -> String / {abort.raise} = {
  let start = line_start(text, offset);
  String::of_bytes_lossy(text.slice(start, end_of_line(text, start)))
}

/// The caret run under one line: the span's own width, or one caret for an empty span, and never
/// past the end of the line the span opens on.
fn carets(text: Bytes, start: Int, end: Int) -> String / {abort.raise} = {
  let from = line_start(text, start);
  let eol = end_of_line(text, from);
  let stop = if end > eol { eol } else { end };
  let width = chars_between(text, start, stop);
  " ".repeat(chars_between(text, from, start)) ++ "^".repeat(if width < 1 { 1 } else { width })
}

fn placed_lines(
  style: Style,
  severity: Bytes,
  place: Place,
  label: Label,
) -> List<String> / {abort.raise} = {
  let at = spot_of(place.text, label.start);
  let said = String::of_bytes_lossy(label.text);
  let tail = if said == "" { "" } else { " " ++ said };
  [
    "  --> " ++ place.path ++ ":" ++ at.line.to_string() ++ ":" ++ at.col.to_string(),
    "   | " ++ line_text(place.text, label.start),
    "   | " ++ painted(style, severity, carets(place.text, label.start, label.end)) ++ tail,
  ]
}

fn label_lines(
  style: Style,
  severity: Bytes,
  places: List<Place>,
  label: Label,
) -> List<String> / {abort.raise} =
  match place_at(places, label.module) {
    None -> [],
    Some(p) -> match slice_of(p.text, label.start, label.end) {
      None -> [],
      Some(_) -> placed_lines(style, severity, p, label),
    },
  }

/// One diagnostic as lines, none of them ending in a newline.
pub fn to_text(style: Style, diag: Diag, places: List<Place>) -> List<String> / {abort.raise} = {
  let title = painted(
    style,
    diag.severity,
    titled(diag.severity) ++ "[" ++ String::of_bytes_lossy(diag.code) ++ "]",
  );
  let head = [title ++ ": " ++ String::of_bytes_lossy(diag.message)];
  let labelled = diag.labels.fold(head, |acc: List<String>, label: Label|
    acc.concat(label_lines(style, diag.severity, places, label)));
  let noted = diag.notes_text.fold(labelled, |acc: List<String>, n: Bytes|
    acc.push("  = " ++ String::of_bytes_lossy(n)));
  diag.fixes.fold(noted, |acc: List<String>, f: Fix|
    acc.push("  = fix: " ++ String::of_bytes_lossy(f.title)))
}

pub fn all_to_text(
  style: Style,
  diags: List<Diag>,
  places: List<Place>,
) -> List<String> / {abort.raise} =
  diags.fold([], |acc: List<String>, diag: Diag| acc.concat(to_text(style, diag, places)))

pub fn errors_of(diags: List<Diag>) -> List<Diag> =
  diags.filter(|diag: Diag| diag.severity == b"error")

pub fn errors_text(diags: List<Diag>) -> String =
  String::join(
    errors_of(diags).map(|diag: Diag| {
      let said = match diag.labels.find(|l: Label| l.primary && l.text.len() > 0) {
        Some(l) -> ": " ++ String::of_bytes_lossy(l.text),
        None -> "",
      };
      String::of_bytes_lossy(diag.message) ++ said ++ " [" ++ String::of_bytes_lossy(diag.code)
        ++ "]"
    }),
    "; ",
  )

// --- Tests ------------------------------------------------------------------

fn source() -> Bytes = b"fn f() -> Int = \"x\"\nfn g() -> Int = 1\n"

fn one_place() -> List<Place> = [{ path: "m.ply", text: source() }]

/// The second module's `é` is two bytes, so a span may land inside it.
fn two_places() -> List<Place> =
  [{ path: "m.ply", text: source() }, { path: "u.ply", text: b"fn \xc3\xa9() -> Int = 1\n" }]

fn as_bytes(lines: List<String>) -> List<Bytes> = lines.map(|l: String| Bytes::of_string(l))

fn a_diag_of(
  severity: Bytes,
  code: Bytes,
  message: Bytes,
  labels: List<Label>,
  notes: List<Bytes>,
  fixes: List<Fix>,
) -> Diag =
  {
    code: code,
    notes: notes.len(),
    labels: labels,
    text: b"",
    message: message,
    notes_text: notes,
    severity: severity,
    fixes: fixes,
  }

fn mismatch() -> Diag =
  a_diag_of(
    b"error",
    b"E0201",
    b"type mismatch: function body type",
    [{ module: 0, start: 16, end: 19, primary: true, text: b"expected `Int`, found `String`" }],
    [b"the body must answer the written type"],
    [],
  )

test "a spot is one-based, and a column counts characters rather than bytes" {
  assert_eq(spot_of(source(), 0), { line: 1, col: 1, offset: 0 });
  assert_eq(spot_of(source(), 16), { line: 1, col: 17, offset: 16 });
  // The newline itself closes the line it ends.
  assert_eq(spot_of(source(), 19), { line: 1, col: 20, offset: 19 });
  assert_eq(spot_of(source(), 20), { line: 2, col: 1, offset: 20 });
  assert_eq(spot_of(b"\xc3\xa9x", 2), { line: 1, col: 2, offset: 2 })
}

test "the JSON is one object per diagnostic, with the label placed and its snippet cut" {
  assert_eq(
    to_json(mismatch(), one_place()),
    object([
      { key: "severity", value: Str("error") },
      { key: "code", value: Str("E0201") },
      { key: "message", value: Str("type mismatch: function body type") },
      {
        key: "labels",
        value: Array([
          object([
            { key: "file", value: Str("m.ply") },
            { key: "start", value: spot_json({ line: 1, col: 17, offset: 16 }) },
            { key: "end", value: spot_json({ line: 1, col: 20, offset: 19 }) },
            { key: "message", value: Str("expected `Int`, found `String`") },
            { key: "primary", value: Bool(true) },
            { key: "snippet", value: Str("\"x\"") },
          ]),
        ]),
      },
      { key: "notes", value: Array([Str("the body must answer the written type")]) },
      { key: "fixes", value: Array([]) },
    ]),
  )
}

test "a label outside every module, or outside its text, is dropped rather than placed" {
  let outside = a_diag_of(
    b"error",
    b"E0201",
    b"type mismatch: function body type",
    [{ module: no_module(), start: 0, end: 0, primary: true, text: b"nowhere" }],
    [],
    [],
  );
  match to_json(outside, one_place()) {
    Object(m) -> assert_eq(m.get("labels"), Some(Array([]))),
    _ -> panic("a diagnostic renders as an object"),
  };
  let past = a_diag_of(
    b"error",
    b"E0201",
    b"type mismatch: function body type",
    [{ module: 0, start: 900, end: 901, primary: true, text: b"past the end" }],
    [b"the body must answer the written type"],
    [],
  );
  assert_eq(to_text(plain(), past, one_place()), [
    "Error[E0201]: type mismatch: function body type",
    "  = the body must answer the written type",
  ])
}

// A span that splits a character is a defect in whoever built it, and the line it points at is
// worth more to a reader than a dropped label, so the bound is the text's length and nothing else.
test "a span cutting a character in half is still placed, on the line it opens" {
  let split = a_diag_of(
    b"error",
    b"E0201",
    b"type mismatch",
    [{ module: 1, start: 4, end: 6, primary: true, text: b"here" }],
    [],
    [],
  );
  assert_eq(as_bytes(to_text(plain(), split, two_places())), [
    b"Error[E0201]: type mismatch",
    b"  --> u.ply:1:5",
    b"   | fn \xc3\xa9() -> Int = 1",
    b"   |     ^ here",
  ])
}

test "the text names the file, prints the line and underlines the span" {
  assert_eq(to_text(plain(), mismatch(), one_place()), [
    "Error[E0201]: type mismatch: function body type",
    "  --> m.ply:1:17",
    "   | fn f() -> Int = \"x\"",
    "   |                 ^^^ expected `Int`, found `String`",
    "  = the body must answer the written type",
  ])
}

// The heading and the caret run wear the severity's colour, and nothing else moves: drop the
// escapes from these lines and the plain render is back.
test "colour is paint on the shape and the shape does not move" {
  assert_eq(as_bytes(to_text(ansi(), mismatch(), one_place())), [
    b"\x1b[31mError[E0201]\x1b[0m: type mismatch: function body type",
    b"  --> m.ply:1:17",
    b"   | fn f() -> Int = \"x\"",
    b"   | \x1b[31m                ^^^\x1b[0m expected `Int`, found `String`",
    b"  = the body must answer the written type",
  ])
}

test "an empty span still gets one caret, and a fix is a note of its own" {
  let insertion = a_diag_of(
    b"warning",
    b"E0126",
    b"this needs a type",
    [{ module: 0, start: 5, end: 5, primary: true, text: b"" }],
    [],
    [{ title: b"add the type", edits: [{ module: 0, start: 5, end: 5, text: b": Int" }] }],
  );
  assert_eq(to_text(plain(), insertion, one_place()), [
    "Warning[E0126]: this needs a type",
    "  --> m.ply:1:6",
    "   | fn f() -> Int = \"x\"",
    "   |      ^",
    "  = fix: add the type",
  ]);
  // A warning is yellow where an error is red.
  assert_eq(as_bytes(to_text(ansi(), insertion, one_place())), [
    b"\x1b[33mWarning[E0126]\x1b[0m: this needs a type",
    b"  --> m.ply:1:6",
    b"   | fn f() -> Int = \"x\"",
    b"   | \x1b[33m     ^\x1b[0m",
    b"  = fix: add the type",
  ])
}

test "only the errors are errors" {
  let warning = a_diag_of(b"warning", b"W0611", b"never used", [], [], []);
  assert_eq(errors_of([mismatch(), warning]).len(), 1)
}

test "a raise's values are rendered into its message, notes and labels" {
  let slot = String::of_bytes(b"\x010\x02");
  let d = shown({
    diag: a_diag_of(b"error", b"E0501", Bytes::of_string("found " ++ slot), [], [], []),
    values: [VInt(7)],
  });
  assert_eq(d.message, b"found 7")
}

test "a raise's JSON carries each value its text names whole, beside the text that shows it cut" {
  let slot = String::of_bytes(b"\x010\x02");
  let long = VList(range(0, shown_characters()).map(|i: Int| VInt(i)));
  let raised = {
    diag: a_diag_of(b"error", b"E0501", Bytes::of_string("found " ++ slot), [], [], []),
    values: [long],
  };
  match raised_json(raised, one_place()) {
    Object(m) -> {
      assert_eq(m.get("values"), Some(Array([Str(render_all(long))])));
      assert_eq(Object(m.remove("values")), to_json(shown(raised), one_place()))
    },
    _ -> panic("a diagnostic renders as an object"),
  };
  assert(render(long) != render_all(long))
}

// The rendered text of any byte is a byte literal the lexer reads back to that byte.
test "every byte a value renders lexes back to the byte it came from" {
  let all = Bytes::concat_all(range(0, 256).map(|i: Int| byte_of_int(i)));
  let dump = lexer::dump(Bytes::of_string(render_all(VBytes(all))));
  let first = match dump.split(";") {
    [first, ..] -> match first.split(":") { [_, _, kind, hex] -> kind ++ ":" ++ hex, _ -> first },
    [] -> dump,
  };
  assert_eq(first, "b:" ++ all.hex_of())
}
