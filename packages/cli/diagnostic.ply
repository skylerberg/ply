import compiler.check.resolve.tables (Diagnostic, Label, Fix, Edit)
import std.json (Json, Member, Object, Null, Str, Bool, Number, Array, object)
import compiler.syntax.lexer
import std.bytes
import std.value (Value, VBytes, VInt, VList, filled, render, render_all, shown_characters)
import std.term (Style, plain, dim, red, yellow, ansi)
import std.list (somes)
import std.string
import compiler.syntax.parsing (no_module)

pub type SourceText = { path: String, text: Bytes }

pub type RuntimeDiagnostic = { diagnostic: Diagnostic, values: List<Value> }

pub fn shown(raised: RuntimeDiagnostic) -> Diagnostic / {abort.raise} = {
  let fill = |b: Bytes| Bytes::of_string(filled(String::of_bytes_lossy(b), raised.values));
  {
    ..raised.diagnostic,
    message: fill(raised.diagnostic.message),
    notes_text: raised.diagnostic.notes_text.map(fill),
    labels: raised.diagnostic.labels.map(|label: Label| { ..label, text: fill(label.text) }),
  }
}

pub fn diagnostic_of(
  severity: String,
  code: String,
  message: String,
  labels: List<Label>,
  notes: List<String>,
) -> Diagnostic =
  {
    code: Bytes::of_string(code),
    notes: notes.len(),
    labels: labels,
    text: b"",
    message: Bytes::of_string(message),
    notes_text: notes.map(Bytes::of_string),
    severity: Bytes::of_string(severity),
    fixes: [],
  }

pub fn with_notes(diagnostic: Diagnostic, notes: List<String>) -> Diagnostic =
  {
    ..diagnostic,
    notes: diagnostic.notes + notes.len(),
    notes_text: notes.fold(diagnostic.notes_text, |accumulator: List<Bytes>, n: String|
      accumulator.push(Bytes::of_string(n))),
  }

fn source_at(places: List<SourceText>, module: Int) -> Option<SourceText> =
  if module == no_module { None } else { places.at(module) }

pub type Position = { line: Int, column: Int, offset: Int }

fn is_continuation(c: Int) -> Bool = c / 64 == 2

fn chars_between(text: Bytes, from: Int, to: Int) -> Int / {abort.raise} =
  range(from, to).fold(0, |n: Int, i: Int| if is_continuation(text.at(i)) { n } else { n + 1 })

fn line_of(text: Bytes, offset: Int) -> { start: Int, line: Int } / {abort.raise} =
  iterate({ start: 0, line: 1 }, offset + 2, |s: { start: Int, line: Int }|
    match text.index_of_from(b"\n", s.start) {
      Some(i) -> if i < offset { Continue({ start: i + 1, line: s.line + 1 }) } else { Stop(s) },
      None -> Stop(s),
    })

fn line_start(text: Bytes, offset: Int) -> Int / {abort.raise} = line_of(text, offset).start

pub fn position_of(text: Bytes, offset: Int) -> Position / {abort.raise} = {
  let at_line = line_of(text, offset);
  { line: at_line.line, column: chars_between(text, at_line.start, offset) + 1, offset: offset }
}

fn slice_of(text: Bytes, start: Int, end: Int) -> Option<Bytes> =
  if start < 0 || end < start || end > text.len() { None } else { Some(text.slice(start, end)) }

fn position_json(spot: Position) -> Json =
  object([
    { key: "line", value: Number(Decimal::of_int(spot.line)) },
    { key: "col", value: Number(Decimal::of_int(spot.column)) },
    { key: "offset", value: Number(Decimal::of_int(spot.offset)) },
  ])

fn label_json(places: List<SourceText>, label: Label) -> Option<Json> / {abort.raise} =
  match source_at(places, label.module) {
    None -> None,
    Some(p) -> match slice_of(p.text, label.start, label.end) {
      None -> None,
      Some(text) ->
        Some(
          object([
            { key: "file", value: Str(p.path) },
            { key: "start", value: position_json(position_of(p.text, label.start)) },
            { key: "end", value: position_json(position_of(p.text, label.end)) },
            { key: "message", value: Str(String::of_bytes_lossy(label.text)) },
            { key: "primary", value: Bool(label.primary) },
            { key: "snippet", value: Str(String::of_bytes_lossy(text)) },
          ]),
        ),
    },
  }

fn edit_json(places: List<SourceText>, e: Edit) -> Option<Json> / {abort.raise} =
  match source_at(places, e.module) {
    None -> None,
    Some(p) -> match slice_of(p.text, e.start, e.end) {
      None -> None,
      Some(_) ->
        Some(
          object([
            { key: "file", value: Str(p.path) },
            { key: "start", value: position_json(position_of(p.text, e.start)) },
            { key: "end", value: position_json(position_of(p.text, e.end)) },
            { key: "text", value: Str(String::of_bytes_lossy(e.text)) },
          ]),
        ),
    },
  }

fn fix_json(places: List<SourceText>, f: Fix) -> Json / {abort.raise} =
  object([
    { key: "title", value: Str(String::of_bytes_lossy(f.title)) },
    { key: "edits", value: Array(somes(f.edits.map(|e: Edit| edit_json(places, e)))) },
  ])

pub fn to_json(diagnostic: Diagnostic, places: List<SourceText>) -> Json / {abort.raise} =
  object(members(diagnostic, places))

pub fn runtime_diagnostic_json(
  raised: RuntimeDiagnostic,
  places: List<SourceText>,
) -> Json / {abort.raise} =
  object(members(shown(raised), places).push({ key: "values", value: values_json(raised.values) }))

pub fn values_json(values: List<Value>) -> Json = Array(values.map(|v: Value| Str(render_all(v))))

fn members(diagnostic: Diagnostic, places: List<SourceText>) -> List<Member> / {abort.raise} =
  [
    { key: "severity", value: Str(String::of_bytes_lossy(diagnostic.severity)) },
    { key: "code", value: Str(String::of_bytes_lossy(diagnostic.code)) },
    { key: "message", value: Str(String::of_bytes_lossy(diagnostic.message)) },
    {
      key: "labels",
      value: Array(somes(diagnostic.labels.map(|label: Label| label_json(places, label)))),
    },
    {
      key: "notes",
      value: Array(diagnostic.notes_text.map(|n: Bytes| Str(String::of_bytes_lossy(n)))),
    },
    { key: "fixes", value: Array(diagnostic.fixes.map(|f: Fix| fix_json(places, f))) },
  ]

pub fn all_to_json(
  diagnostics: List<Diagnostic>,
  places: List<SourceText>,
) -> Json / {abort.raise} =
  Array(diagnostics.map(|diagnostic: Diagnostic| to_json(diagnostic, places)))

pub fn editor_location_json(
  places: List<SourceText>,
  a: { module: Int, start: Int, end: Int },
) -> Json / {abort.raise} =
  match source_at(places, a.module) {
    None -> Null,
    Some(place) -> {
      let from: Position = position_of(place.text, a.start);
      let to: Position = position_of(place.text, a.end);
      object([
        { key: "file", value: Str(place.path) },
        { key: "line", value: Number(Decimal::of_int(from.line)) },
        { key: "column", value: Number(Decimal::of_int(from.column)) },
        { key: "end_line", value: Number(Decimal::of_int(to.line)) },
        { key: "end_column", value: Number(Decimal::of_int(to.column)) },
      ])
    },
  }

fn severity_title(severity: Bytes) -> String =
  if severity == b"error" { "Error" }
  else if severity == b"warning" { "Warning" }
  else if severity == b"note" { "Note" }
  else { String::of_bytes_lossy(severity) }

fn colored(style: Style, severity: Bytes, text: String) -> String =
  if severity == b"error" { red(style, text) }
  else if severity == b"warning" { yellow(style, text) }
  else if severity == b"note" { dim(style, text) }
  else { text }

pub fn end_of_line(text: Bytes, from: Int) -> Int / {abort.raise} =
  match text.index_of_from(b"\n", from) { Some(i) -> i, None -> text.len() }

fn line_text(text: Bytes, offset: Int) -> String / {abort.raise} = {
  let start = line_start(text, offset);
  String::of_bytes_lossy(text.slice(start, end_of_line(text, start)))
}

fn carets(text: Bytes, start: Int, end: Int) -> String / {abort.raise} = {
  let from = line_start(text, start);
  let eol = end_of_line(text, from);
  let stop = if end > eol { eol } else { end };
  let width = chars_between(text, start, stop);
  " ".repeat(chars_between(text, from, start)) ++ "^".repeat(if width < 1 { 1 } else { width })
}

fn snippet_lines(
  style: Style,
  severity: Bytes,
  place: SourceText,
  label: Label,
) -> List<String> / {abort.raise} = {
  let at = position_of(place.text, label.start);
  let label_text = String::of_bytes_lossy(label.text);
  let tail = if label_text == "" { "" } else { " " ++ label_text };
  [
    "  --> " ++ place.path ++ ":" ++ at.line.to_string() ++ ":" ++ at.column.to_string(),
    "   | " ++ line_text(place.text, label.start),
    "   | " ++ colored(style, severity, carets(place.text, label.start, label.end)) ++ tail,
  ]
}

fn label_lines(
  style: Style,
  severity: Bytes,
  places: List<SourceText>,
  label: Label,
) -> List<String> / {abort.raise} =
  match source_at(places, label.module) {
    None -> [],
    Some(p) -> match slice_of(p.text, label.start, label.end) {
      None -> [],
      Some(_) -> snippet_lines(style, severity, p, label),
    },
  }

pub fn to_text(
  style: Style,
  diagnostic: Diagnostic,
  places: List<SourceText>,
) -> List<String> / {abort.raise} = {
  let title = colored(
    style,
    diagnostic.severity,
    severity_title(diagnostic.severity) ++ "[" ++ String::of_bytes_lossy(diagnostic.code) ++ "]",
  );
  let head = [title ++ ": " ++ String::of_bytes_lossy(diagnostic.message)];
  let labelled = diagnostic.labels.fold(head, |accumulator: List<String>, label: Label|
    accumulator.concat(label_lines(style, diagnostic.severity, places, label)));
  let with_notes = diagnostic.notes_text.fold(labelled, |accumulator: List<String>, n: Bytes|
    accumulator.push("  = " ++ String::of_bytes_lossy(n)));
  diagnostic.fixes.fold(with_notes, |accumulator: List<String>, f: Fix|
    accumulator.push("  = fix: " ++ String::of_bytes_lossy(f.title)))
}

pub fn all_to_text(
  style: Style,
  diagnostics: List<Diagnostic>,
  places: List<SourceText>,
) -> List<String> / {abort.raise} =
  diagnostics.fold([], |accumulator: List<String>, diagnostic: Diagnostic|
    accumulator.concat(to_text(style, diagnostic, places)))

pub fn errors_of(diagnostics: List<Diagnostic>) -> List<Diagnostic> =
  diagnostics.filter(|diagnostic: Diagnostic| diagnostic.severity == b"error")

pub fn errors_text(diagnostics: List<Diagnostic>) -> String =
  String::join(
    errors_of(diagnostics).map(|diagnostic: Diagnostic| {
      let label_suffix = match diagnostic.labels.find(|l: Label| l.primary && l.text.len() > 0) {
        Some(l) -> ": " ++ String::of_bytes_lossy(l.text),
        None -> "",
      };
      String::of_bytes_lossy(diagnostic.message) ++ label_suffix ++ " ["
        ++ String::of_bytes_lossy(diagnostic.code)
        ++ "]"
    }),
    "; ",
  )

const source: Bytes = b"fn f() -> Int = \"x\"\nfn g() -> Int = 1\n"

const one_place: List<SourceText> = [{ path: "m.ply", text: source }]

const two_places: List<SourceText> =
  [{ path: "m.ply", text: source }, { path: "u.ply", text: b"fn \xc3\xa9() -> Int = 1\n" }]

fn as_bytes(lines: List<String>) -> List<Bytes> = lines.map(|l: String| Bytes::of_string(l))

fn a_diagnostic_of(
  severity: Bytes,
  code: Bytes,
  message: Bytes,
  labels: List<Label>,
  notes: List<Bytes>,
  fixes: List<Fix>,
) -> Diagnostic =
  {
    code: code,
    notes: notes.len(),
    labels: labels,
    text: b"",
    message: message,
    notes_text: notes,
    severity: severity,
    fixes: fixes,
  }

const mismatch: Diagnostic =
  a_diagnostic_of(
    b"error",
    b"E0201",
    b"type mismatch: function body type",
    [{ module: 0, start: 16, end: 19, primary: true, text: b"expected `Int`, found `String`" }],
    [b"the body must return the written type"],
    [],
  )

test "`position_of` numbers lines and columns from 1, and counts a column in characters rather than bytes" {
  assert_eq(position_of(source, 0), { line: 1, column: 1, offset: 0 });
  assert_eq(position_of(source, 16), { line: 1, column: 17, offset: 16 });
  assert_eq(position_of(source, 19), { line: 1, column: 20, offset: 19 });
  assert_eq(position_of(source, 20), { line: 2, column: 1, offset: 20 });
  assert_eq(position_of(b"\xc3\xa9x", 2), { line: 1, column: 2, offset: 2 })
}

test "the JSON is one object per diagnostic, with each label's start and end positions and its source snippet" {
  assert_eq(
    to_json(mismatch, one_place),
    object([
      { key: "severity", value: Str("error") },
      { key: "code", value: Str("E0201") },
      { key: "message", value: Str("type mismatch: function body type") },
      {
        key: "labels",
        value: Array([
          object([
            { key: "file", value: Str("m.ply") },
            { key: "start", value: position_json({ line: 1, column: 17, offset: 16 }) },
            { key: "end", value: position_json({ line: 1, column: 20, offset: 19 }) },
            { key: "message", value: Str("expected `Int`, found `String`") },
            { key: "primary", value: Bool(true) },
            { key: "snippet", value: Str("\"x\"") },
          ]),
        ]),
      },
      { key: "notes", value: Array([Str("the body must return the written type")]) },
      { key: "fixes", value: Array([]) },
    ]),
  )
}

test "`to_json` omits a label whose module does not exist or whose range is past the end of the text" {
  let outside = a_diagnostic_of(
    b"error",
    b"E0201",
    b"type mismatch: function body type",
    [{ module: no_module, start: 0, end: 0, primary: true, text: b"nowhere" }],
    [],
    [],
  );
  match to_json(outside, one_place) {
    Object(m) -> assert_eq(m.get("labels"), Some(Array([]))),
    _ -> panic("a diagnostic renders as an object"),
  };
  let past = a_diagnostic_of(
    b"error",
    b"E0201",
    b"type mismatch: function body type",
    [{ module: 0, start: 900, end: 901, primary: true, text: b"past the end" }],
    [b"the body must return the written type"],
    [],
  );
  assert_eq(to_text(plain, past, one_place), [
    "Error[E0201]: type mismatch: function body type",
    "  = the body must return the written type",
  ])
}

test "a span that cuts a character in half is still shown, on the line where the span starts" {
  let split = a_diagnostic_of(
    b"error",
    b"E0201",
    b"type mismatch",
    [{ module: 1, start: 4, end: 6, primary: true, text: b"here" }],
    [],
    [],
  );
  assert_eq(as_bytes(to_text(plain, split, two_places)), [
    b"Error[E0201]: type mismatch",
    b"  --> u.ply:1:5",
    b"   | fn \xc3\xa9() -> Int = 1",
    b"   |     ^ here",
  ])
}

test "the text names the file, prints the line and underlines the span" {
  assert_eq(to_text(plain, mismatch, one_place), [
    "Error[E0201]: type mismatch: function body type",
    "  --> m.ply:1:17",
    "   | fn f() -> Int = \"x\"",
    "   |                 ^^^ expected `Int`, found `String`",
    "  = the body must return the written type",
  ])
}

test "ANSI colour only adds escape codes around the text and leaves the layout of the diagnostic unchanged" {
  assert_eq(as_bytes(to_text(ansi, mismatch, one_place)), [
    b"\x1b[31mError[E0201]\x1b[0m: type mismatch: function body type",
    b"  --> m.ply:1:17",
    b"   | fn f() -> Int = \"x\"",
    b"   | \x1b[31m                ^^^\x1b[0m expected `Int`, found `String`",
    b"  = the body must return the written type",
  ])
}

test "an empty span still gets one caret, and a suggested fix prints as its own `fix:` line" {
  let insertion = a_diagnostic_of(
    b"warning",
    b"E0126",
    b"this needs a type",
    [{ module: 0, start: 5, end: 5, primary: true, text: b"" }],
    [],
    [{ title: b"add the type", edits: [{ module: 0, start: 5, end: 5, text: b": Int" }] }],
  );
  assert_eq(to_text(plain, insertion, one_place), [
    "Warning[E0126]: this needs a type",
    "  --> m.ply:1:6",
    "   | fn f() -> Int = \"x\"",
    "   |      ^",
    "  = fix: add the type",
  ]);
  assert_eq(as_bytes(to_text(ansi, insertion, one_place)), [
    b"\x1b[33mWarning[E0126]\x1b[0m: this needs a type",
    b"  --> m.ply:1:6",
    b"   | fn f() -> Int = \"x\"",
    b"   | \x1b[33m     ^\x1b[0m",
    b"  = fix: add the type",
  ])
}

test "`errors_of` returns only the error diagnostics and leaves out warnings" {
  let warning = a_diagnostic_of(b"warning", b"W0611", b"never used", [], [], []);
  assert_eq(errors_of([mismatch, warning]).len(), 1)
}

test "`shown` substitutes a runtime error's values into its message text" {
  let slot = String::of_bytes(b"\x010\x02");
  let d = shown({
    diagnostic: a_diagnostic_of(b"error", b"E0501", Bytes::of_string("found " ++ slot), [], [], []),
    values: [VInt(7)],
  });
  assert_eq(d.message, b"found 7")
}

test "a runtime error's JSON lists each value in full under `values`, while its message shows long values shortened" {
  let slot = String::of_bytes(b"\x010\x02");
  let long = VList(range(0, shown_characters).map(|i: Int| VInt(i)));
  let raised = {
    diagnostic: a_diagnostic_of(b"error", b"E0501", Bytes::of_string("found " ++ slot), [], [], []),
    values: [long],
  };
  match runtime_diagnostic_json(raised, one_place) {
    Object(m) -> {
      assert_eq(m.get("values"), Some(Array([Str(render_all(long))])));
      assert_eq(Object(m.remove("values")), to_json(shown(raised), one_place))
    },
    _ -> panic("a diagnostic renders as an object"),
  };
  assert(render(long) != render_all(long))
}

test "every byte of a rendered `Bytes` value is lexed back as a bytes literal holding the same byte" {
  let all = Bytes::concat_all(range(0, 256).map(|i: Int| byte_of_int(i)));
  let dump = lexer::dump(Bytes::of_string(render_all(VBytes(all))));
  let first = match dump.split(";") {
    [first, ..] -> match first.split(":") { [_, _, kind, hex] -> kind ++ ":" ++ hex, _ -> first },
    [] -> dump,
  };
  assert_eq(first, "b:" ++ all.hex_of())
}
