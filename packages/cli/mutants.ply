import compiler.load (LoadedAnalysis, report_viewed)
import units (emit)
import compiler.front.emitter_input (Analysed, Rejected, checked_program_of)
import compiler.front.facts (CheckedProgram, is_shipped_module)
import compiler.front.rows (ModuleSpan)
import compiler.store.hash.forms (ItemKeyed, reach)
import compiler.check.infer.checker (DefinitionInfo, TestInfo)
import compiler.syntax.lexer (Token, IntLiteral, Keyword, Punctuation, lex)
import compiler.front.pkg (PackageSources, SuppliedPackage)
import compiler.check.resolve.tables (Diagnostic, Source)
import diagnostic (SourceText, diagnostic_of, editor_location_json, unlocated_label)
import program (Program, loaded_analysis, definitions_in_order, reanalysed)
import compiler.unit (shipped)
import std.json (Json, Null, Str, Bool, Number, Array, object, int)
import tester (TestRun, TestUnit, unit_over)
import std.machine as entering
import std.string
import compiler.syntax.parsing (no_module)

pub type Mutation = { definition: String, at: ModuleSpan, original: String, replacement: String }

pub type Queue = {
  definitions: Int,
  unreached: List<String>,
  mutants: List<{ tests: List<Int>, mutation: Mutation }>,
}

pub type MutantVerdict = { id: Int, verdict: String, reason: String }

pub type Survivor = {
  definition: String,
  original: String,
  replacement: String,
  at: Option<ModuleSpan>,
}

pub type MutationReport = {
  killed: Int,
  survived: Int,
  skipped: Int,
  budget_spent: Bool,
  unreached: List<String>,
  survivors: List<Survivor>,
  json: Json,
}

pub type Coverage = { definitions: Int, unreached: List<String>, json: Json }

fn project_definitions(analysis: CheckedProgram) -> List<DefinitionInfo> =
  definitions_in_order(analysis).filter(|definition_info: DefinitionInfo|
    !is_shipped_module(
      analysis.frame.packages,
      analysis.frame.module_packages,
      definition_info.at.module,
    ))

pub fn targets(
  analysis: CheckedProgram,
  query: String,
) -> Result<List<DefinitionInfo>, Diagnostic> = {
  let project = project_definitions(analysis);
  let exact = project.filter(|definition_info: DefinitionInfo|
    String::of_bytes_lossy(definition_info.name) == query);
  let simple = project.filter(|definition_info: DefinitionInfo|
    String::of_bytes_lossy(definition_info.simple_name) == query);
  if query == "*" { Ok(project) }
  else if exact.len() > 0 { Ok(exact) }
  else if simple.len() == 1 { Ok(simple) } else if simple.len() == 0 {
    Err(
      diagnostic_of(
        "error",
        "E0101",
        "no definition is named `" ++ query ++ "`",
        [unlocated_label("not a definition of this project")],
        [
          "`--mutate` takes a full definition name, a short name that only one definition in the project has, or nothing to mutate every definition",
        ],
      ),
    )
  } else {
    Err(
      diagnostic_of(
        "error",
        "E0101",
        "`" ++ query ++ "` names " ++ simple.len().to_string() ++ " definitions",
        [unlocated_label("say which")],
        [
          "one of: "
            ++ String::join(
              simple.map(|definition_info: DefinitionInfo|
                String::of_bytes_lossy(definition_info.name)),
              ", ",
            ),
        ],
      ),
    )
  }
}

fn test_closures(analysis: CheckedProgram) -> Map<Bytes, Map<Bytes, Bool>> / {abort.raise} =
  analysis.checked.tests.fold(
    Map::new(),
    |acc: Map<Bytes, Map<Bytes, Bool>>, test_info: TestInfo|
      acc.insert(test_info.key, reach(analysis.frame.hashes, [ItemKeyed(test_info.key)]).functions),
  )

fn tests_reaching(
  analysis: CheckedProgram,
  closed: Map<Bytes, Map<Bytes, Bool>>,
  name: Bytes,
) -> List<TestInfo> =
  analysis.checked.tests.filter(|test_info: TestInfo|
    match closed.get(test_info.key) { Some(names) -> names.contains(name), None -> false })

fn token_at(tokens: List<Token>, i: Int) -> Option<Token> = if i < 0 { None } else { tokens.at(i) }

fn is_punct(t: Option<Token>, p: Bytes) -> Bool =
  match t { Some(x) -> x.kind == Punctuation(p), None -> false }

fn is_doubled_operator(tokens: List<Token>, i: Int, p: Bytes) -> Bool =
  match token_at(tokens, i) {
    None -> false,
    Some(t) -> {
      let before = token_at(tokens, i - 1);
      let after = token_at(tokens, i + 1);
      (is_punct(before, p) && (match before { Some(b) -> b.end == t.start, None -> false }))
        || (is_punct(after, p) && (match after { Some(a) -> a.start == t.end, None -> false }))
    },
  }

fn swapped_operator(tokens: List<Token>, i: Int, p: Bytes) -> Option<String> =
  if p == b"plus" { Some("-") }
  else if p == b"minus" { Some("+") }
  else if p == b"le" { Some("<") }
  else if p == b"ge" { Some(">") }
  else if p == b"lt" { if is_doubled_operator(tokens, i, b"lt") { None } else { Some("<=") } }
  else if p == b"gt" { if is_doubled_operator(tokens, i, b"gt") { None } else { Some(">=") } }
  else if p == b"eqeq" { Some("!=") }
  else if p == b"bangeq" { Some("==") }
  else if p == b"bang" { Some("") }
  else if p == b"ampamp" { Some("||") }
  else if p == b"pipepipe" { Some("&&") }
  else { None }

fn is_digit_or_underscore(c: Int) -> Bool = (c >= 48 && c <= 57) || c == 95

fn is_word(c: Int) -> Bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95

fn plain_decimal(src: Bytes, t: Token) -> Bool / {abort.raise} = {
  let digits = range(t.start, t.end).fold(true, |ok: Bool, i: Int|
    ok && is_digit_or_underscore(src.at(i)));
  let after = if t.end < src.len() { src.at(t.end) } else { 0 };
  digits && !is_word(after) && after != 46
}

pub fn mutation_sites(src: Bytes) -> List<{ start: Int, end: Int, to: String }> / {abort.raise} = {
  let tokens = lex(src).tokens;
  range(0, tokens.len()).fold([], |acc: List<{ start: Int, end: Int, to: String }>, i: Int|
    match token_at(tokens, i) {
      None -> acc,
      Some(t) -> {
        let site = |to: String| acc.push({ start: t.start, end: t.end, to: to });
        match t.kind {
          Punctuation(p) -> match swapped_operator(tokens, i, p) {
            Some(to) -> site(to),
            None -> acc,
          },
          Keyword(k) -> if k == b"true" { site("false") }
          else if k == b"false" { site("true") }
          else { acc },
          IntLiteral(n) -> if !plain_decimal(src, t) { acc }
          else { match checked_add(n, 1) { Some(m) -> site(m.to_string()), None -> acc } },
          _ -> acc,
        }
      },
    })
}

pub fn mutations(
  places: List<SourceText>,
  definition_info: DefinitionInfo,
) -> List<Mutation> / {abort.raise} =
  match places.at(definition_info.at.module) {
    None -> [],
    Some(place) -> {
      let start = definition_info.at.span.start;
      let src = place.text.slice(start, definition_info.at.span.end);
      mutation_sites(src).map(|s: { start: Int, end: Int, to: String }|
        {
          definition: String::of_bytes_lossy(definition_info.name),
          at: { module: definition_info.at.module, start: start + s.start, end: start + s.end },
          original: String::of_bytes_lossy(src.slice(s.start, s.end)),
          replacement: s.to,
        })
    },
  }

pub fn mutation_queue(
  places: List<SourceText>,
  analysis: CheckedProgram,
  targets: List<DefinitionInfo>,
) -> Queue / {abort.raise} = {
  let closed = test_closures(analysis);
  let start: { unreached: List<String>, by_cost: Map<Int, List<{ tests: List<Int>, mutation: Mutation }>> } = {
    unreached: [],
    by_cost: Map::new(),
  };
  let sorted = targets.fold(
    start,
    |acc: { unreached: List<String>, by_cost: Map<Int, List<{ tests: List<Int>, mutation: Mutation }>> }, definition_info: DefinitionInfo| {
      let tests = tests_reaching(analysis, closed, definition_info.name).map(
        |test_info: TestInfo| test_info.index,
      );
      if tests.len() == 0 {
        { ..acc, unreached: acc.unreached.push(String::of_bytes_lossy(definition_info.name)) }
      } else {
        let held = match acc.by_cost.get(tests.len()) { Some(xs) -> xs, None -> [] };
        {
          ..acc,
          by_cost: acc.by_cost.insert(
            tests.len(),
            mutations(places, definition_info).fold(
              held,
              |into: List<{ tests: List<Int>, mutation: Mutation }>, m: Mutation|
                into.push({ tests: tests, mutation: m }),
            ),
          ),
        }
      }
    },
  );
  {
    definitions: targets.len(),
    unreached: sorted.unreached,
    mutants: sorted.by_cost.values().fold(
      [],
      |acc: List<{ tests: List<Int>, mutation: Mutation }>, xs: List<{ tests: List<Int>, mutation: Mutation }>|
        xs.fold(
          acc,
          |out: List<{ tests: List<Int>, mutation: Mutation }>, x: { tests: List<Int>, mutation: Mutation }|
            out.push(x),
        ),
    ),
  }
}

fn spliced_text(original: Bytes, m: Mutation) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    original.slice(0, m.at.start),
    Bytes::of_string(m.replacement),
    original.slice(m.at.end, original.len()),
  ])

fn spliced_places(places: List<SourceText>, m: Mutation) -> List<SourceText> / {abort.raise} =
  range(0, places.len()).map(|i: Int|
    match places.at(i) {
      None -> { path: "", text: b"" },
      Some(place) -> if i == m.at.module { { ..place, text: spliced_text(place.text, m) } }
      else { place },
    })

fn spliced_packages(
  packages: PackageSources,
  own: Int,
  places: List<SourceText>,
) -> PackageSources = {
  let done = packages.supplied.fold(
    { at: own, out: [] },
    |acc: { at: Int, out: List<SuppliedPackage> }, supplied: SuppliedPackage| {
      let modules = range(0, supplied.modules.len()).map(|j: Int|
        match ((supplied.modules.at(j), places.at(acc.at + j))) {
          (Some(src), Some(place)) -> { name: src.name, src: place.text },
          (Some(src), None) -> src,
          _ -> { name: b"", src: b"" },
        });
      { at: acc.at + supplied.modules.len(), out: acc.out.push({ ..supplied, modules: modules }) }
    },
  );
  { ..packages, supplied: done.out }
}

pub fn mutant_unit(
  testing: TestRun,
  program: Program,
  analysis: CheckedProgram,
  m: Mutation,
) -> Result<TestUnit, MutantVerdict> / {entering::machine.open, emit.unit, emit.compiled, abort.raise, shipped.report_view_used} = {
  let places = spliced_places(program.source_texts, m);
  let own = range(0, program.files.len()).map(|i: Int|
    match ((program.files.at(i), places.at(i))) {
      (Some(f), Some(place)) -> { name: Bytes::of_string(f.module), src: place.text },
      _ -> { name: b"", src: b"" },
    });
  let pulled = reanalysed(
    program,
    analysis.frame,
    own,
    spliced_packages(program.packages, program.files.len(), places),
    [Bytes::of_string(m.definition)],
  );
  report_viewed(pulled.shipped_views, false);
  match pulled.out {
    Rejected(_) -> Err({ id: 0, verdict: "skipped", reason: "fails type checking" }),
    Analysed(mutant) -> {
      let v = checked_program_of(mutant);
      let front: LoadedAnalysis = loaded_analysis(
        {
          program: {
            ..program,
            source_texts: places,
            diagnostics: mutant.warnings,
            frame: Some(v.frame),
          },
          read_ms: 0,
          front_end_ms: 0,
          store_ms: 0,
          cached: false,
        },
        v,
      );
      match unit_over(testing, front) {
        Ok(unit) -> Ok(unit),
        Err(_) -> Err({ id: 0, verdict: "unresolved", reason: "the C backend could not be built" }),
      }
    },
  }
}

fn located_span(at: ModuleSpan) -> Option<ModuleSpan> =
  if at.module == no_module() { None } else { Some(at) }

fn mutation_json(
  places: List<SourceText>,
  m: Mutation,
  tests: List<String>,
  reason: Option<String>,
) -> Json / {abort.raise} =
  object([
    { key: "definition", value: Str(m.definition) },
    { key: "from", value: Str(m.original) },
    { key: "to", value: Str(m.replacement) },
    { key: "location", value: editor_location_json(places, m.at) },
    { key: "tests", value: Array(tests.map(|t: String| Str(t))) },
    { key: "why", value: match reason { Some(w) -> Str(w), None -> Null } },
  ])

pub fn mutants(
  places: List<SourceText>,
  analysis: CheckedProgram,
  q: Queue,
  judged: List<MutantVerdict>,
  budget_spent: Bool,
) -> MutationReport / {abort.raise} = {
  let keys = analysis.checked.tests.fold(
    Map::new(),
    |acc: Map<Int, String>, test_info: TestInfo|
      acc.insert(test_info.index, String::of_bytes_lossy(test_info.key)),
  );
  let rows = judged.fold(
    [],
    |acc: List<{ judged: MutantVerdict, mutation: Mutation, tests: List<String> }>, j: MutantVerdict|
      match q.mutants.at(j.id) {
        None -> acc,
        Some(x) ->
          acc.push({
            judged: j,
            mutation: x.mutation,
            tests: x.tests.fold([], |ts: List<String>, i: Int|
              match keys.get(i) { Some(k) -> ts.push(k), None -> ts }),
          }),
      },
  );
  let said = |verdict: String|
    rows.filter(|r: { judged: MutantVerdict, mutation: Mutation, tests: List<String> }|
      r.judged.verdict == verdict);
  let killed = said("killed").len();
  let survived = said("survived").len();
  let skipped = said("skipped").len();
  let unresolved = said("unresolved").len();
  let entry = |r: { judged: MutantVerdict, mutation: Mutation, tests: List<String> }|
    mutation_json(
      places,
      r.mutation,
      r.tests,
      if r.judged.verdict == "skipped" || r.judged.verdict == "unresolved" { Some(r.judged.reason) }
      else { None },
    );
  {
    killed: killed,
    survived: survived,
    skipped: skipped + unresolved,
    budget_spent: budget_spent,
    unreached: q.unreached,
    survivors: said("survived").map(
      |r: { judged: MutantVerdict, mutation: Mutation, tests: List<String> }|
        {
          definition: r.mutation.definition,
          original: r.mutation.original,
          replacement: r.mutation.replacement,
          at: located_span(r.mutation.at),
        },
    ),
    json: object([
      { key: "definitions", value: int(q.definitions) },
      { key: "generated", value: int(q.mutants.len()) },
      { key: "run", value: int(rows.len()) },
      { key: "killed", value: int(killed) },
      { key: "survived", value: int(survived) },
      { key: "skipped", value: int(skipped) },
      { key: "unresolved", value: int(unresolved) },
      { key: "budget_spent", value: Bool(budget_spent) },
      { key: "unreached", value: Array(q.unreached.map(|n: String| Str(n))) },
      { key: "survivors", value: Array(said("survived").map(entry)) },
      {
        key: "skips",
        value: Array(
          rows.filter(
            |r: { judged: MutantVerdict, mutation: Mutation, tests: List<String> }|
              r.judged.verdict == "skipped" || r.judged.verdict == "unresolved",
          ).map(
            entry,
          ),
        ),
      },
    ]),
  }
}

pub fn coverage(analysis: CheckedProgram) -> Coverage / {abort.raise} = {
  let closed = test_closures(analysis);
  let definitions = project_definitions(analysis).map(|definition_info: DefinitionInfo|
    {
      name: String::of_bytes_lossy(definition_info.name),
      reached_by: tests_reaching(analysis, closed, definition_info.name).map(|t: TestInfo|
        String::of_bytes_lossy(t.key)),
    });
  let unreached = definitions.filter(
    |definition_info: { name: String, reached_by: List<String> }|
      definition_info.reached_by.len() == 0,
  ).map(|definition_info: { name: String, reached_by: List<String> }| definition_info.name);
  {
    definitions: definitions.len(),
    unreached: unreached,
    json: object([
      {
        key: "definitions",
        value: Array(
          definitions.map(|definition_info: { name: String, reached_by: List<String> }|
            object([
              { key: "name", value: Str(definition_info.name) },
              {
                key: "reached_by",
                value: Array(definition_info.reached_by.map(|t: String| Str(t))),
              },
            ])),
        ),
      },
      { key: "unreached", value: Array(unreached.map(|n: String| Str(n))) },
    ]),
  }
}

fn changes(src: String) -> List<String> / {abort.raise} =
  mutation_sites(Bytes::of_string(src)).map(|s: { start: Int, end: Int, to: String }|
    String::of_bytes_lossy(Bytes::of_string(src).slice(s.start, s.end)) ++ "->" ++ s.to)

test "each operator and literal is one site, and an arrow, a concatenation and a string are none" {
  assert_eq(changes("fn f(a: Int) -> Int = a + 1 - 2"), ["+->-", "1->2", "-->+", "2->3"]);
  assert_eq(changes("fn f(s: String) -> String = s ++ \"a + b\""), []);
  assert_eq(changes("fn f(a: Int, b: Int) -> Bool = a <= b && !(a == b) || true"), [
    "<=-><",
    "&&->||",
    "!->",
    "==->!=",
    "||->&&",
    "true->false",
  ])
}

test "a shift, a hex or suffixed literal and a range bound are not sites" {
  assert_eq(changes("fn f(a: Int) -> Int = a >>> 32"), ["32->33"]);
  assert_eq(changes("fn f() -> Int = 0xFF + 3u8"), ["+->-"]);
  assert_eq(changes("fn f() -> List<Int> = range(1..5)"), ["<-><=", ">->>=", "5->6"]);
  assert_eq(changes("fn f(m: Map<Int, List<Int>>) -> Int = 1 // 2 + 3"), ["<-><=", "<-><=", "1->2"])
}
