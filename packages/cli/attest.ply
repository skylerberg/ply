pub type Options = { name: String, version: String }

fn member(json: Json, key: String) -> Json =
  match json { Object(m) -> match m.get(key) { Some(v) -> v, None -> Null }, _ -> Null }

fn count(json: Json, keys: List<String>) -> Int / {abort.raise} = {
  let at = keys.fold(json, |accumulator: Json, k: String| member(accumulator, k));
  match int_json().decode(at) { Ok(n) -> n, Err(_) -> 0 }
}

fn codes(result: Json) -> List<String> =
  match member(result, "diagnostics") {
    Array(ds) -> ds.map(|d: Json| match member(d, "code") { Str(c) -> c, _ -> "" }),
    _ -> [],
  }

fn command_line(argv: List<String>) -> Parsed / {abort.raise} =
  match cli::parse(spec("attest"), argv) {
    cli::Run(p) -> p,
    _ -> panic("`attest` could not parse its own command line"),
  }

fn flags_for(parsed: Parsed, resolved: ResolvedPath) -> Flags =
  args::from_parsed(parsed, false, resolved.display, [resolved])

fn attestation_of(
  name: String,
  v: Version,
  archive: String,
  builder: String,
  tested: CommandOutput,
  proved: CommandOutput,
) -> Attestation / {abort.raise} = {
  let rejections = codes(tested.json);
  let promises = !rejections.contains("E0127") && !rejections.contains("E0148");
  let ran = member(tested.json, "summary") != Null;
  {
    name: name,
    version: v,
    archive: archive,
    semantics: semantics::version(),
    builder: builder,
    checked: ran || !promises,
    contracts_hold: promises,
    tests: {
      passed: count(tested.json, ["summary", "passed"]),
      failed: count(tested.json, ["summary", "failed"])
        + count(tested.json, ["summary", "timed_out"]),
    },
    proofs: {
      proved: count(proved.json, ["summary", "proved"]),
      refuted: count(proved.json, ["summary", "refuted"])
        + count(proved.json, ["summary", "internal_error"]),
      unproved: count(proved.json, ["summary", "unproved"])
        + count(proved.json, ["summary", "vacuous"]),
    },
  }
}

fn signing_key(
  path: Option<String>,
) -> Result<Option<Secret<Bytes>>, Diagnostic> / {fs.read_secret[cwd], fs.read_secret[abs], abort.raise} =
  match path {
    None -> Ok(None),
    Some(p) -> match read_seed(p) { Ok(seed) -> Ok(Some(seed)), Err(reason) -> Err(reason) },
  }

pub fn run(
  flags: Flags,
  opts: Options,
) -> CommandOutput / {semantics.cached, shipped.read_pack, process.out[proc], process.err[proc], env.variable, MachineAccess, shipped.version, env.working_directory, env.variables, fs.read[abs], fs.kind[abs], fs.list_dir[abs], fs.read_file[abs], fs.resolved_kind[abs], fs.write[abs], fs.create_dir[abs], fs.remove[abs], fs.rename[abs], fs.write_file[abs], fs.read[cwd], fs.kind[cwd], fs.list_dir[cwd], fs.read_file[cwd], fs.resolved_kind[cwd], fs.write[cwd], fs.list_dir[shipped], fs.read_file[shipped], net.close[registry], net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.recv[registry], net.send[registry], builder.git[vcs], entropy.next, time.elapsed_ms, time.elapsed_us, time.now_ms, emit.unit, emit.compiled, cost_checker.report, evaluation.verdicts, evaluation.statements, Derives, abort.raise, diverges, shipped.report_view_used, toolchain.reuse_dir} = {
  let s = style_of(flags);
  match malformed({ name: opts.name, version: opts.version }) {
    Some(d) -> reported(s, "attest", [d], []),
    None -> match signing_key(flags.sign) {
      Err(d) -> reported(s, "attest", [d], []),
      Ok(seed) -> match env.variable(url_variable()) {
        None ->
          reported(
            s,
            "attest",
            [
              unset(
                url_variable(),
                "`attest` sends the attestation to the registry at this address",
              ),
            ],
            [],
          ),
        Some(text) -> match base_of(text) {
          Err(reason) -> reported(s, "attest", [registry_unreachable(reason, [])], []),
          Ok(base) -> attest_release(s, flags, opts, base, seed),
        },
      },
    },
  }
}

fn attest_release(
  s: Style,
  flags: Flags,
  opts: Options,
  base: BaseUrl,
  seed: Option<Secret<Bytes>>,
) -> CommandOutput / {semantics.cached, shipped.read_pack, process.out[proc], process.err[proc], env.variable, MachineAccess, shipped.version, env.working_directory, env.variables, fs.read[abs], fs.kind[abs], fs.list_dir[abs], fs.read_file[abs], fs.resolved_kind[abs], fs.write[abs], fs.create_dir[abs], fs.remove[abs], fs.rename[abs], fs.write_file[abs], fs.read[cwd], fs.kind[cwd], fs.list_dir[cwd], fs.read_file[cwd], fs.resolved_kind[cwd], fs.write[cwd], fs.list_dir[shipped], fs.read_file[shipped], net.close[registry], net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.recv[registry], net.send[registry], builder.git[vcs], entropy.next, time.elapsed_ms, time.elapsed_us, time.now_ms, emit.unit, emit.compiled, cost_checker.report, evaluation.verdicts, evaluation.statements, Derives, abort.raise, diverges, shipped.report_view_used, toolchain.reuse_dir} = {
  let v = match parse_version(opts.version) {
    Some(x) -> x,
    None -> { major: 0, minor: 0, patch: 0 },
  };
  match index_of(base, opts.name) {
    Err(d) -> reported(s, "attest", [d], []),
    Ok(index) -> match release_at(index, v) {
      None -> reported(s, "attest", [unpublished(opts.name, v)], []),
      Some(r) -> {
        let work = root_of(flags).absolute ++ "/.ply-cache/attest/" ++ opts.name ++ "@"
          ++ opts.version;
        match download_release(base, work, opts.name, r) {
          Err(d) -> reported(s, "attest", [d], []),
          Ok(dir) -> {
            let at = paths::resolve(dir);
            let tested_line = command_line(["test", dir, "--json"]);
            let tested = run::run(
              flags_for(tested_line, at),
              tester::options_from(tested_line),
              None,
            );
            let proved_line = command_line(["prove", dir, "--json"]);
            let proved = prove::run(flags_for(proved_line, at), claims::options_from(proved_line));
            let a = attestation_of(
              opts.name,
              v,
              r.digest,
              "ply " ++ shipped.version(),
              tested,
              proved,
            );
            match seed {
              None -> attestation_output(s, a, false),
              Some(key) -> send_to_registry(s, base, a, key),
            }
          },
        }
      },
    },
  }
}

fn send_to_registry(
  style: Style,
  base: BaseUrl,
  a: Attestation,
  key: Secret<Bytes>,
) -> CommandOutput / {net.connect[registry], net.close[registry], net.connect_tls[registry], net.handshake[registry], net.recv[registry], net.send[registry], abort.raise} = {
  let version = render_version(a.version);
  let body = encode_signed(
    countersigned({ payload: bin::encode(a, attestation_bin()), signatures: [] }, key),
  );
  let target = attestation_target(base, a.name, version, a.semantics);
  match exchange(base, put(base, target, "", a.archive, body)) {
    Err(d) -> reported(style, "attest", [d], []),
    Ok(result) -> if result.status == 201 || result.status == 200 {
      attestation_output(style, a, true)
    } else {
      reported(
        style,
        "attest",
        [
          rejected_by(
            "store the attestation of `" ++ a.name ++ "` at version " ++ version,
            result.status,
            response_message(result),
          ),
        ],
        [],
      )
    },
  }
}

fn attestation_output(style: Style, a: Attestation, send_to_registry: Bool) -> CommandOutput = {
  let is_attested = attested(a);
  {
    json: object([
      { key: "command", value: Str("attest") },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code())) },
      { key: "name", value: Str(a.name) },
      { key: "version", value: Str(render_version(a.version)) },
      { key: "archive", value: Str(a.archive) },
      { key: "semantics", value: Str(a.semantics) },
      { key: "builder", value: Str(a.builder) },
      { key: "attested", value: Bool(is_attested) },
      { key: "checked", value: Bool(a.checked) },
      { key: "promises", value: Bool(a.contracts_hold) },
      {
        key: "tests",
        value: object([
          { key: "passed", value: Number(Decimal::of_int(a.tests.passed)) },
          { key: "failed", value: Number(Decimal::of_int(a.tests.failed)) },
        ]),
      },
      {
        key: "proofs",
        value: object([
          { key: "proved", value: Number(Decimal::of_int(a.proofs.proved)) },
          { key: "refuted", value: Number(Decimal::of_int(a.proofs.refuted)) },
          { key: "unproved", value: Number(Decimal::of_int(a.proofs.unproved)) },
        ]),
      },
      { key: "sent", value: Bool(send_to_registry) },
    ]),
    lines: [
      indent()
        ++ (if is_attested { green(style, "attested") } else { yellow(style, "not attested") })
        ++ " "
        ++ a.name
        ++ " "
        ++ render_version(a.version)
        ++ " · "
        ++ (if send_to_registry { "sent to the registry" } else { "not sent to the registry" }),
      indent() ++ "  " ++ bold(style, "tests") ++ " " ++ a.tests.passed.to_string() ++ " passed, "
        ++ a.tests.failed.to_string()
        ++ " failed · "
        ++ bold(style, "claims")
        ++ " "
        ++ a.proofs.proved.to_string()
        ++ " proved, "
        ++ a.proofs.refuted.to_string()
        ++ " refuted, "
        ++ a.proofs.unproved.to_string()
        ++ " unproved · "
        ++ (if a.contracts_hold { "promises kept" } else { "a promise broken" }),
    ],
    errs: [],
    code: ok_code(),
  }
}

fn result_of(json: Json) -> CommandOutput = { json: json, lines: [], errs: [], code: 0 }

fn summary(pairs: List<{ key: String, n: Int }>) -> Json =
  object([
    {
      key: "summary",
      value: object(
        pairs.map(|p: { key: String, n: Int }| { key: p.key, value: Number(Decimal::of_int(p.n)) }),
      ),
    },
  ])

test "`attested` is true only when no test fails and no proof is refuted or unproved, using the counts from the `test` and `prove` results" {
  let tested = result_of(summary([{ key: "passed", n: 3 }, { key: "failed", n: 1 }]));
  let proved = result_of(
    summary([
      { key: "proved", n: 2 },
      { key: "refuted", n: 0 },
      { key: "internal_error", n: 1 },
      { key: "unproved", n: 1 },
      { key: "vacuous", n: 1 },
    ]),
  );
  let a = attestation_of(
    "orders",
    { major: 0, minor: 1, patch: 0 },
    "b3:00",
    "ply 0.0.0",
    tested,
    proved,
  );
  assert_eq(a.tests, { passed: 3, failed: 1 });
  assert_eq(a.proofs, { proved: 2, refuted: 1, unproved: 2 });
  assert(a.checked && a.contracts_hold);
  assert(!attested(a));
  assert(
    attested({
      ..a,
      tests: { passed: 4, failed: 0 },
      proofs: { proved: 5, refuted: 0, unproved: 0 },
    }),
  );
  assert(
    !attested({
      ..a,
      tests: { passed: 4, failed: 0 },
      proofs: { proved: 4, refuted: 0, unproved: 1 },
    }),
  )
}

test "a test result with a contract-violation error means the tests ran but a contract failed, and any other error means the tests did not run" {
  let rejected = result_of(
    object([
      { key: "diagnostics", value: Array([object([{ key: "code", value: Str("E0127") }])]) },
    ]),
  );
  let a = attestation_of(
    "orders",
    { major: 0, minor: 1, patch: 0 },
    "b3:00",
    "ply 0.0.0",
    rejected,
    result_of(Null),
  );
  assert(a.checked);
  assert(!a.contracts_hold);
  let broken = result_of(
    object([
      { key: "diagnostics", value: Array([object([{ key: "code", value: Str("E0201") }])]) },
    ]),
  );
  assert(
    !attestation_of(
      "orders",
      { major: 0, minor: 1, patch: 0 },
      "b3:00",
      "ply 0.0.0",
      broken,
      result_of(Null),
    ).checked,
  )
}
