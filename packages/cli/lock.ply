import diagnostic (SourceText)
import std.env (env)
import paths
import paths (ResolvedPath, RootedPath, checkout_of, checkouts, in_checkout, in_root, read_file)
import report (CommandOutput, ok_code, schema_version)
import compiler.front.pkg
import compiler.check.resolve.tables (Diagnostic, error_at)
import std.fs (fs, mem_kind, mem_of, mem_read, mem_resolved_kind)
import std.json (Json, Member, Number, Str, JsonCodec, error_to_string, field, int_json, list_json,
                 object, optional_field, parse, string_json, to_string)
import std.path (join)
import std.list
import compiler.syntax.parsing (no_module, dummy_span)

pub type Pin = { name: String, version: String, digest: String }

pub fn from_front(ps: List<pkg::LockedPackage>) -> List<Pin> =
  ps.map(|pin: pkg::LockedPackage|
    {
      name: String::of_bytes_lossy(pin.name),
      version: String::of_bytes_lossy(pin.version),
      digest: String::of_bytes_lossy(pin.digest),
    })

pub type Entry = { name: String, version: String, digest: Option<String>, archive: Option<String> }

pub type FetchedArchive = {
  name: String,
  version: String,
  archive: String,
  has_interface_file: Bool,
  attestation: Option<Bytes>,
}

pub type Lock = { version: Int, packages: List<Entry> }

fn entry_json() -> JsonCodec<Entry> =
  {
    encode: |e: Entry| {
      let optional = |key: String, value: Option<String>|
        match value { None -> [], Some(v) -> [{ key: key, value: Str(v) }] };
      object(
        [optional("digest", e.digest), optional("archive", e.archive)].fold(
          [{ key: "name", value: Str(e.name) }, { key: "version", value: Str(e.version) }],
          |accumulator: List<Member>, ms: List<Member>|
            ms.fold(accumulator, |a: List<Member>, m: Member| a.push(m)),
        ),
      )
    },
    decode: |json: Json|
      match field(json, "name", string_json()) {
        Err(e) -> Err(e),
        Ok(name) -> match field(json, "version", string_json()) {
          Err(e) -> Err(e),
          Ok(version) -> match optional_field(json, "digest", string_json()) {
            Err(e) -> Err(e),
            Ok(digest) -> match optional_field(json, "archive", string_json()) {
              Err(e) -> Err(e),
              Ok(archive) -> Ok({ name: name, version: version, digest: digest, archive: archive }),
            },
          },
        },
      },
  }

fn lock_json() -> JsonCodec<Lock> =
  {
    encode: |l: Lock|
      object([
        { key: "version", value: Number(Decimal::of_int(l.version)) },
        { key: "packages", value: list_json(entry_json()).encode(l.packages) },
      ]),
    decode: |json: Json|
      match field(json, "version", int_json()) {
        Err(e) -> Err(e),
        Ok(version) -> match field(json, "packages", list_json(entry_json())) {
          Err(e) -> Err(e),
          Ok(packages) -> Ok({ version: version, packages: packages }),
        },
      },
  }

pub const format_version: Int = 2

pub fn path_of(resolved: ResolvedPath) -> RootedPath = in_root(resolved, "ply.lock")

fn parse_lock(text: String) -> Result<Lock, String> / {abort.raise} =
  match parse(Bytes::of_string(text)) {
    Err(e) -> Err(error_to_string(e)),
    Ok(j) -> match lock_json().decode(j) {
      Err(e) -> Err(error_to_string(e)),
      Ok(lock) -> Ok(lock),
    },
  }

pub fn read(
  resolved: ResolvedPath,
) -> Result<Option<Lock>, String> / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match read_file(path_of(resolved)) {
    None -> Ok(None),
    Some(bytes) -> match parse_lock(String::of_bytes_lossy(bytes)) {
      Err(reason) -> Err(reason),
      Ok(lock) -> if lock.version != format_version {
        Err(
          "`ply.lock` is format " ++ lock.version.to_string() ++ ", and this `ply` writes format "
            ++ format_version.to_string(),
        )
      } else { Ok(Some(lock)) },
    },
  }

pub fn entry_of(lock: Lock, name: String) -> Option<Entry> =
  lock.packages.fold(None, |found: Option<Entry>, entry: Entry|
    match found { Some(_) -> found, None -> if entry.name == name { Some(entry) } else { None } })

pub fn committed_packages(
  packages: pkg::PackageSources,
) -> List<String> / {fs.kind[abs], abort.raise} =
  match checkout_of(String::of_bytes_lossy(packages.root)) {
    None -> [],
    Some(tree) ->
      packages.supplied.fold([], |names: List<String>, s: pkg::SuppliedPackage|
        match s.manifest {
          None -> names,
          Some(text) -> match pkg::check_manifest(text).manifest {
            None -> names,
            Some(m) -> if fetched(packages.root, s.root)
                || !in_checkout(tree, String::of_bytes_lossy(s.root)) { names }
            else { names.push(m.name) },
          },
        }),
  }

fn fetched(root: Bytes, key: Bytes) -> Bool / {abort.raise} =
  key.starts_with(b"git+") || key.starts_with(pkg::registry_dir(root).concat(b"/"))

pub fn unreadable_lock(resolved: ResolvedPath, reason: String) -> Diagnostic =
  error_at(
    b"E0139",
    no_module,
    dummy_span,
    Bytes::of_string("`ply.lock` could not be read: " ++ reason),
    b"the lockfile is not one this `ply` wrote",
    [b"delete it to pin what is on disk now, or restore it from version control"],
  )

pub fn mismatch(resolved: ResolvedPath, version: String, digest: String, found: Pin) -> Diagnostic =
  error_at(
    b"E0138",
    no_module,
    dummy_span,
    Bytes::of_string(
      "`" ++ found.name ++ "` is not what `ply.lock` pins: " ++ digest
        ++ " was pinned, and the sources here are "
        ++ found.digest,
    ),
    b"a pinned dependency changed",
    [
      Bytes::of_string(
        "`ply.lock` pins " ++ found.name ++ " " ++ version ++ "; this tree holds " ++ found.version,
      ),
      b"delete its entry from `ply.lock` to pin what is on disk now, once you have checked what changed",
    ],
  )

pub fn verify(
  resolved: ResolvedPath,
  lock: Lock,
  pins: List<Pin>,
  committed_packages: List<String>,
) -> Result<(), Diagnostic> =
  pins.fold(Ok(()), |accumulator: Result<(), Diagnostic>, found: Pin|
    match accumulator {
      Err(d) -> Err(d),
      Ok(_) -> if committed_packages.contains(found.name) { Ok(()) } else {
        match entry_of(lock, found.name) {
          None -> Ok(()),
          Some(pinned) -> match pinned.digest {
            None -> Ok(()),
            Some(digest) -> if digest == found.digest { Ok(()) }
            else { Err(mismatch(resolved, pinned.version, digest, found)) },
          },
        }
      },
    })

pub fn updated_lock(
  lock: Option<Lock>,
  pins: List<Pin>,
  archives: List<FetchedArchive>,
  committed_packages: List<String>,
) -> Lock / {abort.raise} =
  {
    version: format_version,
    packages: sorted(pins.map(|pin: Pin| entry_for(lock, archives, committed_packages, pin))),
  }

pub fn text(
  lock: Option<Lock>,
  pins: List<Pin>,
  archives: List<FetchedArchive>,
  committed_packages: List<String>,
) -> String / {abort.raise} =
  to_string(lock_json().encode(updated_lock(lock, pins, archives, committed_packages))) ++ "\n"

fn entry_for(
  lock: Option<Lock>,
  archives: List<FetchedArchive>,
  committed_packages: List<String>,
  pin: Pin,
) -> Entry =
  if committed_packages.contains(pin.name) {
    { name: pin.name, version: pin.version, digest: None, archive: None }
  } else {
    let fetched = archives.fold(None, |found: Option<String>, a: FetchedArchive|
      match found {
        Some(_) -> found,
        None -> if a.name == pin.name && a.version == pin.version { Some(a.archive) } else { None },
      });
    let recorded = match lock { None -> None, Some(l) -> entry_of(l, pin.name) };
    match fetched {
      Some(archive) ->
        { name: pin.name, version: pin.version, digest: Some(pin.digest), archive: Some(archive) },
      None -> match recorded {
        Some(e) -> if e.digest == Some(pin.digest) && e.version == pin.version { e }
        else { new_entry(pin) },
        None -> new_entry(pin),
      },
    }
  }

fn new_entry(pin: Pin) -> Entry =
  { name: pin.name, version: pin.version, digest: Some(pin.digest), archive: None }

fn sorted(entries: List<Entry>) -> List<Entry> / {abort.raise} =
  entries.fold([], |accumulator: List<Entry>, entry: Entry| {
    let n = accumulator.len();
    let i = range(0, n).fold(n, |at_i: Int, j: Int|
      if at_i < n { at_i }
      else if compare(entry.name, accumulator.get(j).name) == Less { j }
      else { at_i });
    insert_at(accumulator, i, entry)
  })

fn insert_at(entries: List<Entry>, i: Int, p: Entry) -> List<Entry> / {abort.raise} = {
  let before = range(0, i).fold([], |accumulator: List<Entry>, j: Int|
    accumulator.push(entries.get(j)));
  let after = range(i, entries.len()).fold([], |accumulator: List<Entry>, j: Int|
    accumulator.push(entries.get(j)));
  after.fold(before.push(p), |accumulator: List<Entry>, x: Entry| accumulator.push(x))
}

pub fn a_pin(name: String, version: String, digest: String) -> Pin =
  { name: name, version: version, digest: digest }

fn an_entry(name: String, version: String, digest: String, archive: Option<String>) -> Entry =
  { name: name, version: version, digest: Some(digest), archive: archive }

test "a lock is written sorted by name, so a walk order cannot change it" {
  let pins = [a_pin("zebra", "1.0.0", "b3:z"), a_pin("alpha", "0.2.0", "b3:a")];
  let text = text(None, pins, [], []);
  assert(text.contains("\"name\":\"alpha\""));
  assert(text.find("\"alpha\"") < text.find("\"zebra\""))
}

test "a lock round-trips through the format it writes" {
  let pins = [a_pin("lib", "0.1.0", "b3:1f2e"), a_pin("store", "0.1.0", "b3:5a")];
  match parse_lock(text(None, pins, [], ["store"])) {
    Err(reason) -> panic(reason),
    Ok(lock) -> {
      assert_eq(lock.version, 2);
      assert_eq(lock.packages, [
        an_entry("lib", "0.1.0", "b3:1f2e", None),
        { name: "store", version: "0.1.0", digest: None, archive: None },
      ])
    },
  }
}

test "a lock records a path package inside the checkout by name and version only, and other packages by digest, with an archive for registry packages" {
  let text = text(
    None,
    [
      a_pin("lib", "0.1.0", "b3:1f"),
      a_pin("orders", "0.2.0", "b3:9a"),
      a_pin("sim", "0.1.0", "b3:5"),
    ],
    [
      {
        name: "orders",
        version: "0.2.0",
        archive: "b3:77",
        has_interface_file: false,
        attestation: None,
      },
    ],
    ["sim"],
  );
  assert_eq(
    text,
    "{\"packages\":[{\"digest\":\"b3:1f\",\"name\":\"lib\",\"version\":\"0.1.0\"},{\"archive\":\"b3:77\",\"digest\":\"b3:9a\",\"name\":\"orders\",\"version\":\"0.2.0\"},{\"name\":\"sim\",\"version\":\"0.1.0\"}],\"version\":2}\n",
  )
}

test "editing a path package inside the checkout leaves the lock text identical, while a changed dependency outside the checkout is rejected" {
  let before = text(
    None,
    [a_pin("prove", "0.1.0", "b3:old"), a_pin("lib", "0.1.0", "b3:l")],
    [],
    ["prove"],
  );
  match parse_lock(before) {
    Err(reason) -> panic(reason),
    Ok(lock) -> {
      let edited = [a_pin("prove", "0.1.0", "b3:new"), a_pin("lib", "0.1.0", "b3:l")];
      assert_eq(text(Some(lock), edited, [], ["prove"]), before);
      match verify(paths::here(), lock, edited, ["prove"]) {
        Ok(_) -> (),
        Err(_) -> panic("an edit to a package the checkout holds was rejected"),
      };
      let pinned = text(None, [a_pin("prove", "0.1.0", "b3:old")], [], []);
      match parse_lock(pinned) {
        Err(reason) -> panic(reason),
        Ok(outside) -> match verify(paths::here(), outside, edited, []) {
          Ok(_) -> panic("a changed dependency outside the checkout was trusted"),
          Err(d) -> assert_eq(d.code, b"E0138"),
        },
      }
    },
  }
}

test "`verify` rejects a locked package whose sources changed, and accepts a package the lock does not list" {
  let lock: Lock = { version: 2, packages: [an_entry("lib", "0.1.0", "b3:old", None)] };
  let r = paths::here();
  match verify(r, lock, [a_pin("lib", "0.1.0", "b3:new")], []) {
    Ok(_) -> panic("a changed dependency was trusted"),
    Err(d) -> assert_eq(d.code, b"E0138"),
  };
  match verify(r, lock, [a_pin("lib", "0.1.0", "b3:old")], []) {
    Ok(_) -> (),
    Err(_) -> panic("the same dependency was rejected"),
  };
  match verify(r, lock, [a_pin("other", "0.1.0", "b3:x")], []) {
    Ok(_) -> (),
    Err(_) -> panic("an unpinned package was rejected"),
  }
}

test "a lock in a different format, including the previous format 1, fails to load with an error naming both formats" {
  let disk = mem_of([
    { path: "w/app/ply.lock", body: b"{\"packages\":[],\"version\":1}\n" },
    { path: "w/app/main.ply", body: b"fn main() -> Int = 1" },
  ]);
  let r = handle {
    paths::resolve("app")
  } with {
    env.working_directory() -> "/w",
    fs.resolved_kind[cwd](p) -> mem_resolved_kind(disk, join("w", p)),
    fs.resolved_kind[abs](p) -> panic("nothing here leaves the working directory"),
  };
  let found = handle {
    read(r)
  } with {
    fs.read_file[cwd](p) -> mem_read(disk, join("w", p)),
    fs.read_file[abs](p) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(found, Err("`ply.lock` is format 1, and this `ply` writes format 2"))
}

test "a file argument's lock is the `ply.lock` in its directory, and that is the one read" {
  let pinned = text(None, [a_pin("lib", "0.1.0", "b3:1f")], [], []);
  let disk = mem_of([
    { path: "w/app/main.ply", body: b"fn main() -> Int = 1" },
    { path: "w/app/ply.lock", body: Bytes::of_string(pinned) },
  ]);
  let r = handle {
    paths::resolve("app/main.ply")
  } with {
    env.working_directory() -> "/w",
    fs.resolved_kind[cwd](p) -> mem_resolved_kind(disk, join("w", p)),
    fs.resolved_kind[abs](p) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(path_of(r), { label: "cwd", path: "app/ply.lock" });
  let found = handle {
    read(r)
  } with {
    fs.read_file[cwd](p) -> mem_read(disk, join("w", p)),
    fs.read_file[abs](p) -> panic("nothing here leaves the working directory"),
  };
  match found {
    Ok(Some(lock)) -> assert_eq(lock.packages, [an_entry("lib", "0.1.0", "b3:1f", None)]),
    _ -> panic("the lock beside the file was not the one read"),
  }
}

test "writing a lock keeps entries for packages still in the dependency set, adds new packages and drops removed ones" {
  let before: Lock = {
    version: 2,
    packages: [
      an_entry("gone", "0.1.0", "b3:g", None),
      an_entry("lib", "0.1.0", "b3:old", None),
      an_entry("orders", "0.2.0", "b3:o", Some("b3:77")),
    ],
  };
  let text = text(
    Some(before),
    [
      a_pin("lib", "0.1.0", "b3:old"),
      a_pin("new", "0.2.0", "b3:n"),
      a_pin("orders", "0.2.0", "b3:o"),
    ],
    [],
    [],
  );
  match parse_lock(text) {
    Err(reason) -> panic(reason),
    Ok(lock) ->
      assert_eq(lock.packages, [
        an_entry("lib", "0.1.0", "b3:old", None),
        an_entry("new", "0.2.0", "b3:n", None),
        an_entry("orders", "0.2.0", "b3:o", Some("b3:77")),
      ]),
  }
}

test "a lock keeps a package's archive digest only while its sources are unchanged, and records the new archive after a version change" {
  let before: Lock = { version: 2, packages: [an_entry("orders", "0.2.0", "b3:o", Some("b3:77"))] };
  let moved = text(Some(before), [a_pin("orders", "0.2.0", "b3:other")], [], []);
  assert(!moved.contains("b3:77"));
  let raised = text(
    Some(before),
    [a_pin("orders", "0.3.0", "b3:o3")],
    [
      {
        name: "orders",
        version: "0.3.0",
        archive: "b3:88",
        has_interface_file: false,
        attestation: None,
      },
    ],
    [],
  );
  assert(raised.contains("\"archive\":\"b3:88\""));
  assert(!raised.contains("b3:77"))
}

fn a_manifest(name: String) -> Bytes =
  Bytes::of_string(
    "import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"" ++ name
      ++ "\", version: {major: 0, minor: 1, patch: 0}, prefix: None, runtime: {major: 0, minor: 16, patch: 0}, dependencies: [], entry: None}",
  )

fn committed_at(root: String, keys: List<String>) -> List<String> / {abort.raise} =
  handle {
    committed_packages({
      root: Bytes::of_string(root),
      manifest: None,
      supplied: keys.map(|key: String| {
        let segments = key.split("/");
        {
          root: Bytes::of_string(key),
          manifest: Some(a_manifest(segments.get(segments.len() - 1))),
          modules: [],
        }
      }),
    })
  } with {
    fs.kind[abs](p) -> mem_kind(checkouts(), p),
  }

test "`committed_at` lists the path dependencies inside a checkout, and skips registry downloads, symbolic links and dependencies in nested checkouts" {
  assert_eq(
    committed_at("/repo/app", [
      "/repo/libs/a",
      "/repo",
      "/repo-b/d",
      "/other/e",
      "/repo/nested/b",
      "/repo/sub/c",
      "/repo/link",
      "/repo/app/.ply-cache/registry/r",
    ]),
    ["a", "repo"],
  );
  assert_eq(committed_at("/other/e", ["/repo/libs/a"]), []);
  assert_eq(committed_at("/wt", ["/wt/lib", "/repo/libs/a"]), ["lib"])
}
