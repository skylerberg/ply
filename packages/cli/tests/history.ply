import progress
import std.set (Set)
import compiler.check.infer.checker (TestInfo)
import compiler.check.resolve.tables (Source)
import compiler.front.checking (LoadInputs)
import compiler.front.checking.view
import compiler.front.checking.view (ModuleVersion)
import compiler.store.hash.forms (DefinitionHash, ModuleHashes)
import compiler.store.hash.graph (HeldValue)
import changes (StoredText, module_texts, stored_text_at)
import diagnostic (SourceText)
import program (ProgramStore, Session, in_program_store)
import std.list
import tester (result_cache)
import testing.conclude (StoreUpdate, PassRecord)
import tests.listing (TestListing, TestReading, TestRecord, sources_named)
import compiler.front.checking.program_facts (keys_of)

pub type IndexedVersion = { index: Int, version: ModuleVersion }

fn recorded_test_texts(
  listing: TestListing,
  sources: List<Source>,
  update: StoreUpdate,
) -> List<StoredText> / {abort.raise} = {
  let tests = listing.tests.fold(Map::new(), |found: Map<Bytes, TestInfo>, t: TestRecord|
    found.insert(t.info.key, t.info));
  update.records.fold([], |found: List<StoredText>, e: { key: Bytes, record: PassRecord }|
    match tests.get(e.key) {
      None -> found,
      Some(t) -> match stored_text_at(sources, t.at, e.record.test) {
        Some(text) -> found.push(text),
        None -> found,
      },
    })
}

pub fn store_versions(
  listing: TestListing,
  sources: List<Source>,
  versions: List<IndexedVersion>,
  update: StoreUpdate,
) -> Unit / {result_cache.unstored, result_cache.history, abort.raise} = {
  let texts = versions.fold(
    recorded_test_texts(listing, sources, update),
    |found: List<StoredText>, m: IndexedVersion|
      found.concat(module_texts(m.version.one, m.version.hashes.own, sources.get(m.index))),
  );
  let unstored = result_cache.unstored(texts.map(|t: StoredText| t.hash)).fold(
    Set::empty(),
    |found: Set<Bytes>, hash: Bytes| found.insert(hash),
  );
  result_cache.history(
    texts.filter(|t: StoredText| unstored.contains(t.hash)),
    versions.map(|m: IndexedVersion| m.version.hashes),
    listing.records,
  )
}

fn definitions_passed(versions: List<IndexedVersion>) -> List<Bytes> =
  versions.fold([], |found: List<Bytes>, m: IndexedVersion|
    m.version.hashes.own.definitions.fold(
      found.push(m.version.hashes.record),
      |hashes: List<Bytes>, n: DefinitionHash|
        if n.kind == HeldValue { hashes.push(n.hash) } else { hashes },
    ))

pub fn store_run(
  t: Session<TestReading>,
  listing: TestListing,
  places: List<SourceText>,
  update: StoreUpdate,
  all_passed: Bool,
) -> List<Bytes> / {result_cache.known, result_cache.has_records, result_cache.unstored, result_cache.history, ProgramStore, abort.raise} = {
  let records = listing.records;
  let recording = update.records.len() > 0;
  let seen = if all_passed { result_cache.known(records) } else { records.map(|r: Bytes| true) };
  let stored = if recording { result_cache.has_records(records) }
  else { records.map(|r: Bytes| true) };
  let unread = range(0, records.len()).filter(|i: Int|
    !seen.at_or(i, true) || !stored.at_or(i, true));
  let keys = keys_of(t.modules);
  let versions = if unread.len() == 0 { [] } else {
    progress::silently(||
      in_program_store(t.place, |_: LoadInputs|
        unread.map(|i: Int| { index: i, version: view::module_version(keys.get(i)) }))).value
  };
  if recording { store_versions(listing, sources_named(listing.names, places), versions, update) };
  if all_passed { definitions_passed(versions) } else { [] }
}
