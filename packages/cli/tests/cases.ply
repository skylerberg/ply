pub type Scope = { visible: List<Int>, out: List<Int>, filtered_out: Int }

fn root_modules(analysis: CheckedProgram) -> Map<String, Bool> =
  range(0, analysis.frame.outlines.len()).fold(
    Map::new(),
    |accumulator: Map<String, Bool>, i: Int|
      match ((analysis.frame.outlines.at(i), analysis.frame.module_packages.at(i))) {
        (Some(o), Some(pkg)) -> if pkg == 0 {
          accumulator.insert(String::of_bytes_lossy(o.name), true)
        } else { accumulator },
        _ -> accumulator,
      },
  )

pub fn scope_of(
  analysis: CheckedProgram,
  filters: List<String>,
  shard: Option<surface::Shard>,
  named: Option<List<String>>,
) -> Scope / {abort.raise} = {
  let packaged = analysis.frame.packages.len() > 0;
  let root = root_modules(analysis);
  let loaded = module_names(analysis.frame.order);
  let in_scope = |t: TestInfo|
    if packaged { root.contains(String::of_bytes_lossy(t.module)) } else { !is_shipped(t.module) };
  let matches = |t: TestInfo|
    matches_filters(
        filters,
        loaded,
        String::of_bytes_lossy(t.module),
        String::of_bytes_lossy(t.key),
      )
      && in_shard(shard, t.key)
      && (match named {
        Some(modules) -> modules.contains(String::of_bytes_lossy(t.module)),
        None -> true,
      });
  range(0, analysis.checked.tests.len()).fold(
    { visible: [], out: [], filtered_out: 0 },
    |accumulator: Scope, i: Int|
      match test_at(analysis, i) {
        None -> accumulator,
        Some(t) -> if !in_scope(t) { { ..accumulator, out: accumulator.out.push(i) } }
        else if matches(t) { { ..accumulator, visible: accumulator.visible.push(i) } }
        else { { ..accumulator, filtered_out: accumulator.filtered_out + 1 } },
      },
  )
}

fn in_shard(shard: Option<surface::Shard>, key: Bytes) -> Bool / {abort.raise} =
  match shard {
    None -> true,
    Some(s) -> match blake3(key).u32_at(0) {
      Some(n) -> n % s.count == s.index - 1,
      None -> s.index == 1,
    },
  }

pub fn over_cases(
  analysis: CheckedProgram,
  filters: List<String>,
  named: Option<List<String>>,
) -> List<Int> / {abort.raise} = {
  let loaded = module_names(analysis.frame.order);
  scope_of(analysis, [], None, named).visible.filter(|i: Int|
    match test_at(analysis, i) {
      Some(t) -> t.cases && could_match_filters(filters, loaded, String::of_bytes_lossy(t.module)),
      None -> false,
    })
}

type ListingScope = { front: LoadedAnalysis, reach: Map<Bytes, Bool> }

pub fn list_cases(
  testing: TestRun,
  lister: Option<ListingScope>,
  test_indices: List<Int>,
) -> Result<Map<Int, Result<List<ListedCase>, ListingFailure>>, List<Diagnostic>> / {entering::machine.open, entering::machine.enter, entering::machine.close, emit.unit, emit.compiled, abort.raise} =
  match lister {
    None -> Ok(Map::new()),
    Some(l) -> {
      let front = l.front;
      let tables = test_indices.fold(Map::new(), |accumulator: Map<RootName, Bool>, i: Int|
        match test_root_at(front.dump, i) {
          Some(r) -> accumulator.insert(root_name(TestCases(r)), true),
          None -> accumulator,
        });
      match emit.unit(front, reachable_roots(front, tables, l.reach), None) {
        Err(diagnostics) -> Err(diagnostics),
        Ok(e) -> match units::library(e.sources, testing.options.machine.profile) {
          Err(diagnostics) -> Err(diagnostics),
          Ok(library) -> match tester::unit_of(testing, front, Some(library), false) {
            Err(diagnostics) -> Err(diagnostics),
            Ok(unit) -> {
              let cases = test_indices.fold(
                Map::new(),
                |accumulator: Map<Int, Result<List<ListedCase>, ListingFailure>>, i: Int|
                  accumulator.insert(i, tester::cases(unit, i)),
              );
              tester::close_unit(unit);
              Ok(cases)
            },
          },
        },
      }
    },
  }

pub fn scope_for_listing(
  analysis: CheckedProgram,
  listing: List<Int>,
) -> TestRunScope / {abort.raise} = {
  let keys = listing.fold([], |accumulator: List<Bytes>, i: Int|
    match test_at(analysis, i) { Some(t) -> accumulator.push(t.key), None -> accumulator });
  {
    owners: reachable_by_tests(analysis.frame.hashes, keys),
    tests: Map::of_entries(keys.map(|k: Bytes| { key: k, value: true })),
  }
}

pub fn run_within(over: ExpandedTests, running: List<Int>) -> TestRunScope / {abort.raise} =
  {
    owners: reachable_from(over.analysis, running),
    tests: running.fold(Map::new(), |accumulator: Map<Bytes, Bool>, k: Int|
      match over.entries.at(k) {
        Some(entry) -> accumulator.insert(entry.key, true),
        None -> accumulator,
      }),
  }

fn reachable_from(analysis: CheckedProgram, tests: List<Int>) -> Map<Bytes, Bool> / {abort.raise} =
  reachable_functions(
    analysis.frame.hashes,
    tests.fold([], |accumulator: List<Subject>, i: Int|
      match test_at(analysis, i) {
        Some(t) -> accumulator.push(ItemKeyed(t.key)),
        None -> accumulator,
      }),
  )

fn reachable_roots(
  front: LoadedAnalysis,
  own: Map<RootName, Bool>,
  reachable_functions: Map<Bytes, Bool>,
) -> List<RootKey> / {abort.raise} =
  every_root(front).filter(|r: RootKey|
    own.contains(root_name(r))
      || (match root_owner(r) { Named(d) -> reachable_functions.contains(d), _ -> false }))

fn root_owner(root: RootKey) -> RootKey = match root { Clause(c) -> c.definition, _ -> root }

pub fn run_unit(
  front: LoadedAnalysis,
  over: ExpandedTests,
  tests: List<Int>,
  reachable_functions: Map<Bytes, Bool>,
  schema: Bool,
) -> Result<Option<Emitted>, List<Diagnostic>> / {emit.unit, abort.raise} =
  if schema {
    match whole_emitted(front) { Ok(e) -> Ok(Some(e)), Err(diagnostics) -> Err(diagnostics) }
  } else if tests.len() == 0 { Ok(None) } else {
    let own = tests.fold(Map::new(), |accumulator: Map<RootName, Bool>, k: Int|
      match over.entries.at(k) {
        Some(entry) -> match test_root_at(front.dump, entry.test) {
          Some(r) -> accumulator.insert(root_name(r), true).insert(root_name(TestCases(r)), true),
          None -> accumulator,
        },
        None -> accumulator,
      });
    match emit.unit(front, reachable_roots(front, own, reachable_functions), None) {
      Ok(e) -> Ok(Some(e)),
      Err(diagnostics) -> Err(diagnostics),
    }
  }

pub type ExpandedTests = {
  analysis: CheckedProgram,
  run_analysis: CheckedProgram,
  entries: List<Entry>,
}

type ExpansionState = {
  tests: List<TestInfo>,
  hashes: Map<Bytes, Bytes>,
  entries: List<Entry>,
  starts: Map<Bytes, List<Int>>,
  runs: Map<Bytes, List<Int>>,
}

fn add_starts(
  starts: Map<Bytes, List<Int>>,
  key: Bytes,
  new_starts: Option<List<Int>>,
) -> Map<Bytes, List<Int>> =
  match new_starts {
    None -> starts,
    Some(vs) ->
      starts.insert(
        key,
        List::concat(match starts.get(key) { Some(existing) -> existing, None -> [] }, vs),
      ),
  }

type Claim = { test: Int, case: Option<Int> }

fn claimed(claims: Map<Bytes, List<Claim>>, key: Bytes, by: Claim) -> Map<Bytes, List<Claim>> =
  claims.insert(
    key,
    List::push(match claims.get(key) { Some(existing) -> existing, None -> [] }, by),
  )

fn distinct_labels(
  tests: List<TestInfo>,
  labels: List<Location>,
  listings: Map<Int, Result<List<ListedCase>, ListingFailure>>,
) -> Map<Int, Result<List<ListedCase>, ListingFailure>> = {
  let case_key = |t: TestInfo, c: ListedCase| qualify(t.module, Bytes::of_string(c.label));
  let claims = range(0, tests.len()).fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Claim>>, i: Int|
      match tests.at(i) {
        None -> accumulator,
        Some(t) -> {
          let named = claimed(accumulator, t.key, { test: i, case: None });
          match listings.get(i) {
            Some(Ok(listing)) ->
              range(0, listing.len()).fold(named, |a: Map<Bytes, List<Claim>>, k: Int|
                match listing.at(k) {
                  Some(c) -> claimed(a, case_key(t, c), { test: i, case: Some(k) }),
                  None -> a,
                }),
            _ -> named,
          }
        },
      },
  );
  listings.fold(
    listings,
    |accumulator: Map<Int, Result<List<ListedCase>, ListingFailure>>, i: Int, list_cases: Result<List<ListedCase>, ListingFailure>|
      match ((list_cases, tests.at(i))) {
        (Ok(listing), Some(t)) -> {
          let first = range(0, listing.len()).fold(None, |found: Option<ListingFailure>, k: Int|
            match ((found, listing.at(k))) {
              (None, Some(c)) ->
                label_clash(labels, i, k, c.label, match claims.get(case_key(t, c)) {
                  Some(all) -> all,
                  None -> [],
                }),
              _ -> found,
            });
          match first { Some(reason) -> accumulator.insert(i, Err(reason)), None -> accumulator }
        },
        _ -> accumulator,
      },
  )
}

fn label_clash(
  labels: List<Location>,
  i: Int,
  k: Int,
  label: String,
  claims: List<Claim>,
) -> Option<ListingFailure> =
  match labels.at(i) {
    None -> None,
    Some(at) -> match claims.filter(|c: Claim| c.test != i) {
      [other, ..] -> {
        let named = other.case == None;
        Some(
          rejected(
            at,
            match labels.at(other.test) {
              Some(o) ->
                [
                  pointing(o, false, if named { "this test has that name" }
                  else { "a case of this test has that label" }),
                ],
              None -> [],
            },
            "the case at position " ++ k.to_string() ++ " of the table has the label \"" ++ label
              ++ "\", which "
              ++ (if named { "is the name of another test" }
              else { "a case of another test also has" }),
          ),
        )
      },
      [] -> {
        let own = claims.fold([], |at: List<Int>, c: Claim|
          match c.case { Some(n) -> at.push(n), None -> at });
        if own.len() < 2 { None } else {
          Some(
            rejected(
              at,
              [],
              "the cases at positions " ++ places(own) ++ " of the table have the same label, \""
                ++ label
                ++ "\"",
            ),
          )
        }
      },
    },
  }

fn rejected(at: Location, also: List<Label>, message: String) -> ListingFailure =
  {
    status: "failed",
    failure: {
      diagnostic: diagnostic_of(
        "error",
        "E0105",
        message,
        [pointing(at, true, "this test")].concat(also),
        [
          "each test and each case in a module needs its own label, so none of this test's cases ran",
        ],
      ),
      values: [],
    },
  }

fn pointing(at: Location, primary: Bool, text: String) -> Label =
  {
    module: at.module,
    start: at.span.start,
    end: at.span.end,
    primary: primary,
    text: Bytes::of_string(text),
  }

fn places(at: List<Int>) -> String =
  match at {
    [a, b] -> a.to_string() ++ " and " ++ b.to_string(),
    [a, b, c] -> a.to_string() ++ ", " ++ b.to_string() ++ " and " ++ c.to_string(),
    [a, b, c, ..more] ->
      a.to_string() ++ ", " ++ b.to_string() ++ ", " ++ c.to_string() ++ " and "
        ++ more.len().to_string()
        ++ " more",
    [a] -> a.to_string(),
    [] -> "",
  }

pub fn expand_cases(
  analysis: CheckedProgram,
  listings: Map<Int, Result<List<ListedCase>, ListingFailure>>,
) -> ExpandedTests / {abort.raise} = {
  let tests = analysis.checked.tests;
  let cases = distinct_labels(tests, test_label_spans(analysis.frame.outlines), listings);
  let plain = range(0, tests.len()).map(|i: Int|
    entry_of(i, match tests.at(i) { Some(t) -> t.key, None -> b"" }));
  if cases.len() == 0 { { analysis: analysis, run_analysis: analysis, entries: plain } } else {
    let walked = range(0, tests.len()).fold(
      {
        tests: [],
        hashes: Map::new(),
        entries: [],
        starts: analysis.frame.hashes.refs.items,
        runs: analysis.frame.hashes.refs.items,
      },
      |accumulator: ExpansionState, i: Int|
        match ((tests.at(i), plain.at(i))) {
          (Some(t), Some(whole)) -> {
            let hash = analysis.frame.hashes.tests.get(t.key);
            match cases.get(i) {
              Some(Ok(listing)) ->
                range(0, listing.len()).fold(accumulator, |a: ExpansionState, k: Int|
                  match listing.at(k) {
                    None -> a,
                    Some(c) -> {
                      let key = qualify(t.module, Bytes::of_string(c.label));
                      {
                        tests: a.tests.push({
                          ..t,
                          name: Bytes::of_string(c.label),
                          key: key,
                          index: a.tests.len(),
                        }),
                        hashes: match hash {
                          Some(h) -> a.hashes.insert(key, case_hash(h, c.identity)),
                          None -> a.hashes,
                        },
                        entries: a.entries.push({
                          ..whole,
                          case: Some({ at: k, identity: c.identity }),
                        }),
                        starts: add_starts(
                          a.starts,
                          key,
                          analysis.frame.hashes.refs.items.get(t.key),
                        ),
                        runs: add_starts(a.runs, key, analysis.frame.hashes.refs.cases.get(t.key)),
                      }
                    },
                  }),
              other ->
                {
                  ..accumulator,
                  tests: accumulator.tests.push({ ..t, index: accumulator.tests.len() }),
                  hashes: match hash {
                    Some(h) -> accumulator.hashes.insert(t.key, h),
                    None -> accumulator.hashes,
                  },
                  entries: accumulator.entries.push(match other {
                    Some(Err(reason)) -> { ..whole, unlisted: Some(reason) },
                    _ -> whole,
                  }),
                },
            }
          },
          _ -> accumulator,
        },
    );
    let with_starts = |starts: Map<Bytes, List<Int>>|
      {
        frame: {
          ..analysis.frame,
          hashes: {
            ..analysis.frame.hashes,
            tests: walked.hashes,
            refs: { ..analysis.frame.hashes.refs, items: starts },
          },
        },
        checked: { ..analysis.checked, tests: walked.tests },
      };
    {
      analysis: with_starts(walked.starts),
      run_analysis: with_starts(walked.runs),
      entries: walked.entries,
    }
  }
}

pub fn codes_of(
  front: LoadedAnalysis,
  emitted: Emitted,
  entries: List<Entry>,
) -> Map<Int, Bytes> / {abort.raise} = {
  let ran = codes(emitted.contents);
  let code_of = |k: Int|
    match test_root_at(front.dump, k) { Some(r) -> ran.get(root_name(r)), None -> None };
  range(0, entries.len()).fold(Map::new(), |accumulator: Map<Int, Bytes>, i: Int|
    match entries.at(i) {
      None -> accumulator,
      Some(entry) -> match code_of(entry.test) {
        None -> accumulator,
        Some(code) ->
          accumulator.insert(i, match entry.case {
            Some(c) -> case_hash(code, c.identity),
            None -> code,
          }),
      },
    })
}

pub fn passed_by_code(
  decisions: List<Decision>,
  keyed: Map<Int, Bytes>,
  loaded: Map<Bytes, Bytes>,
  options: Options,
  supplied: machine::RunConfiguration,
) -> Map<Int, Bytes> / {result_cache.code_passes, entering::machine.changed_read, fs.list_dir[shipped], fs.read_file[shipped], abort.raise} = {
  let queries = code_keys_to_query(decisions, keyed);
  let results = if queries.len() == 0 { [] }
  else { result_cache.code_passes(queries.map(|a: { index: Int, key: Bytes }| a.key)) };
  let now = views::shipped_state_of(views::views_in(traces_of(results)), |m: Bytes|
    views::read_shipped_text(loaded, m));
  range(0, queries.len()).fold(Map::new(), |accumulator: Map<Int, Bytes>, i: Int|
    match results.at(i) {
      Some(Some(trace)) -> if pass_status(now, Some(trace), options, supplied) == Some(Passing) {
        accumulator.insert(queries.at_or(i, { index: 0 - 1, key: b"" }).index, trace)
      } else { accumulator },
      _ -> accumulator,
    })
}

fn program_binding_report(program: Program) -> BindingReport / {abort.raise} = {
  let hosted = tester::binding_report_of(program.unit.testing, program.unit);
  let host_tests = set_of(hosted.host_test_indices);
  {
    ..hosted,
    host_test_indices: program.cases.filter(|case: Case| host_tests.contains(case.entry.test)).map(
      |case: Case| case.index,
    ),
  }
}

pub effect passing_run {
  write all_passed(count: Int) -> Unit
}

pub fn concluded_run(
  flags: Flags,
  style: Style,
  options: Options,
  program: Program,
  timed: TimedLoad,
  analysis: CheckedProgram,
  run_analysis: CheckedProgram,
  scope: Scope,
  decisions: List<Decision>,
  decided: RunDecision,
  keyed: Map<Int, Bytes>,
  refiled: List<Pass>,
  searching: plan::Plan,
  configured: List<Diagnostic>,
  spent: TimeSpent,
) -> CommandOutput / {passing_run.all_passed, process.out[proc], time.elapsed_us, entering::machine.enter, entering::machine.report, entering::machine.unbind, result_cache.open_warnings, result_cache.known, result_cache.baselines, result_cache.texts, result_cache.unstored, result_cache.history, result_cache.store_filing, shipped.read_pack, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise} = {
  let width = name_column(program, decided);
  let search_options = {
    plan: searching,
    measuring: options.sim.measure_reduction,
    lanes: match options.jobs { Some(n) -> if n > 0 { Some(n) } else { None }, None -> None },
    reporting: { style: style, width: width, to_stderr: flags.json },
  };
  let narrowing = narrowed_searches(decisions, decided.search.roots);
  let hosted = program_binding_report(program);
  printed(opening_lines(style, flags, program, decided, opening_of(options, program, hosted)));
  let started = time.elapsed_us();
  let done = decided.classes.flat_map(|group: Group| {
    let ran = run_class(
      group.tests.map(|i: Int| job_of(program, i, narrowing, searching)),
      search_options,
    );
    printed(
      detailed_result_lines(
        style,
        program,
        ran.map(|d: JobResult| job_outcome(analysis, d)),
        width,
      ),
    );
    ran
  });
  let elapsed = time.elapsed_us() - started;
  let h = hashes_of(run_analysis, results::snapshot_digest_of(timed.program.modules));
  let running = set_of(decided.runs);
  let by_test = done.fold(Map::new(), |accumulator: Map<Int, JobResult>, d: JobResult|
    accumulator.insert(d.test, d));
  let c: Conclusion<RuntimeDiagnostic> = conclude::conclude_run(
    conclude_tests(analysis, program),
    h,
    {
      groups: decided.classes.map(|group: Group| group.tests),
      recorded: pass_keys_by_test(decisions, decided.search).fold(
        Map::new(),
        |accumulator: Map<Int, List<Bytes>>, e: { index: Int, keys: List<Bytes> }|
          if running.contains(e.index) { accumulator.insert(e.index, e.keys) } else { accumulator },
      ),
      codes: keyed.fold(Map::new(), |accumulator: Map<Int, List<Bytes>>, i: Int, k: Bytes|
        if running.contains(i) { accumulator.insert(i, [k]) } else { accumulator }),
      reasons: decisions.fold(Map::new(), |accumulator: Map<Int, Reason>, d: Decision|
        accumulator.insert(d.case.index, d.reason)),
      out_of_scope: scope.out,
    },
    if flags.no_cache { Map::new() } else { seen_of(h) },
    done.map(conclusion_of),
  );
  let cache_warnings = if flags.no_cache { [] } else {
    store_history(
      analysis,
      sources_of(timed.program, analysis.frame),
      timed.program.modules,
      c.store_update,
    );
    store_warnings(
      result_cache.store_filing({
        ..c.store_update,
        passes: c.store_update.passes.concat(refiled),
      }),
      "could not write the test cache: ",
      "the run itself is valid; every test will simply be re-run next time",
    )
  };
  let r = {
    ..run_report_of(options, program, analysis, h, decided, hosted, c, by_test, elapsed, configured.concat(cache_warnings)),
    handshakes: tester::unbind(program.unit.testing),
  };
  let found = diagnosed_all(flags.no_cache, timed, run_analysis, c, r.failures);
  let lazily = if flags.no_cache { [] } else { result_cache.open_warnings() };
  let concluding = time.elapsed_us() - started - elapsed;
  if r.summary.failed == 0 && r.summary.timed_out == 0 && !analysis.checked.tests.any(|t: TestInfo| t.nondet) {
    passing_run.all_passed(r.summary.passed)
  };
  test_output(
    style,
    flags,
    program,
    {
      ..r,
      warnings: r.warnings.concat(lazily),
      spent: { ..spent, tests_us: elapsed, conclude_us: concluding },
    },
    found.faults,
    found.diffs,
    decided,
  )
}

fn store_warnings(f: StoreResult, unflushed: String, note: String) -> List<Diagnostic> =
  match f.unflushed {
    None -> f.warnings,
    Some(reason) ->
      [diagnostic_of("warning", "W0601", unflushed ++ reason, [], [note])].concat(f.warnings),
  }

pub fn search_of(p: plan::Plan) -> Search / {abort.raise} =
  {
    mode: plan::mode_word(p.mode),
    roots: p.roots.map(|r: U64| Int::of_u64(r)),
    budget: p.budget,
    steps: p.steps,
    path: p.path,
  }

pub fn sim_json(p: plan::Plan, sim: machine::SimulationOptions) -> Json / {abort.raise} =
  object([
    { key: "budget", value: int(p.budget) },
    { key: "measure_reduction", value: Bool(sim.measure_reduction) },
    { key: "mode", value: Str(plan::mode_word(p.mode)) },
    {
      key: "roots",
      value: Array(
        p.roots.map(|r: U64|
          Number(Decimal::of_string(plan::u64_text(r)).unwrap_or(Decimal::of_int(0)))),
      ),
    },
    {
      key: "seed",
      value: match sim.seed {
        Some(text) -> match plan::parse_seed(text) {
          Some(seed) -> Str(plan::seed_text(seed)),
          None -> Null,
        },
        None -> Null,
      },
    },
    { key: "seeds", value: int(p.roots.len()) },
    { key: "steps", value: int(p.steps) },
  ])

test "`sim_plan_of` turns the search flags into a search, and the JSON report shows the seed, mode and root seeds" {
  let p = machine::sim_plan_of({
    ..machine::no_sim_options(),
    mode: "random",
    roots: Some({ from: 0, to: 3 }),
  });
  assert_eq(search_of(p), { mode: "random", roots: [0, 1, 2], budget: 1, steps: 100000, path: [] });
  let seeded = { ..machine::no_sim_options(), seed: Some("0x10:2") };
  let doc = to_string(with_sim(object([]), sim_json(machine::sim_plan_of(seeded), seeded)));
  assert(doc.contains("\"seed\":\"16:2\""));
  assert(doc.contains("\"mode\":\"once\""));
  assert(doc.contains("\"roots\":[16]"))
}

test "a run selects the tests of the module it was started on, even a library's, but not those of modules it imports" {
  let library = {
    name: b"std.y",
    source_text: b"pub fn one() -> Int = 1\ntest \"library\" { assert_eq(one(), 1) }\n",
  };
  let compiler = {
    name: b"compiler.x",
    source_text: b"pub fn one() -> Int = 1\ntest \"compiler\" { assert_eq(one(), 1) }\n",
  };
  let keys = |user: List<Source>, shipped: List<Source>| {
    let w = match analyse_pulling_std_with(user, shipped, no_rows(), cut_unused: false).out {
      Analysed(w) -> checked_program_of(w),
      Rejected(_) -> panic("the fixture program was rejected by the checker"),
    };
    scope_of(w, [], None, None).visible.map(|i: Int|
      match test_at(w, i) { Some(t) -> t.key, None -> b"" })
  };
  let program = {
    name: b"m",
    source_text: b"import std.y\nimport compiler.x\ntest \"own\" { assert_eq(y::one(), x::one()) }\n",
  };
  assert_eq(keys([program], [library, compiler]), [b"m.own"]);
  assert_eq(keys([library], [library, compiler]), [b"std.y.library"])
}
