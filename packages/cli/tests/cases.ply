// --- The load ---------------------------------------------------------------

/// Where a run keeps its answer for the next run over the same command: the key, the walk the memo
/// store's record of it is made over, the marks found on what the key held, and the keys of the
/// passes it took. `after` is an answer selected again after the run filed its passes, which the
/// store's warnings on opening are not in.
pub type Keeping = {
  key: Bytes,
  project: Project,
  marks: List<Bytes>,
  passes: List<Bytes>,
  after: Bool,
}

/// What a run that ran nothing answered: the lines it printed before its answer, the answer, and the
/// keys of the passes it took.
pub type Kept = {
  opening: List<String>,
  lines: List<String>,
  errs: List<String>,
  code: Int,
  json: String,
  passes: List<Bytes>,
}

derive bin for Kept

/// Every test in scope taken from a pass filed under its own key, or under each root's.
pub fn all_cached(decisions: List<Decision>, scope: Scope) -> Bool = {
  let visible = set_of(scope.visible);
  decisions.fold(true, |all: Bool, d: Decision|
    all && (!visible.contains(d.case.index) || d.reason == Cached))
}

fn unwarned(answer: Answer) -> Bool =
  match answer.json {
    Object(members) -> match members.get("warnings") {
      Some(Array(ws)) -> ws.len() == 0,
      _ -> false,
    },
    _ -> false,
  }

// --- What the loaded tree tells a selector ------------------------------------

/// Which tests a run reports on: the package being loaded — a dependency's tests are its own to run,
/// and a shipped module's its library's own checkout's — narrowed
/// by a path the line names in the package to the modules under it, by `--filter` to the keys it
/// keeps (`args.kept`), and by `--shard` to its part.
pub type Scope = { visible: List<Int>, out: List<Int>, filtered_out: Int }

fn root_modules(analysis: View) -> Map<String, Bool> =
  range(0, analysis.frame.outlines.len()).fold(Map::new(), |acc: Map<String, Bool>, i: Int|
    match ((analysis.frame.outlines.at(i), analysis.frame.module_packages.at(i))) {
      (Some(o), Some(pkg)) -> if pkg == 0 { acc.insert(String::of_bytes_lossy(o.name), true) }
      else { acc },
      _ -> acc,
    })

pub fn scope_of(
  analysis: View,
  options: Options,
  named: Option<List<String>> = None,
) -> Scope / {abort.raise} = {
  let packaged = analysis.frame.packages.len() > 0;
  let root = root_modules(analysis);
  let loaded = module_names(analysis.frame.order);
  let in_scope = |t: TestInfo|
    if packaged { root.contains(String::of_bytes_lossy(t.module)) } else { !is_shipped(t.module) };
  let matches = |t: TestInfo|
    kept(options.filters, loaded, String::of_bytes_lossy(t.module), String::of_bytes_lossy(t.key))
      && in_shard(options.shard, t.key)
      && (match named {
        Some(modules) -> modules.contains(String::of_bytes_lossy(t.module)),
        None -> true,
      });
  range(0, analysis.checked.tests.len()).fold(
    { visible: [], out: [], filtered_out: 0 },
    |acc: Scope, i: Int|
      match test_at(analysis, i) {
        None -> acc,
        Some(t) -> if !in_scope(t) { { ..acc, out: acc.out.push(i) } }
        else if matches(t) { { ..acc, visible: acc.visible.push(i) } }
        else { { ..acc, filtered_out: acc.filtered_out + 1 } },
      },
  )
}

/// Whether the test keyed `key` is in the part `--shard` asks for: its key's hash decides, so it is in
/// the same part every run, whatever else the run selects.
fn in_shard(shard: Option<surface::Shard>, key: Bytes) -> Bool / {abort.raise} =
  match shard {
    None -> true,
    Some(s) -> match blake3(key).u32_at(0) {
      Some(n) -> n % s.count == s.index - 1,
      None -> s.index == 1,
    },
  }

// --- A test over cases --------------------------------------------------------

/// The tests over cases this run may report on: those of the modules `named` holds that `--filter`
/// could keep whatever labels their tables list (`args.could_keep`). `--shard` reads a case's
/// label, which only its listing knows.
pub fn over_cases(
  analysis: View,
  options: Options,
  named: Option<List<String>> = None,
) -> List<Int> / {abort.raise} = {
  let loaded = module_names(analysis.frame.order);
  scope_of(analysis, { ..options, filters: [], shard: None }, named).visible.filter(|i: Int|
    match test_at(analysis, i) {
      Some(t) -> t.cases && could_keep(options.filters, loaded, String::of_bytes_lossy(t.module)),
      None -> false,
    })
}

/// A dump scoped to what listing some tests over cases enters, and what their listings reach.
type Lister = { front: LoadedAnalysis, reach: Map<Bytes, Bool> }

/// Each asked test's cases, or why they could not be listed, from a unit of their tables alone.
pub fn listed(
  testing: Testing,
  lister: Option<Lister>,
  asked: List<Int>,
) -> Result<Map<Int, Result<List<Listed>, Unlisted>>, List<Diag>> / {entering::machine.open, entering::machine.enter, entering::machine.close, emit.unit, emit.compiled, abort.raise} =
  match lister {
    None -> Ok(Map::new()),
    Some(l) -> {
      let handed = l.front;
      let tables = asked.fold(Map::new(), |acc: Map<RootName, Bool>, i: Int|
        match test_root_at(handed.dump, i) {
          Some(r) -> acc.insert(root_name(Cases(r)), true),
          None -> acc,
        });
      match emit.unit(handed, offered_over(handed, tables, l.reach)) {
        Err(diags) -> Err(diags),
        Ok(e) -> match units::library(e.text, testing.options.profile) {
          Err(diags) -> Err(diags),
          Ok(library) -> match tester::unit_of(testing, handed, Some(library), false) {
            Err(diags) -> Err(diags),
            Ok(unit) -> {
              let cases = asked.fold(
                Map::new(),
                |acc: Map<Int, Result<List<Listed>, Unlisted>>, i: Int|
                  acc.insert(i, tester::cases(unit, i)),
              );
              tester::closed(unit);
              Ok(cases)
            },
          },
        },
      }
    },
  }

/// What listing the tests over cases at `listing` enters of the program: their tables and labels,
/// and what those reach.
pub fn listing_within(analysis: View, listing: List<Int>) -> Within / {abort.raise} = {
  let keys = listing.fold([], |acc: List<Bytes>, i: Int|
    match test_at(analysis, i) { Some(t) -> acc.push(t.key), None -> acc });
  {
    owners: listing_reach(analysis.frame.hashes, keys),
    tests: Map::of_entries(keys.map(|k: Bytes| { key: k, value: true })),
  }
}

/// What running the entries at `running` enters of the program: their tests and all they reach.
pub fn run_within(over: Ranged, running: List<Int>) -> Within / {abort.raise} =
  {
    owners: reached_by(over.analysis, running),
    tests: running.fold(Map::new(), |acc: Map<Bytes, Bool>, k: Int|
      match over.entries.at(k) { Some(entry) -> acc.insert(entry.of, true), None -> acc }),
  }

/// The functions the tests at `tests` reach, and what a reached definition's clauses reach.
fn reached_by(analysis: View, tests: List<Int>) -> Map<Bytes, Bool> / {abort.raise} =
  reached_functions(
    analysis.frame.hashes,
    tests.fold([], |acc: List<Which>, i: Int|
      match test_at(analysis, i) { Some(t) -> acc.push(TheItem(t.key)), None -> acc }),
  )

/// The roots a unit offers: those `own` names, and each root of a definition `reached` names, so a
/// root runs here as in the whole program's unit and its code digests alike.
fn offered_over(
  front: LoadedAnalysis,
  own: Map<RootName, Bool>,
  reached: Map<Bytes, Bool>,
) -> List<RootKey> / {abort.raise} =
  every_root(front).filter(|r: RootKey|
    own.contains(root_name(r))
      || (match root_owner(r) { Named(d) -> reached.contains(d), _ -> false }))

/// The root a root answers for: a clause's is its definition.
fn root_owner(root: RootKey) -> RootKey = match root { Clause(c) -> c.def, _ -> root }

/// The unit the run's tests at `tests` execute in: their roots, a test over cases with the root that
/// lists its table, and all they reach (`reached`); or the whole program's where a schema has
/// constants to enter.
pub fn run_unit(
  front: LoadedAnalysis,
  over: Ranged,
  tests: List<Int>,
  reached: Map<Bytes, Bool>,
  schema: Bool,
) -> Result<Option<Emitted>, List<Diag>> / {emit.unit, abort.raise} =
  if schema { match whole_emitted(front) { Ok(e) -> Ok(Some(e)), Err(diags) -> Err(diags) } }
  else if tests.len() == 0 { Ok(None) } else {
    let own = tests.fold(Map::new(), |acc: Map<RootName, Bool>, k: Int|
      match over.entries.at(k) {
        Some(entry) -> match test_root_at(front.dump, entry.test) {
          Some(r) -> acc.insert(root_name(r), true).insert(root_name(Cases(r)), true),
          None -> acc,
        },
        None -> acc,
      });
    match emit.unit(front, offered_over(front, own, reached)) {
      Ok(e) -> Ok(Some(e)),
      Err(diags) -> Err(diags),
    }
  }

/// The run's tests, each case of a test over cases a test of its own: its label is its name, and its
/// test's hash and its identity make its hash. In `analysis` a case reaches what its test does, its
/// table among it, which is what covers a definition; in `judged` it reaches only what it runs,
/// which is what a failure of it is suspected against. `entries` is how the runtime is asked for
/// each, by the index it has here.
pub type Ranged = { analysis: View, judged: View, entries: List<Entry> }

type Ranging = {
  tests: List<TestInfo>,
  hashes: Map<Bytes, Bytes>,
  entries: List<Entry>,
  starts: Map<Bytes, List<Int>>,
  runs: Map<Bytes, List<Int>>,
}

/// `key` starting where it did and at `reached` besides.
fn starting(
  starts: Map<Bytes, List<Int>>,
  key: Bytes,
  reached: Option<List<Int>>,
) -> Map<Bytes, List<Int>> =
  match reached {
    None -> starts,
    Some(vs) ->
      starts.insert(
        key,
        List::concat(match starts.get(key) { Some(held) -> held, None -> [] }, vs),
      ),
  }

/// One thing a run identifies by a key: test `test` by its name, or its case at position `case`
/// by that case's label.
type Claim = { test: Int, case: Option<Int> }

fn claimed(claims: Map<Bytes, List<Claim>>, key: Bytes, by: Claim) -> Map<Bytes, List<Claim>> =
  claims.insert(key, List::push(match claims.get(key) { Some(held) -> held, None -> [] }, by))

/// The listings, except that a test fails as a whole, running none of its cases, when one of its
/// cases has the label of another case in its table, of another test, or of a case of another
/// test. A run identifies each case by its label, so two with one label would be mixed up.
fn distinct_labels(
  tests: List<TestInfo>,
  labels: List<Location>,
  listings: Map<Int, Result<List<Listed>, Unlisted>>,
) -> Map<Int, Result<List<Listed>, Unlisted>> = {
  let case_key = |t: TestInfo, c: Listed| qualify(t.module, Bytes::of_string(c.label));
  let claims = range(0, tests.len()).fold(Map::new(), |acc: Map<Bytes, List<Claim>>, i: Int|
    match tests.at(i) {
      None -> acc,
      Some(t) -> {
        let named = claimed(acc, t.key, { test: i, case: None });
        match listings.get(i) {
          Some(Ok(listing)) ->
            range(0, listing.len()).fold(named, |a: Map<Bytes, List<Claim>>, k: Int|
              match listing.at(k) {
                Some(c) -> claimed(a, case_key(t, c), { test: i, case: Some(k) }),
                None -> a,
              }),
          _ -> named,
        }
      },
    });
  listings.fold(
    listings,
    |acc: Map<Int, Result<List<Listed>, Unlisted>>, i: Int, listed: Result<List<Listed>, Unlisted>|
      match ((listed, tests.at(i))) {
        (Ok(listing), Some(t)) -> {
          let first = range(0, listing.len()).fold(None, |found: Option<Unlisted>, k: Int|
            match ((found, listing.at(k))) {
              (None, Some(c)) ->
                label_clash(labels, i, k, c.label, match claims.get(case_key(t, c)) {
                  Some(all) -> all,
                  None -> [],
                }),
              _ -> found,
            });
          match first { Some(why) -> acc.insert(i, Err(why)), None -> acc }
        },
        _ -> acc,
      },
  )
}

/// Why test `i` fails when its case at position `k` has the label `label`, given everything in
/// the run with that label's key; `None` when nothing else has it. `labels` is where each test's
/// label is written.
fn label_clash(
  labels: List<Location>,
  i: Int,
  k: Int,
  label: String,
  claims: List<Claim>,
) -> Option<Unlisted> =
  match labels.at(i) {
    None -> None,
    Some(at) -> match claims.filter(|c: Claim| c.test != i) {
      [other, ..] -> {
        let named = other.case == None;
        Some(
          refused(
            at,
            match labels.at(other.test) {
              Some(o) ->
                [
                  pointing(o, false, if named { "this test has that name" }
                  else { "a case of this test has that label" }),
                ],
              None -> [],
            },
            "the case at position " ++ k.to_string() ++ " of the table has the label \"" ++ label
              ++ "\", which "
              ++ (if named { "is the name of another test" }
              else { "a case of another test also has" }),
          ),
        )
      },
      [] -> {
        let own = claims.fold([], |at: List<Int>, c: Claim|
          match c.case { Some(n) -> at.push(n), None -> at });
        if own.len() < 2 { None } else {
          Some(
            refused(
              at,
              [],
              "the cases at positions " ++ places(own) ++ " of the table have the same label, \""
                ++ label
                ++ "\"",
            ),
          )
        }
      },
    },
  }

/// A test failing as a whole with `message`, pointing at its label `at` and at `also`.
fn refused(at: Location, also: List<Label>, message: String) -> Unlisted =
  {
    status: "failed",
    failure: {
      diag: diag_of("error", "E0105", message, [pointing(at, true, "this test")].concat(also), [
        "each test and each case in a module needs its own label, so none of this test's cases ran",
      ]),
      values: [],
    },
  }

fn pointing(at: Location, primary: Bool, text: String) -> Label =
  {
    module: at.module,
    start: at.span.start,
    end: at.span.end,
    primary: primary,
    text: Bytes::of_string(text),
  }

/// Positions in a table, listing the first three and counting the rest.
fn places(at: List<Int>) -> String =
  match at {
    [a, b] -> a.to_string() ++ " and " ++ b.to_string(),
    [a, b, c] -> a.to_string() ++ ", " ++ b.to_string() ++ " and " ++ c.to_string(),
    [a, b, c, ..more] ->
      a.to_string() ++ ", " ++ b.to_string() ++ ", " ++ c.to_string() ++ " and "
        ++ more.len().to_string()
        ++ " more",
    [a] -> a.to_string(),
    [] -> "",
  }

pub fn ranged(
  analysis: View,
  listings: Map<Int, Result<List<Listed>, Unlisted>>,
) -> Ranged / {abort.raise} = {
  let tests = analysis.checked.tests;
  let cases = distinct_labels(tests, test_label_spans(analysis.frame.outlines), listings);
  let plain = range(0, tests.len()).map(|i: Int|
    entry_of(i, match tests.at(i) { Some(t) -> t.key, None -> b"" }));
  if cases.len() == 0 { { analysis: analysis, judged: analysis, entries: plain } } else {
    let walked = range(0, tests.len()).fold(
      {
        tests: [],
        hashes: Map::new(),
        entries: [],
        starts: analysis.frame.hashes.refs.items,
        runs: analysis.frame.hashes.refs.items,
      },
      |acc: Ranging, i: Int|
        match ((tests.at(i), plain.at(i))) {
          (Some(t), Some(whole)) -> {
            let hash = analysis.frame.hashes.tests.get(t.key);
            match cases.get(i) {
              Some(Ok(listing)) ->
                range(0, listing.len()).fold(acc, |a: Ranging, k: Int|
                  match listing.at(k) {
                    None -> a,
                    Some(c) -> {
                      let key = qualify(t.module, Bytes::of_string(c.label));
                      {
                        tests: a.tests.push({
                          ..t,
                          name: Bytes::of_string(c.label),
                          key: key,
                          index: a.tests.len(),
                        }),
                        hashes: match hash {
                          Some(h) -> a.hashes.insert(key, case_hash(h, c.identity)),
                          None -> a.hashes,
                        },
                        entries: a.entries.push({
                          ..whole,
                          case: Some({ at: k, identity: c.identity }),
                        }),
                        starts: starting(
                          a.starts,
                          key,
                          analysis.frame.hashes.refs.items.get(t.key),
                        ),
                        runs: starting(a.runs, key, analysis.frame.hashes.refs.cases.get(t.key)),
                      }
                    },
                  }),
              other ->
                {
                  ..acc,
                  tests: acc.tests.push({ ..t, index: acc.tests.len() }),
                  hashes: match hash { Some(h) -> acc.hashes.insert(t.key, h), None -> acc.hashes },
                  entries: acc.entries.push(match other {
                    Some(Err(why)) -> { ..whole, unlisted: Some(why) },
                    _ -> whole,
                  }),
                },
            }
          },
          _ -> acc,
        },
    );
    let reaching = |starts: Map<Bytes, List<Int>>|
      {
        frame: {
          ..analysis.frame,
          hashes: {
            ..analysis.frame.hashes,
            tests: walked.hashes,
            refs: { ..analysis.frame.hashes.refs, items: starts },
          },
        },
        checked: { ..analysis.checked, tests: walked.tests },
      };
    { analysis: reaching(walked.starts), judged: reaching(walked.runs), entries: walked.entries }
  }
}

/// Each test's code by index: the digest of what its root runs in the unit, and for a case its
/// identity with it.
pub fn codes_of(
  front: LoadedAnalysis,
  emitted: Emitted,
  entries: List<Entry>,
) -> Map<Int, Bytes> / {abort.raise} = {
  let ran = codes(emitted.made);
  let code_of = |k: Int|
    match test_root_at(front.dump, k) { Some(r) -> ran.get(root_name(r)), None -> None };
  range(0, entries.len()).fold(Map::new(), |acc: Map<Int, Bytes>, i: Int|
    match entries.at(i) {
      None -> acc,
      Some(entry) -> match code_of(entry.test) {
        None -> acc,
        Some(code) ->
          acc.insert(i, match entry.case { Some(c) -> case_hash(code, c.identity), None -> code }),
      },
    })
}

/// The tests the store holds a pass for under the code they run that still stands, each with the
/// trace it stands on. `loaded` is what the run's load read of the shipped modules
/// (`views.held_texts`); `options` the run's, whose roots a pass's reads are read against.
pub fn passed_by_code(
  decisions: List<Decision>,
  keyed: Map<Int, Bytes>,
  loaded: Map<Bytes, Bytes>,
  options: Options,
  supplied: machine::Configured,
) -> Map<Int, Bytes> / {ledger.code_passes, entering::machine.moved, fs.list_dir[shipped], fs.read_file[shipped], abort.raise} = {
  let asked = asked_by_code(decisions, keyed);
  let answers = if asked.len() == 0 { [] }
  else { ledger.code_passes(asked.map(|a: { index: Int, key: Bytes }| a.key)) };
  let now = views::now_for(views::viewed_in(traces_of(answers)), |m: Bytes|
    views::read_held(loaded, m));
  range(0, asked.len()).fold(Map::new(), |acc: Map<Int, Bytes>, i: Int|
    match answers.at(i) {
      Some(Some(trace)) -> if standing(now, Some(trace), options, supplied) == Some(Stands) {
        acc.insert(asked.at_or(i, { index: 0 - 1, key: b"" }).index, trace)
      } else { acc },
      _ -> acc,
    })
}

/// What the binding came to, its reach said of the run's tests: a case is reached as its test is.
fn hosted_over(program: Program) -> Hosted / {abort.raise} = {
  let hosted = tester::hosted_of(program.unit.testing, program.unit);
  let reached = set_of(hosted.reaches);
  {
    ..hosted,
    reaches: program.cases.filter(|case: Case| reached.contains(case.entry.test)).map(
      |case: Case| case.index,
    ),
  }
}

/// The run itself, what it establishes, filed, and what it is asked after: a mutation of a green
/// run, and the cause of every failure. `judged` is the tests as a pass is recorded and a failure
/// suspected: a case reaching only what it runs. The binding of `program`'s unit is torn down once
/// its tests ran; the unit stays the caller's to close.
pub fn concluded_run(
  flags: Flags,
  style: Style,
  options: Options,
  program: Program,
  timed: Timed,
  analysis: View,
  judged: View,
  scope: Scope,
  decisions: List<Decision>,
  decided: Decided,
  keyed: Map<Int, Bytes>,
  // The passes refiled under their own keys, and where the run keeps its answer.
  keeps: { refiled: List<Pass>, kept: Option<Keeping> },
  searching: plan::Plan,
  configured: List<Diag>,
  targeted: Option<List<DefInfo>>,
  spent: Spent,
) -> Answer / {process.out[proc], time.elapsed_us, entering::machine.open, entering::machine.enter, entering::machine.unbind, entering::machine.close, ledger.opened, ledger.passes, ledger.seen, ledger.baselines, ledger.bodies, ledger.interfaces, ledger.unfiled, ledger.history, ledger.filed, emit.unit, emit.compiled, shipped.answer, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise, shipped.reached} = {
  let refiled = keeps.refiled;
  let kept = keeps.kept;
  // What the next run answers: this run's notices of its cache and its store are not in it.
  let after = match kept { Some(k) -> k.after, None -> false };
  let asked = {
    plan: searching,
    measuring: options.sim.measure_reduction,
    lanes: match options.jobs { Some(n) -> if n > 0 { Some(n) } else { None }, None -> None },
  };
  let narrowing = narrowed(decisions, decided.search.roots);
  // The head and each group's results are printed as they are known, so a long run shows its
  // progress and its first failure; the document `--json` writes waits for the whole run.
  let shown = !flags.json;
  let width = name_column(program, decided);
  let hosted = hosted_over(program);
  let opening = if shown {
    opening_lines(style, flags, program, decided, opening_of(options, program, hosted))
  } else { [] };
  if shown { printed(opening) };
  let started = time.elapsed_us();
  let done = decided.classes.flat_map(|group: Group| {
    let ran = ran_class(
      group.tests.map(|i: Int| job_of(program, program.unit, i, narrowing, searching)),
      asked,
    );
    if shown {
      printed(result_lines(style, program, ran.map(|d: Done| ran_outcome(analysis, d)), width))
    };
    ran
  });
  let elapsed = time.elapsed_us() - started;
  let h = hashes_of(judged, results::era_digest_of(timed.program.modules));
  let running = set_of(decided.runs);
  let by_test = done.fold(Map::new(), |acc: Map<Int, Done>, d: Done| acc.insert(d.test, d));
  let c: Concluded<Raised> = conclude::concluded(
    conclude_tests(analysis, program),
    h,
    {
      groups: decided.classes.map(|group: Group| group.tests),
      filed: filed(decisions, decided.search).fold(
        Map::new(),
        |acc: Map<Int, List<Bytes>>, e: { index: Int, keys: List<Bytes> }|
          if running.contains(e.index) { acc.insert(e.index, e.keys) } else { acc },
      ),
      codes: keyed.fold(Map::new(), |acc: Map<Int, List<Bytes>>, i: Int, k: Bytes|
        if running.contains(i) { acc.insert(i, [k]) } else { acc }),
      reasons: decisions.fold(Map::new(), |acc: Map<Int, Reason>, d: Decision|
        acc.insert(d.case.index, d.reason)),
      out_of_scope: scope.out,
    },
    if options.no_cache { Map::new() } else { seen_of(h) },
    done.map(conclusion_of),
  );
  let said = if options.no_cache { [] } else {
    history_of(analysis, timed.program.modules, c.filing);
    filing_said(
      ledger.filed({ ..c.filing, passes: c.filing.passes.concat(refiled) }),
      "could not write the test cache: ",
      "the run itself is valid; every test will simply be re-run next time",
    )
  };
  let stored = if after { [] } else { said };
  let tried = mutated(
    timed,
    analysis,
    program,
    ran_of(
      options,
      program,
      analysis,
      h,
      decided,
      hosted,
      c,
      by_test,
      elapsed,
      configured.concat(stored),
    ),
    options,
    asked,
    targeted,
  );
  // Every test the binding serves has run, a mutant's among them; a bisection's mixtures are hermetic.
  let r = { ..tried, handshakes: tester::unbound(program.unit.testing) };
  // After the run is filed, since a pass recorded now is a valid baseline for another's failure.
  let found = diagnosed_all(options, timed, judged, program, c, by_test, r.failures);
  let cause = decided_faults(
    { ..r, failures: found.failures },
    found.benches,
    diagnosing(options),
    tester::begun(options),
  );
  let proved = if options.no_cache || cause.proved.len() == 0 { [] } else {
    filing_said(
      ledger.filed({
        passes: cause.proved.map(|key: Bytes| { key: key, trace: b"" }),
        codes: [],
        records: [],
        seen: [],
        reached: { fns: [], decls: [] },
      }),
      "could not write what the bisection's mixtures proved: ",
      "every verdict stands; the next bisection runs those mixtures again",
    )
  };
  let lazily = if options.no_cache || after { [] } else { ledger.opened() };
  let concluding = time.elapsed_us() - started - elapsed;
  let answer = answered(
    style,
    flags,
    program,
    {
      ..r,
      failures: found.failures,
      warnings: r.warnings.concat(proved).concat(lazily),
      spent: { ..spent, tests_us: elapsed, conclude_us: concluding },
    },
    cause.faults,
    decided,
  );
  match kept {
    Some(k) -> if decided.runs.len() == 0 && answer.code == ok_code() && unwarned(answer)
        && all_cached(decisions, scope) {
      let _ = keep_command(
        flags.paths,
        k.project,
        k.key,
        timed.program,
        bin::encode(
          {
            opening: opening,
            lines: answer.lines,
            errs: answer.errs,
            code: answer.code,
            json: to_string(answer.json),
            passes: k.passes,
          },
          kept_bin(),
        ),
        k.marks,
      );
      ()
    },
    None -> (),
  };
  answer
}

/// What writing to the store had to say, its own failure first.
fn filing_said(f: Filed, unflushed: String, note: String) -> List<Diag> =
  match f.unflushed {
    None -> f.warnings,
    Some(why) -> [diag_of("warning", "W0601", unflushed ++ why, [], [note])].concat(f.warnings),
  }

/// The search a seeded test's key is computed against, as the selector reads one.
pub fn search_of(p: plan::Plan) -> Search / {abort.raise} =
  {
    mode: plan::mode_word(p.mode),
    roots: p.roots.map(|r: U64| Int::of_u64(r)),
    budget: p.budget,
    steps: p.steps,
    path: p.path,
  }

/// The whole plan, as the document's options carry it: every field is in a seeded test's key.
pub fn sim_json(p: plan::Plan, sim: machine::SimulationOptions) -> Json / {abort.raise} =
  object([
    { key: "budget", value: int(p.budget) },
    { key: "measure_reduction", value: Bool(sim.measure_reduction) },
    { key: "mode", value: Str(plan::mode_word(p.mode)) },
    {
      key: "roots",
      value: Array(
        p.roots.map(|r: U64|
          Number(Decimal::of_string(plan::u64_text(r)).unwrap_or(Decimal::of_int(0)))),
      ),
    },
    {
      key: "seed",
      value: match sim.seed {
        Some(text) -> match plan::parse_seed(text) {
          Some(seed) -> Str(plan::seed_text(seed)),
          None -> Null,
        },
        None -> Null,
      },
    },
    { key: "seeds", value: int(p.roots.len()) },
    { key: "steps", value: int(p.steps) },
  ])

// --- Tests ------------------------------------------------------------------

test "the search a seeded test is keyed on is the plan the flags name, and the document says it" {
  let p = machine::sim_plan_of({
    ..machine::no_sim_options(),
    mode: "random",
    roots: Some({ from: 0, to: 3 }),
  });
  assert_eq(search_of(p), { mode: "random", roots: [0, 1, 2], budget: 1, steps: 100000, path: [] });
  let seeded = { ..machine::no_sim_options(), seed: Some("0x10:2") };
  let doc = to_string(with_sim(object([]), sim_json(machine::sim_plan_of(seeded), seeded)));
  assert(doc.contains("\"seed\":\"16:2\""));
  assert(doc.contains("\"mode\":\"once\""));
  assert(doc.contains("\"roots\":[16]"))
}

// --- Footprints over real programs --------------------------------------------

test "a run takes in its root's tests, the library's own tree's among them, and no pulled module's" {
  let library = {
    name: b"std.y",
    src: b"pub fn one() -> Int = 1\ntest \"library\" { assert_eq(one(), 1) }\n",
  };
  let compiler = {
    name: b"compiler.x",
    src: b"pub fn one() -> Int = 1\ntest \"compiler\" { assert_eq(one(), 1) }\n",
  };
  let keys = |user: List<Source>, shipped: List<Source>| {
    let w = match analyse_pulling_std_with(user, shipped, no_rows(), reached: false).out {
      Analysed(w) -> view_of(w),
      Refused(_) -> panic("the fixture checks"),
    };
    scope_of(w, options_from(parsed(["test"]), "/p")).visible.map(|i: Int|
      match test_at(w, i) { Some(t) -> t.key, None -> b"" })
  };
  let program = {
    name: b"m",
    src: b"import std.y\nimport compiler.x\ntest \"own\" { assert_eq(y::one(), x::one()) }\n",
  };
  assert_eq(keys([program], [library, compiler]), [b"m.own"]);
  // A root holding the whole of the library the toolchain lists is the library: its tests are the
  // run's.
  assert_eq(keys([library], [library, compiler]), [b"std.y.library"])
}
