pub type Scope = { visible: List<Int>, filtered_out: Int }

fn in_named(named: Option<List<String>>, t: TestInfo) -> Bool =
  match named { Some(modules) -> modules.contains(String::of_bytes_lossy(t.module)), None -> true }

fn in_scope(
  t: TestInfo,
  filters: List<String>,
  loaded: Set<String>,
  shard: Option<surface::Shard>,
  named: Option<List<String>>,
) -> Bool / {abort.raise} =
  matches_filters(filters, loaded, String::of_bytes_lossy(t.module), String::of_bytes_lossy(t.key))
    && in_shard(shard, t.key)
    && in_named(named, t)

pub fn selection_of(
  list: TestList,
  filters: List<String>,
  shard: Option<surface::Shard>,
  named: Option<List<String>>,
) -> Selection / {abort.raise} = {
  let loaded = module_names(list.names);
  list.tests.fold({ tests: [], filtered_out: 0 }, |found: Selection, t: TestInfo|
    if !in_run(list, t) { found }
    else if in_scope(t, filters, loaded, shard, named)
        || (t.cases && in_named(named, t)
        && could_match_filters(filters, loaded, String::of_bytes_lossy(t.module))) {
      { ..found, tests: found.tests.push(t) }
    } else { { ..found, filtered_out: found.filtered_out + 1 } })
}

pub fn scope_of(
  analysis: TestListing,
  filters: List<String>,
  shard: Option<surface::Shard>,
  named: Option<List<String>>,
) -> Scope / {abort.raise} = {
  let loaded = module_names(analysis.names);
  range(0, analysis.tests.len()).fold(
    { visible: [], filtered_out: analysis.filtered_out },
    |accumulator: Scope, i: Int| {
      let t = analysis.tests.get(i).info;
      if !t.cases || in_scope(t, filters, loaded, shard, named) {
        { ..accumulator, visible: accumulator.visible.push(i) }
      } else { { ..accumulator, filtered_out: accumulator.filtered_out + 1 } }
    },
  )
}

fn in_shard(shard: Option<surface::Shard>, key: Bytes) -> Bool / {abort.raise} =
  match shard {
    None -> true,
    Some(s) -> match blake3(key).u32_at(0) {
      Some(n) -> n % s.count == s.index - 1,
      None -> s.index == 1,
    },
  }

pub type CasedTest = { index: Int, request: ListingRequest }

pub fn over_cases(analysis: TestListing) -> List<CasedTest> =
  analysis.tests.fold(
    { found: [], index: 0 },
    |walked: { found: List<CasedTest>, index: Int }, t: SelectedTest|
      {
        found: match t.identity {
          OverCases(o) ->
            walked.found.push({
              index: walked.index,
              request: { test: t.info.key, listing: o.listing },
            }),
          _ -> walked.found,
        },
        index: walked.index + 1,
      },
  ).found

pub fn list_cases(
  testing: TestRun,
  program: CodeProgram,
  analysis: TestListing,
  test_indices: List<Int>,
) -> Result<Map<Int, Result<List<ListedCase>, KnownFailure>>, List<Diagnostic>> / {entering::machine.open, entering::machine.enter, entering::machine.close, emit.code, emit.libraries, abort.raise} =
  match emit.libraries(
      emit.code(program, roots_of_tests(analysis)),
      testing.options.machine.profile,
    ) {
    Err(diagnostics) -> Err(diagnostics),
    Ok(library) -> match tester::unit_of(
        testing,
        infos_of(analysis),
        program.roots,
        Some(library),
        false,
      ) {
      Err(diagnostics) -> Err(diagnostics),
      Ok(unit) -> {
        let cases = test_indices.fold(
          Map::new(),
          |accumulator: Map<Int, Result<List<ListedCase>, KnownFailure>>, i: Int|
            accumulator.insert(i, tester::cases(unit, i)),
        );
        tester::close_unit(unit);
        Ok(cases)
      },
    },
  }

pub type BuiltTests = { emitted: Emitted, program: CodeProgram }

pub fn run_unit(
  t: Session<TestReading>,
  schema: Option<String>,
) -> Result<BuiltTests, List<Diagnostic>> / {emit.code, EmbeddedFiles, abort.raise} =
  match units::code_program_of(t, t.value.later.reading.rollup) {
    Err(diagnostics) -> Err(diagnostics),
    Ok(program) ->
      Ok({
        emitted: emit.code(
          program,
          roots_of_tests(t.value.listing).concat(match schema {
            Some(name) -> [Named(Bytes::of_string(name))],
            None -> [],
          }),
        ),
        program: program,
      }),
  }

pub type ExpandedTests = { listing: TestListing, entries: List<Entry> }

type ExpansionState = { tests: List<SelectedTest>, entries: List<Entry> }

fn add_starts(
  starts: Map<Bytes, List<Int>>,
  key: Bytes,
  new_starts: Option<List<Int>>,
) -> Map<Bytes, List<Int>> =
  match new_starts {
    None -> starts,
    Some(vs) ->
      starts.insert(
        key,
        List::concat(match starts.get(key) { Some(existing) -> existing, None -> [] }, vs),
      ),
  }

type Claim = { test: Int, case: Option<Int> }

fn claimed(claims: Map<Bytes, List<Claim>>, key: Bytes, by: Claim) -> Map<Bytes, List<Claim>> =
  claims.insert(
    key,
    List::push(match claims.get(key) { Some(existing) -> existing, None -> [] }, by),
  )

fn distinct_labels(
  tests: List<SelectedTest>,
  listings: Map<Int, Result<List<ListedCase>, KnownFailure>>,
) -> Map<Int, Result<List<ListedCase>, KnownFailure>> = {
  let case_key = |t: TestInfo, c: ListedCase| qualify(t.module, Bytes::of_string(c.label));
  let claims = range(0, tests.len()).fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Claim>>, i: Int|
      match tests.at(i).map(|x: SelectedTest| x.info) {
        None -> accumulator,
        Some(t) -> {
          let named = claimed(accumulator, t.key, { test: i, case: None });
          match listings.get(i) {
            Some(Ok(listing)) ->
              range(0, listing.len()).fold(named, |a: Map<Bytes, List<Claim>>, k: Int|
                match listing.at(k) {
                  Some(c) -> claimed(a, case_key(t, c), { test: i, case: Some(k) }),
                  None -> a,
                }),
            _ -> named,
          }
        },
      },
  );
  listings.fold(
    listings,
    |accumulator: Map<Int, Result<List<ListedCase>, KnownFailure>>, i: Int, list_cases: Result<List<ListedCase>, KnownFailure>|
      match ((list_cases, tests.at(i).map(|x: SelectedTest| x.info))) {
        (Ok(listing), Some(t)) -> {
          let first = range(0, listing.len()).fold(None, |found: Option<KnownFailure>, k: Int|
            match ((found, listing.at(k))) {
              (None, Some(c)) ->
                label_clash(tests, i, k, c.label, match claims.get(case_key(t, c)) {
                  Some(all) -> all,
                  None -> [],
                }),
              _ -> found,
            });
          match first { Some(reason) -> accumulator.insert(i, Err(reason)), None -> accumulator }
        },
        _ -> accumulator,
      },
  )
}

fn label_clash(
  tests: List<SelectedTest>,
  i: Int,
  k: Int,
  label: String,
  claims: List<Claim>,
) -> Option<KnownFailure> =
  match tests.at(i).map(|t: SelectedTest| t.info.label) {
    None -> None,
    Some(at) -> match claims.filter(|c: Claim| c.test != i) {
      [other, ..] -> {
        let named = other.case == None;
        Some(
          rejected(
            at,
            match tests.at(other.test).map(|t: SelectedTest| t.info.label) {
              Some(o) ->
                [
                  pointing(o, false, if named { "this test has that name" }
                  else { "a case of this test has that label" }),
                ],
              None -> [],
            },
            "the case at position " ++ k.to_string() ++ " of the table has the label \"" ++ label
              ++ "\", which "
              ++ (if named { "is the name of another test" }
              else { "a case of another test also has" }),
          ),
        )
      },
      [] -> {
        let own = claims.fold([], |at: List<Int>, c: Claim|
          match c.case { Some(n) -> at.push(n), None -> at });
        if own.len() < 2 { None } else {
          Some(
            rejected(
              at,
              [],
              "the cases at positions " ++ places(own) ++ " of the table have the same label, \""
                ++ label
                ++ "\"",
            ),
          )
        }
      },
    },
  }

fn rejected(at: Location, also: List<Label>, message: String) -> KnownFailure =
  {
    status: "failed",
    failure: {
      diagnostic: diagnostic_of(
        Error,
        b"E0105",
        message,
        [pointing(at, true, "this test")].concat(also),
        [
          "each test and each case in a module needs its own label, so none of this test's cases ran",
        ],
      ),
      values: [],
    },
  }

fn pointing(at: Location, primary: Bool, text: String) -> Label =
  label_at(at.module, at.span, primary, Bytes::of_string(text))

fn places(at: List<Int>) -> String =
  match at {
    [a, b] -> a.to_string() ++ " and " ++ b.to_string(),
    [a, b, c] -> a.to_string() ++ ", " ++ b.to_string() ++ " and " ++ c.to_string(),
    [a, b, c, ..more] ->
      a.to_string() ++ ", " ++ b.to_string() ++ ", " ++ c.to_string() ++ " and "
        ++ more.len().to_string()
        ++ " more",
    [a] -> a.to_string(),
    [] -> "",
  }

pub fn expand_cases(
  analysis: TestListing,
  listings: Map<Int, Result<List<ListedCase>, KnownFailure>>,
) -> ExpandedTests / {abort.raise} = {
  let tests = analysis.tests;
  let cases = distinct_labels(tests, listings);
  let plain = range(0, tests.len()).map(|i: Int| entry_of(i, tests.get(i).info.key));
  if cases.len() == 0 { { listing: analysis, entries: plain } } else {
    let walked = range(0, tests.len()).fold(
      { tests: [], entries: [] },
      |accumulator: ExpansionState, i: Int| {
        let t = tests.get(i);
        let whole = plain.get(i);
        match cases.get(i) {
          Some(Ok(listing)) ->
            range(0, listing.len()).fold(accumulator, |a: ExpansionState, k: Int| {
              let c = listing.get(k);
              let key = qualify(t.info.module, Bytes::of_string(c.label));
              {
                tests: a.tests.push({
                  ..t,
                  info: {
                    ..t.info,
                    name: Bytes::of_string(c.label),
                    key: key,
                    index: a.tests.len(),
                  },
                  identity: CaseOf({ parent: t.info.key, run: case_hash(run_hash(t), c.identity) }),
                }),
                entries: a.entries.push({ ..whole, case: Some({ at: k, identity: c.identity }) }),
              }
            }),
          other ->
            {
              ..accumulator,
              tests: accumulator.tests.push({
                ..t,
                info: { ..t.info, index: accumulator.tests.len() },
              }),
              entries: accumulator.entries.push(match other {
                Some(Err(reason)) -> { ..whole, known_failure: Some(reason) },
                _ -> whole,
              }),
            },
        }
      },
    );
    { listing: { ..analysis, tests: walked.tests }, entries: walked.entries }
  }
}

pub type ExpandedProgram = { analysis: ProgramListing, run_analysis: ProgramListing }

pub fn expanded_program(
  whole: ProgramListing,
  positions: Map<Int, Int>,
  over: ExpandedTests,
) -> ExpandedProgram = {
  let placed = over.listing.tests.fold([], |found: List<HashedTest>, listed: SelectedTest| {
    let t = listed.info;
    match positions.get(t.at.module) {
      Some(at) ->
        found.push({
          info: { ..t, at: { ..t.at, module: at }, label: { ..t.label, module: at } },
          hash: run_hash(listed),
        }),
      None -> found,
    }
  });
  let hashes = over.listing.tests.fold(Map::new(), |found: Map<Bytes, Bytes>, t: SelectedTest|
    found.insert(t.info.key, run_hash(t)));
  let parents = over.listing.tests.fold(Map::new(), |found: Map<Bytes, Bytes>, t: SelectedTest|
    match t.identity { CaseOf(c) -> found.insert(t.info.key, c.parent), _ -> found });
  let refs = whole.hashes.refs;
  let starts = |picked: Map<Bytes, List<Int>>|
    parents.fold(refs.items, |found: Map<Bytes, List<Int>>, key: Bytes, parent: Bytes|
      add_starts(found, key, picked.get(parent)));
  let with_starts = |items: Map<Bytes, List<Int>>|
    {
      ..whole,
      hashes: { ..whole.hashes, tests: hashes, refs: { ..refs, items: items } },
      checked: { ..whole.checked, tests: placed.map(|hashed: HashedTest| hashed.info) },
      tests: placed,
    };
  { analysis: with_starts(starts(refs.items)), run_analysis: with_starts(starts(refs.cases)) }
}

pub fn codes_of(
  analysis: TestListing,
  emitted: Emitted,
  entries: List<Entry>,
) -> Map<Int, Bytes> / {abort.raise} = {
  let ran = closure_codes(emitted.code);
  let code_of = |k: Int|
    match test_root_at(analysis, k) { Some(r) -> ran.get(root_name(r)), None -> None };
  range(0, entries.len()).fold(Map::new(), |accumulator: Map<Int, Bytes>, i: Int|
    match entries.at(i) {
      None -> accumulator,
      Some(entry) -> match code_of(entry.test) {
        None -> accumulator,
        Some(code) ->
          accumulator.insert(i, match entry.case {
            Some(c) -> case_hash(code, c.identity),
            None -> code,
          }),
      },
    })
}

pub fn passed_by_code<| e>(
  decisions: List<Decision>,
  keyed: Map<Int, Bytes>,
  passes_holding: (Map<Bytes, List<RecordedRead>>) -> Map<Bytes, List<RecordedRead>> / {abort.raise | e},
) -> Map<Int, CodePass> / {result_cache.code_passes, abort.raise | e} = {
  let queries = code_keys_to_query(decisions, keyed);
  let held = if queries.len() == 0 { Map::new() } else {
    passes_holding(result_cache.code_passes(queries.map(|a: { index: Int, key: Bytes }| a.key)))
  };
  queries.fold(Map::new(), |accumulator: Map<Int, CodePass>, a: { index: Int, key: Bytes }|
    match held.get(a.key) {
      Some(reads) -> accumulator.insert(a.index, { code: a.key, reads: reads }),
      None -> accumulator,
    })
}

fn program_binding_report(program: Program) -> BindingReport / {abort.raise} = {
  let hosted = tester::binding_report_of(program.unit.testing, program.unit);
  let host_tests = Set::of_list(hosted.host_test_indices);
  {
    ..hosted,
    host_test_indices: program.cases.filter(|case: Case| host_tests.contains(case.entry.test)).map(
      |case: Case| case.index,
    ),
  }
}

pub fn concluded_run(
  flags: Flags,
  style: Style,
  options: Options,
  program: Program,
  t: Session<TestReading>,
  over: ExpandedTests,
  scope: Scope,
  decisions: List<Decision>,
  decided: RunDecision,
  keyed: Map<Int, Bytes>,
  kept_passes: List<KeptPass>,
  rolled: List<Pass>,
  searching: plan::Plan,
  configured: List<Diagnostic>,
  spent: TimeSpent,
) -> CommandOutput / {project_store::Databases, process.out[proc], time.elapsed_us, entering::machine.enter, entering::machine.report, entering::machine.unbind, result_cache.interrupted, result_cache.journal, result_cache.started, result_cache.finished, result_cache.open_warnings, result_cache.known, result_cache.baselines, result_cache.texts, result_cache.unstored, result_cache.has_records, result_cache.history, result_cache.store_results, shipped.read_pack, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], ProjectFiles, fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise} = {
  let analysis = over.listing;
  let width = name_column(program, decided);
  let era = results::snapshot_digest_of(t.value.records);
  let running = Set::of_list(decided.runs);
  let concluding = conclude_tests(analysis, program);
  let chosen = {
    groups: decided.classes.map(|group: Group| group.tests),
    recorded: pass_keys_by_test(decisions, decided.search).fold(
      Map::new(),
      |accumulator: Map<Int, List<Bytes>>, e: { index: Int, keys: List<Bytes> }|
        if running.contains(e.index) { accumulator.insert(e.index, e.keys) } else { accumulator },
    ),
    codes: keyed.fold(Map::new(), |accumulator: Map<Int, List<Bytes>>, i: Int, k: Bytes|
      if running.contains(i) { accumulator.insert(i, [k]) } else { accumulator }),
    reasons: decisions.fold(Map::new(), |accumulator: Map<Int, Reason>, d: Decision|
      accumulator.insert(d.case.index, d.reason)),
  };
  let search_options = {
    plan: searching,
    measuring: options.sim.measure_reduction,
    lanes: match options.jobs { Some(n) -> if n > 0 { Some(n) } else { None }, None -> None },
    reporting: { style: style, width: width, to_stderr: flags.json },
    journaling: journaling_of(analysis, concluding, era, chosen, result_cache.journal()),
  };
  let narrowing = narrowed_searches(decisions, decided.search.roots);
  let crashes = crashes_of(analysis, result_cache.interrupted());
  let hosted = program_binding_report(program);
  printed(opening_lines(style, flags, program, decided, opening_of(options, program, hosted)));
  let started = time.elapsed_us();
  let done = decided.classes.flat_map(|group: Group| {
    let ran = run_class(
      group.tests.map(|i: Int| with_crash(job_of(program, i, narrowing, searching), crashes)),
      search_options,
    );
    printed(
      detailed_result_lines(
        style,
        program,
        ran.map(|d: JobResult| job_outcome(analysis, d)),
        width,
      ),
    );
    ran
  });
  let elapsed = time.elapsed_us() - started;
  let by_test = done.fold(Map::new(), |accumulator: Map<Int, JobResult>, d: JobResult|
    accumulator.insert(d.test, d));
  let failed_tests = concluding.filter(|t: conclude::Test|
    match by_test.get(t.index) { Some(d) -> d.failure != None, None -> false });
  let failed = failed_tests.map(|t: conclude::Test| t.key);
  let view = if failed.len() == 0 && !options.coverage { None } else {
    Some(
      view_of_imports(t, program.places, if options.coverage { names_of(t.modules) } else {
        failed_tests.fold([], |found: List<Bytes>, c: conclude::Test|
          match analysis.tests.at(c.index) {
            Some(listed) -> found.push(listed.info.module),
            None -> found,
          })
      }),
    )
  };
  let expanded = view.map(|v: TestsView| expanded_program(v.whole, positions_in(v), over));
  let h = match expanded { Some(e) -> hashes_of(e.run_analysis), None -> no_hashes() };
  let seen = seen_of(h, failed);
  let c: Conclusion<RuntimeDiagnostic> = conclude::conclude_run(
    concluding,
    era,
    chosen,
    |key: Bytes| changes_of_test(h, seen, key),
    done.map(conclusion_of),
  );
  let passed = store_run(
    t,
    analysis,
    program.places,
    c.store_update,
    done.len() > 0 && analysis.filtered_out == 0
      && conclude::undecided(concluding, chosen, c.outcomes).len() == 0,
  );
  let by_code = conclude::kept_update(concluding, era, kept_passes);
  let cache_warnings = result_cache.store_results(
    {
      passes: c.store_update.passes.concat(by_code.passes).concat(rolled),
      code_passes: c.store_update.code_passes,
      records: c.store_update.records.concat(by_code.records),
    },
    passed,
  );
  let r = {
    ..run_report_of(options, program, analysis, h, if options.coverage { expanded.map(|e: ExpandedProgram| coverage(e.analysis)) } else { None }, decided, hosted, c, by_test, elapsed, configured.concat(cache_warnings)),
    handshakes: tester::unbind(program.unit.testing),
  };
  let found = diagnosed_all(
    match ((view, expanded)) {
      (Some(v), Some(e)) -> Some({ whole: e.run_analysis, places: v.places }),
      _ -> None,
    },
    c,
    r.failures,
  );
  let lazily = result_cache.open_warnings();
  let conclude_time = time.elapsed_us() - started - elapsed;
  test_output(
    style,
    flags,
    program,
    {
      ..r,
      warnings: r.warnings.concat(lazily),
      spent: { ..spent, tests_us: elapsed, conclude_us: conclude_time },
    },
    found.faults,
    match view {
      Some(v) ->
        found.diffs.map(|d: ChangeDiff|
          { ..d, at: d.at.map(|l: Location| { ..l, module: module_in_program(v, l.module) }) }),
      None -> found.diffs,
    },
    decided,
  )
}

pub fn search_of(p: plan::Plan, profile: cc::Profile) -> Search / {abort.raise} =
  {
    mode: plan::mode_word(p.mode),
    roots: p.roots.map(|r: U64| Int::of_u64(r)),
    budget: p.budget,
    steps: p.steps,
    path: p.path,
    profile: profile,
  }

pub fn sim_json(p: plan::Plan, sim: machine::SimulationOptions) -> Json / {abort.raise} =
  object([
    { key: "budget", value: int(p.budget) },
    { key: "measure_reduction", value: Bool(sim.measure_reduction) },
    { key: "mode", value: Str(plan::mode_word(p.mode)) },
    {
      key: "roots",
      value: Array(
        p.roots.map(|r: U64|
          Number(Decimal::of_string(plan::u64_text(r)).unwrap_or(Decimal::of_int(0)))),
      ),
    },
    {
      key: "seed",
      value: match sim.seed {
        Some(text) -> match plan::parse_seed(text) {
          Some(seed) -> Str(plan::seed_text(seed)),
          None -> Null,
        },
        None -> Null,
      },
    },
    { key: "seeds", value: int(p.roots.len()) },
    { key: "steps", value: int(p.steps) },
  ])

test "`sim_plan_of` turns the search flags into a search, and the JSON report shows the seed, mode and root seeds" {
  let p = machine::sim_plan_of({
    ..machine::no_sim_options,
    mode: "random",
    roots: Some({ from: 0, to: 3 }),
  });
  assert_eq(search_of(p, cc::release()), {
    mode: "random",
    roots: [0, 1, 2],
    budget: 1,
    steps: 100000,
    path: [],
    profile: cc::release(),
  });
  let seeded = { ..machine::no_sim_options, seed: Some("0x10:2") };
  let doc = to_string(with_sim(object([]), sim_json(machine::sim_plan_of(seeded), seeded)));
  assert(doc.contains("\"seed\":\"16:2\""));
  assert(doc.contains("\"mode\":\"once\""));
  assert(doc.contains("\"roots\":[16]"))
}

test "a run selects the tests of the module it was started on, even a library's, but not those of modules it imports" {
  let library = {
    name: b"std.y",
    source_text: b"pub fn one() -> Int = 1\ntest \"library\" { assert_eq(one(), 1) }\n",
  };
  let compiler = {
    name: b"compiler.x",
    source_text: b"pub fn one() -> Int = 1\ntest \"compiler\" { assert_eq(one(), 1) }\n",
  };
  let keys = |user: List<Source>, shipped: List<Source>| {
    let w = match listed_over(in_memory(user, shipped)) {
      Listed(listing) -> test_list_of_program(listing),
      ListingRejected(_) -> panic("the fixture program was rejected by the checker"),
    };
    selection_of(w, [], None, None).tests.map(|t: TestInfo| t.key)
  };
  let program = {
    name: b"m",
    source_text: b"import std.y\nimport compiler.x\ntest \"own\" { assert_eq(y::one(), x::one()) }\n",
  };
  assert_eq(keys([program], [library, compiler]), [b"m.own"]);
  assert_eq(keys([library], [library, compiler]), [b"std.y.library"])
}
