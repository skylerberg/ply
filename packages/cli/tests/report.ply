pub type PrintedEffect = { entry: Effect, text: String }

pub type Rejection = { diagnostics: List<Diagnostic>, places: List<SourceText> }

pub type Phases = { read_us: Int, front_end_us: Int, write_back_us: Int }

pub type ModuleView = { name: String, file: String }

pub type Entry = {
  test: Int,
  key: Bytes,
  case: Option<SelectedCase>,
  unlisted: Option<ListingFailure>,
}

pub type Case = {
  index: Int,
  entry: Entry,
  key: String,
  name: String,
  module: String,
  nondet: Bool,
  hash: Option<String>,
  effects: String,
  listed: List<PrintedEffect>,
  seeded: Bool,
}

pub type RunDecision = {
  search: Search,
  sim: Json,
  reasons: Map<Int, Reason>,
  pending_seed_counts: Map<Int, Int>,
  runs: List<Int>,
  running: Map<Int, Bool>,
  at: Map<Int, Int>,
  classes: List<Group>,
  parallelism: Parallelism,
}

fn reason_of(decided: RunDecision, index: Int) -> Reason =
  match decided.reasons.get(index) { Some(reason) -> reason, None -> Cached }

fn runs_test(decided: RunDecision, index: Int) -> Bool = decided.running.contains(index)

fn changed_read_of(decided: RunDecision, index: Int) -> Option<String> =
  match reason_of(decided, index) { Changed(what) -> Some(what), _ -> None }

fn selected_count(program: Program, decided: RunDecision) -> Int =
  program.cases.filter(|case: Case| runs_test(decided, case.index)).len()

pub fn cached_count(program: Program, decided: RunDecision) -> Int =
  program.cases.len() - selected_count(program, decided)

fn by_code_count(program: Program, decided: RunDecision) -> Int =
  program.cases.filter(|case: Case| reason_of(decided, case.index) == SameCode).len()

fn group_of(decided: RunDecision, index: Int) -> Option<Int> = decided.at.get(index)

fn pending_seeds(decided: RunDecision, index: Int) -> Int =
  match decided.pending_seed_counts.get(index) { Some(count) -> count, None -> 0 }

pub fn group_of_class(analysis: CheckedProgram, class: List<Int>) -> Group / {abort.raise} =
  {
    tests: class,
    effects: outside_effects_text(
      canonical(
        class.fold([], |accumulator: List<types::Effect>, i: Int|
          match test_at(analysis, i) {
            Some(t) -> accumulator.concat(t.effects),
            None -> accumulator,
          }),
      ),
    ),
  }

fn effects_of(case: Case) -> List<Effect> =
  case.listed.map(|print_lines: PrintedEffect| print_lines.entry)

fn shared_texts(case: Case) -> List<String> =
  case.listed.filter(|print_lines: PrintedEffect|
    cross_test_effects([print_lines.entry]).len() > 0).map(|print_lines: PrintedEffect|
    print_lines.text)

pub fn conflicting_effects_text(case: Case) -> String =
  "{" ++ String::join(shared_texts(case), ", ") ++ "}"

pub fn classes_of(program: Program, runs: List<Int>) -> List<List<Int>> / {abort.raise} =
  group_by_conflict(scheduled_of(program, set_of(runs)))

fn scheduled_of(program: Program, running: Map<Int, Bool>) -> List<ScheduledTest> =
  program.cases.filter(|case: Case| running.contains(case.index)).map(|case: Case|
    { index: case.index, contended_effects: cross_test_effects(effects_of(case)) })

fn host_use_of(host_case_indices: List<Int>, case: Case) -> { listed: List<Effect>, host: Bool } =
  { listed: effects_of(case), host: covers(host_case_indices, case.index) }

pub fn counts_of(program: Program, host_case_indices: List<Int>) -> Counts =
  counts(program.cases.map(|case: Case| host_use_of(host_case_indices, case)))

pub fn run_decision_of(
  program: Program,
  decisions: List<Decision>,
  search: Search,
  sim: Json,
  groups: List<Group>,
  classes: List<List<Int>>,
) -> RunDecision / {abort.raise} = {
  let runs = to_run(decisions).filter(|i: Int| case_of(program, i) != None);
  let running = set_of(runs);
  {
    search: search,
    sim: sim,
    reasons: decisions.fold(Map::new(), |accumulator: Map<Int, Reason>, x: Decision|
      if accumulator.contains(x.case.index) { accumulator }
      else { accumulator.insert(x.case.index, x.reason) }),
    pending_seed_counts: decisions.fold(Map::new(), |accumulator: Map<Int, Int>, x: Decision|
      if !x.case.seeded || accumulator.contains(x.case.index) { accumulator } else {
        accumulator.insert(x.case.index, match x.case.pending_seeds {
          Some(roots) -> roots.len(),
          None -> search.roots.len(),
        })
      }),
    runs: runs,
    running: running,
    at: class_numbers(classes),
    classes: groups,
    parallelism: parallelism(
      program.cases.map(|case: Case| cross_test_effects(effects_of(case))),
      scheduled_of(program, running),
      classes,
    ),
  }
}

fn class_numbers(classes: List<List<Int>>) -> Map<Int, Int> =
  range(0, classes.len()).fold(Map::new(), |accumulator: Map<Int, Int>, i: Int|
    classes.at_or(i, []).fold(accumulator, |a: Map<Int, Int>, index: Int|
      if a.contains(index) { a } else { a.insert(index, i) }))

pub type Group = { tests: List<Int>, effects: String }

pub type Parallelism = {
  total: Int,
  conflict_free: Int,
  shared: Int,
  scheduled: Int,
  groups: Int,
  shared_groups: Int,
}

pub type Program = {
  root: String,
  files: List<String>,
  places: List<SourceText>,
  modules: List<ModuleView>,
  loaded_from_cache: Bool,
  phases: Phases,
  reused_members: List<Member>,
  declared: Int,
  cases: List<Case>,
  positions: Map<Int, Int>,
  filtered_out: Int,
  warnings: List<Diagnostic>,
  options: Json,
  cache_stamp: Option<String>,
  unit: TestUnit,
}

pub type Backend = {
  name: String,
  fragment: Int,
  entered: Int,
  units: Option<Int>,
  load_nanos: Option<Int>,
}

pub type Cost = { explored: Int, bounded: Bool, rendered: String }

pub type SearchSummary = {
  explored: Int,
  exhaustive: Bool,
  exhausted: Bool,
  clockless: Option<Cost>,
  naive: Option<Cost>,
  reduction_tenths: Option<Int>,
  steps: Int,
  virtual_time_ns: Int,
  failing_seed: Option<String>,
}

pub type Outcome = {
  index: Int,
  name: String,
  hash: Option<String>,
  duration_us: Int,
  status: String,
  diagnostic: Option<RuntimeDiagnostic>,
  search: Option<SearchSummary>,
  cached: Option<Bool>,
  performs: Int,
}

pub type Site = { task: String, definition: Option<String>, access: String, at: Option<ModuleSpan> }

pub type Race = { left: Site, right: Site, step: Int }

pub type Failed = {
  key: String,
  name: String,
  diagnostic: RuntimeDiagnostic,
  internal_error: Bool,
  changes: List<{ name: String, hash: Option<String> }>,
  unchanged: Bool,
  seed: Option<String>,
  race: Option<Race>,
  module: Option<String>,
  test_hash: Option<String>,
  nondet: Option<Bool>,
  status: Option<String>,
  declared: Option<List<String>>,
}

pub type Fault = {
  key: String,
  name: String,
  diagnostic: RuntimeDiagnostic,
  internal_error: Bool,
  changes: List<RankedChange>,
  unchanged: Bool,
  seed: Option<String>,
  race: Option<Race>,
  replay: Option<String>,
  module: Option<String>,
  test_hash: Option<String>,
  nondet: Option<Bool>,
  status: Option<String>,
  declared: Option<List<String>>,
}

pub type Summary = { passed: Int, failed: Int, timed_out: Int, cached: Int, duration_us: Int }

pub type SimulationSummary = {
  simulated: Int,
  total: Int,
  seeds: Int,
  interleavings: Int,
  exhaustive: Int,
  exhausted: Int,
  failed: Int,
}

pub type RunReport = {
  operations: Int,
  digest: String,
  handshakes: List<String>,
  hosts: Json,
  tests_using_host: List<Int>,
  workers: Int,
  backend: Option<Backend>,
  results: List<Outcome>,
  failures: List<Failed>,
  summary: Summary,
  simulation: SimulationSummary,
  unbound_pass_diagnostics: List<Diagnostic>,
  warnings: List<Diagnostic>,
  coverage: Option<Coverage>,
  spent: TimeSpent,
}

pub type TimeSpent = {
  before_us: Int,
  promises_us: Int,
  store_us: Int,
  selection_us: Int,
  handoff_us: Int,
  unit_us: Int,
  bind_us: Int,
  tests_us: Int,
  conclude_us: Int,
}

pub fn no_time_spent() -> TimeSpent =
  {
    before_us: 0,
    promises_us: 0,
    store_us: 0,
    selection_us: 0,
    handoff_us: 0,
    unit_us: 0,
    bind_us: 0,
    tests_us: 0,
    conclude_us: 0,
  }

fn opt_bool(v: Option<Bool>) -> Json = match v { Some(b) -> Bool(b), None -> Null }

fn covers(xs: List<Int>, wanted: Int) -> Bool = xs.filter(|x: Int| x == wanted).len() > 0

fn no_group() -> Group = { tests: [], effects: "" }

fn ms_tenths(us: Int) -> String = fixed_point((us + 50) / 100, 1)

fn ms_hundredths(us: Int) -> String = fixed_point((us + 5) / 10, 2)

fn ms_thousandths(us: Int) -> String = fixed_point(us, 3)

fn secs_hundredths(us: Int) -> String = fixed_point((us + 5000) / 10000, 2)

fn ns_as_ms_tenths(ns: Int) -> String = fixed_point((ns + 50000) / 100000, 1)

fn share(part: Int, total: Int) -> String =
  fixed_point(if total == 0 { 0 } else { part * 1000 / total }, 1).pad_left(5, " ") ++ "%"

fn milliseconds_json(us: Int) -> Json =
  Number(Decimal::of_string(ms_thousandths(us)).unwrap_or(Decimal::of_int(0)))

pub fn display_of(program: Program, case: Case) -> String =
  if program.modules.len() > 1 { case.key } else { case.name }

fn short_of(hash: Option<String>) -> String / {abort.raise} =
  match hash { Some(h) -> h.slice(0, 12), None -> "-".repeat(12) }

fn dim_place(
  style: Style,
  places: List<SourceText>,
  a: Option<ModuleSpan>,
) -> String / {abort.raise} =
  match a {
    None -> "",
    Some(spot) -> match location_text(places, spot) {
      Some(text) -> "   " ++ dim(style, text),
      None -> "",
    },
  }

pub fn primary_of(diagnostic: Diagnostic) -> Option<Label> =
  diagnostic.labels.fold(None, |accumulator: Option<Label>, label: Label|
    match accumulator {
      Some(_) -> accumulator,
      None -> if label.primary { Some(label) } else { None },
    })

fn label_at(label: Label) -> ModuleSpan =
  { module: label.module, start: label.start, end: label.end }

fn location_json(places: List<SourceText>, diagnostic: Diagnostic) -> Json / {abort.raise} =
  match primary_of(diagnostic) {
    None -> Null,
    Some(l) -> editor_location_json(places, label_at(l)),
  }

fn reason_key(reason: String) -> String = String::join(reason.split(" "), "_")

fn reason_text(reason: String) -> String =
  if reason == "new" { "this hash has never passed, so nothing is known about it" }
  else if reason == "changed" {
    "something the test read when it last passed has changed since, so that result can no longer be trusted"
  } else if reason == "previous failure" {
    "the last cached result is a failure, and a failure is never reused"
  } else if reason == "cached" {
    "this exact hash already passed; re-running cannot reveal anything new"
  } else if reason == "same code" {
    "this hash is new, but the code it compiles to already passed; re-running cannot reveal anything new"
  } else { "no hash was produced, so no cached result can be trusted" }

pub fn isolated_as(host_case_indices: List<Int>, case: Case) -> String =
  isolation_word(isolation_of(host_use_of(host_case_indices, case)))

pub type Opening = { operations: Int, digest: String, tests_using_host: List<Int>, workers: Int }

fn workers_of(options: Options, hosted: BindingReport) -> Int =
  match options.jobs { Some(n) -> if n > 0 { n } else { hosted.cores }, None -> hosted.cores }

pub fn opening_of(options: Options, program: Program, hosted: BindingReport) -> Opening =
  {
    operations: hosted.operations,
    digest: hosted.digest,
    tests_using_host: hosted.host_test_indices.filter(|i: Int| case_of(program, i) != None),
    workers: workers_of(options, hosted),
  }

fn selected_line(style: Style, program: Program, decided: RunDecision) -> String =
  indent() ++ bold(style, "selected") ++ " "
    ++ bold(style, selected_count(program, decided).to_string())
    ++ " of "
    ++ program.cases.len().to_string()
    ++ " ("
    ++ cached_count(program, decided).to_string()
    ++ " cached"
    ++ (match by_code_count(program, decided) { 0 -> "", n -> ", " ++ n.to_string() ++ " by code" })
    ++ ")"

fn group_line(decided: RunDecision, workers: Int) -> List<String> / {abort.raise} =
  if decided.classes.len() == 0 { [] } else {
    [indent() ++ count_of(decided.classes.len(), "group") ++ " · " ++ count_of(workers, "worker")]
  }

fn isolated_line(style: Style, c: Counts) -> List<String> / {abort.raise} =
  if c.total == 0 { [] } else {
    let contending = if c.shared == 0 { "" }
    else { dim(style, " · " ++ count_of(c.shared, "test") ++ " may conflict") };
    [
      indent() ++ bold(style, c.isolated.to_string()) ++ " of " ++ c.total.to_string()
        ++ bold(style, " tests are isolated")
        ++ contending,
    ]
  }

pub fn binding_lines(style: Style, o: Opening, c: Counts) -> List<String> / {abort.raise} =
  if o.operations == 0 { [] } else {
    [
      indent() ++ bold(style, c.host.to_string()) ++ " of " ++ c.total.to_string()
        ++ bold(style, " tests use the host")
        ++ " · "
        ++ dim(style, "each result is cached with what the test read from the host"),
      indent() ++ dim(style, "host: " ++ count_of(o.operations, "operation") ++ " · " ++ o.digest),
    ]
  }

pub fn handshake_lines(style: Style, report: RunReport) -> List<String> =
  report.handshakes.map(|line: String| indent() ++ dim(style, line))

pub fn simulation_line(style: Style, report: RunReport) -> List<String> / {abort.raise} =
  if report.simulation.simulated == 0 { [] } else {
    let c = report.simulation;
    let head = "simulated: " ++ c.simulated.to_string() ++ " of " ++ c.total.to_string() ++ " · "
      ++ count_of(c.interleavings, "interleaving");
    let thorough = if c.exhaustive == 0 { head }
    else { head ++ " · " ++ c.exhaustive.to_string() ++ " exhaustive" };
    let spent = if c.exhausted == 0 { thorough }
    else { thorough ++ " · " ++ c.exhausted.to_string() ++ " budget spent, not cached" };
    [indent() ++ bold(style, spent)]
  }

fn compiled_line(style: Style, b: Backend) -> List<String> =
  match b.units {
    None -> [],
    Some(units) ->
      [
        indent()
          ++ dim(
            style,
            "loaded " ++ units.to_string() ++ " unit(s) in "
              ++ ns_as_ms_tenths(match b.load_nanos { Some(n) -> n, None -> 0 })
              ++ "ms",
          ),
      ],
  }

fn backend_lines(style: Style, report: RunReport) -> List<String> =
  match report.backend {
    None -> [],
    Some(b) ->
      [
        indent() ++ bold(style, "backend") ++ " " ++ bold(style, b.name) ++ " · "
          ++ b.entered.to_string()
          ++ " tests run · "
          ++ b.fragment.to_string()
          ++ " definitions in the compiled program",
      ].concat(
        compiled_line(style, b),
      ),
  }

fn bypass_lines(style: Style, flags: Flags) -> List<String> =
  if !flags.no_cache { [] }
  else { [indent() ++ dim(style, "--no-cache: results were neither read nor recorded")] }

fn filtered_lines(style: Style, filtered_out: Int) -> List<String> / {abort.raise} =
  if filtered_out == 0 { [] }
  else { [indent() ++ dim(style, "--filter skipped " ++ count_of(filtered_out, "test"))] }

fn head_lines(
  style: Style,
  flags: Flags,
  program: Program,
  decided: RunDecision,
  o: Opening,
) -> List<String> / {abort.raise} = {
  let c = counts_of(program, o.tests_using_host);
  [selected_line(style, program, decided)].concat(group_line(decided, o.workers)).concat(
    isolated_line(style, c),
  ).concat(
    binding_lines(style, o, c),
  ).concat(
    bypass_lines(style, flags),
  ).concat(
    filtered_lines(style, program.filtered_out),
  )
}

pub fn opening_lines(
  style: Style,
  flags: Flags,
  program: Program,
  decided: RunDecision,
  o: Opening,
) -> List<String> / {abort.raise} =
  head_lines(style, flags, program, decided, o).concat(if flags.explain {
    explain_lines(style, program, o.tests_using_host, decided)
  } else { [] }).concat(if decided.classes.len() == 0 { [] } else { [""] })

fn run_lines(style: Style, report: RunReport) -> List<String> / {abort.raise} =
  handshake_lines(style, report).concat(backend_lines(style, report)).concat(
    simulation_line(style, report),
  )

type Phase = { label: String, us: Int }

fn ordered(rows: List<Phase>) -> List<Phase> =
  rows.fold([], |accumulator: List<Phase>, p: Phase|
    accumulator.filter(|q: Phase| q.us >= p.us).push(p).concat(
      accumulator.filter(|q: Phase| q.us < p.us),
    ))

fn phase_rows(phases: Phases) -> List<Phase> =
  ordered([
    { label: "read", us: phases.read_us },
    { label: "front", us: phases.front_end_us },
    { label: "write back", us: phases.write_back_us },
  ])

fn phase_total(phases: Phases) -> Int = phases.read_us + phases.front_end_us + phases.write_back_us

fn phase_line(style: Style, phase: Phase, total: Int) -> String =
  indent() ++ "  " ++ phase.label.pad_right(11, " ") ++ " "
    ++ ms_hundredths(phase.us).pad_left(8, " ")
    ++ "ms "
    ++ dim(style, share(phase.us, total))

pub fn phase_lines(style: Style, phases: Phases) -> List<String> = {
  let total = phase_total(phases);
  ["", indent() ++ bold(style, "front-end time")].concat(
    phase_rows(phases).map(|phase: Phase| phase_line(style, phase, total)),
  ).concat([
    indent() ++ "  " ++ "total".pad_right(11, " ") ++ " " ++ ms_hundredths(total).pad_left(8, " ")
      ++ "ms",
  ])
}

fn run_rows(phases: Phases, x: TimeSpent) -> List<Phase> =
  [
    { label: "before", us: x.before_us },
    { label: "load", us: phase_total(phases) },
    { label: "promises", us: x.promises_us },
    { label: "store", us: x.store_us },
    { label: "selection", us: x.selection_us },
    { label: "handoff", us: x.handoff_us },
    { label: "unit", us: x.unit_us },
    { label: "bind", us: x.bind_us },
    { label: "tests", us: x.tests_us },
    { label: "conclude", us: x.conclude_us },
  ]

pub fn run_total(phases: Phases, x: TimeSpent) -> Int =
  run_rows(phases, x).fold(0, |n: Int, phase: Phase| n + phase.us)

pub fn run_phase_lines(style: Style, phases: Phases, x: TimeSpent) -> List<String> = {
  let total = run_total(phases, x);
  ["", indent() ++ bold(style, "run time")].concat(
    ordered(run_rows(phases, x)).map(|phase: Phase| phase_line(style, phase, total)),
  ).concat([
    indent() ++ "  " ++ "total".pad_right(11, " ") ++ " " ++ ms_hundredths(total).pad_left(8, " ")
      ++ "ms",
  ])
}

fn run_phases_json(phases: Phases, x: TimeSpent) -> Json =
  object(
    run_rows(phases, x).map(|phase: Phase|
      { key: phase.label, value: milliseconds_json(phase.us) }).push({
      key: "total",
      value: milliseconds_json(run_total(phases, x)),
    }),
  )

fn explain_effects(isolation: String, case: Case) -> String =
  if isolation == "isolated" { "" } else { " " ++ conflicting_effects_text(case) }

fn case_line(
  style: Style,
  program: Program,
  host_case_indices: List<Int>,
  case: Case,
  decided: RunDecision,
) -> String / {abort.raise} = {
  let isolation = isolated_as(host_case_indices, case);
  let reason = reason_word(reason_of(decided, case.index));
  let verb = if runs_test(decided, case.index) { bold(style, "run ") } else { dim(style, "skip") };
  indent() ++ verb ++ " " ++ dim(style, short_of(case.hash)) ++ " " ++ reason.pad_right(16, " ")
    ++ " "
    ++ display_of(program, case).pad_right(40, " ")
    ++ " "
    ++ dim(
      style,
      "isolation: " ++ isolation ++ explain_effects(isolation, case)
        ++ (if case.seeded { " · searched" } else { "" })
        ++ (match changed_read_of(decided, case.index) {
          Some(what) -> " · moved: " ++ what,
          None -> "",
        }),
    )
}

fn key_lines(style: Style, program: Program) -> List<String> / {abort.raise} = {
  let recorded = match program.cache_stamp {
    Some(stamp) ->
      "a result is cached under the test's hash and the runtime version " ++ short_of(Some(stamp))
        ++ ", and under the code the test ran together with the values it read from the system",
    None -> "nothing is cached: `--no-cache` reads and writes no cache entries",
  };
  ["", indent() ++ dim(style, "key"), indent() ++ "  " ++ dim(style, recorded)]
}

fn reasons_seen(program: Program, decided: RunDecision) -> List<String> =
  program.cases.fold([], |accumulator: List<String>, case: Case| {
    let reason = reason_word(reason_of(decided, case.index));
    if accumulator.contains(reason) { accumulator } else { accumulator.push(reason) }
  })

fn reason_lines(style: Style, program: Program, decided: RunDecision) -> List<String> = {
  let seen = reasons_seen(program, decided);
  if seen.len() == 0 { [] } else {
    ["", indent() ++ dim(style, "why")].concat(
      seen.map(|reason: String|
        indent() ++ "  " ++ reason.pad_right(16, " ") ++ " " ++ dim(style, reason_text(reason))),
    )
  }
}

fn remaining_seeds_line(
  style: Style,
  program: Program,
  case: Case,
  decided: RunDecision,
) -> List<String> / {abort.raise} =
  if pending_seeds(decided, case.index) == decided.search.roots.len() { [] } else {
    [
      indent() ++ "  "
        ++ dim(
          style,
          display_of(program, case) ++ ": " ++ pending_seeds(decided, case.index).to_string()
            ++ " of "
            ++ count_of(decided.search.roots.len(), "seed")
            ++ " still owed; the rest already passed on their own",
        ),
    ]
  }

fn search_lines(
  style: Style,
  program: Program,
  decided: RunDecision,
) -> List<String> / {abort.raise} = {
  let seeded = program.cases.filter(|case: Case| case.seeded);
  if seeded.len() == 0 { [] } else {
    let head = [
      "",
      indent() ++ dim(style, "search"),
      indent() ++ "  "
        ++ dim(
          style,
          decided.search.mode ++ " · " ++ count_of(decided.search.roots.len(), "seed")
            ++ " · budget "
            ++ decided.search.budget.to_string()
            ++ " · steps "
            ++ decided.search.steps.to_string(),
        ),
      indent() ++ "  "
        ++ dim(
          style,
          seeded.len().to_string() ++ " of " ++ count_of(program.cases.len(), "test")
            ++ " cached under the simulation mode, seeds, budget and steps shown above, not under the test hash alone",
        ),
    ];
    seeded.fold(head, |accumulator: List<String>, case: Case|
      accumulator.concat(remaining_seeds_line(style, program, case, decided)))
  }
}

fn group_tally(style: Style, c: Counts, decided: RunDecision) -> String / {abort.raise} = {
  let hosted = if c.host == 0 { "" } else { " · " ++ c.host.to_string() ++ " use the host" };
  indent() ++ "  "
    ++ dim(
      style,
      c.isolated.to_string() ++ " of " ++ c.total.to_string() ++ " tests are isolated · "
        ++ count_of(decided.parallelism.shared_groups, "group")
        ++ " for the "
        ++ c.shared.to_string()
        ++ " shared "
        ++ plural(c.shared, "test")
        ++ hosted,
    )
}

pub fn display_name_at(program: Program, index: Int) -> String =
  match case_of(program, index) { Some(case) -> display_of(program, case), None -> "" }

fn group_block(
  style: Style,
  program: Program,
  decided: RunDecision,
  lines: List<String>,
  i: Int,
) -> List<String> / {abort.raise} = {
  let g: Group = decided.classes.at_or(i, no_group());
  let head = lines.push(
    indent() ++ "  group " ++ i.to_string() ++ " · " ++ count_of(g.tests.len(), "test") ++ " · "
      ++ dim(style, g.effects),
  );
  g.tests.fold(head, |accumulator: List<String>, index: Int| {
    let named = display_name_at(program, index);
    if named == "" { accumulator } else { accumulator.push(indent() ++ "    " ++ named) }
  })
}

fn concurrency_lines(
  style: Style,
  program: Program,
  c: Counts,
  decided: RunDecision,
) -> List<String> / {abort.raise} =
  if decided.classes.len() == 0 { [] } else {
    range(0, decided.classes.len()).fold(
      ["", indent() ++ dim(style, "concurrency groups"), group_tally(style, c, decided)],
      |accumulator: List<String>, i: Int| group_block(style, program, decided, accumulator, i),
    )
  }

pub fn explain_lines(
  style: Style,
  program: Program,
  host_case_indices: List<Int>,
  decision: RunDecision,
) -> List<String> / {abort.raise} =
  [""].concat(
    program.cases.map(|case: Case| case_line(style, program, host_case_indices, case, decision)),
  ).concat(
    reason_lines(style, program, decision).concat(key_lines(style, program)),
  ).concat(
    search_lines(style, program, decision),
  ).concat(
    concurrency_lines(style, program, counts_of(program, host_case_indices), decision),
  ).concat(
    phase_lines(style, program.phases),
  )

fn glyph_of(status: String) -> String =
  if status == "passed" { "✓" }
  else if status == "failed" { "✗" }
  else if status == "panicked" { "!" }
  else { "–" }

fn word_of(status: String) -> String =
  if status == "passed" { "ok" }
  else if status == "failed" { "FAIL" }
  else if status == "panicked" { "PANIC" }
  else { "TIMED OUT" }

fn painted_glyph(style: Style, status: String) -> String = {
  let glyph = glyph_of(status);
  if status == "passed" { green(style, glyph) }
  else if status == "failed" { red(style, glyph) }
  else if status == "panicked" { yellow(style, glyph) }
  else { dim(style, glyph) }
}

fn marked(style: Style, status: String) -> String =
  if has_colors(style) { painted_glyph(style, status) } else { word_of(status).pad_right(7, " ") }

fn result_name(program: Program, outcome: Outcome) -> String =
  match case_of(program, outcome.index) {
    Some(case) -> display_of(program, case),
    None -> outcome.name,
  }

pub fn name_column(program: Program, decided: RunDecision) -> Int = {
  let widest = decided.classes.fold(0, |accumulator: Int, g: Group|
    g.tests.fold(accumulator, |most: Int, index: Int| {
      let n = display_name_at(program, index).len();
      if n > most { n } else { most }
    }));
  if widest < 24 { 24 } else if widest > 64 { 64 } else { widest }
}

pub fn finished_line(
  style: Style,
  name: String,
  status: String,
  duration_us: Int,
  width: Int,
) -> String =
  indent() ++ marked(style, status) ++ " " ++ name.pad_right(width, " ") ++ " "
    ++ ms_tenths(duration_us).pad_left(8, " ")
    ++ "ms"

pub fn result_line(style: Style, program: Program, outcome: Outcome, width: Int) -> String =
  finished_line(style, result_name(program, outcome), outcome.status, outcome.duration_us, width)

fn reduction_part(e: SearchSummary, naive: Cost) -> List<String> =
  match e.reduction_tenths {
    None -> [],
    Some(tenths) ->
      [
        (if naive.bounded { ">= " } else { "" }) ++ fixed_point((tenths + 5) / 10, 0)
          ++ "× reduction",
      ],
  }

fn search_parts(e: SearchSummary) -> List<String> / {abort.raise} = {
  let head = [count_of(e.explored, "interleaving")];
  let thorough = if e.exhaustive { head.push("exhaustive") } else { head };
  let spent = if e.exhausted { thorough.push("budget spent — not cached") } else { thorough };
  let blind = match e.clockless { None -> spent, Some(b) -> spent.push("blind " ++ b.rendered) };
  match e.naive {
    None -> blind,
    Some(naive) -> blind.push("naive " ++ naive.rendered).concat(reduction_part(e, naive)),
  }
}

fn ended_lines(
  style: Style,
  places: List<SourceText>,
  outcome: Outcome,
) -> List<String> / {abort.raise} =
  match outcome.diagnostic {
    None -> [],
    Some(r) -> if outcome.status == "passed" { [] } else {
      let d = shown(r);
      [indent() ++ "    " ++ String::of_bytes_lossy(d.message)].concat(
        at_lines(style, places, d).map(|line: String| indent() ++ line),
      )
    },
  }

fn has_details(outcome: Outcome) -> Bool = outcome.status != "passed" || outcome.search != None

pub fn detailed_result_lines(
  style: Style,
  program: Program,
  outcomes: List<Outcome>,
  width: Int,
) -> List<String> / {abort.raise} =
  result_lines(style, program, outcomes.filter(has_details), width)

pub fn result_lines(
  style: Style,
  program: Program,
  outcomes: List<Outcome>,
  width: Int,
) -> List<String> / {abort.raise} =
  outcomes.fold([], |accumulator: List<String>, outcome: Outcome| {
    let listed = accumulator.push(result_line(style, program, outcome, width));
    let searched = match outcome.search {
      None -> listed,
      Some(e) ->
        listed.push(indent() ++ "    " ++ dim(style, String::join(search_parts(e), " · "))),
    };
    searched.concat(ended_lines(style, program.places, outcome))
  })

pub fn all_cached_lines(
  style: Style,
  tests: Int,
  filtered_out: Int,
) -> List<String> / {abort.raise} =
  [
    indent() ++ bold(style, "selected") ++ " " ++ bold(style, "0") ++ " of " ++ tests.to_string()
      ++ " ("
      ++ tests.to_string()
      ++ " cached)",
  ].concat(
    filtered_lines(style, filtered_out),
  ).push(
    indent() ++ dim(style, "0 failed") ++ ", " ++ dim(style, "0 passed") ++ ", "
      ++ tests.to_string()
      ++ " cached ("
      ++ secs_hundredths(0)
      ++ "s)",
  )

pub fn summary_line(style: Style, report: RunReport, counted: Counts) -> String = {
  let c = report.summary;
  let failures = c.failed.to_string() ++ " failed";
  let passes = c.passed.to_string() ++ " passed";
  let hosted = if counted.host == 0 { "" }
  else { dim(style, ", " ++ counted.host.to_string() ++ " used the host") };
  let given_up = if c.timed_out == 0 { "" }
  else { yellow(style, ", " ++ c.timed_out.to_string() ++ " timed out") };
  indent() ++ (if c.failed > 0 { red(style, failures) } else { dim(style, failures) }) ++ ", "
    ++ (if c.passed > 0 { green(style, passes) } else { dim(style, passes) })
    ++ ", "
    ++ c.cached.to_string()
    ++ " cached"
    ++ hosted
    ++ given_up
    ++ " ("
    ++ secs_hundredths(c.duration_us)
    ++ "s)"
}

fn note_lines(style: Style, diagnostic: Diagnostic) -> List<String> =
  diagnostic.notes_text.map(|n: Bytes| "  " ++ dim(style, "=") ++ " " ++ String::of_bytes_lossy(n))

pub fn secondary_lines(
  style: Style,
  places: List<SourceText>,
  diagnostic: Diagnostic,
) -> List<String> / {abort.raise} =
  diagnostic.labels.filter(|label: Label| !label.primary).map(|label: Label|
    "    " ++ String::of_bytes_lossy(label.text) ++ dim_place(style, places, Some(label_at(label))))

pub fn at_lines(
  style: Style,
  places: List<SourceText>,
  diagnostic: Diagnostic,
) -> List<String> / {abort.raise} =
  match primary_of(diagnostic) {
    None -> [],
    Some(l) -> match location_text(places, label_at(l)) {
      None -> [],
      Some(text) -> ["    at " ++ dim(style, text)],
    },
  }

fn site_line(
  style: Style,
  places: List<SourceText>,
  site: Site,
  first: Bool,
) -> String / {abort.raise} =
  "  " ++ yellow(style, if first { "race:" } else { "     " }) ++ " " ++ site.task ++ "  "
    ++ (match site.definition { Some(d) -> d, None -> "-" })
    ++ "   "
    ++ site.access
    ++ dim_place(style, places, site.at)

fn race_lines(
  style: Style,
  places: List<SourceText>,
  fault: Fault,
) -> List<String> / {abort.raise} =
  match fault.race {
    None -> [],
    Some(race) ->
      [site_line(style, places, race.left, true), site_line(style, places, race.right, false)],
  }

fn replay_lines(style: Style, fault: Fault) -> List<String> =
  match fault.replay {
    None -> [],
    Some(command) -> ["  " ++ dim(style, "replay:") ++ " " ++ command],
  }

pub fn seed_lines(
  style: Style,
  places: List<SourceText>,
  fault: Fault,
) -> List<String> / {abort.raise} =
  match fault.seed {
    None -> [],
    Some(seed) ->
      ["  " ++ dim(style, "seed:") ++ " " ++ seed].concat(race_lines(style, places, fault)).concat(
        replay_lines(style, fault),
      ),
  }

pub fn change_text(x: RankedChange) -> String =
  match x.change { Some(c) -> x.name ++ " (" ++ kind_word(c) ++ ")", None -> x.name }

fn change_lines(style: Style, fault: Fault) -> List<String> = {
  let named = fault.changes.map(change_text);
  if named.len() > 0 { ["  " ++ yellow(style, "changes:") ++ " " ++ String::join(named, ", ")] }
  else if fault.unchanged {
    ["  " ++ dim(style, "changes: none — nothing this test depends on changed")]
  } else { [] }
}

fn failure_lines(
  style: Style,
  places: List<SourceText>,
  fault: Fault,
) -> List<String> / {abort.raise} = {
  let d = shown(fault.diagnostic);
  [bold(style, fault.key), "  " ++ String::of_bytes_lossy(d.message)].concat(
    at_lines(style, places, d),
  ).concat(
    secondary_lines(style, places, d),
  ).concat(
    note_lines(style, d),
  ).concat(
    seed_lines(style, places, fault),
  ).concat(
    change_lines(style, fault),
  )
}

fn failure_blocks(
  style: Style,
  program: Program,
  faults: List<Fault>,
) -> List<String> / {abort.raise} =
  faults.fold([], |accumulator: List<String>, fault: Fault|
    accumulator.push("").concat(
      failure_lines(style, program.places, fault).map(|l: String| indent() ++ l),
    ))

fn diff_lines_shown() -> Int = 40

fn painted(style: Style, line: String) -> String =
  if line.starts_with("+") { green(style, line) }
  else if line.starts_with("-") { red(style, line) }
  else if line.starts_with("@@") { dim(style, line) }
  else { line }

fn diff_lines(
  style: Style,
  places: List<SourceText>,
  d: ChangeDiff,
) -> List<String> / {abort.raise} = {
  let head = "  " ++ bold(style, d.name) ++ " (" ++ kind_word(d.change) ++ ")"
    ++ dim_place(style, places, d.at);
  let body = match d.diff {
    None -> ["    " ++ dim(style, "its text from when the test last passed is not stored")],
    Some(text) -> {
      let lines = text.split("\n").drop(2).filter(|l: String| l != "");
      let shown = lines.take(diff_lines_shown()).map(|l: String| "    " ++ painted(style, l));
      if lines.len() <= diff_lines_shown() { shown } else {
        shown.push(
          "    " ++ dim(style, "… " ++ count_of(lines.len() - diff_lines_shown(), "more line")),
        )
      }
    },
  };
  [head].concat(body)
}

fn diff_blocks(
  style: Style,
  program: Program,
  diffs: List<ChangeDiff>,
) -> List<String> / {abort.raise} =
  if diffs.len() == 0 { [] } else {
    ["", indent() ++ bold(style, "changed since the failing tests last passed:")].concat(
      diffs.flat_map(|d: ChangeDiff|
        diff_lines(style, program.places, d).map(|l: String| indent() ++ l)),
    )
  }

fn timed_out_lines(
  style: Style,
  places: List<SourceText>,
  outcome: Outcome,
) -> List<String> / {abort.raise} = {
  let head = [bold(style, outcome.name) ++ " " ++ yellow(style, "timed out")];
  match outcome.diagnostic {
    None -> head,
    Some(r) -> {
      let d = shown(r);
      head.push("  " ++ String::of_bytes_lossy(d.message)).concat(
        at_lines(style, places, d),
      ).concat(
        note_lines(style, d),
      )
    },
  }
}

fn timed_out_blocks(
  style: Style,
  program: Program,
  report: RunReport,
) -> List<String> / {abort.raise} =
  report.results.filter(|outcome: Outcome| outcome.status == "timed_out").fold(
    [],
    |accumulator: List<String>, outcome: Outcome|
      accumulator.push("").concat(
        timed_out_lines(style, program.places, outcome).map(|l: String| indent() ++ l),
      ),
  )

fn unreached_lines(style: Style, names: List<String>) -> List<String> =
  names.map(|n: String| indent() ++ indent() ++ dim(style, n ++ ": no test runs it"))

fn coverage_lines(style: Style, report: RunReport) -> List<String> =
  match report.coverage {
    None -> [],
    Some(c) ->
      [
        indent() ++ bold(style, "coverage") ++ " "
          ++ Int::to_string(c.definitions - c.unreached.len())
          ++ " of "
          ++ c.definitions.to_string()
          ++ " definitions executed by at least one test",
      ].concat(
        unreached_lines(style, c.unreached),
      ),
  }

fn no_tests_note(flags: Flags, program: Program) -> String =
  if program.declared == 0 { "no `test` items in this program" } else if flags.filters.len() > 0 {
    "no test key contains a `--filter` substring; nothing was verified"
  } else { "nothing to report" }

fn case_of_json(case: Case) -> List<Member> / {abort.raise} =
  match case.entry.case {
    None -> [],
    Some(c) ->
      [
        {
          key: "case",
          value: object([
            { key: "at", value: int(c.at) },
            { key: "identity", value: Str(c.identity.hex_of()) },
            { key: "of", value: Str(String::of_bytes_lossy(case.entry.key)) },
          ]),
        },
      ],
  }

pub fn case_json(report: RunReport, case: Case, decided: RunDecision) -> Json / {abort.raise} =
  object(
    case_of_json(case).concat([
      { key: "index", value: int(case.index) },
      { key: "key", value: Str(case.key) },
      { key: "name", value: Str(case.name) },
      { key: "module", value: Str(case.module) },
      { key: "hash", value: string_or_null(case.hash) },
      { key: "nondet", value: Bool(case.nondet) },
      { key: "selected", value: Bool(runs_test(decided, case.index)) },
      { key: "reason", value: Str(reason_key(reason_word(reason_of(decided, case.index)))) },
      { key: "why", value: Str(reason_text(reason_word(reason_of(decided, case.index)))) },
      { key: "changed_input", value: string_or_null(changed_read_of(decided, case.index)) },
      { key: "group", value: int_or_null(group_of(decided, case.index)) },
      { key: "outside_effects", value: Str(case.effects) },
      { key: "isolation", value: Str(isolated_as(report.tests_using_host, case)) },
      { key: "host", value: Bool(covers(report.tests_using_host, case.index)) },
      { key: "shared_effects", value: strings(shared_texts(case)) },
      { key: "contends", value: Array(cross_test_effects(effects_of(case)).map(effect_json)) },
      { key: "seeded", value: Bool(case.seeded) },
    ]),
  )

fn effect_json(a: Effect) -> Json =
  object([
    { key: "effect", value: Str(a.effect) },
    { key: "resource", value: Str(a.resource) },
    { key: "writes", value: Bool(a.writes) },
  ])

fn group_json(decided: RunDecision, i: Int) -> Json = {
  let g: Group = decided.classes.at_or(i, no_group());
  object([
    { key: "index", value: int(i) },
    { key: "tests", value: Array(g.tests.map(|x: Int| int(x))) },
    { key: "outside_effects", value: Str(g.effects) },
  ])
}

fn cost_json(v: Option<Cost>) -> Json =
  match v {
    None -> Null,
    Some(c) ->
      object([
        { key: "explored", value: int(c.explored) },
        { key: "bounded", value: Bool(c.bounded) },
        { key: "rendered", value: Str(c.rendered) },
      ]),
  }

fn search_json(e: SearchSummary) -> Json =
  object([
    { key: "explored", value: int(e.explored) },
    { key: "exhaustive", value: Bool(e.exhaustive) },
    { key: "exhausted", value: Bool(e.exhausted) },
    { key: "blind", value: cost_json(e.clockless) },
    { key: "naive", value: cost_json(e.naive) },
    {
      key: "reduction",
      value: match e.reduction_tenths {
        Some(t) -> Number(Decimal::of_string(fixed_point(t, 1)).unwrap_or(Decimal::of_int(0))),
        None -> Null,
      },
    },
    { key: "steps", value: int(e.steps) },
    { key: "virtual_time_ns", value: int(e.virtual_time_ns) },
    { key: "failing_seed", value: string_or_null(e.failing_seed) },
  ])

pub fn case_of(program: Program, index: Int) -> Option<Case> =
  match program.positions.get(index) { Some(place) -> program.cases.at(place), None -> None }

pub fn placed_cases(cases: List<Case>) -> Map<Int, Int> =
  range(0, cases.len()).fold(Map::new(), |accumulator: Map<Int, Int>, place: Int|
    match cases.at(place) {
      Some(case) -> if accumulator.contains(case.index) { accumulator }
      else { accumulator.insert(case.index, place) },
      None -> accumulator,
    })

fn outcome_json(program: Program, outcome: Outcome, d: RunDecision) -> Json / {abort.raise} = {
  let named = case_of(program, outcome.index);
  object([
    { key: "index", value: int(outcome.index) },
    { key: "key", value: match named { Some(c) -> Str(c.key), None -> Null } },
    { key: "name", value: Str(match named { Some(c) -> c.name, None -> outcome.name }) },
    { key: "module", value: match named { Some(c) -> Str(c.module), None -> Null } },
    { key: "hash", value: string_or_null(outcome.hash) },
    { key: "group", value: int(match group_of(d, outcome.index) { Some(g) -> g, None -> 0 }) },
    { key: "status", value: Str(outcome.status) },
    { key: "duration_ms", value: milliseconds_json(outcome.duration_us) },
    {
      key: "diagnostic",
      value: match outcome.diagnostic {
        Some(r) -> runtime_diagnostic_json(r, program.places),
        None -> Null,
      },
    },
    { key: "simulation", value: match outcome.search { Some(e) -> search_json(e), None -> Null } },
    { key: "cached", value: opt_bool(outcome.cached) },
    { key: "performs", value: int(outcome.performs) },
  ])
}

fn span_json(a: Option<ModuleSpan>) -> Json =
  match a {
    None -> Null,
    Some(at) ->
      object([
        { key: "source", value: int(at.module) },
        { key: "start", value: int(at.start) },
        { key: "end", value: int(at.end) },
      ]),
  }

fn site_json(x: Site) -> Json =
  object([
    { key: "task", value: Str(x.task) },
    { key: "definition", value: string_or_null(x.definition) },
    { key: "access", value: Str(x.access) },
    { key: "span", value: span_json(x.at) },
  ])

fn race_json(v: Option<Race>) -> Json =
  match v {
    None -> Null,
    Some(race) ->
      object([
        { key: "at", value: int(race.step) },
        { key: "left", value: site_json(race.left) },
        { key: "right", value: site_json(race.right) },
      ]),
  }

pub fn fault_json(program: Program, fault: Fault) -> Json / {abort.raise} =
  object([
    { key: "key", value: Str(fault.key) },
    { key: "name", value: Str(fault.name) },
    { key: "diagnostic", value: runtime_diagnostic_json(fault.diagnostic, program.places) },
    { key: "internal_error", value: Bool(fault.internal_error) },
    { key: "seed", value: string_or_null(fault.seed) },
    { key: "replay", value: string_or_null(fault.replay) },
    { key: "race", value: race_json(fault.race) },
    { key: "changes", value: Array(fault.changes.map(change_json)) },
    { key: "module", value: string_or_null(fault.module) },
    { key: "test_hash", value: string_or_null(fault.test_hash) },
    { key: "nondet", value: opt_bool(fault.nondet) },
    { key: "status", value: string_or_null(fault.status) },
    { key: "location", value: location_json(program.places, fault.diagnostic.diagnostic) },
    {
      key: "outside_effects",
      value: object([{ key: "declared", value: strings_or_null(fault.declared) }]),
    },
  ])

fn change_json(x: RankedChange) -> Json =
  object([
    { key: "name", value: Str(x.name) },
    {
      key: "change",
      value: string_or_null(match x.change { Some(c) -> Some(kind_word(c)), None -> None }),
    },
    { key: "hash", value: string_or_null(x.hash) },
    { key: "before", value: string_or_null(x.before) },
    { key: "test", value: Bool(x.test) },
  ])

fn diff_json(program: Program, d: ChangeDiff) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(d.name) },
    { key: "change", value: Str(kind_word(d.change)) },
    {
      key: "location",
      value: match d.at { Some(at) -> editor_location_json(program.places, at), None -> Null },
    },
    { key: "diff", value: string_or_null(d.diff) },
  ])

fn parallelism_json(v: Parallelism) -> Json =
  object([
    { key: "total", value: int(v.total) },
    { key: "isolated", value: int(v.conflict_free) },
    { key: "shared", value: int(v.shared) },
    { key: "scheduled", value: int(v.scheduled) },
    { key: "groups", value: int(v.groups) },
    { key: "shared_groups", value: int(v.shared_groups) },
  ])

fn phases_json(phases: Phases) -> Json =
  object([
    { key: "read", value: milliseconds_json(phases.read_us) },
    { key: "front", value: milliseconds_json(phases.front_end_us) },
    { key: "write_back", value: milliseconds_json(phases.write_back_us) },
    { key: "total", value: milliseconds_json(phase_total(phases)) },
  ])

fn selection_json(
  program: Program,
  report: RunReport,
  decided: RunDecision,
) -> Json / {abort.raise} = {
  let c = counts_of(program, report.tests_using_host);
  object([
    { key: "total", value: int(program.cases.len()) },
    { key: "selected", value: int(selected_count(program, decided)) },
    { key: "cached", value: int(cached_count(program, decided)) },
    { key: "same_code", value: int(by_code_count(program, decided)) },
    { key: "filtered_out", value: int(program.filtered_out) },
    { key: "recorded_under", value: string_or_null(program.cache_stamp) },
    {
      key: "groups",
      value: Array(range(0, decided.classes.len()).map(|i: Int| group_json(decided, i))),
    },
    { key: "isolated", value: int(c.isolated) },
    { key: "shared", value: int(c.shared) },
    { key: "host", value: int(c.host) },
    { key: "parallelism", value: parallelism_json(decided.parallelism) },
    {
      key: "tests",
      value: Array(program.cases.map(|case: Case| case_json(report, case, decided))),
    },
  ])
}

fn summary_json(c: Summary) -> Json =
  object([
    { key: "passed", value: int(c.passed) },
    { key: "failed", value: int(c.failed) },
    { key: "timed_out", value: int(c.timed_out) },
    { key: "cached", value: int(c.cached) },
    { key: "duration_ms", value: milliseconds_json(c.duration_us) },
  ])

fn simulation_summary_json(c: SimulationSummary) -> Json =
  object([
    { key: "simulated", value: int(c.simulated) },
    { key: "seeds", value: int(c.seeds) },
    { key: "interleavings", value: int(c.interleavings) },
    { key: "exhaustive", value: int(c.exhaustive) },
    { key: "exhausted", value: int(c.exhausted) },
    { key: "failed", value: int(c.failed) },
  ])

fn backend_json(report: RunReport) -> Json =
  match report.backend {
    None -> Null,
    Some(b) ->
      object([
        { key: "name", value: Str(b.name) },
        { key: "fragment", value: int(b.fragment) },
        { key: "load_nanos", value: int_or_null(b.load_nanos) },
        { key: "units", value: int_or_null(b.units) },
        { key: "entered", value: int(b.entered) },
      ]),
  }

fn coverage_document(report: RunReport) -> List<Member> =
  match report.coverage { None -> [], Some(c) -> [{ key: "coverage", value: c.json }] }

fn artifact_schema() -> Int = 8

fn document(
  flags: Flags,
  program: Program,
  report: RunReport,
  faults: List<Fault>,
  diffs: List<ChangeDiff>,
  warnings: List<Diagnostic>,
  ok: Bool,
  decided: RunDecision,
) -> Json / {abort.raise} =
  object(
    [
      { key: "command", value: Str("test") },
      { key: "schema_version", value: int(artifact_schema()) },
      {
        key: "front_end",
        value: object(
          [
            { key: "incremental", value: Bool(program.loaded_from_cache) },
            { key: "phases", value: phases_json(program.phases) },
          ].concat(
            program.reused_members,
          ),
        ),
      },
      { key: "phases", value: run_phases_json(program.phases, report.spent) },
      { key: "ok", value: Bool(ok) },
      { key: "exit_code", value: int(if ok { ok_code() } else { run_failed() }) },
      { key: "root", value: Str(program.root) },
      { key: "files", value: strings(program.files) },
      {
        key: "modules",
        value: Array(
          program.modules.map(|m: ModuleView|
            object([{ key: "name", value: Str(m.name) }, { key: "file", value: Str(m.file) }])),
        ),
      },
      { key: "filters", value: Array(flags.filters.map(|f: String| Str(f))) },
      { key: "no_cache", value: Bool(flags.no_cache) },
      { key: "hosts", value: report.hosts },
      { key: "workers", value: int(report.workers) },
      { key: "options", value: with_sim(program.options, decided.sim) },
      { key: "simulation", value: simulation_summary_json(report.simulation) },
      { key: "backend", value: backend_json(report) },
      { key: "selection", value: selection_json(program, report, decided) },
      { key: "summary", value: summary_json(report.summary) },
      {
        key: "results",
        value: Array(
          report.results.map(|outcome: Outcome| outcome_json(program, outcome, decided)),
        ),
      },
      { key: "failures", value: Array(faults.map(|f: Fault| fault_json(program, f))) },
      { key: "diffs", value: Array(diffs.map(|d: ChangeDiff| diff_json(program, d))) },
      { key: "diagnostics", value: all_to_json(report.unbound_pass_diagnostics, program.places) },
      { key: "warnings", value: all_to_json(warnings, program.places) },
    ].concat(
      coverage_document(report),
    ),
  )

fn run_failed() -> Int = 1

fn green_run(report: RunReport) -> Bool =
  report.summary.failed == 0 && report.summary.timed_out == 0
    && report.unbound_pass_diagnostics.len() == 0

fn nothing_lines(style: Style, flags: Flags, program: Program) -> List<String> =
  if program.cases.len() > 0 { [] }
  else { ["", indent() ++ dim(style, no_tests_note(flags, program))] }

fn closing_lines(
  style: Style,
  flags: Flags,
  program: Program,
  report: RunReport,
  faults: List<Fault>,
  diffs: List<ChangeDiff>,
  warnings: List<Diagnostic>,
) -> List<String> / {abort.raise} =
  [
    if flags.explain { run_phase_lines(style, program.phases, report.spent) } else { [] },
    [""],
    run_lines(style, report),
    [summary_line(style, report, counts_of(program, report.tests_using_host))],
    warned_lines(style, report.unbound_pass_diagnostics),
    failure_blocks(style, program, faults),
    diff_blocks(style, program, diffs),
    timed_out_blocks(style, program, report),
    nothing_lines(style, flags, program),
    warned_lines(style, warnings),
    coverage_lines(style, report),
  ].fold([], |accumulator: List<String>, part: List<String>| accumulator.concat(part))

fn all_warnings(program: Program, report: RunReport) -> List<Diagnostic> =
  program.warnings.concat(report.warnings).fold(
    [],
    |accumulator: List<Diagnostic>, d: Diagnostic|
      if accumulator.filter(|x: Diagnostic| x.code == d.code && x.message == d.message).len() > 0 {
        accumulator
      } else { accumulator.push(d) },
  )

pub fn test_output(
  style: Style,
  flags: Flags,
  program: Program,
  report: RunReport,
  faults: List<Fault>,
  diffs: List<ChangeDiff>,
  decided: RunDecision,
) -> CommandOutput / {abort.raise} = {
  let warnings = all_warnings(program, report);
  let ok = green_run(report);
  {
    json: document(flags, program, report, faults, diffs, warnings, ok, decided),
    lines: closing_lines(style, flags, program, report, faults, diffs, warnings),
    errs: [],
    code: if ok { ok_code() } else { run_failed() },
  }
}

pub fn unbound(style: Style, rejection: Rejection) -> CommandOutput / {abort.raise} = {
  let tally = indent() ++ red(style, "no host handler was bound") ++ " ("
    ++ count_of(rejection.diagnostics.len(), "error")
    ++ ")";
  {
    json: object([
      { key: "command", value: Str("test") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: int(compile_error()) },
      { key: "diagnostics", value: all_to_json(rejection.diagnostics, rejection.places) },
    ]),
    lines: [],
    errs: all_to_text(style, rejection.diagnostics, rejection.places).push(tally),
    code: compile_error(),
  }
}

pub fn test_at(analysis: CheckedProgram, i: Int) -> Option<TestInfo> = analysis.checked.tests.at(i)

fn resource_rank(r: types::Resource) -> Int =
  match r {
    NamedResource(_) -> 0,
    ResourceVariable(_) -> 1,
    SingletonResource -> 2,
    AnyResource -> 3,
  }

fn mode_rank(m: type_syntax::Mode) -> Int = match m { ReadMode -> 0, WriteMode -> 1, _ -> 2 }

fn effect_before(a: types::Effect, b: types::Effect) -> Bool =
  if a.effect != b.effect { compare(a.effect, b.effect) == Less }
  else if resource_rank(a.resource) != resource_rank(b.resource) {
    resource_rank(a.resource) < resource_rank(b.resource)
  } else if a.resource != b.resource {
    match ((a.resource, b.resource)) {
      (NamedResource(x), NamedResource(y)) -> compare(x, y) == Less,
      (ResourceVariable(x), ResourceVariable(y)) -> x < y,
      _ -> false,
    }
  } else if mode_rank(a.mode) != mode_rank(b.mode) { mode_rank(a.mode) < mode_rank(b.mode) } else {
    match ((a.operation, b.operation)) {
      (None, Some(_)) -> true,
      (Some(x), Some(y)) -> compare(x, y) == Less,
      _ -> false,
    }
  }

pub fn canonical(effects: List<types::Effect>) -> List<types::Effect> =
  dedup(effects.sort_by(effect_before))

pub fn outside_effects_text(effects: List<types::Effect>) -> String / {abort.raise} =
  "{" ++ String::join(effect_texts(effects), ", ") ++ "}"

pub fn with_sim(options: Json, sim: Json) -> Json =
  match options { Object(members) -> Object(members.insert("sim", sim)), other -> other }

test "a test's status mark is a word in plain output and a single symbol in styled output" {
  assert_eq(marked(plain(), "passed"), "ok     ");
  assert_eq(marked(plain(), "failed"), "FAIL   ");
  assert_eq(marked(plain(), "panicked"), "PANIC  ");
  assert_eq(marked(plain(), "timed_out"), "TIMED OUT");
  assert_eq(Bytes::of_string(marked(ansi(), "passed")), b"\x1b[32m\xe2\x9c\x93\x1b[0m")
}

test "a reason is written as separate words in the report line and with underscores in the JSON document" {
  assert_eq(reason_key(reason_word(PreviousFailure)), "previous_failure");
  assert_eq(reason_key(reason_word(New)), "new");
  assert_eq(reason_word(Changed("the file `a.ply`")), "changed");
  assert_eq(reason_word(Unhashed), "unhashed")
}

test "a search report gives the interleavings explored, and how many a search ignoring time or pruning would have explored" {
  let e: SearchSummary = {
    explored: 12,
    exhaustive: true,
    exhausted: false,
    clockless: Some({ explored: 30, bounded: false, rendered: "30" }),
    naive: Some({ explored: 120, bounded: false, rendered: "120" }),
    reduction_tenths: Some(100),
    steps: 8,
    virtual_time_ns: 0,
    failing_seed: None,
  };
  assert_eq(
    String::join(search_parts(e), " · "),
    "12 interleavings · exhaustive · blind 30 · naive 120 · 10× reduction",
  );
  let doc = to_string(search_json(e));
  assert(doc.contains("\"blind\":{\"bounded\":false,\"explored\":30,\"rendered\":\"30\"}"));
  assert(doc.contains("\"naive\":{\"bounded\":false,\"explored\":120,\"rendered\":\"120\"}"));
  let unmeasured = { ..e, clockless: None, naive: None, reduction_tenths: None };
  assert_eq(String::join(search_parts(unmeasured), " · "), "12 interleavings · exhaustive");
  assert(to_string(search_json(unmeasured)).contains("\"blind\":null"))
}

test "a bounded naive count makes the ratio a lower bound" {
  let e: SearchSummary = {
    explored: 12,
    exhaustive: false,
    exhausted: false,
    clockless: Some({ explored: 40, bounded: false, rendered: "40" }),
    naive: Some({ explored: 4096, bounded: true, rendered: ">= 4096" }),
    reduction_tenths: Some(3413),
    steps: 8,
    virtual_time_ns: 0,
    failing_seed: None,
  };
  assert_eq(
    String::join(search_parts(e), " · "),
    "12 interleavings · blind 40 · naive >= 4096 · >= 341× reduction",
  )
}

test "every reason has an explanation of its own" {
  let lines = [New, Changed(""), PreviousFailure, Cached, SameCode, Unhashed].map(
    |r: Reason| reason_word(r),
  ).map(
    reason_text,
  );
  assert_eq(
    range(0, 6).filter(|i: Int|
      range(0, 6).filter(|j: Int| lines.at_or(i, "") == lines.at_or(j, "")).len() == 1).len(
    ),
    6,
  )
}

test "a failed load exits with code 2 and prints its errors with their count" {
  let result = rejected(
    plain(),
    "test",
    [error_with_labels(b"E0201", b"type mismatch", [], [])],
    [],
  );
  assert_eq(result.code, 2);
  assert_eq(result.errs, ["Error[E0201]: type mismatch", "   compilation failed (1 error)"])
}

test "a binding that does not match the program is a start-up failure naming no line" {
  let result = unbound(plain(), {
    diagnostics: [error_with_labels(b"E0412", b"a nondet effect in a det test", [], [])],
    places: [],
  });
  assert_eq(result.code, 2);
  assert_eq(result.errs, [
    "Error[E0412]: a nondet effect in a det test",
    "   no host handler was bound (1 error)",
  ])
}

test "a program cannot declare an effect named `scoped` or `sim`, because the test scheduler reserves those names" {
  let rejected = |name: String|
    match analyse(
        parse_all([
          {
            name: b"",
            source_text: Bytes::of_string(
              "effect " ++ name ++ " {\n  write put[users](v: Int) -> Unit\n}\ntest \"claim\" { "
                ++ name
                ++ ".put[users](1) }\n",
            ),
          },
        ]),
      ) {
      Analysed(_) -> false,
      Rejected(_) -> true,
    };
  assert(rejected("scoped"));
  assert(rejected("sim"))
}
