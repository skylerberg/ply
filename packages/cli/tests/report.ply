/// One atom of a test's footprint, as a scheduler compares them and as the printer spells it.
pub type Printed = { atom: Atom, text: String }

/// The options record, built from the parsed line.
pub fn options_from(p: Parsed, root: String) -> Options / {abort.raise} = {
  let machine_options = machine::options_from(p);
  {
    path: root,
    json: has(p, "json"),
    explain: has(p, "explain"),
    no_cache: has(p, "no-cache"),
    filters: values_of(p, "filter"),
    shard: match value(p, "shard") { Some(v) -> surface::shard_of(v), None -> None },
    jobs: match value(p, "jobs") { Some(v) -> parse_nat(v), None -> None },
    steps: match value(p, "steps") {
      Some(v) -> match parse_nat(v) { Some(n) -> n, None -> 0 },
      None -> 1000000000,
    },
    timeout: match value(p, "timeout") {
      Some(v) -> match parse_nat(v) { Some(n) -> n, None -> 0 },
      None -> 60000,
    },
    bisect: match value(p, "bisect") { Some(v) -> v, None -> "auto" },
    bisect_budget: match value(p, "bisect-budget") {
      Some(v) -> match parse_nat(v) { Some(n) -> n, None -> 0 },
      None -> 64,
    },
    coverage: has(p, "coverage"),
    mutate: value(p, "mutate"),
    mutate_budget: match value(p, "mutate-budget") {
      Some(v) -> match parse_nat(v) { Some(n) -> n, None -> 0 },
      None -> 64,
    },
    profile: machine_options.profile,
    watch: has(p, "watch"),
    host: machine_options.host,
    tls: machine_options.tls,
    trust: machine_options.trust,
    mtls: machine_options.mtls,
    fs: machine_options.fs,
    exec: machine_options.exec,
    allow: machine_options.allow,
    config: machine_options.config,
    sim: machine::sim_options_from(p),
  }
}

pub type Refusal = { diags: List<Diag>, places: List<Place> }

/// Whole microseconds, as the clock the runner reads counts them: every reading in both forms is
/// printed from the same integer, so a line and its document cannot disagree by a rounding.
pub type Phases = { read_us: Int, front_us: Int, write_back_us: Int }

pub type ModuleView = { name: String, file: String }

/// How the runtime is asked for one of the run's tests: the test of the loaded program it is, by
/// index and by key, and over cases the case. `unlisted` is why a test's cases could not be listed,
/// which is then how the test ends.
pub type Entry = { test: Int, of: Bytes, case: Option<Chosen>, unlisted: Option<Unlisted> }

/// One test still in scope, and what the store said about it. `test` is a reserved word, so a
/// single one of them is a case.
pub type Case = {
  index: Int,
  entry: Entry,
  key: String,
  name: String,
  module: String,
  nondet: Bool,
  /// `None` when the front end produced no hash, which is what `unhashed` means.
  hash: Option<String>,
  footprint: String,
  /// Every atom of the footprint: which of them another test could contend over is the suite's.
  atoms: List<Printed>,
  /// Something in its closure entered a `simulate` region, so it is searched and keyed on the plan.
  seeded: Bool,
}

/// What the program decided about a run: the reason for each test, the roots a seeded one still owes,
/// which tests run, the classes they share, and the summary over them. The report reads all of it
/// from here rather than from the runtime, which no longer decides any of it.
pub type Decided = {
  /// The search every seeded test is keyed on, and the options document's account of it.
  search: Search,
  sim: Json,
  // Each by its test's index: a run reports on thousands, and every line asks of one.
  reasons: Map<Int, Reason>,
  owed: Map<Int, Int>,
  runs: List<Int>,
  running: Map<Int, Bool>,
  /// Which class each running test landed in.
  at: Map<Int, Int>,
  classes: List<Group>,
  parallelism: Parallelism,
}

fn reason_of(decided: Decided, index: Int) -> Reason =
  match decided.reasons.get(index) { Some(reason) -> reason, None -> Cached }

fn runs_test(decided: Decided, index: Int) -> Bool = decided.running.contains(index)

/// The read whose move brought a cached test back, when one did.
fn moved_of(decided: Decided, index: Int) -> Option<String> =
  match reason_of(decided, index) { Changed(what) -> Some(what), _ -> None }

/// The same over the tests this run reports on, which `--filter` may have narrowed.
fn selected_count(program: Program, decided: Decided) -> Int =
  program.cases.filter(|case: Case| runs_test(decided, case.index)).len()

pub fn cached_count(program: Program, decided: Decided) -> Int =
  program.cases.len() - selected_count(program, decided)

/// The cached tests a pass answered by the code they compile to rather than by their own key.
fn by_code_count(program: Program, decided: Decided) -> Int =
  program.cases.filter(|case: Case| reason_of(decided, case.index) == SameCode).len()

/// What the program decided about the conflict graph: the classes it coloured, the summary over
/// them, and which class each test landed in — which is only the tests that run, since a class is
/// what a test *shares a worker* with.
fn group_of(decided: Decided, index: Int) -> Option<Int> = decided.at.get(index)

fn owed_of(decided: Decided, index: Int) -> Int =
  match decided.owed.get(index) { Some(owed) -> owed, None -> 0 }

/// A class's footprint is the union of its tests', printed as one footprint is.
pub fn group_of_class(analysis: View, class: List<Int>) -> Group / {abort.raise} =
  {
    tests: class,
    footprint: footprint_text(
      canonical(
        class.fold([], |acc: List<types::Atom>, i: Int|
          match test_at(analysis, i) { Some(t) -> acc.concat(t.footprint), None -> acc }),
      ),
    ),
  }

/// The footprint's atoms, unprinted.
fn atoms_of(case: Case) -> List<Atom> = case.atoms.map(|printed: Printed| printed.atom)

/// The atoms another test could contend over, printed.
fn shared_texts(case: Case) -> List<String> =
  case.atoms.filter(|printed: Printed| shared([printed.atom]).len() > 0).map(|printed: Printed|
    printed.text)

/// The shared footprint, as the printer spells a footprint.
pub fn shared_of(case: Case) -> String = "{" ++ String::join(shared_texts(case), ", ") ++ "}"

/// The classes the named tests share, coloured from the atoms each row carries.
pub fn classes_of(program: Program, runs: List<Int>) -> List<List<Int>> / {abort.raise} =
  group_by_conflict(scheduled_of(program, set_of(runs)))

/// The tests of `running` the run reports on, as the scheduler colours them.
fn scheduled_of(program: Program, running: Map<Int, Bool>) -> List<Scheduled> =
  program.cases.filter(|case: Case| running.contains(case.index)).map(|case: Case|
    { index: case.index, contends: shared(atoms_of(case)) })

/// The classes over every test the run reports on, when a pass will re-run any of them: only a
/// mutation does, so a run without one colours nothing it will not use.
pub fn every_of(program: Program, options: Options) -> List<List<Int>> / {abort.raise} =
  match options.mutate {
    None -> [],
    Some(_) -> classes_of(program, program.cases.map(|case: Case| case.index)),
  }

/// What the binding reaching some tests makes of each test the run reports on.
fn reported(reaches: List<Int>, case: Case) -> { atoms: List<Atom>, host: Bool } =
  { atoms: atoms_of(case), host: covers(reaches, case.index) }

pub fn counts_of(program: Program, reaches: List<Int>) -> Counts =
  counts(program.cases.map(|case: Case| reported(reaches, case)))

/// The whole decision, as the report reads it: a reason per test, what each seeded one still owes,
/// which tests run, and the classes they share.
pub fn decided_of(
  program: Program,
  decisions: List<Decision>,
  search: Search,
  sim: Json,
  groups: List<Group>,
  classes: List<List<Int>>,
) -> Decided / {abort.raise} = {
  let runs = to_run(decisions).filter(|i: Int| case_of(program, i) != None);
  let running = set_of(runs);
  {
    search: search,
    sim: sim,
    reasons: decisions.fold(Map::new(), |acc: Map<Int, Reason>, x: Decision|
      if acc.contains(x.case.index) { acc } else { acc.insert(x.case.index, x.reason) }),
    owed: decisions.fold(Map::new(), |acc: Map<Int, Int>, x: Decision|
      if !x.case.seeded || acc.contains(x.case.index) { acc } else {
        acc.insert(x.case.index, match x.case.owed {
          Some(roots) -> roots.len(),
          None -> search.roots.len(),
        })
      }),
    runs: runs,
    running: running,
    at: flattened(classes),
    classes: groups,
    parallelism: parallelism(
      program.cases.map(|case: Case| shared(atoms_of(case))),
      scheduled_of(program, running),
      classes,
    ),
  }
}

/// Each class's number, for the members it holds: a class is what a test shares a worker with.
fn flattened(classes: List<List<Int>>) -> Map<Int, Int> =
  range(0, classes.len()).fold(Map::new(), |acc: Map<Int, Int>, i: Int|
    classes.at_or(i, []).fold(acc, |a: Map<Int, Int>, index: Int|
      if a.contains(index) { a } else { a.insert(index, i) }))

pub type Group = { tests: List<Int>, footprint: String }

/// How many of a run's tests are trivially parallel, and what the rest cost.
pub type Parallelism = {
  total: Int,
  isolated: Int,
  shared: Int,
  scheduled: Int,
  groups: Int,
  shared_groups: Int,
}

pub type Program = {
  /// The root the load was rooted at, as a report prints it.
  root: String,
  files: List<String>,
  places: List<Place>,
  modules: List<ModuleView>,
  incremental: Bool,
  phases: Phases,
  /// What the report's `front_end` says of the memo run that answered the load.
  reuse: List<Member>,
  /// Every test in the run's scope, filtered out or not: what "no `test` items" is decided over.
  declared: Int,
  /// The tests still in scope, in ascending index order.
  cases: List<Case>,
  /// Where each of `cases` is among them, by its index.
  positions: Map<Int, Int>,
  filtered_out: Int,
  warnings: List<Diag>,
  /// What the machine was configured with, placed under the key this report gives it.
  options: Json,
  /// The runtime stamp a pass is filed under beside its test's hash; `None` when the run files none.
  filed_under: Option<String>,
  /// The unit the run's tests execute in.
  unit: Int,
}

pub type Backend = {
  /// Which backend answered.
  name: String,
  fragment: Int,
  offered: Int,
  entered: Int,
  declined: Int,
  converted_in: Int,
  converted_out: Int,
  /// Absent unless the provider loaded a unit: once per worker, each load counted in `load_nanos`.
  units: Option<Int>,
  load_nanos: Option<Int>,
}

/// What a search run beside the pruned one explored; `bounded` when a spent budget or a failure
/// stopped it first.
pub type Cost = { explored: Int, bounded: Bool, rendered: String }

/// What one test's search did. Absent, never zeroed, on a test that reached no `simulate` region.
pub type Explored = {
  explored: Int,
  exhaustive: Bool,
  exhausted: Bool,
  /// `--measure-reduction` only: the same search blind to the order spawns and joins impose, and the
  /// same search unpruned.
  blind: Option<Cost>,
  naive: Option<Cost>,
  /// Tenths, so one division answers both the line and the document.
  reduction_tenths: Option<Int>,
  steps: Int,
  virtual_time_ns: Int,
  failing_seed: Option<String>,
}

pub type Outcome = {
  index: Int,
  name: String,
  hash: Option<String>,
  duration_us: Int,
  /// `passed`, `failed`, `panicked` or `abandoned`.
  status: String,
  diagnostic: Option<Raised>,
  search: Option<Explored>,
  /// `None` when nothing was written: a spent budget or an unobserved search proved nothing.
  cached: Option<Bool>,
  /// The operations the test performed, handled ones included, over every interleaving it ran.
  performs: Int,
}

pub type Culprit = { names: List<String>, at: Option<ModuleSpan> }

/// What a failure's cause came to. The runtime sends this whole shape — a program that searched
/// answers with its own verdict, and the document publishes whichever side decided.
pub type Bisect = {
  conclusive: Bool,
  requested: Bool,
  reason: String,
  culprits: List<Culprit>,
  verdict: String,
  skipped: Option<String>,
  confidence: String,
  groups: List<List<String>>,
  search: SearchStats,
}

pub type Site = { task: String, definition: Option<String>, access: String, at: Option<ModuleSpan> }

/// The two steps whose reordering at scheduling point `step` flipped a passing interleaving to this
/// one.
pub type Race = { left: Site, right: Site, step: Int }

/// One failure as the runtime reports it: what happened, and the facts its cause is decided from.
pub type Failed = {
  key: String,
  /// The label as the source wrote it.
  name: String,
  diagnostic: Raised,
  /// Two of the gate's facts; the mode is this run's own flag.
  defect: Bool,
  host: Bool,
  /// `None` when the test never passed, so there is no earlier definition set to compare against.
  search: Option<Evident>,
  /// The definitions in the closure the store has never seen pass, each with its current hash.
  suspects: List<{ name: String, hash: Option<String> }>,
  /// Nothing in this test's closure changed, which is not the same as nothing being ranked.
  unchanged: Bool,
  seed: Option<String>,
  race: Option<Race>,
  module: Option<String>,
  test_hash: Option<String>,
  nondet: Option<Bool>,
  status: Option<String>,
  /// The atoms the test's footprint declares.
  declared: Option<List<String>>,
}

/// One failure as a report shows it: the runtime's account, and what this program decided about its
/// cause.
pub type Fault = {
  key: String,
  name: String,
  diagnostic: Diag,
  defect: Bool,
  bisect: Bisect,
  /// Ranked, most likely first.
  suspects: List<Suspect>,
  unchanged: Bool,
  seed: Option<String>,
  race: Option<Race>,
  /// The command that replays the failing interleaving.
  replay: Option<String>,
  module: Option<String>,
  test_hash: Option<String>,
  nondet: Option<Bool>,
  status: Option<String>,
  declared: Option<List<String>>,
}

pub type Summary = { passed: Int, failed: Int, abandoned: Int, cached: Int, duration_us: Int }

pub type Simulated = {
  simulated: Int,
  total: Int,
  seeds: Int,
  interleavings: Int,
  exhaustive: Int,
  exhausted: Int,
  failed: Int,
}

pub type RunReport = {
  hermetic: Bool,
  /// `hermetic` or `host`.
  label: String,
  operations: Int,
  digest: String,
  handshakes: List<String>,
  hosts: Json,
  /// The tests this binding can reach, by index, ascending.
  reaches: List<Int>,
  workers: Int,
  backend: Option<Backend>,
  results: List<Outcome>,
  failures: List<Failed>,
  summary: Summary,
  simulation: Simulated,
  /// Not warnings: every later run believes an escaped cache entry.
  escapes: List<Diag>,
  warnings: List<Diag>,
  mutants: Option<Mutants>,
  coverage: Option<Coverage>,
  spent: Spent,
}

/// Where a run's time went, in microseconds of its clock: before the load began, then each phase
/// after it. The load's own phases are `Phases`.
pub type Spent = {
  before_us: Int,
  promises_us: Int,
  store_us: Int,
  selection_us: Int,
  handoff_us: Int,
  unit_us: Int,
  bind_us: Int,
  tests_us: Int,
  conclude_us: Int,
}

pub fn no_spent() -> Spent =
  {
    before_us: 0,
    promises_us: 0,
    store_us: 0,
    selection_us: 0,
    handoff_us: 0,
    unit_us: 0,
    bind_us: 0,
    tests_us: 0,
    conclude_us: 0,
  }

// --- Small things -----------------------------------------------------------

fn opt_bool(v: Option<Bool>) -> Json = match v { Some(b) -> Bool(b), None -> Null }

fn covers(xs: List<Int>, wanted: Int) -> Bool = xs.filter(|x: Int| x == wanted).len() > 0

fn no_group() -> Group = { tests: [], footprint: "" }

fn no_culprit() -> Culprit = { names: [], at: None }

// --- Fixed point ------------------------------------------------------------

fn ms_tenths(us: Int) -> String = fixed_point((us + 50) / 100, 1)

fn ms_hundredths(us: Int) -> String = fixed_point((us + 5) / 10, 2)

fn ms_thousandths(us: Int) -> String = fixed_point(us, 3)

fn secs_hundredths(us: Int) -> String = fixed_point((us + 5000) / 10000, 2)

fn ns_as_ms_tenths(ns: Int) -> String = fixed_point((ns + 50000) / 100000, 1)

/// Per mille is tenths of a percent, so one division answers both digits.
fn share(part: Int, total: Int) -> String =
  fixed_point(if total == 0 { 0 } else { part * 1000 / total }, 1).pad_left(5, " ") ++ "%"

fn millis(us: Int) -> Json =
  Number(Decimal::of_string(ms_thousandths(us)).unwrap_or(Decimal::of_int(0)))

// --- Naming and placing -----------------------------------------------------

/// The label in a single-module run, `<module>.<label>` otherwise.
pub fn display_of(program: Program, case: Case) -> String =
  if program.modules.len() > 1 { case.key } else { case.name }

fn short_of(hash: Option<String>) -> String / {abort.raise} =
  match hash { Some(h) -> h.slice(0, 12), None -> "-".repeat(12) }

fn dim_place(style: Style, places: List<Place>, a: Option<ModuleSpan>) -> String / {abort.raise} =
  match a {
    None -> "",
    Some(spot) -> match located(places, spot) {
      Some(text) -> "   " ++ dim(style, text),
      None -> "",
    },
  }

pub fn primary_of(diag: Diag) -> Option<Label> =
  diag.labels.fold(None, |acc: Option<Label>, label: Label|
    match acc { Some(_) -> acc, None -> if label.primary { Some(label) } else { None } })

fn label_at(label: Label) -> ModuleSpan =
  { module: label.module, start: label.start, end: label.end }

fn location_json(places: List<Place>, diag: Diag) -> Json / {abort.raise} =
  match primary_of(diag) { None -> Null, Some(l) -> place_json(places, label_at(l)) }

fn one_diagnostic(diag: Diag, places: List<Place>) -> Json / {abort.raise} =
  match all_to_json([diag], places) { Array(xs) -> xs.at_or(0, Null), other -> other }

// --- What the selection decided ---------------------------------------------

/// The document spells a reason as one word, so the halves of a name are joined rather than spaced.
fn keyed(reason: String) -> String = String::join(reason.split(" "), "_")

fn why(reason: String) -> String =
  if reason == "new" { "this hash has never gone green, so nothing is known about it" }
  else if reason == "changed" {
    "something its last pass read has changed since, so that pass no longer answers for it"
  } else if reason == "previous failure" {
    "the cache holds a failure, and a failure is never trusted"
  } else if reason == "cached" {
    "this exact hash already passed; re-running cannot reveal anything new"
  } else if reason == "same code" {
    "this hash is new, but the code it compiles to already passed; re-running cannot reveal anything new"
  } else { "no hash was produced, so the cache cannot answer for it" }

/// `region`, `shared` or `host`: a socket lives outside every region, so a host-backed test is not
/// isolated.
pub fn isolated_as(reaches: List<Int>, case: Case) -> String =
  isolation_word(isolation_of(reported(reaches, case)))

// --- The head ---------------------------------------------------------------

// Printed before a test runs, so it says only what the selection and the binding decided.

/// What the binding says before a test runs: which tests it reaches, and how many run at once.
pub type Opening = {
  hermetic: Bool,
  operations: Int,
  digest: String,
  reaches: List<Int>,
  workers: Int,
}

fn workers_of(options: Options, hosted: Hosted) -> Int =
  match options.jobs { Some(n) -> if n > 0 { n } else { hosted.cores }, None -> hosted.cores }

pub fn opening_of(options: Options, program: Program, hosted: Hosted) -> Opening =
  {
    hermetic: hosted.hermetic,
    operations: hosted.operations,
    digest: hosted.digest,
    reaches: hosted.reaches.filter(|i: Int| case_of(program, i) != None),
    workers: workers_of(options, hosted),
  }

fn selected_line(style: Style, program: Program, decided: Decided) -> String =
  indent() ++ bold(style, "selected") ++ " "
    ++ bold(style, selected_count(program, decided).to_string())
    ++ " of "
    ++ program.cases.len().to_string()
    ++ " ("
    ++ cached_count(program, decided).to_string()
    ++ " cached"
    ++ (match by_code_count(program, decided) { 0 -> "", n -> ", " ++ n.to_string() ++ " by code" })
    ++ ")"

fn group_line(decided: Decided, workers: Int) -> List<String> / {abort.raise} =
  if decided.classes.len() == 0 { [] } else {
    [indent() ++ count_of(decided.classes.len(), "group") ++ " · " ++ count_of(workers, "worker")]
  }

fn isolated_line(style: Style, c: Counts) -> List<String> / {abort.raise} =
  if c.total == 0 { [] } else {
    let contending = if c.shared == 0 { "" }
    else { dim(style, " · " ++ count_of(c.shared, "test") ++ " can contend") };
    [
      indent() ++ bold(style, "isolated") ++ " " ++ bold(style, c.isolated.to_string()) ++ " of "
        ++ c.total.to_string()
        ++ contending,
    ]
  }

pub fn binding_lines(style: Style, o: Opening, c: Counts) -> List<String> / {abort.raise} =
  if o.hermetic { [] } else {
    [
      indent() ++ bold(style, "host") ++ " " ++ bold(style, c.host.to_string()) ++ " of "
        ++ c.total.to_string()
        ++ " · "
        ++ dim(style, "cached by what each read"),
      indent()
        ++ dim(
          style,
          "binding host · " ++ count_of(o.operations, "operation") ++ " · " ++ o.digest,
        ),
    ]
  }

/// What the tests' connections came to, which only the run itself knows.
pub fn handshake_lines(style: Style, report: RunReport) -> List<String> =
  if report.hermetic { [] }
  else { report.handshakes.map(|line: String| indent() ++ dim(style, line)) }

/// `simulated: 3 of 47 · 61 interleavings · 3 exhaustive`.
pub fn simulation_line(style: Style, report: RunReport) -> List<String> / {abort.raise} =
  if report.simulation.simulated == 0 { [] } else {
    let c = report.simulation;
    let head = "simulated: " ++ c.simulated.to_string() ++ " of " ++ c.total.to_string() ++ " · "
      ++ count_of(c.interleavings, "interleaving");
    let thorough = if c.exhaustive == 0 { head }
    else { head ++ " · " ++ c.exhaustive.to_string() ++ " exhaustive" };
    let spent = if c.exhausted == 0 { thorough }
    else { thorough ++ " · " ++ c.exhausted.to_string() ++ " budget spent, not cached" };
    [indent() ++ bold(style, spent)]
  }

/// Apart from the entry counts: a unit is loaded once per worker. Making it is the run's `unit` phase.
fn compiled_line(style: Style, b: Backend) -> List<String> =
  match b.units {
    None -> [],
    Some(units) ->
      [
        indent()
          ++ dim(
            style,
            "loaded " ++ units.to_string() ++ " unit(s) in "
              ++ ns_as_ms_tenths(match b.load_nanos { Some(n) -> n, None -> 0 })
              ++ "ms",
          ),
      ],
  }

fn backend_lines(style: Style, report: RunReport) -> List<String> =
  match report.backend {
    None -> [],
    Some(b) ->
      [
        indent() ++ bold(style, "backend") ++ " " ++ bold(style, b.name) ++ " · "
          ++ b.entered.to_string()
          ++ " of "
          ++ b.offered.to_string()
          ++ " offers entered · "
          ++ b.declined.to_string()
          ++ " declined · "
          ++ b.fragment.to_string()
          ++ " in the fragment",
      ].concat(
        compiled_line(style, b),
      ),
  }

fn bypass_lines(style: Style, flags: Flags) -> List<String> =
  if !flags.no_cache { [] }
  else { [indent() ++ dim(style, "--no-cache: results were neither read nor recorded")] }

fn filtered_lines(style: Style, program: Program) -> List<String> / {abort.raise} =
  if program.filtered_out == 0 { [] }
  else { [indent() ++ dim(style, "--filter hid " ++ count_of(program.filtered_out, "test"))] }

fn head_lines(
  style: Style,
  flags: Flags,
  program: Program,
  decided: Decided,
  o: Opening,
) -> List<String> / {abort.raise} = {
  let c = counts_of(program, o.reaches);
  [selected_line(style, program, decided)].concat(group_line(decided, o.workers)).concat(
    isolated_line(style, c),
  ).concat(
    binding_lines(style, o, c),
  ).concat(
    bypass_lines(style, flags),
  ).concat(
    filtered_lines(style, program),
  )
}

/// The report as far as it goes before a test runs: the head, what `--explain` can say of the
/// selection, and the blank line the results follow.
pub fn opening_lines(
  style: Style,
  flags: Flags,
  program: Program,
  decided: Decided,
  o: Opening,
) -> List<String> / {abort.raise} =
  head_lines(style, flags, program, decided, o).concat(if flags.explain {
    explain_lines(style, program, o.reaches, decided)
  } else { [] }).concat(if decided.classes.len() == 0 { [] } else { [""] })

/// What the run itself came to, under its results: the connections, the backend and the search.
fn run_lines(style: Style, report: RunReport) -> List<String> / {abort.raise} =
  handshake_lines(style, report).concat(backend_lines(style, report)).concat(
    simulation_line(style, report),
  )

// --- Where the time went ----------------------------------------------------

type Phase = { label: String, us: Int }

/// Longest first, so what dominated a run is read first, and ties stay in the order measured.
fn ordered(rows: List<Phase>) -> List<Phase> =
  rows.fold([], |acc: List<Phase>, p: Phase|
    acc.filter(|q: Phase| q.us >= p.us).push(p).concat(acc.filter(|q: Phase| q.us < p.us)))

fn phase_rows(phases: Phases) -> List<Phase> =
  ordered([
    { label: "read", us: phases.read_us },
    { label: "front", us: phases.front_us },
    { label: "write back", us: phases.write_back_us },
  ])

fn phase_total(phases: Phases) -> Int = phases.read_us + phases.front_us + phases.write_back_us

fn phase_line(style: Style, phase: Phase, total: Int) -> String =
  indent() ++ "  " ++ phase.label.pad_right(11, " ") ++ " "
    ++ ms_hundredths(phase.us).pad_left(8, " ")
    ++ "ms "
    ++ dim(style, share(phase.us, total))

pub fn phase_lines(style: Style, phases: Phases) -> List<String> = {
  let total = phase_total(phases);
  ["", indent() ++ bold(style, "front-end time")].concat(
    phase_rows(phases).map(|phase: Phase| phase_line(style, phase, total)),
  ).concat([
    indent() ++ "  " ++ "total".pad_right(11, " ") ++ " " ++ ms_hundredths(total).pad_left(8, " ")
      ++ "ms",
  ])
}

fn run_rows(phases: Phases, x: Spent) -> List<Phase> =
  [
    { label: "before", us: x.before_us },
    { label: "load", us: phase_total(phases) },
    { label: "promises", us: x.promises_us },
    { label: "store", us: x.store_us },
    { label: "selection", us: x.selection_us },
    { label: "handoff", us: x.handoff_us },
    { label: "unit", us: x.unit_us },
    { label: "bind", us: x.bind_us },
    { label: "tests", us: x.tests_us },
    { label: "conclude", us: x.conclude_us },
  ]

pub fn run_total(phases: Phases, x: Spent) -> Int =
  run_rows(phases, x).fold(0, |n: Int, phase: Phase| n + phase.us)

pub fn run_phase_lines(style: Style, phases: Phases, x: Spent) -> List<String> = {
  let total = run_total(phases, x);
  ["", indent() ++ bold(style, "run time")].concat(
    ordered(run_rows(phases, x)).map(|phase: Phase| phase_line(style, phase, total)),
  ).concat([
    indent() ++ "  " ++ "total".pad_right(11, " ") ++ " " ++ ms_hundredths(total).pad_left(8, " ")
      ++ "ms",
  ])
}

fn run_phases_json(phases: Phases, x: Spent) -> Json =
  object(
    run_rows(phases, x).map(|phase: Phase| { key: phase.label, value: millis(phase.us) }).push({
      key: "total",
      value: millis(run_total(phases, x)),
    }),
  )

// --- `--explain` ------------------------------------------------------------

fn explain_atoms(iso: String, case: Case) -> String =
  if iso == "region" { "" } else { " " ++ shared_of(case) }

fn case_line(
  style: Style,
  program: Program,
  reaches: List<Int>,
  case: Case,
  decided: Decided,
) -> String / {abort.raise} = {
  let iso = isolated_as(reaches, case);
  let reason = word(reason_of(decided, case.index));
  let verb = if runs_test(decided, case.index) { bold(style, "run ") } else { dim(style, "skip") };
  indent() ++ verb ++ " " ++ dim(style, short_of(case.hash)) ++ " " ++ reason.pad_right(16, " ")
    ++ " "
    ++ display_of(program, case).pad_right(40, " ")
    ++ " "
    ++ dim(
      style,
      "isolation: " ++ iso ++ explain_atoms(iso, case)
        ++ (if case.seeded { " · searched" } else { "" })
        ++ (match moved_of(decided, case.index) {
          Some(what) -> " · moved: " ++ what,
          None -> "",
        }),
    )
}

/// What a pass is filed under.
fn key_lines(style: Style, program: Program) -> List<String> / {abort.raise} = {
  let filed = match program.filed_under {
    Some(stamp) ->
      "a pass is filed under its test's hash and the runtime stamp " ++ short_of(Some(stamp))
        ++ ", and under the code the test ran, with what its run read",
    None -> "no pass is filed: `--no-cache` reads and writes none",
  };
  ["", indent() ++ dim(style, "key"), indent() ++ "  " ++ dim(style, filed)]
}

fn reasons_seen(program: Program, decided: Decided) -> List<String> =
  program.cases.fold([], |acc: List<String>, case: Case| {
    let reason = word(reason_of(decided, case.index));
    if acc.contains(reason) { acc } else { acc.push(reason) }
  })

fn why_lines(style: Style, program: Program, decided: Decided) -> List<String> = {
  let seen = reasons_seen(program, decided);
  if seen.len() == 0 { [] } else {
    ["", indent() ++ dim(style, "why")].concat(
      seen.map(|reason: String|
        indent() ++ "  " ++ reason.pad_right(16, " ") ++ " " ++ dim(style, why(reason))),
    )
  }
}

fn owed_line(
  style: Style,
  program: Program,
  case: Case,
  decided: Decided,
) -> List<String> / {abort.raise} =
  if owed_of(decided, case.index) == decided.search.roots.len() { [] } else {
    [
      indent() ++ "  "
        ++ dim(
          style,
          display_of(program, case) ++ ": " ++ owed_of(decided, case.index).to_string() ++ " of "
            ++ count_of(decided.search.roots.len(), "seed")
            ++ " still owed; the rest already passed on their own",
        ),
    ]
  }

/// What the seeded tests will search, and what each of them still owes.
fn search_lines(style: Style, program: Program, decided: Decided) -> List<String> / {abort.raise} = {
  let seeded = program.cases.filter(|case: Case| case.seeded);
  if seeded.len() == 0 { [] } else {
    let head = [
      "",
      indent() ++ dim(style, "search"),
      indent() ++ "  "
        ++ dim(
          style,
          decided.search.mode ++ " · " ++ count_of(decided.search.roots.len(), "seed")
            ++ " · budget "
            ++ decided.search.budget.to_string()
            ++ " · steps "
            ++ decided.search.steps.to_string(),
        ),
      indent() ++ "  "
        ++ dim(
          style,
          seeded.len().to_string() ++ " of " ++ count_of(program.cases.len(), "test")
            ++ " keyed on this plan and never on their bare hash",
        ),
    ];
    seeded.fold(head, |acc: List<String>, case: Case|
      acc.concat(owed_line(style, program, case, decided)))
  }
}

/// Grouped like any other test, but a host-backed test is never free.
fn group_tally(style: Style, c: Counts, decided: Decided) -> String / {abort.raise} = {
  let hosted = if c.host == 0 { "" }
  else { " · " ++ c.host.to_string() ++ " host-backed and never free" };
  indent() ++ "  "
    ++ dim(
      style,
      c.isolated.to_string() ++ " of " ++ c.total.to_string() ++ " region-isolated and free · "
        ++ count_of(decided.parallelism.shared_groups, "group")
        ++ " for the "
        ++ c.shared.to_string()
        ++ " shared "
        ++ plural(c.shared, "test")
        ++ hosted,
    )
}

fn named_of(program: Program, index: Int) -> String =
  match case_of(program, index) { Some(case) -> display_of(program, case), None -> "" }

fn group_block(
  style: Style,
  program: Program,
  decided: Decided,
  lines: List<String>,
  i: Int,
) -> List<String> / {abort.raise} = {
  let g: Group = decided.classes.at_or(i, no_group());
  let head = lines.push(
    indent() ++ "  group " ++ i.to_string() ++ " · " ++ count_of(g.tests.len(), "test") ++ " · "
      ++ dim(style, g.footprint),
  );
  g.tests.fold(head, |acc: List<String>, index: Int| {
    let named = named_of(program, index);
    if named == "" { acc } else { acc.push(indent() ++ "    " ++ named) }
  })
}

fn concurrency_lines(
  style: Style,
  program: Program,
  c: Counts,
  decided: Decided,
) -> List<String> / {abort.raise} =
  if decided.classes.len() == 0 { [] } else {
    range(0, decided.classes.len()).fold(
      ["", indent() ++ dim(style, "concurrency groups"), group_tally(style, c, decided)],
      |acc: List<String>, i: Int| group_block(style, program, decided, acc, i),
    )
  }

pub fn explain_lines(
  style: Style,
  program: Program,
  reaches: List<Int>,
  dec: Decided,
) -> List<String> / {abort.raise} =
  [""].concat(program.cases.map(|case: Case| case_line(style, program, reaches, case, dec))).concat(
    why_lines(style, program, dec).concat(key_lines(style, program)),
  ).concat(
    search_lines(style, program, dec),
  ).concat(
    concurrency_lines(style, program, counts_of(program, reaches), dec),
  ).concat(
    phase_lines(style, program.phases),
  )

// --- One test's line --------------------------------------------------------

fn glyph_of(status: String) -> String =
  if status == "passed" { "✓" }
  else if status == "failed" { "✗" }
  else if status == "panicked" { "!" }
  else { "–" }

fn word_of(status: String) -> String =
  if status == "passed" { "ok" }
  else if status == "failed" { "FAIL" }
  else if status == "panicked" { "PANIC" }
  else { "GAVE UP" }

fn painted_glyph(style: Style, status: String) -> String = {
  let glyph = glyph_of(status);
  if status == "passed" { green(style, glyph) }
  else if status == "failed" { red(style, glyph) }
  else if status == "panicked" { yellow(style, glyph) }
  else { dim(style, glyph) }
}

/// A styled mark is one glyph wide whatever escapes it carries, so the column is measured over the
/// word rather than over the paint.
fn marked(style: Style, status: String) -> String =
  if styles(style) { painted_glyph(style, status) } else { word_of(status).pad_right(7, " ") }

fn result_name(program: Program, outcome: Outcome) -> String =
  match case_of(program, outcome.index) {
    Some(case) -> display_of(program, case),
    None -> outcome.name,
  }

/// Over the tests the run will run, since their lines are printed as their groups finish.
pub fn name_column(program: Program, decided: Decided) -> Int = {
  let widest = decided.classes.fold(0, |acc: Int, g: Group|
    g.tests.fold(acc, |most: Int, index: Int| {
      let n = named_of(program, index).len();
      if n > most { n } else { most }
    }));
  if widest < 24 { 24 } else if widest > 64 { 64 } else { widest }
}

pub fn result_line(style: Style, program: Program, outcome: Outcome, width: Int) -> String =
  indent() ++ marked(style, outcome.status) ++ " "
    ++ result_name(program, outcome).pad_right(width, " ")
    ++ " "
    ++ ms_tenths(outcome.duration_us).pad_left(8, " ")
    ++ "ms"

/// A bounded naive count makes the ratio a lower bound.
fn reduction_part(e: Explored, naive: Cost) -> List<String> =
  match e.reduction_tenths {
    None -> [],
    Some(tenths) ->
      [
        (if naive.bounded { ">= " } else { "" }) ++ fixed_point((tenths + 5) / 10, 0)
          ++ "× reduction",
      ],
  }

/// What one test's search did, under its result line.
fn search_parts(e: Explored) -> List<String> / {abort.raise} = {
  let head = [count_of(e.explored, "interleaving")];
  let thorough = if e.exhaustive { head.push("exhaustive") } else { head };
  let spent = if e.exhausted { thorough.push("budget spent — not cached") } else { thorough };
  let blind = match e.blind { None -> spent, Some(b) -> spent.push("blind " ++ b.rendered) };
  match e.naive {
    None -> blind,
    Some(naive) -> blind.push("naive " ++ naive.rendered).concat(reduction_part(e, naive)),
  }
}

pub fn result_lines(
  style: Style,
  program: Program,
  outcomes: List<Outcome>,
  width: Int,
) -> List<String> / {abort.raise} =
  outcomes.fold([], |acc: List<String>, outcome: Outcome| {
    let listed = acc.push(result_line(style, program, outcome, width));
    match outcome.search {
      None -> listed,
      Some(e) ->
        listed.push(indent() ++ "    " ++ dim(style, String::join(search_parts(e), " · "))),
    }
  })

// --- The summary ------------------------------------------------------------

/// `host` sits beside `cached`: a host-backed pass stands only while what it read does.
pub fn summary_line(style: Style, report: RunReport, counted: Counts) -> String = {
  let c = report.summary;
  let failures = c.failed.to_string() ++ " failed";
  let passes = c.passed.to_string() ++ " passed";
  let hosted = if counted.host == 0 { "" }
  else { dim(style, ", " ++ counted.host.to_string() ++ " host-backed") };
  let given_up = if c.abandoned == 0 { "" }
  else { yellow(style, ", " ++ c.abandoned.to_string() ++ " abandoned") };
  indent() ++ (if c.failed > 0 { red(style, failures) } else { dim(style, failures) }) ++ ", "
    ++ (if c.passed > 0 { green(style, passes) } else { dim(style, passes) })
    ++ ", "
    ++ c.cached.to_string()
    ++ " cached"
    ++ hosted
    ++ given_up
    ++ " ("
    ++ secs_hundredths(c.duration_us)
    ++ "s)"
}

// --- One failure ------------------------------------------------------------

fn culprit_line(
  style: Style,
  places: List<Place>,
  c: Culprit,
  first: Bool,
) -> String / {abort.raise} =
  "  " ++ red(style, if first { "culprit:" } else { "        " }) ++ " "
    ++ String::join(c.names, " + ")
    ++ dim_place(style, places, c.at)

/// The culprit before the diff: the culprit is the answer.
pub fn bisect_lines(style: Style, places: List<Place>, b: Bisect) -> List<String> / {abort.raise} =
  if b.conclusive {
    range(0, b.culprits.len()).fold([], |acc: List<String>, i: Int|
      acc.push(culprit_line(style, places, b.culprits.at_or(i, no_culprit()), i == 0))).push(
      "    " ++ dim(style, b.reason),
    )
  }
  // Silent when no bisection was asked for.
  else if !b.requested { [] }
  else { ["  " ++ dim(style, "no culprit:") ++ " " ++ b.reason] }

fn note_lines(style: Style, diag: Diag) -> List<String> =
  diag.notes_text.map(|n: Bytes| "  " ++ dim(style, "=") ++ " " ++ String::of_bytes_lossy(n))

/// A deadlock's cycle lives only in its secondary labels.
pub fn secondary_lines(
  style: Style,
  places: List<Place>,
  diag: Diag,
) -> List<String> / {abort.raise} =
  diag.labels.filter(|label: Label| !label.primary).map(|label: Label|
    "    " ++ String::of_bytes_lossy(label.text) ++ dim_place(style, places, Some(label_at(label))))

pub fn at_lines(style: Style, places: List<Place>, diag: Diag) -> List<String> / {abort.raise} =
  match primary_of(diag) {
    None -> [],
    Some(l) -> match located(places, label_at(l)) {
      None -> [],
      Some(text) -> ["    at " ++ dim(style, text)],
    },
  }

fn site_line(style: Style, places: List<Place>, site: Site, first: Bool) -> String / {abort.raise} =
  "  " ++ yellow(style, if first { "race:" } else { "     " }) ++ " " ++ site.task ++ "  "
    ++ (match site.definition { Some(d) -> d, None -> "-" })
    ++ "   "
    ++ site.access
    ++ dim_place(style, places, site.at)

fn race_lines(style: Style, places: List<Place>, fault: Fault) -> List<String> / {abort.raise} =
  match fault.race {
    None -> [],
    Some(race) ->
      [site_line(style, places, race.left, true), site_line(style, places, race.right, false)],
  }

fn replay_lines(style: Style, fault: Fault) -> List<String> =
  match fault.replay {
    None -> [],
    Some(command) -> ["  " ++ dim(style, "replay:") ++ " " ++ command],
  }

/// The repro, which is a seed rather than a stack trace.
pub fn seed_lines(style: Style, places: List<Place>, fault: Fault) -> List<String> / {abort.raise} =
  match fault.seed {
    None -> [],
    Some(seed) ->
      ["  " ++ dim(style, "seed:") ++ " " ++ seed].concat(race_lines(style, places, fault)).concat(
        replay_lines(style, fault),
      ),
  }

pub fn described(x: Suspect) -> String =
  match x.change { Some(c) -> x.name ++ " (" ++ kind_word(c) ++ ")", None -> x.name }

fn suspect_lines(style: Style, fault: Fault) -> List<String> = {
  let rest = fault.suspects.filter(|x: Suspect| !x.culprit).map(described);
  if rest.len() > 0 { ["  " ++ yellow(style, "suspects:") ++ " " ++ String::join(rest, ", ")] }
  else if fault.unchanged {
    ["  " ++ dim(style, "suspects: none — nothing in this test's closure changed")]
  } else { [] }
}

fn failure_lines(style: Style, places: List<Place>, fault: Fault) -> List<String> / {abort.raise} =
  [bold(style, fault.key)].concat(bisect_lines(style, places, fault.bisect)).concat([
    "  " ++ String::of_bytes_lossy(fault.diagnostic.message),
  ]).concat(
    at_lines(style, places, fault.diagnostic),
  ).concat(
    secondary_lines(style, places, fault.diagnostic),
  ).concat(
    note_lines(style, fault.diagnostic),
  ).concat(
    seed_lines(style, places, fault),
  ).concat(
    suspect_lines(style, fault),
  )

fn failure_blocks(
  style: Style,
  program: Program,
  faults: List<Fault>,
) -> List<String> / {abort.raise} =
  faults.fold([], |acc: List<String>, fault: Fault|
    acc.push("").concat(failure_lines(style, program.places, fault).map(|l: String| indent() ++ l)))

/// A test the clock stopped: no culprit, no suspects, nothing to bisect — the machine ran out of
/// patience, and what the test would have decided is still unknown.
fn abandoned_lines(
  style: Style,
  places: List<Place>,
  outcome: Outcome,
) -> List<String> / {abort.raise} = {
  let head = [bold(style, outcome.name) ++ " " ++ yellow(style, "abandoned")];
  match outcome.diagnostic {
    None -> head,
    Some(r) -> {
      let d = shown(r);
      head.push("  " ++ String::of_bytes_lossy(d.message)).concat(
        at_lines(style, places, d),
      ).concat(
        note_lines(style, d),
      )
    },
  }
}

fn abandoned_blocks(
  style: Style,
  program: Program,
  report: RunReport,
) -> List<String> / {abort.raise} =
  report.results.filter(|outcome: Outcome| outcome.status == "abandoned").fold(
    [],
    |acc: List<String>, outcome: Outcome|
      acc.push("").concat(
        abandoned_lines(style, program.places, outcome).map(|l: String| indent() ++ l),
      ),
  )

// --- Coverage and mutants ---------------------------------------------------

fn unreached_lines(style: Style, names: List<String>) -> List<String> =
  names.map(|n: String| indent() ++ indent() ++ dim(style, n ++ ": no test reaches it"))

fn coverage_lines(style: Style, report: RunReport) -> List<String> =
  match report.coverage {
    None -> [],
    Some(c) ->
      [
        indent() ++ bold(style, "coverage") ++ " "
          ++ Int::to_string(c.definitions - c.unreached.len())
          ++ " of "
          ++ c.definitions.to_string()
          ++ " definitions reached by a test",
      ].concat(
        unreached_lines(style, c.unreached),
      ),
  }

fn survivor_line(style: Style, places: List<Place>, m: Survivor) -> String / {abort.raise} = {
  let spot = match m.at {
    None -> "",
    Some(a) -> match located(places, a) { Some(text) -> text, None -> "" },
  };
  indent() ++ indent() ++ red(style, m.definition) ++ " survives `" ++ m.from ++ "` -> `" ++ m.to
    ++ "` at "
    ++ dim(style, spot)
}

fn mutant_lines(style: Style, program: Program, report: RunReport) -> List<String> / {abort.raise} =
  match report.mutants {
    None -> [],
    Some(m) -> {
      let tally = m.killed.to_string() ++ " killed, " ++ m.survived.to_string() ++ " survived, "
        ++ m.skipped.to_string()
        ++ " skipped"
        ++ (if m.budget_spent { ", budget spent" } else { "" });
      [indent() ++ bold(style, "mutants") ++ " " ++ bold(style, tally)].concat(
        unreached_lines(style, m.unreached),
      ).concat(
        m.survivors.map(|x: Survivor| survivor_line(style, program.places, x)),
      )
    },
  }

fn no_tests_note(flags: Flags, program: Program) -> String =
  if program.declared == 0 { "no `test` items in this program" } else if flags.filters.len() > 0 {
    "no test key contains a `--filter` substring; nothing was verified"
  } else { "nothing to report" }

// --- The document -----------------------------------------------------------

/// A case of a test over cases says so: the test it is a case of, and its place and identity there.
fn case_of_json(case: Case) -> List<Member> / {abort.raise} =
  match case.entry.case {
    None -> [],
    Some(c) ->
      [
        {
          key: "case",
          value: object([
            { key: "at", value: int(c.at) },
            { key: "identity", value: Str(c.identity.hex_of()) },
            { key: "of", value: Str(String::of_bytes_lossy(case.entry.of)) },
          ]),
        },
      ],
  }

pub fn case_json(report: RunReport, case: Case, decided: Decided) -> Json / {abort.raise} =
  object(
    case_of_json(case).concat([
      { key: "index", value: int(case.index) },
      { key: "key", value: Str(case.key) },
      { key: "name", value: Str(case.name) },
      { key: "module", value: Str(case.module) },
      { key: "hash", value: string_or_null(case.hash) },
      { key: "nondet", value: Bool(case.nondet) },
      { key: "selected", value: Bool(runs_test(decided, case.index)) },
      { key: "reason", value: Str(keyed(word(reason_of(decided, case.index)))) },
      { key: "why", value: Str(why(word(reason_of(decided, case.index)))) },
      { key: "moved", value: string_or_null(moved_of(decided, case.index)) },
      { key: "group", value: int_or_null(group_of(decided, case.index)) },
      { key: "footprint", value: Str(case.footprint) },
      { key: "isolation", value: Str(isolated_as(report.reaches, case)) },
      // Whether this test reaches the binding.
      { key: "host", value: Bool(covers(report.reaches, case.index)) },
      { key: "shared_atoms", value: strings(shared_texts(case)) },
      // The same atoms unprinted, as the scheduler compares them, and whether the test is handed a
      // seed: what a program re-colouring the run needs, without parsing a printed atom.
      { key: "contends", value: Array(shared(atoms_of(case)).map(atom_json)) },
      { key: "seeded", value: Bool(case.seeded) },
      // Footprint atoms this binary answers from what it ships, which no pass key covers.
    ]),
  )

fn atom_json(a: Atom) -> Json =
  object([
    { key: "effect", value: Str(a.effect) },
    { key: "resource", value: Str(a.resource) },
    { key: "writes", value: Bool(a.writes) },
  ])

fn group_json(decided: Decided, i: Int) -> Json = {
  let g: Group = decided.classes.at_or(i, no_group());
  object([
    { key: "index", value: int(i) },
    { key: "tests", value: Array(g.tests.map(|x: Int| int(x))) },
    { key: "footprint", value: Str(g.footprint) },
  ])
}

fn cost_json(v: Option<Cost>) -> Json =
  match v {
    None -> Null,
    Some(c) ->
      object([
        { key: "explored", value: int(c.explored) },
        { key: "bounded", value: Bool(c.bounded) },
        { key: "rendered", value: Str(c.rendered) },
      ]),
  }

fn search_json(e: Explored) -> Json =
  object([
    { key: "explored", value: int(e.explored) },
    { key: "exhaustive", value: Bool(e.exhaustive) },
    { key: "exhausted", value: Bool(e.exhausted) },
    { key: "blind", value: cost_json(e.blind) },
    { key: "naive", value: cost_json(e.naive) },
    {
      key: "reduction",
      value: match e.reduction_tenths {
        Some(t) -> Number(Decimal::of_string(fixed_point(t, 1)).unwrap_or(Decimal::of_int(0))),
        None -> Null,
      },
    },
    { key: "steps", value: int(e.steps) },
    { key: "virtual_time_ns", value: int(e.virtual_time_ns) },
    { key: "failing_seed", value: string_or_null(e.failing_seed) },
  ])

pub fn case_of(program: Program, index: Int) -> Option<Case> =
  match program.positions.get(index) { Some(place) -> program.cases.at(place), None -> None }

/// Where each case is among `cases`, by its index; the first of an index stands for it.
pub fn placed_cases(cases: List<Case>) -> Map<Int, Int> =
  range(0, cases.len()).fold(Map::new(), |acc: Map<Int, Int>, place: Int|
    match cases.at(place) {
      Some(case) -> if acc.contains(case.index) { acc } else { acc.insert(case.index, place) },
      None -> acc,
    })

fn outcome_json(program: Program, outcome: Outcome, d: Decided) -> Json / {abort.raise} = {
  let named = case_of(program, outcome.index);
  object([
    { key: "index", value: int(outcome.index) },
    { key: "key", value: match named { Some(c) -> Str(c.key), None -> Null } },
    { key: "name", value: Str(match named { Some(c) -> c.name, None -> outcome.name }) },
    { key: "module", value: match named { Some(c) -> Str(c.module), None -> Null } },
    { key: "hash", value: string_or_null(outcome.hash) },
    { key: "group", value: int(match group_of(d, outcome.index) { Some(g) -> g, None -> 0 }) },
    { key: "status", value: Str(outcome.status) },
    { key: "duration_ms", value: millis(outcome.duration_us) },
    {
      key: "diagnostic",
      value: match outcome.diagnostic {
        Some(r) -> one_diagnostic(shown(r), program.places),
        None -> Null,
      },
    },
    // Absent, never zeroed, when no region was reached.
    { key: "simulation", value: match outcome.search { Some(e) -> search_json(e), None -> Null } },
    { key: "cached", value: opt_bool(outcome.cached) },
    { key: "performs", value: int(outcome.performs) },
  ])
}

/// A place as the artifact carries one: the source and the byte range.
fn span_json(a: Option<ModuleSpan>) -> Json =
  match a {
    None -> Null,
    Some(at) ->
      object([
        { key: "source", value: int(at.module) },
        { key: "start", value: int(at.start) },
        { key: "end", value: int(at.end) },
      ]),
  }

fn site_json(x: Site) -> Json =
  object([
    { key: "task", value: Str(x.task) },
    { key: "definition", value: string_or_null(x.definition) },
    { key: "access", value: Str(x.access) },
    { key: "span", value: span_json(x.at) },
  ])

fn race_json(v: Option<Race>) -> Json =
  match v {
    None -> Null,
    Some(race) ->
      object([
        { key: "at", value: int(race.step) },
        { key: "left", value: site_json(race.left) },
        { key: "right", value: site_json(race.right) },
      ]),
  }

/// The failure artifact: what failed and where, whether it is Ply's fault, how to replay it, and the
/// cause this program decided, led by the culprit.
pub fn fault_json(program: Program, fault: Fault) -> Json / {abort.raise} =
  object([
    { key: "key", value: Str(fault.key) },
    { key: "name", value: Str(fault.name) },
    { key: "diagnostic", value: one_diagnostic(fault.diagnostic, program.places) },
    // Whether to go and read the program or go and report a bug in Ply.
    { key: "defect", value: Bool(fault.defect) },
    { key: "seed", value: string_or_null(fault.seed) },
    { key: "replay", value: string_or_null(fault.replay) },
    // Only when the search actually observed the flip.
    { key: "race", value: race_json(fault.race) },
    { key: "culprit", value: culprit_json(fault.bisect) },
    { key: "suspects", value: Array(fault.suspects.map(suspect_json)) },
    { key: "module", value: string_or_null(fault.module) },
    { key: "test_hash", value: string_or_null(fault.test_hash) },
    { key: "nondet", value: opt_bool(fault.nondet) },
    { key: "status", value: string_or_null(fault.status) },
    { key: "location", value: location_json(program.places, fault.diagnostic) },
    {
      key: "footprint",
      value: object([{ key: "declared", value: strings_or_null(fault.declared) }]),
    },
  ])

/// The verdict as the document carries it: what to change, how sure the system is, and how it
/// found out. Built here rather than read from the runtime's copy of the row, because a program
/// that searched is the side that decided.
fn culprit_json(b: Bisect) -> Json =
  object([
    { key: "verdict", value: Str(b.verdict) },
    { key: "skipped", value: string_or_null(b.skipped) },
    { key: "confidence", value: Str(b.confidence) },
    { key: "definitions", value: Array(b.culprits.map(|c: Culprit| Str(c.names.at_or(0, "")))) },
    {
      key: "groups",
      value: Array(b.groups.map(|g: List<String>| Array(g.map(|n: String| Str(n))))),
    },
    { key: "reason", value: Str(b.reason) },
    {
      key: "search",
      value: object([
        { key: "candidates", value: int(b.search.candidates) },
        { key: "clusters", value: int(b.search.clusters) },
        { key: "evaluated", value: int(b.search.evaluated) },
        { key: "cached", value: int(b.search.cached) },
        { key: "memoized", value: int(b.search.memoized) },
        { key: "unresolved", value: int(b.search.unresolved) },
        { key: "exhausted", value: Bool(b.search.exhausted) },
      ]),
    },
  ])

fn suspect_json(x: Suspect) -> Json =
  object([
    { key: "name", value: Str(x.name) },
    {
      key: "change",
      value: string_or_null(match x.change { Some(c) -> Some(kind_word(c)), None -> None }),
    },
    { key: "hash", value: string_or_null(x.hash) },
    { key: "before", value: string_or_null(x.before) },
    { key: "culprit", value: Bool(x.culprit) },
  ])

fn parallelism_json(v: Parallelism) -> Json =
  object([
    { key: "total", value: int(v.total) },
    { key: "isolated", value: int(v.isolated) },
    { key: "shared", value: int(v.shared) },
    { key: "scheduled", value: int(v.scheduled) },
    { key: "groups", value: int(v.groups) },
    { key: "shared_groups", value: int(v.shared_groups) },
  ])

pub fn phases_json(phases: Phases) -> Json =
  object([
    { key: "read", value: millis(phases.read_us) },
    { key: "front", value: millis(phases.front_us) },
    { key: "write_back", value: millis(phases.write_back_us) },
    { key: "total", value: millis(phase_total(phases)) },
  ])

fn selection_json(program: Program, report: RunReport, decided: Decided) -> Json / {abort.raise} = {
  let c = counts_of(program, report.reaches);
  object([
    { key: "total", value: int(program.cases.len()) },
    { key: "selected", value: int(selected_count(program, decided)) },
    { key: "cached", value: int(cached_count(program, decided)) },
    { key: "by_code", value: int(by_code_count(program, decided)) },
    { key: "filtered_out", value: int(program.filtered_out) },
    { key: "filed_under", value: string_or_null(program.filed_under) },
    {
      key: "groups",
      value: Array(range(0, decided.classes.len()).map(|i: Int| group_json(decided, i))),
    },
    // A host-backed test counts only under `host`, since it is not isolated.
    { key: "isolated", value: int(c.isolated) },
    { key: "shared", value: int(c.shared) },
    { key: "host", value: int(c.host) },
    { key: "parallelism", value: parallelism_json(decided.parallelism) },
    {
      key: "tests",
      value: Array(program.cases.map(|case: Case| case_json(report, case, decided))),
    },
  ])
}

fn summary_json(c: Summary) -> Json =
  object([
    { key: "passed", value: int(c.passed) },
    { key: "failed", value: int(c.failed) },
    { key: "abandoned", value: int(c.abandoned) },
    { key: "cached", value: int(c.cached) },
    { key: "duration_ms", value: millis(c.duration_us) },
  ])

fn simulated_json(c: Simulated) -> Json =
  object([
    { key: "simulated", value: int(c.simulated) },
    { key: "seeds", value: int(c.seeds) },
    { key: "interleavings", value: int(c.interleavings) },
    { key: "exhaustive", value: int(c.exhaustive) },
    { key: "exhausted", value: int(c.exhausted) },
    { key: "failed", value: int(c.failed) },
  ])

fn backend_json(report: RunReport) -> Json =
  match report.backend {
    None -> Null,
    Some(b) ->
      object([
        { key: "name", value: Str(b.name) },
        { key: "fragment", value: int(b.fragment) },
        { key: "offered", value: int(b.offered) },
        { key: "load_nanos", value: int_or_null(b.load_nanos) },
        { key: "units", value: int_or_null(b.units) },
        { key: "entered", value: int(b.entered) },
        { key: "declined", value: int(b.declined) },
        { key: "converted_in", value: int(b.converted_in) },
        { key: "converted_out", value: int(b.converted_out) },
      ]),
  }

/// The two documents `--coverage` and `--mutate` add, each written by the pass that measured it.
fn extra_documents(report: RunReport) -> List<Member> = {
  let covered = match report.coverage {
    None -> [],
    Some(c) -> [{ key: "coverage", value: c.json }],
  };
  match report.mutants {
    None -> covered,
    Some(m) -> covered.push({ key: "mutants", value: m.json }),
  }
}

/// Bumped whenever a field in the failure artifact changes meaning or leaves.
fn artifact_schema() -> Int = 6

fn document(
  flags: Flags,
  program: Program,
  report: RunReport,
  faults: List<Fault>,
  warnings: List<Diag>,
  ok: Bool,
  decided: Decided,
) -> Json / {abort.raise} =
  object(
    [
      { key: "command", value: Str("test") },
      { key: "schema_version", value: int(artifact_schema()) },
      {
        key: "front_end",
        value: object(
          [
            { key: "incremental", value: Bool(program.incremental) },
            { key: "phases", value: phases_json(program.phases) },
          ].concat(
            program.reuse,
          ),
        ),
      },
      { key: "phases", value: run_phases_json(program.phases, report.spent) },
      { key: "ok", value: Bool(ok) },
      { key: "exit_code", value: int(if ok { ok_code() } else { run_failed() }) },
      { key: "root", value: Str(program.root) },
      { key: "files", value: strings(program.files) },
      {
        key: "modules",
        value: Array(
          program.modules.map(|m: ModuleView|
            object([{ key: "name", value: Str(m.name) }, { key: "file", value: Str(m.file) }])),
        ),
      },
      { key: "filters", value: Array(flags.filters.map(|f: String| Str(f))) },
      { key: "no_cache", value: Bool(flags.no_cache) },
      { key: "binding", value: Str(report.label) },
      { key: "hosts", value: report.hosts },
      { key: "workers", value: int(report.workers) },
      { key: "options", value: with_sim(program.options, decided.sim) },
      { key: "simulation", value: simulated_json(report.simulation) },
      { key: "backend", value: backend_json(report) },
      { key: "selection", value: selection_json(program, report, decided) },
      { key: "summary", value: summary_json(report.summary) },
      {
        key: "results",
        value: Array(
          report.results.map(|outcome: Outcome| outcome_json(program, outcome, decided)),
        ),
      },
      { key: "failures", value: Array(faults.map(|f: Fault| fault_json(program, f))) },
      // Not a warning: every later run believes an escaped entry.
      { key: "diagnostics", value: all_to_json(report.escapes, program.places) },
      { key: "warnings", value: all_to_json(warnings, program.places) },
    ].concat(
      extra_documents(report),
    ),
  )

// --- The answer -------------------------------------------------------------

/// A test failed, was abandoned, a pass escaped into the cache, or a mutant lived.
fn run_failed() -> Int = 1

fn survived(report: RunReport) -> Bool =
  match report.mutants { Some(m) -> m.survived > 0, None -> false }

pub fn green_run(report: RunReport) -> Bool =
  report.summary.failed == 0 && report.summary.abandoned == 0 && report.escapes.len() == 0
    && !survived(report)

pub fn printed(lines: List<String>) -> Unit / {process.out[proc]} =
  lines.fold((), |_: Unit, line: String| process.out[proc](line))

fn nothing_lines(style: Style, flags: Flags, program: Program) -> List<String> =
  if program.cases.len() > 0 { [] }
  else { ["", indent() ++ dim(style, no_tests_note(flags, program))] }

/// The report after its results, which were printed as their groups finished.
fn closing_lines(
  style: Style,
  flags: Flags,
  program: Program,
  report: RunReport,
  faults: List<Fault>,
  warnings: List<Diag>,
) -> List<String> / {abort.raise} =
  [
    if flags.explain { run_phase_lines(style, program.phases, report.spent) } else { [] },
    [""],
    run_lines(style, report),
    [summary_line(style, report, counts_of(program, report.reaches))],
    warned_lines(style, report.escapes),
    failure_blocks(style, program, faults),
    abandoned_blocks(style, program, report),
    nothing_lines(style, flags, program),
    warned_lines(style, warnings),
    coverage_lines(style, report),
    mutant_lines(style, program, report),
  ].fold([], |acc: List<String>, part: List<String>| acc.concat(part))

/// A lazy read and a later flush can each report the same unreadable file.
fn collected(program: Program, report: RunReport) -> List<Diag> =
  program.warnings.concat(report.warnings).fold([], |acc: List<Diag>, d: Diag|
    if acc.filter(|x: Diag| x.code == d.code && x.message == d.message).len() > 0 { acc }
    else { acc.push(d) })

pub fn answered(
  style: Style,
  flags: Flags,
  program: Program,
  report: RunReport,
  faults: List<Fault>,
  decided: Decided,
) -> Answer / {abort.raise} = {
  let warnings = collected(program, report);
  let ok = green_run(report);
  {
    json: document(flags, program, report, faults, warnings, ok, decided),
    lines: closing_lines(style, flags, program, report, faults, warnings),
    errs: [],
    code: if ok { ok_code() } else { run_failed() },
  }
}

/// A registration that does not match the program is a start-up failure: nothing ran.
pub fn unbound(style: Style, refusal: Refusal) -> Answer / {abort.raise} = {
  let tally = indent() ++ red(style, "no host handler was bound") ++ " ("
    ++ count_of(refusal.diags.len(), "error")
    ++ ")";
  {
    json: object([
      { key: "command", value: Str("test") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: int(compile_error()) },
      { key: "binding", value: Str("host") },
      { key: "diagnostics", value: all_to_json(refusal.diags, refusal.places) },
    ]),
    lines: [],
    errs: all_to_text(style, refusal.diags, refusal.places).push(tally),
    code: compile_error(),
  }
}

// --- What the loaded tree tells a selector ------------------------------------

pub fn test_at(analysis: View, i: Int) -> Option<TestInfo> = analysis.checked.tests.at(i)

/// The order the runtime holds a footprint's atoms in: by effect, then resource, a named one first
/// and every label last, then mode and operation.
fn resource_rank(r: types::Resource) -> Int =
  match r { RNamed(_) -> 0, RVar(_) -> 1, RSingleton -> 2, RAny -> 3 }

fn mode_rank(m: type_syntax::Mode) -> Int = match m { MRead -> 0, MWrite -> 1, _ -> 2 }

fn atom_before(a: types::Atom, b: types::Atom) -> Bool =
  if a.effect != b.effect { compare(a.effect, b.effect) == Less }
  else if resource_rank(a.resource) != resource_rank(b.resource) {
    resource_rank(a.resource) < resource_rank(b.resource)
  } else if a.resource != b.resource {
    match ((a.resource, b.resource)) {
      (RNamed(x), RNamed(y)) -> compare(x, y) == Less,
      (RVar(x), RVar(y)) -> x < y,
      _ -> false,
    }
  } else if mode_rank(a.mode) != mode_rank(b.mode) { mode_rank(a.mode) < mode_rank(b.mode) } else {
    match ((a.op, b.op)) {
      (None, Some(_)) -> true,
      (Some(x), Some(y)) -> compare(x, y) == Less,
      _ -> false,
    }
  }

/// The atoms ascending, each once.
pub fn canonical(atoms: List<types::Atom>) -> List<types::Atom> = dedup(atoms.sort_by(atom_before))

pub fn footprint_text(atoms: List<types::Atom>) -> String / {abort.raise} =
  "{" ++ String::join(atom_texts(atoms), ", ") ++ "}"

// --- A test over cases --------------------------------------------------------

pub fn with_sim(options: Json, sim: Json) -> Json =
  match options { Object(members) -> Object(members.insert("sim", sim)), other -> other }

// --- Tests ------------------------------------------------------------------

test "the mark is a word in a plain run and one glyph in a styled one" {
  assert_eq(marked(plain(), "passed"), "ok     ");
  assert_eq(marked(plain(), "failed"), "FAIL   ");
  assert_eq(marked(plain(), "panicked"), "PANIC  ");
  assert_eq(marked(plain(), "abandoned"), "GAVE UP");
  assert_eq(Bytes::of_string(marked(ansi(), "passed")), b"\x1b[32m\xe2\x9c\x93\x1b[0m")
}

test "a reason is spaced in the line and joined in the document" {
  assert_eq(keyed(word(PreviousFailure)), "previous_failure");
  assert_eq(keyed(word(New)), "new");
  assert_eq(word(Changed("the file `a.ply`")), "changed");
  assert_eq(word(Unhashed), "unhashed")
}

test "a search says what it explored and what a blind and an unpruned one would have cost" {
  let e: Explored = {
    explored: 12,
    exhaustive: true,
    exhausted: false,
    blind: Some({ explored: 30, bounded: false, rendered: "30" }),
    naive: Some({ explored: 120, bounded: false, rendered: "120" }),
    reduction_tenths: Some(100),
    steps: 8,
    virtual_time_ns: 0,
    failing_seed: None,
  };
  assert_eq(
    String::join(search_parts(e), " · "),
    "12 interleavings · exhaustive · blind 30 · naive 120 · 10× reduction",
  );
  let doc = to_string(search_json(e));
  assert(doc.contains("\"blind\":{\"bounded\":false,\"explored\":30,\"rendered\":\"30\"}"));
  assert(doc.contains("\"naive\":{\"bounded\":false,\"explored\":120,\"rendered\":\"120\"}"));
  let unmeasured = { ..e, blind: None, naive: None, reduction_tenths: None };
  assert_eq(String::join(search_parts(unmeasured), " · "), "12 interleavings · exhaustive");
  assert(to_string(search_json(unmeasured)).contains("\"blind\":null"))
}

test "a bounded naive count makes the ratio a lower bound" {
  let e: Explored = {
    explored: 12,
    exhaustive: false,
    exhausted: false,
    blind: Some({ explored: 40, bounded: false, rendered: "40" }),
    naive: Some({ explored: 4096, bounded: true, rendered: ">= 4096" }),
    reduction_tenths: Some(3413),
    steps: 8,
    virtual_time_ns: 0,
    failing_seed: None,
  };
  assert_eq(
    String::join(search_parts(e), " · "),
    "12 interleavings · blind 40 · naive >= 4096 · >= 341× reduction",
  )
}

test "every reason has an explanation of its own" {
  let lines = [New, Changed(""), PreviousFailure, Cached, SameCode, Unhashed].map(
    |r: Reason| word(r),
  ).map(
    why,
  );
  assert_eq(
    range(0, 6).filter(|i: Int|
      range(0, 6).filter(|j: Int| lines.at_or(i, "") == lines.at_or(j, "")).len() == 1).len(
    ),
    6,
  )
}

test "a load that refuses tallies its errors and binds nothing" {
  let answer = refused(plain(), "test", [error_with_labels(b"E0201", b"type mismatch", [], [])], [
  ]);
  assert_eq(answer.code, 2);
  assert_eq(answer.errs, ["Error[E0201]: type mismatch", "   compilation failed (1 error)"])
}

test "a binding that does not match the program is a start-up failure naming no line" {
  let answer = unbound(plain(), {
    diags: [error_with_labels(b"E0412", b"a nondet effect in a det test", [], [])],
    places: [],
  });
  assert_eq(answer.code, 2);
  assert_eq(answer.errs, [
    "Error[E0412]: a nondet effect in a det test",
    "   no host handler was bound (1 error)",
  ])
}

// --- Footprints over real programs --------------------------------------------

test "a program cannot declare either effect the scheduler reads a name of" {
  let refused = |name: String|
    match analyse(
        parse_all([
          {
            name: b"",
            src: Bytes::of_string(
              "effect " ++ name ++ " {\n  write put[users](v: Int) -> Unit\n}\ntest \"claim\" { "
                ++ name
                ++ ".put[users](1) }\n",
            ),
          },
        ]),
      ) {
      Analysed(_) -> false,
      Refused(_) -> true,
    };
  assert(refused("hold"));
  assert(refused("sim"))
}
