import progress
import std.list
import compiler.check.infer.checker (EffectInfo, TestInfo, prelude_effects)
import compiler.check.resolve.tables (Diagnostic, Source)
import compiler.store.memo (memo)
import compiler.emit.keys (RootKey, TestCases, root_name, root_text, test_key, test_roots)
import compiler.front.checking (LoadInputs)
import compiler.front.checking.identity (identity_of)
import compiler.front.checking.view
import compiler.front.checking.program_facts (TestList, names_of, names_reached)
import module_queries (LaterChecks)
import compiler.front.facts (ProgramListing)
import compiler.front.rows (Outline)
import compiler.store.hash.forms
import compiler.store.hash.forms (Identified, NodeRef, TestRun, InsidePackage,
                                  hash_identities, identity_in)
import compiler.syntax.parsing (generated_span)
import diagnostic (SourceText)
import program (ProgramStore, Session, in_program_store)

pub type TestIdentity =
  | PlainRun(Bytes)
  | OverCases({ run: Bytes, listing: Bytes })
  | CaseOf({ parent: Bytes, run: Bytes })

pub type SelectedTest = { info: TestInfo, identity: TestIdentity }

pub type Determinism = | Deterministic | Nondeterministic

pub type TestListing = {
  root: Int,
  names: List<Bytes>,
  tests: List<SelectedTest>,
  effects: Map<Bytes, Determinism>,
  filtered_out: Int,
}

pub type TestReading = {
  listing: TestListing,
  later: LaterChecks,
  schema: Option<Diagnostic>,
  records: List<Bytes>,
}

pub type Selection = { tests: List<TestInfo>, filtered_out: Int }

pub type NamedEffect = { name: Bytes, nondet: Bool }

fn determinism(nondet: Bool) -> Determinism = if nondet { Nondeterministic } else { Deterministic }

pub fn effect_determinism(declared: List<NamedEffect>) -> Map<Bytes, Determinism> =
  prelude_effects.map(|e: EffectInfo| { name: e.name, nondet: e.nondet }).concat(declared).fold(
    Map::new(),
    |found: Map<Bytes, Determinism>, e: NamedEffect| found.insert(e.name, determinism(e.nondet)),
  )

pub fn listing_of<| e>(
  list: TestList,
  selection: Selection,
  identity: (TestInfo) -> TestIdentity / e,
  effects: Map<Bytes, Determinism>,
) -> TestListing / e =
  {
    root: list.root,
    names: list.names,
    tests: selection.tests.fold(
      { listed: [], index: 0 },
      |walked: { listed: List<SelectedTest>, index: Int }, t: TestInfo|
        {
          listed: walked.listed.push({ info: { ..t, index: walked.index }, identity: identity(t) }),
          index: walked.index + 1,
        },
    ).listed,
    effects: effects,
    filtered_out: selection.filtered_out,
  }

pub fn stored_identity(info: TestInfo) -> TestIdentity / {memo.read, abort.raise} = {
  let identified = |subject: Identified|
    match identity_of({
        module: { module: info.module, shipped: false, tested: false },
        subject: subject,
      }) {
      Some(identity) -> identity,
      None ->
        panic(
          "the checker listed the test `" ++ String::of_bytes_lossy(info.key)
            ++ "`, but its module holds no identity for it",
        ),
    };
  let run = identified(TestRun(info.key));
  if info.cases { OverCases({ run: run, listing: identified(forms::TestListing(info.key)) }) }
  else { PlainRun(run) }
}

pub fn run_of(identity: TestIdentity) -> Bytes =
  match identity { PlainRun(run) -> run, OverCases(o) -> o.run, CaseOf(c) -> c.run }

pub fn run_hash(t: SelectedTest) -> Bytes = run_of(t.identity)

pub fn test_at(listing: TestListing, i: Int) -> Option<SelectedTest> = listing.tests.at(i)

pub fn hash_at(listing: TestListing, i: Int) -> Option<String> / {abort.raise} =
  test_at(listing, i).map(|t: SelectedTest| run_hash(t).hex_of())

pub fn test_root_at(listing: TestListing, i: Int) -> Option<RootKey> / {abort.raise} =
  match test_at(listing, i) { Some(t) -> Some(test_key(t.info.module, t.info.name)), None -> None }

pub fn infos_of(listing: TestListing) -> List<TestInfo> =
  listing.tests.map(|t: SelectedTest| t.info)

pub fn roots_of_tests(listing: TestListing) -> List<RootKey> / {abort.raise} =
  listing.tests.fold([], |found: List<RootKey>, t: SelectedTest|
    found.concat(test_roots(t.info.module, t.info.name, t.info.cases)))

pub fn test_list_of_program(w: ProgramListing) -> TestList =
  { root: w.root, names: w.outlines.map(|o: Outline| o.name), tests: w.checked.tests }

pub fn in_run(list: TestList, t: TestInfo) -> Bool = t.at.module < list.root

pub fn listing_of_program(w: ProgramListing) -> TestListing / {abort.raise} = {
  let list = test_list_of_program(w);
  let identities = hash_identities(w.hashes, |_: Identified, _: NodeRef| InsidePackage);
  let identified = |subject: Identified|
    match identity_in(identities, subject) {
      Some(identity) -> identity,
      None -> panic("a test of the program has no identity"),
    };
  let identity = |info: TestInfo| {
    let run = identified(TestRun(info.key));
    if info.cases { OverCases({ run: run, listing: identified(forms::TestListing(info.key)) }) }
    else { PlainRun(run) }
  };
  listing_of(
    list,
    { tests: list.tests.filter(|t: TestInfo| in_run(list, t)), filtered_out: 0 },
    identity,
    effect_determinism(w.checked.effects.map(|e: EffectInfo| { name: e.name, nondet: e.nondet })),
  )
}

pub fn sources_named(names: List<Bytes>, places: List<SourceText>) -> List<Source> / {abort.raise} =
  range(0, names.len()).map(|i: Int|
    { name: names.get(i), source_text: places.at(i).map(|p: SourceText| p.text).unwrap_or(b"") })

pub type TestsView = { whole: ProgramListing, places: List<SourceText>, included: List<Int> }

pub fn positions_in(view: TestsView) -> Map<Int, Int> / {abort.raise} =
  range(0, view.included.len()).fold(Map::new(), |found: Map<Int, Int>, k: Int|
    found.insert(view.included.get(k), k))

pub fn module_in_program(view: TestsView, k: Int) -> Int = view.included.at_or(k, k)

pub fn view_of_imports(
  t: Session<TestReading>,
  places: List<SourceText>,
  start: List<Bytes>,
) -> TestsView / {ProgramStore, abort.raise} = {
  let names = names_of(t.modules);
  let reached = names_reached(
    names,
    t.value.later.reading.imports,
    start.push(b"std.prelude"),
  );
  let included = range(0, names.len()).filter(|i: Int| reached.contains(names.get(i)));
  let subset = {
    root: included.filter(|i: Int| i < t.modules.root).len(),
    own: included.filter(|i: Int| i < t.modules.own.len()).map(|i: Int| names.get(i)),
    pulled: included.filter(|i: Int| i >= t.modules.own.len()).map(|i: Int| names.get(i)),
  };
  {
    whole: progress::silently(||
      in_program_store(t.place, |_: LoadInputs| view::listed(subset))).value,
    places: included.map(|i: Int| places.get(i)),
    included: included,
  }
}

test "only a test over cases has a root that lists its cases" {
  let plain = {
    name: b"plain",
    module: b"m",
    key: b"m.plain",
    index: 0,
    nondet: false,
    cases: false,
    effects: [],
    at: { module: 0, span: generated_span },
    label: { module: 0, span: generated_span },
  };
  let over_cases = { ..plain, name: b"over", key: b"m.over", cases: true };
  let list = { root: 1, names: [b"m"], tests: [plain, over_cases] };
  let listing = listing_of(
    list,
    { tests: list.tests, filtered_out: 0 },
    |info: TestInfo|
      if info.cases { OverCases({ run: b"r", listing: b"l" }) } else { PlainRun(b"r") },
    Map::new(),
  );
  let run = test_key(b"m", b"over");
  assert_eq(
    roots_of_tests(listing).map(|k: RootKey| root_text(root_name(k))),
    [test_key(b"m", b"plain"), run, TestCases(run)].map(|k: RootKey| root_text(root_name(k))),
  )
}
