import progress
import std.set (Set)
import std.list
import compiler.check.infer.checker (EffectInfo, Location, TestInfo)
import compiler.check.resolve.tables (Diagnostic, Source)
import compiler.emit.keys (RootKey, TestCases, root_name, root_text, test_key, test_roots)
import compiler.front.checking (LoadInputs)
import compiler.front.checking.identity (TestIdentity)
import compiler.front.checking.view
import compiler.front.checking.program_facts (ListedTest, TestIdentity, TestList, names_of,
                                              names_reached, test_list)
import compiler.front.checking.view (NamedRollup)
import compiler.front.checking.world (Modules)
import module_queries (LaterChecks)
import compiler.front.facts (ProgramListing, test_label_spans)
import compiler.front.rows (DeclaredEffect, Outline)
import compiler.store.hash.forms (ModuleHashes)
import compiler.syntax.parsing (Span, generated_span)
import compiler.front.facts (ProgramListing, test_labels)
import compiler.front.rows (Outline)
import compiler.store.hash.forms (ModuleHashes, of_key)
import compiler.syntax.parsing (dummy_span)
import compiler.store.hash.forms (ModuleHashes, SubjectIdentity, TestRun, TestListing)
import diagnostic (SourceText)
import program (ProgramStore, Session, in_program_store)

pub type TestRecord = { info: TestInfo, label: Location, identity: Option<TestIdentity> }

pub type TestListing = {
  root: Int,
  names: List<Bytes>,
  tests: List<TestRecord>,
  effects: Map<Bytes, Bool>,
  records: List<Bytes>,
}

pub type TestReading = { listing: TestListing, later: LaterChecks, schema: Option<Diagnostic> }

pub fn selected_listing(list: TestList, identities: Map<Bytes, TestIdentity>) -> TestListing =
  {
    root: list.root,
    names: list.names,
    tests: list.tests.map(|t: ListedTest|
      { info: t.info, label: t.label, identity: identities.get(t.info.key) }),
    effects: list.effects,
    records: list.records,
  }

pub fn test_at(listing: TestListing, i: Int) -> Option<TestRecord> = listing.tests.at(i)

pub fn run_hash(t: TestRecord) -> Option<Bytes> = t.identity.map(|x: TestIdentity| x.run)

pub fn hash_at(listing: TestListing, i: Int) -> Option<String> / {abort.raise} =
  match test_at(listing, i) {
    Some(t) -> match run_hash(t) { Some(h) -> Some(h.hex_of()), None -> None },
    None -> None,
  }

pub fn test_root_at(listing: TestListing, i: Int) -> Option<RootKey> / {abort.raise} =
  match test_at(listing, i) { Some(t) -> Some(test_key(t.info.module, t.info.name)), None -> None }

pub fn infos_of(listing: TestListing) -> List<TestInfo> =
  listing.tests.map(|t: TestRecord| t.info)

pub fn roots_of_tests(listing: TestListing) -> List<RootKey> / {abort.raise} =
  listing.tests.fold([], |found: List<RootKey>, t: TestRecord|
    found.concat(test_roots(t.info.module, t.info.name, t.info.cases)))

pub fn listing_of_program(w: ProgramListing) -> TestListing / {abort.raise} =
  selected_listing(
    test_list(
      w.root,
      w.outlines.map(|o: Outline| o.name),
      w.checked.tests,
      test_labels(w.outlines),
      w.checked.effects.fold(Map::new(), |found: Map<Bytes, Bool>, e: EffectInfo|
        found.insert(e.name, e.nondet)),
      w.modules.map(|m: ModuleHashes| m.record),
    ),
    w.hashes.tests.fold(Map::new(), |found: Map<Bytes, TestIdentity>, key: Bytes, run: Bytes|
      found.insert(key, { run: run, listing: of_key(w.hashes.listing_hashes, key) })),
  )

pub fn sources_named(names: List<Bytes>, places: List<SourceText>) -> List<Source> / {abort.raise} =
  range(0, names.len()).map(|i: Int|
    { name: names.get(i), source_text: places.at(i).map(|p: SourceText| p.text).unwrap_or(b"") })

pub type TestsView = { whole: ProgramListing, places: List<SourceText>, included: List<Int> }

pub fn positions_in(view: TestsView) -> Map<Int, Int> / {abort.raise} =
  range(0, view.included.len()).fold(Map::new(), |found: Map<Int, Int>, k: Int|
    found.insert(view.included.get(k), k))

pub fn module_in_program(view: TestsView, k: Int) -> Int = view.included.at_or(k, k)

pub fn view_of_imports(
  t: Session<TestReading>,
  places: List<SourceText>,
  start: List<Bytes>,
) -> TestsView / {ProgramStore, abort.raise} = {
  let names = names_of(t.modules);
  let reached = names_reached(names, t.value.later.reading.sites.imports, start.push(b"std.prelude"));
  let included = range(0, names.len()).filter(|i: Int| reached.contains(names.get(i)));
  let subset = {
    root: included.filter(|i: Int| i < t.modules.root).len(),
    own: included.filter(|i: Int| i < t.modules.own.len()).map(|i: Int| names.get(i)),
    pulled: included.filter(|i: Int| i >= t.modules.own.len()).map(|i: Int| names.get(i)),
  };
  {
    whole: progress::silently(|| in_program_store(t.place, |_: LoadInputs| view::listed(subset))).value,
    places: included.map(|i: Int| places.get(i)),
    included: included,
  }
}

test "only a test over cases has a root that lists its cases" {
  let plain = {
    name: b"plain",
    module: b"m",
    key: b"m.plain",
    index: 0,
    nondet: false,
    cases: false,
    effects: [],
    at: { module: 0, span: generated_span },
  };
  let over_cases = { ..plain, name: b"over", key: b"m.over", cases: true };
  let listing = selected_listing(
    test_list(
      1,
      [b"m"],
      [plain, over_cases],
      [plain, over_cases].fold(Map::new(), |found: Map<Bytes, Location>, t: TestInfo|
        found.insert(t.key, t.at)),
      Map::new(),
      [],
    ),
    Map::new(),
  );
  let run = test_key(b"m", b"over");
  assert_eq(
    roots_of_tests(listing).map(|k: RootKey| root_text(root_name(k))),
    [test_key(b"m", b"plain"), run, TestCases(run)].map(|k: RootKey| root_text(root_name(k))),
  )
}
