pub fn test_hash_at(analysis: CheckedProgram, i: Int) -> Option<Bytes> =
  match test_at(analysis, i) { Some(t) -> analysis.frame.hashes.tests.get(t.key), None -> None }

pub fn hash_at(analysis: CheckedProgram, i: Int) -> Option<String> / {abort.raise} =
  match test_hash_at(analysis, i) { Some(h) -> Some(h.hex_of()), None -> None }

pub fn uses_simulation(effects: List<types::Effect>) -> Bool =
  effects.fold(false, |found: Bool, a: types::Effect| found || a.effect == b"sim")

pub fn entry_of(index: Int, key: Bytes) -> Entry =
  { test: index, key: key, case: None, unlisted: None }

pub type Reporting = { style: Style, width: Int, to_stderr: Bool }

type SearchOptions = {
  plan: plan::Plan,
  measuring: Bool,
  lanes: Option<Int>,
  reporting: Option<Reporting>,
}

type Job = { unit: TestUnit, test: Int, name: String, entry: Entry, search: Option<plan::Plan> }

pub type JobResult = {
  test: Int,
  status: String,
  failure: Option<RuntimeDiagnostic>,
  usage: Usage,
  trace: Option<Bytes>,
  searched: Option<{ exploration: Exploration, seeds: Int }>,
}

pub fn job_of(
  program: Program,
  index: Int,
  narrowing: List<{ index: Int, roots: List<Int> }>,
  searching: plan::Plan,
) -> Job / {abort.raise} =
  match case_of(program, index) {
    None ->
      {
        unit: program.unit,
        test: index,
        name: display_name_at(program, index),
        entry: entry_of(index, b""),
        search: None,
      },
    Some(c) ->
      {
        unit: program.unit,
        test: index,
        name: display_name_at(program, index),
        entry: c.entry,
        search: if !c.seeded { None } else {
          match narrowing.filter(|n: { index: Int, roots: List<Int> }| n.index == index) {
            [narrowed, ..] ->
              Some({ ..searching, roots: narrowed.roots.map(|r: Int| U64::of_int(r)) }),
            [] -> Some(searching),
          }
        },
      },
  }

pub fn run_class(
  jobs: List<Job>,
  search_options: SearchOptions,
) -> List<JobResult> / {entering::machine.enter, entering::machine.report, abort.raise} = {
  let lanes = machine::split_into_lanes(jobs, search_options.lanes);
  machine::merge_lanes(
    run_lanes(lanes, search_options.measuring, search_options.reporting, 0, lanes.len(), 64),
  )
}

fn reported(
  done: JobResult,
  j: Job,
  reporting: Option<Reporting>,
) -> JobResult / {entering::machine.report} = {
  match reporting {
    Some(r) ->
      entering::machine.report(
        finished_line(r.style, j.name, done.status, done.usage.duration_us, r.width),
        r.to_stderr,
      ),
    None -> (),
  };
  done
}

fn run_lanes(
  lanes: List<List<Job>>,
  measuring: Bool,
  reporting: Option<Reporting>,
  lo: Int,
  hi: Int,
  depth_left: Int,
) -> List<List<JobResult>> / {entering::machine.enter, entering::machine.report, abort.raise} =
  if hi - lo <= 0 { [] } else if hi - lo == 1 || depth_left <= 0 {
    range(lo, hi).fold([], |lanes_done: List<List<JobResult>>, i: Int|
      match lanes.at(i) {
        Some(lane) ->
          lanes_done.push(
            lane.fold([], |out: List<JobResult>, j: Job|
              out.push(reported(run_job(j, measuring), j, reporting))),
          ),
        None -> lanes_done,
      })
  } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      run_lanes(lanes, measuring, reporting, lo, mid, depth_left - 1),
      run_lanes(lanes, measuring, reporting, mid, hi, depth_left - 1),
    };
    halves._0.concat(halves._1)
  }

type SearchTotals = { usage: Usage, trace: Option<Bytes>, unobserved: Bool }

pub fn run_job(j: Job, measuring: Bool) -> JobResult / {entering::machine.enter, abort.raise} =
  match j.entry.unlisted {
    Some(reason) ->
      {
        test: j.test,
        status: reason.status,
        failure: Some(reason.failure),
        usage: no_usage(),
        trace: None,
        searched: None,
      },
    None -> run_listed(j, measuring),
  }

fn run_listed(j: Job, measuring: Bool) -> JobResult / {entering::machine.enter, abort.raise} =
  match j.search {
    None -> {
      let e: ExecutionResult = tester::execute(j.unit, j.entry.test, j.entry.case);
      {
        test: j.test,
        status: e.status,
        failure: e.failure,
        usage: e.usage,
        trace: e.trace,
        searched: None,
      }
    },
    Some(p) -> {
      let again = plan::re_executes(p) || measuring;
      let run = |st: SearchTotals, seed: Seed| {
        let one = tester::run_interleaving(
          j.unit,
          j.entry.test,
          j.entry.case,
          seed,
          p.steps,
          again,
        );
        {
          run: one.run,
          state: {
            usage: sum_usage(st.usage, one.usage),
            trace: joined_trace(st.trace, one.trace),
            unobserved: st.unobserved || !one.observed,
          },
        }
      };
      let begun: SearchTotals = { usage: no_usage(), trace: Some(b""), unobserved: false };
      let search_result = if measuring { search::measure_with_state(p, begun, run) }
      else { search::explore_with_state(p, Exact, begun, run) };
      let explored = search_result.explored;
      {
        test: j.test,
        status: match explored.failure {
          None -> "passed",
          Some(fl) -> match search::run_failure(fl) {
            Some(fell) -> fell.status,
            None -> "panicked",
          },
        },
        failure: match explored.failure { Some(fl) -> Some(search_failure(fl)), None -> None },
        usage: search_result.state.usage,
        trace: search_result.state.trace,
        searched: if search_result.state.unobserved { None } else {
          Some({ exploration: explored.exploration, seeds: plan::normalized(p).roots.len() })
        },
      }
    },
  }

fn reproduce(seed: Seed) -> String / {abort.raise} =
  "reproduce with `--sim once --seed " ++ plan::seed_text(seed)
    ++ "`, and report it with the test's source"

fn spanned(span: { module: Int, start: Int, end: Int }, text: String) -> Label =
  {
    module: span.module,
    start: span.start,
    end: span.end,
    primary: true,
    text: Bytes::of_string(text),
  }

fn search_failure(fl: Failure<InterleavingFailure>) -> RuntimeDiagnostic / {abort.raise} =
  match search::run_failure(fl) {
    Some(fell) -> { ..fell.failure, diagnostic: with_notes(fell.failure.diagnostic, fl.notes) },
    None -> {
      let d = match fl.cause {
        Diverged(x) ->
          diagnostic_of(
            "error",
            "E0415",
            "replaying seed " ++ plan::seed_text(x.seed)
              ++ " did not reproduce the recorded schedule",
            [spanned(x.span, "this scheduling point")],
            [
              x.what,
              "a simulated run must be a pure function of its definition set and its seed; this is an internal error in Ply rather than in the program under test",
              reproduce(x.seed),
            ],
          ),
        InvalidRecording(x) ->
          diagnostic_of(
            "error",
            "E0505",
            "the scheduler recorded a step that is not a valid scheduling decision",
            [spanned(x.span, "this step")],
            [x.what, reproduce(x.seed)],
          ),
        _ ->
          diagnostic_of(
            "error",
            "E0505",
            "a simulated search stopped at a failure, but the outcome contains no failure",
            [],
            [],
          ),
      };
      { diagnostic: with_notes(d, fl.notes), values: [] }
    },
  }

pub fn hashes_of(analysis: CheckedProgram, era: Bytes) -> Hashes =
  {
    definitions: by_name(analysis.frame.hashes.definitions),
    declarations: by_name(analysis.frame.hashes.declarations),
    era: era,
    closure: |keys: List<Bytes>| {
      let reachable = reach(analysis.frame.hashes, keys.map(|k: Bytes| ItemKeyed(k)));
      { functions: reachable.functions.keys(), declarations: reachable.declarations.keys() }
    },
  }

pub fn conclude_tests(analysis: CheckedProgram, program: Program) -> List<conclude::Test> =
  range(0, analysis.checked.tests.len()).fold([], |accumulator: List<conclude::Test>, i: Int|
    match test_at(analysis, i) {
      Some(t) -> {
        let entry = match case_of(program, i) { Some(c) -> Some(c.entry), None -> None };
        accumulator.push({
          index: i,
          key: t.key,
          seeded: uses_simulation(t.effects),
          hash: test_hash_at(analysis, i),
          start: match entry { Some(e) -> e.key, None -> t.key },
          case: match entry { Some(e) -> e.case != None, None -> false },
        })
      },
      None -> accumulator,
    })

pub fn seen_of(h: Hashes) -> Map<Bytes, Bool> / {result_cache.known} = {
  let hashes = h.definitions.values();
  let results = result_cache.known(hashes);
  range(0, hashes.len()).fold(Map::new(), |accumulator: Map<Bytes, Bool>, i: Int|
    match ((hashes.at(i), results.at(i))) {
      (Some(hash), Some(known)) -> accumulator.insert(hash, known),
      _ -> accumulator,
    })
}

pub fn conclusion_of(done: JobResult) -> conclude::TestResult<RuntimeDiagnostic> =
  {
    index: done.test,
    status: done.status,
    failure: done.failure,
    host: done.usage.used_host,
    trace: done.trace,
    searched: match done.searched {
      Some(x) ->
        Some({
          explored: x.exploration.explored,
          exhaustive: x.exploration.exhaustive,
          exhausted: x.exploration.exhausted,
          failed: x.exploration.failure != None,
        }),
      None -> None,
    },
    seeds: match done.searched { Some(x) -> x.seeds, None -> 0 },
  }

fn result_at(done: Map<Int, JobResult>, index: Int) -> Option<JobResult> = done.get(index)

fn cost_of(c: Option<search::Cost>) -> Option<Cost> =
  match c {
    None -> None,
    Some(x) ->
      Some({
        explored: x.explored,
        bounded: x.stopped_early,
        rendered: (if x.stopped_early { ">= " } else { "" }) ++ x.explored.to_string(),
      }),
  }

fn reduction_tenths_of(e: Exploration) -> Option<Int> =
  match e.naive {
    None -> None,
    Some(naive) -> if e.explored > 0 { Some((naive.explored * 20 + e.explored) / (2 * e.explored)) }
    else { None },
  }

fn explored_of(e: Exploration) -> SearchSummary / {abort.raise} =
  {
    explored: e.explored,
    exhaustive: e.exhaustive,
    exhausted: e.exhausted,
    clockless: cost_of(e.no_clocks),
    naive: cost_of(e.naive),
    reduction_tenths: reduction_tenths_of(e),
    steps: e.steps,
    virtual_time_ns: e.virtual_time,
    failing_seed: match e.failure { Some(seed) -> Some(plan::seed_text(seed)), None -> None },
  }

fn exploration_of(done: Map<Int, JobResult>, index: Int) -> Option<Exploration> =
  match result_at(done, index) {
    Some(d) -> match d.searched { Some(x) -> Some(x.exploration), None -> None },
    None -> None,
  }

fn site_of(x: search::RaceSite) -> Site =
  {
    task: "@" ++ x.task.to_string(),
    definition: x.definition,
    access: x.access,
    at: if x.span.module == no_module() { None } else { Some(x.span) },
  }

pub fn job_outcome(analysis: CheckedProgram, done: JobResult) -> Outcome / {abort.raise} =
  {
    index: done.test,
    name: match test_at(analysis, done.test) {
      Some(t) -> String::of_bytes_lossy(t.name),
      None -> "",
    },
    hash: hash_at(analysis, done.test),
    duration_us: done.usage.duration_us,
    status: done.status,
    diagnostic: done.failure,
    search: match done.searched { Some(x) -> Some(explored_of(x.exploration)), None -> None },
    cached: None,
    performs: done.usage.performs,
  }

fn outcome_of(
  analysis: CheckedProgram,
  done: Map<Int, JobResult>,
  outcome: conclude::Outcome<RuntimeDiagnostic>,
) -> Outcome / {abort.raise} = {
  let d = result_at(done, outcome.index);
  {
    index: outcome.index,
    name: match test_at(analysis, outcome.index) {
      Some(t) -> String::of_bytes_lossy(t.name),
      None -> "",
    },
    hash: hash_at(analysis, outcome.index),
    duration_us: match d { Some(x) -> x.usage.duration_us, None -> 0 },
    status: outcome.status,
    diagnostic: outcome.failure,
    search: match exploration_of(done, outcome.index) {
      Some(e) -> Some(explored_of(e)),
      None -> None,
    },
    cached: match outcome.recorded { Some(record) -> Some(is_written(record)), None -> None },
    performs: match d { Some(x) -> x.usage.performs, None -> 0 },
  }
}

fn failed_of(
  analysis: CheckedProgram,
  h: Hashes,
  done: Map<Int, JobResult>,
  failed: conclude::TestFailure<RuntimeDiagnostic>,
) -> Failed / {abort.raise} = {
  let t = test_at(analysis, failed.index);
  let e = exploration_of(done, failed.index);
  let key = String::of_bytes_lossy(failed.key);
  {
    key: key,
    name: match t { Some(x) -> String::of_bytes_lossy(x.name), None -> key },
    diagnostic: failed.failure,
    internal_error: failed.internal_error,
    changes: failed.changes.map(|name: Bytes|
      {
        name: String::of_bytes_lossy(name),
        hash: match h.definitions.get(name) {
          Some(x) -> Some(x.hex_of()),
          None -> match h.declarations.get(name) { Some(x) -> Some(x.hex_of()), None -> None },
        },
      }),
    unchanged: failed.changes.len() == 0,
    seed: match e {
      Some(x) -> match x.failure { Some(seed) -> Some(plan::seed_text(seed)), None -> None },
      None -> None,
    },
    race: match e {
      Some(x) -> match x.race {
        Some(race) ->
          Some({
            left: site_of(race.left),
            right: site_of(race.right),
            step: race.scheduling_point,
          }),
        None -> None,
      },
      None -> None,
    },
    module: match t { Some(x) -> Some(String::of_bytes_lossy(x.module)), None -> None },
    test_hash: hash_at(analysis, failed.index),
    nondet: match t { Some(x) -> Some(x.nondet), None -> None },
    status: match result_at(done, failed.index) { Some(d) -> Some(d.status), None -> None },
    declared: match t { Some(x) -> Some(effect_texts(canonical(x.effects))), None -> None },
  }
}

fn escapes_of(
  analysis: CheckedProgram,
  c: Conclusion<RuntimeDiagnostic>,
  done: Map<Int, JobResult>,
) -> List<Diagnostic> = {
  let unbound = |index: Int|
    match result_at(done, index) {
      Some(d) ->
        d.usage.used_host
          && (match d.trace {
            Some(trace) -> !String::contains("\n" ++ String::of_bytes_lossy(trace), "\nbinding\t"),
            None -> false,
          }),
      None -> false,
    };
  c.outcomes.fold(
    [],
    |accumulator: List<Diagnostic>, outcome: conclude::Outcome<RuntimeDiagnostic>| {
      let wrote = match outcome.recorded { Some(record) -> is_written(record), None -> false };
      if !wrote || !unbound(outcome.index) { accumulator } else {
        accumulator.push(
          diagnostic_of(
            "error",
            "E0505",
            "`"
              ++ (match test_at(analysis, outcome.index) {
                Some(t) -> String::of_bytes_lossy(t.name),
                None -> "",
              })
              ++ "` performed real system operations, but its passing result was cached without the list of operations the run used",
            [],
            [
              "a passing result of a test that performs system operations is valid only together with the list of operations the run used",
              "run `ply cache clear`: a cache entry written without that list could be reused by a run that performs different system operations",
              "this is a bug in Ply — the test runner and the test analysis disagree about which system operations this test performed",
            ],
          ),
        )
      }
    },
  )
}

fn notice_of(n: conclude::Notice) -> Diagnostic =
  match n {
    StaleIndex(x) ->
      diagnostic_of(
        "warning",
        "E0505",
        "a saved simulation result refers to test number " ++ x.index.to_string()
          ++ ", but the module defines only "
          ++ x.declared.to_string(),
        [],
        ["the choice was made against another program; the stale index was skipped"],
      ),
    UnobservedSearch(key) ->
      diagnostic_of(
        "warning",
        "E0505",
        "`" ++ String::of_bytes_lossy(key)
          ++ "` uses a simulation seed, but the run did not report which schedules it tried",
        [],
        [
          "the test passed and its result was not cached, so it re-runs next time",
          "this is an internal error in Ply rather than in the test; please report it",
        ],
      ),
  }

pub fn run_report_of(
  options: Options,
  program: Program,
  analysis: CheckedProgram,
  h: Hashes,
  decided: RunDecision,
  hosted: BindingReport,
  c: Conclusion<RuntimeDiagnostic>,
  done: Map<Int, JobResult>,
  elapsed: Int,
  extra_warnings: List<Diagnostic>,
) -> RunReport / {abort.raise} = {
  let ordered = c.outcomes.fold(
    [],
    |accumulator: List<JobResult>, outcome: conclude::Outcome<RuntimeDiagnostic>|
      match result_at(done, outcome.index) { Some(d) -> accumulator.push(d), None -> accumulator },
  );
  let teardown = ordered.fold([], |accumulator: List<Diagnostic>, d: JobResult|
    accumulator.concat(d.usage.teardown));
  let b = hosted.backend;
  {
    operations: hosted.operations,
    digest: hosted.digest,
    handshakes: [],
    hosts: hosted.hosts,
    tests_using_host: hosted.host_test_indices.filter(|i: Int| case_of(program, i) != None),
    workers: match options.jobs {
      Some(n) -> if n > 0 { n } else { hosted.cores },
      None -> hosted.cores,
    },
    backend: Some({
      name: b.name,
      fragment: b.fragment,
      entered: done.fold(0, |n: Int, i: Int, d: JobResult| n + d.usage.entries),
      units: b.units,
      load_nanos: b.load_nanos,
    }),
    results: c.outcomes.map(|outcome: conclude::Outcome<RuntimeDiagnostic>|
      outcome_of(analysis, done, outcome)),
    failures: c.failures.map(|failed: conclude::TestFailure<RuntimeDiagnostic>|
      failed_of(analysis, h, done, failed)),
    summary: {
      passed: c.passed,
      failed: c.failed,
      timed_out: c.timed_out,
      cached: cached_count(program, decided),
      duration_us: elapsed,
    },
    simulation: c.simulation,
    unbound_pass_diagnostics: escapes_of(analysis, c, done),
    warnings: teardown.concat(c.notices.map(notice_of)).concat(extra_warnings),
    coverage: if options.coverage { Some(coverage(analysis)) } else { None },
    spent: no_time_spent(),
  }
}

type Selection = { cases: List<select::Case>, returning: List<List<Bytes>> }

pub fn cases_of(
  rows: List<Row>,
  search: Search,
  bypassed: Bool,
  options: Options,
  supplied: machine::RunConfiguration,
  loaded: Map<Bytes, Bytes>,
) -> Selection / {result_cache.passes, entering::machine.changed_read, fs.list_dir[shipped], fs.read_file[shipped], abort.raise} = {
  let ask = |keys: List<Bytes>|
    if bypassed { keys.map(|k: Bytes| None) } else { result_cache.passes(keys) };
  let digest = digest_of(search);
  let keys = rows.map(|r: Row| key_of(r, digest));
  let recorded = ask(
    keys.fold([], |accumulator: List<Bytes>, k: Option<Bytes>|
      match k { Some(key) -> accumulator.push(key), None -> accumulator }),
  );
  let rooted = rows.map(|r: Row|
    match r.hash {
      Some(h) -> if keyed_per_root(r, search) { Some(seed_keys(h, search.roots, [])) }
      else { None },
      None -> None,
    });
  let seeded = rooted.map(|ks: Option<List<Bytes>>|
    match ks { Some(xs) -> Some(ask(xs)), None -> None });
  let now = views::shipped_state_of(
    views::views_in(
      traces_of(
        seeded.fold(recorded, |accumulator: List<Option<Bytes>>, o: Option<List<Option<Bytes>>>|
          match o { Some(xs) -> accumulator.concat(xs), None -> accumulator }),
      ),
    ),
    |m: Bytes| views::read_shipped_text(loaded, m),
  );
  let results = recorded.map(|trace: Option<Bytes>| pass_status(now, trace, options, supplied));
  let stored_results = keys.fold(
    { at: 0, out: [] },
    |st: { at: Int, out: List<Option<StoredResult>> }, k: Option<Bytes>|
      match k {
        None -> { ..st, out: st.out.push(None) },
        Some(_) -> { at: st.at + 1, out: st.out.push(results.at_or(st.at, None)) },
      },
  ).out;
  let pending_seed_roots = seeded.map(|o: Option<List<Option<Bytes>>>|
    match o {
      Some(xs) ->
        Some(
          pending_roots(
            search.roots,
            xs.map(|trace: Option<Bytes>| pass_status(now, trace, options, supplied)),
          ),
        ),
      None -> None,
    });
  {
    cases: range(0, rows.len()).map(|i: Int|
      select::case_of(
        rows.at_or(i, no_row()),
        keys.at_or(i, None),
        stored_results.at_or(i, None),
        pending_seed_roots.at_or(i, None),
      )),
    returning: range(0, rows.len()).map(|i: Int|
      match ((keys.at_or(i, None), stored_results.at_or(i, None))) {
        (Some(key), Some(Passing)) -> [key],
        (Some(_), None) -> match ((rooted.at_or(i, None), pending_seed_roots.at_or(i, None))) {
          (Some(ks), Some([])) -> ks,
          _ -> [],
        },
        _ -> [],
      }),
  }
}

pub fn traces_of(passes: List<Option<Bytes>>) -> List<Bytes> =
  passes.fold([], |accumulator: List<Bytes>, h: Option<Bytes>|
    match h { Some(trace) -> accumulator.push(trace), None -> accumulator })

pub fn pass_status(
  now: views::ShippedState,
  stored_trace: Option<Bytes>,
  options: Options,
  supplied: machine::RunConfiguration,
) -> Option<StoredResult> / {entering::machine.changed_read} =
  match stored_trace {
    None -> None,
    Some(trace) -> if trace == b"" { Some(Passing) } else {
      let split = views::split(trace);
      match tester::stale_read(options, supplied, split.rest) {
        Some(what) -> Some(Moved(what)),
        None -> match views::stale_view(now, split.shipped_views) {
          None -> Some(Passing),
          Some(what) -> Some(Moved(what)),
        },
      }
    },
  }

fn no_row() -> Row =
  { index: 0, label: "", name: "", module: "", hash: None, seeded: false, nondet: false }

pub fn diagnosed_all(
  bypassed: Bool,
  timed: TimedLoad,
  analysis: CheckedProgram,
  c: Conclusion<RuntimeDiagnostic>,
  failures: List<Failed>,
) -> { faults: List<Fault>, diffs: List<ChangeDiff> } / {result_cache.baselines, result_cache.texts, abort.raise} = {
  let records = if bypassed || failures.len() == 0 { failures.map(|f: Failed| None) } else {
    result_cache.baselines(c.failures.map(|f: conclude::TestFailure<RuntimeDiagnostic>| f.key))
  };
  if records.all(|r: Option<LastPass>| r == None) {
    { faults: failures.map(|f: Failed| fault_of(f, None)), diffs: [] }
  } else {
    let tree = changes::program_of(timed.program, analysis);
    let sides = range(0, failures.len()).map(|i: Int|
      match ((failures.at(i), records.at(i))) {
        (Some(f), Some(Some(record))) -> Some(compared(tree, f.key, f.test_hash, record)),
        _ -> None,
      });
    let then = stored_baseline_texts(
      sides.fold([], |accumulator: List<Compared>, x: Option<Compared>|
        match x { Some(c) -> accumulator.push(c), None -> accumulator }),
    );
    let deltas = sides.map(|x: Option<Compared>|
      match x { Some(c) -> Some(delta_of(tree, c, then)), None -> None });
    {
      faults: range(0, failures.len()).flat_map(|i: Int|
        match failures.at(i) { Some(f) -> [fault_of(f, deltas.at_or(i, None))], None -> [] }),
      diffs: change_diffs(
        tree,
        deltas.fold([], |accumulator: List<Delta>, d: Option<Delta>|
          match d { Some(x) -> accumulator.push(x), None -> accumulator }),
        then,
      ),
    }
  }
}

pub fn fault_of(failed: Failed, delta: Option<Delta>) -> Fault =
  {
    key: failed.key,
    name: failed.name,
    diagnostic: failed.diagnostic,
    internal_error: failed.internal_error,
    changes: changes_of(failed.changes, delta),
    unchanged: failed.unchanged,
    seed: failed.seed,
    race: failed.race,
    replay: match failed.seed { Some(seed) -> replay_of(seed, failed.name), None -> None },
    module: failed.module,
    test_hash: failed.test_hash,
    nondet: failed.nondet,
    status: failed.status,
    declared: failed.declared,
  }

pub fn replay_of(seed: String, name: String) -> Option<String> =
  shell_join(["ply", "test", "--seed", seed, "--filter", name])

pub fn store_history(
  analysis: CheckedProgram,
  sources: List<Source>,
  modules: List<ModuleHashes>,
  filing: conclude::Filing,
) -> Unit / {result_cache.unstored, result_cache.history, abort.raise} =
  if filing.records.len() == 0 { () } else {
    let unrecorded = result_cache.unstored(
      filing.reachable.functions.concat(filing.reachable.declarations).concat(
        filing.records.map(|e: { key: Bytes, record: conclude::PassRecord }| e.record.test),
      ),
    );
    result_cache.history(
      if unrecorded.len() == 0 { [] } else { texts_of(analysis, sources, unrecorded) },
      modules,
    )
  }

test "a replay is one command whatever the test is called" {
  assert_eq(
    replay_of("0:1", "it's \"$HOME\" `now`"),
    Some("ply test --seed 0:1 --filter 'it'\\''s \"$HOME\" `now`'"),
  );
  assert_eq(replay_of("0:1", "plain"), Some("ply test --seed 0:1 --filter plain"));
  assert_eq(replay_of("0:1", "a\0b"), None)
}

test "a search stopped early shows its count as `>= N`, and the reduction ratio needs the count of a search without pruning" {
  assert_eq(
    cost_of(Some({ explored: 4096, stopped_early: true })),
    Some({ explored: 4096, bounded: true, rendered: ">= 4096" }),
  );
  assert_eq(cost_of(None), None);
  let e: Exploration = {
    explored: 12,
    exhaustive: true,
    exhausted: false,
    naive: None,
    no_clocks: None,
    steps: 8,
    virtual_time: 0,
    failure: None,
    race: None,
  };
  assert_eq(reduction_tenths_of(e), None);
  assert_eq(
    reduction_tenths_of({ ..e, naive: Some({ explored: 120, stopped_early: false }) }),
    Some(100),
  );
  assert_eq(
    reduction_tenths_of({ ..e, naive: Some({ explored: 40, stopped_early: false }) }),
    Some(33),
  );
  assert_eq(
    reduction_tenths_of({ ..e, explored: 0, naive: Some({ explored: 40, stopped_early: false }) }),
    None,
  );
  assert_eq(
    explored_of({ ..e, failure: Some({ root: 7u64, path: [1, 0] }) }).failing_seed,
    Some("7:1.0"),
  )
}

fn loaded_from(
  files: List<{ path: String, body: Bytes }>,
) -> { modules: List<ModuleHashes>, whole: CheckedProgram, sources: List<Source> } / {abort.raise} = {
  let tree = fs::mem_of(files);
  let listed = Bytes::concat_all(
    queries().map(
      |q: { name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {QueryEffects, abort.raise} }|
        Bytes::concat_all([q.definition, b" ", hex(blake3(q.definition)), b"\n"]),
    ),
  );
  handle {
    match read_packages[t]("p") {
      Err(_) -> panic("the program is read"),
      Ok(p) -> match analyse_in_memory(p.main_package.files, Map::new()).out {
        Analysed(w) -> {
          let whole = checked_program_of(w);
          let texts = files.fold(
            Map::new(),
            |m: Map<Bytes, Bytes>, f: { path: String, body: Bytes }|
              m.insert(Bytes::of_string(f.path.slice(2, f.path.len() - 4)), f.body),
          );
          {
            modules: forbid_derivers(|| fresh_check_results[t](p)).modules,
            whole: whole,
            sources: whole.frame.outlines.map(|o: Outline|
              { name: o.name, source_text: texts.get(o.name).unwrap_or(b"") }),
          }
        },
        _ -> panic("the program checks"),
      },
    }
  } with {
    fs.list_dir[t](path) -> fs::mem_list(tree, path),
    fs.kind[t](path) -> fs::mem_kind(tree, path),
    fs.read_file[t](path) -> fs::mem_read(tree, path),
    shipped.names() -> ["std.prelude"],
    shipped.module(name) -> if name == "std.prelude" { Some(prelude_source::text()) } else { None },
    shipped.report_view_used(view, pulled) -> (),
    shipped.read_pack(path, offset, len) -> None,
    shipped.definitions() -> listed,
    shipped.stamps() -> "",
    shipped.runtime() -> panic("the program names no library deriver"),
  }
}

fn store_passing(
  program: { modules: List<ModuleHashes>, whole: CheckedProgram, sources: List<Source> },
) -> Unit / {fs.read[mem], fs.write[mem], abort.raise} = {
  let view = program.whole;
  let tests = range(0, view.checked.tests.len()).fold(
    [],
    |accumulator: List<conclude::Test>, i: Int|
      match test_at(view, i) {
        Some(t) ->
          accumulator.push({
            index: i,
            key: t.key,
            seeded: false,
            hash: test_hash_at(view, i),
            start: t.key,
            case: false,
          }),
        None -> accumulator,
      },
  );
  let ran: List<conclude::TestResult<RuntimeDiagnostic>> = tests.map(|t: conclude::Test|
    {
      index: t.index,
      status: "passed",
      failure: None,
      host: false,
      trace: Some(b""),
      searched: None,
      seeds: 0,
    });
  let c = conclude::conclude_run(
    tests,
    hashes_of(view, results::snapshot_digest_of(program.modules)),
    {
      groups: [tests.map(|t: conclude::Test| t.index)],
      recorded: tests.fold(Map::new(), |accumulator: Map<Int, List<Bytes>>, t: conclude::Test|
        match t.hash { Some(h) -> accumulator.insert(t.index, [h]), None -> accumulator }),
      codes: Map::new(),
      reasons: Map::new(),
      out_of_scope: [],
    },
    Map::new(),
    ran,
  );
  handle {
    store_history(view, program.sources, program.modules, c.store_update)
  } with {
    var store = tables::open_cache[mem]("cache", { runtime_digest: "runtime", code: "code" }),
    result_cache.unstored(hashes) -> results::unstored_in(store, hashes),
    result_cache.history(texts, modules) -> {
      store = results::store_pass(store, texts, modules);
    },
    return u -> {
      let _flushed = tables::flush_cache[mem](results::put_filing[mem, mem](store, c.store_update));
      u
    },
  }
}

test "the outcome of a failed test includes the diagnostic it failed with" {
  let view = loaded_from([{ path: "p/m.ply", body: b"test \"red\" { assert_eq(1, 2) }\n" }]).whole;
  let raised = {
    diagnostic: diagnostic_of("error", "E0501", "assertion failed", [], []),
    values: [],
  };
  let failed = {
    test: 0,
    status: "failed",
    failure: Some(raised),
    usage: no_usage(),
    trace: None,
    searched: None,
  };
  assert_eq(job_outcome(view, failed).diagnostic, Some(raised))
}

test "after one definition is edited, storing the run adds one module entry and only the changed source texts to the cache" {
  let program = |body: Bytes|
    loaded_from([
      { path: "p/low.ply", body: b"pub fn twice(n: Int) -> Int = n * 2\n" },
      {
        path: "p/app.ply",
        body: Bytes::concat_all([
          b"import low\nfn base(n: Int) -> Int = ",
          body,
          b"\nfn top(n: Int) -> Int = base(n) + low::twice(n)\ntest \"tops\" { assert(top(1) > 0) }\n",
        ]),
      },
    ]);
  let before = program(b"n + 1");
  let after = program(b"n + 2");
  let counted = run_in_memory(mem_empty(), || {
    let table_counts = ||
      tables::counts(tables::open_cache[mem]("cache", { runtime_digest: "runtime", code: "code" }));
    store_passing(before);
    let first = table_counts();
    store_passing(after);
    { first: first, second: table_counts() }
  }).value;
  assert_eq(counted.first.modules, before.modules.len());
  assert_eq(counted.first.snapshots, 1);
  assert(counted.first.texts > 0);
  assert_eq(counted.second.modules - counted.first.modules, 1);
  assert_eq(counted.second.snapshots - counted.first.snapshots, 1);
  assert_eq(counted.second.texts - counted.first.texts, 3)
}
