pub fn uses_simulation(effects: List<types::Effect>) -> Bool =
  effects.fold(false, |found: Bool, a: types::Effect| found || a.effect == b"sim")

pub fn entry_of(index: Int, key: Bytes) -> Entry =
  { test: index, key: key, case: None, known_failure: None }

pub type Reporting = { style: Style, width: Int, to_stderr: Bool }

pub type Journaling = {
  started: (Int) -> StartedTest / {abort.raise},
  stored: (JobResult) -> StoreUpdate / {abort.raise},
}

type SearchOptions = {
  plan: plan::Plan,
  measuring: Bool,
  lanes: Option<Int>,
  reporting: Reporting,
  journaling: Journaling,
}

type Job = { unit: TestUnit, test: Int, name: String, entry: Entry, search: Option<plan::Plan> }

pub type JobResult = {
  test: Int,
  status: String,
  failure: Option<RuntimeDiagnostic>,
  usage: Usage,
  trace: Option<Bytes>,
  searched: Option<{ exploration: Exploration, seeds: Int }>,
}

pub fn job_of(
  program: Program,
  index: Int,
  narrowing: List<{ index: Int, roots: List<Int> }>,
  searching: plan::Plan,
) -> Job / {abort.raise} =
  match case_of(program, index) {
    None ->
      {
        unit: program.unit,
        test: index,
        name: display_name_at(program, index),
        entry: entry_of(index, b""),
        search: None,
      },
    Some(c) ->
      {
        unit: program.unit,
        test: index,
        name: display_name_at(program, index),
        entry: c.entry,
        search: if !c.seeded { None } else {
          match narrowing.filter(|n: { index: Int, roots: List<Int> }| n.index == index) {
            [narrowed, ..] ->
              Some({ ..searching, roots: narrowed.roots.map(|r: Int| U64::of_int(r)) }),
            [] -> Some(searching),
          }
        },
      },
  }

pub fn journaling_of(
  analysis: TestListing,
  concluding: List<conclude::Test>,
  era: Bytes,
  chosen: conclude::RunSelection,
) -> Journaling = {
  let declared = concluding.fold(
    Map::new(),
    |found: Map<Int, conclude::Test>, t: conclude::Test| found.insert(t.index, t),
  );
  {
    started: |i: Int| {
      let t = analysis.tests.get(i);
      { key: t.info.key, hash: run_hash(t) }
    },
    stored: |done: JobResult|
      match declared.get(done.test) {
        Some(t) -> conclude::stored_by(conclusion_of(done), t, era, chosen),
        None -> conclude::nothing_stored,
      },
  }
}

pub fn crashes_of(analysis: TestListing, interrupted: List<StartedTest>) -> Map<Int, KnownFailure> =
  if interrupted.len() == 0 { Map::new() } else {
    range(0, analysis.tests.len()).fold(Map::new(), |found: Map<Int, KnownFailure>, i: Int|
      match test_at(analysis, i) {
        None -> found,
        Some(listed) -> {
          let t = listed.info;
          let hash = run_hash(listed);
          if interrupted.any(|s: StartedTest| s.key == t.key && s.hash == hash) {
            found.insert(
              i,
              tester::crashed(
                t,
                interrupted.filter(|s: StartedTest| s.key != t.key).map(|s: StartedTest| s.key),
              ),
            )
          } else { found }
        },
      })
  }

pub fn with_crash(j: Job, crashes: Map<Int, KnownFailure>) -> Job =
  match crashes.get(j.test) {
    Some(f) -> { ..j, entry: { ..j.entry, known_failure: Some(f) } },
    None -> j,
  }

pub fn run_class(
  jobs: List<Job>,
  search_options: SearchOptions,
) -> List<JobResult> / {entering::machine.enter, entering::machine.report, result_cache.started, result_cache.finished, abort.raise} = {
  let lanes = machine::split_into_lanes(jobs, search_options.lanes);
  machine::merge_lanes(run_lanes(lanes, search_options, 0, lanes.len(), 64))
}

fn journaled_run(
  j: Job,
  measuring: Bool,
  journaling: Journaling,
) -> JobResult / {entering::machine.enter, result_cache.started, result_cache.finished, abort.raise} = {
  let started = (journaling.started)(j.test);
  result_cache.started(started);
  let done = run_job(j, measuring);
  result_cache.finished(started.key, (journaling.stored)(done));
  done
}

fn reported(
  done: JobResult,
  j: Job,
  reporting: Reporting,
) -> JobResult / {entering::machine.report} = {
  entering::machine.report(
    finished_line(reporting.style, j.name, done.status, done.usage.duration_us, reporting.width),
    reporting.to_stderr,
  );
  done
}

fn run_lanes(
  lanes: List<List<Job>>,
  options: SearchOptions,
  lo: Int,
  hi: Int,
  depth_left: Int,
) -> List<List<JobResult>> / {entering::machine.enter, entering::machine.report, result_cache.started, result_cache.finished, abort.raise} =
  if hi - lo <= 0 { [] } else if hi - lo == 1 || depth_left <= 0 {
    range(lo, hi).fold([], |lanes_done: List<List<JobResult>>, i: Int|
      match lanes.at(i) {
        Some(lane) ->
          lanes_done.push(
            lane.fold([], |out: List<JobResult>, j: Job|
              out.push(
                reported(
                  journaled_run(j, options.measuring, options.journaling),
                  j,
                  options.reporting,
                ),
              )),
          ),
        None -> lanes_done,
      })
  } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      run_lanes(lanes, options, lo, mid, depth_left - 1),
      run_lanes(lanes, options, mid, hi, depth_left - 1),
    };
    halves._0.concat(halves._1)
  }

type SearchTotals = { usage: Usage, trace: Option<Bytes>, unobserved: Bool }

pub fn run_job(j: Job, measuring: Bool) -> JobResult / {entering::machine.enter, abort.raise} =
  match j.entry.known_failure {
    Some(reason) ->
      {
        test: j.test,
        status: reason.status,
        failure: Some(reason.failure),
        usage: no_usage,
        trace: None,
        searched: None,
      },
    None -> run_listed(j, measuring),
  }

fn run_listed(j: Job, measuring: Bool) -> JobResult / {entering::machine.enter, abort.raise} =
  match j.search {
    None -> {
      let e: ExecutionResult = tester::execute(j.unit, j.entry.test, j.entry.case);
      {
        test: j.test,
        status: e.status,
        failure: e.failure,
        usage: e.usage,
        trace: e.trace,
        searched: None,
      }
    },
    Some(p) -> {
      let again = plan::re_executes(p) || measuring;
      let run = |st: SearchTotals, seed: Seed| {
        let one = tester::run_interleaving(
          j.unit,
          j.entry.test,
          j.entry.case,
          seed,
          p.steps,
          again,
        );
        {
          run: one.run,
          state: {
            usage: sum_usage(st.usage, one.usage),
            trace: joined_trace(st.trace, one.trace),
            unobserved: st.unobserved || !one.observed,
          },
        }
      };
      let begun: SearchTotals = { usage: no_usage, trace: Some(b""), unobserved: false };
      let search_result = if measuring { search::measure_with_state(p, begun, run) }
      else { search::explore_with_state(p, Exact, begun, run) };
      let explored = search_result.explored;
      {
        test: j.test,
        status: match explored.failure {
          None -> "passed",
          Some(fl) -> match search::run_failure(fl) {
            Some(fell) -> fell.status,
            None -> "panicked",
          },
        },
        failure: match explored.failure { Some(fl) -> Some(search_failure(fl)), None -> None },
        usage: search_result.state.usage,
        trace: search_result.state.trace,
        searched: if search_result.state.unobserved { None } else {
          Some({ exploration: explored.exploration, seeds: plan::normalized(p).roots.len() })
        },
      }
    },
  }

fn reproduce(seed: Seed) -> String / {abort.raise} =
  "reproduce with `--sim once --seed " ++ plan::seed_text(seed)
    ++ "`, and report it with the test's source"

fn spanned(span: Option<SourceSpan>, text: String) -> Label =
  { place: source_place(span), primary: true, text: Bytes::of_string(text) }

fn search_failure(fl: Failure<InterleavingFailure>) -> RuntimeDiagnostic / {abort.raise} =
  match search::run_failure(fl) {
    Some(fell) -> { ..fell.failure, diagnostic: with_notes(fell.failure.diagnostic, fl.notes) },
    None -> {
      let d = match fl.cause {
        Diverged(x) ->
          diagnostic_of(
            Error,
            replay_mismatch_code,
            "replaying seed " ++ plan::seed_text(x.seed)
              ++ " did not reproduce the recorded schedule",
            [spanned(x.span, "this scheduling point")],
            [
              x.what,
              "a simulated run must be a pure function of its definition set and its seed; this is an internal error in Ply rather than in the program under test",
              reproduce(x.seed),
            ],
          ),
        InvalidRecording(x) ->
          diagnostic_of(
            Error,
            internal_error_code,
            "the scheduler recorded a step that is not a valid scheduling decision",
            [spanned(x.span, "this step")],
            [x.what, reproduce(x.seed)],
          ),
        _ ->
          diagnostic_of(
            Error,
            internal_error_code,
            "a simulated search stopped at a failure, but the outcome contains no failure",
            [],
            [],
          ),
      };
      { diagnostic: with_notes(d, fl.notes), values: [] }
    },
  }

pub type Reachable = { functions: List<Bytes>, declarations: List<Bytes> }

pub type Hashes = {
  definitions: Map<Bytes, Bytes>,
  declarations: Map<Bytes, Bytes>,
  closure: (List<Bytes>) -> Reachable / {abort.raise},
}

pub fn hashes_of(analysis: ProgramListing) -> Hashes =
  {
    definitions: by_name(analysis.hashes.definitions),
    declarations: by_name(analysis.hashes.declarations),
    closure: |keys: List<Bytes>| {
      let reachable = reach(analysis.hashes, keys.map(|k: Bytes| ItemKeyed(k)));
      { functions: reachable.functions.elements(), declarations: reachable.declarations.elements() }
    },
  }

pub fn no_hashes() -> Hashes =
  {
    definitions: Map::new(),
    declarations: Map::new(),
    closure: |keys: List<Bytes>| { functions: [], declarations: [] },
  }

pub fn changes_of_test(h: Hashes, seen: Set<Bytes>, key: Bytes) -> List<Bytes> / {abort.raise} =
  (h.closure)([key]).functions.filter(|name: Bytes|
    !name.starts_with(b"std.prelude.")
      && (match h.definitions.get(name) {
        Some(hash) -> !seen.contains(hash),
        None -> false,
      })).sort(
  )

pub fn conclude_tests(analysis: TestListing, program: Program) -> List<conclude::Test> =
  range(0, analysis.tests.len()).fold([], |accumulator: List<conclude::Test>, i: Int|
    match test_at(analysis, i) {
      Some(listed) -> {
        let t = listed.info;
        let entry = match case_of(program, i) { Some(c) -> Some(c.entry), None -> None };
        accumulator.push({
          index: i,
          key: t.key,
          seeded: uses_simulation(t.effects),
          hash: run_hash(listed),
          start: match entry { Some(e) -> e.key, None -> t.key },
          case: match entry { Some(e) -> e.case != None, None -> false },
        })
      },
      None -> accumulator,
    })

pub fn seen_of(h: Hashes, failed: List<Bytes>) -> Set<Bytes> / {result_cache.known, abort.raise} =
  if failed.len() == 0 { Set::empty() } else {
    let hashes = (h.closure)(failed).functions.fold([], |found: List<Bytes>, name: Bytes|
      match h.definitions.get(name) { Some(hash) -> found.push(hash), None -> found });
    let results = result_cache.known(hashes);
    range(0, hashes.len()).fold(Set::empty(), |accumulator: Set<Bytes>, i: Int|
      match ((hashes.at(i), results.at(i))) {
        (Some(hash), Some(known)) -> if known { accumulator.insert(hash) } else { accumulator },
        _ -> accumulator,
      })
  }

pub fn conclusion_of(done: JobResult) -> conclude::TestResult<RuntimeDiagnostic> =
  {
    index: done.test,
    status: done.status,
    failure: done.failure,
    host: done.usage.used_host,
    trace: done.trace,
    searched: match done.searched {
      Some(x) ->
        Some({
          explored: x.exploration.explored,
          exhaustive: x.exploration.exhaustive,
          exhausted: x.exploration.exhausted,
          failed: x.exploration.failure != None,
        }),
      None -> None,
    },
    seeds: match done.searched { Some(x) -> x.seeds, None -> 0 },
  }

fn result_at(done: Map<Int, JobResult>, index: Int) -> Option<JobResult> = done.get(index)

fn cost_of(c: Option<search::Cost>) -> Option<Cost> =
  match c {
    None -> None,
    Some(x) ->
      Some({
        explored: x.explored,
        bounded: x.stopped_early,
        rendered: (if x.stopped_early { ">= " } else { "" }) ++ x.explored.to_string(),
      }),
  }

fn reduction_tenths_of(e: Exploration) -> Option<Int> =
  match e.naive {
    None -> None,
    Some(naive) -> if e.explored > 0 { Some((naive.explored * 20 + e.explored) / (2 * e.explored)) }
    else { None },
  }

fn explored_of(e: Exploration) -> SearchSummary / {abort.raise} =
  {
    explored: e.explored,
    exhaustive: e.exhaustive,
    exhausted: e.exhausted,
    clockless: cost_of(e.no_clocks),
    naive: cost_of(e.naive),
    reduction_tenths: reduction_tenths_of(e),
    steps: e.steps,
    virtual_time_ns: e.virtual_time,
    failing_seed: match e.failure { Some(seed) -> Some(plan::seed_text(seed)), None -> None },
  }

fn exploration_of(done: Map<Int, JobResult>, index: Int) -> Option<Exploration> =
  match result_at(done, index) {
    Some(d) -> match d.searched { Some(x) -> Some(x.exploration), None -> None },
    None -> None,
  }

fn site_of(x: search::RaceSite) -> Site =
  { task: "@" ++ x.task.to_string(), definition: x.definition, access: x.access, at: x.span }

pub fn job_outcome(analysis: TestListing, done: JobResult) -> Outcome / {abort.raise} =
  {
    index: done.test,
    name: match test_at(analysis, done.test) {
      Some(t) -> String::of_bytes_lossy(t.info.name),
      None -> "",
    },
    hash: hash_at(analysis, done.test),
    duration_us: done.usage.duration_us,
    status: done.status,
    diagnostic: done.failure,
    search: match done.searched { Some(x) -> Some(explored_of(x.exploration)), None -> None },
    cached: None,
    performs: done.usage.performs,
  }

fn outcome_of(
  analysis: TestListing,
  done: Map<Int, JobResult>,
  outcome: conclude::Outcome<RuntimeDiagnostic>,
) -> Outcome / {abort.raise} = {
  let d = result_at(done, outcome.index);
  {
    index: outcome.index,
    name: match test_at(analysis, outcome.index) {
      Some(t) -> String::of_bytes_lossy(t.info.name),
      None -> "",
    },
    hash: hash_at(analysis, outcome.index),
    duration_us: match d { Some(x) -> x.usage.duration_us, None -> 0 },
    status: outcome.status,
    diagnostic: outcome.failure,
    search: match exploration_of(done, outcome.index) {
      Some(e) -> Some(explored_of(e)),
      None -> None,
    },
    cached: match outcome.recorded { Some(record) -> Some(is_written(record)), None -> None },
    performs: match d { Some(x) -> x.usage.performs, None -> 0 },
  }
}

fn failed_of(
  analysis: TestListing,
  h: Hashes,
  done: Map<Int, JobResult>,
  failed: conclude::TestFailure<RuntimeDiagnostic>,
) -> Failed / {abort.raise} = {
  let t = test_at(analysis, failed.index).map(|x: SelectedTest| x.info);
  let e = exploration_of(done, failed.index);
  let key = String::of_bytes_lossy(failed.key);
  {
    key: key,
    name: match t { Some(x) -> String::of_bytes_lossy(x.name), None -> key },
    diagnostic: failed.failure,
    internal_error: failed.internal_error,
    changes: failed.changes.map(|name: Bytes|
      {
        name: String::of_bytes_lossy(name),
        hash: match h.definitions.get(name) {
          Some(x) -> Some(x.hex_of()),
          None -> match h.declarations.get(name) { Some(x) -> Some(x.hex_of()), None -> None },
        },
      }),
    unchanged: failed.changes.len() == 0,
    seed: match e {
      Some(x) -> match x.failure { Some(seed) -> Some(plan::seed_text(seed)), None -> None },
      None -> None,
    },
    race: match e {
      Some(x) -> match x.race {
        Some(race) ->
          Some({
            left: site_of(race.left),
            right: site_of(race.right),
            step: race.scheduling_point,
          }),
        None -> None,
      },
      None -> None,
    },
    module: match t { Some(x) -> Some(String::of_bytes_lossy(x.module)), None -> None },
    test_hash: hash_at(analysis, failed.index),
    nondet: match t { Some(x) -> Some(x.nondet), None -> None },
    status: match result_at(done, failed.index) { Some(d) -> Some(d.status), None -> None },
    declared: match t { Some(x) -> Some(effect_texts(canonical(x.effects))), None -> None },
  }
}

fn escapes_of(
  analysis: TestListing,
  c: Conclusion<RuntimeDiagnostic>,
  done: Map<Int, JobResult>,
) -> List<Diagnostic> = {
  let unbound = |index: Int|
    match result_at(done, index) {
      Some(d) ->
        d.usage.used_host
          && (match d.trace {
            Some(trace) -> match trace_of(trace) {
              Checkable(reads) -> !reads.any(|r: RecordedRead| r.read == UsedBinding),
              Unchecked(_) -> false,
            },
            None -> false,
          }),
      None -> false,
    };
  c.outcomes.fold(
    [],
    |accumulator: List<Diagnostic>, outcome: conclude::Outcome<RuntimeDiagnostic>| {
      let wrote = match outcome.recorded { Some(record) -> is_written(record), None -> false };
      if !wrote || !unbound(outcome.index) { accumulator } else {
        accumulator.push(
          diagnostic_of(
            Error,
            internal_error_code,
            "`"
              ++ (match test_at(analysis, outcome.index) {
                Some(t) -> String::of_bytes_lossy(t.info.name),
                None -> "",
              })
              ++ "` performed real system operations, but its passing result was cached without the list of operations the run used",
            [],
            [
              "a passing result of a test that performs system operations is valid only together with the list of operations the run used",
              "run `ply cache clear`: a cache entry written without that list could be reused by a run that performs different system operations",
              "this is a bug in Ply — the test runner and the test analysis disagree about which system operations this test performed",
            ],
          ),
        )
      }
    },
  )
}

fn notice_of(n: conclude::Notice) -> Diagnostic =
  match n {
    StaleIndex(x) ->
      diagnostic_of(
        Warning,
        internal_error_code,
        "a saved simulation result refers to test number " ++ x.index.to_string()
          ++ ", but the module defines only "
          ++ x.declared.to_string(),
        [],
        ["the choice was made against another program; the stale index was skipped"],
      ),
    UnobservedSearch(key) ->
      diagnostic_of(
        Warning,
        internal_error_code,
        "`" ++ String::of_bytes_lossy(key)
          ++ "` uses a simulation seed, but the run did not report which schedules it tried",
        [],
        [
          "the test passed and its result was not cached, so it re-runs next time",
          "this is an internal error in Ply rather than in the test; please report it",
        ],
      ),
  }

pub fn run_report_of(
  options: Options,
  program: Program,
  analysis: TestListing,
  h: Hashes,
  covered: Option<Coverage>,
  decided: RunDecision,
  hosted: BindingReport,
  c: Conclusion<RuntimeDiagnostic>,
  done: Map<Int, JobResult>,
  elapsed: Int,
  extra_warnings: List<Diagnostic>,
) -> RunReport / {abort.raise} = {
  let ordered = c.outcomes.fold(
    [],
    |accumulator: List<JobResult>, outcome: conclude::Outcome<RuntimeDiagnostic>|
      match result_at(done, outcome.index) { Some(d) -> accumulator.push(d), None -> accumulator },
  );
  let teardown = ordered.fold([], |accumulator: List<Diagnostic>, d: JobResult|
    accumulator.concat(d.usage.teardown));
  let b = hosted.backend;
  {
    operations: hosted.operations,
    digest: hosted.digest,
    handshakes: [],
    hosts: hosted.hosts,
    tests_using_host: hosted.host_test_indices.filter(|i: Int| case_of(program, i) != None),
    workers: match options.jobs {
      Some(n) -> if n > 0 { n } else { hosted.cores },
      None -> hosted.cores,
    },
    backend: Some({
      name: b.name,
      fragment: b.fragment,
      entered: done.fold(0, |n: Int, i: Int, d: JobResult| n + d.usage.entries),
      load_nanos: b.load_nanos,
    }),
    results: c.outcomes.map(|outcome: conclude::Outcome<RuntimeDiagnostic>|
      outcome_of(analysis, done, outcome)),
    failures: c.failures.map(|failed: conclude::TestFailure<RuntimeDiagnostic>|
      failed_of(analysis, h, done, failed)),
    summary: {
      passed: c.passed,
      failed: c.failed,
      timed_out: c.timed_out,
      cached: cached_count(program, decided),
      duration_us: elapsed,
    },
    simulation: c.simulation,
    unbound_pass_diagnostics: escapes_of(analysis, c, done),
    warnings: teardown.concat(c.notices.map(notice_of)).concat(extra_warnings),
    coverage: covered,
    spent: no_time_spent,
  }
}

type ModuleRollup = { key: Bytes, at: List<Int> }

fn module_rollups(
  rows: List<Row>,
  keys: List<Bytes>,
  search: Search,
) -> List<ModuleRollup> / {abort.raise} =
  List::group_by(
    range(0, rows.len()).filter(|i: Int|
      !rows.get(i).nondet && !keyed_per_root(rows.get(i), search)),
    |i: Int| rows.get(i).module,
  ).values(
  ).map(|at: List<Int>|
    {
      key: blake3(Bytes::concat_all(at.map(|i: Int| keys.get(i)).push(b"a module's tests"))),
      at: at,
    })

pub type DecidedCases = { cases: List<select::Case>, rolled: List<Pass> }

test "a module's rollup covers its plain tests, leaves out `test/nondet`, and moves with any identity" {
  let row = |name: String, module: String, always: Bool|
    {
      index: 0,
      label: name,
      name: name,
      module: module,
      hash: b"h",
      seeded: false,
      nondet: always,
    };
  let rows = [row("a", "m", false), row("b", "m", false), row("c", "n", true)];
  let search = { mode: "", roots: [], budget: 0, steps: 0, path: [], profile: cc::development() };
  let rollups_of = |keys: List<Bytes>| module_rollups(rows, keys, search);
  let keys = [b"one", b"two", b"three"];
  assert_eq(rollups_of(keys).map(|m: ModuleRollup| m.at), [[0, 1]]);
  assert(
    rollups_of(keys).map(|m: ModuleRollup| m.key)
      != rollups_of([b"one", b"moved", b"three"]).map(|m: ModuleRollup| m.key),
  )
}

pub fn cases_of<| e>(
  rows: List<Row>,
  search: Search,
  passes_holding: (List<Pass>) -> Set<Bytes> / {abort.raise | e},
) -> DecidedCases / {result_cache.passes, abort.raise | e} = {
  let keys = rows.map(|r: Row| key_of(r, search));
  let rollups = module_rollups(rows, keys, search);
  let rollup_keys = rollups.map(|m: ModuleRollup| m.key);
  let rollup_passes = standing(rollup_keys, result_cache.passes(rollup_keys), passes_holding);
  let whole = range(0, rollups.len()).fold(Set::empty(), |found: Set<Int>, k: Int|
    if rollup_passes.at_or(k, None) == None { found }
    else { rollups.get(k).at.fold(found, |in_whole: Set<Int>, i: Int| in_whole.insert(i)) });
  let tests = range(0, rows.len());
  let queried = tests.filter(|i: Int| !whole.contains(i));
  let rooted = rows.map(|r: Row|
    if keyed_per_root(r, search) { Some(seed_keys(r.hash, search.roots, [], search.profile)) }
    else { None });
  let asked = queried.map(|i: Int| keys.get(i)).concat(
    rooted.fold([], |found: List<Bytes>, ks: Option<List<Bytes>>|
      match ks { Some(xs) -> found.concat(xs), None -> found }),
  );
  let stored = standing(asked, result_cache.passes(asked), passes_holding);
  let answered = range(0, queried.len()).fold(
    Map::new(),
    |found: Map<Int, Option<List<RecordedRead>>>, k: Int|
      found.insert(queried.get(k), stored.at_or(k, None)),
  );
  let stored_at = |i: Int|
    if whole.contains(i) { Some([]) } else { answered.get(i).unwrap_or(None) };
  let recorded = tests.map(stored_at);
  let seeded = rooted.fold(
    { at: queried.len(), out: [] },
    |s: { at: Int, out: List<Option<List<Option<List<RecordedRead>>>>> }, ks: Option<List<Bytes>>|
      match ks {
        Some(xs) ->
          { at: s.at + xs.len(), out: s.out.push(Some(stored.drop(s.at).take(xs.len()))) },
        None -> { ..s, out: s.out.push(None) },
      },
  ).out;
  let stored_passes = recorded.map(is_stored_pass);
  let pending_seed_roots = seeded.map(|o: Option<List<Option<List<RecordedRead>>>>|
    match o {
      Some(xs) -> Some(pending_roots(search.roots, xs.map(is_stored_pass))),
      None -> None,
    });
  {
    cases: tests.map(|i: Int|
      select::case_of(rows.get(i), keys.get(i), stored_passes.get(i), pending_seed_roots.get(i))),
    rolled: rollups.filter(|m: ModuleRollup|
      m.at.any(|i: Int| !whole.contains(i)) && m.at.all(|i: Int| stored_at(i) == Some([]))).map(
      |m: ModuleRollup| { key: m.key, reads: [] },
    ),
  }
}

fn standing<| e>(
  keys: List<Bytes>,
  stored: List<Option<List<RecordedRead>>>,
  passes_holding: (List<Pass>) -> Set<Bytes> / {abort.raise | e},
) -> List<Option<List<RecordedRead>>> / {abort.raise | e} = {
  let held = passes_holding(
    range(0, keys.len()).fold([], |found: List<Pass>, i: Int|
      match stored.at_or(i, None) {
        Some(reads) -> found.push({ key: keys.get(i), reads: reads }),
        None -> found,
      }),
  );
  range(0, keys.len()).map(|i: Int|
    if held.contains(keys.get(i)) { stored.at_or(i, None) } else { None })
}

fn is_stored_pass(stored: Option<List<RecordedRead>>) -> Bool = stored != None

pub fn diagnosed_all(
  view: Option<{ whole: ProgramListing, places: List<SourceText> }>,
  c: Conclusion<RuntimeDiagnostic>,
  failures: List<Failed>,
) -> { faults: List<Fault>, diffs: List<ChangeDiff> } / {result_cache.baselines, result_cache.texts, abort.raise} = {
  let records = if failures.len() == 0 { failures.map(|f: Failed| None) } else {
    result_cache.baselines(c.failures.map(|f: conclude::TestFailure<RuntimeDiagnostic>| f.key))
  };
  match if records.all(|r: Option<LastPass>| r == None) { None } else { view } {
    None -> { faults: failures.map(|f: Failed| fault_of(f, None)), diffs: [] },
    Some(v) -> {
      let tree = changes::program_of(v.places, v.whole);
      let sides = range(0, failures.len()).map(|i: Int|
        match ((failures.at(i), records.at(i))) {
          (Some(f), Some(Some(record))) -> Some(compared(tree, f.key, f.test_hash, record)),
          _ -> None,
        });
      let then = stored_baseline_texts(
        sides.fold([], |accumulator: List<Compared>, x: Option<Compared>|
          match x { Some(c) -> accumulator.push(c), None -> accumulator }),
      );
      let deltas = sides.map(|x: Option<Compared>|
        match x { Some(c) -> Some(delta_of(tree, c, then)), None -> None });
      {
        faults: range(0, failures.len()).flat_map(|i: Int|
          match failures.at(i) { Some(f) -> [fault_of(f, deltas.at_or(i, None))], None -> [] }),
        diffs: change_diffs(
          tree,
          deltas.fold([], |accumulator: List<Delta>, d: Option<Delta>|
            match d { Some(x) -> accumulator.push(x), None -> accumulator }),
          then,
        ),
      }
    },
  }
}

pub fn fault_of(failed: Failed, delta: Option<Delta>) -> Fault =
  {
    key: failed.key,
    name: failed.name,
    diagnostic: failed.diagnostic,
    internal_error: failed.internal_error,
    changes: changes_of(failed.changes, delta),
    unchanged: failed.unchanged,
    seed: failed.seed,
    race: failed.race,
    replay: match failed.seed { Some(seed) -> replay_of(seed, failed.name), None -> None },
    module: failed.module,
    test_hash: failed.test_hash,
    nondet: failed.nondet,
    status: failed.status,
    declared: failed.declared,
  }

pub fn replay_of(seed: String, name: String) -> Option<String> =
  shell_join(["ply", "test", "--seed", seed, "--filter", name])

test "a replay is one command whatever the test is called" {
  assert_eq(
    replay_of("0:1", "it's \"$HOME\" `now`"),
    Some("ply test --seed 0:1 --filter 'it'\\''s \"$HOME\" `now`'"),
  );
  assert_eq(replay_of("0:1", "plain"), Some("ply test --seed 0:1 --filter plain"));
  assert_eq(replay_of("0:1", "a\0b"), None)
}

test "a search stopped early shows its count as `>= N`, and the reduction ratio needs the count of a search without pruning" {
  assert_eq(
    cost_of(Some({ explored: 4096, stopped_early: true })),
    Some({ explored: 4096, bounded: true, rendered: ">= 4096" }),
  );
  assert_eq(cost_of(None), None);
  let e: Exploration = {
    explored: 12,
    exhaustive: true,
    exhausted: false,
    naive: None,
    no_clocks: None,
    steps: 8,
    virtual_time: 0,
    failure: None,
    race: None,
  };
  assert_eq(reduction_tenths_of(e), None);
  assert_eq(
    reduction_tenths_of({ ..e, naive: Some({ explored: 120, stopped_early: false }) }),
    Some(100),
  );
  assert_eq(
    reduction_tenths_of({ ..e, naive: Some({ explored: 40, stopped_early: false }) }),
    Some(33),
  );
  assert_eq(
    reduction_tenths_of({ ..e, explored: 0, naive: Some({ explored: 40, stopped_early: false }) }),
    None,
  );
  assert_eq(
    explored_of({ ..e, failure: Some({ root: 7u64, path: [1, 0] }) }).failing_seed,
    Some("7:1.0"),
  )
}

test "the outcome of a failed test includes the diagnostic it failed with" {
  let view = listing_of_program(
    identified_program(
      in_memory([{ name: b"m", source_text: b"test \"red\" { assert_eq(1, 2) }\n" }]),
    ),
  );
  let raised = {
    diagnostic: diagnostic_of(Error, b"E0501", "assertion failed", [], []),
    values: [],
  };
  let failed = {
    test: 0,
    status: "failed",
    failure: Some(raised),
    usage: no_usage,
    trace: None,
    searched: None,
  };
  assert_eq(job_outcome(view, failed).diagnostic, Some(raised))
}
