// --- What the loaded tree tells a selector ------------------------------------

/// The hash of the test at `i`, as the hasher hands it over.
pub fn test_hash_at(analysis: CheckedProgram, i: Int) -> Option<Bytes> =
  match test_at(analysis, i) { Some(t) -> analysis.frame.hashes.tests.get(t.key), None -> None }

/// The same as a report prints it.
pub fn hash_at(analysis: CheckedProgram, i: Int) -> Option<String> / {abort.raise} =
  match test_hash_at(analysis, i) { Some(h) -> Some(h.hex_of()), None -> None }

/// Something in its closure entered a `simulate` region, so it reads a seed and is searched.
pub fn seeded_of(atoms: List<types::Atom>) -> Bool =
  atoms.fold(false, |found: Bool, a: types::Atom| found || a.effect == b"sim")

// --- A test over cases --------------------------------------------------------

pub fn entry_of(index: Int, key: Bytes) -> Entry =
  { test: index, of: key, case: None, unlisted: None }

/// What the run's searches are asked: the plan a seeded test searches, whether to measure what the
/// pruning saved, and how many lanes run tests at once — one per test when `--jobs` names none.
type SearchOptions = { plan: plan::Plan, measuring: Bool, lanes: Option<Int> }

/// One test to run in one unit, how that unit is asked for it, and the plan it searches when it is
/// seeded.
type Job = { unit: TestUnit, test: Int, entry: Entry, search: Option<plan::Plan> }

/// How one test ended, what running it cost, and what its search explored, when it searched and every
/// interleaving of it entered a region.
pub type JobResult = {
  test: Int,
  status: String,
  failure: Option<RuntimeDiagnostic>,
  usage: Usage,
  /// What every run of it read between them, `None` when no trace stands in for one.
  trace: Option<Bytes>,
  searched: Option<{ exploration: Exploration, seeds: Int }>,
}

/// A seeded test searches the roots it still owes; any other runs once.
pub fn job_of(
  program: Program,
  unit: TestUnit,
  index: Int,
  narrowing: List<{ index: Int, roots: List<Int> }>,
  searching: plan::Plan,
) -> Job / {abort.raise} =
  match case_of(program, index) {
    None -> { unit: unit, test: index, entry: entry_of(index, b""), search: None },
    Some(c) ->
      {
        unit: unit,
        test: index,
        entry: c.entry,
        search: if !c.seeded { None } else {
          match narrowing.filter(|n: { index: Int, roots: List<Int> }| n.index == index) {
            [owed, ..] -> Some({ ..searching, roots: owed.roots.map(|r: Int| U64::of_int(r)) }),
            [] -> Some(searching),
          }
        },
      },
  }

/// One class's tests at once: each in a lane of its own, or dealt across the lanes `--jobs` names,
/// a lane's tests in turn, answered in the class's order.
pub fn run_class(
  jobs: List<Job>,
  search_options: SearchOptions,
) -> List<JobResult> / {entering::machine.enter, abort.raise} = {
  let lanes = machine::split_into_lanes(jobs, search_options.lanes);
  machine::merge_lanes(run_lanes(lanes, search_options.measuring, 0, lanes.len(), 64))
}

/// Halves under a `parallel` block until one lane is left, so lanes run at once; each lane answers
/// with its tests' in turn. `depth_left` is the halvings left, and 64 take any length to one.
fn run_lanes(
  lanes: List<List<Job>>,
  measuring: Bool,
  lo: Int,
  hi: Int,
  depth_left: Int,
) -> List<List<JobResult>> / {entering::machine.enter, abort.raise} =
  if hi - lo <= 0 { [] } else if hi - lo == 1 || depth_left <= 0 {
    range(lo, hi).fold([], |lanes_done: List<List<JobResult>>, i: Int|
      match lanes.at(i) {
        Some(lane) ->
          lanes_done.push(
            lane.fold([], |out: List<JobResult>, j: Job| out.push(run_job(j, measuring))),
          ),
        None -> lanes_done,
      })
  } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      run_lanes(lanes, measuring, lo, mid, depth_left - 1),
      run_lanes(lanes, measuring, mid, hi, depth_left - 1),
    };
    halves._0.concat(halves._1)
  }

/// What a search's runs come to between them: what they cost and read, and whether one of them
/// never entered a region, which makes the whole search no search.
type SearchTotals = { usage: Usage, trace: Option<Bytes>, unobserved: Bool }

/// A test once, or a seeded one searched an interleaving at a time. One whose cases could not be
/// listed ends as the listing did.
pub fn run_job(j: Job, measuring: Bool) -> JobResult / {entering::machine.enter, abort.raise} =
  match j.entry.unlisted {
    Some(why) ->
      {
        test: j.test,
        status: why.status,
        failure: Some(why.failure),
        usage: no_usage(),
        trace: None,
        searched: None,
      },
    None -> run_listed(j, measuring),
  }

fn run_listed(j: Job, measuring: Bool) -> JobResult / {entering::machine.enter, abort.raise} =
  match j.search {
    None -> {
      let e: ExecutionResult = tester::execute(j.unit, j.entry.test, j.entry.case);
      {
        test: j.test,
        status: e.status,
        failure: e.failure,
        usage: e.usage,
        trace: e.trace,
        searched: None,
      }
    },
    Some(p) -> {
      // A search re-runs the whole test, so any host operation runs once per interleaving.
      let again = plan::re_executes(p) || measuring;
      let run = |st: SearchTotals, seed: Seed| {
        let one = tester::run_interleaving(
          j.unit,
          j.entry.test,
          j.entry.case,
          seed,
          p.steps,
          again,
        );
        {
          run: one.run,
          state: {
            usage: sum_usage(st.usage, one.usage),
            trace: joined_trace(st.trace, one.trace),
            unobserved: st.unobserved || !one.observed,
          },
        }
      };
      let begun: SearchTotals = { usage: no_usage(), trace: Some(b""), unobserved: false };
      let kept = if measuring { search::measure_with_state(p, begun, run) }
      else { search::explore_with_state(p, Exact, begun, run) };
      let explored = kept.explored;
      {
        test: j.test,
        status: match explored.failure {
          None -> "passed",
          // A recording that names no schedule, or a replay that took another, is Ply's fault.
          Some(fl) -> match search::run_failure(fl) {
            Some(fell) -> fell.status,
            None -> "panicked",
          },
        },
        failure: match explored.failure { Some(fl) -> Some(search_failure(fl)), None -> None },
        usage: kept.state.usage,
        trace: kept.state.trace,
        searched: if kept.state.unobserved { None } else {
          Some({ exploration: explored.exploration, seeds: plan::normalized(p).roots.len() })
        },
      }
    },
  }

fn reproduce(seed: Seed) -> String / {abort.raise} =
  "reproduce with `--sim once --seed " ++ plan::seed_text(seed)
    ++ "`, and report it with the test's source"

fn spanned(span: { module: Int, start: Int, end: Int }, said: String) -> Label =
  {
    module: span.module,
    start: span.start,
    end: span.end,
    primary: true,
    text: Bytes::of_string(said),
  }

/// Why a search stopped at a seed, as the diagnostic a report prints: the run's own failure, or the
/// defect a recording that names no schedule, or a replay that took another, is.
fn search_failure(fl: Failure<InterleavingFailure>) -> RuntimeDiagnostic / {abort.raise} =
  match search::run_failure(fl) {
    Some(fell) -> { ..fell.failure, diag: with_notes(fell.failure.diag, fl.notes) },
    None -> {
      let d = match fl.cause {
        Diverged(x) ->
          diag_of(
            "error",
            "E0415",
            "replaying seed " ++ plan::seed_text(x.seed)
              ++ " did not reproduce the recorded schedule",
            [spanned(x.span, "this scheduling point")],
            [
              x.what,
              "a simulated run must be a pure function of its definition set and its seed; this is a defect in Ply rather than in the program under test",
              reproduce(x.seed),
            ],
          ),
        InvalidRecording(x) ->
          diag_of(
            "error",
            "E0505",
            "the scheduler recorded a step that does not describe a schedule",
            [spanned(x.span, "this step")],
            [x.what, reproduce(x.seed)],
          ),
        _ -> diag_of("error", "E0505", "a search stopped at a failure it does not hold", [], []),
      };
      { diag: with_notes(d, fl.notes), values: [] }
    },
  }

// --- What the run establishes ------------------------------------------------

/// The program `analysis` is, as a run concludes over it, in the era `era` names.
pub fn hashes_of(analysis: CheckedProgram, era: Bytes) -> Hashes / {abort.raise} =
  {
    defs: by_name(analysis.frame.hashes.defs),
    decls: by_name(analysis.frame.hashes.decls),
    era: era,
    closure: |keys: List<Bytes>| {
      let reached = reach(analysis.frame.hashes, keys.map(|k: Bytes| ItemKeyed(k)));
      { fns: reached.fns.keys(), decls: reached.decls.keys() }
    },
  }

/// The run's tests, each with where a later run walks what it reached from: the test it is, or the
/// test it is a case of, as `program` enters it.
pub fn conclude_tests(
  analysis: CheckedProgram,
  program: Program,
) -> List<conclude::Test> / {abort.raise} =
  range(0, analysis.checked.tests.len()).fold([], |acc: List<conclude::Test>, i: Int|
    match test_at(analysis, i) {
      Some(t) -> {
        let entry = match case_of(program, i) { Some(c) -> Some(c.entry), None -> None };
        acc.push({
          index: i,
          key: t.key,
          seeded: seeded_of(t.footprint),
          hash: test_hash_at(analysis, i),
          of: match entry { Some(e) -> e.of, None -> t.key },
          case: match entry { Some(e) -> e.case != None, None -> false },
        })
      },
      None -> acc,
    })

/// Whether the store had seen each definition before this run, which a failure is suspected against.
pub fn seen_of(h: Hashes) -> Map<Bytes, Bool> / {result_cache.known} = {
  let hashes = h.defs.values();
  let answers = result_cache.known(hashes);
  range(0, hashes.len()).fold(Map::new(), |acc: Map<Bytes, Bool>, i: Int|
    match ((hashes.at(i), answers.at(i))) {
      (Some(hash), Some(known)) -> acc.insert(hash, known),
      _ -> acc,
    })
}

pub fn conclusion_of(done: JobResult) -> conclude::TestResult<RuntimeDiagnostic> =
  {
    index: done.test,
    status: done.status,
    failure: done.failure,
    host: done.usage.host,
    trace: done.trace,
    searched: match done.searched {
      Some(x) ->
        Some({
          explored: x.exploration.explored,
          exhaustive: x.exploration.exhaustive,
          exhausted: x.exploration.exhausted,
          failed: x.exploration.failure != None,
        }),
      None -> None,
    },
    seeds: match done.searched { Some(x) -> x.seeds, None -> 0 },
  }

fn result_at(done: Map<Int, JobResult>, index: Int) -> Option<JobResult> = done.get(index)

fn cost_of(c: Option<search::Cost>) -> Option<Cost> =
  match c {
    None -> None,
    Some(x) ->
      Some({
        explored: x.explored,
        bounded: x.bounded,
        rendered: (if x.bounded { ">= " } else { "" }) ++ x.explored.to_string(),
      }),
  }

/// How many times more an unpruned search would have run, in tenths, rounded half up.
fn tenths_of(e: Exploration) -> Option<Int> =
  match e.naive {
    None -> None,
    Some(naive) -> if e.explored > 0 { Some((naive.explored * 20 + e.explored) / (2 * e.explored)) }
    else { None },
  }

fn explored_of(e: Exploration) -> SearchSummary / {abort.raise} =
  {
    explored: e.explored,
    exhaustive: e.exhaustive,
    exhausted: e.exhausted,
    blind: cost_of(e.blind),
    naive: cost_of(e.naive),
    reduction_tenths: tenths_of(e),
    steps: e.steps,
    virtual_time_ns: e.virtual_time,
    failing_seed: match e.failure { Some(seed) -> Some(plan::seed_text(seed)), None -> None },
  }

fn exploration_of(done: Map<Int, JobResult>, index: Int) -> Option<Exploration> =
  match result_at(done, index) {
    Some(d) -> match d.searched { Some(x) -> Some(x.exploration), None -> None },
    None -> None,
  }

fn site_of(x: search::RaceSite) -> Site =
  {
    task: "@" ++ x.task.to_string(),
    definition: x.definition,
    access: x.access,
    at: if x.span.module == no_module() { None } else { Some(x.span) },
  }

/// A test as its group ran it, which is all its result line says; the conclusion adds the failure
/// and what was filed.
pub fn job_outcome(analysis: CheckedProgram, done: JobResult) -> Outcome / {abort.raise} =
  {
    index: done.test,
    name: match test_at(analysis, done.test) {
      Some(t) -> String::of_bytes_lossy(t.name),
      None -> "",
    },
    hash: hash_at(analysis, done.test),
    duration_us: done.usage.duration_us,
    status: done.status,
    diagnostic: done.failure,
    search: match done.searched { Some(x) -> Some(explored_of(x.exploration)), None -> None },
    cached: None,
    performs: done.usage.performs,
  }

fn outcome_of(
  analysis: CheckedProgram,
  done: Map<Int, JobResult>,
  outcome: conclude::Outcome<RuntimeDiagnostic>,
) -> Outcome / {abort.raise} = {
  let d = result_at(done, outcome.index);
  {
    index: outcome.index,
    name: match test_at(analysis, outcome.index) {
      Some(t) -> String::of_bytes_lossy(t.name),
      None -> "",
    },
    hash: hash_at(analysis, outcome.index),
    duration_us: match d { Some(x) -> x.usage.duration_us, None -> 0 },
    status: outcome.status,
    diagnostic: outcome.failure,
    search: match exploration_of(done, outcome.index) {
      Some(e) -> Some(explored_of(e)),
      None -> None,
    },
    cached: match outcome.recorded { Some(rec) -> Some(is_written(rec)), None -> None },
    performs: match d { Some(x) -> x.usage.performs, None -> 0 },
  }
}

fn failed_of(
  analysis: CheckedProgram,
  h: Hashes,
  done: Map<Int, JobResult>,
  failed: conclude::TestFailure<RuntimeDiagnostic>,
) -> Failed / {abort.raise} = {
  let t = test_at(analysis, failed.index);
  let e = exploration_of(done, failed.index);
  let key = String::of_bytes_lossy(failed.key);
  {
    key: key,
    name: match t { Some(x) -> String::of_bytes_lossy(x.name), None -> key },
    diagnostic: failed.failure,
    defect: failed.defect,
    suspects: failed.suspects.map(|name: Bytes|
      {
        name: String::of_bytes_lossy(name),
        hash: match h.defs.get(name) {
          Some(x) -> Some(x.hex_of()),
          None -> match h.decls.get(name) { Some(x) -> Some(x.hex_of()), None -> None },
        },
      }),
    unchanged: failed.suspects.len() == 0,
    seed: match e {
      Some(x) -> match x.failure { Some(seed) -> Some(plan::seed_text(seed)), None -> None },
      None -> None,
    },
    race: match e {
      Some(x) -> match x.race {
        Some(race) -> Some({ left: site_of(race.left), right: site_of(race.right), step: race.at }),
        None -> None,
      },
      None -> None,
    },
    module: match t { Some(x) -> Some(String::of_bytes_lossy(x.module)), None -> None },
    test_hash: hash_at(analysis, failed.index),
    nondet: match t { Some(x) -> Some(x.nondet), None -> None },
    status: match result_at(done, failed.index) { Some(d) -> Some(d.status), None -> None },
    declared: match t { Some(x) -> Some(atom_texts(canonical(x.footprint))), None -> None },
  }
}

/// A pass a run under another binding would believe, filed for a run that reached the host without
/// the binding it ran under: a run that is green over a seam nothing reached.
fn escapes_of(
  analysis: CheckedProgram,
  c: Conclusion<RuntimeDiagnostic>,
  done: Map<Int, JobResult>,
) -> List<Diag> = {
  let unbound = |index: Int|
    match result_at(done, index) {
      Some(d) ->
        d.usage.host
          && (match d.trace {
            Some(trace) -> !String::contains("\n" ++ String::of_bytes_lossy(trace), "\nbinding\t"),
            None -> false,
          }),
      None -> false,
    };
  c.outcomes.fold([], |acc: List<Diag>, outcome: conclude::Outcome<RuntimeDiagnostic>| {
    let wrote = match outcome.recorded { Some(rec) -> is_written(rec), None -> false };
    if !wrote || !unbound(outcome.index) { acc } else {
      acc.push(
        diag_of(
          "error",
          "E0505",
          "`"
            ++ (match test_at(analysis, outcome.index) {
              Some(t) -> String::of_bytes_lossy(t.name),
              None -> "",
            })
            ++ "` reached the host, and its pass was written without the binding it ran under",
          [],
          [
            "a pass that reached the host answers only for the binding it ran under",
            "run `ply cache clear`: an entry written here would be believed by a run under another binding",
            "this is Ply's fault — the runner and the tester disagree about what this test reached",
          ],
        ),
      )
    }
  })
}

fn notice_of(n: conclude::Notice) -> Diag =
  match n {
    StaleIndex(x) ->
      diag_of(
        "warning",
        "E0505",
        "a run named test " ++ x.index.to_string() ++ ", but the module defines "
          ++ x.declared.to_string(),
        [],
        ["the choice was made against another program; the stale index was skipped"],
      ),
    UnobservedSearch(key) ->
      diag_of(
        "warning",
        "E0505",
        "`" ++ String::of_bytes_lossy(key)
          ++ "` reads a simulation seed, but the run reported no search",
        [],
        [
          "the test passed and its result was not cached, so it re-runs next time",
          "this is a defect in Ply rather than in the test; please report it",
        ],
      ),
  }

pub fn run_report_of(
  options: Options,
  program: Program,
  analysis: CheckedProgram,
  h: Hashes,
  decided: RunDecision,
  hosted: BindingReport,
  c: Conclusion<RuntimeDiagnostic>,
  done: Map<Int, JobResult>,
  elapsed: Int,
  said: List<Diag>,
) -> RunReport / {abort.raise} = {
  let ordered = c.outcomes.fold(
    [],
    |acc: List<JobResult>, outcome: conclude::Outcome<RuntimeDiagnostic>|
      match result_at(done, outcome.index) { Some(d) -> acc.push(d), None -> acc },
  );
  let teardown = ordered.fold([], |acc: List<Diag>, d: JobResult| acc.concat(d.usage.teardown));
  let b = hosted.backend;
  {
    operations: hosted.operations,
    digest: hosted.digest,
    handshakes: [],
    hosts: hosted.hosts,
    reaches: hosted.reaches.filter(|i: Int| case_of(program, i) != None),
    workers: match options.jobs {
      Some(n) -> if n > 0 { n } else { hosted.cores },
      None -> hosted.cores,
    },
    backend: Some({
      name: b.name,
      fragment: b.fragment,
      entered: done.fold(0, |n: Int, i: Int, d: JobResult| n + d.usage.entries),
      units: b.units,
      load_nanos: b.load_nanos,
    }),
    results: c.outcomes.map(|outcome: conclude::Outcome<RuntimeDiagnostic>|
      outcome_of(analysis, done, outcome)),
    failures: c.failures.map(|failed: conclude::TestFailure<RuntimeDiagnostic>|
      failed_of(analysis, h, done, failed)),
    summary: {
      passed: c.passed,
      failed: c.failed,
      abandoned: c.abandoned,
      cached: cached_count(program, decided),
      duration_us: elapsed,
    },
    simulation: c.simulation,
    escapes: escapes_of(analysis, c, done),
    warnings: teardown.concat(c.notices.map(notice_of)).concat(said),
    mutants: None,
    coverage: if options.coverage { Some(coverage(analysis)) } else { None },
    spent: no_time_spent(),
  }
}

/// A green run's mutants, judged up to the budget; a red run's survivors would say nothing.
pub fn mutated(
  timed: TimedLoad,
  analysis: CheckedProgram,
  program: Program,
  report: RunReport,
  options: Options,
  search_options: SearchOptions,
  targeted: Option<List<DefInfo>>,
) -> RunReport / {entering::machine.open, entering::machine.enter, entering::machine.close, emit.unit, emit.compiled, abort.raise, shipped.report_reached} =
  match targeted {
    None -> report,
    Some(defs) -> if !green_run(report) { report } else {
      let queue = mutation_queue(timed.program.places, analysis, defs);
      let every = all_classes(program, options);
      let judged = range(0, min(options.mutate_budget, queue.mutants.len())).map(|id: Int|
        mutant_verdict(timed, analysis, program, queue, id, every, search_options));
      {
        ..report,
        mutants: Some(
          mutants(
            timed.program.places,
            analysis,
            queue,
            judged,
            queue.mutants.len() > options.mutate_budget,
          ),
        ),
      }
    },
  }

/// The tests that reach a mutant, in the classes every test the run reports on was coloured into: a
/// subset of a class shares nothing either. Every seed of the plan is owed, and nothing is filed.
fn mutant_verdict(
  timed: TimedLoad,
  analysis: CheckedProgram,
  program: Program,
  queue: Queue,
  id: Int,
  every: List<List<Int>>,
  search_options: SearchOptions,
) -> MutantVerdict / {entering::machine.open, entering::machine.enter, entering::machine.close, emit.unit, emit.compiled, abort.raise, shipped.report_reached} =
  match queue.mutants.at(id) {
    None ->
      { id: id, verdict: "unresolved", reason: "no mutant " ++ id.to_string() ++ " was queued" },
    Some(m) -> match mutant_unit(program.unit.testing, timed.program, analysis, m.mutation) {
      Err(j) -> { ..j, id: id },
      Ok(unit) -> {
        let classes = every.map(|class: List<Int>|
          class.filter(|i: Int| m.tests.contains(i))).filter(|class: List<Int>| class.len() > 0);
        let statuses = classes.flat_map(|class: List<Int>|
          run_class(class.map(|i: Int| job_of(program, unit, i, [], search_options.plan)), {
            ..search_options,
            measuring: false,
          }).map(|done: JobResult| done.status));
        tester::close_unit(unit);
        let expected = classes.fold(0, |n: Int, class: List<Int>| n + class.len());
        let judged = |verdict: String, why: String| { id: id, verdict: verdict, reason: why };
        if statuses.contains("failed") { judged("killed", "") }
        else if statuses.contains("panicked") {
          judged("unresolved", "Ply failed running the tests")
        } else if statuses.filter(|s: String| s == "passed").len() == expected {
          judged("survived", "")
        } else { judged("unresolved", "not every test answered") }
      },
    },
  }

/// What the store holds for each test, asked under the keys this program computes: the key its
/// result is filed under, and — for a seeded test whose plan is answered root by root — each
/// root's own. A run that bypasses the cache asks nothing and finds nothing.
/// Each test's case, and the keys whose passes answer it where one does: its own, or each root's.
type Selection = { cases: List<select::Case>, answering: List<List<Bytes>> }

/// `loaded` is what the run's load read of the shipped modules (`views.held_texts`); `options` the
/// run's, whose roots a pass's reads are read against, and `supplied` its configuration.
pub fn cases_of(
  rows: List<Row>,
  search: Search,
  bypassed: Bool,
  options: Options,
  supplied: machine::RunConfiguration,
  loaded: Map<Bytes, Bytes>,
) -> Selection / {result_cache.passes, entering::machine.changed_read, fs.list_dir[shipped], fs.read_file[shipped], abort.raise} = {
  let ask = |keys: List<Bytes>|
    if bypassed { keys.map(|k: Bytes| None) } else { result_cache.passes(keys) };
  let digest = digest_of(search);
  let keys = rows.map(|r: Row| key_of(r, digest));
  let filed = ask(
    keys.fold([], |acc: List<Bytes>, k: Option<Bytes>|
      match k { Some(key) -> acc.push(key), None -> acc }),
  );
  let rooted = rows.map(|r: Row|
    match r.hash {
      Some(h) -> if keyed_per_root(r, search) { Some(seed_keys(h, search.roots, [])) }
      else { None },
      None -> None,
    });
  let seeded = rooted.map(|ks: Option<List<Bytes>>|
    match ks { Some(xs) -> Some(ask(xs)), None -> None });
  let now = views::shipped_state_of(
    views::views_in(
      traces_of(
        seeded.fold(filed, |acc: List<Option<Bytes>>, o: Option<List<Option<Bytes>>>|
          match o { Some(xs) -> acc.concat(xs), None -> acc }),
      ),
    ),
    |m: Bytes| views::read_shipped_text(loaded, m),
  );
  let answers = filed.map(|held: Option<Bytes>| pass_status(now, held, options, supplied));
  // A keyed row's answer is the next one, in the order the keys were asked.
  let held = keys.fold(
    { at: 0, out: [] },
    |st: { at: Int, out: List<Option<StoredResult>> }, k: Option<Bytes>|
      match k {
        None -> { ..st, out: st.out.push(None) },
        Some(_) -> { at: st.at + 1, out: st.out.push(answers.at_or(st.at, None)) },
      },
  ).out;
  let owed = seeded.map(|o: Option<List<Option<Bytes>>>|
    match o {
      Some(xs) ->
        Some(
          pending_roots(
            search.roots,
            xs.map(|held: Option<Bytes>| pass_status(now, held, options, supplied)),
          ),
        ),
      None -> None,
    });
  {
    cases: range(0, rows.len()).map(|i: Int|
      select::case_of(
        rows.at_or(i, no_row()),
        keys.at_or(i, None),
        held.at_or(i, None),
        owed.at_or(i, None),
      )),
    answering: range(0, rows.len()).map(|i: Int|
      match ((keys.at_or(i, None), held.at_or(i, None))) {
        (Some(key), Some(Stands)) -> [key],
        (Some(_), None) -> match ((rooted.at_or(i, None), owed.at_or(i, None))) {
          (Some(ks), Some([])) -> ks,
          _ -> [],
        },
        _ -> [],
      }),
  }
}

pub fn traces_of(held: List<Option<Bytes>>) -> List<Bytes> =
  held.fold([], |acc: List<Bytes>, h: Option<Bytes>|
    match h { Some(trace) -> acc.push(trace), None -> acc })

/// What a filed pass says now: it stands while every read its trace holds answers as it did under
/// what `options` lend and the configuration `supplied`, and every view of a shipped module it
/// holds stands against `now`.
pub fn pass_status(
  now: views::ShippedState,
  held: Option<Bytes>,
  options: Options,
  supplied: machine::RunConfiguration,
) -> Option<StoredResult> / {entering::machine.changed_read, abort.raise} =
  match held {
    None -> None,
    Some(trace) -> if trace == b"" { Some(Stands) } else {
      let split = views::split(trace);
      match tester::stale_read(options, supplied, split.rest) {
        Some(what) -> Some(Moved(what)),
        None -> match views::stale_view(now, split.shipped_views) {
          None -> Some(Stands),
          Some(what) -> Some(Moved(what)),
        },
      }
    },
  }

fn no_row() -> Row =
  { index: 0, label: "", name: "", module: "", hash: None, seeded: false, nondet: false }

// --- What changed under each failure ------------------------------------------

/// Each failure as a report shows it, its suspects ranked by what changed in its test's closure
/// since the test last passed, and the diff of each change they name. A test that never passed, or
/// a run that bypassed the cache, has no baseline and so no changes. Read once the run is filed,
/// since a pass this run filed is a baseline for another test's failure.
pub fn diagnosed_all(
  bypassed: Bool,
  timed: TimedLoad,
  analysis: CheckedProgram,
  c: Conclusion<RuntimeDiagnostic>,
  failures: List<Failed>,
) -> { faults: List<Fault>, diffs: List<SuspectDiff> } / {result_cache.baselines, result_cache.texts, abort.raise} = {
  let records = if bypassed || failures.len() == 0 { failures.map(|f: Failed| None) } else {
    result_cache.baselines(c.failures.map(|f: conclude::TestFailure<RuntimeDiagnostic>| f.key))
  };
  if records.all(|r: Option<LastPass>| r == None) {
    { faults: failures.map(|f: Failed| fault_of(f, None)), diffs: [] }
  } else {
    let tree = suspects::program_of(timed.program, analysis);
    let sides = range(0, failures.len()).map(|i: Int|
      match ((failures.at(i), records.at(i))) {
        (Some(f), Some(Some(record))) -> Some(compared(tree, f.key, f.test_hash, record)),
        _ -> None,
      });
    let then = texts_then(
      sides.fold([], |acc: List<Compared>, x: Option<Compared>|
        match x { Some(c) -> acc.push(c), None -> acc }),
    );
    let deltas = sides.map(|x: Option<Compared>|
      match x { Some(c) -> Some(delta_of(tree, c, then)), None -> None });
    {
      faults: range(0, failures.len()).flat_map(|i: Int|
        match failures.at(i) { Some(f) -> [fault_of(f, deltas.at_or(i, None))], None -> [] }),
      diffs: suspect_diffs(
        tree,
        deltas.fold([], |acc: List<Delta>, d: Option<Delta>|
          match d { Some(x) -> acc.push(x), None -> acc }),
        then,
      ),
    }
  }
}

/// One failure as a report shows it, its suspects ranked by `delta`, what changed since its test
/// last passed.
pub fn fault_of(failed: Failed, delta: Option<Delta>) -> Fault =
  {
    key: failed.key,
    name: failed.name,
    diagnostic: failed.diagnostic,
    defect: failed.defect,
    suspects: suspects_of(failed.suspects, delta),
    unchanged: failed.unchanged,
    seed: failed.seed,
    race: failed.race,
    replay: match failed.seed { Some(seed) -> replay_of(seed, failed.name), None -> None },
    module: failed.module,
    test_hash: failed.test_hash,
    nondet: failed.nondet,
    status: failed.status,
    declared: failed.declared,
  }

/// The command that replays one interleaving of one test, spelled for a shell to read back as
/// these words; none for a name no shell word can carry.
pub fn replay_of(seed: String, name: String) -> Option<String> =
  shell_join(["ply", "test", "--seed", seed, "--filter", name])

/// Files what a later failure reads of the passes `filing` holds, run over `analysis` and
/// `sources`, whose modules hashed as `modules`: the era they passed in, and the text of each test
/// that passed and each definition it reached, where the store holds none.
pub fn store_history(
  analysis: CheckedProgram,
  sources: List<Source>,
  modules: List<ModuleHashes>,
  filing: conclude::Filing,
) -> Unit / {result_cache.unstored, result_cache.history, abort.raise} =
  if filing.records.len() == 0 { () } else {
    let unfiled = result_cache.unstored(
      filing.reached.fns.concat(filing.reached.decls).concat(
        filing.records.map(|e: { key: Bytes, record: conclude::PassRecord }| e.record.test),
      ),
    );
    result_cache.history(
      if unfiled.len() == 0 { [] } else { texts_of(analysis, sources, unfiled) },
      modules,
    )
  }

// --- Tests ------------------------------------------------------------------

test "a replay is one command whatever the test is called" {
  assert_eq(
    replay_of("0:1", "it's \"$HOME\" `now`"),
    Some("ply test --seed 0:1 --filter 'it'\\''s \"$HOME\" `now`'"),
  );
  assert_eq(replay_of("0:1", "plain"), Some("ply test --seed 0:1 --filter plain"));
  assert_eq(replay_of("0:1", "a\0b"), None)
}

// --- What a search's cost reads as --------------------------------------------

test "a bounded count renders as a lower bound, and a reduction needs the naive search" {
  assert_eq(
    cost_of(Some({ explored: 4096, bounded: true })),
    Some({ explored: 4096, bounded: true, rendered: ">= 4096" }),
  );
  assert_eq(cost_of(None), None);
  let e: Exploration = {
    explored: 12,
    exhaustive: true,
    exhausted: false,
    naive: None,
    blind: None,
    steps: 8,
    virtual_time: 0,
    failure: None,
    race: None,
  };
  assert_eq(tenths_of(e), None);
  assert_eq(tenths_of({ ..e, naive: Some({ explored: 120, bounded: false }) }), Some(100));
  // Rounded half up to a tenth: 40 / 12 is 3.33.
  assert_eq(tenths_of({ ..e, naive: Some({ explored: 40, bounded: false }) }), Some(33));
  assert_eq(tenths_of({ ..e, explored: 0, naive: Some({ explored: 40, bounded: false }) }), None);
  assert_eq(
    explored_of({ ..e, failure: Some({ root: 7u64, path: [1, 0] }) }).failing_seed,
    Some("7:1.0"),
  )
}

// --- What a run files ---------------------------------------------------------

/// The package `p` that `files` hold, loaded as a run loads it: each module's hashing, the program
/// whole, and its sources in the order the analysis numbers them.
fn loaded_from(
  files: List<{ path: String, body: Bytes }>,
) -> { modules: List<ModuleHashes>, whole: CheckedProgram, sources: List<Source> } / {abort.raise} = {
  let tree = fs::mem_of(files);
  let listed = Bytes::concat_all(
    queries().map(
      |q: { name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {QueryEffects, abort.raise} }|
        Bytes::concat_all([q.definition, b" ", hex(blake3(q.definition)), b"\n"]),
    ),
  );
  handle {
    match read_packages[t]("p") {
      Err(_) -> panic("the program is read"),
      Ok(p) -> match analyse_in_memory(p.own.files, Map::new()).out {
        Analysed(w) -> {
          let whole = checked_program_of(w);
          let texts = files.fold(
            Map::new(),
            |m: Map<Bytes, Bytes>, f: { path: String, body: Bytes }|
              m.insert(Bytes::of_string(f.path.slice(2, f.path.len() - 4)), f.body),
          );
          {
            modules: deriving_nothing(|| fresh_check_results[t](p)).modules,
            whole: whole,
            sources: whole.frame.outlines.map(|o: Outline|
              { name: o.name, src: texts.get(o.name).unwrap_or(b"") }),
          }
        },
        _ -> panic("the program checks"),
      },
    }
  } with {
    fs.list_dir[t](path) -> fs::mem_list(tree, path),
    fs.kind[t](path) -> fs::mem_kind(tree, path),
    fs.read_file[t](path) -> fs::mem_read(tree, path),
    shipped.names() -> ["std.prelude"],
    shipped.module(name) -> if name == "std.prelude" { Some(prelude_source::text()) } else { None },
    shipped.report_reached(view, pulled) -> (),
    shipped.read_pack(path, offset, len) -> None,
    shipped.definitions() -> listed,
    shipped.stamps() -> "",
    shipped.runtime() -> panic("the program names no library deriver"),
  }
}

/// Every test of `program` passing, concluded and filed as a run files it, into the store at `cache`
/// under `mem`.
fn store_passing(
  program: { modules: List<ModuleHashes>, whole: CheckedProgram, sources: List<Source> },
) -> Unit / {fs.read[mem], fs.write[mem], abort.raise} = {
  let view = program.whole;
  let tests = range(0, view.checked.tests.len()).fold([], |acc: List<conclude::Test>, i: Int|
    match test_at(view, i) {
      Some(t) ->
        acc.push({
          index: i,
          key: t.key,
          seeded: false,
          hash: test_hash_at(view, i),
          of: t.key,
          case: false,
        }),
      None -> acc,
    });
  let ran: List<conclude::TestResult<RuntimeDiagnostic>> = tests.map(|t: conclude::Test|
    {
      index: t.index,
      status: "passed",
      failure: None,
      host: false,
      trace: Some(b""),
      searched: None,
      seeds: 0,
    });
  let c = conclude::conclude_run(
    tests,
    hashes_of(view, results::snapshot_digest_of(program.modules)),
    {
      groups: [tests.map(|t: conclude::Test| t.index)],
      filed: tests.fold(Map::new(), |acc: Map<Int, List<Bytes>>, t: conclude::Test|
        match t.hash { Some(h) -> acc.insert(t.index, [h]), None -> acc }),
      codes: Map::new(),
      reasons: Map::new(),
      out_of_scope: [],
    },
    Map::new(),
    ran,
  );
  handle {
    store_history(view, program.sources, program.modules, c.filing)
  } with {
    var store = tables::open_cache[mem]("cache", { runtime: "runtime", code: "code" }),
    result_cache.unstored(hashes) -> results::unstored_in(store, hashes),
    result_cache.history(texts, modules) -> {
      store = results::store_pass(store, texts, modules);
    },
    return u -> {
      let _flushed = tables::flush_cache[mem](results::put_filing[mem, mem](store, c.filing));
      u
    },
  }
}

test "a test's outcome as its group finishes carries what it raised" {
  let view = loaded_from([{ path: "p/m.ply", body: b"test \"red\" { assert_eq(1, 2) }\n" }]).whole;
  let raised = { diag: diag_of("error", "E0501", "assertion failed", [], []), values: [] };
  let failed = {
    test: 0,
    status: "failed",
    failure: Some(raised),
    usage: no_usage(),
    trace: None,
    searched: None,
  };
  assert_eq(job_outcome(view, failed).diagnostic, Some(raised))
}

test "a run after one definition is edited files its module's record and the texts the edit moved, and nothing else" {
  let program = |body: Bytes|
    loaded_from([
      { path: "p/low.ply", body: b"pub fn twice(n: Int) -> Int = n * 2\n" },
      {
        path: "p/app.ply",
        body: Bytes::concat_all([
          b"import low\nfn base(n: Int) -> Int = ",
          body,
          b"\nfn top(n: Int) -> Int = base(n) + low::twice(n)\ntest \"tops\" { assert(top(1) > 0) }\n",
        ]),
      },
    ]);
  let before = program(b"n + 1");
  let after = program(b"n + 2");
  let counted = run_in_memory(mem_empty(), || {
    let held = ||
      tables::counts(tables::open_cache[mem]("cache", { runtime: "runtime", code: "code" }));
    store_passing(before);
    let first = held();
    store_passing(after);
    { first: first, second: held() }
  }).value;
  // The first run files a record of every module, the shipped ones it pulled among them, and texts.
  assert_eq(counted.first.modules, before.modules.len());
  assert_eq(counted.first.eras, 1);
  assert(counted.first.texts > 0);
  // The second files the one module whose hashes moved, its era, and the texts of `base`, `top`
  // and the test, whose hashes the edit moved; the rest is held.
  assert_eq(counted.second.modules - counted.first.modules, 1);
  assert_eq(counted.second.eras - counted.first.eras, 1);
  assert_eq(counted.second.texts - counted.first.texts, 3)
}
