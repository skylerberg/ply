import std.env (env)
import std.fs (fs)
import std.machine as entering
import configuration
import compiler.unit (shipped)
import passes (PassContext, still_holding, configured_digest)
import tester (Options, grants_of)
import testing.reads (RecordedRead)

pub fn passes_holding(
  options: Options,
  stored: Map<Bytes, List<RecordedRead>>,
) -> Map<Bytes, List<RecordedRead>> / {entering::machine.hosting, env.variables, env.working_directory, fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.read_file[cwd], fs.read_file[abs], fs.read[abs], fs.read_file[shipped], shipped.names, abort.raise} =
  if stored.fold(true, |untraced: Bool, _: Bytes, reads: List<RecordedRead>|
      untraced && reads.len() == 0) { stored } else {
    match context_of(options) {
      Some(context) -> still_holding(context, stored),
      None ->
        stored.fold(Map::new(), |held: Map<Bytes, List<RecordedRead>>, key: Bytes, reads: List<RecordedRead>|
          if reads.len() == 0 { held.insert(key, reads) } else { held }),
    }
  }

fn context_of(
  options: Options,
) -> Option<PassContext> / {entering::machine.hosting, env.variables, env.working_directory, fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match configuration::resolve_configuration(
      { ..options.machine.config, schema: None },
      |name: String| Err([]),
    ) {
    Err(_) -> None,
    Ok(resolution) -> {
      let supplied = configuration::run_configuration(resolution.configuration);
      let hosting = entering::machine.hosting(grants_of(options.machine, supplied));
      Some({
        roots: hosting.roots.map(|r: entering::NamedPath|
          { name: Bytes::of_string(r.name), directory: Bytes::of_string(r.path) }),
        configuration: supplied.values.filter(
          |v: { key: String, value: String, secret: Bool }| !v.secret,
        ).map(|v: { key: String, value: String, secret: Bool }|
          {
            key: Bytes::of_string(v.key),
            digest: configured_digest(Some(Bytes::of_string(v.value))),
          }),
        binding: Bytes::of_string(hosting.binding),
        program: Bytes::of_string(hosting.program),
      })
    },
  }
