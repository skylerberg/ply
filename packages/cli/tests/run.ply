pub type TestReading = { listing: ProgramListing, results: ModuleResults, checks_later: Bool }

pub type Iteration = {
  result: CommandOutput,
  opened: Option<Session<TestReading>>,
  embeds: List<Embed>,
}

pub fn run(
  flags: Flags,
  options: Options,
) -> CommandOutput / {semantics.cached, shipped.read_pack, process.out[proc], process.err[proc], builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, MachineAccess, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variable, env.working_directory, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.code, emit.compiled, emit.libraries, cost_checker.report, evaluation.verdicts, evaluation.statements, Derives, abort.raise, diverges, toolchain.reuse_dir} =
  run_once(flags, options, None).result

fn test_reading(
  flags: Flags,
  modules: Modules,
  read: ProgramSummary,
) -> TestReading / {memo.read, abort.raise} = {
  let results = listed_results(modules.own);
  {
    listing: view::listing_from(modules, results.results, results.modules),
    results: results,
    checks_later: read.checked_later || flags.no_cache,
  }
}

pub fn run_once(
  flags: Flags,
  options: Options,
  before: Option<Session<TestReading>>,
) -> Iteration / {semantics.cached, shipped.read_pack, process.out[proc], process.err[proc], builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, MachineAccess, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variable, env.working_directory, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.code, emit.compiled, emit.libraries, cost_checker.report, evaluation.verdicts, evaluation.statements, Derives, abort.raise, diverges, toolchain.reuse_dir} = {
  let s: Style = style_of(flags);
  let begun = time.elapsed_us();
  process.err[proc](indent() ++ "checking the program");
  let started = time.elapsed_ms();
  let project = load_resolved(flags.paths);
  let reused = match before {
    Some(t) -> if unchanged(project, t.project, embeds_of(t, t.value.listing.embeds)) { Some(t) }
    else { None },
    None -> None,
  };
  let opened = match reused {
    Some(t) -> Ok({ ..t, phases: { read_ms: 0, front_end_ms: 0, store_ms: 0 } }),
    None ->
      session_over(
        flags.paths,
        project,
        started,
        flags.verify_dependencies,
        flags.no_cache,
        |modules: Modules, read: ProgramSummary| test_reading(flags, modules, read),
      ),
  };
  match opened {
    Err(r) ->
      {
        result: with_front_end(
          rejected(s, "test", r.diagnostics, r.places),
          reuse_members(r.tallies, r.missing_results),
        ),
        opened: None,
        embeds: [],
      },
    Ok(t) -> tests_of_session(flags, options, s, t, begun),
  }
}

fn tests_of_session(
  flags: Flags,
  options: Options,
  s: Style,
  t: Session<TestReading>,
  begun: Int,
) -> Iteration / {semantics.cached, process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, MachineAccess, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variable, env.working_directory, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.code, emit.compiled, emit.libraries, cost_checker.report, shipped.read_pack, toolchain.reuse_dir, Derives, abort.raise, evaluation.verdicts, evaluation.statements} = {
  let embeds = embeds_of(t, t.value.listing.embeds);
  let places = places_of(t);
  match config_schema::schema_error(
      t.value.listing.checked.definitions,
      options.machine.config.schema,
    ) {
    Some(d) ->
      { result: unbound(s, { diagnostics: [d], places: places }), opened: None, embeds: embeds },
    None ->
      { result: tests_over(flags, s, options, t, places, begun), opened: Some(t), embeds: embeds },
  }
}

pub fn file_stamps(
  rs: List<paths::ResolvedPath>,
) -> Option<List<String>> / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], abort.raise, diverges} = {
  let found = walk::walk_paths_for_load(rs);
  if found.errors.len() > 0 { None } else {
    Some(
      found.files.fold([], |accumulator: List<String>, shown: String, rooted: paths::RootedPath|
        accumulator.push(
          shown ++ " " ++ stamp_part(paths::modified_ms(rooted)) ++ " "
            ++ stamp_part(paths::file_size(rooted)),
        )),
    )
  }
}

fn stamp_part(n: Option<Int>) -> String = match n { Some(x) -> x.to_string(), None -> "-" }

fn root_of(rs: List<paths::ResolvedPath>) -> String =
  match rs.at(0) { None -> ".", Some(r) -> r.machine }

pub fn rows_of(analysis: ProgramListing) -> List<Row> =
  range(0, analysis.checked.tests.len()).fold([], |accumulator: List<Row>, i: Int|
    match test_at(analysis, i) {
      None -> accumulator,
      Some(t) ->
        accumulator.push({
          index: i,
          label: String::of_bytes_lossy(t.name),
          name: String::of_bytes_lossy(t.key),
          module: String::of_bytes_lossy(t.module),
          hash: test_hash_at(analysis, i),
          seeded: uses_simulation(t.effects),
          nondet: t.nondet,
        }),
    })

fn is_write_mode(m: type_syntax::Mode) -> Bool = match m { WriteMode -> true, _ -> false }

pub fn declared_effects(analysis: ProgramListing) -> Map<Bytes, Bool> =
  prelude_effects().concat(analysis.checked.effects).fold(
    Map::new(),
    |accumulator: Map<Bytes, Bool>, e: EffectInfo| accumulator.insert(e.name, e.nondet),
  )

pub fn case_view(
  analysis: ProgramListing,
  declared: Map<Bytes, Bool>,
  i: Int,
  test_info: TestInfo,
) -> Case / {abort.raise} = {
  let effects = canonical(test_info.effects);
  let texts = effect_texts(effects);
  {
    index: i,
    entry: entry_of(i, test_info.key),
    key: String::of_bytes_lossy(test_info.key),
    name: String::of_bytes_lossy(test_info.name),
    module: String::of_bytes_lossy(test_info.module),
    nondet: test_info.nondet,
    hash: hash_at(analysis, i),
    effects: outside_effects_text(effects),
    listed: range(0, effects.len()).map(|j: Int|
      match effects.at(j) {
        Some(a) ->
          {
            entry: {
              effect: String::of_bytes_lossy(a.effect),
              resource: String::of_bytes_lossy(types::resource_text(a.resource)),
              writes: is_write_mode(a.mode),
              nondet: match declared.get(a.effect) { Some(known) -> known, None -> true },
            },
            text: texts.at_or(j, ""),
          },
        None -> { entry: { effect: "", resource: "", writes: false, nondet: false }, text: "" },
      }),
    seeded: uses_simulation(test_info.effects),
  }
}

fn named_modules(paths: List<paths::ResolvedPath>, files: List<File>) -> Option<List<String>> =
  if paths.all(|r: paths::ResolvedPath| r.inside == ".") { None } else {
    Some(
      files.filter(|f: File|
        paths.fold(false, |hit: Bool, r: paths::ResolvedPath|
          hit || paths::includes(r, f.path))).map(|f: File| f.module),
    )
  }

fn program_of(
  options: Options,
  t: Session<TestReading>,
  places: List<SourceText>,
  analysis: ProgramListing,
  entries: List<Entry>,
  root: String,
  scope: Scope,
  opened: List<Diagnostic>,
  recorded_under: Option<String>,
  unit: TestUnit,
  loaded_from_cache: Bool,
) -> Program / {abort.raise} = {
  let declared = declared_effects(analysis);
  let cases = scope.visible.fold([], |accumulator: List<Case>, i: Int|
    match test_at(analysis, i) {
      Some(test_info) -> {
        let view = case_view(analysis, declared, i, test_info);
        accumulator.push({ ..view, entry: entries.at_or(i, view.entry) })
      },
      None -> accumulator,
    });
  {
    root: root,
    cache_stamp: recorded_under,
    unit: unit,
    files: places.map(|place: SourceText| place.path),
    places: places,
    modules: modules_of(places, analysis.outlines).map(|m: { name: String, path: String }|
      { name: m.name, file: m.path }),
    loaded_from_cache: loaded_from_cache,
    reused_members: reuse_members(t.tallies, t.missing_results),
    phases: {
      read_us: t.phases.read_ms * 1000,
      front_end_us: t.phases.front_end_ms * 1000,
      write_back_us: t.phases.store_ms * 1000,
    },
    declared: scope.visible.len() + scope.filtered_out,
    cases: cases,
    positions: placed_cases(cases),
    filtered_out: scope.filtered_out,
    warnings: opened.concat(t.warnings),
    options: object([]),
  }
}

type CodeLoad = { timed: TimedLoad, view: CheckedProgram }

fn code_load(
  t: Session<TestReading>,
  no_cache: Bool,
) -> CodeLoad / {shipped.read_pack, toolchain.reuse_dir, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[abs], fs.write[abs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], entropy.next, time.now_ms, Derives, abort.raise} = {
  let timed = timed_of(t, t.value.results, false, no_cache);
  match program_view(timed.program) {
    Some(view) -> { timed: timed, view: view },
    None -> panic("a program that checked did not load for code generation"),
  }
}

fn tests_over(
  flags: Flags,
  style: Style,
  options: Options,
  t: Session<TestReading>,
  places: List<SourceText>,
  begun: Int,
) -> CommandOutput / {semantics.cached, process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, MachineAccess, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variable, env.working_directory, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.code, emit.compiled, emit.libraries, cost_checker.report, evaluation.verdicts, evaluation.statements, shipped.read_pack, toolchain.reuse_dir, Derives, abort.raise} = {
  let loaded_at = time.elapsed_us();
  let broken = if !t.value.checks_later { [] } else {
    let timed = timed_of(t, t.value.results, false, flags.no_cache);
    match timed.program.frame {
      None -> timed.program.diagnostics,
      Some(frame) -> {
        let unkept = reuse_violations(timed.program, frame);
        if unkept.len() > 0 { unkept } else { evaluation_errors(timed, frame) }
      },
    }
  };
  let promised_at = time.elapsed_us();
  let spent = { ..no_time_spent(), before_us: begun, promises_us: promised_at - loaded_at };
  if broken.len() > 0 { rejected(style, "test", broken, places) }
  else { selected(flags, style, options, t, places, spent) }
}

fn selected(
  flags: Flags,
  style: Style,
  options: Options,
  t: Session<TestReading>,
  places: List<SourceText>,
  spent: TimeSpent,
) -> CommandOutput / {semantics.cached, process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, MachineAccess, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variable, env.working_directory, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.code, emit.compiled, emit.libraries, shipped.read_pack, toolchain.reuse_dir, Derives, abort.raise} = {
  let analysis = t.value.listing;
  let configuring = time.elapsed_us();
  let testing = tester::start_run(options);
  results::with_result_cache(results::store_for(flags.paths, flags.no_cache), || {
    let opened = if flags.no_cache { [] } else { result_cache.open_warnings() };
    let cased = over_cases(analysis, flags.filters, named_modules(flags.paths, t.project.files));
    let hashed = if cased.len() == 0 { Map::new() } else { hashed_by_kind(analysis) };
    let listing_requests = cased.map(|i: Int|
      { test: i, hash: listing_hash(analysis, places, hashed, i) });
    let place = listings_at(flags.paths);
    let stamp = Bytes::of_string(shipped_stamps().runtime_digest);
    let cached_listings = if flags.no_cache { Map::new() } else if place.label == "cwd" {
      case_listings::cached_listings[cwd](place.dir, stamp, listing_requests)
    } else { case_listings::cached_listings[abs](place.dir, stamp, listing_requests) };
    let unkept = listing_requests.filter(|a: case_listings::ListingRequest|
      !cached_listings.contains(a.test));
    let to_list = unkept.map(|a: case_listings::ListingRequest| a.test);
    let handoff_start = time.elapsed_us();
    let schema = options.machine.config.schema != None;
    let built = if schema || to_list.len() > 0 { Some(code_load(t, flags.no_cache)) } else { None };
    let lister = match built {
      Some(c) -> if to_list.len() == 0 { None } else { Some(code_program(c.timed, c.view)) },
      None -> None,
    };
    let listing = time.elapsed_us();
    if to_list.len() > 0 { process.err[proc](indent() ++ "listing the test cases") };
    match list_cases(testing, lister, to_list) {
      Err(diagnostics) -> unbound(style, { diagnostics: diagnostics, places: places }),
      Ok(found) -> {
        if flags.no_cache { () } else if place.label == "cwd" {
          case_listings::cache_listings[cwd](place.dir, stamp, unkept, found)
        } else { case_listings::cache_listings[abs](place.dir, stamp, unkept, found) };
        let cases = cached_listings.fold(
          found,
          |accumulator: Map<Int, Result<List<ListedCase>, ListingFailure>>, i: Int, listed: List<ListedCase>|
            accumulator.insert(i, Ok(listed)),
        );
        decided_run(
          flags,
          style,
          testing,
          t,
          places,
          expand_cases(analysis, cases),
          opened,
          { ..spent, store_us: handoff_start - configuring, handoff_us: listing - handoff_start },
          listing,
        )
      },
    }
  })
}

fn hashed_by_kind(analysis: ProgramListing) -> Map<Bytes, Bytes> =
  analysis.hashes.declarations.fold(
    analysis.hashes.definitions.fold(
      Map::new(),
      |accumulator: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }|
        accumulator.insert(b"fn ".concat(d.name), d.hash),
    ),
    |accumulator: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }|
      accumulator.insert(b"decl ".concat(d.name), d.hash),
  )

fn listing_hash(
  analysis: ProgramListing,
  places: List<SourceText>,
  hashed: Map<Bytes, Bytes>,
  i: Int,
) -> Bytes / {abort.raise} =
  match test_at(analysis, i) {
    None -> b"",
    Some(t) -> {
      let text = match places.at(t.at.module) {
        Some(place) -> if t.at.span.end <= place.text.len() && t.at.span.start <= t.at.span.end {
          place.text.slice(t.at.span.start, t.at.span.end)
        } else { b"" },
        None -> b"",
      };
      let r = analysis.hashes.refs;
      blake3(
        Bytes::concat_all(
          List::fold(
            match analysis.hashes.test_refs.get(t.key) { Some(xs) -> xs, None -> [] },
            [text],
            |accumulator: List<Bytes>, v: Int| {
              let key = Bytes::concat(
                if r.is_declaration.get(v) { b"decl " } else { b"fn " },
                r.names.get(v),
              );
              accumulator.push(key).push(match hashed.get(key) { Some(h) -> h, None -> b"" })
            },
          ),
        ),
      )
    },
  }

fn listings_at(paths: List<paths::ResolvedPath>) -> { label: String, dir: String } =
  match paths.at(0) {
    Some(r) -> { label: r.label, dir: paths::in_root(r, ".ply-cache/listings").path },
    None -> { label: "cwd", dir: ".ply-cache/listings" },
  }

fn decided_run(
  flags: Flags,
  style: Style,
  testing: TestRun,
  t: Session<TestReading>,
  places: List<SourceText>,
  over: ExpandedTests,
  opened: List<Diagnostic>,
  spent: TimeSpent,
  listing: Int,
) -> CommandOutput / {semantics.cached, process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.read_file[cwd], fs.read_file[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, env.working_directory, env.variables, MachineAccess, result_cache.open_warnings, result_cache.passes, result_cache.code_passes, result_cache.known, result_cache.baselines, result_cache.texts, result_cache.unstored, result_cache.history, result_cache.store_filing, emit.unit, emit.code, emit.compiled, emit.libraries, shipped.read_pack, toolchain.reuse_dir, entropy.next, time.now_ms, fs.read[abs], fs.list_dir[abs], fs.write[abs], fs.read[cwd], fs.list_dir[cwd], fs.write[cwd], fs.kind[cwd], fs.kind[abs], Derives, abort.raise} = {
  let options = testing.options;
  let analysis = over.analysis;
  let selecting = time.elapsed_us();
  let scope = scope_of(
    analysis,
    flags.filters,
    options.shard,
    named_modules(flags.paths, t.project.files),
  );
  let recorded_under = if flags.no_cache { None } else { Some(shipped_stamps().runtime_digest) };
  let p = program_of(
    options,
    t,
    places,
    analysis,
    over.entries,
    root_of(flags.paths),
    scope,
    opened,
    recorded_under,
    tester::empty_test_unit(testing),
    !flags.no_cache,
  );
  let searching = machine::sim_plan_of(options.sim);
  let search = search_of(searching);
  let shipped_texts = Map::new();
  let reckoned = cases_of(rows_of(analysis), search, flags.no_cache, shipped_texts);
  let first = decide(reckoned.cases);
  let building = time.elapsed_us();
  let visible = set_of(scope.visible);
  let running = to_run(first).filter(|i: Int| visible.contains(i));
  let schema = options.machine.config.schema != None;
  let runs_code = schema || running.len() > 0;
  let code = if !runs_code {
    { front: no_loaded_analysis(), place: { project: t.project, store: None } }
  } else {
    let c = code_load(t, flags.no_cache);
    code_program(c.timed, c.view)
  };
  let unit_at = time.elapsed_us();
  if runs_code { process.err[proc](indent() ++ "building the tests") };
  let emitted = run_unit(code, running, schema);
  match emitted {
    Err(diagnostics) -> unbound(style, { diagnostics: diagnostics, places: p.places }),
    Ok(unit) -> {
      let keyed = match unit {
        Some(e) -> if flags.no_cache { Map::new() }
        else { code_keys(first, codes_of(code.front, e, over.entries), search) },
        None -> Map::new(),
      };
      let returned = by_code(first, passed_by_code(first, keyed, shipped_texts), search);
      let decisions = returned.decisions;
      let classes = classes_of(p, to_run(decisions).filter(|i: Int| visible.contains(i)));
      let decided = run_decision_of(
        p,
        decisions,
        search,
        sim_json(searching, options.sim),
        classes.map(|class: List<Int>| group_of_class(analysis, class)),
        classes,
      );
      let build = decided.runs.len() > 0 || options.machine.config.schema != None;
      let to_compile = match unit { Some(e) -> if build { Some(e) } else { None }, None -> None };
      match to_compile {
        Some(_) -> process.err[proc](indent() ++ "compiling the tests"),
        None -> (),
      };
      let made = match units::library_of(to_compile, options.machine.profile) {
        Err(diagnostics) -> Err(diagnostics),
        Ok(library) -> tester::unit_of(testing, code.front, library, true),
      };
      match made {
        Err(diagnostics) -> unbound(style, { diagnostics: diagnostics, places: p.places }),
        Ok(made_unit) -> {
          let binding = time.elapsed_us();
          let rejected = |diagnostics: List<Diagnostic>| {
            tester::close_unit(made_unit);
            unbound(style, { diagnostics: diagnostics, places: p.places })
          };
          match configuration::resolve_configuration(options.machine.config, |name: String|
              schema_of(made_unit, name)) {
            Err(diagnostics) -> rejected(diagnostics),
            Ok(r) -> match if !runs_code { Ok(testing) } else {
                tester::bind_test_run(
                  testing,
                  code.front.dump,
                  configuration::run_configuration(r.configuration),
                )
              } {
              Err(diagnostics) -> rejected(diagnostics),
              Ok(bound_testing) -> {
                let bound = time.elapsed_us();
                let result = concluded_run(
                  flags,
                  style,
                  options,
                  { ..p, unit: { ..made_unit, testing: bound_testing } },
                  t.value.listing.modules,
                  analysis,
                  over.run_analysis,
                  scope,
                  decisions,
                  decided,
                  keyed,
                  returned.written_passes.concat(reckoned.rolled),
                  searching,
                  r.warnings,
                  {
                    ..spent,
                    selection_us: building - selecting,
                    handoff_us: spent.handoff_us + unit_at - building,
                    unit_us: selecting - listing + binding - unit_at,
                    bind_us: bound - binding,
                  },
                );
                tester::close_unit(made_unit);
                result
              },
            },
          }
        },
      }
    },
  }
}

fn schema_of(
  unit: TestUnit,
  name: String,
) -> Result<Value, List<Diagnostic>> / {entering::machine.enter, abort.raise} =
  match unit.opened {
    Some(o) -> configuration::evaluate_schema_on_unit(o.unit, unit.roots, name),
    None ->
      Err([shown(machine::internal_error(name, "was requested, but the run compiled no program"))]),
  }

test "`file_stamps` returns one line for each `.ply` file in a tree, and nothing when the walk fails" {
  let tree = mem_of([
    { path: "m.ply", body: b"fn m() -> Int = 1" },
    { path: "notes.txt", body: b"x" },
    { path: "sub/deep.ply", body: b"fn d() -> Int = 2" },
  ]);
  let walked = |rs: List<paths::ResolvedPath>|
    handle {
      file_stamps(rs)
    } with {
      fs.kind[cwd](p) -> mem_kind(tree, p),
      fs.kind[abs](p) -> panic("nothing here leaves the working directory"),
      fs.list_dir[cwd](p) -> mem_list(tree, p),
      fs.list_dir[abs](p) -> panic("nothing here leaves the working directory"),
      fs.read_file[cwd](p) -> mem_read(tree, p),
      fs.read_file[abs](p) -> panic("nothing here leaves the working directory"),
      fs.modified_ms[cwd](p) -> mem_modified(tree, p),
      fs.modified_ms[abs](p) -> panic("nothing here leaves the working directory"),
      fs.file_size[cwd](p) -> mem_size(tree, p),
      fs.file_size[abs](p) -> panic("nothing here leaves the working directory"),
    };
  match walked([paths::here()]) {
    Some(lines) -> {
      assert_eq(lines.len(), 2);
      assert(lines.at_or(0, "").starts_with("m.ply "));
      assert(lines.at_or(0, "").ends_with(" 17"));
      assert(lines.at_or(1, "").starts_with("sub/deep.ply "))
    },
    None -> panic("a readable tree stamps"),
  };
  assert_eq(walked([paths::at_cwd("gone")]), None)
}
