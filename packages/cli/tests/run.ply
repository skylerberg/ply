// --- The load ---------------------------------------------------------------

/// One report, the load a watching run's next report may reuse, and what that load embedded, which
/// a watching run reads again whether or not the load held.
pub type Iteration = { result: CommandOutput, held: Option<TimedLoad>, embeds: List<Embed> }

pub fn run(
  flags: Flags,
  options: Options,
  argv: Option<List<String>>,
) -> CommandOutput / {semantics.cached, shipped.read_pack, process.out[proc], builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, MachineAccess, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variable, env.working_directory, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.compiled, cost_checker.report, evaluation.verdicts, evaluation.statements, Derives, abort.raise, diverges, shipped.report_reached, toolchain.reuse_dir} =
  run_once(flags, options, None, argv).result

/// A save that changed no file's text is the last report's load again, with nothing re-derived.
fn load_or_reuse(
  flags: Flags,
  options: Options,
  held: Option<TimedLoad>,
  project: Project,
  started: Int,
) -> TimedLoad / {shipped.read_pack, toolchain.reuse_dir, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], entropy.next, time.now_ms, Derives, abort.raise, shipped.report_reached} = {
  let reused = match held {
    Some(t) -> if unchanged(project, t.program) { Some(t) } else { None },
    None -> None,
  };
  match reused {
    Some(t) -> { ..t, read_ms: 0, front_end_ms: 0, store_ms: 0 },
    None -> if flags.no_cache {
      timed_uncached_over(flags.paths, project, started, flags.verify_deps)
    } else { timed_over(flags.paths, project, started, flags.verify_deps) },
  }
}

/// One report over the tree as it is now; `held` is the load the last one ran against. `argv`, where
/// it is given, is the command line a run that ran nothing keeps its answer under for the next.
pub fn run_once(
  flags: Flags,
  options: Options,
  held: Option<TimedLoad>,
  argv: Option<List<String>>,
) -> Iteration / {semantics.cached, shipped.read_pack, process.out[proc], builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, MachineAccess, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variable, env.working_directory, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.compiled, cost_checker.report, evaluation.verdicts, evaluation.statements, Derives, abort.raise, diverges, shipped.report_reached, toolchain.reuse_dir} = {
  let s: Style = style_of(flags);
  let begun = time.elapsed_us();
  let started = time.elapsed_ms();
  let project = load_resolved(flags.paths);
  let key = match argv {
    Some(line) -> if held == None && caches_output(flags, options) {
      Some(command_key(module_queries::program_digest(), encoded_command_line(line, flags.paths)))
    } else { None },
    None -> None,
  };
  let taken = match key {
    Some(k) -> cached_output(flags, options, k, project, begun),
    None -> None,
  };
  match taken {
    Some(answer) -> { result: answer, held: None, embeds: [] },
    None -> {
      let t: TimedLoad = load_or_reuse(flags, options, held, project, started);
      over_load(flags, options, s, t, begun, match key {
        Some(k) -> Some({ key: k, project: project, passes: [], after: false }),
        None -> None,
      })
    },
  }
}

/// A run whose answer the next may take: one that consults the store, answers once and as a plain
/// run does, and reads no configuration file the key does not cover.
fn caches_output(flags: Flags, options: Options) -> Bool =
  !flags.no_cache && !flags.watch && !flags.explain && !options.coverage && options.mutate == None
    && options.machine.config.files.len() == 0
    && options.machine.config.schema == None

/// The keys of the passes that answer each test in scope.
fn pass_keys_in_scope(answering: List<List<Bytes>>, scope: Scope) -> List<Bytes> =
  scope.visible.fold([], |acc: List<Bytes>, i: Int|
    acc.concat(match answering.at(i) { Some(ks) -> ks, None -> [] }))

/// The answer a run kept under `key`, where it answers this one: every place its load looked at
/// holds what it held, and every pass it took still stands. It prints what that run printed before
/// its answer.
fn cached_output(
  flags: Flags,
  options: Options,
  key: Bytes,
  project: Project,
  begun: Int,
) -> Option<CommandOutput> / {semantics.cached, shipped.read_pack, toolchain.reuse_dir, time.elapsed_us, process.out[proc], fs.list_dir[shipped], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], entering::machine.changed_read, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variable, env.variables, env.working_directory, Derives, abort.raise} = {
  let supplied = configuration::supplied(options.machine.config);
  match match cached_command(flags.paths, project, key) {
      Some(b) -> match bin::decode(b, cached_output_bin()) { Ok(k) -> Some(k), Err(_) -> None },
      None -> None,
    } {
    None -> None,
    Some(k) -> {
      let importing = imported_reader();
      let stands = results::with_result_cache(results::store_for(flags.paths, false), || {
        let held = result_cache.passes(k.passes);
        let now = views::shipped_state_of(views::views_in(traces_of(held)), |m: Bytes|
          shipped_imported(importing, m));
        held.fold(true, |all: Bool, h: Option<Bytes>|
          all && h != None && pass_status(now, h, options, supplied) == Some(Stands))
      });
      match if stands { Some(parse_string(k.json)) } else { None } {
        None -> None,
        Some(Err(_)) -> None,
        Some(Ok(json)) -> {
          printed(k.opening);
          Some({
            json: match json {
              Object(members) ->
                Object(
                  members.insert(
                    "front_end",
                    object([
                      { key: "incremental", value: Bool(true) },
                      {
                        key: "phases",
                        value: phases_json({
                          read_us: time.elapsed_us() - begun,
                          front_end_us: 0,
                          write_back_us: 0,
                        }),
                      },
                      { key: "reused", value: Bool(true) },
                      { key: "key", value: Str(key.hex_of()) },
                    ]),
                  ),
                ),
              other -> other,
            },
            lines: k.lines,
            errs: k.errs,
            code: k.code,
          })
        },
      }
    },
  }
}

fn over_load(
  flags: Flags,
  options: Options,
  s: Style,
  t: TimedLoad,
  begun: Int,
  keeping: Option<CacheTarget>,
) -> Iteration / {semantics.cached, process.out[proc], fs.kind[cwd], fs.kind[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_us, MachineAccess, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variable, env.working_directory, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.compiled, cost_checker.report, shipped.read_pack, Derives, abort.raise, shipped.report_reached, evaluation.verdicts, evaluation.statements} =
  match program_view(t.program) {
    // Every diagnostic, as `check` refuses: an error is the whole answer, so the shipped-module
    // filter a successful load applies to warnings is not applied here.
    None ->
      {
        result: with_front_end(
          refused(s, "test", t.program.diags, t.program.places),
          reuse_members(t.program.tallies, t.program.lost),
        ),
        held: None,
        embeds: t.program.embeds,
      },
    Some(w) -> match config_schema::schema_error(w, options.machine.config.schema) {
      Some(d) ->
        {
          result: unbound(s, { diags: [d], places: t.program.places }),
          held: None,
          embeds: t.program.embeds,
        },
      None ->
        {
          result: tests_over(flags, s, options, t, w, begun, keeping),
          held: Some(t),
          embeds: t.program.embeds,
        },
    },
  }

/// How the tree stamps now, one line per `.ply` file a load of the paths reads, or `None` when the
/// walk could not read what it was given: a walk that failed has seen nothing, and a watcher told
/// the tree is empty stops noticing saves to it.
pub fn file_stamps(
  rs: List<paths::ResolvedPath>,
) -> Option<List<String>> / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], abort.raise, diverges} = {
  let found = walk::walk_paths_for_load(rs);
  if found.errors.len() > 0 { None } else {
    Some(
      found.files.fold([], |acc: List<String>, shown: String, rooted: paths::RootedPath|
        acc.push(
          shown ++ " " ++ stamp_part(paths::modified_ms(rooted)) ++ " "
            ++ stamp_part(paths::file_size(rooted)),
        )),
    )
  }
}

fn stamp_part(n: Option<Int>) -> String = match n { Some(x) -> x.to_string(), None -> "-" }

/// The root a report names.
fn root_of(rs: List<paths::ResolvedPath>) -> String =
  match rs.at(0) { None -> ".", Some(r) -> r.machine }

// --- What the loaded tree tells a selector ------------------------------------

/// Each test of the run, as the selector keys it: one the tree declares, or one case of it.
pub fn rows_of(analysis: CheckedProgram) -> List<Row> / {abort.raise} =
  range(0, analysis.checked.tests.len()).fold([], |acc: List<Row>, i: Int|
    match test_at(analysis, i) {
      None -> acc,
      Some(t) ->
        acc.push({
          index: i,
          label: String::of_bytes_lossy(t.name),
          name: String::of_bytes_lossy(t.key),
          module: String::of_bytes_lossy(t.module),
          hash: test_hash_at(analysis, i),
          seeded: seeded_of(t.footprint),
          nondet: t.nondet,
        }),
    })

fn mode_writes(m: type_syntax::Mode) -> Bool = match m { WriteMode -> true, _ -> false }

/// Every effect the program or the prelude declares, by its program-wide name, with whether it is
/// `nondet`.
pub fn declared_effects(analysis: CheckedProgram) -> Map<Bytes, Bool> =
  prelude_effects().concat(analysis.checked.effects).fold(
    Map::new(),
    |acc: Map<Bytes, Bool>, e: EffectInfo| acc.insert(e.name, e.nondet),
  )

pub fn case_view(
  analysis: CheckedProgram,
  declared: Map<Bytes, Bool>,
  i: Int,
  test_info: TestInfo,
) -> Case / {abort.raise} = {
  let atoms = canonical(test_info.footprint);
  let texts = atom_texts(atoms);
  {
    index: i,
    entry: entry_of(i, test_info.key),
    key: String::of_bytes_lossy(test_info.key),
    name: String::of_bytes_lossy(test_info.name),
    module: String::of_bytes_lossy(test_info.module),
    nondet: test_info.nondet,
    hash: hash_at(analysis, i),
    footprint: footprint_text(atoms),
    atoms: range(0, atoms.len()).map(|j: Int|
      match atoms.at(j) {
        Some(a) ->
          {
            atom: {
              effect: String::of_bytes_lossy(a.effect),
              resource: String::of_bytes_lossy(types::resource_text(a.resource)),
              writes: mode_writes(a.mode),
              // An effect no declaration names is the language's own.
              nondet: match declared.get(a.effect) { Some(known) -> known, None -> true },
            },
            text: texts.at_or(j, ""),
          },
        None -> { atom: { effect: "", resource: "", writes: false, nondet: false }, text: "" },
      }),
    seeded: seeded_of(test_info.footprint),
  }
}

/// The modules a line narrows a run to: those of `files` it names or that are under a directory it
/// names. `None` where it names each root whole.
fn named_modules(paths: List<paths::ResolvedPath>, files: List<File>) -> Option<List<String>> =
  if paths.all(|r: paths::ResolvedPath| r.inside == ".") { None } else {
    Some(
      files.filter(|f: File|
        paths.fold(false, |hit: Bool, r: paths::ResolvedPath|
          hit || paths::includes(r, f.path))).map(|f: File| f.module),
    )
  }

/// What the report says about the load, the tests in scope, the options it ran under and the unit
/// they run in.
fn program_of(
  options: Options,
  timed: TimedLoad,
  analysis: CheckedProgram,
  entries: List<Entry>,
  root: String,
  scope: Scope,
  opened: List<Diag>,
  filed_under: Option<String>,
  unit: TestUnit,
) -> Program / {abort.raise} = {
  let declared = declared_effects(analysis);
  let cases = scope.visible.fold([], |acc: List<Case>, i: Int|
    match test_at(analysis, i) {
      Some(test_info) -> {
        let view = case_view(analysis, declared, i, test_info);
        acc.push({ ..view, entry: entries.at_or(i, view.entry) })
      },
      None -> acc,
    });
  {
    root: root,
    stored_under: filed_under,
    unit: unit,
    files: timed.program.places.map(|place: SourceText| place.path),
    places: timed.program.places,
    modules: modules_of(timed.program, analysis.frame).map(|m: { name: String, path: String }|
      { name: m.name, file: m.path }),
    incremental: timed.cached,
    reuse: reuse_members(timed.program.tallies, timed.program.lost),
    phases: {
      read_us: timed.read_ms * 1000,
      front_end_us: timed.front_end_ms * 1000,
      write_back_us: timed.store_ms * 1000,
    },
    declared: scope.visible.len() + scope.filtered_out,
    cases: cases,
    positions: placed_cases(cases),
    filtered_out: scope.filtered_out,
    warnings: opened.concat(own_diags(timed.program.diags, analysis.frame)),
    options: object([]),
  }
}

// --- The run ----------------------------------------------------------------

/// A query naming nothing is wrong whatever the run does, and a `reuse fn` whose promise the cost
/// checker cannot show stops it as under `ply check`; both refuse before anything runs.
fn tests_over(
  flags: Flags,
  style: Style,
  options: Options,
  timed: TimedLoad,
  analysis: CheckedProgram,
  begun: Int,
  keeping: Option<CacheTarget>,
) -> CommandOutput / {semantics.cached, process.out[proc], fs.kind[cwd], fs.kind[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_us, MachineAccess, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variable, env.working_directory, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.compiled, cost_checker.report, evaluation.verdicts, evaluation.statements, shipped.read_pack, Derives, abort.raise, shipped.report_reached} = {
  let aimed: Result<Option<List<DefInfo>>, Diag> = match options.mutate {
    Some(query) -> match targets(analysis, query) { Ok(defs) -> Ok(Some(defs)), Err(d) -> Err(d) },
    None -> Ok(None),
  };
  match aimed {
    Err(d) -> refused(style, "test", [d], timed.program.places),
    Ok(targeted) -> {
      let loaded_at = time.elapsed_us();
      let unkept = broken_promises(timed.program, analysis.frame);
      let broken = if unkept.len() > 0 { unkept } else { evaluation_errors(timed, analysis.frame) };
      let promised_at = time.elapsed_us();
      let spent = { ..no_time_spent(), before_us: begun, promises_us: promised_at - loaded_at };
      if broken.len() > 0 { refused(style, "test", broken, timed.program.places) }
      else { selected(flags, style, options, timed, analysis, targeted, spent, keeping) }
    },
  }
}

fn selected(
  flags: Flags,
  style: Style,
  options: Options,
  timed: TimedLoad,
  analysis: CheckedProgram,
  targeted: Option<List<DefInfo>>,
  spent: TimeSpent,
  keeping: Option<CacheTarget>,
) -> CommandOutput / {semantics.cached, process.out[proc], fs.kind[cwd], fs.kind[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_us, MachineAccess, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variable, env.working_directory, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.compiled, shipped.read_pack, Derives, abort.raise, shipped.report_reached} = {
  let configuring = time.elapsed_us();
  let testing = tester::start_run(options);
  results::with_result_cache(results::store_for(flags.paths, flags.no_cache), || {
    let opened = if flags.no_cache { [] } else { result_cache.open_warnings() };
    // Which tests there are is the tables' to say, so each test over cases lists its own first,
    // unless a run kept what it listed while all its table reaches stands.
    let hashed = hashed_by_kind(analysis);
    let asked = over_cases(
      analysis,
      flags.filters,
      named_modules(flags.paths, timed.program.files),
    ).map(|i: Int| { test: i, hash: listing_hash(analysis, timed.program.places, hashed, i) });
    let place = listings_at(flags.paths);
    let stamp = Bytes::of_string(shipped_stamps().runtime);
    let kept = if flags.no_cache { Map::new() }
    else if place.label == "cwd" { case_listings::cached_listings[cwd](place.dir, stamp, asked) }
    else { case_listings::cached_listings[abs](place.dir, stamp, asked) };
    let unkept = asked.filter(|a: case_listings::ListingRequest| !kept.contains(a.test));
    let to_list = unkept.map(|a: case_listings::ListingRequest| a.test);
    let handing = time.elapsed_us();
    // Each unit is emitted over a dump of what it enters, but a schema with constants to enter runs
    // the whole program's.
    let whole = if options.machine.config.schema != None { Some(loaded_analysis(timed, analysis)) }
    else { None };
    let analysis_for = |within: TestRunScope|
      match whole { Some(front) -> front, None -> loaded_analysis(timed, analysis, Some(within)) };
    let lister = if to_list.len() == 0 { None } else {
      let within = listing_within(analysis, to_list);
      Some({ front: analysis_for(within), reach: within.owners })
    };
    let listing = time.elapsed_us();
    match list_cases(testing, lister, to_list) {
      Err(diags) -> unbound(style, { diags: diags, places: timed.program.places }),
      Ok(found) -> {
        if flags.no_cache { () } else if place.label == "cwd" {
          case_listings::cache_listings[cwd](place.dir, stamp, unkept, found)
        } else { case_listings::cache_listings[abs](place.dir, stamp, unkept, found) };
        let cases = kept.fold(
          found,
          |acc: Map<Int, Result<List<ListedCase>, ListingFailure>>, i: Int, listed: List<ListedCase>|
            acc.insert(i, Ok(listed)),
        );
        decided_run(
          flags,
          style,
          testing,
          timed,
          expand_cases(analysis, cases),
          analysis_for,
          opened,
          targeted,
          { ..spent, store_us: handing - configuring, handoff_us: listing - handing },
          listing,
          keeping,
        )
      },
    }
  })
}

/// Each definition's hash and each declaration's, by kind and name: a function and a type may share
/// a name.
fn hashed_by_kind(analysis: CheckedProgram) -> Map<Bytes, Bytes> =
  analysis.frame.hashes.decls.fold(
    analysis.frame.hashes.defs.fold(
      Map::new(),
      |acc: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }|
        acc.insert(b"fn ".concat(d.name), d.hash),
    ),
    |acc: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }|
      acc.insert(b"decl ".concat(d.name), d.hash),
  )

/// What a test over cases lists is a function of: its text, its table and its label among it, and
/// each definition it references, by its hash. The test's own hash leaves its table and its label
/// out, so that a case added moves no other case's key.
fn listing_hash(
  analysis: CheckedProgram,
  places: List<SourceText>,
  hashed: Map<Bytes, Bytes>,
  i: Int,
) -> Bytes / {abort.raise} =
  match test_at(analysis, i) {
    None -> b"",
    Some(t) -> {
      let text = match places.at(t.at.module) {
        Some(place) -> if t.at.span.end <= place.text.len() && t.at.span.start <= t.at.span.end {
          place.text.slice(t.at.span.start, t.at.span.end)
        } else { b"" },
        None -> b"",
      };
      let r = analysis.frame.hashes.refs;
      blake3(
        Bytes::concat_all(
          List::fold(
            match analysis.frame.hashes.test_refs.get(t.key) { Some(xs) -> xs, None -> [] },
            [text],
            |acc: List<Bytes>, v: Int| {
              let key = Bytes::concat(
                if r.decls.get(v) { b"decl " } else { b"fn " },
                r.names.get(v),
              );
              acc.push(key).push(match hashed.get(key) { Some(h) -> h, None -> b"" })
            },
          ),
        ),
      )
    },
  }

/// Where a project keeps what its tests over cases listed.
fn listings_at(paths: List<paths::ResolvedPath>) -> { label: String, dir: String } =
  match paths.at(0) {
    Some(r) -> { label: r.label, dir: paths::in_root(r, ".ply-cache/listings").path },
    None -> { label: "cwd", dir: ".ply-cache/listings" },
  }

/// The run over the tests as listing left them. `analysis_for` answers the dump a unit is emitted over,
/// given what the unit enters. `listing` is when listing began.
fn decided_run(
  flags: Flags,
  style: Style,
  testing: TestRun,
  timed: TimedLoad,
  over: ExpandedTests,
  analysis_for: (TestRunScope) -> LoadedAnalysis / {abort.raise},
  opened: List<Diag>,
  targeted: Option<List<DefInfo>>,
  spent: TimeSpent,
  listing: Int,
  keeping: Option<CacheTarget>,
) -> CommandOutput / {semantics.cached, process.out[proc], fs.kind[cwd], fs.kind[abs], fs.read_file[cwd], fs.read_file[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_us, env.working_directory, env.variables, MachineAccess, result_cache.open_warnings, result_cache.passes, result_cache.code_passes, result_cache.known, result_cache.baselines, result_cache.texts, result_cache.unstored, result_cache.history, result_cache.store_filing, emit.unit, emit.compiled, shipped.read_pack, fs.read[abs], fs.list_dir[abs], fs.write[abs], fs.read[cwd], fs.list_dir[cwd], fs.write[cwd], Derives, abort.raise, shipped.report_reached} = {
  let options = testing.options;
  let analysis = over.analysis;
  let selecting = time.elapsed_us();
  let scope = scope_of(
    analysis,
    flags.filters,
    options.shard,
    named_modules(flags.paths, timed.program.files),
  );
  let filed_under = if flags.no_cache { None } else { Some(shipped_stamps().runtime) };
  let p = program_of(
    options,
    timed,
    analysis,
    over.entries,
    root_of(flags.paths),
    scope,
    opened,
    filed_under,
    tester::no_unit(testing),
  );
  // Which tests run is the program's to say, and so is every key the store is asked about or a
  // pass is filed under: the runtime answers what the store holds and does what it is told.
  let searching = machine::sim_plan_of(options.sim);
  let search = search_of(searching);
  let load_or_reuse = views::loaded_texts(timed.program.shipping, timed.program.reached);
  let supplied = configuration::supplied(options.machine.config);
  let asked = cases_of(rows_of(analysis), search, flags.no_cache, options, supplied, load_or_reuse);
  let first = decide(asked.cases);
  let building = time.elapsed_us();
  // What a test runs is the unit's to say, so a run that would execute anything emits it before
  // deciding: a test nothing answered by its own key may be answered by its code.
  // Only what the run's scope holds runs, so only that is compiled.
  let visible = set_of(scope.visible);
  let running = to_run(first).filter(|i: Int| visible.contains(i));
  let within = run_within(over, running);
  let handed = analysis_for(within);
  let unit_at = time.elapsed_us();
  let emitted = run_unit(
    handed,
    over,
    running,
    within.owners,
    options.machine.config.schema != None,
  );
  match emitted {
    Err(diags) -> unbound(style, { diags: diags, places: p.places }),
    Ok(unit) -> {
      let keyed = match unit {
        Some(e) -> if flags.no_cache { Map::new() }
        else { code_keys(first, codes_of(handed, e, over.entries), search) },
        None -> Map::new(),
      };
      let answered = by_code(
        first,
        passed_by_code(first, keyed, load_or_reuse, options, supplied),
        search,
      );
      let decisions = answered.decisions;
      // Which tests may share a worker is the program's to say, from the atoms each row carries.
      let classes = classes_of(p, to_run(decisions).filter(|i: Int| visible.contains(i)));
      let decided = run_decision_of(
        p,
        decisions,
        search,
        sim_json(searching, options.sim),
        classes.map(|class: List<Int>| group_of_class(analysis, class)),
        classes,
      );
      // A run that executes nothing builds no unit, unless a schema has constants to enter or a
      // table had cases to list.
      let build = decided.runs.len() > 0 || options.machine.config.schema != None;
      let text = match unit { Some(e) -> if build { Some(e.text) } else { None }, None -> None };
      let made = match units::library_of(text, options.machine.profile) {
        Err(diags) -> Err(diags),
        Ok(library) -> tester::unit_of(testing, handed, library, true),
      };
      match made {
        Err(diags) -> unbound(style, { diags: diags, places: p.places }),
        Ok(made_unit) -> {
          let binding = time.elapsed_us();
          let refused = |diags: List<Diag>| {
            tester::close_unit(made_unit);
            unbound(style, { diags: diags, places: p.places })
          };
          match configuration::resolve_configuration(options.machine.config, |name: String|
              schema_of(made_unit, name)) {
            Err(diags) -> refused(diags),
            Ok(r) -> match tester::bound(
                testing,
                handed.dump,
                configuration::run_configuration(r.configuration),
              ) {
              Err(diags) -> refused(diags),
              Ok(bound_testing) -> {
                let bound = time.elapsed_us();
                let answer = concluded_run(
                  flags,
                  style,
                  options,
                  { ..p, unit: { ..made_unit, testing: bound_testing } },
                  timed,
                  analysis,
                  over.judged,
                  scope,
                  decisions,
                  decided,
                  keyed,
                  {
                    refiled: answered.refiled,
                    // A `--json` answer is kept from selecting again, below.
                    kept: if flags.json { None } else {
                      match keeping {
                        Some(k) ->
                          Some({ ..k, passes: pass_keys_in_scope(asked.answering, scope) }),
                        None -> None,
                      }
                    },
                  },
                  searching,
                  r.warnings,
                  targeted,
                  {
                    ..spent,
                    selection_us: building - selecting,
                    handoff_us: spent.handoff_us + unit_at - building,
                    unit_us: selecting - listing + binding - unit_at,
                    bind_us: bound - binding,
                  },
                );
                // A green run filed every pass it ran, so selecting again answers what the next run
                // would, which reads a cache this one wrote and says nothing of it: that answer is
                // the one kept.
                match keeping {
                  Some(k) -> if flags.json && answer.code == ok_code() {
                    let again = cases_of(
                      rows_of(analysis),
                      search,
                      false,
                      options,
                      supplied,
                      load_or_reuse,
                    );
                    let settled = decide(again.cases);
                    if all_cached(settled, scope) {
                      // The next run builds no unit, and its binding is torn down as this one's was.
                      let next = program_of(
                        options,
                        timed,
                        analysis,
                        over.entries,
                        root_of(flags.paths),
                        scope,
                        [],
                        filed_under,
                        tester::no_unit({ ..bound_testing, binding: 0 }),
                      );
                      let _ = concluded_run(
                        flags,
                        style,
                        options,
                        next,
                        timed,
                        analysis,
                        over.judged,
                        scope,
                        settled,
                        run_decision_of(
                          next,
                          settled,
                          search,
                          sim_json(searching, options.sim),
                          [],
                          [],
                        ),
                        Map::new(),
                        {
                          refiled: [],
                          kept: Some({
                            ..k,
                            passes: pass_keys_in_scope(again.answering, scope),
                            after: true,
                          }),
                        },
                        searching,
                        r.warnings,
                        targeted,
                        spent,
                      );
                      ()
                    }
                  },
                  None -> (),
                };
                tester::close_unit(made_unit);
                answer
              },
            },
          }
        },
      }
    },
  }
}

/// The value of the constant `name` the configuration schema reads, entered in `unit`, which a run
/// with a schema always builds.
fn schema_of(
  unit: TestUnit,
  name: String,
) -> Result<Value, List<Diag>> / {entering::machine.enter, abort.raise} =
  match unit.opened {
    Some(o) -> configuration::evaluate_schema_on_unit(o.unit, unit.roots, name),
    None -> Err([shown(machine::defect(name, "was asked of a run that built no unit"))]),
  }

// --- What a watching run stamps -----------------------------------------------

test "a tree stamps one line per `.ply` file, and a walk that fails stamps nothing" {
  let tree = mem_of([
    { path: "m.ply", body: b"fn m() -> Int = 1" },
    { path: "notes.txt", body: b"x" },
    { path: "sub/deep.ply", body: b"fn d() -> Int = 2" },
  ]);
  let walked = |rs: List<paths::ResolvedPath>|
    handle {
      file_stamps(rs)
    } with {
      fs.kind[cwd](p) -> mem_kind(tree, p),
      fs.kind[abs](p) -> panic("nothing here leaves the working directory"),
      fs.list_dir[cwd](p) -> mem_list(tree, p),
      fs.list_dir[abs](p) -> panic("nothing here leaves the working directory"),
      fs.read_file[cwd](p) -> mem_read(tree, p),
      fs.read_file[abs](p) -> panic("nothing here leaves the working directory"),
      fs.modified_ms[cwd](p) -> mem_modified(tree, p),
      fs.modified_ms[abs](p) -> panic("nothing here leaves the working directory"),
      fs.file_size[cwd](p) -> mem_size(tree, p),
      fs.file_size[abs](p) -> panic("nothing here leaves the working directory"),
    };
  match walked([paths::here()]) {
    Some(lines) -> {
      assert_eq(lines.len(), 2);
      assert(lines.at_or(0, "").starts_with("m.ply "));
      assert(lines.at_or(0, "").ends_with(" 17"));
      assert(lines.at_or(1, "").starts_with("sub/deep.ply "))
    },
    None -> panic("a readable tree stamps"),
  };
  assert_eq(walked([paths::at_cwd("gone")]), None)
}
