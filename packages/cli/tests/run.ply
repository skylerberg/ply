pub type Iteration = {
  result: CommandOutput,
  opened: Option<Session<TestReading>>,
  embeds: List<Embed>,
}

pub fn run(
  flags: Flags,
  options: Options,
) -> CommandOutput / {project_store::Databases, semantics.cached, shipped.read_pack, shipped.names, process.out[proc], process.err[proc], builder.git[vcs], ProjectFiles, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, MachineAccess, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], env.working_directory, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.code, emit.libraries, cost_checker.report, evaluation.verdicts, evaluation.statements, evaluation.stored, Loads, abort.raise, diverges, toolchain.reuse_dir} =
  run_once(flags, options, None).result

fn test_reading(
  flags: Flags,
  options: Options,
  named: Option<List<String>>,
  modules: Modules,
  read: ProgramSummary,
) -> TestReading / {memo.read, abort.raise} = {
  let list = view::test_list(modules);
  let later = later_checks(modules, read, false);
  {
    listing: listing_of(
      list,
      selection_of(list, flags.filters, options.shard, named),
      stored_identity,
      effect_determinism(
        later.reading.rollup.declared.map(|d: DeclaredEffect| { name: d.name, nondet: d.nondet }),
      ),
    ),
    later: later,
    schema: config_schema::listed_schema_error(modules, options.machine.config.schema),
    records: view::module_records(modules),
  }
}

fn embeds_read(t: Session<TestReading>) -> List<Embed> / {abort.raise} =
  embeds_of(t, t.value.later.reading.rollup.embeds)

pub fn run_once(
  flags: Flags,
  options: Options,
  before: Option<Session<TestReading>>,
) -> Iteration / {project_store::Databases, semantics.cached, shipped.read_pack, shipped.names, process.out[proc], process.err[proc], builder.git[vcs], ProjectFiles, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, MachineAccess, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], env.working_directory, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.code, emit.libraries, cost_checker.report, evaluation.verdicts, evaluation.statements, evaluation.stored, Loads, abort.raise, diverges, toolchain.reuse_dir} = {
  let s: Style = style_of(flags);
  let begun = time.elapsed_us();
  process.err[proc](indent ++ "checking the program");
  match opened_tests(flags, options, before) {
    Err(r) ->
      {
        result: with_front_end(
          rejected(s, "test", r.diagnostics, r.places),
          reuse_members(r.tallies, r.missing_results),
        ),
        opened: None,
        embeds: [],
      },
    Ok(t) -> {
      let embeds = embeds_read(t);
      let places = places_of(t);
      match t.value.schema {
        Some(d) ->
          {
            result: unbound(s, { diagnostics: [d], places: places }),
            opened: None,
            embeds: embeds,
          },
        None ->
          {
            result: tests_over(flags, s, options, t, places, begun),
            opened: Some(t),
            embeds: embeds,
          },
      }
    },
  }
}

fn opened_tests(
  flags: Flags,
  options: Options,
  before: Option<Session<TestReading>>,
) -> Result<Session<TestReading>, Refusal> / {process.err[proc], ProgramStore, builder.git[vcs], time.elapsed_ms, abort.raise, diverges} = {
  let started = time.elapsed_ms();
  let project = load_resolved(flags.paths);
  let reused = match before {
    Some(t) -> if unchanged(project, t.project, embeds_read(t)) { Some(t) } else { None },
    None -> None,
  };
  match reused {
    Some(t) -> Ok({ ..t, phases: { read_ms: 0, front_end_ms: 0, store_ms: 0 } }),
    None ->
      progress::reporting("checking", ||
        session_over(
          flags.paths,
          project,
          started,
          flags.verify_dependencies,
          |modules: Modules, read: ProgramSummary|
            test_reading(flags, options, named_modules(flags.paths, project.files), modules, read),
        )),
  }
}

pub fn file_stamps(
  rs: List<paths::ResolvedPath>,
) -> Option<List<String>> / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], abort.raise, diverges} = {
  let found = walk::walk_paths_for_load(rs);
  if found.errors.len() > 0 { None } else {
    Some(
      found.files.fold([], |accumulator: List<String>, shown: String, rooted: paths::RootedPath|
        accumulator.push(
          shown ++ " " ++ stamp_part(paths::modified_ms(rooted)) ++ " "
            ++ stamp_part(paths::file_size(rooted)),
        )),
    )
  }
}

fn stamp_part(n: Option<Int>) -> String = match n { Some(x) -> x.to_string(), None -> "-" }

fn root_of(rs: List<paths::ResolvedPath>) -> String =
  match rs.at(0) { None -> ".", Some(r) -> r.machine }

pub fn rows_of(analysis: TestListing) -> List<Row> =
  analysis.tests.fold([], |accumulator: List<Row>, t: SelectedTest|
    accumulator.push({
      index: accumulator.len(),
      label: String::of_bytes_lossy(t.info.name),
      name: String::of_bytes_lossy(t.info.key),
      module: String::of_bytes_lossy(t.info.module),
      hash: run_hash(t),
      seeded: uses_simulation(t.info.effects),
      nondet: t.info.nondet,
    }))

fn is_write_mode(m: type_syntax::Mode) -> Bool = match m { WriteMode -> true, _ -> false }

pub fn case_view(analysis: TestListing, i: Int, listed: SelectedTest) -> Case / {abort.raise} = {
  let test_info = listed.info;
  let effects = canonical(test_info.effects);
  let texts = effect_texts(effects);
  {
    index: i,
    entry: entry_of(i, test_info.key),
    key: String::of_bytes_lossy(test_info.key),
    name: String::of_bytes_lossy(test_info.name),
    module: String::of_bytes_lossy(test_info.module),
    nondet: test_info.nondet,
    hash: run_hash(listed).hex_of(),
    effects: outside_effects_text(effects),
    listed: range(0, effects.len()).map(|j: Int|
      match effects.at(j) {
        Some(a) ->
          {
            entry: {
              effect: String::of_bytes_lossy(a.effect),
              resource: String::of_bytes_lossy(types::resource_text(a.resource)),
              writes: is_write_mode(a.mode),
              nondet: match analysis.effects.get(a.effect) {
                Some(Deterministic) -> false,
                Some(Nondeterministic) -> true,
                None -> true,
              },
            },
            text: texts.at_or(j, ""),
          },
        None -> { entry: { effect: "", resource: "", writes: false, nondet: false }, text: "" },
      }),
    seeded: uses_simulation(test_info.effects),
  }
}

fn named_modules(paths: List<paths::ResolvedPath>, files: List<File>) -> Option<List<String>> =
  if paths.all(|r: paths::ResolvedPath| r.inside == ".") { None } else {
    Some(
      files.filter(|f: File|
        paths.fold(false, |hit: Bool, r: paths::ResolvedPath|
          hit || paths::includes(r, f.path))).map(|f: File| f.module),
    )
  }

fn program_of(
  options: Options,
  t: Session<TestReading>,
  places: List<SourceText>,
  analysis: TestListing,
  entries: List<Entry>,
  root: String,
  scope: Scope,
  opened: List<Diagnostic>,
  recorded_under: String,
  unit: TestUnit,
) -> Program / {abort.raise} = {
  let cases = scope.visible.fold([], |accumulator: List<Case>, i: Int|
    match test_at(analysis, i) {
      Some(listed) -> {
        let view = case_view(analysis, i, listed);
        accumulator.push({ ..view, entry: entries.at_or(i, view.entry) })
      },
      None -> accumulator,
    });
  {
    root: root,
    cache_stamp: recorded_under,
    unit: unit,
    files: places.map(|place: SourceText| place.path),
    places: places,
    modules: range(0, analysis.names.len()).map(|i: Int|
      {
        name: String::of_bytes_lossy(analysis.names.get(i)),
        file: places.at(i).map(|p: SourceText| p.path).unwrap_or(""),
      }),
    reused_members: reuse_members(t.tallies, t.missing_results),
    phases: {
      read_us: t.phases.read_ms * 1000,
      front_end_us: t.phases.front_end_ms * 1000,
      write_back_us: t.phases.store_ms * 1000,
    },
    declared: scope.visible.len() + scope.filtered_out,
    cases: cases,
    positions: placed_cases(cases),
    filtered_out: scope.filtered_out,
    warnings: opened.concat(t.warnings),
    options: object([]),
  }
}

fn tests_over(
  flags: Flags,
  style: Style,
  options: Options,
  t: Session<TestReading>,
  places: List<SourceText>,
  begun: Int,
) -> CommandOutput / {toolchain.reuse_dir, project_store::Databases, semantics.cached, process.out[proc], process.err[proc], ProjectFiles, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_us, MachineAccess, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], env.working_directory, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.code, emit.libraries, cost_checker.report, evaluation.verdicts, evaluation.statements, evaluation.stored, shipped.read_pack, shipped.names, Loads, abort.raise} = {
  let loaded_at = time.elapsed_us();
  let broken = later_errors(t, t.value.later, places);
  let promised_at = time.elapsed_us();
  let spent = { ..no_time_spent, before_us: begun, promises_us: promised_at - loaded_at };
  if broken.len() > 0 { rejected(style, "test", broken, places) } else {
    results::with_result_cache(results::store_for(flags.paths), || {
      let configuring = time.elapsed_us();
      let plan = plan_of(flags, options, t);
      run_plan(flags, style, options, t, places, plan, {
        ..spent,
        store_us: time.elapsed_us() - configuring,
      })
    })
  }
}

type CaseListing = { index: Int, request: ListingRequest, stored: Option<List<ListedCase>> }

type Chosen = {
  over: ExpandedTests,
  scope: Scope,
  decided_cases: DecidedCases,
  first: List<Decision>,
}

type Listing = | Listed(Chosen) | Unlisted

type Plan = { opened: List<Diagnostic>, listings: List<CaseListing>, listing: Listing }

fn plan_of(
  flags: Flags,
  options: Options,
  t: Session<TestReading>,
) -> Plan / {result_cache.open_warnings, result_cache.listings, result_cache.passes, entering::machine.hosting, env.variables, env.working_directory, fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.read_file[cwd], fs.read_file[abs], fs.read[abs], fs.read_file[shipped], shipped.names, abort.raise} = {
  let opened = result_cache.open_warnings();
  let cased = over_cases(t.value.listing);
  let stored = result_cache.listings(cased.map(|c: CasedTest| c.request));
  let listings = range(0, cased.len()).map(|k: Int|
    { index: cased.get(k).index, request: cased.get(k).request, stored: stored.get(k) });
  {
    opened: opened,
    listings: listings,
    listing: if listings.any(|c: CaseListing| c.stored == None) { Unlisted }
    else { Listed(chosen_of(flags, options, t, stored_cases(listings, Map::new()))) },
  }
}

fn stored_cases(
  listings: List<CaseListing>,
  found: Map<Int, Result<List<ListedCase>, KnownFailure>>,
) -> Map<Int, Result<List<ListedCase>, KnownFailure>> =
  listings.fold(found, |cases: Map<Int, Result<List<ListedCase>, KnownFailure>>, c: CaseListing|
    match c.stored { Some(listed) -> cases.insert(c.index, Ok(listed)), None -> cases })

fn chosen_of(
  flags: Flags,
  options: Options,
  t: Session<TestReading>,
  cases: Map<Int, Result<List<ListedCase>, KnownFailure>>,
) -> Chosen / {result_cache.passes, entering::machine.hosting, env.variables, env.working_directory, fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.read_file[cwd], fs.read_file[abs], fs.read[abs], fs.read_file[shipped], shipped.names, abort.raise} = {
  let over = expand_cases(t.value.listing, cases);
  let decided_cases = cases_of(
    rows_of(over.listing),
    search_of(machine::sim_plan_of(options.sim), options.machine.profile),
    |stored: Map<Bytes, List<RecordedRead>>| passes_holding(options, stored),
  );
  {
    over: over,
    scope: scope_of(
      over.listing,
      flags.filters,
      options.shard,
      named_modules(flags.paths, t.project.files),
    ),
    decided_cases: decided_cases,
    first: decide(decided_cases.cases),
  }
}

fn run_plan(
  flags: Flags,
  style: Style,
  options: Options,
  t: Session<TestReading>,
  places: List<SourceText>,
  plan: Plan,
  spent: TimeSpent,
) -> CommandOutput / {toolchain.reuse_dir, project_store::Databases, semantics.cached, process.out[proc], process.err[proc], ProjectFiles, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_us, MachineAccess, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], env.working_directory, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.code, emit.libraries, shipped.read_pack, shipped.names, Loads, result_cache.interrupted, result_cache.journal, result_cache.open_warnings, result_cache.passes, result_cache.code_passes, result_cache.known, result_cache.baselines, result_cache.texts, result_cache.unstored, result_cache.has_records, result_cache.history, result_cache.store_results, result_cache.keep_listings, abort.raise} = {
  let testing = tester::start_run(options);
  let handoff_start = time.elapsed_us();
  let chosen = match plan.listing {
    Listed(chosen) -> Ok(chosen),
    Unlisted -> {
      process.err[proc](indent ++ "listing the test cases");
      let to_list = plan.listings.filter(|c: CaseListing| c.stored == None).map(|c: CaseListing|
        c.index);
      match match units::code_program_of(t, t.value.later.reading.rollup) {
          Err(diagnostics) -> Err(diagnostics),
          Ok(program) -> list_cases(testing, program, t.value.listing, to_list),
        } {
        Err(diagnostics) -> Err(diagnostics),
        Ok(found) -> {
          result_cache.keep_listings(
            plan.listings.fold([], |listed: List<CasesListed>, c: CaseListing|
              match found.get(c.index) {
                Some(Ok(cases)) ->
                  listed.push({ test: c.request.test, listing: c.request.listing, cases: cases }),
                _ -> listed,
              }),
          );
          Ok(chosen_of(flags, options, t, stored_cases(plan.listings, found)))
        },
      }
    },
  };
  let listing = time.elapsed_us();
  match chosen {
    Err(diagnostics) -> unbound(style, { diagnostics: diagnostics, places: places }),
    Ok(c) ->
      decided_run(
        flags,
        style,
        testing,
        t,
        places,
        c,
        plan.opened,
        { ..spent, handoff_us: listing - handoff_start },
        listing,
      ),
  }
}

fn decided_run(
  flags: Flags,
  style: Style,
  testing: TestRun,
  t: Session<TestReading>,
  places: List<SourceText>,
  chosen: Chosen,
  opened: List<Diagnostic>,
  spent: TimeSpent,
  listing: Int,
) -> CommandOutput / {toolchain.reuse_dir, project_store::Databases, semantics.cached, process.out[proc], process.err[proc], ProjectFiles, fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_us, env.working_directory, env.variables, MachineAccess, result_cache.interrupted, result_cache.journal, result_cache.open_warnings, result_cache.code_passes, result_cache.known, result_cache.baselines, result_cache.texts, result_cache.unstored, result_cache.has_records, result_cache.history, result_cache.store_results, emit.code, emit.libraries, shipped.read_pack, shipped.names, fs.read[abs], fs.write[abs], fs.read[cwd], fs.write[cwd], Loads, abort.raise} = {
  let options = testing.options;
  let over = chosen.over;
  let analysis = over.listing;
  let scope = chosen.scope;
  let first = chosen.first;
  let selecting = time.elapsed_us();
  let p = program_of(
    options,
    t,
    places,
    analysis,
    over.entries,
    root_of(flags.paths),
    scope,
    opened,
    shipped_stamps().runtime_digest,
    tester::empty_test_unit(testing),
  );
  let searching = machine::sim_plan_of(options.sim);
  let search = search_of(searching, options.machine.profile);
  let building = time.elapsed_us();
  let visible = Set::of_list(scope.visible);
  let running = to_run(first).filter(|i: Int| visible.contains(i));
  let schema = options.machine.config.schema;
  let runs_code = schema != None || running.len() > 0;
  let unit_at = time.elapsed_us();
  if runs_code { process.err[proc](indent ++ "building the tests") };
  let built = if !runs_code { Ok(None) }
  else { match run_unit(t, schema) { Ok(b) -> Ok(Some(b)), Err(diagnostics) -> Err(diagnostics) } };
  match built {
    Err(diagnostics) -> unbound(style, { diagnostics: diagnostics, places: p.places }),
    Ok(unit) -> {
      let keyed = match unit {
        Some(b) -> code_keys(first, codes_of(t.value.listing, b.emitted, over.entries), search),
        None -> Map::new(),
      };
      let returned = by_code(
        first,
        passed_by_code(first, keyed, |stored: Map<Bytes, List<RecordedRead>>|
          passes_holding(options, stored)),
        search,
      );
      let decisions = returned.decisions;
      let classes = classes_of(p, to_run(decisions).filter(|i: Int| visible.contains(i)));
      let decided = run_decision_of(
        p,
        decisions,
        search,
        sim_json(searching, options.sim),
        classes.map(|class: List<Int>| group_of_class(analysis, class)),
        classes,
      );
      let build = decided.runs.len() > 0 || schema != None;
      let to_compile = match unit {
        Some(b) -> if build { Some(b.emitted) } else { None },
        None -> None,
      };
      match to_compile {
        Some(_) -> process.err[proc](indent ++ "compiling the tests"),
        None -> (),
      };
      let made = match units::library_of(to_compile, options.machine.profile) {
        Err(diagnostics) -> Err(diagnostics),
        Ok(library) ->
          tester::unit_of(
            testing,
            infos_of(t.value.listing),
            match unit { Some(b) -> b.program.roots, None -> Map::new() },
            library,
            true,
          ),
      };
      match made {
        Err(diagnostics) -> unbound(style, { diagnostics: diagnostics, places: p.places }),
        Ok(made_unit) -> {
          let binding = time.elapsed_us();
          let rejected = |diagnostics: List<Diagnostic>| {
            tester::close_unit(made_unit);
            unbound(style, { diagnostics: diagnostics, places: p.places })
          };
          match configuration::resolve_configuration(options.machine.config, |name: String|
              schema_of(made_unit, name)) {
            Err(diagnostics) -> rejected(diagnostics),
            Ok(r) -> match if !runs_code { Ok(testing) } else {
                tester::bind_test_run(
                  testing,
                  entries::runnable_from(
                    t.value.later.reading.rollup,
                    t.value.listing.tests.flat_map(|x: SelectedTest| x.info.effects),
                  ),
                  configuration::run_configuration(r.configuration),
                )
              } {
              Err(diagnostics) -> rejected(diagnostics),
              Ok(bound_testing) -> {
                let bound = time.elapsed_us();
                let result = concluded_run(
                  flags,
                  style,
                  options,
                  { ..p, unit: { ..made_unit, testing: bound_testing } },
                  t,
                  over,
                  scope,
                  decisions,
                  decided,
                  keyed,
                  returned.kept_passes,
                  chosen.decided_cases.rolled,
                  searching,
                  r.warnings,
                  {
                    ..spent,
                    selection_us: building - selecting,
                    handoff_us: spent.handoff_us + unit_at - building,
                    unit_us: selecting - listing + binding - unit_at,
                    bind_us: bound - binding,
                  },
                );
                tester::close_unit(made_unit);
                result
              },
            },
          }
        },
      }
    },
  }
}

fn schema_of(
  unit: TestUnit,
  name: String,
) -> Result<Value, List<Diagnostic>> / {entering::machine.enter, abort.raise} =
  match unit.opened {
    Some(o) -> configuration::evaluate_schema_on_unit(o.unit, unit.roots, name),
    None ->
      Err([shown(machine::internal_error(name, "was requested, but the run compiled no program"))]),
  }

test "`file_stamps` returns one line for each `.ply` file in a tree, and nothing when the walk fails" {
  let tree = mem_of([
    { path: "m.ply", body: b"fn m() -> Int = 1" },
    { path: "notes.txt", body: b"x" },
    { path: "sub/deep.ply", body: b"fn d() -> Int = 2" },
  ]);
  let walked = |rs: List<paths::ResolvedPath>|
    handle {
      file_stamps(rs)
    } with {
      fs.kind[cwd](p) -> mem_kind(tree, p),
      fs.kind[abs](p) -> panic("nothing here leaves the working directory"),
      fs.list_dir[cwd](p) -> mem_list(tree, p),
      fs.list_dir[abs](p) -> panic("nothing here leaves the working directory"),
      fs.read_file[cwd](p) -> mem_read(tree, p),
      fs.read_file[abs](p) -> panic("nothing here leaves the working directory"),
      fs.modified_ms[cwd](p) -> mem_modified(tree, p),
      fs.modified_ms[abs](p) -> panic("nothing here leaves the working directory"),
      fs.file_size[cwd](p) -> mem_size(tree, p),
      fs.file_size[abs](p) -> panic("nothing here leaves the working directory"),
    };
  match walked([paths::here()]) {
    Some(lines) -> {
      assert_eq(lines.len(), 2);
      assert(lines.at_or(0, "").starts_with("m.ply "));
      assert(lines.at_or(0, "").ends_with(" 17"));
      assert(lines.at_or(1, "").starts_with("sub/deep.ply "))
    },
    None -> panic("a readable tree stamps"),
  };
  assert_eq(walked([paths::at_cwd("gone")]), None)
}
