import compiler.load (Derives)
import compiler.front (viewed_text)
import compiler.front.facts (pulled_at)
import compiler.unit (shipped)
import std.random (entropy)
import std.time (time)
import module_queries
import builder (builder)
import args (Flags, kept, module_names, no_flags, style_of)
import compiler.cc (toolchain)
import program (Program, Tables, TimedLoad, definitions_in_order, tables_of, location_of, place_of,
                hash_of, own_hash_of, dependencies_of, specs_of, short_of, timed_over, no_program,
                program_view, encoded_command_line, cached_command, cache_command)
import module_queries (command_key)
import sources (Project, load_resolved)
import std.bin
import std.bytes
import report (CommandOutput, schema_version, ok_code, count_of, indent, refused)
import std.term (Style, bold, dim)
import compiler.store.hash.forms (FunctionNamed)
import compiler.store.hash (no_hashes)
import compiler.check.infer.checker (DefinitionInfo)
import compiler.check.termination (Terminates, unknown_summary)
import compiler.check.types (NamedType, FunctionType, row_text, scheme_text)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, Array, Object, object, parse_string, string_or_null,
                 strings, to_string)
import signature (atom_texts)
import compiler.syntax.parsing (span_between)

pub fn scheme_of(definition_info: DefinitionInfo) -> String / {abort.raise} =
  String::of_bytes_lossy(scheme_text(definition_info.scheme))

pub fn effects_text(definition_info: DefinitionInfo) -> String / {abort.raise} =
  String::of_bytes_lossy(row_text({ atoms: definition_info.effects, tail: None }))

fn is_listed(
  flags: Flags,
  modules: Map<String, Bool>,
  pulled: (Int) -> Bool,
  definition_info: DefinitionInfo,
) -> Bool / {abort.raise} =
  !pulled(definition_info.at.module)
    && kept(
      flags.filters,
      modules,
      String::of_bytes_lossy(definition_info.module),
      String::of_bytes_lossy(definition_info.name),
    )

fn file_of(p: Program, definition_info: DefinitionInfo) -> Json =
  match place_of(p, definition_info.at) { Some(place) -> Str(place.path), None -> Null }

fn definition_json(
  program: Program,
  tables: Tables,
  definition_info: DefinitionInfo,
) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(String::of_bytes_lossy(definition_info.name)) },
    { key: "module", value: Str(String::of_bytes_lossy(definition_info.module)) },
    { key: "simple_name", value: Str(String::of_bytes_lossy(definition_info.simple_name)) },
    { key: "location", value: string_or_null(location_of(program, definition_info.at)) },
    { key: "file", value: file_of(program, definition_info) },
    { key: "start", value: Number(Decimal::of_int(definition_info.at.span.start)) },
    { key: "end", value: Number(Decimal::of_int(definition_info.at.span.end)) },
    { key: "hash", value: string_or_null(hash_of(tables, definition_info.name)) },
    { key: "own", value: string_or_null(own_hash_of(tables, definition_info.name)) },
    { key: "type", value: Str(scheme_of(definition_info)) },
    { key: "effects", value: strings(atom_texts(definition_info.effects)) },
    { key: "performed", value: strings(atom_texts(definition_info.performed)) },
    { key: "specs", value: Number(Decimal::of_int(specs_of(tables, definition_info.name))) },
    {
      key: "dependencies",
      value: Array(
        dependencies_of(tables, FunctionNamed(definition_info.name)).map(|n: String| Str(n)),
      ),
    },
  ])

fn short_or_blank(tables: Tables, definition_info: DefinitionInfo) -> String / {abort.raise} =
  match hash_of(tables, definition_info.name) { Some(h) -> short_of(h), None -> "" }

fn location_or_blank(p: Program, definition_info: DefinitionInfo) -> String / {abort.raise} =
  match location_of(p, definition_info.at) { Some(l) -> l, None -> "" }

fn text_lines(
  style: Style,
  program: Program,
  tables: Tables,
  definitions: List<DefinitionInfo>,
) -> List<String> / {abort.raise} =
  definitions.fold([""], |acc: List<String>, definition_info: DefinitionInfo|
    acc.push(
      indent() ++ dim(style, short_or_blank(tables, definition_info)) ++ "  "
        ++ bold(style, String::of_bytes_lossy(definition_info.name))
        ++ "  "
        ++ dim(style, location_or_blank(program, definition_info)),
    ).push(
      indent() ++ indent() ++ scheme_of(definition_info) ++ " / " ++ effects_text(definition_info),
    ))

fn definitions_output(
  style: Style,
  program: Program,
  tables: Tables,
  definitions: List<DefinitionInfo>,
) -> CommandOutput / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("definitions") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code())) },
      {
        key: "definitions",
        value: Array(
          definitions.map(|definition_info: DefinitionInfo|
            definition_json(program, tables, definition_info)),
        ),
      },
      { key: "diagnostics", value: Array([]) },
    ]),
    lines: text_lines(style, program, tables, definitions).push("").push(
      indent() ++ count_of(definitions.len(), "definition"),
    ),
    errs: [],
    code: ok_code(),
  }

pub fn run(
  flags: Flags,
  argv: List<String>,
) -> CommandOutput / {shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], time.elapsed_ms, entropy.next, time.now_ms, Derives, abort.raise, diverges, shipped.report_reached} = {
  let started = time.elapsed_ms();
  let project = load_resolved(flags.paths);
  let key = command_key(module_queries::program_digest(), encoded_command_line(argv, flags.paths));
  let shown = key.hex_of();
  match cached_command(flags.paths, project, key) {
    Some(bytes) -> match bin::decode(bytes, cached_listing_bin()) {
      Ok(l) -> match parse_string(l.json) {
        Ok(Object(members)) ->
          {
            json: Object(
              members.insert(
                "front_end",
                object([{ key: "reused", value: Bool(true) }, { key: "key", value: Str(shown) }]),
              ),
            ),
            lines: l.lines,
            errs: l.errs,
            code: l.code,
          },
        _ -> list_now(flags, project, started, key),
      },
      Err(_) -> list_now(flags, project, started, key),
    },
    None -> list_now(flags, project, started, key),
  }
}

type CachedListing = { lines: List<String>, errs: List<String>, code: Int, json: String }

derive bin for CachedListing

fn list_now(
  flags: Flags,
  project: Project,
  started: Int,
  key: Bytes,
) -> CommandOutput / {shipped.read_pack, toolchain.reuse_dir, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], time.elapsed_ms, entropy.next, time.now_ms, Derives, abort.raise, shipped.report_reached} = {
  let t: TimedLoad = timed_over(flags.paths, project, started, flags.verify_dependencies);
  let loaded: Program = t.program;
  match program_view(loaded) {
    None -> refused(style_of(flags), "definitions", loaded.diagnostics, loaded.places),
    Some(w) -> {
      let modules = module_names(w.frame.order);
      let listed = definitions_output(
        style_of(flags),
        loaded,
        tables_of(w.frame.hashes),
        definitions_in_order(w).filter(|definition_info: DefinitionInfo|
          is_listed(
            flags,
            modules,
            |i: Int| pulled_at(w.frame.packages, w.frame.module_packages, i),
            definition_info,
          )),
      );
      let answer = match listed.json {
        Object(members) ->
          {
            ..listed,
            json: Object(
              members.insert("front_end", object([{ key: "reused", value: Bool(false) }])),
            ),
          },
        _ -> listed,
      };
      let _ = cache_command(
        flags.paths,
        project,
        key,
        loaded,
        bin::encode(
          {
            lines: answer.lines,
            errs: answer.errs,
            code: answer.code,
            json: to_string(answer.json),
          },
          cached_listing_bin(),
        ),
      );
      answer
    },
  }
}

fn nullary(name: Bytes, module: Bytes, simple: Bytes) -> DefinitionInfo =
  {
    name: name,
    module: module,
    simple_name: simple,
    scheme: {
      type_variables: [],
      row_variables: [],
      keep_variables: [],
      label_variables: [],
      ty: FunctionType({
        kept: [],
        once: false,
        params: [],
        ret: NamedType({ name: b"Int", args: [] }),
        effects: { atoms: [], tail: None },
      }),
    },
    effects: [],
    performed: [],
    scaling: [],
    repeats: [],
    bounded: [],
    tail_bounded: false,
    ending: Terminates,
    summary: unknown_summary(),
    raises: [],
    row_aliases: [],
    constraints: [],
    spec: [],
    at: { module: 0, span: span_between(20, 40) },
  }

fn flags_of(filters: List<String>) -> Flags = { ..no_flags(), filters: filters }

test "only the program's own definitions are listed, and `--filter` cuts by program-wide name" {
  let mine = nullary(b"m.three", b"m", b"three");
  let shipped = {
    ..nullary(b"std.json.to_string", b"std.json", b"to_string"),
    at: { module: 1, span: span_between(20, 40) },
  };
  let pulled = |i: Int| i == 1;
  let modules = module_names([b"m", b"std.json"]);
  assert(is_listed(flags_of([]), modules, pulled, mine));
  assert(!is_listed(flags_of([]), modules, pulled, shipped));
  assert(is_listed(flags_of([]), modules, |i: Int| false, shipped));
  assert(is_listed(flags_of(["thr"]), modules, pulled, mine));
  assert(!is_listed(flags_of(["two"]), modules, pulled, mine))
}

test "a definition with no effects and no variables prints the way the reference prints it" {
  let d = nullary(b"m.two", b"m", b"two");
  assert_eq(scheme_of(d), "() -> Int");
  assert_eq(effects_text(d), "{}")
}

test "a listing opens and closes with a blank line and ends on the tally" {
  let p: Program = { ..no_program(), places: [{ path: "m.ply", text: b"fn two() -> Int = 1\n" }] };
  let tables: Tables = {
    definitions: Map::new(),
    own: Map::new(),
    specs: Map::new(),
    hashes: no_hashes(),
  };
  let answer = definitions_output(style_of(flags_of([])), p, tables, [
    nullary(b"m.two", b"m", b"two"),
  ]);
  assert_eq(answer.code, 0);
  assert_eq(answer.lines, [
    "",
    "     m.two  m.ply:2:1",
    "      () -> Int / {}",
    "",
    "   1 definition",
  ])
}
