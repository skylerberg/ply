import progress
import std.set (Set)
import sources (ProjectFiles)
import compiler.load (Derives)
import compiler.front (viewed_text)
import compiler.unit (shipped)
import std.random (entropy)
import std.time (time)
import builder (builder)
import args (Flags, matches_filters, module_names, no_flags, style_of)
import compiler.cc (toolchain)
import program (Tables, definitions_in_order, tables_of, location_of, place_of, places_of, hash_of,
                own_hash_of, dependencies_of, session, specialization_count, short_of)
import diagnostic (SourceText)
import compiler.front.checking.view
import compiler.front.checking.view (Modules)
import compiler.front.checking.groups (ProgramSummary)
import report (CommandOutput, schema_version, ok_code, count_of, indent, rejected)
import std.term (Style, bold, dim)
import compiler.store.hash.forms (FunctionNamed)
import compiler.store.hash (no_hashes)
import compiler.check.infer.checker (DefinitionInfo)
import compiler.check.termination (Terminates, unknown_summary)
import compiler.check.types (Effect, NamedType, FunctionType, effects_text, scheme_text)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, Array, object, string_or_null, strings)
import signature (effect_texts)
import compiler.syntax.parsing (span_between)

pub fn scheme_of(definition_info: DefinitionInfo) -> String / {abort.raise} =
  String::of_bytes_lossy(scheme_text(definition_info.scheme))

pub fn listed_effects_text(effects: List<Effect>) -> String / {abort.raise} =
  String::of_bytes_lossy(effects_text({ listed: effects, variable: None }))

fn is_listed(
  flags: Flags,
  modules: Set<String>,
  pulled: (Int) -> Bool,
  definition_info: DefinitionInfo,
) -> Bool / {abort.raise} =
  !pulled(definition_info.at.module)
    && matches_filters(
      flags.filters,
      modules,
      String::of_bytes_lossy(definition_info.module),
      String::of_bytes_lossy(definition_info.name),
    )

fn file_of(places: List<SourceText>, definition_info: DefinitionInfo) -> Json =
  match place_of(places, definition_info.at) { Some(place) -> Str(place.path), None -> Null }

fn definition_json(
  places: List<SourceText>,
  tables: Tables,
  definition_info: DefinitionInfo,
) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(String::of_bytes_lossy(definition_info.name)) },
    { key: "module", value: Str(String::of_bytes_lossy(definition_info.module)) },
    { key: "simple_name", value: Str(String::of_bytes_lossy(definition_info.simple_name)) },
    { key: "location", value: string_or_null(location_of(places, definition_info.at)) },
    { key: "file", value: file_of(places, definition_info) },
    { key: "start", value: Number(Decimal::of_int(definition_info.at.span.start)) },
    { key: "end", value: Number(Decimal::of_int(definition_info.at.span.end)) },
    { key: "hash", value: string_or_null(hash_of(tables, definition_info.name)) },
    { key: "own", value: string_or_null(own_hash_of(tables, definition_info.name)) },
    { key: "type", value: Str(scheme_of(definition_info)) },
    { key: "effects", value: strings(effect_texts(definition_info.effects)) },
    { key: "performed", value: strings(effect_texts(definition_info.performed)) },
    {
      key: "specs",
      value: Number(Decimal::of_int(specialization_count(tables, definition_info.name))),
    },
    {
      key: "dependencies",
      value: Array(
        dependencies_of(tables, FunctionNamed(definition_info.name)).map(|n: String| Str(n)),
      ),
    },
  ])

fn short_or_blank(tables: Tables, definition_info: DefinitionInfo) -> String / {abort.raise} =
  match hash_of(tables, definition_info.name) { Some(h) -> short_of(h), None -> "" }

fn location_or_blank(
  places: List<SourceText>,
  definition_info: DefinitionInfo,
) -> String / {abort.raise} =
  match location_of(places, definition_info.at) { Some(l) -> l, None -> "" }

fn text_lines(
  style: Style,
  places: List<SourceText>,
  tables: Tables,
  definitions: List<DefinitionInfo>,
) -> List<String> / {abort.raise} =
  definitions.fold([""], |accumulator: List<String>, definition_info: DefinitionInfo|
    accumulator.push(
      indent ++ dim(style, short_or_blank(tables, definition_info)) ++ "  "
        ++ bold(style, String::of_bytes_lossy(definition_info.name))
        ++ "  "
        ++ dim(style, location_or_blank(places, definition_info)),
    ).push(
      indent ++ indent ++ scheme_of(definition_info) ++ " / "
        ++ listed_effects_text(definition_info.effects),
    ))

fn definitions_output(
  style: Style,
  places: List<SourceText>,
  tables: Tables,
  definitions: List<DefinitionInfo>,
) -> CommandOutput / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("definitions") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version)) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code)) },
      {
        key: "definitions",
        value: Array(
          definitions.map(|definition_info: DefinitionInfo|
            definition_json(places, tables, definition_info)),
        ),
      },
      { key: "diagnostics", value: Array([]) },
    ]),
    lines: text_lines(style, places, tables, definitions).push("").push(
      indent ++ count_of(definitions.len(), "definition"),
    ),
    errs: [],
    code: ok_code,
  }

pub fn run(
  flags: Flags,
) -> CommandOutput / {shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], ProjectFiles, fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], time.elapsed_ms, Derives, abort.raise, diverges} =
  match progress::silently(||
      session(flags.paths, flags.verify_dependencies, |m: Modules, _: ProgramSummary|
        view::listed(m))) {
    Err(r) -> rejected(style_of(flags), "definitions", r.diagnostics, r.places),
    Ok(opened) -> {
      let w = opened.value;
      definitions_output(
        style_of(flags),
        places_of(opened),
        tables_of(w.hashes),
        definitions_in_order(w).filter(|definition_info: DefinitionInfo|
          is_listed(flags, module_names(w.order), |i: Int| i >= w.own, definition_info)),
      )
    },
  }

fn monomorphic_definition(name: Bytes, module: Bytes, simple: Bytes) -> DefinitionInfo =
  {
    name: name,
    module: module,
    simple_name: simple,
    scheme: {
      type_variables: [],
      effect_variables: [],
      keep_variables: [],
      label_variables: [],
      ty: FunctionType({
        keep_parameters: [],
        once: false,
        params: [],
        return_type: NamedType({ name: b"Int", args: [] }),
        effects: { listed: [], variable: None },
      }),
    },
    effects: [],
    performed: [],
    undeclared: [],
    scaling: [],
    repeats: [],
    promised_bounded: [],
    variable_bounded: false,
    ending: Terminates,
    summary: unknown_summary,
    raises: [],
    effect_aliases: [],
    constraints: [],
    spec: [],
    at: { module: 0, span: span_between(20, 40) },
  }

fn flags_of(filters: List<String>) -> Flags = { ..no_flags, filters: filters }

test "only the program's own definitions are listed, and `--filter` matches the text against each definition's full name" {
  let mine = monomorphic_definition(b"m.three", b"m", b"three");
  let shipped = {
    ..monomorphic_definition(b"std.json.to_string", b"std.json", b"to_string"),
    at: { module: 1, span: span_between(20, 40) },
  };
  let pulled = |i: Int| i == 1;
  let modules = module_names([b"m", b"std.json"]);
  assert(is_listed(flags_of([]), modules, pulled, mine));
  assert(!is_listed(flags_of([]), modules, pulled, shipped));
  assert(is_listed(flags_of([]), modules, |i: Int| false, shipped));
  assert(is_listed(flags_of(["thr"]), modules, pulled, mine));
  assert(!is_listed(flags_of(["two"]), modules, pulled, mine))
}

test "a definition with no effects and no type variables prints as `() -> Int` with the effect set `{}`" {
  let d = monomorphic_definition(b"m.two", b"m", b"two");
  assert_eq(scheme_of(d), "() -> Int");
  assert_eq(listed_effects_text(d.effects), "{}")
}

test "a definitions listing starts and ends with a blank line, and its last line is the definition count" {
  let p = [{ path: "m.ply", text: b"fn two() -> Int = 1\n" }];
  let tables: Tables = {
    definitions: Map::new(),
    own: Map::new(),
    specs: Map::new(),
    hashes: no_hashes,
  };
  let result = definitions_output(style_of(flags_of([])), p, tables, [
    monomorphic_definition(b"m.two", b"m", b"two"),
  ]);
  assert_eq(result.code, 0);
  assert_eq(result.lines, [
    "",
    "     m.two  m.ply:2:1",
    "      () -> Int / {}",
    "",
    "   1 definition",
  ])
}
