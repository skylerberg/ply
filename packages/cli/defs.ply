//! `ply defs` — every definition of the program with its place, hash, signature and footprint.

import compiler.load (Derives)
import compiler.front (viewed_text)
import compiler.front.facts (pulled_at)
import compiler.unit (shipped)
import std.random (entropy)
import std.time (time)
import queried
import builder (builder)
import args (Flags, kept, no_flags, style_of)
import compiler.cc (toolchain)
import program (Program, Tables, Timed, published, tables_of, location_of, place_of, hash_of,
                own_of, deps_of, specs_of, short_of, timed_over, no_program, program_view,
                asked_line, command_kept, keep_command)
import queried (command_key)
import sources (Project, load_resolved)
import std.bin
import std.bytes
import report (Answer, schema_version, ok_code, count_of, indent, refused)
import std.term (Style, bold, dim)
import compiler.store.hash.forms (TheFn)
import compiler.store.hash (no_hashes)
import compiler.check.infer.checker (DefInfo)
import compiler.check.termination (Ends, unknown_summary)
import compiler.check.types (TyCon, TyFn, row_text, scheme_text)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, Array, Object, object, parse_string, string_or_null,
                 to_string)
import compiler.syntax.parsing (span_between)

pub fn scheme_of(def_info: DefInfo) -> String / {abort.raise} =
  String::of_bytes_lossy(scheme_text(def_info.scheme))

pub fn footprint_of(def_info: DefInfo) -> String / {abort.raise} =
  String::of_bytes_lossy(row_text({ atoms: def_info.footprint, tail: None }))

pub fn performed_of(def_info: DefInfo) -> String / {abort.raise} =
  String::of_bytes_lossy(row_text({ atoms: def_info.performed, tail: None }))

/// Whether a definition is listed: one of the load's own packages holds it, which `pulled` says of
/// none, and a `--filter` keeps it.
fn wanted(flags: Flags, pulled: (Int) -> Bool, def_info: DefInfo) -> Bool =
  !pulled(def_info.at.module) && kept(flags.filters, String::of_bytes_lossy(def_info.name))

fn file_of(p: Program, def_info: DefInfo) -> Json =
  match place_of(p, def_info.at) { Some(place) -> Str(place.path), None -> Null }

fn definition_json(program: Program, tables: Tables, def_info: DefInfo) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(String::of_bytes_lossy(def_info.name)) },
    { key: "module", value: Str(String::of_bytes_lossy(def_info.module)) },
    { key: "simple_name", value: Str(String::of_bytes_lossy(def_info.simple_name)) },
    { key: "location", value: string_or_null(location_of(program, def_info.at)) },
    { key: "file", value: file_of(program, def_info) },
    { key: "start", value: Number(Decimal::of_int(def_info.at.span.start)) },
    { key: "end", value: Number(Decimal::of_int(def_info.at.span.end)) },
    { key: "hash", value: string_or_null(hash_of(tables, def_info.name)) },
    { key: "own", value: string_or_null(own_of(tables, def_info.name)) },
    { key: "type", value: Str(scheme_of(def_info)) },
    { key: "footprint", value: Str(footprint_of(def_info)) },
    { key: "performed", value: Str(performed_of(def_info)) },
    { key: "specs", value: Number(Decimal::of_int(specs_of(tables, def_info.name))) },
    { key: "deps", value: Array(deps_of(tables, TheFn(def_info.name)).map(|n: String| Str(n))) },
  ])

fn short_or_blank(tables: Tables, def_info: DefInfo) -> String / {abort.raise} =
  match hash_of(tables, def_info.name) { Some(h) -> short_of(h), None -> "" }

fn place_or_blank(p: Program, def_info: DefInfo) -> String / {abort.raise} =
  match location_of(p, def_info.at) { Some(l) -> l, None -> "" }

fn text_lines(
  style: Style,
  program: Program,
  tables: Tables,
  defs: List<DefInfo>,
) -> List<String> / {abort.raise} =
  defs.fold([""], |acc: List<String>, def_info: DefInfo|
    acc.push(
      indent() ++ dim(style, short_or_blank(tables, def_info)) ++ "  "
        ++ bold(style, String::of_bytes_lossy(def_info.name))
        ++ "  "
        ++ dim(style, place_or_blank(program, def_info)),
    ).push(
      indent() ++ indent() ++ scheme_of(def_info) ++ " / " ++ footprint_of(def_info),
    ))

fn answered(
  style: Style,
  program: Program,
  tables: Tables,
  defs: List<DefInfo>,
) -> Answer / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("defs") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code())) },
      {
        key: "definitions",
        value: Array(defs.map(|def_info: DefInfo| definition_json(program, tables, def_info))),
      },
      { key: "diagnostics", value: Array([]) },
    ]),
    lines: text_lines(style, program, tables, defs).push("").push(
      indent() ++ count_of(defs.len(), "definition"),
    ),
    errs: [],
    code: ok_code(),
  }

/// The listing `argv` asks for, taken back where an earlier run of the same command line kept it and
/// nothing it read moved, else listed from a load and kept.
pub fn run(
  flags: Flags,
  argv: List<String>,
) -> Answer / {shipped.answer, toolchain.reused, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], time.elapsed_ms, entropy.next, time.now_ms, Derives, abort.raise, diverges, shipped.reached} = {
  let started = time.elapsed_ms();
  let project = load_resolved(flags.paths);
  let key = command_key(queried::program(), asked_line(argv, flags.paths));
  let shown = key.hex_of();
  let kept = command_kept(flags.paths, project, key);
  match kept.output {
    Some(bytes) -> match bin::decode(bytes, listing_bin()) {
      Ok(l) -> match parse_string(l.json) {
        Ok(Object(members)) ->
          {
            json: Object(
              members.insert(
                "front_end",
                object([{ key: "reused", value: Bool(true) }, { key: "key", value: Str(shown) }]),
              ),
            ),
            lines: l.lines,
            errs: l.errs,
            code: l.code,
          },
        _ -> listed_now(flags, project, started, key, kept.marks),
      },
      Err(_) -> listed_now(flags, project, started, key, kept.marks),
    },
    None -> listed_now(flags, project, started, key, kept.marks),
  }
}

/// A listing as the memo store keeps it.
type Listing = { lines: List<String>, errs: List<String>, code: Int, json: String }

derive bin for Listing

/// The listing listed from a load now, and kept under `key` as a function of what the load asked.
fn listed_now(
  flags: Flags,
  project: Project,
  started: Int,
  key: Bytes,
  marks: List<Bytes>,
) -> Answer / {shipped.answer, toolchain.reused, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], time.elapsed_ms, entropy.next, time.now_ms, Derives, abort.raise, shipped.reached} = {
  let t: Timed = timed_over(flags.paths, project, started);
  let loaded: Program = t.program;
  match program_view(loaded) {
    None -> refused(style_of(flags), "defs", loaded.diags, loaded.places),
    Some(w) -> {
      let listed = answered(
        style_of(flags),
        loaded,
        tables_of(w.frame.hashes),
        published(w).filter(|def_info: DefInfo|
          wanted(
            flags,
            |i: Int| pulled_at(w.frame.packages, w.frame.module_packages, i),
            def_info,
          )),
      );
      let answer = match listed.json {
        Object(members) ->
          {
            ..listed,
            json: Object(
              members.insert("front_end", object([{ key: "reused", value: Bool(false) }])),
            ),
          },
        _ -> listed,
      };
      let _ = keep_command(
        flags.paths,
        project,
        key,
        loaded,
        bin::encode(
          {
            lines: answer.lines,
            errs: answer.errs,
            code: answer.code,
            json: to_string(answer.json),
          },
          listing_bin(),
        ),
        marks,
      );
      answer
    },
  }
}

// --- Tests ------------------------------------------------------------------

fn nullary(name: Bytes, module: Bytes, simple: Bytes) -> DefInfo =
  {
    name: name,
    module: module,
    simple_name: simple,
    scheme: {
      ty_vars: [],
      row_vars: [],
      kept_vars: [],
      multi_vars: [],
      label_vars: [],
      ty: TyFn({
        kept: [],
        once: false,
        params: [],
        ret: TyCon({ name: b"Int", args: [] }),
        effects: { atoms: [], tail: None },
      }),
    },
    footprint: [],
    performed: [],
    scaling: [],
    repeats: [],
    bounded: [],
    tail_bounded: false,
    ending: Ends,
    summary: unknown_summary(),
    raises: [],
    row_aliases: [],
    constraints: [],
    spec: [],
    at: { module: 0, span: span_between(20, 40) },
  }

fn flags_of(filters: List<String>) -> Flags = { ..no_flags(), filters: filters }

test "only the program's own definitions are listed, and `--filter` cuts by program-wide name" {
  let mine = nullary(b"m.three", b"m", b"three");
  let shipped = {
    ..nullary(b"std.json.to_string", b"std.json", b"to_string"),
    at: { module: 1, span: span_between(20, 40) },
  };
  let pulled = |i: Int| i == 1;
  assert(wanted(flags_of([]), pulled, mine));
  assert(!wanted(flags_of([]), pulled, shipped));
  // A module named under `std` is the program's own where its load holds it, as a load of the
  // library's own checkout does.
  assert(wanted(flags_of([]), |i: Int| false, shipped));
  assert(wanted(flags_of(["thr"]), pulled, mine));
  assert(!wanted(flags_of(["two"]), pulled, mine))
}

test "a definition with no row and no variables prints the way the reference prints it" {
  let d = nullary(b"m.two", b"m", b"two");
  assert_eq(scheme_of(d), "() -> Int");
  assert_eq(footprint_of(d), "{}");
  assert_eq(performed_of(d), "{}")
}

test "a listing opens and closes with a blank line and ends on the tally" {
  let p: Program = { ..no_program(), places: [{ path: "m.ply", text: b"fn two() -> Int = 1\n" }] };
  let tables: Tables = {
    defs: Map::new(),
    own: Map::new(),
    specs: Map::new(),
    hashes: no_hashes(),
  };
  let answer = answered(style_of(flags_of([])), p, tables, [nullary(b"m.two", b"m", b"two")]);
  assert_eq(answer.code, 0);
  assert_eq(answer.lines, [
    "",
    "     m.two  m.ply:2:1",
    "      () -> Int / {}",
    "",
    "   1 definition",
  ])
}
