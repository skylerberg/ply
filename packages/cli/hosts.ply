pub type Stage = | Bound | NotBound

pub type Preview = {
  stage: Stage,
  root: String,
  handler_count: Int,
  rows: List<Row>,
  digest: String,
  transport: Option<Transport>,
  filesystem: Option<Filesystem>,
  configuration: Option<Report>,
  observability: Option<Observability>,
  shutdown: Option<Shutdown>,
  diagnostics: List<Diagnostic>,
  places: List<SourceText>,
}

pub fn yes_no(flag: Bool) -> String = if flag { "yes" } else { "no" }

fn linear_text(linear: Bool) -> String = if linear { "at-most-once" } else { "repeatable" }

fn linear_json(linear: Bool) -> String = if linear { "at_most_once" } else { "repeatable" }

fn with_member(fields: List<Member>, key: String, value: Option<Json>) -> List<Member> =
  match value { Some(j) -> fields.push({ key: key, value: j }), None -> fields }

fn map_option<a>(value: Option<a>, f: (a) -> Json) -> Option<Json> =
  match value { Some(v) -> Some(f(v)), None -> None }

fn with_lines<a | e>(
  lines: List<String>,
  value: Option<a>,
  f: (a) -> List<String> / e,
) -> List<String> / e = match value { Some(v) -> lines.concat(f(v)), None -> lines }

fn abbreviate(fingerprint: String) -> String / {abort.raise} = {
  let parts = fingerprint.split(":");
  let scheme = if parts.len() < 2 { "" } else { parts.at_or(0, "") };
  let rest = range(1, parts.len()).fold([], |accumulator: List<String>, i: Int|
    accumulator.push(parts.at_or(i, "")));
  let digits = if parts.len() < 2 { fingerprint } else { String::join(rest, ":") };
  let width = digits.len();
  let shown_width = if width < 12 { width } else { 12 };
  let short = digits.slice(0, shown_width);
  let elided = if width > 12 { "…" } else { "" };
  if scheme == "" { short ++ elided } else { scheme ++ ":" ++ short ++ elided }
}

fn headers() -> List<String> = ["OPERATION", "HANDLER", "DET", "LINEAR", "BLOCKING", "SECRETS"]

fn cells(row: Row) -> List<String> =
  [
    row.triple,
    row.handler,
    yes_no(row.deterministic),
    linear_text(row.linear),
    yes_no(row.blocking),
    yes_no(row.secrets),
  ]

fn table(rows: List<Row>) -> List<String> = text::table(prepend(headers(), rows.map(cells)))

fn empty_note(handlers: Int) -> String / {abort.raise} =
  count_of(handlers, "handler") ++ " available, but none handles an effect this program performs"

fn transport_lines(t: Transport) -> List<String> / {abort.raise} = {
  let head = [
    "",
    "transport",
    "tls  " ++ t.tls_library ++ " " ++ t.version ++ " · provider " ++ t.provider ++ " · "
      ++ String::join(t.versions, ", ")
      ++ " · alpn "
      ++ String::join(t.alpn, ", "),
    "roots  " ++ t.roots ++ " " ++ t.roots_version ++ " · " ++ t.trusted_root_count.to_string()
      ++ " trusted by `--trust`",
    "",
    "credentials",
  ];
  if t.credentials.len() == 0 {
    head.push(
      "none — `net.listen_tls` fails with E0429 until `--tls NAME=CERT,KEY` provides a TLS credential",
    )
  } else {
    let width = t.credentials.fold(0, |accumulator: Int, c: Credential|
      max(accumulator, c.name.len()));
    t.credentials.fold(head, |accumulator: List<String>, c: Credential|
      accumulator.push(
        c.name.pad_right(width, " ") ++ "  " ++ abbreviate(c.fingerprint) ++ "  "
          ++ count_of(c.certificates, "certificate"),
      ))
  }
}

fn filesystem_lines(f: Filesystem) -> List<String> =
  if f.roots.len() == 0 {
    [
      "",
      "filesystem",
      "none — an `fs` operation fails with E0451 until `--fs NAME=PATH` maps a name to a directory",
    ]
  } else {
    let width = f.roots.fold(0, |accumulator: Int, named: machine::NamedPath|
      max(accumulator, named.name.len()));
    f.roots.fold(["", "filesystem"], |accumulator: List<String>, named: machine::NamedPath|
      accumulator.push(named.name.pad_right(width, " ") ++ "  " ++ named.path))
  }

fn config_schema_line(report: Report) -> String / {abort.raise} =
  match report.schema {
    None ->
      "schema     none — without `--config-schema`, a missing key is not reported up front; each lookup of it returns `None` when the program runs",
    Some(v) ->
      "schema     " ++ v.function ++ " · " ++ count_of(v.keys.len(), "key") ++ " · "
        ++ report.resolved.to_string()
        ++ " resolved · "
        ++ report.secret.to_string()
        ++ " secret",
  }

fn configuration_lines(report: Report) -> List<String> / {abort.raise} = {
  let head = [
    "",
    "configuration",
    "sources    --set " ++ report.sets.to_string() ++ " · --config "
      ++ count_of(report.files.len(), "file")
      ++ " · environment "
      ++ report.environment.to_string()
      ++ " · defaults "
      ++ report.default_count.to_string(),
    config_schema_line(report),
  ];
  if report.resolved == 0 { head } else {
    let keys = report.keys.map(|k: ReportKey| k.name ++ "=" ++ k.value ++ " (" ++ k.source ++ ")");
    head.push("keys       " ++ String::join(keys, " · "))
  }
}

fn level_suffix(o: Observability) -> String =
  match o.level { Some(l) -> " · level " ++ l, None -> "" }

fn observability_lines(o: Observability) -> List<String> =
  [
    "",
    "observability",
    "sink       " ++ o.sink ++ " → " ++ o.destination ++ level_suffix(o),
    "channels   " ++ String::join(o.channels, " "),
    "spans      each task records its trace spans (timed units of work) on its own stack, and the stack is cleared when the task or the entry point ends",
  ]

fn shutdown_lines(t: Shutdown) -> List<String> =
  [
    "",
    "shutdown",
    "signals    " ++ String::join(t.signals, " ") ++ " · "
      ++ (match t.drain {
        Some(d) ->
          "lead " ++ d.lead_ms.to_string() ++ "ms · drain " ++ d.drain_ms.to_string()
            ++ "ms; if the program receives another of these signals, it exits at once with code 130 or 143",
        None ->
          "child processes are ended on a stop signal, and the program exits with status 130 (SIGINT) or 143 (SIGTERM)",
      }),
  ]

fn disclosure_lines(preview: Preview) -> List<String> / {abort.raise} = {
  let after_transport = with_lines([], preview.transport, transport_lines);
  let after_fs = with_lines(after_transport, preview.filesystem, filesystem_lines);
  let after_config = with_lines(after_fs, preview.configuration, configuration_lines);
  let after_trace = with_lines(after_config, preview.observability, observability_lines);
  with_lines(after_trace, preview.shutdown, shutdown_lines)
}

fn listing_lines(preview: Preview) -> List<String> / {abort.raise} = {
  let head = [
    count_of(preview.handler_count, "host handler") ++ " · "
      ++ count_of(preview.rows.len(), "operation")
      ++ " · these handlers run with full access to the host, so you must trust them",
    "",
  ];
  let body = if preview.rows.len() == 0 { head.push(empty_note(preview.handler_count)) }
  else { head.concat(table(preview.rows)) };
  body.concat(disclosure_lines(preview)).push("").push("digest: " ++ preview.digest)
}

fn row_json(row: Row) -> Json =
  object([
    { key: "effect", value: Str(row.effect) },
    { key: "operation", value: Str(row.operation) },
    { key: "resource", value: string_or_null(row.resource) },
    { key: "triple", value: Str(row.triple) },
    { key: "handler", value: Str(row.handler) },
    { key: "deterministic", value: Bool(row.deterministic) },
    { key: "linearity", value: Str(linear_json(row.linear)) },
    { key: "blocking", value: Bool(row.blocking) },
    { key: "secrets", value: Bool(row.secrets) },
    { key: "declared_nondet", value: Bool(row.declared_nondet) },
  ])

pub fn transport_json(t: Transport) -> Json =
  object([
    { key: "library", value: Str(t.tls_library) },
    { key: "version", value: Str(t.version) },
    { key: "provider", value: Str(t.provider) },
    { key: "versions", value: strings(t.versions) },
    { key: "alpn", value: strings(t.alpn) },
    {
      key: "roots",
      value: object([
        { key: "library", value: Str(t.roots) },
        { key: "version", value: Str(t.roots_version) },
        { key: "trusted", value: int(t.trusted_root_count) },
      ]),
    },
    {
      key: "credentials",
      value: Array(
        t.credentials.map(|c: Credential|
          object([
            { key: "name", value: Str(c.name) },
            { key: "fingerprint", value: Str(c.fingerprint) },
            { key: "certificates", value: int(c.certificates) },
          ])),
      ),
    },
  ])

pub fn filesystem_json(f: Filesystem) -> Json =
  object([
    {
      key: "roots",
      value: Array(
        f.roots.map(|named: machine::NamedPath|
          object([
            { key: "name", value: Str(named.name) },
            { key: "path", value: Str(named.path) },
          ])),
      ),
    },
  ])

fn observability_json(o: Observability) -> Json =
  object([
    { key: "sink", value: Str(o.sink) },
    { key: "destination", value: Str(o.destination) },
    { key: "level", value: string_or_null(o.level) },
    { key: "channels", value: strings(o.channels) },
  ])

fn shutdown_json(t: Shutdown) -> Json =
  object(
    [
      { key: "signals", value: strings(t.signals) },
      { key: "drains", value: Bool(t.drain != None) },
    ].concat(match t.drain {
      Some(d) ->
        [{ key: "lead_ms", value: int(d.lead_ms) }, { key: "drain_ms", value: int(d.drain_ms) }],
      None -> [],
    }),
  )

fn report_json(preview: Preview) -> Json / {abort.raise} = {
  let head: List<Member> = [
    { key: "command", value: Str("hosts") },
    { key: "schema_version", value: int(schema_version()) },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code()) },
    { key: "root", value: Str(preview.root) },
    { key: "handlers", value: int(preview.handler_count) },
    { key: "operations", value: int(preview.rows.len()) },
    { key: "digest", value: Str(preview.digest) },
    { key: "hosts", value: Array(preview.rows.map(row_json)) },
  ];
  let after_transport = with_member(
    head,
    "transport",
    map_option(preview.transport, transport_json),
  );
  let after_fs = with_member(
    after_transport,
    "filesystem",
    map_option(preview.filesystem, filesystem_json),
  );
  let after_config = with_member(
    after_fs,
    "configuration",
    map_option(preview.configuration, configuration::report_json),
  );
  let after_trace = with_member(
    after_config,
    "observability",
    map_option(preview.observability, observability_json),
  );
  let stopping = with_member(after_trace, "shutdown", map_option(preview.shutdown, shutdown_json));
  object(
    stopping.push({ key: "diagnostics", value: all_to_json(preview.diagnostics, preview.places) }),
  )
}

fn binding_failure(
  style: Style,
  diagnostics: List<Diagnostic>,
  places: List<SourceText>,
) -> CommandOutput / {abort.raise} = {
  let tally = indent() ++ red(style, "no host handler was bound") ++ " ("
    ++ count_of(diagnostics.len(), "error")
    ++ ")";
  {
    json: object([
      { key: "command", value: Str("hosts") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: int(compile_error()) },
      { key: "diagnostics", value: all_to_json(diagnostics, places) },
    ]),
    lines: [],
    errs: all_to_text(style, diagnostics, places).push(tally),
    code: compile_error(),
  }
}

pub fn indented(lines: List<String>) -> List<String> =
  lines.map(|l: String| if l == "" { "" } else { indent() ++ l })

fn text_lines(preview: Preview) -> List<String> / {abort.raise} =
  [""].concat(indented(listing_lines(preview)))

fn hosts_output(style: Style, flags: Flags, preview: Preview) -> CommandOutput / {abort.raise} = {
  let lines = if flags.digest { [preview.digest] } else { text_lines(preview) };
  let errs = if flags.digest { [] }
  else { all_to_text(style, preview.diagnostics, preview.places) };
  { json: report_json(preview), lines: lines, errs: errs, code: ok_code() }
}

fn preview_output(style: Style, flags: Flags, p: Preview) -> CommandOutput / {abort.raise} =
  match p.stage {
    NotBound -> binding_failure(style, p.diagnostics, p.places),
    Bound -> hosts_output(style, flags, p),
  }

pub fn run(
  flags: Flags,
  options: machine::Options,
) -> CommandOutput / {shipped.read_pack, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, entering::machine.open, entering::machine.enter, entering::machine.close, entering::machine.hosting, env.variables, env.working_directory, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.compiled, Derives, abort.raise, diverges, shipped.report_view_used} = {
  let s: Style = style_of(flags);
  let t: TimedLoad = timed_uncached(flags.paths, flags.verify_dependencies);
  match program_view(t.program) {
    None -> rejected(s, "hosts", t.program.diagnostics, t.program.source_texts),
    Some(w) -> match config_schema::schema_error(w, options.config.schema) {
      Some(d) -> binding_failure(s, [d], t.program.source_texts),
      None -> bind_and_preview(s, flags, options, loaded_analysis(t, w), t.program.source_texts),
    },
  }
}

fn bind_and_preview(
  style: Style,
  flags: Flags,
  options: machine::Options,
  front: LoadedAnalysis,
  places: List<SourceText>,
) -> CommandOutput / {entering::machine.open, entering::machine.enter, entering::machine.close, entering::machine.hosting, env.variables, env.working_directory, fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.read_file[cwd], fs.read_file[abs], emit.unit, emit.compiled, abort.raise} =
  match configuration::resolve_configuration(options.config, |name: String|
      configuration::evaluate_schema(front, options.profile, name)) {
    Err(diagnostics) -> binding_failure(style, diagnostics, places),
    Ok(r) ->
      preview_output(style, flags, preview_of(root_of(flags).machine, options, front, r, places)),
  }

fn preview_of(
  path: String,
  options: machine::Options,
  front: LoadedAnalysis,
  resolution: Resolution,
  places: List<SourceText>,
) -> Preview / {entering::machine.hosting, abort.raise} = {
  let configured = configuration::run_configuration(resolution.configuration);
  let hosting = entering::machine.hosting({
    ..entering::no_grants(),
    fs: options.fs.map(machine::granted_path),
    allow: options.allow,
    given: machine::grant_entries(options.tls, options.trust, options.mtls, configured).push({
      name: "trace",
      fields: [options.trace.sink, options.trace.level],
    }),
  });
  let base: Preview = {
    stage: Bound,
    root: machine::project_root(path),
    handler_count: 0,
    rows: [],
    digest: "",
    transport: None,
    filesystem: None,
    configuration: if configuration::has_input(resolution.configuration) {
      Some(configuration::report(resolution.configuration))
    } else { None },
    observability: None,
    shutdown: None,
    diagnostics: resolution.warnings,
    places: places,
  };
  let declared = host_listing::declared_of(front.dump);
  let rejected = match host_listing::allow_error(options.allow, declared) {
    Some(d) -> [d],
    None -> hosting.rejections.map(machine::unplaced),
  };
  if rejected.len() > 0 {
    { ..base, stage: NotBound, diagnostics: base.diagnostics.concat(rejected) }
  } else {
    let l = host_listing::listing_of(declared, host_listing::performed_effects(front.dump));
    let d = host_listing::host_settings_of(
      l,
      hosting,
      configured,
      Some({ lead_ms: options.drain_lead_ms, drain_ms: options.drain_ms }),
    );
    {
      ..base,
      handler_count: l.handlers,
      rows: l.rows,
      digest: host_listing::digest_of(l, d),
      transport: d.transport,
      filesystem: d.filesystem,
      observability: d.observability,
      shutdown: d.shutdown,
    }
  }
}

fn a_row(triple: String, handler: String, linear: Bool, blocking: Bool) -> Row =
  {
    effect: "db",
    operation: "get",
    resource: Some("users"),
    triple: triple,
    handler: handler,
    deterministic: false,
    linear: linear,
    blocking: blocking,
    secrets: false,
    declared_nondet: true,
  }

fn empty_preview() -> Preview =
  {
    stage: Bound,
    root: "/p",
    handler_count: 0,
    rows: [],
    digest: "b3:000000000000",
    transport: None,
    filesystem: None,
    configuration: None,
    observability: None,
    shutdown: None,
    diagnostics: [],
    places: [],
  }

fn listed_preview() -> Preview =
  {
    ..empty_preview(),
    handler_count: 3,
    rows: [
      a_row("clock.now", "std.internal.schedule.clocked", false, false),
      a_row("db.get[orders]", "ply_host::postgres::read", true, true),
      a_row("db.get[users]", "ply_host::postgres::read", true, true),
      a_row("db.put[orders]", "ply_host::postgres::write", true, true),
    ],
    digest: "b3:1f2e3d4c5b6a",
  }

fn flags_of(json: Bool, digest: Bool) -> Flags = { ..no_flags(), json: json, digest: digest }

fn first(lines: List<String>, n: Int) -> List<String> =
  range(0, n).fold([], |accumulator: List<String>, i: Int| accumulator.push(lines.at_or(i, "")))

fn plain_preview_output(preview: Preview, flags: Flags) -> CommandOutput / {abort.raise} =
  preview_output(plain(), flags, preview)

test "the host handler listing prints a header, a table of operation, handler, determinism, linearity, blocking and secrets columns, and a final checksum line" {
  let lines = listing_lines(listed_preview());
  assert_eq(
    String::join(first(lines, lines.len() - 2), "\n"),
    "3 host handlers · 4 operations · these handlers run with full access to the host, so you must trust them\n"
      ++ "\n"
      ++ "OPERATION       HANDLER                        DET  LINEAR        BLOCKING  SECRETS\n"
      ++ "clock.now       std.internal.schedule.clocked  no   repeatable    no        no\n"
      ++ "db.get[orders]  ply_host::postgres::read       no   at-most-once  yes       no\n"
      ++ "db.get[users]   ply_host::postgres::read       no   at-most-once  yes       no\n"
      ++ "db.put[orders]  ply_host::postgres::write      no   at-most-once  yes       no",
  );
  assert_eq(lines.at_or(lines.len() - 1, ""), "digest: b3:1f2e3d4c5b6a")
}

test "an empty listing says it is empty rather than printing nothing" {
  assert(
    String::join(listing_lines(empty_preview()), "\n").contains(
      "0 handlers available, but none handles an effect this program performs",
    ),
  );
  let idle: Preview = { ..empty_preview(), handler_count: 2 };
  assert_eq(
    listing_lines(idle).at_or(2, ""),
    "2 handlers available, but none handles an effect this program performs",
  )
}

test "a fingerprint is abbreviated for the table and never for the object" {
  assert_eq(abbreviate("sha256:9f2c1a4e8b03c7d5e6f70819a2b3c4d5"), "sha256:9f2c1a4e8b03…");
  assert_eq(abbreviate("sha256:9f2c"), "sha256:9f2c");
  assert_eq(abbreviate("9f2c1a4e8b03c7d5"), "9f2c1a4e8b03…")
}

test "`transport_lines` names the TLS library, versions and root certificates, and lists each credential or says none is configured" {
  let t: Transport = {
    tls_library: "rustls",
    version: "0.23.43",
    provider: "ring",
    versions: ["TLS 1.3", "TLS 1.2"],
    alpn: ["http/1.1"],
    roots: "webpki-roots",
    roots_version: "1.0.9",
    trusted_root_count: 0,
    credentials: [],
  };
  assert_eq(transport_lines(t), [
    "",
    "transport",
    "tls  rustls 0.23.43 · provider ring · TLS 1.3, TLS 1.2 · alpn http/1.1",
    "roots  webpki-roots 1.0.9 · 0 trusted by `--trust`",
    "",
    "credentials",
    "none — `net.listen_tls` fails with E0429 until `--tls NAME=CERT,KEY` provides a TLS credential",
  ]);
  let named: Transport = {
    ..t,
    credentials: [
      { name: "api", fingerprint: "sha256:9f2c1a4e8b03c7d5e6f70819a2b3c4d5", certificates: 2 },
    ],
  };
  assert_eq(transport_lines(named).at_or(6, ""), "api  sha256:9f2c1a4e8b03…  2 certificates")
}

test "`filesystem_lines` lists each `--fs` name and path, and says so when no filesystem path is configured" {
  assert_eq(filesystem_lines({ roots: [] }), [
    "",
    "filesystem",
    "none — an `fs` operation fails with E0451 until `--fs NAME=PATH` maps a name to a directory",
  ]);
  assert_eq(
    filesystem_lines({
      roots: [{ name: "src", path: "/p/crates" }, { name: "tmp", path: "/p/t" }],
    }),
    ["", "filesystem", "src  /p/crates", "tmp  /p/t"],
  )
}

test "`observability_lines` shows the trace output and its destination, and shows no level when the output discards traces" {
  assert_eq(
    observability_lines({
      sink: "ply_host::trace::discard",
      destination: "nothing",
      level: None,
      channels: ["app"],
    }),
    [
      "",
      "observability",
      "sink       ply_host::trace::discard → nothing",
      "channels   app",
      "spans      each task records its trace spans (timed units of work) on its own stack, and the stack is cleared when the task or the entry point ends",
    ],
  );
  assert_eq(
    observability_lines({
      sink: "ply_host::trace::json",
      destination: "stderr",
      level: Some("info"),
      channels: ["app", "db"],
    }).at_or(
      2,
      "",
    ),
    "sink       ply_host::trace::json → stderr · level info",
  )
}

test "`shutdown_lines` lists the lead and drain times and says a second signal exits, or says child processes are ended when nothing drains" {
  let signals = ["SIGINT", "SIGTERM"];
  assert_eq(
    shutdown_lines({ signals: signals, drain: Some({ lead_ms: 250, drain_ms: 15000 }) }).at_or(
      2,
      "",
    ),
    "signals    SIGINT SIGTERM · lead 250ms · drain 15000ms; if the program receives another of these signals, it exits at once with code 130 or 143",
  );
  assert_eq(
    shutdown_lines({ signals: signals, drain: None }).at_or(2, ""),
    "signals    SIGINT SIGTERM · child processes are ended on a stop signal, and the program exits with status 130 (SIGINT) or 143 (SIGTERM)",
  )
}

test "the configuration block counts its sources and never prints a secret's value" {
  let c: Report = {
    sets: 1,
    files: ["deploy.env"],
    environment: 40,
    default_count: 1,
    schema: Some({
      function: "service.config",
      keys: [{ name: "port", shape: "SInt" }, { name: "token", shape: "SSecret" }],
    }),
    resolved: 2,
    secret: 1,
    keys: [
      { name: "port", value: "8137", source: "--set", secret: false },
      { name: "token", value: "****", source: "deploy.env", secret: true },
    ],
  };
  let lines = configuration_lines(c);
  assert_eq(
    lines.at_or(2, ""),
    "sources    --set 1 · --config 1 file · environment 40 · defaults 1",
  );
  assert_eq(lines.at_or(3, ""), "schema     service.config · 2 keys · 2 resolved · 1 secret");
  assert_eq(lines.at_or(4, ""), "keys       port=8137 (--set) · token=**** (deploy.env)");
  assert(!String::join(lines, "\n").contains("hunter2"))
}

test "the listing opens on a blank line and every other line is indented" {
  let result = plain_preview_output(listed_preview(), flags_of(false, false));
  assert_eq(result.code, 0);
  assert_eq(result.lines.at_or(0, "?"), "");
  assert_eq(
    result.lines.at_or(1, ""),
    indent()
      ++ "3 host handlers · 4 operations · these handlers run with full access to the host, so you must trust them",
  );
  assert_eq(result.lines.at_or(2, "?"), "");
  assert_eq(result.lines.at_or(result.lines.len() - 1, ""), indent() ++ "digest: b3:1f2e3d4c5b6a")
}

test "`--digest` prints only the digest line, so a CI check can compare it with a fixed value" {
  let result = plain_preview_output(listed_preview(), flags_of(false, true));
  assert_eq(result.lines, ["b3:1f2e3d4c5b6a"]);
  assert_eq(result.errs, []);
  assert_eq(result.code, 0)
}

test "the JSON output contains `command`, `exit_code`, the operation and handler counts, and the digest" {
  let text = to_string(plain_preview_output(listed_preview(), flags_of(true, false)).json);
  assert(text.contains("\"command\":\"hosts\""));
  assert(text.contains("\"exit_code\":0"));
  assert(text.contains("\"operations\":4"));
  assert(text.contains("\"handlers\":3"));
  assert(text.contains("\"linearity\":\"at_most_once\""));
  assert(text.contains("\"digest\":\"b3:1f2e3d4c5b6a\""))
}

test "a host binding that fails to resolve exits with code 2 and prints the error followed by an error count" {
  let rejection: Diagnostic = {
    code: b"E0454",
    notes: 0,
    labels: [],
    text: b"",
    message: b"`--fs src=./x` does not resolve",
    notes_text: [],
    severity: b"error",
    fixes: [],
  };
  let rejected: Preview = { ..empty_preview(), stage: NotBound, diagnostics: [rejection] };
  let result = plain_preview_output(rejected, flags_of(false, false));
  assert_eq(result.code, 2);
  assert_eq(result.lines, []);
  assert_eq(result.errs, [
    "Error[E0454]: `--fs src=./x` does not resolve",
    indent() ++ "no host handler was bound (1 error)",
  ])
}
