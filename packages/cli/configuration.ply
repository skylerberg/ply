import compiler.cc
import compiler.check.resolve.tables (Diagnostic, error_at)
import compiler.front.rows (ModuleSpan)
import compiler.load (LoadedAnalysis)
import diagnostic (diagnostic_of, shown)
import std.env (env)
import machine
import machine (ConfigOptions, RunConfiguration)
import std.machine as entering
import units
import units (emit)
import paths
import report (count_of)
import std.config (Key, Shape, SText, SInt, SBool, SSecret, optional)
import std.fs (fs)
import std.ini
import std.json (Json, Null, Str, Bool, Number, Array, object, to_string)
import std.list
import std.result
import std.string
import std.value (Value, VRecord, VList, VStr, VCtor, VBool, Field)
import std.bytes (is_digit, is_letter)
import std.json
import proof.obligation (plural)
import compiler.syntax.parsing (no_module, dummy_span)

pub type Source = | BySet | ByFile(String) | ByEnvironment | ByDefault

pub type SuppliedValue = { value: String, source: Source }

pub type Sources = {
  supplied: Map<String, SuppliedValue>,
  sets: Int,
  files: List<String>,
  environment: Int,
}

pub type ResolvedValue = { value: String, source: Source, shape: Option<Shape> }

pub type Schema = { function: String, keys: List<Key> }

pub type Configuration = {
  values: Map<String, ResolvedValue>,
  schema: Option<Schema>,
  sets: Int,
  files: List<String>,
  environment: Int,
}

pub type Resolution = { configuration: Configuration, warnings: List<Diagnostic> }

pub fn closed_configuration() -> Configuration =
  { values: Map::new(), schema: None, sets: 0, files: [], environment: 0 }

pub fn opened(configuration: Configuration) -> Bool =
  configuration.schema != None || configuration.environment > 0 || configuration.sets > 0
    || configuration.files.len() > 0

pub fn shape_word(s: Shape) -> String =
  match s { SText -> "SText", SInt -> "SInt", SBool -> "SBool", SSecret -> "SSecret" }

pub fn source_word(source: Source) -> String =
  match source {
    BySet -> "--set",
    ByFile(path) -> path,
    ByEnvironment -> "env",
    ByDefault -> "default",
  }

fn source_text(source: Source) -> String =
  match source {
    BySet -> "--set",
    ByFile(path) -> "--config " ++ path,
    ByEnvironment -> "the process environment",
    ByDefault -> "the schema's default",
  }

fn is_explicit(source: Source) -> Bool =
  match source { BySet -> true, ByFile(_) -> true, _ -> false }

fn is_secret(shape: Option<Shape>) -> Bool = shape == Some(SSecret)

pub fn redacted() -> String = "****"

fn error(code: Bytes, message: String, label: String, notes: List<String>) -> Diagnostic =
  error_at(
    code,
    no_module(),
    dummy_span(),
    Bytes::of_string(message),
    Bytes::of_string(label),
    notes.map(Bytes::of_string),
  )

fn configuration_error(message: String, label: String, notes: List<String>) -> Diagnostic =
  error(b"E0440", message, label, notes)

fn char_of(c: Int) -> String / {abort.raise} =
  match String::of_code_points([c]) { Some(t) -> t, None -> "?" }

fn key_error(key: String) -> Option<String> / {abort.raise} =
  match key.code_points() {
    [] -> Some("it has an empty key"),
    [first, ..rest] -> if !(is_letter(first) || first == 95) {
      Some(
        "`" ++ key ++ "` starts with `" ++ char_of(first)
          ++ "`, and a key starts with a letter or `_`",
      )
    } else {
      match rest.filter(|c: Int| !(is_letter(c) || is_digit(c) || c == 95 || c == 46)) {
        [] -> None,
        [bad, ..others] ->
          Some(
            "`" ++ key ++ "` contains `" ++ char_of(bad)
              ++ "`, and a key is letters, digits, `_` and `.`",
          ),
      }
    },
  }

fn trimmed(text: String, drop: List<Int>) -> String / {abort.raise} = {
  let b = Bytes::of_string(text);
  let dropped = |i: Int| drop.fold(false, |hit: Bool, d: Int| hit || b.at(i) == d);
  let start = iterate(0, b.len() + 1, |i: Int|
    if i < b.len() && dropped(i) { Continue(i + 1) } else { Stop(i) });
  let end = iterate(b.len(), b.len() + 1, |j: Int|
    if j > start && dropped(j - 1) { Continue(j - 1) } else { Stop(j) });
  String::of_bytes(b.slice(start, end))
}

fn ini_options() -> ini::Options = { ..ini::defaults(), semicolon: false }

fn parse_line(
  line: String,
) -> Result<Option<{ key: String, value: String }>, String> / {abort.raise} = {
  let read = try { ini::line(line, 1, ini_options()) };
  match read {
    Err(rejection) -> Err(pair_error(rejection.reason)),
    Ok(l) -> match l.what {
      ini::Entry(e) -> match key_error(e.key) {
        Some(reason) -> Err(reason),
        None -> Ok(Some({ key: e.key, value: match e.value { Some(v) -> v, None -> "" } })),
      },
      ini::Header(_) -> Err(pair_error(ini::BadHeader)),
      _ -> Ok(None),
    },
  }
}

fn pair_error(reason: ini::ErrorKind) -> String =
  match reason {
    ini::NoKey -> "it has an empty key",
    ini::BadHeader -> "it opens a `[section]`, and this configuration has none",
    _ -> "it has no `=`",
  }

fn unreadable(path: String, reason: Option<String>) -> Diagnostic =
  configuration_error(
    "`--config " ++ path ++ "` could not be read"
      ++ (match reason { Some(w) -> ": " ++ w, None -> "" }),
    "this file is the run's configuration",
    [
      "the file is `KEY=VALUE`, one per line, with `#` comments and no quoting",
      "correct the path, or drop the `--config` and supply the keys with `--set KEY=VALUE`",
    ],
  )

fn bad_line(path: String, number: Int, line: String, reason: String) -> Diagnostic / {abort.raise} =
  configuration_error(
    "`" ++ path ++ "` line " ++ number.to_string() ++ " is not `KEY=VALUE`: " ++ reason,
    "this line is the run's configuration",
    [
      "the line reads `" ++ trimmed(line, [32, 9, 13, 10]) ++ "`",
      "a key is letters, digits, `_` and `.`, starting with a letter or `_`; the value is the rest of the line",
      "a whole-line `#` is a comment; a `#` after the `=` is part of the value, because there is no quoting to escape it with",
    ],
  )

fn bad_set(argument: String, reason: String) -> Diagnostic =
  configuration_error(
    "`--set " ++ argument ++ "` is not `KEY=VALUE`: " ++ reason,
    "this argument is the run's configuration",
    ["write `--set KEY=VALUE`, once per key; the last `--set` of a key wins"],
  )

pub type ConfigFile = { path: String, text: Option<Bytes> }

type SuppliedValues = { supplied: Map<String, SuppliedValue>, diagnostics: List<Diagnostic> }

fn add_file_values(gathered: SuppliedValues, f: ConfigFile) -> SuppliedValues / {abort.raise} =
  match f.text {
    None -> { ..gathered, diagnostics: gathered.diagnostics.push(unreadable(f.path, None)) },
    Some(b) -> if !b.is_utf8() {
      {
        ..gathered,
        diagnostics: gathered.diagnostics.push(unreadable(f.path, Some("it is not UTF-8"))),
      }
    } else {
      let ls = String::of_bytes(b).lines();
      range(0, ls.len()).fold(gathered, |acc: SuppliedValues, i: Int| {
        let line = match ls.at(i) { Some(l) -> l, None -> "" };
        match parse_line(line) {
          Ok(None) -> acc,
          Ok(Some(key_value)) ->
            {
              ..acc,
              supplied: acc.supplied.insert(key_value.key, {
                value: key_value.value,
                source: ByFile(f.path),
              }),
            },
          Err(reason) ->
            { ..acc, diagnostics: acc.diagnostics.push(bad_line(f.path, i + 1, line, reason)) },
        }
      })
    },
  }

pub fn sources_of(
  sets: List<String>,
  files: List<ConfigFile>,
  environment: List<{ name: String, value: String }>,
) -> Result<Sources, List<Diagnostic>> / {abort.raise} = {
  let from_env = environment.fold(
    Map::new(),
    |m: Map<String, SuppliedValue>, v: { name: String, value: String }|
      if key_error(v.name) == None { m.insert(v.name, { value: v.value, source: ByEnvironment }) }
      else { m },
  );
  let from_files = files.fold({ supplied: from_env, diagnostics: [] }, add_file_values);
  let all = sets.fold(from_files, |acc: SuppliedValues, argument: String|
    match parse_line(argument) {
      Ok(Some(key_value)) ->
        {
          ..acc,
          supplied: acc.supplied.insert(key_value.key, { value: key_value.value, source: BySet }),
        },
      Ok(None) ->
        { ..acc, diagnostics: acc.diagnostics.push(bad_set(argument, "it supplies no key")) },
      Err(reason) -> { ..acc, diagnostics: acc.diagnostics.push(bad_set(argument, reason)) },
    });
  if all.diagnostics.len() > 0 { Err(all.diagnostics) } else {
    Ok({
      supplied: all.supplied,
      sets: sets.len(),
      files: files.map(|f: ConfigFile| f.path),
      environment: environment.len(),
    })
  }
}

fn malformed(function: String, reason: String) -> Diagnostic =
  configuration_error(
    "`--config-schema " ++ function ++ "` returned something that is not a `ConfigSpec`: " ++ reason,
    "this value decides what the run requires of its configuration",
    [
      "a `ConfigSpec` is `{keys: List<Key>}`, and a `Key` is `{name, shape, required, default}`",
      "build it with `std.config`'s `spec`, `required`, `optional` and `with_default`",
    ],
  )

fn field(fields: List<Field>, name: String) -> Option<Value> =
  fields.fold(None, |found: Option<Value>, f: Field|
    match found { Some(_) -> found, None -> if f.name == name { Some(f.value) } else { None } })

fn shape_of(ctor: String) -> Option<Shape> =
  if ctor == "std.config.SText" { Some(SText) }
  else if ctor == "std.config.SInt" { Some(SInt) }
  else if ctor == "std.config.SBool" { Some(SBool) }
  else if ctor == "std.config.SSecret" { Some(SSecret) }
  else { None }

fn key_of(value: Value, function: String) -> Result<Key, Diagnostic> =
  match value {
    VRecord(fields) -> match field(fields, "name") {
      Some(VStr(name)) -> match field(fields, "shape") {
        Some(VCtor(ctor, _)) -> match shape_of(ctor) {
          None ->
            Err(
              malformed(
                function,
                "`" ++ name ++ "` has the shape `" ++ ctor
                  ++ "`, which is not one of `std.config`'s",
              ),
            ),
          Some(shape) -> match field(fields, "required") {
            Some(VBool(required)) -> match field(fields, "default") {
              Some(VCtor("None", [])) ->
                Ok({ name: name, shape: shape, required: required, default: None }),
              Some(VCtor("Some", [VStr(text)])) ->
                Ok({ name: name, shape: shape, required: required, default: Some(text) }),
              Some(VCtor("Some", _)) ->
                Err(malformed(function, "`" ++ name ++ "`'s default is not a string")),
              _ -> Err(malformed(function, "`" ++ name ++ "` has no `default`")),
            },
            _ -> Err(malformed(function, "`" ++ name ++ "` has no `required` flag")),
          },
        },
        _ -> Err(malformed(function, "`" ++ name ++ "` has no `shape`")),
      },
      _ -> Err(malformed(function, "a key has no `name` string")),
    },
    _ -> Err(malformed(function, "a key in `keys` is not a record")),
  }

fn duplicate_key_error(name: String) -> Diagnostic =
  configuration_error(
    "the configuration schema declares `" ++ name ++ "` twice",
    "a key is declared once or the run cannot resolve it",
    [
      "two declarations of one key may disagree about its shape, and which one applied would depend on the order the schema function built its list in",
      "remove the duplicate from the `ConfigSpec`",
    ],
  )

fn check_unique_keys(keys: List<Key>) -> Option<Diagnostic> = {
  let walked = keys.fold(
    { seen: Map::new(), dup: None },
    |acc: { seen: Map<String, Bool>, dup: Option<String> }, k: Key|
      match acc.dup {
        Some(_) -> acc,
        None -> if acc.seen.contains(k.name) { { ..acc, dup: Some(k.name) } }
        else { { ..acc, seen: acc.seen.insert(k.name, true) } },
      },
  );
  match walked.dup { Some(name) -> Some(duplicate_key_error(name)), None -> None }
}

pub fn schema_of(value: Value, function: String) -> Result<Schema, Diagnostic> =
  match value {
    VRecord(fields) -> match field(fields, "keys") {
      Some(VList(items)) -> match Result::traverse(items, |item: Value| key_of(item, function)) {
        Err(d) -> Err(d),
        Ok(ks) -> match check_unique_keys(ks) {
          Some(d) -> Err(d),
          None -> Ok({ function: function, keys: ks }),
        },
      },
      _ -> Err(malformed(function, "it has no `keys` list")),
    },
    _ -> Err(malformed(function, "it is not a record")),
  }

fn shape_error(shape: Shape, value: String) -> Option<String> / {abort.raise} =
  match shape {
    SText -> None,
    SInt -> match value.int_of_string() { Some(_) -> None, None -> Some("is not an `Int`") },
    SBool -> if value == "true" || value == "false" { None }
    else { Some("is neither `true` nor `false`") },
    SSecret -> if value == "" { Some("is empty, and an empty credential is an unset one") }
    else { None },
  }

fn missing(k: Key, sources: Sources) -> Diagnostic / {abort.raise} = {
  let files = if sources.files.len() == 0 { "no `--config` file" } else {
    "the `--config` " ++ plural(sources.files.len(), "file") ++ " "
      ++ String::join(sources.files.map(|f: String| "`" ++ f ++ "`"), ", ")
  };
  error(
    b"E0441",
    "the configuration schema requires `" ++ k.name ++ "` (`" ++ shape_word(k.shape)
      ++ "`) and nothing supplies it",
    "this key is the run's configuration",
    [
      "the run looked in: " ++ sources.sets.to_string() ++ " `--set` "
        ++ plural(sources.sets, "argument")
        ++ ", "
        ++ files
        ++ ", "
        ++ sources.environment.to_string()
        ++ " environment "
        ++ plural(sources.environment, "variable")
        ++ ", and the schema's own default",
      "supply it with `--set " ++ k.name ++ "=...`, put it in a `--config` file, or export it",
      "this is refused before anything is bound: a service that discovers a key is missing on its first request has already told a client it was listening",
    ],
  )
}

fn invalid(k: Key, r: ResolvedValue, reason: String) -> Diagnostic =
  error(
    b"E0442",
    "`" ++ k.name ++ "` is declared `" ++ shape_word(k.shape) ++ "` and " ++ source_text(r.source)
      ++ " supplied a value that "
      ++ reason,
    "this value is the run's configuration",
    [
      if k.shape == SSecret {
        "the value is not printed, because a diagnostic's message reaches stderr, `--json` and a cached failure report"
      } else { "the value is `" ++ r.value ++ "`" },
      "change what " ++ source_text(r.source) ++ " supplies, or declare `" ++ k.name
        ++ "` with a shape it satisfies",
    ],
  )

fn undeclared(key: String, source: Source, schema: Schema) -> Diagnostic = {
  let names = schema.keys.map(|k: Key| k.name).sort();
  let declared = if names.len() == 0 { "the schema declares no keys at all" }
  else { "the schema declares: " ++ String::join(names, ", ") };
  let d = error(
    b"W0607",
    source_text(source) ++ " supplies `" ++ key
      ++ "`, which the configuration schema does not declare",
    "nothing in this program reads this key",
    [
      declared,
      "only `--set` and `--config` are checked: an environment is full of names that have nothing to do with this program",
    ],
  );
  { ..d, severity: b"warning" }
}

type ResolveState = { values: Map<String, ResolvedValue>, diagnostics: List<Diagnostic> }

fn resolve_key(acc: ResolveState, sources: Sources, k: Key) -> ResolveState / {abort.raise} = {
  let found: Option<ResolvedValue> = match sources.supplied.get(k.name) {
    Some(sup) -> Some({ value: sup.value, source: sup.source, shape: Some(k.shape) }),
    None -> match k.default {
      Some(d) -> Some({ value: d, source: ByDefault, shape: Some(k.shape) }),
      None -> None,
    },
  };
  match found {
    None -> if k.required { { ..acc, diagnostics: acc.diagnostics.push(missing(k, sources)) } }
    else { acc },
    Some(r) -> match shape_error(k.shape, r.value) {
      Some(reason) -> { ..acc, diagnostics: acc.diagnostics.push(invalid(k, r, reason)) },
      None -> { ..acc, values: acc.values.insert(k.name, r) },
    },
  }
}

pub fn resolved(
  sources: Sources,
  schema: Option<Schema>,
) -> Result<Resolution, List<Diagnostic>> / {abort.raise} = {
  let supplied = sources.supplied.fold(
    Map::new(),
    |m: Map<String, ResolvedValue>, key: String, sup: SuppliedValue|
      m.insert(key, { value: sup.value, source: sup.source, shape: None }),
  );
  let walked = match schema {
    None -> { values: supplied, diagnostics: [] },
    Some(sc) ->
      sc.keys.fold({ values: supplied, diagnostics: [] }, |acc: ResolveState, k: Key|
        resolve_key(acc, sources, k)),
  };
  let warnings = match schema {
    None -> [],
    Some(sc) -> {
      let declared = sc.keys.fold(Map::new(), |m: Map<String, Bool>, k: Key|
        m.insert(k.name, true));
      sources.supplied.fold([], |diagnostics: List<Diagnostic>, key: String, sup: SuppliedValue|
        if is_explicit(sup.source) && !declared.contains(key) {
          diagnostics.push(undeclared(key, sup.source, sc))
        } else { diagnostics })
    },
  };
  if walked.diagnostics.len() > 0 { Err(walked.diagnostics) } else {
    Ok({
      configuration: {
        values: walked.values,
        schema: schema,
        sets: sources.sets,
        files: sources.files,
        environment: sources.environment,
      },
      warnings: warnings,
    })
  }
}

pub fn supplied(
  flags: ConfigOptions,
) -> RunConfiguration / {abort.raise, env.variables, env.working_directory, fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.read_file[cwd], fs.read_file[abs]} =
  match resolve_configuration({ ..flags, schema: None }, |name: String| Err([])) {
    Ok(r) -> run_configuration(r.configuration),
    Err(_) -> machine::empty_configuration(),
  }

pub fn resolve_configuration<| e>(
  flags: ConfigOptions,
  evaluated: (String) -> Result<Value, List<Diagnostic>> / e,
) -> Result<Resolution, List<Diagnostic>> / {abort.raise, env.variables, env.working_directory, fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.read_file[cwd], fs.read_file[abs] | e} = {
  let files = flags.files.map(|path: String|
    { path: path, text: paths::read_file(paths::rooted(paths::resolve(path))) });
  match sources_of(flags.set, files, env.variables()) {
    Err(diagnostics) -> Err(diagnostics),
    Ok(sources) -> match flags.schema {
      None -> resolved(sources, None),
      Some(function) -> match evaluated(function) {
        Err(diagnostics) -> Err(diagnostics),
        Ok(v) -> match schema_of(v, function) {
          Err(d) -> Err([d]),
          Ok(schema) -> resolved(sources, Some(schema)),
        },
      },
    },
  }
}

pub fn evaluate_schema(
  front: LoadedAnalysis,
  profile: cc::Profile,
  name: String,
) -> Result<Value, List<Diagnostic>> / {entering::machine.open, entering::machine.enter, entering::machine.close, emit.unit, emit.compiled, abort.raise} =
  match units::whole_library(front, profile) {
    Err(diagnostics) -> Err(diagnostics),
    Ok(library) -> match entering::machine.open(library) {
      Err(reason) -> Err([machine::unit_load_error(reason)]),
      Ok(opened) -> {
        let entered = evaluate_schema_on_unit(opened.unit, machine::roots_of(front.dump), name);
        entering::machine.close(opened.unit);
        entered
      },
    },
  }

pub fn evaluate_schema_on_unit(
  unit: Int,
  roots: Map<Bytes, ModuleSpan>,
  name: String,
) -> Result<Value, List<Diagnostic>> / {entering::machine.enter, abort.raise} = {
  let o = entering::machine.enter(unit, name, machine::arguments_of([]), machine::evaluation_run());
  match o.ended {
    entering::NoRoot ->
      Err([
        diagnostic_of(
          "error",
          "E0440",
          "`--config-schema " ++ name ++ "` names no definition in this program",
          [],
          ["an artifact carries a schema only when `ply build --config-schema` shipped it"],
        ),
      ]),
    _ -> match machine::result_of(o, roots, name) {
      Ok(v) -> Ok(v),
      Err(raised) ->
        Err([
          diagnostic_of(
            "error",
            "E0440",
            "`--config-schema " ++ name ++ "` could not be evaluated: "
              ++ String::of_bytes_lossy(shown(raised).message),
            [],
            [
              "it is called once, before anything is bound, and a run that cannot compute its schema does not know whether it is configured",
            ],
          ),
        ]),
    },
  }
}

pub fn run_configuration(configuration: Configuration) -> RunConfiguration =
  {
    values: configuration.values.fold(
      [],
      |acc: List<{ key: String, value: String, secret: Bool }>, key: String, r: ResolvedValue|
        acc.push({ key: key, value: r.value, secret: is_secret(r.shape) }),
    ),
    schema: match configuration.schema {
      None -> None,
      Some(sc) ->
        Some({
          function: sc.function,
          keys: sc.keys.map(|k: Key| { name: k.name, shape: shape_word(k.shape) }),
        }),
    },
    opened: opened(configuration),
  }

pub type ReportKey = { name: String, value: String, source: String, secret: Bool }

pub type KeyShape = { name: String, shape: String }

pub type ReportSchema = { function: String, keys: List<KeyShape> }

pub type Report = {
  sets: Int,
  files: List<String>,
  environment: Int,
  defaults: Int,
  schema: Option<ReportSchema>,
  resolved: Int,
  secret: Int,
  keys: List<ReportKey>,
}

pub fn report(configuration: Configuration) -> Report = {
  let declared = configuration.values.fold(
    [],
    |acc: List<ReportKey>, key: String, r: ResolvedValue|
      match r.shape {
        None -> acc,
        Some(shape) ->
          acc.push({
            name: key,
            value: if shape == SSecret { redacted() } else { r.value },
            source: source_word(r.source),
            secret: shape == SSecret,
          }),
      },
  );
  {
    sets: configuration.sets,
    files: configuration.files,
    environment: configuration.environment,
    defaults: declared.filter(|k: ReportKey| k.source == "default").len(),
    schema: match configuration.schema {
      None -> None,
      Some(sc) ->
        Some({
          function: sc.function,
          keys: sc.keys.map(|k: Key| { name: k.name, shape: shape_word(k.shape) }),
        }),
    },
    resolved: declared.len(),
    secret: declared.filter(|k: ReportKey| k.secret).len(),
    keys: declared,
  }
}

pub fn banner(configuration: Configuration) -> String / {abort.raise} = {
  let won = configuration.values.fold(
    [],
    |acc: List<ResolvedValue>, key: String, r: ResolvedValue|
      if r.shape == None { acc } else { acc.push(r) },
  );
  let counted = |hit: (Source) -> Bool| won.filter(|r: ResolvedValue| hit(r.source)).len();
  let parts = [
    { n: counted(|source: Source| source == ByEnvironment), what: "environment" },
    { n: counted(|source: Source| source == BySet), what: "--set" },
    {
      n: counted(|source: Source| match source { ByFile(_) -> true, _ -> false }),
      what: "--config",
    },
    { n: counted(|source: Source| source == ByDefault), what: "default" },
  ].fold([count_of(won.len(), "key")], |acc: List<String>, p: { n: Int, what: String }|
    if p.n > 0 { acc.push(p.n.to_string() ++ " " ++ p.what) } else { acc });
  let secrets = won.filter(|r: ResolvedValue| is_secret(r.shape)).len();
  String::join(
    if secrets > 0 { parts.push(count_of(secrets, "secret") ++ " (values not shown)") }
    else { parts },
    " · ",
  )
}

pub fn report_json(r: Report) -> Json =
  object([
    {
      key: "sources",
      value: object([
        { key: "set", value: json::int(r.sets) },
        { key: "files", value: Array(r.files.map(|f: String| Str(f))) },
        { key: "environment", value: json::int(r.environment) },
      ]),
    },
    {
      key: "schema",
      value: match r.schema {
        None -> Null,
        Some(v) ->
          object([
            { key: "function", value: Str(v.function) },
            {
              key: "keys",
              value: Array(
                v.keys.map(|k: KeyShape|
                  object([
                    { key: "name", value: Str(k.name) },
                    { key: "shape", value: Str(k.shape) },
                  ])),
              ),
            },
          ]),
      },
    },
    { key: "resolved", value: json::int(r.resolved) },
    { key: "secret", value: json::int(r.secret) },
    {
      key: "keys",
      value: Array(
        r.keys.map(|k: ReportKey|
          object([
            { key: "name", value: Str(k.name) },
            { key: "value", value: Str(k.value) },
            { key: "source", value: Str(k.source) },
            { key: "secret", value: Bool(k.secret) },
          ])),
      ),
    },
  ])

fn file(path: String, text: String) -> ConfigFile =
  { path: path, text: Some(Bytes::of_string(text)) }

fn var(name: String, value: String) -> { name: String, value: String } =
  { name: name, value: value }

fn read_ok(
  sets: List<String>,
  files: List<ConfigFile>,
  environment: List<{ name: String, value: String }>,
) -> Sources / {abort.raise} =
  match sources_of(sets, files, environment) { Ok(s) -> s, Err(_) -> panic("the sources read") }

fn read_err(
  sets: List<String>,
  files: List<ConfigFile>,
  environment: List<{ name: String, value: String }>,
) -> List<Diagnostic> / {abort.raise} =
  match sources_of(sets, files, environment) {
    Ok(_) -> panic("a source was refused"),
    Err(ds) -> ds,
  }

fn spec_of(keys: List<Key>) -> Option<Schema> = Some({ function: "m.spec", keys: keys })

fn resolved_ok(s: Sources, schema: Option<Schema>) -> Resolution / {abort.raise} =
  match resolved(s, schema) { Ok(r) -> r, Err(_) -> panic("the configuration resolves") }

fn resolved_err(s: Sources, schema: Option<Schema>) -> List<Diagnostic> / {abort.raise} =
  match resolved(s, schema) { Ok(_) -> panic("the configuration was refused"), Err(ds) -> ds }

fn value_of(resolution: Resolution, key: String) -> Option<String> =
  match resolution.configuration.values.get(key) { Some(v) -> Some(v.value), None -> None }

fn source_of(resolution: Resolution, key: String) -> Option<Source> =
  match resolution.configuration.values.get(key) { Some(v) -> Some(v.source), None -> None }

fn codes(diagnostics: List<Diagnostic>) -> List<Bytes> =
  diagnostics.map(|diagnostic: Diagnostic| diagnostic.code)

fn rendered(diagnostic: Diagnostic) -> String =
  String::of_bytes_lossy(diagnostic.message) ++ " "
    ++ String::join(diagnostic.notes_text.map(|n: Bytes| String::of_bytes_lossy(n)), " ")

fn says(diagnostic: Diagnostic, text: String) -> Bool = rendered(diagnostic).contains(text)

fn first(ds: List<Diagnostic>) -> Diagnostic / {abort.raise} =
  match ds.at(0) { Some(d) -> d, None -> panic("a diagnostic was raised") }

fn required_key(name: String, shape: Shape) -> Key = { ..optional(name, shape), required: true }

test "precedence walks down as sources are removed: --set, then a file, then the environment" {
  let schema = spec_of([{ ..optional("SERVICE_REGION", SText), default: Some("default") }]);
  let tree = [file("deploy.env", "SERVICE_REGION=file\n")];
  let env = [var("SERVICE_REGION", "environment")];
  let all = resolved_ok(read_ok(["SERVICE_REGION=set"], tree, env), schema);
  assert_eq(value_of(all, "SERVICE_REGION"), Some("set"));
  assert_eq(source_of(all, "SERVICE_REGION"), Some(BySet));
  let no_set = resolved_ok(read_ok([], tree, env), schema);
  assert_eq(value_of(no_set, "SERVICE_REGION"), Some("file"));
  assert_eq(source_of(no_set, "SERVICE_REGION"), Some(ByFile("deploy.env")));
  let no_files = resolved_ok(read_ok([], [], env), schema);
  assert_eq(source_of(no_files, "SERVICE_REGION"), Some(ByEnvironment));
  let nothing = resolved_ok(read_ok([], [], []), schema);
  assert_eq(value_of(nothing, "SERVICE_REGION"), Some("default"));
  assert_eq(source_of(nothing, "SERVICE_REGION"), Some(ByDefault))
}

test "a later file wins over an earlier one, and the last --set of a key wins" {
  let files = resolved_ok(
    read_ok(
      [],
      [
        file("base.env", "SERVICE_REGION=eu\nSERVICE_PORT=8137\n"),
        file("override.env", "SERVICE_REGION=us\n"),
      ],
      [],
    ),
    None,
  );
  assert_eq(value_of(files, "SERVICE_REGION"), Some("us"));
  assert_eq(value_of(files, "SERVICE_PORT"), Some("8137"));
  assert_eq(
    value_of(resolved_ok(read_ok(["K=first", "K=second"], [], []), None), "K"),
    Some("second"),
  )
}

test "a malformed file names the file, the line and what is wrong with it" {
  let ds = read_err(
    [],
    [file("deploy.env", "SERVICE_REGION=eu\nthis line has no equals\n=empty\nSERVICE-PORT=8137\n")],
    [],
  );
  assert_eq(codes(ds), [b"E0440", b"E0440", b"E0440"]);
  let at = |i: Int| match ds.at(i) { Some(d) -> d, None -> panic("three were raised") };
  assert(says(at(0), "`deploy.env` line 2 is not `KEY=VALUE`: it has no `=`"));
  assert(says(at(1), "line 3") && says(at(1), "empty key"));
  assert(says(at(2), "line 4") && says(at(2), "contains `-`"))
}

test "a section header is no line of a configuration, closed or not" {
  let ds = read_err(
    [],
    [file("deploy.ini", "[service]\nSERVICE_REGION=eu\n  [service\n; SERVICE_PORT=1\n")],
    [],
  );
  assert_eq(codes(ds), [b"E0440", b"E0440", b"E0440"]);
  let at = |i: Int| match ds.at(i) { Some(d) -> d, None -> panic("three were raised") };
  assert(says(at(0), "`deploy.ini` line 1 is not `KEY=VALUE`: it opens a `[section]`"));
  assert(says(at(1), "line 3") && says(at(1), "it opens a `[section]`"));
  assert(says(at(2), "line 4") && says(at(2), "starts with `;`"))
}

test "a file that will not read, or is not text, is E0440 naming it" {
  let missing = first(read_err([], [{ path: "missing.env", text: None }], []));
  assert_eq(missing.code, b"E0440");
  assert(says(missing, "`--config missing.env` could not be read"));
  let binary = first(read_err([], [{ path: "blob.env", text: Some(b"\xff\xfe") }], []));
  assert(says(binary, "it is not UTF-8"))
}

test "a --set that is not KEY=VALUE is E0440 and says what to write" {
  let bad = ["SERVICE_PORT", "=8137", "1SERVICE=8137", "", "# a comment"];
  assert_eq(bad.map(|b: String| codes(read_err([b], [], []))), bad.map(|b: String| [b"E0440"]));
  assert(
    bad.fold(true, |ok: Bool, b: String|
      ok && says(first(read_err([b], [], [])), "write `--set KEY=VALUE`")),
  )
}

test "comments are whole lines, a hash in a value survives, and blanks around either side go" {
  let r = resolved_ok(
    read_ok(
      [],
      [
        file(
          "deploy.env",
          "# a comment\n\n   # an indented comment\nSERVICE_REGION = eu \nSERVICE_KEY=pa#ss\n\t\r\n",
        ),
      ],
      [],
    ),
    None,
  );
  assert_eq(value_of(r, "SERVICE_REGION"), Some("eu"));
  assert_eq(value_of(r, "SERVICE_KEY"), Some("pa#ss"))
}

test "the value is the rest of the line, and an empty value is a value" {
  assert_eq(
    value_of(resolved_ok(read_ok(["SERVICE_DSN=a=b=c"], [], []), None), "SERVICE_DSN"),
    Some("a=b=c"),
  );
  assert_eq(
    value_of(resolved_ok(read_ok(["SERVICE_REGION="], [], []), None), "SERVICE_REGION"),
    Some(""),
  )
}

test "an environment name that is not a key is skipped rather than refused" {
  let r = resolved_ok(
    read_ok([], [], [var("BASH_FUNC_x%%", "() { :; }"), var("SERVICE_REGION", "eu")]),
    None,
  );
  assert_eq(value_of(r, "SERVICE_REGION"), Some("eu"));
  assert_eq(value_of(r, "BASH_FUNC_x%%"), None)
}

test "a required key nothing supplies is E0441 naming every place the run looked" {
  let d = first(
    resolved_err(
      read_ok([], [file("deploy.env", "")], [var("PATH", "/bin")]),
      spec_of([required_key("SERVICE_API_KEY", SSecret)]),
    ),
  );
  assert_eq(d.code, b"E0441");
  assert(says(d, "requires `SERVICE_API_KEY` (`SSecret`) and nothing supplies it"));
  assert(
    says(
      d,
      "the run looked in: 0 `--set` arguments, the `--config` file `deploy.env`, 1 environment variable, and the schema's own default",
    ),
  )
}

test "a required key with a default is supplied by the default" {
  let r = resolved_ok(
    read_ok([], [], []),
    spec_of([{ ..required_key("SERVICE_REGION", SText), default: Some("eu") }]),
  );
  assert_eq(value_of(r, "SERVICE_REGION"), Some("eu"))
}

test "a value that is not of its shape is E0442 naming the source and showing the value" {
  let d = first(
    resolved_err(
      read_ok(["SERVICE_PORT=eight"], [], []),
      spec_of([required_key("SERVICE_PORT", SInt)]),
    ),
  );
  assert_eq(d.code, b"E0442");
  assert(
    says(d, "`SERVICE_PORT` is declared `SInt` and --set supplied a value that is not an `Int`"),
  );
  assert(says(d, "the value is `eight`"))
}

test "an Int is what int_of_string reads, and a Bool is true or false and nothing else" {
  let int = spec_of([required_key("N", SInt)]);
  assert_eq(value_of(resolved_ok(read_ok(["N=-17"], [], []), int), "N"), Some("-17"));
  assert_eq(codes(resolved_err(read_ok(["N=+17"], [], []), int)), [b"E0442"]);
  let flag = spec_of([required_key("SERVICE_DEBUG", SBool)]);
  assert_eq(
    value_of(resolved_ok(read_ok(["SERVICE_DEBUG=false"], [], []), flag), "SERVICE_DEBUG"),
    Some("false"),
  );
  assert(
    ["True", "yes", "1", ""].fold(true, |ok: Bool, bad: String|
      ok && codes(resolved_err(read_ok(["SERVICE_DEBUG=" ++ bad], [], []), flag)) == [b"E0442"]),
  )
}

test "a malformed secret is E0442 and its value is not printed" {
  let d = first(
    resolved_err(
      read_ok(["SERVICE_API_KEY=  "], [], []),
      spec_of([required_key("SERVICE_API_KEY", SSecret)]),
    ),
  );
  assert_eq(d.code, b"E0442");
  assert(says(d, "the value is not printed"));
  assert(!rendered(d).contains("  "))
}

test "an undeclared explicit key is W0607 listing the declared ones, an environment name is not" {
  let r = resolved_ok(
    read_ok(["SERVICE_PROT=8137"], [file("deploy.env", "SERVICE_RGION=eu\n")], [
      var("PATH", "/bin"),
      var("HOME", "/root"),
    ]),
    spec_of([optional("SERVICE_REGION", SText)]),
  );
  assert_eq(codes(r.warnings), [b"W0607", b"W0607"]);
  assert_eq(r.warnings.map(|diagnostic: Diagnostic| diagnostic.severity), [b"warning", b"warning"]);
  assert(
    r.warnings.fold(false, |hit: Bool, diagnostic: Diagnostic|
      hit || says(diagnostic, "--set supplies `SERVICE_PROT`")),
  );
  assert(
    r.warnings.fold(false, |hit: Bool, diagnostic: Diagnostic|
      hit || says(diagnostic, "--config deploy.env supplies `SERVICE_RGION`")),
  );
  assert(says(first(r.warnings), "the schema declares: SERVICE_REGION"));
  assert_eq(resolved_ok(read_ok(["ANYTHING=1"], [], []), None).warnings, [])
}

test "every missing and invalid key is reported at once" {
  let ds = resolved_err(
    read_ok(["C=three"], [], []),
    spec_of([required_key("A", SText), required_key("B", SText), required_key("C", SInt)]),
  );
  assert_eq(codes(ds), [b"E0441", b"E0441", b"E0442"])
}

test "a binding is handed every value, which keys are secret, and the schema's names and shapes" {
  let r = resolved_ok(
    read_ok(["SERVICE_API_KEY=s3cret", "SERVICE_REGION=eu", "EXTRA=1"], [], []),
    spec_of([required_key("SERVICE_REGION", SText), required_key("SERVICE_API_KEY", SSecret)]),
  );
  let c = run_configuration(r.configuration);
  assert_eq(c.values, [
    { key: "EXTRA", value: "1", secret: false },
    { key: "SERVICE_API_KEY", value: "s3cret", secret: true },
    { key: "SERVICE_REGION", value: "eu", secret: false },
  ]);
  assert_eq(
    c.schema,
    Some({
      function: "m.spec",
      keys: [
        { name: "SERVICE_REGION", shape: "SText" },
        { name: "SERVICE_API_KEY", shape: "SSecret" },
      ],
    }),
  );
  assert(c.opened);
  assert(!run_configuration(closed_configuration()).opened);
  assert(
    run_configuration(
      resolved_ok(read_ok([], [], [var("PATH", "/bin")]), None).configuration,
    ).opened,
  )
}

test "a report lists only the declared keys, and a secret's value never" {
  let r = resolved_ok(
    read_ok(["SERVICE_API_KEY=hunter2"], [file("deploy.env", "SERVICE_PORT=8137\n")], [
      var("PATH", "/bin"),
    ]),
    spec_of([
      required_key("SERVICE_PORT", SInt),
      required_key("SERVICE_API_KEY", SSecret),
      { ..optional("SERVICE_REGION", SText), default: Some("eu") },
    ]),
  );
  let rep = report(r.configuration);
  assert_eq(rep.keys, [
    { name: "SERVICE_API_KEY", value: "****", source: "--set", secret: true },
    { name: "SERVICE_PORT", value: "8137", source: "deploy.env", secret: false },
    { name: "SERVICE_REGION", value: "eu", source: "default", secret: false },
  ]);
  assert_eq((rep.resolved, rep.secret, rep.defaults, rep.environment), (3, 1, 1, 1));
  assert_eq(
    banner(r.configuration),
    "3 keys · 1 --set · 1 --config · 1 default · 1 secret (values not shown)",
  );
  assert(!to_string(report_json(rep)).contains("hunter2"))
}

fn record(fields: List<{ name: String, value: Value }>) -> Value = VRecord(fields)

fn a_key_value(name: String, shape: String, required: Bool, default: Option<String>) -> Value =
  record([
    {
      name: "default",
      value: match default { Some(d) -> VCtor("Some", [VStr(d)]), None -> VCtor("None", []) },
    },
    { name: "name", value: VStr(name) },
    { name: "required", value: VBool(required) },
    { name: "shape", value: VCtor(shape, []) },
  ])

fn a_spec_value(keys: List<Value>) -> Value = record([{ name: "keys", value: VList(keys) }])

test "a ConfigSpec value decodes into the keys the run resolves, in its own order" {
  let v = a_spec_value([
    a_key_value("SERVICE_PORT", "std.config.SInt", true, None),
    a_key_value("SERVICE_REGION", "std.config.SText", false, Some("eu")),
  ]);
  assert_eq(
    schema_of(v, "service.config"),
    Ok({
      function: "service.config",
      keys: [
        required_key("SERVICE_PORT", SInt),
        { ..optional("SERVICE_REGION", SText), default: Some("eu") },
      ],
    }),
  )
}

test "a value that is not a ConfigSpec is refused rather than partly read" {
  let rejected = |v: Value|
    match schema_of(v, "service.config") {
      Ok(_) -> "",
      Err(d) -> String::of_bytes_lossy(d.message),
    };
  let prefix = "`--config-schema service.config` returned something that is not a `ConfigSpec`: ";
  assert_eq(rejected(VStr("x")), prefix ++ "it is not a record");
  assert_eq(rejected(record([])), prefix ++ "it has no `keys` list");
  assert_eq(rejected(a_spec_value([VStr("x")])), prefix ++ "a key in `keys` is not a record");
  assert_eq(
    rejected(a_spec_value([a_key_value("K", "other.SText", true, None)])),
    prefix ++ "`K` has the shape `other.SText`, which is not one of `std.config`'s",
  );
  assert_eq(
    rejected(
      a_spec_value([
        record([
          { name: "name", value: VStr("K") },
          { name: "shape", value: VCtor("std.config.SInt", []) },
        ]),
      ]),
    ),
    prefix ++ "`K` has no `required` flag",
  )
}

test "a schema that declares a key twice is refused" {
  match schema_of(
      a_spec_value([
        a_key_value("SERVICE_REGION", "std.config.SText", false, None),
        a_key_value("SERVICE_REGION", "std.config.SInt", false, None),
      ]),
      "service.config",
    ) {
    Ok(_) -> panic("one name, two declarations"),
    Err(d) -> {
      assert_eq(d.code, b"E0440");
      assert(says(d, "the configuration schema declares `SERVICE_REGION` twice"))
    },
  }
}
