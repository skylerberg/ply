import args (Flags, no_flags, style_of)
import std.cli (Parsed, has, value)
import diagnostic (SourceText)
import paths (RootedPath, child, create_dir, displayed, here, kind, rooted, write_file)
import report (CommandOutput, indent, ok_code, compile_error, schema_version, reported)
import std.term (Style)
import surface
import compiler.front.pkg (is_dotted_path)
import compiler.check.resolve.tables (error_at)
import std.fs (fs, Missing, MemFs, WriteResult, mem_create_dir, mem_empty, mem_kind, mem_read,
               mem_write)
import std.json (Json, Array, Bool, Number, Str, object)
import std.path (file_name)
import std.pkg (Version, render_version)
import compiler.unit (shipped)
import std.string
import surface (parsed)
import compiler.syntax.parsing (no_module, dummy_span)

pub type Options = { name: Option<String>, lib: Bool }

pub fn options_from(p: Parsed) -> Options = { name: value(p, "name"), lib: has(p, "lib") }

fn at(path: String) -> SourceText = { path: path, text: b"" }

fn failure_output(
  style: Style,
  command: String,
  path: String,
  reason: String,
  note: String,
) -> CommandOutput / {abort.raise} =
  reported(
    style,
    command,
    [
      error_at(
        b"E0502",
        no_module(),
        dummy_span(),
        Bytes::of_string(reason),
        Bytes::of_string(note),
        [],
      ),
    ],
    [at(path)],
  )

fn is_bad_name(name: String) -> Bool / {abort.raise} = !is_dotted_path(name)

fn name_of(dir: RootedPath, opts: Options) -> String =
  match opts.name { Some(named) -> named, None -> file_name(dir.path) }

fn toolchain_version() -> Version / {shipped.version} = {
  let parts = shipped.version().split(".");
  let at_part = |i: Int|
    match parts.at(i) {
      None -> 0,
      Some(text) -> match Decimal::of_string(text) {
        None -> 0,
        Some(d) -> match Int::of_decimal(d, Down) { Some(n) -> n, None -> 0 },
      },
    };
  { major: at_part(0), minor: at_part(1), patch: at_part(2) }
}

pub fn manifest_text(name: String, runtime: Version) -> String =
  "// " ++ name
    ++ " — the package this tree is. `ply check`, `ply test` and `ply build` read it.\n"
    ++ "\n"
    ++ "import std.pkg (Manifest)\n"
    ++ "\n"
    ++ "fn package() -> Manifest = {\n"
    ++ "  name: \""
    ++ name
    ++ "\",\n"
    ++ "  version: { major: 0, minor: 1, patch: 0 },\n"
    ++ "  prefix: None,\n"
    ++ "  runtime: { major: "
    ++ runtime.major.to_string()
    ++ ", minor: "
    ++ runtime.minor.to_string()
    ++ ", patch: "
    ++ runtime.patch.to_string()
    ++ " },\n"
    ++ "  dependencies: [],\n"
    ++ "  entry: None,\n"
    ++ "}\n"

pub fn module_text(name: String, lib: Bool) -> String =
  if lib {
    "// " ++ name ++ " — the first module. A `pub` definition is what an importer reaches.\n"
      ++ "\n"
      ++ "pub fn double(n: Int) -> Int = n * 2\n"
      ++ "\n"
      ++ "test \"doubling\" { assert_eq(double(21), 42) }\n"
  } else {
    "// " ++ name ++ " — the first module. `ply run` calls `main`.\n" ++ "\n"
      ++ "fn main() -> Unit / {Console} = print(\"hello from "
      ++ name
      ++ "\")\n"
      ++ "\n"
      ++ "test \"the first test\" { assert_eq(1 + 1, 2) }\n"
  }

fn module_file(lib: Bool) -> String = if lib { "lib.ply" } else { "main.ply" }

fn files_of(lib: Bool) -> List<String> = ["ply.pkg", module_file(lib)]

fn json_of(name: String, dir: String, lib: Bool, code: Int) -> Json =
  object([
    { key: "command", value: Str("new") },
    { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
    { key: "ok", value: Bool(code == ok_code()) },
    { key: "exit_code", value: Number(Decimal::of_int(code)) },
    { key: "name", value: Str(name) },
    { key: "path", value: Str(dir) },
    { key: "lib", value: Bool(lib) },
    { key: "files", value: Array(files_of(lib).map(|f: String| Str(f))) },
  ])

fn created_output(style: Style, name: String, dir: String, lib: Bool) -> CommandOutput = {
  let step = if lib { "ply test" } else { "ply run ." };
  {
    json: json_of(name, dir, lib, ok_code()),
    lines: [
      indent() ++ "created " ++ dir ++ " · " ++ String::join(files_of(lib), ", "),
      indent() ++ "next: cd " ++ dir ++ " && " ++ step,
    ],
    errs: [],
    code: ok_code(),
  }
}

pub fn run(
  flags: Flags,
  opts: Options,
) -> CommandOutput / {fs.kind[cwd], fs.kind[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.write_file[cwd], fs.write_file[abs], shipped.version, abort.raise} = {
  let s = style_of(flags);
  let dir = rooted(match flags.paths.at(0) { Some(r) -> r, None -> here() });
  let shown_dir = displayed(dir);
  let name = name_of(dir, opts);
  let manifest = child(dir, "ply.pkg");
  let module = child(dir, module_file(opts.lib));
  if is_bad_name(name) {
    failure_output(
      s,
      "new",
      shown_dir,
      "`" ++ name ++ "` is not a package name",
      "a package name is lower-case letters, digits and `_`, joined by dots; importers write it as the prefix of the modules they import",
    )
  } else if kind(dir) != Missing {
    failure_output(
      s,
      "new",
      shown_dir,
      "`" ++ shown_dir ++ "` is already there",
      "`ply new` makes a package, and never writes into one that exists",
    )
  } else if !create_dir(dir) {
    failure_output(
      s,
      "new",
      shown_dir,
      "could not make `" ++ shown_dir ++ "`",
      "the directory was not written",
    )
  } else if !write_file(manifest, Bytes::of_string(manifest_text(name, toolchain_version()))) {
    failure_output(
      s,
      "new",
      shown_dir,
      "could not write `" ++ displayed(manifest) ++ "`",
      "nothing else was written",
    )
  } else if !write_file(module, Bytes::of_string(module_text(name, opts.lib))) {
    failure_output(
      s,
      "new",
      shown_dir,
      "could not write `" ++ displayed(module) ++ "`",
      "the package's other file was written",
    )
  } else { created_output(s, name, shown_dir, opts.lib) }
}

test "a manifest names the package, its version, and the toolchain that made it" {
  let text = manifest_text("demo", { major: 0, minor: 16, patch: 3 });
  assert(text.contains("name: \"demo\",\n"));
  assert(text.contains("version: { major: 0, minor: 1, patch: 0 }"));
  assert(text.contains("runtime: { major: 0, minor: 16, patch: 3 }"));
  assert(text.contains("entry: None"));
  assert_eq(render_version({ major: 1, minor: 2, patch: 3 }), "1.2.3")
}

test "`module_text` gives a program a `main` that prints a greeting and one test, and gives a library a `double` function with a test" {
  let program = module_text("demo", false);
  assert(!program.contains("import"));
  assert(program.contains("fn main() -> Unit / {Console} = print(\"hello from demo\")"));
  assert(program.contains("test \"the first test\""));
  assert_eq(module_file(false), "main.ply");

  let library = module_text("demo", true);
  assert(library.contains("pub fn double(n: Int) -> Int = n * 2"));
  assert(library.contains("test \"doubling\""));
  assert_eq(module_file(true), "lib.ply")
}

test "a name takes the shape a module path takes, and nothing else" {
  assert(!is_bad_name("demo"));
  assert(!is_bad_name("store.orders"));
  assert(!is_bad_name("a1.b_2"));
  assert(is_bad_name("Demo"));
  assert(is_bad_name("my-app"));
  assert(is_bad_name(""));
  assert(is_bad_name("a..b"))
}

test "`options_from` reads the `--lib` and `--name` flags of the `new` command" {
  let opts = options_from(parsed(["new", "demo", "--lib", "--name", "core"]));
  assert_eq(opts.name, Some("core"));
  assert(opts.lib);
  let bare = options_from(parsed(["new", "demo"]));
  assert_eq(bare.name, None);
  assert(!bare.lib)
}

type ScaffoldRun = { tree: MemFs, result: CommandOutput }

fn scaffold_in(tree: MemFs, flags: Flags, opts: Options) -> ScaffoldRun / {abort.raise} =
  handle {
    run(flags, opts)
  } with {
    var a = tree,
    shipped.version() -> "0.16.3",
    fs.kind[cwd](p) ->
      panic(
        "this test allows only absolute paths, but `ply new` checked a path relative to the working directory",
      ),
    fs.kind[abs](p) -> mem_kind(a, p),
    fs.create_dir[cwd](p) ->
      panic(
        "this test allows only absolute paths, but `ply new` created a directory at a path relative to the working directory",
      ),
    fs.create_dir[abs](p) -> {
      let w: WriteResult = mem_create_dir(a, p);
      a = w.fs;
      w.ok
    },
    fs.write_file[cwd](p, body) ->
      panic(
        "this test allows only absolute paths, but `ply new` wrote a file at a path relative to the working directory",
      ),
    fs.write_file[abs](p, body) -> {
      let w: WriteResult = mem_write(a, p, body);
      a = w.fs;
      w.ok
    },
    return result -> { tree: a, result: result },
  }

test "`new` creates a package outside the working directory at its absolute path, and fails with that path if the package already exists" {
  let flags: Flags = {
    ..no_flags(),
    paths: [
      {
        label: "abs",
        root_path: "srv",
        display: "/srv",
        inside: "demo",
        absolute: "/srv",
        machine: "/srv/demo",
        part: "",
      },
    ],
  };
  let first = scaffold_in(mem_empty(), flags, { name: None, lib: true });
  assert_eq(first.result.code, 0);
  assert_eq(first.result.lines, [
    "   created /srv/demo · ply.pkg, lib.ply",
    "   next: cd /srv/demo && ply test",
  ]);
  assert_eq(
    mem_read(first.tree, "srv/demo/lib.ply"),
    Some(Bytes::of_string(module_text("demo", true))),
  );
  assert(mem_read(first.tree, "srv/demo/ply.pkg") != None);
  let program = scaffold_in(mem_empty(), flags, { name: None, lib: false });
  assert_eq(program.result.lines, [
    "   created /srv/demo · ply.pkg, main.ply",
    "   next: cd /srv/demo && ply run .",
  ]);
  assert_eq(
    mem_read(program.tree, "srv/demo/main.ply"),
    Some(Bytes::of_string(module_text("demo", false))),
  );
  let again = scaffold_in(first.tree, flags, { name: None, lib: false });
  assert_eq(again.result.code, 2);
  assert_eq(again.result.errs, ["Error[E0502]: `/srv/demo` is already there"]);
  assert_eq(mem_read(again.tree, "srv/demo/main.ply"), None)
}
