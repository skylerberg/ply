import compiler.front.diagnostics (parse_all)
import compiler.front.rows (DefinitionRow, Dump, EmitterRoot, ModuleRow, ModuleSpan, OrdinalRow,
                            module_span_bin)
import compiler.front.published (analyse, dump_of)
import compiler.check.types (Effect, effect_bin)
import compiler.load (LoadedAnalysis, SourceFile)
import entry (Main, Module)
import host_listing
import host_listing (DeclaredEffect, declared_effect_bin)
import paths
import compiler.syntax.items (is_shipped)
import std.bin
import std.list
import compiler.prelude_source

pub type Entries = { mains: List<Main>, modules: List<Module> }

pub fn none() -> Entries = { mains: [], modules: [] }

fn in_root_package(dump: Dump) -> (Bytes) -> Bool =
  if dump.packages.len() == 0 { |module: Bytes| !is_shipped(module) } else {
    let roots = range(0, dump.ordinals.len()).fold(
      Map::new(),
      |accumulator: Map<Bytes, Bool>, i: Int|
        match ((dump.ordinals.at(i), dump.module_packages.at(i))) {
          (Some(o), Some(package)) -> if package == 0 { accumulator.insert(o.module, true) }
          else { accumulator },
          _ -> accumulator,
        },
    );
    |module: Bytes| roots.contains(module)
  }

fn function_name(item: Bytes) -> Option<Bytes> / {abort.raise} =
  if !item.starts_with(b"fn ") { None } else {
    let rest = item.slice(3, item.len());
    match rest.index_of_byte(32) { Some(space) -> Some(rest.slice(0, space)), None -> Some(rest) }
  }

fn path_of(front: LoadedAnalysis, module: Bytes) -> String =
  match front.dump.modules.filter(|row: ModuleRow| row.name == module) {
    [row, ..] -> match front.files.at(row.index) { Some(file) -> file.path, None -> "<unknown>" },
    [] -> String::of_bytes_lossy(module),
  }

type FoundMains = { seen: Map<Bytes, Bool>, mains: List<Main> }

fn add_main(
  front: LoadedAnalysis,
  accumulator: FoundMains,
  definition: DefinitionRow,
) -> FoundMains =
  if accumulator.seen.contains(definition.name) { accumulator } else {
    {
      seen: accumulator.seen.insert(definition.name, true),
      mains: accumulator.mains.push({
        name: String::of_bytes_lossy(definition.name),
        module: String::of_bytes_lossy(definition.module),
        path: path_of(front, definition.module),
        at: definition.at,
      }),
    }
  }

pub fn mains_of(front: LoadedAnalysis) -> List<Main> / {abort.raise} = {
  let root = in_root_package(front.dump);
  let offered = front.dump.definitions.fold(
    Map::new(),
    |accumulator: Map<Bytes, DefinitionRow>, definition: DefinitionRow|
      if definition.simple_name == b"main" && root(definition.module) {
        accumulator.insert(definition.name, definition)
      } else { accumulator },
  );
  let written: FoundMains = front.dump.ordinals.fold(
    { seen: Map::new(), mains: [] },
    |accumulator: FoundMains, o: OrdinalRow|
      o.items.fold(accumulator, |inner: FoundMains, item: Bytes|
        match function_name(item) {
          None -> inner,
          Some(name) -> match offered.get(name) {
            Some(definition) -> add_main(front, inner, definition),
            None -> inner,
          },
        }),
  );
  let all: FoundMains = front.dump.definitions.fold(
    written,
    |accumulator: FoundMains, definition: DefinitionRow|
      if offered.contains(definition.name) { add_main(front, accumulator, definition) }
      else { accumulator },
  );
  all.mains
}

pub fn modules_of(front: LoadedAnalysis) -> List<Module> =
  front.dump.modules.map(|row: ModuleRow| {
    let file: Option<SourceFile> = front.files.at(row.index);
    let end = match file { Some(f) -> f.text.len(), None -> 0 };
    {
      name: String::of_bytes_lossy(row.name),
      path: match file { Some(f) -> f.path, None -> "<unknown>" },
      at: { module: row.index, start: end, end: end },
    }
  })

pub fn of_front(front: LoadedAnalysis) -> Entries / {abort.raise} =
  { mains: mains_of(front), modules: modules_of(front) }

pub fn narrowed_to(entries: Entries, resolved: List<paths::ResolvedPath>) -> Entries =
  {
    mains: entries.mains.filter(|m: Main| paths::includes_any(resolved, m.path)),
    modules: entries.modules.filter(|m: Module| paths::includes_any(resolved, m.path)),
  }

pub type Runnable = {
  roots: List<RootSpan>,
  declared: List<DeclaredEffect>,
  performed: List<Effect>,
}

pub type RootSpan = { root: Bytes, at: ModuleSpan }

derive bin for RootSpan
derive bin for Runnable

pub fn runnable_of(front: LoadedAnalysis) -> Runnable / {abort.raise} =
  {
    roots: front.dump.emitter_roots.map(|r: EmitterRoot| { root: r.root, at: r.at }),
    declared: host_listing::declared_of(front.dump),
    performed: host_listing::performed_effects(front.dump).fold(
      Map::new(),
      |accumulator: Map<Bytes, Effect>, a: Effect|
        accumulator.insert(bin::encode(a, effect_bin()), a),
    ).values(
    ),
  }

pub fn roots_of(r: Runnable) -> Map<Bytes, ModuleSpan> =
  r.roots.fold(Map::new(), |m: Map<Bytes, ModuleSpan>, x: RootSpan| m.insert(x.root, x.at))

type TestModule = { name: String, text: String }

fn front_over(files: List<TestModule>) -> LoadedAnalysis / {abort.raise} =
  {
    dump: dump_of(
      analyse(
        parse_all(
          files.map(|f: TestModule|
            { name: Bytes::of_string(f.name), source_text: Bytes::of_string(f.text) }),
        ),
      ),
    ),
    files: files.map(|f: TestModule|
      { path: f.name ++ ".ply", name: f.name, text: Bytes::of_string(f.text) }).push({
      path: "<std>/prelude.ply",
      name: "std.prelude",
      text: prelude_source::text(),
    }),
    inputs: Map::new(),
    read_ms: 0,
    front_end_ms: 0,
    store_ms: 0,
    cached: false,
  }

test "`mains_of` finds a `main` in any module that declares it, along with that module's file path" {
  let front = front_over([
    { name: "lib", text: "pub fn one() -> Int = 1\n" },
    { name: "app", text: "import lib\nfn main() -> Int = lib::one()\n" },
  ]);
  match mains_of(front) {
    [only] -> {
      assert_eq(only.name, "app.main");
      assert_eq(only.module, "app");
      assert_eq(only.path, "app.ply");
      assert_eq(only.at.module, 1)
    },
    others -> panic("one `main` is offered, and " ++ others.len().to_string() ++ " were"),
  }
}

test "two modules may each declare `main`, and `mains_of` returns them in load order" {
  let front = front_over([
    { name: "one", text: "fn main() -> Int = 1\n" },
    { name: "two", text: "fn main() -> Int = 2\n" },
  ]);
  assert_eq(mains_of(front).map(|m: Main| m.name), ["one.main", "two.main"])
}

test "`modules_of` returns every module the load read, each with a position at the end of its file" {
  let front = front_over([
    { name: "lib", text: "pub fn one() -> Int = 1\n" },
    { name: "app", text: "import lib\nfn main() -> Int = lib::one()\n" },
  ]);
  let end = prelude_source::text().len();
  assert_eq(modules_of(front), [
    { name: "lib", path: "lib.ply", at: { module: 0, start: 24, end: 24 } },
    { name: "app", path: "app.ply", at: { module: 1, start: 41, end: 41 } },
    { name: "std.prelude", path: "<std>/prelude.ply", at: { module: 2, start: end, end: end } },
  ])
}

test "a run stores the effects the program declares and the effects it performs" {
  let front = front_over([
    {
      name: "m",
      text: "effect log {\n  write note(s: String) -> Unit\n}\nfn main() -> Int / {log.note} = {\n  log.note(\"x\");\n  1\n}\n",
    },
  ]);
  let runnable = runnable_of(front);
  assert(runnable.declared.any(|d: DeclaredEffect| d.name == b"m.log"));
  assert(runnable.performed.any(|a: Effect| a.effect == b"m.log"))
}
