import compiler.emit.keys (RootKey, root_key_bin, printed)
import diagnostic (SourceText)
import compiler.front.checking.program_facts (ProgramRollup)
import compiler.front.emitter_input (RootPlace, MainPlace, root_place_bin)
import compiler.front.rows (DeclaredEffect, DeclaredOperation, DefinitionRow, Dump, EmitterRoot,
                            ModuleRow, OrdinalRow, declared_effect_bin)
import compiler.check.resolve.tables (InSource, Place, place_module)
import compiler.check.types (Effect, effect_bin)
import entry (Main, Module)
import host_listing
import paths
import std.bin
import std.list

pub type Entries = { mains: List<Main>, modules: List<Module> }

pub fn narrowed_to(entries: Entries, resolved: List<paths::ResolvedPath>) -> Entries =
  {
    mains: entries.mains.filter(|m: Main| paths::includes_any(resolved, m.path)),
    modules: entries.modules.filter(|m: Module| paths::includes_any(resolved, m.path)),
  }

pub type Runnable = {
  roots: List<RootPlace>,
  declared: List<DeclaredEffect>,
  performed: List<Effect>,
}

derive bin for Runnable

pub fn runnable_from(rollup: ProgramRollup, performed: List<Effect>) -> Runnable =
  { roots: rollup.roots, declared: rollup.declared, performed: performed.unique() }

pub fn main_effects(rollup: ProgramRollup, entry: String) -> List<Effect> =
  rollup.mains.fold([], |found: List<Effect>, m: MainPlace|
    if m.root == Bytes::of_string(entry) { found.concat(m.effects) } else { found })

pub fn entries_over(
  rollup: ProgramRollup,
  names: List<Bytes>,
  root: Int,
  places: List<SourceText>,
) -> Entries / {abort.raise} = {
  let path_at = |i: Int| places.at(i).map(|p: SourceText| p.path).unwrap_or("<unknown>");
  {
    mains: rollup.mains.flat_map(|m: MainPlace|
      match place_module(m.at) {
        Some(i) -> if i < root {
          [
            {
              name: String::of_bytes_lossy(m.root),
              module: String::of_bytes_lossy(names.get(i)),
              path: path_at(i),
              at: m.at,
            },
          ]
        } else { [] },
        None -> [],
      }),
    modules: range(0, names.len()).map(|i: Int| {
      let end = places.at(i).map(|p: SourceText| p.text.len()).unwrap_or(0);
      {
        name: String::of_bytes_lossy(names.get(i)),
        path: path_at(i),
        at: InSource({ module: i, start: end, end: end }),
      }
    }),
  }
}

pub fn roots_of(roots: List<RootPlace>) -> Map<Bytes, Place> =
  roots.fold(Map::new(), |m: Map<Bytes, Place>, x: RootPlace| m.insert(printed(x.key), x.at))
