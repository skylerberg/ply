import compiler.emit.keys (RootKey, root_key_bin)
import diagnostic (SourceText)
import compiler.front.checking.view (NamedRollup)
import compiler.front.emitter_input (RootPlace, MainPlace)
import compiler.check.infer.checker (TestInfo)
import compiler.front.rows (DeclaredEffect, DeclaredOperation, DefinitionRow, Dump, EmitterRoot,
                            ModuleRow, ModuleSpan, OrdinalRow, declared_effect_bin, module_span_bin)
import compiler.check.types (Effect, effect_bin)
import entry (Main, Module)
import host_listing
import paths
import std.bin
import std.list

pub type Entries = { mains: List<Main>, modules: List<Module> }

pub fn narrowed_to(entries: Entries, resolved: List<paths::ResolvedPath>) -> Entries =
  {
    mains: entries.mains.filter(|m: Main| paths::includes_any(resolved, m.path)),
    modules: entries.modules.filter(|m: Module| paths::includes_any(resolved, m.path)),
  }

pub type Runnable = {
  roots: List<RootSpan>,
  declared: List<DeclaredEffect>,
  performed: List<Effect>,
}

pub type RootSpan = { root: Bytes, key: RootKey, at: ModuleSpan }

derive bin for RootSpan
derive bin for Runnable

fn at_module(d: DeclaredEffect, i: Int) -> DeclaredEffect =
  {
    ..d,
    at: { ..d.at, module: i },
    operations: d.operations.map(|o: DeclaredOperation| { ..o, at: { ..o.at, module: i } }),
  }

pub fn runnable_from_rollups(
  rows: List<NamedRollup>,
  performed: List<Effect>,
) -> Runnable / {abort.raise} =
  {
    roots: root_spans(rows),
    declared: range(0, rows.len()).fold([], |found: List<DeclaredEffect>, i: Int|
      found.concat(rows.get(i).rollup.declared.map(|d: DeclaredEffect| at_module(d, i)))),
    performed: performed.unique(),
  }

pub fn root_spans(rows: List<NamedRollup>) -> List<RootSpan> / {abort.raise} =
  range(0, rows.len()).fold([], |found: List<RootSpan>, i: Int|
    found.concat(
      rows.get(i).rollup.roots.map(|p: RootPlace|
        { root: p.root, key: p.key, at: { ..p.at, module: i } }),
    ))

pub fn main_effects(rows: List<NamedRollup>, entry: String) -> List<Effect> =
  rows.fold([], |found: List<Effect>, r: NamedRollup|
    r.rollup.mains.fold(found, |f: List<Effect>, m: MainPlace|
      if m.root == Bytes::of_string(entry) { f.concat(m.effects) } else { f }))

pub fn test_effects(rows: List<NamedRollup>) -> List<Effect> =
  rows.fold([], |found: List<Effect>, r: NamedRollup|
    r.rollup.tests.fold(found, |f: List<Effect>, t: TestInfo| f.concat(t.effects)))

pub fn entries_over(
  rows: List<NamedRollup>,
  root: Int,
  places: List<SourceText>,
) -> Entries / {abort.raise} = {
  let path_at = |i: Int| places.at(i).map(|p: SourceText| p.path).unwrap_or("<unknown>");
  {
    mains: range(0, root).fold([], |found: List<Main>, i: Int|
      rows.get(i).rollup.mains.fold(found, |f: List<Main>, m: MainPlace|
        f.push({
          name: String::of_bytes_lossy(m.root),
          module: String::of_bytes_lossy(rows.get(i).module),
          path: path_at(i),
          at: { ..m.at, module: i },
        }))),
    modules: range(0, rows.len()).map(|i: Int| {
      let end = places.at(i).map(|p: SourceText| p.text.len()).unwrap_or(0);
      {
        name: String::of_bytes_lossy(rows.get(i).module),
        path: path_at(i),
        at: { module: i, start: end, end: end },
      }
    }),
  }
}

pub fn roots_of(roots: List<RootSpan>) -> Map<Bytes, ModuleSpan> =
  roots.fold(Map::new(), |m: Map<Bytes, ModuleSpan>, x: RootSpan| m.insert(x.root, x.at))
