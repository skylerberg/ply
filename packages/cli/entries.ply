//! The entry points a load offers: every `main` of the package being loaded and every module the
//! load read, as `entry` picks between them. They are read off the front end's answer, and kept
//! beside the answer `ply run` files, so a run that takes one back names its entry without it.

import compiler.front.diagnostics (parse_all)
import compiler.front.rows (DefRow, Dump, EmitterRoot, ModuleRow, ModuleSpan, OrdinalRow,
                            module_span_bin)
import compiler.front.published (analyse, dump_of)
import compiler.check.types (Atom, atom_bin)
import compiler.load (LoadedAnalysis, SourceFile)
import diagnostic (SourceText)
import entry (Main, Module)
import host_listing
import host_listing (DeclaredEffect, declared_effect_bin)
import paths
import compiler.syntax.items (is_shipped)
import std.bin
import std.list
import std.prelude_source

pub type Entries = { mains: List<Main>, modules: List<Module> }

pub fn none() -> Entries = { mains: [], modules: [] }

/// Which modules are the package being loaded, rather than a dependency's or a shipped one: only it
/// offers an entry point. A project without packages is every module the toolchain does not ship.
fn in_root_package(dump: Dump) -> (Bytes) -> Bool =
  if dump.packages.len() == 0 { |module: Bytes| !is_shipped(module) } else {
    let roots = range(0, dump.ordinals.len()).fold(Map::new(), |acc: Map<Bytes, Bool>, i: Int|
      match ((dump.ordinals.at(i), dump.module_packages.at(i))) {
        (Some(o), Some(package)) -> if package == 0 { acc.insert(o.module, true) } else { acc },
        _ -> acc,
      });
    |module: Bytes| roots.contains(module)
  }

/// The definition an ordinal names, when it is a `fn`: `fn <name>`, then its clauses' kinds.
fn function_name(item: Bytes) -> Option<Bytes> / {abort.raise} =
  if !item.starts_with(b"fn ") { None } else {
    let rest = item.slice(3, item.len());
    match rest.index_of_byte(32) { Some(space) -> Some(rest.slice(0, space)), None -> Some(rest) }
  }

/// The file a module was read from, as its reports name it.
fn path_of(front: LoadedAnalysis, module: Bytes) -> String =
  match front.dump.modules.filter(|row: ModuleRow| row.name == module) {
    [row, ..] -> match front.files.at(row.index) { Some(file) -> file.path, None -> "<unknown>" },
    [] -> String::of_bytes_lossy(module),
  }

type FoundMains = { seen: Map<Bytes, Bool>, mains: List<Main> }

fn add_main(front: LoadedAnalysis, acc: FoundMains, def: DefRow) -> FoundMains =
  if acc.seen.contains(def.name) { acc } else {
    {
      seen: acc.seen.insert(def.name, true),
      mains: acc.mains.push({
        name: String::of_bytes_lossy(def.name),
        module: String::of_bytes_lossy(def.module),
        path: path_of(front, def.module),
        at: def.at,
      }),
    }
  }

/// Every `main` of the package being loaded, files in load order and then as written: a
/// dependency's `main` is its own business.
pub fn mains_of(front: LoadedAnalysis) -> List<Main> / {abort.raise} = {
  let root = in_root_package(front.dump);
  let offered = front.dump.defs.fold(Map::new(), |acc: Map<Bytes, DefRow>, def: DefRow|
    if def.simple_name == b"main" && root(def.module) { acc.insert(def.name, def) } else { acc });
  let written: FoundMains = front.dump.ordinals.fold(
    { seen: Map::new(), mains: [] },
    |acc: FoundMains, o: OrdinalRow|
      o.items.fold(acc, |inner: FoundMains, item: Bytes|
        match function_name(item) {
          None -> inner,
          Some(name) -> match offered.get(name) {
            Some(def) -> add_main(front, inner, def),
            None -> inner,
          },
        }),
  );
  let all: FoundMains = front.dump.defs.fold(written, |acc: FoundMains, def: DefRow|
    if offered.contains(def.name) { add_main(front, acc, def) } else { acc });
  all.mains
}

/// Every module the load read, with the empty position at the end of its file: where the entry
/// point it does not declare would be written.
pub fn modules_of(front: LoadedAnalysis) -> List<Module> =
  front.dump.modules.map(|row: ModuleRow| {
    let file: Option<SourceFile> = front.files.at(row.index);
    let end = match file { Some(f) -> f.text.len(), None -> 0 };
    {
      name: String::of_bytes_lossy(row.name),
      path: match file { Some(f) -> f.path, None -> "<unknown>" },
      at: { module: row.index, start: end, end: end },
    }
  })

pub fn of_front(front: LoadedAnalysis) -> Entries / {abort.raise} =
  { mains: mains_of(front), modules: modules_of(front) }

/// `entries` as a line narrows them: those of the files it names, or holds under a directory it
/// names, so a file named in a package picks its `main` among the package's.
pub fn narrowed_to(entries: Entries, resolved: List<paths::ResolvedPath>) -> Entries =
  {
    mains: entries.mains.filter(|m: Main| paths::includes_any(resolved, m.path)),
    modules: entries.modules.filter(|m: Module| paths::includes_any(resolved, m.path)),
  }

// --- What running an entry reads ------------------------------------------------

/// What running a program's entry points reads of its front end, which `ply run` keeps for a later
/// run over the same closure and an artifact carries for its own: where each root of the unit is
/// written, and the effects the program declares and performs, which a binding is resolved against.
pub type Runnable = { roots: List<RootSpan>, declared: List<DeclaredEffect>, performed: List<Atom> }

/// A root of the unit, and where its definition is written.
pub type RootSpan = { root: Bytes, at: ModuleSpan }

derive bin for RootSpan
derive bin for Runnable

/// What running `front`'s entry points reads of it. A performed atom is kept once.
pub fn runnable_of(front: LoadedAnalysis) -> Runnable / {abort.raise} =
  {
    roots: front.dump.emitter_roots.map(|r: EmitterRoot| { root: r.root, at: r.at }),
    declared: host_listing::declared_of(front.dump),
    performed: host_listing::performed_atoms(front.dump).fold(
      Map::new(),
      |acc: Map<Bytes, Atom>, a: Atom| acc.insert(bin::encode(a, atom_bin()), a),
    ).values(
    ),
  }

/// Where each root of the unit is written, which a failure's sites are offsets from.
pub fn roots_of(r: Runnable) -> Map<Bytes, ModuleSpan> =
  r.roots.fold(Map::new(), |m: Map<Bytes, ModuleSpan>, x: RootSpan| m.insert(x.root, x.at))

// --- As `ply run` keeps them ----------------------------------------------------

/// A `main` or a module, flat: `module` is empty for a module.
type EntryRecord = { name: String, module: String, path: String, index: Int, start: Int, end: Int }

/// A file the load read: a shipped module's text is kept as the load placed it, which is what an
/// importer reads of it; any other file's is the walk's, and kept as none.
pub type CachedFile = { path: String, name: String, text: Bytes }

/// What `ply run` keeps of a load: the entry points it offered, the library its unit was compiled
/// into, the files it read, and what running it reads of its front end.
type CachedLoad = {
  mains: List<EntryRecord>,
  modules: List<EntryRecord>,
  library: String,
  files: List<CachedFile>,
  runnable: Runnable,
}

derive bin for EntryRecord
derive bin for CachedFile
derive bin for CachedLoad

/// What a later run over the same closure takes back of a load.
pub type RestoredLoad = {
  entries: Entries,
  library: String,
  files: List<CachedFile>,
  runnable: Runnable,
}

pub fn encode_load(
  entries: Entries,
  library: String,
  files: List<SourceFile>,
  runnable: Runnable,
) -> Bytes / {abort.raise} =
  bin::encode(
    {
      mains: entries.mains.map(|m: Main|
        {
          name: m.name,
          module: m.module,
          path: m.path,
          index: m.at.module,
          start: m.at.start,
          end: m.at.end,
        }),
      modules: entries.modules.map(|m: Module|
        {
          name: m.name,
          module: "",
          path: m.path,
          index: m.at.module,
          start: m.at.start,
          end: m.at.end,
        }),
      library: library,
      files: files.map(|f: SourceFile|
        {
          path: f.path,
          name: f.name,
          text: if is_shipped(Bytes::of_string(f.name)) { f.text } else { b"" },
        }),
      runnable: runnable,
    },
    cached_load_bin(),
  )

/// What `encode_load` filed, or `None` for bytes it did not write.
pub fn decode_load(filed: Bytes) -> Option<RestoredLoad> / {abort.raise} =
  match bin::decode(filed, cached_load_bin()) {
    Err(_) -> None,
    Ok(k) ->
      Some({
        entries: {
          mains: k.mains.map(|h: EntryRecord|
            {
              name: h.name,
              module: h.module,
              path: h.path,
              at: { module: h.index, start: h.start, end: h.end },
            }),
          modules: k.modules.map(|h: EntryRecord|
            { name: h.name, path: h.path, at: { module: h.index, start: h.start, end: h.end } }),
        },
        library: k.library,
        files: k.files,
        runnable: k.runnable,
      }),
  }

/// The files a kept load read, over this run's walk: its modules, the shipped modules the load
/// pulled as it placed them, then its manifests, in the order the load read them, so a span
/// renders as this run's own front end would render it. `None` where the walk does not fit.
pub fn restored_sources(
  files: List<CachedFile>,
  modules: List<SourceText>,
  manifests: List<SourceText>,
) -> Option<List<SourceText>> / {abort.raise} = {
  let own = modules.len();
  let pulled = files.len() - own - manifests.len();
  let walked = modules.concat(manifests);
  if pulled < 0 { None } else {
    range(0, files.len()).fold(Some([]), |acc: Option<List<SourceText>>, i: Int|
      match ((acc, files.at(i))) {
        (Some(placed), Some(f)) -> if i >= own && i < own + pulled {
          if is_shipped(Bytes::of_string(f.name)) {
            Some(placed.push({ path: f.path, text: f.text }))
          } else { None }
        } else {
          match walked.at(if i < own { i } else { i - pulled }) {
            Some(w) -> Some(placed.push(w)),
            None -> None,
          }
        },
        _ -> None,
      })
  }
}

// --- Tests ------------------------------------------------------------------

type TestModule = { name: String, text: String }

/// The front end's answer over `files`, each a module named by its file, and `std.prelude`, which
/// it reads beside them.
fn front_over(files: List<TestModule>) -> LoadedAnalysis / {abort.raise} =
  {
    dump: dump_of(
      analyse(
        parse_all(
          files.map(|f: TestModule|
            { name: Bytes::of_string(f.name), src: Bytes::of_string(f.text) }),
        ),
      ),
    ),
    files: files.map(|f: TestModule|
      { path: f.name ++ ".ply", name: f.name, text: Bytes::of_string(f.text) }).push({
      path: "<std>/prelude.ply",
      name: "std.prelude",
      text: prelude_source::text(),
    }),
    inputs: Map::new(),
    read_ms: 0,
    front_end_ms: 0,
    store_ms: 0,
    cached: false,
  }

test "a `main` is found in whatever module declares it, with the file that holds it" {
  let front = front_over([
    { name: "lib", text: "pub fn one() -> Int = 1\n" },
    { name: "app", text: "import lib\nfn main() -> Int = lib::one()\n" },
  ]);
  match mains_of(front) {
    [only] -> {
      assert_eq(only.name, "app.main");
      assert_eq(only.module, "app");
      assert_eq(only.path, "app.ply");
      assert_eq(only.at.module, 1)
    },
    others -> panic("one `main` is offered, and " ++ others.len().to_string() ++ " were"),
  }
}

test "two modules may each declare `main`, offered in load order" {
  let front = front_over([
    { name: "one", text: "fn main() -> Int = 1\n" },
    { name: "two", text: "fn main() -> Int = 2\n" },
  ]);
  assert_eq(mains_of(front).map(|m: Main| m.name), ["one.main", "two.main"])
}

test "every module the load read is offered, placed at the end of its file" {
  let front = front_over([
    { name: "lib", text: "pub fn one() -> Int = 1\n" },
    { name: "app", text: "import lib\nfn main() -> Int = lib::one()\n" },
  ]);
  let end = prelude_source::text().len();
  assert_eq(modules_of(front), [
    { name: "lib", path: "lib.ply", at: { module: 0, start: 24, end: 24 } },
    { name: "app", path: "app.ply", at: { module: 1, start: 41, end: 41 } },
    { name: "std.prelude", path: "<std>/prelude.ply", at: { module: 2, start: end, end: end } },
  ])
}

test "what a run keeps of a load reads back as it was filed, and nothing else reads" {
  let front = front_over([{ name: "m", text: "fn main() -> Int = 1\n" }]);
  let offered = of_front(front);
  let runnable = runnable_of(front);
  match decode_load(encode_load(offered, "/cache/m.dylib", front.files, runnable)) {
    None -> panic("what `kept` wrote reads back"),
    Some(k) -> {
      assert_eq(k.entries, offered);
      assert_eq(k.library, "/cache/m.dylib");
      assert_eq(k.runnable, runnable);
      // The walk holds the program's own text; a shipped module's is the load's.
      assert_eq(k.files.map(|f: CachedFile| f.text.len() > 0), [false, true])
    },
  };
  assert(decode_load(b"an entry of another shape") == None, None)
}

test "a run keeps the effects the program declares and the atoms it performs" {
  let front = front_over([
    {
      name: "m",
      text: "effect log {\n  write note(s: String) -> Unit\n}\nfn main() -> Int / {log.note} = {\n  log.note(\"x\");\n  1\n}\n",
    },
  ]);
  let runnable = runnable_of(front);
  assert(runnable.declared.any(|d: DeclaredEffect| d.name == b"m.log"));
  assert(runnable.performed.any(|a: Atom| a.effect == b"m.log"))
}

test "a kept load is placed over this run's walk, its shipped modules as the load read them" {
  let files = [
    { path: "m.ply", name: "m", text: b"" },
    { path: "<std>/prelude.ply", name: "std.prelude", text: b"the prelude" },
    { path: "ply.pkg", name: "", text: b"" },
  ];
  let m = { path: "m.ply", text: b"fn main() -> Int = 1\n" };
  let pkg = { path: "ply.pkg", text: b"fn package() -> Manifest = app()\n" };
  assert_eq(
    restored_sources(files, [m], [pkg]),
    Some([m, { path: "<std>/prelude.ply", text: b"the prelude" }, pkg]),
  );
  // A walk of more files than the load read, or one short of a module it read, does not fit.
  assert_eq(restored_sources(files, [m, m, m], [pkg]), None);
  assert_eq(
    restored_sources([{ path: "n.ply", name: "n", text: b"" }].concat(files), [m], [pkg]),
    None,
  )
}
