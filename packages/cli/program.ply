pub type ProgramPlace = { project: Project, store: Option<paths::ResolvedPath> }

pub type ModuleView = { name: String, path: String }

pub type ModuleReport = {
  index: Int,
  name: String,
  path: String,
  imports: List<String>,
  items: List<String>,
}

fn without_first(segments: List<String>) -> List<String> =
  range(1, segments.len()).fold([], |accumulator: List<String>, i: Int|
    match segments.at(i) { Some(s) -> accumulator.push(s), None -> accumulator })

pub fn pseudo_path(name: String) -> String = {
  let segments = name.split(".");
  match segments.at(0) {
    None -> name,
    Some(root) -> "<" ++ root ++ ">/" ++ String::join(without_first(segments), "/") ++ ".ply",
  }
}

pub fn packages_of(project: Project) -> PackageSources =
  {
    root: Bytes::of_string(project.root_key),
    manifest: match project.manifest { None -> None, Some(f) -> Some(f.text) },
    supplied: supplied(project),
  }

fn own_places(project: Project) -> List<SourceText> =
  project.files.map(|file: File| { path: file.path, text: file.text })

fn file_edit(project: Project, places: List<SourceText>, edit: Edit) -> Result<FileEdit, String> =
  match project.files.at(edit.module) {
    Some(file) -> Ok({ file: file, start: edit.start, end: edit.end, text: edit.text }),
    None ->
      Err(match places.at(edit.module) {
        Some(place) -> "it edits `" ++ place.path ++ "`, which is not a file of this project",
        None -> "it edits a module that has no file",
      }),
  }

type Placing = | Fits(PlacedFix) | Outside(List<String>)

fn with_edit(placing: Placing, edit: Result<FileEdit, String>) -> Placing =
  match ((placing, edit)) {
    (Fits(placed), Ok(e)) -> Fits({ ..placed, rest: placed.rest.push(e) }),
    (Fits(_), Err(reason)) -> Outside([reason]),
    (Outside(reasons), Ok(_)) -> Outside(reasons),
    (Outside(reasons), Err(reason)) -> Outside(reasons.push_unique(reason)),
  }

fn placed_fix(project: Project, places: List<SourceText>, fix: Fix) -> FixPlacement = {
  let first = match file_edit(project, places, fix.first) {
    Ok(e) -> Fits({ title: fix.title, first: e, rest: [] }),
    Err(reason) -> Outside([reason]),
  };
  match fix.rest.fold(first, |placing: Placing, edit: Edit|
      with_edit(placing, file_edit(project, places, edit))) {
    Fits(placed) -> Applicable(placed),
    Outside(reasons) -> Unapplicable({ title: fix.title, reason: String::join(reasons, "; ") }),
  }
}

fn alternatives_left(diagnostic: Diagnostic, fixes: List<Fix>) -> FixPlacement =
  Unapplicable({
    title: diagnostic.message,
    reason: "it offers " ++ fixes.len().to_string() ++ " fixes to choose from: "
      ++ String::join(fixes.map(|f: Fix| String::of_bytes_lossy(f.title)), "; "),
  })

pub fn placed_fixes(
  project: Project,
  places: List<SourceText>,
  diagnostics: List<Diagnostic>,
) -> List<FixPlacement> =
  diagnostics.fold([], |found: List<FixPlacement>, d: Diagnostic|
    match d.fixes {
      Apply(fix) -> found.push(placed_fix(project, places, fix)),
      ChooseOne(first, second, rest) ->
        found.push(alternatives_left(d, [first, second].concat(rest))),
      NoFix -> found,
    })

fn supplied(project: Project) -> List<SuppliedPackage> =
  project.packages.map(|package: DependencyPackage|
    {
      root: Bytes::of_string(package.root),
      manifest: package.manifest,
      modules: package.files.map(|file: File|
        { name: Bytes::of_string(file.module), source_text: file.text }),
    })

fn dependency_places(project: Project) -> List<SourceText> =
  project.packages.fold([], |accumulator: List<SourceText>, package: DependencyPackage|
    package.files.fold(accumulator, |places: List<SourceText>, file: File|
      places.push({ path: file.path, text: file.text })))

fn manifest_places(project: Project) -> List<SourceText> = {
  let dependencies = project.packages.fold(
    [],
    |accumulator: List<SourceText>, package: DependencyPackage|
      match package.manifest {
        None -> accumulator,
        Some(text) -> accumulator.push({ path: package.root ++ "/ply.pkg", text: text }),
      },
  );
  match project.manifest {
    None -> dependencies,
    Some(f) -> {
      let root: List<SourceText> = [{ path: f.path, text: f.text }];
      dependencies.fold(root, |accumulator: List<SourceText>, place: SourceText|
        accumulator.push(place))
    },
  }
}

type ProjectSources = { modules: List<SourceText>, manifests: List<SourceText> }

fn project_sources(project: Project) -> ProjectSources =
  {
    modules: own_places(project).concat(dependency_places(project)),
    manifests: manifest_places(project),
  }

pub effect set ProgramStore = {project_store::Databases, shipped.read_pack, toolchain.reuse_dir, fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], ProjectFiles, Derives}

pub fn in_program_store<a>(
  place: ProgramPlace,
  work: (LoadInputs) -> a / {SessionReads, fact_inspection.read, abort.raise},
) -> Opened<a> / {ProgramStore, progress.write, abort.raise} =
  match place.store {
    None -> module_queries::temporary_session(place.project, work),
    Some(r) ->
      module_queries::stored_session(project_store::database_place(r), place.project, work),
  }

fn slots_of(project: Project) -> List<String> / {abort.raise} =
  interfaces::slots(
    project.root_key,
    project.packages.map(|package: DependencyPackage| package.root),
  )

pub type Phases = { read_ms: Int, front_end_ms: Int, store_ms: Int }

pub type Session<a> = {
  paths: List<paths::ResolvedPath>,
  project: Project,
  place: ProgramPlace,
  inputs: LoadInputs,
  modules: Modules,
  summary: ProgramSummary,
  warnings: List<Diagnostic>,
  value: a,
  tallies: List<QueryStats>,
  missing_results: Int,
  phases: Phases,
}

pub type Refusal = {
  diagnostics: List<Diagnostic>,
  places: List<SourceText>,
  tallies: List<QueryStats>,
  missing_results: Int,
  phases: Phases,
}

type Reached<a> = {
  read: ProgramSummary,
  packaged: List<Diagnostic>,
  rejected: List<Diagnostic>,
  warnings: List<Diagnostic>,
  value: Option<a>,
  mismatches: List<Diagnostic>,
}

fn root_of_inputs(project: Project, w: LoadInputs) -> List<Bytes> =
  w.own.take(project.sources.len())

fn reached<a>(
  project: Project,
  tree: ToolchainTree,
  w: LoadInputs,
  published: List<interfaces::SlotInterface>,
  work: (Modules, ProgramSummary) -> a / {memo.read, fact_inspection.read, abort.raise},
) -> Reached<a> / {memo.read, fact_inspection.read, abort.raise} = {
  let read = view::summary(w.own);
  let root = root_of_inputs(project, w);
  let packaged = packages_rejected(
    packages_of(project),
    root,
    project_sources(project).modules.len(),
    tree,
  );
  let rejected = if packaged.len() > 0 { [] } else { view::rejections(w.own, read) };
  if packaged.len() > 0 || rejected.len() > 0 {
    {
      read: read,
      packaged: packaged,
      rejected: rejected,
      warnings: [],
      value: None,
      mismatches: [],
    }
  } else {
    {
      read: read,
      packaged: [],
      rejected: [],
      warnings: view::warnings(root, read),
      value: Some(work({ root: root.len(), own: w.own, pulled: read.pulled }, read)),
      mismatches: interfaces::rederive_mismatches(published, w.own),
    }
  }
}

fn pulled_place(name: Bytes) -> SourceText / {fs.read_file[shipped]} =
  {
    path: pseudo_path(String::of_bytes_lossy(name)),
    text: match shipped_text(name) { Some(t) -> t, None -> b"" },
  }

pub fn places_of<a>(s: Session<a>) -> List<SourceText> / {fs.read_file[shipped]} = {
  let own = project_sources(s.project);
  own.modules.concat(s.modules.pulled.map(pulled_place)).concat(own.manifests)
}

fn refused_before(
  places: List<SourceText>,
  diagnostics: List<Diagnostic>,
  read_ms: Int,
) -> Refusal =
  {
    diagnostics: diagnostics,
    places: places,
    tallies: [],
    missing_results: 0,
    phases: { read_ms: read_ms, front_end_ms: 0, store_ms: 0 },
  }

pub fn session<a>(
  paths: List<paths::ResolvedPath>,
  verify: Bool,
  work: (Modules, ProgramSummary) -> a / {memo.read, fact_inspection.read, abort.raise},
) -> Result<Session<a>, Refusal> / {project_store::Databases, shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], ProjectFiles, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], Derives, progress.write, abort.raise, diverges} = {
  let started = time.elapsed_ms();
  session_over(paths, load_resolved(paths), started, verify, work)
}

pub fn session_over<a>(
  paths: List<paths::ResolvedPath>,
  project: Project,
  started: Int,
  verify: Bool,
  work: (Modules, ProgramSummary) -> a / {memo.read, fact_inspection.read, abort.raise},
) -> Result<Session<a>, Refusal> / {project_store::Databases, shipped.read_pack, toolchain.reuse_dir, ProjectFiles, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], Derives, progress.write, abort.raise} = {
  let read_ms = time.elapsed_ms() - started;
  match ((project.diagnostics, toolchain_tree_of(paths))) {
    ([_, ..], _) -> Err(refused_before(own_places(project), project.diagnostics, read_ms)),
    ([], Err(mixed)) -> Err(refused_before(own_places(project), [mixed], read_ms)),
    ([], Ok(tree)) -> if project.sources.len() == 0 {
      Err(
        refused_before(
          [],
          [no_ply_files(match paths.at(0) { Some(r) -> r.display, None -> "." })],
          read_ms,
        ),
      )
    } else { opened_over(paths, project, started, read_ms, verify, tree, work) },
  }
}

fn toolchain_tree_of(paths: List<paths::ResolvedPath>) -> Result<ToolchainTree, Diagnostic> =
  match paths {
    [] -> Ok(NoTree),
    [first, ..rest] -> if rest.all(|r: paths::ResolvedPath| r.part == first.part) {
      Ok(toolchain_tree(first.part))
    } else { Err(parts_mixed(paths)) },
  }

fn parts_mixed(paths: List<paths::ResolvedPath>) -> Diagnostic =
  error_unplaced(
    b"E0502",
    b"the paths lie in different parts of the toolchain",
    b"name paths in one part at a time",
    paths.map(|r: paths::ResolvedPath|
      Bytes::of_string(
        "`" ++ r.display ++ "` "
          ++ (match r.part {
            None -> "is in no part of the toolchain",
            Some(role) -> "is in the `" ++ prefix_of(role) ++ "` part",
          }),
      )),
  )

fn opened_over<a>(
  paths: List<paths::ResolvedPath>,
  project: Project,
  started: Int,
  read_ms: Int,
  verify: Bool,
  tree: ToolchainTree,
  work: (Modules, ProgramSummary) -> a / {memo.read, fact_inspection.read, abort.raise},
) -> Result<Session<a>, Refusal> / {project_store::Databases, shipped.read_pack, toolchain.reuse_dir, ProjectFiles, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], Derives, progress.write, abort.raise} = {
  let published = if verify { interfaces::published_interfaces(slots_of(project)) } else { [] };
  let place = { project: project, store: paths.at(0) };
  let opened = in_program_store(place, |w: LoadInputs| reached(project, tree, w, published, work));
  let own = project_sources(project);
  let phases = {
    read_ms: read_ms,
    front_end_ms: time.elapsed_ms() - started - read_ms,
    store_ms: 0,
  };
  let refused = |places: List<SourceText>, diagnostics: List<Diagnostic>|
    Err({
      diagnostics: diagnostics,
      places: places,
      tallies: opened.tallies,
      missing_results: opened.missing_results,
      phases: phases,
    });
  let reach = opened.value;
  match reach.value {
    None -> if reach.packaged.len() > 0 {
      refused(own.modules.concat(own.manifests), reach.packaged)
    } else {
      refused(
        own.modules.concat(reach.read.pulled.map(pulled_place)).concat(own.manifests),
        reach.rejected,
      )
    },
    Some(value) -> {
      let opened_session = {
        paths: paths,
        project: project,
        place: place,
        inputs: opened.inputs,
        modules: { root: project.sources.len(), own: opened.inputs.own, pulled: reach.read.pulled },
        summary: reach.read,
        warnings: reach.warnings.concat(project_store::problem_diagnostics(opened.problems)),
        value: value,
        tallies: opened.tallies,
        missing_results: opened.missing_results,
        phases: phases,
      };
      if reach.mismatches.len() > 0 { refused(own.modules.concat(own.manifests), reach.mismatches) }
      else { Ok(opened_session) }
    },
  }
}

pub fn manifest_of(project: Project) -> Option<Manifest> / {abort.raise} =
  closure(packages_of(project), project.sources.map(|s: Source| s.name)).packages.get(0).manifest

pub type Pinned = { pins: List<LockedPackage>, packages: PackageSources }

pub fn pins_of(
  project: Project,
) -> Result<Pinned, { diagnostics: List<Diagnostic>, places: List<SourceText> }> / {ProjectFiles, abort.raise} =
  if project.diagnostics.len() > 0 {
    Err({ diagnostics: project.diagnostics, places: own_places(project) })
  } else {
    let packages = packages_of(project);
    match locked_packages(
        project.sources,
        packages,
        embeds_parsed(project).map(|e: Embed| e.embedded),
      ) {
      Ok(pins) -> Ok({ pins: pins, packages: packages }),
      Err(diagnostics) -> {
        let own = project_sources(project);
        Err({ diagnostics: diagnostics, places: own.modules.concat(own.manifests) })
      },
    }
  }

pub fn pins_for(
  paths: List<paths::ResolvedPath>,
) -> Result<Pinned, { diagnostics: List<Diagnostic>, places: List<SourceText> }> / {builder.git[vcs], ProjectFiles, abort.raise, diverges} =
  pins_of(load_resolved(paths))

pub fn embeds_of<a>(s: Session<a>, embeds: List<ModuleEmbed>) -> List<Embed> / {abort.raise} =
  module_queries::own_embeds(s.project, s.inputs, embeds)

pub fn unchanged(
  project: Project,
  before: Project,
  embeds: List<Embed>,
) -> Bool / {ProjectFiles, abort.raise} =
  project.diagnostics.len() == 0 && project.files == before.files
    && packages_of(project) == packages_of(before)
    && !embeds_changed(embeds)

pub fn modules_of(
  places: List<SourceText>,
  outlines: List<Outline>,
) -> List<ModuleView> / {abort.raise} =
  range(0, outlines.len()).map(|i: Int|
    {
      name: String::of_bytes_lossy(outlines.get(i).name),
      path: match places.at(i) { Some(place) -> place.path, None -> "" },
    })

pub fn module_reports(
  places: List<SourceText>,
  outlines: List<Outline>,
) -> List<ModuleReport> / {abort.raise} =
  range(0, outlines.len()).map(|i: Int| {
    let o = outlines.get(i);
    {
      index: i,
      name: String::of_bytes_lossy(o.name),
      path: match places.at(i) { Some(place) -> place.path, None -> "" },
      imports: o.imports.map(String::of_bytes_lossy),
      items: o.declared.map(String::of_bytes_lossy),
    }
  })

pub fn sources_of(
  places: List<SourceText>,
  outlines: List<Outline>,
) -> List<Source> / {abort.raise} =
  range(0, outlines.len()).map(|i: Int|
    {
      name: outlines.get(i).name,
      source_text: match places.at(i) { Some(place) -> place.text, None -> b"" },
    })

pub fn own_hashed_tests(listing: ProgramListing) -> List<HashedTest> =
  listing.tests.filter(|listed: HashedTest| listed.info.at.module < listing.root)

pub fn own_tests(listing: ProgramListing) -> List<TestInfo> =
  own_hashed_tests(listing).map(|listed: HashedTest| listed.info)

pub fn own_laws(listing: ProgramListing) -> List<LawInfo> =
  listing.checked.laws.filter(|law_info: LawInfo| law_info.at.module < listing.root)

pub fn place_of(places: List<SourceText>, location: Location) -> Option<SourceText> =
  places.at(location.module)

pub fn location_of(places: List<SourceText>, location: Location) -> Option<String> / {abort.raise} =
  match place_of(places, location) {
    None -> None,
    Some(place) -> {
      let spot = position_of(place.text, location.span.start);
      Some(place.path ++ ":" ++ spot.line.to_string() ++ ":" ++ spot.column.to_string())
    },
  }

type DefinitionSelection = { seen: Set<Bytes>, out: List<DefinitionInfo> }

fn pick(
  accumulator: DefinitionSelection,
  by_name: Map<Bytes, DefinitionInfo>,
  name: Bytes,
) -> DefinitionSelection =
  if accumulator.seen.contains(name) { accumulator } else {
    match by_name.get(name) {
      None -> accumulator,
      Some(d) -> { seen: accumulator.seen.insert(name), out: accumulator.out.push(d) },
    }
  }

fn module_functions(accumulator: List<Bytes>, o: Outline) -> List<Bytes> =
  o.items.fold(accumulator, |a: List<Bytes>, it: OutlineItem|
    match it { OutlinedFunction(f) -> a.push(qualify(o.name, f.name)), _ -> a })

pub fn definitions_in_order(view: ProgramListing) -> List<DefinitionInfo> = {
  let by_name = view.checked.definitions.fold(
    Map::new(),
    |accumulator: Map<Bytes, DefinitionInfo>, definition_info: DefinitionInfo|
      accumulator.insert(definition_info.name, definition_info),
  );
  let a_definition = view.outlines.fold([], module_functions);
  let first: DefinitionSelection = a_definition.fold(
    { seen: Set::empty(), out: [] },
    |accumulator: DefinitionSelection, name: Bytes| pick(accumulator, by_name, name),
  );
  let all: DefinitionSelection = view.checked.definitions.fold(
    first,
    |accumulator: DefinitionSelection, definition_info: DefinitionInfo|
      pick(accumulator, by_name, definition_info.name),
  );
  all.out
}

pub fn resolve_definition(
  definitions: List<DefinitionInfo>,
  query: String,
) -> Result<DefinitionInfo, List<String>> = {
  let exact = definitions.fold(None, |accumulator: Option<DefinitionInfo>, d: DefinitionInfo|
    match accumulator {
      Some(_) -> accumulator,
      None -> if String::of_bytes_lossy(d.name) == query { Some(d) } else { None },
    });
  match exact {
    Some(d) -> Ok(d),
    None -> {
      let matching = definitions.filter(|d: DefinitionInfo|
        String::of_bytes_lossy(d.simple_name) == query);
      match matching.at(0) {
        None -> Err([]),
        Some(d) -> if matching.len() == 1 { Ok(d) }
        else { Err(matching.map(|x: DefinitionInfo| String::of_bytes_lossy(x.name))) },
      }
    },
  }
}

pub fn unknown_definition(query: String, names: List<String>) -> Diagnostic =
  if names.len() == 0 {
    error_unplaced(
      unknown_name_code,
      Bytes::of_string("no definition is named `" ++ query ++ "`"),
      b"not a definition of this program",
      [
        b"the query is a program-wide name such as `store.orders.place`, or a simple name unique in the program",
      ],
    )
  } else {
    error_unplaced(
      unknown_name_code,
      Bytes::of_string("`" ++ query ++ "` names " ++ names.len().to_string() ++ " definitions"),
      b"say which",
      [Bytes::of_string("one of: " ++ String::join(names, ", "))],
    )
  }

pub fn with_note(diagnostic: Diagnostic, note: Bytes) -> Diagnostic =
  { ..diagnostic, notes_text: diagnostic.notes_text.push(note) }

pub type Tables = { definitions: Map<Bytes, Bytes>, specs: Map<Bytes, Int>, hashes: HashOutput }

pub fn tables_of(h: HashOutput) -> Tables =
  {
    definitions: h.definitions.fold(
      Map::new(),
      |accumulator: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
        accumulator.insert(x.name, x.hash),
    ),
    specs: h.specs.fold(
      Map::new(),
      |accumulator: Map<Bytes, Int>, x: { name: Bytes, hashes: List<Bytes> }|
        accumulator.insert(x.name, x.hashes.len()),
    ),
    hashes: h,
  }

pub fn hash_of(tables: Tables, name: Bytes) -> Option<String> / {abort.raise} =
  match tables.definitions.get(name) {
    Some(h) -> Some(String::of_bytes_lossy(hex(h))),
    None -> None,
  }

pub fn dependencies_of(tables: Tables, which: Subject) -> List<String> / {abort.raise} =
  forms::references_in(tables.hashes, which).fold([], |accumulator: List<Bytes>, r: NodeRef|
    accumulator.push_unique(r.name)).map(|n: Bytes| String::of_bytes_lossy(n))

pub fn closure_of(tables: Tables, which: Subject) -> List<String> / {abort.raise} = {
  let reached = forms::reach(tables.hashes, [which]);
  reached.functions.union(reached.declarations).elements().map(|n: Bytes| String::of_bytes_lossy(n))
}

pub fn transitive_callers(tables: Tables, name: Bytes) -> List<Bytes> / {abort.raise} = {
  let n = forms::find_referrers(tables.hashes, FunctionNamed(name), true);
  n.functions.concat(n.items)
}

pub fn direct_callers(tables: Tables, name: Bytes) -> List<Bytes> / {abort.raise} = {
  let n = forms::find_referrers(tables.hashes, FunctionNamed(name), false);
  n.functions.concat(n.items)
}

pub fn specialization_count(tables: Tables, name: Bytes) -> Int =
  match tables.specs.get(name) { Some(n) -> n, None -> 0 }

pub fn short_of(hex_text: String) -> String / {abort.raise} = hex_text.slice(0, 12)

test "`pseudo_path` gives a built-in module a placeholder file path such as `<std>/json.ply`, which no user file can have" {
  assert_eq(pseudo_path("std.json"), "<std>/json.ply");
  assert_eq(pseudo_path("std.http.server"), "<std>/http/server.ply");
  assert_eq(pseudo_path("compiler.fmt"), "<compiler>/fmt.ply")
}

fn a_definition(name: Bytes, simple: Bytes) -> DefinitionInfo =
  {
    name: name,
    module: b"m",
    simple_name: simple,
    scheme: {
      type_variables: [],
      effect_variables: [],
      keep_variables: [],
      label_variables: [],
      ty: FunctionType({
        keep_parameters: [],
        once: false,
        params: [],
        return_type: NamedType({ name: b"Int", args: [] }),
        effects: { listed: [], variable: None },
      }),
    },
    effects: [],
    performed: [],
    removable: [],
    effects_source: WrittenEffects,
    scaling: [],
    repeats: [],
    promised_bounded: [],
    variable_bounded: false,
    ending: Terminates,
    summary: unknown_summary,
    raises: [],
    effect_aliases: [],
    constraints: [],
    spec: [],
    at: { module: 0, span: generated_span },
  }

test "`resolve_definition` accepts a fully qualified name, or a short name that matches exactly one definition" {
  let definitions = [
    a_definition(b"a.total", b"total"),
    a_definition(b"b.total", b"total"),
    a_definition(b"a.one", b"one"),
  ];
  assert_eq(
    match resolve_definition(definitions, "a.total") { Ok(d) -> d.name, Err(_) -> b"" },
    b"a.total",
  );
  assert_eq(
    match resolve_definition(definitions, "one") { Ok(d) -> d.name, Err(_) -> b"" },
    b"a.one",
  );
  assert_eq(match resolve_definition(definitions, "total") { Ok(_) -> [], Err(ns) -> ns }, [
    "a.total",
    "b.total",
  ]);
  assert_eq(
    match resolve_definition(definitions, "absent") { Ok(_) -> ["found"], Err(ns) -> ns },
    [],
  )
}

test "an unknown definition name gives `E0101`, and a short name matching several definitions lists the candidates" {
  assert_eq(unknown_definition("absent", []).code, b"E0101");
  assert_eq(unknown_definition("absent", []).message, b"no definition is named `absent`");
  let many = unknown_definition("total", ["a.total", "b.total"]);
  assert_eq(many.message, b"`total` names 2 definitions");
  assert_eq(many.notes_text, [b"one of: a.total, b.total"]);
  assert_eq(with_note(many, b"and one more").notes_text.len(), 2)
}

test "a directory walk lists the root package's modules first and lists each package's manifest separately from its modules" {
  let project = {
    files: [
      {
        path: "main.ply",
        module: "main",
        text: b"fn main() -> Int = 1\n",
        at: { label: paths::WorkingDirectory, path: "main.ply" },
      },
      {
        path: "util.ply",
        module: "util",
        text: b"pub fn one() -> Int = 1\n",
        at: { label: paths::WorkingDirectory, path: "util.ply" },
      },
    ],
    sources: [],
    diagnostics: [],
    manifest: Some({
      path: "ply.pkg",
      module: "",
      text: b"fn package() -> Manifest = app()\n",
      at: { label: paths::WorkingDirectory, path: "ply.pkg" },
    }),
    packages: [
      {
        root: "/w/lib",
        dir: "/w/lib",
        manifest: Some(b"fn package() -> Manifest = lib()\n"),
        files: [
          {
            path: "/w/lib/deep.ply",
            module: "deep",
            text: b"pub fn deep() -> Int = 7\n",
            at: { label: paths::WorkingDirectory, path: "/w/lib/deep.ply" },
          },
        ],
      },
    ],
    root_key: "/w/app",
  };
  let w: ProjectSources = project_sources(project);
  assert_eq(w.modules.map(|p: SourceText| p.path), ["main.ply", "util.ply", "/w/lib/deep.ply"]);
  assert_eq(w.manifests.map(|p: SourceText| p.path), ["ply.pkg", "/w/lib/ply.pkg"])
}

test "`location_of` returns `None` for a span that belongs to no module, and a file, line and column for a real span" {
  let p = [{ path: "m.ply", text: b"fn f() -> Int = 1\n" }];
  assert_eq(location_of(p, { module: module_elsewhere, span: generated_span }), None);
  assert_eq(location_of(p, { module: 0, span: span_between(3, 4) }), Some("m.ply:1:4"))
}
