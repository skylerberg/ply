pub type Program = {
  files: List<File>,
  read_at: List<paths::RootedPath>,
  source_texts: List<SourceText>,
  diagnostics: List<Diagnostic>,
  frame: Option<Frame>,
  returned: Map<Bytes, ModuleResult>,
  reads: TableReads,
  whole: Option<Analysis>,
  sources: List<Source>,
  modules: List<ModuleHashes>,
  packages: PackageSources,
  embeds: List<Embed>,
  inputs: Map<Bytes, Bytes>,
  shipping: ShippedInputs,
  prune_unreached: Bool,
  shipped_views: List<ShippedModuleSummary>,
  tallies: List<QueryStats>,
  missing_results: Int,
}

pub type ModuleView = { name: String, path: String }

pub type ModuleReport = {
  index: Int,
  name: String,
  path: String,
  imports: List<String>,
  items: List<String>,
}

pub type TimedLoad = {
  program: Program,
  read_ms: Int,
  front_end_ms: Int,
  store_ms: Int,
  cached: Bool,
}

fn without_first(segments: List<String>) -> List<String> =
  range(1, segments.len()).fold([], |accumulator: List<String>, i: Int|
    match segments.at(i) { Some(s) -> accumulator.push(s), None -> accumulator })

pub fn pseudo_path(name: String) -> String = {
  let segments = name.split(".");
  match segments.at(0) {
    None -> name,
    Some(root) -> "<" ++ root ++ ">/" ++ String::join(without_first(segments), "/") ++ ".ply",
  }
}

fn shipped_place(texts: Map<String, Bytes>, name: String) -> SourceText =
  { path: pseudo_path(name), text: match texts.get(name) { Some(t) -> t, None -> b"" } }

fn failed_program(
  project: Project,
  shipping: ShippedInputs,
  places: List<SourceText>,
  diagnostics: List<Diagnostic>,
) -> Program =
  {
    files: project.files,
    read_at: read_paths(project),
    source_texts: places,
    diagnostics: diagnostics,
    frame: None,
    returned: Map::new(),
    reads: no_reads(),
    whole: None,
    sources: project.sources,
    modules: [],
    packages: packages_of(project),
    embeds: [],
    inputs: Map::new(),
    shipping: shipping,
    prune_unreached: true,
    shipped_views: [],
    tallies: [],
    missing_results: 0,
  }

pub fn no_program() -> Program =
  {
    files: [],
    read_at: [],
    source_texts: [],
    diagnostics: [],
    frame: None,
    returned: Map::new(),
    reads: no_reads(),
    whole: None,
    sources: [],
    modules: [],
    packages: { root: b"", manifest: None, supplied: [] },
    embeds: [],
    inputs: Map::new(),
    shipping: { sources: [], unread: [], data: [], required_modules: [], dependencies: [] },
    prune_unreached: true,
    shipped_views: [],
    tallies: [],
    missing_results: 0,
  }

pub fn packages_of(project: Project) -> PackageSources =
  {
    root: Bytes::of_string(project.root_key),
    manifest: match project.manifest { None -> None, Some(f) -> Some(f.text) },
    supplied: supplied(project),
  }

fn own_places(project: Project) -> List<SourceText> =
  project.files.map(|file: File| { path: file.path, text: file.text })

fn supplied(project: Project) -> List<SuppliedPackage> =
  project.packages.map(|package: DependencyPackage|
    {
      root: Bytes::of_string(package.root),
      manifest: package.manifest,
      modules: package.files.map(|file: File|
        { name: Bytes::of_string(file.module), source_text: file.text }),
    })

fn read_paths(project: Project) -> List<paths::RootedPath> =
  project.files.map(|file: File| file.at).concat(
    project.packages.fold([], |accumulator: List<paths::RootedPath>, package: DependencyPackage|
      accumulator.concat(package.files.map(|file: File| file.at))),
  )

fn dependency_places(project: Project) -> List<SourceText> =
  project.packages.fold([], |accumulator: List<SourceText>, package: DependencyPackage|
    package.files.fold(accumulator, |places: List<SourceText>, file: File|
      places.push({ path: file.path, text: file.text })))

fn manifest_places(project: Project) -> List<SourceText> = {
  let dependencies = project.packages.fold(
    [],
    |accumulator: List<SourceText>, package: DependencyPackage|
      match package.manifest {
        None -> accumulator,
        Some(text) -> accumulator.push({ path: package.root ++ "/ply.pkg", text: text }),
      },
  );
  match project.manifest {
    None -> dependencies,
    Some(f) -> {
      let root: List<SourceText> = [{ path: f.path, text: f.text }];
      dependencies.fold(root, |accumulator: List<SourceText>, place: SourceText|
        accumulator.push(place))
    },
  }
}

type ProjectSources = { modules: List<SourceText>, manifests: List<SourceText> }

fn project_sources(project: Project) -> ProjectSources =
  {
    modules: own_places(project).concat(dependency_places(project)),
    manifests: manifest_places(project),
  }

pub fn front_end(
  sources: List<Source>,
  shipping: ShippedInputs,
  rows: Rows,
  packages: PackageSources,
  embeds: List<Embed>,
  prune_unreached: Bool,
  fixed: CachedHashes,
  derived: List<ModuleDerivations>,
) -> PulledAnalysis / {abort.raise} =
  analyse_pulling_std_with(
    sources,
    shipping.sources,
    rows,
    packages,
    embeds: embeds.map(|embed: Embed| embed.embedded),
    unread: shipping.unread,
    cut_unused: prune_unreached,
    data: shipping.data,
    required: shipping.required_modules,
    pulls: shipping.dependencies,
    fixed: fixed,
    derived: derived,
  )

pub fn reanalysed(
  program: Program,
  frame: Frame,
  sources: List<Source>,
  moved: Bytes,
) -> PulledAnalysis / {abort.raise} = {
  let rows = published_rows(program);
  let stale = forms::keys_referring_to(frame.hashes, Map::new().insert(moved, true));
  front_end(
    sources,
    program.shipping,
    {
      definitions: rows.definitions.filter(|r: KnownDefinitionRow| !stale.contains(r.name)),
      tests: [],
      types: rows.types,
    },
    program.packages,
    program.embeds,
    program.prune_unreached,
    no_cached_hashes(),
    module_derivations(program),
  )
}

fn analysed(
  project: Project,
  shipping: ShippedInputs,
  results: List<CheckedModule>,
  pulled: List<Bytes>,
  embeds: List<Embed>,
  inputs: Map<Bytes, Bytes>,
  prune_unreached: Bool,
  modules: List<ModuleHashes>,
) -> Program / {abort.raise} = {
  let texts = shipping.sources.fold(
    Map::new(),
    |accumulator: Map<String, Bytes>, source: Source|
      accumulator.insert(String::of_bytes_lossy(source.name), source.source_text),
  );
  let packages: PackageSources = packages_of(project);
  let warnings = root_warnings(results, project.sources.len());
  let loaded = assembled_load(
    project.sources.map(|s: Source| s.name),
    packages,
    results.fold(Map::new(), |accumulator: Map<Bytes, ModuleShape>, a: CheckedModule|
      accumulator.insert(a.module, a.result.shape)),
    joined_cached_hashes(modules),
    pulled,
    all_shipped_names(shipping),
    shipping.sources.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, source: Source|
      accumulator.insert(source.name, source.source_text)),
    true,
    prune_unreached,
    warnings,
  );
  let own = project_sources(project);
  let program = {
    files: project.files,
    read_at: read_paths(project).concat(loaded.pulled.map(shipped_path)),
    source_texts: own.modules.concat(
      loaded.pulled.map(|n: Bytes| shipped_place(texts, String::of_bytes_lossy(n))),
    ).concat(
      own.manifests,
    ),
    diagnostics: warnings,
    frame: Some(loaded.frame),
    returned: results.fold(Map::new(), |accumulator: Map<Bytes, ModuleResult>, a: CheckedModule|
      accumulator.insert(a.module, a.result)),
    reads: loaded.reads,
    whole: None,
    sources: project.sources,
    modules: modules,
    packages: packages,
    embeds: embeds,
    inputs: inputs,
    shipping: shipping,
    prune_unreached: prune_unreached,
    shipped_views: loaded.views,
    tallies: [],
    missing_results: 0,
  };
  let owned = project.sources.fold(Map::new(), |accumulator: Map<Bytes, Bool>, source: Source|
    accumulator.insert(source.name, true));
  let mine = |m: Bytes| owned.contains(m);
  let own = loaded.frame.outlines.take(project.files.len());
  let any_function = |pick: (FunctionOutline) -> Bool|
    own.fold(false, |b: Bool, o: Outline|
      b
        || o.items.fold(false, |m: Bool, item: OutlineItem|
          m || (match item { OutlinedFunction(f) -> pick(f), _ -> false })));
  let measured = any_function(|f: FunctionOutline| f.measured);
  if !measured && !any_function(|f: FunctionOutline| f.reuse || f.returns) { program } else {
    let rejected = |ds: List<Diagnostic>| { ..program, diagnostics: ds, frame: None };
    match whole_of(program) {
      Err(ds) -> rejected(ds),
      Ok(w) -> match if measured { unproved_measures(w, mine) } else { [] } {
        [] -> { ..program, whole: Some(w) },
        missing -> rejected(missing.map(unproved_measure)),
      },
    }
  }
}

fn uses_statement_modules(own: List<Outline>) -> Bool =
  own.fold(false, |b: Bool, o: Outline|
    b
      || statement_modules().fold(false, |m: Bool, n: Bytes|
        m || o.name == n || o.imports.contains(n)))

pub fn runs_statements(program: Program, frame: Frame) -> Bool =
  uses_statement_modules(frame.outlines.take(program.files.len()))

pub fn module_derivations(program: Program) -> List<ModuleDerivations> =
  program.returned.fold([], |accumulator: List<ModuleDerivations>, _: Bytes, a: ModuleResult| {
    let outline = a.shape.outline;
    if outline.derived.len() == 0 { accumulator }
    else { accumulator.push({ module: outline.name, derivations: outline.derived }) }
  })

fn published_rows(program: Program) -> Rows / {abort.raise} =
  program.returned.fold(no_rows(), |accumulator: Rows, _: Bytes, a: ModuleResult| {
    let rows = rows_of_result(a);
    {
      definitions: accumulator.definitions.concat(rows.definitions),
      tests: accumulator.tests.concat(rows.tests),
      types: tables_joined(accumulator.types, rows.types),
    }
  })

pub fn own_diagnostics(diagnostics: List<Diagnostic>, frame: Frame) -> List<Diagnostic> =
  diagnostics.filter(|diagnostic: Diagnostic|
    !diagnostic.labels.any(|l: Label|
      l.primary && is_shipped_module(frame.packages, frame.module_packages, l.module)))

pub fn program_view(program: Program) -> Option<CheckedProgram> / {abort.raise} =
  match program.frame {
    None -> None,
    Some(f) -> Some(checked_program_from_results(f, program.reads, program.returned)),
  }

pub fn whole_of(program: Program) -> Result<Analysis, List<Diagnostic>> / {abort.raise} =
  match ((program.frame, program.whole)) {
    (None, _) -> Err(program.diagnostics),
    (Some(_), Some(w)) -> Ok(w),
    (Some(f), None) -> match front_end(
        program.sources,
        program.shipping,
        published_rows(program),
        program.packages,
        program.embeds,
        program.prune_unreached,
        joined_cached_hashes(program.modules),
        module_derivations(program),
      ).out {
      Rejected(ds) -> Err(ds),
      Analysed(w) -> Ok({ ..w, warnings: f.warnings }),
    },
  }

pub type ParsedSources = Map<Bytes, ParsedSource>

pub type Unresolved = { diagnostics: List<Diagnostic>, modules: List<Source> }

fn parsed_into<| e>(
  parses: ParsedSources,
  sources: List<Source>,
  parsing: (Source) -> ParsedSource / {abort.raise | e},
) -> ParsedSources / {abort.raise | e} =
  sources.fold(parses, |accumulator: ParsedSources, s: Source|
    match accumulator.get(s.name) {
      Some(p) -> if p.text == s.source_text { accumulator }
      else { accumulator.insert(s.name, parsing(s)) },
      None -> accumulator.insert(s.name, parsing(s)),
    })

fn resolved_from(
  sources: List<Source>,
  shipping: ShippedInputs,
  packages: PackageSources,
  embeds: List<Embed>,
  parses: ParsedSources,
) -> Result<ResolvedProgram, Unresolved> / {abort.raise} =
  resolved_with_shipped(
    sources,
    shipping.sources,
    packages,
    embeds.map(|embed: Embed| embed.embedded),
    shipping.unread,
    shipping.data,
    shipping.required_modules,
    shipping.dependencies,
    parses.values(),
  )

fn supplied_sources(
  sources: List<Source>,
  packages: PackageSources,
) -> List<Source> / {abort.raise} =
  closure(packages, sources.map(|s: Source| s.name)).modules.map(
    |m: { pkg: Int, source: Source }| m.source,
  )

pub fn resolution_of(
  program: Program,
  parses: ParsedSources,
) -> { resolved: Result<ResolvedProgram, List<Diagnostic>>, parses: ParsedSources } / {abort.raise} =
  match program.frame {
    None -> { resolved: Err(program.diagnostics), parses: parses },
    Some(_) -> {
      let derived = module_derivations(program);
      let now = parsed_into(
        parses,
        program.sources.concat(supplied_sources(program.sources, program.packages)).concat(
          program.shipping.sources,
        ),
        |s: Source|
          parse_from(
            0,
            s,
            parse(s.source_text),
            derivations: match derived.find(|m: ModuleDerivations| m.module == s.name) {
              Some(m) -> m.derivations,
              None -> [],
            },
          ),
      );
      {
        resolved: match resolved_from(
            program.sources,
            program.shipping,
            program.packages,
            program.embeds,
            now,
          ) {
          Ok(p) -> Ok(p),
          Err(u) -> Err(u.diagnostics),
        },
        parses: now,
      }
    },
  }

pub fn renamed_resolution(
  paths: List<paths::ResolvedPath>,
  shipping: ShippedInputs,
  parses: ParsedSources,
) -> { resolved: Result<ResolvedProgram, Unresolved>, parses: ParsedSources } / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], Derives, abort.raise, diverges} = {
  let project: Project = load_resolved(paths);
  if project.diagnostics.len() > 0 {
    { resolved: Err({ diagnostics: project.diagnostics, modules: [] }), parses: parses }
  } else {
    let packages = packages_of(project);
    let own = project.sources.concat(supplied_sources(project.sources, packages));
    let names = own.fold(Map::new(), |accumulator: Map<Bytes, Bool>, s: Source|
      accumulator.insert(s.name, true));
    let texts = project.sources.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, s: Source|
      accumulator.insert(s.name, s.source_text));
    let shipped = {
      ..shipping,
      sources: shipping.sources.filter(|s: Source| !names.contains(s.name)),
      unread: shipping.unread.concat(
        shipping.sources.filter(|s: Source| names.contains(s.name)).map(|s: Source| s.name),
      ),
    };
    let now = parsed_into(parses, own.concat(shipped.sources), |s: Source|
      parse_from(
        0,
        s,
        parse(s.source_text),
        library: Some(|ask: DeriverRequest| derivation_result(ask, texts)),
      ));
    {
      resolved: resolved_from(project.sources, shipped, packages, embeds_parsed(project), now),
      parses: now,
    }
  }
}

fn unproved_measure(u: UnprovedMeasure) -> Diagnostic =
  error_at(
    b"E0467",
    u.measure.at.module,
    span_between(u.measure.at.start, u.measure.at.end),
    Bytes::of_string(
      "the measure of `" ++ u.measure.owner
        ++ "` is not proved to decrease at every recursive call, including calls between definitions that call each other",
    ),
    b"the checker cannot prove that this `measure` decreases",
    u.reason.map(Bytes::of_string).push(if u.descends {
      b"the checker can see that the definition ends without the measure, so remove the `measure` clause"
    } else {
      b"a definition is read as ending on its measure only once a proof shows it; restructure it so the checker sees it descend, or state a measure a proof can follow"
    }),
  )

fn usable(project: Project) -> Bool = project.diagnostics.len() == 0 && project.sources.len() > 0

fn assembled(
  project: Project,
  shipping: ShippedInputs,
  paths: List<paths::ResolvedPath>,
  q: QueryResults,
) -> Program / {abort.raise} =
  {
    ..assembled_from(project, shipping, paths, q, true),
    tallies: q.tallies,
    missing_results: q.missing_results,
  }

fn assembled_from(
  project: Project,
  shipping: ShippedInputs,
  paths: List<paths::ResolvedPath>,
  q: QueryResults,
  prune_unreached: Bool,
) -> Program / {abort.raise} = {
  let results = q.results;
  if project.diagnostics.len() > 0 {
    failed_program(project, shipping, own_places(project), project.diagnostics)
  } else if project.sources.len() == 0 {
    failed_program(project, shipping, [], [
      no_ply_files(match paths.at(0) { Some(r) -> r.display, None -> "." }),
    ])
  } else {
    let first = rejected_first(results).fold(
      Map::new(),
      |accumulator: Map<Bytes, Bool>, a: CheckedModule| accumulator.insert(a.module, true),
    );
    let own = project_sources(project);
    let packaged = packages_rejected(
      packages_of(project),
      project.sources.map(|s: Source| s.name),
      own.modules.len(),
      shipping.sources.map(|s: Source| s.name).concat(shipping.unread),
    );
    if packaged.len() > 0 {
      failed_program(project, shipping, own.modules.concat(own.manifests), packaged)
    } else if first.len() > 0 {
      let texts = shipping.sources.fold(
        Map::new(),
        |accumulator: Map<String, Bytes>, source: Source|
          accumulator.insert(String::of_bytes_lossy(source.name), source.source_text),
      );
      let pulled = results.drop(own.modules.len()).map(|a: CheckedModule|
        shipped_place(texts, String::of_bytes_lossy(a.module)));
      let diagnostics = range(0, results.len()).fold([], |accumulator: List<Diagnostic>, i: Int| {
        let a = results.get(i);
        if !first.contains(a.module) { accumulator } else {
          accumulator.concat(
            a.result.rejected.map(|d: Diagnostic|
              { ..d, labels: d.labels.map(|l: Label| { ..l, module: i }) }),
          )
        }
      });
      failed_program(
        project,
        shipping,
        own.modules.concat(pulled).concat(own.manifests),
        diagnostics,
      )
    } else {
      match q.inputs {
        Err(moved) -> failed_program(project, shipping, own.modules.concat(own.manifests), moved),
        Ok(inputs) ->
          analysed(
            project,
            shipping,
            results,
            q.pulled,
            q.embeds,
            inputs,
            prune_unreached,
            q.modules,
          ),
      }
    }
  }
}

fn slots_of(project: Project) -> List<String> / {abort.raise} =
  interfaces::slots(
    project.root_key,
    project.packages.map(|package: DependencyPackage| package.root),
  )

fn verified(
  project: Project,
  shipping: ShippedInputs,
  verify: Bool,
  program: Program,
) -> Program / {fs.read_file[abs], abort.raise} =
  if !verify || program.frame == None { program } else {
    match whole_of(program) {
      Err(ds) -> { ..program, diagnostics: ds, frame: None },
      Ok(w) -> match interfaces::rederive_mismatches(
          slots_of(project),
          interfaces::dependency_sources(
            packages_of(project),
            project.sources.map(|source: Source| source.name),
          ),
          w,
        ) {
        [] -> program,
        rejected -> { ..program, diagnostics: program.diagnostics.concat(rejected), frame: None },
      },
    }
  }

fn source_files(program: Program, frame: Frame) -> List<SourceFile> / {abort.raise} = {
  let a_definition = modules_of(program, frame);
  range(0, program.source_texts.len()).map(|i: Int|
    {
      path: match program.source_texts.at(i) { Some(place) -> place.path, None -> "" },
      name: match a_definition.at(i) { Some(m) -> m.name, None -> "pkg" },
      text: match program.source_texts.at(i) { Some(place) -> place.text, None -> b"" },
    })
}

fn check_modules(
  paths: List<paths::ResolvedPath>,
  project: Project,
) -> QueryResults / {fs.list_dir[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], fs.read_file[shipped], shipped.read_pack, Derives, abort.raise} =
  if !usable(project) { module_queries::nothing() } else {
    match paths.at(0) {
      None -> module_queries::query_uncached(project),
      Some(r) -> {
        let dir = paths::in_root(r, ".ply-cache/memo").path;
        if r.label == "cwd" { module_queries::query_through_store[cwd](dir, project) }
        else { module_queries::query_through_store[abs](dir, project) }
      },
    }
  }

pub fn doc_pages(
  paths: List<paths::ResolvedPath>,
  project: Project,
  selected_modules: List<ModuleKey>,
) -> List<Pages> / {fs.list_dir[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} =
  match ((usable(project), paths.at(0))) {
    (true, Some(r)) -> {
      let dir = paths::in_root(r, ".ply-cache/memo").path;
      if r.label == "cwd" { module_queries::doc_pages[cwd](dir, project, selected_modules) }
      else { module_queries::doc_pages[abs](dir, project, selected_modules) }
    },
    _ -> [],
  }

pub fn clean_summary(
  paths: List<paths::ResolvedPath>,
) -> Option<ProgramSummary> / {shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, Derives, abort.raise, diverges} = {
  let project: Project = load_resolved(paths);
  match ((usable(project), paths.at(0))) {
    (true, Some(r)) -> {
      let dir = paths::in_root(r, ".ply-cache/memo").path;
      let summary = if r.label == "cwd" { module_queries::checked_summary[cwd](dir, project) }
      else { module_queries::checked_summary[abs](dir, project) };
      let current = !summary.checked_later
        || (if r.label == "cwd" { memo_files::product_is_current[cwd](dir, "later checks") }
        else { memo_files::product_is_current[abs](dir, "later checks") });
      let layout_fine = packages_rejected(
        packages_of(project),
        project.sources.map(|s: Source| s.name),
        project_sources(project).modules.len(),
        summary.pulled,
      ).len() == 0;
      if summary.clean && current && layout_fine { Some(summary) } else { None }
    },
    _ -> None,
  }
}

pub fn later_checks_passed(
  paths: List<paths::ResolvedPath>,
) -> Unit / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], abort.raise} =
  match paths.at(0) {
    None -> (),
    Some(r) -> {
      let dir = paths::in_root(r, ".ply-cache/memo").path;
      if r.label == "cwd" { memo_files::product_read_log[cwd](dir, "later checks") }
      else { memo_files::product_read_log[abs](dir, "later checks") }
    },
  }

fn check_modules_uncached(
  project: Project,
) -> QueryResults / {shipped.read_pack, fs.list_dir[shipped], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], Derives, abort.raise} =
  if !usable(project) { module_queries::nothing() } else { module_queries::query_uncached(project) }

pub fn load_program(
  paths: List<paths::ResolvedPath>,
  verify: Bool,
) -> Program / {shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, Derives, abort.raise, diverges} = {
  let project: Project = load_resolved(paths);
  let results = check_modules(paths, project);
  let shipping = shipping_cached(results.pulled, results.wants);
  let p: Program = verified(
    project,
    shipping,
    verify,
    assembled(project, shipping, paths, results),
  );
  report_viewed(p.shipped_views, true);
  p
}

pub fn unchecked_program(
  paths: List<paths::ResolvedPath>,
  shipping: ShippedInputs,
) -> Program / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise, diverges} = {
  let project: Project = load_resolved(paths);
  failed_program(project, shipping, own_places(project), project.diagnostics)
}

pub fn pins_for(
  paths: List<paths::ResolvedPath>,
) -> Result<{ pins: List<LockedPackage>, packages: PackageSources }, { diagnostics: List<Diagnostic>, places: List<SourceText> }> / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise, diverges} = {
  let project: Project = load_resolved(paths);
  if project.diagnostics.len() > 0 {
    Err({ diagnostics: project.diagnostics, places: own_places(project) })
  } else {
    let packages = packages_of(project);
    match locked_packages(
        project.sources,
        packages,
        embeds_parsed(project).map(|e: Embed| e.embedded),
      ) {
      Ok(pins) -> Ok({ pins: pins, packages: packages }),
      Err(diagnostics) -> {
        let own = project_sources(project);
        Err({ diagnostics: diagnostics, places: own.modules.concat(own.manifests) })
      },
    }
  }
}

pub fn loaded_analysis(
  timed: TimedLoad,
  view: CheckedProgram,
  within: Option<TestRunScope> = None,
) -> LoadedAnalysis / {abort.raise} = {
  {
    dump: view_dump(
      { ..view, frame: { ..view.frame, warnings: timed.program.diagnostics } },
      within,
    ),
    files: source_files(timed.program, view.frame),
    inputs: timed.program.inputs,
    read_ms: timed.read_ms,
    front_end_ms: timed.front_end_ms,
    store_ms: timed.store_ms,
    cached: timed.cached,
  }
}

pub fn no_loaded_analysis() -> LoadedAnalysis / {abort.raise} =
  {
    dump: dump_of(Rejected([])),
    files: [],
    inputs: Map::new(),
    read_ms: 0,
    front_end_ms: 0,
    store_ms: 0,
    cached: false,
  }

pub fn timed_load(
  paths: List<paths::ResolvedPath>,
  verify: Bool,
) -> TimedLoad / {shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, Derives, abort.raise, diverges} = {
  let started = time.elapsed_ms();
  timed_over(paths, load_resolved(paths), started, verify)
}

pub fn timed_over(
  paths: List<paths::ResolvedPath>,
  project: Project,
  started: Int,
  verify: Bool,
) -> TimedLoad / {shipped.read_pack, toolchain.reuse_dir, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], fs.read_file[abs], entropy.next, time.now_ms, Derives, abort.raise} = {
  let results = check_modules(paths, project);
  let shipping = shipping_cached(results.pulled, results.wants);
  let read_done = time.elapsed_ms();
  let p: Program = verified(
    project,
    shipping,
    verify,
    assembled(project, shipping, paths, results),
  );
  report_viewed(p.shipped_views, true);
  {
    program: p,
    read_ms: read_done - started,
    front_end_ms: time.elapsed_ms() - read_done,
    store_ms: 0,
    cached: true,
  }
}

pub fn timed_uncached(
  paths: List<paths::ResolvedPath>,
  verify: Bool,
) -> TimedLoad / {shipped.read_pack, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, Derives, abort.raise, diverges} = {
  let started = time.elapsed_ms();
  timed_uncached_over(paths, load_resolved(paths), started, verify)
}

pub fn timed_uncached_over(
  paths: List<paths::ResolvedPath>,
  project: Project,
  started: Int,
  verify: Bool,
) -> TimedLoad / {shipped.read_pack, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], Derives, abort.raise} = {
  let results = check_modules_uncached(project);
  let shipping = shipping_of(results.pulled);
  let read_done = time.elapsed_ms();
  let p: Program = verified(
    project,
    shipping,
    verify,
    assembled(project, shipping, paths, results),
  );
  report_viewed(p.shipped_views, true);
  {
    program: p,
    read_ms: read_done - started,
    front_end_ms: time.elapsed_ms() - read_done,
    store_ms: 0,
    cached: false,
  }
}

pub fn unchanged(
  project: Project,
  program: Program,
) -> Bool / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  project.diagnostics.len() == 0 && project.files == program.files
    && packages_of(project) == program.packages
    && !embeds_changed(program.embeds)

pub fn modules_of(program: Program, frame: Frame) -> List<ModuleView> / {abort.raise} =
  range(0, frame.outlines.len()).map(|i: Int|
    {
      name: String::of_bytes_lossy(frame.outlines.get(i).name),
      path: match program.source_texts.at(i) { Some(place) -> place.path, None -> "" },
    })

pub fn module_reports(program: Program, frame: Frame) -> List<ModuleReport> / {abort.raise} =
  range(0, frame.outlines.len()).map(|i: Int| {
    let o = frame.outlines.get(i);
    {
      index: i,
      name: String::of_bytes_lossy(o.name),
      path: match program.source_texts.at(i) { Some(place) -> place.path, None -> "" },
      imports: o.imports.map(String::of_bytes_lossy),
      items: o.declared.map(String::of_bytes_lossy),
    }
  })

pub fn sources_of(program: Program, frame: Frame) -> List<Source> / {abort.raise} =
  range(0, frame.outlines.len()).map(|i: Int|
    {
      name: frame.outlines.get(i).name,
      source_text: match program.source_texts.at(i) { Some(place) -> place.text, None -> b"" },
    })

pub fn in_root_package(frame: Frame) -> (Bytes) -> Bool = {
  let roots = frame.outlines.fold(
    { i: 0, roots: Map::new() },
    |accumulator: { i: Int, roots: Map<Bytes, Bool> }, o: Outline|
      {
        i: accumulator.i + 1,
        roots: if frame.module_packages.at(accumulator.i) == Some(0) {
          accumulator.roots.insert(o.name, true)
        } else { accumulator.roots },
      },
  ).roots;
  |m: Bytes| roots.contains(m)
}

pub fn pulled_modules(frame: Frame) -> Map<Bytes, Bool> =
  frame.outlines.fold(
    { i: 0, pulled: Map::new() },
    |accumulator: { i: Int, pulled: Map<Bytes, Bool> }, o: Outline|
      {
        i: accumulator.i + 1,
        pulled: if is_shipped_module(frame.packages, frame.module_packages, accumulator.i) {
          accumulator.pulled.insert(o.name, true)
        } else { accumulator.pulled },
      },
  ).pulled

pub fn own_tests(program: Program, view: CheckedProgram) -> List<TestInfo> =
  view.checked.tests.filter(|test_info: TestInfo| test_info.at.module < program.files.len())

pub fn own_laws(program: Program, view: CheckedProgram) -> List<LawInfo> =
  view.checked.laws.filter(|law_info: LawInfo| law_info.at.module < program.files.len())

pub fn place_of(program: Program, location: Location) -> Option<SourceText> =
  if location.module == no_module() { None } else { program.source_texts.at(location.module) }

pub fn location_of(program: Program, location: Location) -> Option<String> / {abort.raise} =
  match place_of(program, location) {
    None -> None,
    Some(place) -> {
      let spot = position_of(place.text, location.span.start);
      Some(place.path ++ ":" ++ spot.line.to_string() ++ ":" ++ spot.column.to_string())
    },
  }

type DefinitionSelection = { seen: Map<Bytes, Bool>, out: List<DefinitionInfo> }

fn pick(
  accumulator: DefinitionSelection,
  by_name: Map<Bytes, DefinitionInfo>,
  name: Bytes,
) -> DefinitionSelection =
  match accumulator.seen.get(name) {
    Some(_) -> accumulator,
    None -> match by_name.get(name) {
      None -> accumulator,
      Some(d) -> { seen: accumulator.seen.insert(name, true), out: accumulator.out.push(d) },
    },
  }

fn module_functions(accumulator: List<Bytes>, o: Outline) -> List<Bytes> =
  o.items.fold(accumulator, |a: List<Bytes>, it: OutlineItem|
    match it { OutlinedFunction(f) -> a.push(qualify(o.name, f.name)), _ -> a })

pub fn definitions_in_order(view: CheckedProgram) -> List<DefinitionInfo> = {
  let by_name = view.checked.definitions.fold(
    Map::new(),
    |accumulator: Map<Bytes, DefinitionInfo>, definition_info: DefinitionInfo|
      accumulator.insert(definition_info.name, definition_info),
  );
  let a_definition = view.frame.outlines.fold([], module_functions);
  let first: DefinitionSelection = a_definition.fold(
    { seen: Map::new(), out: [] },
    |accumulator: DefinitionSelection, name: Bytes| pick(accumulator, by_name, name),
  );
  let all: DefinitionSelection = view.checked.definitions.fold(
    first,
    |accumulator: DefinitionSelection, definition_info: DefinitionInfo|
      pick(accumulator, by_name, definition_info.name),
  );
  all.out
}

pub fn resolve_definition(
  definitions: List<DefinitionInfo>,
  query: String,
) -> Result<DefinitionInfo, List<String>> = {
  let exact = definitions.fold(None, |accumulator: Option<DefinitionInfo>, d: DefinitionInfo|
    match accumulator {
      Some(_) -> accumulator,
      None -> if String::of_bytes_lossy(d.name) == query { Some(d) } else { None },
    });
  match exact {
    Some(d) -> Ok(d),
    None -> {
      let matching = definitions.filter(|d: DefinitionInfo|
        String::of_bytes_lossy(d.simple_name) == query);
      match matching.at(0) {
        None -> Err([]),
        Some(d) -> if matching.len() == 1 { Ok(d) }
        else { Err(matching.map(|x: DefinitionInfo| String::of_bytes_lossy(x.name))) },
      }
    },
  }
}

pub fn unknown_definition(query: String, names: List<String>) -> Diagnostic =
  if names.len() == 0 {
    error_at(
      b"E0101",
      no_module(),
      dummy_span(),
      Bytes::of_string("no definition is named `" ++ query ++ "`"),
      b"not a definition of this program",
      [
        b"the query is a program-wide name such as `store.orders.place`, or a simple name unique in the program",
      ],
    )
  } else {
    error_at(
      b"E0101",
      no_module(),
      dummy_span(),
      Bytes::of_string("`" ++ query ++ "` names " ++ names.len().to_string() ++ " definitions"),
      b"say which",
      [Bytes::of_string("one of: " ++ String::join(names, ", "))],
    )
  }

pub fn with_note(diagnostic: Diagnostic, note: Bytes) -> Diagnostic =
  { ..diagnostic, notes: diagnostic.notes + 1, notes_text: diagnostic.notes_text.push(note) }

pub type Tables = {
  definitions: Map<Bytes, Bytes>,
  own: Map<Bytes, Bytes>,
  specs: Map<Bytes, Int>,
  hashes: HashOutput,
}

pub fn tables_of(h: HashOutput) -> Tables =
  {
    definitions: h.definitions.fold(
      Map::new(),
      |accumulator: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
        accumulator.insert(x.name, x.hash),
    ),
    own: h.own.fold(
      Map::new(),
      |accumulator: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
        accumulator.insert(x.name, x.hash),
    ),
    specs: h.specs.fold(
      Map::new(),
      |accumulator: Map<Bytes, Int>, x: { name: Bytes, hashes: List<Bytes> }|
        accumulator.insert(x.name, x.hashes.len()),
    ),
    hashes: h,
  }

pub fn hash_of(tables: Tables, name: Bytes) -> Option<String> / {abort.raise} =
  match tables.definitions.get(name) {
    Some(h) -> Some(String::of_bytes_lossy(hex(h))),
    None -> None,
  }

pub fn own_hash_of(tables: Tables, name: Bytes) -> Option<String> / {abort.raise} =
  match tables.own.get(name) { Some(h) -> Some(String::of_bytes_lossy(hex(h))), None -> None }

pub fn dependencies_of(tables: Tables, which: Subject) -> List<String> / {abort.raise} =
  forms::references_in(tables.hashes, which).fold([], |accumulator: List<Bytes>, r: NodeRef|
    accumulator.push_unique(r.name)).map(|n: Bytes| String::of_bytes_lossy(n))

pub fn closure_of(tables: Tables, which: Subject) -> List<String> / {abort.raise} = {
  let reached = forms::reach(tables.hashes, [which]);
  reached.functions.merge(reached.declarations).keys().map(|n: Bytes| String::of_bytes_lossy(n))
}

pub fn transitive_callers(tables: Tables, name: Bytes) -> List<Bytes> / {abort.raise} = {
  let n = forms::find_referrers(tables.hashes, FunctionNamed(name), true);
  n.functions.concat(n.items)
}

pub fn direct_callers(tables: Tables, name: Bytes) -> List<Bytes> / {abort.raise} = {
  let n = forms::find_referrers(tables.hashes, FunctionNamed(name), false);
  n.functions.concat(n.items)
}

pub fn specialization_count(tables: Tables, name: Bytes) -> Int =
  match tables.specs.get(name) { Some(n) -> n, None -> 0 }

pub fn short_of(hex_text: String) -> String / {abort.raise} = hex_text.slice(0, 12)

test "`pseudo_path` gives a built-in module a placeholder file path such as `<std>/json.ply`, which no user file can have" {
  assert_eq(pseudo_path("std.json"), "<std>/json.ply");
  assert_eq(pseudo_path("std.http.server"), "<std>/http/server.ply");
  assert_eq(pseudo_path("compiler.fmt"), "<compiler>/fmt.ply")
}

test "a proof covers the root package's claims and never a shipped module's" {
  let w = match analyse_pulling_std_with(
      [
        {
          name: b"m",
          source_text: b"import std.y\nimport compiler.x\nfn own() -> Int = y::one() + x::one()\n",
        },
      ],
      [
        { name: b"std.y", source_text: b"pub fn one() -> Int = 1\n" },
        { name: b"compiler.x", source_text: b"pub fn one() -> Int = 1\n" },
      ],
      no_rows(),
      cut_unused: false,
    ).out {
    Analysed(w) -> w,
    Rejected(_) -> panic("the fixture program was rejected by the checker"),
  };
  let owned = in_root_package(checked_program_of(w).frame);
  assert(owned(b"m") && !owned(b"std.y") && !owned(b"compiler.x"))
}

fn a_definition(name: Bytes, simple: Bytes) -> DefinitionInfo =
  {
    name: name,
    module: b"m",
    simple_name: simple,
    scheme: {
      type_variables: [],
      effect_variables: [],
      keep_variables: [],
      label_variables: [],
      ty: FunctionType({
        keep_parameters: [],
        once: false,
        params: [],
        return_type: NamedType({ name: b"Int", args: [] }),
        effects: { listed: [], variable: None },
      }),
    },
    effects: [],
    performed: [],
    scaling: [],
    repeats: [],
    promised_bounded: [],
    variable_bounded: false,
    ending: Terminates,
    summary: unknown_summary(),
    raises: [],
    effect_aliases: [],
    constraints: [],
    spec: [],
    at: { module: 0, span: dummy_span() },
  }

test "`resolve_definition` accepts a fully qualified name, or a short name that matches exactly one definition" {
  let definitions = [
    a_definition(b"a.total", b"total"),
    a_definition(b"b.total", b"total"),
    a_definition(b"a.one", b"one"),
  ];
  assert_eq(
    match resolve_definition(definitions, "a.total") { Ok(d) -> d.name, Err(_) -> b"" },
    b"a.total",
  );
  assert_eq(
    match resolve_definition(definitions, "one") { Ok(d) -> d.name, Err(_) -> b"" },
    b"a.one",
  );
  assert_eq(match resolve_definition(definitions, "total") { Ok(_) -> [], Err(ns) -> ns }, [
    "a.total",
    "b.total",
  ]);
  assert_eq(
    match resolve_definition(definitions, "absent") { Ok(_) -> ["found"], Err(ns) -> ns },
    [],
  )
}

test "an unknown definition name gives `E0101`, and a short name matching several definitions lists the candidates" {
  assert_eq(unknown_definition("absent", []).code, b"E0101");
  assert_eq(unknown_definition("absent", []).message, b"no definition is named `absent`");
  let many = unknown_definition("total", ["a.total", "b.total"]);
  assert_eq(many.message, b"`total` names 2 definitions");
  assert_eq(many.notes_text, [b"one of: a.total, b.total"]);
  assert_eq(with_note(many, b"and one more").notes, 2)
}

test "a directory walk lists the root package's modules first and lists each package's manifest separately from its modules" {
  let project = {
    files: [
      {
        path: "main.ply",
        module: "main",
        text: b"fn main() -> Int = 1\n",
        at: { label: "cwd", path: "main.ply" },
      },
      {
        path: "util.ply",
        module: "util",
        text: b"pub fn one() -> Int = 1\n",
        at: { label: "cwd", path: "util.ply" },
      },
    ],
    sources: [],
    diagnostics: [],
    manifest: Some({
      path: "ply.pkg",
      module: "",
      text: b"fn package() -> Manifest = app()\n",
      at: { label: "cwd", path: "ply.pkg" },
    }),
    packages: [
      {
        root: "/w/lib",
        dir: "/w/lib",
        manifest: Some(b"fn package() -> Manifest = lib()\n"),
        files: [
          {
            path: "/w/lib/deep.ply",
            module: "deep",
            text: b"pub fn deep() -> Int = 7\n",
            at: { label: "cwd", path: "/w/lib/deep.ply" },
          },
        ],
      },
    ],
    root_key: "/w/app",
  };
  let w: ProjectSources = project_sources(project);
  assert_eq(w.modules.map(|p: SourceText| p.path), ["main.ply", "util.ply", "/w/lib/deep.ply"]);
  assert_eq(w.manifests.map(|p: SourceText| p.path), ["ply.pkg", "/w/lib/ply.pkg"])
}

test "`location_of` returns `None` for a span that belongs to no module, and a file, line and column for a real span" {
  let p: Program = {
    ..no_program(),
    source_texts: [{ path: "m.ply", text: b"fn f() -> Int = 1\n" }],
  };
  assert_eq(location_of(p, { module: no_module(), span: dummy_span() }), None);
  assert_eq(location_of(p, { module: 0, span: span_between(3, 4) }), Some("m.ply:1:4"))
}
