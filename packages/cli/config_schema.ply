import compiler.front.diagnostics (parse_all)
import compiler.front.facts (CheckedProgram)
import compiler.front.emitter_input (Analysed, Rejected, checked_program_of)
import compiler.front.published (analyse)
import compiler.front.rows (module_of)
import compiler.check.infer.checker (DefinitionInfo)
import compiler.check.resolve.tables (Diagnostic, error_at)
import compiler.check.types (Type, NamedType, FunctionType, RecordType, field_get, effects_text,
                             type_text, without_raises)
import report (count_of)
import std.list
import std.string
import proof.prover_input (whole_of)
import compiler.syntax.parsing (no_module, dummy_span)

fn flag(name: String) -> String = "`--config-schema " ++ name ++ "`"

fn flag_error(message: String, notes: List<Bytes>) -> Diagnostic =
  error_at(
    b"E0440",
    no_module,
    dummy_span,
    Bytes::of_string(message),
    b"this argument is the run's configuration",
    notes,
  )

fn well_formed(name: String) -> Bool / {abort.raise} = {
  let segments = name.split(".");
  segments.len() >= 2
    && (match module_of(String::join(segments, "/")) { Ok(_) -> true, Err(_) -> false })
}

pub fn check_name(name: String) -> Result<String, Diagnostic> / {abort.raise} =
  if well_formed(name) { Ok(name) } else {
    let note = b"write the program-wide name of the function, as `ply hash` prints it";
    Err(flag_error(flag(name) ++ " is not a `<module>.<fn>` name", [note]))
  }

fn simple_name(name: Bytes) -> Bytes = {
  let segments = name.split(b".");
  match segments.at(segments.len() - 1) { Some(last) -> last, None -> name }
}

fn returns_spec(t: Type) -> Bool =
  match t {
    NamedType(c) -> c.args.len() == 0 && simple_name(c.name) == b"ConfigSpec",
    RecordType(fs) ->
      fs.len() == 1
        && (match field_get(fs, b"keys") {
          Some(NamedType(k)) -> k.name == b"List" && k.args.len() == 1,
          _ -> false,
        }),
    _ -> false,
  }

fn unfit_reason(definition_info: DefinitionInfo) -> Option<String> / {abort.raise} =
  match definition_info.scheme.ty {
    FunctionType(f) -> if f.params.len() > 0 {
      Some(
        "it takes " ++ count_of(f.params.len(), "argument") ++ ", and the run has nothing to pass",
      )
    } else if !returns_spec(f.return_type) {
      Some(
        "it returns `" ++ String::of_bytes_lossy(type_text(f.return_type))
          ++ "` rather than a `ConfigSpec`",
      )
    } else if without_raises(definition_info.effects).len() > 0 {
      Some(
        "its effects are `"
          ++ String::of_bytes_lossy(
            effects_text({ listed: definition_info.effects, variable: None }),
          )
          ++ "`, and the schema is read before any configuration values are loaded, so it must be pure",
      )
    } else { None },
    _ -> Some("it is not a function, and a schema is created by calling a function"),
  }

fn unknown_schema(view: CheckedProgram, name: String) -> Diagnostic / {abort.raise} = {
  let found = view.checked.definitions.filter(|definition_info: DefinitionInfo|
    unfit_reason(definition_info) == None).map(|definition_info: DefinitionInfo|
    String::of_bytes_lossy(definition_info.name)).sort(
  );
  let notes = if found.len() == 0 {
    [
      b"this program declares no function without parameters that returns a `ConfigSpec`",
      b"drop `--config-schema`: without it, each missing key is a `None` where the program reads it, and the program must handle it there",
    ]
  } else { [Bytes::of_string("this program has: " ++ String::join(found, ", "))] };
  flag_error(flag(name) ++ " names no definition in this program", notes)
}

fn not_a_schema(name: String, reason: String) -> Diagnostic =
  flag_error(flag(name) ++ " does not name a configuration schema: " ++ reason, [
    Bytes::of_string(
      "it must be a nullary pure function returning `std.config.ConfigSpec` — a record `{keys: List<Key>}`",
    ),
  ])

fn find_definition(definitions: List<DefinitionInfo>, name: String) -> Option<DefinitionInfo> =
  definitions.fold(None, |found: Option<DefinitionInfo>, definition_info: DefinitionInfo|
    match found {
      Some(_) -> found,
      None -> if String::of_bytes_lossy(definition_info.name) == name { Some(definition_info) }
      else { None },
    })

pub fn resolve_schema(
  view: CheckedProgram,
  name: String,
) -> Result<String, Diagnostic> / {abort.raise} =
  match check_name(name) {
    Err(d) -> Err(d),
    Ok(_) -> match find_definition(view.checked.definitions, name) {
      None -> Err(unknown_schema(view, name)),
      Some(d) -> match unfit_reason(d) {
        Some(reason) -> Err(not_a_schema(name, reason)),
        None -> Ok(name),
      },
    },
  }

pub fn schema_error(
  view: CheckedProgram,
  named: Option<String>,
) -> Option<Diagnostic> / {abort.raise} =
  match named {
    None -> None,
    Some(name) -> match resolve_schema(view, name) { Ok(_) -> None, Err(d) -> Some(d) },
  }

pub fn name_error(named: Option<String>) -> Option<Diagnostic> / {abort.raise} =
  match named {
    None -> None,
    Some(name) -> match check_name(name) { Ok(_) -> None, Err(d) -> Some(d) },
  }

const specs: CheckedProgram =
  checked_program_of(
    whole_of(
      b"type Shape = | SText | SInt | SBool | SSecret\ntype Key = { name: String, shape: Shape, required: Bool, default: Option<String> }\ntype ConfigSpec = { keys: List<Key> }\neffect log { write emit(Bytes) -> Unit }\nfn config() -> ConfigSpec = { keys: [] }\nfn two(a: Int) -> ConfigSpec = { keys: [] }\nfn number() -> Int = 1\nfn loud() -> ConfigSpec / {log.write} = { log.emit(b\"x\"); config() }\n",
    ),
  )

fn rejection_of(r: Result<String, Diagnostic>) -> Diagnostic / {abort.raise} =
  match r { Ok(_) -> panic("the flag took a name it should reject"), Err(d) -> d }

test "`resolve_schema` accepts a pure function with no parameters that returns a spec (a config description) as the config schema" {
  assert_eq(resolve_schema(specs, "m.config"), Ok("m.config"));
  assert_eq(schema_error(specs, Some("m.config")), None);
  assert_eq(schema_error(specs, None), None)
}

test "a name that is not `<module>.<fn>` is rejected before any program is read" {
  let bad = ["config", "service.", ".config", "service..config", "1service.config"];
  assert_eq(
    bad.map(|name: String| rejection_of(check_name(name)).message),
    bad.map(|name: String| Bytes::of_string(flag(name) ++ " is not a `<module>.<fn>` name")),
  );
  assert_eq(
    bad.map(|name: String| rejection_of(check_name(name)).code),
    bad.map(|name: String| b"E0440"),
  );
  assert_eq(check_name("service.config"), Ok("service.config"));
  assert_eq(check_name("store.orders.config"), Ok("store.orders.config"));
  assert(match name_error(Some("config")) { Some(d) -> d.code == b"E0440", None -> false });
  assert_eq(name_error(Some("service.config")), None);
  assert_eq(name_error(None), None)
}

test "a definition that is not a schema is rejected with the reason" {
  let reason = |name: String|
    String::of_bytes_lossy(rejection_of(resolve_schema(specs, name)).message);
  assert_eq(
    reason("m.two"),
    "`--config-schema m.two` does not name a configuration schema: it takes 1 argument, and the run has nothing to pass",
  );
  assert_eq(
    reason("m.number"),
    "`--config-schema m.number` does not name a configuration schema: it returns `Int` rather than a `ConfigSpec`",
  );
  assert_eq(
    reason("m.loud"),
    "`--config-schema m.loud` does not name a configuration schema: its effects are `{m.log.write}`, and the schema is read before any configuration values are loaded, so it must be pure",
  );
  assert_eq(rejection_of(resolve_schema(specs, "m.two")).code, b"E0440")
}

test "a name the program does not declare lists the schemas it does" {
  let d = rejection_of(resolve_schema(specs, "service.config"));
  assert_eq(d.code, b"E0440");
  assert_eq(d.message, b"`--config-schema service.config` names no definition in this program");
  assert_eq(d.notes_text, [b"this program has: m.config"]);
  let none = rejection_of(
    resolve_schema(checked_program_of(whole_of(b"fn number() -> Int = 1\n")), "m.config"),
  );
  assert_eq(none.notes_text, [
    b"this program declares no function without parameters that returns a `ConfigSpec`",
    b"drop `--config-schema`: without it, each missing key is a `None` where the program reads it, and the program must handle it there",
  ])
}
