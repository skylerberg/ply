import args (Flags, style_of)
import std.cli (Parsed)
import paths
import report (CommandOutput, indent, ok_code, reported)
import signing (fresh_seed, public_text, unreadable_key, write_seed)
import std.term (bold, green)
import std.bytes
import std.ed25519
import std.fs (fs, Missing)
import std.json (Bool, Number, Str, object)
import std.random (entropy)
import std.list

pub type Options = { path: String }

pub fn options_from(parsed: Parsed) -> Options = { path: parsed.positionals.at_or(0, "") }

pub fn run(
  flags: Flags,
  opts: Options,
) -> CommandOutput / {entropy.secret, fs.kind[cwd], fs.kind[abs], fs.write_file[cwd], fs.write_file[abs], fs.write_secret[cwd], fs.write_secret[abs], abort.raise} = {
  let s = style_of(flags);
  let public_path = opts.path ++ ".pub";
  let secret = paths::rooted_path(opts.path);
  let public = paths::rooted_path(public_path);
  if paths::kind(secret) != Missing {
    reported(
      s,
      "keygen",
      [unreadable_key(opts.path, "is already there, and a key is never written over")],
      [],
    )
  } else if paths::kind(public) != Missing {
    reported(
      s,
      "keygen",
      [unreadable_key(public_path, "is already there, and a key is never written over")],
      [],
    )
  } else {
    let seed = fresh_seed();
    let key = ed25519::public_key(seed);
    if !write_seed(secret, seed) {
      reported(s, "keygen", [unreadable_key(opts.path, "cannot be written")], [])
    } else if !paths::write_file(public, Bytes::of_string(public_text(key))) {
      reported(s, "keygen", [unreadable_key(public_path, "cannot be written")], [])
    } else {
      {
        json: object([
          { key: "command", value: Str("keygen") },
          { key: "ok", value: Bool(true) },
          { key: "exit_code", value: Number(Decimal::of_int(ok_code)) },
          { key: "secret", value: Str(opts.path) },
          { key: "public", value: Str(public_path) },
          { key: "key", value: Str(key.hex_of()) },
        ]),
        lines: [
          indent ++ green(s, "generated") ++ " " ++ opts.path ++ " · " ++ public_path,
          indent ++ bold(s, "public") ++ " " ++ key.hex_of(),
        ],
        errs: [],
        code: ok_code,
      }
    }
  }
}
