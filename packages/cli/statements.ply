import compiler.front.facts (Frame, StatementSite, Argument, TextArgument, CallArgument,
                             RowArgument, TaggedArgument, ListArgument, ConstructorArgument,
                             OtherArgument, statement_modules, RowField, RowRead, ScalarRead,
                             OptionalRead, ArrayRead, DocumentRead, JsonRead)
import compiler.front.emitter_input (ConstSite, TestRunScope, consts_of_type)
import compiler.store.hash.forms (FunctionNamed, reach)
import compiler.store.hash.encoding (hex)
import compiler.front.interface (length_prefixed)
import compiler.load (reachable_roots, LoadedAnalysis)
import compiler.cc
import compiler.check.resolve.tables (Diagnostic, error_at, error_with_labels, label_at)
import machine
import machine (CallResult)
import std.machine as entering
import std.bin
import std.bytes (ascii_of_int)
import std.hash (blake3)
import std.list
import std.sql
import std.sql (Dialect, Postgres, Sqlite, Operation, Reads, Writes, WritesRows, ReadWrite, Finding,
                FindingKind, Unreadable, Undeclared, LabelMismatch, OperationMismatch, SelectStar,
                Unsupported, RowMismatch, ValueMismatch)
import std.value (Value, VBool, VCtor, VInt, VList, VRecord, VStr, field_named, constructor_name)
import units
import units (emit)
import compiler.syntax.parsing (span_between)

pub const schema_type: Bytes = b"std.sql.Schema"

type StatementRunner = {
  callee: Bytes,
  dialect: Dialect,
  operation: Operation,
  statement: Int,
  params: Int,
  codec: Int,
  labelled: Bool,
}

fn db_call(callee: Bytes, operation: Operation, params: Int, codec: Int) -> StatementRunner =
  {
    callee: callee,
    dialect: Postgres,
    operation: operation,
    statement: 0,
    params: params,
    codec: codec,
    labelled: true,
  }

fn sqlite_call(callee: Bytes, operation: Operation) -> StatementRunner =
  {
    callee: callee,
    dialect: Sqlite,
    operation: operation,
    statement: 1,
    params: 0 - 1,
    codec: 0 - 1,
    labelled: false,
  }

const statement_runners: List<StatementRunner> =
  [
    db_call(b"std.db.db.query", Reads, 1, 0 - 1),
    db_call(b"std.db.db.batch", Reads, 0 - 1, 0 - 1),
    db_call(b"std.db.db.execute", Writes, 1, 0 - 1),
    db_call(b"std.db.db.returning", WritesRows, 1, 0 - 1),
    db_call(b"std.db.db.copy_out", Reads, 0 - 1, 0 - 1),
    db_call(b"std.db.fetch", Reads, 2, 1),
    db_call(b"std.db.fetch_returning", WritesRows, 2, 1),
    sqlite_call(b"std.sqlite.query", Reads),
    sqlite_call(b"std.sqlite.execute", Writes),
    sqlite_call(b"std.sqlite.returning", WritesRows),
    sqlite_call(b"std.sqlite.run", ReadWrite),
    sqlite_call(b"std.sqlite.fold_rows", Reads),
  ]

pub type StatementCheck = {
  dialect: Dialect,
  operation: Operation,
  label: Option<String>,
  statement: Argument,
  given: Option<List<Option<String>>>,
  row: Option<List<sql::Field>>,
  schema: Option<ConstSite>,
}

pub type StatementError = { code: Bytes, at: Int, message: String }

derive bin for StatementError

pub type CheckResult = | Checked({ text: String, found: List<StatementError> }) | Unchecked

derive bin for CheckResult

pub type CheckSite = { site: StatementSite, check: StatementCheck, schemas: List<ConstSite> }

pub fn check_sites(frame: Frame) -> List<CheckSite> / {abort.raise} = {
  let schemas = consts_of_type(frame, schema_type);
  let callees = statement_runners.map(|p: StatementRunner| p.callee);
  let places = range(0, frame.outlines.len()).fold(
    Map::new(),
    |accumulator: Map<Bytes, Int>, i: Int| accumulator.insert(frame.outlines.get(i).name, i),
  );
  let imports = frame.imports.map(|names: List<Bytes>|
    names.fold([], |accumulator: List<Int>, n: Bytes|
      match places.get(n) { Some(i) -> accumulator.push(i), None -> accumulator }));
  frame.statements.filter(|site: StatementSite| callees.contains(site.callee)).fold(
    [],
    |accumulator: List<CheckSite>, site: StatementSite|
      match statement_check_of(site) {
        None -> accumulator,
        Some(a) -> {
          let reachable_modules = transitive_modules(imports, site.module);
          let reachable_schemas = schemas.filter(|s: ConstSite|
            reachable_modules.contains(s.module));
          accumulator.push({
            site: site,
            check: {
              ..a,
              schema: if reachable_schemas.len() == 1 { reachable_schemas.at(0) } else { None },
            },
            schemas: reachable_schemas,
          })
        },
      },
  )
}

fn transitive_modules(imports: List<List<Int>>, module: Int) -> List<Int> =
  range(0, imports.len()).fold([module], |seen: List<Int>, _: Int|
    seen.fold(seen, |accumulator: List<Int>, m: Int|
      List::fold(
        match imports.at(m) { Some(xs) -> xs, None -> [] },
        accumulator,
        |more: List<Int>, x: Int| if more.contains(x) { more } else { more.push(x) },
      )))

fn statement_check_of(site: StatementSite) -> Option<StatementCheck> =
  match statement_runners.find(|p: StatementRunner| p.callee == site.callee) {
    None -> None,
    Some(p) -> match site.args.at(p.statement) {
      None -> None,
      Some(argument) -> {
        let unwrapped = unwrap_bound(argument);
        Some({
          dialect: p.dialect,
          operation: p.operation,
          label: if p.labelled { Some(String::of_bytes_lossy(site.label)) } else { None },
          statement: unwrapped.statement,
          given: match unwrapped.given {
            Some(given) -> Some(given),
            None -> if p.params < 0 { None } else { parameters_of(site.args.at(p.params)) },
          },
          row: if p.codec < 0 { None } else {
            match site.args.at(p.codec) {
              Some(RowArgument(fields)) -> Some(fields.map(|f: RowField| field_of(f))),
              _ -> None,
            }
          },
          schema: None,
        })
      },
    },
  }

fn unwrap_bound(a: Argument) -> { statement: Argument, given: Option<List<Option<String>>> } =
  match a {
    CallArgument(c) -> if c.callee != b"std.sqlite.bound" { { statement: a, given: None } } else {
      match c.args {
        [statement, params] -> { statement: statement, given: parameters_of(Some(params)) },
        _ -> { statement: a, given: None },
      }
    },
    TaggedArgument(t) -> { statement: a, given: Some(t.holes.map(param_of)) },
    _ -> { statement: a, given: None },
  }

fn parameters_of(a: Option<Argument>) -> Option<List<Option<String>>> =
  match a { Some(ListArgument(items)) -> Some(items.map(param_of)), _ -> None }

fn param_of(a: Argument) -> Option<String> =
  match a {
    ConstructorArgument(c) -> if c.type_name == b"std.sql.Param" {
      Some(String::of_bytes_lossy(c.name))
    } else { None },
    _ -> None,
  }

fn field_of(f: RowField) -> sql::Field =
  { name: String::of_bytes_lossy(f.name), kind: kind_of(f.read) }

fn kind_of(r: RowRead) -> sql::FieldKind =
  match r {
    ScalarRead(reader) -> scalar_kind(reader),
    OptionalRead(inner) -> sql::OptionalField(kind_of(inner)),
    ArrayRead(reader) -> sql::ArrayField(scalar_kind(reader)),
    DocumentRead -> sql::JsonField,
    JsonRead -> sql::JsonField,
  }

fn scalar_kind(reader: Bytes) -> sql::FieldKind =
  if reader == b"text_field" { sql::TextField }
  else if reader == b"int_field" { sql::IntField }
  else if reader == b"bool_field" { sql::BoolField }
  else if reader == b"float_field" { sql::FloatField }
  else if reader == b"numeric_field" { sql::NumericField }
  else if reader == b"bytes_field" { sql::BytesField }
  else { sql::JsonField }

fn argument_key(a: Argument, left: Int) -> Bytes / {abort.raise} =
  if left <= 0 { b"?" } else {
    match a {
      TextArgument(b) -> b"t".concat(length_prefixed(b)),
      CallArgument(c) ->
        Bytes::concat_all([
          b"c",
          length_prefixed(c.callee),
          length_prefixed(c.hash),
          length_prefixed(ascii_of_int(c.args.len())),
          Bytes::concat_all(c.args.map(|x: Argument| argument_key(x, left - 1))),
        ]),
      RowArgument(_) -> b"r",
      TaggedArgument(t) ->
        Bytes::concat_all([
          b"g",
          length_prefixed(t.callee),
          length_prefixed(t.hash),
          length_prefixed(ascii_of_int(t.parts.len())),
          Bytes::concat_all(t.parts.map(length_prefixed)),
        ]),
      ListArgument(items) ->
        Bytes::concat_all([
          b"l",
          length_prefixed(ascii_of_int(items.len())),
          Bytes::concat_all(items.map(|x: Argument| argument_key(x, left - 1))),
        ]),
      ConstructorArgument(c) ->
        Bytes::concat_all([b"k", length_prefixed(c.type_name), length_prefixed(c.name)]),
      OtherArgument -> b"o",
    }
  }

fn operation_text(o: Operation) -> Bytes =
  match o {
    Reads -> b"reads",
    Writes -> b"writes",
    WritesRows -> b"writes rows",
    ReadWrite -> b"either",
  }

fn kind_key(k: sql::FieldKind) -> Bytes = Bytes::of_string(sql::field_text(k))

pub fn check_result_key(toolchain: Bytes, a: StatementCheck) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all([
        length_prefixed(b"ply statement judgement 3"),
        length_prefixed(hex(bin::shape_digest(check_result_bin()))),
        length_prefixed(toolchain),
        length_prefixed(match a.schema { Some(s) -> s.hash, None -> b"" }),
        length_prefixed(match a.dialect { Postgres -> b"postgres", Sqlite -> b"sqlite" }),
        length_prefixed(operation_text(a.operation)),
        length_prefixed(match a.label { Some(l) -> Bytes::of_string(l), None -> b"\x00" }),
        match a.given {
          None -> length_prefixed(b"\x00"),
          Some(given) ->
            Bytes::concat_all(
              given.map(|g: Option<String>|
                length_prefixed(match g { Some(c) -> Bytes::of_string(c), None -> b"\x00" })),
            ),
        },
        match a.row {
          None -> length_prefixed(b"\x00"),
          Some(fields) ->
            Bytes::concat_all(
              fields.map(|f: sql::Field|
                length_prefixed(Bytes::of_string(f.name)).concat(
                  length_prefixed(kind_key(f.kind)),
                )),
            ),
        },
        length_prefixed(argument_key(a.statement, 64)),
      ]),
    ),
  )

fn callees_in(a: Argument, accumulator: List<Bytes>, left: Int) -> List<Bytes> =
  if left <= 0 { accumulator } else {
    match a {
      CallArgument(c) ->
        c.args.fold(
          if accumulator.contains(c.callee) { accumulator } else { accumulator.push(c.callee) },
          |more: List<Bytes>, x: Argument| callees_in(x, more, left - 1),
        ),
      TaggedArgument(t) -> if accumulator.contains(t.callee) { accumulator }
      else { accumulator.push(t.callee) },
      ListArgument(items) ->
        items.fold(accumulator, |more: List<Bytes>, x: Argument| callees_in(x, more, left - 1)),
      _ -> accumulator,
    }
  }

type Computed = | Known(Value) | Unknown | Stopped

fn computed_value(
  a: Argument,
  left: Int,
  call: (String, List<Value>) -> CallResult / {entering::machine.enter, abort.raise},
) -> Computed / {entering::machine.enter, abort.raise} =
  if left <= 0 { Unknown } else {
    match a {
      TextArgument(b) -> Known(VStr(String::of_bytes_lossy(b))),
      ListArgument(items) -> match all_computed(items, left - 1, call) {
        Ok(vs) -> Known(VList(vs)),
        Err(c) -> c,
      },
      CallArgument(c) -> match all_computed(c.args, left - 1, call) {
        Err(e) -> e,
        Ok(args) -> computed_of(call(String::of_bytes_lossy(c.callee), args)),
      },
      TaggedArgument(t) -> {
        let texts = t.parts.map(|p: Bytes| VStr(String::of_bytes_lossy(p)));
        let tag_argument = match texts { [one] -> one, _ -> VList(texts) };
        match computed_of(call(String::of_bytes_lossy(t.callee), [tag_argument])) {
          Known(VCtor(name, [v])) -> if constructor_name(name) == "Ok" { Known(v) }
          else { Unknown },
          Stopped -> Stopped,
          _ -> Unknown,
        }
      },
      _ -> Unknown,
    }
  }

fn all_computed(
  xs: List<Argument>,
  left: Int,
  call: (String, List<Value>) -> CallResult / {entering::machine.enter, abort.raise},
) -> Result<List<Value>, Computed> / {entering::machine.enter, abort.raise} =
  xs.fold(Ok([]), |accumulator: Result<List<Value>, Computed>, x: Argument|
    match accumulator {
      Err(_) -> accumulator,
      Ok(vs) -> match computed_value(x, left, call) {
        Known(v) -> Ok(vs.push(v)),
        other -> Err(other),
      },
    })

fn computed_of(called: CallResult) -> Computed =
  match called.result {
    Ok(v) -> Known(v),
    Err(raised) -> if machine::is_timed_out(raised.diagnostic.code) { Stopped } else { Unknown },
  }

pub fn check_statements(
  analysis_for: (TestRunScope) -> LoadedAnalysis / {abort.raise},
  frame: Frame,
  statement_checks: List<StatementCheck>,
) -> Result<List<Option<CheckResult>>, List<Diagnostic>> / {emit.unit, emit.compiled, entering::machine.open, entering::machine.enter, entering::machine.close, abort.raise} = {
  let schemas = statement_checks.fold([], |accumulator: List<Bytes>, a: StatementCheck|
    match a.schema {
      Some(s) -> if accumulator.contains(s.name) { accumulator } else { accumulator.push(s.name) },
      None -> accumulator,
    });
  let named = statement_checks.fold(schemas, |accumulator: List<Bytes>, a: StatementCheck|
    callees_in(a.statement, accumulator, 64));
  if named.len() == 0 {
    Ok(
      statement_checks.map(|a: StatementCheck|
        Some(check_result_of(None, a, computed_text(a.statement)))),
    )
  } else {
    let reachable_functions = reach(frame.hashes, named.map(|n: Bytes| FunctionNamed(n))).functions;
    let front = analysis_for({ owners: reachable_functions, tests: Map::new() });
    match units::library_over(
        emit.unit(front, reachable_roots(front, reachable_functions), None),
        cc::development(),
      ) {
      Err(diagnostics) -> Err(diagnostics),
      Ok(library) -> match entering::machine.open(library) {
        Err(reason) -> Err([machine::unit_load_error(reason)]),
        Ok(opened) -> {
          let roots = machine::roots_of(front.dump);
          let call = |name: String, args: List<Value>|
            machine::machine_call(opened.unit, roots, name, args, machine::evaluation_limits);
          let declared = schemas.fold(
            Map::new(),
            |accumulator: Map<Bytes, Computed>, name: Bytes|
              accumulator.insert(name, computed_of(call(String::of_bytes_lossy(name), []))),
          );
          let check_statements = statement_checks.map(|a: StatementCheck| {
            match match a.schema { Some(s) -> declared.get(s.name), None -> None } {
              Some(Stopped) -> None,
              schema_result -> match computed_value(a.statement, 64, call) {
                Stopped -> None,
                value ->
                  Some(
                    check_result_of(
                      match schema_result { Some(Known(v)) -> schema_of(v), _ -> None },
                      a,
                      match value { Known(v) -> Some(v), _ -> None },
                    ),
                  ),
              },
            }
          });
          entering::machine.close(opened.unit);
          Ok(check_statements)
        },
      },
    }
  }
}

fn computed_text(a: Argument) -> Option<Value> =
  match a { TextArgument(b) -> Some(VStr(String::of_bytes_lossy(b))), _ -> None }

fn check_result_of(
  schema: Option<sql::Schema>,
  a: StatementCheck,
  value: Option<Value>,
) -> CheckResult / {abort.raise} =
  match value {
    None -> Unchecked,
    Some(v) -> match statement_of(v) {
      None -> Unchecked,
      Some(text) ->
        Checked({
          text: text,
          found: sql::check_statement(
            schema,
            {
              dialect: a.dialect,
              operation: a.operation,
              label: a.label,
              parameter_constructors: a.given,
              row: a.row,
            },
            text,
          ).map(|f: Finding| { code: code_of(f.kind), at: f.at, message: f.message }),
        }),
    },
  }

pub fn code_of(m: FindingKind) -> Bytes =
  match m {
    Unreadable -> b"E0431",
    Undeclared -> b"E0433",
    LabelMismatch -> b"E0435",
    OperationMismatch -> b"E0436",
    RowMismatch -> b"E0437",
    ValueMismatch -> b"E0438",
    SelectStar -> b"E0447",
    Unsupported -> b"E0470",
  }

fn text_in(v: Option<Value>) -> Option<String> = match v { Some(VStr(s)) -> Some(s), _ -> None }

fn every<a>(v: Option<Value>, f: (Value) -> Option<a>) -> Option<List<a>> =
  match v {
    Some(VList(items)) ->
      items.fold(Some([]), |accumulator: Option<List<a>>, item: Value|
        match accumulator {
          None -> None,
          Some(xs) -> match f(item) { Some(x) -> Some(xs.push(x)), None -> None },
        }),
    _ -> None,
  }

pub fn schema_of(v: Value) -> Option<sql::Schema> =
  match v {
    VRecord(fields) -> match every(field_named(fields, "tables"), table_of) {
      Some(tables) -> Some({ tables: tables }),
      None -> None,
    },
    _ -> None,
  }

fn table_of(v: Value) -> Option<sql::Table> =
  match v {
    VRecord(fields) -> match ((
        text_in(field_named(fields, "name")),
        every(field_named(fields, "columns"), column_of),
        every(field_named(fields, "primary_key"), |k: Value| text_in(Some(k))),
      )) {
      (Some(name), Some(columns), Some(key)) ->
        Some({
          name: name,
          columns: columns,
          primary_key: key,
          unique: [],
          foreign_keys: [],
          checks: [],
        }),
      _ -> None,
    },
    _ -> None,
  }

fn column_of(v: Value) -> Option<sql::Column> =
  match v {
    VRecord(fields) -> match ((
        text_in(field_named(fields, "name")),
        field_named(fields, "ty"),
        field_named(fields, "nullable"),
      )) {
      (Some(name), Some(ty), Some(VBool(nullable))) -> match column_type_of(ty, 8) {
        Some(t) -> Some({ name: name, ty: t, nullable: nullable, default: sql::DNone }),
        None -> None,
      },
      _ -> None,
    },
    _ -> None,
  }

fn column_type_of(v: Value, left: Int) -> Option<sql::ColumnType> =
  match v {
    VCtor(name, args) -> {
      let n = constructor_name(name);
      if n == "TInt" { Some(sql::IntColumn) }
      else if n == "TBool" { Some(sql::BoolColumn) }
      else if n == "TText" { Some(sql::TText) }
      else if n == "TBytes" { Some(sql::BytesColumn) }
      else if n == "TFloat" { Some(sql::FloatColumn) }
      else if n == "TJson" { Some(sql::JsonColumn) } else if n == "TNumeric" {
        match args { [VInt(p), VInt(s)] -> Some(sql::TNumeric(p, s)), _ -> None }
      } else if n == "TArray" && left > 0 {
        match args {
          [inner] -> match column_type_of(inner, left - 1) {
            Some(t) -> Some(sql::TArray(t)),
            None -> None,
          },
          _ -> None,
        }
      } else { None }
    },
    _ -> None,
  }

fn statement_of(v: Value) -> Option<String> =
  match v {
    VStr(s) -> Some(s),
    VCtor(name, args) -> if constructor_name(name) != "Bound" { None }
    else { match args { [VStr(s), ..] -> Some(s), _ -> None } },
    VRecord(fields) -> text_in(field_named(fields, "sql")),
    _ -> None,
  }

fn source_of(a: Argument) -> Bytes =
  match a {
    CallArgument(c) -> if c.callee == b"std.sql.statement_of" { b"the text written here" }
    else { Bytes::concat_all([b"`", c.callee, b"()`"]) },
    TaggedArgument(t) -> Bytes::concat_all([b"a tagged literal, read by `", t.callee, b"`"]),
    _ -> b"the text written here",
  }

fn excerpt(text: String, at: Int) -> Bytes / {abort.raise} = {
  let b = Bytes::of_string(text);
  let from = min(max(at, 0), b.len());
  b.slice(from, min(b.len(), from + 24))
}

pub fn check_diagnostics(a: CheckSite, j: CheckResult) -> List<Diagnostic> / {abort.raise} =
  match j {
    Unchecked -> [],
    Checked(check_statements) ->
      check_statements.found.map(|f: StatementError| {
        let schema = a.check.schema;
        let schema_name = match schema { Some(s) -> s.name, None -> b"" };
        let message = Bytes::of_string(f.message);
        let headline = if f.code == b"E0433" {
          Bytes::concat_all([b"this statement ", message, b" in the schema `", schema_name, b"`"])
        } else if f.code == b"E0470" {
          Bytes::concat_all([
            b"the SQL schema check does not support ",
            message,
            b" in a statement checked against the schema",
          ])
        } else { message };
        let placed = if f.at <= 0 { [] } else {
          [
            Bytes::concat_all([
              b"at byte ",
              ascii_of_int(f.at),
              b" of the statement: `",
              excerpt(check_statements.text, f.at),
              b"`",
            ]),
          ]
        };
        let against = if schema == None { [] } else {
          [
            Bytes::concat_all([
              b"checked against the schema `",
              schema_name,
              b"`, a constant of `std.sql.Schema`",
            ]),
          ]
        };
        error_at(
          f.code,
          a.site.module,
          a.site.span,
          headline,
          b"this call runs the statement",
          [
            Bytes::concat_all([
              b"the statement, from ",
              source_of(a.check.statement),
              b": ",
              Bytes::of_string(check_statements.text),
            ]),
          ].concat(
            placed,
          ).concat(
            against,
          ),
        )
      }),
  }

pub fn schemas_rejected(check_sites: List<CheckSite>) -> List<Diagnostic> =
  check_sites.fold(
    { modules: [], diagnostics: [] },
    |accumulator: { modules: List<Int>, diagnostics: List<Diagnostic> }, a: CheckSite|
      if accumulator.modules.contains(a.site.module) { accumulator } else {
        match a.schemas {
          [first, second, ..] ->
            {
              modules: accumulator.modules.push(a.site.module),
              diagnostics: accumulator.diagnostics.push(
                error_with_labels(
                  b"E0471",
                  Bytes::concat_all([
                    b"this statement's module uses two SQL schemas, `",
                    first.name,
                    b"` and `",
                    second.name,
                    b"`, and its statements are limited to one",
                  ]),
                  [
                    label_at(a.site.module, a.site.span, true, b"this call runs a statement"),
                    label_at(first.module, first.span, false, b"a constant of `std.sql.Schema`"),
                    label_at(second.module, second.span, false, b"another"),
                  ],
                  [
                    b"a statement is checked against the schema its module declares or imports; split the modules so each uses one",
                  ],
                ),
              ),
            },
          _ -> accumulator,
        }
      },
  ).diagnostics

fn a_site(callee: Bytes, args: List<Argument>) -> StatementSite =
  { module: 0, span: span_between(3, 9), callee: callee, label: b"items", args: args }

fn a_param(name: Bytes) -> Argument =
  ConstructorArgument({ type_name: b"std.sql.Param", name: name })

test "every operation and definition that runs a statement is declared in a statement module" {
  statement_runners.fold((), |_: Unit, p: StatementRunner|
    assert(
      statement_modules.fold(false, |b: Bool, m: Bytes| b || p.callee.starts_with(m.concat(b"."))),
      Some(String::of_bytes_lossy(p.callee)),
    ))
}

test "`statement_check_of` reads a database call's query text, parameter types and result row fields from the arguments written at the call" {
  let text = CallArgument({ callee: b"m.items_all", hash: b"h", args: [] });
  let query = statement_check_of(
    a_site(b"std.db.db.query", [text, ListArgument([a_param(b"PInt"), OtherArgument])]),
  );
  assert_eq(
    match query { Some(a) -> Some((a.label, a.given, a.row, a.statement == text)), None -> None },
    Some((Some("items"), Some([Some("PInt"), None]), None, true)),
  );
  let row = RowArgument([
    { name: b"sku", read: ScalarRead(b"text_field") },
    { name: b"note", read: OptionalRead(ScalarRead(b"text_field")) },
  ]);
  assert_eq(
    match statement_check_of(a_site(b"std.db.fetch", [text, row, ListArgument([])])) {
      Some(a) -> a.row,
      None -> None,
    },
    Some([
      { name: "sku", kind: sql::TextField },
      { name: "note", kind: sql::OptionalField(sql::TextField) },
    ]),
  );
  let bound = CallArgument({
    callee: b"std.sqlite.bound",
    hash: b"b",
    args: [text, ListArgument([a_param(b"PText")])],
  });
  assert_eq(
    match statement_check_of(a_site(b"std.sqlite.query", [OtherArgument, bound, OtherArgument])) {
      Some(a) -> Some((a.label, a.given, a.statement == text)),
      None -> None,
    },
    Some((None, Some([Some("PText")]), true)),
  );
  assert_eq(param_of(ConstructorArgument({ type_name: b"m.Param", name: b"PInt" })), None);
  assert_eq(statement_check_of(a_site(b"m.other", [text])), None)
}

test "a derived codec's scalar fields map to their column types, and its non-scalar fields map to document or array columns" {
  assert_eq(kind_of(JsonRead), sql::JsonField);
  assert_eq(kind_of(ArrayRead(b"int_field")), sql::ArrayField(sql::IntField));
  assert_eq(kind_of(OptionalRead(DocumentRead)), sql::OptionalField(sql::JsonField));
  assert_eq(scalar_kind(b"numeric_field"), sql::NumericField)
}

test "a schema is decoded from the value that evaluating its definition returns" {
  let column = |name: String, ty: Value, nullable: Bool|
    VRecord([
      { name: "default", value: VCtor("std.sql.DNone", []) },
      { name: "name", value: VStr(name) },
      { name: "nullable", value: VBool(nullable) },
      { name: "ty", value: ty },
    ]);
  let schema = VRecord([
    {
      name: "tables",
      value: VList([
        VRecord([
          { name: "checks", value: VList([]) },
          {
            name: "columns",
            value: VList([
              column("sku", VCtor("std.sql.TText", []), false),
              column("price", VCtor("std.sql.TNumeric", [VInt(12), VInt(2)]), true),
              column("tags", VCtor("std.sql.TArray", [VCtor("std.sql.TText", [])]), false),
            ]),
          },
          { name: "foreign_keys", value: VList([]) },
          { name: "name", value: VStr("items") },
          { name: "primary_key", value: VList([VStr("sku")]) },
          { name: "unique", value: VList([]) },
        ]),
      ]),
    },
  ]);
  assert_eq(
    schema_of(schema),
    Some({
      tables: [
        {
          name: "items",
          columns: [
            sql::column("sku", sql::TText, false),
            sql::column("price", sql::TNumeric(12, 2), true),
            sql::column("tags", sql::TArray(sql::TText), false),
          ],
          primary_key: ["sku"],
          unique: [],
          foreign_keys: [],
          checks: [],
        },
      ],
    }),
  );
  assert_eq(schema_of(VRecord([{ name: "tables", value: VList([VInt(1)]) }])), None);
  assert_eq(statement_of(VRecord([{ name: "sql", value: VStr("select 1") }])), Some("select 1"));
  assert_eq(
    statement_of(VCtor("std.sqlite.Bound", [VStr("select 2"), VList([])])),
    Some("select 2"),
  )
}

test "a module's statements are checked against the schema it declares or imports, directly or indirectly" {
  let imports = [[1], [2], [], [0], []];
  assert_eq(transitive_modules(imports, 0), [0, 1, 2]);
  assert_eq(transitive_modules(imports, 3), [3, 0, 1, 2]);
  assert_eq(transitive_modules(imports, 4), [4]);
  assert_eq(transitive_modules([[1], [0]], 1), [1, 0])
}

test "what the check found is reported at the call, naming the statement and the schema" {
  let declared: ConstSite = { module: 0, span: span_between(0, 1), name: b"m.schema", hash: b"s" };
  let a = {
    site: a_site(b"std.db.db.query", []),
    check: {
      dialect: Postgres,
      operation: Reads,
      label: Some("items"),
      statement: CallArgument({ callee: b"m.items_all", hash: b"h", args: [] }),
      given: None,
      row: None,
      schema: Some(declared),
    },
    schemas: [declared],
  };
  let found = {
    code: b"E0433",
    at: 12,
    message: "names the column `nmae`, which `items` does not have",
  };
  let diagnostics = check_diagnostics(
    a,
    Checked({ text: "select sku, nmae from items", found: [found] }),
  );
  assert_eq(diagnostics.map(|d: Diagnostic| d.code), [b"E0433"]);
  assert_eq(diagnostics.map(|d: Diagnostic| d.message), [
    b"this statement names the column `nmae`, which `items` does not have in the schema `m.schema`",
  ]);
  assert_eq(diagnostics.map(|d: Diagnostic| d.notes_text), [
    [
      b"the statement, from `m.items_all()`: select sku, nmae from items",
      b"at byte 12 of the statement: `nmae from items`",
      b"checked against the schema `m.schema`, a constant of `std.sql.Schema`",
    ],
  ]);
  assert_eq(check_diagnostics(a, Unchecked), []);
  let twice = { ..a, schemas: [declared, { ..declared, name: b"n.schema" }] };
  assert_eq(schemas_rejected([twice, twice]).map(|d: Diagnostic| d.code), [b"E0471"]);
  assert_eq(schemas_rejected([a]), []);
  assert_eq(code_of(sql::Unsupported), b"E0470")
}
