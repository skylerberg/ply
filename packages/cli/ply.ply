    fs.read_link[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.walk[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.set_modified[cwd](p, ms) -> panic("`ply explain` does not use the file system"),
    fs.read_at[abs](p, offset, n) -> panic("`ply explain` does not use the file system"),
