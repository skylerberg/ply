    fs.file_size[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.modified_ms[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.append[abs](p, body) -> panic("`ply explain` does not use the file system"),
    fs.sync[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.lock[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.unlock[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.copy[abs](from, to) -> panic("`ply explain` does not use the file system"),
    fs.remove_tree[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.temp_dir[abs](dir, prefix) -> panic("`ply explain` does not use the file system"),
    fs.canonical[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.mode[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.set_mode[abs](p, m) -> panic("`ply explain` does not use the file system"),
    fs.symlink[abs](p, target) -> panic("`ply explain` does not use the file system"),
    fs.read_link[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.walk[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.set_modified[abs](p, ms) -> panic("`ply explain` does not use the file system"),
    fs.remove[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.rename[cwd](from, to) -> panic("`ply explain` does not use the file system"),
    fs.open[cwd](p, how) -> panic("`ply explain` does not use the file system"),
    fs.read_chunk[cwd](file, max) -> panic("`ply explain` does not use the file system"),
    fs.write_chunk[cwd](file, body) -> panic("`ply explain` does not use the file system"),
    fs.close[cwd](file) -> panic("`ply explain` does not use the file system"),
    fs.open[abs](p, how) -> panic("`ply explain` does not use the file system"),
    fs.read_chunk[abs](file, max) -> panic("`ply explain` does not use the file system"),
    fs.write_chunk[abs](file, body) -> panic("`ply explain` does not use the file system"),
    fs.close[abs](file) -> panic("`ply explain` does not use the file system"),
    fs.stat[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.scan[cwd](p, deep) -> panic("`ply explain` does not use the file system"),
    fs.space[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.link[cwd](p, to) -> panic("`ply explain` does not use the file system"),
    fs.stat[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.scan[abs](p, deep) -> panic("`ply explain` does not use the file system"),
    fs.space[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.link[abs](p, to) -> panic("`ply explain` does not use the file system"),
    entropy.next() -> panic("`ply explain` draws nothing"),
    entropy.secret(n) -> panic("`ply explain` draws nothing"),
    time.now_ms() -> panic("`ply explain` does not read the clock"),
    net.connect[registry](host, port, timeout_ms) ->
      panic("`ply explain` does not use the network"),
    net.connect_tls[registry](host, port, timeout_ms) ->
      panic("`ply explain` does not use the network"),
    net.handshake[registry](c) -> panic("`ply explain` does not use the network"),
    net.send[registry](c, payload, timeout_ms) -> panic("`ply explain` does not use the network"),
    net.recv[registry](c, max, timeout_ms) -> panic("`ply explain` does not use the network"),
    net.close[registry](c) -> panic("`ply explain` does not use the network"),
    fs.list_dir[shipped](p) -> panic("`ply explain` does not read the modules shipped with Ply"),
    fs.read_file[shipped](p) -> panic("`ply explain` does not read the modules shipped with Ply"),
    time.elapsed_ms() -> 0,
    time.elapsed_us() -> 0,
    time.sleep_ms(ms) -> panic("`ply explain` does not wait"),
    process.line[proc]() -> panic("`ply explain` does not read a line from a process"),
    shipped.binary_size() -> None,
    process.bound[git]() -> panic("`ply explain` fetches nothing"),
    process.spawn[git](args, dir, environment_variables) -> panic("`ply explain` fetches nothing"),
    entering::machine.open(library) -> panic("`ply explain` does not load a compiled program"),
    entering::machine.bind(grants) ->
      panic("`ply explain` does not give a program its permissions"),
    entering::machine.hosting(grants) ->
      panic("`ply explain` does not give a program its permissions"),
    entering::machine.enter(unit, root, arguments, run) -> panic("`ply explain` runs no program"),
    entering::machine.report(line, to_stderr) -> panic("`ply explain` runs no test"),
    entering::machine.changed_read(grants, trace) ->
      panic("`ply explain` does not check what a program read"),
    entering::machine.unbind(binding) ->
      panic("`ply explain` does not give a program its permissions"),
    entering::machine.close(unit) -> panic("`ply explain` does not load a compiled program"),
    return u -> io,
  }

test "`changed` reports a source tree as changed when its listing could not be read, even when both the earlier and later listings failed" {
  let one: Option<List<String>> = Some(["m.ply 1 2"]);
  let same: Option<List<String>> = Some(["m.ply 1 2"]);
  let other: Option<List<String>> = Some(["m.ply 9 2"]);
  let unread: Option<List<String>> = None;
  assert(!changed(one, same));
  assert(changed(other, one));
  assert(changed(unread, unread));
  assert(changed(unread, one));
  assert(changed(one, unread));
}

test "the first word of the arguments selects the command, and the command's output and exit code are the program's" {
  let one = run_captured(["explain", "E0302"]);
  assert_eq(one.out, ["E0302 effect that the written signature does not list"]);
  assert_eq(one.err, []);
  assert_eq(one.code, Some(0))
}

test "`check` run where no package contains the working directory prints an error and exits 2, while `doc` of a built-in still works" {
  let nowhere = run_captured(["check"]);
  assert_eq(nowhere.out, []);
  assert_eq(nowhere.code, Some(2));
  let print_output = match nowhere.err.at(0) { Some(l) -> l, None -> "" };
  assert(
    print_output.contains("no `ply.pkg` in `/w` or any directory above it"),
    Some(print_output),
  );
  let builtin = run_captured(["doc", "List::len"]);
  assert_eq(builtin.code, Some(0));
  assert(builtin.out.len() > 0)
}

test "a command that fails writes to the error stream and exits 2" {
  let bad = run_captured(["explain", "E9999"]);
  assert_eq(bad.out, []);
  assert_eq(bad.err.len(), 1);
  assert_eq(bad.code, Some(2))
}

test "`--json` writes one document on the output stream and nothing else" {
  let json = run_captured(["explain", "E0302", "--json"]);
  assert_eq(json.out.len(), 1);
  assert_eq(json.err, []);
  let text = match json.out.at(0) { Some(l) -> l, None -> "" };
  assert(text.starts_with("{"));
  assert(text.ends_with("}"));
  assert(text.contains("\"command\":\"explain\""));
  assert(text.contains("\"exit_code\":0"))
}

test "a word that is no command is rejected, never run as `ply fmt`" {
  let result = run_captured(["frobnicate"]);
  assert_eq(result.out, []);
  assert_eq(result.code, Some(2));
  let print_output = match result.err.at(0) { Some(l) -> l, None -> "" };
  assert(print_output.contains("frobnicate"));
  assert(print_output.contains("unrecognized subcommand"))
}

test "every subcommand the CLI handles appears in the `commands` list, and every listed command is handled" {
  let declared = cli::body(spec("0.0.0-test").root).subs.map(|c: cli::Command| cli::body(c).name);
  let listed = commands();
  assert_eq(
    declared.filter(|n: String| !listed.fold(false, |hit: Bool, m: String| hit || m == n)),
    [],
  );
  assert_eq(
    listed.filter(|n: String| !declared.fold(false, |hit: Bool, m: String| hit || m == n)),
    [],
  )
}

test "a flag no command reads is rejected, never taken as a path" {
  let result = run_captured(["check", "--frobnicate", "m.ply"]);
  assert_eq(result.out, []);
  assert_eq(result.code, Some(2));
  let print_output = match result.err.at(0) { Some(l) -> l, None -> "" };
  assert(print_output.contains("--frobnicate"));
  assert(print_output.contains("unexpected argument"))
}

test "a global flag may stand before the command word" {
  let led = run_captured(["--color", "never", "explain", "E0302"]);
  assert_eq(led.code, Some(0));
  let plain = run_captured(["explain", "E0302"]);
  assert_eq(led.out, plain.out);
  let fused = run_captured(["--color=never", "explain", "E0302"]);
  assert_eq(fused.out, plain.out)
}

fn styled_with(choice: Option<String>, set: List<String>) -> Bool / {abort.raise} =
  handle {
    styled_output(choice)
  } with {
    env.variable(name) ->
      set.fold(None, |found: Option<String>, line: String|
        match line.split_once("=") {
          Some(p) -> if p.head == name { Some(p.tail) } else { found },
          None -> found,
        }),
    term.is_terminal(stream) -> false,
  }

test "colour is decided by environment variables such as `FORCE_COLOR` and `NO_COLOR`, and a `--color` flag overrides them" {
  assert(styled_with(None, ["FORCE_COLOR=1"]), Some("FORCE_COLOR styles a pipe"));
  assert(styled_with(None, ["CLICOLOR_FORCE=1"]), Some("CLICOLOR_FORCE styles a pipe"));
  assert(styled_with(None, ["FORCE_COLOR=0"]), Some("FORCE_COLOR forces whatever its value"));
  assert(!styled_with(None, ["FORCE_COLOR="]), Some("a FORCE_COLOR set to nothing is not set"));
  assert(styled_with(None, ["FORCE_COLOR=1", "NO_COLOR=1"]), Some("FORCE_COLOR outranks NO_COLOR"));
  assert(
    !styled_with(None, ["CLICOLOR_FORCE=1", "NO_COLOR=1"]),
    Some("NO_COLOR outranks CLICOLOR_FORCE"),
  );
  assert(
    styled_with(None, ["CLICOLOR_FORCE=1", "NO_COLOR="]),
    Some("a NO_COLOR set to nothing is not set"),
  );
  assert(!styled_with(Some("never"), ["FORCE_COLOR=1"]), Some("a flag outranks FORCE_COLOR"));
  assert(styled_with(Some("always"), ["NO_COLOR=1"]), Some("a flag outranks NO_COLOR"))
}

test "arguments that are all flags and name no subcommand print nothing and exit 2" {
  let only_flags = run_captured(["--json", "--color", "never"]);
  assert_eq(only_flags.out, []);
  assert_eq(only_flags.code, Some(2))
}

test "running `ply` with no subcommand prints an error to the error stream, nothing to the output stream, and exits 2" {
  let empty = run_captured([]);
  assert_eq(empty.out, []);
  let print_output = match empty.err.at(0) { Some(l) -> l, None -> "" };
  assert(print_output.contains("requires a subcommand"));
  assert_eq(empty.code, Some(2))
}
