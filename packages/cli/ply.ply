/// `ply run` writes its own disclosures to stderr here rather than in its answer: they are about an
/// entry that has not run yet, and the answer is collected after it has.
fn run_command(
  command: String,
  flags: Flags,
  parsed: Parsed,
) -> CommandOutput / {semantics.cached, shipped.read_pack, builder.git[vcs], process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, shipped.version, shipped.names, shipped.module, shipped.definitions, replace::edit.replacement_text[replace], machine::MachineAccess, shipped.runtime, builder.loaded[build], fs.remove[abs], fs.rename[abs], env.variable, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, entropy.secret, time.now_ms, env.working_directory, env.variables, emit.unit, emit.compiled, toolchain.reuse_dir, update_costs::cost_checker.report, literals::evaluation.verdicts, literals::evaluation.statements, compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write, toolchain.bodies_dir, Derives, abort.raise, diverges, shipped.report_reached} =
  match command {
    "bootstrap" -> if flags.identity { bootstrap::identity() }
    else { bootstrap::run(flags, surface::profile_of(parsed)) },
    "new" -> new::run(flags, new::options_from(parsed)),
    "build" -> build::run(flags, machine::config_of(parsed).schema),
    "cache" -> cache::run(flags),
    "callers" -> callers::run(flags),
    "check" -> check::run(flags),
    "defs" -> defs::run(flags, canonical_words(parsed)),
    "hash" -> hashes::run(flags),
    "doc" -> doc::run(flags),
    "explain" -> explain::run(flags),
    "hosts" -> hosts::run(flags, machine::options_from(parsed)),
    "prove" -> prove::run(flags, claims::options_from(parsed)),
    "replace" -> replace::run(flags),
    "resolve" -> resolve::run(flags),
    "vendor" -> vendor::run(flags),
    "why" -> why::run(flags),
    "work" -> work::run(flags),
    "publish" -> publish::run(flags),
    "yank" -> yank::run(flags, yank::options_from(parsed)),
    "contracts" -> contracts::run(flags, contracts::options_from(parsed)),
    "keygen" -> keygen::run(flags, keygen::options_from(parsed)),
    "attest" -> attest::run(flags, options_from(parsed)),
    "review" -> review::run(flags, claims::options_from(parsed)),
    "run" -> run::run(flags, machine::options_from(parsed)),
    "show" -> show::run(flags),
    "std" -> if flags.answering { stdlib::results_identity() } else {
      match flags.out {
        Some(dir) ->
          stdlib::pack_shipped_results(
            if dir.starts_with("/") { dir } else { env.working_directory() ++ "/" ++ dir },
            toolchain.reuse_dir(),
            env.variable("PLY_C_PHASES") != None,
          ),
        None -> stdlib::run(flags),
      }
    },
    "test" -> run_tests::run(flags, tester::options_from(parsed), Some(canonical_words(parsed))),
    "fmt" -> fmt::run(flags),
    "rename" -> rename::run(flags),
    _ -> panic("the parser refused the word first; `std.cli` owns this refusal"),
  }

/// `--workspace`: the command run for every package the path reaches by a path dependency, each as
/// its own root, and then for the path itself.
fn run_workspace(
  command: String,
  flags: Flags,
  parsed: Parsed,
) -> CommandOutput / {semantics.cached, shipped.read_pack, builder.git[vcs], process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, shipped.version, shipped.names, shipped.module, shipped.definitions, replace::edit.replacement_text[replace], machine::MachineAccess, shipped.runtime, builder.loaded[build], fs.remove[abs], fs.rename[abs], env.variable, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, entropy.secret, time.now_ms, env.working_directory, env.variables, time.elapsed_us, emit.unit, emit.compiled, toolchain.reuse_dir, update_costs::cost_checker.report, literals::evaluation.verdicts, literals::evaluation.statements, compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write, toolchain.bodies_dir, Derives, abort.raise, diverges, shipped.report_reached} = {
  let deps = workspace::path_packages(sources::load_resolved(flags.paths)).map(|dir: String| {
    let r = paths::resolve(dir);
    { display: r.display, flags: { ..flags, paths: [r], root: r.display, workspace: false } }
  });
  let packages = deps.push({ display: flags.root, flags: { ..flags, workspace: false } });
  // Each package's heading goes out before it runs, since a run may print as it goes.
  let runs = range(0, packages.len()).fold([], |acc: List<workspace::Run>, i: Int|
    match packages.at(i) {
      None -> acc,
      Some(p) -> {
        print_lines(workspace::heading(args::style_of(flags), i, p.display));
        let answer = run_command(command, p.flags, parsed);
        if !flags.json { print_lines(answer.lines) };
        acc.push({ display: p.display, result: answer })
      },
    });
  workspace::combined(command, runs)
}

/// Every command this program answers, in the order `dispatch` tries them.
fn commands() -> List<String> =
  [
    "bootstrap",
    "build",
    "cache",
    "callers",
    "check",
    "defs",
    "doc",
    "explain",
    "fmt",
    "hash",
    "hosts",
    "rename",
    "new",
    "prove",
    "replace",
    "resolve",
    "vendor",
    "why",
    "work",
    "publish",
    "yank",
    "contracts",
    "keygen",
    "attest",
    "review",
    "run",
    "show",
    "std",
    "test",
  ]

fn print_lines(lines: List<String>) -> Unit / {process.out[proc]} =
  match lines {
    [] -> (),
    [first, ..rest] -> {
      process.out[proc](first);
      print_lines(rest)
    },
  }

fn print_error_lines(lines: List<String>) -> Unit / {process.err[proc]} =
  match lines {
    [] -> (),
    [first, ..rest] -> {
      process.err[proc](first);
      print_error_lines(rest)
    },
  }

fn print_output(
  answer: CommandOutput,
  flags: Flags,
) -> Unit / {process.out[proc], process.err[proc], abort.raise} =
  if flags.json { process.out[proc](to_string(answer.json)) } else {
    print_lines(answer.lines);
    print_error_lines(answer.errs)
  }

/// What `body` prints as it runs, such as each test's result, goes to the output stream, or under
/// `--json` to the error stream, since the output stream then carries the document alone.
fn with_progress<a | e>(
  flags: Flags,
  body: () -> a / {process.out[proc] | e},
) -> a / {process.out[proc], process.err[proc] | e} =
  if !flags.json { body() }
  else { handle { body() } with { process.out[proc](line) -> process.err[proc](line) } }

/// Polling rather than watching: the walk is owed anyway, so a watcher would add a dependency for
/// no latency.
fn poll_ms() -> Int = 120

/// One blank line between reports, which a stream of documents must not carry.
fn print_separator(flags: Flags) -> Unit / {process.out[proc]} =
  if flags.json { () } else { process.out[proc]("") }

/// `--watch`, which never returns: a report, then another one whenever the tree moves. The baseline
/// is stamped before a run and never after — a walk after it folds a save made while it ran into
/// the baseline, and that save is the one the next report exists to notice.
fn watch(
  flags: Flags,
  options: tester::Options,
  checkout: Option<library::Checkout>,
) -> Int / {semantics.cached, shipped.read_pack, shipped.names, shipped.module, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, process.out[proc], process.err[proc], time.sleep_ms, fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, entropy.secret, time.now_ms, env.variable, env.working_directory, machine::MachineAccess, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.compiled, update_costs::cost_checker.report, literals::evaluation.verdicts, literals::evaluation.statements, toolchain.bodies_dir, Derives, abort.raise, diverges, shipped.report_reached, toolchain.reuse_dir} = {
  let baseline = stamps_of(flags, checkout);
  let first = library::with_checkout_library(checkout, ||
    with_progress(flags, || run_tests::run_once(flags, options, None, None)));
  print_output(first.result, flags);
  watch_loop(flags, options, checkout, baseline, first.held, first.embeds)
}

/// What a watch compares between reports: the paths it was given, and the toolchain's library the
/// checkout holding them keeps, which each report reads again.
type Stamps = { own: Option<List<String>>, library: Option<List<String>> }

fn stamps_of(
  flags: Flags,
  checkout: Option<library::Checkout>,
) -> Stamps / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], env.working_directory, abort.raise, diverges} =
  {
    own: run_tests::file_stamps(flags.paths),
    library: match checkout {
      None -> Some([]),
      Some(c) ->
        run_tests::file_stamps(library::parts_of(c).map(|p: library::Part| paths::resolve(p.dir))),
    },
  }

/// A walk that failed reports `None`, and two of those are not a tree that held still: the report
/// is owed again, and it is the run that says what is wrong with the tree.
fn changed(now: Option<List<String>>, baseline: Option<List<String>>) -> Bool =
  match now {
    None -> true,
    Some(now) -> match baseline { None -> true, Some(baseline) -> now != baseline },
  }

/// A file the last report's load embedded is not in the walk: it moved when it reads otherwise now.
fn watch_loop(
  flags: Flags,
  options: tester::Options,
  checkout: Option<library::Checkout>,
  baseline: Stamps,
  held: Option<program::TimedLoad>,
  embeds: List<Embed>,
) -> Int / {semantics.cached, shipped.read_pack, shipped.names, shipped.module, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, process.out[proc], process.err[proc], time.sleep_ms, fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, entropy.secret, time.now_ms, env.variable, env.working_directory, machine::MachineAccess, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.compiled, update_costs::cost_checker.report, literals::evaluation.verdicts, literals::evaluation.statements, toolchain.bodies_dir, Derives, abort.raise, diverges, shipped.report_reached, toolchain.reuse_dir} = {
  time.sleep_ms(poll_ms());
  let now = stamps_of(flags, checkout);
  // A load the library moved under answers nothing a later one may take back.
  let library_moved = changed(now.library, baseline.library);
  if changed(now.own, baseline.own) || library_moved || sources::embeds_changed(embeds) {
    print_separator(flags);
    let next = library::with_checkout_library(checkout, ||
      with_progress(flags, ||
        run_tests::run_once(flags, options, if library_moved { None } else { held }, None)));
    print_output(next.result, flags);
    watch_loop(flags, options, checkout, now, next.held, next.embeds)
  } else { watch_loop(flags, options, checkout, baseline, held, embeds) }
}

/// A parsed line as one list of words: the command, each flag with its value, the positionals and
/// what followed `--`, so two lines that parse alike spell alike.
fn canonical_words(p: Parsed) -> List<String> =
  p.path.concat(
    p.flags.flat_map(|g: cli::Given|
      match g.value { Some(v) -> ["--" ++ g.long, v], None -> ["--" ++ g.long] }),
  ).concat(
    p.positionals,
  ).concat(
    ["--"].concat(p.argv),
  )

fn dispatch(
  parsed: Parsed,
  styled: Bool,
) -> Int / {semantics.cached, shipped.read_pack, builder.git[vcs], process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, time.sleep_ms, env.variable, shipped.version, env.working_directory, shipped.names, shipped.module, shipped.definitions, replace::edit.replacement_text[replace], machine::MachineAccess, shipped.runtime, builder.loaded[build], fs.remove[abs], fs.rename[abs], net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, entropy.secret, time.now_ms, env.variables, emit.unit, emit.compiled, toolchain.reuse_dir, update_costs::cost_checker.report, literals::evaluation.verdicts, literals::evaluation.statements, compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write, toolchain.bodies_dir, Derives, abort.raise, diverges, shipped.report_reached} = {
  let command = parsed.path.at_or(0, "");
  let resolved = paths::resolve_all(command, parsed);
  let at = match resolved {
    Ok(rs) -> match rs.at(0) { Some(r) -> r.absolute, None -> env.working_directory() },
    Err(pwd) -> pwd,
  };
  // A load inside the checkout that builds `ply` reads that checkout's library, not this `ply`'s.
  let checkout = if paths::loads(command) { library::enclosing_checkout(at) } else { None };
  match resolved {
    // No package to load: a name may still be a builtin's or a shipped module's.
    Err(pwd) ->
      library::with_checkout_library(checkout, || {
        let flags: Flags = args::from_parsed(parsed, styled, ".", []);
        let nowhere = sources::no_package(pwd);
        let answer: CommandOutput = if command == "doc" { doc::without_project(flags, nowhere) }
        else { reported(style_of(flags), command, [nowhere], []) };
        print_output(answer, flags);
        answer.code
      }),
    Ok(resolved) -> {
      let display = match resolved.at(0) { Some(r) -> r.display, None -> "." };
      let flags: Flags = args::from_parsed(parsed, styled, display, resolved);
      if flags.watch { watch(flags, tester::options_from(parsed), checkout) } else {
        library::with_checkout_library(checkout, || {
          let answer: CommandOutput = with_progress(flags, ||
            if flags.workspace { run_workspace(command, flags, parsed) }
            else { run_command(command, flags, parsed) });
          print_output(answer, flags);
          answer.code
        })
      }
    },
  }
}

/// The whole line is the program's to read now: the surface is `surface.ply`'s declaration of it,
/// and a refusal is the parser's shape — the error, the usage, and the way to help. Help and
/// version print and exit 0; a refusal never runs a command.
pub fn main() -> Unit / {shipped.read_pack, process.bound[git], process.spawn[git], process.line[proc], process.args[proc], process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, time.sleep_ms, env.variable, term.is_terminal, shipped.version, env.working_directory, shipped.names, shipped.module, shipped.runtime, toolchain.bodies_dir, shipped.binary_size, process.exit[proc], fs.remove[abs], fs.rename[abs], net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, entropy.secret, time.now_ms, env.variables, Emits, toolchain.reuse_dir, compilers.read[cc], compilers.write[cc], compilers.read[tcc], compilers.write[tcc], toolchain.read, toolchain.write, abort.raise, diverges, shipped.report_reached, shipped.run_root, shipped.digests, machine::MachineAccess} = {
  let argv = process.args[proc]();
  let line = spec(shipped.version());
  match parse(line, argv) {
    Help(path) -> {
      process.out[proc](help(line, path));
      process.exit[proc](ok_code())
    },
    Version -> {
      process.out[proc](version_line(line));
      process.exit[proc](ok_code())
    },
    Failed(refusal) -> {
      print_error_lines([error_text(line, refusal)]);
      process.exit[proc](compile_error())
    },
    Run(parsed) -> {
      let styled = styled_output(value(parsed, "color"));
      process.exit[proc](
        units::emitting(||
          update_costs::with_cost_cache(||
            literals::with_evaluation_cache(||
              vcs::fetching(||
                replace::with_replacement(||
                  build::with_read_back(|| caching(|| dispatch(parsed, styled)))))))),
      )
    },
  }
}

/// Colour and the marks, decided where the terminal can be asked, by `std.term`'s rule: the
/// flag first, then `FORCE_COLOR`, then `NO_COLOR`, then `CLICOLOR_FORCE`, then whether standard
/// output is a terminal that is not `dumb`.
fn styled_output(choice: Option<String>) -> Bool / {env.variable, term.is_terminal} =
  styles(
    decide(
      match choice { Some("always") -> Always, Some("never") -> Never, _ -> Auto },
      term.is_terminal(Stdout),
      {
        no_color: env.variable("NO_COLOR"),
        force_color: env.variable("FORCE_COLOR"),
        clicolor_force: env.variable("CLICOLOR_FORCE"),
        term: env.variable("TERM"),
        colorterm: env.variable("COLORTERM"),
      },
    ),
  )

// --- Tests ------------------------------------------------------------------

/// The lines a run wrote and the code it asked to exit with, over a program that touches no tree.
fn run_captured(argv: List<String>) -> FakeProcess / {abort.raise, diverges} =
  handle {
    main()
  } with {
    var io = captured(argv),
    process.args[proc]() -> args_step(io),
    process.out[proc](text) -> {
      io = out_step(io, text);
    },
    process.err[proc](text) -> {
      io = err_step(io, text);
    },
    // The run ends here: what the clause answers is the `handle`'s, which `return` does not map.
    process.exit[proc](code) resume k -> exit_step(io, code),
    env.variable(name) -> None,
    env.variables() -> [],
    term.is_terminal(stream) -> false,
    shipped.version() -> "0.0.0-test",
    env.working_directory() -> "/w",
    toolchain.reuse_dir() -> panic("`ply explain` reuses no answer"),
    toolchain.bodies_dir() -> panic("`ply explain` emits nothing"),
    shipped.runtime() -> panic("`ply explain` emits nothing"),
    shipped.definitions() -> panic("`ply explain` emits nothing"),
    shipped.names() -> panic("`ply explain` emits nothing"),
    shipped.module(name) -> panic("`ply explain` emits nothing"),
    shipped.read_pack(path, offset, len) -> panic("`ply explain` loads nothing"),
    shipped.report_reached(view, pulled) -> panic("`ply explain` loads nothing"),
    shipped.run_root(library, root, arguments, timeout_ms) ->
      panic("`ply explain` runs no deriver"),
    shipped.digests() -> panic("`ply explain` runs no deriver"),
    compilers.find[cc]() -> panic("`ply explain` compiles nothing"),
    compilers.start[cc](args) -> panic("`ply explain` compiles nothing"),
    compilers.wait[cc](job) -> panic("`ply explain` compiles nothing"),
    compilers.find[tcc]() -> panic("`ply explain` compiles nothing"),
    compilers.start[tcc](args) -> panic("`ply explain` compiles nothing"),
    compilers.wait[tcc](job) -> panic("`ply explain` compiles nothing"),
    toolchain.cache() -> panic("`ply explain` compiles nothing"),
    toolchain.jobs() -> panic("`ply explain` compiles nothing"),
    toolchain.exists(path) -> panic("`ply explain` compiles nothing"),
    toolchain.read_file(path) -> panic("`ply explain` compiles nothing"),
    toolchain.write_file(path, bytes) -> panic("`ply explain` compiles nothing"),
    toolchain.rename(from, to) -> panic("`ply explain` compiles nothing"),
    toolchain.append(path, bytes) -> panic("`ply explain` compiles nothing"),
    toolchain.temp_dir() -> panic("`ply explain` compiles nothing"),
    toolchain.remove_tree(dir) -> panic("`ply explain` compiles nothing"),
    toolchain.libraries() -> panic("`ply explain` compiles nothing"),
    toolchain.run(path, args) -> panic("`ply explain` runs nothing it built"),
    fs.kind[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.kind[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.resolved_kind[cwd](p) -> Dir,
    // No directory holds a `ply.pkg`: the working directory is part of no package.
    fs.resolved_kind[abs](p) -> Missing,
    fs.list_dir[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.list_dir[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.read_file[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.read_file[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.write_file[cwd](p, body) -> panic("`ply explain` reaches no tree"),
    fs.write_file[abs](p, body) -> panic("`ply explain` reaches no tree"),
    fs.write_secret[cwd](p, before, secret, encoding, after) ->
      panic("`ply explain` reaches no tree"),
    fs.write_secret[abs](p, before, secret, encoding, after) ->
      panic("`ply explain` reaches no tree"),
    fs.read_secret[cwd](p, before, encoding, after) -> panic("`ply explain` reaches no tree"),
    fs.read_secret[abs](p, before, encoding, after) -> panic("`ply explain` reaches no tree"),
    fs.create_dir[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.create_dir[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.remove[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.rename[abs](from, to) -> panic("`ply explain` reaches no tree"),
    fs.read_at[cwd](p, offset, n) -> panic("`ply explain` reaches no tree"),
    fs.exists[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.file_size[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.modified_ms[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.append[cwd](p, body) -> panic("`ply explain` reaches no tree"),
    fs.sync[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.lock[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.unlock[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.copy[cwd](from, to) -> panic("`ply explain` reaches no tree"),
    fs.remove_tree[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.temp_dir[cwd](dir, prefix) -> panic("`ply explain` reaches no tree"),
    fs.canonical[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.mode[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.set_mode[cwd](p, m) -> panic("`ply explain` reaches no tree"),
    fs.symlink[cwd](p, target) -> panic("`ply explain` reaches no tree"),
    fs.read_link[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.walk[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.set_modified[cwd](p, ms) -> panic("`ply explain` reaches no tree"),
    fs.read_at[abs](p, offset, n) -> panic("`ply explain` reaches no tree"),
    fs.exists[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.file_size[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.modified_ms[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.append[abs](p, body) -> panic("`ply explain` reaches no tree"),
    fs.sync[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.lock[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.unlock[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.copy[abs](from, to) -> panic("`ply explain` reaches no tree"),
    fs.remove_tree[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.temp_dir[abs](dir, prefix) -> panic("`ply explain` reaches no tree"),
    fs.canonical[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.mode[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.set_mode[abs](p, m) -> panic("`ply explain` reaches no tree"),
    fs.symlink[abs](p, target) -> panic("`ply explain` reaches no tree"),
    fs.read_link[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.walk[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.set_modified[abs](p, ms) -> panic("`ply explain` reaches no tree"),
    fs.remove[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.rename[cwd](from, to) -> panic("`ply explain` reaches no tree"),
    fs.open[cwd](p, how) -> panic("`ply explain` reaches no tree"),
    fs.read_chunk[cwd](file, max) -> panic("`ply explain` reaches no tree"),
    fs.write_chunk[cwd](file, body) -> panic("`ply explain` reaches no tree"),
    fs.close[cwd](file) -> panic("`ply explain` reaches no tree"),
    fs.open[abs](p, how) -> panic("`ply explain` reaches no tree"),
    fs.read_chunk[abs](file, max) -> panic("`ply explain` reaches no tree"),
    fs.write_chunk[abs](file, body) -> panic("`ply explain` reaches no tree"),
    fs.close[abs](file) -> panic("`ply explain` reaches no tree"),
    fs.stat[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.scan[cwd](p, deep) -> panic("`ply explain` reaches no tree"),
    fs.space[cwd](p) -> panic("`ply explain` reaches no tree"),
    fs.link[cwd](p, to) -> panic("`ply explain` reaches no tree"),
    fs.stat[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.scan[abs](p, deep) -> panic("`ply explain` reaches no tree"),
    fs.space[abs](p) -> panic("`ply explain` reaches no tree"),
    fs.link[abs](p, to) -> panic("`ply explain` reaches no tree"),
    entropy.next() -> panic("`ply explain` draws nothing"),
    entropy.secret(n) -> panic("`ply explain` draws nothing"),
    time.now_ms() -> panic("`ply explain` reads no clock"),
    net.connect[registry](host, port, timeout_ms) -> panic("`ply explain` asks no registry"),
    net.connect_tls[registry](host, port, timeout_ms) -> panic("`ply explain` asks no registry"),
    net.handshake[registry](c) -> panic("`ply explain` asks no registry"),
    net.send[registry](c, payload, timeout_ms) -> panic("`ply explain` asks no registry"),
    net.recv[registry](c, max, timeout_ms) -> panic("`ply explain` asks no registry"),
    net.close[registry](c) -> panic("`ply explain` asks no registry"),
    fs.list_dir[shipped](p) -> panic("`ply explain` reaches no shipped modules"),
    fs.read_file[shipped](p) -> panic("`ply explain` reaches no shipped modules"),
    time.elapsed_ms() -> 0,
    // The twin's readings are milliseconds, so a microsecond reading is the same number a
    // thousand times finer.
    time.elapsed_us() -> 0,
    time.sleep_ms(ms) -> panic("`ply explain` waits for nothing"),
    process.line[proc]() -> panic("`ply explain` reads no replacement"),
    shipped.binary_size() -> None,
    process.bound[git]() -> panic("`ply explain` fetches nothing"),
    process.spawn[git](args, dir, vars) -> panic("`ply explain` fetches nothing"),
    entering::machine.open(library) -> panic("`ply explain` opens no unit"),
    entering::machine.bind(grants) -> panic("`ply explain` binds no host"),
    entering::machine.hosting(grants) -> panic("`ply explain` binds no host"),
    entering::machine.enter(unit, root, arguments, run) -> panic("`ply explain` runs no program"),
    entering::machine.changed_read(grants, trace) -> panic("`ply explain` reads no pass"),
    entering::machine.unbind(binding) -> panic("`ply explain` binds no host"),
    entering::machine.close(unit) -> panic("`ply explain` opens no unit"),
    return u -> io,
  }

test "a walk that failed is not a tree that held still" {
  let one: Option<List<String>> = Some(["m.ply 1 2"]);
  let same: Option<List<String>> = Some(["m.ply 1 2"]);
  let other: Option<List<String>> = Some(["m.ply 9 2"]);
  let unread: Option<List<String>> = None;
  assert(!changed(one, same));
  assert(changed(other, one));
  // Both ends unread: equal values, and still owed a report.
  assert(changed(unread, unread));
  assert(changed(unread, one));
  assert(changed(one, unread));
}

test "the command word picks the command, and its code is the run's" {
  let one = run_captured(["explain", "E0302"]);
  assert_eq(one.out, ["E0302 effect not permitted by the written row"]);
  assert_eq(one.err, []);
  assert_eq(one.code, Some(0))
}

test "a line that names no path where no package holds the working directory loads nothing" {
  let nowhere = run_captured(["check"]);
  assert_eq(nowhere.out, []);
  assert_eq(nowhere.code, Some(2));
  let print_output = match nowhere.err.at(0) { Some(l) -> l, None -> "" };
  assert(
    print_output.contains("no `ply.pkg` in `/w` or any directory above it"),
    Some(print_output),
  );
  // A native is no project's, so its page needs none.
  let builtin = run_captured(["doc", "List::len"]);
  assert_eq(builtin.code, Some(0));
  assert(builtin.out.len() > 0)
}

test "a command that refuses writes to the error stream and exits 2" {
  let bad = run_captured(["explain", "E9999"]);
  assert_eq(bad.out, []);
  assert_eq(bad.err.len(), 1);
  assert_eq(bad.code, Some(2))
}

// The keys come back in byte order, `code` before `command`, so the document is read and not matched.
test "`--json` writes one document on the output stream and nothing else" {
  let json = run_captured(["explain", "E0302", "--json"]);
  assert_eq(json.out.len(), 1);
  assert_eq(json.err, []);
  let text = match json.out.at(0) { Some(l) -> l, None -> "" };
  assert(text.starts_with("{"));
  assert(text.ends_with("}"));
  assert(text.contains("\"command\":\"explain\""));
  assert(text.contains("\"exit_code\":0"))
}

test "a word that is no command is refused, never run as `ply fmt`" {
  let answer = run_captured(["frobnicate"]);
  // Nothing on the output stream: `fmt` would have written the files it rewrote.
  assert_eq(answer.out, []);
  assert_eq(answer.code, Some(2));
  let print_output = match answer.err.at(0) { Some(l) -> l, None -> "" };
  assert(print_output.contains("frobnicate"));
  assert(print_output.contains("unrecognized subcommand"))
}

test "every command the dispatch answers is one `commands` lists" {
  // The list is what an unknown word is told to try, so a command missing from it is a command
  // nobody is told about.
  let declared = cli::body(spec("0.0.0-test").root).subs.map(|c: cli::Command| cli::body(c).name);
  let listed = commands();
  assert_eq(
    declared.filter(|n: String| !listed.fold(false, |hit: Bool, m: String| hit || m == n)),
    [],
  );
  assert_eq(
    listed.filter(|n: String| !declared.fold(false, |hit: Bool, m: String| hit || m == n)),
    [],
  )
}

test "a flag no command reads is refused, never taken as a path" {
  let answer = run_captured(["check", "--frobnicate", "m.ply"]);
  assert_eq(answer.out, []);
  assert_eq(answer.code, Some(2));
  let print_output = match answer.err.at(0) { Some(l) -> l, None -> "" };
  assert(print_output.contains("--frobnicate"));
  assert(print_output.contains("unexpected argument"))
}

test "a global flag may stand before the command word" {
  // `ply --color never explain E0302` names `explain`, not `--color`.
  let led = run_captured(["--color", "never", "explain", "E0302"]);
  assert_eq(led.code, Some(0));
  let plain = run_captured(["explain", "E0302"]);
  assert_eq(led.out, plain.out);
  // A flag's value is skipped with it: `never` is not mistaken for the command.
  let fused = run_captured(["--color=never", "explain", "E0302"]);
  assert_eq(fused.out, plain.out)
}

/// Whether a run's output, a pipe, is styled under the flag `choice` and the variables `set`, each
/// `NAME=value`.
fn styled_with(choice: Option<String>, set: List<String>) -> Bool / {abort.raise} =
  handle {
    styled_output(choice)
  } with {
    env.variable(name) ->
      set.fold(None, |found: Option<String>, line: String|
        match line.split_once("=") {
          Some(p) -> if p.head == name { Some(p.tail) } else { found },
          None -> found,
        }),
    term.is_terminal(stream) -> false,
  }

test "the environment decides colour as its conventions say, and a flag outranks it" {
  assert(styled_with(None, ["FORCE_COLOR=1"]), Some("FORCE_COLOR styles a pipe"));
  assert(styled_with(None, ["CLICOLOR_FORCE=1"]), Some("CLICOLOR_FORCE styles a pipe"));
  assert(styled_with(None, ["FORCE_COLOR=0"]), Some("FORCE_COLOR forces whatever its value"));
  assert(!styled_with(None, ["FORCE_COLOR="]), Some("a FORCE_COLOR set to nothing is not set"));
  assert(styled_with(None, ["FORCE_COLOR=1", "NO_COLOR=1"]), Some("FORCE_COLOR outranks NO_COLOR"));
  assert(
    !styled_with(None, ["CLICOLOR_FORCE=1", "NO_COLOR=1"]),
    Some("NO_COLOR outranks CLICOLOR_FORCE"),
  );
  assert(
    styled_with(None, ["CLICOLOR_FORCE=1", "NO_COLOR="]),
    Some("a NO_COLOR set to nothing is not set"),
  );
  assert(!styled_with(Some("never"), ["FORCE_COLOR=1"]), Some("a flag outranks FORCE_COLOR"));
  assert(styled_with(Some("always"), ["NO_COLOR=1"]), Some("a flag outranks NO_COLOR"))
}

test "a line with no word that is not a flag names no command" {
  let only_flags = run_captured(["--json", "--color", "never"]);
  assert_eq(only_flags.out, []);
  assert_eq(only_flags.code, Some(2))
}

test "no command word at all is a refusal, and nothing is written" {
  let empty = run_captured([]);
  assert_eq(empty.out, []);
  let print_output = match empty.err.at(0) { Some(l) -> l, None -> "" };
  assert(print_output.contains("requires a subcommand"));
  assert_eq(empty.code, Some(2))
}
