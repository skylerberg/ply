fn run_command(
  command: String,
  flags: Flags,
  parsed: Parsed,
) -> CommandOutput / {semantics.cached, shipped.read_pack, builder.git[vcs], process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, shipped.version, shipped.names, shipped.module, shipped.definitions, replace::edit.replacement_text[replace], machine::MachineAccess, shipped.runtime, builder.loaded[build], fs.remove[abs], fs.rename[abs], env.variable, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, entropy.secret, time.now_ms, env.working_directory, env.variables, emit.unit, emit.compiled, toolchain.reuse_dir, update_costs::cost_checker.report, literals::evaluation.verdicts, literals::evaluation.statements, compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write, toolchain.bodies_dir, Derives, abort.raise, diverges, shipped.report_reached} =
  match command {
    "bootstrap" -> if flags.identity { bootstrap::identity() }
    else { bootstrap::run(flags, surface::profile_of(parsed)) },
    "new" -> new::run(flags, new::options_from(parsed)),
    "build" -> build::run(flags, machine::config_of(parsed).schema),
    "cache" -> cache::run(flags),
    "callers" -> callers::run(flags),
    "check" -> check::run(flags),
    "definitions" -> definitions::run(flags, canonical_words(parsed)),
    "hash" -> hashes::run(flags),
    "doc" -> doc::run(flags),
    "explain" -> explain::run(flags),
    "hosts" -> hosts::run(flags, machine::options_from(parsed)),
    "prove" -> prove::run(flags, claims::options_from(parsed)),
    "replace" -> replace::run(flags),
    "resolve" -> resolve::run(flags),
    "vendor" -> vendor::run(flags),
    "why" -> reason::run(flags),
    "work" -> work::run(flags),
    "publish" -> publish::run(flags),
    "yank" -> yank::run(flags, yank::options_from(parsed)),
    "contracts" -> contracts::run(flags, contracts::options_from(parsed)),
    "keygen" -> keygen::run(flags, keygen::options_from(parsed)),
    "attest" -> attest::run(flags, options_from(parsed)),
    "review" -> review::run(flags, claims::options_from(parsed)),
    "run" -> run::run(flags, machine::options_from(parsed)),
    "show" -> show::run(flags),
    "std" -> if flags.returning { stdlib::results_identity() } else {
      match flags.out {
        Some(dir) ->
          stdlib::pack_shipped_results(
            if dir.starts_with("/") { dir } else { env.working_directory() ++ "/" ++ dir },
            toolchain.reuse_dir(),
            env.variable("PLY_C_PHASES") != None,
          ),
        None -> stdlib::run(flags),
      }
    },
    "test" -> run_tests::run(flags, tester::options_from(parsed), Some(canonical_words(parsed))),
    "fmt" -> fmt::run(flags),
    "rename" -> rename::run(flags),
    _ -> panic("the parser refused the word first; `std.cli` owns this refusal"),
  }

fn run_workspace(
  command: String,
  flags: Flags,
  parsed: Parsed,
) -> CommandOutput / {semantics.cached, shipped.read_pack, builder.git[vcs], process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, shipped.version, shipped.names, shipped.module, shipped.definitions, replace::edit.replacement_text[replace], machine::MachineAccess, shipped.runtime, builder.loaded[build], fs.remove[abs], fs.rename[abs], env.variable, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, entropy.secret, time.now_ms, env.working_directory, env.variables, time.elapsed_us, emit.unit, emit.compiled, toolchain.reuse_dir, update_costs::cost_checker.report, literals::evaluation.verdicts, literals::evaluation.statements, compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write, toolchain.bodies_dir, Derives, abort.raise, diverges, shipped.report_reached} = {
  let dependencies = workspace::path_packages(sources::load_resolved(flags.paths)).map(
    |dir: String| {
      let r = paths::resolve(dir);
      { display: r.display, flags: { ..flags, paths: [r], root: r.display, workspace: false } }
    },
  );
  let packages = dependencies.push({ display: flags.root, flags: { ..flags, workspace: false } });
  let runs = range(0, packages.len()).fold([], |acc: List<workspace::Run>, i: Int|
    match packages.at(i) {
      None -> acc,
      Some(p) -> {
        print_lines(workspace::heading(args::style_of(flags), i, p.display));
        let result = run_command(command, p.flags, parsed);
        if !flags.json { print_lines(result.lines) };
        acc.push({ display: p.display, result: result })
      },
    });
  workspace::combined(command, runs)
}

fn commands() -> List<String> =
  [
    "bootstrap",
    "build",
    "cache",
    "callers",
    "check",
    "definitions",
    "doc",
    "explain",
    "fmt",
    "hash",
    "hosts",
    "rename",
    "new",
    "prove",
