    fs.exists[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.file_size[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.modified_ms[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.append[cwd](p, body) -> panic("`ply explain` does not use the file system"),
    fs.sync[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.lock[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.unlock[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.copy[cwd](from, to) -> panic("`ply explain` does not use the file system"),
    fs.remove_tree[cwd](p) -> panic("`ply explain` does not use the file system"),
