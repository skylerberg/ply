fn run_command(
  command: String,
  flags: Flags,
  parsed: Parsed,
) -> CommandOutput / {semantics.cached, shipped.read_pack, builder.git[vcs], process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, shipped.version, shipped.names, shipped.module, shipped.definitions, replace::edit.replacement_text[replace], machine::MachineAccess, shipped.runtime, builder.loaded[build], fs.remove[abs], fs.rename[abs], env.variable, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, entropy.secret, time.now_ms, env.working_directory, env.variables, emit.unit, emit.compiled, toolchain.reuse_dir, update_costs::cost_checker.report, literals::evaluation.verdicts, literals::evaluation.statements, compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write, toolchain.bodies_dir, Derives, abort.raise, diverges, shipped.report_view_used} =
  match command {
    "new" -> new::run(flags, new::options_from(parsed)),
    "build" -> build::run(flags, machine::config_of(parsed).schema),
    "cache" -> cache::run(flags),
    "callers" -> callers::run(flags),
    "unused" -> unused::run(flags),
    "check" -> check::run(flags),
    "definitions" -> definitions::run(flags),
    "hash" -> hashes::run(flags),
    "doc" -> doc::run(flags),
    "explain" -> explain::run(flags),
    "hosts" -> hosts::run(flags, machine::options_from(parsed)),
    "prove" -> prove::run(flags, claims::options_from(parsed)),
    "replace" -> replace::run(flags),
    "resolve" -> resolve::run(flags),
    "vendor" -> vendor::run(flags),
    "why" -> reason::run(flags),
    "work" -> if flags.identity { work::identity_output() } else { work::run(flags) },
    "publish" -> publish::run(flags),
    "yank" -> yank::run(flags, yank::options_from(parsed)),
    "contracts" -> contracts::run(flags, contracts::options_from(parsed)),
    "keygen" -> keygen::run(flags, keygen::options_from(parsed)),
    "attest" -> attest::run(flags, options_from(parsed)),
    "review" -> review::run(flags, claims::options_from(parsed)),
    "run" -> run::run(flags, machine::options_from(parsed)),
    "show" -> show::run(flags),
    "std" -> if flags.returning { stdlib::shipped_results_digest() } else {
      match flags.out {
        Some(dir) ->
          stdlib::pack_shipped_results(
            if dir.starts_with("/") { dir } else { env.working_directory() ++ "/" ++ dir },
            toolchain.reuse_dir(),
            env.variable("PLY_C_PHASES") != None,
          ),
        None -> stdlib::run(flags),
      }
    },
    "test" -> run_tests::run(flags, tester::options_from(parsed)),
    "fmt" -> fmt::run(flags),
    "rename" -> rename::run(flags),
    _ -> panic("the parser rejected the word first; `std.cli` owns this rejection"),
  }

fn run_each_package(
  command: String,
  flags: Flags,
  parsed: Parsed,
) -> CommandOutput / {semantics.cached, shipped.read_pack, builder.git[vcs], process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, shipped.version, shipped.names, shipped.module, shipped.definitions, replace::edit.replacement_text[replace], machine::MachineAccess, shipped.runtime, builder.loaded[build], fs.remove[abs], fs.rename[abs], env.variable, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, entropy.secret, time.now_ms, env.working_directory, env.variables, time.elapsed_us, emit.unit, emit.compiled, toolchain.reuse_dir, update_costs::cost_checker.report, literals::evaluation.verdicts, literals::evaluation.statements, compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write, toolchain.bodies_dir, Derives, abort.raise, diverges, shipped.report_view_used} = {
  let dependencies = workspace::path_packages(sources::load_resolved(flags.paths)).map(
    |dir: String| {
      let r = paths::resolve(dir);
      { display: r.display, flags: { ..flags, paths: [r], root: r.display, workspace: false } }
    },
  );
  let packages = dependencies.push({ display: flags.root, flags: { ..flags, workspace: false } });
  let runs = range(0, packages.len()).fold([], |accumulator: List<workspace::Run>, i: Int|
    match packages.at(i) {
      None -> accumulator,
      Some(p) -> {
        print_lines(workspace::heading(args::style_of(flags), i, p.display));
        let result = run_command(command, p.flags, parsed);
        if !flags.json { print_lines(result.lines) };
        accumulator.push({ display: p.display, result: result })
      },
    });
  workspace::combined(command, runs)
}

fn commands() -> List<String> =
  [
    "build",
    "cache",
    "callers",
    "check",
    "definitions",
    "doc",
    "explain",
    "fmt",
    "hash",
    "hosts",
    "rename",
    "new",
    "prove",
    "replace",
    "resolve",
    "vendor",
    "why",
    "work",
    "publish",
    "yank",
    "contracts",
    "keygen",
    "attest",
    "review",
    "run",
    "show",
    "std",
    "test",
    "unused",
  ]

fn print_lines(lines: List<String>) -> Unit / {process.out[proc]} =
  match lines {
    [] -> (),
    [first, ..rest] -> {
      process.out[proc](first);
      print_lines(rest)
    },
  }

fn print_error_lines(lines: List<String>) -> Unit / {process.err[proc]} =
  match lines {
    [] -> (),
    [first, ..rest] -> {
      process.err[proc](first);
      print_error_lines(rest)
    },
  }

fn print_output(
  result: CommandOutput,
  flags: Flags,
) -> Unit / {process.out[proc], process.err[proc], abort.raise} =
  if flags.json { process.out[proc](to_string(result.json)) } else {
    print_lines(result.lines);
    print_error_lines(result.errs)
  }

fn with_progress<a | e>(
  flags: Flags,
  body: () -> a / {process.out[proc] | e},
) -> a / {process.out[proc], process.err[proc] | e} =
  if !flags.json { body() }
  else { handle { body() } with { process.out[proc](line) -> process.err[proc](line) } }

fn poll_ms() -> Int = 120

fn print_separator(flags: Flags) -> Unit / {process.out[proc]} =
  if flags.json { () } else { process.out[proc]("") }

fn watch(
  flags: Flags,
  options: tester::Options,
  checkout: Option<Checkout>,
) -> Int / {semantics.cached, shipped.read_pack, shipped.names, shipped.module, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, process.out[proc], process.err[proc], time.sleep_ms, fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, entropy.secret, time.now_ms, env.variable, env.working_directory, machine::MachineAccess, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.compiled, update_costs::cost_checker.report, literals::evaluation.verdicts, literals::evaluation.statements, toolchain.bodies_dir, Derives, abort.raise, diverges, shipped.report_view_used, toolchain.reuse_dir} = {
  let baseline = stamps_of(flags, checkout);
  let first = library::with_checkout_library(checkout, ||
    with_progress(flags, || run_tests::run_once(flags, options, None)));
  print_output(first.result, flags);
  watch_loop(flags, options, checkout, baseline, first.cached_load, first.embeds)
}

type Stamps = { own: Option<List<String>>, library: Option<List<String>> }

fn stamps_of(
  flags: Flags,
  checkout: Option<Checkout>,
) -> Stamps / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], env.working_directory, abort.raise, diverges} =
  {
    own: run_tests::file_stamps(flags.paths),
    library: match checkout {
      None -> Some([]),
      Some(c) -> run_tests::file_stamps(parts_of(c).map(|p: Part| paths::resolve(p.dir))),
    },
  }

fn changed(now: Option<List<String>>, baseline: Option<List<String>>) -> Bool =
  match now {
    None -> true,
    Some(now) -> match baseline { None -> true, Some(baseline) -> now != baseline },
  }

fn watch_loop(
  flags: Flags,
  options: tester::Options,
  checkout: Option<Checkout>,
  baseline: Stamps,
  cached_load: Option<program::TimedLoad>,
  embeds: List<Embed>,
) -> Int / {semantics.cached, shipped.read_pack, shipped.names, shipped.module, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, process.out[proc], process.err[proc], time.sleep_ms, fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, entropy.secret, time.now_ms, env.variable, env.working_directory, machine::MachineAccess, env.variables, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.compiled, update_costs::cost_checker.report, literals::evaluation.verdicts, literals::evaluation.statements, toolchain.bodies_dir, Derives, abort.raise, diverges, shipped.report_view_used, toolchain.reuse_dir} = {
  time.sleep_ms(poll_ms());
  let now = stamps_of(flags, checkout);
  let library_moved = changed(now.library, baseline.library);
  if changed(now.own, baseline.own) || library_moved || sources::embeds_changed(embeds) {
    print_separator(flags);
    let next = library::with_checkout_library(checkout, ||
      with_progress(flags, ||
        run_tests::run_once(flags, options, if library_moved { None } else { cached_load })));
    print_output(next.result, flags);
    watch_loop(flags, options, checkout, now, next.cached_load, next.embeds)
  } else { watch_loop(flags, options, checkout, baseline, cached_load, embeds) }
}

fn dispatch(
  parsed: Parsed,
  styled: Bool,
) -> Int / {semantics.cached, shipped.read_pack, builder.git[vcs], process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, time.sleep_ms, env.variable, shipped.version, env.working_directory, shipped.names, shipped.module, shipped.definitions, replace::edit.replacement_text[replace], machine::MachineAccess, shipped.runtime, builder.loaded[build], fs.remove[abs], fs.rename[abs], net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, entropy.secret, time.now_ms, env.variables, emit.unit, emit.compiled, toolchain.reuse_dir, update_costs::cost_checker.report, literals::evaluation.verdicts, literals::evaluation.statements, compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write, toolchain.bodies_dir, Derives, abort.raise, diverges, shipped.report_view_used} = {
  let command = parsed.path.at_or(0, "");
  let resolved = paths::resolve_all(command, parsed);
  let at = match resolved {
    Ok(rs) -> match rs.at(0) { Some(r) -> r.absolute, None -> env.working_directory() },
    Err(pwd) -> pwd,
  };
  let checkout = if paths::needs_enclosing_checkout(command) { library::enclosing_checkout(at) }
  else { None };
  match resolved {
    Err(pwd) ->
      library::with_checkout_library(checkout, || {
        let flags: Flags = args::from_parsed(parsed, styled, ".", []);
        let nowhere = sources::no_package(pwd);
        let result: CommandOutput = if command == "doc" { doc::without_project(flags, nowhere) }
        else { reported(style_of(flags), command, [nowhere], []) };
        print_output(result, flags);
        result.code
      }),
    Ok(resolved) -> {
      let display = match resolved.at(0) { Some(r) -> r.display, None -> "." };
      let flags: Flags = args::from_parsed(parsed, styled, display, resolved);
      if flags.watch { watch(flags, tester::options_from(parsed), checkout) } else {
        library::with_checkout_library(checkout, || {
          let result: CommandOutput = with_progress(flags, ||
            if flags.workspace && command != "unused" { run_each_package(command, flags, parsed) }
            else { run_command(command, flags, parsed) });
          print_output(result, flags);
          result.code
        })
      }
    },
  }
}

pub fn main() -> Unit / {shipped.read_pack, process.bound[git], process.spawn[git], process.line[proc], process.args[proc], process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, time.sleep_ms, env.variable, term.is_terminal, shipped.version, env.working_directory, shipped.names, shipped.module, shipped.runtime, toolchain.bodies_dir, shipped.binary_size, process.exit[proc], fs.remove[abs], fs.rename[abs], net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, entropy.secret, time.now_ms, env.variables, Emits, toolchain.reuse_dir, compilers.read[cc], compilers.write[cc], compilers.read[tcc], compilers.write[tcc], toolchain.read, toolchain.write, abort.raise, diverges, shipped.report_view_used, shipped.run_root, shipped.digests, machine::MachineAccess} = {
  let argv = process.args[proc]();
  let line = spec(shipped.version());
  match parse(line, argv) {
    Help(path) -> {
      process.out[proc](help(line, path));
      process.exit[proc](ok_code())
    },
    Version -> {
      process.out[proc](version_line(line));
      process.exit[proc](ok_code())
    },
    Failed(rejection) -> {
      print_error_lines([error_text(line, rejection)]);
      process.exit[proc](compile_error())
    },
    Run(parsed) -> {
      let styled = styled_output(value(parsed, "color"));
      process.exit[proc](
        units::emitting(parsed.path.at_or(0, "") == "test", ||
          update_costs::with_cost_cache(||
            literals::with_evaluation_cache(||
              vcs::fetching(||
                replace::with_replacement(||
                  build::with_read_back(|| caching(|| dispatch(parsed, styled)))))))),
      )
    },
  }
}

fn styled_output(choice: Option<String>) -> Bool / {env.variable, term.is_terminal} =
  has_colors(
    decide(
      match choice { Some("always") -> Always, Some("never") -> Never, _ -> Auto },
      term.is_terminal(Stdout),
      {
        no_color: env.variable("NO_COLOR"),
        force_color: env.variable("FORCE_COLOR"),
        clicolor_force: env.variable("CLICOLOR_FORCE"),
        term: env.variable("TERM"),
        colorterm: env.variable("COLORTERM"),
      },
    ),
  )

fn run_captured(argv: List<String>) -> FakeProcess / {abort.raise, diverges} =
  handle {
    main()
  } with {
    var io = captured(argv),
    process.args[proc]() -> args_step(io),
    process.out[proc](text) -> {
      io = out_step(io, text);
    },
    process.err[proc](text) -> {
      io = err_step(io, text);
    },
    process.exit[proc](code) resume k -> exit_step(io, code),
    env.variable(name) -> None,
    env.variables() -> [],
    term.is_terminal(stream) -> false,
    shipped.version() -> "0.0.0-test",
    env.working_directory() -> "/w",
    toolchain.reuse_dir() -> panic("`ply explain` reuses no result"),
    toolchain.bodies_dir() -> panic("`ply explain` emits nothing"),
    shipped.runtime() -> panic("`ply explain` emits nothing"),
    shipped.definitions() -> panic("`ply explain` emits nothing"),
    shipped.names() -> panic("`ply explain` emits nothing"),
    shipped.module(name) -> panic("`ply explain` emits nothing"),
    shipped.read_pack(path, offset, len) -> panic("`ply explain` loads nothing"),
    shipped.report_view_used(view, pulled) -> panic("`ply explain` loads nothing"),
    shipped.run_root(library, root, arguments, timeout_ms) ->
      panic("`ply explain` does not run code generators"),
    shipped.digests() -> panic("`ply explain` does not run code generators"),
    compilers.find[cc]() -> panic("`ply explain` compiles nothing"),
    compilers.start[cc](args) -> panic("`ply explain` compiles nothing"),
    compilers.wait[cc](job) -> panic("`ply explain` compiles nothing"),
    compilers.find[tcc]() -> panic("`ply explain` compiles nothing"),
    compilers.start[tcc](args) -> panic("`ply explain` compiles nothing"),
    compilers.wait[tcc](job) -> panic("`ply explain` compiles nothing"),
    toolchain.cache() -> panic("`ply explain` compiles nothing"),
    toolchain.exists(path) -> panic("`ply explain` compiles nothing"),
    toolchain.read_file(path) -> panic("`ply explain` compiles nothing"),
    toolchain.write_file(path, bytes) -> panic("`ply explain` compiles nothing"),
    toolchain.rename(from, to) -> panic("`ply explain` compiles nothing"),
    toolchain.append(path, bytes) -> panic("`ply explain` compiles nothing"),
    toolchain.temp_dir() -> panic("`ply explain` compiles nothing"),
    toolchain.remove_tree(dir) -> panic("`ply explain` compiles nothing"),
    toolchain.libraries() -> panic("`ply explain` compiles nothing"),
    toolchain.run(path, args) -> panic("`ply explain` does not run programs it built"),
    fs.kind[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.kind[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.resolved_kind[cwd](p) -> Dir,
    fs.resolved_kind[abs](p) -> Missing,
    fs.list_dir[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.list_dir[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.read_file[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.read_file[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.write_file[cwd](p, body) -> panic("`ply explain` does not use the file system"),
    fs.write_file[abs](p, body) -> panic("`ply explain` does not use the file system"),
    fs.write_secret[cwd](p, before, secret, encoding, after) ->
      panic("`ply explain` does not use the file system"),
    fs.write_secret[abs](p, before, secret, encoding, after) ->
      panic("`ply explain` does not use the file system"),
    fs.read_secret[cwd](p, before, encoding, after) ->
      panic("`ply explain` does not use the file system"),
    fs.read_secret[abs](p, before, encoding, after) ->
      panic("`ply explain` does not use the file system"),
    fs.create_dir[cwd](p) -> panic("`ply explain` does not use the file system"),
    fs.create_dir[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.remove[abs](p) -> panic("`ply explain` does not use the file system"),
    fs.rename[abs](from, to) -> panic("`ply explain` does not use the file system"),
