import std.option

fn version_text(version: Version) -> String =
  "{ major: " ++ version.major.to_string() ++ ", minor: " ++ version.minor.to_string()
    ++ ", patch: "
    ++ version.patch.to_string()
    ++ " }"

const consumer_name: String = "consumer_of_a_published_package"

fn consumer_manifest(manifest: Manifest) -> Bytes =
  Bytes::of_string(
    "import std.pkg (Manifest)\nfn package() -> Manifest = { name: \"" ++ consumer_name
      ++ "\", version: { major: 0, minor: 0, patch: 0 }, prefix: None, runtime: "
      ++ version_text(manifest.runtime)
      ++ ", dependencies: [{ name: \""
      ++ manifest.name
      ++ "\", prefix: "
      ++ (match manifest.prefix { None -> "None", Some(p) -> "Some(\"" ++ p ++ "\")" })
      ++ ", min: "
      ++ version_text(manifest.version)
      ++ ", source: Registry }], entry: None }\n",
  )

fn consumer_project(
  root: String,
  manifest: Manifest,
  packages: List<DependencyPackage>,
) -> Project =
  {
    files: [],
    sources: [],
    diagnostics: [],
    manifest: Some({
      path: "ply.pkg",
      module: "",
      text: consumer_manifest(manifest),
      at: { label: "abs", path: root ++ "/ply.pkg" },
    }),
    packages: packages,
    root_key: root,
  }

pub fn package_of_supplied(s: SuppliedPackage) -> DependencyPackage = {
  let root = String::of_bytes_lossy(s.root);
  {
    root: root,
    dir: root,
    manifest: s.manifest,
    files: s.modules.map(|m: Source| {
      let module = String::of_bytes_lossy(m.name);
      {
        path: module,
        module: module,
        text: m.source_text,
        at: { label: "abs", path: root ++ "/" ++ module },
      }
    }),
  }
}

pub fn consumed_modules(
  store: Option<ResolvedPath>,
  root: String,
  manifest: Manifest,
  own: DependencyPackage,
  dependencies: List<DependencyPackage>,
) -> Result<List<PublishedModule>, List<Diagnostic>> / {ProgramStore, abort.raise} = {
  let prefix = prefix_of(manifest);
  let names = own.files.map(|f: File| Bytes::of_string(prefix ++ "." ++ f.module));
  progress::silently(||
    in_program_store(
      { project: consumer_project(root, manifest, [own].concat(dependencies)), store: store },
      |w: LoadInputs|
        match view::rejections(w.own, view::summary(w.own)) {
          [] ->
            Ok(
              names.map(|name: Bytes|
                match published_module({ module: name, shipped: false, tested: false }) {
                  Some(m) -> m,
                  None -> panic("a module the consumer's check accepted has no interface"),
                }),
            ),
          rejected -> Err(rejected),
        },
    )).value
}

pub fn contracts_in(modules: List<PublishedModule>) -> List<Contract> =
  modules.fold([], |found: List<Contract>, m: PublishedModule| found.concat(m.contracts))

pub type ContractChanges = { added: List<String>, changed: List<String>, removed: List<String> }

fn key_of(c: Contract) -> Bytes = definition_key(c.reference.name, c.reference.kind)

fn by_key(cs: List<Contract>) -> Map<Bytes, Contract> =
  cs.fold(Map::new(), |accumulator: Map<Bytes, Contract>, c: Contract|
    accumulator.insert(key_of(c), c))

fn shown_name(c: Contract) -> String = String::of_bytes_lossy(c.reference.name)

pub fn contract_changes(was: List<Contract>, now: List<Contract>) -> ContractChanges = {
  let before = by_key(was);
  let after = by_key(now);
  {
    added: now.filter(|c: Contract| !before.contains(key_of(c))).map(shown_name),
    changed: now.filter(|c: Contract|
      match before.get(key_of(c)) { Some(b) -> b.hash != c.hash, None -> false }).map(
      shown_name,
    ),
    removed: was.filter(|c: Contract| !after.contains(key_of(c))).map(shown_name),
  }
}

pub type VersionBump = | Patch | Minor | Major

fn rank(b: VersionBump) -> Int = match b { Patch -> 0, Minor -> 1, Major -> 2 }

pub fn version_bump_name(b: VersionBump) -> String =
  match b { Patch -> "patch", Minor -> "minor", Major -> "major" }

pub fn required_bump(m: ContractChanges) -> VersionBump =
  if m.changed.len() > 0 || m.removed.len() > 0 { Major }
  else if m.added.len() > 0 { Minor }
  else { Patch }

pub fn bump_between(was: Version, now: Version) -> VersionBump =
  if now.major != was.major { Major } else if now.minor != was.minor { Minor } else { Patch }

fn least_version(was: Version, b: VersionBump) -> Version =
  match b {
    Major -> { major: was.major + 1, minor: 0, patch: 0 },
    Minor -> { major: was.major, minor: was.minor + 1, patch: 0 },
    Patch -> { major: was.major, minor: was.minor, patch: was.patch + 1 },
  }

pub fn previous(index: Index, now: Version) -> Option<Release> =
  index.versions.fold(None, |best: Option<Release>, release: Release|
    if release.yanked || compare(release.version, now) != Less { best } else {
      match best {
        None -> Some(release),
        Some(b) -> if compare(b.version, release.version) == Less { Some(release) } else { best },
      }
    })

fn quoted_names(names: List<String>) -> String =
  names.fold("", |accumulator: String, n: String|
    if accumulator == "" { "`" ++ n ++ "`" } else { accumulator ++ ", `" ++ n ++ "`" })

fn change_summary(m: ContractChanges, b: VersionBump) -> String =
  if b == Minor { "adds " ++ quoted_names(m.added) } else {
    match ((m.changed, m.removed)) {
      ([], removed) -> "removes " ++ quoted_names(removed),
      (changed, []) -> "changes what " ++ quoted_names(changed) ++ " promises",
      (changed, removed) ->
        "changes what " ++ quoted_names(changed) ++ " promises and removes "
          ++ quoted_names(removed),
    }
  }

pub fn bump_error(
  name: String,
  was: Version,
  now: Version,
  m: ContractChanges,
) -> Option<Diagnostic> = {
  let need = required_bump(m);
  let actual_bump = bump_between(was, now);
  if rank(actual_bump) >= rank(need) { None } else {
    Some(
      error_unplaced(
        b"E0150",
        Bytes::of_string(
          "`" ++ name ++ "` " ++ render_version(now) ++ " is a " ++ version_bump_name(actual_bump)
            ++ " of "
            ++ render_version(was)
            ++ ", and it "
            ++ change_summary(m, need),
        ),
        b"a version must say what its changes are",
        [
          b"a patch changes no definition's behavior, a minor only adds definitions, and a major may change anything",
          Bytes::of_string(
            "publish it as " ++ render_version(least_version(was, need)) ++ " or later",
          ),
        ],
      ),
    )
  }
}

pub type Options = { name: String, from: String, to: String }

pub fn options_from(parsed: Parsed) -> Options =
  {
    name: parsed.positionals.at_or(0, ""),
    from: parsed.positionals.at_or(1, ""),
    to: parsed.positionals.at_or(2, ""),
  }

fn version_of(text: String) -> Result<Version, Diagnostic> / {abort.raise} =
  match parse_version(text) {
    Some(v) -> Ok(v),
    None ->
      Err(rejected_package("`" ++ text ++ "` is not a version", [b"a version reads like `0.2.0`"])),
  }

pub fn unpublished(name: String, version: Version) -> Diagnostic =
  error_unplaced(
    unsatisfied_registry_dependency_code,
    Bytes::of_string("the registry holds no `" ++ name ++ "` " ++ render_version(version)),
    b"no such published version",
    [],
  )

pub fn published_contracts(
  base: BaseUrl,
  at: ResolvedPath,
  name: String,
  index: Index,
  version: Version,
) -> Result<List<Contract>, List<Diagnostic>> / {ProgramStore, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.create_dir[abs], fs.write_file[abs], abort.raise, diverges} =
  match release_at(index, version) {
    None -> Err([unpublished(name, version)]),
    Some(r) -> match fetch_closure(base, at.absolute, name, r) {
      Err(d) -> Err([d]),
      Ok(c) -> match consumed_modules(
          Some(at),
          at.absolute,
          c.manifest,
          package_of_supplied(c.own),
          c.dependencies.map(package_of_supplied),
        ) {
        Err(ds) -> Err(ds),
        Ok(modules) -> Ok(contracts_in(modules)),
      },
    },
  }

pub fn run(
  flags: Flags,
  opts: Options,
) -> CommandOutput / {env.variable, ProgramStore, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.create_dir[abs], fs.write_file[abs], abort.raise, diverges} = {
  let s = style_of(flags);
  if !is_dotted_path(opts.name) {
    reported(
      s,
      "contracts",
      [rejected_package("`" ++ opts.name ++ "` is not a package name", [])],
      [],
    )
  } else {
    match ((version_of(opts.from), version_of(opts.to))) {
      (Err(d), _) -> reported(s, "contracts", [d], []),
      (_, Err(d)) -> reported(s, "contracts", [d], []),
      (Ok(from), Ok(to)) -> match env.variable(url_variable()) {
        None ->
          reported(
            s,
            "contracts",
            [unset(url_variable(), "the versions are read from a registry")],
            [],
          ),
        Some(text) -> match base_of(text) {
          Err(reason) -> reported(s, "contracts", [registry_unreachable(reason, [])], []),
          Ok(base) -> match index_of(base, opts.name) {
            Err(d) -> reported(s, "contracts", [d], []),
            Ok(index) -> {
              let at = root_of(flags);
              match published_contracts(base, at, opts.name, index, from) {
                Err(ds) -> reported(s, "contracts", ds, []),
                Ok(was) -> match published_contracts(base, at, opts.name, index, to) {
                  Err(ds) -> reported(s, "contracts", ds, []),
                  Ok(now) -> contracts_output(s, opts, from, to, contract_changes(was, now)),
                },
              }
            },
          },
        },
      },
    }
  }
}

fn contracts_output(
  style: Style,
  opts: Options,
  from: Version,
  version: Version,
  m: ContractChanges,
) -> CommandOutput = {
  let need = required_bump(m);
  let covers_changes = compare(from, version) == Less
    && rank(bump_between(from, version)) >= rank(need);
  let rows = |word: String, names: List<String>|
    names.map(|n: String| indent ++ "  " ++ word ++ " " ++ n);
  {
    json: object([
      { key: "command", value: Str("contracts") },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code)) },
      { key: "name", value: Str(opts.name) },
      { key: "from", value: Str(render_version(from)) },
      { key: "to", value: Str(render_version(version)) },
      { key: "added", value: Array(m.added.map(|n: String| Str(n))) },
      { key: "changed", value: Array(m.changed.map(|n: String| Str(n))) },
      { key: "removed", value: Array(m.removed.map(|n: String| Str(n))) },
      { key: "needs", value: Str(version_bump_name(need)) },
      { key: "kept", value: Bool(covers_changes) },
    ]),
    lines: [rows("changed", m.changed), rows("removed", m.removed), rows("added  ", m.added)].fold(
      [
        indent ++ bold(style, opts.name) ++ " " ++ render_version(from) ++ " → "
          ++ render_version(version)
          ++ " · "
          ++ (if covers_changes {
            green(
              style,
              "the changes need a " ++ version_bump_name(need) ++ ", and this version is one",
            )
          } else { yellow(style, "the changes need a " ++ version_bump_name(need)) }),
      ],
      |accumulator: List<String>, more: List<String>|
        more.fold(accumulator, |a: List<String>, x: String| a.push(x)),
    ),
    errs: [],
    code: ok_code,
  }
}

fn contract_of(name: String, hash: Bytes) -> Contract =
  { reference: { name: Bytes::of_string(name), kind: HeldValue }, hash: hash }

test "`contract_changes` lists the definitions added, changed and removed between two contracts, by name and namespace" {
  let was = [
    contract_of("m.a", b"1"),
    contract_of("m.b", b"2"),
    { ..contract_of("m.T", b"3"), reference: { name: b"m.T", kind: HeldType } },
  ];
  let now = [
    contract_of("m.a", b"1"),
    contract_of("m.b", b"9"),
    contract_of("m.T", b"4"),
    contract_of("m.d", b"5"),
  ];
  assert_eq(contract_changes(was, now), {
    added: ["m.T", "m.d"],
    changed: ["m.b"],
    removed: ["m.T"],
  });
  assert_eq(contract_changes(was, was), { added: [], changed: [], removed: [] })
}

test "`bump_error` accepts a patch version bump with no API changes, a minor bump with only additions, and a major bump with any change" {
  let none = { added: [], changed: [], removed: [] };
  let adds = { ..none, added: ["m.d"] };
  let changes = { ..none, changed: ["m.b"] };
  assert_eq(
    bump_error(
      "orders",
      parse_version("0.1.0").expect("a fixture's version"),
      parse_version("0.1.1").expect("a fixture's version"),
      none,
    ),
    None,
  );
  assert_eq(
    bump_error(
      "orders",
      parse_version("0.1.0").expect("a fixture's version"),
      parse_version("0.2.0").expect("a fixture's version"),
      adds,
    ),
    None,
  );
  assert_eq(
    bump_error(
      "orders",
      parse_version("0.1.0").expect("a fixture's version"),
      parse_version("1.0.0").expect("a fixture's version"),
      changes,
    ),
    None,
  );
  match bump_error(
      "orders",
      parse_version("0.1.0").expect("a fixture's version"),
      parse_version("0.1.1").expect("a fixture's version"),
      changes,
    ) {
    None -> panic("a patch that changes a contract was taken"),
    Some(d) -> {
      assert_eq(d.code, b"E0150");
      assert(String::of_bytes_lossy(d.message).contains("changes what `m.b` promises"));
      assert(
        d.notes_text.fold(false, |hit: Bool, n: Bytes| hit || n == b"publish it as 1.0.0 or later"),
      )
    },
  };
  match bump_error(
      "orders",
      parse_version("0.1.0").expect("a fixture's version"),
      parse_version("0.1.1").expect("a fixture's version"),
      adds,
    ) {
    None -> panic("a patch that adds was taken"),
    Some(d) -> assert(String::of_bytes_lossy(d.message).contains("adds `m.d`")),
  }
}

test "`previous` returns the highest published version below the given one, skipping yanked (withdrawn) versions" {
  let r = |text: String, yanked: Bool|
    {
      version: parse_version(text).expect("a fixture's version"),
      digest: "b3:" ++ text,
      yanked: yanked,
      runtime: parse_version("0.16.0").expect("a fixture's version"),
    };
  let index = {
    name: "orders",
    versions: [r("0.1.0", false), r("0.3.0", false), r("0.2.0", true), r("0.2.1", false)],
  };
  assert_eq(
    match previous(index, parse_version("0.2.5").expect("a fixture's version")) {
      Some(x) -> render_version(x.version),
      None -> "",
    },
    "0.2.1",
  );
  assert_eq(
    match previous(index, parse_version("0.2.1").expect("a fixture's version")) {
      Some(x) -> render_version(x.version),
      None -> "",
    },
    "0.1.0",
  );
  assert_eq(previous(index, parse_version("0.1.0").expect("a fixture's version")), None)
}
