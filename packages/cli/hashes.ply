import compiler.load (Derives)
import compiler.cc (toolchain)
import compiler.unit (shipped)
import std.random (entropy)
import std.time (time)
import builder (builder)
import args (Flags, style_of)
import program (Program, ModuleView, Tables, load_program, definitions_in_order, tables_of,
                modules_of, deps_of, closure_of, hash_of, short_of, own_tests, program_view)
import report (CommandOutput, ok_code, count_of, indent, refused)
import std.term (Style, bold, dim, plain)
import compiler.front.facts (CheckedProgram)
import compiler.syntax.exprs (prelude_module)
import compiler.store.hash.forms (FunctionNamed, ItemKeyed, Subject)
import compiler.store.hash.encoding (hex)
import compiler.store.hash (no_hashes, no_refs)
import compiler.check.infer.checker (DefInfo, TestInfo)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, Array, object, string_or_null, strings)
import sources (File)
import std.string

pub fn erasure_note() -> String =
  "module names, imports and `pub` are erased by normalization: moving a definition between modules changes no hash"

fn blank_hash() -> String = "------------"

fn edges(
  tables: Tables,
  deps: Bool,
  which: Subject,
  entry: List<{ key: String, value: Json }>,
) -> List<{ key: String, value: Json }> / {abort.raise} =
  if !deps { entry } else {
    entry.push({ key: "deps", value: strings(deps_of(tables, which)) }).push({
      key: "closure",
      value: strings(closure_of(tables, which)),
    })
  }

fn definition_json(tables: Tables, deps: Bool, def_info: DefInfo) -> Json / {abort.raise} = {
  let hash = hash_of(tables, def_info.name);
  object(
    edges(tables, deps, FunctionNamed(def_info.name), [
      { key: "name", value: Str(String::of_bytes_lossy(def_info.name)) },
      { key: "module", value: Str(String::of_bytes_lossy(def_info.module)) },
      { key: "simple_name", value: Str(String::of_bytes_lossy(def_info.simple_name)) },
      { key: "hash", value: string_or_null(hash) },
      {
        key: "short",
        value: string_or_null(match hash { Some(h) -> Some(short_of(h)), None -> None }),
      },
    ]),
  )
}

fn test_hash(analysis: CheckedProgram, key: Bytes) -> Option<String> / {abort.raise} =
  match analysis.frame.hashes.tests.get(key) {
    Some(h) -> Some(String::of_bytes_lossy(hex(h))),
    None -> None,
  }

fn test_json(
  analysis: CheckedProgram,
  tables: Tables,
  deps: Bool,
  test_info: TestInfo,
) -> Json / {abort.raise} =
  object(
    edges(tables, deps, ItemKeyed(test_info.key), [
      { key: "index", value: Number(Decimal::of_int(test_info.index)) },
      { key: "key", value: Str(String::of_bytes_lossy(test_info.key)) },
      { key: "name", value: Str(String::of_bytes_lossy(test_info.name)) },
      { key: "module", value: Str(String::of_bytes_lossy(test_info.module)) },
      { key: "hash", value: string_or_null(test_hash(analysis, test_info.key)) },
    ]),
  )

fn module_json(mo: ModuleView) -> Json =
  object([{ key: "name", value: Str(mo.name) }, { key: "file", value: Str(mo.path) }])

fn edge_lines(
  style: Style,
  tables: Tables,
  which: Subject,
  lines: List<String>,
) -> List<String> / {abort.raise} = {
  let named = deps_of(tables, which);
  let reached = closure_of(tables, which);
  let with_deps = if named.len() == 0 { lines } else {
    lines.push(
      indent() ++ "                " ++ dim(style, "deps:") ++ " " ++ String::join(named, ", "),
    )
  };
  if reached.len() == 0 { with_deps } else {
    with_deps.push(
      indent() ++ "                " ++ dim(style, "closure:") ++ " "
        ++ String::join(reached, ", "),
    )
  }
}

fn quoted(name: String) -> String = "\"" ++ name ++ "\""

fn def_lines(
  style: Style,
  tables: Tables,
  deps: Bool,
  lines: List<String>,
  def_info: DefInfo,
) -> List<String> / {abort.raise} = {
  let hash = match hash_of(tables, def_info.name) { Some(h) -> short_of(h), None -> blank_hash() };
  let said = lines.push(
    indent() ++ "  " ++ dim(style, hash) ++ "  " ++ String::of_bytes_lossy(def_info.simple_name),
  );
  if deps { edge_lines(style, tables, FunctionNamed(def_info.name), said) } else { said }
}

fn test_lines(
  style: Style,
  analysis: CheckedProgram,
  tables: Tables,
  deps: Bool,
  lines: List<String>,
  test_info: TestInfo,
) -> List<String> / {abort.raise} = {
  let hash = match test_hash(analysis, test_info.key) {
    Some(h) -> short_of(h),
    None -> blank_hash(),
  };
  let said = lines.push(
    indent() ++ "  " ++ dim(style, hash) ++ "  " ++ dim(style, "test") ++ " "
      ++ quoted(String::of_bytes_lossy(test_info.name)),
  );
  if deps { edge_lines(style, tables, ItemKeyed(test_info.key), said) } else { said }
}

fn module_lines(
  style: Style,
  analysis: CheckedProgram,
  tables: Tables,
  deps: Bool,
  defs: List<DefInfo>,
  tests: List<TestInfo>,
  lines: List<String>,
  mo: ModuleView,
) -> List<String> / {abort.raise} = {
  let head = lines.push("").push(indent() ++ bold(style, mo.name) ++ " " ++ dim(style, mo.path));
  let mine = defs.filter(|def_info: DefInfo| String::of_bytes_lossy(def_info.module) == mo.name);
  let after_defs = mine.fold(head, |acc: List<String>, def_info: DefInfo|
    def_lines(style, tables, deps, acc, def_info));
  let its_tests = tests.filter(|test_info: TestInfo|
    String::of_bytes_lossy(test_info.module) == mo.name);
  its_tests.fold(after_defs, |acc: List<String>, test_info: TestInfo|
    test_lines(style, analysis, tables, deps, acc, test_info))
}

fn tally(
  style: Style,
  analysis: CheckedProgram,
  defs: Int,
  tests: Int,
) -> List<String> / {abort.raise} = {
  let modules = analysis.frame.outlines.len();
  [
    "",
    indent() ++ count_of(defs, "definition") ++ " · " ++ count_of(tests, "test") ++ " · "
      ++ count_of(modules, "module"),
    indent() ++ dim(style, erasure_note()),
  ]
}

fn hash_output(
  style: Style,
  flags: Flags,
  program: Program,
  analysis: CheckedProgram,
) -> CommandOutput / {abort.raise} = {
  let tables: Tables = tables_of(analysis.frame.hashes);
  let views = modules_of(program, analysis.frame).filter(|mo: ModuleView|
    mo.name != String::of_bytes_lossy(prelude_module()));
  let defs = definitions_in_order(analysis).filter(|def_info: DefInfo|
    def_info.module != prelude_module());
  let own = own_tests(program, analysis);
  let listed = views.fold([], |acc: List<String>, mo: ModuleView|
    module_lines(style, analysis, tables, flags.deps, defs, own, acc, mo));
  {
    json: object([
      { key: "command", value: Str("hash") },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code())) },
      { key: "root", value: Str(flags.root) },
      { key: "files", value: Array(program.files.map(|file: File| Str(file.path))) },
      { key: "modules", value: Array(views.map(module_json)) },
      { key: "module_is_hashed", value: Bool(false) },
      { key: "note", value: Str(erasure_note()) },
      {
        key: "definitions",
        value: Array(defs.map(|def_info: DefInfo| definition_json(tables, flags.deps, def_info))),
      },
      {
        key: "tests",
        value: Array(
          own.map(|test_info: TestInfo| test_json(analysis, tables, flags.deps, test_info)),
        ),
      },
      { key: "diagnostics", value: Array([]) },
    ]),
    lines: tally(style, analysis, defs.len(), own.len()).fold(
      listed,
      |acc: List<String>, l: String| acc.push(l),
    ),
    errs: [],
    code: ok_code(),
  }
}

pub fn run(
  flags: Flags,
) -> CommandOutput / {shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, Derives, abort.raise, diverges, shipped.report_reached} = {
  let loaded: Program = load_program(flags.paths, flags.verify_deps);
  match program_view(loaded) {
    None -> refused(style_of(flags), "hash", loaded.diags, loaded.places),
    Some(w) -> hash_output(style_of(flags), flags, loaded, w),
  }
}

fn a_table() -> Tables =
  {
    defs: Map::new(),
    own: Map::new(),
    specs: Map::new(),
    hashes: {
      ..no_hashes(),
      refs: {
        ..no_refs(),
        names: [b"m.one", b"m.two", b"m.one"],
        decls: [false, false, true],
        edges: [[], [0], []],
        fns: Map::of_entries([{ key: b"m.one", value: 0 }, { key: b"m.two", value: 1 }]),
        declared: Map::of_entries([{ key: b"m.one", value: [2] }]),
      },
    },
  }

test "the note names what the grouping is not" {
  assert(erasure_note().contains("changes no hash"));
  assert_eq(blank_hash(), "------------")
}

test "a name list is comma-separated, as the listing prints it" {
  assert_eq(String::join([], ", "), "");
  assert_eq(String::join(["m.one"], ", "), "m.one");
  assert_eq(String::join(["m.one", "m.two"], ", "), "m.one, m.two")
}

test "`--deps` adds the references and the closure, the definition's own and not its namesake's" {
  let line = |which: Subject| edge_lines(plain(), a_table(), which, []).map(String::trim);
  assert_eq(line(FunctionNamed(b"m.two")), ["deps: m.one", "closure: m.one, m.two"]);
  assert_eq(line(FunctionNamed(b"m.one")), ["closure: m.one"]);
  assert_eq(line(FunctionNamed(b"m.absent")), [])
}

test "a test is listed under its quoted name" { assert_eq(quoted("two is two"), "\"two is two\"") }
