import compiler.front.published (no_rows)
import compiler.front.emitter_input (Analysed, Rejected, checked_program_of)
import compiler.front.facts (CheckedProgram)
import compiler.front.rows (ModuleSpan, OutlinedType, OutlineItem, location_span)
import compiler.store.hash.forms (ItemKeyed, no_cached_hashes, reach)
import compiler.check.infer.checker (DefinitionInfo, EffectInfo, Location, TestInfo)
import compiler.check.resolve.tables (Source, qualify)
import compiler.syntax.fmt (line_end, line_start)
import program (Program, front_end, sources_of)
import std.diff
import testing.delta (Added, Change, ChangeKind, Declaration, Delta, DefinitionKey, Derived, Edited,
                      Removed, Value, classify, kind_word)
import testing.facts (Baseline, CurrentProgram, facts, moved_from)
import tester (result_cache, LastPass)
import std.bytes
import std.list
import std.option
import proof.prover_input (every)

pub type Tree = {
  whole: CheckedProgram,
  sources: List<Source>,
  places: Locations,
  definitions: Map<String, String>,
  declarations: Map<String, String>,
}

fn by_name(xs: List<{ name: Bytes, hash: Bytes }>) -> Map<String, String> / {abort.raise} =
  xs.fold(Map::new(), |acc: Map<String, String>, x: { name: Bytes, hash: Bytes }|
    acc.insert(String::of_bytes_lossy(x.name), x.hash.hex_of()))

pub fn program_of(program: Program, analysis: CheckedProgram) -> Tree / {abort.raise} =
  tree_of(sources_of(program, analysis.frame), analysis)

pub fn tree_of(sources: List<Source>, analysis: CheckedProgram) -> Tree / {abort.raise} =
  {
    whole: analysis,
    sources: sources,
    places: places_of(analysis),
    definitions: by_name(analysis.frame.hashes.definitions),
    declarations: by_name(analysis.frame.hashes.declarations),
  }

fn closed(
  t: Tree,
  key: String,
) -> { functions: List<String>, declarations: List<String> } / {abort.raise} = {
  let reached = reach(t.whole.frame.hashes, [ItemKeyed(Bytes::of_string(key))]);
  {
    functions: reached.functions.keys().map(String::of_bytes_lossy),
    declarations: reached.declarations.keys().map(String::of_bytes_lossy),
  }
}

fn hex_by_name(reached: Map<Bytes, Bytes>) -> Map<String, String> / {abort.raise} =
  reached.fold(Map::new(), |acc: Map<String, String>, name: Bytes, hash: Bytes|
    acc.insert(String::of_bytes_lossy(name), hash.hex_of()))

pub type Compared = { key: String, baseline: Baseline, now: CurrentProgram }

pub fn compared(
  pr: Tree,
  key: String,
  test_hash: Option<String>,
  baseline: LastPass,
) -> Compared / {abort.raise} =
  {
    key: key,
    baseline: {
      test: baseline.test.hex_of(),
      closure: hex_by_name(baseline.reached.functions),
      declarations: hex_by_name(baseline.reached.declarations),
    },
    now: {
      test: test_hash,
      closure: closed(pr, key),
      definitions: pr.definitions,
      declarations: pr.declarations,
    },
  }

pub fn stored_baseline_texts(
  cs: List<Compared>,
) -> Map<String, Bytes> / {result_cache.texts, abort.raise} = {
  let wanted = cs.fold(Map::new(), |m: Map<String, Bool>, c: Compared|
    moved_from(c.baseline, c.now).fold(m, |into: Map<String, Bool>, h: String|
      into.insert(h, true))).keys(
  );
  let held = result_cache.texts(wanted.map(Bytes::of_hex));
  range(0, wanted.len()).fold(Map::new(), |m: Map<String, Bytes>, i: Int|
    match held.at(i) { Some(Some(text)) -> m.insert(wanted.get(i), text), _ -> m })
}

pub fn delta_of(pr: Tree, c: Compared, then: Map<String, Bytes>) -> Delta / {abort.raise} = {
  let same = |was: Option<Bytes>, at: Option<Location>|
    match ((was, text_at(pr, at))) { (Some(a), Some(b)) -> Some(a == b), _ -> None };
  classify(
    facts(
      c.key,
      c.baseline,
      c.now,
      |k: DefinitionKey, was: String| same(then.get(was), defined_at(pr.places, k)),
      same(then.get(c.baseline.test), pr.places.tests.get(Bytes::of_string(c.key))),
    ),
  )
}

pub type Locations = {
  values: Map<Bytes, Location>,
  declarations: Map<Bytes, Location>,
  tests: Map<Bytes, Location>,
}

fn places_of(analysis: CheckedProgram) -> Locations / {abort.raise} = {
  let effects = analysis.checked.effects.fold(
    Map::new(),
    |acc: Map<Bytes, Location>, e: EffectInfo| acc.insert(e.name, e.at),
  );
  {
    values: analysis.checked.definitions.fold(
      Map::new(),
      |acc: Map<Bytes, Location>, d: DefinitionInfo| acc.insert(d.name, d.at),
    ),
    declarations: range(0, analysis.frame.outlines.len()).fold(
      effects,
      |acc: Map<Bytes, Location>, i: Int| {
        let o = analysis.frame.outlines.get(i);
        o.items.fold(acc, |into: Map<Bytes, Location>, item: OutlineItem|
          match item {
            OutlinedType(t) -> into.insert(qualify(o.name, t.name), { module: i, span: t.span }),
            _ -> into,
          })
      },
    ),
    tests: analysis.checked.tests.fold(Map::new(), |acc: Map<Bytes, Location>, t: TestInfo|
      acc.insert(t.key, t.at)),
  }
}

fn lines_at(sources: List<Source>, at: Location) -> Option<Bytes> / {abort.raise} =
  if at.module < 0 || at.span.end <= at.span.start { None } else {
    match sources.at(at.module) {
      None -> None,
      Some(s) -> if at.span.end > s.src.len() { None } else {
        Some(s.src.slice(line_start(s.src, at.span.start), line_end(s.src, at.span.end - 1)))
      },
    }
  }

fn defined_at(p: Locations, k: DefinitionKey) -> Option<Location> = {
  let name = Bytes::of_string(k.name);
  match k.ns { Value -> p.values.get(name), Declaration -> p.declarations.get(name) }
}

fn text_at(pr: Tree, at: Option<Location>) -> Option<Bytes> / {abort.raise} =
  match at { Some(l) -> lines_at(pr.sources, l), None -> None }

pub fn texts_of(
  analysis: CheckedProgram,
  sources: List<Source>,
  wanted: List<Bytes>,
) -> List<{ hash: Bytes, text: Bytes }> / {abort.raise} = {
  let asked = wanted.fold(Map::new(), |m: Map<Bytes, Bool>, h: Bytes| m.insert(h, true));
  let p = places_of(analysis);
  let h = analysis.frame.hashes;
  let placed = |at: Map<Bytes, Location>, xs: List<{ name: Bytes, hash: Bytes }>|
    xs.map(|x: { name: Bytes, hash: Bytes }| { hash: x.hash, at: at.get(x.name) });
  placed(p.values, h.definitions).concat(placed(p.declarations, h.declarations)).concat(
    h.tests.fold([], |acc: List<{ hash: Bytes, at: Option<Location> }>, key: Bytes, hash: Bytes|
      acc.push({ hash: hash, at: p.tests.get(key) })),
  ).fold(
    { seen: Map::new(), out: [] },
    |acc: { seen: Map<Bytes, Bool>, out: List<{ hash: Bytes, text: Bytes }> }, x: { hash: Bytes, at: Option<Location> }|
      if !asked.contains(x.hash) || acc.seen.contains(x.hash) { acc } else {
        match x.at {
          None -> acc,
          Some(at) -> match lines_at(sources, at) {
            None -> acc,
            Some(text) ->
              {
                seen: acc.seen.insert(x.hash, true),
                out: acc.out.push({ hash: x.hash, text: text }),
              },
          },
        }
      },
  ).out
}

pub type ChangeDiff = {
  name: String,
  change: ChangeKind,
  at: Option<ModuleSpan>,
  diff: Option<String>,
}

type ChangedItem = { change: Change, test: Bool }

pub fn change_diffs(
  pr: Tree,
  deltas: List<Delta>,
  then: Map<String, Bytes>,
) -> List<ChangeDiff> / {abort.raise} = {
  let shown = deltas.fold([], |acc: List<ChangedItem>, d: Delta| {
    let own = match d.own { Some(c) -> [{ change: c, test: true }], None -> [] };
    own.concat(
      d.changes.filter(|c: Change| c.kind != Derived).map(|c: Change| { change: c, test: false }),
    ).fold(acc, |out: List<ChangedItem>, s: ChangedItem|
      if out.contains(s) { out } else { out.push(s) })
  });
  shown.map(|s: ChangedItem| {
    let at = if s.test { pr.places.tests.get(Bytes::of_string(s.change.name)) }
    else { defined_at(pr.places, { name: s.change.name, ns: s.change.ns }) };
    {
      name: s.change.name,
      change: s.change.kind,
      at: match at { Some(l) -> Some(location_span(l)), None -> None },
      diff: diff_of(
        s.change,
        match s.change.before { Some(h) -> then.get(h), None -> None },
        text_at(pr, at),
      ),
    }
  })
}

fn diff_of(c: Change, was: Option<Bytes>, now: Option<Bytes>) -> Option<String> = {
  let ready = match c.kind {
    Added -> now != None,
    Removed -> was != None,
    _ -> was != None && now != None,
  };
  let text = |b: Option<Bytes>| match b { Some(x) -> String::of_bytes_lossy(x), None -> "" };
  if !ready { None } else {
    Some(
      diff::unified({
        old: c.name,
        new: c.name,
        hunks: diff::hunks(diff::diff_lines(text(was), text(now)), 3),
      }),
    )
  }
}

fn call_chain_source() -> String =
  "fn leaf(n: Int) -> Int = n + 1\nfn mid(n: Int) -> Int = leaf(n) + 1\nfn top(n: Int) -> Int = mid(n) + 1\ntest \"chain\" { assert_eq(top(1), 4) }\n"

fn tree_of_source(src: String) -> Tree / {abort.raise} = {
  let sources = [{ name: b"", src: Bytes::of_string(src) }];
  let loaded = front_end(
    sources,
    { sources: [], unread: [], data: [], asked: [], dependencies: [] },
    no_rows(),
    { root: b"", manifest: None, supplied: [] },
    [],
    true,
    no_cached_hashes(),
    [],
  );
  match loaded.out {
    Analysed(w) -> tree_of(sources, checked_program_of(w)),
    Rejected(_) -> panic("the fixture checks"),
  }
}

fn hash_of_test(t: Tree, key: String) -> Option<String> / {abort.raise} =
  match t.whole.frame.hashes.tests.get(Bytes::of_string(key)) {
    Some(h) -> Some(h.hex_of()),
    None -> None,
  }

fn last_passed_hashes(t: Tree, key: String) -> LastPass / {abort.raise} = {
  let h = t.whole.frame.hashes;
  let reached = reach(h, [ItemKeyed(Bytes::of_string(key))]);
  let hashed = |names: Map<Bytes, Bool>, of: List<{ name: Bytes, hash: Bytes }>| {
    let by = of.fold(Map::new(), |m: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
      m.insert(x.name, x.hash));
    names.fold(Map::new(), |acc: Map<Bytes, Bytes>, n: Bytes, _: Bool|
      match by.get(n) { Some(x) -> acc.insert(n, x), None -> acc })
  };
  {
    test: match h.tests.get(Bytes::of_string(key)) { Some(x) -> x, None -> b"" },
    reached: {
      functions: hashed(reached.functions, h.definitions),
      declarations: hashed(reached.declarations, h.declarations),
    },
  }
}

fn over(
  before: Tree,
  after: Tree,
  key: String,
  recorded: (Bytes) -> Bool,
) -> { delta: Delta, diffs: List<ChangeDiff> } / {abort.raise} = {
  let hashes = before.whole.frame.hashes;
  let all = hashes.definitions.concat(hashes.declarations).map(
    |x: { name: Bytes, hash: Bytes }| x.hash,
  ).concat(
    hashes.tests.values(),
  );
  let texts = texts_of(before.whole, before.sources, all.filter(recorded));
  let c = compared(after, key, hash_of_test(after, key), last_passed_hashes(before, key));
  let then = handle {
    stored_baseline_texts([c])
  } with {
    result_cache.texts(asked) ->
      asked.map(|h: Bytes|
        texts.fold(None, |found: Option<Bytes>, t: { hash: Bytes, text: Bytes }|
          if t.hash == h { Some(t.text) } else { found })),
  };
  let d = delta_of(after, c, then);
  { delta: d, diffs: change_diffs(after, [d], then) }
}

fn kinds(before: String, after: String, key: String) -> List<String> / {abort.raise} =
  over(tree_of_source(before), tree_of_source(after), key, every).delta.changes.map(|c: Change|
    c.name ++ " " ++ kind_word(c.kind))

fn leaf_edited() -> String =
  "fn leaf(n: Int) -> Int = n + 2\nfn mid(n: Int) -> Int = leaf(n) + 1\nfn top(n: Int) -> Int = mid(n) + 1\ntest \"chain\" { assert_eq(top(1), 4) }\n"

test "an edit to a leaf leaves what only references it derived" {
  assert_eq(kinds(call_chain_source(), leaf_edited(), "chain"), [
    "leaf edited",
    "mid derived",
    "top derived",
  ]);
  assert_eq(
    over(
      tree_of_source(call_chain_source()),
      tree_of_source(leaf_edited()),
      "chain",
      every,
    ).delta.own,
    None,
  )
}

test "a renamed definition is no change" {
  let renamed = "fn first(n: Int) -> Int = n + 1\nfn mid(n: Int) -> Int = first(n) + 1\nfn top(n: Int) -> Int = mid(n) + 1\ntest \"chain\" { assert_eq(top(1), 4) }\n";
  assert_eq(kinds(call_chain_source(), renamed, "chain"), [])
}

test "an edit to the test body is the test's own change" {
  let edited = call_chain_source().replace("top(1), 4", "top(2), 4");
  let o = over(tree_of_source(call_chain_source()), tree_of_source(edited), "chain", every);
  assert_eq(match o.delta.own { Some(c) -> c.name, None -> "none" }, "chain");
  assert_eq(o.delta.changes, [])
}

test "editing one member of a recursive pair names only that member as edited" {
  let parity = "fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\nfn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\ntest \"parity holds\" { assert(even(4)) }\n";
  let edited = parity.replace("else { even(n - 1) }", "else { even(n - 1) && true }");
  assert_eq(kinds(parity, edited, "parity holds"), ["even derived", "odd edited"])
}

test "an added definition is added, and the one that calls it edited" {
  let added = call_chain_source().replace(
    "fn mid(n: Int) -> Int = leaf(n) + 1",
    "fn bump(n: Int) -> Int = n\nfn mid(n: Int) -> Int = bump(leaf(n)) + 1",
  );
  assert_eq(kinds(call_chain_source(), added, "chain"), ["bump added", "mid edited", "top derived"])
}

fn zero_padded(i: Int) -> String = if i < 10 { "00" ++ i.to_string() } else { "0" ++ i.to_string() }

fn deep(depth: Int, leaf: String) -> String =
  range(1, depth).fold("fn f000(n: Int) -> Int = " ++ leaf ++ "\n", |acc: String, i: Int|
      acc ++ "fn f" ++ zero_padded(i) ++ "(n: Int) -> Int = f" ++ zero_padded(i - 1) ++ "(n) + 1\n")
    ++ "test \"deep\" { assert_eq(f"
    ++ zero_padded(depth - 1)
    ++ "(1), "
    ++ depth.to_string()
    ++ ") }\n"

test "a deep chain yields one edit and every caller above it derived" {
  let k = kinds(deep(64, "n + 1"), deep(64, "n + 2"), "deep");
  assert_eq(k.filter(|x: String| x.ends_with(" edited")), ["f000 edited"]);
  assert_eq(k.filter(|x: String| x.ends_with(" derived")).len(), 63);
  assert_eq(k.filter(|x: String| x.starts_with("std.")), [])
}

fn handled_source() -> String =
  "effect db {\n  read get[users](key: Int) -> Int\n}\nfn lookup(k: Int) -> Int / {db.get[users]} = db.get[users](k)\nfn twice(k: Int) -> Int / {db.get[users]} = lookup(k) + lookup(k)\nfn seeded(k: Int) -> Int = handle { twice(k) } with { db.get[users](n) -> n * 10 }\ntest \"handled\" { assert_eq(seeded(2), 40) }\n"

test "editing a handler names the definition that carries it, and not the performers" {
  assert_eq(kinds(handled_source(), handled_source().replace("n * 10", "n * 11"), "handled"), [
    "seeded edited",
  ])
}

test "editing an effect declaration makes the declaration the edit and its users derived" {
  let after = handled_source().replace(
    "}\nfn lookup",
    "  read peek[users](key: Int) -> Int\n}\nfn lookup",
  );
  let o = over(tree_of_source(handled_source()), tree_of_source(after), "handled", every);
  assert_eq(
    o.delta.changes.map(|c: Change|
      { name: c.name, declaration: c.ns == Declaration, kind: c.kind }),
    [
      { name: "db", declaration: true, kind: Edited },
      { name: "lookup", declaration: false, kind: Derived },
      { name: "seeded", declaration: false, kind: Derived },
      { name: "twice", declaration: false, kind: Derived },
    ],
  )
}

test "a rename beside an edit shows the old name removed and the new one added" {
  let after = "fn leaf(n: Int) -> Int = n + 2\nfn middle(n: Int) -> Int = leaf(n) + 1\nfn top(n: Int) -> Int = middle(n) + 1\ntest \"chain\" { assert_eq(top(1), 4) }\n";
  assert_eq(kinds(call_chain_source(), after, "chain"), [
    "leaf edited",
    "mid removed",
    "middle added",
    "top edited",
  ])
}

test "a name shared by a function and a type still names the one that moved" {
  let collide = "type Amount = Cents(Int) | Dollars(Int)\nfn Amount(n: Int) -> Int = n + 1\nfn use_it(a: Amount) -> Int = match a { Cents(c) -> c, Dollars(d) -> d * 100 }\ntest \"t\" { assert_eq(use_it(Cents(5)), 5) }\n";
  let swapped = collide.replace("Cents(Int) | Dollars(Int)", "Dollars(Int) | Cents(Int)");
  let o = over(tree_of_source(collide), tree_of_source(swapped), "t", every);
  assert_eq(
    o.delta.changes.map(|c: Change|
      { name: c.name, declaration: c.ns == Declaration, kind: c.kind }),
    [
      { name: "Amount", declaration: true, kind: Edited },
      { name: "use_it", declaration: false, kind: Derived },
    ],
  )
}

fn any_line_starts(d: ChangeDiff, sign: String) -> Bool =
  d.diff.unwrap_or("").split("\n").drop(2).any(|l: String| l.starts_with(sign))

test "an edited definition's diff is its whole lines when the test passed against its lines now" {
  let diffs = over(
    tree_of_source(call_chain_source()),
    tree_of_source(leaf_edited()),
    "chain",
    every,
  ).diffs;
  assert_eq(diffs.map(|d: ChangeDiff| d.name), ["leaf"]);
  assert_eq(diffs.map(|d: ChangeDiff| d.diff), [
    Some(
      "--- leaf\n+++ leaf\n@@ -1 +1 @@\n-fn leaf(n: Int) -> Int = n + 1\n+fn leaf(n: Int) -> Int = n + 2\n",
    ),
  ]);
  assert(diffs.all(|d: ChangeDiff| d.at != None))
}

test "an edited test shows its own diff, and an added or a removed definition shows one side" {
  let before = "fn spare() -> Int = 1\nfn leaf(n: Int) -> Int = n + spare()\ntest \"chain\" { assert_eq(leaf(1), 2) }\n";
  let after = "fn bump(n: Int) -> Int = n\nfn leaf(n: Int) -> Int = bump(n) + 1\ntest \"chain\" { assert_eq(leaf(1), 3) }\n";
  let diffs = over(tree_of_source(before), tree_of_source(after), "chain", every).diffs;
  assert_eq(diffs.map(|d: ChangeDiff| d.name), ["chain", "bump", "leaf", "spare"]);
  assert_eq(
    diffs.map(|d: ChangeDiff|
      d.diff.unwrap_or("").contains("+test \"chain\" { assert_eq(leaf(1), 3) }")),
    [true, false, false, false],
  );
  assert_eq(diffs.map(|d: ChangeDiff| any_line_starts(d, "-")), [true, false, true, true]);
  assert_eq(diffs.map(|d: ChangeDiff| any_line_starts(d, "+")), [true, true, true, false]);
  assert_eq(diffs.map(|d: ChangeDiff| d.at == None), [false, false, false, true])
}

test "a store that lacks the earlier texts calls every moved definition edited, with no diff" {
  let diffs = over(
    tree_of_source(call_chain_source()),
    tree_of_source(leaf_edited()),
    "chain",
    |_h: Bytes| false,
  ).diffs;
  assert_eq(diffs.map(|d: ChangeDiff| d.name), ["leaf", "mid", "top"]);
  assert(diffs.all(|d: ChangeDiff| d.diff == None && d.at != None))
}

test "a recorded text is the whole lines of a definition, a type, an effect and a test" {
  let src = "effect db {\n  read get(key: Int) -> Int\n}\ntype Shape = | Dot | Line(Int)\npub fn size(s: Shape) -> Int =\n  match s { Dot -> 1, Line(n) -> n }\ntest \"sized\" { assert_eq(size(Dot), 1) }\n";
  let t = tree_of_source(src);
  let hashes = t.whole.frame.hashes;
  let wanted = hashes.definitions.concat(hashes.declarations).filter(
    |x: { name: Bytes, hash: Bytes }| x.name == b"size" || x.name == b"Shape" || x.name == b"db",
  ).map(|x: { name: Bytes, hash: Bytes }| x.hash).concat(
    hashes.tests.values(),
  );
  let texts = texts_of(t.whole, t.sources, wanted).map(|x: { hash: Bytes, text: Bytes }|
    String::of_bytes_lossy(x.text)).sort(
  );
  assert_eq(texts, [
    "effect db {\n  read get(key: Int) -> Int\n}\n",
    "pub fn size(s: Shape) -> Int =\n  match s { Dot -> 1, Line(n) -> n }\n",
    "test \"sized\" { assert_eq(size(Dot), 1) }\n",
    "type Shape = | Dot | Line(Int)\n",
  ])
}
