import compiler.front.rows (Dump, EffectRow, OperationRow, DefinitionRow, TestRow, LawRow,
                            ModuleSpan, module_span_bin)
import compiler.check.types (Effect, Resource, NamedResource, SingletonResource, ResourceVariable,
                             AnyResource, Type)
import compiler.check.known (mentions_secret)
import compiler.check.resolve.tables (Diagnostic)
import compiler.syntax.type_syntax (mode_text, ReadMode, WriteMode)
import diagnostic (diagnostic_of)
import machine (RunConfiguration, NamedPath, ShutdownMode, PlatformDefault, ExitOnSignal,
                DrainOnSignal, Drain)
import std.bin
import std.bytes
import std.bytes (flag_byte, u64_le)
import std.hash (blake3)
import std.list
import std.machine as entering
import std.option
import std.string

pub type Row = {
  effect: String,
  operation: String,
  resource: Option<String>,
  triple: String,
  handler: String,
  deterministic: Bool,
  linear: Bool,
  blocking: Bool,
  secrets: Bool,
  declared_nondet: Bool,
}

pub type Listing = { rows: List<Row>, handlers: Int }

pub type Credential = { name: String, fingerprint: String, certificates: Int }

pub type Transport = {
  tls_library: String,
  version: String,
  provider: String,
  versions: List<String>,
  alpn: List<String>,
  roots: String,
  roots_version: String,
  trusted_root_count: Int,
  credentials: List<Credential>,
}

pub type Filesystem = { roots: List<NamedPath> }

pub type Observability = {
  sink: String,
  destination: String,
  level: Option<String>,
  channels: List<String>,
}

pub type Shutdown = { signals: List<String>, drain: Option<Drain> }

pub type HostSettings = {
  transport: Option<Transport>,
  filesystem: Option<Filesystem>,
  configured: RunConfiguration,
  observability: Option<Observability>,
  shutdown: Option<Shutdown>,
}

pub type DeclaredEffect = {
  name: Bytes,
  simple_name: Bytes,
  nondet: Bool,
  at: ModuleSpan,
  operations: List<DeclaredOperation>,
  host: Option<Bytes>,
}

pub type DeclaredOperation = {
  name: Bytes,
  mode: Bytes,
  resource_param: Bool,
  at: ModuleSpan,
  secrets: Bool,
  waits: Bool,
}

derive bin for DeclaredOperation
derive bin for DeclaredEffect

pub fn declared_of(d: Dump) -> List<DeclaredEffect> =
  d.effects.map(|e: EffectRow|
    {
      name: e.name,
      simple_name: e.simple_name,
      nondet: e.nondet,
      at: e.at,
      operations: e.operations.map(|o: OperationRow|
        {
          name: o.name,
          mode: o.mode,
          resource_param: o.resource_param,
          at: o.at,
          secrets: o.params.any(|t: Type| mentions_secret(t)),
          waits: e.waits.contains(o.name),
        }),
      host: e.host,
    })

type Family = { name: String, effects: List<String> }

const families: List<Family> =
  [
    { name: "machine", effects: ["machine", "hermetic_machine"] },
    { name: "shipped", effects: ["shipped"] },
    { name: "toolchain", effects: ["compilers", "toolchain", "memory"] },
  ]

pub fn allow_error(allow: List<String>, declared: List<DeclaredEffect>) -> Option<Diagnostic> =
  allow.fold(None, |found: Option<Diagnostic>, name: String|
    match found {
      Some(_) -> found,
      None -> match families.find(|f: Family| f.name == name) {
        None ->
          Some(
            diagnostic_of(
              "error",
              "E0459",
              "`" ++ name ++ "` is not a family a host provides; it provides "
                ++ String::join(families.map(|f: Family| f.name), ", "),
              [],
              [],
            ),
          ),
        Some(f) -> if f.effects.any(|e: String|
            declared.any(|d: DeclaredEffect| String::of_bytes_lossy(d.simple_name) == e)) { None }
        else {
          let named = String::join(f.effects.map(|e: String| "`" ++ e ++ "`"), " or ");
          Some(
            diagnostic_of(
              "error",
              "E0459",
              "`--allow " ++ name ++ "` was granted and the program declares no " ++ named
                ++ " effect",
              [],
              [
                "a family the program does not declare reaches nothing",
                "`" ++ name ++ "` provides the operations of " ++ named
                  ++ ", and a run is granted only what the program it runs can reach",
              ],
            ),
          )
        },
      },
    })

pub fn performed_effects(d: Dump) -> List<Effect> =
  d.definitions.fold([], |accumulator: List<Effect>, row: DefinitionRow|
    accumulator.concat(row.effects)).concat(
    d.tests.fold([], |accumulator: List<Effect>, row: TestRow| accumulator.concat(row.effects)),
  ).concat(
    d.laws.fold([], |accumulator: List<Effect>, row: LawRow| accumulator.concat(row.effects)),
  )

pub fn listing_of(effects: List<DeclaredEffect>, performed_effects: List<Effect>) -> Listing = {
  let served = effects.fold(
    { rows: Map::new(), handlers: 0 },
    |accumulator: { rows: Map<Bytes, Row>, handlers: Int }, e: DeclaredEffect|
      match e.host {
        Some(by) ->
          {
            rows: add_served_rows(
              accumulator.rows,
              e,
              String::of_bytes_lossy(by),
              performed_effects,
            ),
            handlers: accumulator.handlers + 1,
          },
        None -> accumulator,
      },
  );
  { rows: served.rows.values(), handlers: served.handlers }
}

fn add_served_rows(
  accumulator: Map<Bytes, Row>,
  e: DeclaredEffect,
  handler: String,
  performed_effects: List<Effect>,
) -> Map<Bytes, Row> =
  e.operations.fold(accumulator, |a: Map<Bytes, Row>, operation: DeclaredOperation|
    performed_labels(e, operation, performed_effects).fold(
      a,
      |b: Map<Bytes, Row>, label: Resource|
        b.insert(row_key(e, operation, label), {
          effect: String::of_bytes_lossy(e.name),
          operation: String::of_bytes_lossy(operation.name),
          resource: label_name(label),
          triple: triple_of(e, operation, label),
          handler: handler,
          deterministic: !e.nondet,
          linear: operation.mode == b"write",
          blocking: operation.waits,
          secrets: operation.secrets,
          declared_nondet: e.nondet,
        }),
    ))

fn performed_labels(
  declaration: DeclaredEffect,
  operation: DeclaredOperation,
  performed_effects: List<Effect>,
) -> List<Resource> =
  performed_effects.fold([], |accumulator: List<Resource>, a: Effect|
    if a.effect == declaration.name && !is_variable(a.resource)
        && (match a.operation {
          Some(o) -> o == operation.name,
          None -> mode_text(a.mode) == operation.mode,
        })
        && !accumulator.contains(a.resource) { accumulator.push(a.resource) }
    else { accumulator })

fn is_variable(r: Resource) -> Bool = match r { ResourceVariable(_) -> true, _ -> false }

fn triple_of(declaration: DeclaredEffect, operation: DeclaredOperation, label: Resource) -> String =
  String::of_bytes_lossy(declaration.name) ++ "." ++ String::of_bytes_lossy(operation.name)
    ++ label_text(label)

fn row_key(declaration: DeclaredEffect, operation: DeclaredOperation, label: Resource) -> Bytes =
  Bytes::concat_all([declaration.name, b"\x00", operation.name, b"\x00", label_key(label)])

fn label_name(r: Resource) -> Option<String> =
  match r { NamedResource(n) -> Some(String::of_bytes_lossy(n)), _ -> None }

fn label_text(r: Resource) -> String =
  match r {
    NamedResource(n) -> "[" ++ String::of_bytes_lossy(n) ++ "]",
    SingletonResource -> "",
    AnyResource -> "[*]",
    ResourceVariable(n) -> "[$" ++ n.to_string() ++ "]",
  }

fn label_key(r: Resource) -> Bytes =
  match r {
    NamedResource(n) -> b"0".concat(n),
    ResourceVariable(n) -> b"1".concat(Bytes::of_string(n.to_string())),
    SingletonResource -> b"2",
    AnyResource -> b"3",
  }

pub fn uses_host(listing: Listing, effects: List<Effect>) -> Bool =
  effects.any(|a: Effect|
    listing.rows.any(|row: Row|
      !row.deterministic && String::of_bytes_lossy(a.effect) == row.effect
        && (match a.operation {
          Some(o) -> String::of_bytes_lossy(o) == row.operation,
          None -> true,
        })
        && label_matches(a.resource, row.resource)))

fn label_matches(r: Resource, row: Option<String>) -> Bool =
  match ((r, row)) {
    (NamedResource(n), Some(name)) -> String::of_bytes_lossy(n) == name,
    (SingletonResource, None) -> true,
    _ -> false,
  }

pub fn host_settings_of(
  listing: Listing,
  hosting: entering::Hosting,
  configured: RunConfiguration,
  stop: Option<Drain>,
) -> HostSettings = {
  let channels = listing.rows.fold([], |accumulator: List<String>, row: Row|
    if row.effect == "std.trace.trace" {
      match row.resource {
        Some(c) -> if accumulator.contains(c) { accumulator } else { accumulator.push(c) },
        None -> accumulator,
      }
    } else { accumulator }).sort(
  );
  {
    transport: match hosting.transport {
      Some(t) -> if t.credentials.len() > 0 || t.trusted_root_count > 0 {
        Some({
          tls_library: t.tls_library,
          version: t.version,
          provider: t.provider,
          versions: t.versions,
          alpn: t.alpn,
          roots: t.roots,
          roots_version: t.roots_version,
          trusted_root_count: t.trusted_root_count,
          credentials: t.credentials.map(|c: entering::Credential|
            { name: c.name, fingerprint: c.fingerprint, certificates: c.certificates }),
        })
      } else { None },
      None -> None,
    },
    filesystem: if listing.rows.any(|row: Row|
          row.effect == "std.fs.fs" || row.effect == "std.sqlite.sqlite")
        || hosting.roots.len() > 0 {
      Some({ roots: hosting.roots.map(|n: entering::NamedPath| { name: n.name, path: n.path }) })
    } else { None },
    configured: configured,
    observability: if channels.len() == 0 { None } else {
      Some({
        sink: hosting.sink.sink,
        destination: hosting.sink.destination,
        level: hosting.sink.level,
        channels: channels,
      })
    },
    shutdown: match stop {
      Some(bounds) -> match shutdown_mode_of(listing.rows) {
        PlatformDefault -> None,
        ExitOnSignal -> Some({ signals: hosting.signals, drain: None }),
        DrainOnSignal -> Some({ signals: hosting.signals, drain: Some(bounds) }),
      },
      None -> None,
    },
  }
}

pub fn shutdown_mode_of(rows: List<Row>) -> ShutdownMode =
  if rows.any(|row: Row|
      row.effect == "std.signal.signal"
        || (row.effect == "std.net.net" && row.operation == "accept")) { DrainOnSignal }
  else if rows.any(|row: Row|
      row.effect == "std.process.process"
        && (row.operation == "start" || row.operation == "spawn")) { ExitOnSignal }
  else { PlatformDefault }

pub const no_disclosures: HostSettings =
  {
    transport: None,
    filesystem: None,
    configured: { values: [], schema: None, opened: false },
    observability: None,
    shutdown: None,
  }

pub fn sink_banner(o: Observability) -> String =
  o.sink ++ " → " ++ o.destination ++ (match o.level { Some(l) -> " · level " ++ l, None -> "" })
    ++ " · channels "
    ++ String::join(o.channels, " ")

pub type Handshakes = { completed: Int, rejected: Int, reasons: List<RejectionCount> }

pub type RejectionCount = { reason: String, count: Int }

derive bin for RejectionCount
derive bin for Handshakes

pub fn report_of<a>(
  reports: List<entering::Report>,
  name: String,
  codec: bin::BinCodec<a>,
) -> Option<a> / {abort.raise} =
  match reports.find(|r: entering::Report| r.name == name) {
    Some(r) -> match bin::decode(r.body, codec) {
      Ok(x) -> Some(x),
      Err(reason) ->
        panic("the runtime's `" ++ name ++ "` report could not be decoded: " ++ reason.message),
    },
    None -> None,
  }

pub fn handshake_lines(reports: List<entering::Report>) -> List<String> / {abort.raise} =
  match report_of(reports, "handshakes", handshakes_bin()) {
    Some(h) ->
      [
        "handshakes: " ++ h.completed.to_string() ++ " completed, " ++ h.rejected.to_string()
          ++ " rejected",
      ].concat(
        h.reasons.map(|r: RejectionCount| "  " ++ r.count.to_string() ++ " " ++ r.reason),
      ),
    None -> [],
  }

pub fn digest_of(listing: Listing, d: HostSettings) -> String / {abort.raise} =
  if d.transport == None && d.filesystem == None && d.observability == None && d.shutdown == None
      && d.configured.schema == None { short_digest(rows_digest(listing)) } else {
    short_digest(
      blake3(
        Bytes::concat_all([
          b"ply.hosts.transport.v1\x00",
          rows_digest(listing),
          match d.transport { Some(t) -> transport_digest_input(t), None -> b"" },
          match d.filesystem {
            Some(f) ->
              f.roots.fold(b"ply.hosts.filesystem.v1\x00", |accumulator: Bytes, n: NamedPath|
                Bytes::concat_all([accumulator, Bytes::of_string(n.name), b"\x00"])),
            None -> b"",
          },
          match d.configured.schema {
            Some(s) ->
              s.keys.fold(
                b"ply.hosts.configuration.v1\x00".concat(length_prefixed(s.function)),
                |accumulator: Bytes, k: { name: String, shape: String }|
                  Bytes::concat_all([
                    accumulator,
                    length_prefixed(k.name),
                    length_prefixed(k.shape),
                  ]),
              ),
            None -> b"",
          },
          match d.observability {
            Some(o) ->
              o.channels.fold(
                Bytes::concat_all([
                  b"ply.hosts.observability.v1\x00",
                  length_prefixed(o.sink),
                  length_prefixed(o.destination),
                  length_prefixed(match o.level { Some(l) -> l, None -> "" }),
                  u64_le(o.channels.len()),
                ]),
                |accumulator: Bytes, c: String| accumulator.concat(length_prefixed(c)),
              ),
            None -> b"",
          },
          match d.shutdown {
            Some(s) -> match s.drain {
              Some(drain) ->
                Bytes::concat_all([
                  s.signals.fold(b"ply.hosts.shutdown.v1\x00", |accumulator: Bytes, n: String|
                    accumulator.concat(length_prefixed(n))),
                  u64_le(drain.lead_ms),
                  u64_le(drain.drain_ms),
                ]),
              None ->
                s.signals.fold(
                  b"ply.hosts.shutdown.ends.v1\x00",
                  |accumulator: Bytes, n: String| accumulator.concat(length_prefixed(n)),
                ),
            },
            None -> b"",
          },
        ]),
      ),
    )
  }

fn rows_digest(listing: Listing) -> Bytes =
  blake3(
    listing.rows.fold(
      b"ply.hosts.1".concat(u64_le(listing.rows.len())),
      |accumulator: Bytes, row: Row|
        Bytes::concat_all([
          accumulator,
          length_prefixed(row.triple),
          length_prefixed(row.handler),
          flag_byte(row.deterministic),
          flag_byte(row.linear),
          flag_byte(row.blocking),
          flag_byte(row.secrets),
          flag_byte(row.declared_nondet),
        ]),
    ),
  )

fn transport_digest_input(t: Transport) -> Bytes =
  Bytes::concat_all([
    length_prefixed(t.tls_library),
    length_prefixed(t.version),
    length_prefixed(t.provider),
    length_prefixed(t.roots),
    length_prefixed(t.roots_version),
    u64_le(t.trusted_root_count),
    u64_le(t.credentials.len()),
  ]).concat(
    Bytes::concat_all(t.credentials.map(|c: Credential| length_prefixed(c.name))),
  )

fn length_prefixed(text: String) -> Bytes = {
  let b = Bytes::of_string(text);
  u64_le(b.len()).concat(b)
}

fn short_digest(digest: Bytes) -> String / {abort.raise} = "b3:" ++ digest.slice(0, 6).hex_of()

const hashing: DeclaredEffect = {
  let at: ModuleSpan = { module: 0, start: 0, end: 0 };
  let operation = |name: Bytes, mode: Bytes, labelled: Bool, secrets: Bool, waits: Bool|
    { name: name, mode: mode, resource_param: labelled, at: at, secrets: secrets, waits: waits };
  {
    name: b"std.password.kdf",
    simple_name: b"kdf",
    nondet: false,
    at: at,
    operations: [
      operation(b"hash", b"read", false, true, true),
      operation(b"stamp", b"write", true, false, false),
      operation(b"idle", b"read", false, false, false),
    ],
    host: Some(b"std.password.served"),
  }
}

const hashed: List<Effect> =
  [
    {
      effect: b"std.password.kdf",
      resource: SingletonResource,
      mode: ReadMode,
      operation: Some(b"hash"),
    },
    {
      effect: b"std.password.kdf",
      resource: NamedResource(b"log"),
      mode: WriteMode,
      operation: None,
    },
  ]

test "a host handler's listing has one row per operation of the effect it handles, for each effect label the program uses" {
  let l = listing_of([hashing], hashed);
  assert_eq(l.handlers, 1);
  assert_eq(
    l.rows.map(|r: Row|
      (r.triple, r.handler, r.deterministic, r.linear, r.blocking, r.secrets, r.declared_nondet)),
    [
      ("std.password.kdf.hash", "std.password.served", true, false, true, true, false),
      ("std.password.kdf.stamp[log]", "std.password.served", true, true, false, false, false),
    ],
  );
  assert(!uses_host(l, hashed), Some("a deterministic handler reaches no host"))
}

fn bound_row(named: String, operation: String) -> Row =
  {
    effect: named,
    operation: operation,
    resource: None,
    triple: named ++ "." ++ operation,
    handler: "",
    deterministic: false,
    linear: false,
    blocking: false,
    secrets: false,
    declared_nondet: true,
  }

test "`shutdown_mode_of` picks finish-in-flight-work-on-signal for programs that wait for stop or accept connections, exit-at-once for ones that start a process, else the platform default" {
  let start = bound_row("std.process.process", "start");
  let spawn = bound_row("std.process.process", "spawn");
  let accept = bound_row("std.net.net", "accept");
  let stopping_row = bound_row("std.signal.signal", "stopping");
  let prints = bound_row("std.process.process", "out");
  assert_eq(shutdown_mode_of([]), PlatformDefault);
  assert_eq(shutdown_mode_of([prints, bound_row("std.net.net", "connect")]), PlatformDefault);
  assert_eq(shutdown_mode_of([prints, start]), ExitOnSignal);
  assert_eq(shutdown_mode_of([spawn]), ExitOnSignal);
  assert_eq(shutdown_mode_of([start, accept]), DrainOnSignal);
  assert_eq(shutdown_mode_of([stopping_row, spawn]), DrainOnSignal)
}
