import std.list
import std.process (process)
import report (indent, count_of)

pub effect progress {
  write computed(query: Bytes) -> Unit
}

const first_line_at: Int = 128

type Tally = { facts: Int, groups: Int, modules: Int, code: Int, next_line: Int }

const no_tally: Tally = { facts: 0, groups: 0, modules: 0, code: 0, next_line: first_line_at }

fn counted(t: Tally, query: Bytes) -> Tally =
  {
    facts: t.facts + 1,
    groups: if query == b"group" { t.groups + 1 } else { t.groups },
    modules: if query == b"owners" { t.modules + 1 } else { t.modules },
    code: if query == b"code" { t.code + 1 } else { t.code },
    next_line: t.next_line,
  }

fn tally_line(what: String, t: Tally) -> String / {abort.raise} =
  indent ++ what ++ ": " ++ count_of(t.facts, "fact") ++ " computed ("
    ++ count_of(t.modules, "module")
    ++ " read, "
    ++ count_of(t.groups, "group")
    ++ " checked, "
    ++ count_of(t.code, "unit")
    ++ " lowered)"

pub fn reporting<a | e>(
  what: String,
  work: () -> a / {progress.write | e},
) -> a / {process.err[proc], abort.raise | e} =
  handle {
    work()
  } with {
    var tally: Tally = no_tally,
    progress.computed(query) -> {
      tally = counted(tally, query);
      if tally.facts == tally.next_line {
        process.err[proc](tally_line(what, tally));
        tally = { ..tally, next_line: tally.next_line * 2 };
      }
    },
  }

pub fn silently<a | e>(work: () -> a / {progress.write | e}) -> a / e =
  handle { work() } with { progress.computed(_) -> () }
