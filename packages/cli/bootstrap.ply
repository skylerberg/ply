//! `ply bootstrap` — a native `ply` built from a checkout by this one. The runtime's library is the
//! one cargo built of the checkout's Rust, which describes itself; the builder is a program that
//! enters the checkout's compiler, built here against that description over the checkout's shipped
//! modules, which this `ply`'s packed answers answer for wherever they did not move; the builder
//! builds the checkout's `ply` and holds its constants on that runtime; that is linked into a native
//! `ply`, which answers the shipped modules; and its pack carries the shipped modules, those answers
//! and what its front end answered of the definition it enters. The builder and the answers are
//! each kept in the toolchain's cache under what decides them, so a bootstrap of what an earlier one
//! built makes neither again, and one whose `ply` answers as an earlier one's did answers nothing.
//! Only the shipped modules the builder pulls are built by this `ply`'s compiler, so only they
//! cannot use a language rule the checkout introduces.

import compiler.load (Derives)
import args (Flags, no_flags, style_of)
import env (env)
import program (Timed, front_of, timed_uncached_over, program_view)
import queried
import report (Answer, ok_code, compile_error, refused, reported)
import sources (Project)
import library
import library (Shipping)
import compiler.cc
import compiler.cc (Toolchain, compilers, toolchain)
import compiler.front.published (linked_of)
import compiler.front.interface (sized)
import compiler.build (built_roots)
import compiler.emit.keys (Named)
import compiler.native
import compiler.native (Packed)
import compiler.store.packs
import compiler.syntax.parsing (no_module, dummy_span)
import compiler.check.resolve.tables (Diag, error_at)
import compiler.unit (shipped, answers_store, emitted, emitter_identity, held, identity_of)
import compiler.emit.abi (Runtime, runtime_of)
import compiler.store.kept (Record, kept_records, with_kept)
import std.bin
import std.bytes
import std.fs
import std.fs (fs)
import std.hash (blake3)
import std.json (Json, Str, Bool, object)
import std.list
import std.string
import std.process (process)
import std.random (entropy)
import std.time (time)
import std.path (below_root, parent)
import std.pkg (ToolchainParts, library_of)

/// What a bootstrap is told: the checkout and where its `ply.work` says its parts are, the profile
/// it compiles under, the runtime's library and where the `ply` it builds goes.
pub type Options = {
  root: String,
  toolchain: ToolchainParts,
  profile: String,
  library: String,
  out: String,
}

/// `path` made absolute against the working directory `pwd`.
fn absolute(pwd: String, path: String) -> String =
  if path.starts_with("/") { path } else if path == "." { pwd } else { pwd ++ "/" ++ path }

/// The checkout the line names, absolute.
fn checkout_of(flags: Flags) -> String / {env.pwd[sys]} =
  match flags.paths.at(0) { Some(r) -> r.absolute, None -> env.pwd[sys]() }

fn options_of(flags: Flags, t: ToolchainParts) -> Options / {env.pwd[sys]} = {
  let pwd = env.pwd[sys]();
  let root = checkout_of(flags);
  let profile = match flags.profile { Some("release") -> "release", _ -> "development" };
  let target = root ++ "/target/" ++ (if profile == "release" { "release" } else { "debug" });
  {
    root: root,
    toolchain: t,
    profile: profile,
    library: match flags.runtime {
      Some(l) -> absolute(pwd, l),
      None -> target ++ "/" ++ library_of(t),
    },
    out: match flags.out { Some(o) -> absolute(pwd, o), None -> target ++ "/ply" },
  }
}

fn nowhere(message: String) -> Diag =
  error_at(b"E0502", no_module(), dummy_span(), Bytes::of_string(message), b"", [])

/// What a native program's objects compile at under `profile`.
fn level_of(profile: String) -> String = if profile == "release" { "-O2" } else { "-O0" }

// --- Building -------------------------------------------------------------------------

/// What a bootstrap's builds reach beside the loads they make: the compilers and their cache, the
/// checkout and where the `ply` it builds goes, below the filesystem's root.
pub effect set Bootstraps = {compilers.write[cc], toolchain.read, toolchain.write, fs.read[abs], fs.write[abs], shipped.front, time.elapsed_ms}

fn failed<a>(why: String) -> Result<a, List<Diag>> = Err([nowhere(why)])

/// The toolchain native programs compile with under `profile`: `cc`, which links them too.
fn toolchain_for(profile: String) -> Result<Toolchain, List<Diag>> / {compilers.read[cc]} =
  match compilers.found[cc]() {
    None -> failed("no `cc` is installed to compile C with"),
    Some(compiler) -> Ok(cc::toolchain_of(compiler, level_of(profile), profile != "release")),
  }

/// The runtime the library at `library` is, as a program linked with it and nothing else says.
fn described(
  t: Toolchain,
  library: String,
  work: String,
) -> Result<Runtime, List<Diag>> / {compilers.write[cc], toolchain.read, toolchain.write, abort.raise} =
  match cc::executable[cc](
      t,
      native::describer_c(),
      [],
      [library].concat(toolchain.libraries()),
      work,
    ) {
    Err(why) -> failed("the runtime's library at `" ++ library ++ "` does not link: " ++ why),
    Ok(exe) -> {
      let ran = toolchain.ran(relative(exe), []);
      if ran.code != 0 { failed("the runtime's library does not describe itself") } else {
        match runtime_of(ran.out) {
          Ok(r) -> Ok(r),
          Err(why) ->
            failed(
              "the runtime's library describes itself in a form this `ply` does not read: "
                ++ String::of_bytes_lossy(why),
            ),
        }
      }
    },
  }

/// `path`, an absolute one below the toolchain's cache, as the cache names it.
fn relative(path: String) -> String / {toolchain.read, abort.raise} = {
  let cache = toolchain.cache();
  if path.starts_with(cache ++ "/") { path.slice(cache.len() + 1, path.len()) } else { path }
}

/// `objects` and the native `main` linked with the runtime's library into an executable: its path
/// below the cache.
fn linked(
  t: Toolchain,
  objects: Result<List<String>, String>,
  library: String,
  work: String,
) -> Result<String, List<Diag>> / {compilers.write[cc], toolchain.read, toolchain.write, abort.raise} =
  match objects {
    Err(why) -> failed(why),
    Ok(objects) -> match cc::executable[cc](
        t,
        native::main_c(),
        objects,
        [library].concat(toolchain.libraries()),
        work,
      ) {
      Err(why) -> failed(why),
      Ok(exe) -> Ok(exe),
    },
  }

/// The executable at `exe` with `pack` after it.
fn packed_after(
  exe: String,
  pack: Bytes,
) -> Result<String, List<Diag>> / {toolchain.read, toolchain.write, abort.raise} =
  if toolchain.appended(relative(exe), pack) { Ok(exe) }
  else { failed("the pack could not be written after `" ++ exe ++ "`") }

/// What every native `ply` and builder carries: the shipped modules as a pack keeps them, and the
/// program's own front end.
fn packed_with(files: List<Shipping>, front: Bytes, more: List<Packed>) -> Bytes =
  native::pack(
    files.map(|f: Shipping| { path: f.path, bytes: f.bytes }).push({
      path: native::front_path(),
      bytes: front,
    }).concat(
      more,
    ),
  )

// --- What a bootstrap keeps ----------------------------------------------------------------

/// What names the shipped modules `files` hold, whatever order they were read in.
fn shipped_key(files: List<Shipping>) -> Bytes =
  blake3(
    Bytes::concat_all(
      files.fold(Map::new(), |acc: Map<String, Bytes>, f: Shipping|
        acc.insert(f.name, sized(Bytes::of_string(f.path)).concat(blake3(f.bytes)))).fold(
        [b"ply shipped modules 1\0"],
        |acc: List<Bytes>, name: String, held: Bytes|
          acc.push(sized(Bytes::of_string(name))).push(held),
      ),
    ),
  )

/// What an executable linked here is a function of besides its objects' C: the compiler and what
/// every compile and link passes it, the `main` it is entered through, and the runtime's library,
/// `library` its digest and `libraries` what is linked after it.
fn linking_key(t: Toolchain, library: Bytes, libraries: List<String>) -> Bytes =
  blake3(
    Bytes::concat_all([
      b"ply native link 1\0",
      sized(t.identity),
      sized(
        Bytes::of_string(String::join(cc::compile_flags(t).concat(native::native_flags()), " ")),
      ),
      sized(native::main_c()),
      sized(library),
      sized(Bytes::of_string(String::join(libraries, " "))),
    ]),
  )

/// How many bytes of a file one read takes: under what a read may answer at once.
fn read_range() -> Int = 16777216

/// Each `step` bytes of the file at `path` in turn, as `each` makes of them: none where it does not
/// read.
fn ranges_of<a>(
  path: String,
  step: Int,
  each: (Bytes) -> a,
) -> Option<List<a>> / {fs.read[abs], abort.raise} =
  match fs.file_size[abs](path) {
    None -> None,
    Some(size) ->
      range(0, (size + step - 1) / step).fold(Some([]), |held: Option<List<a>>, i: Int|
        match held {
          None -> None,
          Some(made) -> match fs.read_at[abs](path, i * step, step) {
            Some(bytes) -> Some(made.push(each(bytes))),
            None -> None,
          },
        }),
  }

/// What the file at `path` holds, as the digest of the digests of each `step` bytes of it in turn,
/// so a file larger than one read answers is still named by its bytes: none where it does not read.
fn ranged_digest(path: String, step: Int) -> Option<Bytes> / {fs.read[abs], abort.raise} =
  match ranges_of(path, step, blake3) {
    Some(digests) -> Some(blake3(Bytes::concat_all(digests))),
    None -> None,
  }

/// What the file at `path` holds, read `step` bytes at a time: none where it does not read.
fn ranged_read(path: String, step: Int) -> Option<Bytes> / {fs.read[abs], abort.raise} =
  match ranges_of(path, step, |b: Bytes| b) {
    Some(parts) -> Some(Bytes::concat_all(parts)),
    None -> None,
  }

/// The definition a builder is a function of besides what it is made from: the one that builds it,
/// whose hash covers the front end, the emitter and how the builder's C is linked and packed. So a
/// `ply` whose own differs builds its builder itself, and a bootstrap it could not run fails here
/// and not in the checkouts a release of it would be handed.
fn builder_roots() -> List<Bytes> = [b"bootstrap.builder_built"]

/// Where the cache keeps the builder of the shipped modules `shipped` names, linked as `linking`
/// names and built by the definitions `building` identifies.
fn builder_kept(shipped: Bytes, linking: Bytes, building: Bytes) -> String / {abort.raise} = {
  let key = blake3(
    Bytes::concat_all([
      b"ply builder 1\0",
      sized(builder_text()),
      sized(Bytes::of_string(builder_entry())),
      shipped,
      linking,
      sized(building),
    ]),
  );
  key.hex_of() ++ ".builder"
}

/// The definition what a `ply` answered is kept as a function of on this side: the one that gathers
/// it, whose hash covers what is read of the store the `ply` wrote and how it is laid into a pack.
fn answers_roots() -> List<Bytes> = [b"bootstrap.answers"]

/// Where the cache keeps what a `ply` answers of the shipped modules `shipped` names, linked as
/// `linking` names: `answering` is what the `ply` says names how it answers them, and `gathering`
/// identifies the definitions that gather what it answered. The `ply`'s own front end is no part of
/// it, so one that differs only there takes what the other answered.
fn answers_kept(
  shipped: Bytes,
  linking: Bytes,
  answering: Bytes,
  gathering: Bytes,
) -> String / {abort.raise} = {
  let key = blake3(
    Bytes::concat_all([b"ply answers 1\0", shipped, linking, sized(answering), sized(gathering)]),
  );
  key.hex_of() ++ ".answers"
}

/// One file of what a `ply` answered, as the cache keeps it.
type KeptFile = { path: String, bytes: Bytes }

derive bin for KeptFile

/// `answered` as the cache keeps it.
fn kept_of(answered: List<Packed>) -> Bytes / {abort.raise} =
  bin::encode(
    answered.map(|f: Packed| { path: f.path, bytes: f.bytes }),
    bin::list_bin(kept_file_bin()),
  )

/// What `kept_of` kept: nothing for bytes that are not the whole of it.
fn unkept(bytes: Bytes) -> Option<List<Packed>> / {abort.raise} =
  match bin::decode(bytes, bin::list_bin(kept_file_bin())) {
    Ok(files) -> Some(files.map(|f: KeptFile| { path: f.path, bytes: f.bytes })),
    Err(_) -> None,
  }

// --- The builder ------------------------------------------------------------------------

/// The builder's own module: it enters the checkout's compiler, and the rest of the builder is the
/// shipped modules that reaches.
fn builder_text() -> Bytes =
  b"import compiler.build\nimport compiler.build (Builds)\nimport std.process (process)\n\npub fn main() -> Unit / {Builds, process.args[proc], process.exit[proc]} = build::main()\n"

fn builder_entry() -> String = "builder.main"

/// The builder as a load takes it: its one module, read from no directory.
fn builder_project() -> Project = {
  let text = builder_text();
  {
    files: [
      {
        path: "builder.ply",
        module: "builder",
        text: text,
        at: { label: "abs", path: "builder.ply" },
      },
    ],
    sources: [{ name: b"builder", src: text }],
    diags: [],
    manifest: None,
    packages: [],
    root_key: "",
    absent: [],
  }
}

/// A builder below the cache, and whether it was taken as an earlier bootstrap kept it.
type Builder = { path: String, taken: Bool }

/// The builder of the checkout's shipped modules on `runtime`, at `kept` below the cache: the one an
/// earlier bootstrap kept there, or else built here and kept. A shipped module that did not move
/// since this `ply` was built is answered by what this `ply` carries.
fn builder_built(
  options: Options,
  t: Toolchain,
  runtime: Runtime,
  files: List<Shipping>,
  kept: String,
  work: String,
) -> Result<Builder, List<Diag>> / {Bootstraps, shipped.definitions, env.bodies[sys], shipped.answer, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], entropy.next, time.now_ms, shipped.reached, Derives, abort.raise} = {
  let path = toolchain.cache() ++ "/" ++ kept;
  if toolchain.holds(kept) { Ok({ path: path, taken: true }) } else {
    let started = time.elapsed_ms();
    let t_load: Timed = library::over_shipping(files, ||
      timed_uncached_over([], builder_project(), started));
    match program_view(t_load.program) {
      None -> Err(t_load.program.diags),
      Some(w) -> {
        let front = front_of(t_load, w);
        let entry = Bytes::of_string(builder_entry());
        let offered = built_roots(front, w.frame.hashes, entry);
        let store = answers_store(
          below_root(env.bodies[sys]()),
          runtime,
          emitter_identity(shipped.definitions()),
        );
        let emission = with_kept[abs, ans](store, ||
          emitted(
            runtime,
            front.dump,
            front.files.map(|f: { path: String, name: String, text: Bytes }| f.text),
            front.inputs,
            offered,
            |k: Bytes| kept_records.get[ans](k),
            |rs: List<Record>| kept_records.put[ans](rs),
            entered: Some([Named(entry)]),
          ));
        match ((
            held(front.dump, offered, emission),
            linked_of(front.dump, entry, front.files.len()),
          )) {
          (Err(diags), _) -> Err(diags),
          (_, None) -> failed("the builder defines no `" ++ builder_entry() ++ "` to enter"),
          (Ok(c), Some(carried)) -> match linked(
              t,
              cc::objects[cc](t, cc::split(c), native::native_flags(), work),
              options.library,
              work,
            ) {
            Err(diags) -> Err(diags),
            Ok(exe) -> match packed_after(exe, packed_with(files, shipped.front(carried), [])) {
              Err(diags) -> Err(diags),
              Ok(whole) -> if toolchain.moved(relative(whole), kept) {
                Ok({ path: path, taken: false })
              } else { failed("the builder could not be kept in the toolchain's cache") },
            },
          },
        }
      },
    }
  }
}

/// The checkout's `ply` built by `builder`: its front end and the sources of its C, which the cache
/// keeps. The builder tells its steps as it takes them where `phases` asks it to. It checks through
/// the store `ply std --answers` answers the shipped modules through, so each shipped module `ply`
/// imports is answered once a bootstrap.
fn ply_built(
  options: Options,
  builder: String,
  work: String,
  phases: Bool,
) -> Result<{ front: Bytes, sources: List<cc::Source> }, List<Diag>> / {toolchain.read, toolchain.write, fs.read[abs], fs.write[abs], env.reused[sys], abort.raise} = {
  let cache = toolchain.cache();
  let front = cache ++ "/" ++ work ++ "/ply.front";
  let manifest = cache ++ "/" ++ work ++ "/ply.sources";
  let memo = queried::shipped_work(env.reused[sys]());
  if fs.create_dir[abs](below_root(memo)) {
    fs.write_file[abs](below_root(memo) ++ "/.used", b"");
    ()
  };
  let ran = toolchain.ran(relative(builder), [
    options.root ++ "/" ++ options.toolchain.cli,
    options.toolchain.entry,
    front,
    manifest,
    memo,
    "kept",
    if phases { "phases" } else { "quiet" },
  ]);
  if ran.code != 0 { failed("the builder did not build `ply`") } else {
    match ((fs.read_file[abs](below_root(front)), fs.read_file[abs](below_root(manifest)))) {
      (Some(f), Some(m)) -> match cc::manifested(m) {
        Some(sources) -> Ok({ front: f, sources: sources }),
        None -> failed("the builder's manifest of `ply`'s C does not read"),
      },
      _ -> failed("what the builder built could not be read back"),
    }
  }
}

/// What `ply` answers of the shipped modules, as its pack carries it: the pack its `std --answers`
/// wrote below `work`, a file of frames and its index, as it wrote them.
fn answers(
  ply: String,
  work: String,
) -> Result<List<Packed>, List<Diag>> / {toolchain.read, toolchain.write, fs.read[abs], abort.raise} = {
  let dir = toolchain.cache() ++ "/" ++ work ++ "/answers";
  let ran = toolchain.ran(relative(ply), ["std", "--answers", dir]);
  let at = |name: String| below_root(dir ++ "/pack/" ++ name);
  if ran.code != 0 { failed("the new `ply` did not answer the shipped modules") } else {
    match ((
        ranged_read(at(packs::store_file()), read_range()),
        fs.read_file[abs](at(packs::index_file())),
      )) {
      (Some(store), Some(index)) ->
        Ok([
          { path: "answers/" ++ packs::store_file(), bytes: store },
          { path: "answers/" ++ packs::index_file(), bytes: index },
        ]),
      _ -> failed("the new `ply` wrote no pack of what the shipped modules answer"),
    }
  }
}

/// What the `ply` at `exe` answers of the shipped modules, as its pack carries it: what an earlier
/// bootstrap kept of a `ply` that answers them as this one does, or else what this one answers,
/// which is kept. `taken` is whether it was kept. A copy that carries only its front end says how
/// it answers and answers for the one that carries the answers too; one that cannot say answers
/// and nothing is kept.
fn answered(
  exe: String,
  files: List<Shipping>,
  front: Bytes,
  keys: Keys,
  work: String,
) -> Result<{ answered: List<Packed>, taken: Bool }, List<Diag>> / {toolchain.read, toolchain.write, fs.read[abs], fs.write[abs], shipped.definitions, abort.raise} = {
  let answering = exe ++ "-answering";
  if !fs.copy[abs](below_root(exe), below_root(answering)) {
    failed("the new `ply` could not be copied to answer with")
  } else {
    match packed_after(answering, packed_with(files, front, [])) {
      Err(diags) -> Err(diags),
      Ok(_) -> {
        let asked = toolchain.ran(relative(answering), ["std", "--answering"]);
        let kept = if asked.code != 0 { None } else {
          Some(
            answers_kept(
              keys.shipped,
              keys.linking,
              Bytes::of_string(String::of_bytes_lossy(asked.out).trim()),
              identity_of(shipped.definitions(), answers_roots()),
            ),
          )
        };
        let had = match kept {
          None -> None,
          Some(at) -> if !toolchain.holds(at) { None }
          else { match toolchain.held(at) { Some(bytes) -> unkept(bytes), None -> None } },
        };
        match had {
          Some(a) -> Ok({ answered: a, taken: true }),
          None -> match answers(answering, work) {
            Err(diags) -> Err(diags),
            Ok(files) -> match kept {
              None -> Ok({ answered: files, taken: false }),
              Some(at) -> if toolchain.written(at, kept_of(files)) {
                Ok({ answered: files, taken: false })
              } else {
                failed("what the new `ply` answered could not be kept in the toolchain's cache")
              },
            },
          },
        }
      },
    }
  }
}

/// A step of a bootstrap and the milliseconds it took.
type Took = { step: String, ms: Int }

fn took(steps: List<Took>, step: String, since: Int) -> List<Took> / {time.elapsed_ms} =
  steps.push({ step: step, ms: time.elapsed_ms() - since })

/// What a bootstrap that built `ply` made: what each step took.
type Built = { steps: List<Took> }

fn wrote(options: Options, built: Built, phases: Bool) -> Answer =
  {
    json: object([
      { key: "command", value: Str("bootstrap") },
      { key: "ok", value: Bool(true) },
      { key: "wrote", value: Str(options.out) },
    ]),
    lines: [
      "built `ply` from " ++ options.root ++ " under " ++ options.profile,
      "wrote " ++ options.out,
    ].concat(if !phases { [] }
    else { built.steps.map(|t: Took| "phases: " ++ t.step ++ " " ++ t.ms.to_string() ++ "ms") }),
    errs: [],
    code: ok_code(),
  }

/// The `ply` at `exe` written to `out` with its pack, every directory above `out` made: by a copy
/// beside `out` and a rename, so a process running the one there keeps its file.
fn installed(
  exe: String,
  out: String,
  pack: Bytes,
) -> Result<Unit, List<Diag>> / {fs.write[abs], entropy.next, abort.raise} = {
  let tmp = out ++ "." ++ entropy.next().to_string() ++ ".tmp";
  if fs.create_dir[abs](below_root(parent(out))) && fs.copy[abs](below_root(exe), below_root(tmp))
      && fs.append[abs](below_root(tmp), pack) != None
      && fs.rename[abs](below_root(tmp), below_root(out)) { Ok(()) } else {
    let _ = fs.remove[abs](below_root(tmp));
    failed("the new `ply` could not be written to `" ++ out ++ "`")
  }
}

/// What names what every step of one bootstrap is made from: its shipped modules, and how it links.
type Keys = { shipped: Bytes, linking: Bytes }

/// The checkout's `ply` built below `work`, each step timed into `steps`.
fn bootstrapped(
  options: Options,
  t: Toolchain,
  files: List<Shipping>,
  work: String,
  phases: Bool,
) -> Result<Built, List<Diag>> / {Bootstraps, shipped.definitions, env.bodies[sys], env.reused[sys], shipped.answer, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], entropy.next, time.now_ms, shipped.reached, Derives, abort.raise} = {
  let started = time.elapsed_ms();
  match described(t, options.library, work) {
    Err(diags) -> Err(diags),
    Ok(runtime) -> match ranged_digest(below_root(options.library), read_range()) {
      None -> failed("the runtime's library at `" ++ options.library ++ "` could not be read"),
      Some(library) -> {
        let keys = {
          shipped: shipped_key(files),
          linking: linking_key(t, library, toolchain.libraries()),
        };
        let steps = took([], "described the runtime", started);
        let at = time.elapsed_ms();
        match builder_built(
            options,
            t,
            runtime,
            files,
            builder_kept(
              keys.shipped,
              keys.linking,
              identity_of(shipped.definitions(), builder_roots()),
            ),
            work,
          ) {
          Err(diags) -> Err(diags),
          Ok(builder) -> {
            let steps = took(
              steps,
              if builder.taken { "took the kept builder" } else { "built the builder" },
              at,
            );
            let at = time.elapsed_ms();
            match ply_built(options, builder.path, work, phases) {
              Err(diags) -> Err(diags),
              Ok(made) -> {
                let steps = took(steps, "built `ply`", at);
                let at = time.elapsed_ms();
                match linked(
                    t,
                    cc::objects_kept[cc](t, made.sources, native::native_flags(), work),
                    options.library,
                    work,
                  ) {
                  Err(diags) -> Err(diags),
                  Ok(exe) ->
                    finished(
                      options,
                      files,
                      keys,
                      made,
                      exe,
                      work,
                      took(steps, "compiled and linked `ply`", at),
                    ),
                }
              },
            }
          },
        }
      },
    },
  }
}

/// The `ply` linked at `exe` written where it goes with its pack, the last steps timed after `steps`.
fn finished(
  options: Options,
  files: List<Shipping>,
  keys: Keys,
  made: { front: Bytes, sources: List<cc::Source> },
  exe: String,
  work: String,
  steps: List<Took>,
) -> Result<Built, List<Diag>> / {toolchain.read, toolchain.write, fs.read[abs], fs.write[abs], shipped.definitions, time.elapsed_ms, entropy.next, abort.raise} = {
  let at = time.elapsed_ms();
  match answered(exe, files, made.front, keys, work) {
    Err(diags) -> Err(diags),
    Ok(a) -> {
      let steps = took(
        steps,
        if a.taken { "took the kept answers" } else { "answered the shipped modules" },
        at,
      );
      let at = time.elapsed_ms();
      match installed(exe, options.out, packed_with(files, made.front, a.answered)) {
        Err(diags) -> Err(diags),
        Ok(_) -> Ok({ steps: took(steps, "packed and wrote `ply`", at) }),
      }
    },
  }
}

pub fn run(
  flags: Flags,
) -> Answer / {Bootstraps, compilers.read[cc], env.pwd[sys], env.var[sys], shipped.definitions, env.bodies[sys], env.reused[sys], shipped.answer, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], entropy.next, time.now_ms, shipped.reached, Derives, abort.raise} = {
  let s = style_of(flags);
  match library::toolchain(checkout_of(flags)) {
    Err(unread) -> reported(s, "bootstrap", unread.diags, unread.places),
    Ok(parts) -> {
      let options = options_of(flags, parts);
      let files = library::shipping({ root: options.root, parts: parts });
      let phases = env.var[sys]("PLY_C_PHASES") != None;
      let built = match ((toolchain_for(options.profile), toolchain.scratch())) {
        (Err(diags), _) -> Err(diags),
        (_, None) -> failed("the toolchain's cache has no room to build in"),
        (Ok(t), Some(work)) -> {
          let result = bootstrapped(options, t, files, work, phases);
          toolchain.cleared(work);
          result
        },
      };
      match built {
        Err(diags) -> reported(s, "bootstrap", diags, []),
        Ok(b) -> wrote(options, b, phases),
      }
    },
  }
}

fn placed_parts() -> ToolchainParts =
  {
    std: "lib/std",
    std_tests: "tests/std",
    compiler: "lib/compiler",
    cli: "cli",
    entry: "ply.main",
    cli_tests: "tests/cli",
    runtime: "ply-runtime",
  }

// A path outside the working directory is spelled under `abs` without its leading `/`.
test "a checkout named outside the working directory is the path it names" {
  let elsewhere = {
    label: "abs",
    spelling: "src/ply",
    display: "/src/ply",
    inside: ".",
    absolute: "/src/ply",
    machine: "/src/ply",
    part: "",
  };
  let options = handle {
    options_of({ ..no_flags(), paths: [elsewhere] }, placed_parts())
  } with {
    env.pwd[sys]() -> "/home/me",
  };
  assert_eq(options.root, "/src/ply");
  assert_eq(options.library, "/src/ply/target/debug/libply_runtime.a");
  assert_eq(options.out, "/src/ply/target/debug/ply")
}

// The CI's first bootstrap writes below `target/stage1`, which no build made before it.
test "a ply installed below a directory not yet made is written there" {
  let ran = fs::on_mem[abs](fs::mem_of([{ path: "work/exe", body: b"code" }]), ||
    handle { installed("/work/exe", "/out/stage1/ply", b"pack") } with { entropy.next() -> 7 });
  assert_eq(ran.value, Ok(()));
  assert_eq(fs::mem_read(ran.tree, "out/stage1/ply"), Some(b"codepack"));
  assert_eq(fs::mem_list(ran.tree, "out/stage1"), Some(["ply"]))
}

fn two_shipped() -> List<Shipping> =
  [
    { name: "std.a.ply", path: "pack/a.ply", bytes: b"pub fn a() -> Int = 1\n" },
    { name: "std/a/data.txt", path: "pack/a/data.txt", bytes: b"data" },
  ]

test "the shipped modules' key moves with a module's bytes and its name, and not with their order" {
  let files = two_shipped();
  let key = shipped_key(files);
  assert_eq(shipped_key([files.get(1), files.get(0)]), key);
  assert(shipped_key([{ ..files.get(0), bytes: b"pub fn a() -> Int = 2\n" }, files.get(1)]) != key);
  assert(shipped_key([{ ..files.get(0), name: "std.b.ply" }, files.get(1)]) != key);
  assert(shipped_key([files.get(0)]) != key)
}

test "a link's key moves with the compiler, its level, the library and what is linked after it" {
  let t = { identity: b"cc 1", support: [], level: "-O2", checked: false };
  let key = linking_key(t, b"library", ["-lm"]);
  assert_eq(linking_key(t, b"library", ["-lm"]), key);
  assert(linking_key({ ..t, identity: b"cc 2" }, b"library", ["-lm"]) != key);
  assert(linking_key({ ..t, level: "-O0" }, b"library", ["-lm"]) != key);
  assert(linking_key(t, b"another", ["-lm"]) != key);
  assert(linking_key(t, b"library", ["-lm", "-ldl"]) != key)
}

// A development build's library is larger than one read answers.
test "a file's digest is of its ranges' digests, however many reads it takes" {
  let tree = fs::mem_of([{ path: "lib/a", body: b"0123456789" }]);
  let over = |path: String, step: Int| fs::on_mem[abs](tree, || ranged_digest(path, step)).value;
  assert_eq(
    over("lib/a", 4),
    Some(blake3(Bytes::concat_all([blake3(b"0123"), blake3(b"4567"), blake3(b"89")]))),
  );
  assert_eq(over("lib/a", 16), Some(blake3(blake3(b"0123456789"))));
  assert_eq(over("lib/absent", 4), None)
}

test "a builder is kept under its shipped modules, its link and the definitions that build it" {
  let kept = builder_kept(b"shipped", b"linking", b"building");
  assert(kept.ends_with(".builder"));
  assert_eq(builder_kept(b"shipped", b"linking", b"building"), kept);
  assert(builder_kept(b"moved", b"linking", b"building") != kept);
  assert(builder_kept(b"shipped", b"moved", b"building") != kept);
  assert(builder_kept(b"shipped", b"linking", b"moved") != kept)
}

test "what a ply answered is kept under how it answers, and under nothing of its own front end" {
  let kept = answers_kept(b"shipped", b"linking", b"answering", b"gathering");
  assert(kept.ends_with(".answers"));
  assert_eq(answers_kept(b"shipped", b"linking", b"answering", b"gathering"), kept);
  assert(answers_kept(b"moved", b"linking", b"answering", b"gathering") != kept);
  assert(answers_kept(b"shipped", b"moved", b"answering", b"gathering") != kept);
  assert(answers_kept(b"shipped", b"linking", b"moved", b"gathering") != kept);
  assert(answers_kept(b"shipped", b"linking", b"answering", b"moved") != kept)
}

test "what was kept of a ply's answers reads back, and bytes that are not the whole of it read as none" {
  let answered = [
    { path: "answers/store", bytes: b"frames" },
    { path: "answers/index", bytes: b"" },
  ];
  let kept = kept_of(answered);
  assert_eq(unkept(kept), Some(answered));
  assert_eq(unkept(kept.slice(0, kept.len() - 1)), None);
  assert_eq(unkept(kept.concat(b"x")), None);
  assert_eq(unkept(b"short"), None)
}
