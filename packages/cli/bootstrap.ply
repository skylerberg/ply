//! `ply bootstrap` — a native `ply` built from a checkout by this one. The runtime's library is the
//! one cargo built of the checkout's Rust, which describes itself; the builder is a program that
//! enters the checkout's compiler, built here against that description over the checkout's shipped
//! modules, which this `ply`'s packed answers answer for wherever they did not move; the builder
//! builds the checkout's `ply` and holds its constants on that runtime; that is linked into a native
//! `ply`, which answers the shipped modules; and its pack carries the shipped modules, those answers
//! and what its front end answered of the definition it enters. The builder and the answers are
//! each kept in the toolchain's cache under what decides them, so a bootstrap of what an earlier one
//! built makes neither again, and one whose `ply` answers as an earlier one's did answers nothing.
//! Only the shipped modules the builder pulls are built by this `ply`'s compiler, so only they
//! cannot use a language rule the checkout introduces.

import compiler.load (Derives)
import args (Flags, no_flags, style_of)
import std.env (env)
import program (TimedLoad, loaded_analysis, timed_uncached_over, program_view)
import module_queries
import report (CommandOutput, ok_code, compile_error, refused, reported, timed)
import sources (Project)
import library
import library (ShippedFile)
import compiler.cc
import compiler.cc (Profile, Toolchain, compilers, toolchain)
import compiler.front.published (entry_header)
import compiler.front.interface (length_prefixed)
import compiler.build (build_roots)
import compiler.emit.keys (Named)
import compiler.native
import compiler.native (PackFile)
import compiler.store.packs
import compiler.syntax.parsing (no_module, dummy_span)
import compiler.check.resolve.tables (Diag, error_at)
import compiler.unit (shipped, results_store, emitted, emitter_identity, held, identity_of,
                      shipped_runtime)
import compiler.emit.abi (Runtime, runtime_of)
import compiler.store.records (Record, record_store, with_record_store)
import std.bin
import std.bytes
import std.fs
import std.fs (fs)
import std.hash (blake3)
import std.json (Json, Str, Bool, object)
import std.list
import std.string
import std.process (process)
import std.random (entropy)
import std.time (time)
import std.path (strip_root, parent)
import std.pkg (ToolchainParts, library_of)

/// What a bootstrap is told: the checkout and where its `ply.work` says its parts are, the profile
/// it compiles under, the runtime's library and where the `ply` it builds goes.
pub type Options = {
  root: String,
  toolchain: ToolchainParts,
  profile: Profile,
  library: String,
  out: String,
}

/// `path` made absolute against the working directory `pwd`.
fn absolute(pwd: String, path: String) -> String =
  if path.starts_with("/") { path } else if path == "." { pwd } else { pwd ++ "/" ++ path }

/// The checkout the line names, absolute.
fn checkout_of(flags: Flags) -> String / {env.working_directory} =
  match flags.paths.at(0) { Some(r) -> r.absolute, None -> env.working_directory() }

fn options_of(
  flags: Flags,
  profile: Profile,
  t: ToolchainParts,
) -> Options / {env.working_directory} = {
  let pwd = env.working_directory();
  let root = checkout_of(flags);
  let target = root ++ "/target/" ++ profile.runtime_dir;
  {
    root: root,
    toolchain: t,
    profile: profile,
    library: match flags.runtime {
      Some(l) -> absolute(pwd, l),
      None -> target ++ "/" ++ library_of(t),
    },
    out: match flags.out { Some(o) -> absolute(pwd, o), None -> target ++ "/ply" },
  }
}

fn unlocated_error(message: String) -> Diag =
  error_at(b"E0502", no_module(), dummy_span(), Bytes::of_string(message), b"", [])

// --- Building -------------------------------------------------------------------------

/// What a bootstrap's builds reach beside the loads they make: the compilers and their cache, the
/// checkout and where the `ply` it builds goes, below the filesystem's root.
pub effect set Bootstraps = {compilers.write[cc], toolchain.read, toolchain.write, fs.read[abs], fs.write[abs], time.elapsed_ms}

fn failed<a>(why: String) -> Result<a, List<Diag>> = Err([unlocated_error(why)])

/// The toolchain that compiles and links native programs under `profile`. It is always `cc`.
fn toolchain_for(profile: Profile) -> Result<Toolchain, List<Diag>> / {compilers.read[cc]} =
  match compilers.find[cc]() {
    None -> failed("no `cc` is installed to compile C with"),
    Some(compiler) -> Ok(cc::toolchain_of(compiler, profile.native, profile.checked)),
  }

/// The runtime the library at `library` is, as a program linked with it and nothing else says.
fn describe_runtime(
  t: Toolchain,
  library: String,
  work: String,
) -> Result<Runtime, List<Diag>> / {compilers.write[cc], toolchain.read, toolchain.write, abort.raise} =
  match cc::executable[cc](
      t,
      native::describer_c(),
      [],
      [library].concat(toolchain.libraries()),
      work,
    ) {
    Err(why) -> failed("the runtime's library at `" ++ library ++ "` does not link: " ++ why),
    Ok(exe) -> {
      let ran = toolchain.run(cache_relative(exe), []);
      if ran.code != 0 { failed("the runtime's library does not describe itself") } else {
        match runtime_of(ran.out) {
          Ok(r) -> Ok(r),
          Err(why) ->
            failed(
              "the runtime's library describes itself in a form this `ply` does not read: "
                ++ String::of_bytes_lossy(why),
            ),
        }
      }
    },
  }

/// `path`, an absolute one below the toolchain's cache, as the cache names it.
fn cache_relative(path: String) -> String / {toolchain.read, abort.raise} = {
  let cache = toolchain.cache();
  if path.starts_with(cache ++ "/") { path.slice(cache.len() + 1, path.len()) } else { path }
}

/// Prints how many of a program's parts `objects` compiled, the cache holding the rest, and how long
/// that took since `since`, when `phases` is on. `whose` names the program as its owner.
fn compiled_timed(
  phases: Bool,
  whose: String,
  objects: Result<cc::Objects, String>,
  since: Int,
) -> Unit / {process.err[proc], time.elapsed_ms} =
  match objects {
    Err(_) -> (),
    Ok(o) ->
      timed(
        phases,
        "compiled " ++ o.compiled.to_string() ++ " of " ++ whose ++ " " ++ o.paths.len().to_string()
          ++ " parts",
        since,
      ),
  }

/// `objects` and the native `main` linked with the runtime's library into an executable: its path
/// below the cache.
fn link_executable(
  t: Toolchain,
  objects: Result<cc::Objects, String>,
  library: String,
  work: String,
) -> Result<String, List<Diag>> / {compilers.write[cc], toolchain.read, toolchain.write, abort.raise} =
  match objects {
    Err(why) -> failed(why),
    Ok(objects) -> match cc::executable[cc](
        t,
        native::main_c(),
        objects.paths,
        [library].concat(toolchain.libraries()),
        work,
      ) {
      Err(why) -> failed(why),
      Ok(exe) -> Ok(exe),
    },
  }

/// The executable at `exe` with `pack` after it.
fn append_pack(
  exe: String,
  pack: Bytes,
) -> Result<String, List<Diag>> / {toolchain.read, toolchain.write, abort.raise} =
  if toolchain.append(cache_relative(exe), pack) { Ok(exe) }
  else { failed("the pack could not be written after `" ++ exe ++ "`") }

/// What every native `ply` and builder carries: the shipped modules as a pack keeps them, and the
/// program's own front end.
fn build_pack(files: List<ShippedFile>, front: Bytes, more: List<PackFile>) -> Bytes =
  native::pack(
    files.map(|f: ShippedFile| { path: f.path, bytes: f.bytes }).push({
      path: native::definitions_path(),
      bytes: front,
    }).concat(
      more,
    ),
  )

// --- What a bootstrap keeps ----------------------------------------------------------------

/// What names the shipped modules `files` hold, whatever order they were read in.
fn shipped_key(files: List<ShippedFile>) -> Bytes =
  blake3(
    Bytes::concat_all(
      files.fold(Map::new(), |acc: Map<String, Bytes>, f: ShippedFile|
        acc.insert(f.name, length_prefixed(Bytes::of_string(f.path)).concat(blake3(f.bytes)))).fold(
        [b"ply shipped modules 1\0"],
        |acc: List<Bytes>, name: String, held: Bytes|
          acc.push(length_prefixed(Bytes::of_string(name))).push(held),
      ),
    ),
  )

/// What an executable linked here is a function of besides its objects' C: the compiler and what
/// every compile and link passes it, the `main` it is entered through, and the runtime's library,
/// `library` its digest and `libraries` what is linked after it.
fn linking_key(t: Toolchain, library: Bytes, libraries: List<String>) -> Bytes =
  blake3(
    Bytes::concat_all([
      b"ply native link 1\0",
      length_prefixed(t.identity),
      length_prefixed(
        Bytes::of_string(String::join(cc::compile_flags(t).concat(native::native_flags()), " ")),
      ),
      length_prefixed(native::main_c()),
      length_prefixed(library),
      length_prefixed(Bytes::of_string(String::join(libraries, " "))),
    ]),
  )

/// How many bytes of a file one read takes: under what a read may answer at once.
fn chunk_size() -> Int = 16777216

/// Each `step` bytes of the file at `path` in turn, as `each` makes of them: none where it does not
/// read.
fn read_chunks<a>(
  path: String,
  step: Int,
  each: (Bytes) -> a,
) -> Option<List<a>> / {fs.read[abs], abort.raise} =
  match fs.file_size[abs](path) {
    None -> None,
    Some(size) ->
      range(0, (size + step - 1) / step).fold(Some([]), |held: Option<List<a>>, i: Int|
        match held {
          None -> None,
          Some(built_ply) -> match fs.read_at[abs](path, i * step, step) {
            Some(bytes) -> Some(built_ply.push(each(bytes))),
            None -> None,
          },
        }),
  }

/// What the file at `path` holds, as the digest of the digests of each `step` bytes of it in turn,
/// so a file larger than one read answers is still named by its bytes: none where it does not read.
fn chunked_digest(path: String, step: Int) -> Option<Bytes> / {fs.read[abs], abort.raise} =
  match read_chunks(path, step, blake3) {
    Some(digests) -> Some(blake3(Bytes::concat_all(digests))),
    None -> None,
  }

/// What the file at `path` holds, read `step` bytes at a time: none where it does not read.
fn chunked_read(path: String, step: Int) -> Option<Bytes> / {fs.read[abs], abort.raise} =
  match read_chunks(path, step, |b: Bytes| b) {
    Some(parts) -> Some(Bytes::concat_all(parts)),
    None -> None,
  }

/// The definition a builder is a function of besides what it is made from: the one that builds it,
/// whose hash covers the front end, the emitter and how the builder's C is linked and packed. So a
/// `ply` whose own differs builds its builder itself, and a bootstrap it could not run fails here
/// and not in the checkouts a release of it would be handed.
fn builder_roots() -> List<Bytes> = [b"bootstrap.build_builder"]

/// Where the cache keeps the builder of the shipped modules `shipped` names, linked as `linking`
/// names and built by the definitions `building` identifies.
fn builder_cache_key(shipped: Bytes, linking: Bytes, building: Bytes) -> String / {abort.raise} = {
  let key = blake3(
    Bytes::concat_all([
      b"ply builder 1\0",
      length_prefixed(builder_source()),
      length_prefixed(Bytes::of_string(builder_entry())),
      shipped,
      linking,
      length_prefixed(building),
    ]),
  );
  key.hex_of() ++ ".builder"
}

/// The definition what a `ply` answered is kept as a function of on this side: the one that gathers
/// it, whose hash covers what is read of the store the `ply` wrote and how it is laid into a pack.
fn shipped_results_roots() -> List<Bytes> = [b"bootstrap.build_shipped_results"]

/// Where the cache keeps what a `ply` answers of the shipped modules `shipped` names, linked as
/// `linking` names: `answering` is what the `ply` says names how it answers them, and `gathering`
/// identifies the definitions that gather what it answered. The `ply`'s own front end is no part of
/// it, so one that differs only there takes what the other answered.
fn shipped_results_cache_key(
  shipped: Bytes,
  linking: Bytes,
  answering: Bytes,
  gathering: Bytes,
) -> String / {abort.raise} = {
  let key = blake3(
    Bytes::concat_all([
      b"ply answers 1\0",
      shipped,
      linking,
      length_prefixed(answering),
      length_prefixed(gathering),
    ]),
  );
  key.hex_of() ++ ".answers"
}

/// One file of what a `ply` answered, as the cache keeps it.
type CachedFile = { path: String, bytes: Bytes }

derive bin for CachedFile

/// `answered` as the cache keeps it.
fn encode_shipped_results(shipped_results: List<PackFile>) -> Bytes / {abort.raise} =
  bin::encode(
    shipped_results.map(|f: PackFile| { path: f.path, bytes: f.bytes }),
    bin::list_bin(cached_file_bin()),
  )

/// What `encode_shipped_results` kept: nothing for bytes that are not the whole of it.
fn decode_shipped_results(bytes: Bytes) -> Option<List<PackFile>> / {abort.raise} =
  match bin::decode(bytes, bin::list_bin(cached_file_bin())) {
    Ok(files) -> Some(files.map(|f: CachedFile| { path: f.path, bytes: f.bytes })),
    Err(_) -> None,
  }

// --- The builder ------------------------------------------------------------------------

/// The builder's own module: it enters the checkout's compiler, and the rest of the builder is the
/// shipped modules that reaches.
fn builder_source() -> Bytes =
  b"import compiler.build\nimport compiler.build (Builds)\nimport std.process (process)\n\npub fn main() -> Unit / {Builds, process.args[proc], process.exit[proc]} = build::main()\n"

fn builder_entry() -> String = "builder.main"

/// The builder as a load takes it: its one module, read from no directory.
fn builder_project() -> Project = {
  let text = builder_source();
  {
    files: [
      {
        path: "builder.ply",
        module: "builder",
        text: text,
        at: { label: "abs", path: "builder.ply" },
      },
    ],
    sources: [{ name: b"builder", src: text }],
    diags: [],
    manifest: None,
    packages: [],
    root_key: "",
  }
}

/// A builder below the cache, and whether it was taken as an earlier bootstrap kept it.
type Builder = { path: String, taken: Bool }

/// The builder of the checkout's shipped modules on `runtime`, at `kept` below the cache: the one an
/// earlier bootstrap kept there, or else built here and kept, printing how many of its parts were
/// compiled where `phases` asks. A shipped module that did not move since this `ply` was built is
/// answered by what this `ply` carries.
fn build_builder(
  options: Options,
  t: Toolchain,
  runtime: Runtime,
  files: List<ShippedFile>,
  kept: String,
  work: String,
  phases: Bool,
) -> Result<Builder, List<Diag>> / {Bootstraps, process.err[proc], shipped.definitions, toolchain.bodies_dir, shipped.read_pack, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], entropy.next, time.now_ms, shipped.report_reached, Derives, abort.raise} = {
  let path = toolchain.cache() ++ "/" ++ kept;
  if toolchain.exists(kept) { Ok({ path: path, taken: true }) } else {
    let started = time.elapsed_ms();
    let t_load: TimedLoad = library::with_shipped_files(files, ||
      timed_uncached_over([], builder_project(), started, false));
    match program_view(t_load.program) {
      None -> Err(t_load.program.diags),
      Some(w) -> {
        let front = loaded_analysis(t_load, w);
        let entry = Bytes::of_string(builder_entry());
        let offered = build_roots(front, w.frame.hashes, entry);
        let store = results_store(
          strip_root(toolchain.bodies_dir()),
          runtime,
          emitter_identity(shipped.definitions()),
        );
        let emission = with_record_store[abs, ans](store, ||
          emitted(
            runtime,
            front.dump,
            front.files.map(|f: { path: String, name: String, text: Bytes }| f.text),
            front.inputs,
            offered,
            |k: Bytes| record_store.get[ans](k),
            |rs: List<Record>| record_store.put[ans](rs),
            entered: Some([Named(entry)]),
          ));
        match ((held(front.dump, emission), entry_header(front.dump, entry))) {
          (Err(diags), _) -> Err(diags),
          (_, None) -> failed("the builder defines no `" ++ builder_entry() ++ "` to enter"),
          (Ok(c), Some(carried)) -> {
            let compiling = time.elapsed_ms();
            let objects = cc::objects[cc](t, cc::split(c), native::native_flags(), work);
            compiled_timed(phases, "the builder's", objects, compiling);
            match link_executable(t, objects, options.library, work) {
              Err(diags) -> Err(diags),
              Ok(exe) -> match append_pack(exe, build_pack(files, carried, [])) {
                Err(diags) -> Err(diags),
                Ok(whole) -> if toolchain.rename(cache_relative(whole), kept) {
                  Ok({ path: path, taken: false })
                } else { failed("the builder could not be kept in the toolchain's cache") },
              },
            }
          },
        }
      },
    }
  }
}

/// The checkout's `ply` built by `builder`: its front end and the sources of its C, which the cache
/// keeps. The builder tells its steps as it takes them where `phases` asks it to. It checks through
/// the store `ply std --build_shipped_results` answers the shipped modules through, so each shipped module `ply`
/// imports is answered once a bootstrap.
fn build_ply(
  options: Options,
  builder: String,
  work: String,
  phases: Bool,
) -> Result<{ front: Bytes, sources: List<cc::Source> }, List<Diag>> / {toolchain.read, toolchain.write, fs.read[abs], fs.write[abs], toolchain.reuse_dir, abort.raise} = {
  let cache = toolchain.cache();
  let front = cache ++ "/" ++ work ++ "/ply.front";
  let manifest = cache ++ "/" ++ work ++ "/ply.sources";
  let memo = module_queries::shipped_store_dir(toolchain.reuse_dir());
  if fs.create_dir[abs](strip_root(memo)) {
    fs.write_file[abs](strip_root(memo) ++ "/.used", b"");
    ()
  };
  let ran = toolchain.run(cache_relative(builder), [
    options.root ++ "/" ++ options.toolchain.cli,
    options.toolchain.entry,
    front,
    manifest,
    memo,
    "kept",
    if phases { "phases" } else { "quiet" },
  ]);
  if ran.code != 0 { failed("the builder did not build `ply`") } else {
    match ((fs.read_file[abs](strip_root(front)), fs.read_file[abs](strip_root(manifest)))) {
      (Some(f), Some(m)) -> match cc::parse_manifest(m) {
        Some(sources) -> Ok({ front: f, sources: sources }),
        None -> failed("the builder's manifest of `ply`'s C does not read"),
      },
      _ -> failed("what the builder built could not be read back"),
    }
  }
}

/// What `ply` answers of the shipped modules, as its pack carries it: the pack its `std --build_shipped_results`
/// wrote below `work`, a file of frames and its index, as it wrote them.
fn build_shipped_results(
  ply: String,
  work: String,
) -> Result<List<PackFile>, List<Diag>> / {toolchain.read, toolchain.write, fs.read[abs], abort.raise} = {
  let dir = toolchain.cache() ++ "/" ++ work ++ "/answers";
  let ran = toolchain.run(cache_relative(ply), ["std", "--answers", dir]);
  let at = |name: String| strip_root(dir ++ "/pack/" ++ name);
  if ran.code != 0 { failed("the new `ply` did not answer the shipped modules") } else {
    match ((
        chunked_read(at(packs::store_file()), chunk_size()),
        fs.read_file[abs](at(packs::index_file())),
      )) {
      (Some(store), Some(index)) ->
        Ok([
          { path: "answers/" ++ packs::store_file(), bytes: store },
          { path: "answers/" ++ packs::index_file(), bytes: index },
        ]),
      _ -> failed("the new `ply` wrote no pack of what the shipped modules answer"),
    }
  }
}

/// What the `ply` at `exe` answers of the shipped modules, as its pack carries it: what an earlier
/// bootstrap kept of a `ply` that answers them as this one does, or else what this one answers,
/// which is kept. `taken` is whether it was kept. A copy that carries only its front end says how
/// it answers and answers for the one that carries the answers too; one that cannot say answers
/// and nothing is kept.
fn shipped_results(
  exe: String,
  files: List<ShippedFile>,
  front: Bytes,
  keys: CacheKeys,
  work: String,
) -> Result<{ answered: List<PackFile>, taken: Bool }, List<Diag>> / {toolchain.read, toolchain.write, fs.read[abs], fs.write[abs], shipped.definitions, abort.raise} = {
  let answering = exe ++ "-answering";
  if !fs.copy[abs](strip_root(exe), strip_root(answering)) {
    failed("the new `ply` could not be copied to answer with")
  } else {
    match append_pack(answering, build_pack(files, front, [])) {
      Err(diags) -> Err(diags),
      Ok(_) -> {
        let asked = toolchain.run(cache_relative(answering), ["std", "--answering"]);
        let kept = if asked.code != 0 { None } else {
          Some(
            shipped_results_cache_key(
              keys.shipped,
              keys.linking,
              Bytes::of_string(String::of_bytes_lossy(asked.out).trim()),
              identity_of(shipped.definitions(), shipped_results_roots()),
            ),
          )
        };
        let had = match kept {
          None -> None,
          Some(at) -> if !toolchain.exists(at) { None } else {
            match toolchain.read_file(at) {
              Some(bytes) -> decode_shipped_results(bytes),
              None -> None,
            }
          },
        };
        match had {
          Some(a) -> Ok({ answered: a, taken: true }),
          None -> match build_shipped_results(answering, work) {
            Err(diags) -> Err(diags),
            Ok(files) -> match kept {
              None -> Ok({ answered: files, taken: false }),
              Some(at) -> if toolchain.write_file(at, encode_shipped_results(files)) {
                Ok({ answered: files, taken: false })
              } else {
                failed("what the new `ply` answered could not be kept in the toolchain's cache")
              },
            },
          },
        }
      },
    }
  }
}

fn bootstrap_output(options: Options) -> CommandOutput =
  {
    json: object([
      { key: "command", value: Str("bootstrap") },
      { key: "ok", value: Bool(true) },
      { key: "wrote", value: Str(options.out) },
    ]),
    lines: [
      "built `ply` from " ++ options.root ++ " under " ++ options.profile.name,
      "wrote " ++ options.out,
    ],
    errs: [],
    code: ok_code(),
  }

/// The `ply` at `exe` written to `out` with its pack, every directory above `out` made: by a copy
/// beside `out` and a rename, so a process running the one there keeps its file.
fn install(
  exe: String,
  out: String,
  pack: Bytes,
) -> Result<Unit, List<Diag>> / {fs.write[abs], entropy.next, abort.raise} = {
  let tmp = out ++ "." ++ entropy.next().to_string() ++ ".tmp";
  if fs.create_dir[abs](strip_root(parent(out))) && fs.copy[abs](strip_root(exe), strip_root(tmp))
      && fs.append[abs](strip_root(tmp), pack) != None
      && fs.rename[abs](strip_root(tmp), strip_root(out)) { Ok(()) } else {
    let _ = fs.remove[abs](strip_root(tmp));
    failed("the new `ply` could not be written to `" ++ out ++ "`")
  }
}

/// What names what every step of one bootstrap is made from: its shipped modules, and how it links.
type CacheKeys = { shipped: Bytes, linking: Bytes }

/// Builds the checkout's `ply` in `work`, printing each step's time with [`timed`].
fn bootstrap_ply(
  options: Options,
  t: Toolchain,
  files: List<ShippedFile>,
  work: String,
  phases: Bool,
) -> Result<Unit, List<Diag>> / {Bootstraps, process.err[proc], shipped.definitions, toolchain.bodies_dir, toolchain.reuse_dir, shipped.read_pack, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], entropy.next, time.now_ms, shipped.report_reached, Derives, abort.raise} = {
  let started = time.elapsed_ms();
  match describe_runtime(t, options.library, work) {
    Err(diags) -> Err(diags),
    Ok(runtime) -> match chunked_digest(strip_root(options.library), chunk_size()) {
      None -> failed("the runtime's library at `" ++ options.library ++ "` could not be read"),
      Some(library) -> {
        let keys = {
          shipped: shipped_key(files),
          linking: linking_key(t, library, toolchain.libraries()),
        };
        timed(phases, "described the runtime", started);
        let at = time.elapsed_ms();
        match build_builder(
            options,
            t,
            runtime,
            files,
            builder_cache_key(
              keys.shipped,
              keys.linking,
              identity_of(shipped.definitions(), builder_roots()),
            ),
            work,
            phases,
          ) {
          Err(diags) -> Err(diags),
          Ok(builder) -> {
            timed(
              phases,
              if builder.taken { "took the kept builder" } else { "built the builder" },
              at,
            );
            let at = time.elapsed_ms();
            match build_ply(options, builder.path, work, phases) {
              Err(diags) -> Err(diags),
              Ok(built_ply) -> {
                timed(phases, "built `ply`", at);
                let compiling = time.elapsed_ms();
                let objects = cc::objects_from_sources[cc](
                  t,
                  built_ply.sources,
                  native::native_flags(),
                  work,
                );
                compiled_timed(phases, "`ply`'s", objects, compiling);
                let linking = time.elapsed_ms();
                match link_executable(t, objects, options.library, work) {
                  Err(diags) -> Err(diags),
                  Ok(exe) -> {
                    timed(phases, "linked `ply`", linking);
                    precompile_and_install(options, files, keys, built_ply, exe, work, phases)
                  },
                }
              },
            }
          },
        }
      },
    },
  }
}

/// Writes the `ply` linked at `exe`, with its pack, to where it goes, printing each step's time with
/// [`timed`].
fn precompile_and_install(
  options: Options,
  files: List<ShippedFile>,
  keys: CacheKeys,
  built_ply: { front: Bytes, sources: List<cc::Source> },
  exe: String,
  work: String,
  phases: Bool,
) -> Result<Unit, List<Diag>> / {toolchain.read, toolchain.write, fs.read[abs], fs.write[abs], shipped.definitions, process.err[proc], time.elapsed_ms, entropy.next, abort.raise} = {
  let at = time.elapsed_ms();
  match shipped_results(exe, files, built_ply.front, keys, work) {
    Err(diags) -> Err(diags),
    Ok(a) -> {
      timed(
        phases,
        if a.taken { "reused the standard library's stored check results" }
        else { "checked the standard library with the new `ply`" },
        at,
      );
      let at = time.elapsed_ms();
      match install(exe, options.out, build_pack(files, built_ply.front, a.answered)) {
        Err(diags) -> Err(diags),
        Ok(_) -> {
          timed(phases, "packed and wrote `ply`", at);
          Ok(())
        },
      }
    },
  }
}

/// The definition how a `ply` bootstraps a checkout is a function of besides the runtime it runs on:
/// the command's own, whose hash covers all it runs.
fn bootstrapping_roots() -> List<Bytes> = [b"bootstrap.run"]

/// `--identity`: what names how this `ply` bootstraps a checkout, on one line and nothing else: the
/// definitions the command runs and the runtime they run on. Two that print the same build every
/// checkout alike, so a `ply` that prints what the `ply` that built it printed builds itself again
/// as it was built.
pub fn identity() -> CommandOutput / {shipped.definitions, shipped.runtime, abort.raise} = {
  let key = blake3(
    Bytes::concat_all([
      b"ply bootstrapping 1\0",
      identity_of(shipped.definitions(), bootstrapping_roots()),
      b"\0",
      shipped_runtime().identity,
    ]),
  );
  let id = key.hex_of();
  {
    json: object([
      { key: "command", value: Str("bootstrap") },
      { key: "ok", value: Bool(true) },
      { key: "identity", value: Str(id) },
    ]),
    lines: [id],
    errs: [],
    code: ok_code(),
  }
}

pub fn run(
  flags: Flags,
  profile: Profile,
) -> CommandOutput / {Bootstraps, process.err[proc], compilers.read[cc], env.working_directory, env.variable, shipped.definitions, toolchain.bodies_dir, toolchain.reuse_dir, shipped.read_pack, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], entropy.next, time.now_ms, shipped.report_reached, Derives, abort.raise} = {
  let s = style_of(flags);
  match library::toolchain(checkout_of(flags)) {
    Err(unread) -> reported(s, "bootstrap", unread.diags, unread.places),
    Ok(parts) -> {
      let options = options_of(flags, profile, parts);
      let files = library::shipped_files({ root: options.root, parts: parts });
      let phases = env.variable("PLY_C_PHASES") != None;
      let built = match ((toolchain_for(options.profile), toolchain.temp_dir())) {
        (Err(diags), _) -> Err(diags),
        (_, None) -> failed("the toolchain's cache has no room to build in"),
        (Ok(t), Some(work)) -> {
          let result = bootstrap_ply(options, t, files, work, phases);
          toolchain.remove_tree(work);
          result
        },
      };
      match built {
        Err(diags) -> reported(s, "bootstrap", diags, []),
        Ok(_) -> bootstrap_output(options),
      }
    },
  }
}

test "what names how a `ply` bootstraps moves with the command's definition and its runtime alone" {
  let said = |definitions: Bytes, runtime: Bytes|
    handle {
      identity().lines
    } with {
      shipped.definitions() -> definitions,
      shipped.runtime() -> Bytes::concat_all([b"ply runtime 1\nidentity ", runtime, b"\n"]),
    };
  let first = said(b"bootstrap.run 01\nexplain.run 02\n", b"r");
  assert_eq(said(b"bootstrap.run 01\nexplain.run 03\n", b"r"), first);
  assert(said(b"bootstrap.run 04\nexplain.run 02\n", b"r") != first, None);
  assert(said(b"bootstrap.run 01\nexplain.run 02\n", b"s") != first, None)
}

fn sample_parts() -> ToolchainParts =
  {
    std: "lib/std",
    std_tests: "tests/std",
    compiler: "lib/compiler",
    cli: "cli",
    entry: "ply.main",
    cli_tests: "tests/cli",
    runtime: "ply-runtime",
  }

// A path outside the working directory is spelled under `abs` without its leading `/`.
test "a checkout named outside the working directory is the path it names" {
  let elsewhere = {
    label: "abs",
    root_path: "src/ply",
    display: "/src/ply",
    inside: ".",
    absolute: "/src/ply",
    machine: "/src/ply",
    part: "",
  };
  let options = handle {
    options_of({ ..no_flags(), paths: [elsewhere] }, cc::development(), sample_parts())
  } with {
    env.working_directory() -> "/home/me",
  };
  assert_eq(options.root, "/src/ply");
  assert_eq(options.library, "/src/ply/target/debug/libply_runtime.a");
  assert_eq(options.out, "/src/ply/target/debug/ply")
}

test "a release bootstrap links the release runtime and writes beside it" {
  let options = handle {
    options_of(no_flags(), cc::release(), sample_parts())
  } with {
    env.working_directory() -> "/src/ply",
  };
  assert_eq(options.library, "/src/ply/target/release/libply_runtime.a");
  assert_eq(options.out, "/src/ply/target/release/ply")
}

// The CI's first bootstrap writes below `target/stage1`, which no build made before it.
test "a ply installed below a directory not yet made is written there" {
  let ran = fs::on_mem[abs](fs::mem_of([{ path: "work/exe", body: b"code" }]), ||
    handle { install("/work/exe", "/out/stage1/ply", b"pack") } with { entropy.next() -> 7 });
  assert_eq(ran.value, Ok(()));
  assert_eq(fs::mem_read(ran.tree, "out/stage1/ply"), Some(b"codepack"));
  assert_eq(fs::mem_list(ran.tree, "out/stage1"), Some([{ name: "ply", kind: fs::File }]))
}

fn two_shipped() -> List<ShippedFile> =
  [
    { name: "std.a.ply", path: "pack/a.ply", bytes: b"pub fn a() -> Int = 1\n" },
    { name: "std/a/data.txt", path: "pack/a/data.txt", bytes: b"data" },
  ]

test "the shipped modules' key moves with a module's bytes and its name, and not with their order" {
  let files = two_shipped();
  let key = shipped_key(files);
  assert_eq(shipped_key([files.get(1), files.get(0)]), key);
  assert(shipped_key([{ ..files.get(0), bytes: b"pub fn a() -> Int = 2\n" }, files.get(1)]) != key);
  assert(shipped_key([{ ..files.get(0), name: "std.b.ply" }, files.get(1)]) != key);
  assert(shipped_key([files.get(0)]) != key)
}

test "a link's key moves with the compiler, its level, the library and what is linked after it" {
  let t = { identity: b"cc 1", support_flags: [], level: "-O2", checked: false };
  let key = linking_key(t, b"library", ["-lm"]);
  assert_eq(linking_key(t, b"library", ["-lm"]), key);
  assert(linking_key({ ..t, identity: b"cc 2" }, b"library", ["-lm"]) != key);
  assert(linking_key({ ..t, level: "-O0" }, b"library", ["-lm"]) != key);
  assert(linking_key(t, b"another", ["-lm"]) != key);
  assert(linking_key(t, b"library", ["-lm", "-ldl"]) != key)
}

// A development build's library is larger than one read answers.
test "a file's digest is of its ranges' digests, however many reads it takes" {
  let tree = fs::mem_of([{ path: "lib/a", body: b"0123456789" }]);
  let over = |path: String, step: Int| fs::on_mem[abs](tree, || chunked_digest(path, step)).value;
  assert_eq(
    over("lib/a", 4),
    Some(blake3(Bytes::concat_all([blake3(b"0123"), blake3(b"4567"), blake3(b"89")]))),
  );
  assert_eq(over("lib/a", 16), Some(blake3(blake3(b"0123456789"))));
  assert_eq(over("lib/absent", 4), None)
}

test "a builder is kept under its shipped modules, its link and the definitions that build it" {
  let kept = builder_cache_key(b"shipped", b"linking", b"building");
  assert(kept.ends_with(".builder"));
  assert_eq(builder_cache_key(b"shipped", b"linking", b"building"), kept);
  assert(builder_cache_key(b"moved", b"linking", b"building") != kept);
  assert(builder_cache_key(b"shipped", b"moved", b"building") != kept);
  assert(builder_cache_key(b"shipped", b"linking", b"moved") != kept)
}

test "what a ply answered is kept under how it answers, and under nothing of its own front end" {
  let kept = shipped_results_cache_key(b"shipped", b"linking", b"answering", b"gathering");
  assert(kept.ends_with(".answers"));
  assert_eq(shipped_results_cache_key(b"shipped", b"linking", b"answering", b"gathering"), kept);
  assert(shipped_results_cache_key(b"moved", b"linking", b"answering", b"gathering") != kept);
  assert(shipped_results_cache_key(b"shipped", b"moved", b"answering", b"gathering") != kept);
  assert(shipped_results_cache_key(b"shipped", b"linking", b"moved", b"gathering") != kept);
  assert(shipped_results_cache_key(b"shipped", b"linking", b"answering", b"moved") != kept)
}

test "what was kept of a ply's answers reads back, and bytes that are not the whole of it read as none" {
  let shipped_results = [
    { path: "answers/store", bytes: b"frames" },
    { path: "answers/index", bytes: b"" },
  ];
  let kept = encode_shipped_results(shipped_results);
  assert_eq(decode_shipped_results(kept), Some(shipped_results));
  assert_eq(decode_shipped_results(kept.slice(0, kept.len() - 1)), None);
  assert_eq(decode_shipped_results(kept.concat(b"x")), None);
  assert_eq(decode_shipped_results(b"short"), None)
}
