//! What each test over cases listed, kept under its test's hash and the stamp a verdict is filed
//! under: a table lists the same cases while what it reaches stands, so a run lists again only the
//! tables that moved.

import compiler.store.hash.encoding (hex)
import compiler.unit (file_kept, keep_file)
import std.bin
import std.fs (fs, mem_empty)
import std.hash (blake3)
import std.random (entropy)
import std.time (time)
import store.twin (on_twin)
import tester (Listed, Unlisted, listed_bin)

/// A test over cases a run asks for, by its place among the program's tests and its hash.
pub type Asked = { test: Int, hash: Bytes }

fn key_of(stamp: Bytes, hash: Bytes) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all([
        b"ply.listing.1\x00",
        hex(bin::shape_digest(bin::list_bin(listed_bin()))),
        b"\x00",
        stamp,
        b"\x00",
        hash,
      ]),
    ),
  )

/// Each of `asked` a run kept the listing of under `stamp`, by its place.
pub fn kept<[r]>(
  dir: String,
  stamp: Bytes,
  asked: List<Asked>,
) -> Map<Int, List<Listed>> / {fs.read[r], fs.write[r], time.now_ms, abort.raise} =
  asked.fold(Map::new(), |acc: Map<Int, List<Listed>>, a: Asked|
    match file_kept[r](dir, key_of(stamp, a.hash)) {
      None -> acc,
      Some(bytes) -> match bin::decode(bytes, bin::list_bin(listed_bin())) {
        Ok(cases) -> acc.insert(a.test, cases),
        Err(_) -> acc,
      },
    })

/// Keeps each listing of `asked` that `listed` holds; one that could not be listed is asked again.
pub fn keep<[r]>(
  dir: String,
  stamp: Bytes,
  asked: List<Asked>,
  listed: Map<Int, Result<List<Listed>, Unlisted>>,
) -> Unit / {fs.write[r], entropy.next, time.now_ms, abort.raise} =
  asked.fold((), |u: Unit, a: Asked|
    match listed.get(a.test) {
      Some(Ok(cases)) ->
        keep_file[r](dir, key_of(stamp, a.hash), bin::encode(cases, bin::list_bin(listed_bin()))),
      _ -> u,
    })

// --- Tests ------------------------------------------------------------------

test "a listing reads back under the hash and the stamp it was kept under, and under no other" {
  let cases = [{ label: "one", identity: blake3(b"1") }, { label: "two", identity: blake3(b"2") }];
  let read = on_twin(mem_empty(), || {
    keep[mem]("listings", b"stamp", [{ test: 3, hash: b"h" }], Map::new().insert(3, Ok(cases)));
    [
      kept[mem]("listings", b"stamp", [{ test: 5, hash: b"h" }]),
      kept[mem]("listings", b"stamp", [{ test: 5, hash: b"moved" }]),
      kept[mem]("listings", b"another", [{ test: 5, hash: b"h" }]),
    ]
  }).value;
  assert_eq(read, [Map::new().insert(5, cases), Map::new(), Map::new()])
}
