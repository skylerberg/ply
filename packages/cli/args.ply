import std.cli
import std.cli (Parsed, has, value, values_of)
import paths
import paths (ResolvedPath, RootedPath)
import surface
import std.term (Style, ansi, plain, has_colors)
import std.list

pub type Flags = {
  check: Bool,
  json: Bool,
  all: Bool,
  dependencies: Bool,
  types: Bool,
  costs: Bool,
  explain: Bool,
  static_prover: Bool,
  color: Bool,
  digest: Bool,
  returning: Bool,
  identity: Bool,
  no_cache: Bool,
  watch: Bool,
  workspace: Bool,
  verify_dependencies: Bool,
  root: String,
  action: String,
  query: String,
  filters: List<String>,
  entry: Option<String>,
  out: Option<String>,
  diff: Option<String>,
  sign: Option<String>,
  signers: List<String>,
  renames_file: Option<String>,
  words: Bool,
  paths: List<ResolvedPath>,
}

pub const no_flags: Flags =
  {
    check: false,
    json: false,
    all: false,
    dependencies: false,
    types: false,
    costs: false,
    explain: false,
    static_prover: false,
    color: false,
    digest: false,
    returning: false,
    identity: false,
    no_cache: false,
    watch: false,
    workspace: false,
    verify_dependencies: false,
    root: ".",
    action: "",
    query: "",
    filters: [],
    entry: None,
    out: None,
    diff: None,
    sign: None,
    signers: [],
    renames_file: None,
    words: false,
    paths: [],
  }

pub fn style_of(flags: Flags) -> Style = if flags.color { ansi } else { plain }

pub fn matches_filters(
  filters: List<String>,
  modules: Map<String, Bool>,
  module: String,
  key: String,
) -> Bool / {abort.raise} =
  filters.len() == 0
    || filters.any(|f: String|
      if !names_module(f, modules) { key.contains(f) } else {
        let k = Bytes::of_string(key);
        let window = Bytes::of_string(module).len() + Bytes::of_string(f).len();
        k.slice(0, if window < k.len() { window } else { k.len() }).index_of(Bytes::of_string(f))
          != None
      })

pub fn could_match_filters(
  filters: List<String>,
  modules: Map<String, Bool>,
  module: String,
) -> Bool / {abort.raise} =
  filters.len() == 0
    || filters.any(|f: String|
      !names_module(f, modules)
        || {
          let head = Bytes::of_string(module ++ ".");
          let text = Bytes::of_string(f);
          range(0, head.len()).any(|at: Int| {
            let rest = head.slice(at, head.len());
            rest.starts_with(text) || text.starts_with(rest)
          })
        })

pub fn module_names(names: List<Bytes>) -> Map<String, Bool> =
  names.fold(Map::new(), |accumulator: Map<String, Bool>, n: Bytes|
    accumulator.insert(String::of_bytes_lossy(n), true))

fn names_module(f: String, modules: Map<String, Bool>) -> Bool =
  f.contains(".")
    && {
      let parts = f.split(".");
      range(0, parts.len()).any(|from: Int|
        parts.drop(from).fold(
          { run: None, named: false },
          |s: { run: Option<String>, named: Bool }, part: String| {
            let run = match s.run { Some(r) -> r ++ "." ++ part, None -> part };
            { run: Some(run), named: s.named || modules.contains(run) }
          },
        ).named)
    }

fn query_of(command: String, p: Parsed) -> String =
  if command == "doc" || command == "show" || command == "callers" || command == "replace"
      || command == "why" { p.positionals.at_or(0, "") }
  else if command == "explain" { p.positionals.at_or(0, "") }
  else if command == "cache" && p.path.at_or(1, "") == "inspect" { p.positionals.at_or(0, "") }
  else if command == "std" { match value(p, "show") { Some(m) -> m, None -> "" } }
  else { "" }

pub fn from_parsed(
  parsed: Parsed,
  styled: Bool,
  root: String,
  resolved: List<ResolvedPath>,
) -> Flags = {
  let command = parsed.path.at_or(0, "");
  {
    check: has(parsed, "check"),
    json: has(parsed, "json"),
    all: has(parsed, "all"),
    dependencies: has(parsed, "dependencies"),
    types: has(parsed, "types"),
    costs: has(parsed, "costs"),
    explain: has(parsed, "explain"),
    static_prover: has(parsed, "static-prover"),
    color: styled,
    digest: has(parsed, "digest"),
    returning: has(parsed, "answering"),
    identity: has(parsed, "identity"),
    no_cache: has(parsed, "no-cache"),
    watch: has(parsed, "watch"),
    workspace: has(parsed, "workspace"),
    verify_dependencies: has(parsed, "verify-dependencies"),
    root: root,
    action: match parsed.path.at_or(1, "") {
      "" -> if has(parsed, "verify") { "verify" }
      else if has(parsed, "accept") { "accept" }
      else { "" },
      sub -> sub,
    },
    query: query_of(command, parsed),
    filters: values_of(parsed, "filter"),
    entry: value(parsed, "entry"),
    out: match value(parsed, "output") {
      Some(o) -> Some(o),
      None -> if command == "replace" { value(parsed, "with") }
      else if command == "std" { value(parsed, "answers") }
      else { value(parsed, "out") },
    },
    diff: value(parsed, "diff"),
    sign: value(parsed, "sign"),
    signers: values_of(parsed, "require-signer"),
    renames_file: value(parsed, "map"),
    words: has(parsed, "words"),
    paths: resolved,
  }
}

pub fn from_argv(command: String, argv: List<String>) -> Flags / {abort.raise} =
  match cli::parse(
      surface::spec("0.0.0-test"),
      argv.fold([command], |accumulator: List<String>, w: String| accumulator.push(w)),
    ) {
    cli::Run(p) ->
      from_parsed(p, false, ".", p.positionals.map(|spelling: String| paths::at_cwd(spelling))),
    _ -> no_flags,
  }

pub fn root_of(flags: Flags) -> ResolvedPath =
  match flags.paths.at(0) { Some(r) -> r, None -> paths::here() }

test "colour is the launcher's choice, since a program has no terminal to ask" {
  assert(!has_colors(style_of(no_flags)));
  assert(has_colors(style_of({ ..no_flags, color: true })))
}

test "`from_argv` sets the matching `build` field from a long flag, a short flag or a `--flag=value` form" {
  assert_eq(from_argv("build", ["--output=out.plyx"]).out, Some("out.plyx"));
  assert_eq(from_argv("build", ["-o", "out.plyx"]).out, Some("out.plyx"));
  assert_eq(from_argv("build", ["--entry="]).entry, Some(""));
  let named = from_argv("build", ["--entry=app.serve", "--diff=old.plyx"]);
  assert_eq(named.entry, Some("app.serve"));
  assert_eq(named.diff, Some("old.plyx"))
}

test "a query command's first positional is the name it looks up" {
  assert_eq(from_argv("doc", ["std.json"]).query, "std.json");
  assert_eq(from_argv("std", ["--show", "std.hash"]).query, "std.hash");
  assert_eq(from_argv("std", []).query, "");
  assert_eq(from_argv("explain", ["E0001"]).query, "E0001")
}

test "a line the parser rejects leaves the defaults rather than half a set of flags" {
  let rejected = from_argv("build", ["--nope"]);
  assert_eq(rejected.entry, None);
  assert(!rejected.json);
  assert_eq(rejected.paths, [])
}

test "`ply test`'s `--filter` can repeat, and a test that matches any one filter is selected" {
  let filters = from_argv("test", ["--filter", "a.", "--filter", "b.x"]).filters;
  assert_eq(filters, ["a.", "b.x"]);
  let none = Map::new();
  assert(matches_filters(filters, none, "b", "b.xy"));
  assert(!matches_filters(filters, none, "c", "c.x"));
  assert(matches_filters([], none, "c", "c.x"))
}

const named_modules: Map<String, Bool> =
  Map::new().insert("std.ascii85", true).insert("std.ascii85.sub", true).insert("std.base64", true)

test "a filter naming a module selects tests in that module and its submodules, and other filter text selects any test name containing it" {
  let ms = named_modules;
  assert(!matches_filters(["std.ascii85."], ms, "std.base64", "std.base64.std.ascii85. as text"));
  assert(matches_filters(["std.ascii85."], ms, "std.ascii85", "std.ascii85.an encode"));
  assert(matches_filters(["std.ascii85"], ms, "std.ascii85.sub", "std.ascii85.sub.a case"));
  assert(matches_filters(["ascii85.an"], ms, "std.ascii85", "std.ascii85.an encode"));
  assert(matches_filters(["is written z"], ms, "std.base64", "std.base64.0 is written z"));
  assert(matches_filters(["1.5"], ms, "std.base64", "std.base64.1.5 rounds"));
  assert(matches_filters(["base64"], ms, "std.ascii85", "std.ascii85.not base64"))
}

test "a test matches a filter only if its module could match that filter, whatever the test name is" {
  let ms = named_modules;
  let filters = [
    "std.ascii85.",
    "std.ascii85",
    "ascii85.an",
    "std.",
    "sub.a",
    "is written",
    "1.5",
    "std.base64.0",
  ];
  let modules = ["std.ascii85", "std.ascii85.sub", "std.base64", "app"];
  let labels = ["an encode", "std.ascii85. as text", "0 is written z", "a case", "1.5 rounds"];
  assert(
    filters.all(|f: String|
      modules.all(|m: String|
        could_match_filters([f], ms, m)
          || labels.all(|l: String| !matches_filters([f], ms, m, m ++ "." ++ l)))),
    None,
  );
  assert_eq(modules.filter(|m: String| could_match_filters(["std.ascii85."], ms, m)), [
    "std.ascii85",
    "std.ascii85.sub",
  ])
}
