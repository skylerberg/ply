//! The command line as the commands read it. `std.cli` has already refused an unknown flag and
//! parsed every value into its flag, so this module is only the adapter from that parse to the
//! `Flags` record the commands take, and an entry that builds one from a test's argument list.

import std.cli
import std.cli (Parsed, has, value, values_of)
import paths
import paths (Resolved, Rooted)
import surface
import std.term (Style, ansi, plain, styles)
import std.list

pub type Flags = {
  check: Bool,
  json: Bool,
  all: Bool,
  deps: Bool,
  types: Bool,
  costs: Bool,
  explain: Bool,
  /// `ply prove --reach`: ask the static tier about every obligation the run reports on.
  reach: Bool,
  color: Bool,
  digest: Bool,
  /// `ply std --answering`: print what names how this `ply` answers the shipped modules.
  answering: Bool,
  no_cache: Bool,
  watch: Bool,
  /// `--workspace`: the run is repeated for every package the path reaches by a path dependency.
  workspace: Bool,
  /// `--verify-deps`: the load reads every dependency from source and holds what was published to it.
  verify_deps: Bool,
  /// What the load was rooted at, as the launcher resolved it; the paths below are relative to it.
  root: String,
  /// The subcommand a command that has them was parsed with.
  action: String,
  query: String,
  /// Every `--filter` substring, in order; a command whose flag is not repeatable has at most one.
  filters: List<String>,
  /// `None` is the flag left off, which is never what an empty value means.
  entry: Option<String>,
  out: Option<String>,
  /// `ply bootstrap --runtime`: the runtime's library a native `ply` is linked with.
  runtime: Option<String>,
  diff: Option<String>,
  /// `--sign`: the secret key file a build signs what it writes with.
  sign: Option<String>,
  /// `--require-signer`: the public key files an artifact must be signed by one of.
  signers: List<String>,
  paths: List<Resolved>,
}

pub fn no_flags() -> Flags =
  {
    check: false,
    json: false,
    all: false,
    deps: false,
    types: false,
    costs: false,
    explain: false,
    reach: false,
    color: false,
    digest: false,
    answering: false,
    no_cache: false,
    watch: false,
    workspace: false,
    verify_deps: false,
    root: ".",
    action: "",
    query: "",
    filters: [],
    entry: None,
    out: None,
    runtime: None,
    diff: None,
    sign: None,
    signers: [],
    paths: [],
  }

/// The CLI paints with the sixteen colours alone, so whatever more a terminal has changes
/// nothing it writes.
pub fn style_of(flags: Flags) -> Style = if flags.color { ansi() } else { plain() }

/// Whether `--filter` keeps `key`, the key of an item of the module `module`, `modules` holding the
/// name of each module of the load: no filter keeps everything, and any one that keeps it does. A
/// filter keeps a key it is contained in; one that names a module (`names_module`) only where it
/// begins within the key's `<module>.`, so it never matches the text of a label.
pub fn kept(
  filters: List<String>,
  modules: Map<String, Bool>,
  module: String,
  key: String,
) -> Bool / {abort.raise} =
  filters.len() == 0
    || filters.any(|f: String|
      if !names_module(f, modules) { key.contains(f) } else {
        let k = Bytes::of_string(key);
        // Every occurrence that begins within `<module>.` ends within this many bytes.
        let window = Bytes::of_string(module).len() + Bytes::of_string(f).len();
        k.slice(0, if window < k.len() { window } else { k.len() }).index_of(Bytes::of_string(f))
          != None
      })

/// Whether `--filter` could keep a key of an item of `module`, whatever follows the key's
/// `<module>.`: all a run knows of a test over cases before its table lists its labels.
pub fn could_keep(
  filters: List<String>,
  modules: Map<String, Bool>,
  module: String,
) -> Bool / {abort.raise} =
  filters.len() == 0
    || filters.any(|f: String|
      !names_module(f, modules)
        || {
          let head = Bytes::of_string(module ++ ".");
          let text = Bytes::of_string(f);
          range(0, head.len()).any(|at: Int| {
            let rest = head.slice(at, head.len());
            rest.starts_with(text) || text.starts_with(rest)
          })
        })

/// The modules `names` names, as `kept` reads them.
pub fn module_names(names: List<Bytes>) -> Map<String, Bool> =
  names.fold(Map::new(), |acc: Map<String, Bool>, n: Bytes|
    acc.insert(String::of_bytes_lossy(n), true))

/// Whether filter `f` names a module: it holds a `.`, and a whole dotted run of it is the name of
/// one of `modules`.
fn names_module(f: String, modules: Map<String, Bool>) -> Bool =
  f.contains(".")
    && {
      let parts = f.split(".");
      range(0, parts.len()).any(|from: Int|
        parts.drop(from).fold(
          { run: None, named: false },
          |s: { run: Option<String>, named: Bool }, part: String| {
            let run = match s.run { Some(r) -> r ++ "." ++ part, None -> part };
            { run: Some(run), named: s.named || modules.contains(run) }
          },
        ).named)
    }

// --- The adapter: a parsed line as the Flags the commands read -----------------------------

/// What the parser's positionals mean depends on the command: a query command's first is the name
/// it looks up, and every command's path is the last one standing.
fn query_of(command: String, p: Parsed) -> String =
  if command == "doc" || command == "show" || command == "callers" || command == "replace"
      || command == "why" { p.positionals.at_or(0, "") }
  else if command == "explain" { p.positionals.at_or(0, "") }
  else if command == "cache" && p.path.at_or(1, "") == "inspect" { p.positionals.at_or(0, "") }
  else if command == "std" { match value(p, "show") { Some(m) -> m, None -> "" } }
  else { "" }

pub fn from_parsed(parsed: Parsed, styled: Bool, root: String, resolved: List<Resolved>) -> Flags = {
  let command = parsed.path.at_or(0, "");
  {
    check: has(parsed, "check"),
    json: has(parsed, "json"),
    all: has(parsed, "all"),
    deps: has(parsed, "deps"),
    types: has(parsed, "types"),
    costs: has(parsed, "costs"),
    explain: has(parsed, "explain"),
    reach: has(parsed, "reach"),
    color: styled,
    digest: has(parsed, "digest"),
    answering: has(parsed, "answering"),
    no_cache: has(parsed, "no-cache"),
    watch: has(parsed, "watch"),
    workspace: has(parsed, "workspace"),
    verify_deps: has(parsed, "verify-deps"),
    root: root,
    action: match parsed.path.at_or(1, "") {
      "" -> if has(parsed, "verify") { "verify" }
      else if has(parsed, "accept") { "accept" }
      else { "" },
      sub -> sub,
    },
    query: query_of(command, parsed),
    filters: values_of(parsed, "filter"),
    entry: value(parsed, "entry"),
    out: match value(parsed, "output") {
      Some(o) -> Some(o),
      None -> if command == "replace" { value(parsed, "with") }
      else if command == "std" { value(parsed, "answers") }
      else { value(parsed, "out") },
    },
    runtime: value(parsed, "runtime"),
    diff: value(parsed, "diff"),
    sign: value(parsed, "sign"),
    signers: values_of(parsed, "require-signer"),
    paths: resolved,
  }
}

/// The Flags for a test's line, parsed as the launcher parses it: the command word leads, as on
/// the line itself, and every path is spelled under the working directory as given.
pub fn from_argv(command: String, argv: List<String>) -> Flags / {abort.raise} =
  match cli::parse(
      surface::spec("0.0.0-test"),
      argv.fold([command], |acc: List<String>, w: String| acc.push(w)),
    ) {
    cli::Run(p) ->
      from_parsed(p, false, ".", p.positionals.map(|spelling: String| paths::at_cwd(spelling))),
    _ -> no_flags(),
  }

pub fn root_of(flags: Flags) -> Resolved =
  match flags.paths.at(0) { Some(r) -> r, None -> paths::here() }

// --- Tests ------------------------------------------------------------------

test "colour is the launcher's answer, since a program has no terminal to ask" {
  assert(!styles(style_of(no_flags())));
  assert(styles(style_of({ ..no_flags(), color: true })))
}

test "a build's named flags reach the fields they name, however they are written" {
  assert_eq(from_argv("build", ["--output=out.plyx"]).out, Some("out.plyx"));
  assert_eq(from_argv("build", ["-o", "out.plyx"]).out, Some("out.plyx"));
  assert_eq(from_argv("build", ["--entry="]).entry, Some(""));
  let named = from_argv("build", ["--entry=app.serve", "--diff=old.plyx"]);
  assert_eq(named.entry, Some("app.serve"));
  assert_eq(named.diff, Some("old.plyx"))
}

test "a query command's first positional is the name it looks up" {
  assert_eq(from_argv("doc", ["std.json"]).query, "std.json");
  assert_eq(from_argv("std", ["--show", "std.hash"]).query, "std.hash");
  assert_eq(from_argv("std", []).query, "");
  assert_eq(from_argv("explain", ["E0001"]).query, "E0001")
}

test "a line the parser refuses leaves the defaults rather than half a set of flags" {
  let refused = from_argv("build", ["--nope"]);
  assert_eq(refused.entry, None);
  assert(!refused.json);
  assert_eq(refused.paths, [])
}

test "`ply test`'s `--filter` repeats, and a key any one of them matches is kept" {
  let filters = from_argv("test", ["--filter", "a.", "--filter", "b.x"]).filters;
  assert_eq(filters, ["a.", "b.x"]);
  let none = Map::new();
  assert(kept(filters, none, "b", "b.xy"));
  assert(!kept(filters, none, "c", "c.x"));
  assert(kept([], none, "c", "c.x"))
}

/// Modules a filter can name, one inside another.
fn named_modules() -> Map<String, Bool> =
  Map::new().insert("std.ascii85", true).insert("std.ascii85.sub", true).insert("std.base64", true)

test "a filter that names a module keeps keys from that module on, and other text keeps any key holding it" {
  let ms = named_modules();
  // A label holding a module's name is no match for a filter naming that module.
  assert(!kept(["std.ascii85."], ms, "std.base64", "std.base64.std.ascii85. as text"));
  assert(kept(["std.ascii85."], ms, "std.ascii85", "std.ascii85.an encode"));
  assert(kept(["std.ascii85"], ms, "std.ascii85.sub", "std.ascii85.sub.a case"));
  assert(kept(["ascii85.an"], ms, "std.ascii85", "std.ascii85.an encode"));
  // Text naming no module matches a label wherever it is, dots among it.
  assert(kept(["is written z"], ms, "std.base64", "std.base64.0 is written z"));
  assert(kept(["1.5"], ms, "std.base64", "std.base64.1.5 rounds"));
  assert(kept(["base64"], ms, "std.ascii85", "std.ascii85.not base64"))
}

test "a filter keeps a key only of a module it could keep, whatever the label" {
  let ms = named_modules();
  let filters = [
    "std.ascii85.",
    "std.ascii85",
    "ascii85.an",
    "std.",
    "sub.a",
    "is written",
    "1.5",
    "std.base64.0",
  ];
  let modules = ["std.ascii85", "std.ascii85.sub", "std.base64", "app"];
  let labels = ["an encode", "std.ascii85. as text", "0 is written z", "a case", "1.5 rounds"];
  assert(
    filters.all(|f: String|
      modules.all(|m: String|
        could_keep([f], ms, m) || labels.all(|l: String| !kept([f], ms, m, m ++ "." ++ l)))),
    None,
  );
  // What a run lists for `std.ascii85.`: that module's tables and those beneath it.
  assert_eq(modules.filter(|m: String| could_keep(["std.ascii85."], ms, m)), [
    "std.ascii85",
    "std.ascii85.sub",
  ])
}
