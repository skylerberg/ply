import args (Flags, style_of)
import compiler.unit (shipped, compiler_roots, identity_of, shipped_runtime)
import std.env (env)
import std.hash (blake3)
import library (workspace_file, read, workspace_root, workspace_error)
import report (CommandOutput, ok_code, reported)
import std.fs
import std.fs (fs, mem_of)
import std.json (Null, Str, Bool, Number, object)
import std.pkg (Workspace, Suite, workspace_json, library_of)
import std.list

pub fn identity_output() -> CommandOutput / {shipped.definitions, shipped.runtime, abort.raise} = {
  let key = blake3(
    Bytes::concat_all([
      b"ply bootstrapping 2\0",
      identity_of(shipped.definitions(), compiler_roots),
      b"\0",
      shipped_runtime().identity,
    ]),
  );
  let id = key.hex_of();
  {
    json: object([
      { key: "command", value: Str("work") },
      { key: "ok", value: Bool(true) },
      { key: "identity", value: Str(id) },
    ]),
    lines: [id],
    errs: [],
    code: ok_code,
  }
}

pub fn lines_of(w: Workspace) -> List<String> = {
  let parts = match w.toolchain {
    None -> [],
    Some(t) ->
      [
        "std " ++ t.std,
        "std-tests " ++ t.std_tests,
        "compiler " ++ t.compiler,
        "cli " ++ t.cli,
        "entry " ++ t.entry,
        "cli-tests " ++ t.cli_tests,
        "runtime " ++ t.runtime,
        "library " ++ library_of(t),
      ],
  };
  parts.concat(w.packages.map(|p: String| "package " ++ p)).concat(
    w.suites.flat_map(|s: Suite|
      if s.proved { ["suite " ++ s.dir, "proved " ++ s.dir] } else { ["suite " ++ s.dir] }),
  ).concat(
    w.fixtures.map(|f: String| "fixtures " ++ f),
  )
}

fn work_output(root: String, w: Workspace) -> CommandOutput / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("work") },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code)) },
      { key: "root", value: Str(root) },
      { key: "library", value: match w.toolchain { Some(t) -> Str(library_of(t)), None -> Null } },
      { key: "workspace", value: workspace_json().encode(w) },
    ]),
    lines: lines_of(w),
    errs: [],
    code: ok_code,
  }

pub fn run(
  flags: Flags,
) -> CommandOutput / {fs.resolved_kind[abs], fs.read_file[abs], env.working_directory, abort.raise} = {
  let dir = match flags.paths.at(0) { Some(r) -> r.absolute, None -> env.working_directory() };
  match workspace_root(dir) {
    None ->
      reported(
        style_of(flags),
        "work",
        workspace_error(
          "no `" ++ workspace_file ++ "` in `" ++ dir ++ "` or any directory above it",
          b"no workspace to read",
        ).diagnostics,
        [],
      ),
    Some(root) -> match read(root) {
      Err(u) -> reported(style_of(flags), "work", u.diagnostics, u.places),
      Ok(w) -> work_output(root, w),
    },
  }
}

const workspace_text: Bytes =
  b"import std.pkg (Workspace)\n\nfn workspace() -> Workspace = {\n  packages: [\"lib/store\"],\n  suites: [{ dir: \"examples\", proved: true }, { dir: \"tests/lang\", proved: false }],\n  fixtures: [\"tests/fixtures\"],\n  toolchain: Some({\n    std: \"lib/std\",\n    std_tests: \"tests/std\",\n    compiler: \"lib/compiler\",\n    cli: \"cli\",\n    entry: \"ply.main\",\n    cli_tests: \"tests/cli\",\n    runtime: \"ply-runtime\",\n  }),\n}\n"

test "a workspace listing prints one `role path` line for each entry, including the runtime's library" {
  match fs::on_mem[abs](mem_of([{ path: "repo/ply.work", body: workspace_text }]), ||
      read("/repo")).value {
    Err(_) -> panic("the workspace reads"),
    Ok(w) ->
      assert_eq(lines_of(w), [
        "std lib/std",
        "std-tests tests/std",
        "compiler lib/compiler",
        "cli cli",
        "entry ply.main",
        "cli-tests tests/cli",
        "runtime ply-runtime",
        "library libply_runtime.a",
        "package lib/store",
        "suite examples",
        "proved examples",
        "suite tests/lang",
        "fixtures tests/fixtures",
      ]),
  }
}

test "what names how a `ply` builds moves with its compiler's definitions and its runtime alone" {
  let definitions = |hash: Bytes, rest: Bytes|
    Bytes::concat_all(
      compiler_roots.map(|root: Bytes| Bytes::concat_all([root, b" ", hash, b"\n"])),
    ).concat(
      rest,
    );
  let said = |listed: Bytes, runtime: Bytes|
    handle {
      identity_output().lines
    } with {
      shipped.definitions() -> listed,
      shipped.runtime() -> Bytes::concat_all([b"ply runtime 1\nidentity ", runtime, b"\n"]),
    };
  let first = said(definitions(b"01", b""), b"r");
  assert_eq(said(definitions(b"01", b"explain.run 02\n"), b"r"), first);
  assert(said(definitions(b"03", b""), b"r") != first, None);
  assert(said(definitions(b"01", b""), b"s") != first, None)
}
