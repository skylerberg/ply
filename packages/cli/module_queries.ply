import progress
import compiler.store.memo (fact_inspection)
import progress (progress)
import std.set (Set)
import sources (ProjectFiles)
import std.fs
import std.fs (fs)
import compiler.cc (toolchain)
import compiler.store.memo
import compiler.store.memo (memo, Run, QueryStats, reachable_keys, missing_count, reading,
                            in_session, query_stats)
import compiler.store.memo_files
import compiler.store.packs
import compiler.unit (shipped, pack_frame)
import compiler.front.checking (CheckedModule, PackageFile, LoadInputs, LoadResults, query_load,
                                declaring_in, documented_all, evaluator_of, hashed_all,
                                lookup_input, nothing_derived, rejected_first, registry,
                                check_shipped_modules, shipped_queries, wanted_all, load_inputs_of,
                                package_location_in, module_of)
import compiler.front.checking.world (CheckQuery, CheckQueries, RunEffects, SessionReads,
                                      with_decode_cache, ModuleKey)
import compiler.front.checking.groups (ProgramSummary)
import compiler.front.checking.view
import compiler.front.checking.view (LaterReading)
import compiler.front.checking.world (Modules)
import compiler.front.checking.promises (MeasureEntry, measures_query, module_costs_query)
import compiler.store.handles (fetched)
import measures (proof_queries)
import compiler.emit.costs (Report)
import compiler.load (Derives, derivation_response)
import compiler.front.pages (Pages)
import compiler.front (ShippedWants, embed_inputs_of, shipped_bytes)
import compiler.store.hash.forms (ModuleHashes)
import sources (Project, File, DependencyPackage, Embed, read_module_embed, embed_of, shipped_names,
                shipped_text)
import compiler.check.resolve.tables (Diagnostic)
import std.list
import compiler.expand.embed (EmbedBytesResult, ModuleEmbed, EmbedRequest, request_of_key)

fn own_file(f: File) -> PackageFile = { module: Bytes::of_string(f.module), text: f.text }

fn query_inputs(project: Project) -> LoadInputs / {abort.raise} =
  load_inputs_of(
    {
      root: Bytes::of_string(project.root_key),
      manifest: match project.manifest { None -> None, Some(f) -> Some(f.text) },
      files: project.files.map(own_file),
    },
    project.packages.map(|p: DependencyPackage|
      { root: Bytes::of_string(p.root), manifest: p.manifest, files: p.files.map(own_file) }),
  )

fn read_project_input<| e>(
  w: LoadInputs,
  read: (Int, Bytes, EmbedRequest) -> EmbedBytesResult / {fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise | e},
  kind: Bytes,
  at: Bytes,
) -> Option<Bytes> / {fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise | e} =
  lookup_input(
    w,
    |name: Bytes| shipped_text(name),
    |name: Bytes| shipped_data(name),
    || shipped_names(),
    read,
    |kind: Bytes, at: Bytes| derivation_response(w, kind, at),
    kind,
    at,
  )

pub fn embed_inputs(
  project: Project,
  w: LoadInputs,
  embeds: List<ModuleEmbed>,
) -> Result<Map<Bytes, Bytes>, List<Diagnostic>> / {fs.read_file[shipped], ProjectFiles, abort.raise} =
  embed_inputs_of(embeds, |e: ModuleEmbed|
    match package_location_in(w, e.module) {
      Some(p) -> read_module_embed(project, p.package, p.relative, request_of_key(e.key)),
      None -> shipped_bytes(e.module, e.key, shipped_text, shipped_data),
    })

pub fn own_embeds(
  project: Project,
  w: LoadInputs,
  embeds: List<ModuleEmbed>,
) -> List<Embed> / {abort.raise} =
  embeds.fold([], |accumulator: List<Embed>, e: ModuleEmbed|
    match package_location_in(w, e.module) {
      None -> accumulator,
      Some(p) -> match embed_of(project, p.package, p.relative, request_of_key(e.key), e.read) {
        Some(x) -> accumulator.push(x),
        None -> accumulator,
      },
    })

fn shipped_data(name: Bytes) -> Option<Bytes> / {fs.read_file[shipped]} =
  fs.read_file[shipped](String::of_bytes_lossy(name))

fn running_queries() -> CheckQueries / {fs.read_file[shipped], abort.raise} =
  match ((fs.read_file[shipped]("definitions"), fs.read_file[shipped]("stamps"))) {
    (Some(d), Some(stamps)) -> registry(d, evaluator_of(stamps), proof_queries()),
    _ -> panic("the toolchain ships no `definitions` or no `stamps`"),
  }

pub type Opened<a> = {
  inputs: LoadInputs,
  value: a,
  tallies: List<QueryStats>,
  missing_results: Int,
  damage: Option<String>,
}

type SessionRead<a> = { value: a, tallies: List<QueryStats>, missing_results: Int }

fn opened_from<a>(w: LoadInputs, done: memo_files::StoreOutcome<SessionRead<a>>) -> Opened<a> =
  {
    inputs: w,
    value: done.value.value,
    tallies: done.value.tallies,
    missing_results: done.value.missing_results,
    damage: done.damage,
  }

fn read_session<a>(
  qs: CheckQueries,
  w: LoadInputs,
  work: (LoadInputs) -> a / {SessionReads, fact_inspection.read, abort.raise},
) -> SessionRead<a> / {RunEffects, abort.raise} =
  in_session(qs, |run: Run| {
    let done = reading(qs, run, || work(w));
    {
      run: done.run,
      value: {
        value: done.value,
        tallies: query_stats(done.run),
        missing_results: missing_count(done.run),
      },
    }
  })

pub fn stored_session<a, [r]>(
  dir: String,
  project: Project,
  work: (LoadInputs) -> a / {SessionReads, fact_inspection.read, abort.raise},
) -> Opened<a> / {fs.read[abs], toolchain.read, fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], ProjectFiles, shipped.read_pack, Derives, progress.write, abort.raise} = {
  let qs = running_queries();
  let w = query_inputs(project);
  opened_from(
    w,
    memo_files::with_memo_store[r](
      dir,
      pack_frame,
      shipped_files(),
      |kind: Bytes, at: Bytes|
        read_project_input(
          w,
          |k: Int, m: Bytes, want: EmbedRequest| read_module_embed(project, k, m, want),
          kind,
          at,
        ),
      |query: Bytes| progress.computed(query),
      || with_decode_cache(|| read_session(qs, w, work)),
    ),
  )
}

pub type PromiseFacts = { costs: List<Report>, measures: List<MeasureEntry> }

pub fn promise_facts(
  modules: List<Bytes>,
  costs: Bool,
  measures: Bool,
) -> PromiseFacts / {memo.read, abort.raise} = {
  let keys = modules.map(|m: Bytes| { module: m, shipped: false, tested: false });
  {
    costs: (if costs { keys } else { [] }).map(|k: ModuleKey| fetched(module_costs_query(), k)),
    measures: (if measures { keys } else { [] }).fold(
      [],
      |found: List<MeasureEntry>, k: ModuleKey| found.concat(fetched(measures_query(), k)),
    ),
  }
}

pub type LaterChecks = { reading: LaterReading, facts: PromiseFacts }

pub fn later_checks(
  modules: Modules,
  read: ProgramSummary,
  costs: Bool,
) -> LaterChecks / {memo.read, abort.raise} =
  {
    reading: view::later_reading(modules),
    facts: promise_facts(modules.own.take(modules.root), read.promises || costs, read.measures),
  }

pub fn temporary_session<a>(
  project: Project,
  work: (LoadInputs) -> a / {SessionReads, fact_inspection.read, abort.raise},
) -> Opened<a> / {fs.list_dir[shipped], fs.read_file[shipped], ProjectFiles, shipped.read_pack, Derives, abort.raise} = {
  let qs = running_queries();
  let w = query_inputs(project);
  opened_from(w, {
    value: memo_files::with_store_in_memory(
      fs::mem_empty(),
      pack_frame,
      shipped_files(),
      |kind: Bytes, at: Bytes|
        read_project_input(
          w,
          |k: Int, m: Bytes, want: EmbedRequest| read_module_embed(project, k, m, want),
          kind,
          at,
        ),
      || with_decode_cache(|| read_session(qs, w, work)),
    ).value,
    damage: None,
  })
}

pub fn shipped_results<[r]>(
  store_dir: String,
  shipped: List<Bytes>,
) -> { keys: List<Bytes>, rejected: List<CheckedModule> } / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], Derives, abort.raise} = {
  let qs = running_queries();
  let nowhere = load_inputs_of({ root: b"", manifest: None, files: [] }, []);
  let wanted = shipped_queries.fold(Set::empty(), |accumulator: Set<Bytes>, name: Bytes|
    accumulator.insert(name));
  memo_files::with_memo_store[r](
    store_dir,
    packs::no_pack,
    b"",
    |kind: Bytes, at: Bytes|
      lookup_input(
        nowhere,
        shipped_text,
        shipped_data,
        shipped_names,
        |k: Int, m: Bytes, want: EmbedRequest| Err(b"no file is there"),
        |kind: Bytes, at: Bytes| derivation_response(nowhere, kind, at),
        kind,
        at,
      ),
    |_: Bytes| (),
    ||
      with_decode_cache(||
        in_session(qs, |run: Run| {
          let all = reading(qs, run, || check_shipped_modules(shipped));
          {
            run: all.run,
            value: { keys: reachable_keys(qs, wanted, all.run), rejected: all.value },
          }
        })),
  ).value
}

pub fn write_shipped_pack<[r]>(
  store_dir: String,
  keys: List<Bytes>,
) -> { written: packs::PackFiles, records: Int } / {fs.read[r], fs.read_file[shipped], abort.raise} =
  memo_files::write_pack[r](store_dir, keys, memo::queries_id(running_queries()), shipped_files())

fn shipped_files() -> Bytes / {fs.read_file[shipped]} =
  match fs.read_file[shipped]("digests") { Some(b) -> b, None -> b"" }

fn query_shipped<a>(
  query: () -> a / {memo.read, abort.raise},
) -> a / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} = {
  let qs = running_queries();
  let nowhere = load_inputs_of({ root: b"", manifest: None, files: [] }, []);
  memo_files::with_store_in_memory(
    fs::mem_empty(),
    pack_frame,
    shipped_files(),
    |kind: Bytes, at: Bytes|
      lookup_input(
        nowhere,
        shipped_text,
        shipped_data,
        shipped_names,
        |k: Int, m: Bytes, want: EmbedRequest| Err(b"no file is there"),
        nothing_derived,
        kind,
        at,
      ),
    || with_decode_cache(|| in_session(qs, |run: Run| reading(qs, run, query))),
  ).value
}

pub fn shipped_doc_pages(
  modules: List<Bytes>,
) -> List<Pages> / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} =
  query_shipped(||
    documented_all(modules.map(|m: Bytes| { module: m, shipped: true, tested: false })))

pub fn shipped_declarations() -> Map<Bytes, List<Bytes>> / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} =
  query_shipped(|| declaring_in(b"std"))

pub fn current_hashes() -> Set<Bytes> / {fs.read_file[shipped], abort.raise} =
  running_queries().named.fold(Set::empty(), |accumulator: Set<Bytes>, _: Bytes, q: CheckQuery|
    accumulator.insert(q.hash))
