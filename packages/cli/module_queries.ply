//! A project's modules answered through the memo store: the world the compiler's queries read, as
//! the walk and the toolchain's shipped modules hold it.

import std.fs (fs)
import compiler.store.memo
import compiler.store.memo (Dependency, Run, QueryStats, memo_store, driver_dependencies, digest_of,
                            reachable_keys, record_output, missing_count, cached_output, start_run,
                            query_stats)
import compiler.store.memo_files
import compiler.store.packs
import compiler.unit (shipped, pack_frame)
import compiler.front.checking (CheckedModule, OwnFile, OwnPackage, LoadInputs, query_load,
                                declaring_in, documented_all, evaluator_of, hashed_all,
                                lookup_input, nothing_derived, refused_first, registry, shipped_all,
                                shipped_queries, wanted_all, load_inputs_of, package_location_in)
import compiler.front.checking.world (CheckQuery, RunEffects, ModuleKey, with_decode_cache)
import compiler.load (Derives, encoded_derivation)
import compiler.front.pages (Pages)
import compiler.front (ShippedWants, embed_inputs_of, shipped_bytes)
import compiler.store.hash.forms (ModuleHashes)
import sources (Project, File, DepPackage, Embed, read_module_embed, embed_of, shipped_names,
                shipped_text)
import compiler.check.resolve.tables (Diag, diag_bin)
import interfaces
import std.bin
import std.hash (blake3)
import std.zstd
import std.list
import compiler.front.interface (length_prefixed)
import compiler.expand.embed (EmbedBytesResult, ModuleEmbed, EmbedBytes, EmbedFile, EmbedResult,
                              EmbedRequest, request_of_key)

fn own_file(f: File) -> OwnFile = { module: Bytes::of_string(f.module), text: f.text }

/// The world a load of `project` reads.
fn query_inputs(project: Project) -> LoadInputs / {abort.raise} =
  load_inputs_of(
    {
      root: Bytes::of_string(project.root_key),
      manifest: match project.manifest { None -> None, Some(f) -> Some(f.text) },
      files: project.files.map(own_file),
    },
    project.packages.map(|p: DepPackage|
      { root: Bytes::of_string(p.root), manifest: p.manifest, files: p.files.map(own_file) }),
  )

/// The walk, as a place: the path and name of each module it found, in the root package and in
/// each dependency with where that dependency lies, and what it refused. A command's result reads
/// it beside its modules' texts.
fn walk_kind() -> Bytes = b"walk"

/// What each registry dependency's slot holds, as a place.
fn published_kind() -> Bytes = b"published"

fn encoded_walk(project: Project) -> Bytes / {abort.raise} =
  bin::encode(
    {
      files: project.files.map(placed_file),
      packages: project.packages.map(|p: DepPackage|
        { root: p.root, dir: p.dir, files: p.files.map(placed_file) }),
      diags: project.diags,
    },
    walk_record_bin(),
  )

fn placed_file(f: File) -> PlacedFile = { path: f.path, module: f.module }

type PlacedFile = { path: String, module: String }

derive bin for PlacedFile

type WalkedPackage = { root: String, dir: String, files: List<PlacedFile> }

derive bin for WalkedPackage

type WalkRecord = { files: List<PlacedFile>, packages: List<WalkedPackage>, diags: List<Diag> }

derive bin for WalkRecord

/// What each registry dependency's slot of `project` holds.
fn encoded_slots(project: Project) -> Bytes / {fs.read_file[abs], abort.raise} =
  bin::encode(
    interfaces::slots(project.root_key, project.packages.map(|p: DepPackage| p.root)).map(
      |slot: String| { slot: slot, held: interfaces::read_slot_interface(slot) },
    ),
    bin::list_bin(slot_contents_bin()),
  )

type SlotContents = { slot: String, held: Option<Bytes> }

derive bin for SlotContents

/// What the world of `project`, whose queries read `w`, holds at `at` as `kind` reads it, what a
/// module of it embeds read through `read`, and what each library deriver it names answers.
fn read_project_input<| e>(
  project: Project,
  w: LoadInputs,
  read: (Int, Bytes, EmbedRequest) -> EmbedBytesResult / {fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise | e},
  kind: Bytes,
  at: Bytes,
) -> Option<Bytes> / {fs.list_dir[shipped], fs.read_file[shipped], fs.read_file[abs], Derives, abort.raise | e} =
  if kind == walk_kind() { Some(encoded_walk(project)) }
  else if kind == published_kind() { Some(encoded_slots(project)) } else {
    lookup_input(
      w,
      |name: Bytes| shipped_text(name),
      |name: Bytes| shipped_data(name),
      || shipped_names(),
      read,
      |ask: Bytes| encoded_derivation(w, ask),
      kind,
      at,
    )
  }

/// The files a load reads of what its own modules embed, as it reads them.
effect embed_reads {
  write record(files: List<EmbedBytes>) -> Unit
}

/// What module `module` of package `k` of `project` embeds as `want` asks, read beside its file and
/// told to `embed_reads`.
fn read_and_record_embed(
  project: Project,
  k: Int,
  module: Bytes,
  want: EmbedRequest,
) -> EmbedBytesResult / {embed_reads.record, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} = {
  let read = read_module_embed(project, k, module, want);
  match read { Ok(files) -> embed_reads.record(files), Err(_) -> () };
  read
}

/// What `go` answers, beside the bytes of each file it told `embed_reads` it read, by digest.
fn recording_embeds<a | e>(
  go: () -> a / {embed_reads.record, abort.raise | e},
) -> { value: a, seen: Map<Bytes, Bytes> } / {abort.raise | e} =
  handle {
    go()
  } with {
    var seen: Map<Bytes, Bytes> = Map::new(),
    embed_reads.record(files) -> {
      seen = files.fold(seen, |m: Map<Bytes, Bytes>, f: EmbedBytes|
        m.insert(blake3(f.bytes), f.bytes));
    },
    return v -> { value: v, seen: seen },
  }

/// The files `read` names, as `seen` holds them by digest: none where it lacks one of them.
fn seen_files(seen: Map<Bytes, Bytes>, read: EmbedResult) -> Option<List<EmbedBytes>> =
  match read {
    Err(_) -> None,
    Ok(files) ->
      files.fold(Some([]), |acc: Option<List<EmbedBytes>>, f: EmbedFile|
        match ((acc, seen.get(f.digest))) {
          (Some(xs), Some(b)) -> Some(xs.push({ name: f.name, bytes: b })),
          _ -> None,
        }),
  }

/// The bytes of each file `answers` say the load's modules embed, by digest: as the run read it where
/// `seen` holds it, else read again beside its module's file, or off the binary for a shipped module.
/// `Err` refuses one that reads otherwise now.
fn embedded_inputs(
  project: Project,
  w: LoadInputs,
  answers: List<CheckedModule>,
  seen: Map<Bytes, Bytes>,
) -> Result<Map<Bytes, Bytes>, List<Diag>> / {fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  embed_inputs_of(
    answers.fold([], |acc: List<ModuleEmbed>, a: CheckedModule|
      acc.concat(a.result.shape.embeds.map(|e: ModuleEmbed| { ..e, module: a.module }))),
    |e: ModuleEmbed|
      match package_location_in(w, e.module) {
        Some(p) -> match seen_files(seen, e.read) {
          Some(files) -> Ok(files),
          None -> read_module_embed(project, p.package, p.relative, request_of_key(e.key)),
        },
        None -> shipped_bytes(e.module, e.key, shipped_text, shipped_data),
      },
  )

/// What `answers` say the load's own modules embed, each beside its module's file.
fn own_embeds(
  project: Project,
  w: LoadInputs,
  answers: List<CheckedModule>,
) -> List<Embed> / {abort.raise} =
  answers.fold([], |acc: List<Embed>, a: CheckedModule|
    match package_location_in(w, a.module) {
      None -> acc,
      Some(p) ->
        a.result.shape.embeds.fold(acc, |es: List<Embed>, e: ModuleEmbed|
          match embed_of(project, p.package, p.relative, request_of_key(e.key), e.read) {
            Some(x) -> es.push(x),
            None -> es,
          }),
    })

fn shipped_data(name: Bytes) -> Option<Bytes> / {fs.read_file[shipped]} =
  fs.read_file[shipped](String::of_bytes_lossy(name))

/// The queries, each under the hash the program running gives its definition and the evaluator it
/// runs on, which the toolchain ships beside its modules.
fn running_queries() -> Map<Bytes, CheckQuery> / {fs.read_file[shipped], abort.raise} =
  match ((fs.read_file[shipped]("definitions"), fs.read_file[shipped]("stamps"))) {
    (Some(d), Some(stamps)) -> registry(d, evaluator_of(stamps)),
    _ -> panic("the toolchain ships no `definitions` or no `stamps`"),
  }

/// What each module of a load answered, the shipped modules it pulled in the order it pulled them
/// and what each embeds of the shipped modules, what hashing fixed of each where none refuses, the
/// bytes of each file the load embeds by digest, or what refuses one that moved, what the run did of
/// each query to answer them, and how many answers it made again that a standing record named and
/// no store held.
pub type QueryResults = {
  results: List<CheckedModule>,
  pulled: List<Bytes>,
  wants: Map<Bytes, ShippedWants>,
  /// What hashing fixed of each module, the load's own first, where none refuses.
  modules: List<ModuleHashes>,
  embeds: List<Embed>,
  inputs: Result<Map<Bytes, Bytes>, List<Diag>>,
  asked: List<Dependency>,
  /// Each place the run looked at, with the digest it found there.
  looked: List<Dependency>,
  tallies: List<QueryStats>,
  lost: Int,
}

/// What a load with no modules to answer answers.
pub fn nothing() -> QueryResults =
  {
    results: [],
    pulled: [],
    wants: Map::new(),
    modules: [],
    embeds: [],
    inputs: Ok(Map::new()),
    asked: [],
    looked: [],
    tallies: [],
    lost: 0,
  }

type ModuleResults = {
  results: List<CheckedModule>,
  pulled: List<Bytes>,
  wants: Map<Bytes, ShippedWants>,
  modules: List<ModuleHashes>,
  looked: List<Dependency>,
}

/// What `own` and each shipped module they pull answer over `run`, what hashing fixed of each where
/// none refuses, and each place the run looked at to answer them.
fn asked(
  qs: Map<Bytes, CheckQuery>,
  own: List<Bytes>,
  run: Run,
) -> { run: Run, value: ModuleResults } / {RunEffects, abort.raise} = {
  let all = query_load(qs, own, [], false, run);
  let answers = all.value.results;
  let pulled = all.value.pulled;
  let wanted = wanted_all(qs, pulled, false, all.run);
  let fixed = if refused_first(answers).len() > 0 { { run: wanted.run, value: [] } }
  else { hashed_all(qs, own, pulled, false, wanted.run) };
  // A command's result also depends on the walk and the registry slots, read here while it is computed.
  memo_store.external_digest(walk_kind(), b"");
  memo_store.external_digest(published_kind(), b"");
  {
    run: fixed.run,
    value: {
      results: answers,
      pulled: pulled,
      wants: wanted.value,
      modules: fixed.value,
      looked: memo_store.looked(),
    },
  }
}

/// What a load of `project`, whose queries read `w`, answered over `done`, where `seen` holds the
/// bytes of each file the run read of what its modules embed, by digest.
fn queried_of(
  project: Project,
  w: LoadInputs,
  done: { run: Run, value: ModuleResults },
  seen: Map<Bytes, Bytes>,
) -> QueryResults / {fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  {
    results: done.value.results,
    pulled: done.value.pulled,
    wants: done.value.wants,
    modules: done.value.modules,
    embeds: own_embeds(project, w, done.value.results),
    inputs: embedded_inputs(project, w, done.value.results, seen),
    asked: driver_dependencies(done.run),
    looked: done.value.looked,
    tallies: query_stats(done.run),
    lost: missing_count(done.run),
  }

/// What each module of `project`'s own packages answers, and each shipped module they pull, through
/// the memo store in `dir`, with what the toolchain ships answered for its shipped modules beside it.
pub fn query_through_store<[r]>(
  dir: String,
  project: Project,
) -> QueryResults / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} = {
  let qs = running_queries();
  let w = query_inputs(project);
  let ran = recording_embeds(||
    memo_files::with_memo_store[r](
      dir,
      pack_frame,
      shipped_files(),
      |kind: Bytes, at: Bytes|
        read_project_input(
          project,
          w,
          |k: Int, m: Bytes, want: EmbedRequest| read_and_record_embed(project, k, m, want),
          kind,
          at,
        ),
      || with_decode_cache(|| asked(qs, w.own, start_run(qs))),
      commands: [program_digest()],
    ));
  queried_of(project, w, ran.value, ran.seen)
}

/// The `ply` program running and the runtime it runs on: what its definitions hash to and the
/// runtime's stamps, which leave out every shipped definition the program does not reach.
pub fn program_digest() -> Bytes / {fs.read_file[shipped]} =
  blake3(
    Bytes::concat_all([
      length_prefixed(match fs.read_file[shipped]("definitions") { Some(b) -> b, None -> b"" }),
      length_prefixed(match fs.read_file[shipped]("stamps") { Some(b) -> b, None -> b"" }),
    ]),
  )

/// What a command's answer is kept under: what names the `ply` that answered, and `asked`, what names
/// the command and its line.
pub fn command_key(program_digest: Bytes, asked: Bytes) -> Bytes =
  blake3(Bytes::concat_all([b"ply command answer\x00", program_digest, b"\x00", blake3(asked)]))

/// The command result stored under `key` in the memo store in `dir` for a command over `project`,
/// where every place the run that computed it looked at is unchanged. No query runs to find out.
pub fn cached_command<[r]>(
  dir: String,
  project: Project,
  key: Bytes,
) -> Option<Bytes> / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} = {
  let qs = running_queries();
  let w = query_inputs(project);
  memo_files::with_memo_store[r](
    dir,
    pack_frame,
    shipped_files(),
    |kind: Bytes, at: Bytes|
      read_project_input(
        project,
        w,
        |k: Int, m: Bytes, want: EmbedRequest| read_module_embed(project, k, m, want),
        kind,
        at,
      ),
    || cached_output(qs, key),
    commands: [program_digest()],
  )
}

/// `output` stored under `key` in the memo store in `dir` as the result of a command over `project`
/// by the `ply` `program_digest` names. It depends on `asked`, what the command's load asked, and is
/// reused while every place of `looked` is unchanged: what the run that computed it looked at, the
/// walk and each registry slot among them. Whether the store holds it now.
pub fn cache_command<[r]>(
  dir: String,
  project: Project,
  key: Bytes,
  program_digest: Bytes,
  asked: List<Dependency>,
  looked: List<Dependency>,
  output: Bytes,
) -> Bool / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} = {
  let qs = running_queries();
  let w = query_inputs(project);
  memo_files::with_memo_store[r](
    dir,
    pack_frame,
    shipped_files(),
    |kind: Bytes, at: Bytes|
      read_project_input(
        project,
        w,
        |k: Int, m: Bytes, want: EmbedRequest| read_module_embed(project, k, m, want),
        kind,
        at,
      ),
    || record_output(qs, key, program_digest, asked, looked, output),
    commands: [program_digest],
  );
  // Read back once the run has written what it kept, which a store it cannot write never holds.
  match memo_files::record_at[r](dir, key) {
    Some(rec) -> rec.output == digest_of(Some(output)),
    None -> false,
  }
}

/// The records of what each of `shipped`, the shipped modules, answers to each query a load cannot
/// cheaply answer again, answered through the memo store in `store_dir`: what [`shipped_pack`] packs;
/// beside them, the answer of each shipped module that refuses. The run reads no project.
pub fn shipped_results<[r]>(
  store_dir: String,
  shipped: List<Bytes>,
) -> { keys: List<Bytes>, refused: List<CheckedModule> } / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], Derives, abort.raise} = {
  let qs = running_queries();
  let nowhere = load_inputs_of({ root: b"", manifest: None, files: [] }, []);
  let wanted = shipped_queries().fold(Map::new(), |acc: Map<Bytes, Bool>, name: Bytes|
    match qs.get(name) { Some(q) -> acc.insert(q.hash, true), None -> acc });
  memo_files::with_memo_store[r](
    store_dir,
    packs::no_pack,
    b"",
    |kind: Bytes, at: Bytes|
      lookup_input(
        nowhere,
        shipped_text,
        shipped_data,
        shipped_names,
        |k: Int, m: Bytes, want: EmbedRequest| Err(b"no file is there"),
        |ask: Bytes| encoded_derivation(nowhere, ask),
        kind,
        at,
      ),
    ||
      with_decode_cache(|| {
        let all = shipped_all(qs, shipped, start_run(qs));
        { keys: reachable_keys(qs, wanted, all.run), refused: all.refused }
      }),
  )
}

/// The pack of the records `keys` names in the store `store_dir`, as [`shipped_results`] names them: made
/// under this `ply`'s queries over the shipped files it reads, each frame one Zstandard frame. How
/// many records it holds.
pub fn shipped_pack<[r]>(
  store_dir: String,
  keys: List<Bytes>,
) -> { written: packs::PackFiles, records: Int } / {fs.read[r], fs.read_file[shipped], abort.raise} =
  memo_files::write_pack[r](
    store_dir,
    keys,
    |b: Bytes| zstd::compress(b, zstd::Fast),
    memo::queries_id(running_queries()),
    shipped_files(),
  )

/// The shipped files this run reads, as the binary lists them (`digests`): a packed record stands as
/// it is only for the very files it was answered over.
fn shipped_files() -> Bytes / {fs.read_file[shipped]} =
  match fs.read_file[shipped]("digests") { Some(b) -> b, None -> b"" }

/// The store a toolchain's own shipped modules are answered through, beside the stage of reused
/// answers `reused` names: a bootstrap's builder checks `ply` through it and `ply std --answers`
/// answers every shipped module through it, so what one answered the other takes, and so does a
/// later bootstrap, whichever `ply` answers.
pub fn shipped_store_dir(reused: String) -> String / {abort.raise} = {
  let cut = range(0, reused.len()).fold(0 - 1, |acc: Int, i: Int|
    if reused.slice(i, i + 1) == "/" { i } else { acc });
  if cut < 0 { "memo-std" } else { reused.slice(0, cut) ++ "/memo-std" }
}

/// [`query_through_store`] with no store of the project's: what the toolchain ships answered for the shipped
/// modules is read, the rest is answered afresh, and nothing is kept.
pub fn query_uncached(
  project: Project,
) -> QueryResults / {fs.list_dir[shipped], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} = {
  let qs = running_queries();
  let w = query_inputs(project);
  let ran = recording_embeds(||
    memo::with_temporary_store(
      pack_frame,
      shipped_files(),
      |kind: Bytes, at: Bytes|
        lookup_input(
          w,
          shipped_text,
          shipped_data,
          shipped_names,
          |k: Int, m: Bytes, want: EmbedRequest| read_and_record_embed(project, k, m, want),
          |ask: Bytes| encoded_derivation(w, ask),
          kind,
          at,
        ),
      || with_decode_cache(|| asked(qs, w.own, start_run(qs))),
    ));
  queried_of(project, w, ran.value, ran.seen)
}

/// What each of `asked`, modules of a load of `project`, documents, through the memo store in `dir`
/// with what the toolchain ships answered beside it.
pub fn doc_pages<[r]>(
  dir: String,
  project: Project,
  asked: List<ModuleKey>,
) -> List<Pages> / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} = {
  let qs = running_queries();
  let w = query_inputs(project);
  memo_files::with_memo_store[r](
    dir,
    pack_frame,
    shipped_files(),
    |kind: Bytes, at: Bytes|
      read_project_input(
        project,
        w,
        |k: Int, m: Bytes, want: EmbedRequest| read_module_embed(project, k, m, want),
        kind,
        at,
      ),
    || with_decode_cache(|| documented_all(qs, asked, start_run(qs)).value),
    commands: [program_digest()],
  )
}

/// What `asked` answers of the shipped modules, as the toolchain's own answers hold them: no
/// project is read and nothing is kept.
fn query_shipped<a>(
  asked: (Map<Bytes, CheckQuery>, Run) -> a / {RunEffects, abort.raise},
) -> a / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} = {
  let qs = running_queries();
  let nowhere = load_inputs_of({ root: b"", manifest: None, files: [] }, []);
  memo::with_temporary_store(
    pack_frame,
    shipped_files(),
    |kind: Bytes, at: Bytes|
      lookup_input(
        nowhere,
        shipped_text,
        shipped_data,
        shipped_names,
        |k: Int, m: Bytes, want: EmbedRequest| Err(b"no file is there"),
        nothing_derived,
        kind,
        at,
      ),
    || with_decode_cache(|| asked(qs, start_run(qs))),
  )
}

/// What each of `modules`, shipped modules, documents.
pub fn shipped_doc_pages(
  modules: List<Bytes>,
) -> List<Pages> / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} =
  query_shipped(|qs: Map<Bytes, CheckQuery>, run: Run|
    documented_all(
      qs,
      modules.map(|m: Bytes| { module: m, shipped: true, tested: false }),
      run,
    ).value)

/// The modules of the standard library that declare each simple name.
pub fn shipped_declarations() -> Map<Bytes, List<Bytes>> / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} =
  query_shipped(|qs: Map<Bytes, CheckQuery>, run: Run| declaring_in(qs, b"std", run).value)

/// The hash each query has now, and what names this `ply`, which a command's answer is kept under: a
/// record of any other will never be asked by again.
pub fn current_hashes() -> Map<Bytes, Bool> / {fs.read_file[shipped], abort.raise} =
  running_queries().fold(
    Map::new().insert(program_digest(), true),
    |acc: Map<Bytes, Bool>, _: Bytes, q: CheckQuery| acc.insert(q.hash, true),
  )
