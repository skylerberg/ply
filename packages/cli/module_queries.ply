import std.bin
import std.fs (fs)
import std.path (strip_root)
import compiler.cc (toolchain)
import compiler.store.memo
import compiler.store.memo (memo, Run, QueryStats, reachable_keys, missing_count, reading,
                            in_session, query_stats)
import compiler.store.memo_files
import compiler.store.packs
import compiler.unit (shipped, pack_frame)
import compiler.front.checking (CheckedModule, PackageFile, OwnPackage, LoadInputs, LoadResults,
                                listed_load, query_load, declaring_in, documented_all, evaluator_of,
                                hashed_all, lookup_input, nothing_derived, rejected_first, registry,
                                check_shipped_modules, shipped_queries, wanted_all, load_inputs_of,
                                package_location_in)
import compiler.front.checking.world (CheckQuery, RunEffects, SessionReads, with_decode_cache,
                                      decoded, module_key_bin)
import compiler.front.checking.groups (GroupKey, ProgramSummary, group_key_bin)
import compiler.front.checking.view
import compiler.front.checking.view (LaterReading, Modules)
import compiler.front.checking.promises (BodyProgram, MeasureEntry, body_program_bin,
                                         body_program_query, measure_entry_bin, measures_query,
                                         module_costs_query)
import compiler.emit.costs (Report, report_bin)
import compiler.load (Derives, derivation_response)
import compiler.front.pages (Pages)
import compiler.front (ShippedWants, embed_inputs_of, shipped_bytes)
import compiler.store.hash.forms (ModuleHashes)
import sources (Project, File, DependencyPackage, Embed, read_module_embed, embed_of, shipped_names,
                shipped_text)
import compiler.check.resolve.tables (Diagnostic)
import std.hash (blake3)
import std.zstd
import std.list
import compiler.expand.embed (EmbedBytesResult, ModuleEmbed, EmbedBytes, EmbedFile, EmbedResult,
                              EmbedRequest, request_of_key)

fn own_file(f: File) -> PackageFile = { module: Bytes::of_string(f.module), text: f.text }

fn query_inputs(project: Project) -> LoadInputs / {abort.raise} =
  load_inputs_of(
    {
      root: Bytes::of_string(project.root_key),
      manifest: match project.manifest { None -> None, Some(f) -> Some(f.text) },
      files: project.files.map(own_file),
    },
    project.packages.map(|p: DependencyPackage|
      { root: Bytes::of_string(p.root), manifest: p.manifest, files: p.files.map(own_file) }),
  )

fn read_project_input<| e>(
  w: LoadInputs,
  read: (Int, Bytes, EmbedRequest) -> EmbedBytesResult / {fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise | e},
  kind: Bytes,
  at: Bytes,
) -> Option<Bytes> / {fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise | e} =
  lookup_input(
    w,
    |name: Bytes| shipped_text(name),
    |name: Bytes| shipped_data(name),
    || shipped_names(),
    read,
    |ask: Bytes| derivation_response(w, ask),
    kind,
    at,
  )

effect embed_reads {
  write record(files: List<EmbedBytes>) -> Unit
}

fn read_and_record_embed(
  project: Project,
  k: Int,
  module: Bytes,
  want: EmbedRequest,
) -> EmbedBytesResult / {embed_reads.record, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} = {
  let read = read_module_embed(project, k, module, want);
  match read { Ok(files) -> embed_reads.record(files), Err(_) -> () };
  read
}

fn recording_embeds<a | e>(
  go: () -> a / {embed_reads.record, abort.raise | e},
) -> { value: a, seen: Map<Bytes, Bytes> } / {abort.raise | e} =
  handle {
    go()
  } with {
    var seen: Map<Bytes, Bytes> = Map::new(),
    embed_reads.record(files) -> {
      seen = files.fold(seen, |m: Map<Bytes, Bytes>, f: EmbedBytes|
        m.insert(blake3(f.bytes), f.bytes));
    },
    return v -> { value: v, seen: seen },
  }

fn seen_files(seen: Map<Bytes, Bytes>, read: EmbedResult) -> Option<List<EmbedBytes>> =
  match read {
    Err(_) -> None,
    Ok(files) ->
      files.fold(Some([]), |accumulator: Option<List<EmbedBytes>>, f: EmbedFile|
        match ((accumulator, seen.get(f.digest))) {
          (Some(xs), Some(b)) -> Some(xs.push({ name: f.name, bytes: b })),
          _ -> None,
        }),
  }

pub fn embed_inputs(
  project: Project,
  w: LoadInputs,
  embeds: List<ModuleEmbed>,
  seen: Map<Bytes, Bytes>,
) -> Result<Map<Bytes, Bytes>, List<Diagnostic>> / {fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  embed_inputs_of(embeds, |e: ModuleEmbed|
    match package_location_in(w, e.module) {
      Some(p) -> match seen_files(seen, e.read) {
        Some(files) -> Ok(files),
        None -> read_module_embed(project, p.package, p.relative, request_of_key(e.key)),
      },
      None -> shipped_bytes(e.module, e.key, shipped_text, shipped_data),
    })

fn embedded_inputs(
  project: Project,
  w: LoadInputs,
  results: List<CheckedModule>,
  seen: Map<Bytes, Bytes>,
) -> Result<Map<Bytes, Bytes>, List<Diagnostic>> / {fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  embed_inputs(
    project,
    w,
    results.fold([], |accumulator: List<ModuleEmbed>, a: CheckedModule|
      accumulator.concat(a.result.shape.embeds.map(|e: ModuleEmbed| { ..e, module: a.module }))),
    seen,
  )

pub fn own_embeds(
  project: Project,
  w: LoadInputs,
  embeds: List<ModuleEmbed>,
) -> List<Embed> / {abort.raise} =
  embeds.fold([], |accumulator: List<Embed>, e: ModuleEmbed|
    match package_location_in(w, e.module) {
      None -> accumulator,
      Some(p) -> match embed_of(project, p.package, p.relative, request_of_key(e.key), e.read) {
        Some(x) -> accumulator.push(x),
        None -> accumulator,
      },
    })

fn shipped_data(name: Bytes) -> Option<Bytes> / {fs.read_file[shipped]} =
  fs.read_file[shipped](String::of_bytes_lossy(name))

fn running_queries() -> Map<Bytes, CheckQuery> / {fs.read_file[shipped], abort.raise} =
  match ((fs.read_file[shipped]("definitions"), fs.read_file[shipped]("stamps"))) {
    (Some(d), Some(stamps)) -> registry(d, evaluator_of(stamps)),
    _ -> panic("the toolchain ships no `definitions` or no `stamps`"),
  }

pub type QueryResults = {
  results: List<CheckedModule>,
  pulled: List<Bytes>,
  wants: Map<Bytes, ShippedWants>,
  modules: List<ModuleHashes>,
  embeds: List<Embed>,
  inputs: Result<Map<Bytes, Bytes>, List<Diagnostic>>,
  tallies: List<QueryStats>,
  missing_results: Int,
}

pub const nothing: QueryResults =
  {
    results: [],
    pulled: [],
    wants: Map::new(),
    modules: [],
    embeds: [],
    inputs: Ok(Map::new()),
    tallies: [],
    missing_results: 0,
  }

pub type ModuleResults = {
  results: List<CheckedModule>,
  pulled: List<Bytes>,
  shipped_wants: Map<Bytes, ShippedWants>,
  modules: List<ModuleHashes>,
}

fn results_over(own: List<Bytes>, all: LoadResults) -> ModuleResults / {memo.read, abort.raise} =
  {
    results: all.results,
    pulled: all.pulled,
    shipped_wants: wanted_all(all.pulled, false),
    modules: if rejected_first(all.results).len() > 0 { [] }
    else { hashed_all(own, all.pulled, false) },
  }

pub fn module_results(own: List<Bytes>) -> ModuleResults / {memo.read, abort.raise} =
  results_over(own, query_load(own, [], false))

pub fn listed_results(own: List<Bytes>) -> ModuleResults / {memo.read, abort.raise} =
  results_over(own, listed_load(own, [], false))

pub type Opened<a> = {
  inputs: LoadInputs,
  value: a,
  seen: Map<Bytes, Bytes>,
  tallies: List<QueryStats>,
  missing_results: Int,
}

fn opened_from<a>(
  w: LoadInputs,
  done: { value: { value: a, tallies: List<QueryStats>, missing_results: Int }, seen: Map<Bytes, Bytes> },
) -> Opened<a> =
  {
    inputs: w,
    value: done.value.value,
    seen: done.seen,
    tallies: done.value.tallies,
    missing_results: done.value.missing_results,
  }

fn read_session<a>(
  qs: Map<Bytes, CheckQuery>,
  w: LoadInputs,
  work: (LoadInputs) -> a / {SessionReads, abort.raise},
) -> { value: a, tallies: List<QueryStats>, missing_results: Int } / {RunEffects, abort.raise} =
  in_session(qs, |run: Run| {
    let done = reading(qs, run, || work(w));
    {
      run: done.run,
      value: {
        value: done.value,
        tallies: query_stats(done.run),
        missing_results: missing_count(done.run),
      },
    }
  })

pub fn stored_session<a, [r]>(
  dir: String,
  project: Project,
  work: (LoadInputs) -> a / {SessionReads, abort.raise},
) -> Opened<a> / {fs.read[abs], toolchain.read, fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} = {
  let qs = running_queries();
  let w = query_inputs(project);
  opened_from(
    w,
    recording_embeds(||
      memo_files::with_memo_store[r](
        dir,
        pack_frame,
        shipped_files(),
        |kind: Bytes, at: Bytes|
          read_project_input(
            w,
            |k: Int, m: Bytes, want: EmbedRequest| read_and_record_embed(project, k, m, want),
            kind,
            at,
          ),
        || with_decode_cache(|| read_session(qs, w, work)),
      )),
  )
}

pub type PromiseFacts = { costs: List<Report>, measures: List<MeasureEntry> }

pub fn promise_facts(
  modules: List<Bytes>,
  costs: Bool,
  measures: Bool,
) -> PromiseFacts / {memo.read, abort.raise} = {
  let inputs = modules.map(|m: Bytes|
    bin::encode({ module: m, shipped: false, tested: false }, module_key_bin()));
  {
    costs: (if costs { inputs } else { [] }).map(|i: Bytes|
      decoded(memo.fetch(module_costs_query, i), report_bin(), "a module's costs")),
    measures: (if measures { inputs } else { [] }).fold(
      [],
      |found: List<MeasureEntry>, i: Bytes|
        found.concat(
          decoded(
            memo.fetch(measures_query, i),
            bin::list_bin(measure_entry_bin()),
            "a module's measures",
          ),
        ),
    ),
  }
}

pub type LaterChecks = { reading: LaterReading, facts: PromiseFacts }

pub fn later_checks(
  modules: Modules,
  read: ProgramSummary,
  costs: Bool,
) -> LaterChecks / {memo.read, abort.raise} =
  {
    reading: view::later_reading(modules),
    facts: promise_facts(modules.own.take(modules.root), read.promises || costs, read.measures),
  }

pub fn body_programs(units: List<GroupKey>) -> List<BodyProgram> / {memo.read, abort.raise} =
  units.map(|u: GroupKey|
    decoded(
      memo.fetch(body_program_query, bin::encode(u, group_key_bin())),
      body_program_bin(),
      "a body program",
    ))

pub fn temporary_session<a>(
  project: Project,
  work: (LoadInputs) -> a / {SessionReads, abort.raise},
) -> Opened<a> / {fs.list_dir[shipped], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} = {
  let qs = running_queries();
  let w = query_inputs(project);
  opened_from(
    w,
    recording_embeds(||
      memo::with_temporary_store(
        pack_frame,
        shipped_files(),
        |kind: Bytes, at: Bytes|
          read_project_input(
            w,
            |k: Int, m: Bytes, want: EmbedRequest| read_and_record_embed(project, k, m, want),
            kind,
            at,
          ),
        || with_decode_cache(|| read_session(qs, w, work)),
      )),
  )
}

pub fn results_of(
  project: Project,
  opened: Opened<ModuleResults>,
) -> QueryResults / {fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  {
    results: opened.value.results,
    pulled: opened.value.pulled,
    wants: opened.value.shipped_wants,
    modules: opened.value.modules,
    embeds: own_embeds(
      project,
      opened.inputs,
      opened.value.results.fold([], |accumulator: List<ModuleEmbed>, a: CheckedModule|
        accumulator.concat(a.result.shape.embeds.map(|e: ModuleEmbed| { ..e, module: a.module }))),
    ),
    inputs: embedded_inputs(project, opened.inputs, opened.value.results, opened.seen),
    tallies: opened.tallies,
    missing_results: opened.missing_results,
  }

pub fn shipped_results<[r]>(
  store_dir: String,
  shipped: List<Bytes>,
) -> { keys: List<Bytes>, rejected: List<CheckedModule> } / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], Derives, abort.raise} = {
  let qs = running_queries();
  let nowhere = load_inputs_of({ root: b"", manifest: None, files: [] }, []);
  let wanted = shipped_queries.fold(Map::new(), |accumulator: Map<Bytes, Bool>, name: Bytes|
    accumulator.insert(name, true));
  memo_files::with_memo_store[r](
    store_dir,
    packs::no_pack,
    b"",
    |kind: Bytes, at: Bytes|
      lookup_input(
        nowhere,
        shipped_text,
        shipped_data,
        shipped_names,
        |k: Int, m: Bytes, want: EmbedRequest| Err(b"no file is there"),
        |ask: Bytes| derivation_response(nowhere, ask),
        kind,
        at,
      ),
    ||
      with_decode_cache(||
        in_session(qs, |run: Run| {
          let all = reading(qs, run, || check_shipped_modules(shipped));
          {
            run: all.run,
            value: { keys: reachable_keys(qs, wanted, all.run), rejected: all.value },
          }
        })),
  )
}

pub fn write_shipped_pack<[r]>(
  store_dir: String,
  keys: List<Bytes>,
) -> { written: packs::PackFiles, records: Int } / {fs.read[r], fs.read_file[shipped], abort.raise} =
  memo_files::write_pack[r](
    store_dir,
    keys,
    |b: Bytes| zstd::compress(b, zstd::Fast),
    memo::queries_id(running_queries()),
    shipped_files(),
  )

fn shipped_files() -> Bytes / {fs.read_file[shipped]} =
  match fs.read_file[shipped]("digests") { Some(b) -> b, None -> b"" }

fn query_shipped<a>(
  query: () -> a / {memo.read, abort.raise},
) -> a / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} = {
  let qs = running_queries();
  let nowhere = load_inputs_of({ root: b"", manifest: None, files: [] }, []);
  memo::with_temporary_store(
    pack_frame,
    shipped_files(),
    |kind: Bytes, at: Bytes|
      lookup_input(
        nowhere,
        shipped_text,
        shipped_data,
        shipped_names,
        |k: Int, m: Bytes, want: EmbedRequest| Err(b"no file is there"),
        nothing_derived,
        kind,
        at,
      ),
    || with_decode_cache(|| in_session(qs, |run: Run| reading(qs, run, query))),
  )
}

pub fn shipped_doc_pages(
  modules: List<Bytes>,
) -> List<Pages> / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} =
  query_shipped(||
    documented_all(modules.map(|m: Bytes| { module: m, shipped: true, tested: false })))

pub fn shipped_declarations() -> Map<Bytes, List<Bytes>> / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} =
  query_shipped(|| declaring_in(b"std"))

pub fn current_hashes() -> Map<Bytes, Bool> / {fs.read_file[shipped], abort.raise} =
  running_queries().fold(Map::new(), |accumulator: Map<Bytes, Bool>, _: Bytes, q: CheckQuery|
    accumulator.insert(q.hash, true))
