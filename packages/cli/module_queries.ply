import std.bin
import std.fs (fs)
import std.path (strip_root)
import compiler.cc (toolchain)
import compiler.store.memo
import compiler.store.memo (Run, QueryStats, reachable_keys, missing_count, query_output, start_run,
                            query_stats)
import compiler.store.memo_files
import compiler.store.packs
import compiler.unit (shipped, pack_frame)
import compiler.front.checking (CheckedModule, PackageFile, OwnPackage, LoadInputs, query_load,
                                declaring_in, documented_all, evaluator_of, hashed_all,
                                lookup_input, nothing_derived, rejected_first, registry,
                                check_shipped_modules, shipped_queries, wanted_all, load_inputs_of,
                                package_location_in)
import compiler.front.checking.world (CheckQuery, RunEffects, ModuleKey, with_decode_cache, decoded)
import compiler.front.checking.groups (ProgramSummary, declarers_input, program_summary_bin,
                                       program_summary_query, symbol_query)
import compiler.load (Derives, derivation_response)
import compiler.front.pages (Pages)
import compiler.front (ShippedWants, embed_inputs_of, shipped_bytes)
import compiler.store.hash.forms (ModuleHashes)
import sources (Project, File, DependencyPackage, Embed, read_module_embed, embed_of, shipped_names,
                shipped_text)
import compiler.check.resolve.tables (Diagnostic)
import std.hash (blake3)
import std.zstd
import std.list
import compiler.expand.embed (EmbedBytesResult, ModuleEmbed, EmbedBytes, EmbedFile, EmbedResult,
                              EmbedRequest, request_of_key)

fn shared_store() -> String / {toolchain.read, abort.raise} =
  strip_root(toolchain.cache() ++ "/facts")

fn own_file(f: File) -> PackageFile = { module: Bytes::of_string(f.module), text: f.text }

fn query_inputs(project: Project) -> LoadInputs / {abort.raise} =
  load_inputs_of(
    {
      root: Bytes::of_string(project.root_key),
      manifest: match project.manifest { None -> None, Some(f) -> Some(f.text) },
      files: project.files.map(own_file),
    },
    project.packages.map(|p: DependencyPackage|
      { root: Bytes::of_string(p.root), manifest: p.manifest, files: p.files.map(own_file) }),
  )

fn read_project_input<| e>(
  w: LoadInputs,
  read: (Int, Bytes, EmbedRequest) -> EmbedBytesResult / {fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise | e},
  kind: Bytes,
  at: Bytes,
) -> Option<Bytes> / {fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise | e} =
  lookup_input(
    w,
    |name: Bytes| shipped_text(name),
    |name: Bytes| shipped_data(name),
    || shipped_names(),
    read,
    |ask: Bytes| derivation_response(w, ask),
    kind,
    at,
  )

effect embed_reads {
  write record(files: List<EmbedBytes>) -> Unit
}

fn read_and_record_embed(
  project: Project,
  k: Int,
  module: Bytes,
  want: EmbedRequest,
) -> EmbedBytesResult / {embed_reads.record, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} = {
  let read = read_module_embed(project, k, module, want);
  match read { Ok(files) -> embed_reads.record(files), Err(_) -> () };
  read
}

fn recording_embeds<a | e>(
  go: () -> a / {embed_reads.record, abort.raise | e},
) -> { value: a, seen: Map<Bytes, Bytes> } / {abort.raise | e} =
  handle {
    go()
  } with {
    var seen: Map<Bytes, Bytes> = Map::new(),
    embed_reads.record(files) -> {
      seen = files.fold(seen, |m: Map<Bytes, Bytes>, f: EmbedBytes|
        m.insert(blake3(f.bytes), f.bytes));
    },
    return v -> { value: v, seen: seen },
  }

fn seen_files(seen: Map<Bytes, Bytes>, read: EmbedResult) -> Option<List<EmbedBytes>> =
  match read {
    Err(_) -> None,
    Ok(files) ->
      files.fold(Some([]), |accumulator: Option<List<EmbedBytes>>, f: EmbedFile|
        match ((accumulator, seen.get(f.digest))) {
          (Some(xs), Some(b)) -> Some(xs.push({ name: f.name, bytes: b })),
          _ -> None,
        }),
  }

fn embedded_inputs(
  project: Project,
  w: LoadInputs,
  results: List<CheckedModule>,
  seen: Map<Bytes, Bytes>,
) -> Result<Map<Bytes, Bytes>, List<Diagnostic>> / {fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  embed_inputs_of(
    results.fold([], |accumulator: List<ModuleEmbed>, a: CheckedModule|
      accumulator.concat(a.result.shape.embeds.map(|e: ModuleEmbed| { ..e, module: a.module }))),
    |e: ModuleEmbed|
      match package_location_in(w, e.module) {
        Some(p) -> match seen_files(seen, e.read) {
          Some(files) -> Ok(files),
          None -> read_module_embed(project, p.package, p.relative, request_of_key(e.key)),
        },
        None -> shipped_bytes(e.module, e.key, shipped_text, shipped_data),
      },
  )

fn own_embeds(
  project: Project,
  w: LoadInputs,
  results: List<CheckedModule>,
) -> List<Embed> / {abort.raise} =
  results.fold([], |accumulator: List<Embed>, a: CheckedModule|
    match package_location_in(w, a.module) {
      None -> accumulator,
      Some(p) ->
        a.result.shape.embeds.fold(accumulator, |es: List<Embed>, e: ModuleEmbed|
          match embed_of(project, p.package, p.relative, request_of_key(e.key), e.read) {
            Some(x) -> es.push(x),
            None -> es,
          }),
    })

fn shipped_data(name: Bytes) -> Option<Bytes> / {fs.read_file[shipped]} =
  fs.read_file[shipped](String::of_bytes_lossy(name))

fn running_queries() -> Map<Bytes, CheckQuery> / {fs.read_file[shipped], abort.raise} =
  match ((fs.read_file[shipped]("definitions"), fs.read_file[shipped]("stamps"))) {
    (Some(d), Some(stamps)) -> registry(d, evaluator_of(stamps)),
    _ -> panic("the toolchain ships no `definitions` or no `stamps`"),
  }

pub type QueryResults = {
  results: List<CheckedModule>,
  pulled: List<Bytes>,
  wants: Map<Bytes, ShippedWants>,
  modules: List<ModuleHashes>,
  embeds: List<Embed>,
  inputs: Result<Map<Bytes, Bytes>, List<Diagnostic>>,
  tallies: List<QueryStats>,
  missing_results: Int,
  log_position: Option<Int>,
}

pub fn nothing() -> QueryResults =
  {
    results: [],
    pulled: [],
    wants: Map::new(),
    modules: [],
    embeds: [],
    inputs: Ok(Map::new()),
    tallies: [],
    missing_results: 0,
    log_position: None,
  }

type ModuleResults = {
  results: List<CheckedModule>,
  pulled: List<Bytes>,
  shipped_wants: Map<Bytes, ShippedWants>,
  modules: List<ModuleHashes>,
}

fn query_modules(
  qs: Map<Bytes, CheckQuery>,
  own: List<Bytes>,
  run: Run,
) -> { run: Run, value: ModuleResults } / {RunEffects, abort.raise} = {
  let all = query_load(qs, own, [], false, run);
  let results = all.value.results;
  let pulled = all.value.pulled;
  let wanted = wanted_all(qs, pulled, false, all.run);
  let fixed = if rejected_first(results).len() > 0 { { run: wanted.run, value: [] } }
  else { hashed_all(qs, own, pulled, false, wanted.run) };
  {
    run: fixed.run,
    value: { results: results, pulled: pulled, shipped_wants: wanted.value, modules: fixed.value },
  }
}

fn queried_of(
  project: Project,
  w: LoadInputs,
  done: { run: Run, value: ModuleResults },
  seen: Map<Bytes, Bytes>,
) -> QueryResults / {fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  {
    results: done.value.results,
    pulled: done.value.pulled,
    wants: done.value.shipped_wants,
    modules: done.value.modules,
    embeds: own_embeds(project, w, done.value.results),
    inputs: embedded_inputs(project, w, done.value.results, seen),
    tallies: query_stats(done.run),
    missing_results: missing_count(done.run),
    log_position: None,
  }

pub fn query_through_store<[r]>(
  dir: String,
  project: Project,
) -> QueryResults / {fs.read[abs], fs.write[abs], toolchain.read, fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} = {
  let qs = running_queries();
  let w = query_inputs(project);
  let ran = recording_embeds(||
    memo_files::with_logged_store[r, abs](
      dir,
      shared_store(),
      pack_frame,
      shipped_files(),
      |kind: Bytes, at: Bytes|
        read_project_input(
          w,
          |k: Int, m: Bytes, want: EmbedRequest| read_and_record_embed(project, k, m, want),
          kind,
          at,
        ),
      || with_decode_cache(|| query_modules(qs, w.own, start_run(qs))),
    ));
  { ..queried_of(project, w, ran.value.value, ran.seen), log_position: ran.value.log_position }
}

fn over_project_store<a, [r]>(
  dir: String,
  project: Project,
  work: (Map<Bytes, CheckQuery>, LoadInputs) -> a / {RunEffects, abort.raise},
) -> a / {fs.read[abs], fs.write[abs], toolchain.read, fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} = {
  let qs = running_queries();
  let w = query_inputs(project);
  memo_files::with_memo_store[r, abs](
    dir,
    shared_store(),
    pack_frame,
    shipped_files(),
    |kind: Bytes, at: Bytes|
      read_project_input(
        w,
        |k: Int, m: Bytes, want: EmbedRequest| read_module_embed(project, k, m, want),
        kind,
        at,
      ),
    || with_decode_cache(|| work(qs, w)),
  )
}

pub fn checked_summary<[r]>(
  dir: String,
  project: Project,
) -> ProgramSummary / {fs.read[abs], fs.write[abs], toolchain.read, fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} =
  over_project_store[r](dir, project, |qs: Map<Bytes, CheckQuery>, w: LoadInputs|
    decoded(
      query_output(
        qs,
        start_run(qs),
        program_summary_query(),
        bin::encode(w.own, bin::list_bin(bin::bytes_bin())),
      ).output,
      program_summary_bin(),
      "the program's summary",
    ))

pub fn declarers<[r]>(
  dir: String,
  project: Project,
  name: Bytes,
) -> List<Bytes> / {fs.read[abs], fs.write[abs], toolchain.read, fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} =
  over_project_store[r](dir, project, |qs: Map<Bytes, CheckQuery>, w: LoadInputs|
    decoded(
      query_output(qs, start_run(qs), symbol_query(), declarers_input(name)).output,
      bin::list_bin(bin::bytes_bin()),
      "the modules that declare a name",
    ))

pub fn shipped_results<[r]>(
  store_dir: String,
  shipped: List<Bytes>,
) -> { keys: List<Bytes>, rejected: List<CheckedModule> } / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], Derives, abort.raise} = {
  let qs = running_queries();
  let nowhere = load_inputs_of({ root: b"", manifest: None, files: [] }, []);
  let wanted = shipped_queries().fold(Map::new(), |accumulator: Map<Bytes, Bool>, name: Bytes|
    accumulator.insert(name, true));
  memo_files::with_memo_store[r, r](
    store_dir,
    store_dir ++ "/shared",
    packs::no_pack,
    b"",
    |kind: Bytes, at: Bytes|
      lookup_input(
        nowhere,
        shipped_text,
        shipped_data,
        shipped_names,
        |k: Int, m: Bytes, want: EmbedRequest| Err(b"no file is there"),
        |ask: Bytes| derivation_response(nowhere, ask),
        kind,
        at,
      ),
    ||
      with_decode_cache(|| {
        let all = check_shipped_modules(qs, shipped, start_run(qs));
        { keys: reachable_keys(qs, wanted, all.run), rejected: all.rejected }
      }),
  )
}

pub fn write_shipped_pack<[r]>(
  store_dir: String,
  keys: List<Bytes>,
) -> { written: packs::PackFiles, records: Int } / {fs.read[r], fs.read_file[shipped], abort.raise} =
  memo_files::write_pack[r](
    store_dir,
    store_dir ++ "/shared",
    keys,
    |b: Bytes| zstd::compress(b, zstd::Fast),
    memo::queries_id(running_queries()),
    shipped_files(),
  )

fn shipped_files() -> Bytes / {fs.read_file[shipped]} =
  match fs.read_file[shipped]("digests") { Some(b) -> b, None -> b"" }

pub fn query_uncached(
  project: Project,
) -> QueryResults / {fs.list_dir[shipped], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} = {
  let qs = running_queries();
  let w = query_inputs(project);
  let ran = recording_embeds(||
    memo::with_temporary_store(
      pack_frame,
      shipped_files(),
      |kind: Bytes, at: Bytes|
        read_project_input(
          w,
          |k: Int, m: Bytes, want: EmbedRequest| read_and_record_embed(project, k, m, want),
          kind,
          at,
        ),
      || with_decode_cache(|| query_modules(qs, w.own, start_run(qs))),
    ));
  queried_of(project, w, ran.value, ran.seen)
}

pub fn doc_pages<[r]>(
  dir: String,
  project: Project,
  modules: List<ModuleKey>,
) -> List<Pages> / {fs.read[abs], fs.write[abs], toolchain.read, fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.read_pack, Derives, abort.raise} =
  over_project_store[r](dir, project, |qs: Map<Bytes, CheckQuery>, _: LoadInputs|
    documented_all(qs, modules, start_run(qs)).value)

fn query_shipped<a>(
  query: (Map<Bytes, CheckQuery>, Run) -> a / {RunEffects, abort.raise},
) -> a / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} = {
  let qs = running_queries();
  let nowhere = load_inputs_of({ root: b"", manifest: None, files: [] }, []);
  memo::with_temporary_store(
    pack_frame,
    shipped_files(),
    |kind: Bytes, at: Bytes|
      lookup_input(
        nowhere,
        shipped_text,
        shipped_data,
        shipped_names,
        |k: Int, m: Bytes, want: EmbedRequest| Err(b"no file is there"),
        nothing_derived,
        kind,
        at,
      ),
    || with_decode_cache(|| query(qs, start_run(qs))),
  )
}

pub fn shipped_doc_pages(
  modules: List<Bytes>,
) -> List<Pages> / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} =
  query_shipped(|qs: Map<Bytes, CheckQuery>, run: Run|
    documented_all(
      qs,
      modules.map(|m: Bytes| { module: m, shipped: true, tested: false }),
      run,
    ).value)

pub fn shipped_declarations() -> Map<Bytes, List<Bytes>> / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} =
  query_shipped(|qs: Map<Bytes, CheckQuery>, run: Run| declaring_in(qs, b"std", run).value)

pub fn current_hashes() -> Map<Bytes, Bool> / {fs.read_file[shipped], abort.raise} =
  running_queries().fold(Map::new(), |accumulator: Map<Bytes, Bool>, _: Bytes, q: CheckQuery|
    accumulator.insert(q.hash, true))
