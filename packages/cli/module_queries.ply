import compiler.expand.embed (EmbedBytesResult, ModuleEmbed, EmbedRequest, request_of_key)

fn own_file(f: File) -> PackageFile = { module: Bytes::of_string(f.module), text: f.text }

fn query_inputs(project: Project) -> LoadInputs / {abort.raise} =
  load_inputs_of(
    {
      root: Bytes::of_string(project.root_key),
      manifest: match project.manifest { None -> None, Some(f) -> Some(f.text) },
      files: project.files.map(own_file),
    },
    project.packages.map(|p: DependencyPackage|
      { root: Bytes::of_string(p.root), manifest: p.manifest, files: p.files.map(own_file) }),
  )

fn read_project_input<| e>(
  w: LoadInputs,
  read: (Int, Bytes, EmbedRequest) -> EmbedBytesResult / {fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise | e},
  derived: (Bytes) -> Option<Bytes>,
  kind: Bytes,
  at: Bytes,
) -> Option<Bytes> / {fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise | e} =
  lookup_input(
    w,
    |name: Bytes| shipped_text(name),
    |name: Bytes| shipped_data(name),
    || shipped_names(),
    read,
    derived,
    kind,
    at,
  )

pub fn embed_inputs(
  project: Project,
  w: LoadInputs,
  embeds: List<ModuleEmbed>,
) -> Result<Map<Bytes, Bytes>, List<Diagnostic>> / {fs.read_file[shipped], ProjectFiles, abort.raise} =
  embed_inputs_of(embeds, |e: ModuleEmbed|
    match package_location_in(w, e.module) {
      Some(p) -> read_module_embed(project, p.package, p.relative, request_of_key(e.key)),
      None -> shipped_bytes(e.module, e.key, shipped_text, shipped_data),
    })

pub fn own_embeds(
  project: Project,
  w: LoadInputs,
  embeds: List<ModuleEmbed>,
) -> List<Embed> / {abort.raise} =
  embeds.fold([], |accumulator: List<Embed>, e: ModuleEmbed|
    match package_location_in(w, e.module) {
      None -> accumulator,
      Some(p) -> match embed_of(project, p.package, p.relative, request_of_key(e.key), e.read) {
        Some(x) -> accumulator.push(x),
        None -> accumulator,
      },
    })

pub fn shipped_data(name: Bytes) -> Option<Bytes> / {fs.read_file[shipped]} =
  fs.read_file[shipped](String::of_bytes_lossy(name))

fn running_queries() -> CheckQueries / {fs.read_file[shipped], abort.raise} =
  match ((fs.read_file[shipped]("definitions"), fs.read_file[shipped]("stamps"))) {
    (Some(d), Some(stamps)) -> registry(d, evaluator_of(stamps), proof_queries()),
    _ -> panic("the toolchain ships no `definitions` or no `stamps`"),
  }

pub type Opened<a> = {
  inputs: LoadInputs,
  value: a,
  tallies: List<QueryStats>,
  missing_results: Int,
  problems: List<StoreProblem>,
}

type SessionRead<a> = { value: a, tallies: List<QueryStats>, missing_results: Int }

fn opened_from<a>(w: LoadInputs, done: StoreOutcome<SessionRead<a>>) -> Opened<a> =
  {
    inputs: w,
    value: done.value.value,
    tallies: done.value.tallies,
    missing_results: done.value.missing_results,
    problems: done.problems,
  }

fn read_session<a>(
  qs: CheckQueries,
  w: LoadInputs,
  work: (LoadInputs) -> a / {SessionReads, fact_inspection.read, abort.raise},
) -> SessionRead<a> / {RunEffects, abort.raise} =
  in_session(qs, |run: Run| {
    let done = reading(qs, run, || work(w));
    {
      run: done.run,
      value: {
        value: done.value,
        tallies: query_stats(done.run),
        missing_results: missing_count(done.run),
      },
    }
  })

pub fn stored_session<a>(
  place: DatabasePlace,
  project: Project,
  work: (LoadInputs) -> a / {SessionReads, fact_inspection.read, abort.raise},
) -> Opened<a> / {Databases, toolchain.read, fs.list_dir[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], fs.read_file[shipped], ProjectFiles, shipped.read_pack, Derives, progress.write, abort.raise} = {
  let qs = running_queries();
  let w = query_inputs(project);
  let opening = databases.open(place);
  let look = |derived: (Bytes) -> Option<Bytes>|
    |kind: Bytes, at: Bytes|
      read_project_input(
        w,
        |k: Int, m: Bytes, want: EmbedRequest| read_module_embed(project, k, m, want),
        derived,
        kind,
        at,
      );
  let noted = |query: Bytes| progress.computed(query);
  let session = || with_decode_cache(|| read_session(qs, w, work));
  opened_from(w, match place {
    InWorkingDirectory(_) ->
      load::deriving[cwd](
        opening,
        pack_frame,
        w.own,
        w.texts,
        |derived: (Bytes) -> Option<Bytes>|
          database::with_opened_database[cwd](opening, pack_frame, look(derived), noted, session),
      ),
    AtAbsolutePath(_) ->
      load::deriving[abs](
        opening,
        pack_frame,
        w.own,
        w.texts,
        |derived: (Bytes) -> Option<Bytes>|
          database::with_opened_database[abs](opening, pack_frame, look(derived), noted, session),
      ),
  })
}

pub type PromiseFacts = { costs: List<Report>, measures: List<MeasureEntry> }

pub fn promise_facts(
  modules: List<Bytes>,
  costs: Bool,
  measures: Bool,
) -> PromiseFacts / {memo.read, abort.raise} = {
  let keys = modules.map(|m: Bytes| { module: m, shipped: false, tested: false });
  {
    costs: (if costs { keys } else { [] }).map(|k: ModuleKey| fetch(module_costs_query(), k)),
    measures: (if measures { keys } else { [] }).fold(
      [],
      |found: List<MeasureEntry>, k: ModuleKey| found.concat(fetch(measures_query(), k)),
    ),
  }
}

pub type LaterChecks = { reading: LaterReading, facts: PromiseFacts }

pub fn later_checks(
  modules: Modules,
  read: ProgramSummary,
  costs: Bool,
) -> LaterChecks / {memo.read, abort.raise} =
  {
    reading: view::later_reading(modules),
    facts: promise_facts(modules.own.take(modules.root), read.promises || costs, read.measures),
  }

pub fn temporary_session<a>(
  project: Project,
  work: (LoadInputs) -> a / {SessionReads, fact_inspection.read, abort.raise},
) -> Opened<a> / {fs.list_dir[shipped], fs.read_file[shipped], ProjectFiles, shipped.read_pack, Derives, abort.raise} = {
  let qs = running_queries();
  let w = query_inputs(project);
  let session = || with_decode_cache(|| read_session(qs, w, work));
  opened_from(
    w,
    fs::on_mem[memory](fs::mem_empty(), ||
      database::with_opening[memory](database::in_memory_database_dir, |opening: Opening|
        load::deriving[memory](
          opening,
          pack_frame,
          w.own,
          w.texts,
          |derived: (Bytes) -> Option<Bytes>|
            database::with_opened_database[memory](
              opening,
              pack_frame,
              |kind: Bytes, at: Bytes|
                read_project_input(
                  w,
                  |k: Int, m: Bytes, want: EmbedRequest| read_module_embed(project, k, m, want),
                  derived,
                  kind,
                  at,
                ),
              |_: Bytes| (),
              session,
            ),
        ))).value,
  )
}

pub type ShippedResults = { interfaces: Map<Bytes, Set<Bytes>>, rejected: List<CheckedModule> }

pub fn shipped_results<[r]>(
  opening: Opening,
  modules: List<Bytes>,
) -> StoreOutcome<ShippedResults> / {fs.list_dir[shipped], fs.read[r], fs.write[r], recent_reads.read, recent_reads.write, fs.read_file[shipped], Derives, abort.raise} = {
  let qs = running_queries();
  let nowhere = load_inputs_of({ root: b"", manifest: None, files: [] }, []);
  load::deriving[r](
    opening,
    packs::no_pack,
    modules,
    Map::new(),
    |derived: (Bytes) -> Option<Bytes>|
      database::with_opened_database[r](
        opening,
        packs::no_pack,
        |kind: Bytes, at: Bytes|
          lookup_input(
            nowhere,
            shipped_text,
            shipped_data,
            shipped_names,
            |k: Int, m: Bytes, want: EmbedRequest| Err(b"no file is there"),
            derived,
            kind,
            at,
          ),
        |_: Bytes| (),
        ||
          with_decode_cache(||
            in_session(qs, |run: Run| {
              let all = reading(qs, run, || check_shipped_modules(modules));
              { run: all.run, value: { interfaces: interfaces(qs), rejected: all.value } }
            })),
      ),
  )
}

pub fn write_shipped_pack<[r]>(
  opening: Opening,
  results: ShippedResults,
) -> { written: packs::PackFiles, records: Int } / {fs.read[r], recent_reads.read, recent_reads.write, abort.raise} =
  database::write_pack[r](opening, results.interfaces)

fn query_shipped<a>(
  query: () -> a / {memo.read, abort.raise},
) -> a / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} = {
  let qs = running_queries();
  let nowhere = load_inputs_of({ root: b"", manifest: None, files: [] }, []);
  fs::on_mem[memory](fs::mem_empty(), ||
    database::with_opening[memory](database::in_memory_database_dir, |opening: Opening| {
      let known = match database::read_derivations[memory](opening, pack_frame) {
        Ok(found) -> found,
        Err(_) -> Map::new(),
      };
      database::with_opened_database[memory](
        opening,
        pack_frame,
        |kind: Bytes, at: Bytes|
          lookup_input(
            nowhere,
            shipped_text,
            shipped_data,
            shipped_names,
            |k: Int, m: Bytes, want: EmbedRequest| Err(b"no file is there"),
            |a: Bytes| known.get(a),
            kind,
            at,
          ),
        |_: Bytes| (),
        || with_decode_cache(|| in_session(qs, |run: Run| reading(qs, run, query))),
      ).value
    })).value
}

pub fn shipped_doc_pages(
  modules: List<Bytes>,
) -> List<Pages> / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} =
  query_shipped(||
    documented_all(modules.map(|m: Bytes| { module: m, shipped: true, tested: false })))

pub fn shipped_declarations() -> Map<Bytes, List<Bytes>> / {fs.list_dir[shipped], fs.read_file[shipped], shipped.read_pack, abort.raise} =
  query_shipped(|| declaring_in(b"std"))

pub fn current_hashes() -> Set<Bytes> / {fs.read_file[shipped], abort.raise} =
  running_queries().named.fold(Set::empty(), |accumulator: Set<Bytes>, _: Bytes, q: CheckQuery|
    accumulator.insert(q.hash))
