import compiler.store.hash.encoding (hex)
import compiler.unit (read_cached_file, write_cached_file)
import std.bin
import std.fs (fs, mem_empty)
import std.hash (blake3)
import std.random (entropy)
import std.time (time)
import store.fake (run_in_memory)
import tester (ListedCase, ListingFailure, listed_case_bin)

pub type ListingRequest = { test: Int, hash: Bytes }

fn key_of(stamp: Bytes, hash: Bytes) -> Bytes / {abort.raise} =
  hex(
    blake3(
      Bytes::concat_all([
        b"ply.listing.1\x00",
        hex(bin::shape_digest(bin::list_bin(listed_case_bin()))),
        b"\x00",
        stamp,
        b"\x00",
        hash,
      ]),
    ),
  )

pub fn cached_listings<[r]>(
  dir: String,
  stamp: Bytes,
  listing_requests: List<ListingRequest>,
) -> Map<Int, List<ListedCase>> / {fs.read[r], fs.write[r], time.now_ms, abort.raise} =
  listing_requests.fold(Map::new(), |accumulator: Map<Int, List<ListedCase>>, a: ListingRequest|
    match read_cached_file[r](dir, key_of(stamp, a.hash)) {
      None -> accumulator,
      Some(bytes) -> match bin::decode(bytes, bin::list_bin(listed_case_bin())) {
        Ok(cases) -> accumulator.insert(a.test, cases),
        Err(_) -> accumulator,
      },
    })

pub fn cache_listings<[r]>(
  dir: String,
  stamp: Bytes,
  listing_requests: List<ListingRequest>,
  listed: Map<Int, Result<List<ListedCase>, ListingFailure>>,
) -> Unit / {fs.write[r], entropy.next, time.now_ms, abort.raise} =
  listing_requests.fold((), |u: Unit, a: ListingRequest|
    match listed.get(a.test) {
      Some(Ok(cases)) ->
        write_cached_file[r](
          dir,
          key_of(stamp, a.hash),
          bin::encode(cases, bin::list_bin(listed_case_bin())),
        ),
      _ -> u,
    })

test "`cached_listings` returns a stored list of test cases only when the test hash and the stamp argument equal the ones it was stored with" {
  let cases = [{ label: "one", identity: blake3(b"1") }, { label: "two", identity: blake3(b"2") }];
  let read = run_in_memory(mem_empty(), || {
    cache_listings[mem](
      "listings",
      b"stamp",
      [{ test: 3, hash: b"h" }],
      Map::new().insert(3, Ok(cases)),
    );
    [
      cached_listings[mem]("listings", b"stamp", [{ test: 5, hash: b"h" }]),
      cached_listings[mem]("listings", b"stamp", [{ test: 5, hash: b"moved" }]),
      cached_listings[mem]("listings", b"another", [{ test: 5, hash: b"h" }]),
    ]
  }).value;
  assert_eq(read, [Map::new().insert(5, cases), Map::new(), Map::new()])
}
