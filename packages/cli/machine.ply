pub type TlsCredential = { name: String, cert: String, key: String }
pub type NamedPath = { name: String, path: String }

pub type ConfigOptions = { set: List<String>, files: List<String>, schema: Option<String> }

pub type RunConfiguration = {
  values: List<{ key: String, value: String, secret: Bool }>,
  schema: Option<{ function: String, keys: List<{ name: String, shape: String }> }>,
  opened: Bool,
}

pub const empty_configuration: RunConfiguration = { values: [], schema: None, opened: false }

pub type SimulationOptions = {
  seed: Option<String>,
  mode: String,
  roots: Option<{ from: Int, to: Int }>,
  budget: Option<Int>,
  steps: Option<Int>,
  measure_reduction: Bool,
}
pub type TraceOptions = { sink: String, level: String }

pub type Options = {
  tls: List<TlsCredential>,
  trust: List<String>,
  mtls: List<String>,
  fs: List<NamedPath>,
  exec: List<NamedPath>,
  allow: List<String>,
  config: ConfigOptions,
  trace: TraceOptions,
  drain_ms: Int,
  drain_lead_ms: Int,
  timeout: Int,
  seed: Option<Seed>,
  profile: cc::Profile,
  argv: List<String>,
}

pub const default_options: Options =
  {
    tls: [],
    trust: [],
    mtls: [],
    fs: [],
    exec: [],
    allow: [],
    config: { set: [], files: [], schema: None },
    trace: { sink: "json", level: "info" },
    drain_ms: 30000,
    drain_lead_ms: 0,
    timeout: 0,
    seed: None,
    profile: cc::development(),
    argv: [],
  }

pub effect set MachineAccess = {entering::machine.report, entering::machine.open, entering::machine.bind, entering::machine.hosting, entering::machine.enter, entering::machine.changed_read, entering::machine.unbind, entering::machine.close}

pub const evaluation_limits: entering::Run =
  { ..entering::unbounded, timeout_ms: entered_timeout_ms }

pub fn granted_path(n: NamedPath) -> entering::NamedPath = { name: n.name, path: n.path }

pub type ShutdownMode = | PlatformDefault | ExitOnSignal | DrainOnSignal

pub type Drain = { lead_ms: Int, drain_ms: Int }

pub fn run_grants(
  o: Options,
  config: RunConfiguration,
  stop: ShutdownMode,
  stderr: Bool,
) -> entering::Grants =
  {
    ..entering::no_grants,
    fs: o.fs.map(granted_path),
    exec: o.exec.map(granted_path),
    allow: o.allow,
    argv: Some(o.argv),
    stderr: stderr,
    given: grant_entries(o.tls, o.trust, o.mtls, config).push({
      name: "trace",
      fields: [o.trace.sink, o.trace.level],
    }).concat(match stop {
      PlatformDefault -> [],
      ExitOnSignal -> [{ name: "end", fields: [] }],
      DrainOnSignal ->
        [{ name: "drain", fields: [o.drain_lead_ms.to_string(), o.drain_ms.to_string()] }],
    }),
  }
pub fn grant_entries(
  tls: List<TlsCredential>,
  trust: List<String>,
  mtls: List<String>,
  config: RunConfiguration,
) -> List<entering::GrantEntry> =
  tls.map(|c: TlsCredential| { name: "tls", fields: [c.name, c.cert, c.key] }).concat(
    trust.map(|t: String| { name: "trust", fields: [t] }),
  ).concat(
    mtls.map(|m: String| { name: "mtls", fields: [m] }),
  ).concat(
    config.values.map(|v: { key: String, value: String, secret: Bool }|
      { name: "config", fields: [v.key, v.value, if v.secret { "secret" } else { "plain" }] }),
  ).concat(match config.schema {
    Some(s) ->
      [
        {
          name: "schema",
          fields: s.keys.fold(
            [s.function],
            |accumulator: List<String>, k: { name: String, shape: String }|
              accumulator.push(k.name).push(k.shape),
          ),
        },
      ],
    None -> [],
  }).concat(if config.opened { [{ name: "configured", fields: [] }] } else { [] })

pub fn project_root(path: String) -> String = {
  let parts = path.split("/").filter(|p: String| p != ".");
  let root_parts = if path.ends_with(".ply") {
    range(0, parts.len() - 1).fold([], |accumulator: List<String>, i: Int|
      accumulator.push(parts.at_or(i, "")))
  } else { parts };
  let joined = String::join(root_parts, "/");
  if joined == "" { if path.starts_with("/") { "/" } else { "." } } else { joined }
}

pub fn roots_of(d: Dump) -> Map<Bytes, ModuleSpan> =
  d.emitter_roots.fold(Map::new(), |m: Map<Bytes, ModuleSpan>, r: EmitterRoot|
    m.insert(r.root, r.at))

pub fn arguments_of(values: List<Value>) -> Bytes =
  match value::encode(VList(values)) { Some(b) -> b, None -> b"" }

pub fn is_internal_error(code: Bytes) -> Bool = code == b"E0505" || code == b"E0415"

pub fn is_timed_out(code: Bytes) -> Bool = code == b"W0612"

pub fn locate_failure(
  f: entering::Failure,
  roots: Map<Bytes, ModuleSpan>,
  entry: String,
) -> RuntimeDiagnostic / {abort.raise} = {
  let labels = f.labels.map(|l: entering::Label| {
    let text = Bytes::of_string(l.text);
    match site_of(l.site, roots) {
      Some(at) ->
        { module: at.module, start: at.start, end: at.end, primary: l.primary, text: text },
      None -> { module: no_module, start: 0, end: 0, primary: l.primary, text: text },
    }
  });
  let details = entering::failure_details(f);
  let diagnostic = diagnostic_of(
    severity_word(f.severity),
    f.code,
    f.message,
    labels,
    details.notes,
  );
  let unplaced = entry != "" && labels.all(|l: Label| l.module == no_module);
  {
    diagnostic: if unplaced { with_notes(diagnostic, [unlocated_note(entry)]) } else { diagnostic },
    values: details.values,
  }
}

pub fn unplaced(f: entering::Failure) -> Diagnostic / {abort.raise} =
  shown(locate_failure(f, Map::new(), ""))

pub fn site_of(site: Option<entering::Site>, roots: Map<Bytes, ModuleSpan>) -> Option<ModuleSpan> =
  match site {
    None -> None,
    Some(s) -> match roots.get(Bytes::of_string(s.root)) {
      Some(root) ->
        Some({ module: root.module, start: root.start + s.start, end: root.start + s.end }),
      None -> None,
    },
  }

fn severity_word(s: entering::Severity) -> String =
  match s { entering::Error -> "error", entering::Warning -> "warning", entering::Note -> "note" }

fn unlocated_note(entry: String) -> String =
  "this error was raised by the runtime, not by the program's source code: it happened while `"
    ++ entry
    ++ "` was running, in code the runtime runs on the program's behalf"

pub fn step_of(s: entering::Step, roots: Map<Bytes, ModuleSpan>) -> Step =
  {
    scheduler: s.scheduler,
    task: s.task,
    runnable: s.enabled,
    choice: s.choice,
    accesses: s.accesses.map(|a: entering::Access|
      match a {
        entering::EffectAccess(x) -> EffectAccess(x),
        entering::VariableAccess(x) -> VariableAccess(x),
        entering::ScopedAccess(x) -> ScopedAccess(x),
      }),
    site: {
      definition: s.definition,
      span: match site_of(s.site, roots) {
        Some(at) -> at,
        None -> { module: no_module, start: 0, end: 0 },
      },
    },
    vector_clock: s.stamp,
  }

pub type CallResult = { result: Result<Value, RuntimeDiagnostic>, warnings: List<Diagnostic> }

pub fn machine_call(
  unit: Int,
  roots: Map<Bytes, ModuleSpan>,
  name: String,
  args: List<Value>,
  run: entering::Run,
) -> CallResult / {entering::machine.enter, abort.raise} = {
  let o = entering::machine.enter(unit, name, arguments_of(args), run);
  { result: result_of(o, roots, name), warnings: warnings_of(o, roots) }
}

pub fn result_of(
  o: entering::Outcome,
  roots: Map<Bytes, ModuleSpan>,
  name: String,
) -> Result<Value, RuntimeDiagnostic> / {abort.raise} =
  if o.exit != None { Ok(value::VUnit) } else {
    match o.ended {
      entering::Returned(bytes) -> match value::decode(bytes) {
        Some(v) -> Ok(v),
        None -> Err(internal_error(name, "returned bytes that are not a valid program result")),
      },
      entering::Failed(f) -> Err(locate_failure(f, roots, name)),
      entering::Panicked(message) -> Err(internal_error(name, "panicked: " ++ message)),
      entering::NoRoot ->
        Err(internal_error(name, "is not an entry point of the compiled program it was run on")),
      entering::UnencodableResult(reason) -> Err(internal_error(name, "returned, and " ++ reason)),
    }
  }

pub fn warnings_of(
  o: entering::Outcome,
  roots: Map<Bytes, ModuleSpan>,
) -> List<Diagnostic> / {abort.raise} =
  o.warnings.map(|w: entering::Failure| shown(locate_failure(w, roots, "")))

pub fn unit_load_error(reason: String) -> Diagnostic =
  diagnostic_of("error", "E0450", "the unit could not be loaded: " ++ reason, [], [
    "a unit is compiled against the runtime that opens it; this is Ply's fault",
  ])

pub fn internal_error(name: String, reason: String) -> RuntimeDiagnostic =
  {
    diagnostic: diagnostic_of("error", "E0505", "`" ++ name ++ "` " ++ reason, [], [
      "this is Ply's fault, not the program's",
    ]),
    values: [],
  }

test "`split_into_lanes` splits a list round-robin into the requested number of groups, and `merge_lanes` restores the original order" {
  let xs = range(0, 7);
  assert_eq(split_into_lanes(xs, None), xs.map(|x: Int| [x]));
  assert_eq(split_into_lanes(xs, Some(3)), [[0, 3, 6], [1, 4], [2, 5]]);
  assert_eq(split_into_lanes(xs, Some(1)), [xs]);
  assert_eq(split_into_lanes(xs, Some(0)), [xs]);
  assert_eq(split_into_lanes(range(0, 2), Some(8)), [[0], [1]]);
  assert_eq(split_into_lanes([], Some(4)), []);
  assert_eq(merge_lanes(split_into_lanes(xs, Some(3))), xs);
  assert_eq(merge_lanes(split_into_lanes(xs, None)), xs);
  assert_eq(
    merge_lanes(split_into_lanes(xs, Some(2)).map(|lane: List<Int>| lane.map(|x: Int| x * 10))),
    xs.map(|x: Int| x * 10),
  )
}

test "`sim_plan_of` returns the default simulation plan without flags, a single run for `--seed`, and a limit of one search attempt in random mode" {
  let p = sim_plan_of(no_sim_options);
  assert_eq(p, plan::default_plan);
  let seeded = sim_plan_of({ ..no_sim_options, seed: Some("7:1.0") });
  assert_eq(seeded.mode, plan::Once);
  assert_eq(seeded.roots, [7u64]);
  assert_eq(seeded.path, [1, 0]);
  assert_eq(sim_plan_of({ ..no_sim_options, mode: "random" }).budget, 1)
}

test "`default_options` sets the development profile, no timeout, a 30000 ms drain and the `info` trace level" {
  assert_eq(default_options.profile, cc::development());
  assert_eq(default_options.timeout, 0);
  assert_eq(default_options.drain_ms, 30000);
  assert_eq(default_options.trace.level, "info")
}

test "`run_grants` passes on the capabilities the flags name, and adds grants such as `tls`, `config` and `drain` only when requested" {
  let quiet = run_grants(
    { ..default_options, allow: ["shipped"], argv: ["a"] },
    empty_configuration,
    PlatformDefault,
    false,
  );
  assert_eq(quiet.argv, Some(["a"]));
  assert_eq(quiet.allow, ["shipped"]);
  assert_eq(quiet.given.map(|g: entering::GrantEntry| g.name), ["trace"]);
  let serving = run_grants(
    {
      ..default_options,
      fs: [{ name: "cwd", path: "." }],
      argv: ["a"],
      tls: [{ name: "api", cert: "c.pem", key: "k.pem" }],
      drain_lead_ms: 250,
    },
    { values: [{ key: "port", value: "80", secret: false }], schema: None, opened: true },
    DrainOnSignal,
    false,
  );
  assert_eq(serving.fs, [{ name: "cwd", path: "." }]);
  assert_eq(serving.given.map(|g: entering::GrantEntry| g.name), [
    "tls",
    "config",
    "configured",
    "trace",
    "drain",
  ]);
  assert_eq(serving.given.at(4), Some({ name: "drain", fields: ["250", "30000"] }));
  let starting = run_grants(default_options, empty_configuration, ExitOnSignal, true);
  assert_eq(starting.given.at(1), Some({ name: "end", fields: [] }));
  assert(starting.stderr && !quiet.stderr)
}

test "`--config-schema` sets the configuration schema for both `build` and `run`" {
  assert_eq(config_of(surface::parsed(["build", "--config-schema=m.spec"])).schema, Some("m.spec"));
  assert_eq(
    options_from(surface::parsed(["run", "--config-schema=m.spec"])).config.schema,
    Some("m.spec"),
  )
}
test "`locate_failure` converts label positions relative to a function into module offsets, and adds a note when a label has no position" {
  let roots = Map::new().insert(b"m.f", { module: 0, start: 100, end: 120 });
  let failure: entering::Failure = {
    code: "E0502",
    severity: entering::Error,
    message: "boom",
    labels: [{ site: Some({ root: "m.f", start: 3, end: 7 }), primary: true, text: "here" }],
    notes: [],
    values: [],
  };
  let r = locate_failure(failure, roots, "m.main");
  assert_eq(r.diagnostic.labels, [
    { module: 0, start: 103, end: 107, primary: true, text: b"here" },
  ]);
  assert_eq(r.diagnostic.notes, 0);
  let lost = locate_failure(
    { ..failure, labels: [{ site: None, primary: true, text: "here" }] },
    roots,
    "m.main",
  );
  assert_eq(lost.diagnostic.labels.map(|l: Label| l.module), [no_module]);
  assert_eq(lost.diagnostic.notes, 1)
}

pub type Rejection = {
  diagnostics: List<Diagnostic>,
  places: List<SourceText>,
  artifact: Option<String>,
}

pub type Target = | Project(Program) | Deployed(Artifact)

pub type ProgramFiles = { root: String, files: List<String>, places: List<SourceText> }

pub type Program = {
  root: String,
  files: List<String>,
  source_texts: List<SourceText>,
  mains: List<Main>,
  modules: List<Module>,
}

pub fn program_of(read: ProgramFiles, mains: List<Main>, modules: List<Module>) -> Target =
  Project({
    root: read.root,
    files: read.files,
    source_texts: read.places,
    mains: mains,
    modules: modules,
  })

pub type Artifact = { path: String, digest: String, entry: String, definition_count: Int }

pub type BindingSummary = {
  operations: Int,
  digest: String,
  trace: Option<String>,
  signals: Option<Signals>,
}

pub type Signals = { names: List<String>, drain: Option<Drain> }

pub type StopReport = { signal: Option<String>, listeners: Int, connections: Int, elapsed_ms: Int }

pub type Teardown = { lead_ms: Int, drain_ms: Int, spans_left_open: Int }

pub type Trace = { events: Int, spans: Int, timed_out: Int, flushed: Bool }

derive bin for StopReport
derive bin for Trace

pub type RunOutcome = {
  exit: Option<Int>,
  value: Option<Value>,
  raised: Option<RuntimeDiagnostic>,
  runtime_blocks: Int,
  warnings: List<Diagnostic>,
  stopping: Option<StopReport>,
  teardown: Teardown,
  trace: Option<Trace>,
  handshakes: List<String>,
  hosts: Json,
}

pub fn sim_options_from(p: Parsed) -> SimulationOptions / {abort.raise} =
  {
    seed: value(p, "seed"),
    mode: match value(p, "sim") { Some(v) -> v, None -> "dpor" },
    roots: match value(p, "seed-range") {
      Some(text) -> range_of(text),
      None -> match nat_value(p, "seeds") { Some(n) -> Some({ from: 0, to: n }), None -> None },
    },
    budget: nat_value(p, "sim-budget"),
    steps: nat_value(p, "sim-steps"),
    measure_reduction: has(p, "measure-reduction"),
  }

pub fn sim_plan_of(sim: SimulationOptions) -> plan::Plan / {abort.raise} =
  plan::plan_from_flags({
    seed: match sim.seed { Some(text) -> plan::parse_seed(text), None -> None },
    mode: match plan::parse_mode(sim.mode) { Some(m) -> m, None -> plan::PartialOrderReduction },
    roots: sim.roots,
    budget: sim.budget,
    steps: sim.steps,
  })

pub fn split_into_lanes<a>(xs: List<a>, lanes: Option<Int>) -> List<List<a>> = {
  let n = match lanes { Some(k) -> max(1, min(k, xs.len())), None -> xs.len() };
  range(0, min(n, xs.len())).map(|k: Int|
    range(0, (xs.len() - k + n - 1) / n).fold([], |lane: List<a>, j: Int|
      match xs.at(k + j * n) { Some(x) -> lane.push(x), None -> lane }))
}

pub fn merge_lanes<b>(lanes: List<List<b>>) -> List<b> / {abort.raise} = {
  let n = lanes.len();
  let total = lanes.fold(0, |accumulator: Int, lane: List<b>| accumulator + lane.len());
  range(0, total).fold([], |out: List<b>, i: Int|
    match lanes.at(i % n) {
      Some(lane) -> match lane.at(i / n) { Some(x) -> out.push(x), None -> out },
      None -> out,
    })
}

pub const no_sim_options: SimulationOptions =
  { seed: None, mode: "dpor", roots: None, budget: None, steps: None, measure_reduction: false }

fn flag_value(parsed: Parsed, long: String) -> Option<String> = value(parsed, long)

fn int_of(p: Parsed, long: String, default: Int) -> Int / {abort.raise} =
  match nat_value(p, long) { Some(n) -> n, None -> default }

fn tls_credentials(parsed: Parsed) -> List<TlsCredential> / {abort.raise} =
  values_of(parsed, "tls").map(|text: String|
    match split_pair(text) {
      Some(pair) -> match pair {
        (name, paths) -> match split_once(paths, ",") {
          Some(pp) -> match pp { (cert, key) -> { name: name, cert: cert, key: key } },
          None -> { name: name, cert: "", key: "" },
        },
      },
      None -> { name: "", cert: "", key: "" },
    })

fn named_paths(parsed: Parsed, long: String) -> List<NamedPath> / {abort.raise} =
  values_of(parsed, long).map(|text: String|
    match split_pair(text) {
      Some(pair) -> match pair { (name, path) -> { name: name, path: path } },
      None -> { name: "", path: "" },
    })

fn split_pair(text: String) -> Option<(String, String)> / {abort.raise} =
  match text.split_once("=") { Some(cut) -> Some((cut.head, cut.tail)), None -> None }

fn split_once(text: String, sep: String) -> Option<(String, String)> / {abort.raise} =
  match text.split_once(sep) { Some(cut) -> Some((cut.head, cut.tail)), None -> None }

pub fn config_of(p: Parsed) -> ConfigOptions =
  { set: values_of(p, "set"), files: values_of(p, "config"), schema: value(p, "config-schema") }

pub fn options_from(p: Parsed) -> Options / {abort.raise} =
  {
    ..default_options,
    tls: tls_credentials(p),
    trust: values_of(p, "trust"),
    mtls: values_of(p, "mtls"),
    fs: named_paths(p, "fs"),
    exec: named_paths(p, "exec"),
    allow: values_of(p, "allow"),
    config: config_of(p),
    trace: {
      sink: match value(p, "trace") { Some(s) -> s, None -> default_options.trace.sink },
      level: match value(p, "trace-level") { Some(l) -> l, None -> default_options.trace.level },
    },
    drain_ms: int_of(p, "drain-ms", default_options.drain_ms),
    drain_lead_ms: int_of(p, "drain-lead-ms", default_options.drain_lead_ms),
    timeout: int_of(p, "timeout", default_options.timeout),
    seed: match flag_value(p, "seed") { Some(text) -> plan::parse_seed(text), None -> None },
    profile: surface::profile_of(p),
    argv: p.argv,
  }
