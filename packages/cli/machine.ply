//! What the commands that enter programs share over `std.machine`: every group of §14's flags as
//! one record, the grants and the runs a command makes of them, and a runtime failure placed in the
//! program a front end holds. Which root runs, what it is handed and what its answer means are each
//! command's own.

import std.cli (Parsed, has, parse_nat, value, values_of, nat_value)
import surface
import surface (range_of)
import compiler.cc
import compiler.check.resolve.tables (Diag, Label)
import compiler.unit (const_timeout_ms)
import compiler.front.rows (Dump, EmitterRoot, ModuleSpan)
import compiler.syntax.parsing (no_module)
import diagnostic (Place, Raised, diag_of, noted, shown)
import entry (Main, Module)
import std.bin
import std.json (Json)
import std.list
import std.machine as entering
import std.value (Value, VList)
import std.value
import sim.plan
import sim.plan (Seed)
import sim.recording (Step, AAtom, AVar, AHold)
import std.string

/// What a run binds, and how: every group of §14's flags as a value. The program parses and
/// validates; the grants and runs it makes of them read typed fields. This is the one record every
/// command that enters a program shares; each reads the subset its command takes.
pub type TlsCredential = { name: String, cert: String, key: String }
pub type Named = { name: String, path: String }

pub type ConfigOptions = { set: List<String>, files: List<String>, schema: Option<String> }

/// What a binding answers `config.get` and `config.secret` from, resolved by the program before
/// anything is bound. With a schema, only a key it declares secret reads through `secret`; `schema`
/// is the named function and its keys' names and shapes, which the binding's digest covers.
/// `opened` is whether any source was read, which is when the run discloses its configuration.
pub type Configured = {
  values: List<{ key: String, value: String, secret: Bool }>,
  schema: Option<{ function: String, keys: List<{ name: String, shape: String }> }>,
  opened: Bool,
}

/// What a run no source configured binds.
pub fn unconfigured() -> Configured = { values: [], schema: None, opened: false }

/// The search a simulated test or law runs, as §9's flags say it: every field is in the key of what
/// it proves. `roots` are the seeds searched, from `from` up to but not including `to`.
pub type SimulationOptions = {
  seed: Option<String>,
  mode: String,
  roots: Option<{ from: Int, to: Int }>,
  budget: Option<Int>,
  steps: Option<Int>,
  measure_reduction: Bool,
}
pub type TraceOptions = { sink: String, level: String }

pub type Options = {
  /// `--json`: stdout is the one document's, so the entry's own lines go to stderr.
  json: Bool,
  tls: List<TlsCredential>,
  trust: List<String>,
  /// The `--tls` credentials whose listeners require a client certificate.
  mtls: List<String>,
  fs: List<Named>,
  exec: List<Named>,
  /// The privileged families `--allow` granted the program this run drives, by name.
  allow: List<String>,
  config: ConfigOptions,
  trace: TraceOptions,
  drain_ms: Int,
  drain_lead_ms: Int,
  timeout: Int,
  /// The one interleaving a run's `simulate` regions take.
  seed: Option<Seed>,
  profile: cc::Profile,
  argv: List<String>,
}

/// Every default a command that enters a program takes when its flags say nothing. One record, so
/// a program that is not the CLI, a test harness among them, can enter one without inventing a
/// second copy of the defaults, and the CLI's own parse below spreads over it.
pub fn default_options() -> Options =
  {
    json: false,
    tls: [],
    trust: [],
    mtls: [],
    fs: [],
    exec: [],
    allow: [],
    config: { set: [], files: [], schema: None },
    trace: { sink: "json", level: "info" },
    drain_ms: 30000,
    drain_lead_ms: 0,
    timeout: 0,
    seed: None,
    profile: cc::development(),
    argv: [],
  }

/// Every operation of the capability a command enters programs with.
pub effect set Entering = {entering::machine.open, entering::machine.bind, entering::machine.hosting, entering::machine.enter, entering::machine.moved, entering::machine.unbind, entering::machine.close}

// --- Grants and runs --------------------------------------------------------------

/// How deeply an entry's calls may nest.
pub fn max_calls() -> Int = 10000

/// The run a check enters a definition under before anything runs: bound to no host, and stopped
/// by the clock past `const_timeout_ms`.
pub fn evaluation_run() -> entering::Run =
  { ..entering::unbounded(max_calls()), timeout_ms: const_timeout_ms() }

/// A root or a program a run is lent, as `std.machine` names one.
pub fn lent(n: Named) -> entering::Named = { name: n.name, path: n.path }

/// How a run meets `INT` and `TERM`. `Unheard` installs nothing, so the platform ends the
/// process; `Ends` ends the run's children and exits with the code the signal would have given;
/// `Drains` stops accepting and drains within `--drain-lead-ms` and `--drain-ms`.
pub type Stop = | Unheard | Ends | Drains

/// `--drain-lead-ms` and `--drain-ms`.
pub type Drain = { lead_ms: Int, drain_ms: Int }

/// What `ply run` lends the program it runs: its roots, its programs, its command line, its
/// credentials, its configuration, its sink, the families `--allow` names, and its `stop`.
pub fn run_grants(o: Options, config: Configured, stop: Stop) -> entering::Grants =
  {
    ..entering::no_grants(),
    fs: o.fs.map(lent),
    exec: o.exec.map(lent),
    allow: o.allow,
    argv: Some(o.argv),
    stderr: o.json,
    given: given_of(o.tls, o.trust, o.mtls, config).push({
      name: "trace",
      fields: [o.trace.sink, o.trace.level],
    }).concat(match stop {
      Unheard -> [],
      Ends -> [{ name: "end", fields: [] }],
      Drains -> [{ name: "drain", fields: [o.drain_lead_ms.to_string(), o.drain_ms.to_string()] }],
    }),
  }
/// What the families still served in Rust read of a run: its credentials, the trust it adds to the
/// roots, the listeners that require a client certificate, and its configuration.
pub fn given_of(
  tls: List<TlsCredential>,
  trust: List<String>,
  mtls: List<String>,
  config: Configured,
) -> List<entering::Given> =
  tls.map(|c: TlsCredential| { name: "tls", fields: [c.name, c.cert, c.key] }).concat(
    trust.map(|t: String| { name: "trust", fields: [t] }),
  ).concat(
    mtls.map(|m: String| { name: "mtls", fields: [m] }),
  ).concat(
    config.values.map(|v: { key: String, value: String, secret: Bool }|
      { name: "config", fields: [v.key, v.value, if v.secret { "secret" } else { "plain" }] }),
  ).concat(match config.schema {
    Some(s) ->
      [
        {
          name: "schema",
          fields: s.keys.fold(
            [s.function],
            |acc: List<String>, k: { name: String, shape: String }| acc.push(k.name).push(k.shape),
          ),
        },
      ],
    None -> [],
  }).concat(if config.opened { [{ name: "configured", fields: [] }] } else { [] })

/// The root a load of `path` is rooted at, as a report prints it: a source file's directory, or the
/// path with every `.` component dropped, `.` where nothing is left.
pub fn project_root(path: String) -> String = {
  let parts = path.split("/").filter(|p: String| p != ".");
  let kept = if path.ends_with(".ply") {
    range(0, parts.len() - 1).fold([], |acc: List<String>, i: Int| acc.push(parts.at_or(i, "")))
  } else { parts };
  let joined = String::join(kept, "/");
  if joined == "" { if path.starts_with("/") { "/" } else { "." } } else { joined }
}

/// Where each root a unit of `d` is entered at is written, which a failure's sites are offsets
/// from.
pub fn roots_of(d: Dump) -> Map<Bytes, ModuleSpan> =
  d.emitter_roots.fold(Map::new(), |m: Map<Bytes, ModuleSpan>, r: EmitterRoot|
    m.insert(r.root, r.at))

/// The PLV1 list a root is handed, of `values`.
pub fn arguments_of(values: List<Value>) -> Bytes =
  match value::encode(VList(values)) { Some(b) -> b, None -> b"" }

// --- Failures placed ------------------------------------------------------------------

/// A runtime diagnostic's codes that say Ply failed rather than the program: a test that ends with
/// one is `panicked`, and a claim's point says nothing.
pub fn is_defect(code: Bytes) -> Bool = code == b"E0505" || code == b"E0415"

/// Whether a runtime diagnostic's code says the clock stopped the run, which decides nothing about
/// the program.
pub fn is_abandoned(code: Bytes) -> Bool = code == b"W0612"

/// `f` as a report renders it: each site placed in the module its root is written in, at an offset
/// from where that root's definition starts. A raise with no place says what failed and not what
/// was running, so it names `entry`, where there is one.
pub fn placed(
  f: entering::Failure,
  roots: Map<Bytes, ModuleSpan>,
  entry: String,
) -> Raised / {abort.raise} = {
  let labels = f.labels.map(|l: entering::Label| {
    let text = Bytes::of_string(l.text);
    match site_of(l.site, roots) {
      Some(at) ->
        { module: at.module, start: at.start, end: at.end, primary: l.primary, text: text },
      None -> { module: no_module(), start: 0, end: 0, primary: l.primary, text: text },
    }
  });
  let said = entering::showing(f);
  let diag = diag_of(severity_word(f.severity), f.code, f.message, labels, said.notes);
  let unplaced = entry != "" && labels.all(|l: Label| l.module == no_module());
  { diag: if unplaced { noted(diag, [unplaced_note(entry)]) } else { diag }, values: said.values }
}

/// `f`, which no program wrote, as a report renders it: a binding's refusal among them.
pub fn unplaced(f: entering::Failure) -> Diag / {abort.raise} = shown(placed(f, Map::new(), ""))

/// Where a site lies in the modules: its root's place, and the site's offsets from it.
pub fn site_of(site: Option<entering::Site>, roots: Map<Bytes, ModuleSpan>) -> Option<ModuleSpan> =
  match site {
    None -> None,
    Some(s) -> match roots.get(Bytes::of_string(s.root)) {
      Some(root) ->
        Some({ module: root.module, start: root.start + s.start, end: root.start + s.end }),
      None -> None,
    },
  }

fn severity_word(s: entering::Severity) -> String =
  match s { entering::Error -> "error", entering::Warning -> "warning", entering::Note -> "note" }

fn unplaced_note(entry: String) -> String =
  "this raise has no place in the source: it happened while `" ++ entry
    ++ "` was running, in code the runtime runs on the program's behalf"

/// A scheduling point as `sim` reads it, its site placed as `placed` places a label's.
pub fn step_of(s: entering::Step, roots: Map<Bytes, ModuleSpan>) -> Step =
  {
    region: s.region,
    task: s.task,
    enabled: s.enabled,
    choice: s.choice,
    accesses: s.accesses.map(|a: entering::Access|
      match a {
        entering::AAtom(x) -> AAtom(x),
        entering::AVar(x) -> AVar(x),
        entering::AHold(x) -> AHold(x),
      }),
    site: {
      definition: s.definition,
      span: match site_of(s.site, roots) {
        Some(at) -> at,
        None -> { module: no_module(), start: 0, end: 0 },
      },
    },
    stamp: s.stamp,
  }

/// One call's value, or what it raised, and what the entry ended with.
pub type Called = { answer: Result<Value, Raised>, warnings: List<Diag> }

/// `name` of `unit` called with `args` under `run`: its answer or what it raised, and what the
/// entry ended with.
pub fn called(
  unit: Int,
  roots: Map<Bytes, ModuleSpan>,
  name: String,
  args: List<Value>,
  run: entering::Run,
) -> Called / {entering::machine.enter, abort.raise} = {
  let o = entering::machine.enter(unit, name, arguments_of(args), run);
  { answer: answer_of(o, roots, name), warnings: warnings_of(o, roots) }
}

/// What an entry's outcome says of its answer: the value it answered, or what it raised, Ply's
/// defect where the runtime failed rather than the program. An entry that chose its exit code
/// raised nothing, and answers `()`, as `process.exit` does.
pub fn answer_of(
  o: entering::Outcome,
  roots: Map<Bytes, ModuleSpan>,
  name: String,
) -> Result<Value, Raised> / {abort.raise} =
  if o.exit != None { Ok(value::VUnit) } else {
    match o.ended {
      entering::Answered(bytes) -> match value::decode(bytes) {
        Some(v) -> Ok(v),
        None -> Err(defect(name, "answered bytes that are no value")),
      },
      entering::Failed(f) -> Err(placed(f, roots, name)),
      entering::Panicked(message) -> Err(defect(name, "panicked: " ++ message)),
      entering::NoRoot -> Err(defect(name, "is no root of the unit it was entered on")),
      entering::Unanswerable(why) -> Err(defect(name, "answered, and " ++ why)),
    }
  }

/// What an entry ended with, placed.
pub fn warnings_of(
  o: entering::Outcome,
  roots: Map<Bytes, ModuleSpan>,
) -> List<Diag> / {abort.raise} = o.warnings.map(|w: entering::Failure| shown(placed(w, roots, "")))

/// A unit the runtime could not open, which says why: one compiled against another runtime, among
/// others.
pub fn unloaded(why: String) -> Diag =
  diag_of("error", "E0450", "the unit could not be loaded: " ++ why, [], [
    "a unit is compiled against the runtime that opens it; this is Ply's fault",
  ])

/// Ply failed entering `name`, rather than the program.
pub fn defect(name: String, why: String) -> Raised =
  {
    diag: diag_of("error", "E0505", "`" ++ name ++ "` " ++ why, [], [
      "this is Ply's fault, not the program's",
    ]),
    values: [],
  }

// --- Tests ------------------------------------------------------------------

test "work is dealt into lanes round-robin and comes back in its own order" {
  let xs = range(0, 7);
  assert_eq(dealt(xs, None), xs.map(|x: Int| [x]));
  assert_eq(dealt(xs, Some(3)), [[0, 3, 6], [1, 4], [2, 5]]);
  assert_eq(dealt(xs, Some(1)), [xs]);
  assert_eq(dealt(xs, Some(0)), [xs]);
  assert_eq(dealt(range(0, 2), Some(8)), [[0], [1]]);
  assert_eq(dealt([], Some(4)), []);
  assert_eq(undealt(dealt(xs, Some(3))), xs);
  assert_eq(undealt(dealt(xs, None)), xs);
  assert_eq(
    undealt(dealt(xs, Some(2)).map(|lane: List<Int>| lane.map(|x: Int| x * 10))),
    xs.map(|x: Int| x * 10),
  )
}

test "the flags name the search a run keys its seeded tests on" {
  let p = sim_plan_of(no_sim_options());
  assert_eq(p, plan::default_plan());
  let seeded = sim_plan_of({ ..no_sim_options(), seed: Some("7:1.0") });
  assert_eq(seeded.mode, plan::Once);
  assert_eq(seeded.roots, [7u64]);
  assert_eq(seeded.path, [1, 0]);
  assert_eq(sim_plan_of({ ..no_sim_options(), mode: "random" }).budget, 1)
}

test "the defaults are one record" {
  assert_eq(default_options().profile, cc::development());
  assert_eq(default_options().timeout, 0);
  assert_eq(default_options().drain_ms, 30000);
  assert_eq(default_options().trace.level, "info")
}

test "a run is lent what its flags name, and the stop it meets a signal with" {
  let quiet = run_grants(
    { ..default_options(), allow: ["shipped"], argv: ["a"] },
    unconfigured(),
    Unheard,
  );
  assert_eq(quiet.argv, Some(["a"]));
  assert_eq(quiet.allow, ["shipped"]);
  assert_eq(quiet.given.map(|g: entering::Given| g.name), ["trace"]);
  let serving = run_grants(
    {
      ..default_options(),
      fs: [{ name: "cwd", path: "." }],
      argv: ["a"],
      tls: [{ name: "api", cert: "c.pem", key: "k.pem" }],
      drain_lead_ms: 250,
    },
    { values: [{ key: "port", value: "80", secret: false }], schema: None, opened: true },
    Drains,
  );
  assert_eq(serving.fs, [{ name: "cwd", path: "." }]);
  assert_eq(serving.given.map(|g: entering::Given| g.name), [
    "tls",
    "config",
    "configured",
    "trace",
    "drain",
  ]);
  assert_eq(serving.given.at(4), Some({ name: "drain", fields: ["250", "30000"] }));
  let starting = run_grants(default_options(), unconfigured(), Ends);
  assert_eq(starting.given.at(1), Some({ name: "end", fields: [] }))
}
test "a failure's sites are placed at their roots, and an unplaced raise names its entry" {
  let roots = Map::new().insert(b"m.f", { module: 0, start: 100, end: 120 });
  let failure: entering::Failure = {
    code: "E0502",
    severity: entering::Error,
    message: "boom",
    labels: [{ site: Some({ root: "m.f", start: 3, end: 7 }), primary: true, text: "here" }],
    notes: [],
    values: [],
  };
  let r = placed(failure, roots, "m.main");
  assert_eq(r.diag.labels, [{ module: 0, start: 103, end: 107, primary: true, text: b"here" }]);
  assert_eq(r.diag.notes, 0);
  let lost = placed(
    { ..failure, labels: [{ site: None, primary: true, text: "here" }] },
    roots,
    "m.main",
  );
  assert_eq(lost.diag.labels.map(|l: Label| l.module), [no_module()]);
  assert_eq(lost.diag.notes, 1)
}

// --- What a command runs over ----------------------------------------------

pub type Refusal = {
  diags: List<Diag>,
  places: List<Place>,
  /// The file the refusal is about, when a `.plyx` was named and is not one. A program that does
  /// not compile is refused over its own sources instead, and names no file here.
  artifact: Option<String>,
}

/// What this run runs: a project the front end loaded, or an artifact opened from a file.
pub type Target = | Project(Program) | Deployed(Artifact)

/// What a run read of the program it loaded.
pub type Read = {
  /// The root the load was rooted at, as a report prints it.
  root: String,
  files: List<String>,
  places: List<Place>,
}

/// A loaded program and the entry points it offers, which the program reads off the front end's
/// answer.
pub type Program = {
  root: String,
  files: List<String>,
  places: List<Place>,
  mains: List<Main>,
  modules: List<Module>,
}

pub fn program_of(read: Read, mains: List<Main>, modules: List<Module>) -> Target =
  Project({
    root: read.root,
    files: read.files,
    places: read.places,
    mains: mains,
    modules: modules,
  })

pub type Artifact = { path: String, digest: String, entry: String, definitions: Int }

/// What the binding discloses before anything runs. A run that performs nothing of the host
/// discloses nothing, because there is nothing it could reach.
pub type Bound = {
  operations: Int,
  digest: String,
  /// The banner the trace sink writes for itself.
  trace: Option<String>,
  /// Only a run that meets a stop itself names the signals it stops on.
  signals: Option<Signals>,
}

/// The signals a run stops on, and its drain where it drains rather than ending at once.
pub type Signals = { names: List<String>, drain: Option<Drain> }

/// What a run reused. `in_place` is `None` when nothing was updated at all, which is not a ratio
/// of zero.
pub type Counters = { updates: Int, updates_in_place: Int, in_place: Option<Decimal> }

/// What was in flight when a signal asked the run to stop; `None` when nobody asked.
pub type Stopping = { signal: Option<String>, listeners: Int, connections: Int, elapsed_ms: Int }

/// What the run was given to stop in, and the spans its entries left open, which `W0609` named.
pub type Teardown = { lead_ms: Int, drain_ms: Int, spans_left_open: Int }

pub type Trace = { events: Int, spans: Int, abandoned: Int, flushed: Bool }

derive bin for Stopping
derive bin for Trace

/// What the entry did, once the binding is torn down.
pub type Ended = {
  /// The code `process.exit` asked for: the program chose it and returned no value.
  exit: Option<Int>,
  value: Option<Value>,
  raised: Option<Raised>,
  counters: Counters,
  /// What the entry ended with, such as the spans it left open.
  warnings: List<Diag>,
  stopping: Option<Stopping>,
  teardown: Teardown,
  trace: Option<Trace>,
  handshakes: List<String>,
  /// The host's own disclosure documents, placed under the keys this report gives them.
  hosts: Json,
}

// --- The options record, built from the parsed line -----------------------------------------

/// The simulation flags as one record: `--sim-roots FROM..TO`, or `--seeds N` from seed 0.
pub fn sim_options_from(p: Parsed) -> SimulationOptions / {abort.raise} =
  {
    seed: value(p, "seed"),
    mode: match value(p, "sim") { Some(v) -> v, None -> "dpor" },
    roots: match value(p, "sim-roots") {
      Some(text) -> range_of(text),
      None -> match nat_value(p, "seeds") { Some(n) -> Some({ from: 0, to: n }), None -> None },
    },
    budget: nat_value(p, "sim-budget"),
    steps: nat_value(p, "sim-steps"),
    measure_reduction: has(p, "measure-reduction"),
  }

/// What the flags ask a search to run, as `sim.plan` normalizes a plan.
pub fn sim_plan_of(sim: SimulationOptions) -> plan::Plan / {abort.raise} =
  plan::asked_plan({
    seed: match sim.seed { Some(text) -> plan::parse_seed(text), None -> None },
    mode: match plan::parse_mode(sim.mode) { Some(m) -> m, None -> plan::Dpor },
    roots: sim.roots,
    budget: sim.budget,
    steps: sim.steps,
  })

/// Work dealt into lanes run at once: one lane per item, or `n` lanes dealt round-robin when `--jobs`
/// names `n`, so lane `k` holds items `k`, `k + n`, ...
pub fn dealt<a>(xs: List<a>, lanes: Option<Int>) -> List<List<a>> = {
  let n = match lanes { Some(k) -> max(1, min(k, xs.len())), None -> xs.len() };
  // Each of a lane's items is stepped to, so dealing thousands into as many lanes is one pass.
  range(0, min(n, xs.len())).map(|k: Int|
    range(0, (xs.len() - k + n - 1) / n).fold([], |lane: List<a>, j: Int|
      match xs.at(k + j * n) { Some(x) -> lane.push(x), None -> lane }))
}

/// What each lane answered, back in the order `dealt` took the items in.
pub fn undealt<b>(lanes: List<List<b>>) -> List<b> / {abort.raise} = {
  let n = lanes.len();
  let total = lanes.fold(0, |acc: Int, lane: List<b>| acc + lane.len());
  range(0, total).fold([], |out: List<b>, i: Int|
    match lanes.at(i % n) {
      Some(lane) -> match lane.at(i / n) { Some(x) -> out.push(x), None -> out },
      None -> out,
    })
}

/// What a run searches when no flag says otherwise.
pub fn no_sim_options() -> SimulationOptions =
  { seed: None, mode: "dpor", roots: None, budget: None, steps: None, measure_reduction: false }

fn opt_text(parsed: Parsed, long: String) -> Option<String> = value(parsed, long)

fn int_of(p: Parsed, long: String, default: Int) -> Int / {abort.raise} =
  match nat_value(p, long) { Some(n) -> n, None -> default }

/// `--tls api=cert.pem,key.pem` as a credential record.
fn creds(parsed: Parsed) -> List<TlsCredential> / {abort.raise} =
  values_of(parsed, "tls").map(|text: String|
    match cut_pair(text) {
      Some(pair) -> match pair {
        (name, paths) -> match split_once(paths, ",") {
          Some(pp) -> match pp { (cert, key) -> { name: name, cert: cert, key: key } },
          None -> { name: name, cert: "", key: "" },
        },
      },
      None -> { name: "", cert: "", key: "" },
    })

fn named_paths(parsed: Parsed, long: String) -> List<Named> / {abort.raise} =
  values_of(parsed, long).map(|text: String|
    match cut_pair(text) {
      Some(pair) -> match pair { (name, path) -> { name: name, path: path } },
      None -> { name: "", path: "" },
    })

/// `NAME=VALUE`: the pair on the first `=`.
fn cut_pair(text: String) -> Option<(String, String)> / {abort.raise} =
  match text.split_once("=") { Some(cut) -> Some((cut.head, cut.tail)), None -> None }

fn split_once(text: String, sep: String) -> Option<(String, String)> / {abort.raise} =
  match text.split_once(sep) { Some(cut) -> Some((cut.head, cut.tail)), None -> None }

/// The whole options record, from the parsed line. Each command reads the subset its flags cover;
/// the parser already refused a flag the command does not take.
pub fn options_from(p: Parsed) -> Options / {abort.raise} =
  {
    ..default_options(),
    json: has(p, "json"),
    tls: creds(p),
    trust: values_of(p, "trust"),
    mtls: values_of(p, "mtls"),
    fs: named_paths(p, "fs"),
    exec: named_paths(p, "exec"),
    allow: values_of(p, "allow"),
    config: {
      set: values_of(p, "set"),
      files: values_of(p, "config"),
      schema: opt_text(p, "config-schema"),
    },
    trace: {
      sink: match value(p, "trace") { Some(s) -> s, None -> default_options().trace.sink },
      level: match value(p, "trace-level") { Some(l) -> l, None -> default_options().trace.level },
    },
    drain_ms: int_of(p, "drain-ms", default_options().drain_ms),
    drain_lead_ms: int_of(p, "drain-lead-ms", default_options().drain_lead_ms),
    timeout: int_of(p, "timeout", default_options().timeout),
    seed: match opt_text(p, "seed") { Some(text) -> plan::parse_seed(text), None -> None },
    profile: surface::profile_of(p),
    argv: p.argv,
  }
