import compiler.check.resolve.tables (Diagnostic, error_at)
import std.http
import std.http (Get, Limits, Post, Put, Request, Response, default_limits, request_to, set_header)
import std.net (net)
import std.string
import compiler.syntax.parsing (no_module, dummy_span)

pub type BaseUrl = {
  secure: Bool,
  host: String,
  port: Int,
  authority: String,
  prefix: String,
  url: String,
}

pub fn url_variable() -> String = "PLY_REGISTRY"

pub const token_variable: String = "PLY_REGISTRY_TOKEN"

pub fn base_of(text: String) -> Result<BaseUrl, String> / {abort.raise} = {
  let url = trimmed_slash(text);
  if url.starts_with("https://") { authority_of(url, true, url.slice(8, url.len())) }
  else if url.starts_with("http://") { authority_of(url, false, url.slice(7, url.len())) }
  else { Err("`" ++ text ++ "` is not an `https://` URL") }
}

fn trimmed_slash(text: String) -> String / {abort.raise} =
  text.slice(
    0,
    range(0, text.len()).fold(text.len(), |end: Int, _i: Int|
      if end > 0 && text.slice(end - 1, end) == "/" { end - 1 } else { end }),
  )

fn authority_of(
  url: String,
  secure: Bool,
  rest: String,
) -> Result<BaseUrl, String> / {abort.raise} = {
  let cut = match rest.split("/") { [] -> "", [first, ..] -> first };
  let prefix = rest.slice(cut.len(), rest.len());
  match host_port(cut, if secure { 443 } else { 80 }) {
    Err(reason) -> Err("`" ++ url ++ "` " ++ reason),
    Ok(hp) -> if !secure && !loopback(hp.host) {
      Err(
        "`" ++ url
          ++ "` uses `http://` to a remote machine, which sends data unencrypted; use `https://`, or use `http://` only for a registry on this machine",
      )
    } else if prefix.contains("?") || prefix.contains("#") {
      Err("`" ++ url ++ "` carries a query or a fragment, and a base URL is a host and a path")
    } else {
      Ok({ secure: secure, host: hp.host, port: hp.port, authority: cut, prefix: prefix, url: url })
    },
  }
}

fn host_port(
  cut: String,
  default: Int,
) -> Result<{ host: String, port: Int }, String> / {abort.raise} =
  if cut == "" { Err("names no host") } else if cut.starts_with("[") {
    match cut.slice(1, cut.len()).split("]") {
      [host, ""] -> Ok({ host: host, port: default }),
      [host, tail] -> if tail.starts_with(":") {
        match port_of(tail.slice(1, tail.len())) {
          None -> Err("names a port that is not a valid port number"),
          Some(p) -> Ok({ host: host, port: p }),
        }
      } else { Err("names a host that is not a valid host name") },
      _ -> Err("names a host that is not a valid host name"),
    }
  } else {
    match cut.split(":") {
      [host] -> Ok({ host: host, port: default }),
      [host, p] -> if host == "" { Err("names no host") } else {
        match port_of(p) {
          None -> Err("names a port that is not a valid port number"),
          Some(n) -> Ok({ host: host, port: n }),
        }
      },
      _ -> Err("names a host that is not a valid host name"),
    }
  }

fn port_of(text: String) -> Option<Int> / {abort.raise} =
  if text.len() > 5 || text.starts_with("-") { None } else {
    match text.int_of_string() {
      Some(p) -> if p >= 1 && p <= 65535 { Some(p) } else { None },
      None -> None,
    }
  }

fn loopback(host: String) -> Bool = host == "localhost" || host == "::1" || host.starts_with("127.")

pub fn index_target(base: BaseUrl, name: String) -> String =
  base.prefix ++ "/" ++ name ++ "/index.json"

pub fn release_target(base: BaseUrl, name: String, version: String) -> String =
  base.prefix ++ "/" ++ name ++ "/" ++ version

pub fn archive_target(base: BaseUrl, name: String, version: String) -> String =
  release_target(base, name, version) ++ "/package.plyz"

pub fn yank_target(base: BaseUrl, name: String, version: String) -> String =
  release_target(base, name, version) ++ "/yank"

pub fn interface_target(base: BaseUrl, name: String, version: String, semantics: String) -> String =
  release_target(base, name, version) ++ "/interface/" ++ semantics

pub fn attestation_target(
  base: BaseUrl,
  name: String,
  version: String,
  semantics: String,
) -> String = release_target(base, name, version) ++ "/attestation/" ++ semantics

const limits: Limits = {
  let base = default_limits;
  { ..base, max_body: 67108864 }
}

pub fn get(base: BaseUrl, target: String) -> Request / {abort.raise} =
  request_to(Get, base.authority, target, b"")

pub fn put(
  base: BaseUrl,
  target: String,
  token: String,
  digest: String,
  body: Bytes,
) -> Request / {abort.raise} = {
  let request = request_to(Put, base.authority, target, body);
  {
    ..request,
    headers: set_header(
      set_header(
        set_header(request.headers, "authorization", "Bearer " ++ token),
        "x-ply-digest",
        digest,
      ),
      "content-type",
      "application/octet-stream",
    ),
  }
}

pub fn post(base: BaseUrl, target: String, token: String) -> Request / {abort.raise} = {
  let request = request_to(Post, base.authority, target, b"");
  { ..request, headers: set_header(request.headers, "authorization", "Bearer " ++ token) }
}

pub fn exchange(
  base: BaseUrl,
  request: Request,
) -> Result<Response<| {}>, Diagnostic> / {net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], abort.raise} =
  if base.secure {
    match http::dial_tls[registry](base.host, base.port, limits) {
      Err(reason) -> Err(registry_unreachable(base.url ++ " " ++ reason_text(reason), [])),
      Ok(c) -> match net.handshake[registry](c.handle) {
        None -> {
          http::close[registry](c);
          Err(untrusted(base))
        },
        Some(_) -> {
          let got = http::round_trip_last[registry](c, request, limits);
          http::close[registry](c);
          response_or_error(base, got)
        },
      },
    }
  } else { response_or_error(base, http::request[registry](base.host, base.port, request, limits)) }

fn response_or_error(
  base: BaseUrl,
  got: Result<Response<| {}>, http::ClientError>,
) -> Result<Response<| {}>, Diagnostic> =
  match got {
    Ok(r) -> Ok(r),
    Err(reason) -> Err(registry_unreachable(base.url ++ " " ++ reason_text(reason), [])),
  }

fn untrusted(base: BaseUrl) -> Diagnostic =
  registry_unreachable(base.url ++ " did not complete a TLS handshake", [
    Bytes::of_string(
      "its certificate is not trusted by this machine, or was not issued for `" ++ base.host ++ "`",
    ),
    b"`PLY_TRUST` lists PEM files of extra certificates to trust, such as the certificate authority of a private registry, in addition to the built-in trusted certificates",
  ])

fn reason_text(reason: http::ClientError) -> String =
  match reason {
    http::Unreachable -> "was not reachable",
    http::NotSent -> "could not be sent the request",
    http::TimedOut -> "did not respond in time",
    http::Closed -> "closed the connection without responding",
    http::Malformed(r) -> "responded with something that is not HTTP: " ++ r.reason,
  }

pub fn response_message(r: Response<| {}>) -> String / {abort.raise} = {
  let text = String::of_bytes_lossy(http::whole_bytes(r.body));
  match text.split("\n") { [] -> "", [first, ..] -> first.trim() }
}

pub fn registry_unreachable(message: String, notes: List<Bytes>) -> Diagnostic =
  error_at(
    b"E0141",
    no_module,
    dummy_span,
    Bytes::of_string(message),
    b"the registry could not be asked",
    notes,
  )

pub fn rejected_by(what: String, status: Int, reason: String) -> Diagnostic =
  error_at(
    b"E0144",
    no_module,
    dummy_span,
    Bytes::of_string(
      "the registry rejected the request to " ++ what ++ ": " ++ status.to_string()
        ++ (if reason == "" { "" } else { " " ++ reason }),
    ),
    b"the registry rejected",
    status_notes(status),
  )

fn status_notes(status: Int) -> List<Bytes> =
  if status == 401 { [b"the registry accepts a write only with `Authorization: Bearer <token>`"] }
  else if status == 403 {
    [b"`PLY_REGISTRY_TOKEN` is not the token the registry maps this package's name to"]
  } else if status == 409 {
    [b"a version is published once and never changes: publish the change as a new version"]
  } else if status == 404 { [b"the registry has no such version"] }
  else { [] }

pub fn rejected_package(message: String, notes: List<Bytes>) -> Diagnostic =
  error_at(
    b"E0145",
    no_module,
    dummy_span,
    Bytes::of_string(message),
    b"not a package the registry can store",
    notes,
  )

pub fn unset(url_variable: String, what: String) -> Diagnostic =
  registry_unreachable("`" ++ url_variable ++ "` is not set, and " ++ what, [
    Bytes::of_string(if url_variable == token_variable {
      "set it to a token the registry maps to this package's name"
    } else { "set it to the registry's base URL, such as `https://registry.example.com`" }),
  ])

fn parsed_base(text: String) -> BaseUrl / {abort.raise} =
  match base_of(text) { Ok(b) -> b, Err(reason) -> panic(reason) }

test "a base URL is a scheme, a host, a port the scheme implies, and a prefix" {
  let b = parsed_base("https://registry.example.com");
  assert_eq(b.secure, true);
  assert_eq(b.host, "registry.example.com");
  assert_eq(b.port, 443);
  assert_eq(b.authority, "registry.example.com");
  assert_eq(b.prefix, "");
  let c = parsed_base("https://example.com:8443/ply/");
  assert_eq(c.port, 8443);
  assert_eq(c.authority, "example.com:8443");
  assert_eq(c.prefix, "/ply");
  assert_eq(index_target(c, "orders"), "/ply/orders/index.json");
  assert_eq(archive_target(c, "orders", "0.2.0"), "/ply/orders/0.2.0/package.plyz");
  assert_eq(release_target(b, "orders", "0.2.0"), "/orders/0.2.0");
  assert_eq(yank_target(b, "orders", "0.2.0"), "/orders/0.2.0/yank");
  let v6 = parsed_base("http://[::1]:9000");
  assert_eq(v6.host, "::1");
  assert_eq(v6.port, 9000);
  assert_eq(v6.authority, "[::1]:9000")
}

test "a registry URL may use unencrypted `http://` only for this machine, and other hosts must use `https://`" {
  assert_eq(parsed_base("http://127.0.0.1:8080").secure, false);
  assert_eq(parsed_base("http://localhost").port, 80);
  match base_of("http://registry.example.com") {
    Ok(_) -> panic("a token would cross the network in the clear"),
    Err(reason) -> assert(reason.contains("sends data unencrypted")),
  };
  match base_of("ftp://example.com") {
    Ok(_) -> panic("ftp is not a registry"),
    Err(reason) -> assert(reason.contains("is not an `https://` URL")),
  };
  match base_of("https://:443") {
    Ok(_) -> panic("no host"),
    Err(reason) -> assert(reason.contains("no host")),
  };
  match base_of("https://example.com:0") {
    Ok(_) -> panic("port 0"),
    Err(reason) -> assert(reason.contains("port")),
  };
  match base_of("https://example.com/ply?x=1") {
    Ok(_) -> panic("a query"),
    Err(reason) -> assert(reason.contains("query")),
  }
}

test "a publish carries the token, the digest and the archive" {
  let request = put(
    parsed_base("https://example.com"),
    "/orders/0.2.0",
    "t0k",
    "b3:ab",
    b"PLYLIB01",
  );
  assert_eq(http::header(request.headers, "authorization"), Some("Bearer t0k"));
  assert_eq(http::header(request.headers, "x-ply-digest"), Some("b3:ab"));
  assert_eq(http::whole_bytes(request.body), b"PLYLIB01");
  assert_eq(request.target, "/orders/0.2.0");
  let yank = post(parsed_base("https://example.com"), "/orders/0.2.0/yank", "t0k");
  assert_eq(http::header(yank.headers, "authorization"), Some("Bearer t0k"));
  assert_eq(yank.method, Post)
}

test "`response_message` returns the first line of a rejected response's body, or an empty string when the body is empty" {
  assert_eq(
    response_message(http::text_response(409, "orders 0.2.0 is already published\n")),
    "orders 0.2.0 is already published",
  );
  assert_eq(response_message(http::response(500, b"")), "")
}
