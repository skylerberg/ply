import paths
import paths (RootedPath, child, displayed, kind, read_file, at_abs)
import std.fs (fs, File, Dir, Symlink, Missing, MemFs, mem_of, mem_kind, mem_list, mem_read,
               mem_symlink)
import std.list
import compiler.expand.derive (import_path)
import compiler.syntax.items (ImportDeclaration, header, parse)
import compiler.load (is_ply, modules_below, is_skipped)

pub type Failure = { path: String, reason: String }

pub type WalkResult = { files: Map<String, RootedPath>, errors: List<Failure> }

pub fn nothing() -> WalkResult = { files: Map::new(), errors: [] }

fn add_file(found: WalkResult, rooted: RootedPath) -> WalkResult =
  { ..found, files: found.files.insert(displayed(rooted), rooted) }

fn add_error(found: WalkResult, rooted: RootedPath, reason: String) -> WalkResult =
  { ..found, errors: found.errors.push({ path: displayed(rooted), reason: reason }) }

pub fn walk_path(
  found: WalkResult,
  rooted: RootedPath,
) -> WalkResult / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs]} =
  match kind(rooted) {
    File -> add_file(found, rooted),
    Dir -> walk_dir(found, rooted, false),
    Symlink -> add_error(found, rooted, "a symlink is not followed"),
    Missing -> add_error(found, rooted, "could not read"),
  }

pub fn walk_package(
  found: WalkResult,
  root: RootedPath,
) -> WalkResult / {fs.list_dir[cwd], fs.list_dir[abs]} = walk_dir(found, root, true)

fn imports_of(text: Bytes) -> List<String> / {abort.raise} =
  List::map(
    (match header(text) { Some(m) -> m, None -> parse(text).node }).imports,
    |d: ImportDeclaration| String::of_bytes_lossy(import_path(d)),
  )

fn module_file(
  root: RootedPath,
  name: String,
) -> Option<RootedPath> / {fs.kind[cwd], fs.kind[abs]} = {
  let segments = name.split(".");
  let dir = segments.take(segments.len() - 1).fold(
    Some(root),
    |at: Option<RootedPath>, d: String|
      match at {
        None -> None,
        Some(up) -> if is_skipped(d) || kind(child(up, d)) != Dir { None }
        else { Some(child(up, d)) },
      },
  );
  match ((dir, segments.at(segments.len() - 1))) {
    (Some(d), Some(stem)) -> if kind(child(d, stem ++ ".ply")) == File {
      Some(child(d, stem ++ ".ply"))
    } else { None },
    _ -> None,
  }
}

type FollowState = { found: WalkResult, todo: List<RootedPath>, seen: List<String> }

fn follow_imports(
  f: FollowState,
  root: RootedPath,
) -> WalkResult / {fs.kind[cwd], fs.kind[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise, diverges} =
  match f.todo {
    [] -> f.found,
    [file, ..rest] ->
      follow_imports(
        List::fold(
          match read_file(file) { Some(text) -> imports_of(text), None -> [] },
          { ..f, todo: rest },
          |accumulator: FollowState, name: String|
            if accumulator.seen.contains(name) { accumulator } else {
              let seen = accumulator.seen.push(name);
              match module_file(root, name) {
                None -> { ..accumulator, seen: seen },
                Some(at) -> if accumulator.found.files.contains(displayed(at)) {
                  { ..accumulator, seen: seen }
                } else {
                  {
                    found: add_file(accumulator.found, at),
                    todo: accumulator.todo.push(at),
                    seen: seen,
                  }
                },
              }
            },
        ),
        root,
      ),
  }

pub fn walk_for_load(
  found: WalkResult,
  resolved: paths::ResolvedPath,
) -> WalkResult / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise, diverges} = {
  let root: RootedPath = { label: resolved.label, path: resolved.root_path };
  let at = paths::rooted(resolved);
  if resolved.part != "" || kind(child(root, "ply.pkg")) != Missing { walk_package(found, root) }
  else if resolved.inside != "." && is_ply(resolved.inside) && kind(at) == File {
    follow_imports({ found: add_file(found, at), todo: [at], seen: [] }, root)
  } else { walk_path(found, at) }
}

fn walk_dir(
  found: WalkResult,
  dir: RootedPath,
  own: Bool,
) -> WalkResult / {fs.list_dir[cwd], fs.list_dir[abs]} = {
  let modules = if dir.label == "cwd" { modules_below[cwd](dir.path, own) }
  else { modules_below[abs](dir.path, own) };
  let at = |path: String| if path == "" { dir } else { child(dir, path) };
  modules.unread.fold(
    modules.files.fold(found, |accumulator: WalkResult, path: String|
      add_file(accumulator, at(path))),
    |accumulator: WalkResult, path: String| add_error(accumulator, at(path), "could not read"),
  )
}

pub fn walk_paths(
  rs: List<paths::ResolvedPath>,
) -> WalkResult / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs]} = {
  let rs = if rs.len() == 0 { [paths::here()] } else { rs };
  rs.fold(nothing(), |accumulator: WalkResult, resolved: paths::ResolvedPath|
    walk_path(accumulator, paths::rooted(resolved)))
}

pub fn walk_paths_for_load(
  rs: List<paths::ResolvedPath>,
) -> WalkResult / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise, diverges} = {
  let rs = if rs.len() == 0 { [paths::here()] } else { rs };
  rs.fold(nothing(), |accumulator: WalkResult, resolved: paths::ResolvedPath|
    walk_for_load(accumulator, resolved))
}

fn in_cwd(path: String) -> RootedPath = { label: "cwd", path: path }

test "the walk passes over a symlink, a hidden directory, `target` and anything not `.ply`" {
  let files = mem_of([
    { path: "m.ply", body: b"fn m() -> Int = 1" },
    { path: "notes.txt", body: b"x" },
    { path: "sub/deep.ply", body: b"fn d() -> Int = 1" },
    { path: ".git/config.ply", body: b"fn g() -> Int = 1" },
    { path: "target/built.ply", body: b"fn b() -> Int = 1" },
  ]);
  let tree = mem_symlink(files, "link.ply", "m.ply").fs;
  let found = handle {
    walk_path(nothing(), in_cwd("."))
  } with {
    fs.list_dir[cwd](p) -> mem_list(tree, p),
    fs.list_dir[abs](p) -> panic("nothing here leaves the working directory"),
    fs.kind[cwd](p) -> mem_kind(tree, p),
    fs.kind[abs](p) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(found.files.keys(), ["m.ply", "sub/deep.ply"]);
  assert_eq(found.errors, [])
}

fn loading_in(tree: MemFs, resolved: paths::ResolvedPath) -> WalkResult / {abort.raise, diverges} =
  handle {
    walk_for_load(nothing(), resolved)
  } with {
    fs.list_dir[cwd](p) -> mem_list(tree, p),
    fs.list_dir[abs](p) -> panic("nothing here leaves the working directory"),
    fs.kind[cwd](p) -> mem_kind(tree, p),
    fs.kind[abs](p) -> panic("nothing here leaves the working directory"),
    fs.read_file[cwd](p) -> mem_read(tree, p),
    fs.read_file[abs](p) -> panic("nothing here leaves the working directory"),
  }

fn found_with_vendored(own: Bool) -> List<String> / {abort.raise, diverges} = {
  let tree = mem_of([
    { path: "ply.pkg", body: b"" },
    { path: "m.ply", body: b"fn m() -> Int = 1" },
    { path: "sub/deep.ply", body: b"fn d() -> Int = 1" },
    { path: "vendor/lib/ply.pkg", body: b"" },
    { path: "vendor/lib/lib.ply", body: b"pub fn l() -> Int = 1" },
  ]);
  if own { loading_in(tree, paths::at_cwd(".")).files.keys() } else {
    handle {
      walk_path(nothing(), in_cwd(".")).files.keys()
    } with {
      fs.list_dir[cwd](p) -> mem_list(tree, p),
      fs.list_dir[abs](p) -> panic("nothing here leaves the working directory"),
      fs.kind[cwd](p) -> mem_kind(tree, p),
      fs.kind[abs](p) -> panic("nothing here leaves the working directory"),
    }
  }
}

test "walking a package skips the package nested inside it, but walking the directory's files includes the nested package's files" {
  assert_eq(found_with_vendored(true), ["m.ply", "sub/deep.ply"]);
  assert_eq(found_with_vendored(false), ["m.ply", "sub/deep.ply", "vendor/lib/lib.ply"])
}

fn unpackaged() -> MemFs / {abort.raise} =
  mem_of([
    {
      path: "app/main.ply",
      body: b"import beside\nimport util.text\nimport target.built\nimport std.list\n",
    },
    { path: "app/beside.ply", body: b"pub fn b() -> Int = 1" },
    { path: "app/util/text.ply", body: b"import main\nimport util.chars\n" },
    { path: "app/util/chars.ply", body: b"pub fn c() -> Int = 1" },
    { path: "app/target/built.ply", body: b"pub fn g() -> Int = 1" },
    { path: "app/other.ply", body: b"import util.unread\n" },
    { path: "app/util/unread.ply", body: b"pub fn u() -> Int = 1" },
  ])

test "a file outside any package loads together with the modules it imports, following each import, and no other files" {
  let found = loading_in(unpackaged(), { ..paths::at_cwd("app"), inside: "main.ply" });
  assert_eq(found.files.keys(), [
    "app/beside.ply",
    "app/main.ply",
    "app/util/chars.ply",
    "app/util/text.ply",
  ]);
  assert_eq(found.errors, [])
}

test "a directory outside any package loads all its files, whether or not they are imported" {
  let found = loading_in(unpackaged(), paths::at_cwd("app/util"));
  assert_eq(found.files.keys(), ["app/util/chars.ply", "app/util/text.ply", "app/util/unread.ply"])
}

test "a file in a package loads with the package's files, not with the modules it imports" {
  let tree = mem_of([
    { path: "ply.pkg", body: b"" },
    { path: "m.ply", body: b"import absent\n" },
    { path: "n.ply", body: b"pub fn n() -> Int = 1" },
  ]);
  let found = loading_in(tree, { ..paths::at_cwd("."), inside: "m.ply" });
  assert_eq(found.files.keys(), ["m.ply", "n.ply"])
}

test "a named symlink is rejected rather than followed" {
  let found = handle {
    walk_path(nothing(), in_cwd("link.ply"))
  } with {
    fs.kind[cwd](p) -> Symlink,
    fs.kind[abs](p) -> panic("nothing here leaves the working directory"),
    fs.list_dir[cwd](p) -> panic("a symlink is never walked"),
    fs.list_dir[abs](p) -> panic("a symlink is never walked"),
  };
  assert_eq(found.files.keys(), []);
  assert_eq(found.errors, [{ path: "link.ply", reason: "a symlink is not followed" }])
}

test "a file named on the command line is taken whatever its extension, but a file found by walking a directory is taken only if it is `.ply`" {
  let tree = mem_of([{ path: "notes.txt", body: b"x" }]);
  let both = handle {
    walk_dir(walk_path(nothing(), in_cwd("notes.txt")), in_cwd("."), false)
  } with {
    fs.list_dir[cwd](p) -> mem_list(tree, p),
    fs.list_dir[abs](p) -> panic("nothing here leaves the working directory"),
    fs.kind[cwd](p) -> mem_kind(tree, p),
    fs.kind[abs](p) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(both.files.keys(), ["notes.txt"])
}

test "a directory entry ending in `.ply` whose kind is `Missing` is reported as an error, and a `Missing` entry of any other type is skipped" {
  let found = handle {
    walk_path(nothing(), in_cwd("."))
  } with {
    fs.list_dir[cwd](p) ->
      Some([
        { name: "gone.ply", kind: Missing },
        { name: "gone.txt", kind: Missing },
        { name: "m.ply", kind: File },
      ]),
    fs.list_dir[abs](p) -> panic("nothing here leaves the working directory"),
    fs.kind[cwd](p) -> if p == "." { Dir } else { panic("a walk asks no entry what it is") },
    fs.kind[abs](p) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(found.files.keys(), ["m.ply"]);
  assert_eq(found.errors, [{ path: "gone.ply", reason: "could not read" }])
}

test "no path given is the working directory" {
  let tree = mem_of([{ path: "m.ply", body: b"fn m() -> Int = 1" }]);
  let found = handle {
    walk_paths([])
  } with {
    fs.list_dir[cwd](p) -> mem_list(tree, p),
    fs.list_dir[abs](p) -> panic("nothing here leaves the working directory"),
    fs.kind[cwd](p) -> mem_kind(tree, p),
    fs.kind[abs](p) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(found.files.keys(), ["m.ply"])
}

test "the same relative path under the working directory and under an absolute root is found as two separate files" {
  let here = mem_of([{ path: "app/m.ply", body: b"fn m() -> Int = 1" }]);
  let root = mem_of([{ path: "app/m.ply", body: b"fn m() -> Int = 2" }]);
  let found = handle {
    walk_paths([paths::at_cwd("app"), at_abs("app")])
  } with {
    fs.list_dir[cwd](p) -> mem_list(here, p),
    fs.list_dir[abs](p) -> mem_list(root, p),
    fs.kind[cwd](p) -> mem_kind(here, p),
    fs.kind[abs](p) -> mem_kind(root, p),
  };
  assert_eq(found.files.keys(), ["/app/m.ply", "app/m.ply"]);
  assert_eq(found.files.values(), [
    { label: "abs", path: "app/m.ply" },
    { label: "cwd", path: "app/m.ply" },
  ]);
  assert_eq(found.errors, [])
}

test "a missing path outside the working directory is rejected, and the error shows its full path" {
  let found = handle {
    walk_paths([at_abs("srv/absent.ply")])
  } with {
    fs.list_dir[cwd](p) -> panic("a path under `abs` is listed under `abs`"),
    fs.list_dir[abs](p) -> None,
    fs.kind[cwd](p) ->
      panic(
        "this test allows only absolute paths, but `ply new` checked a path relative to the working directory",
      ),
    fs.kind[abs](p) -> Missing,
  };
  assert_eq(found.errors, [{ path: "/srv/absent.ply", reason: "could not read" }])
}
