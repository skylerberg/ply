import compiler.load (Derives)
import compiler.cc (toolchain)
import compiler.unit (shipped)
import std.random (entropy)
import std.time (time)
import builder (builder)
import args (Flags, style_of)
import program (Program, load_program, location_of, own_laws, own_tests, program_view)
import report (CommandOutput, schema_version, ok_code, indent, count_of, rejected)
import std.term (Style, bold, dim)
import compiler.front.emitter_input (Analysed, Rejected, checked_program_of)
import compiler.front.facts (CheckedProgram, Frame)
import compiler.front.published (analyse)
import compiler.front.diagnostics (parse_all)
import compiler.front.rows (Outline, OutlineItem, OutlinedEffect, OutlinedFunction, OutlinedType)
import compiler.check.infer.checker (LawInfo, Location, TestInfo)
import compiler.check.resolve.tables (Diagnostic, qualify)
import compiler.store.hash (is_discarded_name)
import compiler.store.hash.forms (DeclarationNamed, FunctionNamed, ItemKeyed, ReachableNames,
                                  Subject, used_from)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, Array, object)
import std.string

pub type Kind = | FunctionKind | TypeKind | EffectKind

pub type Written = { name: Bytes, kind: Kind, at: Location, public: Bool, entry: Bool, held: Bool }

pub type Unused = { definitions: Int, never_used: List<Written>, only_tests: List<Written> }

fn written_in(outline: Outline, module: Int) -> List<Written> / {abort.raise} =
  outline.items.fold([], |acc: List<Written>, item: OutlineItem|
    match item {
      OutlinedFunction(f) -> {
        let name = qualify(outline.name, f.name);
        acc.push({
          name: name,
          kind: FunctionKind,
          at: { module: module, span: f.name_span },
          public: f.public,
          entry: f.name == b"main",
          held: f.generated || is_discarded_name(f.name) || outline.schemas.contains(name),
        })
      },
      OutlinedType(t) ->
        acc.push({
          name: qualify(outline.name, t.name),
          kind: TypeKind,
          at: { module: module, span: t.span },
          public: t.public,
          entry: false,
          held: is_discarded_name(t.name),
        }),
      OutlinedEffect(e) ->
        acc.push({
          name: qualify(outline.name, e.name),
          kind: EffectKind,
          at: { module: module, span: e.span },
          public: e.public,
          entry: false,
          held: is_discarded_name(e.name),
        }),
      _ -> acc,
    })

fn written_in_root_package(frame: Frame) -> List<Written> / {abort.raise} =
  range(0, frame.outlines.len()).filter(|i: Int| frame.module_packages.at(i) == Some(0)).flat_map(
    |i: Int| written_in(frame.outlines.get(i), i),
  )

fn subject_of(w: Written) -> Subject =
  match w.kind {
    FunctionKind -> FunctionNamed(w.name),
    TypeKind -> DeclarationNamed(w.name),
    EffectKind -> DeclarationNamed(w.name),
  }

fn reached(names: ReachableNames, w: Written) -> Bool =
  match w.kind {
    FunctionKind -> names.functions.contains(w.name),
    TypeKind -> names.declarations.contains(w.name),
    EffectKind -> names.declarations.contains(w.name),
  }

pub fn unused_in(
  frame: Frame,
  tests: List<TestInfo>,
  laws: List<LawInfo>,
) -> Unused / {abort.raise} = {
  let written = written_in_root_package(frame);
  let is_program = written.any(|w: Written| w.entry);
  let roots = written.filter(|w: Written| w.entry || w.held || (!is_program && w.public)).map(
    subject_of,
  );
  let checks = tests.map(|t: TestInfo| ItemKeyed(t.key)).concat(
    laws.map(|l: LawInfo| ItemKeyed(l.key)),
  );
  let running = used_from(frame.hashes, roots);
  let testing = used_from(frame.hashes, roots.concat(checks));
  {
    definitions: written.len(),
    never_used: written.filter(|w: Written| !reached(testing, w)),
    only_tests: written.filter(|w: Written| reached(testing, w) && !reached(running, w)),
  }
}

fn kind_text(kind: Kind) -> String =
  match kind { FunctionKind -> "fn", TypeKind -> "type", EffectKind -> "effect" }

fn location_text(program: Program, w: Written) -> String / {abort.raise} =
  match location_of(program, w.at) { Some(text) -> text, None -> "" }

fn group_lines(
  style: Style,
  program: Program,
  title: String,
  group: List<Written>,
) -> List<String> / {abort.raise} =
  if group.len() == 0 { [] } else {
    [""].push(indent() ++ bold(style, title ++ ": " ++ count_of(group.len(), "definition"))).concat(
      group.map(|w: Written|
        indent() ++ indent() ++ String::of_bytes_lossy(w.name) ++ "  "
          ++ dim(style, location_text(program, w))),
    )
  }

fn written_json(program: Program, w: Written) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(String::of_bytes_lossy(w.name)) },
    { key: "kind", value: Str(kind_text(w.kind)) },
    {
      key: "location",
      value: match location_of(program, w.at) { Some(text) -> Str(text), None -> Null },
    },
  ])

fn unused_output(style: Style, program: Program, found: Unused) -> CommandOutput / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("unused") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code())) },
      { key: "definitions", value: Number(Decimal::of_int(found.definitions)) },
      {
        key: "never_used",
        value: Array(found.never_used.map(|w: Written| written_json(program, w))),
      },
      {
        key: "only_tests",
        value: Array(found.only_tests.map(|w: Written| written_json(program, w))),
      },
    ]),
    lines: group_lines(style, program, "never used", found.never_used).concat(
      group_lines(style, program, "only tests use", found.only_tests),
    ).concat(["", indent() ++ count_of(found.definitions, "definition") ++ " checked"]),
    errs: [],
    code: ok_code(),
  }

pub fn run(
  flags: Flags,
) -> CommandOutput / {shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.list_dir[shipped], fs.read_file[cwd], fs.read_file[abs], fs.read_file[shipped], fs.write[cwd], fs.write[abs], fs.read[cwd], fs.read[abs], entropy.next, time.now_ms, Derives, abort.raise, shipped.report_view_used, diverges} = {
  let loaded: Program = load_program(flags.paths, flags.verify_dependencies);
  let s = style_of(flags);
  match program_view(loaded) {
    None -> rejected(s, "unused", loaded.diagnostics, loaded.source_texts),
    Some(w) ->
      unused_output(s, loaded, unused_in(w.frame, own_tests(loaded, w), own_laws(loaded, w))),
  }
}

fn analysed(src: String) -> CheckedProgram / {abort.raise} =
  match analyse(parse_all([{ name: b"m", src: Bytes::of_string(src) }])) {
    Analysed(w) -> checked_program_of(w),
    Rejected(rejected) ->
      panic(
        "the fixture checks: "
          ++ String::join(rejected.map(|d: Diagnostic| String::of_bytes_lossy(d.message)), "; "),
      ),
  }

fn found_in(src: String) -> Unused / {abort.raise} = {
  let analysis = analysed(src);
  unused_in(analysis.frame, analysis.checked.tests, analysis.checked.laws)
}

fn names(group: List<Written>) -> List<Bytes> = group.map(|w: Written| w.name)

test "in a program, a `pub` definition nothing reaches is never used" {
  let found = found_in(
    "pub fn main() -> Unit = kept()\nfn kept() -> Unit = ()\npub fn gone() -> Int = 1\n",
  );
  assert_eq(names(found.never_used), [b"m.gone"]);
  assert_eq(found.only_tests, [])
}

test "what only a test or a law reaches is set apart from what `main` reaches" {
  let found = found_in(
    "pub fn main() -> Unit = ()\npub fn tested() -> Int = 1\npub fn lawful() -> Int = 2\ntest \"t\" { assert_eq(tested(), 1) }\nlaw \"l\" forall (n: Int) { lawful() == 2 }\n",
  );
  assert_eq(names(found.only_tests), [b"m.tested", b"m.lawful"]);
  assert_eq(found.never_used, [])
}

test "in a library every `pub` definition is used, so only what it leaves behind is reported" {
  let found = found_in(
    "pub fn offered() -> Int = 1\nfn helper() -> Int = 2\nfn stray() -> Int = 3\ntest \"h\" { assert_eq(helper(), 2) }\n",
  );
  assert_eq(names(found.never_used), [b"m.stray"]);
  assert_eq(names(found.only_tests), [b"m.helper"])
}

test "a name that opts out, and a type or an effect nothing names, are judged the same way" {
  let found = found_in(
    "pub fn main() -> Unit = ()\nfn _kept() -> Int = 1\npub type Shape = { size: Int }\npub effect log { write emit(Bytes) -> Unit }\n",
  );
  assert_eq(names(found.never_used), [b"m.Shape", b"m.log"])
}

test "a definition reached only through a `requires` clause is used" {
  let found = found_in(
    "pub fn main() -> Unit = guarded(1)\nfn positive(n: Int) -> Bool = n > 0\nfn guarded(n: Int) -> Unit\n  requires positive(n)\n= ()\n",
  );
  assert_eq(found.never_used, [])
}
