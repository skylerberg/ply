import compiler.cc (toolchain)
import std.random (entropy)
import std.time (time)
import std.process (process)
import builder (builder)
import args (Flags, no_flags, style_of)
import paths
import paths (RootedPath, displayed, write_file)
import diagnostic (all_to_json, all_to_text, errors_of, errors_text)
import program (Program, load_program, reanalysed, no_program, program_view)
import compiler.load (Derives, report_viewed)
import compiler.unit (shipped)
import report (CommandOutput, schema_version, ok_code, compile_error, rejected)
import show (DefinitionSource, locate)
import sources (File)
import std.term (Style, plain)
import compiler.front.facts (CheckedProgram)
import compiler.front (PulledAnalysis)
import compiler.front.emitter_input (Rejected, Analysed)
import compiler.syntax.fmt (replace_item)
import compiler.store.hash.forms (HashOutput, by_name)
import compiler.store.hash (no_hashes)
import compiler.check.resolve.tables (Source, Diagnostic, error_at)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, object)
import std.string
import compiler.syntax.parsing (no_module, dummy_span, span_between)

pub nondet effect edit {
  read replacement_text[r](replacement: Option<String>) -> Result<String, String>
}

pub fn with_replacement<a | e>(
  body: () -> a / {edit.replacement_text[replace] | e},
) -> a / {diverges, fs.read_file[cwd], fs.read_file[abs], process.line[proc], abort.raise | e} =
  handle { body() } with { edit.replacement_text[replace](named) -> read_replacement(named) }

fn read_replacement(
  named: Option<String>,
) -> Result<String, String> / {fs.read_file[cwd], fs.read_file[abs], process.line[proc], abort.raise, diverges} =
  match named {
    None -> Ok(read_stdin("")),
    Some(file) -> match paths::read_file(paths::rooted_path(file)) {
      None -> Err("could not read `" ++ file ++ "`"),
      Some(text) -> if text.is_utf8() { Ok(String::of_bytes(text)) }
      else { Err("could not read `" ++ file ++ "`: it is not UTF-8") },
    },
  }

fn read_stdin(read: String) -> String / {process.line[proc], diverges} =
  match process.line[proc]() { Some(line) -> read_stdin(read ++ line ++ "\n"), None -> read }

fn backticked(names: List<String>) -> String =
  String::join(names.map(|n: String| "`" ++ n ++ "`"), ", ")

fn unreadable(reason: String) -> Diagnostic =
  error_at(
    b"E0502",
    no_module(),
    dummy_span(),
    Bytes::of_string(reason),
    b"the replacement could not be read",
    [],
  )

fn unwritable(path: String) -> Diagnostic =
  error_at(
    b"E0502",
    no_module(),
    dummy_span(),
    Bytes::of_string("could not write `" ++ path ++ "`"),
    b"the file could not be written",
    [],
  )

fn not_one_item(shown: DefinitionSource, reason: String) -> Diagnostic =
  error_at(
    b"E0128",
    shown.at.module,
    shown.at.span,
    Bytes::of_string(reason),
    b"the definition to replace",
    [b"the replacement is one item of the same kind and name"],
  )

fn not_the_same(shown: DefinitionSource, message: String) -> Diagnostic =
  error_at(
    b"E0128",
    shown.at.module,
    shown.at.span,
    Bytes::of_string(message),
    b"the definition to replace",
    [b"nothing was written"],
  )

fn names_map(xs: List<{ name: Bytes, hash: Bytes }>, into: Map<Bytes, Bool>) -> Map<Bytes, Bool> =
  xs.fold(into, |accumulator: Map<Bytes, Bool>, x: { name: Bytes, hash: Bytes }|
    accumulator.insert(x.name, true))

fn declared(h: HashOutput) -> Map<Bytes, Bool> =
  names_map(h.declarations, names_map(h.definitions, Map::new()))

fn absent_from(these: Map<Bytes, Bool>, those: Map<Bytes, Bool>) -> List<String> =
  these.fold([], |accumulator: List<String>, key: Bytes, present: Bool|
    match those.get(key) {
      Some(_) -> accumulator,
      None -> accumulator.push(String::of_bytes_lossy(key)),
    })

fn what_changed(added: List<String>, removed: List<String>) -> String =
  if added.len() == 0 { "removes " ++ backticked(removed) }
  else if removed.len() == 0 { "adds " ++ backticked(added) }
  else { "adds " ++ backticked(added) ++ " and removes " ++ backticked(removed) }

fn contains_name(xs: List<{ name: Bytes, hash: Bytes }>, name: Bytes) -> Bool =
  xs.fold(false, |accumulator: Bool, x: { name: Bytes, hash: Bytes }| accumulator || x.name == name)

fn differing_names(
  was: Map<Bytes, Bytes>,
  now: Map<Bytes, Bytes>,
  skip: Bytes,
  into: List<String>,
) -> List<String> =
  was.fold(into, |accumulator: List<String>, key: Bytes, hash: Bytes|
    if key != skip && now.get(key) != Some(hash) { accumulator.push(String::of_bytes_lossy(key)) }
    else { accumulator })

pub fn changed_names(before: HashOutput, after: HashOutput, name: Bytes) -> List<String> = {
  let own = differing_names(by_name(before.own), by_name(after.own), name, []);
  if !contains_name(before.definitions, name) { own }
  else { differing_names(by_name(before.declarations), by_name(after.declarations), b"", own) }
}

pub fn difference(before: HashOutput, after: HashOutput, name: String) -> Option<String> = {
  let was = declared(before);
  let now = declared(after);
  let added = absent_from(now, was);
  let removed = absent_from(was, now);
  if added.len() > 0 || removed.len() > 0 {
    Some("the replacement of `" ++ name ++ "` " ++ what_changed(added, removed))
  } else {
    let moved = changed_names(before, after, Bytes::of_string(name));
    if moved.len() == 0 { None }
    else { Some("the replacement of `" ++ name ++ "` also changes " ++ backticked(moved)) }
  }
}

fn replaced_sources(program: Program, at: Int, text: Bytes) -> List<Source> =
  range(0, program.files.len()).map(|i: Int|
    match program.files.at(i) {
      None -> { name: b"", source_text: b"" },
      Some(f) ->
        { name: Bytes::of_string(f.module), source_text: if i == at { text } else { f.text } },
    })

fn still_the_same(
  program: Program,
  analysis: CheckedProgram,
  shown: DefinitionSource,
  text: Bytes,
) -> Option<Diagnostic> / {abort.raise, shipped.report_view_used} = {
  let before: HashOutput = analysis.frame.hashes;
  let out: PulledAnalysis = reanalysed(
    program,
    analysis.frame,
    replaced_sources(program, shown.at.module, text),
    Bytes::of_string(shown.name),
  );
  report_viewed(out.shipped_views, false);
  match out.out {
    Rejected(ds) ->
      Some(
        not_the_same(
          shown,
          "with `" ++ shown.name ++ "` replaced, the program does not check: " ++ errors_text(ds),
        ),
      ),
    Analysed(after) -> match difference(before, after.hashes, shown.name) {
      None -> None,
      Some(message) -> Some(not_the_same(shown, message)),
    },
  }
}

fn file_of(program: Program, shown: DefinitionSource) -> Option<File> =
  program.files.at(shown.at.module)

fn output_lines(
  p: Program,
  flags: Flags,
  shown: Option<DefinitionSource>,
  changed: Bool,
) -> List<String> =
  match shown {
    None -> [],
    Some(x) -> {
      let path = match file_of(p, x) { Some(f) -> displayed(f.at), None -> x.path };
      if !changed { [x.name ++ " in " ++ path ++ " is unchanged"] }
      else if flags.check { ["would replace " ++ path] }
      else { ["replaced " ++ x.name ++ " in " ++ path] }
    },
  }

fn name_json(shown: Option<DefinitionSource>) -> Json =
  match shown { Some(x) -> Str(x.name), None -> Null }

fn file_json(shown: Option<DefinitionSource>) -> Json =
  match shown { Some(x) -> Str(x.path), None -> Null }

pub fn replace_output(
  style: Style,
  flags: Flags,
  program: Program,
  shown: Option<DefinitionSource>,
  changed: Bool,
  diagnostics: List<Diagnostic>,
) -> CommandOutput / {abort.raise} = {
  let code = if diagnostics.len() == 0 { ok_code() } else { compile_error() };
  let lines = if diagnostics.len() > 0 { [] } else { output_lines(program, flags, shown, changed) };
  {
    json: object([
      { key: "command", value: Str("replace") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
      { key: "ok", value: Bool(diagnostics.len() == 0) },
      { key: "exit_code", value: Number(Decimal::of_int(code)) },
      { key: "name", value: name_json(shown) },
      { key: "file", value: file_json(shown) },
      { key: "changed", value: Bool(changed) },
      { key: "diagnostics", value: all_to_json(diagnostics, program.source_texts) },
    ]),
    lines: lines,
    errs: all_to_text(style, diagnostics, program.source_texts),
    code: code,
  }
}

fn stopped(
  style: Style,
  flags: Flags,
  program: Program,
  shown: DefinitionSource,
  diagnostic: Diagnostic,
) -> CommandOutput / {abort.raise} =
  replace_output(style, flags, program, Some(shown), false, [diagnostic])

fn written(
  style: Style,
  flags: Flags,
  program: Program,
  shown: DefinitionSource,
  file: File,
  text: Bytes,
) -> CommandOutput / {fs.write_file[cwd], fs.write_file[abs], abort.raise} =
  if flags.check { replace_output(style, flags, program, Some(shown), true, []) }
  else if write_file(file.at, text) { replace_output(style, flags, program, Some(shown), true, []) }
  else { stopped(style, flags, program, shown, unwritable(displayed(file.at))) }

fn replaced(
  style: Style,
  flags: Flags,
  program: Program,
  analysis: CheckedProgram,
  shown: DefinitionSource,
  file: File,
  read_replacement: String,
) -> CommandOutput / {fs.write_file[cwd], fs.write_file[abs], abort.raise, shipped.report_view_used} =
  match replace_item(
      shown.text,
      Bytes::of_string(shown.unqualified_name),
      Bytes::of_string(read_replacement),
    ) {
    Err(reason) ->
      stopped(style, flags, program, shown, not_one_item(shown, String::of_bytes_lossy(reason))),
    Ok(text) -> if text == shown.text {
      replace_output(style, flags, program, Some(shown), false, [])
    } else {
      match still_the_same(program, analysis, shown, text) {
        Some(d) -> stopped(style, flags, program, shown, d),
        None -> written(style, flags, program, shown, file, text),
      }
    },
  }

fn rewritten(
  style: Style,
  flags: Flags,
  program: Program,
  analysis: CheckedProgram,
  shown: DefinitionSource,
) -> CommandOutput / {fs.write_file[cwd], fs.write_file[abs], edit.replacement_text[replace], abort.raise, shipped.report_view_used} =
  match file_of(program, shown) {
    None ->
      stopped(
        style,
        flags,
        program,
        shown,
        not_the_same(
          shown,
          "`" ++ shown.name ++ "` ships with the compiler, and no file of this program defines it",
        ),
      ),
    Some(file) -> match edit.replacement_text[replace](flags.out) {
      Err(reason) -> stopped(style, flags, program, shown, unreadable(reason)),
      Ok(read_replacement) ->
        replaced(style, flags, program, analysis, shown, file, read_replacement),
    },
  }

pub fn run(
  flags: Flags,
) -> CommandOutput / {shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shipped], fs.read_file[shipped], edit.replacement_text[replace], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, Derives, abort.raise, diverges, shipped.report_view_used} = {
  let loaded: Program = load_program(flags.paths, flags.verify_dependencies);
  let s = style_of(flags);
  match program_view(loaded) {
    None -> rejected(s, "replace", loaded.diagnostics, loaded.source_texts),
    Some(w) -> match locate(loaded, w, flags.query) {
      Err(d) -> replace_output(s, flags, loaded, None, false, [d]),
      Ok(shown) -> rewritten(s, flags, loaded, w, shown),
    },
  }
}

fn hashes_of(
  definitions: List<{ name: Bytes, hash: Bytes }>,
  own: List<{ name: Bytes, hash: Bytes }>,
  declarations: List<{ name: Bytes, hash: Bytes }>,
) -> HashOutput = { ..no_hashes(), definitions: definitions, own: own, declarations: declarations }

fn two_definitions(two: Bytes) -> HashOutput =
  hashes_of(
    [{ name: b"m.one", hash: b"aa" }, { name: b"m.two", hash: two }],
    [{ name: b"m.one", hash: b"aa" }, { name: b"m.two", hash: two }],
    [],
  )

fn example_definition() -> DefinitionSource =
  {
    name: "m.two",
    unqualified_name: "two",
    at: { module: 0, span: span_between(0, 10) },
    path: "m.ply",
    text: b"fn two() -> Int = 2\n",
    start: 0,
    end: 20,
  }

fn flags_of(check: Bool) -> Flags = { ..no_flags(), check: check }

fn a_file(rooted: RootedPath) -> File =
  { path: "m.ply", module: "m", text: example_definition().text, at: rooted }

fn a_program(rooted: RootedPath) -> Program = { ..no_program(), files: [a_file(rooted)] }

test "`difference` returns `None` when two programs differ only in the definition `m.two`" {
  assert_eq(difference(two_definitions(b"bb"), two_definitions(b"cc"), "m.two"), None)
}

test "a replacement that changes another definition's hash reports that definition by name" {
  let after = hashes_of(
    [{ name: b"m.one", hash: b"zz" }, { name: b"m.two", hash: b"cc" }],
    [{ name: b"m.one", hash: b"zz" }, { name: b"m.two", hash: b"cc" }],
    [],
  );
  assert_eq(
    difference(two_definitions(b"bb"), after, "m.two"),
    Some("the replacement of `m.two` also changes `m.one`"),
  )
}

test "a replacement that renames a definition says what it added and what it took away" {
  let renamed = hashes_of(
    [{ name: b"m.one", hash: b"aa" }, { name: b"m.twice", hash: b"bb" }],
    [{ name: b"m.one", hash: b"aa" }, { name: b"m.twice", hash: b"bb" }],
    [],
  );
  assert_eq(
    difference(two_definitions(b"bb"), renamed, "m.two"),
    Some("the replacement of `m.two` adds `m.twice` and removes `m.two`"),
  )
}

test "replacing a `fn` can change the hash of a type that uses it, but replacing a type reports no other changed names" {
  let as_fn = hashes_of([{ name: b"m.two", hash: b"bb" }], [], [{ name: b"m.Shape", hash: b"dd" }]);
  let after = hashes_of([{ name: b"m.two", hash: b"cc" }], [], [{ name: b"m.Shape", hash: b"ee" }]);
  assert_eq(changed_names(as_fn, after, b"m.two"), ["m.Shape"]);
  let as_type = hashes_of([], [], [{ name: b"m.Shape", hash: b"dd" }]);
  let moved = hashes_of([], [], [{ name: b"m.Shape", hash: b"ee" }]);
  assert_eq(changed_names(as_type, moved, b"m.Shape"), [])
}

test "a replace run prints a line saying whether it replaced, would replace or left the definition unchanged, and prints nothing if no definition was found" {
  let p = a_program({ label: "cwd", path: "m.ply" });
  assert_eq(output_lines(p, flags_of(false), Some(example_definition()), false), [
    "m.two in m.ply is unchanged",
  ]);
  assert_eq(output_lines(p, flags_of(false), Some(example_definition()), true), [
    "replaced m.two in m.ply",
  ]);
  assert_eq(output_lines(p, flags_of(true), Some(example_definition()), true), [
    "would replace m.ply",
  ]);
  assert_eq(output_lines(p, flags_of(false), None, false), [])
}

test "a replace run names the file at the path it was read from, whether the path is under the working directory or absolute" {
  let under = a_program({ label: "cwd", path: "app/m.ply" });
  assert_eq(output_lines(under, flags_of(false), Some(example_definition()), true), [
    "replaced m.two in app/m.ply",
  ]);
  let outside_it = a_program({ label: "abs", path: "srv/app/m.ply" });
  assert_eq(output_lines(outside_it, flags_of(true), Some(example_definition()), true), [
    "would replace /srv/app/m.ply",
  ])
}

test "a replacement is written to the same path, through the same file system handler, that the file was read with" {
  let at: RootedPath = { label: "abs", path: "srv/app/m.ply" };
  let result = handle {
    written(
      plain(),
      flags_of(false),
      a_program(at),
      example_definition(),
      a_file(at),
      b"fn two() -> Int = 1 + 1\n",
    )
  } with {
    fs.write_file[cwd](path, body) -> panic("a file read under `abs` is written under `abs`"),
    fs.write_file[abs](path, body) -> path == "srv/app/m.ply",
  };
  assert_eq(result.code, 0);
  assert_eq(result.lines, ["replaced m.two in /srv/app/m.ply"])
}

test "a rejection exits 2, writes no line, and renders the diagnostic to the error stream" {
  let result = replace_output(
    plain(),
    flags_of(false),
    a_program({ label: "cwd", path: "m.ply" }),
    Some(example_definition()),
    false,
    [not_the_same(example_definition(), "the replacement of `m.two` adds `m.twice`")],
  );
  assert_eq(result.code, 2);
  assert_eq(result.lines, []);
  assert_eq(
    match result.errs.at(0) { Some(l) -> l, None -> "" },
    "Error[E0128]: the replacement of `m.two` adds `m.twice`",
  )
}
