import compiler.load (LoadedAnalysis)
import diagnostic (SourceText)
import lock (Pin)
import compiler.check.resolve.tables (Diagnostic)
import entry (Main, Module)

pub nondet effect builder {
  read loaded[r](root: String, front: LoadedAnalysis) -> Result<LoadedProgram, Refusal>
  read git[r](root: String, key: String) -> Option<String>
}

pub type Refusal = { diagnostics: List<Diagnostic>, places: List<SourceText> }

pub type LoadedProgram = {
  root: String,
  mains: List<Main>,
  modules: List<Module>,
  places: List<SourceText>,
  pins: List<Pin>,
  binary_bytes: Option<Int>,
  version: String,
}
