//! `ply cache` — what the store under `.ply-cache` and the memo store beside it hold, what clearing
//! or compacting them did, and what a load answers for one definition; and what the four
//! subcommands say about it in both forms.

import compiler.load (Derives)
import args (Flags, no_flags, style_of)
import builder (builder)
import env (env)
import compiler.unit (shipped)
import compiler.front
import compiler.front.facts (View)
import compiler.front.rows (Outlined, OType, KnownTestRow)
import compiler.front.published (FiledBody, FiledDef, body_encoding, filed_bodies, interfaces_of)
import compiler.check.infer.checker (CtorInfo, DefInfo, EffectInfo, OpInfo, TestInfo, Location)
import compiler.store.memo_files
import compiler.check.resolve.tables (Diag, qualify)
import compiler.syntax.type_syntax (mode_text)
import compiler.check.types (Type, type_text)
import diagnostic (spot_of)
import loads
import paths
import program (Program, load_program, program_view)
import queried
import std.bin
import std.bytes
import std.fs (fs)
import std.random (entropy)
import std.time (time)
import store.engine
import store.tables
import compiler.store.hash.forms (by_name)
import compiler.store.hash.encoding (hex)
import diagnostic (all_to_json, all_to_text)
import report (Answer, indent, ok_code, compile_error, count_of, warning_lines)
import std.json (Json, Null, Str, Bool, Number, Array, Member, object, to_string, int,
                 string_or_null, strings, strings_or_null)
import std.list
