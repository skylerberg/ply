pub type Rejection = {
  directory: Option<String>,
  diagnostics: List<Diagnostic>,
  warnings: List<Diagnostic>,
}

pub type Stats = {
  directory: String,
  warnings: List<Diagnostic>,
  format: Int,
  root: String,
  open_us: Int,
  results: Int,
  definitions_seen: Int,
  obligations: Int,
  reviews: Int,
  texts: Int,
  segments: Int,
  data_bytes: Int,
  garbage_bytes: Int,
  memo: memo_files::Usage,
}

pub type PruneCounts = { texts: Int }

pub type CompactResult = {
  directory: String,
  warnings: List<Diagnostic>,
  dropped: PruneCounts,
  memo: memo_files::Compaction,
  bytes_before: Int,
  bytes_after: Int,
  results: Int,
}

pub type ClearResult = { directory: String, warnings: List<Diagnostic>, cleared: Int }

pub type EntryKind = | FnEntry | TypeEntry | EffectEntry | TestEntry(Bool)

pub type EffectHash = { name: String, hash: String }

pub type Variant = { name: String, fields: List<String> }

pub type Operation = {
  mode: String,
  name: String,
  resource: Bool,
  params: List<String>,
  return_type: String,
}

pub type Interface =
  | FunctionInterface(String)
  | TypeInterface(Int, List<Variant>)
  | EffectInterface(Bool, List<Operation>)
  | TestInterface(Bool)

pub type Outcome = | Passed | Failed(String)

pub type Entry = {
  name: String,
  kind: EntryKind,
  hash: String,
  file: String,
  location: Option<String>,
  interface: Interface,
  effects: Option<List<String>>,
  effect_hashes: List<EffectHash>,
  body: Option<Int>,
  outcome: Option<Outcome>,
}

pub type Matches = { directory: String, warnings: List<Diagnostic>, entries: List<Entry> }

fn decimal(text: String) -> Json =
  match Decimal::of_string(text) { Some(d) -> Number(d), None -> int(0) }

fn size_text(n: Int) -> String = size(n, digits: 2, rounding: HalfUp)

fn share(part: Int, whole: Int, per: Int) -> Int =
  if whole == 0 { 0 } else { (part * per + whole / 2) / whole }

fn compact_suggested(stats: Stats) -> Bool =
  (stats.data_bytes > 0 && stats.garbage_bytes * 2 > stats.data_bytes)
    || (stats.memo.bytes > 0 && stats.memo.reclaimable_bytes * 2 > stats.memo.bytes)

fn failure_output(
  style: Style,
  action: String,
  reason: Rejection,
) -> CommandOutput / {abort.raise} = {
  let head: List<Member> = [
    { key: "command", value: Str("cache") },
    { key: "action", value: Str(action) },
    { key: "ok", value: Bool(false) },
    { key: "exit_code", value: int(compile_error()) },
    { key: "diagnostics", value: all_to_json(reason.diagnostics, []) },
  ];
  let body = match reason.directory {
    None -> head,
    Some(dir) ->
      head.concat([
        { key: "directory", value: Str(dir) },
        { key: "warnings", value: all_to_json(reason.warnings, []) },
      ]),
  };
  {
    json: object(body),
    lines: warning_lines(style, reason.warnings),
    errs: all_to_text(style, reason.diagnostics, []),
    code: compile_error(),
  }
}

fn no_match(query: String) -> Diagnostic =
  {
    code: b"E0101",
    notes: 1,
    labels: [],
    text: b"",
    message: Bytes::of_string("the program defines nothing under `" ++ query ++ "`"),
    notes_text: [
      b"the query is a program-wide name, a simple name, or a hash prefix of 4+ hex digits",
    ],
    severity: b"error",
    fixes: [],
  }

fn store_json(stats: Stats) -> Json = {
  let ratio = decimal(fixed_point(share(stats.garbage_bytes, stats.data_bytes, 1000000), 6));
  object([
    { key: "segments", value: int(stats.segments) },
    { key: "data_bytes", value: int(stats.data_bytes) },
    { key: "garbage_bytes", value: int(stats.garbage_bytes) },
    { key: "garbage_ratio", value: ratio },
    { key: "compact_suggested", value: Bool(compact_suggested(stats)) },
  ])
}

fn memo_json(u: memo_files::Usage) -> Json =
  object([
    { key: "records", value: int(u.records) },
    { key: "answers", value: int(u.results) },
    { key: "answer_bytes", value: int(u.output_bytes) },
    { key: "unread_bytes", value: int(u.unreferenced_bytes) },
    { key: "foreign", value: int(u.foreign) },
    { key: "reclaimable_bytes", value: int(u.reclaimable_bytes) },
    { key: "segments", value: int(u.segments) },
    { key: "bytes", value: int(u.bytes) },
  ])

fn stats_json(stats: Stats) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("cache") },
    { key: "action", value: Str("stats") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code()) },
    { key: "format", value: int(stats.format) },
    { key: "root", value: Str(stats.root) },
    { key: "directory", value: Str(stats.directory) },
    { key: "open_ms", value: decimal(fixed_point(stats.open_us, 3)) },
    { key: "entries", value: int(stats.results) },
    { key: "definitions_seen", value: int(stats.definitions_seen) },
    { key: "obligations", value: int(stats.obligations) },
    { key: "reviews", value: int(stats.reviews) },
    { key: "history", value: object([{ key: "texts", value: int(stats.texts) }]) },
    { key: "store", value: store_json(stats) },
    { key: "memo", value: memo_json(stats.memo) },
    { key: "warnings", value: all_to_json(stats.warnings, []) },
  ])

fn reclaimable(style: Style, stats: Stats) -> String =
  dim(
    style,
    size_text(stats.garbage_bytes) ++ " ("
      ++ share(stats.garbage_bytes, stats.data_bytes, 100).to_string()
      ++ "%)",
  )

fn stats_lines(style: Style, stats: Stats) -> List<String> / {abort.raise} = {
  let opened = fixed_point(share(stats.open_us, 1000, 100), 2) ++ "ms";
  let head = [
    indent() ++ dim(style, stats.directory),
    indent() ++ "opened in " ++ bold(style, opened),
    indent() ++ "store format " ++ stats.format.to_string(),
    indent() ++ "results · " ++ bold(style, stats.results.to_string()) ++ " cached "
      ++ plural(stats.results, "result")
      ++ " · "
      ++ count_of(stats.definitions_seen, "definition")
      ++ " seen",
    indent() ++ "prover · " ++ bold(style, stats.obligations.to_string()) ++ " discharged "
      ++ plural(stats.obligations, "obligation")
      ++ " · "
      ++ stats.reviews.to_string()
      ++ " accepted "
      ++ plural(stats.reviews, "review"),
    indent() ++ "history · " ++ bold(style, stats.texts.to_string()) ++ " definition "
      ++ plural(stats.texts, "text"),
    indent() ++ "  " ++ count_of(stats.segments, "segment") ++ " "
      ++ dim(style, size_text(stats.data_bytes))
      ++ " · reclaimable "
      ++ reclaimable(style, stats),
    indent() ++ "memo · " ++ bold(style, stats.memo.records.to_string()) ++ " "
      ++ plural(stats.memo.records, "record")
      ++ " · "
      ++ count_of(stats.memo.results, "longer result"),
    indent() ++ "  " ++ count_of(stats.memo.segments, "segment") ++ " "
      ++ dim(style, size_text(stats.memo.bytes))
      ++ " · results "
      ++ dim(style, size_text(stats.memo.output_bytes))
      ++ " · reclaimable "
      ++ dim(style, size_text(stats.memo.reclaimable_bytes))
      ++ (if stats.memo.foreign == 0 { "" }
      else { " (" ++ count_of(stats.memo.foreign, "record") ++ " of another `ply`)" }),
  ];
  let advised = if compact_suggested(stats) {
    head.push(
      indent() ++ "  "
        ++ yellow(style, "more than half of what is kept is unreachable; run `ply cache compact`"),
    )
  } else { head };
  if stats.results == 0 { advised } else {
    advised.push(
      indent() ++ "  "
        ++ dim(
          style,
          "the cache stores one result per test per version of its code, so a test can have several results",
        ),
    )
  }
}

fn reclaimed(c: CompactResult) -> Int =
  if c.bytes_before > c.bytes_after { c.bytes_before - c.bytes_after } else { 0 }

fn compact_json(c: CompactResult) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("cache") },
    { key: "action", value: Str("compact") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code()) },
    { key: "directory", value: Str(c.directory) },
    {
      key: "dropped",
      value: object([
        { key: "texts", value: int(c.dropped.texts) },
        { key: "records", value: int(c.memo.records) },
        { key: "answers", value: int(c.memo.results) },
      ]),
    },
    { key: "bytes_before", value: int(c.bytes_before) },
    { key: "bytes_after", value: int(c.bytes_after) },
    { key: "reclaimed_bytes", value: int(reclaimed(c)) },
    { key: "results", value: int(c.results) },
    { key: "warnings", value: all_to_json(c.warnings, []) },
  ])

fn compact_lines(style: Style, c: CompactResult) -> List<String> / {abort.raise} = {
  let d = c.dropped;
  let head = [indent() ++ green(style, "compacted") ++ " " ++ dim(style, c.directory)];
  let pruned = if d.texts == 0 { head } else {
    head.push(
      indent() ++ "  dropped " ++ count_of(d.texts, "cached source text")
        ++ " that no check or build used",
    )
  };
  let swept = if c.memo.records + c.memo.results == 0 { pruned } else {
    pruned.push(
      indent() ++ "  dropped " ++ count_of(c.memo.records, "record") ++ " · "
        ++ count_of(c.memo.results, "result")
        ++ " nothing reads",
    )
  };
  let sized = if reclaimed(c) == 0 {
    swept.push(
      indent() ++ "  " ++ size_text(c.bytes_after) ++ " · " ++ dim(style, "nothing to reclaim"),
    )
  } else {
    swept.push(
      indent() ++ "  " ++ size_text(c.bytes_before) ++ " → " ++ size_text(c.bytes_after) ++ " ("
        ++ bold(style, size_text(reclaimed(c)))
        ++ " reclaimed)",
    )
  };
  sized.push(
    indent() ++ "  " ++ dim(style, "compacting keeps every test result, so no test runs again"),
  )
}

fn clear_json(c: ClearResult) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("cache") },
    { key: "action", value: Str("clear") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code()) },
    { key: "directory", value: Str(c.directory) },
    { key: "cleared", value: int(c.cleared) },
    { key: "warnings", value: all_to_json(c.warnings, []) },
  ])

fn clear_lines(style: Style, c: ClearResult) -> List<String> / {abort.raise} =
  [
    indent() ++ green(style, "cleared") ++ " " ++ c.cleared.to_string() ++ " cached "
      ++ plural(c.cleared, "result")
      ++ " from "
      ++ dim(style, c.directory),
  ]

fn listed_effects(text: Bytes) -> List<String> =
  if text.len() == 0 { [] }
  else if text.starts_with(b"<") { [String::of_bytes_lossy(text)] }
  else { text.split(b",").map(String::of_bytes_lossy) }

fn effect_hashes_of(ws: List<{ name: Bytes, hash: Bytes }>) -> List<EffectHash> / {abort.raise} =
  ws.map(|w: { name: Bytes, hash: Bytes }|
    { name: String::of_bytes_lossy(w.name), hash: String::of_bytes_lossy(hex(w.hash)) })

type Field = { label: String, value: String }

fn short_hash(hash: String) -> String = if hash.len() < 12 { hash } else { hash.slice(0, 12) }

fn kind_text(k: EntryKind) -> String =
  match k {
    FnEntry -> "fn",
    TypeEntry -> "type",
    EffectEntry -> "effect",
    TestEntry(nd) -> if nd { "test/nondet" } else { "test" },
  }

fn title_of(entry: Entry) -> String =
  match entry.kind { TestEntry(_) -> quoted(entry.name), _ -> entry.name }

fn entry_location(entry: Entry) -> String =
  match entry.location { Some(l) -> l, None -> entry.file }

fn variant_text(v: Variant) -> String =
  if v.fields.len() == 0 { v.name } else { v.name ++ "(" ++ String::join(v.fields, ", ") ++ ")" }

fn operation_text(o: Operation) -> String = {
  let resource = if o.resource { "[r]" } else { "" };
  o.mode ++ " " ++ o.name ++ resource ++ "(" ++ String::join(o.params, ", ") ++ ")"
    ++ (if o.mode == "raise" { "" } else { " -> " ++ o.return_type })
}

fn labeled_fields(label: String, values: List<String>) -> List<Field> =
  range(0, values.len()).map(|i: Int|
    { label: if i == 0 { label } else { "" }, value: values.at_or(i, "") })

fn rows_of(entry: Entry) -> List<Field> = {
  let shape = match entry.interface {
    FunctionInterface(ty) -> [{ label: "type", value: ty }],
    TypeInterface(parameters, variants) ->
      [{ label: "parameters", value: parameters.to_string() }].concat(
        labeled_fields("variants", variants.map(variant_text)),
      ),
    EffectInterface(nd, operations) ->
      [{ label: "nondet", value: yes_no(nd) }].concat(
        labeled_fields("operations", operations.map(operation_text)),
      ),
    TestInterface(nd) -> [{ label: "nondet", value: yes_no(nd) }],
  };
  match entry.effects {
    Some(effects) -> shape.push({ label: "performs", value: braced(effects) }),
    None -> shape,
  }
}

fn not_a_test(entry: Entry) -> String =
  match entry.interface {
    TestInterface(_) ->
      "— no passing result is cached for this version of the test, so it runs next time",
    _ -> "— not a test",
  }

fn result_line(entry: Entry) -> String =
  match entry.outcome {
    Some(Passed) -> "passed — the test runs again only when something it read changes",
    Some(Failed(message)) -> "failed: " ++ message,
    None -> not_a_test(entry),
  }

fn effect_hashes_line(e: Entry) -> String =
  if e.effect_hashes.len() == 0 { "— no effects" } else {
    String::join(e.effect_hashes.map(|w: EffectHash| w.name ++ " → " ++ short_hash(w.hash)), ", ")
  }

fn body_line(entry: Entry) -> String / {abort.raise} =
  match entry.body {
    Some(bytes) -> count_of(bytes, "byte"),
    None -> "— no body: this declaration states only a signature",
  }

fn field_line(label: String, value: String) -> String =
  indent() ++ "  " ++ label.pad_right(10, " ") ++ " " ++ value

fn entry_lines(style: Style, entry: Entry) -> List<String> / {abort.raise} = {
  let head = indent() ++ bold(style, title_of(entry)) ++ "  " ++ dim(style, short_hash(entry.hash))
    ++ "  "
    ++ kind_text(entry.kind)
    ++ "  "
    ++ dim(style, entry_location(entry));
  let shape = rows_of(entry).fold([head], |accumulator: List<String>, f: Field|
    accumulator.push(field_line(f.label, f.value)));
  shape.concat([
    field_line("effects", effect_hashes_line(entry)),
    field_line("body", body_line(entry)),
    field_line("result", result_line(entry)),
  ])
}

fn interface_json(i: Interface) -> Json =
  match i {
    FunctionInterface(ty) -> object([{ key: "type", value: Str(ty) }]),
    TypeInterface(parameters, variants) ->
      object([
        { key: "parameters", value: int(parameters) },
        { key: "variants", value: strings(variants.map(variant_text)) },
      ]),
    EffectInterface(nd, operations) ->
      object([
        { key: "nondet", value: Bool(nd) },
        { key: "operations", value: strings(operations.map(operation_text)) },
      ]),
    TestInterface(nd) -> object([{ key: "nondet", value: Bool(nd) }]),
  }

fn body_json(b: Option<Int>) -> Json =
  match b { Some(bytes) -> object([{ key: "bytes", value: int(bytes) }]), None -> Null }

fn entry_json(e: Entry) -> Json =
  object([
    { key: "name", value: Str(title_of(e)) },
    { key: "hash", value: Str(short_hash(e.hash)) },
    { key: "kind", value: Str(kind_text(e.kind)) },
    { key: "file", value: Str(e.file) },
    { key: "location", value: string_or_null(e.location) },
    { key: "interface", value: interface_json(e.interface) },
    { key: "effects", value: strings_or_null(e.effects) },
    {
      key: "effect_hashes",
      value: Array(
        e.effect_hashes.map(|w: EffectHash|
          object([{ key: "name", value: Str(w.name) }, { key: "hash", value: Str(w.hash) }])),
      ),
    },
    { key: "body", value: body_json(e.body) },
    { key: "result", value: Str(result_line(e)) },
  ])

fn before(a: Entry, b: Entry) -> Bool =
  match compare_values(a.name, b.name) {
    Less -> true,
    Greater -> false,
    Equal -> match compare_values(a.hash, b.hash) {
      Less -> true,
      Greater -> false,
      Equal -> match compare_values(a.file, b.file) { Less -> true, _ -> false },
    },
  }

fn sorted_entries(entries: List<Entry>) -> List<Entry> =
  entries.fold([], |accumulator: List<Entry>, entry: Entry| {
    let n = accumulator.len();
    let i = range(0, n).fold(n, |p: Int, j: Int|
      if p < n { p } else if before(entry, accumulator.at_or(j, entry)) { j } else { p });
    range(0, i).map(|j: Int| accumulator.at_or(j, entry)).push(entry).concat(
      range(i, n).map(|j: Int| accumulator.at_or(j, entry)),
    )
  })

fn inspect_json(query: String, matches: Matches, entries: List<Entry>) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("cache") },
    { key: "action", value: Str("inspect") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code()) },
    { key: "query", value: Str(query) },
    { key: "directory", value: Str(matches.directory) },
    { key: "matches", value: Array(entries.map(entry_json)) },
    { key: "warnings", value: all_to_json(matches.warnings, []) },
  ])

fn inspect_lines(
  style: Style,
  query: String,
  entries: List<Entry>,
) -> List<String> / {abort.raise} = {
  let body = entries.fold([], |accumulator: List<String>, entry: Entry|
    List::concat(
      if accumulator.len() == 0 { accumulator } else { accumulator.push("") },
      entry_lines(style, entry),
    ));
  if entries.len() < 2 { body } else {
    body.concat([
      "",
      indent() ++ dim(style, count_of(entries.len(), "entry") ++ " matched `" ++ query ++ "`"),
    ])
  }
}

fn stats_result(style: Style, result: Result<Stats, Rejection>) -> CommandOutput / {abort.raise} =
  match result {
    Err(reason) -> failure_output(style, "stats", reason),
    Ok(st) ->
      {
        json: stats_json(st),
        lines: warning_lines(style, st.warnings).concat(stats_lines(style, st)),
        errs: [],
        code: ok_code(),
      },
  }

fn compact_result(
  style: Style,
  result: Result<CompactResult, Rejection>,
) -> CommandOutput / {abort.raise} =
  match result {
    Err(reason) -> failure_output(style, "compact", reason),
    Ok(c) ->
      {
        json: compact_json(c),
        lines: warning_lines(style, c.warnings).concat(compact_lines(style, c)),
        errs: [],
        code: ok_code(),
      },
  }

fn clear_result(
  style: Style,
  result: Result<ClearResult, Rejection>,
) -> CommandOutput / {abort.raise} =
  match result {
    Err(reason) -> failure_output(style, "clear", reason),
    Ok(c) ->
      {
        json: clear_json(c),
        lines: warning_lines(style, c.warnings).concat(clear_lines(style, c)),
        errs: [],
        code: ok_code(),
      },
  }

fn inspect_output(style: Style, query: String, matches: Matches) -> CommandOutput / {abort.raise} = {
  let entries = sorted_entries(matches.entries);
  if entries.len() == 0 {
    failure_output(style, "inspect", {
      directory: Some(matches.directory),
      diagnostics: [no_match(query)],
      warnings: matches.warnings,
    })
  } else {
    {
      json: inspect_json(query, matches, entries),
      lines: warning_lines(style, matches.warnings).concat(inspect_lines(style, query, entries)),
      errs: [],
      code: ok_code(),
    }
  }
}

fn inspect_result(
  s: Style,
  query: String,
  result: Result<Matches, Rejection>,
) -> CommandOutput / {abort.raise} =
  match result {
    Err(reason) -> failure_output(s, "inspect", reason),
    Ok(m) -> inspect_output(s, query, m),
  }

fn display_path(place: project_store::StoreLocation, name: String) -> String =
  paths::displayed({
    label: place.label,
    path: if name == "" { place.dir } else { place.dir ++ "/" ++ name },
  })

fn memo_dir(place: project_store::StoreLocation) -> String = place.dir ++ "/memo"

fn stats_of<[r]>(
  place: project_store::StoreLocation,
  current: Map<Bytes, Bool>,
) -> Stats / {fs.read[r], time.elapsed_us, abort.raise} = {
  let started = time.elapsed_us();
  let c = tables::open_cache[r](place.dir, place.stamps);
  let open_us = time.elapsed_us() - started;
  let u = tables::usage(c);
  {
    directory: display_path(place, ""),
    warnings: project_store::diagnostics_of(tables::warnings(c)),
    format: engine::format_version(),
    root: paths::displayed({
      label: place.label,
      path: if place.label == "cwd" { place.root } else { place.root.slice(1, place.root.len()) },
    }),
    open_us: open_us,
    results: u.counts.passed,
    definitions_seen: u.counts.seen,
    obligations: u.counts.evidence,
    reviews: u.counts.reviews,
    texts: u.counts.texts,
    segments: u.segments,
    data_bytes: u.data_bytes,
    garbage_bytes: if u.data_bytes > u.live_bytes { u.data_bytes - u.live_bytes } else { 0 },
    memo: memo_files::usage[r](memo_dir(place), current.keys()),
  }
}

fn disk_bytes<[r]>(place: project_store::StoreLocation) -> Int / {fs.read[r], abort.raise} =
  engine::disk_usage[r](place.dir) + memo_files::usage[r](memo_dir(place), []).bytes

fn compact_store<[r]>(
  place: project_store::StoreLocation,
  current: Map<Bytes, Bool>,
) -> CompactResult / {fs.read[r], fs.write[r], abort.raise} = {
  let before = disk_bytes[r](place);
  let c = tables::open_cache[r](place.dir, place.stamps);
  let pruned = tables::prune[r](c);
  let done = tables::compact_cache[r](pruned.cache);
  let memo = memo_files::compact[r](memo_dir(place), current.keys());
  {
    directory: display_path(place, ""),
    warnings: project_store::diagnostics_of(tables::warnings(done)),
    dropped: { texts: pruned.pruned.texts },
    memo: memo,
    bytes_before: before,
    bytes_after: disk_bytes[r](place),
    results: tables::counts(done).passed,
  }
}

fn clear_store<[r]>(
  place: project_store::StoreLocation,
) -> Result<ClearResult, Rejection> / {fs.read[r], fs.write[r], abort.raise} = {
  let c = tables::open_cache[r](place.dir, place.stamps);
  let before = tables::counts(c).passed;
  let stored = engine::clear_dir[r](place.dir);
  let memo = memo_dir(place);
  let gone = (!fs.exists[r](memo) || fs.remove_tree[r](memo)) && stored;
  let warnings = project_store::diagnostics_of(tables::warnings(c));
  if gone { Ok({ directory: display_path(place, ""), warnings: warnings, cleared: before }) } else {
    Err({
      directory: Some(display_path(place, "")),
      diagnostics: [
        {
          code: b"E0502",
          notes: 1,
          labels: [],
          text: b"",
          message: Bytes::of_string(
            "could not clear the cache at `" ++ display_path(place, "") ++ "`",
          ),
          notes_text: [b"check the directory's permissions, or delete it by hand"],
          severity: b"error",
          fixes: [],
        },
      ],
      warnings: warnings,
    })
  }
}

fn matches_query(query: String, name: Bytes, hash: Bytes) -> Bool / {abort.raise} = {
  let full = String::of_bytes_lossy(name);
  let segments = full.split(".");
  full == query || segments.at_or(segments.len() - 1, "") == query
    || (query.len() >= 4 && hash.hex_of().starts_with(query.ascii_lower()))
}

fn file_location(
  program: Program,
  at: Location,
) -> { file: String, location: Option<String> } / {abort.raise} =
  match program.source_texts.at(at.module) {
    Some(place) ->
      {
        file: place.path,
        location: if at.span.start > place.text.len() { None } else {
          let spot = position_of(place.text, at.span.start);
          Some(place.path ++ ":" ++ spot.line.to_string() ++ ":" ++ spot.column.to_string())
        },
      },
    None -> { file: "", location: None },
  }

fn operation_of(o: OperationInfo) -> Operation / {abort.raise} =
  {
    mode: String::of_bytes_lossy(mode_text(o.mode)),
    name: String::of_bytes_lossy(o.name),
    resource: o.resource_param,
    params: o.params.map(|t: Type| String::of_bytes_lossy(type_text(t))),
    return_type: String::of_bytes_lossy(type_text(o.return_type)),
  }

fn matches_in(
  program: Program,
  w: CheckedProgram,
  query: String,
  proven: Map<Bytes, Bool>,
) -> List<Entry> / {abort.raise} = {
  let definitions = by_name(w.frame.hashes.definitions);
  let declarations = by_name(w.frame.hashes.declarations);
  let read = all_body_facts(w.checked);
  let bodies = stored_bodies(w.frame.hashes).fold(
    Map::new(),
    |accumulator: Map<Bytes, Int>, b: StoredBody| accumulator.insert(b.hash, b.body.len()),
  );
  let hash_of = |name: Bytes, m: Map<Bytes, Bytes>| match m.get(name) { Some(h) -> h, None -> b"" };
  let body_of = |hash: Bytes| bodies.get(hash);
  let functions = w.checked.definitions.fold([], |accumulator: List<Entry>, d: DefinitionInfo| {
    let hash = hash_of(d.name, definitions);
    if !matches_query(query, d.name, hash) { accumulator } else {
      let at = file_location(program, d.at);
      let row = match definitions.get(d.name) {
        Some(h) -> Some(definition_known_row(declarations, d, h, read)),
        None -> None,
      };
      accumulator.push({
        name: String::of_bytes_lossy(d.name),
        kind: FnEntry,
        hash: hash.hex_of(),
        file: at.file,
        location: at.location,
        interface: FunctionInterface(match row {
          Some(_) -> String::of_bytes_lossy(scheme_text(d.scheme)),
          None -> "",
        }),
        effects: match row { Some(r) -> Some(listed_effects(r.effects)), None -> None },
        effect_hashes: match row { Some(r) -> effect_hashes_of(r.effect_hashes), None -> [] },
        body: body_of(hash),
        outcome: None,
      })
    }
  });
  let types = range(0, w.frame.outlines.len()).fold(
    functions,
    |accumulator: List<Entry>, i: Int| {
      let o = w.frame.outlines.get(i);
      o.items.fold(accumulator, |a: List<Entry>, item: OutlineItem|
        match item {
          OutlinedType(t) -> {
            let name = qualify(o.name, t.name);
            let hash = hash_of(name, declarations);
            if !matches_query(query, name, hash) { a } else {
              let at = file_location(program, { module: i, span: t.span });
              a.push({
                name: String::of_bytes_lossy(name),
                kind: TypeEntry,
                hash: hash.hex_of(),
                file: at.file,
                location: at.location,
                interface: TypeInterface(
                  t.arity,
                  w.checked.constructors.filter(|c: ConstructorInfo| c.type_name == name).map(
                    |c: ConstructorInfo|
                      {
                        name: String::of_bytes_lossy(c.simple_name),
                        fields: c.fields.map(|f: Type| String::of_bytes_lossy(type_text(f))),
                      },
                  ),
                ),
                effects: None,
                effect_hashes: [],
                body: None,
                outcome: None,
              })
            }
          },
          _ -> a,
        })
    },
  );
  let effects = w.checked.effects.fold(types, |accumulator: List<Entry>, e: EffectInfo| {
    let hash = hash_of(e.name, declarations);
    if !matches_query(query, e.name, hash) { accumulator } else {
      let at = file_location(program, e.at);
      accumulator.push({
        name: String::of_bytes_lossy(e.name),
        kind: EffectEntry,
        hash: hash.hex_of(),
        file: at.file,
        location: at.location,
        interface: EffectInterface(e.nondet, e.operations.map(operation_of)),
        effects: None,
        effect_hashes: [],
        body: None,
        outcome: None,
      })
    }
  });
  let rows = emitter_input::rows_from(w.checked, w.frame.hashes).tests.fold(
    Map::new(),
    |accumulator: Map<Bytes, KnownTestRow>, r: KnownTestRow| accumulator.insert(r.key, r),
  );
  w.checked.tests.fold(effects, |accumulator: List<Entry>, t: TestInfo| {
    let hash = match w.frame.hashes.tests.get(t.key) { Some(h) -> h, None -> b"" };
    if !matches_query(query, t.name, hash) && !matches_query(query, t.key, hash) { accumulator }
    else {
      let at = file_location(program, t.at);
      let row = rows.get(t.key);
      accumulator.push({
        name: String::of_bytes_lossy(t.name),
        kind: TestEntry(t.nondet),
        hash: hash.hex_of(),
        file: at.file,
        location: at.location,
        interface: TestInterface(t.nondet),
        effects: match row { Some(r) -> Some(listed_effects(r.effects)), None -> None },
        effect_hashes: match row { Some(r) -> effect_hashes_of(r.effect_hashes), None -> [] },
        body: None,
        outcome: if proven.contains(hash) { Some(Passed) } else { None },
      })
    }
  })
}

fn inspect_store<[r]>(
  place: project_store::StoreLocation,
  program: Program,
  query: String,
) -> Result<Matches, Rejection> / {fs.read[r], abort.raise} =
  match program_view(program) {
    None ->
      Err({
        directory: Some(display_path(place, "")),
        diagnostics: program.diagnostics,
        warnings: [],
      }),
    Some(w) -> {
      let c = tables::open_cache[r](place.dir, place.stamps);
      let proven = w.frame.hashes.tests.values().fold(
        Map::new(),
        |accumulator: Map<Bytes, Bool>, h: Bytes|
          if tables::passed[r](c, h).value == Some(true) { accumulator.insert(h, true) }
          else { accumulator },
      );
      Ok({
        directory: display_path(place, ""),
        warnings: project_store::diagnostics_of(tables::warnings(c)),
        entries: matches_in(program, w, query, proven),
      })
    },
  }

pub fn run(
  flags: Flags,
) -> CommandOutput / {semantics.cached, shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, time.elapsed_us, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise, diverges, shipped.report_view_used} = {
  let s: Style = style_of(flags);
  let place = project_store::store_location_of(flags.paths, project_store::shipped_stamps());
  let cwd = place.label == "cwd";
  if flags.action == "stats" {
    let current = module_queries::current_hashes();
    stats_result(
      s,
      Ok(if cwd { stats_of[cwd](place, current) } else { stats_of[abs](place, current) }),
    )
  } else if flags.action == "compact" {
    let current = module_queries::current_hashes();
    compact_result(
      s,
      Ok(if cwd { compact_store[cwd](place, current) } else { compact_store[abs](place, current) }),
    )
  } else if flags.action == "clear" {
    clear_result(s, if cwd { clear_store[cwd](place) } else { clear_store[abs](place) })
  } else {
    let program = load_program(flags.paths, flags.verify_dependencies);
    inspect_result(s, flags.query, if cwd { inspect_store[cwd](place, program, flags.query) }
    else { inspect_store[abs](place, program, flags.query) })
  }
}

fn no_stats() -> Stats =
  {
    directory: "/p/.ply-cache",
    warnings: [],
    format: 1,
    root: "/p",
    open_us: 0,
    results: 0,
    definitions_seen: 0,
    obligations: 0,
    reviews: 0,
    texts: 0,
    segments: 0,
    data_bytes: 0,
    garbage_bytes: 0,
    memo: {
      records: 0,
      results: 0,
      output_bytes: 0,
      unreferenced_bytes: 0,
      foreign: 0,
      reclaimable_bytes: 0,
      segments: 0,
      bytes: 0,
    },
  }

fn an_entry() -> Entry =
  {
    name: "m.active",
    kind: FnEntry,
    hash: "9f2c1a4e8b03c7d5e6f70819a2b3c4d5",
    file: "m.ply",
    location: Some("m.ply:4:1"),
    interface: FunctionInterface("(Int) -> List<Int>"),
    effects: None,
    effect_hashes: [],
    body: None,
    outcome: None,
  }

test "`size_text` shows bytes exactly and larger sizes in KiB or MiB with two decimal places" {
  assert_eq(size_text(0), "0 B");
  assert_eq(size_text(999), "999 B");
  assert_eq(size_text(1024), "1.00 KiB");
  assert_eq(size_text(12750000), "12.16 MiB");
  assert_eq(size_text(1048575), "1.00 MiB")
}

test "`compact_suggested` is true only when more than half of a store's bytes are garbage that compaction would remove" {
  let half: Stats = { ..no_stats(), data_bytes: 1000, garbage_bytes: 400 };
  assert(!compact_suggested(half));
  assert(compact_suggested({ ..half, garbage_bytes: 501 }));
  assert(!compact_suggested({ ..half, data_bytes: 0, garbage_bytes: 0 }));
  let results = {
    records: 2,
    results: 2,
    output_bytes: 1000,
    unreferenced_bytes: 501,
    foreign: 1,
    reclaimable_bytes: 601,
    segments: 1,
    bytes: 1200,
  };
  assert(compact_suggested({ ..half, memo: results }));
  assert(!compact_suggested({ ..half, memo: { ..results, reclaimable_bytes: 600 } }))
}

test "`stats_lines` prints the cache directory, open time, format and counts, followed by lines for the store and result sizes" {
  let st: Stats = {
    ..no_stats(),
    open_us: 1234,
    results: 2,
    definitions_seen: 3,
    obligations: 1,
    reviews: 0,
    texts: 4,
    segments: 2,
    data_bytes: 1000,
    garbage_bytes: 250,
    memo: {
      records: 3,
      results: 5,
      output_bytes: 2048,
      unreferenced_bytes: 0,
      foreign: 2,
      reclaimable_bytes: 1024,
      segments: 2,
      bytes: 4096,
    },
  };
  let lines = stats_lines(plain(), st);
  assert_eq(lines.at_or(0, ""), "   /p/.ply-cache");
  assert_eq(lines.at_or(1, ""), "   opened in 1.23ms");
  assert_eq(lines.at_or(2, ""), "   store format 1");
  assert_eq(lines.at_or(3, ""), "   results · 2 cached results · 3 definitions seen");
  assert_eq(lines.at_or(4, ""), "   prover · 1 discharged obligation · 0 accepted reviews");
  assert_eq(lines.at_or(5, ""), "   history · 4 definition texts");
  assert_eq(lines.at_or(6, ""), "     2 segments 1000 B · reclaimable 250 B (25%)");
  assert_eq(lines.at_or(7, ""), "   memo · 3 records · 5 longer results");
  assert_eq(
    lines.at_or(8, ""),
    "     2 segments 4.00 KiB · results 2.00 KiB · reclaimable 1.00 KiB (2 records of another `ply`)",
  );
  assert_eq(
    lines.at_or(9, ""),
    "     the cache stores one result per test per version of its code, so a test can have several results",
  )
}

test "an empty store has nothing to reclaim and no note about what an entry counts" {
  let lines = stats_lines(plain(), { ..no_stats(), segments: 1, data_bytes: 2 });
  assert_eq(lines.at_or(6, ""), "     1 segment 2 B · reclaimable 0 B (0%)");
  assert_eq(lines.len(), 9)
}

test "compaction that dropped nothing and reclaimed nothing still says what it did" {
  let c: CompactResult = {
    directory: "/p/.ply-cache",
    warnings: [],
    dropped: { texts: 0 },
    memo: { records: 0, results: 0, bytes: 0 },
    bytes_before: 900,
    bytes_after: 900,
    results: 2,
  };
  assert_eq(compact_lines(plain(), c), [
    "   compacted /p/.ply-cache",
    "     900 B · nothing to reclaim",
    "     compacting keeps every test result, so no test runs again",
  ]);
  let swept: CompactResult = {
    ..c,
    dropped: { texts: 2 },
    memo: { records: 1, results: 3, bytes: 300 },
    bytes_after: 400,
  };
  assert_eq(compact_lines(plain(), swept), [
    "   compacted /p/.ply-cache",
    "     dropped 2 cached source texts that no check or build used",
    "     dropped 1 record · 3 results nothing reads",
    "     900 B → 400 B (500 B reclaimed)",
    "     compacting keeps every test result, so no test runs again",
  ])
}

test "clearing names the count it discarded and where from" {
  assert_eq(clear_lines(plain(), { directory: "/p/.ply-cache", warnings: [], cleared: 1 }), [
    "   cleared 1 cached result from /p/.ply-cache",
  ]);
  assert_eq(clear_lines(plain(), { directory: "/p/.ply-cache", warnings: [], cleared: 0 }), [
    "   cleared 0 cached results from /p/.ply-cache",
  ])
}

test "a function's entry prints its resolved type rather than a serialization" {
  let e: Entry = { ..an_entry(), effects: Some(["m.db.read[users]"]) };
  assert_eq(entry_lines(plain(), e), [
    "   m.active  9f2c1a4e8b03  fn  m.ply:4:1",
    "     type       (Int) -> List<Int>",
    "     performs   {m.db.read[users]}",
    "     effects    — no effects",
    "     body       — no body: this declaration states only a signature",
    "     result     — not a test",
  ])
}

test "an effect declaration is one row per operation, and a type one per variant" {
  let operations = [
    { mode: "read", name: "now", resource: false, params: [], return_type: "Int" },
    { mode: "write", name: "set", resource: true, params: ["Int"], return_type: "Unit" },
  ];
  let e: Entry = {
    ..an_entry(),
    name: "m.wall",
    kind: EffectEntry,
    interface: EffectInterface(true, operations),
  };
  assert_eq(rows_of(e), [
    { label: "nondet", value: "yes" },
    { label: "operations", value: "read now() -> Int" },
    { label: "", value: "write set[r](Int) -> Unit" },
  ]);
  let shape: Entry = {
    ..an_entry(),
    name: "m.Shape",
    kind: TypeEntry,
    interface: TypeInterface(1, [
      { name: "Circle", fields: ["Int"] },
      { name: "Empty", fields: [] },
    ]),
  };
  assert_eq(rows_of(shape), [
    { label: "parameters", value: "1" },
    { label: "variants", value: "Circle(Int)" },
    { label: "", value: "Empty" },
  ])
}

test "a test's result line says whether the test has a recorded pass at its current hash, and so whether it will run again" {
  let unproven: Entry = {
    ..an_entry(),
    name: "one is one",
    kind: TestEntry(false),
    interface: TestInterface(false),
  };
  assert_eq(
    result_line(unproven),
    "— no passing result is cached for this version of the test, so it runs next time",
  );
  assert_eq(
    result_line({ ..unproven, kind: TestEntry(true), interface: TestInterface(true) }),
    "— no passing result is cached for this version of the test, so it runs next time",
  );
  assert_eq(
    result_line({ ..unproven, outcome: Some(Passed) }),
    "passed — the test runs again only when something it read changes",
  );
  assert_eq(result_line({ ..unproven, outcome: Some(Failed("1 != 2")) }), "failed: 1 != 2");
  assert_eq(title_of(unproven), "\"one is one\"");
  assert_eq(kind_text(TestEntry(true)), "test/nondet")
}

test "a name declared twice is ordered by name, then hash, then file" {
  let alpha: Entry = { ..an_entry(), name: "alpha.shared", hash: "bb", file: "alpha.ply" };
  let beta: Entry = { ..an_entry(), name: "beta.shared", hash: "aa", file: "beta.ply" };
  let fake: Entry = { ..an_entry(), name: "alpha.shared", hash: "aa", file: "alpha.ply" };
  assert_eq(sorted_entries([beta, alpha, fake]).map(|entry: Entry| entry.hash), ["aa", "bb", "aa"]);
  assert_eq(sorted_entries([alpha, fake, beta]).map(|entry: Entry| entry.name), [
    "alpha.shared",
    "alpha.shared",
    "beta.shared",
  ])
}

test "`inspect_lines` puts a blank line between the output for two matching entries, and ends with a line giving the number of entries matched" {
  let one: Entry = { ..an_entry(), name: "alpha.shared", file: "alpha.ply" };
  let two: Entry = { ..an_entry(), name: "beta.shared", file: "beta.ply" };
  let lines = inspect_lines(plain(), "shared", [one, two]);
  assert_eq(lines.at_or(5, "?"), "");
  assert_eq(lines.at_or(lines.len() - 1, ""), "   2 entries matched `shared`");
  assert_eq(inspect_lines(plain(), "shared", [one]).len(), 5)
}

fn run_with(
  flags: Flags,
  result: Result<Stats, Rejection>,
  hits: Result<Matches, Rejection>,
  swept: Result<CompactResult, Rejection>,
  emptied: Result<ClearResult, Rejection>,
) -> CommandOutput / {abort.raise} = {
  let s: Style = style_of(flags);
  if flags.action == "stats" { stats_result(s, result) }
  else if flags.action == "compact" { compact_result(s, swept) }
  else if flags.action == "clear" { clear_result(s, emptied) }
  else { inspect_result(s, flags.query, hits) }
}

fn no_rejection() -> Rejection = { directory: None, diagnostics: [], warnings: [] }

fn flags_of(action: String, query: String, json: Bool) -> Flags =
  { ..no_flags(), action: action, query: query, json: json }

fn only_stats(flags: Flags, stats: Stats) -> CommandOutput / {abort.raise} =
  run_with(flags, Ok(stats), Err(no_rejection()), Err(no_rejection()), Err(no_rejection()))

test "the `action` flag selects the cache subcommand, and the JSON output contains `command` and `action`" {
  let result = only_stats(flags_of("stats", "", true), { ..no_stats(), results: 2, data_bytes: 8 });
  assert_eq(result.code, 0);
  assert_eq(result.errs, []);
  let text = to_string(result.json);
  assert(text.contains("\"command\":\"cache\""));
  assert(text.contains("\"action\":\"stats\""));
  assert(text.contains("\"exit_code\":0"));
  assert(text.contains("\"entries\":2"));
  assert(text.contains("\"compact_suggested\":false"));
  assert(text.contains("\"format\":1"))
}

test "a cache store that cannot be opened exits with code 2 and its JSON output has no cache directory" {
  let reason: Rejection = {
    directory: None,
    diagnostics: [
      {
        code: b"E0502",
        notes: 0,
        labels: [],
        text: b"",
        message: b"could not open a cache under `/p`",
        notes_text: [],
        severity: b"error",
        fixes: [],
      },
    ],
    warnings: [],
  };
  let result = run_with(
    flags_of("clear", "", false),
    Err(reason),
    Err(reason),
    Err(reason),
    Err(reason),
  );
  assert_eq(result.code, 2);
  assert_eq(result.lines, []);
  assert_eq(result.errs, ["Error[E0502]: could not open a cache under `/p`"]);
  assert(!to_string(result.json).contains("\"directory\""))
}

test "a rejection after the store opened names the cache and carries its warnings" {
  let reason: Rejection = {
    directory: Some("/p/.ply-cache"),
    diagnostics: [
      {
        code: b"E0502",
        notes: 0,
        labels: [],
        text: b"",
        message: b"could not compact the cache at `/p/.ply-cache`",
        notes_text: [],
        severity: b"error",
        fixes: [],
      },
    ],
    warnings: [
      {
        code: b"W0603",
        notes: 0,
        labels: [],
        text: b"",
        message: b"the store was discarded",
        notes_text: [],
        severity: b"warning",
        fixes: [],
      },
    ],
  };
  let result = run_with(
    flags_of("compact", "", false),
    Err(reason),
    Err(reason),
    Err(reason),
    Err(reason),
  );
  assert_eq(result.code, 2);
  assert_eq(result.lines, ["   warning: the store was discarded"]);
  let text = to_string(result.json);
  assert(text.contains("\"action\":\"compact\""));
  assert(text.contains("\"directory\":\"/p/.ply-cache\""));
  assert(text.contains("\"W0603\""))
}

test "inspecting a name the program does not define is E0101 and exits two" {
  let empty: Matches = { directory: "/p/.ply-cache", warnings: [], entries: [] };
  let result = run_with(
    flags_of("inspect", "no_such_thing", false),
    Err(no_rejection()),
    Ok(empty),
    Err(no_rejection()),
    Err(no_rejection()),
  );
  assert_eq(result.code, 2);
  assert_eq(result.lines, []);
  assert_eq(result.errs, [
    "Error[E0101]: the program defines nothing under `no_such_thing`",
    "  = the query is a program-wide name, a simple name, or a hash prefix of 4+ hex digits",
  ])
}

test "a match is one object under `matches`, with the hash shortened and the type resolved" {
  let hits: Matches = { directory: "/p/.ply-cache", warnings: [], entries: [an_entry()] };
  let result = run_with(
    flags_of("inspect", "active", true),
    Err(no_rejection()),
    Ok(hits),
    Err(no_rejection()),
    Err(no_rejection()),
  );
  assert_eq(result.code, 0);
  let text = to_string(result.json);
  assert(text.contains("\"query\":\"active\""));
  assert(text.contains("\"name\":\"m.active\""));
  assert(text.contains("\"hash\":\"9f2c1a4e8b03\""));
  assert(text.contains("\"kind\":\"fn\""));
  assert(text.contains("\"location\":\"m.ply:4:1\""));
  assert(text.contains("\"type\":\"(Int) -> List<Int>\""))
}
