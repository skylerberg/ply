import std.string
import std.fmt (fixed_point, size)
import check (quoted)
import hosts (yes_no)
import proof.obligation (plural)
import compiler.front.seam

// --- What each subcommand found ---------------------------------------------

/// Why an action did not finish.
pub type Refusal = {
  /// `None` when no store opened at all, which is the one refusal with no cache to name.
  directory: Option<String>,
  diags: List<Diag>,
  warnings: List<Diag>,
}

pub type Stats = {
  directory: String,
  /// What the store degraded past on the way here; every subcommand reports them.
  warnings: List<Diag>,
  format: Int,
  root: String,
  /// Whole microseconds; the report prints milliseconds.
  open_us: Int,
  results: Int,
  definitions_seen: Int,
  obligations: Int,
  reviews: Int,
  /// What the store keeps of the definitions a pass ran, which a later era's bisection reads.
  defs: Int,
  bodies: Int,
  segments: Int,
  data_bytes: Int,
  /// The bytes of entries a later filing replaced or dropped, which compaction reclaims.
  garbage_bytes: Int,
  memo: memo_files::Usage,
}

pub type Pruned = { defs: Int, bodies: Int }

pub type Compacted = {
  directory: String,
  warnings: List<Diag>,
  dropped: Pruned,
  memo: memo_files::Compacted,
  bytes_before: Int,
  bytes_after: Int,
  /// The results compaction keeps.
  results: Int,
}

pub type Cleared = { directory: String, warnings: List<Diag>, cleared: Int }

pub type EntryKind = | FnEntry | TypeEntry | EffectEntry | TestEntry(Bool)

pub type EffectHash = { name: String, hash: String }

pub type Body = { encoding: Int, bytes: Int }

pub type Variant = { name: String, fields: List<String> }

pub type Operation = {
  mode: String,
  name: String,
  resource: Bool,
  params: List<String>,
  ret: String,
}

pub type Interface =
  | OfFn(String)
  | OfType(Int, List<Variant>)
  | OfEffect(Bool, List<Operation>)
  | OfTest(Bool)

pub type Outcome = | Passed | Failed(String)

/// One match as a report prints it.
pub type Entry = {
  /// A definition's program-wide name, or a test's name as it was written.
  name: String,
  kind: EntryKind,
  hash: String,
  file: String,
  location: Option<String>,
  interface: Interface,
  footprint: Option<List<String>>,
  effect_hashes: List<EffectHash>,
  body: Option<Body>,
  outcome: Option<Outcome>,
}

pub type Matches = { directory: String, warnings: List<Diag>, entries: List<Entry> }

// --- Small things -----------------------------------------------------------

// --- Fixed point ------------------------------------------------------------
// Every number a report rounds is counted in whole units first, so a size and a share read the
// same on every machine.

fn decimal(text: String) -> Json =
  match Decimal::of_string(text) { Some(d) -> Number(d), None -> int(0) }

/// A size as a person reads it: bytes exactly, and two decimals of the largest unit above that.
fn size_text(n: Int) -> String = size(n, digits: 2, rounding: HalfUp)

/// `part` of `whole`, counted in `per` of them; a whole of nothing is a share of nothing.
fn share(part: Int, whole: Int, per: Int) -> Int =
  if whole == 0 { 0 } else { (part * per + whole / 2) / whole }

/// Suggested, never done: more than half of the store's data file, or of the memo store, is what a
/// compaction drops.
fn compact_suggested(stats: Stats) -> Bool =
  (stats.data_bytes > 0 && stats.garbage_bytes * 2 > stats.data_bytes)
    || (stats.memo.bytes > 0 && stats.memo.reclaimable_bytes * 2 > stats.memo.bytes)

// --- The refusals -----------------------------------------------------------

/// One shape for every cache command, so an agent can key off `action` and `exit_code`.
fn stopped(style: Style, action: String, why: Refusal) -> Answer / {abort.raise} = {
  let head: List<Member> = [
    { key: "command", value: Str("cache") },
    { key: "action", value: Str(action) },
    { key: "ok", value: Bool(false) },
    { key: "exit_code", value: int(compile_error()) },
    { key: "diagnostics", value: all_to_json(why.diags, []) },
  ];
  // A store that never opened has no cache to name and raised no warning on the way.
  let body = match why.directory {
    None -> head,
    Some(dir) ->
      head.concat([
        { key: "directory", value: Str(dir) },
        { key: "warnings", value: all_to_json(why.warnings, []) },
      ]),
  };
  {
    json: object(body),
    lines: warning_lines(style, why.warnings),
    errs: all_to_text(style, why.diags, []),
    code: compile_error(),
  }
}

fn nothing_cached(query: String) -> Diag =
  {
    code: b"E0101",
    notes: 1,
    labels: [],
    text: b"",
    message: Bytes::of_string("the program defines nothing under `" ++ query ++ "`"),
    notes_text: [
      b"the query is a program-wide name, a simple name, or a hash prefix of 4+ hex digits",
    ],
    severity: b"error",
    fixes: [],
  }

// --- `ply cache stats` ------------------------------------------------------

fn store_json(stats: Stats) -> Json = {
  let ratio = decimal(fixed_point(share(stats.garbage_bytes, stats.data_bytes, 1000000), 6));
  object([
    { key: "segments", value: int(stats.segments) },
    { key: "data_bytes", value: int(stats.data_bytes) },
    { key: "garbage_bytes", value: int(stats.garbage_bytes) },
    { key: "garbage_ratio", value: ratio },
    { key: "compact_suggested", value: Bool(compact_suggested(stats)) },
  ])
}

fn memo_json(u: memo_files::Usage) -> Json =
  object([
    { key: "records", value: int(u.records) },
    { key: "answers", value: int(u.answers) },
    { key: "answer_bytes", value: int(u.answer_bytes) },
    { key: "unread_bytes", value: int(u.unread_bytes) },
    { key: "foreign", value: int(u.foreign) },
    { key: "reclaimable_bytes", value: int(u.reclaimable_bytes) },
    { key: "segments", value: int(u.segments) },
    { key: "bytes", value: int(u.bytes) },
  ])

fn stats_json(stats: Stats) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("cache") },
    { key: "action", value: Str("stats") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code()) },
    { key: "format", value: int(stats.format) },
    { key: "root", value: Str(stats.root) },
    { key: "directory", value: Str(stats.directory) },
    { key: "open_ms", value: decimal(fixed_point(stats.open_us, 3)) },
    { key: "entries", value: int(stats.results) },
    { key: "definitions_seen", value: int(stats.definitions_seen) },
    { key: "obligations", value: int(stats.obligations) },
    { key: "reviews", value: int(stats.reviews) },
    {
      key: "history",
      value: object([
        { key: "definitions", value: int(stats.defs) },
        { key: "bodies", value: int(stats.bodies) },
      ]),
    },
    { key: "store", value: store_json(stats) },
    { key: "memo", value: memo_json(stats.memo) },
    { key: "warnings", value: all_to_json(stats.warnings, []) },
  ])

fn reclaimable(style: Style, stats: Stats) -> String =
  dim(
    style,
    size_text(stats.garbage_bytes) ++ " ("
      ++ share(stats.garbage_bytes, stats.data_bytes, 100).to_string()
      ++ "%)",
  )

fn stats_lines(style: Style, stats: Stats) -> List<String> / {abort.raise} = {
  let opened = fixed_point(share(stats.open_us, 1000, 100), 2) ++ "ms";
  let head = [
    indent() ++ dim(style, stats.directory),
    indent() ++ "opened in " ++ bold(style, opened),
    indent() ++ "store format " ++ stats.format.to_string(),
    indent() ++ "results · " ++ bold(style, stats.results.to_string()) ++ " cached "
      ++ plural(stats.results, "result")
      ++ " · "
      ++ count_of(stats.definitions_seen, "definition")
      ++ " seen",
    indent() ++ "prover · " ++ bold(style, stats.obligations.to_string()) ++ " discharged "
      ++ plural(stats.obligations, "obligation")
      ++ " · "
      ++ stats.reviews.to_string()
      ++ " accepted "
      ++ plural(stats.reviews, "review"),
    indent() ++ "history · " ++ bold(style, stats.defs.to_string()) ++ " "
      ++ plural(stats.defs, "definition")
      ++ " · "
      ++ count_of(stats.bodies, "body"),
    indent() ++ "  " ++ count_of(stats.segments, "segment") ++ " "
      ++ dim(style, size_text(stats.data_bytes))
      ++ " · reclaimable "
      ++ reclaimable(style, stats),
    indent() ++ "memo · " ++ bold(style, stats.memo.records.to_string()) ++ " "
      ++ plural(stats.memo.records, "record")
      ++ " · "
      ++ count_of(stats.memo.answers, "longer answer"),
    indent() ++ "  " ++ count_of(stats.memo.segments, "segment") ++ " "
      ++ dim(style, size_text(stats.memo.bytes))
      ++ " · answers "
      ++ dim(style, size_text(stats.memo.answer_bytes))
      ++ " · reclaimable "
      ++ dim(style, size_text(stats.memo.reclaimable_bytes))
      ++ (if stats.memo.foreign == 0 { "" }
      else { " (" ++ count_of(stats.memo.foreign, "record") ++ " of another `ply`)" }),
  ];
  let advised = if compact_suggested(stats) {
    head.push(
      indent() ++ "  "
        ++ yellow(style, "more than half of what is kept is unreachable; run `ply cache compact`"),
    )
  } else { head };
  // A hybrid program earns a real cache entry, which a reader could mistake for corruption.
  if stats.results == 0 { advised } else {
    advised.push(
      indent() ++ "  " ++ dim(style, "a result entry is one proven configuration, not one test"),
    )
  }
}

// --- `ply cache compact` ----------------------------------------------------

fn reclaimed(c: Compacted) -> Int =
  if c.bytes_before > c.bytes_after { c.bytes_before - c.bytes_after } else { 0 }

fn compact_json(c: Compacted) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("cache") },
    { key: "action", value: Str("compact") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code()) },
    { key: "directory", value: Str(c.directory) },
    {
      key: "dropped",
      value: object([
        { key: "definitions", value: int(c.dropped.defs) },
        { key: "bodies", value: int(c.dropped.bodies) },
        { key: "records", value: int(c.memo.records) },
        { key: "answers", value: int(c.memo.answers) },
      ]),
    },
    { key: "bytes_before", value: int(c.bytes_before) },
    { key: "bytes_after", value: int(c.bytes_after) },
    { key: "reclaimed_bytes", value: int(reclaimed(c)) },
    { key: "results", value: int(c.results) },
    { key: "warnings", value: all_to_json(c.warnings, []) },
  ])

fn compact_lines(style: Style, c: Compacted) -> List<String> / {abort.raise} = {
  let d = c.dropped;
  let head = [indent() ++ green(style, "compacted") ++ " " ++ dim(style, c.directory)];
  // Only what was dropped; zeroes would read as though something happened.
  let pruned = if d.defs + d.bodies == 0 { head } else {
    head.push(
      indent() ++ "  dropped " ++ count_of(d.defs, "definition") ++ " · "
        ++ count_of(d.bodies, "body")
        ++ " no pass ran",
    )
  };
  let swept = if c.memo.records + c.memo.answers == 0 { pruned } else {
    pruned.push(
      indent() ++ "  dropped " ++ count_of(c.memo.records, "record") ++ " · "
        ++ count_of(c.memo.answers, "answer")
        ++ " nothing reads",
    )
  };
  let sized = if reclaimed(c) == 0 {
    swept.push(
      indent() ++ "  " ++ size_text(c.bytes_after) ++ " · " ++ dim(style, "nothing to reclaim"),
    )
  } else {
    swept.push(
      indent() ++ "  " ++ size_text(c.bytes_before) ++ " → " ++ size_text(c.bytes_after) ++ " ("
        ++ bold(style, size_text(reclaimed(c)))
        ++ " reclaimed)",
    )
  };
  sized.push(indent() ++ "  " ++ dim(style, "every result is kept, so no test re-runs"))
}

// --- `ply cache clear` ------------------------------------------------------

fn clear_json(c: Cleared) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("cache") },
    { key: "action", value: Str("clear") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code()) },
    { key: "directory", value: Str(c.directory) },
    { key: "cleared", value: int(c.cleared) },
    { key: "warnings", value: all_to_json(c.warnings, []) },
  ])

fn clear_lines(style: Style, c: Cleared) -> List<String> / {abort.raise} =
  [
    indent() ++ green(style, "cleared") ++ " " ++ c.cleared.to_string() ++ " cached "
      ++ plural(c.cleared, "result")
      ++ " from "
      ++ dim(style, c.directory),
  ]

// --- `ply cache inspect` ----------------------------------------------------

/// A row's atoms, one per line of the footprint: a row is written `atom,atom`, and one headed by the
/// labels its atoms bind is shown whole.
fn atoms_listed(row: Bytes) -> List<String> =
  if row.len() == 0 { [] }
  else if row.starts_with(b"<") { [String::of_bytes_lossy(row)] }
  else { row.split(b",").map(String::of_bytes_lossy) }

fn effect_hashes_of(ws: List<{ name: Bytes, hash: Bytes }>) -> List<EffectHash> / {abort.raise} =
  ws.map(|w: { name: Bytes, hash: Bytes }|
    { name: String::of_bytes_lossy(w.name), hash: String::of_bytes_lossy(hex(w.hash)) })

type Field = { label: String, value: String }

fn short(hash: String) -> String = if hash.len() < 12 { hash } else { hash.slice(0, 12) }

fn kind_text(k: EntryKind) -> String =
  match k {
    FnEntry -> "fn",
    TypeEntry -> "type",
    EffectEntry -> "effect",
    TestEntry(nd) -> if nd { "test/nondet" } else { "test" },
  }

fn title_of(entry: Entry) -> String =
  match entry.kind { TestEntry(_) -> quoted(entry.name), _ -> entry.name }

fn where_of(entry: Entry) -> String = match entry.location { Some(l) -> l, None -> entry.file }

fn variant_text(v: Variant) -> String =
  if v.fields.len() == 0 { v.name } else { v.name ++ "(" ++ String::join(v.fields, ", ") ++ ")" }

fn operation_text(o: Operation) -> String = {
  let resource = if o.resource { "[r]" } else { "" };
  o.mode ++ " " ++ o.name ++ resource ++ "(" ++ String::join(o.params, ", ") ++ ")"
    ++ (if o.mode == "raise" { "" } else { " -> " ++ o.ret })
}

fn braced(atoms: List<String>) -> String = "{" ++ String::join(atoms, ", ") ++ "}"

/// The label is blank on continuation lines, so a multi-variant type reads as one block.
fn listed(label: String, values: List<String>) -> List<Field> =
  range(0, values.len()).map(|i: Int|
    { label: if i == 0 { label } else { "" }, value: values.at_or(i, "") })

fn rows_of(entry: Entry) -> List<Field> = {
  let shape = match entry.interface {
    OfFn(ty) -> [{ label: "type", value: ty }],
    OfType(parameters, variants) ->
      [{ label: "parameters", value: parameters.to_string() }].concat(
        listed("variants", variants.map(variant_text)),
      ),
    OfEffect(nd, ops) ->
      [{ label: "nondet", value: yes_no(nd) }].concat(
        listed("operations", ops.map(operation_text)),
      ),
    OfTest(nd) -> [{ label: "nondet", value: yes_no(nd) }],
  };
  match entry.footprint {
    Some(atoms) -> shape.push({ label: "footprint", value: braced(atoms) }),
    None -> shape,
  }
}

fn not_a_test(entry: Entry) -> String =
  match entry.interface {
    OfTest(_) -> "— not proven at this hash, so it runs next time",
    _ -> "— not a test",
  }

fn result_line(entry: Entry) -> String =
  match entry.outcome {
    Some(Passed) -> "passed — this hash re-runs only when something its run read changes",
    Some(Failed(message)) -> "failed: " ++ message,
    None -> not_a_test(entry),
  }

fn effect_hashes_line(e: Entry) -> String =
  if e.effect_hashes.len() == 0 { "— names no effect" } else {
    String::join(e.effect_hashes.map(|w: EffectHash| w.name ++ " → " ++ short(w.hash)), ", ")
  }

fn body_line(entry: Entry) -> String / {abort.raise} =
  match entry.body {
    Some(b) -> count_of(b.bytes, "byte") ++ " (encoding " ++ b.encoding.to_string() ++ ")",
    None -> "— none: a declaration's is its form",
  }

fn under(label: String, value: String) -> String =
  indent() ++ "  " ++ label.pad_right(10, " ") ++ " " ++ value

fn entry_lines(style: Style, entry: Entry) -> List<String> / {abort.raise} = {
  let head = indent() ++ bold(style, title_of(entry)) ++ "  " ++ dim(style, short(entry.hash))
    ++ "  "
    ++ kind_text(entry.kind)
    ++ "  "
    ++ dim(style, where_of(entry));
  let shape = rows_of(entry).fold([head], |acc: List<String>, f: Field|
    acc.push(under(f.label, f.value)));
  shape.concat([
    under("effects", effect_hashes_line(entry)),
    under("body", body_line(entry)),
    under("result", result_line(entry)),
  ])
}

fn interface_json(i: Interface) -> Json =
  match i {
    OfFn(ty) -> object([{ key: "type", value: Str(ty) }]),
    OfType(parameters, variants) ->
      object([
        { key: "parameters", value: int(parameters) },
        { key: "variants", value: strings(variants.map(variant_text)) },
      ]),
    OfEffect(nd, ops) ->
      object([
        { key: "nondet", value: Bool(nd) },
        { key: "operations", value: strings(ops.map(operation_text)) },
      ]),
    OfTest(nd) -> object([{ key: "nondet", value: Bool(nd) }]),
  }

fn body_json(b: Option<Body>) -> Json =
  match b {
    Some(v) ->
      object([{ key: "encoding", value: int(v.encoding) }, { key: "bytes", value: int(v.bytes) }]),
    None -> Null,
  }

fn entry_json(e: Entry) -> Json =
  object([
    { key: "name", value: Str(title_of(e)) },
    { key: "hash", value: Str(short(e.hash)) },
    { key: "kind", value: Str(kind_text(e.kind)) },
    { key: "file", value: Str(e.file) },
    { key: "location", value: string_or_null(e.location) },
    { key: "interface", value: interface_json(e.interface) },
    { key: "footprint", value: strings_or_null(e.footprint) },
    {
      key: "effect_hashes",
      value: Array(
        e.effect_hashes.map(|w: EffectHash|
          object([{ key: "name", value: Str(w.name) }, { key: "hash", value: Str(w.hash) }])),
      ),
    },
    { key: "body", value: body_json(e.body) },
    { key: "result", value: Str(result_line(e)) },
  ])

/// Independent of the order a load found them in, so the report is the same twice running.
fn before(a: Entry, b: Entry) -> Bool =
  match compare_values(a.name, b.name) {
    Less -> true,
    Greater -> false,
    Equal -> match compare_values(a.hash, b.hash) {
      Less -> true,
      Greater -> false,
      Equal -> match compare_values(a.file, b.file) { Less -> true, _ -> false },
    },
  }

fn ordered(entries: List<Entry>) -> List<Entry> =
  entries.fold([], |acc: List<Entry>, entry: Entry| {
    let n = acc.len();
    let i = range(0, n).fold(n, |p: Int, j: Int|
      if p < n { p } else if before(entry, acc.at_or(j, entry)) { j } else { p });
    range(0, i).map(|j: Int| acc.at_or(j, entry)).push(entry).concat(
      range(i, n).map(|j: Int| acc.at_or(j, entry)),
    )
  })

fn inspect_json(query: String, matches: Matches, entries: List<Entry>) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("cache") },
    { key: "action", value: Str("inspect") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code()) },
    { key: "query", value: Str(query) },
    { key: "directory", value: Str(matches.directory) },
    { key: "matches", value: Array(entries.map(entry_json)) },
    { key: "warnings", value: all_to_json(matches.warnings, []) },
  ])

fn inspect_lines(
  style: Style,
  query: String,
  entries: List<Entry>,
) -> List<String> / {abort.raise} = {
  let body = entries.fold([], |acc: List<String>, entry: Entry|
    List::concat(if acc.len() == 0 { acc } else { acc.push("") }, entry_lines(style, entry)));
  if entries.len() < 2 { body } else {
    body.concat([
      "",
      indent() ++ dim(style, count_of(entries.len(), "entry") ++ " matched `" ++ query ++ "`"),
    ])
  }
}

// --- The command ------------------------------------------------------------

fn stats_answer(style: Style, answer: Result<Stats, Refusal>) -> Answer / {abort.raise} =
  match answer {
    Err(why) -> stopped(style, "stats", why),
    Ok(st) ->
      {
        json: stats_json(st),
        lines: warning_lines(style, st.warnings).concat(stats_lines(style, st)),
        errs: [],
        code: ok_code(),
      },
  }

fn compact_answer(style: Style, answer: Result<Compacted, Refusal>) -> Answer / {abort.raise} =
  match answer {
    Err(why) -> stopped(style, "compact", why),
    Ok(c) ->
      {
        json: compact_json(c),
        lines: warning_lines(style, c.warnings).concat(compact_lines(style, c)),
        errs: [],
        code: ok_code(),
      },
  }

fn clear_answer(style: Style, answer: Result<Cleared, Refusal>) -> Answer / {abort.raise} =
  match answer {
    Err(why) -> stopped(style, "clear", why),
    Ok(c) ->
      {
        json: clear_json(c),
        lines: warning_lines(style, c.warnings).concat(clear_lines(style, c)),
        errs: [],
        code: ok_code(),
      },
  }

fn matched(style: Style, query: String, matches: Matches) -> Answer / {abort.raise} = {
  let entries = ordered(matches.entries);
  if entries.len() == 0 {
    stopped(style, "inspect", {
      directory: Some(matches.directory),
      diags: [nothing_cached(query)],
      warnings: matches.warnings,
    })
  } else {
    {
      json: inspect_json(query, matches, entries),
      lines: warning_lines(style, matches.warnings).concat(inspect_lines(style, query, entries)),
      errs: [],
      code: ok_code(),
    }
  }
}

fn inspect_answer(
  s: Style,
  query: String,
  answer: Result<Matches, Refusal>,
) -> Answer / {abort.raise} =
  match answer { Err(why) -> stopped(s, "inspect", why), Ok(m) -> matched(s, query, m) }

// --- Working the store ------------------------------------------------------

fn shown(place: loads::Place, name: String) -> String =
  paths::displayed({
    label: place.label,
    path: if name == "" { place.dir } else { place.dir ++ "/" ++ name },
  })

fn memo_dir(place: loads::Place) -> String = place.dir ++ "/memo"

/// What the store at `place` holds, `current` naming the queries this `ply` answers under.
fn stats_of<[r]>(
  place: loads::Place,
  current: Map<Bytes, Bool>,
) -> Stats / {fs.read[r], time.elapsed_us, abort.raise} = {
  let started = time.elapsed_us();
  let c = tables::open_cache[r](place.dir, place.stamps);
  let open_us = time.elapsed_us() - started;
  let u = tables::usage(c);
  {
    directory: shown(place, ""),
    warnings: loads::diags_of(tables::warnings(c)),
    format: engine::format(),
    root: paths::displayed({
      label: place.label,
      path: if place.label == "cwd" { place.root } else { place.root.slice(1, place.root.len()) },
    }),
    open_us: open_us,
    results: u.counts.passed,
    definitions_seen: u.counts.seen,
    obligations: u.counts.evidence,
    reviews: u.counts.reviews,
    defs: u.counts.defs,
    bodies: u.counts.bodies,
    segments: u.segments,
    data_bytes: u.data_bytes,
    garbage_bytes: if u.data_bytes > u.live_bytes { u.data_bytes - u.live_bytes } else { 0 },
    memo: memo_files::usage[r](memo_dir(place), current.keys()),
  }
}

/// Bytes the store and the memo store's segments take on disk.
fn kept_bytes<[r]>(place: loads::Place) -> Int / {fs.read[r], abort.raise} =
  engine::kept_bytes[r](place.dir) + memo_files::usage[r](memo_dir(place), []).bytes

fn compacted_of<[r]>(
  place: loads::Place,
  current: Map<Bytes, Bool>,
) -> Compacted / {fs.read[r], fs.write[r], abort.raise} = {
  let before = kept_bytes[r](place);
  let c = tables::open_cache[r](place.dir, place.stamps);
  let pruned = tables::prune[r](c);
  let done = tables::compact_cache[r](pruned.cache);
  let memo = memo_files::compacted[r](memo_dir(place), current.keys());
  {
    directory: shown(place, ""),
    warnings: loads::diags_of(tables::warnings(done)),
    dropped: pruned.pruned,
    memo: memo,
    bytes_before: before,
    bytes_after: kept_bytes[r](place),
    results: tables::counts(done).passed,
  }
}

fn cleared_of<[r]>(
  place: loads::Place,
) -> Result<Cleared, Refusal> / {fs.read[r], fs.write[r], abort.raise} = {
  let c = tables::open_cache[r](place.dir, place.stamps);
  let before = tables::counts(c).passed;
  let stored = engine::cleared[r](place.dir);
  let memo = memo_dir(place);
  let gone = (!fs.exists[r](memo) || fs.remove_tree[r](memo)) && stored;
  let warnings = loads::diags_of(tables::warnings(c));
  if gone { Ok({ directory: shown(place, ""), warnings: warnings, cleared: before }) } else {
    Err({
      directory: Some(shown(place, "")),
      diags: [
        {
          code: b"E0502",
          notes: 1,
          labels: [],
          text: b"",
          message: Bytes::of_string("could not clear the cache at `" ++ shown(place, "") ++ "`"),
          notes_text: [b"check the directory's permissions, or delete it by hand"],
          severity: b"error",
          fixes: [],
        },
      ],
      warnings: warnings,
    })
  }
}

// --- What a load answers for one name -------------------------------------------

/// Whether `query` names `name`, by its program-wide name or its last segment, or `hash` by a
/// prefix of 4 or more hex digits.
fn names(query: String, name: Bytes, hash: Bytes) -> Bool / {abort.raise} = {
  let full = String::of_bytes_lossy(name);
  let segments = full.split(".");
  full == query || segments.at_or(segments.len() - 1, "") == query
    || (query.len() >= 4 && hash.hex_of().starts_with(query.ascii_lower()))
}

fn place_text(
  program: Program,
  at: Location,
) -> { file: String, location: Option<String> } / {abort.raise} =
  match program.places.at(at.module) {
    Some(place) ->
      {
        file: place.path,
        location: if at.span.start > place.text.len() { None } else {
          let spot = spot_of(place.text, at.span.start);
          Some(place.path ++ ":" ++ spot.line.to_string() ++ ":" ++ spot.col.to_string())
        },
      },
    None -> { file: "", location: None },
  }

fn operation_of(o: OpInfo) -> Operation / {abort.raise} =
  {
    mode: String::of_bytes_lossy(mode_text(o.mode)),
    name: String::of_bytes_lossy(o.name),
    resource: o.resource_param,
    params: o.params.map(|t: Type| String::of_bytes_lossy(type_text(t))),
    ret: String::of_bytes_lossy(type_text(o.ret)),
  }

/// Each definition, declaration and test of `w` that `query` names, as the load that analysed it
/// answers: a test by whether a run proved it at its hash, which `proven` holds.
fn matches_in(
  program: Program,
  w: View,
  query: String,
  proven: Map<Bytes, Bool>,
) -> List<Entry> / {abort.raise} = {
  let defs = by_name(w.frame.hashes.defs);
  let decls = by_name(w.frame.hashes.decls);
  let interfaces = interfaces_of(w.checked, w.frame.hashes).fold(
    Map::new(),
    |acc: Map<Bytes, FiledDef>, d: FiledDef| acc.insert(d.name, d),
  );
  let bodies = filed_bodies(w.frame.hashes).fold(
    Map::new(),
    |acc: Map<Bytes, Int>, b: FiledBody| acc.insert(b.hash, b.body.len()),
  );
  let held = |name: Bytes, m: Map<Bytes, Bytes>| match m.get(name) { Some(h) -> h, None -> b"" };
  let body_of = |hash: Bytes|
    match bodies.get(hash) {
      Some(n) -> Some({ encoding: body_encoding(), bytes: n }),
      None -> None,
    };
  let fns = w.checked.defs.fold([], |acc: List<Entry>, d: DefInfo| {
    let hash = held(d.name, defs);
    if !names(query, d.name, hash) { acc } else {
      let at = place_text(program, d.at);
      let row = match interfaces.get(d.name) { Some(f) -> Some(f.interface.row), None -> None };
      acc.push({
        name: String::of_bytes_lossy(d.name),
        kind: FnEntry,
        hash: hash.hex_of(),
        file: at.file,
        location: at.location,
        interface: OfFn(match interfaces.get(d.name) {
          Some(f) -> String::of_bytes_lossy(f.interface.scheme),
          None -> "",
        }),
        footprint: match row { Some(r) -> Some(atoms_listed(r.footprint)), None -> None },
        effect_hashes: match row { Some(r) -> effect_hashes_of(r.effect_hashes), None -> [] },
        body: body_of(hash),
        outcome: None,
      })
    }
  });
  let types = range(0, w.frame.outlines.len()).fold(fns, |acc: List<Entry>, i: Int| {
    let o = w.frame.outlines.get(i);
    o.items.fold(acc, |a: List<Entry>, item: Outlined|
      match item {
        OType(t) -> {
          let name = qualify(o.name, t.name);
          let hash = held(name, decls);
          if !names(query, name, hash) { a } else {
            let at = place_text(program, { module: i, span: t.span });
            a.push({
              name: String::of_bytes_lossy(name),
              kind: TypeEntry,
              hash: hash.hex_of(),
              file: at.file,
              location: at.location,
              interface: OfType(
                t.arity,
                w.checked.ctors.filter(|c: CtorInfo| c.type_name == name).map(|c: CtorInfo|
                  {
                    name: String::of_bytes_lossy(c.simple_name),
                    fields: c.fields.map(|f: Type| String::of_bytes_lossy(type_text(f))),
                  }),
              ),
              footprint: None,
              effect_hashes: [],
              body: None,
              outcome: None,
            })
          }
        },
        _ -> a,
      })
  });
  let effects = w.checked.effects.fold(types, |acc: List<Entry>, e: EffectInfo| {
    let hash = held(e.name, decls);
    if !names(query, e.name, hash) { acc } else {
      let at = place_text(program, e.at);
      acc.push({
        name: String::of_bytes_lossy(e.name),
        kind: EffectEntry,
        hash: hash.hex_of(),
        file: at.file,
        location: at.location,
        interface: OfEffect(e.nondet, e.ops.map(operation_of)),
        footprint: None,
        effect_hashes: [],
        body: None,
        outcome: None,
      })
    }
  });
  let rows = seam::rows_from(w.checked, w.frame.hashes).tests.fold(
    Map::new(),
    |acc: Map<Bytes, KnownTestRow>, r: KnownTestRow| acc.insert(r.key, r),
  );
  w.checked.tests.fold(effects, |acc: List<Entry>, t: TestInfo| {
    let hash = match w.frame.hashes.tests.get(t.key) { Some(h) -> h, None -> b"" };
    if !names(query, t.name, hash) && !names(query, t.key, hash) { acc } else {
      let at = place_text(program, t.at);
      let row = rows.get(t.key);
      acc.push({
        name: String::of_bytes_lossy(t.name),
        kind: TestEntry(t.nondet),
        hash: hash.hex_of(),
        file: at.file,
        location: at.location,
        interface: OfTest(t.nondet),
        footprint: match row { Some(r) -> Some(atoms_listed(r.footprint)), None -> None },
        effect_hashes: match row { Some(r) -> effect_hashes_of(r.effect_hashes), None -> [] },
        body: None,
        outcome: if proven.contains(hash) { Some(Passed) } else { None },
      })
    }
  })
}

fn inspected<[r]>(
  place: loads::Place,
  program: Program,
  query: String,
) -> Result<Matches, Refusal> / {fs.read[r], abort.raise} =
  match program_view(program) {
    None -> Err({ directory: Some(shown(place, "")), diags: program.diags, warnings: [] }),
    Some(w) -> {
      let c = tables::open_cache[r](place.dir, place.stamps);
      let proven = w.frame.hashes.tests.values().fold(
        Map::new(),
        |acc: Map<Bytes, Bool>, h: Bytes|
          if tables::passed[r](c, h).value == Some(true) { acc.insert(h, true) } else { acc },
      );
      Ok({
        directory: shown(place, ""),
        warnings: loads::diags_of(tables::warnings(c)),
        entries: matches_in(program, w, query, proven),
      })
    },
  }

/// The parser has already refused a word that is not one of the four, so the last arm is `inspect`.
pub fn run(
  flags: Flags,
) -> Answer / {shipped.answer, env.reused[sys], builder.git[vcs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, time.elapsed_us, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], Derives, abort.raise, diverges, shipped.reached} = {
  let s: Style = style_of(flags);
  let place = loads::place_of(flags.paths, loads::shipped_stamps());
  let cwd = place.label == "cwd";
  if flags.action == "stats" {
    let current = queried::current();
    stats_answer(
      s,
      Ok(if cwd { stats_of[cwd](place, current) } else { stats_of[abs](place, current) }),
    )
  } else if flags.action == "compact" {
    let current = queried::current();
    compact_answer(
      s,
      Ok(if cwd { compacted_of[cwd](place, current) } else { compacted_of[abs](place, current) }),
    )
  } else if flags.action == "clear" {
    clear_answer(s, if cwd { cleared_of[cwd](place) } else { cleared_of[abs](place) })
  } else {
    let program = load_program(flags.paths);
    inspect_answer(s, flags.query, if cwd { inspected[cwd](place, program, flags.query) }
    else { inspected[abs](place, program, flags.query) })
  }
}

// --- Tests ------------------------------------------------------------------

fn no_stats() -> Stats =
  {
    directory: "/p/.ply-cache",
    warnings: [],
    format: 1,
    root: "/p",
    open_us: 0,
    results: 0,
    definitions_seen: 0,
    obligations: 0,
    reviews: 0,
    defs: 0,
    bodies: 0,
    segments: 0,
    data_bytes: 0,
    garbage_bytes: 0,
    memo: {
      records: 0,
      answers: 0,
      answer_bytes: 0,
      unread_bytes: 0,
      foreign: 0,
      reclaimable_bytes: 0,
      segments: 0,
      bytes: 0,
    },
  }

fn an_entry() -> Entry =
  {
    name: "m.active",
    kind: FnEntry,
    hash: "9f2c1a4e8b03c7d5e6f70819a2b3c4d5",
    file: "m.ply",
    location: Some("m.ply:4:1"),
    interface: OfFn("(Int) -> List<Int>"),
    footprint: None,
    effect_hashes: [],
    body: None,
    outcome: None,
  }

test "a size is exact in bytes and two decimals above that" {
  assert_eq(size_text(0), "0 B");
  assert_eq(size_text(999), "999 B");
  assert_eq(size_text(1024), "1.00 KiB");
  assert_eq(size_text(12750000), "12.16 MiB");
  assert_eq(size_text(1048575), "1.00 MiB")
}

test "a store half of whose bytes are unreachable is where compaction starts being suggested" {
  let half: Stats = { ..no_stats(), data_bytes: 1000, garbage_bytes: 400 };
  assert(!compact_suggested(half));
  assert(compact_suggested({ ..half, garbage_bytes: 501 }));
  assert(!compact_suggested({ ..half, data_bytes: 0, garbage_bytes: 0 }));
  let answers = {
    records: 2,
    answers: 2,
    answer_bytes: 1000,
    unread_bytes: 501,
    foreign: 1,
    reclaimable_bytes: 601,
    segments: 1,
    bytes: 1200,
  };
  assert(compact_suggested({ ..half, memo: answers }));
  assert(!compact_suggested({ ..half, memo: { ..answers, reclaimable_bytes: 600 } }))
}

test "the statistics read as five lines and the sizes under them" {
  let st: Stats = {
    ..no_stats(),
    open_us: 1234,
    results: 2,
    definitions_seen: 3,
    obligations: 1,
    reviews: 0,
    defs: 4,
    bodies: 4,
    segments: 2,
    data_bytes: 1000,
    garbage_bytes: 250,
    memo: {
      records: 3,
      answers: 5,
      answer_bytes: 2048,
      unread_bytes: 0,
      foreign: 2,
      reclaimable_bytes: 1024,
      segments: 2,
      bytes: 4096,
    },
  };
  let lines = stats_lines(plain(), st);
  assert_eq(lines.at_or(0, ""), "   /p/.ply-cache");
  assert_eq(lines.at_or(1, ""), "   opened in 1.23ms");
  assert_eq(lines.at_or(2, ""), "   store format 1");
  assert_eq(lines.at_or(3, ""), "   results · 2 cached results · 3 definitions seen");
  assert_eq(lines.at_or(4, ""), "   prover · 1 discharged obligation · 0 accepted reviews");
  assert_eq(lines.at_or(5, ""), "   history · 4 definitions · 4 bodies");
  assert_eq(lines.at_or(6, ""), "     2 segments 1000 B · reclaimable 250 B (25%)");
  assert_eq(lines.at_or(7, ""), "   memo · 3 records · 5 longer answers");
  assert_eq(
    lines.at_or(8, ""),
    "     2 segments 4.00 KiB · answers 2.00 KiB · reclaimable 1.00 KiB (2 records of another `ply`)",
  );
  assert_eq(lines.at_or(9, ""), "     a result entry is one proven configuration, not one test")
}

test "an empty store has nothing to reclaim and no note about what an entry counts" {
  let lines = stats_lines(plain(), { ..no_stats(), segments: 1, data_bytes: 2 });
  assert_eq(lines.at_or(6, ""), "     1 segment 2 B · reclaimable 0 B (0%)");
  assert_eq(lines.len(), 9)
}

test "compaction that dropped nothing and reclaimed nothing still says what it did" {
  let c: Compacted = {
    directory: "/p/.ply-cache",
    warnings: [],
    dropped: { defs: 0, bodies: 0 },
    memo: { records: 0, answers: 0, bytes: 0 },
    bytes_before: 900,
    bytes_after: 900,
    results: 2,
  };
  assert_eq(compact_lines(plain(), c), [
    "   compacted /p/.ply-cache",
    "     900 B · nothing to reclaim",
    "     every result is kept, so no test re-runs",
  ]);
  let swept: Compacted = {
    ..c,
    dropped: { defs: 2, bodies: 2 },
    memo: { records: 1, answers: 3, bytes: 300 },
    bytes_after: 400,
  };
  assert_eq(compact_lines(plain(), swept), [
    "   compacted /p/.ply-cache",
    "     dropped 2 definitions · 2 bodies no pass ran",
    "     dropped 1 record · 3 answers nothing reads",
    "     900 B → 400 B (500 B reclaimed)",
    "     every result is kept, so no test re-runs",
  ])
}

test "clearing names the count it discarded and where from" {
  assert_eq(clear_lines(plain(), { directory: "/p/.ply-cache", warnings: [], cleared: 1 }), [
    "   cleared 1 cached result from /p/.ply-cache",
  ]);
  assert_eq(clear_lines(plain(), { directory: "/p/.ply-cache", warnings: [], cleared: 0 }), [
    "   cleared 0 cached results from /p/.ply-cache",
  ])
}

test "a function's entry prints its resolved type rather than a serialization" {
  let e: Entry = { ..an_entry(), footprint: Some(["m.db.read[users]"]) };
  assert_eq(entry_lines(plain(), e), [
    "   m.active  9f2c1a4e8b03  fn  m.ply:4:1",
    "     type       (Int) -> List<Int>",
    "     footprint  {m.db.read[users]}",
    "     effects    — names no effect",
    "     body       — none: a declaration's is its form",
    "     result     — not a test",
  ])
}

test "an effect declaration is one row per operation, and a type one per variant" {
  let ops = [
    { mode: "read", name: "now", resource: false, params: [], ret: "Int" },
    { mode: "write", name: "set", resource: true, params: ["Int"], ret: "Unit" },
  ];
  let e: Entry = {
    ..an_entry(),
    name: "m.wall",
    kind: EffectEntry,
    interface: OfEffect(true, ops),
  };
  assert_eq(rows_of(e), [
    { label: "nondet", value: "yes" },
    { label: "operations", value: "read now() -> Int" },
    { label: "", value: "write set[r](Int) -> Unit" },
  ]);
  let shape: Entry = {
    ..an_entry(),
    name: "m.Shape",
    kind: TypeEntry,
    interface: OfType(1, [{ name: "Circle", fields: ["Int"] }, { name: "Empty", fields: [] }]),
  };
  assert_eq(rows_of(shape), [
    { label: "parameters", value: "1" },
    { label: "variants", value: "Circle(Int)" },
    { label: "", value: "Empty" },
  ])
}

test "a test's result line says whether this very hash is proven" {
  let unproven: Entry = {
    ..an_entry(),
    name: "one is one",
    kind: TestEntry(false),
    interface: OfTest(false),
  };
  assert_eq(result_line(unproven), "— not proven at this hash, so it runs next time");
  assert_eq(
    result_line({ ..unproven, kind: TestEntry(true), interface: OfTest(true) }),
    "— not proven at this hash, so it runs next time",
  );
  assert_eq(
    result_line({ ..unproven, outcome: Some(Passed) }),
    "passed — this hash re-runs only when something its run read changes",
  );
  assert_eq(result_line({ ..unproven, outcome: Some(Failed("1 != 2")) }), "failed: 1 != 2");
  assert_eq(title_of(unproven), "\"one is one\"");
  assert_eq(kind_text(TestEntry(true)), "test/nondet")
}

test "a name declared twice is ordered by name, then hash, then file" {
  let alpha: Entry = { ..an_entry(), name: "alpha.shared", hash: "bb", file: "alpha.ply" };
  let beta: Entry = { ..an_entry(), name: "beta.shared", hash: "aa", file: "beta.ply" };
  let twin: Entry = { ..an_entry(), name: "alpha.shared", hash: "aa", file: "alpha.ply" };
  assert_eq(ordered([beta, alpha, twin]).map(|entry: Entry| entry.hash), ["aa", "bb", "aa"]);
  assert_eq(ordered([alpha, twin, beta]).map(|entry: Entry| entry.name), [
    "alpha.shared",
    "alpha.shared",
    "beta.shared",
  ])
}

test "a second match is separated by a blank line and counted under both" {
  let one: Entry = { ..an_entry(), name: "alpha.shared", file: "alpha.ply" };
  let two: Entry = { ..an_entry(), name: "beta.shared", file: "beta.ply" };
  let lines = inspect_lines(plain(), "shared", [one, two]);
  assert_eq(lines.at_or(5, "?"), "");
  assert_eq(lines.at_or(lines.len() - 1, ""), "   2 entries matched `shared`");
  assert_eq(inspect_lines(plain(), "shared", [one]).len(), 5)
}

/// The answer the subcommand the flags name gives, over what the store was found to hold.
fn answered_over(
  flags: Flags,
  answer: Result<Stats, Refusal>,
  hits: Result<Matches, Refusal>,
  swept: Result<Compacted, Refusal>,
  emptied: Result<Cleared, Refusal>,
) -> Answer / {abort.raise} = {
  let s: Style = style_of(flags);
  if flags.action == "stats" { stats_answer(s, answer) }
  else if flags.action == "compact" { compact_answer(s, swept) }
  else if flags.action == "clear" { clear_answer(s, emptied) }
  else { inspect_answer(s, flags.query, hits) }
}

fn nowhere() -> Refusal = { directory: None, diags: [], warnings: [] }

fn flags_of(action: String, query: String, json: Bool) -> Flags =
  { ..no_flags(), action: action, query: query, json: json }

fn only_stats(flags: Flags, stats: Stats) -> Answer / {abort.raise} =
  answered_over(flags, Ok(stats), Err(nowhere()), Err(nowhere()), Err(nowhere()))

test "the action picks the subcommand, and its object keys off `command` and `action`" {
  let answer = only_stats(flags_of("stats", "", true), { ..no_stats(), results: 2, data_bytes: 8 });
  assert_eq(answer.code, 0);
  assert_eq(answer.errs, []);
  let text = to_string(answer.json);
  assert(text.contains("\"command\":\"cache\""));
  assert(text.contains("\"action\":\"stats\""));
  assert(text.contains("\"exit_code\":0"));
  assert(text.contains("\"entries\":2"));
  assert(text.contains("\"compact_suggested\":false"));
  assert(text.contains("\"format\":1"))
}

test "a store that never opened is exit 2 and names no cache" {
  let why: Refusal = {
    directory: None,
    diags: [
      {
        code: b"E0502",
        notes: 0,
        labels: [],
        text: b"",
        message: b"could not open a cache under `/p`",
        notes_text: [],
        severity: b"error",
        fixes: [],
      },
    ],
    warnings: [],
  };
  let answer = answered_over(flags_of("clear", "", false), Err(why), Err(why), Err(why), Err(why));
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, []);
  assert_eq(answer.errs, ["Error[E0502]: could not open a cache under `/p`"]);
  assert(!to_string(answer.json).contains("\"directory\""))
}

test "a refusal after the store opened names the cache and carries its warnings" {
  let why: Refusal = {
    directory: Some("/p/.ply-cache"),
    diags: [
      {
        code: b"E0502",
        notes: 0,
        labels: [],
        text: b"",
        message: b"could not compact the cache at `/p/.ply-cache`",
        notes_text: [],
        severity: b"error",
        fixes: [],
      },
    ],
    warnings: [
      {
        code: b"W0603",
        notes: 0,
        labels: [],
        text: b"",
        message: b"the store was discarded",
        notes_text: [],
        severity: b"warning",
        fixes: [],
      },
    ],
  };
  let answer = answered_over(
    flags_of("compact", "", false),
    Err(why),
    Err(why),
    Err(why),
    Err(why),
  );
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, ["   warning: the store was discarded"]);
  let text = to_string(answer.json);
  assert(text.contains("\"action\":\"compact\""));
  assert(text.contains("\"directory\":\"/p/.ply-cache\""));
  assert(text.contains("\"W0603\""))
}

test "inspecting a name the program does not define is E0101 and exits two" {
  let empty: Matches = { directory: "/p/.ply-cache", warnings: [], entries: [] };
  let answer = answered_over(
    flags_of("inspect", "no_such_thing", false),
    Err(nowhere()),
    Ok(empty),
    Err(nowhere()),
    Err(nowhere()),
  );
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, []);
  assert_eq(answer.errs, [
    "Error[E0101]: the program defines nothing under `no_such_thing`",
    "  = the query is a program-wide name, a simple name, or a hash prefix of 4+ hex digits",
  ])
}

test "a match is one object under `matches`, with the hash shortened and the type resolved" {
  let hits: Matches = { directory: "/p/.ply-cache", warnings: [], entries: [an_entry()] };
  let answer = answered_over(
    flags_of("inspect", "active", true),
    Err(nowhere()),
    Ok(hits),
    Err(nowhere()),
    Err(nowhere()),
  );
  assert_eq(answer.code, 0);
  let text = to_string(answer.json);
  assert(text.contains("\"query\":\"active\""));
  assert(text.contains("\"name\":\"m.active\""));
  assert(text.contains("\"hash\":\"9f2c1a4e8b03\""));
  assert(text.contains("\"kind\":\"fn\""));
  assert(text.contains("\"location\":\"m.ply:4:1\""));
  assert(text.contains("\"type\":\"(Int) -> List<Int>\""))
}
