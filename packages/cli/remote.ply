import compiler.front.interface (envelope_of)
import compiler.front.pkg (SuppliedPackage, check_manifest, registry_dir, registry_key)
import compiler.store.plyx (digest_of, digest_text, encode_named, library_domain, library_magic,
                            offset_digest, archive_digest)
import builder (builder)
import compiler.check.resolve.tables (Diagnostic, error_at)
import std.env (env)
import lock (FetchedArchive, Lock, entry_of)
import plyz
import plyz (Module, ArchiveContents, unpack)
import registry (BaseUrl, archive_target, attestation_target, base_of, exchange, get, index_target,
                 interface_target, response_message, registry_unreachable, unset, url_variable)
import interfaces (slot_attestation, slot_interface)
import semantics
import sources (DependencyPackage, File, Project, VendoredPackage, from_vendor, vendored,
                unlocated_error)
import std.fs (fs, Listed, Dir)
import std.http
import std.json (decode_bytes, error_to_string)
import std.net (net)
import std.path (join, parent, strip_root)
import std.pkg (Dependency, Index, Manifest, Registry, Release, Version, index_json, parse_version,
                render_version, release_at)
import std.list
import std.option

pub type Requirement = { name: String, floor: Version }

pub fn cache_dir(root: String) -> String / {abort.raise} =
  String::of_bytes_lossy(registry_dir(Bytes::of_string(root)))

pub fn slot_of(root: String, name: String) -> String / {abort.raise} =
  String::of_bytes_lossy(registry_key(Bytes::of_string(root), Bytes::of_string(name)))

fn archive_path(root: String, name: String, version: String) -> String / {abort.raise} =
  join(cache_dir(root), name ++ "@" ++ version ++ ".plyz")

fn interface_path(root: String, name: String, version: String) -> String / {abort.raise} =
  join(cache_dir(root), name ++ "@" ++ version ++ "." ++ semantics::version() ++ ".interface")

pub fn requirements(project: Project) -> List<Requirement> / {abort.raise} = {
  let cached_archive = cache_dir(project.root_key) ++ "/";
  let own = match project.manifest { Some(f) -> [f.text], None -> [] };
  let texts = project.packages.fold(own, |accumulator: List<Bytes>, package: DependencyPackage|
    if package.root.starts_with(cached_archive) { accumulator }
    else { match package.manifest { Some(t) -> accumulator.push(t), None -> accumulator } });
  texts.fold([], |accumulator: List<Requirement>, t: Bytes|
    match manifest_of(t) {
      None -> accumulator,
      Some(m) -> accumulator.concat(registry_requirements(m)),
    })
}

fn manifest_of(text: Bytes) -> Option<Manifest> / {abort.raise} = {
  let c = check_manifest(text);
  if c.diagnostics.len() > 0 { None } else { c.manifest }
}

fn registry_requirements(manifest: Manifest) -> List<Requirement> =
  manifest.dependencies.fold([], |accumulator: List<Requirement>, d: Dependency|
    match d.source {
      Registry -> accumulator.push({ name: d.name, floor: d.min }),
      _ -> accumulator,
    })

pub fn select(index: Index, floor: Version, pinned: Option<Version>) -> Option<Release> = {
  let pinned_release = match pinned {
    None -> None,
    Some(v) -> if compare(v, floor) == Less { None } else { release_at(index, v) },
  };
  match pinned_release {
    Some(r) -> Some(r),
    None ->
      index.versions.fold(None, |best: Option<Release>, r: Release|
        if r.yanked || compare(r.version, floor) == Less { best } else {
          match best {
            None -> Some(r),
            Some(b) -> if compare(r.version, b.version) == Less { Some(r) } else { best },
          }
        }),
  }
}

fn pinned_version(lock: Option<Lock>, name: String) -> Option<Version> / {abort.raise} =
  match lock {
    None -> None,
    Some(l) -> match entry_of(l, name) { None -> None, Some(e) -> parse_version(e.version) },
  }

fn pinned_archive(lock: Option<Lock>, name: String, version: String) -> Option<String> =
  match lock {
    None -> None,
    Some(l) -> match entry_of(l, name) {
      None -> None,
      Some(e) -> if e.version == version { e.archive } else { None },
    },
  }

pub type Node = {
  name: String,
  release: Release,
  archive: ArchiveContents,
  dependencies: List<Requirement>,
  interface: Option<Bytes>,
  attestation: Option<Bytes>,
}

type Walk = { indexes: Map<String, Index>, nodes: Map<String, Node>, queue: List<Requirement> }

pub fn walk<| e>(
  lock: Option<Lock>,
  reqs: List<Requirement>,
  index_of: (String) -> Result<Index, Diagnostic> / e,
  node_at: (String, Release) -> Result<Node, Diagnostic> / e,
) -> Result<List<Node>, Diagnostic> / {diverges, abort.raise | e} =
  match walk_queue(lock, index_of, node_at, {
      indexes: Map::new(),
      nodes: Map::new(),
      queue: reqs,
    }) {
    Err(d) -> Err(d),
    Ok(w) -> Ok(w.nodes.values()),
  }

fn walk_queue<| e>(
  lock: Option<Lock>,
  index_of: (String) -> Result<Index, Diagnostic> / e,
  node_at: (String, Release) -> Result<Node, Diagnostic> / e,
  w: Walk,
) -> Result<Walk, Diagnostic> / {abort.raise, diverges | e} =
  match w.queue {
    [] -> Ok(w),
    [request, ..rest] -> match visited(lock, index_of, node_at, { ..w, queue: rest }, request) {
      Err(d) -> Err(d),
      Ok(next) -> walk_queue(lock, index_of, node_at, next),
    },
  }

fn visited<| e>(
  lock: Option<Lock>,
  index_of: (String) -> Result<Index, Diagnostic> / e,
  node_at: (String, Release) -> Result<Node, Diagnostic> / e,
  w: Walk,
  request: Requirement,
) -> Result<Walk, Diagnostic> / {abort.raise | e} = {
  let registry_requirements = match w.indexes.get(request.name) {
    Some(x) -> Ok(x),
    None -> index_of(request.name),
  };
  match registry_requirements {
    Err(d) -> Err(d),
    Ok(index) -> {
      let w1 = { ..w, indexes: w.indexes.insert(request.name, index) };
      match select(index, request.floor, pinned_version(lock, request.name)) {
        None -> Err(unsatisfied(request, index)),
        Some(r) -> {
          let key = request.name ++ "@" ++ render_version(r.version);
          if w1.nodes.contains(key) { Ok(w1) } else {
            match node_at(request.name, r) {
              Err(d) -> Err(d),
              Ok(node) ->
                Ok({
                  ..w1,
                  nodes: w1.nodes.insert(key, node),
                  queue: w1.queue.concat(node.dependencies),
                }),
            }
          }
        },
      }
    },
  }
}

type RegistryContext = { base: BaseUrl, root: String, lock: Option<Lock> }

fn fetch_index(
  base: BaseUrl,
  name: String,
) -> Result<Index, Diagnostic> / {net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], abort.raise} = {
  let target = index_target(base, name);
  match exchange(base, get(base, target)) {
    Err(d) -> Err(d),
    Ok(r) -> if r.status == 404 { Err(no_package(base, name)) }
    else if r.status != 200 { Err(unexpected_status(base, target, r.status, response_message(r))) }
    else {
      match decode_bytes(http::whole_bytes(r.body), index_json()) {
        Err(e) ->
          Err(
            registry_unreachable(
              base.url ++ target ++ " is not a registry index: " ++ error_to_string(e),
              [],
            ),
          ),
        Ok(index) -> if index.name != name {
          Err(
            wrong_response(
              "the registry was asked for the index of `" ++ name ++ "` and returned the index of `"
                ++ index.name
                ++ "`",
              [],
            ),
          )
        } else { Ok(index) },
      }
    },
  }
}

fn fetch_node(
  ctx: RegistryContext,
  name: String,
  release: Release,
) -> Result<Node, Diagnostic> / {net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.read_file[abs], fs.create_dir[abs], fs.write_file[abs], abort.raise} = {
  let version = render_version(release.version);
  let pinned = pinned_archive(ctx.lock, name, version);
  let path = archive_path(ctx.root, name, version);
  match cached_archive(path, release.digest, pinned) {
    Some(u) -> node_of(name, release, u),
    None -> {
      let target = archive_target(ctx.base, name, version);
      match exchange(ctx.base, get(ctx.base, target)) {
        Err(d) -> Err(d),
        Ok(result) -> if result.status != 200 {
          Err(unexpected_status(ctx.base, target, result.status, response_message(result)))
        } else {
          match verified_archive(
              name,
              version,
              http::whole_bytes(result.body),
              release.digest,
              pinned,
            ) {
            Err(d) -> Err(d),
            Ok(u) -> match node_of(name, release, u) {
              Err(d) -> Err(d),
              Ok(node) -> if write_cached(path, http::whole_bytes(result.body)) { Ok(node) }
              else { Err(registry_write_error(path)) },
            },
          }
        },
      }
    },
  }
}

fn cached_archive(
  path: String,
  listed: String,
  pinned: Option<String>,
) -> Option<ArchiveContents> / {fs.read_file[abs], abort.raise} =
  match fs.read_file[abs](strip_root(path)) {
    None -> None,
    Some(bytes) -> match unpack(bytes) {
      Err(_) -> None,
      Ok(u) -> {
        let d = digest_text(u.digest);
        if d == listed && (pinned == None || pinned == Some(d)) { Some(u) } else { None }
      },
    },
  }

pub fn verified_archive(
  name: String,
  version: String,
  bytes: Bytes,
  listed: String,
  pinned: Option<String>,
) -> Result<ArchiveContents, Diagnostic> / {abort.raise} =
  match unpack(bytes) {
    Err(reason) ->
      Err(
        wrong_response(
          "the registry's archive of `" ++ name ++ "` " ++ version ++ " cannot be unpacked: "
            ++ reason,
          [],
        ),
      ),
    Ok(u) -> {
      let d = digest_text(u.digest);
      match pinned {
        Some(p) -> if p != d { Err(pin_mismatch(name, version, p, d)) }
        else { listed_as(name, version, listed, d, u) },
        None -> listed_as(name, version, listed, d, u),
      }
    },
  }

fn listed_as(
  name: String,
  version: String,
  listed: String,
  d: String,
  u: ArchiveContents,
) -> Result<ArchiveContents, Diagnostic> =
  if listed == d { Ok(u) } else {
    Err(
      wrong_response(
        "the registry's index lists `" ++ name ++ "` " ++ version ++ " as " ++ listed
          ++ ", and the archive it served is "
          ++ d,
        [
          b"the index is only a listing: the downloaded archive does not match the digest that the index lists for it, so the archive was not used",
        ],
      ),
    )
  }

fn write_cached(
  path: String,
  bytes: Bytes,
) -> Bool / {fs.create_dir[abs], fs.write_file[abs], abort.raise} =
  fs.create_dir[abs](strip_root(parent(path))) && fs.write_file[abs](strip_root(path), bytes)

fn node_of(
  name: String,
  release: Release,
  u: ArchiveContents,
) -> Result<Node, Diagnostic> / {abort.raise} = {
  let version = render_version(release.version);
  match manifest_of(u.manifest) {
    None ->
      Err(
        wrong_response(
          "the manifest in the registry's archive of `" ++ name ++ "` " ++ version
            ++ " is not valid",
          [],
        ),
      ),
    Some(m) -> if m.name != name || m.version != release.version {
      Err(
        wrong_response(
          "the registry's archive of `" ++ name ++ "` " ++ version ++ " holds `" ++ m.name ++ "` "
            ++ render_version(m.version),
          [],
        ),
      )
    } else {
      Ok({
        name: name,
        release: release,
        archive: u,
        dependencies: registry_requirements(m),
        interface: None,
        attestation: None,
      })
    },
  }
}

fn envelope_matches(bytes: Bytes, archive: String) -> Bool / {abort.raise} =
  match envelope_of(bytes) {
    None -> false,
    Some(e) ->
      e.semantics == Bytes::of_string(semantics::version())
        && e.archive == Bytes::of_string(archive),
  }

fn with_interface(
  ctx: RegistryContext,
  node: Node,
) -> Node / {net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.read_file[abs], fs.create_dir[abs], fs.write_file[abs], abort.raise} = {
  let version = render_version(node.release.version);
  let path = interface_path(ctx.root, node.name, version);
  let archive = digest_text(node.archive.digest);
  match fs.read_file[abs](strip_root(path)) {
    Some(bytes) -> if envelope_matches(bytes, archive) { { ..node, interface: Some(bytes) } }
    else { served_interface(ctx, node, path, archive) },
    None -> served_interface(ctx, node, path, archive),
  }
}

fn served_interface(
  ctx: RegistryContext,
  node: Node,
  path: String,
  archive: String,
) -> Node / {net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.create_dir[abs], fs.write_file[abs], abort.raise} = {
  let target = interface_target(
    ctx.base,
    node.name,
    render_version(node.release.version),
    semantics::version(),
  );
  match exchange(ctx.base, get(ctx.base, target)) {
    Err(_) -> node,
    Ok(result) -> if result.status == 200
        && envelope_matches(http::whole_bytes(result.body), archive) {
      write_cached(path, http::whole_bytes(result.body));
      { ..node, interface: Some(http::whole_bytes(result.body)) }
    } else { node },
  }
}

fn with_attestation(
  ctx: RegistryContext,
  node: Node,
) -> Node / {net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], abort.raise} = {
  let target = attestation_target(
    ctx.base,
    node.name,
    render_version(node.release.version),
    semantics::version(),
  );
  match exchange(ctx.base, get(ctx.base, target)) {
    Err(_) -> node,
    Ok(result) -> if result.status == 200 {
      { ..node, attestation: Some(http::whole_bytes(result.body)) }
    } else { node },
  }
}

pub fn highest_versions(nodes: List<Node>) -> List<Node> = {
  let best = nodes.fold(Map::new(), |accumulator: Map<String, Node>, node: Node|
    match accumulator.get(node.name) {
      None -> accumulator.insert(node.name, node),
      Some(highest_node) -> if compare(highest_node.release.version, node.release.version) == Less {
        accumulator.insert(node.name, node)
      } else { accumulator },
    });
  best.values()
}

fn install(
  root: String,
  items: List<VendoredPackage>,
  node: Node,
) -> Result<Unit, Diagnostic> / {fs.list_dir[abs], fs.remove[abs], fs.rename[abs], fs.create_dir[abs], fs.write_file[abs], abort.raise} = {
  let slot = slot_of(root, node.name);
  match replace_package(slot, node, true) {
    Err(d) -> Err(d),
    Ok(_) -> match from_vendor(root, items, Bytes::of_string(slot)) {
      None -> Ok(()),
      Some(dir) -> replace_package(dir, node, false),
    },
  }
}

fn replace_package(
  dir: String,
  node: Node,
  published: Bool,
) -> Result<Unit, Diagnostic> / {fs.list_dir[abs], fs.remove[abs], fs.rename[abs], fs.create_dir[abs], fs.write_file[abs], abort.raise} = {
  let staging = dir ++ "@" ++ render_version(node.release.version);
  remove_tree(staging, 0);
  let beside = |at: String, contents: Option<Bytes>|
    match contents {
      None -> true,
      Some(bytes) ->
        !published
          || (fs.create_dir[abs](strip_root(parent(at)))
          && fs.write_file[abs](strip_root(at), bytes)),
    };
  let written = unpacked_into(staging, node.archive)
    && beside(slot_interface(staging), node.interface)
    && beside(slot_attestation(staging), node.attestation);
  if !written { Err(registry_write_error(staging)) } else {
    remove_tree(dir, 0);
    if fs.rename[abs](strip_root(staging), strip_root(dir)) { Ok(()) }
    else { Err(registry_write_error(dir)) }
  }
}

fn unpacked_into(
  dir: String,
  u: ArchiveContents,
) -> Bool / {fs.create_dir[abs], fs.write_file[abs], abort.raise} =
  fs.create_dir[abs](strip_root(dir))
    && fs.write_file[abs](strip_root(join(dir, "ply.pkg")), u.manifest)
    && u.modules.fold(true, |ok: Bool, module: Module|
      ok && fs.create_dir[abs](strip_root(parent(join(dir, module.path))))
        && fs.write_file[abs](strip_root(join(dir, module.path)), module.text))

fn remove_tree(dir: String, depth: Int) -> Bool / {fs.list_dir[abs], fs.remove[abs], abort.raise} =
  if depth > 16 { false } else {
    match fs.list_dir[abs](strip_root(dir)) {
      None -> true,
      Some(listed) -> {
        let emptied = listed.fold(true, |ok: Bool, l: Listed| {
          let child = join(dir, l.name);
          match l.kind {
            Dir -> remove_tree(child, depth + 1) && ok,
            _ -> fs.remove[abs](strip_root(child)) && ok,
          }
        });
        emptied && fs.remove[abs](strip_root(dir))
      },
    }
  }

pub fn resolved(
  project: Project,
  lock: Option<Lock>,
) -> Result<List<FetchedArchive>, Diagnostic> / {env.variable, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.kind[abs], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.remove[abs], fs.rename[abs], fs.create_dir[abs], fs.write_file[abs], abort.raise, diverges} =
  match requirements(project) {
    [] -> Ok([]),
    reqs -> match env.variable(url_variable()) {
      None -> Err(unset(url_variable(), "this project has registry dependencies")),
      Some(text) -> match base_of(text) {
        Err(reason) -> Err(registry_unreachable(reason, [])),
        Ok(base) -> {
          let ctx: RegistryContext = { base: base, root: project.root_key, lock: lock };
          match walk(
              lock,
              reqs,
              |name: String| fetch_index(base, name),
              |name: String, release: Release| fetch_node(ctx, name, release),
            ) {
            Err(d) -> Err(d),
            Ok(nodes) ->
              install_all(
                ctx.root,
                vendored(ctx.root),
                highest_versions(nodes).map(|node: Node|
                  with_attestation(ctx, with_interface(ctx, node))),
                [],
              ),
          }
        },
      },
    },
  }

fn install_all(
  root: String,
  items: List<VendoredPackage>,
  nodes: List<Node>,
  out: List<FetchedArchive>,
) -> Result<List<FetchedArchive>, Diagnostic> / {fs.kind[abs], fs.list_dir[abs], fs.remove[abs], fs.rename[abs], fs.create_dir[abs], fs.write_file[abs], abort.raise} =
  match nodes {
    [] -> Ok(out),
    [n, ..rest] -> match install(root, items, n) {
      Err(d) -> Err(d),
      Ok(_) ->
        install_all(
          root,
          items,
          rest,
          out.push({
            name: n.name,
            version: render_version(n.release.version),
            archive: digest_text(n.archive.digest),
            has_interface_file: n.interface != None,
            attestation: n.attestation,
          }),
        ),
    },
  }

pub type FetchedClosure = {
  manifest: Manifest,
  own: SuppliedPackage,
  dependencies: List<SuppliedPackage>,
}

fn supplied_of(root: String, node: Node) -> SuppliedPackage / {abort.raise} =
  {
    root: registry_key(Bytes::of_string(root), Bytes::of_string(node.name)),
    manifest: Some(node.archive.manifest),
    modules: node.archive.modules.map(|module: Module|
      { name: Bytes::of_string(module.name), source_text: module.text }),
  }

pub fn index_of(
  base: BaseUrl,
  name: String,
) -> Result<Index, Diagnostic> / {net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], abort.raise} =
  fetch_index(base, name)

pub fn fetch_closure(
  base: BaseUrl,
  root: String,
  name: String,
  r: Release,
) -> Result<FetchedClosure, Diagnostic> / {net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.read_file[abs], fs.create_dir[abs], fs.write_file[abs], abort.raise, diverges} = {
  let ctx: RegistryContext = { base: base, root: root, lock: None };
  match fetch_node(ctx, name, r) {
    Err(d) -> Err(d),
    Ok(n) -> match manifest_of(n.archive.manifest) {
      None ->
        Err(
          wrong_response(
            "the manifest in the registry's archive of `" ++ name ++ "` "
              ++ render_version(r.version)
              ++ " is not valid",
            [],
          ),
        ),
      Some(m) -> match walk(
          None,
          n.dependencies,
          |x: String| fetch_index(base, x),
          |x: String, at: Release| fetch_node(ctx, x, at),
        ) {
        Err(d) -> Err(d),
        Ok(nodes) ->
          Ok({
            manifest: m,
            own: supplied_of(root, n),
            dependencies: highest_versions(nodes).map(|x: Node| supplied_of(root, x)),
          }),
      },
    },
  }
}

pub fn download_release(
  base: BaseUrl,
  dir: String,
  name: String,
  r: Release,
) -> Result<String, Diagnostic> / {net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.kind[abs], fs.list_dir[abs], fs.remove[abs], fs.rename[abs], fs.read_file[abs], fs.create_dir[abs], fs.write_file[abs], abort.raise, diverges} = {
  let ctx: RegistryContext = { base: base, root: dir, lock: None };
  let package = join(dir, "package");
  match fetch_node(ctx, name, r) {
    Err(d) -> Err(d),
    Ok(n) -> match walk(
        None,
        n.dependencies,
        |x: String| fetch_index(base, x),
        |x: String, at: Release| fetch_node(ctx, x, at),
      ) {
      Err(d) -> Err(d),
      Ok(nodes) -> match replace_package(package, n, false) {
        Err(d) -> Err(d),
        Ok(_) -> match install_all(package, [], highest_versions(nodes), []) {
          Err(d) -> Err(d),
          Ok(_) -> Ok(package),
        },
      },
    },
  }
}

fn wrong_response(message: String, notes: List<Bytes>) -> Diagnostic =
  unlocated_error(b"E0142", message, b"the registry's response is not what was requested", notes)

fn pin_mismatch(name: String, version: String, pinned: String, served: String) -> Diagnostic =
  wrong_response(
    "the registry served `" ++ name ++ "` " ++ version ++ " as " ++ served
      ++ ", and `ply.lock` pins it as "
      ++ pinned,
    [
      b"a published version never changes, so these are not the bytes that were pinned",
      Bytes::of_string(
        "if the registry was rebuilt on purpose, delete `" ++ name
          ++ "` from `ply.lock` to accept what it serves now",
      ),
    ],
  )

fn unexpected_status(base: BaseUrl, target: String, status: Int, reason: String) -> Diagnostic =
  registry_unreachable(
    base.url ++ target ++ " responded " ++ status.to_string()
      ++ (if reason == "" { "" } else { ": " ++ reason }),
    [],
  )

fn no_package(base: BaseUrl, name: String) -> Diagnostic =
  unlocated_error(
    b"E0143",
    "the registry at " ++ base.url ++ " has no package named `" ++ name ++ "`",
    b"no published version satisfies this dependency",
    [b"check the name in `ply.pkg`, and that `PLY_REGISTRY` names the registry it is published to"],
  )

fn unsatisfied(request: Requirement, index: Index) -> Diagnostic = {
  let above = index.versions.filter(|release: Release|
    compare(release.version, request.floor) != Less);
  let floor = render_version(request.floor);
  if above.len() == 0 {
    unlocated_error(
      b"E0143",
      "no published version of `" ++ request.name ++ "` is at or above " ++ floor,
      b"no published version satisfies this dependency",
      [Bytes::of_string("published: " ++ versions_text(index.versions))],
    )
  } else {
    unlocated_error(
      b"E0143",
      "every version of `" ++ request.name ++ "` at or above " ++ floor ++ " is yanked: "
        ++ versions_text(above),
      b"no published version satisfies this dependency",
      [b"a yanked version is served only to a lock that already pins it"],
    )
  }
}

fn versions_text(rs: List<Release>) -> String =
  if rs.len() == 0 { "nothing" } else {
    rs.fold("", |accumulator: String, release: Release| {
      let one = render_version(release.version) ++ (if release.yanked { " (yanked)" } else { "" });
      if accumulator == "" { one } else { accumulator ++ ", " ++ one }
    })
  }

fn registry_write_error(path: String) -> Diagnostic =
  unlocated_error(
    b"E0502",
    "could not write `" ++ path ++ "`",
    b"the registry dependency was not copied into the cache",
    [b"check the directory's permissions; the cache is this project's own `.ply-cache`"],
  )

fn a_release(version: String, yanked: Bool) -> Release / {abort.raise} =
  {
    version: parse_version(version).expect("a fixture's version"),
    digest: "b3:" ++ version,
    yanked: yanked,
    runtime: parse_version("0.16.0").expect("a fixture's version"),
  }

fn an_index(releases: List<Release>) -> Index = { name: "orders", versions: releases }

fn version_text(r: Option<Release>) -> String =
  match r { None -> "none", Some(x) -> render_version(x.version) }

test "`select` returns the lowest version that is at least the minimum version and has not been withdrawn" {
  let index = an_index([
    a_release("0.1.0", false),
    a_release("0.3.0", false),
    a_release("0.2.0", false),
  ]);
  assert_eq(
    version_text(select(index, parse_version("0.1.0").expect("a fixture's version"), None)),
    "0.1.0",
  );
  assert_eq(
    version_text(select(index, parse_version("0.1.5").expect("a fixture's version"), None)),
    "0.2.0",
  );
  assert_eq(
    version_text(select(index, parse_version("0.3.0").expect("a fixture's version"), None)),
    "0.3.0",
  );
  assert_eq(
    version_text(select(index, parse_version("0.4.0").expect("a fixture's version"), None)),
    "none",
  )
}

test "`select` skips a withdrawn version for a new resolution, but still returns it when the lock file already pins it" {
  let index = an_index([
    a_release("0.1.0", false),
    a_release("0.2.0", true),
    a_release("0.2.1", false),
  ]);
  assert_eq(
    version_text(select(index, parse_version("0.2.0").expect("a fixture's version"), None)),
    "0.2.1",
  );
  assert_eq(
    version_text(
      select(
        index,
        parse_version("0.2.0").expect("a fixture's version"),
        Some(parse_version("0.2.0").expect("a fixture's version")),
      ),
    ),
    "0.2.0",
  );
  let only = an_index([a_release("0.2.0", true)]);
  assert_eq(
    version_text(select(only, parse_version("0.1.0").expect("a fixture's version"), None)),
    "none",
  );
  assert_eq(
    unsatisfied(
      { name: "orders", floor: parse_version("0.1.0").expect("a fixture's version") },
      only,
    ).code,
    b"E0143",
  )
}

test "`select` keeps the locked version while it meets the minimum version, and picks a higher one when the minimum is raised" {
  let index = an_index([
    a_release("0.1.0", false),
    a_release("0.2.0", false),
    a_release("0.3.0", false),
  ]);
  assert_eq(
    version_text(
      select(
        index,
        parse_version("0.1.0").expect("a fixture's version"),
        Some(parse_version("0.2.0").expect("a fixture's version")),
      ),
    ),
    "0.2.0",
  );
  assert_eq(
    version_text(
      select(
        index,
        parse_version("0.3.0").expect("a fixture's version"),
        Some(parse_version("0.2.0").expect("a fixture's version")),
      ),
    ),
    "0.3.0",
  );
  assert_eq(
    version_text(
      select(
        index,
        parse_version("0.1.0").expect("a fixture's version"),
        Some(parse_version("0.9.0").expect("a fixture's version")),
      ),
    ),
    "0.1.0",
  )
}

fn a_node(name: String, version: String) -> Node / {abort.raise} =
  {
    name: name,
    release: a_release(version, false),
    archive: { digest: b"", manifest: b"", modules: [] },
    dependencies: [],
    interface: None,
    attestation: None,
  }

test "`highest_versions` returns one entry per package name, with the highest version found in the dependency graph" {
  let nodes = [
    a_node("orders", "0.1.0"),
    a_node("money", "1.0.0"),
    a_node("orders", "0.3.0"),
    a_node("orders", "0.2.0"),
  ];
  let got = highest_versions(nodes).map(|node: Node|
    node.name ++ " " ++ render_version(node.release.version));
  assert_eq(got, ["money 1.0.0", "orders 0.3.0"])
}

fn a_registry() -> Map<String, Index> / {abort.raise} =
  Map::of_entries([
    {
      key: "orders",
      value: { name: "orders", versions: [a_release("0.1.0", false), a_release("0.2.0", false)] },
    },
    {
      key: "money",
      value: {
        name: "money",
        versions: [a_release("1.0.0", false), a_release("1.1.0", false), a_release("1.2.0", false)],
      },
    },
    { key: "billing", value: { name: "billing", versions: [a_release("0.1.0", false)] } },
  ])

fn dependencies_of(name: String, version: String) -> List<Requirement> / {abort.raise} =
  if name == "orders" && version == "0.1.0" {
    [{ name: "money", floor: parse_version("1.0.0").expect("a fixture's version") }]
  } else if name == "orders" && version == "0.2.0" {
    [{ name: "money", floor: parse_version("1.1.0").expect("a fixture's version") }]
  } else if name == "billing" {
    [{ name: "orders", floor: parse_version("0.2.0").expect("a fixture's version") }]
  } else { [] }

fn walk_table(
  reqs: List<Requirement>,
  lock: Option<Lock>,
) -> Result<List<String>, Diagnostic> / {abort.raise, diverges} = {
  let table = a_registry();
  match walk(
      lock,
      reqs,
      |name: String|
        match table.get(name) {
          Some(x) -> Ok(x),
          None ->
            Err(
              no_package(
                {
                  secure: true,
                  host: "r",
                  port: 443,
                  authority: "r",
                  prefix: "",
                  url: "https://r",
                },
                name,
              ),
            ),
        },
      |name: String, release: Release|
        Ok({
          ..a_node(name, render_version(release.version)),
          dependencies: dependencies_of(name, render_version(release.version)),
        }),
    ) {
    Err(d) -> Err(d),
    Ok(nodes) ->
      Ok(
        highest_versions(nodes).map(|node: Node|
          node.name ++ " " ++ render_version(node.release.version)),
      ),
  }
}

test "minimal version selection picks the highest minimum version that any package in the dependency graph requires" {
  let got = walk_table(
    [
      { name: "orders", floor: parse_version("0.1.0").expect("a fixture's version") },
      { name: "billing", floor: parse_version("0.1.0").expect("a fixture's version") },
    ],
    None,
  );
  assert_eq(got, Ok(["billing 0.1.0", "money 1.1.0", "orders 0.2.0"]));
  assert_eq(
    walk_table(
      [
        { name: "billing", floor: parse_version("0.1.0").expect("a fixture's version") },
        { name: "orders", floor: parse_version("0.1.0").expect("a fixture's version") },
      ],
      None,
    ),
    got,
  )
}

test "resolving fails with `E0143` for a package the registry does not have, or a minimum version above every published version" {
  match walk_table(
      [{ name: "absent", floor: parse_version("0.1.0").expect("a fixture's version") }],
      None,
    ) {
    Ok(_) -> panic("a package nobody published was selected"),
    Err(d) -> assert_eq(d.code, b"E0143"),
  };
  match walk_table(
      [{ name: "orders", floor: parse_version("0.9.0").expect("a fixture's version") }],
      None,
    ) {
    Ok(_) -> panic("a floor above every version was met"),
    Err(d) -> {
      assert_eq(d.code, b"E0143");
      assert(String::of_bytes_lossy(d.message).contains("at or above 0.9.0"))
    },
  }
}

test "resolving keeps the versions in the lock file as long as they still meet the minimum versions" {
  let lock: Lock = {
    version: 2,
    packages: [
      { name: "money", version: "1.2.0", digest: Some("b3:m"), archive: Some("b3:1.2.0") },
    ],
  };
  assert_eq(
    walk_table(
      [{ name: "orders", floor: parse_version("0.2.0").expect("a fixture's version") }],
      Some(lock),
    ),
    Ok(["money 1.2.0", "orders 0.2.0"]),
  )
}

fn a_manifest(name: String, minor: Int) -> Bytes =
  Bytes::of_string(
    "import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"" ++ name
      ++ "\", version: {major: 0, minor: "
      ++ minor.to_string()
      ++ ", patch: 0}, prefix: None, runtime: {major: 0, minor: 16, patch: 0}, dependencies: [], entry: None}",
  )

fn an_archive(manifest: Bytes) -> Bytes / {abort.raise} = {
  let files: List<File> = [
    {
      path: "core.ply",
      module: "core",
      text: b"pub fn one() -> Int = 1\n",
      at: { label: "cwd", path: "core.ply" },
    },
  ];
  let container = encode_named(
    library_magic(),
    { frontend: b"", runtime: b"", entry: b"" },
    plyz::sections(files, manifest, {
      head: { frontend: b"", runtime: b"", entry: b"" },
      count: 0,
      payload: b"",
    }),
  );
  match digest_of(library_domain(), container) {
    None -> panic("the test archive is too short to compute its digest"),
    Some(d) ->
      Bytes::concat_all([
        container.slice(0, offset_digest()),
        d,
        container.slice(offset_digest() + 32, container.len()),
      ]),
  }
}

test "an archive is accepted only when its bytes hash to both the digest in the registry index and the digest in the lock file" {
  let bytes = an_archive(a_manifest("orders", 2));
  let d = archive_digest(bytes);
  match verified_archive("orders", "0.2.0", bytes, d, Some(d)) {
    Err(_) -> panic("the archive the index lists and the lock pins was rejected"),
    Ok(u) -> assert_eq(u.modules.map(|module: Module| module.path), ["core.ply"]),
  };
  match verified_archive("orders", "0.2.0", bytes, "b3:00", None) {
    Ok(_) -> panic("an archive the index does not list was believed"),
    Err(e) -> {
      assert_eq(e.code, b"E0142");
      assert(String::of_bytes_lossy(e.message).contains("index lists"))
    },
  };
  match verified_archive("orders", "0.2.0", bytes, d, Some("b3:00")) {
    Ok(_) -> panic("different bytes for a pinned version were believed"),
    Err(e) -> {
      assert_eq(e.code, b"E0142");
      assert(String::of_bytes_lossy(e.message).contains("`ply.lock` pins it"))
    },
  }
}

test "a tampered archive fails to load with `E0142`, even when its digest matches the registry index" {
  let bytes = an_archive(a_manifest("orders", 2));
  let at = bytes.len() - 3;
  let tampered = Bytes::concat_all([bytes.slice(0, at), b"X", bytes.slice(at + 1, bytes.len())]);
  match verified_archive("orders", "0.2.0", tampered, archive_digest(tampered), None) {
    Ok(_) -> panic("an archive whose digest field lies was believed"),
    Err(e) -> {
      assert_eq(e.code, b"E0142");
      assert(String::of_bytes_lossy(e.message).contains("cannot be unpacked"))
    },
  }
}

test "an archive containing a different package or version than the one requested is rejected with `E0142`" {
  let bytes = an_archive(a_manifest("billing", 2));
  match unpack(bytes) {
    Err(reason) -> panic(reason),
    Ok(u) -> match node_of("orders", a_release("0.2.0", false), u) {
      Ok(_) -> panic("`billing` was taken for `orders`"),
      Err(e) -> {
        assert_eq(e.code, b"E0142");
        assert(String::of_bytes_lossy(e.message).contains("holds `billing` 0.2.0"))
      },
    },
  };
  match unpack(an_archive(a_manifest("orders", 3))) {
    Err(reason) -> panic(reason),
    Ok(u) -> match node_of("orders", a_release("0.2.0", false), u) {
      Ok(_) -> panic("0.3.0 was taken for 0.2.0"),
      Err(e) -> assert_eq(e.code, b"E0142"),
    },
  }
}
