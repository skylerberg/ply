//! `ply show` — one definition's text as its file holds it: the comment lines above it, its
//! `pub`, and its body through the end of its last line.

import compiler.load (Derives)
import compiler.cc (toolchain)
import compiler.unit (shipped)
import std.random (entropy)
import std.time (time)
import builder (builder)
import args (Flags, style_of)
import program (Program, load_program, published, place_of, resolve_def, unknown_def, program_view)
import report (Answer, schema_version, ok_code, refused, reported)
import compiler.front.facts (View)
import compiler.front.rows (Outlined, OType)
import compiler.syntax.fmt (item_range)
import compiler.check.infer.checker (Location)
import compiler.check.resolve.tables (Diag, error_at, qualify)
import std.fs (fs)
import std.json (Str, Bool, Number, object)
import std.string
import compiler.syntax.parsing (no_module, dummy_span, span_between)

/// A `fn` or a `type` the query named, and where the tree declares it.
pub type Named = { name: String, simple: String, at: Location }

/// One definition and the range of its file that holds it.
pub type Shown = {
  name: String,
  simple: String,
  at: Location,
  path: String,
  text: Bytes,
  start: Int,
  end: Int,
}

pub fn source_of(shown: Shown) -> String / {abort.raise} =
  String::of_bytes_lossy(shown.text.slice(shown.start, shown.end))

// --- Naming a `type` ------------------------------------------------------------
// No table of the checker's holds a `type` declaration, so it is read from the tree.

type Lookup = | NoType | OneType(Named) | ManyTypes(List<String>)

fn declared_types(view: View) -> List<Named> =
  range(0, view.frame.outlines.len()).fold([], |acc: List<Named>, i: Int|
    match view.frame.outlines.at(i) {
      None -> acc,
      Some(o) ->
        o.items.fold(acc, |a: List<Named>, it: Outlined|
          match it {
            OType(t) ->
              a.push({
                name: String::of_bytes_lossy(qualify(o.name, t.name)),
                simple: String::of_bytes_lossy(t.name),
                at: { module: i, span: t.span },
              }),
            _ -> a,
          }),
    })

fn type_named(analysis: View, query: String) -> Lookup = {
  let all = declared_types(analysis);
  let exact = all.fold(None, |acc: Option<Named>, t: Named|
    match acc { Some(_) -> acc, None -> if t.name == query { Some(t) } else { None } });
  match exact {
    Some(t) -> OneType(t),
    None -> {
      let matching = all.filter(|t: Named| t.simple == query);
      match matching.at(0) {
        None -> NoType,
        Some(t) -> if matching.len() == 1 { OneType(t) }
        else { ManyTypes(matching.map(|x: Named| x.name)) },
      }
    },
  }
}

fn many_types(query: String, names: List<String>) -> Diag =
  error_at(
    b"E0101",
    no_module(),
    dummy_span(),
    Bytes::of_string("`" ++ query ++ "` names " ++ names.len().to_string() ++ " types"),
    b"say which",
    [Bytes::of_string("one of: " ++ String::join(names, ", "))],
  )

// --- Where the file holds it -------------------------------------------------------

fn no_text(name: String, location: Location) -> Diag =
  error_at(
    b"E0505",
    location.module,
    location.span,
    Bytes::of_string("`" ++ name ++ "` has no source text"),
    b"declared here",
    [],
  )

fn unplaced(name: String, why: String, location: Location) -> Diag =
  error_at(
    b"E0101",
    location.module,
    location.span,
    Bytes::of_string("`" ++ name ++ "`: " ++ why),
    b"declared here",
    [],
  )

fn placed(program: Program, found: Named) -> Result<Shown, Diag> / {abort.raise} =
  match place_of(program, found.at) {
    None -> Err(no_text(found.name, found.at)),
    Some(place) -> match item_range(place.text, Bytes::of_string(found.simple)) {
      Err(why) -> Err(unplaced(found.name, String::of_bytes_lossy(why), found.at)),
      Ok(r) ->
        Ok({
          name: found.name,
          simple: found.simple,
          at: found.at,
          path: place.path,
          text: place.text,
          start: r.start,
          end: r.end,
        }),
    },
  }

/// The `fn` or `type` the query names, by a program-wide name or a simple name unique in the
/// program, and where its file holds it.
pub fn locate(
  program: Program,
  analysis: View,
  query: String,
) -> Result<Shown, Diag> / {abort.raise} =
  match resolve_def(published(analysis), query) {
    Ok(d) ->
      placed(program, {
        name: String::of_bytes_lossy(d.name),
        simple: String::of_bytes_lossy(d.simple_name),
        at: d.at,
      }),
    Err(names) -> match type_named(analysis, query) {
      OneType(t) -> placed(program, t),
      ManyTypes(ns) -> Err(many_types(query, ns)),
      NoType -> Err(unknown_def(query, names)),
    },
  }

// --- The answer -------------------------------------------------------------------

/// The text as lines, since each is written with the newline that ended it.
pub fn source_lines(text: String) -> List<String> = {
  let parts = text.split("\n");
  let n = parts.len();
  if n > 0 && (match parts.at(n - 1) { Some(l) -> l == "", None -> false }) {
    range(0, n - 1).fold([], |acc: List<String>, i: Int|
      match parts.at(i) { Some(l) -> acc.push(l), None -> acc })
  } else { parts }
}

pub fn answered(shown: Shown) -> Answer / {abort.raise} = {
  let source = source_of(shown);
  {
    json: object([
      { key: "command", value: Str("show") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code())) },
      { key: "name", value: Str(shown.name) },
      { key: "file", value: Str(shown.path) },
      { key: "start", value: Number(Decimal::of_int(shown.start)) },
      { key: "end", value: Number(Decimal::of_int(shown.end)) },
      { key: "source", value: Str(source) },
    ]),
    lines: source_lines(source),
    errs: [],
    code: ok_code(),
  }
}

pub fn run(
  flags: Flags,
) -> Answer / {shipped.answer, toolchain.reused, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, Derives, abort.raise, diverges, shipped.reached} = {
  let loaded: Program = load_program(flags.paths, flags.verify_deps);
  let s = style_of(flags);
  match program_view(loaded) {
    None -> refused(s, "show", loaded.diags, loaded.places),
    Some(w) -> match locate(loaded, w, flags.query) {
      Err(d) -> reported(s, "show", [d], loaded.places),
      Ok(shown) -> answered(shown),
    },
  }
}

// --- Tests ------------------------------------------------------------------

fn a_file() -> Bytes =
  b"// The base.\nfn one() -> Int = 1\n\n// Doubles the base.\npub fn two() -> Int = one() + one()  // twice\n"

fn shown_of(start: Int, end: Int) -> Shown =
  {
    name: "m.two",
    simple: "two",
    at: { module: 0, span: span_between(54, 98) },
    path: "m.ply",
    text: a_file(),
    start: start,
    end: end,
  }

test "the text shown is the item's range of its file, comment lines and all" {
  match item_range(a_file(), b"two") {
    Err(e) -> panic(String::of_bytes(e)),
    Ok(r) ->
      assert_eq(
        source_of(shown_of(r.start, r.end)),
        "// Doubles the base.\npub fn two() -> Int = one() + one()  // twice\n",
      ),
  }
}

test "the text is written back as the lines it is made of, the last newline ending the last" {
  assert_eq(source_lines("a\nb\n"), ["a", "b"]);
  assert_eq(source_lines("a\nb"), ["a", "b"]);
  assert_eq(source_lines("\n"), [""]);
  assert_eq(source_lines(""), [])
}

test "the answer carries the byte range and the text, and exits 0" {
  let answer = answered(shown_of(0, 13));
  assert_eq(answer.code, 0);
  assert_eq(answer.errs, []);
  assert_eq(answer.lines, ["// The base."])
}

test "a query that names several types says which, and one that names nothing is `E0101`" {
  let many = many_types("Shape", ["a.Shape", "b.Shape"]);
  assert_eq(many.code, b"E0101");
  assert_eq(many.message, b"`Shape` names 2 types");
  assert_eq(many.notes_text, [b"one of: a.Shape, b.Shape"]);
  assert_eq(unknown_def("Shape", []).code, b"E0101")
}
