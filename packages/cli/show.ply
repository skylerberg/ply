import std.json (Str, Bool, Number, object)
import std.string
import compiler.syntax.parsing (no_module, generated_span, span_between)

pub type NamedDefinition = { name: String, simple: String, at: Location }

pub type DefinitionSource = {
  name: String,
  unqualified_name: String,
  at: Location,
  path: String,
  text: Bytes,
  start: Int,
  end: Int,
}

pub fn source_of(shown: DefinitionSource) -> String / {abort.raise} =
  String::of_bytes_lossy(shown.text.slice(shown.start, shown.end))

type Lookup = | NoType | OneType(NamedDefinition) | ManyTypes(List<String>)

fn declared_types(view: ProgramListing) -> List<NamedDefinition> =
  range(0, view.outlines.len()).fold([], |accumulator: List<NamedDefinition>, i: Int|
    match view.outlines.at(i) {
      None -> accumulator,
      Some(o) ->
        o.items.fold(accumulator, |a: List<NamedDefinition>, it: OutlineItem|
          match it {
            OutlinedType(t) ->
              a.push({
                name: String::of_bytes_lossy(qualify(o.name, t.name)),
                simple: String::of_bytes_lossy(t.name),
                at: { module: i, span: t.span },
              }),
            _ -> a,
          }),
    })

fn type_named(analysis: ProgramListing, query: String) -> Lookup = {
  let all = declared_types(analysis);
  let exact = all.fold(None, |accumulator: Option<NamedDefinition>, t: NamedDefinition|
    match accumulator {
      Some(_) -> accumulator,
      None -> if t.name == query { Some(t) } else { None },
    });
  match exact {
    Some(t) -> OneType(t),
    None -> {
      let matching = all.filter(|t: NamedDefinition| t.simple == query);
      match matching.at(0) {
        None -> NoType,
        Some(t) -> if matching.len() == 1 { OneType(t) }
        else { ManyTypes(matching.map(|x: NamedDefinition| x.name)) },
      }
    },
  }
}

fn many_types(query: String, names: List<String>) -> Diagnostic =
  error_unplaced(
    unknown_name_code,
    Bytes::of_string("`" ++ query ++ "` names " ++ names.len().to_string() ++ " types"),
    b"say which",
    [Bytes::of_string("one of: " ++ String::join(names, ", "))],
  )

fn no_text(name: String, location: Location) -> Diagnostic =
  error_at(
    internal_error_code,
    location.module,
    location.span,
    Bytes::of_string("`" ++ name ++ "` has no source text"),
    b"declared here",
    [],
  )

fn unlocatable(name: String, reason: String, location: Location) -> Diagnostic =
  error_at(
    unknown_name_code,
    location.module,
    location.span,
    Bytes::of_string("`" ++ name ++ "`: " ++ reason),
    b"declared here",
    [],
  )

fn located_source(
  places: List<SourceText>,
  found: NamedDefinition,
) -> Result<DefinitionSource, Diagnostic> / {abort.raise} =
  match place_of(places, found.at) {
    None -> Err(no_text(found.name, found.at)),
    Some(place) -> match item_range(place.text, Bytes::of_string(found.simple)) {
      Err(reason) -> Err(unlocatable(found.name, String::of_bytes_lossy(reason), found.at)),
      Ok(r) ->
        Ok({
          name: found.name,
          unqualified_name: found.simple,
          at: found.at,
          path: place.path,
          text: place.text,
          start: r.start,
          end: r.end,
        }),
    },
  }

pub fn locate(
  places: List<SourceText>,
  analysis: ProgramListing,
  query: String,
) -> Result<DefinitionSource, Diagnostic> / {abort.raise} =
  match resolve_definition(definitions_in_order(analysis), query) {
    Ok(d) ->
      located_source(places, {
        name: String::of_bytes_lossy(d.name),
        simple: String::of_bytes_lossy(d.simple_name),
        at: d.at,
      }),
    Err(names) -> match type_named(analysis, query) {
      OneType(t) -> located_source(places, t),
      ManyTypes(ns) -> Err(many_types(query, ns)),
      NoType -> Err(unknown_definition(query, names)),
    },
  }

pub fn source_lines(text: String) -> List<String> = {
  let parts = text.split("\n");
  let n = parts.len();
  if n > 0 && (match parts.at(n - 1) { Some(l) -> l == "", None -> false }) {
    range(0, n - 1).fold([], |accumulator: List<String>, i: Int|
      match parts.at(i) { Some(l) -> accumulator.push(l), None -> accumulator })
  } else { parts }
}

pub fn show_output(shown: DefinitionSource) -> CommandOutput / {abort.raise} = {
  let source = source_of(shown);
  {
    json: object([
      { key: "command", value: Str("show") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version)) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code)) },
      { key: "name", value: Str(shown.name) },
      { key: "file", value: Str(shown.path) },
      { key: "start", value: Number(Decimal::of_int(shown.start)) },
      { key: "end", value: Number(Decimal::of_int(shown.end)) },
      { key: "source", value: Str(source) },
    ]),
    lines: source_lines(source),
    errs: [],
    code: ok_code,
  }
}

fn own_file(project: Project, module: String) -> Option<File> =
  project.files.concat(project.packages.flat_map(|p: DependencyPackage| p.files)).filter(
    |f: File| f.module == module,
  ).at(
    0,
  )

fn named_in(query: String) -> { module: String, simple: String } = {
  let parts = query.split(".");
  let last = parts.len() - 1;
  { module: String::join(parts.take(last), "."), simple: parts.at_or(last, query) }
}

fn found_by_name(
  project: Project,
  query: String,
) -> Option<DefinitionSource> / {memo.read, abort.raise} = {
  let named = named_in(query);
  match view::declarers(Bytes::of_string(named.simple)) {
    [only] -> {
      let module = String::of_bytes_lossy(only);
      match if named.module == "" || named.module == module { own_file(project, module) }
        else { None } {
        None -> None,
        Some(file) -> match item_range(file.text, Bytes::of_string(named.simple)) {
          Err(_) -> None,
          Ok(r) ->
            Some({
              name: module ++ "." ++ named.simple,
              unqualified_name: named.simple,
              at: { module: no_module, span: generated_span },
              path: file.path,
              text: file.text,
              start: r.start,
              end: r.end,
            }),
        },
      }
    },
    _ -> None,
  }
}

type ShowReading = | FoundByName(DefinitionSource) | WholeListing(ProgramListing)

pub fn run(
  flags: Flags,
) -> CommandOutput / {time.elapsed_ms, shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], ProjectFiles, fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], Derives, abort.raise, diverges} = {
  let s = style_of(flags);
  let started = time.elapsed_ms();
  let project = load_resolved(flags.paths);
  match progress::silently(||
      session_over(
        flags.paths,
        project,
        started,
        flags.verify_dependencies,
        |m: Modules, _: ProgramSummary|
          match found_by_name(project, flags.query) {
            Some(shown) -> FoundByName(shown),
            None -> WholeListing(view::listed(m)),
          },
      )) {
    Err(r) -> rejected(s, "show", r.diagnostics, r.places),
    Ok(opened) -> match opened.value {
      FoundByName(shown) -> show_output(shown),
      WholeListing(w) -> {
        let places = places_of(opened);
        match locate(places, w, flags.query) {
          Err(d) -> reported(s, "show", [d], places),
          Ok(shown) -> show_output(shown),
        }
      },
    },
  }
}

const a_file: Bytes =
  b"// The base.\nfn one() -> Int = 1\n\n// Doubles the base.\npub fn two() -> Int = one() + one()  // twice\n"

fn shown_of(start: Int, end: Int) -> DefinitionSource =
  {
    name: "m.two",
    unqualified_name: "two",
    at: { module: 0, span: span_between(54, 98) },
    path: "m.ply",
    text: a_file,
    start: start,
    end: end,
  }

test "the text shown for a definition is its whole range in the file, including comment lines" {
  match item_range(a_file, b"two") {
    Err(e) -> panic(String::of_bytes(e)),
    Ok(r) ->
      assert_eq(
        source_of(shown_of(r.start, r.end)),
        "// Doubles the base.\npub fn two() -> Int = one() + one()  // twice\n",
      ),
  }
}

test "`source_lines` splits text into lines, and a final newline does not add an empty line" {
  assert_eq(source_lines("a\nb\n"), ["a", "b"]);
  assert_eq(source_lines("a\nb"), ["a", "b"]);
  assert_eq(source_lines("\n"), [""]);
  assert_eq(source_lines(""), [])
}

test "the result carries the byte range and the text, and exits 0" {
  let result = show_output(shown_of(0, 13));
  assert_eq(result.code, 0);
  assert_eq(result.errs, []);
  assert_eq(result.lines, ["// The base."])
}

test "a query matching several types fails with `E0101` and lists them, and a query matching no type fails with `E0101`" {
  let many = many_types("Shape", ["a.Shape", "b.Shape"]);
  assert_eq(many.code, b"E0101");
  assert_eq(many.message, b"`Shape` names 2 types");
  assert_eq(many.notes_text, [b"one of: a.Shape, b.Shape"]);
  assert_eq(unknown_definition("Shape", []).code, b"E0101")
}
