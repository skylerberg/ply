//! How `ply check --types` lays a signature out, and the effect-set provenance `--explain` adds.
//! The width is fixed rather than the terminal's, because this output is diffed.

import compiler.check.types (Atom, Row, NamedResource, SingletonResource, Type, VariableType,
                             NamedType, FunctionType, Scheme, Printer, printer_new, reserve_atoms,
                             print_atom_list, print_row, print_scheme, atom_text, atom_covers,
                             atoms_covered, row_empty, row_closed, row_is_pure, named_type)
import compiler.syntax.type_syntax (Mode, ReadMode, WriteMode)
import compiler.check.infer.checker (DefInfo, RaiseReason, RequirementNotShown, UnguardedBuiltin,
                                     RaisingCall, ZeroDivisor, RefutableLet, RaisingOperation,
                                     RaisingFunctionValue)
import compiler.check.termination (Terminates, Diverges, Site, unknown_summary)
import compiler.front.rows (EffectSetRow)
import report (count_of)
import std.list
import std.string
import compiler.syntax.parsing (dummy_span, span_between)

/// Counted from the terminal's left edge, so callers subtract their indent.
pub fn width() -> Int = 80

/// A row as separate atoms, so no atom is ever broken across a line. `tail` is named by the same
/// printer as the head it was lifted out of, so the two agree on it.
pub type RowText = { atoms: List<String>, tail: Option<String> }

/// A signature split at its top-level effect row; `row` is `None` for a pure definition, which
/// prints no row at all.
pub type SplitSignature = { head: String, row: Option<RowText> }

/// One `effect set` as `--explain` reports it.
pub type SetLine = { name: String, atoms: List<String>, used_by: Int }

/// What a definition's row was written as, and what its body actually performed. `performed` is
/// `None` when it equals the declared row.
pub type Provenance = {
  aliases: List<String>,
  performed: Option<List<String>>,
  unperformed: List<String>,
}

fn trim_end(s: String) -> String / {abort.raise} =
  s.slice(
    0,
    range(0, s.len()).fold(s.len(), |end: Int, _i: Int|
      if end > 0 && s.slice(end - 1, end) == " " { end - 1 } else { end }),
  )

// --- The split ------------------------------------------------------------------

fn without_row(scheme: Scheme) -> SplitSignature / {abort.raise} =
  { head: String::of_bytes_lossy(print_scheme(printer_new(), scheme).text), row: None }

fn lifted(
  scheme: Scheme,
  params: List<Type>,
  ret: Type,
  effects: Row,
) -> SplitSignature / {abort.raise} = {
  // The row is printed apart from the head it was lifted out of, so the printer is told what it
  // holds before it names a label of its own.
  let reserved: Printer = reserve_atoms(printer_new(), effects.atoms);
  let head = print_scheme(reserved, {
    ..scheme,
    ty: match scheme.ty {
      FunctionType(f) -> FunctionType({ ..f, params: params, ret: ret, effects: row_empty() }),
      _ -> FunctionType({ kept: [], once: false, params: params, ret: ret, effects: row_empty() }),
    },
  });
  let listed = print_atom_list(head.printer, effects.atoms);
  let tail = match effects.tail {
    None -> None,
    Some(v) ->
      Some(String::of_bytes_lossy(print_row(listed.printer, { atoms: [], tail: Some(v) }).text)),
  };
  {
    head: String::of_bytes_lossy(head.text),
    row: Some({ atoms: listed.texts.map(String::of_bytes_lossy), tail: tail }),
  }
}

pub fn split(scheme: Scheme) -> SplitSignature / {abort.raise} =
  match scheme.ty {
    FunctionType(f) -> if row_is_pure(f.effects) { without_row(scheme) }
    else { lifted(scheme, f.params, f.ret, f.effects) },
    _ -> without_row(scheme),
  }

// --- Placing items across lines --------------------------------------------------

type Filling = { lines: List<String>, line: String, column: Int }

/// Places `items` across lines, `first` before the first line and `rest` before every other.
pub fn fill(
  first: String,
  rest: String,
  items: List<String>,
  suffix: String,
  width: Int,
) -> List<String> / {abort.raise} =
  if items.len() == 0 { [first ++ suffix] } else {
    let start = rest.len();
    let opened = first.len();
    let empty: Filling = { lines: [], line: first, column: opened };
    let out = range(0, items.len()).fold(empty, |acc: Filling, i: Int| {
      let item = match items.at(i) { Some(x) -> x, None -> "" };
      let last = i + 1 == items.len();
      let piece = if last { item ++ suffix } else { item ++ ", " };
      // The separator's trailing space may overflow, so an exact fit is not wrapped.
      let printed = if last { piece.len() } else { piece.len() - 1 };
      let fresh = if acc.lines.len() == 0 { opened } else { start };
      let placed: Filling = if acc.column > fresh && acc.column + printed > width {
        { lines: acc.lines.push(trim_end(acc.line)), line: rest, column: start }
      } else { acc };
      { lines: placed.lines, line: placed.line ++ piece, column: placed.column + piece.len() }
    });
    out.lines.push(trim_end(out.line))
  }

/// `/ {a, b, c}`, wrapped, with continuations aligned inside the brace. A last atom too long to take
/// the row variable beside it leaves the variable a line of its own.
fn row_lines(indent: Int, gutter: String, r: RowText) -> List<String> / {abort.raise} = {
  let max_width = width() - indent;
  match r.tail {
    Some(t) -> if r.atoms.len() == 0 { [gutter ++ "/ " ++ t] } else {
      let tailed = fill(gutter ++ "/ {", gutter ++ "   ", r.atoms, " | " ++ t ++ "}", max_width);
      if tailed.fold(true, |fits: Bool, l: String| fits && l.len() <= max_width) { tailed } else {
        fill(gutter ++ "/ {", gutter ++ "   ", r.atoms, "", max_width).push(
          gutter ++ "   | " ++ t ++ "}",
        )
      }
    },
    None -> fill(gutter ++ "/ {", gutter ++ "   ", r.atoms, "}", max_width),
  }
}

pub fn definition_lines(
  indent: Int,
  label_width: Int,
  label: String,
  scheme: Scheme,
) -> List<String> / {abort.raise} = split_lines(indent, label_width, label, split(scheme))

/// The signature with each atom of its row, and its row variable, marked with how many times a call
/// performs it: `bounded`, or `scaling` with the input.
pub fn counted_lines(
  indent: Int,
  label_width: Int,
  label: String,
  def_info: DefInfo,
  call_at: Option<String>,
) -> List<String> / {abort.raise} = {
  let sp: SplitSignature = split(def_info.scheme);
  let marked = match ((sp.row, def_info.scheme.ty)) {
    (Some(r), FunctionType(f)) ->
      {
        ..sp,
        row: Some({
          atoms: range(0, r.atoms.len()).map(|i: Int|
            r.atoms.at_or(i, "") ++ " "
              ++ (match f.effects.atoms.at(i) {
                Some(a) -> class_of(atoms_covered(def_info.scaling, a)),
                None -> "",
              })),
          tail: match r.tail {
            Some(t) -> Some(t ++ " " ++ class_of(def_info.repeats.len() > 0)),
            None -> None,
          },
        }),
      },
    _ -> sp,
  };
  let lines = split_lines(indent, label_width, label, marked);
  // A definition that may not return says so on a line of its own, beneath its row.
  match def_info.ending {
    Diverges(d) ->
      lines.push(
        " ".repeat(label_column(label_width, label) + 3) ++ "diverges: "
          ++ nonreturn_reason(d.through, d.loop.len() > 0, call_at),
      ),
    _ -> lines,
  }
}

/// Why a definition may not return, at the call by which it may not where the source says.
/// With no loop, the check stopped short of reading the whole recursion.
fn nonreturn_reason(through: Option<Bytes>, looped: Bool, call_at: Option<String>) -> String = {
  let at_ = match call_at { Some(p) -> " at " ++ p, None -> "" };
  match through {
    None -> if looped { "its recursion" ++ at_ ++ " is not seen to descend" }
    else { "its recursion" ++ at_ ++ " is past what the check follows" },
    Some(name) ->
      "calls `" ++ String::of_bytes_lossy(name) ++ "`" ++ at_ ++ ", which may not return",
  }
}

fn class_of(scaling: Bool) -> String = if scaling { "scaling" } else { "bounded" }

fn split_lines(
  indent: Int,
  label_width: Int,
  label: String,
  sp: SplitSignature,
) -> List<String> / {abort.raise} = {
  let first = label.pad_right(label_width, " ") ++ " : ";
  let heads = head_lines(width() - indent, first, sp.head);
  match sp.row {
    None -> heads,
    Some(r) -> heads.concat(row_lines(indent, " ".repeat(label_column(label_width, label) + 3), r)),
  }
}

/// `first` and the head, its parameters wrapped and aligned inside the parenthesis where the whole
/// runs past `max_width`. An answer too wide to follow the last parameter takes a line of its own.
pub fn head_lines(max_width: Int, first: String, head: String) -> List<String> / {abort.raise} =
  if first.len() + head.len() <= max_width { [first ++ head] } else {
    match head_parts(Bytes::of_string(head)) {
      Some(h) -> {
        let open = first ++ h.open;
        let hang = " ".repeat(open.len());
        let closed = fill(
          open,
          hang,
          h.params,
          if h.result == "" { ")" } else { ") " ++ h.result },
          max_width,
        );
        if h.result == "" || closed.at_or(closed.len() - 1, "").len() <= max_width { closed }
        else { fill(open, hang, h.params, ")", max_width).push(hang ++ h.result) }
      },
      None -> [first ++ head],
    }
  }

/// A head split at its parameter list: what opens it (its quantifier and the parenthesis), each
/// parameter, and the answer past the parenthesis that closes it. `None` for a head with no list.
fn head_parts(
  b: Bytes,
) -> Option<{ open: String, params: List<String>, result: String }> / {abort.raise} = {
  let text = |from: Int, to: Int| String::of_bytes_lossy(b.slice(from, to));
  // Depth counts brackets of every kind; the `>` of an arrow closes nothing.
  let walked = range(0, b.len()).fold(
    { depth: 0, open: 0 - 1, start: 0, close: 0 - 1, params: [] },
    |acc: { depth: Int, open: Int, start: Int, close: Int, params: List<String> }, i: Int| {
      let c = b.at(i);
      let arrow = c == 62 && i > 0 && b.at(i - 1) == 45;
      if acc.close >= 0 || arrow { acc } else if c == 40 || c == 60 || c == 91 || c == 123 {
        if c == 40 && acc.depth == 0 && acc.open < 0 { { ..acc, depth: 1, open: i, start: i + 1 } }
        else { { ..acc, depth: acc.depth + 1 } }
      } else if c == 41 || c == 62 || c == 93 || c == 125 {
        if acc.depth == 1 && acc.open >= 0 {
          {
            ..acc,
            depth: 0,
            close: i,
            params: if i > acc.start { acc.params.push(text(acc.start, i)) } else { acc.params },
          }
        } else { { ..acc, depth: acc.depth - 1 } }
      } else if c == 44 && acc.depth == 1 && acc.open >= 0 {
        { ..acc, start: i + 2, params: acc.params.push(text(acc.start, i)) }
      } else { acc }
    },
  );
  if walked.open < 0 || walked.close < 0 { None } else {
    let rest = text(walked.close + 1, b.len());
    Some({
      open: text(0, walked.open + 1),
      params: walked.params,
      result: if rest.starts_with(" ") { rest.slice(1, rest.len()) } else { rest },
    })
  }
}

fn label_column(label_width: Int, label: String) -> Int =
  if label_width > label.len() { label_width } else { label.len() }

// --- Effect sets ------------------------------------------------------------------

fn includes_of(sets: List<EffectSetRow>, name: Bytes) -> List<Bytes> =
  sets.fold([], |acc: List<Bytes>, s: EffectSetRow| if s.name == name { s.includes } else { acc })

fn with_name(names: List<Bytes>, name: Bytes) -> List<Bytes> =
  if names.fold(false, |acc: Bool, n: Bytes| acc || n == name) { names } else { names.push(name) }

fn one_round(sets: List<EffectSetRow>, seen: List<Bytes>) -> List<Bytes> =
  seen.fold(seen, |acc: List<Bytes>, n: Bytes|
    includes_of(sets, n).fold(acc, |a: List<Bytes>, x: Bytes| with_name(a, x)))

/// Every set a row reaches, directly or through another set. A set cannot include itself, so the
/// number of sets bounds the rounds.
fn reached(sets: List<EffectSetRow>, aliases: List<Bytes>) -> List<Bytes> =
  range(0, sets.len() + 1).fold(aliases.fold([], with_name), |acc: List<Bytes>, i: Int|
    one_round(sets, acc))

fn bumped(uses: Map<Bytes, Int>, name: Bytes) -> Map<Bytes, Int> =
  match uses.get(name) { Some(k) -> uses.insert(name, k + 1), None -> uses.insert(name, 1) }

fn counted(sets: List<EffectSetRow>, defs: List<DefInfo>) -> Map<Bytes, Int> =
  defs.fold(Map::new(), |acc: Map<Bytes, Int>, def_info: DefInfo|
    reached(sets, def_info.row_aliases).fold(acc, bumped))

/// The sets a module declares, each with the definitions whose written row named it.
pub fn effect_sets(sets: List<EffectSetRow>, defs: List<DefInfo>) -> List<SetLine> / {abort.raise} = {
  let uses = counted(sets, defs);
  sets.map(|s: EffectSetRow|
    {
      name: String::of_bytes_lossy(s.name),
      atoms: s.atoms.map(|a: Atom| String::of_bytes_lossy(atom_text(a))),
      used_by: match uses.get(s.name) { Some(k) -> k, None -> 0 },
    })
}

pub fn set_lines(v: SetLine, indent: Int) -> List<String> / {abort.raise} =
  ["effect set " ++ v.name].concat(fill("  = {", "     ", v.atoms, "}", width() - indent)).concat([
    "  used by " ++ count_of(v.used_by, "definition"),
  ])

// --- Provenance --------------------------------------------------------------------

fn performs(performed: List<Atom>, declared: Atom) -> Bool =
  performed.fold(false, |acc: Bool, p: Atom| acc || atom_covers(declared, p))

pub fn provenance(def_info: DefInfo) -> Provenance / {abort.raise} = {
  // Declared atoms covering nothing the body performed.
  let undone = def_info.footprint.filter(|a: Atom| !performs(def_info.performed, a));
  let unperformed = print_atom_list(printer_new(), undone).texts.map(String::of_bytes_lossy);
  let performed: Option<List<String>> = if unperformed.len() == 0 { None } else {
    Some(print_atom_list(printer_new(), def_info.performed).texts.map(String::of_bytes_lossy))
  };
  {
    aliases: def_info.row_aliases.map(String::of_bytes_lossy),
    performed: performed,
    unperformed: unperformed,
  }
}

pub fn is_bare(p: Provenance) -> Bool =
  p.aliases.len() == 0 && (match p.performed { None -> true, Some(_) -> false })

pub fn provenance_lines(p: Provenance, indent: Int) -> List<String> / {abort.raise} = {
  let max_width = width() - indent;
  let written = if p.aliases.len() == 0 { [] }
  else { fill("  written as     / {", "                     ", p.aliases, "}", max_width) };
  let performed = match p.performed {
    None -> written,
    Some(atoms) ->
      written.concat(fill("  body performs  {", "                  ", atoms, "}", max_width)),
  };
  if p.unperformed.len() == 0 { performed } else {
    performed.concat(fill("  declared, not performed: ", "    ", p.unperformed, "", max_width))
  }
}

/// Why a place in a body can raise, as `--explain` says it under the definition.
pub fn raise_text(nonreturn_reason: RaiseReason) -> String = {
  let an_atom = |name: Bytes| "`" ++ String::of_bytes_lossy(name) ++ "`";
  match nonreturn_reason {
    RequirementNotShown(u) ->
      an_atom(u.callee) ++ " requires " ++ an_atom(u.needs) ++ ", which nothing on the way shows",
    UnguardedBuiltin(name) ->
      an_atom(name) ++ " can raise, and states no `requires` a call could show",
    RaisingCall(name) -> "calls " ++ an_atom(name) ++ ", whose row names the raise",
    ZeroDivisor -> "divides by a value nothing on the way shows is other than zero",
    RefutableLet -> "a `let` whose pattern can miss",
    RaisingOperation -> "performs an operation that raises",
    RaisingFunctionValue -> "calls a function value whose type says it may raise",
  }
}

/// The word `--json` files a raise's reason under.
pub fn raise_kind(nonreturn_reason: RaiseReason) -> String =
  match nonreturn_reason {
    RequirementNotShown(_) -> "unshown",
    UnguardedBuiltin(_) -> "unguarded",
    RaisingCall(_) -> "calls",
    ZeroDivisor -> "zero_divisor",
    RefutableLet -> "misses",
    RaisingOperation -> "performed",
    RaisingFunctionValue -> "handed",
  }

/// Each atom's text, a label variable named against the rest, so `[l]` means one thing among them.
pub fn atom_texts(atoms: List<Atom>) -> List<String> / {abort.raise} =
  print_atom_list(printer_new(), atoms).texts.map(String::of_bytes_lossy)

// --- Tests ------------------------------------------------------------------

fn fn_scheme(effects: Row, row_vars: List<Int>) -> Scheme =
  {
    ty_vars: [],
    row_vars: row_vars,
    keep_variables: [],
    label_vars: [],
    ty: FunctionType({
      kept: [],
      once: false,
      params: [named_type(b"Request")],
      ret: named_type(b"Response"),
      effects: effects,
    }),
  }

fn an_atom(eff: Bytes, mode: Mode, resource: Option<Bytes>) -> Atom =
  {
    effect: eff,
    mode: mode,
    op: None,
    resource: match resource { Some(r) -> NamedResource(r), None -> SingletonResource },
  }

test "a pure definition prints no row at all" {
  assert_eq(definition_lines(5, 12, "endpoint_of", fn_scheme(row_empty(), [])), [
    "endpoint_of  : (Request) -> Response",
  ])
}

// Wrapped at a fixed column, with the atoms hanging under the first rather than run off the edge.
test "a long row wraps inside the brace and aligns" {
  let row = row_closed([
    an_atom(b"db", ReadMode, Some(b"inventory")),
    an_atom(b"db", ReadMode, Some(b"orders")),
    an_atom(b"db", ReadMode, Some(b"users")),
    an_atom(b"db", WriteMode, Some(b"orders")),
    an_atom(b"http", WriteMode, Some(b"outbound")),
    an_atom(b"log", WriteMode, None),
  ]);
  assert_eq(definition_lines(5, 12, "create_order", fn_scheme(row, [])), [
    "create_order : (Request) -> Response",
    "               / {db.read[inventory], db.read[orders], db.write[orders],",
    "                  db.read[users], http.write[outbound], log.write}",
  ])
}

// A head too long for the column wraps between its parameters, never inside one.
test "a long head wraps between its parameters and aligns" {
  let node = NamedType({ name: b"std.prelude.ListNode", args: [VariableType(1)] });
  let sc: Scheme = {
    ty_vars: [1],
    row_vars: [],
    keep_variables: [],
    label_vars: [],
    ty: FunctionType({
      kept: [],
      once: false,
      params: [node, named_type(b"Int"), named_type(b"Int"), node],
      ret: node,
      effects: row_empty(),
    }),
  };
  assert_eq(definition_lines(5, 13, "trie_inserted", sc), [
    "trie_inserted : <a>(std.prelude.ListNode<a>, Int, Int,",
    "                    std.prelude.ListNode<a>) -> std.prelude.ListNode<a>",
  ]);
  assert_eq(
    definition_lines(5, 4, "path", {
      ..sc,
      ty: FunctionType({ kept: [], once: false, params: [], ret: node, effects: row_empty() }),
    }),
    ["path : <a>() -> std.prelude.ListNode<a>"],
  );
  // Beside a wider label, the answer no longer fits after the last parameter.
  assert_eq(definition_lines(5, 20, "gathered", sc), [
    "gathered             : <a>(std.prelude.ListNode<a>, Int, Int,",
    "                           std.prelude.ListNode<a>)",
    "                           -> std.prelude.ListNode<a>",
  ])
}

// A row variable is named once, by one printer, so the quantifier and the row cannot drift apart.
test "a row variable survives the split with one name" {
  let row: Row = { atoms: [an_atom(b"net", WriteMode, Some(b"conn"))], tail: Some(3) };
  assert_eq(definition_lines(5, 4, "serve", fn_scheme(row, [3])), [
    "serve : <| e>(Request) -> Response",
    "        / {net.write[conn] | e}",
  ]);
  assert_eq(definition_lines(5, 3, "run", fn_scheme({ atoms: [], tail: Some(0) }, [0])), [
    "run : <| e>(Request) -> Response",
    "      / e",
  ])
}

test "a type variable keeps its letter across the split" {
  let sc: Scheme = {
    ty_vars: [1],
    row_vars: [2],
    keep_variables: [],
    label_vars: [],
    ty: FunctionType({
      kept: [],
      once: false,
      params: [VariableType(1)],
      ret: VariableType(1),
      effects: { atoms: [an_atom(b"log", WriteMode, None)], tail: Some(2) },
    }),
  };
  assert_eq(definition_lines(5, 2, "id", sc), ["id : <a | e>(a) -> a", "     / {log.write | e}"])
}

fn counted_def(row: Row, scaling: List<Atom>, repeats: List<Int>) -> DefInfo =
  {
    ..def_of([], row.atoms, row.atoms),
    scheme: fn_scheme(row, match row.tail { Some(v) -> [v], None -> [] }),
    scaling: scaling,
    repeats: repeats,
  }

test "each atom and the row variable print with how many times a call performs them" {
  let query = an_atom(b"db", ReadMode, Some(b"orders"));
  let log = an_atom(b"log", WriteMode, None);
  let row: Row = { atoms: [query, log], tail: Some(3) };
  assert_eq(counted_lines(5, 4, "find", counted_def(row, [query], [0]), None), [
    "find : <| e>(Request) -> Response",
    "       / {db.read[orders] scaling, log.write bounded | e scaling}",
  ]);
  assert_eq(counted_lines(5, 4, "find", counted_def(row, [], []), None), [
    "find : <| e>(Request) -> Response",
    "       / {db.read[orders] bounded, log.write bounded | e bounded}",
  ])
}

// The variable is glued to the last atom unless that runs past the column, where it takes a line.
test "a row variable too wide to sit beside the last atom takes a line of its own" {
  let long = an_atom(
    b"a_very_long_effect_name_that_fills_a_line",
    WriteMode,
    Some(b"a_long_label"),
  );
  let row: Row = { atoms: [long], tail: Some(3) };
  assert_eq(counted_lines(5, 4, "wide", counted_def(row, [long], [0]), None), [
    "wide : <| e>(Request) -> Response",
    "       / {a_very_long_effect_name_that_fills_a_line.write[a_long_label] scaling",
    "          | e scaling}",
  ])
}

fn a_site(caller: Bytes) -> Site = { caller: caller, span: span_between(4, 9) }

test "a definition that may not return says by which call, and where" {
  let pure: Row = { atoms: [], tail: None };
  let looping = {
    ..counted_def(pure, [], []),
    ending: Diverges({ at: a_site(b"m.spin"), through: None, loop: [a_site(b"m.spin")] }),
  };
  let calling = {
    ..counted_def(pure, [], []),
    ending: Diverges({ at: a_site(b"m.wait"), through: Some(b"m.spin"), loop: [] }),
  };
  assert_eq(counted_lines(5, 4, "spin", looping, Some("m.ply:3:5")), [
    "spin : (Request) -> Response",
    "       diverges: its recursion at m.ply:3:5 is not seen to descend",
  ]);
  assert_eq(counted_lines(5, 4, "wait", calling, Some("m.ply:7:3")), [
    "wait : (Request) -> Response",
    "       diverges: calls `m.spin` at m.ply:7:3, which may not return",
  ]);
  assert_eq(counted_lines(5, 4, "wait", calling, None), [
    "wait : (Request) -> Response",
    "       diverges: calls `m.spin`, which may not return",
  ]);
  let unread = {
    ..counted_def(pure, [], []),
    ending: Diverges({ at: a_site(b"m.wide"), through: None, loop: [] }),
  };
  assert_eq(counted_lines(5, 4, "wide", unread, Some("m.ply:3:5")), [
    "wide : (Request) -> Response",
    "       diverges: its recursion at m.ply:3:5 is past what the check follows",
  ])
}

test "filling never splits an item, even when one item is too wide" {
  let wide = range(0, 90).fold("", |acc: String, i: Int| acc ++ "a");
  assert_eq(fill("[", " ", [wide, "b"], "]", 20), ["[" ++ wide ++ ",", " b]"]);
  assert_eq(fill("= {", "   ", [], "}", 40), ["= {}"])
}

test "the set block names the set and spells out its expansion" {
  let view: SetLine = {
    name: "Web",
    used_by: 4,
    atoms: [
      "db.read[inventory]",
      "db.read[orders]",
      "db.read[users]",
      "db.write[orders]",
      "http.write[outbound]",
      "log.write",
    ],
  };
  assert_eq(set_lines(view, 5), [
    "effect set Web",
    "  = {db.read[inventory], db.read[orders], db.read[users], db.write[orders],",
    "     http.write[outbound], log.write}",
    "  used by 4 definitions",
  ]);
  assert_eq(set_lines({ name: "Web", atoms: ["log.write"], used_by: 1 }, 5), [
    "effect set Web",
    "  = {log.write}",
    "  used by 1 definition",
  ])
}

fn def_of(aliases: List<Bytes>, declared: List<Atom>, performed: List<Atom>) -> DefInfo =
  {
    name: b"m.create_order",
    module: b"m",
    simple_name: b"create_order",
    scheme: fn_scheme(row_empty(), []),
    footprint: declared,
    performed: performed,
    scaling: [],
    repeats: [],
    bounded: [],
    tail_bounded: false,
    ending: Terminates,
    summary: unknown_summary(),
    raises: [],
    row_aliases: aliases,
    constraints: [],
    spec: [],
    at: { module: 0, span: dummy_span() },
  }

test "provenance names the alias and the difference the alias hides" {
  let p = provenance(
    def_of(
      [b"Web"],
      [
        an_atom(b"db", ReadMode, Some(b"orders")),
        an_atom(b"db", ReadMode, Some(b"users")),
        an_atom(b"log", WriteMode, None),
      ],
      [an_atom(b"db", ReadMode, Some(b"users")), an_atom(b"log", WriteMode, None)],
    ),
  );
  assert_eq(provenance_lines(p, 5), [
    "  written as     / {Web}",
    "  body performs  {db.read[users], log.write}",
    "  declared, not performed: db.read[orders]",
  ])
}

test "an alias the body uses completely reports only how it was written" {
  let exact = [an_atom(b"log", WriteMode, None)];
  let p = provenance(def_of([b"Web"], exact, exact));
  assert_eq(provenance_lines(p, 5), ["  written as     / {Web}"]);
  assert_eq(p.unperformed, []);
  let bare = provenance(def_of([], [], []));
  assert(is_bare(bare));
  assert_eq(provenance_lines(bare, 5), [])
}

test "a written row wider than its body is reported without any alias" {
  let p = provenance(
    def_of([], [an_atom(b"db", ReadMode, Some(b"orders")), an_atom(b"log", WriteMode, None)], [
      an_atom(b"log", WriteMode, None),
    ]),
  );
  assert_eq(provenance_lines(p, 5), [
    "  body performs  {log.write}",
    "  declared, not performed: db.read[orders]",
  ])
}

test "a set is used by every definition that reaches it, through another set or not" {
  let reads: EffectSetRow = {
    name: b"Reads",
    includes: [],
    atoms: [an_atom(b"m.store", ReadMode, Some(b"orders"))],
  };
  let web: EffectSetRow = {
    name: b"Web",
    includes: [b"Reads"],
    atoms: [
      an_atom(b"m.store", ReadMode, Some(b"orders")),
      an_atom(b"m.store", WriteMode, Some(b"orders")),
    ],
  };
  let unused: EffectSetRow = { name: b"Unused", includes: [], atoms: [] };
  let lines = effect_sets([reads, web, unused], [
    def_of([b"Reads"], [], []),
    def_of([b"Web"], [], []),
  ]);
  assert_eq(lines.map(|l: SetLine| l.name), ["Reads", "Web", "Unused"]);
  assert_eq(lines.map(|l: SetLine| l.used_by), [2, 1, 0]);
  assert_eq(match lines.at(1) { Some(l) -> l.atoms, None -> [] }, [
    "m.store.read[orders]",
    "m.store.write[orders]",
  ])
}
