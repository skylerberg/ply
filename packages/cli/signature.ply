import compiler.check.types (Effect, Effects, NamedResource, SingletonResource, Type, VariableType,
                             NamedType, FunctionType, Scheme, Printer, printer_new, reserve_effects,
                             print_effect_list, print_effects, print_scheme, effect_text,
                             effect_covers, effects_cover, no_effects, closed_effects, is_pure,
                             named_type)
import compiler.syntax.type_syntax (Mode, ReadMode, WriteMode)
import compiler.check.infer.checker (DefinitionInfo, RaiseReason, RequirementNotShown,
                                     UnguardedBuiltin, RaisingCall, ZeroDivisor, RefutableLet,
                                     RaisingOperation, RaisingFunctionValue)
import compiler.check.termination (Terminates, Diverges, Site, unknown_summary)
import compiler.front.rows (EffectSetRow)
import report (count_of)
import std.list
import std.string
import compiler.syntax.parsing (dummy_span, span_between)

pub fn width() -> Int = 80

pub type EffectsText = { listed: List<String>, variable: Option<String> }

pub type SplitSignature = { head: String, effects: Option<EffectsText> }

pub type SetLine = { name: String, listed: List<String>, used_by: Int }

pub type Provenance = {
  aliases: List<String>,
  performed: Option<List<String>>,
  unused_effects: List<String>,
}

fn trim_end(s: String) -> String / {abort.raise} =
  s.slice(
    0,
    range(0, s.len()).fold(s.len(), |end: Int, _i: Int|
      if end > 0 && s.slice(end - 1, end) == " " { end - 1 } else { end }),
  )

fn without_effects(scheme: Scheme) -> SplitSignature / {abort.raise} =
  { head: String::of_bytes_lossy(print_scheme(printer_new, scheme).text), effects: None }

fn split_signature(
  scheme: Scheme,
  params: List<Type>,
  return_type: Type,
  effects: Effects,
) -> SplitSignature / {abort.raise} = {
  let reserved: Printer = reserve_effects(printer_new, effects.listed);
  let head = print_scheme(reserved, {
    ..scheme,
    ty: match scheme.ty {
      FunctionType(f) ->
        FunctionType({ ..f, params: params, return_type: return_type, effects: no_effects }),
      _ ->
        FunctionType({
          keep_parameters: [],
          once: false,
          params: params,
          return_type: return_type,
          effects: no_effects,
        }),
    },
  });
  let listed = print_effect_list(head.printer, effects.listed);
  let variable = match effects.variable {
    None -> None,
    Some(v) ->
      Some(
        String::of_bytes_lossy(
          print_effects(listed.printer, { listed: [], variable: Some(v) }).text,
        ),
      ),
  };
  {
    head: String::of_bytes_lossy(head.text),
    effects: Some({ listed: listed.texts.map(String::of_bytes_lossy), variable: variable }),
  }
}

pub fn split(scheme: Scheme) -> SplitSignature / {abort.raise} =
  match scheme.ty {
    FunctionType(f) -> if is_pure(f.effects) { without_effects(scheme) }
    else { split_signature(scheme, f.params, f.return_type, f.effects) },
    _ -> without_effects(scheme),
  }

type Filling = { lines: List<String>, line: String, column: Int }

pub fn fill(
  first: String,
  rest: String,
  items: List<String>,
  suffix: String,
  width: Int,
) -> List<String> / {abort.raise} =
  if items.len() == 0 { [first ++ suffix] } else {
    let start = rest.len();
    let opened = first.len();
    let empty: Filling = { lines: [], line: first, column: opened };
    let out = range(0, items.len()).fold(empty, |accumulator: Filling, i: Int| {
      let item = match items.at(i) { Some(x) -> x, None -> "" };
      let last = i + 1 == items.len();
      let piece = if last { item ++ suffix } else { item ++ ", " };
      let printed = if last { piece.len() } else { piece.len() - 1 };
      let fresh = if accumulator.lines.len() == 0 { opened } else { start };
      let placed: Filling = if accumulator.column > fresh && accumulator.column + printed > width {
        { lines: accumulator.lines.push(trim_end(accumulator.line)), line: rest, column: start }
      } else { accumulator };
      { lines: placed.lines, line: placed.line ++ piece, column: placed.column + piece.len() }
    });
    out.lines.push(trim_end(out.line))
  }

fn effects_lines(indent: Int, gutter: String, r: EffectsText) -> List<String> / {abort.raise} = {
  let max_width = width() - indent;
  match r.variable {
    Some(t) -> if r.listed.len() == 0 { [gutter ++ "/ " ++ t] } else {
      let tailed = fill(gutter ++ "/ {", gutter ++ "   ", r.listed, " | " ++ t ++ "}", max_width);
      if tailed.fold(true, |fits: Bool, l: String| fits && l.len() <= max_width) { tailed } else {
        fill(gutter ++ "/ {", gutter ++ "   ", r.listed, "", max_width).push(
          gutter ++ "   | " ++ t ++ "}",
        )
      }
    },
    None -> fill(gutter ++ "/ {", gutter ++ "   ", r.listed, "}", max_width),
  }
}

pub fn definition_lines(
  indent: Int,
  label_width: Int,
  label: String,
  scheme: Scheme,
) -> List<String> / {abort.raise} = split_lines(indent, label_width, label, split(scheme))

pub fn counted_lines(
  indent: Int,
  label_width: Int,
  label: String,
  definition_info: DefinitionInfo,
  call_at: Option<String>,
) -> List<String> / {abort.raise} = {
  let signature: SplitSignature = split(definition_info.scheme);
  let marked = match ((signature.effects, definition_info.scheme.ty)) {
    (Some(r), FunctionType(f)) ->
      {
        ..signature,
        effects: Some({
          listed: range(0, r.listed.len()).map(|i: Int|
            r.listed.at_or(i, "") ++ " "
              ++ (match f.effects.listed.at(i) {
                Some(a) -> class_of(effects_cover(definition_info.scaling, a)),
                None -> "",
              })),
          variable: match r.variable {
            Some(t) -> Some(t ++ " " ++ class_of(definition_info.repeats.len() > 0)),
            None -> None,
          },
        }),
      },
    _ -> signature,
  };
  let lines = split_lines(indent, label_width, label, marked);
  match definition_info.ending {
    Diverges(d) ->
      lines.push(
        " ".repeat(label_column(label_width, label) + 3) ++ "diverges: "
          ++ nonreturn_reason(d.through, d.loop.len() > 0, call_at),
      ),
    _ -> lines,
  }
}

fn nonreturn_reason(through: Option<Bytes>, looped: Bool, call_at: Option<String>) -> String = {
  let at_ = match call_at { Some(p) -> " at " ++ p, None -> "" };
  match through {
    None -> if looped {
      "its recursion" ++ at_ ++ " does not clearly shrink its argument, so it may never end"
    } else { "its recursion" ++ at_ ++ " is too complex for the check to prove that it ends" },
    Some(name) ->
      "calls `" ++ String::of_bytes_lossy(name) ++ "`" ++ at_ ++ ", which may not return",
  }
}

fn class_of(scaling: Bool) -> String = if scaling { "scaling" } else { "bounded" }

fn split_lines(
  indent: Int,
  label_width: Int,
  label: String,
  signature: SplitSignature,
) -> List<String> / {abort.raise} = {
  let first = label.pad_right(label_width, " ") ++ " : ";
  let heads = head_lines(width() - indent, first, signature.head);
  match signature.effects {
    None -> heads,
    Some(r) ->
      heads.concat(effects_lines(indent, " ".repeat(label_column(label_width, label) + 3), r)),
  }
}

pub fn head_lines(max_width: Int, first: String, head: String) -> List<String> / {abort.raise} =
  if first.len() + head.len() <= max_width { [first ++ head] } else {
    match head_parts(Bytes::of_string(head)) {
      Some(h) -> {
        let open = first ++ h.open;
        let hang = " ".repeat(open.len());
        let closed = fill(
          open,
          hang,
          h.params,
          if h.result == "" { ")" } else { ") " ++ h.result },
          max_width,
        );
        if h.result == "" || closed.at_or(closed.len() - 1, "").len() <= max_width { closed }
        else { fill(open, hang, h.params, ")", max_width).push(hang ++ h.result) }
      },
      None -> [first ++ head],
    }
  }

fn head_parts(
  b: Bytes,
) -> Option<{ open: String, params: List<String>, result: String }> / {abort.raise} = {
  let text = |from: Int, to: Int| String::of_bytes_lossy(b.slice(from, to));
  let walked = range(0, b.len()).fold(
    { depth: 0, open: 0 - 1, start: 0, close: 0 - 1, params: [] },
    |accumulator: { depth: Int, open: Int, start: Int, close: Int, params: List<String> }, i: Int| {
      let c = b.at(i);
      let arrow = c == 62 && i > 0 && b.at(i - 1) == 45;
      if accumulator.close >= 0 || arrow { accumulator }
      else if c == 40 || c == 60 || c == 91 || c == 123 {
        if c == 40 && accumulator.depth == 0 && accumulator.open < 0 {
          { ..accumulator, depth: 1, open: i, start: i + 1 }
        } else { { ..accumulator, depth: accumulator.depth + 1 } }
      } else if c == 41 || c == 62 || c == 93 || c == 125 {
        if accumulator.depth == 1 && accumulator.open >= 0 {
          {
            ..accumulator,
            depth: 0,
            close: i,
            params: if i > accumulator.start { accumulator.params.push(text(accumulator.start, i)) }
            else { accumulator.params },
          }
        } else { { ..accumulator, depth: accumulator.depth - 1 } }
      } else if c == 44 && accumulator.depth == 1 && accumulator.open >= 0 {
        { ..accumulator, start: i + 2, params: accumulator.params.push(text(accumulator.start, i)) }
      } else { accumulator }
    },
  );
  if walked.open < 0 || walked.close < 0 { None } else {
    let rest = text(walked.close + 1, b.len());
    Some({
      open: text(0, walked.open + 1),
      params: walked.params,
      result: if rest.starts_with(" ") { rest.slice(1, rest.len()) } else { rest },
    })
  }
}

fn label_column(label_width: Int, label: String) -> Int =
  if label_width > label.len() { label_width } else { label.len() }

fn includes_of(sets: List<EffectSetRow>, name: Bytes) -> List<Bytes> =
  sets.fold([], |accumulator: List<Bytes>, s: EffectSetRow|
    if s.name == name { s.includes } else { accumulator })

fn with_name(names: List<Bytes>, name: Bytes) -> List<Bytes> =
  if names.fold(false, |accumulator: Bool, n: Bytes| accumulator || n == name) { names }
  else { names.push(name) }

fn one_round(sets: List<EffectSetRow>, seen: List<Bytes>) -> List<Bytes> =
  seen.fold(seen, |accumulator: List<Bytes>, n: Bytes|
    includes_of(sets, n).fold(accumulator, |a: List<Bytes>, x: Bytes| with_name(a, x)))

fn expanded_names(sets: List<EffectSetRow>, aliases: List<Bytes>) -> List<Bytes> =
  range(0, sets.len() + 1).fold(aliases.fold([], with_name), |accumulator: List<Bytes>, i: Int|
    one_round(sets, accumulator))

fn bumped(uses: Map<Bytes, Int>, name: Bytes) -> Map<Bytes, Int> =
  match uses.get(name) { Some(k) -> uses.insert(name, k + 1), None -> uses.insert(name, 1) }

fn counted(sets: List<EffectSetRow>, definitions: List<DefinitionInfo>) -> Map<Bytes, Int> =
  definitions.fold(Map::new(), |accumulator: Map<Bytes, Int>, definition_info: DefinitionInfo|
    expanded_names(sets, definition_info.effect_aliases).fold(accumulator, bumped))

pub fn effect_sets(
  sets: List<EffectSetRow>,
  definitions: List<DefinitionInfo>,
) -> List<SetLine> / {abort.raise} = {
  let uses = counted(sets, definitions);
  sets.map(|s: EffectSetRow|
    {
      name: String::of_bytes_lossy(s.name),
      listed: s.listed.map(|a: Effect| String::of_bytes_lossy(effect_text(a))),
      used_by: match uses.get(s.name) { Some(k) -> k, None -> 0 },
    })
}

pub fn set_lines(v: SetLine, indent: Int) -> List<String> / {abort.raise} =
  ["effect set " ++ v.name].concat(fill("  = {", "     ", v.listed, "}", width() - indent)).concat(
    ["  used by " ++ count_of(v.used_by, "definition")],
  )

fn performs(performed: List<Effect>, declared: Effect) -> Bool =
  performed.fold(false, |accumulator: Bool, p: Effect| accumulator || effect_covers(declared, p))

pub fn provenance(definition_info: DefinitionInfo) -> Provenance / {abort.raise} = {
  let undone = definition_info.effects.filter(|a: Effect| !performs(definition_info.performed, a));
  let unperformed = print_effect_list(printer_new, undone).texts.map(String::of_bytes_lossy);
  let performed: Option<List<String>> = if unperformed.len() == 0 { None } else {
    Some(
      print_effect_list(printer_new, definition_info.performed).texts.map(String::of_bytes_lossy),
    )
  };
  {
    aliases: definition_info.effect_aliases.map(String::of_bytes_lossy),
    performed: performed,
    unused_effects: unperformed,
  }
}

pub fn is_bare(p: Provenance) -> Bool =
  p.aliases.len() == 0 && (match p.performed { None -> true, Some(_) -> false })

pub fn provenance_lines(p: Provenance, indent: Int) -> List<String> / {abort.raise} = {
  let max_width = width() - indent;
  let written = if p.aliases.len() == 0 { [] }
  else { fill("  written as     / {", "                     ", p.aliases, "}", max_width) };
  let performed = match p.performed {
    None -> written,
    Some(effects) ->
      written.concat(fill("  body performs  {", "                  ", effects, "}", max_width)),
  };
  if p.unused_effects.len() == 0 { performed } else {
    performed.concat(fill("  declared, not performed: ", "    ", p.unused_effects, "", max_width))
  }
}

pub fn raise_text(nonreturn_reason: RaiseReason) -> String = {
  let an_effect = |name: Bytes| "`" ++ String::of_bytes_lossy(name) ++ "`";
  match nonreturn_reason {
    RequirementNotShown(u) ->
      an_effect(u.callee) ++ " requires " ++ an_effect(u.needs)
        ++ ", which nothing on the way shows",
    UnguardedBuiltin(name) ->
      an_effect(name) ++ " can raise, and states no `requires` a call could show",
    RaisingCall(name) -> "calls " ++ an_effect(name) ++ ", whose effects name the raise",
    ZeroDivisor -> "divides by a value nothing on the way shows is other than zero",
    RefutableLet -> "a `let` whose pattern can miss",
    RaisingOperation -> "performs an operation that raises",
    RaisingFunctionValue -> "calls a function value whose type says it may raise",
  }
}

pub fn raise_kind(nonreturn_reason: RaiseReason) -> String =
  match nonreturn_reason {
    RequirementNotShown(_) -> "unshown",
    UnguardedBuiltin(_) -> "unguarded",
    RaisingCall(_) -> "calls",
    ZeroDivisor -> "zero_divisor",
    RefutableLet -> "misses",
    RaisingOperation -> "performed",
    RaisingFunctionValue -> "handed",
  }

pub fn effect_texts(effects: List<Effect>) -> List<String> / {abort.raise} =
  print_effect_list(printer_new, effects).texts.map(String::of_bytes_lossy)

pub fn braced(effects: List<String>) -> String = "{" ++ String::join(effects, ", ") ++ "}"

fn function_scheme(effects: Effects, row_variables: List<Int>) -> Scheme =
  {
    type_variables: [],
    effect_variables: row_variables,
    keep_variables: [],
    label_variables: [],
    ty: FunctionType({
      keep_parameters: [],
      once: false,
      params: [named_type(b"Request")],
      return_type: named_type(b"Response"),
      effects: effects,
    }),
  }

fn an_effect(eff: Bytes, mode: Mode, resource: Option<Bytes>) -> Effect =
  {
    effect: eff,
    mode: mode,
    operation: None,
    resource: match resource { Some(r) -> NamedResource(r), None -> SingletonResource },
  }

test "a pure definition prints no effects at all" {
  assert_eq(definition_lines(5, 12, "endpoint_of", function_scheme(no_effects, [])), [
    "endpoint_of  : (Request) -> Response",
  ])
}

test "a long list of effects wraps inside the brace and aligns" {
  let effects = closed_effects([
    an_effect(b"db", ReadMode, Some(b"inventory")),
    an_effect(b"db", ReadMode, Some(b"orders")),
    an_effect(b"db", ReadMode, Some(b"users")),
    an_effect(b"db", WriteMode, Some(b"orders")),
    an_effect(b"http", WriteMode, Some(b"outbound")),
    an_effect(b"log", WriteMode, None),
  ]);
  assert_eq(definition_lines(5, 12, "create_order", function_scheme(effects, [])), [
    "create_order : (Request) -> Response",
    "               / {db.read[inventory], db.read[orders], db.write[orders],",
    "                  db.read[users], http.write[outbound], log.write}",
  ])
}

test "a signature with many parameters wraps between parameters and aligns the continuation line" {
  let node = NamedType({ name: b"std.prelude.ListNode", args: [VariableType(1)] });
  let scheme: Scheme = {
    type_variables: [1],
    effect_variables: [],
    keep_variables: [],
    label_variables: [],
    ty: FunctionType({
      keep_parameters: [],
      once: false,
      params: [node, named_type(b"Int"), named_type(b"Int"), node],
      return_type: node,
      effects: no_effects,
    }),
  };
  assert_eq(definition_lines(5, 13, "trie_inserted", scheme), [
    "trie_inserted : <a>(std.prelude.ListNode<a>, Int, Int,",
    "                    std.prelude.ListNode<a>) -> std.prelude.ListNode<a>",
  ]);
  assert_eq(
    definition_lines(5, 4, "path", {
      ..scheme,
      ty: FunctionType({
        keep_parameters: [],
        once: false,
        params: [],
        return_type: node,
        effects: no_effects,
      }),
    }),
    ["path : <a>() -> std.prelude.ListNode<a>"],
  );
  assert_eq(definition_lines(5, 20, "gathered", scheme), [
    "gathered             : <a>(std.prelude.ListNode<a>, Int, Int,",
    "                           std.prelude.ListNode<a>)",
    "                           -> std.prelude.ListNode<a>",
  ])
}

test "a signature printed on two lines shows its effect variable under the same name in both parts" {
  let effects: Effects = {
    listed: [an_effect(b"net", WriteMode, Some(b"conn"))],
    variable: Some(3),
  };
  assert_eq(definition_lines(5, 4, "serve", function_scheme(effects, [3])), [
    "serve : <| e>(Request) -> Response",
    "        / {net.write[conn] | e}",
  ]);
  assert_eq(
    definition_lines(5, 3, "run", function_scheme({ listed: [], variable: Some(0) }, [0])),
    ["run : <| e>(Request) -> Response", "      / e"],
  )
}

test "a type variable is printed with the same letter in the type parameters and in the parameter and result types" {
  let scheme: Scheme = {
    type_variables: [1],
    effect_variables: [2],
    keep_variables: [],
    label_variables: [],
    ty: FunctionType({
      keep_parameters: [],
      once: false,
      params: [VariableType(1)],
      return_type: VariableType(1),
      effects: { listed: [an_effect(b"log", WriteMode, None)], variable: Some(2) },
    }),
  };
  assert_eq(definition_lines(5, 2, "id", scheme), [
    "id : <a | e>(a) -> a",
    "     / {log.write | e}",
  ])
}

fn counted_definition(
  effects: Effects,
  scaling: List<Effect>,
  repeats: List<Int>,
) -> DefinitionInfo =
  {
    ..definition_of([], effects.listed, effects.listed),
    scheme: function_scheme(effects, match effects.variable { Some(v) -> [v], None -> [] }),
    scaling: scaling,
    repeats: repeats,
  }

test "a signature marks each effect and the effect variable `scaling` if a call performs it a growing number of times, else `bounded`" {
  let query = an_effect(b"db", ReadMode, Some(b"orders"));
  let log = an_effect(b"log", WriteMode, None);
  let effects: Effects = { listed: [query, log], variable: Some(3) };
  assert_eq(counted_lines(5, 4, "find", counted_definition(effects, [query], [0]), None), [
    "find : <| e>(Request) -> Response",
    "       / {db.read[orders] scaling, log.write bounded | e scaling}",
  ]);
  assert_eq(counted_lines(5, 4, "find", counted_definition(effects, [], []), None), [
    "find : <| e>(Request) -> Response",
    "       / {db.read[orders] bounded, log.write bounded | e bounded}",
  ])
}

test "an effect variable too wide to sit beside the last effect takes a line of its own" {
  let long = an_effect(
    b"a_very_long_effect_name_that_fills_a_line",
    WriteMode,
    Some(b"a_long_label"),
  );
  let effects: Effects = { listed: [long], variable: Some(3) };
  assert_eq(counted_lines(5, 4, "wide", counted_definition(effects, [long], [0]), None), [
    "wide : <| e>(Request) -> Response",
    "       / {a_very_long_effect_name_that_fills_a_line.write[a_long_label] scaling",
    "          | e scaling}",
  ])
}

fn a_site(caller: Bytes) -> Site = { caller: caller, span: span_between(4, 9) }

test "a definition that may not return prints the call that may not return and the location of that call" {
  let pure: Effects = { listed: [], variable: None };
  let looping = {
    ..counted_definition(pure, [], []),
    ending: Diverges({ at: a_site(b"m.spin"), through: None, loop: [a_site(b"m.spin")] }),
  };
  let calling = {
    ..counted_definition(pure, [], []),
    ending: Diverges({ at: a_site(b"m.wait"), through: Some(b"m.spin"), loop: [] }),
  };
  assert_eq(counted_lines(5, 4, "spin", looping, Some("m.ply:3:5")), [
    "spin : (Request) -> Response",
    "       diverges: its recursion at m.ply:3:5 does not clearly shrink its argument, so it may never end",
  ]);
  assert_eq(counted_lines(5, 4, "wait", calling, Some("m.ply:7:3")), [
    "wait : (Request) -> Response",
    "       diverges: calls `m.spin` at m.ply:7:3, which may not return",
  ]);
  assert_eq(counted_lines(5, 4, "wait", calling, None), [
    "wait : (Request) -> Response",
    "       diverges: calls `m.spin`, which may not return",
  ]);
  let unread = {
    ..counted_definition(pure, [], []),
    ending: Diverges({ at: a_site(b"m.wide"), through: None, loop: [] }),
  };
  assert_eq(counted_lines(5, 4, "wide", unread, Some("m.ply:3:5")), [
    "wide : (Request) -> Response",
    "       diverges: its recursion at m.ply:3:5 is too complex for the check to prove that it ends",
  ])
}

test "`fill` never breaks a list entry across lines, even when a single entry is wider than the line" {
  let wide = range(0, 90).fold("", |accumulator: String, i: Int| accumulator ++ "a");
  assert_eq(fill("[", " ", [wide, "b"], "]", 20), ["[" ++ wide ++ ",", " b]"]);
  assert_eq(fill("= {", "   ", [], "}", 40), ["= {}"])
}

test "an effect set prints its name, the effects it contains and how many definitions use it" {
  let view: SetLine = {
    name: "Web",
    used_by: 4,
    listed: [
      "db.read[inventory]",
      "db.read[orders]",
      "db.read[users]",
      "db.write[orders]",
      "http.write[outbound]",
      "log.write",
    ],
  };
  assert_eq(set_lines(view, 5), [
    "effect set Web",
    "  = {db.read[inventory], db.read[orders], db.read[users], db.write[orders],",
    "     http.write[outbound], log.write}",
    "  used by 4 definitions",
  ]);
  assert_eq(set_lines({ name: "Web", listed: ["log.write"], used_by: 1 }, 5), [
    "effect set Web",
    "  = {log.write}",
    "  used by 1 definition",
  ])
}

fn definition_of(
  aliases: List<Bytes>,
  declared: List<Effect>,
  performed: List<Effect>,
) -> DefinitionInfo =
  {
    name: b"m.create_order",
    module: b"m",
    simple_name: b"create_order",
    scheme: function_scheme(no_effects, []),
    effects: declared,
    performed: performed,
    scaling: [],
    repeats: [],
    promised_bounded: [],
    variable_bounded: false,
    ending: Terminates,
    summary: unknown_summary,
    raises: [],
    effect_aliases: aliases,
    constraints: [],
    spec: [],
    at: { module: 0, span: dummy_span },
  }

test "a definition declared with an effect set prints the set name, the effects it performs and the declared effects it does not perform" {
  let p = provenance(
    definition_of(
      [b"Web"],
      [
        an_effect(b"db", ReadMode, Some(b"orders")),
        an_effect(b"db", ReadMode, Some(b"users")),
        an_effect(b"log", WriteMode, None),
      ],
      [an_effect(b"db", ReadMode, Some(b"users")), an_effect(b"log", WriteMode, None)],
    ),
  );
  assert_eq(provenance_lines(p, 5), [
    "  written as     / {Web}",
    "  body performs  {db.read[users], log.write}",
    "  declared, not performed: db.read[orders]",
  ])
}

test "a definition that performs exactly the effects of its declared set prints only the set name" {
  let exact = [an_effect(b"log", WriteMode, None)];
  let p = provenance(definition_of([b"Web"], exact, exact));
  assert_eq(provenance_lines(p, 5), ["  written as     / {Web}"]);
  assert_eq(p.unused_effects, []);
  let bare = provenance(definition_of([], [], []));
  assert(is_bare(bare));
  assert_eq(provenance_lines(bare, 5), [])
}

test "declared effects wider than the body's are reported without any alias" {
  let p = provenance(
    definition_of(
      [],
      [an_effect(b"db", ReadMode, Some(b"orders")), an_effect(b"log", WriteMode, None)],
      [an_effect(b"log", WriteMode, None)],
    ),
  );
  assert_eq(provenance_lines(p, 5), [
    "  body performs  {log.write}",
    "  declared, not performed: db.read[orders]",
  ])
}

test "`effect_sets` counts each effect set's users, including definitions that use it only through another effect set" {
  let reads: EffectSetRow = {
    name: b"Reads",
    includes: [],
    listed: [an_effect(b"m.store", ReadMode, Some(b"orders"))],
  };
  let web: EffectSetRow = {
    name: b"Web",
    includes: [b"Reads"],
    listed: [
      an_effect(b"m.store", ReadMode, Some(b"orders")),
      an_effect(b"m.store", WriteMode, Some(b"orders")),
    ],
  };
  let unused: EffectSetRow = { name: b"Unused", includes: [], listed: [] };
  let lines = effect_sets([reads, web, unused], [
    definition_of([b"Reads"], [], []),
    definition_of([b"Web"], [], []),
  ]);
  assert_eq(lines.map(|l: SetLine| l.name), ["Reads", "Web", "Unused"]);
  assert_eq(lines.map(|l: SetLine| l.used_by), [2, 1, 0]);
  assert_eq(match lines.at(1) { Some(l) -> l.listed, None -> [] }, [
    "m.store.read[orders]",
    "m.store.write[orders]",
  ])
}
