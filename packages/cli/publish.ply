fn not_a_library(manifest: Manifest, reason: String) -> Diagnostic =
  rejected_package("`" ++ manifest.name ++ "` is a program: " ++ reason, [
    b"only a library is published: a package with no entry whose modules declare no `main`",
  ])

fn non_registry_source(d: Dependency) -> Option<String> =
  match d.source {
    Registry -> None,
    Path(p) -> Some("`" ++ d.name ++ "` comes from the path `" ++ p ++ "`"),
    Git(url, rev) -> Some("`" ++ d.name ++ "` comes from git, `" ++ url ++ "` at `" ++ rev ++ "`"),
  }

pub fn unpublishable(manifest: Manifest, mains: Int) -> Option<Diagnostic> =
  match manifest.entry {
    Some(e) -> Some(not_a_library(manifest, "its manifest names the entry `" ++ e ++ "`")),
    None -> if mains > 0 { Some(not_a_library(manifest, "its modules declare `main`")) } else {
      match manifest.dependencies.fold(None, |found: Option<String>, d: Dependency|
          match found { Some(_) -> found, None -> non_registry_source(d) }) {
        None -> None,
        Some(reason) ->
          Some(
            rejected_package(
              "`" ++ manifest.name ++ "` cannot be published: the dependency " ++ reason,
              [
                b"a published package can depend only on packages from the registry, because everyone who installs it downloads its dependencies from the registry",
              ],
            ),
          ),
      }
    },
  }

type PublishedInterface = { envelope: Bytes, promised: List<Contract> }

fn published_interface_of(
  s: Session<PublishReading>,
  manifest: Manifest,
  archive: String,
) -> Result<PublishedInterface, List<Diagnostic>> / {ProgramStore, abort.raise} =
  match consumed_modules(
      s.paths.at(0),
      s.project.root_key,
      manifest,
      {
        root: String::of_bytes_lossy(
          registry_key(Bytes::of_string(s.project.root_key), Bytes::of_string(manifest.name)),
        ),
        dir: s.project.root_key,
        manifest: match s.project.manifest { Some(f) -> Some(f.text), None -> None },
        files: s.project.files,
      },
      s.project.packages,
    ) {
    Err(ds) -> Err(ds),
    Ok(modules) ->
      Ok({
        envelope: enveloped({
          semantics: Bytes::of_string(semantics::version),
          archive: Bytes::of_string(archive),
          payload: bin::encode(
            { modules: modules.map(|m: PublishedModule| m.interface) },
            interface_bin(),
          ),
        }),
        promised: contracts_in(modules),
      }),
  }

fn bump_rejection(
  base: BaseUrl,
  at: ResolvedPath,
  manifest: Manifest,
  now: List<Contract>,
) -> Option<List<Diagnostic>> / {ProgramStore, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.create_dir[abs], fs.write_file[abs], abort.raise, diverges} =
  match remote::index_of(base, manifest.name) {
    Err(d) -> if d.code == unsatisfied_registry_dependency_code { None } else { Some([d]) },
    Ok(index) -> if index.versions.fold(false, |found: Bool, release: Release|
        found || release.version == manifest.version) { None } else {
      match previous(index, manifest.version) {
        None -> None,
        Some(was) -> match published_contracts(base, at, manifest.name, index, was.version) {
          Err(ds) -> Some(ds),
          Ok(before) -> match bump_error(
              manifest.name,
              was.version,
              manifest.version,
              contract_changes(before, now),
            ) {
            None -> None,
            Some(d) -> Some([d]),
          },
        },
      }
    },
  }

type PublishReading = { later: LaterReading, listing: ProgramListing }

pub fn run(
  flags: Flags,
) -> CommandOutput / {shipped.version, shipped.binary_size, toolchain.reuse_dir, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], cost_checker.report, evaluation.stored, evaluation.verdicts, evaluation.statements, shipped.read_pack, builder.git[vcs], emit.code, shipped.names, shipped.module, shipped.definitions, shipped.runtime, env.variable, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], ProjectFiles, fs.create_dir[abs], fs.write_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, Derives, abort.raise, diverges} = {
  let s = style_of(flags);
  let r = root_of(flags);
  match progress::silently(||
      session(flags.paths, flags.verify_dependencies, |modules: Modules, _: ProgramSummary|
        { later: view::later_reading(modules), listing: view::listed(modules) })) {
    Err(refusal) -> rejected(s, "publish", refusal.diagnostics, refusal.places),
    Ok(opened) -> {
      let places = places_of(opened);
      match measure_errors(opened.place).concat(site_errors(opened, opened.value.later, places)) {
        [] -> match pins_of(opened.project) {
          Err(x) -> rejected(s, "publish", x.diagnostics, x.places),
          Ok(pinned) -> {
            let p = loaded_from(flags, opened, opened.value.later.rollup, places, pinned.pins);
            match lock::read(r) {
              Err(reason) -> reported(s, "publish", [lock::unreadable_lock(r, reason)], p.places),
              Ok(existing) -> match lock_rejection(
                  r,
                  existing,
                  p,
                  lock::committed_packages(pinned.packages),
                ) {
                Some(d) -> reported(s, "publish", [d], p.places),
                None -> with_library_units(|| publish_loaded(s, r, opened, p)),
              },
            }
          },
        },
        refused -> rejected(s, "publish", refused, places),
      }
    },
  }
}

fn publish_loaded(
  style: Style,
  root: ResolvedPath,
  opened: Session<PublishReading>,
  p: LoadedProgram,
) -> CommandOutput / {artifacts.unit, ProgramStore, EmbeddedFiles, env.variable, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.create_dir[abs], fs.write_file[abs], abort.raise, diverges} =
  match manifest_of(opened.project) {
    None ->
      reported(
        style,
        "publish",
        [
          rejected_package("this project has no `ply.pkg`, so there is no package to publish", [
            b"`ply new NAME --lib` creates a library with a `ply.pkg`",
          ]),
        ],
        p.places,
      ),
    Some(m) -> match unpublishable(m, p.mains.len()) {
      Some(d) -> reported(style, "publish", [d], p.places),
      None -> match pack_library(
          project_program(opened, opened.value.later.rollup, opened.value.listing),
          opened.project.files,
          match opened.project.manifest { Some(f) -> f.text, None -> b"" },
          definitions_of(opened.value.listing),
        ) {
        Err(reason) -> reported(style, "publish", reason.diagnostics, p.places),
        Ok(k) -> match published_interface_of(opened, m, digest_text(k.sealed.full)) {
          Err(ds) -> reported(style, "publish", ds, p.places),
          Ok(interface) -> publish_packed(style, root, m, k, interface),
        },
      },
    },
  }

fn publish_packed(
  style: Style,
  root: ResolvedPath,
  manifest: Manifest,
  k: LibraryArchive,
  interface: PublishedInterface,
) -> CommandOutput / {ProgramStore, env.variable, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.create_dir[abs], fs.write_file[abs], abort.raise, diverges} =
  match env.variable(url_variable()) {
    None ->
      reported(
        style,
        "publish",
        [unset(url_variable(), "a publish needs a registry to send to")],
        [],
      ),
    Some(text) -> match base_of(text) {
      Err(reason) -> reported(style, "publish", [registry_unreachable(reason, [])], []),
      Ok(base) -> match env.variable(token_variable) {
        None ->
          reported(style, "publish", [unset(token_variable, "a publish is made under a token")], [
          ]),
        Some(token) -> match bump_rejection(base, root, manifest, interface.promised) {
          Some(ds) -> reported(style, "publish", ds, []),
          None -> upload(style, base, token, manifest, k, interface.envelope),
        },
      },
    },
  }

fn upload(
  style: Style,
  base: BaseUrl,
  token: String,
  manifest: Manifest,
  k: LibraryArchive,
  iface: Bytes,
) -> CommandOutput / {net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], abort.raise} = {
  let version = render_version(manifest.version);
  let digest = digest_text(k.sealed.full);
  let target = release_target(base, manifest.name, version);
  match exchange(base, put(base, target, token, digest, k.sealed.bytes)) {
    Err(d) -> reported(style, "publish", [d], []),
    Ok(result) -> if result.status == 201 || result.status == 200 {
      let already_published = result.status == 200;
      let at = interface_target(base, manifest.name, version, semantics::version);
      match exchange(base, put(base, at, token, digest, iface)) {
        Err(d) -> reported(style, "publish", [d], []),
        Ok(publish_packed) -> if publish_packed.status == 201 || publish_packed.status == 200 {
          {
            json: json_of(
              manifest.name,
              version,
              digest,
              base.url,
              k.sealed.bytes.len(),
              already_published,
            ),
            lines: [
              indent
                ++ green(style, if already_published { "already published" } else { "published" })
                ++ " "
                ++ manifest.name
                ++ " "
                ++ version
                ++ " · "
                ++ digest,
              indent ++ "  " ++ count_of(k.sealed.bytes.len(), "byte")
                ++ " of archive and the package interface uploaded to "
                ++ base.url,
            ],
            errs: [],
            code: ok_code,
          }
        } else {
          reported(
            style,
            "publish",
            [
              interface_rejected(
                manifest.name ++ "` " ++ version,
                publish_packed.status,
                response_message(publish_packed),
              ),
            ],
            [],
          )
        },
      }
    } else {
      reported(
        style,
        "publish",
        [
          rejected_by(
            "publish `" ++ manifest.name ++ "` " ++ version,
            result.status,
            response_message(result),
          ),
        ],
        [],
      )
    },
  }
}

fn interface_rejected(what: String, status: Int, reason: String) -> Diagnostic =
  error_unplaced(
    b"E0144",
    Bytes::of_string(
      "the registry rejected the interface of `" ++ what ++ " with status " ++ status.to_string()
        ++ (if reason == "" { "" } else { " " ++ reason }),
    ),
    b"the registry rejected the package interface",
    [
      b"the package version is already published: run `ply publish` again to upload the interface for that version",
    ],
  )

fn json_of(
  name: String,
  version: String,
  digest: String,
  url: String,
  size: Int,
  already: Bool,
) -> Json =
  object([
    { key: "command", value: Str("publish") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: Number(Decimal::of_int(ok_code)) },
    { key: "name", value: Str(name) },
    { key: "version", value: Str(version) },
    { key: "digest", value: Str(digest) },
    { key: "registry", value: Str(url) },
    { key: "bytes", value: Number(Decimal::of_int(size)) },
    { key: "already", value: Bool(already) },
    { key: "semantics", value: Str(semantics::version) },
  ])

fn a_library(dependencies: List<Dependency>) -> Manifest =
  {
    name: "orders",
    version: { major: 0, minor: 2, patch: 0 },
    prefix: None,
    runtime: { major: 0, minor: 16, patch: 0 },
    dependencies: dependencies,
    entry: None,
  }

const minimum_version: Version = { major: 0, minor: 1, patch: 0 }

test "a library whose dependencies are the registry's own is publishable" {
  assert_eq(unpublishable(a_library([]), 0), None);
  assert_eq(
    unpublishable(
      a_library([{ name: "money", prefix: None, min: minimum_version, source: Registry }]),
      0,
    ),
    None,
  )
}

test "`unpublishable` rejects a package that declares an entry point or a `main` function" {
  match unpublishable({ ..a_library([]), entry: Some("app.serve") }, 0) {
    None -> panic("a package with an entry was publishable"),
    Some(d) -> {
      assert_eq(d.code, b"E0145");
      assert(String::of_bytes_lossy(d.message).contains("names the entry `app.serve`"))
    },
  };
  match unpublishable(a_library([]), 1) {
    None -> panic("a package declaring `main` was publishable"),
    Some(d) -> assert(String::of_bytes_lossy(d.message).contains("declare `main`")),
  }
}

test "a package with a dependency the registry cannot serve, such as a path or git dependency, cannot be published" {
  match unpublishable(
      a_library([{ name: "lib", prefix: None, min: minimum_version, source: Path("../lib") }]),
      0,
    ) {
    None -> panic("a path dependency was publishable"),
    Some(d) -> {
      assert_eq(d.code, b"E0145");
      assert(String::of_bytes_lossy(d.message).contains("the path `../lib`"))
    },
  };
  match unpublishable(
      a_library([
        { name: "g", prefix: None, min: minimum_version, source: Git("https://x/g", "main") },
      ]),
      0,
    ) {
    None -> panic("a git dependency was publishable"),
    Some(d) -> assert(String::of_bytes_lossy(d.message).contains("comes from git")),
  }
}

test "a publish reports what it sent and where" {
  let text = to_string(json_of("orders", "0.2.0", "b3:ab", "https://r.example", 512, false));
  assert(text.contains("\"command\":\"publish\""));
  assert(text.contains("\"digest\":\"b3:ab\""));
  assert(text.contains("\"registry\":\"https://r.example\""))
}
