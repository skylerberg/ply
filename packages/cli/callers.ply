import compiler.load (Derives)
import compiler.cc (toolchain)
import compiler.unit (shipped)
import std.random (entropy)
import std.time (time)
import builder (builder)
import args (Flags, style_of)
import program (Program, Tables, load_program, definitions_in_order, tables_of, location_of,
                resolve_definition, unknown_definition, own_tests, own_laws, transitive_callers,
                direct_callers, program_view, product_unchanged, keep_product_at)
import paths
import std.bin
import std.hash (blake3)
import std.string
import compiler.store.hash.encoding (hex)
import report (CommandOutput, schema_version, ok_code, indent, count_of, rejected, reported)
import std.term (Style, bold)
import compiler.front.facts (CheckedProgram)
import compiler.store.hash (no_hashes, no_refs)
import compiler.check.infer.checker (DefinitionInfo, TestInfo, LawInfo)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, Array, object, string_or_null)
import compiler.syntax.parsing (dummy_span)

type Group = { definitions: List<DefinitionInfo>, tests: List<TestInfo>, laws: List<LawInfo> }

type Index = {
  definitions: Map<Bytes, DefinitionInfo>,
  tests: Map<Bytes, TestInfo>,
  laws: Map<Bytes, LawInfo>,
}

fn indexed(program: Program, analysis: CheckedProgram) -> Index =
  {
    definitions: analysis.checked.definitions.fold(
      Map::new(),
      |accumulator: Map<Bytes, DefinitionInfo>, definition_info: DefinitionInfo|
        accumulator.insert(definition_info.name, definition_info),
    ),
    tests: own_tests(program, analysis).fold(
      Map::new(),
      |accumulator: Map<Bytes, TestInfo>, x: TestInfo| accumulator.insert(x.key, x),
    ),
    laws: own_laws(program, analysis).fold(
      Map::new(),
      |accumulator: Map<Bytes, LawInfo>, x: LawInfo| accumulator.insert(x.key, x),
    ),
  }

fn sorted_into(ix: Index, keys: List<Bytes>) -> Group =
  keys.fold({ definitions: [], tests: [], laws: [] }, |accumulator: Group, key: Bytes|
    match ix.definitions.get(key) {
      Some(d) -> { ..accumulator, definitions: accumulator.definitions.push(d) },
      None -> match ix.tests.get(key) {
        Some(x) -> { ..accumulator, tests: accumulator.tests.push(x) },
        None -> match ix.laws.get(key) {
          Some(x) -> { ..accumulator, laws: accumulator.laws.push(x) },
          None -> accumulator,
        },
      },
    })

type CallerNames = { definitions: List<Bytes>, tests: List<Bytes>, laws: List<Bytes> }

type KeptCallers = { name: Bytes, direct: CallerNames, transitive: CallerNames }

derive bin for CallerNames

derive bin for KeptCallers

fn names_in(group: Group) -> CallerNames =
  {
    definitions: group.definitions.map(|d: DefinitionInfo| d.name),
    tests: group.tests.map(|x: TestInfo| x.name),
    laws: group.laws.map(|x: LawInfo| x.name),
  }

fn summary(names: CallerNames) -> String / {abort.raise} =
  count_of(names.definitions.len(), "definition") ++ ", " ++ count_of(names.tests.len(), "test")
    ++ ", "
    ++ count_of(names.laws.len(), "law")

fn quoted(name: Bytes) -> String = "\"" ++ String::of_bytes_lossy(name) ++ "\""

fn group_lines(
  title: String,
  names: CallerNames,
  lines: List<String>,
) -> List<String> / {abort.raise} = {
  let head = lines.push(indent() ++ title ++ ": " ++ summary(names));
  let after_definitions = names.definitions.fold(head, |accumulator: List<String>, name: Bytes|
    accumulator.push(indent() ++ indent() ++ String::of_bytes_lossy(name)));
  let after_tests = names.tests.fold(after_definitions, |accumulator: List<String>, name: Bytes|
    accumulator.push(indent() ++ indent() ++ "test " ++ quoted(name)));
  names.laws.fold(after_tests, |accumulator: List<String>, name: Bytes|
    accumulator.push(indent() ++ indent() ++ "law " ++ quoted(name)))
}

fn text_lines(style: Style, kept: KeptCallers) -> List<String> / {abort.raise} =
  group_lines(
    "reached from",
    kept.transitive,
    group_lines("mentioned by", kept.direct, [
      "",
      indent() ++ bold(style, String::of_bytes_lossy(kept.name)),
    ]),
  )

fn definition_json(program: Program, definition_info: DefinitionInfo) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(String::of_bytes_lossy(definition_info.name)) },
    { key: "location", value: string_or_null(location_of(program, definition_info.at)) },
  ])

fn test_json(program: Program, test_info: TestInfo) -> Json / {abort.raise} =
  object([
    { key: "index", value: Number(Decimal::of_int(test_info.index)) },
    { key: "key", value: Str(String::of_bytes_lossy(test_info.key)) },
    { key: "name", value: Str(String::of_bytes_lossy(test_info.name)) },
    { key: "module", value: Str(String::of_bytes_lossy(test_info.module)) },
    { key: "location", value: string_or_null(location_of(program, test_info.at)) },
  ])

fn law_json(program: Program, law_info: LawInfo) -> Json / {abort.raise} =
  object([
    { key: "index", value: Number(Decimal::of_int(law_info.index)) },
    { key: "key", value: Str(String::of_bytes_lossy(law_info.key)) },
    { key: "name", value: Str(String::of_bytes_lossy(law_info.name)) },
    { key: "module", value: Str(String::of_bytes_lossy(law_info.module)) },
    { key: "location", value: string_or_null(location_of(program, law_info.at)) },
  ])

fn group_json(program: Program, group: Group) -> Json / {abort.raise} =
  object([
    {
      key: "definitions",
      value: Array(
        group.definitions.map(|definition_info: DefinitionInfo|
          definition_json(program, definition_info)),
      ),
    },
    { key: "tests", value: Array(group.tests.map(|x: TestInfo| test_json(program, x))) },
    { key: "laws", value: Array(group.laws.map(|x: LawInfo| law_json(program, x))) },
  ])

fn kept_callers(definition_info: DefinitionInfo, direct: Group, transitive: Group) -> KeptCallers =
  { name: definition_info.name, direct: names_in(direct), transitive: names_in(transitive) }

fn callers_output(
  style: Style,
  program: Program,
  definition_info: DefinitionInfo,
  direct: Group,
  transitive: Group,
) -> CommandOutput / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("callers") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code())) },
      {
        key: "definition",
        value: object([
          { key: "name", value: Str(String::of_bytes_lossy(definition_info.name)) },
          { key: "module", value: Str(String::of_bytes_lossy(definition_info.module)) },
          { key: "location", value: string_or_null(location_of(program, definition_info.at)) },
        ]),
      },
      { key: "direct", value: group_json(program, direct) },
      { key: "transitive", value: group_json(program, transitive) },
      { key: "diagnostics", value: Array([]) },
    ]),
    lines: text_lines(style, kept_callers(definition_info, direct, transitive)),
    errs: [],
    code: ok_code(),
  }

fn found_callers(
  program: Program,
  analysis: CheckedProgram,
  definition_info: DefinitionInfo,
) -> { direct: Group, transitive: Group } / {abort.raise} = {
  let tables: Tables = tables_of(analysis.frame.hashes);
  let ix: Index = indexed(program, analysis);
  {
    direct: sorted_into(ix, direct_callers(tables, definition_info.name)),
    transitive: sorted_into(ix, transitive_callers(tables, definition_info.name)),
  }
}

fn callers_product(flags: Flags) -> String / {abort.raise} =
  "callers "
    ++ String::of_bytes_lossy(
      hex(
        blake3(
          Bytes::of_string(
            String::join(
              [flags.query].concat(flags.paths.map(|r: paths::ResolvedPath| r.display)),
              "\n",
            ),
          ),
        ),
      ),
    )

fn may_reuse_callers(flags: Flags) -> Bool =
  !flags.no_cache && !flags.json && !flags.verify_dependencies

pub fn run(
  flags: Flags,
) -> CommandOutput / {time.elapsed_ms, shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, Derives, abort.raise, diverges, shipped.report_view_used} = {
  let product = callers_product(flags);
  let current = if may_reuse_callers(flags) { product_unchanged(flags.paths, product) }
  else { None };
  let kept = match current {
    None -> None,
    Some(c) -> match bin::decode(c.value, kept_callers_bin()) {
      Ok(names) -> Some(names),
      Err(_) -> None,
    },
  };
  match kept {
    Some(names) ->
      { json: object([]), lines: text_lines(style_of(flags), names), errs: [], code: ok_code() },
    None -> callers_from_sources(flags, product),
  }
}

fn callers_from_sources(
  flags: Flags,
  product: String,
) -> CommandOutput / {shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, Derives, abort.raise, diverges, shipped.report_view_used} = {
  let loaded: Program = load_program(flags.paths, flags.verify_dependencies);
  let s = style_of(flags);
  match program_view(loaded) {
    None -> rejected(s, "callers", loaded.diagnostics, loaded.source_texts),
    Some(w) -> match resolve_definition(definitions_in_order(w), flags.query) {
      Err(names) ->
        reported(s, "callers", [unknown_definition(flags.query, names)], loaded.source_texts),
      Ok(d) -> {
        let found = found_callers(loaded, w, d);
        if may_reuse_callers(flags) {
          keep_product_at(
            flags.paths,
            loaded.log_position,
            product,
            bin::encode(kept_callers(d, found.direct, found.transitive), kept_callers_bin()),
          )
        };
        callers_output(s, loaded, d, found.direct, found.transitive)
      },
    },
  }
}

fn a_test(name: Bytes, key: Bytes, index: Int) -> TestInfo =
  {
    name: name,
    module: b"m",
    key: key,
    index: index,
    nondet: false,
    cases: false,
    effects: [],
    at: { module: 0, span: dummy_span() },
  }

fn a_law(name: Bytes, key: Bytes, index: Int) -> LawInfo =
  {
    name: name,
    module: b"m",
    key: key,
    index: index,
    binders: [],
    identities: [],
    has_guard: false,
    effects: [],
    at: { module: 0, span: dummy_span() },
  }

fn a_table() -> Tables =
  {
    definitions: Map::new(),
    own: Map::new(),
    specs: Map::new(),
    hashes: {
      ..no_hashes(),
      refs: {
        ..no_refs(),
        names: [b"m.one", b"m.two", b"m.three", b"m.one", b"m.uses"],
        is_declaration: [false, false, false, true, false],
        edges: [[], [0], [1], [], [3]],
        functions: Map::of_entries([
          { key: b"m.one", value: 0 },
          { key: b"m.two", value: 1 },
          { key: b"m.three", value: 2 },
          { key: b"m.uses", value: 4 },
        ]),
        declared: Map::of_entries([{ key: b"m.one", value: [3] }]),
        items: Map::of_entries([{ key: b"m.one", value: [2] }]),
      },
    },
  }

test "`direct_callers` returns the definitions that mention a name, and `transitive_callers` returns every definition that depends on it through any chain" {
  assert_eq(direct_callers(a_table(), b"m.one"), [b"m.two"]);
  assert_eq(direct_callers(a_table(), b"m.three"), [b"m.one"]);
  assert_eq(transitive_callers(a_table(), b"m.one"), [b"m.three", b"m.two", b"m.one"])
}

test "`sorted_into` drops a name that is not a definition, test or law, such as a type declaration" {
  let ix: Index = {
    definitions: Map::new(),
    tests: Map::new().insert(b"m.two is two", a_test(b"two is two", b"m.two is two", 0)),
    laws: Map::new().insert(b"m.three", a_law(b"three is three", b"m.three", 0)),
  };
  let g = sorted_into(ix, [b"m.two is two", b"m.three", b"m.Shape"]);
  assert_eq(g.definitions.len(), 0);
  assert_eq(g.tests.map(|x: TestInfo| x.name), [b"two is two"]);
  assert_eq(g.laws.map(|x: LawInfo| x.name), [b"three is three"]);
  assert_eq(summary(names_in(g)), "0 definitions, 1 test, 1 law")
}

test "a group is titled, counted, and one indented line each" {
  let g: Group = { definitions: [], tests: [a_test(b"two is two", b"m.two is two", 0)], laws: [] };
  assert_eq(group_lines("mentioned by", names_in(g), []), [
    "   mentioned by: 0 definitions, 1 test, 0 laws",
    "      test \"two is two\"",
  ])
}
