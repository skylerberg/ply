import std.fs (fs, Missing)
import std.json (Json, Str, Bool, Number, Array, Null, object)
import args (Flags)
import paths (RootedPath, absolute, parent_of, displayed, kind, read_file, write_file, create_dir,
              move_file, rooted_path, here)
import std.env (env)
import report (CommandOutput, schema_version, ok_code, compile_error)
import walk (Failure)
import builder (builder)
import std.random (entropy)
import std.time (time)
import compiler.cc (toolchain)
import compiler.load (Derives)
import compiler.unit (shipped)
import compiler.check.resolve.tables (Source, Declaration, Namespace, declarations_in, namespaces,
                                      describe_namespace)
import compiler.check.resolve.bindings (Reference, Member, Local, FieldName)
import compiler.syntax.lexer (lex, Token)
import rename.lines (LocalLine, Moved, MemberLine, Renames, keyword_rejection, only_locals, renamed,
                     renames_of, shown)
import rename.strings (Mention, mentions_in, module_mentions, qualified_edits)
import rename.programs (Entry, Library, Loaded, Read, DeclaredRecord, DefinitionKey, libraries_of,
                        loads_of)
import rename.edits (Edit, Edited, ModuleMove, SharedName, applied, comment_edits, edited_of,
                     local_binders, shared_names, split_names, SplitName, moved_name,
                     unqualified_name, qualified_renames, record_clashes, renaming_of,
                     renames_derived, uses_renamed, with_derived, Renaming)
import rename.verify (Checked, Renamed, retargeted_calls, verified)
import program (ParsedSources)

type Change = { at: RootedPath, text: Bytes, changed: Bool, to: Option<RootedPath> }

type Plan = {
  changes: List<Change>,
  mentions: List<Mention>,
  shared: List<SharedName>,
  split: List<SplitName>,
  derived: Map<DefinitionKey, Bytes>,
  rejections: List<Failure>,
}

const nothing_planned: Plan =
  { changes: [], mentions: [], shared: [], split: [], derived: Map::new(), rejections: [] }

fn unmatched(renames: Renames, loads: List<Loaded>) -> List<Failure> / {abort.raise} = {
  let reads = loads.fold([], |accumulator: List<{ load: Loaded, read: Read }>, l: Loaded|
    accumulator.concat(l.reads.map(|r: Read| { load: l, read: r })));
  let by_path = reads.fold(
    Map::new(),
    |accumulator: Map<String, { load: Loaded, read: Read }>, x: { load: Loaded, read: Read }|
      accumulator.insert(displayed(x.read.file.at), x),
  );
  let fields_written = reads.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bool>, x: { load: Loaded, read: Read }|
      x.read.entries.fold(accumulator, |into: Map<Bytes, Bool>, e: Entry|
        e.names.members.fold(into, |found: Map<Bytes, Bool>, m: Member|
          match m.kind { FieldName(_) -> found.insert(m.name, true), _ -> found })),
  );
  let missing = |path: String| { path: path, reason: "is not among the files being renamed" };
  let declares = |x: { load: Loaded, read: Read }, name: Bytes|
    namespaces.any(|namespace: Namespace|
        declarations_in(x.load.declarations.get(x.read.index), namespace).any(|d: Declaration|
          d.name == name || unqualified_name(d.name) == name))
      || x.read.entries.any(|e: Entry|
        e.names.references.any(|r: Reference|
          r.name == name && (match r.target { Local(_) -> true, _ -> false })));
  renames.defined.fold(
    [],
    |accumulator: List<Failure>, old: Bytes, files: Map<String, Bytes>|
      files.fold(accumulator, |found: List<Failure>, file: String, _: Bytes|
        match by_path.get(file) {
          None -> found.push(missing(file)),
          Some(x) -> if declares(x, old) { found }
          else { found.push({ path: file, reason: "binds no " ++ shown(old) }) },
        }),
  ).concat(
    renames.members.fold([], |accumulator: List<Failure>, m: MemberLine|
      match by_path.get(m.file) {
        None -> accumulator.push(missing(m.file)),
        Some(x) -> if x.read.effects.any(|e: { name: Bytes, operations: List<Bytes> }|
              e.name == m.of && e.operations.contains(m.member))
            || x.read.records.any(|d: DeclaredRecord|
              d.name == m.of && d.fields.contains(m.member)) { accumulator } else {
          accumulator.push({
            path: m.file,
            reason: "declares no effect operation or record field "
              ++ shown(Bytes::concat_all([m.of, b".", m.member])),
          })
        },
      }),
  ).concat(
    renames.modules.fold([], |accumulator: List<Failure>, m: Moved|
      if by_path.keys().any(|f: String|
          f == m.path || (m.path.ends_with("/") && f.starts_with(m.path))) { accumulator }
      else { accumulator.push(missing(m.path)) }),
  ).concat(
    renames.fields.keys().filter(|old: Bytes| !fields_written.contains(old)).map(|old: Bytes|
      { path: "", reason: "no record in the files being renamed has a field " ++ shown(old) }),
  ).concat(
    renames.locals.fold([], |accumulator: List<Failure>, line: LocalLine|
      match by_path.get(line.file) {
        None -> accumulator.push(missing(line.file)),
        Some(x) -> if local_binders(x.read, line).len() > 0 { accumulator } else {
          accumulator.push({
            path: line.file ++ ":" ++ line.line.to_string(),
            reason: "declares no local " ++ shown(line.old),
          })
        },
      }),
  )
}

fn plan_of(
  renaming: Renaming,
  loads: List<Loaded>,
) -> Plan / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.read[abs], Derives, abort.raise, diverges} = {
  let renames = renaming.renames;
  let reads = loads.fold([], |accumulator: List<{ load: Loaded, read: Read }>, l: Loaded|
    accumulator.concat(l.reads.map(|r: Read| { load: l, read: r })));
  let edited = reads.map(|x: { load: Loaded, read: Read }| edited_of(renaming, x.load, x.read));
  let lexed = reads.map(|x: { load: Loaded, read: Read }| lex(x.read.file.text));
  let qualified = qualified_renames(renaming, reads.map(|x: { load: Loaded, read: Read }| x.read));
  let strings = range(0, reads.len()).map(|i: Int|
    qualified_edits(reads.get(i).read.file.text, lexed.get(i).tokens, qualified));
  let changes = range(0, reads.len()).map(|i: Int| {
    let r = reads.get(i).read;
    let e = edited.get(i);
    let text = applied(
      r.file.text,
      e.edits.concat(comment_edits(r.file.text, lexed.get(i).comments, e)).concat(strings.get(i)),
    );
    {
      at: r.file.at,
      text: text,
      changed: text != r.file.text,
      to: renaming.modules.get(absolute(renaming.pwd, r.file.at)).map(|m: ModuleMove| m.to),
    }
  });
  let moved_names = reads.fold([], |accumulator: List<Bytes>, x: { load: Loaded, read: Read }|
    if renaming.modules.contains(absolute(renaming.pwd, x.read.file.at)) {
      accumulator.push(x.read.name)
    } else { accumulator });
  let qualifiers = renaming.modules.values().fold(
    Map::new(),
    |accumulator: Map<Bytes, Bool>, m: ModuleMove|
      match m.before.at(m.before.len() - 1) {
        Some(last) -> accumulator.insert(last, true),
        None -> accumulator,
      },
  );
  let olds = edited.fold(Map::new(), |accumulator: Map<Bytes, Bool>, e: Edited|
    e.renamed.fold(accumulator, |into: Map<Bytes, Bool>, old: Bytes, _: List<Bytes>|
      if qualifiers.contains(old) { into } else { into.insert(old, true) }));
  let words = olds.fold(Map::new(), |accumulator: Map<Bytes, Bool>, old: Bytes, _: Bool|
    if renames.words || renames.names.contains(old) { accumulator.insert(old, true) }
    else { accumulator });
  let names = edited.fold(Map::new(), |accumulator: Map<Bytes, Bool>, e: Edited|
    e.edits.fold(accumulator, |into: Map<Bytes, Bool>, x: Edit|
      x.names.fold(into, |n: Map<Bytes, Bool>, name: Bytes| n.insert(name, true))));
  let named = names.keys().fold([], |accumulator: List<Failure>, name: Bytes|
    match keyword_rejection(name) { Some(f) -> accumulator.push(f), None -> accumulator });
  let targets = changes.fold(
    Map::new(),
    |accumulator: Map<String, List<String>>, change: Change|
      match change.to {
        Some(to) ->
          accumulator.insert(
            displayed(to),
            accumulator.get(displayed(to)).unwrap_or([]).push(displayed(change.at)),
          ),
        None -> accumulator,
      },
  );
  let crowded = targets.fold(
    [],
    |accumulator: List<Failure>, target: String, from: List<String>|
      if from.len() > 1 {
        accumulator.push({
          path: target,
          reason: String::join(from, " and ") ++ " would both be moved here",
        })
      } else { accumulator },
  );
  let taken = changes.fold([], |accumulator: List<Failure>, change: Change|
    match change.to {
      Some(to) -> if kind(to) != Missing {
        accumulator.push({
          path: displayed(to),
          reason: displayed(change.at) ++ " would be moved here, but this file already exists",
        })
      } else { accumulator },
      None -> accumulator,
    });
  let rejections = renaming.rejections.concat(unmatched(renames, loads)).concat(named).concat(
    edited.fold([], |accumulator: List<Failure>, e: Edited| accumulator.concat(e.failures)),
  ).concat(
    crowded,
  ).concat(
    taken,
  ).concat(
    retargeted_calls(renaming, loads),
  ).concat(
    record_clashes(renaming, loads),
  ).concat(
    loads.fold([], |accumulator: List<Failure>, l: Loaded|
      l.unrenamed.fold(accumulator, |found: List<Failure>, r: Read|
        if !uses_renamed(renaming, l, r) { found } else {
          found.push({
            path: displayed(r.file.at),
            reason: "uses a name that the rename changes, but this file is not in the paths given on the command line",
          })
        })),
  );
  let texts = range(0, reads.len()).fold(Map::new(), |accumulator: Map<String, Bytes>, i: Int|
    accumulator.insert(absolute(renaming.pwd, reads.get(i).read.file.at), changes.get(i).text));
  let library = range(0, reads.len()).fold(Map::new(), |accumulator: Map<Bytes, Source>, i: Int| {
    let r = reads.get(i).read;
    accumulator.insert(r.name, {
      name: moved_name(r.name, renaming.modules.get(absolute(renaming.pwd, r.file.at))),
      source_text: changes.get(i).text,
    })
  });
  let checked: Checked = if rejections.len() > 0 { { failures: rejections, derived: Map::new() } }
  else {
    let renamed = changes.fold(
      { pwd: renaming.pwd, texts: Map::new(), gone: Map::new() },
      |accumulator: Renamed, change: Change|
        match change.to {
          Some(to) ->
            {
              ..accumulator,
              texts: accumulator.texts.insert(absolute(renaming.pwd, to), change.text),
              gone: accumulator.gone.insert(absolute(renaming.pwd, change.at), true),
            },
          None -> if !change.changed { accumulator } else {
            {
              ..accumulator,
              texts: accumulator.texts.insert(absolute(renaming.pwd, change.at), change.text),
            }
          },
        },
    );
    loads.fold(
      { checked: { failures: [], derived: Map::new() }, parses: Map::new() },
      |accumulator: { checked: Checked, parses: ParsedSources }, l: Loaded| {
        let v = verified(renaming, l, library, texts, renamed, accumulator.parses);
        {
          checked: {
            failures: accumulator.checked.failures.concat(v.checked.failures),
            derived: v.checked.derived.fold(
              accumulator.checked.derived,
              |m: Map<DefinitionKey, Bytes>, key: DefinitionKey, new: Bytes| m.insert(key, new),
            ),
          },
          parses: v.parses,
        }
      },
    ).checked
  };
  {
    changes: changes.filter(|change: Change| change.changed || change.to != None),
    shared: shared_names(renaming, loads),
    split: split_names(renaming, loads),
    mentions: range(0, reads.len()).fold([], |accumulator: List<Mention>, i: Int| {
      let r = reads.get(i).read;
      let rewritten = strings.get(i);
      let tokens = lexed.get(i).tokens.filter(|t: Token|
        !rewritten.any(|s: Edit| s.start > t.start && s.end < t.end));
      accumulator.concat(
        mentions_in(displayed(r.file.at), r.file.text, tokens, olds, words),
      ).concat(
        module_mentions(displayed(r.file.at), r.file.text, tokens, moved_names),
      )
    }),
    derived: checked.derived,
    rejections: checked.failures,
  }
}

fn planned(
  pwd: String,
  renames: Renames,
  loads: List<Loaded>,
  libraries: List<Library>,
) -> Plan / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.read[abs], Derives, abort.raise, diverges} = {
  let renaming = renaming_of(pwd, renames, loads, libraries);
  let first = plan_of(renaming, loads);
  if renames_derived(renaming, first.derived) { first }
  else { plan_of(with_derived(renaming, first.derived), loads) }
}

fn saved(
  change: Change,
) -> Option<Failure> / {fs.write_file[cwd], fs.write_file[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.rename[cwd], fs.rename[abs]} =
  if change.changed && !write_file(change.at, change.text) {
    Some({ path: displayed(change.at), reason: "could not write" })
  } else {
    match change.to {
      None -> None,
      Some(to) -> {
        let room = match parent_of(to) { Some(dir) -> create_dir(dir), None -> true };
        if room && move_file(change.at, to) { None }
        else { Some({ path: displayed(change.at), reason: "could not move to " ++ displayed(to) }) }
      },
    }
  }

fn json_report(plan: Plan, failures: List<Failure>, code: Int) -> Json =
  object([
    { key: "command", value: Str("rename") },
    { key: "schema_version", value: Number(Decimal::of_int(schema_version)) },
    { key: "ok", value: Bool(code == 0) },
    { key: "exit_code", value: Number(Decimal::of_int(code)) },
    {
      key: "files",
      value: Array(
        plan.changes.map(|change: Change|
          object([
            { key: "path", value: Str(displayed(change.at)) },
            {
              key: "moved_to",
              value: match change.to { Some(to) -> Str(displayed(to)), None -> Null },
            },
          ])),
      ),
    },
    {
      key: "mentions",
      value: Array(
        plan.mentions.map(|m: Mention|
          object([
            { key: "path", value: Str(m.path) },
            { key: "line", value: Number(Decimal::of_int(m.line)) },
            { key: "name", value: Str(String::of_bytes_lossy(m.name)) },
          ])),
      ),
    },
    {
      key: "shared_names",
      value: Array(
        plan.shared.map(|s: SharedName|
          object([
            { key: "path", value: Str(s.path) },
            { key: "line", value: Number(Decimal::of_int(s.line)) },
            { key: "from", value: Str(String::of_bytes_lossy(s.old)) },
            { key: "to", value: Str(String::of_bytes_lossy(s.new)) },
            { key: "also", value: Str(String::of_bytes_lossy(describe_namespace(s.other))) },
          ])),
      ),
    },
    {
      key: "errors",
      value: Array(
        failures.map(|f: Failure|
          object([{ key: "path", value: Str(f.path) }, { key: "error", value: Str(f.reason) }])),
      ),
    },
  ])

fn command_output(plan: Plan, failures: List<Failure>, check: Bool) -> CommandOutput = {
  let code = if failures.len() > 0 { compile_error }
  else if check && plan.changes.len() > 0 { 1 }
  else { ok_code };
  let verb = if check { "would rename in " } else { "renamed in " };
  {
    json: json_report(plan, failures, code),
    lines: plan.changes.fold([], |accumulator: List<String>, change: Change| {
      let renamed_in = if change.changed { accumulator.push(verb ++ displayed(change.at)) }
      else { accumulator };
      match change.to {
        Some(to) ->
          renamed_in.push(
            (if check { "would move " } else { "moved " }) ++ displayed(change.at) ++ " to "
              ++ displayed(to),
          ),
        None -> renamed_in,
      }
    }),
    errs: failures.map(|f: Failure|
      "error: " ++ (if f.path == "" { "" } else { f.path ++ ": " }) ++ f.reason).concat(
      plan.mentions.map(|m: Mention|
        "warning: " ++ m.path ++ ":" ++ m.line.to_string()
          ++ ": a string contains the renamed name "
          ++ shown(m.name)),
    ).concat(
      plan.shared.map(|s: SharedName|
        "warning: " ++ s.path ++ ":" ++ s.line.to_string() ++ ": renaming " ++ shown(s.old)
          ++ " to "
          ++ shown(s.new)
          ++ " gives it the name of a "
          ++ String::of_bytes_lossy(describe_namespace(s.other))
          ++ " this module also uses"),
    ).concat(
      plan.split.map(|s: SplitName|
        "warning: " ++ s.path ++ ":" ++ s.line.to_string() ++ ": renaming the type " ++ shown(s.old)
          ++ " to "
          ++ shown(s.new)
          ++ " also renames the variant "
          ++ shown(s.old)
          ++ " of "
          ++ shown(s.sum)
          ++ ", which is a different item that only has the same name"),
    ),
    code: code,
  }
}

fn rejected_with(reason: String) -> CommandOutput =
  command_output(nothing_planned, [{ path: "", reason: reason }], false)

pub fn run(
  flags: Flags,
) -> CommandOutput / {env.working_directory, shipped.read_pack, toolchain.reuse_dir, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.resolved_kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.write_file[cwd], fs.write_file[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.rename[cwd], fs.rename[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, Derives, abort.raise, diverges} =
  match flags.renames_file {
    None -> rejected_with("list the renames in a file and pass it with `--map FILE`"),
    Some(map) -> match read_file(rooted_path(map)) {
      None -> rejected_with(map ++ ": could not read"),
      Some(text) -> match renames_of(text, flags.words) {
        Err(reason) -> rejected_with(map ++ ": " ++ reason),
        Ok(renames) -> {
          let given = if flags.paths.len() == 0 { [here()] } else { flags.paths };
          let pwd = env.working_directory();
          let libraries = libraries_of(given);
          let loading = loads_of(given, pwd, !only_locals(renames));
          if loading.failures.len() > 0 { command_output(nothing_planned, loading.failures, false) }
          else {
            let plan = planned(pwd, renames, loading.loads, libraries);
            if flags.check { command_output(plan, plan.rejections, true) }
            else if plan.rejections.len() > 0 {
              command_output(nothing_planned, plan.rejections, false)
            } else {
              command_output(
                plan,
                plan.changes.fold([], |accumulator: List<Failure>, change: Change|
                  match saved(change) { Some(f) -> accumulator.push(f), None -> accumulator }),
                false,
              )
            }
          }
        },
      },
    },
  }
