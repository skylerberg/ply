import compiler.front.facts (ShippedModuleSummary)
import compiler.front (ShippedInputs, shipped_viewer, shipped_views)
import compiler.check.resolve.tables (Source)
import compiler.store.hash.encoding (hex)
import compiler.front.interface (imported)
import sources (shipping_for, shipped_text)
import std.fs (fs)
import std.hash (blake3)

pub type Form = { module: Bytes, text: Bytes, form: Bytes }

pub type ViewedFunction = { module: Bytes, name: Bytes, hash: Bytes }

pub type TraceViews = { forms: List<Form>, definitions: List<ViewedFunction> }

pub type SplitTrace = { rest: Bytes, shipped_views: TraceViews }

pub fn split(trace: Bytes) -> SplitTrace = {
  let parted = trace.split(b"\n").fold(
    { rest: [], forms: [], definitions: [] },
    |acc: { rest: List<Bytes>, forms: List<Form>, definitions: List<ViewedFunction> }, line: Bytes|
      match line.split(b"\t") {
        [b"shipform", module, text, form] ->
          { ..acc, forms: acc.forms.push({ module: module, text: text, form: form }) },
        [b"shipdef", module, name, hash] ->
          { ..acc, definitions: acc.definitions.push({ module: module, name: name, hash: hash }) },
        _ -> if line.len() == 0 { acc } else { { ..acc, rest: acc.rest.push(line).push(b"\n") } },
      },
  );
  {
    rest: Bytes::concat_all(parted.rest),
    shipped_views: { forms: parted.forms, definitions: parted.definitions },
  }
}

pub type ShippedState = { texts: Map<Bytes, Option<Bytes>>, whole: Option<Map<Bytes, WholeModule>> }

pub type WholeModule = { form: Bytes, hashes: Map<Bytes, Bytes> }

pub fn shipped_state_of<| e>(
  viewed: List<TraceViews>,
  read: (Bytes) -> Option<Bytes> / e,
) -> ShippedState / {fs.list_dir[shipped], fs.read_file[shipped], abort.raise | e} = {
  let named = viewed.fold(Map::new(), |acc: Map<Bytes, Bool>, v: TraceViews|
    v.forms.fold(acc, |a: Map<Bytes, Bool>, f: Form| a.insert(f.module, true)));
  let texts = named.fold(Map::new(), |acc: Map<Bytes, Option<Bytes>>, module: Bytes, b: Bool|
    acc.insert(module, match read(module) { Some(text) -> Some(hex(blake3(text))), None -> None }));
  let stale_view = viewed.fold(Map::new(), |acc: Map<Bytes, Bool>, v: TraceViews|
    v.forms.fold(acc, |a: Map<Bytes, Bool>, f: Form|
      match texts.get(f.module) {
        Some(Some(now)) -> if now == f.text { a } else { a.insert(f.module, true) },
        _ -> a,
      }));
  let modules = stale_view.keys();
  if modules.len() == 0 { { texts: texts, whole: Some(Map::new()) } } else {
    let shipping = shipping_for([shipped_viewer(modules)], {
      root: b"",
      manifest: None,
      supplied: [],
    });
    {
      texts: texts,
      whole: match shipped_views(modules, shipping.sources, shipping.unread, shipping.data) {
        Err(_) -> None,
        Ok(views) ->
          Some(
            views.fold(Map::new(), |acc: Map<Bytes, WholeModule>, v: ShippedModuleSummary|
              acc.insert(v.module, {
                form: v.form,
                hashes: v.definitions.fold(
                  Map::new(),
                  |h: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }| h.insert(d.name, d.hash),
                ),
              })),
          ),
      },
    }
  }
}

pub fn loaded_texts(shipping: ShippedInputs, reached: Bool) -> Map<Bytes, Bytes> =
  if !reached { Map::new() } else {
    shipping.sources.fold(Map::new(), |acc: Map<Bytes, Bytes>, s: Source| acc.insert(s.name, s.src))
  }

pub fn read_shipped_text(
  held: Map<Bytes, Bytes>,
  name: Bytes,
) -> Option<Bytes> / {fs.read_file[shipped], abort.raise} =
  match held.get(name) {
    Some(text) -> Some(text),
    None -> match shipped_text(name) { Some(text) -> Some(imported(text)), None -> None },
  }

pub fn views_in(traces: List<Bytes>) -> List<TraceViews> =
  traces.map(|t: Bytes| split(t).shipped_views)

pub fn stale_view(now: ShippedState, viewed: TraceViews) -> Option<String> = {
  let module = |m: Bytes|
    Some("the bundled module `" ++ String::of_bytes_lossy(m) ++ "` has changed");
  let held = viewed.forms.fold(
    { reason: None, same: Map::new(), read: Map::new() },
    |acc: { reason: Option<String>, same: Map<Bytes, Bool>, read: Map<Bytes, WholeModule> }, f: Form|
      if acc.reason != None { acc } else {
        match now.texts.get(f.module) {
          Some(Some(text)) -> if text == f.text { { ..acc, same: acc.same.insert(f.module, true) } }
          else {
            match match now.whole { Some(whole) -> whole.get(f.module), None -> None } {
              Some(w) -> if w.form == f.form { { ..acc, read: acc.read.insert(f.module, w) } }
              else { { ..acc, reason: module(f.module) } },
              None -> { ..acc, reason: module(f.module) },
            }
          },
          _ -> { ..acc, reason: module(f.module) },
        }
      },
  );
  if held.reason != None { held.reason } else {
    viewed.definitions.fold(None, |acc: Option<String>, d: ViewedFunction|
      if acc != None { acc } else {
        match held.read.get(d.module) {
          Some(w) -> if w.hashes.get(d.name) == Some(d.hash) { None } else {
            Some("the bundled definition `" ++ String::of_bytes_lossy(d.name) ++ "` has changed")
          },
          None -> if held.same.contains(d.module) { None } else { module(d.module) },
        }
      })
  }
}

test "`split` separates the `shipform` and `shipdef` lines of a recorded trace from its other lines" {
  let s = split(
    b"file\tcwd\ta.ply\t\tabc\nshipform\tstd.list\tt1\tf1\nshipdef\tstd.list\tstd.list.take\th1\nshipped\t\td0\n",
  );
  assert_eq(s.rest, b"file\tcwd\ta.ply\t\tabc\nshipped\t\td0\n");
  assert_eq(s.shipped_views.forms, [{ module: b"std.list", text: b"t1", form: b"f1" }]);
  assert_eq(s.shipped_views.definitions, [
    { module: b"std.list", name: b"std.list.take", hash: b"h1" },
  ])
}

test "`stale_view` accepts a recorded module view if the module text is unchanged, or else if its form and definition hashes are unchanged" {
  let viewed = {
    forms: [{ module: b"std.list", text: b"t1", form: b"f1" }],
    definitions: [{ module: b"std.list", name: b"std.list.take", hash: b"h1" }],
  };
  let whole = |form: Bytes, definitions: List<{ name: Bytes, hash: Bytes }>|
    Some(
      Map::new().insert(b"std.list", {
        form: form,
        hashes: definitions.fold(
          Map::new(),
          |h: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }| h.insert(d.name, d.hash),
        ),
      }),
    );
  let texts = |t: Option<Bytes>| Map::new().insert(b"std.list", t);
  assert_eq(stale_view({ texts: texts(Some(b"t1")), whole: None }, viewed), None);
  let added = whole(b"f1", [
    { name: b"std.list.take", hash: b"h1" },
    { name: b"std.list.later", hash: b"h9" },
  ]);
  assert_eq(stale_view({ texts: texts(Some(b"t2")), whole: added }, viewed), None);
  assert_eq(
    stale_view(
      { texts: texts(Some(b"t2")), whole: whole(b"f1", [{ name: b"std.list.take", hash: b"h2" }]) },
      viewed,
    ),
    Some("the bundled definition `std.list.take`"),
  );
  assert_eq(
    stale_view(
      { texts: texts(Some(b"t2")), whole: whole(b"f2", [{ name: b"std.list.take", hash: b"h1" }]) },
      viewed,
    ),
    Some("the bundled module `std.list`"),
  );
  assert_eq(
    stale_view({ texts: texts(None), whole: Some(Map::new()) }, viewed),
    Some("the bundled module `std.list`"),
  );
  assert_eq(
    stale_view({ texts: texts(Some(b"t2")), whole: None }, viewed),
    Some("the bundled module `std.list`"),
  );
  assert_eq(
    stale_view({ texts: texts(Some(b"t1")), whole: None }, { ..viewed, forms: [] }),
    Some("the bundled module `std.list`"),
  )
}
