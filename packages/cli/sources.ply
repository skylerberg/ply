import std.fs
import std.fs (fs, MemFs, mem_empty, mem_list, mem_write, on_mem)
import std.bytes (u64_le)
import std.hash (blake3)
import compiler.store.hash.encoding (hex)
import std.path (join, is_absolute, normalize, parent, strip_root)
import compiler.front.rows (module_of)
import compiler.front (EmbedRecord, ShippedInputs, ShippedData, ShippedWants, embeds_wanted,
                       dependencies_of, shipped_data_wanted, shipped_inputs_of, shipped_wants,
                       shipped_inputs_of_pulled)
import compiler.unit (identity_of, read_cached_file, write_cached_file)
import compiler.front.interface (blanked, imported)
import compiler.syntax.items (parse, unneeded_spans, is_std)
import std.bin
import std.random (entropy)
import std.time (time)
import compiler.expand.embed (EmbedResult, EmbedBytesResult, EmbedRequest, with_digests)
import compiler.check.resolve.tables (Source, Diagnostic, Label, error_at)
import builder (builder)
import compiler.cc (toolchain)
import compiler.load (embedded_below, is_ply)
import compiler.front.pkg (PackageSources, SuppliedPackage, roots_wanted)
import paths
import paths (RootedPath, displayed, read_file)
import walk (Failure, WalkResult, walk_for_load, nothing, walk_package)
import std.list
import compiler.syntax.parsing (no_module, Span, dummy_span, span_between)

pub type File = { path: String, module: String, text: Bytes, at: RootedPath }

pub type DependencyPackage = {
  root: String,
  dir: String,
  manifest: Option<Bytes>,
  files: List<File>,
}

pub type VendoredPackage = { requirement: String, dir: String }

pub type Project = {
  files: List<File>,
  sources: List<Source>,
  diagnostics: List<Diagnostic>,
  manifest: Option<File>,
  packages: List<DependencyPackage>,
  root_key: String,
}

pub type Embed = { embedded: EmbedRecord, file: RootedPath }

pub fn unlocated_error(
  code: Bytes,
  message: String,
  label: Bytes,
  notes: List<Bytes>,
) -> Diagnostic = error_at(code, no_module(), dummy_span(), Bytes::of_string(message), label, notes)

fn at_file(code: Bytes, m: Int, message: String, label: Bytes, notes: List<Bytes>) -> Diagnostic =
  error_at(code, m, dummy_span(), Bytes::of_string(message), label, notes)

fn unaddressable(m: Int, path: String, reason: String) -> Diagnostic =
  at_file(
    b"E0111",
    m,
    "`" ++ path ++ "` cannot be a module: " ++ reason,
    b"the file name cannot be used as a module name",
    [
      b"rename it so every directory name and the file name (without `.ply`) contains only letters, digits and `_`, and does not start with a digit",
    ],
  )

fn unreadable(path: String) -> Diagnostic =
  unlocated_error(b"E0502", "could not read `" ++ path ++ "`", b"this path could not be loaded", [
    b"pass a `.ply` file or a directory containing one",
  ])

pub fn no_ply_files(path: String) -> Diagnostic =
  unlocated_error(b"E0502", "no `.ply` files under `" ++ path ++ "`", b"nothing to compile", [
    b"name a `.ply` file, or a directory that contains one",
    b"directories whose name starts with `.` are not searched",
  ])

pub fn no_package(pwd: String) -> Diagnostic =
  unlocated_error(
    b"E0502",
    "no `ply.pkg` in `" ++ pwd ++ "` or any directory above it",
    b"no package to load",
    [
      b"name a `.ply` file or a directory to load it without a package",
      b"`ply new NAME` starts a package",
    ],
  )

fn rejected_file(project: Project, file: File, diagnostic: Diagnostic) -> Project =
  { ..project, files: project.files.push(file), diagnostics: project.diagnostics.push(diagnostic) }

fn with_module(
  project: Project,
  rooted: RootedPath,
  path: String,
  text: Bytes,
  part: String,
) -> Project / {abort.raise} = {
  let here = project.files.len();
  match module_of(path) {
    Err(reason) ->
      rejected_file(
        project,
        { path: path, module: "", text: text, at: rooted },
        unaddressable(here, path, reason),
      ),
    Ok(stem) -> {
      let name = if part == "" { stem } else { part ++ "." ++ stem };
      {
        ..project,
        files: project.files.push({ path: path, module: name, text: text, at: rooted }),
        sources: project.sources.push({ name: Bytes::of_string(name), source_text: text }),
      }
    },
  }
}

fn one_file(
  strip: String,
  part: String,
  project: Project,
  rooted: RootedPath,
) -> Project / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match read_file(rooted) {
    None -> { ..project, diagnostics: project.diagnostics.push(unreadable(displayed(rooted))) },
    Some(text) -> {
      let display = match paths::strip_prefix(rooted.path, strip) {
        Some(rest) -> if rest == "" { rooted.path } else { rest },
        None -> rooted.path,
      };
      with_module(project, rooted, display, text, part)
    },
  }

fn empty() -> Project =
  { files: [], sources: [], diagnostics: [], manifest: None, packages: [], root_key: "" }

fn read(
  found: WalkResult,
  strip: String,
  part: String = "",
) -> Project / {fs.read_file[cwd], fs.read_file[abs], abort.raise} = {
  let recorded: Project = found.files.values().fold(
    empty(),
    |accumulator: Project, rooted: RootedPath| one_file(strip, part, accumulator, rooted),
  );
  found.errors.fold(recorded, |accumulator: Project, e: Failure|
    { ..accumulator, diagnostics: accumulator.diagnostics.push(unreadable(e.path)) })
}

fn named_path_errors(
  resolved: paths::ResolvedPath,
) -> List<Diagnostic> / {fs.kind[cwd], fs.kind[abs]} = {
  let at = paths::rooted(resolved);
  match paths::kind(at) {
    fs::Missing -> [unreadable(displayed(at))],
    fs::Symlink -> [unreadable(displayed(at))],
    _ -> [],
  }
}

fn load_path(
  resolved: paths::ResolvedPath,
) -> Project / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise, diverges} = {
  let own = read(walk_for_load(nothing(), resolved), paths::root_prefix(resolved), resolved.part);
  match with_manifest(resolved, empty()).manifest {
    None -> if resolved.part == "" { own }
    else { { ..own, diagnostics: own.diagnostics.concat(named_path_errors(resolved)) } },
    Some(manifest) ->
      {
        ..own,
        manifest: Some(manifest),
        diagnostics: own.diagnostics.concat(named_path_errors(resolved)),
      },
  }
}

pub fn load_resolved(
  rs: List<paths::ResolvedPath>,
) -> Project / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise, diverges} = {
  let rs = if rs.len() == 0 { [paths::here()] } else { rs };
  let merged = rs.fold(
    { project: empty(), packages: [] },
    |accumulator: { project: Project, packages: List<RootedPath> }, resolved: paths::ResolvedPath| {
      let root: RootedPath = { label: resolved.label, path: resolved.root_path };
      if accumulator.packages.contains(root) {
        {
          ..accumulator,
          project: {
            ..accumulator.project,
            diagnostics: accumulator.project.diagnostics.concat(named_path_errors(resolved)),
          },
        }
      } else {
        let one = load_path(resolved);
        {
          project: merge(accumulator.project, one),
          packages: if one.manifest != None || resolved.part != "" {
            accumulator.packages.push(root)
          } else { accumulator.packages },
        }
      }
    },
  ).project;
  match rs.at(0) {
    None -> merged,
    Some(first) ->
      {
        ..merged,
        packages: walk_packages(first.absolute, merged.manifest),
        root_key: first.absolute,
      },
  }
}

fn package_files(project: Project, k: Int) -> List<File> =
  if k == 0 { project.files }
  else { match project.packages.at(k - 1) { Some(p) -> p.files, None -> [] } }

fn package_root(project: Project, k: Int) -> String =
  if k == 0 { project.root_key }
  else { match project.packages.at(k - 1) { Some(p) -> p.root, None -> "" } }

pub fn read_module_embed(
  project: Project,
  k: Int,
  module: Bytes,
  want: EmbedRequest,
) -> EmbedBytesResult / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match package_files(project, k).filter(|f: File| Bytes::of_string(f.module) == module) {
    [f, ..] -> read_embed(f.at, want),
    [] -> Err(b"no file in this package has that module name"),
  }

pub fn embed_of(
  project: Project,
  k: Int,
  module: Bytes,
  want: EmbedRequest,
  read: EmbedResult,
) -> Option<Embed> =
  match package_files(project, k).filter(|f: File| Bytes::of_string(f.module) == module) {
    [f, ..] ->
      Some({
        embedded: {
          root: Bytes::of_string(package_root(project, k)),
          module: module,
          want: want,
          read: read,
        },
        file: f.at,
      }),
    [] -> None,
  }

pub fn embeds_parsed(
  project: Project,
) -> List<Embed> / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  project.packages.fold(
    read_embeds(Bytes::of_string(project.root_key), project.files),
    |accumulator: List<Embed>, package: DependencyPackage|
      accumulator.concat(read_embeds(Bytes::of_string(package.root), package.files)),
  )

fn read_embeds(
  root: Bytes,
  files: List<File>,
) -> List<Embed> / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  files.fold([], |accumulator: List<Embed>, file: File|
    embeds_wanted(root, [{ name: Bytes::of_string(file.module), source_text: file.text }]).fold(
      accumulator,
      |a: List<Embed>, e: EmbedRecord|
        a.push({
          embedded: { ..e, read: with_digests(read_embed(file.at, e.want)) },
          file: file.at,
        }),
    ))

pub fn embeds_changed(
  embeds: List<Embed>,
) -> Bool / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  embeds.fold(false, |accumulator: Bool, embed: Embed|
    accumulator || with_digests(read_embed(embed.file, embed.embedded.want)) != embed.embedded.read)

fn embed_target(rooted: RootedPath, path: String) -> RootedPath / {abort.raise} =
  if is_absolute(path) { paths::rooted_path(path) }
  else { { label: rooted.label, path: normalize(join(parent(rooted.path), path)) } }

fn unreadable_embed(target: RootedPath, what: String) -> EmbedBytesResult =
  Err(Bytes::of_string("`" ++ displayed(target) ++ "` " ++ what))

fn read_embed(
  rooted: RootedPath,
  w: EmbedRequest,
) -> EmbedBytesResult / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} = {
  let target = embed_target(rooted, String::of_bytes_lossy(w.path));
  match paths::kind(target) {
    fs::Missing -> unreadable_embed(target, "does not exist"),
    fs::Dir -> if w.dir { read_dir(target) }
    else { unreadable_embed(target, "is a directory, and `embed` takes a file") },
    fs::File -> if w.dir {
      unreadable_embed(target, "is a file, and `embed_dir` takes a directory")
    } else { read_one(target) },
    fs::Symlink -> if w.dir { read_dir(target) } else { read_one(target) },
  }
}

fn read_one(target: RootedPath) -> EmbedBytesResult / {fs.read_file[cwd], fs.read_file[abs]} =
  match read_file(target) {
    Some(b) -> Ok([{ name: b"", bytes: b }]),
    None -> unreadable_embed(target, "could not be read"),
  }

fn read_dir(
  target: RootedPath,
) -> EmbedBytesResult / {fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs]} = {
  let under = |path: String| { label: target.label, path: path };
  let walked = if target.label == "cwd" { embedded_below[cwd](target.path) }
  else { embedded_below[abs](target.path) };
  match walked {
    Err(stopped) -> unreadable_embed(under(stopped.path), stopped.reason),
    Ok(found) ->
      found.fold(Ok([]), |accumulator: EmbedBytesResult, name: String, path: String|
        match accumulator {
          Err(_) -> accumulator,
          Ok(files) -> match read_file(under(path)) {
            Some(b) -> Ok(files.push({ name: Bytes::of_string(name), bytes: b })),
            None -> unreadable_embed(under(path), "could not be read"),
          },
        }),
  }
}

fn read_dependency_modules(
  root: String,
) -> List<File> / {fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} = {
  let swept = at_abs(root);
  let found = walk_package(nothing(), swept);
  found.files.values().fold([], |accumulator: List<File>, rooted: RootedPath|
    match paths::strip_prefix(rooted.path, swept.path) {
      None -> accumulator,
      Some(rest) -> match read_file(rooted) {
        None -> accumulator,
        Some(text) -> match module_of(rest) {
          Err(_) -> accumulator,
          Ok(name) ->
            accumulator.push({ path: root ++ "/" ++ rest, module: name, text: text, at: rooted }),
        },
      },
    })
}

fn at_abs(path: String) -> RootedPath / {abort.raise} = { label: "abs", path: strip_root(path) }

fn read_dependency(
  root: Bytes,
  dir: String,
) -> DependencyPackage / {fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} = {
  let here = String::of_bytes_lossy(root);
  match read_file(at_abs(join(dir, "ply.pkg"))) {
    None -> { root: here, dir: dir, manifest: None, files: [] },
    Some(text) ->
      { root: here, dir: dir, manifest: Some(text), files: read_dependency_modules(dir) },
  }
}

pub fn index_path(project: String) -> String = join(project, "vendor/index")

pub fn vendored(
  project: String,
) -> List<VendoredPackage> / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match read_file(at_abs(index_path(project))) {
    None -> [],
    Some(text) -> parse_vendor_index(text),
  }

fn parse_vendor_index(text: Bytes) -> List<VendoredPackage> / {abort.raise} =
  text.split(b"\n").fold([], |accumulator: List<VendoredPackage>, line: Bytes|
    match line.index_of(b"\t") {
      None -> accumulator,
      Some(tab) ->
        accumulator.push({
          requirement: String::of_bytes_lossy(line.slice(0, tab)),
          dir: String::of_bytes_lossy(line.slice(tab + 1, line.len())),
        }),
    })

pub fn from_vendor(project: String, items: List<VendoredPackage>, want: Bytes) -> Option<String> =
  items.fold(None, |found: Option<String>, v: VendoredPackage|
    match found {
      Some(_) -> found,
      None -> if Bytes::of_string(v.requirement) == want { Some(join(project, v.dir)) }
      else { None },
    })

fn walk_round(
  root: String,
  vendored: List<VendoredPackage>,
  known: List<Bytes>,
  manifests: List<SuppliedPackage>,
  supplied: List<DependencyPackage>,
) -> List<DependencyPackage> / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise, diverges} =
  match roots_wanted(known, manifests) {
    [] -> supplied,
    wanted -> {
      let next = wanted.fold(
        { known: known, manifests: manifests, supplied: supplied },
        |accumulator: { known: List<Bytes>, manifests: List<SuppliedPackage>, supplied: List<DependencyPackage> }, want: Bytes| {
          match dependency_dir(root, vendored, want) {
            None -> { ..accumulator, known: accumulator.known.push(want) },
            Some(tree) -> {
              let package = read_dependency(want, tree);
              {
                known: accumulator.known.push(want),
                manifests: accumulator.manifests.push({
                  root: want,
                  manifest: package.manifest,
                  modules: [],
                }),
                supplied: accumulator.supplied.push(package),
              }
            },
          }
        },
      );
      walk_round(root, vendored, next.known, next.manifests, next.supplied)
    },
  }

fn walk_packages(
  root: String,
  manifest: Option<File>,
) -> List<DependencyPackage> / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise, diverges} = {
  let root_key = Bytes::of_string(root);
  walk_round(
    root,
    vendored(root),
    [root_key],
    [
      {
        root: root_key,
        manifest: match manifest { None -> None, Some(f) -> Some(f.text) },
        modules: [],
      },
    ],
    [],
  )
}

pub fn dependency_dir(
  project: String,
  vendored: List<VendoredPackage>,
  want: Bytes,
) -> Option<String> / {builder.git[vcs]} =
  match from_vendor(project, vendored, want) {
    Some(dir) -> Some(dir),
    None -> fetched(project, want),
  }

fn fetched(project: String, want: Bytes) -> Option<String> / {builder.git[vcs]} =
  if want.starts_with(b"git+") { builder.git[vcs](project, String::of_bytes_lossy(want)) }
  else { Some(String::of_bytes_lossy(want)) }

fn with_manifest(
  resolved: paths::ResolvedPath,
  project: Project,
) -> Project / {fs.read_file[cwd], fs.read_file[abs]} =
  match project.manifest {
    Some(_) -> project,
    None -> {
      let at = paths::in_root(resolved, "ply.pkg");
      match read_file(at) {
        None -> project,
        Some(text) ->
          { ..project, manifest: Some({ path: displayed(at), module: "", text: text, at: at }) },
      }
    },
  }

fn merge(a: Project, b: Project) -> Project = {
  let files = b.files.fold(a.files, |accumulator: List<File>, file: File| accumulator.push(file));
  let sources = b.sources.fold(a.sources, |accumulator: List<Source>, source: Source|
    accumulator.push(source));
  {
    files: files,
    sources: sources,
    diagnostics: b.diagnostics.fold(
      a.diagnostics,
      |accumulator: List<Diagnostic>, diagnostic: Diagnostic| accumulator.push(diagnostic),
    ),
    manifest: match a.manifest { Some(_) -> a.manifest, None -> b.manifest },
    packages: b.packages.fold(
      a.packages,
      |accumulator: List<DependencyPackage>, package: DependencyPackage| accumulator.push(package),
    ),
    root_key: if a.root_key == "" { b.root_key } else { a.root_key },
  }
}

pub fn stem(name: String) -> String / {abort.raise} = name.slice(0, name.len() - 4)

pub fn shipped_digest_of(sources: List<Source>, data: List<ShippedData>) -> String / {abort.raise} = {
  let part = |name: Bytes, bytes: Bytes|
    Bytes::concat_all([u64_le(String::of_bytes_lossy(name).len()), name, blake3(bytes)]);
  let parts = sources.filter(|source: Source| is_std(source.name)).map(|source: Source|
    part(source.name, source.source_text)).concat(
    data.map(|d: ShippedData| part(d.name, d.bytes)),
  );
  "b3:" ++ String::of_bytes(hex(blake3(Bytes::concat_all(parts))).slice(0, 12))
}

pub fn shipped_names() -> List<Bytes> / {fs.list_dir[shipped], abort.raise} =
  match fs::listed_names(fs.list_dir[shipped](".")) {
    None -> [],
    Some(names) -> names.filter(is_ply).map(|name: String| Bytes::of_string(stem(name))),
  }

pub fn shipped_path(name: Bytes) -> RootedPath =
  { label: "shipped", path: String::of_bytes_lossy(name) ++ ".ply" }

pub fn shipped_text(name: Bytes) -> Option<Bytes> / {fs.read_file[shipped]} =
  fs.read_file[shipped](shipped_path(name).path)

pub fn shipping_for(
  user: List<Source>,
  packages: PackageSources,
) -> ShippedInputs / {fs.list_dir[shipped], fs.read_file[shipped], abort.raise} = {
  let listed = shipped_names();
  shipped_inputs_of(
    user,
    packages,
    listed,
    |name: Bytes| match shipped_text(name) { Some(text) -> Some(imported(text)), None -> None },
    |name: Bytes| fs.read_file[shipped](String::of_bytes_lossy(name)),
    dependencies_of,
  )
}

pub fn shipping_cached(
  pulled: List<Bytes>,
  wants: Map<Bytes, ShippedWants>,
) -> ShippedInputs / {toolchain.reuse_dir, fs.list_dir[shipped], fs.read_file[shipped], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} = {
  let importing = imported_reader();
  shipped_inputs_of_pulled(
    pulled,
    shipped_names(),
    |name: Bytes|
      match shipped_text(name) { Some(text) -> Some(read_imported(importing, text)), None -> None },
    |name: Bytes| fs.read_file[shipped](String::of_bytes_lossy(name)),
    |source: Source| match wants.get(source.name) { Some(w) -> w, None -> shipped_wants(source) },
    [],
  )
}

pub fn shipping_of(
  pulled: List<Bytes>,
) -> ShippedInputs / {fs.list_dir[shipped], fs.read_file[shipped], abort.raise} =
  shipped_inputs_of_pulled(
    pulled,
    shipped_names(),
    |name: Bytes| match shipped_text(name) { Some(text) -> Some(imported(text)), None -> None },
    |name: Bytes| fs.read_file[shipped](String::of_bytes_lossy(name)),
    shipped_wants,
    [],
  )

pub type ImportedReader = { dir: String, importer: Bytes }

pub fn imported_reader() -> ImportedReader / {toolchain.reuse_dir, fs.read_file[shipped], abort.raise} =
  {
    dir: strip_root(toolchain.reuse_dir()),
    importer: match fs.read_file[shipped]("definitions") {
      Some(definitions) ->
        Bytes::concat_all([
          b"ply.imported.1\x00",
          hex(bin::shape_digest(blanked_spans_bin())),
          b"\x00",
          identity_of(definitions, [b"compiler.front.interface.imported"]),
          b"\x00",
        ]),
      None -> b"",
    },
  }

pub fn read_imported(
  r: ImportedReader,
  text: Bytes,
) -> Bytes / {fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  if r.importer.len() == 0 { imported(text) } else { cached_imported(r.dir, r.importer, text) }

pub fn shipped_imported(
  r: ImportedReader,
  name: Bytes,
) -> Option<Bytes> / {fs.read_file[shipped], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  match shipped_text(name) { Some(text) -> Some(read_imported(r, text)), None -> None }

fn cached_imported(
  dir: String,
  importer: Bytes,
  text: Bytes,
) -> Bytes / {fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} = {
  let key = hex(blake3(importer.concat(blake3(text))));
  let cached_spans = match read_cached_file[abs](dir, key) {
    Some(bytes) -> match bin::decode(bytes, blanked_spans_bin()) {
      Ok(b) -> if !fits(b.bounds, text.len()) { None } else {
        Some(
          range(0, b.bounds.len() / 2).map(|i: Int|
            span_between(b.bounds.at_or(2 * i, 0), b.bounds.at_or(2 * i + 1, 0))),
        )
      },
      Err(_) -> None,
    },
    None -> None,
  };
  let spans = match cached_spans {
    Some(spans) -> spans,
    None -> {
      let spans = unneeded_spans(text);
      let bounds = spans.fold([], |accumulator: List<Int>, s: Span|
        accumulator.push(s.start).push(s.end));
      write_cached_file[abs](dir, key, bin::encode({ bounds: bounds }, blanked_spans_bin()));
      spans
    },
  };
  blanked(text, spans)
}

type BlankedSpans = { bounds: List<Int> }

derive bin for BlankedSpans

fn fits(bounds: List<Int>, size: Int) -> Bool =
  bounds.len() % 2 == 0
    && bounds.fold({ ok: true, at: 0 }, |s: { ok: Bool, at: Int }, b: Int|
      { ok: s.ok && s.at <= b && b <= size, at: b }).ok

pub fn shipped_data(
  modules: List<Source>,
) -> List<ShippedData> / {fs.read_file[shipped], abort.raise} =
  modules.fold([], |accumulator: List<ShippedData>, module: Source|
    shipped_data_wanted(module).fold(
      accumulator,
      |collected_data: List<ShippedData>, name: Bytes|
        if collected_data.filter(|d: ShippedData| d.name == name).len() > 0 { collected_data }
        else {
          match fs.read_file[shipped](String::of_bytes_lossy(name)) {
            Some(bytes) -> collected_data.push({ name: name, bytes: bytes }),
            None -> collected_data,
          }
        },
    ))

pub fn all_shipped_names(s: ShippedInputs) -> List<Bytes> =
  s.sources.map(|source: Source| source.name).concat(s.unread)

pub fn shipped_modules() -> List<Source> / {fs.list_dir[shipped], fs.read_file[shipped], abort.raise} =
  match fs::listed_names(fs.list_dir[shipped](".")) {
    None -> [],
    Some(names) ->
      names.fold([], |accumulator: List<Source>, name: String|
        if !is_ply(name) { accumulator } else {
          match fs.read_file[shipped](name) {
            None -> accumulator,
            Some(contents) ->
              accumulator.push({ name: Bytes::of_string(stem(name)), source_text: contents }),
          }
        }),
  }

fn files_listed(names: List<String>) -> List<fs::Listed> =
  names.map(|name: String| { name: name, kind: fs::File })

test "a file path gives a module name from its directories and file name, and a segment that is not an identifier is an error" {
  assert_eq(module_of("m.ply"), Ok("m"));
  assert_eq(module_of("store/orders.ply"), Ok("store.orders"));
  assert_eq(module_of("a/b/c.ply"), Ok("a.b.c"));
  assert_eq(module_of("_kept.ply"), Ok("_kept"));
  assert_eq(module_of("my-file.ply"), Err("`my-file` is not an identifier"));
  assert_eq(module_of("9lives.ply"), Err("`9lives` is not an identifier"));
  assert_eq(module_of("a b/c.ply"), Err("`a b` is not an identifier"));
  assert_eq(module_of("café.ply"), Err("`café` is not an identifier"))
}

fn found_here(names: List<String>) -> WalkResult =
  {
    files: names.fold(Map::new(), |accumulator: Map<String, RootedPath>, path: String|
      accumulator.insert(path, { label: "cwd", path: path })),
    errors: [],
  }

test "a file whose path cannot be a module name is rejected with a diagnostic and is not passed to the compiler as a source" {
  let p = handle {
    read(found_here(["m.ply", "my-file.ply"]), "")
  } with {
    fs.read_file[cwd](path) -> Some(b"fn f() -> Int = 1\n"),
    fs.read_file[abs](path) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(p.sources.len(), 1);
  assert_eq(p.diagnostics.len(), 1);
  assert_eq(match p.diagnostics.at(0) { Some(d) -> d.code, None -> b"" }, b"E0111");
  assert_eq(p.files.map(|file: File| file.path), ["m.ply", "my-file.ply"]);
  assert_eq(
    match p.diagnostics.at(0) { Some(d) -> d.labels.map(|label: Label| label.module), None -> [] },
    [1],
  )
}

test "a project file under a `compiler` directory becomes the module `compiler.fmt` with no diagnostic from the file reader" {
  let p = handle {
    read(found_here(["compiler/fmt.ply"]), "")
  } with {
    fs.read_file[cwd](path) -> Some(b"fn f() -> Int = 1\n"),
    fs.read_file[abs](path) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(p.diagnostics.len(), 0);
  assert_eq(match p.sources.at(0) { Some(s) -> s.name, None -> b"" }, b"compiler.fmt")
}

test "a project file under a `std` directory becomes the module `std.json` with no diagnostic from the file reader" {
  let p = handle {
    read(found_here(["std/json.ply"]), "")
  } with {
    fs.read_file[cwd](path) -> Some(b"fn f() -> Int = 1\n"),
    fs.read_file[abs](path) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(p.diagnostics.len(), 0);
  assert_eq(match p.sources.at(0) { Some(s) -> s.name, None -> b"" }, b"std.json")
}

test "reading standard library files given the prefix `std` names their modules `std.` plus the file path, such as `std.hash.legacy`" {
  let p = handle {
    read(found_here(["json.ply", "hash/legacy.ply"]), "", "std")
  } with {
    fs.read_file[cwd](path) -> Some(b"pub fn f() -> Int = 1\n"),
    fs.read_file[abs](path) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(p.diagnostics.len(), 0);
  assert_eq(p.sources.map(|s: Source| s.name).sort(), [b"std.hash.legacy", b"std.json"]);
  assert_eq(p.files.map(|file: File| file.path).sort(), ["hash/legacy.ply", "json.ply"])
}

test "a file outside the working directory is read from its absolute path, and its module name comes from its path below the given base directory" {
  let found: WalkResult = {
    files: Map::new().insert("/srv/app/store/orders.ply", {
      label: "abs",
      path: "srv/app/store/orders.ply",
    }),
    errors: [],
  };
  let p = handle {
    read(found, "srv/app")
  } with {
    fs.read_file[cwd](path) -> panic("a file found under `abs` is read under `abs`"),
    fs.read_file[abs](path) -> if path == "srv/app/store/orders.ply" {
      Some(b"fn f() -> Int = 1\n")
    } else { None },
  };
  assert_eq(p.diagnostics.len(), 0);
  assert_eq(p.files.map(|file: File| file.path), ["store/orders.ply"]);
  assert_eq(p.files.map(|file: File| file.at), [
    { label: "abs", path: "srv/app/store/orders.ply" },
  ]);
  assert_eq(match p.sources.at(0) { Some(s) -> s.name, None -> b"" }, b"store.orders")
}

test "`with_manifest` reads `ply.pkg` from the directory of the given path's base, even when the path names another file such as `main.ply`" {
  let file: paths::ResolvedPath = {
    label: "abs",
    root_path: "srv/app",
    display: "/srv/app",
    inside: "main.ply",
    absolute: "/srv/app",
    machine: "/srv/app",
    part: "",
  };
  let p = handle {
    with_manifest(file, empty())
  } with {
    fs.read_file[cwd](path) -> panic("a root under `abs` is read under `abs`"),
    fs.read_file[abs](path) -> if path == "srv/app/ply.pkg" { Some(b"manifest") } else { None },
  };
  match p.manifest {
    None -> panic("the manifest beside the file was not read"),
    Some(f) -> {
      assert_eq(f.path, "/srv/app/ply.pkg");
      assert_eq(f.at, { label: "abs", path: "srv/app/ply.pkg" })
    },
  }
}

test "a load reads only the shipped modules the program imports, directly or indirectly, and the data files they embed" {
  let got = handle {
    shipping_for([{ name: b"main", source_text: b"import std.json\nfn main() -> Unit = ()\n" }], {
      root: b"",
      manifest: None,
      supplied: [],
    })
  } with {
    var files: List<String> = [],
    fs.list_dir[shipped](p) ->
      Some(files_listed(["std.json.ply", "std.bytes.ply", "std.list.ply", "compiler.fmt.ply"])),
    fs.read_file[shipped](p) -> {
      files = files.push(p);
      if p == "std.json.ply" { Some(b"import std.bytes\npub fn j() -> Int = bytes::b()\n") }
      else if p == "std.bytes.ply" { Some(b"pub fn b() -> Int = 2\n") }
      else { Some(b"pub fn x() -> Int = 3\n") }
    },
    return shipping -> { shipping: shipping, files: files },
  };
  assert_eq(got.shipping.sources.map(|source: Source| source.name), [b"std.json", b"std.bytes"]);
  assert_eq(got.shipping.unread, [b"std.list", b"compiler.fmt"]);
  assert_eq(got.files, ["std.json.ply", "std.bytes.ply"])
}

fn sample_module_source() -> Bytes =
  b"//! Counting.\n\nimport std.laws (agrees)\n\n/// One more.\npub fn more(x: Int) -> Int = bump(x)\n\nfn bump(x: Int) -> Int = x + 1\n\n/// Only the tests ask.\nfn twice(x: Int) -> Int = x * 2\n\ntest \"more adds one\" {\n  assert_eq(more(twice(1)), 3)\n}\n\nlaw \"more is bump\" = agrees(more, bump)\n"

fn counted_load() -> { read: List<Bytes>, text: Bytes, files: List<String> } / {abort.raise} =
  handle {
    shipping_for([{ name: b"main", source_text: b"import std.count\nfn main() -> Unit = ()\n" }], {
      root: b"",
      manifest: None,
      supplied: [],
    })
  } with {
    var files: List<String> = [],
    fs.list_dir[shipped](p) -> Some(files_listed(["std.count.ply", "std.laws.ply"])),
    fs.read_file[shipped](p) -> {
      files = files.push(p);
      if p == "std.count.ply" { Some(sample_module_source()) }
      else { Some(b"pub fn agrees<a>(f: (Int) -> a, g: (Int) -> a) -> Bool = true\n") }
    },
    return shipping ->
      {
        read: shipping.sources.map(|source: Source| source.name),
        text: shipping.sources.fold(b"", |accumulator: Bytes, source: Source|
          if source.name == b"std.count" { source.source_text } else { accumulator }),
        files: files,
      },
  }

fn cached_count(store: MemFs) -> { text: Bytes, toolchain: MemFs } / {abort.raise} = {
  let over = on_mem[cwd](mem_empty(), ||
    on_mem[abs](store, ||
      handle {
        shipping_cached([b"std.count"], Map::new())
      } with {
        toolchain.reuse_dir() -> "/reused",
        fs.list_dir[shipped](p) -> Some(files_listed(["std.count.ply"])),
        fs.read_file[shipped](p) -> if p == "std.count.ply" { Some(sample_module_source()) }
        else if p == "definitions" {
          Some(b"compiler.front.pulls_of aa\ncompiler.front.interface.imported bb\n")
        } else { None },
        entropy.next() -> 7,
        time.now_ms() -> 0,
      })).value;
  {
    text: over.value.sources.fold(b"", |accumulator: Bytes, source: Source|
      if source.name == b"std.count" { source.source_text } else { accumulator }),
    toolchain: over.tree,
  }
}

test "the cached source of a shipped module is reused by every project, and a cache entry with invalid contents is ignored" {
  let viewed = imported(sample_module_source());
  let cold = cached_count(mem_empty());
  assert_eq(cold.text, viewed);
  let cached_names = match fs::listed_names(mem_list(cold.toolchain, "reused")) {
    Some(names) -> names,
    None -> [],
  };
  assert_eq(cached_names.len(), 1);
  let entry = "reused/" ++ cached_names.at_or(0, "");
  let planted = mem_write(
    cold.toolchain,
    entry,
    bin::encode({ bounds: [] }, blanked_spans_bin()),
  ).fs;
  assert_eq(cached_count(planted).text, sample_module_source());
  let spoiled = mem_write(
    cold.toolchain,
    entry,
    bin::encode({ bounds: [5, 2] }, blanked_spans_bin()),
  ).fs;
  assert_eq(cached_count(spoiled).text, viewed)
}

test "loading a project does not read a shipped module's tests or laws, or code that only the tests and laws use" {
  let load = counted_load();
  assert_eq(load.read, [b"std.count"]);
  assert_eq(load.files, ["std.count.ply"]);
  assert_eq(load.text.len(), sample_module_source().len());
  let says = |word: Bytes| load.text.index_of(word) != None;
  assert(says(b"/// One more.\npub fn more(x: Int) -> Int = bump(x)"));
  assert(says(b"fn bump(x: Int) -> Int = x + 1"));
  assert(!says(b"std.laws") && !says(b"twice") && !says(b"test") && !says(b"law"));
  let parsed = parse(load.text);
  assert_eq(parsed.parser.diagnostics.len(), 0);
  assert_eq(parsed.node.items.len(), 2)
}

fn embedding_words() -> Bytes = b"pub fn list() -> Bytes = embed(\"words/list.txt\")\n"

test "a load reads the data file embedded by an imported shipped module and names it by its path under `std`" {
  let got = handle {
    shipping_for([{ name: b"main", source_text: b"import std.words\nfn main() -> Unit = ()\n" }], {
      root: b"",
      manifest: None,
      supplied: [],
    })
  } with {
    var files: List<String> = [],
    fs.list_dir[shipped](p) ->
      Some(
        [{ name: "std", kind: fs::Dir }].concat(files_listed(["std.idle.ply", "std.words.ply"])),
      ),
    fs.read_file[shipped](p) -> {
      files = files.push(p);
      if p == "std.words.ply" { Some(embedding_words()) }
      else if p == "std/words/list.txt" { Some(b"one\n") }
      else { None }
    },
    return shipping -> { shipping: shipping, files: files },
  };
  assert_eq(got.shipping.data, [{ name: b"std/words/list.txt", bytes: b"one\n" }]);
  assert_eq(got.shipping.unread, [b"std.idle"]);
  assert_eq(got.files, ["std.words.ply", "std/words/list.txt"])
}

test "the digest of the shipped modules covers the data files they embed" {
  let sources = [{ name: b"std.words", source_text: embedding_words() }];
  let over = |bytes: Bytes|
    shipped_digest_of(sources, [{ name: b"std/words/list.txt", bytes: bytes }]);
  assert_eq(over(b"one\n"), over(b"one\n"));
  assert(over(b"one\n") != over(b"two\n"));
  assert(over(b"one\n") != shipped_digest_of(sources, []));
  let collected_data = handle {
    shipped_data(sources.concat(sources))
  } with {
    fs.read_file[shipped](p) -> if p == "std/words/list.txt" { Some(b"one\n") } else { None },
  };
  assert_eq(collected_data, [{ name: b"std/words/list.txt", bytes: b"one\n" }])
}

test "`shipped_modules` returns one source per `.ply` file, named from the file name without its extension" {
  let out = handle {
    shipped_modules()
  } with {
    builder.git[vcs](root, key) -> None,
    fs.list_dir[shipped](p) ->
      Some(files_listed(["std.json.ply", "README.md", "compiler.fmt.ply"])),
    fs.read_file[shipped](p) -> Some(Bytes::of_string(p)),
  };
  assert_eq(out.map(|source: Source| source.name), [b"std.json", b"compiler.fmt"])
}
