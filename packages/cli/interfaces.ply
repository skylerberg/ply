import std.bin
import std.fs (fs)
import compiler.store.memo (memo)
import compiler.front.checking.interfaces (published_module)
import compiler.front.interface (Interface, ModuleInterface, interface_bin, envelope_of)
import compiler.front.pkg (registry_dir)
import compiler.check.resolve.tables (Diagnostic, error_at)
import semantics
import sources
import compiler.syntax.parsing (no_module, dummy_span)
import std.path (strip_root)

pub fn slot_interface(slot: String) -> String = slot ++ "/.interface/" ++ semantics::version

pub fn slot_attestation(slot: String) -> String = slot ++ "/.attestation/" ++ semantics::version

pub fn slots(root_key: String, roots: List<String>) -> List<String> / {abort.raise} = {
  let dir = String::of_bytes_lossy(registry_dir(Bytes::of_string(root_key))) ++ "/";
  roots.filter(|r: String| r.starts_with(dir))
}

fn read_slot_interface(slot: String) -> Option<Bytes> / {fs.read_file[abs], abort.raise} =
  fs.read_file[abs](strip_root(slot_interface(slot)))

fn rederive_mismatch(slot: String, what: String) -> Diagnostic =
  error_at(
    b"E0149",
    no_module,
    dummy_span,
    Bytes::of_string(
      "the interface published for `" ++ last_segment(slot)
        ++ "` does not re-derive from its source: "
        ++ what
        ++ " differs",
    ),
    b"the published interface does not match the package's source",
    [
      b"the registry that served the package, or the slot `ply resolve` stored it in, contains an interface that differs from the one computed from the package source",
      b"the check read every dependency from source, so the result does not depend on the published interface",
    ],
  )

fn last_segment(path: String) -> String =
  match path.split("/").at(path.split("/").len() - 1) { Some(s) -> s, None -> path }

fn first_some<a>(xs: List<a>, f: (a) -> Option<String>) -> Option<String> =
  xs.fold(None, |found: Option<String>, x: a| match found { Some(_) -> found, None -> f(x) })

fn interface_difference(published: Interface, own: Interface) -> Option<String> = {
  let modules = own.modules.fold(
    Map::new(),
    |accumulator: Map<Bytes, ModuleInterface>, m: ModuleInterface|
      accumulator.insert(m.exports.module, m),
  );
  first_some(published.modules, |m: ModuleInterface| {
    let named = "`" ++ String::of_bytes_lossy(m.exports.module) ++ "`";
    match modules.get(m.exports.module) {
      None -> Some(named),
      Some(o) -> if o.exports != m.exports { Some(named ++ "'s exports") }
      else if o.hashes != m.hashes { Some(named ++ "'s hashes") }
      else { None },
    }
  })
}

fn decode_interface(bytes: Bytes) -> Option<Interface> / {abort.raise} =
  match envelope_of(bytes) {
    None -> None,
    Some(e) -> if e.semantics != Bytes::of_string(semantics::version) { None }
    else { match bin::decode(e.payload, interface_bin()) { Err(_) -> None, Ok(p) -> Some(p) } },
  }

pub type SlotInterface = { slot: String, interface: Interface }

pub fn published_interfaces(
  slots: List<String>,
) -> List<SlotInterface> / {fs.read_file[abs], abort.raise} =
  slots.fold([], |found: List<SlotInterface>, slot: String|
    match read_slot_interface(slot) {
      None -> found,
      Some(bytes) -> match decode_interface(bytes) {
        None -> found,
        Some(p) -> found.push({ slot: slot, interface: p }),
      },
    })

pub fn rederive_mismatches(
  published: List<SlotInterface>,
  own: List<Bytes>,
) -> List<Diagnostic> / {memo.read, abort.raise} =
  published.fold([], |accumulator: List<Diagnostic>, p: SlotInterface| {
    let derived = p.interface.modules.fold(
      [],
      |found: List<ModuleInterface>, m: ModuleInterface|
        if !own.contains(m.exports.module) { found } else {
          match published_module({ module: m.exports.module, shipped: false, tested: false }) {
            Some(x) -> found.push(x.interface),
            None -> found,
          }
        },
    );
    match interface_difference(p.interface, { modules: derived }) {
      None -> accumulator,
      Some(what) -> accumulator.push(rederive_mismatch(p.slot, what)),
    }
  })
