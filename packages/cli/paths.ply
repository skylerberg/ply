import std.cli
import std.env (env)
import library
import std.fs (fs, Kind, File, Dir, Symlink, Missing, MemFs, WriteResult, mem_create_dir, mem_empty,
               mem_kind, mem_of, mem_read, mem_resolved_kind, mem_symlink, mem_write)
import std.path (strip_root, file_name, is_absolute, join, normalize, parent, strip_dot)
import std.list

pub type ResolvedPath = {
  label: String,
  root_path: String,
  display: String,
  inside: String,
  absolute: String,
  machine: String,
  part: String,
}

pub fn strip_prefix(path: String, prefix: String) -> Option<String> / {abort.raise} =
  if path == prefix { Some("") }
  else if path.starts_with(prefix ++ "/") { Some(path.slice(prefix.len() + 1, path.len())) }
  else { None }

fn kind_of(
  label: String,
  spelling: String,
) -> String / {fs.resolved_kind[cwd], fs.resolved_kind[abs]} = {
  let kind = if label == "cwd" { fs.resolved_kind[cwd](spelling) }
  else { fs.resolved_kind[abs](spelling) };
  match kind { File -> "file", Dir -> "dir", Symlink -> "symlink", Missing -> "missing" }
}

fn nearest_dir(
  label: String,
  spelling: String,
) -> String / {fs.resolved_kind[cwd], fs.resolved_kind[abs], abort.raise} =
  iterate(spelling, spelling.len() + 2, |at: String|
    if kind_of(label, at) == "dir" || at == "." || at == "" || parent(at) == at { Stop(at) }
    else { Continue(parent(at)) })

fn display_of(pwd: String, full: String) -> String / {abort.raise} =
  match strip_prefix(full, pwd) { Some(rest) -> if rest == "" { "." } else { rest }, None -> full }

fn absolute_of(pwd: String, label: String, spelling: String) -> String =
  normalize(if label == "cwd" { join(pwd, spelling) } else { "/" ++ spelling })

pub fn absolute(pwd: String, p: RootedPath) -> String = absolute_of(pwd, p.label, p.path)

fn addressed(pwd: String, full: String) -> (String, String) / {abort.raise} =
  match strip_prefix(full, pwd) {
    Some(rest) -> ("cwd", if rest == "" { "." } else { rest }),
    None -> ("abs", strip_root(full)),
  }

fn root_at(
  pwd: String,
  dir: String,
  inside: String,
  part: String = "",
) -> ResolvedPath / {abort.raise} = {
  let (label, spelling) = addressed(pwd, dir);
  {
    label: label,
    root_path: spelling,
    display: display_of(pwd, dir),
    inside: inside,
    absolute: dir,
    machine: if label == "cwd" { spelling } else { dir },
    part: part,
  }
}

pub fn resolve(
  arg: String,
) -> ResolvedPath / {fs.resolved_kind[cwd], fs.resolved_kind[abs], env.working_directory, abort.raise} = {
  let pwd = env.working_directory();
  let full = normalize(if is_absolute(strip_dot(arg)) { arg } else { join(pwd, strip_dot(arg)) });
  let (label, spelling) = addressed(pwd, full);
  match kind_of(label, spelling) {
    "dir" -> root_at(pwd, full, "."),
    "file" -> root_at(pwd, parent(full), file_name(full)),
    _ -> {
      let dir = nearest_dir(label, spelling);
      root_at(pwd, absolute_of(pwd, label, dir), match strip_prefix(spelling, dir) {
        Some(rest) -> rest,
        None -> spelling,
      })
    },
  }
}

pub fn package_of(dir: String) -> Option<String> / {fs.resolved_kind[abs], abort.raise} =
  iterate(normalize(dir), dir.len() + 2, |at: String|
    if !is_absolute(at) { Stop(None) }
    else if fs.resolved_kind[abs](strip_root(join(at, "ply.pkg"))) == File { Stop(Some(at)) }
    else if at == "/" { Stop(None) }
    else { Continue(parent(at)) })

fn enclosing(
  dir: String,
) -> Option<{ dir: String, part: String }> / {fs.resolved_kind[abs], fs.read_file[abs], abort.raise} = {
  let package = match package_of(dir) { Some(root) -> Some({ dir: root, part: "" }), None -> None };
  match library::part_of(dir) {
    None -> package,
    Some(p) -> match package {
      Some(k) -> if k.dir.len() >= p.dir.len() { package }
      else { Some({ dir: p.dir, part: p.prefix }) },
      None -> Some({ dir: p.dir, part: p.prefix }),
    },
  }
}

pub fn in_package(
  resolved: ResolvedPath,
) -> ResolvedPath / {fs.resolved_kind[abs], fs.read_file[abs], env.working_directory, abort.raise} =
  if resolved.inside != "." && !resolved.inside.ends_with(".ply") { resolved } else {
    match enclosing(resolved.absolute) {
      None -> resolved,
      Some(e) -> match strip_prefix(resolved.absolute, if e.dir == "/" { "" } else { e.dir }) {
        None -> resolved,
        Some(below) ->
          root_at(
            env.working_directory(),
            e.dir,
            if below == "" { resolved.inside }
            else if resolved.inside == "." { below }
            else { join(below, resolved.inside) },
            e.part,
          ),
      },
    }
  }

fn address(resolved: ResolvedPath) -> String =
  if resolved.inside == "." { resolved.root_path }
  else { join(resolved.root_path, resolved.inside) }

pub fn includes(resolved: ResolvedPath, path: String) -> Bool =
  resolved.inside == "." || path == resolved.inside || path.starts_with(resolved.inside ++ "/")

pub fn includes_any(resolved: List<ResolvedPath>, path: String) -> Bool =
  resolved.len() == 0 || resolved.fold(false, |hit: Bool, r: ResolvedPath| hit || includes(r, path))

pub fn display_path(resolved: ResolvedPath) -> String = displayed(rooted(resolved))

pub type RootedPath = { label: String, path: String }

pub fn rooted(resolved: ResolvedPath) -> RootedPath =
  { label: resolved.label, path: address(resolved) }

pub fn rooted_path(path: String) -> RootedPath / {abort.raise} =
  if is_absolute(path) {
    let full = normalize(path);
    { label: "abs", path: full.slice(1, full.len()) }
  } else { { label: "cwd", path: normalize(path) } }

pub fn parent_of(p: RootedPath) -> Option<RootedPath> = {
  let dir = parent(p.path);
  if dir == "" || dir == "." || dir == "/" { None } else { Some({ label: p.label, path: dir }) }
}

pub fn in_root(resolved: ResolvedPath, name: String) -> RootedPath =
  child({ label: resolved.label, path: resolved.root_path }, name)

pub fn child(dir: RootedPath, name: String) -> RootedPath =
  { label: dir.label, path: join(dir.path, name) }

pub fn displayed(p: RootedPath) -> String = if p.label == "cwd" { p.path } else { "/" ++ p.path }

pub fn read_file(p: RootedPath) -> Option<Bytes> / {fs.read_file[cwd], fs.read_file[abs]} =
  if p.label == "cwd" { fs.read_file[cwd](p.path) } else { fs.read_file[abs](p.path) }

pub fn write_file(p: RootedPath, body: Bytes) -> Bool / {fs.write_file[cwd], fs.write_file[abs]} =
  if p.label == "cwd" { fs.write_file[cwd](p.path, body) } else { fs.write_file[abs](p.path, body) }

pub fn read_secret(
  p: RootedPath,
  before: Bytes,
  encoding: String,
  after: Bytes,
) -> Option<Secret<Bytes>> / {fs.read_secret[cwd], fs.read_secret[abs]} =
  if p.label == "cwd" { fs.read_secret[cwd](p.path, before, encoding, after) }
  else { fs.read_secret[abs](p.path, before, encoding, after) }

pub fn write_secret(
  p: RootedPath,
  before: Bytes,
  secret: Secret<Bytes>,
  encoding: String,
  after: Bytes,
) -> Bool / {fs.write_secret[cwd], fs.write_secret[abs]} =
  if p.label == "cwd" { fs.write_secret[cwd](p.path, before, secret, encoding, after) }
  else { fs.write_secret[abs](p.path, before, secret, encoding, after) }

pub fn kind(p: RootedPath) -> Kind / {fs.kind[cwd], fs.kind[abs]} =
  if p.label == "cwd" { fs.kind[cwd](p.path) } else { fs.kind[abs](p.path) }

pub fn modified_ms(p: RootedPath) -> Option<Int> / {fs.modified_ms[cwd], fs.modified_ms[abs]} =
  if p.label == "cwd" { fs.modified_ms[cwd](p.path) } else { fs.modified_ms[abs](p.path) }

pub fn file_size(p: RootedPath) -> Option<Int> / {fs.file_size[cwd], fs.file_size[abs]} =
  if p.label == "cwd" { fs.file_size[cwd](p.path) } else { fs.file_size[abs](p.path) }

pub fn create_dir(p: RootedPath) -> Bool / {fs.create_dir[cwd], fs.create_dir[abs]} =
  if p.label == "cwd" { fs.create_dir[cwd](p.path) } else { fs.create_dir[abs](p.path) }

pub fn move_file(from: RootedPath, to: RootedPath) -> Bool / {fs.rename[cwd], fs.rename[abs]} =
  if from.label == "cwd" { fs.rename[cwd](from.path, to.path) }
  else { fs.rename[abs](from.path, to.path) }

pub fn root_prefix(resolved: ResolvedPath) -> String =
  if resolved.root_path == "." { "" } else { resolved.root_path }

fn path_arguments(command: String, parsed: cli::Parsed) -> List<String> =
  if command == "doc" || command == "show" || command == "callers" || command == "replace"
      || command == "why" { drop_first(parsed.positionals) }
  else if command == "cache" && parsed.path.at_or(1, "") == "inspect" {
    drop_first(parsed.positionals)
  } else if takes_no_paths(command) { [] }
  else { parsed.positionals }

pub fn needs_enclosing_checkout(command: String) -> Bool =
  !takes_no_paths(command) && command != "new" && command != "work" && command != "fmt"

fn takes_no_paths(command: String) -> Bool =
  command == "explain" || command == "std" || command == "yank" || command == "contracts"
    || command == "keygen"
    || command == "attest"

pub fn resolve_all(
  command: String,
  parsed: cli::Parsed,
) -> Result<List<ResolvedPath>, String> / {fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.read_file[abs], env.working_directory, abort.raise} = {
  let named = path_arguments(command, parsed);
  if takes_no_paths(command) { Ok([resolve(".")]) }
  else if command == "new" || command == "work" || (command == "fmt" && named.len() > 0) {
    Ok(named.map(|path: String| resolve(path)))
  } else if named.len() > 0 { Ok(named.map(|path: String| in_package(resolve(path)))) } else {
    let pwd = env.working_directory();
    match enclosing(pwd) { Some(e) -> Ok([root_at(pwd, e.dir, ".", e.part)]), None -> Err(pwd) }
  }
}

fn drop_first(xs: List<String>) -> List<String> = match xs { [] -> [], [_, ..rest] -> rest }

pub fn here() -> ResolvedPath =
  { label: "cwd", root_path: ".", display: ".", inside: ".", absolute: ".", machine: ".", part: "" }

pub fn at_cwd(spelling: String) -> ResolvedPath =
  {
    label: "cwd",
    root_path: spelling,
    display: spelling,
    inside: ".",
    absolute: spelling,
    machine: spelling,
    part: "",
  }

pub fn at_abs(spelling: String) -> ResolvedPath =
  {
    label: "abs",
    root_path: spelling,
    display: "/" ++ spelling,
    inside: ".",
    absolute: "/" ++ spelling,
    machine: "/" ++ spelling,
    part: "",
  }

fn kind_at_root(path: String) -> Kind / {fs.kind[abs], abort.raise} =
  fs.kind[abs](path.slice(1, path.len()))

pub fn checkout_of(dir: String) -> Option<String> / {fs.kind[abs], abort.raise} =
  iterate(normalize(dir), dir.len() + 2, |at: String|
    if !is_absolute(at) || at == "/" { Stop(None) }
    else if kind_at_root(join(at, ".git")) != Missing { Stop(Some(at)) }
    else { Continue(parent(at)) })

pub fn in_checkout(tree: String, dir: String) -> Bool / {fs.kind[abs], abort.raise} =
  iterate(normalize(dir), dir.len() + 2, |at: String|
    if at == tree { Stop(true) }
    else if !at.starts_with(tree ++ "/") { Stop(false) }
    else if kind_at_root(at) != Dir || kind_at_root(join(at, ".git")) != Missing { Stop(false) }
    else { Continue(parent(at)) })

test "`displayed` prints a path under the working directory as written, and a path outside it as an absolute path" {
  assert_eq(displayed({ label: "cwd", path: "sub/m.ply" }), "sub/m.ply");
  assert_eq(displayed({ label: "abs", path: "srv/app/m.ply" }), "/srv/app/m.ply");
  assert_eq(displayed({ label: "abs", path: "" }), "/")
}

test "a path labelled `abs` or `cwd` is read and written only through the filesystem handler with that label" {
  let read = handle {
    read_file({ label: "abs", path: "srv/m.ply" })
  } with {
    fs.read_file[cwd](p) -> panic("a path under `abs` is read under `abs`"),
    fs.read_file[abs](p) -> if p == "srv/m.ply" { Some(b"text") } else { None },
  };
  assert_eq(read, Some(b"text"));
  let wrote = handle {
    write_file({ label: "cwd", path: "m.ply" }, b"text")
  } with {
    fs.write_file[cwd](p, body) -> p == "m.ply" && body == b"text",
    fs.write_file[abs](p, body) -> panic("a path under `cwd` is written under `cwd`"),
  };
  assert(wrote)
}

test "`kind` checks a path only in the filesystem handler with the path's own label, so the same path under `cwd` and `abs` can differ" {
  let here = mem_of([{ path: "app/m.ply", body: b"fn m() -> Int = 1" }]);
  let root = mem_of([{ path: "srv/app/m.ply", body: b"fn m() -> Int = 2" }]);
  let kinds = handle {
    [
      kind({ label: "cwd", path: "app" }),
      kind({ label: "cwd", path: "app/m.ply" }),
      kind({ label: "abs", path: "app" }),
      kind({ label: "abs", path: "srv/app/m.ply" }),
    ]
  } with {
    fs.kind[cwd](p) -> mem_kind(here, p),
    fs.kind[abs](p) -> mem_kind(root, p),
  };
  assert_eq(kinds, [Dir, File, Missing, File])
}

test "creating a directory and then writing a file in it both go through the handler with the directory's label" {
  let made: RootedPath = { label: "abs", path: "srv/demo" };
  let wrote = handle {
    create_dir(made) && write_file(child(made, "ply.pkg"), b"pkg")
  } with {
    var a = mem_empty(),
    fs.create_dir[cwd](p) ->
      panic(
        "this test allows only absolute paths, but `ply new` created a directory at a path relative to the working directory",
      ),
    fs.create_dir[abs](p) -> {
      let w: WriteResult = mem_create_dir(a, p);
      a = w.fs;
      w.ok
    },
    fs.write_file[cwd](p, body) ->
      panic(
        "this test allows only absolute paths, but `ply new` wrote a file at a path relative to the working directory",
      ),
    fs.write_file[abs](p, body) -> {
      let w: WriteResult = mem_write(a, p, body);
      a = w.fs;
      w.ok
    },
    return ok -> { ok: ok, tree: a },
  };
  assert(wrote.ok);
  assert_eq(mem_kind(wrote.tree, "srv/demo"), Dir);
  assert_eq(mem_read(wrote.tree, "srv/demo/ply.pkg"), Some(b"pkg"))
}

test "`child` keeps its parent's label, and a parent path of `.` in the working directory gives the child path just the file name" {
  assert_eq(child({ label: "cwd", path: "." }, "m.ply"), { label: "cwd", path: "m.ply" });
  assert_eq(child({ label: "cwd", path: "app" }, "m.ply"), { label: "cwd", path: "app/m.ply" });
  assert_eq(child({ label: "abs", path: "" }, "m.ply"), { label: "abs", path: "m.ply" });
  assert_eq(displayed(child({ label: "abs", path: "srv/app" }, "m.ply")), "/srv/app/m.ply")
}

fn resolved_at(disk: MemFs, pwd: String, arg: String) -> ResolvedPath / {abort.raise} =
  handle {
    resolve(arg)
  } with {
    env.working_directory() -> pwd,
    fs.resolved_kind[cwd](p) -> mem_resolved_kind(disk, join(pwd.slice(1, pwd.len()), p)),
    fs.resolved_kind[abs](p) -> mem_resolved_kind(disk, p),
  }

fn a_disk() -> MemFs / {abort.raise} =
  mem_of([
    { path: "w/m.ply", body: b"fn m() -> Int = 1" },
    { path: "w/app/main.ply", body: b"fn main() -> Int = 1" },
    { path: "srv/lib/x.ply", body: b"pub fn x() -> Int = 1" },
  ])

test "`in_root` finds a file such as `ply.lock` in the directory of the given file or directory, with the same label, inside or outside the working directory" {
  let file = resolved_at(a_disk(), "/w", "app/main.ply");
  assert_eq(rooted(file), { label: "cwd", path: "app/main.ply" });
  assert_eq(in_root(file, "ply.lock"), { label: "cwd", path: "app/ply.lock" });
  assert_eq(file.absolute, "/w/app");
  let dir = resolved_at(a_disk(), "/w", "app");
  assert_eq(in_root(dir, "ply.lock"), in_root(file, "ply.lock"));
  assert_eq(dir.absolute, file.absolute);
  assert_eq(in_root(resolved_at(a_disk(), "/w", "m.ply"), "ply.pkg"), {
    label: "cwd",
    path: "ply.pkg",
  });
  let outside = resolved_at(a_disk(), "/w", "../srv/lib/x.ply");
  assert_eq(in_root(outside, "ply.lock"), { label: "abs", path: "srv/lib/ply.lock" });
  assert_eq(displayed(in_root(outside, "ply.lock")), "/srv/lib/ply.lock");
  assert_eq(outside.absolute, "/srv/lib")
}

pub fn checkouts() -> MemFs / {abort.raise} =
  mem_symlink(
    mem_of([
      { path: "repo/.git/HEAD", body: b"ref: refs/heads/main\n" },
      { path: "repo/app/ply.pkg", body: b"" },
      { path: "repo/app/.ply-cache/registry/r/ply.pkg", body: b"" },
      { path: "repo/libs/a/ply.pkg", body: b"" },
      { path: "repo/nested/.git/HEAD", body: b"ref: refs/heads/main\n" },
      { path: "repo/nested/b/ply.pkg", body: b"" },
      { path: "repo/sub/.git", body: b"gitdir: ../.git/modules/sub\n" },
      { path: "repo/sub/c/ply.pkg", body: b"" },
      { path: "repo-b/d/ply.pkg", body: b"" },
      { path: "other/e/ply.pkg", body: b"" },
      { path: "wt/.git", body: b"gitdir: /repo/.git/worktrees/wt\n" },
      { path: "wt/lib/ply.pkg", body: b"" },
    ]),
    "repo/link",
    "../other/e",
  ).fs

test "`checkout_of` returns the nearest parent directory that contains a `.git` directory or a worktree's `.git` file" {
  let found = |dir: String|
    handle { checkout_of(dir) } with { fs.kind[abs](p) -> mem_kind(checkouts(), p) };
  assert_eq(found("/repo/app"), Some("/repo"));
  assert_eq(found("/repo"), Some("/repo"));
  assert_eq(found("/repo/nested/b"), Some("/repo/nested"));
  assert_eq(found("/repo/sub/c"), Some("/repo/sub"));
  assert_eq(found("/wt/lib"), Some("/wt"));
  assert_eq(found("/other/e"), None);
  assert_eq(found("repo/app"), None)
}

test "`in_checkout` is true for a directory inside a checkout, and false for one reached through a symbolic link or inside a nested checkout" {
  let part = |tree: String, dir: String|
    handle { in_checkout(tree, dir) } with { fs.kind[abs](p) -> mem_kind(checkouts(), p) };
  assert(part("/repo", "/repo/libs/a"));
  assert(part("/repo", "/repo/libs/a/../../app"));
  assert(part("/repo", "/repo"));
  assert(part("/wt", "/wt/lib"));
  assert(!part("/repo", "/repo-b/d"));
  assert(!part("/repo", "/other/e"));
  assert(!part("/repo", "/repo/nested/b"));
  assert(!part("/repo", "/repo/sub/c"));
  assert(!part("/repo", "/repo/link"));
  assert(!part("/repo", "/repo/gone"))
}

test "a path that does not exist yet gets the label and directory of its nearest existing parent directory" {
  let gate = resolved_at(a_disk(), "/w/app", "../gate");
  assert_eq(rooted(gate), { label: "abs", path: "w/gate" });
  assert_eq(displayed(rooted(gate)), "/w/gate");
  assert_eq(gate.absolute, "/w");
  assert_eq(gate.display, "/w");
  let made = resolved_at(a_disk(), "/w", "store/orders");
  assert_eq(rooted(made), { label: "cwd", path: "store/orders" });
  assert_eq(made.absolute, "/w")
}

fn packages() -> MemFs / {abort.raise} =
  mem_of([
    { path: "repo/app/ply.pkg", body: b"" },
    { path: "repo/app/main.ply", body: b"fn main() -> Int = 1" },
    { path: "repo/app/store/orders.ply", body: b"pub fn total() -> Int = 1" },
    { path: "repo/app/tools/ply.pkg", body: b"" },
    { path: "repo/app/tools/gen.ply", body: b"fn main() -> Int = 2" },
    { path: "loose/a.ply", body: b"fn a() -> Int = 1" },
    { path: "repo/ply.work", body: workspace() },
    { path: "repo/lib/std/json.ply", body: b"pub fn parse() -> Int = 1" },
    { path: "repo/lib/std/hash/legacy.ply", body: b"pub fn md5() -> Int = 1" },
    { path: "repo/lib/compiler/emit/roots.ply", body: b"pub fn r() -> Int = 1" },
  ])

fn workspace() -> Bytes =
  b"import std.pkg (Workspace)\n\nfn workspace() -> Workspace = {\n  packages: [],\n  suites: [],\n  fixtures: [],\n  toolchain: Some({\n    std: \"lib/std\",\n    std_tests: \"tests/std\",\n    compiler: \"lib/compiler\",\n    cli: \"app\",\n    entry: \"main.main\",\n    cli_tests: \"tests/cli\",\n    runtime: \"ply-runtime\",\n  }),\n}\n"

fn resolve_all_at(
  pwd: String,
  command: String,
  positionals: List<String>,
) -> List<String> / {abort.raise} = {
  let disk = packages();
  let resolved_paths = handle {
    resolve_all(command, { path: [command], flags: [], positionals: positionals, argv: [] })
  } with {
    env.working_directory() -> pwd,
    fs.resolved_kind[cwd](p) -> mem_resolved_kind(disk, normalize(join(strip_root(pwd), p))),
    fs.resolved_kind[abs](p) -> mem_resolved_kind(disk, p),
    fs.read_file[abs](p) -> mem_read(disk, p),
  };
  match resolved_paths {
    Err(nowhere) -> ["no package contains " ++ nowhere],
    Ok(rs) ->
      rs.map(|r: ResolvedPath|
        r.machine ++ " " ++ r.inside ++ (if r.part == "" { "" } else { " " ++ r.part })),
  }
}

test "a path argument is resolved to the package that contains it, or used as written when no package contains it" {
  assert_eq(resolve_all_at("/repo/app/store", "check", ["orders.ply"]), [
    "/repo/app store/orders.ply",
  ]);
  assert_eq(resolve_all_at("/repo/app", "test", ["store"]), [". store"]);
  assert_eq(resolve_all_at("/repo", "run", ["app/main.ply"]), ["app main.ply"]);
  assert_eq(resolve_all_at("/repo/app", "run", ["tools/gen.ply"]), ["tools gen.ply"]);
  assert_eq(resolve_all_at("/repo", "check", ["../loose/a.ply"]), ["/loose a.ply"]);
  assert_eq(resolve_all_at("/loose", "check", ["."]), [". ."])
}

test "a command without a path argument uses the package containing the working directory, or reports that no package contains it" {
  assert_eq(resolve_all_at("/repo/app/store", "check", []), ["/repo/app ."]);
  assert_eq(resolve_all_at("/repo/app", "doc", ["total"]), [". ."]);
  assert_eq(resolve_all_at("/repo/app/tools", "fmt", []), [". ."]);
  assert_eq(resolve_all_at("/loose", "check", []), ["no package contains /loose"]);
  assert_eq(resolve_all_at("/loose", "doc", ["std.list"]), ["no package contains /loose"]);
  assert_eq(resolve_all_at("/repo/app", "fmt", ["store"]), ["store ."]);
  assert_eq(resolve_all_at("/loose", "explain", ["E0302"]), [". ."])
}

test "a path inside a library part of the toolchain (such as `std`) resolves to that part, with module names relative to it" {
  assert_eq(resolve_all_at("/repo", "check", ["lib/std"]), ["lib/std . std"]);
  assert_eq(resolve_all_at("/repo", "test", ["lib/std/hash/legacy.ply"]), [
    "lib/std hash/legacy.ply std",
  ]);
  assert_eq(resolve_all_at("/repo/lib/compiler/emit", "check", []), [
    "/repo/lib/compiler . compiler",
  ]);
  assert_eq(resolve_all_at("/repo/lib/std/hash", "check", ["."]), ["/repo/lib/std hash std"]);
  assert_eq(resolve_all_at("/repo/lib", "check", []), ["no package contains /repo/lib"]);
  assert_eq(resolve_all_at("/repo", "fmt", ["lib/std"]), ["lib/std ."])
}
