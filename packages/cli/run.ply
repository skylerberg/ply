// --- Small things -----------------------------------------------------------

/// `main` raised, which is the one failure a run of a checked program can have.
fn failed() -> Int = 1

/// The drain deadline expired with requests still in flight.
fn drain_incomplete() -> Int = 3

/// `m.main` is declared by `m`: a definition's name is its module's and its own.
fn module_of(name: String) -> String = {
  let parts = name.split(".");
  String::join(range(0, parts.len() - 1).map(|i: Int| parts.at_or(i, "")), ".")
}

/// An artifact's spans point into text printed at build time, which no reader wrote, so it places
/// nothing.
fn places_of(target: Target) -> List<Place> =
  match target { Project(p) -> p.places, Deployed(_) -> [] }

// --- Which entry runs -------------------------------------------------------

/// An artifact was closed over its entry point at build time; there is nothing left to choose.
fn entry_of(target: Target) -> Result<String, Diag> / {abort.raise} =
  match target {
    Project(p) -> match entry_point(p.mains, p.modules) { Ok(m) -> Ok(m.name), Err(d) -> Err(d) },
    Deployed(a) -> Ok(a.entry),
  }

// --- What is disclosed before the entry runs ---------------------------------

/// The one line that says what this run may reach, and each facility's own under it.
fn binding_lines(style: Style, bound: Bound, c: Configuration) -> List<String> / {abort.raise} =
  if bound.operations == 0 { [] } else {
    let head = [
      indent()
        ++ dim(
          style,
          "binding host · " ++ count_of(bound.operations, "operation") ++ " · " ++ bound.digest,
        ),
    ];
    let configured = if configuration::opened(c) {
      head.push(indent() ++ dim(style, "config      " ++ configuration::banner(c)))
    } else { head };
    match bound.trace {
      Some(banner) -> configured.push(indent() ++ dim(style, "trace       " ++ banner)),
      None -> configured,
    }
  }

/// An artifact says what it is: a program has its files, and this has a digest and a count.
fn program_lines(style: Style, target: Target) -> List<String> =
  match target {
    Project(_) -> [],
    Deployed(a) ->
      [
        indent()
          ++ dim(
            style,
            "program " ++ a.digest ++ " · " ++ a.definitions.to_string() ++ " definitions",
          ),
      ],
  }

/// `--drain-ms` should exceed the program's own `body_timeout_ms + write_timeout_ms`, which this
/// run cannot see, so it is printed for comparison by eye.
fn signal_lines(style: Style, bound: Bound) -> List<String> =
  match bound.signals {
    None -> [],
    Some(g) ->
      [
        indent()
          ++ dim(
            style,
            "shutdown    signals " ++ String::join(g.names, " ") ++ " · "
              ++ (match g.drain {
                Some(d) ->
                  "lead " ++ d.lead_ms.to_string() ++ "ms · drain " ++ d.drain_ms.to_string()
                    ++ "ms · second signal exits 130/143",
                None -> "children ended · exits 130/143",
              }),
          ),
      ],
  }

fn wrote(lines: List<String>, i: Int) -> Unit / {process.out[proc]} =
  if i >= lines.len() { () } else {
    process.out[proc](lines.at_or(i, ""));
    wrote(lines, i + 1)
  }

fn warned(lines: List<String>, i: Int) -> Unit / {process.err[proc]} =
  if i >= lines.len() { () } else {
    process.err[proc](lines.at_or(i, ""));
    warned(lines, i + 1)
  }

/// Written while the entry is still ahead of the run: a disclosure made afterwards discloses
/// nothing. `--json` promises stdout to the one object, so a run that makes that promise says
/// none of this aloud and carries all of it in the document instead.
fn disclosed(
  style: Style,
  flags: Flags,
  target: Target,
  bound: Bound,
  resolution: Resolution,
) -> Unit / {process.out[proc], process.err[proc], abort.raise} =
  if flags.json { () } else {
    warned(all_to_text(style, resolution.warnings, places_of(target)), 0);
    wrote(
      binding_lines(style, bound, resolution.configuration).concat(program_lines(style, target)),
      0,
    );
    warned(signal_lines(style, bound), 0)
  }

// --- What is reported once it is over ----------------------------------------

/// An expired drain is the configuration's fault: a warning, and exit 3 says requests were lost.
fn drained(diag: Diag) -> Bool = diag.code == b"W0608"

/// An abandoned run raised nothing: the clock stopped it where it stood.
fn abandoned(diag: Diag) -> Bool = diag.code == b"W0612"

fn expired_of(e: Ended) -> Bool = match e.raised { Some(r) -> drained(r.diag), None -> false }

/// Handshakes completed and refused, which a run only knows once it is over.
fn handshake_lines(style: Style, e: Ended) -> List<String> =
  e.handshakes.map(|line: String| indent() ++ dim(style, line))

fn stopped_line(style: Style, g: Stopping, w: Teardown) -> String =
  indent()
    ++ dim(
      style,
      "stopping    signal " ++ (match g.signal { Some(n) -> n, None -> "none" }) ++ " · lead "
        ++ w.lead_ms.to_string()
        ++ "ms · drain "
        ++ w.drain_ms.to_string()
        ++ "ms · "
        ++ g.listeners.to_string()
        ++ " listener(s) closed · "
        ++ g.connections.to_string()
        ++ " connection(s) in flight",
    )

fn drain_line(style: Style, g: Stopping, expired: Bool) -> String =
  indent()
    ++ dim(
      style,
      (if expired { "abandoned" } else { "drained  " }) ++ "     " ++ g.elapsed_ms.to_string()
        ++ "ms since the signal",
    )

fn teardown_line(style: Style, w: Teardown) -> String =
  indent()
    ++ dim(
      style,
      "teardown    " ++ w.spans_left_open.to_string() ++ " span(s) left open · sink flushed",
    )

fn trace_lines(style: Style, e: Ended) -> List<String> =
  match e.trace {
    None -> [],
    Some(c) ->
      [
        indent()
          ++ dim(
            style,
            "trace       " ++ c.events.to_string() ++ " event(s) · " ++ c.spans.to_string()
              ++ " span(s) · "
              ++ c.abandoned.to_string()
              ++ " abandoned · "
              ++ (if c.flushed { "flushed" } else { "not flushed" }),
          ),
      ],
  }

/// Nothing when nobody asked the service to stop.
fn stop_lines(style: Style, e: Ended) -> List<String> =
  match e.stopping {
    None -> [],
    Some(g) ->
      [
        stopped_line(style, g, e.teardown),
        drain_line(style, g, expired_of(e)),
        teardown_line(style, e.teardown),
      ].concat(
        trace_lines(style, e),
      ),
  }

fn primary_of(diag: Diag) -> Option<Label> = {
  let start: Option<Label> = None;
  diag.labels.fold(start, |acc: Option<Label>, label: Label|
    match acc { Some(_) -> acc, None -> if label.primary { Some(label) } else { None } })
}

fn spotted(places: List<Place>, label: Label) -> Option<String> / {abort.raise} =
  if label.module == no_module() { None } else {
    match places.at(label.module) {
      None -> None,
      Some(p) -> {
        let at: Spot = spot_of(p.text, label.start);
        Some(p.path ++ ":" ++ at.line.to_string() ++ ":" ++ at.col.to_string())
      },
    }
  }

/// Where the raise happened, for a reader with the file open.
fn raised_at(style: Style, target: Target, diag: Diag) -> List<String> / {abort.raise} =
  if drained(diag) || abandoned(diag) { [] } else {
    match primary_of(diag) {
      None -> [],
      Some(l) -> match spotted(places_of(target), l) {
        None -> [],
        Some(at) -> [indent() ++ red(style, "raised at") ++ " " ++ at],
      },
    }
  }

// --- The document -----------------------------------------------------------

/// What the run was over: a program has a root and its files, an artifact a file and a digest.
fn identity(target: Target) -> List<Member> =
  match target {
    Project(p) -> [{ key: "root", value: Str(p.root) }, { key: "files", value: strings(p.files) }],
    Deployed(a) ->
      [
        { key: "artifact", value: Str(a.path) },
        { key: "digest", value: Str(a.digest) },
        { key: "definitions", value: int(a.definitions) },
      ],
  }

fn counters_json(c: Counters) -> Json =
  object([
    { key: "updates", value: int(c.updates) },
    { key: "updates_in_place", value: int(c.updates_in_place) },
    { key: "in_place", value: match c.in_place { Some(d) -> Number(d), None -> Null } },
  ])

/// One shape whether or not anybody asked the run to stop, so a deployment reads one `shutdown`
/// block whichever form it shipped.
fn shutdown_json(e: Ended) -> Json =
  object([
    { key: "requested", value: Bool(match e.stopping { Some(_) -> true, None -> false }) },
    {
      key: "signal",
      value: match e.stopping { Some(g) -> string_or_null(g.signal), None -> Null },
    },
    { key: "drain_ms", value: int(e.teardown.drain_ms) },
    { key: "drain_lead_ms", value: int(e.teardown.lead_ms) },
    { key: "spans_left_open", value: int(e.teardown.spans_left_open) },
  ])

fn document(
  target: Target,
  en: String,
  resolution: Resolution,
  e: Ended,
  ok: Bool,
  code: Int,
  diags: List<Diag>,
) -> Json / {abort.raise} =
  object(
    [
      { key: "command", value: Str("run") },
      { key: "ok", value: Bool(ok) },
      { key: "exit_code", value: int(code) },
    ].concat(
      identity(target),
    ).concat([
      { key: "entry", value: Str(en) },
      { key: "module", value: Str(module_of(en)) },
      { key: "counters", value: counters_json(e.counters) },
      { key: "hosts", value: e.hosts },
      { key: "value", value: match e.value { Some(v) -> Str(render(v)), None -> Null } },
      {
        key: "configuration",
        value: configuration::report_json(configuration::report(resolution.configuration)),
      },
      { key: "shutdown", value: shutdown_json(e) },
      { key: "diagnostics", value: all_to_json(diags, places_of(target)) },
    ]),
  )

// --- The answer -------------------------------------------------------------

/// Everything the run has to say about itself that is not the entry's own answer.
fn noted(resolution: Resolution, e: Ended) -> List<Diag> = resolution.warnings.concat(e.warnings)

/// The program chose its code and returned no value, so none is printed.
fn exited(
  style: Style,
  target: Target,
  en: String,
  resolution: Resolution,
  e: Ended,
  code: Int,
) -> Answer / {abort.raise} =
  {
    json: document(target, en, resolution, e, code == ok_code(), code, noted(resolution, e)),
    lines: handshake_lines(style, e),
    errs: stop_lines(style, e).concat(warned_lines(style, e.warnings)),
    code: code,
  }

fn answered(
  style: Style,
  target: Target,
  en: String,
  resolution: Resolution,
  e: Ended,
) -> Answer / {abort.raise} =
  {
    json: document(target, en, resolution, e, true, ok_code(), noted(resolution, e)),
    lines: handshake_lines(style, e).concat([
      indent() ++ (match e.value { Some(v) -> render(v), None -> "" }),
    ]),
    errs: stop_lines(style, e).concat(warned_lines(style, e.warnings)),
    code: ok_code(),
  }

fn raised(
  style: Style,
  target: Target,
  en: String,
  resolution: Resolution,
  e: Ended,
  diag: Diag,
) -> Answer / {abort.raise} = {
  let code = if drained(diag) { drain_incomplete() } else { failed() };
  {
    json: document(target, en, resolution, e, false, code, noted(resolution, e).push(diag)),
    lines: [],
    errs: stop_lines(style, e).concat(all_to_text(style, [diag], places_of(target))).concat(
      raised_at(style, target, diag),
    ).concat(
      warned_lines(style, e.warnings),
    ),
    code: code,
  }
}

fn ended(
  style: Style,
  target: Target,
  en: String,
  resolution: Resolution,
  e: Ended,
) -> Answer / {abort.raise} =
  match e.exit {
    Some(code) -> exited(style, target, en, resolution, e, code),
    None -> match e.raised {
      None -> answered(style, target, en, resolution, e),
      Some(r) -> raised(style, target, en, resolution, e, shown(r)),
    },
  }

/// A `.plyx` that is not one is refused about the file: there is no program to tally errors over.
fn unread(style: Style, path: String, why: Refusal) -> Answer / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("run") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: int(compile_error()) },
      { key: "artifact", value: Str(path) },
      { key: "diagnostics", value: all_to_json(why.diags, why.places) },
    ]),
    lines: [],
    errs: all_to_text(style, why.diags, why.places),
    code: compile_error(),
  }

fn unloaded(style: Style, why: Refusal) -> Answer / {abort.raise} =
  match why.artifact {
    None -> refused(style, "run", why.diags, why.places),
    Some(path) -> unread(style, path, why),
  }

/// The entry point is named before anything is bound, so nothing ran and nothing is tallied.
fn unentered(style: Style, target: Target, diag: Diag) -> Answer / {abort.raise} =
  {
    json: object(
      [
        { key: "command", value: Str("run") },
        { key: "ok", value: Bool(false) },
        { key: "exit_code", value: int(compile_error()) },
      ].concat(
        identity(target),
      ).concat([{ key: "diagnostics", value: all_to_json([diag], places_of(target)) }]),
    ),
    lines: [],
    errs: all_to_text(style, [diag], places_of(target)),
    code: compile_error(),
  }

/// A registration that does not match the program is a start-up failure: nothing ran.
fn unbound(style: Style, why: Refusal) -> Answer / {abort.raise} = {
  let tally = indent() ++ red(style, "no host handler was bound") ++ " ("
    ++ count_of(why.diags.len(), "error")
    ++ ")";
  {
    json: object([
      { key: "command", value: Str("run") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: int(compile_error()) },
      { key: "diagnostics", value: all_to_json(why.diags, why.places) },
    ]),
    lines: [],
    errs: all_to_text(style, why.diags, why.places).push(tally),
    code: compile_error(),
  }
}

/// A run that loaded, bound: what the binding discloses, and its entry run under it.
type Entered<| e> = { bound: Bound, enter: () -> Ended / e }

/// A configuration that did not resolve refuses the run before anything is bound; one that did is
/// what the binding answers from. `bind` makes the binding the entry `en` runs under.
fn started<| e>(
  style: Style,
  flags: Flags,
  target: Target,
  en: String,
  cfg: Result<Resolution, List<Diag>>,
  bind: (String, Configured) -> Result<Entered<| e>, Refusal> / e,
) -> Answer / {process.out[proc], process.err[proc], abort.raise | e} =
  match cfg {
    Err(diags) -> unbound(style, { diags: diags, places: places_of(target), artifact: None }),
    Ok(r) -> match bind(en, configuration::configured(r.configuration)) {
      Err(why) -> unbound(style, why),
      Ok(b) -> {
        disclosed(style, flags, target, b.bound, r);
        ended(style, target, en, r, (b.enter)())
      },
    },
  }

fn chosen<| e>(
  style: Style,
  flags: Flags,
  target: Target,
  cfg: Result<Resolution, List<Diag>>,
  bind: (String, Configured) -> Result<Entered<| e>, Refusal> / e,
) -> Answer / {process.out[proc], process.err[proc], abort.raise | e} =
  match entry_of(target) {
    Err(d) -> unentered(style, target, d),
    Ok(en) -> started(style, flags, target, en, cfg, bind),
  }

/// What a run enters: its target, the unit it opened, and what running it reads of its front end.
type Loaded = { target: Target, unit: entering::Opened, runnable: Runnable }

/// The configuration a run binds, read once its target loaded, whose own unit enters the schema.
fn configured_over(
  loaded: Loaded,
  options: Options,
) -> Result<Resolution, List<Diag>> / {entering::machine.enter, env.variables, env.working_directory, fs.resolved[cwd], fs.resolved[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  configuration::opened_by(options.config, |name: String|
    configuration::schema_in(loaded.unit.unit, entries::roots_of(loaded.runnable), name))

/// The binding `options` make for the entry `en` of `loaded`, answering `config`, and the entry
/// run under it; or why it cannot be made: a family the program does not declare (`E0459`), or a
/// facility that does not load.
fn bound_over(
  loaded: Loaded,
  options: Options,
  en: String,
  config: Configured,
) -> Result<Entered<| {entering::machine.enter, entering::machine.unbind, abort.raise}>, Refusal> / {entering::machine.hosting, entering::machine.bind, abort.raise} = {
  let unheard = machine::run_grants(options, config, machine::Unheard);
  let declared = loaded.runnable.declared;
  let refused = |diags: List<Diag>|
    Err({ diags: diags, places: places_of(loaded.target), artifact: None });
  match listing::unlendable(unheard.allow, declared) {
    Some(d) -> refused([d]),
    None -> {
      let hosting = entering::machine.hosting(unheard);
      if hosting.refusals.len() > 0 { refused(hosting.refusals.map(machine::unplaced)) } else {
        let l = listing::resolved(declared, loaded.runnable.performed);
        let stop = listing::stop_of(l.rows);
        match entering::machine.bind(machine::run_grants(options, config, stop)) {
          Err(failures) -> refused(failures.map(machine::unplaced)),
          Ok(binding) -> {
            let bounds = { lead_ms: options.drain_lead_ms, drain_ms: options.drain_ms };
            let disclosures = listing::disclosures_of(l, hosting, config, Some(bounds));
            Ok({
              bound: {
                operations: l.rows.len(),
                digest: listing::digest_of(l, disclosures),
                trace: match disclosures.observability {
                  Some(o) -> Some(listing::banner(o)),
                  None -> None,
                },
                signals: match stop {
                  machine::Unheard -> None,
                  machine::Ends -> Some({ names: hosting.signals, drain: None }),
                  machine::Drains -> Some({ names: hosting.signals, drain: Some(bounds) }),
                },
              },
              enter: || entered(loaded, options, en, binding, l, disclosures),
            })
          },
        }
      }
    },
  }
}

/// The entry `en` of `loaded` run under `binding`, and the binding torn down once it ends: what the
/// entry answered or raised, what it reused, and what the binding's facilities report.
fn entered(
  loaded: Loaded,
  options: Options,
  en: String,
  binding: Int,
  l: Listing,
  disclosures: Disclosures,
) -> Ended / {entering::machine.enter, entering::machine.unbind, abort.raise} = {
  let o = entering::machine.enter(loaded.unit.unit, en, machine::arguments_of([]), {
    ..entering::unbounded(machine::max_calls()),
    binding: binding,
    hosted: true,
    steps: options.steps,
    timeout_ms: options.timeout,
    seed: match options.seed {
      Some(s) -> Some({ root: s.root, path: s.path, steps: plan::default_steps() }),
      None -> None,
    },
  });
  let reports = entering::machine.unbind(binding);
  let roots = entries::roots_of(loaded.runnable);
  let answer = machine::answer_of(o, roots, en);
  {
    exit: o.exit,
    // The program chose its code and returned no value, so none is carried.
    value: if o.exit != None { None } else { match answer { Ok(v) -> Some(v), Err(_) -> None } },
    raised: match answer { Ok(_) -> None, Err(r) -> Some(r) },
    counters: counters_of(o.usage),
    warnings: machine::warnings_of(o, roots),
    stopping: listing::report_of(reports, "stopping", machine::stopping_bin()),
    teardown: {
      lead_ms: options.drain_lead_ms,
      drain_ms: options.drain_ms,
      spans_left_open: listing::report_of(reports, "teardown", bin::int_bin()).unwrap_or(0),
    },
    trace: listing::report_of(reports, "trace", machine::trace_bin()),
    handshakes: listing::handshake_lines(reports),
    hosts: hosts_json(l, disclosures, reports),
  }
}

/// `in_place` is the share of updates made in place, none where nothing was updated.
fn counters_of(u: entering::Usage) -> Counters =
  {
    updates: u.updates,
    updates_in_place: u.updates_in_place,
    in_place: if u.updates == 0 { None }
    else { Decimal::of_float(Float::of_int(u.updates_in_place) / Float::of_int(u.updates)) },
  }

/// The binding's own document: its rows' count and digest, and the transport and the roots where it
/// discloses them, the handshakes beside the transport.
fn hosts_json(l: Listing, d: Disclosures, reports: List<entering::Report>) -> Json / {abort.raise} =
  object(
    [
      { key: "handlers", value: int(l.handlers) },
      { key: "operations", value: int(l.rows.len()) },
      { key: "digest", value: Str(listing::digest_of(l, d)) },
    ].concat(match d.transport {
      Some(t) ->
        [
          { key: "transport", value: transport_json(t) },
          { key: "handshakes", value: handshakes_json(reports) },
        ],
      None -> [],
    }).concat(match d.filesystem {
      Some(f) -> [{ key: "filesystem", value: filesystem_json(f) }],
      None -> [],
    }),
  )

fn handshakes_json(reports: List<entering::Report>) -> Json / {abort.raise} = {
  let h = listing::report_of(reports, "handshakes", listing::handshakes_bin()).unwrap_or({
    completed: 0,
    refused: 0,
    reasons: [],
  });
  object([
    { key: "completed", value: int(h.completed) },
    { key: "refused", value: int(h.refused) },
    {
      key: "reasons",
      value: Array(
        h.reasons.map(|r: Refused|
          object([{ key: "reason", value: Str(r.reason) }, { key: "count", value: int(r.count) }])),
      ),
    },
  ])
}

pub fn run(
  flags: Flags,
  options: Options,
) -> Answer / {shipped.answer, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, Entering, process.out[proc], process.err[proc], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variables, env.working_directory, fs.resolved[cwd], fs.resolved[abs], emit.unit, emit.compiled, toolchain.reused, shipped.definitions, shipped.runtime, priced.report, literal.verdicts, literal.statements, Derives, abort.raise, diverges, shipped.reached} = {
  let s: Style = style_of(flags);
  // An artifact is not a program to analyse: what it holds is its own definitions, and the front
  // end never sees it. Only sources are a load this side runs, so only their schema is resolved
  // here; an artifact's is the one its build shipped.
  let named = paths::given(root_of(flags));
  if is_artifact(named) {
    match config_schema::misspelled(options.config.schema) {
      Some(d) -> unbound(s, { diags: [d], places: [], artifact: None }),
      None -> match signer_refusal(flags) {
        Some(d) -> unread(s, named, { diags: [d], places: [], artifact: Some(named) }),
        None ->
          over(
            s,
            flags,
            options,
            deployed_target(named, artifact_bytes(flags), options.profile),
            None,
          ),
      },
    }
  } else { sourced(s, flags, options) }
}

/// An artifact read back and held to itself here, its unit compiled under `profile` and opened. A
/// library is a package to depend on, and nothing to run.
fn deployed_target(
  path: String,
  bytes: Option<Bytes>,
  profile: String,
) -> Result<Loaded, Refusal> / {entering::machine.open, emit.compiled, shipped.definitions, shipped.runtime, abort.raise} =
  if path.ends_with(".plyz") { Err({ diags: [a_library(path)], places: [], artifact: None }) }
  else {
    let refused = |d: List<Diag>| Err({ diags: d, places: [], artifact: Some(path) });
    match bytes {
      None -> refused([deployed::unreadable(path)]),
      Some(b) -> match deployed::opened(path, b) {
        Err(d) -> refused([d]),
        Ok(o) -> match units::library(o.unit, profile) {
          Err(diags) -> refused(diags),
          Ok(library) -> match entering::machine.open(library) {
            Err(why) -> refused([machine::unloaded(why)]),
            Ok(unit) ->
              Ok({
                target: Deployed({
                  path: path,
                  digest: o.digest,
                  entry: o.entry,
                  definitions: o.definitions,
                }),
                unit: unit,
                runnable: o.runnable,
              }),
          },
        },
      },
    }
  }

fn a_library(path: String) -> Diag =
  error_at(
    b"E0443",
    no_module(),
    dummy_span(),
    Bytes::of_string("`" ++ path ++ "` is a library, and nothing to run"),
    b"not a program",
    [
      b"a `.plyz` is a package: declare it in a `ply.pkg` and depend on it",
      b"`ply build` writes a program's artifact as a `.plyx`",
    ],
  )

/// Read here, so the machine reads no file of its own.
fn artifact_bytes(flags: Flags) -> Option<Bytes> / {fs.read_file[cwd], fs.read_file[abs]} =
  match flags.paths.at(0) { Some(r) -> paths::read_file(paths::rooted(r)), None -> None }

// --- `--require-signer` ---------------------------------------------------------------

fn unsigned(path: String, why: String) -> Diag =
  error_at(
    b"E0460",
    no_module(),
    dummy_span(),
    Bytes::of_string("the artifact `" ++ path ++ "` " ++ why),
    b"not signed by a key `--require-signer` trusts",
    [
      b"`ply build --sign KEY` signs what it builds, in `<artifact>.sig` beside it; `--require-signer` names the public key files a run trusts",
    ],
  )

fn trusted_keys(
  files: List<String>,
) -> Result<List<Bytes>, Diag> / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  files.fold(Ok([]), |acc: Result<List<Bytes>, Diag>, path: String|
    match acc {
      Err(d) -> Err(d),
      Ok(keys) -> match paths::read_file(paths::spelled(path)) {
        None -> Err(unkeyed(path, "cannot be read")),
        Some(b) -> match public_of(String::of_bytes_lossy(b)) {
          Ok(k) -> Ok(keys.push(k)),
          Err(why) -> Err(unkeyed(path, "does not hold a public key: " ++ why)),
        },
      },
    })

fn signatures_of(flags: Flags) -> Option<Bytes> / {fs.read_file[cwd], fs.read_file[abs]} =
  match flags.paths.at(0) {
    Some(r) -> {
      let at = paths::rooted(r);
      paths::read_file({ ..at, path: signatures_path(at.path) })
    },
    None -> None,
  }

/// An artifact `--require-signer` holds to its keys runs only when one of them signed its digest.
fn signer_refusal(
  flags: Flags,
) -> Option<Diag> / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  if flags.signers.len() == 0 { None } else {
    let path = paths::given(root_of(flags));
    match trusted_keys(flags.signers) {
      Err(d) -> Some(d),
      Ok(keys) -> match artifact_bytes(flags) {
        // The machine refuses a file it cannot read, as it would without a signer to ask for.
        None -> None,
        Some(bytes) -> {
          let into = if path.ends_with(".plyz") { library_domain() } else { domain() };
          let digest = match digest_of(into, bytes) { Some(d) -> digest_text(d), None -> "" };
          match signatures_of(flags) {
            None ->
              Some(
                unsigned(
                  path,
                  "carries no signatures: `" ++ signatures_path(path) ++ "` is not there",
                ),
              ),
            Some(b) -> match signed_of(b) {
              None -> Some(unsigned(path, "has signatures beside it that do not read")),
              Some(g) -> match provenance_of(g.payload) {
                None ->
                  Some(unsigned(path, "has signatures beside it over nothing a build vouches for")),
                Some(what) -> if what.digest != digest {
                  Some(
                    unsigned(
                      path,
                      "is " ++ digest ++ ", and its signatures vouch for " ++ what.digest,
                    ),
                  )
                } else {
                  match vouched_by(g, keys) {
                    Some(_) -> None,
                    None -> Some(unsigned(path, "is signed by no key `--require-signer` names")),
                  }
                },
              },
            },
          }
        },
      },
    }
  }

/// Whether a path names a built artifact rather than sources. `ply build` writes them, and the
/// container they hold is `compiler.store.plyx`'s, so the spelling lives beside the writer.
fn is_artifact(path: String) -> Bool = path.ends_with(".plyx") || path.ends_with(".plyz")

/// A run of sources: the walk, then the load an earlier run of the same closure kept under what the
/// walk hashes to, or this run's own front end when none is kept or the one kept does not fit.
fn sourced(
  style: Style,
  flags: Flags,
  options: Options,
) -> Answer / {shipped.answer, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, Entering, process.out[proc], process.err[proc], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variables, env.working_directory, fs.resolved[cwd], fs.resolved[abs], emit.unit, emit.compiled, toolchain.reused, priced.report, literal.verdicts, literal.statements, Derives, abort.raise, diverges, shipped.reached} = {
  let started = time.elapsed_ms();
  let project: sources::Project = load_resolved(flags.paths);
  let key = command_key(queried::program(), asked_of(flags, options));
  let asked = time.elapsed_ms();
  let filed = command_kept(flags.paths, project, key);
  let kept = match filed.output {
    None -> None,
    Some(bytes) -> match entries::taken(bytes) {
      None -> None,
      Some(k) -> reused(root_of(flags).machine, project, k),
    },
  };
  match kept {
    Some(t) -> {
      let l = {
        reused: true,
        key: key.hex_of(),
        read_ms: asked - started,
        front_ms: 0,
        file_ms: 0,
        load_ms: time.elapsed_ms() - asked,
      };
      over(style, flags, options, Ok(t), Some(l))
    },
    None -> built(style, flags, options, project, key, filed.marks, started),
  }
}

/// The load `taken` kept, over this run's own files, its unit opened from the library it was
/// compiled into; none where the walk does not fit it or the library is gone.
fn reused(
  root: String,
  project: sources::Project,
  taken: Taken,
) -> Option<Loaded> / {entering::machine.open, abort.raise} = {
  let walked: Placed = placed_of(project);
  match entries::placed_over(taken.files, walked.modules, walked.manifests) {
    None -> None,
    Some(places) -> match entering::machine.open(taken.library) {
      Err(_) -> None,
      Ok(unit) ->
        Some({
          target: program_of(
            {
              root: machine::project_root(root),
              files: places.map(|p: Place| p.path),
              places: places,
            },
            taken.entries.mains,
            taken.entries.modules,
          ),
          unit: unit,
          runnable: taken.runnable,
        }),
    },
  }
}

/// What names a run and what shapes its front end's answer: the paths it was given and the
/// `--config-schema` the answer is resolved against.
fn asked_of(flags: Flags, options: Options) -> Bytes =
  Bytes::concat_all([
    sized(b"ply run"),
    resolved_fields(flags.paths),
    match options.config.schema {
      Some(s) -> b"+".concat(sized(Bytes::of_string(s))),
      None -> b"-",
    },
  ])

/// This run's own front end and its unit, kept under `key` once the load holds, with `marks`, the
/// marks found on what was kept there, removed.
fn built(
  style: Style,
  flags: Flags,
  options: Options,
  project: sources::Project,
  key: Bytes,
  marks: List<Bytes>,
  started: Int,
) -> Answer / {shipped.answer, fs.list_dir[shipped], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], time.elapsed_ms, Entering, process.out[proc], process.err[proc], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variables, env.working_directory, fs.resolved[cwd], fs.resolved[abs], emit.unit, emit.compiled, toolchain.reused, priced.report, literal.verdicts, literal.statements, Derives, abort.raise, shipped.reached} = {
  let t: Timed = timed_over(flags.paths, project, started);
  match program_view(t.program) {
    // A load refusal, in the shape the machine's own refusals take: nothing ran, and the
    // diagnostics say why.
    None -> unloaded(style, { diags: t.program.diags, places: t.program.places, artifact: None }),
    Some(w) -> match config_schema::refusal(w, options.config.schema) {
      Some(d) -> unbound(style, { diags: [d], places: t.program.places, artifact: None }),
      None -> match broken_promises(t.program, w.frame) {
        [] -> match unsettled(t, w.frame) {
          [] -> loaded_built(style, flags, options, project, t, w, key, marks),
          refused -> unloaded(style, { diags: refused, places: t.program.places, artifact: None }),
        },
        broken -> unloaded(style, { diags: broken, places: t.program.places, artifact: None }),
      },
    },
  }
}

/// A front end this run checked, its unit compiled and opened, kept under the walk's key once the
/// load holds.
fn loaded_built(
  style: Style,
  flags: Flags,
  options: Options,
  project: sources::Project,
  timed: Timed,
  view: View,
  key: Bytes,
  marks: List<Bytes>,
) -> Answer / {shipped.answer, fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], time.elapsed_ms, Entering, process.out[proc], process.err[proc], env.variables, env.working_directory, fs.resolved[cwd], fs.resolved[abs], fs.read_file[cwd], fs.read_file[abs], emit.unit, emit.compiled, fs.write[abs], Derives, abort.raise} = {
  let asked = time.elapsed_ms();
  let front = front_of(timed, view);
  let emitted = match units::whole(front) {
    Err(diags) -> Err(diags),
    Ok(text) -> units::library(text, options.profile),
  };
  let offered = entries::named(entries::of_front(front), flags.paths);
  let runnable = entries::runnable_of(front);
  let refused = |diags: List<Diag>|
    Err({ diags: diags, places: timed.program.places, artifact: None });
  let loaded = match emitted {
    Err(diags) -> refused(diags),
    Ok(library) -> match entering::machine.open(library) {
      Err(why) -> refused([machine::unloaded(why)]),
      Ok(unit) ->
        Ok({
          target: program_of(
            {
              root: machine::project_root(root_of(flags).machine),
              files: front.files.map(|f: SourceFile| f.path),
              places: front.files.map(|f: SourceFile| { path: f.path, text: f.text }),
            },
            offered.mains,
            offered.modules,
          ),
          unit: unit,
          runnable: runnable,
        }),
    },
  };
  let l = {
    reused: false,
    key: key.hex_of(),
    read_ms: timed.read_ms,
    front_ms: timed.front_ms,
    file_ms: timed.file_ms,
    load_ms: time.elapsed_ms() - asked,
  };
  match ((loaded, emitted)) {
    (Ok(_), Ok(library)) -> {
      let _ = keep_command(
        flags.paths,
        project,
        key,
        timed.program,
        entries::kept(offered, library, front.files, runnable),
        marks,
      );
      ()
    },
    _ -> (),
  };
  over(style, flags, options, loaded, Some(l))
}

/// The run over what loaded, or the refusal of the load; the unit is closed once the run is over.
fn over(
  style: Style,
  flags: Flags,
  options: Options,
  loaded: Result<Loaded, Refusal>,
  l: Option<Loading>,
) -> Answer / {Entering, process.out[proc], process.err[proc], env.variables, env.working_directory, fs.resolved[cwd], fs.resolved[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match loaded {
    Err(why) -> unloaded(style, why),
    Ok(t) -> {
      let answer = reported(
        style,
        flags,
        Ok(t.target),
        configured_over(t, options),
        |en: String, config: Configured| bound_over(t, options, en, config),
        l,
      );
      entering::machine.close(t.unit.unit);
      answer
    },
  }

/// The run over `target`, bound and entered as `bind` says; over sources, saying where the load's
/// time went when `--explain` asks: aloud before the entry runs, or in the one document under
/// `--json`.
fn reported<| e>(
  style: Style,
  flags: Flags,
  target: Result<Target, Refusal>,
  cfg: Result<Resolution, List<Diag>>,
  bind: (String, Configured) -> Result<Entered<| e>, Refusal> / e,
  l: Option<Loading>,
) -> Answer / {process.out[proc], process.err[proc], abort.raise | e} =
  match target {
    Err(why) -> unloaded(style, why),
    Ok(t) -> match l {
      None -> chosen(style, flags, t, cfg, bind),
      Some(loading) -> {
        if flags.explain && !flags.json { process.err[proc](loading_line(style, loading)) };
        explained(flags, loading, chosen(style, flags, t, cfg, bind))
      },
    },
  }

// --- Where a load's time went --------------------------------------------------

/// A load over sources: whether its front end ran or the answer an earlier run filed under its key
/// was taken, and what each phase cost.
type Loading = {
  reused: Bool,
  key: String,
  read_ms: Int,
  front_ms: Int,
  file_ms: Int,
  load_ms: Int,
}

fn millis(n: Int) -> String = n.to_string() ++ "ms"

fn loading_line(style: Style, l: Loading) -> String / {abort.raise} = {
  let phases = if l.reused { ["read " ++ millis(l.read_ms), "load " ++ millis(l.load_ms)] } else {
    [
      "read " ++ millis(l.read_ms),
      "front " ++ millis(l.front_ms),
      "write back " ++ millis(l.file_ms),
      "load " ++ millis(l.load_ms),
    ]
  };
  indent()
    ++ dim(
      style,
      "front end   " ++ (if l.reused { "reused " } else { "built " }) ++ short(l.key) ++ " · "
        ++ String::join(phases, " · "),
    )
}

fn loading_json(l: Loading) -> Json =
  object([
    { key: "reused", value: Bool(l.reused) },
    { key: "key", value: Str(l.key) },
    {
      key: "phases",
      value: object([
        { key: "read", value: int(l.read_ms) },
        { key: "front", value: int(l.front_ms) },
        { key: "write_back", value: int(l.file_ms) },
        { key: "load", value: int(l.load_ms) },
      ]),
    },
  ])

fn explained(flags: Flags, l: Loading, answer: Answer) -> Answer =
  if !(flags.explain && flags.json) { answer } else {
    match answer.json {
      Object(members) -> { ..answer, json: Object(members.insert("front_end", loading_json(l))) },
      _ -> answer,
    }
  }

/// `b3:` and the key's first twelve hex characters, as a report prints a digest.
fn short(key: String) -> String / {abort.raise} = "b3:" ++ key.slice(0, 12)

// --- Tests ------------------------------------------------------------------

fn a_main() -> Main =
  { name: "m.main", module: "m", path: "m.ply", at: { module: 0, start: 3, end: 7 } }

fn a_program() -> Target =
  Project({
    root: "/p",
    files: ["m.ply"],
    places: [{ path: "m.ply", text: b"fn main() -> Int = 42\n" }],
    mains: [a_main()],
    modules: [{ name: "m", path: "m.ply", at: { module: 0, start: 22, end: 22 } }],
  })

fn an_artifact() -> Target =
  Deployed({ path: "m.plyx", digest: "b3:1f2e3d4c5b6a", entry: "m.main", definitions: 3 })

fn reaching_nothing() -> Bound = { operations: 0, digest: "", trace: None, signals: None }

fn a_binding() -> Bound =
  {
    operations: 7,
    digest: "b3:aabbccddeeff",
    trace: Some("json on stderr · info"),
    signals: Some({ names: ["SIGINT", "SIGTERM"], drain: Some({ lead_ms: 0, drain_ms: 30000 }) }),
  }

fn no_counters() -> Counters = { updates: 0, updates_in_place: 0, in_place: None }

fn no_teardown() -> Teardown = { lead_ms: 0, drain_ms: 30000, spans_left_open: 0 }

fn answered_with(value: Value) -> Ended =
  {
    exit: None,
    value: Some(value),
    raised: None,
    counters: no_counters(),
    warnings: [],
    stopping: None,
    teardown: no_teardown(),
    trace: None,
    handshakes: [],
    hosts: Null,
  }

fn unvalued(diag: Diag) -> Raised = { diag: diag, values: [] }

fn a_diag(code: Bytes, message: Bytes, labels: List<Label>) -> Diag =
  {
    code: code,
    notes: 0,
    labels: labels,
    text: b"",
    message: message,
    notes_text: [],
    severity: b"error",
    fixes: [],
  }

fn nothing() -> Refusal = { diags: [], places: [], artifact: None }

/// The run's own answer over a load, a binding and an entry the test hands it in place of the
/// runtime, with whatever it wrote on either stream captured beside it.
type RunCapture = { answer: Answer, out: List<String>, err: List<String> }

fn ran_over(
  flags: Flags,
  t: Result<Target, Refusal>,
  b: Result<Bound, Refusal>,
  e: Ended,
) -> RunCapture / {abort.raise} = ran_loaded(flags, t, Ok(unconfigured()), b, e, None)

fn unconfigured() -> Resolution = { configuration: configuration::unopened(), warnings: [] }

/// Two keys the schema declares, one of them secret, both from the environment.
fn configured_service() -> Resolution / {abort.raise} =
  match configuration::sources_of([], [], [
      { name: "PORT", value: "8137" },
      { name: "TOKEN", value: "t" },
    ]) {
    Err(_) -> panic("the fixture's sources read"),
    Ok(sources) -> match configuration::resolved(
        sources,
        Some({
          function: "m.spec",
          keys: [
            { name: "PORT", shape: SInt, required: true, default: None },
            { name: "TOKEN", shape: SSecret, required: true, default: None },
          ],
        }),
      ) {
      Err(_) -> panic("the fixture resolves"),
      Ok(r) -> r,
    },
  }

/// The same over sources, whose load `l` says where the time went, when there is one to say.
fn ran_loaded(
  flags: Flags,
  t: Result<Target, Refusal>,
  cfg: Result<Resolution, List<Diag>>,
  b: Result<Bound, Refusal>,
  e: Ended,
  l: Option<Loading>,
) -> RunCapture / {abort.raise} =
  handle {
    reported(
      plain(),
      flags,
      t,
      cfg,
      |en: String, config: Configured|
        match b { Ok(bound) -> Ok({ bound: bound, enter: || e }), Err(why) -> Err(why) },
      l,
    )
  } with {
    var io = captured([]),
    process.out[proc](text) -> {
      io = out_step(io, text);
    },
    process.err[proc](text) -> {
      io = err_step(io, text);
    },
    return answer -> { answer: answer, out: io.out, err: io.err },
  }

fn bare() -> Flags / {abort.raise} = from_argv("run", [])

fn as_json() -> Flags / {abort.raise} = from_argv("run", ["--json"])

test "a value the entry answered with is one indented line and exit 0" {
  let ran = ran_over(bare(), Ok(a_program()), Ok(reaching_nothing()), answered_with(VInt(42)));
  assert_eq(ran.answer.code, 0);
  assert_eq(ran.answer.lines, ["   42"]);
  assert_eq(ran.answer.errs, []);
  assert_eq(ran.out, []);
  assert_eq(ran.err, [])
}

test "the object keys off `command` and `exit_code`, and names the entry and its module" {
  let text = to_string(
    ran_over(
      as_json(),
      Ok(a_program()),
      Ok(reaching_nothing()),
      answered_with(VInt(42)),
    ).answer.json,
  );
  assert(text.contains("\"command\":\"run\""));
  assert(text.contains("\"exit_code\":0"));
  assert(text.contains("\"entry\":\"m.main\""));
  assert(text.contains("\"module\":\"m\""));
  assert(text.contains("\"value\":\"42\""));
  assert(text.contains("\"root\":\"/p\""));
  assert(text.contains("\"files\":[\"m.ply\"]"))
}

// What a run may reach is disclosed while the entry is still ahead of it, so it goes out on the
// stream as the program runs rather than in the answer collected after it.
test "a bound run discloses what it may reach before the entry is entered" {
  let ran = ran_loaded(
    bare(),
    Ok(a_program()),
    Ok(configured_service()),
    Ok(a_binding()),
    answered_with(VInt(42)),
    None,
  );
  assert_eq(ran.out, [
    "   binding host · 7 operations · b3:aabbccddeeff",
    "   config      2 keys · 2 environment · 1 secret (values not shown)",
    "   trace       json on stderr · info",
  ]);
  assert_eq(ran.err, [
    "   shutdown    signals SIGINT SIGTERM · lead 0ms · drain 30000ms · second signal exits 130/143",
  ]);
  assert_eq(ran.answer.lines, ["   42"])
}

test "a run that ends at once on a stop says so before the entry is entered" {
  let ending = { ..a_binding(), signals: Some({ names: ["SIGINT", "SIGTERM"], drain: None }) };
  let ran = ran_over(bare(), Ok(a_program()), Ok(ending), answered_with(VInt(42)));
  assert_eq(ran.err, ["   shutdown    signals SIGINT SIGTERM · children ended · exits 130/143"])
}

test "`--json` promises stdout to the one object, so nothing else is written at all" {
  let ran = ran_over(as_json(), Ok(a_program()), Ok(a_binding()), answered_with(VInt(42)));
  assert_eq(ran.out, []);
  assert_eq(ran.err, []);
  assert(to_string(ran.answer.json).contains("\"value\":\"42\""))
}

test "a run that performs nothing of the host discloses nothing, because there is nothing it could reach" {
  let ran = ran_over(bare(), Ok(a_program()), Ok(reaching_nothing()), answered_with(VUnit));
  assert_eq(ran.out, []);
  assert_eq(ran.err, [])
}

test "a raise is exit 1, and says where it was raised for a reader with the file open" {
  let raise = {
    ..answered_with(VInt(42)),
    value: None,
    raised: Some(
      unvalued(
        a_diag(b"E0501", b"nope", [
          { module: 0, start: 19, end: 21, primary: true, text: b"here" },
        ]),
      ),
    ),
  };
  let ran = ran_over(bare(), Ok(a_program()), Ok(reaching_nothing()), raise);
  assert_eq(ran.answer.code, 1);
  assert_eq(ran.answer.lines, []);
  assert_eq(ran.answer.errs.at_or(0, ""), "Error[E0501]: nope");
  assert_eq(ran.answer.errs.at_or(ran.answer.errs.len() - 1, ""), "   raised at m.ply:1:20")
}

test "a raise shows the values it carries, rendered where its text names them" {
  let raise = {
    ..answered_with(VInt(42)),
    value: None,
    raised: Some({ diag: a_diag(b"E0501", b"expected \x010\x02", []), values: [VInt(3)] }),
  };
  let ran = ran_over(bare(), Ok(a_program()), Ok(reaching_nothing()), raise);
  assert_eq(ran.answer.errs.at_or(0, ""), "Error[E0501]: expected 3")
}

test "an expired drain is exit 3, and is not attributed to a line of the program" {
  let expired = {
    ..answered_with(VUnit),
    value: None,
    raised: Some(unvalued(a_diag(b"W0608", b"the drain deadline expired", []))),
  };
  let ran = ran_over(bare(), Ok(a_program()), Ok(a_binding()), expired);
  assert_eq(ran.answer.code, 3);
  assert_eq(ran.answer.errs.filter(|l: String| l.contains("raised at")).len(), 0)
}

test "a program that chose its own exit code is answered with that code and no value" {
  let chose = { ..answered_with(VUnit), exit: Some(7), value: None };
  let ran = ran_over(bare(), Ok(a_program()), Ok(reaching_nothing()), chose);
  assert_eq(ran.answer.code, 7);
  assert_eq(ran.answer.lines, []);
  let text = to_string(
    ran_over(as_json(), Ok(a_program()), Ok(reaching_nothing()), chose).answer.json,
  );
  assert(text.contains("\"exit_code\":7"));
  assert(text.contains("\"ok\":false"));
  assert(text.contains("\"value\":null"))
}

test "a stopped run says what was in flight, how long the drain took, and what it left open" {
  let stopped = {
    ..answered_with(VUnit),
    stopping: Some({ signal: Some("SIGTERM"), listeners: 1, connections: 2, elapsed_ms: 40 }),
    teardown: { ..no_teardown(), spans_left_open: 1 },
    trace: Some({ events: 9, spans: 4, abandoned: 2, flushed: true }),
  };
  let ran = ran_over(bare(), Ok(a_program()), Ok(a_binding()), stopped);
  assert_eq(ran.answer.errs, [
    "   stopping    signal SIGTERM · lead 0ms · drain 30000ms · 1 listener(s) closed · 2 connection(s) in flight",
    "   drained       40ms since the signal",
    "   teardown    1 span(s) left open · sink flushed",
    "   trace       9 event(s) · 4 span(s) · 2 abandoned · flushed",
  ])
}

test "the shutdown block counts the spans left open, as the warning that named them did" {
  let finished = {
    ..answered_with(VInt(3)),
    warnings: [left_open()],
    teardown: { ..no_teardown(), spans_left_open: 2 },
  };
  let text = to_string(
    ran_over(as_json(), Ok(a_program()), Ok(reaching_nothing()), finished).answer.json,
  );
  assert(text.contains("\"spans_left_open\":2"))
}

/// What the runtime warns of when an entry ends with `reserving` open inside `order`.
fn left_open() -> Diag =
  {
    ..a_diag(b"W0609", b"2 spans were still open when their task or the entry point ended: `reserving` on `orders`, `order` on `orders`", []),
    notes: 1,
    notes_text: [b"each was closed `Abandoned` and written"],
    severity: b"warning",
  }

fn warned_of_spans() -> List<String> =
  [
    "",
    "   warning: 2 spans were still open when their task or the entry point ended: `reserving` on `orders`, `order` on `orders`",
    "     = each was closed `Abandoned` and written",
  ]

test "spans an entry left open are warned of on stderr under its answer, and its exit 0 stands" {
  let finished = { ..answered_with(VInt(3)), warnings: [left_open()] };
  let ran = ran_over(bare(), Ok(a_program()), Ok(reaching_nothing()), finished);
  assert_eq(ran.answer.code, 0);
  assert_eq(ran.answer.lines, ["   3"]);
  assert_eq(ran.answer.errs, warned_of_spans());
  let text = to_string(
    ran_over(as_json(), Ok(a_program()), Ok(reaching_nothing()), finished).answer.json,
  );
  assert(text.contains("\"code\":\"W0609\""));
  assert(text.contains("\"exit_code\":0"))
}

test "a raise that left spans open is said first, and the spans after where it was raised" {
  let finished = {
    ..answered_with(VUnit),
    value: None,
    raised: Some(
      unvalued(
        a_diag(b"E0502", b"boom", [
          { module: 0, start: 19, end: 21, primary: true, text: b"here" },
        ]),
      ),
    ),
    warnings: [left_open()],
  };
  let ran = ran_over(bare(), Ok(a_program()), Ok(reaching_nothing()), finished);
  assert_eq(ran.answer.code, 1);
  let errs = ran.answer.errs;
  assert_eq(errs.at_or(0, ""), "Error[E0502]: boom");
  assert_eq(errs.at_or(errs.len() - 4, ""), "   raised at m.ply:1:20");
  assert_eq(range(errs.len() - 3, errs.len()).map(|i: Int| errs.at_or(i, "")), warned_of_spans())
}

test "an artifact says which file it ran, its digest, and what it carries" {
  let ran = ran_over(bare(), Ok(an_artifact()), Ok(reaching_nothing()), answered_with(VInt(42)));
  assert_eq(ran.out, ["   program b3:1f2e3d4c5b6a · 3 definitions"]);
  let text = to_string(
    ran_over(
      as_json(),
      Ok(an_artifact()),
      Ok(reaching_nothing()),
      answered_with(VInt(42)),
    ).answer.json,
  );
  assert(text.contains("\"artifact\":\"m.plyx\""));
  assert(text.contains("\"digest\":\"b3:1f2e3d4c5b6a\""));
  assert(text.contains("\"definitions\":3"));
  assert(text.contains("\"entry\":\"m.main\""))
}

test "a program that does not load is the load's own refusal with the tally under it" {
  let why: Refusal = {
    diags: [a_diag(b"E0201", b"type mismatch", [])],
    places: [],
    artifact: None,
  };
  let ran = ran_over(bare(), Err(why), Err(nothing()), answered_with(VUnit));
  assert_eq(ran.answer.code, 2);
  assert_eq(ran.answer.lines, []);
  assert_eq(ran.answer.errs, [
    "Error[E0201]: type mismatch",
    indent() ++ "compilation failed (1 error)",
  ])
}

test "a file that is not an artifact is refused about the file and tallies nothing" {
  let why: Refusal = {
    diags: [a_diag(b"E0443", b"not a program at all", [])],
    places: [],
    artifact: Some("junk.plyx"),
  };
  let text = to_string(
    ran_over(as_json(), Err(why), Err(nothing()), answered_with(VUnit)).answer.json,
  );
  assert(text.contains("\"artifact\":\"junk.plyx\""));
  assert(text.contains("\"E0443\""));
  let ran = ran_over(bare(), Err(why), Err(nothing()), answered_with(VUnit));
  assert_eq(ran.answer.code, 2);
  assert_eq(ran.answer.errs, ["Error[E0443]: not a program at all"])
}

test "a program with no `main` is refused over its own files before anything is bound" {
  let empty = Project({
    root: "/p",
    files: ["m.ply"],
    places: [],
    mains: [],
    modules: [{ name: "m", path: "m.ply", at: { module: 0, start: 18, end: 18 } }],
  });
  let ran = ran_over(as_json(), Ok(empty), Err(nothing()), answered_with(VUnit));
  assert_eq(ran.answer.code, 2);
  let text = to_string(ran.answer.json);
  assert(text.contains("\"root\":\"/p\""));
  assert(text.contains("\"E0101\""))
}

test "a binding that does not match the program is a start-up failure naming no line" {
  let why: Refusal = {
    diags: [a_diag(b"E0412", b"a nondet effect in a det test", [])],
    places: [],
    artifact: None,
  };
  let ran = ran_over(bare(), Ok(a_program()), Err(why), answered_with(VUnit));
  assert_eq(ran.answer.code, 2);
  assert_eq(ran.answer.errs, [
    "Error[E0412]: a nondet effect in a det test",
    indent() ++ "no host handler was bound (1 error)",
  ]);
  assert(
    to_string(
      ran_over(as_json(), Ok(a_program()), Err(why), answered_with(VUnit)).answer.json,
    ).contains(
      "\"exit_code\":2",
    ),
  )
}

test "what the machine reused is a count and a ratio, and no ratio at all over nothing" {
  let reused = {
    ..answered_with(VInt(42)),
    counters: { updates: 4, updates_in_place: 3, in_place: Decimal::of_string("0.75") },
  };
  let text = to_string(
    ran_over(as_json(), Ok(a_program()), Ok(reaching_nothing()), reused).answer.json,
  );
  assert(text.contains("\"updates\":4"));
  assert(text.contains("\"updates_in_place\":3"));
  assert(text.contains("\"in_place\":0.75"));
  let over_nothing = to_string(
    ran_over(
      as_json(),
      Ok(a_program()),
      Ok(reaching_nothing()),
      answered_with(VInt(42)),
    ).answer.json,
  );
  assert(over_nothing.contains("\"in_place\":null"))
}

test "an entry's updates in place are a share of its updates, and no share of none" {
  let usage: entering::Usage = {
    nanos: 0,
    host: false,
    steps: 0,
    performs: 0,
    bridges: 0,
    scheduled: 0,
    task_stacks: 0,
    frame_tables: 0,
    updates: 4,
    updates_in_place: 3,
    live: 0,
  };
  assert_eq(counters_of(usage).in_place, Decimal::of_string("0.75"));
  assert_eq(counters_of({ ..usage, updates: 0, updates_in_place: 0 }).in_place, None)
}

test "a definition's module is its name without its own last segment" {
  assert_eq(module_of("m.main"), "m");
  assert_eq(module_of("store.orders.main"), "store.orders")
}

fn a_key() -> String = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn a_reuse() -> Loading =
  { reused: true, key: a_key(), read_ms: 9, front_ms: 0, file_ms: 0, load_ms: 41 }

fn a_build() -> Loading =
  { reused: false, key: a_key(), read_ms: 7, front_ms: 1774, file_ms: 44, load_ms: 1392 }

fn explaining() -> Flags / {abort.raise} = from_argv("run", ["--explain"])

fn loaded(flags: Flags, l: Loading) -> RunCapture / {abort.raise} =
  ran_loaded(
    flags,
    Ok(a_program()),
    Ok(unconfigured()),
    Ok(a_binding()),
    answered_with(VInt(42)),
    Some(l),
  )

test "a run over a reused front end answers exactly as one over a front end it ran" {
  assert_eq(loaded(bare(), a_reuse()), loaded(bare(), a_build()));
  assert_eq(loaded(as_json(), a_reuse()), loaded(as_json(), a_build()));
  assert_eq(
    loaded(bare(), a_reuse()),
    ran_over(bare(), Ok(a_program()), Ok(a_binding()), answered_with(VInt(42))),
  )
}

test "`--explain` says whether the front end ran, under which key, and where the time went" {
  let reused = loaded(explaining(), a_reuse());
  assert_eq(
    reused.err.at_or(0, ""),
    "   front end   reused b3:0123456789ab · read 9ms · load 41ms",
  );
  let built = loaded(explaining(), a_build());
  assert_eq(
    built.err.at_or(0, ""),
    "   front end   built b3:0123456789ab · read 7ms · front 1774ms · write back 44ms · load 1392ms",
  );
  // Said before the entry runs, ahead of what the binding discloses on the same stream.
  assert_eq(built.err.at_or(1, ""), loaded(bare(), a_build()).err.at_or(0, ""));
  assert_eq(built.answer, loaded(bare(), a_build()).answer)
}

test "`--json --explain` carries the load in the one document and says nothing aloud" {
  let ran = loaded(from_argv("run", ["--json", "--explain"]), a_reuse());
  assert_eq(ran.out, []);
  assert_eq(ran.err, []);
  let text = to_string(ran.answer.json);
  assert(text.contains("\"front_end\":{\"key\":\"" ++ a_key() ++ "\""));
  assert(text.contains("\"phases\":{\"front\":0,\"load\":41,\"read\":9,\"write_back\":0}"));
  assert(text.contains("\"reused\":true"));
  assert(!to_string(loaded(as_json(), a_reuse()).answer.json).contains("front_end"))
}

test "a load the machine refused says nothing about where its time went" {
  let why: Refusal = {
    diags: [a_diag(b"E0201", b"type mismatch", [])],
    places: [],
    artifact: None,
  };
  let ran = ran_loaded(
    explaining(),
    Err(why),
    Ok(unconfigured()),
    Err(nothing()),
    answered_with(VUnit),
    Some(a_build()),
  );
  assert_eq(ran.err, []);
  assert_eq(ran.answer.code, 2)
}

test "a walk places its modules, the root's first, and its manifests apart" {
  let project = {
    files: [
      {
        path: "main.ply",
        module: "main",
        text: b"fn main() -> Int = 1\n",
        at: { label: "cwd", path: "main.ply" },
      },
      {
        path: "util.ply",
        module: "util",
        text: b"pub fn one() -> Int = 1\n",
        at: { label: "cwd", path: "util.ply" },
      },
    ],
    sources: [],
    diags: [],
    manifest: Some({
      path: "ply.pkg",
      module: "",
      text: b"fn package() -> Manifest = app()\n",
      at: { label: "cwd", path: "ply.pkg" },
    }),
    packages: [
      {
        root: "/w/lib",
        dir: "/w/lib",
        manifest: Some(b"fn package() -> Manifest = lib()\n"),
        files: [
          {
            path: "/w/lib/deep.ply",
            module: "deep",
            text: b"pub fn deep() -> Int = 7\n",
            at: { label: "cwd", path: "/w/lib/deep.ply" },
          },
        ],
      },
    ],
    root_key: "/w/app",
    absent: [],
  };
  let w: Placed = placed_of(project);
  assert_eq(w.modules.map(|p: Place| p.path), ["main.ply", "util.ply", "/w/lib/deep.ply"]);
  assert_eq(w.manifests.map(|p: Place| p.path), ["ply.pkg", "/w/lib/ply.pkg"])
}
