fn failed() -> Int = 1

fn drain_incomplete() -> Int = 3

fn module_of(name: String) -> String = {
  let parts = name.split(".");
  String::join(range(0, parts.len() - 1).map(|i: Int| parts.at_or(i, "")), ".")
}

fn places_of(target: Target) -> List<SourceText> =
  match target { Project(p) -> p.source_texts, Deployed(_) -> [] }

fn entry_of(target: Target) -> Result<String, Diagnostic> / {abort.raise} =
  match target {
    Project(p) -> match entry_point(p.mains, p.modules) { Ok(m) -> Ok(m.name), Err(d) -> Err(d) },
    Deployed(a) -> Ok(a.entry),
  }

fn binding_lines(
  style: Style,
  bound: BindingSummary,
  c: Configuration,
) -> List<String> / {abort.raise} =
  if bound.operations == 0 { [] } else {
    let head = [
      indent()
        ++ dim(
          style,
          "host: " ++ count_of(bound.operations, "operation") ++ " · " ++ bound.digest,
        ),
    ];
    let configured = if configuration::has_input(c) {
      head.push(indent() ++ dim(style, "config      " ++ configuration::banner(c)))
    } else { head };
    match bound.trace {
      Some(banner) -> configured.push(indent() ++ dim(style, "trace       " ++ banner)),
      None -> configured,
    }
  }

fn program_lines(style: Style, target: Target) -> List<String> =
  match target {
    Project(_) -> [],
    Deployed(a) ->
      [
        indent()
          ++ dim(
            style,
            "program " ++ a.digest ++ " · " ++ a.definition_count.to_string() ++ " definitions",
          ),
      ],
  }

fn signal_lines(style: Style, bound: BindingSummary) -> List<String> =
  match bound.signals {
    None -> [],
    Some(g) ->
      [
        indent()
          ++ dim(
            style,
            "shutdown    signals " ++ String::join(g.names, " ") ++ " · "
              ++ (match g.drain {
                Some(d) ->
                  "lead " ++ d.lead_ms.to_string() ++ "ms · drain " ++ d.drain_ms.to_string()
                    ++ "ms, and a second stop signal ends the program with exit status 130 (SIGINT) or 143 (SIGTERM)",
                None ->
                  "child processes are ended on a stop signal, and the program exits with status 130 (SIGINT) or 143 (SIGTERM)",
              }),
          ),
      ],
  }

fn print_error_lines(lines: List<String>, i: Int) -> Unit / {process.err[proc]} =
  if i >= lines.len() { () } else {
    process.err[proc](lines.at_or(i, ""));
    print_error_lines(lines, i + 1)
  }

fn print_disclosures(
  style: Style,
  flags: Flags,
  target: Target,
  bound: BindingSummary,
  resolution: Resolution,
) -> Unit / {process.err[proc], abort.raise} =
  if flags.json { () } else {
    print_error_lines(all_to_text(style, resolution.warnings, places_of(target)), 0);
    if flags.explain {
      print_error_lines(
        binding_lines(style, bound, resolution.configuration).concat(
          program_lines(style, target),
        ).concat(
          signal_lines(style, bound),
        ),
        0,
      )
    }
  }

fn shutdown_deadline_exceeded(diagnostic: Diagnostic) -> Bool = diagnostic.code == b"W0608"

fn timed_out(diagnostic: Diagnostic) -> Bool = machine::is_timed_out(diagnostic.code)

fn expired_of(e: RunOutcome) -> Bool =
  match e.raised { Some(r) -> shutdown_deadline_exceeded(r.diagnostic), None -> false }

fn handshake_lines(style: Style, e: RunOutcome) -> List<String> =
  e.handshakes.map(|line: String| indent() ++ dim(style, line))

fn stopped_line(style: Style, g: StopReport, w: Teardown) -> String =
  indent()
    ++ dim(
      style,
      "stopping    signal " ++ (match g.signal { Some(n) -> n, None -> "none" }) ++ " · lead "
        ++ w.lead_ms.to_string()
        ++ "ms · drain "
        ++ w.drain_ms.to_string()
        ++ "ms · "
        ++ g.listeners.to_string()
        ++ " listener(s) closed · "
        ++ g.connections.to_string()
        ++ " connection(s) in flight",
    )

fn drain_report_line(style: Style, g: StopReport, expired: Bool) -> String =
  indent()
    ++ dim(
      style,
      (if expired { "timed out" } else { "drained  " }) ++ "     " ++ g.elapsed_ms.to_string()
        ++ "ms after the stop signal was received",
    )

fn teardown_line(style: Style, w: Teardown) -> String =
  indent()
    ++ dim(
      style,
      "teardown    " ++ w.spans_left_open.to_string() ++ " span(s) left open · sink flushed",
    )

fn trace_lines(style: Style, e: RunOutcome) -> List<String> =
  match e.trace {
    None -> [],
    Some(c) ->
      [
        indent()
          ++ dim(
            style,
            "trace       " ++ c.events.to_string() ++ " event(s) · " ++ c.spans.to_string()
              ++ " span(s) · "
              ++ c.timed_out.to_string()
              ++ " abandoned · "
              ++ (if c.flushed { "flushed" } else { "not flushed" }),
          ),
      ],
  }

fn stop_lines(style: Style, e: RunOutcome) -> List<String> =
  match e.stopping {
    None -> [],
    Some(g) ->
      [
        stopped_line(style, g, e.teardown),
        drain_report_line(style, g, expired_of(e)),
        teardown_line(style, e.teardown),
      ].concat(
        trace_lines(style, e),
      ),
  }

fn primary_of(diagnostic: Diagnostic) -> Option<Label> = {
  let start: Option<Label> = None;
  diagnostic.labels.fold(start, |accumulator: Option<Label>, label: Label|
    match accumulator {
      Some(_) -> accumulator,
      None -> if label.primary { Some(label) } else { None },
    })
}

fn label_location(places: List<SourceText>, label: Label) -> Option<String> / {abort.raise} =
  if label.module == no_module() { None } else {
    match places.at(label.module) {
      None -> None,
      Some(p) -> {
        let at: Position = position_of(p.text, label.start);
        Some(p.path ++ ":" ++ at.line.to_string() ++ ":" ++ at.column.to_string())
      },
    }
  }

fn raised_at(style: Style, target: Target, diagnostic: Diagnostic) -> List<String> / {abort.raise} =
  if shutdown_deadline_exceeded(diagnostic) || timed_out(diagnostic) { [] } else {
    match primary_of(diagnostic) {
      None -> [],
      Some(l) -> match label_location(places_of(target), l) {
        None -> [],
        Some(at) -> [indent() ++ red(style, "raised at") ++ " " ++ at],
      },
    }
  }

fn target_members(target: Target) -> List<Member> =
  match target {
    Project(p) -> [{ key: "root", value: Str(p.root) }, { key: "files", value: strings(p.files) }],
    Deployed(a) ->
      [
        { key: "artifact", value: Str(a.path) },
        { key: "digest", value: Str(a.digest) },
        { key: "definitions", value: int(a.definition_count) },
      ],
  }

fn shutdown_json(e: RunOutcome) -> Json =
  object([
    { key: "requested", value: Bool(match e.stopping { Some(_) -> true, None -> false }) },
    {
      key: "signal",
      value: match e.stopping { Some(g) -> string_or_null(g.signal), None -> Null },
    },
    { key: "drain_ms", value: int(e.teardown.drain_ms) },
    { key: "drain_lead_ms", value: int(e.teardown.lead_ms) },
    { key: "spans_left_open", value: int(e.teardown.spans_left_open) },
  ])

fn document(
  target: Target,
  entry_name: String,
  resolution: Resolution,
  e: RunOutcome,
  ok: Bool,
  code: Int,
  raised: Option<RuntimeDiagnostic>,
) -> Json / {abort.raise} =
  object(
    [
      { key: "command", value: Str("run") },
      { key: "ok", value: Bool(ok) },
      { key: "exit_code", value: int(code) },
    ].concat(
      target_members(target),
    ).concat([
      { key: "entry", value: Str(entry_name) },
      { key: "module", value: Str(module_of(entry_name)) },
      { key: "runtime_blocks", value: int(e.runtime_blocks) },
      { key: "hosts", value: e.hosts },
      { key: "value", value: match e.value { Some(v) -> Str(render(v)), None -> Null } },
      {
        key: "configuration",
        value: configuration::report_json(configuration::report(resolution.configuration)),
      },
      { key: "shutdown", value: shutdown_json(e) },
      {
        key: "diagnostics",
        value: Array(
          run_warnings(resolution, e).map(|d: Diagnostic| to_json(d, places_of(target))).concat(
            match raised { Some(r) -> [runtime_diagnostic_json(r, places_of(target))], None -> [] },
          ),
        ),
      },
    ]),
  )

fn run_warnings(resolution: Resolution, e: RunOutcome) -> List<Diagnostic> =
  resolution.warnings.concat(e.warnings)

fn explained_end(style: Style, flags: Flags, e: RunOutcome) -> List<String> =
  if flags.explain { handshake_lines(style, e).concat(stop_lines(style, e)) } else { [] }

fn finished(
  style: Style,
  flags: Flags,
  target: Target,
  entry_name: String,
  resolution: Resolution,
  e: RunOutcome,
  code: Int,
) -> CommandOutput / {abort.raise} =
  {
    json: document(target, entry_name, resolution, e, code == ok_code(), code, None),
    lines: [],
    errs: explained_end(style, flags, e).concat(warned_lines(style, e.warnings)),
    code: code,
  }

fn raised(
  style: Style,
  flags: Flags,
  target: Target,
  entry_name: String,
  resolution: Resolution,
  e: RunOutcome,
  r: RuntimeDiagnostic,
) -> CommandOutput / {abort.raise} = {
  let diagnostic = shown(r);
  let code = if shutdown_deadline_exceeded(diagnostic) { drain_incomplete() } else { failed() };
  {
    json: document(target, entry_name, resolution, e, false, code, Some(r)),
    lines: [],
    errs: explained_end(style, flags, e).concat(
      all_to_text(style, [diagnostic], places_of(target)),
    ).concat(
      raised_at(style, target, diagnostic),
    ).concat(
      warned_lines(style, e.warnings),
    ),
    code: code,
  }
}

fn ended(
  style: Style,
  flags: Flags,
  target: Target,
  entry_name: String,
  resolution: Resolution,
  e: RunOutcome,
) -> CommandOutput / {abort.raise} =
  match e.exit {
    Some(code) -> finished(style, flags, target, entry_name, resolution, e, code),
    None -> match e.raised {
      None -> finished(style, flags, target, entry_name, resolution, e, ok_code()),
      Some(r) -> raised(style, flags, target, entry_name, resolution, e, r),
    },
  }

fn unreadable_artifact(
  style: Style,
  path: String,
  reason: Rejection,
) -> CommandOutput / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("run") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: int(compile_error()) },
      { key: "artifact", value: Str(path) },
      { key: "diagnostics", value: all_to_json(reason.diagnostics, reason.places) },
    ]),
    lines: [],
    errs: all_to_text(style, reason.diagnostics, reason.places),
    code: compile_error(),
  }

fn load_error_output(style: Style, reason: Rejection) -> CommandOutput / {abort.raise} =
  match reason.artifact {
    None -> rejected(style, "run", reason.diagnostics, reason.places),
    Some(path) -> unreadable_artifact(style, path, reason),
  }

fn entry_error_output(
  style: Style,
  target: Target,
  diagnostic: Diagnostic,
) -> CommandOutput / {abort.raise} =
  {
    json: object(
      [
        { key: "command", value: Str("run") },
        { key: "ok", value: Bool(false) },
        { key: "exit_code", value: int(compile_error()) },
      ].concat(
        target_members(target),
      ).concat([{ key: "diagnostics", value: all_to_json([diagnostic], places_of(target)) }]),
    ),
    lines: [],
    errs: all_to_text(style, [diagnostic], places_of(target)),
    code: compile_error(),
  }

fn unbound(style: Style, reason: Rejection) -> CommandOutput / {abort.raise} = {
  let tally = indent() ++ red(style, "no host handler was bound") ++ " ("
    ++ count_of(reason.diagnostics.len(), "error")
    ++ ")";
  {
    json: object([
      { key: "command", value: Str("run") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: int(compile_error()) },
      { key: "diagnostics", value: all_to_json(reason.diagnostics, reason.places) },
    ]),
    lines: [],
    errs: all_to_text(style, reason.diagnostics, reason.places).push(tally),
    code: compile_error(),
  }
}

type BoundEntry<| e> = { summary: BindingSummary, enter: () -> RunOutcome / e }

fn bind_and_run<| e>(
  style: Style,
  flags: Flags,
  target: Target,
  entry_name: String,
  config: Result<Resolution, List<Diagnostic>>,
  bind: (String, RunConfiguration) -> Result<BoundEntry<| e>, Rejection> / e,
) -> CommandOutput / {process.err[proc], abort.raise | e} =
  match config {
    Err(diagnostics) ->
      unbound(style, { diagnostics: diagnostics, places: places_of(target), artifact: None }),
    Ok(r) -> match bind(entry_name, configuration::run_configuration(r.configuration)) {
      Err(reason) -> unbound(style, reason),
      Ok(b) -> {
        print_disclosures(style, flags, target, b.summary, r);
        ended(style, flags, target, entry_name, r, (b.enter)())
      },
    },
  }

fn choose_entry<| e>(
  style: Style,
  flags: Flags,
  target: Target,
  config: Result<Resolution, List<Diagnostic>>,
  bind: (String, RunConfiguration) -> Result<BoundEntry<| e>, Rejection> / e,
) -> CommandOutput / {process.err[proc], abort.raise | e} =
  match entry_of(target) {
    Err(d) -> entry_error_output(style, target, d),
    Ok(entry_name) -> bind_and_run(style, flags, target, entry_name, config, bind),
  }

type LoadedTarget = { target: Target, unit: entering::LoadedUnit, runnable: Runnable }

fn configured_over(
  loaded: LoadedTarget,
  options: Options,
) -> Result<Resolution, List<Diagnostic>> / {entering::machine.enter, env.variables, env.working_directory, fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  configuration::resolve_configuration(options.config, |name: String|
    configuration::evaluate_schema_on_unit(
      loaded.unit.unit,
      entries::roots_of(loaded.runnable),
      name,
    ))

fn bind_entry(
  loaded: LoadedTarget,
  options: Options,
  entry_name: String,
  config: RunConfiguration,
  stderr: Bool,
) -> Result<BoundEntry<| {entering::machine.enter, entering::machine.unbind, abort.raise}>, Rejection> / {entering::machine.hosting, entering::machine.bind, abort.raise} = {
  let unheard = machine::run_grants(options, config, machine::PlatformDefault, stderr);
  let declared = loaded.runnable.declared;
  let rejected = |diagnostics: List<Diagnostic>|
    Err({ diagnostics: diagnostics, places: places_of(loaded.target), artifact: None });
  match host_listing::allow_error(unheard.allow, declared) {
    Some(d) -> rejected([d]),
    None -> {
      let hosting = entering::machine.hosting(unheard);
      if hosting.rejections.len() > 0 { rejected(hosting.rejections.map(machine::unplaced)) } else {
        let l = host_listing::listing_of(declared, loaded.runnable.performed);
        let stop = host_listing::shutdown_mode_of(l.rows);
        match entering::machine.bind(machine::run_grants(options, config, stop, stderr)) {
          Err(failures) -> rejected(failures.map(machine::unplaced)),
          Ok(binding) -> {
            let bounds = { lead_ms: options.drain_lead_ms, drain_ms: options.drain_ms };
            let disclosures = host_listing::host_settings_of(l, hosting, config, Some(bounds));
            Ok({
              summary: {
                operations: l.rows.len(),
                digest: host_listing::digest_of(l, disclosures),
                trace: match disclosures.observability {
                  Some(o) -> Some(host_listing::sink_banner(o)),
                  None -> None,
                },
                signals: match stop {
                  machine::PlatformDefault -> None,
                  machine::ExitOnSignal -> Some({ names: hosting.signals, drain: None }),
                  machine::DrainOnSignal -> Some({ names: hosting.signals, drain: Some(bounds) }),
                },
              },
              enter: || entered(loaded, options, entry_name, binding, l, disclosures),
            })
          },
        }
      }
    },
  }
}

fn entered(
  loaded: LoadedTarget,
  options: Options,
  entry_name: String,
  binding: Int,
  l: Listing,
  disclosures: HostSettings,
) -> RunOutcome / {entering::machine.enter, entering::machine.unbind, abort.raise} = {
  let o = entering::machine.enter(loaded.unit.unit, entry_name, machine::arguments_of([]), {
    ..entering::unbounded(),
    binding: binding,
    hosted: true,
    timeout_ms: options.timeout,
    seed: match options.seed {
      Some(s) -> Some({ root: s.root, path: s.path, steps: plan::default_steps() }),
      None -> None,
    },
  });
  let reports = entering::machine.unbind(binding);
  let roots = entries::roots_of(loaded.runnable);
  let result = machine::result_of(o, roots, entry_name);
  {
    exit: o.exit,
    value: if o.exit != None { None } else { match result { Ok(v) -> Some(v), Err(_) -> None } },
    raised: match result { Ok(_) -> None, Err(r) -> Some(r) },
    runtime_blocks: o.usage.runtime_blocks,
    warnings: machine::warnings_of(o, roots),
    stopping: host_listing::report_of(reports, "stopping", machine::stop_report_bin()),
    teardown: {
      lead_ms: options.drain_lead_ms,
      drain_ms: options.drain_ms,
      spans_left_open: host_listing::report_of(reports, "teardown", bin::int_bin()).unwrap_or(0),
    },
    trace: host_listing::report_of(reports, "trace", machine::trace_bin()),
    handshakes: host_listing::handshake_lines(reports),
    hosts: hosts_json(l, disclosures, reports),
  }
}

fn hosts_json(
  l: Listing,
  d: HostSettings,
  reports: List<entering::Report>,
) -> Json / {abort.raise} =
  object(
    [
      { key: "handlers", value: int(l.handlers) },
      { key: "operations", value: int(l.rows.len()) },
      { key: "digest", value: Str(host_listing::digest_of(l, d)) },
    ].concat(match d.transport {
      Some(t) ->
        [
          { key: "transport", value: transport_json(t) },
          { key: "handshakes", value: handshakes_json(reports) },
        ],
      None -> [],
    }).concat(match d.filesystem {
      Some(f) -> [{ key: "filesystem", value: filesystem_json(f) }],
      None -> [],
    }),
  )

fn handshakes_json(reports: List<entering::Report>) -> Json / {abort.raise} = {
  let h = host_listing::report_of(reports, "handshakes", host_listing::handshakes_bin()).unwrap_or(
    { completed: 0, rejected: 0, reasons: [] },
  );
  object([
    { key: "completed", value: int(h.completed) },
    { key: "rejected", value: int(h.rejected) },
    {
      key: "reasons",
      value: Array(
        h.reasons.map(|r: RejectionCount|
          object([{ key: "reason", value: Str(r.reason) }, { key: "count", value: int(r.count) }])),
      ),
    },
  ])
}

pub fn run(
  flags: Flags,
  options: Options,
) -> CommandOutput / {shipped.read_pack, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, MachineAccess, process.err[proc], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variables, env.working_directory, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.compiled, toolchain.reuse_dir, shipped.definitions, shipped.runtime, cost_checker.report, evaluation.verdicts, evaluation.statements, Derives, abort.raise, diverges, shipped.report_view_used} = {
  let s: Style = style_of(flags);
  let named = paths::display_path(root_of(flags));
  if is_artifact(named) {
    match config_schema::name_error(options.config.schema) {
      Some(d) -> unbound(s, { diagnostics: [d], places: [], artifact: None }),
      None -> match signer_rejection(flags) {
        Some(d) ->
          unreadable_artifact(s, named, { diagnostics: [d], places: [], artifact: Some(named) }),
        None ->
          run_loaded(
            s,
            flags,
            options,
            deployed_target(named, artifact_bytes(flags), options.profile),
            None,
          ),
      },
    }
  } else { run_sources(s, flags, options) }
}

fn deployed_target(
  path: String,
  bytes: Option<Bytes>,
  profile: cc::Profile,
) -> Result<LoadedTarget, Rejection> / {entering::machine.open, emit.compiled, shipped.definitions, toolchain.read, toolchain.write, abort.raise} =
  if path.ends_with(".plyz") { Err({ diagnostics: [a_library(path)], places: [], artifact: None }) }
  else {
    let rejected = |d: List<Diagnostic>| Err({ diagnostics: d, places: [], artifact: Some(path) });
    match bytes {
      None -> rejected([artifact_builder::unreadable(path)]),
      Some(b) -> match artifact_builder::open_artifact(path, b) {
        Err(d) -> rejected([d]),
        Ok(o) -> match units::cached_library(o.unit, profile) {
          Err(diagnostics) -> rejected(diagnostics),
          Ok(library) -> match entering::machine.open(library) {
            Err(reason) -> rejected([machine::unit_load_error(reason)]),
            Ok(unit) ->
              Ok({
                target: Deployed({
                  path: path,
                  digest: o.digest,
                  entry: o.entry,
                  definition_count: o.definitions,
                }),
                unit: unit,
                runnable: o.runnable,
              }),
          },
        },
      },
    }
  }

fn a_library(path: String) -> Diagnostic =
  error_at(
    b"E0443",
    no_module(),
    dummy_span(),
    Bytes::of_string("`" ++ path ++ "` is a library, and nothing to run"),
    b"not a program",
    [
      b"a `.plyz` is a package: declare it in a `ply.pkg` and depend on it",
      b"`ply build` writes a program's artifact as a `.plyx`",
    ],
  )

fn artifact_bytes(flags: Flags) -> Option<Bytes> / {fs.read_file[cwd], fs.read_file[abs]} =
  match flags.paths.at(0) { Some(r) -> paths::read_file(paths::rooted(r)), None -> None }

fn untrusted_artifact(path: String, reason: String) -> Diagnostic =
  error_at(
    b"E0460",
    no_module(),
    dummy_span(),
    Bytes::of_string("the artifact `" ++ path ++ "` " ++ reason),
    b"not signed by a key `--require-signer` trusts",
    [
      b"`ply build --sign KEY` signs what it builds, in `<artifact>.sig` beside it; `--require-signer` names the public key files a run trusts",
    ],
  )

fn trusted_keys(
  files: List<String>,
) -> Result<List<Bytes>, Diagnostic> / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  files.fold(Ok([]), |accumulator: Result<List<Bytes>, Diagnostic>, path: String|
    match accumulator {
      Err(d) -> Err(d),
      Ok(keys) -> match paths::read_file(paths::rooted_path(path)) {
        None -> Err(unreadable_key(path, "cannot be read")),
        Some(b) -> match public_of(String::of_bytes_lossy(b)) {
          Ok(k) -> Ok(keys.push(k)),
          Err(reason) -> Err(unreadable_key(path, "does not contain a public key: " ++ reason)),
        },
      },
    })

fn signatures_of(flags: Flags) -> Option<Bytes> / {fs.read_file[cwd], fs.read_file[abs]} =
  match flags.paths.at(0) {
    Some(r) -> {
      let at = paths::rooted(r);
      paths::read_file({ ..at, path: signatures_path(at.path) })
    },
    None -> None,
  }

fn signer_rejection(
  flags: Flags,
) -> Option<Diagnostic> / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  if flags.signers.len() == 0 { None } else {
    let path = paths::display_path(root_of(flags));
    match trusted_keys(flags.signers) {
      Err(d) -> Some(d),
      Ok(keys) -> match artifact_bytes(flags) {
        None -> None,
        Some(bytes) -> {
          let into = if path.ends_with(".plyz") { library_domain() } else { domain() };
          let digest = match digest_of(into, bytes) { Some(d) -> digest_text(d), None -> "" };
          match signatures_of(flags) {
            None ->
              Some(
                untrusted_artifact(
                  path,
                  "carries no signatures: `" ++ signatures_path(path) ++ "` is not there",
                ),
              ),
            Some(b) -> match decode_signed(b) {
              None ->
                Some(
                  untrusted_artifact(path, "has a signature file next to it that cannot be parsed"),
                ),
              Some(g) -> match provenance_of(g.payload) {
                None ->
                  Some(
                    untrusted_artifact(
                      path,
                      "has a signature file next to it, but the signatures do not cover a build record",
                    ),
                  ),
                Some(what) -> if what.digest != digest {
                  Some(
                    untrusted_artifact(
                      path,
                      "is " ++ digest ++ ", and its signatures vouch for " ++ what.digest,
                    ),
                  )
                } else {
                  match trusted_signer(g, keys) {
                    Some(_) -> None,
                    None ->
                      Some(
                        untrusted_artifact(path, "is signed by no key `--require-signer` names"),
                      ),
                  }
                },
              },
            },
          }
        },
      },
    }
  }

fn is_artifact(path: String) -> Bool = path.ends_with(".plyx") || path.ends_with(".plyz")

fn built_product(
  flags: Flags,
  options: Options,
) -> String / {shipped.runtime, shipped.definitions, abort.raise} =
  "built "
    ++ String::of_bytes_lossy(
      product_key(
        Bytes::of_string(
          String::join(
            [options.profile.name, match options.config.schema { Some(s) -> s, None -> "" }].concat(
              flags.paths.map(|r: paths::ResolvedPath| r.display),
            ),
            "\n",
          ),
        ),
      ),
    )

fn may_reuse_library(flags: Flags) -> Bool = !flags.explain && !flags.verify_dependencies

type StoredPlace = { path: String, module: String }

type StoredRun = {
  library: String,
  root: String,
  places: List<StoredPlace>,
  mains: List<Main>,
  modules: List<Module>,
  runnable: Runnable,
}

derive bin for StoredPlace

derive bin for StoredRun

fn stored_target(
  stored: StoredRun,
  project: Project,
) -> Target / {fs.read_file[shipped], abort.raise} = {
  let own = project.files.concat(project.packages.flat_map(|p: DependencyPackage| p.files)).fold(
    Map::new(),
    |texts: Map<String, Bytes>, f: File| texts.insert(f.module, f.text),
  );
  program_of(
    {
      root: stored.root,
      files: stored.places.map(|p: StoredPlace| p.path),
      places: stored.places.map(|p: StoredPlace|
        {
          path: p.path,
          text: match own.get(p.module) {
            Some(text) -> text,
            None -> match shipped_text(Bytes::of_string(p.module)) {
              Some(text) -> text,
              None -> b"",
            },
          },
        }),
    },
    stored.mains,
    stored.modules,
  )
}

fn stored_run_of(value: Bytes) -> Option<StoredRun> / {abort.raise} =
  match bin::decode(value, stored_run_bin()) { Ok(stored) -> Some(stored), Err(_) -> None }

fn run_sources(
  style: Style,
  flags: Flags,
  options: Options,
) -> CommandOutput / {shipped.read_pack, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, MachineAccess, process.err[proc], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variables, env.working_directory, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.compiled, toolchain.reuse_dir, cost_checker.report, evaluation.verdicts, evaluation.statements, Derives, abort.raise, diverges, shipped.report_view_used} = {
  let product = built_product(flags, options);
  let current = if may_reuse_library(flags) { product_unchanged(flags.paths, product) }
  else { None };
  let reopened = match current {
    None -> None,
    Some(c) -> match stored_run_of(c.value) {
      None -> None,
      Some(stored) -> match entering::machine.open(stored.library) {
        Err(_) -> None,
        Ok(unit) ->
          Some({
            target: stored_target(stored, c.clean.project),
            unit: unit,
            runnable: stored.runnable,
          }),
      },
    },
  };
  match reopened {
    Some(t) -> run_loaded(style, flags, options, Ok(t), None),
    None -> built_sources(style, flags, options, product),
  }
}

fn built_sources(
  style: Style,
  flags: Flags,
  options: Options,
  product: String,
) -> CommandOutput / {shipped.read_pack, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, MachineAccess, process.err[proc], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.variables, env.working_directory, fs.resolved_kind[cwd], fs.resolved_kind[abs], emit.unit, emit.compiled, toolchain.reuse_dir, cost_checker.report, evaluation.verdicts, evaluation.statements, Derives, abort.raise, diverges, shipped.report_view_used} = {
  let t: TimedLoad = timed_load(flags.paths, flags.verify_dependencies);
  match program_view(t.program) {
    None ->
      load_error_output(style, {
        diagnostics: t.program.diagnostics,
        places: t.program.source_texts,
        artifact: None,
      }),
    Some(w) -> match config_schema::schema_error(w, options.config.schema) {
      Some(d) ->
        unbound(style, { diagnostics: [d], places: t.program.source_texts, artifact: None }),
      None -> match reuse_violations(t.program, w.frame) {
        [] -> match evaluation_errors(t, w.frame) {
          [] -> loaded_built(style, flags, options, t, w, product),
          rejected ->
            load_error_output(style, {
              diagnostics: rejected,
              places: t.program.source_texts,
              artifact: None,
            }),
        },
        broken ->
          load_error_output(style, {
            diagnostics: broken,
            places: t.program.source_texts,
            artifact: None,
          }),
      },
    },
  }
}

fn loaded_built(
  style: Style,
  flags: Flags,
  options: Options,
  timed: TimedLoad,
  view: CheckedProgram,
  product: String,
) -> CommandOutput / {shipped.read_pack, fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], time.elapsed_ms, MachineAccess, process.err[proc], env.variables, env.working_directory, fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.read_file[cwd], fs.read_file[abs], emit.unit, emit.compiled, fs.write[abs], Derives, abort.raise} = {
  let load_started_ms = time.elapsed_ms();
  let front = loaded_analysis(timed, view);
  let offered = entries::narrowed_to(entries::of_front(front), flags.paths);
  let target = program_of(
    {
      root: machine::project_root(root_of(flags).machine),
      files: front.files.map(|f: SourceFile| f.path),
      places: front.files.map(|f: SourceFile| { path: f.path, text: f.text }),
    },
    offered.mains,
    offered.modules,
  );
  let timing = ||
    {
      read_ms: timed.read_ms,
      front_end_ms: timed.front_end_ms,
      store_ms: timed.store_ms,
      load_ms: time.elapsed_ms() - load_started_ms,
    };
  match entry_of(target) {
    Err(d) -> with_timing(style, flags, Some(timing()), || entry_error_output(style, target, d)),
    Ok(entry_name) -> {
      let emitted = units::entered_library(
        front,
        view.frame.hashes,
        entered_by(entry_name, options),
        options.profile,
      );
      let runnable = entries::runnable_of(front);
      let rejected = |diagnostics: List<Diagnostic>|
        Err({ diagnostics: diagnostics, places: timed.program.source_texts, artifact: None });
      let loaded = match emitted {
        Err(diagnostics) -> rejected(diagnostics),
        Ok(library) -> match entering::machine.open(library) {
          Err(reason) -> rejected([machine::unit_load_error(reason)]),
          Ok(unit) -> {
            if may_reuse_library(flags) {
              store_product_at(
                flags.paths,
                timed.program.log_position,
                product,
                bin::encode(
                  {
                    library: library,
                    root: machine::project_root(root_of(flags).machine),
                    places: front.files.map(|f: SourceFile| { path: f.path, module: f.name }),
                    mains: offered.mains,
                    modules: offered.modules,
                    runnable: runnable,
                  },
                  stored_run_bin(),
                ),
              )
            };
            Ok({ target: target, unit: unit, runnable: runnable })
          },
        },
      };
      run_loaded(style, flags, options, loaded, Some(timing()))
    },
  }
}

fn entered_by(entry_name: String, options: Options) -> List<Bytes> =
  [entry_name].concat(match options.config.schema { Some(s) -> [s], None -> [] }).map(
    |name: String| Bytes::of_string(name),
  )

fn run_loaded(
  style: Style,
  flags: Flags,
  options: Options,
  loaded: Result<LoadedTarget, Rejection>,
  l: Option<LoadTiming>,
) -> CommandOutput / {MachineAccess, process.err[proc], env.variables, env.working_directory, fs.resolved_kind[cwd], fs.resolved_kind[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match loaded {
    Err(reason) -> load_error_output(style, reason),
    Ok(t) -> {
      let result = run_target(
        style,
        flags,
        Ok(t.target),
        configured_over(t, options),
        |entry_name: String, config: RunConfiguration|
          bind_entry(t, options, entry_name, config, flags.json),
        l,
      );
      entering::machine.close(t.unit.unit);
      result
    },
  }

fn run_target<| e>(
  style: Style,
  flags: Flags,
  target: Result<Target, Rejection>,
  config: Result<Resolution, List<Diagnostic>>,
  bind: (String, RunConfiguration) -> Result<BoundEntry<| e>, Rejection> / e,
  l: Option<LoadTiming>,
) -> CommandOutput / {process.err[proc], abort.raise | e} =
  match target {
    Err(reason) -> load_error_output(style, reason),
    Ok(t) -> with_timing(style, flags, l, || choose_entry(style, flags, t, config, bind)),
  }

fn with_timing<| e>(
  style: Style,
  flags: Flags,
  l: Option<LoadTiming>,
  output: () -> CommandOutput / e,
) -> CommandOutput / {process.err[proc], abort.raise | e} =
  match l {
    None -> output(),
    Some(loading) -> {
      if flags.explain && !flags.json { process.err[proc](load_timing_line(style, loading)) };
      with_load_timing(flags, loading, output())
    },
  }

type LoadTiming = { read_ms: Int, front_end_ms: Int, store_ms: Int, load_ms: Int }

fn millis(n: Int) -> String = n.to_string() ++ "ms"

fn load_timing_line(style: Style, l: LoadTiming) -> String / {abort.raise} =
  indent()
    ++ dim(
      style,
      "front end   "
        ++ String::join(
          [
            "read " ++ millis(l.read_ms),
            "front " ++ millis(l.front_end_ms),
            "write back " ++ millis(l.store_ms),
            "load " ++ millis(l.load_ms),
          ],
          " · ",
        ),
    )

fn load_timing_json(l: LoadTiming) -> Json =
  object([
    {
      key: "phases",
      value: object([
        { key: "read", value: int(l.read_ms) },
        { key: "front", value: int(l.front_end_ms) },
        { key: "write_back", value: int(l.store_ms) },
        { key: "load", value: int(l.load_ms) },
      ]),
    },
  ])

fn with_load_timing(flags: Flags, l: LoadTiming, result: CommandOutput) -> CommandOutput =
  if !(flags.explain && flags.json) { result } else {
    match result.json {
      Object(members) ->
        { ..result, json: Object(members.insert("front_end", load_timing_json(l))) },
      _ -> result,
    }
  }

fn a_main() -> Main =
  { name: "m.main", module: "m", path: "m.ply", at: { module: 0, start: 3, end: 7 } }

fn example_project() -> Target =
  Project({
    root: "/p",
    files: ["m.ply"],
    source_texts: [{ path: "m.ply", text: b"fn main() -> Int = 42\n" }],
    mains: [a_main()],
    modules: [{ name: "m", path: "m.ply", at: { module: 0, start: 22, end: 22 } }],
  })

fn an_artifact() -> Target =
  Deployed({ path: "m.plyx", digest: "b3:1f2e3d4c5b6a", entry: "m.main", definition_count: 3 })

fn empty_binding() -> BindingSummary = { operations: 0, digest: "", trace: None, signals: None }

fn a_binding() -> BindingSummary =
  {
    operations: 7,
    digest: "b3:aabbccddeeff",
    trace: Some("json on stderr · info"),
    signals: Some({ names: ["SIGINT", "SIGTERM"], drain: Some({ lead_ms: 0, drain_ms: 30000 }) }),
  }

fn no_teardown() -> Teardown = { lead_ms: 0, drain_ms: 30000, spans_left_open: 0 }

fn returned_value(value: Value) -> RunOutcome =
  {
    exit: None,
    value: Some(value),
    raised: None,
    runtime_blocks: 0,
    warnings: [],
    stopping: None,
    teardown: no_teardown(),
    trace: None,
    handshakes: [],
    hosts: Null,
  }

fn raised_without_values(diagnostic: Diagnostic) -> RuntimeDiagnostic =
  { diagnostic: diagnostic, values: [] }

fn a_diagnostic(code: Bytes, message: Bytes, labels: List<Label>) -> Diagnostic =
  {
    code: code,
    notes: 0,
    labels: labels,
    text: b"",
    message: message,
    notes_text: [],
    severity: b"error",
    fixes: [],
  }

fn no_rejection() -> Rejection = { diagnostics: [], places: [], artifact: None }

type RunCapture = { result: CommandOutput, err: List<String> }

fn run_fixture(
  flags: Flags,
  t: Result<Target, Rejection>,
  b: Result<BindingSummary, Rejection>,
  e: RunOutcome,
) -> RunCapture / {abort.raise} = run_fixture_loaded(flags, t, Ok(unconfigured()), b, e, None)

fn unconfigured() -> Resolution =
  { configuration: configuration::closed_configuration(), warnings: [] }

fn configured_service() -> Resolution / {abort.raise} =
  match configuration::sources_of([], [], [
      { name: "PORT", value: "8137" },
      { name: "TOKEN", value: "t" },
    ]) {
    Err(_) -> panic("the fixture's sources read"),
    Ok(sources) -> match configuration::resolved(
        sources,
        Some({
          function: "m.spec",
          keys: [
            { name: "PORT", shape: SInt, required: true, default: None },
            { name: "TOKEN", shape: SSecret, required: true, default: None },
          ],
        }),
      ) {
      Err(_) -> panic("the fixture resolves"),
      Ok(r) -> r,
    },
  }

fn run_fixture_loaded(
  flags: Flags,
  t: Result<Target, Rejection>,
  config: Result<Resolution, List<Diagnostic>>,
  b: Result<BindingSummary, Rejection>,
  e: RunOutcome,
  l: Option<LoadTiming>,
) -> RunCapture / {abort.raise} =
  handle {
    run_target(
      plain(),
      flags,
      t,
      config,
      |entry_name: String, config: RunConfiguration|
        match b { Ok(bound) -> Ok({ summary: bound, enter: || e }), Err(reason) -> Err(reason) },
      l,
    )
  } with {
    var io = captured([]),
    process.err[proc](text) -> {
      io = err_step(io, text);
    },
    return result -> { result: result, err: io.err },
  }

fn bare() -> Flags / {abort.raise} = from_argv("run", [])

fn json_flags() -> Flags / {abort.raise} = from_argv("run", ["--json"])

test "a run whose entry returns a value prints nothing, not even the value, and exits 0" {
  let ran = run_fixture(bare(), Ok(example_project()), Ok(a_binding()), returned_value(VInt(42)));
  assert_eq(ran.result.code, 0);
  assert_eq(ran.result.lines, []);
  assert_eq(ran.result.errs, []);
  assert_eq(ran.err, [])
}

test "the `--json` output of a run contains `command`, `exit_code`, the entry, its module, the value, the root and the files" {
  let text = to_string(
    run_fixture(
      json_flags(),
      Ok(example_project()),
      Ok(empty_binding()),
      returned_value(VInt(42)),
    ).result.json,
  );
  assert(text.contains("\"command\":\"run\""));
  assert(text.contains("\"exit_code\":0"));
  assert(text.contains("\"entry\":\"m.main\""));
  assert(text.contains("\"module\":\"m\""));
  assert(text.contains("\"value\":\"42\""));
  assert(text.contains("\"root\":\"/p\""));
  assert(text.contains("\"files\":[\"m.ply\"]"))
}

test "under `--explain` a run prints the host bindings, config and shutdown settings to stderr before the entry starts" {
  let ran = run_fixture_loaded(
    explain_flags(),
    Ok(example_project()),
    Ok(configured_service()),
    Ok(a_binding()),
    returned_value(VInt(42)),
    None,
  );
  assert_eq(ran.err, [
    "   host: 7 operations · b3:aabbccddeeff",
    "   config      2 keys · 2 environment · 1 secret (values not shown)",
    "   trace       json on stderr · info",
    "   shutdown    signals SIGINT SIGTERM · lead 0ms · drain 30000ms, and a second stop signal ends the program with exit status 130 (SIGINT) or 143 (SIGTERM)",
  ]);
  assert_eq(ran.result.lines, [])
}

test "under `--explain` a run that exits immediately on a signal says so on stderr before the entry starts" {
  let ending = { ..a_binding(), signals: Some({ names: ["SIGINT", "SIGTERM"], drain: None }) };
  let ran = run_fixture(
    explain_flags(),
    Ok(example_project()),
    Ok(ending),
    returned_value(VInt(42)),
  );
  assert_eq(
    ran.err.at_or(ran.err.len() - 1, ""),
    "   shutdown    signals SIGINT SIGTERM · child processes are ended on a stop signal, and the program exits with status 130 (SIGINT) or 143 (SIGTERM)",
  )
}

test "with `--json` a run writes only the JSON object to stdout and nothing to stderr" {
  let ran = run_fixture(
    json_flags(),
    Ok(example_project()),
    Ok(a_binding()),
    returned_value(VInt(42)),
  );
  assert_eq(ran.err, []);
  assert(to_string(ran.result.json).contains("\"value\":\"42\""))
}

test "under `--explain` a run that uses no host operations prints no binding information, because it can use none" {
  let ran = run_fixture(
    explain_flags(),
    Ok(example_project()),
    Ok(empty_binding()),
    returned_value(VUnit),
  );
  assert_eq(ran.err, [])
}

test "a run that raises an error exits 1 and prints the error with its file, line and column" {
  let raise = {
    ..returned_value(VInt(42)),
    value: None,
    raised: Some(
      raised_without_values(
        a_diagnostic(b"E0501", b"nope", [
          { module: 0, start: 19, end: 21, primary: true, text: b"here" },
        ]),
      ),
    ),
  };
  let ran = run_fixture(bare(), Ok(example_project()), Ok(empty_binding()), raise);
  assert_eq(ran.result.code, 1);
  assert_eq(ran.result.lines, []);
  assert_eq(ran.result.errs.at_or(0, ""), "Error[E0501]: nope");
  assert_eq(ran.result.errs.at_or(ran.result.errs.len() - 1, ""), "   raised at m.ply:1:20")
}

test "a raised error shows its values in place of the placeholders in its message, in both stderr and the `--json` output" {
  let raise = {
    ..returned_value(VInt(42)),
    value: None,
    raised: Some({
      diagnostic: a_diagnostic(b"E0501", b"expected \x010\x02", []),
      values: [VInt(3)],
    }),
  };
  let ran = run_fixture(bare(), Ok(example_project()), Ok(empty_binding()), raise);
  assert_eq(ran.result.errs.at_or(0, ""), "Error[E0501]: expected 3");
  let text = to_string(
    run_fixture(json_flags(), Ok(example_project()), Ok(empty_binding()), raise).result.json,
  );
  assert(text.contains("\"message\":\"expected 3\""));
  assert(text.contains("\"values\":[\"3\"]"))
}

test "a run whose shutdown deadline expired exits 3 and prints an error with no source line or column" {
  let expired = {
    ..returned_value(VUnit),
    value: None,
    raised: Some(raised_without_values(a_diagnostic(b"W0608", b"the drain deadline expired", []))),
  };
  let ran = run_fixture(bare(), Ok(example_project()), Ok(a_binding()), expired);
  assert_eq(ran.result.code, 3);
  assert_eq(ran.result.errs.filter(|l: String| l.contains("raised at")).len(), 0)
}

test "a program that chose its own exit code exits with that code and no value" {
  let chose = { ..returned_value(VUnit), exit: Some(7), value: None };
  let ran = run_fixture(bare(), Ok(example_project()), Ok(empty_binding()), chose);
  assert_eq(ran.result.code, 7);
  assert_eq(ran.result.lines, []);
  let text = to_string(
    run_fixture(json_flags(), Ok(example_project()), Ok(empty_binding()), chose).result.json,
  );
  assert(text.contains("\"exit_code\":7"));
  assert(text.contains("\"ok\":false"));
  assert(text.contains("\"value\":null"))
}

test "under `--explain` a run stopped by a signal prints its TLS handshake counts, open listeners and connections, shutdown time and unfinished spans" {
  let stopped = {
    ..returned_value(VUnit),
    stopping: Some({ signal: Some("SIGTERM"), listeners: 1, connections: 2, elapsed_ms: 40 }),
    teardown: { ..no_teardown(), spans_left_open: 1 },
    trace: Some({ events: 9, spans: 4, timed_out: 2, flushed: true }),
    handshakes: ["handshakes: 1 completed, 0 rejected"],
  };
  let ran = run_fixture(explain_flags(), Ok(example_project()), Ok(a_binding()), stopped);
  assert_eq(ran.result.lines, []);
  assert_eq(ran.result.errs, [
    "   handshakes: 1 completed, 0 rejected",
    "   stopping    signal SIGTERM · lead 0ms · drain 30000ms · 1 listener(s) closed · 2 connection(s) in flight",
    "   drained       40ms after the stop signal was received",
    "   teardown    1 span(s) left open · sink flushed",
    "   trace       9 event(s) · 4 span(s) · 2 abandoned · flushed",
  ]);
  assert_eq(run_fixture(bare(), Ok(example_project()), Ok(a_binding()), stopped).result.errs, [])
}

test "the `--json` shutdown block reports the same number of unfinished spans as the warning about them" {
  let finished = {
    ..returned_value(VInt(3)),
    warnings: [left_open()],
    teardown: { ..no_teardown(), spans_left_open: 2 },
  };
  let text = to_string(
    run_fixture(json_flags(), Ok(example_project()), Ok(empty_binding()), finished).result.json,
  );
  assert(text.contains("\"spans_left_open\":2"))
}

fn left_open() -> Diagnostic =
  {
    ..a_diagnostic(b"W0609", b"2 spans were still open when their task or the entry point ended: `reserving` on `orders`, `order` on `orders`", []),
    notes: 1,
    notes_text: [b"each was closed `Abandoned` and written"],
    severity: b"warning",
  }

fn warned_of_spans() -> List<String> =
  [
    "",
    "   warning: 2 spans were still open when their task or the entry point ended: `reserving` on `orders`, `order` on `orders`",
    "     = each was closed `Abandoned` and written",
  ]

test "a run whose entry leaves spans unfinished prints a warning on stderr but still exits 0" {
  let finished = { ..returned_value(VInt(3)), warnings: [left_open()] };
  let ran = run_fixture(bare(), Ok(example_project()), Ok(empty_binding()), finished);
  assert_eq(ran.result.code, 0);
  assert_eq(ran.result.lines, []);
  assert_eq(ran.result.errs, warned_of_spans());
  let text = to_string(
    run_fixture(json_flags(), Ok(example_project()), Ok(empty_binding()), finished).result.json,
  );
  assert(text.contains("\"code\":\"W0609\""));
  assert(text.contains("\"exit_code\":0"))
}

test "a raised error that leaves spans unfinished prints the error first, then where it was raised, then the span warning" {
  let finished = {
    ..returned_value(VUnit),
    value: None,
    raised: Some(
      raised_without_values(
        a_diagnostic(b"E0502", b"boom", [
          { module: 0, start: 19, end: 21, primary: true, text: b"here" },
        ]),
      ),
    ),
    warnings: [left_open()],
  };
  let ran = run_fixture(bare(), Ok(example_project()), Ok(empty_binding()), finished);
  assert_eq(ran.result.code, 1);
  let errs = ran.result.errs;
  assert_eq(errs.at_or(0, ""), "Error[E0502]: boom");
  assert_eq(errs.at_or(errs.len() - 4, ""), "   raised at m.ply:1:20");
  assert_eq(range(errs.len() - 3, errs.len()).map(|i: Int| errs.at_or(i, "")), warned_of_spans())
}

test "running an artifact reports the artifact file, its digest and its definition count" {
  let ran = run_fixture(
    explain_flags(),
    Ok(an_artifact()),
    Ok(empty_binding()),
    returned_value(VInt(42)),
  );
  assert_eq(ran.err, ["   program b3:1f2e3d4c5b6a · 3 definitions"]);
  let text = to_string(
    run_fixture(
      json_flags(),
      Ok(an_artifact()),
      Ok(empty_binding()),
      returned_value(VInt(42)),
    ).result.json,
  );
  assert(text.contains("\"artifact\":\"m.plyx\""));
  assert(text.contains("\"digest\":\"b3:1f2e3d4c5b6a\""));
  assert(text.contains("\"definitions\":3"));
  assert(text.contains("\"entry\":\"m.main\""))
}

test "a program that fails to load exits 2 and prints the load's error followed by the error count" {
  let reason: Rejection = {
    diagnostics: [a_diagnostic(b"E0201", b"type mismatch", [])],
    places: [],
    artifact: None,
  };
  let ran = run_fixture(bare(), Err(reason), Err(no_rejection()), returned_value(VUnit));
  assert_eq(ran.result.code, 2);
  assert_eq(ran.result.lines, []);
  assert_eq(ran.result.errs, [
    "Error[E0201]: type mismatch",
    indent() ++ "compilation failed (1 error)",
  ])
}

test "a file that is not an artifact exits 2 with an error about the file and no error count" {
  let reason: Rejection = {
    diagnostics: [a_diagnostic(b"E0443", b"not a program at all", [])],
    places: [],
    artifact: Some("junk.plyx"),
  };
  let text = to_string(
    run_fixture(json_flags(), Err(reason), Err(no_rejection()), returned_value(VUnit)).result.json,
  );
  assert(text.contains("\"artifact\":\"junk.plyx\""));
  assert(text.contains("\"E0443\""));
  let ran = run_fixture(bare(), Err(reason), Err(no_rejection()), returned_value(VUnit));
  assert_eq(ran.result.code, 2);
  assert_eq(ran.result.errs, ["Error[E0443]: not a program at all"])
}

test "a program with no `main` is rejected with exit 2 and an error about its files, before any host handlers are attached" {
  let empty = Project({
    root: "/p",
    files: ["m.ply"],
    source_texts: [],
    mains: [],
    modules: [{ name: "m", path: "m.ply", at: { module: 0, start: 18, end: 18 } }],
  });
  let ran = run_fixture(json_flags(), Ok(empty), Err(no_rejection()), returned_value(VUnit));
  assert_eq(ran.result.code, 2);
  let text = to_string(ran.result.json);
  assert(text.contains("\"root\":\"/p\""));
  assert(text.contains("\"E0101\""))
}

test "host handlers that do not match the program make the run exit 2 with an error that names no source line" {
  let reason: Rejection = {
    diagnostics: [a_diagnostic(b"E0412", b"a nondet effect in a det test", [])],
    places: [],
    artifact: None,
  };
  let ran = run_fixture(bare(), Ok(example_project()), Err(reason), returned_value(VUnit));
  assert_eq(ran.result.code, 2);
  assert_eq(ran.result.errs, [
    "Error[E0412]: a nondet effect in a det test",
    indent() ++ "no host handler was bound (1 error)",
  ]);
  assert(
    to_string(
      run_fixture(
        json_flags(),
        Ok(example_project()),
        Err(reason),
        returned_value(VUnit),
      ).result.json,
    ).contains(
      "\"exit_code\":2",
    ),
  )
}

test "the blocks a run took through the runtime are reported as a count" {
  let text = to_string(
    run_fixture(json_flags(), Ok(example_project()), Ok(empty_binding()), {
      ..returned_value(VInt(42)),
      runtime_blocks: 7,
    }).result.json,
  );
  assert(text.contains("\"runtime_blocks\":7"))
}

test "a definition's module is its name without its own last segment" {
  assert_eq(module_of("m.main"), "m");
  assert_eq(module_of("store.orders.main"), "store.orders")
}

fn a_load_timing() -> LoadTiming = { read_ms: 7, front_end_ms: 1774, store_ms: 44, load_ms: 1392 }

fn explain_flags() -> Flags / {abort.raise} = from_argv("run", ["--explain"])

fn loaded(flags: Flags, l: LoadTiming) -> RunCapture / {abort.raise} =
  run_fixture_loaded(
    flags,
    Ok(example_project()),
    Ok(unconfigured()),
    Ok(a_binding()),
    returned_value(VInt(42)),
    Some(l),
  )

test "a run that reports load timing gives the same result as one that does not" {
  assert_eq(
    loaded(bare(), a_load_timing()),
    run_fixture(bare(), Ok(example_project()), Ok(a_binding()), returned_value(VInt(42))),
  )
}

test "`--explain` says how long each step of the load took" {
  let explained = loaded(explain_flags(), a_load_timing());
  assert_eq(
    explained.err.at_or(0, ""),
    "   front end   read 7ms · front 1774ms · write back 44ms · load 1392ms",
  );
  assert_eq(explained.err.at_or(1, ""), "   host: 7 operations · b3:aabbccddeeff");
  assert_eq(loaded(bare(), a_load_timing()).err, []);
  assert_eq(explained.result, loaded(bare(), a_load_timing()).result)
}

test "`--json --explain` puts the front end details in the JSON document and prints nothing to stderr" {
  let ran = loaded(from_argv("run", ["--json", "--explain"]), a_load_timing());
  assert_eq(ran.err, []);
  let text = to_string(ran.result.json);
  assert(
    text.contains(
      "\"front_end\":{\"phases\":{\"front\":1774,\"load\":1392,\"read\":7,\"write_back\":44}}",
    ),
  );
  assert(!to_string(loaded(json_flags(), a_load_timing()).result.json).contains("front_end"))
}

test "a program that fails to load prints no front end timing under `--explain` and exits 2" {
  let reason: Rejection = {
    diagnostics: [a_diagnostic(b"E0201", b"type mismatch", [])],
    places: [],
    artifact: None,
  };
  let ran = run_fixture_loaded(
    explain_flags(),
    Err(reason),
    Ok(unconfigured()),
    Err(no_rejection()),
    returned_value(VUnit),
    Some(a_load_timing()),
  );
  assert_eq(ran.err, []);
  assert_eq(ran.result.code, 2)
}

test "a run enters its entry, and the function `--config-schema` names" {
  let options = machine::default_options();
  assert_eq(entered_by("m.main", options), [b"m.main"]);
  assert_eq(
    entered_by("m.main", { ..options, config: { ..options.config, schema: Some("m.spec") } }),
    [b"m.main", b"m.spec"],
  )
}
