fn selected_claims(collection: Collection, flags: Flags) -> List<Int> / {abort.raise} = {
  let modules = module_names(collection.modules);
  let claims = collection.claims;
  range(0, claims.len()).fold([], |accumulator: List<Int>, i: Int|
    match claims.at(i) {
      None -> accumulator,
      Some(c) -> {
        let module = match collection.modules.at(c.at.module) {
          Some(m) -> String::of_bytes_lossy(m),
          None -> "",
        };
        if matches_filters(flags.filters, modules, module, c.owner) { accumulator.push(i) }
        else { accumulator }
      },
    })
}

fn internal_errors_word(rows: List<Row>) -> String / {abort.raise} =
  count_of(count_internal_errors(rows), "internal error") ++ " in Ply"

fn detail_lines(style: Style, row: Row) -> List<String> =
  match row.outcome {
    Refuted(context) ->
      [
        detail_indent() ++ quantifier(row.claim, context.bindings) ++ "  →  "
          ++ bindings_text(context.bindings),
        detail_indent() ++ dim(style, "frame: " ++ frame_summary(row.claim.frame)),
      ].concat(
        schema_lines(style, row.claim),
      ),
    Unproved(reason) -> match reason {
      Raised(raise) -> if raise.bindings.len() == 0 { [] } else {
        [
          detail_indent()
            ++ dim(style, "the code can abort with `raise` at " ++ bindings_text(raise.bindings)),
        ]
      },
      Open(o) -> o.stopped.map(|s: Stopped| detail_indent() ++ dim(style, stopped_summary(s))),
      _ -> [],
    },
    InternalError(f) -> if f.bindings.len() == 0 { [] }
    else { [detail_indent() ++ dim(style, "at " ++ bindings_text(f.bindings))] },
    _ -> [],
  }

fn weakened_frame(claim: Claim) -> List<String> / {abort.raise} =
  match claim.kind {
    Ensures(_) -> if claim.unused_effects.len() == 0 { [] } else {
      fill(
        "the claim allows effects that the body never uses: ",
        "  ",
        claim.unused_effects,
        "",
        width() - detail_indent().len(),
      )
    },
    _ -> [],
  }

fn schema_lines(style: Style, claim: Claim) -> List<String> =
  match claim.schema {
    Some(name) -> [detail_indent() ++ dim(style, "schema: " ++ name)],
    None -> [],
  }

fn explained_lines(style: Style, flags: Flags, row: Row) -> List<String> / {abort.raise} =
  if !flags.explain { [] } else {
    [detail_indent() ++ dim(style, "from: " ++ cache_status_word(row.reason))].concat(
      match row.outcome { Refuted(_) -> [], _ -> schema_lines(style, row.claim) },
    ).concat(
      weakened_frame(row.claim).map(|line: String| detail_indent() ++ dim(style, line)),
    )
  }

fn row_lines(
  style: Style,
  flags: Flags,
  places: List<SourceText>,
  row: Row,
) -> List<String> / {abort.raise} =
  [row_head(style, row, places)].concat(detail_lines(style, row)).concat(
    explained_lines(style, flags, row),
  )

fn tally_line(style: Style, rows: List<Row>, ms: Decimal) -> String / {abort.raise} = {
  let cache_contents = count_proved(rows).to_string() ++ " proved";
  let clock = " (" ++ seconds(ms) ++ "s)";
  let counted = |n: Int, word: String| if n > 0 { [n.to_string() ++ " " ++ word] } else { [] };
  let claimed = counted(count_refuted(rows), "refuted").concat(
    counted(count_vacuous(rows), "vacuous"),
  ).concat(
    counted(count_unproved(rows), "unproved"),
  );
  let parts = if count_internal_errors(rows) > 0 { claimed.push(internal_errors_word(rows)) }
  else { claimed };
  let verdict = if parts.len() == 0 { green(style, cache_contents) }
  else { red(style, String::join(parts, ", ")) ++ ", " ++ cache_contents };
  indent() ++ count_of(rows.len(), "obligation") ++ " · " ++ verdict ++ clock
}

fn filtered_lines(style: Style, filtered_out: Int) -> List<String> =
  if filtered_out > 0 { [indent() ++ dim(style, filtered_out.to_string() ++ " filtered out")] }
  else { [] }

fn opening_lines(
  style: Style,
  collection: Collection,
  wanted: List<Int>,
) -> List<String> / {abort.raise} =
  [coverage_head(collection.definitions.len(), count_specified(collection))].concat(
    filtered_lines(style, collection.claims.len() - wanted.len()),
  ).concat(if wanted.len() > 0 { [""] } else { [] })

fn closing_lines(
  style: Style,
  flags: Flags,
  rows: List<Row>,
  v: Verdicts,
  warnings: List<Diagnostic>,
) -> List<String> / {abort.raise} =
  warned_lines(style, warnings).concat([""]).concat(
    uncovered_lines(style, v.coverage, flags.explain),
  ).concat([tally_line(style, rows, v.duration_ms)])

fn summary_json(rows: List<Row>) -> Json =
  object([
    { key: "obligations", value: int(rows.len()) },
    { key: "proved", value: int(count_proved(rows)) },
    { key: "refuted", value: int(count_refuted(rows)) },
    { key: "vacuous", value: int(count_vacuous(rows)) },
    { key: "unproved", value: int(count_unproved(rows)) },
    { key: "internal_error", value: int(count_internal_errors(rows)) },
  ])

fn document(
  collection: Collection,
  rows: List<Row>,
  v: Verdicts,
  code: Int,
  filtered_out: Int,
  warnings: List<Diagnostic>,
) -> Json / {abort.raise} =
  object([
    { key: "schema_version", value: int(schema_version()) },
    { key: "command", value: Str("prove") },
    { key: "ok", value: Bool(code == ok_code()) },
    { key: "exit_code", value: int(code) },
    { key: "specified", value: int(v.specified) },
    { key: "coverage", value: coverage_json(v.coverage) },
    { key: "plan", value: plan_json(collection.plan) },
    { key: "cached", value: int(v.cached) },
    { key: "filtered_out", value: int(filtered_out) },
    { key: "duration_ms", value: Number(v.duration_ms) },
    { key: "summary", value: summary_json(rows) },
    {
      key: "obligations",
      value: Array(
        rows.map(|row: Row|
          obligation_json(row, collection.places, match v.static_prover_results {
            Some(_) -> true,
            None -> false,
          })),
      ),
    },
    { key: "diagnostics", value: all_to_json(diagnostics_of(rows), collection.places) },
    { key: "warnings", value: all_to_json(warnings, collection.places) },
  ])

fn prove_output(
  style: Style,
  flags: Flags,
  collection: Collection,
  rows: List<Row>,
  v: Verdicts,
  filtered_out: Int,
) -> CommandOutput / {abort.raise} = {
  let warnings = once_each(collection.warnings.concat(v.warnings));
  let code = exit_code_of(rows);
  {
    json: document(collection, rows, v, code, filtered_out, warnings),
    lines: closing_lines(style, flags, rows, v, warnings),
    errs: [],
    code: code,
  }
}

fn prove_collection<| e>(
  style: Style,
  flags: Flags,
  collection: Collection,
  use_cache: Bool,
  statics: StaticProver,
  discharge: (Collection, List<Int>, List<StaticResult>) -> Result<DischargeResult, Rejection> / {discharging.decided | e},
) -> CommandOutput / {process.out[proc], abort.raise, proof_store.record, proof_store.cached | e} = {
  let wanted = selected_claims(collection, flags);
  printed(opening_lines(style, collection, wanted));
  let fixture_discharge = handle {
    decide_claims(
      collection,
      wanted,
      use_cache,
      statics,
      flags.static_prover,
      |runs: List<Int>, resolved: List<StaticResult>| discharge(collection, runs, resolved),
    )
  } with {
    decisions.known(row) -> printed(row_lines(style, flags, collection.places, row)),
  };
  match fixture_discharge {
    Err(reason) -> failure_output(style, "prove", reason),
    Ok(v) ->
      prove_output(
        style,
        flags,
        collection,
        rows_of(collection.claims, wanted, v),
        v,
        collection.claims.len() - wanted.len(),
      ),
  }
}

pub fn run(
  flags: Flags,
  options: Options,
) -> CommandOutput / {semantics.cached, shipped.read_pack, builder.git[vcs], process.out[proc], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, env.variable, env.working_directory, entering::machine.open, entering::machine.enter, entering::machine.close, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, emit.unit, emit.compiled, evaluation.verdicts, evaluation.statements, Derives, abort.raise, diverges, shipped.report_view_used, toolchain.reuse_dir} = {
  let s: Style = style_of(flags);
  let t: TimedLoad = if options.no_incremental {
    timed_uncached(flags.paths, flags.verify_dependencies)
  } else { timed_load(flags.paths, flags.verify_dependencies) };
  let broken = |diagnostics: List<Diagnostic>|
    with_front_end(
      failure_output(
        s,
        "prove",
        NotCompiled({ diagnostics: diagnostics, places: t.program.source_texts }),
      ),
      reuse_members(t.program.tallies, t.program.missing_results),
    );
  match program_view(t.program) {
    None -> broken(t.program.diagnostics),
    Some(v) -> match whole_of(t.program) {
      Err(diagnostics) -> broken(diagnostics),
      Ok(w) -> match evaluation_errors(t, v.frame) {
        [] -> {
          let owned = in_root_package(v.frame);
          let built: ProverInputResult = prover_input_of(w, owned);
          with_front_end(
            results::with_evidence(results::store_for(flags.paths, flags.no_cache), ||
              prove_over(
                s,
                flags,
                options,
                {
                  places: t.program.source_texts,
                  warnings: own_diagnostics(t.program.diagnostics, v.frame),
                },
                own_claims(w, built),
                static_prover_of(w, built.world, owned),
                |collection: Collection, runs: List<Int>, resolved: List<StaticResult>|
                  discharge_library(loaded_analysis(t, v), collection, runs, resolved),
              )),
            reuse_members(t.program.tallies, t.program.missing_results),
          )
        },
        literals -> broken(literals),
      },
    },
  }
}

fn prove_over<| e>(
  style: Style,
  flags: Flags,
  options: Options,
  got: LoadResult,
  mine: OwnClaims,
  statics: StaticProver,
  discharge: (Collection, List<Int>, List<StaticResult>) -> Result<DischargeResult, Rejection> / {discharging.decided | e},
) -> CommandOutput / {process.out[proc], abort.raise, proof_store.record, proof_store.cached | e} =
  prove_collection(
    style,
    flags,
    collection_of(got, mine, options),
    !flags.no_cache,
    statics,
    discharge,
  )

pub fn a_collection(claims: List<Claim>) -> Collection =
  {
    places: [a_place()],
    warnings: [],
    claims: claims,
    definitions: claims.map(|claim: Claim| { name: claim.owner, hash: Some(claim.key), specs: [] }),
    laws: [],
    plan: a_plan(),
    world: empty_prover_input(),
    modules: [],
    lanes: None,
  }

fn got_of(c: Result<Collection, Rejection>) -> Result<LoadResult, Rejection> =
  match c { Ok(x) -> Ok(collected_part(x)), Err(reason) -> Err(reason) }

fn own_claims_of(c: Result<Collection, Rejection>) -> OwnClaims =
  match c {
    Ok(x) -> claimed_part(x),
    Err(_) ->
      {
        claims: [],
        definitions: [],
        laws: [],
        warnings: [],
        world: empty_prover_input(),
        modules: [],
      },
  }

fn verdicts(outcomes: List<Outcome>) -> DischargeResult =
  { outcomes: outcomes, duration_ms: Decimal::of_int(0), warnings: [] }

fn prove_fixture(
  flags: Flags,
  c: Result<Collection, Rejection>,
  v: Result<DischargeResult, Rejection>,
) -> CommandOutput / {abort.raise} = prove_fixture_cached(flags, c, v, [None, None])

fn prove_fixture_cached(
  flags: Flags,
  c: Result<Collection, Rejection>,
  v: Result<DischargeResult, Rejection>,
  cache_contents: List<Option<String>>,
) -> CommandOutput / {abort.raise} = prove_fixture_with_reach(flags, c, v, cache_contents, None)

fn prove_fixture_with_reach(
  flags: Flags,
  c: Result<Collection, Rejection>,
  v: Result<DischargeResult, Rejection>,
  cache_contents: List<Option<String>>,
  static_prover: Option<claims::StaticProverResult>,
) -> CommandOutput / {abort.raise} =
  handle {
    match got_of(c) {
      Err(reason) -> failure_output(style_of(flags), "prove", reason),
      Ok(got) ->
        prove_over(
          style_of(flags),
          flags,
          claims::no_options(),
          got,
          own_claims_of(c),
          no_static_prover(static_prover),
          |collection: Collection, runs: List<Int>, _resolved: List<StaticResult>|
            fixture_discharge(v, runs),
        ),
    }
  } with {
    var printed: List<String> = [],
    process.out[proc](line) -> {
      printed = printed.push(line);
    },
    proof_store.cached(keys) ->
      range(0, keys.len()).map(|j: Int|
        cached_evidence(cache_contents.at_or(j, None), certificate_for(c, v, keys.at_or(j, "")))),
    proof_store.record(entries) -> [],
    return result -> { ..result, lines: printed.concat(result.lines) },
  }

fn bare() -> Flags / {abort.raise} = from_argv("prove", [])

fn one_claim() -> List<Claim> = [a_claim("m.one", Ensures(0))]

fn one_proved() -> List<Outcome> = [proved([Congruence], 2)]

test "`ply prove` prints the coverage summary first, then one line per claim, then the totals" {
  let result = prove_fixture(bare(), Ok(a_collection(one_claim())), Ok(verdicts(one_proved())));
  assert_eq(result.code, 0);
  assert_eq(result.errs, []);
  assert_eq(result.lines, [
    "   1 definition · 1 of them have a claim · 0 do not",
    "",
    "   ✓ proved         m.one ensures #0                         congruence · 2 steps",
    "",
    "   1 obligation · 1 proved (0.00s)",
  ])
}

test "a refuted claim is exit 1, and says where it fails" {
  let result = prove_fixture(
    bare(),
    Ok(a_collection(one_claim())),
    Ok(verdicts([Refuted(a_counter())])),
  );
  assert_eq(result.code, 1);
  assert_eq(result.lines, [
    "   1 definition · 1 of them have a claim · 0 do not",
    "",
    "   ✗ refuted        m.one ensures #0                         m.ply:1:4",
    "       forall (xs: List<Int>)  →  xs = [0, 0]",
    "       frame: pure",
    "",
    "   1 definitions have no proved claim: m.one",
    "   1 obligation · 1 refuted, 0 proved (0.00s)",
  ])
}

test "before the run finishes, `ply prove` has printed only the coverage summary and each claim's result line" {
  let printed = handle {
    match got_of(Ok(a_collection(one_claim()))) {
      Err(_) -> panic("the fixture collects"),
      Ok(got) ->
        prove_over(
          style_of(bare()),
          bare(),
          claims::no_options(),
          got,
          own_claims_of(Ok(a_collection(one_claim()))),
          no_static_prover(None),
          |collection: Collection, runs: List<Int>, _resolved: List<StaticResult>|
            fixture_discharge(Ok(verdicts(one_proved())), runs),
        ),
    }
  } with {
    var lines: List<String> = [],
    process.out[proc](line) -> {
      lines = lines.push(line);
    },
    proof_store.cached(keys) -> keys.map(|_key: String| None),
    proof_store.record(entries) -> [],
    return _result -> lines,
  };
  assert_eq(printed, [
    "   1 definition · 1 of them have a claim · 0 do not",
    "",
    "   ✓ proved         m.one ensures #0                         congruence · 2 steps",
  ])
}

fn fixture_discharge(
  v: Result<DischargeResult, Rejection>,
  runs: List<Int>,
) -> Result<DischargeResult, Rejection> / {discharging.decided} =
  match v {
    Err(reason) -> Err(reason),
    Ok(d) ->
      Ok({
        ..d,
        outcomes: runs.fold([], |out: List<Outcome>, i: Int|
          match d.outcomes.at(i) {
            Some(o) -> {
              discharging.decided(i, o);
              out.push(o)
            },
            None -> out,
          }),
      }),
  }

fn cached_evidence(word: Option<String>, c: Option<Certificate>) -> Option<Bytes> / {abort.raise} =
  match word {
    None -> None,
    Some(w) ->
      Some(if w == "proof" || w == "run" {
        let stood = match c {
          Some(x) -> x,
          None -> { rules: [Congruence], steps: 2, guard_satisfiable: true, sorts: [], ran: false },
        };
        evidence_bytes({ ..stood, ran: w == "run" })
      } else { b"not evidence" }),
  }

fn certificate_for(
  c: Result<Collection, Rejection>,
  v: Result<DischargeResult, Rejection>,
  key: String,
) -> Option<Certificate> / {abort.raise} =
  match ((c, v)) {
    (Ok(x), Ok(d)) ->
      range(0, x.claims.len()).fold(None, |found: Option<Certificate>, i: Int|
        match found {
          Some(_) -> found,
          None -> match ((x.claims.at(i), d.outcomes.at(i))) {
            (Some(claim), Some(Proved(cert))) -> if claim_key(Bytes::of_hex(claim.key)).hex_of()
                == key
                || run_key(Bytes::of_hex(claim.run_key)).hex_of() == key { Some(cert) }
            else { None },
            _ -> None,
          },
        }),
    _ -> None,
  }

test "a vacuous claim is exit 1" {
  let result = prove_fixture(
    bare(),
    Ok(a_collection(one_claim())),
    Ok(verdicts([Vacuous({ guard: a_span() })])),
  );
  assert_eq(result.code, 1);
  assert_eq(
    result.lines.at_or(result.lines.len() - 1, ""),
    "   1 obligation · 1 vacuous, 0 proved (0.00s)",
  );
  assert(to_string(result.json).contains("\"ok\":false"))
}

test "`ply prove` exits 1 for an unproved claim and prints where the prover gave up" {
  let result = prove_fixture(
    bare(),
    Ok(a_collection(one_claim())),
    Ok(
      verdicts([
        Unproved(Open({ spent: false, stopped: [{ kind: "recursive_call", about: Some("m.f") }] })),
      ]),
    ),
  );
  assert_eq(result.code, 1);
  assert_eq(result.lines, [
    "   1 definition · 1 of them have a claim · 0 do not",
    "",
    "   ✗ unproved       m.one ensures #0                         no proof",
    "       the prover stopped at a recursive call to `m.f`",
    "",
    "   1 definitions have no proved claim: m.one",
    "   1 obligation · 1 unproved, 0 proved (0.00s)",
  ]);
  let text = to_string(result.json);
  assert(text.contains("\"reason_kind\":\"open\""));
  assert(text.contains("\"unproved\":1"));
  assert(text.contains("E0474"));
  assert(text.contains("\"ok\":false"))
}

test "a prover internal error is reported as a Ply bug, not as an unproved claim in the program, and exits 1" {
  let result = prove_fixture(
    bare(),
    Ok(a_collection(one_claim())),
    Ok(verdicts([InternalError(a_fault())])),
  );
  assert_eq(result.code, 1);
  assert(
    result.lines.at_or(2, "").contains(
      "this is a bug in Ply, not in your program: the compiled program has no entry point `m.law`",
    ),
  );
  assert_eq(result.lines.at_or(3, ""), "       at b = true");
  assert_eq(
    result.lines.at_or(result.lines.len() - 1, ""),
    "   1 obligation · 1 internal error in Ply, 0 proved (0.00s)",
  );
  let text = to_string(result.json);
  assert(text.contains("\"outcome\":\"internal_error\""));
  assert(text.contains("\"internal_error\":1"));
  assert(text.contains("\"unproved\":0"));
  assert(text.contains("\"code\":\"E0505\""));
  assert(text.contains("\"ok\":false"));
  assert(!text.contains("E0474"));
  assert(!text.contains("\"reason\""))
}

test "`--filter` proves only the matching claims and reports how many claims were filtered out" {
  let two = [a_claim("m.one", Ensures(0)), a_claim("m.two", Ensures(0))];
  let result = prove_fixture(
    from_argv("prove", ["--filter=two"]),
    Ok(a_collection(two)),
    Ok(verdicts(one_proved().concat(one_proved()))),
  );
  assert_eq(result.lines.filter(|l: String| l.contains("m.two ensures #0")).len(), 1);
  assert_eq(result.lines.filter(|l: String| l.contains("m.one ensures #0")).len(), 0);
  assert_eq(result.lines.at_or(1, ""), "   1 filtered out");
  assert(result.lines.contains("   1 definitions have no proved claim: m.one"))
}

test "repeating `--filter` proves the claims matching any of the filters and skips the others" {
  let three = [
    a_claim("m.one", Ensures(0)),
    a_claim("m.two", Ensures(0)),
    a_claim("m.three", Ensures(0)),
  ];
  let result = prove_fixture(
    from_argv("prove", ["--filter=one", "--filter=three"]),
    Ok(a_collection(three)),
    Ok(verdicts(one_proved().concat(one_proved()))),
  );
  assert_eq(
    result.lines.filter(|l: String|
      l.contains("m.one ensures #0") || l.contains("m.three ensures #0")).len(
    ),
    2,
  );
  assert_eq(result.lines.filter(|l: String| l.contains("m.two ensures #0")).len(), 0);
  assert(result.lines.contains("   1 filtered out"))
}

test "`ply prove --json` output has `command` and `exit_code` fields and records the proof budget and timeout used" {
  let result = prove_fixture(
    from_argv("prove", ["--json"]),
    Ok(a_collection(one_claim())),
    Ok(verdicts(one_proved())),
  );
  let text = to_string(result.json);
  assert(text.contains("\"command\":\"prove\""));
  assert(text.contains("\"schema_version\":1"));
  assert(text.contains("\"exit_code\":0"));
  assert(text.contains("\"ok\":true"));
  assert(text.contains("\"specified\":1"));
  assert(text.contains("\"prove_budget\":10000"));
  assert(text.contains("\"timeout_ms\":60000"));
  assert(text.contains("\"outcome\":\"proved\""));
  assert(text.contains("\"label\":\"m.one ensures #0\""))
}

test "`--explain` shows whether each result came from the cache, and which declared effects the body never uses" {
  let wide = { ..a_claim("m.wide", Ensures(0)), unused_effects: ["db.read[rows]"] };
  let result = prove_fixture_cached(
    from_argv("prove", ["--explain"]),
    Ok(a_collection([wide])),
    Ok(verdicts(one_proved())),
    [Some("proof"), None],
  );
  assert_eq(result.lines.at_or(3, ""), "       from: cached proof");
  assert_eq(
    result.lines.at_or(4, ""),
    "       the claim allows effects that the body never uses: db.read[rows]",
  )
}

test "`prove` shows the schema name of a claim built from a schema under `--json`, under `--explain` and when the claim is refuted" {
  let made = { ..a_claim("m.round trip", Law(Some("round trip"))), schema: Some("lib.round_trip") };
  let listed = prove_fixture(
    from_argv("prove", ["--json"]),
    Ok(a_collection([made])),
    Ok(verdicts(one_proved())),
  );
  assert(to_string(listed.json).contains("\"schema\":\"lib.round_trip\""));
  let explained = prove_fixture(
    from_argv("prove", ["--explain"]),
    Ok(a_collection([made])),
    Ok(verdicts(one_proved())),
  );
  let says = |result: CommandOutput| result.lines.contains("       schema: lib.round_trip");
  assert(says(explained));
  assert(
    says(prove_fixture(bare(), Ok(a_collection([made])), Ok(verdicts([Refuted(a_counter())])))),
  );
  assert(!says(prove_fixture(bare(), Ok(a_collection([made])), Ok(verdicts(one_proved())))));
  let written = prove_fixture(
    from_argv("prove", ["--json"]),
    Ok(a_collection([a_claim("m.round trip", Law(Some("round trip")))])),
    Ok(verdicts(one_proved())),
  );
  assert(!to_string(written.json).contains("\"schema\""))
}

fn proved_by_run() -> List<Outcome> =
  [Proved({ rules: [Congruence], steps: 2, guard_satisfiable: true, sorts: [], ran: true })]

test "under `--static-prover` each claim's JSON includes the static prover's decision, its step count and why it stopped" {
  let static_prover = {
    decision: "open",
    steps: 12,
    blockers: [{ kind: "division", about: None }, { kind: "recursive_call", about: Some("m.f") }],
  };
  let static_prover_json = "\"static_prover\":{\"blockers\":[{\"about\":null,\"kind\":\"division\"},{\"about\":\"m.f\",\"kind\":\"recursive_call\"}],\"decision\":\"open\",\"steps\":12}";
  let prove_collection = from_argv("prove", ["--json", "--static-prover"]);
  let fresh = prove_fixture_with_reach(
    prove_collection,
    Ok(a_collection(one_claim())),
    Ok(verdicts(proved_by_run())),
    [None, None],
    Some(static_prover),
  );
  assert(to_string(fresh.json).contains(static_prover_json));
  let cached = prove_fixture_with_reach(
    prove_collection,
    Ok(a_collection(one_claim())),
    Ok(verdicts(proved_by_run())),
    [None, Some("run")],
    Some(static_prover),
  );
  assert(to_string(cached.json).contains("\"cached\":1"));
  assert(to_string(cached.json).contains(static_prover_json));
  let unasked = prove_fixture(
    from_argv("prove", ["--json"]),
    Ok(a_collection(one_claim())),
    Ok(verdicts(one_proved())),
  );
  assert(!to_string(unasked.json).contains("\"static_prover\""))
}

test "`prove` reuses a cached proof, with no warnings, for a claim whose proof used a run, when the cache has an entry for the code the claim executes" {
  let result = prove_fixture_cached(
    from_argv("prove", ["--explain", "--json"]),
    Ok(a_collection(one_claim())),
    Ok(verdicts(proved_by_run())),
    [None, Some("run")],
  );
  assert(result.lines.filter(|l: String| l == "       from: cached proof").len() == 1);
  assert(to_string(result.json).contains("\"cached\":1"));
  assert(to_string(result.json).contains("\"warnings\":[]"))
}

test "a cache entry stored under the wrong kind of key is rejected, and `ply prove` reports it as warning `W0602`" {
  let result = prove_fixture_cached(
    from_argv("prove", ["--explain", "--json"]),
    Ok(a_collection(one_claim())),
    Ok(verdicts(one_proved())),
    [None, Some("proof")],
  );
  assert(result.lines.filter(|l: String| l == "       from: cache rejected").len() == 1);
  let text = to_string(result.json);
  assert(text.contains("\"cached\":0"));
  assert(text.contains("W0602"));
  assert(
    text.contains(
      "contains a proof that depends on the claim alone, stored under a cache key for a claim and its executed code `",
    ),
  )
}

test "when the program fails to compile, `ply prove` prints the compile error, counts it and exits 2" {
  let d: Diagnostic = {
    code: b"E0201",
    notes: 0,
    labels: [],
    text: b"",
    message: b"type mismatch",
    notes_text: [],
    severity: b"error",
    fixes: [],
  };
  let result = prove_fixture(
    bare(),
    Err(NotCompiled({ diagnostics: [d], places: [] })),
    Ok(verdicts([])),
  );
  assert_eq(result.code, 2);
  assert_eq(result.lines, []);
  assert_eq(result.errs, ["Error[E0201]: type mismatch", "   compilation failed (1 error)"])
}

test "a cache that would not open at all is reported without a compilation tally" {
  let d: Diagnostic = {
    code: b"E0501",
    notes: 0,
    labels: [],
    text: b"",
    message: b"could not open the cache",
    notes_text: [],
    severity: b"error",
    fixes: [],
  };
  let result = prove_fixture(
    bare(),
    Err(CacheUnavailable({ diagnostics: [d], places: [] })),
    Ok(verdicts([])),
  );
  assert_eq(result.code, 2);
  assert_eq(result.errs, ["Error[E0501]: could not open the cache"])
}
