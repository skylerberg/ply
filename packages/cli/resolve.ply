import std.list
import compiler.syntax.parsing (no_module, dummy_span)

fn unwritable(path: String) -> Diagnostic =
  error_at(
    b"E0502",
    no_module,
    dummy_span,
    Bytes::of_string("could not write `" ++ path ++ "`"),
    b"the lockfile was not written",
    [b"check the directory's permissions, or point `ply resolve` at another project"],
  )

fn archived_of(archives: List<FetchedArchive>, pin: Pin) -> Option<FetchedArchive> =
  archives.fold(None, |found: Option<FetchedArchive>, a: FetchedArchive|
    match found {
      Some(_) -> found,
      None -> if a.name == pin.name && a.version == pin.version { Some(a) } else { None },
    })

const attesters_variable_name: String = "PLY_ATTESTERS"

fn attesters() -> Result<List<Bytes>, Diagnostic> / {env.variable, fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match env.variable(attesters_variable_name) {
    None -> Ok([]),
    Some(text) ->
      text.split(":").fold(Ok([]), |accumulator: Result<List<Bytes>, Diagnostic>, path: String|
        match accumulator {
          Err(d) -> Err(d),
          Ok(keys) -> if path == "" { Ok(keys) } else {
            match paths::read_file(paths::rooted_path(path)) {
              None -> Err(unreadable_key(path, "cannot be read")),
              Some(b) -> match public_of(String::of_bytes_lossy(b)) {
                Ok(k) -> Ok(keys.push(k)),
                Err(reason) ->
                  Err(unreadable_key(path, "does not contain a public key: " ++ reason)),
              },
            }
          },
        }),
  }

type SignedAttestation = { signer: Option<Bytes>, attestation: Attestation }

fn signed_attestation(
  a: FetchedArchive,
  keys: List<Bytes>,
) -> Option<SignedAttestation> / {abort.raise} =
  match a.attestation {
    None -> None,
    Some(b) -> match decode_signed(b) {
      None -> None,
      Some(doc) -> match bin::decode(doc.payload, attestation_bin()) {
        Err(_) -> None,
        Ok(x) -> if x.archive != a.archive || x.semantics != semantics::version { None }
        else { Some({ signer: trusted_signer(doc, keys), attestation: x }) },
      },
    },
  }

fn is_attested(v: SignedAttestation) -> Bool = v.signer != None && attested(v.attestation)

fn attestation_json(v: Option<SignedAttestation>) -> Json / {abort.raise} =
  match v {
    None -> Null,
    Some(x) ->
      object([
        { key: "attested", value: Bool(is_attested(x)) },
        { key: "trusted", value: Bool(x.signer != None) },
        { key: "signer", value: match x.signer { Some(k) -> Str(k.hex_of()), None -> Null } },
        { key: "checked", value: Bool(x.attestation.checked) },
        { key: "promises", value: Bool(x.attestation.contracts_hold) },
        {
          key: "tests",
          value: object([
            { key: "passed", value: int(x.attestation.tests.passed) },
            { key: "failed", value: int(x.attestation.tests.failed) },
          ]),
        },
        {
          key: "proofs",
          value: object([
            { key: "proved", value: int(x.attestation.proofs.proved) },
            { key: "refuted", value: int(x.attestation.proofs.refuted) },
            { key: "unproved", value: int(x.attestation.proofs.unproved) },
          ]),
        },
        { key: "builder", value: Str(x.attestation.builder) },
      ]),
  }

fn recorded(pin: Pin, committed: List<String>) -> String =
  if committed.contains(pin.name) { "in the checkout" } else { pin.digest }

fn package_line(
  pin: Pin,
  committed: List<String>,
  archived: Option<FetchedArchive>,
  keys: List<Bytes>,
) -> String / {abort.raise} =
  pin.name ++ " " ++ pin.version ++ " · " ++ recorded(pin, committed)
    ++ (match archived {
      Some(a) ->
        " · registry"
          ++ (match signed_attestation(a, keys) {
            None -> "",
            Some(v) -> if is_attested(v) { " · attested" } else { " · not attested" },
          }),
      None -> "",
    })

fn heading_lines(style: Style, pins: List<Pin>, path: String) -> List<String> / {abort.raise} =
  [indent ++ green(style, "resolved") ++ " " ++ count_of(pins.len(), "package") ++ " · " ++ path]

fn json_of(
  pins: List<Pin>,
  committed: List<String>,
  archives: List<FetchedArchive>,
  keys: List<Bytes>,
  path: String,
  code: Int,
  wrote: Bool,
) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("resolve") },
    { key: "ok", value: Bool(code == ok_code) },
    { key: "exit_code", value: Number(Decimal::of_int(code)) },
    { key: "lockfile", value: Str(path) },
    { key: "written", value: Bool(wrote) },
    {
      key: "packages",
      value: Array(
        pins.map(|pin: Pin|
          object(
            List::fold(
              match archived_of(archives, pin) {
                None -> [],
                Some(a) ->
                  [
                    { key: "archive", value: Str(a.archive) },
                    { key: "interface", value: Bool(a.has_interface_file) },
                    { key: "attestation", value: attestation_json(signed_attestation(a, keys)) },
                  ],
              },
              [
                { key: "name", value: Str(pin.name) },
                { key: "version", value: Str(pin.version) },
                {
                  key: "digest",
                  value: if committed.contains(pin.name) { Null } else { Str(pin.digest) },
                },
              ],
              |accumulator: List<Member>, m: Member| accumulator.push(m),
            ),
          )),
      ),
    },
  ])

fn resolve_output(
  style: Style,
  pins: List<Pin>,
  committed: List<String>,
  archives: List<FetchedArchive>,
  keys: List<Bytes>,
  path: String,
  code: Int,
  wrote: Bool,
  list_packages: Bool,
) -> CommandOutput / {abort.raise} = {
  let body: List<String> = pins.map(|pin: Pin|
    indent ++ "  " ++ package_line(pin, committed, archived_of(archives, pin), keys));
  {
    json: json_of(pins, committed, archives, keys, path, code, wrote),
    lines: heading_lines(style, pins, path).concat(if list_packages { body } else { [] }),
    errs: [],
    code: code,
  }
}

pub fn run(
  flags: Flags,
) -> CommandOutput / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], env.variable, net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.create_dir[abs], fs.remove[abs], fs.rename[abs], abort.raise, diverges} = {
  let s = style_of(flags);
  let r = root_of(flags);
  match attesters() {
    Err(d) -> reported(s, "resolve", [d], []),
    Ok(keys) -> match lock::read(r) {
      Err(reason) -> reported(s, "resolve", [lock::unreadable_lock(r, reason)], []),
      Ok(existing) -> match remote::resolved(load_resolved(flags.paths), existing) {
        Err(d) -> reported(s, "resolve", [d], []),
        Ok(archives) -> write_lock_file(s, flags, r, archives, keys),
      },
    },
  }
}

fn write_lock_file(
  style: Style,
  flags: Flags,
  resolved: ResolvedPath,
  archives: List<FetchedArchive>,
  keys: List<Bytes>,
) -> CommandOutput / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], abort.raise, diverges} = {
  match pins_for(flags.paths) {
    Err(rejection) -> rejected(style, "resolve", rejection.diagnostics, rejection.places),
    Ok(write_lock_file) -> {
      let pins = from_front(write_lock_file.pins);
      let committed = lock::committed_packages(write_lock_file.packages);
      let at = path_of(resolved);
      let body = Bytes::of_string(text(None, pins, archives, committed));
      if !write_file(at, body) { reported(style, "resolve", [unwritable(displayed(at))], []) }
      else {
        resolve_output(
          style,
          pins,
          committed,
          archives,
          keys,
          displayed(at),
          ok_code,
          true,
          !flags.json,
        )
      }
    },
  }
}

test "a resolve names what it pinned, one line per package" {
  let pins = [
    a_pin("lib", "0.1.0", "b3:1f2e3d4c5b6a"),
    a_pin("base", "0.0.1", "b3:99aa"),
    a_pin("sim", "0.1.0", "b3:5e"),
  ];
  let result = resolve_output(
    plain,
    pins,
    ["sim"],
    [
      {
        name: "base",
        version: "0.0.1",
        archive: "b3:77",
        has_interface_file: false,
        attestation: None,
      },
    ],
    [],
    "app/ply.lock",
    ok_code,
    true,
    true,
  );
  assert_eq(result.code, 0);
  assert_eq(result.lines, [
    "   resolved 3 packages · app/ply.lock",
    "     lib 0.1.0 · b3:1f2e3d4c5b6a",
    "     base 0.0.1 · b3:99aa · registry",
    "     sim 0.1.0 · in the checkout",
  ])
}

test "the json result carries every pin, and `--json` prints no lines" {
  let pins = [a_pin("lib", "0.1.0", "b3:1f2e3d4c5b6a"), a_pin("sim", "0.1.0", "b3:5e")];
  let text = to_string(
    json_of(
      pins,
      ["sim"],
      [
        {
          name: "lib",
          version: "0.1.0",
          archive: "b3:77",
          has_interface_file: true,
          attestation: None,
        },
      ],
      [],
      "app/ply.lock",
      ok_code,
      true,
    ),
  );
  assert(text.contains("\"command\":\"resolve\""));
  assert(text.contains("\"lockfile\":\"app/ply.lock\""));
  assert(text.contains("\"written\":true"));
  assert(text.contains("\"name\":\"lib\""));
  assert(text.contains("\"digest\":\"b3:1f2e3d4c5b6a\""));
  assert(text.contains("\"archive\":\"b3:77\""));
  assert(text.contains("\"interface\":true"));
  assert(text.contains("\"digest\":null,\"name\":\"sim\""));
  assert_eq(heading_lines(plain, pins, "app/ply.lock"), ["   resolved 2 packages · app/ply.lock"])
}

test "a project with no dependencies resolves to an empty lock" {
  let result = resolve_output(plain, [], [], [], [], "ply.lock", ok_code, true, false);
  assert_eq(result.lines, ["   resolved 0 packages · ply.lock"])
}

fn an_attestation(builder: String, semantics: String) -> Attestation =
  {
    name: "orders",
    version: { major: 0, minor: 1, patch: 0 },
    archive: "b3:77",
    semantics: semantics,
    builder: builder,
    checked: true,
    contracts_hold: true,
    tests: { passed: 2, failed: 0 },
    proofs: { proved: 1, refuted: 0, unproved: 0 },
  }

fn attested_archive(a: Attestation) -> FetchedArchive / {abort.raise} =
  {
    name: "orders",
    version: "0.1.0",
    archive: "b3:77",
    has_interface_file: false,
    attestation: Some(
      encode_signed(
        countersigned(
          { payload: bin::encode(a, attestation_bin()), signatures: [] },
          Secret::of_bytes(a_seed(1)),
        ),
      ),
    ),
  }

test "an attestation signed by another build is trusted only when it was made with the same `semantics::version`" {
  let key = ed25519::public_key(Secret::of_bytes(a_seed(1)));
  let other_build = attested_archive(an_attestation("ply 9.9.9", semantics::version));
  match signed_attestation(other_build, [key]) {
    None -> panic("an attestation under these semantics was not read"),
    Some(v) -> assert(is_attested(v)),
  };
  assert(match signed_attestation(other_build, []) { Some(v) -> !is_attested(v), None -> false });
  assert_eq(
    signed_attestation(attested_archive(an_attestation("ply 9.9.9", "elsewhere")), [key]),
    None,
  );
  assert_eq(signed_attestation({ ..other_build, archive: "b3:88" }, [key]), None)
}
