import compiler.front.checking.groups (GroupKey, group_key_bin)
import compiler.front.checking.promises (MeasureProgram, measure_program, measure_name)
import compiler.front.checking.world (QueryEffects, CheckDefinition)
import compiler.store.handles (QueryOf, Written, written, fetched, query_definition)
import compiler.front.emitter_input (Analysed, Rejected)
import compiler.front.published (checked_bodies)
import compiler.check.resolve.tables (Diagnostic)
import compiler.store.memo (memo)
import proof.static_prover (UnprovedMeasure, unproved_measures)
import std.bin
import std.list
import std.string

pub type MeasureFailure = {
  owner: Bytes,
  start: Int,
  end: Int,
  reason: List<String>,
  descends: Bool,
}

derive bin for MeasureFailure

fn failures_of(p: MeasureProgram) -> List<MeasureFailure> / {abort.raise} =
  match p.outcome {
    Rejected(ds) ->
      p.measured.map(|name: Bytes|
        {
          owner: name,
          start: 0,
          end: 0,
          reason: ds.map(|d: Diagnostic| String::of_bytes_lossy(d.message)),
          descends: false,
        }),
    Analysed(w) ->
      unproved_measures(
        w,
        |m: Bytes| p.owned.contains(m),
        Some(checked_bodies(w)),
        Some(p.measured),
      ).map(|u: UnprovedMeasure|
        {
          owner: Bytes::of_string(u.measure.owner),
          start: u.measure.at.start - p.offset,
          end: u.measure.at.end - p.offset,
          reason: u.reason,
          descends: u.descends,
        }),
  }

pub fn measure_query() -> QueryOf<GroupKey, List<MeasureFailure>> =
  { name: measure_name, input: group_key_bin(), output: bin::list_bin(measure_failure_bin()) }

pub fn measure_result(u: GroupKey) -> Written / {QueryEffects, abort.raise} =
  written(measure_query(), failures_of(measure_program(u)))

pub fn measure_failures(u: GroupKey) -> List<MeasureFailure> / {memo.read, abort.raise} =
  fetched(measure_query(), u)

pub fn proof_queries() -> List<CheckDefinition> =
  [query_definition(measure_query(), b"measures.measure_result", measure_result)]
