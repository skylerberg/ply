import compiler.front.checking.groups (UnitKey, unit_key_bin, GroupOutput, CurrentGroup,
                                       ObsoleteGroup, group_output_bin, current_output,
                                       is_current_unit)
import compiler.front.checking.promises (MeasureProgram, measure_program, measure_name)
import compiler.front.checking.world (QueryEffects, CheckDefinition, measure_products)
import compiler.store.handles (QueryOf, Written, written, product_definition)
import compiler.front.emitter_input (Analysed, Rejected)
import compiler.front.published (checked_bodies)
import compiler.check.resolve.tables (Diagnostic)
import compiler.store.memo (memo)
import proof.static_prover (UnprovedMeasure, unproved_measures)
import std.bin
import std.list
import std.string

pub type MeasureFailure = {
  owner: Bytes,
  start: Int,
  end: Int,
  reason: List<String>,
  descends: Bool,
}

derive bin for MeasureFailure

fn failures_of(p: MeasureProgram) -> List<MeasureFailure> / {abort.raise} =
  match p.outcome {
    Rejected(ds) ->
      p.measured.map(|name: Bytes|
        {
          owner: name,
          start: 0,
          end: 0,
          reason: ds.map(|d: Diagnostic| String::of_bytes_lossy(d.message)),
          descends: false,
        }),
    Analysed(w) ->
      unproved_measures(
        w,
        |m: Bytes| p.owned.contains(m),
        Some(checked_bodies(w)),
        Some(p.measured),
      ).map(|u: UnprovedMeasure|
        {
          owner: Bytes::of_string(u.measure.owner),
          start: u.measure.at.start - p.offset,
          end: u.measure.at.end - p.offset,
          reason: u.reason,
          descends: u.descends,
        }),
  }

pub fn measure_query() -> QueryOf<UnitKey, GroupOutput<List<MeasureFailure>>> =
  {
    name: measure_name,
    input: unit_key_bin(),
    output: group_output_bin(bin::list_bin(measure_failure_bin())),
  }

pub fn measure_result(u: UnitKey) -> Written / {QueryEffects, abort.raise} =
  written(measure_query(), if !is_current_unit(u) { ObsoleteGroup }
  else { CurrentGroup(failures_of(measure_program(u))) })

pub fn measure_failures(u: UnitKey) -> List<MeasureFailure> / {memo.read, abort.raise} =
  current_output(measure_query(), u)

pub fn proof_queries() -> List<CheckDefinition> =
  [
    product_definition(
      measure_query(),
      b"measures.measure_result",
      measure_result,
      measure_products,
    ),
  ]
