import builder (builder)
import std.env (env)
import paths
import std.bytes
import std.fs (fs, Dir, Missing)
import std.path (join, parent)
import std.process (process, exit_code, environment_variable, CompletedProcess, Exited)

pub effect set Fetches = {process.bound[git], process.spawn[git], env.variables, fs.kind[cwd], fs.kind[abs], fs.create_dir[cwd], fs.create_dir[abs], abort.raise}

pub fn fetching<a | e>(body: () -> a / {builder.git[vcs] | e}) -> a / {Fetches | e} =
  handle { body() } with { builder.git[vcs](root, key) -> fetched(root, key) }

type Remote = { url: String, rev: String }

fn remote(key: String) -> Option<Remote> / {abort.raise} =
  if !key.starts_with("git+") { None } else {
    let parts = key.slice(4, key.len()).split("@");
    let last = parts.len() - 1;
    match parts.at(last) {
      None -> None,
      Some(rev) -> {
        let url = range(0, last).fold("", |accumulator: String, i: Int|
          match parts.at(i) {
            Some(p) -> if i == 0 { p } else { accumulator ++ "@" ++ p },
            None -> accumulator,
          });
        if url == "" || rev == "" { None } else { Some({ url: url, rev: rev }) }
      },
    }
  }

fn fetch_dir(root: String, key: String) -> String / {abort.raise} =
  join(join(join(root, ".ply-cache"), "git"), Bytes::of_string(key).blake3().hex_of())

fn git(args: List<String>) -> CompletedProcess / {process.spawn[git], env.variables} =
  process.spawn[git](
    args,
    "",
    env.variables().map(|v: { name: String, value: String }| environment_variable(v.name, v.value)),
  )

fn git_succeeds(args: List<String>) -> Bool / {process.spawn[git], env.variables} =
  exit_code(git(args)) == Some(0)

fn commit(dir: String, rev: String) -> Option<String> / {process.spawn[git], env.variables} =
  [rev, "origin/" ++ rev].fold(None, |found: Option<String>, name: String|
    match found {
      Some(_) -> found,
      None -> {
        let f = git(["-C", dir, "rev-parse", "--verify", "--quiet", name ++ "^{commit}"]);
        if exit_code(f) == Some(0) { Some(String::of_bytes_lossy(f.out).trim()) } else { None }
      },
    })

fn checkout(dir: String, commit: String) -> Bool / {process.spawn[git], env.variables} =
  git_succeeds(["-C", dir, "checkout", "--quiet", "--force", commit])

fn checked_out(dir: String, rev: String) -> Bool / {process.spawn[git], env.variables} =
  match commit(dir, rev) {
    Some(c) -> checkout(dir, c),
    None ->
      git_succeeds(["-C", dir, "fetch", "--quiet", "--all", "--tags"])
        && (match commit(dir, rev) { Some(c) -> checkout(dir, c), None -> false }),
  }

fn fetched(root: String, key: String) -> Option<String> / {Fetches} =
  if !process.bound[git]() { None } else {
    match remote(key) {
      None -> None,
      Some(r) -> {
        let dir = fetch_dir(root, key);
        let cloned = paths::kind(paths::rooted_path(join(dir, ".git"))) != Missing;
        let there = cloned
          || (paths::create_dir(paths::rooted_path(parent(dir)))
          && git_succeeds(["clone", "--quiet", "--no-checkout", r.url, dir]));
        if there && checked_out(dir, r.rev) { Some(dir) } else { None }
      },
    }
  }

test "`remote` splits a git dependency's url from its revision at the last `@`" {
  assert_eq(
    remote("git+https://host/lib.git@v1"),
    Some({ url: "https://host/lib.git", rev: "v1" }),
  );
  assert_eq(remote("git+git@host:lib.git@main"), Some({ url: "git@host:lib.git", rev: "main" }));
  assert_eq(remote("git+https://host/lib.git"), None);
  assert_eq(remote("git+@main"), None);
  assert_eq(remote("git+https://host/lib.git@"), None);
  assert_eq(remote("https://host/lib.git@v1"), None)
}

fn fake_fetch(
  cloned: Bool,
  bound: Bool,
  results: (List<String>) -> Int,
) -> { result: Option<String>, ran: List<String> } / {abort.raise} =
  handle {
    fetching(|| builder.git[vcs]("app", "git+https://host/lib.git@main"))
  } with {
    var git_succeeds: List<String> = [],
    process.bound[git]() -> bound,
    process.spawn[git](args, dir, env) -> {
      git_succeeds = git_succeeds.push(spaced(args));
      { ended: Exited(results(args)), out: b"0123abc\n", err: b"" }
    },
    env.variables() -> [{ name: "HOME", value: "/home" }],
    fs.kind[cwd](p) -> if cloned { Dir } else { Missing },
    fs.kind[abs](p) -> panic("the project is under the working directory"),
    fs.create_dir[cwd](p) -> true,
    fs.create_dir[abs](p) -> panic("the project is under the working directory"),
    return result -> { result: result, ran: git_succeeds },
  }

fn spaced(args: List<String>) -> String =
  range(0, args.len()).fold("", |accumulator: String, i: Int|
    match args.at(i) {
      Some(a) -> if i == 0 { a } else { accumulator ++ " " ++ a },
      None -> accumulator,
    })

const expected_dir: String =
  "app/.ply-cache/git/" ++ b"git+https://host/lib.git@main".blake3().hex_of()

test "a tree not in the cache is cloned, then checked out at the commit its revision names" {
  let f = fake_fetch(false, true, |args: List<String>| 0);
  assert_eq(f.result, Some(expected_dir));
  assert_eq(f.ran, [
    "clone --quiet --no-checkout https://host/lib.git " ++ expected_dir,
    "-C " ++ expected_dir ++ " rev-parse --verify --quiet main^{commit}",
    "-C " ++ expected_dir ++ " checkout --quiet --force 0123abc",
  ])
}

test "a tree that is already in the cache is neither cloned nor fetched when it contains the revision" {
  let f = fake_fetch(true, true, |args: List<String>| 0);
  assert_eq(f.result, Some(expected_dir));
  assert_eq(f.ran.len(), 2)
}

test "a missing revision triggers a git fetch, and a revision still missing after the fetch makes the lookup return `None`" {
  let f = fake_fetch(true, true, |args: List<String>|
    if args.at(2) == Some("rev-parse") { 1 } else { 0 });
  assert_eq(f.result, None);
  assert_eq(f.ran, [
    "-C " ++ expected_dir ++ " rev-parse --verify --quiet main^{commit}",
    "-C " ++ expected_dir ++ " rev-parse --verify --quiet origin/main^{commit}",
    "-C " ++ expected_dir ++ " fetch --quiet --all --tags",
    "-C " ++ expected_dir ++ " rev-parse --verify --quiet main^{commit}",
    "-C " ++ expected_dir ++ " rev-parse --verify --quiet origin/main^{commit}",
  ])
}

test "a run with no `git` available fetches nothing" {
  let f = fake_fetch(false, false, |args: List<String>| 0);
  assert_eq(f.result, None);
  assert_eq(f.ran, [])
}
