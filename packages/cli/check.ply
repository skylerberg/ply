fn types_indent() -> Int = 5

fn nested_indent() -> String = indent() ++ "  "

fn json_strings(ss: List<String>) -> List<Json> = ss.map(|s: String| Str(s))

pub fn quoted(s: String) -> String = {
  let b = Bytes::of_string(s);
  String::of_bytes_lossy(
    Bytes::concat_all([
      b"\"",
      Bytes::concat_all(
        range(0, b.len()).map(|i: Int| {
          let c = b.at(i);
          if c == 34 { b"\\\"" }
          else if c == 92 { b"\\\\" }
          else if c == 10 { b"\\n" }
          else if c == 13 { b"\\r" }
          else if c == 9 { b"\\t" }
          else { b.slice(i, i + 1) }
        }),
      ),
      b"\"",
    ]),
  )
}

fn mode_text(m: Mode) -> String =
  match m { ReadMode -> "read", WriteMode -> "write", InvalidMode -> "", RaiseMode -> "raise" }

fn module_definitions(name: String, definitions: List<DefinitionInfo>) -> List<DefinitionInfo> =
  definitions.filter(|definition_info: DefinitionInfo|
    String::of_bytes_lossy(definition_info.module) == name)

type Phase = { label: String, ms: Int }

fn percent_text(ms: Int, total: Int) -> String = {
  let tenths = if total == 0 { 0 } else { ms * 1000 / total };
  String::pad_left(Int::to_string(tenths / 10) ++ "." ++ Int::to_string(tenths % 10), 5, " ") ++ "%"
}

fn phase_line(style: Style, phase: Phase, total: Int) -> String =
  nested_indent() ++ phase.label.pad_right(11, " ") ++ " " ++ phase.ms.to_string().pad_left(8, " ")
    ++ "ms "
    ++ dim(style, percent_text(phase.ms, total))

fn longest_first(phases: List<Phase>) -> List<Phase> =
  phases.fold([], |accumulator: List<Phase>, p: Phase| {
    let before = accumulator.filter(|q: Phase| q.ms >= p.ms);
    before.push(p).concat(accumulator.filter(|q: Phase| q.ms < p.ms))
  })

fn phase_lines(style: Style, timed: TimedLoad) -> List<String> = {
  let total = timed.read_ms + timed.front_end_ms + timed.store_ms;
  let rows = longest_first([
    { label: "read", ms: timed.read_ms },
    { label: "front", ms: timed.front_end_ms },
    { label: "write back", ms: timed.store_ms },
  ]);
  ["", indent() ++ bold(style, "front-end time")].concat(
    rows.map(|phase: Phase| phase_line(style, phase, total)),
  ).concat([
    nested_indent() ++ "total".pad_right(11, " ") ++ " " ++ total.to_string().pad_left(8, " ")
      ++ "ms",
  ])
}

fn phases_json(timed: TimedLoad) -> Json =
  object([
    { key: "read", value: int(timed.read_ms) },
    { key: "front", value: int(timed.front_end_ms) },
    { key: "write_back", value: int(timed.store_ms) },
    { key: "total", value: int(timed.read_ms + timed.front_end_ms + timed.store_ms) },
  ])

fn count_line(label: String, n: Int, noun: String = "definition") -> String / {abort.raise} =
  nested_indent() ++ label.pad_right(11, " ") ++ " " ++ n.to_string().pad_left(8, " ") ++ " "
    ++ plural(n, noun)

fn tally_lines(style: Style, program: Program) -> List<String> =
  ["", indent() ++ bold(style, "memo")].concat(
    program.tallies.map(|t: QueryStats|
      nested_indent() ++ String::of_bytes_lossy(t.query).pad_right(11, " ") ++ " "
        ++ t.took.to_string().pad_left(8, " ")
        ++ " taken "
        ++ t.ran.to_string().pad_left(8, " ")
        ++ " run"
        ++ (if t.lost > 0 { ", " ++ t.lost.to_string() ++ " not kept" } else { "" })),
  )

fn cost_lines(style: Style, pass: Option<Costing>) -> List<String> / {abort.raise} =
  match pass {
    None -> [],
    Some(c) ->
      [
        "",
        indent() ++ bold(style, "cost pass"),
        count_line("walked", c.walked_modules, "body"),
        count_line("lowered", c.lowered, "module"),
      ],
  }

fn cost_json(pass: Option<Costing>) -> Json =
  match pass {
    None -> Null,
    Some(c) ->
      object([
        { key: "walked", value: int(c.walked_modules) },
        { key: "lowered", value: int(c.lowered) },
      ]),
  }

fn operation_lines(style: Style, o: OperationInfo) -> List<String> / {abort.raise} = {
  let gutter = indent() ++ "    ";
  let named = String::of_bytes_lossy(o.name) ++ (if o.resource_param { "[r]" } else { "" });
  let bare = mode_text(o.mode) ++ " " ++ named;
  let head = "(" ++ String::join(o.params.map(|t: Type| String::of_bytes_lossy(type_text(t))), ", ")
    ++ ")"
    ++ (if is_raise(o.mode) { "" }
    else { " -> " ++ String::of_bytes_lossy(type_text(o.return_type)) });
  let lines = head_lines(signature::width() - gutter.len(), bare, head);
  range(0, lines.len()).map(|i: Int| {
    let l = lines.at_or(i, "");
    if i == 0 {
      gutter ++ dim(style, mode_text(o.mode)) ++ " " ++ named ++ l.slice(bare.len(), l.len())
    } else { gutter ++ l }
  })
}

fn effect_lines(
  style: Style,
  lines: List<String>,
  effect_info: EffectInfo,
) -> List<String> / {abort.raise} = {
  let marker = if effect_info.nondet { "nondet effect" } else { "effect" };
  let head = lines.push(
    nested_indent() ++ dim(style, marker) ++ " "
      ++ bold(style, String::of_bytes_lossy(effect_info.simple_name)),
  );
  effect_info.operations.fold(head, |accumulator: List<String>, o: OperationInfo|
    accumulator.concat(operation_lines(style, o)))
}

fn set_block(lines: List<String>, v: SetLine) -> List<String> / {abort.raise} =
  set_lines(v, types_indent()).fold(lines.push(""), |accumulator: List<String>, l: String|
    accumulator.push(nested_indent() ++ l))

fn set_blocks(lines: List<String>, sets: List<SetLine>) -> List<String> / {abort.raise} = {
  let blocks = sets.fold(lines, set_block);
  if sets.len() == 0 { blocks } else { blocks.push("") }
}

fn widest_name(definitions: List<DefinitionInfo>) -> Int =
  definitions.fold(0, |accumulator: Int, definition_info: DefinitionInfo| {
    let n = String::of_bytes_lossy(definition_info.simple_name).len();
    if n > accumulator { n } else { accumulator }
  })

fn provenance_in(
  schemas: Map<Bytes, Bool>,
  definition_info: DefinitionInfo,
) -> Provenance / {abort.raise} =
  if schemas.contains(definition_info.name) {
    { ..provenance(definition_info), performed: None, unused_effects: [] }
  } else { provenance(definition_info) }

fn definition_block(
  style: Style,
  explain: Bool,
  program: Program,
  schemas: Map<Bytes, Bool>,
  located: Map<Bytes, Location>,
  width: Int,
  lines: List<String>,
  definition_info: DefinitionInfo,
) -> List<String> / {abort.raise} = {
  let definition_lines = counted_lines(
    types_indent(),
    width,
    String::of_bytes_lossy(definition_info.simple_name),
    definition_info,
    divergence_location(program, located, definition_info),
  ).fold(lines, |accumulator: List<String>, l: String| accumulator.push(nested_indent() ++ l));
  if !explain { definition_lines } else {
    provenance_lines(provenance_in(schemas, definition_info), types_indent()).concat(
      definition_info.raises.map(|r: Raise|
        "  raises"
          ++ (match raise_location(program, definition_info, r) {
            Some(p) -> " at " ++ p,
            None -> "",
          })
          ++ ": "
          ++ raise_text(r.reason)),
    ).fold(definition_lines, |accumulator: List<String>, l: String|
      accumulator.push(nested_indent() ++ dim(style, l)))
  }
}

fn raise_location(
  program: Program,
  definition_info: DefinitionInfo,
  r: Raise,
) -> Option<String> / {abort.raise} = {
  let start = definition_info.at.span.start;
  location_of(program, {
    module: definition_info.at.module,
    span: span_between(start + r.span.start, start + r.span.end),
  })
}

fn raise_json(program: Program, definition_info: DefinitionInfo, r: Raise) -> Json / {abort.raise} = {
  let named = |name: Bytes| Str(String::of_bytes_lossy(name));
  let members: List<Member> = [
    {
      key: "at",
      value: match raise_location(program, definition_info, r) { Some(p) -> Str(p), None -> Null },
    },
    { key: "kind", value: Str(raise_kind(r.reason)) },
    { key: "why", value: Str(raise_text(r.reason)) },
  ];
  object(match r.reason {
    RequirementNotShown(u) ->
      members.push({ key: "callee", value: named(u.callee) }).push({
        key: "requires",
        value: named(u.needs),
      }),
    UnguardedBuiltin(name) -> members.push({ key: "callee", value: named(name) }),
    RaisingCall(name) -> members.push({ key: "callee", value: named(name) }),
    _ -> members,
  })
}

fn locations(definitions: List<DefinitionInfo>) -> Map<Bytes, Location> =
  definitions.fold(
    Map::new(),
    |accumulator: Map<Bytes, Location>, definition_info: DefinitionInfo|
      accumulator.insert(definition_info.name, definition_info.at),
  )

fn call_location(
  program: Program,
  located: Map<Bytes, Location>,
  site: Site,
) -> Option<String> / {abort.raise} =
  match located.get(site.caller) {
    Some(caller) -> {
      let start = caller.span.start;
      location_of(program, {
        module: caller.module,
        span: span_between(start + site.span.start, start + site.span.end),
      })
    },
    None -> None,
  }

fn divergence_location(
  program: Program,
  located: Map<Bytes, Location>,
  definition_info: DefinitionInfo,
) -> Option<String> / {abort.raise} =
  match definition_info.ending { Diverges(d) -> call_location(program, located, d.at), _ -> None }

fn test_line(style: Style, test_info: TestInfo) -> String / {abort.raise} = {
  let kind = if test_info.nondet { "test/nondet" } else { "test" };
  nested_indent() ++ dim(style, kind) ++ " " ++ quoted(String::of_bytes_lossy(test_info.name))
    ++ " : "
    ++ dim(style, listed_effects_text(test_info.effects))
}

fn module_block(
  style: Style,
  explain: Bool,
  program: Program,
  analysis: CheckedProgram,
  schemas: Map<Bytes, Bool>,
  located: Map<Bytes, Location>,
  definitions: List<DefinitionInfo>,
  tests: List<TestInfo>,
  lines: List<String>,
  mo: ModuleReport,
) -> List<String> / {abort.raise} = {
  let head = mo.imports.fold(
    lines.push("").push(indent() ++ bold(style, mo.name) ++ " " ++ dim(style, mo.path)),
    |accumulator: List<String>, import_name: String|
      accumulator.push(nested_indent() ++ dim(style, "import") ++ " " ++ import_name),
  );
  let ours = module_definitions(mo.name, definitions);
  let effected = analysis.checked.effects.filter(|effect_info: EffectInfo|
    String::of_bytes_lossy(effect_info.module) == mo.name).fold(
    head,
    |accumulator: List<String>, effect_info: EffectInfo|
      effect_lines(style, accumulator, effect_info),
  );
  let setted = if !explain { effected }
  else { set_blocks(effected, module_effect_sets(analysis, mo, ours)) };
  let width = widest_name(ours);
  let defined = ours.fold(setted, |accumulator: List<String>, definition_info: DefinitionInfo|
    definition_block(
      style,
      explain,
      program,
      schemas,
      located,
      width,
      accumulator,
      definition_info,
    ));
  tests.filter(|test_info: TestInfo| String::of_bytes_lossy(test_info.module) == mo.name).fold(
    defined,
    |accumulator: List<String>, test_info: TestInfo| accumulator.push(test_line(style, test_info)),
  )
}

fn module_effect_sets(
  view: CheckedProgram,
  mo: ModuleReport,
  definitions: List<DefinitionInfo>,
) -> List<SetLine> / {abort.raise} =
  match view.frame.outlines.at(mo.index) { None -> [], Some(o) -> effect_sets(o.sets, definitions) }

fn schemas_of(view: CheckedProgram) -> Map<Bytes, Bool> =
  view.frame.outlines.fold(Map::new(), |accumulator: Map<Bytes, Bool>, o: Outline|
    o.schemas.fold(accumulator, |a: Map<Bytes, Bool>, n: Bytes| a.insert(n, true)))

fn type_lines(
  style: Style,
  explain: Bool,
  program: Program,
  analysis: CheckedProgram,
  views: List<ModuleReport>,
  definitions: List<DefinitionInfo>,
  tests: List<TestInfo>,
) -> List<String> / {abort.raise} = {
  let located = locations(definitions);
  let schemas = schemas_of(analysis);
  views.fold([], |accumulator: List<String>, mo: ModuleReport|
    module_block(
      style,
      explain,
      program,
      analysis,
      schemas,
      located,
      definitions,
      tests,
      accumulator,
      mo,
    ))
}

fn set_json(v: SetLine) -> Json =
  object([
    { key: "name", value: Str(v.name) },
    { key: "expansion", value: Array(json_strings(v.listed)) },
    { key: "used_by", value: int(v.used_by) },
  ])

fn module_json(
  explain: Bool,
  analysis: CheckedProgram,
  definitions: List<DefinitionInfo>,
  mo: ModuleReport,
) -> Json / {abort.raise} = {
  let named: List<Member> = [
    { key: "name", value: Str(mo.name) },
    { key: "file", value: Str(mo.path) },
    { key: "imports", value: Array(json_strings(mo.imports)) },
    { key: "items", value: Array(json_strings(mo.items)) },
  ];
  let fields: List<Member> = if !explain { named } else {
    named.push({
      key: "effect_sets",
      value: Array(
        module_effect_sets(analysis, mo, module_definitions(mo.name, definitions)).map(set_json),
      ),
    })
  };
  object(fields)
}

fn provenance_fields(
  program: Program,
  schemas: Map<Bytes, Bool>,
  definition_info: DefinitionInfo,
) -> List<Member> / {abort.raise} =
  [
    {
      key: "written_as",
      value: Array(json_strings(definition_info.effect_aliases.map(String::of_bytes_lossy))),
    },
    {
      key: "performed",
      value: Array(
        json_strings(
          definition_info.performed.map(|a: Effect| String::of_bytes_lossy(effect_text(a))),
        ),
      ),
    },
    {
      key: "declared_not_performed",
      value: Array(json_strings(provenance_in(schemas, definition_info).unused_effects)),
    },
    {
      key: "raises",
      value: Array(definition_info.raises.map(|r: Raise| raise_json(program, definition_info, r))),
    },
  ]

fn definition_json(
  program: Program,
  explain: Bool,
  schemas: Map<Bytes, Bool>,
  located: Map<Bytes, Location>,
  hash: Bytes,
  definition_info: DefinitionInfo,
) -> Json / {abort.raise} = {
  let named: List<Member> = [
    { key: "name", value: Str(String::of_bytes_lossy(definition_info.name)) },
    { key: "module", value: Str(String::of_bytes_lossy(definition_info.module)) },
    { key: "simple_name", value: Str(String::of_bytes_lossy(definition_info.simple_name)) },
    { key: "hash", value: Str(String::of_bytes(hex(hash))) },
    { key: "type", value: Str(scheme_of(definition_info)) },
    { key: "effects", value: Array(json_strings(effect_texts(definition_info.effects))) },
    { key: "scaling", value: Array(json_strings(effect_texts(definition_info.scaling))) },
    { key: "repeats", value: Array(definition_info.repeats.map(|i: Int| int(i))) },
    { key: "ending", value: ending_json(program, located, definition_info) },
  ];
  let fields: List<Member> = if !explain { named } else {
    provenance_fields(program, schemas, definition_info).fold(
      named,
      |accumulator: List<Member>, f: Member| accumulator.push(f),
    )
  };
  object(fields)
}

fn ending_json(
  program: Program,
  located: Map<Bytes, Location>,
  definition_info: DefinitionInfo,
) -> Json / {abort.raise} =
  match definition_info.ending {
    Terminates -> object([{ key: "kind", value: Str("ends") }]),
    TerminatesByDecreases -> object([{ key: "kind", value: Str("stated") }]),
    Diverges(d) ->
      object([
        { key: "kind", value: Str("diverges") },
        {
          key: "through",
          value: match d.through { Some(n) -> Str(String::of_bytes_lossy(n)), None -> Null },
        },
        {
          key: "at",
          value: match divergence_location(program, located, definition_info) {
            Some(p) -> Str(p),
            None -> Null,
          },
        },
        {
          key: "loop",
          value: Array(
            d.loop.map(|site: Site|
              match call_location(program, located, site) { Some(p) -> Str(p), None -> Null }),
          ),
        },
      ]),
  }

fn test_json(hash: Bytes, test_info: TestInfo) -> Json / {abort.raise} =
  object([
    { key: "index", value: int(test_info.index) },
    { key: "key", value: Str(String::of_bytes_lossy(test_info.key)) },
    { key: "name", value: Str(String::of_bytes_lossy(test_info.name)) },
    { key: "module", value: Str(String::of_bytes_lossy(test_info.module)) },
    { key: "hash", value: Str(String::of_bytes(hex(hash))) },
    { key: "nondet", value: Bool(test_info.nondet) },
    { key: "outside_effects", value: Array(json_strings(effect_texts(test_info.effects))) },
  ])

fn operation_json(o: OperationInfo) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(String::of_bytes_lossy(o.name)) },
    { key: "mode", value: Str(mode_text(o.mode)) },
    { key: "resource_param", value: Bool(o.resource_param) },
    {
      key: "params",
      value: Array(json_strings(o.params.map(|t: Type| String::of_bytes_lossy(type_text(t))))),
    },
    { key: "returns", value: Str(String::of_bytes_lossy(type_text(o.return_type))) },
  ])

fn effect_json(effect_info: EffectInfo) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(String::of_bytes_lossy(effect_info.name)) },
    { key: "module", value: Str(String::of_bytes_lossy(effect_info.module)) },
    { key: "simple_name", value: Str(String::of_bytes_lossy(effect_info.simple_name)) },
    { key: "nondet", value: Bool(effect_info.nondet) },
    { key: "operations", value: Array(effect_info.operations.map(operation_json)) },
  ])

fn document(
  flags: Flags,
  timed: TimedLoad,
  analysis: CheckedProgram,
  views: List<ModuleReport>,
  definitions: List<DefinitionInfo>,
  warnings: List<Diagnostic>,
  pass: Option<Costing>,
) -> Json / {abort.raise} = {
  let p: Program = timed.program;
  let located = locations(definitions);
  let schemas = schemas_of(analysis);
  let hashes = analysis.frame.hashes.definitions.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }|
      accumulator.insert(d.name, d.hash),
  );
  object([
    { key: "command", value: Str("check") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code()) },
    { key: "root", value: Str(flags.root) },
    {
      key: "files",
      value: Array(json_strings(p.source_texts.map(|place: SourceText| place.path))),
    },
    {
      key: "modules",
      value: Array(
        views.map(|mo: ModuleReport| module_json(flags.explain, analysis, definitions, mo)),
      ),
    },
    {
      key: "definitions",
      value: Array(
        definitions.map(|definition_info: DefinitionInfo|
          definition_json(
            p,
            flags.explain,
            schemas,
            located,
            match hashes.get(definition_info.name) { Some(h) -> h, None -> b"" },
            definition_info,
          )),
      ),
    },
    {
      key: "tests",
      value: Array(
        own_tests(p, analysis).map(|t: TestInfo|
          test_json(match analysis.frame.hashes.tests.get(t.key) { Some(h) -> h, None -> b"" }, t)),
      ),
    },
    { key: "effects", value: Array(analysis.checked.effects.map(effect_json)) },
    {
      key: "front_end",
      value: object(
        [{ key: "phases", value: phases_json(timed) }].concat(
          reuse_members(timed.program.tallies, timed.program.missing_results),
        ),
      ),
    },
    { key: "cost_pass", value: cost_json(pass) },
    { key: "diagnostics", value: all_to_json(warnings, p.source_texts) },
  ])
}

fn summary(style: Style, program: Program, frame: Frame) -> String / {abort.raise} =
  indent() ++ green(style, "checked") ++ " " ++ count_of(frame.outlines.len(), "module") ++ ", "
    ++ count_of(written_functions_of(frame), "definition")
    ++ ", "
    ++ count_of(tests_of(frame, program.files.len()), "test")

fn with_cost_report(
  style: Style,
  flags: Flags,
  places: List<SourceText>,
  report: Report,
  lines: List<String>,
) -> List<String> / {abort.raise} =
  if !flags.costs { lines } else { lines.concat(report_lines(style, places, report)) }

fn check_output(
  style: Style,
  flags: Flags,
  timed: TimedLoad,
  frame: Frame,
  pass: Option<Costing>,
  warnings: List<Diagnostic>,
) -> CommandOutput / {abort.raise} = {
  let holes = warnings.filter(|d: Diagnostic| d.code == b"W0613");
  let head = [summary(style, timed.program, frame)].concat(
    warning_lines(style, warnings.filter(|d: Diagnostic| d.code != b"W0613")),
  ).concat(
    holes.flat_map(|d: Diagnostic| to_text(style, d, timed.program.source_texts)),
  );
  let explained = if flags.explain {
    head.concat(phase_lines(style, timed)).concat(tally_lines(style, timed.program)).concat(
      cost_lines(style, pass),
    )
  } else { head };
  let read = if flags.types || flags.json { program_view(timed.program) } else { None };
  let listed = |v: CheckedProgram|
    {
      views: module_reports(timed.program, frame),
      definitions: definitions_in_order(v),
      tests: own_tests(timed.program, v),
    };
  let typed = match read {
    Some(v) -> if !flags.types { explained } else {
      let l = listed(v);
      explained.concat(
        type_lines(style, flags.explain, timed.program, v, l.views, l.definitions, l.tests),
      )
    },
    None -> explained,
  };
  {
    json: match read {
      Some(v) -> if !flags.json { object([]) } else {
        let l = listed(v);
        document(flags, timed, v, l.views, l.definitions, warnings, pass)
      },
      None -> object([]),
    },
    lines: match pass {
      Some(c) -> with_cost_report(style, flags, timed.program.source_texts, c.report, typed),
      None -> typed,
    },
    errs: [],
    code: ok_code(),
  }
}

fn checked(
  style: Style,
  flags: Flags,
  timed: TimedLoad,
  frame: Frame,
) -> CommandOutput / {cost_checker.report, evaluation.verdicts, evaluation.statements, abort.raise} = {
  let promised = has_promises(timed.program, frame);
  let pass = if !promised && !flags.costs { Ok(None) } else {
    match whole_of(timed.program) {
      Ok(w) -> Ok(Some(costs_of(timed.program, w))),
      Err(diagnostics) -> Err(diagnostics),
    }
  };
  let unkept = match pass {
    Err(diagnostics) -> diagnostics,
    Ok(None) -> [],
    Ok(Some(c)) -> if !c.report.ok { [unresolved()] }
    else if promised { report_reuse_violations(c.report) }
    else { [] },
  };
  let broken = if unkept.len() > 0 { unkept } else { evaluation_errors(timed, frame) };
  if broken.len() > 0 { rejected(style, "check", broken, timed.program.source_texts) } else {
    check_output(
      style,
      flags,
      timed,
      frame,
      match pass { Ok(p) -> p, Err(_) -> None },
      timed.program.diagnostics,
    )
  }
}

fn rejected_load(flags: Flags, timed: TimedLoad) -> CommandOutput / {abort.raise} = {
  let style = style_of(flags);
  let output = with_front_end(
    rejected(style, "check", timed.program.diagnostics, timed.program.source_texts),
    [{ key: "phases", value: phases_json(timed) }].concat(
      reuse_members(timed.program.tallies, timed.program.missing_results),
    ),
  );
  if !flags.explain { output }
  else { { ..output, lines: phase_lines(style, timed).concat(tally_lines(style, timed.program)) } }
}

fn summary_line(style: Style, summary: ProgramSummary) -> String / {abort.raise} =
  indent() ++ green(style, "checked") ++ " " ++ count_of(summary.modules, "module") ++ ", "
    ++ count_of(summary.definitions, "definition")
    ++ ", "
    ++ count_of(summary.tests, "test")

fn only_summary_wanted(flags: Flags) -> Bool =
  !flags.json && !flags.types && !flags.costs && !flags.explain && !flags.verify_dependencies
    && !flags.no_cache

pub fn run(
  flags: Flags,
) -> CommandOutput / {shipped.read_pack, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, cost_checker.report, evaluation.verdicts, evaluation.statements, toolchain.reuse_dir, Derives, abort.raise, diverges, shipped.report_view_used} = {
  match if only_summary_wanted(flags) { clean_summary(flags.paths) } else { None } {
    Some(summary) ->
      {
        json: object([]),
        lines: [summary_line(style_of(flags), summary)],
        errs: [],
        code: ok_code(),
      },
    None -> {
      let t: TimedLoad = timed_load(flags.paths, flags.verify_dependencies);
      match t.program.frame {
        None -> rejected_load(flags, t),
        Some(f) -> {
          let output = checked(style_of(flags), flags, t, f);
          if output.code == ok_code() { later_checks_passed(flags.paths, t.program.log_position) };
          output
        },
      }
    },
  }
}

test "`percent_text` prints a share to one decimal place and prints 0.0% instead of dividing when the total time is zero" {
  assert_eq(percent_text(984, 1000), " 98.4%");
  assert_eq(percent_text(1, 1000), "  0.1%");
  assert_eq(percent_text(0, 0), "  0.0%")
}

test "phase lines list the longest phase first, and the total is the sum of the read, front-end and write-back times" {
  let lines = phase_lines(plain(), {
    program: no_program(),
    read_ms: 2,
    front_end_ms: 90,
    store_ms: 8,
    cached: true,
  });
  assert_eq(lines, [
    "",
    "   front-end time",
    "     front             90ms  90.0%",
    "     write back         8ms   8.0%",
    "     read               2ms   2.0%",
    "     total            100ms",
  ])
}

test "`longest_first` keeps phases with equal times in their original order" {
  assert_eq(
    longest_first([
      { label: "read", ms: 0 },
      { label: "front", ms: 0 },
      { label: "write back", ms: 0 },
    ]).map(|phase: Phase| phase.label),
    ["read", "front", "write back"],
  )
}

test "`count_line` prints the number of definitions loaded from the cache and the number checked, with the singular form for one" {
  assert_eq(count_line("seeded", 2950), "     seeded          2950 definitions");
  assert_eq(count_line("checked", 1), "     checked            1 definition")
}

test "`quoted` prints a test name in double quotes, with embedded quotes escaped by backslashes" {
  assert_eq(quoted("two is two"), "\"two is two\"");
  assert_eq(quoted("a \"quoted\" name"), "\"a \\\"quoted\\\" name\"")
}

test "an operation too wide for the column wraps between its parameters, as a definition does" {
  let node = NamedType({ name: b"std.prelude.ListNode", args: [named_type(b"Int")] });
  let operation: OperationInfo = {
    name: b"stored_everywhere",
    mode: WriteMode,
    resource_param: true,
    keep_indices: [],
    params: [node, node, node],
    return_type: node,
    at: { module: 0, span: dummy_span() },
    scheme: None,
  };
  let hung = " ".repeat(34);
  assert_eq(operation_lines(plain(), operation), [
    "       write stored_everywhere[r](std.prelude.ListNode<Int>,",
    hung ++ "std.prelude.ListNode<Int>,",
    hung ++ "std.prelude.ListNode<Int>)",
    hung ++ "-> std.prelude.ListNode<Int>",
  ]);
  assert_eq(operation_lines(plain(), { ..operation, params: [node] }), [
    "       write stored_everywhere[r](std.prelude.ListNode<Int>)",
    hung ++ "-> std.prelude.ListNode<Int>",
  ]);
  assert_eq(operation_lines(plain(), { ..operation, mode: RaiseMode, params: [] }), [
    "       raise stored_everywhere[r]()",
  ])
}
