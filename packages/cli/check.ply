/// `indent()` plus the two spaces that put a definition under its module heading.
fn types_indent() -> Int = 5

fn under() -> String = indent() ++ "  "

fn json_strings(ss: List<String>) -> List<Json> = ss.map(|s: String| Str(s))

/// As the reference prints a test's name: the bytes, with the ones that would close the quotes escaped.
pub fn quoted(s: String) -> String = {
  let b = Bytes::of_string(s);
  String::of_bytes_lossy(
    Bytes::concat_all([
      b"\"",
      Bytes::concat_all(
        range(0, b.len()).map(|i: Int| {
          let c = b.at(i);
          if c == 34 { b"\\\"" }
          else if c == 92 { b"\\\\" }
          else if c == 10 { b"\\n" }
          else if c == 13 { b"\\r" }
          else if c == 9 { b"\\t" }
          else { b.slice(i, i + 1) }
        }),
      ),
      b"\"",
    ]),
  )
}

fn mode_text(m: Mode) -> String =
  match m { MRead -> "read", MWrite -> "write", MBad -> "", MRaise -> "raise" }

fn footprint_of(atoms: List<Atom>) -> String / {abort.raise} =
  String::of_bytes_lossy(row_text({ atoms: atoms, tail: None }))

fn mine(name: String, defs: List<DefInfo>) -> List<DefInfo> =
  defs.filter(|def_info: DefInfo| String::of_bytes_lossy(def_info.module) == name)

// --- Where the time went ----------------------------------------------------------
// The clock the program reads counts whole milliseconds, so that is what a phase is reported in.

type Phase = { label: String, ms: Int }

fn share(ms: Int, total: Int) -> String = {
  // Per mille is tenths of a percent, so one division answers both digits.
  let tenths = if total == 0 { 0 } else { ms * 1000 / total };
  String::pad_left(Int::to_string(tenths / 10) ++ "." ++ Int::to_string(tenths % 10), 5, " ") ++ "%"
}

fn phase_line(style: Style, phase: Phase, total: Int) -> String =
  under() ++ phase.label.pad_right(11, " ") ++ " " ++ phase.ms.to_string().pad_left(8, " ") ++ "ms "
    ++ dim(style, share(phase.ms, total))

/// Longest first, so what dominated a run is read first; a tie keeps the order the load ran them in.
fn ordered(phases: List<Phase>) -> List<Phase> =
  phases.fold([], |acc: List<Phase>, p: Phase| {
    let before = acc.filter(|q: Phase| q.ms >= p.ms);
    before.push(p).concat(acc.filter(|q: Phase| q.ms < p.ms))
  })

fn phase_lines(style: Style, timed: Timed) -> List<String> = {
  let total = timed.read_ms + timed.front_ms + timed.file_ms;
  let rows = ordered([
    { label: "read", ms: timed.read_ms },
    { label: "front", ms: timed.front_ms },
    { label: "write back", ms: timed.file_ms },
  ]);
  ["", indent() ++ bold(style, "front-end time")].concat(
    rows.map(|phase: Phase| phase_line(style, phase, total)),
  ).concat([
    under() ++ "total".pad_right(11, " ") ++ " " ++ total.to_string().pad_left(8, " ") ++ "ms",
  ])
}

fn phases_json(timed: Timed) -> Json =
  object([
    { key: "read", value: int(timed.read_ms) },
    { key: "front", value: int(timed.front_ms) },
    { key: "write_back", value: int(timed.file_ms) },
    { key: "total", value: int(timed.read_ms + timed.front_ms + timed.file_ms) },
  ])

// --- Where the answer came from ---------------------------------------------------
// Each query a load asked answers from its record where every read the record made answers the
// same, and runs again where one does not.

fn count_line(label: String, n: Int, noun: String = "definition") -> String / {abort.raise} =
  under() ++ label.pad_right(11, " ") ++ " " ++ n.to_string().pad_left(8, " ") ++ " "
    ++ plural(n, noun)

fn tally_lines(style: Style, program: Program) -> List<String> =
  ["", indent() ++ bold(style, "memo")].concat(
    program.tallies.map(|t: Tally|
      under() ++ String::of_bytes_lossy(t.query).pad_right(11, " ") ++ " "
        ++ t.took.to_string().pad_left(8, " ")
        ++ " taken "
        ++ t.ran.to_string().pad_left(8, " ")
        ++ " run"
        ++ (if t.lost > 0 { ", " ++ t.lost.to_string() ++ " not kept" } else { "" })),
  )

/// What the cost pass walked, where it ran: the bodies it walked rather than took as an earlier run
/// kept them, and the modules it lowered to walk them.
fn cost_lines(style: Style, pass: Option<Costing>) -> List<String> / {abort.raise} =
  match pass {
    None -> [],
    Some(c) ->
      [
        "",
        indent() ++ bold(style, "cost pass"),
        count_line("walked", c.walked, "body"),
        count_line("lowered", c.lowered, "module"),
      ],
  }

fn cost_json(pass: Option<Costing>) -> Json =
  match pass {
    None -> Null,
    Some(c) ->
      object([{ key: "walked", value: int(c.walked) }, { key: "lowered", value: int(c.lowered) }]),
  }

// --- `--types` ---------------------------------------------------------------------

/// An operation's signature, its parameters wrapped as a definition's are.
fn op_lines(style: Style, o: OpInfo) -> List<String> / {abort.raise} = {
  let gutter = indent() ++ "    ";
  let named = String::of_bytes_lossy(o.name) ++ (if o.resource_param { "[r]" } else { "" });
  let bare = mode_text(o.mode) ++ " " ++ named;
  let head = "(" ++ String::join(o.params.map(|t: Type| String::of_bytes_lossy(type_text(t))), ", ")
    ++ ")"
    ++ (if is_raise(o.mode) { "" } else { " -> " ++ String::of_bytes_lossy(type_text(o.ret)) });
  let lines = head_lines(signature::width() - gutter.len(), bare, head);
  range(0, lines.len()).map(|i: Int| {
    let l = lines.at_or(i, "");
    // The mode is dimmed only once the line is laid out, so its escapes take no column.
    if i == 0 {
      gutter ++ dim(style, mode_text(o.mode)) ++ " " ++ named ++ l.slice(bare.len(), l.len())
    } else { gutter ++ l }
  })
}

fn effect_lines(
  style: Style,
  lines: List<String>,
  effect_info: EffectInfo,
) -> List<String> / {abort.raise} = {
  let marker = if effect_info.nondet { "nondet effect" } else { "effect" };
  let head = lines.push(
    under() ++ dim(style, marker) ++ " "
      ++ bold(style, String::of_bytes_lossy(effect_info.simple_name)),
  );
  effect_info.ops.fold(head, |acc: List<String>, o: OpInfo| acc.concat(op_lines(style, o)))
}

fn set_block(lines: List<String>, v: SetLine) -> List<String> / {abort.raise} =
  set_lines(v, types_indent()).fold(lines.push(""), |acc: List<String>, l: String|
    acc.push(under() ++ l))

fn set_blocks(lines: List<String>, sets: List<SetLine>) -> List<String> / {abort.raise} = {
  let blocks = sets.fold(lines, set_block);
  if sets.len() == 0 { blocks } else { blocks.push("") }
}

fn widest(defs: List<DefInfo>) -> Int =
  defs.fold(0, |acc: Int, def_info: DefInfo| {
    let n = String::of_bytes_lossy(def_info.simple_name).len();
    if n > acc { n } else { acc }
  })

/// What a definition's row declares and its body does not perform. A definition a law schema is
/// carries the row the compiler gives every schema so that any law body fits it, and is held to none.
fn provenance_in(schemas: Map<Bytes, Bool>, def_info: DefInfo) -> Provenance / {abort.raise} =
  if schemas.contains(def_info.name) {
    { ..provenance(def_info), performed: None, unperformed: [] }
  } else { provenance(def_info) }

fn def_block(
  style: Style,
  explain: Bool,
  program: Program,
  schemas: Map<Bytes, Bool>,
  located: Map<Bytes, Location>,
  width: Int,
  lines: List<String>,
  def_info: DefInfo,
) -> List<String> / {abort.raise} = {
  let said = counted_lines(
    types_indent(),
    width,
    String::of_bytes_lossy(def_info.simple_name),
    def_info,
    diverging_at(program, located, def_info),
  ).fold(lines, |acc: List<String>, l: String| acc.push(under() ++ l));
  if !explain { said } else {
    provenance_lines(provenance_in(schemas, def_info), types_indent()).concat(
      def_info.raises.map(|r: Raise|
        "  raises" ++ (match raise_at(program, def_info, r) { Some(p) -> " at " ++ p, None -> "" })
          ++ ": "
          ++ raise_text(r.why)),
    ).fold(said, |acc: List<String>, l: String| acc.push(under() ++ dim(style, l)))
  }
}

/// Where a raise is: in its definition's body, where that body is now.
fn raise_at(program: Program, def_info: DefInfo, r: Raise) -> Option<String> / {abort.raise} = {
  let start = def_info.at.span.start;
  location_of(program, {
    module: def_info.at.module,
    span: span_between(start + r.span.start, start + r.span.end),
  })
}

fn raise_json(program: Program, def_info: DefInfo, r: Raise) -> Json / {abort.raise} = {
  let named = |name: Bytes| Str(String::of_bytes_lossy(name));
  let said: List<Member> = [
    { key: "at", value: match raise_at(program, def_info, r) { Some(p) -> Str(p), None -> Null } },
    { key: "kind", value: Str(raise_kind(r.why)) },
    { key: "why", value: Str(raise_text(r.why)) },
  ];
  object(match r.why {
    Unshown(u) ->
      said.push({ key: "callee", value: named(u.callee) }).push({
        key: "requires",
        value: named(u.needs),
      }),
    Unguarded(name) -> said.push({ key: "callee", value: named(name) }),
    Calls(name) -> said.push({ key: "callee", value: named(name) }),
    _ -> said,
  })
}

/// Each definition's location, by its qualified name.
fn locations(defs: List<DefInfo>) -> Map<Bytes, Location> =
  defs.fold(Map::new(), |acc: Map<Bytes, Location>, def_info: DefInfo|
    acc.insert(def_info.name, def_info.at))

/// Where a call is: in its caller's body, where that body is now.
fn site_at(
  program: Program,
  located: Map<Bytes, Location>,
  site: Site,
) -> Option<String> / {abort.raise} =
  match located.get(site.caller) {
    Some(caller) -> {
      let start = caller.span.start;
      location_of(program, {
        module: caller.module,
        span: span_between(start + site.span.start, start + site.span.end),
      })
    },
    None -> None,
  }

/// Where the call is by which a definition may not return.
fn diverging_at(
  program: Program,
  located: Map<Bytes, Location>,
  def_info: DefInfo,
) -> Option<String> / {abort.raise} =
  match def_info.ending { Diverges(d) -> site_at(program, located, d.at), _ -> None }

fn test_line(style: Style, test_info: TestInfo) -> String / {abort.raise} = {
  let kind = if test_info.nondet { "test/nondet" } else { "test" };
  under() ++ dim(style, kind) ++ " " ++ quoted(String::of_bytes_lossy(test_info.name)) ++ " : "
    ++ dim(style, footprint_of(test_info.footprint))
}

fn module_block(
  style: Style,
  explain: Bool,
  program: Program,
  analysis: View,
  schemas: Map<Bytes, Bool>,
  located: Map<Bytes, Location>,
  defs: List<DefInfo>,
  tests: List<TestInfo>,
  lines: List<String>,
  mo: ModuleReport,
) -> List<String> / {abort.raise} = {
  let head = mo.imports.fold(
    lines.push("").push(indent() ++ bold(style, mo.name) ++ " " ++ dim(style, mo.path)),
    |acc: List<String>, im: String| acc.push(under() ++ dim(style, "import") ++ " " ++ im),
  );
  let ours = mine(mo.name, defs);
  let effected = analysis.checked.effects.filter(|effect_info: EffectInfo|
    String::of_bytes_lossy(effect_info.module) == mo.name).fold(
    head,
    |acc: List<String>, effect_info: EffectInfo| effect_lines(style, acc, effect_info),
  );
  let setted = if !explain { effected } else { set_blocks(effected, sets_of(analysis, mo, ours)) };
  let width = widest(ours);
  let defined = ours.fold(setted, |acc: List<String>, def_info: DefInfo|
    def_block(style, explain, program, schemas, located, width, acc, def_info));
  tests.filter(|test_info: TestInfo| String::of_bytes_lossy(test_info.module) == mo.name).fold(
    defined,
    |acc: List<String>, test_info: TestInfo| acc.push(test_line(style, test_info)),
  )
}

fn sets_of(view: View, mo: ModuleReport, defs: List<DefInfo>) -> List<SetLine> / {abort.raise} =
  match view.frame.outlines.at(mo.index) { None -> [], Some(o) -> effect_sets(o.sets, defs) }

/// Each schema the program declares, and each schema's guard, by program-wide name.
fn schemas_of(view: View) -> Map<Bytes, Bool> =
  view.frame.outlines.fold(Map::new(), |acc: Map<Bytes, Bool>, o: Outline|
    o.schemas.fold(acc, |a: Map<Bytes, Bool>, n: Bytes| a.insert(n, true)))

fn type_lines(
  style: Style,
  explain: Bool,
  program: Program,
  analysis: View,
  views: List<ModuleReport>,
  defs: List<DefInfo>,
  tests: List<TestInfo>,
) -> List<String> / {abort.raise} = {
  let located = locations(defs);
  let schemas = schemas_of(analysis);
  views.fold([], |acc: List<String>, mo: ModuleReport|
    module_block(style, explain, program, analysis, schemas, located, defs, tests, acc, mo))
}

// --- The JSON document ---------------------------------------------------------------

fn set_json(v: SetLine) -> Json =
  object([
    { key: "name", value: Str(v.name) },
    { key: "expansion", value: Array(json_strings(v.atoms)) },
    { key: "used_by", value: int(v.used_by) },
  ])

fn module_json(
  explain: Bool,
  analysis: View,
  defs: List<DefInfo>,
  mo: ModuleReport,
) -> Json / {abort.raise} = {
  let named: List<Member> = [
    { key: "name", value: Str(mo.name) },
    { key: "file", value: Str(mo.path) },
    { key: "imports", value: Array(json_strings(mo.imports)) },
    { key: "items", value: Array(json_strings(mo.items)) },
  ];
  let fields: List<Member> = if !explain { named } else {
    named.push({
      key: "effect_sets",
      value: Array(sets_of(analysis, mo, mine(mo.name, defs)).map(set_json)),
    })
  };
  object(fields)
}

fn provenance_fields(
  program: Program,
  schemas: Map<Bytes, Bool>,
  def_info: DefInfo,
) -> List<Member> / {abort.raise} =
  [
    {
      key: "written_as",
      value: Array(json_strings(def_info.row_aliases.map(String::of_bytes_lossy))),
    },
    {
      key: "performed",
      value: Array(
        json_strings(def_info.performed.map(|a: Atom| String::of_bytes_lossy(atom_text(a)))),
      ),
    },
    {
      key: "declared_not_performed",
      value: Array(json_strings(provenance_in(schemas, def_info).unperformed)),
    },
    {
      key: "raises",
      value: Array(def_info.raises.map(|r: Raise| raise_json(program, def_info, r))),
    },
  ]

fn definition_json(
  program: Program,
  explain: Bool,
  schemas: Map<Bytes, Bool>,
  located: Map<Bytes, Location>,
  hash: Bytes,
  def_info: DefInfo,
) -> Json / {abort.raise} = {
  let named: List<Member> = [
    { key: "name", value: Str(String::of_bytes_lossy(def_info.name)) },
    { key: "module", value: Str(String::of_bytes_lossy(def_info.module)) },
    { key: "simple_name", value: Str(String::of_bytes_lossy(def_info.simple_name)) },
    { key: "hash", value: Str(String::of_bytes(hex(hash))) },
    { key: "type", value: Str(scheme_of(def_info)) },
    { key: "footprint", value: Str(footprint_of(def_info.footprint)) },
    { key: "atoms", value: Array(json_strings(atom_texts(def_info.footprint))) },
    { key: "scaling", value: Array(json_strings(atom_texts(def_info.scaling))) },
    { key: "repeats", value: Array(def_info.repeats.map(|i: Int| int(i))) },
    { key: "ending", value: ending_json(program, located, def_info) },
  ];
  let fields: List<Member> = if !explain { named } else {
    provenance_fields(program, schemas, def_info).fold(named, |acc: List<Member>, f: Member|
      acc.push(f))
  };
  object(fields)
}

/// How a definition's calls are known to return; one that may not names the call and where it is.
fn ending_json(
  program: Program,
  located: Map<Bytes, Location>,
  def_info: DefInfo,
) -> Json / {abort.raise} =
  match def_info.ending {
    Ends -> object([{ key: "kind", value: Str("ends") }]),
    Stated -> object([{ key: "kind", value: Str("stated") }]),
    Diverges(d) ->
      object([
        { key: "kind", value: Str("diverges") },
        {
          key: "through",
          value: match d.through { Some(n) -> Str(String::of_bytes_lossy(n)), None -> Null },
        },
        {
          key: "at",
          value: match diverging_at(program, located, def_info) { Some(p) -> Str(p), None -> Null },
        },
        {
          key: "loop",
          value: Array(
            d.loop.map(|site: Site|
              match site_at(program, located, site) { Some(p) -> Str(p), None -> Null }),
          ),
        },
      ]),
  }

fn test_json(hash: Bytes, test_info: TestInfo) -> Json / {abort.raise} =
  object([
    { key: "index", value: int(test_info.index) },
    { key: "key", value: Str(String::of_bytes_lossy(test_info.key)) },
    { key: "name", value: Str(String::of_bytes_lossy(test_info.name)) },
    { key: "module", value: Str(String::of_bytes_lossy(test_info.module)) },
    { key: "hash", value: Str(String::of_bytes(hex(hash))) },
    { key: "nondet", value: Bool(test_info.nondet) },
    { key: "footprint", value: Str(footprint_of(test_info.footprint)) },
  ])

fn op_json(o: OpInfo) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(String::of_bytes_lossy(o.name)) },
    { key: "mode", value: Str(mode_text(o.mode)) },
    { key: "resource_param", value: Bool(o.resource_param) },
    {
      key: "params",
      value: Array(json_strings(o.params.map(|t: Type| String::of_bytes_lossy(type_text(t))))),
    },
    { key: "returns", value: Str(String::of_bytes_lossy(type_text(o.ret))) },
  ])

fn effect_json(effect_info: EffectInfo) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(String::of_bytes_lossy(effect_info.name)) },
    { key: "module", value: Str(String::of_bytes_lossy(effect_info.module)) },
    { key: "simple_name", value: Str(String::of_bytes_lossy(effect_info.simple_name)) },
    { key: "nondet", value: Bool(effect_info.nondet) },
    { key: "operations", value: Array(effect_info.ops.map(op_json)) },
  ])

fn document(
  flags: Flags,
  timed: Timed,
  analysis: View,
  views: List<ModuleReport>,
  defs: List<DefInfo>,
  warnings: List<Diag>,
  pass: Option<Costing>,
) -> Json / {abort.raise} = {
  let p: Program = timed.program;
  let located = locations(defs);
  let schemas = schemas_of(analysis);
  let hashes = analysis.frame.hashes.defs.fold(
    Map::new(),
    |acc: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }| acc.insert(d.name, d.hash),
  );
  object([
    { key: "command", value: Str("check") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code()) },
    { key: "root", value: Str(flags.root) },
    { key: "files", value: Array(json_strings(p.places.map(|place: Place| place.path))) },
    {
      key: "modules",
      value: Array(views.map(|mo: ModuleReport| module_json(flags.explain, analysis, defs, mo))),
    },
    {
      key: "definitions",
      value: Array(
        defs.map(|def_info: DefInfo|
          definition_json(
            p,
            flags.explain,
            schemas,
            located,
            match hashes.get(def_info.name) { Some(h) -> h, None -> b"" },
            def_info,
          )),
      ),
    },
    {
      key: "tests",
      value: Array(
        own_tests(p, analysis).map(|t: TestInfo|
          test_json(match analysis.frame.hashes.tests.get(t.key) { Some(h) -> h, None -> b"" }, t)),
      ),
    },
    { key: "effects", value: Array(analysis.checked.effects.map(effect_json)) },
    {
      key: "front_end",
      value: object(
        [{ key: "phases", value: phases_json(timed) }].concat(
          reuse_members(timed.program.tallies, timed.program.vouched, timed.program.lost),
        ),
      ),
    },
    { key: "cost_pass", value: cost_json(pass) },
    { key: "diagnostics", value: all_to_json(warnings, p.places) },
  ])
}

// --- The answer -----------------------------------------------------------------------

/// The modules, the definitions past the prelude's and the own tests `frame` holds of `program`.
fn summary(style: Style, program: Program, frame: Frame) -> String / {abort.raise} =
  indent() ++ green(style, "checked") ++ " " ++ count_of(frame.outlines.len(), "module") ++ ", "
    ++ count_of(written_functions_of(frame), "definition")
    ++ ", "
    ++ count_of(tests_of(frame, program.files.len()), "test")

fn costed(
  style: Style,
  flags: Flags,
  places: List<Place>,
  report: Report,
  lines: List<String>,
) -> List<String> / {abort.raise} =
  if !flags.costs { lines } else { lines.concat(report_lines(style, places, report)) }

/// The answer over `frame`: the check's tables are read only for `--types` and `--json`, which list
/// them.
fn answered(
  style: Style,
  flags: Flags,
  timed: Timed,
  frame: Frame,
  pass: Option<Costing>,
  warnings: List<Diag>,
) -> Answer / {abort.raise} = {
  // A hole report is its labels: the compact warning line would say nothing of where or what.
  let holes = warnings.filter(|d: Diag| d.code == b"W0613");
  let head = [summary(style, timed.program, frame)].concat(
    warning_lines(style, warnings.filter(|d: Diag| d.code != b"W0613")),
  ).concat(
    holes.flat_map(|d: Diag| to_text(style, d, timed.program.places)),
  );
  let explained = if flags.explain {
    head.concat(phase_lines(style, timed)).concat(tally_lines(style, timed.program)).concat(
      cost_lines(style, pass),
    )
  } else { head };
  let read = if flags.types || flags.json { program_view(timed.program) } else { None };
  let listed = |v: View|
    {
      views: module_reports(timed.program, frame),
      defs: published(v),
      tests: own_tests(timed.program, v),
    };
  let typed = match read {
    Some(v) -> if !flags.types { explained } else {
      let l = listed(v);
      explained.concat(type_lines(style, flags.explain, timed.program, v, l.views, l.defs, l.tests))
    },
    None -> explained,
  };
  {
    json: match read {
      Some(v) -> if !flags.json { object([]) } else {
        let l = listed(v);
        document(flags, timed, v, l.views, l.defs, warnings, pass)
      },
      None -> object([]),
    },
    lines: match pass {
      Some(c) -> costed(style, flags, timed.program.places, c.report, typed),
      None -> typed,
    },
    errs: [],
    code: ok_code(),
  }
}

/// The cost pass answers both `--costs` and the `reuse fn` promise, and runs at most once, over the
/// program analysed whole.
fn checked(
  style: Style,
  flags: Flags,
  timed: Timed,
  frame: Frame,
) -> Answer / {priced.report, literal.verdicts, literal.statements, abort.raise} = {
  let kept = promised(timed.program, frame);
  let pass = if !kept && !flags.costs { Ok(None) } else {
    match whole_of(timed.program) {
      Ok(w) -> Ok(Some(costs_of(timed.program, w))),
      Err(diags) -> Err(diags),
    }
  };
  let unkept = match pass {
    Err(diags) -> diags,
    Ok(None) -> [],
    Ok(Some(c)) -> if !c.report.ok { [unresolved()] }
    else if kept { promises(c.report) }
    else { [] },
  };
  let broken = if unkept.len() > 0 { unkept } else { unsettled(timed, frame) };
  if broken.len() > 0 { refused(style, "check", broken, timed.program.places) } else {
    answered(
      style,
      flags,
      timed,
      frame,
      match pass { Ok(p) -> p, Err(_) -> None },
      timed.program.diags,
    )
  }
}

// --- An unchanged check ---------------------------------------------------------------
// A check's answer is a function of what its load asked, its walk, what each registry slot holds,
// the `ply` that answered and its flags; the memo store keeps it as a record of those, which a later
// check takes back while nothing it read moved.

/// A check's answer as the memo store keeps it.
type Replay = { lines: List<String>, errs: List<String>, code: Int, json: String }

derive bin for Replay

/// What names a check and the flags that shape its answer: the paths it was given and its root,
/// which its reports are relative to, and what it prints.
fn asked_of(flags: Flags) -> Bytes =
  Bytes::concat_all([
    sized(b"ply check"),
    dump_flag(flags.json),
    dump_flag(flags.types),
    dump_flag(flags.costs),
    dump_flag(flags.color),
    dump_flag(flags.verify_deps),
    sized(Bytes::of_string(flags.root)),
    resolved_fields(flags.paths),
  ])

fn filed_answer(a: Answer) -> Bytes / {abort.raise} =
  bin::encode({ lines: a.lines, errs: a.errs, code: a.code, json: to_string(a.json) }, replay_bin())

fn replayed(entry: Option<Bytes>) -> Option<Answer> / {abort.raise} =
  match entry {
    None -> None,
    Some(bytes) -> match bin::decode(bytes, replay_bin()) {
      Err(_) -> None,
      Ok(r) -> match parse_string(r.json) {
        Ok(json) -> Some({ json: json, lines: r.lines, errs: r.errs, code: r.code }),
        Err(_) -> None,
      },
    },
  }

/// The answer with its `front_end` member as `front` makes it: what the front end did is this run's,
/// whatever answer it takes.
fn with_front(a: Answer, front: (Json) -> Json) -> Answer =
  match a.json {
    Object(members) ->
      {
        ..a,
        json: Object(
          members.insert(
            "front_end",
            front(match members.get("front_end") { Some(f) -> f, None -> Null }),
          ),
        ),
      },
    _ -> a,
  }

fn reuse_said(front: Json, said: List<Member>) -> Json =
  match front {
    Object(members) ->
      Object(said.fold(members, |acc: Map<String, Json>, m: Member| acc.insert(m.key, m.value))),
    _ -> object(said),
  }

/// What a check whose load refused answers: its diagnostics, and what the load spent refusing, which
/// can be as much as a load that checks: its document's `front_end`, and under `--explain` the
/// phases and the queries it took and ran, as a check that passes prints them.
fn refused_load(flags: Flags, timed: Timed) -> Answer / {abort.raise} = {
  let style = style_of(flags);
  let said = with_front_end(
    refused(style, "check", timed.program.diags, timed.program.places),
    [{ key: "phases", value: phases_json(timed) }].concat(
      reuse_members(timed.program.tallies, timed.program.vouched, timed.program.lost),
    ),
  );
  if !flags.explain { said }
  else { { ..said, lines: phase_lines(style, timed).concat(tally_lines(style, timed.program)) } }
}

/// A check run now, beside its load, and the answer a later check may take back: one the front end
/// answered whole.
/// A check's answer from a load now. `settled` and `settled_lost` are what the run that settled the
/// store before it did, which its tallies count beside the load's own.
fn checked_now(
  flags: Flags,
  project: Project,
  started: Int,
  settled: List<Tally> = [],
  settled_lost: Int = 0,
) -> { answer: Answer, filed: Option<Answer>, program: Program } / {shipped.answer, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, priced.report, literal.verdicts, literal.statements, Derives, abort.raise, shipped.reached, toolchain.reused} = {
  let loaded: Timed = timed_over(flags.paths, project, started, flags.verify_deps);
  let t = {
    ..loaded,
    program: {
      ..loaded.program,
      tallies: joined_tallies(settled, loaded.program.tallies),
      lost: loaded.program.lost + settled_lost,
    },
  };
  match t.program.frame {
    None -> { answer: refused_load(flags, t), filed: None, program: t.program },
    Some(f) -> {
      let answer = checked(style_of(flags), flags, t, f);
      { answer: answer, filed: Some(answer), program: t.program }
    },
  }
}

pub fn run(
  flags: Flags,
) -> Answer / {shipped.answer, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, priced.report, literal.verdicts, literal.statements, toolchain.reused, Derives, abort.raise, diverges, shipped.reached} = {
  let started = time.elapsed_ms();
  let project = load_resolved(flags.paths);
  // `--explain` says what this run's own phases took, which no kept answer knows.
  if flags.explain { checked_now(flags, project, started).answer } else {
    let key = command_key(queried::program(), asked_of(flags));
    let shown = key.hex_of();
    let kept = command_kept(flags.paths, project, key);
    match replayed(kept.output) {
      Some(answer) -> if !flags.json { answer } else {
        with_front(answer, |_: Json|
          object(
            [{ key: "reused", value: Bool(true) }, { key: "key", value: Str(shown) }].concat(
              tally_members(kept.tallies, kept.lost),
            ),
          ))
      },
      None -> {
        let now = checked_now(
          flags,
          project,
          started,
          settled: kept.tallies,
          settled_lost: kept.lost,
        );
        let filed = match now.filed {
          Some(own) ->
            keep_command(flags.paths, project, key, now.program, filed_answer(own), kept.marks),
          None -> false,
        };
        if !flags.json { now.answer } else {
          with_front(now.answer, |front: Json|
            reuse_said(front, [
              { key: "reused", value: Bool(false) },
              { key: "key", value: Str(shown) },
              { key: "filed", value: Bool(filed) },
            ]))
        }
      },
    }
  }
}

// --- Tests ------------------------------------------------------------------

test "a check is asked under its paths, root and the flags that shape its answer, and reads back whole" {
  let flags = { ..no_flags(), paths: [paths::here()] };
  let base = asked_of(flags);
  assert_eq(asked_of(flags), base);
  assert(asked_of({ ..flags, types: true }) != base);
  assert(asked_of({ ..flags, json: true }) != base);
  assert(asked_of({ ..flags, costs: true }) != base);
  assert(asked_of({ ..flags, color: true }) != base);
  assert(asked_of({ ..flags, verify_deps: true }) != base);
  assert(asked_of({ ..flags, paths: [paths::at_cwd("app")] }) != base);
  let answer: Answer = {
    json: object([{ key: "ok", value: Bool(true) }]),
    lines: ["   checked 1 module"],
    errs: ["a note"],
    code: 0,
  };
  assert_eq(replayed(Some(filed_answer(answer))), Some(answer));
  assert_eq(replayed(Some(b"not an answer")), None)
}

test "a share is a tenth of a percent, and a run that took no time at all is not a division" {
  assert_eq(share(984, 1000), " 98.4%");
  assert_eq(share(1, 1000), "  0.1%");
  assert_eq(share(0, 0), "  0.0%")
}

test "the longest phase is printed first, and the total accounts for all three" {
  let lines = phase_lines(plain(), {
    program: no_program(),
    read_ms: 2,
    front_ms: 90,
    file_ms: 8,
    cached: true,
  });
  assert_eq(lines, [
    "",
    "   front-end time",
    "     front             90ms  90.0%",
    "     write back         8ms   8.0%",
    "     read               2ms   2.0%",
    "     total            100ms",
  ])
}

test "phases that took the same time are read in the order the load ran them" {
  assert_eq(
    ordered([
      { label: "read", ms: 0 },
      { label: "front", ms: 0 },
      { label: "write back", ms: 0 },
    ]).map(|phase: Phase| phase.label),
    ["read", "front", "write back"],
  )
}

test "the cache reading says how many definitions were seeded and how many were checked" {
  assert_eq(count_line("seeded", 2950), "     seeded          2950 definitions");
  assert_eq(count_line("checked", 1), "     checked            1 definition")
}

test "a test name is printed as the reference prints it, with the quotes escaped" {
  assert_eq(quoted("two is two"), "\"two is two\"");
  assert_eq(quoted("a \"quoted\" name"), "\"a \\\"quoted\\\" name\"")
}

test "an operation too wide for the column wraps between its parameters, as a definition does" {
  let node = TyCon({ name: b"std.prelude.ListNode", args: [named_type(b"Int")] });
  let op: OpInfo = {
    name: b"stored_everywhere",
    mode: MWrite,
    resource_param: true,
    kept: [],
    params: [node, node, node],
    ret: node,
    at: { module: 0, span: dummy_span() },
    scheme: None,
  };
  let hung = " ".repeat(34);
  assert_eq(op_lines(plain(), op), [
    "       write stored_everywhere[r](std.prelude.ListNode<Int>,",
    hung ++ "std.prelude.ListNode<Int>,",
    hung ++ "std.prelude.ListNode<Int>)",
    hung ++ "-> std.prelude.ListNode<Int>",
  ]);
  assert_eq(op_lines(plain(), { ..op, params: [node] }), [
    "       write stored_everywhere[r](std.prelude.ListNode<Int>)",
    hung ++ "-> std.prelude.ListNode<Int>",
  ]);
  assert_eq(op_lines(plain(), { ..op, mode: MRaise, params: [] }), [
    "       raise stored_everywhere[r]()",
  ])
}
