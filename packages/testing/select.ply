import std.bytes
import std.list
import compiler.cc (Profile)
import compiler.cc
import keys (code_key, pass_keys, plan_digest, result_key, seed_bytes, seed_key, writes_seed_keys)

pub type Row = {
  index: Int,
  label: String,
  name: String,
  module: String,
  hash: Bytes,
  seeded: Bool,
  nondet: Bool,
}

pub type Search = {
  mode: String,
  roots: List<Int>,
  budget: Int,
  steps: Int,
  path: List<Int>,
  profile: Profile,
}

pub fn digest_of(s: Search) -> Bytes / {abort.raise} =
  plan_digest(s.mode, s.budget, s.steps, s.roots, s.path)

pub fn per_root(s: Search) -> Bool = writes_seed_keys(s.mode, s.budget, s.steps, s.path)

pub fn key_of(row: Row, s: Search) -> Bytes / {abort.raise} =
  result_key(row.hash, row.seeded, digest_of(s), s.profile)

pub fn keyed_per_root(row: Row, s: Search) -> Bool = row.seeded && per_root(s)

pub type StoredResult = | Passing | Failing

pub type Case = {
  index: Int,
  label: String,
  name: String,
  module: String,
  hash: Bytes,
  cache_key: Bytes,
  seeded: Bool,
  nondet: Bool,
  cached: Option<StoredResult>,
  pending_seeds: Option<List<Int>>,
}

pub fn case_of(
  row: Row,
  cache_key: Bytes,
  cached: Option<StoredResult>,
  pending_seeds: Option<List<Int>>,
) -> Case =
  {
    index: row.index,
    label: row.label,
    name: row.name,
    module: row.module,
    hash: row.hash,
    cache_key: cache_key,
    seeded: row.seeded,
    nondet: row.nondet,
    cached: cached,
    pending_seeds: pending_seeds,
  }

pub type Reason = | New | PreviousFailure | Cached | SameCode | Nondet

pub type Pass = { key: Bytes, trace: Bytes }

pub type Decision = { case: Case, reason: Reason }

pub fn passed_before(r: Reason) -> Bool = match r { Cached -> true, SameCode -> true, _ -> false }

pub fn runs(d: Decision) -> Bool = !passed_before(d.reason)

pub fn reason_of(c: Case) -> Reason =
  if c.nondet { Nondet } else {
    match c.cached {
      None -> match c.pending_seeds {
        Some(roots) -> if roots.len() == 0 { Cached } else { New },
        None -> New,
      },
      Some(Passing) -> Cached,
      Some(Failing) -> PreviousFailure,
    }
  }

pub fn decide(cases: List<Case>) -> List<Decision> =
  cases.map(|c: Case| { case: c, reason: reason_of(c) })

pub fn pending_roots(
  roots: List<Int>,
  cached_results: List<Option<StoredResult>>,
) -> List<Int> / {abort.raise} =
  range(0, roots.len()).filter(|i: Int| {
    match cached_results.at(i) { Some(Some(Passing)) -> false, _ -> true }
  }).map(|i: Int| roots.get(i))

pub fn seed_keys(
  test_hash: Bytes,
  roots: List<Int>,
  path: List<Int>,
  profile: Profile,
) -> List<Bytes> / {abort.raise} =
  roots.map(|root: Int| seed_key(test_hash, seed_bytes(root, path), profile))

pub fn roots_to_search(c: Case, roots: List<Int>) -> List<Int> =
  match c.pending_seeds {
    Some(pending_seeds) -> if pending_seeds.len() > 0 && pending_seeds.len() < roots.len() {
      pending_seeds
    } else { roots },
    None -> roots,
  }

pub fn narrowed_searches(
  decisions: List<Decision>,
  roots: List<Int>,
) -> List<{ index: Int, roots: List<Int> }> =
  decisions.fold([], |accumulator: List<{ index: Int, roots: List<Int> }>, d: Decision| {
    let searched = roots_to_search(d.case, roots);
    if runs(d) && searched.len() < roots.len() {
      accumulator.push({ index: d.case.index, roots: searched })
    } else { accumulator }
  })

pub fn pass_keys_by_test(
  decisions: List<Decision>,
  s: Search,
) -> List<{ index: Int, keys: List<Bytes> }> / {abort.raise} = {
  let digest = digest_of(s);
  decisions.fold([], |accumulator: List<{ index: Int, keys: List<Bytes> }>, d: Decision|
    if !runs(d) { accumulator } else {
      accumulator.push({
        index: d.case.index,
        keys: pass_keys(
          d.case.hash,
          d.case.seeded,
          digest,
          per_root(s),
          roots_to_search(d.case, s.roots),
          s.profile,
        ),
      })
    })
}

pub fn code_keys(
  decisions: List<Decision>,
  codes: Map<Int, Bytes>,
  s: Search,
) -> Map<Int, Bytes> / {abort.raise} = {
  let digest = digest_of(s);
  decisions.fold(Map::new(), |accumulator: Map<Int, Bytes>, d: Decision|
    match codes.get(d.case.index) {
      None -> accumulator,
      Some(code) ->
        accumulator.insert(d.case.index, code_key(code, d.case.seeded, digest, s.profile)),
    })
}

pub fn code_keys_to_query(
  decisions: List<Decision>,
  keys: Map<Int, Bytes>,
) -> List<{ index: Int, key: Bytes }> =
  decisions.fold([], |accumulator: List<{ index: Int, key: Bytes }>, d: Decision|
    if d.reason != New { accumulator } else {
      match keys.get(d.case.index) {
        Some(k) -> accumulator.push({ index: d.case.index, key: k }),
        None -> accumulator,
      }
    })

pub type ByCode = { decisions: List<Decision>, written_passes: List<Pass> }

pub fn by_code(
  decisions: List<Decision>,
  passed: Map<Int, Bytes>,
  s: Search,
) -> ByCode / {abort.raise} = {
  let hit = |d: Decision| d.reason == New && passed.contains(d.case.index);
  {
    decisions: decisions.map(|d: Decision| if hit(d) { { ..d, reason: SameCode } } else { d }),
    written_passes: pass_keys_by_test(decisions.filter(hit), s).fold(
      [],
      |accumulator: List<Pass>, e: { index: Int, keys: List<Bytes> }| {
        let trace = match passed.get(e.index) { Some(t) -> t, None -> b"" };
        e.keys.fold(accumulator, |a: List<Pass>, k: Bytes| a.push({ key: k, trace: trace }))
      },
    ),
  }
}

pub fn to_run(decisions: List<Decision>) -> List<Int> =
  decisions.fold([], |accumulator: List<Int>, d: Decision|
    if runs(d) { accumulator.push(d.case.index) } else { accumulator })

pub fn reused(decisions: List<Decision>) -> List<{ index: Int, outcome: String }> =
  decisions.fold([], |accumulator: List<{ index: Int, outcome: String }>, d: Decision|
    if passed_before(d.reason) { accumulator.push({ index: d.case.index, outcome: "passed" }) }
    else { accumulator })

pub fn reason_word(r: Reason) -> String =
  match r {
    New -> "new",
    PreviousFailure -> "previous failure",
    Cached -> "cached",
    SameCode -> "same code",
    Nondet -> "nondet",
  }

const a_hash: Bytes = b"\x07".repeat(32)

fn a_case(index: Int, cached: Option<StoredResult>) -> Case =
  {
    index: index,
    label: "doubles",
    name: "m.doubles",
    module: "m",
    hash: a_hash,
    cache_key: a_hash,
    seeded: false,
    nondet: false,
    cached: cached,
    pending_seeds: None,
  }

const a_row: Row =
  {
    index: 0,
    label: "doubles",
    name: "m.doubles",
    module: "m",
    hash: a_hash,
    seeded: false,
    nondet: false,
  }

fn reason(index: Int, cached: Option<StoredResult>) -> Reason = reason_of(a_case(index, cached))

fn random(roots: Int) -> Search =
  {
    mode: "random",
    roots: range(0, roots),
    budget: 1,
    steps: 100000,
    path: [],
    profile: cc::development(),
  }

const dpor: Search =
  { mode: "dpor", roots: [0], budget: 256, steps: 100000, path: [], profile: cc::development() }

test "only a stored passing result makes a test skip running" {
  assert_eq(reason(0, Some(Passing)), Cached);
  assert_eq(reason(0, None), New);
  assert_eq(reason(0, Some(Failing)), PreviousFailure)
}

const code_hash: Bytes = b"\x77".repeat(32)

test "a new test reuses a stored pass for the same code, and runs again after a stored failure" {
  let decisions = decide([
    a_case(0, None),
    a_case(1, Some(Failing)),
    a_case(2, None),
    { ..a_case(3, None), nondet: true },
  ]);
  let codes = range(0, 4).fold(Map::new(), |m: Map<Int, Bytes>, i: Int| m.insert(i, code_hash));
  let keys = code_keys(decisions, codes, dpor);
  assert_eq(keys.keys(), [0, 1, 2, 3]);
  assert_eq(keys.get(0), keys.get(2));
  assert_eq(code_keys_to_query(decisions, keys).map(|a: { index: Int, key: Bytes }| a.index), [
    0,
    2,
  ]);
  let returned = by_code(decisions, Map::new().insert(0, b"read"), dpor);
  assert_eq(returned.decisions.map(|d: Decision| d.reason), [
    SameCode,
    PreviousFailure,
    New,
    Nondet,
  ]);
  assert_eq(returned.written_passes, [
    { key: result_key(a_hash, false, digest_of(dpor), dpor.profile), trace: b"read" },
  ]);
  assert_eq(to_run(returned.decisions), [1, 2, 3]);
  assert_eq(reused(returned.decisions), [{ index: 0, outcome: "passed" }])
}

test "a test run with random seeds gets a different cache key when its code or its `random` or `dpor` setting changes" {
  let seeded = decide([{ ..a_case(0, None), seeded: true }]);
  let codes = Map::new().insert(0, code_hash);
  assert(code_keys(seeded, codes, dpor) != code_keys(seeded, codes, random(4)), None);
  assert(code_keys(seeded, codes, dpor) != code_keys(decide([a_case(0, None)]), codes, dpor), None)
}

test "a `test/nondet` test runs every time, because its effects can write" {
  assert_eq(reason_of({ ..a_case(0, Some(Passing)), nondet: true }), Nondet);
  let d = decide([{ ..a_case(0, Some(Passing)), nondet: true }, a_case(1, Some(Passing))]);
  assert_eq(to_run(d), [0])
}

test "only a cached test is left out, and the run's list is in index order" {
  let cases = [a_case(0, Some(Passing)), a_case(1, None), a_case(2, Some(Failing))];
  let decisions = decide(cases);
  assert_eq(decisions.map(|d: Decision| reason_word(d.reason)), [
    "cached",
    "new",
    "previous failure",
  ]);
  assert_eq(to_run(decisions), [1, 2]);
  assert_eq(reused(decisions), [{ index: 0, outcome: "passed" }])
}

test "`reason_word` returns the word the report prints for each reason a test runs or is skipped" {
  assert_eq(reason_word(New), "new");
  assert_eq(reason_word(PreviousFailure), "previous failure");
  assert_eq(reason_word(Cached), "cached");
  assert_eq(reason_word(SameCode), "same code");
  assert_eq(reason_word(Nondet), "nondet")
}

test "`key_of` gives a randomly seeded test a key that depends on the search setting, and every test a key that depends on the profile" {
  let row = {
    index: 0,
    label: "t",
    name: "m.t",
    module: "m",
    hash: a_hash,
    seeded: false,
    nondet: false,
  };
  assert_eq(key_of(row, dpor), key_of(row, random(4)));
  assert(key_of(row, dpor) != key_of(row, { ..dpor, profile: cc::release() }));
  let seeded = { ..row, seeded: true };
  let four = key_of(seeded, random(4));
  assert(four != key_of(row, random(4)));
  assert(four != key_of(seeded, random(8)));
  assert(keyed_per_root(seeded, random(4)));
  assert(!keyed_per_root(seeded, dpor));
  assert(!keyed_per_root(row, random(4)))
}

test "a randomly seeded test is cached when every seed already passed, and otherwise reruns only the seeds without a pass" {
  let seeded = { ..a_case(0, None), seeded: true, pending_seeds: Some([]) };
  assert_eq(reason_of(seeded), Cached);
  let decisions = decide([seeded]);
  assert_eq(to_run(decisions), []);
  assert_eq(narrowed_searches(decisions, [0, 1, 2, 3]), []);
  assert_eq(pass_keys_by_test(decisions, random(4)), []);
  let some = decide([{ ..seeded, pending_seeds: Some([2, 3]) }]);
  assert_eq(some.map(|d: Decision| d.reason), [New]);
  assert_eq(narrowed_searches(some, [0, 1, 2, 3]), [{ index: 0, roots: [2, 3] }]);
  let all = decide([{ ..seeded, pending_seeds: Some([0, 1, 2, 3]) }]);
  assert_eq(narrowed_searches(all, [0, 1, 2, 3]), []);
  assert_eq(reason_of({ ..seeded, cached: Some(Failing) }), PreviousFailure);
  assert_eq(reason_of({ ..seeded, cached: Some(Passing), pending_seeds: Some([1]) }), Cached)
}

test "a failing randomly seeded test with every seed already passed still runs again, using all seeds" {
  let failing = decide([{ ..a_case(0, Some(Failing)), seeded: true, pending_seeds: Some([]) }]);
  assert_eq(to_run(failing), [0]);
  assert_eq(narrowed_searches(failing, [0, 1, 2, 3]), []);
  assert_eq(roots_to_search(failing.get(0).case, [0, 1, 2, 3]), [0, 1, 2, 3])
}

test "`pending_roots` returns the seeds whose own cache key has no stored pass, including seeds with a stored failure" {
  assert_eq(pending_roots([0, 1, 2, 3], [Some(Passing), None, Some(Failing), Some(Passing)]), [
    1,
    2,
  ]);
  assert_eq(pending_roots([4, 5], []), [4, 5]);
  assert_eq(seed_keys(a_hash, [0, 1, 2], [], dpor.profile).len(), 3)
}

test "a passing test is stored under its code hash, and a rerun of some seeds also stores a key for each seed it ran" {
  let hermetic = decide([a_case(0, None)]);
  assert_eq(pass_keys_by_test(hermetic, dpor), [{ index: 0, keys: [key_of(a_row, dpor)] }]);
  assert_eq(pass_keys_by_test(decide([a_case(0, Some(Passing))]), dpor), []);
  let seeded = { ..a_case(0, None), seeded: true, pending_seeds: Some([2, 3]) };
  let four = random(4);
  let keys = pass_keys_by_test(
    decide([{ ..seeded, cache_key: key_of({ ..a_row, seeded: true }, four) }]),
    four,
  );
  assert_eq(keys.map(|f: { index: Int, keys: List<Bytes> }| f.keys.len()), [3]);
  assert_eq(keys.map(|f: { index: Int, keys: List<Bytes> }| f.keys).get(0), [
    seed_keys(a_hash, [2], [], four.profile).get(0),
    seed_keys(a_hash, [3], [], four.profile).get(0),
    result_key(a_hash, true, digest_of(four), four.profile),
  ])
}
