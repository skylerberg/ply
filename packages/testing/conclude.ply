//! `conclude` — what a run came to: each test's status, the keys a green verdict is filed under or
//! why it is filed under none, what each failure is suspected of, and which definitions the store
//! may record as seen. The runtime ran the tests; what their results establish is decided here.

import std.list
import select (Cached, Pass, Reason, passed_before)

/// A search a seeded test ran, as concluding reads it.
pub type SearchSummary = { explored: Int, exhaustive: Bool, exhausted: Bool, failed: Bool }

/// One test the run executed, generic over how a failure is said.
pub type TestResult<d> = {
  index: Int,
  /// `passed`, `failed`, `panicked` or `abandoned`.
  status: String,
  failure: Option<d>,
  /// The run reached a host handler, so running it again acts on the world again.
  host: Bool,
  /// What the run read, which its pass is filed with; `None` when no trace stands in for it.
  trace: Option<Bytes>,
  /// `None` for a test that ran once, and for a search no interleaving of which was observed.
  searched: Option<SearchSummary>,
  /// The roots its search started from.
  seeds: Int,
}

/// One test the program declares, and where a later run's walk of what it reached starts: at what
/// `of`, the test it is or is a case of, references, or at what its cases run where `case` says.
pub type Test = { index: Int, key: Bytes, seeded: Bool, hash: Option<Bytes>, of: Bytes, case: Bool }

/// What some tests reach: each function, and each type or effect, by name. A function and an effect
/// may share a name, and reaching one is not reaching the other.
pub type Reached = { functions: List<Bytes>, declarations: List<Bytes> }

/// The program's hashes by name, the digest of the era its module records make, and what the tests
/// whose keys it is handed reach.
pub type Hashes = {
  definitions: Map<Bytes, Bytes>,
  declarations: Map<Bytes, Bytes>,
  era: Bytes,
  closure: (List<Bytes>) -> Reached / {abort.raise},
}

/// What the run was told: the classes it ran, the keys each running test's pass is filed under and
/// those it is filed under by the code the test ran, the reason for every test, and the tests it was
/// never asked to decide.
pub type RunSelection = {
  groups: List<List<Int>>,
  filed: Map<Int, List<Bytes>>,
  codes: Map<Int, List<Bytes>>,
  reasons: Map<Int, Reason>,
  out_of_scope: List<Int>,
}

/// Where a green verdict is written, or why it is not.
pub type Record =
  /// Under each of these keys, in order.
  | WrittenUnder(List<Bytes>)
  /// The search spent its budget, or stopped at a failure.
  | Exhausted
  /// The footprint reads a seed and no search was observed.
  | Unobserved
  /// The run did something no trace stands in for.
  | Untraced

pub fn is_written(r: Record) -> Bool = match r { WrittenUnder(_) -> true, _ -> false }

/// A spent budget or an unobserved search proved nothing, seeded or not: a handler can hide the seed
/// a region reads, and the region still searched.
pub fn record_under(
  filed: List<Bytes>,
  seeded: Bool,
  search_summary: Option<SearchSummary>,
) -> Record =
  match search_summary {
    None -> if seeded { Unobserved } else { WrittenUnder(filed) },
    Some(s) -> if s.failed || s.exhausted { Exhausted } else { WrittenUnder(filed) },
  }

pub type Outcome<d> = {
  index: Int,
  status: String,
  failure: Option<d>,
  searched: Option<SearchSummary>,
  /// The class it ran in; one past the last for a test no class names.
  group: Int,
  /// `None` when no pass was filed for it at all.
  recorded: Option<Record>,
}

pub type TestFailure<d> = {
  index: Int,
  key: Bytes,
  failure: d,
  /// Ply's fault rather than the program's: nothing in the definition graph to attribute.
  defect: Bool,
  /// The failing run reached a host handler, so re-running it acts on the world again.
  host: Bool,
  /// Definitions in the test's closure the store had never seen, ascending, the test aside.
  suspects: List<Bytes>,
}

/// What a test passed at: its hash, and the era it passed in, whose module records a later run walks
/// by name from `of` to find each definition the test reached and its hash then, since names are
/// how two eras of a program are lined up.
pub type PassRecord = { test: Bytes, era: Bytes, of: Bytes, case: Bool }

/// Each function and each declaration some tests reached, by hash.
pub type ReachedHashes = { functions: List<Bytes>, declarations: List<Bytes> }

/// What the store is told: passes by key and by the code their tests ran, pass records by test, the
/// definitions it may record as seen, and what the passing tests reached, whose interfaces and
/// bodies a later failure's diagnosis reads.
pub type Filing = {
  passes: List<Pass>,
  codes: List<Pass>,
  records: List<{ key: Bytes, record: PassRecord }>,
  seen: List<Bytes>,
  reached: ReachedHashes,
}

/// Something about the run itself rather than about any test.
pub type Notice =
  /// The program ran a test index the program does not declare.
  | StaleIndex({ index: Int, declared: Int })
  /// A test reading a seed passed with no search observed, named by its key.
  | UnobservedSearch(Bytes)

pub type SimulationStats = {
  simulated: Int,
  /// Every test the run executed, simulated or not.
  total: Int,
  seeds: Int,
  interleavings: Int,
  /// Searches that emptied their frontier, and searches that spent their budget.
  exhaustive: Int,
  exhausted: Int,
  failed: Int,
}

pub type Conclusion<d> = {
  /// Every test that ran, in index order.
  outcomes: List<Outcome<d>>,
  failures: List<TestFailure<d>>,
  passed: Int,
  failed: Int,
  /// The wall clock stopped these: no verdict, so the run is no success either.
  abandoned: Int,
  notices: List<Notice>,
  filing: Filing,
  simulation: SimulationStats,
}

type Tally<d> = {
  outcomes: List<Outcome<d>>,
  failures: List<TestFailure<d>>,
  passed: Int,
  failed: Int,
  abandoned: Int,
  notices: List<Notice>,
  passes: List<Pass>,
  codes: List<Pass>,
  records: List<{ key: Bytes, record: PassRecord }>,
}

fn by_index<a>(xs: List<{ index: Int, item: a }>) -> Map<Int, a> =
  xs.fold(Map::new(), |acc: Map<Int, a>, x: { index: Int, item: a }| acc.insert(x.index, x.item))

fn sorted_by_index<d>(results: List<TestResult<d>>) -> List<TestResult<d>> = {
  let held = by_index(results.map(|r: TestResult<d>| { index: r.index, item: r }));
  held.values()
}

fn hashes_in(m: Map<Bytes, Bytes>, names: List<Bytes>) -> List<Bytes> =
  names.fold([], |acc: List<Bytes>, name: Bytes|
    match m.get(name) { Some(h) -> acc.push(h), None -> acc })

/// Definitions whose current hash the store had never seen.
fn unseen_definitions(h: Hashes, seen: Map<Bytes, Bool>) -> Map<Bytes, Bool> =
  h.definitions.fold(Map::new(), |acc: Map<Bytes, Bool>, name: Bytes, hash: Bytes|
    match seen.get(hash) {
      Some(known) -> if known { acc } else { acc.insert(name, true) },
      None -> acc.insert(name, true),
    })

/// The functions test `key` reaches that moved, ascending: the prelude's are the language's, which
/// code the emitter writes reaches though no text names it, so never the program's suspects.
fn suspects_of(
  h: Hashes,
  key: Bytes,
  unseen_definitions: Map<Bytes, Bool>,
) -> List<Bytes> / {abort.raise} = {
  let moved = (h.closure)([key]).functions.filter(|name: Bytes|
    unseen_definitions.contains(name) && !name.starts_with(b"std.prelude."));
  moved.sort()
}

fn group_of(groups: List<List<Int>>) -> Map<Int, Int> =
  range(0, groups.len()).fold(Map::new(), |acc: Map<Int, Int>, g: Int|
    match groups.at(g) {
      Some(class) -> class.fold(acc, |into: Map<Int, Int>, i: Int| into.insert(i, g)),
      None -> acc,
    })

fn tally_result<d>(
  t: Tally<d>,
  r: TestResult<d>,
  declared: Test,
  h: Hashes,
  chosen: RunSelection,
  unseen_definitions: Map<Bytes, Bool>,
  groups: Map<Int, Int>,
) -> Tally<d> / {abort.raise} = {
  let outcome = |recorded: Option<Record>|
    {
      index: r.index,
      status: r.status,
      failure: r.failure,
      searched: r.searched,
      group: match groups.get(r.index) { Some(g) -> g, None -> chosen.groups.len() },
      recorded: recorded,
    };
  if r.status == "abandoned" {
    // The clock is a fact about this machine: no verdict, no suspects, nothing stored.
    { ..t, outcomes: t.outcomes.push(outcome(None)), abandoned: t.abandoned + 1 }
  } else {
    match r.failure {
      Some(failure) ->
        {
          ..t,
          outcomes: t.outcomes.push(outcome(None)),
          failed: t.failed + 1,
          failures: t.failures.push({
            index: r.index,
            key: declared.key,
            failure: failure,
            defect: r.status == "panicked",
            host: r.host,
            suspects: suspects_of(h, declared.key, unseen_definitions),
          }),
        },
      None -> match r.trace {
        None -> { ..t, outcomes: t.outcomes.push(outcome(Some(Untraced))), passed: t.passed + 1 },
        Some(trace) -> match chosen.filed.get(r.index) {
          None -> { ..t, outcomes: t.outcomes.push(outcome(None)), passed: t.passed + 1 },
          Some(keys) -> {
            let record = record_under(keys, declared.seeded, r.searched);
            let noticed = match record {
              Unobserved -> t.notices.push(UnobservedSearch(declared.key)),
              _ -> t.notices,
            };
            let passes = match record {
              WrittenUnder(under) ->
                under.fold(t.passes, |acc: List<Pass>, k: Bytes|
                  acc.push({ key: k, trace: trace })),
              _ -> t.passes,
            };
            let codes = match chosen.codes.get(r.index) {
              Some(cs) -> if is_written(record) {
                cs.fold(t.codes, |acc: List<Pass>, k: Bytes| acc.push({ key: k, trace: trace }))
              } else { t.codes },
              None -> t.codes,
            };
            let records = match declared.hash {
              Some(hash) -> if is_written(record) {
                t.records.push({
                  key: declared.key,
                  record: { test: hash, era: h.era, of: declared.of, case: declared.case },
                })
              } else { t.records },
              None -> t.records,
            };
            {
              ..t,
              outcomes: t.outcomes.push(outcome(Some(record))),
              passed: t.passed + 1,
              notices: noticed,
              passes: passes,
              codes: codes,
              records: records,
            }
          },
        },
      },
    }
  }
}

/// Every definition but those a failed, or never decided, test reached: a red test does not vouch
/// for what it exercised, and a skipped one vouches for nothing.
fn vouched_for<d>(
  tests: List<Test>,
  h: Hashes,
  chosen: RunSelection,
  outcomes: List<Outcome<d>>,
) -> List<Bytes> / {abort.raise} = {
  let proven = outcomes.fold(Map::new(), |acc: Map<Int, Bool>, o: Outcome<d>|
    if o.status == "passed" { acc.insert(o.index, true) } else { acc });
  let out = chosen.out_of_scope.fold(Map::new(), |acc: Map<Int, Bool>, i: Int| acc.insert(i, true));
  let undecided = tests.filter(|t: Test| {
    let green = match chosen.reasons.get(t.index) { Some(r) -> passed_before(r), None -> false };
    !out.contains(t.index) && !green && !proven.contains(t.index)
  });
  let implicated = List::fold(
    (h.closure)(undecided.map(|t: Test| t.key)).functions,
    Map::new(),
    |acc: Map<Bytes, Bool>, n: Bytes| acc.insert(n, true),
  );
  h.definitions.fold([], |acc: List<Bytes>, name: Bytes, hash: Bytes|
    if implicated.contains(name) { acc } else { acc.push(hash) })
}

/// What the tests filed with a pass record reached, by hash, read in one walk from all of them.
fn reached_by(
  h: Hashes,
  records: List<{ key: Bytes, record: PassRecord }>,
) -> ReachedHashes / {abort.raise} =
  if records.len() == 0 { { functions: [], declarations: [] } } else {
    let reached = (h.closure)(records.map(|e: { key: Bytes, record: PassRecord }| e.key));
    {
      functions: hashes_in(h.definitions, reached.functions),
      declarations: hashes_in(h.declarations, reached.declarations),
    }
  }

fn simulation_stats<d>(
  outcomes: List<Outcome<d>>,
  results: List<TestResult<d>>,
) -> SimulationStats = {
  let seeds = by_index(results.map(|r: TestResult<d>| { index: r.index, item: r.seeds }));
  outcomes.fold(
    {
      simulated: 0,
      total: outcomes.len(),
      seeds: 0,
      interleavings: 0,
      exhaustive: 0,
      exhausted: 0,
      failed: 0,
    },
    |acc: SimulationStats, o: Outcome<d>|
      match o.searched {
        None -> acc,
        Some(s) ->
          {
            ..acc,
            simulated: acc.simulated + 1,
            seeds: acc.seeds + (match seeds.get(o.index) { Some(n) -> n, None -> 0 }),
            interleavings: acc.interleavings + s.explored,
            exhaustive: acc.exhaustive + (if s.exhaustive { 1 } else { 0 }),
            exhausted: acc.exhausted + (if s.exhausted { 1 } else { 0 }),
            failed: acc.failed + (if s.failed { 1 } else { 0 }),
          },
      },
  )
}

/// What the run came to, in test order. `seen` is whether the store had seen each definition's
/// hash before this run, which is what a failure's suspects are judged against.
pub fn conclude_run<d>(
  tests: List<Test>,
  h: Hashes,
  chosen: RunSelection,
  seen: Map<Bytes, Bool>,
  results: List<TestResult<d>>,
) -> Conclusion<d> / {abort.raise} = {
  let declared = by_index(tests.map(|t: Test| { index: t.index, item: t }));
  let suspicious = unseen_definitions(h, seen);
  let groups = group_of(chosen.groups);
  let ordered = sorted_by_index(results);
  let t: Tally<d> = ordered.fold(
    {
      outcomes: [],
      failures: [],
      passed: 0,
      failed: 0,
      abandoned: 0,
      notices: [],
      passes: [],
      codes: [],
      records: [],
    },
    |acc: Tally<d>, r: TestResult<d>|
      match declared.get(r.index) {
        None ->
          {
            ..acc,
            notices: acc.notices.push(StaleIndex({ index: r.index, declared: tests.len() })),
          },
        Some(declared_test) -> tally_result(acc, r, declared_test, h, chosen, suspicious, groups),
      },
  );
  {
    outcomes: t.outcomes,
    failures: t.failures,
    passed: t.passed,
    failed: t.failed,
    abandoned: t.abandoned,
    notices: t.notices,
    filing: {
      passes: t.passes,
      codes: t.codes,
      records: t.records,
      seen: vouched_for(tests, h, chosen, t.outcomes),
      reached: reached_by(h, t.records),
    },
    simulation: simulation_stats(t.outcomes, ordered),
  }
}

// --- Tests ------------------------------------------------------------------

fn a_test(index: Int, name: Bytes) -> Test =
  {
    index: index,
    key: b"m." ++ name,
    seeded: false,
    hash: Some(b"t" ++ Bytes::of_string(index.to_string())),
    of: b"m." ++ name,
    case: false,
  }

fn snapshot() -> Bytes = b"era"

fn a_program() -> Hashes =
  {
    definitions: Map::of_entries([
      { key: b"m.add", value: b"h_add" },
      { key: b"m.mul", value: b"h_mul" },
      { key: b"m.twice", value: b"h_twice" },
    ]),
    declarations: Map::new(),
    era: snapshot(),
    closure: |keys: List<Bytes>| {
      let reached = Map::of_entries([
        { key: b"m.adds", value: [b"m.add"] },
        { key: b"m.doubles", value: [b"m.twice", b"m.mul"] },
      ]);
      {
        functions: keys.fold([], |acc: List<Bytes>, k: Bytes|
          match reached.get(k) {
            Some(names) -> names.fold(acc, |out: List<Bytes>, n: Bytes| out.push(n)),
            None -> acc,
          }),
        declarations: [],
      }
    },
  }

fn select_all(tests: List<Test>) -> RunSelection =
  {
    groups: [tests.map(|t: Test| t.index)],
    filed: tests.fold(Map::new(), |acc: Map<Int, List<Bytes>>, t: Test|
      match t.hash { Some(h) -> acc.insert(t.index, [h]), None -> acc }),
    codes: tests.fold(Map::new(), |acc: Map<Int, List<Bytes>>, t: Test|
      acc.insert(t.index, [b"c" ++ Bytes::of_string(t.index.to_string())])),
    reasons: Map::new(),
    out_of_scope: [],
  }

fn passing(index: Int) -> TestResult<String> =
  {
    index: index,
    status: "passed",
    failure: None,
    host: false,
    trace: Some(b""),
    searched: None,
    seeds: 0,
  }

fn pass_of(key: Bytes) -> Pass = { key: key, trace: b"" }

fn failing(index: Int) -> TestResult<String> =
  { ..passing(index), status: "failed", failure: Some("assertion failed") }

fn both() -> List<Test> = [a_test(0, b"adds"), a_test(1, b"doubles")]

test "a pass is filed under its keys with its hash and era, and a failure under none" {
  let c = conclude_run(both(), a_program(), select_all(both()), Map::new(), [
    passing(0),
    failing(1),
  ]);
  assert_eq(c.passed, 1);
  assert_eq(c.failed, 1);
  assert_eq(c.filing.passes, [pass_of(b"t0")]);
  assert_eq(c.filing.codes, [pass_of(b"c0")]);
  assert_eq(c.filing.records, [
    { key: b"m.adds", record: { test: b"t0", era: snapshot(), of: b"m.adds", case: false } },
  ]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(WrittenUnder([b"t0"])), None])
}

test "a case's pass record names the test it is a case of, whose cases' runs a walk starts from" {
  let case = { ..a_test(0, b"adds 1"), of: b"m.adds {n}", case: true };
  let c = conclude_run([case], a_program(), select_all([case]), Map::new(), [passing(0)]);
  assert_eq(c.filing.records.map(|e: { key: Bytes, record: PassRecord }| e.record), [
    { test: b"t0", era: snapshot(), of: b"m.adds {n}", case: true },
  ])
}

test "what the passing tests reached is filed by hash, a reached effect's and not its function's" {
  let h: Hashes = {
    definitions: Map::of_entries([
      { key: b"m.gz", value: b"h_fn" },
      { key: b"m.read", value: b"h_read" },
    ]),
    declarations: Map::of_entries([{ key: b"m.gz", value: b"h_effect" }]),
    era: snapshot(),
    closure: |keys: List<Bytes>| { functions: [b"m.read"], declarations: [b"m.gz"] },
  };
  let c = conclude_run([a_test(0, b"reads")], h, select_all([a_test(0, b"reads")]), Map::new(), [
    passing(0),
  ]);
  assert_eq(c.filing.reached, { functions: [b"h_read"], declarations: [b"h_effect"] });
  let red = conclude_run(
    [a_test(0, b"reads")],
    h,
    select_all([a_test(0, b"reads")]),
    Map::new(),
    [failing(0)],
  );
  assert_eq(red.filing.reached, { functions: [], declarations: [] })
}

test "a red test does not vouch for the definitions it exercised" {
  let c = conclude_run(both(), a_program(), select_all(both()), Map::new(), [
    passing(0),
    failing(1),
  ]);
  assert_eq(c.filing.seen, [b"h_add"])
}

test "a test the run skipped vouches for nothing, and a cached one still does" {
  let chosen = { ..select_all(both()), reasons: Map::new().insert(1, Cached) };
  let c = conclude_run(both(), a_program(), chosen, Map::new(), [passing(0)]);
  assert_eq(c.filing.seen, [b"h_add", b"h_mul", b"h_twice"]);
  let skipped = conclude_run(both(), a_program(), select_all(both()), Map::new(), [passing(0)]);
  assert_eq(skipped.filing.seen, [b"h_add"])
}

test "a failure suspects exactly the definitions in its closure the store never saw" {
  let seen = Map::new().insert(b"h_mul", true);
  let c = conclude_run(both(), a_program(), select_all(both()), seen, [failing(1)]);
  assert_eq(c.failures.map(|f: TestFailure<String>| f.suspects), [[b"m.twice"]])
}

test "an untraced pass, an abandoned run and a defect are each recorded for what they are" {
  let untraced = { ..passing(0), host: true, trace: None };
  let stopped = { ..failing(1), status: "abandoned" };
  let c = conclude_run(both(), a_program(), select_all(both()), Map::new(), [untraced, stopped]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Untraced), None]);
  assert_eq(c.abandoned, 1);
  assert_eq(c.failed, 0);
  assert_eq(c.filing.passes, []);
  let defect = conclude_run(both(), a_program(), select_all(both()), Map::new(), [
    { ..failing(1), status: "panicked" },
  ]);
  assert_eq(defect.failures.map(|f: TestFailure<String>| f.defect), [true])
}

test "a spent or unobserved search writes nothing, and the unobserved one is noticed" {
  let seeded = [{ ..a_test(0, b"adds"), seeded: true }, a_test(1, b"doubles")];
  let spent = {
    ..passing(1),
    searched: Some({ explored: 4, exhaustive: false, exhausted: true, failed: false }),
  };
  let c = conclude_run(seeded, a_program(), select_all(seeded), Map::new(), [passing(0), spent]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Unobserved), Some(Exhausted)]);
  assert_eq(c.filing.passes, []);
  assert_eq(c.filing.codes, []);
  assert_eq(c.notices, [UnobservedSearch(b"m.adds")]);
  assert_eq(c.simulation.exhausted, 1);
  assert_eq(c.simulation.interleavings, 4)
}

test "a test index the program does not declare is noticed rather than reported" {
  let c = conclude_run(both(), a_program(), select_all(both()), Map::new(), [passing(7)]);
  assert_eq(c.notices, [StaleIndex({ index: 7, declared: 2 })]);
  assert_eq(c.outcomes, [])
}

test "results come back in test order, each with the class it ran in" {
  let chosen = { ..select_all(both()), groups: [[1], [0]] };
  let c = conclude_run(both(), a_program(), chosen, Map::new(), [passing(1), passing(0)]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.index), [0, 1]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.group), [1, 0])
}

fn search_summary(explored: Int, exhausted: Bool, failed: Bool) -> SearchSummary =
  { explored: explored, exhaustive: !exhausted && !failed, exhausted: exhausted, failed: failed }

test "a pass is written under exactly the keys it was filed under, a seeded one's roots too" {
  let seeded = [{ ..a_test(0, b"adds"), seeded: true }];
  let chosen = {
    ..select_all(seeded),
    filed: Map::new().insert(0, [b"plan", b"root 0", b"root 1"]),
  };
  let c = conclude_run(seeded, a_program(), chosen, Map::new(), [
    { ..passing(0), searched: Some(search_summary(3, false, false)), seeds: 2 },
  ]);
  assert_eq(c.filing.passes, [b"plan", b"root 0", b"root 1"].map(pass_of));
  assert_eq(c.simulation.seeds, 2);
  assert_eq(c.simulation.exhaustive, 1)
}

test "a search stopped at a failure is filed under no key, and counted as failed" {
  let seeded = [{ ..a_test(0, b"adds"), seeded: true }];
  let c = conclude_run(seeded, a_program(), select_all(seeded), Map::new(), [
    { ..failing(0), searched: Some(search_summary(5, false, true)), seeds: 1 },
  ]);
  assert_eq(c.filing.passes, []);
  assert_eq(c.filing.records, []);
  assert_eq(c.simulation.failed, 1);
  assert_eq(c.simulation.interleavings, 5)
}

test "a spent budget stops an unseeded test's pass being written as well" {
  let c = conclude_run(both(), a_program(), select_all(both()), Map::new(), [
    { ..passing(0), searched: Some(search_summary(9, true, false)) },
  ]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Exhausted)]);
  assert_eq(c.filing.passes, [])
}

test "a test with no keys filed for it passes and is written under nothing" {
  let chosen = { ..select_all(both()), filed: Map::new() };
  let c = conclude_run(both(), a_program(), chosen, Map::new(), [passing(0)]);
  assert_eq(c.passed, 1);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [None]);
  assert_eq(c.filing.passes, [])
}

test "a test outside the run's scope never implicates what it reaches" {
  let chosen = { ..select_all(both()), out_of_scope: [1] };
  let c = conclude_run(both(), a_program(), chosen, Map::new(), [passing(0)]);
  assert_eq(c.filing.seen, [b"h_add", b"h_mul", b"h_twice"])
}

test "only a pass with a hash is filed with a pass record" {
  let unhashed = [{ ..a_test(0, b"adds"), hash: None }];
  let chosen = { ..select_all(unhashed), filed: Map::new().insert(0, [b"k"]) };
  let c = conclude_run(unhashed, a_program(), chosen, Map::new(), [passing(0)]);
  assert_eq(c.filing.passes, [pass_of(b"k")]);
  assert_eq(c.filing.records, [])
}

test "a pass that reached the host is filed with what it read, in both of its keys" {
  let hosted = { ..passing(0), host: true, trace: Some(b"file\tcwd\ta.txt\tb3\n") };
  let c = conclude_run(both(), a_program(), select_all(both()), Map::new(), [hosted]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(WrittenUnder([b"t0"]))]);
  assert_eq(c.filing.passes, [{ key: b"t0", trace: b"file\tcwd\ta.txt\tb3\n" }]);
  assert_eq(c.filing.codes, [{ key: b"c0", trace: b"file\tcwd\ta.txt\tb3\n" }])
}
