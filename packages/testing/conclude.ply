import std.list
import select (Cached, Pass, Reason, passed_before)

pub type SearchSummary = { explored: Int, exhaustive: Bool, exhausted: Bool, failed: Bool }

pub type TestResult<d> = {
  index: Int,
  status: String,
  failure: Option<d>,
  host: Bool,
  trace: Option<Bytes>,
  searched: Option<SearchSummary>,
  seeds: Int,
}

pub type Test = {
  index: Int,
  key: Bytes,
  seeded: Bool,
  hash: Option<Bytes>,
  start: Bytes,
  case: Bool,
}

pub type Reachable = { functions: List<Bytes>, declarations: List<Bytes> }

pub type Hashes = {
  definitions: Map<Bytes, Bytes>,
  declarations: Map<Bytes, Bytes>,
  era: Bytes,
  closure: (List<Bytes>) -> Reachable / {abort.raise},
}

pub type RunSelection = {
  groups: List<List<Int>>,
  recorded: Map<Int, List<Bytes>>,
  codes: Map<Int, List<Bytes>>,
  reasons: Map<Int, Reason>,
  out_of_scope: List<Int>,
}

pub type Record = | WrittenUnder(List<Bytes>) | Exhausted | Unobserved | Untraced

pub fn is_written(r: Record) -> Bool = match r { WrittenUnder(_) -> true, _ -> false }

pub fn record_under(
  recorded: List<Bytes>,
  seeded: Bool,
  search_summary: Option<SearchSummary>,
) -> Record =
  match search_summary {
    None -> if seeded { Unobserved } else { WrittenUnder(recorded) },
    Some(s) -> if s.failed || s.exhausted { Exhausted } else { WrittenUnder(recorded) },
  }

pub type Outcome<d> = {
  index: Int,
  status: String,
  failure: Option<d>,
  searched: Option<SearchSummary>,
  group: Int,
  recorded: Option<Record>,
}

pub type TestFailure<d> = {
  index: Int,
  key: Bytes,
  failure: d,
  internal_error: Bool,
  host: Bool,
  changes: List<Bytes>,
}

pub type PassRecord = { test: Bytes, era: Bytes, start: Bytes, case: Bool }

pub type ReachableHashes = { functions: List<Bytes>, declarations: List<Bytes> }

pub type Filing = {
  passes: List<Pass>,
  code_passes: List<Pass>,
  records: List<{ key: Bytes, record: PassRecord }>,
  seen: List<Bytes>,
  reachable: ReachableHashes,
}

pub type Notice = | StaleIndex({ index: Int, declared: Int }) | UnobservedSearch(Bytes)

pub type SimulationStats = {
  simulated: Int,
  total: Int,
  seeds: Int,
  interleavings: Int,
  exhaustive: Int,
  exhausted: Int,
  failed: Int,
}

pub type Conclusion<d> = {
  outcomes: List<Outcome<d>>,
  failures: List<TestFailure<d>>,
  passed: Int,
  failed: Int,
  timed_out: Int,
  notices: List<Notice>,
  store_update: Filing,
  simulation: SimulationStats,
}

type Tally<d> = {
  outcomes: List<Outcome<d>>,
  failures: List<TestFailure<d>>,
  passed: Int,
  failed: Int,
  timed_out: Int,
  notices: List<Notice>,
  passes: List<Pass>,
  codes: List<Pass>,
  records: List<{ key: Bytes, record: PassRecord }>,
}

fn by_index<a>(xs: List<{ index: Int, item: a }>) -> Map<Int, a> =
  xs.fold(Map::new(), |accumulator: Map<Int, a>, x: { index: Int, item: a }|
    accumulator.insert(x.index, x.item))

fn sorted_by_index<d>(results: List<TestResult<d>>) -> List<TestResult<d>> = {
  let results_by_index = by_index(results.map(|r: TestResult<d>| { index: r.index, item: r }));
  results_by_index.values()
}

fn hashes_in(m: Map<Bytes, Bytes>, names: List<Bytes>) -> List<Bytes> =
  names.fold([], |accumulator: List<Bytes>, name: Bytes|
    match m.get(name) { Some(h) -> accumulator.push(h), None -> accumulator })

fn unseen_definitions(h: Hashes, seen: Map<Bytes, Bool>) -> Map<Bytes, Bool> =
  h.definitions.fold(Map::new(), |accumulator: Map<Bytes, Bool>, name: Bytes, hash: Bytes|
    match seen.get(hash) {
      Some(known) -> if known { accumulator } else { accumulator.insert(name, true) },
      None -> accumulator.insert(name, true),
    })

fn changes_of(
  h: Hashes,
  key: Bytes,
  unseen_definitions: Map<Bytes, Bool>,
) -> List<Bytes> / {abort.raise} = {
  let moved = (h.closure)([key]).functions.filter(|name: Bytes|
    unseen_definitions.contains(name) && !name.starts_with(b"std.prelude."));
  moved.sort()
}

fn group_of(groups: List<List<Int>>) -> Map<Int, Int> =
  range(0, groups.len()).fold(Map::new(), |accumulator: Map<Int, Int>, g: Int|
    match groups.at(g) {
      Some(class) -> class.fold(accumulator, |into: Map<Int, Int>, i: Int| into.insert(i, g)),
      None -> accumulator,
    })

fn tally_result<d>(
  t: Tally<d>,
  r: TestResult<d>,
  declared: Test,
  h: Hashes,
  chosen: RunSelection,
  unseen_definitions: Map<Bytes, Bool>,
  groups: Map<Int, Int>,
) -> Tally<d> / {abort.raise} = {
  let outcome = |recorded: Option<Record>|
    {
      index: r.index,
      status: r.status,
      failure: r.failure,
      searched: r.searched,
      group: match groups.get(r.index) { Some(g) -> g, None -> chosen.groups.len() },
      recorded: recorded,
    };
  if r.status == "timed_out" {
    { ..t, outcomes: t.outcomes.push(outcome(None)), timed_out: t.timed_out + 1 }
  } else {
    match r.failure {
      Some(failure) ->
        {
          ..t,
          outcomes: t.outcomes.push(outcome(None)),
          failed: t.failed + 1,
          failures: t.failures.push({
            index: r.index,
            key: declared.key,
            failure: failure,
            internal_error: r.status == "panicked",
            host: r.host,
            changes: changes_of(h, declared.key, unseen_definitions),
          }),
        },
      None -> match r.trace {
        None -> { ..t, outcomes: t.outcomes.push(outcome(Some(Untraced))), passed: t.passed + 1 },
        Some(trace) -> match chosen.recorded.get(r.index) {
          None -> { ..t, outcomes: t.outcomes.push(outcome(None)), passed: t.passed + 1 },
          Some(keys) -> {
            let record = record_under(keys, declared.seeded, r.searched);
            let noticed = match record {
              Unobserved -> t.notices.push(UnobservedSearch(declared.key)),
              _ -> t.notices,
            };
            let passes = match record {
              WrittenUnder(under) ->
                under.fold(t.passes, |accumulator: List<Pass>, k: Bytes|
                  accumulator.push({ key: k, trace: trace })),
              _ -> t.passes,
            };
            let codes = match chosen.codes.get(r.index) {
              Some(cs) -> if is_written(record) {
                cs.fold(t.codes, |accumulator: List<Pass>, k: Bytes|
                  accumulator.push({ key: k, trace: trace }))
              } else { t.codes },
              None -> t.codes,
            };
            let records = match declared.hash {
              Some(hash) -> if is_written(record) {
                t.records.push({
                  key: declared.key,
                  record: { test: hash, era: h.era, start: declared.start, case: declared.case },
                })
              } else { t.records },
              None -> t.records,
            };
            {
              ..t,
              outcomes: t.outcomes.push(outcome(Some(record))),
              passed: t.passed + 1,
              notices: noticed,
              passes: passes,
              codes: codes,
              records: records,
            }
          },
        },
      },
    }
  }
}

fn vouched_for<d>(
  tests: List<Test>,
  h: Hashes,
  chosen: RunSelection,
  outcomes: List<Outcome<d>>,
) -> List<Bytes> / {abort.raise} = {
  let proven = outcomes.fold(Map::new(), |accumulator: Map<Int, Bool>, o: Outcome<d>|
    if o.status == "passed" { accumulator.insert(o.index, true) } else { accumulator });
  let out = chosen.out_of_scope.fold(Map::new(), |accumulator: Map<Int, Bool>, i: Int|
    accumulator.insert(i, true));
  let undecided = tests.filter(|t: Test| {
    let green = match chosen.reasons.get(t.index) { Some(r) -> passed_before(r), None -> false };
    !out.contains(t.index) && !green && !proven.contains(t.index)
  });
  let implicated = List::fold(
    (h.closure)(undecided.map(|t: Test| t.key)).functions,
    Map::new(),
    |accumulator: Map<Bytes, Bool>, n: Bytes| accumulator.insert(n, true),
  );
  h.definitions.fold([], |accumulator: List<Bytes>, name: Bytes, hash: Bytes|
    if implicated.contains(name) { accumulator } else { accumulator.push(hash) })
}

fn reachable_from_records(
  h: Hashes,
  records: List<{ key: Bytes, record: PassRecord }>,
) -> ReachableHashes / {abort.raise} =
  if records.len() == 0 { { functions: [], declarations: [] } } else {
    let reachable = (h.closure)(records.map(|e: { key: Bytes, record: PassRecord }| e.key));
    {
      functions: hashes_in(h.definitions, reachable.functions),
      declarations: hashes_in(h.declarations, reachable.declarations),
    }
  }

fn simulation_stats<d>(
  outcomes: List<Outcome<d>>,
  results: List<TestResult<d>>,
) -> SimulationStats = {
  let seeds = by_index(results.map(|r: TestResult<d>| { index: r.index, item: r.seeds }));
  outcomes.fold(
    {
      simulated: 0,
      total: outcomes.len(),
      seeds: 0,
      interleavings: 0,
      exhaustive: 0,
      exhausted: 0,
      failed: 0,
    },
    |accumulator: SimulationStats, o: Outcome<d>|
      match o.searched {
        None -> accumulator,
        Some(s) ->
          {
            ..accumulator,
            simulated: accumulator.simulated + 1,
            seeds: accumulator.seeds + (match seeds.get(o.index) { Some(n) -> n, None -> 0 }),
            interleavings: accumulator.interleavings + s.explored,
            exhaustive: accumulator.exhaustive + (if s.exhaustive { 1 } else { 0 }),
            exhausted: accumulator.exhausted + (if s.exhausted { 1 } else { 0 }),
            failed: accumulator.failed + (if s.failed { 1 } else { 0 }),
          },
      },
  )
}

pub fn conclude_run<d>(
  tests: List<Test>,
  h: Hashes,
  chosen: RunSelection,
  seen: Map<Bytes, Bool>,
  results: List<TestResult<d>>,
) -> Conclusion<d> / {abort.raise} = {
  let declared = by_index(tests.map(|t: Test| { index: t.index, item: t }));
  let suspicious = unseen_definitions(h, seen);
  let groups = group_of(chosen.groups);
  let ordered = sorted_by_index(results);
  let t: Tally<d> = ordered.fold(
    {
      outcomes: [],
      failures: [],
      passed: 0,
      failed: 0,
      timed_out: 0,
      notices: [],
      passes: [],
      codes: [],
      records: [],
    },
    |accumulator: Tally<d>, r: TestResult<d>|
      match declared.get(r.index) {
        None ->
          {
            ..accumulator,
            notices: accumulator.notices.push(
              StaleIndex({ index: r.index, declared: tests.len() }),
            ),
          },
        Some(declared_test) ->
          tally_result(accumulator, r, declared_test, h, chosen, suspicious, groups),
      },
  );
  {
    outcomes: t.outcomes,
    failures: t.failures,
    passed: t.passed,
    failed: t.failed,
    timed_out: t.timed_out,
    notices: t.notices,
    store_update: {
      passes: t.passes,
      code_passes: t.codes,
      records: t.records,
      seen: vouched_for(tests, h, chosen, t.outcomes),
      reachable: reachable_from_records(h, t.records),
    },
    simulation: simulation_stats(t.outcomes, ordered),
  }
}

fn a_test(index: Int, name: Bytes) -> Test =
  {
    index: index,
    key: b"m." ++ name,
    seeded: false,
    hash: Some(b"t" ++ Bytes::of_string(index.to_string())),
    start: b"m." ++ name,
    case: false,
  }

const snapshot: Bytes = b"era"

fn sample_hashes() -> Hashes =
  {
    definitions: Map::of_entries([
      { key: b"m.add", value: b"h_add" },
      { key: b"m.mul", value: b"h_mul" },
      { key: b"m.twice", value: b"h_twice" },
    ]),
    declarations: Map::new(),
    era: snapshot,
    closure: |keys: List<Bytes>| {
      let reachable_names = Map::of_entries([
        { key: b"m.adds", value: [b"m.add"] },
        { key: b"m.doubles", value: [b"m.twice", b"m.mul"] },
      ]);
      {
        functions: keys.fold([], |accumulator: List<Bytes>, k: Bytes|
          match reachable_names.get(k) {
            Some(names) -> names.fold(accumulator, |out: List<Bytes>, n: Bytes| out.push(n)),
            None -> accumulator,
          }),
        declarations: [],
      }
    },
  }

fn select_all(tests: List<Test>) -> RunSelection =
  {
    groups: [tests.map(|t: Test| t.index)],
    recorded: tests.fold(Map::new(), |accumulator: Map<Int, List<Bytes>>, t: Test|
      match t.hash { Some(h) -> accumulator.insert(t.index, [h]), None -> accumulator }),
    codes: tests.fold(Map::new(), |accumulator: Map<Int, List<Bytes>>, t: Test|
      accumulator.insert(t.index, [b"c" ++ Bytes::of_string(t.index.to_string())])),
    reasons: Map::new(),
    out_of_scope: [],
  }

fn passing(index: Int) -> TestResult<String> =
  {
    index: index,
    status: "passed",
    failure: None,
    host: false,
    trace: Some(b""),
    searched: None,
    seeds: 0,
  }

fn pass_of(key: Bytes) -> Pass = { key: key, trace: b"" }

fn failing(index: Int) -> TestResult<String> =
  { ..passing(index), status: "failed", failure: Some("assertion failed") }

const two_tests: List<Test> = [a_test(0, b"adds"), a_test(1, b"doubles")]

test "`conclude_run` stores a passing test under its test key and code key with a pass record, and stores nothing for a failing test" {
  let c = conclude_run(two_tests, sample_hashes(), select_all(two_tests), Map::new(), [
    passing(0),
    failing(1),
  ]);
  assert_eq(c.passed, 1);
  assert_eq(c.failed, 1);
  assert_eq(c.store_update.passes, [pass_of(b"t0")]);
  assert_eq(c.store_update.code_passes, [pass_of(b"c0")]);
  assert_eq(c.store_update.records, [
    { key: b"m.adds", record: { test: b"t0", era: snapshot, start: b"m.adds", case: false } },
  ]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(WrittenUnder([b"t0"])), None])
}

test "`conclude_run` writes the pass record of a test case with the key of its parent test and marks it as a case" {
  let case = { ..a_test(0, b"adds 1"), start: b"m.adds {n}", case: true };
  let c = conclude_run([case], sample_hashes(), select_all([case]), Map::new(), [passing(0)]);
  assert_eq(c.store_update.records.map(|e: { key: Bytes, record: PassRecord }| e.record), [
    { test: b"t0", era: snapshot, start: b"m.adds {n}", case: true },
  ])
}

test "a passing test records the hashes of the functions and effects it uses, and a failing test records none" {
  let h: Hashes = {
    definitions: Map::of_entries([
      { key: b"m.gz", value: b"h_fn" },
      { key: b"m.read", value: b"h_read" },
    ]),
    declarations: Map::of_entries([{ key: b"m.gz", value: b"h_effect" }]),
    era: snapshot,
    closure: |keys: List<Bytes>| { functions: [b"m.read"], declarations: [b"m.gz"] },
  };
  let c = conclude_run([a_test(0, b"reads")], h, select_all([a_test(0, b"reads")]), Map::new(), [
    passing(0),
  ]);
  assert_eq(c.store_update.reachable, { functions: [b"h_read"], declarations: [b"h_effect"] });
  let red = conclude_run(
    [a_test(0, b"reads")],
    h,
    select_all([a_test(0, b"reads")]),
    Map::new(),
    [failing(0)],
  );
  assert_eq(red.store_update.reachable, { functions: [], declarations: [] })
}

test "`conclude_run` records the definitions of a passing test as passed, but not those of a failing test" {
  let c = conclude_run(two_tests, sample_hashes(), select_all(two_tests), Map::new(), [
    passing(0),
    failing(1),
  ]);
  assert_eq(c.store_update.seen, [b"h_add"])
}

test "`conclude_run` records the definitions of a test with a cached result as passed, but not those of a selected test with no result" {
  let chosen = { ..select_all(two_tests), reasons: Map::new().insert(1, Cached) };
  let c = conclude_run(two_tests, sample_hashes(), chosen, Map::new(), [passing(0)]);
  assert_eq(c.store_update.seen, [b"h_add", b"h_mul", b"h_twice"]);
  let skipped = conclude_run(two_tests, sample_hashes(), select_all(two_tests), Map::new(), [
    passing(0),
  ]);
  assert_eq(skipped.store_update.seen, [b"h_add"])
}

test "a failing test reports as changed the definitions it depends on that the store has not recorded as passed" {
  let seen = Map::new().insert(b"h_mul", true);
  let c = conclude_run(two_tests, sample_hashes(), select_all(two_tests), seen, [failing(1)]);
  assert_eq(c.failures.map(|f: TestFailure<String>| f.changes), [[b"m.twice"]])
}

test "`conclude_run` records a pass with no read trace as untraced, counts a timed-out test as neither passed nor failed, and reports a panic as an internal error" {
  let untraced = { ..passing(0), host: true, trace: None };
  let stopped = { ..failing(1), status: "timed_out" };
  let c = conclude_run(two_tests, sample_hashes(), select_all(two_tests), Map::new(), [
    untraced,
    stopped,
  ]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Untraced), None]);
  assert_eq(c.timed_out, 1);
  assert_eq(c.failed, 0);
  assert_eq(c.store_update.passes, []);
  let internal_error = conclude_run(
    two_tests,
    sample_hashes(),
    select_all(two_tests),
    Map::new(),
    [{ ..failing(1), status: "panicked" }],
  );
  assert_eq(internal_error.failures.map(|f: TestFailure<String>| f.internal_error), [true])
}

test "`conclude_run` stores no pass for a seeded test with no search result or for a search that ran out of budget, and adds a notice only for the seeded test" {
  let seeded = [{ ..a_test(0, b"adds"), seeded: true }, a_test(1, b"doubles")];
  let spent = {
    ..passing(1),
    searched: Some({ explored: 4, exhaustive: false, exhausted: true, failed: false }),
  };
  let c = conclude_run(seeded, sample_hashes(), select_all(seeded), Map::new(), [
    passing(0),
    spent,
  ]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Unobserved), Some(Exhausted)]);
  assert_eq(c.store_update.passes, []);
  assert_eq(c.store_update.code_passes, []);
  assert_eq(c.notices, [UnobservedSearch(b"m.adds")]);
  assert_eq(c.simulation.exhausted, 1);
  assert_eq(c.simulation.interleavings, 4)
}

test "`conclude_run` adds a stale-index notice and no test outcome for a result whose test number the program does not declare" {
  let c = conclude_run(two_tests, sample_hashes(), select_all(two_tests), Map::new(), [passing(7)]);
  assert_eq(c.notices, [StaleIndex({ index: 7, declared: 2 })]);
  assert_eq(c.outcomes, [])
}

test "results come back in test order, each with the class it ran in" {
  let chosen = { ..select_all(two_tests), groups: [[1], [0]] };
  let c = conclude_run(two_tests, sample_hashes(), chosen, Map::new(), [passing(1), passing(0)]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.index), [0, 1]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.group), [1, 0])
}

fn search_summary(explored: Int, exhausted: Bool, failed: Bool) -> SearchSummary =
  { explored: explored, exhaustive: !exhausted && !failed, exhausted: exhausted, failed: failed }

test "a passing test is stored under exactly its recorded keys, including the per-seed keys of a seeded test" {
  let seeded = [{ ..a_test(0, b"adds"), seeded: true }];
  let chosen = {
    ..select_all(seeded),
    recorded: Map::new().insert(0, [b"plan", b"root 0", b"root 1"]),
  };
  let c = conclude_run(seeded, sample_hashes(), chosen, Map::new(), [
    { ..passing(0), searched: Some(search_summary(3, false, false)), seeds: 2 },
  ]);
  assert_eq(c.store_update.passes, [b"plan", b"root 0", b"root 1"].map(pass_of));
  assert_eq(c.simulation.seeds, 2);
  assert_eq(c.simulation.exhaustive, 1)
}

test "a search stopped at a failure is recorded under no key, and counted as failed" {
  let seeded = [{ ..a_test(0, b"adds"), seeded: true }];
  let c = conclude_run(seeded, sample_hashes(), select_all(seeded), Map::new(), [
    { ..failing(0), searched: Some(search_summary(5, false, true)), seeds: 1 },
  ]);
  assert_eq(c.store_update.passes, []);
  assert_eq(c.store_update.records, []);
  assert_eq(c.simulation.failed, 1);
  assert_eq(c.simulation.interleavings, 5)
}

test "an unseeded test whose search ran out of budget also stores no pass" {
  let c = conclude_run(two_tests, sample_hashes(), select_all(two_tests), Map::new(), [
    { ..passing(0), searched: Some(search_summary(9, true, false)) },
  ]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Exhausted)]);
  assert_eq(c.store_update.passes, [])
}

test "a passing test with no recorded keys is counted as passed but stores no pass" {
  let chosen = { ..select_all(two_tests), recorded: Map::new() };
  let c = conclude_run(two_tests, sample_hashes(), chosen, Map::new(), [passing(0)]);
  assert_eq(c.passed, 1);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [None]);
  assert_eq(c.store_update.passes, [])
}

test "the definitions used by a test outside the run's scope are never blamed for a later failure" {
  let chosen = { ..select_all(two_tests), out_of_scope: [1] };
  let c = conclude_run(two_tests, sample_hashes(), chosen, Map::new(), [passing(0)]);
  assert_eq(c.store_update.seen, [b"h_add", b"h_mul", b"h_twice"])
}

test "a passing test with no hash is stored under its keys but gets no record naming the test" {
  let unhashed = [{ ..a_test(0, b"adds"), hash: None }];
  let chosen = { ..select_all(unhashed), recorded: Map::new().insert(0, [b"k"]) };
  let c = conclude_run(unhashed, sample_hashes(), chosen, Map::new(), [passing(0)]);
  assert_eq(c.store_update.passes, [pass_of(b"k")]);
  assert_eq(c.store_update.records, [])
}

test "`conclude_run` stores a passing test that used the host with its trace of file reads, under both its test key and its code key" {
  let hosted = { ..passing(0), host: true, trace: Some(b"file\tcwd\ta.txt\tb3\n") };
  let c = conclude_run(two_tests, sample_hashes(), select_all(two_tests), Map::new(), [hosted]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(WrittenUnder([b"t0"]))]);
  assert_eq(c.store_update.passes, [{ key: b"t0", trace: b"file\tcwd\ta.txt\tb3\n" }]);
  assert_eq(c.store_update.code_passes, [{ key: b"c0", trace: b"file\tcwd\ta.txt\tb3\n" }])
}
