import std.list
import std.set (Set)
import select (Cached, KeptPass, Pass, Reason, passed_before)
import reads (Checkable, Unchecked, RecordedRead, ReadPath, ReadShippedNames, UnderRoot, WholeFile,
              trace_of)

pub type SearchSummary = { explored: Int, exhaustive: Bool, exhausted: Bool, failed: Bool }

pub type TestResult<d> = {
  index: Int,
  status: String,
  failure: Option<d>,
  host: Bool,
  trace: Option<Bytes>,
  searched: Option<SearchSummary>,
  seeds: Int,
}

pub type Test = { index: Int, key: Bytes, seeded: Bool, hash: Bytes, start: Bytes, case: Bool }

pub type RunSelection = {
  groups: List<List<Int>>,
  recorded: Map<Int, List<Bytes>>,
  codes: Map<Int, List<Bytes>>,
  reasons: Map<Int, Reason>,
}

pub type Record = | WrittenUnder(List<Bytes>) | Exhausted | Unobserved | Untraced

pub fn is_written(r: Record) -> Bool = match r { WrittenUnder(_) -> true, _ -> false }

pub fn record_under(
  recorded: List<Bytes>,
  seeded: Bool,
  search_summary: Option<SearchSummary>,
) -> Record =
  match search_summary {
    None -> if seeded { Unobserved } else { WrittenUnder(recorded) },
    Some(s) -> if s.failed || s.exhausted { Exhausted } else { WrittenUnder(recorded) },
  }

pub type Outcome<d> = {
  index: Int,
  status: String,
  failure: Option<d>,
  searched: Option<SearchSummary>,
  group: Int,
  recorded: Option<Record>,
}

pub type TestFailure<d> = {
  index: Int,
  key: Bytes,
  failure: d,
  internal_error: Bool,
  host: Bool,
  changes: List<Bytes>,
}

pub type PassRecord = {
  test: Bytes,
  era: Bytes,
  start: Bytes,
  case: Bool,
  passes: List<Bytes>,
  codes: List<Bytes>,
}

pub type StoreUpdate = {
  passes: List<Pass>,
  code_passes: List<Pass>,
  records: List<{ key: Bytes, record: PassRecord }>,
}

pub type Notice = | StaleIndex({ index: Int, declared: Int }) | UnobservedSearch(Bytes)

pub type SimulationStats = {
  simulated: Int,
  total: Int,
  seeds: Int,
  interleavings: Int,
  exhaustive: Int,
  exhausted: Int,
  failed: Int,
}

pub type Conclusion<d> = {
  outcomes: List<Outcome<d>>,
  failures: List<TestFailure<d>>,
  passed: Int,
  failed: Int,
  timed_out: Int,
  notices: List<Notice>,
  store_update: StoreUpdate,
  simulation: SimulationStats,
}

type Tally<d> = {
  outcomes: List<Outcome<d>>,
  failures: List<TestFailure<d>>,
  passed: Int,
  failed: Int,
  timed_out: Int,
  notices: List<Notice>,
  passes: List<Pass>,
  codes: List<Pass>,
  records: List<{ key: Bytes, record: PassRecord }>,
}

fn by_index<a>(xs: List<{ index: Int, item: a }>) -> Map<Int, a> =
  xs.fold(Map::new(), |accumulator: Map<Int, a>, x: { index: Int, item: a }|
    accumulator.insert(x.index, x.item))

fn sorted_by_index<d>(results: List<TestResult<d>>) -> List<TestResult<d>> = {
  let results_by_index = by_index(results.map(|r: TestResult<d>| { index: r.index, item: r }));
  results_by_index.values()
}

fn group_of(groups: List<List<Int>>) -> Map<Int, Int> =
  range(0, groups.len()).fold(Map::new(), |accumulator: Map<Int, Int>, g: Int|
    match groups.at(g) {
      Some(class) -> class.fold(accumulator, |into: Map<Int, Int>, i: Int| into.insert(i, g)),
      None -> accumulator,
    })

pub type Recorded = { record: Option<Record>, update: StoreUpdate }

pub const nothing_stored: StoreUpdate = { passes: [], code_passes: [], records: [] }

pub fn recorded_pass<d>(
  r: TestResult<d>,
  declared: Test,
  era: Bytes,
  chosen: RunSelection,
) -> Recorded =
  match r.trace {
    None -> untraced,
    Some(text) -> match trace_of(text) {
      Unchecked(_) -> untraced,
      Checkable(reads) -> recorded_with(reads, r, declared, era, chosen),
    },
  }

const untraced: Recorded = { record: Some(Untraced), update: nothing_stored }

fn recorded_with<d>(
  reads: List<RecordedRead>,
  r: TestResult<d>,
  declared: Test,
  era: Bytes,
  chosen: RunSelection,
) -> Recorded =
  match chosen.recorded.get(r.index) {
    None -> { record: None, update: nothing_stored },
    Some(keys) -> {
      let record = record_under(keys, declared.seeded, r.searched);
      let written = match record { WrittenUnder(under) -> under, _ -> [] };
      let coded = match chosen.codes.get(r.index) {
        Some(cs) -> if is_written(record) { cs } else { [] },
        None -> [],
      };
      {
        record: Some(record),
        update: {
          passes: written.map(|k: Bytes| { key: k, reads: reads }),
          code_passes: coded.map(|k: Bytes| { key: k, reads: reads }),
          records: if is_written(record) {
            [
              {
                key: declared.key,
                record: {
                  test: declared.hash,
                  era: era,
                  start: declared.start,
                  case: declared.case,
                  passes: written,
                  codes: coded,
                },
              },
            ]
          } else { [] },
        },
      }
    },
  }

pub fn kept_update(
  tests: List<Test>,
  era: Bytes,
  kept_passes: List<KeptPass>,
) -> StoreUpdate / {abort.raise} = {
  let declared = by_index(tests.map(|t: Test| { index: t.index, item: t }));
  kept_passes.fold(nothing_stored, |update: StoreUpdate, k: KeptPass| {
    let t = match declared.get(k.index) {
      Some(t) -> t,
      None -> panic("a pass kept by its code names no test of the run"),
    };
    {
      passes: update.passes.concat(k.keys.map(|key: Bytes| { key: key, reads: k.reads })),
      code_passes: update.code_passes,
      records: update.records.push({
        key: t.key,
        record: {
          test: t.hash,
          era: era,
          start: t.start,
          case: t.case,
          passes: k.keys,
          codes: [k.code],
        },
      }),
    }
  })
}

pub fn stored_by<d>(
  r: TestResult<d>,
  declared: Test,
  era: Bytes,
  chosen: RunSelection,
) -> StoreUpdate =
  match r.failure {
    Some(_) -> nothing_stored,
    None -> if r.status == "timed_out" { nothing_stored }
    else { recorded_pass(r, declared, era, chosen).update },
  }

fn tally_result<d>(
  t: Tally<d>,
  r: TestResult<d>,
  declared: Test,
  era: Bytes,
  chosen: RunSelection,
  changes: (Bytes) -> List<Bytes> / {abort.raise},
  groups: Map<Int, Int>,
) -> Tally<d> / {abort.raise} = {
  let outcome = |recorded: Option<Record>|
    {
      index: r.index,
      status: r.status,
      failure: r.failure,
      searched: r.searched,
      group: match groups.get(r.index) { Some(g) -> g, None -> chosen.groups.len() },
      recorded: recorded,
    };
  if r.status == "timed_out" {
    { ..t, outcomes: t.outcomes.push(outcome(None)), timed_out: t.timed_out + 1 }
  } else {
    match r.failure {
      Some(failure) ->
        {
          ..t,
          outcomes: t.outcomes.push(outcome(None)),
          failed: t.failed + 1,
          failures: t.failures.push({
            index: r.index,
            key: declared.key,
            failure: failure,
            internal_error: r.status == "panicked",
            host: r.host,
            changes: changes(declared.key),
          }),
        },
      None -> {
        let recorded = recorded_pass(r, declared, era, chosen);
        {
          ..t,
          outcomes: t.outcomes.push(outcome(recorded.record)),
          passed: t.passed + 1,
          notices: if recorded.record == Some(Unobserved) {
            t.notices.push(UnobservedSearch(declared.key))
          } else { t.notices },
          passes: t.passes.concat(recorded.update.passes),
          codes: t.codes.concat(recorded.update.code_passes),
          records: t.records.concat(recorded.update.records),
        }
      },
    }
  }
}

pub fn undecided<d>(
  tests: List<Test>,
  chosen: RunSelection,
  outcomes: List<Outcome<d>>,
) -> List<Bytes> = {
  let proven = outcomes.fold(Set::empty(), |accumulator: Set<Int>, o: Outcome<d>|
    if o.status == "passed" { accumulator.insert(o.index) } else { accumulator });
  tests.filter(|t: Test| {
    let green = match chosen.reasons.get(t.index) { Some(r) -> passed_before(r), None -> false };
    !green && !proven.contains(t.index)
  }).map(|t: Test| t.key)
}

fn simulation_stats<d>(
  outcomes: List<Outcome<d>>,
  results: List<TestResult<d>>,
) -> SimulationStats = {
  let seeds = by_index(results.map(|r: TestResult<d>| { index: r.index, item: r.seeds }));
  outcomes.fold(
    {
      simulated: 0,
      total: outcomes.len(),
      seeds: 0,
      interleavings: 0,
      exhaustive: 0,
      exhausted: 0,
      failed: 0,
    },
    |accumulator: SimulationStats, o: Outcome<d>|
      match o.searched {
        None -> accumulator,
        Some(s) ->
          {
            ..accumulator,
            simulated: accumulator.simulated + 1,
            seeds: accumulator.seeds + (match seeds.get(o.index) { Some(n) -> n, None -> 0 }),
            interleavings: accumulator.interleavings + s.explored,
            exhaustive: accumulator.exhaustive + (if s.exhaustive { 1 } else { 0 }),
            exhausted: accumulator.exhausted + (if s.exhausted { 1 } else { 0 }),
            failed: accumulator.failed + (if s.failed { 1 } else { 0 }),
          },
      },
  )
}

pub fn conclude_run<d>(
  tests: List<Test>,
  era: Bytes,
  chosen: RunSelection,
  changes: (Bytes) -> List<Bytes> / {abort.raise},
  results: List<TestResult<d>>,
) -> Conclusion<d> / {abort.raise} = {
  let declared = by_index(tests.map(|t: Test| { index: t.index, item: t }));
  let groups = group_of(chosen.groups);
  let ordered = sorted_by_index(results);
  let t: Tally<d> = ordered.fold(
    {
      outcomes: [],
      failures: [],
      passed: 0,
      failed: 0,
      timed_out: 0,
      notices: [],
      passes: [],
      codes: [],
      records: [],
    },
    |accumulator: Tally<d>, r: TestResult<d>|
      match declared.get(r.index) {
        None ->
          {
            ..accumulator,
            notices: accumulator.notices.push(
              StaleIndex({ index: r.index, declared: tests.len() }),
            ),
          },
        Some(declared_test) ->
          tally_result(accumulator, r, declared_test, era, chosen, changes, groups),
      },
  );
  {
    outcomes: t.outcomes,
    failures: t.failures,
    passed: t.passed,
    failed: t.failed,
    timed_out: t.timed_out,
    notices: t.notices,
    store_update: { passes: t.passes, code_passes: t.codes, records: t.records },
    simulation: simulation_stats(t.outcomes, ordered),
  }
}

fn a_test(index: Int, name: Bytes) -> Test =
  {
    index: index,
    key: b"m." ++ name,
    seeded: false,
    hash: b"t" ++ Bytes::of_string(index.to_string()),
    start: b"m." ++ name,
    case: false,
  }

const snapshot: Bytes = b"era"

fn no_changes(key: Bytes) -> List<Bytes> = []

fn select_all(tests: List<Test>) -> RunSelection =
  {
    groups: [tests.map(|t: Test| t.index)],
    recorded: tests.fold(Map::new(), |accumulator: Map<Int, List<Bytes>>, t: Test|
      accumulator.insert(t.index, [t.hash])),
    codes: tests.fold(Map::new(), |accumulator: Map<Int, List<Bytes>>, t: Test|
      accumulator.insert(t.index, [b"c" ++ Bytes::of_string(t.index.to_string())])),
    reasons: Map::new(),
  }

fn passing(index: Int) -> TestResult<String> =
  {
    index: index,
    status: "passed",
    failure: None,
    host: false,
    trace: Some(b""),
    searched: None,
    seeds: 0,
  }

fn pass_of(key: Bytes) -> Pass = { key: key, reads: [] }

fn failing(index: Int) -> TestResult<String> =
  { ..passing(index), status: "failed", failure: Some("assertion failed") }

const two_tests: List<Test> = [a_test(0, b"adds"), a_test(1, b"doubles")]

test "`conclude_run` stores a passing test under its test key and code key with a pass record, and stores nothing for a failing test" {
  let c = conclude_run(two_tests, snapshot, select_all(two_tests), no_changes, [
    passing(0),
    failing(1),
  ]);
  assert_eq(c.passed, 1);
  assert_eq(c.failed, 1);
  assert_eq(c.store_update.passes, [pass_of(b"t0")]);
  assert_eq(c.store_update.code_passes, [pass_of(b"c0")]);
  assert_eq(c.store_update.records, [
    {
      key: b"m.adds",
      record: {
        test: b"t0",
        era: snapshot,
        start: b"m.adds",
        case: false,
        passes: [b"t0"],
        codes: [b"c0"],
      },
    },
  ]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(WrittenUnder([b"t0"])), None])
}

test "`stored_by` stores what `conclude_run` stores for one result, and nothing for a failure or a timeout" {
  let chosen = select_all(two_tests);
  let one = |r: TestResult<String>| stored_by(r, a_test(r.index, b"adds"), snapshot, chosen);
  let whole = |r: TestResult<String>|
    conclude_run([a_test(r.index, b"adds")], snapshot, chosen, no_changes, [r]).store_update;
  assert_eq(one(passing(0)), whole(passing(0)));
  assert_eq(one(failing(0)), nothing_stored);
  assert_eq(one({ ..passing(0), status: "timed_out" }), nothing_stored)
}

test "`conclude_run` writes the pass record of a test case with the key of its parent test and marks it as a case" {
  let case = { ..a_test(0, b"adds 1"), start: b"m.adds {n}", case: true };
  let c = conclude_run([case], snapshot, select_all([case]), no_changes, [passing(0)]);
  assert_eq(c.store_update.records.map(|e: { key: Bytes, record: PassRecord }| e.record), [
    {
      test: b"t0",
      era: snapshot,
      start: b"m.adds {n}",
      case: true,
      passes: [b"t0"],
      codes: [b"c0"],
    },
  ])
}

test "a failing test and a selected test with no result are undecided, and a passing or cached test is not" {
  let chosen = { ..select_all(two_tests), reasons: Map::new().insert(1, Cached) };
  let cached = conclude_run(two_tests, snapshot, chosen, no_changes, [passing(0)]);
  assert_eq(undecided(two_tests, chosen, cached.outcomes), []);
  let all = select_all(two_tests);
  let red = conclude_run(two_tests, snapshot, all, no_changes, [passing(0), failing(1)]);
  assert_eq(undecided(two_tests, all, red.outcomes), [b"m.doubles"]);
  let skipped = conclude_run(two_tests, snapshot, all, no_changes, [passing(0)]);
  assert_eq(undecided(two_tests, all, skipped.outcomes), [b"m.doubles"])
}

test "a failing test carries the changes it is given" {
  let c = conclude_run(two_tests, snapshot, select_all(two_tests), |key: Bytes| [key], [
    failing(1),
  ]);
  assert_eq(c.failures.map(|f: TestFailure<String>| f.changes), [[b"m.doubles"]])
}

test "a pass kept by its code is written with a pass record that lists its keys and its code" {
  let update = kept_update([a_test(0, b"a")], snapshot, [
    { index: 0, keys: [b"k0"], code: b"c0", reads: [] },
  ]);
  assert_eq(update.passes, [{ key: b"k0", reads: [] }]);
  assert_eq(update.records, [
    {
      key: b"m.a",
      record: {
        test: b"t0",
        era: snapshot,
        start: b"m.a",
        case: false,
        passes: [b"k0"],
        codes: [b"c0"],
      },
    },
  ])
}

test "`conclude_run` records a pass with no read trace as untraced, counts a timed-out test as neither passed nor failed, and reports a panic as an internal error" {
  let untraced = { ..passing(0), host: true, trace: None };
  let stopped = { ..failing(1), status: "timed_out" };
  let c = conclude_run(two_tests, snapshot, select_all(two_tests), no_changes, [untraced, stopped]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Untraced), None]);
  assert_eq(c.timed_out, 1);
  assert_eq(c.failed, 0);
  assert_eq(c.store_update.passes, []);
  let internal_error = conclude_run(two_tests, snapshot, select_all(two_tests), no_changes, [
    { ..failing(1), status: "panicked" },
  ]);
  assert_eq(internal_error.failures.map(|f: TestFailure<String>| f.internal_error), [true])
}

test "`conclude_run` stores no pass for a seeded test with no search result or for a search that ran out of budget, and adds a notice only for the seeded test" {
  let seeded = [{ ..a_test(0, b"adds"), seeded: true }, a_test(1, b"doubles")];
  let spent = {
    ..passing(1),
    searched: Some({ explored: 4, exhaustive: false, exhausted: true, failed: false }),
  };
  let c = conclude_run(seeded, snapshot, select_all(seeded), no_changes, [passing(0), spent]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Unobserved), Some(Exhausted)]);
  assert_eq(c.store_update.passes, []);
  assert_eq(c.store_update.code_passes, []);
  assert_eq(c.notices, [UnobservedSearch(b"m.adds")]);
  assert_eq(c.simulation.exhausted, 1);
  assert_eq(c.simulation.interleavings, 4)
}

test "`conclude_run` adds a stale-index notice and no test outcome for a result whose test number the program does not declare" {
  let c = conclude_run(two_tests, snapshot, select_all(two_tests), no_changes, [passing(7)]);
  assert_eq(c.notices, [StaleIndex({ index: 7, declared: 2 })]);
  assert_eq(c.outcomes, [])
}

test "results come back in test order, each with the class it ran in" {
  let chosen = { ..select_all(two_tests), groups: [[1], [0]] };
  let c = conclude_run(two_tests, snapshot, chosen, no_changes, [passing(1), passing(0)]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.index), [0, 1]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.group), [1, 0])
}

fn search_summary(explored: Int, exhausted: Bool, failed: Bool) -> SearchSummary =
  { explored: explored, exhaustive: !exhausted && !failed, exhausted: exhausted, failed: failed }

test "a passing test is stored under exactly its recorded keys, including the per-seed keys of a seeded test" {
  let seeded = [{ ..a_test(0, b"adds"), seeded: true }];
  let chosen = {
    ..select_all(seeded),
    recorded: Map::new().insert(0, [b"plan", b"root 0", b"root 1"]),
  };
  let c = conclude_run(seeded, snapshot, chosen, no_changes, [
    { ..passing(0), searched: Some(search_summary(3, false, false)), seeds: 2 },
  ]);
  assert_eq(c.store_update.passes, [b"plan", b"root 0", b"root 1"].map(pass_of));
  assert_eq(c.simulation.seeds, 2);
  assert_eq(c.simulation.exhaustive, 1)
}

test "a search stopped at a failure is recorded under no key, and counted as failed" {
  let seeded = [{ ..a_test(0, b"adds"), seeded: true }];
  let c = conclude_run(seeded, snapshot, select_all(seeded), no_changes, [
    { ..failing(0), searched: Some(search_summary(5, false, true)), seeds: 1 },
  ]);
  assert_eq(c.store_update.passes, []);
  assert_eq(c.store_update.records, []);
  assert_eq(c.simulation.failed, 1);
  assert_eq(c.simulation.interleavings, 5)
}

test "an unseeded test whose search ran out of budget also stores no pass" {
  let c = conclude_run(two_tests, snapshot, select_all(two_tests), no_changes, [
    { ..passing(0), searched: Some(search_summary(9, true, false)) },
  ]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Exhausted)]);
  assert_eq(c.store_update.passes, [])
}

test "a passing test with no recorded keys is counted as passed but stores no pass" {
  let chosen = { ..select_all(two_tests), recorded: Map::new() };
  let c = conclude_run(two_tests, snapshot, chosen, no_changes, [passing(0)]);
  assert_eq(c.passed, 1);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [None]);
  assert_eq(c.store_update.passes, [])
}

test "`conclude_run` stores a passing test that used the host with the reads of its trace, under both its test key and its code key" {
  let hosted = { ..passing(0), host: true, trace: Some(b"file\tcwd\ta.txt\t\tb3\n") };
  let c = conclude_run(two_tests, snapshot, select_all(two_tests), no_changes, [hosted]);
  let reads = [
    {
      read: ReadPath({
        how: WholeFile,
        place: UnderRoot({ root: b"cwd", path: b"a.txt" }),
        own: [],
      }),
      digest: b"b3",
    },
  ];
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(WrittenUnder([b"t0"]))]);
  assert_eq(c.store_update.passes, [{ key: b"t0", reads: reads }]);
  assert_eq(c.store_update.code_passes, [{ key: b"c0", reads: reads }])
}

test "`conclude_run` stores no pass for a passing test whose trace names a read that cannot be checked again" {
  let unchecked = { ..passing(0), host: true, trace: Some(b"file\tcwd\ta.txt\tb3\n") };
  let c = conclude_run(two_tests, snapshot, select_all(two_tests), no_changes, [unchecked]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Untraced)]);
  assert_eq(c.store_update.passes, []);
  assert_eq(c.store_update.code_passes, [])
}

test "`conclude_run` stores a pass for a passing test that read the list of shipped modules" {
  let listed = { ..passing(0), host: true, trace: Some(b"shipped\t\tn1\n") };
  let c = conclude_run(two_tests, snapshot, select_all(two_tests), no_changes, [listed]);
  let reads = [{ read: ReadShippedNames, digest: b"n1" }];
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(WrittenUnder([b"t0"]))]);
  assert_eq(c.store_update.passes, [{ key: b"t0", reads: reads }]);
  assert_eq(c.store_update.code_passes, [{ key: b"c0", reads: reads }])
}
