//! `conclude` — what a run came to: each test's status, the keys a green verdict is filed under or
//! why it is filed under none, what each failure is suspected of, and which definitions the store
//! may record as seen. The runtime ran the tests; what their results establish is decided here.

import std.list
import select (Cached, Pass, Reason, passed_before)

/// A search a seeded test ran, as concluding reads it.
pub type Searched = { explored: Int, exhaustive: Bool, exhausted: Bool, failed: Bool }

/// One test the run executed, generic over how a failure is said.
pub type Ran<d> = {
  index: Int,
  /// `passed`, `failed`, `panicked` or `abandoned`.
  status: String,
  failure: Option<d>,
  /// The run reached a host handler, so running it again acts on the world again.
  host: Bool,
  /// What the run read, which its pass is filed with; `None` when no trace stands in for it.
  trace: Option<Bytes>,
  /// `None` for a test that ran once, and for a search no interleaving of which was observed.
  searched: Option<Searched>,
  /// The roots its search started from.
  seeds: Int,
}

/// One test the program declares.
pub type Test = { index: Int, key: String, seeded: Bool, hash: Option<String> }

/// What some tests reach: each function, and each type or effect, by name. A function and an effect
/// may share a name, and reaching one is not reaching the other.
pub type Reached = { fns: List<String>, decls: List<String> }

/// The program's hashes by name, and what the tests whose keys it is handed reach.
pub type Hashes = {
  defs: Map<String, String>,
  decls: Map<String, String>,
  closure: (List<String>) -> Reached / {abort.raise},
}

/// What the run was told: the classes it ran, the keys each running test's pass is filed under and
/// those it is filed under by the code the test ran, the reason for every test, and the tests it was
/// never asked to decide.
pub type Chosen = {
  groups: List<List<Int>>,
  filed: Map<Int, List<String>>,
  codes: Map<Int, List<String>>,
  reasons: Map<Int, Reason>,
  out_of_scope: List<Int>,
}

/// Where a green verdict is written, or why it is not.
pub type Record =
  /// Under each of these keys, in order.
  | Under(List<String>)
  /// The search spent its budget, or stopped at a failure.
  | Exhausted
  /// The footprint reads a seed and no search was observed.
  | Unobserved
  /// The run did something no trace stands in for.
  | Untraced

pub fn written(r: Record) -> Bool = match r { Under(_) -> true, _ -> false }

/// A spent budget or an unobserved search proved nothing, seeded or not: a handler can hide the seed
/// a region reads, and the region still searched.
pub fn record_under(filed: List<String>, seeded: Bool, searched: Option<Searched>) -> Record =
  match searched {
    None -> if seeded { Unobserved } else { Under(filed) },
    Some(s) -> if s.failed || s.exhausted { Exhausted } else { Under(filed) },
  }

pub type Outcome<d> = {
  index: Int,
  status: String,
  failure: Option<d>,
  searched: Option<Searched>,
  /// The class it ran in; one past the last for a test no class names.
  group: Int,
  /// `None` when no pass was filed for it at all.
  recorded: Option<Record>,
}

pub type Failed<d> = {
  index: Int,
  key: String,
  failure: d,
  /// Ply's fault rather than the program's: nothing in the definition graph to attribute.
  defect: Bool,
  /// The failing run reached a host handler, so re-running it acts on the world again.
  host: Bool,
  /// Definitions in the test's closure the store had never seen, ascending, the test aside.
  suspects: List<String>,
}

pub type Named = { name: String, hash: String }

/// The definition set a test passed at: its hash, and the hash of every function and declaration
/// in its closure, by name, since names are how two eras of a program are lined up.
pub type PassRecord = { test: String, closure: List<Named>, decls: List<Named> }

/// What the store is told: passes by key and by the code their tests ran, pass records by test, and
/// the definitions it may record as seen.
pub type Filing = {
  passes: List<Pass>,
  codes: List<Pass>,
  records: List<{ key: String, record: PassRecord }>,
  seen: List<String>,
}

/// Something about the run itself rather than about any test.
pub type Notice =
  /// The program ran a test index the program does not declare.
  | StaleIndex({ index: Int, declared: Int })
  /// A test reading a seed passed with no search observed, named by its key.
  | UnobservedSearch(String)

pub type Simulated = {
  simulated: Int,
  /// Every test the run executed, simulated or not.
  total: Int,
  seeds: Int,
  interleavings: Int,
  /// Searches that emptied their frontier, and searches that spent their budget.
  exhaustive: Int,
  exhausted: Int,
  failed: Int,
}

pub type Concluded<d> = {
  /// Every test that ran, in index order.
  outcomes: List<Outcome<d>>,
  failures: List<Failed<d>>,
  passed: Int,
  failed: Int,
  /// The wall clock stopped these: no verdict, so the run is no success either.
  abandoned: Int,
  notices: List<Notice>,
  filing: Filing,
  simulation: Simulated,
}

type Tally<d> = {
  outcomes: List<Outcome<d>>,
  failures: List<Failed<d>>,
  passed: Int,
  failed: Int,
  abandoned: Int,
  notices: List<Notice>,
  passes: List<Pass>,
  codes: List<Pass>,
  records: List<{ key: String, record: PassRecord }>,
}

fn by_index<a>(xs: List<{ index: Int, item: a }>) -> Map<Int, a> =
  xs.fold(Map::new(), |acc: Map<Int, a>, x: { index: Int, item: a }| acc.insert(x.index, x.item))

fn sorted_ran<d>(ran: List<Ran<d>>) -> List<Ran<d>> = {
  let held = by_index(ran.map(|r: Ran<d>| { index: r.index, item: r }));
  held.values()
}

fn names_in(m: Map<String, String>, names: List<String>) -> List<Named> =
  names.fold([], |acc: List<Named>, name: String|
    match m.get(name) { Some(h) -> acc.push({ name: name, hash: h }), None -> acc })

fn closure_of(h: Hashes, key: String) -> Reached / {abort.raise} = {
  let reached = (h.closure)([key]);
  { fns: reached.fns.sort(), decls: reached.decls.sort() }
}

/// The record a passing test is filed with: its own hash and its closure's.
pub fn pass_record(h: Hashes, key: String, own: String) -> PassRecord / {abort.raise} = {
  let reached = closure_of(h, key);
  { test: own, closure: names_in(h.defs, reached.fns), decls: names_in(h.decls, reached.decls) }
}

/// Definitions whose current hash the store had never seen.
fn changed(h: Hashes, seen: Map<String, Bool>) -> Map<String, Bool> =
  h.defs.fold(Map::new(), |acc: Map<String, Bool>, name: String, hash: String|
    match seen.get(hash) {
      Some(known) -> if known { acc } else { acc.insert(name, true) },
      None -> acc.insert(name, true),
    })

/// The functions test `key` reaches that moved: the prelude's are the language's, which code the
/// emitter writes reaches though no text names it, so never the program's suspects.
fn suspects_of(h: Hashes, key: String, changed: Map<String, Bool>) -> List<String> / {abort.raise} =
  closure_of(h, key).fns.filter(|name: String|
    changed.contains(name) && !name.starts_with("std.prelude."))

fn group_of(groups: List<List<Int>>) -> Map<Int, Int> =
  range(0, groups.len()).fold(Map::new(), |acc: Map<Int, Int>, g: Int|
    match groups.at(g) {
      Some(class) -> class.fold(acc, |into: Map<Int, Int>, i: Int| into.insert(i, g)),
      None -> acc,
    })

fn one<d>(
  t: Tally<d>,
  r: Ran<d>,
  declared: Test,
  h: Hashes,
  chosen: Chosen,
  changed: Map<String, Bool>,
  groups: Map<Int, Int>,
) -> Tally<d> / {abort.raise} = {
  let outcome = |recorded: Option<Record>|
    {
      index: r.index,
      status: r.status,
      failure: r.failure,
      searched: r.searched,
      group: match groups.get(r.index) { Some(g) -> g, None -> chosen.groups.len() },
      recorded: recorded,
    };
  if r.status == "abandoned" {
    // The clock is a fact about this machine: no verdict, no suspects, nothing stored.
    { ..t, outcomes: t.outcomes.push(outcome(None)), abandoned: t.abandoned + 1 }
  } else {
    match r.failure {
      Some(failure) ->
        {
          ..t,
          outcomes: t.outcomes.push(outcome(None)),
          failed: t.failed + 1,
          failures: t.failures.push({
            index: r.index,
            key: declared.key,
            failure: failure,
            defect: r.status == "panicked",
            host: r.host,
            suspects: suspects_of(h, declared.key, changed),
          }),
        },
      None -> match r.trace {
        None -> { ..t, outcomes: t.outcomes.push(outcome(Some(Untraced))), passed: t.passed + 1 },
        Some(trace) -> match chosen.filed.get(r.index) {
          None -> { ..t, outcomes: t.outcomes.push(outcome(None)), passed: t.passed + 1 },
          Some(keys) -> {
            let record = record_under(keys, declared.seeded, r.searched);
            let noticed = match record {
              Unobserved -> t.notices.push(UnobservedSearch(declared.key)),
              _ -> t.notices,
            };
            let passes = match record {
              Under(under) ->
                under.fold(t.passes, |acc: List<Pass>, k: String|
                  acc.push({ key: k, trace: trace })),
              _ -> t.passes,
            };
            let codes = match chosen.codes.get(r.index) {
              Some(cs) -> if written(record) {
                cs.fold(t.codes, |acc: List<Pass>, k: String| acc.push({ key: k, trace: trace }))
              } else { t.codes },
              None -> t.codes,
            };
            let records = match declared.hash {
              Some(hash) -> if written(record) {
                t.records.push({ key: declared.key, record: pass_record(h, declared.key, hash) })
              } else { t.records },
              None -> t.records,
            };
            {
              ..t,
              outcomes: t.outcomes.push(outcome(Some(record))),
              passed: t.passed + 1,
              notices: noticed,
              passes: passes,
              codes: codes,
              records: records,
            }
          },
        },
      },
    }
  }
}

/// Every definition but those a failed, or never decided, test reached: a red test does not vouch
/// for what it exercised, and a skipped one vouches for nothing.
fn vouched_for<d>(
  tests: List<Test>,
  h: Hashes,
  chosen: Chosen,
  outcomes: List<Outcome<d>>,
) -> List<String> / {abort.raise} = {
  let proven = outcomes.fold(Map::new(), |acc: Map<Int, Bool>, o: Outcome<d>|
    if o.status == "passed" { acc.insert(o.index, true) } else { acc });
  let out = chosen.out_of_scope.fold(Map::new(), |acc: Map<Int, Bool>, i: Int| acc.insert(i, true));
  let undecided = tests.filter(|t: Test| {
    let green = match chosen.reasons.get(t.index) { Some(r) -> passed_before(r), None -> false };
    !out.contains(t.index) && !green && !proven.contains(t.index)
  });
  let implicated = List::fold(
    (h.closure)(undecided.map(|t: Test| t.key)).fns,
    Map::new(),
    |acc: Map<String, Bool>, n: String| acc.insert(n, true),
  );
  h.defs.fold([], |acc: List<String>, name: String, hash: String|
    if implicated.contains(name) { acc } else { acc.push(hash) })
}

fn simulated<d>(outcomes: List<Outcome<d>>, ran: List<Ran<d>>) -> Simulated = {
  let seeds = by_index(ran.map(|r: Ran<d>| { index: r.index, item: r.seeds }));
  outcomes.fold(
    {
      simulated: 0,
      total: outcomes.len(),
      seeds: 0,
      interleavings: 0,
      exhaustive: 0,
      exhausted: 0,
      failed: 0,
    },
    |acc: Simulated, o: Outcome<d>|
      match o.searched {
        None -> acc,
        Some(s) ->
          {
            ..acc,
            simulated: acc.simulated + 1,
            seeds: acc.seeds + (match seeds.get(o.index) { Some(n) -> n, None -> 0 }),
            interleavings: acc.interleavings + s.explored,
            exhaustive: acc.exhaustive + (if s.exhaustive { 1 } else { 0 }),
            exhausted: acc.exhausted + (if s.exhausted { 1 } else { 0 }),
            failed: acc.failed + (if s.failed { 1 } else { 0 }),
          },
      },
  )
}

/// What the run came to, in test order. `seen` is whether the store had seen each definition's
/// hash before this run, which is what a failure's suspects are judged against.
pub fn concluded<d>(
  tests: List<Test>,
  h: Hashes,
  chosen: Chosen,
  seen: Map<String, Bool>,
  ran: List<Ran<d>>,
) -> Concluded<d> / {abort.raise} = {
  let declared = by_index(tests.map(|t: Test| { index: t.index, item: t }));
  let suspicious = changed(h, seen);
  let groups = group_of(chosen.groups);
  let ordered = sorted_ran(ran);
  let t: Tally<d> = ordered.fold(
    {
      outcomes: [],
      failures: [],
      passed: 0,
      failed: 0,
      abandoned: 0,
      notices: [],
      passes: [],
      codes: [],
      records: [],
    },
    |acc: Tally<d>, r: Ran<d>|
      match declared.get(r.index) {
        None ->
          {
            ..acc,
            notices: acc.notices.push(StaleIndex({ index: r.index, declared: tests.len() })),
          },
        Some(declared_test) -> one(acc, r, declared_test, h, chosen, suspicious, groups),
      },
  );
  {
    outcomes: t.outcomes,
    failures: t.failures,
    passed: t.passed,
    failed: t.failed,
    abandoned: t.abandoned,
    notices: t.notices,
    filing: {
      passes: t.passes,
      codes: t.codes,
      records: t.records,
      seen: vouched_for(tests, h, chosen, t.outcomes),
    },
    simulation: simulated(t.outcomes, ordered),
  }
}

// --- Tests ------------------------------------------------------------------

fn a_test(index: Int, name: String) -> Test =
  { index: index, key: "m." ++ name, seeded: false, hash: Some("t" ++ index.to_string()) }

fn a_program() -> Hashes =
  {
    defs: Map::of_entries([
      { key: "m.add", value: "h_add" },
      { key: "m.mul", value: "h_mul" },
      { key: "m.twice", value: "h_twice" },
    ]),
    decls: Map::new(),
    closure: |keys: List<String>| {
      let reached = Map::of_entries([
        { key: "m.adds", value: ["m.add"] },
        { key: "m.doubles", value: ["m.twice", "m.mul"] },
      ]);
      {
        fns: keys.fold([], |acc: List<String>, k: String|
          match reached.get(k) {
            Some(names) -> names.fold(acc, |out: List<String>, n: String| out.push(n)),
            None -> acc,
          }),
        decls: [],
      }
    },
  }

fn every(tests: List<Test>) -> Chosen =
  {
    groups: [tests.map(|t: Test| t.index)],
    filed: tests.fold(Map::new(), |acc: Map<Int, List<String>>, t: Test|
      match t.hash { Some(h) -> acc.insert(t.index, [h]), None -> acc }),
    codes: tests.fold(Map::new(), |acc: Map<Int, List<String>>, t: Test|
      acc.insert(t.index, ["c" ++ t.index.to_string()])),
    reasons: Map::new(),
    out_of_scope: [],
  }

fn passing(index: Int) -> Ran<String> =
  {
    index: index,
    status: "passed",
    failure: None,
    host: false,
    trace: Some(b""),
    searched: None,
    seeds: 0,
  }

fn pass_of(key: String) -> Pass = { key: key, trace: b"" }

fn failing(index: Int) -> Ran<String> =
  { ..passing(index), status: "failed", failure: Some("assertion failed") }

fn both() -> List<Test> = [a_test(0, "adds"), a_test(1, "doubles")]

test "a pass is filed under its keys with its closure, and a failure under none" {
  let c = concluded(both(), a_program(), every(both()), Map::new(), [passing(0), failing(1)]);
  assert_eq(c.passed, 1);
  assert_eq(c.failed, 1);
  assert_eq(c.filing.passes, [pass_of("t0")]);
  assert_eq(c.filing.codes, [pass_of("c0")]);
  assert_eq(c.filing.records, [
    {
      key: "m.adds",
      record: { test: "t0", closure: [{ name: "m.add", hash: "h_add" }], decls: [] },
    },
  ]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Under(["t0"])), None])
}

test "a pass record holds a reached effect's hash and not that of the function of its name" {
  let h: Hashes = {
    defs: Map::of_entries([{ key: "m.gz", value: "h_fn" }, { key: "m.read", value: "h_read" }]),
    decls: Map::of_entries([{ key: "m.gz", value: "h_effect" }]),
    closure: |keys: List<String>| { fns: ["m.read"], decls: ["m.gz"] },
  };
  assert_eq(pass_record(h, "m.reads", "t0"), {
    test: "t0",
    closure: [{ name: "m.read", hash: "h_read" }],
    decls: [{ name: "m.gz", hash: "h_effect" }],
  })
}

test "a red test does not vouch for the definitions it exercised" {
  let c = concluded(both(), a_program(), every(both()), Map::new(), [passing(0), failing(1)]);
  assert_eq(c.filing.seen, ["h_add"])
}

test "a test the run skipped vouches for nothing, and a cached one still does" {
  let chosen = { ..every(both()), reasons: Map::new().insert(1, Cached) };
  let c = concluded(both(), a_program(), chosen, Map::new(), [passing(0)]);
  assert_eq(c.filing.seen, ["h_add", "h_mul", "h_twice"]);
  let skipped = concluded(both(), a_program(), every(both()), Map::new(), [passing(0)]);
  assert_eq(skipped.filing.seen, ["h_add"])
}

test "a failure suspects exactly the definitions in its closure the store never saw" {
  let seen = Map::new().insert("h_mul", true);
  let c = concluded(both(), a_program(), every(both()), seen, [failing(1)]);
  assert_eq(c.failures.map(|f: Failed<String>| f.suspects), [["m.twice"]])
}

test "an untraced pass, an abandoned run and a defect are each recorded for what they are" {
  let untraced = { ..passing(0), host: true, trace: None };
  let stopped = { ..failing(1), status: "abandoned" };
  let c = concluded(both(), a_program(), every(both()), Map::new(), [untraced, stopped]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Untraced), None]);
  assert_eq(c.abandoned, 1);
  assert_eq(c.failed, 0);
  assert_eq(c.filing.passes, []);
  let defect = concluded(both(), a_program(), every(both()), Map::new(), [
    { ..failing(1), status: "panicked" },
  ]);
  assert_eq(defect.failures.map(|f: Failed<String>| f.defect), [true])
}

test "a spent or unobserved search writes nothing, and the unobserved one is noticed" {
  let seeded = [{ ..a_test(0, "adds"), seeded: true }, a_test(1, "doubles")];
  let spent = {
    ..passing(1),
    searched: Some({ explored: 4, exhaustive: false, exhausted: true, failed: false }),
  };
  let c = concluded(seeded, a_program(), every(seeded), Map::new(), [passing(0), spent]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Unobserved), Some(Exhausted)]);
  assert_eq(c.filing.passes, []);
  assert_eq(c.filing.codes, []);
  assert_eq(c.notices, [UnobservedSearch("m.adds")]);
  assert_eq(c.simulation.exhausted, 1);
  assert_eq(c.simulation.interleavings, 4)
}

test "a test index the program does not declare is noticed rather than reported" {
  let c = concluded(both(), a_program(), every(both()), Map::new(), [passing(7)]);
  assert_eq(c.notices, [StaleIndex({ index: 7, declared: 2 })]);
  assert_eq(c.outcomes, [])
}

test "results come back in test order, each with the class it ran in" {
  let chosen = { ..every(both()), groups: [[1], [0]] };
  let c = concluded(both(), a_program(), chosen, Map::new(), [passing(1), passing(0)]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.index), [0, 1]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.group), [1, 0])
}

fn searched(explored: Int, exhausted: Bool, failed: Bool) -> Searched =
  { explored: explored, exhaustive: !exhausted && !failed, exhausted: exhausted, failed: failed }

test "a pass is written under exactly the keys it was filed under, a seeded one's roots too" {
  let seeded = [{ ..a_test(0, "adds"), seeded: true }];
  let chosen = { ..every(seeded), filed: Map::new().insert(0, ["plan", "root 0", "root 1"]) };
  let c = concluded(seeded, a_program(), chosen, Map::new(), [
    { ..passing(0), searched: Some(searched(3, false, false)), seeds: 2 },
  ]);
  assert_eq(c.filing.passes, ["plan", "root 0", "root 1"].map(pass_of));
  assert_eq(c.simulation.seeds, 2);
  assert_eq(c.simulation.exhaustive, 1)
}

test "a search stopped at a failure is filed under no key, and counted as failed" {
  let seeded = [{ ..a_test(0, "adds"), seeded: true }];
  let c = concluded(seeded, a_program(), every(seeded), Map::new(), [
    { ..failing(0), searched: Some(searched(5, false, true)), seeds: 1 },
  ]);
  assert_eq(c.filing.passes, []);
  assert_eq(c.filing.records, []);
  assert_eq(c.simulation.failed, 1);
  assert_eq(c.simulation.interleavings, 5)
}

test "a spent budget stops an unseeded test's pass being written as well" {
  let c = concluded(both(), a_program(), every(both()), Map::new(), [
    { ..passing(0), searched: Some(searched(9, true, false)) },
  ]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Exhausted)]);
  assert_eq(c.filing.passes, [])
}

test "a test with no keys filed for it passes and is written under nothing" {
  let chosen = { ..every(both()), filed: Map::new() };
  let c = concluded(both(), a_program(), chosen, Map::new(), [passing(0)]);
  assert_eq(c.passed, 1);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [None]);
  assert_eq(c.filing.passes, [])
}

test "a test outside the run's scope never implicates what it reaches" {
  let chosen = { ..every(both()), out_of_scope: [1] };
  let c = concluded(both(), a_program(), chosen, Map::new(), [passing(0)]);
  assert_eq(c.filing.seen, ["h_add", "h_mul", "h_twice"])
}

test "only a pass with a hash is filed with a pass record" {
  let unhashed = [{ ..a_test(0, "adds"), hash: None }];
  let chosen = { ..every(unhashed), filed: Map::new().insert(0, ["k"]) };
  let c = concluded(unhashed, a_program(), chosen, Map::new(), [passing(0)]);
  assert_eq(c.filing.passes, [pass_of("k")]);
  assert_eq(c.filing.records, [])
}

test "a pass that reached the host is filed with what it read, in both of its keys" {
  let hosted = { ..passing(0), host: true, trace: Some(b"file\tcwd\ta.txt\tb3\n") };
  let c = concluded(both(), a_program(), every(both()), Map::new(), [hosted]);
  assert_eq(c.outcomes.map(|o: Outcome<String>| o.recorded), [Some(Under(["t0"]))]);
  assert_eq(c.filing.passes, [{ key: "t0", trace: b"file\tcwd\ta.txt\tb3\n" }]);
  assert_eq(c.filing.codes, [{ key: "c0", trace: b"file\tcwd\ta.txt\tb3\n" }])
}
