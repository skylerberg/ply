//! `delta` — what moved in a failing test's closure since the test last passed. A definition whose
//! hash moved is *edited* when its text differs from its text then, and *derived* when the text is
//! the same, so the hash moved only because something under it did.

import std.list

/// Which namespace a definition is in: a `fn`/`let`, or a `type`/`effect` declaration.
pub type Ns = | Value | Decl

/// A definition's identity across two configurations: its program-wide name and namespace.
pub type DefKey = { name: String, ns: Ns }

pub fn value_key(name: String) -> DefKey = { name: name, ns: Value }

pub fn decl_key(name: String) -> DefKey = { name: name, ns: Decl }

/// Ascending by name, then by namespace, with `value` before `declaration`.
pub fn key_before(a: DefKey, b: DefKey) -> Bool =
  match compare(a.name, b.name) {
    Less -> true,
    Greater -> false,
    Equal -> ns_rank(a.ns) < ns_rank(b.ns),
  }

fn ns_rank(ns: Ns) -> Int = match ns { Value -> 0, Decl -> 1 }

pub fn key_text(key: DefKey) -> String =
  match key.ns { Value -> "v " ++ key.name, Decl -> "d " ++ key.name }

pub type ChangeKind = | Edited | Derived | Added | Removed

pub fn kind_word(k: ChangeKind) -> String =
  match k { Edited -> "edited", Derived -> "derived", Added -> "added", Removed -> "removed" }

pub type Change = {
  /// The program-wide name — `store.orders.place`.
  name: String,
  ns: Ns,
  /// Its hash when the test last passed.
  before: Option<String>,
  after: Option<String>,
  kind: ChangeKind,
}

pub fn edited(name: String, before: String, after: String) -> Change =
  { name: name, ns: Value, before: Some(before), after: Some(after), kind: Edited }

pub fn derived(name: String, before: String, after: String) -> Change =
  { name: name, ns: Value, before: Some(before), after: Some(after), kind: Derived }

pub fn added(name: String, after: String) -> Change =
  { name: name, ns: Value, before: None, after: Some(after), kind: Added }

pub fn removed(name: String, before: String) -> Change =
  { name: name, ns: Value, before: Some(before), after: None, kind: Removed }

/// What moved since the test last passed: the test's own edit, when its body was edited, and each
/// definition of its closure that changed, ascending by key.
pub type Delta = { own: Option<Change>, changes: List<Change> }

/// The change `name` made, preferring an edit over a derived change sharing its name.
pub fn change(d: Delta, name: String) -> Option<Change> =
  match d.changes.filter(|c: Change| c.name == name && c.kind != Derived) {
    [c, ..] -> Some(c),
    [] -> match d.changes.filter(|c: Change| c.name == name) { [c, ..] -> Some(c), [] -> None },
  }

// --- What the runtime knows, and the change set it makes ------------------------

/// One definition in a failing test's closure, in either era.
pub type Row = {
  name: String,
  ns: Ns,
  /// Its hash when the test last passed, and now.
  before: Option<String>,
  after: Option<String>,
  /// Whether its text is the one it had when the test last passed; `None` where either text is
  /// unknown, or its hash did not move.
  same: Option<Bool>,
  /// Its baseline hash is still somewhere in the current program.
  kept: Bool,
}

/// The test's own hash when it last passed and now, and whether its text is the same.
pub type Own = { name: String, before: String, after: Option<String>, same: Option<Bool> }

pub type Facts = { own: Own, rows: List<Row> }

/// What moved since the test last passed. A name that vanished while its hash stayed in the program,
/// or appeared with a hash the baseline already held, was renamed rather than changed; a definition
/// whose text is the same is derived; and one whose text then is unknown is an edit, the wider answer
/// and never a wrong one. A comment that changed counts as an edit, and its diff shows it.
pub fn classified(f: Facts) -> Delta / {abort.raise} = {
  let then = f.rows.fold([], |acc: List<String>, row: Row|
    match row.before { Some(h) -> acc.push(h), None -> acc });
  let rows = sorted_rows(f.rows);
  {
    own: judged_own(f.own),
    changes: rows.fold([], |acc: List<Change>, row: Row|
      match judged_row(row, then) { Some(c) -> acc.push({ ..c, ns: row.ns }), None -> acc }),
  }
}

fn judged_row(row: Row, then: List<String>) -> Option<Change> =
  match row.before {
    None -> match row.after {
      None -> None,
      Some(now) -> if then.contains(now) { None } else { Some(added(row.name, now)) },
    },
    Some(was) -> match row.after {
      None -> if row.kept { None } else { Some(removed(row.name, was)) },
      Some(now) -> if now == was { None }
      else if row.same == Some(true) { Some(derived(row.name, was, now)) }
      else { Some(edited(row.name, was, now)) },
    },
  }

/// A test whose hash moved is edited only when its text is known to differ: a hash that moved under
/// it accuses nothing.
fn judged_own(o: Own) -> Option<Change> =
  match o.after {
    Some(now) -> if now != o.before && o.same == Some(false) { Some(edited(o.name, o.before, now)) }
    else { None },
    None -> None,
  }

/// Ascending by key, which is the order a change set lists its changes in.
fn sorted_rows(rows: List<Row>) -> List<Row> =
  rows.sort_by(|a: Row, b: Row| key_before({ name: a.name, ns: a.ns }, { name: b.name, ns: b.ns }))

// --- Tests ------------------------------------------------------------------

/// A row whose hash moved from `before` to `after`, and whose text did or did not change with it.
fn moved(name: String, before: String, after: String, same: Bool) -> Row =
  { name: name, ns: Value, before: Some(before), after: Some(after), same: Some(same), kept: false }

fn still(name: String, hash: String) -> Row =
  { name: name, ns: Value, before: Some(hash), after: Some(hash), same: None, kept: false }

fn gone(name: String, hash: String) -> Row =
  { name: name, ns: Value, before: Some(hash), after: None, same: None, kept: false }

fn arrived(name: String, hash: String) -> Row =
  { name: name, ns: Value, before: None, after: Some(hash), same: None, kept: false }

fn untouched(named: String) -> Own =
  { name: named, before: "t1", after: Some("t2"), same: Some(true) }

fn kinds(d: Delta) -> List<String> = d.changes.map(|c: Change| c.name ++ " " ++ kind_word(c.kind))

/// `leaf` was edited; `mid` and `top` only reference it, so their hashes moved and their texts did not.
fn chain(leaf: Row, top: Row) -> Facts =
  { own: untouched("chain"), rows: [top, moved("mid", "m1", "m2", true), leaf] }

test "an edit to a leaf leaves what only references it derived" {
  let d = classified(chain(moved("leaf", "l1", "l2", false), moved("top", "t1", "t2", true)));
  assert_eq(kinds(d), ["leaf edited", "mid derived", "top derived"]);
  // A closure that moved under the test is not an edit to the test.
  assert_eq(d.own, None)
}

test "two edits are two changes, each on its own" {
  let d = classified(chain(moved("leaf", "l1", "l2", false), moved("top", "t1", "t2", false)));
  assert_eq(kinds(d), ["leaf edited", "mid derived", "top edited"])
}

test "a rename moves a name and no hash, so it is no change at all" {
  let d = classified({
    own: untouched("chain"),
    rows: [
      // `leaf` is gone and its hash is still in the program; `first` is new with a hash the baseline held.
      { ..gone("leaf", "l1"), kept: true },
      arrived("first", "l1"),
      still("mid", "m1"),
    ],
  });
  assert_eq(d.changes, [])
}

test "an edit to the test's body is recorded on the test rather than on a definition" {
  let d = classified({
    own: { name: "chain", before: "t1", after: Some("t2"), same: Some(false) },
    rows: [still("leaf", "l1")],
  });
  assert_eq(
    match d.own { Some(c) -> c.name ++ " " ++ kind_word(c.kind), None -> "none" },
    "chain edited",
  );
  assert_eq(d.changes, []);
  // A test's rows are what it reaches, never the test itself, so a definition named like its key is
  // a definition: `test "chain"` and `fn chain` are both `m.chain`.
  let shared = classified({ own: untouched("chain"), rows: [moved("chain", "c1", "c2", false)] });
  assert_eq(kinds(shared), ["chain edited"])
}

test "an added and a removed definition are changes" {
  let d = classified({
    own: untouched("chain"),
    rows: [arrived("bump", "b1"), gone("spare", "s1"), moved("mid", "m1", "m2", false)],
  });
  assert_eq(kinds(d), ["bump added", "mid edited", "spare removed"])
}

test "a moved definition whose text then is unknown is edited, and an unknown test is not" {
  let unknown = |name: String, before: String, after: String|
    { ..moved(name, before, after, true), same: None };
  let d = classified({
    own: { name: "chain", before: "t1", after: Some("t2"), same: None },
    rows: [unknown("top", "t1", "t2"), unknown("mid", "m1", "m2"), still("leaf", "l1")],
  });
  assert_eq(kinds(d), ["mid edited", "top edited"]);
  assert_eq(d.own, None)
}

test "a declaration and a value of one name are two changes, and the edit is the one named" {
  let d = classified({
    own: untouched("app"),
    rows: [
      { ..moved("store.db", "d1", "d2", false), ns: Decl },
      moved("store.db", "k1", "k2", true),
    ],
  });
  assert_eq(d.changes.map(|c: Change| { name: c.name, ns: c.ns, kind: c.kind }), [
    { name: "store.db", ns: Value, kind: Derived },
    { name: "store.db", ns: Decl, kind: Edited },
  ]);
  assert_eq(match change(d, "store.db") { Some(c) -> c.ns, None -> Value }, Decl);
  assert_eq(change(d, "nothing"), None)
}
