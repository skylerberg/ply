import std.list
import delta (DefinitionKey, Facts, Row, Value, Declaration, declaration_key, key_before, value_key,
              key_text)

pub type Baseline = {
  test: String,
  closure: Map<String, String>,
  declarations: Map<String, String>,
}

pub type CurrentProgram = {
  test: Option<String>,
  closure: { functions: List<String>, declarations: List<String> },
  definitions: Map<String, String>,
  declarations: Map<String, String>,
}

fn hash_in(
  definitions: Map<String, String>,
  declarations: Map<String, String>,
  key: DefinitionKey,
) -> Option<String> =
  match key.ns { Value -> definitions.get(key.name), Declaration -> declarations.get(key.name) }

fn insert_key(
  accumulator: Map<String, DefinitionKey>,
  key: DefinitionKey,
) -> Map<String, DefinitionKey> = accumulator.insert(key_text(key), key)

fn keys_of(b: Baseline, now: CurrentProgram) -> List<DefinitionKey> = {
  let then = b.closure.keys().map(value_key).concat(
    b.declarations.keys().map(declaration_key),
  ).fold(
    Map::new(),
    insert_key,
  );
  let with_functions = now.closure.functions.fold(
    then,
    |accumulator: Map<String, DefinitionKey>, name: String|
      if now.definitions.contains(name) { insert_key(accumulator, value_key(name)) }
      else { accumulator },
  );
  let all = now.closure.declarations.fold(
    with_functions,
    |accumulator: Map<String, DefinitionKey>, name: String|
      if now.declarations.contains(name) { insert_key(accumulator, declaration_key(name)) }
      else { accumulator },
  );
  all.values().sort_by(key_before)
}

pub fn moved_from(b: Baseline, now: CurrentProgram) -> List<String> = {
  let rows = keys_of(b, now).fold([], |accumulator: List<String>, k: DefinitionKey|
    match hash_in(b.closure, b.declarations, k) {
      Some(was) -> if hash_in(now.definitions, now.declarations, k) == Some(was) { accumulator }
      else { accumulator.push(was) },
      None -> accumulator,
    });
  if now.test == Some(b.test) { rows } else { rows.push(b.test) }
}

pub fn facts<| e>(
  key: String,
  b: Baseline,
  now: CurrentProgram,
  same: (DefinitionKey, String) -> Option<Bool> / e,
  own_same: Option<Bool>,
) -> Facts / e = {
  let present = now.definitions.values().concat(now.declarations.values()).fold(
    Map::new(),
    |accumulator: Map<String, Bool>, h: String| accumulator.insert(h, true),
  );
  {
    test_hashes: { name: key, before: b.test, after: now.test, same_text: own_same },
    rows: keys_of(b, now).map(|k: DefinitionKey| {
      let before = hash_in(b.closure, b.declarations, k);
      let after = hash_in(now.definitions, now.declarations, k);
      {
        name: k.name,
        ns: k.ns,
        before: before,
        after: after,
        same: match ((before, after)) {
          (Some(was), Some(is)) -> if was == is { None } else { same(k, was) },
          _ -> None,
        },
        retained: match before { Some(was) -> present.contains(was), None -> false },
      }
    }),
  }
}

fn named(pairs: List<{ key: String, value: String }>) -> Map<String, String> =
  Map::of_entries(pairs)

const a_baseline: Baseline =
  {
    test: "t1",
    closure: named([{ key: "m.leaf", value: "l1" }, { key: "m.top", value: "p1" }]),
    declarations: Map::new(),
  }

const a_now: CurrentProgram =
  {
    test: Some("t2"),
    closure: { functions: ["m.leaf", "m.top"], declarations: [] },
    definitions: named([{ key: "m.leaf", value: "l2" }, { key: "m.top", value: "p2" }]),
    declarations: Map::new(),
  }

fn row_named(f: Facts, name: String) -> Row / {abort.raise} =
  match f.rows.filter(|row: Row| row.name == name) {
    [row, ..] -> row,
    [] -> panic("no test result was recorded for this name in the baseline or the current program"),
  }

fn top_unchanged(key: DefinitionKey, was: String) -> Option<Bool> = Some(key.name == "m.top")

test "text is compared only for definitions whose hash changed" {
  let f = facts("m.t", a_baseline, a_now, top_unchanged, Some(true));
  assert_eq(row_named(f, "m.leaf").same, Some(false));
  assert_eq(row_named(f, "m.top").same, Some(true));
  let still = facts(
    "m.t",
    a_baseline,
    { ..a_now, definitions: a_baseline.closure },
    |key: DefinitionKey, was: String| panic("a hash that did not move is not asked about"),
    None,
  );
  assert_eq(still.rows.map(|row: Row| row.same), [None, None])
}

test "the old texts to compare are those of changed definitions, including removed ones, and of a changed test" {
  assert_eq(moved_from(a_baseline, a_now), ["l1", "p1", "t1"]);
  let now = {
    ..a_now,
    test: Some("t1"),
    closure: { functions: ["m.top"], declarations: [] },
    definitions: named([{ key: "m.top", value: "p1" }]),
  };
  assert_eq(moved_from(a_baseline, now), ["l1"])
}

test "a definition present in only one version of the program is a row with no hash for the other version" {
  let now = {
    ..a_now,
    closure: { functions: ["m.top", "m.added"], declarations: [] },
    definitions: a_now.definitions.insert("m.added", "a2"),
  };
  let f = facts("m.t", a_baseline, now, top_unchanged, None);
  assert_eq(f.rows.map(|row: Row| row.name), ["m.added", "m.leaf", "m.top"]);
  assert_eq(row_named(f, "m.added").before, None);
  assert_eq(row_named(f, "m.added").after, Some("a2"))
}

test "a definition's old hash is marked as still in use when another definition in the program has that hash" {
  let now = {
    ..a_now,
    definitions: named([
      { key: "m.leaf", value: "l2" },
      { key: "m.top", value: "p2" },
      { key: "m.other", value: "l1" },
    ]),
  };
  let f = facts("m.t", a_baseline, now, top_unchanged, None);
  assert(row_named(f, "m.leaf").retained);
  assert(!row_named(f, "m.top").retained)
}
