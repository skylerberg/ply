//! `facts` — what is known about each definition in a failing test's closure, in the era it last
//! passed and now: the rows `delta.classified` makes a change set of.

import std.list
import delta (DefKey, Facts, Row, Value, Decl, decl_key, key_before, value_key, key_text)

/// The definition set a test was last seen to pass at.
pub type Baseline = {
  test: String,
  /// Program-wide name to hash, for every function in the closure then.
  closure: Map<String, String>,
  /// The same for the `type` and `effect` declarations.
  decls: Map<String, String>,
}

/// The program now: the failing test's hash, the functions and the declarations its closure holds,
/// and every hash by name.
pub type Now = {
  test: Option<String>,
  closure: { fns: List<String>, decls: List<String> },
  defs: Map<String, String>,
  decls: Map<String, String>,
}

fn era_hash(defs: Map<String, String>, decls: Map<String, String>, key: DefKey) -> Option<String> =
  match key.ns { Value -> defs.get(key.name), Decl -> decls.get(key.name) }

fn keyed(acc: Map<String, DefKey>, key: DefKey) -> Map<String, DefKey> =
  acc.insert(key_text(key), key)

/// Every definition either era's closure holds, ascending.
fn keys_of(b: Baseline, now: Now) -> List<DefKey> = {
  let then = b.closure.keys().map(value_key).concat(b.decls.keys().map(decl_key)).fold(
    Map::new(),
    keyed,
  );
  let with_fns = now.closure.fns.fold(then, |acc: Map<String, DefKey>, name: String|
    if now.defs.contains(name) { keyed(acc, value_key(name)) } else { acc });
  let all = now.closure.decls.fold(with_fns, |acc: Map<String, DefKey>, name: String|
    if now.decls.contains(name) { keyed(acc, decl_key(name)) } else { acc });
  all.values().sort_by(key_before)
}

/// The hash, when the test last passed, of each definition of either era's closure whose hash has
/// moved since, then of the test where its own did: the texts its classification compares.
pub fn moved_from(b: Baseline, now: Now) -> List<String> = {
  let rows = keys_of(b, now).fold([], |acc: List<String>, k: DefKey|
    match era_hash(b.closure, b.decls, k) {
      Some(was) -> if era_hash(now.defs, now.decls, k) == Some(was) { acc } else { acc.push(was) },
      None -> acc,
    });
  if now.test == Some(b.test) { rows } else { rows.push(b.test) }
}

/// The facts one failure's change set is classified from. `same` is asked, of a definition whose
/// hash moved from the one it is handed, whether its text is the one it had when the test last
/// passed; `own_same` says the same of the test.
pub fn facts<| e>(
  key: String,
  b: Baseline,
  now: Now,
  same: (DefKey, String) -> Option<Bool> / e,
  own_same: Option<Bool>,
) -> Facts / e = {
  let present = now.defs.values().concat(now.decls.values()).fold(
    Map::new(),
    |acc: Map<String, Bool>, h: String| acc.insert(h, true),
  );
  {
    own: { name: key, before: b.test, after: now.test, same: own_same },
    rows: keys_of(b, now).map(|k: DefKey| {
      let before = era_hash(b.closure, b.decls, k);
      let after = era_hash(now.defs, now.decls, k);
      {
        name: k.name,
        ns: k.ns,
        before: before,
        after: after,
        same: match ((before, after)) {
          (Some(was), Some(is)) -> if was == is { None } else { same(k, was) },
          _ -> None,
        },
        kept: match before { Some(was) -> present.contains(was), None -> false },
      }
    }),
  }
}

// --- Tests ------------------------------------------------------------------

fn named(pairs: List<{ key: String, value: String }>) -> Map<String, String> =
  Map::of_entries(pairs)

fn a_baseline() -> Baseline =
  {
    test: "t1",
    closure: named([{ key: "m.leaf", value: "l1" }, { key: "m.top", value: "p1" }]),
    decls: Map::new(),
  }

fn a_now() -> Now =
  {
    test: Some("t2"),
    closure: { fns: ["m.leaf", "m.top"], decls: [] },
    defs: named([{ key: "m.leaf", value: "l2" }, { key: "m.top", value: "p2" }]),
    decls: Map::new(),
  }

fn row_named(f: Facts, name: String) -> Row / {abort.raise} =
  match f.rows.filter(|row: Row| row.name == name) {
    [row, ..] -> row,
    [] -> panic("a row for every name in either closure"),
  }

/// Whether a definition's text is the same: `m.top`'s is, and every other's is not.
fn top_unchanged(key: DefKey, was: String) -> Option<Bool> = Some(key.name == "m.top")

test "only a definition whose hash moved is asked about its text" {
  let f = facts("m.t", a_baseline(), a_now(), top_unchanged, Some(true));
  assert_eq(row_named(f, "m.leaf").same, Some(false));
  assert_eq(row_named(f, "m.top").same, Some(true));
  let still = facts(
    "m.t",
    a_baseline(),
    { ..a_now(), defs: a_baseline().closure },
    |key: DefKey, was: String| panic("a hash that did not move is not asked about"),
    None,
  );
  assert_eq(still.rows.map(|row: Row| row.same), [None, None])
}

test "the texts compared are of the moved definitions and the test, as they were" {
  assert_eq(moved_from(a_baseline(), a_now()), ["l1", "p1", "t1"]);
  // A definition gone since names its hash then; an unmoved test names nothing.
  let now = {
    ..a_now(),
    test: Some("t1"),
    closure: { fns: ["m.top"], decls: [] },
    defs: named([{ key: "m.top", value: "p1" }]),
  };
  assert_eq(moved_from(a_baseline(), now), ["l1"])
}

test "a definition only one era holds is a row with the other era's hash missing" {
  let now = {
    ..a_now(),
    closure: { fns: ["m.top", "m.added"], decls: [] },
    defs: a_now().defs.insert("m.added", "a2"),
  };
  let f = facts("m.t", a_baseline(), now, top_unchanged, None);
  assert_eq(f.rows.map(|row: Row| row.name), ["m.added", "m.leaf", "m.top"]);
  assert_eq(row_named(f, "m.added").before, None);
  assert_eq(row_named(f, "m.added").after, Some("a2"))
}

test "a baseline hash still in the program is kept" {
  let now = {
    ..a_now(),
    defs: named([
      { key: "m.leaf", value: "l2" },
      { key: "m.top", value: "p2" },
      { key: "m.other", value: "l1" },
    ]),
  };
  let f = facts("m.t", a_baseline(), now, top_unchanged, None);
  assert(row_named(f, "m.leaf").kept);
  assert(!row_named(f, "m.top").kept)
}
