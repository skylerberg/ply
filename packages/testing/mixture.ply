//! `mixture` — one failure's two eras as a single program that takes some definitions from each:
//! which hash each definition is taken at, the redirection that points every reference at the
//! version taken, and the name each stored body is printed under.

import std.bytes (u32_le)
import std.hash (blake3)
import compiler.store.hash (body_component)
import compiler.syntax.items (is_shipped)
import std.list
import std.string
import delta (DefKey, Value, Decl, decl_key, key_before, value_key, key_text)
import bisect (DoesNotCheck, Unresolved)

/// One definition, at the hash it had when the test last passed and the one it has now.
pub type Era = { key: DefKey, before: Option<String>, after: Option<String> }

/// Every definition either era holds, ascending by key.
pub type Mixture = { eras: List<Era> }

fn eras_with(acc: Map<String, Era>, key: DefKey, update: (Era) -> Era) -> Map<String, Era> = {
  let text = key_text(key);
  let held = match acc.get(text) { Some(e) -> e, None -> { key: key, before: None, after: None } };
  acc.insert(text, update(held))
}

/// The baseline's closure and declarations beside the functions and declarations the test's closure
/// holds now: a function and a declaration of one name are each taken only where it is reached.
pub fn mixture_of(
  closure: Map<String, String>,
  decls: Map<String, String>,
  now: { fns: List<String>, decls: List<String> },
  defs_now: Map<String, String>,
  decls_now: Map<String, String>,
) -> Mixture = {
  let then = decls.fold(
    closure.fold(Map::new(), |acc: Map<String, Era>, n: String, h: String|
      eras_with(acc, value_key(n), |e: Era| { ..e, before: Some(h) })),
    |acc: Map<String, Era>, n: String, h: String|
      eras_with(acc, decl_key(n), |e: Era| { ..e, before: Some(h) }),
  );
  let now_of = |acc: Map<String, Era>, names: List<String>, held: Map<String, String>, key: (String) -> DefKey|
    names.fold(acc, |into: Map<String, Era>, n: String|
      match held.get(n) {
        Some(h) -> eras_with(into, key(n), |e: Era| { ..e, after: Some(h) }),
        None -> into,
      });
  let both = now_of(now_of(then, now.fns, defs_now, value_key), now.decls, decls_now, decl_key);
  { eras: both.values().sort_by(|a: Era, b: Era| key_before(a.key, b.key)) }
}

/// Every hash the mixture could take a body at, in either era.
pub fn hashes_of(m: Mixture) -> List<String> = {
  let all = m.eras.fold(Map::new(), |acc: Map<String, Bool>, e: Era| {
    let with_before = match e.before { Some(h) -> acc.insert(h, true), None -> acc };
    match e.after { Some(h) -> with_before.insert(h, true), None -> with_before }
  });
  all.keys()
}

/// The hashes a mixture takes, ascending, the definition each is taken as, and where every
/// reference to either era of each definition now points.
pub type Chosen = {
  hashes: List<String>,
  named: Map<String, String>,
  relink: List<{ from: String, to: String }>,
}

fn flips(flipped: List<DefKey>, k: DefKey) -> Bool =
  flipped.fold(false, |found: Bool, f: DefKey| found || key_text(f) == key_text(k))

/// The mixture that takes `flipped` from the post-edit era and everything else from the baseline.
/// Two definitions whose eras share a hash but are taken at different ones cannot both be honoured,
/// so that mixture does not check.
pub fn choose(m: Mixture, flipped: List<DefKey>) -> Result<Chosen, Unresolved> = {
  let start: Result<{ hashes: Map<String, String>, relink: Map<String, String> }, Unresolved> = Ok(
    { hashes: Map::new(), relink: Map::new() },
  );
  let chosen = m.eras.fold(
    start,
    |acc: Result<{ hashes: Map<String, String>, relink: Map<String, String> }, Unresolved>, e: Era|
      match acc {
        Err(why) -> Err(why),
        Ok(held) -> {
          let picked = if flips(flipped, e.key) { e.after } else { e.before };
          match picked {
            None -> Ok(held),
            Some(to) ->
              [e.before, e.after].fold(
                Ok({ hashes: held.hashes.insert(to, e.key.name), relink: held.relink }),
                |r: Result<{ hashes: Map<String, String>, relink: Map<String, String> }, Unresolved>, from: Option<String>|
                  match ((r, from)) {
                    (Ok(x), Some(h)) -> match x.relink.get(h) {
                      Some(other) -> if other != to { Err(DoesNotCheck) } else { Ok(x) },
                      None -> Ok({ ..x, relink: x.relink.insert(h, to) }),
                    },
                    _ -> r,
                  },
              ),
          }
        },
      },
  );
  match chosen {
    Err(why) -> Err(why),
    Ok(x) ->
      Ok({
        hashes: x.hashes.keys(),
        named: x.hashes,
        relink: x.relink.entries().map(|e: { key: String, value: String }|
          { from: e.key, to: e.value }),
      }),
  }
}

/// The names a mixture's bodies are printed under, and the shipped modules among them, which a
/// printing reads rather than prints.
pub type Printable = {
  names: List<{ name: Bytes, hash: Bytes, public: Bool }>,
  shipped: List<Bytes>,
}

/// The name each body's definitions are printed under, ascending by hash: neither era's names fit
/// a mixture of both, so a definition is named by its component and its own hash. A body `taken`
/// names as a definition of a module the load pulled of the shipped ones, as `pulled` says, keeps
/// that name: no bisection edits the modules a load pulled, so the mixture reads the definition
/// from its module, where it may use what only that module can.
pub fn printed_names(
  bodies: List<Bytes>,
  taken: Map<String, String>,
  pulled: (Bytes) -> Bool,
) -> Option<Printable> / {abort.raise} = {
  let own = |hash: String|
    match taken.get(hash) {
      Some(name) -> if pulled(module_of(name)) { Some(name) } else { None },
      None -> None,
    };
  let named = bodies.fold(Some(Map::new()), |acc: Option<Map<String, Bytes>>, body: Bytes|
    match acc {
      None -> None,
      Some(held) -> match body_component(body) {
        None -> None,
        Some(c) ->
          Some(
            c.members.fold(held, |into: Map<String, Bytes>, member: Bytes| {
              let hash = member.hex_of();
              into.insert(hash, match own(hash) {
                Some(name) -> Bytes::of_string(name),
                None ->
                  Bytes::of_string("m" ++ c.id.hex_of().slice(0, 16) ++ ".d" ++ hash.slice(0, 16)),
              })
            }),
          ),
      },
    });
  match named {
    None -> None,
    Some(m) ->
      Some({
        names: m.fold(
          [],
          |acc: List<{ name: Bytes, hash: Bytes, public: Bool }>, hash: String, name: Bytes|
            acc.push({ name: name, hash: Bytes::of_hex(hash), public: true }),
        ),
        shipped: m.fold(Map::new(), |acc: Map<Bytes, Bool>, hash: String, name: Bytes| {
          let module = module_of(String::of_bytes_lossy(name));
          if pulled(module) { acc.insert(module, true) } else { acc }
        }).keys(
        ),
      }),
  }
}

/// The module `name` is a definition of: all of it before its last `.`.
fn module_of(name: String) -> Bytes = {
  let parts = name.split(".");
  Bytes::of_string(String::join(parts.take(parts.len() - 1), "."))
}

// --- Tests ------------------------------------------------------------------

fn era(name: String, before: Option<String>, after: Option<String>) -> Era =
  { key: value_key(name), before: before, after: after }

fn three() -> Mixture =
  {
    eras: [
      era("m.a", Some("a1"), Some("a2")),
      era("m.b", Some("b1"), Some("b2")),
      era("m.c", Some("c1"), Some("c1")),
    ],
  }

test "a mixture takes the flipped definitions from now and the rest from the baseline" {
  match choose(three(), [value_key("m.b")]) {
    Ok(c) -> {
      assert_eq(c.hashes, ["a1", "b2", "c1"]);
      assert_eq(c.named.entries(), [
        { key: "a1", value: "m.a" },
        { key: "b2", value: "m.b" },
        { key: "c1", value: "m.c" },
      ]);
      assert_eq(c.relink, [
        { from: "a1", to: "a1" },
        { from: "a2", to: "a1" },
        { from: "b1", to: "b2" },
        { from: "b2", to: "b2" },
        { from: "c1", to: "c1" },
      ])
    },
    Err(_) -> panic("a mixture of independent definitions checks"),
  }
}

test "two definitions that share a hash cannot be taken at different ones" {
  let shared = { eras: [era("m.a", Some("x"), Some("a2")), era("m.b", Some("x"), Some("b2"))] };
  assert_eq(choose(shared, [value_key("m.a")]), Err(DoesNotCheck));
  assert(match choose(shared, []) { Ok(_) -> true, Err(_) -> false })
}

test "the eras line up by name and namespace, whichever holds a definition" {
  let m = mixture_of(
    Map::new().insert("m.old", "o1"),
    Map::new().insert("m.T", "t1"),
    { fns: ["m.new"], decls: ["m.T"] },
    Map::new().insert("m.new", "n2").insert("m.T", "f2"),
    Map::new().insert("m.T", "t2"),
  );
  // `m.T` is reached as a declaration now; the function of its name is not, and is no era of it.
  assert_eq(m.eras, [
    { key: decl_key("m.T"), before: Some("t1"), after: Some("t2") },
    { key: value_key("m.new"), before: None, after: Some("n2") },
    { key: value_key("m.old"), before: Some("o1"), after: None },
  ]);
  assert_eq(hashes_of(m), ["n2", "o1", "t1", "t2"])
}

test "bytes no envelope holds name nothing" {
  assert_eq(printed_names([b""], Map::new(), is_shipped), None)
}

test "a definition is printed under its component and its own hash, unless a shipped module's" {
  // A body alone in its component, with no choices of its calls on values.
  let solo = Bytes::concat_all([byte_of_int(0), u32_le(0), b"body"]);
  let id = blake3(b"body").hex_of();
  let apart = Bytes::of_string("m" ++ id.slice(0, 16) ++ ".d" ++ id.slice(0, 16));
  let named = |taken: Map<String, String>| printed_names([solo], taken, is_shipped);
  let under = |name: Bytes, shipped: List<Bytes>|
    Some({ names: [{ name: name, hash: blake3(b"body"), public: true }], shipped: shipped });
  assert_eq(named(Map::new()), under(apart, []));
  assert_eq(named(Map::new().insert(id, "m.f")), under(apart, []));
  assert_eq(
    named(Map::new().insert(id, "std.prelude.List::at")),
    under(b"std.prelude.List::at", [b"std.prelude"]),
  );
  assert_eq(
    named(Map::new().insert(id, "std.sqlite.sqlite_functions")),
    under(b"std.sqlite.sqlite_functions", [b"std.sqlite"]),
  );
  assert_eq(
    named(Map::new().insert(id, "compiler.hash.reach")),
    under(b"compiler.hash.reach", [b"compiler.hash"]),
  );
  // The library's own tree pulls none of its modules, so its definitions are its own to print.
  assert_eq(
    printed_names([solo], Map::new().insert(id, "std.prelude.List::at"), |m: Bytes| false),
    under(apart, []),
  )
}
