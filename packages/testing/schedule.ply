//! `schedule` — which selected tests may run at the same time, as graph colouring over the
//! resources they declare, and how a run's tests split once the binding is taken into account. The
//! graph is a *conflict* graph, not a sharing one: two tests may share a resource freely as long as
//! neither writes it, so a conflict is an effect and a resource both name plus a write on one side.
//! Colouring is greedy, largest effects first, and a test takes the first class it clears *every*
//! member of — conflict is not transitive, so clearing one member is not enough.
//!
//! The runtime hands over every effect of a test's effects; which of them another test could reach,
//! and what that makes the test, is decided here. Which effects are ambient is a fact about the
//! language, not about the runtime, so it lives here too.

import std.list

/// One effect of a test's effects. `nondet` is whether its effect is declared `nondet` or is the
/// language's own: any other is answered from the test's own state, by a handler that is a function
/// of it, so no other test reaches what it names.
pub type Effect = { effect: String, resource: String, writes: Bool, nondet: Bool }

// --- What the language declares about an effect -------------------------------

/// Effects that name an input no test can write: a seed, and a scoped value, which is only read.
pub fn ambient_effects() -> List<String> = ["sim", "scoped"]

pub fn is_ambient(a: Effect) -> Bool = contains_text(ambient_effects(), a.effect)

/// Whether an effect can be contended over at all. An ambient input cannot: it is read, and only
/// the run looking at it knows what it is. Nor can one a deterministic handler answers.
pub fn contends(a: Effect) -> Bool = a.nondet && !is_ambient(a)

/// Nothing this test names can be reached from another one.
pub fn is_isolated(f: List<Effect>) -> Bool = f.all(|a: Effect| !contends(a))

/// The effects that can contend across tests: the effects minus the inputs only this test is
/// handed.
pub fn shared(f: List<Effect>) -> List<Effect> = f.filter(contends)

// --- What a run's tests are, once the binding is taken into account ----------

/// One test the run reports on: its effects, and whether the run's binding reaches it.
pub type ReportedTest = { listed: List<Effect>, host: Bool }

/// Whether a test can interfere with any other test at all. A test the binding reaches acts on the
/// world outside the test, so it is never isolated.
pub type Isolation = | Isolated | Shared | Host

pub fn isolation_of(t: ReportedTest) -> Isolation =
  if t.host { Host } else if is_isolated(t.listed) { Isolated } else { Shared }

pub fn isolation_word(i: Isolation) -> String =
  match i { Isolated -> "isolated", Shared -> "shared", Host -> "host" }

/// How a run's tests split: each counts under exactly one of the three.
pub type Counts = { total: Int, isolated: Int, shared: Int, host: Int }

pub fn counts(tests: List<ReportedTest>) -> Counts =
  tests.fold({ total: 0, isolated: 0, shared: 0, host: 0 }, |c: Counts, t: ReportedTest| {
    let one = { ..c, total: c.total + 1 };
    match isolation_of(t) {
      Isolated -> { ..one, isolated: c.isolated + 1 },
      Shared -> { ..one, shared: c.shared + 1 },
      Host -> { ..one, host: c.host + 1 },
    }
  })

// --- The conflict graph -----------------------------------------------------

pub fn conflicts(a: Effect, b: Effect) -> Bool =
  a.effect == b.effect && a.resource == b.resource && (a.writes || b.writes)

/// Two tests conflict when any pair of their effects does.
pub fn effects_conflict(xs: List<Effect>, ys: List<Effect>) -> Bool =
  !xs.all(|a: Effect| !any_conflicts(ys, a))

fn any_conflicts(ys: List<Effect>, a: Effect) -> Bool = some(ys, |b: Effect| conflicts(a, b))

/// One selected test, with the atoms another test could contend over.
pub type ScheduledTest = { index: Int, contended_effects: List<Effect> }

/// Greedy colouring of the conflict graph, largest effects first, ties by index. Each class is
/// returned with its indices ascending, and the classes come out in the order they were opened.
pub fn group_by_conflict(tests: List<ScheduledTest>) -> List<List<Int>> / {abort.raise} =
  in_order(tests).fold([], |classes: List<List<ScheduledTest>>, t: ScheduledTest|
    assign_class(classes, t)).map(|class: List<ScheduledTest>| sorted_indices(class))

/// The tests as a scheduler considers them: most contended first, so the classes are not shaped by
/// an accident of the order the tree happens to declare them in.
fn in_order(tests: List<ScheduledTest>) -> List<ScheduledTest> = tests.sort_by(ahead_of)

/// Most effects first; ties by index, so the order is total and no insertion order leaks in.
fn ahead_of(t: ScheduledTest, other: ScheduledTest) -> Bool =
  if t.contended_effects.len() == other.contended_effects.len() { t.index < other.index }
  else { t.contended_effects.len() > other.contended_effects.len() }

fn sorted_indices(class: List<ScheduledTest>) -> List<Int> =
  class.map(|t: ScheduledTest| t.index).sort_by(|a: Int, b: Int| a < b)

/// The first class this test clears every member of; a new class when it clears none.
fn assign_class(
  classes: List<List<ScheduledTest>>,
  t: ScheduledTest,
) -> List<List<ScheduledTest>> / {abort.raise} = {
  let slot = first_compatible_class(classes, t.contended_effects);
  match slot { Some(k) -> classes.set(k, classes.get(k).push(t)), None -> classes.push([t]) }
}

fn first_compatible_class(
  classes: List<List<ScheduledTest>>,
  effects: List<Effect>,
) -> Option<Int> / {abort.raise} =
  range(0, classes.len()).fold(None, |found: Option<Int>, k: Int|
    match found {
      Some(_) -> found,
      None -> if is_compatible(classes.get(k), effects) { Some(k) } else { None },
    })

/// Whether a test of `effects` clears every member of `class`: one nothing could contend with
/// clears every class without being held against its members.
fn is_compatible(class: List<ScheduledTest>, effects: List<Effect>) -> Bool =
  effects.is_empty()
    || class.all(|other: ScheduledTest| !effects_conflict(effects, other.contended_effects))

// --- How many of a run's tests are trivially parallel -----------------------

pub type Parallelism = {
  total: Int,
  isolated: Int,
  shared: Int,
  /// Selected tests: what `groups` and `shared_groups` are counted over.
  scheduled: Int,
  groups: Int,
  /// What the shared selected tests need on their own.
  shared_groups: Int,
}

/// Groups equal what the shared tests alone need: the property `--explain` publishes.
pub fn groups_are_minimal(p: Parallelism) -> Bool = {
  let floor = if p.scheduled > 0 { 1 } else { 0 };
  p.groups == max(p.shared_groups, floor)
}

/// `universe` is every test the run reports on; `scheduled` is the subset being coloured, and
/// `groups` is what `group_by_conflict` made of it.
pub fn parallelism(
  universe: List<List<Effect>>,
  scheduled: List<ScheduledTest>,
  groups: List<List<Int>>,
) -> Parallelism / {abort.raise} = {
  let total = universe.len();
  let isolated = universe.filter(is_isolated).len();
  let shared_only = scheduled.filter(|t: ScheduledTest| !is_isolated(t.contended_effects));
  {
    total: total,
    isolated: isolated,
    shared: total - isolated,
    scheduled: scheduled.len(),
    groups: groups.len(),
    shared_groups: group_by_conflict(shared_only).len(),
  }
}

// --- Helpers ----------------------------------------------------------------

fn contains_text(xs: List<String>, x: String) -> Bool = some(xs, |y: String| y == x)

fn some<a>(xs: List<a>, p: (a) -> Bool) -> Bool = xs.fold(false, |hit: Bool, x: a| hit || p(x))

/// `effect` is not a parameter name — the parser reads it as an effect declaration — so the
/// constructor's parameters are named around it.
fn effect_on(e: String, r: String, w: Bool) -> Effect = { effect: e, resource: r, writes: w, nondet: true }

// --- Tests ------------------------------------------------------------------
//
// The cases are chosen where a colouring could go wrong — a class that must clear every member, the
// order the largest effects imposes, and the two ways a class may be shared.

fn writes(label: String) -> Effect = effect_on("store", label, true)

fn reads(label: String) -> Effect = effect_on("store", label, false)

fn fs(path: String) -> Effect = effect_on("fs", path, true)

fn sim() -> Effect = effect_on("sim", "", false)

fn scheduled(index: Int, effects: List<Effect>) -> ScheduledTest =
  { index: index, contended_effects: effects }

fn unreached(effects: List<Effect>) -> ReportedTest = { listed: effects, host: false }

test "a seed or a scoped value contends with nothing, and a write does" {
  let hold = effect_on("scoped", "log", false);
  assert_eq(is_isolated([sim()]), true);
  assert_eq(is_isolated([hold]), true);
  assert_eq(is_isolated([]), true);
  assert_eq(isolation_of(unreached([sim(), hold])), Isolated);
  assert_eq(shared([writes("a"), sim(), hold]), [writes("a")]);
  assert_eq(isolation_of(unreached([writes("a")])), Shared);
  assert_eq(isolation_word(Shared), "shared");
  // A program's own effects are module-qualified, so none of them can pass for `hold`.
  assert_eq(is_isolated([effect_on("m.hold", "log", false)]), false)
}

// A seed read is an input only the test reading it is handed, so a simulated test is not shared for
// reading one, and still contends over what its tasks touch.
test "a seed never makes a test shared, and what its tasks touch still does" {
  assert_eq(isolation_of(unreached([sim()])), Isolated);
  assert_eq(isolation_of(unreached([sim(), writes("a")])), Shared);
  assert_eq(shared([sim(), writes("a")]), [writes("a")]);
  // Two simulated tests over one label are two classes, and two over nothing share one.
  assert_eq(
    group_by_conflict([scheduled(0, shared([sim(), writes("a")])), scheduled(1, [writes("a")])]),
    [[0], [1]],
  );
  assert_eq(group_by_conflict([scheduled(0, shared([sim()])), scheduled(1, shared([sim()]))]), [
    [0, 1],
  ])
}

// A socket lives outside every region, so a test the binding reaches is host whatever its effects
// says, and each test counts under exactly one heading.
test "a test the binding reaches is host rather than isolated, and counts only there" {
  assert_eq(isolation_of({ listed: [sim()], host: true }), Host);
  assert_eq(isolation_word(Host), "host");
  assert_eq(isolation_word(Isolated), "isolated");
  let c = counts([
    { listed: [effect_on("db", "users", false)], host: true },
    unreached([]),
    unreached([sim()]),
    unreached([fs("/tmp/x")]),
  ]);
  assert_eq(c, { total: 4, isolated: 2, shared: 1, host: 1 });
  // A binding that reaches no test leaves the host column empty.
  let unbound = counts([unreached([effect_on("db", "users", false)]), unreached([])]);
  assert_eq(unbound, { total: 2, isolated: 1, shared: 1, host: 0 });
  assert_eq(counts([]), { total: 0, isolated: 0, shared: 0, host: 0 })
}

test "conflict needs one writer, so two readers of one resource never conflict" {
  assert_eq(conflicts(writes("a"), writes("a")), true);
  assert_eq(conflicts(reads("a"), writes("a")), true);
  assert_eq(conflicts(writes("a"), reads("a")), true);
  assert_eq(conflicts(reads("a"), reads("a")), false);
  // A different label is a different resource, and a different effect is a different resource.
  assert_eq(conflicts(writes("a"), writes("b")), false);
  assert_eq(conflicts(writes("a"), effect_on("db", "a", true)), false);
  assert_eq(effects_conflict([writes("a"), fs("/tmp/x")], [fs("/tmp/x")]), true);
  assert_eq(effects_conflict([writes("a")], [fs("/tmp/x")]), false)
}

test "a class is taken only when it clears every member, because conflict is not transitive" {
  // `0` contends with `1` and `2`; `1` and `2` do not contend with each other. Colouring `0` first
  // puts it in a class of its own and `1` and `2` together in the next, which a class-per-*pair*
  // test would not do.
  let tests = [
    scheduled(0, [writes("a"), writes("b")]),
    scheduled(1, [writes("a")]),
    scheduled(2, [writes("b")]),
  ];
  assert_eq(group_by_conflict(tests), [[0], [1, 2]]);
  // Without the transitivity trap: two tests over one label need two classes.
  assert_eq(group_by_conflict([scheduled(0, [writes("a")]), scheduled(1, [writes("a")])]), [
    [0],
    [1],
  ]);
  // A test nothing can reach conflicts with nothing, so it joins the first class.
  assert_eq(
    group_by_conflict([
      scheduled(0, [writes("a")]),
      scheduled(1, [writes("a")]),
      scheduled(2, [sim()]),
    ]),
    [[0, 2], [1]],
  );
  assert_eq(group_by_conflict([]), [])
}

test "the largest set of effects is coloured first, so the order it was declared in does not show" {
  // Declared smallest first, and the answer is the same as if it were declared the other way.
  let small = scheduled(0, [writes("a")]);
  let big = scheduled(1, [writes("a"), writes("b")]);
  assert_eq(group_by_conflict([small, big]), [[1], [0]]);
  assert_eq(group_by_conflict([big, small]), [[1], [0]]);
  // Ties go by index, and every class's members come back ascending.
  let three = [writes("a"), writes("b"), writes("c")];
  assert_eq(group_by_conflict([scheduled(2, three), scheduled(0, three), scheduled(1, three)]), [
    [0],
    [1],
    [2],
  ])
}

test "the groups a run needs are what the shared tests alone need" {
  let universe = [[writes("a")], [sim()], [fs("/tmp/x")], [writes("b"), sim()]];
  let scheduled_tests = [scheduled(0, [writes("a")]), scheduled(1, [fs("/tmp/x")])];
  let groups = group_by_conflict(scheduled_tests);
  // Different effects, so nothing contends: one class holds both.
  assert_eq(groups, [[0, 1]]);
  let p = parallelism(universe, scheduled_tests, groups);
  assert_eq(p.total, 4);
  assert_eq(p.isolated, 1);
  assert_eq(p.shared, 3);
  assert_eq(p.scheduled, 2);
  assert_eq(p.groups, 1);
  assert_eq(p.shared_groups, 1);
  assert_eq(groups_are_minimal(p), true);
  // One selected test, and one nothing else could reach: `groups` is one while `shared_groups` is
  // zero, so the floor is what makes the property hold.
  let one = parallelism(universe, [scheduled(0, [sim()])], [[0]]);
  assert_eq(one.shared_groups, 0);
  assert_eq(one.groups, 1);
  assert_eq(groups_are_minimal(one), true);
  // Nothing selected at all: no floor, and nothing to colour.
  let none = parallelism(universe, [], []);
  assert_eq(groups_are_minimal(none), true)
}

fn db(resource: String, w: Bool) -> Effect = effect_on("db", resource, w)

/// A write an effect that is not `nondet` names: a machine a test loads into its own state.
fn loaded(label: String) -> Effect = { ..effect_on("hermetic_machine", label, true), nondet: false }

test "what a deterministic handler handles contends with nothing, whatever it writes" {
  assert_eq(contends(loaded("run")), false);
  assert_eq(is_isolated([loaded("run"), sim()]), true);
  assert_eq(isolation_of(unreached([loaded("run")])), Isolated);
  assert_eq(shared([loaded("run"), fs("/tmp/x")]), [fs("/tmp/x")]);
  assert_eq(group_by_conflict(range(0, 3).map(|i: Int| scheduled(i, shared([loaded("run")])))), [
    [0, 1, 2],
  ])
}

fn contends_of(tests: List<ScheduledTest>, i: Int) -> List<Effect> =
  tests.fold([], |found: List<Effect>, t: ScheduledTest|
    if t.index == i { t.contended_effects } else { found })

fn clear_pairs(tests: List<ScheduledTest>, class: List<Int>) -> Bool / {abort.raise} =
  range(0, class.len()).all(|a: Int|
    range(a + 1, class.len()).all(|b: Int|
      !effects_conflict(contends_of(tests, class.get(a)), contends_of(tests, class.get(b)))))

test "tests that touch nothing, or disjoint things, share one class, and only a writer is apart" {
  assert_eq(group_by_conflict(range(0, 5).map(|i: Int| scheduled(i, []))), [[0, 1, 2, 3, 4]]);
  assert_eq(
    group_by_conflict([
      scheduled(0, [db("users", true)]),
      scheduled(1, [db("orders", true)]),
      scheduled(2, []),
    ]),
    [[0, 1, 2]],
  );
  // Readers of one resource share, its writer is apart, and a write elsewhere separates no reader.
  assert_eq(
    group_by_conflict([
      scheduled(0, [db("users", false)]),
      scheduled(1, [db("users", false)]),
      scheduled(2, [db("users", true)]),
      scheduled(3, [db("users", false)]),
      scheduled(4, [db("orders", true)]),
    ]),
    [[0, 1, 3, 4], [2]],
  )
}

test "one label separates all its writers, and a label each separates none" {
  assert_eq(group_by_conflict(range(0, 4).map(|i: Int| scheduled(i, [writes("users")]))).len(), 4);
  assert_eq(
    group_by_conflict(range(0, 4).map(|i: Int| scheduled(i, [writes("r" ++ i.to_string())]))),
    [[0, 1, 2, 3]],
  )
}

// Declaration order would colour this six-cycle in three classes; the largest effects first need
// the two it has.
test "coloured largest first, a six-cycle takes the two classes it needs" {
  let tests = [
    scheduled(0, [db("e03", true), db("e05", true), db("p0", false)]),
    scheduled(1, [db("e12", true), db("e14", true)]),
    scheduled(2, [db("e12", true), db("e25", true), db("p2", false)]),
    scheduled(3, [db("e03", true), db("e34", true)]),
    scheduled(4, [db("e14", true), db("e34", true), db("p4", false)]),
    scheduled(5, [db("e05", true), db("e25", true)]),
  ];
  assert_eq(group_by_conflict(tests), [[0, 2, 4], [1, 3, 5]])
}

// What the runtime relies on when it runs a class at once.
test "every test lands in exactly one class, and no class holds a conflicting pair" {
  let tests = [
    scheduled(3, [db("users", true)]),
    scheduled(7, [db("users", false)]),
    scheduled(8, []),
    scheduled(11, [db("users", true), db("orders", true)]),
    scheduled(12, [db("orders", false)]),
    scheduled(13, [writes("t0"), reads("t0")]),
    scheduled(14, [writes("t0"), reads("t0")]),
    scheduled(15, [writes("t1")]),
  ];
  let classes = group_by_conflict(tests);
  let flat = classes.fold([], |acc: List<Int>, class: List<Int>|
    class.fold(acc, |xs: List<Int>, x: Int| xs.push(x)));
  assert_eq(flat.len(), tests.len());
  assert(tests.all(|t: ScheduledTest| flat.count(|y: Int| y == t.index) == 1));
  assert(classes.all(|class: List<Int>| clear_pairs(tests, class)))
}

test "a test nothing can reach joins the first class, so adding such tests never adds one" {
  let contended = [
    scheduled(0, [db("users", true)]),
    scheduled(1, [db("users", false)]),
    scheduled(2, [db("orders", true)]),
  ];
  let baseline = group_by_conflict(contended);
  assert_eq(baseline, [[0, 2], [1]]);
  let wider = range(3, 40).fold(contended, |acc: List<ScheduledTest>, i: Int|
    acc.push(scheduled(i, shared([sim()]))));
  let classes = group_by_conflict(wider);
  assert_eq(classes.len(), baseline.len());
  assert(range(3, 40).all(|i: Int| classes.get(0).count(|y: Int| y == i) == 1));
  let universe = range(3, 40).fold(
    contended.map(|t: ScheduledTest| t.contended_effects),
    |acc: List<List<Effect>>, i: Int| acc.push([sim()]),
  );
  let p = parallelism(universe, wider, classes);
  assert_eq(p.isolated, 37);
  assert_eq(p.shared, 3);
  assert_eq(p.shared_groups, baseline.len());
  assert_eq(groups_are_minimal(p), true)
}
