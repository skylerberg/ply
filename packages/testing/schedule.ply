import std.list

pub type Effect = { effect: String, resource: String, writes: Bool, nondet: Bool }

pub fn ambient_effects() -> List<String> = ["sim", "scoped"]

pub fn is_ambient(a: Effect) -> Bool = contains_text(ambient_effects(), a.effect)

pub fn can_conflict(a: Effect) -> Bool = a.nondet && !is_ambient(a)

pub fn is_isolated(f: List<Effect>) -> Bool = f.all(|a: Effect| !can_conflict(a))

pub fn cross_test_effects(f: List<Effect>) -> List<Effect> = f.filter(can_conflict)

pub type ReportedTest = { listed: List<Effect>, host: Bool }

pub type Isolation = | Isolated | Shared | Host

pub fn isolation_of(t: ReportedTest) -> Isolation =
  if t.host { Host } else if is_isolated(t.listed) { Isolated } else { Shared }

pub fn isolation_word(i: Isolation) -> String =
  match i { Isolated -> "isolated", Shared -> "shared", Host -> "host" }

pub type Counts = { total: Int, isolated: Int, shared: Int, host: Int }

pub fn counts(tests: List<ReportedTest>) -> Counts =
  tests.fold({ total: 0, isolated: 0, shared: 0, host: 0 }, |c: Counts, t: ReportedTest| {
    let one = { ..c, total: c.total + 1 };
    match isolation_of(t) {
      Isolated -> { ..one, isolated: c.isolated + 1 },
      Shared -> { ..one, shared: c.shared + 1 },
      Host -> { ..one, host: c.host + 1 },
    }
  })

pub fn conflicts(a: Effect, b: Effect) -> Bool =
  a.effect == b.effect && a.resource == b.resource && (a.writes || b.writes)

pub fn effects_conflict(xs: List<Effect>, ys: List<Effect>) -> Bool =
  !xs.all(|a: Effect| !any_conflicts(ys, a))

fn any_conflicts(ys: List<Effect>, a: Effect) -> Bool = some(ys, |b: Effect| conflicts(a, b))

pub type ScheduledTest = { index: Int, contended_effects: List<Effect> }

pub fn group_by_conflict(tests: List<ScheduledTest>) -> List<List<Int>> / {abort.raise} =
  in_order(tests).fold([], |classes: List<List<ScheduledTest>>, t: ScheduledTest|
    assign_class(classes, t)).map(|class: List<ScheduledTest>| sorted_indices(class))

fn in_order(tests: List<ScheduledTest>) -> List<ScheduledTest> = tests.sort_by(ahead_of)

fn ahead_of(t: ScheduledTest, other: ScheduledTest) -> Bool =
  if t.contended_effects.len() == other.contended_effects.len() { t.index < other.index }
  else { t.contended_effects.len() > other.contended_effects.len() }

fn sorted_indices(class: List<ScheduledTest>) -> List<Int> =
  class.map(|t: ScheduledTest| t.index).sort_by(|a: Int, b: Int| a < b)

fn assign_class(
  classes: List<List<ScheduledTest>>,
  t: ScheduledTest,
) -> List<List<ScheduledTest>> / {abort.raise} = {
  let slot = first_compatible_class(classes, t.contended_effects);
  match slot { Some(k) -> classes.set(k, classes.get(k).push(t)), None -> classes.push([t]) }
}

fn first_compatible_class(
  classes: List<List<ScheduledTest>>,
  effects: List<Effect>,
) -> Option<Int> / {abort.raise} =
  range(0, classes.len()).fold(None, |found: Option<Int>, k: Int|
    match found {
      Some(_) -> found,
      None -> if is_compatible(classes.get(k), effects) { Some(k) } else { None },
    })

fn is_compatible(class: List<ScheduledTest>, effects: List<Effect>) -> Bool =
  effects.is_empty()
    || class.all(|other: ScheduledTest| !effects_conflict(effects, other.contended_effects))

pub type Parallelism = {
  total: Int,
  conflict_free: Int,
  shared: Int,
  scheduled: Int,
  groups: Int,
  shared_groups: Int,
}

pub fn groups_are_minimal(p: Parallelism) -> Bool = {
  let floor = if p.scheduled > 0 { 1 } else { 0 };
  p.groups == max(p.shared_groups, floor)
}

pub fn parallelism(
  universe: List<List<Effect>>,
  scheduled: List<ScheduledTest>,
  groups: List<List<Int>>,
) -> Parallelism / {abort.raise} = {
  let total = universe.len();
  let isolated = universe.filter(is_isolated).len();
  let shared_only = scheduled.filter(|t: ScheduledTest| !is_isolated(t.contended_effects));
  {
    total: total,
    conflict_free: isolated,
    shared: total - isolated,
    scheduled: scheduled.len(),
    groups: groups.len(),
    shared_groups: group_by_conflict(shared_only).len(),
  }
}

fn contains_text(xs: List<String>, x: String) -> Bool = some(xs, |y: String| y == x)

fn some<a>(xs: List<a>, p: (a) -> Bool) -> Bool = xs.fold(false, |hit: Bool, x: a| hit || p(x))

fn effect_on(e: String, r: String, w: Bool) -> Effect =
  { effect: e, resource: r, writes: w, nondet: true }

fn writes(label: String) -> Effect = effect_on("store", label, true)

fn reads(label: String) -> Effect = effect_on("store", label, false)

fn fs(path: String) -> Effect = effect_on("fs", path, true)

fn sim() -> Effect = effect_on("sim", "", false)

fn scheduled(index: Int, effects: List<Effect>) -> ScheduledTest =
  { index: index, contended_effects: effects }

fn unreached(effects: List<Effect>) -> ReportedTest = { listed: effects, host: false }

test "a test that uses only a simulation or a scoped effect is isolated from other tests, and a test that writes a shared effect is not" {
  let hold = effect_on("scoped", "log", false);
  assert_eq(is_isolated([sim()]), true);
  assert_eq(is_isolated([hold]), true);
  assert_eq(is_isolated([]), true);
  assert_eq(isolation_of(unreached([sim(), hold])), Isolated);
  assert_eq(cross_test_effects([writes("a"), sim(), hold]), [writes("a")]);
  assert_eq(isolation_of(unreached([writes("a")])), Shared);
  assert_eq(isolation_word(Shared), "shared");
  assert_eq(is_isolated([effect_on("m.hold", "log", false)]), false)
}

test "a seeded test stays isolated, but writes made by its tasks still make it shared" {
  assert_eq(isolation_of(unreached([sim()])), Isolated);
  assert_eq(isolation_of(unreached([sim(), writes("a")])), Shared);
  assert_eq(cross_test_effects([sim(), writes("a")]), [writes("a")]);
  assert_eq(
    group_by_conflict([
      scheduled(0, cross_test_effects([sim(), writes("a")])),
      scheduled(1, [writes("a")]),
    ]),
    [[0], [1]],
  );
  assert_eq(
    group_by_conflict([
      scheduled(0, cross_test_effects([sim()])),
      scheduled(1, cross_test_effects([sim()])),
    ]),
    [[0, 1]],
  )
}

test "a test that runs on the host is classed `host` rather than `isolated`, and only such tests are counted as host" {
  assert_eq(isolation_of({ listed: [sim()], host: true }), Host);
  assert_eq(isolation_word(Host), "host");
  assert_eq(isolation_word(Isolated), "isolated");
  let c = counts([
    { listed: [effect_on("db", "users", false)], host: true },
    unreached([]),
    unreached([sim()]),
    unreached([fs("/tmp/x")]),
  ]);
  assert_eq(c, { total: 4, isolated: 2, shared: 1, host: 1 });
  let unbound = counts([unreached([effect_on("db", "users", false)]), unreached([])]);
  assert_eq(unbound, { total: 2, isolated: 1, shared: 1, host: 0 });
  assert_eq(counts([]), { total: 0, isolated: 0, shared: 0, host: 0 })
}

test "conflict needs one writer, so two readers of one resource never conflict" {
  assert_eq(conflicts(writes("a"), writes("a")), true);
  assert_eq(conflicts(reads("a"), writes("a")), true);
  assert_eq(conflicts(writes("a"), reads("a")), true);
  assert_eq(conflicts(reads("a"), reads("a")), false);
  assert_eq(conflicts(writes("a"), writes("b")), false);
  assert_eq(conflicts(writes("a"), effect_on("db", "a", true)), false);
  assert_eq(effects_conflict([writes("a"), fs("/tmp/x")], [fs("/tmp/x")]), true);
  assert_eq(effects_conflict([writes("a")], [fs("/tmp/x")]), false)
}

test "a test joins a group only if it conflicts with none of that group's tests, because conflict is not transitive" {
  let tests = [
    scheduled(0, [writes("a"), writes("b")]),
    scheduled(1, [writes("a")]),
    scheduled(2, [writes("b")]),
  ];
  assert_eq(group_by_conflict(tests), [[0], [1, 2]]);
  assert_eq(group_by_conflict([scheduled(0, [writes("a")]), scheduled(1, [writes("a")])]), [
    [0],
    [1],
  ]);
  assert_eq(
    group_by_conflict([
      scheduled(0, [writes("a")]),
      scheduled(1, [writes("a")]),
      scheduled(2, [sim()]),
    ]),
    [[0, 2], [1]],
  );
  assert_eq(group_by_conflict([]), [])
}

test "tests with the most effects are grouped first, so the order the tests are given in does not change the grouping" {
  let small = scheduled(0, [writes("a")]);
  let big = scheduled(1, [writes("a"), writes("b")]);
  assert_eq(group_by_conflict([small, big]), [[1], [0]]);
  assert_eq(group_by_conflict([big, small]), [[1], [0]]);
  let three = [writes("a"), writes("b"), writes("c")];
  assert_eq(group_by_conflict([scheduled(2, three), scheduled(0, three), scheduled(1, three)]), [
    [0],
    [1],
    [2],
  ])
}

test "a run uses the fewest groups its shared tests need, and at least one group when any test is selected" {
  let universe = [[writes("a")], [sim()], [fs("/tmp/x")], [writes("b"), sim()]];
  let scheduled_tests = [scheduled(0, [writes("a")]), scheduled(1, [fs("/tmp/x")])];
  let groups = group_by_conflict(scheduled_tests);
  assert_eq(groups, [[0, 1]]);
  let p = parallelism(universe, scheduled_tests, groups);
  assert_eq(p.total, 4);
  assert_eq(p.conflict_free, 1);
  assert_eq(p.shared, 3);
  assert_eq(p.scheduled, 2);
  assert_eq(p.groups, 1);
  assert_eq(p.shared_groups, 1);
  assert_eq(groups_are_minimal(p), true);
  let one = parallelism(universe, [scheduled(0, [sim()])], [[0]]);
  assert_eq(one.shared_groups, 0);
  assert_eq(one.groups, 1);
  assert_eq(groups_are_minimal(one), true);
  let none = parallelism(universe, [], []);
  assert_eq(groups_are_minimal(none), true)
}

fn db(resource: String, w: Bool) -> Effect = effect_on("db", resource, w)

fn loaded(label: String) -> Effect = { ..effect_on("hermetic_machine", label, true), nondet: false }

test "an effect handled by a deterministic handler never conflicts with other tests, whatever the handler writes" {
  assert_eq(can_conflict(loaded("run")), false);
  assert_eq(is_isolated([loaded("run"), sim()]), true);
  assert_eq(isolation_of(unreached([loaded("run")])), Isolated);
  assert_eq(cross_test_effects([loaded("run"), fs("/tmp/x")]), [fs("/tmp/x")]);
  assert_eq(
    group_by_conflict(range(0, 3).map(|i: Int| scheduled(i, cross_test_effects([loaded("run")])))),
    [[0, 1, 2]],
  )
}

fn contends_of(tests: List<ScheduledTest>, i: Int) -> List<Effect> =
  tests.fold([], |found: List<Effect>, t: ScheduledTest|
    if t.index == i { t.contended_effects } else { found })

fn no_pair_conflicts(tests: List<ScheduledTest>, class: List<Int>) -> Bool / {abort.raise} =
  range(0, class.len()).all(|a: Int|
    range(a + 1, class.len()).all(|b: Int|
      !effects_conflict(contends_of(tests, class.get(a)), contends_of(tests, class.get(b)))))

test "`group_by_conflict` puts tests with no resources or different resources in one group, and puts a test that writes a resource in a separate group from the readers of that resource" {
  assert_eq(group_by_conflict(range(0, 5).map(|i: Int| scheduled(i, []))), [[0, 1, 2, 3, 4]]);
  assert_eq(
    group_by_conflict([
      scheduled(0, [db("users", true)]),
      scheduled(1, [db("orders", true)]),
      scheduled(2, []),
    ]),
    [[0, 1, 2]],
  );
  assert_eq(
    group_by_conflict([
      scheduled(0, [db("users", false)]),
      scheduled(1, [db("users", false)]),
      scheduled(2, [db("users", true)]),
      scheduled(3, [db("users", false)]),
      scheduled(4, [db("orders", true)]),
    ]),
    [[0, 1, 3, 4], [2]],
  )
}

test "tests writing the same label each get their own group, and tests writing different labels share one group" {
  assert_eq(group_by_conflict(range(0, 4).map(|i: Int| scheduled(i, [writes("users")]))).len(), 4);
  assert_eq(
    group_by_conflict(range(0, 4).map(|i: Int| scheduled(i, [writes("r" ++ i.to_string())]))),
    [[0, 1, 2, 3]],
  )
}

test "six tests that conflict in a ring, each with its two neighbours, are split into two groups" {
  let tests = [
    scheduled(0, [db("e03", true), db("e05", true), db("p0", false)]),
    scheduled(1, [db("e12", true), db("e14", true)]),
    scheduled(2, [db("e12", true), db("e25", true), db("p2", false)]),
    scheduled(3, [db("e03", true), db("e34", true)]),
    scheduled(4, [db("e14", true), db("e34", true), db("p4", false)]),
    scheduled(5, [db("e05", true), db("e25", true)]),
  ];
  assert_eq(group_by_conflict(tests), [[0, 2, 4], [1, 3, 5]])
}

test "every test is placed in exactly one group, and no group contains two tests that conflict" {
  let tests = [
    scheduled(3, [db("users", true)]),
    scheduled(7, [db("users", false)]),
    scheduled(8, []),
    scheduled(11, [db("users", true), db("orders", true)]),
    scheduled(12, [db("orders", false)]),
    scheduled(13, [writes("t0"), reads("t0")]),
    scheduled(14, [writes("t0"), reads("t0")]),
    scheduled(15, [writes("t1")]),
  ];
  let classes = group_by_conflict(tests);
  let flat = classes.fold([], |accumulator: List<Int>, class: List<Int>|
    class.fold(accumulator, |xs: List<Int>, x: Int| xs.push(x)));
  assert_eq(flat.len(), tests.len());
  assert(tests.all(|t: ScheduledTest| flat.count(|y: Int| y == t.index) == 1));
  assert(classes.all(|class: List<Int>| no_pair_conflicts(tests, class)))
}

test "`group_by_conflict` puts tests that touch no shared resource into the first group, so adding them adds no new group" {
  let contended = [
    scheduled(0, [db("users", true)]),
    scheduled(1, [db("users", false)]),
    scheduled(2, [db("orders", true)]),
  ];
  let baseline = group_by_conflict(contended);
  assert_eq(baseline, [[0, 2], [1]]);
  let wider = range(3, 40).fold(contended, |accumulator: List<ScheduledTest>, i: Int|
    accumulator.push(scheduled(i, cross_test_effects([sim()]))));
  let classes = group_by_conflict(wider);
  assert_eq(classes.len(), baseline.len());
  assert(range(3, 40).all(|i: Int| classes.get(0).count(|y: Int| y == i) == 1));
  let universe = range(3, 40).fold(
    contended.map(|t: ScheduledTest| t.contended_effects),
    |accumulator: List<List<Effect>>, i: Int| accumulator.push([sim()]),
  );
  let p = parallelism(universe, wider, classes);
  assert_eq(p.conflict_free, 37);
  assert_eq(p.shared, 3);
  assert_eq(p.shared_groups, baseline.len());
  assert_eq(groups_are_minimal(p), true)
}
