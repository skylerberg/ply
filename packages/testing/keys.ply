import std.bytes (u32_le, u64_le)
import std.hash (blake3)
import std.list
import compiler.cc (Profile)
import compiler.cc

const sim_domain: Bytes = b"ply.sim.key.1"
const seed_domain: Bytes = b"ply.sim.seed.1"
const plan_domain: Bytes = b"ply.sim.plan.1"
const code_domain: Bytes = b"ply.pass.code.1"
const case_domain: Bytes = b"ply.test.case.1"
const build_domain: Bytes = b"ply.test.build.1"

pub fn case_hash(test_hash: Bytes, identity: Bytes) -> Bytes =
  blake3(Bytes::concat_all([case_domain, test_hash, identity]))

fn built(identity: Bytes, profile: Profile) -> Bytes / {abort.raise} =
  blake3(Bytes::concat_all([build_domain, identity, cc::profile_identity(profile)]))

pub fn plan_digest(
  mode: String,
  budget: Int,
  steps: Int,
  roots: List<Int>,
  path: List<Int>,
) -> Bytes / {abort.raise} = {
  let fixed = if mode == "once" { path } else { [] };
  let normal = normal_roots(roots);
  blake3(
    Bytes::concat_all([
      plan_domain,
      mode_byte(mode),
      u32_le(if budget < 1 { 1 } else { budget }),
      u32_le(if steps < 1 { 1 } else { steps }),
      u32_le(normal.len()),
      Bytes::concat_all(normal.map(u64_le)),
      u32_le(fixed.len()),
      Bytes::concat_all(fixed.map(u16_le)),
    ]),
  )
}

fn normal_roots(roots: List<Int>) -> List<Int> / {abort.raise} =
  match sorted_ints(roots) { [] -> [0], some -> some }

fn sorted_ints(xs: List<Int>) -> List<Int> / {abort.raise} =
  xs.fold([], |accumulator: List<Int>, x: Int| {
    if accumulator.contains(x) { accumulator } else {
      let n = accumulator.len();
      let position = range(0, n).fold(n, |i: Int, j: Int|
        if i < n { i } else if x < accumulator.get(j) { j } else { i });
      insert_at(accumulator, position, x)
    }
  })

fn insert_at<a>(xs: List<a>, position: Int, x: a) -> List<a> / {abort.raise} = {
  let before = range(0, position).map(|j: Int| xs.get(j));
  let after = range(position, xs.len()).map(|j: Int| xs.get(j));
  after.fold(before.push(x), |accumulator: List<a>, y: a| accumulator.push(y))
}

fn sim_key(test_hash: Bytes, plan_digest: Bytes) -> Bytes =
  blake3(Bytes::concat_all([sim_domain, test_hash, plan_digest]))

pub fn seed_key(test_hash: Bytes, seed: Bytes, profile: Profile) -> Bytes / {abort.raise} =
  blake3(Bytes::concat_all([seed_domain, built(test_hash, profile), seed]))

pub fn result_key(
  test_hash: Bytes,
  seeded: Bool,
  plan_digest: Bytes,
  profile: Profile,
) -> Bytes / {abort.raise} = {
  let hash = built(test_hash, profile);
  if seeded { sim_key(hash, plan_digest) } else { hash }
}

pub fn code_key(
  code: Bytes,
  seeded: Bool,
  plan_digest: Bytes,
  profile: Profile,
) -> Bytes / {abort.raise} =
  blake3(
    Bytes::concat_all([code_domain, built(code, profile), if seeded { plan_digest } else { b"" }]),
  )

pub fn seed_bytes(root: Int, path: List<Int>) -> Bytes / {abort.raise} =
  Bytes::concat_all([u64_le(root), u32_le(path.len()), Bytes::concat_all(path.map(u16_le))])

pub const default_steps: Int = 100000

pub fn writes_seed_keys(mode: String, budget: Int, steps: Int, path: List<Int>) -> Bool =
  mode == "random" && budget == 1 && steps == default_steps && path.len() == 0

pub fn pass_keys(
  test_hash: Bytes,
  seeded: Bool,
  plan_digest: Bytes,
  per_root: Bool,
  roots_run: List<Int>,
  profile: Profile,
) -> List<Bytes> / {abort.raise} =
  if !seeded { [result_key(test_hash, false, plan_digest, profile)] } else {
    let roots = if per_root {
      normal_roots(roots_run).map(|root: Int| seed_key(test_hash, seed_bytes(root, []), profile))
    } else { [] };
    roots.push(result_key(test_hash, true, plan_digest, profile))
  }

fn mode_byte(mode: String) -> Bytes =
  if mode == "once" { b"\x00" } else if mode == "random" { b"\x01" } else { b"\x02" }

fn u16_le(n: Int) -> Bytes / {abort.raise} = u32_le(n & 0xFFFF).slice(0, 2)

const a_hash: Bytes =
  b"\x11\x22\x33\x44".concat(
    b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
  )

const sevens: Bytes =
  Bytes::of_hex("0707070707070707070707070707070707070707070707070707070707070707")

test "a search plan's digest matches fixed expected bytes for its fields in order, so stored keys stay stable" {
  assert_eq(
    plan_digest("once", 1, 100000, [], []),
    b"\xbc\x1a\x3b\x85\xbe\x13\x7e\x77\x8c\x4b\x60\xfa\x9e\xbc\xbb\xd5\x49\x67\xf4\x53\x82\xc4\x67\x36\x40\x87\x9f\x3f\x25\xb0\x36\x17",
  );
  assert_eq(
    plan_digest("dpor", 256, 100000, [0, 1], []),
    b"\xe8\xaa\x1f\x9d\xd0\x88\x94\x75\xed\x1f\xa7\x27\xda\xc0\xed\x48\x81\x02\xfb\x79\x4d\xf3\x27\xa9\xbb\x88\x08\x4b\xac\x33\x42\x44",
  );
  assert_eq(
    plan_digest("dpor", 256, 100000, [0], []).hex_of(),
    "3fd52dde1cf3697764f69bc85a2f911e96beccbee26bd7961190b298f4694469",
  );
  assert_eq(
    plan_digest("random", 1, 100000, [0, 1, 2, 3], []).hex_of(),
    "7a99e05acca1f79db5c3e3a9239f631e4d15aa5663fb85bb96f68460e8ff498e",
  )
}

test "a path is digested in the order its choices were taken" {
  assert_eq(
    plan_digest("once", 1, 100000, [7], [3, 0, 2]).hex_of(),
    "68e4f179b5579c9e4dc7908e92306450aa94778467373791d3cf4dad5521d6ca",
  );
  assert_eq(
    plan_digest("once", 1, 100000, [7], [2, 3, 0]).hex_of(),
    "46e36ae2c680e04083a2be5e2e0a80cf0fe236e348dac4a4f6d1638025164d80",
  );
  assert_eq(
    plan_digest("dpor", 256, 100000, [0], [1, 2]),
    plan_digest("dpor", 256, 100000, [0], []),
  )
}

test "equivalent spellings of a search plan give one digest, and changing any field gives a different digest" {
  assert_eq(
    plan_digest("dpor", 256, 100000, [3, 1, 1, 2], []),
    plan_digest("dpor", 256, 100000, [1, 2, 3], []),
  );
  assert_eq(plan_digest("dpor", 0, 0, [], []), plan_digest("dpor", 1, 1, [0], []));
  let digests = [
    plan_digest("dpor", 256, 100000, [0], []),
    plan_digest("random", 256, 100000, [0], []),
    plan_digest("dpor", 256, 100000, [0, 1], []),
    plan_digest("dpor", 257, 100000, [0], []),
    plan_digest("dpor", 256, 100001, [0], []),
    plan_digest("once", 1, 100000, [0], [1]),
    plan_digest("once", 1, 100000, [0], [2]),
  ].map(
    Bytes::hex_of,
  );
  assert_eq(
    range(0, digests.len()).filter(|i: Int|
      digests.filter(|d: String| d == digests.get(i)).len() == 1).len(
    ),
    digests.len(),
  )
}

test "a code key is derived from the code a test ran, and from the plan for a seeded test, and differs from the result key" {
  let digest = plan_digest("dpor", 256, 100000, [0], []);
  let other = plan_digest("random", 1, 100000, [0], []);
  let profile = cc::development();
  assert_eq(code_key(sevens, false, digest, profile), code_key(sevens, false, other, profile));
  assert(code_key(sevens, true, digest, profile) != code_key(sevens, true, other, profile), None);
  assert(code_key(sevens, false, digest, profile) != code_key(sevens, true, digest, profile), None);
  assert(
    code_key(sevens, false, digest, profile) != result_key(sevens, false, digest, profile),
    None,
  );
  assert(
    code_key(a_hash, false, digest, profile) != code_key(sevens, false, digest, profile),
    None,
  );
  assert(
    code_key(sevens, false, digest, profile) != code_key(sevens, false, digest, cc::release()),
    None,
  )
}

test "a seeded test's key depends on its plan, and a hermetic one's does not" {
  let hash = a_hash;
  let digest = plan_digest("dpor", 256, 100000, [0], []);
  let other = plan_digest("random", 1, 100000, [0, 1, 2, 3], []);
  let profile = cc::development();
  assert(
    sim_key(hash, digest)
      == b"\x48\x37\x11\x8d\xfc\xd9\xe6\x3b\x95\x62\xfd\xf6\x85\xb6\x7c\x6b\x67\x6b\x9a\xc4\xa8\x9b\xcf\x47\x63\xd4\x08\x3b\xdc\xc6\x5e\x76",
    None,
  );
  assert_eq(result_key(hash, false, digest, profile), result_key(hash, false, other, profile));
  assert(result_key(hash, true, digest, profile) != result_key(hash, true, other, profile), None);
  assert(result_key(hash, true, digest, profile) != result_key(hash, false, digest, profile), None)
}

test "a per-seed key is derived from the test's hash, the seed and the profile" {
  let profile = cc::development();
  assert(
    seed_key(a_hash, seed_bytes(0, []), profile) != seed_key(sevens, seed_bytes(0, []), profile),
    None,
  );
  assert(
    seed_key(a_hash, seed_bytes(0, []), profile) != seed_key(a_hash, seed_bytes(3, []), profile),
    None,
  );
  assert(
    seed_key(a_hash, seed_bytes(0, []), profile)
      != seed_key(a_hash, seed_bytes(0, []), cc::release()),
    None,
  )
}

test "`writes_seed_keys` is true only for a `random` search with one run per seed, the default step count and no root selection" {
  assert(writes_seed_keys("random", 1, default_steps, []));
  assert(!writes_seed_keys("random", 2, default_steps, []));
  assert(!writes_seed_keys("random", 1, 5, []));
  assert(!writes_seed_keys("random", 1, default_steps, [0]));
  assert(!writes_seed_keys("dpor", 1, default_steps, []))
}

test "a pass is stored under the test's result key, and for a seeded test also under the key of each seed it ran" {
  let hash = sevens;
  let profile = cc::development();
  let dpor = plan_digest("dpor", 256, 100000, [0, 1, 2], []);
  assert_eq(pass_keys(hash, false, dpor, false, [0, 1, 2], profile), [
    result_key(hash, false, dpor, profile),
  ]);
  assert_eq(pass_keys(hash, true, dpor, false, [0, 1, 2], profile), [
    result_key(hash, true, dpor, profile),
  ]);
  let four = plan_digest("random", 1, 100000, [0, 1, 2, 3], []);
  assert_eq(pass_keys(hash, true, four, true, [3, 2], profile), [
    seed_key(hash, seed_bytes(2, []), profile),
    seed_key(hash, seed_bytes(3, []), profile),
    result_key(hash, true, four, profile),
  ])
}

test "a test's result key differs between two profiles and is the same under one profile" {
  let digest = plan_digest("dpor", 256, 100000, [0], []);
  [false, true].fold((), |_: Unit, seeded: Bool| {
    assert(
      result_key(sevens, seeded, digest, cc::development())
        != result_key(sevens, seeded, digest, cc::release()),
      None,
    );
    assert_eq(
      result_key(sevens, seeded, digest, cc::release()),
      result_key(sevens, seeded, digest, cc::release()),
    )
  })
}
