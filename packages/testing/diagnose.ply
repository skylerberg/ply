import delta (Change, ChangeKind, Declaration, Delta, Derived, change, edited, derived, added,
              kind_word)
import std.list

pub type RankedChange = {
  name: String,
  hash: Option<String>,
  before: Option<String>,
  change: Option<ChangeKind>,
  test: Bool,
}

pub fn ranked_change(name: String, hash: Option<String>) -> RankedChange =
  { name: name, hash: hash, before: None, change: None, test: false }

fn ranks_before(a: RankedChange, b: RankedChange) -> Bool =
  if a.test != b.test { a.test }
  else if moved_only(a) != moved_only(b) { !moved_only(a) }
  else { compare(a.name, b.name) == Less }

fn moved_only(s: RankedChange) -> Bool = s.change == Some(Derived)

pub fn changes_of(
  found: List<{ name: String, hash: Option<String> }>,
  delta: Option<Delta>,
) -> List<RankedChange> = {
  let listed = found.map(|f: { name: String, hash: Option<String> }| ranked_change(f.name, f.hash));
  let all = match delta {
    None -> listed,
    Some(d) -> {
      let marked = listed.map(|s: RankedChange|
        match change(d, s.name) {
          Some(c) -> { ..s, before: c.before, change: Some(c.kind) },
          None -> s,
        });
      let changed = d.changes.fold(marked, |accumulator: List<RankedChange>, c: Change|
        if accumulator.any(|s: RankedChange| s.name == c.name) { accumulator } else {
          match change(d, c.name) {
            Some(shown) ->
              accumulator.push({
                ..ranked_change(shown.name, shown.after),
                before: shown.before,
                change: Some(shown.kind),
              }),
            None -> accumulator,
          }
        });
      match d.own {
        None -> changed,
        Some(c) ->
          changed.push({
            ..ranked_change(c.name, c.after),
            before: c.before,
            change: Some(c.kind),
            test: true,
          }),
      }
    },
  };
  all.sort_by(ranks_before)
}

fn described(xs: List<RankedChange>) -> List<String> =
  xs.map(|s: RankedChange|
    s.name ++ ":" ++ change_word(s.change) ++ (if s.test { ":test" } else { "" }))

fn change_word(c: Option<ChangeKind>) -> String = match c { Some(k) -> kind_word(k), None -> "-" }

fn found(names: List<String>) -> List<{ name: String, hash: Option<String> }> =
  names.map(|n: String| { name: n, hash: Some("h1") })

test "a failure that never passed is ranked by name alone" {
  assert_eq(described(changes_of(found(["zeta", "alpha"]), None)), ["alpha:-", "zeta:-"])
}

test "changes rank the test's own edit first, then edits and additions, then derived changes last" {
  let d = {
    own: Some(edited("m.t", "t1", "t2")),
    changes: [edited("known", "h1", "h2"), added("new", "h3"), derived("moved", "h4", "h5")],
  };
  assert_eq(described(changes_of(found(["moved", "known", "unseen"]), Some(d))), [
    "m.t:edited:test",
    "known:edited",
    "new:added",
    "unseen:-",
    "moved:derived",
  ])
}

test "an edit and a derived change to the same name are reported as one change, the edit" {
  let d = {
    own: None,
    changes: [derived("x", "h1", "h2"), { ..edited("x", "h3", "h4"), ns: Declaration }],
  };
  assert_eq(described(changes_of([], Some(d))), ["x:edited"]);
  assert_eq(changes_of([], Some(d)).map(|s: RankedChange| s.before), [Some("h3")])
}
