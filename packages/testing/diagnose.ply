//! `diagnose` — a failure's suspects: the definitions that changed in its test's closure since the
//! test last passed, ranked for a person who reads the list from the top.
//!
//! The test's own edit comes first, then a definition that was edited, then one whose hash only
//! moved because something under it changed, which is what an untouched dependency looks like.

import delta (Change, ChangeKind, Decl, Delta, Derived, change, edited, derived, added, kind_word)
import std.list

/// One definition a failure might be explained by, with everything the run knows about it.
pub type Suspect = {
  name: String,
  hash: Option<String>,
  /// Its hash when the test last passed.
  before: Option<String>,
  /// Absent when the two eras were never compared, so an edit looks like a moved hash.
  change: Option<ChangeKind>,
  /// The failing test itself, whose own body changed.
  test: Bool,
}

pub fn suspect(name: String, hash: Option<String>) -> Suspect =
  { name: name, hash: hash, before: None, change: None, test: false }

fn before(a: Suspect, b: Suspect) -> Bool =
  if a.test != b.test { a.test }
  else if moved_only(a) != moved_only(b) { !moved_only(a) }
  else { compare(a.name, b.name) == Less }

fn moved_only(s: Suspect) -> Bool = s.change == Some(Derived)

/// The suspects of one failure: `found` is each definition of its closure no pass has seen, with its
/// current hash, and `delta` what changed since the test last passed, when it passed before. A name
/// that is both a `fn` and a `type` is one suspect, since it is one thing to look at.
pub fn suspects_of(
  found: List<{ name: String, hash: Option<String> }>,
  delta: Option<Delta>,
) -> List<Suspect> = {
  let listed = found.map(|f: { name: String, hash: Option<String> }| suspect(f.name, f.hash));
  let all = match delta {
    None -> listed,
    Some(d) -> {
      let marked = listed.map(|s: Suspect|
        match change(d, s.name) {
          Some(c) -> { ..s, before: c.before, change: Some(c.kind) },
          None -> s,
        });
      let changed = d.changes.fold(marked, |acc: List<Suspect>, c: Change|
        if acc.any(|s: Suspect| s.name == c.name) { acc } else {
          match change(d, c.name) {
            Some(shown) ->
              acc.push({
                ..suspect(shown.name, shown.after),
                before: shown.before,
                change: Some(shown.kind),
              }),
            None -> acc,
          }
        });
      match d.own {
        None -> changed,
        Some(c) ->
          changed.push({
            ..suspect(c.name, c.after),
            before: c.before,
            change: Some(c.kind),
            test: true,
          }),
      }
    },
  };
  all.sort_by(before)
}

// --- Tests ------------------------------------------------------------------

fn described(xs: List<Suspect>) -> List<String> =
  xs.map(|s: Suspect| s.name ++ ":" ++ change_word(s.change) ++ (if s.test { ":test" } else { "" }))

fn change_word(c: Option<ChangeKind>) -> String = match c { Some(k) -> kind_word(k), None -> "-" }

fn found(names: List<String>) -> List<{ name: String, hash: Option<String> }> =
  names.map(|n: String| { name: n, hash: Some("h1") })

test "a failure that never passed is ranked by name alone" {
  assert_eq(described(suspects_of(found(["zeta", "alpha"]), None)), ["alpha:-", "zeta:-"])
}

test "the test's own edit comes first, then an edit, then a hash that only moved" {
  let d = {
    own: Some(edited("m.t", "t1", "t2")),
    changes: [edited("known", "h1", "h2"), added("new", "h3"), derived("moved", "h4", "h5")],
  };
  // A name the closure listed keeps its hash; a change the closure never listed is added.
  assert_eq(described(suspects_of(found(["moved", "known", "unseen"]), Some(d))), [
    "m.t:edited:test",
    "known:edited",
    "new:added",
    "unseen:-",
    "moved:derived",
  ])
}

test "an edit and a derived change of one name are one suspect, and the edit shows" {
  let d = {
    own: None,
    changes: [derived("x", "h1", "h2"), { ..edited("x", "h3", "h4"), ns: Decl }],
  };
  assert_eq(described(suspects_of([], Some(d))), ["x:edited"]);
  assert_eq(suspects_of([], Some(d)).map(|s: Suspect| s.before), [Some("h3")])
}
