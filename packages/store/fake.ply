import std.fs (fs, MemFs, MemResult, on_mem)
import std.random (entropy)
import std.time (time)
import compiler.store.fact_store (recent_reads, with_recent_reads)

pub fn run_in_memory<a>(
  tree: MemFs,
  go: () -> a / {fs.read[mem], fs.write[mem], recent_reads.read, recent_reads.write, entropy.next, time.now_ms, abort.raise},
) -> MemResult<a> / {abort.raise} =
  handle {
    on_mem(tree, || with_recent_reads(go))
  } with {
    var n = 0,
    entropy.next() -> {
      n = n + 1;
      n
    },
    time.now_ms() -> 1000,
  }
