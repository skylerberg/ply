import std.fs (fs, MemFs, on_mem)
import std.random (entropy)
import std.time (time)

pub type InMemoryRun<a> = { value: a, tree: MemFs }

pub fn run_in_memory<a>(
  tree: MemFs,
  go: () -> a / {fs.read[mem], fs.write[mem], entropy.next, time.now_ms, abort.raise},
) -> InMemoryRun<a> / {abort.raise} =
  handle {
    on_mem(tree, go)
  } with {
    var n = 0,
    entropy.next() -> {
      n = n + 1;
      n
    },
    time.now_ms() -> 1000,
  }
