//! What `ply` keeps between runs, as tables over the engine. Every record is a `derive bin` type, so
//! the store's schema is the digest of their shapes and changing one starts the store afresh.

import std.bin
import std.fs (fs, mem_empty)
import std.random (entropy)
import std.time (time)
import std.bytes
import compiler.store.hash (body_key)
import compiler.store.hash.forms (ModuleRecord, module_record_bin, record_digest, recorded_graph,
                                  recorded_hashes)
import engine (Store, Found, Hit, Miss, Bad, Warning, Trouble, Corrupt, Unreadable, OtherVersion,
               open, get, put, drop, keys, flush, compact, stats, warn, messages, pending, name_key,
               held)
import twin (on_twin)
import upstream (Upstream, read_entry, entry_keys, publish, mark_live)
import std.hash (blake3)

// --- Tables -----------------------------------------------------------------

fn t_defs() -> Int = 2
fn t_bodies() -> Int = 4
fn t_passed() -> Int = 5
fn t_pass_records() -> Int = 6
fn t_seen() -> Int = 7
fn t_evidence() -> Int = 8
fn t_reviews() -> Int = 9
fn t_stamps() -> Int = 11
fn t_code_passes() -> Int = 14
fn t_eras() -> Int = 15
fn t_modules() -> Int = 16

// --- Records ----------------------------------------------------------------

pub type Body = { encoding: Int, bytes: Bytes }

/// What a test last passed at: its hash, the era it passed in, and where a walk of that era's module
/// records starts to find what it reached: at what `of` references, or at what its cases run where
/// `case` says.
pub type PassRecord = { test_hash: Bytes, era: Bytes, of: Bytes, case: Bool }

type Named<a> = { name: Bytes, value: a }

/// What a human last accepted for a definition: its hash, and its own clauses' and laws' keys.
pub type Review = { def: Bytes, specs: List<Bytes> }

/// The build the versioned groups were filed by: its runtime's digest, and the one a pass filed under
/// the code its test ran answers to, which no compiler change moves.
pub type Stamps = { runtime: String, code: String }

derive bin for Body
derive bin for PassRecord
derive bin for Named
derive bin for Review
derive bin for Stamps

/// Every stored record's shape, so a store written under another encoding of any of them is not read.
pub fn schema() -> Bytes / {abort.raise} =
  Bytes::concat_all([
    bin::shape_digest(body_bin()),
    bin::shape_digest(named_bin(pass_record_bin())),
    bin::shape_digest(named_bin(review_bin())),
    bin::shape_digest(stamps_bin()),
    bin::shape_digest(bin::bytes_bin()),
    bin::shape_digest(bin::string_bin()),
    bin::shape_digest(bin::list_bin(bin::bytes_bin())),
    bin::shape_digest(module_record_bin()),
  ])

// --- Opening ----------------------------------------------------------------

/// One run's view of the store: the engine's, and the upstream it shares passes and evidence with,
/// whose passes it read when it attached; passes filed under code are shared under a schema of their
/// own, which a compiler change leaves where it was.
pub type Cache = {
  store: Store,
  stamps: Stamps,
  upstream: Option<Upstream>,
  shared: Map<Bytes, Bool>,
  code_upstream: Option<Upstream>,
  code_shared: Map<Bytes, Bool>,
}

pub fn open_cache<[r]>(dir: String, stamps: Stamps) -> Cache / {fs.read[r], abort.raise} =
  {
    store: stamped[r](open[r](dir, schema()), stamps),
    stamps: stamps,
    upstream: None,
    shared: Map::new(),
    code_upstream: None,
    code_shared: Map::new(),
  }

fn stamps_key() -> Bytes = named_key(b"stamps")

/// A versioned group of tables, and the stamp its entries were filed under.
type Group = { what: String, was: String, now: String, tables: List<Int> }

fn groups(was: Stamps, now: Stamps) -> List<Group> =
  [
    {
      what: "the test results and discharged obligations",
      was: was.runtime,
      now: now.runtime,
      tables: [t_passed(), t_pass_records(), t_seen(), t_evidence(), t_defs()],
    },
    {
      what: "the passes filed under the code their tests ran",
      was: was.code,
      now: now.code,
      tables: [t_code_passes()],
    },
  ]

fn emptied(s: Store, g: Group) -> Store / {abort.raise} =
  g.tables.fold(s, |s1: Store, t: Int| keys(s1, t).fold(s1, |s2: Store, k: Bytes| drop(s2, t, k)))

fn restamped(store: Store, now: Stamps) -> Store / {abort.raise} =
  put(store, t_stamps(), stamps_key(), bin::encode(now, stamps_bin()))

fn short_stamp(stamp: String) -> String =
  if stamp.len() > 12 { "b3:" ++ stamp.slice(0, 12) } else { stamp }

type Stamped = | Known(Stamps) | Unstamped | Garbled

/// Groups filed under other stamps are dropped, each warned once; unreadable stamps drop them all.
fn stamped<[r]>(s: Store, now: Stamps) -> Store / {fs.read[r], abort.raise} = {
  let was = match get[r](s, t_stamps(), stamps_key()) {
    Hit(bytes) -> match bin::decode(bytes, stamps_bin()) { Ok(st) -> Known(st), Err(_) -> Garbled },
    Miss -> Unstamped,
    Bad(_) -> Garbled,
  };
  let all = groups(now, now);
  let dropped = |why: Trouble, message: String|
    restamped(warn(all.fold(s, emptied), why, message), now);
  match was {
    Known(st) -> if st == now { s } else {
      restamped(
        groups(st, now).filter(|g: Group| g.was != g.now).fold(s, |s1: Store, g: Group|
          warn(
            emptied(s1, g),
            OtherVersion,
            g.what ++ " were filed by another build (" ++ short_stamp(g.was) ++ "; this one is "
              ++ short_stamp(g.now)
              ++ "), so they are filed again",
          )),
        now,
      )
    },
    Unstamped -> if all.fold(true, |none: Bool, g: Group|
        none && g.tables.fold(true, |n: Bool, t: Int| n && keys(s, t).len() == 0)) { s } else {
      dropped(OtherVersion, "the store names no stamps for its entries; they are filed again")
    },
    Garbled -> dropped(Corrupt, "the store's stamps do not read back; its entries are filed again"),
  }
}

/// Passes published there answer here; what this run learns is published back unless `publish` is
/// off. The upstream is reached under a label of its own, since it is rarely under the project.
pub fn with_upstream<[u]>(
  cache: Cache,
  root: String,
  publish: Bool,
) -> Cache / {fs.read[u], abort.raise} = {
  let under = |stamp: String|
    { root: root, schema: blake3(schema() ++ Bytes::of_string(stamp)), publish: publish };
  let up = under(cache.stamps.runtime);
  let code_up = under(cache.stamps.code);
  {
    ..cache,
    upstream: Some(up),
    shared: published_keys[u](up, t_passed()),
    code_upstream: Some(code_up),
    code_shared: published_keys[u](code_up, t_code_passes()),
  }
}

fn published_keys<[u]>(up: Upstream, table: Int) -> Map<Bytes, Bool> / {fs.read[u], abort.raise} =
  entry_keys[u](up, table).fold(Map::new(), |m: Map<Bytes, Bool>, k: Bytes| m.insert(k, true))

type Put = { table: Int, key: Bytes, payload: Bytes }

fn published_failures(n: Int, root: String) -> String =
  (if n == 1 { "1 entry" } else { n.to_string() ++ " entries" })
    ++ " could not be published to the upstream store `"
    ++ root
    ++ "`; this run is unaffected"

fn puts_in(store: Store, tables: List<Int>) -> List<Put> / {abort.raise} =
  store.puts.fold([], |acc: List<Put>, sl: Bytes, payload: Bytes|
    if tables.fold(false, |hit: Bool, t: Int| hit || t == sl.at(0)) {
      acc.push({ table: sl.at(0), key: sl.slice(1, sl.len()), payload: payload })
    } else { acc })

pub fn flush_cache<[r]>(cache: Cache) -> Cache / {fs.read[r], fs.write[r], abort.raise} =
  {
    ..cache,
    store: flush[r](if pending(cache.store) == 0 { cache.store }
    else { current[r](cache.store, cache.stamps) }),
  }

/// Whatever a flush writes goes under this build's stamps.
fn current<[r]>(store: Store, now: Stamps) -> Store / {fs.read[r], abort.raise} =
  match get[r](store, t_stamps(), stamps_key()) {
    Hit(b) -> if b == bin::encode(now, stamps_bin()) { store } else { restamped(store, now) },
    _ -> restamped(store, now),
  }

type Published = { failed: Int, known: Map<Bytes, Bool> }

/// Each of `puts` published there; `known` is what it holds of `passes`.
fn published_to<[u]>(
  up: Upstream,
  puts: List<Put>,
  known: Map<Bytes, Bool>,
  passes: Int,
) -> Published / {fs.read[u], fs.write[u], entropy.next, time.now_ms, abort.raise} =
  {
    failed: puts.fold(0, |n: Int, p: Put|
      if publish[u](up, p.table, p.key, p.payload) { n } else { n + 1 }),
    known: puts.fold(known, |m: Map<Bytes, Bool>, p: Put|
      if p.table == passes { m.insert(p.key, true) } else { m }),
  }

/// The local write comes first, so an upstream that cannot be reached never costs a run its own record.
pub fn flush_shared<[r], [u]>(
  cache: Cache,
) -> Cache / {fs.read[r], fs.write[r], fs.read[u], fs.write[u], entropy.next, time.now_ms, abort.raise} = {
  let shared = puts_in(cache.store, [t_passed(), t_evidence()]);
  let coded = puts_in(cache.store, [t_code_passes()]);
  let flushed = flush_cache[r](cache);
  match ((cache.upstream, cache.code_upstream)) {
    (Some(up), Some(code_up)) -> if !up.publish { flushed } else {
      let a = published_to[u](up, shared, flushed.shared, t_passed());
      let b = published_to[u](code_up, coded, flushed.code_shared, t_code_passes());
      // A merge keeps the schemas runs published under, so one this run read from stays too.
      let _live = mark_live[u](up);
      let _code_live = mark_live[u](code_up);
      let out = { ..flushed, shared: a.known, code_shared: b.known };
      let failed = a.failed + b.failed;
      if failed == 0 { out }
      else { { ..out, store: warn(out.store, Unreadable, published_failures(failed, up.root)) } }
    },
    _ -> flushed,
  }
}

pub fn warnings(cache: Cache) -> List<Warning> = cache.store.warnings

fn noted(cache: Cache, why: String) -> Cache = { ..cache, store: warn(cache.store, Corrupt, why) }

fn named_key(name: Bytes) -> Bytes = blake3(name)

/// A record read back: what it holds, or a warning that it did not decode and is treated as absent.
pub type Read<a> = { value: Option<a>, cache: Cache }

fn read<a, [r]>(
  cache: Cache,
  table: Int,
  key: Bytes,
  codec: bin::BinCodec<a>,
  what: String,
) -> Read<a> / {fs.read[r], abort.raise} =
  match get[r](cache.store, table, key) {
    Miss -> { value: None, cache: cache },
    Bad(why) -> { value: None, cache: noted(cache, damaged(what, why)) },
    Hit(bytes) -> match bin::decode(bytes, codec) {
      Ok(v) -> { value: Some(v), cache: cache },
      Err(e) -> { value: None, cache: noted(cache, damaged(what, bin::error_to_string(e))) },
    },
  }

fn damaged(what: String, why: String) -> String =
  "a stored " ++ what ++ " is damaged (" ++ why ++ "); it is treated as absent"

fn write<a>(
  cache: Cache,
  table: Int,
  key: Bytes,
  codec: bin::BinCodec<a>,
  value: a,
) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, table, key, bin::encode(value, codec)) }

/// A write of what is already there is no write, so a run that changed nothing flushes nothing.
fn renew<a, [r]>(
  cache: Cache,
  table: Int,
  key: Bytes,
  codec: bin::BinCodec<a>,
  value: a,
) -> Cache / {fs.read[r], abort.raise} =
  match get[r](cache.store, table, key) {
    Hit(old) -> if old == bin::encode(value, codec) { cache }
    else { write(cache, table, key, codec, value) },
    _ -> write(cache, table, key, codec, value),
  }

// --- What a passing run's definitions were -----------------------------------------
// A failure's bisection reads what its test last passed against: the era it passed in, that era's
// module records, and each definition's interface and body by its hash.

/// What a definition published, under its hash: it is a function of the hash.
pub fn def_of<[r]>(cache: Cache, hash: Bytes) -> Read<Bytes> / {fs.read[r], abort.raise} =
  read[r](cache, t_defs(), hash, bin::bytes_bin(), "interface")

/// A write of what is already there is no write.
pub fn put_def<[r]>(cache: Cache, hash: Bytes, value: Bytes) -> Cache / {fs.read[r], abort.raise} =
  renew[r](cache, t_defs(), hash, bin::bytes_bin(), value)

/// Whether an interface is filed under `hash`, read from the index alone.
pub fn holds_def(cache: Cache, hash: Bytes) -> Bool / {abort.raise} =
  held(cache.store, t_defs(), hash)

pub fn body<[r]>(cache: Cache, hash: Bytes) -> Read<Body> / {fs.read[r], abort.raise} = {
  let got = read[r](cache, t_bodies(), hash, body_bin(), "body");
  match got.value {
    Some(b) -> if body_key(b.bytes) == Some(hash) { got } else {
      { value: None, cache: noted(got.cache, damaged("body", "its envelope names another hash")) }
    },
    None -> got,
  }
}

/// A body whose envelope does not name `hash` is not filed: it could never be read back.
/// A body is keyed by a digest of itself, so a different body already there means its encoding
/// depends on something the hash does not cover: the one stored is kept and the run warned.
pub fn put_body<[r]>(cache: Cache, hash: Bytes, b: Body) -> Cache / {fs.read[r], abort.raise} =
  if body_key(b.bytes) != Some(hash) { cache } else {
    match get[r](cache.store, t_bodies(), hash) {
      Hit(old) -> if old == bin::encode(b, body_bin()) { cache } else {
        noted(
          cache,
          "two different bodies were stored for definition `" ++ hash.hex_of().slice(0, 12)
            ++ "`; the one already stored is kept",
        )
      },
      _ -> write(cache, t_bodies(), hash, body_bin(), b),
    }
  }

/// Whether a body is filed under `hash`, read from the index alone.
pub fn holds_body(cache: Cache, hash: Bytes) -> Bool / {abort.raise} =
  held(cache.store, t_bodies(), hash)

fn era_domain() -> Bytes = b"ply.era.1"

/// What an era is filed under: a digest of its modules' record digests, in their order.
pub fn era_digest(modules: List<Bytes>) -> Bytes =
  blake3(era_domain().concat(Bytes::concat_all(modules)))

/// The digests of the module records the era `digest` names; one that is not what its digest names
/// is no era.
pub fn era<[r]>(cache: Cache, digest: Bytes) -> Read<List<Bytes>> / {fs.read[r], abort.raise} = {
  let got = read[r](cache, t_eras(), digest, bin::list_bin(bin::bytes_bin()), "era");
  match got.value {
    Some(modules) -> if era_digest(modules) == digest { got } else {
      { value: None, cache: noted(got.cache, damaged("era", "it is not what its digest names")) }
    },
    None -> got,
  }
}

/// The era of `modules`, filed under its digest unless the store holds it.
pub fn put_era(cache: Cache, modules: List<Bytes>) -> Cache / {abort.raise} = {
  let digest = era_digest(modules);
  if held(cache.store, t_eras(), digest) { cache }
  else { write(cache, t_eras(), digest, bin::list_bin(bin::bytes_bin()), modules) }
}

/// The module record filed under `digest`; one that is not what its digest names is no record.
pub fn module_record<[r]>(
  cache: Cache,
  digest: Bytes,
) -> Read<ModuleRecord> / {fs.read[r], abort.raise} =
  match get[r](cache.store, t_modules(), digest) {
    Miss -> { value: None, cache: cache },
    Bad(why) -> { value: None, cache: noted(cache, damaged("module record", why)) },
    Hit(bytes) -> if record_digest(bytes) != digest {
      {
        value: None,
        cache: noted(cache, damaged("module record", "it is not what its digest names")),
      }
    } else {
      match bin::decode(bytes, module_record_bin()) {
        Ok(x) -> { value: Some(x), cache: cache },
        Err(e) ->
          { value: None, cache: noted(cache, damaged("module record", bin::error_to_string(e))) },
      }
    },
  }

/// Whether a module record is filed under `digest`, read from the index alone.
pub fn holds_module_record(cache: Cache, digest: Bytes) -> Bool / {abort.raise} =
  held(cache.store, t_modules(), digest)

/// `record`, a module record's bytes, filed under its digest unless the store holds it.
pub fn put_module_record(cache: Cache, record: Bytes) -> Cache / {abort.raise} = {
  let digest = record_digest(record);
  if held(cache.store, t_modules(), digest) { cache }
  else { { ..cache, store: put(cache.store, t_modules(), digest, record) } }
}

// --- Test results -----------------------------------------------------------

fn passed_in<[r]>(
  cache: Cache,
  table: Int,
  shared: Map<Bytes, Bool>,
  key: Bytes,
) -> Read<Bool> / {fs.read[r], abort.raise} =
  match get[r](cache.store, table, key) {
    Hit(_) -> { value: Some(true), cache: cache },
    Miss -> { value: Some(shared.contains(key)), cache: cache },
    Bad(why) -> { value: Some(shared.contains(key)), cache: noted(cache, damaged("result", why)) },
  }

pub fn passed<[r]>(cache: Cache, key: Bytes) -> Read<Bool> / {fs.read[r], abort.raise} =
  passed_in[r](cache, t_passed(), cache.shared, key)

/// The trace a pass filed under `key` here, or else in the upstream, stands on.
fn trace_in<[r], [u]>(
  cache: Cache,
  table: Int,
  upstream: Option<Upstream>,
  shared: Map<Bytes, Bool>,
  key: Bytes,
) -> Read<Bytes> / {fs.read[r], fs.read[u], abort.raise} =
  match get[r](cache.store, table, key) {
    Hit(trace) -> { value: Some(trace), cache: cache },
    Bad(why) -> { value: None, cache: noted(cache, damaged("result", why)) },
    Miss -> match upstream {
      None -> { value: None, cache: cache },
      Some(up) -> if !shared.contains(key) { { value: None, cache: cache } } else {
        match read_entry[u](up, table, key) {
          Hit(trace) -> { value: Some(trace), cache: cache },
          Miss -> { value: None, cache: cache },
          Bad(why) -> { value: None, cache: noted(cache, damaged("upstream result", why)) },
        }
      },
    },
  }

pub fn pass_trace<[r], [u]>(
  cache: Cache,
  key: Bytes,
) -> Read<Bytes> / {fs.read[r], fs.read[u], abort.raise} =
  trace_in[r, u](cache, t_passed(), cache.upstream, cache.shared, key)

/// A pass, with the trace of what its run read.
pub fn put_passed(cache: Cache, key: Bytes, trace: Bytes) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, t_passed(), key, trace) }

/// A pass filed under the code its test ran, here or in the upstream.
pub fn passed_code<[r]>(cache: Cache, key: Bytes) -> Read<Bool> / {fs.read[r], abort.raise} =
  passed_in[r](cache, t_code_passes(), cache.code_shared, key)

pub fn code_pass_trace<[r], [u]>(
  cache: Cache,
  key: Bytes,
) -> Read<Bytes> / {fs.read[r], fs.read[u], abort.raise} =
  trace_in[r, u](cache, t_code_passes(), cache.code_upstream, cache.code_shared, key)

pub fn put_passed_code(cache: Cache, key: Bytes, trace: Bytes) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, t_code_passes(), key, trace) }

pub fn pass_record<[r]>(cache: Cache, key: Bytes) -> Read<PassRecord> / {fs.read[r], abort.raise} = {
  let got = read[r](
    cache,
    t_pass_records(),
    named_key(key),
    named_bin(pass_record_bin()),
    "pass record",
  );
  match got.value {
    Some(n) -> { value: if n.name == key { Some(n.value) } else { None }, cache: got.cache },
    None -> { value: None, cache: got.cache },
  }
}

pub fn put_pass_record<[r]>(
  cache: Cache,
  key: Bytes,
  record: PassRecord,
) -> Cache / {fs.read[r], abort.raise} =
  renew[r](cache, t_pass_records(), named_key(key), named_bin(pass_record_bin()), {
    name: key,
    value: record,
  })

/// Whether the store has seen the definition `hash` pass, read from the index alone.
pub fn knows_definition(cache: Cache, hash: Bytes) -> Bool / {abort.raise} =
  held(cache.store, t_seen(), hash)

pub fn observe_definition(cache: Cache, hash: Bytes) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, t_seen(), hash, b"") }

// --- The prover -------------------------------------------------------------

pub fn evidence<[r]>(cache: Cache, key: Bytes) -> Read<Bytes> / {fs.read[r], abort.raise} =
  read[r](cache, t_evidence(), key, bin::bytes_bin(), "evidence")

/// The local entry, or else the upstream's.
pub fn evidence_shared<[r], [u]>(
  cache: Cache,
  key: Bytes,
) -> Read<Bytes> / {fs.read[r], fs.read[u], abort.raise} = {
  let local = evidence[r](cache, key);
  match local.value {
    Some(_) -> local,
    None -> match cache.upstream {
      None -> local,
      Some(up) -> match read_entry[u](up, t_evidence(), key) {
        Hit(payload) -> match bin::decode(payload, bin::bytes_bin()) {
          Ok(v) -> { value: Some(v), cache: local.cache },
          Err(e) ->
            {
              value: None,
              cache: noted(local.cache, damaged("upstream evidence", bin::error_to_string(e))),
            },
        },
        Miss -> local,
        Bad(why) -> { value: None, cache: noted(local.cache, damaged("upstream evidence", why)) },
      },
    },
  }
}

pub fn put_evidence(cache: Cache, key: Bytes, encoded: Bytes) -> Cache / {abort.raise} =
  write(cache, t_evidence(), key, bin::bytes_bin(), encoded)

pub fn review<[r]>(cache: Cache, def: Bytes) -> Read<Review> / {fs.read[r], abort.raise} = {
  let got = read[r](cache, t_reviews(), named_key(def), named_bin(review_bin()), "review");
  match got.value {
    Some(n) -> { value: if n.name == def { Some(n.value) } else { None }, cache: got.cache },
    None -> { value: None, cache: got.cache },
  }
}

pub fn put_review(cache: Cache, def: Bytes, r: Review) -> Cache / {abort.raise} =
  write(cache, t_reviews(), named_key(def), named_bin(review_bin()), { name: def, value: r })

// --- Upkeep -----------------------------------------------------------------

pub type Counts = {
  defs: Int,
  bodies: Int,
  passed: Int,
  pass_records: Int,
  eras: Int,
  modules: Int,
  seen: Int,
  evidence: Int,
  reviews: Int,
}

pub fn counts(cache: Cache) -> Counts / {abort.raise} =
  {
    defs: keys(cache.store, t_defs()).len(),
    bodies: keys(cache.store, t_bodies()).len(),
    passed: keys(cache.store, t_passed()).len(),
    pass_records: keys(cache.store, t_pass_records()).len(),
    eras: keys(cache.store, t_eras()).len(),
    modules: keys(cache.store, t_modules()).len(),
    seen: keys(cache.store, t_seen()).len(),
    evidence: keys(cache.store, t_evidence()).len(),
    reviews: keys(cache.store, t_reviews()).len(),
  }

/// How many interfaces, bodies, eras and module records a prune dropped.
pub type Pruned = { defs: Int, bodies: Int, eras: Int, modules: Int }

/// The tests whose pass record names each era, each by where a walk of it starts.
type Passed = { eras: Map<Bytes, List<{ key: Bytes, case: Bool }>>, cache: Cache }

/// What a prune keeps live: each module record a kept era names, each one decoded, and the hash of
/// each definition a test reached in the era it last passed in.
type Live = {
  modules: Map<Bytes, Bool>,
  records: Map<Bytes, ModuleRecord>,
  hashes: Map<Bytes, Bool>,
  cache: Cache,
}

/// Drops every era no pass record names, every module record no kept era names, and every interface
/// and body no test reached in the era it last passed in: a bisection reads only what a test last
/// passed against. Each era is walked once, from all the tests that last passed in it.
pub fn prune<[r]>(cache: Cache) -> { pruned: Pruned, cache: Cache } / {fs.read[r], abort.raise} = {
  let passed = keys(cache.store, t_pass_records()).fold(
    { eras: Map::new(), cache: cache },
    |acc: Passed, k: Bytes| {
      let got = read[r](
        acc.cache,
        t_pass_records(),
        k,
        named_bin(pass_record_bin()),
        "pass record",
      );
      match got.value {
        Some(n) -> {
          let era = n.value.era;
          let tests = match acc.eras.get(era) { Some(ts) -> ts, None -> [] };
          {
            eras: acc.eras.insert(era, tests.push({ key: n.value.of, case: n.value.case })),
            cache: got.cache,
          }
        },
        None -> { ..acc, cache: got.cache },
      }
    },
  );
  let live = passed.eras.fold(
    { modules: Map::new(), records: Map::new(), hashes: Map::new(), cache: passed.cache },
    |acc: Live, e: Bytes, tests: List<{ key: Bytes, case: Bool }>| {
      let got = era[r](acc.cache, e);
      match got.value {
        None -> { ..acc, cache: got.cache },
        Some(ms) -> {
          let read = ms.fold({ ..acc, cache: got.cache }, |l: Live, d: Bytes|
            if l.records.contains(d) { { ..l, modules: l.modules.insert(d, true) } } else {
              let held = module_record[r](l.cache, d);
              {
                ..l,
                modules: l.modules.insert(d, true),
                records: match held.value { Some(x) -> l.records.insert(d, x), None -> l.records },
                cache: held.cache,
              }
            });
          let records = ms.fold([], |rs: List<ModuleRecord>, d: Bytes|
            match read.records.get(d) { Some(x) -> rs.push(x), None -> rs });
          {
            ..read,
            hashes: recorded_hashes(recorded_graph(records), tests).fold(
              read.hashes,
              |m: Map<Bytes, Bool>, h: Bytes| m.insert(h, true),
            ),
          }
        },
      }
    },
  );
  let swept = |c: Cache, t: Int, keep: (Bytes) -> Bool| {
    let dead = keys(c.store, t).filter(|k: Bytes| !keep(k));
    {
      cache: { ..c, store: dead.fold(c.store, |store: Store, k: Bytes| drop(store, t, k)) },
      gone: dead.len(),
    }
  };
  let gone_eras = swept(live.cache, t_eras(), |k: Bytes| passed.eras.contains(k));
  let gone_modules = swept(gone_eras.cache, t_modules(), |k: Bytes| live.modules.contains(k));
  let defs = swept(gone_modules.cache, t_defs(), |k: Bytes| live.hashes.contains(k));
  let bodies = swept(defs.cache, t_bodies(), |k: Bytes| live.hashes.contains(k));
  {
    pruned: {
      defs: defs.gone,
      bodies: bodies.gone,
      eras: gone_eras.gone,
      modules: gone_modules.gone,
    },
    cache: bodies.cache,
  }
}

pub type Usage = { counts: Counts, segments: Int, data_bytes: Int, live_bytes: Int }

pub fn usage(cache: Cache) -> Usage / {abort.raise} = {
  let s = stats(cache.store);
  {
    counts: counts(cache),
    segments: cache.store.manifest.segments.len(),
    data_bytes: s.data_bytes,
    live_bytes: s.live_bytes,
  }
}

pub fn compact_cache<[r]>(cache: Cache) -> Cache / {fs.read[r], fs.write[r], abort.raise} =
  { ..cache, store: compact[r](cache.store) }

// --- Tests ------------------------------------------------------------------

fn built() -> Stamps = { runtime: "runtime", code: "code" }

/// A body alone in its component, which says nothing of what its calls on values call.
fn solo(payload: Bytes) -> Body =
  { encoding: 7, bytes: byte_of_int(0) ++ b"\x00\x00\x00\x00" ++ payload }

fn key_of_body(b: Body) -> Bytes / {abort.raise} =
  match body_key(b.bytes) { Some(k) -> k, None -> b"" }

/// A module record holding one definition of each of `names`, each under the hash its name keys,
/// and the test `m.t`, which references the first.
fn holding(names: List<String>) -> Bytes / {abort.raise} =
  bin::encode(
    {
      nodes: names.map(|n: String|
        { name: Bytes::of_string(n), decl: false, hash: name_key(n), edges: [] }),
      tests: [
        {
          key: b"m.t",
          hash: name_key("t"),
          refs: names.take(1).map(|n: String| { name: Bytes::of_string(n), decl: false }),
          runs: [],
        },
      ],
    },
    module_record_bin(),
  )

/// The pass record of a test that passed in the era of `modules`.
fn record_in(modules: List<Bytes>) -> PassRecord =
  { test_hash: name_key("t"), era: era_digest(modules), of: b"m.t", case: false }

test "every table round-trips through a flush and a reopen" {
  let b = solo(b"body bytes");
  let m = holding(["m.f"]);
  let run = on_twin(mem_empty(), || {
    let c1 = open_cache[mem]("cache", built());
    let c2 = put_def[mem](c1, name_key("m.f"), b"F");
    let c3 = put_era(put_module_record(put_body(c2, key_of_body(b), b), m), [record_digest(m)]);
    let c4 = put_pass_record(
      observe_definition(put_passed(c3, name_key("result"), b""), name_key("m.f")),
      b"m.t",
      record_in([record_digest(m)]),
    );
    let c5 = put_review(put_evidence(c4, name_key("claim"), b"evidence"), b"m.f", {
      def: name_key("m.f"),
      specs: [name_key("s")],
    });
    let c = flush_cache[mem](c5);
    let r = open_cache[mem]("cache", built());
    assert_eq(def_of[mem](r, name_key("m.f")).value, Some(b"F"));
    assert_eq(def_of[mem](r, name_key("m.g")).value, None);
    assert(holds_def(r, name_key("m.f")) && !holds_def(r, name_key("m.g")));
    assert_eq(body[mem](r, key_of_body(b)).value, Some(b));
    assert(holds_body(r, key_of_body(b)));
    assert_eq(passed[mem](r, name_key("result")).value, Some(true));
    assert_eq(passed[mem](r, name_key("other")).value, Some(false));
    assert(knows_definition(r, name_key("m.f")) && !knows_definition(r, name_key("m.g")));
    assert_eq(pass_record[mem](r, b"m.t").value, Some(record_in([record_digest(m)])));
    assert_eq(era[mem](r, era_digest([record_digest(m)])).value, Some([record_digest(m)]));
    assert_eq(
      module_record[mem](r, record_digest(m)).value,
      match bin::decode(m, module_record_bin()) { Ok(x) -> Some(x), Err(_) -> None },
    );
    assert(holds_module_record(r, record_digest(m)));
    assert_eq(evidence[mem](r, name_key("claim")).value, Some(b"evidence"));
    assert_eq(review[mem](r, b"m.f").value, Some({ def: name_key("m.f"), specs: [name_key("s")] }));
    assert_eq(counts(r).defs, 1);
    warnings(c)
  });
  assert_eq(run.value, [])
}

test "an era or a module record not under its own digest is not filed or not read" {
  let m = holding(["m.f"]);
  let run = on_twin(mem_empty(), || {
    let c = put_era(put_module_record(open_cache[mem]("cache", built()), m), [record_digest(m)]);
    let refiled = put_era(put_module_record(c, m), [record_digest(m)]);
    let elsewhere = { ..c, store: put(c.store, t_modules(), name_key("elsewhere"), m) };
    {
      // Filing what is held puts nothing.
      again: pending(refiled.store) == pending(c.store),
      read: module_record[mem](elsewhere, name_key("elsewhere")).value == None,
      warned: warnings(module_record[mem](elsewhere, name_key("elsewhere")).cache).len(),
    }
  });
  assert(run.value.again && run.value.read);
  assert_eq(run.value.warned, 1)
}

test "a body is filed only under the hash its envelope names" {
  let b = solo(b"x");
  let member = {
    encoding: 7,
    bytes: Bytes::concat_all([byte_of_int(1), b"\x02\x00\x00\x00", b"\x00\x00\x00\x00", b"group"]),
  };
  assert_eq(body_key(member.bytes), Some(blake3(blake3(b"group") ++ b"\x02\x00\x00\x00")));
  assert_eq(body_key(b"\x07"), None);
  let run = on_twin(mem_empty(), || {
    let c = put_body(
      put_body(open_cache[mem]("cache", built()), name_key("wrong"), b),
      key_of_body(member),
      member,
    );
    let r = open_cache[mem]("cache", built());
    let flushed = flush_cache[mem](c);
    let again = open_cache[mem]("cache", built());
    [
      body[mem](again, name_key("wrong")).value == None,
      body[mem](again, key_of_body(member)).value == Some(member),
    ]
  });
  assert_eq(run.value, [true, true])
}

test "prune keeps what each test reached in the era it last passed in, and drops the rest" {
  let live = holding(["m.passed", "m.stale"]);
  let dead = holding(["m.orphan"]);
  let run = on_twin(mem_empty(), || {
    let c0 = open_cache[mem]("cache", built());
    let c1 = put_pass_record(
      put_era(
        put_era(put_module_record(put_module_record(c0, live), dead), [record_digest(dead)]),
        [record_digest(live)],
      ),
      b"m.t",
      record_in([record_digest(live)]),
    );
    let c2 = ["m.passed", "m.stale", "m.orphan"].fold(c1, |cache: Cache, n: String|
      put_def[mem](cache, name_key(n), b"v"));
    let c3 = put_body(c2, key_of_body(solo(b"orphan")), solo(b"orphan"));
    let p = prune[mem](flush_cache[mem](c3));
    let kept = flush_cache[mem](p.cache);
    let r = open_cache[mem]("cache", built());
    {
      pruned: p.pruned,
      defs: ["m.passed", "m.stale", "m.orphan"].map(|n: String| holds_def(r, name_key(n))),
      modules: [live, dead].map(|m: Bytes| holds_module_record(r, record_digest(m))),
    }
  });
  // `m.stale` is in an era a test last passed in, and no test of that era reached it.
  assert_eq(run.value.pruned, { defs: 2, bodies: 1, eras: 1, modules: 1 });
  assert_eq(run.value.defs, [true, false, false]);
  assert_eq(run.value.modules, [true, false])
}

test "the schema is a function of the stored shapes alone" {
  assert_eq(schema(), schema());
  assert_eq(schema().len(), 8 * 32)
}

test "two runs filing different entries both keep theirs" {
  let run = on_twin(mem_empty(), || {
    let a = put_def[mem](open_cache[mem]("cache", built()), name_key("m.a"), b"A");
    let b = put_def[mem](open_cache[mem]("cache", built()), name_key("m.b"), b"B");
    let a1 = flush_cache[mem](a);
    let b1 = flush_cache[mem](b);
    let r = open_cache[mem]("cache", built());
    [def_of[mem](r, name_key("m.a")).value, def_of[mem](r, name_key("m.b")).value]
  });
  assert_eq(run.value, [Some(b"A"), Some(b"B")])
}

test "filing what is already filed writes nothing, and a second body for one hash is refused" {
  let b = solo(b"body");
  let run = on_twin(mem_empty(), || {
    let c0 = put_body(
      put_def(open_cache[mem]("cache", built()), name_key("m.f"), b"F"),
      key_of_body(b),
      b,
    );
    let c1 = flush_cache[mem](c0);
    let again = put_body(
      put_def(open_cache[mem]("cache", built()), name_key("m.f"), b"F"),
      key_of_body(b),
      b,
    );
    let other = put_body(again, key_of_body(b), { encoding: 8, bytes: b.bytes });
    { pending: pending(other.store), warned: warnings(other).len() }
  });
  assert_eq(run.value, { pending: 0, warned: 1 })
}

test "an upstream's passes and evidence answer here, and what this run learns is published there" {
  let run = on_twin(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", built()), "shared", true);
    let a1 = flush_shared[mem, mem](
      put_evidence(put_passed(a, name_key("pass"), b""), name_key("claim"), b"evidence"),
    );
    let b = with_upstream[mem](open_cache[mem]("two/cache", built()), "shared", true);
    let lonely = open_cache[mem]("three/cache", built());
    [
      passed[mem](b, name_key("pass")).value == Some(true),
      evidence_shared[mem, mem](b, name_key("claim")).value == Some(b"evidence"),
      passed[mem](lonely, name_key("pass")).value == Some(false),
      passed[mem](b, name_key("other")).value == Some(false),
      warnings(a1) == [],
    ]
  });
  assert_eq(run.value, [true, true, true, true, true])
}

test "a pass is read back with its trace, here or from the upstream, and filed again on another" {
  let run = on_twin(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", built()), "shared", true);
    let _a1 = flush_shared[mem, mem](put_passed(a, name_key("pass"), b"read a"));
    let b = with_upstream[mem](open_cache[mem]("two/cache", built()), "shared", true);
    let first = pass_trace[mem, mem](b, name_key("pass")).value;
    let _b1 = flush_shared[mem, mem](put_passed(b, name_key("pass"), b"read b"));
    let c = with_upstream[mem](open_cache[mem]("three/cache", built()), "shared", true);
    [
      first,
      pass_trace[mem, mem](c, name_key("pass")).value,
      pass_trace[mem, mem](c, name_key("other")).value,
    ]
  });
  assert_eq(run.value, [Some(b"read a"), Some(b"read b"), None])
}

test "a pass filed under the code its test ran outlives another runtime stamp, and goes with its own" {
  let run = on_twin(mem_empty(), || {
    let a = open_cache[mem]("cache", built());
    let _filed = flush_cache[mem](
      put_passed_code(put_passed(a, name_key("result"), b""), name_key("code"), b""),
    );
    let moved = open_cache[mem]("cache", { ..built(), runtime: "another" });
    let recoded = open_cache[mem]("cache", { ..built(), runtime: "another", code: "another" });
    [
      passed[mem](moved, name_key("result")).value,
      passed_code[mem](moved, name_key("code")).value,
      passed_code[mem](recoded, name_key("code")).value,
    ]
  });
  assert_eq(run.value, [Some(false), Some(true), Some(false)])
}

test "a pass filed under its code is shared under a schema of its own, which another runtime reads" {
  let run = on_twin(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", built()), "shared", true);
    let _published = flush_shared[mem, mem](
      put_passed_code(put_passed(a, name_key("pass"), b""), name_key("code"), b""),
    );
    let b = with_upstream[mem](
      open_cache[mem]("two/cache", { ..built(), runtime: "another" }),
      "shared",
      true,
    );
    [passed[mem](b, name_key("pass")).value, passed_code[mem](b, name_key("code")).value]
  });
  assert_eq(run.value, [Some(false), Some(true)])
}

test "a publishing run marks every schema it used live, and a read-only one marks none" {
  let lives = |publish: Bool|
    on_twin(mem_empty(), || {
      let a = with_upstream[mem](open_cache[mem]("one/cache", built()), "shared", publish);
      let _flushed = flush_shared[mem, mem](a);
      match fs.list_dir[mem]("shared/v2") {
        Some(dirs) -> dirs.filter(|d: String| fs.exists[mem]("shared/v2/" ++ d ++ "/live")).len(),
        None -> 0,
      }
    }).value;
  assert_eq(lives(true), 2);
  assert_eq(lives(false), 0)
}

test "a read-only upstream answers and is not written" {
  let run = on_twin(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", built()), "shared", false);
    let a1 = flush_shared[mem, mem](put_passed(a, name_key("pass"), b""));
    let b = with_upstream[mem](open_cache[mem]("two/cache", built()), "shared", true);
    passed[mem](b, name_key("pass")).value
  });
  assert_eq(run.value, Some(false))
}

test "two runs publishing one pass race harmlessly, and an unwritable upstream is a warning" {
  let run = on_twin(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", built()), "shared", true);
    let b = with_upstream[mem](open_cache[mem]("two/cache", built()), "shared", true);
    let a1 = flush_shared[mem, mem](put_passed(a, name_key("pass"), b""));
    let b1 = flush_shared[mem, mem](put_passed(b, name_key("pass"), b""));
    let blocked = fs.write_file[mem]("blocked", b"a file where the upstream should be");
    let c = with_upstream[mem](open_cache[mem]("three/cache", built()), "blocked", true);
    let c1 = flush_shared[mem, mem](put_passed(c, name_key("mine"), b""));
    let again = open_cache[mem]("three/cache", built());
    {
      clean: warnings(a1) == [] && warnings(b1) == [],
      warned: messages(warnings(c1)),
      kept: passed[mem](again, name_key("mine")).value,
    }
  });
  assert(run.value.clean);
  assert_eq(run.value.warned, [
    "1 entry could not be published to the upstream store `blocked`; this run is unaffected",
  ]);
  assert_eq(run.value.kept, Some(true))
}

test "entries filed under another build's stamp are dropped group by group, and said once" {
  let run = on_twin(mem_empty(), || {
    let c0 = put_passed_code(
      put_passed(open_cache[mem]("cache", built()), name_key("t"), b""),
      name_key("code"),
      b"",
    );
    let c1 = put_review(c0, b"m.f", { def: name_key("m.f"), specs: [] });
    let written = flush_cache[mem](c1);
    let moved = { ..built(), runtime: "elsewhere" };
    let r = open_cache[mem]("cache", moved);
    let warned = messages(r.store.warnings);
    let refiled = flush_cache[mem](open_cache[mem]("cache", moved));
    {
      warned: warned,
      passed: passed[mem](r, name_key("t")).value,
      code: passed_code[mem](r, name_key("code")).value,
      review: review[mem](r, b"m.f").value != None,
      later: messages(open_cache[mem]("cache", moved).store.warnings),
    }
  });
  assert_eq(run.value.warned, [
    "the test results and discharged obligations were filed by another build (runtime; this one is elsewhere), so they are filed again",
  ]);
  assert_eq(run.value.passed, Some(false));
  assert_eq(run.value.code, Some(true));
  assert(run.value.review);
  assert_eq(run.value.later, [])
}

test "a pass or a claim's evidence filed by another runtime is not believed" {
  let run = on_twin(mem_empty(), || {
    let c0 = put_evidence(
      put_passed(open_cache[mem]("cache", built()), name_key("t"), b""),
      name_key("claim"),
      b"evidence",
    );
    let written = flush_cache[mem](c0);
    let r = open_cache[mem]("cache", { ..built(), runtime: "another runtime" });
    {
      warned: messages(r.store.warnings).len(),
      passed: passed[mem](r, name_key("t")).value,
      evidence: evidence[mem](r, name_key("claim")).value,
    }
  });
  assert_eq(run.value.warned, 1);
  assert_eq(run.value.passed, Some(false));
  assert_eq(run.value.evidence, None)
}

test "an upstream answers only the runtime that published to it" {
  let run = on_twin(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", built()), "shared", true);
    let published = flush_shared[mem, mem](put_passed(a, name_key("pass"), b""));
    let same = with_upstream[mem](open_cache[mem]("two/cache", built()), "shared", true);
    let other = with_upstream[mem](
      open_cache[mem]("three/cache", { ..built(), runtime: "another runtime" }),
      "shared",
      true,
    );
    [passed[mem](same, name_key("pass")).value, passed[mem](other, name_key("pass")).value]
  });
  assert_eq(run.value, [Some(true), Some(false)])
}
