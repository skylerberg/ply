import std.bin
import std.fs (fs, listed_names, mem_empty)
import std.random (entropy)
import std.time (time)
import std.bytes
import compiler.store.hash.forms (ModuleRecord, module_record_bin, record_digest, recorded_graph,
                                  recorded_hashes)
import engine (Store, Lookup, Hit, Miss, Bad, Warning, WarningKind, Corrupt, Unreadable,
               OtherVersion, open, get, put, drop, keys, flush, stats, warn, messages,
               pending_count, name_key, contains_key)
import compiler.store.memo_files (database_in)
import fake (run_in_memory)
import std.hash (blake3)

const passed_table: Int = 5
const pass_records_table: Int = 6
const seen_table: Int = 7
const evidence_table: Int = 8
const reviews_table: Int = 9
const stamps_table: Int = 11
const code_passes_table: Int = 14
const snapshots_table: Int = 15
const modules_table: Int = 16
const t_texts: Int = 17
const verdicts_table: Int = 18
const statement_checks_table: Int = 19
const claims_table: Int = 20
const listings_table: Int = 21
const code_records_table: Int = 22

pub type PassRecord = {
  test_hash: Bytes,
  era: Bytes,
  walk_start: Bytes,
  case: Bool,
  passes: List<Bytes>,
}

type Named<a> = { name: Bytes, value: a }

pub type Review = { definition: Bytes, specs: List<Bytes> }

pub type ModuleClaims = { identity: Bytes, claims: Bytes, evidence: List<Bytes> }

pub type CaseListing = { listing: Bytes, cases: Bytes }

pub type Stamps = { runtime_digest: String, code: String }

derive bin for PassRecord
derive bin for Named
derive bin for Review
derive bin for ModuleClaims
derive bin for CaseListing
derive bin for Stamps

pub const schema: Bytes =
  Bytes::concat_all([
    bin::shape_digest(named_bin(pass_record_bin())),
    bin::shape_digest(named_bin(review_bin())),
    bin::shape_digest(named_bin(module_claims_bin())),
    bin::shape_digest(named_bin(case_listing_bin())),
    bin::shape_digest(named_bin(bin::list_bin(bin::bytes_bin()))),
    bin::shape_digest(stamps_bin()),
    bin::shape_digest(bin::bytes_bin()),
    bin::shape_digest(bin::string_bin()),
    bin::shape_digest(bin::list_bin(bin::bytes_bin())),
    bin::shape_digest(module_record_bin()),
  ])

pub type Cache = { store: Store, stamps: Stamps }

pub fn open_cache<[r]>(dir: String, stamps: Stamps) -> Cache / {fs.read[r], abort.raise} =
  { store: check_stamps(open[r](database_in(dir), schema), stamps), stamps: stamps }

const stamps_key: Bytes = named_key(b"stamps")

type Group = { what: String, stored_stamp: String, now: String, tables: List<Int> }

fn groups(was: Stamps, now: Stamps) -> List<Group> =
  [
    {
      what: "the test results and proof results",
      stored_stamp: was.runtime_digest,
      now: now.runtime_digest,
      tables: [
        passed_table,
        pass_records_table,
        seen_table,
        evidence_table,
        claims_table,
        listings_table,
      ],
    },
    {
      what: "the passing test results recorded for the code that was tested",
      stored_stamp: was.code,
      now: now.code,
      tables: [code_passes_table, code_records_table],
    },
  ]

fn clear_group(s: Store, g: Group) -> Store / {abort.raise} =
  g.tables.fold(s, |s1: Store, t: Int| keys(s1, t).fold(s1, |s2: Store, k: Bytes| drop(s2, t, k)))

fn write_stamps(store: Store, now: Stamps) -> Store / {abort.raise} =
  put(store, stamps_table, stamps_key, bin::encode(now, stamps_bin()))

fn short_stamp(stamp: String) -> String =
  if stamp.len() > 12 { "b3:" ++ stamp.slice(0, 12) } else { stamp }

type StoredStamps = | Known(Stamps) | Unstamped | Garbled

fn check_stamps(s: Store, now: Stamps) -> Store / {abort.raise} = {
  let was = match get(s, stamps_table, stamps_key) {
    Hit(bytes) -> match bin::decode(bytes, stamps_bin()) { Ok(st) -> Known(st), Err(_) -> Garbled },
    Miss -> Unstamped,
    Bad(_) -> Garbled,
  };
  let all = groups(now, now);
  let dropped = |reason: WarningKind, message: String|
    write_stamps(warn(all.fold(s, clear_group), reason, message), now);
  match was {
    Known(st) -> if st == now { s } else {
      write_stamps(
        groups(st, now).filter(|g: Group| g.stored_stamp != g.now).fold(s, |s1: Store, g: Group|
          warn(
            clear_group(s1, g),
            OtherVersion,
            g.what ++ " were recorded by another build (" ++ short_stamp(g.stored_stamp)
              ++ "; this one is "
              ++ short_stamp(g.now)
              ++ "), so they are recorded again",
          )),
        now,
      )
    },
    Unstamped -> if all.fold(true, |none: Bool, g: Group|
        none && g.tables.fold(true, |n: Bool, t: Int| n && keys(s, t).len() == 0)) { s } else {
      dropped(OtherVersion, "the store names no stamps for its entries; they are recorded again")
    },
    Garbled ->
      dropped(Corrupt, "the store's stamps do not read back; its entries are recorded again"),
  }
}

pub fn flush_cache<[r]>(cache: Cache) -> Cache / {fs.read[r], fs.write[r], abort.raise} =
  if pending_count(cache.store) == 0 { cache } else {
    let pruned = prune(cache);
    { ..pruned, store: flush[r](with_current_stamps(pruned.store, pruned.stamps)) }
  }

fn with_current_stamps(store: Store, now: Stamps) -> Store / {abort.raise} =
  match get(store, stamps_table, stamps_key) {
    Hit(b) -> if b == bin::encode(now, stamps_bin()) { store } else { write_stamps(store, now) },
    _ -> write_stamps(store, now),
  }

pub fn warnings(cache: Cache) -> List<Warning> = cache.store.warnings

fn warn_corrupt(cache: Cache, reason: String) -> Cache =
  { ..cache, store: warn(cache.store, Corrupt, reason) }

fn named_key(name: Bytes) -> Bytes = blake3(name)

pub type ReadResult<a> = { value: Option<a>, cache: Cache }

fn read<a>(
  cache: Cache,
  table: Int,
  key: Bytes,
  codec: bin::BinCodec<a>,
  what: String,
) -> ReadResult<a> / {abort.raise} =
  match get(cache.store, table, key) {
    Miss -> { value: None, cache: cache },
    Bad(reason) -> { value: None, cache: warn_corrupt(cache, damage_message(what, reason)) },
    Hit(bytes) -> match bin::decode(bytes, codec) {
      Ok(v) -> { value: Some(v), cache: cache },
      Err(e) ->
        { value: None, cache: warn_corrupt(cache, damage_message(what, bin::error_to_string(e))) },
    },
  }

fn damage_message(what: String, reason: String) -> String =
  "a stored " ++ what ++ " is damaged (" ++ reason ++ "); it is treated as absent"

fn write<a>(
  cache: Cache,
  table: Int,
  key: Bytes,
  codec: bin::BinCodec<a>,
  value: a,
) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, table, key, bin::encode(value, codec)) }

fn write_if_changed<a>(
  cache: Cache,
  table: Int,
  key: Bytes,
  codec: bin::BinCodec<a>,
  value: a,
) -> Cache / {abort.raise} =
  match get(cache.store, table, key) {
    Hit(old) -> if old == bin::encode(value, codec) { cache }
    else { write(cache, table, key, codec, value) },
    _ -> write(cache, table, key, codec, value),
  }

pub fn text(cache: Cache, hash: Bytes) -> ReadResult<Bytes> / {abort.raise} =
  read(cache, t_texts, hash, bin::bytes_bin(), "definition text")

pub fn put_text(cache: Cache, hash: Bytes, text: Bytes) -> Cache / {abort.raise} =
  if contains_key(cache.store, t_texts, hash) { cache }
  else { write(cache, t_texts, hash, bin::bytes_bin(), text) }

pub fn has_text(cache: Cache, hash: Bytes) -> Bool / {abort.raise} =
  contains_key(cache.store, t_texts, hash)

const snapshot_domain: Bytes = b"ply.era.1"

pub fn snapshot_digest(modules: List<Bytes>) -> Bytes =
  blake3(snapshot_domain.concat(Bytes::concat_all(modules)))

pub fn snapshot(cache: Cache, digest: Bytes) -> ReadResult<List<Bytes>> / {abort.raise} = {
  let got = read(cache, snapshots_table, digest, bin::list_bin(bin::bytes_bin()), "era");
  match got.value {
    Some(modules) -> if snapshot_digest(modules) == digest { got } else {
      {
        value: None,
        cache: warn_corrupt(
          got.cache,
          damage_message(
            "module snapshot",
            "the module list stored under this digest does not hash to the digest",
          ),
        ),
      }
    },
    None -> got,
  }
}

pub fn put_snapshot(cache: Cache, modules: List<Bytes>) -> Cache / {abort.raise} = {
  let digest = snapshot_digest(modules);
  if contains_key(cache.store, snapshots_table, digest) { cache }
  else { write(cache, snapshots_table, digest, bin::list_bin(bin::bytes_bin()), modules) }
}

pub fn module_record(cache: Cache, digest: Bytes) -> ReadResult<ModuleRecord> / {abort.raise} =
  match get(cache.store, modules_table, digest) {
    Miss -> { value: None, cache: cache },
    Bad(reason) ->
      { value: None, cache: warn_corrupt(cache, damage_message("module record", reason)) },
    Hit(bytes) -> if record_digest(bytes) != digest {
      {
        value: None,
        cache: warn_corrupt(
          cache,
          damage_message("module record", "its contents do not match its digest"),
        ),
      }
    } else {
      match bin::decode(bytes, module_record_bin()) {
        Ok(x) -> { value: Some(x), cache: cache },
        Err(e) ->
          {
            value: None,
            cache: warn_corrupt(cache, damage_message("module record", bin::error_to_string(e))),
          },
      }
    },
  }

pub fn has_module_record(cache: Cache, digest: Bytes) -> Bool / {abort.raise} =
  contains_key(cache.store, modules_table, digest)

pub fn put_module_record(cache: Cache, record: Bytes) -> Cache / {abort.raise} = {
  let digest = record_digest(record);
  if contains_key(cache.store, modules_table, digest) { cache }
  else { { ..cache, store: put(cache.store, modules_table, digest, record) } }
}

fn passed_in(cache: Cache, table: Int, key: Bytes) -> ReadResult<Bool> / {abort.raise} =
  match get(cache.store, table, key) {
    Hit(_) -> { value: Some(true), cache: cache },
    Miss -> { value: Some(false), cache: cache },
    Bad(reason) ->
      { value: Some(false), cache: warn_corrupt(cache, damage_message("result", reason)) },
  }

pub fn passed(cache: Cache, key: Bytes) -> ReadResult<Bool> / {abort.raise} =
  passed_in(cache, passed_table, key)

fn trace_in(cache: Cache, table: Int, key: Bytes) -> ReadResult<Bytes> / {abort.raise} =
  match get(cache.store, table, key) {
    Hit(trace) -> { value: Some(trace), cache: cache },
    Bad(reason) -> { value: None, cache: warn_corrupt(cache, damage_message("result", reason)) },
    Miss -> { value: None, cache: cache },
  }

pub fn pass_trace(cache: Cache, key: Bytes) -> ReadResult<Bytes> / {abort.raise} =
  trace_in(cache, passed_table, key)

pub fn put_passed(cache: Cache, key: Bytes, trace: Bytes) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, passed_table, key, trace) }

pub fn passed_code(cache: Cache, key: Bytes) -> ReadResult<Bool> / {abort.raise} =
  passed_in(cache, code_passes_table, key)

pub fn code_pass_trace(cache: Cache, key: Bytes) -> ReadResult<Bytes> / {abort.raise} =
  trace_in(cache, code_passes_table, key)

pub fn put_passed_code(cache: Cache, key: Bytes, trace: Bytes) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, code_passes_table, key, trace) }

pub fn pass_record(cache: Cache, key: Bytes) -> ReadResult<PassRecord> / {abort.raise} = {
  let got = read(
    cache,
    pass_records_table,
    named_key(key),
    named_bin(pass_record_bin()),
    "pass record",
  );
  match got.value {
    Some(n) -> { value: if n.name == key { Some(n.value) } else { None }, cache: got.cache },
    None -> { value: None, cache: got.cache },
  }
}

pub fn put_pass_record(cache: Cache, key: Bytes, record: PassRecord) -> Cache / {abort.raise} =
  write_if_changed(cache, pass_records_table, named_key(key), named_bin(pass_record_bin()), {
    name: key,
    value: record,
  })

pub fn put_code_record(cache: Cache, key: Bytes, codes: List<Bytes>) -> Cache / {abort.raise} =
  write_if_changed(
    cache,
    code_records_table,
    named_key(key),
    named_bin(bin::list_bin(bin::bytes_bin())),
    { name: key, value: codes },
  )

pub fn knows_definition(cache: Cache, hash: Bytes) -> Bool / {abort.raise} =
  contains_key(cache.store, seen_table, hash)

pub fn observe_definition(cache: Cache, hash: Bytes) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, seen_table, hash, b"") }

pub fn evidence(cache: Cache, key: Bytes) -> ReadResult<Bytes> / {abort.raise} =
  read(cache, evidence_table, key, bin::bytes_bin(), "evidence")

pub fn put_evidence(cache: Cache, key: Bytes, encoded: Bytes) -> Cache / {abort.raise} =
  write(cache, evidence_table, key, bin::bytes_bin(), encoded)

pub fn review(cache: Cache, definition: Bytes) -> ReadResult<Review> / {abort.raise} = {
  let got = read(cache, reviews_table, named_key(definition), named_bin(review_bin()), "review");
  match got.value {
    Some(n) -> { value: if n.name == definition { Some(n.value) } else { None }, cache: got.cache },
    None -> { value: None, cache: got.cache },
  }
}

pub fn put_review(cache: Cache, definition: Bytes, r: Review) -> Cache / {abort.raise} =
  write(cache, reviews_table, named_key(definition), named_bin(review_bin()), {
    name: definition,
    value: r,
  })

pub fn module_claims(cache: Cache, module: Bytes) -> ReadResult<ModuleClaims> / {abort.raise} = {
  let got = read(cache, claims_table, named_key(module), named_bin(module_claims_bin()), "claims");
  match got.value {
    Some(n) -> { value: if n.name == module { Some(n.value) } else { None }, cache: got.cache },
    None -> { value: None, cache: got.cache },
  }
}

pub fn case_listing(cache: Cache, key: Bytes) -> ReadResult<CaseListing> / {abort.raise} = {
  let got = read(cache, listings_table, named_key(key), named_bin(case_listing_bin()), "listing");
  match got.value {
    Some(n) -> { value: if n.name == key { Some(n.value) } else { None }, cache: got.cache },
    None -> { value: None, cache: got.cache },
  }
}

pub fn put_case_listing(cache: Cache, key: Bytes, listing: CaseListing) -> Cache / {abort.raise} =
  write_if_changed(cache, listings_table, named_key(key), named_bin(case_listing_bin()), {
    name: key,
    value: listing,
  })

pub fn put_module_claims(
  cache: Cache,
  module: Bytes,
  claims: ModuleClaims,
) -> Cache / {abort.raise} =
  write_if_changed(cache, claims_table, named_key(module), named_bin(module_claims_bin()), {
    name: module,
    value: claims,
  })

pub type Judged = | Verdicts | StatementChecks

fn judged_table(kind: Judged) -> Int =
  match kind { Verdicts -> verdicts_table, StatementChecks -> statement_checks_table }

pub fn judgement(cache: Cache, kind: Judged, key: Bytes) -> Option<Bytes> / {abort.raise} =
  match get(cache.store, judged_table(kind), blake3(key)) { Hit(b) -> Some(b), _ -> None }

pub fn judgements_replaced(
  cache: Cache,
  kind: Judged,
  judgements: Map<Bytes, Bytes>,
) -> Cache / {abort.raise} = {
  let table = judged_table(kind);
  let wanted = judgements.fold(Map::new(), |found: Map<Bytes, Bytes>, key: Bytes, value: Bytes|
    found.insert(blake3(key), value));
  let dropped = keys(cache.store, table).filter(|k: Bytes| !wanted.contains(k)).fold(
    cache.store,
    |store: Store, k: Bytes| drop(store, table, k),
  );
  {
    ..cache,
    store: wanted.fold(dropped, |store: Store, k: Bytes, value: Bytes|
      match get(store, table, k) {
        Hit(old) -> if old == value { store } else { put(store, table, k, value) },
        _ -> put(store, table, k, value),
      }),
  }
}

pub type Counts = {
  texts: Int,
  passed: Int,
  pass_records: Int,
  snapshots: Int,
  modules: Int,
  seen: Int,
  evidence: Int,
  reviews: Int,
}

pub fn counts(cache: Cache) -> Counts / {abort.raise} =
  {
    texts: keys(cache.store, t_texts).len(),
    passed: keys(cache.store, passed_table).len(),
    pass_records: keys(cache.store, pass_records_table).len(),
    snapshots: keys(cache.store, snapshots_table).len(),
    modules: keys(cache.store, modules_table).len(),
    seen: keys(cache.store, seen_table).len(),
    evidence: keys(cache.store, evidence_table).len(),
    reviews: keys(cache.store, reviews_table).len(),
  }

type PassesBySnapshot = {
  eras: Map<Bytes, List<{ key: Bytes, case: Bool }>>,
  tests: Map<Bytes, Bool>,
  passes: Map<Bytes, Bool>,
  cache: Cache,
}

type Live = {
  modules: Map<Bytes, Bool>,
  records: Map<Bytes, ModuleRecord>,
  hashes: Map<Bytes, Bool>,
  cache: Cache,
}

pub fn prune(cache: Cache) -> Cache / {abort.raise} = {
  let passed = keys(cache.store, pass_records_table).fold(
    { eras: Map::new(), tests: Map::new(), passes: Map::new(), cache: cache },
    |accumulator: PassesBySnapshot, k: Bytes| {
      let got = read(
        accumulator.cache,
        pass_records_table,
        k,
        named_bin(pass_record_bin()),
        "pass record",
      );
      match got.value {
        Some(n) -> {
          let snapshot = n.value.era;
          let tests = match accumulator.eras.get(snapshot) { Some(ts) -> ts, None -> [] };
          {
            eras: accumulator.eras.insert(
              snapshot,
              tests.push({ key: n.value.walk_start, case: n.value.case }),
            ),
            tests: accumulator.tests.insert(n.value.test_hash, true),
            passes: n.value.passes.fold(accumulator.passes, |m: Map<Bytes, Bool>, k: Bytes|
              m.insert(k, true)),
            cache: got.cache,
          }
        },
        None -> { ..accumulator, cache: got.cache },
      }
    },
  );
  let live = passed.eras.fold(
    { modules: Map::new(), records: Map::new(), hashes: Map::new(), cache: passed.cache },
    |accumulator: Live, e: Bytes, tests: List<{ key: Bytes, case: Bool }>| {
      let got = snapshot(accumulator.cache, e);
      match got.value {
        None -> { ..accumulator, cache: got.cache },
        Some(ms) -> {
          let read = ms.fold({ ..accumulator, cache: got.cache }, |l: Live, d: Bytes|
            if l.records.contains(d) { { ..l, modules: l.modules.insert(d, true) } } else {
              let record_result = module_record(l.cache, d);
              {
                ..l,
                modules: l.modules.insert(d, true),
                records: match record_result.value {
                  Some(x) -> l.records.insert(d, x),
                  None -> l.records,
                },
                cache: record_result.cache,
              }
            });
          let records = ms.fold([], |rs: List<ModuleRecord>, d: Bytes|
            match read.records.get(d) { Some(x) -> rs.push(x), None -> rs });
          {
            ..read,
            hashes: recorded_hashes(recorded_graph(records), tests).fold(
              read.hashes,
              |m: Map<Bytes, Bool>, h: Bytes| m.insert(h, true),
            ),
          }
        },
      }
    },
  );
  let claimed = keys(live.cache.store, claims_table).fold(
    { evidence: Map::new(), cache: live.cache },
    |found: { evidence: Map<Bytes, Bool>, cache: Cache }, k: Bytes| {
      let got = read(found.cache, claims_table, k, named_bin(module_claims_bin()), "claims");
      {
        evidence: match got.value {
          Some(n) ->
            n.value.evidence.fold(found.evidence, |m: Map<Bytes, Bool>, e: Bytes|
              m.insert(e, true)),
          None -> found.evidence,
        },
        cache: got.cache,
      }
    },
  );
  let coded = keys(claimed.cache.store, code_records_table).fold(
    { keys: Map::new(), cache: claimed.cache },
    |found: { keys: Map<Bytes, Bool>, cache: Cache }, k: Bytes| {
      let got = read(
        found.cache,
        code_records_table,
        k,
        named_bin(bin::list_bin(bin::bytes_bin())),
        "code record",
      );
      {
        keys: match got.value {
          Some(n) ->
            n.value.fold(found.keys, |m: Map<Bytes, Bool>, key: Bytes| m.insert(key, true)),
          None -> found.keys,
        },
        cache: got.cache,
      }
    },
  );
  let swept = |c: Cache, t: Int, keep: (Bytes) -> Bool|
    {
      ..c,
      store: keys(c.store, t).filter(|k: Bytes| !keep(k)).fold(c.store, |store: Store, k: Bytes|
        drop(store, t, k)),
    };
  [
    { table: snapshots_table, keep: |k: Bytes| passed.eras.contains(k) },
    { table: modules_table, keep: |k: Bytes| live.modules.contains(k) },
    { table: t_texts, keep: |k: Bytes| live.hashes.contains(k) || passed.tests.contains(k) },
    { table: evidence_table, keep: |k: Bytes| claimed.evidence.contains(k) },
    { table: passed_table, keep: |k: Bytes| passed.passes.contains(k) },
    { table: code_passes_table, keep: |k: Bytes| coded.keys.contains(k) },
  ].fold(coded.cache, |c: Cache, t: { table: Int, keep: (Bytes) -> Bool }|
    swept(c, t.table, t.keep))
}

const test_stamps: Stamps = { runtime_digest: "runtime", code: "code" }

fn module_record_with_names(names: List<String>) -> Bytes / {abort.raise} =
  bin::encode(
    {
      nodes: names.map(|n: String|
        { name: Bytes::of_string(n), declaration: false, hash: name_key(n), edges: [] }),
      tests: [
        {
          key: b"m.t",
          hash: name_key("t"),
          refs: names.take(1).map(|n: String| { name: Bytes::of_string(n), declaration: false }),
          runs: [],
        },
      ],
    },
    module_record_bin(),
  )

fn record_in(modules: List<Bytes>) -> PassRecord =
  {
    test_hash: name_key("t"),
    era: snapshot_digest(modules),
    walk_start: b"m.t",
    case: false,
    passes: [name_key("result")],
  }

test "every table round-trips through a flush and a reopen" {
  let m = module_record_with_names(["m.f"]);
  let run = run_in_memory(mem_empty(), || {
    let c1 = open_cache[mem]("cache", test_stamps);
    let c2 = put_text(c1, name_key("m.f"), b"fn f() -> Int = 1\n");
    let c3 = put_snapshot(put_module_record(c2, m), [record_digest(m)]);
    let c4 = put_pass_record(
      observe_definition(put_passed(c3, name_key("result"), b""), name_key("m.f")),
      b"m.t",
      record_in([record_digest(m)]),
    );
    let claimed = put_module_claims(c4, b"m", {
      identity: b"",
      claims: b"",
      evidence: [name_key("claim")],
    });
    let c5 = put_review(put_evidence(claimed, name_key("claim"), b"evidence"), b"m.f", {
      definition: name_key("m.f"),
      specs: [name_key("s")],
    });
    let c = flush_cache[mem](c5);
    let r = open_cache[mem]("cache", test_stamps);
    assert_eq(text(r, name_key("m.f")).value, Some(b"fn f() -> Int = 1\n"));
    assert_eq(text(r, name_key("m.g")).value, None);
    assert(has_text(r, name_key("m.f")) && !has_text(r, name_key("m.g")));
    assert_eq(passed(r, name_key("result")).value, Some(true));
    assert_eq(passed(r, name_key("other")).value, Some(false));
    assert(knows_definition(r, name_key("m.f")) && !knows_definition(r, name_key("m.g")));
    assert_eq(pass_record(r, b"m.t").value, Some(record_in([record_digest(m)])));
    assert_eq(snapshot(r, snapshot_digest([record_digest(m)])).value, Some([record_digest(m)]));
    assert_eq(
      module_record(r, record_digest(m)).value,
      match bin::decode(m, module_record_bin()) { Ok(x) -> Some(x), Err(_) -> None },
    );
    assert(has_module_record(r, record_digest(m)));
    assert_eq(evidence(r, name_key("claim")).value, Some(b"evidence"));
    assert_eq(
      review(r, b"m.f").value,
      Some({ definition: name_key("m.f"), specs: [name_key("s")] }),
    );
    warnings(c)
  });
  assert_eq(run.value, [])
}

test "recording a snapshot or module record again writes nothing, and a module record filed under a name other than its digest is not read and warns" {
  let m = module_record_with_names(["m.f"]);
  let run = run_in_memory(mem_empty(), || {
    let c = put_snapshot(put_module_record(open_cache[mem]("cache", test_stamps), m), [
      record_digest(m),
    ]);
    let passes_kept = put_snapshot(put_module_record(c, m), [record_digest(m)]);
    let elsewhere = { ..c, store: put(c.store, modules_table, name_key("elsewhere"), m) };
    {
      reprinted: pending_count(passes_kept.store) == pending_count(c.store),
      read: module_record(elsewhere, name_key("elsewhere")).value == None,
      warned: warnings(module_record(elsewhere, name_key("elsewhere")).cache).len(),
    }
  });
  assert(run.value.reprinted && run.value.read);
  assert_eq(run.value.warned, 1)
}

test "`prune` deletes cached texts, snapshots and module records that no passing test used, and keeps the ones a passing test used" {
  let live = module_record_with_names(["m.passed", "m.stale"]);
  let dead = module_record_with_names(["m.orphan"]);
  let run = run_in_memory(mem_empty(), || {
    let c0 = open_cache[mem]("cache", test_stamps);
    let c1 = put_pass_record(
      put_snapshot(
        put_snapshot(put_module_record(put_module_record(c0, live), dead), [record_digest(dead)]),
        [record_digest(live)],
      ),
      b"m.t",
      record_in([record_digest(live)]),
    );
    let c2 = ["m.passed", "m.stale", "m.orphan", "t"].fold(c1, |cache: Cache, n: String|
      put_text(cache, name_key(n), b"v"));
    let pruned_cache = flush_cache[mem](prune(c2));
    let r = open_cache[mem]("cache", test_stamps);
    {
      texts: ["m.passed", "m.stale", "m.orphan", "t"].map(|n: String| has_text(r, name_key(n))),
      modules: [live, dead].map(|m: Bytes| has_module_record(r, record_digest(m))),
    }
  });
  assert_eq(run.value.texts, [true, false, false, true]);
  assert_eq(run.value.modules, [true, false])
}

test "`prune` deletes test passes that no pass record lists, and keeps the passes they list" {
  let run = run_in_memory(mem_empty(), || {
    let m = module_record_with_names(["m.f"]);
    let c0 = put_snapshot(put_module_record(open_cache[mem]("cache", test_stamps), m), [
      record_digest(m),
    ]);
    let c1 = put_pass_record(c0, b"m.t", record_in([record_digest(m)]));
    let c2 = put_code_record(put_passed_code(c1, name_key("code"), b""), b"m.t", [
      name_key("code"),
    ]);
    let c3 = put_passed_code(
      put_passed(put_passed(c2, name_key("result"), b""), name_key("stale"), b""),
      name_key("old code"),
      b"",
    );
    let flushed = flush_cache[mem](c3);
    let r = open_cache[mem]("cache", test_stamps);
    [
      passed(r, name_key("result")).value,
      passed(r, name_key("stale")).value,
      passed_code(r, name_key("code")).value,
      passed_code(r, name_key("old code")).value,
    ]
  });
  assert_eq(run.value, [Some(true), Some(false), Some(true), Some(false)])
}

test "`prune` deletes proof evidence that no module's claims list, and keeps the evidence they list" {
  let run = run_in_memory(mem_empty(), || {
    let c0 = put_module_claims(open_cache[mem]("cache", test_stamps), b"m", {
      identity: b"",
      claims: b"",
      evidence: [name_key("listed")],
    });
    let c1 = put_evidence(put_evidence(c0, name_key("listed"), b"a"), name_key("stale"), b"b");
    let c = flush_cache[mem](c1);
    let r = open_cache[mem]("cache", test_stamps);
    [evidence(r, name_key("listed")).value, evidence(r, name_key("stale")).value]
  });
  assert_eq(run.value, [Some(b"a"), None])
}

test "two runs update different entries both keep theirs" {
  let run = run_in_memory(mem_empty(), || {
    let claims = |text: Bytes| { identity: b"", claims: text, evidence: [] };
    let a = put_module_claims(open_cache[mem]("cache", test_stamps), b"m.a", claims(b"A"));
    let b = put_module_claims(open_cache[mem]("cache", test_stamps), b"m.b", claims(b"B"));
    let a1 = flush_cache[mem](a);
    let b1 = flush_cache[mem](b);
    let r = open_cache[mem]("cache", test_stamps);
    [b"m.a", b"m.b"].map(|m: Bytes|
      match module_claims(r, m).value { Some(c) -> c.claims, None -> b"" })
  });
  assert_eq(run.value, [b"A", b"B"])
}

test "recording a text under a hash that already has a text writes nothing and leaves the first text unchanged" {
  let run = run_in_memory(mem_empty(), || {
    let first = put_text(open_cache[mem]("cache", test_stamps), name_key("m.f"), b"F");
    let again = put_text(first, name_key("m.f"), b"F // a comment");
    { pending: pending_count(again.store), retained: text(again, name_key("m.f")).value }
  });
  assert_eq(run.value, { pending: 1, retained: Some(b"F") })
}

test "a passing result saved with its test's code is still found after the runtime digest changes, but is lost once the code stamp changes too" {
  let run = run_in_memory(mem_empty(), || {
    let a = open_cache[mem]("cache", test_stamps);
    let _recorded = flush_cache[mem](
      put_code_record(
        put_passed_code(put_passed(a, name_key("result"), b""), name_key("code"), b""),
        b"m.t",
        [name_key("code")],
      ),
    );
    let moved = open_cache[mem]("cache", { ..test_stamps, runtime_digest: "another" });
    let recoded = open_cache[mem]("cache", {
      ..test_stamps,
      runtime_digest: "another",
      code: "another",
    });
    [
      passed(moved, name_key("result")).value,
      passed_code(moved, name_key("code")).value,
      passed_code(recoded, name_key("code")).value,
    ]
  });
  assert_eq(run.value, [Some(false), Some(true), Some(false)])
}

test "cache entries written by a different build are discarded with a single warning, and the next open does not warn again" {
  let run = run_in_memory(mem_empty(), || {
    let c0 = put_code_record(
      put_passed_code(
        put_passed(open_cache[mem]("cache", test_stamps), name_key("t"), b""),
        name_key("code"),
        b"",
      ),
      b"m.t",
      [name_key("code")],
    );
    let c1 = put_review(c0, b"m.f", { definition: name_key("m.f"), specs: [] });
    let written = flush_cache[mem](c1);
    let moved = { ..test_stamps, runtime_digest: "elsewhere" };
    let r = open_cache[mem]("cache", moved);
    let warned = messages(r.store.warnings);
    let passes_kept = flush_cache[mem](open_cache[mem]("cache", moved));
    {
      warned: warned,
      passed: passed(r, name_key("t")).value,
      code: passed_code(r, name_key("code")).value,
      review: review(r, b"m.f").value != None,
      later: messages(open_cache[mem]("cache", moved).store.warnings),
    }
  });
  assert_eq(run.value.warned, [
    "the test results and proof results were recorded by another build (runtime; this one is elsewhere), so they are recorded again",
  ]);
  assert_eq(run.value.passed, Some(false));
  assert_eq(run.value.code, Some(true));
  assert(run.value.review);
  assert_eq(run.value.later, [])
}

test "opening a cache written by a different runtime warns once and returns no stored test result or evidence" {
  let run = run_in_memory(mem_empty(), || {
    let c0 = put_evidence(
      put_passed(open_cache[mem]("cache", test_stamps), name_key("t"), b""),
      name_key("claim"),
      b"evidence",
    );
    let written = flush_cache[mem](c0);
    let r = open_cache[mem]("cache", { ..test_stamps, runtime_digest: "another runtime" });
    {
      warned: messages(r.store.warnings).len(),
      passed: passed(r, name_key("t")).value,
      evidence: evidence(r, name_key("claim")).value,
    }
  });
  assert_eq(run.value.warned, 1);
  assert_eq(run.value.passed, Some(false));
  assert_eq(run.value.evidence, None)
}
