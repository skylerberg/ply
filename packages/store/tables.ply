//! What `ply` keeps between runs, as tables over the engine. Every record is a `derive bin` type, so
//! the store's schema is the digest of their shapes and changing one starts the store afresh.

import std.bin
import std.fs (fs, listed_names, mem_empty)
import std.random (entropy)
import std.time (time)
import std.bytes
import compiler.store.hash.forms (ModuleRecord, module_record_bin, record_digest, recorded_graph,
                                  recorded_hashes)
import engine (Store, Lookup, Hit, Miss, Bad, Warning, WarningKind, Corrupt, Unreadable,
               OtherVersion, open, get, put, drop, keys, flush, compact, stats, warn, messages,
               pending_count, name_key, contains_key)
import fake (run_in_memory)
import upstream (Upstream, read_entry, entry_keys, publish, mark_live)
import std.hash (blake3)

// --- Tables -----------------------------------------------------------------

fn passed_table() -> Int = 5
fn pass_records_table() -> Int = 6
fn seen_table() -> Int = 7
fn evidence_table() -> Int = 8
fn reviews_table() -> Int = 9
fn stamps_table() -> Int = 11
fn code_passes_table() -> Int = 14
fn snapshots_table() -> Int = 15
fn modules_table() -> Int = 16
fn t_texts() -> Int = 17

// --- Records ----------------------------------------------------------------

/// What a test last passed at: its hash, the era it passed in, and where a walk of that era's module
/// records starts to find what it reached: at what `of` references, or at what its cases run where
/// `case` says.
pub type PassRecord = { test_hash: Bytes, era: Bytes, of: Bytes, case: Bool }

type Named<a> = { name: Bytes, value: a }

/// What a human last accepted for a definition: its hash, and its own clauses' and laws' keys.
pub type Review = { definition: Bytes, specs: List<Bytes> }

/// The build the versioned groups were filed by: its runtime's digest, and the one a pass filed under
/// the code its test ran answers to, which no compiler change moves.
pub type Stamps = { runtime: String, code: String }

derive bin for PassRecord
derive bin for Named
derive bin for Review
derive bin for Stamps

/// Every stored record's shape, so a store written under another encoding of any of them is not read.
pub fn schema() -> Bytes / {abort.raise} =
  Bytes::concat_all([
    bin::shape_digest(named_bin(pass_record_bin())),
    bin::shape_digest(named_bin(review_bin())),
    bin::shape_digest(stamps_bin()),
    bin::shape_digest(bin::bytes_bin()),
    bin::shape_digest(bin::string_bin()),
    bin::shape_digest(bin::list_bin(bin::bytes_bin())),
    bin::shape_digest(module_record_bin()),
  ])

// --- Opening ----------------------------------------------------------------

/// One run's view of the store: the engine's, and the upstream it shares passes and evidence with,
/// whose passes it read when it attached; passes filed under code are shared under a schema of their
/// own, which a compiler change leaves where it was.
pub type Cache = {
  store: Store,
  stamps: Stamps,
  upstream: Option<Upstream>,
  shared: Map<Bytes, Bool>,
  code_upstream: Option<Upstream>,
  code_shared: Map<Bytes, Bool>,
}

pub fn open_cache<[r]>(dir: String, stamps: Stamps) -> Cache / {fs.read[r], abort.raise} =
  {
    store: check_stamps[r](open[r](dir, schema()), stamps),
    stamps: stamps,
    upstream: None,
    shared: Map::new(),
    code_upstream: None,
    code_shared: Map::new(),
  }

fn stamps_key() -> Bytes = named_key(b"stamps")

/// A versioned group of tables, and the stamp its entries were filed under.
type Group = { what: String, was: String, now: String, tables: List<Int> }

fn groups(was: Stamps, now: Stamps) -> List<Group> =
  [
    {
      what: "the test results and discharged obligations",
      was: was.runtime,
      now: now.runtime,
      tables: [passed_table(), pass_records_table(), seen_table(), evidence_table()],
    },
    {
      what: "the passes recorded under the code their tests ran",
      was: was.code,
      now: now.code,
      tables: [code_passes_table()],
    },
  ]

fn clear_group(s: Store, g: Group) -> Store / {abort.raise} =
  g.tables.fold(s, |s1: Store, t: Int| keys(s1, t).fold(s1, |s2: Store, k: Bytes| drop(s2, t, k)))

fn write_stamps(store: Store, now: Stamps) -> Store / {abort.raise} =
  put(store, stamps_table(), stamps_key(), bin::encode(now, stamps_bin()))

fn short_stamp(stamp: String) -> String =
  if stamp.len() > 12 { "b3:" ++ stamp.slice(0, 12) } else { stamp }

type StoredStamps = | Known(Stamps) | Unstamped | Garbled

/// Groups filed under other stamps are dropped, each warned once; unreadable stamps drop them all.
fn check_stamps<[r]>(s: Store, now: Stamps) -> Store / {fs.read[r], abort.raise} = {
  let was = match get[r](s, stamps_table(), stamps_key()) {
    Hit(bytes) -> match bin::decode(bytes, stamps_bin()) { Ok(st) -> Known(st), Err(_) -> Garbled },
    Miss -> Unstamped,
    Bad(_) -> Garbled,
  };
  let all = groups(now, now);
  let dropped = |reason: WarningKind, message: String|
    write_stamps(warn(all.fold(s, clear_group), reason, message), now);
  match was {
    Known(st) -> if st == now { s } else {
      write_stamps(
        groups(st, now).filter(|g: Group| g.was != g.now).fold(s, |s1: Store, g: Group|
          warn(
            clear_group(s1, g),
            OtherVersion,
            g.what ++ " were recorded by another build (" ++ short_stamp(g.was) ++ "; this one is "
              ++ short_stamp(g.now)
              ++ "), so they are recorded again",
          )),
        now,
      )
    },
    Unstamped -> if all.fold(true, |none: Bool, g: Group|
        none && g.tables.fold(true, |n: Bool, t: Int| n && keys(s, t).len() == 0)) { s } else {
      dropped(OtherVersion, "the store names no stamps for its entries; they are recorded again")
    },
    Garbled -> dropped(Corrupt, "the store's stamps do not read back; its entries are recorded again"),
  }
}

/// Passes published there answer here; what this run learns is published back unless `publish` is
/// off. The upstream is reached under a label of its own, since it is rarely under the project.
pub fn with_upstream<[u]>(
  cache: Cache,
  root: String,
  publish: Bool,
) -> Cache / {fs.read[u], abort.raise} = {
  let under = |stamp: String|
    { root: root, schema: blake3(schema() ++ Bytes::of_string(stamp)), publish: publish };
  let upstream_store = under(cache.stamps.runtime);
  let code_upstream_store = under(cache.stamps.code);
  {
    ..cache,
    upstream: Some(upstream_store),
    shared: published_keys[u](upstream_store, passed_table()),
    code_upstream: Some(code_upstream_store),
    code_shared: published_keys[u](code_upstream_store, code_passes_table()),
  }
}

fn published_keys<[u]>(
  upstream_store: Upstream,
  table: Int,
) -> Map<Bytes, Bool> / {fs.read[u], abort.raise} =
  entry_keys[u](upstream_store, table).fold(Map::new(), |m: Map<Bytes, Bool>, k: Bytes|
    m.insert(k, true))

type Put = { table: Int, key: Bytes, payload: Bytes }

fn publish_failure_message(n: Int, root: String) -> String =
  (if n == 1 { "1 entry" } else { n.to_string() ++ " entries" })
    ++ " could not be published to the upstream store `"
    ++ root
    ++ "`; this run is unaffected"

fn puts_in(store: Store, tables: List<Int>) -> List<Put> / {abort.raise} =
  store.puts.fold([], |acc: List<Put>, sl: Bytes, payload: Bytes|
    if tables.fold(false, |hit: Bool, t: Int| hit || t == sl.at(0)) {
      acc.push({ table: sl.at(0), key: sl.slice(1, sl.len()), payload: payload })
    } else { acc })

pub fn flush_cache<[r]>(cache: Cache) -> Cache / {fs.read[r], fs.write[r], abort.raise} =
  {
    ..cache,
    store: flush[r](if pending_count(cache.store) == 0 { cache.store }
    else { with_current_stamps[r](cache.store, cache.stamps) }),
  }

/// Whatever a flush writes goes under this build's stamps.
fn with_current_stamps<[r]>(store: Store, now: Stamps) -> Store / {fs.read[r], abort.raise} =
  match get[r](store, stamps_table(), stamps_key()) {
    Hit(b) -> if b == bin::encode(now, stamps_bin()) { store } else { write_stamps(store, now) },
    _ -> write_stamps(store, now),
  }

type PublishResult = { failed: Int, known: Map<Bytes, Bool> }

/// Each of `puts` published there; `known` is what it holds of `passes`.
fn publish_all<[u]>(
  upstream_store: Upstream,
  puts: List<Put>,
  known: Map<Bytes, Bool>,
  passes: Int,
) -> PublishResult / {fs.read[u], fs.write[u], entropy.next, time.now_ms, abort.raise} =
  {
    failed: puts.fold(0, |n: Int, p: Put|
      if publish[u](upstream_store, p.table, p.key, p.payload) { n } else { n + 1 }),
    known: puts.fold(known, |m: Map<Bytes, Bool>, p: Put|
      if p.table == passes { m.insert(p.key, true) } else { m }),
  }

/// The local write comes first, so an upstream that cannot be reached never costs a run its own record.
pub fn flush_shared<[r], [u]>(
  cache: Cache,
) -> Cache / {fs.read[r], fs.write[r], fs.read[u], fs.write[u], entropy.next, time.now_ms, abort.raise} = {
  let shared = puts_in(cache.store, [passed_table(), evidence_table()]);
  let coded = puts_in(cache.store, [code_passes_table()]);
  let flushed = flush_cache[r](cache);
  match ((cache.upstream, cache.code_upstream)) {
    (Some(upstream_store), Some(code_upstream_store)) -> if !upstream_store.publish { flushed }
    else {
      let a = publish_all[u](upstream_store, shared, flushed.shared, passed_table());
      let b = publish_all[u](code_upstream_store, coded, flushed.code_shared, code_passes_table());
      // A merge keeps the schemas runs published under, so one this run read from stays too.
      let _live = mark_live[u](upstream_store);
      let _code_live = mark_live[u](code_upstream_store);
      let out = { ..flushed, shared: a.known, code_shared: b.known };
      let failed = a.failed + b.failed;
      if failed == 0 { out } else {
        {
          ..out,
          store: warn(out.store, Unreadable, publish_failure_message(failed, upstream_store.root)),
        }
      }
    },
    _ -> flushed,
  }
}

pub fn warnings(cache: Cache) -> List<Warning> = cache.store.warnings

fn warn_corrupt(cache: Cache, reason: String) -> Cache =
  { ..cache, store: warn(cache.store, Corrupt, reason) }

fn named_key(name: Bytes) -> Bytes = blake3(name)

/// A record read back: what it holds, or a warning that it did not decode and is treated as absent.
pub type ReadResult<a> = { value: Option<a>, cache: Cache }

fn read<a, [r]>(
  cache: Cache,
  table: Int,
  key: Bytes,
  codec: bin::BinCodec<a>,
  what: String,
) -> ReadResult<a> / {fs.read[r], abort.raise} =
  match get[r](cache.store, table, key) {
    Miss -> { value: None, cache: cache },
    Bad(reason) -> { value: None, cache: warn_corrupt(cache, damage_message(what, reason)) },
    Hit(bytes) -> match bin::decode(bytes, codec) {
      Ok(v) -> { value: Some(v), cache: cache },
      Err(e) ->
        { value: None, cache: warn_corrupt(cache, damage_message(what, bin::error_to_string(e))) },
    },
  }

fn damage_message(what: String, reason: String) -> String =
  "a stored " ++ what ++ " is damaged (" ++ reason ++ "); it is treated as absent"

fn write<a>(
  cache: Cache,
  table: Int,
  key: Bytes,
  codec: bin::BinCodec<a>,
  value: a,
) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, table, key, bin::encode(value, codec)) }

/// A write of what is already there is no write, so a run that changed nothing flushes nothing.
fn write_if_changed<a, [r]>(
  cache: Cache,
  table: Int,
  key: Bytes,
  codec: bin::BinCodec<a>,
  value: a,
) -> Cache / {fs.read[r], abort.raise} =
  match get[r](cache.store, table, key) {
    Hit(old) -> if old == bin::encode(value, codec) { cache }
    else { write(cache, table, key, codec, value) },
    _ -> write(cache, table, key, codec, value),
  }

// --- What a passing run's definitions were -----------------------------------------
// A failure's changes are read against what its test last passed against: the era it passed in,
// that era's module records, and each definition's text by its hash.

/// The source text of the definition `hash` names, as it read when it was filed.
pub fn text<[r]>(cache: Cache, hash: Bytes) -> ReadResult<Bytes> / {fs.read[r], abort.raise} =
  read[r](cache, t_texts(), hash, bin::bytes_bin(), "definition text")

/// Files the text of the definition `hash` names, unless one is filed already. Two texts with one
/// hash differ only in what a hash leaves out, such as comments, so the first one stays.
pub fn put_text(cache: Cache, hash: Bytes, text: Bytes) -> Cache / {abort.raise} =
  if contains_key(cache.store, t_texts(), hash) { cache }
  else { write(cache, t_texts(), hash, bin::bytes_bin(), text) }

/// Whether a text is filed under `hash`, read from the index alone.
pub fn holds_text(cache: Cache, hash: Bytes) -> Bool / {abort.raise} =
  contains_key(cache.store, t_texts(), hash)

fn snapshot_domain() -> Bytes = b"ply.era.1"

/// What an era is filed under: a digest of its modules' record digests, in their order.
pub fn snapshot_digest(modules: List<Bytes>) -> Bytes =
  blake3(snapshot_domain().concat(Bytes::concat_all(modules)))

/// The digests of the module records the era `digest` names; one that is not what its digest names
/// is no era.
pub fn snapshot<[r]>(
  cache: Cache,
  digest: Bytes,
) -> ReadResult<List<Bytes>> / {fs.read[r], abort.raise} = {
  let got = read[r](cache, snapshots_table(), digest, bin::list_bin(bin::bytes_bin()), "era");
  match got.value {
    Some(modules) -> if snapshot_digest(modules) == digest { got } else {
      {
        value: None,
        cache: warn_corrupt(got.cache, damage_message("era", "it is not what its digest names")),
      }
    },
    None -> got,
  }
}

/// The era of `modules`, filed under its digest unless the store holds it.
pub fn put_snapshot(cache: Cache, modules: List<Bytes>) -> Cache / {abort.raise} = {
  let digest = snapshot_digest(modules);
  if contains_key(cache.store, snapshots_table(), digest) { cache }
  else { write(cache, snapshots_table(), digest, bin::list_bin(bin::bytes_bin()), modules) }
}

/// The module record filed under `digest`; one that is not what its digest names is no record.
pub fn module_record<[r]>(
  cache: Cache,
  digest: Bytes,
) -> ReadResult<ModuleRecord> / {fs.read[r], abort.raise} =
  match get[r](cache.store, modules_table(), digest) {
    Miss -> { value: None, cache: cache },
    Bad(reason) -> { value: None, cache: warn_corrupt(cache, damage_message("module record", reason)) },
    Hit(bytes) -> if record_digest(bytes) != digest {
      {
        value: None,
        cache: warn_corrupt(
          cache,
          damage_message("module record", "it is not what its digest names"),
        ),
      }
    } else {
      match bin::decode(bytes, module_record_bin()) {
        Ok(x) -> { value: Some(x), cache: cache },
        Err(e) ->
          {
            value: None,
            cache: warn_corrupt(cache, damage_message("module record", bin::error_to_string(e))),
          },
      }
    },
  }

/// Whether a module record is filed under `digest`, read from the index alone.
pub fn holds_module_record(cache: Cache, digest: Bytes) -> Bool / {abort.raise} =
  contains_key(cache.store, modules_table(), digest)

/// `record`, a module record's bytes, filed under its digest unless the store holds it.
pub fn put_module_record(cache: Cache, record: Bytes) -> Cache / {abort.raise} = {
  let digest = record_digest(record);
  if contains_key(cache.store, modules_table(), digest) { cache }
  else { { ..cache, store: put(cache.store, modules_table(), digest, record) } }
}

// --- Test results -----------------------------------------------------------

fn passed_in<[r]>(
  cache: Cache,
  table: Int,
  shared: Map<Bytes, Bool>,
  key: Bytes,
) -> ReadResult<Bool> / {fs.read[r], abort.raise} =
  match get[r](cache.store, table, key) {
    Hit(_) -> { value: Some(true), cache: cache },
    Miss -> { value: Some(shared.contains(key)), cache: cache },
    Bad(reason) ->
      {
        value: Some(shared.contains(key)),
        cache: warn_corrupt(cache, damage_message("result", reason)),
      },
  }

pub fn passed<[r]>(cache: Cache, key: Bytes) -> ReadResult<Bool> / {fs.read[r], abort.raise} =
  passed_in[r](cache, passed_table(), cache.shared, key)

/// The trace a pass filed under `key` here, or else in the upstream, stands on.
fn trace_in<[r], [u]>(
  cache: Cache,
  table: Int,
  upstream: Option<Upstream>,
  shared: Map<Bytes, Bool>,
  key: Bytes,
) -> ReadResult<Bytes> / {fs.read[r], fs.read[u], abort.raise} =
  match get[r](cache.store, table, key) {
    Hit(trace) -> { value: Some(trace), cache: cache },
    Bad(reason) -> { value: None, cache: warn_corrupt(cache, damage_message("result", reason)) },
    Miss -> match upstream {
      None -> { value: None, cache: cache },
      Some(upstream_store) -> if !shared.contains(key) { { value: None, cache: cache } } else {
        match read_entry[u](upstream_store, table, key) {
          Hit(trace) -> { value: Some(trace), cache: cache },
          Miss -> { value: None, cache: cache },
          Bad(reason) ->
            { value: None, cache: warn_corrupt(cache, damage_message("upstream result", reason)) },
        }
      },
    },
  }

pub fn pass_trace<[r], [u]>(
  cache: Cache,
  key: Bytes,
) -> ReadResult<Bytes> / {fs.read[r], fs.read[u], abort.raise} =
  trace_in[r, u](cache, passed_table(), cache.upstream, cache.shared, key)

/// A pass, with the trace of what its run read.
pub fn put_passed(cache: Cache, key: Bytes, trace: Bytes) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, passed_table(), key, trace) }

/// A pass filed under the code its test ran, here or in the upstream.
pub fn passed_code<[r]>(cache: Cache, key: Bytes) -> ReadResult<Bool> / {fs.read[r], abort.raise} =
  passed_in[r](cache, code_passes_table(), cache.code_shared, key)

pub fn code_pass_trace<[r], [u]>(
  cache: Cache,
  key: Bytes,
) -> ReadResult<Bytes> / {fs.read[r], fs.read[u], abort.raise} =
  trace_in[r, u](cache, code_passes_table(), cache.code_upstream, cache.code_shared, key)

pub fn put_passed_code(cache: Cache, key: Bytes, trace: Bytes) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, code_passes_table(), key, trace) }

pub fn pass_record<[r]>(
  cache: Cache,
  key: Bytes,
) -> ReadResult<PassRecord> / {fs.read[r], abort.raise} = {
  let got = read[r](
    cache,
    pass_records_table(),
    named_key(key),
    named_bin(pass_record_bin()),
    "pass record",
  );
  match got.value {
    Some(n) -> { value: if n.name == key { Some(n.value) } else { None }, cache: got.cache },
    None -> { value: None, cache: got.cache },
  }
}

pub fn put_pass_record<[r]>(
  cache: Cache,
  key: Bytes,
  record: PassRecord,
) -> Cache / {fs.read[r], abort.raise} =
  write_if_changed[r](cache, pass_records_table(), named_key(key), named_bin(pass_record_bin()), {
    name: key,
    value: record,
  })

/// Whether the store has seen the definition `hash` pass, read from the index alone.
pub fn knows_definition(cache: Cache, hash: Bytes) -> Bool / {abort.raise} =
  contains_key(cache.store, seen_table(), hash)

pub fn observe_definition(cache: Cache, hash: Bytes) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, seen_table(), hash, b"") }

// --- The prover -------------------------------------------------------------

pub fn evidence<[r]>(cache: Cache, key: Bytes) -> ReadResult<Bytes> / {fs.read[r], abort.raise} =
  read[r](cache, evidence_table(), key, bin::bytes_bin(), "evidence")

/// The local entry, or else the upstream's.
pub fn evidence_shared<[r], [u]>(
  cache: Cache,
  key: Bytes,
) -> ReadResult<Bytes> / {fs.read[r], fs.read[u], abort.raise} = {
  let local = evidence[r](cache, key);
  match local.value {
    Some(_) -> local,
    None -> match cache.upstream {
      None -> local,
      Some(upstream_store) -> match read_entry[u](upstream_store, evidence_table(), key) {
        Hit(payload) -> match bin::decode(payload, bin::bytes_bin()) {
          Ok(v) -> { value: Some(v), cache: local.cache },
          Err(e) ->
            {
              value: None,
              cache: warn_corrupt(
                local.cache,
                damage_message("upstream evidence", bin::error_to_string(e)),
              ),
            },
        },
        Miss -> local,
        Bad(reason) ->
          {
            value: None,
            cache: warn_corrupt(local.cache, damage_message("upstream evidence", reason)),
          },
      },
    },
  }
}

pub fn put_evidence(cache: Cache, key: Bytes, encoded: Bytes) -> Cache / {abort.raise} =
  write(cache, evidence_table(), key, bin::bytes_bin(), encoded)

pub fn review<[r]>(
  cache: Cache,
  definition: Bytes,
) -> ReadResult<Review> / {fs.read[r], abort.raise} = {
  let got = read[r](
    cache,
    reviews_table(),
    named_key(definition),
    named_bin(review_bin()),
    "review",
  );
  match got.value {
    Some(n) -> { value: if n.name == definition { Some(n.value) } else { None }, cache: got.cache },
    None -> { value: None, cache: got.cache },
  }
}

pub fn put_review(cache: Cache, definition: Bytes, r: Review) -> Cache / {abort.raise} =
  write(cache, reviews_table(), named_key(definition), named_bin(review_bin()), {
    name: definition,
    value: r,
  })

// --- Upkeep -----------------------------------------------------------------

pub type Counts = {
  texts: Int,
  passed: Int,
  pass_records: Int,
  eras: Int,
  modules: Int,
  seen: Int,
  evidence: Int,
  reviews: Int,
}

pub fn counts(cache: Cache) -> Counts / {abort.raise} =
  {
    texts: keys(cache.store, t_texts()).len(),
    passed: keys(cache.store, passed_table()).len(),
    pass_records: keys(cache.store, pass_records_table()).len(),
    eras: keys(cache.store, snapshots_table()).len(),
    modules: keys(cache.store, modules_table()).len(),
    seen: keys(cache.store, seen_table()).len(),
    evidence: keys(cache.store, evidence_table()).len(),
    reviews: keys(cache.store, reviews_table()).len(),
  }

/// How many definition texts, eras and module records a prune dropped.
pub type PruneCounts = { texts: Int, eras: Int, modules: Int }

/// The tests whose pass record names each era, each by where a walk of it starts, and the hash
/// each test passed at.
type PassesBySnapshot = {
  eras: Map<Bytes, List<{ key: Bytes, case: Bool }>>,
  tests: Map<Bytes, Bool>,
  cache: Cache,
}

/// What a prune keeps live: each module record a kept era names, each one decoded, and the hash of
/// each definition a test reached in the era it last passed in.
type Live = {
  modules: Map<Bytes, Bool>,
  records: Map<Bytes, ModuleRecord>,
  hashes: Map<Bytes, Bool>,
  cache: Cache,
}

/// Drops every era no pass record names, every module record no kept era names, and every text
/// that is neither of a test as it last passed nor of a definition it reached then: a failure reads
/// only what its test last passed against. Each era is walked once, from all the tests that last
/// passed in it.
pub fn prune<[r]>(
  cache: Cache,
) -> { pruned: PruneCounts, cache: Cache } / {fs.read[r], abort.raise} = {
  let passed = keys(cache.store, pass_records_table()).fold(
    { eras: Map::new(), tests: Map::new(), cache: cache },
    |acc: PassesBySnapshot, k: Bytes| {
      let got = read[r](
        acc.cache,
        pass_records_table(),
        k,
        named_bin(pass_record_bin()),
        "pass record",
      );
      match got.value {
        Some(n) -> {
          let snapshot = n.value.era;
          let tests = match acc.eras.get(snapshot) { Some(ts) -> ts, None -> [] };
          {
            eras: acc.eras.insert(snapshot, tests.push({ key: n.value.of, case: n.value.case })),
            tests: acc.tests.insert(n.value.test_hash, true),
            cache: got.cache,
          }
        },
        None -> { ..acc, cache: got.cache },
      }
    },
  );
  let live = passed.eras.fold(
    { modules: Map::new(), records: Map::new(), hashes: Map::new(), cache: passed.cache },
    |acc: Live, e: Bytes, tests: List<{ key: Bytes, case: Bool }>| {
      let got = snapshot[r](acc.cache, e);
      match got.value {
        None -> { ..acc, cache: got.cache },
        Some(ms) -> {
          let read = ms.fold({ ..acc, cache: got.cache }, |l: Live, d: Bytes|
            if l.records.contains(d) { { ..l, modules: l.modules.insert(d, true) } } else {
              let held = module_record[r](l.cache, d);
              {
                ..l,
                modules: l.modules.insert(d, true),
                records: match held.value { Some(x) -> l.records.insert(d, x), None -> l.records },
                cache: held.cache,
              }
            });
          let records = ms.fold([], |rs: List<ModuleRecord>, d: Bytes|
            match read.records.get(d) { Some(x) -> rs.push(x), None -> rs });
          {
            ..read,
            hashes: recorded_hashes(recorded_graph(records), tests).fold(
              read.hashes,
              |m: Map<Bytes, Bool>, h: Bytes| m.insert(h, true),
            ),
          }
        },
      }
    },
  );
  let swept = |c: Cache, t: Int, keep: (Bytes) -> Bool| {
    let dead = keys(c.store, t).filter(|k: Bytes| !keep(k));
    {
      cache: { ..c, store: dead.fold(c.store, |store: Store, k: Bytes| drop(store, t, k)) },
      gone: dead.len(),
    }
  };
  let gone_eras = swept(live.cache, snapshots_table(), |k: Bytes| passed.eras.contains(k));
  let gone_modules = swept(gone_eras.cache, modules_table(), |k: Bytes| live.modules.contains(k));
  let texts = swept(gone_modules.cache, t_texts(), |k: Bytes|
    live.hashes.contains(k) || passed.tests.contains(k));
  {
    pruned: { texts: texts.gone, eras: gone_eras.gone, modules: gone_modules.gone },
    cache: texts.cache,
  }
}

pub type Usage = { counts: Counts, segments: Int, data_bytes: Int, live_bytes: Int }

pub fn usage(cache: Cache) -> Usage / {abort.raise} = {
  let s = stats(cache.store);
  {
    counts: counts(cache),
    segments: cache.store.manifest.segments.len(),
    data_bytes: s.data_bytes,
    live_bytes: s.live_bytes,
  }
}

pub fn compact_cache<[r]>(cache: Cache) -> Cache / {fs.read[r], fs.write[r], abort.raise} =
  { ..cache, store: compact[r](cache.store) }

// --- Tests ------------------------------------------------------------------

fn test_stamps() -> Stamps = { runtime: "runtime", code: "code" }

/// A module record holding one definition of each of `names`, each under the hash its name keys,
/// and the test `m.t`, which references the first.
fn module_record_holding(names: List<String>) -> Bytes / {abort.raise} =
  bin::encode(
    {
      nodes: names.map(|n: String|
        { name: Bytes::of_string(n), declaration: false, hash: name_key(n), edges: [] }),
      tests: [
        {
          key: b"m.t",
          hash: name_key("t"),
          refs: names.take(1).map(|n: String| { name: Bytes::of_string(n), declaration: false }),
          runs: [],
        },
      ],
    },
    module_record_bin(),
  )

/// The pass record of a test that passed in the era of `modules`.
fn record_in(modules: List<Bytes>) -> PassRecord =
  { test_hash: name_key("t"), era: snapshot_digest(modules), of: b"m.t", case: false }

test "every table round-trips through a flush and a reopen" {
  let m = module_record_holding(["m.f"]);
  let run = run_in_memory(mem_empty(), || {
    let c1 = open_cache[mem]("cache", test_stamps());
    let c2 = put_text(c1, name_key("m.f"), b"fn f() -> Int = 1\n");
    let c3 = put_snapshot(put_module_record(c2, m), [record_digest(m)]);
    let c4 = put_pass_record(
      observe_definition(put_passed(c3, name_key("result"), b""), name_key("m.f")),
      b"m.t",
      record_in([record_digest(m)]),
    );
    let c5 = put_review(put_evidence(c4, name_key("claim"), b"evidence"), b"m.f", {
      definition: name_key("m.f"),
      specs: [name_key("s")],
    });
    let c = flush_cache[mem](c5);
    let r = open_cache[mem]("cache", test_stamps());
    assert_eq(text[mem](r, name_key("m.f")).value, Some(b"fn f() -> Int = 1\n"));
    assert_eq(text[mem](r, name_key("m.g")).value, None);
    assert(holds_text(r, name_key("m.f")) && !holds_text(r, name_key("m.g")));
    assert_eq(passed[mem](r, name_key("result")).value, Some(true));
    assert_eq(passed[mem](r, name_key("other")).value, Some(false));
    assert(knows_definition(r, name_key("m.f")) && !knows_definition(r, name_key("m.g")));
    assert_eq(pass_record[mem](r, b"m.t").value, Some(record_in([record_digest(m)])));
    assert_eq(
      snapshot[mem](r, snapshot_digest([record_digest(m)])).value,
      Some([record_digest(m)]),
    );
    assert_eq(
      module_record[mem](r, record_digest(m)).value,
      match bin::decode(m, module_record_bin()) { Ok(x) -> Some(x), Err(_) -> None },
    );
    assert(holds_module_record(r, record_digest(m)));
    assert_eq(evidence[mem](r, name_key("claim")).value, Some(b"evidence"));
    assert_eq(
      review[mem](r, b"m.f").value,
      Some({ definition: name_key("m.f"), specs: [name_key("s")] }),
    );
    assert_eq(counts(r).texts, 1);
    warnings(c)
  });
  assert_eq(run.value, [])
}

test "an era or a module record not under its own digest is not recorded or not read" {
  let m = module_record_holding(["m.f"]);
  let run = run_in_memory(mem_empty(), || {
    let c = put_snapshot(put_module_record(open_cache[mem]("cache", test_stamps()), m), [
      record_digest(m),
    ]);
    let refiled = put_snapshot(put_module_record(c, m), [record_digest(m)]);
    let elsewhere = { ..c, store: put(c.store, modules_table(), name_key("elsewhere"), m) };
    {
      // Filing what is held puts nothing.
      again: pending_count(refiled.store) == pending_count(c.store),
      read: module_record[mem](elsewhere, name_key("elsewhere")).value == None,
      warned: warnings(module_record[mem](elsewhere, name_key("elsewhere")).cache).len(),
    }
  });
  assert(run.value.again && run.value.read);
  assert_eq(run.value.warned, 1)
}

test "prune keeps what each test reached in the era it last passed in, and drops the rest" {
  let live = module_record_holding(["m.passed", "m.stale"]);
  let dead = module_record_holding(["m.orphan"]);
  let run = run_in_memory(mem_empty(), || {
    let c0 = open_cache[mem]("cache", test_stamps());
    let c1 = put_pass_record(
      put_snapshot(
        put_snapshot(put_module_record(put_module_record(c0, live), dead), [record_digest(dead)]),
        [record_digest(live)],
      ),
      b"m.t",
      record_in([record_digest(live)]),
    );
    let c2 = ["m.passed", "m.stale", "m.orphan", "t"].fold(c1, |cache: Cache, n: String|
      put_text(cache, name_key(n), b"v"));
    let p = prune[mem](flush_cache[mem](c2));
    let kept = flush_cache[mem](p.cache);
    let r = open_cache[mem]("cache", test_stamps());
    {
      pruned: p.pruned,
      texts: ["m.passed", "m.stale", "m.orphan", "t"].map(|n: String| holds_text(r, name_key(n))),
      modules: [live, dead].map(|m: Bytes| holds_module_record(r, record_digest(m))),
    }
  });
  // `m.stale` is in an era a test last passed in, and no test of that era reached it.
  assert_eq(run.value.pruned, { texts: 2, eras: 1, modules: 1 });
  // The test's own text stays with its pass record.
  assert_eq(run.value.texts, [true, false, false, true]);
  assert_eq(run.value.modules, [true, false])
}

test "the schema is a function of the stored shapes alone" {
  assert_eq(schema(), schema());
  assert_eq(schema().len(), 7 * 32)
}

test "two runs filing different entries both keep theirs" {
  let run = run_in_memory(mem_empty(), || {
    let a = put_text(open_cache[mem]("cache", test_stamps()), name_key("m.a"), b"A");
    let b = put_text(open_cache[mem]("cache", test_stamps()), name_key("m.b"), b"B");
    let a1 = flush_cache[mem](a);
    let b1 = flush_cache[mem](b);
    let r = open_cache[mem]("cache", test_stamps());
    [text[mem](r, name_key("m.a")).value, text[mem](r, name_key("m.b")).value]
  });
  assert_eq(run.value, [Some(b"A"), Some(b"B")])
}

test "a text recorded under a hash that already stores one writes nothing, and the first stays" {
  let run = run_in_memory(mem_empty(), || {
    let _c1 = flush_cache[mem](
      put_text(open_cache[mem]("cache", test_stamps()), name_key("m.f"), b"F"),
    );
    let again = put_text(
      open_cache[mem]("cache", test_stamps()),
      name_key("m.f"),
      b"F // a comment",
    );
    { pending: pending_count(again.store), kept: text[mem](again, name_key("m.f")).value }
  });
  assert_eq(run.value, { pending: 0, kept: Some(b"F") })
}

test "an upstream's passes and evidence serve as cached results here, and what this run learns is published there" {
  let run = run_in_memory(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", test_stamps()), "shared", true);
    let a1 = flush_shared[mem, mem](
      put_evidence(put_passed(a, name_key("pass"), b""), name_key("claim"), b"evidence"),
    );
    let b = with_upstream[mem](open_cache[mem]("two/cache", test_stamps()), "shared", true);
    let lonely = open_cache[mem]("three/cache", test_stamps());
    [
      passed[mem](b, name_key("pass")).value == Some(true),
      evidence_shared[mem, mem](b, name_key("claim")).value == Some(b"evidence"),
      passed[mem](lonely, name_key("pass")).value == Some(false),
      passed[mem](b, name_key("other")).value == Some(false),
      warnings(a1) == [],
    ]
  });
  assert_eq(run.value, [true, true, true, true, true])
}

test "a pass is read back with its trace, here or from the upstream, and recorded again on another" {
  let run = run_in_memory(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", test_stamps()), "shared", true);
    let _a1 = flush_shared[mem, mem](put_passed(a, name_key("pass"), b"read a"));
    let b = with_upstream[mem](open_cache[mem]("two/cache", test_stamps()), "shared", true);
    let first = pass_trace[mem, mem](b, name_key("pass")).value;
    let _b1 = flush_shared[mem, mem](put_passed(b, name_key("pass"), b"read b"));
    let c = with_upstream[mem](open_cache[mem]("three/cache", test_stamps()), "shared", true);
    [
      first,
      pass_trace[mem, mem](c, name_key("pass")).value,
      pass_trace[mem, mem](c, name_key("other")).value,
    ]
  });
  assert_eq(run.value, [Some(b"read a"), Some(b"read b"), None])
}

test "a pass recorded under the code its test ran outlives another runtime stamp, and goes with its own" {
  let run = run_in_memory(mem_empty(), || {
    let a = open_cache[mem]("cache", test_stamps());
    let _recorded = flush_cache[mem](
      put_passed_code(put_passed(a, name_key("result"), b""), name_key("code"), b""),
    );
    let moved = open_cache[mem]("cache", { ..test_stamps(), runtime: "another" });
    let recoded = open_cache[mem]("cache", {
      ..test_stamps(),
      runtime: "another",
      code: "another",
    });
    [
      passed[mem](moved, name_key("result")).value,
      passed_code[mem](moved, name_key("code")).value,
      passed_code[mem](recoded, name_key("code")).value,
    ]
  });
  assert_eq(run.value, [Some(false), Some(true), Some(false)])
}

test "a pass recorded under its code is shared under a schema of its own, which another runtime reads" {
  let run = run_in_memory(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", test_stamps()), "shared", true);
    let _published = flush_shared[mem, mem](
      put_passed_code(put_passed(a, name_key("pass"), b""), name_key("code"), b""),
    );
    let b = with_upstream[mem](
      open_cache[mem]("two/cache", { ..test_stamps(), runtime: "another" }),
      "shared",
      true,
    );
    [passed[mem](b, name_key("pass")).value, passed_code[mem](b, name_key("code")).value]
  });
  assert_eq(run.value, [Some(false), Some(true)])
}

test "a publishing run marks every schema it used live, and a read-only one marks none" {
  let lives = |publish: Bool|
    run_in_memory(mem_empty(), || {
      let a = with_upstream[mem](open_cache[mem]("one/cache", test_stamps()), "shared", publish);
      let _flushed = flush_shared[mem, mem](a);
      match listed_names(fs.list_dir[mem]("shared/v2")) {
        Some(dirs) -> dirs.filter(|d: String| fs.exists[mem]("shared/v2/" ++ d ++ "/live")).len(),
        None -> 0,
      }
    }).value;
  assert_eq(lives(true), 2);
  assert_eq(lives(false), 0)
}

test "a read-only upstream serves cached results and is not written" {
  let run = run_in_memory(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", test_stamps()), "shared", false);
    let a1 = flush_shared[mem, mem](put_passed(a, name_key("pass"), b""));
    let b = with_upstream[mem](open_cache[mem]("two/cache", test_stamps()), "shared", true);
    passed[mem](b, name_key("pass")).value
  });
  assert_eq(run.value, Some(false))
}

test "two runs publishing one pass race harmlessly, and an unwritable upstream is a warning" {
  let run = run_in_memory(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", test_stamps()), "shared", true);
    let b = with_upstream[mem](open_cache[mem]("two/cache", test_stamps()), "shared", true);
    let a1 = flush_shared[mem, mem](put_passed(a, name_key("pass"), b""));
    let b1 = flush_shared[mem, mem](put_passed(b, name_key("pass"), b""));
    let blocked = fs.write_file[mem]("blocked", b"a file where the upstream should be");
    let c = with_upstream[mem](open_cache[mem]("three/cache", test_stamps()), "blocked", true);
    let c1 = flush_shared[mem, mem](put_passed(c, name_key("mine"), b""));
    let again = open_cache[mem]("three/cache", test_stamps());
    {
      clean: warnings(a1) == [] && warnings(b1) == [],
      warned: messages(warnings(c1)),
      kept: passed[mem](again, name_key("mine")).value,
    }
  });
  assert(run.value.clean);
  assert_eq(run.value.warned, [
    "1 entry could not be published to the upstream store `blocked`; this run is unaffected",
  ]);
  assert_eq(run.value.kept, Some(true))
}

test "entries recorded under another build's stamp are dropped group by group, and said once" {
  let run = run_in_memory(mem_empty(), || {
    let c0 = put_passed_code(
      put_passed(open_cache[mem]("cache", test_stamps()), name_key("t"), b""),
      name_key("code"),
      b"",
    );
    let c1 = put_review(c0, b"m.f", { definition: name_key("m.f"), specs: [] });
    let written = flush_cache[mem](c1);
    let moved = { ..test_stamps(), runtime: "elsewhere" };
    let r = open_cache[mem]("cache", moved);
    let warned = messages(r.store.warnings);
    let refiled = flush_cache[mem](open_cache[mem]("cache", moved));
    {
      warned: warned,
      passed: passed[mem](r, name_key("t")).value,
      code: passed_code[mem](r, name_key("code")).value,
      review: review[mem](r, b"m.f").value != None,
      later: messages(open_cache[mem]("cache", moved).store.warnings),
    }
  });
  assert_eq(run.value.warned, [
    "the test results and discharged obligations were filed by another build (runtime; this one is elsewhere), so they are filed again",
  ]);
  assert_eq(run.value.passed, Some(false));
  assert_eq(run.value.code, Some(true));
  assert(run.value.review);
  assert_eq(run.value.later, [])
}

test "a pass or a claim's evidence recorded by another runtime is not believed" {
  let run = run_in_memory(mem_empty(), || {
    let c0 = put_evidence(
      put_passed(open_cache[mem]("cache", test_stamps()), name_key("t"), b""),
      name_key("claim"),
      b"evidence",
    );
    let written = flush_cache[mem](c0);
    let r = open_cache[mem]("cache", { ..test_stamps(), runtime: "another runtime" });
    {
      warned: messages(r.store.warnings).len(),
      passed: passed[mem](r, name_key("t")).value,
      evidence: evidence[mem](r, name_key("claim")).value,
    }
  });
  assert_eq(run.value.warned, 1);
  assert_eq(run.value.passed, Some(false));
  assert_eq(run.value.evidence, None)
}

test "an upstream serves cached results only to the runtime that published to it" {
  let run = run_in_memory(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", test_stamps()), "shared", true);
    let published = flush_shared[mem, mem](put_passed(a, name_key("pass"), b""));
    let same = with_upstream[mem](open_cache[mem]("two/cache", test_stamps()), "shared", true);
    let other = with_upstream[mem](
      open_cache[mem]("three/cache", { ..test_stamps(), runtime: "another runtime" }),
      "shared",
      true,
    );
    [passed[mem](same, name_key("pass")).value, passed[mem](other, name_key("pass")).value]
  });
  assert_eq(run.value, [Some(true), Some(false)])
}
