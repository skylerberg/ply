//! The engine: tables of payloads keyed by 32 bytes, stored as a manifest and a handful of segments
//! (`compiler.store.segments`). A flush writes what a run put and dropped as one segment, which the
//! manifest names under the store's lock and syncs, so a reader sees a flush whole or not at all,
//! two runs flushing one store keep each other's entries, and what a flush wrote outlives a loss of
//! power. It knows a table by its number and a key as 32 bytes, never what a payload means.

import std.fs (fs, listed_names, mem_empty)
import std.bytes (u32_le, u64_le)
import std.list
import std.path (join)
import compiler.store.segments
import compiler.store.segments (Manifest, Segment, SegmentWriter, Committed, LockHeld)
import fake (run_in_memory)

// --- Layout -----------------------------------------------------------------

/// Moves whenever the bytes on disk change meaning; a store in another format reads as empty.
pub fn format_version() -> Int = 2

pub fn key_width() -> Int = 32

/// A table's number, then a key.
fn slot_width() -> Int = 1 + key_width()

/// A slot, whether its entry was dropped, where the entry's frame lies and how long its payload is.
fn row_width() -> Int = slot_width() + 13

fn rows_table() -> Int = 1

/// The files of a layout no `ply` reads, which the next flush removes.
fn retired_files() -> List<String> =
  ["store.dat", "store.idx", "store.lock", "store.dat.tmp", "store.idx.tmp"]

fn slot(table: Int, key: Bytes) -> Bytes / {abort.raise} = byte_of_int(table) ++ key

fn row_value(is_deleted: Bool, offset: Int, size: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([byte_of_int(if is_deleted { 1 } else { 0 }), u64_le(offset), u32_le(size)])

fn is_deleted(row: Bytes) -> Bool / {abort.raise} = row.at(slot_width()) == 1

fn offset_of(row: Bytes) -> Int = segments::read_u64(row, slot_width() + 1)

fn size_of(row: Bytes) -> Int = segments::read_u32(row, slot_width() + 9)

fn row_at(rows: Bytes, i: Int) -> Bytes / {abort.raise} =
  rows.slice(i * row_width(), (i + 1) * row_width())

// --- The store --------------------------------------------------------------

/// What one run holds: the manifest it read, each segment's rows, oldest first, the segments whose
/// rows did not read, and what it put and dropped since, which a read sees first. `schema` names
/// the stored types and this format, and the manifest by them.
pub type Store = {
  dir: String,
  schema: Bytes,
  manifest: Manifest,
  rows: List<Bytes>,
  unreadable_segments: List<Bytes>,
  puts: Map<Bytes, Bytes>,
  deleted: Map<Bytes, Bool>,
  warnings: List<Warning>,
}

/// What a warning reports: the store could not be read or written, held something that did not
/// verify, or was written in another format or for other stored types.
pub type WarningKind = | Unreadable | Corrupt | OtherVersion

pub type Warning = { kind: WarningKind, message: String }

pub type Lookup = | Hit(Bytes) | Miss | Bad(String)

/// One warning per distinct reason, however often a run meets it.
pub fn warn(store: Store, trouble: WarningKind, message: String) -> Store =
  { ..store, warnings: add_warning(store.warnings, { kind: trouble, message: message }) }

fn add_warning(ws: List<Warning>, w: Warning) -> List<Warning> =
  if ws.fold(false, |seen: Bool, x: Warning| seen || x == w) { ws } else { ws.push(w) }

pub fn messages(ws: List<Warning>) -> List<String> = ws.map(|w: Warning| w.message)

type SegmentRows = { rows: List<Bytes>, unreadable_segments: List<Bytes> }

/// Each segment's rows of `m`, taken from `cached_rows` where a run read them already: a segment whose
/// rows do not read holds nothing a run can find, and is named among the lost.
fn read_rows<[r]>(
  dir: String,
  m: Manifest,
  cached_rows: Map<Bytes, Bytes>,
) -> SegmentRows / {fs.read[r], abort.raise} =
  m.segments.fold({ rows: [], unreadable_segments: [] }, |acc: SegmentRows, seg: Segment|
    match cached_rows.get(seg.token) {
      Some(b) -> { rows: acc.rows.push(b), unreadable_segments: acc.unreadable_segments },
      None -> match segments::table_rows[r](dir, seg, rows_table()) {
        Some(b) -> { rows: acc.rows.push(b), unreadable_segments: acc.unreadable_segments },
        None ->
          {
            rows: acc.rows.push(b""),
            unreadable_segments: acc.unreadable_segments.push(seg.token),
          },
      },
    })

fn warn_lost_segments(store: Store) -> Store =
  if store.unreadable_segments.len() == 0 { store } else {
    warn(store, Corrupt, "a part of the store does not read; its entries are treated as absent")
  }

/// `schema` names every stored type's encoding; a store written under another is read as empty.
pub fn open<[r]>(dir: String, schema: Bytes) -> Store / {fs.read[r], abort.raise} = {
  let shapes = Bytes::blake3(u32_le(format_version()) ++ schema);
  let m = segments::manifest[r](dir, shapes);
  let read = read_rows[r](dir, m, Map::new());
  let store = warn_lost_segments({
    dir: dir,
    schema: shapes,
    manifest: m,
    rows: read.rows,
    unreadable_segments: read.unreadable_segments,
    puts: Map::new(),
    deleted: Map::new(),
    warnings: [],
  });
  if m.generation > 0 { store } else if segments::unreadable[r](dir, shapes) {
    warn(
      store,
      Corrupt,
      "the store is unreadable (its manifest does not read); this run starts empty",
    )
  } else if segments::has_other_manifests[r](dir, shapes) || fs.exists[r](join(dir, "store.idx")) {
    warn(store, OtherVersion, "the store was written by another version; this run starts empty")
  } else { store }
}

// --- Reading ----------------------------------------------------------------

type SegmentRow = { token: Bytes, row: Bytes }

/// The newest row of `sl` and the segment that holds it.
fn find_row(store: Store, sl: Bytes) -> Option<SegmentRow> / {abort.raise} =
  range(0, store.rows.len()).fold(None, |acc: Option<SegmentRow>, back: Int|
    match acc {
      Some(_) -> acc,
      None -> {
        let i = store.rows.len() - 1 - back;
        match segments::row_of(store.rows.get(i), row_width(), sl) {
          Some(row) -> Some({ token: store.manifest.segments.get(i).token, row: row }),
          None -> None,
        }
      },
    })

pub fn get<[r]>(store: Store, table: Int, key: Bytes) -> Lookup / {fs.read[r], abort.raise} =
  if key.len() != key_width() { Miss } else {
    let sl = slot(table, key);
    let unwritten = store.puts.len() == 0 && store.deleted.len() == 0;
    match if unwritten { None } else { store.puts.get(sl) } {
      Some(payload) -> Hit(payload),
      None -> if !unwritten && store.deleted.contains(sl) { Miss } else {
        match find_row(store, sl) {
          None -> Miss,
          // An entry that holds nothing is all in its row, which its table's checksum vouched for.
          Some(p) -> if is_deleted(p.row) { Miss }
          else if size_of(p.row) == 0 { Hit(b"") } else {
            match segments::payload[r](store.dir, p.token, offset_of(p.row), size_of(p.row)) {
              Some(payload) -> Hit(payload),
              None -> Bad("a frame does not match its checksum"),
            }
          },
        }
      },
    }
  }

/// Whether `table` holds `key`, read from the index alone: no payload is read or checked.
pub fn contains_key(store: Store, table: Int, key: Bytes) -> Bool / {abort.raise} =
  if key.len() != key_width() { false } else {
    let sl = slot(table, key);
    if store.puts.contains(sl) { true }
    else if store.deleted.contains(sl) { false }
    else { match find_row(store, sl) { Some(p) -> !is_deleted(p.row), None -> false } }
  }

/// The rows of `table` among `rows`, in order: a table's rows lie together, since a row leads with
/// its table.
fn table_rows(rows: Bytes, table: Int) -> List<Bytes> / {abort.raise} =
  iterate(
    {
      i: segments::lower_bound(rows, row_width(), byte_of_int(table).concat(b"\x00\x00\x00")),
      out: [],
    },
    1000000000,
    |x: { i: Int, out: List<Bytes> }|
      if (x.i + 1) * row_width() <= rows.len() && rows.at(x.i * row_width()) == table {
        Continue({ i: x.i + 1, out: x.out.push(row_at(rows, x.i)) })
      } else { Stop(x.out) },
  )

/// Every key the table holds, ascending, what this run put and dropped included.
pub fn keys(store: Store, table: Int) -> List<Bytes> / {abort.raise} = {
  let contains_key = store.rows.fold(Map::new(), |acc: Map<Bytes, Bool>, rows: Bytes|
    table_rows(rows, table).fold(acc, |m: Map<Bytes, Bool>, row: Bytes| {
      let key = row.slice(1, slot_width());
      if is_deleted(row) || store.deleted.contains(slot(table, key)) { m.remove(key) }
      else { m.insert(key, true) }
    }));
  store.puts.fold(contains_key, |acc: Map<Bytes, Bool>, sl: Bytes, _: Bytes|
    if sl.at(0) == table { acc.insert(sl.slice(1, sl.len()), true) } else { acc }).keys(
  )
}

/// The newest row of each slot among the segments from the one at `from` on, and the segment that
/// holds it.
fn newest_rows(store: Store, from: Int) -> Map<Bytes, SegmentRow> / {abort.raise} =
  range(from, store.rows.len()).fold(Map::new(), |acc: Map<Bytes, SegmentRow>, i: Int| {
    let token = store.manifest.segments.get(i).token;
    let rows = store.rows.get(i);
    range(0, rows.len() / row_width()).fold(acc, |m: Map<Bytes, SegmentRow>, j: Int| {
      let row = row_at(rows, j);
      m.insert(row.slice(0, slot_width()), { token: token, row: row })
    })
  })

pub type Stats = { entries: List<{ table: Int, count: Int }>, data_bytes: Int, live_bytes: Int }

type Live = { counts: Map<Int, Int>, frames: Int, rows: Int }

/// What the segments hold, and what one segment of the live entries alone would take, so
/// `data_bytes - live_bytes` is what compaction reclaims.
pub fn stats(store: Store) -> Stats / {abort.raise} = {
  let live = newest_rows(store, 0).fold(
    { counts: Map::new(), frames: 0, rows: 0 },
    |acc: Live, sl: Bytes, p: SegmentRow|
      if is_deleted(p.row) { acc } else {
        let table = sl.at(0);
        {
          counts: acc.counts.insert(
            table,
            1 + (match acc.counts.get(table) { Some(n) -> n, None -> 0 }),
          ),
          frames: acc.frames + segments::framed_len(size_of(p.row)),
          rows: acc.rows + 1,
        }
      },
  );
  {
    entries: live.counts.fold([], |acc: List<{ table: Int, count: Int }>, t: Int, n: Int|
      acc.push({ table: t, count: n })),
    data_bytes: store.manifest.segments.fold(0, |n: Int, seg: Segment| n + seg.size),
    live_bytes: if store.manifest.segments.len() == 0 { 0 }
    else { segments::header_len() + live.frames + live.rows * row_width() },
  }
}

// --- Writing ----------------------------------------------------------------

fn checked_slot(table: Int, key: Bytes) -> Bytes / {abort.raise} =
  if table < 0 || table > 255 { panic("a store table is numbered 0 to 255") }
  else if key.len() != key_width() { panic("a store key is 32 bytes") }
  else { slot(table, key) }

/// Stored by the next `flush`; until then this store's reads see it.
pub fn put(store: Store, table: Int, key: Bytes, payload: Bytes) -> Store / {abort.raise} = {
  let sl = checked_slot(table, key);
  { ..store, puts: store.puts.insert(sl, payload), deleted: store.deleted.remove(sl) }
}

pub fn drop(store: Store, table: Int, key: Bytes) -> Store / {abort.raise} = {
  let sl = checked_slot(table, key);
  { ..store, puts: store.puts.remove(sl), deleted: store.deleted.insert(sl, true) }
}

pub fn pending_count(store: Store) -> Int = store.puts.len() + store.deleted.len()

fn warn_not_flushed(store: Store, reason: String) -> Store =
  warn(store, Unreadable, reason ++ "; this run's entries were not kept")

/// `store` as the manifest `m` names it, with nothing waiting to be written.
fn with_manifest<[r]>(store: Store, m: Manifest) -> Store / {fs.read[r], abort.raise} = {
  let cached_rows = range(0, store.rows.len()).fold(Map::new(), |acc: Map<Bytes, Bytes>, i: Int| {
    let token = store.manifest.segments.get(i).token;
    if store.unreadable_segments.fold(false, |any: Bool, t: Bytes| any || t == token) { acc }
    else { acc.insert(token, store.rows.get(i)) }
  });
  let read = read_rows[r](store.dir, m, cached_rows);
  warn_lost_segments({
    ..store,
    manifest: m,
    rows: read.rows,
    unreadable_segments: read.unreadable_segments,
    puts: Map::new(),
    deleted: Map::new(),
  })
}

type PendingSegment = { writing: SegmentWriter, rows: Map<Bytes, Bytes>, lost: Int }

fn append_entry<[r]>(
  store: Store,
  token: Bytes,
  acc: PendingSegment,
  sl: Bytes,
  payload: Bytes,
) -> PendingSegment / {fs.write[r], abort.raise} = {
  let f = segments::append_payload(acc.writing, payload);
  {
    writing: segments::flush_when_full[r](store.dir, store.schema, token, f.writing),
    rows: acc.rows.insert(sl, row_value(false, f.at, payload.len())),
    lost: acc.lost,
  }
}

fn finish_segment<[r]>(
  store: Store,
  token: Bytes,
  segment: PendingSegment,
) -> Option<Segment> / {fs.write[r], abort.raise} =
  segments::finish[r](store.dir, store.schema, token, segment.writing, [
    segments::table(rows_table(), segment.rows, |_: Bytes, rest: Bytes| Some(rest)),
  ])

fn remove_segment<[r]>(store: Store, token: Bytes) -> Unit / {fs.write[r], abort.raise} = {
  fs.remove[r](segments::segment_path(store.dir, token));
  ()
}

/// What a run put and dropped written as one segment, which the store's manifest then names: read
/// again under the lock, so two runs flushing one store keep each other's entries, and the later
/// wins a key both wrote.
pub fn flush<[r]>(store: Store) -> Store / {fs.read[r], fs.write[r], abort.raise} =
  if pending_count(store) == 0 { store } else {
    match segments::start_run[r](store.dir) {
      None -> warn_not_flushed(store, "the store's directory could not be made"),
      Some(run) -> {
        let done = write_segment[r](store, run);
        segments::end_run[r](Some(run));
        done
      },
    }
  }

fn write_segment<[r]>(store: Store, run: String) -> Store / {fs.read[r], fs.write[r], abort.raise} = {
  let token = segments::segment_token(Some(run), store.manifest.generation, 0);
  let framed = store.puts.fold(
    { writing: segments::new_writer(), rows: Map::new(), lost: 0 },
    |acc: PendingSegment, sl: Bytes, payload: Bytes|
      append_entry[r](store, token, acc, sl, payload),
  );
  let segment = {
    ..framed,
    rows: store.deleted.fold(framed.rows, |acc: Map<Bytes, Bytes>, sl: Bytes, _: Bool|
      acc.insert(sl, row_value(true, 0, 0))),
  };
  match finish_segment[r](store, token, segment) {
    None -> warn_not_flushed(store, "the store's data could not be written"),
    Some(seg) -> match segments::commit[r](
        store.dir,
        store.schema,
        seg,
        store.unreadable_segments,
        true,
      ) {
      Committed(m) -> clean_up[r](with_manifest[r](store, m), run),
      LockHeld -> {
        remove_segment[r](store, token);
        warn_not_flushed(store, "another run holds the store's lock")
      },
      _ -> {
        remove_segment[r](store, token);
        warn_not_flushed(store, "the store's manifest could not be written")
      },
    },
  }
}

fn mostly_dead(st: Stats) -> Bool = (st.data_bytes - st.live_bytes) * 2 > st.data_bytes

/// `store` after a flush: what no manifest names removed, then its newest segments written again
/// as one where they are due, and all of them where most of what they hold is replaced or dropped.
/// The segments that rewrite replaces stay until the next flush, since the store is read without a
/// run's directory: a run that opened it before this flush still reads what it was shown.
fn clean_up<[r]>(store: Store, run: String) -> Store / {fs.read[r], fs.write[r], abort.raise} = {
  segments::sweep[r](store.dir, store.schema, run, []);
  retired_files().fold((), |_: Unit, name: String| {
    fs.remove[r](join(store.dir, name));
    ()
  });
  let from = if mostly_dead(stats(store)) { 0 } else { segments::merge_start(store.manifest) };
  if from < store.manifest.segments.len() - 1 { rewrite_segments[r](store, from, run, 1) }
  else { store }
}

/// The segments of `store` from the one at `from` on written again as one: of each slot its newest
/// row and that row's payload. A dropped slot keeps its row while an older segment may still hold
/// the entry.
fn rewrite_segments<[r]>(
  store: Store,
  from: Int,
  run: String,
  nth: Int,
) -> Store / {fs.read[r], fs.write[r], abort.raise} = {
  let token = segments::segment_token(Some(run), store.manifest.generation, nth);
  let segment = newest_rows(store, from).fold(
    { writing: segments::new_writer(), rows: Map::new(), lost: 0 },
    |acc: PendingSegment, sl: Bytes, p: SegmentRow|
      if is_deleted(p.row) {
        if from == 0 { acc } else { { ..acc, rows: acc.rows.insert(sl, row_value(true, 0, 0)) } }
      } else {
        match segments::payload[r](store.dir, p.token, offset_of(p.row), size_of(p.row)) {
          Some(payload) -> append_entry[r](store, token, acc, sl, payload),
          None -> { ..acc, lost: acc.lost + 1 },
        }
      },
  );
  let s1 = if segment.lost == 0 { store }
  else { warn(store, Corrupt, "compaction dropped entries whose stored data could not be read or was corrupt") };
  match finish_segment[r](s1, token, segment) {
    None -> warn(s1, Unreadable, "the store could not be compacted"),
    Some(seg) -> match segments::replace_merged[r](
        s1.dir,
        s1.schema,
        s1.manifest,
        from,
        seg,
        true,
      ) {
      Committed(m) -> with_manifest[r](s1, m),
      LockHeld -> {
        remove_segment[r](s1, token);
        warn(s1, Unreadable, "another run holds the store's lock; it was not compacted")
      },
      _ -> {
        remove_segment[r](s1, token);
        s1
      },
    },
  }
}

// --- Compaction -------------------------------------------------------------

/// The live entries written again as one segment, so what replaced or dropped entries left is gone
/// at once: a run that opened the store before reads its entries as absent from then on.
pub fn compact<[r]>(s0: Store) -> Store / {fs.read[r], fs.write[r], abort.raise} = {
  let s = flush[r](s0);
  let st = stats(s);
  if pending_count(s) > 0 || (s.manifest.segments.len() < 2 && st.data_bytes == st.live_bytes) { s }
  else {
    match segments::start_run[r](s.dir) {
      None -> warn(s, Unreadable, "the store could not be compacted"),
      Some(run) -> {
        let done = rewrite_segments[r](s, 0, run, 0);
        segments::sweep[r](done.dir, done.schema, run, []);
        segments::end_run[r](Some(run));
        done
      },
    }
  }
}

/// Everything a store holds in `dir` removed, whatever format wrote it: whether all of it went.
pub fn clear_dir<[r]>(dir: String) -> Bool / {fs.read[r], fs.write[r]} =
  match listed_names(fs.list_dir[r](dir)) {
    None -> true,
    Some(names) ->
      names.fold(true, |ok: Bool, name: String|
        if name.starts_with("manifest-") || name.starts_with("seg-")
            || retired_files().fold(false, |any: Bool, old: String| any || old == name) {
          fs.remove[r](join(dir, name)) && ok
        } else { ok }),
  }

/// How many bytes the store's files in `dir` take, those no manifest names any more among them.
pub fn disk_usage<[r]>(dir: String) -> Int / {fs.read[r]} =
  List::fold(
    match listed_names(fs.list_dir[r](dir)) { Some(names) -> names, None -> [] },
    0,
    |n: Int, name: String|
      if name.starts_with("manifest-") || name.starts_with("seg-") {
        n + (match fs.file_size[r](join(dir, name)) { Some(size) -> size, None -> 0 })
      } else { n },
  )

pub fn name_key(name: String) -> Bytes = Bytes::of_string(name).blake3()

// --- Tests ------------------------------------------------------------------

fn schema_a() -> Bytes = b"schema a"

fn lookup_payload(f: Lookup) -> Bytes =
  match f { Hit(b) -> b, Miss -> b"<miss>", Bad(reason) -> Bytes::of_string(reason) }

fn all_messages(xs: List<List<Warning>>) -> List<String> =
  xs.fold([], |acc: List<String>, x: List<Warning>|
    x.fold(acc, |a: List<String>, w: Warning| a.push(w.message)))

fn is_miss(f: Lookup) -> Bool = match f { Miss -> true, _ -> false }

/// The segments that hold the store in `cache`, by name.
fn segment_files() -> List<String> / {fs.read[mem]} =
  List::filter(
    match listed_names(fs.list_dir[mem]("cache")) { Some(names) -> names, None -> [] },
    |name: String| name.starts_with("seg-"),
  )

test "entries put in a store can be read immediately, and again after the store is flushed and reopened" {
  let run = run_in_memory(mem_empty(), || {
    let s0 = open[mem]("cache", schema_a());
    assert_eq(s0.warnings, []);
    let s1 = put(
      put(put(s0, 1, name_key("a"), b"alpha"), 2, name_key("a"), b"other table"),
      1,
      name_key("b"),
      b"beta",
    );
    assert_eq(lookup_payload(get[mem](s1, 1, name_key("a"))), b"alpha");
    let s2 = flush[mem](s1);
    assert_eq(s2.warnings, []);
    assert_eq(pending_count(s2), 0);
    assert_eq(lookup_payload(get[mem](s2, 1, name_key("b"))), b"beta");
    let s3 = open[mem]("cache", schema_a());
    assert_eq(lookup_payload(get[mem](s3, 1, name_key("a"))), b"alpha");
    assert_eq(lookup_payload(get[mem](s3, 1, name_key("b"))), b"beta");
    assert_eq(lookup_payload(get[mem](s3, 2, name_key("a"))), b"other table");
    assert(is_miss(get[mem](s3, 1, name_key("c"))));
    assert_eq(keys(s3, 1).len(), 2);
    assert_eq(stats(s3).entries.map(|e: { table: Int, count: Int }| e.count), [2, 1]);
    messages(s3.warnings)
  });
  assert_eq(run.value, [])
}

test "a deleted entry stays deleted and a replaced entry keeps its new value after a flush and a reopen" {
  let run = run_in_memory(mem_empty(), || {
    let s1 = flush[mem](
      put(put(open[mem]("cache", schema_a()), 1, name_key("a"), b"one"), 1, name_key("b"), b"two"),
    );
    let s2 = flush[mem](put(drop(s1, 1, name_key("a")), 1, name_key("b"), b"three"));
    assert(is_miss(get[mem](s2, 1, name_key("a"))));
    let s3 = open[mem]("cache", schema_a());
    assert(is_miss(get[mem](s3, 1, name_key("a"))));
    assert_eq(lookup_payload(get[mem](s3, 1, name_key("b"))), b"three");
    assert_eq(keys(s3, 1), [name_key("b")]);
    messages(s3.warnings)
  });
  assert_eq(run.value, [])
}

test "two runs flushing one store keep each other's entries, and the later wins a shared key" {
  let run = run_in_memory(mem_empty(), || {
    let a = put(
      put(open[mem]("cache", schema_a()), 1, name_key("mine"), b"a"),
      1,
      name_key("both"),
      b"from a",
    );
    let b = put(
      put(open[mem]("cache", schema_a()), 1, name_key("theirs"), b"b"),
      1,
      name_key("both"),
      b"from b",
    );
    let a1 = flush[mem](a);
    let b1 = flush[mem](b);
    // The later flush reads the manifest again, so it holds what the earlier one wrote.
    assert_eq(lookup_payload(get[mem](b1, 1, name_key("mine"))), b"a");
    let c = open[mem]("cache", schema_a());
    assert_eq(lookup_payload(get[mem](c, 1, name_key("mine"))), b"a");
    assert_eq(lookup_payload(get[mem](c, 1, name_key("theirs"))), b"b");
    assert_eq(lookup_payload(get[mem](c, 1, name_key("both"))), b"from b");
    assert_eq(keys(c, 1), keys(b1, 1));
    all_messages([a1.warnings, b1.warnings, c.warnings])
  });
  assert_eq(run.value, [])
}

test "an entry deleted by one run stays deleted when another run flushed its own entries first" {
  let run = run_in_memory(mem_empty(), || {
    let s0 = flush[mem](put(open[mem]("cache", schema_a()), 1, name_key("first"), b"0"));
    let a = put(open[mem]("cache", schema_a()), 1, name_key("mine"), b"a");
    let b = drop(open[mem]("cache", schema_a()), 1, name_key("first"));
    let a1 = flush[mem](a);
    let b1 = flush[mem](b);
    let c = open[mem]("cache", schema_a());
    assert(is_miss(get[mem](c, 1, name_key("first"))));
    assert_eq(lookup_payload(get[mem](c, 1, name_key("mine"))), b"a");
    assert_eq(keys(c, 1), [name_key("mine")]);
    all_messages([s0.warnings, a1.warnings, b1.warnings, c.warnings])
  });
  assert_eq(run.value, [])
}

test "a segment file that no manifest lists is ignored when the store opens, and the next flush deletes it" {
  let run = run_in_memory(mem_empty(), || {
    let s1 = flush[mem](put(open[mem]("cache", schema_a()), 1, name_key("a"), b"kept"));
    assert(fs.write_file[mem]("cache/seg-00000000000000ff", b"left by a run that died"));
    let s2 = open[mem]("cache", schema_a());
    assert_eq(s2.warnings, []);
    assert_eq(lookup_payload(get[mem](s2, 1, name_key("a"))), b"kept");
    let s3 = flush[mem](put(s2, 1, name_key("b"), b"after"));
    assert(!fs.exists[mem]("cache/seg-00000000000000ff"));
    let s4 = open[mem]("cache", schema_a());
    assert_eq(lookup_payload(get[mem](s4, 1, name_key("a"))), b"kept");
    assert_eq(lookup_payload(get[mem](s4, 1, name_key("b"))), b"after");
    all_messages([s1.warnings, s3.warnings, s4.warnings])
  });
  assert_eq(run.value, [])
}

test "a segment frame that fails its checksum makes the lookup fail with the reason, not return a partly read value" {
  let run = run_in_memory(mem_empty(), || {
    let s1 = flush[mem](put(open[mem]("cache", schema_a()), 1, name_key("a"), b"payload"));
    let file = "cache/" ++ segment_files().get(0);
    let data = match fs.read_file[mem](file) { Some(b) -> b, None -> b"" };
    let frame = segments::header_len();
    let broken = Bytes::concat_all([
      data.slice(0, frame + 12),
      b"X",
      data.slice(frame + 13, data.len()),
    ]);
    assert(fs.write_file[mem](file, broken));
    get[mem](open[mem]("cache", schema_a()), 1, name_key("a"))
  });
  assert_eq(run.value, Bad("a frame does not match its checksum"))
}

test "opening a store written under another schema gives an empty store and a warning, and does not delete the other schema's entries" {
  let run = run_in_memory(mem_empty(), || {
    let s1 = flush[mem](put(open[mem]("cache", schema_a()), 1, name_key("a"), b"x"));
    let other = open[mem]("cache", b"schema b");
    assert(is_miss(get[mem](other, 1, name_key("a"))));
    assert_eq(pending_count(flush[mem](put(other, 1, name_key("b"), b"y"))), 0);
    assert_eq(messages(open[mem]("cache", b"schema b").warnings), []);
    assert_eq(lookup_payload(get[mem](open[mem]("cache", schema_a()), 1, name_key("a"))), b"x");
    all_messages([s1.warnings, other.warnings])
  });
  assert_eq(run.value, ["the store was written by another version; this run starts empty"])
}

test "a store with a segment file missing warns, still reads the other segments, and a later flush removes the missing segment from the manifest" {
  let run = run_in_memory(mem_empty(), || {
    // Long enough that the short segment after it is not written again with it as one.
    let long = Bytes::concat_all(range(0, 64).map(|i: Int| b"0123456789abcdef"));
    let s1 = flush[mem](
      put(put(open[mem]("cache", schema_a()), 1, name_key("a"), long), 1, name_key("b"), long),
    );
    let first = segment_files().get(0);
    let s2 = flush[mem](put(s1, 1, name_key("c"), b"x"));
    assert_eq(s2.manifest.segments.len(), 2);
    assert(fs.remove[mem]("cache/" ++ first));
    let gone = open[mem]("cache", schema_a());
    assert(is_miss(get[mem](gone, 1, name_key("a"))));
    assert_eq(lookup_payload(get[mem](gone, 1, name_key("c"))), b"x");
    let again = flush[mem](put(gone, 1, name_key("d"), b"y"));
    assert_eq(pending_count(again), 0);
    let back = open[mem]("cache", schema_a());
    assert_eq(lookup_payload(get[mem](back, 1, name_key("d"))), b"y");
    assert_eq(lookup_payload(get[mem](back, 1, name_key("c"))), b"x");
    all_messages([s2.warnings, gone.warnings, back.warnings])
  });
  assert_eq(run.value, ["a part of the store does not read; its entries are treated as absent"])
}

test "a run that cannot take the lock writes nothing and says so" {
  let run = run_in_memory(mem_empty(), || {
    assert(fs.create_dir[mem]("cache"));
    assert(fs.lock[mem]("cache/lock"));
    let s = flush[mem](put(open[mem]("cache", schema_a()), 1, name_key("a"), b"x"));
    assert_eq(pending_count(s), 1);
    assert(is_miss(get[mem](open[mem]("cache", schema_a()), 1, name_key("a"))));
    assert_eq(segment_files(), []);
    messages(s.warnings)
  });
  assert_eq(run.value, ["another run holds the store's lock; this run's entries were not kept"])
}

test "compaction rewrites the live entries into one segment and deletes the space the other entries used" {
  let run = run_in_memory(mem_empty(), || {
    let long = Bytes::concat_all(range(0, 64).map(|i: Int| b"0123456789abcdef"));
    let s1 = flush[mem](
      put(
        put(
          put(open[mem]("cache", schema_a()), 1, name_key("a"), b"first"),
          1,
          name_key("b"),
          b"gone",
        ),
        1,
        name_key("c"),
        long,
      ),
    );
    let s2 = flush[mem](drop(put(s1, 1, name_key("a"), b"second"), 1, name_key("b")));
    assert(stats(s2).data_bytes > stats(s2).live_bytes);
    let s3 = compact[mem](s2);
    assert_eq(stats(s3).data_bytes, stats(s3).live_bytes);
    assert_eq(s3.manifest.segments.len(), 1);
    assert_eq(segment_files().len(), 1);
    let s4 = open[mem]("cache", schema_a());
    assert_eq(lookup_payload(get[mem](s4, 1, name_key("a"))), b"second");
    assert(is_miss(get[mem](s4, 1, name_key("b"))));
    assert_eq(lookup_payload(get[mem](s4, 1, name_key("c"))), long);
    assert_eq(keys(s4, 1), keys(s3, 1));
    all_messages([s3.warnings, s4.warnings])
  });
  assert_eq(run.value, [])
}

test "a flush after most stored data was replaced or deleted rewrites the live entries into a new segment and deletes the old one" {
  let run = run_in_memory(mem_empty(), || {
    let big = Bytes::concat_all(range(0, 64).map(|i: Int| b"0123456789abcdef"));
    let s1 = flush[mem](put(open[mem]("cache", schema_a()), 1, name_key("a"), big));
    let first = "cache/" ++ segment_files().get(0);
    let s2 = flush[mem](put(s1, 1, name_key("a"), b"small"));
    assert_eq(stats(s2).data_bytes, stats(s2).live_bytes);
    assert_eq(s2.manifest.segments.len(), 1);
    // A run that opened the store before the flush still reads what it was shown, until the next.
    assert_eq(lookup_payload(get[mem](s1, 1, name_key("a"))), big);
    let s3 = open[mem]("cache", schema_a());
    assert_eq(pending_count(flush[mem](put(s3, 1, name_key("b"), b"next"))), 0);
    assert(!fs.exists[mem](first));
    assert_eq(lookup_payload(get[mem](s3, 1, name_key("a"))), b"small");
    all_messages([s2.warnings, s3.warnings])
  });
  assert_eq(run.value, [])
}

test "a store saved as two files is treated as another version's store, and the next flush deletes those two files" {
  let run = run_in_memory(mem_empty(), || {
    assert(fs.create_dir[mem]("cache"));
    assert(
      fs.write_file[mem]("cache/store.idx", b"PLYSTIDX")
        && fs.write_file[mem]("cache/store.dat", b"PLYSTDAT"),
    );
    let old = open[mem]("cache", schema_a());
    let s1 = flush[mem](put(old, 1, name_key("a"), b"x"));
    assert(!fs.exists[mem]("cache/store.idx") && !fs.exists[mem]("cache/store.dat"));
    let s2 = open[mem]("cache", schema_a());
    assert_eq(lookup_payload(get[mem](s2, 1, name_key("a"))), b"x");
    assert(clear_dir[mem]("cache"));
    assert(is_miss(get[mem](open[mem]("cache", schema_a()), 1, name_key("a"))));
    all_messages([old.warnings, s2.warnings])
  });
  assert_eq(run.value, ["the store was written by another version; this run starts empty"])
}

fn first_warning(ws: List<Warning>) -> Warning =
  match ws.at(0) { Some(w) -> w, None -> { kind: Corrupt, message: "none" } }

test "a warning says whether the store came from another version, has a missing segment, or cannot be read because it is locked" {
  let run = run_in_memory(mem_empty(), || {
    let s1 = flush[mem](put(open[mem]("cache", schema_a()), 1, name_key("a"), b"x"));
    let other = open[mem]("cache", b"schema b");
    assert(fs.remove[mem]("cache/" ++ segment_files().get(0)));
    let gone = open[mem]("cache", schema_a());
    assert(fs.lock[mem]("cache/lock"));
    let contains_key = flush[mem](put(gone, 1, name_key("b"), b"y"));
    contains_key.warnings.push(first_warning(other.warnings)).map(|w: Warning| w.kind)
  });
  assert_eq(run.value, [Corrupt, Unreadable, OtherVersion])
}
