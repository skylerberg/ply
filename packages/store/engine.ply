import std.fs (fs, mem_empty)
import std.set (Set)
import compiler.store.database
import compiler.store.database (StoreProblem, open_database)
import compiler.store.fact_store (Opening)
import fake (run_in_memory)

pub const key_width: Int = 32

fn slot(table: Int, key: Bytes) -> Bytes / {abort.raise} = byte_of_int(table) ++ key

const schema_slot: Bytes = b"\x00schema"

pub type Store = {
  database: Opening,
  schema: Bytes,
  rows: Map<Bytes, Bytes>,
  puts: Map<Bytes, Bytes>,
  deleted: Set<Bytes>,
  warnings: List<Warning>,
}

pub type WarningKind = | Unreadable | Corrupt | OtherVersion

pub type Warning = { kind: WarningKind, message: String }

pub type Lookup = | Hit(Bytes) | Miss | Bad(String)

pub fn warn(store: Store, trouble: WarningKind, message: String) -> Store =
  { ..store, warnings: add_warning(store.warnings, { kind: trouble, message: message }) }

fn add_warning(ws: List<Warning>, w: Warning) -> List<Warning> =
  if ws.fold(false, |seen: Bool, x: Warning| seen || x == w) { ws } else { ws.push(w) }

pub fn problem_warning(problem: StoreProblem) -> Warning =
  {
    kind: match problem { database::Damaged(_) -> Corrupt, database::NotKept(_) -> Unreadable },
    message: database::problem_message(problem),
  }

pub fn messages(ws: List<Warning>) -> List<String> = ws.map(|w: Warning| w.message)

fn store_of(database: Opening, schema: Bytes, rows: Map<Bytes, Bytes>) -> Store =
  {
    database: database,
    schema: schema,
    rows: rows,
    puts: Map::new(),
    deleted: Set::empty(),
    warnings: [],
  }

pub fn open<[r]>(database: Opening, schema: Bytes) -> Store / {fs.read[r], abort.raise} =
  match database::read_records[r](database) {
    Err(reason) ->
      {
        ..store_of(database, schema, Map::new()),
        warnings: [problem_warning(database::Damaged(reason))],
      },
    Ok(rows) -> if rows.get(schema_slot) == Some(schema) || rows.remove(schema_slot).len() == 0 {
      store_of(database, schema, rows.remove(schema_slot))
    } else {
      warn(
        {
          ..store_of(database, schema, Map::new()),
          deleted: rows.fold(Set::empty(), |found: Set<Bytes>, sl: Bytes, _: Bytes|
            found.insert(sl)),
        },
        OtherVersion,
        "the store was written by another version; this run starts empty",
      )
    },
  }

pub fn get(store: Store, table: Int, key: Bytes) -> Lookup / {abort.raise} = {
  let sl = slot(table, key);
  match store.puts.get(sl) {
    Some(payload) -> Hit(payload),
    None -> if store.deleted.contains(sl) { Miss }
    else { match store.rows.get(sl) { Some(payload) -> Hit(payload), None -> Miss } },
  }
}

pub fn contains_key(store: Store, table: Int, key: Bytes) -> Bool / {abort.raise} =
  match get(store, table, key) { Hit(_) -> true, _ -> false }

pub fn keys(store: Store, table: Int) -> List<Bytes> / {abort.raise} = {
  let in_table = |found: Set<Bytes>, sl: Bytes|
    if sl.at(0) == table && !store.deleted.contains(sl) { found.insert(sl.slice(1, sl.len())) }
    else { found };
  store.puts.fold(
    store.rows.fold(Set::empty(), |found: Set<Bytes>, sl: Bytes, _: Bytes| in_table(found, sl)),
    |found: Set<Bytes>, sl: Bytes, _: Bytes| in_table(found, sl),
  ).elements(
  )
}

pub type Stats = { entries: List<{ table: Int, count: Int }> }

pub fn stats(store: Store) -> Stats / {abort.raise} = {
  let counts = store.rows.fold(Map::new(), |found: Map<Int, Int>, sl: Bytes, _: Bytes|
    found.insert(sl.at(0), 1 + found.get(sl.at(0)).unwrap_or(0)));
  {
    entries: counts.fold([], |found: List<{ table: Int, count: Int }>, t: Int, n: Int|
      found.push({ table: t, count: n })),
  }
}

fn checked_slot(table: Int, key: Bytes) -> Bytes / {abort.raise} =
  if table < 1 || table > 255 { panic("a store table is numbered 1 to 255") }
  else if key.len() != key_width { panic("a store key is 32 bytes") }
  else { slot(table, key) }

pub fn put(store: Store, table: Int, key: Bytes, payload: Bytes) -> Store / {abort.raise} = {
  let sl = checked_slot(table, key);
  { ..store, puts: store.puts.insert(sl, payload), deleted: store.deleted.remove(sl) }
}

pub fn drop(store: Store, table: Int, key: Bytes) -> Store / {abort.raise} = {
  let sl = checked_slot(table, key);
  { ..store, puts: store.puts.remove(sl), deleted: store.deleted.insert(sl) }
}

pub fn pending_count(store: Store) -> Int = store.puts.len() + store.deleted.size()

pub type Row = { slot: Bytes, payload: Bytes }

pub fn pending_rows(store: Store) -> List<Row> =
  store.puts.fold([], |rows: List<Row>, sl: Bytes, payload: Bytes|
    rows.push({ slot: sl, payload: payload }))

pub fn without_pending(store: Store) -> Store = { ..store, puts: Map::new(), deleted: Set::empty() }

pub fn with_rows(store: Store, rows: List<Row>) -> Store / {abort.raise} =
  rows.fold(store, |s: Store, row: Row|
    if row.slot.len() != 1 + key_width || row.slot.at(0) < 1 { s }
    else { put(s, row.slot.at(0), row.slot.slice(1, row.slot.len()), row.payload) })

pub fn flush<[r]>(store: Store) -> Store / {fs.read[r], fs.write[r], abort.raise} =
  if pending_count(store) == 0 { store } else {
    match database::write_records[r](
        store.database,
        store.puts.insert(schema_slot, store.schema),
        store.deleted,
      ) {
      [] -> {
        let reopened = open[r](store.database, store.schema);
        { ..reopened, warnings: store.warnings.concat(reopened.warnings) }
      },
      problems ->
        problems.fold(store, |s: Store, problem: StoreProblem|
          { ..s, warnings: add_warning(s.warnings, problem_warning(problem)) }),
    }
  }

pub fn name_key(name: String) -> Bytes = Bytes::of_string(name).blake3()

const schema_a: Bytes = b"schema a"

fn database_in_memory(cache_dir: String) -> Opening / {fs.write[mem]} =
  open_database[mem](database::database_in(cache_dir))

fn lookup_payload(f: Lookup) -> Bytes =
  match f { Hit(b) -> b, Miss -> b"<miss>", Bad(reason) -> Bytes::of_string(reason) }

fn all_messages(xs: List<List<Warning>>) -> List<String> =
  xs.fold([], |accumulator: List<String>, x: List<Warning>|
    x.fold(accumulator, |a: List<String>, w: Warning| a.push(w.message)))

fn is_miss(f: Lookup) -> Bool = match f { Miss -> true, _ -> false }

test "entries put in a store can be read immediately, and again after the store is flushed and reopened" {
  let run = run_in_memory(mem_empty(), || {
    let s0 = open[mem](database_in_memory("cache"), schema_a);
    assert_eq(s0.warnings, []);
    let s1 = put(
      put(put(s0, 1, name_key("a"), b"alpha"), 2, name_key("a"), b"other table"),
      1,
      name_key("b"),
      b"beta",
    );
    assert_eq(lookup_payload(get(s1, 1, name_key("a"))), b"alpha");
    let s2 = flush[mem](s1);
    assert_eq(s2.warnings, []);
    assert_eq(pending_count(s2), 0);
    assert_eq(lookup_payload(get(s2, 1, name_key("b"))), b"beta");
    let s3 = open[mem](database_in_memory("cache"), schema_a);
    assert_eq(lookup_payload(get(s3, 1, name_key("a"))), b"alpha");
    assert_eq(lookup_payload(get(s3, 1, name_key("b"))), b"beta");
    assert_eq(lookup_payload(get(s3, 2, name_key("a"))), b"other table");
    assert(is_miss(get(s3, 1, name_key("c"))));
    assert_eq(keys(s3, 1).sort(), [name_key("a"), name_key("b")].sort());
    messages(s3.warnings)
  });
  assert_eq(run.value, [])
}

test "the rows a store has not flushed yet, put into another store, read back the same, and a row that names no slot is skipped" {
  let run = run_in_memory(mem_empty(), || {
    let written = put(
      put(open[mem](database_in_memory("one"), schema_a), 1, name_key("a"), b"alpha"),
      2,
      name_key("b"),
      b"beta",
    );
    let copied = with_rows(
      open[mem](database_in_memory("two"), schema_a),
      pending_rows(written).push({ slot: b"\x01short", payload: b"x" }),
    );
    {
      read: [get(copied, 1, name_key("a")), get(copied, 2, name_key("b"))].map(lookup_payload),
      same: pending_count(copied) == pending_count(written),
      emptied: pending_count(without_pending(written)),
    }
  });
  assert_eq(run.value.read, [b"alpha", b"beta"]);
  assert(run.value.same);
  assert_eq(run.value.emptied, 0)
}

test "a deleted entry stays deleted and a replaced entry keeps its new value after a flush and a reopen" {
  let run = run_in_memory(mem_empty(), || {
    let s1 = flush[mem](
      put(
        put(open[mem](database_in_memory("cache"), schema_a), 1, name_key("a"), b"one"),
        1,
        name_key("b"),
        b"two",
      ),
    );
    let s2 = flush[mem](put(drop(s1, 1, name_key("a")), 1, name_key("b"), b"three"));
    assert(is_miss(get(s2, 1, name_key("a"))));
    let s3 = open[mem](database_in_memory("cache"), schema_a);
    assert(is_miss(get(s3, 1, name_key("a"))));
    assert_eq(lookup_payload(get(s3, 1, name_key("b"))), b"three");
    assert_eq(keys(s3, 1), [name_key("b")]);
    messages(s3.warnings)
  });
  assert_eq(run.value, [])
}

test "two runs flushing one store keep each other's entries, and the later wins a shared key" {
  let run = run_in_memory(mem_empty(), || {
    let a = put(
      put(open[mem](database_in_memory("cache"), schema_a), 1, name_key("mine"), b"a"),
      1,
      name_key("both"),
      b"from a",
    );
    let b = put(
      put(open[mem](database_in_memory("cache"), schema_a), 1, name_key("theirs"), b"b"),
      1,
      name_key("both"),
      b"from b",
    );
    let a1 = flush[mem](a);
    let b1 = flush[mem](b);
    assert_eq(lookup_payload(get(b1, 1, name_key("mine"))), b"a");
    let c = open[mem](database_in_memory("cache"), schema_a);
    assert_eq(lookup_payload(get(c, 1, name_key("mine"))), b"a");
    assert_eq(lookup_payload(get(c, 1, name_key("theirs"))), b"b");
    assert_eq(lookup_payload(get(c, 1, name_key("both"))), b"from b");
    all_messages([a1.warnings, b1.warnings, c.warnings])
  });
  assert_eq(run.value, [])
}

test "an entry deleted by one run stays deleted when another run flushed its own entries first" {
  let run = run_in_memory(mem_empty(), || {
    let s0 = flush[mem](
      put(open[mem](database_in_memory("cache"), schema_a), 1, name_key("first"), b"0"),
    );
    let a = put(open[mem](database_in_memory("cache"), schema_a), 1, name_key("mine"), b"a");
    let b = drop(open[mem](database_in_memory("cache"), schema_a), 1, name_key("first"));
    let a1 = flush[mem](a);
    let b1 = flush[mem](b);
    let c = open[mem](database_in_memory("cache"), schema_a);
    assert(is_miss(get(c, 1, name_key("first"))));
    assert_eq(lookup_payload(get(c, 1, name_key("mine"))), b"a");
    all_messages([s0.warnings, a1.warnings, b1.warnings, c.warnings])
  });
  assert_eq(run.value, [])
}

test "a store written under another schema opens empty with a warning, and the next flush replaces its entries" {
  let run = run_in_memory(mem_empty(), || {
    let s1 = flush[mem](
      put(open[mem](database_in_memory("cache"), schema_a), 1, name_key("a"), b"x"),
    );
    let other = open[mem](database_in_memory("cache"), b"schema b");
    assert(is_miss(get(other, 1, name_key("a"))));
    assert_eq(pending_count(flush[mem](put(other, 1, name_key("b"), b"y"))), 0);
    let again = open[mem](database_in_memory("cache"), b"schema b");
    assert(is_miss(get(again, 1, name_key("a"))));
    assert_eq(lookup_payload(get(again, 1, name_key("b"))), b"y");
    all_messages([s1.warnings, other.warnings, again.warnings])
  });
  assert_eq(run.value, ["the store was written by another version; this run starts empty"])
}
