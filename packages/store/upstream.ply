import std.fs (fs, listed_names, mem_empty)
import std.random (entropy)
import std.time (time)
import std.bytes (u32_le, u64_le)
import engine (Lookup, Hit, Miss, Bad, name_key)
import fake (run_in_memory)

const frame_header_len: Int = 13

fn checksum(head: Bytes, payload: Bytes) -> Bytes / {abort.raise} =
  Bytes::blake3(head ++ payload).slice(0, 8)

fn frame(table: Int, payload: Bytes) -> Bytes / {abort.raise} = {
  let head = byte_of_int(table) ++ u32_le(payload.len());
  Bytes::concat_all([head, checksum(head, payload), payload])
}

fn unframe(table: Int, b: Bytes) -> Lookup / {abort.raise} =
  if b.len() < frame_header_len || Int::of_u32(b.u32_le(1)) != b.len() - frame_header_len {
    Bad("the bytes end inside a frame")
  } else if b.at(0) != table { Bad("a frame of another table") } else {
    let payload = b.slice(frame_header_len, b.len());
    if checksum(b.slice(0, 5), payload) != b.slice(5, frame_header_len) {
      Bad("a frame does not match its checksum")
    } else { Hit(payload) }
  }

fn fresh_nonce() -> Bytes / {entropy.next, time.now_ms, abort.raise} =
  Bytes::blake3(u64_le(entropy.next()) ++ u64_le(time.now_ms())).slice(0, 16)

pub type Upstream = { root: String, schema: Bytes, publish: Bool }

fn schema_dir(upstream: Upstream) -> String / {abort.raise} =
  upstream.root ++ "/v2/" ++ upstream.schema.hex_of().slice(0, 16)

fn table_dir(upstream: Upstream, table: Int) -> String / {abort.raise} =
  schema_dir(upstream) ++ "/" ++ table.to_string()

pub fn mark_published<[r]>(upstream: Upstream) -> Bool / {fs.write[r], abort.raise} =
  !upstream.publish
    || (fs.create_dir[r](schema_dir(upstream))
    && fs.write_file[r](schema_dir(upstream) ++ "/live", b""))

fn shard_dir(upstream: Upstream, table: Int, key: Bytes) -> String / {abort.raise} =
  table_dir(upstream, table) ++ "/" ++ key.hex_of().slice(0, 2)

fn entry_path(upstream: Upstream, table: Int, key: Bytes) -> String / {abort.raise} =
  shard_dir(upstream, table, key) ++ "/" ++ key.hex_of()

pub fn read_entry<[r]>(u: Upstream, table: Int, key: Bytes) -> Lookup / {fs.read[r], abort.raise} =
  match fs.read_file[r](entry_path(u, table, key)) { None -> Miss, Some(b) -> unframe(table, b) }

fn is_key_name(name: String) -> Bool =
  name.len() == 64
    && range(0, 64).fold(true, |ok: Bool, i: Int|
      ok && "0123456789abcdef".contains(name.slice(i, i + 1)))

pub fn entry_keys<[r]>(upstream: Upstream, table: Int) -> List<Bytes> / {fs.read[r], abort.raise} =
  match listed_names(fs.list_dir[r](table_dir(upstream, table))) {
    None -> [],
    Some(shards) ->
      shards.fold([], |accumulator: List<Bytes>, shard: String|
        match listed_names(fs.list_dir[r](table_dir(upstream, table) ++ "/" ++ shard)) {
          None -> accumulator,
          Some(names) ->
            names.fold(accumulator, |keys: List<Bytes>, name: String|
              if is_key_name(name) { keys.push(Bytes::of_hex(name)) } else { keys }),
        }),
  }

pub fn publish<[r]>(
  upstream: Upstream,
  table: Int,
  key: Bytes,
  payload: Bytes,
) -> Bool / {fs.read[r], fs.write[r], entropy.next, time.now_ms, abort.raise} =
  if !upstream.publish || read_entry[r](upstream, table, key) == Hit(payload) { true }
  else if !fs.create_dir[r](shard_dir(upstream, table, key)) { false } else {
    let temp = entry_path(upstream, table, key) ++ "." ++ fresh_nonce().hex_of() ++ ".tmp";
    if fs.write_file[r](temp, frame(table, payload))
        && fs.rename[r](temp, entry_path(upstream, table, key)) { true }
    else { if fs.remove[r](temp) { false } else { false } }
  }

fn test_upstream(publish: Bool) -> Upstream =
  { root: "shared", schema: b"schema".blake3(), publish: publish }

test "an entry published to an upstream is read back by its key, and a key never published is a miss" {
  let run = run_in_memory(mem_empty(), || {
    let wrote = publish[mem](test_upstream(true), 8, name_key("claim"), b"evidence")
      && publish[mem](test_upstream(true), 5, name_key("pass"), b"");
    let again = publish[mem](test_upstream(true), 8, name_key("claim"), b"evidence");
    [
      wrote && again,
      read_entry[mem](test_upstream(true), 8, name_key("claim")) == Hit(b"evidence"),
      read_entry[mem](test_upstream(true), 5, name_key("pass")) == Hit(b""),
      read_entry[mem](test_upstream(true), 8, name_key("other")) == Miss,
      entry_keys[mem](test_upstream(true), 5) == [name_key("pass")],
      entry_keys[mem](test_upstream(true), 6) == [],
    ]
  });
  assert_eq(run.value, [true, true, true, true, true, true])
}

test "publishing an entry again under the same key with new contents replaces the earlier contents" {
  let run = run_in_memory(mem_empty(), || {
    let first = publish[mem](test_upstream(true), 5, name_key("pass"), b"read a");
    let again = publish[mem](test_upstream(true), 5, name_key("pass"), b"read b");
    [first && again, read_entry[mem](test_upstream(true), 5, name_key("pass")) == Hit(b"read b")]
  });
  assert_eq(run.value, [true, true])
}

test "a read-only upstream serves cached results and is never written" {
  let run = run_in_memory(mem_empty(), || {
    let ok = publish[mem](test_upstream(false), 5, name_key("pass"), b"");
    [ok, entry_keys[mem](test_upstream(true), 5) == [], fs.exists[mem]("shared") == false]
  });
  assert_eq(run.value, [true, true, true])
}

test "reading an entry with a different schema hash is a miss, and reading an entry with altered bytes fails with a checksum mismatch" {
  let run = run_in_memory(mem_empty(), || {
    let wrote = publish[mem](test_upstream(true), 8, name_key("claim"), b"evidence");
    let other = { root: "shared", schema: b"another".blake3(), publish: true };
    let path = entry_path(test_upstream(true), 8, name_key("claim"));
    let bytes = match fs.read_file[mem](path) { Some(b) -> b, None -> b"" };
    let damaged = fs.write_file[mem](path, bytes.slice(0, bytes.len() - 1) ++ b"?");
    [
      read_entry[mem](other, 8, name_key("claim")),
      read_entry[mem](test_upstream(true), 8, name_key("claim")),
    ]
  });
  assert_eq(run.value, [Miss, Bad("a frame does not match its checksum")])
}
