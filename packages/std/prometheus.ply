//! Stores Prometheus metrics in a registry and serves them to scrapers.
//!
//! A `Registry` is a value. `add` returns a registry with a counter increased, `set` one with a
//! gauge set, and `observe` one with a histogram bucket counted.
//!
//! `snapshot` returns the registry's contents. Families are sorted by name and each family's series
//! are sorted by labels, so two scrapes of the same state produce the same bytes.
//!
//! A metric name is a `Name` and a label name is a `Label`. Each can hold only text the exposition
//! formats allow. `sanitized_name` and `sanitized_label` build one from any text.
//!
//! A metric accepts at most the registry's `max_series` distinct label sets. A new label set past
//! that limit is dropped and counted. This stops a label with unlimited values from using all of
//! the server's memory.
//!
//! `render_text` writes a snapshot in the text format, version 0.0.4. `render_openmetrics` writes
//! OpenMetrics 1.0, which adds units, exemplars on counters and buckets, and a final `# EOF` line.
//! `parse` reads either format.
//!
//! Parsing `render_openmetrics(s)` returns `s`. Parsing `render_text(s)` returns
//! `as_text_format(s)`, which is `s` without the units and exemplars that the text format cannot
//! express.
//!
//! A counter family is named without `_total`, and its samples are named with it. A histogram's
//! buckets are cumulative, labeled by `le`, and end with `+Inf`. Summaries, info metrics and state
//! sets are not supported, and `parse` rejects each with its own message.
//!
//! `recording` is a `trace` handler. It records `trace.count`, `trace.gauge` and `trace.time` on
//! any channel into a registry. The channel becomes the label `channel`, the fields become labels,
//! and timings are in seconds.
//!
//! `scrape` responds to `GET /metrics` from a registry, in the format the request's `Accept` header
//! prefers.

import std.bytes (is_digit)
import std.float
import std.gen
import std.gen (Gen)
import std.http
import std.http (Request, Response)
import std.json
import std.list
import std.string
import std.telemetry
import std.trace
import std.trace (Fields, trace)

/// A metric's name: a letter, `_` or `:`, and then letters, digits, `_` and `:`.
pub opaque type Name = | Name(String)

/// A label's name: a letter or `_`, and then letters, digits and `_`, and not starting with
/// `__`, which Prometheus reserves for itself.
pub opaque type Label = | Label(String)

show for Name by name_text

show for Label by label_text

fn ascii_letters() -> Bytes = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

fn name_bytes() -> Bytes = ascii_letters().concat(b"0123456789_:")

fn label_bytes() -> Bytes = ascii_letters().concat(b"0123456789_")

fn fits(text: String, allowed: Bytes) -> Bool =
  match try[abort.raise] {
      let raw = Bytes::of_string(text);
      raw.len() > 0 && !is_digit(raw.at(0)) && raw.skip(0, allowed) >= raw.len()
    } {
    Ok(result) -> result,
    Err(_) -> false,
  }

/// `text` as a metric name, or `None` if it is not a valid one.
pub fn name(text: String) -> Option<Name> =
  if fits(text, name_bytes()) { Some(Name(text)) } else { None }

/// `text` as a label name, or `None` if it is not a valid one.
pub fn label(text: String) -> Option<Label> =
  if fits(text, label_bytes()) && !text.starts_with("__") { Some(Label(text)) } else { None }

/// Makes a metric name from any text: each character a name cannot contain becomes `_`, and a
/// name that would start with a digit, or be empty, starts with `_`.
pub fn sanitized_name(text: String) -> Name = Name(sanitized(text, name_bytes()))

/// Makes a label name from any text, as `sanitized_name` does for a metric. A name that would
/// start with `__` starts with `_x` instead.
pub fn sanitized_label(text: String) -> Label = {
  let made = sanitized(text, label_bytes());
  if made.starts_with("__") {
    Label(
      "_x"
        ++ (match try[abort.raise] { made.slice(2, made.len()) } {
          Ok(rest) -> rest,
          Err(_) -> "",
        }),
    )
  } else { Label(made) }
}

fn sanitized(text: String, allowed: Bytes) -> String =
  match try[abort.raise] {
      let raw = Bytes::of_string(text);
      let sanitized_bytes = Bytes::concat_all(
        range(0, raw.len()).map(|i: Int|
          if allowed.index_of_byte(raw.at(i)) == None { b"_" } else { raw.slice(i, i + 1) }),
      );
      if sanitized_bytes.len() == 0 || is_digit(sanitized_bytes.at(0)) {
        String::of_bytes(b"_".concat(sanitized_bytes))
      } else { String::of_bytes(sanitized_bytes) }
    } {
    Ok(made) -> made,
    Err(_) -> "_",
  }

/// A metric name's text.
pub fn name_text(n: Name) -> String = match n { Name(text) -> text }

/// A label name's text.
pub fn label_text(l: Label) -> String = match l { Label(text) -> text }

/// One label and its value.
pub type Pair = new { label: Label, value: String }

/// A series' labels: in the order of their names, each name once.
pub opaque type Labels = | Labels(List<Pair>)

/// Labels from these pairs. A name given more than once takes its last value.
pub fn labels(given: List<Pair>) -> Labels =
  Labels(
    given.fold(Map::new(), |by_label: Map<Label, String>, p: Pair|
      by_label.insert(p.label, p.value)).entries(
    ).map(|e: { key: Label, value: String }| -> Pair { { label: e.key, value: e.value } }),
  )

/// No labels.
pub fn no_labels() -> Labels = Labels([])

/// The pairs of a label set, in the order of their names.
pub fn pairs(ls: Labels) -> List<Pair> = match ls { Labels(held) -> held }

/// A label and its value.
pub fn pair(l: Label, value: String) -> Pair = { label: l, value: value }

/// The type of a metric family: a counter that only increases, a gauge that can go up and down, a
/// histogram of bucketed observations, or `Untyped` when the type is unknown.
pub type Kind = | Counter | Gauge | Histogram | Untyped

/// An observation a sample refers to: its labels, by convention a trace id and a span id, and
/// its value.
pub type Exemplar = new { labels: Labels, value: Float }

/// One bucket of a histogram: how many observations were at most `le`, counting those of every
/// bucket before it. The last bucket's `le` is infinity.
pub type Bucket = new { le: Float, count: Int, exemplar: Option<Exemplar> }

/// The data of one series, which depends on the family's kind: a counter's total, a gauge's current
/// value, or a histogram's buckets and sum.
pub type Value =
  | CounterValue(Float, Option<Exemplar>)
  | GaugeValue(Float)
  /// The buckets, and the sum of everything observed.
  | HistogramValue(List<Bucket>, Float)

/// One series of a family.
pub type Series = new { labels: Labels, value: Value }

/// One metric and its series. A counter's `name` is without `_total`, and a `unit`, if there is
/// one, is what the name ends with after a `_`.
pub type Family = new { name: Name, help: String, unit: String, kind: Kind, series: List<Series> }

/// A registry's contents at one moment.
pub type Snapshot = new { families: List<Family> }

/// `s` as the text format can express it: without units and exemplars.
pub fn as_text_format(s: Snapshot) -> Snapshot =
  {
    families: s.families.map(|f: Family| -> Family {
      {
        ..f,
        unit: "",
        series: f.series.map(|series: Series| -> Series {
          {
            labels: series.labels,
            value: match series.value {
              CounterValue(v, _) -> CounterValue(v, None),
              GaugeValue(v) -> GaugeValue(v),
              HistogramValue(buckets, sum) ->
                HistogramValue(buckets.map(|b: Bucket| -> Bucket { { ..b, exemplar: None } }), sum),
            },
          }
        }),
      }
    }),
  }

type Slot =
  | CounterSlot(Float, Option<Exemplar>)
  | GaugeSlot(Float)
  | HistogramSlot(List<Int>, List<Option<Exemplar>>, Float)

type FamilyState = {
  name: Name,
  help: String,
  unit: String,
  kind: Kind,
  bounds: List<Float>,
  series: Map<Labels, Slot>,
}

/// Stores metrics: each metric family by name, and each family's series by label set.
pub opaque type Registry = new {
  families: Map<String, FamilyState>,
  max_series: Int,
  dropped: Int,
  rejected: Int,
}

/// An empty registry, whose metrics each keep at most `max_series` label sets.
pub fn registry(max_series: Int) -> Registry =
  { families: Map::new(), max_series: max_series, dropped: 0, rejected: 0 }

/// How many updates had a label set that their metric had no room for.
pub fn dropped(r: Registry) -> Int = r.dropped

/// Returns how many updates were rejected as invalid. An update is invalid when it targets a metric
/// of a different kind, moves a counter backwards or by a NaN, or declares a unit that the metric's
/// name does not end with.
pub fn rejected(r: Registry) -> Int = r.rejected

fn family_name(n: Name, kind: Kind) -> String = {
  let text = name_text(n);
  match kind {
    Counter -> if text.ends_with("_total") && text.len() > 6 {
      match try[abort.raise] { text.slice(0, text.len() - 6) } { Ok(base) -> base, Err(_) -> text }
    } else { text },
    _ -> text,
  }
}

fn rejecting(r: Registry) -> Registry = { ..r, rejected: r.rejected + 1 }

/// Declares the metric `n` to be of `kind`, with the given help and unit. A non-empty unit must
/// follow a `_` at the end of the name, as OpenMetrics requires. Rejects and counts the call if the
/// unit does not match the name, or if the metric already exists with a different kind.
pub fn describe(r: Registry, n: Name, kind: Kind, help: String, unit: String) -> Registry = {
  let key = family_name(n, kind);
  if unit != "" && !key.ends_with("_" ++ unit) { rejecting(r) } else {
    match r.families.get(key) {
      Some(family) -> if family.kind != kind { rejecting(r) }
      else { { ..r, families: r.families.insert(key, { ..family, help: help, unit: unit }) } },
      None ->
        {
          ..r,
          families: r.families.insert(key, {
            name: Name(key),
            help: help,
            unit: unit,
            kind: kind,
            bounds: telemetry::duration_bounds(),
            series: Map::new(),
          }),
        },
    }
  }
}

/// Sets the upper bounds of the buckets of the histogram `n`. Rejects and counts the call if the
/// histogram already has a series, because counts recorded with different bounds cannot be
/// compared, or if the bounds do not strictly ascend or contain a NaN or an infinity.
pub fn with_bounds(r: Registry, n: Name, bounds: List<Float>) -> Registry = {
  let described = match r.families.get(name_text(n)) {
    Some(_) -> r,
    None -> describe(r, n, Histogram, "", ""),
  };
  let ascending = range(0, bounds.len()).all(|i: Int|
    match ((bounds.at(i), bounds.at(i + 1))) {
      (Some(a), Some(b)) -> a < b,
      (Some(a), None) -> a == a && a != Float::infinity() && a != Float::neg_infinity(),
      _ -> true,
    });
  match described.families.get(name_text(n)) {
    Some(family) -> if family.kind != Histogram || family.series.len() > 0 || !ascending {
      rejecting(r)
    } else {
      {
        ..described,
        families: described.families.insert(name_text(n), { ..family, bounds: bounds }),
      }
    },
    None -> rejecting(r),
  }
}

fn update_series(
  r: Registry,
  n: Name,
  kind: Kind,
  ls: Labels,
  step: (FamilyState, Option<Slot>) -> Slot,
) -> Registry = {
  let key = family_name(n, kind);
  let known = match r.families.get(key) { Some(_) -> r, None -> describe(r, n, kind, "", "") };
  match known.families.get(key) {
    None -> rejecting(r),
    Some(family) -> if family.kind != kind { rejecting(r) } else {
      let before = family.series.get(ls);
      if before == None && family.series.len() >= max(known.max_series, 1) {
        { ..known, dropped: known.dropped + 1 }
      } else {
        {
          ..known,
          families: known.families.insert(key, {
            ..family,
            series: family.series.insert(ls, step(family, before)),
          }),
        }
      }
    },
  }
}

fn exemplar_within_limit(e: Option<Exemplar>) -> Option<Exemplar> =
  match e {
    Some(exemplar) -> if pairs(exemplar.labels).fold(0, |n: Int, p: Pair|
          n + label_text(p.label).len() + p.value.len())
        > 128 { None }
    else { e },
    None -> None,
  }

/// Increases the counter `n` under `ls` by `delta`. A counter only rises: a delta below zero, or
/// a NaN, is rejected and counted.
pub fn add(r: Registry, n: Name, ls: Labels, delta: Float) -> Registry =
  add_with(r, n, ls, delta, None)

/// Adds `delta` to a counter like `add`, and replaces the series' exemplar with `exemplar`. With
/// `None`, the series keeps its current exemplar.
pub fn add_with(
  r: Registry,
  n: Name,
  ls: Labels,
  delta: Float,
  exemplar: Option<Exemplar>,
) -> Registry =
  if !(delta >= 0.0) { rejecting(r) } else {
    update_series(r, n, Counter, ls, |_: FamilyState, before: Option<Slot>|
      match before {
        Some(CounterSlot(total, seen)) ->
          CounterSlot(total + delta, match exemplar_within_limit(exemplar) {
            Some(e) -> Some(e),
            None -> seen,
          }),
        _ -> CounterSlot(delta, exemplar_within_limit(exemplar)),
      })
  }

/// Sets the gauge `n` under `ls` to `value`.
pub fn set(r: Registry, n: Name, ls: Labels, value: Float) -> Registry =
  update_series(r, n, Gauge, ls, |_: FamilyState, _: Option<Slot>| GaugeSlot(value))

/// Counts `value` in the histogram `n` under `ls`. A NaN is rejected and counted.
pub fn observe(r: Registry, n: Name, ls: Labels, value: Float) -> Registry =
  observe_with(r, n, ls, value, None)

/// `observe`, with an exemplar for the bucket the value falls in.
pub fn observe_with(
  r: Registry,
  n: Name,
  ls: Labels,
  value: Float,
  exemplar: Option<Exemplar>,
) -> Registry =
  if value.is_nan() { rejecting(r) } else {
    update_series(r, n, Histogram, ls, |family: FamilyState, before: Option<Slot>| {
      let at = telemetry::bucket_of(family.bounds, value);
      let marked = |seen: List<Option<Exemplar>>|
        range(0, family.bounds.len() + 1).map(|i: Int| -> Option<Exemplar> {
          let old = match seen.at(i) { Some(e) -> e, None -> None };
          if i == at { match exemplar_within_limit(exemplar) { Some(e) -> Some(e), None -> old } }
          else { old }
        });
      match before {
        Some(HistogramSlot(counts, seen, sum)) ->
          HistogramSlot(
            telemetry::add_to_buckets(family.bounds, counts, value),
            marked(seen),
            sum + value,
          ),
        _ -> HistogramSlot(telemetry::add_to_buckets(family.bounds, [], value), marked([]), value),
      }
    })
  }

/// The contents of `r`: its families in the order of their names, and each one's series in the
/// order of their labels.
pub fn snapshot(r: Registry) -> Snapshot =
  {
    families: r.families.values().map(|family: FamilyState| -> Family {
      {
        name: family.name,
        help: family.help,
        unit: family.unit,
        kind: family.kind,
        series: family.series.entries().map(|e: { key: Labels, value: Slot }| -> Series {
          { labels: e.key, value: slot_value(family, e.value) }
        }),
      }
    }),
  }

fn slot_value(family: FamilyState, slot: Slot) -> Value =
  match slot {
    CounterSlot(total, seen) -> CounterValue(total, seen),
    GaugeSlot(level) -> GaugeValue(level),
    HistogramSlot(counts, seen, sum) ->
      HistogramValue(
        range(0, family.bounds.len() + 1).fold(
          { total: 0, out: [] },
          |accumulator: { total: Int, out: List<Bucket> }, i: Int| {
            let total = accumulator.total + (match counts.at(i) { Some(n) -> n, None -> 0 });
            let bucket: Bucket = {
              le: match family.bounds.at(i) { Some(bound) -> bound, None -> Float::infinity() },
              count: total,
              exemplar: match seen.at(i) { Some(e) -> e, None -> None },
            };
            { total: total, out: accumulator.out.push(bucket) }
          },
        ).out,
        sum,
      ),
  }

/// The `Content-Type` of the text format.
pub fn text_content_type() -> String = "text/plain; version=0.0.4; charset=utf-8"

/// The `Content-Type` of OpenMetrics.
pub fn openmetrics_content_type() -> String =
  "application/openmetrics-text; version=1.0.0; charset=utf-8"

fn number(f: Float, openmetrics: Bool) -> String =
  if f.is_nan() { "NaN" }
  else if f == Float::infinity() { "+Inf" }
  else if f == Float::neg_infinity() { "-Inf" } else {
    match try[abort.raise] { format_like_go(f.to_string(), openmetrics) } {
      Ok(text) -> text,
      Err(_) -> f.to_string(),
    }
  }

fn format_like_go(written: String, openmetrics: Bool) -> String / {abort.raise} = {
  let negative = written.starts_with("-");
  let body = if negative { written.slice(1, written.len()) } else { written };
  let parts = body.split("e");
  let halves = parts.at_or(0, "0").split(".");
  let whole = halves.at_or(0, "0");
  let every = Bytes::of_string(whole ++ halves.at_or(1, ""));
  let lead = every.skip(0, b"0");
  let digits = String::of_bytes(every.slice(lead, last_digit(every, lead)));
  let point = whole.len() + exponent_of(parts.at_or(1, "0")) - lead;
  let n = digits.len();
  let text = if n == 0 { if openmetrics { "0.0" } else { "0" } }
  else if point - 1 < -4 || point - 1 >= 6 {
    digits.slice(0, 1) ++ (if n > 1 { "." ++ digits.slice(1, n) } else { "" }) ++ "e"
      ++ (if point - 1 < 0 { "-" } else { "+" })
      ++ (if abs_int(point - 1) < 10 { "0" } else { "" })
      ++ abs_int(point - 1).to_string()
  } else if point <= 0 { "0." ++ "0".repeat(0 - point) ++ digits }
  else if n <= point { digits ++ "0".repeat(point - n) ++ (if openmetrics { ".0" } else { "" }) }
  else { digits.slice(0, point) ++ "." ++ digits.slice(point, n) };
  (if negative { "-" } else { "" }) ++ text
}

fn last_digit(every: Bytes, from: Int) -> Int / {abort.raise} =
  range(from, every.len()).fold(from, |end: Int, i: Int|
    if every.at(i) == b'0' { end } else { i + 1 })

fn exponent_of(text: String) -> Int / {abort.raise} = {
  let negative = text.starts_with("-");
  let signed = negative || text.starts_with("+");
  let digits = if signed { text.slice(1, text.len()) } else { text };
  let value = match Bytes::of_string(digits).int_of_ascii() { Some(n) -> n, None -> 0 };
  if negative { 0 - value } else { value }
}

fn abs_int(n: Int) -> Int = if n < 0 { 0 - n } else { n }

fn replaced(text: String, from: String, to: String) -> String =
  String::join(string_split_whole(text, from), to)

fn string_split_whole(text: String, sep: String) -> List<String> =
  match try[abort.raise] { text.split(sep) } { Ok(parts) -> parts, Err(_) -> [text] }

fn escaped_value(text: String) -> String =
  replaced(replaced(replaced(text, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n")

fn escaped_help(text: String, openmetrics: Bool) -> String = {
  let base = replaced(replaced(text, "\\", "\\\\"), "\n", "\\n");
  if openmetrics { replaced(base, "\"", "\\\"") } else { base }
}

fn written_labels(label_pairs: List<Pair>, le: Option<Float>, openmetrics: Bool) -> String = {
  let own = label_pairs.map(|p: Pair|
    label_text(p.label) ++ "=\"" ++ escaped_value(p.value) ++ "\"");
  let every = match le {
    Some(bound) -> own.push("le=\"" ++ number(bound, openmetrics) ++ "\""),
    None -> own,
  };
  if every.len() == 0 { "" } else { "{" ++ String::join(every, ",") ++ "}" }
}

fn written_exemplar(e: Option<Exemplar>, openmetrics: Bool) -> String =
  match ((openmetrics, e)) {
    (true, Some(exemplar)) -> {
      let inside = written_labels(pairs(exemplar.labels), None, openmetrics);
      " # " ++ (if inside == "" { "{}" } else { inside }) ++ " "
        ++ number(exemplar.value, openmetrics)
    },
    _ -> "",
  }

fn kind_text(kind: Kind, openmetrics: Bool) -> String =
  match kind {
    Counter -> "counter",
    Gauge -> "gauge",
    Histogram -> "histogram",
    Untyped -> if openmetrics { "unknown" } else { "untyped" },
  }

fn series_lines(base: String, series: Series, openmetrics: Bool) -> List<String> = {
  let own = pairs(series.labels);
  match series.value {
    CounterValue(total, seen) ->
      [
        base ++ "_total" ++ written_labels(own, None, openmetrics) ++ " "
          ++ number(total, openmetrics)
          ++ written_exemplar(seen, openmetrics),
      ],
    GaugeValue(level) ->
      [base ++ written_labels(own, None, openmetrics) ++ " " ++ number(level, openmetrics)],
    HistogramValue(buckets, sum) ->
      buckets.map(|b: Bucket|
        base ++ "_bucket" ++ written_labels(own, Some(b.le), openmetrics) ++ " "
          ++ b.count.to_string()
          ++ written_exemplar(b.exemplar, openmetrics)).concat([
        base ++ "_sum" ++ written_labels(own, None, openmetrics) ++ " " ++ number(sum, openmetrics),
        base ++ "_count" ++ written_labels(own, None, openmetrics) ++ " "
          ++ Int::to_string(match buckets.at(buckets.len() - 1) { Some(b) -> b.count, None -> 0 }),
      ]),
  }
}

fn family_lines(f: Family, openmetrics: Bool) -> List<String> = {
  let base = name_text(f.name);
  let titled = match f.kind {
    Counter -> if openmetrics { base } else { base ++ "_total" },
    _ -> base,
  };
  let head = List::concat(
    if f.help == "" { [] }
    else { ["# HELP " ++ titled ++ " " ++ escaped_help(f.help, openmetrics)] },
    ["# TYPE " ++ titled ++ " " ++ kind_text(f.kind, openmetrics)],
  ).concat(if openmetrics && f.unit != "" { ["# UNIT " ++ titled ++ " " ++ f.unit] } else { [] });
  f.series.fold(head, |lines: List<String>, series: Series|
    lines.concat(series_lines(base, series, openmetrics)))
}

fn rendered(s: Snapshot, openmetrics: Bool) -> Bytes = {
  let lines = s.families.fold([], |accumulator: List<String>, f: Family|
    accumulator.concat(family_lines(f, openmetrics)));
  let every = if openmetrics { lines.push("# EOF") } else { lines };
  Bytes::of_string(every.fold("", |text: String, line: String| text ++ line ++ "\n"))
}

/// Renders the snapshot `s` in the Prometheus text format, version 0.0.4.
pub fn render_text(s: Snapshot) -> Bytes = rendered(s, false)

/// Renders the snapshot `s` in OpenMetrics 1.0, ending with a `# EOF` line.
pub fn render_openmetrics(s: Snapshot) -> Bytes = rendered(s, true)

/// The limits `parse` enforces on a page.
pub type Limits = new {
  /// The most bytes a page may be.
  length: Int,
  /// The most sample lines it may contain.
  samples: Int,
}

/// Why a page was rejected.
pub type ErrorKind =
  /// Longer than `Limits.length`.
  | TooLong
  /// More sample lines than `Limits.samples`.
  | TooMany
  /// Not UTF-8.
  | NotText
  /// A line that does not start with a metric name.
  | BadName
  /// Labels that are not closed, a label with no quoted value, or an invalid label name.
  | BadLabels
  /// An escape other than `\\`, `\"` and `\n`.
  | BadEscape
  /// A value that is not a number, or a count that is not a whole one.
  | BadValue
  /// A `TYPE` this module does not model, such as `summary`, `info` or `stateset`. The variant
  /// contains the type's name.
  | Unsupported(String)
  /// A `HELP`, `TYPE` or `UNIT` line without its parts.
  | BadComment
  /// A sample that does not fit the kind of its family, such as a histogram bucket sample with no
  /// `le` label.
  | Misplaced
  /// A line after `# EOF`.
  | AfterEnd

/// A parse error, and the line it is on, counted from one.
pub type Error = new { reason: ErrorKind, line: Int }

/// This module's operations: the error `read` raises, and the registry `recording` provides.
pub effect prometheus {
  /// The page is not one this module reads.
  raise fail(e: Error)
  /// The current registry of the `recording` around the caller.
  read registry() -> Registry
}

/// Sixteen mebibytes and a million samples.
pub fn default_limits() -> Limits = { length: 16777216, samples: 1000000 }

/// Parses a page in either format into a snapshot, or returns why it was rejected.
pub fn parse(page: Bytes, limits: Limits) -> Result<Snapshot, Error> / {abort.raise} =
  try { read(page, limits) }

type Draft = {
  name: String,
  help: String,
  unit: String,
  kind: Kind,
  order: List<Labels>,
  series: Map<Labels, Value>,
}

type ParseState = { order: List<String>, drafts: Map<String, Draft>, samples: Int, ended: Bool }

/// Parses a page in either format into a snapshot, raising `prometheus.fail` where `parse`
/// returns `Err`. Timestamps and `_created` samples are skipped, and a sample whose name no `TYPE`
/// line declared is a family of its own, untyped.
pub fn read(page: Bytes, limits: Limits) -> Snapshot / {prometheus.fail, abort.raise} =
  if page.len() > limits.length { prometheus.fail({ reason: TooLong, line: 0 }) }
  else if !page.is_utf8() { prometheus.fail({ reason: NotText, line: 0 }) } else {
    let lines = page.split(b"\n");
    let start: ParseState = { order: [], drafts: Map::new(), samples: 0, ended: false };
    let done = range(0, lines.len()).fold(start, |r: ParseState, i: Int|
      match lines.at(i) {
        Some(line) -> line_read(r, trimmed_line(line), i + 1, limits),
        None -> r,
      });
    {
      families: done.order.fold([], |accumulator: List<Family>, key: String|
        match done.drafts.get(key) {
          Some(d) -> accumulator.push(family_of(d)),
          None -> accumulator,
        }),
    }
  }

fn family_of(d: Draft) -> Family =
  {
    name: Name(d.name),
    help: d.help,
    unit: d.unit,
    kind: d.kind,
    series: d.order.fold([], |accumulator: List<Series>, ls: Labels|
      match d.series.get(ls) {
        Some(v) -> accumulator.push({ labels: ls, value: v }),
        None -> accumulator,
      }),
  }

fn trimmed_line(line: Bytes) -> Bytes / {abort.raise} =
  if line.ends_with(b"\r") { line.slice(0, line.len() - 1) } else { line }

fn fail<a>(reason: ErrorKind, line: Int) -> a / {prometheus.fail} =
  prometheus.fail({ reason: reason, line: line })

fn line_read(
  r: ParseState,
  line: Bytes,
  at: Int,
  limits: Limits,
) -> ParseState / {prometheus.fail, abort.raise} =
  if line.len() == 0 { r }
  else if r.ended { fail(AfterEnd, at) }
  else if line == b"# EOF" { { ..r, ended: true } }
  else if line.starts_with(b"# HELP ") || line.starts_with(b"# TYPE ")
      || line.starts_with(b"# UNIT ") { comment_read(r, line, at) }
  else if line.starts_with(b"#") { r }
  else if r.samples >= limits.samples { fail(TooMany, at) }
  else { sample_read({ ..r, samples: r.samples + 1 }, line, at) }

fn ensure_draft(r: ParseState, key: String, kind: Kind) -> ParseState =
  match r.drafts.get(key) {
    Some(_) -> r,
    None ->
      {
        ..r,
        order: r.order.push(key),
        drafts: r.drafts.insert(key, {
          name: key,
          help: "",
          unit: "",
          kind: kind,
          order: [],
          series: Map::new(),
        }),
      },
  }

fn comment_read(
  r: ParseState,
  line: Bytes,
  at: Int,
) -> ParseState / {prometheus.fail, abort.raise} = {
  let word = line.slice(2, 6);
  let rest = line.slice(7, line.len());
  let space = match rest.index_of_byte(b' ') { Some(i) -> i, None -> rest.len() };
  let named = String::of_bytes(rest.slice(0, space));
  let comment_text = String::of_bytes(rest.slice(min(space + 1, rest.len()), rest.len()));
  if name(named) == None { fail(BadComment, at) } else if word == b"TYPE" {
    let kind = kind_of(comment_text, at);
    let key = family_name(Name(named), kind);
    let early = if key == named { None } else { r.drafts.get(named) };
    let update_series = match early {
      Some(_) ->
        { ..r, order: r.order.filter(|k: String| k != named), drafts: r.drafts.remove(named) },
      None -> r,
    };
    let known = ensure_draft(update_series, key, kind);
    match known.drafts.get(key) {
      Some(d) ->
        {
          ..known,
          drafts: known.drafts.insert(key, {
            ..d,
            kind: kind,
            help: match early { Some(e) -> e.help, None -> d.help },
          }),
        },
      None -> known,
    }
  } else {
    let key = match r.drafts.get(named) {
      Some(_) -> named,
      None -> if r.drafts.contains(family_name(Name(named), Counter)) {
        family_name(Name(named), Counter)
      } else { named },
    };
    let known = ensure_draft(r, key, Untyped);
    match known.drafts.get(key) {
      Some(d) ->
        {
          ..known,
          drafts: known.drafts.insert(key, if word == b"HELP" {
            { ..d, help: unescaped(Bytes::of_string(comment_text), at) }
          } else { { ..d, unit: comment_text } }),
        },
      None -> known,
    }
  }
}

fn kind_of(comment_text: String, at: Int) -> Kind / {prometheus.fail} =
  match comment_text {
    "counter" -> Counter,
    "gauge" -> Gauge,
    "histogram" -> Histogram,
    "untyped" -> Untyped,
    "unknown" -> Untyped,
    other -> fail(Unsupported(other), at),
  }

fn unescaped(raw: Bytes, at: Int) -> String / {prometheus.fail, abort.raise} = {
  let n = raw.len();
  let pieces = iterate({ i: 0, out: [] }, n + 1, |s: { i: Int, out: List<Bytes> }|
    if s.i >= n { Stop(s.out) } else {
      match raw.index_of_from(b"\\", s.i) {
        None -> Stop(s.out.push(raw.slice(s.i, n))),
        Some(slash) -> if slash + 1 >= n { fail(BadEscape, at) } else {
          let piece = match raw.at(slash + 1) {
            b'\\' -> b"\\",
            b'"' -> b"\"",
            b'n' -> b"\n",
            _ -> fail(BadEscape, at),
          };
          Continue({ i: slash + 2, out: s.out.push(raw.slice(s.i, slash)).push(piece) })
        },
      }
    });
  String::of_bytes(Bytes::concat_all(pieces))
}

type LabelsRead = { pairs: List<Pair>, le: Option<Float>, next: Int }

fn labels_read(line: Bytes, from: Int, at: Int) -> LabelsRead / {prometheus.fail, abort.raise} = {
  let n = line.len();
  let start: LabelsRead = { pairs: [], le: None, next: from + 1 };
  iterate(start, n + 2, |s: LabelsRead| {
    let i = line.skip(s.next, b" ,");
    if i >= n { fail(BadLabels, at) }
    else if line.at(i) == b'}' { Stop({ ..s, next: i + 1 }) } else {
      let equals = line.skip(i, label_bytes());
      let named = String::of_bytes(line.slice(i, equals));
      if equals + 1 >= n || line.at(equals) != b'=' || line.at(equals + 1) != b'"' {
        fail(BadLabels, at)
      } else {
        let close = closing_quote(line, equals + 2, at);
        let value = unescaped(line.slice(equals + 2, close), at);
        if named == "le" {
          Continue({ ..s, le: Some(number_of(Bytes::of_string(value), at)), next: close + 1 })
        } else {
          match label(named) {
            Some(l) -> Continue({ ..s, pairs: s.pairs.push(pair(l, value)), next: close + 1 }),
            None -> fail(BadLabels, at),
          }
        }
      }
    }
  })
}

fn closing_quote(line: Bytes, from: Int, at: Int) -> Int / {prometheus.fail, abort.raise} = {
  let n = line.len();
  iterate(from, n + 1, |i: Int|
    if i >= n { fail(BadLabels, at) }
    else if line.at(i) == b'\\' { Continue(i + 2) }
    else if line.at(i) == b'"' { Stop(i) }
    else { Continue(i + 1) })
}

fn number_of(raw: Bytes, at: Int) -> Float / {prometheus.fail, abort.raise} =
  if raw == b"+Inf" || raw == b"Inf" { Float::infinity() }
  else if raw == b"-Inf" { Float::neg_infinity() }
  else if raw == b"NaN" { Float::of_bits(0x7FF8_0000_0000_0000) } else {
    let unsigned = if raw.starts_with(b"+") { raw.slice(1, raw.len()) } else { raw };
    let text = replaced(replaced(String::of_bytes(unsigned), "e+", "e"), "E+", "E");
    match Float::of_string(text) { Some(f) -> f, None -> fail(BadValue, at) }
  }

fn whole_of(raw: Bytes, at: Int) -> Int / {prometheus.fail, abort.raise} = {
  let f = number_of(raw, at);
  match Int::of_float(f, Down) {
    Some(n) -> if Float::of_int(n) == f { n } else { fail(BadValue, at) },
    None -> fail(BadValue, at),
  }
}

type Token = { text: Bytes, next: Int }

fn token(line: Bytes, from: Int) -> Token / {abort.raise} = {
  let start = line.skip(from, b" ");
  let stop = line.scan_until(start, b" ", max(line.len() - start, 0));
  { text: line.slice(min(start, line.len()), min(stop, line.len())), next: stop }
}

type SampleRead = {
  name: String,
  labels: Labels,
  le: Option<Float>,
  value: Bytes,
  exemplar: Option<Exemplar>,
}

fn sample_of(line: Bytes, at: Int) -> SampleRead / {prometheus.fail, abort.raise} = {
  let stop = line.skip(0, name_bytes());
  let named = String::of_bytes(line.slice(0, stop));
  if name(named) == None { fail(BadName, at) } else {
    let read_labels = if stop < line.len() && line.at(stop) == b'{' { labels_read(line, stop, at) }
    else {
      let none: LabelsRead = { pairs: [], le: None, next: stop };
      none
    };
    let value = token(line, read_labels.next);
    if value.text.len() == 0 { fail(BadValue, at) } else {
      {
        name: named,
        labels: labels(read_labels.pairs),
        le: read_labels.le,
        value: value.text,
        exemplar: exemplar_of(line, value.next, at),
      }
    }
  }
}

fn exemplar_of(
  line: Bytes,
  from: Int,
  at: Int,
) -> Option<Exemplar> / {prometheus.fail, abort.raise} =
  match line.index_of_from(b" # {", min(from, line.len())) {
    None -> None,
    Some(hash) -> {
      let read_labels = labels_read(line, hash + 3, at);
      let value = token(line, read_labels.next);
      let made: Exemplar = { labels: labels(read_labels.pairs), value: number_of(value.text, at) };
      Some(made)
    },
  }

fn base_of(named: String, suffix: String) -> Option<String> =
  if named.ends_with(suffix) && named.len() > suffix.len() {
    match try[abort.raise] { named.slice(0, named.len() - suffix.len()) } {
      Ok(base) -> Some(base),
      Err(_) -> None,
    }
  } else { None }

fn of_kind(r: ParseState, key: Option<String>, kind: Kind) -> Option<Draft> =
  match key {
    Some(k) -> match r.drafts.get(k) {
      Some(d) -> if d.kind == kind { Some(d) } else { None },
      None -> None,
    },
    None -> None,
  }

fn stored(r: ParseState, d: Draft, ls: Labels, step: (Option<Value>) -> Value) -> ParseState = {
  let before = d.series.get(ls);
  {
    ..r,
    drafts: r.drafts.insert(d.name, {
      ..d,
      order: if before == None { d.order.push(ls) } else { d.order },
      series: d.series.insert(ls, step(before)),
    }),
  }
}

fn sample_read(r: ParseState, line: Bytes, at: Int) -> ParseState / {prometheus.fail, abort.raise} = {
  let s = sample_of(line, at);
  match ((
      of_kind(r, base_of(s.name, "_total"), Counter),
      of_kind(r, base_of(s.name, "_bucket"), Histogram),
      of_kind(r, base_of(s.name, "_sum"), Histogram),
    )) {
    (Some(d), _, _) -> {
      let total = number_of(s.value, at);
      stored(r, d, s.labels, |_: Option<Value>| CounterValue(total, s.exemplar))
    },
    (_, Some(d), _) -> match s.le {
      None -> fail(Misplaced, at),
      Some(le) -> {
        let bucket: Bucket = { le: le, count: whole_of(s.value, at), exemplar: s.exemplar };
        stored(r, d, s.labels, |before: Option<Value>|
          match before {
            Some(HistogramValue(buckets, sum)) -> HistogramValue(buckets.push(bucket), sum),
            _ -> HistogramValue([bucket], 0.0),
          })
      },
    },
    (_, _, Some(d)) -> {
      let sum = number_of(s.value, at);
      stored(r, d, s.labels, |before: Option<Value>|
        match before {
          Some(HistogramValue(buckets, _)) -> HistogramValue(buckets, sum),
          _ -> HistogramValue([], sum),
        })
    },
    _ -> passed_or_level(r, s, at),
  }
}

fn passed_or_level(
  r: ParseState,
  s: SampleRead,
  at: Int,
) -> ParseState / {prometheus.fail, abort.raise} =
  match of_kind(r, base_of(s.name, "_count"), Histogram) {
    Some(_) -> r,
    None -> match base_of(s.name, "_created") {
      Some(base) -> if r.drafts.contains(base) { r } else { read_gauge(r, s, at) },
      None -> read_gauge(r, s, at),
    },
  }

fn read_gauge(
  r: ParseState,
  s: SampleRead,
  at: Int,
) -> ParseState / {prometheus.fail, abort.raise} = {
  let known = ensure_draft(r, s.name, Untyped);
  let level = number_of(s.value, at);
  match known.drafts.get(s.name) {
    Some(d) -> match d.kind {
      Gauge | Untyped -> stored(known, d, s.labels, |_: Option<Value>| GaugeValue(level)),
      _ -> fail(Misplaced, at),
    },
    None -> known,
  }
}

fn field_text(f: trace::Field) -> String =
  match f {
    trace::IntField(n) -> n.to_string(),
    trace::BoolField(b) -> if b { "true" } else { "false" },
    trace::StringField(s) -> s,
    trace::FloatField(x) -> number(x, false),
    trace::DecimalField(d) -> d.to_string(),
    trace::BytesField(b) -> match try[abort.raise] { b.hex_of() } {
      Ok(text) -> text,
      Err(_) -> "",
    },
    trace::JsonField(j) -> match try[abort.raise] { json::to_string(j) } {
      Ok(text) -> text,
      Err(_) -> "",
    },
  }

/// Returns the name of the label that records which channel a metric was recorded on.
pub fn channel_label() -> Label = Label("channel")

fn labels_of(channel: String, fields: Fields) -> Labels =
  labels(
    fields.entries().fold(
      [pair(channel_label(), channel)],
      |accumulator: List<Pair>, e: { key: String, value: trace::Field }|
        if e.key == telemetry::trace_id_field() || e.key == telemetry::span_id_field() {
          accumulator
        } else { accumulator.push(pair(sanitized_label(e.key), field_text(e.value))) },
    ),
  )

fn exemplar_in(fields: Fields, value: Float) -> Option<Exemplar> =
  match ((fields.get(telemetry::trace_id_field()), fields.get(telemetry::span_id_field()))) {
    (Some(trace::StringField(trace_hex)), Some(trace::StringField(span_hex))) ->
      Some({
        labels: labels([pair(Label("trace_id"), trace_hex), pair(Label("span_id"), span_hex)]),
        value: value,
      }),
    _ -> None,
  }

/// Records a `trace.count` in the counter named `sanitized_name(name)`.
pub fn record_count(
  r: Registry,
  channel: String,
  name: String,
  delta: Int,
  fields: Fields,
) -> Registry =
  add_with(
    r,
    sanitized_name(name),
    labels_of(channel, fields),
    Float::of_int(delta),
    exemplar_in(fields, Float::of_int(delta)),
  )

/// Records a `trace.gauge` in the gauge named `sanitized_name(name)`.
pub fn record_gauge(
  r: Registry,
  channel: String,
  name: String,
  value: Decimal,
  fields: Fields,
) -> Registry = set(r, sanitized_name(name), labels_of(channel, fields), Float::of_decimal(value))

/// Records a `trace.time`, in seconds, in the histogram named `sanitized_name(name)` followed by
/// `_seconds`, which is its unit.
pub fn record_time(
  r: Registry,
  channel: String,
  name: String,
  micros: Int,
  fields: Fields,
) -> Registry = {
  let named = sanitized_name(name ++ "_seconds");
  let seconds = Float::of_int(micros) / 1000000.0;
  let known = match r.families.get(name_text(named)) {
    Some(_) -> r,
    None -> describe(r, named, Histogram, "", "seconds"),
  };
  observe_with(known, named, labels_of(channel, fields), seconds, exemplar_in(fields, seconds))
}

/// Runs `body` and records every `trace.count`, `trace.gauge` and `trace.time` it performs, on any
/// channel, into a registry that starts as `start`. Other `trace` operations are not handled here
/// and continue to the next enclosing handler, such as a span exporter. The `prometheus.registry`
/// operation returns the current registry, which `scrape` serves.
pub fn recording<a | e>(
  start: Registry,
  body: () -> a / {trace.count[*], trace.gauge[*], trace.time[*], prometheus.registry | e},
) -> a / e =
  handle {
    body()
  } with {
    var registry = start,
    trace.count[*c](name, delta, fields) -> {
      registry = record_count(registry, c, name, delta, fields);
    },
    trace.gauge[*c](name, value, fields) -> {
      registry = record_gauge(registry, c, name, value, fields);
    },
    trace.time[*c](name, micros, fields) -> {
      registry = record_time(registry, c, name, micros, fields);
    },
    prometheus.registry() -> registry,
  }

/// Whether an `Accept` field prefers OpenMetrics to the text format: whichever of
/// `application/openmetrics-text` and `text/plain` has the higher `q`, or the text format when
/// they tie or neither is listed.
pub fn prefers_openmetrics(accept: String) -> Bool = {
  let weights = string_split_whole(accept, ",").fold(
    { open: -1.0, text: -1.0 },
    |best: { open: Float, text: Float }, range_text: String| {
      let parts = string_split_whole(range_text, ";").map(|part: String|
        part.ascii_trim().ascii_lower());
      let q = parts.fold(1.0, |weight: Float, part: String|
        if part.starts_with("q=") {
          match Float::of_string(replaced(part, "q=", "")) {
            Some(weight) -> weight,
            None -> weight,
          }
        } else { weight });
      match parts {
        ["application/openmetrics-text", ..] -> { open: max_float(best.open, q), text: best.text },
        ["text/plain", ..] -> { open: best.open, text: max_float(best.text, q) },
        _ -> best,
      }
    },
  );
  weights.open > 0.0 && weights.open > weights.text
}

fn max_float(a: Float, b: Float) -> Float = if b > a { b } else { a }

/// The response to a scrape of `s`, in the format the request's `Accept` prefers.
pub fn page<| e>(request: Request, s: Snapshot) -> Response<| e> = {
  let openmetrics = http::header_lines(request.headers, "accept").fold(
    false,
    |any_open: Bool, line: String| any_open || prefers_openmetrics(line),
  );
  {
    status: 200,
    headers: http::set_header(http::empty_headers(), "content-type", if openmetrics {
      openmetrics_content_type()
    } else { text_content_type() }),
    body: http::Whole(if openmetrics { render_openmetrics(s) } else { render_text(s) }),
  }
}

/// Returns the response to a scrape request. For a `GET` or `HEAD` of `/metrics`, the response
/// contains the current registry of the enclosing `recording`, written by `page`. For any other
/// request it returns `None`, so the caller must handle the request itself.
pub fn scrape<| e>(request: Request) -> Option<Response<| e>> / {prometheus.registry} =
  match ((request.method, request.path)) {
    (http::Get, "/metrics") -> Some(page(request, snapshot(prometheus.registry()))),
    (http::Head, "/metrics") -> Some(page(request, snapshot(prometheus.registry()))),
    _ -> None,
  }

type Step = { kind: Int, metric: Int, label_set_index: Int, value: Int, marked: Bool }

fn steps() -> Gen<Step> =
  gen::and_then(gen::list_of_length(gen::below(8), 4), |draws: List<Int>|
    gen::map(gen::bool(), |marked: Bool| -> Step {
      {
        kind: draws.at_or(0, 0) % 3,
        metric: draws.at_or(1, 0) % 2,
        label_set_index: draws.at_or(2, 0) % 5,
        value: draws.at_or(3, 0),
        marked: marked,
      }
    }))

fn named(text: String) -> Name = sanitized_name(text)

fn label_sets() -> List<Labels> =
  [
    no_labels(),
    labels([pair(sanitized_label("sku"), "BOLT-1")]),
    labels([pair(sanitized_label("sku"), "a\"b\\c\nd"), pair(sanitized_label("zone"), "eu")]),
    labels([pair(sanitized_label("zone"), "us")]),
    labels([pair(sanitized_label("sku"), "\u{e9}t\u{e9} \\n")]),
  ]

fn values() -> List<Float> = [0.0, 1.0, 2.5, 0.1, 1e300, 7.0, 0.004, 12.0]

fn sample_exemplar(value: Float) -> Exemplar =
  {
    labels: labels([
      pair(sanitized_label("trace_id"), "4bf92f3577b34da6a3ce929d0e0e4736"),
      pair(sanitized_label("span_id"), "00f067aa0ba902b7"),
    ]),
    value: value,
  }

fn described() -> Registry =
  describe(
    describe(
      describe(
        registry(3),
        named("orders"),
        Counter,
        "Orders \"placed\", by sku.\nA \\ is a backslash.",
        "",
      ),
      named("request_duration_seconds"),
      Histogram,
      "How long a request took.",
      "seconds",
    ),
    named("shelf_level"),
    Gauge,
    "",
    "",
  )

fn applied(r: Registry, s: Step) -> Registry = {
  let ls = match label_sets().at(s.label_set_index) {
    Some(label_set) -> label_set,
    None -> no_labels(),
  };
  let value = match values().at(s.value) { Some(v) -> v, None -> 0.0 };
  let seen = if s.marked { Some(sample_exemplar(value)) } else { None };
  if s.kind == 0 {
    add_with(r, named(if s.metric == 0 { "orders" } else { "http_requests" }), ls, value, seen)
  } else if s.kind == 1 {
    set(r, named(if s.metric == 0 { "shelf_level" } else { "queue:depth" }), ls, if s.value == 7 {
      Float::neg_infinity()
    } else if s.value == 6 { Float::infinity() }
    else { value - 3.5 })
  } else {
    observe_with(
      r,
      named(if s.metric == 0 { "request_duration_seconds" } else { "payload_bytes" }),
      ls,
      value,
      seen,
    )
  }
}

fn registries() -> Gen<Registry> =
  gen::map(gen::list_of(steps(), 14), |script: List<Step>| script.fold(described(), applied))

test "a snapshot reads back from OpenMetrics" {
  gen::check(registries(), |r: Registry| {
    parse(render_openmetrics(snapshot(r)), default_limits()) == Ok(snapshot(r))
  })
}

test "a registry stores no more series per metric than its limit, and counts every series it discards" {
  gen::check(registries(), |r: Registry| {
    snapshot(r).families.all(|f: Family| f.series.len() <= 3) && dropped(r) >= 0
  })
}

fn sample_registry() -> Registry = {
  let bolt = labels([pair(sanitized_label("sku"), "BOLT-1")]);
  let odd = labels([pair(sanitized_label("sku"), "a\"b\\c\nd")]);
  let record_count = add(
    add_with(
      add(described(), named("orders"), bolt, 2.0),
      named("orders"),
      bolt,
      1.0,
      Some(sample_exemplar(1.0)),
    ),
    named("orders_total"),
    odd,
    4.0,
  );
  let record_gauge = set(record_count, named("shelf_level"), no_labels(), 41.75);
  let bounded = with_bounds(record_gauge, named("request_duration_seconds"), [0.1, 1.0]);
  observe(
    observe_with(
      observe(bounded, named("request_duration_seconds"), bolt, 0.05),
      named("request_duration_seconds"),
      bolt,
      0.5,
      Some(sample_exemplar(0.5)),
    ),
    named("request_duration_seconds"),
    bolt,
    30.0,
  )
}

fn text_page() -> String =
  \\# HELP orders_total Orders "placed", by sku.\nA \\ is a backslash.
  \\# TYPE orders_total counter
  \\orders_total{sku="BOLT-1"} 3
  \\orders_total{sku="a\"b\\c\nd"} 4
  \\# HELP request_duration_seconds How long a request took.
  \\# TYPE request_duration_seconds histogram
  \\request_duration_seconds_bucket{sku="BOLT-1",le="0.1"} 1
  \\request_duration_seconds_bucket{sku="BOLT-1",le="1"} 2
  \\request_duration_seconds_bucket{sku="BOLT-1",le="+Inf"} 3
  \\request_duration_seconds_sum{sku="BOLT-1"} 30.55
  \\request_duration_seconds_count{sku="BOLT-1"} 3
  \\# TYPE shelf_level gauge
  \\shelf_level 41.75
  \\

fn open_page() -> String =
  \\# HELP orders Orders \"placed\", by sku.\nA \\ is a backslash.
  \\# TYPE orders counter
  \\orders_total{sku="BOLT-1"} 3.0 # {span_id="00f067aa0ba902b7",trace_id="4bf92f3577b34da6a3ce929d0e0e4736"} 1.0
  \\orders_total{sku="a\"b\\c\nd"} 4.0
  \\# HELP request_duration_seconds How long a request took.
  \\# TYPE request_duration_seconds histogram
  \\# UNIT request_duration_seconds seconds
  \\request_duration_seconds_bucket{sku="BOLT-1",le="0.1"} 1
  \\request_duration_seconds_bucket{sku="BOLT-1",le="1.0"} 2 # {span_id="00f067aa0ba902b7",trace_id="4bf92f3577b34da6a3ce929d0e0e4736"} 0.5
  \\request_duration_seconds_bucket{sku="BOLT-1",le="+Inf"} 3
  \\request_duration_seconds_sum{sku="BOLT-1"} 30.55
  \\request_duration_seconds_count{sku="BOLT-1"} 3
  \\# TYPE shelf_level gauge
  \\shelf_level 41.75
  \\# EOF
  \\

test "`render_text` writes HELP and TYPE lines, `_total` counters, cumulative histogram buckets and escaped text" {
  assert_eq(String::of_bytes(render_text(snapshot(sample_registry()))), text_page())
}

test "`render_openmetrics` names counter families without `_total` and writes units, exemplars and a final `# EOF`" {
  assert_eq(String::of_bytes(render_openmetrics(snapshot(sample_registry()))), open_page())
}

test "two registries given the same updates in different orders render the same page" {
  let a = labels([pair(sanitized_label("zone"), "eu"), pair(sanitized_label("sku"), "x")]);
  let b = labels([pair(sanitized_label("sku"), "x"), pair(sanitized_label("zone"), "us")]);
  let one = set(
    add(add(registry(10), named("orders"), a, 1.0), named("orders"), b, 2.0),
    named("level"),
    a,
    5.0,
  );
  let other = add(
    add(set(registry(10), named("level"), a, 5.0), named("orders"), b, 2.0),
    named("orders"),
    a,
    1.0,
  );
  assert_eq(render_text(snapshot(one)), render_text(snapshot(other)));
  assert_eq(render_openmetrics(snapshot(one)), render_openmetrics(snapshot(other)));
  assert(
    String::of_bytes(render_text(snapshot(one))).contains(
      "orders_total{sku=\"x\",zone=\"eu\"} 1\n",
    ),
  )
}

type Named = { text: String, metric: Bool, label: Bool, like: String }

fn name_cases() -> List<Named> =
  [
    { text: "orders", metric: true, label: true, like: "orders" },
    { text: "http_requests:rate5m", metric: true, label: false, like: "http_requests:rate5m" },
    { text: "_x9", metric: true, label: true, like: "_x9" },
    { text: "__name__", metric: true, label: false, like: "__name__" },
    { text: "9lives", metric: false, label: false, like: "_9lives" },
    { text: "orders placed", metric: false, label: false, like: "orders_placed" },
    { text: "http.server.duration", metric: false, label: false, like: "http_server_duration" },
    { text: "", metric: false, label: false, like: "_" },
    { text: "caf\u{e9}", metric: false, label: false, like: "caf__" },
  ]

test "`name` and `label` accept the text `{c.text}` only if it is valid, and sanitizing that text gives a valid name and a valid label" for c: Named in name_cases(
  ) {
  assert_eq(name(c.text) != None, c.metric);
  assert_eq(label(c.text) != None, c.label);
  assert_eq(name_text(sanitized_name(c.text)), c.like);
  assert(name(name_text(sanitized_name(c.text))) != None);
  assert(label(label_text(sanitized_label(c.text))) != None)
}

test "a metric stores label sets up to the registry's limit and counts each extra one it drops" {
  let filled = ["a", "b", "c", "d", "a", "e"].fold(registry(3), |r: Registry, sku: String|
    add(r, named("orders"), labels([pair(sanitized_label("sku"), sku)]), 1.0));
  assert_eq(dropped(filled), 2);
  match snapshot(filled).families {
    [orders] ->
      assert_eq(orders.series.map(|s: Series| s.value), [
        CounterValue(2.0, None),
        CounterValue(1.0, None),
        CounterValue(1.0, None),
      ]),
    _ -> panic("expected one family"),
  }
}

test "an update that does not fit its metric is rejected and counted" {
  let r = add(registry(3), named("orders"), no_labels(), 1.0);
  let after = with_bounds(
    describe(
      observe(
        add(
          add(set(r, named("orders"), no_labels(), 5.0), named("orders"), no_labels(), -1.0),
          named("orders"),
          no_labels(),
          Float::of_bits(0x7FF8_0000_0000_0000),
        ),
        named("orders"),
        no_labels(),
        1.0,
      ),
      named("wait"),
      Histogram,
      "",
      "seconds",
    ),
    named("orders"),
    [1.0],
  );
  assert_eq(rejected(after), 6);
  assert_eq(snapshot(after), snapshot(r));
  assert_eq(snapshot(set(r, named("orders_total"), no_labels(), 1.0)).families.len(), 2)
}

type Rejected = { name: String, page: String, reason: ErrorKind, line: Int }

fn rejected_pages() -> List<Rejected> =
  [
    { name: "a line that opens with no name", page: "{a=\"b\"} 1\n", reason: BadName, line: 1 },
    { name: "a sample with no value", page: "orders\n", reason: BadValue, line: 1 },
    { name: "a value that is not a number", page: "a 1\norders one\n", reason: BadValue, line: 2 },
    { name: "labels that never close", page: "orders{sku=\"x\" 1\n", reason: BadLabels, line: 1 },
    { name: "a label with no quotes", page: "orders{sku=x} 1\n", reason: BadLabels, line: 1 },
    {
      name: "a label name Prometheus reserves",
      page: "orders{__sku=\"x\"} 1\n",
      reason: BadLabels,
      line: 1,
    },
    {
      name: "an escape no format has",
      page: "orders{sku=\"a\\tb\"} 1\n",
      reason: BadEscape,
      line: 1,
    },
    { name: "a summary", page: "# TYPE wait summary\n", reason: Unsupported("summary"), line: 1 },
    { name: "a TYPE of no name", page: "# TYPE 9 counter\n", reason: BadComment, line: 1 },
    {
      name: "a bucket with no le",
      page: "# TYPE wait histogram\nwait_bucket 1\n",
      reason: Misplaced,
      line: 2,
    },
    {
      name: "a bucket count that is not whole",
      page: "# TYPE wait histogram\nwait_bucket{le=\"1\"} 1.5\n",
      reason: BadValue,
      line: 2,
    },
    { name: "a line after the end", page: "# EOF\norders 1\n", reason: AfterEnd, line: 2 },
  ]

test "`parse` rejects the malformed page described as `{c.name}` with the expected reason and line number" for c: Rejected in rejected_pages(
  ) {
  assert_eq(
    parse(Bytes::of_string(c.page), default_limits()),
    Err({ reason: c.reason, line: c.line }),
  )
}

test "a page past its limits is rejected" {
  let page = Bytes::of_string("a 1\nb 2\nc 3\n");
  assert_eq(parse(page, { length: 5, samples: 10 }), Err({ reason: TooLong, line: 0 }));
  assert_eq(parse(page, { length: 100, samples: 2 }), Err({ reason: TooMany, line: 3 }));
  assert_eq(parse(b"a \xff\n", default_limits()), Err({ reason: NotText, line: 0 }))
}

test "`parse` accepts what other writers produce: timestamps, `_created` samples, comments, CRLF line ends and samples with no TYPE line" {
  let page =
    \\# A comment.
    \\# TYPE orders_total counter
    \\# HELP orders_total Orders.
    \\orders_total{sku="x",} 3 1712000000000
    \\orders_created{sku="x"} 1.7e+09
    \\# TYPE wait histogram
    \\wait_bucket{le="1"} 1
    \\wait_bucket{le="+Inf"} 2
    \\wait_count 2
    \\wait_sum 1.5
    \\wait_created 1.7e+09
    \\loose{a="b"} +Inf
    \\
  ;
  let crlf = Bytes::of_string(replaced(page, "\n", "\r\n"));
  let want: Snapshot = {
    families: [
      {
        name: named("orders"),
        help: "Orders.",
        unit: "",
        kind: Counter,
        series: [
          { labels: labels([pair(sanitized_label("sku"), "x")]), value: CounterValue(3.0, None) },
        ],
      },
      {
        name: named("wait"),
        help: "",
        unit: "",
        kind: Histogram,
        series: [
          {
            labels: no_labels(),
            value: HistogramValue(
              [
                { le: 1.0, count: 1, exemplar: None },
                { le: Float::infinity(), count: 2, exemplar: None },
              ],
              1.5,
            ),
          },
        ],
      },
      {
        name: named("loose"),
        help: "",
        unit: "",
        kind: Untyped,
        series: [
          {
            labels: labels([pair(sanitized_label("a"), "b")]),
            value: GaugeValue(Float::infinity()),
          },
        ],
      },
    ],
  };
  assert_eq(parse(Bytes::of_string(page), default_limits()), Ok(want));
  assert_eq(parse(crlf, default_limits()), Ok(want))
}

fn traced<[c]>() -> Unit / {trace.count[c], trace.gauge[c], trace.time[c]} = {
  trace.count[c](
    "orders placed",
    2,
    #{
      "sku": trace::StringField("BOLT-1"),
      "trace_id": trace::StringField("4bf92f3577b34da6a3ce929d0e0e4736"),
      "span_id": trace::StringField("00f067aa0ba902b7"),
    },
  );
  trace.count[c]("orders placed", 1, #{"sku": trace::StringField("BOLT-1")});
  trace.gauge[c]("shelf", 41.75m, #{"aisle": trace::IntField(7)});
  trace.time[c]("checkout", 7000, Map::new())
}

fn scraped(accept: Option<String>, path: String) -> Option<Response<| {}>> / {abort.raise} = {
  let request = http::request_to(http::Get, "shop.example", path, b"");
  let scrape_request = match accept {
    Some(a) -> { ..request, headers: http::set_header(request.headers, "accept", a) },
    None -> request,
  };
  recording(registry(100), || {
    traced[orders]();
    scrape(scrape_request)
  })
}

test "a trace's counts, gauges and timings are scraped as a page, in the format the scrape prefers" {
  let text = match scraped(None, "/metrics") {
    Some(response) -> response,
    None -> panic("no page"),
  };
  assert_eq(http::header(text.headers, "content-type"), Some(text_content_type()));
  assert_eq(
    String::of_bytes(http::whole_bytes(text.body)),
    "# TYPE checkout_seconds histogram\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"0.005\"} 0\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"0.01\"} 1\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"0.025\"} 1\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"0.05\"} 1\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"0.075\"} 1\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"0.1\"} 1\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"0.25\"} 1\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"0.5\"} 1\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"0.75\"} 1\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"1\"} 1\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"2.5\"} 1\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"5\"} 1\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"7.5\"} 1\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"10\"} 1\n"
      ++ "checkout_seconds_bucket{channel=\"orders\",le=\"+Inf\"} 1\n"
      ++ "checkout_seconds_sum{channel=\"orders\"} 0.007\n"
      ++ "checkout_seconds_count{channel=\"orders\"} 1\n"
      ++ "# TYPE orders_placed_total counter\n"
      ++ "orders_placed_total{channel=\"orders\",sku=\"BOLT-1\"} 3\n"
      ++ "# TYPE shelf gauge\n"
      ++ "shelf{aisle=\"7\",channel=\"orders\"} 41.75\n",
  );
  let openmetrics = match scraped(
      Some(
        "application/openmetrics-text;version=1.0.0;q=0.5,text/plain;version=0.0.4;q=0.3,*/*;q=0.2",
      ),
      "/metrics",
    ) {
    Some(response) -> response,
    None -> panic("no page"),
  };
  assert_eq(http::header(openmetrics.headers, "content-type"), Some(openmetrics_content_type()));
  let page = String::of_bytes(http::whole_bytes(openmetrics.body));
  assert(page.contains("# UNIT checkout_seconds seconds\n"));
  assert(
    page.contains(
      "orders_placed_total{channel=\"orders\",sku=\"BOLT-1\"} 3.0 # {span_id=\"00f067aa0ba902b7\",trace_id=\"4bf92f3577b34da6a3ce929d0e0e4736\"} 2.0\n",
    ),
  );
  assert(page.ends_with("# EOF\n"));
  assert_eq(scraped(None, "/orders"), None)
}

type Accepting = { accept: String, open: Bool }

fn accepts() -> List<Accepting> =
  [
    { accept: "", open: false },
    { accept: "*/*", open: false },
    { accept: "text/plain;version=0.0.4", open: false },
    { accept: "application/openmetrics-text; version=1.0.0; charset=utf-8", open: true },
    { accept: "Application/OpenMetrics-Text", open: true },
    { accept: "text/plain;q=0.9, application/openmetrics-text;q=0.5", open: false },
    { accept: "text/plain;q=0.5, application/openmetrics-text;q=0.9", open: true },
    { accept: "application/openmetrics-text;q=0", open: false },
    { accept: "application/openmetrics-text, text/plain", open: false },
  ]

test "an Accept of `{c.accept}` gets OpenMetrics, or the text format" for c: Accepting in accepts(
  ) { assert_eq(prefers_openmetrics(c.accept), c.open) }

type Written = { value: String, text: String, openmetrics: String }

fn written_numbers() -> List<Written> =
  [
    { value: "0.0", text: "0", openmetrics: "0.0" },
    { value: "1.0", text: "1", openmetrics: "1.0" },
    { value: "-1.0", text: "-1", openmetrics: "-1.0" },
    { value: "0.005", text: "0.005", openmetrics: "0.005" },
    { value: "0.0001", text: "0.0001", openmetrics: "0.0001" },
    { value: "0.00001", text: "1e-05", openmetrics: "1e-05" },
    { value: "0.000025551", text: "2.5551e-05", openmetrics: "2.5551e-05" },
    { value: "100000.0", text: "100000", openmetrics: "100000.0" },
    { value: "1000000.0", text: "1e+06", openmetrics: "1e+06" },
    { value: "4473520.0", text: "4.47352e+06", openmetrics: "4.47352e+06" },
    { value: "1594239123.45", text: "1.59423912345e+09", openmetrics: "1.59423912345e+09" },
    { value: "41.75", text: "41.75", openmetrics: "41.75" },
    { value: "1e300", text: "1e+300", openmetrics: "1e+300" },
    { value: "5e-324", text: "5e-324", openmetrics: "5e-324" },
    { value: "-2.5", text: "-2.5", openmetrics: "-2.5" },
    { value: "123456.789", text: "123456.789", openmetrics: "123456.789" },
  ]

test "a number is written as Prometheus writes {c.text}" for c: Written in written_numbers() {
  let value = match Float::of_string(c.value) { Some(f) -> f, None -> panic("a number") };
  assert_eq(number(value, false), c.text);
  assert_eq(number(value, true), c.openmetrics);
  assert_eq(try { number_of(Bytes::of_string(c.text), 1) }, Ok(value))
}
