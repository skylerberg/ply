//! Structured tasks: deadlines, races, gathers, retries and limits over the language's `task`.
//!
//! Every function here that starts tasks ends them before it returns. It starts them in the
//! `acquire` step of a `bracket`, and the `release` step of that `bracket` cancels and awaits each
//! one. (`bracket` runs a body between an `acquire` and a `release`, and runs `release` however the
//! body ends.) So when a function that runs a body, such as `until` or `scoped`, returns, raises or
//! is cancelled, every task it started has stopped and has run its own releases.
//!
//! A body passed to such a function runs as a task of its own. A raise in the body ends that task
//! and does not reach the caller, so a body that can fail returns a `Result`.
//!
//! A deadline is an instant. `until` and `timeout` stop a body at that instant by cancelling its
//! task. They report the instant through `deadline.at`, so the code inside, and every task started
//! there, can read how much time it has. Nested deadlines take the earlier instant: an inner
//! deadline later than the outer one has no effect. `unbounded` runs a body with no deadline.
//!
//! Retrying, breaking a circuit, limiting a rate and keeping a retry budget are each a value plus
//! pure functions that compute its next state from the current clock reading. The caller stores the
//! value, in a handler's variable or elsewhere. Nothing here is global.
//!
//! A function that updates such a value while it runs a body (`guarded`, `throttled`,
//! `retry_budgeted`) takes `load` and `store`. `load` reads the caller's value and `store` writes a
//! new one. If the value lives in a handler's variable, `load` and `store` are effect operations,
//! and the handler's clauses implement them. Each read and write happens with no other task able to
//! run in between, so tasks sharing one value see each update as a whole.
//!
//! `single_flight` stores its in-progress runs in a channel that its callers share.
//! `runs_in_progress` creates that channel in the scheduler the callers run in.
//!
//! Jitter is drawn from `std.random`'s `entropy`, so a run that supplies `entropy` from a seed
//! waits for durations that the seed determines.
//!
//! Under `simulate`, every wait here is virtual time and every interleaving of the tasks these
//! functions start is searched. Outside `simulate`, the same waits use the run's clock, and a task
//! that waits is parked alone while the others run.

import std.list
import std.math (rem_euclid)
import std.random
import std.time (after, as_nanos, between, millis, nanos_at)
import std.gen

/// Starts a task for each of `bodies`, passes the tasks to `inside`, and returns its result. Every
/// task has ended when this returns, however it returns. If `inside` returns or raises, or the
/// caller is cancelled, the tasks still running are cancelled and awaited until they release what
/// they hold.
pub fn scoped<a, b | e>(
  bodies: List<() -> a / e>,
  inside: (List<Task<a>>) -> b / {task.write, abort.raise | e},
) -> b / {task.write, abort.raise | e} =
  bracket(|| bodies.map(|body: () -> a / e| task.spawn(body)), cancel_and_await, inside)

fn cancel_and_await<a>(kids: List<Task<a>>) -> Unit / {task.write} = {
  kids.fold((), |_u: Unit, kid: Task<a>| {
    task.cancel(kid);
    ()
  });
  kids.fold((), |_u: Unit, kid: Task<a>| {
    task.await(kid);
    ()
  })
}

fn fold_as_completed<a, s | e>(
  bodies: List<() -> a / e>,
  init: s,
  step: (s, Int, a) -> Iter<s, s>,
) -> s / {task.write, abort.raise | e} = {
  let n = bodies.len();
  if n == 0 { init } else {
    let ended = task.channel(n);
    let racers = range(0, n).map(|i: Int|
      || {
        task.send(ended, (i, bodies.get(i)()));
        ()
      });
    scoped(racers, |_kids: List<Task<Unit>>|
      iterate({ state: init, output_lines: 0 }, n + 1, |so_far: { state: s, output_lines: Int }|
        if so_far.output_lines == n { Stop(so_far.state) } else {
          match task.recv(ended) {
            None -> Stop(so_far.state),
            Some(result) -> match step(so_far.state, result._0, result._1) {
              Continue(next) -> Continue({ state: next, output_lines: so_far.output_lines + 1 }),
              Stop(last) -> Stop(last),
            },
          }
        }))
  }
}

/// Runs all of `bodies` at once, and returns their results in their order.
pub fn all<a | e>(bodies: List<() -> a / e>) -> List<a> / {task.write, abort.raise | e} =
  scoped(bodies, |kids: List<Task<a>>| kids.map(|kid: Task<a>| task.join(kid)))

/// Returns the results of all `bodies` in their order, or the first failure. The bodies still
/// running when one fails are cancelled, and have ended when this returns.
pub fn all_ok<a, x | e>(
  bodies: List<() -> Result<a, x> / e>,
) -> Result<List<a>, x> / {task.write, abort.raise | e} =
  match fold_as_completed(
      bodies,
      Ok(Map::new()),
      |so_far: Result<Map<Int, a>, x>, i: Int, r: Result<a, x>|
        match ((so_far, r)) {
          (Ok(results), Ok(result)) -> Continue(Ok(results.insert(i, result))),
          (_, Err(failure)) -> Stop(Err(failure)),
          (Err(failure), _) -> Stop(Err(failure)),
        },
    ) {
    Ok(results) -> Ok(results.values()),
    Err(failure) -> Err(failure),
  }

/// Returns the first success among `bodies` and cancels the others, or returns every failure in
/// their order.
pub fn first_ok<a, x | e>(
  bodies: List<() -> Result<a, x> / e>,
) -> Result<a, List<x>> / {task.write, abort.raise | e} =
  match fold_as_completed(
      bodies,
      Err(Map::new()),
      |so_far: Result<a, Map<Int, x>>, i: Int, r: Result<a, x>|
        match ((so_far, r)) {
          (_, Ok(result)) -> Stop(Ok(result)),
          (Err(failures), Err(failure)) -> Continue(Err(failures.insert(i, failure))),
          (Ok(result), _) -> Stop(Ok(result)),
        },
    ) {
    Ok(result) -> Ok(result),
    Err(failures) -> Err(failures.values()),
  }

/// Returns the result of the first of `bodies` to end, or `None` for no bodies. The others are
/// cancelled, and have run their releases when this returns.
pub fn race<a | e>(bodies: List<() -> a / e>) -> Option<a> / {task.write, abort.raise | e} =
  fold_as_completed(bodies, None, |_none: Option<a>, _i: Int, result: a| Stop(Some(result)))

/// Applies `f` to each of `xs`, with at most `limit` running at once, and returns the results in
/// order. Raises for a `limit` below one.
pub fn map_concurrent<a, b | e>(
  xs: List<a>,
  limit: Int,
  f: keep (a) -> b / e,
) -> List<b> / {task.write, abort.raise | e} = {
  let n = xs.len();
  if limit < 1 {
    panic("`map_concurrent` runs at most `limit` at once, and this limit is below one")
  } else if n == 0 { [] } else {
    let jobs = task.channel(n);
    range(0, n).fold((), |_u: Unit, i: Int| {
      task.send(jobs, (i, xs.get(i)));
      ()
    });
    task.close(jobs);
    let worker = ||
      iterate([], n + 1, |done: List<(Int, b)>|
        match task.recv(jobs) {
          Some(job) -> Continue(done.push((job._0, f(job._1)))),
          None -> Stop(done),
        });
    let parts = all(range(0, min(limit, n)).map(|_i: Int| worker));
    parts.fold(Map::new(), |placed: Map<Int, b>, part: List<(Int, b)>|
      part.fold(placed, |m: Map<Int, b>, done: (Int, b)| m.insert(done._0, done._1))).values(
    )
  }
}

/// The instant the work around a call must end by.
pub effect deadline {
  /// Returns the earliest deadline that applies to the current call, or `None` if there is no
  /// deadline. `unbounded` removes any deadline for its body.
  read at() -> Option<Instant>
  /// The work did not end by `at`.
  raise passed(at: Instant)
}

/// How work under a deadline ended.
pub type Timed<a> =
  /// It returned in time.
  | Done(a)
  /// The deadline came first, and the work was stopped there.
  | TimedOut

/// Runs `body` with no deadline above it.
pub fn unbounded<a | e>(body: () -> a / {deadline.at | e}) -> a / e =
  handle { body() } with { deadline.at() -> None }

/// The earlier of two deadlines, where `None` means no deadline.
pub fn earliest(a: Option<Instant>, b: Option<Instant>) -> Option<Instant> =
  match ((a, b)) {
    (Some(x), Some(y)) -> if nanos_at(x) <= nanos_at(y) { a } else { b },
    (Some(_), None) -> a,
    (None, _) -> b,
  }

/// How long is left before the deadline around this call, or `None` if there is none. Never
/// below zero.
pub fn remaining() -> Option<Duration> / {deadline.at, clock.read} =
  match deadline.at() {
    None -> None,
    Some(at) -> {
      let left = between(clock.now(), at);
      Some(if as_nanos(left) < 0 { Duration(0) } else { left })
    },
  }

/// Waits until the clock reads `at`. For an instant that has passed, it does not wait.
pub fn sleep_until(at: Instant) -> Unit / {clock.read, clock.write} =
  clock.sleep(between(clock.now(), at))

/// Runs `body` as a task that is cancelled at `at`, and returns `Done` with its result, or
/// `TimedOut` if the task was cancelled. Inside `body`, and in every task started there,
/// `deadline.at` returns `at`, or the deadline already in effect around this call if that deadline
/// is no later than `at`. In that case the existing deadline cancels the whole call along with
/// `body`, so the caller sees a cancel and receives no return value. After `TimedOut`, the task has
/// run its releases and everything it started through this module has ended.
pub fn until<a | e>(
  at: Instant,
  body: keep () -> a / {deadline.at | e},
) -> Timed<a> / {task.write, clock.read, clock.write, deadline.at | e} = {
  let around = deadline.at();
  let bound = match earliest(Some(at), around) { Some(earlier) -> earlier, None -> at };
  let timed = match around { Some(outer) -> nanos_at(at) < nanos_at(outer), None -> true };
  let left = between(clock.now(), bound);
  bracket(
    || {
      let worker = task.spawn(|| handle { body() } with { deadline.at() -> Some(bound) });
      let timers = if timed {
        [
          task.spawn(|| {
            clock.sleep(left);
            task.cancel(worker);
            ()
          }),
        ]
      } else { [] };
      { worker: worker, timers: timers }
    },
    |running: { worker: Task<a>, timers: List<Task<Unit>> }| {
      cancel_and_await(running.timers);
      cancel_and_await([running.worker])
    },
    |running: { worker: Task<a>, timers: List<Task<Unit>> }|
      match task.await(running.worker) { Some(result) -> Done(result), None -> TimedOut },
  )
}

fn effective_deadline(at: Instant) -> Instant / {deadline.at} =
  match earliest(Some(at), deadline.at()) { Some(bound) -> bound, None -> at }

/// Runs `body` as `until` does, with the deadline `d` after the current time.
pub fn timeout<a | e>(
  d: Duration,
  body: keep () -> a / {deadline.at | e},
) -> Timed<a> / {task.write, clock.read, clock.write, deadline.at | e} =
  until(after(clock.now(), d), body)

/// Runs `body` as `until` does, and returns its result if it ends by `at`. If the body is
/// cancelled, raises `deadline.passed` with the deadline that applied, which is `at` or an earlier
/// outer deadline.
pub fn by<a | e>(
  at: Instant,
  body: keep () -> a / {deadline.at | e},
) -> a / {task.write, clock.read, clock.write, deadline.at, deadline.passed | e} = {
  let bound = effective_deadline(at);
  match until(bound, body) { Done(result) -> result, TimedOut -> deadline.passed(bound) }
}

/// Runs `body` as `by` does, with the deadline `d` after the current time.
pub fn within<a | e>(
  d: Duration,
  body: keep () -> a / {deadline.at | e},
) -> a / {task.write, clock.read, clock.write, deadline.at, deadline.passed | e} =
  by(after(clock.now(), d), body)

/// A counting semaphore: a fixed number of permits that tasks acquire and release. `semaphore`
/// creates one.
pub opaque type Semaphore<c> = | Semaphore(c)

/// A semaphore as `semaphore` creates it.
pub type Permits = Semaphore<Chan<Unit>>

/// A semaphore of `permits` permits. Raises for a count below zero.
pub fn semaphore(permits: Int) -> Permits / {task.write, abort.raise} = {
  let tokens = task.channel(permits);
  range(0, permits).fold((), |_u: Unit, _i: Int| {
    task.send(tokens, ());
    ()
  });
  Semaphore(tokens)
}

/// Waits for one of `sem`'s permits, then runs `body` while holding it and returns its result.
/// Waiting tasks receive permits in the order they began to wait. The permit is returned exactly
/// once however `body` ends, including by a cancel. A task cancelled while it waits never receives
/// a permit.
pub fn with_permit<a | e>(sem: Permits, body: () -> a / e) -> a / {task.write | e} =
  match sem {
    Semaphore(tokens) -> with_scope[permit](
      task.recv(tokens),
      |_held: Option<Unit>| {
        task.send(tokens, ());
        ()
      },
    ) { _permit -> body() },
  }

/// Runs `body` while holding one of `sem`'s permits, and returns `Some` of its result. Returns
/// `None` without running it when no permit is free now.
pub fn try_with_permit<a | e>(sem: Permits, body: () -> a / e) -> Option<a> / {task.write | e} =
  match sem {
    Semaphore(tokens) -> with_scope[permit](
      task.select([(tokens, None)], false),
      |selection: Option<(Int, Option<Unit>)>|
        match selection {
          Some(_) -> {
            task.send(tokens, ());
            ()
          },
          None -> (),
        },
    ) { permit -> match permit.get() { Some(_) -> Some(body()), None -> None } },
  }

/// How the wait before another attempt is spread, with the names the AWS Architecture Blog's
/// "Exponential Backoff And Jitter" uses. The ceiling after `n` failures is
/// `min(cap, base * 2^(n-1))`.
pub type Jitter =
  /// Waits exactly the ceiling: the longest wait allowed after this many failures, which is `base`
  /// doubled for each failure after the first, and no more than `cap`.
  | NoJitter
  /// Anywhere from nothing to the ceiling.
  | FullJitter
  /// Waits half the ceiling (the longest wait allowed after this many failures, which is `base`
  /// doubled for each failure after the first, and no more than `cap`) plus a random amount from
  /// nothing up to the other half of the ceiling.
  | EqualJitter
  /// Anywhere from `base` to three times the wait before, and no more than `cap`.
  | DecorrelatedJitter

/// How `retry` tries again. Every field is the caller's to choose: there is no default.
pub type Retry<x> = new {
  /// How many times the body may run in all; at least one.
  attempts: Int,
  /// The wait after the first failure, before jitter.
  base: Duration,
  /// The longest wait.
  cap: Duration,
  jitter: Jitter,
  /// Whether another attempt may follow this failure.
  retryable: (x) -> Bool,
  /// How long the attempts and the waits between them may take in all, limited by the deadline
  /// around the call if that is earlier. `None` leaves only that deadline.
  within: Option<Duration>,
}

/// Why `retry` stopped at a failure.
pub type Reason =
  /// The body ran `attempts` times.
  | Spent
  /// `retryable` returned `false`.
  | NotRetryable
  /// The wait before another attempt would have ended at or past the deadline.
  | OutOfTime
  /// The retry budget had no retry to give.
  | OverBudget

/// The failure `retry` stopped at, how many times the body had run, and why it ran no more.
pub type RetryFailure<x> = new { last: x, attempts: Int, reason: Reason }

/// The longest the wait after `failures` failures in a row may be: `base` doubled for each
/// failure after the first, and no more than `cap`.
pub fn wait_ceiling<x>(policy: Retry<x>, failures: Int) -> Duration = {
  let cap = as_nanos(policy.cap);
  Duration(
    range(1, failures).fold(min(cap, as_nanos(policy.base)), |wait: Int, _i: Int|
      if wait > cap / 2 { cap } else { wait * 2 }),
  )
}

/// How many waits the jitter chooses from after `failures` failures, when the previous wait was
/// `previous` (`base` before the first). A draw below this number picks one. At least one.
pub fn wait_choices<x>(policy: Retry<x>, failures: Int, previous: Duration) -> Int = {
  let ceiling = as_nanos(wait_ceiling(policy, failures));
  match policy.jitter {
    NoJitter -> 1,
    FullJitter -> ceiling + 1,
    EqualJitter -> ceiling / 2 + 1,
    DecorrelatedJitter -> decorrelated_upper_bound(policy, previous) - as_nanos(policy.base) + 1,
  }
}

/// The wait after `failures` failures that `draw` picks, a draw below `wait_choices`.
pub fn wait_of<x>(policy: Retry<x>, failures: Int, previous: Duration, draw: Int) -> Duration = {
  let ceiling = as_nanos(wait_ceiling(policy, failures));
  Duration(match policy.jitter {
    NoJitter -> ceiling,
    FullJitter -> draw,
    EqualJitter -> ceiling - ceiling / 2 + draw,
    DecorrelatedJitter -> min(as_nanos(policy.cap), as_nanos(policy.base) + draw),
  })
}

fn decorrelated_upper_bound<x>(policy: Retry<x>, previous: Duration) -> Int = {
  let before = max(as_nanos(policy.base), as_nanos(previous));
  if before > max_wait / 3 { max_wait } else { before * 3 }
}

const max_wait: Int = 4611686018427387904

/// Runs `body`, and runs it again after each failure that `policy` allows a retry for, at most
/// `policy.attempts` times. Between attempts it waits as `policy.jitter` spreads the waits, with
/// one `entropy.below` per draw. `body` is passed its attempt number, from 1. It stops at the
/// first success, or returns the failure it stopped at with the reason. A wait that would end at
/// or past the deadline is not begun. Raises for a policy of no attempts, a negative `base`, or a
/// `cap` below `base`.
pub fn retry<a, x | e>(
  policy: Retry<x>,
  body: (Int) -> Result<a, x> / e,
) -> Result<a, RetryFailure<x>> / {clock.read, clock.write, random::entropy.below, deadline.at, abort.raise | e} =
  run_retries(policy, || true, body)

/// `retry` under a retry budget that the caller stores. The call pays into the budget, each retry
/// draws on it, and a retry it cannot pay for is not made.
pub fn retry_budgeted<a, x | e>(
  policy: Retry<x>,
  load: () -> Budget / e,
  store: (Budget) -> Unit / e,
  body: (Int) -> Result<a, x> / e,
) -> Result<a, RetryFailure<x>> / {clock.read, clock.write, random::entropy.below, deadline.at, abort.raise | e} = {
  store(credit_call(load()));
  run_retries(
    policy,
    ||
      match spend_retry(load()) {
        Some(rest) -> {
          store(rest);
          true
        },
        None -> false,
      },
    body,
  )
}

type RetryState = { attempt: Int, previous: Duration }

fn run_retries<a, x | e>(
  policy: Retry<x>,
  allowed: () -> Bool / e,
  body: (Int) -> Result<a, x> / e,
) -> Result<a, RetryFailure<x>> / {clock.read, clock.write, random::entropy.below, deadline.at, abort.raise | e} =
  if policy.attempts < 1 { panic("a retry policy allows at least one attempt") }
  else if as_nanos(policy.base) < 0 || as_nanos(policy.cap) < as_nanos(policy.base) {
    panic("a retry policy needs a `base` of zero or more and a `cap` at least as large as `base`")
  } else {
    let bound = earliest(
      match policy.within { Some(d) -> Some(after(clock.now(), d)), None -> None },
      deadline.at(),
    );
    iterate({ attempt: 1, previous: policy.base }, policy.attempts + 1, |trying: RetryState|
      match body(trying.attempt) {
        Ok(result) -> Stop(Ok(result)),
        Err(failure) -> if !(policy.retryable)(failure) { give_up(failure, trying, NotRetryable) }
        else if trying.attempt >= policy.attempts { give_up(failure, trying, Spent) }
        else if !allowed() { give_up(failure, trying, OverBudget) } else {
          let choices = wait_choices(policy, trying.attempt, trying.previous);
          let draw = if choices <= 1 { 0 } else { random::below(choices) };
          let wait = wait_of(policy, trying.attempt, trying.previous, draw);
          if past(after(clock.now(), wait), bound) { give_up(failure, trying, OutOfTime) } else {
            clock.sleep(wait);
            Continue({ attempt: trying.attempt + 1, previous: wait })
          }
        },
      })
  }

fn give_up<a, x>(
  failure: x,
  trying: RetryState,
  reason: Reason,
) -> Iter<RetryState, Result<a, RetryFailure<x>>> =
  Stop(Err({ last: failure, attempts: trying.attempt, reason: reason }))

fn past(at: Instant, bound: Option<Instant>) -> Bool =
  match bound { Some(b) -> nanos_at(at) >= nanos_at(b), None -> false }

/// Tracks how many retries are allowed, as a share of the calls made. Each call adds `percent`
/// hundredths of a retry to the budget, and each retry uses up one whole retry. So over any series
/// of calls at most `percent` in a hundred are retries, plus the `reserve` retries the budget
/// starts with. The budget never holds more than `reserve` retries, or one if `reserve` is zero.
pub opaque type Budget = new { hundredths: Int, percent: Int, reserve: Int }

/// Returns a budget that allows `percent` retries for every hundred calls and starts with `reserve`
/// retries available. The budget never accumulates more than `reserve` retries, or one retry if
/// `reserve` is zero. A negative `percent` or `reserve` is treated as zero.
pub fn budget(percent: Int, reserve: Int) -> Budget = {
  let clamped_reserve = max(0, reserve);
  { hundredths: clamped_reserve * 100, percent: max(0, percent), reserve: clamped_reserve }
}

/// The budget after a call pays into it.
pub fn credit_call(b: Budget) -> Budget =
  { ..b, hundredths: min(max(1, b.reserve) * 100, b.hundredths + b.percent) }

/// The budget after a retry draws on it, or `None` if it has no whole retry to give.
pub fn spend_retry(b: Budget) -> Option<Budget> =
  if b.hundredths < 100 { None } else { Some({ ..b, hundredths: b.hundredths - 100 }) }

/// How many whole retries the budget could pay for now.
pub fn retries_left(b: Budget) -> Int = b.hundredths / 100

/// The state of a breaker.
pub type Circuit =
  /// Calls pass, and this many have failed in a row.
  | Closed(Int)
  /// Calls are rejected until this instant.
  | Open(Instant)
  /// Calls are allowed through one at a time as trial calls, called probes, to test whether the
  /// failures have stopped. The `Int` is how many probes have succeeded. The `Bool` is true while a
  /// probe is running.
  | HalfOpen(Int, Bool)

/// A circuit breaker: it opens after `trip_after` failures in a row, rejects every call for
/// `cooldown`, then lets one call at a time probe, closing after `close_after` of them succeed
/// and opening again at the first that fails.
pub opaque type Breaker = new {
  trip_after: Int,
  cooldown: Duration,
  close_after: Int,
  circuit: Circuit,
}

/// Returns a closed breaker. A `trip_after` or `close_after` below one is treated as one.
pub fn breaker(trip_after: Int, cooldown: Duration, close_after: Int) -> Breaker =
  {
    trip_after: max(1, trip_after),
    cooldown: cooldown,
    close_after: max(1, close_after),
    circuit: Closed(0),
  }

/// The breaker's state.
pub fn circuit(b: Breaker) -> Circuit = b.circuit

/// Whether a call may go at `now`, and the breaker after the check. An open breaker past its
/// cooldown lets this call probe. A half-open one lets a call probe only while no other probe is
/// in progress. `probe` reports that the call is a probe, which `record` or `abandon_probe` must
/// then conclude.
pub fn admit(b: Breaker, now: Instant) -> { breaker: Breaker, admitted: Bool, probe: Bool } =
  match b.circuit {
    Closed(_) -> { breaker: b, admitted: true, probe: false },
    Open(until) -> if nanos_at(now) < nanos_at(until) {
      { breaker: b, admitted: false, probe: false }
    } else { { breaker: { ..b, circuit: HalfOpen(0, true) }, admitted: true, probe: true } },
    HalfOpen(_, true) -> { breaker: b, admitted: false, probe: false },
    HalfOpen(passed, false) ->
      { breaker: { ..b, circuit: HalfOpen(passed, true) }, admitted: true, probe: true },
  }

/// The breaker after a call it admitted ended at `now`, successfully or not. A call that ends
/// after the breaker opened changes nothing.
pub fn record(b: Breaker, ok: Bool, now: Instant) -> Breaker =
  match b.circuit {
    Closed(failed) -> if ok { { ..b, circuit: Closed(0) } }
    else if failed + 1 >= b.trip_after { { ..b, circuit: Open(after(now, b.cooldown)) } }
    else { { ..b, circuit: Closed(failed + 1) } },
    Open(_) -> b,
    HalfOpen(passed, _) -> if !ok { { ..b, circuit: Open(after(now, b.cooldown)) } }
    else if passed + 1 >= b.close_after { { ..b, circuit: Closed(0) } }
    else { { ..b, circuit: HalfOpen(passed + 1, false) } },
  }

/// The breaker after a probe ended without a result, as a cancelled probe does, so another may go.
pub fn abandon_probe(b: Breaker) -> Breaker =
  match b.circuit { HalfOpen(passed, true) -> { ..b, circuit: HalfOpen(passed, false) }, _ -> b }

/// How a call behind a breaker ended without a result.
pub type BreakerError<x> =
  /// The breaker rejected it, and the body did not run.
  | Rejected
  /// The body ran and failed.
  | Failed(x)

/// Runs `body` behind a circuit breaker that the caller reads with `load` and saves with `store`.
/// While the breaker rejects calls, `body` does not run and the result is `Err(Rejected)`.
/// Otherwise the result is that of `body`, with its error wrapped in `Failed`, and the breaker is
/// updated with whether `body` succeeded, using the time from `clock.now`. If a probe call is
/// cancelled, the breaker is updated so that another probe can run.
pub fn guarded<a, x | e>(
  load: () -> Breaker / e,
  store: (Breaker) -> Unit / e,
  body: () -> Result<a, x> / e,
) -> Result<a, BreakerError<x>> / {clock.read | e} = {
  let requested_at = clock.now();
  bracket(
    || {
      let result = admit(load(), requested_at);
      store(result.breaker);
      result
    },
    |result: { breaker: Breaker, admitted: Bool, probe: Bool }|
      if result.probe { store(abandon_probe(load())) } else { () },
    |result: { breaker: Breaker, admitted: Bool, probe: Bool }|
      if !result.admitted { Err(Rejected) } else {
        let ended = body();
        let now = clock.now();
        store(record(load(), match ended { Ok(_) -> true, Err(_) -> false }, now));
        match ended { Ok(done) -> Ok(done), Err(failure) -> Err(Failed(failure)) }
      },
  )
}

/// A token bucket: `capacity` calls may go at once, and one more every `every` after.
pub opaque type Bucket = new {
  capacity: Int,
  every: Duration,
  /// When the bucket would be full again if nothing more were taken.
  full_at: Instant,
}

/// A bucket full at `now`. A `capacity` below one is one, and an `every` below a nanosecond is
/// one.
pub fn bucket(capacity: Int, every: Duration, now: Instant) -> Bucket =
  { capacity: max(1, capacity), every: Duration(max(1, as_nanos(every))), full_at: now }

/// Takes one token at `now`. Returns the bucket after the take, and how long to wait from `now`
/// before the token can be used. The wait is zero when the bucket has a token at `now`. Tokens are
/// given out in the order they were reserved, so each wait ends after the waits of all earlier
/// reservations.
pub fn reserve(b: Bucket, now: Instant) -> { bucket: Bucket, wait: Duration } = {
  let every = as_nanos(b.every);
  let full_at = max(nanos_at(b.full_at), nanos_at(now)) + every;
  let ready = full_at - b.capacity * every;
  { bucket: { ..b, full_at: Instant(full_at) }, wait: Duration(max(0, ready - nanos_at(now))) }
}

/// The bucket after a token is taken at `now`, or `None` if it has none then.
pub fn take(b: Bucket, now: Instant) -> Option<Bucket> = {
  let reserved = reserve(b, now);
  if as_nanos(reserved.wait) == 0 { Some(reserved.bucket) } else { None }
}

/// Returns how many tokens the bucket contains at `now`.
pub fn tokens(b: Bucket, now: Instant) -> Int / {abort.raise} = {
  let nanos_until_full = nanos_at(b.full_at) - nanos_at(now);
  if nanos_until_full <= 0 { b.capacity }
  else { max(0, b.capacity - (nanos_until_full + as_nanos(b.every) - 1) / as_nanos(b.every)) }
}

/// Runs `body` once the bucket that the caller stores has a token for it. The token is reserved
/// at once and the call waits its turn on the clock. A call cancelled while it waits has used up
/// its token.
pub fn throttled<a | e>(
  load: () -> Bucket / e,
  store: (Bucket) -> Unit / e,
  body: () -> a / e,
) -> a / {clock.read, clock.write | e} = {
  let now = clock.now();
  let reserved = reserve(load(), now);
  store(reserved.bucket);
  clock.sleep(reserved.wait);
  body()
}

/// Tracks the runs in progress, by key. It stores their table in a channel, so a caller takes the
/// table out to read or change it and puts it back afterwards.
pub type RunsInProgress<k, a> = { table: Chan<FlightTable<k, a>> }

type FlightTable<k, a> = { next: Int, runs: Map<k, { id: Int, waiting: List<Chan<a>> }> }

type FlightRole<channel> = | Run(Int) | Wait(channel)

/// Returns a new `RunsInProgress` with no runs in it. It is backed by a channel of the scheduler
/// the call runs in, so it can be used only by tasks of that scheduler.
pub fn runs_in_progress<k, a>() -> RunsInProgress<k, a> / {task.write}
  where derivable(ord, k)
= {
  let table = task.channel(1);
  task.send(table, { next: 0, runs: Map::new() });
  { table: table }
}

/// Runs `body` once for all callers that request `key` from `runs_in_progress` while it runs: the first
/// caller runs it and the others wait for its result. A caller that comes after it has returned
/// runs it again. If the caller running it is cancelled, one of the waiting callers runs it
/// instead.
pub fn single_flight<k, a | e>(
  runs_in_progress: RunsInProgress<k, a>,
  key: k,
  body: () -> a / e,
) -> a / {task.write, diverges | e}
  where derivable(ord, k)
=
  bracket(
    || join_flight(runs_in_progress, key),
    |j: Option<FlightRole<Chan<a>>>|
      match j { Some(Run(id)) -> finish_flight(runs_in_progress, key, id, None), _ -> () },
    |j: Option<FlightRole<Chan<a>>>|
      match j {
        Some(Run(id)) -> {
          let result = body();
          bracket(
            || finish_flight(runs_in_progress, key, id, Some(result)),
            |_u: Unit| (),
            |_u: Unit| result,
          )
        },
        Some(Wait(returned)) -> match task.recv(returned) {
          Some(result) -> result,
          None -> single_flight(runs_in_progress, key, body),
        },
        None -> body(),
      },
  )

fn join_flight<k, a>(
  runs_in_progress: RunsInProgress<k, a>,
  key: k,
) -> Option<FlightRole<Chan<a>>> / {task.write}
  where derivable(ord, k)
=
  match task.recv(runs_in_progress.table) {
    None -> None,
    Some(t) -> match t.runs.get(key) {
      Some(run) -> {
        let mine = task.channel(1);
        task.send(runs_in_progress.table, {
          ..t,
          runs: t.runs.insert(key, { ..run, waiting: run.waiting.push(mine) }),
        });
        Some(Wait(mine))
      },
      None -> {
        task.send(runs_in_progress.table, {
          next: t.next + 1,
          runs: t.runs.insert(key, { id: t.next, waiting: [] }),
        });
        Some(Run(t.next))
      },
    },
  }

fn finish_flight<k, a>(
  runs_in_progress: RunsInProgress<k, a>,
  key: k,
  id: Int,
  result: Option<a>,
) -> Unit / {task.write}
  where derivable(ord, k)
=
  match task.recv(runs_in_progress.table) {
    None -> (),
    Some(t) -> match t.runs.get(key) {
      Some(run) -> if run.id != id { put_back(runs_in_progress, t) } else {
        put_back(runs_in_progress, { ..t, runs: t.runs.remove(key) });
        run.waiting.fold((), |_u: Unit, waiter: Chan<a>|
          match result {
            Some(x) -> {
              task.send(waiter, x);
              ()
            },
            None -> task.close(waiter),
          })
      },
      None -> put_back(runs_in_progress, t),
    },
  }

fn put_back<k, a>(
  runs_in_progress: RunsInProgress<k, a>,
  t: FlightTable<k, a>,
) -> Unit / {task.write}
  where derivable(ord, k)
= {
  task.send(runs_in_progress.table, t);
  ()
}

/// What a ticker does when the work of one tick runs past the next.
pub type MissedTickBehavior =
  /// Ticks stay on the original schedule. After a late tick, the missed ticks run one after another
  /// until the ticker is back on that schedule.
  | Burst
  /// The next tick is a whole period after the late one ended, and the schedule moves with it.
  | Delay
  /// The ticks missed are dropped: the next is the first on the schedule still to come.
  | Skip

/// Returns the instant of the next tick. `due` is when the tick that just ran was due, and `now` is
/// when that tick's work ended. `missed` decides what happens when the work ran past the next tick.
/// Raises for a period below a nanosecond.
pub fn next_due(
  missed: MissedTickBehavior,
  period: Duration,
  due: Instant,
  now: Instant,
) -> Instant / {abort.raise} = {
  let step = as_nanos(period);
  let late = nanos_at(now) - nanos_at(due);
  if step < 1 { panic("a ticker's period is at least a nanosecond") }
  else if late < step { after(due, period) } else {
    match missed {
      Burst -> after(due, period),
      Delay -> after(now, period),
      Skip -> Instant(nanos_at(due) + (late / step + 1) * step),
    }
  }
}

/// Runs `tick` each `period`, starting one period from now, at most `limit` times. `tick` is
/// passed the previous tick's result, starting from `init`, and the instant it was due. It returns
/// `Continue` to tick again or `Stop` to end. Returns the last of those results. `missed` decides
/// what follows a tick that ran past the next. Raises for a period below a nanosecond.
pub fn every<s | e>(
  period: Duration,
  missed: MissedTickBehavior,
  limit: Int,
  init: s,
  tick: (s, Instant) -> Iter<s, s> / e,
) -> s / {clock.read, clock.write, abort.raise | e} =
  if limit < 1 { init } else {
    iterate(
      { state: init, due: next_due(missed, period, clock.now(), clock.now()), ticked: 0 },
      limit + 1,
      |ticking: { state: s, due: Instant, ticked: Int }|
        if ticking.ticked == limit { Stop(ticking.state) } else {
          sleep_until(ticking.due);
          match tick(ticking.state, ticking.due) {
            Stop(last) -> Stop(last),
            Continue(next) ->
              Continue({
                state: next,
                due: next_due(missed, period, ticking.due, clock.now()),
                ticked: ticking.ticked + 1,
              }),
          }
        },
    )
  }

fn nap(n: Int) -> Int / {clock.write} = {
  clock.sleep(Duration(n));
  n
}

effect log {
  write note(line: String) -> Unit
  read notes() -> List<String>
}

fn logged<a | e>(
  body: () -> a / {log.note, log.notes | e},
) -> { value: a, notes: List<String> } / e =
  handle {
    body()
  } with {
    var lines: List<String> = [],
    log.note(line) -> {
      lines = lines.push(line);
    },
    log.notes() -> lines,
    return value -> { value: value, notes: lines },
  }

effect level {
  write up() -> Unit
  write down() -> Unit
}

fn peak<a | e>(
  body: () -> a / {level.up, level.down | e},
) -> { value: a, inside: Int, most: Int } / e =
  handle {
    body()
  } with {
    var inside = 0,
    var most = 0,
    level.up() -> {
      inside = inside + 1;
      most = max(most, inside);
    },
    level.down() -> {
      inside = inside - 1;
    },
    return value -> { value: value, inside: inside, most: most },
  }

type Bounded = { name: String, budget: Int, work: Int, ended: Timed<Int>, at: Int }

const bounded: List<Bounded> =
  [
    { name: "work past it is stopped there", budget: 100, work: 250, ended: TimedOut, at: 100 },
    { name: "work inside it returns", budget: 100, work: 40, ended: Done(40), at: 40 },
    { name: "work that does not wait returns", budget: 100, work: 0, ended: Done(0), at: 0 },
  ]

test "a timeout runs on the virtual clock: {c.name}" for c: Bounded in bounded {
  simulate {
    unbounded(|| {
      let ended = timeout(Duration(c.budget), || nap(c.work));
      assert_eq((ended, clock.now()), (c.ended, Instant(c.at)))
    })
  }
}

type SmallCount = | Zero | One | Two | Three

fn few_to_int(n: SmallCount) -> Int = match n { Zero -> 0, One -> 1, Two -> 2, Three -> 3 }

law "work ends before its timeout or is stopped at it, in every interleaving"
  forall (allowed: SmallCount, taken: SmallCount) {
    simulate {
      unbounded(|| {
        let budget = few_to_int(allowed);
        let work = few_to_int(taken);
        let ended = timeout(Duration(budget), || nap(work));
        let at = clock.now();
        if work < budget { ended == Done(work) && at == Instant(work) }
        else if work > budget { ended == TimedOut && at == Instant(budget) }
        else { at == Instant(budget) && (ended == Done(work) || ended == TimedOut) }
      })
    }
  }

type Nested = { name: String, outer: Int, inner: Int, ended: Timed<Timed<Int>>, at: Int }

const nested: List<Nested> =
  [
    {
      name: "an inner one set to a later instant is stopped at the outer",
      outer: 50,
      inner: 200,
      ended: TimedOut,
      at: 50,
    },
    {
      name: "an inner one set to an earlier instant stops its work there",
      outer: 50,
      inner: 20,
      ended: Done(TimedOut),
      at: 20,
    },
  ]

test "nested timeouts take the earlier deadline: {c.name}" for c: Nested in nested {
  simulate {
    unbounded(|| {
      let ended = timeout(Duration(c.outer), || timeout(Duration(c.inner), || nap(1000)));
      assert_eq((ended, clock.now()), (c.ended, Instant(c.at)))
    })
  }
}

test "work under two nested timeouts sees the earlier deadline, whichever timeout is the inner one" {
  simulate {
    unbounded(|| {
      let read = timeout(Duration(50), || timeout(Duration(200), || deadline.at()));
      assert_eq(read, Done(Done(Some(Instant(50)))))
    })
  }
}

test "a task started under a deadline sees that deadline, and sees none when no deadline applies" {
  simulate {
    unbounded(|| {
      assert_eq(deadline.at(), None);
      assert_eq(remaining(), None);
      let read = until(Instant(30), || {
        let t = task.spawn(|| {
          clock.sleep(Duration(10));
          remaining()
        });
        task.join(t)
      });
      assert_eq(read, Done(Some(Duration(20))))
    })
  }
}

test "`within` in a `try` block returns the result of work that finishes before the timeout" {
  simulate { unbounded(|| assert_eq(try { within(Duration(5), || nap(3)) }, Ok(3))) }
}

test "`within` in a `try` block fails with the deadline instant when the work runs past the timeout" {
  simulate { unbounded(|| assert_eq(try { within(Duration(5), || nap(10)) }, Err(Instant(5)))) }
}

test "`by` in a `try` block fails with the given instant when the work runs past it, and the simulated clock reads that instant" {
  simulate {
    unbounded(|| {
      clock.sleep(Duration(1));
      assert_eq(try { by(Instant(4), || nap(10)) }, Err(Instant(4)));
      assert_eq(clock.now(), Instant(4))
    })
  }
}

test "when a timeout stops its work, the work's cleanup has already run by the time the timeout returns" {
  logged(||
    simulate {
      unbounded(|| {
        let ended = timeout(Duration(5), ||
          bracket(|| log.note("open"), |_u: Unit| log.note("close"), |_u: Unit| nap(10)));
        assert_eq(ended, TimedOut);
        assert_eq(log.notes(), ["open", "close"])
      })
    });
  ()
}

test "cancelling a `timeout` stops both its work and its timer, so neither work nor timer runs afterwards" {
  let ran = logged(||
    simulate {
      let outer = task.spawn(||
        unbounded(||
          timeout(Duration(50), || {
            clock.sleep(Duration(10));
            log.note("late")
          })));
      clock.sleep(Duration(5));
      assert(task.cancel(outer));
      assert_eq(task.await(outer), None);
      assert_eq(clock.now(), Instant(5));
      clock.sleep(Duration(100));
      assert_eq(clock.now(), Instant(105))
    });
  assert_eq(ran.notes, [])
}

test "when a race returns, the cleanup of every losing task has already run" {
  let won = logged(||
    simulate {
      let runner = |name: String, takes: Int|
        || bracket(|| (), |_u: Unit| log.note(name), |_u: Unit| nap(takes));
      let first = race([runner("a", 30), runner("b", 10), runner("c", 20)]);
      (first, log.notes(), clock.now())
    }).value;
  assert_eq(won._0, Some(10));
  assert_eq(won._1.sort(), ["a", "b", "c"]);
  assert_eq(won._2, Instant(10))
}

law "a race returns the body that ends first and takes no longer, in every interleaving"
  forall (a: SmallCount, b: SmallCount, c: SmallCount) where a != b && a != c && b != c {
    simulate {
      let first = min(few_to_int(a), min(few_to_int(b), few_to_int(c)));
      race([|| nap(few_to_int(a)), || nap(few_to_int(b)), || nap(few_to_int(c))]) == Some(first)
        && clock.now() == Instant(first)
    }
  }

test "a race of no bodies has no result" {
  simulate {
    let none: List<() -> Int / {clock.write}> = [];
    assert_eq(race(none), None)
  }
}

test "all returns each body's result in the bodies' order, and takes as long as the longest" {
  simulate {
    assert_eq(all([|| nap(30), || nap(10), || nap(20)]), [30, 10, 20]);
    assert_eq(clock.now(), Instant(30));
    let none: List<() -> Int / {clock.write}> = [];
    assert_eq(all(none), [])
  }
}

fn sleep_then_result(takes: Int, ok: Bool) -> Result<Int, String> / {clock.write} = {
  clock.sleep(Duration(takes));
  if ok { Ok(takes) } else { Err("failed at " ++ takes.to_string()) }
}

test "all_ok returns every success in the bodies' order" {
  simulate {
    assert_eq(
      all_ok([
        || sleep_then_result(3, true),
        || sleep_then_result(1, true),
        || sleep_then_result(2, true),
      ]),
      Ok([3, 1, 2]),
    )
  }
}

test "all_ok stops at the first failure, and no body is left running" {
  let ran = logged(||
    simulate {
      let late = |takes: Int|
        || {
          let r = sleep_then_result(takes, true);
          log.note("late");
          r
        };
      assert_eq(all_ok([late(50), || sleep_then_result(10, false), late(40)]), Err("failed at 10"));
      assert_eq(clock.now(), Instant(10));
      clock.sleep(Duration(100))
    });
  assert_eq(ran.notes, [])
}

test "first_ok returns the first success and stops the rest" {
  simulate {
    let first = first_ok([
      || sleep_then_result(30, true),
      || sleep_then_result(10, false),
      || sleep_then_result(20, true),
    ]);
    assert_eq((first, clock.now()), (Ok(20), Instant(20)))
  }
}

test "first_ok of bodies that all fail returns every failure in the bodies' order" {
  simulate {
    assert_eq(
      first_ok([|| sleep_then_result(3, false), || sleep_then_result(1, false)]),
      Err(["failed at 3", "failed at 1"]),
    )
  }
}

law "map_concurrent returns results in the order given and never runs more than its limit at once"
  forall (items: SmallCount, at_once: SmallCount)
  where at_once != Zero && (items != Three || at_once != Three) {
    simulate {
      let n = few_to_int(items);
      let got = peak(||
        map_concurrent(range(0, n), few_to_int(at_once), |x: Int| {
          level.up();
          task.yield();
          level.down();
          x * 2
        }));
      got.value == range(0, n).map(|x: Int| x * 2) && got.most <= few_to_int(at_once)
        && got.inside == 0
    }
  }

test "`map_concurrent` returns an empty list for an empty list, and raises when the limit is below one" {
  simulate {
    let none: List<Int> = [];
    assert_eq(map_concurrent(none, 2, |x: Int| x), []);
    assert_eq(handle { map_concurrent([1], 0, |x: Int| x) } with { abort.raise(_m) -> [0 - 1] }, [
      0 - 1,
    ])
  }
}

law "a semaphore never admits more holders than it has permits, in every interleaving"
  forall (permits: SmallCount, tasks: SmallCount)
  where permits != Zero && permits != Three && (permits == One || tasks != Three) {
    simulate {
      let sem = semaphore(few_to_int(permits));
      let got = peak(||
        all(
          range(0, few_to_int(tasks)).map(|_i: Int|
            ||
              with_permit(sem, || {
                level.up();
                task.yield();
                level.down()
              })),
        ));
      got.most <= few_to_int(permits) && got.inside == 0
        && (few_to_int(tasks) == 0 || got.most >= 1)
    }
  }

effect queue {
  write requested(i: Int) -> Unit
  write entered(i: Int) -> Unit
}

law "a semaphore of one permit admits waiters in the order they requested, in every interleaving"
  forall (tasks: SmallCount) {
    simulate {
      let sem = semaphore(1);
      handle {
        all(
          range(0, few_to_int(tasks)).map(|i: Int|
            || {
              queue.requested(i);
              with_permit(sem, || {
                queue.entered(i);
                task.yield()
              })
            }),
        )
      } with {
        var requested_order: List<Int> = [],
        var entered: List<Int> = [],
        queue.requested(i) -> {
          requested_order = requested_order.push(i);
        },
        queue.entered(i) -> {
          entered = entered.push(i);
        },
        return _done -> requested_order == entered,
      }
    }
  }

test "a semaphore serves its waiters in the order they began to wait" {
  let ran = logged(||
    simulate {
      let sem = semaphore(1);
      let waiter = |name: String, from: Int|
        || {
          clock.sleep(Duration(from));
          with_permit(sem, || {
            log.note(name);
            clock.sleep(Duration(10))
          })
        };
      all([waiter("third", 3), waiter("first", 0), waiter("second", 2), waiter("fourth", 4)]);
      ()
    });
  assert_eq(ran.notes, ["first", "second", "third", "fourth"])
}

test "a permit is returned however its holder ends: cancelled anywhere, or by a raise" {
  simulate {
    let sem = semaphore(1);
    let holder = task.spawn(|| with_permit(sem, || task.yield()));
    task.cancel(holder);
    task.await(holder);
    assert_eq(try_with_permit(sem, || 1), Some(1));
    let raised = handle { with_permit(sem, || panic("gone")) } with { abort.raise(_m) -> 0 };
    assert_eq(raised, 0);
    assert_eq(with_permit(sem, || try_with_permit(sem, || 2)), None);
    assert_eq(try_with_permit(sem, || 3), Some(3))
  }
}

test "`scoped` ends every task it started when the task that called it is cancelled" {
  let ran = logged(||
    simulate {
      let late = |name: String|
        || {
          clock.sleep(Duration(10));
          log.note(name)
        };
      let outer = task.spawn(||
        scoped([late("a"), late("b")], |_kids: List<Task<Unit>>| clock.sleep(Duration(100))));
      task.cancel(outer);
      task.await(outer);
      clock.sleep(Duration(50))
    });
  assert_eq(ran.notes, [])
}

fn retry_policy(
  jitter: Jitter,
  base: Int,
  cap: Int,
  attempts: Int,
  within: Option<Duration>,
) -> Retry<String> =
  {
    attempts: attempts,
    base: Duration(base),
    cap: Duration(cap),
    jitter: jitter,
    retryable: |failure: String| failure != "fatal",
    within: within,
  }

fn always_fails(attempt: Int) -> Result<Int, String> = Err("no " ++ attempt.to_string())

fn total_wait(policy: Retry<String>, r: random::Rand, failures: Int) -> Int / {abort.raise} =
  range(1, failures + 1).fold(
    { total: 0, previous: policy.base, rand: r },
    |so_far: { total: Int, previous: Duration, rand: random::Rand }, n: Int| {
      let choices = wait_choices(policy, n, so_far.previous);
      let drawn = if choices <= 1 { { value: 0, rand: so_far.rand } } else {
        match random::rand_below(so_far.rand, choices) {
          Some(d) -> d,
          None -> panic("drawing a random wait failed although more than one wait is possible"),
        }
      };
      let wait = wait_of(policy, n, so_far.previous, drawn.value);
      { total: so_far.total + as_nanos(wait), previous: wait, rand: drawn.rand }
    },
  ).total

test "a retry without jitter waits its base doubled up to its cap, until its attempts are spent" {
  let ended = simulate {
    unbounded(||
      random::with_rand(random::rand(1), || {
        let last = retry(retry_policy(NoJitter, 10, 40, 5, None), always_fails);
        (last, clock.now())
      }).value)
  };
  assert_eq(ended, (Err({ last: "no 5", attempts: 5, reason: Spent }), Instant(110)))
}

type JitterCase = { name: String, jitter: Jitter }

const jitter_cases: List<JitterCase> =
  [
    { name: "none", jitter: NoJitter },
    { name: "full", jitter: FullJitter },
    { name: "equal", jitter: EqualJitter },
    { name: "decorrelated", jitter: DecorrelatedJitter },
  ]

test "a retry sleeps for the total delay its jitter setting computes from the simulation seed's random values: {c.name}" for c: JitterCase in jitter_cases {
  simulate {
    unbounded(|| {
      let policy = retry_policy(c.jitter, 10, 200, 5, None);
      let seeded = random::rand(sim.seed());
      random::with_rand(seeded, || {
        retry(policy, always_fails);
        ()
      });
      assert_eq(clock.now(), Instant(total_wait(policy, seeded, 4)))
    })
  }
}

test "a retry does not begin a wait that would end at or past its deadline" {
  let own = simulate {
    unbounded(||
      random::with_rand(random::rand(1), || {
        let last = retry(retry_policy(NoJitter, 10, 40, 5, Some(Duration(25))), always_fails);
        (last, clock.now())
      }).value)
  };
  assert_eq(own, (Err({ last: "no 2", attempts: 2, reason: OutOfTime }), Instant(10)));
  let around = simulate {
    unbounded(|| {
      let ended = until(Instant(25), ||
        random::with_rand(random::rand(1), ||
          retry(retry_policy(NoJitter, 10, 40, 5, None), always_fails)).value);
      (ended, clock.now())
    })
  };
  assert_eq(around, (Done(Err({ last: "no 2", attempts: 2, reason: OutOfTime })), Instant(10)))
}

test "a retry stops at a failure its policy does not retry, and at the first success" {
  let ended = simulate {
    unbounded(||
      random::with_rand(random::rand(1), || {
        let fatal = retry(retry_policy(NoJitter, 10, 40, 5, None), |attempt: Int|
          if attempt < 2 { always_fails(attempt) } else { Err("fatal") });
        let at = clock.now();
        let third = retry(retry_policy(NoJitter, 10, 40, 5, None), |attempt: Int|
          if attempt < 3 { always_fails(attempt) } else { Ok(attempt) });
        (fatal, at, third, clock.now())
      }).value)
  };
  assert_eq(ended._0, Err({ last: "fatal", attempts: 2, reason: NotRetryable }));
  assert_eq(ended._1, Instant(10));
  assert_eq(ended._2, Ok(3));
  assert_eq(ended._3, Instant(40))
}

test "`retry_budgeted` retries only while the budget has retries left, and every call adds to the budget" {
  let ended = handle {
    simulate {
      unbounded(||
        random::with_rand(random::rand(1), || {
          let call = ||
            retry_budgeted(
              retry_policy(NoJitter, 10, 40, 5, None),
              || budgets.load(),
              |next: Budget| budgets.store(next),
              always_fails,
            );
          [call(), call(), call()]
        }).value)
    }
  } with {
    var stored_budget = budget(50, 1),
    budgets.load() -> stored_budget,
    budgets.store(next) -> {
      stored_budget = next;
    },
    return calls -> (calls, stored_budget),
  };
  assert_eq(ended._0, [over_budget_failure(2), over_budget_failure(1), over_budget_failure(2)]);
  assert_eq(retries_left(ended._1), 0)
}

effect budgets {
  read load() -> Budget
  write store(b: Budget) -> Unit
}

fn over_budget_failure(attempts: Int) -> Result<Int, RetryFailure<String>> =
  Err({ last: "no " ++ attempts.to_string(), attempts: attempts, reason: OverBudget })

fn jitters() -> gen::Gen<Jitter> =
  gen::elements([NoJitter, FullJitter, EqualJitter, DecorrelatedJitter])

test "a budget never allows more retries than its reserve plus its percentage of the calls made" {
  gen::check3(
    gen::any_int(),
    gen::any_int(),
    gen::list(gen::bool()),
    |share: Int, reserve_input: Int, script: List<Bool>| {
      let percent = rem_euclid(share, 101);
      let reserve = rem_euclid(reserve_input, 4);
      let ran = script.fold(
        { budget: budget(percent, reserve), calls: 0, retries: 0 },
        |so_far: { budget: Budget, calls: Int, retries: Int }, call: Bool|
          if call { { ..so_far, budget: credit_call(so_far.budget), calls: so_far.calls + 1 } }
          else {
            match spend_retry(so_far.budget) {
              Some(rest) -> { ..so_far, budget: rest, retries: so_far.retries + 1 },
              None -> so_far,
            }
          },
      );
      ran.retries * 100 <= reserve * 100 + percent * ran.calls
        && retries_left(ran.budget) <= max(1, reserve)
    },
  )
}

fn doubled(base: Int, times: Int) -> Int = range(0, times).fold(base, |wait: Int, _i: Int| wait * 2)

test "a retry wait never exceeds the cap or falls below the jitter's minimum, for any random value" {
  gen::check(
    gen::and_then(jitters(), |jitter: Jitter|
      gen::and_then(gen::any_int(), |from: Int|
        gen::map4(
          gen::any_int(),
          gen::any_int(),
          gen::any_int(),
          gen::any_int(),
          |room: Int, failed: Int, waited_before: Int, pick: Int|
            (jitter, from, room, failed, waited_before, pick),
        ))),
    |drawn: (Jitter, Int, Int, Int, Int, Int)| {
      let jitter = drawn._0;
      let from = drawn._1;
      let room = drawn._2;
      let failed = drawn._3;
      let waited_before = drawn._4;
      let pick = drawn._5;
      let base = rem_euclid(from, 21);
      let extra = rem_euclid(room, 201);
      let failures = 1 + rem_euclid(failed, 8);
      let before = rem_euclid(waited_before, 301);
      let policy = retry_policy(jitter, base, base + extra, 9, None);
      let ceiling = min(base + extra, doubled(base, failures - 1));
      let choices = wait_choices(policy, failures, Duration(before));
      let wait = as_nanos(wait_of(policy, failures, Duration(before), rem_euclid(pick, choices)));
      choices >= 1 && wait <= base + extra
        && (match jitter {
          NoJitter -> wait == ceiling,
          FullJitter -> wait >= 0 && wait <= ceiling,
          EqualJitter -> wait >= ceiling - ceiling / 2 && wait <= ceiling,
          DecorrelatedJitter -> wait >= base && wait <= max(base, before) * 3,
        })
    },
  )
}

test "an open breaker rejects every call until its cooldown ends, then lets one probe at a time" {
  gen::check2(gen::any_int(), gen::any_int(), |cools: Int, arrival_input: Int| {
    let cooldown = rem_euclid(cools, 6);
    let arrival = rem_euclid(arrival_input, 9);
    let open = record(breaker(1, Duration(cooldown), 2), false, Instant(0));
    let first = admit(open, Instant(arrival));
    let second = admit(first.breaker, Instant(arrival));
    if arrival < cooldown { !first.admitted && !first.probe && first.breaker == open } else {
      first.admitted && first.probe && circuit(first.breaker) == HalfOpen(0, true)
        && !second.admitted
        && admit(abandon_probe(first.breaker), Instant(arrival)).admitted
    }
  })
}

test "a call behind an open breaker is rejected, probes after the cooldown, and closes it" {
  with_breaker(breaker(2, Duration(10), 1), ||
    simulate {
      let call = |ok: Bool|
        guarded(|| shared_breaker.load(), |b: Breaker| shared_breaker.store(b), ||
          if ok { Ok(1) } else { Err("down") });
      assert_eq(call(false), Err(Failed("down")));
      assert_eq(call(false), Err(Failed("down")));
      assert_eq(call(true), Err(Rejected));
      clock.sleep(Duration(10));
      assert_eq(call(true), Ok(1));
      assert_eq(circuit(shared_breaker.load()), Closed(0))
    })
}

effect shared_breaker {
  read load() -> Breaker
  write store(b: Breaker) -> Unit
}

fn with_breaker<a | e>(
  b: Breaker,
  body: () -> a / {shared_breaker.load, shared_breaker.store | e},
) -> a / e =
  handle {
    body()
  } with {
    var current = b,
    shared_breaker.load() -> current,
    shared_breaker.store(next) -> {
      current = next;
    },
  }

fn slow_ok(takes: Int) -> Result<Int, String> / {clock.write} = {
  clock.sleep(Duration(takes));
  Ok(takes)
}

test "a probe that is cancelled is released, so the next call may probe" {
  with_breaker(record(breaker(1, Duration(0), 1), false, Instant(0)), ||
    simulate {
      let call = |takes: Int|
        guarded(|| shared_breaker.load(), |b: Breaker| shared_breaker.store(b), || slow_ok(takes));
      let probe = task.spawn(|| call(50));
      clock.sleep(Duration(1));
      assert_eq(call(1), Err(Rejected));
      assert(task.cancel(probe));
      assert_eq(task.await(probe), None);
      assert_eq(circuit(shared_breaker.load()), HalfOpen(0, false));
      assert_eq(call(1), Ok(1))
    })
}

test "a bucket left alone fills again, to its capacity and no further" {
  gen::check4(
    gen::any_int(),
    gen::any_int(),
    gen::any_int(),
    gen::any_int(),
    |capacity_input: Int, period: Int, takes: Int, rests: Int| {
      let capacity = 1 + rem_euclid(capacity_input, 3);
      let every = 1 + rem_euclid(period, 3);
      let taken = rem_euclid(takes, capacity + 1);
      let idle = rem_euclid(rests, 13);
      let b = range(0, taken).fold(
        bucket(capacity, Duration(every), Instant(0)),
        |b: Bucket, _i: Int| reserve(b, Instant(0)).bucket,
      );
      tokens(b, Instant(idle)) == min(capacity, max(0, capacity - taken + idle / every))
    },
  )
}

effect shared_bucket {
  read load() -> Bucket
  write store(b: Bucket) -> Unit
}

fn bucketed<a | e>(
  b: Bucket,
  body: () -> a / {shared_bucket.load, shared_bucket.store | e},
) -> a / e =
  handle {
    body()
  } with {
    var current = b,
    shared_bucket.load() -> current,
    shared_bucket.store(next) -> {
      current = next;
    },
  }

test "calls through a bucket run at once while it has tokens left, and then one per period" {
  let times = bucketed(bucket(2, Duration(10), Instant(0)), ||
    simulate {
      range(0, 5).map(|_i: Int|
        throttled(|| shared_bucket.load(), |b: Bucket| shared_bucket.store(b), || clock.now()))
    });
  assert_eq(times, [Instant(0), Instant(0), Instant(10), Instant(20), Instant(30)])
}

test "concurrent tasks sharing one bucket are spaced out the same as sequential calls, in every interleaving" {
  let times = bucketed(bucket(1, Duration(10), Instant(0)), ||
    simulate {
      all(
        range(0, 3).map(|_i: Int|
          ||
            throttled(|| shared_bucket.load(), |b: Bucket| shared_bucket.store(b), || clock.now())),
      )
    });
  assert_eq(times.sort(), [Instant(0), Instant(10), Instant(20)])
}

effect ran {
  write run() -> Unit
}

fn counted_runs<a | e>(body: () -> a / {ran.run | e}) -> { value: a, runs: Int } / e =
  handle {
    body()
  } with {
    var runs = 0,
    ran.run() -> {
      runs = runs + 1;
    },
    return value -> { value: value, runs: runs },
  }

test "concurrent callers with the same key share one run and its result while that run is in progress, in every interleaving" {
  let ran = counted_runs(||
    simulate {
      {
        let f: RunsInProgress<String, Int> = runs_in_progress();
        let ask = |key: String|
          ||
            single_flight(f, key, || {
              ran.run();
              clock.sleep(Duration(10));
              key.len()
            });
        all([
          ask("a"),
          ask("a"),
          || {
            clock.sleep(Duration(1));
            ask("a")()
          },
        ])
      }
    });
  assert_eq(ran.value, [1, 1, 1]);
  assert_eq(ran.runs, 1)
}

test "callers that request different keys each run their own, and a later caller runs again" {
  let ran = counted_runs(||
    simulate {
      {
        let f: RunsInProgress<String, Int> = runs_in_progress();
        let ask = |key: String|
          ||
            single_flight(f, key, || {
              ran.run();
              clock.sleep(Duration(10));
              key.len()
            });
        let together = all([
          ask("a"),
          || {
            clock.sleep(Duration(1));
            ask("bb")()
          },
        ]);
        together.concat([ask("a")()])
      }
    });
  assert_eq(ran.value, [1, 2, 1]);
  assert_eq(ran.runs, 3)
}

test "when the caller running a shared `single_flight` call is cancelled, a waiting caller runs the call itself" {
  let ran = counted_runs(||
    simulate {
      {
        let f: RunsInProgress<String, Int> = runs_in_progress();
        let ask = ||
          single_flight(f, "a", || {
            ran.run();
            clock.sleep(Duration(10));
            7
          });
        let results = unbounded(||
          all([
            || timeout(Duration(5), ask),
            || {
              clock.sleep(Duration(1));
              Done(ask())
            },
          ]));
        (results, clock.now())
      }
    });
  assert_eq(ran.value, ([TimedOut, Done(7)], Instant(15)));
  assert_eq(ran.runs, 2)
}

fn ticked(missed: MissedTickBehavior) -> List<Int> / {clock.read, clock.write, abort.raise} =
  every(Duration(10), missed, 5, [], |seen: List<Int>, _due: Instant| {
    let ran = nanos_at(clock.now());
    if seen.len() == 1 { clock.sleep(Duration(25)) } else { () };
    Continue(seen.push(ran))
  })

test "a ticker whose second tick runs long catches up, starts over or skips, per its policy" {
  assert_eq(simulate { ticked(Burst) }, [10, 20, 45, 45, 50]);
  assert_eq(simulate { ticked(Delay) }, [10, 20, 55, 65, 75]);
  assert_eq(simulate { ticked(Skip) }, [10, 20, 50, 60, 70])
}

test "a ticker ends when its tick returns Stop, and never ticks past its limit" {
  simulate {
    let cancel_and_await = every(Duration(10), Burst, 9, 0, |few_to_int: Int, _due: Instant|
      if few_to_int == 2 { Stop(few_to_int + 1) } else { Continue(few_to_int + 1) });
    assert_eq((cancel_and_await, clock.now()), (3, Instant(30)));
    let limited = every(Duration(10), Burst, 2, 0, |few_to_int: Int, _due: Instant|
      Continue(few_to_int + 1));
    assert_eq((limited, clock.now()), (2, Instant(50)))
  }
}

test/nondet "outside `simulate` the clock is the real clock, and `clock.sleep` really waits" {
  let before = clock.now();
  clock.sleep(millis(2));
  clock.sleep(Duration(0 - 1000000000));
  let after = clock.now();
  assert(as_nanos(between(before, after)) >= as_nanos(millis(2)), None)
}

test/nondet "a task that sleeps waits in the run's scheduler while another runs" {
  let started = clock.now();
  let sleeper = task.spawn(|| {
    clock.sleep(millis(20));
    clock.now()
  });
  let other = task.spawn(|| clock.now());
  let woke = task.join(sleeper);
  let ran = task.join(other);
  assert(as_nanos(between(ran, woke)) > 0, None);
  assert(as_nanos(between(started, woke)) >= as_nanos(millis(20)), None)
}
