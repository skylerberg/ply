//! Directed graphs: components, orders, traversals and shortest paths.
//!
//! A `Graph` numbers its nodes from zero and stores each one's successors, so a caller with
//! adjacency lists already has one: `{ out: lists }`. `of` calls a successor function for each
//! node, `of_edges` reads pairs, and `keyed` and `explore` number nodes of any ordered type. A
//! successor that is not one of the graph's nodes is not an edge, and every traversal skips it.
//!
//! A result depends only on the graph as written. A traversal tries nodes in ascending order and a
//! node's successors in the order the graph lists them. Where several nodes could come next in an
//! order, the least comes first.
//!
//! No traversal recurses: each is a loop over a stack it manages itself, so a chain deeper than the
//! call stack is traversed like a short one. Each loop is limited to a number of steps based on the
//! graph's node and edge counts and panics if it exceeds that limit, so every loop ends.

import std.laws (agrees)
import std.list
import std.gen

/// A directed graph over the nodes `0..len(out)`.
///
/// `out` contains each node's successors, in the order a traversal visits them. An edge may be
/// listed twice, and a successor outside the nodes is not an edge.
pub type Graph = new { out: List<List<Int>> }

/// An edge, from one node to another.
pub type Edge = { from: Int, target: Int }

/// An edge and the cost of following it.
pub type WeightedEdge = { from: Int, target: Int, weight: Int }

/// The errors that graph functions raise.
pub effect graph {
  /// The graph has a cycle where an order was requested. `path` is one such cycle: each node has an
  /// edge to the next, and the last to the first.
  raise cyclic(path: List<Int>)
  /// An edge along the way has a weight below zero, so no shortest path through it can be found.
  raise negative(edge: WeightedEdge)
}

/// The graph over `0..n` in which `next(v)` are `v`'s successors.
///
/// `next` is called once for each node, in ascending order.
pub fn of<| e>(n: Int, next: (Int) -> List<Int> / e) -> Graph / e = { out: range(0, n).map(next) }

/// The graph over `0..n` with these edges, each node's successors in the order its edges come.
///
/// An edge from outside `0..n` is dropped.
pub fn of_edges(n: Int, edges: List<Edge>) -> Graph = {
  let none = range(0, n).fold(Map::new(), |m: Map<Int, List<Int>>, v: Int| m.insert(v, []));
  {
    out: edges.fold(none, |m: Map<Int, List<Int>>, e: Edge|
      m.update(e.from, |next: List<Int>| next.push(e.target))).values(
    ),
  }
}

/// How many nodes the graph has.
pub fn size(g: Graph) -> Int = g.out.len()

/// Returns the successors of `v` that are nodes, in the graph's order, or an empty list when `v` is
/// not a node.
pub fn successors(g: Graph, v: Int) -> List<Int> = {
  let n = g.out.len();
  g.out.at_or(v, []).filter(|w: Int| w >= 0 && w < n)
}

/// Returns every edge, ordered by source node in ascending order, and for each node in the order of
/// its successors.
pub fn edges(g: Graph) -> List<Edge> =
  range(0, g.out.len()).fold([], |accumulator: List<Edge>, v: Int|
    successors(g, v).fold(accumulator, |es: List<Edge>, w: Int| es.push({ from: v, target: w })))

/// The graph with every edge reversed.
///
/// A node's successors come in ascending order of the node each edge came from.
pub fn transpose(g: Graph) -> Graph =
  of_edges(g.out.len(), edges(g).map(|e: Edge| { from: e.target, target: e.from }))

fn edge_count(out: List<List<Int>>) -> Int =
  out.fold(0, |sum: Int, next: List<Int>| sum + next.len())

fn blank(n: Int) -> List<Int> = range(0, n).map(|_: Int| -1)

fn out_of_budget<a>() -> a / {abort.raise} =
  panic("the walk visited more nodes or edges than the graph contains")

/// The strongly connected components: the largest sets of nodes in which each reaches every other.
///
/// A component comes after every component it has an edge into, which is reverse topological
/// order, so folding over the result reaches a node's successors before the node. A component's
/// members come in the order the search found them, starting with the node through which the search
/// entered the component.
pub fn components(g: Graph) -> List<List<Int>> / {abort.raise} = {
  let n = g.out.len();
  let none = blank(n);
  tarjan(
    g.out,
    n,
    { mark: none, low: none, cursor: none, parent: none, stack: none, depth: 0, found: [] },
    0,
    -1,
    [],
    0,
    0,
    2 * n + edge_count(g.out) + 1,
  )
}

type Tarjan = {
  mark: List<Int>,
  low: List<Int>,
  cursor: List<Int>,
  parent: List<Int>,
  stack: List<Int>,
  depth: Int,
  found: List<List<Int>>,
}

reuse fn tarjan(
  out: List<List<Int>>,
  n: Int,
  s: Tarjan,
  root: Int,
  v: Int,
  next: List<Int>,
  i: Int,
  low: Int,
  room: Int,
) -> List<List<Int>> / {abort.raise} =
  if room <= 0 { out_of_budget() } else if v < 0 {
    if root >= n { s.found }
    else if s.mark.get(root) >= 0 { tarjan(out, n, s, root + 1, -1, [], 0, 0, room - 1) } else {
      let { mark, low: lows, cursor, parent, stack, depth, found: add_if_new } = s;
      tarjan(
        out,
        n,
        {
          mark: mark.set(root, depth),
          low: lows,
          cursor: cursor,
          parent: parent,
          stack: stack.set(depth, root),
          depth: depth + 1,
          found: add_if_new,
        },
        root + 1,
        root,
        out.get(root),
        0,
        depth,
        room - 1,
      )
    }
  } else if i < next.len() {
    let w = next.get(i);
    let seen = if w < 0 || w >= n { n } else { s.mark.get(w) };
    if seen >= 0 { tarjan(out, n, s, root, v, next, i + 1, min(low, seen), room - 1) } else {
      let { mark, low: lows, cursor, parent, stack, depth, found: add_if_new } = s;
      tarjan(
        out,
        n,
        {
          mark: mark.set(w, depth),
          low: lows.set(v, low),
          cursor: cursor.set(v, i + 1),
          parent: parent.set(w, v),
          stack: stack.set(depth, w),
          depth: depth + 1,
          found: add_if_new,
        },
        root,
        w,
        out.get(w),
        0,
        depth,
        room - 1,
      )
    }
  } else {
    let up = s.parent.get(v);
    let closed = if low == s.mark.get(v) { close(s, low, n) } else { s };
    if up < 0 { tarjan(out, n, closed, root, -1, [], 0, 0, room - 1) } else {
      let resumed = closed.cursor.get(up);
      let none_if_negative = min(closed.low.get(up), low);
      tarjan(out, n, closed, root, up, out.get(up), resumed, none_if_negative, room - 1)
    }
  }

reuse fn close(s: Tarjan, from: Int, n: Int) -> Tarjan / {abort.raise} = {
  let { mark, low, cursor, parent, stack, depth, found: add_if_new } = s;
  let left = leave(mark, stack, from, depth, n, []);
  {
    mark: left.mark,
    low: low,
    cursor: cursor,
    parent: parent,
    stack: stack,
    depth: from,
    found: add_if_new.push(left.members),
  }
}

type PoppedComponent = { mark: List<Int>, members: List<Int> }

reuse fn leave(
  mark: List<Int>,
  stack: List<Int>,
  k: Int,
  depth: Int,
  n: Int,
  members: List<Int>,
) -> PoppedComponent / {abort.raise} =
  if k >= depth { { mark: mark, members: members } } else {
    let w = stack.get(k);
    leave(mark.set(w, n), stack, k + 1, depth, n, members.push(w))
  }

/// A graph's strongly connected components, as a graph of their own.
///
/// `members` is `components`, and `component` gives the component of each node. `graph` has an
/// edge from one component to another when a member of the first has an edge to a member of the
/// second. Each such edge appears once, in the order of the members' edges. The components come in
/// reverse topological order, so every edge of `graph` goes to a lower node, and it has no cycle.
pub type Condensation = new { graph: Graph, members: List<List<Int>>, component: List<Int> }

/// The graph of `g`'s strongly connected components.
pub fn condensation(g: Graph) -> Condensation / {abort.raise} = {
  let n = g.out.len();
  let members = components(g);
  let count = members.len();
  let component = range(0, count).fold(blank(n), |of: List<Int>, c: Int|
    members.get(c).fold(of, |o: List<Int>, v: Int| o.set(v, c)));
  let joined = range(0, count).fold(
    { out: [], last: blank(count) },
    |accumulator: CondensedEdges, c: Int| {
      let row = members.get(c).fold({ next: [], last: accumulator.last }, |r: Row, v: Int|
        g.out.get(v).fold(r, |r: Row, w: Int|
          if w < 0 || w >= n { r } else {
            let d = component.get(w);
            if d == c || r.last.get(d) == c { r } else {
              let { next, last } = r;
              { next: next.push(d), last: last.set(d, c) }
            }
          }));
      { out: accumulator.out.push(row.next), last: row.last }
    },
  );
  { graph: { out: joined.out }, members: members, component: component }
}

type CondensedEdges = { out: List<List<Int>>, last: List<Int> }

type Row = { next: List<Int>, last: List<Int> }

/// Returns a cycle as a list of nodes, or `None` if the graph has no cycle.
///
/// Each node in the list has an edge to the next node, and the last has an edge to the first. A
/// node with an edge to itself is a cycle whose list has one node. This is the first cycle a
/// depth-first search finds: when the search follows an edge to a node that is still on its current
/// path from the start, the cycle is the part of that path from the edge's target to the node the
/// edge leaves.
pub fn cycle(g: Graph) -> Option<List<Int>> / {abort.raise} =
  descend(g, range(0, g.out.len()), true).back

/// The nodes a depth-first search from `from` reaches, in the order it first visits them.
///
/// A node comes first, then everything its first successor leads to, then everything its second
/// leads to. The search starts at each of `from` in turn, skipping one it has already visited and
/// one that is not a node.
pub fn depth_first(g: Graph, from: List<Int>) -> List<Int> / {abort.raise} =
  descend(g, from, false).pre

/// The nodes a depth-first search from `from` reaches, in the order it finishes them.
///
/// A node comes after everything it leads to that the search had not already finished. In a graph
/// with no cycle, that means after all of its successors.
pub fn post_order(g: Graph, from: List<Int>) -> List<Int> / {abort.raise} =
  descend(g, from, false).post_order

type Descent = {
  mark: List<Int>,
  cursor: List<Int>,
  path: List<Int>,
  pre: List<Int>,
  post: List<Int>,
}

type DescentResult = { pre: List<Int>, post_order: List<Int>, back: Option<List<Int>> }

fn descend(g: Graph, from: List<Int>, halt: Bool) -> DescentResult / {abort.raise} = {
  let n = g.out.len();
  let none = blank(n);
  descent(
    g.out,
    n,
    from,
    halt,
    { mark: none, cursor: none, path: none, pre: [], post: [] },
    0,
    0,
    -1,
    [],
    0,
    from.len() + n + edge_count(g.out) + 1,
  )
}

reuse fn descent(
  out: List<List<Int>>,
  n: Int,
  from: List<Int>,
  halt: Bool,
  s: Descent,
  r: Int,
  height: Int,
  v: Int,
  next: List<Int>,
  i: Int,
  room: Int,
) -> DescentResult / {abort.raise} =
  if room <= 0 { out_of_budget() } else if height == 0 {
    match from.at(r) {
      None -> { pre: s.pre, post_order: s.post, back: None },
      Some(root) -> if root < 0 || root >= n || s.mark.get(root) >= 0 {
        descent(out, n, from, halt, s, r + 1, 0, -1, [], 0, room - 1)
      } else {
        let { mark, cursor, path, pre, post } = s;
        descent(
          out,
          n,
          from,
          halt,
          {
            mark: mark.set(root, 0),
            cursor: cursor,
            path: path.set(0, root),
            pre: pre.push(root),
            post: post,
          },
          r + 1,
          1,
          root,
          out.get(root),
          0,
          room - 1,
        )
      },
    }
  } else if i < next.len() {
    let w = next.get(i);
    let seen = if w < 0 || w >= n { n } else { s.mark.get(w) };
    if seen < 0 {
      let { mark, cursor, path, pre, post } = s;
      descent(
        out,
        n,
        from,
        halt,
        {
          mark: mark.set(w, height),
          cursor: cursor.set(v, i + 1),
          path: path.set(height, w),
          pre: pre.push(w),
          post: post,
        },
        r,
        height + 1,
        w,
        out.get(w),
        0,
        room - 1,
      )
    } else if halt && seen < n {
      { pre: s.pre, post_order: s.post, back: Some(s.path.take(height).drop(seen)) }
    } else { descent(out, n, from, halt, s, r, height, v, next, i + 1, room - 1) }
  } else {
    let { mark, cursor, path, pre, post } = s;
    let left = { mark: mark.set(v, n), cursor: cursor, path: path, pre: pre, post: post.push(v) };
    if height == 1 { descent(out, n, from, halt, left, r, 0, -1, [], 0, room - 1) } else {
      let up = left.path.get(height - 2);
      let resumed = left.cursor.get(up);
      descent(out, n, from, halt, left, r, height - 1, up, out.get(up), resumed, room - 1)
    }
  }

/// The nodes a breadth-first search from `from` reaches, nearest first.
///
/// The nodes of `from` come in the order given, then the nodes they have edges to, then the nodes
/// those have edges to. Each node comes once, where the search first found it, and a node of `from`
/// that is not in the graph is skipped.
pub fn breadth_first(g: Graph, from: List<Int>) -> List<Int> / {abort.raise} = spread(g, from).queue

/// The nodes `from` reaches, including themselves, in ascending order.
pub fn reachable(g: Graph, from: List<Int>) -> List<Int> / {abort.raise} = {
  let met = spread(g, from).met;
  range(0, g.out.len()).filter(|v: Int| met.at_or(v, false))
}

type Spread = { met: List<Bool>, queue: List<Int> }

fn spread(g: Graph, from: List<Int>) -> Spread / {abort.raise} = {
  let n = g.out.len();
  spreading(
    g.out,
    n,
    { met: range(0, n).map(|_: Int| false), queue: [] },
    0,
    from,
    0,
    from.len() + n + edge_count(g.out) + 1,
  )
}

reuse fn spreading(
  out: List<List<Int>>,
  n: Int,
  s: Spread,
  head: Int,
  next: List<Int>,
  i: Int,
  room: Int,
) -> Spread / {abort.raise} =
  if room <= 0 { out_of_budget() } else if i < next.len() {
    spreading(out, n, admit(n, s, next.get(i)), head, next, i + 1, room - 1)
  } else {
    match s.queue.at(head) {
      None -> s,
      Some(v) -> spreading(out, n, s, head + 1, out.get(v), 0, room - 1),
    }
  }

reuse fn admit(n: Int, s: Spread, v: Int) -> Spread / {abort.raise} =
  if v < 0 || v >= n || s.met.get(v) { s } else {
    let { met, queue } = s;
    { met: met.set(v, true), queue: queue.push(v) }
  }

/// A topological sort in progress, for a caller that runs the nodes itself.
///
/// `take` returns the nodes that may run, and `mark_done` marks one as finished, which releases the
/// nodes that were waiting only on it. For a node `take` has not yet returned, `waiting` is the
/// number of edges into it from nodes that are not done. For a node that is running, `waiting` is
/// -1, and for a node that is done it is -2. `ready` contains the nodes `take` will return next,
/// and `left` is the number of nodes not done.
pub type Sorter = new { graph: Graph, waiting: List<Int>, ready: Map<Int, Unit>, left: Int }

/// A sort of `g` with nothing done.
///
/// Its first `take` returns the nodes with no incoming edges. Raises `graph.cyclic` for a graph
/// with a cycle, whose nodes could never all be returned.
pub fn sorter(g: Graph) -> Sorter / {graph.cyclic, abort.raise} =
  match cycle(g) { Some(path) -> graph.cyclic(path), None -> sorter_unchecked(g) }

fn sorter_unchecked(g: Graph) -> Sorter / {abort.raise} = {
  let n = g.out.len();
  let waiting = g.out.fold(range(0, n).map(|_: Int| 0), |counts: List<Int>, next: List<Int>|
    next.fold(counts, |c: List<Int>, w: Int|
      if w < 0 || w >= n { c } else {
        let had = c.get(w);
        c.set(w, had + 1)
      }));
  let ready = range(0, n).fold(Map::new(), |m: Map<Int, Unit>, v: Int|
    if waiting.get(v) == 0 { m.insert(v, ()) } else { m });
  { graph: g, waiting: waiting, ready: ready, left: n }
}

/// The nodes that may run now, in ascending order, and the sort with them marked as running.
///
/// They are every node whose predecessors are all done and that `take` has not returned before.
/// There are none while the sort waits on a running node, and none once it is finished.
pub fn take(s: Sorter) -> { nodes: List<Int>, sorter: Sorter } / {abort.raise} = {
  let { graph: g, waiting, ready, left } = s;
  let nodes = ready.keys();
  {
    nodes: nodes,
    sorter: {
      graph: g,
      waiting: nodes.fold(waiting, |w: List<Int>, v: Int| w.set(v, -1)),
      ready: Map::new(),
      left: left,
    },
  }
}

/// The sort with `node` done.
///
/// `node` must be one that `take` returned and that is not yet done. Any other node is the
/// caller's mistake, and raises.
pub fn mark_done(s: Sorter, node: Int) -> Sorter / {abort.raise} = {
  let { graph: g, waiting, ready, left } = s;
  if waiting.at_or(node, 0) != -1 {
    panic("`mark_done` was called on a node that `take` has not returned or that is already done")
  } else {
    let n = g.out.len();
    let freed = g.out.get(node).fold(
      { waiting: waiting.set(node, -2), ready: ready },
      |accumulator: ReadyCounts, w: Int|
        if w < 0 || w >= n { accumulator } else {
          let { waiting: counts, ready: free } = accumulator;
          let still = counts.get(w) - 1;
          {
            waiting: counts.set(w, still),
            ready: if still == 0 { free.insert(w, ()) } else { free },
          }
        },
    );
    { graph: g, waiting: freed.waiting, ready: freed.ready, left: left - 1 }
  }
}

type ReadyCounts = { waiting: List<Int>, ready: Map<Int, Unit> }

/// Whether every node is done.
pub fn is_finished(s: Sorter) -> Bool = s.left == 0

/// The nodes grouped in the rounds a sort returns them in, when each round is done before the next.
///
/// First come the nodes with no incoming edges, then the nodes that waited only on those, and so
/// on: a node comes in the round after the last of its predecessors. A round is in ascending order,
/// and no edge joins two nodes of the same round. Raises `graph.cyclic` for a graph with a cycle.
pub fn layers(g: Graph) -> List<List<Int>> / {graph.cyclic, abort.raise} = {
  let swept = sweep(sorter_unchecked(g), [], g.out.len() + 1);
  if swept.sorter.left == 0 { swept.layers }
  else { match cycle(g) { Some(path) -> graph.cyclic(path), None -> out_of_budget() } }
}

type SweepResult = { sorter: Sorter, layers: List<List<Int>> }

fn sweep(s: Sorter, layers: List<List<Int>>, room: Int) -> SweepResult / {abort.raise} =
  if room <= 0 { out_of_budget() } else {
    let taken = take(s);
    if taken.nodes.len() == 0 { { sorter: taken.sorter, layers: layers } }
    else { sweep(taken.nodes.fold(taken.sorter, mark_done), layers.push(taken.nodes), room - 1) }
  }

/// Returns a topological order: every node, each before every node it has an edge to.
///
/// The order is `layers` joined end to end, so a node comes before the nodes of later layers, and
/// nodes in the same layer are in ascending order. Raises `graph.cyclic` for a graph with a cycle,
/// which has no such order.
pub fn order(g: Graph) -> List<Int> / {graph.cyclic, abort.raise} = layers(g).flatten()

/// `order`, or the path of a cycle where `order` raises.
pub fn try_order(g: Graph) -> Result<List<Int>, List<Int>> / {abort.raise} = try { order(g) }

/// The shortest paths from one node.
///
/// `distance` is how far each node is from `from`, or `None` for a node that `from` does not reach.
/// `before` is the previous node on a shortest path to each node, or `None` for `from` and for a
/// node that is not reached.
pub type Paths = new { from: Int, distance: List<Option<Int>>, before: List<Option<Int>> }

/// Returns the shortest paths from `from`, where following the edge from `a` to `b` costs
/// `weight(a, b)`.
///
/// This is Dijkstra's algorithm. A path's length is the sum of its edges' weights. When two
/// shortest paths reach a node, the path recorded in `before` is the one whose previous node is
/// nearer to `from`, and if both are equally near, the one whose previous node has the lower
/// number.
///
/// `weight` is called once for each edge leaving a node that `from` reaches. Raises
/// `graph.negative` at the first of those with a weight below zero. A `from` that is not a node
/// reaches nothing. If a distance overflows `Int`, this raises `abort.raise`, as any overflowing
/// sum does.
pub fn shortest<| e>(
  g: Graph,
  from: Int,
  weight: (Int, Int) -> Int / e,
) -> Paths / {graph.negative, abort.raise | e} = {
  let n = g.out.len();
  let unreached: Search = { distance: blank(n), before: blank(n), frontier: Map::new() };
  let add_if_new = if from < 0 || from >= n { unreached } else {
    let { distance, before, frontier } = unreached;
    resolve(
      g.out,
      n,
      weight,
      { distance: distance.set(from, 0), before: before, frontier: frontier.insert((0, from), ()) },
      n + 1,
    )
  };
  {
    from: from,
    distance: add_if_new.distance.map(none_if_negative),
    before: add_if_new.before.map(none_if_negative),
  }
}

fn none_if_negative(x: Int) -> Option<Int> = if x < 0 { None } else { Some(x) }

/// `shortest`, or the edge it raises `graph.negative` for.
pub fn try_shortest<| e>(
  g: Graph,
  from: Int,
  weight: (Int, Int) -> Int / e,
) -> Result<Paths, WeightedEdge> / {abort.raise | e} =
  try[graph.negative] { shortest(g, from, weight) }

type Search = { distance: List<Int>, before: List<Int>, frontier: Map<(Int, Int), Unit> }

fn resolve<| e>(
  out: List<List<Int>>,
  n: Int,
  weight: (Int, Int) -> Int / e,
  s: Search,
  room: Int,
) -> Search / {graph.negative, abort.raise | e} =
  if room <= 0 { out_of_budget() } else {
    let distance = s.distance;
    let before = s.before;
    match s.frontier.pop_first() {
      None -> { distance: distance, before: before, frontier: Map::new() },
      Some(nearest) -> {
        let d = nearest.key._0;
        let v = nearest.key._1;
        resolve(
          out,
          n,
          weight,
          out.get(v).fold(
            { distance: distance, before: before, frontier: nearest.rest },
            |accumulator: Search, w: Int|
              if w < 0 || w >= n { accumulator } else {
                let cost = weight(v, w);
                if cost < 0 { graph.negative({ from: v, target: w, weight: cost }) }
                else { relax(accumulator, v, w, d + cost) }
              },
          ),
          room - 1,
        )
      },
    }
  }

reuse fn relax(s: Search, v: Int, w: Int, through: Int) -> Search / {abort.raise} = {
  let known = s.distance.get(w);
  if known >= 0 && known <= through { s } else {
    let { distance, before, frontier } = s;
    {
      distance: distance.set(w, through),
      before: before.set(w, v),
      frontier: Map::insert(
        if known < 0 { frontier } else { frontier.remove((known, w)) },
        (through, w),
        (),
      ),
    }
  }
}

/// How far `to` is from where the paths start, or `None` if they do not reach it.
pub fn distance(p: Paths, to: Int) -> Option<Int> =
  match p.distance.at(to) { Some(d) -> d, None -> None }

/// A shortest path to `to`: the nodes from the start to `to`, both included, or `None` if the
/// paths do not reach it.
pub fn path(p: Paths, to: Int) -> Option<List<Int>> / {abort.raise} =
  match distance(p, to) {
    None -> None,
    Some(_) -> Some(follow_predecessors(p.before, to, [], p.before.len() + 1).reverse()),
  }

fn follow_predecessors(
  before: List<Option<Int>>,
  v: Int,
  accumulator: List<Int>,
  room: Int,
) -> List<Int> / {abort.raise} =
  if room <= 0 { out_of_budget() } else {
    match before.get(v) {
      None -> accumulator.push(v),
      Some(u) -> follow_predecessors(before, u, accumulator.push(v), room - 1),
    }
  }

/// A graph over nodes of any ordered type.
///
/// `keys` are the nodes in ascending order, each numbered by its position. `index` maps each node
/// to its number, and `graph` is the graph over those numbers, which every function here takes.
/// Results are numbers, and `named` maps them back to nodes.
pub type Keyed<k> = new { keys: List<k>, index: Map<k, Int>, graph: Graph }

/// The graph over `nodes` in which `next(node)` are a node's successors.
///
/// `next` is called once for each node, in ascending order. A node listed twice is one node, and
/// a successor that is not among `nodes` is not an edge.
pub fn keyed<k | e>(nodes: List<k>, next: (k) -> List<k> / e) -> Keyed<k> / e
  where derivable(ord, k)
= {
  let keys = nodes.fold(Map::new(), |m: Map<k, Unit>, key: k| m.insert(key, ())).keys();
  let numbered = keys.fold({ index: Map::new(), at: 0 }, |accumulator: Numbering<k>, key: k|
    { index: accumulator.index.insert(key, accumulator.at), at: accumulator.at + 1 });
  {
    keys: keys,
    index: numbered.index,
    graph: {
      out: keys.map(|key: k|
        next(key).fold([], |out: List<Int>, to: k|
          match numbered.index.get(to) { Some(w) -> out.push(w), None -> out })),
    },
  }
}

type Numbering<k> = { index: Map<k, Int>, at: Int }

/// Returns the graph of everything `roots` reach, where `next(node)` returns a node's successors.
///
/// `next` is called once for each node, nearest to the roots first. Returns `None` if the roots
/// reach more than `limit` nodes, and the search stops calling `next` at that point.
pub fn explore<k | e>(
  roots: List<k>,
  next: (k) -> List<k> / e,
  limit: Int,
) -> Option<Keyed<k>> / {abort.raise | e}
  where derivable(ord, k)
= {
  let start = roots.fold({ met: Map::new(), queue: [], successors: Map::new() }, add_if_new);
  let walked = explore_from(next, limit, start, 0, limit + 1);
  if walked.met.len() > limit { None } else {
    Some(
      keyed(walked.queue, |key: k| match walked.successors.get(key) { Some(to) -> to, None -> [] }),
    )
  }
}

type Exploration<k> = { met: Map<k, Unit>, queue: List<k>, successors: Map<k, List<k>> }

fn add_if_new<k>(s: Exploration<k>, key: k) -> Exploration<k>
  where derivable(ord, k)
=
  if s.met.contains(key) { s } else {
    let { met, queue, successors: successors } = s;
    { met: met.insert(key, ()), queue: queue.push(key), successors: successors }
  }

fn explore_from<k | e>(
  next: (k) -> List<k> / e,
  limit: Int,
  s: Exploration<k>,
  head: Int,
  room: Int,
) -> Exploration<k> / {abort.raise | e}
  where derivable(ord, k)
=
  if s.met.len() > limit { s } else {
    match s.queue.at(head) {
      None -> s,
      Some(key) -> if room <= 0 { out_of_budget() } else {
        let to = next(key);
        let { met, queue, successors: successors } = s;
        explore_from(
          next,
          limit,
          to.fold({ met: met, queue: queue, successors: successors.insert(key, to) }, add_if_new),
          head + 1,
          room - 1,
        )
      },
    }
  }

/// The number of the node `key`, or `None` if the graph has no such node.
pub fn node<k>(g: Keyed<k>, key: k) -> Option<Int>
  where derivable(ord, k)
= g.index.get(key)

/// The numbers of `keys`, in their order. A key that is not a node is left out.
pub fn numbered<k>(g: Keyed<k>, keys: List<k>) -> List<Int>
  where derivable(ord, k)
=
  keys.fold([], |accumulator: List<Int>, key: k|
    match g.index.get(key) { Some(v) -> accumulator.push(v), None -> accumulator })

/// Returns the nodes numbered by `nodes`, in the same order. A number that is not a node is left
/// out.
pub fn named<k>(g: Keyed<k>, nodes: List<Int>) -> List<k> =
  nodes.fold([], |accumulator: List<k>, v: Int|
    match g.keys.at(v) { Some(key) -> accumulator.push(key), None -> accumulator })

fn rings() -> Graph = { out: [[1], [2], [0, 3], [4], [3], [0]] }

effect asks {
  write one() -> Unit
  read total() -> Int
}

test "a graph is its nodes' successors, however it was built" {
  let g = of_edges(3, [
    { from: 0, target: 2 },
    { from: 2, target: 1 },
    { from: 0, target: 1 },
    { from: 7, target: 0 },
  ]);
  assert_eq(g, { out: [[2, 1], [], [1]] });
  assert_eq(of(3, |v: Int| if v == 0 { [2, 1] } else if v == 2 { [1] } else { [] }), g);
  assert_eq(size(g), 3);
  assert_eq(edges(g), [{ from: 0, target: 2 }, { from: 0, target: 1 }, { from: 2, target: 1 }]);
  assert_eq(transpose(g), { out: [[], [0, 2], [0]] });
  let loose: Graph = { out: [[1, 5, -1], [0]] };
  assert_eq(successors(loose, 0), [1]);
  assert_eq(successors(loose, 5), []);
  assert_eq(edges(loose), [{ from: 0, target: 1 }, { from: 1, target: 0 }])
}

test "`components` returns strongly connected components with dependencies before dependents, each listing nodes in depth-first discovery order" {
  assert_eq(components(rings()), [[3, 4], [0, 1, 2], [5]]);
  assert_eq(components({ out: [[2], [0], [1]] }), [[0, 2, 1]]);
  assert_eq(components({ out: [[1, 9], [0, -1], []] }), [[0, 1], [2]]);
  assert_eq(components({ out: [] }), [])
}

test "a condensation is the components and the edges between them, each once" {
  let c = condensation(rings());
  assert_eq(c.members, [[3, 4], [0, 1, 2], [5]]);
  assert_eq(c.component, [1, 1, 1, 0, 0, 2]);
  assert_eq(c.graph, { out: [[], [0], [1]] });
  assert_eq(condensation({ out: [[1, 2], [0, 2, 2], []] }).graph, { out: [[], [0]] })
}

test "`cycle` returns the nodes of a cycle in the order a depth-first search walks them, and None for a graph without one" {
  assert_eq(cycle(rings()), Some([0, 1, 2]));
  assert_eq(cycle({ out: [[1], [2], [1]] }), Some([1, 2]));
  assert_eq(cycle({ out: [[], [1]] }), Some([1]));
  assert_eq(cycle({ out: [[1, 2], [3], [3], []] }), None);
  assert_eq(cycle({ out: [] }), None)
}

test "a traversal visits each node once: depth first by first successor, breadth first by nearest" {
  let g: Graph = { out: [[1, 2], [3], [3, 4], [], [0], [0]] };
  assert_eq(depth_first(g, [0]), [0, 1, 3, 2, 4]);
  assert_eq(post_order(g, [0]), [3, 1, 4, 2, 0]);
  assert_eq(breadth_first(g, [0]), [0, 1, 2, 3, 4]);
  assert_eq(reachable(g, [0]), [0, 1, 2, 3, 4]);
  assert_eq(reachable(g, [3]), [3]);
  assert_eq(breadth_first(g, [5, 9, 3, 5]), [5, 3, 0, 1, 2, 4]);
  assert_eq(depth_first(g, [3, 2]), [3, 2, 4, 0, 1]);
  assert_eq(reachable(g, []), [])
}

test "`order` lists every edge's source before its target, `layers` groups nodes into levels, and `try_order` returns a cycle's nodes as an error" {
  let g: Graph = { out: [[2], [2], [3], [], []] };
  assert_eq(layers(g), [[0, 1, 4], [2], [3]]);
  assert_eq(order(g), [0, 1, 4, 2, 3]);
  assert_eq(try_order(g), Ok([0, 1, 4, 2, 3]));
  assert_eq(try_order(rings()), Err([0, 1, 2]));
  assert_eq(try { layers({ out: [[1], [0]] }) }, Err([0, 1]));
  assert_eq(order({ out: [] }), [])
}

test "a sorter returns a node once its predecessors are done, and never twice" {
  let first = take(sorter({ out: [[1, 2], [3], [3], []] }));
  assert_eq(first.nodes, [0]);
  assert_eq(take(first.sorter).nodes, []);
  let second = take(mark_done(first.sorter, 0));
  assert_eq(second.nodes, [1, 2]);
  let waiting = take(mark_done(second.sorter, 2));
  assert_eq(waiting.nodes, []);
  assert(!is_finished(waiting.sorter));
  let last = take(mark_done(waiting.sorter, 1));
  assert_eq(last.nodes, [3]);
  assert(is_finished(mark_done(last.sorter, 3)))
}

test "`sorter` rejects a graph with a cycle, and `mark_done` aborts for a node whose prerequisites are not done or that is already done" {
  assert_eq(match try { sorter(rings()) } { Ok(_) -> [], Err(path) -> path }, [0, 1, 2]);
  let taken = take(sorter({ out: [[1], []] }));
  let early = try[abort.raise] { mark_done(taken.sorter, 1) };
  assert(match early { Ok(_) -> false, Err(_) -> true });
  let twice = try[abort.raise] { mark_done(mark_done(taken.sorter, 0), 0) };
  assert(match twice { Ok(_) -> false, Err(_) -> true })
}

test "`shortest` finds minimum-weight paths from a start node, and unreachable nodes have no distance or path" {
  let g: Graph = { out: [[1, 2], [2], [3], [0], []] };
  let p = shortest(g, 0, |a: Int, b: Int|
    if a == 0 && b == 2 { 5 } else if b == 3 { 2 } else { 1 });
  assert_eq(p.distance, [Some(0), Some(1), Some(2), Some(4), None]);
  assert_eq(p.before, [None, Some(0), Some(1), Some(2), None]);
  assert_eq(distance(p, 3), Some(4));
  assert_eq(distance(p, 4), None);
  assert_eq(distance(p, 9), None);
  assert_eq(path(p, 3), Some([0, 1, 2, 3]));
  assert_eq(path(p, 0), Some([0]));
  assert_eq(path(p, 4), None);
  assert_eq(shortest(g, 7, |_: Int, _: Int| 1).distance, [None, None, None, None, None])
}

test "`try_shortest` returns the edge with a negative weight as an error, but only when that edge is reachable from the start node" {
  let g: Graph = { out: [[1], [2], []] };
  assert_eq(
    match try_shortest(g, 0, |a: Int, _: Int| 1 - 3 * a) { Ok(_) -> None, Err(edge) -> Some(edge) },
    Some({ from: 1, target: 2, weight: -2 }),
  );
  assert_eq(match try_shortest(g, 2, |_: Int, _: Int| -1) { Ok(p) -> p.distance, Err(_) -> [] }, [
    None,
    None,
    Some(0),
  ])
}

test "nodes of any ordered type are numbered in their order, and a result maps back to them" {
  let needs = |name: String|
    if name == "app" { ["lib", "std", "gone"] } else if name == "lib" { ["std"] } else { [] };
  let g = keyed(["std", "app", "lib", "app"], needs);
  assert_eq(g.keys, ["app", "lib", "std"]);
  assert_eq(g.graph, { out: [[1, 2], [2], []] });
  assert_eq(node(g, "lib"), Some(1));
  assert_eq(node(g, "gone"), None);
  assert_eq(named(g, order(g.graph)), ["app", "lib", "std"]);
  assert_eq(named(g, reachable(g.graph, numbered(g, ["lib", "gone"]))), ["lib", "std"]);
  assert_eq(named(g, [2, 7, 0]), ["std", "app"])
}

test "`explore` expands each reachable node once, and returns None when the node count exceeds its limit" {
  let expansion_count = handle {
    let halves = |n: Int| {
      asks.one();
      if n <= 1 { [] } else { [n / 2, n - n / 2] }
    };
    match explore([12, 12], halves, 8) {
      None -> assert(false),
      Some(g) -> {
        assert_eq(g.keys, [1, 2, 3, 6, 12]);
        assert_eq(g.graph, { out: [[], [0, 0], [0, 1], [2, 2], [3, 3]] })
      },
    };
    asks.total()
  } with {
    var n = 0,
    asks.one() -> {
      n = n + 1;
    },
    asks.total() -> n,
  };
  assert_eq(expansion_count, 5);
  let doubles = |n: Int| [n * 2, n * 2 + 1];
  assert(match explore([1], doubles, 100) { None -> true, Some(_) -> false });
  assert(match explore([1], |_: Int| [], 0) { None -> true, Some(_) -> false })
}

fn chain(n: Int) -> Graph = { out: range(0, n).map(|v: Int| if v + 1 < n { [v + 1] } else { [] }) }

test "a chain deeper than the call stack is traversed like any other" {
  let n = 20000;
  let g = chain(n);
  assert_eq(components(g).len(), n);
  assert_eq(cycle(g), None);
  assert_eq(order(g), range(0, n));
  assert_eq(depth_first(g, [0]), range(0, n));
  assert_eq(breadth_first(g, [0]), range(0, n));
  assert_eq(reachable(g, [n / 2]).len(), n - n / 2);
  assert_eq(components(of(n, |v: Int| [(v + 1) % n])).get(0).len(), n);
  let p = shortest(g, 0, |_: Int, _: Int| 2);
  assert_eq(distance(p, n - 1), Some(2 * (n - 1)));
  assert_eq(match path(p, n - 1) { Some(nodes) -> nodes.len(), None -> 0 }, n)
}

fn drawn(n: Int, seeds: List<Int>) -> Graph / {abort.raise} =
  of_edges(
    n,
    range(0, seeds.len() / 2).map(|i: Int|
      { from: within(n, seeds.get(2 * i)), target: within(n, seeds.get(2 * i + 1)) }),
  )

fn within(n: Int, x: Int) -> Int / {abort.raise} = (x % n + n) % n

fn has_edge(g: Graph, from: Int, target: Int) -> Bool = successors(g, from).contains(target)

fn closure(g: Graph, from: Int) -> List<Int> = {
  let n = size(g);
  range(0, n).fold(
    if from >= 0 && from < n { [from] } else { [] },
    |add_if_new: List<Int>, _: Int|
      edges(g).fold(add_if_new, |accumulator: List<Int>, e: Edge|
        if accumulator.contains(e.from) && !accumulator.contains(e.target) {
          accumulator.push(e.target)
        } else { accumulator }),
  ).sort(
  )
}

fn positions(n: Int, order: List<Int>) -> List<Int> / {abort.raise} =
  range(0, order.len()).fold(blank(n), |at_of: List<Int>, i: Int| at_of.set(order.get(i), i))

fn runs_forward(g: Graph, order: List<Int>) -> Bool / {abort.raise} = {
  let place = positions(size(g), order);
  order.sort() == range(0, size(g))
    && edges(g).fold(true, |ok: Bool, e: Edge| ok && place.get(e.from) < place.get(e.target))
}

fn closes(g: Graph, path: List<Int>) -> Bool / {abort.raise} =
  path.len() > 0
    && range(0, path.len()).fold(true, |ok: Bool, i: Int|
      ok && has_edge(g, path.get(i), path.get((i + 1) % path.len())))

test "depth-first, post-order and breadth-first traversals from a node each visit exactly the nodes reachable from it" {
  gen::check(gen::list(gen::any_int()), |seeds: List<Int>| {
    let g = drawn(6, seeds);
    let from = [seeds.len() % 6];
    depth_first(g, from).sort() == reachable(g, from)
      && post_order(g, from).sort() == reachable(g, from)
      && breadth_first(g, from).sort() == reachable(g, from)
  })
}

test "`components` groups nodes that can each be reached from one another, checked against a reference built from transitive closure" {
  gen::check(gen::list(gen::any_int()), |x: List<Int>|
    agrees(
      |seeds: List<Int>| components(drawn(6, seeds)).map(|c: List<Int>| c.sort()).sort(),
      |seeds: List<Int>| {
        let g = drawn(6, seeds);
        range(0, 6).map(|v: Int| closure(g, v).filter(|u: Int| closure(g, u).contains(v))).unique()
      },
      x,
    ))
}

test "every edge goes forward in a topological order, and a graph without one has a cycle" {
  gen::check(gen::list(gen::any_int()), |seeds: List<Int>| {
    let g = drawn(6, seeds);
    match try_order(g) {
      Ok(order) -> runs_forward(g, order) && cycle(g) == None,
      Err(path) -> closes(g, path) && cycle(g) == Some(path),
    }
  })
}

fn edge_weight(seeds: List<Int>, a: Int, b: Int) -> Int = (a * 7 + b * 3 + seeds.len()) % 5

fn relaxed(g: Graph, from: Int, seeds: List<Int>) -> List<Int> / {abort.raise} =
  range(0, size(g)).fold(blank(size(g)).set(from, 0), |far: List<Int>, _: Int|
    edges(g).fold(far, |d: List<Int>, e: Edge| {
      let near = d.get(e.from);
      let through = near + edge_weight(seeds, e.from, e.target);
      if near >= 0 && (d.get(e.target) < 0 || through < d.get(e.target)) {
        d.set(e.target, through)
      } else { d }
    }))

test "the shortest distances match the ones that relaxing every edge produces" {
  gen::check(gen::list(gen::any_int()), |x: List<Int>|
    agrees(
      |seeds: List<Int>|
        shortest(drawn(6, seeds), seeds.len() % 6, |a: Int, b: Int|
          edge_weight(seeds, a, b)).distance,
      |seeds: List<Int>| relaxed(drawn(6, seeds), seeds.len() % 6, seeds).map(none_if_negative),
      x,
    ))
}
