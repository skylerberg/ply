//! HTTP/2 (RFC 9113) and its header compression, HPACK (RFC 7541), as a state machine with no I/O:
//! bytes in, events and bytes out.
//!
//! The frame codec reads and writes every frame type. `read_frame` rejects what the standard calls
//! a connection or a stream error by raising `http2.violated`. HPACK is an `Encoder` and a
//! `Decoder`, each with the static table, the Huffman code and its own dynamic table.
//!
//! A `Connection` is one end of a connection, a server's or a client's. `receive` passes it bytes
//! read from the peer and returns the `Event`s they produce. `respond` and `request` pass it
//! messages to send, and `take_output` returns the bytes to write. A `Response` has the same shape
//! as `std.http`'s, so either converts to the other, and `std.http` reads a `Request` as its own.
//! `std.http` serves and fetches over this machine, so an application does not know which
//! protocol carried a message. Time is what the caller passes as `now`. `tick` acts on what depends
//! only on the clock, and `deadline` reports when it next needs to run. The machine reads no socket
//! and no clock, so an exchange is data, and two machines given each other's bytes test each other.
//!
//! `Limits` sets the cost a peer can impose on one connection, and each known attack on HTTP/2 has
//! a field: rapid reset (CVE-2023-44487) is `max_resets`; the CONTINUATION flood is
//! `max_continuations` and `max_header_block`; an HPACK bomb is `max_header_list_size`,
//! `max_table_size` and `max_table_size_updates`; SETTINGS and PING floods are `max_settings` and
//! `max_pings`; frames that carry nothing are `max_empty_frames`; and a reader that never opens its
//! window is `stall_ms` and `max_buffered`. Past a limit, the stream or the connection is rejected,
//! and a rejected connection gets a `GOAWAY`. `drain` closes a connection gracefully: the streams
//! it accepted get responses, and the peer is told which streams it did not accept.
//!
//! Server push and the priority tree are not supported: a server pushes nothing, and both ends
//! read priorities and ignore them, as RFC 9113 allows. A `CONNECT` request gets a 501 response.

import std.bytes (is_blank, u32_be)
import std.gen
import std.gen (Gen)
import std.laws (round_trip)
import std.list
import std.string
import std.time (at_millis)

// --- Errors -------------------------------------------------------------------

/// What a `RST_STREAM` or a `GOAWAY` reports went wrong (RFC 9113 §7). A code the standard does
/// not assign keeps its number, and is treated as `InternalError`.
pub type ErrorCode =
  | NoError
  | ProtocolError
  | InternalError
  | FlowControlError
  | SettingsTimeout
  | StreamClosed
  | FrameSizeError
  | RefusedStream
  | Cancel
  | CompressionError
  | ConnectError
  | EnhanceYourCalm
  | InadequateSecurity
  | Http11Required
  | Unassigned(Int)

fn assigned_codes() -> List<ErrorCode> =
  [
    NoError,
    ProtocolError,
    InternalError,
    FlowControlError,
    SettingsTimeout,
    StreamClosed,
    FrameSizeError,
    RefusedStream,
    Cancel,
    CompressionError,
    ConnectError,
    EnhanceYourCalm,
    InadequateSecurity,
    Http11Required,
  ]

/// The code as RFC 9113 names it, `PROTOCOL_ERROR` for `ProtocolError`; an unassigned one as
/// its number in hexadecimal.
pub fn code_name(c: ErrorCode) -> String / {abort.raise} =
  match c {
    Unassigned(n) -> "0x" ++ u32_be(n).hex_of(),
    _ ->
      [
        "NO_ERROR",
        "PROTOCOL_ERROR",
        "INTERNAL_ERROR",
        "FLOW_CONTROL_ERROR",
        "SETTINGS_TIMEOUT",
        "STREAM_CLOSED",
        "FRAME_SIZE_ERROR",
        "REFUSED_STREAM",
        "CANCEL",
        "COMPRESSION_ERROR",
        "CONNECT_ERROR",
        "ENHANCE_YOUR_CALM",
        "INADEQUATE_SECURITY",
        "HTTP_1_1_REQUIRED",
      ].at_or(
        code_number(c),
        "",
      ),
  }

/// The code's number on the wire.
pub fn code_number(c: ErrorCode) -> Int =
  match c {
    NoError -> 0,
    ProtocolError -> 1,
    InternalError -> 2,
    FlowControlError -> 3,
    SettingsTimeout -> 4,
    StreamClosed -> 5,
    FrameSizeError -> 6,
    RefusedStream -> 7,
    Cancel -> 8,
    CompressionError -> 9,
    ConnectError -> 10,
    EnhanceYourCalm -> 11,
    InadequateSecurity -> 12,
    Http11Required -> 13,
    Unassigned(n) -> n,
  }

/// The code a number names; a number the standard does not assign is `Unassigned`.
pub fn code_of(n: Int) -> ErrorCode =
  if n < 0 { Unassigned(n) }
  else { match assigned_codes().at(n) { Some(c) -> c, None -> Unassigned(n) } }

/// A peer's breach of the protocol: the code to respond with, the stream it is limited to (`0` for
/// the whole connection), and what was wrong.
pub type Violation = new { code: ErrorCode, stream: Int, reason: String }

/// What this module raises when it rejects bytes.
pub effect http2 {
  /// The bytes break the protocol, as the violation describes.
  raise violated(v: Violation)
}

fn violation<a>(code: ErrorCode, stream: Int, reason: String) -> a / {http2.violated} =
  http2.violated({ code: code, stream: stream, reason: reason })

// --- Frames -------------------------------------------------------------------

/// The connection preface a client opens with, before its first `SETTINGS` (RFC 9113 §3.4).
pub fn preface() -> Bytes = b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

/// The largest frame every endpoint accepts until its peer allows more, and the smallest maximum a
/// peer may set.
pub fn default_frame_size() -> Int = 16384

/// The largest frame size a peer may allow: a frame's length is 24 bits.
pub fn largest_frame_size() -> Int = 16777215

/// The largest flow-control window, and the largest stream identifier: 2^31-1.
pub fn largest_window() -> Int = 2147483647

/// The window every stream and the connection start with, until `SETTINGS` say otherwise.
pub fn default_window() -> Int = 65535

/// The dynamic table size HPACK starts with on each side.
pub fn default_table_size() -> Int = 4096

/// A stream's place in the priority tree RFC 7540 had clients build, which RFC 9113 says to parse
/// and ignore: the stream it depends on, whether exclusively, and its weight from 1 to 256.
pub type Priority = { depends_on: Int, exclusive: Bool, weight: Int }

/// One parameter of a `SETTINGS` frame (RFC 9113 §6.5.2). A reader stores one the standard does not
/// define as `Unknown`, with its identifier and its value, and nothing acts on it.
pub type Setting =
  | HeaderTableSize(Int)
  | EnablePush(Bool)
  | MaxConcurrentStreams(Int)
  | InitialWindowSize(Int)
  | MaxFrameSize(Int)
  | MaxHeaderListSize(Int)
  | Unknown(Int, Int)

/// A frame (RFC 9113 §6). `padding` is how many octets of padding a padded frame carries, `None` for
/// a frame without the flag. A `block` is a piece of a field block HPACK wrote, which a `HEADERS` or
/// `PUSH_PROMISE` frame and the `CONTINUATION` frames after it carry between them.
pub type Frame =
  | DataFrame({ stream: Int, data: Bytes, end_stream: Bool, padding: Option<Int> })
  | HeadersFrame({ stream: Int, block: Bytes, end_stream: Bool, end_headers: Bool, priority: Option<Priority>, padding: Option<Int> })
  | PriorityFrame({ stream: Int, priority: Priority })
  | ResetFrame({ stream: Int, code: ErrorCode })
  | SettingsFrame({ ack: Bool, settings: List<Setting> })
  | PushPromiseFrame({ stream: Int, promised: Int, block: Bytes, end_headers: Bool, padding: Option<Int> })
  | PingFrame({ ack: Bool, data: Bytes })
  | GoAwayFrame({ last_stream: Int, code: ErrorCode, debug: Bytes })
  | WindowUpdateFrame({ stream: Int, increment: Int })
  | ContinuationFrame({ stream: Int, block: Bytes, end_headers: Bool })
  /// A frame of a type RFC 9113 does not define, which a reader ignores.
  | UnknownFrame({ kind: Int, flags: Int, stream: Int, payload: Bytes })

/// The octets a frame takes from a flow-control window: its whole payload, padding included. Only
/// `DATA` frames take any.
pub fn flow_length(f: Frame) -> Int =
  match f {
    DataFrame(d) -> d.data.len() + (match d.padding { None -> 0, Some(n) -> n + 1 }),
    _ -> 0,
  }

fn flag(on: Bool, bit: Int) -> Int = if on { bit } else { 0 }

fn is_set(flags: Int, bit: Int) -> Bool = flags & bit != 0

fn word(b: Bytes, at: Int) -> Int = match b.u32_be_at(at) { Some(n) -> n, None -> 0 }

/// The bytes of a frame. Panics on one no peer may be sent: a payload past 2^24-1 octets, padding
/// past 255, a stream, a promised stream or an increment past 31 bits, or a ping that is not eight
/// octets.
pub fn encode_frame(f: Frame) -> Bytes / {abort.raise} =
  match f {
    DataFrame(d) ->
      framed(
        0,
        flag(d.end_stream, 0x1) | flag(d.padding != None, 0x8),
        d.stream,
        padded(d.data, d.padding),
      ),
    HeadersFrame(h) ->
      framed(
        1,
        flag(h.end_stream, 0x1) | flag(h.end_headers, 0x4) | flag(h.padding != None, 0x8)
          | flag(h.priority != None, 0x20),
        h.stream,
        padded(priority_bytes(h.priority).concat(h.block), h.padding),
      ),
    PriorityFrame(p) -> framed(2, 0, p.stream, priority_bytes(Some(p.priority))),
    ResetFrame(r) -> framed(3, 0, r.stream, u32_be(code_number(r.code))),
    SettingsFrame(s) ->
      framed(4, flag(s.ack, 0x1), 0, Bytes::concat_all(s.settings.map(setting_bytes))),
    PushPromiseFrame(p) ->
      framed(
        5,
        flag(p.end_headers, 0x4) | flag(p.padding != None, 0x8),
        p.stream,
        padded(u32_be(checked_window_increment(p.promised)).concat(p.block), p.padding),
      ),
    PingFrame(p) -> if p.data.len() != 8 { panic("a PING carries eight octets") }
    else { framed(6, flag(p.ack, 0x1), 0, p.data) },
    GoAwayFrame(g) ->
      framed(
        7,
        0,
        0,
        Bytes::concat_all([
          u32_be(checked_window_increment(g.last_stream)),
          u32_be(code_number(g.code)),
          g.debug,
        ]),
      ),
    WindowUpdateFrame(w) -> framed(8, 0, w.stream, u32_be(checked_window_increment(w.increment))),
    ContinuationFrame(c) -> framed(9, flag(c.end_headers, 0x4), c.stream, c.block),
    UnknownFrame(u) -> framed(u.kind, u.flags, u.stream, u.payload),
  }

fn checked_window_increment(n: Int) -> Int / {abort.raise} =
  if n < 0 || n > largest_window() { panic(n.to_string() ++ " is past 31 bits") } else { n }

fn framed(kind: Int, flags: Int, stream: Int, payload: Bytes) -> Bytes / {abort.raise} = {
  let n = payload.len();
  if n > largest_frame_size() {
    panic("a frame's payload is at most 16777215 octets, not " ++ n.to_string())
  } else {
    Bytes::concat_all([
      byte_of_int(n >>> 16 & 0xFF),
      byte_of_int(n >>> 8 & 0xFF),
      byte_of_int(n & 0xFF),
      byte_of_int(kind),
      byte_of_int(flags),
      u32_be(checked_window_increment(stream)),
      payload,
    ])
  }
}

fn padded(body: Bytes, padding: Option<Int>) -> Bytes / {abort.raise} =
  match padding {
    None -> body,
    Some(n) -> if n < 0 || n > 255 { panic("padding is 0 to 255 octets") }
    else { Bytes::concat_all([byte_of_int(n), body, b"\x00".repeat(n)]) },
  }

fn priority_bytes(p: Option<Priority>) -> Bytes / {abort.raise} =
  match p {
    None -> b"",
    Some(q) -> if q.weight < 1 || q.weight > 256 { panic("a weight is 1 to 256") } else {
      u32_be(checked_window_increment(q.depends_on) | flag(q.exclusive, 0x8000_0000)).concat(
        byte_of_int(q.weight - 1),
      )
    },
  }

fn setting_bytes(s: Setting) -> Bytes = {
  let pair = setting_pair(s);
  Bytes::concat_all([
    byte_of_int(pair.id >>> 8 & 0xFF),
    byte_of_int(pair.id & 0xFF),
    u32_be(pair.value),
  ])
}

fn setting_pair(s: Setting) -> { id: Int, value: Int } =
  match s {
    HeaderTableSize(n) -> { id: 1, value: n },
    EnablePush(on) -> { id: 2, value: if on { 1 } else { 0 } },
    MaxConcurrentStreams(n) -> { id: 3, value: n },
    InitialWindowSize(n) -> { id: 4, value: n },
    MaxFrameSize(n) -> { id: 5, value: n },
    MaxHeaderListSize(n) -> { id: 6, value: n },
    Unknown(id, value) -> { id: id, value: value },
  }

/// A frame read, and where the bytes after it start.
pub type ReadResult = { frame: Frame, next: Int }

/// The length of the frame whose header starts at `at`, or `None` where `buf` ends before its
/// header does.
pub fn frame_length(buf: Bytes, at: Int) -> Option<Int> =
  if at < 0 || buf.len() - at < 9 { None }
  else { Some(buf.at(at) << 16 | buf.at(at + 1) << 8 | buf.at(at + 2)) }

/// The frame at `at`, or `None` when `buf` ends before the frame does. A frame longer than
/// `max_size` is rejected as soon as its header arrives, without waiting for its payload. A
/// violation limited to a stream is raised only when reading the frame changed nothing else, so a
/// reader can reset the stream and continue after the frame, whose length its header gives.
pub fn read_frame(
  buf: Bytes,
  at: Int,
  max_size: Int,
) -> Option<ReadResult> / {http2.violated, abort.raise} =
  match frame_length(buf, at) {
    None -> None,
    Some(length) -> if length > max_size {
      violation(
        FrameSizeError,
        0,
        "a frame of " ++ length.to_string() ++ " octets, past the " ++ max_size.to_string()
          ++ " allowed",
      )
    } else if buf.len() - at - 9 < length { None } else {
      Some({
        frame: frame_of(
          buf.at(at + 3),
          buf.at(at + 4),
          word(buf, at + 5) & 0x7FFF_FFFF,
          buf.slice(at + 9, at + 9 + length),
        ),
        next: at + 9 + length,
      })
    },
  }

fn frame_of(
  kind: Int,
  flags: Int,
  stream: Int,
  payload: Bytes,
) -> Frame / {http2.violated, abort.raise} =
  if kind == 0 { data_of(flags, stream, payload) }
  else if kind == 1 { headers_of(flags, stream, payload) }
  else if kind == 2 { read_priority_frame(stream, payload) }
  else if kind == 3 { reset_of(stream, payload) }
  else if kind == 4 { read_settings_frame(flags, stream, payload) }
  else if kind == 5 { push_promise_of(flags, stream, payload) }
  else if kind == 6 { ping_of(flags, stream, payload) }
  else if kind == 7 { goaway_of(stream, payload) }
  else if kind == 8 { window_update_of(stream, payload) }
  else if kind == 9 { continuation_of(flags, stream, payload) }
  else { UnknownFrame({ kind: kind, flags: flags, stream: stream, payload: payload }) }

fn on_stream(stream: Int, name: String) -> Unit / {http2.violated} =
  if stream == 0 { violation(ProtocolError, 0, "a " ++ name ++ " frame on stream 0") } else { () }

fn on_connection(stream: Int, name: String) -> Unit / {http2.violated} =
  if stream != 0 { violation(ProtocolError, 0, "a " ++ name ++ " frame on a stream") } else { () }

type Unpadded = { body: Bytes, padding: Option<Int> }

/// A padded payload without its padding. Padding as long as the payload is rejected (§6.1).
fn unpadded(flags: Int, payload: Bytes) -> Unpadded / {http2.violated} =
  if !is_set(flags, 0x8) { { body: payload, padding: None } } else if payload.len() == 0 {
    violation(FrameSizeError, 0, "a padded frame without its pad length")
  } else {
    let pad = payload.at(0);
    if pad >= payload.len() {
      violation(ProtocolError, 0, "the padding length must be less than the length of the frame payload")
    } else { { body: payload.slice(1, payload.len() - pad), padding: Some(pad) } }
  }

fn priority_at(b: Bytes, at: Int) -> Priority / {abort.raise} = {
  let w = word(b, at);
  { depends_on: w & 0x7FFF_FFFF, exclusive: is_set(w, 0x8000_0000), weight: b.at(at + 4) + 1 }
}

fn data_of(flags: Int, stream: Int, payload: Bytes) -> Frame / {http2.violated} = {
  on_stream(stream, "DATA");
  let p = unpadded(flags, payload);
  DataFrame({ stream: stream, data: p.body, end_stream: is_set(flags, 0x1), padding: p.padding })
}

/// A `HEADERS` frame that makes its stream depend on itself is read unchanged: its block must
/// still be decoded, so the reader raises the stream error after decoding it.
fn headers_of(flags: Int, stream: Int, payload: Bytes) -> Frame / {http2.violated, abort.raise} = {
  on_stream(stream, "HEADERS");
  let p = unpadded(flags, payload);
  let prioritized = is_set(flags, 0x20);
  if prioritized && p.body.len() < 5 {
    violation(FrameSizeError, 0, "a HEADERS frame too short for its priority")
  } else {
    HeadersFrame({
      stream: stream,
      block: if prioritized { p.body.slice(5, p.body.len()) } else { p.body },
      end_stream: is_set(flags, 0x1),
      end_headers: is_set(flags, 0x4),
      priority: if prioritized { Some(priority_at(p.body, 0)) } else { None },
      padding: p.padding,
    })
  }
}

fn read_priority_frame(stream: Int, payload: Bytes) -> Frame / {http2.violated, abort.raise} = {
  on_stream(stream, "PRIORITY");
  if payload.len() != 5 {
    violation(FrameSizeError, stream, "a PRIORITY frame of other than five octets")
  } else {
    let q = priority_at(payload, 0);
    if q.depends_on == stream {
      violation(ProtocolError, stream, "a stream that depends on itself")
    } else { PriorityFrame({ stream: stream, priority: q }) }
  }
}

fn reset_of(stream: Int, payload: Bytes) -> Frame / {http2.violated} = {
  on_stream(stream, "RST_STREAM");
  if payload.len() != 4 {
    violation(FrameSizeError, 0, "a RST_STREAM frame of other than four octets")
  } else { ResetFrame({ stream: stream, code: code_of(word(payload, 0)) }) }
}

fn read_settings_frame(
  flags: Int,
  stream: Int,
  payload: Bytes,
) -> Frame / {http2.violated, abort.raise} = {
  on_connection(stream, "SETTINGS");
  if is_set(flags, 0x1) {
    if payload.len() != 0 {
      violation(FrameSizeError, 0, "a SETTINGS acknowledgement with a payload")
    } else { SettingsFrame({ ack: true, settings: [] }) }
  } else if payload.len() % 6 != 0 {
    violation(FrameSizeError, 0, "a SETTINGS frame whose length is not a multiple of six")
  } else {
    SettingsFrame({
      ack: false,
      settings: range(0, payload.len() / 6).map(|i: Int| setting_at(payload, i * 6)),
    })
  }
}

fn setting_at(b: Bytes, at: Int) -> Setting / {http2.violated, abort.raise} = {
  let id = b.at(at) << 8 | b.at(at + 1);
  let value = word(b, at + 2);
  if id == 1 { HeaderTableSize(value) } else if id == 2 {
    if value > 1 { violation(ProtocolError, 0, "SETTINGS_ENABLE_PUSH other than 0 or 1") }
    else { EnablePush(value == 1) }
  } else if id == 3 { MaxConcurrentStreams(value) } else if id == 4 {
    if value > largest_window() {
      violation(FlowControlError, 0, "SETTINGS_INITIAL_WINDOW_SIZE past 2^31-1")
    } else { InitialWindowSize(value) }
  } else if id == 5 {
    if value < default_frame_size() || value > largest_frame_size() {
      violation(ProtocolError, 0, "SETTINGS_MAX_FRAME_SIZE outside 16384 to 16777215")
    } else { MaxFrameSize(value) }
  } else if id == 6 { MaxHeaderListSize(value) }
  else { Unknown(id, value) }
}

fn push_promise_of(flags: Int, stream: Int, payload: Bytes) -> Frame / {http2.violated} = {
  on_stream(stream, "PUSH_PROMISE");
  let p = unpadded(flags, payload);
  if p.body.len() < 4 {
    violation(FrameSizeError, 0, "a PUSH_PROMISE frame too short for its promised stream")
  } else {
    PushPromiseFrame({
      stream: stream,
      promised: word(p.body, 0) & 0x7FFF_FFFF,
      block: p.body.slice(4, p.body.len()),
      end_headers: is_set(flags, 0x4),
      padding: p.padding,
    })
  }
}

fn ping_of(flags: Int, stream: Int, payload: Bytes) -> Frame / {http2.violated} = {
  on_connection(stream, "PING");
  if payload.len() != 8 { violation(FrameSizeError, 0, "a PING frame of other than eight octets") }
  else { PingFrame({ ack: is_set(flags, 0x1), data: payload }) }
}

fn goaway_of(stream: Int, payload: Bytes) -> Frame / {http2.violated} = {
  on_connection(stream, "GOAWAY");
  if payload.len() < 8 { violation(FrameSizeError, 0, "a GOAWAY frame shorter than eight octets") }
  else {
    GoAwayFrame({
      last_stream: word(payload, 0) & 0x7FFF_FFFF,
      code: code_of(word(payload, 4)),
      debug: payload.slice(8, payload.len()),
    })
  }
}

fn window_update_of(stream: Int, payload: Bytes) -> Frame / {http2.violated} =
  if payload.len() != 4 {
    violation(FrameSizeError, 0, "a WINDOW_UPDATE frame of other than four octets")
  } else {
    let increment = word(payload, 0) & 0x7FFF_FFFF;
    if increment == 0 { violation(ProtocolError, stream, "a window increment of 0") }
    else { WindowUpdateFrame({ stream: stream, increment: increment }) }
  }

fn continuation_of(flags: Int, stream: Int, payload: Bytes) -> Frame / {http2.violated} = {
  on_stream(stream, "CONTINUATION");
  ContinuationFrame({ stream: stream, block: payload, end_headers: is_set(flags, 0x4) })
}

// --- HPACK: integers and strings ------------------------------------------------

/// A header field as HPACK carries it: a name and a value, both octets.
pub type Field = { name: Bytes, value: Bytes }

fn compression_error<a>(reason: String) -> a / {http2.violated} =
  violation(CompressionError, 0, reason)

/// `n` encoded as an integer whose first octet gives it the low `prefix` bits and contains `bits`
/// above them (RFC 7541 §5.1).
fn integer(n: Int, prefix: Int, bits: Int) -> Bytes / {abort.raise} = {
  let top = (1 << prefix) - 1;
  if n < top { byte_of_int(bits | n) }
  else { byte_of_int(bits | top).concat(continuation_octets(n - top, [], 10)) }
}

fn continuation_octets(n: Int, out: List<Bytes>, fuel: Int) -> Bytes =
  if n < 128 || fuel <= 0 { Bytes::concat_all(out.push(byte_of_int(n & 127))) }
  else { continuation_octets(n >>> 7, out.push(byte_of_int(n & 127 | 128)), fuel - 1) }

type DecodedInteger = { value: Int, next: Int }

/// The integer at `at` whose first octet gives it `prefix` bits. An integer with more than five
/// continuation octets, above 2^32, or running past the block is rejected.
fn integer_at(b: Bytes, at: Int, prefix: Int) -> DecodedInteger / {http2.violated, abort.raise} = {
  let top = (1 << prefix) - 1;
  let first = b.at(at) & top;
  if first < top { { value: first, next: at + 1 } } else { integer_rest(b, at + 1, top, 0, 5) }
}

fn integer_rest(
  b: Bytes,
  at: Int,
  value: Int,
  shift: Int,
  fuel: Int,
) -> DecodedInteger / {http2.violated, abort.raise} =
  if fuel <= 0 { compression_error("an integer that is longer than six bytes") }
  else if at >= b.len() { compression_error("an integer that continues past the end of the header block") }
  else {
    let octet = b.at(at);
    let v = value + ((octet & 127) << shift);
    if v > 0xFFFF_FFFF { compression_error("an integer past 2^32") }
    else if octet & 128 == 0 { { value: v, next: at + 1 } }
    else { integer_rest(b, at + 1, v, shift + 7, fuel - 1) }
  }

type Literal = { value: Bytes, next: Int }

/// The string literal at `at`, Huffman-decoded when its first bit marks it as coded (§5.2).
fn string_at(b: Bytes, at: Int) -> Literal / {http2.violated, abort.raise} =
  if at >= b.len() { compression_error("a block that ends where a string should start") } else {
    let coded = b.at(at) & 0x80 != 0;
    let n = integer_at(b, at, 7);
    if n.value > b.len() - n.next {
      compression_error("a string that runs past the end of its block")
    } else {
      let raw = b.slice(n.next, n.next + n.value);
      { value: if coded { huffman_decode(raw) } else { raw }, next: n.next + n.value }
    }
  }

/// `s` as a string literal, Huffman-coded where that is shorter.
fn string_literal(s: Bytes) -> Bytes / {abort.raise} = {
  let coded = huffman_length(s);
  if coded < s.len() { integer(coded, 7, 0x80).concat(huffman_encode(s)) }
  else { integer(s.len(), 7, 0).concat(s) }
}

