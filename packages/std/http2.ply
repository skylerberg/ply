test "decoding each header block of RFC 7541's example {s.name} in turn returns its header fields and leaves the dynamic table at the listed size" for s: Scenario in stories(
  ) {
  s.examples.fold(decoder(s.capacity, 2), |d: Decoder, e: Example| {
    let got = decoded(d, Bytes::of_hex(e.wire));
    assert_eq(
      got.fields.map(text_field),
      e.fields.map(|f: { name: String, value: String }| f.name ++ ": " ++ f.value),
    );
    assert_eq(got.decoder.table.size, e.table_size);
    got.decoder
  });
  ()
}

test "integers are encoded and decoded as the examples in RFC 7541 section C.1 show" {
  assert_eq(integer(10, 5, 0).hex_of(), "0a");
  assert_eq(integer(1337, 5, 0).hex_of(), "1f9a0a");
  assert_eq(integer(42, 8, 0).hex_of(), "2a");
  assert_eq(integer_at(Bytes::of_hex("1f9a0a"), 0, 5), { value: 1337, next: 3 })
}

test "strings are Huffman-coded as the examples in RFC 7541 section C.4 show" {
  assert_eq(huffman_encode(b"www.example.com").hex_of(), "f1e3c2e5f23a6ba0ab90f4ff");
  assert_eq(huffman_encode(b"no-cache").hex_of(), "a8eb10649cbf");
  assert_eq(huffman_length(b"custom-key"), 8);
  assert_eq(huffman().codes.get(256), 0x3FFF_FFFF);
  assert_eq(huffman().codes.get(48), 0);
  assert_eq(huffman().codes.get(47), 0x18)
}

test "encoding a string with Huffman coding and decoding it gives back the original string" {
  gen::check(gen::bytes(), |x: Bytes|
    round_trip(
      huffman_encode,
      |b: Bytes| match try { huffman_decode(b) } { Ok(s) -> Some(s), Err(_) -> None },
      x,
    ))
}

test "a Huffman string that contains EOS, or is padded wrong, is rejected" {
  // EOS whole, then a padding of eight ones, then a padding of zeros.
  assert_eq(
    decode_result_text(decoder(4096, 2), Bytes::of_hex("0084ffffffff" ++ "8178")),
    "a Huffman string that holds EOS",
  );
  assert_eq(
    decode_result_text(decoder(4096, 2), Bytes::of_hex("0081ff")),
    "a Huffman string padded with more than seven bits",
  );
  assert_eq(
    decode_result_text(decoder(4096, 2), Bytes::of_hex("008100")),
    "a Huffman string padded with other than the first bits of EOS",
  )
}

test "decoding a header block fails on index 0, an index past the static and dynamic tables, or a truncated or oversized string or integer" {
  assert_eq(decode_result_text(decoder(4096, 2), Bytes::of_hex("80")), "index 0");
  assert_eq(decode_result_text(decoder(4096, 2), Bytes::of_hex("be")), "index 62 is larger than the static and dynamic tables together");
  assert_eq(
    decode_result_text(decoder(4096, 2), Bytes::of_hex("400a6375")),
    "a string that runs past the end of its block",
  );
  assert_eq(
    decode_result_text(decoder(4096, 2), Bytes::of_hex("ff")),
    "an integer that continues past the end of the header block",
  );
  assert_eq(
    decode_result_text(decoder(4096, 2), Bytes::of_hex("ff8080808080")),
    "an integer that is longer than six bytes",
  );
  assert_eq(
    decode_result_text(decoder(4096, 2), Bytes::of_hex("ffffffffff0f")),
    "an integer past 2^32",
  )
}

test "decoding fails when a dynamic table size update follows a field, repeats too often, or exceeds the table's maximum size" {
  assert_eq(
    decode_result_text(decoder(4096, 2), Bytes::of_hex("8220")),
    "a table size update after a field",
  );
  assert_eq(
    decode_result_text(decoder(4096, 2), Bytes::of_hex("202020")),
    "more than 2 table size updates in a block",
  );
  assert_eq(
    decode_result_text(decoder(4096, 2), Bytes::of_hex("3fe21f")),
    "a table size update to 4097 past the 4096 allowed",
  );
  assert_eq(decoded(decoder(4096, 2), Bytes::of_hex("203fe11f82")).decoder.table.capacity, 4096);
  // After the ceiling drops below the table's size, the next block must start with an update.
  let lowered = with_ceiling(decoded(decoder(4096, 2), Bytes::of_hex("82")).decoder, 100);
  assert_eq(
    decode_result_text(lowered, Bytes::of_hex("82")),
    "a header block must start with a dynamic table size update, and this one does not",
  );
  assert_eq(decoded(lowered, Bytes::of_hex("3f4582")).decoder.table.capacity, 100)
}

/// Fields that resemble real headers: the static table's names and fields, names it lacks, values
/// that repeat, and fields larger than a small table.
fn vocabulary() -> List<Field> =
  [
    { name: b":method", value: b"GET" },
    { name: b":path", value: b"/" },
    { name: b":path", value: b"/search?q=a" },
    { name: b":authority", value: b"example.com" },
    { name: b"accept-encoding", value: b"gzip, deflate" },
    { name: b"accept-encoding", value: b"br" },
    { name: b"user-agent", value: b"ply/0.1" },
    { name: b"cookie", value: b"a=1" },
    { name: b"cookie", value: b"session=0123456789abcdef0123" },
    { name: b"authorization", value: b"Bearer abc" },
    { name: b"x-custom", value: b"one" },
    { name: b"x-custom", value: b"two" },
    { name: b"x-empty", value: b"" },
    { name: b"x-binary", value: b"\x00\x01\xfe\xff" },
    { name: b"x-long", value: b"0123456789".repeat(30) },
    { name: b":status", value: b"200" },
    { name: b"content-type", value: b"text/html; charset=utf-8" },
    { name: b"set-cookie", value: b"id=7; HttpOnly" },
  ]

fn picked(picks: List<Int>) -> List<Field> / {abort.raise} =
  picks.map(|p: Int|
    vocabulary().at_or(non_negative(p, vocabulary().len()), { name: b"", value: b"" }))

type Pair = { encoder: Encoder, decoder: Decoder, same: Bool }

test "blocks decode to the fields they were encoded from, as the table's size changes between them" {
  gen::check2(
    gen::list(gen::list(gen::any_int())),
    gen::list(gen::any_int()),
    |blocks: List<List<Int>>, sizes: List<Int>| {
      let end = range(0, blocks.len()).fold(
        { encoder: encoder(4096), decoder: decoder(4096, 2), same: true },
        |p: Pair, i: Int| {
          let size = sizes.at_or(i, -1);
          let e = if size < 0 { p.encoder } else { with_capacity(p.encoder, size % 4097) };
          let fields = picked(blocks.at_or(i, []));
          let written = encode(e, fields);
          match try { decode(p.decoder, written.block) } {
            Ok(got) ->
              {
                encoder: written.encoder,
                decoder: got.decoder,
                same: p.same && got.fields == fields && got.decoder.table == written.encoder.table,
              },
            Err(_) -> { ..p, same: false },
          }
        },
      );
      end.same
    },
  )
}

test "a field in a table is written as its index, and a sensitive one is never indexed" {
  let first = encode(encoder(4096), [
    { name: b":method", value: b"GET" },
    { name: b"x-custom", value: b"one" },
    { name: b"authorization", value: b"secret" },
  ]);
  assert_eq(first.block.slice(0, 2).hex_of(), "8240");
  let second = encode(first.encoder, [{ name: b"x-custom", value: b"one" }]);
  assert_eq(second.block.hex_of(), "be");
  let fields = decoded(decoder(4096, 2), first.block).fields;
  assert_eq(fields.map(text_field), [":method: GET", "x-custom: one", "authorization: secret"]);
  // `0001` starts a never-indexed field, named here by the static table's index 23.
  assert(first.block.index_of(Bytes::of_hex("1f08")) != None, None)
}

// --- Tests: exchanges ---------------------------------------------------------------

fn at(t: Int) -> Instant = at_millis(t)

/// A frame as a line: its type, its stream and what matters of the rest.
fn shown(f: Frame) -> String / {abort.raise} =
  match f {
    DataFrame(d) ->
      "DATA " ++ d.stream.to_string() ++ " " ++ d.data.len().to_string()
        ++ (if d.end_stream { " END_STREAM" } else { "" }),
    HeadersFrame(h) ->
      "HEADERS " ++ h.stream.to_string() ++ (if h.end_stream { " END_STREAM" } else { "" })
        ++ (if h.end_headers { "" } else { " CONTINUED" }),
    PriorityFrame(p) -> "PRIORITY " ++ p.stream.to_string(),
    ResetFrame(r) -> "RST_STREAM " ++ r.stream.to_string() ++ " " ++ code_name(r.code),
    SettingsFrame(s) -> if s.ack { "SETTINGS ACK" } else { "SETTINGS" },
    PushPromiseFrame(p) -> "PUSH_PROMISE " ++ p.stream.to_string(),
    PingFrame(p) -> if p.ack { "PING ACK" } else { "PING" },
    GoAwayFrame(g) -> "GOAWAY " ++ g.last_stream.to_string() ++ " " ++ code_name(g.code),
    WindowUpdateFrame(w) ->
      "WINDOW_UPDATE " ++ w.stream.to_string() ++ " " ++ w.increment.to_string(),
    ContinuationFrame(c) ->
      "CONTINUATION " ++ c.stream.to_string() ++ (if c.end_headers { "" } else { " CONTINUED" }),
    UnknownFrame(u) -> "UNKNOWN " ++ u.kind.to_string(),
  }

type Parsing = { at: Int, frames: List<Frame> }

/// The frames in the bytes a machine wrote.
fn frames_in(b: Bytes) -> List<Frame> / {abort.raise} =
  iterate({ at: 0, frames: [] }, b.len() + 1, |p: Parsing|
    match try { read_frame(b, p.at, largest_frame_size()) } {
      Ok(Some(r)) -> Continue({ at: r.next, frames: p.frames.push(r.frame) }),
      _ -> Stop(p.frames),
    })

fn wire(fs: List<Frame>) -> Bytes / {abort.raise} = Bytes::concat_all(fs.map(encode_frame))

/// What a client opens with: the preface, its `SETTINGS`, and the acknowledgement of the
/// server's.
fn opening(settings: List<Setting>) -> Bytes / {abort.raise} =
  preface().concat(
    wire([
      SettingsFrame({ ack: false, settings: settings }),
      SettingsFrame({ ack: true, settings: [] }),
    ]),
  )

fn block_of(fields: List<(String, String)>) -> Bytes / {abort.raise} =
  encode(
    encoder(4096),
    fields.map(|f: (String, String)|
      match f { (n, v) -> { name: Bytes::of_string(n), value: Bytes::of_string(v) } }),
  ).block

fn get_fields(path: String) -> List<(String, String)> =
  [(":method", "GET"), (":scheme", "https"), (":authority", "example.com"), (":path", path)]

fn headers(s: Int, fields: List<(String, String)>, end_stream: Bool) -> Frame / {abort.raise} =
  HeadersFrame({
    stream: s,
    block: block_of(fields),
    end_stream: end_stream,
    end_headers: true,
    priority: None,
    padding: None,
  })

fn get(s: Int, path: String) -> Bytes / {abort.raise} =
  encode_frame(headers(s, get_fields(path), true))

fn data(s: Int, b: Bytes, end: Bool) -> Bytes / {abort.raise} =
  encode_frame(DataFrame({ stream: s, data: b, end_stream: end, padding: None }))

fn echo(r: Request) -> Response =
  plain_text(200, r.method ++ " " ++ r.target ++ " " ++ String::of_bytes_lossy(r.body))

/// A request to example.com over `https`, with no field of its own.
fn asking(method: String, target: String, body: Bytes) -> Request =
  {
    method: method,
    scheme: "https",
    authority: "example.com",
    target: target,
    headers: Map::new(),
    trailers: Map::new(),
    body: body,
  }

fn first_value(h: Headers, name: String) -> Option<String> =
  match h.get(name) { Some(values) -> values.at(0), None -> None }

type Served = { connection: Connection, frames: List<String>, events: List<Event> }

fn returned_all(
  c: Connection,
  events: List<Event>,
  app: (Request) -> Response / {abort.raise},
  t: Int,
) -> Connection / {abort.raise} =
  events.fold(c, |acc: Connection, e: Event|
    match e { Requested(q) -> respond(acc, q.stream, app(q.request), at(t)), _ -> acc })

/// Runs a server with these limits, passing it `chunks` in turn at time 1, with `app` responding to
/// each request as it arrives. Returns what the server wrote after its own `SETTINGS`, frame by
/// frame.
fn served(
  limits: Limits,
  chunks: List<Bytes>,
  app: (Request) -> Response / {abort.raise},
) -> Served / {abort.raise} = {
  let start = take_output(server(limits, at(0)));
  chunks.fold({ connection: start.connection, frames: [], events: [] }, |s: Served, chunk: Bytes|
    serve_result(s, receive(s.connection, chunk, at(1)), app, 1))
}

fn serve_result(
  s: Served,
  r: ReceiveResult,
  app: (Request) -> Response / {abort.raise},
  t: Int,
) -> Served / {abort.raise} = {
  let out = take_output(returned_all(r.connection, r.events, app, t));
  {
    connection: out.connection,
    frames: s.frames.concat(frames_in(out.bytes).map(shown)),
    events: s.events.concat(r.events),
  }
}

fn serve_tick(s: Served, t: Int) -> Served / {abort.raise} =
  serve_result(s, tick(s.connection, at(t)), echo, t)

test "a GET is a request the application responds to with HEADERS and then DATA" {
  let s = served(default_limits(), [opening([]).concat(get(1, "/a?b=1"))], echo);
  assert_eq(s.frames, ["SETTINGS ACK", "HEADERS 1", "DATA 1 11 END_STREAM"]);
  match s.events {
    [Requested(q)] -> {
      assert_eq(q.stream, 1);
      assert_eq(q.request.scheme, "https");
      assert_eq(q.request.target, "/a?b=1");
      assert_eq(q.request.authority, "example.com");
      assert_eq(q.request.method, "GET")
    },
    _ -> panic("one request, not " ++ s.events.len().to_string() ++ " events"),
  };
  assert_eq(open_streams(s.connection), 0)
}

test "the server's first output is a SETTINGS frame and a WINDOW_UPDATE that enlarges the connection's flow-control window" {
  let start = take_output(server(default_limits(), at(0)));
  assert_eq(frames_in(start.bytes).map(shown), ["SETTINGS", "WINDOW_UPDATE 0 983041"])
}

test "a connection that does not open with the preface is closed at its first byte that differs" {
  let s = served(default_limits(), [b"GET / HTTP/1.1\r\n"], echo);
  assert_eq(s.frames, ["GOAWAY 0 PROTOCOL_ERROR"]);
  assert(finished(s.connection), None);
  let partial = served(default_limits(), [b"PRI * HTTP/2"], echo);
  assert_eq(partial.frames, []);
  assert(!finished(partial.connection), None)
}

test "a connection whose first frame is not SETTINGS is closed" {
  let s = served(
    default_limits(),
    [preface().concat(wire([PingFrame({ ack: false, data: b"12345678" })]))],
    echo,
  );
  assert_eq(s.frames, ["GOAWAY 0 PROTOCOL_ERROR"])
}

test "SETTINGS are acknowledged and a PING is acknowledged with its own payload" {
  let s = served(
    default_limits(),
    [opening([]), wire([PingFrame({ ack: false, data: b"abcdefgh" })])],
    echo,
  );
  assert_eq(s.frames, ["SETTINGS ACK", "PING ACK"])
}

test "bytes that arrive an octet at a time are read as the frames they form" {
  let all = Bytes::concat_all([opening([]), get(1, "/"), get(3, "/x")]);
  let s = served(default_limits(), range(0, all.len()).map(|i: Int| all.slice(i, i + 1)), echo);
  assert_eq(s.frames, [
    "SETTINGS ACK",
    "HEADERS 1",
    "DATA 1 6 END_STREAM",
    "HEADERS 3",
    "DATA 3 7 END_STREAM",
  ]);
  assert_eq(s.events.len(), 2)
}

type Exchange = { name: String, input: List<Bytes>, output: List<String> }

/// Exchanges based on h2spec's cases for RFC 9113: what a client sends after its opening, and how
/// the server must respond.
fn exchanges() -> List<Exchange> / {abort.raise} =
  [
    {
      name: "DATA on an idle stream",
      input: [data(1, b"x", true)],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "RST_STREAM on an idle stream",
      input: [wire([ResetFrame({ stream: 1, code: Cancel })])],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "WINDOW_UPDATE on an idle stream",
      input: [wire([WindowUpdateFrame({ stream: 1, increment: 1 })])],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "a stream numbered below one already opened",
      input: [get(5, "/"), get(3, "/")],
      output: ["HEADERS 5", "DATA 5 6 END_STREAM", "GOAWAY 5 PROTOCOL_ERROR"],
    },
    {
      name: "an even stream from a client",
      input: [get(2, "/")],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "DATA on a stream whose request has ended",
      input: [get(1, "/").concat(data(1, b"x", true))],
      output: ["RST_STREAM 1 STREAM_CLOSED"],
    },
    {
      name: "DATA on a closed stream",
      input: [get(1, "/"), data(1, b"x", true)],
      output: ["HEADERS 1", "DATA 1 6 END_STREAM", "GOAWAY 1 STREAM_CLOSED"],
    },
    {
      name: "HEADERS on a closed stream",
      input: [get(1, "/"), get(1, "/")],
      output: ["HEADERS 1", "DATA 1 6 END_STREAM", "GOAWAY 1 STREAM_CLOSED"],
    },
    {
      name: "a frame of an unknown type",
      input: [
        wire([
          UnknownFrame({ kind: 0x20, flags: 0xFF, stream: 1, payload: b"?" }),
          PingFrame({ ack: false, data: b"12345678" }),
        ]),
      ],
      output: ["PING ACK"],
    },
    {
      name: "a frame of an unknown type inside a field block",
      input: [
        wire([
          HeadersFrame({
            stream: 1,
            block: block_of(get_fields("/")),
            end_stream: true,
            end_headers: false,
            priority: None,
            padding: None,
          }),
          UnknownFrame({ kind: 0x20, flags: 0, stream: 1, payload: b"" }),
        ]),
      ],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "HEADERS inside another stream's field block",
      input: [
        wire([
          HeadersFrame({
            stream: 1,
            block: b"",
            end_stream: true,
            end_headers: false,
            priority: None,
            padding: None,
          }),
          headers(3, get_fields("/"), true),
        ]),
      ],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "a CONTINUATION with no field block open",
      input: [wire([ContinuationFrame({ stream: 1, block: b"", end_headers: true })])],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "a field block HPACK cannot read",
      input: [
        wire([
          HeadersFrame({
            stream: 1,
            block: Bytes::of_hex("be"),
            end_stream: true,
            end_headers: true,
            priority: None,
            padding: None,
          }),
        ]),
      ],
      output: ["GOAWAY 0 COMPRESSION_ERROR"],
    },
    {
      name: "a stream that depends on itself",
      input: [
        wire([
          HeadersFrame({
            stream: 1,
            block: block_of(get_fields("/")),
            end_stream: true,
            end_headers: true,
            priority: Some({ depends_on: 1, exclusive: false, weight: 16 }),
            padding: None,
          }),
        ]),
      ],
      output: ["RST_STREAM 1 PROTOCOL_ERROR"],
    },
    {
      name: "a PRIORITY frame of the wrong length, confined to its open stream",
      input: [
        Bytes::concat_all([
          encode_frame(headers(1, get_fields("/"), false)),
          Bytes::of_hex("000004020000000001" ++ "00000003"),
          wire([PingFrame({ ack: false, data: b"12345678" })]),
        ]),
      ],
      output: ["RST_STREAM 1 FRAME_SIZE_ERROR", "PING ACK"],
    },
    {
      name: "a PRIORITY frame of the wrong length on an idle stream",
      input: [Bytes::of_hex("000004020000000003" ++ "00000001")],
      output: ["GOAWAY 0 FRAME_SIZE_ERROR"],
    },
    {
      name: "a connection window past 2^31-1",
      input: [wire([WindowUpdateFrame({ stream: 0, increment: largest_window() })])],
      output: ["GOAWAY 0 FLOW_CONTROL_ERROR"],
    },
    {
      name: "a stream window past 2^31-1",
      input: [
        encode_frame(headers(1, get_fields("/"), false)).concat(
          wire([WindowUpdateFrame({ stream: 1, increment: largest_window() })]),
        ),
      ],
      output: ["RST_STREAM 1 FLOW_CONTROL_ERROR"],
    },
    {
      name: "a SETTINGS_INITIAL_WINDOW_SIZE that takes a stream's window past 2^31-1",
      input: [
        encode_frame(headers(1, get_fields("/"), false)).concat(
          wire([
            WindowUpdateFrame({ stream: 1, increment: largest_window() - default_window() }),
            SettingsFrame({ ack: false, settings: [InitialWindowSize(65536)] }),
          ]),
        ),
      ],
      output: ["GOAWAY 1 FLOW_CONTROL_ERROR"],
    },
    {
      name: "a PUSH_PROMISE sent to a server",
      input: [
        wire([
          PushPromiseFrame({
            stream: 1,
            promised: 2,
            block: b"",
            end_headers: true,
            padding: None,
          }),
        ]),
      ],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "a field block in CONTINUATION frames",
      input: [
        wire([
          HeadersFrame({
            stream: 1,
            block: block_of(get_fields("/")).slice(0, 3),
            end_stream: true,
            end_headers: false,
            priority: None,
            padding: None,
          }),
          ContinuationFrame({
            stream: 1,
            block: block_of(get_fields("/")).slice(3, block_of(get_fields("/")).len()),
            end_headers: true,
          }),
        ]),
      ],
      output: ["HEADERS 1", "DATA 1 6 END_STREAM"],
    },
    {
      name: "a request with a body and trailers",
      input: [
        Bytes::concat_all([
          encode_frame(
            headers(
              1,
              drop_method(get_fields("/up")).push((":method", "POST")).push((
                "content-length",
                "4",
              )),
              false,
            ),
          ),
          data(1, b"ab", false),
          data(1, b"cd", false),
          encode_frame(headers(1, [("x-sum", "1")], true)),
        ]),
      ],
      output: ["HEADERS 1", "DATA 1 13 END_STREAM"],
    },
    {
      name: "a body other than its content-length",
      input: [
        encode_frame(
          headers(1, drop_method(get_fields("/up")).push(("content-length", "5")), false),
        ).concat(
          data(1, b"abc", true),
        ),
      ],
      output: ["RST_STREAM 1 PROTOCOL_ERROR"],
    },
    {
      name: "trailers that do not end the stream",
      input: [
        encode_frame(headers(1, get_fields("/"), false)).concat(
          encode_frame(headers(1, [("x-sum", "1")], false)),
        ),
      ],
      output: ["RST_STREAM 1 PROTOCOL_ERROR"],
    },
    {
      name: "a CONNECT",
      input: [
        encode_frame(headers(1, [(":method", "CONNECT"), (":authority", "example.com:443")], true)),
      ],
      output: ["HEADERS 1", "DATA 1 22 END_STREAM"],
    },
    {
      name: "a request that expects 100-continue",
      input: [
        encode_frame(
          headers(
            1,
            drop_method(get_fields("/")).concat([
              (":method", "POST"),
              ("expect", "100-continue"),
              ("content-length", "2"),
            ]),
            false,
          ),
        ),
        data(1, b"hi", true),
      ],
      output: ["HEADERS 1", "HEADERS 1", "DATA 1 9 END_STREAM"],
    },
  ]

/// `:method` comes first; this removes it so a test can give its own.
fn drop_method(fields: List<(String, String)>) -> List<(String, String)> =
  fields.filter(|f: (String, String)| match f { (n, _) -> n != ":method" })

test "for the h2spec case {e.name}, the server sends the frames that h2spec expects in reply" for e: Exchange in exchanges() {
  let s = served(default_limits(), [opening([])].concat(e.input), echo);
  assert_eq(s.frames.drop(1), e.output)
}

type Bad = { name: String, fields: List<(String, String)> }

/// Requests RFC 9113 §8 calls malformed, which a server resets with `PROTOCOL_ERROR`.
fn malformed_requests() -> List<Bad> =
  [
    { name: "an uppercase field name", fields: get_fields("/").push(("X-Upper", "1")) },
    {
      name: "a pseudo-header after a regular field",
      fields: [("accept", "*/*")].concat(get_fields("/")),
    },
    { name: "an unknown pseudo-header", fields: get_fields("/").push((":protocol", "websocket")) },
    { name: "a response's pseudo-header", fields: get_fields("/").push((":status", "200")) },
    { name: "a pseudo-header twice", fields: get_fields("/").concat([(":path", "/b")]) },
    { name: "no `:method`", fields: drop_method(get_fields("/")) },
    { name: "no `:path`", fields: [(":method", "GET"), (":scheme", "https")] },
    { name: "an empty `:path`", fields: [(":method", "GET"), (":scheme", "https"), (":path", "")] },
    {
      name: "a `:path` of `*` with GET",
      fields: [(":method", "GET"), (":scheme", "https"), (":path", "*")],
    },
    { name: "a connection field", fields: get_fields("/").push(("connection", "close")) },
    { name: "a transfer-encoding", fields: get_fields("/").push(("transfer-encoding", "chunked")) },
    { name: "`te` other than trailers", fields: get_fields("/").push(("te", "gzip")) },
    { name: "a value with a line feed", fields: get_fields("/").push(("x-a", "1\n2")) },
    { name: "a value with a space at its end", fields: get_fields("/").push(("x-a", "1 ")) },
    {
      name: "a `host` other than the `:authority`",
      fields: get_fields("/").push(("host", "other.example")),
    },
    {
      name: "userinfo in the `:authority`",
      fields: [
        (":method", "GET"),
        (":scheme", "https"),
        (":authority", "u@example.com"),
        (":path", "/"),
      ],
    },
    {
      name: "two content-lengths that differ",
      fields: get_fields("/").concat([("content-length", "1"), ("content-length", "2")]),
    },
  ]

test "a request with {b.name} is reset with PROTOCOL_ERROR as malformed and never reaches the application" for b: Bad in malformed_requests() {
  let s = served(default_limits(), [opening([]), encode_frame(headers(1, b.fields, true))], echo);
  assert_eq(s.frames, ["SETTINGS ACK", "RST_STREAM 1 PROTOCOL_ERROR"]);
  assert_eq(s.events, [])
}

test "cookie fields sent separately are joined with `; ` into one cookie field for the application" {
  let s = served(
    default_limits(),
    [
      opening([]),
      encode_frame(
        headers(
          1,
          get_fields("/").concat([("cookie", "a=1"), ("accept", "*/*"), ("cookie", "b=2")]),
          true,
        ),
      ),
    ],
    echo,
  );
  match s.events {
    [Requested(q)] -> {
      assert_eq(q.request.headers.get("cookie"), Some(["a=1; b=2"]));
      assert_eq(first_value(q.request.headers, "accept"), Some("*/*"))
    },
    _ -> panic("one request"),
  }
}

test "a response's body waits for the windows its client opens" {
  let s = served(
    default_limits(),
    [
      opening([InitialWindowSize(1)]).concat(get(1, "/")),
      wire([WindowUpdateFrame({ stream: 1, increment: 1 })]),
      wire([WindowUpdateFrame({ stream: 1, increment: 10 })]),
    ],
    echo,
  );
  assert_eq(s.frames, ["SETTINGS ACK", "HEADERS 1", "DATA 1 1", "DATA 1 1", "DATA 1 4 END_STREAM"])
}

test "a client's SETTINGS_INITIAL_WINDOW_SIZE moves the windows of streams already open" {
  let s = served(
    default_limits(),
    [
      opening([InitialWindowSize(0)]).concat(get(1, "/")),
      wire([SettingsFrame({ ack: false, settings: [InitialWindowSize(3)] })]),
    ],
    echo,
  );
  assert_eq(s.frames, ["SETTINGS ACK", "HEADERS 1", "SETTINGS ACK", "DATA 1 3"])
}

test "a response to HEAD, and a 204, carry no body" {
  let head = served(
    default_limits(),
    [
      opening([]),
      encode_frame(headers(1, drop_method(get_fields("/")).push((":method", "HEAD")), true)),
    ],
    echo,
  );
  assert_eq(head.frames, ["SETTINGS ACK", "HEADERS 1 END_STREAM"]);
  let none = served(default_limits(), [opening([]), get(1, "/")], |_: Request|
    { status: 204, headers: Map::new(), body: b"ignored" });
  assert_eq(none.frames, ["SETTINGS ACK", "HEADERS 1 END_STREAM"])
}

test "a stream beyond `max_concurrent_streams` is reset with REFUSED_STREAM, and a later stream is accepted" {
  let l = { ..default_limits(), max_concurrent_streams: 1 };
  let s = served(
    l,
    [
      opening([]),
      encode_frame(headers(1, get_fields("/"), false)).concat(get(3, "/")),
      data(1, b"", true),
      get(5, "/"),
    ],
    echo,
  );
  assert_eq(s.frames, [
    "SETTINGS ACK",
    "RST_STREAM 3 REFUSED_STREAM",
    "HEADERS 1",
    "DATA 1 6 END_STREAM",
    "HEADERS 5",
    "DATA 5 6 END_STREAM",
  ])
}

// --- Tests: the attacks ---------------------------------------------------------------

test "rapid reset: streams opened and reset past max_resets close the connection" {
  let l = { ..default_limits(), max_resets: 3 };
  let pairs = Bytes::concat_all(
    [1, 3, 5, 7, 9].map(|s: Int|
      get(s, "/").concat(wire([ResetFrame({ stream: s, code: Cancel })]))),
  );
  let s = served(l, [opening([]), pairs], echo);
  assert_eq(s.frames, ["SETTINGS ACK", "GOAWAY 7 ENHANCE_YOUR_CALM"]);
  // No request reset in the same bytes reaches the application.
  assert_eq(s.events.filter(|e: Event| match e { Requested(_) -> true, _ -> false }), []);
  assert(finished(s.connection), None)
}

test "the connection closes when stream resets exceed `max_resets` within `window_ms`, and resets in a later window count from zero" {
  let l = { ..default_limits(), max_resets: 2, window_ms: 100 };
  let start = take_output(server(l, at(0)));
  let one = receive(
    start.connection,
    opening([]).concat(get(1, "/").concat(wire([ResetFrame({ stream: 1, code: Cancel })]))),
    at(1),
  );
  let two = receive(
    one.connection,
    get(3, "/").concat(wire([ResetFrame({ stream: 3, code: Cancel })])),
    at(2),
  );
  let three = receive(
    two.connection,
    get(5, "/").concat(wire([ResetFrame({ stream: 5, code: Cancel })])),
    at(150),
  );
  assert(!finished(three.connection), None);
  let four = receive(
    three.connection,
    get(7, "/").concat(wire([ResetFrame({ stream: 7, code: Cancel })])),
    at(151),
  );
  let five = receive(
    four.connection,
    get(9, "/").concat(wire([ResetFrame({ stream: 9, code: Cancel })])),
    at(152),
  );
  assert(finished(five.connection), None)
}

test "a peer that makes the server reset its streams counts towards max_resets too" {
  let l = { ..default_limits(), max_resets: 2 };
  let bad = Bytes::concat_all(
    [1, 3, 5].map(|s: Int| encode_frame(headers(s, get_fields("/").push(("X-Upper", "1")), true))),
  );
  let s = served(l, [opening([]), bad], echo);
  assert_eq(s.frames, [
    "SETTINGS ACK",
    "RST_STREAM 1 PROTOCOL_ERROR",
    "RST_STREAM 3 PROTOCOL_ERROR",
    "GOAWAY 5 ENHANCE_YOUR_CALM",
  ])
}

test "CONTINUATION flood: a field block past max_continuations closes the connection" {
  let l = { ..default_limits(), max_continuations: 3 };
  let open = HeadersFrame({
    stream: 1,
    block: b"",
    end_stream: true,
    end_headers: false,
    priority: None,
    padding: None,
  });
  let more = range(0, 4).map(|_: Int|
    ContinuationFrame({ stream: 1, block: b"\x82", end_headers: false }));
  let s = served(l, [opening([]), wire([open].concat(more))], echo);
  assert_eq(s.frames, ["SETTINGS ACK", "GOAWAY 0 ENHANCE_YOUR_CALM"])
}

test "CONTINUATION flood: a field block past max_header_block closes the connection before it ends" {
  let l = { ..default_limits(), max_header_block: 100 };
  let open = HeadersFrame({
    stream: 1,
    block: b"\x82".repeat(60),
    end_stream: true,
    end_headers: false,
    priority: None,
    padding: None,
  });
  let s = served(
    l,
    [
      opening([]),
      wire([open, ContinuationFrame({ stream: 1, block: b"\x82".repeat(60), end_headers: false })]),
    ],
    echo,
  );
  assert_eq(s.frames, ["SETTINGS ACK", "GOAWAY 0 ENHANCE_YOUR_CALM"])
}

/// A first request that leaves a 4 KiB field in the server's table, and a second whose block of
/// a few dozen octets names it twenty times: its `:authority` is inserted first, so the field is
/// index 63.
fn table_amplification_input() -> List<Bytes> / {abort.raise} = {
  let planted = block_of(get_fields("/")).concat(
    Bytes::concat_all([
      integer(0, 6, 0x40),
      string_literal(b"x-bomb"),
      string_literal(b"a".repeat(4000)),
    ]),
  );
  let named = block_of(get_fields("/")).concat(Bytes::of_hex("bf").repeat(20));
  [
    wire([
      HeadersFrame({
        stream: 1,
        block: planted,
        end_stream: true,
        end_headers: true,
        priority: None,
        padding: None,
      }),
    ]),
    wire([
      HeadersFrame({
        stream: 3,
        block: named,
        end_stream: true,
        end_headers: true,
        priority: None,
        padding: None,
      }),
    ]),
  ]
}

test "a small compressed header block that expands past `max_header_list_size` gets a 431 response" {
  let s = served(default_limits(), [opening([])].concat(table_amplification_input()), echo);
  let reason = "the fields are larger than 65536 octets\n";
  assert_eq(s.frames, [
    "SETTINGS ACK",
    "HEADERS 1",
    "DATA 1 6 END_STREAM",
    "HEADERS 3",
    "DATA 3 " ++ reason.len().to_string() ++ " END_STREAM",
  ]);
  assert_eq(s.events.len(), 1)
}

test "HPACK bomb: more table size updates than `max_table_size_updates`, or an update above the maximum table size, close the connection" {
  let updates = HeadersFrame({
    stream: 1,
    block: Bytes::of_hex("202020").concat(block_of(get_fields("/"))),
    end_stream: true,
    end_headers: true,
    priority: None,
    padding: None,
  });
  assert_eq(served(default_limits(), [opening([]), wire([updates])], echo).frames, [
    "SETTINGS ACK",
    "GOAWAY 0 COMPRESSION_ERROR",
  ]);
  let past = HeadersFrame({
    stream: 1,
    block: integer(4097, 5, 0x20).concat(block_of(get_fields("/"))),
    end_stream: true,
    end_headers: true,
    priority: None,
    padding: None,
  });
  assert_eq(served(default_limits(), [opening([]), wire([past])], echo).frames, [
    "SETTINGS ACK",
    "GOAWAY 0 COMPRESSION_ERROR",
  ])
}

test "SETTINGS flood: SETTINGS past max_settings within the window close the connection" {
  let l = { ..default_limits(), max_settings: 3 };
  let more = wire(range(0, 3).map(|_: Int| SettingsFrame({ ack: false, settings: [] })));
  assert_eq(served(l, [opening([]), more], echo).frames, [
    "SETTINGS ACK",
    "SETTINGS ACK",
    "SETTINGS ACK",
    "GOAWAY 0 ENHANCE_YOUR_CALM",
  ])
}

test "PING flood: PINGs past max_pings within the window close the connection" {
  let l = { ..default_limits(), max_pings: 2 };
  let pings = wire(range(0, 3).map(|_: Int| PingFrame({ ack: false, data: b"12345678" })));
  assert_eq(served(l, [opening([]), pings], echo).frames, [
    "SETTINGS ACK",
    "PING ACK",
    "PING ACK",
    "GOAWAY 0 ENHANCE_YOUR_CALM",
  ])
}

test "frames that carry nothing past max_empty_frames close the connection" {
  let l = { ..default_limits(), max_empty_frames: 2 };
  let nothing = wire([
    PriorityFrame({ stream: 1, priority: { depends_on: 0, exclusive: false, weight: 16 } }),
    UnknownFrame({ kind: 0x30, flags: 0, stream: 0, payload: b"" }),
    PriorityFrame({ stream: 3, priority: { depends_on: 0, exclusive: false, weight: 16 } }),
  ]);
  assert_eq(served(l, [opening([]), nothing], echo).frames, [
    "SETTINGS ACK",
    "GOAWAY 0 ENHANCE_YOUR_CALM",
  ])
}

test "slow reader: a stream whose window stays closed past stall_ms is reset, and its bytes freed" {
  let l = { ..default_limits(), stall_ms: 1000 };
  let s = served(l, [opening([InitialWindowSize(0)]).concat(get(1, "/"))], echo);
  assert_eq(s.frames, ["SETTINGS ACK", "HEADERS 1"]);
  assert_eq(buffered_octets(s.connection), 6);
  assert_eq(deadline(s.connection), Some(at(1001)));
  let early = serve_tick(s, 900);
  assert_eq(early.frames, s.frames);
  let late = serve_tick(early, 1001);
  assert_eq(late.frames, ["SETTINGS ACK", "HEADERS 1", "RST_STREAM 1 CANCEL"]);
  assert_eq(buffered_octets(late.connection), 0)
}

test "slow reader: a stream opened while `max_buffered` bytes are waiting to be sent is reset with REFUSED_STREAM" {
  let l = { ..default_limits(), max_buffered: 10 };
  let s = served(
    l,
    [opening([InitialWindowSize(0)]).concat(get(1, "/0123456789")), get(3, "/")],
    echo,
  );
  assert_eq(s.frames, ["SETTINGS ACK", "HEADERS 1", "RST_STREAM 3 REFUSED_STREAM"])
}

test "a body past max_body gets a 413 response, and the stream is reset once the response is sent" {
  let l = { ..default_limits(), max_body: 10 };
  let reason = "the body is longer than 10 octets\n";
  let s = served(
    l,
    [
      opening([]),
      encode_frame(headers(1, get_fields("/"), false)).concat(data(1, b"x".repeat(11), false)),
    ],
    echo,
  );
  assert_eq(s.frames, [
    "SETTINGS ACK",
    "HEADERS 1",
    "DATA 1 " ++ reason.len().to_string() ++ " END_STREAM",
    "RST_STREAM 1 NO_ERROR",
  ])
}

test "a request not complete within request_timeout_ms gets a 408 response" {
  let l = { ..default_limits(), request_timeout_ms: 1000 };
  let s = served(l, [opening([]), encode_frame(headers(1, get_fields("/"), false))], echo);
  assert_eq(deadline(s.connection), Some(at(1001)));
  let late = serve_tick(s, 1001);
  let reason = "the request did not arrive whole within 1000 ms\n";
  assert_eq(late.frames, [
    "SETTINGS ACK",
    "HEADERS 1",
    "DATA 1 " ++ reason.len().to_string() ++ " END_STREAM",
    "RST_STREAM 1 NO_ERROR",
  ])
}

test "SETTINGS the client never acknowledges close the connection with SETTINGS_TIMEOUT" {
  let l = { ..default_limits(), settings_timeout_ms: 500 };
  let s = served(l, [preface().concat(wire([SettingsFrame({ ack: false, settings: [] })]))], echo);
  assert_eq(deadline(s.connection), Some(at(500)));
  assert_eq(serve_tick(s, 500).frames, ["SETTINGS ACK", "GOAWAY 0 SETTINGS_TIMEOUT"])
}

test "an idle connection closes after idle_timeout_ms" {
  let l = { ..default_limits(), idle_timeout_ms: 2000 };
  let s = served(l, [opening([]), get(1, "/")], echo);
  assert_eq(deadline(s.connection), Some(at(2001)));
  let idle = serve_tick(s, 2001);
  assert_eq(idle.frames.drop(3), ["GOAWAY 1 NO_ERROR"]);
  assert(finished(idle.connection), None)
}

test "after `max_requests` streams the server sends GOAWAY naming the last stream it will process, and ignores later streams" {
  let l = { ..default_limits(), max_requests: 2 };
  let s = served(
    l,
    [opening([]), Bytes::concat_all([get(1, "/"), get(3, "/"), get(5, "/")]), data(5, b"x", true)],
    echo,
  );
  assert_eq(s.frames, [
    "SETTINGS ACK",
    "GOAWAY 3 NO_ERROR",
    "HEADERS 1",
    "DATA 1 6 END_STREAM",
    "HEADERS 3",
    "DATA 3 6 END_STREAM",
  ]);
  assert(finished(s.connection), None)
}

test "a drain accepts the streams sent before its PING returns, and only those" {
  let s = served(default_limits(), [opening([]), get(1, "/")], echo);
  let begun = take_output(drain(s.connection, at(2)));
  assert_eq(frames_in(begun.bytes).map(shown), ["GOAWAY 2147483647 NO_ERROR", "PING"]);
  assert(!finished(begun.connection), None);
  let late = serve_result(
    { ..s, connection: begun.connection, frames: [] },
    receive(
      begun.connection,
      get(3, "/").concat(wire([PingFrame({ ack: true, data: drain_ping() })])),
      at(3),
    ),
    echo,
    3,
  );
  assert_eq(late.frames, ["GOAWAY 3 NO_ERROR", "HEADERS 3", "DATA 3 6 END_STREAM"]);
  let ignored = serve_result(late, receive(late.connection, get(5, "/"), at(4)), echo, 4);
  assert_eq(ignored.frames, late.frames);
  assert(finished(ignored.connection), None)
}

test "a drain whose PING never returns names the last stream after drain_ms" {
  let s = served(
    default_limits(),
    [opening([]), encode_frame(headers(1, get_fields("/"), false))],
    echo,
  );
  let begun = take_output(drain(s.connection, at(2)));
  assert_eq(deadline(begun.connection), Some(at(1002)));
  let named = serve_tick({ ..s, connection: begun.connection, frames: [] }, 1002);
  assert_eq(named.frames, ["GOAWAY 1 NO_ERROR"]);
  assert(!finished(named.connection), None);
  let done = serve_result(
    named,
    receive(named.connection, data(1, b"", true), at(1003)),
    echo,
    1003,
  );
  assert_eq(done.frames, ["GOAWAY 1 NO_ERROR", "HEADERS 1", "DATA 1 6 END_STREAM"]);
  assert(finished(done.connection), None)
}

// --- Tests: a client and a server ------------------------------------------------------

/// A client and a server joined by the bytes each has sent and the other not yet read.
type ConnectedPair = {
  client: Connection,
  server: Connection,
  to_server: Bytes,
  to_client: Bytes,
  events: List<Event>,
  step: Int,
}

fn connected_pair(l: Limits) -> ConnectedPair / {abort.raise} =
  {
    client: client(l, at(0)),
    server: server(l, at(0)),
    to_server: b"",
    to_client: b"",
    events: [],
    step: 0,
  }

/// How many of the `n` waiting octets the delivery at step `i` carries: the next value from `cuts`,
/// as 1 to 200, or all of them when `cuts` has no value.
fn piece(cuts: List<Int>, i: Int, n: Int) -> Int / {abort.raise} =
  if cuts == [] { n } else { min(n, 1 + (cuts.at_or(i % cuts.len(), 0) % 200 + 200) % 200) }

fn send_requests(e: ConnectedPair, reqs: List<Request>) -> ConnectedPair / {abort.raise} =
  reqs.fold(e, |x: ConnectedPair, r: Request|
    match request(x.client, r, at(x.step)) {
      Some(sent) -> { ..x, client: sent.connection },
      None -> x,
    })

/// Runs the two ends until neither has a byte to send, or for `budget` steps. Each step carries
/// part of what is waiting each way, as `cuts` decides, and `app` responds to each request as it
/// arrives.
fn carried(
  e: ConnectedPair,
  app: (Request) -> Response / {abort.raise},
  cuts: List<Int>,
  budget: Int,
) -> ConnectedPair / {abort.raise} =
  iterate(e, budget + 1, |x: ConnectedPair| {
    let c = take_output(x.client);
    let s = take_output(x.server);
    let up = x.to_server.concat(c.bytes);
    let down = x.to_client.concat(s.bytes);
    if (up.len() == 0 && down.len() == 0) || x.step >= budget {
      Stop({ ..x, client: c.connection, server: s.connection, to_server: up, to_client: down })
    } else {
      let n = piece(cuts, x.step, up.len());
      let heard = receive(s.connection, up.slice(0, n), at(x.step + 1));
      let m = piece(cuts, x.step + 1, down.len());
      let back = receive(c.connection, down.slice(0, m), at(x.step + 1));
      Continue({
        client: back.connection,
        server: returned_all(heard.connection, heard.events, app, x.step + 1),
        to_server: up.slice(n, up.len()),
        to_client: down.slice(m, down.len()),
        events: x.events.concat(back.events),
        step: x.step + 1,
      })
    }
  })

fn results(events: List<Event>) -> List<(Int, Int, String)> / {abort.raise} =
  events.fold([], |acc: List<(Int, Int, String)>, e: Event|
    match e {
      Responded(a) ->
        acc.push((a.stream, a.response.status, String::of_bytes_lossy(a.response.body))),
      Failed(f) -> acc.push((f.stream, 0, f.reason)),
      Reset(r) -> acc.push((r.stream, 0 - 1, code_name(r.code))),
      _ -> acc,
    })

test "a client's requests arrive at a server, and each response comes back on its request's stream" {
  let posted = { ..asking("POST", "/b", b"xyz"), trailers: Map::new().insert("x-sum", ["3"]) };
  let e = carried(
    send_requests(connected_pair(default_limits()), [
      asking("GET", "/a", b""),
      posted,
      asking("HEAD", "/c", b""),
    ]),
    echo,
    [],
    50,
  );
  assert_eq(results(e.events), [(1, 200, "GET /a "), (3, 200, "POST /b xyz"), (5, 200, "")]);
  match e.events.filter(|x: Event| match x { Responded(a) -> a.stream == 5, _ -> false }) {
    [Responded(a)] -> assert_eq(first_value(a.response.headers, "content-length"), Some("8")),
    _ -> panic("a response on stream 5"),
  };
  assert_eq(open_streams(e.client), 0);
  assert_eq(open_streams(e.server), 0)
}

test "a request's trailers are passed to the server's application" {
  let posted = { ..asking("POST", "/b", b"xyz"), trailers: Map::new().insert("x-sum", ["3"]) };
  let e = carried(
    send_requests(connected_pair(default_limits()), [posted]),
    |r: Request|
      plain_text(200, match first_value(r.trailers, "x-sum") { Some(v) -> v, None -> "none" }),
    [],
    50,
  );
  assert_eq(results(e.events), [(1, 200, "3")])
}

test "a client rejects a response whose status and headers are malformed, and closes the connection when the server sends PUSH_PROMISE" {
  let start = take_output(client(default_limits(), at(0)));
  let sent = match request(start.connection, asking("GET", "/", b""), at(0)) {
    Some(s) -> s.connection,
    None -> panic("a stream"),
  };
  let reply = wire([
    SettingsFrame({ ack: false, settings: [] }),
    headers(1, [(":status", "200"), (":path", "/")], true),
  ]);
  let r = receive(sent, reply, at(1));
  assert_eq(results(r.events), [
    (1, 0, "the pseudo-header `:path` is not allowed in this kind of message"),
  ]);
  let pushed = receive(
    sent,
    wire([
      SettingsFrame({ ack: false, settings: [] }),
      PushPromiseFrame({ stream: 1, promised: 2, block: b"", end_headers: true, padding: None }),
    ]),
    at(1),
  );
  assert(finished(pushed.connection), None)
}

test "a client learns which of its streams a GOAWAY left unprocessed, and opens no more" {
  let opened_two = send_requests(connected_pair(default_limits()), [
    asking("GET", "/a", b""),
    asking("GET", "/b", b""),
  ]);
  let c = take_output(opened_two.client);
  let told = receive(
    c.connection,
    wire([
      SettingsFrame({ ack: false, settings: [] }),
      GoAwayFrame({ last_stream: 1, code: NoError, debug: b"" }),
    ]),
    at(1),
  );
  assert_eq(results(told.events), [(3, 0 - 1, "REFUSED_STREAM")]);
  assert_eq(request(told.connection, asking("GET", "/c", b""), at(2)) == None, true)
}

/// A response with as many octets as the target names, such as `/50`.
fn response_of_size(r: Request) -> Response / {abort.raise} =
  {
    status: 200,
    headers: Map::new(),
    body: b"x".repeat(match Bytes::of_string(r.target.slice(1, r.target.len())).int_of_ascii() {
      Some(n) -> n,
      None -> 0,
    }),
  }

/// `n` reduced to the range `0` to `below`, to pick with a generated number.
fn non_negative(n: Int, below: Int) -> Int / {abort.raise} =
  if n < 0 { 0 - n % below } else { n % below }

type Ledger = {
  connection: Connection,
  sent: Map<Int, Int>,
  granted: Map<Int, Int>,
  within_window: Bool,
}

fn tallied(l: Ledger, bytes: Bytes, window: Int) -> Ledger / {abort.raise} =
  frames_in(bytes).fold(l, |x: Ledger, f: Frame|
    match f {
      DataFrame(d) -> {
        let sent = x.sent.insert(d.stream, at_least(x.sent.get(d.stream)) + flow_length(f)).insert(
          0,
          at_least(x.sent.get(0)) + flow_length(f),
        );
        {
          ..x,
          sent: sent,
          within_window: x.within_window
            && at_least(sent.get(d.stream)) <= window + at_least(x.granted.get(d.stream))
            && at_least(sent.get(0)) <= default_window() + at_least(x.granted.get(0)),
        }
      },
      _ -> x,
    })

fn at_least(n: Option<Int>) -> Int = match n { Some(v) -> v, None -> 0 }

test "a server sends no more DATA than its client's windows allow, however they open" {
  gen::check3(
    gen::any_int(),
    gen::list(gen::any_int()),
    gen::list(gen::any_int()),
    |window: Int, sizes: List<Int>, updates: List<Int>| {
      let w = non_negative(window, 1000);
      let gets = Bytes::concat_all(
        range(0, 3).map(|i: Int|
          get(2 * i + 1, "/" ++ non_negative(sizes.at_or(i, 0), 70000).to_string())),
      );
      let start = take_output(server(default_limits(), at(0)));
      let first = receive(start.connection, opening([InitialWindowSize(w)]).concat(gets), at(1));
      let out = take_output(returned_all(first.connection, first.events, response_of_size, 1));
      let opened_ledger = tallied(
        { connection: out.connection, sent: Map::new(), granted: Map::new(), within_window: true },
        out.bytes,
        w,
      );
      let end = updates.fold(opened_ledger, |x: Ledger, u: Int| {
        let s = [0, 1, 3, 5].at_or(non_negative(u, 4), 0);
        let n = 1 + non_negative(u / 4, 40000);
        let r = receive(
          x.connection,
          wire([WindowUpdateFrame({ stream: s, increment: n })]),
          at(2),
        );
        let o = take_output(r.connection);
        tallied(
          {
            ..x,
            connection: o.connection,
            granted: x.granted.insert(s, at_least(x.granted.get(s)) + n),
          },
          o.bytes,
          w,
        )
      });
      end.within_window
    },
  )
}

fn spawned(
  events: List<Event>,
  inbox: Chan<(Int, Response)>,
) -> Unit / {task.spawn, task.send, abort.raise} =
  match events {
    [] -> (),
    [Requested(q), ..rest] -> {
      task.spawn(|| task.send(inbox, (q.stream, response_of_size(q.request))));
      spawned(rest, inbox)
    },
    [_, ..rest] -> spawned(rest, inbox),
  }

/// A connection on the one-core task model. Each request is handled by its own task. The
/// connection's task carries a step of bytes each way, then takes whatever response is ready
/// without waiting, and waits for one only when no bytes are left to carry. The schedule decides
/// where among the steps each response lands.
fn multiplexed(
  e: ConnectedPair,
  inbox: Chan<(Int, Response)>,
  fuel: Int,
) -> ConnectedPair / {task.spawn, task.send, task.select, task.recv, abort.raise} =
  if fuel <= 0 || results(e.events).len() >= 2 { e } else {
    let c = take_output(e.client);
    let s = take_output(e.server);
    let heard = receive(s.connection, c.bytes, at(1));
    spawned(heard.events, inbox);
    let back = receive(c.connection, s.bytes, at(1));
    let quiet = c.bytes.len() == 0 && s.bytes.len() == 0;
    let ready = match task.select([(inbox, None)], quiet) {
      Some((_, Some(result))) -> Some(result),
      _ -> None,
    };
    let server_now = match ready {
      Some((stream, r)) -> respond(heard.connection, stream, r, at(1)),
      None -> heard.connection,
    };
    multiplexed(
      { ..e, client: back.connection, server: server_now, events: e.events.concat(back.events) },
      inbox,
      fuel - 1,
    )
  }

test "two responses larger than their windows finish under every interleaving of their streams" {
  simulate {
    let inbox = task.channel(4);
    let l = { ..default_limits(), initial_window: 40 };
    let e = multiplexed(
      send_requests(connected_pair(l), [asking("GET", "/50", b""), asking("GET", "/45", b"")]),
      inbox,
      40,
    );
    assert_eq(results(e.events).sort(), [
      (1, 200, String::of_bytes(b"x".repeat(50))),
      (3, 200, String::of_bytes(b"x".repeat(45))),
    ])
  }
}
