/// The code built from its lengths. By length from 0 to 30: the first code of that length, where
/// its symbols start in `symbols`, and `limits`, the bound that every code of that length or
/// shorter is below once shifted to the left of a 30-bit window.
type Huffman = {
  codes: Array<Int>,
  lengths: Array<Int>,
  first: Array<Int>,
  offsets: Array<Int>,
  limits: Array<Int>,
  symbols: Array<Int>,
}

type HuffmanBuilder = {
  first: List<Int>,
  offsets: List<Int>,
  limits: List<Int>,
  symbols: List<Int>,
  codes: Array<Int>,
  code: Int,
  count: Int,
}

const fn huffman() -> Huffman = huffman_of(Array::of_list(code_lengths()))

fn huffman_of(lengths: Array<Int>) -> Huffman / {abort.raise} = {
  let built = range(1, 31).fold(
    {
      first: [0],
      offsets: [0],
      limits: [0],
      symbols: [],
      codes: Array::new(lengths.len(), 0),
      code: 0,
      count: 0,
    },
    |b: HuffmanBuilder, l: Int| {
      let of_length = range(0, lengths.len()).filter(|s: Int| lengths.get(s) == l);
      let first = b.code + b.count << 1;
      {
        first: b.first.push(first),
        offsets: b.offsets.push(b.symbols.len()),
        limits: b.limits.push(first + of_length.len() << 30 - l),
        symbols: b.symbols.concat(of_length),
        codes: range(0, of_length.len()).fold(b.codes, |cs: Array<Int>, i: Int|
          cs.set(of_length.at_or(i, 0), first + i)),
        code: first,
        count: of_length.len(),
      }
    },
  );
  {
    codes: built.codes,
    lengths: lengths,
    first: Array::of_list(built.first),
    offsets: Array::of_list(built.offsets),
    limits: Array::of_list(built.limits),
    symbols: Array::of_list(built.symbols),
  }
}

/// The octets `s` takes Huffman-coded.
fn huffman_length(s: Bytes) -> Int / {abort.raise} = {
  let h = huffman();
  (range(0, s.len()).fold(0, |bits: Int, i: Int| bits + h.lengths.get(s.at(i))) + 7) / 8
}

type Coding = { acc: Int, count: Int, out: List<Bytes> }

/// `s` Huffman-coded, its last octet padded with the first bits of EOS.
fn huffman_encode(s: Bytes) -> Bytes / {abort.raise} = {
  let h = huffman();
  let coded = range(0, s.len()).fold({ acc: 0, count: 0, out: [] }, |c: Coding, i: Int| {
    let symbol = s.at(i);
    let length = h.lengths.get(symbol);
    flush_bytes(
      { acc: c.acc << length | h.codes.get(symbol), count: c.count + length, out: c.out },
      5,
    )
  });
  if coded.count == 0 { Bytes::concat_all(coded.out) } else {
    let pad = 8 - coded.count;
    Bytes::concat_all(coded.out.push(byte_of_int((coded.acc << pad | (1 << pad) - 1) & 0xFF)))
  }
}

fn flush_bytes(c: Coding, fuel: Int) -> Coding =
  if c.count < 8 || fuel <= 0 { c } else {
    let rest = c.count - 8;
    flush_bytes(
      {
        acc: c.acc & (1 << rest) - 1,
        count: rest,
        out: c.out.push(byte_of_int(c.acc >>> rest & 0xFF)),
      },
      fuel - 1,
    )
  }

type Decoding = { acc: Int, count: Int, at: Int, out: List<Bytes> }

/// The octets a Huffman-coded string represents. A string that contains EOS, or that ends in more
/// than seven bits or in bits that are not the first of EOS, is rejected (§5.2).
fn huffman_decode(raw: Bytes) -> Bytes / {http2.violated, abort.raise} = {
  let h = huffman();
  iterate({ acc: 0, count: 0, at: 0, out: [] }, 2 * raw.len() + 2, |d: Decoding| {
    let s = refill_bits(raw, d, 5);
    if s.count == 0 { Stop(Bytes::concat_all(s.out)) } else {
      let w = if s.count >= 30 { s.acc >>> s.count - 30 & 0x3FFF_FFFF }
      else { (s.acc << 30 - s.count | (1 << 30 - s.count) - 1) & 0x3FFF_FFFF };
      let l = code_length(h.limits, w, 25);
      if l > s.count {
        if s.count > 7 { compression_error("a Huffman string padded with more than seven bits") }
        else if s.acc & (1 << s.count) - 1 != (1 << s.count) - 1 {
          compression_error("a Huffman string padded with other than the first bits of EOS")
        } else { Stop(Bytes::concat_all(s.out)) }
      } else {
        let symbol = h.symbols.get(h.offsets.get(l) + (w >>> 30 - l) - h.first.get(l));
        if symbol == 256 { compression_error("a Huffman string that holds EOS") } else {
          Continue({
            acc: s.acc & (1 << s.count - l) - 1,
            count: s.count - l,
            at: s.at,
            out: s.out.push(byte_of_int(symbol)),
          })
        }
      }
    }
  })
}

/// Refills to at least 30 bits, or every bit left.
fn refill_bits(raw: Bytes, d: Decoding, fuel: Int) -> Decoding / {abort.raise} =
  if d.count >= 30 || d.at >= raw.len() || fuel <= 0 { d } else {
    refill_bits(
      raw,
      { ..d, acc: d.acc << 8 | raw.at(d.at), count: d.count + 8, at: d.at + 1 },
      fuel - 1,
    )
  }

/// The length of the code a 30-bit window starts with: the shortest whose limit the window is
/// below.
fn code_length(limits: Array<Int>, w: Int, left: Int) -> Int / {abort.raise} = {
  let l = 30 - left;
  if left <= 0 || w < limits.get(l) { l } else { code_length(limits, w, left - 1) }
}

// --- HPACK: the tables ------------------------------------------------------------

/// The static table, RFC 7541 Appendix A: index 1 is the first.
fn static_fields() -> List<Field> =
  [
    { name: b":authority", value: b"" },
    { name: b":method", value: b"GET" },
    { name: b":method", value: b"POST" },
    { name: b":path", value: b"/" },
    { name: b":path", value: b"/index.html" },
    { name: b":scheme", value: b"http" },
    { name: b":scheme", value: b"https" },
    { name: b":status", value: b"200" },
    { name: b":status", value: b"204" },
    { name: b":status", value: b"206" },
    { name: b":status", value: b"304" },
    { name: b":status", value: b"400" },
    { name: b":status", value: b"404" },
    { name: b":status", value: b"500" },
    { name: b"accept-charset", value: b"" },
    { name: b"accept-encoding", value: b"gzip, deflate" },
    { name: b"accept-language", value: b"" },
    { name: b"accept-ranges", value: b"" },
    { name: b"accept", value: b"" },
    { name: b"access-control-allow-origin", value: b"" },
    { name: b"age", value: b"" },
    { name: b"allow", value: b"" },
    { name: b"authorization", value: b"" },
    { name: b"cache-control", value: b"" },
    { name: b"content-disposition", value: b"" },
    { name: b"content-encoding", value: b"" },
    { name: b"content-language", value: b"" },
    { name: b"content-length", value: b"" },
    { name: b"content-location", value: b"" },
    { name: b"content-range", value: b"" },
    { name: b"content-type", value: b"" },
    { name: b"cookie", value: b"" },
    { name: b"date", value: b"" },
    { name: b"etag", value: b"" },
    { name: b"expect", value: b"" },
    { name: b"expires", value: b"" },
    { name: b"from", value: b"" },
    { name: b"host", value: b"" },
    { name: b"if-match", value: b"" },
    { name: b"if-modified-since", value: b"" },
    { name: b"if-none-match", value: b"" },
    { name: b"if-range", value: b"" },
    { name: b"if-unmodified-since", value: b"" },
    { name: b"last-modified", value: b"" },
    { name: b"link", value: b"" },
    { name: b"location", value: b"" },
    { name: b"max-forwards", value: b"" },
    { name: b"proxy-authenticate", value: b"" },
    { name: b"proxy-authorization", value: b"" },
    { name: b"range", value: b"" },
    { name: b"referer", value: b"" },
    { name: b"refresh", value: b"" },
    { name: b"retry-after", value: b"" },
    { name: b"server", value: b"" },
    { name: b"set-cookie", value: b"" },
    { name: b"strict-transport-security", value: b"" },
    { name: b"transfer-encoding", value: b"" },
    { name: b"user-agent", value: b"" },
    { name: b"vary", value: b"" },
    { name: b"via", value: b"" },
    { name: b"www-authenticate", value: b"" },
  ]

/// The static table to read by index, and to look up by field and by name, each at its first
/// index.
type StaticTable = { fields: Array<Field>, exact: Map<Field, Int>, names: Map<Bytes, Int> }

const fn static_table() -> StaticTable = {
  let fields = static_fields();
  range(0, fields.len()).fold(
    { fields: Array::of_list(fields), exact: Map::new(), names: Map::new() },
    |s: StaticTable, i: Int| {
      let f = fields.at_or(i, { name: b"", value: b"" });
      {
        fields: s.fields,
        exact: if s.exact.contains(f) { s.exact } else { s.exact.insert(f, i + 1) },
        names: if s.names.contains(f.name) { s.names } else { s.names.insert(f.name, i + 1) },
      }
    },
  )
}

fn static_count() -> Int = 61

/// The octets an entry takes in a table: its name, its value and 32 (§4.1).
fn entry_size(f: Field) -> Int = f.name.len() + f.value.len() + 32

/// A dynamic table: its entries by the order they were inserted in, the newest's number, how many
/// there are, the octets they take and the most they may take.
type Table = { entries: Map<Int, Field>, newest: Int, count: Int, size: Int, capacity: Int }

type Eviction = { table: Table, gone: List<{ key: Int, value: Field }> }

fn table_of(capacity: Int) -> Table =
  { entries: Map::new(), newest: 0, count: 0, size: 0, capacity: capacity }

/// The table with its oldest entries evicted until it contains at most `capacity - space_needed`
/// octets.
fn evict(t: Table, space_needed: Int) -> Eviction / {abort.raise} =
  iterate({ table: t, gone: [] }, t.count + 1, |e: Eviction|
    if e.table.size + space_needed <= e.table.capacity || e.table.count == 0 { Stop(e) } else {
      let oldest = e.table.newest - e.table.count + 1;
      match e.table.entries.get(oldest) {
        None -> Stop(e),
        Some(f) ->
          Continue({
            table: {
              ..e.table,
              entries: e.table.entries.remove(oldest),
              count: e.table.count - 1,
              size: e.table.size - entry_size(f),
            },
            gone: e.gone.push({ key: oldest, value: f }),
          }),
      }
    })

/// The table after `f` is inserted; an entry larger than the table empties it and is not stored.
fn insert_entry(t: Table, f: Field) -> Eviction / {abort.raise} = {
  let size = entry_size(f);
  if size > t.capacity { evict(t, t.capacity + 1) } else {
    let e = evict(t, size);
    {
      table: {
        ..e.table,
        entries: e.table.entries.insert(e.table.newest + 1, f),
        newest: e.table.newest + 1,
        count: e.table.count + 1,
        size: e.table.size + size,
      },
      gone: e.gone,
    }
  }
}

fn resize_table(t: Table, capacity: Int) -> Eviction / {abort.raise} =
  evict({ ..t, capacity: capacity }, 0)

/// The field at an index of the two tables together: the static table's 61 and then the dynamic
/// table's, newest first.
fn field_at(t: Table, index: Int) -> Field / {http2.violated, abort.raise} =
  if index <= 0 { compression_error("index 0") }
  else if index <= static_count() { static_table().fields.get(index - 1) } else {
    match t.entries.get(t.newest - (index - static_count() - 1)) {
      Some(f) -> if index - static_count() <= t.count { f }
      else { compression_error("index " ++ index.to_string() ++ " is larger than the static and dynamic tables together") },
      None -> compression_error("index " ++ index.to_string() ++ " is larger than the static and dynamic tables together"),
    }
  }

// --- HPACK: decoding --------------------------------------------------------------

/// One end's decoder for the field blocks its peer writes: the dynamic table the two share, the
/// most it may be made to contain, and how many size updates one block may start with.
pub opaque type Decoder = new { table: Table, ceiling: Int, max_updates: Int, owed: Bool }

/// A decoder whose table may hold `ceiling` octets, the `SETTINGS_HEADER_TABLE_SIZE` its end sent,
/// and that accepts at most `max_updates` size updates at the start of a block.
pub fn decoder(ceiling: Int, max_updates: Int) -> Decoder =
  { table: table_of(ceiling), ceiling: ceiling, max_updates: max_updates, owed: false }

/// The decoder after its end allows a table of `ceiling` octets. When that is less than the table
/// contains now, the next block must start with a size update to at most `ceiling`.
pub fn with_ceiling(d: Decoder, ceiling: Int) -> Decoder =
  { ..d, ceiling: ceiling, owed: d.owed || d.table.capacity > ceiling }

/// What a field block decodes to: the decoder after it, the fields in order, and the size the list
/// takes as `SETTINGS_MAX_HEADER_LIST_SIZE` counts it, each field's octets and 32.
pub type DecodeResult = { decoder: Decoder, fields: List<Field>, size: Int }

type Reading = {
  table: Table,
  at: Int,
  fields: List<Field>,
  size: Int,
  updates: Int,
  started: Bool,
}

/// Decodes one whole field block. Rejected with `CompressionError`: an index neither table
/// contains, an integer or a string past the block or an integer above 2^32, a Huffman string that
/// is not valid code, and a size update above the ceiling, after a field, or beyond `max_updates`.
/// The work is linear in the block, however large the fields it names: an index into the table
/// copies nothing.
pub fn decode(d: Decoder, block: Bytes) -> DecodeResult / {http2.violated, abort.raise} = {
  let n = block.len();
  let read = iterate(
    { table: d.table, at: 0, fields: [], size: 0, updates: 0, started: false },
    n + 1,
    |r: Reading|
      if r.at >= n { Stop(r) } else {
        let first = block.at(r.at);
        if first & 0xE0 == 0x20 { Continue(size_update(d, block, r)) }
        else if d.owed && !r.started && r.updates == 0 {
          compression_error("a header block must start with a dynamic table size update, and this one does not")
        } else { Continue(read_representation(block, r, first)) }
      },
  );
  {
    decoder: { ..d, table: read.table, owed: d.owed && read.updates == 0 },
    fields: read.fields,
    size: read.size,
  }
}

fn size_update(d: Decoder, block: Bytes, r: Reading) -> Reading / {http2.violated, abort.raise} =
  if r.started { compression_error("a table size update after a field") }
  else if r.updates >= d.max_updates {
    compression_error("more than " ++ d.max_updates.to_string() ++ " table size updates in a block")
  } else {
    let size = integer_at(block, r.at, 5);
    if size.value > d.ceiling {
      compression_error(
        "a table size update to " ++ size.value.to_string() ++ " past the " ++ d.ceiling.to_string()
          ++ " allowed",
      )
    } else {
      { ..r, table: resize_table(r.table, size.value).table, at: size.next, updates: r.updates + 1 }
    }
  }

fn read_representation(
  block: Bytes,
  r: Reading,
  first: Int,
) -> Reading / {http2.violated, abort.raise} =
  if first & 0x80 != 0 {
    let index = integer_at(block, r.at, 7);
    with_field({ ..r, at: index.next }, field_at(r.table, index.value))
  } else if first & 0xC0 == 0x40 {
    let f = literal_at(block, r, 6);
    with_field({ ..r, table: insert_entry(r.table, f.field).table, at: f.next }, f.field)
  } else {
    let f = literal_at(block, r, 4);
    with_field({ ..r, at: f.next }, f.field)
  }

fn with_field(r: Reading, f: Field) -> Reading =
  { ..r, fields: r.fields.push(f), size: r.size + entry_size(f), started: true }

type LiteralField = { field: Field, next: Int }

/// A literal field: its name by index or as a string, then its value.
fn literal_at(
  block: Bytes,
  r: Reading,
  prefix: Int,
) -> LiteralField / {http2.violated, abort.raise} = {
  let index = integer_at(block, r.at, prefix);
  if index.value == 0 {
    let name = string_at(block, index.next);
    let value = string_at(block, name.next);
    { field: { name: name.value, value: value.value }, next: value.next }
  } else {
    let value = string_at(block, index.next);
    { field: { name: field_at(r.table, index.value).name, value: value.value }, next: value.next }
  }
}

// --- HPACK: encoding --------------------------------------------------------------

/// One end's encoder for field blocks: the dynamic table it shares with its peer's decoder, the
/// index of each field and name in it, the most the peer allows it, and the size updates the next
/// block must start with.
pub opaque type Encoder = new {
  table: Table,
  fields: Map<Field, Int>,
  names: Map<Bytes, Int>,
  updates: List<Int>,
}

/// An encoder whose table may hold `capacity` octets; HPACK starts both ends at 4096.
pub fn encoder(capacity: Int) -> Encoder =
  { table: table_of(capacity), fields: Map::new(), names: Map::new(), updates: [] }

/// The encoder with a table of `capacity` octets, at most what the peer's decoder allows. The next
/// block starts with the size update, preceded by one to the smallest size the table passed
/// through, so the peer's decoder evicts what this one did.
pub fn with_capacity(e: Encoder, capacity: Int) -> Encoder / {abort.raise} =
  if capacity == e.table.capacity && e.updates == [] { e } else {
    let low = match e.updates { [] -> capacity, [l, ..] -> min(l, capacity) };
    let shrunk = forget_evicted(e, resize_table(e.table, capacity));
    { ..shrunk, updates: if low == capacity { [capacity] } else { [low, capacity] } }
  }

fn forget_evicted(e: Encoder, ev: Eviction) -> Encoder =
  ev.gone.fold({ ..e, table: ev.table }, |acc: Encoder, g: { key: Int, value: Field }|
    {
      ..acc,
      fields: if acc.fields.get(g.value) == Some(g.key) { acc.fields.remove(g.value) }
      else { acc.fields },
      names: if acc.names.get(g.value.name) == Some(g.key) { acc.names.remove(g.value.name) }
      else { acc.names },
    })

/// What `encode` returns: the encoder after the block, and the block.
pub type EncodeResult = { encoder: Encoder, block: Bytes }

/// The fields as one field block. A field in either table is written as its index; one whose value
/// varies from message to message, or that would take most of the table, is written without being
/// inserted; and an `authorization`, a `proxy-authorization` and a short `cookie` are never
/// indexed, so no intermediary inserts them either (§7.1.3). A string is Huffman-coded where that
/// is shorter.
pub fn encode(e: Encoder, fields: List<Field>) -> EncodeResult / {abort.raise} = {
  let opening = e.updates.map(|size: Int| integer(size, 5, 0x20));
  let written = fields.fold(
    { encoder: { ..e, updates: [] }, pieces: opening },
    |w: { encoder: Encoder, pieces: List<Bytes> }, f: Field| {
      let one = write_field(w.encoder, f);
      { encoder: one.encoder, pieces: w.pieces.push(one.block) }
    },
  );
  { encoder: written.encoder, block: Bytes::concat_all(written.pieces) }
}

fn dynamic_index(t: Table, key: Int) -> Int = static_count() + t.newest - key + 1

fn write_field(e: Encoder, f: Field) -> EncodeResult / {abort.raise} =
  match static_table().exact.get(f) {
    Some(i) -> { encoder: e, block: integer(i, 7, 0x80) },
    None -> match e.fields.get(f) {
      Some(key) -> { encoder: e, block: integer(dynamic_index(e.table, key), 7, 0x80) },
      None -> write_literal(e, f),
    },
  }

fn name_index(e: Encoder, name: Bytes) -> Int =
  match static_table().names.get(name) {
    Some(i) -> i,
    None -> match e.names.get(name) { Some(key) -> dynamic_index(e.table, key), None -> 0 },
  }

fn write_literal(e: Encoder, f: Field) -> EncodeResult / {abort.raise} = {
  let index = name_index(e, f.name);
  let name = if index == 0 { string_literal(f.name) } else { b"" };
  let value = string_literal(f.value);
  if never_indexed(f) {
    { encoder: e, block: Bytes::concat_all([integer(index, 4, 0x10), name, value]) }
  } else if !worth_indexing(f) || entry_size(f) > e.table.capacity * 3 / 4 {
    { encoder: e, block: Bytes::concat_all([integer(index, 4, 0), name, value]) }
  } else {
    let ev = insert_entry(e.table, f);
    let kept = forget_evicted(e, ev);
    {
      encoder: {
        ..kept,
        fields: kept.fields.insert(f, ev.table.newest),
        names: kept.names.insert(f.name, ev.table.newest),
      },
      block: Bytes::concat_all([integer(index, 6, 0x40), name, value]),
    }
  }
}

fn never_indexed(f: Field) -> Bool =
  f.name == b"authorization" || f.name == b"proxy-authorization"
    || (f.name == b"cookie" && f.value.len() < 20)

/// Whether to insert a field into the table. A field whose value is rarely sent twice would fill
/// the table for nothing.
fn worth_indexing(f: Field) -> Bool =
  f.name != b":path" && f.name != b"content-length" && f.name != b"etag"
    && f.name != b"if-modified-since"
    && f.name != b"if-none-match"
    && f.name != b"location"
    && f.name != b"set-cookie"
    && f.name != b"date"
    && f.name != b"last-modified"

// --- The connection: limits -----------------------------------------------------

/// Which end of a connection a machine is.
pub type Role = | Server | Client

/// The most a peer can make one connection cost, each field limiting one way to raise the cost.
/// The counts described as "within `window_ms`" are tracked over windows of that length. Every
/// limit must be positive (`check_limits`).
pub type Limits = new {
  /// Streams the peer may have open at once, advertised as `SETTINGS_MAX_CONCURRENT_STREAMS`; one
  /// past it is refused with `REFUSED_STREAM`.
  max_concurrent_streams: Int,
  /// Streams the peer may open on one connection in total; at the last one, a server drains.
  max_requests: Int,
  /// Octets the peer may send on one stream before this end has read them, advertised as
  /// `SETTINGS_INITIAL_WINDOW_SIZE`.
  initial_window: Int,
  /// Octets the peer may send on the whole connection before this end has read them.
  connection_window: Int,
  /// The largest frame this end reads, advertised as `SETTINGS_MAX_FRAME_SIZE`.
  max_frame_size: Int,
  /// Octets of HPACK table the peer may make this end store, advertised as
  /// `SETTINGS_HEADER_TABLE_SIZE`, and the most this end's own encoder stores.
  max_table_size: Int,
  /// Table size updates one field block may start with.
  max_table_size_updates: Int,
  /// The largest field list, measured as `SETTINGS_MAX_HEADER_LIST_SIZE` measures it and
  /// advertised: each field's octets and 32. A request past it gets a 431 response, however few
  /// octets its block took.
  max_header_list_size: Int,
  /// Octets of one field block across its `HEADERS` and `CONTINUATION` frames.
  max_header_block: Int,
  /// `CONTINUATION` frames one field block may take.
  max_continuations: Int,
  /// Octets of one message's body; a request past it gets a 413 response.
  max_body: Int,
  /// `RST_STREAM` frames sent and received within `window_ms`: the rapid reset attack, and a peer
  /// that makes this end reset its streams for it.
  max_resets: Int,
  /// `SETTINGS` frames the peer may send within `window_ms`.
  max_settings: Int,
  /// `PING` frames the peer may send within `window_ms`.
  max_pings: Int,
  /// Frames that carry nothing a stream needs, within `window_ms`: an empty `DATA` that does not
  /// end its stream, an empty `CONTINUATION` that does not end its block, `PRIORITY`, and a frame
  /// of a type RFC 9113 does not define.
  max_empty_frames: Int,
  window_ms: Int,
  /// Octets of messages waiting on the peer's windows, over every stream; a stream the peer opens
  /// past it is refused with `REFUSED_STREAM`.
  max_buffered: Int,
  /// How long a stream's output may wait on a window the peer keeps closed before the stream is
  /// reset: a reader that never reads.
  stall_ms: Int,
  /// How long this end's `SETTINGS` may go unacknowledged before the connection is closed.
  settings_timeout_ms: Int,
  /// The time from a stream's head to its last frame: a request not complete by then gets a 408
  /// response, and a response not complete by then fails.
  request_timeout_ms: Int,
  /// How long a connection with no stream open waits for one before it closes.
  idle_timeout_ms: Int,
  /// How long a server's drain waits for its `PING` to return before it names the last stream it
  /// accepted.
  drain_ms: Int,
}

/// A hundred streams at once and a thousand in all, the protocol's 64 KiB stream windows and a
/// 1 MiB connection window, 16 KiB frames, the protocol's 4 KiB HPACK table and two updates a
/// block, 64 KiB of fields and of field block in at most 32 `CONTINUATION` frames, 1 MiB bodies;
/// within ten seconds 200 resets, 50 `SETTINGS`, 50 `PING` and 200 empty frames; 16 MiB waiting on
/// windows, thirty seconds for a stalled stream and for a request, ten for `SETTINGS` to be
/// acknowledged, five for an idle connection and one for a drain's `PING`.
pub fn default_limits() -> Limits =
  {
    max_concurrent_streams: 100,
    max_requests: 1000,
    initial_window: 65535,
    connection_window: 1048576,
    max_frame_size: 16384,
    max_table_size: 4096,
    max_table_size_updates: 2,
    max_header_list_size: 65536,
    max_header_block: 65536,
    max_continuations: 32,
    max_body: 1048576,
    max_resets: 200,
    max_settings: 50,
    max_pings: 50,
    max_empty_frames: 200,
    window_ms: 10000,
    max_buffered: 16777216,
    stall_ms: 30000,
    settings_timeout_ms: 10000,
    request_timeout_ms: 30000,
    idle_timeout_ms: 5000,
    drain_ms: 1000,
  }

/// Panics, naming the field, on a limit that is not positive, a frame size outside 16384 to
/// 16777215, or a window past 2^31-1: each is a configuration mistake.
pub fn check_limits(l: Limits) -> Unit / {abort.raise} = {
  let fields = [
    ("max_concurrent_streams", l.max_concurrent_streams),
    ("max_requests", l.max_requests),
    ("initial_window", l.initial_window),
    ("connection_window", l.connection_window),
    ("max_table_size", l.max_table_size),
    ("max_table_size_updates", l.max_table_size_updates),
    ("max_header_list_size", l.max_header_list_size),
    ("max_header_block", l.max_header_block),
    ("max_continuations", l.max_continuations),
    ("max_body", l.max_body),
    ("max_resets", l.max_resets),
    ("max_settings", l.max_settings),
    ("max_pings", l.max_pings),
    ("max_empty_frames", l.max_empty_frames),
    ("window_ms", l.window_ms),
    ("max_buffered", l.max_buffered),
    ("stall_ms", l.stall_ms),
    ("settings_timeout_ms", l.settings_timeout_ms),
    ("request_timeout_ms", l.request_timeout_ms),
    ("idle_timeout_ms", l.idle_timeout_ms),
    ("drain_ms", l.drain_ms),
  ];
  match fields.filter(|f: (String, Int)| match f { (_, v) -> v <= 0 }) {
    [(name, v), ..] ->
      panic("`Limits." ++ name ++ "` is " ++ v.to_string() ++ ", and every limit must be positive"),
    [] -> if l.max_frame_size < default_frame_size() || l.max_frame_size > largest_frame_size() {
      panic(
        "`Limits.max_frame_size` is " ++ l.max_frame_size.to_string()
          ++ ", outside 16384 to 16777215",
      )
    } else if l.initial_window > largest_window() || l.connection_window > largest_window() {
      panic("a window in `Limits` is past 2^31-1")
    } else { () },
  }
}

// --- The connection: its state ------------------------------------------------------

/// A message's fields after its pseudo-header fields: each name lowercase, with its values in the
/// order they came. It is the shape `std.http`'s `Headers` has.
pub type Headers = Map<String, List<String>>

/// A request as HTTP/2 carries it: its method, scheme and authority, its target (the path with its
/// query, or `*`), its fields, the trailers after its body, and its body. A received request has
/// every `cookie` field joined into one, as an HTTP/1.1 request would.
pub type Request = {
  method: String,
  scheme: String,
  authority: String,
  target: String,
  headers: Headers,
  trailers: Headers,
  body: Bytes,
}

/// A response: its status, fields and body, the same shape as `std.http`'s `Response`, so either
/// converts to the other.
pub type Response = { status: Int, headers: Headers, body: Bytes }

/// What a call on a connection reports, in the order it happened.
pub type Event =
  /// A complete request arrived on a stream; `respond` responds to it.
  | Requested({ stream: Int, request: Request })
  /// The complete response to the request a client sent on a stream arrived.
  | Responded({ stream: Int, response: Response })
  /// The peer reset a stream, or a client's stream was refused, so what it carried will not be
  /// finished. `RefusedStream` means the server did nothing with it, so it may be sent again.
  | Reset({ stream: Int, code: ErrorCode })
  /// A client rejected the response on its stream and reset the stream; the reason explains why.
  | Failed({ stream: Int, reason: String })
  /// The peer began to close the connection: streams this end opened past `last_stream` were not
  /// accepted, and no more may be opened.
  | GoingAway({ last_stream: Int, code: ErrorCode, debug: Bytes })
  /// The connection ended for this reason, with this code in the `GOAWAY` either end sent; every
  /// stream still open on it is lost.
  | Closed({ code: ErrorCode, reason: String })

/// The state of a stream that both ends have not closed (RFC 9113 §5.1): open, finished sending by
/// this end, or finished sending by the peer.
type Phase = | Open | LocalClosed | RemoteClosed

type Stream = {
  id: Int,
  phase: Phase,
  send_window: Int,
  recv_window: Int,
  /// Octets read and not yet given back to the peer's window.
  unacked: Int,
  /// A server's request as read so far, or the request a client sent.
  request: Request,
  /// A client's response head: its status, 0 until it arrives, and its fields.
  status: Int,
  headers: Headers,
  /// The `content-length` the message's head gave.
  expected: Option<Int>,
  body: List<Bytes>,
  received: Int,
  trailers: Headers,
  /// The body this end sends, how much of it has been sent, the trailers that follow it, whether
  /// the stream has anything left to send, and whether more of the body is still to come.
  out: Bytes,
  sent: Int,
  trailers_out: List<Field>,
  sending: Bool,
  more: Bool,
  /// A server responded before the request ended, so the stream is reset once the response is sent.
  reset_after: Bool,
  returned: Bool,
  since: Int,
  /// When its output began to wait on a closed window, or -1.
  stalled: Int,
}

/// A field block whose `CONTINUATION` frames are still coming.
type Block = {
  stream: Int,
  pieces: List<Bytes>,
  size: Int,
  continuations: Int,
  end_stream: Bool,
  priority: Option<Priority>,
  since: Int,
}

type ConnectionState = {
  role: Role,
  limits: Limits,
  /// A server has read the client's preface.
  started: Bool,
  /// The peer's first `SETTINGS` has been read.
  greeted: Bool,
  /// The connection is closed: input is ignored, and only output is left.
  over: Bool,
  /// Input not yet read, in the pieces it arrived in, how many octets they contain, and how many
  /// the next frame needs. The pieces are joined only once the frame can be read, so a frame that
  /// arrives an octet at a time is not copied again for each octet.
  held: List<Bytes>,
  pending_size: Int,
  needed: Int,
  out: List<Bytes>,
  decoder: Decoder,
  encoder: Encoder,
  /// This end's `SETTINGS` have been acknowledged, and when they were sent.
  acked: Bool,
  settings_at: Int,
  peer_window: Int,
  peer_frame: Int,
  peer_streams: Int,
  streams: Map<Int, Stream>,
  /// Recently closed streams, `true` when this end reset them, whose late frames are discarded.
  closed: Map<Int, Bool>,
  /// The highest stream the peer opened, the stream this end opens next, and how many the peer
  /// opened in total.
  highest: Int,
  next_stream: Int,
  opened: Int,
  send_window: Int,
  recv_window: Int,
  unacked: Int,
  block: Option<Block>,
  window_start: Int,
  resets: Int,
  settings: Int,
  pings: Int,
  empty_frames: Int,
  /// The last stream named in a final `GOAWAY` sent and in one received, or -1.
  goaway_sent: Int,
  goaway_received: Int,
  /// When a server's drain sent its first `GOAWAY`, or -1.
  draining: Int,
  buffered: Int,
  /// The time since which no stream has been open.
  quiet_since: Int,
  /// The stream the last round of `DATA` ended at, so the next starts after it.
  turn: Int,
  events: List<Event>,
}

/// One end of an HTTP/2 connection.
pub opaque type Connection = | Connection(ConnectionState)

/// What a call returns: the connection after it, and what happened, in order.
pub type ReceiveResult = { connection: Connection, events: List<Event> }

fn state_of(c: Connection) -> ConnectionState = match c { Connection(k) -> k }

fn ms(now: Instant) -> Int = match now { Instant(n) -> n / 1000000 }

fn drain_ping() -> Bytes = b"draining"

fn our_settings(l: Limits) -> List<Setting> =
  [
    HeaderTableSize(l.max_table_size),
    EnablePush(false),
    MaxConcurrentStreams(l.max_concurrent_streams),
    InitialWindowSize(l.initial_window),
    MaxFrameSize(l.max_frame_size),
    MaxHeaderListSize(l.max_header_list_size),
  ]

fn blank_request() -> Request =
  {
    method: "",
    scheme: "",
    authority: "",
    target: "",
    headers: Map::new(),
    trailers: Map::new(),
    body: b"",
  }

fn new_connection(role: Role, limits: Limits, now: Instant) -> Connection / {abort.raise} = {
  check_limits(limits);
  let t = ms(now);
  let raise_by = limits.connection_window - default_window();
  let greeting = encode_frame(SettingsFrame({ ack: false, settings: our_settings(limits) }));
  let window = if raise_by > 0 {
    [encode_frame(WindowUpdateFrame({ stream: 0, increment: raise_by }))]
  } else { [] };
  Connection({
    role: role,
    limits: limits,
    started: role == Client,
    greeted: false,
    over: false,
    held: [],
    pending_size: 0,
    needed: 0,
    out: List::concat(if role == Client { [preface(), greeting] } else { [greeting] }, window),
    decoder: decoder(
      max(default_table_size(), limits.max_table_size),
      limits.max_table_size_updates,
    ),
    encoder: with_capacity(
      encoder(default_table_size()),
      min(default_table_size(), limits.max_table_size),
    ),
    acked: false,
    settings_at: t,
    peer_window: default_window(),
    peer_frame: default_frame_size(),
    peer_streams: largest_window(),
    streams: Map::new(),
    closed: Map::new(),
    highest: 0,
    next_stream: 1,
    opened: 0,
    send_window: default_window(),
    recv_window: max(default_window(), limits.connection_window),
    unacked: 0,
    block: None,
    window_start: t,
    resets: 0,
    settings: 0,
    pings: 0,
    empty_frames: 0,
    goaway_sent: -1,
    goaway_received: -1,
    draining: -1,
    buffered: 0,
    quiet_since: t,
    turn: 0,
    events: [],
  })
}

/// A server's end of a connection a client just opened. Its `SETTINGS` are the first output, and
/// the client's preface is the first input it reads: a connection that opens with anything else,
/// including an HTTP/1.1 request, is closed at its first byte that differs. Panics on limits
/// `check_limits` rejects.
pub fn server(limits: Limits, now: Instant) -> Connection / {abort.raise} =
  new_connection(Server, limits, now)

/// A client's end of a connection it just opened. The preface and its `SETTINGS` are the first
/// output. Panics on limits `check_limits` rejects.
pub fn client(limits: Limits, now: Instant) -> Connection / {abort.raise} =
  new_connection(Client, limits, now)

/// The bytes to write to the peer, in order, and the connection without them.
pub fn take_output(c: Connection) -> { connection: Connection, bytes: Bytes } = {
  let k = state_of(c);
  { connection: Connection({ ..k, out: [] }), bytes: Bytes::concat_all(k.out) }
}

/// Whether the connection is over: closed on an error, or closing with no stream left open. Once
/// `take_output`'s bytes are written, the socket can be closed.
pub fn finished(c: Connection) -> Bool = {
  let k = state_of(c);
  k.over
    || ((k.goaway_sent >= 0 || k.goaway_received >= 0) && k.streams.len() == 0 && k.block == None)
}

/// Streams open on the connection, in either direction.
pub fn open_streams(c: Connection) -> Int = state_of(c).streams.len()

/// Octets of messages waiting on the peer's windows.
pub fn buffered_octets(c: Connection) -> Int = state_of(c).buffered

fn emit_frame(k: ConnectionState, f: Frame) -> ConnectionState / {abort.raise} =
  { ..k, out: k.out.push(encode_frame(f)) }

fn event(k: ConnectionState, e: Event) -> ConnectionState = { ..k, events: k.events.push(e) }

fn store_stream(k: ConnectionState, st: Stream) -> ConnectionState =
  { ..k, streams: k.streams.insert(st.id, st) }

fn enhance_your_calm<a>(reason: String) -> a / {http2.violated} =
  violation(EnhanceYourCalm, 0, reason)

fn rate_text(n: Int, l: Limits) -> String =
  n.to_string() ++ " within " ++ l.window_ms.to_string() ++ " ms"

/// The connection with its counts reset where their window has passed.
fn roll_window(k: ConnectionState, t: Int) -> ConnectionState =
  if t - k.window_start >= k.limits.window_ms {
    { ..k, window_start: t, resets: 0, settings: 0, pings: 0, empty_frames: 0 }
  } else { k }

fn count_empty_frame(k: ConnectionState, t: Int) -> ConnectionState / {http2.violated} = {
  let r = roll_window(k, t);
  if r.empty_frames >= r.limits.max_empty_frames {
    enhance_your_calm(
      "more than " ++ rate_text(r.limits.max_empty_frames, r.limits)
        ++ " of frames that carry nothing",
    )
  } else { { ..r, empty_frames: r.empty_frames + 1 } }
}

/// Whether the peer opens a stream of this number: clients open the odd ones.
fn peer_opens(k: ConnectionState, s: Int) -> Bool =
  match k.role { Server -> s % 2 == 1, Client -> s % 2 == 0 }

/// Whether a stream has not been opened yet.
fn idle(k: ConnectionState, s: Int) -> Bool =
  if peer_opens(k, s) { s > k.highest } else { s >= k.next_stream }

/// The window a stream starts with on this end. Until the peer acknowledges this end's
/// `SETTINGS`, it may still send as the protocol's default allows.
fn recv_target(k: ConnectionState) -> Int =
  if k.acked { k.limits.initial_window } else { max(default_window(), k.limits.initial_window) }

fn remember_closed(closed: Map<Int, Bool>, s: Int, by_us: Bool, most: Int) -> Map<Int, Bool> = {
  let kept = closed.insert(s, by_us);
  if kept.len() <= most { kept } else { match kept.pop_first() { Some(p) -> p.rest, None -> kept } }
}

/// The connection without a stream, which is remembered as closed.
fn drop_stream(k: ConnectionState, st: Stream, by_us: Bool, t: Int) -> ConnectionState = {
  let streams = k.streams.remove(st.id);
  {
    ..k,
    streams: streams,
    closed: remember_closed(k.closed, st.id, by_us, 2 * k.limits.max_concurrent_streams + 16),
    buffered: k.buffered - (st.out.len() - st.sent),
    quiet_since: if streams.len() == 0 { t } else { k.quiet_since },
  }
}

/// A stream reset by this end, which counts towards `max_resets` as one the peer resets does.
fn reset_stream(
  k: ConnectionState,
  s: Int,
  code: ErrorCode,
  t: Int,
) -> ConnectionState / {abort.raise} = {
  let r = roll_window(k, t);
  if r.resets >= r.limits.max_resets {
    close_with_error(
      r,
      EnhanceYourCalm,
      "more than " ++ rate_text(r.limits.max_resets, r.limits) ++ " of streams reset",
    )
  } else {
    let sent = emit_frame({ ..r, resets: r.resets + 1 }, ResetFrame({ stream: s, code: code }));
    match sent.streams.get(s) {
      Some(st) -> drop_stream(sent, st, true, t),
      None ->
        {
          ..sent,
          closed: remember_closed(
            sent.closed,
            s,
            true,
            2 * sent.limits.max_concurrent_streams + 16,
          ),
        },
    }
  }
}

/// The connection closed on an error: a `GOAWAY` naming it, and nothing read after it.
fn close_with_error(
  k: ConnectionState,
  code: ErrorCode,
  reason: String,
) -> ConnectionState / {abort.raise} =
  if k.over { k } else {
    let sent = emit_frame(
      k,
      GoAwayFrame({ last_stream: k.highest, code: code, debug: Bytes::of_string(reason) }),
    );
    event(
      { ..sent, over: true, held: [], pending_size: 0, block: None, goaway_sent: k.highest },
      Closed({ code: code, reason: reason }),
    )
  }

fn goaway(k: ConnectionState, last: Int) -> ConnectionState / {abort.raise} = {
  let sent = emit_frame(k, GoAwayFrame({ last_stream: last, code: NoError, debug: b"" }));
  { ..sent, goaway_sent: last }
}

// --- The connection: reading -------------------------------------------------------

/// Reads `data`, the next bytes from the peer, and returns the events they cause, after the events
/// from calls since the last `receive` or `tick`. A breach of the protocol closes the stream it is
/// limited to, or the connection. Either way the output contains the frame that reports it, and a
/// closed connection reads nothing more.
pub fn receive(c: Connection, data: Bytes, now: Instant) -> ReceiveResult / {abort.raise} = {
  let k = state_of(c);
  let size = k.pending_size + data.len();
  if k.over { report(k) } else if k.started && size < k.needed {
    report({ ..k, held: k.held.push(data), pending_size: size })
  } else {
    let t = ms(now);
    let buf = Bytes::concat_all(k.held.push(data));
    report(
      send_pending_data(
        if k.started { framed_input(k, buf, t) } else { read_preface(k, buf, t) },
        t,
      ),
    )
  }
}

/// The events the calls produced, with the requests still waiting for a response. A request whose
/// stream the peer reset in the same bytes, or on a connection now closed, is not passed to the
/// application.
fn report(k: ConnectionState) -> ReceiveResult =
  {
    connection: Connection({ ..k, events: [] }),
    events: k.events.filter(|e: Event|
      match e {
        Requested(r) ->
          !k.over && (match k.streams.get(r.stream) { Some(st) -> !st.returned, None -> false }),
        _ -> true,
      }),
  }

fn read_preface(k: ConnectionState, buf: Bytes, t: Int) -> ConnectionState / {abort.raise} = {
  let n = min(buf.len(), preface().len());
  if buf.slice(0, n) != preface().slice(0, n) {
    close_with_error(k, ProtocolError, "the connection does not open with the HTTP/2 preface")
  } else if n < preface().len() { { ..k, held: [buf], pending_size: buf.len() } }
  else { framed_input({ ..k, started: true }, buf.slice(n, buf.len()), t) }
}

type Scan = { k: ConnectionState, at: Int }

/// Every whole frame in `buf`, which contains all input not yet read.
fn framed_input(k: ConnectionState, buf: Bytes, t: Int) -> ConnectionState / {abort.raise} = {
  let done = iterate({ k: k, at: 0 }, buf.len() / 9 + 2, |r: Scan|
    if r.k.over { Stop(r) } else {
      match frame_length(buf, r.at) {
        None -> Stop(r),
        Some(length) -> if length > r.k.limits.max_frame_size {
          Stop({
            ..r,
            k: close_with_error(
              r.k,
              FrameSizeError,
              "a frame of " ++ length.to_string() ++ " octets, past the "
                ++ r.k.limits.max_frame_size.to_string()
                ++ " allowed",
            ),
          })
        } else if buf.len() - r.at - 9 < length { Stop(r) }
        else { Continue({ k: one_frame(r.k, buf, r.at, t), at: r.at + 9 + length }) },
      }
    });
  if done.k.over { done.k } else {
    let rest = buf.slice(done.at, buf.len());
    {
      ..done.k,
      held: [rest],
      pending_size: rest.len(),
      needed: match frame_length(rest, 0) { Some(length) -> 9 + length, None -> 9 },
    }
  }
}

/// One whole frame, whose header is at `at`. A violation limited to a stream resets it; any other
/// closes the connection, from the state before the frame.
fn one_frame(k: ConnectionState, buf: Bytes, at: Int, t: Int) -> ConnectionState / {abort.raise} = {
  let kind = buf.at(at + 3);
  let stream = word(buf, at + 5) & 0x7FFF_FFFF;
  match k.block {
    Some(b) -> if kind != 9 || stream != b.stream {
      close_with_error(k, ProtocolError, "a field block interrupted before its END_HEADERS")
    } else { handle_frame(k, buf, at, t) },
    None -> if !k.greeted && (kind != 4 || buf.at(at + 4) & 0x1 != 0) {
      close_with_error(k, ProtocolError, "a connection whose first frame is not SETTINGS")
    } else { handle_frame(k, buf, at, t) },
  }
}

fn handle_frame(
  k: ConnectionState,
  buf: Bytes,
  at: Int,
  t: Int,
) -> ConnectionState / {abort.raise} =
  match try {
      match read_frame(buf, at, k.limits.max_frame_size) {
        None -> k,
        Some(r) -> on_frame(k, r.frame, t),
      }
    } {
    Ok(next) -> next,
    // No RST_STREAM goes to an idle stream (§6.4), so an error confined to one ends the connection.
    Err(v) -> if v.stream == 0 || idle(k, v.stream) { close_with_error(k, v.code, v.reason) }
    else { reset_stream(k, v.stream, v.code, t) },
  }

fn on_frame(
  k: ConnectionState,
  f: Frame,
  t: Int,
) -> ConnectionState / {http2.violated, abort.raise} =
  match f {
    DataFrame(d) -> on_data(k, d.stream, d.data, d.end_stream, flow_length(f), t),
    HeadersFrame(h) -> on_headers(k, h.stream, h.block, h.end_stream, h.end_headers, h.priority, t),
    PriorityFrame(_) -> count_empty_frame(k, t),
    ResetFrame(r) -> on_reset(k, r.stream, r.code, t),
    SettingsFrame(s) -> if s.ack { on_settings_ack(k) } else { on_settings(k, s.settings, t) },
    PushPromiseFrame(_) ->
      violation(ProtocolError, 0, "a PUSH_PROMISE frame, which this endpoint does not accept"),
    PingFrame(p) -> on_ping(k, p.ack, p.data, t),
    GoAwayFrame(g) -> on_goaway(k, g.last_stream, g.code, g.debug, t),
    WindowUpdateFrame(w) -> on_window_update(k, w.stream, w.increment, t),
    ContinuationFrame(c) -> on_continuation(k, c.end_headers, c.block, t),
    UnknownFrame(_) -> count_empty_frame(k, t),
  }

/// The octets a `DATA` frame took from the connection's window, given back to the peer once half
/// the window is used: a stream buffers what it reads, so the window never waits on another stream.
fn credit_window(k: ConnectionState, flow: Int) -> ConnectionState / {abort.raise} = {
  let unacked = k.unacked + flow;
  if unacked > 0 && unacked >= max(default_window(), k.limits.connection_window) / 2 {
    emit_frame(
      { ..k, recv_window: k.recv_window + unacked, unacked: 0 },
      WindowUpdateFrame({ stream: 0, increment: unacked }),
    )
  } else { { ..k, unacked: unacked } }
}

fn on_data(
  k: ConnectionState,
  s: Int,
  data: Bytes,
  end: Bool,
  flow: Int,
  t: Int,
) -> ConnectionState / {http2.violated, abort.raise} =
  if idle(k, s) { violation(ProtocolError, 0, "DATA on a stream not yet open") }
  else if flow > k.recv_window {
    violation(FlowControlError, 0, "DATA past the connection's window")
  } else {
    let paid = credit_window({ ..k, recv_window: k.recv_window - flow }, flow);
    let counted = if data.len() == 0 && !end { count_empty_frame(paid, t) } else { paid };
    match counted.streams.get(s) {
      None -> if counted.closed.get(s) == Some(true) { counted }
      else { violation(StreamClosed, 0, "DATA on a closed stream") },
      Some(st) -> if st.phase == RemoteClosed { reset_stream(counted, s, StreamClosed, t) }
      else if flow > st.recv_window { reset_stream(counted, s, FlowControlError, t) }
      else if counted.role == Client && st.status == 0 {
        fail_stream(counted, st, "DATA arrived before the response headers", t)
      } else if counted.role == Server && st.returned { discard_data(counted, st, end, flow, t) }
      else { accept_data(counted, st, data, end, flow, t) },
    }
  }

fn accept_data(
  k: ConnectionState,
  st: Stream,
  data: Bytes,
  end: Bool,
  flow: Int,
  t: Int,
) -> ConnectionState / {abort.raise} = {
  let received = st.received + data.len();
  if received > k.limits.max_body {
    match k.role {
      Server ->
        reject_request(
          k,
          st,
          413,
          "the body is longer than " ++ k.limits.max_body.to_string() ++ " octets",
          t,
        ),
      Client ->
        fail_stream(k, st, "a body longer than " ++ k.limits.max_body.to_string() ++ " octets", t),
    }
  } else {
    let unacked = if end { 0 } else { st.unacked + flow };
    let update = !end && unacked > 0 && unacked >= recv_target(k) / 2;
    let read = {
      ..st,
      recv_window: st.recv_window - flow + (if update { unacked } else { 0 }),
      unacked: if update { 0 } else { unacked },
      body: st.body.push(data),
      received: received,
    };
    let given = if update {
      emit_frame(k, WindowUpdateFrame({ stream: st.id, increment: unacked }))
    } else { k };
    if end { remote_ended(given, read, t) } else { store_stream(given, read) }
  }
}

fn has_no_body(st: Stream) -> Bool =
  st.status == 204 || st.status == 304 || st.request.method == "HEAD"

/// The peer ended its side of a stream: the message is whole.
fn remote_ended(k: ConnectionState, st: Stream, t: Int) -> ConnectionState / {abort.raise} =
  match st.expected {
    // The response to HEAD, a 204 and a 304 carry the length another response's body would have.
    Some(n) if n != st.received && !(k.role == Client && has_no_body(st)) -> match k.role {
      Server -> reset_stream(k, st.id, ProtocolError, t),
      Client -> fail_stream(k, st, "the body length differs from the content-length", t),
    },
    _ -> match k.role {
      Server -> {
        let ended = { ..st, phase: RemoteClosed };
        event(
          store_stream(k, ended),
          Requested({
            stream: st.id,
            request: { ..st.request, body: Bytes::concat_all(st.body), trailers: st.trailers },
          }),
        )
      },
      Client -> {
        let result = Responded({
          stream: st.id,
          response: { status: st.status, headers: st.headers, body: Bytes::concat_all(st.body) },
        });
        if st.phase == LocalClosed { event(drop_stream(k, st, false, t), result) }
        else { event(store_stream(k, { ..st, phase: RemoteClosed }), result) }
      },
    },
  }

fn on_headers(
  k: ConnectionState,
  s: Int,
  block: Bytes,
  end_stream: Bool,
  end_headers: Bool,
  priority: Option<Priority>,
  t: Int,
) -> ConnectionState / {http2.violated, abort.raise} =
  if block.len() > k.limits.max_header_block {
    enhance_your_calm("a field block past " ++ k.limits.max_header_block.to_string() ++ " octets")
  } else if end_headers { field_block(k, s, block, end_stream, priority, t) } else {
    {
      ..k,
      block: Some({
        stream: s,
        pieces: [block],
        size: block.len(),
        continuations: 0,
        end_stream: end_stream,
        priority: priority,
        since: t,
      }),
    }
  }

fn on_continuation(
  k: ConnectionState,
  end_headers: Bool,
  piece: Bytes,
  t: Int,
) -> ConnectionState / {http2.violated, abort.raise} =
  match k.block {
    None -> violation(ProtocolError, 0, "a CONTINUATION with no field block open"),
    Some(b) -> if b.continuations >= k.limits.max_continuations {
      enhance_your_calm(
        "more than " ++ k.limits.max_continuations.to_string()
          ++ " CONTINUATION frames in one field block",
      )
    } else if b.size + piece.len() > k.limits.max_header_block {
      enhance_your_calm("a field block past " ++ k.limits.max_header_block.to_string() ++ " octets")
    } else {
      let counted = if piece.len() == 0 && !end_headers { count_empty_frame(k, t) } else { k };
      let grown = {
        ..b,
        pieces: b.pieces.push(piece),
        size: b.size + piece.len(),
        continuations: b.continuations + 1,
      };
      if end_headers {
        field_block(
          { ..counted, block: None },
          b.stream,
          Bytes::concat_all(grown.pieces),
          b.end_stream,
          b.priority,
          t,
        )
      } else { { ..counted, block: Some(grown) } }
    },
  }

/// A whole field block: decoded whatever becomes of its stream, so the two ends' tables agree.
fn field_block(
  k: ConnectionState,
  s: Int,
  block: Bytes,
  end_stream: Bool,
  priority: Option<Priority>,
  t: Int,
) -> ConnectionState / {http2.violated, abort.raise} = {
  let d = decode(k.decoder, block);
  let read = { ..k, decoder: d.decoder };
  match k.role {
    Server -> if !peer_opens(read, s) {
      violation(ProtocolError, 0, "HEADERS on an even stream, which only a server opens")
    } else {
      match read.streams.get(s) {
        Some(st) -> trailers_in(read, st, d, end_stream, t),
        None -> if s > read.highest { new_stream(read, s, d, end_stream, priority, t) } else {
          match read.closed.get(s) {
            Some(true) -> read,
            Some(false) -> violation(StreamClosed, 0, "HEADERS on a closed stream"),
            None -> violation(ProtocolError, 0, "a new stream has a lower number than a stream that was already opened"),
          }
        },
      }
    },
    Client -> if peer_opens(read, s) {
      violation(ProtocolError, 0, "HEADERS on a stream the server opened")
    } else if s >= read.next_stream {
      violation(ProtocolError, 0, "HEADERS on a stream not yet open")
    } else {
      match read.streams.get(s) {
        Some(st) -> response_head(read, st, d, end_stream, t),
        None -> if read.closed.get(s) == Some(true) { read }
        else { violation(StreamClosed, 0, "HEADERS on a closed stream") },
      }
    },
  }
}

fn new_stream(
  k: ConnectionState,
  s: Int,
  d: DecodeResult,
  end_stream: Bool,
  priority: Option<Priority>,
  t: Int,
) -> ConnectionState / {abort.raise} = {
  let seen = { ..k, highest: s };
  if seen.goaway_sent >= 0 && s > seen.goaway_sent {
    // Past the last stream a GOAWAY named: ignored, and its late frames with it.
    {
      ..seen,
      closed: remember_closed(seen.closed, s, true, 2 * seen.limits.max_concurrent_streams + 16),
    }
  } else if match priority { Some(p) -> p.depends_on == s, None -> false } {
    reset_stream(seen, s, ProtocolError, t)
  } else if seen.streams.len() >= seen.limits.max_concurrent_streams
      || seen.buffered >= seen.limits.max_buffered { reset_stream(seen, s, RefusedStream, t) }
  else {
    let counted = { ..seen, opened: seen.opened + 1 };
    let taken = if counted.opened >= counted.limits.max_requests && counted.goaway_sent < 0 {
      goaway(counted, s)
    } else { counted };
    let st = fresh_stream(
      taken,
      s,
      if end_stream { RemoteClosed } else { Open },
      blank_request(),
      t,
    );
    if d.size > taken.limits.max_header_list_size {
      reject_request(
        store_stream(taken, st),
        st,
        431,
        "the fields are larger than " ++ taken.limits.max_header_list_size.to_string() ++ " octets",
        t,
      )
    } else {
      match request_of(d.fields) {
        Malformed(_) -> reset_stream(taken, s, ProtocolError, t),
        Rejected(status, reason) -> reject_request(store_stream(taken, st), st, status, reason, t),
        WellFormed(request, expected) -> {
          let read = { ..st, request: request, expected: expected, phase: Open };
          if end_stream { remote_ended(store_stream(taken, read), read, t) }
          else if match request.headers.get("expect") {
              Some([v]) -> v.ascii_lower() == "100-continue",
              _ -> false,
            } {
            // The client waits for the 100 before it sends its body.
            store_stream(emit_headers(taken, s, [status_field(100)], false), read)
          } else { store_stream(taken, read) }
        },
      }
    }
  }
}

fn fresh_stream(k: ConnectionState, s: Int, phase: Phase, request: Request, t: Int) -> Stream =
  {
    id: s,
    phase: phase,
    send_window: k.peer_window,
    recv_window: recv_target(k),
    unacked: 0,
    request: request,
    status: 0,
    headers: Map::new(),
    expected: None,
    body: [],
    received: 0,
    trailers: Map::new(),
    out: b"",
    sent: 0,
    trailers_out: [],
    sending: false,
    more: false,
    reset_after: false,
    returned: false,
    since: t,
    stalled: -1,
  }

/// Fields after a message's body: they end the stream and contain no pseudo-header.
fn trailers_in(
  k: ConnectionState,
  st: Stream,
  d: DecodeResult,
  end_stream: Bool,
  t: Int,
) -> ConnectionState / {abort.raise} =
  if st.phase == RemoteClosed { reset_stream(k, st.id, StreamClosed, t) }
  else if k.role == Server && st.returned { discard_data(k, st, end_stream, 0, t) }
  else if !end_stream || d.size > k.limits.max_header_list_size {
    match k.role {
      Server -> reset_stream(k, st.id, ProtocolError, t),
      Client -> fail_stream(k, st, "trailers that do not end the stream, or are too large", t),
    }
  } else {
    match trailers_of(d.fields) {
      Ok(h) -> remote_ended(k, { ..st, trailers: h }, t),
      Err(reason) -> match k.role {
        Server -> reset_stream(k, st.id, ProtocolError, t),
        Client -> fail_stream(k, st, reason, t),
      },
    }
  }

fn response_head(
  k: ConnectionState,
  st: Stream,
  d: DecodeResult,
  end_stream: Bool,
  t: Int,
) -> ConnectionState / {abort.raise} =
  if st.phase == RemoteClosed { reset_stream(k, st.id, StreamClosed, t) }
  else if st.status != 0 { trailers_in(k, st, d, end_stream, t) }
  else if d.size > k.limits.max_header_list_size {
    fail_stream(
      k,
      st,
      "a response head larger than " ++ k.limits.max_header_list_size.to_string() ++ " octets",
      t,
    )
  } else {
    match response_of(d.fields) {
      Err(reason) -> fail_stream(k, st, reason, t),
      Ok(r) -> if r.status < 200 {
        if end_stream { fail_stream(k, st, "an informational response that ends its stream", t) }
        else { k }
      } else {
        let headed = { ..st, status: r.status, headers: r.headers, expected: r.expected };
        if end_stream { remote_ended(k, headed, t) } else { store_stream(k, headed) }
      },
    }
  }

/// A client rejecting the malformed response on one of its streams.
fn fail_stream(
  k: ConnectionState,
  st: Stream,
  reason: String,
  t: Int,
) -> ConnectionState / {abort.raise} = failed_with(k, st, ProtocolError, reason, t)

fn failed_with(
  k: ConnectionState,
  st: Stream,
  code: ErrorCode,
  reason: String,
  t: Int,
) -> ConnectionState / {abort.raise} =
  event(reset_stream(k, st.id, code, t), Failed({ stream: st.id, reason: reason }))

/// What the peer sends on a stream a server has already responded to: read and dropped.
fn discard_data(k: ConnectionState, st: Stream, end: Bool, flow: Int, t: Int) -> ConnectionState = {
  let read = { ..st, recv_window: st.recv_window - flow };
  if !end { store_stream(k, read) }
  else if st.phase == LocalClosed { drop_stream(k, read, false, t) }
  else { store_stream(k, { ..read, phase: RemoteClosed, reset_after: false }) }
}

/// A server responding to a request it does not pass on, with the status that gives the reason.
fn reject_request(
  k: ConnectionState,
  st: Stream,
  status: Int,
  reason: String,
  t: Int,
) -> ConnectionState / {abort.raise} =
  match k.streams.get(st.id) {
    Some(current) -> if current.returned { reset_stream(k, st.id, Cancel, t) }
    else { send_response(k, current, plain_text(status, reason ++ "\n"), t) },
    None -> k,
  }

/// A `text/plain` response, as a server sends for what it rejects.
fn plain_text(status: Int, text: String) -> Response =
  {
    status: status,
    headers: Map::new().insert("content-type", ["text/plain; charset=utf-8"]),
    body: Bytes::of_string(text),
  }

fn on_reset(
  k: ConnectionState,
  s: Int,
  code: ErrorCode,
  t: Int,
) -> ConnectionState / {http2.violated} =
  if idle(k, s) { violation(ProtocolError, 0, "RST_STREAM on a stream not yet open") } else {
    let r = roll_window(k, t);
    if r.resets >= r.limits.max_resets {
      enhance_your_calm(
        "more than " ++ rate_text(r.limits.max_resets, r.limits) ++ " of streams reset",
      )
    } else {
      let counted = { ..r, resets: r.resets + 1 };
      match counted.streams.get(s) {
        None -> counted,
        Some(st) -> event(drop_stream(counted, st, false, t), Reset({ stream: s, code: code })),
      }
    }
  }

fn on_settings(
  k: ConnectionState,
  settings: List<Setting>,
  t: Int,
) -> ConnectionState / {http2.violated, abort.raise} = {
  let r = roll_window(k, t);
  if r.settings >= r.limits.max_settings {
    enhance_your_calm(
      "more than " ++ rate_text(r.limits.max_settings, r.limits) ++ " of SETTINGS frames",
    )
  } else {
    let applied = settings.fold({ ..r, settings: r.settings + 1, greeted: true }, setting_applied);
    emit_frame(applied, SettingsFrame({ ack: true, settings: [] }))
  }
}

fn setting_applied(
  k: ConnectionState,
  s: Setting,
) -> ConnectionState / {http2.violated, abort.raise} =
  match s {
    HeaderTableSize(n) ->
      { ..k, encoder: with_capacity(k.encoder, min(n, k.limits.max_table_size)) },
    EnablePush(on) -> if on && k.role == Client {
      violation(ProtocolError, 0, "the server sent SETTINGS_ENABLE_PUSH with the value 1")
    } else { k },
    MaxConcurrentStreams(n) -> { ..k, peer_streams: n },
    InitialWindowSize(n) -> {
      let delta = n - k.peer_window;
      let moved = k.streams.fold(Map::new(), |acc: Map<Int, Stream>, id: Int, st: Stream|
        if st.send_window + delta > largest_window() {
          violation(
            FlowControlError,
            0,
            "SETTINGS_INITIAL_WINDOW_SIZE would raise a stream's window above 2^31-1",
          )
        } else { acc.insert(id, { ..st, send_window: st.send_window + delta }) });
      { ..k, peer_window: n, streams: moved }
    },
    MaxFrameSize(n) -> { ..k, peer_frame: n },
    MaxHeaderListSize(_) -> k,
    Unknown(_, _) -> k,
  }

/// The peer has acknowledged this end's `SETTINGS`: its windows and its table now take the values
/// they set.
fn on_settings_ack(k: ConnectionState) -> ConnectionState =
  if k.acked { k } else {
    let delta = k.limits.initial_window - max(default_window(), k.limits.initial_window);
    {
      ..k,
      acked: true,
      decoder: with_ceiling(k.decoder, k.limits.max_table_size),
      streams: if delta == 0 { k.streams } else {
        k.streams.fold(Map::new(), |acc: Map<Int, Stream>, id: Int, st: Stream|
          acc.insert(id, { ..st, recv_window: st.recv_window + delta }))
      },
    }
  }

fn on_ping(
  k: ConnectionState,
  ack: Bool,
  data: Bytes,
  t: Int,
) -> ConnectionState / {http2.violated, abort.raise} =
  if ack {
    if k.draining >= 0 && k.goaway_sent < 0 && data == drain_ping() { goaway(k, k.highest) }
    else { k }
  } else {
    let r = roll_window(k, t);
    if r.pings >= r.limits.max_pings {
      enhance_your_calm(
        "more than " ++ rate_text(r.limits.max_pings, r.limits) ++ " of PING frames",
      )
    } else { emit_frame({ ..r, pings: r.pings + 1 }, PingFrame({ ack: true, data: data })) }
  }

fn on_goaway(
  k: ConnectionState,
  last: Int,
  code: ErrorCode,
  debug: Bytes,
  t: Int,
) -> ConnectionState = {
  let bound = if k.goaway_received >= 0 { min(last, k.goaway_received) } else { last };
  let untaken = k.streams.values().filter(|st: Stream| !peer_opens(k, st.id) && st.id > bound);
  let refused_ones = untaken.fold(
    { ..k, goaway_received: bound },
    |acc: ConnectionState, st: Stream|
      event(drop_stream(acc, st, false, t), Reset({ stream: st.id, code: RefusedStream })),
  );
  let told = event(refused_ones, GoingAway({ last_stream: bound, code: code, debug: debug }));
  if code == NoError { told } else {
    event(
      { ..told, over: true, held: [], pending_size: 0, block: None },
      Closed({ code: code, reason: "the peer's GOAWAY: " ++ String::of_bytes_lossy(debug) }),
    )
  }
}

fn on_window_update(
  k: ConnectionState,
  s: Int,
  increment: Int,
  t: Int,
) -> ConnectionState / {http2.violated, abort.raise} =
  if s == 0 {
    if k.send_window + increment > largest_window() {
      violation(FlowControlError, 0, "a connection window past 2^31-1")
    } else { { ..k, send_window: k.send_window + increment } }
  } else if idle(k, s) { violation(ProtocolError, 0, "WINDOW_UPDATE on a stream not yet open") }
  else {
    match k.streams.get(s) {
      None -> k,
      Some(st) -> if st.send_window + increment > largest_window() {
        reset_stream(k, s, FlowControlError, t)
      } else { store_stream(k, { ..st, send_window: st.send_window + increment }) },
    }
  }

// --- Messages: fields as a request or a response -----------------------------------

/// What a request's head is: a request and the `content-length` it gave, malformed (RFC 9113
/// §8.1.1), or well formed and not served, with the status that reports why.
type Head = | WellFormed(Request, Option<Int>) | Malformed(String) | Rejected(Int, String)

type CollectedHeaders = {
  pseudo: Map<Bytes, Bytes>,
  regular: Bool,
  headers: Headers,
  cookies: List<String>,
  content_length: Option<Int>,
  malformed_reason: Option<String>,
}

/// A field name's octets after its colon, if any: lowercase, and a token's (RFC 9113 §8.2.1).
fn name_chars() -> Bytes = b"!#$%&'*+-.^_`|~0123456789abcdefghijklmnopqrstuvwxyz"

/// What is wrong with a field as RFC 9113 §8.2.1 has one, and a value that is not UTF-8, which
/// `std.http` rejects too.
fn field_flaw(f: Field) -> Option<String> / {abort.raise} = {
  let n = f.name.len();
  let from = if n > 0 && f.name.at(0) == b':' { 1 } else { 0 };
  let v = f.value.len();
  if n == from { Some("an empty field name") }
  else if f.name.scan(from, name_chars(), n - from) < n {
    Some(if f.name.scan_until(0, b"ABCDEFGHIJKLMNOPQRSTUVWXYZ", n) < n {
      "a field name with an uppercase letter"
    } else { "a field name that is not a token" })
  } else if v > 0 && f.value.scan_until(0, b"\x00\r\n", v) < v {
    Some("a field value with NUL, CR or LF")
  } else if v > 0 && (is_blank(f.value.at(0)) || is_blank(f.value.at(v - 1))) {
    Some("a field value with whitespace at either end")
  } else if !f.value.is_utf8() { Some("a field value that is not UTF-8") }
  else { None }
}

/// Fields that describe a connection, which HTTP/2 does not carry (§8.2.2).
fn connection_specific(name: String) -> Bool =
  name == "connection" || name == "keep-alive" || name == "proxy-connection"
    || name == "transfer-encoding"
    || name == "upgrade"

fn collect_headers(
  fields: List<Field>,
  allowed: List<Bytes>,
  trailing: Bool,
) -> CollectedHeaders / {abort.raise} =
  fields.fold(
    {
      pseudo: Map::new(),
      regular: false,
      headers: Map::new(),
      cookies: [],
      content_length: None,
      malformed_reason: None,
    },
    |g: CollectedHeaders, f: Field|
      if g.malformed_reason != None { g } else { field_gathered(g, f, allowed, trailing) },
  )

fn wrong(g: CollectedHeaders, reason: String) -> CollectedHeaders =
  { ..g, malformed_reason: Some(reason) }

fn field_gathered(
  g: CollectedHeaders,
  f: Field,
  allowed: List<Bytes>,
  trailing: Bool,
) -> CollectedHeaders / {abort.raise} =
  match field_flaw(f) {
    Some(reason) -> wrong(g, reason),
    None -> if f.name.at(0) == b':' {
      let name = String::of_bytes(f.name);
      if trailing { wrong(g, "the pseudo-header `" ++ name ++ "` is not allowed in trailers") }
      else if g.regular { wrong(g, "the pseudo-header `" ++ name ++ "` comes after a regular field, but pseudo-headers must come first") }
      else if !allowed.contains(f.name) {
        wrong(g, "the pseudo-header `" ++ name ++ "` is not allowed in this kind of message")
      } else if g.pseudo.contains(f.name) { wrong(g, "`" ++ name ++ "` twice") }
      else { { ..g, pseudo: g.pseudo.insert(f.name, f.value) } }
    } else {
      regular_gathered({ ..g, regular: true }, String::of_bytes(f.name), String::of_bytes(f.value))
    },
  }

fn regular_gathered(
  g: CollectedHeaders,
  name: String,
  value: String,
) -> CollectedHeaders / {abort.raise} =
  if connection_specific(name) { wrong(g, "the field `" ++ name ++ "` is connection-specific, which HTTP/2 does not allow") }
  else if name == "te" && value != "trailers" { wrong(g, "`te` other than `trailers`") }
  else if name == "cookie" { { ..g, cookies: g.cookies.push(value) } }
  else if name == "content-length" {
    match Bytes::of_string(value).int_of_ascii() {
      None -> wrong(g, "a `content-length` that is not a number"),
      Some(n) -> if g.content_length != None && g.content_length != Some(n) {
        wrong(g, "two `content-length` fields that differ")
      } else { { ..g, content_length: Some(n), headers: field_added(g.headers, name, value) } },
    }
  } else { { ..g, headers: field_added(g.headers, name, value) } }

fn field_added(h: Headers, name: String, value: String) -> Headers =
  h.insert(name, List::push(match h.get(name) { Some(earlier) -> earlier, None -> [] }, value))

/// The fields with the cookie's pieces joined into one, as an HTTP/1.1 message has it (§8.2.3).
fn with_cookies(g: CollectedHeaders) -> Headers =
  if g.cookies == [] { g.headers }
  else { g.headers.insert("cookie", [String::join(g.cookies, "; ")]) }

fn request_of(fields: List<Field>) -> Head / {abort.raise} = {
  let g = collect_headers(fields, [b":method", b":scheme", b":authority", b":path"], false);
  match g.malformed_reason {
    Some(reason) -> Malformed(reason),
    None -> match g.pseudo.get(b":method") {
      None -> Malformed("no `:method`"),
      Some(m) -> if m == b"CONNECT" { Rejected(501, "CONNECT is not served") }
      else if m.scan(
            0,
            b"!#$%&'*+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz",
            m.len(),
          )
          < m.len() { Malformed("a `:method` that is not a token") } else {
        match ((g.pseudo.get(b":scheme"), g.pseudo.get(b":path"))) {
          (Some(scheme), Some(p)) ->
            request_head(g, String::of_bytes(m), String::of_bytes(scheme), String::of_bytes(p)),
          _ -> Malformed("no `:scheme` or no `:path`"),
        }
      },
    },
  }
}

fn request_head(
  g: CollectedHeaders,
  method: String,
  scheme: String,
  path: String,
) -> Head / {abort.raise} = {
  let hosts = match g.headers.get("host") { Some(named) -> named, None -> [] };
  let authority = match g.pseudo.get(b":authority") {
    Some(a) -> String::of_bytes(a),
    None -> match hosts { [h] -> h, _ -> "" },
  };
  if path == "" { Malformed("an empty `:path`") } else if path == "*" && method != "OPTIONS" {
    Malformed("a `:path` of `*` in a request whose method is not OPTIONS")
  } else if path != "*" && !path.starts_with("/") { Malformed("a `:path` that is not a path") }
  else if path.contains("#") { Malformed("a `:path` with a fragment") }
  else if authority.contains("@") { Malformed("an `:authority` with userinfo") }
  else if hosts != [] && hosts != [authority] { Malformed("a `host` other than the `:authority`") }
  else {
    WellFormed(
      {
        method: method,
        scheme: scheme,
        authority: authority,
        target: path,
        headers: with_cookies(g),
        trailers: Map::new(),
        body: b"",
      },
      g.content_length,
    )
  }
}

type ResponseHead = { status: Int, headers: Headers, expected: Option<Int> }

fn response_of(fields: List<Field>) -> Result<ResponseHead, String> / {abort.raise} = {
  let g = collect_headers(fields, [b":status"], false);
  match g.malformed_reason {
    Some(reason) -> Err(reason),
    None -> match g.pseudo.get(b":status") {
      None -> Err("no `:status`"),
      Some(s) -> match s.int_of_ascii() {
        Some(n) -> if s.len() != 3 || n < 100 { Err("a `:status` that is not three digits") }
        else if n == 101 { Err("a 101, which HTTP/2 does not use") }
        else { Ok({ status: n, headers: with_cookies(g), expected: g.content_length }) },
        None -> Err("a `:status` that is not three digits"),
      },
    },
  }
}

fn trailers_of(fields: List<Field>) -> Result<Headers, String> / {abort.raise} = {
  let g = collect_headers(fields, [], true);
  match g.malformed_reason { Some(reason) -> Err(reason), None -> Ok(with_cookies(g)) }
}

/// The fields a message's header map is sent as. A field the protocol computes or the connection
/// carries itself panics, as in `std.http`'s `encode`. A field that only means something to an
/// HTTP/1.1 connection is left out, and each value has the whitespace at its ends removed.
fn sent_fields(headers: Headers, request: Bool) -> List<Field> / {abort.raise} =
  headers.entries().fold([], |acc: List<Field>, e: { key: String, value: List<String> }| {
    let name = e.key.ascii_lower();
    let raw = Bytes::of_string(name);
    if raw.len() == 0 || raw.scan(0, name_chars(), raw.len()) < raw.len() {
      panic("`" ++ e.key ++ "` is not a valid header name")
    } else if name == "content-length" || name == "transfer-encoding" || name == "connection" {
      panic("`" ++ e.key ++ "` is computed by HTTP/2 and may not be set by the program")
    } else if request && name == "host" {
      panic("`Host` is computed from `Request.authority` and may not be set by the program")
    } else if name == "keep-alive" || name == "proxy-connection" || name == "upgrade" { acc } else {
      e.value.fold(acc, |fs: List<Field>, v: String|
        if v.contains("\r") || v.contains("\n") || v.contains("\0") {
          panic("the value of `" ++ e.key ++ "` contains CR, LF or NUL, which would split the message")
        } else if name == "te" && (!request || v.ascii_trim() != "trailers") { fs }
        else { fs.push({ name: raw, value: Bytes::of_string(v.ascii_trim()) }) })
    }
  })

fn status_field(status: Int) -> Field =
  { name: b":status", value: Bytes::of_string(status.to_string()) }

fn length_field(n: Int) -> Field =
  { name: b"content-length", value: Bytes::of_string(n.to_string()) }

fn request_fields(r: Request) -> List<Field> / {abort.raise} = {
  let method = r.method;
  let authority = if r.authority == "" { [] }
  else { [{ name: b":authority", value: Bytes::of_string(r.authority) }] };
  let pseudo = [
    { name: b":method", value: Bytes::of_string(method) },
    { name: b":scheme", value: Bytes::of_string(r.scheme) },
  ].concat(
    authority.push({
      name: b":path",
      value: Bytes::of_string(if r.target == "" { "/" } else { r.target }),
    }),
  );
  let framed = r.body.len() > 0 || method == "POST" || method == "PUT" || method == "PATCH";
  pseudo.concat(sent_fields(r.headers, true)).concat(if framed { [length_field(r.body.len())] }
  else { [] })
}

// --- The connection: writing --------------------------------------------------------

/// `block` in pieces of at most `size` octets; an empty block is one empty piece.
fn split_block(block: Bytes, size: Int) -> List<Bytes> / {abort.raise} =
  if block.len() <= size { [block] } else {
    range(0, (block.len() + size - 1) / size).map(|i: Int|
      block.slice(i * size, min(block.len(), (i + 1) * size)))
  }

/// A field block on a stream, as one `HEADERS` frame and as many `CONTINUATION` frames as the
/// peer's frame size requires. It is encoded as it is sent, so blocks reach the peer's table in the
/// order they changed this one.
fn emit_headers(
  k: ConnectionState,
  s: Int,
  fields: List<Field>,
  end_stream: Bool,
) -> ConnectionState / {abort.raise} = {
  let e = encode(k.encoder, fields);
  let pieces = split_block(e.block, k.peer_frame);
  let last = pieces.len() - 1;
  range(0, pieces.len()).fold({ ..k, encoder: e.encoder }, |acc: ConnectionState, i: Int|
    emit_frame(acc, if i == 0 {
      HeadersFrame({
        stream: s,
        block: pieces.at_or(0, b""),
        end_stream: end_stream,
        end_headers: last == 0,
        priority: None,
        padding: None,
      })
    } else {
      ContinuationFrame({ stream: s, block: pieces.at_or(i, b""), end_headers: i == last })
    }))
}

/// A stream whose last frame has been sent.
fn sending_finished(k: ConnectionState, st: Stream, t: Int) -> ConnectionState / {abort.raise} = {
  let done = { ..st, sending: false };
  if done.reset_after { reset_stream(store_stream(k, done), st.id, NoError, t) } else {
    match done.phase {
      RemoteClosed -> drop_stream(k, done, false, t),
      _ -> store_stream(k, { ..done, phase: LocalClosed }),
    }
  }
}

/// A server's response on a stream: its head is sent now, and its body as the windows allow.
fn send_response(
  k: ConnectionState,
  st: Stream,
  r: Response,
  t: Int,
) -> ConnectionState / {abort.raise} =
  if r.status < 200 || r.status > 999 {
    panic("a response's status is 200 to 999, not " ++ r.status.to_string())
  } else {
    let empty = r.status == 204 || r.status == 304;
    let body = if empty || st.request.method == "HEAD" { b"" } else { r.body };
    let fields = [status_field(r.status)].concat(sent_fields(r.headers, false)).concat(if empty {
      []
    } else { [length_field(r.body.len())] });
    let headed = emit_headers(k, st.id, fields, body.len() == 0);
    let queued = {
      ..st,
      returned: true,
      out: body,
      sent: 0,
      sending: body.len() > 0,
      reset_after: st.phase == Open,
    };
    if body.len() == 0 { sending_finished(headed, queued, t) }
    else { store_stream({ ..headed, buffered: headed.buffered + body.len() }, queued) }
  }

type PumpRound = { connection: ConnectionState, sent_data: Bool }

/// Sends `DATA` for every stream with data to send, one frame for each in turn, starting after the
/// stream the last round ended at, until no window allows more.
fn send_pending_data(k: ConnectionState, t: Int) -> ConnectionState / {abort.raise} =
  if k.over { k } else {
    let done = iterate(k, k.buffered + k.streams.len() + 2, |p: ConnectionState| {
      let r = one_round(p, t);
      if r.sent_data && !r.connection.over { Continue(r.connection) } else { Stop(r.connection) }
    });
    mark_stalls(done, t)
  }

fn one_round(k: ConnectionState, t: Int) -> PumpRound / {abort.raise} = {
  let ids = k.streams.keys().filter(|s: Int|
    match k.streams.get(s) { Some(st) -> st.sending, None -> false });
  let ordered = ids.filter(|s: Int| s > k.turn).concat(ids.filter(|s: Int| s <= k.turn));
  ordered.fold({ connection: k, sent_data: false }, |p: PumpRound, s: Int|
    match p.connection.streams.get(s) {
      Some(st) -> if st.sending && !p.connection.over { stream_step(p, st, t) } else { p },
      None -> p,
    })
}

fn stream_step(p: PumpRound, st: Stream, t: Int) -> PumpRound / {abort.raise} = {
  let k = p.connection;
  let left = st.out.len() - st.sent;
  if left <= 0 && st.more { p } else if left > 0 {
    let n = min(min(left, st.send_window), min(k.send_window, k.peer_frame));
    if n <= 0 { p } else {
      let last = n == left && st.trailers_out == [] && !st.more;
      let sent = emit_frame(
        { ..k, send_window: k.send_window - n, buffered: k.buffered - n, turn: st.id },
        DataFrame({
          stream: st.id,
          data: st.out.slice(st.sent, st.sent + n),
          end_stream: last,
          padding: None,
        }),
      );
      let moved = { ..st, sent: st.sent + n, send_window: st.send_window - n, stalled: -1 };
      {
        connection: if last { sending_finished(sent, moved, t) } else { store_stream(sent, moved) },
        sent_data: true,
      }
    }
  } else if st.trailers_out != [] {
    let sent = emit_headers({ ..k, turn: st.id }, st.id, st.trailers_out, true);
    { connection: sending_finished(sent, { ..st, trailers_out: [] }, t), sent_data: true }
  } else {
    let sent = emit_frame(
      { ..k, turn: st.id },
      DataFrame({ stream: st.id, data: b"", end_stream: true, padding: None }),
    );
    { connection: sending_finished(sent, st, t), sent_data: true }
  }
}

/// Marks each stream whose output is waiting on a closed window with the time it started waiting.
fn mark_stalls(k: ConnectionState, t: Int) -> ConnectionState =
  {
    ..k,
    streams: k.streams.fold(k.streams, |acc: Map<Int, Stream>, id: Int, st: Stream| {
      let waits = st.sending && st.out.len() > st.sent;
      if waits && st.stalled < 0 { acc.insert(id, { ..st, stalled: t }) }
      else if !waits && st.stalled >= 0 { acc.insert(id, { ..st, stalled: -1 }) }
      else { acc }
    }),
  }

/// Responds to the request on `stream` with `r`. Its head is sent at once and its body as the
/// peer's windows allow. A response to a stream the peer has reset, or that already has a response,
/// is dropped. Panics on a status outside 200 to 999, and, as `std.http`'s `encode` does, on a
/// field the program may not set. A field that only means something to an HTTP/1.1 connection is
/// left out.
pub fn respond(
  c: Connection,
  stream: Int,
  r: Response,
  now: Instant,
) -> Connection / {abort.raise} = {
  let k = state_of(c);
  match k.role {
    Client -> panic("a client handles no request"),
    Server -> match k.streams.get(stream) {
      Some(st) -> if st.returned || k.over { c }
      else { Connection(send_pending_data(send_response(k, st, r, ms(now)), ms(now))) },
      None -> c,
    },
  }
}

/// Responds to the request on `stream` with a head whose body `give` passes a piece at a time, as
/// the application produces it. The head is sent at once, with a `content-length` when `length`
/// gives one, and ends the stream when no body follows it, as for `HEAD`, 204 and 304. It is
/// dropped, and panics, in the same cases as `respond`.
pub fn respond_head(
  c: Connection,
  stream: Int,
  status: Int,
  headers: Headers,
  length: Option<Int>,
  now: Instant,
) -> Connection / {abort.raise} = {
  let k = state_of(c);
  let t = ms(now);
  match k.role {
    Client -> panic("a client handles no request"),
    Server -> match k.streams.get(stream) {
      Some(st) -> if st.returned || k.over { c } else if status < 200 || status > 999 {
        panic("a response's status is 200 to 999, not " ++ status.to_string())
      } else {
        let has_no_body = status == 204 || status == 304 || st.request.method == "HEAD";
        let fields = [status_field(status)].concat(sent_fields(headers, false)).concat(
          match length {
            Some(n) -> if status == 204 || status == 304 { [] } else { [length_field(n)] },
            None -> [],
          },
        );
        let headed = emit_headers(k, st.id, fields, has_no_body);
        let queued = {
          ..st,
          returned: true,
          out: b"",
          sent: 0,
          sending: !has_no_body,
          more: !has_no_body,
          reset_after: st.phase == Open,
        };
        Connection(
          send_pending_data(
            if has_no_body { sending_finished(headed, queued, t) }
            else { store_stream(headed, queued) },
            t,
          ),
        )
      },
      None -> c,
    },
  }
}

/// Sends `piece` of the body of the response `respond_head` started on `stream`, as the last piece
/// when `last` is true. It is sent as the peer's windows allow. It is dropped when the stream
/// accepts no more body: it was reset or closed, or its last piece was already given.
pub fn give(
  c: Connection,
  stream: Int,
  piece: Bytes,
  last: Bool,
  now: Instant,
) -> Connection / {abort.raise} = {
  let k = state_of(c);
  match k.streams.get(stream) {
    Some(st) -> if !st.more || k.over { c } else {
      let held = if st.sent == 0 { st.out } else { st.out.slice(st.sent, st.out.len()) };
      let fed = { ..st, out: held.concat(piece), sent: 0, more: !last };
      Connection(
        send_pending_data(store_stream({ ..k, buffered: k.buffered + piece.len() }, fed), ms(now)),
      )
    },
    None -> c,
  }
}

/// Abandons the body of the response `respond_head` started on `stream`. The stream is reset, so
/// the peer knows the body it has is incomplete.
pub fn cancel(c: Connection, stream: Int, now: Instant) -> Connection / {abort.raise} = {
  let k = state_of(c);
  match k.streams.get(stream) {
    Some(st) -> if !st.more || k.over { c }
    else { Connection(reset_stream(k, stream, InternalError, ms(now))) },
    None -> c,
  }
}

/// The octets of the body of the response `respond_head` started on `stream` that are waiting on
/// the peer's windows. `None` when the stream accepts no more of it, so its producer can stop.
pub fn backlog(c: Connection, stream: Int) -> Option<Int> =
  match state_of(c).streams.get(stream) {
    Some(st) -> if st.more && !state_of(c).over { Some(st.out.len() - st.sent) } else { None },
    None -> None,
  }

/// What `request` returns: the connection with the request queued, and the stream it is sent on.
pub type RequestResult = { connection: Connection, stream: Int }

/// Queues `request` on a new stream. Its head is sent at once, and its body and trailers as the
/// server's windows allow. `None` when no stream can be opened now: the server's
/// `SETTINGS_MAX_CONCURRENT_STREAMS` are open, a `GOAWAY` was sent or received, or the stream
/// numbers have run out. Panics, as `std.http`'s `encode_request` does, on a field the program may
/// not set, including `host`: the `:authority` is `request.authority`.
pub fn request(
  c: Connection,
  request: Request,
  now: Instant,
) -> Option<RequestResult> / {abort.raise} = {
  let k = state_of(c);
  let t = ms(now);
  if k.role == Server { panic("a server sends no request") }
  else if k.over || k.goaway_sent >= 0 || k.goaway_received >= 0
      || k.streams.len() >= k.peer_streams
      || k.next_stream > largest_window() { None } else {
    let s = k.next_stream;
    let trailers = sent_fields(request.trailers, false);
    let ends = request.body.len() == 0 && trailers == [];
    let headed = emit_headers({ ..k, next_stream: s + 2 }, s, request_fields(request), ends);
    let st = {
      ..fresh_stream(headed, s, Open, request, t),
      out: request.body,
      sending: !ends,
      trailers_out: trailers,
    };
    let queued = if ends { store_stream(headed, { ..st, phase: LocalClosed }) }
    else { store_stream({ ..headed, buffered: headed.buffered + request.body.len() }, st) };
    Some({ connection: Connection(send_pending_data(queued, t)), stream: s })
  }
}

// --- The connection: time -----------------------------------------------------------

/// Acts on what depends only on the time `now`. `SETTINGS` unacknowledged too long, or a field
/// block left open too long, close the connection. A request not complete in time gets a 408
/// response, and a response not complete in time fails. A stream whose output waited too long on
/// a closed window is reset. A drain stops waiting for its `PING`. A connection idle too long
/// closes.
pub fn tick(c: Connection, now: Instant) -> ReceiveResult / {abort.raise} = {
  let k = state_of(c);
  let t = ms(now);
  let l = k.limits;
  if k.over { report(k) } else if !k.acked && t - k.settings_at >= l.settings_timeout_ms {
    report(
      close_with_error(
        k,
        SettingsTimeout,
        "SETTINGS not acknowledged within " ++ l.settings_timeout_ms.to_string() ++ " ms",
      ),
    )
  } else if match k.block { Some(b) -> t - b.since >= l.request_timeout_ms, None -> false } {
    report(
      close_with_error(
        k,
        ProtocolError,
        "the headers were not completed within " ++ l.request_timeout_ms.to_string() ++ " ms",
      ),
    )
  } else {
    let timed = k.streams.keys().fold(k, |acc: ConnectionState, s: Int| timed_out(acc, s, t));
    let drained = if timed.draining >= 0 && timed.goaway_sent < 0
        && t - timed.draining >= l.drain_ms { goaway(timed, timed.highest) }
    else { timed };
    let idled = if drained.streams.len() == 0 && drained.goaway_sent < 0 && drained.draining < 0
        && t - drained.quiet_since >= l.idle_timeout_ms { goaway(drained, drained.highest) }
    else { drained };
    report(send_pending_data(idled, t))
  }
}

fn timed_out(k: ConnectionState, s: Int, t: Int) -> ConnectionState / {abort.raise} =
  match k.streams.get(s) {
    None -> k,
    Some(st) -> if st.stalled >= 0 && t - st.stalled >= k.limits.stall_ms {
      match k.role {
        Server -> reset_stream(k, s, Cancel, t),
        Client ->
          failed_with(
            k,
            st,
            Cancel,
            "the server accepted no more request data for " ++ k.limits.stall_ms.to_string() ++ " ms",
            t,
          ),
      }
    } else if t - st.since < k.limits.request_timeout_ms { k } else {
      match k.role {
        Server -> if !st.returned && st.phase == Open {
          reject_request(
            k,
            st,
            408,
            "the request did not arrive whole within " ++ k.limits.request_timeout_ms.to_string()
              ++ " ms",
            t,
          )
        } else { k },
        Client -> if st.phase != RemoteClosed {
          failed_with(
            k,
            st,
            Cancel,
            "no complete response arrived within " ++ k.limits.request_timeout_ms.to_string() ++ " ms",
            t,
          )
        } else { k },
      }
    },
  }

fn stream_deadline(k: ConnectionState, st: Stream) -> Int =
  min(
    if st.stalled >= 0 { st.stalled + k.limits.stall_ms } else { largest_window() * 4096 },
    match k.role {
      Server -> if !st.returned && st.phase == Open { st.since + k.limits.request_timeout_ms }
      else { largest_window() * 4096 },
      Client -> if st.phase != RemoteClosed { st.since + k.limits.request_timeout_ms }
      else { largest_window() * 4096 },
    },
  )

/// When `tick` next has something to do, or `None` when only the peer can make progress.
pub fn deadline(c: Connection) -> Option<Instant> = {
  let k = state_of(c);
  let l = k.limits;
  let never = largest_window() * 4096;
  if k.over { None } else {
    let soonest = k.streams.values().fold(
      min(
        min(if !k.acked { k.settings_at + l.settings_timeout_ms } else { never }, match k.block {
          Some(b) -> b.since + l.request_timeout_ms,
          None -> never,
        }),
        min(
          if k.draining >= 0 && k.goaway_sent < 0 { k.draining + l.drain_ms } else { never },
          if k.streams.len() == 0 && k.goaway_sent < 0 && k.draining < 0 {
            k.quiet_since + l.idle_timeout_ms
          } else { never },
        ),
      ),
      |m: Int, st: Stream| min(m, stream_deadline(k, st)),
    );
    if soonest >= never { None } else { Some(at_millis(soonest)) }
  }
}

/// Starts closing the connection gracefully. A server sends a `GOAWAY` naming the highest possible
/// stream, and a `PING`. When the `PING` returns, or `drain_ms` later, a second `GOAWAY` names the
/// last stream it accepted. A client sends one `GOAWAY` and opens no more streams. Either way the
/// accepted streams are completed, and then `finished` is true.
pub fn drain(c: Connection, now: Instant) -> Connection / {abort.raise} = {
  let k = state_of(c);
  if k.over || k.goaway_sent >= 0 || k.draining >= 0 { c } else {
    match k.role {
      Server -> {
        let first = emit_frame(
          k,
          GoAwayFrame({ last_stream: largest_window(), code: NoError, debug: b"" }),
        );
        let pinged = emit_frame(first, PingFrame({ ack: false, data: drain_ping() }));
        Connection({ ..pinged, draining: ms(now) })
      },
      Client -> Connection(goaway(k, k.highest)),
    }
  }
}

/// The connection after the peer has closed its side of the socket: finished, with every stream
/// still open on it lost.
pub fn peer_closed(c: Connection) -> ReceiveResult = {
  let k = state_of(c);
  if k.over { report(k) } else {
    report(
      event(
        { ..k, over: true, held: [], pending_size: 0 },
        Closed({ code: Cancel, reason: "the peer closed the connection" }),
      ),
    )
  }
}

// --- Tests: frames ----------------------------------------------------------------

fn read_back(b: Bytes) -> Option<Frame> / {abort.raise} =
  match try { read_frame(b, 0, largest_frame_size()) } {
    Ok(Some(r)) -> if r.next == b.len() { Some(r.frame) } else { None },
    _ -> None,
  }

/// The violation reading `b` raises, as its code and stream; `None` when it reads without error.
fn frame_error(b: Bytes) -> Option<(ErrorCode, Int)> / {abort.raise} =
  match try { read_frame(b, 0, default_frame_size()) } {
    Ok(_) -> None,
    Err(v) -> Some((v.code, v.stream)),
  }

/// Frames a peer may be sent, generated so that each type, flag and padding appears.
type Sendable = | Sendable(Frame)

fn sendable() -> Gen<Sendable> =
  gen::map(
    gen::one_of([
      gen::map2(gen::int_between(1, 9), gen::bytes_of(20), |s: Int, b: Bytes|
        DataFrame({
          stream: s,
          data: b,
          end_stream: s % 2 == 0,
          padding: if s > 5 { Some(s) } else { None },
        })),
      gen::map2(gen::int_between(1, 9), gen::bytes_of(20), |s: Int, b: Bytes|
        HeadersFrame({
          stream: s,
          block: b,
          end_stream: s % 2 == 1,
          end_headers: s > 3,
          priority: if s > 6 { Some({ depends_on: s - 1, exclusive: s == 8, weight: s * 20 }) }
          else { None },
          padding: if s % 3 == 0 { Some(s * 7) } else { None },
        })),
      gen::map(gen::int_between(1, 9), |s: Int|
        PriorityFrame({
          stream: s,
          priority: { depends_on: s + 1, exclusive: s > 4, weight: 256 },
        })),
      gen::map2(gen::int_between(1, 9), gen::int_between(0, 20), |s: Int, c: Int|
        ResetFrame({ stream: s, code: code_of(c) })),
      gen::map(gen::int_between(0, 4), |n: Int|
        SettingsFrame({
          ack: n == 0,
          settings: if n == 0 { [] } else {
            [
              [HeaderTableSize(0)],
              [EnablePush(false), MaxConcurrentStreams(100)],
              [InitialWindowSize(largest_window()), MaxFrameSize(largest_frame_size())],
              [MaxHeaderListSize(8192), Unknown(9, 1)],
            ].at_or(n - 1, [])
          },
        })),
      gen::map2(gen::int_between(1, 9), gen::bytes_of(12), |s: Int, b: Bytes|
        PushPromiseFrame({
          stream: s,
          promised: s * 2,
          block: b,
          end_headers: s % 2 == 0,
          padding: if s > 4 { Some(3) } else { None },
        })),
      gen::map2(gen::bool(), gen::bytes_of(8), |ack: Bool, b: Bytes|
        PingFrame({ ack: ack, data: b.concat(b"\x00".repeat(8 - b.len())) })),
      gen::map2(gen::int_between(0, 99), gen::bytes_of(10), |s: Int, b: Bytes|
        GoAwayFrame({ last_stream: s, code: code_of(s % 15), debug: b })),
      gen::map2(gen::int_between(0, 9), gen::int_between(1, largest_window()), |s: Int, n: Int|
        WindowUpdateFrame({ stream: s, increment: n })),
      gen::map2(gen::int_between(1, 9), gen::bytes_of(20), |s: Int, b: Bytes|
        ContinuationFrame({ stream: s, block: b, end_headers: s % 2 == 0 })),
      gen::map2(gen::int_between(10, 255), gen::bytes_of(5), |k: Int, b: Bytes|
        UnknownFrame({ kind: k, flags: k % 7, stream: k % 3, payload: b })),
    ]),
    |f: Frame| Sendable(f),
  )

test "encoding any frame to bytes and reading the bytes back gives the same frame" {
  gen::check(sendable(), |x: Sendable|
    round_trip(
      |s: Sendable| match s { Sendable(f) -> encode_frame(f) },
      |b: Bytes| match read_back(b) { Some(f) -> Some(Sendable(f)), None -> None },
      x,
    ))
}

test "frames are read and written as RFC 9113 lays them out" {
  assert_eq(
    encode_frame(DataFrame({ stream: 1, data: b"hi", end_stream: true, padding: None })).hex_of(),
    "000002000100000001" ++ "6869",
  );
  assert_eq(
    encode_frame(SettingsFrame({ ack: false, settings: [InitialWindowSize(65535)] })).hex_of(),
    "000006040000000000" ++ "00040000ffff",
  );
  assert_eq(
    encode_frame(SettingsFrame({ ack: true, settings: [] })).hex_of(),
    "000000040100000000",
  );
  assert_eq(
    encode_frame(WindowUpdateFrame({ stream: 3, increment: 1000 })).hex_of(),
    "000004080000000003000003e8",
  );
  assert_eq(
    encode_frame(GoAwayFrame({ last_stream: 5, code: EnhanceYourCalm, debug: b"x" })).hex_of(),
    "000009070000000000000000050000000b78",
  );
  assert_eq(
    encode_frame(DataFrame({ stream: 1, data: b"a", end_stream: false, padding: Some(2) })).hex_of(
    ),
    "000004000800000001" ++ "02610000",
  );
  assert_eq(
    read_back(Bytes::of_hex("000000ff0500000007")),
    Some(UnknownFrame({ kind: 255, flags: 5, stream: 7, payload: b"" })),
  );
  // The reserved bit of a stream identifier is ignored on receipt.
  assert_eq(
    read_back(Bytes::of_hex("000000000180000001")),
    Some(DataFrame({ stream: 1, data: b"", end_stream: true, padding: None })),
  )
}

test "a frame is not read until all of it has arrived" {
  let whole = encode_frame(PingFrame({ ack: false, data: b"12345678" }));
  assert_eq(
    range(0, whole.len()).map(|n: Int| read_back(whole.slice(0, n))),
    range(0, whole.len()).map(|_: Int| None),
  );
  assert_eq(read_back(whole), Some(PingFrame({ ack: false, data: b"12345678" })))
}

type RejectedFrame = { hex: String, code: ErrorCode, stream: Int }

/// Frames RFC 9113 §6 says a receiver must reject, the code it rejects each with, and the stream
/// the error is limited to.
fn rejected_frame_cases() -> List<RejectedFrame> =
  [
    // Past SETTINGS_MAX_FRAME_SIZE, rejected from its header alone.
    { hex: "004001000000000001", code: FrameSizeError, stream: 0 },
    { hex: "000000000000000000", code: ProtocolError, stream: 0 },
    // DATA whose padding is as long as its payload.
    { hex: "000002000800000001" ++ "0200", code: ProtocolError, stream: 0 },
    { hex: "000000000800000001", code: FrameSizeError, stream: 0 },
    { hex: "000000010400000000", code: ProtocolError, stream: 0 },
    { hex: "000003012400000001" ++ "000000", code: FrameSizeError, stream: 0 },
    { hex: "000005020000000000" ++ "0000000110", code: ProtocolError, stream: 0 },
    { hex: "000004020000000003" ++ "00000001", code: FrameSizeError, stream: 3 },
    { hex: "000005020000000003" ++ "0000000310", code: ProtocolError, stream: 3 },
    { hex: "000004030000000000" ++ "00000008", code: ProtocolError, stream: 0 },
    { hex: "000003030000000001" ++ "000008", code: FrameSizeError, stream: 0 },
    { hex: "000000040000000001", code: ProtocolError, stream: 0 },
    { hex: "000006040100000000" ++ "000400000001", code: FrameSizeError, stream: 0 },
    { hex: "000005040000000000" ++ "0004000000", code: FrameSizeError, stream: 0 },
    { hex: "000006040000000000" ++ "000200000002", code: ProtocolError, stream: 0 },
    { hex: "000006040000000000" ++ "000480000000", code: FlowControlError, stream: 0 },
    { hex: "000006040000000000" ++ "000500003fff", code: ProtocolError, stream: 0 },
    { hex: "000006040000000000" ++ "000501000000", code: ProtocolError, stream: 0 },
    { hex: "000004050400000000" ++ "00000002", code: ProtocolError, stream: 0 },
    { hex: "000003050400000001" ++ "000002", code: FrameSizeError, stream: 0 },
    { hex: "000008060000000001" ++ "0000000000000000", code: ProtocolError, stream: 0 },
    { hex: "000007060000000000" ++ "00000000000000", code: FrameSizeError, stream: 0 },
    { hex: "000008070000000001" ++ "0000000000000000", code: ProtocolError, stream: 0 },
    { hex: "000007070000000000" ++ "00000000000000", code: FrameSizeError, stream: 0 },
    { hex: "000003080000000000" ++ "000001", code: FrameSizeError, stream: 0 },
    { hex: "000004080000000000" ++ "00000000", code: ProtocolError, stream: 0 },
    { hex: "000004080000000005" ++ "80000000", code: ProtocolError, stream: 5 },
    { hex: "000000090400000000", code: ProtocolError, stream: 0 },
  ]

test "frame {r.hex} is rejected as RFC 9113 requires" for r: RejectedFrame in rejected_frame_cases(
  ) { assert_eq(frame_error(Bytes::of_hex(r.hex)), Some((r.code, r.stream))) }

// --- Tests: HPACK -------------------------------------------------------------------

fn decoded(d: Decoder, block: Bytes) -> DecodeResult / {abort.raise} =
  match try { decode(d, block) } { Ok(got) -> got, Err(v) -> panic(v.reason) }

fn decode_result_text(d: Decoder, block: Bytes) -> String / {abort.raise} =
  match try { decode(d, block) } { Ok(_) -> "decoded", Err(v) -> v.reason }

fn text_field(f: Field) -> String / {abort.raise} =
  String::of_bytes(f.name) ++ ": " ++ String::of_bytes(f.value)

type Example = {
  section: String,
  wire: String,
  fields: List<{ name: String, value: String }>,
  table_size: Int,
}

type Scenario = { name: String, capacity: Int, examples: List<Example> }

/// RFC 7541 Appendix C, each section's blocks in order: the requests decoded with a table of 4096
/// octets and the responses with one of 256, as the RFC has them.
fn stories() -> List<Scenario> =
  [
    {
      name: "C.2.1",
      capacity: 4096,
      examples: [
        {
          section: "C.2.1",
          wire: "400a637573746f6d2d6b65790d637573746f6d2d686561646572",
          fields: [{ name: "custom-key", value: "custom-header" }],
          table_size: 55,
