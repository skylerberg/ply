//! Time zones: the offsets a place's clocks have at each instant, and the instants that a
//! wall-clock reading can mean.
//!
//! The library ships the IANA Time Zone Database as a release publishes it: the text `tzdata.zi`,
//! made of zone lines and rules. `version` returns the release name. `zone("Europe/Paris")` looks
//! the name up in that text, spelled exactly as the database spells it, and builds the zone from
//! the lines and rules that describe it. A link such as `US/Eastern` returns the zone it points to,
//! under that zone's own name. `canonical` finds a zone's name when given it in any letter case.
//! `tz"Europe/Paris"` checks the name when the program is compiled. `utc` and `fixed` make a zone
//! without the database. `zone_in` makes a zone from `tzdata.zi` text that the program passes in,
//! such as a newer release than the one the library ships. Nothing here reads a clock or the host's
//! own zone: the instant and the zone are always arguments. `extended` writes an instant with its
//! zone in the RFC 9557 format, and `zoned` reads that text back and fails if the zone's offset at
//! that instant differs from the offset in the text.
//!
//! A `Zone` contains every change of its clocks, from the first change in the database to the end
//! of `Instant`'s range. Rules that repeat forever are expanded year by year, so a query on a zone
//! is a search and performs no effects. Before the first change, a zone uses the offset the
//! database starts it at, which for a place is its local mean time. `offset_at` returns the offset,
//! the abbreviation and whether daylight saving time is in force, and `local` returns the
//! wall-clock reading. Abbreviations are only written, never parsed, because several zones share
//! `CST`.
//!
//! A wall-clock reading in a zone means one instant, no instant or two instants, and `resolve` says
//! which: `Unique`, a `Gap` where the clocks were moved forward past the reading, or an `Overlap`
//! where they were moved back over it. `earlier`, `later`, `compatible` and `unique` are policies
//! that pick one instant. `add` moves an instant by a calendar period on the zone's own clocks, so
//! adding a day gives the same reading on the next date. An elapsed `Duration` is added to the
//! instant itself, by `after` in `std.time`, and the two results differ when a change of the clocks
//! falls in between.

import std.bytes (is_digit)
import std.date
import std.date (DateTime, ExtendedDateTime, OffsetDateTime, Overflow, Period, SuffixTag)
import std.gen
import std.gen (Gen)
import std.laws (agrees)
import std.list
import std.option
import std.result
import std.string
import std.text (closest)
import std.time

/// The setting of a zone's clocks over a stretch of time.
pub type Offset = new {
  /// Seconds east of UTC, negative for west, under a day either way.
  seconds: Int,
  /// What the zone calls its time over the stretch, as the database abbreviates it: `CET`, `EDT`,
  /// or the offset in digits, `+0530`, where the place has no name for it.
  abbreviation: String,
  /// Whether the database counts the stretch as daylight saving time.
  daylight: Bool,
}

/// A time zone: a name, and every change of its clocks.
pub opaque type Zone = | Zone(Table)

type Table = { name: String, initial: Offset, times: Array<Int>, after: List<Offset>, stride: Int }

show for Zone by name

/// The instants a wall-clock reading names in a zone.
pub type Resolution =
  /// The one instant at which the zone's clocks show the wall-clock reading.
  | Unique(Instant)
  /// No instant: the clocks were moved forward past the reading, so they never show it. `before` is
  /// the instant the reading would have if the clocks had already been moved forward, which is
  /// before the change. `after` is the instant it would have if they had not been moved, which is
  /// at or after the change. The two instants are as far apart as the clocks were moved.
  | Gap({ before: Instant, after: Instant })
  /// Two instants: the clocks were put back through the reading. `earlier` is before the change
  /// and `later` at or after it.
  | Overlap({ earlier: Instant, later: Instant })

/// A change of a zone's clocks: when it happens, and the offsets on either side.
pub type Transition = new { at: Instant, before: Offset, after: Offset }

/// Another name that the database records for a zone it lists under a different name.
pub type Link = { name: String, target: String }

/// How much a zone read from data that a program supplies may contain.
pub type Limits = {
  /// The most changes of the zone's clocks that the data may define. The count includes changes
  /// that are later dropped because they cancel out.
  transitions: Int,
}

/// Why a zone could not be made.
pub type ErrorKind =
  /// No zone or link in the data has the name, and it is not an offset written `+hh:mm`.
  | Unknown
  /// A line of the data is not a valid `tzdata.zi` line: a field is missing, or is not a number, a
  /// month, a weekday or a time of day.
  | Malformed
  /// A zone line names rules the data has none of.
  | NoRules
  /// A zone line's abbreviation format contains `%s`, which a rule's abbreviation text must
  /// replace, but no rule is in force on that line to supply the text.
  | NoAbbreviation
  /// An offset a day or more from UTC.
  | OffsetRange
  /// More changes than the limit.
  | TooMany
  /// A reading's zone, whose clocks stand at another offset at the instant the reading names.
  | Disagrees
  /// A reading has a tag other than its zone that is marked critical. This module does not
  /// interpret such tags, so it rejects the reading.
  | Critical
  /// A reading of an instant outside the range of `Instant`, which is the years 1677 to 2262.
  | InstantRange

/// An error, and the byte of the data where its line starts: zero when the name is unknown.
pub type Error = new { reason: ErrorKind, at: Int }

/// What `zone` and `zone_in` raise when they fail.
pub effect tz {
  /// The name is not a zone's, or the data's lines for it do not make a valid zone.
  raise fail(e: Error)
}

/// A sentence that explains an error to a person.
pub fn error_message(rejected: Error) -> String =
  match rejected.reason {
    Unknown -> "no zone or link in the database has this name",
    Malformed -> "a line of the data is not a valid `tzdata.zi` line",
    NoRules -> "a zone line refers to a set of daylight-saving rules that the data does not define",
    NoAbbreviation -> "a zone line starts with an abbreviation that the data does not define",
    OffsetRange -> "an offset is a day or more away from UTC",
    TooMany -> "the zone has more clock changes than the limit allows",
    Disagrees ->
      "the offset in the text differs from the zone's offset at the instant the text gives",
    Critical ->
      "the text has an extra field, other than the zone, that it requires readers to understand, and this reader does not understand it",
    InstantRange -> "an instant outside the range an `Instant` can represent, 1677 to 2262",
  }

fn shipped() -> Bytes = embed("tz/tzdata.zi")

/// The release of the IANA Time Zone Database that ships, as the release names itself: a year
/// and a letter.
pub fn version() -> String =
  match try[abort.raise] { version_of(shipped()) } { Ok(find_table) -> find_table, Err(_) -> "" }

/// The notice the database is published under, which puts it in the public domain.
pub fn license() -> String = String::of_bytes_lossy(embed("tz/LICENSE"))

/// The name of every zone the database describes, in its order. A link is not among them.
pub fn names() -> List<String> =
  match try[abort.raise] { names_of(shipped()) } { Ok(find_table) -> find_table, Err(_) -> [] }

/// Every link of the database, in its order: a name, and the zone it names.
pub fn links() -> List<Link> =
  match try[abort.raise] { links_of(shipped()) } { Ok(find_table) -> find_table, Err(_) -> [] }

/// Returns the zone for a name: a zone name from the time zone database, a link name from the
/// database, or a fixed offset such as `+05:30` or `-03:30:15` (a sign, then `hh:mm`, with optional
/// `:ss`). Names are matched exactly as written, so `europe/paris` is not a valid name; use
/// `canonical` to find the database's name for a name in any letter case. Raises `tz.fail` when the
/// name is not valid.
pub fn zone(name: String) -> Zone / {tz.fail} =
  match offset_named(name) {
    Some(z) -> z,
    None -> lookup_zone(shipped(), true, name, { transitions: 4096 }),
  }

/// `zone`, with its error as an `Err`.
pub fn parse(name: String) -> Result<Zone, Error> = try { zone(name) }

/// Returns the canonical name of the zone that `name` refers to, matching in any letter case and
/// following links: `us/eastern` returns `America/New_York`, and an offset such as `+05:30` returns
/// the offset's own name. The database's names differ in more than letter case, so at most one
/// matches. Returns `None` when `name` is not an offset and matches no zone name or link name in
/// any letter case.
pub fn canonical(name: String) -> Option<String> =
  match offset_named(name) {
    Some(z) -> Some(table(z).name),
    None -> {
      let wanted = name.ascii_lower();
      match names().find(|n: String| n.ascii_lower() == wanted) {
        Some(find_table) -> Some(find_table),
        None -> links().find(|l: Link| l.name.ascii_lower() == wanted).map(|l: Link| l.target),
      }
    },
  }

/// Checks a `tz"..."` literal: returns the zone `zone` returns, or why the text names no zone,
/// with the nearest name in the database when one is close.
pub fn literal(text: String) -> Result<Zone, { message: String, offset: Int }> =
  match parse(text) {
    Ok(z) -> Ok(z),
    Err(rejected) ->
      Err({
        message: match rejected.reason {
          Unknown -> match closest(text, names().concat(links().map(|l: Link| l.name)), 3) {
            Some(near) -> "no zone has this name: the nearest is `" ++ near ++ "`",
            None -> error_message(rejected),
          },
          _ -> error_message(rejected),
        },
        offset: 0,
      }),
  }

/// The zone of a name in a release of the database that a program supplies. `data` is the bytes
/// of a `tzdata.zi`, the one file in which each release publishes its zones and rules, as `embed`
/// reads them. A program that embeds a newer release than the one that ships uses that release,
/// whatever its toolchain carries. Raises `tz.fail` as `zone` does, and when the zone has more
/// changes than `limits` allows.
pub fn zone_in(data: Bytes, name: String, limits: Limits) -> Zone / {tz.fail} =
  match offset_named(name) { Some(z) -> z, None -> lookup_zone(data, false, name, limits) }

/// The release a `tzdata.zi` names itself as in its first line, or `""` if it names none.
pub fn version_in(data: Bytes) -> String =
  match try[abort.raise] { version_of(data) } { Ok(find_table) -> find_table, Err(_) -> "" }

/// UTC, as the database lists it: `Etc/UTC`, with no change ever.
pub fn utc() -> Zone =
  Zone({
    name: "Etc/UTC",
    initial: { seconds: 0, abbreviation: "UTC", daylight: false },
    times: Array::of_list([]),
    after: [],
    stride: 0,
  })

/// Returns the zone that is always `seconds` east of UTC (negative for west), named in the `+05:30`
/// form that `zone` accepts. Returns `None` when `seconds` is a day or more away from UTC in either
/// direction.
pub fn fixed(seconds: Int) -> Option<Zone> =
  if seconds <= 0 - 86400 || seconds >= 86400 { None } else {
    Some(
      Zone({
        name: offset_name(seconds),
        initial: { seconds: seconds, abbreviation: numeric(seconds), daylight: false },
        times: Array::of_list([]),
        after: [],
        stride: 0,
      }),
    )
  }

/// The zone's name: the database's own name for it, whatever link it was requested by, or
/// `+05:30` for a fixed offset.
pub fn name(z: Zone) -> String = table(z).name

fn table(z: Zone) -> Table = match z { Zone(t) -> t }

fn format_offset(seconds: Int, between: String, whole: Bool) -> String = {
  let east = if seconds < 0 { 0 - seconds } else { seconds };
  let two = |n: Int| n.to_string().pad_left(2, "0");
  (if seconds < 0 { "-" } else { "+" }) ++ two(east / 3600)
    ++ (if whole || east % 3600 != 0 { between ++ two(east / 60 % 60) } else { "" })
    ++ (if east % 60 != 0 { between ++ two(east % 60) } else { "" })
}

fn offset_name(seconds: Int) -> String = format_offset(seconds, ":", true)

fn numeric(seconds: Int) -> String = format_offset(seconds, "", false)

fn digit(c: Char) -> Option<Int> =
  if c >= '0' && c <= '9' { Some(Int::of_char(c) - 48) } else { None }

fn two_digits(tens: Char, ones: Char, most: Int) -> Option<Int> =
  match ((digit(tens), digit(ones))) {
    (Some(a), Some(b)) -> if a * 10 + b <= most { Some(a * 10 + b) } else { None },
    _ -> None,
  }

fn zone_from_sign(sign: Char, seconds: Option<Int>) -> Option<Zone> =
  match seconds {
    Some(east) -> if sign == '+' { fixed(east) }
    else if sign == '-' { fixed(0 - east) }
    else { None },
    None -> None,
  }

fn offset_named(name: String) -> Option<Zone> =
  match name.chars() {
    [sign, h1, h2, ':', m1, m2] ->
      zone_from_sign(sign, match ((two_digits(h1, h2, 23), two_digits(m1, m2, 59))) {
        (Some(h), Some(m)) -> Some(h * 3600 + m * 60),
        _ -> None,
      }),
    [sign, h1, h2, ':', m1, m2, ':', s1, s2] ->
      zone_from_sign(
        sign,
        match ((two_digits(h1, h2, 23), two_digits(m1, m2, 59), two_digits(s1, s2, 59))) {
          (Some(h), Some(m), Some(s)) -> Some(h * 3600 + m * 60 + s),
          _ -> None,
        },
      ),
    _ -> None,
  }

type Line = { at: Int, end: Int, fields: List<Bytes> }

type Clock = | Wall | Standard | Universal

type Day = | DayOfMonth(Int) | OnOrAfter(Int, Int) | OnOrBefore(Int, Int)

type Rule = {
  from: Int,
  to: Int,
  month: Int,
  day: Day,
  at: Int,
  clock: Clock,
  save: Int,
  daylight: Bool,
  letter: String,
}

type Until = { year: Int, at: Int, clock: Clock }

type Regime = | Fixed(Int, Bool) | Ruled(List<Rule>)

type ZoneLine = {
  at: Int,
  standard_offset: Int,
  regime: Regime,
  format: String,
  until: Option<Until>,
}

type RuleSets = Map<String, List<Rule>>

fn fail<a>(reason: ErrorKind, at: Int) -> a / {tz.fail} = tz.fail({ reason: reason, at: at })

fn required<a>(find_table: Option<a>, at: Int) -> a / {tz.fail} =
  match find_table { Some(v) -> v, None -> fail(Malformed, at) }

fn horizon() -> Int = 2262

fn line_at(data: Bytes, at: Int) -> Line / {abort.raise} = {
  let end = match data.index_of_from(b"\n", at) { Some(e) -> e, None -> data.len() };
  { at: at, end: end, fields: data.slice(at, end).split(b" ") }
}

fn lines_from(
  data: Bytes,
  needle: Bytes,
  from: Int,
  left: Int,
  find_table: List<Line>,
) -> List<Line> / {abort.raise} =
  if left <= 0 { find_table } else {
    match data.index_of_from(needle, from) {
      None -> find_table,
      Some(p) -> lines_from(data, needle, p + 1, left - 1, find_table.push(line_at(data, p + 1))),
    }
  }

fn zone_lines(
  data: Bytes,
  at: Int,
  left: Int,
  find_table: List<Line>,
) -> List<Line> / {abort.raise} =
  if left <= 0 || at >= data.len() { find_table } else {
    let line = line_at(data, at);
    let next = line.end + 1;
    if next < data.len() && (is_digit(data.at(next)) || data.at(next) == b'-') {
      zone_lines(data, next, left - 1, find_table.push(line))
    } else { find_table.push(line) }
  }

fn version_of(data: Bytes) -> String / {abort.raise} =
  if !data.starts_with(b"# version ") { "" } else {
    match data.index_of(b"\n") {
      Some(end) -> String::of_bytes_lossy(data.slice(10, end)),
      None -> "",
    }
  }

fn text_at(fields: List<Bytes>, i: Int) -> String = String::of_bytes_lossy(fields.at_or(i, b""))

fn names_of(data: Bytes) -> List<String> / {abort.raise} =
  lines_from(data, b"\nZ ", 0, data.len(), []).map(|l: Line| text_at(l.fields, 1))

fn links_of(data: Bytes) -> List<Link> / {abort.raise} =
  lines_from(data, b"\nL ", 0, data.len(), []).map(|l: Line|
    { name: text_at(l.fields, 2), target: text_at(l.fields, 1) })

fn hms(text: Bytes) -> Option<Int> / {abort.raise} =
  if text.starts_with(b"-") { unsigned_hms(text.slice(1, text.len())).map(|n: Int| 0 - n) }
  else { unsigned_hms(text) }

fn unsigned_hms(text: Bytes) -> Option<Int> / {abort.raise} = {
  let within = |n: Option<Int>, most: Int|
    match n { Some(v) -> if v >= 0 && v <= most { Some(v) } else { None }, None -> None };
  match text.split(b":").map(Bytes::int_of_ascii) {
    [h] -> within(h, 999).map(|hours: Int| hours * 3600),
    [h, m] -> match ((within(h, 999), within(m, 59))) {
      (Some(hours), Some(minutes)) -> Some(hours * 3600 + minutes * 60),
      _ -> None,
    },
    [h, m, s] -> match ((within(h, 999), within(m, 59), within(s, 59))) {
      (Some(hours), Some(minutes), Some(seconds)) -> Some(hours * 3600 + minutes * 60 + seconds),
      _ -> None,
    },
    _ -> None,
  }
}

fn month_names() -> List<Bytes> =
  [
    b"January",
    b"February",
    b"March",
    b"April",
    b"May",
    b"June",
    b"July",
    b"August",
    b"September",
    b"October",
    b"November",
    b"December",
  ]

fn weekday_names() -> List<Bytes> =
  [b"Sunday", b"Monday", b"Tuesday", b"Wednesday", b"Thursday", b"Friday", b"Saturday"]

fn prefix_index(word: Bytes, names: List<Bytes>) -> Option<Int> =
  if word.len() == 0 { None } else {
    match range(0, names.len()).filter(|i: Int| names.at_or(i, b"").starts_with(word)) {
      [only] -> Some(only),
      _ -> None,
    }
  }

fn leap_month_days(month: Int) -> Int =
  if month == 2 { 29 }
  else if month == 4 || month == 6 || month == 9 || month == 11 { 30 }
  else { 31 }

fn in_month(day: Option<Int>) -> Option<Int> =
  match day { Some(d) -> if d >= 1 && d <= 31 { Some(d) } else { None }, None -> None }

fn day_of(text: Bytes, month: Int) -> Option<Day> / {abort.raise} =
  if text.starts_with(b"last") {
    prefix_index(text.slice(4, text.len()), weekday_names()).map(|w: Int|
      OnOrBefore(w, leap_month_days(month)))
  } else {
    match text.index_of(b"=") {
      None -> in_month(text.int_of_ascii()).map(|d: Int| DayOfMonth(d)),
      Some(equals) -> if equals < 2 { None } else {
        let weekday = prefix_index(text.slice(0, equals - 1), weekday_names());
        let day = in_month(text.slice(equals + 1, text.len()).int_of_ascii());
        let sense = text.at(equals - 1);
        match ((weekday, day)) {
          (Some(w), Some(d)) -> if sense == b'>' { Some(OnOrAfter(w, d)) }
          else if sense == b'<' { Some(OnOrBefore(w, d)) }
          else { None },
          _ -> None,
        }
      },
    }
  }

type TimeOfDay = { seconds: Int, clock: Clock }

fn parse_time_of_day(text: Bytes) -> Option<TimeOfDay> / {abort.raise} = {
  let n = text.len();
  if n == 0 { None } else {
    let end = text.at(n - 1);
    let clock = if end == b'w' { Some(Wall) }
    else if end == b's' { Some(Standard) }
    else if end == b'u' || end == b'g' || end == b'z' { Some(Universal) }
    else { None };
    match clock {
      Some(c) -> hms(text.slice(0, n - 1)).map(|s: Int| { seconds: s, clock: c }),
      None -> hms(text).map(|s: Int| { seconds: s, clock: Wall }),
    }
  }
}

type Save = { seconds: Int, daylight: Bool }

fn parse_save(text: Bytes) -> Option<Save> / {abort.raise} = {
  let n = text.len();
  if n == 0 { None } else {
    let end = text.at(n - 1);
    if end == b's' || end == b'd' {
      hms(text.slice(0, n - 1)).map(|s: Int| { seconds: s, daylight: end == b'd' })
    } else { hms(text).map(|s: Int| { seconds: s, daylight: s != 0 }) }
  }
}

fn year_of(text: Bytes) -> Option<Int> / {abort.raise} =
  match text.int_of_ascii() {
    Some(y) -> if y >= 1 && y <= 9999 { Some(y) } else { None },
    None -> None,
  }

fn last_year(text: Bytes, first: Int) -> Option<Int> / {abort.raise} =
  if text.len() > 0 && b"only".starts_with(text) { Some(first) }
  else if text.len() > 1 && b"maximum".starts_with(text) { Some(horizon()) }
  else { year_of(text).map(|y: Int| min(y, horizon())) }

fn rule_of(line: Line) -> Rule / {tz.fail, abort.raise} =
  match line.fields {
    [_, _, from, to, _, month, day, at, save, letter] -> {
      let first = required(year_of(from), line.at);
      let m = required(prefix_index(month, month_names()), line.at) + 1;
      let time = required(parse_time_of_day(at), line.at);
      let adds = required(parse_save(save), line.at);
      {
        from: first,
        to: required(last_year(to, first), line.at),
        month: m,
        day: required(day_of(day, m), line.at),
        at: time.seconds,
        clock: time.clock,
        save: adds.seconds,
        daylight: adds.daylight,
        letter: if letter == b"-" { "" } else { String::of_bytes_lossy(letter) },
      }
    },
    _ -> fail(Malformed, line.at),
  }

fn until_of(fields: List<Bytes>, at: Int) -> Option<Until> / {tz.fail, abort.raise} =
  match fields {
    [] -> None,
    [year, ..rest] -> {
      let y = required(year_of(year), at);
      let month = match rest.at(0) {
        Some(m) -> required(prefix_index(m, month_names()), at) + 1,
        None -> 1,
      };
      let day = match rest.at(1) {
        Some(d) -> required(day_of(d, month), at),
        None -> DayOfMonth(1),
      };
      let time = match rest.at(2) {
        Some(t) -> required(parse_time_of_day(t), at),
        None -> { seconds: 0, clock: Wall },
      };
      Some({ year: y, at: moment(y, month, day, time.seconds), clock: time.clock })
    },
  }

type ZoneLineResult = { era: ZoneLine, sets: RuleSets }

fn zone_line_of(
  data: Bytes,
  at: Int,
  fields: List<Bytes>,
  sets: RuleSets,
) -> ZoneLineResult / {tz.fail, abort.raise} =
  match fields {
    [stdoff, rules, format, ..until] -> {
      let offset = required(hms(stdoff), at);
      let set = String::of_bytes_lossy(rules);
      let zone_table = |regime: Regime, known: RuleSets|
        {
          era: {
            at: at,
            standard_offset: offset,
            regime: regime,
            format: String::of_bytes_lossy(format),
            until: until_of(until, at),
          },
          sets: known,
        };
      if rules == b"-" { zone_table(Fixed(0, false), sets) }
      else if rules.len() == 0 { fail(Malformed, at) }
      else if is_digit(rules.at(0)) || rules.at(0) == b'-' {
        let adds = required(parse_save(rules), at);
        zone_table(Fixed(adds.seconds, adds.daylight), sets)
      } else {
        match sets.get(set) {
          Some(known) -> zone_table(Ruled(known), sets),
          None -> {
            let lines = lines_from(
              data,
              Bytes::concat_all([b"\nR ", rules, b" "]),
              0,
              data.len(),
              [],
            );
            let read = lines.map(rule_of);
            if read == [] { fail(NoRules, at) }
            else { zone_table(Ruled(read), sets.insert(set, read)) }
          },
        }
      }
    },
    _ -> fail(Malformed, at),
  }

fn weekday_of(days: Int) -> Int = week_part(days + 4)

fn week_part(n: Int) -> Int = (n % 7 + 7) % 7

fn moment(year: Int, month: Int, day: Day, at: Int) -> Int = {
  let first = match date::of(year, month, 1) { Some(d) -> date::unix_days(d), None -> 0 };
  let on = match day {
    DayOfMonth(d) -> first + d - 1,
    OnOrAfter(weekday, d) -> first + d - 1 + week_part(weekday - weekday_of(first + d - 1)),
    OnOrBefore(weekday, d) -> {
      let from = first + (if month == 2 && d == 29 && !date::is_leap_year(year) { 28 } else { d })
        - 1;
      from - week_part(weekday_of(from) - weekday)
    },
  };
  on * 86400 + at
}

fn clock_offset(clock: Clock, stdoff: Int, save: Int) -> Int =
  match clock { Wall -> stdoff + save, Standard -> stdoff, Universal -> 0 }

fn designation(
  format: String,
  total: Int,
  letters: Option<String>,
  daylight: Bool,
) -> Option<String> / {abort.raise} =
  match format.split_once("/") {
    Some(halves) -> Some(if daylight { halves.tail } else { halves.head }),
    None -> match format.split_once("%z") {
      Some(around) -> Some(around.head ++ numeric(total) ++ around.tail),
      None -> match format.split_once("%s") {
        Some(around) -> letters.map(|l: String| around.head ++ l ++ around.tail),
        None -> Some(format),
      },
    },
  }

type Change = { at: Int, kind: Offset }

type RuleOccurrence = { local_seconds: Int, rule: Rule, kind: Offset }

type YearState = {
  save: Int,
  pending: Bool,
  start_offset: Int,
  start_name: Option<String>,
  out: List<Change>,
}

type ZoneState = {
  changes: List<Change>,
  start: Option<Int>,
  initial: Option<Offset>,
  sets: RuleSets,
  lines: Int,
}

type Pick = { index: Int, at: Int }

fn earliest(stdoff: Int, save: Int, dues: List<RuleOccurrence>) -> Option<Pick> =
  range(0, dues.len()).fold(None, |best: Option<Pick>, i: Int|
    match dues.at(i) {
      None -> best,
      Some(due) -> {
        let at = due.local_seconds - clock_offset(due.rule.clock, stdoff, save);
        match best {
          Some(b) -> if at < b.at { Some({ index: i, at: at }) } else { best },
          None -> Some({ index: i, at: at }),
        }
      },
    })

fn apply_year_rules(
  era: ZoneLine,
  start: Option<Int>,
  w: YearState,
  dues: List<RuleOccurrence>,
  left: Int,
) -> YearState =
  if left <= 0 { w } else {
    match earliest(era.standard_offset, w.save, dues) {
      None -> w,
      Some(pick) -> match dues.at(pick.index) {
        None -> w,
        Some(due) -> {
          let rule = due.rule;
          let total = due.kind.seconds;
          let ended = match era.until {
            Some(u) -> pick.at >= u.at - clock_offset(u.clock, era.standard_offset, w.save),
            None -> false,
          };
          if ended {
            if w.start_name == None && total == w.start_offset {
              { ..w, start_name: Some(due.kind.abbreviation) }
            } else { w }
          } else {
            let pending = w.pending && start != Some(pick.at);
            let before = match start { Some(s) -> pending && pick.at < s, None -> false };
            let rest = dues.take(pick.index).concat(dues.drop(pick.index + 1));
            if before {
              apply_year_rules(
                era,
                start,
                {
                  ..w,
                  save: rule.save,
                  pending: pending,
                  start_offset: total,
                  start_name: Some(due.kind.abbreviation),
                },
                rest,
                left - 1,
              )
            } else {
              apply_year_rules(
                era,
                start,
                {
                  save: rule.save,
                  pending: pending,
                  start_offset: w.start_offset,
                  start_name: if pending && w.start_name == None && w.start_offset == total {
                    Some(due.kind.abbreviation)
                  } else { w.start_name },
                  out: w.out.push({ at: pick.at, kind: due.kind }),
                },
                rest,
                left - 1,
              )
            }
          }
        },
      },
    }
  }

fn occurrence_count(rules: List<Rule>, top: Int) -> Int =
  rules.fold(0, |n: Int, r: Rule| n + max(min(r.to, top) - r.from + 1, 0))

fn by_year(
  era: ZoneLine,
  rules: List<Rule>,
  top: Int,
) -> Map<Int, List<RuleOccurrence>> / {abort.raise} =
  rules.fold(Map::new(), |years: Map<Int, List<RuleOccurrence>>, r: Rule| {
    let kind: Offset = {
      seconds: era.standard_offset + r.save,
      abbreviation: match designation(
          era.format,
          era.standard_offset + r.save,
          Some(r.letter),
          r.daylight,
        ) {
        Some(written) -> written,
        None -> "",
      },
      daylight: r.daylight,
    };
    range(r.from, min(r.to, top) + 1).fold(years, |m: Map<Int, List<RuleOccurrence>>, year: Int|
      m.insert(
        year,
        List::push(match m.get(year) { Some(dues) -> dues, None -> [] }, {
          local_seconds: moment(year, r.month, r.day, r.at),
          rule: r,
          kind: kind,
        }),
      ))
  })

fn add_checked_zone_line(
  m: ZoneState,
  era: ZoneLine,
  limits: Limits,
) -> ZoneState / {tz.fail, abort.raise} =
  if m.lines > 0 && m.start == None { fail(Malformed, era.at) }
  else { add_zone_line(m, era, limits) }

fn add_zone_line(
  m: ZoneState,
  era: ZoneLine,
  limits: Limits,
) -> ZoneState / {tz.fail, abort.raise} =
  match era.regime {
    Fixed(save, daylight) -> {
      let total = era.standard_offset + save;
      let kind: Offset = {
        seconds: total,
        abbreviation: match designation(era.format, total, Some(""), daylight) {
          Some(written) -> written,
          None -> "",
        },
        daylight: daylight,
      };
      {
        changes: match m.start {
          Some(at) -> m.changes.push({ at: at, kind: kind }),
          None -> m.changes,
        },
        start: next_start(era, save),
        initial: if m.start == None { Some(kind) } else { m.initial },
        sets: m.sets,
        lines: m.lines + 1,
      }
    },
    Ruled(rules) -> {
      let top = match era.until { Some(u) -> u.year, None -> horizon() };
      if occurrence_count(rules, top) > limits.transitions { fail(TooMany, era.at) } else {
        let fresh: YearState = {
          save: 0,
          pending: m.start != None,
          start_offset: era.standard_offset,
          start_name: None,
          out: [],
        };
        let w = by_year(era, rules, top).fold(
          fresh,
          |walk: YearState, _year: Int, dues: List<RuleOccurrence>|
            apply_year_rules(era, m.start, walk, dues, dues.len()),
        );
        let opening: List<Change> = match m.start {
          Some(at) -> if !w.pending { [] } else {
            let daylight = w.start_offset != era.standard_offset;
            let written = match w.start_name {
              Some(resolved) -> Some(resolved),
              None -> designation(era.format, era.standard_offset + w.save, None, daylight),
            };
            match written {
              Some(abbreviation) ->
                [
                  {
                    at: at,
                    kind: {
                      seconds: w.start_offset,
                      abbreviation: abbreviation,
                      daylight: daylight,
                    },
                  },
                ],
              None -> fail(NoAbbreviation, era.at),
            }
          },
          None -> [],
        };
        let out = opening.concat(w.out);
        {
          changes: m.changes.concat(out),
          start: next_start(era, w.save),
          initial: match m.initial {
            Some(resolved) -> Some(resolved),
            None -> out.find(|s: Change| !s.kind.daylight).map(|s: Change| s.kind),
          },
          sets: m.sets,
          lines: m.lines + 1,
        }
      }
    },
  }

fn next_start(era: ZoneLine, save: Int) -> Option<Int> =
  match era.until {
    Some(u) -> Some(u.at - clock_offset(u.clock, era.standard_offset, save)),
    None -> None,
  }

fn ordered(stamps: List<Change>) -> List<Change> = {
  let sorted = stamps.fold(
    { last: None, ok: true },
    |so: { last: Option<Int>, ok: Bool }, s: Change|
      {
        last: Some(s.at),
        ok: so.ok && (match so.last { Some(before) -> before <= s.at, None -> true }),
      },
  );
  if sorted.ok { stamps } else { stamps.sort_by(|a: Change, b: Change| a.at <= b.at) }
}

fn merge_change(
  so_far: List<Change>,
  next: Change,
  initial: Offset,
) -> List<Change> / {abort.raise} =
  match so_far.last() {
    None -> so_far.push(next),
    Some(previous) -> {
      let n = so_far.len();
      let earlier = match so_far.at(n - 2) { Some(s) -> s.kind.seconds, None -> initial.seconds };
      if next.at + previous.kind.seconds <= previous.at + earlier {
        so_far.set(n - 1, { at: previous.at, kind: next.kind })
      } else if previous.kind == next.kind { so_far }
      else { so_far.push(next) }
    },
  }

fn effective_changes(stamps: List<Change>, initial: Offset, at: Int) -> List<Change> / {tz.fail} = {
  let ranged = |k: Offset| k.seconds > 0 - 86400 && k.seconds < 86400;
  if !ranged(initial) { fail(OffsetRange, at) } else {
    stamps.fold(
      { out: [], now: initial },
      |so: { out: List<Change>, now: Offset }, s: Change|
        if !ranged(s.kind) { fail(OffsetRange, at) }
        else if s.kind == so.now { so }
        else { { out: so.out.push(s), now: s.kind } },
    ).out
  }
}

fn stride_of(count: Int) -> Int =
  [
    1,
    2,
    4,
    8,
    16,
    32,
    64,
    128,
    256,
    512,
    1024,
    2048,
    4096,
    8192,
    16384,
    32768,
    65536,
    131072,
    262144,
    524288,
    1048576,
  ].fold(0, |best: Int, power: Int| if power <= count { power } else { best })

fn zone_table(
  data: Bytes,
  name: String,
  at: Int,
  limits: Limits,
) -> Table / {tz.fail, abort.raise} = {
  let lines = zone_lines(data, at, data.len(), []);
  let empty: ZoneState = { changes: [], start: None, initial: None, sets: Map::new(), lines: 0 };
  let m = lines.fold(empty, |so: ZoneState, line: Line| {
    let read = zone_line_of(
      data,
      line.at,
      if line.at == at { line.fields.drop(2) } else { line.fields },
      so.sets,
    );
    add_checked_zone_line({ ..so, sets: read.sets }, read.era, limits)
  });
  let stamps = if m.start == None { ordered(m.changes) } else { fail(Malformed, at) };
  let initial = match m.initial {
    Some(resolved) -> resolved,
    None -> match stamps { [first, ..] -> first.kind, [] -> fail(Malformed, at) },
  };
  let changes = effective_changes(
    stamps.fold([], |so_far: List<Change>, next: Change| merge_change(so_far, next, initial)),
    initial,
    at,
  );
  if changes.len() > min(limits.transitions, 1048576) { fail(TooMany, at) } else {
    {
      name: name,
      initial: initial,
      times: Array::of_list(changes.map(|s: Change| s.at)),
      after: changes.map(|s: Change| s.kind),
      stride: stride_of(changes.len()),
    }
  }
}

fn zone_key(name: String) -> Bytes = Bytes::concat_all([b"\nZ ", Bytes::of_string(name), b" "])

fn is_name(name: String) -> Bool =
  name != "" && Bytes::of_string(name).position(0, |c: Int| c <= 32 || c >= 127) == None

fn find_table(
  data: Bytes,
  is_shipped: Bool,
  name: String,
  limits: Limits,
) -> Table / {tz.fail, abort.raise} =
  if !is_name(name) { fail(Unknown, 0) } else {
    match data.index_of(zone_key(name)) {
      Some(p) -> zone_table(data, name, p + 1, limits),
      None -> match List::find(if is_shipped { links() } else { links_of(data) }, |l: Link|
          l.name == name) {
        None -> fail(Unknown, 0),
        Some(link) -> match data.index_of(zone_key(link.target)) {
          Some(p) -> zone_table(data, link.target, p + 1, limits),
          None -> fail(Unknown, 0),
        },
      },
    }
  }

fn lookup_zone(data: Bytes, is_shipped: Bool, name: String, limits: Limits) -> Zone / {tz.fail} =
  match try[abort.raise] { find_table(data, is_shipped, name, limits) } {
    Ok(t) -> Zone(t),
    Err(_) -> fail(Malformed, 0),
  }

fn count_through(times: Array<Int>, t: Int, base: Int, step: Int) -> Int =
  if step <= 0 { base } else {
    count_through(
      times,
      t,
      match times.at(base + step - 1) {
        Some(at) -> if at <= t { base + step } else { base },
        None -> base,
      },
      step / 2,
    )
  }

fn count_at(z: Table, t: Int) -> Int = count_through(z.times, t, 0, z.stride)

fn offset_before(z: Table, index: Int) -> Offset =
  if index <= 0 { z.initial }
  else { match z.after.at(index - 1) { Some(kind) -> kind, None -> z.initial } }

fn seconds_of(at: Instant) -> Int =
  match at { Instant(n) -> if n >= 0 { n / 1000000000 } else { (n + 1) / 1000000000 - 1 } }

fn instant_at(seconds: Int, part: Int) -> Option<Instant> = {
  let whole = if seconds >= 0 { seconds } else { seconds + 1 };
  let rest = if seconds >= 0 { part } else { part - 1000000000 };
  match checked_mul(whole, 1000000000) {
    Some(n) -> match checked_add(n, rest) { Some(nanos) -> Some(Instant(nanos)), None -> None },
    None -> None,
  }
}

/// The setting of the zone's clocks at an instant: the offset, the abbreviation, and whether
/// daylight time is in force.
pub fn offset_at(z: Zone, at: Instant) -> Offset =
  offset_before(table(z), count_at(table(z), seconds_of(at)))

/// What the zone's clocks read at an instant, to the nanosecond.
pub fn local(z: Zone, at: Instant) -> DateTime = {
  let universal = date::local(date::of_instant(at));
  match date::date_time_after(universal, time::nanos(offset_at(z, at).seconds * 1000000000)) {
    Some(reading) -> reading,
    None -> universal,
  }
}

/// Returns `at` as an `OffsetDateTime` that uses the zone's offset at that instant. An
/// `OffsetDateTime` stores its offset in whole minutes, which is all RFC 3339 can write, so an
/// offset with seconds, such as local mean time, is rounded to the nearest minute. The clock
/// reading in the result then differs from `local` by those seconds.
pub fn of_instant(z: Zone, at: Instant) -> OffsetDateTime = {
  let seconds = offset_at(z, at).seconds;
  let minutes = if seconds >= 0 { (seconds + 30) / 60 } else { 0 - (30 - seconds) / 60 };
  match date::in_offset(date::of_instant(at), max(min(minutes, 1439), 0 - 1439)) {
    Some(reading) -> reading,
    None -> date::of_instant(at),
  }
}

/// The instant with the zone named after it, which `std.date`'s `rfc9557` writes as
/// `2026-10-25T01:30:00+01:00[Europe/Paris]`.
pub fn extended(z: Zone, at: Instant) -> ExtendedDateTime =
  { instant: of_instant(z, at), zone: Some({ name: name(z), critical: false }), tags: [] }

/// An instant, and the zone whose clocks read it.
pub type Zoned = { zone: Zone, at: Instant }

/// Returns the zone and instant named by the RFC 9557 date-time `e`, as `std.date`'s
/// `parse_rfc9557` parses one and `extended` writes one. The instant comes from the offset in `e`.
/// The zone comes from the zone name in the bracketed suffix, or is the fixed zone of the offset
/// when there is no name. An offset of `Z` is accepted with any zone name, and the zone's offset is
/// not compared with it; `std.date` also reads `+00:00` and `-00:00` as `Z`. Fails with `tz.fail`:
/// `Unknown` when the suffix names no zone, `Disagrees` when the offset in `e` is not the zone's
/// offset at that instant, `Critical` when a tag other than the zone is marked critical,
/// `InstantRange` when the instant is outside `Instant`'s range, and `OffsetRange` when there is no
/// zone name and the offset is not a valid fixed offset.
pub fn zoned(e: ExtendedDateTime) -> Zoned / {tz.fail} = {
  if e.tags.any(|tag: SuffixTag| tag.critical) { fail(Critical, 0) };
  let at = match date::instant(e.instant) { Some(i) -> i, None -> fail(InstantRange, 0) };
  let minutes = date::offset_minutes(e.instant);
  match e.zone {
    None -> match fixed(minutes * 60) {
      Some(z) -> { zone: z, at: at },
      None -> fail(OffsetRange, 0),
    },
    Some(tag) -> {
      let z = zone(tag.name);
      if minutes != 0 && date::offset_minutes(of_instant(z, at)) != minutes { fail(Disagrees, 0) }
      else { { zone: z, at: at } }
    },
  }
}

type ScanState = { seconds: List<Int>, gap: Option<{ before: Int, after: Int }> }

fn scan(z: Table, wall: Int, index: Int, kind: Offset, find_table: ScanState) -> ScanState = {
  let t = wall - kind.seconds;
  let begun = if index <= 0 { true }
  else { match z.times.at(index - 1) { Some(from) -> from <= t, None -> true } };
  match z.times.at(index) {
    None -> if begun { { ..find_table, seconds: find_table.seconds.push(t) } } else { find_table },
    Some(next) -> {
      let here = if begun && t < next { { ..find_table, seconds: find_table.seconds.push(t) } }
      else { find_table };
      if next > wall + 86400 { here } else {
        let after = offset_before(z, index + 1);
        scan(
          z,
          wall,
          index + 1,
          after,
          if here.gap == None && next + kind.seconds <= wall && wall < next + after.seconds {
            { ..here, gap: Some({ before: wall - after.seconds, after: t }) }
          } else { here },
        )
      }
    },
  }
}

/// The instants a wall-clock reading names in the zone: one, none or two. `None` when an instant
/// it names is outside `Instant`'s range, 1677-09-21 to 2262-04-11.
pub fn resolve(z: Zone, reading: DateTime) -> Option<Resolution> = {
  let wall = date::unix_seconds(date::utc(reading));
  let part = date::nanosecond(date::time_of(reading));
  let from = count_at(table(z), wall - 86400);
  let find_table = scan(table(z), wall, from, offset_before(table(z), from), {
    seconds: [],
    gap: None,
  });
  match find_table.seconds {
    [] -> match find_table.gap {
      Some(skipped) -> match ((instant_at(skipped.before, part), instant_at(skipped.after, part))) {
        (Some(before), Some(after)) -> Some(Gap({ before: before, after: after })),
        _ -> None,
      },
      None -> None,
    },
    [only] -> instant_at(only, part).map(|at: Instant| Unique(at)),
    [first, ..rest] -> match ((
        instant_at(first, part),
        rest.last().map(|s: Int| instant_at(s, part)),
      )) {
      (Some(earlier), Some(Some(later))) -> Some(Overlap({ earlier: earlier, later: later })),
      _ -> None,
    },
  }
}

/// The earlier instant: of an overlap the one before the clocks were put back, and of a gap the
/// one before they were put forward.
pub fn earlier(find_table: Resolution) -> Instant =
  match find_table {
    Unique(at) -> at,
    Gap(skipped) -> skipped.before,
    Overlap(both) -> both.earlier,
  }

/// The later instant: of an overlap the one after the clocks were put back, and of a gap the one
/// after they were put forward.
pub fn later(find_table: Resolution) -> Instant =
  match find_table { Unique(at) -> at, Gap(skipped) -> skipped.after, Overlap(both) -> both.later }

/// The instant most calendars choose: the earlier of an overlap, and for a gap the reading moved
/// forward by as much as the clocks were, which is its later instant. It is what RFC 5545 requires
/// of a calendar, and the default in `java.time` and Temporal.
pub fn compatible(find_table: Resolution) -> Instant =
  match find_table {
    Unique(at) -> at,
    Gap(skipped) -> skipped.after,
    Overlap(both) -> both.earlier,
  }

/// The instant, when the reading names exactly one. `None` for a gap and for an overlap.
pub fn unique(find_table: Resolution) -> Option<Instant> =
  match find_table { Unique(at) -> Some(at), Gap(_) -> None, Overlap(_) -> None }

/// Moves the zone's clock reading at an instant by a calendar period, as `std.date`'s
/// `date_time_add` moves a reading, and resolves the result. A day later is the same time on the
/// next date, however many hours that is, so the result may be a reading the clocks skip or show
/// twice. `None` when the date is past either end of the calendar or of `Instant`'s range.
pub fn add(z: Zone, at: Instant, span: Period, overflow: Overflow) -> Option<Resolution> =
  match date::date_time_add(local(z, at), span, overflow) {
    Some(moved) -> resolve(z, moved),
    None -> None,
  }

fn transition_at(z: Table, index: Int) -> Option<Transition> =
  match z.times.at(index) {
    None -> None,
    Some(t) -> match instant_at(t, 0) {
      Some(at) ->
        Some({ at: at, before: offset_before(z, index), after: offset_before(z, index + 1) }),
      None -> None,
    },
  }

/// The first change of the zone's clocks after an instant, or `None` if there is none within
/// `Instant`'s range.
pub fn next_transition(z: Zone, after: Instant) -> Option<Transition> =
  transition_at(table(z), count_at(table(z), seconds_of(after)))

/// The last change of the zone's clocks at or before an instant: the one that set the offset in
/// force there. `None` before the first.
pub fn previous_transition(z: Zone, at: Instant) -> Option<Transition> =
  transition_at(table(z), count_at(table(z), seconds_of(at)) - 1)

/// A zone of the database three times in five, else a fixed offset or UTC.
pub fn arbitrary() -> Gen<Zone> = {
  let listed = gen::map(gen::elements(names()), |named: String|
    match parse(named) { Ok(z) -> z, Err(_) -> utc() });
  gen::one_of([
    listed,
    listed,
    listed,
    gen::map(gen::int_between(0 - 86399, 86399), |seconds: Int|
      match fixed(seconds) { Some(z) -> z, None -> utc() }),
    gen::constant(utc()),
  ])
}

type ZoneInstant = | ZoneInstant(Zone, Instant)

fn any_instant() -> Gen<Instant> =
  gen::one_of([
    gen::map(gen::int_between(0 - 9223372036, 9223372036), |s: Int| Instant(s * 1000000000)),
    gen::map(gen::int(), |n: Int| Instant(n)),
  ])

fn instants_near_changes(z: Table) -> Gen<Instant> = {
  let beside = |span: Int|
    gen::map2(gen::below(z.times.len()), gen::int_between(0 - span, span), |i: Int, by: Int|
      match z.times.at(i) {
        Some(t) -> match instant_at(t + by, 0) { Some(at) -> at, None -> Instant(0) },
        None -> Instant(0),
      });
  if z.times.len() == 0 { any_instant() }
  else { gen::one_of([any_instant(), beside(1), beside(172800)]) }
}

fn zone_instants() -> Gen<ZoneInstant> =
  gen::and_then(arbitrary(), |z: Zone|
    gen::map(instants_near_changes(table(z)), |at: Instant| ZoneInstant(z, at)))

fn offset_by_scan(s: ZoneInstant) -> Offset =
  match s {
    ZoneInstant(z, at) ->
      offset_before(
        table(z),
        table(z).times.to_list().fold(0, |passed: Int, t: Int|
          if t <= seconds_of(at) { passed + 1 } else { passed }),
      ),
  }

fn offset_by_search(s: ZoneInstant) -> Offset = match s { ZoneInstant(z, at) -> offset_at(z, at) }

test "`resolve` of the local date and time of an instant returns that same instant, or one of two instants in an overlap" {
  gen::check(zone_instants(), |s: ZoneInstant| {
    match s {
      ZoneInstant(z, at) -> match resolve(z, local(z, at)) {
        Some(Unique(find_table)) -> find_table == at,
        Some(Overlap(both)) ->
          (both.earlier == at || both.later == at) && compare(both.earlier, both.later) == Less,
        Some(Gap(_)) -> false,
        None -> false,
      },
    }
  })
}

test "binary search for an offset gives the same result as scanning every clock transition" {
  gen::check(zone_instants(), |x: ZoneInstant| agrees(offset_by_search, offset_by_scan, x))
}

fn zone_named(named: String) -> Zone / {abort.raise} =
  match parse(named) {
    Ok(z) -> z,
    Err(rejected) -> panic(named ++ ": " ++ error_message(rejected)),
  }

fn instant_of_text(text: String) -> Instant / {abort.raise} =
  date::parse_rfc3339(text).and_then(date::instant).expect(text)

fn date_time_of_text(text: String) -> DateTime / {abort.raise} =
  match date::date_time_literal(text) {
    Ok(read) -> read,
    Err(reason) -> panic(text ++ ": " ++ reason.message),
  }

test "the database is release 2026e, of 345 zones and 253 links" {
  assert_eq(version(), "2026e");
  assert_eq(names().len(), 345);
  assert_eq(links().len(), 253);
  assert_eq(version_in(shipped()), "2026e");
  assert(license().contains("public domain"))
}

test "a link names a zone the database lists, and is not itself a zone" {
  let listed = names().fold(Map::new(), |known: Map<String, Unit>, named: String|
    known.insert(named, ()));
  assert_eq(listed.len(), 345);
  assert_eq(links().filter(|l: Link| !listed.contains(l.target)), []);
  assert_eq(links().filter(|l: Link| listed.contains(l.name)), [])
}

test "a zone is found by its name or a link's, and is named as the database names it" {
  let new_york = zone_named("America/New_York");
  assert_eq(name(new_york), "America/New_York");
  assert_eq(f"{new_york}", "America/New_York");
  assert_eq(zone_named("US/Eastern"), new_york);
  assert_eq(name(zone_named("Asia/Calcutta")), "Asia/Kolkata");
  assert_eq(name(zone_named("UTC")), "Etc/UTC");
  assert_eq(name(zone_named("Etc/GMT+10")), "Etc/GMT+10");
  assert_eq(offset_at(zone_named("Etc/GMT+10"), Instant(0)), {
    seconds: 0 - 36000,
    abbreviation: "-10",
    daylight: false,
  })
}

fn unknown() -> List<String> =
  [
    "",
    "Europe/Pariss",
    "europe/paris",
    "EUROPE/PARIS",
    "Europe/Paris ",
    " Europe/Paris",
    "Europe",
    "Europe/",
    "Paris",
    "Europe/Paris\nZ",
    "Z",
    "L",
    "CEST",
    "+5:30",
    "+05",
    "+0530",
    "+24:00",
    "+05:60",
    "05:30",
  ]

test "`parse` and `zone` both reject the text `{c}` as an unknown zone name" for c: String in unknown(
  ) {
  assert_eq(parse(c), Err({ reason: Unknown, at: 0 }));
  assert_eq(try { zone(c) }, Err({ reason: Unknown, at: 0 }))
}

test "`literal` returns the zone for a valid name, or an error naming the closest valid zone name" {
  assert_eq(literal("Europe/Paris"), Ok(zone_named("Europe/Paris")));
  assert_eq(
    literal("europe/paris"),
    Err({ message: "no zone has this name: the nearest is `Europe/Paris`", offset: 0 }),
  );
  assert_eq(
    literal("Amerika/New_York"),
    Err({ message: "no zone has this name: the nearest is `America/New_York`", offset: 0 }),
  );
  assert_eq(
    literal("US/Estern"),
    Err({ message: "no zone has this name: the nearest is `US/Eastern`", offset: 0 }),
  );
  assert_eq(
    literal("Middle/Earth"),
    Err({ message: "no zone or link in the database has this name", offset: 0 }),
  )
}

test "`utc` and `fixed` build zones without the time zone database, and the zones have the same names and offsets as when read from it" {
  assert_eq(utc(), zone_named("Etc/UTC"));
  assert_eq(name(utc()), "Etc/UTC");
  assert_eq(offset_at(utc(), Instant(0)), { seconds: 0, abbreviation: "UTC", daylight: false });
  let india = fixed(19800).expect("five and a half hours");
  assert_eq(name(india), "+05:30");
  assert_eq(zone_named("+05:30"), india);
  assert_eq(offset_at(india, Instant(0)), {
    seconds: 19800,
    abbreviation: "+0530",
    daylight: false,
  });
  assert_eq(fixed(0 - 12615).map(name), Some("-03:30:15"));
  assert_eq(parse("-03:30:15"), Ok(fixed(0 - 12615).expect("newfoundland")));
  assert_eq(fixed(0).map(name), Some("+00:00"));
  assert_eq(parse("-00:00"), Ok(fixed(0).expect("no offset")));
  assert_eq(fixed(86399).map(name), Some("+23:59:59"));
  assert_eq(fixed(86400), None);
  assert_eq(fixed(0 - 86400), None);
  assert_eq(next_transition(india, Instant(0)), None);
  assert_eq(previous_transition(india, Instant(0)), None)
}

type Observation = {
  zone: String,
  at: String,
  reads: String,
  seconds: Int,
  abbreviation: String,
  daylight: Bool,
}

fn observation(
  zone: String,
  at: String,
  reads: String,
  seconds: Int,
  abbreviation: String,
  daylight: Bool,
) -> Observation =
  {
    zone: zone,
    at: at,
    reads: reads,
    seconds: seconds,
    abbreviation: abbreviation,
    daylight: daylight,
  }

fn assert_observation(z: Zone, c: Observation) -> Unit / {abort.raise} = {
  let at = instant_of_text(c.at);
  assert_eq(offset_at(z, at), {
    seconds: c.seconds,
    abbreviation: c.abbreviation,
    daylight: c.daylight,
  });
  assert_eq(local(z, at), date_time_of_text(c.reads))
}

