//! Functions over a `List<a>` that the prelude does not provide.
//!
//! The prelude has the building blocks (`List::map`, `List::filter`, `List::fold`, `iterate`,
//! `range`, `List::push` and `List::at`), and this module builds on them. A `List` is a vector, not
//! a linked list, so the cheap end is the back: `List::push` appends, and `prepend` puts an element
//! first by copying the list. Functions here that build a list do so in one left-to-right pass,
//! appending each element to the result. Building a list from the front copies the accumulator at
//! every step and is quadratic, a shape to avoid in Ply generally.
//!
//! A callback may perform effects, as the prelude's `List::map` and `List::fold` allow. The
//! callback is called on the elements in list order, except the callback of `List::fold_right`,
//! which is called from the last element back. `List::any`, `List::all`, `List::find`,
//! `List::find_map`, `List::find_index`, `List::take_while`, `List::drop_while` and `List::span`
//! stop calling their callback once the result is known.
//!
//! Every function but `List::get` is total: a count below zero or past the end is clamped to the
//! list, and a search that may find nothing returns an `Option`. A `cost` clause bounds the number
//! of calls a function makes by the lengths of its lists and by `k`, the number of steps one call
//! of its callback takes. `List::sort`, `List::sort_by` and `List::sort_by_key` cost the list's
//! length times the logarithm of its length. `List::binary_search` and `List::partition_point` cost
//! only the logarithm of the length. A `reuse fn` modifies its argument list in place when nothing
//! else uses that list, instead of copying it.
//!
//! `List::sum` and `List::product` combine a list into a single number. `List::group_by`,
//! `List::index_by`, `List::count_by` and `List::frequencies` build a `Map` keyed by a value
//! computed from each element. Selections whose number grows explosively (`combinations`,
//! `permutations`, `cartesian`) are in `std.seq`, which produces them one at a time.

import std.laws (agrees, inverse)
import std.math (ilog2)
import std.gen

/// The first element, or `None` for an empty list.
pub transparent fn List::first<a>(xs: List<a>) -> Option<a>
  cost 1
= xs.at(0)

/// The last element, or `None` for an empty list.
pub transparent fn List::last<a>(xs: List<a>) -> Option<a>
  cost 1
= xs.at(xs.len() - 1)

/// The element at `i`. An index outside the list is the caller's mistake, and raises.
pub fn List::get<a>(xs: List<a>, i: Int) -> a / {abort.raise}
  cost 1
= match xs.at(i) { Some(x) -> x, None -> panic("the index is out of range for the list") }

/// The element at `i`, or `spare` when `i` is outside the list.
pub fn List::at_or<a>(xs: List<a>, i: Int, spare: a) -> a
  cost 1
= match xs.at(i) { Some(x) -> x, None -> spare }

/// The first `n` elements. A non-positive `n` gives the empty list, and a list shorter than `n` is
/// returned whole.
pub fn List::take<a>(xs: List<a>, n: Int) -> List<a> =
  range(0, clamped(n, xs.len())).fold([], |accumulator: List<a>, i: Int|
    push_at(accumulator, xs, i))

/// Everything but the first `n` elements. A non-positive `n` returns the list unchanged.
pub fn List::drop<a>(xs: List<a>, n: Int) -> List<a> =
  range(clamped(n, xs.len()), xs.len()).fold([], |accumulator: List<a>, i: Int|
    push_at(accumulator, xs, i))

/// The last `n` elements. A non-positive `n` gives the empty list, and a list shorter than `n` is
/// returned whole.
pub fn List::take_last<a>(xs: List<a>, n: Int) -> List<a> = xs.drop(xs.len() - clamped(n, xs.len()))

/// Everything but the last `n` elements. A non-positive `n` returns the list unchanged.
pub fn List::drop_last<a>(xs: List<a>, n: Int) -> List<a> = xs.take(xs.len() - clamped(n, xs.len()))

/// Returns the elements at indexes `from` up to but not including `to`. Indexes below zero or past
/// the end of the list are clamped to the list's bounds, and when `to` is not greater than `from`
/// the result is empty.
pub fn List::slice<a>(xs: List<a>, from: Int, to: Int) -> List<a> =
  range(clamped(from, xs.len()), clamped(to, xs.len())).fold([], |accumulator: List<a>, i: Int|
    push_at(accumulator, xs, i))

/// The longest prefix whose elements all satisfy `ok`. `ok` is not called after the first element
/// it returns false for.
pub fn List::take_while<a | e>(xs: List<a>, ok: (a) -> Bool / e cost k) -> List<a> / e =
  xs.take(leading(xs, ok))

/// Everything from the first element `ok` returns false for. `ok` is not called after that element.
pub fn List::drop_while<a | e>(xs: List<a>, ok: (a) -> Bool / e cost k) -> List<a> / e =
  xs.drop(leading(xs, ok))

/// `List::take_while` and `List::drop_while` at once: the longest prefix whose elements all satisfy
/// `ok`, and everything after it. `ok` is not called after the first element it returns false for.
pub fn List::span<a | e>(
  xs: List<a>,
  ok: (a) -> Bool / e cost k,
) -> { prefix: List<a>, rest: List<a> } / e = {
  let n = leading(xs, ok);
  { prefix: xs.take(n), rest: xs.drop(n) }
}

/// The list back to front. The index counts down while the accumulator appends, so nothing is
/// prepended and the pass is linear.
pub fn List::reverse<a>(xs: List<a>) -> List<a>
  cost xs.len()
=
  range(0, xs.len()).fold([], |accumulator: List<a>, i: Int|
    push_at(accumulator, xs, xs.len() - 1 - i))

/// The list rotated `n` places toward its front, so the element at `n` comes first and those before
/// it follow the last. `n` is taken modulo the length: a negative `n` rotates toward the back, and
/// a multiple of the length leaves the list unchanged.
pub fn List::rotate<a>(xs: List<a>, n: Int) -> List<a> = {
  let k = wrap_index(n, xs.len());
  range(0, xs.len()).fold([], |accumulator: List<a>, i: Int|
    push_at(accumulator, xs, if i + k < xs.len() { i + k } else { i + k - xs.len() }))
}

/// `xs` followed by `ys`.
pub fn List::concat<a>(xs: List<a>, ys: List<a>) -> List<a>
  cost ys.len()
= ys.fold(xs, |accumulator: List<a>, y: a| accumulator.push(y))

/// Returns the lists that `f` returns when called on each element of `xs`, joined into one list in
/// order.
pub fn List::flat_map<a, b | e>(xs: List<a>, f: (a) -> List<b> / e) -> List<b> / e =
  xs.fold([], |accumulator: List<b>, x: a| accumulator.concat(f(x)))

/// Each element with the one at its position in `ys`, up to the shorter of the two.
pub reuse fn zip<a, b>(xs: List<a>, ys: List<b>) -> List<{ first: a, second: b }> =
  range(0, min(xs.len(), ys.len())).fold([], |accumulator: List<{ first: a, second: b }>, i: Int|
    match ((xs.at(i), ys.at(i))) {
      (Some(x), Some(y)) -> accumulator.push({ first: x, second: y }),
      _ -> accumulator,
    })

/// Each element with the one at its position in `ys`, or `None` unless the two have the same
/// length, which `zip` does not require.
pub fn List::zip_strict<a, b>(xs: List<a>, ys: List<b>) -> Option<List<{ first: a, second: b }>> =
  if xs.len() == ys.len() { Some(zip(xs, ys)) } else { None }

/// `f` applied to the pair of elements at each index, stopping at the shorter list.
pub reuse fn zip_with<a, b, c | e>(
  xs: List<a>,
  ys: List<b>,
  f: (a, b) -> c / e cost k,
) -> List<c> / e =
  range(0, min(xs.len(), ys.len())).fold([], |accumulator: List<c>, i: Int|
    match ((xs.at(i), ys.at(i))) {
      (Some(x), Some(y)) -> accumulator.push(f(x, y)),
      _ -> accumulator,
    })

/// The pairs `zip` makes, split back into the list of their firsts and the list of their seconds.
pub fn List::unzip<a, b>(
  pairs: List<{ first: a, second: b }>,
) -> { firsts: List<a>, seconds: List<b> }
  cost pairs.len()
=
  {
    firsts: pairs.map(|p: { first: a, second: b }| p.first),
    seconds: pairs.map(|p: { first: a, second: b }| p.second),
  }

/// Each element with its position, counting from zero.
pub reuse fn enumerate<a>(xs: List<a>) -> List<{ index: Int, value: a }>
  cost xs.len()
=
  xs.fold([], |accumulator: List<{ index: Int, value: a }>, x: a| {
    let index = accumulator.len();
    accumulator.push({ index: index, value: x })
  })

/// Each element with the one after it, so a list of fewer than two elements has none.
pub reuse fn pairwise<a>(xs: List<a>) -> List<{ first: a, second: a }>
  cost xs.len()
=
  range(0, xs.len()).fold([], |accumulator: List<{ first: a, second: a }>, i: Int|
    match ((xs.at(i), xs.at(i + 1))) {
      (Some(x), Some(y)) -> accumulator.push({ first: x, second: y }),
      _ -> accumulator,
    })

/// Returns the transpose of `xss`: a list of the first elements of every list, then the second
/// elements, and so on. It has as many positions as the shortest list has elements, so longer lists
/// are cut short, as `zip` cuts the longer of two lists. The result is an empty list when `xss` is
/// empty or when any list in it is empty.
pub fn List::transpose<a>(xss: List<List<a>>) -> List<List<a>> =
  range(0, shortest_length(xss)).map(|j: Int|
    xss.fold([], |column: List<a>, xs: List<a>| push_at(column, xs, j)))

/// `x`, repeated `n` times. Empty when `n` is not positive.
pub fn List::replicate<a>(x: a, n: Int) -> List<a> = range(0, n).map(|_: Int| x)

/// Whether `ok` returns true for some element. An empty list gives `false`. `ok` is not called
/// after the first element it returns true for.
pub transparent fn List::any<a | e>(xs: List<a>, ok: (a) -> Bool / e cost k) -> Bool / e
  cost xs.len() * k
= match xs { [] -> false, [x, ..rest] -> if ok(x) { true } else { rest.any(ok) } }

/// Whether `ok` returns true for every element. An empty list gives `true`. `ok` is not called
/// after the first element it returns false for.
pub transparent fn List::all<a | e>(xs: List<a>, ok: (a) -> Bool / e cost k) -> Bool / e
  cost xs.len() * k
= match xs { [] -> true, [x, ..rest] -> if ok(x) { rest.all(ok) } else { false } }

/// How many elements `ok` returns true for.
pub transparent fn List::count<a | e>(xs: List<a>, ok: (a) -> Bool / e cost k) -> Int / e
  cost xs.len() * k
= xs.fold(0, |accumulator: Int, x: a| if ok(x) { accumulator + 1 } else { accumulator })

/// The first element `ok` returns true for, or `None`. `ok` is not called on any later element.
pub transparent fn List::find<a | e>(xs: List<a>, ok: (a) -> Bool / e cost k) -> Option<a> / e
  cost xs.len() * k
= match xs { [] -> None, [x, ..rest] -> if ok(x) { Some(x) } else { rest.find(ok) } }

/// The first `Some` that `f` returns, or `None`. `f` is not called on any later element.
pub transparent fn List::find_map<a, b | e>(
  xs: List<a>,
  f: (a) -> Option<b> / e cost k,
) -> Option<b> / e
  cost xs.len() * k
=
  match xs {
    [] -> None,
    [x, ..rest] -> match f(x) { Some(y) -> Some(y), None -> rest.find_map(f) },
  }

/// The last element `ok` returns true for, or `None`. `ok` is called on every element.
pub transparent fn List::find_last<a | e>(xs: List<a>, ok: (a) -> Bool / e cost k) -> Option<a> / e
  cost xs.len() * k
= xs.fold(None, |found: Option<a>, x: a| if ok(x) { Some(x) } else { found })

/// The position of the first element `ok` returns true for, or `None`. `ok` is not called on any
/// later element.
pub transparent fn List::find_index<a | e>(
  xs: List<a>,
  ok: (a) -> Bool / e cost k,
) -> Option<Int> / e
  cost xs.len() * k
= index_from(xs, ok, 0)

transparent fn index_from<a | e>(
  xs: List<a>,
  ok: (a) -> Bool / e cost k,
  at: Int,
) -> Option<Int> / e
  cost xs.len() * k
=
  match xs {
    [] -> None,
    [x, ..rest] -> if ok(x) { Some(at) } else { index_from(rest, ok, at + 1) },
  }

/// Whether `x` is one of the elements.
pub transparent fn List::contains<a>(xs: List<a>, x: a) -> Bool
  where derivable(eq, a)
  cost xs.len()
= xs.any(|y: a| y == x)

/// `xs` with `x` pushed on, unless it already contains `x`.
pub fn List::push_unique<a>(xs: List<a>, x: a) -> List<a>
  where derivable(eq, a)
  cost xs.len()
= if xs.contains(x) { xs } else { xs.push(x) }

/// Whether the list has no elements.
pub fn List::is_empty<a>(xs: List<a>) -> Bool
  cost 1
= xs.len() == 0

/// Returns a list with `x` first, followed by the elements of `xs`. Copies `xs`, because a `List`
/// can only be added to at the back.
pub reuse fn prepend<a>(x: a, xs: List<a>) -> List<a>
  cost xs.len()
= xs.fold([x], |accumulator: List<a>, y: a| accumulator.push(y))

/// The values inside the `Some`s, in order. Every `None` is left out.
pub reuse fn somes<a>(xs: List<Option<a>>) -> List<a>
  cost xs.len()
=
  xs.fold([], |accumulator: List<a>, x: Option<a>|
    match x { Some(v) -> accumulator.push(v), None -> accumulator })

/// The values `f` returns in `Some`, for each element in order. An element it returns `None` for is
/// left out.
pub reuse fn filter_map<a, b | e>(xs: List<a>, f: (a) -> Option<b> / e cost k) -> List<b> / e
  cost xs.len() * k
=
  xs.fold([], |accumulator: List<b>, x: a|
    match f(x) { Some(y) -> accumulator.push(y), None -> accumulator })

/// The position of the first `x`, or `None`.
pub fn List::index_of<a>(xs: List<a>, x: a) -> Option<Int>
  where derivable(eq, a)
  cost xs.len()
= xs.find_index(|y: a| y == x)

/// The position of the last `x`, or `None`.
pub fn List::last_index_of<a>(xs: List<a>, x: a) -> Option<Int>
  where derivable(eq, a)
  cost xs.len()
=
  range(0, xs.len()).fold(None, |found: Option<Int>, i: Int|
    if xs.at(i) == Some(x) { Some(i) } else { found })

/// The list without the element at `i`. An index outside the list leaves it unchanged.
pub fn List::remove_at<a>(xs: List<a>, i: Int) -> List<a>
  cost xs.len()
=
  range(0, xs.len()).fold([], |accumulator: List<a>, at: Int|
    if at == i { accumulator } else { push_at(accumulator, xs, at) })

/// `x` taken out once, at its first position; `None` if it is not there.
pub fn List::remove_first<a>(xs: List<a>, x: a) -> Option<List<a>>
  where derivable(eq, a)
  cost xs.len()
= match xs.index_of(x) { None -> None, Some(i) -> Some(xs.remove_at(i)) }

/// The result of `f` after each element, with each call passed the previous result, starting from
/// `init`. These are the accumulators a `List::fold` passes through, and the last is the fold's
/// result. `init` is not among them, so the result is as long as `xs`.
pub reuse fn scan<a, b | e>(xs: List<a>, init: b, f: (b, a) -> b / e cost k) -> List<b> / e
  cost xs.len() * k
=
  xs.fold([], |out: List<b>, x: a| {
    let accumulator = match out.at(out.len() - 1) { Some(y) -> y, None -> init };
    out.push(f(accumulator, x))
  })

/// A fold from the back: `f` of the last element and `init`, then of the element before it and that
/// result, down to the first. So `f` is called in reverse list order.
pub fn List::fold_right<a, b | e>(xs: List<a>, init: b, f: (a, b) -> b / e cost k) -> b / e
  cost xs.len() * k
=
  xs.fold(
    { accumulator: init, at: xs.len() - 1 },
    |s: { accumulator: b, at: Int }, _: a|
      match xs.at(s.at) {
        Some(x) -> { accumulator: f(x, s.accumulator), at: s.at - 1 },
        None -> s,
      },
  ).accumulator

/// Returns the greatest element, or `None` for an empty list. If several elements are equally
/// greatest, returns the first of them.
pub fn List::max_of<a>(xs: List<a>) -> Option<a>
  where derivable(ord, a)
  cost xs.len()
=
  match xs {
    [] -> None,
    [first, ..rest] ->
      Some(rest.fold(first, |best: a, x: a| match compare(x, best) { Greater -> x, _ -> best })),
  }

/// Returns the least element, or `None` for an empty list. If several elements are equally least,
/// returns the first of them.
pub fn List::min_of<a>(xs: List<a>) -> Option<a>
  where derivable(ord, a)
  cost xs.len()
=
  match xs {
    [] -> None,
    [first, ..rest] ->
      Some(rest.fold(first, |best: a, x: a| match compare(x, best) { Less -> x, _ -> best })),
  }

/// Returns the element for which `key_of` returns the greatest key, or `None` for an empty list. If
/// several elements have that key, returns the first of them. Calls `key_of` once on each element.
pub fn List::max_by<a, k | e>(xs: List<a>, key_of: (a) -> k / e cost c) -> Option<a> / e
  where derivable(ord, k)
  cost xs.len() * c
= best_by(xs, key_of, Greater)

/// The element for which `key_of` returns the least key, or `None` for an empty list. Of several
/// with that key, the first is returned. `key_of` is called once on each element.
pub fn List::min_by<a, k | e>(xs: List<a>, key_of: (a) -> k / e cost c) -> Option<a> / e
  where derivable(ord, k)
  cost xs.len() * c
= best_by(xs, key_of, Less)

/// Whether the elements are in ascending order. Equal neighbours are, and so is a list of fewer
/// than two elements.
pub fn List::is_sorted<a>(xs: List<a>) -> Bool
  where derivable(ord, a)
  cost xs.len()
=
  range(0, xs.len() - 1).fold(true, |accumulator: Bool, i: Int|
    accumulator
      && (match ((xs.at(i), xs.at(i + 1))) {
        (Some(x), Some(y)) -> !(compare(x, y) == Greater),
        _ -> true,
      }))

/// The elements in ascending order, by a merge sort: `n log n` comparisons whatever the input
/// order is, and equal elements keep their relative order.
pub fn List::sort<a>(xs: List<a>) -> List<a>
  where derivable(ord, a)
= merge_sorted(xs, |later: a, earlier: a| compare(later, earlier) == Less)

/// Returns the elements ordered by `before`, which returns whether its first argument must come
/// before its second. The result is totally ordered if `before` is. Elements that `before` does not
/// order, or for which `before` returns true in both directions (as `<=` does for equal values),
/// stay in their original relative order. Calls `before` up to twice on a pair.
pub fn List::sort_by<a | e>(xs: List<a>, before: (a, a) -> Bool / e) -> List<a> / e =
  merge_sorted(xs, |later: a, earlier: a| before(later, earlier) && !before(earlier, later))

/// The elements in ascending order of the key `key_of` returns for each, calling it once per
/// element. Elements with equal keys keep their relative order.
pub fn List::sort_by_key<a, k | e>(xs: List<a>, key_of: (a) -> k / e) -> List<a> / e
  where derivable(ord, k)
=
  merge_sorted(
    xs.map(|x: a| { key: key_of(x), item: x }),
    |later: { key: k, item: a }, earlier: { key: k, item: a }|
      compare(later.key, earlier.key) == Less,
  ).map(|keyed: { key: k, item: a }| keyed.item)

/// Searches a list sorted by `order` for an element. `order` returns how an element compares to the
/// one sought: `Less` if it comes before the sought element. The list must contain every `Less`
/// element first, then every `Equal` one, then every `Greater` one. Returns `Ok` with the index of
/// the first `Equal` element, or `Err` with the index where the sought element would be inserted to
/// keep the order, which is the number of `Less` elements. Calls `order` on a logarithmic number of
/// elements. If the list is not sorted this way, an `Ok` index still points to an `Equal` element,
/// but `Err` does not prove that no `Equal` element exists.
pub fn List::binary_search<a | e>(xs: List<a>, order: (a) -> Ordering / e) -> Result<Int, Int> / e = {
  let i = xs.partition_point(|x: a| order(x) == Less);
  match xs.at(i) { Some(x) -> if order(x) == Equal { Ok(i) } else { Err(i) }, None -> Err(i) }
}

/// Returns how many leading elements `ok` returns true for, assuming no element that `ok` accepts
/// follows one that it rejects. The result is the index of the first element `ok` returns false
/// for, or the length if there is none. Calls `ok` on a logarithmic number of elements. If the list
/// is not arranged this way, the result is still an index `i` where `ok` returns true for the
/// element before `i` and false for the element at `i`, when those elements exist.
pub fn List::partition_point<a | e>(xs: List<a>, ok: (a) -> Bool / e) -> Int / e =
  partition_point_from(xs, ok, 0, widest_stride(xs.len(), 1))

/// Returns the elements of every inner list, concatenated in order into one list.
pub fn List::flatten<a>(xss: List<List<a>>) -> List<a> = xss.flat_map(|xs: List<a>| xs)

/// The elements `ok` returns true for, and the rest, in their original order. `ok` is called once
/// on each element, in order.
pub fn List::partition<a | e>(
  xs: List<a>,
  ok: (a) -> Bool / e cost k,
) -> { yes: List<a>, no: List<a> } / e
  cost xs.len() * k
= partition_into(xs, ok, [], [])

/// The list split at `n`: the first `n` elements and the rest, so the two halves are `List::take`
/// and `List::drop` combined. An `n` outside the list puts the whole list on one side.
pub fn List::split_at<a>(xs: List<a>, n: Int) -> { head: List<a>, tail: List<a> } =
  { head: xs.take(n), tail: xs.drop(n) }

/// The elements in groups of `n`, the last one short. A non-positive `n` has no groups.
pub fn List::chunks<a>(xs: List<a>, n: Int) -> List<List<a>>
  cost xs.len()
= if n <= 0 { [] } else { chunks_from(xs, n, [], []) }

/// The elements in runs of neighbours for which `key_of` returns the same key. A run ends where the
/// next element's key differs, so two separate runs may have the same key, whereas `std.map`'s
/// `group_by` collects a key's elements wherever they are. No run is empty. `key_of` is called once
/// on each element.
pub fn List::chunk_by<a, k | e>(xs: List<a>, key_of: (a) -> k / e cost c) -> List<List<a>> / e
  where derivable(eq, k)
  cost xs.len() * c
= runs_from(xs.map(|x: a| { key: key_of(x), item: x }), [], [], None)

/// Every run of `n` neighbouring elements, in order. A non-positive `n`, or one past the length,
/// has none.
pub fn List::windows<a>(xs: List<a>, n: Int) -> List<List<a>> =
  if n <= 0 || n > xs.len() { [] }
  else { range(0, xs.len() - n + 1).map(|i: Int| xs.slice(i, i + n)) }

/// `xs` with `sep` between each pair and nowhere else.
pub reuse fn intersperse<a>(xs: List<a>, sep: a) -> List<a>
  cost xs.len()
=
  match xs {
    [] -> [],
    [first, ..rest] ->
      rest.fold([first], |accumulator: List<a>, x: a| accumulator.push(sep).push(x)),
  }

/// An element of `xs`, then one of `ys`, and so on in turn; once either has ended, the rest of the
/// other.
pub fn List::interleave<a>(xs: List<a>, ys: List<a>) -> List<a>
  cost xs.len() + ys.len()
= {
  let paired = min(xs.len(), ys.len());
  range(0, xs.len() + ys.len()).fold([], |accumulator: List<a>, i: Int|
    if i < 2 * paired { push_at(accumulator, if i & 1 == 0 { xs } else { ys }, i >> 1) }
    else { push_at(push_at(accumulator, xs, i - paired), ys, i - paired) })
}

/// Returns the elements with duplicates removed, keeping the first occurrence of each, in the
/// original order. Tracks the elements already seen in a `Map`, so it takes `n log n` time rather
/// than `n²`.
pub fn List::unique<a>(xs: List<a>) -> List<a>
  where derivable(ord, a)
  cost xs.len()
= unique_from(xs, Map::new(), [])

/// Each distinct element once, in ascending order.
pub fn sorted_unique<a>(xs: List<a>) -> List<a>
  where derivable(ord, a)
= xs.fold(Map::new(), |seen: Map<a, Unit>, x: a| seen.insert(x, ())).keys()

/// Returns the elements with each run of equal neighbours reduced to its first element. An element
/// can still appear again later, unlike in `List::unique`, which removes every repeat.
pub reuse fn dedup<a>(xs: List<a>) -> List<a>
  where derivable(eq, a)
  cost xs.len()
=
  xs.fold([], |deduplicated: List<a>, x: a|
    if deduplicated.at(deduplicated.len() - 1) == Some(x) { deduplicated }
    else { deduplicated.push(x) })

fn merge_sorted<a | e>(xs: List<a>, precedes: (a, a) -> Bool / e) -> List<a> / e =
  if xs.len() <= 1 { xs }
  else { match runs_merged(xs.map(|x: a| [x]), 64, precedes) { [] -> [], [run, ..] -> run } }

fn runs_merged<a | e>(
  runs: List<List<a>>,
  rounds: Int,
  precedes: (a, a) -> Bool / e,
) -> List<List<a>> / e =
  if rounds <= 0 || runs.len() <= 1 { runs } else {
    runs_merged(
      range(0, (runs.len() + 1) / 2).map(|i: Int|
        match ((runs.at(2 * i), runs.at(2 * i + 1))) {
          (Some(left), Some(right)) -> merge_into(left, right, [], precedes),
          (Some(left), None) -> left,
          _ -> [],
        }),
      rounds - 1,
      precedes,
    )
  }

reuse fn merge_into<a | e>(
  a: List<a>,
  b: List<a>,
  accumulator: List<a>,
  precedes: (a, a) -> Bool / e,
) -> List<a> / e =
  match a {
    [] -> accumulator.concat(b),
    [x, ..rest_a] -> match b {
      [] -> accumulator.concat(a),
      [y, ..rest_b] -> if precedes(y, x) { merge_into(a, rest_b, accumulator.push(y), precedes) }
      else { merge_into(rest_a, b, accumulator.push(x), precedes) },
    },
  }

fn best_by<a, k | e>(xs: List<a>, key_of: (a) -> k / e cost c, wanted: Ordering) -> Option<a> / e
  where derivable(ord, k)
  cost xs.len() * c
=
  match xs.fold(None, |best: Option<{ key: k, item: a }>, x: a| {
      let key = key_of(x);
      match best {
        None -> Some({ key: key, item: x }),
        Some(current_best) -> if compare(key, current_best.key) == wanted {
          Some({ key: key, item: x })
        } else { best },
      }
    }) {
    Some(current_best) -> Some(current_best.item),
    None -> None,
  }

fn leading<a | e>(xs: List<a>, ok: (a) -> Bool / e cost k) -> Int / e
  cost xs.len() * k
= match xs.find_index(|x: a| !ok(x)) { Some(i) -> i, None -> xs.len() }

fn partition_point_from<a | e>(
  xs: List<a>,
  ok: (a) -> Bool / e,
  known: Int,
  stride: Int,
) -> Int / e =
  if stride < 1 { known } else {
    match xs.at(known + stride - 1) {
      Some(x) -> if ok(x) { partition_point_from(xs, ok, known + stride, stride / 2) }
      else { partition_point_from(xs, ok, known, stride / 2) },
      None -> partition_point_from(xs, ok, known, stride / 2),
    }
  }

fn widest_stride(n: Int, stride: Int) -> Int =
  if n <= 1 { stride } else { widest_stride(n / 2, stride * 2) }

reuse fn partition_into<a | e>(
  xs: List<a>,
  ok: (a) -> Bool / e cost k,
  yes: List<a>,
  no: List<a>,
) -> { yes: List<a>, no: List<a> } / e =
  match xs {
    [] -> { yes: yes, no: no },
    [x, ..rest] -> if ok(x) { partition_into(rest, ok, yes.push(x), no) }
    else { partition_into(rest, ok, yes, no.push(x)) },
  }

fn shortest_length<a>(xss: List<List<a>>) -> Int =
  match xss {
    [] -> 0,
    [first, ..rest] -> rest.fold(first.len(), |least: Int, xs: List<a>| min(least, xs.len())),
  }

fn wrap_index(n: Int, size: Int) -> Int =
  handle { (n % size + size) % size } with { abort.raise(_) -> 0 }

fn clamped(n: Int, total: Int) -> Int = if n < 0 { 0 } else if n > total { total } else { n }

reuse fn chunks_from<a>(
  xs: List<a>,
  n: Int,
  accumulator: List<List<a>>,
  current: List<a>,
) -> List<List<a>> =
  match xs {
    [] -> if current.len() == 0 { accumulator } else { accumulator.push(current) },
    [x, ..rest] -> if current.len() == n { chunks_from(rest, n, accumulator.push(current), [x]) }
    else { chunks_from(rest, n, accumulator, current.push(x)) },
  }

reuse fn runs_from<a, k>(
  keyed: List<{ key: k, item: a }>,
  runs: List<List<a>>,
  run: List<a>,
  held: Option<k>,
) -> List<List<a>>
  where derivable(eq, k)
=
  match keyed {
    [] -> if run.len() == 0 { runs } else { runs.push(run) },
    [next, ..rest] -> if run.len() == 0 || held == Some(next.key) {
      runs_from(rest, runs, run.push(next.item), Some(next.key))
    } else { runs_from(rest, runs.push(run), [next.item], Some(next.key)) },
  }

reuse fn unique_from<a>(xs: List<a>, seen: Map<a, Unit>, out: List<a>) -> List<a>
  where derivable(ord, a)
=
  match xs {
    [] -> out,
    [x, ..rest] -> if seen.contains(x) { unique_from(rest, seen, out) }
    else { unique_from(rest, seen.insert(x, ()), out.push(x)) },
  }

reuse fn push_at<a>(accumulator: List<a>, xs: List<a>, i: Int) -> List<a> =
  match xs.at(i) { Some(x) -> accumulator.push(x), None -> accumulator }

effect asks {
  write one() -> Unit
  read so_far() -> Int
}

/// Each element of `xs` with its index. An element that repeats keeps its last index.
pub fn positions<a>(xs: List<a>) -> Map<a, Int> / {abort.raise}
  where derivable(ord, a)
= range(0, xs.len()).fold(Map::new(), |m: Map<a, Int>, i: Int| m.insert(xs.get(i), i))

test "`take` and `drop` split a list in two, and accept counts that are zero, negative or larger than the list" {
  assert_eq([1, 2, 3].take(2), [1, 2]);
  assert_eq([1, 2, 3].take(0), []);
  assert_eq([1, 2, 3].take(0 - 1), []);
  assert_eq([1, 2, 3].take(9), [1, 2, 3]);
  assert_eq([].take(2), []);
  assert_eq([1, 2, 3].drop(1), [2, 3]);
  assert_eq([1, 2, 3].drop(0), [1, 2, 3]);
  assert_eq([1, 2, 3].drop(9), []);
  assert_eq([].drop(1), []);
  assert_eq([1, 2, 3].take(2).concat([1, 2, 3].drop(2)), [1, 2, 3])
}

test "`take_last` and `drop_last` cut from the back, and accept counts that are zero, negative or larger than the list" {
  assert_eq([1, 2, 3].take_last(2), [2, 3]);
  assert_eq([1, 2, 3].take_last(0), []);
  assert_eq([1, 2, 3].take_last(0 - 1), []);
  assert_eq([1, 2, 3].take_last(9), [1, 2, 3]);
  assert_eq([].take_last(2), []);
  assert_eq([1, 2, 3].drop_last(1), [1, 2]);
  assert_eq([1, 2, 3].drop_last(0), [1, 2, 3]);
  assert_eq([1, 2, 3].drop_last(0 - 1), [1, 2, 3]);
  assert_eq([1, 2, 3].drop_last(9), []);
  assert_eq([].drop_last(1), []);
  let least = 0 - 9223372036854775807 - 1;
  assert_eq([1, 2, 3].take_last(least), []);
  assert_eq([1, 2, 3].drop_last(least), [1, 2, 3])
}

test "slice is the elements between two indexes, clamped to the list" {
  assert_eq([1, 2, 3, 4].slice(1, 3), [2, 3]);
  assert_eq([1, 2, 3, 4].slice(0, 4), [1, 2, 3, 4]);
  assert_eq([1, 2, 3, 4].slice(2, 2), []);
  assert_eq([1, 2, 3, 4].slice(3, 1), []);
  assert_eq([1, 2, 3, 4].slice(0 - 2, 2), [1, 2]);
  assert_eq([1, 2, 3, 4].slice(2, 9), [3, 4]);
  assert_eq([1, 2, 3, 4].slice(7, 9), []);
  assert_eq([].slice(0, 3), [])
}

test "a slice far past the list returns what the list contains" {
  let far = 9223372036854775807;
  assert_eq([1, 2, 3].slice(1, far), [2, 3]);
  assert_eq([1, 2, 3].slice(0 - far, far), [1, 2, 3])
}

test "`drop_while` drops the matching prefix and does not call the predicate on elements after the first non-match" {
  assert_eq([1, 2, 5, 1].drop_while(|x: Int| x < 3), [5, 1]);
  assert_eq([4, 1].drop_while(|x: Int| x < 3), [4, 1]);
  assert_eq([1, 2].drop_while(|x: Int| x < 3), []);
  let result = handle {
    let remaining = [1, 9, 1, 1].drop_while(|x: Int| {
      asks.one();
      x < 3
    });
    { retained: remaining, requested: asks.so_far() }
  } with {
    var n = 0,
    asks.one() -> {
      n = n + 1;
    },
    asks.so_far() -> n,
  };
  assert_eq(result, { retained: [9, 1, 1], requested: 2 })
}

test "`take_while` returns the matching prefix and does not call the predicate on elements after the first non-match" {
  assert_eq([1, 2, 5, 1].take_while(|x: Int| x < 3), [1, 2]);
  assert_eq([4, 1].take_while(|x: Int| x < 3), []);
  assert_eq([].take_while(|x: Int| x < 3), []);
  let result = handle {
    let prefix = [1, 9, 1, 1].take_while(|x: Int| {
      asks.one();
      x < 3
    });
    { retained: prefix, requested: asks.so_far() }
  } with {
    var n = 0,
    asks.one() -> {
      n = n + 1;
    },
    asks.so_far() -> n,
  };
  assert_eq(result, { retained: [1], requested: 2 })
}

test "`span` splits where `take_while` stops, and does not call the predicate on elements after the first non-match" {
  assert_eq([1, 2, 5, 1].span(|x: Int| x < 3), { prefix: [1, 2], rest: [5, 1] });
  assert_eq([4, 1].span(|x: Int| x < 3), { prefix: [], rest: [4, 1] });
  assert_eq([].span(|x: Int| x < 3), { prefix: [], rest: [] });
  let result = handle {
    let halves = [1, 9, 1].span(|x: Int| {
      asks.one();
      x < 3
    });
    { halves: halves, requested: asks.so_far() }
  } with {
    var n = 0,
    asks.one() -> {
      n = n + 1;
    },
    asks.so_far() -> n,
  };
  assert_eq(result, { halves: { prefix: [1], rest: [9, 1] }, requested: 2 })
}

test "reverse is the list back to front, and first and last are its ends" {
  assert_eq([1, 2, 3].reverse(), [3, 2, 1]);
  assert_eq([].reverse(), []);
  assert_eq([1].reverse(), [1]);
  assert_eq([1, 2, 3].reverse().reverse(), [1, 2, 3]);
  assert_eq([1, 2].first(), Some(1));
  assert_eq([].first(), None);
  assert_eq([1, 2].last(), Some(2));
  assert_eq([].last(), None)
}

test "rotate turns the list toward its front, with any count taken modulo the length" {
  assert_eq([1, 2, 3, 4].rotate(1), [2, 3, 4, 1]);
  assert_eq([1, 2, 3, 4].rotate(0 - 1), [4, 1, 2, 3]);
  assert_eq([1, 2, 3, 4].rotate(0), [1, 2, 3, 4]);
  assert_eq([1, 2, 3, 4].rotate(4), [1, 2, 3, 4]);
  assert_eq([1, 2, 3, 4].rotate(9), [2, 3, 4, 1]);
  assert_eq([1, 2, 3, 4].rotate(0 - 9), [4, 1, 2, 3]);
  assert_eq([1].rotate(5), [1]);
  assert_eq([].rotate(3), []);
  assert_eq([1, 2, 3].rotate(9223372036854775807), [2, 3, 1]);
  assert_eq([1, 2, 3].rotate(0 - 9223372036854775807 - 1), [2, 3, 1])
}

fn get_result(xs: List<Int>, i: Int) -> Result<Int, String> =
  handle { xs.get(i) } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

test "`get` returns an element in the list and raises for any other index, and `at_or` returns the given default for such an index" {
  assert_eq(get_result([7, 8, 9], 0), Ok(7));
  assert_eq(get_result([7, 8, 9], 2), Ok(9));
  assert_eq(get_result([7, 8, 9], 3), Err("the index is out of range for the list"));
  assert_eq(get_result([7, 8, 9], 0 - 1), Err("the index is out of range for the list"));
  assert_eq(get_result([], 0), Err("the index is out of range for the list"));
  assert_eq([7, 8, 9].at_or(1, 0), 8);
  assert_eq([7, 8, 9].at_or(3, 0), 0);
  assert_eq([].at_or(0, "none"), "none")
}

test "concat and flat_map put lists one after another" {
  assert_eq([1, 2].concat([3]), [1, 2, 3]);
  assert_eq([].concat([1]), [1]);
  assert_eq([1].concat([]), [1]);
  assert_eq([1, 2, 3].flat_map(|n: Int| [n, n * 10]), [1, 10, 2, 20, 3, 30]);
  assert_eq([1, 2].flat_map(|_: Int| []), []);
  assert_eq([].flat_map(|n: Int| [n]), [])
}

test "zip_with combines the elements at each index and stops at the shorter list" {
  assert_eq(zip_with([1, 2, 3], [10, 20], |x: Int, y: Int| x + y), [11, 22]);
  assert_eq(zip_with([], [1], |x: Int, y: Int| x * y), [])
}

test "unzip undoes zip, and splits no pairs into two empty lists" {
  assert_eq(zip([1, 2], ["a", "b"]).unzip(), { firsts: [1, 2], seconds: ["a", "b"] });
  let none: List<{ first: Int, second: String }> = [];
  assert_eq(none.unzip(), { firsts: [], seconds: [] })
}

test "last_index_of returns the position of the last match, and none when nothing matches" {
  assert_eq([1, 2, 1, 3].last_index_of(1), Some(2));
  assert_eq([1, 2].last_index_of(5), None)
}

test "`find_map` returns the first `Some` result and does not call the function on later elements" {
  let first_above_two = |xs: List<Int>|
    xs.find_map(|n: Int| if n > 2 { Some(n * 10) } else { None });
  assert_eq(first_above_two([1, 3, 4]), Some(30));
  assert_eq(first_above_two([1, 2]), None);
  assert_eq(first_above_two([]), None);
  assert_eq([1, 0].find_map(|n: Int| Some(10 / n)), Some(10))
}

test "find_last returns the last element that matches, and none when nothing does" {
  assert_eq([1, 2, 3, 4].find_last(|n: Int| n % 2 == 1), Some(3));
  assert_eq([2, 4].find_last(|n: Int| n % 2 == 1), None)
}

test "`filter_map` returns the values inside the `Some` results of its function, in list order" {
  let halved = |xs: List<Int>| filter_map(xs, |n: Int| if n % 2 == 0 { Some(n / 2) } else { None });
  assert_eq(halved([1, 2, 3, 4]), [1, 2]);
  assert_eq(halved([1, 3]), []);
  assert_eq(halved([]), []);
  assert_eq(filter_map(["a", "b"], |s: String| Some(s ++ "!")), ["a!", "b!"])
}

test "replicate repeats its element, and a count that is not positive gives none" {
  assert_eq(List::replicate("a", 3), ["a", "a", "a"]);
  assert_eq(List::replicate(1, 0), []);
  assert_eq(List::replicate(1, 0 - 2), [])
}

test "enumerate pairs each element with its position from zero" {
  assert_eq(enumerate(["a", "b"]), [{ index: 0, value: "a" }, { index: 1, value: "b" }]);
  let none: List<Int> = [];
  assert_eq(enumerate(none), [])
}

test "`zip` stops at the shorter list, and `zip_strict` returns `None` unless both lists have the same length" {
  assert_eq(zip([1, 2], ["a", "b"]), [{ first: 1, second: "a" }, { first: 2, second: "b" }]);
  assert_eq(zip([1, 2, 3], ["a"]), [{ first: 1, second: "a" }]);
  assert_eq(zip([], ["a"]), []);
  assert_eq(zip(["a"], []), []);
  assert_eq([1, 2].zip_strict(["a", "b"]), Some(zip([1, 2], ["a", "b"])));
  assert_eq([1, 2, 3].zip_strict(["a"]), None);
  assert_eq([1].zip_strict(["a", "b"]), None);
  let none: List<Int> = [];
  assert_eq(none.zip_strict(none), Some([]))
}

test "pairwise pairs each element with the next, and fewer than two have no pair" {
  assert_eq(pairwise([1, 2, 3]), [{ first: 1, second: 2 }, { first: 2, second: 3 }]);
  assert_eq(pairwise([1, 2]), [{ first: 1, second: 2 }]);
  assert_eq(pairwise([1]), []);
  let none: List<Int> = [];
  assert_eq(pairwise(none), [])
}

test "`transpose` turns rows into columns, using only as many columns as the shortest row has" {
  assert_eq([[1, 2, 3], [4, 5, 6]].transpose(), [[1, 4], [2, 5], [3, 6]]);
  assert_eq([[1, 2, 3]].transpose(), [[1], [2], [3]]);
  assert_eq([[1], [2], [3]].transpose(), [[1, 2, 3]]);
  assert_eq([[1, 2, 3], [4, 5], [6]].transpose(), [[1, 4, 6]]);
  assert_eq([[1, 2], []].transpose(), []);
  let none: List<List<Int>> = [];
  assert_eq(none.transpose(), [])
}

test "`any` and `all` return booleans, `count` returns a number, and `find` and `find_index` return an option, all by testing each element" {
  assert([1, 2, 3].any(|n: Int| n > 2));
  assert(![1, 2, 3].any(|n: Int| n > 9));
  assert(![].any(|n: Int| n > 0));
  assert([1, 2, 3].all(|n: Int| n > 0));
  assert([].all(|n: Int| n > 0));
  assert(![1, 0, 3].all(|n: Int| n > 0));
  assert_eq([1, 2, 3, 4].count(|n: Int| n % 2 == 0), 2);
  assert_eq([].count(|n: Int| n > 0), 0);
  assert_eq([1, 2, 3].find(|n: Int| n > 1), Some(2));
  assert_eq([1, 2, 3].find(|n: Int| n > 9), None);
  assert_eq([9, 2, 3].find_index(|n: Int| n < 5), Some(1));
  assert_eq([1, 2, 3].find_index(|n: Int| n > 9), None)
}

test "a callback may perform effects, and stops being called once the result is known" {
  let calls = handle {
    let tick = |x: Int| {
      asks.one();
      x
    };
    assert([1, 2, 3, 4].any(|x: Int| tick(x) == 2));
    let by_any = asks.so_far();
    assert(![1, 2, 3, 4].all(|x: Int| tick(x) < 2));
    let by_all = asks.so_far();
    assert_eq([1, 2, 3, 4].find(|x: Int| tick(x) > 2), Some(3));
    let by_find = asks.so_far();
    assert_eq([1, 2, 3, 4].find_index(|x: Int| tick(x) > 2), Some(2));
    let by_index = asks.so_far();
    assert_eq([1, 2, 3, 4].find_map(|x: Int| if tick(x) > 1 { Some(x) } else { None }), Some(2));
    let by_map = asks.so_far();
    assert_eq([1, 2, 3, 4].count(|x: Int| tick(x) > 2), 2);
    [
      by_any,
      by_all - by_any,
      by_find - by_all,
      by_index - by_find,
      by_map - by_index,
      asks.so_far() - by_map,
    ]
  } with {
    var n = 0,
    asks.one() -> {
      n = n + 1;
    },
    asks.so_far() -> n,
  };
  assert_eq(calls, [2, 2, 3, 3, 2, 4])
}

test "contains, index_of and remove_first test elements for equality" {
  assert([1, 2, 3].contains(2));
  assert(![1, 2, 3].contains(9));
  assert(![].contains(1));
  assert_eq([1, 2, 3, 2].index_of(2), Some(1));
  assert_eq([1, 2, 3].index_of(9), None);
  assert_eq([1, 2, 3].remove_first(2), Some([1, 3]));
  assert_eq([1, 2, 3].remove_first(1), Some([2, 3]));
  assert_eq([1, 2, 3].remove_first(3), Some([1, 2]));
  assert_eq([1, 2, 3, 2].remove_first(2), Some([1, 3, 2]));
  assert_eq([1, 2, 3].remove_first(9), None)
}

test "remove_at removes the element at an index, and any other index removes nothing" {
  assert_eq([1, 2, 3].remove_at(0), [2, 3]);
  assert_eq([1, 2, 3].remove_at(1), [1, 3]);
  assert_eq([1, 2, 3].remove_at(2), [1, 2]);
  assert_eq([1, 2, 3].remove_at(3), [1, 2, 3]);
  assert_eq([1, 2, 3].remove_at(0 - 1), [1, 2, 3]);
  assert_eq([1].remove_at(0), []);
  assert_eq([].remove_at(0), [])
}

test "`scan` returns the running result after each element, and `fold_right` folds from the last element to the first" {
  assert_eq(scan([1, 2, 3], 0, |accumulator: Int, x: Int| accumulator + x), [1, 3, 6]);
  assert_eq(scan([1, 2, 3], "", |accumulator: String, x: Int| accumulator ++ x.to_string()), [
    "1",
    "12",
    "123",
  ]);
  assert_eq(scan([5], 10, |accumulator: Int, x: Int| accumulator - x), [5]);
  assert_eq(scan([], 10, |accumulator: Int, x: Int| accumulator + x), []);
  assert_eq(
    [1, 2, 3].fold_right("", |x: Int, accumulator: String| accumulator ++ x.to_string()),
    "321",
  );
  assert_eq([1, 2, 3].fold_right(0, |x: Int, accumulator: Int| x - accumulator), 2);
  assert_eq([].fold_right(7, |x: Int, accumulator: Int| x - accumulator), 7)
}

test "max_of and min_of return the extremes, and an empty list has none" {
  assert_eq([3, 9, 4].max_of(), Some(9));
  assert_eq([].max_of(), None);
  assert_eq([3, 9, 4].min_of(), Some(3));
  assert_eq([].min_of(), None)
}

test "max_by and min_by return the first element with the extreme key, computing each key once" {
  let words = ["pear", "fig", "plum", "kiwi", "yam"];
  assert_eq(words.max_by(|w: String| w.len()), Some("pear"));
  assert_eq(words.min_by(|w: String| w.len()), Some("fig"));
  assert_eq(["one"].max_by(|w: String| w.len()), Some("one"));
  let none: List<String> = [];
  assert_eq(none.max_by(|w: String| w.len()), None);
  assert_eq(none.min_by(|w: String| w.len()), None);
  let result = handle {
    let least = words.min_by(|w: String| {
      asks.one();
      w.len()
    });
    { minimum_sizes: least, requested: asks.so_far() }
  } with {
    var n = 0,
    asks.one() -> {
      n = n + 1;
    },
    asks.so_far() -> n,
  };
  assert_eq(result, { minimum_sizes: Some("fig"), requested: 5 })
}

test "sort orders, and a long list exercises the merge rather than its base case" {
  assert_eq([3, 1, 2].sort(), [1, 2, 3]);
  assert_eq([].sort(), []);
  assert_eq([1].sort(), [1]);
  assert_eq([2, 1, 2, 1].sort(), [1, 1, 2, 2]);
  assert_eq(["b", "a", "c"].sort(), ["a", "b", "c"]);
  assert_eq(range(0, 100).reverse().sort(), range(0, 100));
  assert_eq(range(0, 100).sort(), range(0, 100));
  assert([5, 4, 3, 2, 1].sort().is_sorted());
  assert([].is_sorted());
  assert([1].is_sorted());
  assert([1, 1].is_sorted());
  assert(![1, 3, 2].is_sorted())
}

test "`sort_by` leaves equal elements in their original order, whether the comparison is `<` or `<=`" {
  let items = [
    { k: 2, tag: "a" },
    { k: 1, tag: "b" },
    { k: 1, tag: "c" },
    { k: 2, tag: "d" },
    { k: 1, tag: "e" },
  ];
  let sorted = [
    { k: 1, tag: "b" },
    { k: 1, tag: "c" },
    { k: 1, tag: "e" },
    { k: 2, tag: "a" },
    { k: 2, tag: "d" },
  ];
  assert_eq(
    items.sort_by(|l: { k: Int, tag: String }, r: { k: Int, tag: String }| l.k < r.k),
    sorted,
  );
  assert_eq(
    items.sort_by(|l: { k: Int, tag: String }, r: { k: Int, tag: String }| l.k <= r.k),
    sorted,
  );
  assert_eq([1, 3, 2].sort_by(|l: Int, r: Int| l > r), [3, 2, 1])
}

test "`sort_by_key` sorts by key, leaves elements with equal keys in their original order and computes each key once" {
  let words = ["pear", "fig", "plum", "kiwi", "yam", "a"];
  assert_eq(words.sort_by_key(|w: String| w.len()), ["a", "fig", "yam", "pear", "plum", "kiwi"]);
  let none: List<String> = [];
  assert_eq(none.sort_by_key(|w: String| w.len()), []);
  let result = handle {
    let sorted = [3, 1, 2, 1].sort_by_key(|n: Int| {
      asks.one();
      0 - n
    });
    { sorted: sorted, requested: asks.so_far() }
  } with {
    var n = 0,
    asks.one() -> {
      n = n + 1;
    },
    asks.so_far() -> n,
  };
  assert_eq(result, { sorted: [3, 2, 1, 1], requested: 4 })
}

test "`partition_point` returns the index where a list stops satisfying a predicate, using a binary search that skips most elements" {
  let below = |limit: Int| |x: Int| x < limit;
  assert_eq([1, 2, 3, 10, 11].partition_point(below(5)), 3);
  assert_eq([1, 2, 3].partition_point(below(0)), 0);
  assert_eq([1, 2, 3].partition_point(below(9)), 3);
  assert_eq([7].partition_point(below(9)), 1);
  assert_eq([7].partition_point(below(7)), 0);
  assert_eq([].partition_point(below(5)), 0);
  assert_eq(range(0, 9).map(|limit: Int| range(0, 7).partition_point(below(limit))), [
    0,
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    7,
  ]);
  let search_result = handle {
    let point = range(0, 1000).partition_point(|x: Int| {
      asks.one();
      x < 700
    });
    { point: point, requested: asks.so_far() }
  } with {
    var n = 0,
    asks.one() -> {
      n = n + 1;
    },
    asks.so_far() -> n,
  };
  assert_eq(search_result, { point: 700, requested: 10 })
}

test "a binary search returns the first equal element, or where the element would go" {
  let seek = |xs: List<Int>, x: Int| xs.binary_search(|y: Int| compare(y, x));
  assert_eq(seek([1, 3, 5, 7], 5), Ok(2));
  assert_eq(seek([1, 3, 5, 7], 1), Ok(0));
  assert_eq(seek([1, 3, 5, 7], 7), Ok(3));
  assert_eq(seek([1, 3, 5, 7], 0), Err(0));
  assert_eq(seek([1, 3, 5, 7], 4), Err(2));
  assert_eq(seek([1, 3, 5, 7], 9), Err(4));
  assert_eq(seek([2, 4, 4, 4, 6], 4), Ok(1));
  assert_eq(seek([4, 4, 4], 4), Ok(0));
  assert_eq(seek([], 4), Err(0));
  let rows = [{ id: 10, name: "a" }, { id: 20, name: "b" }, { id: 30, name: "c" }];
  assert_eq(rows.binary_search(|r: { id: Int, name: String }| compare(r.id, 20)), Ok(1));
  assert_eq(rows.binary_search(|r: { id: Int, name: String }| compare(r.id, 25)), Err(2))
}

test "`windows` returns every run of consecutive elements of the given size, and none when the size is zero, negative or above the list length" {
  assert_eq([1, 2, 3, 4].windows(2), [[1, 2], [2, 3], [3, 4]]);
  assert_eq([1, 2, 3].windows(3), [[1, 2, 3]]);
  assert_eq([1, 2, 3].windows(1), [[1], [2], [3]]);
  assert_eq([1, 2].windows(3), []);
  assert_eq([1, 2].windows(0), []);
  assert_eq([1, 2].windows(0 - 1), []);
  assert_eq([].windows(1), [])
}

test "partition, split_at and chunks divide the list, and keep the order" {
  assert_eq([1, 2, 3, 4].partition(|n: Int| n % 2 == 0), { yes: [2, 4], no: [1, 3] });
  assert_eq([].partition(|n: Int| n > 0), { yes: [], no: [] });
  assert_eq([1, 2, 3].split_at(1), { head: [1], tail: [2, 3] });
  assert_eq([1].split_at(9), { head: [1], tail: [] });
  assert_eq([1].split_at(0 - 1), { head: [], tail: [1] });
  assert_eq([1, 2, 3, 4, 5].chunks(2), [[1, 2], [3, 4], [5]]);
  assert_eq([1, 2].chunks(9), [[1, 2]]);
  assert_eq([].chunks(2), []);
  assert_eq([1, 2].chunks(0), [])
}

effect order {
  write saw(n: Int) -> Unit
}

test "partition calls its callback once on each element, in order" {
  let result = handle {
    [5, 1, 4].partition(|n: Int| {
      order.saw(n);
      n > 3
    })
  } with {
    var seen = 0,
    order.saw(n) -> {
      seen = seen * 10 + n;
    },
    return halves -> { halves: halves, requested: seen },
  };
  assert_eq(result, { halves: { yes: [5, 4], no: [1] }, requested: 514 })
}

test "chunk_by cuts where the key changes, so a key that comes again starts another run" {
  assert_eq([1, 3, 2, 4, 5].chunk_by(|n: Int| n % 2), [[1, 3], [2, 4], [5]]);
  assert_eq(["a", "b", "cc", "d"].chunk_by(|s: String| s.len()), [["a", "b"], ["cc"], ["d"]]);
  assert_eq([7].chunk_by(|n: Int| n), [[7]]);
  assert_eq([7, 7, 7].chunk_by(|n: Int| n), [[7, 7, 7]]);
  assert_eq([].chunk_by(|n: Int| n), []);
  let result = handle {
    let runs = [1, 1, 2].chunk_by(|n: Int| {
      asks.one();
      n
    });
    { runs: runs, requested: asks.so_far() }
  } with {
    var n = 0,
    asks.one() -> {
      n = n + 1;
    },
    asks.so_far() -> n,
  };
  assert_eq(result, { runs: [[1, 1], [2]], requested: 3 })
}

test "`flatten` joins the inner lists, `intersperse` puts a separator between elements, and `unique` keeps the first occurrence of each element" {
  assert_eq([[1, 2], [], [3]].flatten(), [1, 2, 3]);
  assert_eq([[]].flatten(), []);
  assert_eq(intersperse([1, 2, 3], 0), [1, 0, 2, 0, 3]);
  assert_eq(intersperse([1], 0), [1]);
  assert_eq(intersperse([], 0), []);
  assert_eq([3, 1, 3, 2, 1].unique(), [3, 1, 2]);
  assert_eq([].unique(), []);
  assert_eq(["b", "a", "b"].unique(), ["b", "a"])
}

test "`dedup` collapses each run of adjacent equal elements to one, but leaves equal elements that are not adjacent" {
  assert_eq(dedup([1, 1, 2, 2, 2, 1, 3, 3]), [1, 2, 1, 3]);
  assert_eq(dedup(["a"]), ["a"]);
  assert_eq(dedup([4, 4, 4]), [4]);
  let none: List<Int> = [];
  assert_eq(dedup(none), [])
}

test "interleave takes turns, and the longer list's rest follows" {
  assert_eq([1, 2, 3].interleave([7, 8, 9, 10, 11]), [1, 7, 2, 8, 3, 9, 10, 11]);
  assert_eq([7, 8, 9].interleave([1]), [7, 1, 8, 9]);
  assert_eq([1, 2].interleave([8, 9]), [1, 8, 2, 9]);
  assert_eq([].interleave([1, 2]), [1, 2]);
  assert_eq([1, 2].interleave([]), [1, 2]);
  let none: List<Int> = [];
  assert_eq(none.interleave(none), [])
}

test "`is_empty` tests for an empty list, `somes` returns the values inside `Some`, and `push_unique` appends only an element not yet present" {
  assert([].is_empty());
  assert(![0].is_empty());
  assert_eq(somes([Some(1), None, Some(3)]), [1, 3]);
  assert_eq(somes([None, None]), []);
  assert_eq([1, 2].push_unique(3), [1, 2, 3]);
  assert_eq([1, 2].push_unique(2), [1, 2])
}

test "prepend puts the element first" {
  assert_eq(prepend(0, [1, 2]), [0, 1, 2]);
  assert_eq(prepend(0, []), [0])
}

type Cut = { xs: List<Int>, n: Int }

type ListPair = { xs: List<Int>, ys: List<Int> }

fn parity(x: Int) -> Int = x & 1

fn below_eight(n: Int) -> Int = n & 7

fn cuts() -> gen::Gen<Cut> =
  gen::map2(gen::list(gen::any_int()), gen::any_int(), |xs: List<Int>, n: Int| { xs: xs, n: n })

fn list_pairs() -> gen::Gen<ListPair> =
  gen::map2(gen::list(gen::any_int()), gen::list(gen::any_int()), |xs: List<Int>, ys: List<Int>|
    { xs: xs, ys: ys })

test "concatenating `take(n)` and `drop(n)` of a list gives back the original list" {
  gen::check(cuts(), |x: Cut|
    agrees(|c: Cut| c.xs.take(c.n).concat(c.xs.drop(c.n)), |c: Cut| c.xs, x))
}

test "reversing twice is the list" {
  gen::check(gen::list(gen::any_int()), |x: List<Int>|
    inverse(|xs: List<Int>| xs.reverse(), |xs: List<Int>| xs.reverse(), x))
}

test "the chunks of a list flatten back to it" {
  gen::check(cuts(), |x: Cut|
    agrees(|c: Cut| c.xs.chunks(below_eight(c.n) + 1).flatten(), |c: Cut| c.xs, x))
}

test "unzip gives back what zip paired" {
  gen::check(list_pairs(), |x: ListPair|
    agrees(
      |t: ListPair| zip(t.xs, t.ys).unzip(),
      |t: ListPair|
        {
          firsts: t.xs.take(min(t.xs.len(), t.ys.len())),
          seconds: t.ys.take(min(t.xs.len(), t.ys.len())),
        },
      x,
    ))
}

test "`windows(n)` returns one list per start position where `n` elements fit, each equal to `slice(start, start + n)`" {
  gen::check(cuts(), |c: Cut| {
    let n = below_eight(c.n) + 1;
    let found = c.xs.windows(n);
    found.len() == max(c.xs.len() - n + 1, 0)
      && enumerate(found).all(|w: { index: Int, value: List<Int> }|
        w.value == c.xs.slice(w.index, w.index + n))
  })
}

test "`scan` returns the fold of every prefix of the list, so its last value equals the fold of the whole list" {
  gen::check(cuts(), |c: Cut| {
    let sums = scan(c.xs, c.n, |accumulator: Int, x: Int| accumulator ^ x);
    sums.len() == c.xs.len()
      && sums.last()
      == (if c.xs.is_empty() { None }
      else { Some(c.xs.fold(c.n, |accumulator: Int, x: Int| accumulator ^ x)) })
      && sums.take(below_eight(c.n))
      == scan(c.xs.take(below_eight(c.n)), c.n, |accumulator: Int, x: Int| accumulator ^ x)
  })
}

test "a list is sorted exactly when sorting leaves it as it is" {
  gen::check(gen::list(gen::any_int()), |x: List<Int>|
    agrees(|xs: List<Int>| xs.is_sorted(), |xs: List<Int>| xs.sort() == xs, x))
}

test "sort_by_key is the stable sort by the order of the keys" {
  gen::check(gen::list(gen::any_int()), |p: List<Int>|
    agrees(
      |xs: List<Int>| xs.sort_by_key(parity),
      |xs: List<Int>| xs.sort_by(|x: Int, y: Int| parity(x) < parity(y)),
      p,
    ))
}

test "on a sorted list, `partition_point` of `x < n` equals the number of elements less than `n`" {
  gen::check(cuts(), |p: Cut|
    agrees(
      |c: Cut| c.xs.sort().partition_point(|x: Int| x < c.n),
      |c: Cut| c.xs.count(|x: Int| x < c.n),
      p,
    ))
}

test "a binary search of a sorted list finds the first index of the element, or where it goes" {
  gen::check(cuts(), |p: Cut|
    agrees(
      |c: Cut| {
        let sorted = c.xs.map(below_eight).sort();
        sorted.binary_search(|x: Int| compare(x, below_eight(c.n)))
      },
      |c: Cut| {
        let sorted = c.xs.map(below_eight).sort();
        match sorted.index_of(below_eight(c.n)) {
          Some(i) -> Ok(i),
          None -> Err(sorted.count(|x: Int| x < below_eight(c.n))),
        }
      },
      p,
    ))
}

test "sorting the result of `unique` gives the same list as removing adjacent duplicates from the sorted list" {
  gen::check(gen::list(gen::any_int()), |x: List<Int>|
    agrees(
      |xs: List<Int>| xs.map(below_eight).unique().sort(),
      |xs: List<Int>| dedup(xs.map(below_eight).sort()),
      x,
    ))
}

test "sorted_unique is the sorted list without its repeats" {
  gen::check(gen::list(gen::any_int()), |x: List<Int>|
    agrees(
      |xs: List<Int>| sorted_unique(xs.map(below_eight)),
      |xs: List<Int>| dedup(xs.map(below_eight).sort()),
      x,
    ))
}

/// The total, which stops the program when a fixed-width total overflows. The empty list's total
/// is zero.
pub fn List::sum<a>(xs: List<a>) -> a
  where numeric(a)
= xs.fold(numeric_of_int(0), |s: a, x: a| s + x)

/// The product, which stops the program when a fixed-width product overflows. The empty list's
/// product is one.
pub fn List::product<a>(xs: List<a>) -> a
  where numeric(a)
= xs.fold(numeric_of_int(1), |p: a, x: a| p * x)

/// The elements of `xs` grouped under the key `key_of` returns for each. A key's elements keep
/// their order, wherever they are in `xs`. `List::chunk_by` is the one that splits runs of
/// neighbours.
pub fn List::group_by<a, k | e>(xs: List<a>, key_of: (a) -> k / e) -> Map<k, List<a>> / e
  where derivable(ord, k)
= group_by_from(xs, 0, Map::new(), key_of)

fn group_by_from<a, k | e>(
  xs: List<a>,
  i: Int,
  accumulator: Map<k, List<a>>,
  key_of: (a) -> k / e,
) -> Map<k, List<a>> / e
  where derivable(ord, k)
=
  match xs.at(i) {
    None -> accumulator,
    Some(x) -> {
      let key = key_of(x);
      group_by_from(
        xs,
        i + 1,
        if accumulator.contains(key) { accumulator.update(key, |group: List<a>| group.push(x)) }
        else { accumulator.insert(key, [x]) },
        key_of,
      )
    },
  }

/// Returns a map from each key to an element of `xs` that `key_of` gives that key. When several
/// elements have the same key, the map contains the last of them.
pub fn List::index_by<a, k | e>(xs: List<a>, key_of: (a) -> k / e) -> Map<k, a> / e
  where derivable(ord, k)
= index_by_from(xs, 0, Map::new(), key_of)

fn index_by_from<a, k | e>(
  xs: List<a>,
  i: Int,
  accumulator: Map<k, a>,
  key_of: (a) -> k / e,
) -> Map<k, a> / e
  where derivable(ord, k)
=
  match xs.at(i) {
    None -> accumulator,
    Some(x) -> index_by_from(xs, i + 1, accumulator.insert(key_of(x), x), key_of),
  }

/// Returns a map from each key to the number of elements of `xs` that `key_of` gives that key. A
/// key that `key_of` gives to no element is absent from the map; it does not map to 0.
pub fn List::count_by<a, k | e>(xs: List<a>, key_of: (a) -> k / e) -> Map<k, Int> / e
  where derivable(ord, k)
= tallied(xs, 0, Map::new(), key_of)

fn tallied<a, k | e>(
  xs: List<a>,
  i: Int,
  accumulator: Map<k, Int>,
  key_of: (a) -> k / e,
) -> Map<k, Int> / e
  where derivable(ord, k)
=
  match xs.at(i) {
    None -> accumulator,
    Some(x) -> {
      let key = key_of(x);
      tallied(
        xs,
        i + 1,
        if accumulator.contains(key) { accumulator.update(key, |times: Int| times + 1) }
        else { accumulator.insert(key, 1) },
        key_of,
      )
    },
  }

/// How many times each element of `xs` occurs.
pub fn List::frequencies<a>(xs: List<a>) -> Map<a, Int>
  where derivable(ord, a)
= xs.count_by(|x: a| x)

test "`sum` and `product` of a list work for any numeric type, and give 0 and 1 for an empty list" {
  assert_eq([1, 2, 3].sum(), 6);
  assert_eq([250u8, 5u8].sum(), 255u8);
  assert_eq([1.5m, 2.25m].sum(), 3.75m);
  assert_eq([0.5, 0.25].sum(), 0.75);
  assert_eq(range(0, 4).map(|i: Int| U32::of_int(i)).sum(), 6u32);
  assert_eq([2, 3, 4].product(), 24);
  assert_eq([2u16, 300u16].product(), 600u16);
  let none: List<Int> = [];
  assert_eq(none.sum(), 0);
  let nothing: List<Float> = [];
  assert_eq(nothing.product(), 1.0)
}

test "`group_by` collects the elements for each key in order, `index_by` keeps the last element for each key, and `count_by` and `frequencies` count elements per key" {
  let tens = |n: Int| n / 10;
  assert_eq([5, 12, 7, 20, 31].group_by(tens).entries(), [
    { key: 0, value: [5, 7] },
    { key: 1, value: [12] },
    { key: 2, value: [20] },
    { key: 3, value: [31] },
  ]);
  assert_eq([5, 12, 7, 20, 31].index_by(tens).entries(), [
    { key: 0, value: 7 },
    { key: 1, value: 12 },
    { key: 2, value: 20 },
    { key: 3, value: 31 },
  ]);
  assert_eq([5, 12, 7, 20, 31].count_by(tens).entries(), [
    { key: 0, value: 2 },
    { key: 1, value: 1 },
    { key: 2, value: 1 },
    { key: 3, value: 1 },
  ]);
  assert_eq(["b", "a", "b", "b"].frequencies().entries(), [
    { key: "a", value: 1 },
    { key: "b", value: 3 },
  ]);
  let none: List<Int> = [];
  assert_eq(none.group_by(tens), Map::new());
  assert_eq(none.index_by(tens), Map::new());
  assert_eq(none.count_by(tens), Map::new());
  assert_eq(none.frequencies(), Map::new())
}
