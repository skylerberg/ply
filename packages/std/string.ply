//! String operations that the prelude does not provide.
//!
//! The prelude has the basic operations (`String::len`, `String::slice`, `String::split`,
//! `String::find`, `String::contains`) but not `String::join` or `String::replace`. This module
//! adds those and more. A `String` is characters, not bytes, so a slice here never splits a
//! character. `String::replace` with an empty needle returns the text unchanged rather than
//! looping. `std.bytes.join` is `String::join` for `Bytes`.
//!
//! There are two kinds of case mapping, each with its own name. `String::ascii_lower` and
//! `String::ascii_upper` change only `A-Z` and `a-z` and leave every other character as it is. Use
//! them for a name that a protocol compares without case. `std.unicode`'s `lowercase` and
//! `uppercase` map by Unicode's tables. Use them for text a person reads, and never for a name that
//! is compared, since they map some characters outside ASCII onto ASCII letters (`lowercase` of the
//! Kelvin sign `U+212A` is `k`).
//!
//! There are also two kinds of trim. `String::ascii_trim` removes spaces, tabs, line feeds and
//! carriage returns, which is what surrounds a token in a protocol's text. The prelude's
//! `String::trim` removes every character Unicode calls white space, including the no-break space.
//! Use it for text a person wrote, and never for a token, since another reader of the same bytes
//! may not trim it the same way.

import std.bytes
import std.list
import std.gen

/// The parts joined, with `sep` between each pair and nowhere else.
pub fn String::join(parts: List<String>, sep: String) -> String =
  match parts {
    [] -> "",
    [first, ..rest] ->
      rest.fold(first, |accumulator: String, part: String| accumulator ++ sep ++ part),
  }

/// Whether the text has no characters.
pub fn String::is_empty(text: String) -> Bool = text.len() == 0

/// `text` with every occurrence of `from` replaced by `to`. An empty `from` returns the text
/// unchanged, since it occurs at every position and replacing it there has no well-defined result.
pub fn String::replace(text: String, from: String, to: String) -> String =
  if from.len() == 0 { text } else { String::join(text.split(from), to) }

/// `text` with the first occurrence of `from` replaced by `to`.
pub fn String::replace_first(text: String, from: String, to: String) -> String / {abort.raise} =
  if from.len() == 0 { text } else {
    match text.split_once(from) { None -> text, Some(split) -> split.head ++ to ++ split.tail }
  }

/// The text before and after the first `sep`, or `None` if `sep` is not in it.
pub fn String::split_once(
  text: String,
  sep: String,
) -> Option<{ head: String, tail: String }> / {abort.raise} =
  if text.contains(sep) {
    let at = text.find(sep);
    Some({ head: text.slice(0, at), tail: text.slice(at + sep.len(), text.len()) })
  } else { None }

/// `text` without the spaces, tabs, line feeds and carriage returns at either end. Other white
/// space stays. This is the trim for a token or a value in a protocol's text.
pub fn String::ascii_trim(text: String) -> String = text.ascii_trim_end().ascii_trim_start()

/// `text` without the spaces, tabs, line feeds and carriage returns it starts with.
pub fn String::ascii_trim_start(text: String) -> String =
  if leads_blank(text) { String::of_chars(text.chars().drop_while(is_blank)) } else { text }

/// `text` without the spaces, tabs, line feeds and carriage returns it ends with.
pub fn String::ascii_trim_end(text: String) -> String =
  if ends_blank(text) { String::of_chars(text.chars().reverse().drop_while(is_blank).reverse()) }
  else { text }

/// `text` with each of `A` to `Z` lower-cased and every other character unchanged, including
/// letters outside ASCII, so the result is as long as `text`. This is the case mapping for a name a
/// protocol compares without case, such as a header name, a scheme, a host or a hex digit.
pub fn String::ascii_lower(text: String) -> String
  cost text.len()
= String::of_chars(ascii_lower_chars(text))

/// `text` with each of `a` to `z` upper-cased and every other character unchanged, as in
/// `String::ascii_lower`.
pub fn String::ascii_upper(text: String) -> String
  cost text.len()
= String::of_chars(ascii_upper_chars(text))

/// Whether two texts differ at most in the case of the letters `A` to `Z`.
pub fn String::eq_ignore_ascii_case(a: String, b: String) -> Bool =
  a.ascii_lower() == b.ascii_lower()

/// `text` repeated `n` times, or the empty string when `n` is zero or less.
pub fn String::repeat(text: String, n: Int) -> String =
  range(0, if n > 0 { n } else { 0 }).fold("", |accumulator: String, _: Int| accumulator ++ text)

/// `text` padded on the left with copies of `fill` until it is at least `width` characters. The
/// last copy is whole, so the result can be longer than `width`. An empty `fill`, or a `text`
/// already at least `width` long, returns `text` unchanged.
pub fn String::pad_left(text: String, width: Int, fill: String) -> String =
  padding(text, width, fill) ++ text

/// `text` padded on the right, as `String::pad_left` pads on the left.
pub fn String::pad_right(text: String, width: Int, fill: String) -> String =
  text ++ padding(text, width, fill)

fn padding(text: String, width: Int, fill: String) -> String = {
  let missing = width - text.len();
  range(0, if missing > 0 { missing } else { 0 }).fold("", |accumulator: String, _: Int|
    if accumulator.len() >= missing { accumulator } else { accumulator ++ fill })
}

/// Returns the character index where `needle` first occurs in `text`, or `None` when `needle` does
/// not occur.
pub fn String::index_of(text: String, needle: String) -> Option<Int> / {abort.raise} =
  if text.contains(needle) { Some(text.find(needle)) } else { None }

/// `text` without `suffix` at its end, or `text` unchanged when it does not end with `suffix`.
pub fn String::strip_suffix(text: String, suffix: String) -> String / {abort.raise} =
  if text.ends_with(suffix) { text.slice(0, text.len() - suffix.len()) } else { text }

/// Each of `rows` followed by a newline.
pub fn String::unlines(rows: List<String>) -> String =
  rows.fold("", |accumulator: String, row: String| accumulator ++ row ++ "\n")

/// The lines of `text`, split on `\n`, with one trailing `\r` removed from each line so CRLF text
/// reads like LF text. The empty text has no lines, not one empty line.
pub fn String::lines(text: String) -> List<String> / {abort.raise} =
  if text.is_empty() { [] } else { text.split("\n").map(|line: String| without_cr(line)) }

/// The runs of characters that are not spaces, tabs or newlines, in order. There is never an
/// empty word, and an all-whitespace text has none.
pub fn String::words(text: String) -> List<String> / {abort.raise} = words_from(text, 0, "", [])

/// How many times `needle` occurs in `text`, without overlaps. An empty needle occurs zero times.
pub fn String::count(text: String, needle: String) -> Int / {abort.raise} =
  if needle.is_empty() { 0 } else { text.split(needle).len() - 1 }

/// `text` with its first character upper-cased as `String::ascii_upper` does, and the rest
/// unchanged. An empty text stays empty.
pub fn String::capitalize(text: String) -> String =
  match text.chars() {
    [] -> "",
    [head, ..tail] -> String::of_chars([upper_char(head)]) ++ String::of_chars(tail),
  }

fn without_cr(line: String) -> String / {abort.raise} =
  if line.ends_with("\r") { line.slice(0, line.len() - 1) } else { line }

fn words_from(
  text: String,
  at: Int,
  current: String,
  out: List<String>,
) -> List<String> / {abort.raise} =
  if at >= text.len() { if current.is_empty() { out } else { out.push(current) } } else {
    let c = text.slice(at, at + 1);
    if is_space(c) {
      if current.is_empty() { words_from(text, at + 1, "", out) }
      else { words_from(text, at + 1, "", out.push(current)) }
    } else { words_from(text, at + 1, current ++ c, out) }
  }

fn is_space(c: String) -> Bool = " \t\n\r".contains(c)

fn is_blank(c: Char) -> Bool = c == ' ' || c == '\t' || c == '\n' || c == '\r'

fn leads_blank(text: String) -> Bool =
  text.starts_with(" ") || text.starts_with("\t") || text.starts_with("\n")
    || text.starts_with("\r")

fn ends_blank(text: String) -> Bool =
  text.ends_with(" ") || text.ends_with("\t") || text.ends_with("\n") || text.ends_with("\r")

/// Whether every character of `text` is ASCII.
pub fn String::is_ascii(text: String) -> Bool = Bytes::of_string(text).len() == text.len()

fn ascii_lower_chars(text: String) -> List<Char> = text.chars().map(lower_char)

fn ascii_upper_chars(text: String) -> List<Char> = text.chars().map(upper_char)

fn lower_char(c: Char) -> Char = if c >= 'A' && c <= 'Z' { shifted(c, 32) } else { c }

fn upper_char(c: Char) -> Char = if c >= 'a' && c <= 'z' { shifted(c, -32) } else { c }

fn shifted(c: Char, by: Int) -> Char =
  match Char::of_int(Int::of_char(c) + by) { Some(other) -> other, None -> c }

test "strip_suffix takes one suffix off, and unlines ends each row" {
  assert_eq("line\n".strip_suffix("\n"), "line");
  assert_eq("line".strip_suffix("\n"), "line");
  assert_eq("aa".strip_suffix("a"), "a");
  assert_eq(String::unlines(["a", "b"]), "a\nb\n");
  assert_eq(String::unlines([]), "")
}

test "join puts the separator between and nowhere else" {
  assert_eq(String::join([], ", "), "");
  assert_eq(String::join(["a"], ", "), "a");
  assert_eq(String::join(["a", "b", "c"], ", "), "a, b, c");
  assert_eq(String::join(["", ""], "-"), "-");
  assert_eq(String::join(["a", ""], "-"), "a-")
}

test "replace changes every occurrence and replace_first changes one" {
  assert_eq("a-b-c".replace("-", "+"), "a+b+c");
  assert_eq("abc".replace("x", "+"), "abc");
  assert_eq("abc".replace("", "+"), "abc");
  assert_eq("aaa".replace("aa", "b"), "ba");
  assert_eq("a-b-c".replace_first("-", "+"), "a+b-c");
  assert_eq("abc".replace_first("-", "+"), "abc");
  assert_eq("a=b".split_once("="), Some({ head: "a", tail: "b" }));
  assert_eq("a=b=c".split_once("="), Some({ head: "a", tail: "b=c" }));
  assert_eq("ab".split_once("="), None)
}

test "the ASCII trim removes spaces, tabs, line feeds and carriage returns, and nothing else" {
  assert_eq("  x \n".ascii_trim(), "x");
  assert_eq("   ".ascii_trim(), "");
  assert_eq("  x ".ascii_trim_start(), "x ");
  assert_eq("  x ".ascii_trim_end(), "  x");
  assert_eq("\t\r\n".ascii_trim(), "");
  assert_eq("".ascii_trim(), "");
  assert_eq(" a b ".ascii_trim(), "a b");
  assert_eq("\u{b}x\u{c}".ascii_trim(), "\u{b}x\u{c}")
}

test "`ascii_trim` does not remove white space outside ASCII, but `trim` removes it" {
  let spaced = "\u{a0}chunked\u{2003}";
  assert_eq(spaced.ascii_trim(), spaced);
  assert_eq(spaced.trim(), "chunked");
  assert_eq(String::ascii_trim(" " ++ spaced ++ "\t"), spaced);
  assert_eq("\u{85}x\u{3000}".ascii_trim(), "\u{85}x\u{3000}");
  assert_eq("\u{85}x\u{3000}".trim(), "x")
}

law "for each code point below 256, `ascii_trim` removes only a space, tab, line feed or carriage return"
  forall (b: U8) {
    let n = Int::of_u8(b);
    one(n).ascii_trim() == (if n == 32 || n == 9 || n == 10 || n == 13 { "" } else { one(n) })
      && String::ascii_trim("a" ++ one(n) ++ "b") == "a" ++ one(n) ++ "b"
  }

test "`ascii_trim` removes only blanks from the ends of a string, and no blank remains at either end" {
  gen::check3(gen::any_int(), gen::text(), gen::any_int(), |lead: Int, middle: String, tail: Int| {
    let text = " \t\r\n".repeat(lead & 3) ++ middle ++ "\n \t".repeat(tail & 3);
    let whole = text.chars();
    let led = whole.len() - text.ascii_trim_start().len();
    let trimmed_length = text.ascii_trim_end().len();
    text.ends_with(text.ascii_trim_start()) && whole.take(led).all(is_blank)
      && !leads_blank(text.ascii_trim_start())
      && text.starts_with(text.ascii_trim_end())
      && whole.drop(trimmed_length).all(is_blank)
      && !ends_blank(text.ascii_trim_end())
      && text.ascii_trim() == text.ascii_trim_start().ascii_trim_end()
  })
}

test "the ASCII case mapping changes `A-Z` and `a-z`, and leaves every other character as it is" {
  assert_eq("AbC1 É".ascii_lower(), "abc1 É");
  assert_eq("AbC1 é".ascii_upper(), "ABC1 é");
  assert_eq("@[`{".ascii_lower(), "@[`{");
  assert_eq("@[`{".ascii_upper(), "@[`{");
  assert_eq("".ascii_lower(), "");
  assert_eq("".ascii_upper(), "")
}

test "texts are equal ignoring ASCII case where only `A-Z` and `a-z` differ" {
  assert("Content-Length".eq_ignore_ascii_case("content-length"));
  assert("".eq_ignore_ascii_case(""));
  assert(!"content-length".eq_ignore_ascii_case("content-length "));
  assert(!"\u{212A}".eq_ignore_ascii_case("k"));
  assert(!"É".eq_ignore_ascii_case("é"))
}

fn one(n: Int) -> String = match Char::of_int(n) { Some(c) -> String::of_chars([c]), None -> "" }

law "for each code point below 256, `ascii_lower` lowercases `A-Z` and leaves every other character unchanged"
  forall (b: U8) {
    let n = Int::of_u8(b);
    one(n).ascii_lower() == one(if n >= 65 && n <= 90 { n + 32 } else { n })
  }

law "for each code point below 256, `ascii_upper` uppercases `a-z` and leaves every other character unchanged"
  forall (b: U8) {
    let n = Int::of_u8(b);
    one(n).ascii_upper() == one(if n >= 97 && n <= 122 { n - 32 } else { n })
  }

test "texts are equal ignoring ASCII case exactly where their upper cases are equal" {
  gen::check2(gen::text(), gen::text(), |a: String, b: String| {
    a.eq_ignore_ascii_case(b) == (a.ascii_upper() == b.ascii_upper())
      && a.eq_ignore_ascii_case(a.ascii_upper())
  })
}

test "repeat and pad are total, and both treat a width of zero as the text" {
  assert_eq("ab".repeat(3), "ababab");
  assert_eq("ab".repeat(0), "");
  assert_eq("ab".repeat(0 - 2), "");
  assert_eq("7".pad_left(3, "0"), "007");
  assert_eq("7".pad_left(1, "0"), "7");
  assert_eq("7".pad_left(3, ""), "7");
  assert_eq("7".pad_right(3, "."), "7..");
  assert("".is_empty());
  assert(!"x".is_empty())
}

test "`split` returns the pieces between separators, `contains`, `starts_with` and `ends_with` return true or false, and `index_of` returns the first position or `None`" {
  assert_eq("a-b-c".split("-"), ["a", "b", "c"]);
  assert_eq("".split("-"), [""]);
  assert("abc".contains("b"));
  assert(!"abc".contains("z"));
  assert("abc".contains(""));
  assert("abc".starts_with("ab"));
  assert(!"abc".starts_with("b"));
  assert("abc".ends_with("bc"));
  assert(!"abc".ends_with("b"));
  assert_eq("a-b".index_of("-"), Some(1));
  assert_eq("abc".index_of("z"), None)
}

test "chars are a text's scalar values, and they rebuild it" {
  assert_eq("aé😀".chars(), ['a', 'é', '😀']);
  assert_eq("e\u{301}".chars(), ['e', '\u{301}']);
  assert_eq("".chars(), []);
  assert_eq(String::of_chars(['a', 'é', '😀']), "aé😀");
  assert_eq(String::of_chars([]), "");
  assert_eq(String::of_chars("plié".chars().reverse()), "éilp")
}

test "lines removes the newline and one carriage return before it" {
  assert_eq("a\nb".lines(), ["a", "b"]);
  assert_eq("a\r\nb\r\n".lines(), ["a", "b", ""]);
  assert_eq("a".lines(), ["a"]);
  assert_eq("".lines(), []);
  assert_eq("\n".lines(), ["", ""])
}

test "words are the runs that are not whitespace, and never empty" {
  assert_eq("  a  bb\tc\n d ".words(), ["a", "bb", "c", "d"]);
  assert_eq("".words(), []);
  assert_eq("   \t\n".words(), []);
  assert_eq("one".words(), ["one"])
}

test "`count` does not count overlapping matches, and `capitalize` changes only the first character" {
  assert_eq("aaa".count("a"), 3);
  assert_eq("aaa".count("aa"), 1);
  assert_eq("abc".count("z"), 0);
  assert_eq("abc".count(""), 0);
  assert_eq("".count("a"), 0);
  assert_eq("abc".capitalize(), "Abc");
  assert_eq("ABC".capitalize(), "ABC");
  assert_eq("".capitalize(), "")
}

/// Reads a decimal integer: an optional `-`, then digits, and nothing else. Returns `None` for any
/// other text, and for a number too large for an `Int`.
pub fn String::int_of_string(text: String) -> Option<Int> / {abort.raise} =
  Bytes::of_string(text).int_of_ascii()

/// Each character's Unicode scalar value, in order.
pub fn String::code_points(text: String) -> List<Int> / {abort.raise} =
  decoded(Bytes::of_string(text), 0, [])

/// The text with these scalar values, or `None` when one is negative, a surrogate or past
/// `U+10FFFF`.
pub fn String::of_code_points(points: List<Int>) -> Option<String> / {abort.raise} =
  if all_scalar(points) {
    Some(String::of_bytes(Bytes::concat_all(points.map(|c: Int| encode_utf8(c)))))
  } else { None }

fn all_scalar(points: List<Int>) -> Bool =
  points.fold(true, |ok: Bool, c: Int| ok && c >= 0 && c <= 0x10FFFF && (c < 0xD800 || c > 0xDFFF))

fn decoded(b: Bytes, i: Int, accumulator: List<Int>) -> List<Int> / {abort.raise} =
  if i >= b.len() { accumulator } else {
    let lead = b.at(i);
    if lead < 0x80 { decoded(b, i + 1, accumulator.push(lead)) } else if lead < 0xE0 {
      decoded(b, i + 2, accumulator.push((lead & 0x1F) << 6 | continuation(b, i + 1)))
    } else if lead < 0xF0 {
      decoded(
        b,
        i + 3,
        accumulator.push(
          (lead & 0x0F) << 12 | continuation(b, i + 1) << 6 | continuation(b, i + 2),
        ),
      )
    } else {
      decoded(
        b,
        i + 4,
        accumulator.push(
          (lead & 0x07) << 18 | continuation(b, i + 1) << 12 | continuation(b, i + 2) << 6
            | continuation(b, i + 3),
        ),
      )
    }
  }

fn continuation(b: Bytes, i: Int) -> Int / {abort.raise} = b.at(i) & 0x3F

fn encode_utf8(c: Int) -> Bytes / {abort.raise} =
  if c < 0x80 { byte_of_int(c) }
  else if c < 0x800 { byte_of_int(0xC0 | c >> 6).concat(continuation_byte(c, 0)) }
  else if c < 0x10000 {
    Bytes::concat_all([
      byte_of_int(0xE0 | c >> 12),
      continuation_byte(c, 6),
      continuation_byte(c, 0),
    ])
  } else {
    Bytes::concat_all([
      byte_of_int(0xF0 | c >> 18),
      continuation_byte(c, 12),
      continuation_byte(c, 6),
      continuation_byte(c, 0),
    ])
  }

fn continuation_byte(c: Int, shift: Int) -> Bytes = byte_of_int(0x80 | c >> shift & 0x3F)

test "int_of_string reads a signed decimal and rejects anything else" {
  assert_eq("-17".int_of_string(), Some(0 - 17));
  assert_eq("17".int_of_string(), Some(17));
  assert_eq("7.5".int_of_string(), None);
  assert_eq("".int_of_string(), None)
}

test "code points are each character's scalar value, and they rebuild the text" {
  assert_eq("ab".code_points(), [97, 98]);
  assert_eq("é€😀".code_points(), [0xE9, 0x20AC, 0x1F600]);
  assert_eq("".code_points(), []);
  assert_eq(String::of_code_points([104, 0xE9, 0x20AC, 0x1F600]), Some("hé€😀"));
  assert_eq(String::of_code_points("mixed é text".code_points()), Some("mixed é text"));
  assert_eq(String::of_code_points([]), Some(""))
}

test "`String::of_code_points` returns `None` for a surrogate, a negative number or a value above U+10FFFF" {
  assert_eq(String::of_code_points([0xD800]), None);
  assert_eq(String::of_code_points([0xDFFF]), None);
  assert_eq(String::of_code_points([0 - 1]), None);
  assert_eq(String::of_code_points([0x110000]), None);
  assert(String::of_code_points([0x10FFFF]) != None)
}
