//! The `semver_range">=1.2, <2"` literal: a `std.semver` range, checked at compile time.
//!
//! A literal's tag names a module. `std.semver` is already the tag for a version, so a range needs
//! a module of its own. The `Range` type and its functions live in `std.semver`.

import std.result
import std.semver (Range, parse_range, range_literal)

/// Checks a `semver_range"..."` literal. Returns the range that `std.semver`'s `parse_range`
/// reads, or an error message and the offset of the character where the text stops being a range.
pub fn literal(text: String) -> Result<Range, { message: String, offset: Int }> / {abort.raise} =
  range_literal(text)

// --- Tests ------------------------------------------------------------------

test "the check returns the range, or where the text stops being one" {
  assert_eq(literal(">=1.0 <2.0").ok(), parse_range(">=1.0, <2.0").ok());
  assert_eq(literal("*").ok(), Some(Range([])));
  assert_eq(literal("1.*.1"), Err({ message: "only a `*` follows a `*`", offset: 4 }));
  assert_eq(literal("1.2.3 - 2.0.0"), Err({ message: "a count goes here", offset: 6 }))
}
