//! The cryptographic natives the toolchain implements, which `std.crypto` and `std.ed25519` are
//! written over.

/// `plaintext` sealed under a 32-byte key and a nonce, bound to `associated`: the ciphertext and
/// then its 16-byte tag. `cipher` is `"aes-256-gcm"` or `"chacha20-poly1305"`, whose nonce is 12
/// bytes, or `"xchacha20-poly1305"`, whose nonce is 24. Raises for any other cipher or length.
/// Sealing two messages under one key and nonce gives both away: `std.crypto` is what keeps a
/// nonce from being used twice.
pub extern fn crypto_seal(
  cipher: String,
  key: Secret<Bytes>,
  nonce: Bytes,
  associated: Bytes,
  plaintext: Bytes,
) -> Bytes / {abort.raise}

/// What `crypto_seal` sealed; `None` when the key, the nonce, `associated` or a byte of `sealed`
/// is not what it was sealed with. Raises as `crypto_seal` does.
pub extern fn crypto_open(
  cipher: String,
  key: Secret<Bytes>,
  nonce: Bytes,
  associated: Bytes,
  sealed: Bytes,
) -> Option<Bytes> / {abort.raise}

/// A private key's public key. `scheme` is `"ed25519"` (a 32-byte seed to 32 bytes), `"x25519"`
/// (32 bytes to 32), `"p256"`, `"p384"`, `"p521"` or `"k256"` (a big-endian scalar of 32, 48, 66
/// or 32 bytes to the uncompressed point) or `"rsa"` (a PKCS #8 or PKCS #1 document, of 2048 to
/// 4096 bits, to its PKCS #1 public key). `None` for a key that is none of its scheme; raises for
/// any other scheme.
pub extern fn crypto_public(scheme: String, key: Secret<Bytes>) -> Option<Bytes> / {abort.raise}

/// A signature over `message`, a function of the key and the message alone. `scheme` is
/// `"ed25519"` (RFC 8032, 64 bytes); `"ecdsa-p256-sha256"`, `"ecdsa-p384-sha384"`,
/// `"ecdsa-p521-sha512"` or `"ecdsa-k256-sha256"` (the nonce RFC 6979's, the signature `r` then
/// `s`, each as long as the curve's scalar, and on secp256k1 `s` in the low half); or
/// `"rsa-pkcs1-sha256"`, `-sha384`, `-sha512`, `"rsa-pss-sha256"`, `-sha384` or `-sha512` (a salt
/// as long as the digest, HMAC under the key of the message's digest, so the signature too is a
/// function of the two). The keys are `crypto_public`'s; `None` for one that is none of its
/// scheme, and raises for any other scheme.
pub extern fn crypto_sign(
  scheme: String,
  key: Secret<Bytes>,
  message: Bytes,
) -> Option<Bytes> / {abort.raise}

/// Whether `signature` is `message` signed by the key `public` is, under `crypto_sign`'s schemes
/// (a PSS salt of any value), but for `"ecdsa-p384-sha384"`, whose signature is DER here, as it is
/// for `"ecdsa-p256-sha384"` and `"ecdsa-p384-sha256"`; every ECDSA key is the uncompressed point,
/// and a secp256k1 `s` in the high half is taken as its low twin. `false` for a key or a
/// signature that is not one: an Ed25519 `S` at or past the group order, an ECDSA `r` or `s` out
/// of range, a point off the curve, an RSA key under 2048 bits. Raises for any other scheme.
pub extern fn crypto_verify(
  scheme: String,
  public: Bytes,
  message: Bytes,
  signature: Bytes,
) -> Bool / {abort.raise}

/// The secret two keys share: `"x25519"` (RFC 7748) or `"p256"` (the shared point's 32-byte `x`).
/// `None` for a key that is none of its scheme, a peer that is no point of the curve, and an
/// X25519 result of all zeros. Raises for any other scheme. What it answers is not uniform: derive
/// keys from it with HKDF.
pub extern fn crypto_agree(
  scheme: String,
  key: Secret<Bytes>,
  peer: Bytes,
) -> Option<Secret<Bytes>> / {abort.raise}
