//! Effects for the toolchain's natives, which read the machine a program runs on. A function whose
//! effects name `native.read` queries the machine through a native, so nothing treats its
//! result as a function of its arguments alone. The effect has no operations and nothing handles
//! it. An effect's host handler (`host for`) names it next to the effect it handles, and the roots
//! that run under that handler never see it.
//!
//! A native that would block the program's thread passes its work to the runtime and returns a
//! ticket, and `job_wait` reads the work's bytes by that ticket. A native returns structured data
//! in one of the flat forms that `told`, `found` and `parts` decode. `encode_parts` writes the form
//! a native reads as parts. A host handler records what it read of a root with `observed`, and
//! tests check those records.

/// Querying the machine through a native.
pub nondet effect native {}

/// Waiting for work the machine does off the program's thread. Only `job_wait` performs it. A
/// function whose effects include it may wait on a ticket, and `ply hosts` reports a host handler's
/// clause with it as blocking.
pub nondet effect wait {}

/// Returns the bytes produced by the work of `ticket`. Inside a production scheduler the task waits
/// for them while the other tasks run; outside one the thread waits. If the work failed,
/// the run ends with a message naming what requested it.
pub extern fn job_wait(ticket: Int) -> Bytes / {native.read, wait.read}

/// Records what the calling run's host handler read or wrote at `path` under the root named
/// `label`. The record exists only when a test observes the run. `kind` is what was accessed: 0
/// a file's bytes, 1 a directory's names, 2 what is there, 3 every path below, and 4 a write. With
/// `label` empty, it is about what the binary ships: 5 the shipped module named by `path` (every
/// module's name when `path` is empty), 6 the program the launcher started, and 7 and 8 a load's
/// view `path` of the shipped modules it reached, where 7 means the load pulled them itself. A real
/// handler calls this in the clause that reads, so a read that a test's own handler handles is
/// never recorded.
pub extern fn observed(label: String, path: String, kind: Int) -> Unit / {native.read}

/// Decodes a native's reply that must succeed. After a leading byte 1, the result is the rest of
/// the bytes. After a leading byte 0, the rest is why the system could not report `what`, and the
/// run ends with that reason, since a program cannot run on a machine that cannot report it.
pub fn told(what: String, encoded: Bytes) -> Bytes / {abort.raise} = {
  let rest = encoded.slice(1, encoded.len());
  if encoded.at(0) == 1 { rest }
  else { panic("the system did not say " ++ what ++ ": " ++ String::of_bytes_lossy(rest)) }
}

/// Decodes a native's optional reply: the bytes after a leading byte 1, or `None` otherwise.
pub fn found(encoded: Bytes) -> Option<Bytes> =
  if encoded.len() > 0 && encoded.at(0) == 1 { Some(encoded.slice(1, encoded.len())) } else { None }

/// Splits a native's reply into its parts. Each part follows its length in four bytes, most
/// significant first. A truncated part at the end is dropped.
pub fn parts(encoded: Bytes) -> List<Bytes> / {abort.raise} =
  iterate({ at: 0, parts: [] }, encoded.len() + 1, |s: { at: Int, parts: List<Bytes> }|
    if s.at + 4 > encoded.len() { Stop(s.parts) } else {
      let count = ((encoded.at(s.at) * 256 + encoded.at(s.at + 1)) * 256 + encoded.at(s.at + 2))
        * 256
        + encoded.at(s.at + 3);
      let end = s.at + 4 + count;
      if end > encoded.len() { Stop(s.parts) }
      else { Continue({ at: end, parts: s.parts.push(encoded.slice(s.at + 4, end)) }) }
    })

/// Decodes an integer from eight bytes, most significant first. Returns 0 for any other length.
pub fn decode_int(flat: Bytes) -> Int =
  if flat.len() != 8 { 0 } else { range(0, 8).fold(0, |acc: Int, i: Int| acc << 8 | flat.at(i)) }

/// Joins `each` into the form a native reads as parts: each part after its length in four bytes,
/// most significant first. `parts` decodes it back.
pub fn encode_parts(each: List<Bytes>) -> Bytes =
  Bytes::concat_all(
    each.fold([], |acc: List<Bytes>, part: Bytes| acc.push(counted(part.len())).push(part)),
  )

/// `n` in four bytes, the most significant first.
fn counted(n: Int) -> Bytes =
  Bytes::concat_all([n >>> 24, n >>> 16, n >>> 8, n].map(|b: Int| byte_of_int(b & 0xFF)))

/// Decodes a native's optional reply as text. Bytes that are not UTF-8 are replaced.
pub fn found_text(reply: Bytes) -> Option<String> =
  match found(reply) { Some(t) -> Some(String::of_bytes_lossy(t)), None -> None }

/// Decodes a native's optional reply as an integer, read as `decode_int` reads one.
pub fn found_int(reply: Bytes) -> Option<Int> =
  match found(reply) { Some(n) -> Some(decode_int(n)), None -> None }

/// Joins `texts` into the form a native reads as parts, each text as its UTF-8 bytes.
pub fn encode_texts(texts: List<String>) -> Bytes =
  encode_parts(texts.map(|t: String| Bytes::of_string(t)))

test "a native's encoded replies decode to what was written" {
  assert_eq(parts(encode_parts([b"ab", b"", b"c"])), [b"ab", b"", b"c"]);
  assert_eq(encode_parts([]), b"");
  assert_eq(decode_int(b"\x00\x00\x00\x00\x00\x00\x01\x02"), 258);
  assert_eq(decode_int(b"\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFE"), -2);
  assert_eq(decode_int(b"\x01"), 0);
  assert_eq(told("its name", b"\x01Linux"), b"Linux");
  assert_eq(found(b"\x01ada"), Some(b"ada"));
  assert_eq(found(b"\x00"), None);
  assert_eq(found(b""), None);
  assert_eq(parts(b"\x00\x00\x00\x02ab\x00\x00\x00\x00\x00\x00\x00\x01c"), [b"ab", b"", b"c"]);
  assert_eq(parts(b""), []);
  assert_eq(
    try[abort.raise] { told("its name", b"\x00no such call") },
    Err("the system did not say its name: no such call"),
  )
}
