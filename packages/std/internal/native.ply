//! What the toolchain's natives read of the machine a program runs on, as an effect: a function
//! whose row names `native.read` asks the machine through one, so nothing takes its answer for a
//! function of its arguments. No operation is performed and nothing handles one: an effect's real
//! handler (`host for`) names it beside the effect it discharges, and the roots that run under the
//! handler never see it.
//!
//! A native that would hold the program's thread hands its work to the runtime and answers a
//! ticket, which `job_wait` reads the work's bytes by. What a native answers as structured text is
//! one of the flat forms `told`, `found` and `parts` read.

/// Asking the machine through a native.
pub nondet effect native {}

/// The bytes the work of `ticket` answered: inside a production region the task waits for them
/// while the region's other tasks run, and outside one the thread waits. Work that failed ends the
/// run, naming what asked for it.
pub extern fn job_wait(ticket: Int) -> Bytes / {native.read}

/// What a native told: the bytes after a leading byte 1, or, after a leading byte 0, why the system
/// said nothing, which ends the run naming `what`, since a machine that cannot say it is none a
/// program runs on.
pub fn told(what: String, said: Bytes) -> Bytes / {abort.raise} = {
  let rest = said.slice(1, said.len());
  if said.at(0) == 1 { rest }
  else { panic("the system did not say " ++ what ++ ": " ++ String::of_bytes_lossy(rest)) }
}

/// What a native found: the bytes after a leading byte 1, or none for the single byte 0.
pub fn found(said: Bytes) -> Option<Bytes> =
  if said.len() > 0 && said.at(0) == 1 { Some(said.slice(1, said.len())) } else { None }

/// The parts a native wrote one after another, each behind its count in four bytes, the most
/// significant first.
pub fn parts(said: Bytes) -> List<Bytes> / {abort.raise} =
  iterate({ at: 0, parts: [] }, said.len() + 1, |s: { at: Int, parts: List<Bytes> }|
    if s.at + 4 > said.len() { Stop(s.parts) } else {
      let count = ((said.at(s.at) * 256 + said.at(s.at + 1)) * 256 + said.at(s.at + 2)) * 256
        + said.at(s.at + 3);
      let end = s.at + 4 + count;
      if end > said.len() { Stop(s.parts) }
      else { Continue({ at: end, parts: s.parts.push(said.slice(s.at + 4, end)) }) }
    })

test "a native's flat answers read back as what it wrote" {
  assert_eq(told("its name", b"\x01Linux"), b"Linux");
  assert_eq(found(b"\x01ada"), Some(b"ada"));
  assert_eq(found(b"\x00"), None);
  assert_eq(found(b""), None);
  assert_eq(parts(b"\x00\x00\x00\x02ab\x00\x00\x00\x00\x00\x00\x00\x01c"), [b"ab", b"", b"c"]);
  assert_eq(parts(b""), []);
  assert_eq(
    try[abort.raise] { told("its name", b"\x00no such call") },
    Err("the system did not say its name: no such call"),
  )
}
