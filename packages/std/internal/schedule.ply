//! A scheduler as data: what its tasks wait on, how each request a task makes changes them, and
//! which task runs next. `simulate` takes its schedule from a seed and records each step. A
//! production scheduler runs ready tasks first in, first out, and waits on the run's tickets and
//! clock when none is ready. Nothing here switches a stack or reads the host: a scheduler's loop
//! passes in each request with what the runtime knows about it, and runs the task each turn names.
//!
//! Values one task passes to another (`v`) are stored without being inspected. A task's result is
//! not among them: the task's handle stores it, and the scheduler only tells a joiner that it is
//! there.

import std.bin
import std.internal.native (native)
import std.internal.trail as trail
import std.internal.trail (Trail, Site, nowhere, Access, Step, Read, Write, site_bin)
import std.list
import std.string

// --- Inputs and outputs ---------------------------------------------------------

/// How a scheduler picks what runs next: by the entry's seed, as `simulate` does (`Seeded`), or in
/// the order its tasks became ready, handling the host's operations as they come (`Production`).
pub type Policy = | Seeded | Production

/// How deep a task is inside brackets: the `acquire`s and `release`s it is inside, and whether a
/// cancel waits for it to leave them. The runtime tracks these, since a bracket is entered and
/// left without the scheduler.
pub type Shields = { acquiring: Int, releasing: Int, stopping: Bool }

/// Inside no bracket.
pub fn unshielded() -> Shields = { acquiring: 0, releasing: 0, stopping: false }

/// A task's handle as its owner reads it: the scheduler and the task it refers to, and how the task
/// ended if the handle has recorded that.
pub type TaskRef = { scheduler: Int, id: Int, ended: TaskStatus }

/// How a task ended, as its handle records it: not yet, with a result, or cancelled.
pub type TaskStatus = | Live | Returned | Cancelled

/// A channel's handle: its scheduler and its id there.
pub type ChanRef = { scheduler: Int, id: Int }

/// What a task requests from its scheduler when it gives up control.
pub type Request<v> =
  | Spawn
  | Join(TaskRef)
  | Await(TaskRef)
  /// The task to stop, and the brackets it is inside.
  | Cancel(TaskRef, Shields)
  /// A capacity of at least 0.
  | Channel(Int)
  | Send(ChanRef, v)
  | Recv(ChanRef)
  | Close(ChanRef)
  /// Each arm's channel with what it sends, if anything, and whether to wait.
  | Select(List<{ chan: ChanRef, send: Option<v> }>, Bool)
  | Yield
  | Now
  /// Nanoseconds.
  | Sleep(Int)
  | Next
  /// A bound of at least 1.
  | Below(Int)
  | Seed
  /// Wait until the run completes the ticket for this token.
  | Ticket(Int)
  /// The task's body returned, and its handle stores the result.
  | Finished
  /// The task finished unwinding after a cancel.
  | Unwound
  /// A raise that nothing in the task handled leaves it for the handlers around the scheduler.
  /// Carries the brackets each other task is inside, by task, if any.
  | Raised(Map<Int, Shields>)
  /// The task failed at run time; the runtime stores the failure.
  | Failed

/// What the runtime knows about a request: where it was performed, the brackets the task is inside
/// if a cancel waits for it to leave them (otherwise none), and the run's clock, which a production
/// scheduler reads.
pub type RequestContext = { site: Site, acquire_release_depth: Shields, now: Int }

/// What a task receives when it runs again.
pub type Reply<v> =
  | Nothing
  | Flag(Bool)
  | Number(Int)
  /// The id of the task spawned.
  | Spawned(Int)
  /// The id of the channel created.
  | ChannelCreated(Int)
  /// The joined task returned: its handle stores the result.
  | Joined
  /// The awaited task returned (`true`) or was cancelled.
  | Awaited(Bool)
  | Received(Option<v>)
  /// The arm that completed, by its position, with what it received or sent.
  | Selected(Option<{ at: Int, got: Option<v> }>)

/// How a task runs again: from its body's start, with a reply, only to unwind, or raising.
pub type Resumption<v> = | Start | Resume(Reply<v>) | Unwind | Raise(Failure)

/// What runs next, or why nothing does.
pub type Turn<v> =
  | Run(Int, Resumption<v>)
  /// Every task ended, and the body returned.
  | Complete
  /// Every task ended after this task's raise left it, and the raise now lands at the scheduler's
  /// site.
  | Reraise(Int)
  | Ends(Ending)
  /// A production scheduler with nothing to run until a ticket is completed, the deadline passes if
  /// there is one, or the run is stopped.
  | Idle(Option<Int>)

/// How a scheduler ends without its body's result.
pub type Ending =
  /// The scheduler's own failure.
  | SchedulerFailed(Failure)
  /// The task failed at run time: the runtime's failure is reported, with this note.
  | TaskFailed(Int, Option<String>)
  /// A drain after a stop ran out of time, which failed the run.
  | Drained

/// An action the scheduler's loop takes for the scheduler, which only the runtime can perform.
pub type Command =
  /// A cancel waits until the task leaves the brackets it is inside.
  | DelayCancel(Int)
  /// The task's cancel no longer waits.
  | LetThrough(Int)
  /// The task never started: free its body and stack.
  | Discard(Int)
  /// The task ended by cancellation, which its handle records.
  | MarkCancelled(Int)
  /// The task's raise is dropped: another task's raise is already leaving the scheduler.
  | DropRaise(Int)

/// A failure the scheduler reports: a code, a message, labels at sites, and notes.
pub type Failure = { code: String, message: String, labels: List<Label>, notes: List<String> }

/// A failure's message at a site, with `primary` set for the site the failure is about.
pub type Label = { at: Site, primary: Bool, text: String }

derive bin for Label
derive bin for Failure

/// `f` encoded as the runtime reads the failure it fails a run with.
pub fn failure_bytes(f: Failure) -> Bytes / {abort.raise} = bin::encode(f, failure_bin())

/// What the scheduler's host reports to a production turn.
pub type HostState = { now: Int, stopping: Bool }

// --- A scheduler's state -------------------------------------------------------------

type Wait<v> =
  | Joining(Int)
  | Awaiting(Int)
  /// Until this deadline: virtual time in `simulate`, the run's clock in production.
  | Sleeping(Int)
  | AwaitingTicket(Int)
  /// To send this value on the channel.
  | Sending(Int, v)
  | Receiving(Int)
  | Selecting(List<Arm<v>>)

type Arm<v> = { chan: Int, send: Option<v> }

/// A task's state. The running task stays in the state it was chosen in until its request changes
/// it.
type State<v> =
  | Ready(Resumption<v>)
  | Blocked(Wait<v>, Site)
  | Done
  | Errored
  | Stopped
  /// Cancelled before it started, in `simulate`: enabled for one step that runs nothing, so the
  /// search has a step of the task to order against the cancel.
  | Dropped

/// One of the scheduler's tasks.
type Member<v> = {
  id: Int,
  state: State<v>,
  origin: Site,
  waiters: List<Int>,
  /// A cancel reached it. A later cancel changes nothing, and every step it takes reads this.
  cancelled: Bool,
}

type Queued<v> = { value: v, stamp: List<Int> }

type Channel<v> = {
  capacity: Int,
  /// Sent and not yet received, each with its sender's clock as of the send.
  queue: List<Queued<v>>,
  senders: List<Int>,
  receivers: List<Int>,
  closed: Bool,
}

/// One scheduler. Tasks and channels are numbered from 0 in the scheduler and never reused.
/// Its loop has the only reference to it, so a request updates it in place.
pub type Scheduler<v> = {
  policy: Policy,
  id: Int,
  site: Site,
  tasks: Map<Int, Member<v>>,
  /// In `simulate`, each task's vector clock: how many steps of each task it has observed. A
  /// production scheduler keeps none.
  stamps: List<List<Int>>,
  /// The tasks that may run. In `simulate` they are ascending, the order a choice indexes, with
  /// the running task among them until it stops being ready. In production they are in the order
  /// they became ready.
  ready: List<Int>,
  timers: Map<(Int, Int), Unit>,
  /// A production scheduler's tasks waiting on tickets, by token.
  tickets: Map<Int, Int>,
  channels: Map<Int, Channel<v>>,
  /// In `simulate`, what an operation on each channel writes, by the channel's id. A production
  /// scheduler keeps none.
  chan_accesses: List<Access>,
  unfinished: Int,
  next_id: Int,
  next_chan: Int,
  current: Option<Int>,
  /// `simulate`'s virtual time, in nanoseconds since the scheduler opened.
  now: Int,
  trail: Trail,
  /// The steps this scheduler took before its last.
  steps: List<Step>,
  /// The last step this scheduler took, which the running task is taking; none before the first.
  step: Option<Step>,
  ending: Option<Ending>,
  /// The task whose raise leaves the scheduler once every other task has ended.
  raising: Option<Int>,
  orders: List<Command>,
  /// What the last `next_turn` decided runs next. Before the first call, its value means nothing.
  turn: Turn<v>,
  /// Used by `simulate`'s loop: each set of effects the runtime wrote, decoded, and cached because
  /// a program repeats its steps' effects.
  touches: Map<Bytes, List<trail::Touch>>,
  /// Used by a production scheduler's loop: how many waits on the run in a row woke nothing.
  spurious_wakeups: Int,
}

/// A simulation `id` at `site`, its body to run as task 0, choosing from `t`.
pub fn seeded<v>(id: Int, site: Site, t: Trail) -> Scheduler<v> = new_scheduler(Seeded, id, site, t)

/// The run's production scheduler, its root to run as task 0.
pub fn production<v>(id: Int, site: Site) -> Scheduler<v> =
  new_scheduler(Production, id, site, trail::trail({ root: 0u64, path: [] }, 1))

fn new_scheduler<v>(policy: Policy, id: Int, site: Site, t: Trail) -> Scheduler<v> =
  {
    policy: policy,
    id: id,
    site: site,
    tasks: Map::new().insert(0, {
      id: 0,
      state: Ready(Start),
      origin: site,
      waiters: [],
      cancelled: false,
    }),
    stamps: match policy { Seeded -> [[0]], Production -> [] },
    ready: [0],
    timers: Map::new(),
    tickets: Map::new(),
    channels: Map::new(),
    chan_accesses: [],
    unfinished: 1,
    next_id: 1,
    next_chan: 0,
    current: None,
    now: 0,
    trail: t,
    steps: [],
    step: None,
    ending: None,
    raising: None,
    orders: [],
    turn: Idle(None),
    touches: Map::new(),
    spurious_wakeups: 0,
  }

/// The accesses of a step that accessed nothing.
fn no_accesses() -> List<Access> = []

/// Every step the scheduler took, in order.
pub fn steps_taken<v>(r: Scheduler<v>) -> List<Step> = steps_with(r.steps, r.step)

/// The trail as the scheduler leaves it, including the virtual time it used.
pub fn final_trail<v>(r: Scheduler<v>) -> Trail = { ..r.trail, virtual_time: r.now }

/// The commands the scheduler issued since they were last taken, oldest first, and the scheduler
/// without them.
pub fn take_commands<v>(r: Scheduler<v>) -> { orders: List<Command>, scheduler: Scheduler<v> } =
  { orders: r.orders, scheduler: { ..r, orders: [] } }

/// How many tasks the scheduler has: in `simulate` every one it spawned, in production those not
/// yet ended.
pub fn task_count<v>(r: Scheduler<v>) -> Int = r.tasks.len()

// --- Turns -------------------------------------------------------------------------

/// The scheduler once it has decided what runs next, which it stores as its turn.
pub fn next_turn<v>(r: Scheduler<v>, host: HostState) -> Scheduler<v> / {abort.raise} =
  match r.ending {
    Some(e) -> { ..r, turn: Ends(e) },
    None -> match r.current {
      Some(task) ->
        fail_turn(
          r,
          internal_error(
            r,
            task_name(task) ++ " was still running when the scheduler was asked for the next task",
          ),
        ),
      None -> match r.policy { Seeded -> seeded_turn(r), Production -> production_turn(r, host) },
    },
  }

fn fail_turn<v>(r: Scheduler<v>, f: Failure) -> Scheduler<v> = {
  let s = fail_scheduler(r, f);
  let turn = match s.ending { Some(e) -> Ends(e), None -> Ends(SchedulerFailed(f)) };
  { ..s, turn: turn }
}

/// `r` failed with `f`, unless it already ended another way.
fn fail_scheduler<v>(r: Scheduler<v>, f: Failure) -> Scheduler<v> =
  match r.ending { Some(_) -> r, None -> { ..r, ending: Some(SchedulerFailed(f)) } }

/// The final turn: completion or a re-raise when every task has ended, or a deadlock failure when
/// some still wait on something that can never happen.
fn final_turn<v>(r: Scheduler<v>) -> Scheduler<v> / {abort.raise} =
  if r.unfinished > 0 {
    fail_turn(r, match r.policy { Seeded -> deadlock(r), Production -> host_deadlock(r) })
  } else {
    match r.raising { Some(task) -> { ..r, turn: Reraise(task) }, None -> { ..r, turn: Complete } }
  }

fn seeded_turn<v>(r: Scheduler<v>) -> Scheduler<v> / {abort.raise} =
  iterate(r, r.tasks.len() + r.timers.len() + 2, |s: Scheduler<v>|
    match s.ending {
      Some(e) -> Stop({ ..s, turn: Ends(e) }),
      None -> {
        let enabled = s.ready.len();
        if enabled == 0 {
          match s.timers.first() {
            Some(earliest) -> Continue(advance_time(s, earliest.key._0)),
            None -> Stop(final_turn(s)),
          }
        } else if s.trail.points >= s.trail.budget { Stop(fail_turn(s, step_budget_exceeded(s))) }
        else {
          let c = trail::choose(s.trail, enabled);
          if c.choice >= enabled {
            Stop(fail_turn(s, divergence(s, s.trail.points, c.choice, enabled)))
          } else { choose_task(s, c.choice, c.choices) }
        }
      },
    })

/// Records the scheduling point that chooses the enabled task at `choice`, with the choices stream
/// at `choices` after it.
fn choose_task<v>(
  s: Scheduler<v>,
  choice: Int,
  choices: Int,
) -> Iter<Scheduler<v>, Scheduler<v>> / {abort.raise} =
  match s.ready.at(choice) {
    None ->
      Stop(fail_turn(s, internal_error(s, "a scheduling point had no enabled task to choose"))),
    Some(id) -> match s.tasks.get(id) {
      None ->
        Stop(fail_turn(s, internal_error(s, task_name(id) ++ " is not a task of this scheduler"))),
      Some(task) -> {
        let dropped = match task.state { Dropped -> true, _ -> false };
        let read = if task.cancelled { [trail::liveness(id, Read)] } else { no_accesses() };
        let step = {
          scheduler: s.id,
          task: id,
          runnable: s.ready,
          choice: choice,
          accesses: if dropped { trail::with_access(read, trail::end_access(id)) } else { read },
          site: None,
          vector_clock: ticked(stamp_of(s, id), id),
        };
        let taken = record_step(s, step, choices);
        if dropped { Continue(finish_cancel(stopped_running(taken, id, Stopped), id)) } else {
          match task.state {
            Ready(res) -> Stop({ ..taken, current: Some(id), turn: Run(id, res) }),
            _ ->
              Stop(
                fail_turn(
                  taken,
                  internal_error(taken, task_name(id) ++ " was chosen but is not enabled"),
                ),
              ),
          }
        }
      },
    },
  }

/// `s` after the scheduling point that took `step`, with the choices stream's counter at
/// `choices`.
fn record_step<v>(s: Scheduler<v>, step: Step, choices: Int) -> Scheduler<v> / {abort.raise} =
  {
    ..s,
    trail: { ..s.trail, points: s.trail.points + 1, choices: choices },
    steps: steps_with(s.steps, s.step),
    stamps: s.stamps.set(step.task, step.vector_clock),
    step: Some(step),
  }

/// `steps` followed by `last`, if there is one.
fn steps_with(steps: List<Step>, last: Option<Step>) -> List<Step> =
  match last { Some(step) -> steps.push(step), None -> steps }

/// `stamp` with one more step of task `id`.
fn ticked(stamp: List<Int>, id: Int) -> List<Int> =
  match stamp.at(id) { Some(n) -> stamp.set(id, n + 1), None -> widened(stamp, id).push(1) }

fn widened(xs: List<Int>, n: Int) -> List<Int> =
  if xs.len() >= n { xs }
  else { range(xs.len(), n).fold(xs, |acc: List<Int>, _i: Int| acc.push(0)) }

/// Moves virtual time to `deadline`, and readies each task sleeping until then, in task order.
fn advance_time<v>(s: Scheduler<v>, deadline: Int) -> Scheduler<v> = {
  let woken = s.timers.keys().filter(|k: (Int, Int)| k._0 == deadline);
  woken.fold(timers_cut(s, woken, deadline), |acc: Scheduler<v>, k: (Int, Int)|
    wake_sleeper(acc, k._1))
}

/// `s` at virtual time `deadline`, without the timers `woken`.
fn timers_cut<v>(s: Scheduler<v>, woken: List<(Int, Int)>, deadline: Int) -> Scheduler<v> =
  {
    ..s,
    timers: woken.fold(s.timers, |m: Map<(Int, Int), Unit>, k: (Int, Int)| m.remove(k)),
    now: deadline,
  }

/// `s` without the timer `key`.
fn timer_cut<v>(s: Scheduler<v>, key: (Int, Int)) -> Scheduler<v> =
  { ..s, timers: s.timers.remove(key) }

/// `s` with the timer `key`.
fn timer_set<v>(s: Scheduler<v>, key: (Int, Int)) -> Scheduler<v> =
  { ..s, timers: s.timers.insert(key, ()) }

/// Readies each sleeper whose deadline is `now` or earlier, earliest first and then in task order.
fn wake_due_sleepers<v>(r: Scheduler<v>, now: Int) -> Scheduler<v> / {abort.raise} =
  iterate(r, r.timers.len() + 1, |s: Scheduler<v>|
    match s.timers.first() {
      Some(t) -> if t.key._0 > now { Stop(s) }
      else { Continue(wake_sleeper(timer_cut(s, t.key), t.key._1)) },
      None -> Stop(s),
    })

fn wake_sleeper<v>(s: Scheduler<v>, id: Int) -> Scheduler<v> =
  match s.tasks.get(id) {
    Some(t) -> match t.state {
      Blocked(Sleeping(_), _) -> make_ready(s, id, Resume(Nothing)),
      _ ->
        fail_scheduler(
          s,
          internal_error(
            s,
            "a timer fired for " ++ task_name(id) ++ ", which was not waiting on one",
          ),
        ),
    },
    None ->
      fail_scheduler(
        s,
        internal_error(s, "a timer fired for " ++ task_name(id) ++ ", which is not a task"),
      ),
  }

fn production_turn<v>(r: Scheduler<v>, host: HostState) -> Scheduler<v> / {abort.raise} = {
  let s = if r.timers.len() == 0 { r } else { wake_due_sleepers(r, host.now) };
  match s.ending {
    Some(e) -> { ..s, turn: Ends(e) },
    None -> match s.ready {
      [id, ..rest] -> match s.tasks.get(id) {
        Some(t) -> match t.state {
          Ready(res) -> { ..s, ready: rest, current: Some(id), turn: Run(id, res) },
          _ -> fail_turn(s, internal_error(s, task_name(id) ++ " was chosen but is not enabled")),
        },
        None ->
          fail_turn(s, internal_error(s, task_name(id) ++ " is not a task of this scheduler")),
      },
      [] -> if s.unfinished == 0 { final_turn(s) } else {
        match s.timers.first() {
          Some(earliest) -> { ..s, turn: Idle(Some(earliest.key._0)) },
          None -> if s.tickets.len() == 0 && !host.stopping { final_turn(s) }
          else { { ..s, turn: Idle(None) } },
        }
      },
    },
  }
}

/// Readies, in task order, each task waiting on one of `tokens`, whose tickets the run completed.
/// A token that no task here waits on belongs to another scheduler of the run that has ended.
pub fn wake_ticket_waiters<v>(r: Scheduler<v>, tokens: List<Int>) -> Scheduler<v> = {
  let found = tokens.fold(
    { tickets: r.tickets, tasks: [] },
    |acc: { tickets: Map<Int, Int>, tasks: List<Int> }, token: Int|
      match acc.tickets.get(token) {
        Some(task) -> { tickets: acc.tickets.remove(token), tasks: acc.tasks.push(task) },
        None -> acc,
      },
  );
  found.tasks.sort().fold({ ..r, tickets: found.tickets }, |acc: Scheduler<v>, id: Int|
    match acc.tasks.get(id) {
      Some(t) -> match t.state {
        Blocked(AwaitingTicket(_), _) -> make_ready(acc, id, Resume(Nothing)),
        _ ->
          fail_scheduler(
            acc,
            internal_error(acc, task_name(id) ++ " was answered a ticket while not waiting on one"),
          ),
      },
      None -> acc,
    })
}

// --- Requests ---------------------------------------------------------------------

/// Applies the running `task`'s request to the scheduler.
pub fn handle_request<v>(
  r: Scheduler<v>,
  task: Int,
  request: Request<v>,
  context: RequestContext,
) -> Scheduler<v> / {abort.raise} =
  match r.ending {
    Some(_) -> r,
    None -> if r.current != Some(task) {
      fail_scheduler(
        r,
        internal_error(
          r,
          "the scheduler was asked for " ++ task_name(task) ++ ", which was not running",
        ),
      )
    } else {
      let s = set_step_site(r, context.site);
      match request {
        Failed -> fail_task(s, task),
        _ -> unwind_if_cancelled(apply_request(s, task, request, context), task, context),
      }
    },
  }

fn apply_request<v>(
  s: Scheduler<v>,
  task: Int,
  request: Request<v>,
  context: RequestContext,
) -> Scheduler<v> / {abort.raise} =
  match request {
    Spawn -> apply_spawn(s, task, context.site),
    Join(t) -> apply_join(s, task, t, context.site, false),
    Await(t) -> apply_join(s, task, t, context.site, true),
    Cancel(t, shields) -> apply_cancel(s, task, t, shields, context.site),
    Channel(capacity) -> if capacity < 0 {
      raise_in_task(s, task, negative_capacity(context.site, capacity))
    } else {
      let id = s.next_chan;
      reply(
        record_access(add_channel(s, capacity), trail::new_channel_access(), context.site),
        task,
        ChannelCreated(id),
      )
    },
    Send(c, value) -> match channel_error(s, c, context.site) {
      Some(f) -> fail_scheduler(s, f),
      None ->
        record_channel_access(apply_send(s, task, c.id, value, context.site), c.id, context.site),
    },
    Recv(c) -> match channel_error(s, c, context.site) {
      Some(f) -> fail_scheduler(s, f),
      None -> record_channel_access(apply_receive(s, task, c.id, context.site), c.id, context.site),
    },
    Close(c) -> match channel_error(s, c, context.site) {
      Some(f) -> fail_scheduler(s, f),
      None -> record_channel_access(apply_close(s, task, c.id), c.id, context.site),
    },
    Select(arms, wait) -> apply_select(s, task, arms, wait, context.site),
    Yield -> reply(s, task, Nothing),
    Now -> match s.policy {
      Seeded -> {
        let now = s.now;
        reply(s, task, Number(now))
      },
      Production -> reply(s, task, Number(context.now)),
    },
    Sleep(nanos) -> apply_sleep(s, task, nanos, context),
    Next -> match s.policy {
      Seeded -> {
        let value = trail::next_draw(s.trail);
        reply({ ..s, trail: { ..s.trail, draws: s.trail.draws + 1 } }, task, Number(value))
      },
      Production ->
        fail_scheduler(
          s,
          internal_error(s, "`random.next` reached the run's own scheduler, which draws nothing"),
        ),
    },
    Below(n) -> match s.policy {
      Seeded -> if n < 1 { raise_in_task(s, task, invalid_bound(context.site, n)) } else {
        let d = trail::draw_below(s.trail, n);
        reply({ ..s, trail: { ..s.trail, draws: d.counter } }, task, Number(d.value))
      },
      Production ->
        fail_scheduler(
          s,
          internal_error(s, "`random.below` reached the run's own scheduler, which draws nothing"),
        ),
    },
    Seed -> {
      let root = trail::to_signed(s.trail.seed.root);
      reply(s, task, Number(root))
    },
    Ticket(token) -> apply_ticket(s, task, token, context.site),
    Finished -> finish_task(s, task),
    Unwound -> {
      finish_cancel(
        record_access(stopped_running(s, task, Stopped), trail::end_access(task), context.site),
        task,
      )
    },
    Raised(shields) -> raise_from_task(s, task, shields, context.site),
    Failed -> fail_task(s, task),
  }

/// `s` with one more channel, of `capacity`.
fn add_channel<v>(s: Scheduler<v>, capacity: Int) -> Scheduler<v> =
  {
    ..s,
    next_chan: s.next_chan + 1,
    chan_accesses: match s.policy {
      Seeded -> s.chan_accesses.push(trail::channel_access(s.next_chan)),
      Production -> s.chan_accesses,
    },
    channels: s.channels.insert(s.next_chan, {
      capacity: capacity,
      queue: [],
      senders: [],
      receivers: [],
      closed: false,
    }),
  }

/// `s` with channel `id` replaced by `f` of it.
fn chan_set<v>(s: Scheduler<v>, id: Int, f: (Channel<v>) -> Channel<v>) -> Scheduler<v> =
  { ..s, channels: s.channels.update(id, f) }

/// `s` with task `id` replaced by `f` of it.
fn task_set<v>(s: Scheduler<v>, id: Int, f: (Member<v>) -> Member<v>) -> Scheduler<v> =
  { ..s, tasks: s.tasks.update(id, f) }

/// `s` without task `id`.
fn task_removed<v>(s: Scheduler<v>, id: Int) -> Scheduler<v> = { ..s, tasks: s.tasks.remove(id) }

/// Readies the running task with `incoming`, and gives control back to the loop.
fn reply<v>(s: Scheduler<v>, task: Int, incoming: Reply<v>) -> Scheduler<v> =
  { ..running_readied(s, task, Resume(incoming)), current: None }

/// Readies the task to raise `f` where it made its request, and gives control back to the loop.
fn raise_in_task<v>(s: Scheduler<v>, task: Int, f: Failure) -> Scheduler<v> =
  { ..running_readied(s, task, Raise(f)), current: None }

/// Readies the running task `id` to run again as `res`. In `simulate` it is already among the
/// ready tasks.
fn running_readied<v>(s: Scheduler<v>, id: Int, res: Resumption<v>) -> Scheduler<v> =
  match s.policy { Seeded -> set_state(s, id, Ready(res)), Production -> ready_queued(s, id, res) }

/// Readies task `id`, which the scheduler has, to run again as `res`.
fn make_ready<v>(s: Scheduler<v>, id: Int, res: Resumption<v>) -> Scheduler<v> =
  match s.policy { Seeded -> ready_in_order(s, id, res), Production -> ready_queued(s, id, res) }

fn ready_in_order<v>(s: Scheduler<v>, id: Int, res: Resumption<v>) -> Scheduler<v> =
  {
    ..s,
    tasks: s.tasks.update(id, |t: Member<v>| { ..t, state: Ready(res) }),
    ready: ascending_with(s.ready, id),
  }

fn ready_queued<v>(s: Scheduler<v>, id: Int, res: Resumption<v>) -> Scheduler<v> =
  {
    ..s,
    tasks: s.tasks.update(id, |t: Member<v>| { ..t, state: Ready(res) }),
    ready: s.ready.push(id),
  }

/// `xs`, which is ascending, with `id` added in order.
fn ascending_with(xs: List<Int>, id: Int) -> List<Int> =
  if at_or_minus(xs, xs.len() - 1) < id { xs.push(id) }
  else if at_or_minus(xs, first_not_below(xs, id, 0, xs.len())) == id { xs }
  else { xs.filter(|x: Int| x < id).push(id).concat(xs.filter(|x: Int| x > id)) }

/// The position in `xs`, which is ascending, of the first of the `final_trail` elements from `i`
/// on that is not below `id`.
fn first_not_below(xs: List<Int>, id: Int, i: Int, final_trail: Int) -> Int =
  if final_trail <= 0 || at_or_minus(xs, i) >= id { i }
  else { first_not_below(xs, id, i + 1, final_trail - 1) }

fn at_or_minus(xs: List<Int>, i: Int) -> Int = match xs.at(i) { Some(n) -> n, None -> 0 - 1 }

fn set_state<v>(s: Scheduler<v>, id: Int, state: State<v>) -> Scheduler<v> =
  { ..s, tasks: s.tasks.update(id, |t: Member<v>| { ..t, state: state }) }

fn block_task<v>(s: Scheduler<v>, id: Int, wait: Wait<v>, site: Site) -> Scheduler<v> =
  stopped_running(s, id, Blocked(wait, site))

/// Puts the running task `id` in `state`, in which it cannot run, and gives control back to the
/// loop.
fn stopped_running<v>(s: Scheduler<v>, id: Int, state: State<v>) -> Scheduler<v> = {
  let final_trail = match s.policy { Seeded -> unready(s, id), Production -> s };
  { ..set_state(final_trail, id, state), current: None }
}

fn add_command<v>(s: Scheduler<v>, order: Command) -> Scheduler<v> =
  { ..s, orders: s.orders.push(order) }

/// Places the running task's step at `site`, if it accessed nothing before.
fn set_step_site<v>(s: Scheduler<v>, site: Site) -> Scheduler<v> =
  match s.policy { Production -> s, Seeded -> set_last_step_site(s, site) }

/// `s` with its last step placed at `site`, if it was not placed yet.
fn set_last_step_site<v>(s: Scheduler<v>, site: Site) -> Scheduler<v> =
  { ..s, step: with_site(s.step, site) }

/// `step` placed at `site`, if it was not placed yet.
fn with_site(step: Option<Step>, site: Site) -> Option<Step> =
  match step {
    Some(st) -> match st.site { Some(_) -> Some(st), None -> Some({ ..st, site: Some(site) }) },
    None -> None,
  }

/// `step` with `access` added, if there is a step.
fn step_touched(step: Option<Step>, access: Access) -> Option<Step> =
  match step { Some(st) -> Some(touching(st, access)), None -> None }

/// `step` with `access` added.
fn touching(step: Step, access: Access) -> Step =
  { ..step, accesses: trail::with_access(step.accesses, access) }

/// Adds `access`, made at `site`, to what the step that made this request accessed.
fn record_access<v>(s: Scheduler<v>, access: Access, site: Site) -> Scheduler<v> =
  match s.policy { Production -> s, Seeded -> touched_step(s, access, site) }

/// `s` with `access` added to its last step, and the step placed at `site` if it was not placed
/// yet.
fn touched_step<v>(s: Scheduler<v>, access: Access, site: Site) -> Scheduler<v> =
  { ..s, step: step_touched(with_site(s.step, site), access) }

/// Adds an operation on channel `chan`, made at `site`, to what the step that made it accessed.
fn record_channel_access<v>(s: Scheduler<v>, chan: Int, site: Site) -> Scheduler<v> =
  match s.policy {
    Production -> s,
    Seeded -> match s.chan_accesses.at(chan) {
      Some(access) -> record_access(s, access, site),
      None -> record_access(s, trail::channel_access(chan), site),
    },
  }

/// Adds what the running task's step performed, each where it was made, to the step's accesses.
pub fn record_accesses<v>(
  r: Scheduler<v>,
  accesses: List<{ access: Access, at: Site }>,
) -> Scheduler<v> =
  accesses.fold(r, |acc: Scheduler<v>, a: { access: Access, at: Site }|
    record_access(acc, a.access, a.at))

/// Adds `access` to what task `id`'s last step accessed. A cancel is known only once it happens,
/// and that step could have come after it instead.
fn record_last_step_access<v>(
  s: Scheduler<v>,
  id: Int,
  access: Access,
) -> Scheduler<v> / {abort.raise} =
  match s.policy {
    Production -> s,
    Seeded -> if match s.step { Some(st) -> st.task == id, None -> false } {
      { ..s, step: step_touched(s.step, access) }
    } else {
      let context = iterate(s.steps.len() - 1, s.steps.len() + 1, |i: Int|
        if i < 0 { Stop(i) } else {
          match s.steps.at(i) {
            Some(step) -> if step.task == id { Stop(i) } else { Continue(i - 1) },
            None -> Stop(0 - 1),
          }
        });
      match s.steps.at(context) {
        Some(step) -> { ..s, steps: s.steps.set(context, touching(step, access)) },
        None -> s,
      }
    },
  }

fn apply_spawn<v>(s: Scheduler<v>, task: Int, site: Site) -> Scheduler<v> = {
  let id = s.next_id;
  let stamp = match s.policy { Seeded -> stamp_of(s, task), Production -> [] };
  reply(make_ready(task_born(s, site, stamp), id, Start), task, Spawned(id))
}

/// `s` with one more task, created at `site` with the clock `stamp` in `simulate`, and not yet
/// ready.
fn task_born<v>(s: Scheduler<v>, site: Site, stamp: List<Int>) -> Scheduler<v> =
  {
    ..s,
    next_id: s.next_id + 1,
    unfinished: s.unfinished + 1,
    tasks: s.tasks.insert(s.next_id, {
      id: s.next_id,
      state: Ready(Start),
      origin: site,
      waiters: [],
      cancelled: false,
    }),
    stamps: match s.policy { Seeded -> s.stamps.push(stamp), Production -> s.stamps },
  }

/// A join, or an await, of `t`.
fn apply_join<v>(
  s: Scheduler<v>,
  task: Int,
  t: TaskRef,
  site: Site,
  awaiting: Bool,
) -> Scheduler<v> / {abort.raise} =
  if t.scheduler != s.id { fail_scheduler(s, foreign_task(site, t.id)) } else {
    let settled = match s.tasks.get(t.id) {
      Some(target) -> match target.state { Done -> Returned, Stopped -> Cancelled, _ -> Live },
      None -> t.ended,
    };
    match settled {
      Returned ->
        reply(absorbed(s, task, t.id), task, if awaiting { Awaited(true) } else { Joined }),
      Cancelled -> {
        let a = absorbed(s, task, t.id);
        if awaiting { reply(a, task, Awaited(false)) }
        else { raise_in_task(a, task, joined_cancelled(site, t.id)) }
      },
      Live -> if !s.tasks.contains(t.id) { fail_scheduler(s, unknown_task(site, t.id)) } else {
        let wait_description = task_set(s, t.id, |x: Member<v>|
          { ..x, waiters: x.waiters.push(task) });
        block_task(
          wait_description,
          task,
          if awaiting { Awaiting(t.id) } else { Joining(t.id) },
          site,
        )
      },
    }
  }

/// Stops `t` wherever it is, as `task.cancel` does, and replies whether it stopped anything.
fn apply_cancel<v>(
  s: Scheduler<v>,
  task: Int,
  t: TaskRef,
  shields: Shields,
  site: Site,
) -> Scheduler<v> / {abort.raise} =
  if t.scheduler != s.id { fail_scheduler(s, foreign_task(site, t.id)) }
  else if t.id == task || t.id == 0 { fail_scheduler(s, invalid_cancel(site, t.id, task)) } else {
    let standing = match s.tasks.get(t.id) {
      None -> None,
      Some(target) ->
        Some({
          ended: match target.state {
            Done -> true,
            Errored -> true,
            Stopped -> true,
            Dropped -> true,
            _ -> false,
          },
          suspends: !target.cancelled,
        }),
    };
    match standing {
      None -> match t.ended {
        Live -> fail_scheduler(s, unknown_task(site, t.id)),
        _ -> reply(record_access(s, trail::end_access(t.id), site), task, Flag(false)),
      },
      Some(st) -> if st.ended {
        reply(record_access(s, trail::end_access(t.id), site), task, Flag(false))
      } else {
        let stopped = if st.suspends { stop_task(s, task, t.id, shields, site) } else { s };
        let marked = record_last_step_access(
          record_access(stopped, trail::liveness(t.id, Write), site),
          t.id,
          trail::liveness(t.id, Read),
        );
        reply(marked, task, Flag(st.suspends))
      },
    }
  }

/// Stops task `id` on behalf of `by`, which it waited on or ran after. It abandons its wait, and
/// only unwinds when it next runs. A task in a bracket's `acquire` keeps a reply it was given, a
/// task in a `release` also keeps its wait, and the cancel takes effect when it leaves them.
fn stop_task<v>(
  s: Scheduler<v>,
  by: Int,
  id: Int,
  shields: Shields,
  site: Site,
) -> Scheduler<v> / {abort.raise} =
  match s.tasks.get(id) {
    None -> s,
    Some(target) -> {
      let state = target.state;
      let s1 = task_set(s, id, |x: Member<v>| { ..x, cancelled: true });
      let shielded = shields.acquiring > 0 || shields.releasing > 0;
      match state {
        // A production scheduler keeps no ended task, so its handle records the end before it goes.
        Ready(Start) -> match s1.policy {
          Seeded -> set_state(add_command(s1, Discard(id)), id, Dropped),
          Production ->
            add_command(finish_cancel(set_state(unready(s1, id), id, Stopped), id), Discard(id)),
        },
        Ready(_) -> if shielded { add_command(s1, DelayCancel(id)) }
        else { set_state(s1, id, Ready(Unwind)) },
        Blocked(wait, _) -> if shields.releasing > 0 { add_command(s1, DelayCancel(id)) }
        else { absorbed(make_ready(release_wait(s1, id, wait, site), id, Unwind), id, by) },
        _ ->
          fail_scheduler(s1, internal_error(s1, task_name(id) ++ " was cancelled while running")),
      }
    },
  }

/// Removes task `id` from what `wait` held it on, recording an access so a step on that is ordered
/// against this.
fn release_wait<v>(s: Scheduler<v>, id: Int, wait: Wait<v>, site: Site) -> Scheduler<v> =
  match wait {
    Sleeping(until) -> { ..s, timers: s.timers.remove((until, id)) },
    Joining(on) -> record_access(remove_joiner(s, on, id), trail::end_access(on), site),
    Awaiting(on) -> record_access(remove_joiner(s, on, id), trail::end_access(on), site),
    AwaitingTicket(token) -> { ..s, tickets: s.tickets.remove(token) },
    Sending(chan, _) -> record_channel_access(remove_waiter(s, id, [chan]), chan, site),
    Receiving(chan) -> record_channel_access(remove_waiter(s, id, [chan]), chan, site),
    Selecting(arms) -> {
      let chans = arms.map(|a: Arm<v>| a.chan).sort().fold([], |acc: List<Int>, c: Int|
        if acc.contains(c) { acc } else { acc.push(c) });
      chans.fold(remove_waiter(s, id, chans), |acc: Scheduler<v>, c: Int|
        record_channel_access(acc, c, site))
    },
  }

/// `s` without task `id` among the tasks that may run.
fn unready<v>(s: Scheduler<v>, id: Int) -> Scheduler<v> =
  { ..s, ready: s.ready.filter(|q: Int| q != id) }

fn remove_joiner<v>(s: Scheduler<v>, on: Int, joiner: Int) -> Scheduler<v> =
  {
    ..s,
    tasks: s.tasks.update(on, |t: Member<v>|
      { ..t, waiters: t.waiters.filter(|j: Int| j != joiner) }),
  }

/// Removes task `id` from each of `chans`' waiting lists.
fn remove_waiter<v>(s: Scheduler<v>, id: Int, chans: List<Int>) -> Scheduler<v> =
  chans.fold(s, |acc: Scheduler<v>, c: Int|
    {
      ..acc,
      channels: acc.channels.update(c, |ch: Channel<v>|
        {
          ..ch,
          senders: ch.senders.filter(|t: Int| t != id),
          receivers: ch.receivers.filter(|t: Int| t != id),
        }),
    })

/// Cancels a wait `task` just began, if a cancel held back during the `acquire` it is inside came
/// first. In that case an operation that replied keeps its reply, and one that waits does not
/// start.
fn unwind_if_cancelled<v>(s: Scheduler<v>, task: Int, context: RequestContext) -> Scheduler<v> =
  if !context.acquire_release_depth.stopping || context.acquire_release_depth.releasing > 0 { s }
  else {
    let wait = match s.tasks.get(task) {
      Some(t) -> match t.state { Blocked(w, _) -> Some(w), _ -> None },
      None -> None,
    };
    match wait {
      Some(w) ->
        make_ready(
          release_wait(add_command(s, LetThrough(task)), task, w, context.site),
          task,
          Unwind,
        ),
      None -> s,
    }
  }

/// Marks a cancelled task, whether running or never started, as ended. An await of it returns that
/// it was cancelled, and a join raises.
fn finish_cancel<v>(s: Scheduler<v>, id: Int) -> Scheduler<v> / {abort.raise} = {
  let joiners = match s.tasks.get(id) { Some(t) -> Some(t.waiters), None -> None };
  match joiners {
    None -> s,
    Some(js) -> {
      let woken = js.fold(
        add_command({ ..s, unfinished: s.unfinished - 1 }, MarkCancelled(id)),
        |acc: Scheduler<v>, joiner: Int| {
          let waited = match acc.tasks.get(joiner) {
            Some(j) -> match j.state {
              Blocked(Awaiting(_), _) -> Some(Some(Resume(Awaited(false)))),
              Blocked(Joining(_), site) -> Some(Some(Raise(joined_cancelled(site, id)))),
              _ -> Some(None),
            },
            None -> None,
          };
          match waited {
            None -> acc,
            Some(Some(res)) -> absorbed(make_ready(acc, joiner, res), joiner, id),
            Some(None) ->
              fail_scheduler(
                acc,
                internal_error(
                  acc,
                  task_name(joiner) ++ " waited on " ++ task_name(id) ++ " without a join",
                ),
              ),
          }
        },
      );
      match woken.policy {
        Seeded -> task_set(woken, id, |x: Member<v>| { ..x, waiters: [] }),
        Production -> task_removed(woken, id),
      }
    },
  }
}

/// The running task returned, and its handle stores the result. Each task waiting on it is
/// notified.
fn finish_task<v>(s: Scheduler<v>, task: Int) -> Scheduler<v> / {abort.raise} = {
  let joiners = match s.tasks.get(task) { Some(t) -> Some(t.waiters), None -> None };
  match joiners {
    None ->
      fail_scheduler(
        s,
        internal_error(s, task_name(task) ++ " finished without being a task of this scheduler"),
      ),
    Some(js) -> {
      let s1 = record_access(s, trail::end_access(task), nowhere());
      let woken = js.fold(
        { ..s1, unfinished: s1.unfinished - 1 },
        |acc: Scheduler<v>, joiner: Int| {
          let incoming = match acc.tasks.get(joiner) {
            Some(j) -> match j.state {
              Blocked(Awaiting(_), _) -> Some(Some(Awaited(true))),
              Blocked(_, _) -> Some(Some(Joined)),
              _ -> Some(None),
            },
            None -> None,
          };
          match incoming {
            Some(Some(h)) -> absorbed(make_ready(acc, joiner, Resume(h)), joiner, task),
            Some(None) ->
              fail_scheduler(
                acc,
                internal_error(acc, task_name(joiner) ++ " was woken but was not blocked"),
              ),
            None -> acc,
          }
        },
      );
      let done = stopped_running(woken, task, Done);
      match done.policy {
        Seeded -> task_set(done, task, |x: Member<v>| { ..x, waiters: [] }),
        Production -> task_removed(done, task),
      }
    },
  }
}

/// The running task's raise leaves it for the handlers around the scheduler. Every other task still
/// running is cancelled, so each releases the brackets it is inside, and the raise lands once they
/// have ended. A second raise while one is leaving is dropped.
fn raise_from_task<v>(
  s: Scheduler<v>,
  task: Int,
  shields: Map<Int, Shields>,
  site: Site,
) -> Scheduler<v> / {abort.raise} = {
  let leaving = s.raising;
  let unfinished = s.unfinished - 1;
  let out = record_access(
    { ..stopped_running(s, task, Errored), unfinished: unfinished },
    trail::end_access(task),
    site,
  );
  match leaving {
    Some(_) -> add_command(out, DropRaise(task)),
    None ->
      out.tasks.keys().fold({ ..out, raising: Some(task) }, |acc: Scheduler<v>, id: Int| {
        let live = match acc.tasks.get(id) {
          Some(t) ->
            !t.cancelled
              && (match t.state {
                Done -> false,
                Errored -> false,
                Stopped -> false,
                Dropped -> false,
                _ -> true,
              }),
          None -> false,
        };
        if id == task || !live { acc } else {
          let held_by = match shields.get(id) { Some(h) -> h, None -> unshielded() };
          record_last_step_access(
            record_access(
              stop_task(acc, task, id, held_by, site),
              trail::liveness(id, Write),
              site,
            ),
            id,
            trail::liveness(id, Read),
          )
        }
      }),
  }
}

/// The running task failed at run time: the scheduler ends, and the failure is noted with where it
/// happened.
fn fail_task<v>(s: Scheduler<v>, task: Int) -> Scheduler<v> / {abort.raise} = {
  let live = max(s.unfinished - 1, 0);
  let note = if s.next_id <= 1 { None } else {
    Some(match s.policy {
      Seeded ->
        "failed in task " ++ task_name(task) ++ " of a simulation, with " ++ live.to_string()
          ++ " other task(s) unfinished; replay with seed "
          ++ trail::seed_text(s.trail.seed),
      Production ->
        "failed in task " ++ task_name(task) ++ " of the run's scheduler, with " ++ live.to_string()
          ++ " other task(s) unfinished; a host-backed run is not replayable from a seed",
    })
  };
  let fell = stopped_running(s, task, Errored);
  match fell.ending { Some(_) -> fell, None -> { ..fell, ending: Some(TaskFailed(task, note)) } }
}

fn apply_sleep<v>(s: Scheduler<v>, task: Int, nanos: Int, context: RequestContext) -> Scheduler<v> =
  if nanos <= 0 { reply(s, task, Nothing) } else {
    match s.policy {
      Seeded -> match checked_add(s.now, nanos) {
        None -> fail_scheduler(s, time_overflow(context.site, s.now, nanos)),
        Some(deadline) ->
          block_task(timer_set(s, (deadline, task)), task, Sleeping(deadline), context.site),
      },
      Production -> {
        let until = context.now +| nanos;
        block_task(timer_set(s, (until, task)), task, Sleeping(until), context.site)
      },
    }
  }

fn apply_ticket<v>(s: Scheduler<v>, task: Int, token: Int, site: Site) -> Scheduler<v> =
  match s.policy {
    Seeded ->
      fail_scheduler(
        s,
        internal_error(
          s,
          "a simulation was asked to wait on a ticket, which only the run's own scheduler does",
        ),
      ),
    Production -> match s.tickets.get(token) {
      Some(other) ->
        fail_scheduler(
          s,
          internal_error(
            s,
            task_name(task) ++ " waited on ticket " ++ token.to_string() ++ ", which "
              ++ task_name(other)
              ++ " was already waiting on",
          ),
        ),
      None -> block_task(ticket_set(s, token, task), task, AwaitingTicket(token), site),
    },
  }

/// `s` with task `task` waiting on the ticket of `token`.
fn ticket_set<v>(s: Scheduler<v>, token: Int, task: Int) -> Scheduler<v> =
  { ..s, tickets: s.tickets.insert(token, task) }

// --- Channels --------------------------------------------------------------------

/// Why `c` does not refer to a channel of this scheduler, if it does not: it belongs to another
/// scheduler, or its id was never created here.
fn channel_error<v>(s: Scheduler<v>, c: ChanRef, site: Site) -> Option<Failure> =
  if c.scheduler != s.id { Some(foreign_channel(site, c.id)) }
  else if c.id >= s.next_chan || c.id < 0 {
    Some(internal_error(s, chan_name(c.id) ++ " is not a channel of this scheduler"))
  } else { None }

/// Where a send goes without waiting: nowhere, rejected by a closed channel or one the scheduler no
/// longer has; to the receiver that has waited longest; into the queue while it has room; or not
/// yet.
type SendRoute = | Closed | ToReceiver(Int) | Queued | SenderWaits

fn send_route<v>(s: Scheduler<v>, id: Int) -> SendRoute =
  match s.channels.get(id) {
    None -> Closed,
    Some(ch) -> if ch.closed { Closed } else {
      match ch.receivers.at(0) {
        Some(receiver) -> ToReceiver(receiver),
        None -> if ch.queue.len() < ch.capacity { Queued } else { SenderWaits },
      }
    },
  }

/// `s` after `task`'s send of `value` on channel `id`, which goes where `goes` says, is complete.
fn complete_send<v>(
  s: Scheduler<v>,
  task: Int,
  id: Int,
  value: v,
  goes: SendRoute,
) -> Scheduler<v> / {abort.raise} =
  match goes {
    ToReceiver(receiver) ->
      deliver(
        chan_set(s, id, |c: Channel<v>| { ..c, receivers: c.receivers.drop(1) }),
        receiver,
        id,
        Some(value),
        task,
      ),
    Queued -> {
      let stamp = stamp_of(s, task);
      chan_set(s, id, |c: Channel<v>| { ..c, queue: c.queue.push({ value: value, stamp: stamp }) })
    },
    _ -> s,
  }

fn apply_send<v>(
  s: Scheduler<v>,
  task: Int,
  id: Int,
  value: v,
  site: Site,
) -> Scheduler<v> / {abort.raise} =
  match send_route(s, id) {
    Closed -> reply(s, task, Flag(false)),
    SenderWaits ->
      block_task(
        chan_set(s, id, |c: Channel<v>| { ..c, senders: c.senders.push(task) }),
        task,
        Sending(id, value),
        site,
      ),
    goes -> reply(complete_send(s, task, id, value, goes), task, Flag(true)),
  }

/// Readies `receiver`, waiting to receive on `chan`, with `value`, or with the close.
fn deliver<v>(
  s: Scheduler<v>,
  receiver: Int,
  chan: Int,
  value: Option<v>,
  by: Int,
) -> Scheduler<v> / {abort.raise} = {
  let wait = match s.tasks.get(receiver) {
    Some(t) -> match t.state { Blocked(w, _) -> Some(Some(w)), _ -> Some(None) },
    None -> None,
  };
  match wait {
    None -> s,
    Some(Some(Receiving(_))) ->
      absorbed(make_ready(s, receiver, Resume(Received(value))), receiver, by),
    Some(Some(Selecting(arms))) -> match index_where(arms, |a: Arm<v>|
        a.chan == chan && !sends(a)) {
      Some(context) ->
        absorbed(
          make_ready(
            remove_waiter(s, receiver, arms.map(|a: Arm<v>| a.chan)),
            receiver,
            Resume(Selected(Some({ at: context, got: value }))),
          ),
          receiver,
          by,
        ),
      None ->
        fail_scheduler(
          s,
          internal_error(
            s,
            task_name(receiver) ++ " was taken as a receiver on " ++ chan_name(chan)
              ++ ", which its select does not receive from",
          ),
        ),
    },
    _ ->
      fail_scheduler(
        s,
        internal_error(s, task_name(receiver) ++ " was taken as a receiver but was not receiving"),
      ),
  }
}

/// What task `id` waits on: `None` if the scheduler has no such task, `Some(None)` if it waits on
/// nothing.
fn wait_of<v>(s: Scheduler<v>, id: Int) -> Option<Option<Wait<v>>> =
  match s.tasks.get(id) {
    Some(t) -> match t.state { Blocked(w, _) -> Some(Some(w)), _ -> Some(None) },
    None -> None,
  }

/// What a sender waiting as `wait` sends on `chan`: its send's value, or its select's arm's.
fn sent_value<v>(wait: Option<Option<Wait<v>>>, chan: Int) -> Option<v> =
  match wait {
    Some(Some(Sending(_, value))) -> Some(value),
    Some(Some(Selecting(arms))) -> match index_where(arms, |a: Arm<v>| a.chan == chan && sends(a)) {
      Some(context) -> match arms.at(context) { Some(arm) -> arm.send, None -> None },
      None -> None,
    },
    _ -> None,
  }

/// Readies `sender`, waiting as `wait` to send on `chan`, with whether its value was sent.
fn release_sender<v>(
  s: Scheduler<v>,
  sender: Int,
  wait: Option<Option<Wait<v>>>,
  chan: Int,
  went: Bool,
  by: Int,
) -> Scheduler<v> / {abort.raise} =
  match wait {
    None -> s,
    Some(Some(Sending(_, _))) -> absorbed(make_ready(s, sender, Resume(Flag(went))), sender, by),
    Some(Some(Selecting(arms))) -> match index_where(arms, |a: Arm<v>| a.chan == chan && sends(a)) {
      Some(context) -> {
        let got = if went { match arms.at(context) { Some(arm) -> arm.send, None -> None } }
        else { None };
        absorbed(
          make_ready(
            remove_waiter(s, sender, arms.map(|a: Arm<v>| a.chan)),
            sender,
            Resume(Selected(Some({ at: context, got: got }))),
          ),
          sender,
          by,
        )
      },
      None ->
        fail_scheduler(
          s,
          internal_error(
            s,
            task_name(sender) ++ " was taken as a sender on " ++ chan_name(chan)
              ++ ", which its select does not send to",
          ),
        ),
    },
    _ ->
      fail_scheduler(
        s,
        internal_error(s, task_name(sender) ++ " was taken as a sender but was not sending"),
      ),
  }

fn sends<v>(a: Arm<v>) -> Bool = match a.send { Some(_) -> true, None -> false }

fn index_where<a>(xs: List<a>, ok: (a) -> Bool) -> Option<Int> =
  range(0, xs.len()).fold(None, |found: Option<Int>, i: Int|
    match found {
      Some(_) -> found,
      None -> match xs.at(i) { Some(x) -> if ok(x) { Some(i) } else { None }, None -> None },
    })

/// Where a receive takes from without waiting: the oldest queued value; the sender that has waited
/// longest, if nothing is queued; nothing, from a channel that is closed and empty or one the
/// scheduler no longer has; or nowhere yet.
type ReceiveRoute<v> =
  | FromQueue
  | FromSender(Int, Option<Option<Wait<v>>>)
  | Spent
  | ReceiverWaits

fn receive_route<v>(s: Scheduler<v>, id: Int) -> ReceiveRoute<v> =
  match s.channels.get(id) {
    None -> Spent,
    Some(ch) -> if ch.queue.len() > 0 { FromQueue } else {
      match ch.senders.at(0) {
        Some(sender) -> FromSender(sender, wait_of(s, sender)),
        None -> if ch.closed { Spent } else { ReceiverWaits },
      }
    },
  }

/// The value a receive on channel `id` takes, from where `goes` says.
fn received_value<v>(s: Scheduler<v>, id: Int, goes: ReceiveRoute<v>) -> Option<v> =
  match goes {
    FromQueue -> match s.channels.get(id) {
      Some(ch) -> match ch.queue.at(0) { Some(q) -> Some(q.value), None -> None },
      None -> None,
    },
    FromSender(_, wait) -> sent_value(wait, id),
    _ -> None,
  }

/// `s` after `task`'s receive on channel `id`, from where `goes` says, is complete.
fn complete_receive<v>(
  s: Scheduler<v>,
  task: Int,
  id: Int,
  goes: ReceiveRoute<v>,
) -> Scheduler<v> / {abort.raise} =
  match goes {
    FromQueue -> {
      let stamp = match s.channels.get(id) {
        Some(ch) -> match ch.queue.at(0) { Some(q) -> q.stamp, None -> [] },
        None -> [],
      };
      let popped = stamp_absorbed(
        chan_set(s, id, |c: Channel<v>| { ..c, queue: c.queue.drop(1) }),
        task,
        stamp,
      );
      remove_if_spent(refilled(popped, id, task), id)
    },
    FromSender(sender, wait) ->
      release_sender(
        absorbed(
          chan_set(s, id, |c: Channel<v>| { ..c, senders: c.senders.drop(1) }),
          task,
          sender,
        ),
        sender,
        wait,
        id,
        true,
        task,
      ),
    _ -> s,
  }

/// `s` with the room that `by`'s receive made on channel `id` filled by the value of the sender
/// that has waited longest, which is then released.
fn refilled<v>(s: Scheduler<v>, id: Int, by: Int) -> Scheduler<v> / {abort.raise} = {
  let sender = match s.channels.get(id) { Some(ch) -> ch.senders.at(0), None -> None };
  match sender {
    None -> s,
    Some(sender) -> {
      let wait = wait_of(s, sender);
      let value = sent_value(wait, id);
      let stamp = stamp_of(s, sender);
      let taken = release_sender(
        chan_set(s, id, |c: Channel<v>| { ..c, senders: c.senders.drop(1) }),
        sender,
        wait,
        id,
        true,
        by,
      );
      match value {
        Some(apply_send) ->
          chan_set(taken, id, |c: Channel<v>|
            { ..c, queue: c.queue.push({ value: apply_send, stamp: stamp }) }),
        None -> taken,
      }
    },
  }
}

fn apply_receive<v>(
  s: Scheduler<v>,
  task: Int,
  id: Int,
  site: Site,
) -> Scheduler<v> / {abort.raise} =
  match receive_route(s, id) {
    ReceiverWaits ->
      block_task(
        chan_set(s, id, |c: Channel<v>| { ..c, receivers: c.receivers.push(task) }),
        task,
        Receiving(id),
        site,
      ),
    goes -> {
      let value = received_value(s, id, goes);
      reply(complete_receive(s, task, id, goes), task, Received(value))
    },
  }

/// Closes the channel to sending. Each waiting receiver gets `None` and each waiting sender
/// `false`, while queued values remain to be received.
fn apply_close<v>(s: Scheduler<v>, task: Int, id: Int) -> Scheduler<v> / {abort.raise} = {
  let shut = chan_set(s, id, |c: Channel<v>| { ..c, closed: true });
  let wait_description = match shut.channels.get(id) {
    Some(ch) -> ch.receivers.len() + ch.senders.len(),
    None -> 0,
  };
  // One waiter at a time off the live queues, since a select may wait on both sides of a channel.
  let drained = iterate(shut, wait_description + 1, |acc: Scheduler<v>| {
    let next = match acc.channels.get(id) {
      None -> None,
      Some(ch) -> match ch.receivers {
        [receiver, ..rest] -> Some({ receiver: true, task: receiver }),
        [] -> match ch.senders {
          [sender, ..rest] -> Some({ receiver: false, task: sender }),
          [] -> None,
        },
      },
    };
    match next {
      None -> Stop(acc),
      Some(w) -> if w.receiver {
        Continue(
          deliver(
            chan_set(acc, id, |c: Channel<v>|
              { ..c, receivers: c.receivers.filter(|t: Int| t != w.task) }),
            w.task,
            id,
            None,
            task,
          ),
        )
      } else {
        Continue(
          release_sender(
            chan_set(acc, id, |c: Channel<v>|
              { ..c, senders: c.senders.filter(|t: Int| t != w.task) }),
            w.task,
            wait_of(acc, w.task),
            id,
            false,
            task,
          ),
        )
      },
    }
  });
  reply(remove_if_spent(drained, id), task, Nothing)
}

/// Completes the first arm, in the order given, that can go without waiting. If none can and
/// `wait` is true, waits on every arm for the first one another task makes ready.
fn apply_select<v>(
  s: Scheduler<v>,
  task: Int,
  arms: List<{ chan: ChanRef, send: Option<v> }>,
  wait: Bool,
  site: Site,
) -> Scheduler<v> / {abort.raise} = {
  let refused = arms.fold(None, |bad: Option<Failure>, a: { chan: ChanRef, send: Option<v> }|
    match bad { Some(_) -> bad, None -> channel_error(s, a.chan, site) });
  match refused {
    Some(f) -> fail_scheduler(s, f),
    None -> {
      let wait_description = arms.map(|a: { chan: ChanRef, send: Option<v> }|
        { chan: a.chan.id, send: a.send });
      let touched = wait_description.fold(s, |acc: Scheduler<v>, a: Arm<v>|
        record_channel_access(acc, a.chan, site));
      let tried = range(0, wait_description.len()).fold(
        { scheduler: touched, arms: wait_description, went: None },
        |acc: { scheduler: Scheduler<v>, arms: List<Arm<v>>, went: Option<{ at: Int, got: Option<v> }> }, i: Int|
          match acc.went {
            Some(_) -> acc,
            None -> match acc.arms.at(i) {
              None -> acc,
              Some(arm) -> match arm.send {
                None -> match receive_route(acc.scheduler, arm.chan) {
                  ReceiverWaits -> acc,
                  goes -> {
                    let got = received_value(acc.scheduler, arm.chan, goes);
                    {
                      ..acc,
                      scheduler: complete_receive(acc.scheduler, task, arm.chan, goes),
                      went: Some({ at: i, got: got }),
                    }
                  },
                },
                Some(value) -> match send_route(acc.scheduler, arm.chan) {
                  SenderWaits -> acc,
                  Closed -> { ..acc, went: Some({ at: i, got: None }) },
                  goes ->
                    {
                      ..acc,
                      scheduler: complete_send(acc.scheduler, task, arm.chan, value, goes),
                      went: Some({ at: i, got: Some(value) }),
                    },
                },
              },
            },
          },
      );
      match tried.went {
        Some(went) -> reply(tried.scheduler, task, Selected(Some(went))),
        None -> if !wait { reply(tried.scheduler, task, Selected(None)) } else {
          let queued = tried.arms.fold(tried.scheduler, |acc: Scheduler<v>, a: Arm<v>|
            chan_set(acc, a.chan, |c: Channel<v>|
              match a.send {
                Some(_) -> if c.senders.contains(task) { c }
                else { { ..c, senders: c.senders.push(task) } },
                None -> if c.receivers.contains(task) { c }
                else { { ..c, receivers: c.receivers.push(task) } },
              }));
          block_task(queued, task, Selecting(tried.arms), site)
        },
      }
    },
  }
}

/// Removes a closed channel with nothing queued and nobody waiting. Operations on it then behave
/// as on an exhausted channel, which it is.
fn remove_if_spent<v>(s: Scheduler<v>, id: Int) -> Scheduler<v> = {
  let spent = match s.channels.get(id) {
    Some(ch) ->
      ch.closed && ch.queue.len() == 0 && ch.senders.len() == 0 && ch.receivers.len() == 0,
    None -> false,
  };
  if spent { channel_removed(s, id) } else { s }
}

/// `s` without channel `id`.
fn channel_removed<v>(s: Scheduler<v>, id: Int) -> Scheduler<v> =
  { ..s, channels: s.channels.remove(id) }

// --- Vector clocks ------------------------------------------------------------------

fn stamp_of<v>(s: Scheduler<v>, id: Int) -> List<Int> =
  match s.stamps.at(id) { Some(stamp) -> stamp, None -> [] }

/// In `simulate`, records that `into` has observed everything `from` had.
fn absorbed<v>(s: Scheduler<v>, into: Int, from: Int) -> Scheduler<v> / {abort.raise} =
  match s.policy { Production -> s, Seeded -> stamp_absorbed(s, into, stamp_of(s, from)) }

fn stamp_absorbed<v>(s: Scheduler<v>, into: Int, stamp: List<Int>) -> Scheduler<v> / {abort.raise} =
  match s.policy {
    Production -> s,
    Seeded -> if stamp.len() == 0 { s } else { stamps_absorbed(s, into, stamp) },
  }

fn stamps_absorbed<v>(
  s: Scheduler<v>,
  into: Int,
  stamp: List<Int>,
) -> Scheduler<v> / {abort.raise} = { ..s, stamps: stamps_joined(s.stamps, into, stamp) }

/// `stamps` with task `into`'s clock joined with `stamp`.
fn stamps_joined(
  stamps: List<List<Int>>,
  into: Int,
  stamp: List<Int>,
) -> List<List<Int>> / {abort.raise} =
  match stamps.at(into) {
    Some(mine) -> if seen_all(mine, stamp, 0, stamp.len()) { stamps }
    else { stamps.set(into, joined_from(mine, stamp, 0, stamp.len())) },
    None -> stamps,
  }

/// Whether `mine` counts at least as many steps as `theirs` for each of the `final_trail` tasks
/// from task `i` on.
fn seen_all(mine: List<Int>, theirs: List<Int>, i: Int, final_trail: Int) -> Bool =
  if final_trail <= 0 { true }
  else if theirs.at_or(i, 0) > mine.at_or(i, 0) { false }
  else { seen_all(mine, theirs, i + 1, final_trail - 1) }

/// `mine` with the count of each of the `final_trail` tasks from task `i` on set to the greater of
/// its own and `theirs`.
fn joined_from(
  mine: List<Int>,
  theirs: List<Int>,
  i: Int,
  final_trail: Int,
) -> List<Int> / {abort.raise} =
  if final_trail <= 0 { mine } else {
    let n = theirs.at_or(i, 0);
    let apply_join = if n <= mine.at_or(i, 0) { mine } else { widened(mine, i + 1).set(i, n) };
    joined_from(apply_join, theirs, i + 1, final_trail - 1)
  }

// --- Failures -----------------------------------------------------------------------

fn task_name(id: Int) -> String = "@" ++ id.to_string()

fn chan_name(id: Int) -> String = "#" ++ id.to_string()

fn plural(n: Int, one: String, many: String) -> String =
  if n == 1 { "1 " ++ one } else { n.to_string() ++ " " ++ many }

fn primary(context: Site, text: String) -> Label = { at: context, primary: true, text: text }

fn secondary(context: Site, text: String) -> Label = { at: context, primary: false, text: text }

fn internal_error<v>(r: Scheduler<v>, message: String) -> Failure =
  {
    code: "E0505",
    message: message,
    labels: [
      primary(r.site, match r.policy {
        Seeded -> "the simulated scheduler was driven out of order",
        Production -> "the production scheduler was driven out of order",
      }),
    ],
    notes: [],
  }

/// Each blocked task, ascending, with where it waits and on what.
fn blocked_labels<v>(r: Scheduler<v>, now: Option<Int>) -> List<Label> =
  r.tasks.fold([], |acc: List<Label>, id: Int, t: Member<v>|
    match t.state {
      Blocked(wait, site) ->
        acc.push(
          secondary(if site.root < 0 { t.origin } else { site }, wait_description(id, wait, now)),
        ),
      _ -> acc,
    })

fn wait_description<v>(id: Int, wait: Wait<v>, now: Option<Int>) -> String =
  match wait {
    Joining(task) -> task_name(id) ++ " waits here for " ++ task_name(task) ++ " to finish",
    Awaiting(task) -> task_name(id) ++ " waits here for " ++ task_name(task) ++ " to finish",
    Sleeping(until) -> match now {
      Some(n) ->
        task_name(id) ++ " sleeps here until " ++ until.to_string() ++ "ns, and it is "
          ++ n.to_string()
          ++ "ns",
      None -> task_name(id) ++ " sleeps here until " ++ until.to_string() ++ "ns",
    },
    AwaitingTicket(token) -> task_name(id) ++ " waits here on ticket " ++ token.to_string(),
    Sending(chan, _) ->
      task_name(id) ++ " waits here to send on channel " ++ chan_name(chan) ++ ", which is full",
    Receiving(chan) ->
      task_name(id) ++ " waits here to receive from channel " ++ chan_name(chan)
        ++ ", which is empty",
    Selecting(arms) -> if arms.len() == 0 { task_name(id) ++ " waits here on a select with no arm" }
    else {
      task_name(id) ++ " waits here on a select, none of whose arms can go: "
        ++ String::join(
          arms.map(|a: Arm<v>|
            match a.send {
              Some(_) -> "to send on " ++ chan_name(a.chan),
              None -> "to receive from " ++ chan_name(a.chan),
            }),
          ", ",
        )
    },
  }

fn blocked_count<v>(r: Scheduler<v>) -> Int =
  r.tasks.fold(0, |n: Int, _id: Int, t: Member<v>| match t.state { Blocked(_, _) -> n + 1, _ -> n })

fn deadlock<v>(r: Scheduler<v>) -> Failure / {abort.raise} =
  {
    code: "E0414",
    message: "this simulation deadlocked: " ++ plural(blocked_count(r), "task is", "tasks are")
      ++ " blocked and none runnable",
    labels: [primary(r.site, "no task in this scheduler can make progress")].concat(
      blocked_labels(r, Some(r.now)),
    ),
    notes: [
      "a simulation ends when its last task ends, so a task that never finishes stops the simulation rather than being dropped",
      "break the wait cycle, or make the task being waited on finish",
      "replay with seed " ++ trail::seed_text(r.trail.seed),
    ],
  }

fn host_deadlock<v>(r: Scheduler<v>) -> Failure =
  {
    code: "E0414",
    message: "this run's scheduler deadlocked: " ++ plural(blocked_count(r), "task is", "tasks are")
      ++ " blocked, none runnable and none waiting on the host",
    labels: [primary(r.site, "no task in this scheduler can make progress")].concat(
      blocked_labels(r, None),
    ),
    notes: [
      "a scheduler ends when its last task ends, so a task that never finishes stops it rather than being dropped",
      "break the wait cycle, or make the task being waited on finish",
    ],
  }

fn step_budget_exceeded<v>(r: Scheduler<v>) -> Failure / {abort.raise} =
  {
    code: "E0414",
    message: "this simulation took " ++ r.trail.budget.to_string()
      ++ " scheduling steps without finishing",
    labels: [primary(r.site, "no task in this simulation ever stopped running")],
    notes: [
      "this is the per-interleaving step budget; a simulation that needs more steps raises the simulation plan's `steps`",
      "more often it is a task that loops without ever finishing, which a real scheduler would spin on forever",
      "replay with seed " ++ trail::seed_text(r.trail.seed),
    ],
  }

fn divergence<v>(
  r: Scheduler<v>,
  point: Int,
  choice: Int,
  enabled: Int,
) -> Failure / {abort.raise} =
  {
    code: "E0415",
    message: "replaying this seed did not reproduce the schedule it recorded",
    labels: [primary(r.site, "this simulation scheduled differently on replay")],
    notes: [
      "at scheduling point " ++ point.to_string() ++ " the seed names enabled task "
        ++ choice.to_string()
        ++ ", and "
        ++ plural(enabled, "task was", "tasks were")
        ++ " enabled",
      "this is an internal error in Ply's simulation rather than in the program under test: a run must be a function of its definitions and its seed",
      "the seed replayed was " ++ trail::seed_text(r.trail.seed),
    ],
  }

/// How many times in a row a production scheduler's park may wake with no ticket completed and no
/// stop before it counts as a bug in the host.
pub fn max_spurious_wakeups() -> Int = 1024

/// The failure for a host whose park kept waking for no reason.
pub fn too_many_spurious_wakeups<v>(r: Scheduler<v>) -> Failure =
  {
    code: "E0505",
    message: "the host runtime returned from `park` " ++ max_spurious_wakeups().to_string()
      ++ " times without resolving a token",
    labels: [primary(r.site, "every task in this scheduler is waiting on the host")],
    notes: [
      "a park must block until at least one outstanding ticket is answered",
      "this is a defect in the host runtime rather than in the program: spinning here would burn a core and report nothing",
    ],
  }

/// A second simulation entered while `outer` runs.
pub fn nested(site: Site, outer: Site) -> Failure =
  {
    code: "E0416",
    message: "a simulation may not run inside another one",
    labels: [
      primary(site, "this simulation starts while one is already running"),
      secondary(outer, "the simulation already running"),
    ],
    notes: [
      "two schedulers mean two notions of `runnable` and a state space that is a product of both",
      "move the inner simulation out, or handle its effects with an ordinary `handle`",
    ],
  }

fn time_overflow(site: Site, now: Int, nanos: Int) -> Failure =
  {
    code: "E0502",
    message: "this sleep runs past the end of virtual time: " ++ now.to_string() ++ "ns + "
      ++ nanos.to_string()
      ++ "ns overflows",
    labels: [primary(site, "this deadline cannot be represented")],
    notes: ["virtual time is nanoseconds since the simulation started, and it is an `Int`"],
  }

fn foreign_channel(site: Site, chan: Int) -> Failure =
  {
    code: "E0413",
    message: "`" ++ chan_name(chan) ++ "` is a channel of another scheduler",
    labels: [primary(site, "this handle was made by another scheduler")],
    notes: [
      "every scheduler numbers its own channels, so here the handle's id names another channel, or none",
      "use a channel inside the simulation that made it",
    ],
  }

fn foreign_task(site: Site, task: Int) -> Failure =
  {
    code: "E0413",
    message: "`" ++ task_name(task) ++ "` is a task of another scheduler",
    labels: [primary(site, "this handle was spawned by another scheduler")],
    notes: [
      "every scheduler numbers its own tasks, so here the handle's id names another task, or none",
      "join the task inside the simulation that spawned it",
    ],
  }

fn unknown_task(site: Site, task: Int) -> Failure =
  {
    code: "E0413",
    message: "`" ++ task_name(task) ++ "` names no task in this simulation",
    labels: [primary(site, "this handle outlived the simulation that created it")],
    notes: [
      "a `Task` is a key into its simulation's scheduler, and the scheduler ends with the simulation",
      "join the task inside the simulation that spawned it",
    ],
  }

/// What a join of a cancelled task raises in the joiner.
fn joined_cancelled(site: Site, task: Int) -> Failure =
  {
    code: "E0502",
    message: "`" ++ task_name(task) ++ "` was cancelled, so it has nothing to join",
    labels: [primary(site, "joined here")],
    notes: [
      "`task.await` answers `None` for a cancelled task, where `task.join` has no answer to give",
    ],
  }

/// What a `task.channel` of a negative capacity raises in the requesting task.
fn negative_capacity(site: Site, capacity: Int) -> Failure =
  {
    code: "E0502",
    message: "a channel cannot hold " ++ capacity.to_string() ++ " values",
    labels: [primary(site, "made here")],
    notes: ["a capacity is how many sent values may wait for a receiver; `0` is a rendezvous"],
  }

/// What a `random.below` of a bound below one raises in the requesting task.
fn invalid_bound(site: Site, bound: Int) -> Failure =
  {
    code: "E0502",
    message: "`random.below` needs a bound above zero, but got " ++ bound.to_string(),
    labels: [primary(site, "this bound names no value to draw")],
    notes: [
      "`random.below(n)` answers a value in `0..n`, which is empty for `n <= 0`",
      "guard the bound, or use `random.next()` for the whole range",
    ],
  }

fn invalid_cancel(site: Site, target: Int, task: Int) -> Failure =
  {
    code: "E0502",
    message: task_name(target) ++ " cannot be cancelled from " ++ task_name(task),
    labels: [primary(site, "cancelled here")],
    notes: [
      "a task cancels another one: the simulation's own body, and a task itself, are not cancelled",
    ],
  }

// --- The runtime's part -----------------------------------------------------------------

/// A value of any type stored with its type's descriptor: what is marshalled between a perform of
/// an operation that is generic in its own type parameters and the clause that handles it.
pub extern type Kept

/// `x` wrapped as a `Kept`.
extern fn keep<a>(x: a) -> Kept

/// The value of type `a` that `k` wraps. The run fails if `k` wraps a value of another type.
extern fn open<a>(k: Kept) -> a

/// The stacks of one scheduler's tasks, the switch between each task and the scheduler's loop, and
/// each task's last request and reply. Each stack is freed when its last owner releases it.
pub extern type Stacks

/// A task's body and the words its effects take, as its creator had them, until it starts.
pub extern type TaskBody

/// Stacks for a scheduler opened here, `seeded` for `simulate`, for the scheduler written at the
/// site that `root`, `start` and `end` give.
extern fn stacks_opened(seeded: Bool, root: Int, start: Int, end: Int) -> Stacks / {native.write}

/// The id of `s`'s scheduler among the entry's schedulers.
extern fn stacks_region(s: Stacks) -> Int / {native.read}

/// Where the scheduler opened on the context before `s`'s was written, a seeded one's or else a
/// production one's: the site's root, start or end by `which`, with a root of -1 if there is none.
extern fn stacks_outer(s: Stacks, which: Int) -> Int / {native.read}

/// `body`, from which the program's own work runs: its cost counting continues from where it
/// stopped.
extern fn program_resumed<a>(body: a) -> a

/// `answer` wrapped as a `Kept`, with the program's own work ending there: what follows is the
/// scheduler's work.
extern fn program_paused<a>(answer: a) -> Kept

/// What `body` returns, wrapped as a `Kept`, when run as a task's body. The program's own work in
/// it is counted, and the scheduler's work around it is not.
fn task_ran<a | e>(body: keep () -> a / e) -> Kept / e = program_paused(program_resumed(body)())

/// A task's handle at the type its perform or its clause uses: the same handle.
extern fn task_as<a, b>(t: Task<a>) -> Task<b>

/// A channel's handle at the type its perform or its clause uses: the same handle.
extern fn chan_as<a, b>(c: Chan<a>) -> Chan<b>

/// The trail the entry's last simulation left (`trail::encode_saved_trail`), empty before its
/// first.
extern fn trail_entered() -> Bytes / {native.read}

/// The root of the seed the driver set: its high 32 bits for `which` 0, its low ones for 1.
extern fn seed_root(which: Int) -> Int / {native.read}

/// The seed's path, each choice in two bytes, the least significant first.
extern fn seed_path() -> Bytes / {native.read}

/// The scheduling points the entry's simulations may take.
extern fn seeded_steps() -> Int / {native.read}

/// Stores `final_trail` for the entry's next scheduler, and `interleaving` as its outcome's
/// interleaving.
extern fn trail_left(final_trail: Bytes, interleaving: Bytes) -> Unit / {native.write}

/// The location of the site that `root`, `start` and `end` give, as an outcome reports it
/// (`trail::location_of`).
extern fn site_placed(root: Int, start: Int, end: Int) -> Bytes

/// What the running seeded step accessed since this was last called (`trail::touches_of`).
extern fn footprint_taken() -> Bytes / {native.write}

/// How many accesses the running seeded step made since `footprint_taken` was last called.
extern fn footprint_held() -> Int / {native.read}

/// `body`, which returns into `t`, with the words its effects take as the caller has them.
extern fn task_body<| e>(t: Task<Kept>, body: keep () -> Kept / e) -> TaskBody

/// Creates task `id`, which runs `b`'s body the first time the loop resumes it, and numbers its
/// handle `id`.
extern fn task_started(s: Stacks, id: Int, b: TaskBody) -> Unit / {native.write}

/// Runs task `id` until it makes a request of its loop, passing it `code` and `n`, where a code of
/// -1 unwinds after a cancel. Returns the code of the request, never below 0, or how its body
/// ended: -1 returned, -2 unwound, -3 raised what nothing in it handled, -4 failed.
extern fn task_resumed(s: Stacks, id: Int, code: Int, n: Int) -> Int / {native.write}

/// `task_resumed`, passing the task `kept` as well.
extern fn task_resumed_kept(
  s: Stacks,
  id: Int,
  code: Int,
  n: Int,
  kept: Kept,
) -> Int / {native.write}

/// `task_resumed`, with the task raising at its perform the failure that `failure_bytes` encoded.
extern fn task_resumed_raising(s: Stacks, id: Int, failure: Bytes) -> Int / {native.write}

/// The `i`th number of the last resumed task's request.
extern fn asked_number(s: Stacks, i: Int) -> Int / {native.read}

/// Where the last resumed task was when it made its request: the site's root, start or end by
/// `i`.
extern fn asked_site(s: Stacks, i: Int) -> Int / {native.read}

/// Takes the value the last resumed task passed with its request.
extern fn asked_kept(s: Stacks) -> Kept / {native.write}

/// The running task sends its loop the request `code`, `a` and `b`, placed where the perform its
/// clause handles was, and waits. Returns the code the loop resumes it with. If resumed to unwind
/// or to raise, it does so.
extern fn task_yielded(s: Stacks, code: Int, a: Int, b: Int) -> Int / {native.write}

/// `task_yielded`, passing the loop `kept` as well.
extern fn task_yielded_kept(
  s: Stacks,
  code: Int,
  a: Int,
  b: Int,
  kept: Kept,
) -> Int / {native.write}

/// The number the loop resumed the running task with.
extern fn heard_number(s: Stacks) -> Int / {native.read}

/// Takes the value the loop resumed the running task with.
extern fn heard_kept(s: Stacks) -> Kept / {native.write}

/// Frees task `id`: its stack, a body it never ran, and the scheduler's reference to its handle.
extern fn task_freed(s: Stacks, id: Int) -> Unit / {native.write}

/// Restores the context that task `id`'s body left without returning, adding `note` if it is not
/// empty. Returns whether the body left anything.
extern fn task_restored(s: Stacks, id: Int, note: String) -> Bool / {native.write}

/// The brackets task `id` is inside, by `which`: its `acquire`s, its `release`s, and 1 if a cancel
/// waits for it to leave them.
extern fn task_shields(s: Stacks, id: Int, which: Int) -> Int / {native.read}

/// Sets whether a cancel of task `id` waits for it to leave the brackets it is inside.
extern fn task_held_back(s: Stacks, id: Int, stop_task: Bool) -> Unit / {native.write}

/// Records on task `id`'s handle that it was cancelled.
extern fn task_settled(s: Stacks, id: Int) -> Unit / {native.write}

/// A handle for a task of scheduler `scheduler`, numbered when the scheduler starts it.
extern fn task_made(region: Int) -> Task<Kept>

/// A field of `t`, by `which`: its scheduler, its id, or how it ended (0 not yet, 1 returned, 2
/// cancelled).
extern fn task_said(t: Task<Kept>, which: Int) -> Int / {native.read}

/// The result of the task `t` refers to. The run fails if it has not returned.
extern fn task_answer(t: Task<Kept>) -> Kept / {native.read}

/// A handle of channel `id` of scheduler `scheduler`.
extern fn chan_made(region: Int, id: Int) -> Chan<Kept>

/// A field of `c`, by `which`: its scheduler or its id.
extern fn chan_said(c: Chan<Kept>, which: Int) -> Int

/// Fails the run with the scheduler's failure that `failure_bytes` encoded.
extern fn region_failed(failure: Bytes) -> Unit / {native.write}

/// Makes `tickets_answered` report the ticket for `token` once it is completed. Returns 1, or 0
/// with the run failed for a ticket the run did not issue.
extern fn ticket_watch(token: Int) -> Int / {native.write}

/// The watched tickets completed and not yet taken, ascending, each token eight bytes, least
/// significant first.
extern fn tickets_answered() -> Bytes / {native.read}

/// Waits until a watched ticket is completed, the run is told to stop, or the run's clock reaches
/// `deadline` if it is not below 0. Returns 1, or 0 with the run failed if it watches nothing and
/// has no deadline, since nothing would end the wait.
extern fn tickets_park(deadline: Int) -> Int / {native.read}

/// The run's clock: nanoseconds since it began.
extern fn host_now() -> Int / {native.read}

/// Records what the run still has when its root's body returns, before the scheduler whose stacks
/// are `s` drains its other tasks: `scheduled` tasks still present, and the stacks it keeps.
extern fn root_returned(s: Stacks, scheduled: Int) -> Unit / {native.write}

/// 1 if the run has been told to stop, else 0.
extern fn run_stopping() -> Int / {native.read}

/// 1, with the run failed and reporting it, if its drain after a stop has run out of time; else 0.
extern fn run_drained() -> Int / {native.write}

// --- How a perform is marshalled ------------------------------------------------------------

// A perform of a `task` operation at a type other than `Kept` becomes a call of its marshalling
// function here. Each value of the operation's type parameter is wrapped as a `Kept`, a function
// returning one is wrapped to wrap its result, and a result containing one is unwrapped. Each
// marshalling function's own perform is at `Kept`, annotated where nothing else fixes its type:
// the emitter rejects a perform here at another type, which would call itself.

/// `task.spawn(body)` at `a`, with the body's result wrapped.
pub fn crossing_spawn<a | e>(body: keep () -> a / e) -> Task<a> / {task.spawn | e} =
  task_as(task.spawn(|| task_ran(body)))

/// `task.join(t)` at `a`, with the result unwrapped.
pub fn crossing_join<a>(t: Task<a>) -> a / {task.join, abort.raise} = open(task.join(task_as(t)))

/// `task.cancel(t)` at `a`.
pub fn crossing_cancel<a>(t: Task<a>) -> Bool / {task.cancel} = {
  let kept: Task<Kept> = task_as(t);
  task.cancel(kept)
}

/// `task.await(t)` at `a`, with a result unwrapped.
pub fn crossing_await<a>(t: Task<a>) -> Option<a> / {task.await} =
  match task.await(task_as(t)) { Some(k) -> Some(open(k)), None -> None }

/// `task.channel(capacity)` at `a`.
pub fn crossing_channel<a>(capacity: Int) -> Chan<a> / {task.channel, abort.raise} = {
  let kept: Chan<Kept> = task.channel(capacity);
  chan_as(kept)
}

/// `task.send(c, x)` at `a`, with `x` wrapped.
pub fn crossing_send<a>(c: Chan<a>, x: a) -> Bool / {task.send} = task.send(chan_as(c), keep(x))

/// `task.recv(c)` at `a`, with what it receives unwrapped.
pub fn crossing_recv<a>(c: Chan<a>) -> Option<a> / {task.recv} =
  match task.recv(chan_as(c)) { Some(k) -> Some(open(k)), None -> None }

/// `task.close(c)` at `a`.
pub fn crossing_close<a>(c: Chan<a>) -> Unit / {task.close} = {
  let kept: Chan<Kept> = chan_as(c);
  task.close(kept)
}

/// `task.select(arms, wait)` at `a`, with each value an arm sends wrapped and the one received
/// unwrapped.
pub fn crossing_select<a>(
  arms: List<(Chan<a>, Option<a>)>,
  wait: Bool,
) -> Option<(Int, Option<a>)> / {task.select} =
  match task.select(
      arms.map(|arm: (Chan<a>, Option<a>)|
        (chan_as(arm._0), match arm._1 { Some(x) -> Some(keep(x)), None -> None })),
      wait,
    ) {
    Some(went) -> Some((went._0, match went._1 { Some(k) -> Some(open(k)), None -> None })),
    None -> None,
  }

// --- Requests and replies -------------------------------------------------------------------

// The code of each request a clause sends its loop, never below 0.
fn spawn_code() -> Int = 0
fn join_code() -> Int = 1
fn await_code() -> Int = 2
fn cancel_code() -> Int = 3
fn channel_code() -> Int = 4
fn send_code() -> Int = 5
fn recv_code() -> Int = 6
fn close_code() -> Int = 7
fn select_code() -> Int = 8
fn yield_code() -> Int = 9
fn now_code() -> Int = 10
fn sleep_code() -> Int = 11
fn next_code() -> Int = 12
fn below_code() -> Int = 13
fn seed_code() -> Int = 14
// The runtime itself sends this and `sleep_code` for a host operation or a native's job that
// waits on the run or its clock; `tasks.rs` calls them `ASK_TICKET` and `ASK_SLEEP`.
fn ticket_code() -> Int = 15

// How a task's body ended, as `task_resumed` returns it: below 0, where no request code is.
fn body_returned() -> Int = 0 - 1
fn body_unwound() -> Int = 0 - 2
fn body_raised() -> Int = 0 - 3

// How the loop resumes a task: to start or unwind, or with a reply, by code and number.
fn resume_start() -> Int = 0
fn resume_unwind() -> Int = 0 - 1
fn nothing_reply_code() -> Int = 1
fn flag_reply_code() -> Int = 2
fn number_reply_code() -> Int = 3
fn received_reply_code() -> Int = 4
fn closed_reply_code() -> Int = 5
fn selected_reply_code() -> Int = 6

/// The running task sends its loop request `code` about the task `t`: its id, then its scheduler
/// and how its handle records it ended, packed in one number.
fn request_on_task(s: Stacks, code: Int, t: Task<Kept>) -> Int / {native.read, native.write} =
  task_yielded(s, code, task_said(t, 1), task_said(t, 0) * 4 + task_said(t, 2))

/// The brackets task `id` is inside.
fn shields_of(s: Stacks, id: Int) -> Shields / {native.read} =
  {
    acquiring: task_shields(s, id, 0),
    releasing: task_shields(s, id, 1),
    stopping: task_shields(s, id, 2) != 0,
  }

/// The brackets task `id`, which just made a request, is inside, if a cancel waits for it to leave
/// them. This is all a request reads of them.
fn waited_shields(s: Stacks, id: Int) -> Shields / {native.read} =
  if task_shields(s, id, 2) == 0 { { acquiring: 0, releasing: 0, stopping: false } }
  else { shields_of(s, id) }

/// The task a request refers to, from the numbers it was sent with.
fn requested_task(s: Stacks) -> TaskRef / {native.read} = {
  let b = asked_number(s, 1);
  {
    scheduler: b / 4,
    id: asked_number(s, 0),
    ended: match b % 4 { 1 -> Returned, 2 -> Cancelled, _ -> Live },
  }
}

/// The channel a request refers to, from the numbers it was sent with.
fn requested_channel(s: Stacks) -> ChanRef / {native.read} =
  { scheduler: asked_number(s, 1), id: asked_number(s, 0) }

/// The request the loop just received from task `id`, with code `code`.
fn request_of(
  s: Stacks,
  r: Scheduler<Kept>,
  id: Int,
  code: Int,
) -> Request<Kept> / {native.read, native.write} = {
  // The most common codes come first, since each code read is a call.
  if code == yield_code() { Yield }
  else if code == send_code() { Send(requested_channel(s), asked_kept(s)) }
  else if code == recv_code() { Recv(requested_channel(s)) }
  else if code == below_code() { Below(asked_number(s, 0)) }
  else if code == next_code() { Next }
  else if code == now_code() { Now }
  else if code == sleep_code() { Sleep(asked_number(s, 0)) }
  else if code == ticket_code() { Ticket(asked_number(s, 0)) }
  else if code == spawn_code() { Spawn }
  else if code == join_code() { Join(requested_task(s)) }
  else if code == await_code() { Await(requested_task(s)) } else if code == cancel_code() {
    let task = requested_task(s);
    Cancel(task, shields_of(s, task.id))
  } else if code == channel_code() { Channel(asked_number(s, 0)) }
  else if code == close_code() { Close(requested_channel(s)) }
  else if code == select_code() { Select(open(asked_kept(s)), asked_number(s, 0) != 0) }
  else if code == seed_code() { Seed }
  else if code == body_returned() { Finished }
  else if code == body_unwound() { Unwound } else if code == body_raised() {
    Raised(
      r.tasks.keys().fold(Map::new(), |m: Map<Int, Shields>, other: Int|
        if other == id { m } else { m.insert(other, shields_of(s, other)) }),
    )
  } else { Failed }
}

// How a scheduler's clause handles each `task` operation: the running task of the scheduler whose
// stacks are `s` sends a request to its loop.

fn request_join(s: Stacks, t: Task<Kept>) -> Kept / {native.read, native.write} = {
  request_on_task(s, join_code(), t);
  task_answer(t)
}

fn request_await(s: Stacks, t: Task<Kept>) -> Option<Kept> / {native.read, native.write} =
  if request_on_task(s, await_code(), t) == flag_reply_code() && heard_number(s) == 1 {
    Some(task_answer(t))
  } else { None }

fn request_cancel(s: Stacks, t: Task<Kept>) -> Bool / {native.read, native.write} = {
  request_on_task(s, cancel_code(), t);
  heard_number(s) == 1
}

fn request_yield(s: Stacks) -> Unit / {native.write} = {
  task_yielded(s, yield_code(), 0, 0);
  ()
}

fn request_channel(
  s: Stacks,
  region: Int,
  capacity: Int,
) -> Chan<Kept> / {native.read, native.write} = {
  task_yielded(s, channel_code(), capacity, 0);
  chan_made(region, heard_number(s))
}

fn request_send(s: Stacks, c: Chan<Kept>, x: Kept) -> Bool / {native.read, native.write} = {
  task_yielded_kept(s, send_code(), chan_said(c, 1), chan_said(c, 0), x);
  heard_number(s) == 1
}

fn request_recv(s: Stacks, c: Chan<Kept>) -> Option<Kept> / {native.write} =
  if task_yielded(s, recv_code(), chan_said(c, 1), chan_said(c, 0)) == received_reply_code() {
    Some(heard_kept(s))
  } else { None }

fn request_close(s: Stacks, c: Chan<Kept>) -> Unit / {native.write} = {
  task_yielded(s, close_code(), chan_said(c, 1), chan_said(c, 0));
  ()
}

fn request_select(
  s: Stacks,
  arms: List<(Chan<Kept>, Option<Kept>)>,
  wait: Bool,
) -> Option<(Int, Option<Kept>)> / {native.write} = {
  let handle_request = arms.map(|arm: (Chan<Kept>, Option<Kept>)|
    { chan: { scheduler: chan_said(arm._0, 0), id: chan_said(arm._0, 1) }, send: arm._1 });
  task_yielded_kept(s, select_code(), if wait { 1 } else { 0 }, 0, keep(handle_request));
  let went: Option<{ at: Int, got: Option<Kept> }> = open(heard_kept(s));
  match went { Some(w) -> Some((w.at, w.got)), None -> None }
}

/// Resumes task `id` as `res`. Returns the code of its next request, or of how its body ended.
fn resume_task(s: Stacks, id: Int, res: Resumption<Kept>) -> Int / {abort.raise, native.write} =
  match res {
    Start -> task_resumed(s, id, resume_start(), 0),
    Unwind -> task_resumed(s, id, resume_unwind(), 0),
    Raise(f) -> task_resumed_raising(s, id, failure_bytes(f)),
    Resume(incoming) -> match incoming {
      Nothing -> task_resumed(s, id, nothing_reply_code(), 0),
      Flag(b) -> task_resumed(s, id, flag_reply_code(), if b { 1 } else { 0 }),
      Number(n) -> task_resumed(s, id, number_reply_code(), n),
      Spawned(n) -> task_resumed(s, id, number_reply_code(), n),
      ChannelCreated(n) -> task_resumed(s, id, number_reply_code(), n),
      Joined -> task_resumed(s, id, nothing_reply_code(), 0),
      Awaited(b) -> task_resumed(s, id, flag_reply_code(), if b { 1 } else { 0 }),
      Received(Some(k)) -> task_resumed_kept(s, id, received_reply_code(), 0, k),
      Received(None) -> task_resumed(s, id, closed_reply_code(), 0),
      Selected(went) -> task_resumed_kept(s, id, selected_reply_code(), 0, keep(went)),
    },
  }

// --- `simulate`'s scheduler ---------------------------------------------------------------------

/// `simulate`'s scheduler, written at the site that `root`, `start` and `end` give. `body` runs as
/// its task 0, and every task's `task`, `clock`, `random` and `sim` operations are handled here, in
/// the order the entry's seed picks. A raise that leaves a task lands where the scheduler is
/// written, once every other task has ended. A scheduler that ends any other way fails the run.
pub fn simulated<a | e>(
  root: Int,
  start: Int,
  end: Int,
  body: keep () -> a / {task.write, clock.read, clock.write, random.write, sim.read | e},
) -> a / {abort.raise, native.read, native.write | e} = {
  let stacks = stacks_opened(true, root, start, end);
  let id = stacks_region(stacks);
  let site = { root: root, start: start, end: end };
  let root_task = task_made(id);
  handle {
    if stacks_outer(stacks, 0) >= 0 {
      let outer = {
        root: stacks_outer(stacks, 0),
        start: stacks_outer(stacks, 1),
        end: stacks_outer(stacks, 2),
      };
      region_failed(failure_bytes(nested(site, outer)))
    } else {
      task_started(stacks, 0, task_body(root_task, || task_ran(body)));
      run_simulation(stacks, id, site)
    };
    open(task_answer(root_task))
  } with {
    task.spawn(f) -> {
      let t = task_made(id);
      task_yielded_kept(stacks, spawn_code(), 0, 0, keep(task_body(t, f)));
      t
    },
    task.join(t) -> request_join(stacks, t),
    task.await(t) -> request_await(stacks, t),
    task.cancel(t) -> request_cancel(stacks, t),
    task.yield() -> request_yield(stacks),
    task.channel(n) -> request_channel(stacks, id, n),
    task.send(c, x) -> request_send(stacks, c, x),
    task.recv(c) -> request_recv(stacks, c),
    task.close(c) -> request_close(stacks, c),
    task.select(arms, wait) -> request_select(stacks, arms, wait),
    clock.now() -> {
      task_yielded(stacks, now_code(), 0, 0);
      Instant(heard_number(stacks))
    },
    clock.sleep(d) -> {
      task_yielded(stacks, sleep_code(), match d { Duration(n) -> n }, 0);
      ()
    },
    random.next() -> {
      task_yielded(stacks, next_code(), 0, 0);
      heard_number(stacks)
    },
    random.below(n) -> {
      task_yielded(stacks, below_code(), n, 0);
      heard_number(stacks)
    },
    sim.seed() -> {
      task_yielded(stacks, seed_code(), 0, 0);
      heard_number(stacks)
    },
  }
}

/// The trail the entry's schedulers left, or the seed's own before the first.
fn load_trail() -> trail::SavedTrail / {abort.raise, native.read} =
  match trail::decode_saved_trail(trail_entered()) {
    Some(l) -> l,
    None -> {
      let path = seed_path();
      {
        trail: trail::trail(
          {
            root: U64::of_int(seed_root(0)) << 32 | U64::of_int(seed_root(1)),
            path: range(0, path.len() / 2).map(|i: Int| path.at(2 * i) + 256 * path.at(2 * i + 1)),
          },
          seeded_steps(),
        ),
        written: trail::no_steps(),
      }
    },
  }

/// `simulate`'s loop over the stacks `s` of scheduler `id` written at `site`. It runs the task each
/// turn names and applies its requests until the scheduler ends. Then it stores the trail and
/// returns, fails the run, or lands the raise that left a task, depending on how the scheduler
/// ended.
fn run_simulation(
  s: Stacks,
  id: Int,
  site: Site,
) -> Unit / {abort.raise, native.read, native.write} = {
  let entered = load_trail();
  let r = iterate(
    seeded(id, site, entered.trail),
    entered.trail.budget + 2,
    |region: Scheduler<Kept>| {
      let chosen = next_turn(region, { now: 0, stopping: false });
      match chosen.turn {
        Run(task, res) -> {
          let code = resume_task(s, task, res);
          let child = chosen.next_id;
          let context = {
            site: { root: asked_site(s, 0), start: asked_site(s, 1), end: asked_site(s, 2) },
            acquire_release_depth: waited_shields(s, task),
            now: 0,
          };
          let touched = if footprint_held() == 0 { chosen }
          else { add_touches(chosen, footprint_taken()) };
          let request = request_of(s, touched, task, code);
          let next = handle_request(touched, task, request, context);
          if next.next_id > child && code == spawn_code() {
            task_started(s, child, open(asked_kept(s)))
          };
          let given = run_commands(s, next);
          if code < 0 && (code == body_returned() || code == body_unwound()) {
            task_freed(s, task)
          };
          Continue(given)
        },
        _ -> Stop(chosen),
      }
    },
  );
  let written = trail::encode_steps(entered.written, steps_taken(r), |context: Site|
    trail::location_of(site_placed(context.root, context.start, context.end)));
  trail_left(
    trail::encode_saved_trail({ trail: final_trail(r), written: written }),
    trail::interleaving_of(written, r.now),
  );
  match r.turn {
    Complete -> (),
    Reraise(task) -> {
      task_restored(s, task, raised_note(r, task));
      ()
    },
    Ends(SchedulerFailed(f)) -> region_failed(failure_bytes(f)),
    Ends(TaskFailed(task, note)) -> {
      task_restored(s, task, match note { Some(n) -> n, None -> "" });
      ()
    },
    _ -> region_failed(failure_bytes(internal_error(r, "a simulation waited on the host"))),
  }
}

/// `r` with what the running task's step performed, which the runtime wrote as `effects`, added
/// to the step's accesses.
fn add_touches(r: Scheduler<Kept>, footprint: Bytes) -> Scheduler<Kept> / {abort.raise} =
  match r.touches.get(footprint) {
    Some(touches) -> record_accesses(r, touches),
    None -> {
      let touches = trail::touches_of(footprint);
      record_accesses({ ..r, touches: r.touches.insert(footprint, touches) }, touches)
    },
  }

/// The note a scheduler adds when it re-raises a raise that left task `task`, if the scheduler
/// spawned any task: the task, and the seed that replays the run.
fn raised_note(r: Scheduler<Kept>, task: Int) -> String / {abort.raise} =
  if r.next_id <= 1 { "" } else {
    "raised in task " ++ task_name(task) ++ " of a simulation; replay with seed "
      ++ trail::seed_text(r.trail.seed)
  }

/// The scheduler after the loop has carried out each command it issued since they were last taken.
fn run_commands(s: Stacks, r: Scheduler<Kept>) -> Scheduler<Kept> / {native.write} =
  if r.orders.len() == 0 { r } else {
    let given = take_commands(r);
    given.orders.fold((), |_u: Unit, o: Command| run_command(s, o));
    given.scheduler
  }

/// Carries out a command the scheduler issued.
fn run_command(s: Stacks, o: Command) -> Unit / {native.write} =
  match o {
    DelayCancel(id) -> task_held_back(s, id, true),
    LetThrough(id) -> task_held_back(s, id, false),
    Discard(id) -> task_freed(s, id),
    MarkCancelled(id) -> task_settled(s, id),
    DropRaise(id) -> task_freed(s, id),
  }

// --- The run's scheduler ------------------------------------------------------------------------

/// The run's scheduler, under which an entry runs a root that performs `task`. `body` runs as its
/// task 0, and every task's `task` operations are handled here, ready tasks first in, first out. A
/// task that waits on the host or sleeps waits here while the others run. It returns once every
/// task has ended. A raise that leaves a task lands at the entry once every other task has ended.
pub fn scheduled<a | e>(
  body: keep () -> a / {task.write | e},
) -> a / {abort.raise, native.read, native.write, diverges | e} = {
  let stacks = stacks_opened(false, nowhere().root, 0, 0);
  let id = stacks_region(stacks);
  let root_task = task_made(id);
  handle {
    task_started(stacks, 0, task_body(root_task, || task_ran(body)));
    run_scheduler(stacks, id);
    open(task_answer(root_task))
  } with {
    task.spawn(f) -> {
      let t = task_made(id);
      task_yielded_kept(stacks, spawn_code(), 0, 0, keep(task_body(t, f)));
      t
    },
    task.join(t) -> request_join(stacks, t),
    task.await(t) -> request_await(stacks, t),
    task.cancel(t) -> request_cancel(stacks, t),
    task.yield() -> request_yield(stacks),
    task.channel(n) -> request_channel(stacks, id, n),
    task.send(c, x) -> request_send(stacks, c, x),
    task.recv(c) -> request_recv(stacks, c),
    task.close(c) -> request_close(stacks, c),
    task.select(arms, wait) -> request_select(stacks, arms, wait),
  }
}

/// The run's loop over the stacks `s` of scheduler `id`. It runs the task each turn names and
/// applies its requests, waiting on the run when none is ready, until the scheduler ends. Then it
/// returns, fails the run, or lands the raise that left a task, depending on how the scheduler
/// ended.
fn run_scheduler(s: Stacks, id: Int) -> Unit / {abort.raise, native.read, native.write, diverges} = {
  let r = serve_loop(s, production(id, nowhere()));
  match r.turn {
    Complete -> (),
    Reraise(task) -> {
      task_restored(s, task, "");
      ()
    },
    Ends(SchedulerFailed(f)) -> region_failed(failure_bytes(f)),
    Ends(TaskFailed(task, note)) -> {
      task_restored(s, task, match note { Some(n) -> n, None -> "" });
      ()
    },
    Ends(Drained) -> (),
    _ -> region_failed(failure_bytes(internal_error(r, "the run's scheduler stopped waiting"))),
  }
}

/// The run's loop from `r`, up to a turn that runs nothing, which is stored in the scheduler it
/// returns. A drain after a stop that has run out of time has failed the run, which ends the loop.
fn serve_loop(
  s: Stacks,
  r: Scheduler<Kept>,
) -> Scheduler<Kept> / {abort.raise, native.read, native.write, diverges} =
  if run_drained() != 0 { { ..r, turn: Ends(Drained) } }
  else { serve_turn(s, next_turn(r, { now: host_now(), stopping: run_stopping() != 0 })) }

/// The run's loop after the turn stored in `r`.
fn serve_turn(
  s: Stacks,
  r: Scheduler<Kept>,
) -> Scheduler<Kept> / {abort.raise, native.read, native.write, diverges} =
  match r.turn {
    Run(task, res) -> {
      let code = resume_task(s, task, res);
      let child = r.next_id;
      let context = {
        site: { root: asked_site(s, 0), start: asked_site(s, 1), end: asked_site(s, 2) },
        acquire_release_depth: waited_shields(s, task),
        now: host_now(),
      };
      let request = request_of(s, r, task, code);
      match request { Ticket(token) -> ticket_watch(token), _ -> 0 };
      if task == 0 && code == body_returned() { root_returned(s, task_count(r)) };
      let next = handle_request(r, task, request, context);
      if next.next_id > child && code == spawn_code() {
        task_started(s, child, open(asked_kept(s)))
      };
      // Run the commands first: one may record how a task ended on its handle, which freeing drops.
      let given = run_commands(s, next);
      if code < 0 && (code == body_returned() || code == body_unwound()) { task_freed(s, task) };
      serve_loop(s, { ..given, spurious_wakeups: 0 })
    },
    Idle(deadline) -> {
      tickets_park(match deadline { Some(d) -> d, None -> 0 - 1 });
      let after = after_park(r, deadline, tokens_of(tickets_answered()), run_stopping() != 0);
      match after.ending { Some(e) -> { ..after, turn: Ends(e) }, None -> serve_loop(s, after) }
    },
    _ -> r,
  }

/// The scheduler after a wait on the run ended with `tokens` completed. Each task waiting on one of
/// them is readied. The scheduler fails if waits that could only end by a completion woke nothing
/// too many times in a row. A wait that a stop ended is how an idle service receives a signal, and
/// one bounded by `deadline` ends when it passes, so neither counts as a wasted wakeup.
fn after_park(
  r: Scheduler<Kept>,
  deadline: Option<Int>,
  tokens: List<Int>,
  stop_task: Bool,
) -> Scheduler<Kept> = {
  let parks = if tokens.len() == 0 && deadline == None && !stop_task { r.spurious_wakeups + 1 }
  else { 0 };
  let woken = wake_ticket_waiters(r, tokens);
  if parks > max_spurious_wakeups() {
    { ..fail_scheduler(woken, too_many_spurious_wakeups(woken)), spurious_wakeups: parks }
  } else { { ..woken, spurious_wakeups: parks } }
}

/// The tokens in `bytes`, each eight bytes, least significant first.
fn tokens_of(bytes: Bytes) -> List<Int> =
  range(0, bytes.len() / 8).map(|i: Int|
    Int::of_u32(bytes.u32_le(8 * i)) | Int::of_u32(bytes.u32_le(8 * i + 4)) << 32)

// --- The run's clock -------------------------------------------------------------------------

/// The language's `clock` where no `simulate` handles it, under which an entry runs a root that
/// performs it. It is the run's monotonic clock. A sleep by a task of the run's scheduler waits in
/// that scheduler while its other tasks run; anywhere else it blocks the thread.
pub fn clocked<a | e>(go: () -> a / {clock.read, clock.write | e}) -> a / {native.read | e} =
  handle {
    go()
  } with {
    clock.now() -> Instant(clock_now()),
    clock.sleep(d) -> clock_sleep(match d { Duration(n) -> n }),
  }

/// Nanoseconds on the run's monotonic clock.
extern fn clock_now() -> Int / {native.read}

/// Waits `nanos` nanoseconds, or not at all for a span at or below zero. A task of the run's
/// scheduler waits in the scheduler; anywhere else the thread waits.
extern fn clock_sleep(nanos: Int) -> Unit / {native.read}

// --- Tests --------------------------------------------------------------------------

fn here() -> RequestContext = { site: nowhere(), acquire_release_depth: unshielded(), now: 0 }

fn scheduler_site() -> Site = { root: 1, start: 0, end: 10 }

/// A simulation whose seed follows `path`, then picks the lowest enabled task.
fn seeded_by(path: List<Int>, budget: Int) -> Scheduler<Int> =
  seeded(
    0,
    scheduler_site(),
    trail::trail({ root: 0u64, path: path.concat(range(0, 200).map(|_i: Int| 0)) }, budget),
  )

fn lowest() -> Scheduler<Int> = seeded_by([], 1000)

fn next(r: Scheduler<Int>) -> Scheduler<Int> / {abort.raise} =
  next_turn(r, { now: 0, stopping: false })

/// The turn after the running `task` makes `request`.
fn then(t: Scheduler<Int>, task: Int, request: Request<Int>) -> Scheduler<Int> / {abort.raise} =
  next(handle_request(t, task, request, here()))

fn live(id: Int) -> TaskRef = { scheduler: 0, id: id, ended: Live }

fn chan(id: Int) -> ChanRef = { scheduler: 0, id: id }

fn code_of(t: Scheduler<Int>) -> String =
  match t.turn { Ends(SchedulerFailed(f)) -> f.code, _ -> "" }

test "the body runs first, and the region completes once every task has ended" {
  let t = next(lowest());
  assert_eq(t.turn, Run(0, Start));
  assert_eq(then(t, 0, Finished).turn, Complete)
}

test "a join waits for the task it names, which returns its result through its handle" {
  let apply_spawn = then(next(lowest()), 0, Spawn);
  assert_eq(apply_spawn.turn, Run(0, Resume(Spawned(1))));
  let wait_description = then(apply_spawn, 0, Join(live(1)));
  assert_eq(wait_description.turn, Run(1, Start));
  let apply_join = then(wait_description, 1, Finished);
  assert_eq(apply_join.turn, Run(0, Resume(Joined)));
  assert_eq(then(apply_join, 0, Join({ ..live(1), ended: Returned })).turn, Run(0, Resume(Joined)));
  assert_eq(then(apply_join, 0, Finished).turn, Complete)
}

test "a send on a rendezvous waits for the receive that takes it" {
  let made = then(next(lowest()), 0, Channel(0));
  assert_eq(made.turn, Run(0, Resume(ChannelCreated(0))));
  let sending = then(then(made, 0, Spawn), 0, Send(chan(0), 7));
  assert_eq(sending.turn, Run(1, Start));
  let taken = then(sending, 1, Recv(chan(0)));
  assert_eq(taken.turn, Run(0, Resume(Flag(true))));
  assert_eq(then(taken, 0, Finished).turn, Run(1, Resume(Received(Some(7)))))
}

test "a closed channel delivers what was queued, then nothing, and rejects a send" {
  let queued = then(then(next(lowest()), 0, Channel(2)), 0, Send(chan(0), 1));
  assert_eq(queued.turn, Run(0, Resume(Flag(true))));
  let first = then(then(queued, 0, Close(chan(0))), 0, Recv(chan(0)));
  assert_eq(first.turn, Run(0, Resume(Received(Some(1)))));
  let after = then(first, 0, Recv(chan(0)));
  assert_eq(after.turn, Run(0, Resume(Received(None))));
  assert_eq(then(after, 0, Send(chan(0), 2)).turn, Run(0, Resume(Flag(false))))
}

test "a select completes the first arm that can, and if none can, waits on every arm" {
  let two = then(then(then(next(lowest()), 0, Channel(0)), 0, Channel(1)), 0, Send(chan(1), 5));
  let arms = [{ chan: chan(0), send: None }, { chan: chan(1), send: None }];
  let went = then(two, 0, Select(arms, true));
  assert_eq(went.turn, Run(0, Resume(Selected(Some({ at: 1, got: Some(5) })))));
  assert_eq(then(went, 0, Select(arms, false)).turn, Run(0, Resume(Selected(None))));
  let wait_description = then(then(went, 0, Spawn), 0, Select(arms, true));
  assert_eq(wait_description.turn, Run(1, Start));
  let apply_send = then(wait_description, 1, Send(chan(0), 9));
  assert_eq(apply_send.turn, Run(0, Resume(Selected(Some({ at: 0, got: Some(9) })))));
  assert_eq(then(apply_send, 0, Finished).turn, Run(1, Resume(Flag(true))))
}

test "virtual time moves only when every task sleeps, waking one deadline's sleepers in task order" {
  let three = then(then(next(lowest()), 0, Spawn), 0, Spawn);
  let asleep = then(then(then(three, 0, Sleep(10)), 1, Sleep(10)), 2, Sleep(5));
  assert_eq(asleep.turn, Run(2, Resume(Nothing)));
  let early = then(asleep, 2, Now);
  assert_eq(early.turn, Run(2, Resume(Number(5))));
  let late = then(early, 2, Finished);
  assert_eq(late.turn, Run(0, Resume(Nothing)));
  assert_eq(then(late, 0, Now).turn, Run(0, Resume(Number(10))))
}

/// The body spawns task 1 and sleeps. Task 1 receives on a channel nothing sends to, and the body
/// wakes after it.
fn receiver_waiting() -> Scheduler<Int> / {abort.raise} = {
  let apply_spawn = then(then(next(lowest()), 0, Channel(0)), 0, Spawn);
  let receiving = then(then(apply_spawn, 0, Sleep(10)), 1, Recv(chan(0)));
  assert_eq(receiving.turn, Run(0, Resume(Nothing)));
  receiving
}

test "a cancel releases what the task waits on, and the task only unwinds" {
  let stopped = then(receiver_waiting(), 0, Cancel(live(1), unshielded()));
  assert_eq(stopped.turn, Run(0, Resume(Flag(true))));
  let again = then(stopped, 0, Cancel(live(1), unshielded()));
  assert_eq(again.turn, Run(0, Resume(Flag(false))));
  let awaiting = then(again, 0, Await(live(1)));
  assert_eq(awaiting.turn, Run(1, Unwind));
  let unwound = then(awaiting, 1, Unwound);
  assert_eq(unwound.turn, Run(0, Resume(Awaited(false))));
  assert(unwound.orders.contains(MarkCancelled(1)));
  assert_eq(then(unwound, 0, Join(live(1))).turn, Run(0, Raise(joined_cancelled(nowhere(), 1))))
}

test "a task cancelled inside a release keeps its wait, and the cancel waits for it to leave" {
  let releasing = { acquiring: 0, releasing: 1, stopping: false };
  let stopped = then(receiver_waiting(), 0, Cancel(live(1), releasing));
  assert_eq(stopped.turn, Run(0, Resume(Flag(true))));
  assert(stopped.orders.contains(DelayCancel(1)));
  // Still receiving, so a send reaches it.
  assert_eq(then(stopped, 0, Send(chan(0), 3)).turn, Run(0, Resume(Flag(true))))
}

test "a raise that leaves a task cancels the region's other tasks, and lands once they have ended" {
  let raising = then(receiver_waiting(), 0, Sleep(10));
  assert_eq(raising.turn, Run(0, Resume(Nothing)));
  let apply_spawn = then(raising, 0, Spawn);
  assert_eq(apply_spawn.turn, Run(0, Resume(Spawned(2))));
  let final_trail = then(apply_spawn, 0, Raised(Map::new()));
  assert_eq(final_trail.turn, Run(1, Unwind));
  let first = then(final_trail, 1, Unwound);
  // Task 2 never started, so it takes a step that runs nothing.
  assert_eq(first.turn, Reraise(0));
  assert_eq(first.raising, Some(0))
}

test "a sibling in a bracket's acquire keeps its reply, and the raise waits for it to unwind" {
  // The body spawns task 1, and the seed runs task 1 before the body receives its reply.
  let apply_spawn = then(next(seeded_by([0, 1], 1000)), 0, Spawn);
  assert_eq(apply_spawn.turn, Run(1, Start));
  let acquiring = Map::new().insert(0, { acquiring: 1, releasing: 0, stopping: false });
  let final_trail = then(apply_spawn, 1, Raised(acquiring));
  assert(final_trail.orders.contains(DelayCancel(0)));
  assert_eq(final_trail.turn, Run(0, Resume(Spawned(1))));
  // Its acquire returns, the cancel lands there, and its release runs as it unwinds.
  assert_eq(then(final_trail, 0, Unwound).turn, Reraise(1))
}

test "each step records what the scheduler orders it against" {
  let stopped = then(receiver_waiting(), 0, Cancel(live(1), unshielded()));
  let steps = steps_taken(stopped);
  let touched = |i: Int| match steps.at(i) { Some(s) -> s.accesses, None -> [] };
  assert_eq(steps.map(|s: Step| s.task), [0, 0, 0, 1, 0, 0]);
  assert(touched(0).contains(trail::new_channel_access()));
  // Task 1's receive, the last step it took, could have come after the cancel instead.
  assert(touched(3).contains(trail::channel_access(0)));
  assert(touched(3).contains(trail::liveness(1, Read)));
  assert(touched(4).contains(trail::liveness(1, Write)));
  assert(touched(4).contains(trail::channel_access(0)));
  assert_eq(touched(5), [])
}

test "a step is placed where it first accessed what another task could, else where it gave up control" {
  let context = |n: Int| { root: 1, start: n, end: n + 1 };
  let touched = record_accesses(next(lowest()), [
    { access: trail::ScopedValue(1, Write), at: context(2) },
    { access: trail::ScopedValue(2, Read), at: context(3) },
  ]);
  let first = next_turn(handle_request(touched, 0, Yield, { ..here(), site: context(4) }), {
    now: 0,
    stopping: false,
  });
  let second = handle_request(first, 0, Yield, { ..here(), site: context(5) });
  assert_eq(steps_taken(second).map(|s: Step| s.site), [Some(context(2)), Some(context(5))]);
  assert_eq(steps_taken(second).map(|s: Step| s.accesses), [
    [trail::ScopedValue(1, Write), trail::ScopedValue(2, Read)],
    [],
  ])
}

test "a deadlock names each blocked task where it waits" {
  let stuck = then(then(next(lowest()), 0, Channel(0)), 0, Recv(chan(0)));
  match stuck.turn {
    Ends(SchedulerFailed(f)) -> {
      assert_eq(f.code, "E0414");
      assert_eq(f.message, "this simulation deadlocked: 1 task is blocked and none runnable");
      assert_eq(f.labels.map(|l: Label| l.text), [
        "no task in this scheduler can make progress",
        "@0 waits here to receive from channel #0, which is empty",
      ]);
      assert_eq(
        f.notes.at(2),
        Some("replay with seed 0:" ++ String::join(range(0, 200).map(|_i: Int| "0"), ".")),
      )
    },
    _ -> assert(false),
  }
}

// The bytes `ply_compiled::tasks::failure_of` is tested on.
test "a failure is written as the runtime reads it" {
  let f = {
    code: "E0414",
    message: "m",
    labels: [{ at: { root: 2, start: 1, end: 3 }, primary: true, text: "t" }],
    notes: ["n"],
  };
  assert_eq(failure_bytes(f), b"\x05E0414\x01m\x01\x04\x02\x06\x01\x01t\x01\x01n")
}

test "a handle another region made is rejected" {
  let r = then(next(lowest()), 0, Join({ scheduler: 5, id: 1, ended: Live }));
  assert_eq(code_of(r), "E0413");
  assert_eq(code_of(then(next(lowest()), 0, Send({ scheduler: 5, id: 0 }, 1))), "E0413")
}

test "the step budget ends a region that never finishes, and a replay off its schedule diverges" {
  let spun = then(then(next(seeded_by([], 3)), 0, Yield), 0, Yield);
  assert_eq(code_of(then(spun, 0, Yield)), "E0414");
  assert_eq(code_of(then(next(seeded_by([0, 5], 10)), 0, Spawn)), "E0415")
}

fn produced() -> Scheduler<Int> / {abort.raise} = next(production(0, scheduler_site()))

fn at_time(
  t: Scheduler<Int>,
  task: Int,
  request: Request<Int>,
  now: Int,
) -> Scheduler<Int> / {abort.raise} =
  next_turn(handle_request(t, task, request, { ..here(), now: now }), { now: now, stopping: false })

test "a production region runs ready tasks first in, first out" {
  let apply_spawn = then(produced(), 0, Spawn);
  assert_eq(apply_spawn.turn, Run(1, Start));
  assert_eq(then(apply_spawn, 1, Yield).turn, Run(0, Resume(Spawned(1))))
}

test "a production task waits on its ticket while the region idles, and runs once it is completed" {
  let wait_description = then(produced(), 0, Ticket(42));
  assert_eq(wait_description.turn, Idle(None));
  assert_eq(next(wake_ticket_waiters(wait_description, [7, 42])).turn, Run(0, Resume(Nothing)))
}

test "a production sleeper runs once the run's clock reaches its deadline" {
  let asleep = at_time(produced(), 0, Sleep(100), 0);
  assert_eq(asleep.turn, Idle(Some(100)));
  assert_eq(next_turn(asleep, { now: 50, stopping: false }).turn, Idle(Some(100)));
  assert_eq(next_turn(asleep, { now: 100, stopping: false }).turn, Run(0, Resume(Nothing)))
}

test "a production scheduler deadlocks only with nothing waiting on the host" {
  let stuck = handle_request(then(produced(), 0, Channel(0)), 0, Recv(chan(0)), here());
  assert_eq(code_of(next_turn(stuck, { now: 0, stopping: false })), "E0414");
  assert_eq(next_turn(stuck, { now: 0, stopping: true }).turn, Idle(None))
}

test "a production scheduler keeps no task that has ended, and a join reads the handle" {
  let ended = then(then(produced(), 0, Spawn), 1, Finished);
  assert_eq(ended.turn, Run(0, Resume(Spawned(1))));
  assert_eq(task_count(ended), 1);
  assert_eq(then(ended, 0, Join({ ..live(1), ended: Returned })).turn, Run(0, Resume(Joined)));
  assert_eq(code_of(then(ended, 0, Join(live(1)))), "E0413")
}

test "a production task cancelled before it starts has its handle marked before it is freed" {
  let both = then(then(then(produced(), 0, Spawn), 1, Yield), 0, Spawn);
  assert_eq(both.turn, Run(1, Resume(Nothing)));
  let stopped = then(both, 1, Cancel(live(2), unshielded()));
  assert_eq(stopped.turn, Run(0, Resume(Spawned(2))));
  assert_eq(stopped.orders.filter(|o: Command| o == MarkCancelled(2) || o == Discard(2)), [
    MarkCancelled(2),
    Discard(2),
  ]);
  let incoming = then(stopped, 0, Await({ ..live(2), ended: Cancelled }));
  assert_eq(incoming.turn, Run(1, Resume(Flag(true))));
  assert_eq(then(incoming, 1, Yield).turn, Run(0, Resume(Awaited(false))))
}

/// A new run's scheduler, after `parks` waits in a row that woke nothing.
fn serving_at(parks: Int) -> Scheduler<Kept> =
  { ..production(0, scheduler_site()), spurious_wakeups: parks }

/// The code of the failure the scheduler ended with, if it failed.
fn failure_code(r: Scheduler<Kept>) -> String =
  match r.ending { Some(SchedulerFailed(f)) -> f.code, _ -> "" }

test "waits on the run that wake nothing fail the scheduler past the bound, and a wait a deadline or stop ended does not count" {
  assert_eq(failure_code(after_park(serving_at(max_spurious_wakeups()), None, [], false)), "E0505");
  assert_eq(failure_code(after_park(serving_at(max_spurious_wakeups() - 1), None, [], false)), "");
  assert_eq(
    [
      after_park(serving_at(max_spurious_wakeups()), Some(5), [], false),
      after_park(serving_at(max_spurious_wakeups()), None, [], true),
      after_park(serving_at(3), None, [7], false),
    ].map(|r: Scheduler<Kept>| r.spurious_wakeups),
    [0, 0, 0],
  )
}

test "the tickets the run completed decode from their bytes, least significant first" {
  assert_eq(tokens_of(b"\x01\x00\x00\x00\x00\x00\x00\x00\x02\x01\x00\x00\x00\x00\x00\x00"), [
    1,
    258,
  ]);
  assert_eq(tokens_of(b""), [])
}
