//! A region's scheduler as data: what its tasks wait on, what each request a task makes does to
//! them, and which task runs next. `simulate` takes its schedule from a seed and records each step;
//! a production region runs ready tasks first in, first out, and waits on the run's tickets and
//! clock where none is ready. Nothing here switches a stack or reads the host: a region's loop hands
//! each request in with what the runtime knows of it and runs the task each turn names.
//!
//! Values a task passes another (`v`) are held without being read. A task's answer is not among
//! them: the task's handle holds it, and the scheduler tells a joiner only that it is there.

import std.bin
import std.internal.trail as trail
import std.internal.trail (Trail, Site, nowhere, Access, Step, Read, Write, Took, Beyond, site_bin)
import std.list
import std.string

// --- What a region is told ------------------------------------------------------

pub type Policy = | Seeded | Production

/// Where a task stands in brackets: the `acquire`s and the `release`s it is inside, and whether a
/// cancel waits for it to leave them. The runtime keeps these, since a bracket is entered and left
/// without the scheduler.
pub type Shields = { acquiring: Int, releasing: Int, stopping: Bool }

/// No bracket.
pub fn unshielded() -> Shields = { acquiring: 0, releasing: 0, stopping: false }

/// A task's handle as its holder reads it: the region and the task it names, and how the task
/// ended where its handle has recorded that.
pub type TaskRef = { region: Int, id: Int, ended: Ended }

pub type Ended = | Live | Answered | Cancelled

/// A channel's handle: its region and its id there.
pub type ChanRef = { region: Int, id: Int }

/// What a task asks of its region when it gives control back.
pub type Request<v> =
  | Spawn
  | Join(TaskRef)
  | Await(TaskRef)
  /// The task to stop, and the brackets it stands in.
  | Cancel(TaskRef, Shields)
  /// A capacity of at least 0.
  | Channel(Int)
  | Send(ChanRef, v)
  | Recv(ChanRef)
  | Close(ChanRef)
  /// Each arm's channel beside what it sends, if anything, and whether to wait.
  | Select(List<{ chan: ChanRef, send: Option<v> }>, Bool)
  | Yield
  | Now
  /// Nanoseconds.
  | Sleep(Int)
  | Next
  /// A bound of at least 1.
  | Below(Int)
  | Seed
  /// Wait until the run's ticket of this token is answered.
  | Ticket(Int)
  /// The task's body answered, and its handle holds the answer.
  | Finished
  /// The task finished unwinding after a cancel.
  | Unwound
  /// A raise nothing in the task answered leaves it for the handlers around the region; the
  /// brackets each other task stands in, by task, where any.
  | Raised(Map<Int, Shields>)
  /// The task failed at run time; the runtime holds the failure.
  | Failed

/// What the runtime knows of a request: where it was performed, the brackets the task stands in,
/// and the run's clock, which a production region reads.
pub type Asked = { site: Site, shields: Shields, now: Int }

/// What a task hears when it runs again.
pub type Heard<v> =
  | Went
  | Flag(Bool)
  | Number(Int)
  /// The id of the task spawned.
  | Spawned(Int)
  /// The id of the channel made.
  | Made(Int)
  /// The task joined answered: its handle holds the answer.
  | Joined
  /// The task awaited answered (`true`) or was cancelled.
  | Awaited(Bool)
  | Received(Option<v>)
  /// The arm that went, by its place, beside what it took or sent.
  | Chose(Option<{ at: Int, got: Option<v> }>)

/// How a task runs again: from its body's start, answered, only to unwind, or raising.
pub type Resumption<v> = | Start | Resume(Heard<v>) | Unwind | Raise(Failure)

/// What runs next, or why nothing does.
pub type Turn<v> =
  | Run(Int, Resumption<v>)
  /// Every task ended, the body answering.
  | Complete
  /// Every task ended after this one's raise left it, which now lands at the region's site.
  | Reraise(Int)
  | Ends(Ending)
  /// A production region with nothing to run until a ticket is answered, the deadline passes
  /// where there is one, or the run is stopped.
  | Idle(Option<Int>)

pub type Turned<v> = { region: Region<v>, turn: Turn<v> }

/// How a region ends without its body's answer.
pub type Ending =
  /// The region's own failure.
  | Refused(Failure)
  /// A task failed at run time: the runtime's failure stands, with this note.
  | TaskFailed(Option<String>)

/// What the region's loop does for the scheduler, which only the runtime can.
pub type Order =
  /// A cancel waits until the task leaves the brackets it stands in.
  | HoldBack(Int)
  /// The task's cancel no longer waits.
  | LetThrough(Int)
  /// The task never started: its body and stack go.
  | Discard(Int)
  /// The task ended cancelled, which its handle records.
  | Settled(Int)
  /// The task's raise goes nowhere: another's already leaves the region.
  | DropRaise(Int)

/// A failure the region reports: a code, a message, labels at sites, and notes.
pub type Failure = { code: String, message: String, labels: List<Label>, notes: List<String> }

pub type Label = { at: Site, primary: Bool, text: String }

derive bin for Label
derive bin for Failure

/// `f` as the runtime reads the failure it fails a run with.
pub fn failure_bytes(f: Failure) -> Bytes / {abort.raise} = bin::encode(f, failure_bin())

/// What the region's host tells a production turn.
pub type Host = { now: Int, stopping: Bool }

// --- A region's state -------------------------------------------------------------

type Wait<v> =
  | Joining(Int)
  | Awaiting(Int)
  /// Until this deadline: virtual time in `simulate`, the run's clock in production.
  | Sleeping(Int)
  | Ticketed(Int)
  /// To send on the channel what it holds.
  | Sending(Int, v)
  | Receiving(Int)
  | Selecting(List<Arm<v>>)

type Arm<v> = { chan: Int, send: Option<v> }

type State<v> =
  | Ready(Resumption<v>)
  | Running
  | Blocked(Wait<v>, Site)
  | Done
  | Broke
  | Stopped
  /// Cancelled before it started, in `simulate`: enabled for one step that runs nothing, so the
  /// search has a step of the task to order against the cancel.
  | Dropped

/// One of the region's tasks.
type Member<v> = {
  id: Int,
  state: State<v>,
  origin: Site,
  joiners: List<Int>,
  /// A cancel reached it: a later one changes nothing, and every step it takes reads it.
  cancelled: Bool,
  /// Its vector clock, by task; a production region keeps none.
  stamp: List<Int>,
}

type Queued<v> = { value: v, stamp: List<Int> }

type Channel<v> = {
  capacity: Int,
  /// Sent and not yet received, each with its sender's clock as of the send.
  queue: List<Queued<v>>,
  senders: List<Int>,
  receivers: List<Int>,
  closed: Bool,
}

/// One region's scheduler. Tasks and channels are numbered from 0 in the region and never reused.
pub type Region<v> = {
  policy: Policy,
  id: Int,
  site: Site,
  tasks: Map<Int, Member<v>>,
  /// `simulate`'s enabled tasks, ascending, the order a choice indexes.
  ready: Map<Int, Unit>,
  /// A production region's ready tasks, first in first out.
  queue: List<Int>,
  timers: Map<(Int, Int), Unit>,
  /// A production region's tasks waiting on tickets, by token.
  tickets: Map<Int, Int>,
  channels: Map<Int, Channel<v>>,
  unfinished: Int,
  next_id: Int,
  next_chan: Int,
  current: Option<Int>,
  /// `simulate`'s virtual time, in nanoseconds since the region opened.
  now: Int,
  trail: Trail,
  /// The steps this region took.
  steps: List<Step>,
  ending: Option<Ending>,
  /// The task whose raise leaves the region once every other task has ended.
  raising: Option<Int>,
  orders: List<Order>,
}

/// A `simulate` region `id` at `site`, its body to run as task 0, choosing from `t`.
pub fn seeded<v>(id: Int, site: Site, t: Trail) -> Region<v> = opened(Seeded, id, site, t)

/// The run's production region, its root to run as task 0.
pub fn production<v>(id: Int, site: Site) -> Region<v> =
  opened(Production, id, site, trail::trail({ root: 0u64, path: [] }, 1))

fn opened<v>(policy: Policy, id: Int, site: Site, t: Trail) -> Region<v> =
  {
    policy: policy,
    id: id,
    site: site,
    tasks: Map::new().insert(0, {
      id: 0,
      state: Ready(Start),
      origin: site,
      joiners: [],
      cancelled: false,
      stamp: [0],
    }),
    ready: match policy { Seeded -> Map::new().insert(0, ()), Production -> Map::new() },
    queue: match policy { Seeded -> [], Production -> [0] },
    timers: Map::new(),
    tickets: Map::new(),
    channels: Map::new(),
    unfinished: 1,
    next_id: 1,
    next_chan: 0,
    current: None,
    now: 0,
    trail: t,
    steps: [],
    ending: None,
    raising: None,
    orders: [],
  }

/// The trail as the region leaves it, the virtual time it spent counted.
pub fn left<v>(r: Region<v>) -> Trail = { ..r.trail, virtual_time: r.now }

/// The orders the region gave since they were last taken, oldest first, and the region without them.
pub fn orders_taken<v>(r: Region<v>) -> { orders: List<Order>, region: Region<v> } =
  { orders: r.orders, region: { ..r, orders: [] } }

/// How many tasks the region holds: in `simulate` every one it spawned, in production those not
/// yet ended.
pub fn held<v>(r: Region<v>) -> Int = r.tasks.len()

// --- Turns -------------------------------------------------------------------------

/// What runs next, and the region as it stands once that is decided.
pub fn turned<v>(r: Region<v>, host: Host) -> Turned<v> / {abort.raise} =
  match r.ending {
    Some(e) -> { region: r, turn: Ends(e) },
    None -> match r.current {
      Some(task) ->
        ended_with(
          r,
          internal(
            r,
            task_name(task) ++ " was still running when the scheduler was asked for the next task",
          ),
        ),
      None -> match r.policy { Seeded -> seeded_turn(r), Production -> production_turn(r, host) },
    },
  }

fn ended_with<v>(r: Region<v>, f: Failure) -> Turned<v> = {
  let s = broke(r, f);
  { region: s, turn: match s.ending { Some(e) -> Ends(e), None -> Ends(Refused(f)) } }
}

/// `r` refused with `f`, unless it already ended otherwise.
fn broke<v>(r: Region<v>, f: Failure) -> Region<v> =
  match r.ending { Some(_) -> r, None -> { ..r, ending: Some(Refused(f)) } }

/// What a region whose tasks have all ended answers, and one where some wait for nothing.
fn finished_turn<v>(r: Region<v>) -> Turned<v> / {abort.raise} =
  if r.unfinished > 0 {
    ended_with(r, match r.policy { Seeded -> deadlock(r), Production -> host_deadlock(r) })
  } else {
    match r.raising {
      Some(task) -> { region: r, turn: Reraise(task) },
      None -> { region: r, turn: Complete },
    }
  }

fn seeded_turn<v>(r: Region<v>) -> Turned<v> / {abort.raise} =
  iterate(r, r.tasks.len() + r.timers.len() + 2, |s: Region<v>|
    match s.ending {
      Some(e) -> Stop({ region: s, turn: Ends(e) }),
      None -> {
        let enabled = s.ready.keys();
        if enabled.len() == 0 {
          match s.timers.first() {
            Some(earliest) -> Continue(advanced(s, earliest.key._0)),
            None -> Stop(finished_turn(s)),
          }
        } else if s.trail.points >= s.trail.budget { Stop(ended_with(s, step_budget(s))) } else {
          match trail::chosen(s.trail, enabled.len()) {
            Beyond(choice) ->
              Stop(ended_with(s, divergence(s, s.trail.points, choice, enabled.len()))),
            Took(c) -> stepped(s, enabled, c.choice, c.trail),
          }
        }
      },
    })

/// The scheduling point that takes `enabled`'s `choice`, recorded.
fn stepped<v>(
  s: Region<v>,
  enabled: List<Int>,
  choice: Int,
  t: Trail,
) -> Iter<Region<v>, Turned<v>> / {abort.raise} =
  match enabled.at(choice) {
    None -> Stop(ended_with(s, internal(s, "a scheduling point had no enabled task to choose"))),
    Some(id) -> match s.tasks.get(id) {
      None -> Stop(ended_with(s, internal(s, task_name(id) ++ " is not a task of this region"))),
      Some(task) -> {
        let stamp = ticked(task.stamp, id);
        let dropped = match task.state { Dropped -> true, _ -> false };
        let read = if task.cancelled { [trail::liveness(id, Read)] } else { [] };
        let accesses = if dropped { trail::with_access(read, trail::ended(id)) } else { read };
        let step = {
          region: s.id,
          task: id,
          enabled: enabled,
          choice: choice,
          accesses: accesses,
          site: None,
          stamp: stamp,
        };
        let recorded = {
          ..s,
          trail: { ..t, points: t.points + 1 },
          steps: s.steps.push(step),
          tasks: s.tasks.insert(id, { ..task, stamp: stamp }),
        };
        if dropped {
          Continue(
            settled_cancel(
              state_of({ ..recorded, ready: recorded.ready.remove(id) }, id, Stopped),
              id,
            ),
          )
        } else {
          match task.state {
            Ready(res) ->
              Stop({
                region: {
                  ..state_of({ ..recorded, ready: recorded.ready.remove(id) }, id, Running),
                  current: Some(id),
                },
                turn: Run(id, res),
              }),
            _ ->
              Stop(
                ended_with(
                  recorded,
                  internal(recorded, task_name(id) ++ " was chosen but is not enabled"),
                ),
              ),
          }
        }
      },
    },
  }

/// `stamp` with one more step of task `id`.
fn ticked(stamp: List<Int>, id: Int) -> List<Int> / {abort.raise} = {
  let wide = widened(stamp, id + 1);
  wide.set(id, at_or_zero(wide, id) + 1)
}

fn widened(xs: List<Int>, n: Int) -> List<Int> =
  range(xs.len(), n).fold(xs, |acc: List<Int>, _i: Int| acc.push(0))

fn at_or_zero(xs: List<Int>, i: Int) -> Int = match xs.at(i) { Some(n) -> n, None -> 0 }

/// Virtual time moved on to `deadline`, each task asleep until then readied in task order.
fn advanced<v>(s: Region<v>, deadline: Int) -> Region<v> / {abort.raise} = {
  let woken = s.timers.keys().filter(|k: (Int, Int)| k._0 == deadline);
  woken.fold(
    {
      ..s,
      timers: woken.fold(s.timers, |m: Map<(Int, Int), Unit>, k: (Int, Int)| m.remove(k)),
      now: deadline,
    },
    |acc: Region<v>, k: (Int, Int)| woken_by_timer(acc, k._1),
  )
}

/// Each sleeper whose deadline is `now` or earlier readied, earliest first and then in task order.
fn due<v>(r: Region<v>, now: Int) -> Region<v> / {abort.raise} =
  iterate(r, r.timers.len() + 1, |s: Region<v>|
    match s.timers.first() {
      Some(t) -> if t.key._0 > now { Stop(s) }
      else { Continue(woken_by_timer({ ..s, timers: s.timers.remove(t.key) }, t.key._1)) },
      None -> Stop(s),
    })

fn woken_by_timer<v>(s: Region<v>, id: Int) -> Region<v> =
  match s.tasks.get(id) {
    Some(t) -> match t.state {
      Blocked(Sleeping(_), _) -> readied(s, id, Resume(Went)),
      _ ->
        broke(
          s,
          internal(s, "a timer fired for " ++ task_name(id) ++ ", which was not waiting on one"),
        ),
    },
    None -> broke(s, internal(s, "a timer fired for " ++ task_name(id) ++ ", which is not a task")),
  }

fn production_turn<v>(r: Region<v>, host: Host) -> Turned<v> / {abort.raise} = {
  let s = due(r, host.now);
  match s.ending {
    Some(e) -> { region: s, turn: Ends(e) },
    None -> match s.queue {
      [id, ..rest] -> match s.tasks.get(id) {
        Some(t) -> match t.state {
          Ready(res) ->
            {
              region: { ..state_of({ ..s, queue: rest }, id, Running), current: Some(id) },
              turn: Run(id, res),
            },
          _ -> ended_with(s, internal(s, task_name(id) ++ " was chosen but is not enabled")),
        },
        None -> ended_with(s, internal(s, task_name(id) ++ " is not a task of this region")),
      },
      [] -> if s.unfinished == 0 { finished_turn(s) } else {
        match s.timers.first() {
          Some(earliest) -> { region: s, turn: Idle(Some(earliest.key._0)) },
          None -> if s.tickets.len() == 0 && !host.stopping { finished_turn(s) }
          else { { region: s, turn: Idle(None) } },
        }
      },
    },
  }
}

/// Each task waiting on one of `tokens`, whose tickets the run answered, readied in task order.
/// A token no task here waits on is another region's of the run that has ended.
pub fn woke<v>(r: Region<v>, tokens: List<Int>) -> Region<v> / {abort.raise} = {
  let found = tokens.fold(
    { tickets: r.tickets, tasks: [] },
    |acc: { tickets: Map<Int, Int>, tasks: List<Int> }, token: Int|
      match acc.tickets.get(token) {
        Some(task) -> { tickets: acc.tickets.remove(token), tasks: acc.tasks.push(task) },
        None -> acc,
      },
  );
  found.tasks.sort().fold({ ..r, tickets: found.tickets }, |acc: Region<v>, id: Int|
    match acc.tasks.get(id) {
      Some(t) -> match t.state {
        Blocked(Ticketed(_), _) -> readied(acc, id, Resume(Went)),
        _ ->
          broke(
            acc,
            internal(acc, task_name(id) ++ " was answered a ticket while not waiting on one"),
          ),
      },
      None -> acc,
    })
}

// --- Requests ---------------------------------------------------------------------

/// What the running `task`'s request does to the region.
pub fn asked<v>(
  r: Region<v>,
  task: Int,
  request: Request<v>,
  at: Asked,
) -> Region<v> / {abort.raise} =
  match r.ending {
    Some(_) -> r,
    None -> if r.current != Some(task) {
      broke(
        r,
        internal(r, "the scheduler was asked for " ++ task_name(task) ++ ", which was not running"),
      )
    } else {
      let s = step_placed(r, at.site);
      match request {
        Failed -> failed(s, task),
        _ -> refused_wait(applied(s, task, request, at), task, at),
      }
    },
  }

fn applied<v>(
  s: Region<v>,
  task: Int,
  request: Request<v>,
  at: Asked,
) -> Region<v> / {abort.raise} =
  match request {
    Spawn -> spawned(s, task, at.site),
    Join(t) -> joined(s, task, t, at.site, false),
    Await(t) -> joined(s, task, t, at.site, true),
    Cancel(t, shields) -> cancelled(s, task, t, shields, at.site),
    Channel(capacity) -> {
      let id = s.next_chan;
      let made = {
        ..s,
        next_chan: id + 1,
        channels: s.channels.insert(id, {
          capacity: capacity,
          queue: [],
          senders: [],
          receivers: [],
          closed: false,
        }),
      };
      answered(recorded(made, trail::channel_made(), at.site), task, Made(id))
    },
    Send(c, value) -> on_channel(s, c, at.site, |id: Int| sent(s, task, id, value, at.site)),
    Recv(c) -> on_channel(s, c, at.site, |id: Int| received(s, task, id, at.site)),
    Close(c) -> on_channel(s, c, at.site, |id: Int| closing(s, task, id)),
    Select(arms, wait) -> selected(s, task, arms, wait, at.site),
    Yield -> answered(s, task, Went),
    Now -> match s.policy {
      Seeded -> answered(s, task, Number(s.now)),
      Production -> answered(s, task, Number(at.now)),
    },
    Sleep(nanos) -> slept(s, task, nanos, at),
    Next -> match s.policy {
      Seeded -> {
        let d = trail::next_draw(s.trail);
        answered({ ..s, trail: d.trail }, task, Number(d.value))
      },
      Production ->
        broke(s, internal(s, "`random.next` reached a production region, which draws nothing")),
    },
    Below(n) -> match s.policy {
      Seeded -> {
        let d = trail::draw_below(s.trail, n);
        answered({ ..s, trail: d.trail }, task, Number(d.value))
      },
      Production ->
        broke(s, internal(s, "`random.below` reached a production region, which draws nothing")),
    },
    Seed -> answered(s, task, Number(trail::bits_of(s.trail.seed.root))),
    Ticket(token) -> ticketed(s, task, token, at.site),
    Finished -> finished(s, task),
    Unwound -> {
      let s2 = recorded(state_of(s, task, Stopped), trail::ended(task), at.site);
      { ..settled_cancel(s2, task), current: None }
    },
    Raised(shields) -> raised(s, task, shields, at.site),
    Failed -> failed(s, task),
  }

/// The task readied with `heard`, giving control back.
fn answered<v>(s: Region<v>, task: Int, heard: Heard<v>) -> Region<v> =
  { ..readied(s, task, Resume(heard)), current: None }

/// The task readied to run again as `res`.
fn readied<v>(s: Region<v>, id: Int, res: Resumption<v>) -> Region<v> =
  if !s.tasks.contains(id) { s } else {
    let t = state_of(s, id, Ready(res));
    match t.policy {
      Seeded -> { ..t, ready: t.ready.insert(id, ()) },
      Production -> { ..t, queue: t.queue.push(id) },
    }
  }

fn state_of<v>(s: Region<v>, id: Int, state: State<v>) -> Region<v> =
  { ..s, tasks: s.tasks.update(id, |t: Member<v>| { ..t, state: state }) }

fn blocked<v>(s: Region<v>, id: Int, wait: Wait<v>, site: Site) -> Region<v> =
  { ..state_of(s, id, Blocked(wait, site)), current: None }

fn ordered<v>(s: Region<v>, order: Order) -> Region<v> = { ..s, orders: s.orders.push(order) }

/// The step the running task took ends at `site`, where it touched nothing before.
fn step_placed<v>(s: Region<v>, site: Site) -> Region<v> / {abort.raise} =
  match s.policy {
    Production -> s,
    Seeded ->
      last_step_changed(s, |step: Step|
        match step.site { Some(_) -> step, None -> { ..step, site: Some(site) } }),
  }

fn last_step_changed<v>(s: Region<v>, f: (Step) -> Step) -> Region<v> / {abort.raise} =
  match s.steps.at(s.steps.len() - 1) {
    Some(step) -> { ..s, steps: s.steps.set(s.steps.len() - 1, f(step)) },
    None -> s,
  }

/// `access` among what the step that made this request touched, made at `site`.
fn recorded<v>(s: Region<v>, access: Access, site: Site) -> Region<v> / {abort.raise} =
  match s.policy {
    Production -> s,
    Seeded -> if trail::is_bookkeeping(access) { s } else {
      last_step_changed(s, |step: Step|
        {
          ..step,
          accesses: trail::with_access(step.accesses, access),
          site: match step.site { Some(_) -> step.site, None -> Some(site) },
        })
    },
  }

/// What the running task's step performed, each where it was made, among what it touched.
pub fn performed<v>(
  r: Region<v>,
  accesses: List<{ access: Access, at: Site }>,
) -> Region<v> / {abort.raise} =
  accesses.fold(r, |acc: Region<v>, a: { access: Access, at: Site }| recorded(acc, a.access, a.at))

/// `access` among what the last step task `id` took touched: a cancel is known only once it
/// happens, and that step could have come after it instead.
fn last_step_of_marked<v>(s: Region<v>, id: Int, access: Access) -> Region<v> / {abort.raise} =
  match s.policy {
    Production -> s,
    Seeded -> {
      let at = range(0, s.steps.len()).fold(None, |found: Option<Int>, i: Int|
        match s.steps.at(i) {
          Some(step) -> if step.task == id { Some(i) } else { found },
          None -> found,
        });
      match at {
        Some(i) -> match s.steps.at(i) {
          Some(step) ->
            {
              ..s,
              steps: s.steps.set(i, {
                ..step,
                accesses: trail::with_access(step.accesses, access),
              }),
            },
          None -> s,
        },
        None -> s,
      }
    },
  }

fn spawned<v>(s: Region<v>, task: Int, site: Site) -> Region<v> = {
  let id = s.next_id;
  let stamp = match s.policy {
    Seeded -> match s.tasks.get(task) { Some(t) -> t.stamp, None -> [] },
    Production -> [],
  };
  let born = {
    ..s,
    next_id: id + 1,
    unfinished: s.unfinished + 1,
    tasks: s.tasks.insert(id, {
      id: id,
      state: Ready(Start),
      origin: site,
      joiners: [],
      cancelled: false,
      stamp: stamp,
    }),
  };
  answered(readied(born, id, Start), task, Spawned(id))
}

/// A join, or an await, of `t`.
fn joined<v>(s: Region<v>, task: Int, t: TaskRef, site: Site, awaiting: Bool) -> Region<v> =
  if t.region != s.id { broke(s, foreign_task(site, t.id)) } else {
    let settled = match s.tasks.get(t.id) {
      Some(target) -> match target.state { Done -> Answered, Stopped -> Cancelled, _ -> Live },
      None -> t.ended,
    };
    match settled {
      Answered ->
        answered(absorbed(s, task, t.id), task, if awaiting { Awaited(true) } else { Joined }),
      Cancelled -> {
        let a = absorbed(s, task, t.id);
        if awaiting { answered(a, task, Awaited(false)) }
        else { { ..readied(a, task, Raise(joined_cancelled(site, t.id))), current: None } }
      },
      Live -> if !s.tasks.contains(t.id) { broke(s, unknown_task(site, t.id)) } else {
        let waiting = {
          ..s,
          tasks: s.tasks.update(t.id, |x: Member<v>| { ..x, joiners: x.joiners.push(task) }),
        };
        blocked(waiting, task, if awaiting { Awaiting(t.id) } else { Joining(t.id) }, site)
      },
    }
  }

/// Stops `t` where it stands, as `task.cancel` does: answers whether it stopped anything.
fn cancelled<v>(
  s: Region<v>,
  task: Int,
  t: TaskRef,
  shields: Shields,
  site: Site,
) -> Region<v> / {abort.raise} =
  if t.region != s.id { broke(s, foreign_task(site, t.id)) }
  else if t.id == task || t.id == 0 { broke(s, cancelled_from(site, t.id, task)) } else {
    match s.tasks.get(t.id) {
      None -> match t.ended {
        Live -> broke(s, unknown_task(site, t.id)),
        _ -> answered(recorded(s, trail::ended(t.id), site), task, Flag(false)),
      },
      Some(target) -> {
        let ended = match target.state {
          Done -> true,
          Broke -> true,
          Stopped -> true,
          Dropped -> true,
          _ -> false,
        };
        if ended { answered(recorded(s, trail::ended(t.id), site), task, Flag(false)) } else {
          let stops = !target.cancelled;
          let stopped = if stops { stopping(s, task, t.id, shields, site) } else { s };
          let marked = last_step_of_marked(
            recorded(stopped, trail::liveness(t.id, Write), site),
            t.id,
            trail::liveness(t.id, Read),
          );
          answered(marked, task, Flag(stops))
        }
      },
    }
  }

/// Task `id` stopped by `by`, which it waited on or ran after: it lets go of its wait and only
/// unwinds when it next runs. A task in a bracket's `acquire` keeps an answer it was given, one in
/// a `release` its wait too, and the cancel lands when it leaves them.
fn stopping<v>(
  s: Region<v>,
  by: Int,
  id: Int,
  shields: Shields,
  site: Site,
) -> Region<v> / {abort.raise} =
  match s.tasks.get(id) {
    None -> s,
    Some(target) -> {
      let s1 = { ..s, tasks: s.tasks.update(id, |x: Member<v>| { ..x, cancelled: true }) };
      let shielded = shields.acquiring > 0 || shields.releasing > 0;
      match target.state {
        Ready(Start) -> {
          let gone = ordered(s1, Discard(id));
          match s.policy {
            Seeded -> state_of(gone, id, Dropped),
            Production ->
              settled_cancel(
                state_of({ ..gone, queue: gone.queue.filter(|q: Int| q != id) }, id, Stopped),
                id,
              ),
          }
        },
        Ready(_) -> if shielded { ordered(s1, HoldBack(id)) }
        else { state_of(s1, id, Ready(Unwind)) },
        Blocked(wait, _) -> if shields.releasing > 0 { ordered(s1, HoldBack(id)) } else {
          let gone = let_go(s1, id, wait, site);
          absorbed(readied(state_of(gone, id, Running), id, Unwind), id, by)
        },
        _ -> broke(s1, internal(s1, task_name(id) ++ " was cancelled while running")),
      }
    },
  }

/// Task `id` taken off what `wait` held it on, which a step on it is ordered against.
fn let_go<v>(s: Region<v>, id: Int, wait: Wait<v>, site: Site) -> Region<v> / {abort.raise} =
  match wait {
    Sleeping(until) -> { ..s, timers: s.timers.remove((until, id)) },
    Joining(on) -> recorded(left_by_joiner(s, on, id), trail::ended(on), site),
    Awaiting(on) -> recorded(left_by_joiner(s, on, id), trail::ended(on), site),
    Ticketed(token) -> { ..s, tickets: s.tickets.remove(token) },
    Sending(chan, _) -> recorded(unwaited(s, id, [chan]), trail::channel_access(chan), site),
    Receiving(chan) -> recorded(unwaited(s, id, [chan]), trail::channel_access(chan), site),
    Selecting(arms) -> {
      let chans = arms.map(|a: Arm<v>| a.chan).sort().fold([], |acc: List<Int>, c: Int|
        if acc.contains(c) { acc } else { acc.push(c) });
      chans.fold(unwaited(s, id, chans), |acc: Region<v>, c: Int|
        recorded(acc, trail::channel_access(c), site))
    },
  }

fn left_by_joiner<v>(s: Region<v>, on: Int, joiner: Int) -> Region<v> =
  {
    ..s,
    tasks: s.tasks.update(on, |t: Member<v>|
      { ..t, joiners: t.joiners.filter(|j: Int| j != joiner) }),
  }

/// Task `id` out of each of `chans`' queues.
fn unwaited<v>(s: Region<v>, id: Int, chans: List<Int>) -> Region<v> =
  chans.fold(s, |acc: Region<v>, c: Int|
    if !acc.channels.contains(c) { acc } else {
      {
        ..acc,
        channels: acc.channels.update(c, |ch: Channel<v>|
          {
            ..ch,
            senders: ch.senders.filter(|t: Int| t != id),
            receivers: ch.receivers.filter(|t: Int| t != id),
          }),
      }
    })

/// A wait `task` just began let go, where a cancel held back for the `acquire` it stands in came
/// first: there an operation that answers keeps its answer, and one that waits does not start.
fn refused_wait<v>(s: Region<v>, task: Int, at: Asked) -> Region<v> / {abort.raise} =
  if !at.shields.stopping || at.shields.releasing > 0 { s } else {
    match s.tasks.get(task) {
      Some(t) -> match t.state {
        Blocked(wait, _) -> {
          let gone = let_go(ordered(s, LetThrough(task)), task, wait, at.site);
          readied(state_of(gone, task, Running), task, Unwind)
        },
        _ -> s,
      },
      None -> s,
    }
  }

/// The running task cancelled, or cancelled before it ran, has ended: an await of it hears it was,
/// and a join raises.
fn settled_cancel<v>(s: Region<v>, id: Int) -> Region<v> / {abort.raise} =
  match s.tasks.get(id) {
    None -> s,
    Some(t) -> {
      let woken = t.joiners.fold(
        ordered({ ..s, unfinished: s.unfinished - 1 }, Settled(id)),
        |acc: Region<v>, joiner: Int|
          match acc.tasks.get(joiner) {
            Some(j) -> match j.state {
              Blocked(Awaiting(_), _) ->
                absorbed(
                  readied(state_of(acc, joiner, Running), joiner, Resume(Awaited(false))),
                  joiner,
                  id,
                ),
              Blocked(Joining(_), site) ->
                absorbed(
                  readied(
                    state_of(acc, joiner, Running),
                    joiner,
                    Raise(joined_cancelled(site, id)),
                  ),
                  joiner,
                  id,
                ),
              _ ->
                broke(
                  acc,
                  internal(
                    acc,
                    task_name(joiner) ++ " waited on " ++ task_name(id) ++ " without a join",
                  ),
                ),
            },
            None -> acc,
          },
      );
      let cleared = { ..woken, tasks: woken.tasks.update(id, |x: Member<v>| { ..x, joiners: [] }) };
      match s.policy {
        Seeded -> cleared,
        Production -> { ..cleared, tasks: cleared.tasks.remove(id) },
      }
    },
  }

/// The running task answered, which its handle holds: each task waiting on it hears so.
fn finished<v>(s: Region<v>, task: Int) -> Region<v> / {abort.raise} =
  match s.tasks.get(task) {
    None ->
      broke(s, internal(s, task_name(task) ++ " finished without being a task of this region")),
    Some(t) -> {
      let s1 = recorded(s, trail::ended(task), nowhere());
      let woken = t.joiners.fold(
        { ..s1, unfinished: s1.unfinished - 1 },
        |acc: Region<v>, joiner: Int|
          match acc.tasks.get(joiner) {
            Some(j) -> match j.state {
              Blocked(Awaiting(_), _) ->
                absorbed(
                  readied(state_of(acc, joiner, Running), joiner, Resume(Awaited(true))),
                  joiner,
                  task,
                ),
              Blocked(_, _) ->
                absorbed(
                  readied(state_of(acc, joiner, Running), joiner, Resume(Joined)),
                  joiner,
                  task,
                ),
              _ -> broke(acc, internal(acc, task_name(joiner) ++ " was woken but was not blocked")),
            },
            None -> acc,
          },
      );
      let done = { ..state_of(woken, task, Done), current: None };
      match s.policy {
        Seeded -> { ..done, tasks: done.tasks.update(task, |x: Member<v>| { ..x, joiners: [] }) },
        Production -> { ..done, tasks: done.tasks.remove(task) },
      }
    },
  }

/// The running task's raise leaves it for the handlers around the region: every other task still
/// running is cancelled, so each releases the brackets it stands in, and the raise lands once
/// they have ended. A second raise while one leaves goes nowhere.
fn raised<v>(
  s: Region<v>,
  task: Int,
  shields: Map<Int, Shields>,
  site: Site,
) -> Region<v> / {abort.raise} = {
  let out = recorded(
    { ..state_of(s, task, Broke), unfinished: s.unfinished - 1, current: None },
    trail::ended(task),
    site,
  );
  match s.raising {
    Some(_) -> ordered(out, DropRaise(task)),
    None ->
      out.tasks.keys().fold({ ..out, raising: Some(task) }, |acc: Region<v>, id: Int|
        match acc.tasks.get(id) {
          Some(t) -> {
            let live = match t.state {
              Done -> false,
              Broke -> false,
              Stopped -> false,
              Dropped -> false,
              _ -> true,
            };
            if id == task || t.cancelled || !live { acc } else {
              let held_by = match shields.get(id) { Some(h) -> h, None -> unshielded() };
              last_step_of_marked(
                recorded(stopping(acc, task, id, held_by, site), trail::liveness(id, Write), site),
                id,
                trail::liveness(id, Read),
              )
            }
          },
          None -> acc,
        }),
  }
}

/// The running task failed at run time: the region ends, the failure noted with where it fell.
fn failed<v>(s: Region<v>, task: Int) -> Region<v> / {abort.raise} = {
  let live = max(s.unfinished - 1, 0);
  let note = if s.next_id <= 1 { None } else {
    Some(match s.policy {
      Seeded ->
        "failed in task " ++ task_name(task) ++ " of a simulated region, with " ++ live.to_string()
          ++ " other task(s) unfinished; replay with seed "
          ++ trail::seed_text(s.trail.seed),
      Production ->
        "failed in task " ++ task_name(task) ++ " of a host-scheduled region, with "
          ++ live.to_string()
          ++ " other task(s) unfinished; a host-backed run is not replayable from a seed",
    })
  };
  let fell = { ..state_of(s, task, Broke), current: None };
  match fell.ending { Some(_) -> fell, None -> { ..fell, ending: Some(TaskFailed(note)) } }
}

fn slept<v>(s: Region<v>, task: Int, nanos: Int, at: Asked) -> Region<v> / {abort.raise} =
  if nanos <= 0 { answered(s, task, Went) } else {
    match s.policy {
      Seeded -> match checked_add(s.now, nanos) {
        None -> broke(s, time_overflow(at.site, s.now, nanos)),
        Some(deadline) ->
          blocked(
            { ..s, timers: s.timers.insert((deadline, task), ()) },
            task,
            Sleeping(deadline),
            at.site,
          ),
      },
      Production -> {
        let until = at.now +| nanos;
        blocked({ ..s, timers: s.timers.insert((until, task), ()) }, task, Sleeping(until), at.site)
      },
    }
  }

fn ticketed<v>(s: Region<v>, task: Int, token: Int, site: Site) -> Region<v> =
  match s.policy {
    Seeded ->
      broke(
        s,
        internal(
          s,
          "a seeded region was asked to wait on a ticket, which only a production region does",
        ),
      ),
    Production -> match s.tickets.get(token) {
      Some(other) ->
        broke(
          s,
          internal(
            s,
            task_name(task) ++ " waited on ticket " ++ token.to_string() ++ ", which "
              ++ task_name(other)
              ++ " was already waiting on",
          ),
        ),
      None -> blocked({ ..s, tickets: s.tickets.insert(token, task) }, task, Ticketed(token), site),
    },
  }

// --- Channels --------------------------------------------------------------------

/// `go` of the channel `c` names here, the operation recorded against it; a handle of another
/// region refused.
fn on_channel<v>(
  s: Region<v>,
  c: ChanRef,
  site: Site,
  go: (Int) -> Region<v> / {abort.raise},
) -> Region<v> / {abort.raise} =
  if c.region != s.id { broke(s, foreign_channel(site, c.id)) }
  else if c.id >= s.next_chan || c.id < 0 {
    broke(s, internal(s, chan_name(c.id) ++ " is not a channel of this region"))
  } else { recorded(go(c.id), trail::channel_access(c.id), site) }

/// Whether a send that does not wait went, or was refused by a closed channel; or the value back.
type SendNow<v> = | Sent(Bool) | Waits(v)

/// A send that does not wait: handed to the receiver waiting longest, queued while there is room,
/// or refused by a closed channel.
fn sent_now<v>(
  s: Region<v>,
  task: Int,
  id: Int,
  value: v,
) -> { region: Region<v>, sent: SendNow<v> } / {abort.raise} =
  match s.channels.get(id) {
    None -> { region: s, sent: Sent(false) },
    Some(ch) -> if ch.closed { { region: s, sent: Sent(false) } } else {
      match ch.receivers {
        [receiver, ..rest] -> {
          let s1 = {
            ..s,
            channels: s.channels.update(id, |c: Channel<v>| { ..c, receivers: rest }),
          };
          { region: delivered(s1, receiver, id, Some(value), task), sent: Sent(true) }
        },
        [] -> if ch.queue.len() < ch.capacity {
          let stamp = stamp_of(s, task);
          {
            region: {
              ..s,
              channels: s.channels.update(id, |c: Channel<v>|
                { ..c, queue: c.queue.push({ value: value, stamp: stamp }) }),
            },
            sent: Sent(true),
          }
        } else { { region: s, sent: Waits(value) } },
      }
    },
  }

fn sent<v>(s: Region<v>, task: Int, id: Int, value: v, site: Site) -> Region<v> / {abort.raise} = {
  let now = sent_now(s, task, id, value);
  match now.sent {
    Sent(went) -> answered(now.region, task, Flag(went)),
    Waits(held) ->
      blocked(
        {
          ..now.region,
          channels: now.region.channels.update(id, |c: Channel<v>|
            { ..c, senders: c.senders.push(task) }),
        },
        task,
        Sending(id, held),
        site,
      ),
  }
}

/// `receiver`, waiting to receive on `chan`, readied with `value`, or with the close.
fn delivered<v>(s: Region<v>, receiver: Int, chan: Int, value: Option<v>, by: Int) -> Region<v> =
  match s.tasks.get(receiver) {
    Some(t) -> match t.state {
      Blocked(Receiving(_), _) ->
        absorbed(
          readied(state_of(s, receiver, Running), receiver, Resume(Received(value))),
          receiver,
          by,
        ),
      Blocked(Selecting(arms), _) -> match index_where(arms, |a: Arm<v>|
          a.chan == chan && !sends(a)) {
        Some(at) ->
          absorbed(
            readied(
              state_of(unwaited(s, receiver, arms.map(|a: Arm<v>| a.chan)), receiver, Running),
              receiver,
              Resume(Chose(Some({ at: at, got: value }))),
            ),
            receiver,
            by,
          ),
        None ->
          broke(
            s,
            internal(
              s,
              task_name(receiver) ++ " was taken as a receiver on " ++ chan_name(chan)
                ++ ", which its select does not receive from",
            ),
          ),
      },
      _ ->
        broke(
          s,
          internal(s, task_name(receiver) ++ " was taken as a receiver but was not receiving"),
        ),
    },
    None -> s,
  }

/// `sender`, waiting to send on `chan`, readied with whether its value went; answers the value.
fn taken_sent<v>(
  s: Region<v>,
  sender: Int,
  chan: Int,
  went: Bool,
  by: Int,
) -> { region: Region<v>, value: Option<v> } =
  match s.tasks.get(sender) {
    Some(t) -> match t.state {
      Blocked(Sending(_, value), _) ->
        {
          region: absorbed(
            readied(state_of(s, sender, Running), sender, Resume(Flag(went))),
            sender,
            by,
          ),
          value: Some(value),
        },
      Blocked(Selecting(arms), _) -> match index_where(arms, |a: Arm<v>|
          a.chan == chan && sends(a)) {
        Some(at) -> match arms.at(at) {
          Some(arm) -> {
            let got = if went { arm.send } else { None };
            {
              region: absorbed(
                readied(
                  state_of(unwaited(s, sender, arms.map(|a: Arm<v>| a.chan)), sender, Running),
                  sender,
                  Resume(Chose(Some({ at: at, got: got }))),
                ),
                sender,
                by,
              ),
              value: arm.send,
            }
          },
          None -> { region: s, value: None },
        },
        None ->
          {
            region: broke(
              s,
              internal(
                s,
                task_name(sender) ++ " was taken as a sender on " ++ chan_name(chan)
                  ++ ", which its select does not send to",
              ),
            ),
            value: None,
          },
      },
      _ ->
        {
          region: broke(
            s,
            internal(s, task_name(sender) ++ " was taken as a sender but was not sending"),
          ),
          value: None,
        },
    },
    None -> { region: s, value: None },
  }

fn sends<v>(a: Arm<v>) -> Bool = match a.send { Some(_) -> true, None -> false }

fn index_where<a>(xs: List<a>, ok: (a) -> Bool) -> Option<Int> =
  range(0, xs.len()).fold(None, |found: Option<Int>, i: Int|
    match found {
      Some(_) -> found,
      None -> match xs.at(i) { Some(x) -> if ok(x) { Some(i) } else { None }, None -> None },
    })

/// A receive that does not wait: `Some` of the oldest value sent, `Some(None)` from a channel
/// closed and empty, and `None` where it would wait.
fn received_now<v>(
  s: Region<v>,
  task: Int,
  id: Int,
) -> { region: Region<v>, taken: Option<Option<v>> } =
  match s.channels.get(id) {
    None -> { region: s, taken: Some(None) },
    Some(ch) -> match ch.queue {
      [first, ..rest] -> {
        let s1 = stamp_absorbed(
          { ..s, channels: s.channels.update(id, |c: Channel<v>| { ..c, queue: rest }) },
          task,
          first.stamp,
        );
        // The room this made takes the value of the sender that waited longest.
        let refilled = match ch.senders {
          [sender, ..others] -> {
            let s2 = {
              ..s1,
              channels: s1.channels.update(id, |c: Channel<v>| { ..c, senders: others }),
            };
            let sent_at = stamp_of(s2, sender);
            let took = taken_sent(s2, sender, id, true, task);
            match took.value {
              Some(value) ->
                {
                  ..took.region,
                  channels: took.region.channels.update(id, |c: Channel<v>|
                    { ..c, queue: c.queue.push({ value: value, stamp: sent_at }) }),
                },
              None -> took.region,
            }
          },
          [] -> s1,
        };
        { region: spent_retired(refilled, id), taken: Some(Some(first.value)) }
      },
      [] -> match ch.senders {
        [sender, ..others] -> {
          let s1 = absorbed(
            { ..s, channels: s.channels.update(id, |c: Channel<v>| { ..c, senders: others }) },
            task,
            sender,
          );
          let took = taken_sent(s1, sender, id, true, task);
          { region: took.region, taken: Some(took.value) }
        },
        [] -> if ch.closed { { region: s, taken: Some(None) } } else { { region: s, taken: None } },
      },
    },
  }

fn received<v>(s: Region<v>, task: Int, id: Int, site: Site) -> Region<v> = {
  let now = received_now(s, task, id);
  match now.taken {
    Some(taken) -> answered(now.region, task, Received(taken)),
    None ->
      blocked(
        {
          ..now.region,
          channels: now.region.channels.update(id, |c: Channel<v>|
            { ..c, receivers: c.receivers.push(task) }),
        },
        task,
        Receiving(id),
        site,
      ),
  }
}

/// Ends sending: each waiting receiver hears `None` and each waiting sender `false`, while what
/// was queued stays to be received.
fn closing<v>(s: Region<v>, task: Int, id: Int) -> Region<v> / {abort.raise} = {
  let shut = { ..s, channels: s.channels.update(id, |c: Channel<v>| { ..c, closed: true }) };
  let waiting = match shut.channels.get(id) {
    Some(ch) -> ch.receivers.len() + ch.senders.len(),
    None -> 0,
  };
  // One at a time off the live queues: a select may wait on both sides of one channel.
  let drained = iterate(shut, waiting + 1, |acc: Region<v>|
    match acc.channels.get(id) {
      None -> Stop(acc),
      Some(ch) -> match ch.receivers {
        [receiver, ..rest] ->
          Continue(
            delivered(
              {
                ..acc,
                channels: acc.channels.update(id, |c: Channel<v>| { ..c, receivers: rest }),
              },
              receiver,
              id,
              None,
              task,
            ),
          ),
        [] -> match ch.senders {
          [sender, ..rest] ->
            Continue(
              taken_sent(
                {
                  ..acc,
                  channels: acc.channels.update(id, |c: Channel<v>| { ..c, senders: rest }),
                },
                sender,
                id,
                false,
                task,
              ).region,
            ),
          [] -> Stop(acc),
        },
      },
    });
  answered(spent_retired(drained, id), task, Went)
}

/// The first arm, in the order given, that can go without waiting goes; with none, `wait` waits on
/// every arm for the first another task makes ready.
fn selected<v>(
  s: Region<v>,
  task: Int,
  arms: List<{ chan: ChanRef, send: Option<v> }>,
  wait: Bool,
  site: Site,
) -> Region<v> / {abort.raise} =
  match arms.fold(None, |bad: Option<ChanRef>, a: { chan: ChanRef, send: Option<v> }|
      match bad {
        Some(_) -> bad,
        None -> if a.chan.region != s.id || a.chan.id < 0 || a.chan.id >= s.next_chan {
          Some(a.chan)
        } else { None },
      }) {
    Some(c) -> if c.region != s.id { broke(s, foreign_channel(site, c.id)) }
    else { broke(s, internal(s, chan_name(c.id) ++ " is not a channel of this region")) },
    None -> {
      let waiting = arms.map(|a: { chan: ChanRef, send: Option<v> }|
        { chan: a.chan.id, send: a.send });
      let touched = waiting.fold(s, |acc: Region<v>, a: Arm<v>|
        recorded(acc, trail::channel_access(a.chan), site));
      let tried = range(0, waiting.len()).fold(
        { region: touched, arms: waiting, went: None },
        |acc: { region: Region<v>, arms: List<Arm<v>>, went: Option<{ at: Int, got: Option<v> }> }, i: Int|
          match acc.went {
            Some(_) -> acc,
            None -> match acc.arms.at(i) {
              None -> acc,
              Some(arm) -> match arm.send {
                None -> {
                  let now = received_now(acc.region, task, arm.chan);
                  match now.taken {
                    Some(got) -> { ..acc, region: now.region, went: Some({ at: i, got: got }) },
                    None -> { ..acc, region: now.region },
                  }
                },
                Some(value) -> {
                  let now = sent_now(acc.region, task, arm.chan, value);
                  match now.sent {
                    Sent(went) ->
                      {
                        ..acc,
                        region: now.region,
                        went: Some({ at: i, got: if went { Some(value) } else { None } }),
                      },
                    Waits(held) ->
                      {
                        ..acc,
                        region: now.region,
                        arms: acc.arms.set(i, { ..arm, send: Some(held) }),
                      },
                  }
                },
              },
            },
          },
      );
      match tried.went {
        Some(went) -> answered(tried.region, task, Chose(Some(went))),
        None -> if !wait { answered(tried.region, task, Chose(None)) } else {
          let queued = tried.arms.fold(tried.region, |acc: Region<v>, a: Arm<v>|
            {
              ..acc,
              channels: acc.channels.update(a.chan, |c: Channel<v>|
                match a.send {
                  Some(_) -> if c.senders.contains(task) { c }
                  else { { ..c, senders: c.senders.push(task) } },
                  None -> if c.receivers.contains(task) { c }
                  else { { ..c, receivers: c.receivers.push(task) } },
                }),
            });
          blocked(queued, task, Selecting(tried.arms), site)
        },
      }
    },
  }

/// A closed channel with nothing queued and nobody waiting answers as a spent one, which it is.
fn spent_retired<v>(s: Region<v>, id: Int) -> Region<v> =
  match s.channels.get(id) {
    Some(ch) -> if ch.closed && ch.queue.len() == 0 && ch.senders.len() == 0
        && ch.receivers.len() == 0 { { ..s, channels: s.channels.remove(id) } }
    else { s },
    None -> s,
  }

// --- Vector clocks ------------------------------------------------------------------

fn stamp_of<v>(s: Region<v>, id: Int) -> List<Int> =
  match s.tasks.get(id) { Some(t) -> t.stamp, None -> [] }

/// `into` has observed what `from` had, in `simulate`.
fn absorbed<v>(s: Region<v>, into: Int, from: Int) -> Region<v> =
  stamp_absorbed(s, into, stamp_of(s, from))

fn stamp_absorbed<v>(s: Region<v>, into: Int, stamp: List<Int>) -> Region<v> =
  match s.policy {
    Production -> s,
    Seeded -> if !s.tasks.contains(into) || stamp.len() == 0 { s } else {
      {
        ..s,
        tasks: s.tasks.update(into, |t: Member<v>|
          {
            ..t,
            stamp: range(0, max(t.stamp.len(), stamp.len())).map(|i: Int|
              max(at_or_zero(t.stamp, i), at_or_zero(stamp, i))),
          }),
      }
    },
  }

// --- Failures -----------------------------------------------------------------------

fn task_name(id: Int) -> String = "@" ++ id.to_string()

fn chan_name(id: Int) -> String = "#" ++ id.to_string()

fn plural(n: Int, one: String, many: String) -> String =
  if n == 1 { "1 " ++ one } else { n.to_string() ++ " " ++ many }

fn primary(at: Site, text: String) -> Label = { at: at, primary: true, text: text }

fn secondary(at: Site, text: String) -> Label = { at: at, primary: false, text: text }

fn internal<v>(r: Region<v>, message: String) -> Failure =
  {
    code: "E0505",
    message: message,
    labels: [
      primary(r.site, match r.policy {
        Seeded -> "the simulated scheduler was driven out of order",
        Production -> "the production scheduler was driven out of order",
      }),
    ],
    notes: [],
  }

/// Each blocked task, ascending, beside where it waits and on what.
fn blocked_labels<v>(r: Region<v>, now: Option<Int>) -> List<Label> =
  r.tasks.fold([], |acc: List<Label>, id: Int, t: Member<v>|
    match t.state {
      Blocked(wait, site) ->
        acc.push(secondary(if site.root < 0 { t.origin } else { site }, waiting(id, wait, now))),
      _ -> acc,
    })

fn waiting<v>(id: Int, wait: Wait<v>, now: Option<Int>) -> String =
  match wait {
    Joining(task) -> task_name(id) ++ " waits here for " ++ task_name(task) ++ " to finish",
    Awaiting(task) -> task_name(id) ++ " waits here for " ++ task_name(task) ++ " to finish",
    Sleeping(until) -> match now {
      Some(n) ->
        task_name(id) ++ " sleeps here until " ++ until.to_string() ++ "ns, and it is "
          ++ n.to_string()
          ++ "ns",
      None -> task_name(id) ++ " sleeps here until " ++ until.to_string() ++ "ns",
    },
    Ticketed(token) -> task_name(id) ++ " waits here on ticket " ++ token.to_string(),
    Sending(chan, _) ->
      task_name(id) ++ " waits here to send on channel " ++ chan_name(chan) ++ ", which is full",
    Receiving(chan) ->
      task_name(id) ++ " waits here to receive from channel " ++ chan_name(chan)
        ++ ", which is empty",
    Selecting(arms) -> if arms.len() == 0 { task_name(id) ++ " waits here on a select with no arm" }
    else {
      task_name(id) ++ " waits here on a select, none of whose arms can go: "
        ++ String::join(
          arms.map(|a: Arm<v>|
            match a.send {
              Some(_) -> "to send on " ++ chan_name(a.chan),
              None -> "to receive from " ++ chan_name(a.chan),
            }),
          ", ",
        )
    },
  }

fn blocked_count<v>(r: Region<v>) -> Int =
  r.tasks.fold(0, |n: Int, _id: Int, t: Member<v>| match t.state { Blocked(_, _) -> n + 1, _ -> n })

fn deadlock<v>(r: Region<v>) -> Failure / {abort.raise} =
  {
    code: "E0414",
    message: "this simulated region deadlocked: "
      ++ plural(blocked_count(r), "task is", "tasks are")
      ++ " blocked and none runnable",
    labels: [primary(r.site, "no task in this region can make progress")].concat(
      blocked_labels(r, Some(r.now)),
    ),
    notes: [
      "a `simulate` region ends when its last task ends, so a task that never finishes stops the region rather than being abandoned",
      "break the wait cycle, or make the task being waited on finish",
      "replay with seed " ++ trail::seed_text(r.trail.seed),
    ],
  }

fn host_deadlock<v>(r: Region<v>) -> Failure / {abort.raise} =
  {
    code: "E0414",
    message: "this host-scheduled region deadlocked: "
      ++ plural(blocked_count(r), "task is", "tasks are")
      ++ " blocked, none runnable and none waiting on the host",
    labels: [primary(r.site, "no task in this region can make progress")].concat(
      blocked_labels(r, None),
    ),
    notes: [
      "a region ends when its last task ends, so a task that never finishes stops the region rather than being abandoned",
      "break the wait cycle, or make the task being waited on finish",
    ],
  }

fn step_budget<v>(r: Region<v>) -> Failure / {abort.raise} =
  {
    code: "E0414",
    message: "this simulated region took " ++ r.trail.budget.to_string()
      ++ " scheduling steps without finishing",
    labels: [primary(r.site, "no task in this region ever stopped running")],
    notes: [
      "this is the per-interleaving step budget; a region that legitimately needs more steps raises the simulation plan's `steps`",
      "more often it is a task that loops without ever finishing, which a real scheduler would spin on forever",
      "replay with seed " ++ trail::seed_text(r.trail.seed),
    ],
  }

fn divergence<v>(r: Region<v>, point: Int, choice: Int, enabled: Int) -> Failure / {abort.raise} =
  {
    code: "E0415",
    message: "replaying this seed did not reproduce the schedule it recorded",
    labels: [primary(r.site, "this region scheduled differently on replay")],
    notes: [
      "at scheduling point " ++ point.to_string() ++ " the seed names enabled task "
        ++ choice.to_string()
        ++ ", and "
        ++ plural(enabled, "task was", "tasks were")
        ++ " enabled",
      "this is a defect in Ply's simulation rather than in the program under test: a run must be a function of its definitions and its seed",
      "the seed replayed was " ++ trail::seed_text(r.trail.seed),
    ],
  }

/// How many times in a row a production region's park may wake with no ticket answered and no
/// stop before that is the host's defect.
pub fn fruitless_parks() -> Int = 1024

/// What a host whose park kept waking for nothing is.
pub fn fruitless<v>(r: Region<v>) -> Failure =
  {
    code: "E0505",
    message: "the host runtime returned from `park` " ++ fruitless_parks().to_string()
      ++ " times without resolving a token",
    labels: [primary(r.site, "every task in this region is waiting on the host")],
    notes: [
      "a park must block until at least one outstanding ticket is answered",
      "this is a defect in the host runtime rather than in the program: spinning here would burn a core and report nothing",
    ],
  }

/// A second `simulate` region entered while `outer` runs.
pub fn nested(site: Site, outer: Site) -> Failure =
  {
    code: "E0416",
    message: "a `simulate` region may not run inside another one",
    labels: [
      primary(site, "this region is entered while one is already running"),
      secondary(outer, "the region already running"),
    ],
    notes: [
      "two schedulers mean two notions of `runnable` and a state space that is a product of both",
      "hoist the inner region out, or handle its effects with an ordinary `handle`",
    ],
  }

fn time_overflow(site: Site, now: Int, nanos: Int) -> Failure =
  {
    code: "E0502",
    message: "this sleep runs past the end of virtual time: " ++ now.to_string() ++ "ns + "
      ++ nanos.to_string()
      ++ "ns overflows",
    labels: [primary(site, "this deadline cannot be represented")],
    notes: ["virtual time is nanoseconds since the region was entered, and it is an `Int`"],
  }

fn foreign_channel(site: Site, chan: Int) -> Failure =
  {
    code: "E0413",
    message: "`" ++ chan_name(chan) ++ "` is a channel of another region",
    labels: [primary(site, "this handle was made by another region's scheduler")],
    notes: [
      "every region numbers its own channels, so here the handle's id names another channel, or none",
      "use a channel inside the region that made it",
    ],
  }

fn foreign_task(site: Site, task: Int) -> Failure =
  {
    code: "E0413",
    message: "`" ++ task_name(task) ++ "` is a task of another region",
    labels: [primary(site, "this handle was spawned by another region's scheduler")],
    notes: [
      "every region numbers its own tasks, so here the handle's id names another task, or none",
      "join the task inside the region that spawned it",
    ],
  }

fn unknown_task(site: Site, task: Int) -> Failure =
  {
    code: "E0413",
    message: "`" ++ task_name(task) ++ "` names no task in this simulated region",
    labels: [primary(site, "this handle outlived the region that created it")],
    notes: [
      "a `Task` is a key into its region's scheduler, and the scheduler ends with the region",
      "join the task inside the `simulate` region that spawned it",
    ],
  }

/// What a join of a cancelled task raises in the joiner.
fn joined_cancelled(site: Site, task: Int) -> Failure =
  {
    code: "E0502",
    message: "`" ++ task_name(task) ++ "` was cancelled, so it has nothing to join",
    labels: [primary(site, "joined here")],
    notes: [
      "`task.await` answers `None` for a cancelled task, where `task.join` has no answer to give",
    ],
  }

fn cancelled_from(site: Site, target: Int, task: Int) -> Failure =
  {
    code: "E0502",
    message: task_name(target) ++ " cannot be cancelled from " ++ task_name(task),
    labels: [primary(site, "cancelled here")],
    notes: [
      "a task cancels another one: the region's own body, and a task itself, are not cancelled",
    ],
  }

// --- Tests --------------------------------------------------------------------------

fn here() -> Asked = { site: nowhere(), shields: unshielded(), now: 0 }

fn region_site() -> Site = { root: 1, start: 0, end: 10 }

/// A `simulate` region whose seed takes `path`, then the lowest enabled task.
fn simulated(path: List<Int>, budget: Int) -> Region<Int> =
  seeded(
    0,
    region_site(),
    trail::trail({ root: 0u64, path: path.concat(range(0, 200).map(|_i: Int| 0)) }, budget),
  )

fn lowest() -> Region<Int> = simulated([], 1000)

fn next(r: Region<Int>) -> Turned<Int> / {abort.raise} = turned(r, { now: 0, stopping: false })

/// The turn after the running `task` asks `request`.
fn then(t: Turned<Int>, task: Int, request: Request<Int>) -> Turned<Int> / {abort.raise} =
  next(asked(t.region, task, request, here()))

fn live(id: Int) -> TaskRef = { region: 0, id: id, ended: Live }

fn chan(id: Int) -> ChanRef = { region: 0, id: id }

fn code_of(t: Turned<Int>) -> String = match t.turn { Ends(Refused(f)) -> f.code, _ -> "" }

test "the body runs first, and the region completes once every task has ended" {
  let t = next(lowest());
  assert_eq(t.turn, Run(0, Start));
  assert_eq(then(t, 0, Finished).turn, Complete)
}

test "a join waits for the task it names, which answers it through its handle" {
  let spawned = then(next(lowest()), 0, Spawn);
  assert_eq(spawned.turn, Run(0, Resume(Spawned(1))));
  let waiting = then(spawned, 0, Join(live(1)));
  assert_eq(waiting.turn, Run(1, Start));
  let joined = then(waiting, 1, Finished);
  assert_eq(joined.turn, Run(0, Resume(Joined)));
  assert_eq(then(joined, 0, Join({ ..live(1), ended: Answered })).turn, Run(0, Resume(Joined)));
  assert_eq(then(joined, 0, Finished).turn, Complete)
}

test "a send on a rendezvous waits for the receive that takes it" {
  let made = then(next(lowest()), 0, Channel(0));
  assert_eq(made.turn, Run(0, Resume(Made(0))));
  let sending = then(then(made, 0, Spawn), 0, Send(chan(0), 7));
  assert_eq(sending.turn, Run(1, Start));
  let taken = then(sending, 1, Recv(chan(0)));
  assert_eq(taken.turn, Run(0, Resume(Flag(true))));
  assert_eq(then(taken, 0, Finished).turn, Run(1, Resume(Received(Some(7)))))
}

test "a closed channel hands over what was queued, then nothing, and refuses a send" {
  let queued = then(then(next(lowest()), 0, Channel(2)), 0, Send(chan(0), 1));
  assert_eq(queued.turn, Run(0, Resume(Flag(true))));
  let first = then(then(queued, 0, Close(chan(0))), 0, Recv(chan(0)));
  assert_eq(first.turn, Run(0, Resume(Received(Some(1)))));
  let after = then(first, 0, Recv(chan(0)));
  assert_eq(after.turn, Run(0, Resume(Received(None))));
  assert_eq(then(after, 0, Send(chan(0), 2)).turn, Run(0, Resume(Flag(false))))
}

test "a select goes on the first arm that can go, and with none waits on every arm" {
  let two = then(then(then(next(lowest()), 0, Channel(0)), 0, Channel(1)), 0, Send(chan(1), 5));
  let arms = [{ chan: chan(0), send: None }, { chan: chan(1), send: None }];
  let went = then(two, 0, Select(arms, true));
  assert_eq(went.turn, Run(0, Resume(Chose(Some({ at: 1, got: Some(5) })))));
  assert_eq(then(went, 0, Select(arms, false)).turn, Run(0, Resume(Chose(None))));
  let waiting = then(then(went, 0, Spawn), 0, Select(arms, true));
  assert_eq(waiting.turn, Run(1, Start));
  let sent = then(waiting, 1, Send(chan(0), 9));
  assert_eq(sent.turn, Run(0, Resume(Chose(Some({ at: 0, got: Some(9) })))));
  assert_eq(then(sent, 0, Finished).turn, Run(1, Resume(Flag(true))))
}

test "virtual time moves only when every task sleeps, waking one deadline's sleepers in task order" {
  let three = then(then(next(lowest()), 0, Spawn), 0, Spawn);
  let asleep = then(then(then(three, 0, Sleep(10)), 1, Sleep(10)), 2, Sleep(5));
  assert_eq(asleep.turn, Run(2, Resume(Went)));
  let early = then(asleep, 2, Now);
  assert_eq(early.turn, Run(2, Resume(Number(5))));
  let late = then(early, 2, Finished);
  assert_eq(late.turn, Run(0, Resume(Went)));
  assert_eq(then(late, 0, Now).turn, Run(0, Resume(Number(10))))
}

/// The body spawns task 1, which receives on a channel nothing sends to, and wakes after it.
fn receiver_waiting() -> Turned<Int> / {abort.raise} = {
  let spawned = then(then(next(lowest()), 0, Channel(0)), 0, Spawn);
  let receiving = then(then(spawned, 0, Sleep(10)), 1, Recv(chan(0)));
  assert_eq(receiving.turn, Run(0, Resume(Went)));
  receiving
}

test "a cancel lets go of what the task waits on, and the task only unwinds" {
  let stopped = then(receiver_waiting(), 0, Cancel(live(1), unshielded()));
  assert_eq(stopped.turn, Run(0, Resume(Flag(true))));
  let again = then(stopped, 0, Cancel(live(1), unshielded()));
  assert_eq(again.turn, Run(0, Resume(Flag(false))));
  let awaiting = then(again, 0, Await(live(1)));
  assert_eq(awaiting.turn, Run(1, Unwind));
  let unwound = then(awaiting, 1, Unwound);
  assert_eq(unwound.turn, Run(0, Resume(Awaited(false))));
  assert(unwound.region.orders.contains(Settled(1)));
  assert_eq(then(unwound, 0, Join(live(1))).turn, Run(0, Raise(joined_cancelled(nowhere(), 1))))
}

test "a task cancelled inside a release keeps its wait, and the cancel waits for it to leave" {
  let releasing = { acquiring: 0, releasing: 1, stopping: false };
  let stopped = then(receiver_waiting(), 0, Cancel(live(1), releasing));
  assert_eq(stopped.turn, Run(0, Resume(Flag(true))));
  assert(stopped.region.orders.contains(HoldBack(1)));
  // Still receiving, so a send reaches it.
  assert_eq(then(stopped, 0, Send(chan(0), 3)).turn, Run(0, Resume(Flag(true))))
}

test "a raise that leaves a task cancels the region's other tasks, and lands once they have ended" {
  let raising = then(receiver_waiting(), 0, Sleep(10));
  assert_eq(raising.turn, Run(0, Resume(Went)));
  let spawned = then(raising, 0, Spawn);
  assert_eq(spawned.turn, Run(0, Resume(Spawned(2))));
  let left = then(spawned, 0, Raised(Map::new()));
  assert_eq(left.turn, Run(1, Unwind));
  let first = then(left, 1, Unwound);
  // Task 2 never started, so it takes a step that runs nothing.
  assert_eq(first.turn, Reraise(0));
  assert_eq(first.region.raising, Some(0))
}

test "a sibling in a bracket's acquire keeps its answer, and the raise waits for it to unwind" {
  // The body spawns task 1, and the seed runs task 1 before the body hears its answer.
  let spawned = then(next(simulated([0, 1], 1000)), 0, Spawn);
  assert_eq(spawned.turn, Run(1, Start));
  let acquiring = Map::new().insert(0, { acquiring: 1, releasing: 0, stopping: false });
  let left = then(spawned, 1, Raised(acquiring));
  assert(left.region.orders.contains(HoldBack(0)));
  assert_eq(left.turn, Run(0, Resume(Spawned(1))));
  // Its acquire returns, the cancel lands there, and its release runs as it unwinds.
  assert_eq(then(left, 0, Unwound).turn, Reraise(1))
}

test "each step records what the scheduler orders it against" {
  let stopped = then(receiver_waiting(), 0, Cancel(live(1), unshielded()));
  let steps = stopped.region.steps;
  let touched = |i: Int| match steps.at(i) { Some(s) -> s.accesses, None -> [] };
  assert_eq(steps.map(|s: Step| s.task), [0, 0, 0, 1, 0, 0]);
  assert(touched(0).contains(trail::channel_made()));
  // Task 1's receive, the last step it took, could have come after the cancel instead.
  assert(touched(3).contains(trail::channel_access(0)));
  assert(touched(3).contains(trail::liveness(1, Read)));
  assert(touched(4).contains(trail::liveness(1, Write)));
  assert(touched(4).contains(trail::channel_access(0)));
  assert_eq(touched(5), [])
}

test "a step is placed where it first touched what another task could, else where it gave control back" {
  let at = |n: Int| { root: 1, start: n, end: n + 1 };
  let touched = performed(next(lowest()).region, [
    { access: trail::Atom("task", trail::Singleton, Write, None), at: at(1) },
    { access: trail::Hold(1, Write), at: at(2) },
    { access: trail::Hold(2, Read), at: at(3) },
  ]);
  let first = turned(asked(touched, 0, Yield, { ..here(), site: at(4) }), {
    now: 0,
    stopping: false,
  });
  let second = asked(first.region, 0, Yield, { ..here(), site: at(5) });
  assert_eq(second.steps.map(|s: Step| s.site), [Some(at(2)), Some(at(5))]);
  assert_eq(second.steps.map(|s: Step| s.accesses), [
    [trail::Hold(1, Write), trail::Hold(2, Read)],
    [],
  ])
}

test "a deadlock names each blocked task where it waits" {
  let stuck = then(then(next(lowest()), 0, Channel(0)), 0, Recv(chan(0)));
  match stuck.turn {
    Ends(Refused(f)) -> {
      assert_eq(f.code, "E0414");
      assert_eq(f.message, "this simulated region deadlocked: 1 task is blocked and none runnable");
      assert_eq(f.labels.map(|l: Label| l.text), [
        "no task in this region can make progress",
        "@0 waits here to receive from channel #0, which is empty",
      ]);
      assert_eq(
        f.notes.at(2),
        Some("replay with seed 0:" ++ String::join(range(0, 200).map(|_i: Int| "0"), ".")),
      )
    },
    _ -> assert(false),
  }
}

// The bytes `ply_compiled::tasks::failure_of` is tested on.
test "a failure is written as the runtime reads it" {
  let f = {
    code: "E0414",
    message: "m",
    labels: [{ at: { root: 2, start: 1, end: 3 }, primary: true, text: "t" }],
    notes: ["n"],
  };
  assert_eq(failure_bytes(f), b"\x05E0414\x01m\x01\x04\x02\x06\x01\x01t\x01\x01n")
}

test "a handle another region made is refused" {
  let r = then(next(lowest()), 0, Join({ region: 5, id: 1, ended: Live }));
  assert_eq(code_of(r), "E0413");
  assert_eq(code_of(then(next(lowest()), 0, Send({ region: 5, id: 0 }, 1))), "E0413")
}

test "the step budget ends a region that never finishes, and a replay off its schedule diverges" {
  let spun = then(then(next(simulated([], 3)), 0, Yield), 0, Yield);
  assert_eq(code_of(then(spun, 0, Yield)), "E0414");
  assert_eq(code_of(then(next(simulated([0, 5], 10)), 0, Spawn)), "E0415")
}

fn produced() -> Turned<Int> / {abort.raise} = next(production(0, region_site()))

fn at_time(
  t: Turned<Int>,
  task: Int,
  request: Request<Int>,
  now: Int,
) -> Turned<Int> / {abort.raise} =
  turned(asked(t.region, task, request, { ..here(), now: now }), { now: now, stopping: false })

test "a production region runs ready tasks first in, first out" {
  let spawned = then(produced(), 0, Spawn);
  assert_eq(spawned.turn, Run(1, Start));
  assert_eq(then(spawned, 1, Yield).turn, Run(0, Resume(Spawned(1))))
}

test "a production task waits on its ticket while the region idles, and runs once it is answered" {
  let waiting = then(produced(), 0, Ticket(42));
  assert_eq(waiting.turn, Idle(None));
  assert_eq(next(woke(waiting.region, [7, 42])).turn, Run(0, Resume(Went)))
}

test "a production sleeper runs once the run's clock reaches its deadline" {
  let asleep = at_time(produced(), 0, Sleep(100), 0);
  assert_eq(asleep.turn, Idle(Some(100)));
  assert_eq(turned(asleep.region, { now: 50, stopping: false }).turn, Idle(Some(100)));
  assert_eq(turned(asleep.region, { now: 100, stopping: false }).turn, Run(0, Resume(Went)))
}

test "a production region deadlocks only with nothing waiting on the host" {
  let stuck = asked(then(produced(), 0, Channel(0)).region, 0, Recv(chan(0)), here());
  assert_eq(code_of(turned(stuck, { now: 0, stopping: false })), "E0414");
  assert_eq(turned(stuck, { now: 0, stopping: true }).turn, Idle(None))
}

test "a production region keeps no task that has ended, and a join reads the handle" {
  let ended = then(then(produced(), 0, Spawn), 1, Finished);
  assert_eq(ended.turn, Run(0, Resume(Spawned(1))));
  assert_eq(held(ended.region), 1);
  assert_eq(then(ended, 0, Join({ ..live(1), ended: Answered })).turn, Run(0, Resume(Joined)));
  assert_eq(code_of(then(ended, 0, Join(live(1)))), "E0413")
}
