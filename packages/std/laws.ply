//! Common properties of a module's definitions, each stated once as a `law schema`.
//!
//! A law applies a schema to a module's own definitions. It is proved as the schema's body with
//! those definitions substituted in. The functions a schema is given may raise, with `abort.raise`
//! or an effect of their own. A definition that fails on some input still fits the schema: the
//! claim then says nothing about that input, rather than being rejected. Each schema is also a
//! function of its parameters and then its bound variables, which returns whether the claim holds
//! at one point.

import std.gen

/// `decode` reads back every value `encode` wrote.
///
/// One direction only: `decode` may also accept what `encode` never writes.
pub law schema round_trip<a, b | e>(encode: (a) -> b / e, decode: (b) -> Option<a> / e)
  forall (x: a) {
    decode(encode(x)) == Some(x)
  }

/// `back` undoes `there`.
///
/// One direction only: `there` need not undo `back`.
pub law schema inverse<a, b | e>(there: (a) -> b / e, back: (b) -> a / e)
  forall (x: a) {
    back(there(x)) == x
  }

/// Applying `f` a second time changes nothing.
pub law schema idempotent<a | e>(f: (a) -> a / e) forall (x: a) { f(f(x)) == f(x) }

/// `f` and `g` return the same result on every input.
pub law schema agrees<a, b | e>(f: (a) -> b / e, g: (a) -> b / e) forall (x: a) { f(x) == g(x) }

/// `compare` is a total order.
///
/// A value compares `Equal` to itself, and to no value that differs from it under `==`. Swapping
/// the arguments reverses the result. If `x` is at most `y` and `y` is at most `z`, then `x` is at
/// most `z`. A `compare` that reads only part of a value is not a total order.
pub law schema total_order<a | e>(compare: (a, a) -> Ordering / e)
  forall (x: a, y: a, z: a) {
    compare(x, x) == Equal && (compare(x, y) != Equal || x == y)
      && compare(x, y) == reversed(compare(y, x))
      && (compare(x, y) == Greater || compare(y, z) == Greater || compare(x, z) != Greater)
  }

transparent fn reversed(o: Ordering) -> Ordering =
  match o { Less -> Greater, Equal -> Equal, Greater -> Less }

/// `op` is associative and `unit` is its identity on either side.
pub law schema monoid<a | e>(op: (a, a) -> a / e, unit: a)
  forall (x: a, y: a, z: a) {
    op(unit, x) == x && op(x, unit) == x && op(op(x, y), z) == op(x, op(y, z))
  }

/// `op` matches `model_op` under the abstraction `view`.
///
/// Viewing a state after `op` gives what `model_op` gives on the state's view. So two states with
/// the same view still have the same view after `op`.
pub law schema refines<s, m, i | e>(
  view: (s) -> m / e,
  op: (s, i) -> s / e,
  model_op: (m, i) -> m / e,
)
  forall (state: s, input: i) {
    view(op(state, input)) == model_op(view(state), input)
  }

// --- Tests ------------------------------------------------------------------

fn clamped(n: Int) -> Int = if n < 0 { 0 } else { n }

fn sign_of(text: String) -> Option<Bool> = if text == "-" { Some(true) } else { Some(false) }

fn negative(b: Bool) -> String = if b { "-" } else { "+" }

fn count(xs: List<Bool>) -> Int = xs.len()

law "a sign reads back" = round_trip(negative, sign_of)

law "not twice is the value" = inverse(|b: Bool| !b, |b: Bool| !b)

law "clamping is idempotent" = idempotent(clamped)

test "a clamped value is the larger of it and zero" {
  gen::check(gen::any_int(), |x: Int| agrees(clamped, |n: Int| max(n, 0), x))
}

law "the builtin comparison orders booleans" = total_order(|x: Bool, y: Bool| compare(x, y))

law "conjunction is a monoid over true" = monoid(|x: Bool, y: Bool| x && y, true)

law "a pushed list is one longer" =
  refines(count, |xs: List<Bool>, x: Bool| xs.push(x), |n: Int, x: Bool| n + 1)
