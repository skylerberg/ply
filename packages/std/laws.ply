//! Common properties of a module's definitions, each stated once as a `law schema`: a named claim
//! about functions passed in as parameters.
//!
//! A law applies a schema to a module's own definitions. It is proved as the schema's body with
//! those definitions substituted in. The functions given to a schema may raise, with `abort.raise`
//! or an effect of their own. A definition that fails on some input still satisfies the schema: the
//! claim then says nothing about that input, and the law is not rejected. A schema can also be
//! called as a function. It takes the schema's parameters, then its bound variables, and returns
//! whether the claim holds for those values.

import std.gen

/// `decode` reads back every value `operation` wrote.
///
/// One direction only: `decode` may also accept what `operation` never writes.
pub law schema round_trip<a, b | e>(operation: (a) -> b / e, decode: (b) -> Option<a> / e)
  forall (x: a) {
    decode(operation(x)) == Some(x)
  }

/// `back` undoes `operation`.
///
/// One direction only: `operation` need not undo `back`.
pub law schema inverse<a, b | e>(operation: (a) -> b / e, back: (b) -> a / e)
  forall (x: a) {
    back(operation(x)) == x
  }

/// Applying `operation` a second time changes nothing.
pub law schema idempotent<a | e>(operation: (a) -> a / e)
  forall (x: a) {
    operation(operation(x)) == operation(x)
  }

/// `operation` and `g` return the same result on every input.
pub law schema agrees<a, b | e>(operation: (a) -> b / e, g: (a) -> b / e)
  forall (x: a) {
    operation(x) == g(x)
  }

/// `compare` is a total order.
///
/// A value compares `Equal` to itself, and to no value that differs from it under `==`. Swapping
/// the arguments reverses the result. If `x` is at most `y` and `y` is at most `z`, then `x` is at
/// most `z`. A `compare` that reads only part of a value is not a total order.
pub law schema total_order<a | e>(operation: (a, a) -> Ordering / e)
  forall (x: a, y: a, z: a) {
    operation(x, x) == Equal && (operation(x, y) != Equal || x == y)
      && operation(x, y) == reversed(operation(y, x))
      && (operation(x, y) == Greater || operation(y, z) == Greater || operation(x, z) != Greater)
  }

transparent fn reversed(o: Ordering) -> Ordering =
  match o { Less -> Greater, Equal -> Equal, Greater -> Less }

/// `op` is associative and `unit` is its identity on either side.
pub law schema monoid<a | e>(operation: (a, a) -> a / e, unit: a)
  forall (x: a, y: a, z: a) {
    operation(unit, x) == x && operation(x, unit) == x
      && operation(operation(x, y), z) == operation(x, operation(y, z))
  }

/// `op` matches `model_op` under the abstraction `operation`.
///
/// Viewing a state after `op` gives what `model_op` gives on the state's view. So two states with
/// the same view still have the same view after `op`.
pub law schema refines<s, m, i | e>(
  operation: (s) -> m / e,
  op: (s, i) -> s / e,
  model_op: (m, i) -> m / e,
)
  forall (state: s, input: i) {
    operation(op(state, input)) == model_op(operation(state), input)
  }

fn clamped(n: Int) -> Int = if n < 0 { 0 } else { n }

fn sign_of(text: String) -> Option<Bool> = if text == "-" { Some(true) } else { Some(false) }

fn negative(b: Bool) -> String = if b { "-" } else { "+" }

fn count(xs: List<Bool>) -> Int = xs.len()

law "`sign_of` recovers the original value from the result of `negative`" =
  round_trip(negative, sign_of)

law "negating a Bool twice returns the original Bool" = inverse(|b: Bool| !b, |b: Bool| !b)

law "clamping is idempotent" = idempotent(clamped)

test "a clamped value is the larger of it and zero" {
  gen::check(gen::any_int(), |x: Int| agrees(clamped, |n: Int| max(n, 0), x))
}

law "the builtin comparison orders booleans" = total_order(|x: Bool, y: Bool| compare(x, y))

law "conjunction is a monoid over true" = monoid(|x: Bool, y: Bool| x && y, true)

law "a pushed list is one longer" =
  refines(count, |xs: List<Bool>, x: Bool| xs.push(x), |n: Int, x: Bool| n + 1)
