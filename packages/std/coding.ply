//! Content codings (RFC 9110 §8.4): `gzip`, `deflate`, `br` and `zstd`, which are compressed and
//! decompressed with `std.gzip`, `std.brotli` and `std.zstd`, and chosen by the `Accept-Encoding`
//! header.
//!
//! `negotiate` weighs a request's `Accept-Encoding` by RFC 9110 §12.5.3. It picks the offered
//! coding with the highest weight, and the earlier one when two weigh the same. It picks `identity`
//! unless the header rules it out, and returns `None` when no offered coding is acceptable.
//!
//! `encoded` compresses a response for its request. It does so only when the response is a 200 with
//! no coding or range of its own, its type is text or another type that compresses, and its body is
//! a stream or at least `min_size` bytes. Responses of types that are already compressed (images,
//! audio, video, archives) are left as they are. A response that could have been compressed always
//! states that it varies by `Accept-Encoding`. A compressed response's strong entity tag becomes
//! weak, because the compressed bytes are a different representation of the same resource.
//!
//! `decoded_request` undoes the codings a request body names, last applied first. Every step has
//! one limit on the bytes it may produce. A body that would decompress past the limit is rejected
//! with `TooLarge` (413) before its memory is allocated, which stops a decompression bomb. A coding
//! this module cannot read gives `Unsupported` (415), and a body that does not decode gives
//! `Damaged` (400).
//!
//! A streamed body is compressed and decompressed one chunk at a time as it is pulled, by the
//! `encoded` and `decoded` functions of `std.gzip`, `std.brotli` and `std.zstd`. This needs memory
//! for only a coder's window and one block, whatever the body's length. A streamed request body
//! that decodes past its limit fails with `std.http`'s `incoming.fail` at the pull that passes the
//! limit.
//!
//! `std.http`'s `fetch` offers every coding here and decodes the response. It reads the whole
//! response body, within `Limits.max_body`.

import std.brotli
import std.brotli (brotli)
import std.cookie
import std.cookie (Jar)
import std.dns
import std.dns (dns)
import std.gzip
import std.gzip (gzip)
import std.http
import std.http (Headers, Method, Reading, Request, Response, Streamed, Whole, incoming)
import std.ip
import std.ip (ip)
import std.list
import std.mime
import std.net
import std.net (net)
import std.seq
import std.seq (Seq, Done, Skip, Yield)
import std.string
import std.task
import std.url
import std.url (Url)
import std.zstd
import std.zstd (zstd)
import std.gen

/// A content coding.
pub type Coding = | Identity | Gzip | Deflate | Brotli | Zstd

/// The coding's name in a header field.
pub fn name(c: Coding) -> String =
  match c {
    Identity -> "identity",
    Gzip -> "gzip",
    Deflate -> "deflate",
    Brotli -> "br",
    Zstd -> "zstd",
  }

/// The coding a field's token names, ignoring case and reading `x-gzip` as `gzip`.
pub fn of_name(text: String) -> Option<Coding> = {
  let t = text.ascii_trim().ascii_lower();
  if t == "identity" { Some(Identity) }
  else if t == "gzip" || t == "x-gzip" { Some(Gzip) }
  else if t == "deflate" { Some(Deflate) }
  else if t == "br" { Some(Brotli) }
  else if t == "zstd" { Some(Zstd) }
  else { None }
}

/// The codings a server offers, in the order it prefers them when a client gives them equal weight.
pub fn preferred() -> List<Coding> = [Zstd, Brotli, Gzip, Deflate]

/// One entry of `Accept-Encoding`: a coding's token in lower case, or `*`, and its weight in
/// thousandths.
pub type AcceptEntry = { token: String, weight: Int }

/// The entries of the `Accept-Encoding` fields in `fields`, in order. `None` if one does not
/// parse, which a server treats as if the field were absent.
pub fn read_accept(fields: List<String>) -> Option<List<AcceptEntry>> / {abort.raise} =
  fields.fold(Some([]), |accumulator: Option<List<AcceptEntry>>, field: String|
    field.split(",").fold(accumulator, |inner: Option<List<AcceptEntry>>, piece: String|
      match inner {
        None -> None,
        Some(found) -> if piece.ascii_trim().len() == 0 { inner }
        else { match parse_accept_entry(piece) { Some(w) -> Some(found.push(w)), None -> None } },
      }))

fn parse_accept_entry(piece: String) -> Option<AcceptEntry> / {abort.raise} = {
  let parts = piece.split(";");
  let token = String::ascii_trim(match parts.at(0) { Some(t) -> t, None -> "" }).ascii_lower();
  if token.len() == 0 || !(token == "*" || mime::is_token(token)) { None } else {
    let weight = parts.drop(1).fold(Some(1000), |w: Option<Int>, param: String| {
      let p = param.ascii_trim();
      if p.ascii_lower().starts_with("q=") { parse_qvalue(p.slice(2, p.len())) } else { w }
    });
    match weight { Some(n) -> Some({ token: token, weight: n }), None -> None }
  }
}

fn parse_qvalue(q: String) -> Option<Int> = {
  let b = Bytes::of_string(q);
  let n = b.len();
  let digits = range(2, n).fold(true, |ok: Bool, i: Int| ok && b.at(i) >= 0x30 && b.at(i) <= 0x39);
  if n == 0 || n > 5 || (n > 1 && (b.at(1) != 0x2e || !digits)) { None } else {
    let whole = b.at(0) - 0x30;
    let fraction = range(2, 5).fold(0, |accumulator: Int, i: Int|
      accumulator * 10 + (if i < n { b.at(i) - 0x30 } else { 0 }));
    if (whole == 0 || whole == 1) && whole * 1000 + fraction <= 1000 {
      Some(whole * 1000 + fraction)
    } else { None }
  }
}

fn weight_for(entries: List<AcceptEntry>, c: Coding) -> Int = {
  let own = entries.fold(None, |w: Option<Int>, e: AcceptEntry|
    if e.token == name(c) || (c == Gzip && e.token == "x-gzip") { Some(e.weight) } else { w });
  let star = entries.fold(None, |w: Option<Int>, e: AcceptEntry|
    if e.token == "*" { Some(e.weight) } else { w });
  match own {
    Some(n) -> n,
    None -> match star { Some(n) -> n, None -> if c == Identity { 1000 } else { 0 } },
  }
}

/// Returns the coding from `offered` to use for a request whose `Accept-Encoding` header fields are
/// `fields`. Returns `identity` when no field was sent, or when no offered coding has a higher
/// weight than `identity` and the fields do not exclude `identity`. Returns `None` when the fields
/// exclude every offered coding and `identity` too.
pub fn negotiate(fields: List<String>, offered: List<Coding>) -> Option<Coding> / {abort.raise} =
  match fields {
    [] -> Some(Identity),
    _ -> match read_accept(fields) {
      None -> Some(Identity),
      Some(entries) -> {
        let best = offered.fold(
          { pick: Identity, weight: weight_for(entries, Identity) },
          |b: { pick: Coding, weight: Int }, c: Coding| {
            let w = weight_for(entries, c);
            if w > b.weight || (w == b.weight && w > 0 && b.pick == Identity) {
              { pick: c, weight: w }
            } else { b }
          },
        );
        if best.weight > 0 { Some(best.pick) } else { None }
      },
    },
  }

/// Returns `body` compressed with the coding `c`. `Identity` returns `body` unchanged.
pub fn encode(body: Bytes, c: Coding) -> Bytes / {abort.raise} =
  match c {
    Identity -> body,
    Gzip -> gzip::gzip(body),
    Deflate -> gzip::zlib(body),
    Brotli -> brotli::compress(body, brotli::Fast),
    Zstd -> zstd::compress(body, zstd::Fast),
  }

/// The chunks of `plain` coded in `c` as they are pulled. It uses the memory of the coder's window
/// and one block, however long the stream.
pub fn encode_stream<| e>(
  plain: Seq<Bytes | {abort.raise | e}>,
  c: Coding,
) -> Seq<Bytes | {abort.raise | e}> =
  match c {
    Identity -> plain,
    Gzip -> gzip::encoded(plain, gzip::Gzip),
    Deflate -> gzip::encoded(plain, gzip::Zlib),
    Brotli -> brotli::compress_stream(plain, brotli::Fast),
    Zstd -> zstd::encoded(plain, zstd::Fast),
  }

/// Why a coded body could not be decoded.
pub type DecodeError =
  /// The body's `Content-Encoding` names a coding this module cannot read. The string is that name.
  | Unsupported(String)
  /// The decoded body is longer than the limit. The integer is the limit in bytes.
  | TooLarge(Int)
  /// The body is not valid data in the coding it was labeled with. The string names that coding.
  | Damaged(String)

/// The HTTP status for a request rejected because of `r`.
pub fn error_status(r: DecodeError) -> Int =
  match r { Unsupported(_) -> 415, TooLarge(_) -> 413, Damaged(_) -> 400 }

/// Decodes `body` from the coding `c`. Returns `Err(TooLarge)` if the result would be longer than
/// `limit` bytes and `Err(Damaged)` if `body` is not valid in `c`.
pub fn decode(body: Bytes, c: Coding, limit: Int) -> Result<Bytes, DecodeError> / {abort.raise} =
  match c {
    Identity -> if body.len() > limit { Err(TooLarge(limit)) } else { Ok(body) },
    Gzip -> match gzip::try_gunzip(body, limit) {
      Ok(b) -> Ok(b),
      Err(r) -> Err(gzip_error(r, limit, "gzip")),
    },
    Deflate -> match gzip::try_unzlib(body, limit) {
      Ok(b) -> Ok(b),
      Err(r) -> Err(gzip_error(r, limit, "deflate")),
    },
    Brotli -> match brotli::try_decompress(body, brotli_limits(limit)) {
      Ok(b) -> Ok(b),
      Err(r) -> Err(if r.reason == brotli::OverLimit { TooLarge(limit) } else { Damaged("br") }),
    },
    Zstd -> match zstd::try_decompress(body, zstd_limits(limit)) {
      Ok(b) -> Ok(b),
      Err(r) -> Err(if r.reason == zstd::OverLimit { TooLarge(limit) } else { Damaged("zstd") }),
    },
  }

fn gzip_error(r: gzip::Error, limit: Int, coding: String) -> DecodeError =
  if r.reason == gzip::OverLimit { TooLarge(limit) } else { Damaged(coding) }

fn brotli_limits(limit: Int) -> brotli::Limits = { output: limit, window: 16777216 }

fn zstd_limits(limit: Int) -> zstd::Limits = { output: limit, window: 8388608 }

/// Decodes a request body in the coding `c`, chunk by chunk as the caller pulls, producing at most
/// `limit` bytes in total. If the decoded output would exceed `limit`, the pull that would exceed
/// it fails with `incoming.fail` and status 413, and no more coded bytes are read than that pull
/// needed. A body that is not valid in `c` fails with status 400.
pub fn decode_stream(
  packed: Seq<Bytes | {Reading}>,
  c: Coding,
  limit: Int,
) -> Seq<Bytes | {Reading}> =
  match c {
    Identity -> bounded(packed, limit, 0, max_pulls()),
    Gzip -> map_gzip_errors(gzip::decoded(packed, gzip::Gzip, limit), limit, "gzip", max_pulls()),
    Deflate ->
      map_gzip_errors(gzip::decoded(packed, gzip::Zlib, limit), limit, "deflate", max_pulls()),
    Brotli ->
      map_brotli_errors(
        brotli::decompress_stream(packed, brotli_limits(limit)),
        limit,
        max_pulls(),
      ),
    Zstd -> map_zstd_errors(zstd::decoded(packed, zstd_limits(limit)), limit, max_pulls()),
  }

fn too_large(limit: Int) -> http::Error =
  { status: 413, reason: "the body decodes to more than " ++ limit.to_string() ++ " bytes" }

fn damaged(coding: String) -> http::Error =
  { status: 400, reason: "the body does not decode as " ++ coding }

fn max_pulls() -> Int = 4611686018427387903

fn bounded(s: Seq<Bytes | {Reading}>, limit: Int, seen: Int, fuel: Int) -> Seq<Bytes | {Reading}> =
  ||
    if fuel <= 0 { Done } else {
      match s() {
        Done -> Done,
        Skip(rest) -> Skip(bounded(rest, limit, seen, fuel - 1)),
        Yield(chunk, rest) -> if seen + chunk.len() > limit { incoming.fail(too_large(limit)) }
        else { Yield(chunk, bounded(rest, limit, seen + chunk.len(), fuel - 1)) },
      }
    }

fn map_gzip_errors(
  s: Seq<Bytes | {gzip.fail, Reading}>,
  limit: Int,
  coding: String,
  fuel: Int,
) -> Seq<Bytes | {Reading}> =
  ||
    if fuel <= 0 { Done } else {
      let step = handle {
        s()
      } with {
        gzip.fail(r) ->
          incoming.fail(if r.reason == gzip::OverLimit { too_large(limit) }
          else { damaged(coding) }),
      };
      match step {
        Done -> Done,
        Skip(rest) -> Skip(map_gzip_errors(rest, limit, coding, fuel - 1)),
        Yield(chunk, rest) -> Yield(chunk, map_gzip_errors(rest, limit, coding, fuel - 1)),
      }
    }

fn map_brotli_errors(
  s: Seq<Bytes | {brotli.fail, Reading}>,
  limit: Int,
  fuel: Int,
) -> Seq<Bytes | {Reading}> =
  ||
    if fuel <= 0 { Done } else {
      let step = handle {
        s()
      } with {
        brotli.fail(r) ->
          incoming.fail(if r.reason == brotli::OverLimit { too_large(limit) }
          else { damaged("br") }),
      };
      match step {
        Done -> Done,
        Skip(rest) -> Skip(map_brotli_errors(rest, limit, fuel - 1)),
        Yield(chunk, rest) -> Yield(chunk, map_brotli_errors(rest, limit, fuel - 1)),
      }
    }

fn map_zstd_errors(
  s: Seq<Bytes | {zstd.fail, Reading}>,
  limit: Int,
  fuel: Int,
) -> Seq<Bytes | {Reading}> =
  ||
    if fuel <= 0 { Done } else {
      let step = handle {
        s()
      } with {
        zstd.fail(r) ->
          incoming.fail(if r.reason == zstd::OverLimit { too_large(limit) }
          else { damaged("zstd") }),
      };
      match step {
        Done -> Done,
        Skip(rest) -> Skip(map_zstd_errors(rest, limit, fuel - 1)),
        Yield(chunk, rest) -> Yield(chunk, map_zstd_errors(rest, limit, fuel - 1)),
      }
    }

/// Parses the `Content-Encoding` fields into the codings they list, in the order they were applied.
/// Returns `Err` with the first coding name this module cannot read.
pub fn codings_of(fields: List<String>) -> Result<List<Coding>, String> =
  fields.fold(Ok([]), |accumulator: Result<List<Coding>, String>, field: String|
    field.split(",").fold(accumulator, |inner: Result<List<Coding>, String>, piece: String|
      match inner {
        Err(_) -> inner,
        Ok(found) -> if piece.ascii_trim().len() == 0 { inner } else {
          match of_name(piece) {
            Some(Identity) -> inner,
            Some(c) -> Ok(found.push(c)),
            None -> Err(piece.ascii_trim()),
          }
        },
      }))

/// Decodes a message body whose `Content-Encoding` is in `headers`, undoing the last coding first,
/// with at most `limit` bytes at every step.
pub fn decoded_body(
  headers: Headers,
  body: Bytes,
  limit: Int,
) -> Result<Bytes, DecodeError> / {abort.raise} =
  match codings_of(http::header_lines(headers, "content-encoding")) {
    Err(token) -> Err(Unsupported(token)),
    Ok(codings) ->
      codings.reverse().fold(Ok(body), |accumulator: Result<Bytes, DecodeError>, c: Coding|
        match accumulator { Ok(b) -> decode(b, c, limit), Err(_) -> accumulator }),
  }

/// `request` with its body decoded and its `Content-Encoding` removed, or why it could not be decoded.
/// A whole body is decoded at once, and a streamed one as it is pulled. Every coding is limited to
/// `limit` bytes. A streamed body reports its error through `incoming.fail`.
pub fn decoded_request(
  request: Request,
  limit: Int,
) -> Result<Request, DecodeError> / {abort.raise} =
  match codings_of(http::header_lines(request.headers, "content-encoding")) {
    Err(token) -> Err(Unsupported(token)),
    Ok([]) -> Ok(request),
    Ok(codings) -> {
      let plain = { ..request, headers: request.headers.remove("content-encoding") };
      match request.body {
        Whole(bytes) -> match codings.reverse().fold(
            Ok(bytes),
            |accumulator: Result<Bytes, DecodeError>, c: Coding|
              match accumulator { Ok(b) -> decode(b, c, limit), Err(_) -> accumulator },
          ) {
          Ok(decoded) -> Ok({ ..plain, body: Whole(decoded) }),
          Err(r) -> Err(r),
        },
        Streamed(s) ->
          Ok({
            ..plain,
            body: Streamed({
              length: None,
              chunks: codings.reverse().fold(
                s.chunks,
                |accumulator: Seq<Bytes | {Reading}>, c: Coding|
                  decode_stream(accumulator, c, limit),
              ),
              close: s.close,
            }),
          }),
      }
    },
  }

/// The response to a request whose body was rejected because of `r`.
pub fn error_response<| e>(r: DecodeError) -> Response<| e> =
  http::text_response(error_status(r), error_text(r))

fn error_text(r: DecodeError) -> String =
  match r {
    Unsupported(token) ->
      "the body is coded as `" ++ token ++ "`, which this server does not support\n",
    TooLarge(n) -> "the body decodes to more than " ++ n.to_string() ++ " bytes\n",
    Damaged(c) -> "the body does not decode as " ++ c ++ "\n",
  }

/// Whether a content type is worth compressing: text, and the types of structured text, scripts,
/// fonts and images that are text. Nothing already compressed is.
pub fn compressible(content_type: String) -> Bool / {abort.raise} =
  match mime::parse(content_type) {
    Err(_) -> false,
    Ok(m) -> {
      let top = mime::top_level(m);
      let sub = mime::subtype(m);
      top == "text" || sub.ends_with("+json") || sub.ends_with("+xml")
        || (top == "application"
        && (sub == "json" || sub == "javascript" || sub == "xml" || sub == "wasm"
        || sub == "x-www-form-urlencoded"
        || sub == "graphql"))
        || (top == "image" && (sub == "svg+xml" || sub == "bmp" || sub == "x-icon"))
        || (top == "font" && (sub == "ttf" || sub == "otf"))
    },
  }

/// Returns `response` coded in the coding that the `Accept-Encoding` of `request` prefers among
/// `offered`. `response` is coded only if its status is 200, its content type is compressible, it has no
/// `Content-Encoding` or `Content-Range`, and its body is streamed or at least `min_size` bytes. A
/// whole body is coded at once. A streamed body is coded chunk by chunk as it is pulled, and its
/// length becomes unknown. Whenever `response` is eligible, whether or not it ends up coded, the result
/// has `Vary: Accept-Encoding`.
pub fn encoded<| e>(
  request: Headers,
  response: Response<| {abort.raise | e}>,
  offered: List<Coding>,
  min_size: Int,
) -> Response<| {abort.raise | e}> / {abort.raise} = {
  let kind = http::header(response.headers, "content-type");
  let eligible = response.status == 200 && !http::has_header(response.headers, "content-encoding")
    && !http::has_header(response.headers, "content-range")
    && (match kind { Some(k) -> compressible(k), None -> false });
  if !eligible { response } else {
    let varied = http::vary(response, "Accept-Encoding");
    let small = match varied.body { Whole(bytes) -> bytes.len() < min_size, Streamed(_) -> false };
    if small { varied } else {
      match negotiate(http::header_lines(request, "accept-encoding"), offered) {
        Some(Identity) -> varied,
        None -> varied,
        Some(c) -> {
          let fields = http::set_header(varied.headers, "content-encoding", name(c));
          {
            status: varied.status,
            headers: match http::header(fields, "etag") {
              Some(tag) -> if tag.starts_with("W/") { fields }
              else { http::set_header(fields, "etag", "W/" ++ tag) },
              None -> fields,
            },
            body: match varied.body {
              Whole(bytes) -> Whole(encode(bytes, c)),
              Streamed(s) ->
                Streamed({ length: None, chunks: encode_stream(s.chunks, c), close: s.close }),
            },
          }
        },
      }
    }
  }
}

/// Returns the response of `app` for `request`, with the request body decoded and each response
/// coded. A request body longer than `limit` bytes once decoded is rejected, and a streamed body is
/// decoded as `app` pulls it. The response is coded by `encoded`, offering every coding in this
/// module, except that a whole body under 256 bytes is left uncoded.
pub fn serving<| e, s>(
  request: Request,
  limit: Int,
  app: (Request) -> Response<| {abort.raise | s}> / e,
) -> Response<| {abort.raise | s}> / {abort.raise | e} =
  match decoded_request(request, limit) {
    Err(rejected) -> error_response(rejected),
    Ok(plain) -> encoded(request.headers, app(plain), preferred(), 256),
  }

/// Fetches like `http::fetch`, but sends every coding in this module in `Accept-Encoding` and
/// decodes the response body to at most `Limits.max_body` bytes. If the body cannot be decoded,
/// returns a `Malformed` error with HTTP status 502.
pub fn fetch<[l]>(
  method: Method,
  to: Url,
  headers: Headers,
  body: Bytes,
  jar: Jar,
  options: http::FetchOptions,
  now: Instant,
) -> Result<http::FetchResult, http::FetchError> / {dns.lookup, net.connect_to[l], net.start_tls[l], net.send[l], net.recv[l], net.close[l], task.write, clock.read, clock.write, task::deadline.at, abort.raise} = {
  let offered = http::set_header(
    headers,
    "accept-encoding",
    String::join(preferred().map(name), ", "),
  );
  match http::fetch[l](method, to, offered, body, jar, options, now) {
    Err(e) -> Err(e),
    Ok(f) -> match decoded_body(
        f.response.headers,
        http::whole_bytes(f.response.body),
        options.limits.max_body,
      ) {
      Ok(plain) ->
        Ok({
          ..f,
          response: {
            ..f.response,
            body: Whole(plain),
            headers: f.response.headers.remove("content-encoding"),
          },
        }),
      Err(r) -> Err(http::NoOutcome(http::Malformed({ status: 502, reason: error_text(r) }))),
    },
  }
}

fn accept(field: String) -> List<String> = if field.len() == 0 { [] } else { [field] }

test "`negotiate` picks the content coding with the highest `q` value in the `Accept-Encoding` header, breaking ties by the server's preference order: {c.field}" for c: { field: String, chosen: Option<Coding> } in [
    { field: "", chosen: Some(Identity) },
    { field: "gzip", chosen: Some(Gzip) },
    { field: "gzip, br", chosen: Some(Brotli) },
    { field: "gzip;q=1.0, br;q=0.5", chosen: Some(Gzip) },
    { field: "*", chosen: Some(Zstd) },
    { field: "*;q=0.2, br;q=0", chosen: Some(Zstd) },
    { field: "br;q=0, zstd;q=0, gzip;q=0, deflate;q=0", chosen: Some(Identity) },
    { field: "identity;q=0, br;q=0, zstd;q=0, gzip;q=0, deflate;q=0", chosen: None },
    { field: "*;q=0", chosen: None },
    { field: "x-gzip", chosen: Some(Gzip) },
    { field: "compress", chosen: Some(Identity) },
    { field: "gzip;q=2", chosen: Some(Identity) },
    { field: "gzip;q=0.0001", chosen: Some(Identity) },
  ] { assert_eq(negotiate(accept(c.field), preferred()), c.chosen) }

fn page() -> Bytes =
  Bytes::of_string(
    range(0, 40).fold("", |accumulator: String, i: Int|
      accumulator ++ "<li>part " ++ i.to_string() ++ " in stock</li>\n"),
  )

fn served<| e>(kind: String, status: Int, body: Bytes) -> Response<| e> =
  {
    status: status,
    headers: http::set_header(
      http::set_header(http::empty_headers(), "content-type", kind),
      "etag",
      "\"v1\"",
    ),
    body: Whole(body),
  }

test "every coding reads back what it wrote" {
  assert(all_read_back([Identity, Gzip, Deflate, Brotli, Zstd]))
}

fn all_read_back(cs: List<Coding>) -> Bool / {abort.raise} =
  cs.fold(true, |ok: Bool, c: Coding| ok && decode(encode(page(), c), c, 1000000) == Ok(page()))

test "a text response is compressed with the coding the request prefers, gets a `Vary: Accept-Encoding` header, and its ETag becomes weak" {
  let request = http::set_header(http::empty_headers(), "accept-encoding", "gzip, br;q=0.5");
  let r: Response<| {abort.raise}> = encoded(
    request,
    served("text/html; charset=utf-8", 200, page()),
    preferred(),
    256,
  );
  assert_eq(http::header(r.headers, "content-encoding"), Some("gzip"));
  assert_eq(http::header(r.headers, "vary"), Some("Accept-Encoding"));
  assert_eq(http::header(r.headers, "etag"), Some("W/\"v1\""));
  assert(http::whole_bytes(r.body).len() < page().len());
  assert_eq(decoded_body(r.headers, http::whole_bytes(r.body), 1000000), Ok(page()))
}

test "what is not worth coding is left as it is: {c.what}" for c: { what: String, kind: String, status: Int, size: Int, varied: Bool } in [
    { what: "an image", kind: "image/png", status: 200, size: 2000, varied: false },
    { what: "an archive", kind: "application/zip", status: 200, size: 2000, varied: false },
    { what: "a small page", kind: "text/html", status: 200, size: 100, varied: true },
    { what: "a partial result", kind: "text/plain", status: 206, size: 2000, varied: false },
  ] {
  let request = http::set_header(http::empty_headers(), "accept-encoding", "gzip");
  let body = page().concat(page()).slice(0, c.size);
  let r: Response<| {abort.raise}> = encoded(
    request,
    served(c.kind, c.status, body),
    preferred(),
    256,
  );
  assert_eq(http::header(r.headers, "content-encoding"), None);
  assert_eq(http::whole_bytes(r.body), body);
  assert_eq(http::header(r.headers, "vary") != None, c.varied)
}

fn streamed_in<| e>(body: Bytes, size: Int) -> Response<| {abort.raise | e}> =
  {
    status: 200,
    headers: http::set_header(http::empty_headers(), "content-type", "text/plain"),
    body: http::chunked(seq::slices(body, size)),
  }

test "a streamed response is coded a chunk at a time, in every coding, and reads back whole: {c}" for c: Coding in [
    Gzip,
    Deflate,
    Brotli,
    Zstd,
  ] {
  let body = Bytes::concat_all(range(0, 40).map(|_i: Int| page()));
  let request = http::set_header(http::empty_headers(), "accept-encoding", name(c));
  let r: Response<| {abort.raise}> = encoded(request, streamed_in(body, 1000), preferred(), 256);
  assert_eq(http::header(r.headers, "content-encoding"), Some(name(c)));
  assert_eq(http::body_length(r.body), None);
  match http::collect_body(r.body, 1000000) {
    Some(coded) -> {
      assert(coded.len() < body.len() / 4);
      assert_eq(decode(coded, c, 1000000), Ok(body))
    },
    None -> panic("the coded stream is smaller than the bound"),
  }
}

fn zeros() -> Bytes =
  Bytes::of_string(
    range(0, 64).fold("", |accumulator: String, _i: Int| accumulator ++ "0000000000000000"),
  )

fn coded_request(body: Bytes, coding: String) -> Request / {abort.raise} = {
  let bare = http::request_to(http::Post, "x", "/", body);
  { ..bare, headers: http::set_header(http::empty_headers(), "content-encoding", coding) }
}

fn read_decoded(request: Request, limit: Int) -> Result<Bytes, Int> / {abort.raise} =
  match decoded_request(request, limit) {
    Err(r) -> Err(error_status(r)),
    Ok(plain) -> if http::has_header(plain.headers, "content-encoding") { Err(0) } else {
      match http::read_whole(http::empty_headers(), || http::request_body(plain, 1000000)) {
        Ok(bytes) -> Ok(bytes),
        Err(rejection) -> Err(rejection.status),
      }
    },
  }

test "a coded request body is decoded, and one that would decode past the limit is rejected" {
  let z = zeros();
  assert(
    [Gzip, Deflate, Brotli, Zstd].fold(true, |ok: Bool, c: Coding|
      ok && read_decoded(coded_request(encode(z, c), name(c)), 1024) == Ok(z)),
  );
  assert(
    [Gzip, Deflate, Brotli, Zstd].fold(true, |ok: Bool, c: Coding|
      ok && read_decoded(coded_request(encode(z, c), name(c)), 100) == Err(413)),
  );
  assert_eq(read_decoded(coded_request(encode(encode(z, Gzip), Brotli), "gzip, br"), 4096), Ok(z));
  assert_eq(read_decoded(coded_request(z, "compress"), 4096), Err(415));
  assert_eq(read_decoded(coded_request(b"not gzip", "gzip"), 4096), Err(400));
  assert_eq(decoded_body(http::empty_headers(), z, 4096), Ok(z))
}

test "a response over a connection is coded as its client requested, and the client reads it" {
  let request_bytes = b"GET /parts HTTP/1.1\r\nHost: shop.example\r\nAccept-Encoding: br\r\nConnection: close\r\n\r\n";
  let served_over = net::on_mem(
    net::mem_calling(net::mem_empty(), ip::read_socket("198.51.100.4:5000"), [
      net::Sends(request_bytes),
    ]),
    || {
      let listener = net.listen[listener](0);
      http::serve_connection[conn](
        net.accept[listener](listener),
        http::default_limits(),
        |request: Request|
          serving(request, 1048576, |_r: Request| served("text/html", 200, page())),
      )
    },
  );
  let result = net::mem_sent(served_over.net, 2);
  assert(String::of_bytes_lossy(result).contains("content-encoding: br\r\n"));
  let world = net::mem_serving(
    net::mem_resolving(
      net::mem_empty(),
      dns::with_name(dns::table(), "shop.example", [ip::read("192.0.2.10")]),
    ),
    ip::read_socket("192.0.2.10:80"),
    [[net::Sends(result)]],
  );
  let ran = net::on_mem(world, ||
    simulate {
      task::unbounded(||
        fetch[site](
          http::Get,
          url"http://shop.example/parts",
          http::empty_headers(),
          b"",
          cookie::jar(0),
          http::default_fetch_options(),
          Instant(0),
        ))
    });
  match ran.value {
    Ok(f) -> {
      assert_eq(http::whole_bytes(f.response.body), page());
      assert_eq(http::header(f.response.headers, "content-encoding"), None)
    },
    Err(_) -> panic("the coded result reads"),
  };
  assert(
    String::of_bytes_lossy(net::mem_sent(ran.net, 1)).contains(
      "accept-encoding: zstd, br, gzip, deflate\r\n",
    ),
  )
}

test "a body coded in any coding decodes to itself within a limit large enough for it" {
  gen::check2(gen::bytes(), gen::any_int(), |b: Bytes, which: Int| {
    let c = match preferred().at((which % 4 + 4) % 4) { Some(x) -> x, None -> Gzip };
    decode(encode(b, c), c, b.len()) == Ok(b)
  })
}
