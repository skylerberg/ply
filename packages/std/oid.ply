//! Object identifiers: the dotted numbers that name an algorithm, an attribute or an extension.
//!
//! An `Oid` is a list of numbers called arcs. A valid one has at least two. The first is 0, 1 or 2.
//! When the first is 0 or 1, the second is below 40, which lets ASN.1 encode the first two as one
//! number. An arc is an `Int`, so an identifier with an arc wider than 63 bits has no `Oid`.
//! `to_string` writes the dotted text and `parse` reads it back. `oid"1.2.840.113549.1.1.11"` is an
//! `Oid` checked when the program is checked. `std.asn1` reads and writes the encoded form. `name`
//! and `of_name` convert between a well-known identifier and the name its standard gives it. They
//! look names up in a table that is embedded in the program when it is built.

import std.bytes (is_digit)
import std.list
import std.string
import std.gen

/// An object identifier as its arcs, first to last.
pub type Oid = | Oid(List<Int>)

show for Oid by to_string

/// Returns the numbers of the identifier, in order from first to last.
pub fn arcs(o: Oid) -> List<Int> = match o { Oid(arcs) -> arcs }

/// The identifier with these arcs, or `None` if they are not valid (see `is_valid`).
pub fn of_arcs(arcs: List<Int>) -> Option<Oid> =
  if is_valid(Oid(arcs)) { Some(Oid(arcs)) } else { None }

/// Returns whether the numbers form a valid identifier. There must be at least two, none may be
/// negative, and the first must be 0, 1 or 2. If the first is 0 or 1, the second must be below 40.
/// If the first is 2, the second must be small enough that 80 plus the second still fits in an
/// `Int`, because the first two numbers are encoded together as `40 * first + second`.
pub fn is_valid(o: Oid) -> Bool =
  match arcs(o) {
    [first, second, ..] ->
      arcs(o).all(|arc: Int| arc >= 0) && first <= 2
        && (if first < 2 { second < 40 } else { second <= 9223372036854775727 }),
    _ -> false,
  }

/// The dotted text: each arc in decimal, with `.` between them.
pub fn to_string(o: Oid) -> String = String::join(arcs(o).map(Int::to_string), ".")

/// The identifier a dotted text names, or `None`. This is `literal` without the error's reason.
pub fn parse(text: String) -> Option<Oid> / {abort.raise} =
  match literal(text) { Ok(o) -> Some(o), Err(_) -> None }

/// Checks an `oid"..."` literal. Returns the identifier a dotted text names, or an error at the
/// first character that makes the text invalid. An arc is written without a sign and without a
/// leading zero.
pub fn literal(text: String) -> Result<Oid, { message: String, offset: Int }> / {abort.raise} = {
  let scanned = text.split(".").fold({ arcs: [], offset: 0, stray: None }, scan_arc);
  match scanned.stray {
    Some(stray) -> Err(stray),
    None -> match scanned.arcs {
      [first, second, ..] -> if first > 2 {
        Err({ message: "the first arc is 0, 1 or 2", offset: 0 })
      } else if !is_valid(Oid(scanned.arcs)) {
        Err({
          message: if first < 2 {
            "when the first number is 0 or 1, the second number must be below 40"
          } else { "this number is too large to fit in an `Int`" },
          offset: first.to_string().len() + 1,
        })
      } else { Ok(Oid(scanned.arcs)) },
      _ -> Err({ message: "an object identifier has at least two arcs", offset: text.len() }),
    },
  }
}

type Scan = { arcs: List<Int>, offset: Int, stray: Option<{ message: String, offset: Int }> }

fn scan_arc(s: Scan, part: String) -> Scan / {abort.raise} =
  if s.stray != None { s } else {
    let digits = Bytes::of_string(part);
    let stops = match digits.position(0, |b: Int| !is_digit(b)) {
      Some(i) -> String::of_bytes_lossy(digits.slice(0, i)).len(),
      None -> part.len(),
    };
    let rejected = |message: String, at: Int|
      { ..s, stray: Some({ message: message, offset: at }) };
    if stops < part.len() { rejected("not a digit or a `.`", s.offset + stops) }
    else if stops == 0 { rejected("an arc has at least one digit", s.offset) }
    else if stops > 1 && part.starts_with("0") { rejected("an arc has no leading zero", s.offset) }
    else {
      match digits.int_of_ascii() {
        None -> rejected("this number is too large to fit in an `Int`", s.offset),
        Some(arc) -> { arcs: s.arcs.push(arc), offset: s.offset + stops + 1, stray: None },
      }
    }
  }

/// `rsaEncryption`, an RSA key (PKCS #1).
pub const rsa_encryption: Oid = Oid([1, 2, 840, 113549, 1, 1, 1])

/// `sha256WithRSAEncryption`, an RSA PKCS #1 v1.5 signature over SHA-256.
pub const sha256_with_rsa_encryption: Oid = Oid([1, 2, 840, 113549, 1, 1, 11])

/// `sha384WithRSAEncryption`, an RSA PKCS #1 v1.5 signature over SHA-384.
pub const sha384_with_rsa_encryption: Oid = Oid([1, 2, 840, 113549, 1, 1, 12])

/// `sha512WithRSAEncryption`, an RSA PKCS #1 v1.5 signature over SHA-512.
pub const sha512_with_rsa_encryption: Oid = Oid([1, 2, 840, 113549, 1, 1, 13])

/// `id-RSASSA-PSS`, an RSA signature with the PSS padding.
pub const rsassa_pss: Oid = Oid([1, 2, 840, 113549, 1, 1, 10])

/// `id-ecPublicKey`, an elliptic-curve key, whose parameters name its curve.
pub const ec_public_key: Oid = Oid([1, 2, 840, 10045, 2, 1])

/// `prime256v1`, the curve NIST calls P-256.
pub const prime256v1: Oid = Oid([1, 2, 840, 10045, 3, 1, 7])

/// `secp384r1`, the curve NIST calls P-384.
pub const secp384r1: Oid = Oid([1, 3, 132, 0, 34])

/// `secp521r1`, the curve NIST calls P-521.
pub const secp521r1: Oid = Oid([1, 3, 132, 0, 35])

/// `secp256k1`, the Koblitz curve of SEC 2.
pub const secp256k1: Oid = Oid([1, 3, 132, 0, 10])

/// `ecdsa-with-SHA256`, an ECDSA signature over SHA-256.
pub const ecdsa_with_sha256: Oid = Oid([1, 2, 840, 10045, 4, 3, 2])

/// `ecdsa-with-SHA384`, an ECDSA signature over SHA-384.
pub const ecdsa_with_sha384: Oid = Oid([1, 2, 840, 10045, 4, 3, 3])

/// `id-Ed25519`, an Ed25519 key and its signatures.
pub const ed25519: Oid = Oid([1, 3, 101, 112])

/// `id-X25519`, an X25519 key.
pub const x25519: Oid = Oid([1, 3, 101, 110])

/// `id-sha256`, the SHA-256 digest.
pub const sha256: Oid = Oid([2, 16, 840, 1, 101, 3, 4, 2, 1])

/// `id-sha384`, the SHA-384 digest.
pub const sha384: Oid = Oid([2, 16, 840, 1, 101, 3, 4, 2, 2])

/// `id-sha512`, the SHA-512 digest.
pub const sha512: Oid = Oid([2, 16, 840, 1, 101, 3, 4, 2, 3])

/// `commonName`, the `CN` of a distinguished name.
pub const common_name: Oid = Oid([2, 5, 4, 3])

/// `countryName`, the `C` of a distinguished name.
pub const country_name: Oid = Oid([2, 5, 4, 6])

/// `localityName`, the `L` of a distinguished name.
pub const locality_name: Oid = Oid([2, 5, 4, 7])

/// `stateOrProvinceName`, the `ST` of a distinguished name.
pub const state_or_province_name: Oid = Oid([2, 5, 4, 8])

/// `organizationName`, the `O` of a distinguished name.
pub const organization_name: Oid = Oid([2, 5, 4, 10])

/// `organizationalUnitName`, the `OU` of a distinguished name.
pub const organizational_unit_name: Oid = Oid([2, 5, 4, 11])

/// `subjectKeyIdentifier`, the certificate extension.
pub const subject_key_identifier: Oid = Oid([2, 5, 29, 14])

/// `keyUsage`, the certificate extension.
pub const key_usage: Oid = Oid([2, 5, 29, 15])

/// `subjectAltName`, the certificate extension.
pub const subject_alt_name: Oid = Oid([2, 5, 29, 17])

/// `basicConstraints`, the certificate extension.
pub const basic_constraints: Oid = Oid([2, 5, 29, 19])

/// `authorityKeyIdentifier`, the certificate extension.
pub const authority_key_identifier: Oid = Oid([2, 5, 29, 35])

/// `extKeyUsage`, the certificate extension.
pub const extended_key_usage: Oid = Oid([2, 5, 29, 37])

type RegistryEntry = { oid: Oid, name: String }

const registry: List<RegistryEntry> = parse_registry(embed("oid/names.txt"))

fn parse_registry(text: Bytes) -> List<RegistryEntry> / {abort.raise} =
  String::of_bytes(text).split("\n").filter(|line: String| line != "").map(|line: String|
    match line.split_once(" ") {
      None -> panic("`" ++ line ++ "` is no `<dotted> <name>`"),
      Some(cut) -> match literal(cut.head) {
        Ok(o) -> { oid: o, name: cut.tail },
        Err(reason) -> panic("`" ++ cut.head ++ "` is no identifier: " ++ reason.message),
      },
    })

/// Returns the registered name of a well-known identifier, such as `sha256WithRSAEncryption` for
/// `1.2.840.113549.1.1.11`. The registry covers algorithms, curves, digests, distinguished-name
/// attributes, and certificate extensions and purposes. Returns `None` if the registry has no name
/// for the identifier.
pub fn name(o: Oid) -> Option<String> =
  registry.fold(None, |found: Option<String>, known: RegistryEntry|
    match found { Some(_) -> found, None -> if known.oid == o { Some(known.name) } else { None } })

/// The well-known identifier with this name, written exactly as `name` returns it, or `None`.
pub fn of_name(text: String) -> Option<Oid> =
  registry.fold(None, |found: Option<Oid>, known: RegistryEntry|
    match found {
      Some(_) -> found,
      None -> if known.name == text { Some(known.oid) } else { None },
    })

type BadLiteral = { text: String, message: String, offset: Int }

const bad_literals: List<BadLiteral> =
  [
    { text: "", message: "an arc has at least one digit", offset: 0 },
    { text: "1", message: "an object identifier has at least two arcs", offset: 1 },
    { text: "1.", message: "an arc has at least one digit", offset: 2 },
    { text: ".1", message: "an arc has at least one digit", offset: 0 },
    { text: "1..2", message: "an arc has at least one digit", offset: 2 },
    { text: "1.2.x", message: "not a digit or a `.`", offset: 4 },
    { text: "1.2.8é0", message: "not a digit or a `.`", offset: 5 },
    { text: "1.-2", message: "not a digit or a `.`", offset: 2 },
    { text: "1.2 ", message: "not a digit or a `.`", offset: 3 },
    { text: "1.02", message: "an arc has no leading zero", offset: 2 },
    { text: "3.1", message: "the first arc is 0, 1 or 2", offset: 0 },
    {
      text: "1.40",
      message: "when the first number is 0 or 1, the second number must be below 40",
      offset: 2,
    },
    {
      text: "0.40.1",
      message: "when the first number is 0 or 1, the second number must be below 40",
      offset: 2,
    },
    {
      text: "1.2.9223372036854775808",
      message: "this number is too large to fit in an `Int`",
      offset: 4,
    },
    {
      text: "2.9223372036854775728",
      message: "this number is too large to fit in an `Int`",
      offset: 2,
    },
  ]

test "`literal` returns an error and `parse` returns `None` for the malformed identifier text {c.text}" for c: BadLiteral in bad_literals {
  assert_eq(literal(c.text), Err({ message: c.message, offset: c.offset }));
  assert_eq(parse(c.text), None)
}

test "`parse` turns dotted text into an identifier's numbers, and `to_string` gives back the same text" {
  let o = Oid([1, 2, 840, 113549, 1, 1, 11]);
  assert_eq(parse("1.2.840.113549.1.1.11"), Some(o));
  assert_eq(literal("1.2.840.113549.1.1.11"), Ok(sha256_with_rsa_encryption));
  assert_eq(to_string(o), "1.2.840.113549.1.1.11");
  assert_eq(f"{o}", "1.2.840.113549.1.1.11");
  assert_eq(parse("0.0"), Some(Oid([0, 0])));
  assert_eq(parse("1.39"), Some(Oid([1, 39])));
  assert_eq(parse("2.999.0"), Some(Oid([2, 999, 0])));
  assert_eq(parse("2.9223372036854775727"), Some(Oid([2, 9223372036854775727])));
  assert_eq(parse("1.2.9223372036854775807"), Some(Oid([1, 2, 9223372036854775807])))
}

test "`of_arcs` returns an identifier only when the first two numbers are valid, and otherwise returns no value" {
  assert_eq(of_arcs([2, 5, 4, 3]), Some(common_name));
  assert_eq(arcs(common_name), [2, 5, 4, 3]);
  assert_eq(of_arcs([]), None);
  assert_eq(of_arcs([1]), None);
  assert_eq(of_arcs([3, 1]), None);
  assert_eq(of_arcs([1, 40]), None);
  assert_eq(of_arcs([2, 40]), Some(Oid([2, 40])));
  assert_eq(of_arcs([1, 2, 0 - 1]), None);
  assert_eq(of_arcs([0 - 1, 2]), None)
}

test "`parse` of `to_string` returns the same identifier for any valid identifier" {
  gen::check3(
    gen::any_int(),
    gen::any_int(),
    gen::list(gen::any_int()),
    |first: Int, second: Int, rest: List<Int>| {
      let o = Oid([first & 1, second & 31].concat(rest.map(|arc: Int| arc & 9223372036854775807)));
      is_valid(o) && parse(to_string(o)) == Some(o)
    },
  )
}

test "{c.name} names one identifier, which is named by it alone" for c: RegistryEntry in registry {
  assert_eq(name(c.oid), Some(c.name));
  assert_eq(of_name(c.name), Some(c.oid))
}

const function_identifiers: List<RegistryEntry> =
  [
    { oid: rsa_encryption, name: "rsaEncryption" },
    { oid: sha256_with_rsa_encryption, name: "sha256WithRSAEncryption" },
    { oid: sha384_with_rsa_encryption, name: "sha384WithRSAEncryption" },
    { oid: sha512_with_rsa_encryption, name: "sha512WithRSAEncryption" },
    { oid: rsassa_pss, name: "id-RSASSA-PSS" },
    { oid: ec_public_key, name: "id-ecPublicKey" },
    { oid: prime256v1, name: "prime256v1" },
    { oid: secp384r1, name: "secp384r1" },
    { oid: ecdsa_with_sha256, name: "ecdsa-with-SHA256" },
    { oid: ecdsa_with_sha384, name: "ecdsa-with-SHA384" },
    { oid: ed25519, name: "id-Ed25519" },
    { oid: x25519, name: "id-X25519" },
    { oid: sha256, name: "id-sha256" },
    { oid: sha384, name: "id-sha384" },
    { oid: sha512, name: "id-sha512" },
    { oid: common_name, name: "commonName" },
    { oid: country_name, name: "countryName" },
    { oid: locality_name, name: "localityName" },
    { oid: state_or_province_name, name: "stateOrProvinceName" },
    { oid: organization_name, name: "organizationName" },
    { oid: organizational_unit_name, name: "organizationalUnitName" },
    { oid: subject_key_identifier, name: "subjectKeyIdentifier" },
    { oid: key_usage, name: "keyUsage" },
    { oid: subject_alt_name, name: "subjectAltName" },
    { oid: basic_constraints, name: "basicConstraints" },
    { oid: authority_key_identifier, name: "authorityKeyIdentifier" },
    { oid: extended_key_usage, name: "extKeyUsage" },
  ]

test "`name` returns {c.name} for the identifier of a function, such as an algorithm this module defines" for c: RegistryEntry in function_identifiers {
  assert_eq(name(c.oid), Some(c.name))
}

test "an unknown identifier has no name, and an unknown name has no identifier" {
  assert_eq(name(Oid([2, 999, 1])), None);
  assert_eq(of_name("commonname"), None);
  assert_eq(of_name(""), None)
}
