//! Functions that take a `Decimal` apart and build one. The prelude does arithmetic with decimals.
//! This module provides the number of digits after the point, the same value without trailing
//! zeros, the whole and fractional parts, and a value built from a mantissa and a scale.
//!
//! A `Decimal` stores the scale it was written or computed at, so `1.5m` and `1.50m` are equal but
//! print differently. `Decimal::scale` returns the stored scale. The result of `Decimal::div` and
//! `Decimal::round` has the scale passed to that call, and `Decimal::of_parts` returns a value with
//! the scale passed to it.

import std.math (pow)
import std.show (show)
import std.gen

/// Returns the same value without trailing zeros after its point, at the smallest scale that
/// represents it.
pub fn Decimal::normalize(d: Decimal) -> Decimal / {abort.raise} =
  d.round(d.scale() - trailing_zeros(d), Down)

/// The whole part, rounded toward zero.
pub fn Decimal::trunc(d: Decimal) -> Decimal = d.round(0, Down)

/// The part after the point, with `d`'s sign: what `Decimal::trunc` removes.
pub fn Decimal::fract(d: Decimal) -> Decimal = d - d.trunc()

/// Whether the value is below zero.
pub fn Decimal::is_negative(d: Decimal) -> Bool = d < Decimal::of_int(0)

/// The distance from zero.
pub fn Decimal::abs(d: Decimal) -> Decimal =
  if d.is_negative() { Decimal::of_int(0) - d } else { d }

/// Returns `mantissa / 10^scale` with exactly `scale` digits after the point, so its digits are
/// those of `mantissa`. Returns `None` for a scale outside `0..=28`.
pub fn Decimal::of_parts(mantissa: Int, scale: Int) -> Option<Decimal> / {abort.raise} =
  if scale < 0 || scale > 28 { None }
  else { Some(Decimal::of_int(mantissa).div(power_of_ten(scale), scale, Down)) }

/// The largest `Decimal`: the largest 96-bit mantissa at scale zero.
pub fn Decimal::max_value() -> Decimal / {abort.raise} =
  match Decimal::of_string("79228162514264337593543950335") {
    Some(d) -> d,
    None -> panic("the text of the largest Decimal failed to parse"),
  }

/// The smallest `Decimal`: the largest one negated.
pub fn Decimal::min_value() -> Decimal / {abort.raise} = Decimal::of_int(0) - Decimal::max_value()

fn power_of_ten(n: Int) -> Decimal =
  range(0, n).fold(Decimal::of_int(1), |accumulator: Decimal, _: Int|
    accumulator * Decimal::of_int(10))

fn trailing_zeros(d: Decimal) -> Int / {abort.raise} = {
  let text = d.to_string();
  zeros_before(text, text.len(), d.scale())
}

fn zeros_before(text: String, end: Int, left: Int) -> Int / {abort.raise} =
  if left <= 0 || text.slice(end - 1, end) != "0" { 0 }
  else { 1 + zeros_before(text, end - 1, left - 1) }

test "scale is the number of digits after the point, trailing zeros included" {
  assert_eq(Decimal::scale(1.50m), 2);
  assert_eq(Decimal::scale(1.5m), 1);
  assert_eq(Decimal::scale(2m), 0);
  assert_eq(Decimal::scale(0.00m), 2);
  assert_eq(Decimal::scale(-3.125m), 3)
}

test "normalize drops trailing zeros and nothing else" {
  assert_eq(Decimal::normalize(1.50m).to_string(), "1.5");
  assert_eq(Decimal::normalize(2.00m).to_string(), "2");
  assert_eq(Decimal::normalize(0.00m).to_string(), "0");
  assert_eq(Decimal::normalize(1.25m).to_string(), "1.25");
  assert_eq(Decimal::normalize(-7.10m).to_string(), "-7.1")
}

test "`trunc` rounds toward zero and `fract` returns the remaining fractional part" {
  assert_eq(Decimal::trunc(3.75m), 3m);
  assert_eq(Decimal::trunc(-3.75m), -3m);
  assert_eq(Decimal::fract(3.75m), 0.75m);
  assert_eq(Decimal::fract(-3.75m), -0.75m);
  assert_eq(Decimal::fract(4m), 0m)
}

test "`is_negative` is true only for negative decimals, and `abs` returns the decimal without its sign" {
  assert(Decimal::is_negative(-0.5m));
  assert(!Decimal::is_negative(0m));
  assert(!Decimal::is_negative(0.5m));
  assert_eq(Decimal::abs(-2.5m), 2.5m);
  assert_eq(Decimal::abs(2.5m), 2.5m)
}

test "`of_parts` builds a decimal from an integer and a scale, keeps trailing zeros, and returns `None` for a scale below 0 or above 28" {
  assert_eq(Decimal::of_parts(150, 2), Some(1.50m));
  assert_eq(show(Decimal::of_parts(150, 2)), "Some(1.50)");
  assert_eq(show(Decimal::of_parts(100, 2)), "Some(1.00)");
  assert_eq(show(Decimal::of_parts(0, 2)), "Some(0.00)");
  assert_eq(show(Decimal::of_parts(0 - 5, 3)), "Some(-0.005)");
  assert_eq(show(Decimal::of_parts(7, 0)), "Some(7)");
  assert_eq(show(Decimal::of_parts(1, 28)), "Some(0.0000000000000000000000000001)");
  assert_eq(Decimal::of_parts(1, 29), None);
  assert_eq(Decimal::of_parts(1, 0 - 1), None)
}

test "a quotient has as many digits after its point as requested" {
  assert_eq(show(Decimal::div(3m, 2m, 3, HalfEven)), "1.500");
  assert_eq(show(Decimal::div(1m, 3m, 3, HalfEven)), "0.333");
  assert_eq(show(Decimal::div(100m, 100m, 2, Down)), "1.00");
  assert_eq(show(Decimal::div(3.00m, 2m, 0, HalfEven)), "2");
  assert_eq(show(Decimal::div(0m, 7m, 2, Up)), "0.00");
  assert_eq(show(Decimal::div(0m - 1m, 3m, 2, Floor)), "-0.34");
  assert_eq(show(Decimal::div(0m - 1m, 300m, 2, HalfEven)), "0.00")
}

test "`round` pads the result with zeros when the requested scale has more digits than the value" {
  assert_eq(show(Decimal::round(1.5m, 3, HalfEven)), "1.500");
  assert_eq(show(Decimal::round(1.50m, 1, HalfEven)), "1.5");
  assert_eq(show(Decimal::round(7m, 2, Down)), "7.00");
  assert_eq(show(Decimal::round(2.5m, 0, HalfEven)), "2");
  assert_eq(show(Decimal::round(2.5m, 0, HalfUp)), "3");
  assert_eq(show(Decimal::round(0m - 0.001m, 2, Floor)), "-0.01");
  assert_eq(show(Decimal::round(0m - 0.001m, 2, HalfEven)), "0.00")
}

test "a quotient is rounded once, at its last digit, however many digits it has" {
  assert_eq(show(Decimal::div(2m, 3m, 28, Down)), "0.6666666666666666666666666666");
  assert_eq(show(Decimal::div(2m, 3m, 28, HalfEven)), "0.6666666666666666666666666667");
  assert_eq(show(Decimal::div(1m, 3m, 28, Up)), "0.3333333333333333333333333334");
  assert_eq(show(Decimal::div(4.9999999999999999999999999995m, 10m, 0, HalfUp)), "0");
  assert_eq(show(Decimal::max_value().div(3m, 0, Down)), "26409387504754779197847983445")
}

test "a quotient or a rounding that does not fit at its scale raises an overflow error" {
  let overflow = |what: String| Err("`Decimal` overflow in " ++ what);
  assert_eq(try[abort.raise] { Decimal::max_value().round(1, Down) }, overflow("rounding"));
  assert_eq(try[abort.raise] { Decimal::round(8m, 28, Down) }, overflow("rounding"));
  assert_eq(show(Decimal::round(7m, 28, Down)), "7.0000000000000000000000000000");
  assert_eq(try[abort.raise] { Decimal::max_value().div(1m, 1, Down) }, overflow("division"));
  assert_eq(try[abort.raise] { Decimal::div(1m, 0.1m, 28, Down) }, overflow("division"));
  assert_eq(try[abort.raise] { Decimal::max_value().div(0.5m, 0, Down) }, overflow("division"));
  assert_eq(show(Decimal::max_value().div(1m, 0, Down)), "79228162514264337593543950335")
}

fn whole_quotient(n: Int, m: Int, mode: Rounding) -> Int / {abort.raise} = {
  let q = n / m;
  let r = n % m;
  let negative = n < 0 != (m < 0);
  let away = if negative { q - 1 } else { q + 1 };
  let half = compare(2 * max(r, 0 - r), max(m, 0 - m));
  if r == 0 { q } else {
    match mode {
      Down -> q,
      Up -> away,
      Ceiling -> if negative { q } else { away },
      Floor -> if negative { away } else { q },
      HalfUp -> if half == Less { q } else { away },
      HalfEven -> if half == Greater || (half == Equal && q % 2 != 0) { away } else { q },
    }
  }
}

const modes: List<Rounding> = [HalfEven, HalfUp, Down, Up, Ceiling, Floor]

fn mode_at(pick: Int) -> Rounding =
  match modes.at(pick & 7) { Some(mode) -> mode, None -> HalfEven }

fn decimal_text(mantissa: Int, scale: Int) -> Option<String> / {abort.raise} =
  match Decimal::of_parts(mantissa, scale) { Some(d) -> Some(d.to_string()), None -> None }

test "dividing whole numbers rounds once, with the given rounding mode, at the requested number of decimal places" {
  gen::check4(
    gen::any_int(),
    gen::any_int(),
    gen::any_int(),
    gen::any_int(),
    |n: Int, m: Int, k: Int, pick: Int|
      if m % 1000000 != 0 {
        let a = n % 1000000000;
        let b = m % 1000000;
        let places = k & 7;
        let mode = mode_at(pick);
        Some(Decimal::of_int(a).div(Decimal::of_int(b), places, mode).to_string())
          == decimal_text(whole_quotient(a * pow(10, places), b, mode), places)
      } else { true },
  )
}

test "the extremes are the largest 96-bit mantissa and its negation" {
  assert_eq(Decimal::max_value().to_string(), "79228162514264337593543950335");
  assert_eq(Decimal::min_value().to_string(), "-79228162514264337593543950335")
}
