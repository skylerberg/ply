//! Paths as text. Nothing here touches a filesystem: a path is a `String`, and so is every result,
//! so code that walks a tree of paths can be tested without a directory.

import std.list

/// `dir` and `name` with exactly one separator between them. A `dir` of `"."` or `""` adds no
/// separator, so the result is `name`.
pub fn join(dir: String, name: String) -> String =
  if dir == "" || dir == "." { name }
  else if dir.ends_with("/") { dir ++ name }
  else { dir ++ "/" ++ name }

/// The last segment; `""` for a path that ends in a separator.
pub fn file_name(path: String) -> String = {
  let segments = path.split("/");
  match segments.at(segments.len() - 1) { Some(last) -> last, None -> "" }
}

/// The file name without its extension, as `extension` defines it. Only the last extension is
/// removed, and a name with no extension is returned whole.
pub fn stem(path: String) -> String / {abort.raise} =
  match extension(path) {
    None -> file_name(path),
    Some(file_extension) -> {
      let name = file_name(path);
      name.slice(0, name.len() - file_extension.len() - 1)
    },
  }

/// `path` with its extension replaced by `file_extension`, which is written without the dot. A name with no
/// extension gains one.
pub fn with_extension(path: String, file_extension: String) -> String / {abort.raise} = {
  let dir = parent(path);
  let renamed = stem(path) ++ "." ++ file_extension;
  if dir == "." { renamed } else { join(dir, renamed) }
}

/// What follows the last `.` of the file name. A name with no dot has none, and neither has a
/// dotfile: `".gitignore"` is a name, not an extension.
pub fn extension(path: String) -> Option<String> = {
  let pieces = file_name(path).split(".");
  if pieces.len() < 2 { None } else {
    match pieces.at(0) {
      Some(first) -> if first == "" { None } else { pieces.at(pieces.len() - 1) },
      None -> None,
    }
  }
}

/// The directory that contains `path`. Returns `"."` for a name with no separator, since it is in
/// the working directory. Returns `"."` for the root too, since nothing is above it.
pub fn parent(path: String) -> String =
  if path == "/" || path == "" { "." } else {
    let segments = path.split("/");
    if segments.len() < 2 { "." } else {
      let dir = range(0, segments.len() - 1).fold("", |accumulator: String, i: Int|
        match segments.at(i) {
          Some(seg) -> if i == 0 { seg } else { accumulator ++ "/" ++ seg },
          None -> accumulator,
        });
      if dir == "" { "/" } else { dir }
    }
  }

/// `path` without a leading `./`. `./m.ply` and `m.ply` name the same file, so a set keyed on
/// paths should store only one of them.
pub fn strip_dot(path: String) -> String / {abort.raise} =
  if path.starts_with("./") { path.slice(2, path.len()) } else { path }

/// Whether the path is absolute: it starts with the separator.
pub fn is_absolute(path: String) -> Bool = path.starts_with("/")

/// Returns `path` without its leading `/`, which gives the path relative to the root. A relative
/// `path` is returned unchanged.
pub fn strip_root(path: String) -> String / {abort.raise} =
  if is_absolute(path) { path.slice(1, path.len()) } else { path }

/// The path with repeated separators merged, `.` segments dropped, and `..` resolved lexically. A
/// `..` past the start of a relative path stays in the result. A `..` at the root is dropped, since
/// nothing is above the root.
pub fn normalize(path: String) -> String = {
  let absolute = is_absolute(path);
  let segments = path.split("/").fold([], |accumulator: List<String>, seg: String|
    if seg == "" || seg == "." { accumulator } else if seg == ".." {
      match accumulator.at(accumulator.len() - 1) {
        Some(last) -> if last == ".." { accumulator.push(seg) } else { accumulator.drop_last(1) },
        None -> if absolute { accumulator } else { accumulator.push(seg) },
      }
    } else { accumulator.push(seg) });
  let body = segments.fold("", |accumulator: String, seg: String|
    if accumulator == "" { seg } else { accumulator ++ "/" ++ seg });
  let joined = if absolute { "/" ++ body } else { body };
  if joined == "" { if absolute { "/" } else { "." } } else { joined }
}

/// The segments between separators, in order. A leading separator is an empty first segment, so
/// `"/a/b"` is `["", "a", "b"]` and a caller that joins them with `/` gets the path back.
pub fn components(path: String) -> List<String> = path.split("/")

/// The segments that name something: the components that are neither empty nor `.`.
pub fn segments(path: String) -> List<String> =
  path.split("/").filter(|s: String| s != "" && s != ".")

/// `path` resolved against `base`. An absolute `path` replaces `base`, and a relative one is
/// appended to it; either way the result is normalized. No filesystem is read, so `..` removes
/// the segment before it whatever the directories on disk contain.
pub fn resolve(base: String, path: String) -> String =
  if is_absolute(path) { normalize(path) } else { normalize(join(base, path)) }

test "`strip_root` removes the leading separator from an absolute path and leaves a relative path unchanged" {
  assert_eq(strip_root("/usr/lib"), "usr/lib");
  assert_eq(strip_root("/"), "");
  assert_eq(strip_root("lib/x"), "lib/x")
}

test "`join` puts exactly one separator between two paths, and adds none when the first is empty or `.`" {
  assert_eq(join("src", "a.ply"), "src/a.ply");
  assert_eq(join("src/", "a.ply"), "src/a.ply");
  assert_eq(join(".", "a.ply"), "a.ply");
  assert_eq(join("", "a.ply"), "a.ply");
  assert_eq(join("a/b", "c/d"), "a/b/c/d")
}

test "the file name is the last segment" {
  assert_eq(file_name("src/a.ply"), "a.ply");
  assert_eq(file_name("a.ply"), "a.ply");
  assert_eq(file_name("src/"), "");
  assert_eq(file_name(""), "")
}

test "an extension follows the last dot of the file name, and a dotfile has none" {
  assert_eq(extension("src/a.ply"), Some("ply"));
  assert_eq(extension("a.tar.gz"), Some("gz"));
  assert_eq(extension("src/README"), None);
  assert_eq(extension(".gitignore"), None);
  assert_eq(extension("a.d/README"), None)
}

test "`strip_dot` removes only a leading `./`, and leaves `../`, an inner `./` and a lone `.` unchanged" {
  assert_eq(strip_dot("./m.ply"), "m.ply");
  assert_eq(strip_dot("m.ply"), "m.ply");
  assert_eq(strip_dot("./a/./b"), "a/./b");
  assert_eq(strip_dot("../m.ply"), "../m.ply");
  assert_eq(strip_dot("."), ".")
}

test "a stem is the file name without its extension, and with_extension replaces it" {
  assert_eq(stem("src/a.ply"), "a");
  assert_eq(stem("a.tar.gz"), "a.tar");
  assert_eq(stem("README"), "README");
  assert_eq(stem(".gitignore"), ".gitignore");
  assert_eq(stem("src/"), "");
  assert_eq(with_extension("src/a.ply", "txt"), "src/a.txt");
  assert_eq(with_extension("a.ply", "txt"), "a.txt");
  assert_eq(with_extension("README", "md"), "README.md");
  assert_eq(extension(with_extension("a.ply", "gz")), Some("gz"))
}

test "`components` splits a path at separators, and `resolve` combines paths and applies `..` without touching the file system" {
  assert_eq(components("/a/b"), ["", "a", "b"]);
  assert_eq(components("a"), ["a"]);
  assert_eq(resolve("/a", "b"), "/a/b");
  assert_eq(resolve("/a", "/b"), "/b");
  assert_eq(resolve("a", "../b"), "b");
  assert_eq(resolve("/a", "../b"), "/b");
  assert_eq(resolve(".", "a/b"), "a/b")
}

test "`normalize` collapses repeated separators, removes `.` segments and resolves `..` segments" {
  assert_eq(normalize("a//b/./c"), "a/b/c");
  assert_eq(normalize("./a/b"), "a/b");
  assert_eq(normalize("a/./b"), "a/b");
  assert_eq(normalize("a/b/../c"), "a/c");
  assert_eq(normalize("/a//b"), "/a/b");
  assert_eq(normalize("/a/../b"), "/b");
  assert_eq(normalize("/.."), "/");
  assert_eq(normalize("../a"), "../a");
  assert_eq(normalize("a/../../b"), "../b");
  assert_eq(normalize(""), ".");
  assert_eq(normalize("/"), "/");
  assert_eq(normalize("."), ".")
}

test "`is_absolute` returns true for a path that starts with a separator and false for any other path" {
  assert(is_absolute("/a/b"));
  assert(is_absolute("/"));
  assert(!is_absolute("a/b"));
  assert(!is_absolute("./a"))
}

test "a parent is the directory that contains the path, and a name alone is in the working directory" {
  assert_eq(parent("src/m.ply"), "src");
  assert_eq(parent("a/b/c.ply"), "a/b");
  assert_eq(parent("m.ply"), ".");
  assert_eq(parent("/a/b"), "/a");
  assert_eq(parent("/a"), "/");
  assert_eq(parent("/"), ".");
  assert_eq(parent(""), ".");
  assert_eq(join(parent("src/m.ply"), file_name("src/m.ply")), "src/m.ply")
}

test "`segments` splits a path at separators and drops empty segments and `.`" {
  assert_eq(segments("a/./b//c/"), ["a", "b", "c"]);
  assert_eq(segments("/abs/x"), ["abs", "x"]);
  assert_eq(segments("."), [])
}
