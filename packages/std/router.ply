//! Routes as data: a table is a `List<Route<a>>`, and a pure function matches a request against it.
//!
//! The endpoint is a tag the caller `match`es on. A path is split on `/` first, and each segment is
//! percent-decoded afterwards, so a `%2F` never creates a segment boundary. Matching never
//! normalizes a path; call `normalize_path` to do that. `conflicts`, `well_formed`, `listing` and
//! `route_lines` inspect a table.

import std.bytes
import std.http
import std.laws (inverse)
import std.list
import std.gen

/// The type a `Typed` segment requires its text to parse as: an `Int` (`int_of_text`), a `Decimal`
/// (`decimal_of_text`) or a `Bool` (`bool_of_text`).
pub type ParamType = | IntParam | DecimalParam | BoolParam

/// A typed parameter's name and the kind its segment must parse as.
pub type Binding = { name: String, kind: ParamType }

/// One piece of a route's path pattern.
pub type Segment =
  /// Matches exactly this text.
  | Literal(String)
  /// Captures one segment under this name, as text.
  | Param(String)
  /// Captures one segment, and only if it parses as the binding's kind.
  | Typed(Binding)
  /// Captures every remaining segment, joined by `/`; only last in a pattern.
  | Rest(String)

/// A method and path pattern, and the endpoint that handles a request matching both.
pub type Route<a> = { method: http::Method, path: List<Segment>, endpoint: a }

/// What `route` found for a request.
pub type RouteResult<a> =
  /// No route's path matches.
  | NotFound
  /// A path matched only under other methods: these, sorted and deduplicated, as `Allow` lists them.
  | MethodNotAllowed(List<http::Method>)
  /// The most specific matching route's endpoint, and what its parameters captured.
  | Found({ endpoint: a, params: Map<String, String> })

type RouteMatch<a> = { endpoint: a, params: Map<String, String>, rank: List<Int> }

type Search<a> = { best: Option<RouteMatch<a>>, allowed: List<http::Method> }

/// The most specific route whose method and path match (`more_specific`); a tie goes to the earlier
/// entry.
pub fn route<a>(
  table: List<Route<a>>,
  method: http::Method,
  path: String,
) -> RouteResult<a> / {abort.raise} = {
  let segments = path_segments(path);
  search_result(
    table.fold({ best: None, allowed: [] }, |accumulator: Search<a>, r: Route<a>|
      consider(accumulator, r, method, segments)),
  )
}

fn consider<a>(
  accumulator: Search<a>,
  r: Route<a>,
  method: http::Method,
  segments: List<String>,
) -> Search<a> / {abort.raise} =
  match capture(r.path, segments, Map::new()) {
    None -> accumulator,
    Some(params) -> if r.method == method {
      take(accumulator, { endpoint: r.endpoint, params: params, rank: ranks(r.path) })
    } else { { best: accumulator.best, allowed: accumulator.allowed.push(r.method) } },
  }

fn take<a>(accumulator: Search<a>, hit: RouteMatch<a>) -> Search<a> =
  match accumulator.best {
    None -> { best: Some(hit), allowed: accumulator.allowed },
    Some(current_best) -> if outranks(hit.rank, current_best.rank) {
      { best: Some(hit), allowed: accumulator.allowed }
    } else { accumulator },
  }

fn search_result<a>(s: Search<a>) -> RouteResult<a> =
  match s.best {
    Some(hit) -> Found({ endpoint: hit.endpoint, params: hit.params }),
    None -> if s.allowed.len() == 0 { NotFound }
    else { MethodNotAllowed(sorted_methods(s.allowed)) },
  }

fn capture(
  pattern: List<Segment>,
  segments: List<String>,
  accumulator: Map<String, String>,
) -> Option<Map<String, String>> / {abort.raise} =
  match pattern {
    [] -> if segments.len() == 0 { Some(accumulator) } else { None },
    [first, ..rest] -> capture_one(first, rest, segments, accumulator),
  }

fn capture_one(
  first: Segment,
  rest: List<Segment>,
  segments: List<String>,
  accumulator: Map<String, String>,
) -> Option<Map<String, String>> / {abort.raise} =
  match first {
    Rest(name) -> Some(accumulator.insert(name, join_segments(segments))),
    Literal(text) -> capture_literal(text, rest, segments, accumulator),
    Param(name) -> capture_param(name, rest, segments, accumulator),
    Typed(binding) -> capture_typed(binding, rest, segments, accumulator),
  }

fn capture_literal(
  text: String,
  rest: List<Segment>,
  segments: List<String>,
  accumulator: Map<String, String>,
) -> Option<Map<String, String>> / {abort.raise} =
  match segments {
    [] -> None,
    [s, ..more] -> if s == text { capture(rest, more, accumulator) } else { None },
  }

fn capture_param(
  name: String,
  rest: List<Segment>,
  segments: List<String>,
  accumulator: Map<String, String>,
) -> Option<Map<String, String>> / {abort.raise} =
  match segments { [] -> None, [s, ..more] -> capture(rest, more, accumulator.insert(name, s)) }

fn capture_typed(
  binding: Binding,
  rest: List<Segment>,
  segments: List<String>,
  accumulator: Map<String, String>,
) -> Option<Map<String, String>> / {abort.raise} =
  match segments {
    [] -> None,
    [s, ..more] -> if parses(s, binding.kind) {
      capture(rest, more, accumulator.insert(binding.name, s))
    } else { None },
  }

fn parses(text: String, kind: ParamType) -> Bool / {abort.raise} =
  match kind {
    IntParam -> match int_of_text(text) { Some(_) -> true, None -> false },
    DecimalParam -> match decimal_of_text(text) { Some(_) -> true, None -> false },
    BoolParam -> match bool_of_text(text) { Some(_) -> true, None -> false },
  }

/// What the matched route captured under `name`, as text.
pub fn param(params: Map<String, String>, name: String) -> Option<String> = params.get(name)

/// `param`, or `fallback` when the route captured nothing under `name`.
pub fn param_or(params: Map<String, String>, name: String, fallback: String) -> String =
  match params.get(name) { Some(t) -> t, None -> fallback }

/// Returns the parameter `name` parsed as an `Int`. Returns `None` when the route captured nothing
/// under `name` or the text is not a valid `Int` as `int_of_text` defines it. A parameter declared
/// `IntParam` always parses.
pub fn int_param(params: Map<String, String>, name: String) -> Option<Int> / {abort.raise} =
  match params.get(name) { Some(t) -> int_of_text(t), None -> None }

/// Returns the parameter `name` parsed as an `Int`, or `fallback` when `int_param` returns `None`.
pub fn int_param_or(
  params: Map<String, String>,
  name: String,
  fallback: Int,
) -> Int / {abort.raise} = match int_param(params, name) { Some(n) -> n, None -> fallback }

/// Returns the parameter `name` parsed as a `Decimal`. Returns `None` when the route captured
/// nothing under `name` or the text is not a valid `Decimal` as `decimal_of_text` defines it. A
/// parameter declared `DecimalParam` always parses.
pub fn decimal_param(params: Map<String, String>, name: String) -> Option<Decimal> / {abort.raise} =
  match params.get(name) { Some(t) -> decimal_of_text(t), None -> None }

/// Returns the parameter `name` parsed as a `Decimal`, or `fallback` when `decimal_param` returns
/// `None`.
pub fn decimal_param_or(
  params: Map<String, String>,
  name: String,
  fallback: Decimal,
) -> Decimal / {abort.raise} = match decimal_param(params, name) { Some(d) -> d, None -> fallback }

/// Returns the parameter `name` parsed as a `Bool`. Returns `None` when the route captured nothing
/// under `name` or the text is not `true` or `false`. A parameter declared `BoolParam` always
/// parses.
pub fn bool_param(params: Map<String, String>, name: String) -> Option<Bool> =
  match params.get(name) { Some(t) -> bool_of_text(t), None -> None }

/// Returns the parameter `name` parsed as a `Bool`, or `fallback` when `bool_param` returns `None`.
pub fn bool_param_or(params: Map<String, String>, name: String, fallback: Bool) -> Bool =
  match bool_param(params, name) { Some(b) -> b, None -> fallback }

/// Parses an `Int` from its one canonical text: no `+`, no leading zeros, no `-0`, no whitespace
/// and no exponent.
pub fn int_of_text(text: String) -> Option<Int> / {abort.raise} = {
  let raw = Bytes::of_string(text);
  if canonical_int(raw) { raw.int_of_ascii() } else { None }
}

fn canonical_int(raw: Bytes) -> Bool / {abort.raise} =
  if raw.len() == 0 { false } else { whole(raw, sign_width(raw), raw.len()) }

fn sign_width(raw: Bytes) -> Int / {abort.raise} = if raw.at(0) == 45 { 1 } else { 0 }

fn whole(raw: Bytes, start: Int, n: Int) -> Bool / {abort.raise} = {
  let end = raw.scan(start, digits, n - start);
  end == n && digits_are_canonical(raw, start, end) && !negative_zero(raw, start, end)
}

fn digits_are_canonical(raw: Bytes, start: Int, end: Int) -> Bool / {abort.raise} =
  if end <= start { false } else if raw.at(start) != 48 { true } else { end - start == 1 }

fn negative_zero(raw: Bytes, start: Int, end: Int) -> Bool / {abort.raise} =
  start == 1 && end - start == 1 && raw.at(start) == 48

/// Parses a `Decimal` from its canonical text, or returns `None`. The text follows the `Int` rules
/// in `int_of_text`, and may add a fraction: a `.` followed by at least one digit.
pub fn decimal_of_text(text: String) -> Option<Decimal> / {abort.raise} =
  if canonical_decimal(Bytes::of_string(text)) { Decimal::of_string(text) } else { None }

fn canonical_decimal(raw: Bytes) -> Bool / {abort.raise} =
  if raw.len() == 0 { false } else { decimal_parts(raw, sign_width(raw), raw.len()) }

fn decimal_parts(raw: Bytes, start: Int, n: Int) -> Bool / {abort.raise} = {
  let end = raw.scan(start, digits, n - start);
  digits_are_canonical(raw, start, end) && fraction_is_valid(raw, end, n)
}

fn fraction_is_valid(raw: Bytes, end: Int, n: Int) -> Bool / {abort.raise} =
  if end == n { true }
  else if raw.at(end) != 46 { false }
  else { raw.scan(end + 1, digits, n - end - 1) == n && n > end + 1 }

/// `true` and `false`, and nothing else.
pub fn bool_of_text(text: String) -> Option<Bool> =
  if text == "true" { Some(true) } else if text == "false" { Some(false) } else { None }

const digits: Bytes = b"0123456789"

/// Returns whether pattern `x` ranks above pattern `y`. Segments are compared left to right. At the
/// first position where their kinds differ, the higher kind wins, in the order `Literal`, `Typed`,
/// `Param`, `Rest`. If one pattern runs out of segments first, the longer pattern wins.
pub fn more_specific(x: List<Segment>, y: List<Segment>) -> Bool = outranks(ranks(x), ranks(y))

fn ranks(pattern: List<Segment>) -> List<Int> = pattern.map(|s: Segment| kind_rank(s))

fn kind_rank(s: Segment) -> Int =
  match s { Literal(_) -> 4, Typed(_) -> 3, Param(_) -> 2, Rest(_) -> 1 }

fn outranks(x: List<Int>, y: List<Int>) -> Bool =
  match x {
    [] -> false,
    [a, ..xs] -> match y { [] -> true, [b, ..ys] -> if a == b { outranks(xs, ys) } else { a > b } },
  }

/// Every pair of entries that can match one path at equal precedence, so the earlier silently wins.
pub fn conflicts<a>(table: List<Route<a>>) -> List<{ first: Int, second: Int }> / {} =
  pairs(indexed_routes(table), [])

fn pairs<a>(
  entries: List<IndexedRoute<a>>,
  accumulator: List<{ first: Int, second: Int }>,
) -> List<{ first: Int, second: Int }> =
  match entries {
    [] -> accumulator,
    [x, ..rest] ->
      pairs(
        rest,
        rest.fold(accumulator, |found: List<{ first: Int, second: Int }>, y: IndexedRoute<a>|
          if ambiguous(x.route, y.route) { found.push({ first: x.index, second: y.index }) }
          else { found }),
      ),
  }

fn ambiguous<a>(x: Route<a>, y: Route<a>) -> Bool =
  x.method == y.method && overlapping_patterns(x.path, y.path)

fn overlapping_patterns(x: List<Segment>, y: List<Segment>) -> Bool =
  match x {
    [] -> match y { [] -> true, [_, ..] -> false },
    [a, ..xs] -> match y {
      [] -> false,
      [b, ..ys] -> if overlapping(a, b) { overlapping_patterns(xs, ys) } else { false },
    },
  }

fn overlapping(x: Segment, y: Segment) -> Bool =
  match x {
    Literal(t) -> match y { Literal(u) -> t == u, _ -> false },
    Param(_) -> match y { Param(_) -> true, _ -> false },
    Rest(_) -> match y { Rest(_) -> true, _ -> false },
    Typed(p) -> match y { Typed(q) -> kinds_overlap(p.kind, q.kind), _ -> false },
  }

fn kinds_overlap(p: ParamType, q: ParamType) -> Bool =
  match p {
    BoolParam -> match q { BoolParam -> true, _ -> false },
    IntParam -> match q { BoolParam -> false, _ -> true },
    DecimalParam -> match q { BoolParam -> false, _ -> true },
  }

/// Returns every fault found in the table, each with the index of its route and a reason. The
/// faults are a `Rest` segment that is not last, a name bound by more than one segment, a segment
/// with an empty name, and a pattern with no segments, which can match no path.
pub fn well_formed<a>(table: List<Route<a>>) -> List<{ index: Int, reason: String }> / {} =
  indexed_routes(table).fold(
    [],
    |accumulator: List<{ index: Int, reason: String }>, e: IndexedRoute<a>|
      concat_faults(accumulator, faults(e.index, e.route.path)),
  )

fn faults(index: Int, pattern: List<Segment>) -> List<{ index: Int, reason: String }> =
  concat_faults(shape_faults(index, pattern), name_faults(index, binder_names(pattern)))

fn shape_faults(index: Int, pattern: List<Segment>) -> List<{ index: Int, reason: String }> =
  if pattern.len() == 0 {
    [{ index: index, reason: "this pattern has no segments, so it matches no path" }]
  } else if rest_is_early(pattern) {
    [{ index: index, reason: "a `Rest` segment captures what is left, so it must be the last one" }]
  } else { [] }

fn rest_is_early(pattern: List<Segment>) -> Bool =
  match pattern {
    [] -> false,
    [only] -> false,
    [first, ..rest] -> is_rest(first) || rest_is_early(rest),
  }

fn is_rest(s: Segment) -> Bool = match s { Rest(_) -> true, _ -> false }

reuse fn binder_names(pattern: List<Segment>) -> List<String> =
  pattern.fold([], |accumulator: List<String>, s: Segment|
    match binder_name(s) { Some(n) -> accumulator.push(n), None -> accumulator })

fn binder_name(s: Segment) -> Option<String> =
  match s {
    Literal(_) -> None,
    Param(name) -> Some(name),
    Typed(binding) -> Some(binding.name),
    Rest(name) -> Some(name),
  }

fn name_faults(index: Int, names: List<String>) -> List<{ index: Int, reason: String }> = {
  let counts = names.fold(Map::new(), |accumulator: Map<String, Int>, n: String|
    accumulator.insert(n, count_of(accumulator, n) + 1));
  counts.entries().fold(
    [],
    |accumulator: List<{ index: Int, reason: String }>, e: { key: String, value: Int }|
      concat_faults(accumulator, name_fault(index, e)),
  )
}

fn count_of(counts: Map<String, Int>, name: String) -> Int =
  match counts.get(name) { Some(n) -> n, None -> 0 }

fn name_fault(index: Int, e: { key: String, value: Int }) -> List<{ index: Int, reason: String }> =
  if e.key == "" { [{ index: index, reason: "a segment binds a parameter with no name" }] }
  else if e.value > 1 {
    [{ index: index, reason: "`" ++ e.key ++ "` is bound by more than one segment" }]
  } else { [] }

reuse fn concat_faults(
  x: List<{ index: Int, reason: String }>,
  y: List<{ index: Int, reason: String }>,
) -> List<{ index: Int, reason: String }> =
  y.fold(
    x,
    |accumulator: List<{ index: Int, reason: String }>, f: { index: Int, reason: String }|
      accumulator.push(f),
  )

type IndexedRoute<a> = { index: Int, route: Route<a> }

type IndexingState<a> = { out: List<IndexedRoute<a>>, next: Int }

fn indexed_routes<a>(table: List<Route<a>>) -> List<IndexedRoute<a>> =
  table.fold({ next: 0, out: [] }, |accumulator: IndexingState<a>, r: Route<a>|
    {
      next: accumulator.next + 1,
      out: accumulator.out.push({ index: accumulator.next, route: r }),
    }).out

/// One row in a listing of a table: a route's method, its pattern as text, and the name of its
/// endpoint.
pub type Listing = { method: http::Method, pattern: String, endpoint: String }

/// Each route of the table, its endpoint named by `show`.
pub fn listing<a | e>(
  table: List<Route<a>>,
  show: (a) -> String / e,
) -> List<Listing> / {abort.raise | e} =
  table.map(|r: Route<a>|
    { method: r.method, pattern: pattern_to_string(r.path), endpoint: show(r.endpoint) })

/// Returns one line of text for each route in the table, made from its method, pattern and endpoint
/// name as `show` gives it.
pub fn route_lines<a | e>(
  table: List<Route<a>>,
  show: (a) -> String / e,
) -> List<String> / {abort.raise | e} =
  listing(table, show).map(|l: Listing|
    http::method_name(l.method) ++ " " ++ l.pattern ++ " -> " ++ l.endpoint)

/// The methods a path allows: what a `405` needs, and what an `OPTIONS` on a concrete path
/// returns.
pub fn allowed<a>(table: List<Route<a>>, path: String) -> List<http::Method> / {abort.raise} = {
  let segments = path_segments(path);
  sorted_methods(
    table.fold([], |accumulator: List<http::Method>, r: Route<a>|
      match capture(r.path, segments, Map::new()) {
        None -> accumulator,
        Some(_) -> accumulator.push(r.method),
      }),
  )
}

/// What `OPTIONS *` returns: the methods the table declares anywhere.
pub fn declared_methods<a>(table: List<Route<a>>) -> List<http::Method> / {} =
  sorted_methods(table.map(|r: Route<a>| r.method))

fn sorted_methods(ms: List<http::Method>) -> List<http::Method> =
  ms.fold(Map::new(), |accumulator: Map<http::Method, Unit>, m: http::Method|
    accumulator.insert(m, ())).keys(
  )

/// The path split on `/`, then each segment decoded, in that order.
pub fn path_segments(path: String) -> List<String> / {abort.raise} =
  split_path(path).map(|s: String| percent_decode(s))

/// The path split on `/`, a leading `/` dropped, before any decoding.
pub fn split_path(path: String) -> List<String> =
  drop_leading(path.split("/"), path.starts_with("/"))

fn drop_leading(parts: List<String>, leading: Bool) -> List<String> =
  if leading { match parts { [_, ..rest] -> rest, [] -> [] } } else { parts }

fn join_segments(segments: List<String>) -> String / {abort.raise} =
  String::of_bytes(Bytes::join(segments.map(|s: String| Bytes::of_string(s)), b"/"))

/// Returns `text` with each `%XX` escape replaced by the byte it names. Returns `text` unchanged if
/// the decoded bytes are not valid UTF-8. Decode a single path segment after splitting the path on
/// `/`, so that `%2F` never splits a segment.
pub fn percent_decode(text: String) -> String / {abort.raise} = {
  let raw = Bytes::of_string(text);
  match raw.index_of_byte(37) { None -> text, Some(_) -> as_text(text, decoded_bytes(raw)) }
}

fn as_text(original: String, decoded: Bytes) -> String / {abort.raise} =
  if decoded.is_utf8() { String::of_bytes(decoded) } else { original }

fn decoded_bytes(raw: Bytes) -> Bytes / {abort.raise} = {
  let hex = hex_table;
  let table = byte_table;
  match raw.split(b"%") {
    [first, ..rest] ->
      first.concat(Bytes::concat_all(rest.map(|p: Bytes| decode_escape(p, hex, table)))),
    [] -> raw,
  }
}

fn decode_escape(part: Bytes, hex: Bytes, table: Bytes) -> Bytes / {abort.raise} = {
  let n = part.len();
  let hi = if n < 2 { 0 } else { hex.at(part.at(0)) };
  let lo = if n < 2 { 0 } else { hex.at(part.at(1)) };
  if hi == 0 || lo == 0 { b"%".concat(part) }
  else if n == 2 { table.slice((hi - 1) * 16 + lo - 1, (hi - 1) * 16 + lo) }
  else { table.slice((hi - 1) * 16 + lo - 1, (hi - 1) * 16 + lo).concat(part.slice(2, n)) }
}

const hex_table: Bytes =
  b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x00\x00\x00\x00\x00\x00\x00\x0b\x0c\x0d\x0e\x0f\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0b\x0c\x0d\x0e\x0f\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"

/// Escapes everything that decides where a segment ends, so an encoded segment splits back into one.
pub fn percent_encode(text: String) -> String / {abort.raise} = {
  let raw = Bytes::of_string(text);
  let n = raw.len();
  if raw.scan_until(0, must_encode, n) >= n { text } else {
    let escapes = must_encode;
    let table = byte_table;
    String::of_bytes(
      Bytes::concat_all(range(0, n).map(|i: Int| encode_byte(raw.at(i), escapes, table))),
    )
  }
}

fn encode_byte(c: Int, escapes: Bytes, table: Bytes) -> Bytes / {abort.raise} =
  match escapes.index_of_byte(c) { Some(_) -> escaped(c), None -> table.slice(c, c + 1) }

const must_encode: Bytes =
  b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x7f%/?#"

fn escaped(c: Int) -> Bytes / {abort.raise} = b"%".concat(hex_char(c / 16).concat(hex_char(c % 16)))

fn hex_char(v: Int) -> Bytes / {abort.raise} = b"0123456789ABCDEF".slice(v, v + 1)

const byte_table: Bytes =
  b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"

/// Returns the canonical form of `path`. Empty and `.` segments are dropped, and `..` removes the
/// previous segment (at the root it does nothing). Each segment is percent-decoded before `..` is
/// resolved and then encoded again, so `route` splits the result into the same segments as the
/// original path.
pub fn normalize_path(path: String) -> String / {abort.raise} =
  "/" ++ join_segments(remove_dot_segments(path_segments(path)).map(|s: String| percent_encode(s)))

type Stack = { items: Map<Int, String>, depth: Int }

fn remove_dot_segments(segments: List<String>) -> List<String> = {
  let out = segments.fold({ items: Map::new(), depth: 0 }, |st: Stack, s: String|
    step_segment(st, s));
  range(0, out.depth).map(|i: Int| stack_at(out.items, i))
}

fn step_segment(st: Stack, s: String) -> Stack =
  if s == "" || s == "." { st }
  else if s == ".." { { items: st.items, depth: if st.depth > 0 { st.depth - 1 } else { 0 } } }
  else { { items: st.items.insert(st.depth, s), depth: st.depth + 1 } }

fn stack_at(items: Map<Int, String>, i: Int) -> String =
  match items.get(i) { Some(s) -> s, None -> "" }

/// Parses a pattern from text. A segment is a literal, `{name}` for a parameter, `{name:Type}` for
/// a typed parameter, or `{..name}` for the rest. Raises for an unknown type.
pub fn pattern_of_string(text: String) -> List<Segment> / {abort.raise} =
  split_path(text).map(|s: String| segment_of_string(s))

fn segment_of_string(s: String) -> Segment / {abort.raise} =
  if s.starts_with("{") && s.ends_with("}") && s.len() >= 2 {
    binder_of_string(s.slice(1, s.len() - 1))
  } else { Literal(s) }

fn binder_of_string(inner: String) -> Segment / {abort.raise} =
  if inner.starts_with("..") { Rest(inner.slice(2, inner.len())) }
  else if inner.contains(":") { typed_of_string(inner, inner.find(":")) }
  else { Param(inner) }

fn typed_of_string(inner: String, colon: Int) -> Segment / {abort.raise} =
  Typed({ name: inner.slice(0, colon), kind: kind_of_string(inner.slice(colon + 1, inner.len())) })

fn kind_of_string(name: String) -> ParamType / {abort.raise} =
  if name == "Int" { IntParam }
  else if name == "Decimal" { DecimalParam }
  else if name == "Bool" { BoolParam }
  else { panic("`" ++ name ++ "` names no parameter type; they are `Int`, `Decimal` and `Bool`") }

/// Returns the text form of `pattern`. `pattern_of_string` parses that text back into the same
/// pattern.
pub fn pattern_to_string(pattern: List<Segment>) -> String / {abort.raise} =
  "/" ++ join_segments(pattern.map(|s: Segment| segment_to_string(s)))

fn segment_to_string(s: Segment) -> String =
  match s {
    Literal(text) -> text,
    Param(name) -> "{" ++ name ++ "}",
    Typed(binding) -> "{" ++ binding.name ++ ":" ++ kind_to_string(binding.kind) ++ "}",
    Rest(name) -> "{.." ++ name ++ "}",
  }

fn kind_to_string(kind: ParamType) -> String =
  match kind { IntParam -> "Int", DecimalParam -> "Decimal", BoolParam -> "Bool" }

fn segments() -> gen::Gen<Segment> =
  gen::one_of([
    gen::map(gen::text(), |f0: String| Literal(f0)),
    gen::map(gen::text(), |f0: String| Param(f0)),
    gen::map(bindings(), |f0: Binding| Typed(f0)),
    gen::map(gen::text(), |f0: String| Rest(f0)),
  ])

fn bindings() -> gen::Gen<Binding> =
  gen::map2(gen::text(), param_types(), |name: String, kind: ParamType| { name: name, kind: kind })

fn param_types() -> gen::Gen<ParamType> = gen::elements([IntParam, DecimalParam, BoolParam])

test "decoding undoes encoding" {
  gen::check(gen::text(), |x: String| inverse(percent_encode, percent_decode, x))
}

test "two patterns cannot each be more specific than the other" {
  gen::check2(gen::list(segments()), gen::list(segments()), |x: List<Segment>, y: List<Segment>| {
    !(more_specific(x, y) && more_specific(y, x))
  })
}

type Endpoint = | ListOrders | CreateOrder | GetOrder | GetOrderLines | LatestOrder | Files | Health

fn table() -> List<Route<Endpoint>> / {abort.raise} =
  [
    { method: http::Get, path: pattern_of_string("/health"), endpoint: Health },
    { method: http::Get, path: pattern_of_string("/orders"), endpoint: ListOrders },
    { method: http::Post, path: pattern_of_string("/orders"), endpoint: CreateOrder },
    { method: http::Get, path: pattern_of_string("/orders/latest"), endpoint: LatestOrder },
    { method: http::Get, path: pattern_of_string("/orders/{id:Int}"), endpoint: GetOrder },
    {
      method: http::Get,
      path: pattern_of_string("/orders/{id:Int}/lines"),
      endpoint: GetOrderLines,
    },
    { method: http::Get, path: pattern_of_string("/files/{..rest}"), endpoint: Files },
  ]

fn found<a>(m: RouteResult<a>) -> a / {abort.raise} =
  match m {
    Found(hit) -> hit.endpoint,
    NotFound -> panic("expected a route to match"),
    MethodNotAllowed(_) -> panic("expected a route to match under this method"),
  }

fn params_of(m: RouteResult<Endpoint>) -> Map<String, String> / {abort.raise} =
  match m {
    Found(hit) -> hit.params,
    NotFound -> panic("expected a route to match"),
    MethodNotAllowed(_) -> panic("expected a route to match under this method"),
  }

fn get(path: String) -> RouteResult<Endpoint> / {abort.raise} = route(table(), http::Get, path)

test "the example route table has no conflicting entries and no malformed entries" {
  assert_eq(conflicts(table()), []);
  assert_eq(well_formed(table()), [])
}

test "a literal path matches its route" {
  assert_eq(found(get("/health")), Health);
  assert_eq(found(get("/orders")), ListOrders);
  assert_eq(found(route(table(), http::Post, "/orders")), CreateOrder)
}

test "a parameter captures one segment and is typed by the pattern" {
  assert_eq(found(get("/orders/17")), GetOrder);
  assert_eq(int_param(params_of(get("/orders/17")), "id"), Some(17));
  assert_eq(int_param_or(params_of(get("/orders/17")), "id", 0), 17);
  assert_eq(param(params_of(get("/orders/17")), "id"), Some("17"));
  assert_eq(found(get("/orders/17/lines")), GetOrderLines)
}

test "a parameter that does not parse is not a match" {
  assert_eq(get("/orders/abc"), NotFound);
  assert_eq(get("/orders/1.5"), NotFound);
  assert_eq(get("/orders/007"), NotFound);
  assert_eq(get("/orders/-0"), NotFound);
  assert_eq(get("/orders/+7"), NotFound);
  assert_eq(get("/orders/ 7"), NotFound);
  assert_eq(get("/orders/99999999999999999999999999999999"), NotFound)
}

test "a wildcard segment captures the remaining segments joined by slashes, and may capture none" {
  assert_eq(found(get("/files/a/b/c.txt")), Files);
  assert_eq(param(params_of(get("/files/a/b/c.txt")), "rest"), Some("a/b/c.txt"));
  assert_eq(param(params_of(get("/files")), "rest"), Some(""));
  assert_eq(param(params_of(get("/files/")), "rest"), Some(""))
}

test "a wildcard segment captures the decoded text, so `a%2Fb` gives the same capture as `a/b`" {
  assert_eq(
    param(params_of(get("/files/a%2Fb")), "rest"),
    param(params_of(get("/files/a/b")), "rest"),
  )
}

test "literal beats typed beats parameter beats wildcard, left to right" {
  let t = [
    { method: http::Get, path: pattern_of_string("/orders/{..rest}"), endpoint: Files },
    { method: http::Get, path: pattern_of_string("/orders/{name}"), endpoint: ListOrders },
    { method: http::Get, path: pattern_of_string("/orders/{id:Int}"), endpoint: GetOrder },
    { method: http::Get, path: pattern_of_string("/orders/latest"), endpoint: LatestOrder },
  ];
  assert_eq(found(route(t, http::Get, "/orders/latest")), LatestOrder);
  assert_eq(found(route(t, http::Get, "/orders/7")), GetOrder);
  assert_eq(found(route(t, http::Get, "/orders/other")), ListOrders);
  assert_eq(found(route(t, http::Get, "/orders/a/b")), Files)
}

test "precedence is decided at the first position where two patterns differ" {
  let t = [
    { method: http::Get, path: pattern_of_string("/{a}/lines"), endpoint: GetOrderLines },
    { method: http::Get, path: pattern_of_string("/orders/{b}"), endpoint: GetOrder },
  ];
  assert_eq(found(route(t, http::Get, "/orders/lines")), GetOrder);
  assert_eq(more_specific(pattern_of_string("/orders/{b}"), pattern_of_string("/{a}/lines")), true);
  assert_eq(more_specific(pattern_of_string("/{a}/lines"), pattern_of_string("/orders/{b}")), false)
}

test "a request for `/files` matches the shorter pattern `/files`, not the longer wildcard pattern `/files/{..rest}`" {
  let t = [
    { method: http::Get, path: pattern_of_string("/files"), endpoint: Health },
    { method: http::Get, path: pattern_of_string("/files/{..rest}"), endpoint: Files },
  ];
  assert_eq(found(route(t, http::Get, "/files")), Files)
}

test "a tie between two patterns routes to the earlier entry, and `conflicts` reports that pair" {
  let t = [
    { method: http::Get, path: pattern_of_string("/orders/{id}"), endpoint: GetOrder },
    { method: http::Get, path: pattern_of_string("/orders/{name}"), endpoint: ListOrders },
    { method: http::Post, path: pattern_of_string("/orders/{id}"), endpoint: CreateOrder },
  ];
  assert_eq(found(route(t, http::Get, "/orders/7")), GetOrder);
  assert_eq(conflicts(t), [{ first: 0, second: 1 }])
}

test "`conflicts` reports a pair only when some path matches both patterns with equal precedence" {
  assert_eq(
    conflicts([
      { method: http::Get, path: pattern_of_string("/a"), endpoint: Health },
      { method: http::Get, path: pattern_of_string("/b"), endpoint: ListOrders },
    ]),
    [],
  );
  assert_eq(
    conflicts([
      { method: http::Get, path: pattern_of_string("/{id:Int}"), endpoint: GetOrder },
      { method: http::Get, path: pattern_of_string("/{name}"), endpoint: ListOrders },
    ]),
    [],
  );
  assert_eq(
    conflicts([
      { method: http::Get, path: pattern_of_string("/{id:Int}"), endpoint: GetOrder },
      { method: http::Get, path: pattern_of_string("/{flag:Bool}"), endpoint: Health },
    ]),
    [],
  );
  assert_eq(
    conflicts([
      { method: http::Get, path: pattern_of_string("/{id:Int}"), endpoint: GetOrder },
      { method: http::Get, path: pattern_of_string("/{n:Decimal}"), endpoint: Health },
    ]),
    [{ first: 0, second: 1 }],
  )
}

test "a path no route matches is not found" {
  assert_eq(get("/nothing"), NotFound);
  assert_eq(get("/orders/17/lines/3"), NotFound);
  assert_eq(get(""), NotFound);
  assert_eq(route([], http::Get, "/anything"), NotFound);
  assert_eq(conflicts([]), []);
  assert_eq(well_formed([]), [])
}

test "an untyped parameter captures an empty segment, but an `Int` parameter does not match one" {
  let t = [
    { method: http::Get, path: pattern_of_string("/users/{name}"), endpoint: ListOrders },
    { method: http::Get, path: pattern_of_string("/orders/{id:Int}"), endpoint: GetOrder },
  ];
  assert_eq(param(params_of(route(t, http::Get, "/users/")), "name"), Some(""));
  assert_eq(route(t, http::Get, "/orders/"), NotFound)
}

test "a `Rest` segment that is not last still captures all remaining segments, and `well_formed` reports the misplaced `Rest` segment" {
  let t = [{ method: http::Get, path: [Rest("r"), Literal("x")], endpoint: Files }];
  assert_eq(found(route(t, http::Get, "/a/b")), Files);
  assert_eq(param(params_of(route(t, http::Get, "/a/b")), "r"), Some("a/b"));
  assert_eq(well_formed(t).len(), 1)
}

test "a path that matches under another method is a 405 with sorted methods" {
  assert_eq(route(table(), http::Delete, "/orders"), MethodNotAllowed([http::Get, http::Post]));
  assert_eq(route(table(), http::Delete, "/health"), MethodNotAllowed([http::Get]));
  assert_eq(allowed(table(), "/orders"), [http::Get, http::Post]);
  assert_eq(allowed(table(), "/nothing"), [])
}

test "the allowed methods are deduplicated" {
  let t = [
    { method: http::Get, path: pattern_of_string("/a/{x}"), endpoint: Health },
    { method: http::Get, path: pattern_of_string("/a/b"), endpoint: ListOrders },
    { method: http::Post, path: pattern_of_string("/a/b"), endpoint: CreateOrder },
  ];
  assert_eq(route(t, http::Put, "/a/b"), MethodNotAllowed([http::Get, http::Post]));
  assert_eq(declared_methods(t), [http::Get, http::Post])
}

test "`path_segments` splits on slashes before percent-decoding, so `%2F` stays inside one segment" {
  assert_eq(path_segments("/a%2Fb"), ["a/b"]);
  assert_eq(path_segments("/a/b"), ["a", "b"]);
  assert_eq(path_segments("/a%2Fb").len(), 1);
  let t = [{ method: http::Get, path: [Literal("a/b")], endpoint: Health }];
  assert_eq(found(route(t, http::Get, "/a%2Fb")), Health);
  assert_eq(route(t, http::Get, "/a/b"), NotFound)
}

test "an invalid escape is left as written" {
  assert_eq(percent_decode("%zz"), "%zz");
  assert_eq(percent_decode("%4"), "%4");
  assert_eq(percent_decode("%"), "%");
  assert_eq(percent_decode("a%20b%"), "a b%");
  assert_eq(percent_decode("%41%42"), "AB");
  assert_eq(percent_decode("%c3%a9"), "é");
  assert_eq(percent_decode("%ff"), "%ff")
}

test "`path_segments` preserves empty segments, so `/orders` and `/orders/` route to different endpoints" {
  assert_eq(path_segments("/orders/"), ["orders", ""]);
  assert_eq(path_segments("/a//b"), ["a", "", "b"]);
  assert_eq(path_segments("/"), [""]);
  let t = [
    { method: http::Get, path: pattern_of_string("/orders"), endpoint: ListOrders },
    { method: http::Get, path: pattern_of_string("/orders/"), endpoint: CreateOrder },
  ];
  assert_eq(found(route(t, http::Get, "/orders")), ListOrders);
  assert_eq(found(route(t, http::Get, "/orders/")), CreateOrder)
}

test "matching is byte-exact and case-sensitive" {
  assert_eq(get("/Health"), NotFound);
  assert_eq(get("/health "), NotFound)
}

test "`well_formed` reports entries that can never match as written, such as a misplaced `Rest` or a repeated name" {
  assert_eq(
    well_formed([{ method: http::Get, path: [Rest("rest"), Literal("x")], endpoint: Files }]),
    [{ index: 0, reason: "a `Rest` segment captures what is left, so it must be the last one" }],
  );

  assert_eq(
    well_formed([{ method: http::Get, path: pattern_of_string("/{id}/{id}"), endpoint: GetOrder }]),
    [{ index: 0, reason: "`id` is bound by more than one segment" }],
  );

  assert_eq(well_formed([{ method: http::Get, path: [], endpoint: Health }]), [
    { index: 0, reason: "this pattern has no segments, so it matches no path" },
  ]);

  assert_eq(well_formed([{ method: http::Get, path: [Param("")], endpoint: Health }]), [
    { index: 0, reason: "a segment binds a parameter with no name" },
  ]);

  assert_eq(
    well_formed([
      { method: http::Get, path: pattern_of_string("/ok"), endpoint: Health },
      { method: http::Get, path: pattern_of_string("/{x:Int}/{..x}"), endpoint: Files },
    ]),
    [{ index: 1, reason: "`x` is bound by more than one segment" }],
  )
}

test "a pattern written as text is the same value read back" {
  assert_eq(pattern_of_string("/orders/{id:Int}/{name}/{..rest}"), [
    Literal("orders"),
    Typed({ name: "id", kind: IntParam }),
    Param("name"),
    Rest("rest"),
  ]);
  assert_eq(pattern_to_string(pattern_of_string("/orders/{id:Int}")), "/orders/{id:Int}");
  assert_eq(pattern_to_string(pattern_of_string("/files/{..rest}")), "/files/{..rest}");
  assert_eq(pattern_to_string(pattern_of_string("/orders/")), "/orders/");
  assert_eq(pattern_of_string("/a{b}c"), [Literal("a{b}c")])
}

test "`route_lines` and `listing` describe each table entry as its method, pattern and endpoint name" {
  assert_eq(route_lines(table(), |e: Endpoint| endpoint_name(e)), [
    "GET /health -> Health",
    "GET /orders -> ListOrders",
    "POST /orders -> CreateOrder",
    "GET /orders/latest -> LatestOrder",
    "GET /orders/{id:Int} -> GetOrder",
    "GET /orders/{id:Int}/lines -> GetOrderLines",
    "GET /files/{..rest} -> Files",
  ]);
  assert_eq(
    listing(table(), |e: Endpoint| endpoint_name(e)),
    table().map(|r: Route<Endpoint>|
      {
        method: r.method,
        pattern: pattern_to_string(r.path),
        endpoint: endpoint_name(r.endpoint),
      }),
  )
}

fn endpoint_name(e: Endpoint) -> String =
  match e {
    ListOrders -> "ListOrders",
    CreateOrder -> "CreateOrder",
    GetOrder -> "GetOrder",
    GetOrderLines -> "GetOrderLines",
    LatestOrder -> "LatestOrder",
    Files -> "Files",
    Health -> "Health",
  }

test "`route` returns `MethodNotAllowed` for an unrecognised method with no table entry, and matches the entry when the table has one" {
  assert_eq(
    route(table(), http::Other("BREW"), "/orders"),
    MethodNotAllowed([http::Get, http::Post]),
  );
  let t = [{ method: http::Other("BREW"), path: pattern_of_string("/coffee"), endpoint: Health }];
  assert_eq(found(route(t, http::Other("BREW"), "/coffee")), Health)
}

test "`int_of_text` parses only the canonical decimal form of an integer and returns `None` for any other text" {
  assert_eq(int_of_text("0"), Some(0));
  assert_eq(int_of_text("-7"), Some(-7));
  assert_eq(int_of_text("2147483648"), Some(2147483648));
  assert_eq(int_of_text(""), None);
  assert_eq(int_of_text("-"), None);
  assert_eq(int_of_text("00"), None);
  assert_eq(int_of_text("-0"), None);
  assert_eq(int_of_text("1_0"), None);
  assert_eq(int_of_text("1e3"), None);
  assert_eq(int_of_text("7 "), None)
}

test "a decimal parameter takes a fraction and nothing else" {
  assert_eq(decimal_of_text("10.99"), Some(10.99m));
  assert_eq(decimal_of_text("-0.5"), Some(-0.5m));
  assert_eq(decimal_of_text("7"), Some(7m));
  assert_eq(decimal_of_text("7."), None);
  assert_eq(decimal_of_text(".5"), None);
  assert_eq(decimal_of_text("1e3"), None);
  assert_eq(decimal_of_text("01.5"), None);
  assert_eq(bool_of_text("true"), Some(true));
  assert_eq(bool_of_text("True"), None)
}

test "a decimal and a bool parameter match only what parses" {
  let t = [
    { method: http::Get, path: pattern_of_string("/price/{p:Decimal}"), endpoint: Health },
    { method: http::Get, path: pattern_of_string("/flag/{f:Bool}"), endpoint: ListOrders },
  ];
  assert_eq(found(route(t, http::Get, "/price/10.99")), Health);
  assert_eq(decimal_param(params_of(route(t, http::Get, "/price/10.99")), "p"), Some(10.99m));
  assert_eq(route(t, http::Get, "/price/free"), NotFound);
  assert_eq(bool_param(params_of(route(t, http::Get, "/flag/false")), "f"), Some(false));
  assert_eq(route(t, http::Get, "/flag/1"), NotFound)
}

test "`normalize_path` percent-decodes before removing `.` and `..` segments, and keeps an encoded slash inside one segment" {
  assert_eq(normalize_path("/a//b/"), "/a/b");
  assert_eq(normalize_path("/a/./b"), "/a/b");
  assert_eq(normalize_path("/a/../b"), "/b");
  assert_eq(normalize_path("/../../b"), "/b");
  assert_eq(normalize_path("/"), "/");
  assert_eq(normalize_path("/a/.."), "/");
  assert_eq(normalize_path("/a/%2e%2e/b"), "/b");
  assert_eq(normalize_path("/a%2Fb"), "/a%2Fb");
  assert_eq(path_segments(normalize_path("/a%2Fb")), ["a/b"]);
  assert_eq(normalize_path("/a b"), "/a%20b");
  assert_eq(path_segments(normalize_path("/a b")), ["a b"])
}

test "an encoded segment survives a round trip whatever it contains" {
  assert_eq(percent_decode(percent_encode("a/b")), "a/b");
  assert_eq(percent_decode(percent_encode("100%")), "100%");
  assert_eq(percent_decode(percent_encode("é ?#")), "é ?#");
  assert_eq(percent_encode("a/b"), "a%2Fb");
  assert_eq(split_path("/" ++ percent_encode("a/b/c")).len(), 1)
}

type Guarded = | Admin | Wild | Item | Slug | Posted | Deleted | Any | One

const guarded: List<Route<Guarded>> =
  [
    { method: http::Get, path: pattern_of_string("/admin"), endpoint: Admin },
    { method: http::Get, path: pattern_of_string("/files/{..rest}"), endpoint: Wild },
    { method: http::Get, path: pattern_of_string("/orders/{id:Int}"), endpoint: Item },
    { method: http::Get, path: pattern_of_string("/orders/{slug}"), endpoint: Slug },
    { method: http::Post, path: pattern_of_string("/orders/{slug}"), endpoint: Posted },
    { method: http::Delete, path: pattern_of_string("/orders/{slug}"), endpoint: Deleted },
  ]

const guarded_reversed: List<Route<Guarded>> = guarded.reverse()

fn guarded_get(path: String) -> RouteResult<Guarded> / {abort.raise} =
  route(guarded, http::Get, path)

fn captured_param(m: RouteResult<Guarded>, name: String) -> String =
  match m { Found(hit) -> param_or(hit.params, name, "<unbound>"), _ -> "<no match>" }

test "a dot-dot segment never leaves the route it was matched against" {
  assert_eq(path_segments("/public/../admin"), ["public", "..", "admin"]);
  assert_eq(guarded_get("/public/../admin"), NotFound);
  assert_eq(
    guarded_get("/files/../admin"),
    Found({ endpoint: Wild, params: Map::of_entries([{ key: "rest", value: "../admin" }]) }),
  );
  assert_eq(found(guarded_get("/admin")), Admin)
}

test "an encoded dot (`%2e`) decodes to a dot segment, so `..` cannot be used to escape a route" {
  assert_eq(path_segments("/public/%2e%2e/admin"), ["public", "..", "admin"]);
  assert_eq(path_segments("/public/%2E%2E/admin"), ["public", "..", "admin"]);
  assert_eq(guarded_get("/public/%2e%2e/admin"), NotFound);
  assert_eq(
    captured_param(guarded_get("/files/%2e%2e/%2e%2e/etc/passwd"), "rest"),
    "../../etc/passwd",
  )
}

test "decoding happens exactly once" {
  assert_eq(path_segments("/a/%252e%252e/b"), ["a", "%2e%2e", "b"]);
  assert_eq(percent_decode("%252F"), "%2F");
  assert_eq(normalize_path("/a/%2e%2e/b"), "/b");
  assert_eq(normalize_path("/a/%252e%252e/b"), "/a/%252e%252e/b")
}

test "an encoded separator is a byte inside one segment" {
  assert_eq(path_segments("/files%2F..%2F..%2Fetc"), ["files/../../etc"]);
  assert_eq(guarded_get("/files%2F..%2F..%2Fetc"), NotFound)
}

test "a percent-encoded null byte is part of the segment, so `/admin%00` does not match the literal `admin`" {
  assert_eq(guarded_get("/admin%00"), NotFound);
  assert_eq(path_segments("/admin%00").len(), 1);
  assert_eq(captured_param(guarded_get("/orders/x%00"), "slug"), "x\0")
}

test "a table with its entries in reverse order returns the same `route` result as the original table for every tested path" {
  assert_eq(conflicts(guarded), []);
  assert_eq(conflicts(guarded_reversed), []);
  assert_eq(well_formed(guarded), []);
  [
    "/",
    "/admin",
    "/admin/",
    "/ADMIN",
    "/orders",
    "/orders/",
    "/orders/7",
    "/orders/007",
    "/orders/abc",
    "/orders/7/lines",
    "/files",
    "/files/",
    "/files/a/b",
    "/files/a%2Fb",
    "/a//b",
    "/nowhere",
    "",
    "/orders/%2e%2e",
  ].fold((), |_: Unit, p: String|
    assert_eq(route(guarded, http::Get, p), route(guarded_reversed, http::Get, p)))
}

test "`route` picks the entry whose method matches the request over an earlier entry for another method" {
  let t = [
    { method: http::Post, path: pattern_of_string("/p"), endpoint: Posted },
    { method: http::Get, path: pattern_of_string("/p"), endpoint: Admin },
  ];
  assert_eq(found(route(t, http::Get, "/p")), Admin);
  assert_eq(found(route(t, http::Post, "/p")), Posted)
}

test "a typed parameter that does not parse falls through rather than 404ing" {
  assert_eq(found(guarded_get("/orders/7")), Item);
  assert_eq(found(guarded_get("/orders/abc")), Slug);
  assert_eq(found(guarded_get("/orders/007")), Slug);
  assert_eq(found(guarded_get("/orders/")), Slug);
  assert_eq(captured_param(guarded_get("/orders/"), "slug"), "")
}

test "a wildcard matches only its own prefix, so `/file`, `/filesx` and `/x/files/a` are not found" {
  assert_eq(found(guarded_get("/files")), Wild);
  assert_eq(found(guarded_get("/files/")), Wild);
  assert_eq(captured_param(guarded_get("/files"), "rest"), "");
  assert_eq(captured_param(guarded_get("/files/"), "rest"), "");
  assert_eq(guarded_get("/file"), NotFound);
  assert_eq(guarded_get("/filesx"), NotFound);
  assert_eq(guarded_get("/x/files/a"), NotFound)
}

test "a wildcard written first shadows nothing that follows it" {
  let t = [
    { method: http::Get, path: pattern_of_string("/{..any}"), endpoint: Any },
    { method: http::Get, path: pattern_of_string("/admin"), endpoint: Admin },
    { method: http::Get, path: pattern_of_string("/{one}"), endpoint: One },
  ];
  assert_eq(found(route(t, http::Get, "/admin")), Admin);
  assert_eq(found(route(t, http::Get, "/other")), One);
  assert_eq(found(route(t, http::Get, "/a/b")), Any);
  assert_eq(conflicts(t), [])
}

test "`conflicts` reports an entry that is shadowed, because an earlier entry matches the same paths first" {
  let t = [
    { method: http::Get, path: pattern_of_string("/x/{a}"), endpoint: Admin },
    { method: http::Get, path: pattern_of_string("/x/{b}"), endpoint: Slug },
  ];
  assert_eq(found(route(t, http::Get, "/x/1")), Admin);
  assert_eq(conflicts(t), [{ first: 0, second: 1 }])
}

test "a path no pattern matches is 404 and one no method matches is 405" {
  assert_eq(route(guarded, http::Put, "/nowhere"), NotFound);
  assert_eq(
    route(guarded, http::Put, "/orders/abc"),
    MethodNotAllowed([http::Delete, http::Get, http::Post]),
  );
  assert_eq(
    route(guarded, http::Put, "/orders/7"),
    MethodNotAllowed([http::Delete, http::Get, http::Post]),
  )
}

test "the Allow list does not depend on the order the table was written in" {
  assert_eq(
    route(guarded_reversed, http::Put, "/orders/abc"),
    route(guarded, http::Put, "/orders/abc"),
  );
  assert_eq(allowed(guarded_reversed, "/orders/abc"), allowed(guarded, "/orders/abc"))
}

test "the Allow list is deduplicated across the routes that produced it" {
  let t = [
    { method: http::Get, path: pattern_of_string("/p/{a}"), endpoint: Slug },
    { method: http::Get, path: pattern_of_string("/p/x"), endpoint: Admin },
    { method: http::Get, path: pattern_of_string("/p/{..r}"), endpoint: Wild },
    { method: http::Post, path: pattern_of_string("/p/x"), endpoint: Posted },
  ];
  assert_eq(route(t, http::Put, "/p/x"), MethodNotAllowed([http::Get, http::Post]))
}

test "an unrecognised method is routed and handled rather than rejected" {
  assert_eq(
    route(guarded, http::Other("BREW"), "/orders/abc"),
    MethodNotAllowed([http::Delete, http::Get, http::Post]),
  );
  let t = [{ method: http::Other("BREW"), path: pattern_of_string("/coffee"), endpoint: Admin }];
  assert_eq(found(route(t, http::Other("BREW"), "/coffee")), Admin);
  assert_eq(route(t, http::Get, "/coffee"), MethodNotAllowed([http::Other("BREW")]))
}

test "a method is matched byte-exactly, so a lowercase token is another method" {
  assert_eq(route(guarded, http::Other("get"), "/admin"), MethodNotAllowed([http::Get]));
  assert_eq(guarded_get("/ADMIN"), NotFound);
  assert_eq(guarded_get("/Admin"), NotFound)
}

test "`path_segments` preserves empty segments, so `/admin/` and `//admin` do not match `/admin`" {
  assert_eq(path_segments("/"), [""]);
  assert_eq(path_segments("/a//b"), ["a", "", "b"]);
  assert_eq(path_segments("/admin/"), ["admin", ""]);
  assert_eq(guarded_get("/admin/"), NotFound);
  assert_eq(guarded_get("//admin"), NotFound);
  assert_eq(guarded_get("/"), NotFound)
}

test "a query string a caller failed to strip does not match" {
  assert_eq(path_segments("/admin?x=1"), ["admin?x=1"]);
  assert_eq(guarded_get("/admin?x=1"), NotFound)
}

test "an invalid escape is text rather than an error" {
  assert_eq(percent_decode("%zz"), "%zz");
  assert_eq(percent_decode("%4"), "%4");
  assert_eq(percent_decode("%"), "%");
  assert_eq(captured_param(guarded_get("/orders/%zz"), "slug"), "%zz")
}

test "a path with two thousand segments is routed" {
  let deep = range(0, 2000).fold("", |accumulator: String, _: Int| accumulator ++ "/a");
  assert_eq(path_segments(deep).len(), 2000);
  assert_eq(route(guarded, http::Get, deep), NotFound);
  assert_eq(captured_param(route(guarded, http::Get, "/files" ++ deep), "rest").len(), 3999)
}

fn repeated(s: String, k: Int) -> String = range(0, k).fold(s, |a: String, _: Int| a ++ a)

test "`percent_decode` decodes a very long sequence of escapes in full without stopping early" {
  let decoded = percent_decode(repeated("%41", 15));
  assert_eq(decoded.len(), 32768);
  assert_eq(decoded.slice(0, 4), "AAAA");
  assert_eq(percent_encode(repeated(" ", 15)).len(), 98304)
}

test "a path of nothing but escapes routes, whatever its length" {
  let t = [{ method: http::Get, path: pattern_of_string("/orders/{id:Int}"), endpoint: GetOrder }];
  assert_eq(route(t, http::Get, "/" ++ repeated("%41%41%41%41%41", 9)), NotFound);
  assert_eq(path_segments("/" ++ repeated("%41", 10)).len(), 1);
  assert_eq(percent_decode(repeated("%41", 10)).len(), 1024)
}
