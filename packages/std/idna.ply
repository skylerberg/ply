//! Internationalized domain names: a name as people write it, and its ASCII form on the wire.
//!
//! `to_ascii` and `to_unicode` are the two operations of UTS #46, Unicode IDNA Compatibility
//! Processing, with its mapping table for the Unicode version `std.ucd` names. Processing maps a
//! name (capitals to lower case, width and compatibility forms to the characters they represent,
//! some characters to nothing), normalizes it, splits it at its full stops, and checks each label.
//! A label that starts with `xn--` is decoded from Punycode first. `to_ascii` writes every label
//! that is not ASCII as Punycode after `xn--`. Processing is nontransitional: `U+00DF`, the final
//! sigma and the two joiners stay as they are. The transitional mapping, which UTS #46 deprecates,
//! is not offered.
//!
//! The caller chooses which checks apply, in an `Options` that has no default. `strict` turns on
//! every check: the rules a registry or a resolver applies to a name. `web` is the set the URL
//! Standard applies to a host, which accepts names that are in use even though they break a rule.
//! `to_ascii` rejects a name that fails a check, with every problem found and the label of each.
//! `to_unicode` returns the name converted as far as possible, together with its problems. It
//! produces the name to display, and a wrong name is still displayed.
//!
//! The rules behind the options come from IDNA2008: the hyphen rules of RFC 5891, the Bidi rule of
//! RFC 5893 and the two joiner rules of RFC 5892. The other contextual rules of IDNA2008, and its
//! narrower table of permitted characters, are not applied, since UTS #46 does not apply them.

import std.char
import std.char (sample_text, text_of)
import std.list
import std.punycode
import std.ucd
import std.ucd (SequencePool, Run, Table, ValueRun)
import std.unicode
import std.gen

type IdnaTable = { words: Table, points: Array<Int> }

fn disallowed() -> Int = 0

fn valid() -> Int = 1

fn deviation() -> Int = 2

fn ignored() -> Int = 3

fn mapped() -> Int = 4

fn status(letter: Bytes) -> Int / {abort.raise} =
  match letter {
    b"" -> disallowed(),
    b"v" -> valid(),
    b"d" -> deviation(),
    b"i" -> ignored(),
    b"m" -> mapped(),
    _ -> panic("an IDNA status letter is v (valid), d (deviation), i (ignored) or m (mapped)"),
  }

fn bidi(name: Bytes) -> Int =
  match name {
    b"L" -> 1,
    b"R" -> 2,
    b"AL" -> 3,
    b"AN" -> 4,
    b"EN" -> 5,
    b"ES" -> 6,
    b"CS" -> 7,
    b"ET" -> 8,
    b"ON" -> 9,
    b"BN" -> 10,
    b"NSM" -> 11,
    _ -> 0,
  }

fn left_to_right() -> Int = 1

fn right() -> Int = 2

fn arabic_letter() -> Int = 3

fn arabic_number() -> Int = 4

fn european_number() -> Int = 5

fn nonspacing() -> Int = 11

fn joining_type_bits(letters: Bytes) -> Int / {abort.raise} =
  range(0, letters.len()).fold(0, |bits: Int, i: Int|
    bits
      | (match letters.at(i) {
        b'D' -> 1 << 7,
        b'L' -> 2 << 7,
        b'R' -> 3 << 7,
        b'T' -> 4 << 7,
        b'v' -> 1 << 10,
        _ ->
          panic(
            "a joining type letter must be D, L, R or T (dual, left, right or transparent joining), or `v` for a virama (a combining mark that removes a vowel)",
          ),
      }))

fn sequence_mapping_bit() -> Int = 1 << 11

type TableBuilder = { valued: List<ValueRun>, pool: SequencePool }

fn idna_table_of(runs: List<Run>) -> IdnaTable / {abort.raise} = {
  let made = runs.fold({ valued: [], pool: ucd::empty_pool() }, |m: TableBuilder, run: Run| {
    let field = |i: Int| match run.fields.at(i) { Some(text) -> text, None -> b"" };
    let bits = status(field(0)) | bidi(field(2)) << 3 | joining_type_bits(field(3));
    let mapping = field(1);
    if mapping.starts_with(b"+") || mapping.starts_with(b"-") || mapping.len() == 0 {
      let far = ucd::parse_offset(if mapping.starts_with(b"+") { mapping.slice(1, mapping.len()) }
      else { mapping });
      {
        valued: m.valued.push({ first: run.first, last: run.last, value: bits | far << 12 }),
        pool: m.pool,
      }
    } else {
      let put = ucd::intern(m.pool, ucd::code_points(mapping));
      {
        valued: m.valued.push({
          first: run.first,
          last: run.last,
          value: bits | sequence_mapping_bit() | put.place << 12,
        }),
        pool: put.gathering,
      }
    }
  });
  { words: ucd::table_of(made.valued, 0), points: Array::of_list(made.pool.points) }
}

const fn idna_table() -> IdnaTable = idna_table_of(ucd::runs(embed("ucd/idna.txt")))

fn status_of(word: Int) -> Int = word & 7

fn bidi_of(word: Int) -> Int = word >> 3 & 15

fn joining_of(word: Int) -> Int = word >> 7 & 7

fn is_virama(word: Int) -> Bool = word >> 10 & 1 == 1

/// Which of UTS #46's checks a name must pass. There is no default: `strict` and `web` are the two
/// named sets.
pub type Options = new {
  /// CheckHyphens: no label starts or ends with a hyphen, or has hyphens in its third and fourth
  /// places unless it is Punycode.
  check_hyphens: Bool,
  /// CheckBidi: a name with a right-to-left label meets the Bidi rule of RFC 5893 in every label.
  check_bidi: Bool,
  /// CheckJoiners: `U+200C` and `U+200D` appear only where RFC 5892 allows them.
  check_joiners: Bool,
  /// UseSTD3ASCIIRules: the only ASCII in a label is letters, digits and hyphens.
  use_std3_ascii_rules: Bool,
  /// VerifyDnsLength: every label is 1 to 63 characters of ASCII, and the name at most 253. Only
  /// `to_ascii` checks lengths; `to_unicode` ignores this option.
  verify_dns_length: Bool,
}

/// Every check turned on: the rules for names a registry would register and a resolver should look
/// up.
pub fn strict() -> Options =
  {
    check_hyphens: true,
    check_bidi: true,
    check_joiners: true,
    use_std3_ascii_rules: true,
    verify_dns_length: true,
  }

/// The checks the URL Standard applies to a host: the Bidi and joiner rules. It leaves out the
/// hyphen rules, the ASCII rules and the lengths, which names in use break.
pub fn web() -> Options =
  {
    check_hyphens: false,
    check_bidi: true,
    check_joiners: true,
    use_std3_ascii_rules: false,
    verify_dns_length: false,
  }

/// What is wrong with a label, or with the name.
pub type ErrorKind =
  /// A character that may not appear in a domain name: one UTS #46 disallows, or, in a label
  /// decoded from Punycode, a full stop or a character that maps to something else. Under
  /// `use_std3_ascii_rules` it is also any ASCII character other than a letter, a digit or a
  /// hyphen.
  | Disallowed
  /// A hyphen at the start or end of the label, or hyphens in both its third and fourth places.
  | Hyphens
  /// A label that starts with `xn--` and is not valid Punycode, contains a character that is not
  /// ASCII, or decodes to nothing or to ASCII alone.
  | Punycode
  /// A label decoded from Punycode that is not in Normalization Form C.
  | NotNormalized
  /// A combining mark at the start of the label.
  | LeadingMark
  /// A zero-width joiner or non-joiner where RFC 5892 does not allow one.
  | Joiner
  /// A label that breaks the Bidi rule of RFC 5893, in a name that has a right-to-left label.
  | Bidi
  /// A label of no characters.
  | EmptyLabel
  /// A label of more than 63 characters of ASCII.
  | LongLabel
  /// A name of more than 253 characters of ASCII.
  | LongName

/// One thing wrong with a name: the label it is in, counted from zero, and its kind. `LongName`
/// applies to the whole name, so its label is `-1`.
pub type Problem = { label: Int, reason: ErrorKind }

/// The broken rule as a sentence, for a diagnostic.
pub fn reason(reason: ErrorKind) -> String =
  match reason {
    Disallowed -> "a label contains a character that a domain name may not contain",
    Hyphens ->
      "a label starts or ends with a hyphen, or has hyphens as its third and fourth characters",
    Punycode ->
      "a label that starts with `xn--` must be valid Punycode (an ASCII encoding of Unicode text) that decodes to text with a non-ASCII character",
    NotNormalized ->
      "a label decoded from Punycode must be in Unicode Normalization Form C (composed characters)",
    LeadingMark ->
      "a label must not start with a combining mark (a character that attaches to the one before it)",
    Joiner ->
      "a zero-width joiner or zero-width non-joiner may appear in a label only where the rules for the label's script allow it",
    Bidi ->
      "if a name has a right-to-left label, every label in the name must follow the Unicode bidirectional text rule (RFC 5893)",
    EmptyLabel -> "a label must not be empty",
    LongLabel -> "a label must be at most 63 characters of ASCII",
    LongName -> "a name must be at most 253 characters of ASCII",
  }

/// A name as `to_unicode` converts it, and every problem found on the way.
pub type ConversionResult = { name: String, problems: List<Problem> }

/// How converting a name to ASCII fails.
pub effect idna {
  /// The name breaks the rules it was checked against. Reports each problem found.
  raise fail(problems: List<Problem>)
}

fn mapped_into(table: IdnaTable, out: List<Int>, code_point: Int) -> List<Int> =
  if code_point >= 0x61 && code_point <= 0x7A { out.push(code_point) } else {
    let word = ucd::lookup(table.words, code_point);
    let kind = status_of(word);
    if kind == ignored() { out }
    else if kind != mapped() { out.push(code_point) } else if word & sequence_mapping_bit() == 0 {
      out.push(ucd::apply_distance(code_point, word >> 12))
    } else { out.concat(ucd::sequence(table.points, word >> 12)) }
  }

fn points_of(text: String) -> List<Int> = text.chars().map(Int::of_char)

type LabelSplit = { labels: List<List<Int>>, label: List<Int> }

fn labels_of(points: List<Int>) -> List<List<Int>> = {
  let cut = points.fold({ labels: [], label: [] }, |so_far: LabelSplit, code_point: Int|
    if code_point == 0x2E { { labels: so_far.labels.push(so_far.label), label: [] } }
    else { { labels: so_far.labels, label: so_far.label.push(code_point) } });
  cut.labels.push(cut.label)
}

fn is_ace(label: List<Int>) -> Bool = label.take(4) == [0x78, 0x6E, 0x2D, 0x2D]

fn is_ascii(label: List<Int>) -> Bool = label.all(|code_point: Int| code_point < 128)

fn joins(words: Array<Int>, i: Int, non_joiner: Bool) -> Bool =
  match words.at(i - 1) {
    None -> false,
    Some(before) ->
      is_virama(before)
        || (non_joiner && joined_before(words, i - 1) && joined_after(words, i + 1)),
  }

fn joined_before(words: Array<Int>, i: Int) -> Bool =
  if i < 0 { false } else {
    match words.at(i) {
      None -> false,
      Some(word) -> if joining_of(word) == 4 { joined_before(words, i - 1) }
      else { joining_of(word) == 1 || joining_of(word) == 2 },
    }
  }

fn joined_after(words: Array<Int>, i: Int) -> Bool =
  match words.at(i) {
    None -> false,
    Some(word) -> if joining_of(word) == 4 { joined_after(words, i + 1) }
    else { joining_of(word) == 1 || joining_of(word) == 3 },
  }

fn joiners_allowed(label: List<Int>, words: Array<Int>) -> Bool =
  range(0, label.len()).fold(true, |ok: Bool, i: Int|
    ok
      && (match label.at(i) {
        Some(0x200C) -> joins(words, i, true),
        Some(0x200D) -> joins(words, i, false),
        _ -> true,
      }))

fn faults(table: IdnaTable, label: List<Int>, options: Options, read: Bool) -> List<ErrorKind> = {
  let words = label.map(|code_point: Int| ucd::lookup(table.words, code_point));
  let hyphen = |i: Int| label.at(i) == Some(0x2D);
  let allowed = |i: Int| {
    let code_point = label.at_or(i, 0);
    let kind = status_of(words.at_or(i, 0));
    (kind == valid() || kind == deviation()) && code_point != 0x2E
      && !(options.use_std3_ascii_rules && code_point < 128
        && !((code_point >= 0x61 && code_point <= 0x7A)
          || (code_point >= 0x30 && code_point <= 0x39)
          || code_point == 0x2D))
  };
  let found = |reason: ErrorKind, invalid_name_cases: Bool|
    if invalid_name_cases { [reason] } else { [] };
  found(NotNormalized, read && !unicode::is_normalized(text_of(label), unicode::Nfc)).concat(
    found(
      Hyphens,
      options.check_hyphens && (hyphen(0) || hyphen(label.len() - 1) || (hyphen(2) && hyphen(3))),
    ),
  ).concat(
    found(Punycode, !options.check_hyphens && is_ace(label)).concat(
      found(LeadingMark, match label.at(0) {
        Some(code_point) -> match Char::of_int(code_point) {
          Some(c) -> c.is_mark(),
          None -> false,
        },
        None -> false,
      }),
    ).concat(
      found(Disallowed, !range(0, label.len()).all(allowed)).concat(
        found(Joiner, options.check_joiners && !joiners_allowed(label, Array::of_list(words))),
      ),
    ),
  )
}

fn is_rtl(class: Int) -> Bool = class == right() || class == arabic_letter()

fn has_rtl(classes: List<Int>) -> Bool =
  classes.any(|class: Int| is_rtl(class) || class == arabic_number())

fn last_spacing(classes: List<Int>) -> Int =
  classes.fold(0, |last: Int, class: Int| if class == nonspacing() { last } else { class })

fn meets_bidi_rule(classes: List<Int>) -> Bool =
  match classes {
    [] -> true,
    [first, ..] -> if is_rtl(first) {
      classes.all(|c: Int| is_rtl(c) || c == arabic_number() || c == european_number() || c >= 6)
        && (is_rtl(last_spacing(classes)) || last_spacing(classes) == european_number()
        || last_spacing(classes) == arabic_number())
        && !(classes.any(|c: Int| c == european_number())
          && classes.any(|c: Int| c == arabic_number()))
    } else {
      first == left_to_right()
        && classes.all(|c: Int| c == left_to_right() || c == european_number() || c >= 6)
        && (last_spacing(classes) == left_to_right() || last_spacing(classes) == european_number())
    },
  }

type Label = { points: List<Int>, errors: List<ErrorKind> }

fn convert_label(table: IdnaTable, label: List<Int>, options: Options) -> Label / {abort.raise} =
  if !is_ace(label) { { points: label, errors: faults(table, label, options, false) } }
  else if !is_ascii(label) { { points: label, errors: [Punycode] } } else {
    let encoded = text_of(label.drop(4));
    match punycode::decode(encoded, encoded.len()) {
      None -> { points: label, errors: [Punycode] },
      Some(read) -> {
        let points = points_of(read);
        {
          points: points,
          errors: List::concat(
            if points.len() == 0 || is_ascii(points) { [Punycode] } else { [] },
            faults(table, points, options, true),
          ),
        }
      },
    }
  }

fn process_domain(domain: String, options: Options) -> List<Label> / {abort.raise} = {
  let table = idna_table();
  let mapped = domain.chars().fold([], |out: List<Int>, c: Char|
    mapped_into(table, out, Int::of_char(c)));
  let labels = labels_of(points_of(unicode::nfc(text_of(mapped)))).map(|label: List<Int>|
    convert_label(table, label, options));
  let classes = labels.map(|l: Label|
    l.points.map(|code_point: Int| bidi_of(ucd::lookup(table.words, code_point))));
  if !options.check_bidi || !classes.any(has_rtl) { labels } else {
    range(0, labels.len()).map(|i: Int| {
      let l = labels.at_or(i, { points: [], errors: [] });
      if meets_bidi_rule(classes.at_or(i, [])) { l }
      else { { points: l.points, errors: l.errors.push(Bidi) } }
    })
  }
}

fn problems_of(labels: List<Label>) -> List<Problem> =
  range(0, labels.len()).fold([], |found: List<Problem>, i: Int|
    labels.at_or(i, { points: [], errors: [] }).errors.fold(
      found,
      |all: List<Problem>, reason: ErrorKind| all.push({ label: i, reason: reason }),
    ))

fn dotted(labels: List<String>) -> String =
  labels.drop(1).fold(labels.at_or(0, ""), |name: String, label: String| name ++ "." ++ label)

/// Returns `domain` in display form: mapped, normalized, with every valid Punycode `xn--` label
/// decoded. A bad name does not make it fail. It returns the name together with every problem
/// found, and a label that cannot be decoded stays as written.
pub fn to_unicode(domain: String, options: Options) -> ConversionResult / {abort.raise} = {
  let labels = process_domain(domain, options);
  { name: dotted(labels.map(|l: Label| text_of(l.points))), problems: problems_of(labels) }
}

/// `domain` in its form on the wire: `to_unicode`'s name with every label that is not ASCII
/// written as Punycode after `xn--`. Raises `idna.fail` with every problem found, including the
/// lengths under `verify_dns_length`.
pub fn ascii(domain: String, options: Options) -> String / {idna.fail, abort.raise} = {
  let labels = process_domain(domain, options);
  let written = labels.map(|l: Label|
    if is_ascii(l.points) { text_of(l.points) }
    else { "xn--" ++ punycode::encode(text_of(l.points)) });
  let name = dotted(written);
  let lengths = if !options.verify_dns_length { [] } else {
    range(0, written.len()).fold([], |found: List<Problem>, i: Int| {
      let length = written.at_or(i, "").len();
      if length == 0 { found.push({ label: i, reason: EmptyLabel }) }
      else if length > 63 { found.push({ label: i, reason: LongLabel }) }
      else { found }
    }).concat(if name.len() - (if name.ends_with(".") { 1 } else { 0 }) > 253 {
      [{ label: -1, reason: LongName }]
    } else { [] })
  };
  let problems = problems_of(labels).concat(lengths);
  if problems.len() > 0 { idna.fail(problems) } else { name }
}

/// `ascii`, returning the problems instead of raising them.
pub fn to_ascii(domain: String, options: Options) -> Result<String, List<Problem>> / {abort.raise} =
  try { ascii(domain, options) }

fn labels() -> List<String> =
  [
    "example",
    "EXAMPLE",
    "b\u{FC}cher",
    "B\u{DC}CHER",
    "bu\u{308}cher",
    "xn--bcher-kva",
    "fa\u{DF}",
    "\u{3B2}\u{3CC}\u{3BB}\u{3BF}\u{3C2}",
    "\u{65E5}\u{672C}\u{8A9E}",
    "\u{FF41}\u{FF42}\u{FF43}",
    "a1",
    "com",
    "\u{5D0}\u{5D1}",
    "\u{627}\u{644}\u{639}",
    "xn--4dbc",
    "\u{1F600}",
    "a-b",
    "-a",
    "\u{301}x",
  ]

fn drawn_name(seed: Int) -> String = {
  let n = seed & 0x7FFFFFFF;
  let label = |i: Int| labels().at_or(i % 19, "");
  let stop = if n % 2 == 0 { "." } else { "\u{3002}" };
  let two = label(n / 6) ++ stop ++ label(n / 114);
  match n / 2 % 3 { 0 -> label(n / 6), 1 -> two, _ -> two ++ "." ++ label(n / 2166) }
}

test "a name on the wire converts to itself, and displays the same as the name it came from" {
  gen::check(gen::any_int(), |seed: Int| {
    let name = drawn_name(seed);
    match to_ascii(name, strict()) {
      Err(_) -> to_unicode(name, strict()).problems.len() > 0,
      Ok(wire) -> {
        let shown = to_unicode(name, strict());
        to_ascii(wire, strict()) == Ok(wire) && to_unicode(wire, strict()) == shown
          && shown.problems.len() == 0
          && to_ascii(shown.name, strict()) == Ok(wire)
          && to_unicode(shown.name, strict()) == shown
      },
    }
  })
}

test "text that `to_ascii` accepts with strict rules gives the same result with web rules, and `to_unicode` with web rules reports no problems" {
  gen::check(gen::any_int(), |seed: Int| {
    let text = sample_text(seed);
    match to_ascii(text, strict()) {
      Err(problems) -> problems.len() > 0,
      Ok(wire) -> to_ascii(text, web()) == Ok(wire) && to_unicode(text, web()).problems.len() == 0,
    }
  })
}

type Name = { written: String, ascii: String, unicode: String }

fn names() -> List<Name> =
  [
    { written: "example.com", ascii: "example.com", unicode: "example.com" },
    { written: "EXAMPLE.Com", ascii: "example.com", unicode: "example.com" },
    {
      written: "b\u{FC}cher.example",
      ascii: "xn--bcher-kva.example",
      unicode: "b\u{FC}cher.example",
    },
    {
      written: "B\u{DC}CHER.example",
      ascii: "xn--bcher-kva.example",
      unicode: "b\u{FC}cher.example",
    },
    {
      written: "xn--bcher-kva.example",
      ascii: "xn--bcher-kva.example",
      unicode: "b\u{FC}cher.example",
    },
    {
      written: "XN--BCHER-KVA.example",
      ascii: "xn--bcher-kva.example",
      unicode: "b\u{FC}cher.example",
    },
    { written: "fa\u{DF}.de", ascii: "xn--fa-hia.de", unicode: "fa\u{DF}.de" },
    {
      written: "\u{3B2}\u{3CC}\u{3BB}\u{3BF}\u{3C2}.gr",
      ascii: "xn--nxasmm1c.gr",
      unicode: "\u{3B2}\u{3CC}\u{3BB}\u{3BF}\u{3C2}.gr",
    },
    {
      written: "\u{65E5}\u{672C}\u{8A9E}\u{3002}jp",
      ascii: "xn--wgv71a119e.jp",
      unicode: "\u{65E5}\u{672C}\u{8A9E}.jp",
    },
    {
      written: "\u{FF45}\u{FF58}\u{FF41}\u{FF4D}\u{FF50}\u{FF4C}\u{FF45}\u{FF0E}com",
      ascii: "example.com",
      unicode: "example.com",
    },
    { written: "a\u{AD}b.c", ascii: "ab.c", unicode: "ab.c" },
    { written: "\u{5D0}\u{5D1}.il", ascii: "xn--4dbc.il", unicode: "\u{5D0}\u{5D1}.il" },
    { written: "\u{1F600}.example", ascii: "xn--e28h.example", unicode: "\u{1F600}.example" },
  ]

test "`to_ascii` converts the name {c.written} to {c.ascii}, and `to_unicode` converts both back to the same Unicode name" for c: Name in names(
  ) {
  assert_eq(to_ascii(c.written, strict()), Ok(c.ascii));
  assert_eq(to_unicode(c.written, strict()), { name: c.unicode, problems: [] });
  assert_eq(to_unicode(c.ascii, strict()), { name: c.unicode, problems: [] });
  assert_eq(to_ascii(c.written, web()), Ok(c.ascii))
}

type Wrong = { written: String, problems: List<Problem> }

fn invalid_name_cases() -> List<Wrong> =
  [
    { written: "-a.example", problems: [{ label: 0, reason: Hyphens }] },
    { written: "a-.example", problems: [{ label: 0, reason: Hyphens }] },
    { written: "ab--c.example", problems: [{ label: 0, reason: Hyphens }] },
    { written: "a_b.example", problems: [{ label: 0, reason: Disallowed }] },
    { written: "a b.example", problems: [{ label: 0, reason: Disallowed }] },
    { written: "a..b", problems: [{ label: 1, reason: EmptyLabel }] },
    { written: "example.com.", problems: [{ label: 2, reason: EmptyLabel }] },
    { written: "", problems: [{ label: 0, reason: EmptyLabel }] },
    { written: "xn--a.example", problems: [{ label: 0, reason: Disallowed }] },
    { written: "xn--abc-.example", problems: [{ label: 0, reason: Punycode }] },
    {
      written: "xn--.example",
      problems: [{ label: 0, reason: Punycode }, { label: 0, reason: EmptyLabel }],
    },
    { written: "xn--bcher-kva\u{FC}.example", problems: [{ label: 0, reason: Punycode }] },
    { written: "xn--bcher-kv.example", problems: [{ label: 0, reason: Punycode }] },
    { written: "a.\u{301}b", problems: [{ label: 1, reason: LeadingMark }] },
    { written: "a\u{200D}b.example", problems: [{ label: 0, reason: Joiner }] },
    { written: "\u{5D0}a.example", problems: [{ label: 0, reason: Bidi }] },
    { written: "a.1\u{5D0}", problems: [{ label: 1, reason: Bidi }] },
    { written: "\u{FFFD}.example", problems: [{ label: 0, reason: Disallowed }] },
  ]

test "`to_ascii` with strict rules rejects the name {c.written} and returns the problems found in it" for c: Wrong in invalid_name_cases(
  ) { assert_eq(to_ascii(c.written, strict()), Err(c.problems)) }

test "a label is at most 63 characters on the wire and a name at most 253" {
  let label = |n: Int| String::of_chars(range(0, n).map(|_: Int| 'a'));
  assert_eq(to_ascii(label(63) ++ ".example", strict()), Ok(label(63) ++ ".example"));
  assert_eq(to_ascii(label(64) ++ ".example", strict()), Err([{ label: 0, reason: LongLabel }]));
  let long = dotted([label(63), label(63), label(63), label(61)]);
  assert_eq(long.len(), 253);
  assert_eq(to_ascii(long, strict()), Ok(long));
  assert_eq(to_ascii(long ++ "a", strict()), Err([{ label: -1, reason: LongName }]));
  assert_eq(to_ascii(label(64) ++ ".example", web()), Ok(label(64) ++ ".example"))
}

test "`to_ascii` with web rules accepts underscores, leading hyphens and a trailing dot, but rejects zero-width joiners and invalid Punycode" {
  assert_eq(to_ascii("a_b.example", web()), Ok("a_b.example"));
  assert_eq(to_ascii("-a.example", web()), Ok("-a.example"));
  assert_eq(
    to_ascii("r3---sn-apo3qvuoxuxbt-j5pe.googlevideo.com", web()),
    Ok("r3---sn-apo3qvuoxuxbt-j5pe.googlevideo.com"),
  );
  assert_eq(to_ascii("example.com.", web()), Ok("example.com."));
  assert_eq(to_ascii("a\u{200D}b.example", web()), Err([{ label: 0, reason: Joiner }]));
  assert_eq(to_ascii("xn--bcher-kv.example", web()), Err([{ label: 0, reason: Punycode }]))
}

test "a wrong name is still shown, with what is wrong with it" {
  assert_eq(to_unicode("xn--bcher-kv.EXAMPLE", strict()), {
    name: "xn--bcher-kv.example",
    problems: [{ label: 0, reason: Punycode }],
  });
  assert_eq(to_unicode("-B\u{DC}CHER.example", strict()), {
    name: "-b\u{FC}cher.example",
    problems: [{ label: 0, reason: Hyphens }],
  });
  assert_eq(to_unicode("a..b", strict()), { name: "a..b", problems: [] })
}

test "a joiner is allowed after a virama, and a non-joiner between letters that join" {
  assert_eq(to_unicode("\u{915}\u{94D}\u{200D}\u{937}", strict()).problems, []);
  assert_eq(to_unicode("\u{915}\u{94D}\u{200C}\u{937}", strict()).problems, []);
  assert_eq(to_unicode("\u{628}\u{200C}\u{628}", strict()).problems, []);
  assert_eq(to_unicode("\u{628}\u{200D}\u{628}", strict()).problems, [
    { label: 0, reason: Joiner },
  ]);
  assert_eq(to_unicode("a\u{200C}b", strict()).problems, [{ label: 0, reason: Joiner }])
}
