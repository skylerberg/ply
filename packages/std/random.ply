//! Random values for a program, from three sources.
//!
//! The prelude's `random` effect is normally handled by `simulate`, which produces values
//! determined by a seed, so a simulation can be repeated exactly. A real run has no simulation and
//! needs the operating system's randomness, which the host supplies through the `entropy` effect.
//!
//! A `Rand` is the third source: a plain value that produces random numbers as a pure function of
//! its seed (its root), for code that wants repeatable randomness without a simulation, such as a
//! fuzz case or a shuffled order. It uses BLAKE3 in counter mode, the same construction the
//! simulation uses, so the same root gives the same results on every machine and version. A key
//! selects one independent sequence from a root, and no two keys, nor a key and the simulation,
//! produce the same output. `rand` uses the empty key, which gives the simulation's own sequence.
//! The counter is a field, so a sequence can start at any position.
//!
//! Every distribution comes in two forms that draw the same way. The plain name (`uniform`,
//! `shuffle`, `sample`, `choice`, `weighted_choice`, `normal`, `exponential`) draws from `entropy`.
//! The `rand_` form draws from a `Rand` and returns the `Rand` advanced past its draws. `with_rand`
//! runs code that uses `entropy` against a `Rand`, so there a plain name returns what its `rand_`
//! form returns.
//!
//! A token (`token_bytes`, `token_hex`, `token_urlsafe`) always comes from the operating system's
//! entropy, as a session identifier, reset link or API key must. Nothing drawn from a `Rand` is
//! secret, because anyone who knows its root can reproduce it.

import std.bytes (u32_le, u64_le)
import std.float
import std.internal.native (native)
import std.list
import std.math (ilog2)
import std.radix
import std.gen

/// The operating system's randomness.
pub nondet effect entropy {
  /// Sixty-three random bits, so a draw is never negative.
  read next() -> Int
  /// A uniform draw below `n`, which must be above zero. The host draws again rather than reducing
  /// a value modulo `n`, which would bias it.
  read below(n: Int) -> Int
  /// `n` bytes drawn directly into a `Secret`, so no plain value of the program ever contains them.
  /// Use it for key material. The host draws 0 to 65536 bytes and raises for any other count.
  read secret(n: Int) -> Secret<Bytes>
}

/// Sixty-three bits, so a draw is never negative.
pub fn next() -> Int / {entropy.next bounded} = entropy.next()

/// A uniform draw below `n`, which must be above zero. The host rejects a bound it cannot honour
/// rather than skewing the distribution.
pub fn below(n: Int) -> Int / {entropy.below bounded} = entropy.below(n)

/// A nonce: unpredictable and printable, as a SASL exchange and a cache key need.
pub fn nonce() -> String / {entropy.next bounded} = next().to_string() ++ "-" ++ next().to_string()

/// `n` bytes of the operating system's entropy, so `8 * n` bits a guesser must find. A session
/// identifier, a reset link or an API key should have at least 16 bytes. Empty for an `n` of zero
/// or less.
pub fn token_bytes(n: Int) -> Bytes / {entropy.next, abort.raise} =
  bytes_of_draws(range(0, (n + 6) / 7).map(|_i: Int| entropy.next()), n)

/// `n` bytes of the operating system's entropy as a `Secret`, never a plain value. Use it for key
/// material, and `token_bytes` for a token.
pub fn secret(n: Int) -> Secret<Bytes> / {entropy.secret bounded} = entropy.secret(n)

/// A token of `n` bytes in lower-case hex: `2 * n` characters.
pub fn token_hex(n: Int) -> String / {entropy.next, abort.raise} = token_bytes(n).hex_of()

/// A token of `n` bytes in the URL-safe base64 alphabet, unpadded, as `std.base64`'s
/// `base64url_encode` writes it: `(4 * n + 2) / 3` characters, none of which a URL, a cookie or a
/// header has to escape.
pub fn token_urlsafe(n: Int) -> String / {entropy.next, abort.raise} =
  radix::encode(radix::base64url(), token_bytes(n))

/// Uniform in `[0, 1)`: one of the `2^53` multiples of `2^-53` there, each as likely as another.
pub fn uniform() -> Float / {entropy.next bounded} = uniform_of(entropy.next())

/// Uniform in `(0, 1)`: one of the `2^52` midpoints between the multiples of `2^-52`, so neither
/// end is drawn and its logarithm is finite.
pub fn uniform_open() -> Float / {entropy.next bounded} = uniform_open_of(entropy.next())

/// A draw from the standard normal distribution, of mean zero and standard deviation one, so
/// `mean + deviation * normal()` is a draw from any other normal distribution. It uses two draws of
/// `entropy.next`.
pub fn normal() -> Float / {entropy.next bounded} = {
  let u = uniform_open();
  normal_of(u, uniform())
}

/// A draw from the exponential distribution of rate one: the wait for an event that comes once a
/// unit of time on average, so `exponential() / rate` is a draw at any other rate. Always above
/// zero.
pub fn exponential() -> Float / {entropy.next bounded} = exponential_of(uniform_open())

/// One element, each as likely as another; `None` for an empty list.
pub fn choice<a>(xs: List<a>) -> Option<a> / {entropy.below bounded} =
  if xs.len() == 0 { None } else { xs.at(entropy.below(xs.len())) }

/// `xs` in a random order, with every order equally likely. It is a Fisher–Yates shuffle, with one
/// draw for each element but the last.
pub fn shuffle<a>(xs: List<a>) -> List<a> / {entropy.below, abort.raise} =
  partial_shuffle(xs, picks(xs.len(), draws_for(xs.len(), xs.len())))

/// Returns `k` elements of `xs` chosen without repeating a position, in the order chosen, with
/// every such sample equally likely. Returns an empty list when `k` is zero or less, and all
/// elements shuffled when `k` is at least the length of `xs`. It draws once per returned element,
/// except that returning all of `xs` needs one draw fewer, because the last element is then forced.
pub fn sample<a>(xs: List<a>, k: Int) -> List<a> / {entropy.below, abort.raise} =
  partial_shuffle(xs, picks(xs.len(), draws_for(xs.len(), k))).take(k)

/// One item of the table, chosen in proportion to its weight. Raises for a table `weighted` did not
/// make.
pub fn weighted_choice<a>(w: Weighted<a>) -> a / {entropy.below bounded, abort.raise} = {
  let total = total_of(w);
  if total < 1 { invalid_weighted_table() } else { item_at_point(w, entropy.below(total)) }
}

/// Runs `body`, answering each `entropy.next` and `entropy.below` it performs with a draw from `r`.
/// Returns `body`'s result and the stream after those draws. A call such as `shuffle(xs)` inside
/// `body` returns what `rand_shuffle(r, xs)` returns. Panics if `body` performs `entropy.below`
/// with a bound below one. Does not handle `entropy.secret`, because anyone who knows `r` can
/// predict a `Rand`'s draws.
pub fn with_rand<a | e>(
  r: Rand,
  body: () -> a / {entropy.next, entropy.below | e},
) -> { value: a, rand: Rand } / {abort.raise | e} =
  handle {
    body()
  } with {
    var stream = r,
    entropy.next() -> {
      let step = rand_int(stream);
      stream = step.rand;
      step.value
    },
    entropy.below(n) -> match rand_below(stream, n) {
      Some(step) -> {
        stream = step.rand;
        step.value
      },
      None -> panic("`entropy.below` needs a bound above zero"),
    },
    return value -> { value: value, rand: stream },
  }

fn bytes_of_draws(draws: List<Int>, n: Int) -> Bytes / {abort.raise} = {
  let all = Bytes::concat_all(draws.map(|d: Int| u64_le(d).slice(0, 7)));
  all.slice(0, min(max(n, 0), all.len()))
}

fn uniform_of(draw: Int) -> Float =
  Float::of_int(draw >>> 10 & 0x1F_FFFF_FFFF_FFFF) * Float::pow2(0 - 53)

fn uniform_open_of(draw: Int) -> Float =
  (Float::of_int(draw >>> 11 & 0xF_FFFF_FFFF_FFFF) + 0.5) * Float::pow2(0 - 52)

fn normal_of(u: Float, v: Float) -> Float =
  Float::sqrt(0.0 - 2.0 * u.ln()) * Float::cos(Float::tau() * v)

fn exponential_of(u: Float) -> Float = 0.0 - u.ln()

fn draws_for(n: Int, k: Int) -> Int = min(max(k, 0), n - 1)

fn picks(n: Int, draws: Int) -> List<Int> / {entropy.below} =
  range(0, draws).map(|i: Int| entropy.below(n - i))

fn partial_shuffle<a>(xs: List<a>, picks: List<Int>) -> List<a> / {abort.raise}
  cost picks.len()
=
  range(0, picks.len()).fold(xs, |accumulator: List<a>, i: Int|
    match picks.at(i) {
      Some(p) -> if p < 0 || p >= accumulator.len() - i { accumulator }
      else { swapped(accumulator, i, i + p) },
      None -> accumulator,
    })

fn swapped<a>(xs: List<a>, i: Int, j: Int) -> List<a> / {abort.raise} =
  match ((xs.at(i), xs.at(j))) { (Some(x), Some(y)) -> xs.set(i, y).set(j, x), _ -> xs }

/// Items with the running totals of their weights, which a weighted draw searches. Only a table
/// `weighted` makes is a valid distribution: the totals ascend, one for each item.
pub type Weighted<a> = new { items: List<a>, totals: List<Int> }

/// A table that draws each item in proportion to its weight. An item of weight zero is never drawn.
/// `None` unless every weight is at least zero, at least one is above zero, and their sum fits in
/// an `Int`.
pub fn weighted<a>(pairs: List<{ item: a, weight: Int }>) -> Option<Weighted<a>>
  cost pairs.len()
= {
  let start: Option<Weighted<a>> = Some({ items: [], totals: [] });
  let table = pairs.fold(start, |accumulator: Option<Weighted<a>>, p: { item: a, weight: Int }|
    match accumulator {
      None -> None,
      Some(w) -> if p.weight < 0 { None }
      else if p.weight == 0 { Some(w) } else {
        match checked_add(total_of(w), p.weight) {
          None -> None,
          Some(sum) -> Some({ ..w, items: w.items.push(p.item), totals: w.totals.push(sum) }),
        }
      },
    });
  match table { Some(w) -> if w.items.len() == 0 { None } else { table }, None -> None }
}

fn total_of<a>(w: Weighted<a>) -> Int = match w.totals.last() { Some(t) -> t, None -> 0 }

fn item_at_point<a>(w: Weighted<a>, point: Int) -> a / {abort.raise} =
  match w.items.at(first_above(w.totals, point)) { Some(x) -> x, None -> invalid_weighted_table() }

fn invalid_weighted_table<a>() -> a / {abort.raise} =
  panic("std.random: a weighted draw failed because the table `weighted` is invalid")

fn first_above(totals: List<Int>, point: Int) -> Int =
  totals.partition_point(|total: Int| total <= point)

host for entropy by from_operating_system

fn from_operating_system<a | e>(
  go: () -> a / {entropy.read | e},
) -> a / {native.read, abort.raise | e} =
  handle {
    go()
  } with {
    entropy.next() -> entropy_next(),
    entropy.below(n) -> if n < 1 {
      panic("`entropy.below` needs a bound above zero, but got " ++ n.to_string())
    } else { host_draw_below(n) },
    entropy.secret(n) -> if n < 0 || n > max_secret_bytes() {
      panic(
        "`entropy.secret` draws 0 to " ++ max_secret_bytes().to_string()
          ++ " bytes, and was asked for "
          ++ n.to_string(),
      )
    } else { entropy_secret(n) },
  }

fn max_secret_bytes() -> Int = 65536

fn host_draw_below(n: Int) -> Int / {native.read, abort.raise} = {
  let limit = max_draw() / n * n;
  iterate(0, 64, |tries: Int| {
    let x = entropy_next();
    if x < limit { Stop(x % n) } else { Continue(tries + 1) }
  })
}

extern fn entropy_next() -> Int / {native.read}

extern fn entropy_secret(n: Int) -> Secret<Bytes> / {native.read}

effect draw_counter {
  write one() -> Unit
  read total() -> Int
}

test "a draw comes from the effect's handler, not the program" {
  handle {
    {
      assert_eq(next(), 41);
      assert_eq(below(10), 7)
    }
  } with {
    entropy.next() -> 41,
    entropy.below(n) -> if n == 10 { 7 } else { 0 },
  }
}

test "a nonce is two draws, so a server cannot predict it from one" {
  let out = handle { nonce() } with { entropy.next() -> 5 };
  assert_eq(out, "5-5")
}

/// A seeded stream: its root, the key that selects it among the root's streams, and how many
/// blocks it has drawn.
pub type Rand = { root: Int, key: Bytes, counter: Int }

/// The stream of `root` with the empty key, which is the simulation's own stream.
pub fn rand(root: Int) -> Rand = rand_keyed(root, b"")

/// Returns the stream that `key` names among the streams derived from `root`. Different keys give
/// independent streams.
pub fn rand_keyed(root: Int, key: Bytes) -> Rand = { root: root, key: key, counter: 0 }

/// One draw: a non-negative integer, sixty-three bits wide, and the stream that follows it.
pub fn rand_int(r: Rand) -> { value: Int, rand: Rand } / {abort.raise} = {
  let b = block(r);
  let eight = Bytes::concat_all([b.slice(0, 7), byte_of_int(b.at(7) & 0x7F)]);
  {
    value: match eight.u64_at(0) { Some(v) -> v, None -> 0 },
    rand: { ..r, counter: r.counter + 1 },
  }
}

/// Returns one draw of all sixty-four bits and the stream after it. It reads the same eight bytes
/// as `rand_int`, but keeps the top bit that `rand_int` clears.
pub fn rand_u64(r: Rand) -> { value: U64, rand: Rand } / {abort.raise} = {
  let b = block(r);
  let low = U64::of_int(Int::of_u32(b.u32_le(0)));
  let high = U64::of_int(Int::of_u32(b.u32_le(4)));
  { value: high * 4294967296u64 + low, rand: { ..r, counter: r.counter + 1 } }
}

/// `n` bytes of the stream, advanced by the blocks they need.
pub fn rand_bytes(r: Rand, n: Int) -> { bytes: Bytes, rand: Rand } / {abort.raise} =
  if n <= 0 { { bytes: b"", rand: r } } else {
    let blocks = (n + 31) / 32;
    let raw = range(0, blocks).fold(b"", |accumulator: Bytes, i: Int|
      accumulator.concat(block({ ..r, counter: r.counter + i })));
    { bytes: raw.slice(0, n), rand: { ..r, counter: r.counter + blocks } }
  }

/// A uniform draw over `0..n`, by rejection. A draw in the last, partial multiple of `n` is thrown
/// away rather than reduced, so no remainder is likelier than another. `None` for a bound of zero
/// or less, which has no uniform draw.
pub fn rand_below(r: Rand, n: Int) -> Option<{ value: Int, rand: Rand }> / {abort.raise} =
  if n <= 0 { None } else { Some(below_draw(r, n, max_draw() / n * n)) }

fn below_draw(r: Rand, n: Int, limit: Int) -> { value: Int, rand: Rand } / {abort.raise} =
  iterate(r, 64, |at: Rand| {
    let step = rand_int(at);
    if step.value < limit { Stop({ value: step.value % n, rand: step.rand }) }
    else { Continue(step.rand) }
  })

/// Uniform in `[0, 1)`, as `uniform` is, and the stream after its one draw.
pub fn rand_uniform(r: Rand) -> { value: Float, rand: Rand } / {abort.raise} = {
  let step = rand_int(r);
  { value: uniform_of(step.value), rand: step.rand }
}

/// Uniform in `(0, 1)`, as `uniform_open` is, and the stream after its one draw.
pub fn rand_uniform_open(r: Rand) -> { value: Float, rand: Rand } / {abort.raise} = {
  let step = rand_int(r);
  { value: uniform_open_of(step.value), rand: step.rand }
}

/// A standard normal draw, as `normal` is, and the stream after its two draws.
pub fn rand_normal(r: Rand) -> { value: Float, rand: Rand } / {abort.raise} = {
  let u = rand_uniform_open(r);
  let v = rand_uniform(u.rand);
  { value: normal_of(u.value, v.value), rand: v.rand }
}

/// An exponential draw of rate one, as `exponential` is, and the stream after its one draw.
pub fn rand_exponential(r: Rand) -> { value: Float, rand: Rand } / {abort.raise} = {
  let u = rand_uniform_open(r);
  { value: exponential_of(u.value), rand: u.rand }
}

/// One element, each as likely as another, and the stream after its draw; `None` for an empty
/// list.
pub fn rand_choice<a>(r: Rand, xs: List<a>) -> Option<{ value: a, rand: Rand }> / {abort.raise} =
  match rand_below(r, xs.len()) {
    None -> None,
    Some(step) -> match xs.at(step.value) {
      Some(x) -> Some({ value: x, rand: step.rand }),
      None -> None,
    },
  }

/// `xs` shuffled, as `shuffle` does it, and the stream after its draws.
pub fn rand_shuffle<a>(r: Rand, xs: List<a>) -> { value: List<a>, rand: Rand } / {abort.raise} = {
  let drawn = rand_picks(r, xs.len(), draws_for(xs.len(), xs.len()));
  { value: partial_shuffle(xs, drawn.value), rand: drawn.rand }
}

/// `k` of the elements without replacement, as `sample` draws them, and the stream after its
/// draws.
pub fn rand_sample<a>(
  r: Rand,
  xs: List<a>,
  k: Int,
) -> { value: List<a>, rand: Rand } / {abort.raise} = {
  let drawn = rand_picks(r, xs.len(), draws_for(xs.len(), k));
  { value: partial_shuffle(xs, drawn.value).take(k), rand: drawn.rand }
}

/// One item of the table, each in proportion to its weight, and the stream after its draw. Raises
/// for a table `weighted` did not make.
pub fn rand_weighted_choice<a>(
  r: Rand,
  w: Weighted<a>,
) -> { value: a, rand: Rand } / {abort.raise} =
  match rand_below(r, total_of(w)) {
    Some(step) -> { value: item_at_point(w, step.value), rand: step.rand },
    None -> invalid_weighted_table(),
  }

fn rand_picks(r: Rand, n: Int, draws: Int) -> { value: List<Int>, rand: Rand } / {abort.raise} =
  range(0, draws).fold({ value: [], rand: r }, |s: { value: List<Int>, rand: Rand }, i: Int|
    match rand_below(s.rand, n - i) {
      Some(step) -> { value: s.value.push(step.value), rand: step.rand },
      None -> s,
    })

fn block(r: Rand) -> Bytes =
  Bytes::concat_all([
    Bytes::of_string("ply.sim.stream.1"),
    u64_le(r.root),
    if r.key.len() == 0 { byte_of_int(1) }
    else { Bytes::concat_all([byte_of_int(2), u32_le(r.key.len()), r.key]) },
    u64_le(r.counter),
  ]).blake3(
  )

fn max_draw() -> Int = 0x7FFF_FFFF_FFFF_FFFF

test "a pure random stream returns the same values for the same seed and different values for different seeds" {
  let first = rand_int(rand(7));
  let again = rand_int(rand(7));
  assert_eq(first.value, again.value);
  assert_eq(first.rand, again.rand);
  assert_eq(rand_bytes(rand(1), 40).bytes, rand_bytes(rand(1), 40).bytes);
  assert(rand_int(rand(7)).value != rand_int(rand(8)).value)
}

test "a draw is in range, and `below` rejects a bound it cannot honour" {
  let draws = range(0, 200).fold(
    { ok: true, rand: rand(11) },
    |accumulator: { ok: Bool, rand: Rand }, _: Int|
      match rand_below(accumulator.rand, 6) {
        None -> accumulator,
        Some(step) -> { ok: accumulator.ok && step.value >= 0 && step.value < 6, rand: step.rand },
      },
  );
  assert(draws.ok);
  assert_eq(rand_below(rand(1), 0), None)
}

test "the first block of `rand(0)` is the BLAKE3 hash of the string `ply.sim.stream.1`, seed 0, `rand_tag` and counter 0, in that order" {
  assert_eq(
    block(rand(0)).hex_of(),
    "242257320a1f4f4c9f0b62a52348f099e6f3738dcc4c2a85040607361f7cb92b",
  )
}

test "a keyed block is BLAKE3 over the domain, the root, tag 2, the key and the counter" {
  assert_eq(
    block(rand_keyed(0, b"key")).hex_of(),
    "56841b1e69751f400d9eae9e6759921b6b4edff34e08dd5452b693fc6e2862d5",
  )
}

test "each key selects its own stream, and the empty key selects the same stream as `rand`" {
  assert_eq(rand_int(rand_keyed(3, b"")).value, rand_int(rand(3)).value);
  assert(rand_int(rand_keyed(3, b"a")).value != rand_int(rand(3)).value);
  assert(rand_int(rand_keyed(3, b"a")).value != rand_int(rand_keyed(3, b"b")).value);
  assert_eq(rand_int(rand_keyed(3, b"a")).value, rand_int(rand_keyed(3, b"a")).value)
}

test "`rand_u64` returns a 64-bit unsigned integer whose low 63 bits equal the result of `rand_int`, and both advance the generator the same way" {
  let r = rand_keyed(9, b"k");
  let wide = rand_u64(r).value;
  assert_eq(Int::of_u64(wide & 0x7FFF_FFFF_FFFF_FFFFu64), rand_int(r).value);
  assert_eq(rand_u64(r).rand, rand_int(r).rand)
}

test "a stream started at counter 2 returns the same value as the third draw of the stream started at counter 0" {
  let third = rand_int(rand_int(rand_int(rand_keyed(5, b"k")).rand).rand);
  assert_eq(rand_int({ ..rand_keyed(5, b"k"), counter: 2 }).value, third.value)
}

fn counting() -> Int = 0x0706_0504_0302_0100

test "a token is the low seven bytes of each draw, cut to the length requested" {
  let drawn = |n: Int| handle { token_bytes(n) } with { entropy.next() -> counting() };
  assert_eq(drawn(3), b"\x00\x01\x02");
  assert_eq(drawn(7), b"\x00\x01\x02\x03\x04\x05\x06");
  assert_eq(drawn(9), b"\x00\x01\x02\x03\x04\x05\x06\x00\x01");
  assert_eq(drawn(0), b"");
  assert_eq(drawn(0 - 4), b"")
}

test "`token_hex` returns two characters per byte, and `token_urlsafe` uses `-` and `_` as its two non-alphanumeric characters" {
  assert_eq(handle { token_hex(4) } with { entropy.next() -> counting() }, "00010203");
  assert_eq(handle { token_urlsafe(3) } with { entropy.next() -> 0xFE_FFFF }, "___-");
  assert_eq(handle { token_urlsafe(4) } with { entropy.next() -> 0xFE_FFFF }, "___-AA")
}

fn count_draws<a>(
  body: () -> a / {entropy.next, entropy.below, abort.raise},
) -> Int / {abort.raise} =
  handle {
    handle {
      let _result = body();
      draw_counter.total()
    } with {
      entropy.next() -> {
        draw_counter.one();
        0
      },
      entropy.below(_) -> {
        draw_counter.one();
        0
      },
    }
  } with {
    var n = 0,
    draw_counter.one() -> {
      n = n + 1;
    },
    draw_counter.total() -> n,
  }

test "a token draws once for every seven bytes it contains" {
  assert_eq(count_draws(|| token_bytes(0)), 0);
  assert_eq(count_draws(|| token_bytes(1)), 1);
  assert_eq(count_draws(|| token_bytes(7)), 1);
  assert_eq(count_draws(|| token_bytes(8)), 2);
  assert_eq(count_draws(|| token_urlsafe(32)), 5)
}

test "a uniform float is built from a draw's top bits and is at least zero and always less than one" {
  assert_eq(uniform_of(0), 0.0);
  assert_eq(uniform_of(max_draw()), 0.9999999999999999);
  assert_eq(uniform_of(1 << 62), 0.5);
  assert_eq(uniform_open_of(0), Float::pow2(0 - 53));
  assert_eq(uniform_open_of(max_draw()), 0.9999999999999999);
  assert_eq(handle { uniform() } with { entropy.next() -> 1 << 62 }, 0.5);
  assert_eq(handle { uniform_open() } with { entropy.next() -> 0 }, Float::pow2(0 - 53))
}

fn tally(kinds: Int, draws: List<Int>) -> List<Int> =
  draws.fold(range(0, kinds).map(|_k: Int| 0), |counts: List<Int>, d: Int|
    match counts.at(d) { Some(c) -> counts.set(d, c + 1), None -> counts })

fn squared_error(counts: List<Int>, expected: Int) -> Int =
  counts.fold(0, |sum: Int, c: Int| sum + (c - expected) * (c - expected))

test "six thousand draws below six pass chi-square at five degrees of freedom (20.52)" {
  let draws = with_rand(rand(11), || range(0, 6000).map(|_i: Int| below(6))).value;
  let counts = tally(6, draws);
  assert_eq(counts.fold(0, |n: Int, c: Int| n + c), 6000);
  assert(squared_error(counts, 1000) < 20520)
}

fn order_of(p: List<Int>) -> Int =
  match p {
    [0, 1, 2] -> 0,
    [0, 2, 1] -> 1,
    [1, 0, 2] -> 2,
    [1, 2, 0] -> 3,
    [2, 0, 1] -> 4,
    [2, 1, 0] -> 5,
    _ -> 6,
  }

test "six thousand shuffles of three pass chi-square over the six orders (20.52)" {
  let orders = with_rand(rand(12), || range(0, 6000).map(|_i: Int| order_of(shuffle([0, 1, 2]))));
  let counts = tally(6, orders.value);
  assert_eq(counts.fold(0, |n: Int, c: Int| n + c), 6000);
  assert(squared_error(counts, 1000) < 20520)
}

test "ten thousand uniform floats pass chi-square over ten equal bins (27.88)" {
  let bins = with_rand(rand(13), ||
    range(0, 10000).map(|_i: Int|
      match Int::of_float(uniform() * 10.0, Down) { Some(bin) -> bin, None -> 10 }));
  let counts = tally(10, bins.value);
  assert_eq(counts.fold(0, |n: Int, c: Int| n + c), 10000);
  assert(squared_error(counts, 1000) < 27880)
}

test "six thousand draws weighted one, two and three pass chi-square at two degrees (13.82)" {
  let table = weighted([{ item: 0, weight: 1 }, { item: 1, weight: 2 }, { item: 2, weight: 3 }]);
  let draws = match table {
    Some(w) -> with_rand(rand(14), || range(0, 6000).map(|_i: Int| weighted_choice(w))).value,
    None -> [],
  };
  let off = |counts: List<Int>, i: Int, expected: Int|
    match counts.at(i) { Some(c) -> (c - expected) * (c - expected), None -> 0 };
  let counts = tally(3, draws);
  assert_eq(counts.fold(0, |n: Int, c: Int| n + c), 6000);
  assert(6 * off(counts, 0, 1000) + 3 * off(counts, 1, 2000) + 2 * off(counts, 2, 3000) < 82900)
}

test "four thousand normal draws have a mean near zero and a standard deviation near one" {
  let mean = |xs: List<Float>| xs.fold(0.0, |sum: Float, x: Float| sum + x) / 4000.0;
  let zs = with_rand(rand(15), || range(0, 4000).map(|_i: Int| normal())).value;
  let m = mean(zs);
  let variance = mean(zs.map(|z: Float| (z - m) * (z - m)));
  let within_one = zs.filter(|z: Float| z > 0.0 - 1.0 && z < 1.0).len();
  assert(m > 0.0 - 0.08 && m < 0.08);
  assert(variance > 0.89 && variance < 1.11);
  assert(within_one > 2731 - 150 && within_one < 2731 + 150)
}

test "four thousand exponential draws are above zero with a mean near one" {
  let waits = with_rand(rand(16), || range(0, 4000).map(|_i: Int| exponential())).value;
  let m = waits.fold(0.0, |sum: Float, w: Float| sum + w) / 4000.0;
  assert_eq(waits.filter(|w: Float| w > 0.0).len(), 4000);
  assert(m > 0.92 && m < 1.08)
}

test "`shuffle`, `sample` and `choice` return normally for empty and single-element lists" {
  let none: List<Int> = [];
  assert_eq(count_draws(|| assert_eq(shuffle(none), [])), 0);
  assert_eq(count_draws(|| assert_eq(shuffle([7]), [7])), 0);
  assert_eq(count_draws(|| assert_eq(choice(none), None)), 0);
  assert_eq(count_draws(|| assert_eq(choice([7]), Some(7))), 1);
  assert_eq(count_draws(|| assert_eq(sample(none, 3), [])), 0);
  assert_eq(rand_choice(rand(1), none), None);
  assert_eq(rand_shuffle(rand(1), none), { value: [], rand: rand(1) });
  assert_eq(rand_sample(rand(1), [7], 1), { value: [7], rand: rand(1) })
}

test "a sample draws once for each element it returns, and a shuffle once for all but the last" {
  let five = [1, 2, 3, 4, 5];
  assert_eq(count_draws(|| assert_eq(sample(five, 2), [1, 2])), 2);
  assert_eq(count_draws(|| assert_eq(sample(five, 0), [])), 0);
  assert_eq(count_draws(|| assert_eq(sample(five, 0 - 3), [])), 0);
  assert_eq(count_draws(|| assert_eq(sample(five, 5), five)), 4);
  assert_eq(count_draws(|| assert_eq(sample(five, 9), five)), 4);
  assert_eq(count_draws(|| assert_eq(shuffle(five), five)), 4)
}

test "`partial_shuffle` swaps position i with the position given by the i-th index, and skips indexes that are out of range" {
  assert_eq(partial_shuffle([1, 2, 3, 4], [3, 0, 1]), [4, 2, 1, 3]);
  assert_eq(partial_shuffle([1, 2, 3, 4], [0, 0, 0]), [1, 2, 3, 4]);
  assert_eq(partial_shuffle([1, 2, 3, 4], [9, 0 - 5, max_draw()]), [1, 2, 3, 4])
}

test "a shuffle is a permutation" {
  gen::check2(gen::any_int(), gen::list(gen::any_int()), |root: Int, xs: List<Int>| {
    rand_shuffle(rand(root), xs).value.sort() == xs.sort()
  })
}

test "a sample has the length requested and no position twice" {
  gen::check3(
    gen::any_int(),
    gen::list(gen::bool()),
    gen::list(gen::bool()),
    |root: Int, xs: List<Bool>, sized: List<Bool>| {
      let n = xs.len();
      let k = sized.len();
      let drawn = rand_sample(rand(root), range(0, n), k).value;
      drawn.len() == min(k, n) && drawn.unique() == drawn
        && drawn.fold(true, |ok: Bool, at: Int| ok && at >= 0 && at < n)
    },
  )
}

test "`rand_below` returns 0 for a bound of 1, a value from 0 up to below `max_draw()` for that largest bound, and `None` for a negative bound" {
  assert_eq(rand_below(rand(3), 1), Some({ value: 0, rand: { ..rand(3), counter: 1 } }));
  let wide = rand_below(rand(3), max_draw());
  assert(match wide { Some(step) -> step.value >= 0 && step.value < max_draw(), None -> false });
  assert_eq(rand_below(rand(3), 0 - 1), None)
}

test "`rand_below` returns a value in range for a positive bound, and `None` for a bound of zero or less" {
  gen::check2(gen::any_int(), gen::any_int(), |root: Int, n: Int| {
    match rand_below(rand(root), n) {
      Some(step) -> n > 0 && step.value >= 0 && step.value < n,
      None -> n <= 0,
    }
  })
}

test "`weighted` accepts a non-empty list of non-negative weights with a positive sum that fits in an Int, and rejects any other" {
  let none: List<{ item: String, weight: Int }> = [];
  assert_eq(weighted(none), None);
  assert_eq(weighted([{ item: "a", weight: 0 }]), None);
  assert_eq(weighted([{ item: "a", weight: 1 }, { item: "b", weight: 0 - 1 }]), None);
  assert_eq(weighted([{ item: "a", weight: max_draw() }, { item: "b", weight: 1 }]), None);
  assert_eq(
    weighted([{ item: "a", weight: 2 }, { item: "b", weight: 0 }, { item: "c", weight: 3 }]),
    Some({ items: ["a", "c"], totals: [2, 5] }),
  )
}

test "`item_at_point` maps each integer below the total weight to the item whose weight range contains it" {
  let table: Weighted<String> = { items: ["a", "c"], totals: [2, 5] };
  assert_eq(range(0, 5).map(|point: Int| item_at_point(table, point)), ["a", "a", "c", "c", "c"]);
  assert_eq(handle { weighted_choice(table) } with { entropy.below(n) -> n - 1 }, "c");
  assert_eq(first_above([2, 5], 5), 2);
  assert_eq(first_above([], 0), 0)
}

fn small_weights(ws: List<Int>) -> List<{ item: Int, weight: Int }> =
  range(0, ws.len()).map(|i: Int|
    { item: i, weight: match ws.at(i) { Some(w) -> w & 3, None -> 0 } })

test "an item takes as many points of the total as its weight" {
  gen::check(gen::list(gen::any_int()), |ws: List<Int>| {
    let pairs = small_weights(ws);
    let spread = pairs.fold([], |out: List<Int>, p: { item: Int, weight: Int }|
      range(0, p.weight).fold(out, |accumulator: List<Int>, _k: Int| accumulator.push(p.item)));
    match weighted(pairs) {
      Some(w) -> range(0, total_of(w)).map(|point: Int| item_at_point(w, point)) == spread,
      None -> spread == [],
    }
  })
}

test "`with_rand` runs a program with entropy drawn from a seeded stream, and returns the result with the advanced stream" {
  let first = rand_int(rand_keyed(7, b"k"));
  let second = rand_int(first.rand);
  let under = with_rand(rand_keyed(7, b"k"), || nonce());
  assert_eq(under.value, first.value.to_string() ++ "-" ++ second.value.to_string());
  assert_eq(under.rand, second.rand);
  assert_eq(with_rand(rand(7), || 1).rand, rand(7))
}

test "under a seeded handler a shuffle and a sample match their `rand_` versions" {
  gen::check3(
    gen::any_int(),
    gen::list(gen::any_int()),
    gen::list(gen::bool()),
    |root: Int, xs: List<Int>, sized: List<Bool>| {
      let r = rand(root);
      let k = sized.len();
      with_rand(r, || shuffle(xs)) == rand_shuffle(r, xs)
        && with_rand(r, || sample(xs, k)) == rand_sample(r, xs, k)
    },
  )
}

fn main() -> Int = 0
