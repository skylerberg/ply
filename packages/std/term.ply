//! Detects and uses the terminal that a program's standard streams are connected to: whether there
//! is one, how to style text for it, how to read what is typed, and how to draw progress.
//!
//! `term.is_terminal` reports whether a stream is a terminal, and `term.size` returns the
//! terminal's size. `std.signal`'s `resized` reports when the size changes. `term.mode` changes how
//! the terminal delivers typed input, `term.input` reads that input, and `term.secret_line` reads a
//! line without exposing it to the rest of the program. When the run ends, the terminal is restored
//! to the mode it had before. A test replaces these operations with `on_screen` over a `Screen`, a
//! scripted terminal that supplies the typed input and records the modes it was set to. A program
//! writes to a terminal through standard output or standard error, so a test of a prompt or of
//! progress also runs under `std.process`'s `Captured`, which records what was written.
//!
//! The rest of this module is pure. A `Style` says how many colours a stream supports, and every
//! function that paints takes one. `decide` chooses a `Style` from the caller's `Choice`, whether
//! the stream is a terminal, and five environment variables. `style_for` does the same, reading the
//! variables through `std.config`. The first rule that applies wins:
//!
//! 1. `Never` means no styling, and `Always` means styling. Both override every environment
//! variable, so a command-line flag outranks `NO_COLOR` (no-color.org). 2. `FORCE_COLOR` set and
//! not empty means styling, even when the stream is not a terminal (force-color.org). Its value is
//! ignored. 3. `NO_COLOR` set and not empty means no styling (no-color.org). Its value is ignored.
//! 4. `CLICOLOR_FORCE` set and not empty means styling, even when the stream is not a terminal
//! (bixense.com/clicolors). 5. A stream that is not a terminal is not styled. A terminal whose
//! `TERM` is `dumb` is not styled either. `dumb` is the terminfo name for a terminal that
//! understands no escape sequences. 6. Any other terminal is styled with the colours it reports:
//! all colours when `COLORTERM` is `truecolor` or `24bit` or `TERM` ends in `-direct`, 256 colours
//! when `TERM` contains `256color`, and sixteen otherwise.
//!
//! The three conventions disagree on whether `NO_COLOR` outranks a variable that forces colour, so
//! each variable has the rank its own convention gives it. bixense says `CLICOLOR_FORCE` counts
//! only when `NO_COLOR` is unset. force-color.org's reference code checks `NO_COLOR` first and then
//! `FORCE_COLOR`, so `FORCE_COLOR` wins. That ranking is also the more useful one: a person exports
//! `NO_COLOR` once for every program, while `FORCE_COLOR` is set for one pipeline that no flag can
//! reach. The reference code also lets `FORCE_COLOR` outrank the command line, but here a flag
//! comes first because it is the most specific request. bixense's `CLICOLOR` asks for colour on a
//! terminal, which a terminal gets anyway, so it is not read.
//!
//! A colour that the style does not support is painted as the nearest supported colour: an `Rgb`
//! becomes one of the 256, and either becomes one of the sixteen.
//!
//! `strip` removes the styling from text, and `visible_width` counts the columns the remaining text
//! occupies. Each character counts as one column unless the caller passes a `std.text` `Measure`
//! that says otherwise. Wide and combining characters need a measure that knows them, such as
//! `std.width`'s `char_columns`. This module does not import `std.width`, so a program that only
//! paints lines does not load its tables.
//!
//! A terminal sends bytes, and `decode` turns them into `Event`s: keys with their modifiers, a
//! bracketed paste as one event, and focus and size reports. A terminal sends all the bytes of a
//! key's escape sequence at once, which a person cannot type that fast. So an escape byte followed
//! by nothing for `escape_timeout_ms` is the Escape key, which is how `next_event` reads it.
//!
//! A `Writer` is the only writer of standard error while progress is drawn. The program's own lines
//! go through it too, so none appears in the middle of a status line. On a terminal, it redraws one
//! status line in place, no more often than its interval. When the stream is not a terminal, it
//! writes the status as plain lines, at the same rate limit.

import std.bytes
import std.config
import std.config (config)
import std.internal.native (native, wait, job_wait, found, decode_int)
import std.list
import std.laws (agrees)
import std.process
import std.process (process, pipe, Stream, Stdin, Stdout, Stderr, write_err)
import std.string
import std.text
import std.text (Measure)
import std.time (as_nanos, nanos_at)
import std.gen

/// The terminal the process's streams are connected to, if any.
pub nondet effect term {
  /// Whether `stream` is a terminal.
  read is_terminal(stream: Stream) -> Bool
  /// The columns and rows of the terminal: standard output's if that is one, else standard
  /// error's, else standard input's; `None` if none is a terminal.
  read size() -> Option<Size>
  /// Puts standard input's terminal in `mode` and returns the mode it was in, so a `with_scope` can
  /// restore it. Returns `None` and changes nothing if standard input is not a terminal. However
  /// the run ends, the host leaves the terminal as it found it.
  write mode(mode: Mode) -> Option<Mode>
  /// What has been typed, at most `max` bytes. Waits at most `timeout_ms` for the first byte, or
  /// indefinitely if that is negative. Returns `None` when nothing came in time, and empty bytes
  /// at the end of input. It reads the same buffer as `process.line` and `process.in_bytes`.
  write input(max: Int, timeout_ms: Int) -> Option<Bytes>
  /// One line of standard input, without its line ending, readable only through a `Secret`'s own
  /// functions. `None` at the end of input.
  write secret_line() -> Option<Secret<String>>
}

/// The error raised when a terminal is required but missing.
pub effect tty {
  /// `stream` is not a terminal, and the request needs one.
  raise missing(stream: Stream)
}

/// A terminal's size in character cells.
pub type Size = { columns: Int, rows: Int }

/// How a terminal delivers what is typed.
pub type Mode =
  /// A line at a time, echoed: a terminal's usual mode.
  | Cooked
  /// A line at a time, with nothing typed shown.
  | Silent
  /// Delivers each byte as it is typed. Nothing is echoed and no byte is treated as a signal, so
  /// `ctrl-C` arrives as a key. Output is not post-processed either, so a line must end with `\r\n`
  /// instead of `\n`.
  | Raw

/// How much colour a stream accepts.
pub type Colors =
  /// No styling at all: text is written as it is.
  | NoColors
  /// The eight colours and their bright forms.
  | Ansi16
  | Ansi256
  /// Any colour, by its red, green and blue.
  | TrueColor

/// What decides how text is painted for one stream.
pub type Style = new { colors: Colors }

/// A style that paints nothing: text is written as it is.
pub fn plain() -> Style = { colors: NoColors }

/// A style of the sixteen colours, which every terminal that supports colour supports.
pub fn ansi() -> Style = { colors: Ansi16 }

/// Returns a `Style` that paints with `colors`.
pub fn style_of(colors: Colors) -> Style = { colors: colors }

/// Whether the style paints at all.
pub fn has_colors(style: Style) -> Bool = style.colors != NoColors

/// What a caller requests for colour.
pub type Choice =
  /// Styled when the stream and the environment allow it.
  | Auto
  | Always
  | Never

/// The values of the environment variables that affect colour, each `None` when the variable is not
/// set.
pub type Environment = {
  no_color: Option<String>,
  force_color: Option<String>,
  clicolor_force: Option<String>,
  term: Option<String>,
  colorterm: Option<String>,
}

/// An environment with none of the variables set.
pub fn silent_environment() -> Environment =
  { no_color: None, force_color: None, clicolor_force: None, term: None, colorterm: None }

/// The run's colour variables, read through `std.config` under the label `k`:
/// `NO_COLOR`, `FORCE_COLOR`, `CLICOLOR_FORCE`, `TERM` and `COLORTERM`.
pub fn environment<[k]>() -> Environment / {config.get[k]} =
  {
    no_color: config.get[k]("NO_COLOR"),
    force_color: config.get[k]("FORCE_COLOR"),
    clicolor_force: config.get[k]("CLICOLOR_FORCE"),
    term: config.get[k]("TERM"),
    colorterm: config.get[k]("COLORTERM"),
  }

/// The style for `stream` in this run: `decide` applied to what the caller requested, whether the
/// stream is a terminal, and the run's environment. A program calls this once and passes the
/// style to whatever paints.
pub fn style_for<[k]>(choice: Choice, stream: Stream) -> Style / {term.is_terminal, config.get[k]} =
  decide(choice, term.is_terminal(stream), environment[k]())

fn is_set(variable: Option<String>) -> Bool = match variable { Some(v) -> v != "", None -> false }

fn terminal_colors(env: Environment) -> Colors = {
  let term = match env.term { Some(t) -> t.ascii_lower(), None -> "" };
  let colorterm = match env.colorterm { Some(c) -> c.ascii_lower(), None -> "" };
  if colorterm == "truecolor" || colorterm == "24bit" || String::ends_with(term, "-direct") {
    TrueColor
  } else if String::contains(term, "256color") { Ansi256 }
  else { Ansi16 }
}

/// The style for a stream, from what `choice` requests, whether the stream is a `terminal`, and
/// the environment, by the precedence in this module's documentation.
pub fn decide(choice: Choice, terminal: Bool, env: Environment) -> Style =
  match choice {
    Never -> plain(),
    Always -> style_of(terminal_colors(env)),
    Auto -> if is_set(env.force_color) { style_of(terminal_colors(env)) }
    else if is_set(env.no_color) { plain() }
    else if is_set(env.clicolor_force) { style_of(terminal_colors(env)) }
    else if !terminal || env.term == Some("dumb") { plain() }
    else { style_of(terminal_colors(env)) },
  }

/// A colour: one of the eight and their bright forms, one of the 256 by its index, or any by
/// its red, green and blue, each `0` to `255`. An index or a part outside that range is clamped to
/// the nearest end.
pub type Color =
  | Black
  | Red
  | Green
  | Yellow
  | Blue
  | Magenta
  | Cyan
  | White
  | BrightBlack
  | BrightRed
  | BrightGreen
  | BrightYellow
  | BrightBlue
  | BrightMagenta
  | BrightCyan
  | BrightWhite
  | Indexed(Int)
  | Rgb(Int, Int, Int)

/// How a run of text looks: its foreground and background colours, each `None` to keep the
/// terminal's own colour, and its on-or-off attributes.
pub type TextFormat = {
  foreground: Option<Color>,
  background: Option<Color>,
  bold: Bool,
  dim: Bool,
  italic: Bool,
  underline: Bool,
  reverse: Bool,
  strike: Bool,
}

/// Returns the format that changes nothing: no colours and no attributes.
pub fn default_look() -> TextFormat =
  {
    foreground: None,
    background: None,
    bold: false,
    dim: false,
    italic: false,
    underline: false,
    reverse: false,
    strike: false,
  }

/// The look of text in `color`.
pub fn colored(color: Color) -> TextFormat = { ..default_look(), foreground: Some(color) }

/// Returns `inner` applied on top of `outer`. A colour set in `inner` replaces the colour in
/// `outer`, and an attribute that is on in either stays on.
pub fn over_look(outer: TextFormat, inner: TextFormat) -> TextFormat =
  {
    foreground: match inner.foreground { Some(_) -> inner.foreground, None -> outer.foreground },
    background: match inner.background { Some(_) -> inner.background, None -> outer.background },
    bold: outer.bold || inner.bold,
    dim: outer.dim || inner.dim,
    italic: outer.italic || inner.italic,
    underline: outer.underline || inner.underline,
    reverse: outer.reverse || inner.reverse,
    strike: outer.strike || inner.strike,
  }

fn clamp_byte(n: Int) -> Int = max(0, min(n, 255))

fn basic_index(color: Color) -> Option<Int> =
  match color {
    Black -> Some(0),
    Red -> Some(1),
    Green -> Some(2),
    Yellow -> Some(3),
    Blue -> Some(4),
    Magenta -> Some(5),
    Cyan -> Some(6),
    White -> Some(7),
    BrightBlack -> Some(8),
    BrightRed -> Some(9),
    BrightGreen -> Some(10),
    BrightYellow -> Some(11),
    BrightBlue -> Some(12),
    BrightMagenta -> Some(13),
    BrightCyan -> Some(14),
    BrightWhite -> Some(15),
    Indexed(n) -> if clamp_byte(n) < 16 { Some(clamp_byte(n)) } else { None },
    Rgb(_, _, _) -> None,
  }

type RgbParts = { r: Int, g: Int, b: Int }

fn basic_parts() -> List<RgbParts> =
  [
    { r: 0, g: 0, b: 0 },
    { r: 205, g: 0, b: 0 },
    { r: 0, g: 205, b: 0 },
    { r: 205, g: 205, b: 0 },
    { r: 0, g: 0, b: 238 },
    { r: 205, g: 0, b: 205 },
    { r: 0, g: 205, b: 205 },
    { r: 229, g: 229, b: 229 },
    { r: 127, g: 127, b: 127 },
    { r: 255, g: 0, b: 0 },
    { r: 0, g: 255, b: 0 },
    { r: 255, g: 255, b: 0 },
    { r: 92, g: 92, b: 255 },
    { r: 255, g: 0, b: 255 },
    { r: 0, g: 255, b: 255 },
    { r: 255, g: 255, b: 255 },
  ]

fn cube_part(step: Int) -> Int = if step == 0 { 0 } else { 55 + 40 * step }

fn indexed_parts(n: Int) -> RgbParts =
  if n < 16 { basic_parts().at_or(n, { r: 0, g: 0, b: 0 }) } else if n < 232 {
    let c = n - 16;
    { r: cube_part(c / 36), g: cube_part(c / 6 % 6), b: cube_part(c % 6) }
  } else {
    let grey = 8 + 10 * (n - 232);
    { r: grey, g: grey, b: grey }
  }

fn distance(a: RgbParts, b: RgbParts) -> Int =
  (a.r - b.r) * (a.r - b.r) + (a.g - b.g) * (a.g - b.g) + (a.b - b.b) * (a.b - b.b)

fn cube_step(part: Int) -> Int =
  if part < 48 { 0 } else if part < 115 { 1 } else { (part - 35) / 40 }

fn nearest_indexed(p: RgbParts) -> Int = {
  let cube = 16 + 36 * cube_step(p.r) + 6 * cube_step(p.g) + cube_step(p.b);
  let grey = 232 + max(0, min((p.r + p.g + p.b) / 3 - 3, 239)) / 10;
  if distance(p, indexed_parts(grey)) < distance(p, indexed_parts(cube)) { grey } else { cube }
}

fn nearest_basic(p: RgbParts) -> Int =
  range(0, 16).fold(0, |best: Int, n: Int|
    if distance(p, indexed_parts(n)) < distance(p, indexed_parts(best)) { n } else { best })

fn parts_of(color: Color) -> RgbParts =
  match color {
    Rgb(r, g, b) -> { r: clamp_byte(r), g: clamp_byte(g), b: clamp_byte(b) },
    Indexed(n) -> indexed_parts(clamp_byte(n)),
    _ -> match basic_index(color) { Some(n) -> indexed_parts(n), None -> { r: 0, g: 0, b: 0 } },
  }

fn basic_code(n: Int, base: Int) -> String =
  Int::to_string(if n < 8 { base + n } else { base + 60 + n - 8 })

fn color_code(colors: Colors, color: Color, base: Int) -> String =
  match basic_index(color) {
    Some(n) -> basic_code(n, base),
    None -> match colors {
      NoColors -> "",
      Ansi16 -> basic_code(nearest_basic(parts_of(color)), base),
      Ansi256 ->
        Int::to_string(base + 8) ++ ";5;"
          ++ Int::to_string(match color {
            Indexed(n) -> clamp_byte(n),
            _ -> nearest_indexed(parts_of(color)),
          }),
      TrueColor -> match color {
        Indexed(n) -> Int::to_string(base + 8) ++ ";5;" ++ clamp_byte(n).to_string(),
        _ -> {
          let p = parts_of(color);
          Int::to_string(base + 8) ++ ";2;" ++ p.r.to_string() ++ ";" ++ p.g.to_string() ++ ";"
            ++ p.b.to_string()
        },
      },
    },
  }

fn codes(colors: Colors, default_look: TextFormat) -> String = {
  let attributes = [
    { on: default_look.bold, code: "1" },
    { on: default_look.dim, code: "2" },
    { on: default_look.italic, code: "3" },
    { on: default_look.underline, code: "4" },
    { on: default_look.reverse, code: "7" },
    { on: default_look.strike, code: "9" },
  ].fold([], |accumulator: List<String>, a: { on: Bool, code: String }|
    if a.on { accumulator.push(a.code) } else { accumulator });
  let fg = match default_look.foreground {
    Some(c) -> attributes.push(color_code(colors, c, 30)),
    None -> attributes,
  };
  let all = match default_look.background {
    Some(c) -> fg.push(color_code(colors, c, 40)),
    None -> fg,
  };
  all.fold("", |accumulator: String, code: String|
    if accumulator == "" { code } else { accumulator ++ ";" ++ code })
}

fn escape() -> String = "\u{1b}"

/// `text` with the look `default_look`, as far as `style` allows: the sequence that sets the look,
/// the text, and the reset. A style that paints nothing, or a look that sets nothing, returns the
/// text unchanged.
pub fn paint(style: Style, default_look: TextFormat, text: String) -> String =
  if !has_colors(style) { text } else {
    let set = codes(style.colors, default_look);
    if set == "" { text } else { escape() ++ "[" ++ set ++ "m" ++ text ++ escape() ++ "[0m" }
  }

/// `text` in bold.
pub fn bold(style: Style, text: String) -> String =
  paint(style, { ..default_look(), bold: true }, text)

/// `text` dimmed.
pub fn dim(style: Style, text: String) -> String =
  paint(style, { ..default_look(), dim: true }, text)

/// `text` in red.
pub fn red(style: Style, text: String) -> String = paint(style, colored(Red), text)

/// `text` in green.
pub fn green(style: Style, text: String) -> String = paint(style, colored(Green), text)

/// `text` in yellow.
pub fn yellow(style: Style, text: String) -> String = paint(style, colored(Yellow), text)

/// Text whose parts may look different: a plain run, or parts under one look, with each part's
/// own look laid over it.
pub type Span = | Run(String) | Painted(TextFormat, List<Span>)

fn render_span(style: Style, under: TextFormat, span: Span) -> String =
  match span {
    Run(text) -> paint(style, under, text),
    Painted(inner, parts) ->
      parts.fold("", |accumulator: String, part: Span|
        accumulator ++ render_span(style, over_look(under, inner), part)),
  }

/// The span as text for a stream with `style`. Each run is painted whole, with every enclosing
/// look combined, so after a nested span ends, the following text uses the style of the enclosing span again.
pub fn render(style: Style, span: Span) -> String = render_span(style, default_look(), span)

/// The span's text, with no styling.
pub fn text_of(span: Span) -> String = render_span(plain(), default_look(), span)

fn sequence_end(b: Bytes, i: Int) -> Int / {abort.raise} = {
  let n = b.len();
  if i + 1 >= n { n } else {
    match b.at(i + 1) {
      b'[' -> {
        let last = b.scan(i + 2, b"0123456789:;<=>? !\"#$%&'()*+,-./", n - (i + 2));
        if last < n && b.at(last) >= 0x40 && b.at(last) <= 0x7e { last + 1 } else { last }
      },
      b']' -> {
        let bell = b.index_of_from(b"\x07", i + 2);
        let st = b.index_of_from(b"\x1b\\", i + 2);
        match bell {
          Some(at) -> match st { Some(s) -> if s < at { s + 2 } else { at + 1 }, None -> at + 1 },
          None -> match st { Some(s) -> s + 2, None -> n },
        }
      },
      _ -> i + 2,
    }
  }
}

/// `text` with every escape sequence removed: what to write to a stream that accepts no styling.
pub fn strip(text: String) -> String / {abort.raise} = {
  let b = Bytes::of_string(text);
  let n = b.len();
  let unescaped_parts = iterate(
    { at: 0, parts: [] },
    n + 1,
    |s: { at: Int, parts: List<Bytes> }|
      if s.at >= n { Stop(s.parts) } else {
        match b.index_of_from(b"\x1b", s.at) {
          None -> Stop(s.parts.push(b.slice(s.at, n))),
          Some(esc) ->
            Continue({ at: sequence_end(b, esc), parts: s.parts.push(b.slice(s.at, esc)) }),
        }
      },
  );
  String::of_bytes_lossy(Bytes::concat_all(unescaped_parts))
}

/// The columns `text` takes once its escape sequences are removed, each character one column
/// unless `measure` says otherwise.
pub fn visible_width(text: String, measure: Measure = None) -> Int / {abort.raise} =
  text::width(strip(text), measure)

/// A key, without the modifiers held with it.
pub type Key =
  /// A typed character, as the terminal sent it. A held shift shows in the character, not in the
  /// chord.
  | Character(Char)
  | Enter
  | Tab
  | Backspace
  | Escape
  | Up
  | Down
  | Left
  | Right
  | Home
  | End
  | PageUp
  | PageDown
  | Insert
  | Delete
  /// A function key by its number, `F(1)` to `F(20)`.
  | F(Int)

/// A key and the modifiers held as it was pressed. A terminal reports only what its sequences can
/// express: a control character is `ctrl` with its letter in lower case, and an escape before a
/// key is `alt`.
pub type Chord = { key: Key, ctrl: Bool, alt: Bool, shift: Bool }

/// What a terminal sends.
pub type Event =
  | Pressed(Chord)
  /// What was pasted between the markers of a bracketed paste, which a terminal sends once
  /// `\x1b[?2004h` has enabled it.
  | Pasted(Bytes)
  /// The terminal's window gained or lost focus, reported once `\x1b[?1004h` has enabled it.
  | Focused(Bool)
  /// The terminal's size, when it reports one in its input.
  | Resized(Size)
  /// A sequence this module does not recognize, or bytes that are not a character.
  | Unknown(Bytes)

/// `key` with no modifiers held.
pub fn chord(key: Key) -> Chord = { key: key, ctrl: false, alt: false, shift: false }

/// How long an escape must be followed by nothing before it counts as the Escape key, in
/// milliseconds.
pub fn escape_timeout_ms() -> Int = 50

/// What `decode` made of some bytes: the events they contain, and the bytes of a sequence that has
/// not fully arrived.
pub type DecodeResult = { events: List<Event>, rest: Bytes }

type DecodedEvent = { event: Event, next: Int }

fn letter(c: Int) -> Char = match Char::of_int(c) { Some(ch) -> ch, None -> '?' }

fn ascii_key(c: Int) -> Chord =
  match c {
    0x0d | 0x0a -> chord(Enter),
    0x09 -> chord(Tab),
    0x7f -> chord(Backspace),
    0x00 -> { ..chord(Character(' ')), ctrl: true },
    0x01..=0x1a -> { ..chord(Character(letter(c + 0x60))), ctrl: true },
    0x1c..=0x1f -> { ..chord(Character(letter(c + 0x40))), ctrl: true },
    _ -> chord(Character(letter(c))),
  }

fn unknown_event(b: Bytes, from: Int, to: Int) -> DecodedEvent / {abort.raise} =
  { event: Unknown(b.slice(from, to)), next: to }

fn utf8_len(lead: Int) -> Int =
  if lead >= 0xc2 && lead < 0xe0 { 2 }
  else if lead >= 0xe0 && lead < 0xf0 { 3 }
  else if lead >= 0xf0 && lead <= 0xf4 { 4 }
  else { 0 }

fn decode_key(b: Bytes, i: Int, input_complete: Bool) -> Option<DecodedEvent> / {abort.raise} = {
  let c = b.at(i);
  let need = utf8_len(c);
  let have = b.len() - i;
  if c < 0x80 { Some({ event: Pressed(ascii_key(c)), next: i + 1 }) }
  else if need == 0 { Some(unknown_event(b, i, i + 1)) }
  else if have < need { if input_complete { Some(unknown_event(b, i, b.len())) } else { None } }
  else {
    let piece = b.slice(i, i + need);
    if !piece.is_utf8() { Some(unknown_event(b, i, i + 1)) } else {
      match String::of_bytes(piece).chars() {
        [ch, ..] -> Some({ event: Pressed(chord(Character(ch))), next: i + need }),
        [] -> Some(unknown_event(b, i, i + 1)),
      }
    }
  }
}

fn with_modifiers(key: Key, modifier: Int) -> Chord = {
  let bits = max(modifier, 1) - 1;
  { key: key, shift: bits & 1 != 0, alt: bits & 2 != 0, ctrl: bits & 4 != 0 }
}

fn tilde_key(n: Int) -> Option<Key> =
  match n {
    1 | 7 -> Some(Home),
    2 -> Some(Insert),
    3 -> Some(Delete),
    4 | 8 -> Some(End),
    5 -> Some(PageUp),
    6 -> Some(PageDown),
    11..=15 -> Some(F(n - 10)),
    17..=21 -> Some(F(n - 11)),
    23..=26 -> Some(F(n - 12)),
    28 | 29 -> Some(F(n - 13)),
    31..=34 -> Some(F(n - 14)),
    _ -> None,
  }

fn letter_key(last: Int) -> Option<Key> =
  match last {
    b'A' -> Some(Up),
    b'B' -> Some(Down),
    b'C' -> Some(Right),
    b'D' -> Some(Left),
    b'H' -> Some(Home),
    b'F' -> Some(End),
    b'P' -> Some(F(1)),
    b'Q' -> Some(F(2)),
    b'R' -> Some(F(3)),
    b'S' -> Some(F(4)),
    _ -> None,
  }

fn numbers(params: Bytes) -> List<Int> / {abort.raise} =
  params.split(b";").map(|field: Bytes| match field.int_of_ascii() { Some(n) -> n, None -> 0 })

fn decode_paste(b: Bytes, from: Int, input_complete: Bool) -> Option<DecodedEvent> / {abort.raise} =
  match b.index_of_from(b"\x1b[201~", from) {
    Some(end) -> Some({ event: Pasted(b.slice(from, end)), next: end + 6 }),
    None -> if input_complete { Some({ event: Pasted(b.slice(from, b.len())), next: b.len() }) }
    else { None },
  }

fn decode_control_sequence(
  b: Bytes,
  start: Int,
  params: Bytes,
  last: Int,
  next: Int,
  input_complete: Bool,
) -> Option<DecodedEvent> / {abort.raise} = {
  let ps = numbers(params);
  let first = ps.at_or(0, 0);
  let modifier = ps.at_or(1, 1);
  let pressed = |key: Key| Some({ event: Pressed(with_modifiers(key, modifier)), next: next });
  let private = params.len() > 0 && params.at(0) >= b'<';
  if private { Some(unknown_event(b, start, next)) } else {
    match last {
      b'~' -> if first == 200 { decode_paste(b, next, input_complete) } else {
        match tilde_key(first) {
          Some(key) -> pressed(key),
          None -> Some(unknown_event(b, start, next)),
        }
      },
      b'Z' -> Some({ event: Pressed({ ..chord(Tab), shift: true }), next: next }),
      b'I' -> Some({ event: Focused(true), next: next }),
      b'O' -> Some({ event: Focused(false), next: next }),
      b'u' -> match Char::of_int(first) {
        Some(ch) -> pressed(Character(ch)),
        None -> Some(unknown_event(b, start, next)),
      },
      b't' -> if (first == 8 || first == 48) && ps.len() >= 3 {
        Some({ event: Resized({ columns: ps.at_or(2, 0), rows: ps.at_or(1, 0) }), next: next })
      } else { Some(unknown_event(b, start, next)) },
      _ -> match letter_key(last) {
        Some(key) -> pressed(key),
        None -> Some(unknown_event(b, start, next)),
      },
    }
  }
}

fn decode_escape(b: Bytes, i: Int, input_complete: Bool) -> Option<DecodedEvent> / {abort.raise} = {
  let n = b.len();
  let alone = |key: Key|
    if input_complete { Some({ event: Pressed({ ..chord(key), alt: key != Escape }), next: n }) }
    else { None };
  if i + 1 >= n { alone(Escape) } else {
    match b.at(i + 1) {
      b'[' -> {
        let params_end = b.scan(i + 2, b"0123456789:;<=>?", n - (i + 2));
        let last = b.scan(params_end, b" !\"#$%&'()*+,-./", n - params_end);
        if last >= n {
          if i + 2 >= n { alone(Character('[')) }
          else if input_complete { Some(unknown_event(b, i, n)) }
          else { None }
        } else if b.at(last) < 0x40 || b.at(last) > 0x7e { Some(unknown_event(b, i, last)) } else {
          decode_control_sequence(
            b,
            i,
            b.slice(i + 2, params_end),
            b.at(last),
            last + 1,
            input_complete,
          )
        }
      },
      b'O' -> if i + 2 >= n { alone(Character('O')) } else {
        match letter_key(b.at(i + 2)) {
          Some(key) -> Some({ event: Pressed(chord(key)), next: i + 3 }),
          None -> if b.at(i + 2) == b'M' { Some({ event: Pressed(chord(Enter)), next: i + 3 }) }
          else { Some(unknown_event(b, i, i + 3)) },
        }
      },
      0x1b -> Some({ event: Pressed({ ..chord(Escape), alt: true }), next: i + 2 }),
      _ -> match decode_key(b, i + 1, input_complete) {
        None -> None,
        Some(got) -> match got.event {
          Pressed(c) -> Some({ event: Pressed({ ..c, alt: true }), next: got.next }),
          _ -> Some(unknown_event(b, i, got.next)),
        },
      },
    }
  }
}

/// The events in `bytes`, in order. When `input_complete` is false, more bytes may be coming, so
/// anything that could start a longer sequence is left in `rest` to be joined with them. When it
/// is true, nothing more is coming, so a lone escape is the Escape key and an escape before a key
/// is that key with `alt`.
pub fn decode(bytes: Bytes, input_complete: Bool) -> DecodeResult / {abort.raise} = {
  let n = bytes.len();
  let read = iterate({ at: 0, events: [] }, n + 1, |s: { at: Int, events: List<Event> }|
    if s.at >= n { Stop(s) } else {
      let got = if bytes.at(s.at) == 0x1b { decode_escape(bytes, s.at, input_complete) }
      else { decode_key(bytes, s.at, input_complete) };
      match got {
        None -> Stop(s),
        Some(g) -> Continue({ at: g.next, events: s.events.push(g.event) }),
      }
    });
  { events: read.events, rest: bytes.slice(read.at, n) }
}

/// The state of an event reader between reads: the bytes of a sequence that is still arriving, the
/// events that were read but not yet returned, and whether the input has ended.
pub type Pending = { rest: Bytes, ready: List<Event>, ended: Bool }

/// A reader that has read nothing.
pub fn pending() -> Pending = { rest: b"", ready: [], ended: false }

/// One event, or none, and the reader after it.
pub type Next = { event: Option<Event>, pending: Pending }

fn take_ready(p: Pending) -> Next =
  match p.ready {
    [first, ..rest] -> { event: Some(first), pending: { ..p, ready: rest } },
    [] -> { event: None, pending: p },
  }

/// Returns the next event and the updated reader. The event is one that was already read, or else
/// one the terminal sends within `wait_ms` milliseconds; a negative `wait_ms` waits indefinitely.
/// `Next.event` is `None` when no event arrived in time, and always once the input has ended. After
/// the first byte of a sequence, each read waits `escape_timeout_ms` for the rest. A sequence
/// longer than `limit` bytes, such as an endless paste, is decoded from the bytes read so far.
pub fn next_event(p: Pending, wait_ms: Int, limit: Int) -> Next / {term.input, abort.raise} =
  if p.ready.len() > 0 || p.ended { take_ready(p) } else {
    take_ready(
      iterate(p, max(limit, 0) + 2, |s: Pending| {
        let partial = s.rest.len() > 0;
        let input = term.input(256, if partial { escape_timeout_ms() } else { wait_ms });
        let more = match input { Some(bytes) -> bytes, None -> b"" };
        let ended = input == Some(b"");
        let quiet = more.len() == 0;
        let all = s.rest.concat(more);
        let read = decode(all, quiet || all.len() > limit);
        let now = { rest: read.rest, ready: read.events, ended: ended };
        if read.events.len() > 0 || quiet { Stop(now) } else { Continue(now) }
      }),
    )
  }

/// Puts the terminal in `mode` and returns the mode it was in. Use it as a `with_scope` acquire
/// function, with `restore_mode` to release.
pub fn enter_mode(mode: Mode) -> Mode / {term.mode, tty.missing} =
  match term.mode(mode) { Some(was) -> was, None -> tty.missing(Stdin) }

/// Puts the terminal back in the mode `enter_mode` found it in.
pub fn restore_mode(was: Mode) -> Unit / {term.mode} = {
  let _ = term.mode(was);
  ()
}

/// Runs `body` with the terminal in raw mode, and restores the previous mode however `body` ends.
pub fn raw<a | e>(body: () -> a / e) -> a / {term.mode, tty.missing | e} =
  with_scope[term_raw](enter_mode(Raw), restore_mode) { was -> body() }

/// How to read a secret when standard input is not a terminal.
pub type SecretFallback =
  /// Never read piped input: `read_secret` raises `tty.missing` instead, so a secret is read only
  /// when the person types it with echo turned off.
  | TypedOnly
  /// Read the next line of standard input, whatever it is, as when a script pipes one in.
  | OrPiped

/// A line typed without being shown, after `prompt` on standard error; `None` at the end of input.
/// The terminal echoes again however the read ends. When standard input is not a terminal, there
/// is no echo to hide: `TypedOnly` raises `tty.missing`, and `OrPiped` reads the next line as it
/// is, with no prompt.
pub fn read_secret<[p]>(
  prompt: String,
  fallback: SecretFallback,
) -> Option<Secret<String>> / {term.is_terminal, term.mode, term.secret_line, process.err_bytes[p], pipe.broken, tty.missing} =
  if term.is_terminal(Stdin) {
    write_err[p](Bytes::of_string(prompt));
    let secret = with_scope[term_silent](
      enter_mode(Silent),
      restore_mode,
    ) { was -> term.secret_line() };
    write_err[p](b"\n");
    secret
  } else { match fallback { TypedOnly -> tty.missing(Stdin), OrPiped -> term.secret_line() } }

/// Returns a progress bar `width` columns wide, followed by the percentage that `done` is of
/// `total`, such as `[#####.....]  50%`. A `total` below one gives a full bar, and a `total` above
/// 2^52 is treated as 2^52.
pub fn bar(done: Int, total: Int, width: Int) -> String = {
  let whole = min(total, 4503599627370496);
  let share = if whole < 1 { 100 } else { max(0, min(done, whole)) * 100 / whole };
  let cells = max(min(width, 4096) - 7, 0);
  let filled = cells * share / 100;
  "[" ++ "#".repeat(filled) ++ ".".repeat(cells - filled) ++ "] "
    ++ text::aligned(share.to_string(), 3, text::Right)
    ++ "%"
}

/// The mark a spinner shows on its `tick`th turn.
pub fn spinner(tick: Int) -> String = ["|", "/", "-", "\\"].at_or((tick % 4 + 4) % 4, "|")

/// Tracks the status line shown on standard error and decides when to write it. Create one with
/// `writer` or `stderr_writer`. Each step function returns the bytes to write and the updated
/// `Writer`.
pub type Writer = {
  /// Whether the stream is a terminal. On a terminal, the status is a single line that is redrawn
  /// in place.
  live: Bool,
  /// The columns a status may take.
  columns: Int,
  /// The shortest time between two writes of a status.
  every: Duration,
  /// The columns each character of a status takes, one if `None`.
  measure: Measure,
  /// The clock's reading when a status was last written.
  wrote: Option<Instant>,
  /// The most recently requested status.
  status: String,
  /// Whether the current status has not been written yet because the minimum interval between
  /// writes had not passed.
  unsaid: Bool,
  /// Whether a status is on the terminal's line.
  shown: Bool,
}

/// A writer for a stream that is `live` if it is a terminal, `columns` wide, writing a status at
/// most once every `every`. A status is measured at one column per character unless `measure`
/// says otherwise.
pub fn writer(live: Bool, columns: Int, every: Duration, measure: Measure = None) -> Writer =
  {
    live: live,
    columns: columns,
    every: every,
    measure: measure,
    wrote: None,
    status: "",
    unsaid: false,
    shown: false,
  }

/// What a step of a writer writes, and the writer after it.
pub type Step = { writer: Writer, bytes: Bytes }

fn clear_line() -> String = "\r" ++ escape() ++ "[K"

fn draw_status(w: Writer) -> String / {abort.raise} = {
  let room = max(w.columns - 1, 0);
  clear_line()
    ++ (if visible_width(w.status, w.measure) <= room { w.status }
    else { text::truncate(strip(w.status), room, "", w.measure) })
}

fn due(w: Writer, now: Instant) -> Bool =
  match w.wrote { None -> true, Some(at) -> nanos_at(now) -| nanos_at(at) >= as_nanos(w.every) }

/// Sets the status to `status`, where `now` is a reading of the caller's clock. If no status was
/// written within the writer's interval, the status is written now. Otherwise it is saved and
/// written by a later step once the interval has passed. A status equal to the one already shown is
/// not written again. On a terminal the status is redrawn in place, cut to the terminal's width;
/// anywhere else it is written as a line of its own.
pub fn status_step(w: Writer, now: Instant, status: String) -> Step / {abort.raise} = {
  let prompt_secret = { ..w, status: status, unsaid: w.unsaid || status != w.status };
  if !prompt_secret.unsaid || !due(w, now) { { writer: prompt_secret, bytes: b"" } } else {
    {
      writer: { ..prompt_secret, unsaid: false, wrote: Some(now), shown: w.live },
      bytes: Bytes::of_string(if w.live { draw_status(prompt_secret) } else { as_line(status) }),
    }
  }
}

fn as_line(status: String) -> String = if status == "" { "" } else { status ++ "\n" }

/// Writes a line of the program's own. On a terminal, the status is cleared for it and drawn again
/// below it; anywhere else, only the line is written.
pub fn line_step(w: Writer, line: String) -> Step / {abort.raise} =
  {
    writer: w,
    bytes: Bytes::of_string(if w.live && w.shown { clear_line() ++ line ++ "\n" ++ draw_status(w) }
    else { line ++ "\n" }),
  }

/// Ends the progress. On a terminal the status is cleared. Anywhere else, the last status is
/// written if the interval delayed it.
pub fn finish_step(w: Writer) -> Step = {
  let ended = { ..w, status: "", unsaid: false, shown: false };
  if w.live { { writer: ended, bytes: Bytes::of_string(if w.shown { clear_line() } else { "" }) } }
  else { { writer: ended, bytes: Bytes::of_string(if w.unsaid { as_line(w.status) } else { "" }) } }
}

/// A writer for this run's standard error: live if it is a terminal, as wide as the terminal, or
/// 80 columns if the size is unknown.
pub fn stderr_writer(
  every: Duration,
  measure: Measure = None,
) -> Writer / {term.is_terminal, term.size} =
  writer(
    term.is_terminal(Stderr),
    match term.size() { Some(size) -> size.columns, None -> 80 },
    every,
    measure,
  )

fn write_step<[p]>(step: Step) -> Writer / {process.err_bytes[p], pipe.broken} = {
  if step.bytes.len() > 0 { write_err[p](step.bytes) };
  step.writer
}

/// Shows `text` as the status, as `status_step` does, at the current reading of the language's
/// `clock`: the run's real clock under `ply run`, and the virtual clock inside `simulate`.
pub fn status<[p]>(
  w: Writer,
  text: String,
) -> Writer / {process.err_bytes[p], pipe.broken, clock.now, abort.raise} =
  write_step[p](status_step(w, clock.now(), text))

/// Writes a line of the program's own, as `line_step` does.
pub fn say<[p]>(
  w: Writer,
  line: String,
) -> Writer / {process.err_bytes[p], pipe.broken, abort.raise} = write_step[p](line_step(w, line))

/// Ends the progress, as `finish_step` does.
pub fn finish<[p]>(w: Writer) -> Writer / {process.err_bytes[p], pipe.broken} =
  write_step[p](finish_step(w))

host for term by with_host

fn with_host<a | e>(
  go: () -> a / {term.read, term.write | e},
) -> a / {native.read, wait.read, abort.raise | e} =
  handle {
    go()
  } with {
    term.is_terminal(stream) -> term_is_terminal(stream_number(stream)),
    term.size() -> match found(term_size()) {
      Some(both) ->
        Some({ columns: decode_int(both.slice(0, 8)), rows: decode_int(both.slice(8, 16)) }),
      None -> None,
    },
    term.mode(mode) -> mode_of(term_mode(mode_number(mode))),
    term.input(max, timeout_ms) -> if max < 0 {
      panic("`term.input` was asked for " ++ max.to_string() ++ " bytes")
    } else { found(job_wait(term_input(max, timeout_ms))) },
    term.secret_line() -> match found(job_wait(term_secret_line())) {
      Some(number) -> Some(term_secret_taken(decode_int(number))),
      None -> None,
    },
  }

extern fn term_is_terminal(stream: Int) -> Bool / {native.read}

extern fn term_size() -> Bytes / {native.read}

extern fn term_mode(mode: Int) -> Int / {native.read}

extern fn term_input(max: Int, timeout_ms: Int) -> Int / {native.read}

extern fn term_secret_line() -> Int / {native.read}

extern fn term_secret_taken(number: Int) -> Secret<String> / {native.read}

fn stream_number(stream: Stream) -> Int = match stream { Stdin -> 0, Stdout -> 1, Stderr -> 2 }

fn mode_number(mode: Mode) -> Int = match mode { Cooked -> 0, Silent -> 1, Raw -> 2 }

fn mode_of(number: Int) -> Option<Mode> =
  match number { 0 -> Some(Cooked), 1 -> Some(Silent), 2 -> Some(Raw), _ -> None }

/// A scripted terminal that a test passes to `on_screen` in place of the host.
pub type Screen = {
  /// The streams that are a terminal.
  terminals: List<Stream>,
  size: Option<Size>,
  mode: Mode,
  /// Every mode the terminal was put in, in order.
  modes: List<Mode>,
  /// The result of each `input`, in order, with `None` for a wait that timed out. Running out
  /// means the end of input.
  typed: List<Option<Bytes>>,
  /// The lines `secret_line` returns, in order. Running out means the end of input.
  lines: List<String>,
}

/// A terminal `columns` by `rows` on all three streams, with nothing typed at it.
pub fn screen(columns: Int, rows: Int) -> Screen =
  {
    terminals: [Stdin, Stdout, Stderr],
    size: Some({ columns: columns, rows: rows }),
    mode: Cooked,
    modes: [],
    typed: [],
    lines: [],
  }

/// No terminal at all: every stream a pipe or a file.
pub fn no_screen() -> Screen =
  { terminals: [], size: None, mode: Cooked, modes: [], typed: [], lines: [] }

/// The same terminal, with these results for successive reads of input.
pub fn with_input(s: Screen, typed: List<Option<Bytes>>) -> Screen = { ..s, typed: typed }

/// The same terminal, with these lines for `secret_line`.
pub fn with_secret_lines(s: Screen, lines: List<String>) -> Screen = { ..s, lines: lines }

/// What `go` returned over a fake terminal, and the terminal's final state.
pub type RunResult<a> = { value: a, screen: Screen }

/// Runs `go` with the terminal `s` standing in for the host, so every `term` operation that `go`
/// performs is handled by `s`.
pub fn on_screen<a | e>(s: Screen, go: () -> a / {term.read, term.write | e}) -> RunResult<a> / e =
  handle {
    go()
  } with {
    var fake = s,
    term.is_terminal(stream) -> fake.terminals.contains(stream),
    term.size() -> fake.size,
    term.mode(mode) -> {
      let was = fake;
      if was.terminals.contains(Stdin) {
        fake = { ..was, mode: mode, modes: was.modes.push(mode) };
        Some(was.mode)
      } else { None }
    },
    term.input(_, _) -> {
      let was = fake;
      match was.typed {
        [] -> Some(b""),
        [first, ..rest] -> {
          fake = { ..was, typed: rest };
          first
        },
      }
    },
    term.secret_line() -> {
      let was = fake;
      match was.lines {
        [] -> None,
        [first, ..rest] -> {
          fake = { ..was, lines: rest };
          Some(Secret::of_string(first))
        },
      }
    },
    return value -> { value: value, screen: fake },
  }

type DecisionCase = {
  reason: String,
  choice: Choice,
  terminal: Bool,
  env: Environment,
  colors: Colors,
}

fn on_xterm() -> Environment = { ..silent_environment(), term: Some("xterm") }

fn decision_cases() -> List<DecisionCase> =
  [
    {
      reason: "a terminal is styled",
      choice: Auto,
      terminal: true,
      env: on_xterm(),
      colors: Ansi16,
    },
    { reason: "a pipe is not", choice: Auto, terminal: false, env: on_xterm(), colors: NoColors },
    {
      reason: "NO_COLOR set leaves a terminal plain",
      choice: Auto,
      terminal: true,
      env: { ..on_xterm(), no_color: Some("1") },
      colors: NoColors,
    },
    {
      reason: "NO_COLOR set to nothing is not set",
      choice: Auto,
      terminal: true,
      env: { ..on_xterm(), no_color: Some("") },
      colors: Ansi16,
    },
    {
      reason: "FORCE_COLOR outranks NO_COLOR, as force-color.org's code has it",
      choice: Auto,
      terminal: false,
      env: { ..on_xterm(), no_color: Some("1"), force_color: Some("1") },
      colors: Ansi16,
    },
    {
      reason: "NO_COLOR outranks CLICOLOR_FORCE, as bixense has it",
      choice: Auto,
      terminal: true,
      env: { ..on_xterm(), no_color: Some("1"), clicolor_force: Some("1") },
      colors: NoColors,
    },
    {
      reason: "FORCE_COLOR set to nothing is not set",
      choice: Auto,
      terminal: false,
      env: { ..on_xterm(), force_color: Some("") },
      colors: NoColors,
    },
    {
      reason: "CLICOLOR_FORCE set to nothing is not set",
      choice: Auto,
      terminal: false,
      env: { ..on_xterm(), clicolor_force: Some("") },
      colors: NoColors,
    },
    {
      reason: "a flag outranks NO_COLOR",
      choice: Always,
      terminal: false,
      env: { ..on_xterm(), no_color: Some("1") },
      colors: Ansi16,
    },
    {
      reason: "a flag outranks FORCE_COLOR",
      choice: Never,
      terminal: true,
      env: { ..on_xterm(), force_color: Some("1") },
      colors: NoColors,
    },
    {
      reason: "FORCE_COLOR styles a pipe",
      choice: Auto,
      terminal: false,
      env: { ..silent_environment(), force_color: Some("1") },
      colors: Ansi16,
    },
    {
      reason: "CLICOLOR_FORCE styles a pipe",
      choice: Auto,
      terminal: false,
      env: { ..on_xterm(), clicolor_force: Some("1") },
      colors: Ansi16,
    },
    {
      reason: "CLICOLOR_FORCE forces whatever it is set to",
      choice: Auto,
      terminal: false,
      env: { ..on_xterm(), clicolor_force: Some("0") },
      colors: Ansi16,
    },
    {
      reason: "FORCE_COLOR forces whatever it is set to",
      choice: Auto,
      terminal: false,
      env: { ..on_xterm(), force_color: Some("0") },
      colors: Ansi16,
    },
    {
      reason: "a forced pipe is styled at what TERM says a terminal would have",
      choice: Auto,
      terminal: false,
      env: { ..silent_environment(), term: Some("xterm-256color"), force_color: Some("3") },
      colors: Ansi256,
    },
    {
      reason: "a dumb terminal is not styled",
      choice: Auto,
      terminal: true,
      env: { ..silent_environment(), term: Some("dumb") },
      colors: NoColors,
    },
    {
      reason: "FORCE_COLOR styles a dumb terminal",
      choice: Auto,
      terminal: true,
      env: { ..silent_environment(), term: Some("dumb"), force_color: Some("1") },
      colors: Ansi16,
    },
    {
      reason: "a terminal that names 256 colours has them",
      choice: Auto,
      terminal: true,
      env: { ..silent_environment(), term: Some("xterm-256color") },
      colors: Ansi256,
    },
    {
      reason: "COLORTERM says a terminal has every colour",
      choice: Auto,
      terminal: true,
      env: { ..silent_environment(), term: Some("xterm-256color"), colorterm: Some("truecolor") },
      colors: TrueColor,
    },
    {
      reason: "a direct-colour terminal has every colour",
      choice: Auto,
      terminal: true,
      env: { ..silent_environment(), term: Some("xterm-direct") },
      colors: TrueColor,
    },
    {
      reason: "a terminal that names no type is styled",
      choice: Auto,
      terminal: true,
      env: silent_environment(),
      colors: Ansi16,
    },
    {
      reason: "a flag styles at what the terminal says it has",
      choice: Always,
      terminal: false,
      env: { ..silent_environment(), colorterm: Some("24bit") },
      colors: TrueColor,
    },
  ]

test "`decide` picks the style the case lists for this user choice, terminal and environment: {d.reason}" for d: DecisionCase in decision_cases(
  ) { assert_eq(decide(d.choice, d.terminal, d.env), style_of(d.colors)) }

fn style_over(s: Screen, set: List<{ key: String, value: String }>) -> Style =
  on_screen(s, ||
    handle {
      style_for[env](Auto, Stdout)
    } with {
      config.get[env](key) -> config::get_value(config::values(set, []), key),
    }).value

test "a program's style is decided from its stream and its environment, once" {
  assert_eq(
    style_over(screen(80, 24), [{ key: "TERM", value: "xterm-256color" }]),
    style_of(Ansi256),
  );
  assert_eq(style_over(screen(80, 24), [{ key: "NO_COLOR", value: "1" }]), plain());
  assert_eq(style_over(no_screen(), [{ key: "TERM", value: "xterm-256color" }]), plain());
  assert_eq(
    style_over(no_screen(), [
      { key: "CLICOLOR_FORCE", value: "1" },
      { key: "COLORTERM", value: "truecolor" },
    ]),
    style_of(TrueColor),
  );
  assert_eq(style_over({ ..screen(80, 24), terminals: [Stdin, Stderr] }, []), plain())
}

test "an unstyled stream gets the text and nothing around it" {
  assert_eq(bold(plain(), "E0001"), "E0001");
  assert_eq(dim(plain(), "at"), "at");
  assert_eq(red(plain(), "error"), "error");
  assert_eq(green(plain(), "checked"), "checked");
  assert_eq(yellow(plain(), "warning"), "warning");
  assert_eq(paint(plain(), { ..colored(Rgb(1, 2, 3)), bold: true }, "x"), "x");
  assert(!has_colors(plain()));
  assert(has_colors(ansi()))
}

test "a styled stream wraps the text between the escape sequence for its text style and the reset sequence" {
  let on = ansi();
  assert_eq(Bytes::of_string(bold(on, "x")), b"\x1b[1mx\x1b[0m");
  assert_eq(Bytes::of_string(dim(on, "x")), b"\x1b[2mx\x1b[0m");
  assert_eq(Bytes::of_string(red(on, "x")), b"\x1b[31mx\x1b[0m");
  assert_eq(Bytes::of_string(green(on, "x")), b"\x1b[32mx\x1b[0m");
  assert_eq(Bytes::of_string(yellow(on, "x")), b"\x1b[33mx\x1b[0m");
  assert_eq(Bytes::of_string(bold(on, "")), b"\x1b[1m\x1b[0m");
  assert_eq(paint(on, default_look(), "x"), "x");
  let every = {
    foreground: Some(BrightWhite),
    background: Some(Blue),
    bold: true,
    dim: true,
    italic: true,
    underline: true,
    reverse: true,
    strike: true,
  };
  assert_eq(Bytes::of_string(paint(on, every, "x")), b"\x1b[1;2;3;4;7;9;97;44mx\x1b[0m")
}

type Shade = { color: Color, colors: Colors, code: String }

fn shades() -> List<Shade> =
  [
    { color: Red, colors: Ansi16, code: "31" },
    { color: BrightRed, colors: Ansi16, code: "91" },
    { color: Red, colors: TrueColor, code: "31" },
    { color: Indexed(3), colors: Ansi256, code: "33" },
    { color: Indexed(12), colors: Ansi16, code: "94" },
    { color: Indexed(196), colors: TrueColor, code: "38;5;196" },
    { color: Indexed(196), colors: Ansi256, code: "38;5;196" },
    { color: Indexed(196), colors: Ansi16, code: "91" },
    { color: Indexed(244), colors: Ansi16, code: "90" },
    { color: Indexed(999), colors: Ansi256, code: "38;5;255" },
    { color: Rgb(255, 0, 0), colors: TrueColor, code: "38;2;255;0;0" },
    { color: Rgb(255, 0, 0), colors: Ansi256, code: "38;5;196" },
    { color: Rgb(255, 0, 0), colors: Ansi16, code: "91" },
    { color: Rgb(0, 0, 0), colors: Ansi256, code: "38;5;16" },
    { color: Rgb(128, 128, 128), colors: Ansi256, code: "38;5;244" },
    { color: Rgb(95, 135, 175), colors: Ansi256, code: "38;5;67" },
    { color: Rgb(96, 136, 176), colors: Ansi256, code: "38;5;67" },
    { color: Rgb(300, -5, 12), colors: TrueColor, code: "38;2;255;0;12" },
    { color: Rgb(10, 200, 10), colors: Ansi16, code: "32" },
  ]

test "{s.color} is painted as the nearest colour a stream of {s.colors} accepts" for s: Shade in shades(
  ) {
  assert_eq(paint(style_of(s.colors), colored(s.color), "x"), "\u{1b}[" ++ s.code ++ "mx\u{1b}[0m")
}

test "a background colour uses the terminal colour codes 40 to 47, 100 to 107 and 48" {
  assert_eq(
    Bytes::of_string(
      paint(style_of(TrueColor), { ..default_look(), background: Some(Rgb(1, 2, 3)) }, "x"),
    ),
    b"\x1b[48;2;1;2;3mx\x1b[0m",
  );
  assert_eq(
    Bytes::of_string(paint(ansi(), { ..default_look(), background: Some(BrightGreen) }, "x")),
    b"\x1b[102mx\x1b[0m",
  )
}

fn nested_span() -> Span =
  Painted({ ..default_look(), bold: true }, [
    Run("a "),
    Painted(colored(Red), [Run("b"), Painted({ ..default_look(), underline: true }, [Run("c")])]),
    Run(" d"),
  ])

test "after a nested span ends, the following text uses the style of the enclosing span again" {
  assert_eq(
    Bytes::of_string(render(ansi(), nested_span())),
    b"\x1b[1ma \x1b[0m\x1b[1;31mb\x1b[0m\x1b[1;4;31mc\x1b[0m\x1b[1m d\x1b[0m",
  );
  assert_eq(render(plain(), nested_span()), "a bc d");
  assert_eq(text_of(nested_span()), "a bc d")
}

test "stripping removes the styling and leaves the text" {
  assert_eq(strip(render(style_of(TrueColor), nested_span())), "a bc d");
  assert_eq(strip("plain"), "plain");
  assert_eq(strip(""), "");
  assert_eq(strip("\u{1b}]8;;https://example.com\u{7}link\u{1b}]8;;\u{7}!"), "link!");
  assert_eq(strip("\u{1b}]0;title\u{1b}\\shown"), "shown");
  assert_eq(strip("a\u{1b}[2Kb\u{1b}"), "ab");
  assert_eq(strip("caf\u{e9} \u{1b}[31m\u{4e16}\u{754c}\u{1b}[0m"), "caf\u{e9} \u{4e16}\u{754c}")
}

test "`visible_width` skips escape sequences and counts each character as one column, unless a width function is passed" {
  let painted = red(ansi(), "\u{4e16}\u{754c}!");
  assert_eq(visible_width(painted), 3);
  assert_eq(
    visible_width(painted, Some(|c: Char| if Int::of_char(c) > 0x2e80 { 2 } else { 1 })),
    5,
  );
  assert_eq(visible_width(""), 0)
}

type Painting = { picks: List<Int>, colors: Int, parts: List<Int>, bold: Bool, behind: Bool }

fn sample_text(p: Painting) -> String =
  p.picks.fold("", |accumulator: String, pick: Int|
    accumulator
      ++ ["a", "B", " ", "\u{e9}", "\u{4e16}", "[", "m", ";"].at_or((pick % 8 + 8) % 8, "a"))

fn painted_and_stripped(p: Painting) -> String / {abort.raise} = {
  let colors = [NoColors, Ansi16, Ansi256, TrueColor].at_or((p.colors % 4 + 4) % 4, NoColors);
  let color = match p.parts {
    [] -> Red,
    [n] -> Indexed(n),
    [r, g, ..rest] -> Rgb(r, g, rest.at_or(0, 0)),
  };
  let colored = if p.behind { { ..default_look(), background: Some(color) } }
  else { colored(color) };
  strip(paint(style_of(colors), { ..colored, bold: p.bold }, sample_text(p)))
}

fn paintings() -> gen::Gen<Painting> =
  gen::and_then(gen::list(gen::any_int()), |picks: List<Int>|
    gen::map4(
      gen::any_int(),
      gen::list(gen::any_int()),
      gen::bool(),
      gen::bool(),
      |colors: Int, parts: List<Int>, bold: Bool, behind: Bool|
        { picks: picks, colors: colors, parts: parts, bold: bold, behind: behind },
    ))

fn cuts() -> gen::Gen<SplitInput> =
  gen::map2(gen::list(gen::any_int()), gen::any_int(), |picks: List<Int>, at: Int|
    { picks: picks, at: at })

test "`strip` returns the original text from painted output, whichever styles and colour levels were used" {
  gen::check(paintings(), |x: Painting| agrees(painted_and_stripped, sample_text, x))
}

type TypedCase = { description: String, bytes: Bytes, events: List<Event> }

fn press(key: Key) -> Event = Pressed(chord(key))

fn pressed_with(key: Key, ctrl: Bool, alt: Bool, shift: Bool) -> Event =
  Pressed({ key: key, ctrl: ctrl, alt: alt, shift: shift })

