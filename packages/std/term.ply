    { description: "an empty paste", bytes: b"\x1b[200~\x1b[201~", events: [Pasted(b"")] },
    { description: "focus gained", bytes: b"\x1b[I", events: [Focused(true)] },
    { description: "focus lost", bytes: b"\x1b[O", events: [Focused(false)] },
    {
      description: "a size report",
      bytes: b"\x1b[8;24;80t",
      events: [Resized({ columns: 80, rows: 24 })],
    },
