      bytes: b"\x1b[?1;2c",
      events: [Unknown(b"\x1b[?1;2c")],
    },
    {
      description: "a sequence with an unknown end",
      bytes: b"\x1b[5x",
      events: [Unknown(b"\x1b[5x")],
    },
    { description: "a byte that starts no character", bytes: b"\xff", events: [Unknown(b"\xff")] },
    { description: "a character cut short", bytes: b"\xe4\xb8", events: [Unknown(b"\xe4\xb8")] },
    {
      description: "keys one after another",
      bytes: b"hi\x1b[A\r",
      events: [press(Character('h')), press(Character('i')), press(Up), press(Enter)],
    },
  ]

test "`decode` turns the bytes for {t.description} into the key event the case lists, with no bytes left over" for t: TypedCase in sequences(
  ) {
  let read = decode(t.bytes, true);
  assert_eq(read.events, t.events);
  assert_eq(read.rest, b"")
}

test "a sequence that has not all arrived waits for the rest, and is read once nothing more is coming" {
  let waiting = [b"\x1b", b"\x1b[", b"\x1b[1;", b"\x1b[200~half", b"\x1bO", b"\xe4\xb8"];
  waiting.fold((), |_: Unit, bytes: Bytes| {
    let read = decode(bytes, false);
    assert_eq(read.events, []);
    assert_eq(read.rest, bytes)
  });
  let after = decode(b"ab\x1b[1", false);
  assert_eq(after.events, [press(Character('a')), press(Character('b'))]);
  assert_eq(after.rest, b"\x1b[1");
  assert_eq(decode(after.rest.concat(b";5C"), false).events, [
    pressed_with(Right, true, false, false),
  ]);
  assert_eq(decode(b"\x1b[200~half", true).events, [Pasted(b"half")]);
  assert_eq(decode(b"\x1b[1;", true).events, [Unknown(b"\x1b[1;")])
}

type SplitInput = { picks: List<Int>, at: Int }

fn typed_bytes(picks: List<Int>) -> Bytes =
  Bytes::concat_all(
    picks.map(|p: Int|
      [b"\x1b", b"[", b"O", b"A", b"1", b";", b"~", b"a", b"\xc3", b"\xa9"].at_or(
        (p % 10 + 10) % 10,
        b"a",
      )),
  )

fn read_in_two(c: SplitInput) -> List<Event> / {abort.raise} = {
  let all = typed_bytes(c.picks);
  let n = all.len();
  let at = if n == 0 { 0 } else { (c.at % n + n) % n };
  let first = decode(all.slice(0, at), false);
  let second = decode(first.rest.concat(all.slice(at, n)), true);
  second.events.fold(first.events, |events: List<Event>, e: Event| events.push(e))
}

fn read_at_once(c: SplitInput) -> List<Event> / {abort.raise} =
  decode(typed_bytes(c.picks), true).events

test "typed input is decoded to the same events however it is split into chunks" {
  gen::check(cuts(), |x: SplitInput| agrees(read_in_two, read_at_once, x))
}

fn events_of(s: Screen, limit: Int) -> RunResult<List<Event>> / {abort.raise} =
  on_screen(s, || {
    let read = iterate(
      { pending: pending(), events: [] },
      64,
      |r: { pending: Pending, events: List<Event> }| {
        let next = next_event(r.pending, 1000, limit);
        match next.event {
          Some(e) -> Continue({ pending: next.pending, events: r.events.push(e) }),
          None -> if next.pending.ended { Stop(r.events) }
          else { Continue({ pending: next.pending, events: r.events }) },
        }
      },
    );
    read
  })

test "events are read as they arrive, and an escape with nothing after it is the Escape key" {
  let typed = [
    Some(b"a\x1b"),
    Some(b"[A"),
    None,
    Some(b"\x1b"),
    None,
    Some(b"\x1b[200~pas"),
    Some(b"ted\x1b[201~z"),
  ];
  let ran = events_of(with_input(screen(80, 24), typed), 4096);
  assert_eq(ran.value, [
    press(Character('a')),
    press(Up),
    press(Escape),
    Pasted(b"pasted"),
    press(Character('z')),
  ]);
  assert_eq(ran.screen.typed, [])
}

test "a sequence longer than a reader's limit is returned as far as it got" {
  let ran = events_of(
    with_input(screen(80, 24), [Some(b"\x1b[200~0123"), Some(b"4567"), Some(b"89")]),
    12,
  );
  assert_eq(ran.value, [Pasted(b"01234567"), press(Character('8')), press(Character('9'))])
}

test "`raw` switches the terminal back to cooked mode when the function it runs returns, panics, or is cut short by a handler that never resumes" {
  let returned = on_screen(screen(80, 24), || raw(|| term.mode(Raw)));
  assert_eq(returned.value, Some(Raw));
  assert_eq(returned.screen.modes, [Raw, Raw, Cooked]);
  assert_eq(returned.screen.mode, Cooked);
  let raised = on_screen(screen(80, 24), || {
    let ended: Result<Int, String> = try[abort.raise] { raw(|| panic("mid-key")) };
    ended
  });
  assert_eq(raised.value, Err("mid-key"));
  assert_eq(raised.screen.modes, [Raw, Cooked]);
  let timed_out = on_screen(screen(80, 24), ||
    handle {
      raw(|| Bytes::len(match term.input(1, -1) { Some(b) -> b, None -> b"" }))
    } with {
      term.mode(mode) -> term.mode(mode),
      term.input(_, _) resume k -> -1,
    });
  assert_eq(timed_out.value, -1);
  assert_eq(timed_out.screen.modes, [Raw, Cooked]);
  let silenced = on_screen({ ..screen(80, 24), mode: Silent }, || raw(|| 0));
  assert_eq(silenced.screen.modes, [Raw, Silent])
}

test "raw mode requires a terminal" {
  let piped = on_screen(no_screen(), || {
    let enter_mode: Result<Int, Stream> = try[tty.missing] { raw(|| 1) };
    enter_mode
  });
  assert_eq(piped.value, Err(Stdin));
  assert_eq(piped.screen.modes, [])
}

type SecretPrompt = { secret: Option<Bool>, screen: Screen, err: Bytes }

fn prompt_secret(
  s: Screen,
  fallback: SecretFallback,
  expected: String,
) -> SecretPrompt / {abort.raise, tty.missing, pipe.broken} = {
  let ran = process::over[proc](process::captured([]), ||
    on_screen(s, || read_secret[proc]("Password: ", fallback)));
  match ran.value {
    None -> panic("the prompt ended the program"),
    Some(at) ->
      {
        secret: match at.value { Some(s) -> Some(s.verify(expected)), None -> None },
        screen: at.screen,
        err: process::written_to(ran.captured, Stderr),
      },
  }
}

test "a secret is typed unseen, and the terminal echoes again after it" {
  let read = prompt_secret(with_secret_lines(screen(80, 24), ["hunter2"]), TypedOnly, "hunter2");
  assert_eq(read.secret, Some(true));
  assert_eq(read.screen.modes, [Silent, Cooked]);
  assert_eq(read.err, b"Password: \n");
  let ended = prompt_secret(screen(80, 24), TypedOnly, "");
  assert_eq(ended.secret, None);
  assert_eq(ended.screen.modes, [Silent, Cooked])
}

test "a secret is not read from a pipe unless the caller says a pipe will do" {
  let piped = with_secret_lines(no_screen(), ["from-a-script"]);
  let rejected: Result<SecretPrompt, Stream> = try[tty.missing] {
    prompt_secret(piped, TypedOnly, "")
  };
  assert_eq(rejected, Err(Stdin));
  let read = prompt_secret(piped, OrPiped, "from-a-script");
  assert_eq(read.secret, Some(true));
  assert_eq(read.screen.modes, []);
  assert_eq(read.err, b"")
}

test "the terminal echoes again when the read of a secret is cut short" {
  let cut = on_screen(with_secret_lines(screen(80, 24), ["never read"]), || {
    let ended: Result<Bool, String> = try[abort.raise] {
      handle {
        with_scope[term_silent](
          enter_mode(Silent),
          restore_mode,
        ) { was -> term.secret_line() == None }
      } with {
        term.mode(mode) -> term.mode(mode),
        term.secret_line() -> panic("interrupted"),
      }
    };
    ended
  });
  assert_eq(cut.value, Err("interrupted"));
  assert_eq(cut.screen.modes, [Silent, Cooked]);
  assert_eq(cut.screen.mode, Cooked)
}

test "a bar fills with its share, and a spinner turns" {
  assert_eq(bar(0, 10, 17), "[..........]   0%");
  assert_eq(bar(5, 10, 17), "[#####.....]  50%");
  assert_eq(bar(10, 10, 17), "[##########] 100%");
  assert_eq(bar(99, 10, 17), "[##########] 100%");
  assert_eq(bar(-3, 10, 17), "[..........]   0%");
  assert_eq(bar(1, 0, 17), "[##########] 100%");
  assert_eq(bar(1, 3, 7), "[]  33%");
  assert_eq(range(-1, 5).map(spinner), ["\\", "|", "/", "-", "\\", "|"])
}

fn step_bytes(steps: List<Step>) -> List<Bytes> = steps.map(|s: Step| s.bytes)

test "on a terminal a status is one line redrawn in place, no more often than its interval" {
  let w = writer(true, 12, Duration(100));
  let first = status_step(w, Instant(1000), "copying 1/3");
  let early = status_step(first.writer, Instant(1050), "copying 2/3");
  let later = status_step(early.writer, Instant(1100), "copying 3/3 of them all");
  let same = status_step(later.writer, Instant(1300), "copying 3/3 of them all");
  assert_eq(step_bytes([first, early, later, same]), [
    b"\r\x1b[Kcopying 1/3",
    b"",
    b"\r\x1b[Kcopying 3/3",
    b"",
  ]);
  let line = line_step(later.writer, "wrote a.txt");
  assert_eq(line.bytes, b"\r\x1b[Kwrote a.txt\n\r\x1b[Kcopying 3/3");
  let done = finish_step(line.writer);
  assert_eq(done.bytes, b"\r\x1b[K");
  assert_eq(line_step(done.writer, "done").bytes, b"done\n");
  assert_eq(finish_step(done.writer).bytes, b"")
}

test "when output is not a terminal, each status is written as its own line at most once per minimum interval, and the last status is written on finish" {
  let w = writer(false, 80, Duration(1000));
  let first = status_step(w, Instant(0), "1 of 3");
  let early = status_step(first.writer, Instant(10), "2 of 3");
  let line = line_step(early.writer, "wrote a.txt");
  let later = status_step(line.writer, Instant(1000), "3 of 3");
  let done = finish_step(later.writer);
  assert_eq(step_bytes([first, early, line, later, done]), [
    b"1 of 3\n",
    b"",
    b"wrote a.txt\n",
    b"3 of 3\n",
    b"",
  ]);
  let quick = finish_step(writer(false, 80, Duration(1000)));
  assert_eq(quick.bytes, b"");
  assert_eq(finish_step(early.writer).bytes, b"2 of 3\n");
  assert_eq(status_step(w, Instant(0), "").bytes, b"")
}

test "a status wider than the terminal's width is cut to fit it, and a status that fits keeps its colour" {
  let w = writer(true, 8, Duration(0));
  assert_eq(
    status_step(w, Instant(0), green(ansi(), "copying")).bytes,
    b"\r\x1b[K\x1b[32mcopying\x1b[0m",
  );
  assert_eq(status_step(w, Instant(0), green(ansi(), "copying it")).bytes, b"\r\x1b[Kcopying");
  let wide = writer(
    true,
    8,
    Duration(0),
    Some(|c: Char| if Int::of_char(c) > 0x2e80 { 2 } else { 1 }),
  );
  assert_eq(
    status_step(wide, Instant(0), "\u{4e16}\u{754c}\u{4e16}\u{754c}").bytes,
    Bytes::of_string("\r\u{1b}[K\u{4e16}\u{754c}\u{4e16}"),
  );
  assert_eq(status_step(writer(true, 0, Duration(0)), Instant(0), "anything").bytes, b"\r\x1b[K")
}

test "`stderr_writer` writes progress to standard error only, and redraws a status only after a minimum time has passed on `clock.now`" {
  let ran = process::over[proc](process::captured([]), ||
    on_screen(screen(40, 10), ||
      handle {
        let w = stderr_writer(Duration(100));
        let one = status[proc](w, bar(1, 2, 17));
        let two = say[proc](one, "half way");
        let three = status[proc](two, bar(2, 2, 17));
        let ended = finish[proc](three);
        ended.shown
      } with {
        var ticked = 0,
        clock.now() -> {
          ticked = ticked + 100;
          Instant(ticked)
        },
      }));
  assert_eq(
    process::written_to(ran.captured, Stderr),
    Bytes::concat_all([
      b"\r\x1b[K[#####.....]  50%",
      b"\r\x1b[Khalf way\n\r\x1b[K[#####.....]  50%",
      b"\r\x1b[K[##########] 100%",
      b"\r\x1b[K",
    ]),
  );
  assert_eq(process::written_to(ran.captured, Stdout), b"")
}

test "a stream that is no terminal gets its progress as lines" {
  let ran = process::over[proc](process::captured([]), ||
    on_screen(no_screen(), || {
      let w = stderr_writer(Duration(0));
      w.live || w.columns != 80
    }));
  assert_eq(ran.value, Some({ value: false, screen: no_screen() }))
}

test "a terminal reports which streams it is and how large it is" {
  let ran = on_screen({ ..screen(132, 43), terminals: [Stdin, Stderr] }, ||
    { streams: [Stdin, Stdout, Stderr].map(|s: Stream| term.is_terminal(s)), size: term.size() });
  assert_eq(ran.value.streams, [true, false, true]);
  assert_eq(ran.value.size, Some({ columns: 132, rows: 43 }))
}
