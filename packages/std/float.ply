//! Predicates, conversions and constants for a `Float`, beyond arithmetic.
//!
//! This module checks whether a value is a NaN, an infinity or finite. It also returns a value's
//! sign, whole part and absolute value, powers of two, and the special values of an IEEE-754
//! double. Every result is computed from the value's bits, so nothing here raises. Arithmetic on a
//! `Float` is in the prelude.

/// Whether the value is not a number.
pub fn Float::is_nan(f: Float) -> Bool = f != f

/// Whether the value is an infinity of either sign.
pub fn Float::is_infinite(f: Float) -> Bool = magnitude_bits(f) == infinity_bits()

/// Whether the value is neither a NaN nor an infinity.
pub fn Float::is_finite(f: Float) -> Bool = magnitude_bits(f) < infinity_bits()

/// Whether the value is negative or `-0.0`. A NaN has no sign, so this is false for one.
pub fn Float::is_sign_negative(f: Float) -> Bool = bits_of_float(f) < 0

/// The value with its sign bit cleared.
pub fn Float::abs(f: Float) -> Float = Float::of_bits(magnitude_bits(f))

/// `magnitude` with the sign of `sign`, including the sign of a zero. A NaN has no sign: as `sign`
/// it counts as positive, and as `magnitude` the result is the NaN.
pub fn Float::copy_sign(magnitude: Float, sign: Float) -> Float =
  Float::of_bits(magnitude_bits(magnitude) | bits_of_float(sign) & sign_bit())

/// Whether `a` and `b` differ by at most `relative` times the larger of their magnitudes, or by at
/// most `absolute`, whichever allows more, as in Python's `math.isclose`. Equal values are close,
/// including two infinities of the same sign. A NaN is close to nothing.
pub fn Float::is_close(a: Float, b: Float, relative: Float, absolute: Float) -> Bool =
  a == b
    || (a.is_finite() && b.is_finite()
    && (Float::abs(a - b) <= relative * a.abs() || Float::abs(a - b) <= relative * b.abs()
    || Float::abs(a - b) <= absolute))

/// The whole part, rounded toward zero. A NaN or an infinity returns itself.
pub fn Float::trunc(f: Float) -> Float = truncated(f, bits_of_float(f))

fn truncated(f: Float, bits: Int) -> Float = {
  let exponent = exponent_of(bits);
  if exponent >= 52 { f }
  else if exponent < 0 { Float::of_bits(bits & sign_bit()) }
  else { Float::of_bits(bits & ~low_bits(52 - exponent)) }
}

fn exponent_of(bits: Int) -> Int = (bits >>> 52 & 0x7FF) - 1023

fn low_bits(n: Int) -> Int = (1 << n) - 1

/// `2^k`. Returns infinity above the largest finite power, and zero below the smallest subnormal
/// one.
pub fn Float::pow2(k: Int) -> Float =
  if k > 1023 { Float::infinity() }
  else if k >= 0 - 1022 { Float::of_bits(k + 1023 << 52) }
  else if k >= 0 - 1074 { Float::of_bits(1 << k + 1074) }
  else { 0.0 }

/// The nearest `Float` to π.
pub fn Float::pi() -> Float = 3.141592653589793

/// The nearest `Float` to Euler's number.
pub fn Float::e() -> Float = 2.718281828459045

/// The nearest `Float` to 2π, a full turn in radians.
pub fn Float::tau() -> Float = 6.283185307179586

/// The NaN. Every NaN a program sees has the same bits as this one.
pub fn Float::nan() -> Float = Float::of_bits(0x7FF8_0000_0000_0000)

/// Positive infinity.
pub fn Float::infinity() -> Float = Float::of_bits(infinity_bits())

/// Negative infinity.
pub fn Float::neg_infinity() -> Float = Float::of_bits(infinity_bits() | sign_bit())

/// The greatest finite `Float`.
pub fn Float::max_value() -> Float = Float::of_bits(0x7FEF_FFFF_FFFF_FFFF)

fn infinity_bits() -> Int = 0x7FF0_0000_0000_0000

fn sign_bit() -> Int = 0x8000_0000_0000_0000

fn magnitude_bits(f: Float) -> Int = bits_of_float(f) & 0x7FFF_FFFF_FFFF_FFFF

test "NaN, the infinities and the finite numbers are distinguished" {
  assert(Float::nan().is_nan());
  assert(!Float::is_nan(1.5));
  assert(Float::infinity().is_infinite());
  assert(Float::neg_infinity().is_infinite());
  assert(!Float::max_value().is_infinite());
  assert(Float::max_value().is_finite());
  assert(!Float::nan().is_finite());
  assert(!Float::infinity().is_finite())
}

test "a float's sign is its top bit, so negative zero is negative and `abs` clears that bit" {
  assert(Float::is_sign_negative(-1.5));
  assert(!Float::is_sign_negative(0.0));
  assert(Float::of_bits(sign_bit()).is_sign_negative());
  assert_eq(Float::abs(-2.5), 2.5);
  assert_eq(bits_of_float(Float::of_bits(sign_bit()).abs()), 0)
}

test "a NaN is never negative, whatever its bit pattern" {
  assert(!Float::of_bits(0xFFF8_0000_0000_0001).is_sign_negative());
  assert(!Float::is_sign_negative(0.0 - Float::nan()));
  assert_eq(bits_of_float(Float::nan().copy_sign(-1.0)), bits_of_float(Float::nan()));
  assert_eq(bits_of_float(Float::of_bits(0xFFF0_0000_0000_0001).abs()), bits_of_float(Float::nan()))
}

test "a sign is copied onto a magnitude, zeros and infinities included" {
  assert_eq(Float::copy_sign(2.5, -1.0), -2.5);
  assert_eq(Float::copy_sign(-2.5, 1.0), 2.5);
  assert(Float::copy_sign(0.0, -3.0).is_sign_negative());
  assert(!Float::of_bits(sign_bit()).copy_sign(3.0).is_sign_negative());
  assert_eq(Float::infinity().copy_sign(Float::of_bits(sign_bit())), Float::neg_infinity())
}

test "`is_close` accepts two floats within a relative tolerance of the larger one or within an absolute tolerance" {
  assert(Float::is_close(1.0, 1.0 + 1e-12, 1e-9, 0.0));
  assert(!Float::is_close(1.0, 1.0 + 1e-6, 1e-9, 0.0));
  assert(Float::is_close(1e-20, 0.0, 1e-9, 1e-12));
  assert(!Float::is_close(1e-20, 0.0, 1e-9, 0.0));
  assert(Float::infinity().is_close(Float::infinity(), 0.0, 0.0));
  assert(!Float::infinity().is_close(Float::neg_infinity(), 1.0, 1e300));
  assert(!Float::infinity().is_close(Float::max_value(), 1.0, 1e300));
  assert(!Float::nan().is_close(Float::nan(), 1.0, 1.0))
}

test "`trunc` rounds toward zero and preserves the sign, including for negative zero" {
  assert_eq(Float::trunc(2.75), 2.0);
  assert_eq(Float::trunc(-2.75), -2.0);
  assert_eq(Float::trunc(0.5), 0.0);
  assert(Float::trunc(-0.5).is_sign_negative());
  assert_eq(Float::trunc(1.0e300), 1.0e300);
  assert(Float::nan().trunc().is_nan());
  assert_eq(Float::infinity().trunc(), Float::infinity())
}

test "pow2 spans the normal and subnormal range and saturates past it" {
  assert_eq(Float::pow2(0), 1.0);
  assert_eq(Float::pow2(3), 8.0);
  assert_eq(Float::pow2(0 - 2), 0.25);
  assert_eq(bits_of_float(Float::pow2(0 - 1074)), 1);
  assert_eq(Float::pow2(0 - 1075), 0.0);
  assert_eq(Float::pow2(1024), Float::infinity())
}

test "`pi`, `e` and `tau` each return the float nearest to the true constant" {
  assert_eq(bits_of_float(Float::pi()), 0x4009_21FB_5444_2D18);
  assert_eq(bits_of_float(Float::e()), 0x4005_BF0A_8B14_5769);
  assert_eq(bits_of_float(Float::tau()), 0x4019_21FB_5444_2D18);
  assert_eq(Float::tau(), 2.0 * Float::pi())
}
