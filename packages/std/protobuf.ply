//! The Protocol Buffers wire format: tags, varints, zigzag, the two fixed widths and
//! length-delimited fields, written and read by field number.
//!
//! This is the encoding only, with no schema. A writer writes the fields it chooses, in the order
//! it chooses. A reader reads a message as the list of its fields. Each field has its number, the
//! offset of its tag, and its payload bytes, whose extent is set by the wire type. The function
//! that reads a payload decides what it means: whether a varint is an `int64`, a `sint64` or a
//! `bool`, and whether a delimited payload is text, bytes, a message or a packed run. A reader
//! skips a field number it does not know, which is how a message gains fields without breaking its
//! readers.
//!
//! `fields` takes a `Message`: bytes together with the `Limits` they are read under. Only `message`
//! and `message_of` create one. A nested message is a range of its parent's bytes and is never
//! copied, so every offset in an error counts from the start of the outermost input. A reader
//! fails, reporting why and at which byte, on: an input longer than the limit, a message nested
//! deeper than the limit, a truncated field, a varint longer than ten bytes or 64 bits, a field
//! number of zero or wider than 29 bits, a group (wire types 3 and 4, which proto3 never writes),
//! and the two undefined wire types. `fields` and the field readers raise `protobuf.fail`; `parse`
//! returns the error as an `Err`.
//!
//! There is no 32-bit `float`, since no `Float` has that width. There is no `.proto` reader either:
//! the code that encodes a message writes its field numbers.

import std.bin (zigzag_decode, zigzag_encode)
import std.bytes (u32_le, u64_le)
import std.gen

/// `n` as a base-128 varint, least significant group first: its 64 bits read as unsigned, so a
/// negative number takes ten bytes, as an `int64` does.
pub fn varint(n: Int) -> Bytes = varint_groups(n, 10)

fn varint_groups(n: Int, left: Int) -> Bytes =
  if left <= 1 || n >>> 7 == 0 { byte_of_int(n & 0x7F) }
  else { byte_of_int(n & 0x7F | 0x80).concat(varint_groups(n >>> 7, left - 1)) }

/// The four wire types proto3 writes, as the number a tag carries in its low three bits.
pub type WireType =
  | VarintWire
  /// Eight bytes, least significant first.
  | Fixed64Wire
  /// A varint length and that many bytes.
  | DelimitedWire
  /// Four bytes, least significant first.
  | Fixed32Wire

fn wire_number(w: WireType) -> Int =
  match w { VarintWire -> 0, Fixed64Wire -> 1, DelimitedWire -> 2, Fixed32Wire -> 5 }

/// Returns the greatest field number a tag can encode, which is 29 bits wide.
pub fn max_field_number() -> Int = 536870911

/// A field's tag. Raises for a field number below one or above `max_field_number`, which no message
/// has.
pub fn tag(field: Int, wire: WireType) -> Bytes / {abort.raise} =
  if field < 1 || field > max_field_number() {
    panic("a field number is from 1 to 536870911, and this one is " ++ field.to_string())
  } else { varint(field << 3 | wire_number(wire)) }

/// An `int32`, `int64`, `uint32`, `uint64` or enum field: the 64 bits of `n` as a varint.
pub fn int_field(field: Int, n: Int) -> Bytes / {abort.raise} =
  tag(field, VarintWire).concat(varint(n))

/// A `sint32` or `sint64` field: the varint of `n`'s zigzag encoding, as `std.bin`'s
/// `zigzag_encode` computes it.
pub fn sint_field(field: Int, n: Int) -> Bytes / {abort.raise} = int_field(field, zigzag_encode(n))

/// A `bool` field.
pub fn bool_field(field: Int, b: Bool) -> Bytes / {abort.raise} =
  tag(field, VarintWire).concat(if b { b"\x01" } else { b"\x00" })

/// A `fixed64` field.
pub fn fixed64_field(field: Int, n: U64) -> Bytes / {abort.raise} =
  tag(field, Fixed64Wire).concat(fixed64(n))

/// An `sfixed64` field.
pub fn sfixed64_field(field: Int, n: Int) -> Bytes / {abort.raise} =
  tag(field, Fixed64Wire).concat(u64_le(n))

/// A `double` field: the bits of `f`.
pub fn double_field(field: Int, f: Float) -> Bytes / {abort.raise} =
  sfixed64_field(field, bits_of_float(f))

/// A `fixed32` field.
pub fn fixed32_field(field: Int, n: U32) -> Bytes / {abort.raise} =
  tag(field, Fixed32Wire).concat(u32_le(Int::of_u32(n)))

/// A `bytes` field.
pub fn bytes_field(field: Int, b: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([tag(field, DelimitedWire), varint(b.len()), b])

/// A `string` field: the text's UTF-8.
pub fn string_field(field: Int, s: String) -> Bytes / {abort.raise} =
  bytes_field(field, Bytes::of_string(s))

/// A field containing a message already encoded as `body`. It is written even when `body` is empty,
/// which is how a message marks a submessage as present but empty.
pub fn message_field(field: Int, body: Bytes) -> Bytes / {abort.raise} = bytes_field(field, body)

/// A repeated varint field, packed: one delimited payload of the numbers in order. No bytes for an
/// empty list, as proto3 writes it.
pub fn packed_ints(field: Int, ns: List<Int>) -> Bytes / {abort.raise} =
  packed(field, ns.map(varint))

/// A repeated `fixed64` field, packed.
pub fn packed_fixed64(field: Int, ns: List<U64>) -> Bytes / {abort.raise} =
  packed(field, ns.map(fixed64))

/// A repeated `double` field, packed.
pub fn packed_doubles(field: Int, fs: List<Float>) -> Bytes / {abort.raise} =
  packed(field, fs.map(|f: Float| u64_le(bits_of_float(f))))

fn packed(field: Int, items: List<Bytes>) -> Bytes / {abort.raise} =
  if items.len() == 0 { b"" } else { bytes_field(field, Bytes::concat_all(items)) }

fn fixed64(n: U64) -> Bytes / {abort.raise} =
  u32_le(Int::of_u64(n & 0xFFFF_FFFFu64)).concat(u32_le(Int::of_u64(n >>> 32)))

/// Why a reader failed.
pub type ErrorKind =
  /// The input ends inside a field, or a length counts more bytes than its message has left.
  | Truncated
  /// A varint of more than ten bytes, or one whose tenth byte sets bits past the sixty-fourth.
  | Overflow
  /// Wire type 3 or 4: a group, which proto2 wrote and proto3 does not.
  | Group
  /// Wire type 6 or 7, neither of which is defined. The `Int` is the wire type number that was
  /// found.
  | UnknownWireType(Int)
  /// A field number of zero, or one past `max_field_number`.
  | BadFieldNumber
  /// A message nested deeper than `Limits.depth`.
  | TooDeep
  /// An input longer than `Limits.length`.
  | TooLong
  /// A field read as a type that does not match its wire type, such as a varint read as a message.
  | WrongWireType
  /// A `string` field that is not UTF-8.
  | NotUtf8
  /// A packed run of fixed-width numbers whose length in bytes is not a multiple of the width of
  /// one number.
  | UnevenPackedLength

/// A reading error, and the offset in the outermost input of the byte the reader was at.
pub type Error = new { at: Int, reason: ErrorKind }

/// The effect this module's readers raise when they fail.
pub effect protobuf {
  /// The bytes are not a message a reader accepts, or a field is not the type it was read as.
  raise fail(e: Error)
}

fn fail<a>(at: Int, reason: ErrorKind) -> a / {protobuf.fail} =
  protobuf.fail({ at: at, reason: reason })

/// The limits a reader enforces on an input.
pub type Limits = new {
  /// How many messages may nest inside the outermost one.
  depth: Int,
  /// The largest input, in bytes, that a reader accepts.
  length: Int,
}

/// A message's bytes, as a range of the input they were read from.
pub opaque type Message = new { data: Bytes, from: Int, to: Int, room: Int }

/// The contents of a field, decoded according to the field's wire type.
pub type Value =
  /// The 64 bits a varint encodes.
  | Varint(Int)
  | Fixed64(U64)
  | Delimited(Message)
  | Fixed32(U32)

/// One field of a message: its number, the offset of its tag, and its payload.
pub type Field = new { number: Int, at: Int, value: Value }

/// `data` as a message to read under `limits`. Fails for `data` longer than `limits.length`.
pub fn message(data: Bytes, limits: Limits) -> Message / {protobuf.fail} =
  if data.len() > limits.length { fail(limits.length, TooLong) }
  else { { data: data, from: 0, to: data.len(), room: limits.depth } }

/// Returns the bytes that make up `m`, without the surrounding input.
pub fn payload(m: Message) -> Bytes / {abort.raise} = m.data.slice(m.from, m.to)

/// Where a message starts in the outermost input.
pub fn offset(m: Message) -> Int = m.from

/// Every field of `m`, in the order they appear; a field written twice appears twice. Fails for a
/// message nested deeper than the limit it was made under.
pub fn fields(m: Message) -> List<Field> / {protobuf.fail, abort.raise} =
  if m.room < 0 { fail(m.from, TooDeep) } else {
    iterate(
      { at: m.from, accumulator: [] },
      m.to - m.from + 1,
      |s: { at: Int, accumulator: List<Field> }|
        if s.at >= m.to { Stop(s.accumulator) } else {
          let read = field_at(m, s.at);
          Continue({ at: read.next, accumulator: s.accumulator.push(read.field) })
        },
    )
  }

/// The fields of `data` read as one message, or why it is not one.
pub fn parse(data: Bytes, limits: Limits) -> Result<List<Field>, Error> / {abort.raise} =
  try { fields(message(data, limits)) }

type FieldRead = { field: Field, next: Int }

type VarintRead = { value: Int, next: Int }

fn field_at(m: Message, at: Int) -> FieldRead / {protobuf.fail, abort.raise} = {
  let key = varint_at(m, at);
  let number = key.value >>> 3;
  if number < 1 || number > max_field_number() { fail(at, BadFieldNumber) } else {
    match key.value & 7 {
      0 -> {
        let v = varint_at(m, key.next);
        { field: { number: number, at: at, value: Varint(v.value) }, next: v.next }
      },
      1 -> {
        let low = fixed32_at(m, key.next);
        let high = fixed32_at(m, key.next + 4);
        {
          field: {
            number: number,
            at: at,
            value: Fixed64(U64::of_int(high) << 32 | U64::of_int(low)),
          },
          next: key.next + 8,
        }
      },
      2 -> delimited_at(m, number, at, key.next),
      5 ->
        {
          field: { number: number, at: at, value: Fixed32(U32::of_int(fixed32_at(m, key.next))) },
          next: key.next + 4,
        },
      3 | 4 -> fail(at, Group),
      wire -> fail(at, UnknownWireType(wire)),
    }
  }
}

fn delimited_at(
  m: Message,
  number: Int,
  at: Int,
  from: Int,
) -> FieldRead / {protobuf.fail, abort.raise} = {
  let length = varint_at(m, from);
  if length.value < 0 || length.value > m.to - length.next { fail(from, Truncated) } else {
    let inner: Message = {
      data: m.data,
      from: length.next,
      to: length.next + length.value,
      room: m.room - 1,
    };
    { field: { number: number, at: at, value: Delimited(inner) }, next: length.next + length.value }
  }
}

fn fixed32_at(m: Message, at: Int) -> Int / {protobuf.fail} =
  if at + 4 > m.to { fail(at, Truncated) }
  else { match m.data.u32_at(at) { Some(n) -> n, None -> fail(at, Truncated) } }

fn varint_at(m: Message, at: Int) -> VarintRead / {protobuf.fail, abort.raise} =
  iterate({ i: 0, value: 0 }, 11, |s: { i: Int, value: Int }|
    if at + s.i >= m.to { fail(at + s.i, Truncated) }
    else if s.i >= 10 { fail(at, Overflow) } else {
      let b = m.data.at(at + s.i);
      if s.i == 9 && b > 1 { fail(at, Overflow) } else {
        let value = s.value | (b & 0x7F) << 7 * s.i;
        if b < 0x80 { Stop({ value: value, next: at + s.i + 1 }) }
        else { Continue({ i: s.i + 1, value: value }) }
      }
    })

/// An `int32`, `int64`, `uint64` or enum field: the 64 bits its varint encodes.
pub fn int_of(f: Field) -> Int / {protobuf.fail} =
  match f.value { Varint(n) -> n, _ -> fail(f.at, WrongWireType) }

/// Returns the value of a `sint32` or `sint64` field, zigzag-decoding the varint into a signed
/// integer.
pub fn sint_of(f: Field) -> Int / {protobuf.fail} = zigzag_decode(int_of(f))

/// A `bool` field: any varint but zero is true.
pub fn bool_of(f: Field) -> Bool / {protobuf.fail} = int_of(f) != 0

/// Returns the low 32 bits of the field's varint. Protobuf readers discard the higher bits of a
/// `uint32` that was written with more than 32 bits.
pub fn uint32_of(f: Field) -> U32 / {protobuf.fail, abort.raise} =
  U32::of_int(int_of(f) & 0xFFFF_FFFF)

/// A `fixed64` field.
pub fn fixed64_of(f: Field) -> U64 / {protobuf.fail} =
  match f.value { Fixed64(n) -> n, _ -> fail(f.at, WrongWireType) }

/// Returns the value of an `sfixed64` field, reading its 64 bits as a signed integer.
pub fn sfixed64_of(f: Field) -> Int / {protobuf.fail, abort.raise} = signed(fixed64_of(f))

/// A `double` field.
pub fn double_of(f: Field) -> Float / {protobuf.fail, abort.raise} = Float::of_bits(sfixed64_of(f))

/// A `fixed32` field.
pub fn fixed32_of(f: Field) -> U32 / {protobuf.fail} =
  match f.value { Fixed32(n) -> n, _ -> fail(f.at, WrongWireType) }

/// A field containing a message, to pass to `fields`.
pub fn message_of(f: Field) -> Message / {protobuf.fail} =
  match f.value { Delimited(m) -> m, _ -> fail(f.at, WrongWireType) }

/// A `bytes` field.
pub fn bytes_of(f: Field) -> Bytes / {protobuf.fail, abort.raise} = payload(message_of(f))

/// A `string` field. Fails for bytes that are not UTF-8, with the error at the payload's first
/// byte.
pub fn string_of(f: Field) -> String / {protobuf.fail, abort.raise} = {
  let m = message_of(f);
  let raw = payload(m);
  if raw.is_utf8() { String::of_bytes(raw) } else { fail(m.from, NotUtf8) }
}

/// The numbers in one occurrence of a repeated varint field: a packed run, or the single number of
/// an unpacked occurrence. A reader accepts either, whichever the writer chose.
pub fn ints_of(f: Field) -> List<Int> / {protobuf.fail, abort.raise} =
  match f.value {
    Varint(n) -> [n],
    Delimited(m) ->
      iterate(
        { at: m.from, accumulator: [] },
        m.to - m.from + 1,
        |s: { at: Int, accumulator: List<Int> }|
          if s.at >= m.to { Stop(s.accumulator) } else {
            let v = varint_at(m, s.at);
            Continue({ at: v.next, accumulator: s.accumulator.push(v.value) })
          },
      ),
    _ -> fail(f.at, WrongWireType),
  }

/// The numbers in one occurrence of a repeated `fixed64` field, packed or not.
pub fn fixed64s_of(f: Field) -> List<U64> / {protobuf.fail, abort.raise} =
  match f.value {
    Fixed64(n) -> [n],
    Delimited(m) -> if (m.to - m.from) % 8 != 0 { fail(m.from, UnevenPackedLength) } else {
      range(0, (m.to - m.from) / 8).map(|i: Int|
        U64::of_int(fixed32_at(m, m.from + 8 * i + 4)) << 32
          | U64::of_int(fixed32_at(m, m.from + 8 * i)))
    },
    _ -> fail(f.at, WrongWireType),
  }

/// The numbers in one occurrence of a repeated `double` field, packed or not.
pub fn doubles_of(f: Field) -> List<Float> / {protobuf.fail, abort.raise} =
  fixed64s_of(f).map(|n: U64| Float::of_bits(signed(n)))

fn signed(n: U64) -> Int / {abort.raise} =
  Int::of_u64(n >>> 32) << 32 | Int::of_u64(n & 0xFFFF_FFFFu64)

fn generous() -> Limits = { depth: 16, length: 1048576 }

fn hex(b: Bytes) -> String / {abort.raise} = b.hex_of()

fn read(data: Bytes) -> List<Field> / {protobuf.fail, abort.raise} =
  fields(message(data, generous()))

fn single_field(data: Bytes) -> Field / {protobuf.fail, abort.raise} =
  match read(data) { [f] -> f, _ -> panic("expected one field") }

fn error_of(text: String, limits: Limits) -> Option<Error> / {abort.raise} =
  match parse(Bytes::of_hex(text), limits) { Ok(_) -> None, Err(e) -> Some(e) }

type EncodingExample = { name: String, bytes: Bytes, hex: String }

fn encoding_examples() -> List<EncodingExample> / {abort.raise} =
  [
    { name: "150 is two groups of seven bits", bytes: varint(150), hex: "9601" },
    { name: "a varint field of 150", bytes: int_field(1, 150), hex: "089601" },
    { name: "a string field", bytes: string_field(2, "testing"), hex: "120774657374696e67" },
    { name: "a message in a field", bytes: message_field(3, int_field(1, 150)), hex: "1a03089601" },
    {
      name: "a packed run of varints",
      bytes: packed_ints(6, [3, 270, 86942]),
      hex: "3206038e029ea705",
    },
    {
      name: "a negative int64 takes ten bytes",
      bytes: int_field(1, -2),
      hex: "08feffffffffffffffff01",
    },
    { name: "a sint64 of -500 is its zigzag", bytes: sint_field(1, -500), hex: "08e707" },
    {
      name: "a fixed32 holding the float 25.4",
      bytes: fixed32_field(5, 0x41CB_CCCDu32),
      hex: "2dcdcccb41",
    },
    { name: "a double of 25.4", bytes: double_field(1, 25.4), hex: "096666666666663940" },
    { name: "a bool", bytes: bool_field(1, true), hex: "0801" },
    { name: "an empty message is still written", bytes: message_field(4, b""), hex: "2200" },
    { name: "an empty packed run is not", bytes: packed_ints(6, []), hex: "" },
    {
      name: "a field number past fifteen takes a two-byte tag",
      bytes: int_field(16, 1),
      hex: "800101",
    },
  ]

test "the protobuf encoding guide example `{c.name}` encodes to the hex bytes the guide lists" for c: EncodingExample in encoding_examples(
  ) { assert_eq(hex(c.bytes), c.hex) }

type Zigzag = { number: Int, encoded: Int }

fn zigzag_cases() -> List<Zigzag> =
  [
    { number: 0, encoded: 0 },
    { number: -1, encoded: 1 },
    { number: 1, encoded: 2 },
    { number: -2, encoded: 3 },
    { number: 2147483647, encoded: 4294967294 },
    { number: -2147483648, encoded: 4294967295 },
    { number: 0x7FFF_FFFF_FFFF_FFFF, encoded: -2 },
  ]

test "zigzag of {c.number}" for c: Zigzag in zigzag_cases() {
  assert_eq(zigzag_encode(c.number), c.encoded);
  assert_eq(zigzag_decode(c.encoded), c.number)
}

test "a varint field reads back, whatever its sign" {
  gen::check(gen::any_int(), |n: Int| { (try { int_of(single_field(int_field(1, n))) }) == Ok(n) })
}

test "a packed run reads back as the numbers it was written from" {
  gen::check2(gen::list(gen::any_int()), gen::list(gen::u64()), |ns: List<Int>, wide: List<U64>| {
    (try {
        read(packed_ints(1, ns)).fold([], |accumulator: List<Int>, f: Field|
          ints_of(f).fold(accumulator, |inner: List<Int>, n: Int| inner.push(n)))
      })
      == Ok(ns)
      && (try {
        read(packed_fixed64(2, wide)).fold([], |accumulator: List<U64>, f: Field|
          fixed64s_of(f).fold(accumulator, |inner: List<U64>, n: U64| inner.push(n)))
      })
      == Ok(wide)
  })
}

test "reading a bytes field followed by an integer field returns both field numbers correctly, whatever bytes the first field contains" {
  gen::check3(gen::any_int(), gen::bytes(), gen::any_int(), |k: Int, b: Bytes, n: Int| {
    (try {
        read(bytes_field(to_field_number(k), b).concat(int_field(to_field_number(k), n))).map(
          |f: Field| f.number,
        )
      })
      == Ok([to_field_number(k), to_field_number(k)])
  })
}

fn to_field_number(k: Int) -> Int = 1 + (k & 536870910)

test "a reader accepts a repeated number packed or one at a time" {
  let unpacked = int_field(6, 3).concat(int_field(6, 270));
  let packed = packed_ints(6, [3, 270]);
  let numbers = |data: Bytes|
    read(data).fold([], |accumulator: List<Int>, f: Field|
      ints_of(f).fold(accumulator, |inner: List<Int>, n: Int| inner.push(n)));
  assert_eq(try { numbers(unpacked) }, Ok([3, 270]));
  assert_eq(try { numbers(packed) }, Ok([3, 270]));
  let doubles = double_field(7, 1.5).concat(packed_doubles(7, [2.5, -0.5]));
  assert_eq(
    try {
      read(doubles).fold([], |accumulator: List<Float>, f: Field|
        doubles_of(f).fold(accumulator, |inner: List<Float>, x: Float| inner.push(x)))
    },
    Ok([1.5, 2.5, -0.5]),
  )
}

test "a reader skips a field it does not know, whatever its wire type" {
  let data = Bytes::concat_all([
    int_field(1, 7),
    fixed64_field(90, 5u64),
    bytes_field(91, b"\xff\xfe"),
    fixed32_field(92, 5u32),
    string_field(2, "kept"),
  ]);
  let named = try {
    read(data).fold({ a: 0, b: "" }, |accumulator: { a: Int, b: String }, f: Field|
      match f.number {
        1 -> { ..accumulator, a: int_of(f) },
        2 -> { ..accumulator, b: string_of(f) },
        _ -> accumulator,
      })
  };
  assert_eq(named, Ok({ a: 7, b: "kept" }))
}

test "a nested message is read in place, and its offsets count from the outermost input" {
  let inner = int_field(1, 150).concat(string_field(2, "x"));
  let outer = string_field(1, "pad").concat(message_field(3, inner));
  let read_inner = try {
    match read(outer) {
      [_, f] -> fields(message_of(f)).map(|g: Field| g.at),
      _ -> panic("expected two fields"),
    }
  };
  assert_eq(read_inner, Ok([7, 10]));
  assert_eq(try { offset(message_of(single_field(message_field(3, inner)))) }, Ok(2))
}

type ErrorCase = { name: String, hex: String, at: Int, reason: ErrorKind }

fn error_cases() -> List<ErrorCase> =
  [
    { name: "a tag and no payload", hex: "08", at: 1, reason: Truncated },
    { name: "a varint that never ends", hex: "08ffff", at: 3, reason: Truncated },
    { name: "a varint of eleven bytes", hex: "08ffffffffffffffffffff01", at: 1, reason: Overflow },
    { name: "a varint past 64 bits", hex: "08ffffffffffffffffff02", at: 1, reason: Overflow },
    { name: "a length past the end", hex: "120574657374", at: 1, reason: Truncated },
    { name: "a fixed64 cut short", hex: "0901020304", at: 5, reason: Truncated },
    { name: "a fixed32 cut short", hex: "2d0102", at: 1, reason: Truncated },
    { name: "field number zero", hex: "0001", at: 0, reason: BadFieldNumber },
    { name: "a start group", hex: "0b", at: 0, reason: Group },
    { name: "an end group", hex: "0c", at: 0, reason: Group },
    { name: "wire type six", hex: "0e", at: 0, reason: UnknownWireType(6) },
    { name: "wire type seven", hex: "0f", at: 0, reason: UnknownWireType(7) },
  ]

test "`error_of` rejects the malformed protobuf input `{c.name}` with the expected position and reason" for c: ErrorCase in error_cases(
  ) { assert_eq(error_of(c.hex, generous()), Some({ at: c.at, reason: c.reason })) }

test "an input past the length limit is rejected before any of it is read" {
  let limits: Limits = { depth: 4, length: 3 };
  assert_eq(error_of("089601", limits), None);
  assert_eq(error_of("08960108", limits), Some({ at: 3, reason: TooLong }))
}

fn nested(levels: Int) -> Bytes / {abort.raise} =
  range(0, levels).fold(int_field(1, 1), |body: Bytes, _: Int| message_field(2, body))

fn deepest(m: Message, left: Int) -> Int / {protobuf.fail, abort.raise} =
  if left <= 0 { 0 } else {
    fields(m).fold(0, |sum: Int, f: Field|
      match f.number { 1 -> sum + int_of(f), _ -> sum + deepest(message_of(f), left - 1) })
  }

test "a message nested past the depth limit is rejected where the limit ran out" {
  let limits: Limits = { depth: 3, length: 1024 };
  assert_eq(try { deepest(message(nested(3), limits), 16) }, Ok(1));
  assert_eq(try { deepest(message(nested(4), limits), 16) }, Err({ at: 8, reason: TooDeep }))
}

test "a field read as a type its wire type cannot frame is rejected at its tag" {
  assert_eq(
    try { offset(message_of(single_field(int_field(1, 5)))) },
    Err({ at: 0, reason: WrongWireType }),
  );
  assert_eq(
    try { int_of(single_field(string_field(1, "x"))) },
    Err({ at: 0, reason: WrongWireType }),
  );
  assert_eq(
    try { fixed64_of(single_field(fixed32_field(1, 1u32))) },
    Err({ at: 0, reason: WrongWireType }),
  );
  assert_eq(
    try { string_of(single_field(bytes_field(1, b"\xff"))) },
    Err({ at: 2, reason: NotUtf8 }),
  );
  assert_eq(
    try { fixed64s_of(single_field(bytes_field(1, b"\x01\x02\x03"))) },
    Err({ at: 2, reason: UnevenPackedLength }),
  )
}

test "`read` on malformed input inside a spawned task fails with the same rejection that `parse` returns" {
  let got = simulate {
    let t = task.spawn(|| try { read(Bytes::of_hex("0b")) });
    task.join(t)
  };
  assert_eq(result_rejection(got), Some({ at: 0, reason: Group }))
}

fn result_rejection(r: Result<List<Field>, Error>) -> Option<Error> =
  match r { Ok(_) -> None, Err(e) -> Some(e) }
