//! A set of elements of one ordered type, each stored once, in sorted order.
//!
//! The set literal `#[a, b]` builds a `Set`, and `show` writes a set back as that literal. Elements
//! are stored in `compare` order, so `==`, `compare`, `digest` and `Set::elements` give the same
//! results whatever order the elements were inserted in. A signature that names `Set<a>` requires
//! `derivable(ord, a)` without writing it. `Set::map`, `Set::filter`, `Set::fold`, `Set::min` and
//! `Set::max` have the same names as the prelude's list functions, so call them with method syntax:
//! `s.map(f)`.
//!
//! The compiler imports this module automatically into any module that writes a set literal, under
//! a name that source code cannot write. This module therefore writes no set literals of its own.
//!
//! Updating a set that has only one reference changes it in place, as for a map. Operations on two
//! sets iterate over the smaller set and look each element up in the larger, so each takes as many
//! steps as the smaller set has elements. `Set::min`, `Set::max` and `Set::between` read one path
//! of the set's tree, however large the set is.

import std.gen
import std.gen (Gen)
import std.laws (agrees, inverse, monoid)
import std.list
import std.map
import std.map (Bound, Excluded, Included, Unbounded)
import std.show
import std.string
import std.value (render_all, shown)

/// A set of `a`, which the literal `#[a, b]` writes.
pub opaque type Set<a> = | Set(Map<a, Unit>)

key for Set by items

show for Set by literal_text

fn items<a>(s: Set<a>) -> Map<a, Unit> = match s { Set(m) -> m }

fn literal_text<a>(s: Set<a>) -> String =
  "#["
    ++ String::join(
      items(s).fold([], |accumulator: List<String>, x: a, _: Unit|
        accumulator.push(render_all(shown(x)))),
      ", ",
    )
    ++ "]"

/// The set with nothing in it.
pub fn Set::empty<a>() -> Set<a> = Set(Map::new())

/// Whether the set is empty.
pub fn Set::is_empty<a>(s: Set<a>) -> Bool = items(s).len() == 0

/// How many elements the set holds.
pub fn Set::size<a>(s: Set<a>) -> Int = items(s).len()

/// Whether `x` is in the set.
pub fn Set::contains<a>(s: Set<a>, x: a) -> Bool = items(s).contains(x)

/// `s` with `x` added. If `x` is already in the set, the result is `s` unchanged.
pub fn Set::insert<a>(s: Set<a>, x: a) -> Set<a> = match s { Set(m) -> Set(m.insert(x, ())) }

/// `s` without `x`. If `x` is absent, the result is `s` unchanged.
pub fn Set::remove<a>(s: Set<a>, x: a) -> Set<a> = match s { Set(m) -> Set(m.remove(x)) }

/// The elements, in order.
pub fn Set::elements<a>(s: Set<a>) -> List<a> = items(s).keys()

/// The set of the elements of `xs`.
pub fn Set::of_list<a>(xs: List<a>) -> Set<a> = Set(with_from(Map::new(), xs, 0))

fn with_from<a>(m: Map<a, Unit>, xs: List<a>, i: Int) -> Map<a, Unit>
  where derivable(ord, a)
= match xs.at(i) { Some(x) -> with_from(m.insert(x, ()), xs, i + 1), None -> m }

/// The least element, or `None` for the empty set.
pub fn Set::min<a>(s: Set<a>) -> Option<a> =
  match items(s).first() { Some(least) -> Some(least.key), None -> None }

/// The greatest element, or `None` for the empty set.
pub fn Set::max<a>(s: Set<a>) -> Option<a> =
  match items(s).last() { Some(greatest) -> Some(greatest.key), None -> None }

/// The elements from `lo` to `hi`, each end included or excluded as its bound specifies. The result
/// shares as much of its structure with `s` as it can.
pub fn Set::between<a>(s: Set<a>, lo: Bound<a>, hi: Bound<a>) -> Set<a> =
  Set(items(s).between(lo, hi))

/// Folds `step` over the elements in order, starting from `init`. Each call gets the result of the
/// previous one.
pub fn Set::fold<a, b | e>(s: Set<a>, init: b, step: (b, a) -> b / e cost k) -> b / e =
  folded(items(s), init, step)

fn folded<a, b | e>(m: Map<a, Unit>, init: b, step: (b, a) -> b / e cost k) -> b / e
  where derivable(ord, a)
  cost m.len() * k
= m.fold(init, |accumulator: b, x: a, _: Unit| step(accumulator, x))

/// The set of `f`'s results for each element. It is smaller than `s` when `f` returns the same
/// value for two elements.
pub fn Set::map<a, b | e>(s: Set<a>, f: (a) -> b / e cost k) -> Set<b> / e =
  Set(mapped(items(s), f))

fn mapped<a, b | e>(m: Map<a, Unit>, f: (a) -> b / e cost k) -> Map<b, Unit> / e
  where derivable(ord, a), derivable(ord, b)
  cost m.len() * k
= m.fold(Map::new(), |accumulator: Map<b, Unit>, x: a, _: Unit| accumulator.insert(f(x), ()))

/// The elements for which `keep` returns true.
pub fn Set::filter<a | e>(s: Set<a>, keep: (a) -> Bool / e cost k) -> Set<a> / e =
  Set(filtered(items(s), keep))

fn filtered<a | e>(m: Map<a, Unit>, keep: (a) -> Bool / e cost k) -> Map<a, Unit> / e
  where derivable(ord, a)
  cost m.len() * k
=
  m.fold(Map::new(), |accumulator: Map<a, Unit>, x: a, _: Unit|
    if keep(x) { accumulator.insert(x, ()) } else { accumulator })

/// The elements for which `ok` returns true, and the rest. `ok` is called once per element.
pub fn Set::partition<a | e>(
  s: Set<a>,
  ok: (a) -> Bool / e cost k,
) -> { yes: Set<a>, no: Set<a> } / e = {
  let split = partitioned(items(s), ok);
  { yes: Set(split.yes), no: Set(split.no) }
}

fn partitioned<a | e>(
  m: Map<a, Unit>,
  ok: (a) -> Bool / e cost k,
) -> { yes: Map<a, Unit>, no: Map<a, Unit> } / e
  where derivable(ord, a)
  cost m.len() * k
=
  m.fold(
    { yes: Map::new(), no: Map::new() },
    |accumulator: { yes: Map<a, Unit>, no: Map<a, Unit> }, x: a, _: Unit| {
      let yes = accumulator.yes;
      let no = accumulator.no;
      if ok(x) { { yes: yes.insert(x, ()), no: no } } else { { yes: yes, no: no.insert(x, ()) } }
    },
  )

/// Whether `ok` returns true for some element. It calls `ok` in order and stops at the first true.
/// `false` for the empty set.
pub fn Set::any<a | e>(s: Set<a>, ok: (a) -> Bool / e cost k) -> Bool / e = any_in(items(s), ok)

fn any_in<a | e>(m: Map<a, Unit>, ok: (a) -> Bool / e cost k) -> Bool / e
  where derivable(ord, a)
  cost m.len() * k
= m.fold(false, |found: Bool, x: a, _: Unit| found || ok(x))

/// Whether `ok` returns true for every element. It calls `ok` in order and stops at the first
/// false. `true` for the empty set.
pub fn Set::all<a | e>(s: Set<a>, ok: (a) -> Bool / e cost k) -> Bool / e = all_in(items(s), ok)

fn all_in<a | e>(m: Map<a, Unit>, ok: (a) -> Bool / e cost k) -> Bool / e
  where derivable(ord, a)
  cost m.len() * k
= m.fold(true, |all_so_far: Bool, x: a, _: Unit| all_so_far && ok(x))

/// Whether every element of `xs` is in the set; `true` for an empty `xs`.
pub fn Set::contains_all<a>(s: Set<a>, xs: List<a>) -> Bool = {
  let m = items(s);
  xs.all(|x: a| m.contains(x))
}

/// Whether no element of `xs` is in the set; `true` for an empty `xs`.
pub fn Set::contains_none<a>(s: Set<a>, xs: List<a>) -> Bool = {
  let m = items(s);
  xs.all(|x: a| !m.contains(x))
}

/// Everything in either set.
pub fn Set::union<a>(a: Set<a>, b: Set<a>) -> Set<a> = {
  let x = items(a);
  let y = items(b);
  Set(if x.len() < y.len() { y.merge(x) } else { x.merge(y) })
}

/// Everything in any of the sets.
pub fn Set::unions<a>(sets: List<Set<a>>) -> Set<a> = unions_from(Set::empty(), sets, 0)

fn unions_from<a>(accumulator: Set<a>, sets: List<Set<a>>, i: Int) -> Set<a> =
  match sets.at(i) {
    Some(s) -> unions_from(accumulator.union(s), sets, i + 1),
    None -> accumulator,
  }

/// The elements in both sets.
pub fn Set::intersection<a>(a: Set<a>, b: Set<a>) -> Set<a> = Set(keys_in_both(items(a), items(b)))

fn keys_in_both<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Map<a, Unit>
  where derivable(ord, a)
  cost x.len() + y.len()
= if x.len() <= y.len() { common_keys(x, y) } else { common_keys(y, x) }

fn common_keys<a>(smaller: Map<a, Unit>, searched: Map<a, Unit>) -> Map<a, Unit>
  where derivable(ord, a)
=
  smaller.fold(Map::new(), |accumulator: Map<a, Unit>, x: a, _: Unit|
    if searched.contains(x) { accumulator.insert(x, ()) } else { accumulator })

/// The elements of `a` that are not in `b`.
pub fn Set::difference<a>(a: Set<a>, b: Set<a>) -> Set<a> = Set(without(items(a), items(b)))

fn without<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Map<a, Unit>
  where derivable(ord, a)
  cost x.len() + y.len()
=
  if y.len() < x.len() {
    y.fold(x, |accumulator: Map<a, Unit>, k: a, _: Unit| accumulator.remove(k))
  } else {
    x.fold(Map::new(), |accumulator: Map<a, Unit>, k: a, _: Unit|
      if y.contains(k) { accumulator } else { accumulator.insert(k, ()) })
  }

/// The elements in exactly one of the two sets.
pub fn Set::symmetric_difference<a>(a: Set<a>, b: Set<a>) -> Set<a> =
  Set(either_alone(items(a), items(b)))

fn either_alone<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Map<a, Unit>
  where derivable(ord, a)
  cost x.len() + y.len()
= {
  let left = without(x, y);
  let right = without(y, x);
  if left.len() < right.len() { right.merge(left) } else { left.merge(right) }
}

/// Whether every element of `a` is in `b`. The empty set is a subset of everything.
pub fn Set::is_subset<a>(a: Set<a>, b: Set<a>) -> Bool = is_submap(items(a), items(b))

fn is_submap<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Bool
  where derivable(ord, a)
  cost x.len()
= x.len() <= y.len() && x.fold(true, |all_so_far: Bool, k: a, _: Unit| all_so_far && y.contains(k))

/// Whether every element of `b` is in `a`.
pub fn Set::is_superset<a>(a: Set<a>, b: Set<a>) -> Bool = b.is_subset(a)

/// Whether the two sets have no element in common. The empty set is disjoint from every set.
pub fn Set::is_disjoint<a>(a: Set<a>, b: Set<a>) -> Bool = is_disjoint_map(items(a), items(b))

fn is_disjoint_map<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Bool
  where derivable(ord, a)
  cost x.len() + y.len()
= if x.len() <= y.len() { none_in(x, y) } else { none_in(y, x) }

fn none_in<a>(smaller: Map<a, Unit>, searched: Map<a, Unit>) -> Bool
  where derivable(ord, a)
= smaller.fold(true, |none_so_far: Bool, k: a, _: Unit| none_so_far && !searched.contains(k))

test "a set's elements come back in order, each once" {
  let s = Set::of_list([3, 1, 2, 1]);
  assert_eq(s, Set::of_list([1, 2, 3]));
  assert_eq(s.size(), 3);
  assert(!s.is_empty());
  assert(Set::empty().is_empty());
  assert(s.contains(2));
  assert(!s.contains(9));
  assert_eq(s.elements(), [1, 2, 3]);
  assert_eq(Set::of_list(["b", "a", "b"]).elements(), ["a", "b"])
}

test "a set is shown as the literal that builds it" {
  assert_eq(literal_text(Set::of_list([3, 1, 2])), "#[1, 2, 3]");
  assert_eq(literal_text(Set::of_list(["b", "a"])), "#[\"a\", \"b\"]");
  assert_eq(literal_text(Set::empty()), "#[]");
  assert_eq(literal_text(Set::of_list([Set::of_list([2]), Set::of_list([])])), "#[#[], #[2]]")
}

test "insert and remove are idempotent, and a union contains the elements of both sets" {
  let s = Set::empty().insert(1);
  assert_eq(s.insert(1), Set::of_list([1]));
  assert_eq(s.remove(1), Set::empty());
  assert_eq(s.remove(9), Set::of_list([1]));
  assert_eq(Set::of_list([1, 2]).union(Set::of_list([2, 3])), Set::of_list([1, 2, 3]));
  assert_eq(
    Set::unions([Set::of_list([1]), Set::of_list([3, 4]), Set::empty(), Set::of_list([1, 2])]),
    Set::of_list([1, 2, 3, 4]),
  );
  let none: List<Set<Int>> = [];
  assert_eq(Set::unions(none), Set::empty());
  assert(Set::of_list([1, 2, 3]).contains_all([1, 3]));
  assert(Set::of_list([1]).contains_all([]));
  assert(!Set::of_list([1, 2]).contains_all([1, 9]));
  assert(Set::of_list([1, 2]).contains_none([8, 9]));
  assert(Set::of_list([1, 2]).contains_none([]));
  assert(!Set::of_list([1, 2]).contains_none([1]))
}

test "the two-set operations return what is shared and what is not" {
  let a = Set::of_list([1, 2, 3]);
  let b = Set::of_list([3, 4]);
  assert_eq(a.intersection(b), Set::of_list([3]));
  assert_eq(a.intersection(Set::empty()), Set::empty());
  assert_eq(a.difference(b), Set::of_list([1, 2]));
  assert_eq(b.difference(a), Set::of_list([4]));
  assert_eq(a.difference(a), Set::empty());
  assert_eq(a.symmetric_difference(b), Set::of_list([1, 2, 4]));
  assert_eq(a.symmetric_difference(a), Set::empty());
  assert(Set::of_list([1, 2]).is_subset(a));
  assert(Set::empty().is_subset(a));
  assert(!b.is_subset(a));
  assert(a.is_superset(Set::of_list([1])));
  assert(!a.is_superset(b));
  assert(Set::of_list([1, 2]).is_disjoint(Set::of_list([3])));
  assert(a.is_disjoint(Set::empty()));
  assert(!a.is_disjoint(b))
}

test "`Set::map` merges elements that map to the same value, `filter` drops elements the predicate rejects, and `partition` splits by the predicate" {
  let s = Set::of_list([1, 2, 3, 4, 5]);
  assert_eq(s.map(|x: Int| x * 10), Set::of_list([10, 20, 30, 40, 50]));
  assert_eq(s.map(|x: Int| x % 2), Set::of_list([0, 1]));
  assert_eq(s.map(|x: Int| x.to_string()), Set::of_list(["1", "2", "3", "4", "5"]));
  assert_eq(s.filter(|x: Int| x > 3), Set::of_list([4, 5]));
  assert_eq(s.filter(|x: Int| x > 9), Set::empty());
  assert_eq(s.partition(|x: Int| x % 2 == 0), {
    yes: Set::of_list([2, 4]),
    no: Set::of_list([1, 3, 5]),
  })
}

test "min and max are the ends of the order, and the empty set has neither" {
  assert_eq(Set::of_list([3, 1, 2]).min(), Some(1));
  assert_eq(Set::of_list([3, 1, 2]).max(), Some(3));
  assert_eq(Set::of_list(["b", "a"]).min(), Some("a"));
  let none: Set<Int> = Set::empty();
  assert_eq(none.min(), None);
  assert_eq(none.max(), None)
}

test "between returns the elements within its bounds, each end included or not as its bound specifies" {
  let s = Set::of_list([1, 3, 5, 7, 9]);
  assert_eq(s.between(Included(3), Included(7)), Set::of_list([3, 5, 7]));
  assert_eq(s.between(Excluded(3), Excluded(7)), Set::of_list([5]));
  assert_eq(s.between(Included(4), Unbounded), Set::of_list([5, 7, 9]));
  assert_eq(s.between(Unbounded, Excluded(5)), Set::of_list([1, 3]));
  assert_eq(s.between(Unbounded, Unbounded), s);
  assert_eq(s.between(Included(8), Included(2)), Set::empty());
  assert_eq(
    Set::of_list(["pear", "apple", "fig"]).between(Excluded("apple"), Unbounded),
    Set::of_list(["fig", "pear"]),
  )
}

effect call_counter {
  write count() -> Unit
}

test "a fold visits the elements in order, and its step may perform effects" {
  assert_eq(
    Set::of_list([3, 1, 2]).fold([], |accumulator: List<Int>, x: Int| accumulator.push(x)),
    [1, 2, 3],
  );
  let smaller = handle {
    Set::of_list([1, 2, 3]).fold(0, |accumulator: Int, x: Int| {
      call_counter.count();
      accumulator + x
    })
  } with {
    var n = 0,
    call_counter.count() -> {
      n = n + 1;
    },
    return total -> { total: total, steps: n },
  };
  assert_eq(smaller, { total: 6, steps: 3 })
}

test "any and all stop calling the predicate once the result is decided" {
  let s = Set::of_list([1, 2, 3]);
  assert(s.any(|x: Int| x == 2));
  assert(!s.any(|x: Int| x > 3));
  assert(s.all(|x: Int| x > 0));
  assert(!s.all(|x: Int| x < 3));
  let none: Set<Int> = Set::empty();
  assert(!none.any(|_: Int| true));
  assert(none.all(|_: Int| false));
  let searched = handle {
    let found = s.any(|x: Int| {
      call_counter.count();
      x == 2
    });
    let all_result = s.all(|x: Int| {
      call_counter.count();
      x < 1
    });
    { found: found, held: all_result }
  } with {
    var n = 0,
    call_counter.count() -> {
      n = n + 1;
    },
    return r -> { found: r.found, held: r.held, requested: n },
  };
  assert_eq(searched, { found: true, held: false, requested: 3 })
}

type SmallSet = { low: Bool, has_one: Bool, high: Bool }

type Two = { a: SmallSet, b: SmallSet }

fn picked(p: SmallSet) -> Set<Int> = {
  let low = if p.low { Set::of_list([0]) } else { Set::empty() };
  let mid = if p.has_one { low.insert(1) } else { low };
  if p.high { mid.insert(2) } else { mid }
}

fn pick_of(s: Set<Int>) -> SmallSet =
  { low: s.contains(0), has_one: s.contains(1), high: s.contains(2) }

fn universe() -> Set<Int> = Set::of_list([0, 1, 2])

fn over(operation: keep (Set<Int>, Set<Int>) -> Set<Int>) -> (Two) -> Set<Int> =
  |t: Two| operation(picked(t.a), picked(t.b))

fn small_set_operation(
  operation: keep (Set<Int>, Set<Int>) -> Set<Int>,
) -> (SmallSet, SmallSet) -> SmallSet =
  |x: SmallSet, y: SmallSet| pick_of(operation(picked(x), picked(y)))

fn each(t: Two, combine: (Bool, Bool) -> Bool) -> Set<Int> =
  picked({
    low: combine(t.a.low, t.b.low),
    has_one: combine(t.a.has_one, t.b.has_one),
    high: combine(t.a.high, t.b.high),
  })

law "choosing which of 0, 1 and 2 to include, building that `Set`, then reading membership back gives the same choice" =
  inverse(picked, pick_of)

law "a union contains the elements that are in either set" =
  agrees(over(Set::union), |t: Two| each(t, |x: Bool, y: Bool| x || y))

law "an intersection contains the elements that are in both sets" =
  agrees(over(Set::intersection), |t: Two| each(t, |x: Bool, y: Bool| x && y))

law "a difference contains the elements that are in the first set but not in the second" =
  agrees(over(Set::difference), |t: Two| each(t, |x: Bool, y: Bool| x && !y))

law "a symmetric difference contains the elements that are in exactly one of the two sets" =
  agrees(over(Set::symmetric_difference), |t: Two| each(t, |x: Bool, y: Bool| x != y))

law "`is_subset` is true when no element of the first set is missing from the second" =
  agrees(|t: Two| picked(t.a).is_subset(picked(t.b)), |t: Two|
    each(t, |x: Bool, y: Bool| x && !y) == Set::empty())

law "`is_disjoint` is true when the two sets share no elements" =
  agrees(|t: Two| picked(t.a).is_disjoint(picked(t.b)), |t: Two|
    each(t, |x: Bool, y: Bool| x && y) == Set::empty())

law "union is commutative" = agrees(over(Set::union), over(|a: Set<Int>, b: Set<Int>| b.union(a)))

law "intersection is commutative" =
  agrees(over(Set::intersection), over(|a: Set<Int>, b: Set<Int>| b.intersection(a)))

law "union is associative, and the empty set is its identity" =
  monoid(small_set_operation(Set::union), pick_of(Set::empty()))

law "intersection is associative, and the universe is its identity" =
  monoid(small_set_operation(Set::intersection), pick_of(universe()))

law "the union of a set with its intersection with another set is the original set" =
  agrees(over(|a: Set<Int>, b: Set<Int>| a.union(a.intersection(b))), |t: Two| picked(t.a))

law "the intersection of a set with its union with another set is the original set" =
  agrees(over(|a: Set<Int>, b: Set<Int>| a.intersection(a.union(b))), |t: Two| picked(t.a))

law "the complement of a union is the intersection of the two complements" =
  agrees(
    over(|a: Set<Int>, b: Set<Int>| universe().difference(a.union(b))),
    over(|a: Set<Int>, b: Set<Int>|
      universe().difference(a).intersection(universe().difference(b))),
  )

law "the complement of an intersection is the union of the two complements" =
  agrees(
    over(|a: Set<Int>, b: Set<Int>| universe().difference(a.intersection(b))),
    over(|a: Set<Int>, b: Set<Int>| universe().difference(a).union(universe().difference(b))),
  )

law "min and max are the first and the last of the elements" =
  agrees(
    |p: SmallSet| { minimum_sizes: picked(p).min(), greatest: picked(p).max() },
    |p: SmallSet|
      { minimum_sizes: picked(p).elements().first(), greatest: picked(p).elements().last() },
  )

test "a set's `elements` are the elements of the list it was built from, sorted and without duplicates" {
  gen::check(gen::list(gen::any_int()), |x: List<Int>|
    agrees(|xs: List<Int>| Set::of_list(xs).elements(), |xs: List<Int>| xs.unique().sort(), x))
}
