//! Channels between tasks: selecting among several, pipelines over them, and lists and sequences
//! through them.
//!
//! The language creates a channel with `task.channel(n)`, which buffers up to `n` values that no
//! receiver has taken yet (`0` passes each value directly from sender to receiver). It provides
//! `task.send`, `task.recv` and `task.close` to use one. This module builds on those.
//!
//! A channel is closed once, by its sender, when there is nothing more to send. Every function
//! here that starts the tasks sending on a channel closes it when they have ended, and a function
//! that only receives never closes one. A send on a closed channel fails: `send` raises
//! `chan.closed`, `try_send` returns `Rejected`, and a select returns `Closed`. A receive from a
//! closed channel returns the values queued before the close, in order, and then returns `None`
//! every time.
//!
//! `select` performs one of several channel operations: the first, in the order of its arms, that
//! can proceed. `select_from` is the fair version. It looks first at the arm the caller names,
//! which is the one after the arm that proceeded last, so an arm that stays ready proceeds within
//! as many selects as there are arms. No random choice is involved, so the choice is the same
//! under `simulate` and under the real scheduler. All arms of one select share one type. To select
//! over channels of different types, make them channels of one sum type.
//!
//! A pipeline is tasks joined by channels. Each function here that starts one runs the rest of the
//! pipeline as `inside`, passing it the channel the started tasks write. `from_list`, `stage`,
//! `fan_out`, `in_order` and `merge` each make sure the tasks they started have ended before they
//! return, as `std.task`'s `scoped` does. A task cancelled while it has a value in hand takes the
//! value with it: a value a sender was waiting to send, or a value a receiver got but had not yet
//! used. The channel is left as if that send or receive never happened, so what the other tasks
//! send and receive is unchanged.

import std.list
import std.seq
import std.seq (Seq, Done, Skip, Yield)
import std.task
import std.time (between, nanos_at)

// --- Sending and receiving --------------------------------------------------

/// How a channel operation of this module fails.
pub effect chan {
  /// The channel a value was sent on is closed.
  raise closed()
}

/// Sends `x` on `c`, waiting for room. Raises `chan.closed` if `c` is closed.
pub fn send<a>(c: Chan<a>, x: a) -> Unit / {task.send, chan.closed} =
  if task.send(c, x) { () } else { chan.closed() }

/// Sends each of `xs` on `c` in order, waiting for room for each. Raises `chan.closed` at the
/// first value that finds `c` closed. The values before it were sent.
pub fn send_all<a>(c: Chan<a>, xs: List<a>) -> Unit / {task.send, chan.closed} =
  xs.fold((), |_u: Unit, x: a| send(c, x))

/// Sends each element of `s` on `c` in order, pulling at most `budget` elements and skips from
/// `s`. Raises `seq.spent` if `s` has more, and `chan.closed` if `c` is closed.
pub fn send_seq<a | e>(
  c: Chan<a>,
  s: Seq<a | e>,
  budget: Int,
) -> Unit / {task.send, chan.closed, seq::seq.spent | e} =
  if send_each(c, s, budget, budget) { () } else { chan.closed() }

/// Sends the elements of `s` on `c` in order, pulling at most `left` more of `budget` elements
/// and skips. Returns whether `c` accepted them all.
fn send_each<a | e>(
  c: Chan<a>,
  s: Seq<a | e>,
  budget: Int,
  left: Int,
) -> Bool / {task.send, seq::seq.spent | e} =
  match s() {
    Done -> true,
    Skip(rest) -> if left <= 0 { seq::seq.spent(budget) }
    else { send_each(c, rest, budget, left - 1) },
    Yield(x, rest) -> if left <= 0 { seq::seq.spent(budget) }
    else if task.send(c, x) { send_each(c, rest, budget, left - 1) }
    else { false },
  }

/// The values `c` carries from now until it is closed, as a sequence. Each pull receives one
/// value, waiting for it.
pub fn receiving<a>(c: Chan<a>) -> Seq<a | {task.recv}> =
  seq::unfold((), |_u: Unit|
    match task.recv(c) { Some(x) -> Some({ value: x, next: () }), None -> None })

/// Every value `c` carries until it is closed, in order. Takes at most `limit` of them, and raises
/// `seq.spent` if it carries more.
pub fn drain<a>(c: Chan<a>, limit: Int) -> List<a> / {task.recv, seq::seq.spent} =
  seq::to_list(receiving(c), limit)

/// The result of a receive that does not wait.
pub type ReceiveResult<a> =
  /// A value was available.
  | Got(a)
  /// No value was available, and the channel is open.
  | Empty
  /// The channel is closed and empty.
  | Ended

/// Receives a value from `c` if one is available now.
pub fn try_recv<a>(c: Chan<a>) -> ReceiveResult<a> / {task.select} =
  match task.select([(c, None)], false) {
    Some((_, Some(x))) -> Got(x),
    Some((_, None)) -> Ended,
    None -> Empty,
  }

/// The result of a send that does not wait.
pub type SendResult =
  /// The value was queued, or passed to a waiting receiver.
  | Accepted
  /// The channel had no room, and no receiver was waiting.
  | Full
  /// The channel is closed.
  | Rejected

/// Sends `x` on `c` if it can be sent now.
pub fn try_send<a>(c: Chan<a>, x: a) -> SendResult / {task.select} =
  match task.select([(c, Some(x))], false) {
    Some((_, Some(_))) -> Accepted,
    Some((_, None)) -> Rejected,
    None -> Full,
  }

// --- Choosing among channels ------------------------------------------------

/// One thing a select may do: `receive` from a channel, or `sending` a value to one.
pub type Arm<a> = (Chan<a>, Option<a>)

/// The arm that receives from `c`.
pub fn receive<a>(c: Chan<a>) -> Arm<a> = (c, None)

/// The arm that sends `x` to `c`.
pub fn sending<a>(c: Chan<a>, x: a) -> Arm<a> = (c, Some(x))

/// What a select did, with the index of the arm that proceeded.
pub type SelectResult<a> =
  /// A receive got this value.
  | Received(Int, a)
  /// A send delivered its value.
  | Sent(Int)
  /// The arm's channel was closed: a receive found it closed and empty, or a send was rejected.
  | Closed(Int)

/// Performs the first of `arms`, in their order, that can proceed, waiting until one can if none
/// can now. With no arms, it waits forever.
pub fn select<a>(arms: List<Arm<a>>) -> SelectResult<a> / {task.select, abort.raise} =
  select_from(0, arms)

/// `select`, looking first at the arm at index `first`, then at those after it, and then at those
/// before. Given `next_turn` of its last result, it gives every arm a turn: an arm that stays
/// ready proceeds within as many selects as there are arms.
pub fn select_from<a>(
  first: Int,
  arms: List<Arm<a>>,
) -> SelectResult<a> / {task.select, abort.raise} =
  match select_rotated(first, arms, [], true) {
    Some(went) -> went,
    None -> panic("a select that waits returns the arm that went"),
  }

/// `select`, returning `None` at once if no arm can proceed.
pub fn try_select<a>(arms: List<Arm<a>>) -> Option<SelectResult<a>> / {task.select, abort.raise} =
  select_rotated(0, arms, [], false)

/// `select_from`, returning `None` at once if no arm can proceed.
pub fn try_select_from<a>(
  first: Int,
  arms: List<Arm<a>>,
) -> Option<SelectResult<a>> / {task.select, abort.raise} = select_rotated(first, arms, [], false)

/// The index `select_from` should look at first after the result `went`: the arm after the one
/// that proceeded.
pub fn next_turn<a>(went: SelectResult<a>) -> Int =
  match went { Received(at, _) -> at + 1, Sent(at) -> at + 1, Closed(at) -> at + 1 }

/// `select_from`, giving up at `at`. Returns `TimedOut` if no arm could proceed by then, though an
/// arm that is ready at that instant may still proceed. If an enclosing deadline is no later than
/// `at`, that deadline stops the call, as it stops any wait.
pub fn select_until<a>(
  at: Instant,
  first: Int,
  arms: List<Arm<a>>,
) -> task::Timed<SelectResult<a>> / {task.write, clock.read, clock.write, task::deadline.at, abort.raise} =
  match task::deadline.at() {
    // The enclosing deadline comes first and stops this task, so no timer is needed.
    Some(outer) if nanos_at(outer) <= nanos_at(at) -> task::Done(select_from(first, arms)),
    _ -> {
      let left = between(clock.now(), at);
      let bell: Chan<a> = task.channel(0);
      task::scoped(
        [
          || {
            clock.sleep(left);
            task.close(bell)
          },
        ],
        |_timer: List<Task<Unit>>|
          match select_rotated(first, arms, [(bell, None)], true) {
            Some(Closed(rang)) -> if rang == arms.len() { task::TimedOut }
            else { task::Done(Closed(rang)) },
            Some(went) -> task::Done(went),
            None -> panic("a select that waits returns the arm that went"),
          },
      )
    },
  }

/// Selects over `arms` rotated to start at `first`, with `last` after them all. Each result gives
/// the arm's index in `arms`, and the arms of `last` get indexes past the end of `arms`.
fn select_rotated<a>(
  first: Int,
  arms: List<Arm<a>>,
  last: List<Arm<a>>,
  wait: Bool,
) -> Option<SelectResult<a>> / {task.select, abort.raise} = {
  let n = arms.len();
  let turn = if n == 0 { 0 } else { (first % n + n) % n };
  let turned = arms.drop(turn).concat(arms.take(turn)).concat(last);
  match task.select(turned, wait) {
    None -> None,
    Some((went, got)) -> {
      let at = if went >= n { went } else { (went + turn) % n };
      Some(match ((got, turned.at(went))) {
        (None, _) -> Closed(at),
        (Some(x), Some((_, None))) -> Received(at, x),
        (Some(_), _) -> Sent(at),
      })
    },
  }
}

// --- Pipelines --------------------------------------------------------------

/// Runs `inside` with a channel of capacity `capacity`, and returns its result. A task sends each
/// of `xs` on the channel in order and then closes it. The task has ended when this returns.
pub fn from_list<a, r | e>(
  xs: List<a>,
  capacity: Int,
  inside: (Chan<a>) -> r / {task.write, abort.raise | e},
) -> r / {task.write, abort.raise | e} = {
  let out = task.channel(capacity);
  task::scoped(
    [
      || {
        xs.fold(true, |open: Bool, x: a| open && task.send(out, x));
        task.close(out)
      },
    ],
    |_feeder: List<Task<Unit>>| inside(out),
  )
}

/// `from_list` for the elements of `s`, pulled as the channel accepts them. The feeding task pulls
/// at most `budget` elements and skips, and raises `seq.spent` if `s` has more.
pub fn from_seq<a, r | e>(
  s: Seq<a | e>,
  budget: Int,
  capacity: Int,
  inside: (Chan<a>) -> r / {task.write, abort.raise, seq::seq.spent | e},
) -> r / {task.write, abort.raise, seq::seq.spent | e} = {
  let out = task.channel(capacity);
  task::scoped(
    [
      || {
        send_each(out, s, budget, budget);
        task.close(out)
      },
    ],
    |_feeder: List<Task<Unit>>| inside(out),
  )
}

/// Runs `inside` with a channel of capacity `capacity` that carries `f` of each value from
/// `input`, in order, and returns its result. One task receives, applies `f` and sends, and closes
/// the channel when `input` ends. The task has ended when this returns.
pub fn stage<a, b, r | e>(
  input: Chan<a>,
  capacity: Int,
  f: keep (a) -> b / e,
  inside: (Chan<b>) -> r / {task.write, abort.raise, diverges | e},
) -> r / {task.write, abort.raise, diverges | e} = {
  let out = task.channel(capacity);
  task::scoped(
    [
      || {
        map_values(input, out, f);
        task.close(out)
      },
    ],
    |_worker: List<Task<Unit>>| inside(out),
  )
}

/// `stage` with `workers` tasks that share `input`. `f` runs on at most that many values at once,
/// and its results are sent in the order they finish. The channel is closed when `input` has
/// ended and every worker has sent its last result. Raises when `workers` is below one.
pub fn fan_out<a, b, r | e>(
  input: Chan<a>,
  workers: Int,
  capacity: Int,
  f: keep (a) -> b / e,
  inside: (Chan<b>) -> r / {task.write, abort.raise, diverges | e},
) -> r / {task.write, abort.raise, diverges | e} =
  if workers < 1 { panic("a channel is worked by at least one task") } else {
    let out = task.channel(capacity);
    task::scoped(
      [
        || {
          task::all(range(0, workers).map(|_i: Int| || map_values(input, out, f)));
          task.close(out)
        },
      ],
      |_pool: List<Task<Unit>>| inside(out),
    )
  }

/// `fan_out` that sends its results in the order their values arrived on `input`. At most
/// `workers + capacity` values are in progress between being taken from `input` and being sent
/// on, so at most that many results wait for an earlier one.
pub fn in_order<a, b, r | e>(
  input: Chan<a>,
  workers: Int,
  capacity: Int,
  f: keep (a) -> b / e,
  inside: (Chan<b>) -> r / {task.write, abort.raise, diverges | e},
) -> r / {task.write, abort.raise, diverges | e} =
  if workers < 1 { panic("a channel is worked by at least one task") } else {
    let out = task.channel(capacity);
    let numbered = task.channel(0);
    let finished = task.channel(0);
    let taken = task.channel(workers + capacity);
    task::scoped(
      [
        || {
          number_values(input, numbered, taken, 0);
          task.close(numbered)
        },
        || {
          task::all(
            range(0, workers).map(|_i: Int|
              || map_values(numbered, finished, |job: (Int, a)| (job._0, f(job._1)))),
          );
          task.close(finished)
        },
        || {
          reorder(finished, out, taken, Map::new(), 0);
          task.close(out)
        },
      ],
      |_tasks: List<Task<Unit>>| inside(out),
    )
  }

/// Runs `inside` with a channel of capacity `capacity` that carries every value of every one of
/// `inputs`, and returns its result. Each input's values keep their order, and the inputs are
/// taken from in turn. One task moves the values, and closes the channel when every input has
/// ended.
pub fn merge<a, r | e>(
  inputs: List<Chan<a>>,
  capacity: Int,
  inside: (Chan<a>) -> r / {task.write, abort.raise, diverges | e},
) -> r / {task.write, abort.raise, diverges | e} = {
  let out = task.channel(capacity);
  task::scoped(
    [
      || {
        merge_into(inputs, out, 0);
        task.close(out)
      },
    ],
    |_merger: List<Task<Unit>>| inside(out),
  )
}

/// Sends `f` of each value of `input` on `out` until `input` ends or `out` is closed.
fn map_values<a, b | e>(
  input: Chan<a>,
  out: Chan<b>,
  f: (a) -> b / e,
) -> Unit / {task.write, diverges | e} =
  match task.recv(input) {
    Some(x) -> if task.send(out, f(x)) { map_values(input, out, f) } else { () },
    None -> (),
  }

/// Sends each value of `input` on `out` with its index, counting from `next`, after reserving room
/// for it in `taken`.
fn number_values<a>(
  input: Chan<a>,
  out: Chan<(Int, a)>,
  taken: Chan<Unit>,
  next: Int,
) -> Unit / {task.write, diverges} =
  match task.recv(input) {
    Some(x) -> if task.send(taken, ()) && task.send(out, (next, x)) {
      number_values(input, out, taken, next + 1)
    } else { () },
    None -> (),
  }

/// Sends the values of `finished` on `out` in index order, from `next`. Values that arrive early
/// wait in `held`. Releases the room in `taken` for each value sent.
fn reorder<b>(
  finished: Chan<(Int, b)>,
  out: Chan<b>,
  taken: Chan<Unit>,
  held: Map<Int, b>,
  next: Int,
) -> Unit / {task.write, diverges} =
  match held.get(next) {
    Some(ready) -> if task.send(out, ready) {
      task.recv(taken);
      reorder(finished, out, taken, held.remove(next), next + 1)
    } else { () },
    None -> match task.recv(finished) {
      Some(done) -> reorder(finished, out, taken, held.insert(done._0, done._1), next),
      None -> (),
    },
  }

/// Moves every value of `inputs` to `out`, looking first at the input at `turn`, until all have
/// ended or `out` is closed.
fn merge_into<a>(
  inputs: List<Chan<a>>,
  out: Chan<a>,
  turn: Int,
) -> Unit / {task.write, abort.raise, diverges} =
  if inputs.len() == 0 { () } else {
    match select_from(turn, inputs.map(|input: Chan<a>| receive(input))) {
      Received(at, x) -> if task.send(out, x) { merge_into(inputs, out, at + 1) } else { () },
      Closed(at) -> merge_into(inputs.take(at).concat(inputs.drop(at + 1)), out, at),
      Sent(_) -> (),
    }
  }

// --- Tests: what the language's channels do ---------------------------------

test "a sender to a full channel waits until a receive makes room" {
  simulate {
    let ch = task.channel(1);
    let notes = task.channel(2);
    let sender = task.spawn(|| {
      task.send(ch, 1);
      task.send(notes, "sent 1");
      task.send(ch, 2);
      task.send(notes, "sent 2")
    });
    clock.sleep(Duration(1));
    assert_eq(try_recv(notes), Got("sent 1"));
    assert_eq(try_recv(notes), Empty);
    assert_eq(try_send(ch, 9), Full);
    assert_eq(task.recv(ch), Some(1));
    task.join(sender);
    assert_eq(try_recv(notes), Got("sent 2"));
    assert_eq(task.recv(ch), Some(2))
  }
}

test "a closed channel rejects a send, returns what was queued in order, and then returns the end" {
  simulate {
    let ch = task.channel(2);
    assert_eq(try { send_all(ch, [1, 2]) }, Ok(()));
    task.close(ch);
    assert_eq(try { send(ch, 3) }, Err(()));
    assert_eq(try_send(ch, 3), Rejected);
    assert_eq(task.recv(ch), Some(1));
    assert_eq(try_recv(ch), Got(2));
    assert_eq(task.recv(ch), None);
    assert_eq(try_recv(ch), Ended)
  }
}

/// A level a test's tasks raise and lower.
effect level {
  write up() -> Unit
  write down() -> Unit
}

/// Runs `body` and returns its value with the highest level it reached.
fn peak<a | e>(body: () -> a / {level.up, level.down | e}) -> { value: a, most: Int } / e =
  handle {
    body()
  } with {
    var now = 0,
    var most = 0,
    level.up() -> {
      now = now + 1;
      most = max(most, now);
    },
    level.down() -> {
      now = now - 1;
    },
    return value -> { value: value, most: most },
  }

/// A count small enough that a law can try every interleaving at each value.
type Few = | Zero | One | Two

fn count(n: Few) -> Int = match n { Zero -> 0, One -> 1, Two -> 2 }

fn sent_from(from: Int, n: Int) -> List<Int> = range(0, n).map(|i: Int| from + i)

law "every value sent is received once, each sender's in the order it sent them, in every interleaving"
  forall (room: Few, first: Few, second: Few) where count(first) + count(second) <= 2 {
    simulate {
      let ch = task.channel(count(room));
      let low = sent_from(0, count(first));
      let high = sent_from(100, count(second));
      let sender = |xs: List<Int>|
        ||
          xs.fold((), |_u: Unit, x: Int| {
            task.send(ch, x);
            ()
          });
      let got = task::scoped([sender(low), sender(high)], |_senders: List<Task<Unit>>|
        range(0, low.len() + high.len()).map(|_i: Int|
          match task.recv(ch) { Some(x) -> x, None -> 0 - 1 }));
      got.filter(|x: Int| x < 100) == low && got.filter(|x: Int| x >= 100) == high
    }
  }

law "a channel never holds more values than its capacity, in every interleaving"
  forall (room: Few, values: Few) {
    simulate {
      let ch = task.channel(count(room));
      let n = count(values);
      peak(||
          task::scoped(
            [
              ||
                range(0, n).fold((), |_u: Unit, i: Int| {
                  task.send(ch, i);
                  level.up()
                }),
            ],
            |_sender: List<Task<Unit>>|
              range(0, n).fold((), |_u: Unit, _i: Int| {
                level.down();
                task.recv(ch);
                ()
              }),
          )).most
        <= count(room)
    }
  }

test "a task cancelled while it waits to send or to receive leaves the channel as it was" {
  simulate {
    let ch = task.channel(1);
    assert_eq(try_send(ch, 1), Accepted);
    let sender = task.spawn(|| task.send(ch, 2));
    clock.sleep(Duration(1));
    assert(task.cancel(sender));
    assert_eq(task.await(sender), None);
    assert_eq(try_recv(ch), Got(1));
    assert_eq(try_recv(ch), Empty);
    let receiver = task.spawn(|| task.recv(ch));
    clock.sleep(Duration(1));
    assert(task.cancel(receiver));
    assert_eq(task.await(receiver), None);
    assert_eq(try_send(ch, 3), Accepted);
    assert_eq(try_recv(ch), Got(3))
  }
}

test "a sender cancelled anywhere has sent its value whole or not at all, in every interleaving" {
  simulate {
    let ch = task.channel(1);
    let sender = task.spawn(|| task.send(ch, 1));
    task.cancel(sender);
    let sent = task.await(sender);
    let held = try_recv(ch);
    assert(held == Empty || held == Got(1));
    assert(sent != Some(true) || held == Got(1));
    assert_eq(try_send(ch, 2), Accepted);
    assert_eq(try_recv(ch), Got(2));
    assert_eq(try_recv(ch), Empty)
  }
}

// --- Tests of choosing ------------------------------------------------------

test "a select reports which arm proceeded and what it did" {
  simulate {
    let a = task.channel(1);
    let b = task.channel(1);
    assert_eq(try_select([receive(a), receive(b)]), None);
    assert_eq(select([receive(a), sending(b, 5)]), Sent(1));
    assert_eq(select([receive(a), receive(b)]), Received(1, 5));
    assert_eq(try_send(a, 7), Accepted);
    assert_eq(select([receive(b), receive(a)]), Received(1, 7));
    task.close(a);
    assert_eq(select([receive(b), sending(a, 8)]), Closed(1));
    assert_eq(select([receive(b), receive(a)]), Closed(1))
  }
}

test "a select tries its arms in the order given and takes the first that can proceed" {
  simulate {
    let a = task.channel(3);
    let b = task.channel(3);
    send_all(a, [1, 2, 3]);
    send_all(b, [4, 5, 6]);
    let went = range(0, 3).map(|_i: Int| select([receive(a), receive(b)]));
    assert_eq(went, [Received(0, 1), Received(0, 2), Received(0, 3)])
  }
}

law "an arm that stays ready goes within as many fair selects as there are arms"
  forall (others: Few, start: Few) {
    simulate {
      let n = count(others) + 1;
      let ready = range(0, n).map(|i: Int| {
        let c = task.channel(n);
        range(0, n).fold((), |_u: Unit, _j: Int| {
          task.send(c, i);
          ()
        });
        c
      });
      let went = range(0, n).fold(
        { turn: count(start), seen: [] },
        |so_far: { turn: Int, seen: List<Int> }, _i: Int| {
          let chose = select_from(so_far.turn, ready.map(|c: Chan<Int>| receive(c)));
          match chose {
            Received(at, from) ->
              { turn: next_turn(chose), seen: if at == from { so_far.seen.push(at) } else { [] } },
            _ -> { turn: so_far.turn, seen: [] },
          }
        },
      );
      went.seen.sort() == range(0, n)
    }
  }

test "a select with a deadline gives up at it on the virtual clock" {
  simulate {
    task::unbounded(|| {
      let quiet: Chan<Int> = task.channel(0);
      assert_eq(select_until(Instant(30), 0, [receive(quiet)]), task::TimedOut);
      assert_eq(clock.now(), Instant(30))
    })
  }
}

test "a select with a deadline takes an arm made ready before the deadline" {
  simulate {
    task::unbounded(|| {
      let c = task.channel(0);
      let late = task.spawn(|| {
        clock.sleep(Duration(10));
        task.send(c, 4)
      });
      assert_eq(select_until(Instant(30), 0, [receive(c)]), task::Done(Received(0, 4)));
      assert_eq(clock.now(), Instant(10));
      assert(task.join(late))
    })
  }
}

test "a select with a deadline stops at an earlier enclosing deadline" {
  simulate {
    task::unbounded(|| {
      let quiet: Chan<Int> = task.channel(0);
      let held = task::until(Instant(20), || select_until(Instant(90), 0, [receive(quiet)]));
      assert_eq((held, clock.now()), (task::TimedOut, Instant(20)))
    })
  }
}

// --- Tests of lists, sequences and pipelines --------------------------------

/// A closed channel containing `xs`, so a test of one pipeline step runs only that step's tasks.
fn filled(xs: List<Int>) -> Chan<Int> / {task.write} = {
  let c = task.channel(xs.len());
  xs.fold((), |_u: Unit, x: Int| {
    task.send(c, x);
    ()
  });
  task.close(c);
  c
}

test "a producer and a consumer pass every value in order, in every interleaving" {
  simulate { assert_eq(from_list([1, 2, 3], 0, |c: Chan<Int>| drain(c, 10)), [1, 2, 3]) }
}

test "a sequence goes through a channel and comes out a list" {
  simulate {
    let squares = seq::map(seq::range(0, 3), |i: Int| i * i);
    assert_eq(from_seq(squares, 10, 1, |c: Chan<Int>| drain(c, 10)), [0, 1, 4])
  }
}

test "a drain past its limit raises rather than return part of what the channel carries" {
  simulate { assert_eq(try { drain(filled([1, 2, 3]), 2) }, Err(2)) }
}

test "a stage carries its function of each value in order, in every interleaving" {
  simulate {
    let got = stage(filled([1, 2, 3]), 0, |x: Int| x * 2, |doubled: Chan<Int>| drain(doubled, 10));
    assert_eq(got, [2, 4, 6])
  }
}

test "a pipeline of a source, a stage and a drain carries each of {count(values)} values through in order" for values: Few in [
    Zero,
    One,
    Two,
  ] {
  simulate {
    let sent = sent_from(1, count(values));
    let got = from_list(sent, 0, |input: Chan<Int>|
      stage(input, 0, |x: Int| x * 2, |doubled: Chan<Int>| drain(doubled, 10)));
    assert_eq(got, sent.map(|x: Int| x * 2))
  }
}

test "a stage whose reader leaves early is ended, and takes nothing more" {
  simulate {
    let input = filled([1, 2, 3]);
    let first = stage(input, 0, |x: Int| x * 2, |doubled: Chan<Int>| task.recv(doubled));
    assert_eq(first, Some(2));
    let left = drain(input, 10);
    clock.sleep(Duration(100));
    assert(left == [2, 3] || left == [3]);
    assert_eq(try_recv(input), Ended)
  }
}

law "merge carries every value of every input once, each input's in its order, in every interleaving"
  forall (first: Few, second: Few) {
    simulate {
      let low = sent_from(0, count(first));
      let high = sent_from(100, count(second));
      let got = merge([filled(low), filled(high)], 0, |out: Chan<Int>| drain(out, 10));
      got.filter(|x: Int| x < 100) == low && got.filter(|x: Int| x >= 100) == high
    }
  }

test "merge takes from its inputs in turn while each has a value" {
  simulate {
    let got = merge([filled([1, 2]), filled([10, 20])], 4, |out: Chan<Int>| {
      clock.sleep(Duration(1));
      drain(out, 10)
    });
    assert_eq(got, [1, 10, 2, 20])
  }
}

/// Values for workers to take, each a count small enough that a test runs every interleaving.
type Load = { values: Few, workers: Few }

fn loads() -> List<Load> =
  [Zero, One, Two].fold([], |acc: List<Load>, values: Few|
    [One, Two].fold(acc, |inner: List<Load>, workers: Few|
      inner.push({ values: values, workers: workers })))

test "fan_out runs its function on no more of {count(c.values)} values at once than its {count(c.workers)} workers, and sends every result" for c: Load in loads(
  ).filter(|l: Load| l.values != Two || l.workers != Two) {
  simulate {
    let n = count(c.values);
    let got = peak(||
      fan_out(
        filled(range(0, n)),
        count(c.workers),
        n,
        |x: Int| {
          level.up();
          task.yield();
          level.down();
          x * 2
        },
        |out: Chan<Int>| drain(out, 10),
      ));
    assert_eq(got.value.sort(), range(0, n).map(|x: Int| x * 2));
    assert(got.most <= count(c.workers))
  }
}

test "fan_out sends its results in the order the workers finish them" {
  simulate {
    let got = fan_out(
      filled([20, 10]),
      2,
      2,
      |takes: Int| {
        clock.sleep(Duration(takes));
        takes + 1
      },
      |out: Chan<Int>| {
        clock.sleep(Duration(100));
        drain(out, 10)
      },
    );
    assert_eq(got, [11, 21])
  }
}

test "what the workers of in_order finish out of order is sent on in index order" {
  simulate {
    let finished = task.channel(3);
    [(2, 30), (0, 10), (1, 20)].fold((), |_u: Unit, done: (Int, Int)| {
      task.send(finished, done);
      ()
    });
    task.close(finished);
    let taken = task.channel(3);
    range(0, 3).fold((), |_u: Unit, _i: Int| {
      task.send(taken, ());
      ()
    });
    let out = task.channel(3);
    reorder(finished, out, taken, Map::new(), 0);
    task.close(out);
    assert_eq(drain(out, 10), [10, 20, 30]);
    assert_eq(try_recv(taken), Empty)
  }
}

test "in_order sends the result for each of {count(c.values)} values in the order they came, over {count(c.workers)} workers" for c: Load in loads(
  ) {
  simulate {
    let sent = sent_from(1, count(c.values));
    let got = in_order(filled(sent), count(c.workers), 1, |x: Int| x * 2, |out: Chan<Int>|
      drain(out, 10));
    assert_eq(got, sent.map(|x: Int| x * 2))
  }
}
