//! The text of the prelude, from which the compiler reads the builtins. It is a module of its own
//! because every load that imports a shipped module reads that module's whole text, embedded files
//! included. So the module that embeds the prelude stays small.

/// The text of `std.prelude`, as the toolchain ships it.
pub fn text() -> Bytes = embed("prelude.ply")
