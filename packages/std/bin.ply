//! A compact positional encoding, and what `derive bin for T` targets.
//!
//! Both ends know the type, so nothing names a field: a record is its fields in declared order, and
//! a variant is its constructor's index and then its fields. `Int`, counts, lengths and the 16- to
//! 128-bit widths are varints, the signed ones zigzag-encoded. `U8` and `I8` are one byte, `Float`
//! its eight IEEE bytes, `Decimal` its text, `Char` its scalar value and `Unit` one zero byte. So
//! every value takes at least one byte, and a reader can reject a count larger than the bytes left.
//! Each value has exactly one encoding: `decode` rejects bytes that end inside the value, bytes
//! left over, and anything no value encodes to (a constructor index past the type's last, a map's
//! keys out of order, an overlong varint, text that is not UTF-8). A store uses `shape_digest` to
//! key what it wrote by the shape of its type.

import std.gen
import std.derive
import std.derive.codec (derive_bin)

/// `derive bin for T`: derives `<snake_case(T)>_bin`, `T`'s `BinCodec`, as `std.derive.codec`
/// writes it.
pub fn derive(declaration: derive::Declaration) -> Result<String, derive::Refused> / {abort.raise} =
  derive_bin(declaration)

/// Why bytes do not decode, and the offset where that was found.
pub type BinError = { at: Int, message: String }

/// The error as text.
pub fn error_to_string(e: BinError) -> String = e.message ++ " (at byte " ++ e.at.to_string() ++ ")"

fn short(at: Int) -> BinError = { at: at, message: "the bytes end inside a value" }

fn rejected(at: Int, message: String) -> BinError = { at: at, message: message }

/// A value read, and the offset after it.
pub type Taken<a> = { value: a, at: Int }

/// How a value is appended to the bytes written so far.
pub type Put<a> = (Bytes, a) -> Bytes / {abort.raise}

/// How a value is read at an offset: the value and the offset after it, or why the bytes do not
/// contain one.
pub type Take<a> = (Bytes, Int) -> Result<Taken<a>, BinError> / {abort.raise}

/// `shape` is a digest of the type's structure, including names. It lets a reader tell bytes
/// written for one definition of a type from bytes written for a different one.
pub type BinCodec<a> = { put: Put<a>, take: Take<a>, shape: Shape }

/// Returns the maximum depth to which a derived codec over a recursive type nests values. It is
/// chosen to stay within how deeply calls can nest.
pub fn max_depth() -> Int = 10000

/// The codec a derived codec over a recursive type uses past `max_depth` levels: writing panics and
/// reading fails.
pub fn too_deep<a>() -> BinCodec<a> =
  {
    put: |_w: Bytes, _x: a| panic(nested_too_deep),
    take: |_d: Bytes, at: Int| Err(rejected(at, nested_too_deep)),
    shape: |_s: Shapes| panic(nested_too_deep),
  }

const nested_too_deep: String = "nested deeper than " ++ max_depth().to_string() ++ " levels"

/// Appends seven bits a byte, low first, with the high bit set on every byte but the last. `n` is
/// read as its 64 unsigned bits.
pub fn put_varint(w: Bytes, n: Int) -> Bytes / {abort.raise} =
  if n >= 0 { unsigned_varint(w, n) }
  else { unsigned_varint(w ++ byte_of_int(n & 127 | 128), n >>> 7) }

fn unsigned_varint(w: Bytes, n: Int) -> Bytes / {abort.raise} =
  if n < 128 { w ++ byte_of_int(n) }
  else { unsigned_varint(w ++ byte_of_int(n & 127 | 128), n >>> 7) }

/// The varint at `at`, rejecting an overlong one.
pub fn take_varint(d: Bytes, at: Int) -> Result<Taken<Int>, BinError> / {abort.raise} = {
  let b = byte_at(d, at);
  if b >= 0 && b < 128 { Ok({ value: b, at: at + 1 }) } else { varint_from(d, at, at, 0, 0) }
}

fn byte_at(d: Bytes, at: Int) -> Int / {abort.raise} = if at < d.len() { d.at(at) } else { 0 - 1 }

fn varint_from(
  d: Bytes,
  start: Int,
  at: Int,
  shift: Int,
  accumulator: Int,
) -> Result<Taken<Int>, BinError> / {abort.raise} = {
  if at >= d.len() { Err(short(at)) } else {
    let b = d.at(at);
    if shift == 63 && b > 1 { Err(rejected(start, "a varint wider than 64 bits")) }
    else if b < 128 {
      if b == 0 && shift > 0 { Err(rejected(start, "a varint with a redundant last byte")) }
      else { Ok({ value: accumulator | b << shift, at: at + 1 }) }
    } else { varint_from(d, start, at + 1, shift + 7, accumulator | (b & 127) << shift) }
  }
}

/// The zigzag of `n`: a magnitude of either sign as a small unsigned number, `0`, `-1`, `1`, `-2`
/// as `0`, `1`, `2`, `3`, which is what a signed varint is written as.
pub fn zigzag_encode(n: Int) -> Int = n << 1 ^ n >> 63

/// The number a zigzag-encoded value represents.
pub fn zigzag_decode(z: Int) -> Int = z >>> 1 ^ 0 - (z & 1)

fn take_ranged(
  d: Bytes,
  at: Int,
  lo: Int,
  hi: Int,
  what: String,
) -> Result<Taken<Int>, BinError> / {abort.raise} =
  match take_varint(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> if t.value < lo || t.value > hi { Err(rejected(at, "a varint outside " ++ what)) }
    else { ok_at(t.value, t.at) },
  }

fn take_zigzag(
  d: Bytes,
  at: Int,
  lo: Int,
  hi: Int,
  what: String,
) -> Result<Taken<Int>, BinError> / {abort.raise} =
  match take_varint(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> {
      let n = zigzag_decode(t.value);
      if n < lo || n > hi { Err(rejected(at, "a varint outside " ++ what)) } else { ok_at(n, t.at) }
    },
  }

fn ok_at<a>(value: a, at: Int) -> Result<Taken<a>, BinError> = Ok({ value: value, at: at })

/// A count of what follows: each item takes at least a byte, so a count past the bytes left is
/// rejected.
pub fn take_count(d: Bytes, at: Int) -> Result<Taken<Int>, BinError> / {abort.raise} =
  match take_varint(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> if t.value < 0 || t.value > d.len() - t.at {
      Err(rejected(at, "a count larger than the number of bytes left"))
    } else { Ok(t) },
  }

/// Appends a constructor index.
pub fn put_tag(w: Bytes, index: Int) -> Bytes / {abort.raise} = put_varint(w, index)

/// The constructor index of a type with `count` constructors.
pub fn take_tag(d: Bytes, at: Int, count: Int) -> Result<Taken<Int>, BinError> / {abort.raise} =
  match take_varint(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> if t.value < 0 || t.value >= count {
      Err(
        rejected(
          at,
          "constructor " ++ t.value.to_string() ++ " of a type with " ++ count.to_string(),
        ),
      )
    } else { Ok(t) },
  }

/// Appends one zero byte, the encoding of `()`.
pub fn put_unit(w: Bytes, u: Unit) -> Bytes = w ++ byte_of_int(0)

/// Reads `()` at `at`.
pub fn take_unit(d: Bytes, at: Int) -> Result<Taken<Unit>, BinError> / {abort.raise} = {
  let b = byte_at(d, at);
  if b == 0 { ok_at((), at + 1) }
  else if b < 0 { Err(short(at)) }
  else { Err(rejected(at, "a unit is the byte 0")) }
}

/// Appends a `Bool`.
pub fn put_bool(w: Bytes, b: Bool) -> Bytes / {abort.raise} =
  w ++ byte_of_int(if b { 1 } else { 0 })

/// Reads a `Bool` at `at`.
pub fn take_bool(d: Bytes, at: Int) -> Result<Taken<Bool>, BinError> / {abort.raise} = {
  let b = byte_at(d, at);
  if b == 0 { ok_at(false, at + 1) }
  else if b == 1 { ok_at(true, at + 1) }
  else if b < 0 { Err(short(at)) }
  else { Err(rejected(at, "a boolean is the byte 0 or 1")) }
}

/// Appends an `Int`, zigzagged.
pub fn put_int(w: Bytes, n: Int) -> Bytes / {abort.raise} = put_varint(w, zigzag_encode(n))

/// Reads an `Int` at `at`.
pub fn take_int(d: Bytes, at: Int) -> Result<Taken<Int>, BinError> / {abort.raise} = {
  let b = byte_at(d, at);
  if b >= 0 && b < 128 { Ok({ value: zigzag_decode(b), at: at + 1 }) } else {
    match varint_from(d, at, at, 0, 0) {
      Err(e) -> Err(e),
      Ok(t) -> ok_at(zigzag_decode(t.value), t.at),
    }
  }
}

/// Appends a `Float`'s IEEE-754 bits, little-endian.
pub fn put_float(w: Bytes, f: Float) -> Bytes / {abort.raise} = {
  let n = bits_of_float(f);
  Bytes::concat_all([
    w,
    byte_of_int(n & 255),
    byte_of_int(n >>> 8 & 255),
    byte_of_int(n >>> 16 & 255),
    byte_of_int(n >>> 24 & 255),
    byte_of_int(n >>> 32 & 255),
    byte_of_int(n >>> 40 & 255),
    byte_of_int(n >>> 48 & 255),
    byte_of_int(n >>> 56 & 255),
  ])
}

/// Reads a `Float` at `at`.
pub fn take_float(d: Bytes, at: Int) -> Result<Taken<Float>, BinError> / {abort.raise} =
  if at + 8 > d.len() { Err(short(at)) } else {
    let low = Int::of_u32(d.u32_le(at));
    let high = Int::of_u32(d.u32_le(at + 4));
    ok_at(Float::of_bits(low | high << 32), at + 8)
  }

/// Appends a length and the bytes.
pub fn put_bytes(w: Bytes, b: Bytes) -> Bytes / {abort.raise} = put_varint(w, b.len()) ++ b

/// Reads a length and the bytes at `at`.
pub fn take_bytes(d: Bytes, at: Int) -> Result<Taken<Bytes>, BinError> / {abort.raise} = {
  let n = byte_at(d, at);
  if n >= 0 && n < 128 && n <= d.len() - at - 1 {
    Ok({ value: d.slice(at + 1, at + 1 + n), at: at + 1 + n })
  } else {
    match take_count(d, at) {
      Err(e) -> Err(e),
      Ok(c) -> ok_at(d.slice(c.at, c.at + c.value), c.at + c.value),
    }
  }
}

/// Appends a `String` as its UTF-8 bytes.
pub fn put_string(w: Bytes, s: String) -> Bytes / {abort.raise} = put_bytes(w, Bytes::of_string(s))

/// Reads a `String` as its UTF-8 bytes at `at`.
pub fn take_string(d: Bytes, at: Int) -> Result<Taken<String>, BinError> / {abort.raise} =
  match take_bytes(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> if t.value.is_utf8() { ok_at(String::of_bytes(t.value), t.at) }
    else { Err(rejected(at, "a string that is not UTF-8")) },
  }

/// Appends a `Decimal` as its text, so the scale is preserved: `1.50` reads back as `1.50`.
pub fn put_decimal(w: Bytes, d: Decimal) -> Bytes / {abort.raise} = put_string(w, d.to_string())

/// Reads a `Decimal` at `at`.
pub fn take_decimal(d: Bytes, at: Int) -> Result<Taken<Decimal>, BinError> / {abort.raise} =
  match take_string(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> match Decimal::of_string(t.value) {
      Some(x) -> ok_at(x, t.at),
      None -> Err(rejected(at, "`" ++ t.value ++ "` is not a decimal")),
    },
  }

/// Appends a `Char`'s scalar value as a varint.
pub fn put_char(w: Bytes, c: Char) -> Bytes / {abort.raise} = put_varint(w, Int::of_char(c))

/// Reads a `Char` at `at`.
pub fn take_char(d: Bytes, at: Int) -> Result<Taken<Char>, BinError> / {abort.raise} =
  match take_varint(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> match Char::of_int(t.value) {
      Some(c) -> ok_at(c, t.at),
      None -> Err(rejected(at, "a number that is not a valid character code")),
    },
  }

/// Appends a `U8`.
pub fn put_u8(w: Bytes, n: U8) -> Bytes = w ++ byte_of_int(Int::of_u8(n))

/// Reads a `U8` at `at`.
pub fn take_u8(d: Bytes, at: Int) -> Result<Taken<U8>, BinError> / {abort.raise} = {
  let b = byte_at(d, at);
  if b < 0 { Err(short(at)) } else { ok_at(U8::of_int(b), at + 1) }
}

/// Appends an `I8`.
pub fn put_i8(w: Bytes, n: I8) -> Bytes = w ++ byte_of_int(Int::of_i8(n) & 255)

/// Reads an `I8` at `at`.
pub fn take_i8(d: Bytes, at: Int) -> Result<Taken<I8>, BinError> / {abort.raise} = {
  let b = byte_at(d, at);
  if b < 0 { Err(short(at)) } else { ok_at(I8::of_int(if b > 127 { b - 256 } else { b }), at + 1) }
}

/// Appends a `U16` as a varint.
pub fn put_u16(w: Bytes, n: U16) -> Bytes / {abort.raise} = put_varint(w, Int::of_u16(n))

/// Reads a `U16` at `at`.
pub fn take_u16(d: Bytes, at: Int) -> Result<Taken<U16>, BinError> / {abort.raise} =
  match take_ranged(d, at, 0, 65535, "`U16`") {
    Err(e) -> Err(e),
    Ok(t) -> ok_at(U16::of_int(t.value), t.at),
  }

/// Appends a `U32` as a varint.
pub fn put_u32(w: Bytes, n: U32) -> Bytes / {abort.raise} = put_varint(w, Int::of_u32(n))

/// Reads a `U32` at `at`.
pub fn take_u32(d: Bytes, at: Int) -> Result<Taken<U32>, BinError> / {abort.raise} =
  match take_ranged(d, at, 0, 4294967295, "`U32`") {
    Err(e) -> Err(e),
    Ok(t) -> ok_at(U32::of_int(t.value), t.at),
  }

/// Appends a `U64` as a varint of its 64 bits. The `Int` passed to the varint is built from the
/// high and low 32-bit halves of `n`.
pub fn put_u64(w: Bytes, n: U64) -> Bytes / {abort.raise} =
  put_varint(w, Int::of_u64(n >>> 32) << 32 | Int::of_u64(n & 0xFFFF_FFFFu64))

/// Reads a `U64` at `at`.
pub fn take_u64(d: Bytes, at: Int) -> Result<Taken<U64>, BinError> / {abort.raise} =
  match take_varint(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> ok_at(U64::of_int(t.value >>> 32) << 32 | U64::of_int(t.value & 0xFFFF_FFFF), t.at),
  }

/// Appends an `I16`.
pub fn put_i16(w: Bytes, n: I16) -> Bytes / {abort.raise} =
  put_varint(w, zigzag_encode(Int::of_i16(n)))

/// Reads an `I16` at `at`.
pub fn take_i16(d: Bytes, at: Int) -> Result<Taken<I16>, BinError> / {abort.raise} =
  match take_zigzag(d, at, 0 - 32768, 32767, "`I16`") {
    Err(e) -> Err(e),
    Ok(t) -> ok_at(I16::of_int(t.value), t.at),
  }

/// Appends an `I32`.
pub fn put_i32(w: Bytes, n: I32) -> Bytes / {abort.raise} =
  put_varint(w, zigzag_encode(Int::of_i32(n)))

/// Reads an `I32` at `at`.
pub fn take_i32(d: Bytes, at: Int) -> Result<Taken<I32>, BinError> / {abort.raise} =
  match take_zigzag(d, at, 0 - 2147483648, 2147483647, "`I32`") {
    Err(e) -> Err(e),
    Ok(t) -> ok_at(I32::of_int(t.value), t.at),
  }

/// Appends an `I64`.
pub fn put_i64(w: Bytes, n: I64) -> Bytes / {abort.raise} = put_int(w, Int::of_i64(n))

/// Reads an `I64` at `at`.
pub fn take_i64(d: Bytes, at: Int) -> Result<Taken<I64>, BinError> / {abort.raise} =
  match take_int(d, at) { Err(e) -> Err(e), Ok(t) -> ok_at(I64::of_int(t.value), t.at) }

/// Appends a `U128`.
pub fn put_u128(w: Bytes, n: U128) -> Bytes / {abort.raise} =
  if n < 128u128 { w ++ byte_of_int(Int::of_u128(n)) }
  else { put_u128(w ++ byte_of_int(Int::of_u128(n & 127u128) | 128), n >>> 7) }

/// Reads a `U128` at `at`.
pub fn take_u128(d: Bytes, at: Int) -> Result<Taken<U128>, BinError> / {abort.raise} =
  u128_from(d, at, at, 0, 0u128)

fn u128_from(
  d: Bytes,
  start: Int,
  at: Int,
  shift: Int,
  accumulator: U128,
) -> Result<Taken<U128>, BinError> / {abort.raise} = {
  if at >= d.len() { Err(short(at)) } else {
    let b = d.at(at);
    if shift == 126 && b > 3 { Err(rejected(start, "a varint wider than 128 bits")) }
    else if b < 128 {
      if b == 0 && shift > 0 { Err(rejected(start, "a varint with a redundant last byte")) }
      else { ok_at(accumulator | U128::of_int(b) << shift, at + 1) }
    } else { u128_from(d, start, at + 1, shift + 7, accumulator | U128::of_int(b & 127) << shift) }
  }
}

/// Appends an `I128` as a varint. The value is zigzag encoded using 128-bit arithmetic, then
/// written as an unsigned 128-bit varint.
pub fn put_i128(w: Bytes, n: I128) -> Bytes / {abort.raise} = i128_bits(w, n << 1 ^ n >> 127)

fn i128_bits(w: Bytes, z: I128) -> Bytes / {abort.raise} =
  if z >= 0i128 { unsigned_i128_bits(w, z) }
  else { unsigned_i128_bits(w ++ byte_of_int(Int::of_i128(z & 127i128) | 128), z >>> 7) }

fn unsigned_i128_bits(w: Bytes, z: I128) -> Bytes / {abort.raise} =
  if z < 128i128 { w ++ byte_of_int(Int::of_i128(z)) }
  else { unsigned_i128_bits(w ++ byte_of_int(Int::of_i128(z & 127i128) | 128), z >>> 7) }

/// Reads an `I128` at `at`.
pub fn take_i128(d: Bytes, at: Int) -> Result<Taken<I128>, BinError> / {abort.raise} =
  i128_from(d, at, at, 0, 0i128)

fn i128_from(
  d: Bytes,
  start: Int,
  at: Int,
  shift: Int,
  accumulator: I128,
) -> Result<Taken<I128>, BinError> / {abort.raise} = {
  if at >= d.len() { Err(short(at)) } else {
    let b = d.at(at);
    if shift == 126 && b > 3 { Err(rejected(start, "a varint wider than 128 bits")) }
    else if b < 128 {
      if b == 0 && shift > 0 { Err(rejected(start, "a varint with a redundant last byte")) } else {
        let z = accumulator | I128::of_int(b) << shift;
        ok_at(z >>> 1 ^ 0i128 - (z & 1i128), at + 1)
      }
    } else { i128_from(d, start, at + 1, shift + 7, accumulator | I128::of_int(b & 127) << shift) }
  }
}

/// The sum types digested so far. `done` maps the key of each completely digested sum type to its
/// digest. `open` lists the keys of the sum types whose variants are being digested now, so a
/// recursive reference to one of them is digested by name instead of being entered again.
pub type Shapes = { done: Map<Bytes, Bytes>, open: List<Bytes> }
/// A type's digest, and the updated `Shapes` after digesting it.
pub type ShapeResult = { digest: Bytes, shapes: Shapes }
/// Computes a type's digest from the `Shapes` so far, and returns the digest with the updated
/// `Shapes`.
pub type Shape = (Shapes) -> ShapeResult / {abort.raise}
/// A record field's name and shape.
pub type FieldShape = { name: String, shape: Shape }
/// A constructor's name and its fields' shapes.
pub type VariantShape = { name: String, fields: List<Shape> }

type Digests = { digests: List<Bytes>, shapes: Shapes }

fn named(name: String) -> Bytes / {abort.raise} = put_bytes(b"", Bytes::of_string(name))

fn digests_of(s: Shapes, shapes: List<Shape>) -> Digests / {abort.raise} =
  shapes.fold({ digests: [], shapes: s }, |accumulator: Digests, f: Shape| {
    let r = f(accumulator.shapes);
    { digests: accumulator.digests.push(r.digest), shapes: r.shapes }
  })

fn digest(kind: Int, parts: List<Bytes>) -> Bytes / {abort.raise} =
  Bytes::concat_all([byte_of_int(kind), Bytes::concat_all(parts)]).blake3()

/// The shape of a type with no parts, by its name.
pub fn leaf_shape(name: String) -> Shape =
  |shapes: Shapes| { digest: digest(1, [named(name)]), shapes: shapes }

/// A type the language declares, applied to its arguments.
pub fn applied_shape(
  shapes: Shapes,
  name: String,
  args: List<Shape>,
) -> ShapeResult / {abort.raise} = {
  let a = digests_of(shapes, args);
  {
    digest: digest(2, [named(name), put_varint(b"", args.len()), Bytes::concat_all(a.digests)]),
    shapes: a.shapes,
  }
}

/// The shape of a record: each field's name and shape, in order.
pub fn record_shape(shapes: Shapes, fields: List<FieldShape>) -> ShapeResult / {abort.raise} = {
  let walked = fields.fold(
    { digests: [], shapes: shapes },
    |accumulator: Digests, f: FieldShape| {
      let r = (f.shape)(accumulator.shapes);
      { digests: accumulator.digests.push(named(f.name) ++ r.digest), shapes: r.shapes }
    },
  );
  {
    digest: digest(3, [put_varint(b"", fields.len()), Bytes::concat_all(walked.digests)]),
    shapes: walked.shapes,
  }
}

/// Returns the digest of a sum type. `key` distinguishes two sum types that share a simple name.
/// Only `name` enters the digest, so moving a module does not change its shapes.
pub fn sum_shape(
  shapes: Shapes,
  key: String,
  name: String,
  args: List<Shape>,
  variants: List<VariantShape>,
) -> ShapeResult / {abort.raise} = {
  let a = digests_of(shapes, args);
  let head = Bytes::concat_all([
    named(name),
    put_varint(b"", args.len()),
    Bytes::concat_all(a.digests),
  ]);
  let k = named(key) ++ head;
  match a.shapes.done.get(k) {
    Some(d) -> { digest: d, shapes: a.shapes },
    None -> if a.shapes.open.fold(false, |seen: Bool, o: Bytes| seen || o == k) {
      { digest: digest(5, [head]), shapes: a.shapes }
    } else {
      let inside = { done: a.shapes.done, open: a.shapes.open.push(k) };
      let walked = variants.fold(
        { digests: [], shapes: inside },
        |accumulator: Digests, v: VariantShape| {
          let f = digests_of(accumulator.shapes, v.fields);
          {
            digests: accumulator.digests.push(
              Bytes::concat_all([
                named(v.name),
                put_varint(b"", v.fields.len()),
                Bytes::concat_all(f.digests),
              ]),
            ),
            shapes: f.shapes,
          }
        },
      );
      let d = digest(4, [head, put_varint(b"", variants.len()), Bytes::concat_all(walked.digests)]);
      { digest: d, shapes: { done: walked.shapes.done.insert(k, d), open: a.shapes.open } }
    },
  }
}

/// The codec of `Unit`.
pub fn unit_bin() -> BinCodec<Unit> = { put: put_unit, take: take_unit, shape: leaf_shape("Unit") }
/// The codec of `Bool`.
pub fn bool_bin() -> BinCodec<Bool> = { put: put_bool, take: take_bool, shape: leaf_shape("Bool") }
/// The codec of `Int`.
pub fn int_bin() -> BinCodec<Int> = { put: put_int, take: take_int, shape: leaf_shape("Int") }

/// The codec of `Float`.
pub fn float_bin() -> BinCodec<Float> =
  { put: put_float, take: take_float, shape: leaf_shape("Float") }

/// The codec of `Decimal`.
pub fn decimal_bin() -> BinCodec<Decimal> =
  { put: put_decimal, take: take_decimal, shape: leaf_shape("Decimal") }

/// The codec of `String`.
pub fn string_bin() -> BinCodec<String> =
  { put: put_string, take: take_string, shape: leaf_shape("String") }

/// The codec of `Bytes`.
pub fn bytes_bin() -> BinCodec<Bytes> =
  { put: put_bytes, take: take_bytes, shape: leaf_shape("Bytes") }

/// The codec of `Char`.
pub fn char_bin() -> BinCodec<Char> = { put: put_char, take: take_char, shape: leaf_shape("Char") }

/// The codec of `U8`.
pub fn u8_bin() -> BinCodec<U8> = { put: put_u8, take: take_u8, shape: leaf_shape("U8") }
/// The codec of `U16`.
pub fn u16_bin() -> BinCodec<U16> = { put: put_u16, take: take_u16, shape: leaf_shape("U16") }
/// The codec of `U32`.
pub fn u32_bin() -> BinCodec<U32> = { put: put_u32, take: take_u32, shape: leaf_shape("U32") }
/// The codec of `U64`.
pub fn u64_bin() -> BinCodec<U64> = { put: put_u64, take: take_u64, shape: leaf_shape("U64") }
/// The codec of `U128`.
pub fn u128_bin() -> BinCodec<U128> = { put: put_u128, take: take_u128, shape: leaf_shape("U128") }
/// The codec of `I8`.
pub fn i8_bin() -> BinCodec<I8> = { put: put_i8, take: take_i8, shape: leaf_shape("I8") }
/// The codec of `I16`.
pub fn i16_bin() -> BinCodec<I16> = { put: put_i16, take: take_i16, shape: leaf_shape("I16") }
/// The codec of `I32`.
pub fn i32_bin() -> BinCodec<I32> = { put: put_i32, take: take_i32, shape: leaf_shape("I32") }
/// The codec of `I64`.
pub fn i64_bin() -> BinCodec<I64> = { put: put_i64, take: take_i64, shape: leaf_shape("I64") }
/// The codec of `I128`.
pub fn i128_bin() -> BinCodec<I128> = { put: put_i128, take: take_i128, shape: leaf_shape("I128") }

/// Appends a count and the items, each by `put`.
pub fn put_list<a>(w: Bytes, xs: List<a>, put: Put<a>) -> Bytes / {abort.raise} =
  xs.fold(put_varint(w, xs.len()), put)

/// Reads a count and that many items, each by `take`.
pub fn take_list<a>(
  d: Bytes,
  at: Int,
  take: Take<a>,
) -> Result<Taken<List<a>>, BinError> / {abort.raise} =
  match take_count(d, at) { Err(e) -> Err(e), Ok(n) -> take_items(d, n.at, n.value, take, []) }

fn take_items<a>(
  d: Bytes,
  at: Int,
  left: Int,
  take: Take<a>,
  accumulator: List<a>,
) -> Result<Taken<List<a>>, BinError> / {abort.raise} =
  if left <= 0 { ok_at(accumulator, at) } else {
    match take(d, at) {
      Err(e) -> Err(e),
      Ok(t) -> take_items(d, t.at, left - 1, take, accumulator.push(t.value)),
    }
  }

/// Returns a codec that writes a list's length, then each item with the `item` codec.
pub fn list_bin<a>(item: BinCodec<a>) -> BinCodec<List<a>> =
  {
    put: |w: Bytes, xs: List<a>| put_list(w, xs, item.put),
    take: |d: Bytes, at: Int| take_list(d, at, item.take),
    shape: |shapes: Shapes| applied_shape(shapes, "List", [item.shape]),
  }

/// Appends an array as the list of its items.
pub fn put_array<a>(w: Bytes, xs: Array<a>, put: Put<a>) -> Bytes / {abort.raise} =
  put_list(w, xs.to_list(), put)

/// Reads an array as a list is read.
pub fn take_array<a>(
  d: Bytes,
  at: Int,
  take: Take<a>,
) -> Result<Taken<Array<a>>, BinError> / {abort.raise} =
  match take_list(d, at, take) {
    Ok(t) -> Ok({ value: Array::of_list(t.value), at: t.at }),
    Err(e) -> Err(e),
  }

/// Returns a codec that writes an array exactly as `list_bin` writes a list. Its shape is named
/// `Array`, so an array and a list have different shape digests.
pub fn array_bin<a>(item: BinCodec<a>) -> BinCodec<Array<a>> =
  {
    put: |w: Bytes, xs: Array<a>| put_array(w, xs, item.put),
    take: |d: Bytes, at: Int| take_array(d, at, item.take),
    shape: |shapes: Shapes| applied_shape(shapes, "Array", [item.shape]),
  }

/// Appends a count and the entries in key order, a key by `put_key` and its value by `put_value`.
pub fn put_map<k, v>(
  w: Bytes,
  m: Map<k, v>,
  put_key: Put<k>,
  put_value: Put<v>,
) -> Bytes / {abort.raise}
  where derivable(ord, k)
=
  m.fold(put_varint(w, m.len()), |accumulator: Bytes, x: k, y: v|
    put_value(put_key(accumulator, x), y))

/// Reads a count and that many entries, rejecting keys out of order.
pub fn take_map<k, v>(
  d: Bytes,
  at: Int,
  take_key: Take<k>,
  take_value: Take<v>,
) -> Result<Taken<Map<k, v>>, BinError> / {abort.raise}
  where derivable(ord, k)
=
  match take_count(d, at) {
    Err(e) -> Err(e),
    Ok(n) -> take_entries(d, n.at, n.value, take_key, take_value, None, Map::new()),
  }

fn take_entries<k, v>(
  d: Bytes,
  at: Int,
  left: Int,
  take_key: Take<k>,
  take_value: Take<v>,
  last: Option<k>,
  accumulator: Map<k, v>,
) -> Result<Taken<Map<k, v>>, BinError> / {abort.raise}
  where derivable(ord, k)
=
  if left <= 0 { ok_at(accumulator, at) } else {
    match take_key(d, at) {
      Err(e) -> Err(e),
      Ok(x) -> {
        let ordered = match last { None -> true, Some(l) -> compare_values(l, x.value) == Less };
        if !ordered { Err(rejected(at, "a map key out of order")) } else {
          match take_value(d, x.at) {
            Err(e) -> Err(e),
            Ok(y) ->
              take_entries(
                d,
                y.at,
                left - 1,
                take_key,
                take_value,
                Some(x.value),
                accumulator.insert(x.value, y.value),
              ),
          }
        }
      },
    }
  }

/// Returns a codec that writes a map's entries in key order. Decoding rejects keys out of order, so
/// each map has exactly one encoding.
pub fn map_bin<k, v>(key: BinCodec<k>, value: BinCodec<v>) -> BinCodec<Map<k, v>>
  where derivable(ord, k)
=
  {
    put: |w: Bytes, m: Map<k, v>| put_map(w, m, key.put, value.put),
    take: |d: Bytes, at: Int| take_map(d, at, key.take, value.take),
    shape: |shapes: Shapes| applied_shape(shapes, "Map", [key.shape, value.shape]),
  }

/// Appends `None` or `Some`, tagged as a variant.
pub fn put_option<a>(w: Bytes, o: Option<a>, put: Put<a>) -> Bytes / {abort.raise} =
  match o { None -> put_tag(w, 0), Some(x) -> put(put_tag(w, 1), x) }

/// Reads an `Option` at `at`.
pub fn take_option<a>(
  d: Bytes,
  at: Int,
  take: Take<a>,
) -> Result<Taken<Option<a>>, BinError> / {abort.raise} =
  match take_tag(d, at, 2) {
    Err(e) -> Err(e),
    Ok(t) -> if t.value == 0 { ok_at(None, t.at) }
    else { match take(d, t.at) { Err(e) -> Err(e), Ok(x) -> ok_at(Some(x.value), x.at) } },
  }

/// Returns a codec that writes `None` as one tag, and `Some` as another tag followed by the item.
pub fn option_bin<a>(item: BinCodec<a>) -> BinCodec<Option<a>> =
  {
    put: |w: Bytes, o: Option<a>| put_option(w, o, item.put),
    take: |d: Bytes, at: Int| take_option(d, at, item.take),
    shape: |shapes: Shapes| applied_shape(shapes, "Option", [item.shape]),
  }

/// Appends `Ok` or `Err`, tagged as a variant.
pub fn put_result<a, b>(
  w: Bytes,
  r: Result<a, b>,
  put_ok: Put<a>,
  put_err: Put<b>,
) -> Bytes / {abort.raise} =
  match r { Ok(x) -> put_ok(put_tag(w, 0), x), Err(x) -> put_err(put_tag(w, 1), x) }

/// Reads a `Result` at `at`.
pub fn take_result<a, b>(
  d: Bytes,
  at: Int,
  take_ok: Take<a>,
  take_err: Take<b>,
) -> Result<Taken<Result<a, b>>, BinError> / {abort.raise} =
  match take_tag(d, at, 2) {
    Err(e) -> Err(e),
    Ok(t) -> if t.value == 0 {
      match take_ok(d, t.at) { Err(e) -> Err(e), Ok(x) -> ok_at(Ok(x.value), x.at) }
    } else { match take_err(d, t.at) { Err(e) -> Err(e), Ok(x) -> ok_at(Err(x.value), x.at) } },
  }

/// Returns a codec that writes `Ok` as one tag and `Err` as another tag, each followed by its
/// value.
pub fn result_bin<a, b>(ok: BinCodec<a>, err: BinCodec<b>) -> BinCodec<Result<a, b>> =
  {
    put: |w: Bytes, r: Result<a, b>| put_result(w, r, ok.put, err.put),
    take: |d: Bytes, at: Int| take_result(d, at, ok.take, err.take),
    shape: |shapes: Shapes| applied_shape(shapes, "Result", [ok.shape, err.shape]),
  }

/// Appends `Continue` or `Stop`, tagged as a variant.
pub fn put_iter<a, b>(
  w: Bytes,
  i: Iter<a, b>,
  put_more: Put<a>,
  put_done: Put<b>,
) -> Bytes / {abort.raise} =
  match i { Continue(x) -> put_more(put_tag(w, 0), x), Stop(x) -> put_done(put_tag(w, 1), x) }

/// Reads an `Iter` at `at`.
pub fn take_iter<a, b>(
  d: Bytes,
  at: Int,
  take_more: Take<a>,
  take_done: Take<b>,
) -> Result<Taken<Iter<a, b>>, BinError> / {abort.raise} =
  match take_tag(d, at, 2) {
    Err(e) -> Err(e),
    Ok(t) -> if t.value == 0 {
      match take_more(d, t.at) { Err(e) -> Err(e), Ok(x) -> ok_at(Continue(x.value), x.at) }
    } else { match take_done(d, t.at) { Err(e) -> Err(e), Ok(x) -> ok_at(Stop(x.value), x.at) } },
  }

/// Returns a codec that writes `Continue` as one tag and `Stop` as another tag, each followed by
/// its value.
pub fn iter_bin<a, b>(more: BinCodec<a>, done: BinCodec<b>) -> BinCodec<Iter<a, b>> =
  {
    put: |w: Bytes, i: Iter<a, b>| put_iter(w, i, more.put, done.put),
    take: |d: Bytes, at: Int| take_iter(d, at, more.take, done.take),
    shape: |shapes: Shapes| applied_shape(shapes, "Iter", [more.shape, done.shape]),
  }

/// Appends an `Instant` as its nanoseconds.
pub fn put_instant(w: Bytes, t: Instant) -> Bytes / {abort.raise} =
  match t { Instant(n) -> put_int(w, n) }

/// Reads an `Instant` at `at`.
pub fn take_instant(d: Bytes, at: Int) -> Result<Taken<Instant>, BinError> / {abort.raise} =
  match take_int(d, at) { Err(e) -> Err(e), Ok(t) -> ok_at(Instant(t.value), t.at) }

/// Returns a codec that writes an `Instant` as its number of nanoseconds.
pub fn instant_bin() -> BinCodec<Instant> =
  {
    put: put_instant,
    take: take_instant,
    shape: |shapes: Shapes| applied_shape(shapes, "Instant", []),
  }

/// Appends a `Duration` as its nanoseconds.
pub fn put_duration(w: Bytes, t: Duration) -> Bytes / {abort.raise} =
  match t { Duration(n) -> put_int(w, n) }

/// Reads a `Duration` at `at`.
pub fn take_duration(d: Bytes, at: Int) -> Result<Taken<Duration>, BinError> / {abort.raise} =
  match take_int(d, at) { Err(e) -> Err(e), Ok(t) -> ok_at(Duration(t.value), t.at) }

/// The codec of `Duration`, as its nanoseconds.
pub fn duration_bin() -> BinCodec<Duration> =
  {
    put: put_duration,
    take: take_duration,
    shape: |shapes: Shapes| applied_shape(shapes, "Duration", []),
  }

/// Appends an `Ordering` as its constructor's index.
pub fn put_ordering(w: Bytes, o: Ordering) -> Bytes / {abort.raise} =
  put_tag(w, match o { Less -> 0, Equal -> 1, Greater -> 2 })

/// Reads an `Ordering` at `at`.
pub fn take_ordering(d: Bytes, at: Int) -> Result<Taken<Ordering>, BinError> / {abort.raise} =
  match take_tag(d, at, 3) {
    Err(e) -> Err(e),
    Ok(t) -> ok_at(match t.value { 0 -> Less, 1 -> Equal, _ -> Greater }, t.at),
  }

/// The codec of `Ordering`.
pub fn ordering_bin() -> BinCodec<Ordering> =
  {
    put: put_ordering,
    take: take_ordering,
    shape: |shapes: Shapes| applied_shape(shapes, "Ordering", []),
  }

/// Appends a `Rounding` as its constructor's index.
pub fn put_rounding(w: Bytes, r: Rounding) -> Bytes / {abort.raise} =
  put_tag(w, match r { HalfEven -> 0, HalfUp -> 1, Down -> 2, Up -> 3, Ceiling -> 4, Floor -> 5 })

/// Reads a `Rounding` at `at`.
pub fn take_rounding(d: Bytes, at: Int) -> Result<Taken<Rounding>, BinError> / {abort.raise} =
  match take_tag(d, at, 6) {
    Err(e) -> Err(e),
    Ok(t) ->
      ok_at(
        match t.value { 0 -> HalfEven, 1 -> HalfUp, 2 -> Down, 3 -> Up, 4 -> Ceiling, _ -> Floor },
        t.at,
      ),
  }

/// The codec of `Rounding`.
pub fn rounding_bin() -> BinCodec<Rounding> =
  {
    put: put_rounding,
    take: take_rounding,
    shape: |shapes: Shapes| applied_shape(shapes, "Rounding", []),
  }

/// Returns the bytes that encode `x` with `codec`.
pub fn encode<a>(x: a, codec: BinCodec<a>) -> Bytes / {abort.raise} = (codec.put)(b"", x)

/// Returns the value that the bytes `data` encode with `codec`. Fails if bytes remain after the
/// value, or if `data` ends inside it.
pub fn decode<a>(data: Bytes, codec: BinCodec<a>) -> Result<a, BinError> / {abort.raise} =
  match (codec.take)(data, 0) {
    Err(e) -> Err(e),
    Ok(t) -> if t.at == data.len() { Ok(t.value) }
    else { Err(rejected(t.at, "bytes follow the value")) },
  }

/// Whether `x`, written with `codec`, reads back as itself.
pub fn round_trips<a>(x: a, codec: BinCodec<a>) -> Bool / {abort.raise} =
  decode(encode(x, codec), codec) == Ok(x)

/// Returns the 32-byte digest of the codec's type. Two codecs for the same definition have equal
/// digests. The digest changes when a field, constructor, name or order changes anywhere in the
/// type, including nested types.
pub fn shape_digest<a>(codec: BinCodec<a>) -> Bytes / {abort.raise} =
  (codec.shape)({ done: Map::new(), open: [] }).digest

test "an `Int` encodes as a varint of seven bits per byte, least significant first, and takes at most ten bytes" {
  assert_eq(encode(0, int_bin()), b"\x00");
  assert_eq(encode(0 - 1, int_bin()), b"\x01");
  assert_eq(encode(1, int_bin()), b"\x02");
  assert_eq(encode(64, int_bin()), b"\x80\x01");
  assert_eq(encode(9223372036854775807, int_bin()).len(), 10);
  assert(round_trips(9223372036854775807, int_bin()));
  assert(round_trips(0 - 9223372036854775807 - 1, int_bin()));
  assert_eq(put_varint(b"", 300), b"\xac\x02")
}

test "every scalar type decodes back to its original value, and a NaN keeps its exact bits" {
  assert(round_trips((), unit_bin()));
  assert(round_trips(true, bool_bin()) && round_trips(false, bool_bin()));
  assert(round_trips("héllo", string_bin()));
  assert(round_trips(b"\x00\xff", bytes_bin()));
  assert(round_trips(1.5, float_bin()) && round_trips(0.0 - 2.5, float_bin()));
  let nan = Float::of_bits(0x7FF8_0000_0000_0001);
  match decode(encode(nan, float_bin()), float_bin()) {
    Ok(f) -> assert_eq(bits_of_float(f), bits_of_float(nan)),
    Err(e) -> assert(false),
  };
  assert_eq(
    Decimal::to_string(match decode(encode(1.50m, decimal_bin()), decimal_bin()) {
      Ok(d) -> d,
      Err(e) -> Decimal::of_int(0),
    }),
    "1.50",
  )
}

test "every fixed-width integer type decodes back to its original value at both ends of its range" {
  assert(round_trips(0u8, u8_bin()) && round_trips(255u8, u8_bin()));
  assert(round_trips(I8::of_int(0 - 128), i8_bin()) && round_trips(127i8, i8_bin()));
  assert(round_trips(65535u16, u16_bin()) && round_trips(4294967295u32, u32_bin()));
  assert(round_trips(0xFFFF_FFFF_FFFF_FFFFu64, u64_bin()) && round_trips(0u64, u64_bin()));
  assert(round_trips(I16::of_int(0 - 32768), i16_bin()) && round_trips(2147483647i32, i32_bin()));
  assert(round_trips(I64::of_int(0 - 9223372036854775807 - 1), i64_bin()));
  let top = match U128::of_string("340282366920938463463374607431768211455") {
    Some(n) -> n,
    None -> 0u128,
  };
  assert(round_trips(top, u128_bin()) && round_trips(0u128, u128_bin()));
  assert_eq(encode(top, u128_bin()).len(), 19);
  let least = match I128::of_string("-170141183460469231731687303715884105728") {
    Some(n) -> n,
    None -> 0i128,
  };
  assert(round_trips(least, i128_bin()) && round_trips(0i128 - (least + 1i128), i128_bin()));
  assert(round_trips(0i128 - 1i128, i128_bin()))
}

test "lists, maps, options, results and user-defined sum types decode back to their original values" {
  assert(round_trips([1, 2, 3], list_bin(int_bin())));
  assert(round_trips([(), ()], list_bin(unit_bin())));
  assert(round_trips(Map::new().insert("b", 2).insert("a", 1), map_bin(string_bin(), int_bin())));
  assert(round_trips(Some(Some(())), option_bin(option_bin(unit_bin()))));
  assert(round_trips(None, option_bin(int_bin())));
  assert(round_trips(Err("no"), result_bin(int_bin(), string_bin())));
  assert(round_trips(Stop(3), iter_bin(string_bin(), int_bin())));
  assert(round_trips(Greater, ordering_bin()) && round_trips(Floor, rounding_bin()))
}

test "an array encodes to the same bytes as the equivalent list, but `shape_digest` (a hash of the format's structure) differs between them" {
  assert(round_trips(Array::of_list([1, 2, 3]), array_bin(int_bin())));
  assert(round_trips(Array::new(0, ()), array_bin(unit_bin())));
  assert_eq(encode(Array::of_list([7]), array_bin(int_bin())), encode([7], list_bin(int_bin())));
  assert(shape_digest(array_bin(int_bin())) != shape_digest(list_bin(int_bin())))
}

test "a character encodes as its scalar value, and decoding a number that is not a scalar value fails" {
  assert_eq(encode('a', char_bin()), b"a");
  assert(round_trips('\u{1F600}', char_bin()) && round_trips('\u{0}', char_bin()));
  assert(round_trips(['h', 'é'], list_bin(char_bin())));
  assert_eq(
    decode(put_varint(b"", 55296), char_bin()),
    Err({ at: 0, message: "a number that is not a valid character code" }),
  );
  assert(decode(put_varint(b"", 1114112), char_bin()) != Ok('a'))
}

test "an instant and a duration each encode as their nanoseconds, and the `shape_digest` of each format differs from the other's" {
  assert(
    round_trips(Instant(0 - 5), instant_bin())
      && round_trips(Duration(1_000_000_000), duration_bin()),
  );
  assert_eq(encode(Duration(1), duration_bin()), encode(1, int_bin()));
  assert(shape_digest(instant_bin()) != shape_digest(duration_bin()));
  assert(shape_digest(duration_bin()) != shape_digest(int_bin()))
}

test "a reader rejects bytes that end early, bytes left over and bytes no value encodes to" {
  let c = list_bin(int_bin());
  let full = encode([1, 2, 3], c);
  assert_eq(decode(b"\x80", int_bin()), Err({ at: 1, message: "the bytes end inside a value" }));
  assert_eq(
    decode(full.slice(0, 3), c),
    Err({ at: 0, message: "a count larger than the number of bytes left" }),
  );
  assert_eq(decode(full ++ b"\x00", c), Err({ at: 4, message: "bytes follow the value" }));
  assert(decode(b"\x02", bool_bin()) != Ok(true));
  assert(decode(b"\x80\x00", int_bin()) != Ok(0));
  assert(decode(b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\x02", int_bin()) != Ok(0));
  assert(decode(b"\x01\xff", string_bin()) != Ok(""));
  assert(decode(b"\x05", list_bin(unit_bin())) != Ok([]));
  assert(decode(b"\x03", ordering_bin()) != Ok(Less));
  assert(decode(b"\x02\x02\x00\x00\x00", map_bin(int_bin(), unit_bin())) != Ok(Map::new()));
  assert(decode(b"\x80\x02", u8_bin()) != Ok(0u8));
  assert(decode(b"\x80\x80\x04", u16_bin()) != Ok(0u16))
}

test "`shape_digest` differs when the structure differs, and differs when a field name differs" {
  assert_eq(shape_digest(int_bin()).len(), 32);
  assert(shape_digest(int_bin()) != shape_digest(i64_bin()));
  assert(shape_digest(list_bin(int_bin())) != shape_digest(option_bin(int_bin())));
  assert_eq(shape_digest(list_bin(int_bin())), shape_digest(list_bin(int_bin())));
  let a: Shape = |shapes: Shapes| record_shape(shapes, [{ name: "a", shape: int_bin().shape }]);
  let b: Shape = |shapes: Shapes| record_shape(shapes, [{ name: "b", shape: int_bin().shape }]);
  assert(a({ done: Map::new(), open: [] }).digest != b({ done: Map::new(), open: [] }).digest);
  assert(shape_digest(tree()) != shape_digest(list_bin(tree())))
}

fn tree() -> BinCodec<List<Int>> = tree_at(max_depth())

fn tree_at(depth: Int) -> BinCodec<List<Int>> =
  if depth <= 0 { too_deep() } else {
    {
      put: |w: Bytes, xs: List<Int>| w,
      take: |d: Bytes, at: Int| ok_at([], at),
      shape: |shapes: Shapes|
        sum_shape(shapes, "t.Tree", "Tree", [], [
          { name: "Leaf", fields: [] },
          { name: "Node", fields: [tree_at(depth - 1).shape, tree_at(depth - 1).shape] },
        ]),
    }
  }

test "a list of strings survives the round trip" {
  gen::check(gen::list(gen::text()), |xs: List<String>| { round_trips(xs, list_bin(string_bin())) })
}
