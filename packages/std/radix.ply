//! Encodes bytes as text over an alphabet of 2 to 64 symbols. Hex, base32 and base64 are one
//! encoding, each with its own `Alphabet`.
//!
//! The bytes are read as one sequence of bits, starting from the first byte's high bit, and split
//! into groups of `bits` bits. Each group is written as the symbol for its value, and a last group
//! with too few bits is filled with zeros. A padded alphabet then adds `=` until the text is a
//! whole number of quanta. A quantum is the fewest symbols that carry a whole number of bytes: two
//! for hex, eight for base32 and four for base64.
//!
//! `decode` accepts exactly the texts `encode` writes. It rejects a symbol outside the alphabet or
//! in the other case, a `=` anywhere but the end, the wrong number of `=`, a last symbol that
//! completes no byte, and fill bits that are not zero. So decoding an encoding returns the bytes,
//! and encoding a decoding returns the text. To accept text as a person typed it, first convert it
//! to the canonical form with a separate function, as `std.base32`'s `normalize` does.
//!
//! An alphabet contains lookup tables for both directions, so build it once and reuse it. The
//! alphabets defined here are constants. Build one of your own with `alphabet` inside a `const fn`,
//! as they are, so it is built once. At four, five and six bits per symbol, encoding and decoding
//! process one whole quantum at a time and allocate only to grow the result. A narrower alphabet is
//! processed one symbol at a time. The work depends only on the length of the input, not on its
//! contents. `std.base64`, `std.base32`, `std.hex` and `std.bytes`'s `hex_of` are this module with
//! one alphabet each.

import std.gen

/// The symbols a text is written in, whether the text is padded, and lookup tables built from
/// them. Only `alphabet` creates one, so every `Alphabet` is a valid encoding.
pub opaque type Alphabet = new {
  /// The symbol for each value, lowest value first: `2^bits` distinct printable ASCII bytes, none
  /// of them `=`.
  symbols: Bytes,
  /// How many bits a symbol carries, one to six.
  bits: Int,
  /// Whether `=` fills a text to a whole number of quanta.
  padded: Bool,
  /// The symbol for each value as a `String`, so an encoder appends it without checking it again.
  singles: Array<String>,
  /// The two symbols for each value of `2 * bits` bits, so an encoder writes both in one step.
  pairs: Array<String>,
  /// For each byte, the value of the symbol it is, or 255 for a byte that is not a symbol.
  values: Bytes,
}

/// Why `parse` rejects a text; `decode` returns `None` for the same texts. `InvalidSymbol` means a
/// byte is not a symbol of the alphabet where a symbol is required, as a `=` before the end of the
/// text is. `BadPaddedLength` means a padded text is not a whole number of quanta. `TrailingSymbol`
/// means the last symbol completes no byte. `NonzeroTrailingBits` means the fill bits of the last
/// symbol are not zero.
pub type ErrorKind = | InvalidSymbol | BadPaddedLength | TrailingSymbol | NonzeroTrailingBits

/// A decoding error, and the offset of the character it is about. For `BadPaddedLength` the offset
/// is the length of the text.
pub type Error = new { reason: ErrorKind, at: Int }

/// The alphabet whose symbols, lowest value first, are `symbols`. `None` unless they are 2, 4, 8,
/// 16, 32 or 64 distinct printable ASCII bytes other than `=`. Building one fills its tables, a
/// step for each pair of symbols, so build an alphabet once and reuse it.
pub fn alphabet(symbols: Bytes, padded: Bool) -> Option<Alphabet> / {abort.raise} = {
  let bits = range(1, 7).fold(0, |found: Int, b: Int|
    if symbols.len() == 1 << b { b } else { found });
  let distinct = range(0, symbols.len()).fold(bits > 0, |ok: Bool, i: Int| {
    let c = symbols.at(i);
    ok && c > 32 && c < 127 && c != 61 && symbols.index_of_byte(c) == Some(i)
  });
  if !distinct { None } else {
    let letters = String::of_bytes(symbols);
    let singles = Array::of_list(range(0, symbols.len()).map(|v: Int| letters.slice(v, v + 1)));
    Some({
      symbols: symbols,
      singles: singles,
      bits: bits,
      padded: padded,
      pairs: Array::of_list(
        range(0, 1 << 2 * bits).map(|v: Int|
          singles.get(v >>> bits) ++ singles.get(v & (1 << bits) - 1)),
      ),
      values: Bytes::concat_all(
        range(0, 256).map(|c: Int|
          byte_of_int(match symbols.index_of_byte(c) { Some(v) -> v, None -> 255 })),
      ),
    })
  }
}

/// Returns the hex alphabet in upper case: `0-9A-F`, unpadded.
pub const fn base16() -> Alphabet = named(b"0123456789ABCDEF", false)

/// Returns the hex alphabet in lower case: `0-9a-f`, unpadded. This is the usual way to write a
/// hash.
pub const fn hex() -> Alphabet = named(b"0123456789abcdef", false)

/// Returns the standard base32 alphabet: `A-Z2-7`, padded.
pub const fn base32() -> Alphabet = named(b"ABCDEFGHIJKLMNOPQRSTUVWXYZ234567", true)

/// Returns the base32hex alphabet: `0-9A-V`, padded. Texts sort in the same order as the bytes they
/// encode.
pub const fn base32hex() -> Alphabet = named(b"0123456789ABCDEFGHIJKLMNOPQRSTUV", true)

/// Returns Crockford's base32 alphabet: `0-9A-Z` without `I`, `L`, `O` and `U`, unpadded.
///
/// Like every alphabet here, it takes bits starting from the first byte. A ULID, a 26-character
/// identifier written in this alphabet, instead fills its characters starting from the last bit.
/// The two give the same text only when the input is a multiple of five bytes long.
pub const fn crockford() -> Alphabet = named(b"0123456789ABCDEFGHJKMNPQRSTVWXYZ", false)

/// Returns the standard base64 alphabet: `A-Za-z0-9+/`, padded.
pub const fn base64() -> Alphabet =
  named(b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", true)

/// Returns the URL-safe base64 alphabet: `A-Za-z0-9-_`, unpadded. URLs and JWTs use it.
pub const fn base64url() -> Alphabet =
  named(b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_", false)

/// `a`, with its texts padded with `=`.
pub fn padded(a: Alphabet) -> Alphabet = { ..a, padded: true }

/// `a`, with its texts unpadded.
pub fn unpadded(a: Alphabet) -> Alphabet = { ..a, padded: false }

/// `data` in the alphabet's symbols.
pub fn encode(a: Alphabet, data: Bytes) -> String / {abort.raise} = {
  let whole = bytes_before_tail(a.bits, data.len());
  let head = if a.bits == 4 { encode_4bit_quanta(a.pairs, data, 0, whole, "") }
  else if a.bits == 6 { encode_6bit_quanta(a.pairs, data, 0, whole, "") }
  else if a.bits == 5 { encode_5bit_quanta(a.pairs, data, 0, whole, "") }
  else { "" };
  if whole == data.len() { head } else { encode_from(a, data, whole, head) }
}

/// Decodes `text` into bytes. Returns `None` when `text` is not a valid encoding in this alphabet.
pub fn decode(a: Alphabet, text: String) -> Option<Bytes> / {abort.raise} =
  match parse(a, text) { Ok(data) -> Some(data), Err(_) -> None }

/// The bytes `text` encodes, or an error that reports where and why it is not a valid encoding.
pub fn parse(a: Alphabet, text: String) -> Result<Bytes, Error> / {abort.raise} = {
  let t = Bytes::of_string(text);
  let body = t.len() - padding_length(a, t);
  match find_error(a, t, body) {
    Some(r) -> Err(r),
    None -> {
      let whole = symbols_before_tail(a.bits, body);
      let head = if a.bits == 4 { decode_4bit_quanta(a.values, t, 0, whole, b"") }
      else if a.bits == 6 { decode_6bit_quanta(a.values, t, 0, whole, b"") }
      else if a.bits == 5 { decode_5bit_quanta(a.values, t, 0, whole, b"") }
      else { b"" };
      Ok(if whole == body { head } else { decode_tail(a, t, whole, body, head) })
    },
  }
}

/// `text` cut into lines of `columns` characters, the last one shorter when the width does not
/// divide the text. An empty text has no lines. Raises for a width below one.
pub fn wrap(text: String, columns: Int) -> List<String> / {abort.raise} =
  if columns < 1 { panic("a line is at least one column wide") } else {
    range(0, (text.len() + columns - 1) / columns).map(|i: Int|
      text.slice(i * columns, min(text.len(), (i + 1) * columns)))
  }

fn named(symbols: Bytes, padded: Bool) -> Alphabet / {abort.raise} =
  match alphabet(symbols, padded) {
    Some(a) -> a,
    None -> panic("these symbols do not form a valid alphabet"),
  }

fn quantum(bits: Int) -> Int = if bits % 4 == 0 { 2 } else if bits % 2 == 0 { 4 } else { 8 }

fn bytes_before_tail(bits: Int, n: Int) -> Int =
  if bits == 4 { n } else if bits == 6 { n - n % 3 } else if bits == 5 { n - n % 5 } else { 0 }

fn symbols_before_tail(bits: Int, n: Int) -> Int =
  if bits == 4 { n - n % 2 }
  else if bits == 6 { n - n % 4 }
  else if bits == 5 { n - n % 8 }
  else { 0 }

fn encode_4bit_quanta(
  pairs: Array<String>,
  data: Bytes,
  at: Int,
  end: Int,
  out: String,
) -> String / {abort.raise} =
  if at >= end { out }
  else { encode_4bit_quanta(pairs, data, at + 1, end, out ++ pairs.get(data.at(at))) }

fn encode_6bit_quanta(
  pairs: Array<String>,
  data: Bytes,
  at: Int,
  end: Int,
  out: String,
) -> String / {abort.raise} =
  if at >= end { out } else {
    let w = data.at(at) << 16 | data.at(at + 1) << 8 | data.at(at + 2);
    encode_6bit_quanta(pairs, data, at + 3, end, out ++ pairs.get(w >>> 12) ++ pairs.get(w & 0xFFF))
  }

fn encode_5bit_quanta(
  pairs: Array<String>,
  data: Bytes,
  at: Int,
  end: Int,
  out: String,
) -> String / {abort.raise} =
  if at >= end { out } else {
    let w = data.at(at) << 32 | data.at(at + 1) << 24 | data.at(at + 2) << 16 | data.at(at + 3) << 8
      | data.at(at + 4);
    encode_5bit_quanta(
      pairs,
      data,
      at + 5,
      end,
      out ++ pairs.get(w >>> 30) ++ pairs.get(w >>> 20 & 0x3FF) ++ pairs.get(w >>> 10 & 0x3FF)
        ++ pairs.get(w & 0x3FF),
    )
  }

fn encode_from(a: Alphabet, data: Bytes, from: Int, out: String) -> String / {abort.raise} = {
  let count = (data.len() * 8 + a.bits - 1) / a.bits;
  let fill = if a.padded { (quantum(a.bits) - count % quantum(a.bits)) % quantum(a.bits) }
  else { 0 };
  filled(symbols_from(a, data, from * 8 / a.bits, count, out), fill)
}

fn symbols_from(
  a: Alphabet,
  data: Bytes,
  j: Int,
  last: Int,
  out: String,
) -> String / {abort.raise} =
  if j >= last { out }
  else { symbols_from(a, data, j + 1, last, out ++ symbol(a, data, j * a.bits)) }

fn filled(out: String, n: Int) -> String = if n <= 0 { out } else { filled(out ++ "=", n - 1) }

fn symbol(a: Alphabet, data: Bytes, at: Int) -> String / {abort.raise} = {
  let i = at >>> 3;
  let low = if i + 1 < data.len() { data.at(i + 1) } else { 0 };
  let v = (data.at(i) << 8 | low) >>> 16 - (at & 7) - a.bits & (1 << a.bits) - 1;
  a.singles.get(v)
}

fn padding_length(a: Alphabet, t: Bytes) -> Int / {abort.raise} =
  if a.padded {
    range(1, quantum(a.bits)).fold(0, |c: Int, k: Int|
      if c == k - 1 && k <= t.len() && t.at(t.len() - k) == 61 { k } else { c })
  } else { 0 }

fn find_error(a: Alphabet, t: Bytes, body: Int) -> Option<Error> / {abort.raise} = {
  let stray = t.scan(0, a.symbols, body);
  let spare = body * a.bits % 8;
  if stray < body { Some({ reason: InvalidSymbol, at: stray }) }
  else if a.padded && t.len() % quantum(a.bits) != 0 {
    Some({ reason: BadPaddedLength, at: t.len() })
  } else if spare >= a.bits { Some({ reason: TrailingSymbol, at: body - 1 }) }
  else if spare > 0 && a.values.at(t.at(body - 1)) & (1 << spare) - 1 != 0 {
    Some({ reason: NonzeroTrailingBits, at: body - 1 })
  } else { None }
}

fn decode_4bit_quanta(
  values: Bytes,
  t: Bytes,
  at: Int,
  end: Int,
  out: Bytes,
) -> Bytes / {abort.raise} =
  if at >= end { out } else {
    let w = values.at(t.at(at)) << 4 | values.at(t.at(at + 1));
    decode_4bit_quanta(values, t, at + 2, end, out ++ byte_of_int(w))
  }

fn decode_6bit_quanta(
  values: Bytes,
  t: Bytes,
  at: Int,
  end: Int,
  out: Bytes,
) -> Bytes / {abort.raise} =
  if at >= end { out } else {
    let w = values.at(t.at(at)) << 18 | values.at(t.at(at + 1)) << 12 | values.at(t.at(at + 2)) << 6
      | values.at(t.at(at + 3));
    decode_6bit_quanta(
      values,
      t,
      at + 4,
      end,
      out ++ byte_of_int(w >>> 16) ++ byte_of_int(w >>> 8 & 0xFF) ++ byte_of_int(w & 0xFF),
    )
  }

fn decode_5bit_quanta(
  values: Bytes,
  t: Bytes,
  at: Int,
  end: Int,
  out: Bytes,
) -> Bytes / {abort.raise} =
  if at >= end { out } else {
    let w = values.at(t.at(at)) << 35 | values.at(t.at(at + 1)) << 30
      | values.at(t.at(at + 2)) << 25
      | values.at(t.at(at + 3)) << 20
      | values.at(t.at(at + 4)) << 15
      | values.at(t.at(at + 5)) << 10
      | values.at(t.at(at + 6)) << 5
      | values.at(t.at(at + 7));
    decode_5bit_quanta(
      values,
      t,
      at + 8,
      end,
      out ++ byte_of_int(w >>> 32) ++ byte_of_int(w >>> 24 & 0xFF) ++ byte_of_int(w >>> 16 & 0xFF)
        ++ byte_of_int(w >>> 8 & 0xFF)
        ++ byte_of_int(w & 0xFF),
    )
  }

fn decode_tail(a: Alphabet, t: Bytes, at: Int, end: Int, out: Bytes) -> Bytes / {abort.raise} =
  octets_from(a, t, at * a.bits / 8, end * a.bits / 8, out)

fn octets_from(a: Alphabet, t: Bytes, k: Int, last: Int, out: Bytes) -> Bytes / {abort.raise} =
  if k >= last { out } else { octets_from(a, t, k + 1, last, out ++ octet(a, t, k)) }

fn octet(a: Alphabet, t: Bytes, k: Int) -> Bytes / {abort.raise} = {
  let first = k * 8 / a.bits;
  let past = (k * 8 + 7) / a.bits + 1;
  byte_of_int(symbol_bits(a, t, first, past, 0) >>> past * a.bits - k * 8 - 8 & 0xFF)
}

fn symbol_bits(a: Alphabet, t: Bytes, i: Int, past: Int, m: Int) -> Int / {abort.raise} =
  if i >= past { m } else { symbol_bits(a, t, i + 1, past, m << a.bits | a.values.at(t.at(i))) }

fn named_and_narrow() -> List<Alphabet> / {abort.raise} =
  [
    base16(),
    hex(),
    base32(),
    base32hex(),
    crockford(),
    base64(),
    base64url(),
    named(b"01", false),
    named(b"ACGT", false),
    named(b"01234567", false),
  ]

fn all_alphabets() -> List<Alphabet> / {abort.raise} =
  named_and_narrow().fold([], |all: List<Alphabet>, a: Alphabet|
    all.push(padded(a)).push(unpadded(a)))

fn altered(text: String, at: Int, to: Int) -> String / {abort.raise} = {
  let t = Bytes::of_string(text);
  let n = t.len();
  if n == 0 { text } else {
    let i = (at % n + n) % n;
    String::of_bytes(Bytes::concat_all([t.slice(0, i), byte_of_int(to & 0x7F), t.slice(i + 1, n)]))
  }
}

fn repeated_to_length(data: Bytes, n: Int) -> Bytes / {abort.raise} = {
  let want = (n % 64 + 64) % 64;
  let seed = data.concat(b"\x00\xff\x5a");
  Bytes::concat_all(range(0, want / seed.len() + 1).map(|_: Int| seed)).slice(0, want)
}

test "`decode` of an encoded string with one character changed fails, or returns bytes that `encode` turns back into the changed string" {
  gen::check3(gen::bytes(), gen::any_int(), gen::any_int(), |data: Bytes, at: Int, to: Int| {
    all_alphabets().fold(true, |ok: Bool, a: Alphabet| {
      let text = altered(encode(a, repeated_to_length(data, at)), at, to);
      ok && (match decode(a, text) { None -> true, Some(read) -> encode(a, read) == text })
    })
  })
}

test "`encode` output decodes back to the original bytes, and decoding the final partial group with `decode_tail` gives the same bytes as `decode`" {
  gen::check2(gen::bytes(), gen::any_int(), |data: Bytes, n: Int| {
    all_alphabets().fold(true, |ok: Bool, a: Alphabet| {
      let bytes = repeated_to_length(data, n);
      let text = encode_from(a, bytes, 0, "");
      let body = Bytes::of_string(text).len() - padding_length(a, Bytes::of_string(text));
      ok && encode(a, bytes) == text && decode(a, text) == Some(bytes)
        && decode_tail(a, Bytes::of_string(text), 0, body, b"") == bytes
    })
  })
}

test "an alphabet is made only of distinct printable symbols, a power of two of them" {
  assert(alphabet(b"01", false) != None);
  assert(alphabet(b"!~", true) != None);
  assert_eq(alphabet(b"=1", false), None);
  assert_eq(alphabet(b"0\x7f", false), None);
  assert_eq(alphabet(b"0 ", false), None);
  assert_eq(alphabet(b"012", false), None);
  assert_eq(alphabet(b"0123456789abcdeF0", false), None);
  assert_eq(alphabet(b"0123456789abcde0", false), None);
  assert_eq(alphabet(b"0123456789abcde=", false), None);
  assert_eq(alphabet(b"", false), None);
  assert_eq(alphabet(b"0", false), None);
  assert_eq(named_and_narrow().map(|a: Alphabet| a.bits), [4, 4, 5, 5, 5, 6, 6, 1, 2, 3])
}

test "an alphabet's `pairs` lists every two-symbol combination, and its `values` maps each byte to a symbol value" {
  let a = base32();
  assert_eq(a.pairs.len(), 1024);
  assert_eq(a.pairs.get(0), "AA");
  assert_eq(a.pairs.get(33), "BB");
  assert_eq(a.pairs.get(1023), "77");
  assert_eq(a.values.len(), 256);
  assert_eq([65, 90, 50, 55].map(|c: Int| a.values.at(c)), [0, 25, 26, 31]);
  assert_eq([97, 61, 0, 255].map(|c: Int| a.values.at(c)), [255, 255, 255, 255]);
  assert_eq(padded(unpadded(a)), a)
}

test "alphabets of one to six bits per symbol encode and decode bytes" {
  let binary = named(b"01", false);
  let octal = named(b"01234567", true);
  assert_eq(encode(binary, b"\xa5"), "10100101");
  assert_eq(decode(binary, "10100101"), Some(b"\xa5"));
  assert_eq(encode(octal, b"\xff"), "776=====");
  assert_eq(encode(octal, b"\xff\xff"), "777774==");
  assert_eq(encode(octal, b"\xff\xff\xff"), "77777777");
  assert_eq(decode(octal, "776====="), Some(b"\xff"));
  assert_eq(decode(octal, "777774=="), Some(b"\xff\xff"));
  assert_eq(decode(octal, "777====="), None)
}

test "an alphabet can be padded or unpadded" {
  assert_eq(encode(base32(), b"f"), "MY======");
  assert_eq(encode(unpadded(base32()), b"f"), "MY");
  assert_eq(encode(padded(base64url()), b"f"), "Zg==");
  assert_eq(decode(unpadded(base32()), "MY======"), None);
  assert_eq(decode(base32(), "MY"), None);
  assert_eq(encode(padded(hex()), b"f"), "66")
}

test "an error reports where the text stops being an encoding, and why" {
  assert_eq(parse(base32(), "MZXW6==="), Ok(b"foo"));
  assert_eq(parse(base32(), "MZxW6==="), Err({ reason: InvalidSymbol, at: 2 }));
  assert_eq(parse(base32(), "MZ=W6==="), Err({ reason: InvalidSymbol, at: 2 }));
  assert_eq(parse(base32(), "MZXW6=="), Err({ reason: BadPaddedLength, at: 7 }));
  assert_eq(parse(base32(), "MZXW6==========="), Err({ reason: InvalidSymbol, at: 5 }));
  assert_eq(parse(base32(), "MZX====="), Err({ reason: TrailingSymbol, at: 2 }));
  assert_eq(parse(base32(), "MZXW7==="), Err({ reason: NonzeroTrailingBits, at: 4 }));
  assert_eq(parse(hex(), "abc"), Err({ reason: TrailingSymbol, at: 2 }));
  assert_eq(parse(hex(), "aB"), Err({ reason: InvalidSymbol, at: 1 }));
  assert_eq(parse(base64url(), "Zh"), Err({ reason: NonzeroTrailingBits, at: 1 }));
  assert_eq(parse(base64(), "é"), Err({ reason: InvalidSymbol, at: 0 }));
  assert_eq(parse(base64(), "===="), Err({ reason: InvalidSymbol, at: 0 }));
  assert_eq(parse(base64(), "="), Err({ reason: BadPaddedLength, at: 1 }))
}

test "full groups of bytes and the final partial group decode back to the original bytes at every length from 0 to 40" {
  all_alphabets().fold((), |_: Unit, a: Alphabet|
    range(0, 41).fold((), |_: Unit, n: Int| {
      let bytes = repeated_to_length(b"\x01\x80\x7e", n);
      assert_eq(decode(a, encode(a, bytes)), Some(bytes))
    }))
}

test "`wrap` splits text into lines of the given width, and the last line is the shorter remainder" {
  assert_eq(wrap("abcdefgh", 3), ["abc", "def", "gh"]);
  assert_eq(wrap("abcdef", 3), ["abc", "def"]);
  assert_eq(wrap("ab", 3), ["ab"]);
  assert_eq(wrap("", 3), [])
}
