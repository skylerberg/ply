//! Sending mail: an SMTP client (RFC 5321), written as an engine over bytes and as sessions over
//! `std.net`.
//!
//! The protocol is an `Engine`, which is a plain value. `start` makes one for a newly opened
//! connection. `feed` gives it the bytes the server sent and returns a `Turn`: the bytes to write
//! back, and whether to wait for more, start TLS, accept a command or close. The engine reads no
//! socket and no clock, so an exchange is data, and a test is the server's lines plus the lines the
//! client must reply with. The engine greets with `EHLO`, and uses `HELO` only when the caller asks
//! for it. It reads the server's offers into `Capabilities`, upgrades with `STARTTLS` (RFC 3207),
//! and authenticates with `AUTH` (RFC 4954) using the mechanisms of `std.sasl`. It sends a message
//! as `MAIL FROM`, one `RCPT TO` per recipient, and `DATA`. It sends them together when the server
//! offers `PIPELINING`, and sends `RSET` before every message except the first in a session. A
//! `Reply` is a `Code`, its lines, and the enhanced `Status` (RFC 3463) that its text starts with.
//! `Limits`, which `config` takes, caps how much a server can make the client store.
//!
//! A `Config` states what the caller requires. TLS is required unless the config says otherwise. On
//! a connection that starts in the clear, the engine sends `STARTTLS`, rejects a server that does
//! not offer or accept it, and discards everything the server said before the handshake. Bytes that
//! arrive between the server's go-ahead and the handshake are rejected as `Injected`, so they are
//! never read as if TLS had carried them. A mechanism that sends the password itself is used only
//! over TLS, unless the caller sets `PasswordInClear`. No credential appears in an error, in what a
//! turn or an engine shows, or in the lines a session records. The client's side of an `AUTH`
//! exchange is a secret `Veiled` wire, which a session writes with `net.send_secret`.
//!
//! A message is bytes plus an `Envelope`, both from `std.email`. `send` writes a `Draft`, `relay`
//! forwards a `Message` as the bytes it was read from, and `submit` sends bytes and an envelope
//! unchanged. Nothing is repaired. These messages are rejected: bytes that are not CRLF lines of at
//! most 998 octets, a message larger than the server's `SIZE`, a message with a byte above 127 sent
//! to a server without `8BITMIME`, and a message whose addresses or header need `SMTPUTF8` sent to
//! a server without it. The result is a `Delivery` for each recipient: `Accepted`, `Temporary` or
//! `Permanent`, with the rejected command and the server's reply. A message that failed for one
//! recipient is therefore never reported as a plain success.
//!
//! A `Session` is an engine on a `std.net` connection, with a label chosen by the caller.
//! `open_tls` uses TLS from the first byte (port 465). `open` starts in the clear (ports 587 and
//! 25) and upgrades with `net.start_tls`, which verifies the server against the named host.
//! `with_session_tls` and `with_session` keep the session open only for the body, and close it
//! however the body ends. Each wait for a reply is limited by `Timeouts` for its phase, by default
//! the values of RFC 5321 section 4.5.3.2. The limit is one deadline on the clock, and each read
//! gets whatever time is left. An earlier deadline from `std.task` around the call takes priority,
//! so `task::timeout` around a session bounds the whole session. A caller who wants no limit says
//! so with `task::unbounded`.
//!
//! Not included: a queue with retries, looking up a domain's mail servers, DKIM signatures, and
//! `BDAT`.

import std.base64 (base64_decode, base64_encode)
import std.bytes
import std.dns
import std.email
import std.email (Address, Draft, Envelope, Message, NullPath, ReturnTo, email)
import std.gen
import std.gen (Gen)
import std.http (max_reads, read_size)
import std.ip
import std.laws (inverse)
import std.list
import std.net
import std.net (net, send_all)
import std.random (entropy, nonce)
import std.result
import std.sasl
import std.sasl (Credential, Exchange, Mechanism, sasl)
import std.show (show)
import std.string
import std.task
import std.time (after, millis, time)

/// The three digits a reply starts with (RFC 5321 §4.2), such as `250` or `550`. The first digit
/// reports what became of the command, and is all a client may base decisions on; the other two
/// give a person more detail.
pub opaque type Code = | Code(Int)

show for Code by code_text

fn code_text(c: Code) -> String = match c { Code(n) -> n.to_string() }

/// `n` as a code; `None` unless it is three digits of which the first is 2, 3, 4 or 5.
pub fn code(n: Int) -> Option<Code> = if n >= 200 && n <= 599 { Some(Code(n)) } else { None }

/// A code as a number, `250`.
pub fn number(c: Code) -> Int = match c { Code(n) -> n }

/// What a code's first digit means.
pub type Class =
  /// 2: the command was done.
  | Completed
  /// 3: the server waits for the rest of the command.
  | Intermediate
  /// 4: not now. The same command may succeed later.
  | Transient
  /// 5: no, and not later either.
  | Rejected

/// What a code's first digit means.
pub fn class_of(c: Code) -> Class =
  match c {
    Code(n) -> if n < 300 { Completed }
    else if n < 400 { Intermediate }
    else if n < 500 { Transient }
    else { Rejected },
  }

/// Generates the codes that RFC 5321 and its extensions name, and any other code from 200 to 599.
pub fn codes() -> Gen<Code> =
  gen::one_of([
    gen::map(
      gen::elements([
        220,
        221,
        235,
        250,
        251,
        334,
        354,
        421,
        450,
        451,
        452,
        454,
        500,
        502,
        503,
        530,
        535,
        550,
        552,
        554,
      ]),
      |n: Int| Code(n),
    ),
    gen::map(gen::int_between(200, 599), |n: Int| Code(n)),
  ])

/// An enhanced status code (RFC 3463), such as `5.1.1`: a class that is 2, 4 or 5, like a reply
/// code's first digit, then a subject and a detail. Where a reply code reports how the command
/// went, this reports why, in terms a program can act on: `x.1.1` is a mailbox that does not
/// exist, `x.2.2` one that is full, `x.7.1` a delivery not authorized.
pub opaque type Status = | Status(Int, Int, Int)

show for Status by status_text

fn status_text(s: Status) -> String =
  match s {
    Status(kind, subject, detail) ->
      kind.to_string() ++ "." ++ subject.to_string() ++ "." ++ detail.to_string(),
  }

/// The status of these three numbers; `None` unless the class is 2, 4 or 5 and the subject and
/// the detail are each from 0 to 999.
pub fn status(kind: Int, subject: Int, detail: Int) -> Option<Status> =
  if (kind == 2 || kind == 4 || kind == 5) && subject >= 0 && subject <= 999 && detail >= 0
      && detail <= 999 { Some(Status(kind, subject, detail)) }
  else { None }

/// A status's class, subject and detail: `[5, 1, 1]` of `5.1.1`.
pub fn status_parts(s: Status) -> List<Int> =
  match s { Status(kind, subject, detail) -> [kind, subject, detail] }

/// `text` as a status: three numbers between dots, with no sign and no spaces; `None` for
/// anything else.
pub fn read_status(text: String) -> Option<Status> / {abort.raise} =
  match text.split(".").map(|part: String|
      if part.len() < 1 || part.len() > 3 { None } else { Bytes::of_string(part).int_of_ascii() }) {
    [Some(kind), Some(subject), Some(detail)] -> status(kind, subject, detail),
    _ -> None,
  }

/// Generates a `Status` of any class (2, 4 or 5), with any subject and detail from 0 to 999.
pub fn statuses() -> Gen<Status> =
  gen::map2(
    gen::elements([2, 4, 5]),
    gen::map2(gen::int_between(0, 999), gen::int_between(0, 999), |subject: Int, detail: Int|
      [subject, detail]),
    |kind: Int, rest: List<Int>| Status(kind, rest.at_or(0, 0), rest.at_or(1, 0)),
  )

/// A server's reply to a command: a code, and one or more lines of text for a person.
///
/// A line contains no line break and no control character except a tab. Text a server sent that
/// is not UTF-8, or that contains a control character, is read with U+FFFD in its place, so that a
/// reply can be logged as it is.
pub opaque type Reply = new {
  code: Code,
  /// The text of each line, without its code. A reply has at least one, which may be empty.
  lines: List<String>,
}

/// The reply of this code and these lines; `None` for no lines, and for a line that contains a
/// control character other than a tab.
pub fn reply(c: Code, texts: List<String>) -> Option<Reply> =
  if texts.len() == 0 || !texts.all(is_text) { None } else { Some({ code: c, lines: texts }) }

fn is_text(line: String) -> Bool = line.chars().all(|c: Char| !is_control(c))

fn is_control(c: Char) -> Bool = (Int::of_char(c) < 32 && c != '\t') || Int::of_char(c) == 127

/// A reply's lines as one text, a line feed between them.
pub fn reply_text(r: Reply) -> String = String::join(r.lines, "\n")

/// The enhanced status a reply's text starts with, if it starts with one of the code's own class;
/// `None` otherwise. A server that offers `ENHANCEDSTATUSCODES` starts every reply to a command
/// after `EHLO` with one.
pub fn enhanced_status(r: Reply) -> Option<Status> / {abort.raise} =
  match r.lines.at_or(0, "").split(" ").first() {
    None -> None,
    Some(word) -> match read_status(word) {
      Some(Status(kind, subject, detail)) -> if kind == number(r.code) / 100 {
        Some(Status(kind, subject, detail))
      } else { None },
      None -> None,
    },
  }

/// Returns a reply as a server writes it to the connection. Every line starts with the code. The
/// code is followed by a hyphen on each line except the last, and by a space on the last. When the
/// last line's text is empty, the code stands alone.
pub fn render_reply(r: Reply) -> Bytes = {
  let digits = code_text(r.code);
  let end = r.lines.len() - 1;
  Bytes::of_string(
    String::join(
        list::enumerate(r.lines).map(|l: { index: Int, value: String }|
          if l.index < end { digits ++ "-" ++ l.value }
          else if l.value == "" { digits }
          else { digits ++ " " ++ l.value }),
        "\r\n",
      )
      ++ "\r\n",
  )
}

/// Replies of one line and of several, some of them empty, and some starting with a status.
pub fn replies() -> Gen<Reply> =
  gen::map2(
    codes(),
    gen::and_then(gen::int_between(1, 4), |n: Int|
      gen::list_of_length(
        gen::map2(
          gen::option_of(statuses()),
          gen::list_of(
            gen::elements([
              "OK",
              "mx.example",
              "PIPELINING",
              "8BITMIME",
              "SIZE",
              "10240000",
              "AUTH",
              "PLAIN",
              "caf\u{e9}",
              "<a@b.example>",
              "-",
              "\t",
              "Queued",
              "as",
              "4F2A",
            ]),
            4,
          ),
          |opening: Option<Status>, words: List<String>|
            String::join(
              List::concat(match opening { Some(s) -> [status_text(s)], None -> [] }, words),
              " ",
            ),
        ),
        n,
      )),
    |c: Code, texts: List<String>| { code: c, lines: texts },
  )

/// What a server may make a client store and do.
pub type Limits = new {
  /// Bytes in one line of a reply, its line break among them.
  line: Int,
  /// Bytes in one whole reply, over however many lines.
  reply: Int,
  /// The largest iteration count a SCRAM server may ask the client to use when hashing the
  /// password. A larger request is rejected.
  scram_iterations: Int,
  /// How many of the most recent lines sent or received a session stores for `transcript`. `0`
  /// stores none.
  transcript: Int,
}

/// Returns the default `Limits`: 4096 bytes per line, 65536 bytes per reply, at most 1000000 SCRAM
/// iterations, and no transcript. The line limit is larger than the 512 bytes RFC 5321 allows a
/// server to send.
pub fn default_limits() -> Limits =
  { line: 4096, reply: 65536, scram_iterations: 1000000, transcript: 0 }

/// A step of an SMTP session in which the client waits for the server. A `Phase` selects which
/// deadline applies and says where a timeout or other failure happened.
pub type Phase =
  /// The server's greeting, before the client sends anything.
  | Greeting
  /// The reply to `EHLO` or `HELO`.
  | Hello
  /// The reply to `STARTTLS`.
  | StartTls
  /// The TLS handshake.
  | Handshake
  /// A reply in an `AUTH` exchange.
  | Auth
  /// The reply to `RSET`.
  | Reset
  /// The reply to `MAIL FROM`.
  | Mail
  /// The reply to a `RCPT TO`.
  | Rcpt
  /// The reply to `DATA`: the go-ahead to send the message.
  | Data
  /// The reply to the message, after the dot that ends it.
  | Body
  /// The reply to `QUIT`.
  | Quit

/// How long, in milliseconds, each wait may last.
pub type Timeouts = new {
  /// How long to wait while connecting to the server and completing the TLS handshake.
  connect_ms: Int,
  /// The server's greeting.
  greeting_ms: Int,
  /// The reply to `MAIL FROM`.
  mail_ms: Int,
  /// The reply to one `RCPT TO`.
  rcpt_ms: Int,
  /// The reply to `DATA`.
  data_ms: Int,
  /// How long a single write to the server may take, whether it sends a command or one part of the
  /// message.
  block_ms: Int,
  /// The reply to the message, which a server sends only once it has taken responsibility for
  /// it.
  end_ms: Int,
  /// The reply to `EHLO`, `STARTTLS`, `RSET` and each step of `AUTH`.
  other_ms: Int,
  /// The reply to `QUIT`.
  quit_ms: Int,
}

/// Returns the default `Timeouts`. Where RFC 5321 §4.5.3.2 sets a minimum, the default is that
/// minimum: five minutes for the greeting, for `MAIL` and for each `RCPT`, two minutes for `DATA`,
/// three minutes for each write, and ten minutes for the reply to the message. For the other waits
/// the RFC sets no minimum: the defaults are five minutes for `EHLO`, `STARTTLS`, `RSET` and `AUTH`
/// replies, one minute to connect, and thirty seconds for the reply to `QUIT`.
pub fn default_timeouts() -> Timeouts =
  {
    connect_ms: 60000,
    greeting_ms: 300000,
    mail_ms: 300000,
    rcpt_ms: 300000,
    data_ms: 120000,
    block_ms: 180000,
    end_ms: 600000,
    other_ms: 300000,
    quit_ms: 30000,
  }

/// How long the wait for a phase's reply may last.
pub fn timeout(t: Timeouts, p: Phase) -> Int =
  match p {
    Greeting -> t.greeting_ms,
    Handshake -> t.connect_ms,
    Mail -> t.mail_ms,
    Rcpt -> t.rcpt_ms,
    Data -> t.data_ms,
    Body -> t.end_ms,
    Quit -> t.quit_ms,
    _ -> t.other_ms,
  }

/// An extension a message cannot be sent without.
pub type RequiredExtension =
  /// `8BITMIME` (RFC 6152): the message contains a byte past 127.
  | EightBitMime
  /// `SMTPUTF8` (RFC 6531): an address of the envelope, or the message's header, is outside
  /// ASCII.
  | SmtpUtf8
  /// `DSN` (RFC 3461): delivery reports were requested.
  | Notices

/// Why a session cannot continue, or a message is not sent.
pub type Error =
  /// The name to greet the server by is neither a domain nor an address literal.
  | BadClientName
  | Unreachable
  /// The connection stopped accepting bytes.
  | NotSent(Phase)
  /// No reply came within the phase's wait.
  | TimedOut(Phase)
  /// The server closed the connection before it replied. In `Body` the whole message was sent
  /// and may or may not have been accepted.
  | Closed(Phase)
  /// A reply's line is longer than `Limits.line`.
  | LineTooLong
  /// A reply is longer than `Limits.reply`.
  | ReplyTooLarge
  /// A line that is not a three-digit reply code followed by a space, a hyphen or the line's end;
  /// or one that ends with a bare line feed, or contains a carriage return.
  | BadLine
  /// A reply whose lines do not all start with the same code.
  | MixedCodes
  /// The server sent more replies than the commands sent to it called for.
  | Unsolicited
  /// Bytes arrived after the server agreed to start TLS and before the handshake. The connection
  /// discards them, because they may not come from the server the handshake verifies (RFC 3207
  /// §4.2).
  | Injected
  /// A reply the phase does not expect: a greeting that is not 220, `EHLO` rejected, or
  /// `STARTTLS` rejected when TLS is required.
  | Unexpected(Phase, Reply)
  /// TLS is required and the server does not offer `STARTTLS`.
  | NoTls
  /// The TLS handshake failed, for the reason `std.net` gives: the server is not the one named,
  /// the two sides share no protocol version or cipher, or the server disconnected.
  | HandshakeFailed(net::Error)
  /// The server offers no mechanism the credential and the configuration both accept, or no
  /// `AUTH` at all.
  | NoMechanism
  /// The connection is not TLS, `PasswordInClear` is not set, and every mechanism that both sides
  /// accept sends the password in clear text.
  | InClear(Mechanism)
  /// The server rejected the credential.
  | Denied(Reply)
  /// The exchange failed on the server's side, for the reason `std.sasl` reports.
  | BadAuth(sasl::Error)
  /// A command was sent while the session was waiting for a reply, or after the session ended.
  | NotReady
  /// The envelope has no recipients.
  | NoRecipients
  /// The message is larger than the server accepts. The first `Int` is the message size in bytes
  /// and the second is the server's maximum size in bytes.
  | TooLarge(Int, Int)
  /// The message needs an extension the server does not offer.
  | MissingExtension(RequiredExtension)
  /// The message is not made of lines that each end with CRLF and have at most 998 octets. The
  /// `std.email` error gives the position and the reason.
  | Unsendable(email::Error)
  /// The message contains a NUL, at this byte.
  | NulByte(Int)
  /// The message's last line has no line break.
  | Unterminated
  /// An envelope identifier that is empty, longer than 100 characters, or not printable ASCII.
  | BadEnvelopeId
  /// The draft cannot be written as bytes, for the reason `std.email` gives.
  | Unwritable(email::Unwritable)
  /// The envelope cannot be taken from the message, for the reason `std.email` gives.
  | Unreadable(email::Error)

/// The error this module raises.
pub effect smtp {
  /// The session cannot continue, or the message is not sent.
  raise fail(reason: Error)
}

/// Whether the session an error came from can still send: `true` for a message rejected before
/// any of it was sent, `false` once the exchange itself failed.
pub fn usable(reason: Error) -> Bool =
  match reason {
    NoRecipients -> true,
    TooLarge(_, _) -> true,
    MissingExtension(_) -> true,
    Unsendable(_) -> true,
    NulByte(_) -> true,
    Unterminated -> true,
    BadEnvelopeId -> true,
    Unwritable(_) -> true,
    Unreadable(_) -> true,
    _ -> false,
  }

type Partial = { digits: Int, lines: List<String>, size: Int }

fn nothing_read() -> Partial = { digits: -1, lines: [], size: 0 }

type ReplyScan = { whole: Option<Reply>, partial: Partial, unread_start: Int }

fn printable(raw: Bytes) -> String =
  String::of_chars(
    String::of_bytes_lossy(raw).chars().map(|c: Char| if is_control(c) { '\u{fffd}' } else { c }),
  )

fn scan_reply(
  buffer: Bytes,
  at: Int,
  p: Partial,
  limits: Limits,
  left: Int,
) -> ReplyScan / {smtp.fail, abort.raise} =
  match buffer.index_of_from(b"\n", at) {
    None -> if buffer.len() - at > limits.line { smtp.fail(LineTooLong) }
    else if p.size + buffer.len() - at > limits.reply { smtp.fail(ReplyTooLarge) }
    else { { whole: None, partial: p, unread_start: at } },
    Some(end) -> {
      let size = p.size + end + 1 - at;
      if end + 1 - at > limits.line { smtp.fail(LineTooLong) }
      else if size > limits.reply { smtp.fail(ReplyTooLarge) }
      else if end == at || buffer.peek(end - 1) != b'\r' { smtp.fail(BadLine) } else {
        let line = buffer.slice(at, end - 1);
        let n = line.len();
        let digits = match line.slice(0, min(n, 3)).int_of_ascii() {
          Some(d) -> if n >= 3 && d >= 200 && d <= 599 { d } else { -1 },
          None -> -1,
        };
        let mark = line.peek(3);
        if digits < 0 || (n > 3 && mark != b' ' && mark != b'-') { smtp.fail(BadLine) }
        else if line.index_of_byte(b'\r') != None { smtp.fail(BadLine) }
        else if p.digits >= 0 && p.digits != digits { smtp.fail(MixedCodes) } else {
          let texts = p.lines.push(printable(line.slice(min(n, 4), n)));
          if mark != b'-' {
            {
              whole: Some({ code: Code(digits), lines: texts }),
              partial: nothing_read(),
              unread_start: end + 1,
            }
          } else if left <= 0 { smtp.fail(ReplyTooLarge) } else {
            scan_reply(
              buffer,
              end + 1,
              { digits: digits, lines: texts, size: size },
              limits,
              left - 1,
            )
          }
        }
      }
    },
  }

/// `data` read as one whole reply, as RFC 5321 §4.2 has a server write it: each line ending with
/// CRLF, and nothing after it. Raises `smtp.fail` where `parse_reply` returns `Err`.
pub fn read_reply(data: Bytes, limits: Limits) -> Reply / {smtp.fail, abort.raise} = {
  let t = scan_reply(data, 0, nothing_read(), limits, data.len());
  match t.whole {
    Some(r) -> if t.unread_start == data.len() { r } else { smtp.fail(Unsolicited) },
    None -> smtp.fail(BadLine),
  }
}

/// `data` read as a reply, or why it is not one: a line or a reply past its limit, a line that is
/// not a reply line, lines with two different codes, or bytes after the reply's end.
pub fn parse_reply(data: Bytes, limits: Limits) -> Result<Reply, Error> / {abort.raise} =
  try { read_reply(data, limits) }

/// What a server states about the message size it accepts (RFC 1870).
pub type Size =
  /// Nothing: it does not offer `SIZE`.
  | NotAdvertised
  /// It reads the size a client declares, and states no limit.
  | Unbounded
  /// It accepts at most this many bytes.
  | AtMost(Int)

/// An extension this module has no use for: its keyword in upper case, and its parameters as
/// written.
pub type Extension = { keyword: String, params: List<String> }

/// What a server offered in reply to `EHLO`.
pub type Capabilities = new {
  /// The first line of its reply: the server's name, and whatever text follows it.
  greeting: String,
  /// `STARTTLS` (RFC 3207): it will upgrade the connection to TLS.
  starttls: Bool,
  /// `AUTH` (RFC 4954): the mechanisms the server accepts that `std.sasl` supports, in the order
  /// the server lists them.
  auth: List<Mechanism>,
  /// The mechanisms it accepts that `std.sasl` does not support, by name in upper case.
  unsupported_mechanisms: List<String>,
  /// `PIPELINING` (RFC 2920): it reads commands sent before their replies.
  pipelining: Bool,
  /// `8BITMIME` (RFC 6152): it accepts a message with bytes past 127.
  eight_bit: Bool,
  /// `SMTPUTF8` (RFC 6531): it accepts addresses and headers outside ASCII.
  utf8: Bool,
  /// The largest message size the server accepts, from `SIZE` (RFC 1870).
  size: Size,
  /// Whether the server accepts a message by `BDAT` (`CHUNKING`, RFC 3030). This module never sends
  /// `BDAT`.
  chunking: Bool,
  /// `DSN` (RFC 3461): it accepts requests for delivery reports.
  dsn: Bool,
  /// Whether the server starts each reply with an enhanced status code (`ENHANCEDSTATUSCODES`, RFC
  /// 2034). `enhanced_status` reads that code from a reply.
  enhanced: Bool,
  /// Everything else it offered, in its order.
  others: List<Extension>,
}

/// Returns the capabilities of a server that offers no extensions, with only its `greeting`. A
/// reply to `HELO` tells a client nothing more than this.
pub fn nothing_offered(greeting: String) -> Capabilities =
  {
    greeting: greeting,
    starttls: false,
    auth: [],
    unsupported_mechanisms: [],
    pipelining: false,
    eight_bit: false,
    utf8: false,
    size: NotAdvertised,
    chunking: false,
    dsn: false,
    enhanced: false,
    others: [],
  }

/// Parses the reply to `EHLO` into the capabilities the server offers. The first line is the
/// greeting, and each later line is a keyword, in any case, followed by space-separated parameters.
/// A keyword `AUTH=` followed by mechanisms is treated as `AUTH`, because old servers sent it for
/// old clients. A `SIZE` whose parameter is not a number states no limit.
pub fn capabilities(r: Reply) -> Capabilities / {abort.raise} =
  r.lines.drop(1).fold(nothing_offered(r.lines.at_or(0, "")), |c: Capabilities, line: String| {
    let words = line.split(" ").filter(|w: String| w != "");
    let keyword = words.at_or(0, "").ascii_upper();
    let params = words.drop(1);
    if keyword.starts_with("AUTH=") {
      mechanisms_in(c, list::prepend(keyword.slice(5, keyword.len()), params))
    } else {
      match keyword {
        "" -> c,
        "STARTTLS" -> { ..c, starttls: true },
        "AUTH" -> mechanisms_in(c, params),
        "PIPELINING" -> { ..c, pipelining: true },
        "8BITMIME" -> { ..c, eight_bit: true },
        "SMTPUTF8" -> { ..c, utf8: true },
        "SIZE" -> { ..c, size: bound_of(params) },
        "CHUNKING" -> { ..c, chunking: true },
        "DSN" -> { ..c, dsn: true },
        "ENHANCEDSTATUSCODES" -> { ..c, enhanced: true },
        _ -> { ..c, others: c.others.push({ keyword: keyword, params: params }) },
      }
    }
  })

fn mechanisms_in(c: Capabilities, offered: List<String>) -> Capabilities =
  offered.filter(|named: String| named != "").fold(c, |capabilities: Capabilities, named: String|
    match sasl::mechanism_named(named) {
      Some(m) -> { ..capabilities, auth: capabilities.auth.push_unique(m) },
      None ->
        {
          ..capabilities,
          unsupported_mechanisms: capabilities.unsupported_mechanisms.push_unique(
            named.ascii_upper(),
          ),
        },
    })

fn bound_of(params: List<String>) -> Size / {abort.raise} =
  match params.first() {
    None -> Unbounded,
    Some(digits) -> match Bytes::of_string(digits).int_of_ascii() {
      Some(most) -> if most > 0 { AtMost(most) } else { Unbounded },
      None -> Unbounded,
    },
  }

/// Returns `body` with an extra dot added at the start of every line that begins with a dot (RFC
/// 5321 section 4.5.2). A line of the message is then never a single dot, which would end the
/// message.
pub fn dot_stuff(body: Bytes) -> Bytes = {
  let inner = body.replace(b"\r\n.", b"\r\n..");
  if inner.peek(0) == b'.' { b".".concat(inner) } else { inner }
}

/// Returns `data` with the extra dot that `dot_stuff` added at the start of each line removed. This
/// is what a server stores from the message it read before the final single dot.
pub fn unstuff(data: Bytes) -> Bytes / {abort.raise} = {
  let inner = data.replace(b"\r\n.", b"\r\n");
  if data.peek(0) == b'.' { inner.slice(1, inner.len()) } else { inner }
}

/// Returns why `data` cannot be sent as a message, or `None` if it can. The reasons are a line feed
/// or carriage return that is not part of a CRLF, a line over 998 octets, a NUL byte, and a last
/// line with no line break. Nothing is repaired: a repair would change the bytes a signature
/// covers, and servers that treat a stray line break differently can be used to smuggle a second
/// message inside the first.
pub fn message_error(data: Bytes) -> Option<Error> / {abort.raise} = {
  let n = data.len();
  match email::line_flaws(data).first() {
    Some(found) -> Some(Unsendable(found)),
    None -> match data.index_of_byte(0) {
      Some(at) -> Some(NulByte(at)),
      None -> if n > 0 && data.peek(n - 1) != b'\n' { Some(Unterminated) } else { None },
    },
  }
}

fn payload_of(data: Bytes) -> Bytes = dot_stuff(data).concat(b".\r\n")

/// How much of a message a report of its failure returns (RFC 3461 §4.3).
pub type Return =
  /// The whole message.
  | Full
  /// Its header alone.
  | Headers

/// An event reported to a sender (RFC 3461 §4.1).
pub type Event =
  /// The message reached the recipient's mailbox, or was passed to a server that does not report
  /// delivery.
  | Delivered
  /// It could not be delivered.
  | Failed
  /// It is late, and still being tried.
  | Delayed

/// What a message requests from the servers that carry it, under RFC 3461's `DSN` extension. A
/// message that requests anything is not sent to a server that does not offer the extension.
pub type Dsn = new {
  /// How much of the message a report returns; the server's choice if `None`.
  return_content: Option<Return>,
  /// An identifier of the sender's own, returned in each report: printable ASCII, 100
  /// characters at most.
  envelope_id: Option<String>,
  /// The events to report: `Some([])` for none at all, and the server's choice, usually failure
  /// and often delay, if `None`.
  notify: Option<List<Event>>,
  /// Whether to tell the servers each recipient's original address, so that a report still names
  /// it that way after it was rewritten in transit.
  original: Bool,
}

/// Nothing requested: reports are made as the servers choose.
pub fn no_dsn() -> Dsn = { return_content: None, envelope_id: None, notify: None, original: false }

fn requests_reports(d: Dsn) -> Bool = d != no_dsn()

/// `text` encoded as RFC 3461 §4 requires in a parameter: printable ASCII as it is, except `+`
/// and `=`, and every other byte as `+` and two hex digits.
pub fn xtext(text: String) -> String / {abort.raise} = {
  let raw = Bytes::of_string(text);
  String::join(
    range(0, raw.len()).map(|i: Int| {
      let b = raw.peek(i);
      if b > 32 && b < 127 && b != b'+' && b != b'=' { String::of_bytes(byte_of_int(b)) }
      else { "+" ++ upper_hex(b) }
    }),
    "",
  )
}

fn upper_hex(b: Int) -> String / {abort.raise} = byte_of_int(b).hex_of().ascii_upper()

fn path_text(a: Address) -> String =
  match email::ascii_text(a) { Some(text) -> text, None -> show(a) }

fn original_of(a: Address) -> String / {abort.raise} =
  if email::is_ascii(a) { "rfc822;" ++ xtext(path_text(a)) } else {
    "utf-8;"
      ++ String::join(
        show(a).chars().map(|c: Char|
          if Int::of_char(c) <= 32 || c == '\\' || c == '+' || c == '=' || Int::of_char(c) == 127 {
            "\\x{" ++ upper_hex(Int::of_char(c)) ++ "}"
          } else { String::of_chars([c]) }),
        "",
      )
  }

fn event_word(e: Event) -> String =
  match e { Delivered -> "SUCCESS", Failed -> "FAILURE", Delayed -> "DELAY" }

fn mail_dsn_parameters(dsn_request: Dsn) -> String / {abort.raise} =
  (match dsn_request.return_content {
      Some(Full) -> " RET=FULL",
      Some(Headers) -> " RET=HDRS",
      None -> "",
    })
    ++ (match dsn_request.envelope_id { Some(id) -> " ENVID=" ++ xtext(id), None -> "" })

fn rcpt_dsn_parameters(dsn_request: Dsn, a: Address) -> String / {abort.raise} =
  (match dsn_request.notify {
      None -> "",
      Some(events) ->
        " NOTIFY="
          ++ (if events.len() == 0 { "NEVER" } else {
            String::join(
              [Delivered, Failed, Delayed].filter(|e: Event| events.contains(e)).map(event_word),
              ",",
            )
          }),
    })
    ++ (if dsn_request.original { " ORCPT=" ++ original_of(a) } else { "" })

fn is_envelope_id(id: String) -> Bool / {abort.raise} =
  id != "" && xtext(id).len() <= 100
    && id.chars().all(|c: Char| Int::of_char(c) >= 32 && Int::of_char(c) < 127)

/// What a caller requires of the connection before a credential or a message is sent over it.
pub type TlsPolicy =
  /// TLS, or nothing is sent: on a connection that is not TLS the client sends `STARTTLS` and
  /// rejects a server that does not offer or accept it.
  | RequireTls
  /// TLS if the server offers it, and the plain connection if it does not. Anyone between the
  /// two ends can remove the offer, so this protects against an eavesdropper but not against an
  /// active attacker.
  | Opportunistic
  /// No TLS: the client never requests it. For a server on the same host, and for a test.
  | Plain

/// Whether a credential may be sent where anyone on the path can read it.
pub type Exposure =
  /// A mechanism that sends the credential itself is used only over TLS.
  | Protected
  /// Such a mechanism is also used on a connection that is not TLS: the password or the token
  /// travels the network in the clear.
  | PasswordInClear

/// What a client is configured as: the name it greets a server by, what it requires of the
/// connection, the credential it proves itself with, and its limits and waits.
pub opaque type Config = new {
  client: String,
  tls: TlsPolicy,
  credential: Option<Credential>,
  mechanisms: List<Mechanism>,
  exposure: Exposure,
  helo: Bool,
  limits: Limits,
  timeouts: Timeouts,
}

/// A client that greets a server as `client`, its own domain or its address in brackets
/// (`[192.0.2.1]`), requires TLS, has no credential, and waits as `default_timeouts` sets.
/// Raises `smtp.fail(BadClientName)` for a name that is neither.
pub fn config(client: String, limits: Limits) -> Config / {smtp.fail, abort.raise} =
  match email::parse_address("postmaster@" ++ client) {
    Err(_) -> smtp.fail(BadClientName),
    Ok(_) ->
      {
        client: client,
        tls: RequireTls,
        credential: None,
        mechanisms: sasl::mechanisms(),
        exposure: Protected,
        helo: false,
        limits: limits,
        timeouts: default_timeouts(),
      },
  }

/// Returns `c` with the TLS policy `policy`, which sets whether the connection must use TLS.
pub fn with_tls(c: Config, policy: TlsPolicy) -> Config = { ..c, tls: policy }

/// Returns `c` set to authenticate with `credential` by `AUTH`. A session fails when the server
/// offers no mechanism that the credential and the configuration both accept.
pub fn with_credential(c: Config, credential: Credential) -> Config =
  { ..c, credential: Some(credential) }

/// Returns `c` set to use only the mechanisms in `order`, choosing the first one the server offers
/// that works with the credential. By default `c` uses the mechanisms of `std.sasl`, in their
/// order.
pub fn with_mechanisms(c: Config, order: List<Mechanism>) -> Config = { ..c, mechanisms: order }

/// Returns `c` with the exposure `e`, which sets whether a mechanism that sends the credential
/// itself may be used on a connection that is not TLS.
pub fn with_exposure(c: Config, e: Exposure) -> Config = { ..c, exposure: e }

/// `c` sending `HELO` to a server that rejects `EHLO`; such a server then offers no extensions.
pub fn with_helo_fallback(c: Config) -> Config = { ..c, helo: true }

/// Returns `c` with its timeouts set to `t`.
pub fn with_timeouts(c: Config, t: Timeouts) -> Config = { ..c, timeouts: t }

/// The command at which a server rejected a message.
pub type Stage =
  /// `MAIL FROM`: the sender, or the message's size or kind.
  | AtMail
  /// `RCPT TO`: the server rejected one recipient.
  | AtRcpt
  /// `DATA`: the server rejected the message after accepting at least one recipient, so it has no
  /// recipient to send it to.
  | AtData
  /// The server rejected the message after receiving all of its text.
  | AtEnd

/// What became of a message for one recipient.
pub type Outcome =
  /// The server took responsibility for delivering it, with its reply, which often gives the
  /// message's queue id.
  | Accepted(Reply)
  /// Not now: the same message may be accepted later.
  | Temporary(Stage, Reply)
  /// The server rejected the message for this recipient, and sending it again will not change that.
  | Permanent(Stage, Reply)

/// One recipient of a message, and the `Outcome` of sending the message to that recipient.
pub type Delivery = { recipient: Address, outcome: Outcome }

/// Returns whether sending the message again later may succeed, which is true when the outcome is
/// `Temporary`.
pub fn retryable(o: Outcome) -> Bool = match o { Temporary(_, _) -> true, _ -> false }

/// Whether the server accepted the message for this recipient.
pub fn accepted(o: Outcome) -> Bool = match o { Accepted(_) -> true, _ -> false }

fn failure(stage: Stage, r: Reply) -> Outcome =
  if class_of(r.code) == Transient || (stage == AtRcpt && number(r.code) == 552) {
    Temporary(stage, r)
  } else { Permanent(stage, r) }

/// What an engine knows of the connection it runs over.
pub type Link = new {
  /// The host connected to. Some `AUTH` mechanisms include it in the data they send to the server.
  host: String,
  port: Int,
  /// Whether the connection is TLS already.
  secure: Bool,
  /// A nonce no earlier connection used, for SCRAM: printable ASCII with no comma.
  nonce: String,
}

type Expect =
  | ForGreeting
  | ForEhlo
  | ForHelo
  | ForStartTls
  | ForAuth
  | ForReset
  | ForMail
  | ForRcpt(Address)
  | ForData
  | ForEnd
  | ForQuit

fn phase_of(x: Expect) -> Phase =
  match x {
    ForGreeting -> Greeting,
    ForEhlo -> Hello,
    ForHelo -> Hello,
    ForStartTls -> StartTls,
    ForAuth -> Auth,
    ForReset -> Reset,
    ForMail -> Mail,
    ForRcpt(_) -> Rcpt,
    ForData -> Data,
    ForEnd -> Body,
    ForQuit -> Quit,
  }

type NextAction =
  | SayHello
  | SayHelo
  | Negotiate
  | Authenticate
  | StartHandshake
  | Respond(sasl::Response)
  | Advance
  | Idle
  | Finish

type Command = { words: String, expect: Expect }

type DataState = | Unasked | ReadyForData | Stopped(Reply) | Ended(Reply)

type EarlyEnd = { stage: Stage, by: Reply }

type Transaction = {
  queue: List<Command>,
  payload: Bytes,
  recipients: List<Address>,
  mail: Option<Reply>,
  rejected: List<Delivery>,
  accepted_recipients: List<Address>,
  data: DataState,
  ended_early: Option<EarlyEnd>,
}

type AuthExchange = { exchange: Exchange, pending_response: Option<sasl::Response> }

type State = {
  config: Config,
  link: Link,
  offered: Option<Capabilities>,
  unparsed: Bytes,
  partial: Partial,
  pending: List<Expect>,
  todo: NextAction,
  authentication: Option<AuthExchange>,
  authenticated: Bool,
  job: Option<Transaction>,
  done: List<Delivery>,
  sent: Int,
  over: Bool,
}

/// The client end of an SMTP session as a value: what the client knows of the server, what it is
/// waiting for, and the bytes it has of an incomplete reply. It reads nothing and writes nothing:
/// `feed` is given what the server sent and returns what to send back.
pub opaque type Engine = | Engine(State)

/// The bytes to write to the server. Converting a `Wire` to a string gives its bytes, except that a
/// line of an `AUTH` exchange becomes `****`, so a credential never appears in logs.
pub type Wire =
  /// These bytes, written with `net.send`.
  | Open(Bytes)
  /// A line of an `AUTH` exchange, made of three parts: the bytes before the client's response, the
  /// response (a secret), and the bytes that end the line. `net.send_secret` writes the first part,
  /// then the response encoded in base64, then the last part.
  | Veiled(Bytes, Secret<Bytes>, Bytes)

show for Wire by wire_text

fn wire_text(w: Wire) -> String =
  match w { Open(reply_of) -> show(reply_of), Veiled(_, _, _) -> "****" }

fn wire_size(w: Wire) -> Int =
  match w {
    Open(reply_of) -> reply_of.len(),
    Veiled(lead, reply_of, end) -> lead.len() + (reply_of.len() + 2) / 3 * 4 + end.len(),
  }

/// One line of an exchange, as a session stores it. No line contains a credential: what the
/// client sends in an `AUTH` exchange is stored as stars.
pub type Line =
  /// A line the client sent, without its line break.
  | Client(String)
  /// A line the server sent.
  | Server(String)
  /// The message body, with the number of bytes sent, including the final `.` line that tells the
  /// server the message is complete.
  | Payload(Int)
  /// The connection became TLS.
  | Upgraded

/// What a transport does next for an engine.
pub type Next =
  /// Read from the server, waiting no longer than the timeout configured for the `Phase`, and
  /// `feed` the bytes that arrive.
  | Await(Phase)
  /// Start TLS on the connection, passing `unread` to whatever starts it, and then call
  /// `tls_started`.
  | Secure
  /// Nothing: the session is ready for a command.
  | Ready
  /// Close the connection: the session is over.
  | Over

/// One step of an engine: its new state, what to write to the server first, what to do after
/// that, the lines of the exchange this step read and wrote, and how many whole replies it read.
pub type Turn = { engine: Engine, out: Wire, next: Next, reply_lines: List<Line>, returned: Int }

fn state(e: Engine) -> State = match e { Engine(s) -> s }

fn turn(s: State, out: Wire, next: Next, reply_of: List<Line>, replies_read: Int) -> Turn =
  { engine: Engine(s), out: out, next: next, reply_lines: reply_of, returned: replies_read }

/// An engine for a newly made connection, waiting for the server's greeting.
pub fn start(c: Config, link: Link) -> Turn =
  turn(
    {
      config: c,
      link: link,
      offered: None,
      unparsed: b"",
      partial: nothing_read(),
      pending: [ForGreeting],
      todo: Idle,
      authentication: None,
      authenticated: false,
      job: None,
      done: [],
      sent: 0,
      over: false,
    },
    Open(b""),
    Await(Greeting),
    [],
    0,
  )

/// What the server offered in reply to the last `EHLO`. `None` before the first reply, and again
/// from the moment TLS starts until the server replies to the next `EHLO`.
pub fn offered(e: Engine) -> Option<Capabilities> = state(e).offered

/// Whether the connection is TLS.
pub fn secured(e: Engine) -> Bool = state(e).link.secure

/// Whether the server accepted the credential.
pub fn authenticated(e: Engine) -> Bool = state(e).authenticated

/// What became of the last message for each of its recipients, in the envelope's order.
pub fn deliveries(e: Engine) -> List<Delivery> = state(e).done

/// The bytes the engine was fed and has not yet read as a line. They are passed to whatever
/// starts TLS on the connection, which rejects the upgrade if there are any.
pub fn unread(e: Engine) -> Bytes = state(e).unparsed

/// How many bytes of the reply being read the engine stores: at most `Limits.reply`, since it
/// rejects any byte past that.
pub fn buffered_size(e: Engine) -> Int = state(e).partial.size + state(e).unparsed.len()

/// How many bytes a transport may read for the engine now: what is left of `Limits.reply` for
/// the reply being read, and never less than the one byte that shows a reply to be too large.
pub fn read_limit(e: Engine) -> Int = max(1, state(e).config.limits.reply - buffered_size(e))

/// The limits and waits an engine was configured with.
pub fn config_of(e: Engine) -> Config = state(e).config

fn ready(s: State) -> Bool = s.pending.len() == 0 && s.todo == Idle && !s.over

/// Returns the turn that results from the server sending `data`. Each whole reply in `data` is
/// matched to the oldest command still waiting for a reply. Once no command is waiting, the next
/// command is written.
///
/// Fails with `smtp.fail` for a reply that cannot be parsed, a reply its command does not expect,
/// bytes after the last expected reply (`Unsolicited`, or `Injected` when they follow the go-ahead
/// to start TLS), and anything that stops the session from continuing: TLS required but
/// unavailable, no usable authentication mechanism, or a rejected credential.
pub fn feed(e: Engine, data: Bytes) -> Turn / {smtp.fail, abort.raise} = {
  let s = state(e);
  let input = s.unparsed.concat(data);
  if s.todo == StartHandshake && s.pending.len() == 0 { smtp.fail(Injected) }
  else { absorb({ ..s, unparsed: b"" }, input, 0, [], 0, input.len() + 1) }
}

fn absorb(
  s: State,
  input: Bytes,
  at: Int,
  reply_of: List<Line>,
  replies_read: Int,
  left: Int,
) -> Turn / {smtp.fail, abort.raise} =
  match s.pending.first() {
    None -> if at < input.len() && !s.over {
      smtp.fail(if s.todo == StartHandshake { Injected } else { Unsolicited })
    } else { take_next_action(s, reply_of, replies_read) },
    Some(awaited) -> if left <= 0 { smtp.fail(Unsolicited) } else {
      let t = scan_reply(input, at, s.partial, s.config.limits, input.len());
      match t.whole {
        None ->
          turn(
            { ..s, unparsed: input.slice(t.unread_start, input.len()), partial: t.partial },
            Open(b""),
            Await(phase_of(awaited)),
            reply_of,
            replies_read,
          ),
        Some(r) ->
          absorb(
            handle_reply({ ..s, pending: s.pending.drop(1), partial: nothing_read() }, awaited, r),
            input,
            t.unread_start,
            reply_of.concat(reply_lines(r)),
            replies_read + 1,
            left - 1,
          ),
      }
    },
  }

fn reply_lines(r: Reply) -> List<Line> = {
  let end = r.lines.len() - 1;
  list::enumerate(r.lines).map(|l: { index: Int, value: String }|
    Server(
      code_text(r.code) ++ (if l.index < end { "-" } else if l.value == "" { "" } else { " " })
        ++ l.value,
    ))
}

fn handle_reply(s: State, awaited: Expect, r: Reply) -> State / {smtp.fail, abort.raise} = {
  let kind = class_of(r.code);
  match awaited {
    ForGreeting -> if number(r.code) == 220 { { ..s, todo: SayHello } }
    else { smtp.fail(Unexpected(Greeting, r)) },
    ForEhlo -> if kind == Completed { { ..s, offered: Some(capabilities(r)), todo: Negotiate } }
    else if kind == Rejected && s.config.helo { { ..s, todo: SayHelo } }
    else { smtp.fail(Unexpected(Hello, r)) },
    ForHelo -> if kind == Completed {
      { ..s, offered: Some(nothing_offered(r.lines.at_or(0, ""))), todo: Negotiate }
    } else { smtp.fail(Unexpected(Hello, r)) },
    ForStartTls -> if number(r.code) == 220 { { ..s, todo: StartHandshake } }
    else if s.config.tls == RequireTls { smtp.fail(Unexpected(StartTls, r)) }
    else { { ..s, todo: Authenticate } },
    ForAuth -> handle_auth_reply(s, r),
    ForReset -> if kind == Completed { { ..s, todo: Advance } }
    else { smtp.fail(Unexpected(Reset, r)) },
    ForQuit -> { ..s, todo: Finish, over: true },
    _ -> match s.job {
      None -> smtp.fail(Unsolicited),
      Some(j) -> handle_transaction_reply(s, j, awaited, r),
    },
  }
}

fn handle_auth_reply(s: State, r: Reply) -> State / {smtp.fail, abort.raise} =
  match s.authentication {
    None -> smtp.fail(Unsolicited),
    Some(p) -> if number(r.code) == 334 {
      match p.pending_response {
        Some(response) ->
          {
            ..s,
            authentication: Some({ exchange: p.exchange, pending_response: None }),
            todo: Respond(response),
          },
        None -> {
          let reply_of = r.lines.at_or(0, "").ascii_trim();
          match base64_decode(if reply_of == "=" { "" } else { reply_of }) {
            None -> smtp.fail(BadAuth(sasl::BadChallenge)),
            Some(challenge) -> match try[sasl.fail] { sasl::respond(p.exchange, challenge) } {
              Err(reason) -> smtp.fail(BadAuth(reason)),
              Ok(a) ->
                {
                  ..s,
                  authentication: Some({ exchange: a.exchange, pending_response: None }),
                  todo: Respond(a.response),
                },
            },
          }
        },
      }
    } else if number(r.code) == 235 {
      if sasl::is_authenticated(p.exchange) && p.pending_response == None {
        { ..s, authentication: None, authenticated: true, todo: Idle }
      } else { smtp.fail(BadAuth(sasl::BadServerProof)) }
    } else if class_of(r.code) == Transient || class_of(r.code) == Rejected { smtp.fail(Denied(r)) }
    else { smtp.fail(Unexpected(Auth, r)) },
  }

fn handle_transaction_reply(
  s: State,
  j: Transaction,
  awaited: Expect,
  r: Reply,
) -> State / {smtp.fail} = {
  let kind = class_of(r.code);
  let stage = match awaited {
    ForMail -> AtMail,
    ForRcpt(_) -> AtRcpt,
    ForData -> AtData,
    _ -> AtEnd,
  };
  if number(r.code) == 421 {
    {
      ..s,
      pending: [],
      job: Some({ ..j, queue: [], ended_early: Some({ stage: stage, by: r }) }),
      todo: Advance,
      over: true,
    }
  } else if kind == Intermediate && awaited != ForData {
    smtp.fail(Unexpected(phase_of(awaited), r))
  } else {
    let after = match awaited {
      ForMail -> if kind == Completed { j } else { { ..j, mail: Some(r) } },
      ForRcpt(a) -> if kind == Completed {
        { ..j, accepted_recipients: j.accepted_recipients.push(a) }
      } else { { ..j, rejected: j.rejected.push({ recipient: a, outcome: failure(AtRcpt, r) }) } },
      ForData -> { ..j, data: if kind == Intermediate { ReadyForData } else { Stopped(r) } },
      _ -> { ..j, data: Ended(r) },
    };
    if awaited == ForData && kind == Completed { smtp.fail(Unexpected(Data, r)) }
    else { { ..s, job: Some(after), todo: Advance } }
  }
}

fn take_next_action(
  s: State,
  reply_of: List<Line>,
  replies_read: Int,
) -> Turn / {smtp.fail, abort.raise} =
  match s.todo {
    SayHello -> send_command(s, "EHLO " ++ s.config.client, ForEhlo, reply_of, replies_read),
    SayHelo -> send_command(s, "HELO " ++ s.config.client, ForHelo, reply_of, replies_read),
    Negotiate -> {
      let starttls = match s.offered { Some(c) -> c.starttls, None -> false };
      if s.link.secure || s.config.tls == Plain { authenticate(s, reply_of, replies_read) }
      else if starttls { send_command(s, "STARTTLS", ForStartTls, reply_of, replies_read) }
      else if s.config.tls == RequireTls { smtp.fail(NoTls) }
      else { authenticate(s, reply_of, replies_read) }
    },
    Authenticate -> authenticate(s, reply_of, replies_read),
    StartHandshake -> turn(s, Open(b""), Secure, reply_of, replies_read),
    Respond(response) ->
      turn(
        { ..s, pending: [ForAuth], todo: Idle },
        auth_line("", response),
        Await(Auth),
        reply_of.push(Client("****")),
        replies_read,
      ),
    Advance -> advance(s, reply_of, replies_read),
    Idle -> turn(s, Open(b""), Ready, reply_of, replies_read),
    Finish -> turn(s, Open(b""), Over, reply_of, replies_read),
  }

fn auth_line(lead: String, response: sasl::Response) -> Wire = {
  let reply_of = sasl::secret_bytes(response);
  let marked = if lead != "" && reply_of.is_empty() { lead ++ "=" } else { lead };
  Veiled(Bytes::of_string(marked), reply_of, b"\r\n")
}

fn send_command(
  s: State,
  words: String,
  expect: Expect,
  reply_of: List<Line>,
  replies_read: Int,
) -> Turn =
  turn(
    { ..s, pending: [expect], todo: Idle },
    Open(Bytes::of_string(words ++ "\r\n")),
    Await(phase_of(expect)),
    reply_of.push(Client(words)),
    replies_read,
  )

fn authenticate(s: State, reply_of: List<Line>, replies_read: Int) -> Turn / {smtp.fail} =
  match s.config.credential {
    None -> turn({ ..s, todo: Idle }, Open(b""), Ready, reply_of, replies_read),
    Some(credential) -> {
      let server_takes = match s.offered { Some(c) -> c.auth, None -> [] };
      let fit = s.config.mechanisms.filter(|m: Mechanism|
        server_takes.contains(m) && sasl::supports(credential, m));
      let safe = fit.filter(|m: Mechanism|
        s.link.secure || !sasl::reveals(m) || s.config.exposure == PasswordInClear);
      match safe.first() {
        None -> match fit.first() {
          Some(m) -> smtp.fail(InClear(m)),
          None -> smtp.fail(NoMechanism),
        },
        Some(m) -> match try[sasl.fail] {
            sasl::begin(m, credential, {
              nonce: s.link.nonce,
              max_iterations: s.config.limits.scram_iterations,
              host: s.link.host,
              port: s.link.port,
            })
          } {
          Err(reason) -> smtp.fail(BadAuth(reason)),
          Ok(b) -> {
            let words = "AUTH " ++ sasl::mechanism_name(m);
            let inline = match b.first {
              Some(said_first) -> Some(auth_line(words ++ " ", said_first)),
              None -> None,
            };
            match inline {
              Some(line) if wire_size(line) <= 512 ->
                turn(
                  {
                    ..s,
                    authentication: Some({ exchange: b.exchange, pending_response: None }),
                    pending: [ForAuth],
                    todo: Idle,
                  },
                  line,
                  Await(Auth),
                  reply_of.push(Client(words ++ " ****")),
                  replies_read,
                ),
              _ ->
                turn(
                  {
                    ..s,
                    authentication: Some({ exchange: b.exchange, pending_response: b.first }),
                    pending: [ForAuth],
                    todo: Idle,
                  },
                  Open(Bytes::of_string(words ++ "\r\n")),
                  Await(Auth),
                  reply_of.push(Client(words)),
                  replies_read,
                ),
            }
          },
        },
      }
    },
  }

fn advance(s: State, reply_of: List<Line>, replies_read: Int) -> Turn / {abort.raise} =
  match s.job {
    None -> turn({ ..s, todo: Idle }, Open(b""), Ready, reply_of, replies_read),
    Some(j) -> match j.queue {
      [next_step, ..later] -> if s.over || j.mail != None
          || (next_step.expect == ForData && j.accepted_recipients.len() == 0) {
        finish_transaction(s, j, reply_of, replies_read)
      } else {
        turn(
          { ..s, job: Some({ ..j, queue: later }), pending: [next_step.expect], todo: Advance },
          Open(Bytes::of_string(next_step.words ++ "\r\n")),
          Await(phase_of(next_step.expect)),
          reply_of.push(Client(next_step.words)),
          replies_read,
        )
      },
      _ -> if j.data != ReadyForData || s.over { finish_transaction(s, j, reply_of, replies_read) }
      else {
        let body = if j.mail == None && j.accepted_recipients.len() > 0 { j.payload }
        else { b".\r\n" };
        turn(
          { ..s, job: Some({ ..j, data: Unasked }), pending: [ForEnd], todo: Advance },
          Open(body),
          Await(Body),
          reply_of.push(Payload(body.len())),
          replies_read,
        )
      },
    },
  }

fn finish_transaction(
  s: State,
  j: Transaction,
  reply_of: List<Line>,
  replies_read: Int,
) -> Turn / {abort.raise} =
  turn(
    {
      ..s,
      job: None,
      pending: [],
      done: j.recipients.map(|a: Address| { recipient: a, outcome: recipient_outcome(j, a) }),
      sent: s.sent + 1,
      todo: if s.over { Finish } else { Idle },
    },
    Open(b""),
    if s.over { Over } else { Ready },
    reply_of,
    replies_read,
  )

fn recipient_outcome(j: Transaction, a: Address) -> Outcome / {abort.raise} =
  match j.mail {
    Some(r) -> failure(AtMail, r),
    None -> match j.rejected.find(|d: Delivery| d.recipient == a) {
      Some(d) -> d.outcome,
      None -> match j.data {
        Ended(r) if j.accepted_recipients.contains(a) -> if class_of(r.code) == Completed {
          Accepted(r)
        } else { failure(AtEnd, r) },
        Stopped(r) if j.accepted_recipients.contains(a) -> failure(AtData, r),
        _ -> match j.ended_early {
          Some(c) -> Temporary(c.stage, c.by),
          None -> panic("the server sent no reply for a recipient"),
        },
      },
    },
  }

/// Returns the turn after TLS has started on the connection. It discards the capabilities the
/// server offered before TLS, because anyone could have forged them, and sends `EHLO` again. Fails
/// with `smtp.fail(NotReady)` if the engine did not request TLS.
pub fn tls_started(e: Engine) -> Turn / {smtp.fail, abort.raise} = {
  let s = state(e);
  if s.todo != StartHandshake || s.pending.len() > 0 || s.unparsed.len() > 0 { smtp.fail(NotReady) }
  else {
    take_next_action(
      { ..s, link: { ..s.link, secure: true }, offered: None, todo: SayHello },
      [Upgraded],
      0,
    )
  }
}

/// The engine after the server closed the connection: over, if that was the reply to `QUIT` or
/// nothing was awaited. Otherwise raises `smtp.fail(Closed(..))` naming the phase.
pub fn connection_closed(e: Engine) -> Turn / {smtp.fail} = {
  let s = state(e);
  match s.pending.first() {
    Some(awaited) if awaited != ForQuit -> smtp.fail(Closed(phase_of(awaited))),
    _ -> turn({ ..s, pending: [], todo: Finish, over: true }, Open(b""), Over, [], 0),
  }
}

/// Returns the turn that sends `data` under `envelope`. It writes `MAIL FROM`, a `RCPT TO` for each
/// recipient, and `DATA`: all at once if the server offers `PIPELINING`, one at a time otherwise,
/// and after a `RSET` if the session has already sent a message. After the server's go-ahead it
/// sends the message dot-stuffed, unless no recipient was accepted. Once the engine is `Ready`
/// again, `deliveries` returns the outcome for each recipient.
///
/// Fails with `smtp.fail` before writing anything, leaving the session unchanged, when the envelope
/// has no recipients (`NoRecipients`), the message is not CRLF lines (`Unsendable`, `NulByte`,
/// `Unterminated`), the message is larger than the server accepts (`TooLarge`), the message needs
/// `8BITMIME`, `SMTPUTF8` or `DSN` and the server does not offer it (`MissingExtension`), or the
/// envelope identifier is invalid (`BadEnvelopeId`). Fails with `NotReady` if the engine is waiting
/// or over.
pub fn mail(
  e: Engine,
  envelope: Envelope,
  data: Bytes,
  dsn_request: Dsn = { return_content: None, envelope_id: None, notify: None, original: false },
) -> Turn / {smtp.fail, abort.raise} = {
  let s = state(e);
  let shape = shape_of(envelope, data);
  match s.offered {
    None -> smtp.fail(NotReady),
    Some(c) -> if s.over { smtp.fail(Closed(Mail)) }
    else if !ready(s) { smtp.fail(NotReady) } else {
      match send_error(c, envelope, data, dsn_request, shape) {
        Some(reason) -> smtp.fail(reason),
        None -> {
          let steps = commands_of(c, envelope, dsn_request, shape, s.sent > 0);
          let now = if c.pipelining { steps } else { steps.take(1) };
          turn(
            {
              ..s,
              job: Some({
                queue: steps.drop(now.len()),
                payload: payload_of(data),
                recipients: envelope.recipients,
                mail: None,
                rejected: [],
                accepted_recipients: [],
                data: Unasked,
                ended_early: None,
              }),
              pending: now.map(|step: Command| step.expect),
              todo: Advance,
              done: [],
            },
            Open(Bytes::of_string(String::join(now.map(|step: Command| step.words ++ "\r\n"), ""))),
            Await(phase_of(now.at_or(0, { words: "", expect: ForMail }).expect)),
            now.map(|step: Command| Client(step.words)),
            0,
          )
        },
      }
    },
  }
}

type Shape = { size: Int, eight_bit: Bool, utf8: Bool }

fn shape_of(envelope: Envelope, data: Bytes) -> Shape = {
  let n = data.len();
  let high = match data.position(0, |b: Int| b > 127) { Some(at) -> at, None -> n };
  let head_end = match data.index_of(b"\r\n\r\n") { Some(at) -> at, None -> n };
  { size: n, eight_bit: high < n, utf8: envelope.utf8 || high < head_end }
}

fn send_error(
  c: Capabilities,
  envelope: Envelope,
  data: Bytes,
  dsn_request: Dsn,
  shape: Shape,
) -> Option<Error> / {abort.raise} =
  if envelope.recipients.len() == 0 { Some(NoRecipients) } else {
    match message_error(data) {
      Some(reason) -> Some(reason),
      None -> if shape.eight_bit && !c.eight_bit { Some(MissingExtension(EightBitMime)) }
      else if shape.utf8 && !c.utf8 { Some(MissingExtension(SmtpUtf8)) }
      else if requests_reports(dsn_request) && !c.dsn { Some(MissingExtension(Notices)) }
      else if !(match dsn_request.envelope_id { Some(id) -> is_envelope_id(id), None -> true }) {
        Some(BadEnvelopeId)
      } else {
        match c.size {
          AtMost(most) if shape.size > most -> Some(TooLarge(shape.size, most)),
          _ -> None,
        }
      },
    }
  }

fn commands_of(
  c: Capabilities,
  envelope: Envelope,
  dsn_request: Dsn,
  shape: Shape,
  again: Bool,
) -> List<Command> / {abort.raise} = {
  let from_words = "MAIL FROM:<"
    ++ (match envelope.sender { ReturnTo(a) -> path_text(a), NullPath -> "" })
    ++ ">"
    ++ (if c.size == NotAdvertised { "" } else { " SIZE=" ++ shape.size.to_string() })
    ++ (if shape.eight_bit { " BODY=8BITMIME" } else { "" })
    ++ (if shape.utf8 { " SMTPUTF8" } else { "" })
    ++ mail_dsn_parameters(dsn_request);
  List::concat(if again { [{ words: "RSET", expect: ForReset }] } else { [] }, [
    { words: from_words, expect: ForMail },
  ]).concat(
    envelope.recipients.map(|a: Address|
      {
        words: "RCPT TO:<" ++ path_text(a) ++ ">" ++ rcpt_dsn_parameters(dsn_request, a),
        expect: ForRcpt(a),
      }).push({ words: "DATA", expect: ForData }),
  )
}

/// The turn that sends `QUIT`; for an engine that is already over, a turn that is over. Raises
/// `smtp.fail(NotReady)` for an engine that is waiting for a reply.
pub fn leave(e: Engine) -> Turn / {smtp.fail} = {
  let s = state(e);
  if s.over { turn(s, Open(b""), Over, [], 0) }
  else if !ready(s) { smtp.fail(NotReady) }
  else { turn({ ..s, pending: [ForQuit] }, Open(b"QUIT\r\n"), Await(Quit), [Client("QUIT")], 0) }
}

/// An SMTP session on an open connection: the connection handle from `std.net` and the engine that
/// runs over it. Every function here must run with the same network handler (the effect parameter
/// `[l]`) that opened the session.
pub opaque type Session = new {
  handle: Int,
  engine: Engine,
  /// The newest lines of the exchange, `Limits.transcript` of them at most.
  recent_lines: List<Line>,
}

/// The result of sending a message: the session to use for the next message, and the outcome of
/// this message for each recipient, in the envelope's order. The message was delivered to every
/// recipient only if every outcome is `Accepted`.
pub type SendResult = { session: Session, deliveries: List<Delivery> }

type DriveResult = { engine: Engine, lines: List<Line> }

fn deadline_after(ms: Int) -> Instant / {clock.read, task::deadline.at} = {
  let own = after(clock.now(), millis(ms));
  match task::earliest(Some(own), task::deadline.at()) { Some(earlier) -> earlier, None -> own }
}

fn read_by<[l]>(h: Int, most: Int, end: Instant) -> Option<Bytes> / {net.recv[l], clock.read} =
  match net::ms_left(end) { None -> None, Some(ms) -> net.recv[l](h, most, ms) }

fn sent_by<[l]>(
  h: Int,
  out: Wire,
  end: Instant,
) -> Bool / {net.send[l], net.send_secret[l], clock.read, abort.raise} =
  match net::ms_left(end) {
    None -> false,
    Some(ms) -> match out {
      Open(payload) -> send_all[l](h, payload, ms),
      Veiled(lead, reply_of, line_end) ->
        net.send_secret[l](h, lead, reply_of, "base64", line_end, ms),
    },
  }

fn upgrade<[l]>(
  h: Int,
  host: String,
  unread: Bytes,
  ms: Int,
) -> Option<Error> / {net.start_tls[l], clock.read, task::deadline.at} =
  match net::ms_left(deadline_after(ms)) {
    None -> Some(TimedOut(Handshake)),
    Some(left) -> match net.start_tls[l](h, host, [], unread, left) {
      Ok(_) -> None,
      Err(net::Injected) -> Some(Injected),
      Err(net::TimedOut) -> Some(TimedOut(Handshake)),
      Err(reason) -> Some(HandshakeFailed(reason)),
    },
  }

fn drive<[l] | e>(
  h: Int,
  t: Turn,
  reply_of: List<Line>,
  end: Option<Instant>,
  secure: (Int, Bytes) -> Option<Error> / e,
  left: Int,
) -> DriveResult / {net.send[l], net.send_secret[l], net.recv[l], clock.read, task::deadline.at, smtp.fail, abort.raise | e} = {
  let waits = config_of(t.engine).timeouts;
  let all_said = reply_of.concat(t.reply_lines);
  let wrote = wire_size(t.out) > 0;
  if wrote && !sent_by[l](h, t.out, deadline_after(waits.block_ms)) {
    smtp.fail(NotSent(match t.next { Await(p) -> p, _ -> Quit }))
  } else {
    match t.next {
      Ready -> { engine: t.engine, lines: all_said },
      Over -> { engine: t.engine, lines: all_said },
      Secure -> if left <= 0 { smtp.fail(TimedOut(Handshake)) } else {
        match secure(h, unread(t.engine)) {
          Some(reason) -> smtp.fail(reason),
          None -> drive[l](h, tls_started(t.engine), all_said, None, secure, left - 1),
        }
      },
      Await(p) -> {
        let until = match end {
          Some(end_time) if !wrote && t.returned == 0 -> end_time,
          _ -> deadline_after(timeout(waits, p)),
        };
        match read_by[l](h, min(read_size(), read_limit(t.engine)), until) {
          Some(chunk) if left > 0 ->
            drive[l](
              h,
              if chunk.len() == 0 { connection_closed(t.engine) } else { feed(t.engine, chunk) },
              all_said,
              Some(until),
              secure,
              left - 1,
            ),
          _ -> smtp.fail(TimedOut(p)),
        }
      },
    }
  }
}

fn trim_transcript(limits: Limits, earlier_lines: List<Line>, reply_of: List<Line>) -> List<Line> = {
  let lines = earlier_lines.concat(reply_of);
  lines.drop(lines.len() - max(limits.transcript, 0))
}

fn established<[l] | e>(
  h: Int,
  c: Config,
  link: Link,
  secure: (Int, Bytes) -> Option<Error> / e,
) -> Session / {net.send[l], net.send_secret[l], net.recv[l], net.close[l], clock.read, task::deadline.at, smtp.fail, abort.raise | e} =
  match try[smtp.fail] { drive[l](h, start(c, link), [], None, secure, 16 * max_reads()) } {
    Ok(d) -> { handle: h, engine: d.engine, recent_lines: trim_transcript(c.limits, [], d.lines) },
    Err(reason) -> {
      net.close[l](h);
      smtp.fail(reason)
    },
  }

fn connected<[l]>(
  host: String,
  port: Int,
  c: Config,
) -> Int / {net.connect[l], clock.read, task::deadline.at, smtp.fail} =
  match net::ms_left(deadline_after(c.timeouts.connect_ms)) {
    None -> smtp.fail(Unreachable),
    Some(ms) -> match net.connect[l](host, port, ms) {
      Some(h) -> h,
      None -> smtp.fail(Unreachable),
    },
  }

/// A session with the server at `host` and `port` over TLS from its first byte, as port 465
/// serves it (RFC 8314). The handshake completes and the server is verified as `host` before the
/// greeting, and then `c`'s credential is given if it has one.
///
/// Raises `smtp.fail`, with the connection closed: `Unreachable`, `HandshakeFailed` with
/// `std.net`'s reason for a server that is not `host` or shares no TLS version, and whatever
/// `feed` raises for the greeting, the server's offer, or the credential.
pub fn open_tls<[l]>(
  host: String,
  port: Int,
  c: Config,
) -> Session / {net.connect[l] bounded, net.start_tls[l] bounded, net.send[l], net.send_secret[l], net.recv[l], net.close[l], clock.read, task::deadline.at, entropy.next bounded, smtp.fail, abort.raise} = {
  let h = connected[l](host, port, c);
  match upgrade[l](h, host, b"", c.timeouts.connect_ms) {
    Some(reason) -> {
      net.close[l](h);
      smtp.fail(reason)
    },
    None ->
      established[l](
        h,
        c,
        { host: host, port: port, secure: true, nonce: nonce() },
        |_: Int, _: Bytes| Some(NotReady),
      ),
  }
}

/// Opens a session with the server at `host` and `port` over a connection that starts unencrypted,
/// as ports 587 and 25 do. It reads the greeting, starts TLS with `STARTTLS` as `c` requires,
/// verifies the server as `host`, and sends `c`'s credential if it has one.
///
/// Fails with `smtp.fail` and closes the connection for: `Unreachable`; `NoTls` when TLS is
/// required and the server does not offer it; `Injected` for bytes the server sent between its
/// go-ahead to start TLS and the handshake; `HandshakeFailed` with `std.net`'s reason; and anything
/// `feed` raises.
pub fn open<[l]>(
  host: String,
  port: Int,
  c: Config,
) -> Session / {net.connect[l] bounded, net.start_tls[l], net.send[l], net.send_secret[l], net.recv[l], net.close[l], clock.read, task::deadline.at, entropy.next bounded, smtp.fail, abort.raise} = {
  let h = connected[l](host, port, c);
  established[l](
    h,
    c,
    { host: host, port: port, secure: false, nonce: nonce() },
    |at: Int, unread: Bytes| upgrade[l](at, host, unread, c.timeouts.connect_ms),
  )
}

/// Sends `data` under `envelope` and returns what became of it for each recipient, never a plain
/// success. A recipient the server rejected, or told to try later, is in the result with the
/// server's reply. `dsn_request` is what to request of the servers about delivery reports.
///
/// Raises `smtp.fail`. If `usable` returns `true` for the error, the message was rejected before
/// any of it was written and the session is as it was. Otherwise the exchange failed and the
/// session is good only for `close`.
pub fn submit<[l]>(
  s: Session,
  envelope: Envelope,
  data: Bytes,
  dsn_request: Dsn = { return_content: None, envelope_id: None, notify: None, original: false },
) -> SendResult / {net.send[l], net.send_secret[l], net.recv[l], clock.read, task::deadline.at, smtp.fail, abort.raise} = {
  let d = drive[l](
    s.handle,
    mail(s.engine, envelope, data, dsn_request),
    [],
    None,
    |_: Int, _: Bytes| Some(NotReady),
    max_reads() * (envelope.recipients.len() + 8),
  );
  {
    session: {
      handle: s.handle,
      engine: d.engine,
      recent_lines: trim_transcript(config_of(d.engine).limits, s.recent_lines, d.lines),
    },
    deliveries: deliveries(d.engine),
  }
}

/// Sends a draft to everyone `std.email`'s `envelope` names, including its `Bcc` recipients, with
/// their field left out. It is written in ASCII wherever the draft allows, with a boundary drawn
/// from the host's entropy. Returns and raises as `submit` does, and raises `Unwritable` for a
/// draft that cannot be written.
pub fn send<[l]>(
  s: Session,
  d: Draft,
  dsn_request: Dsn = { return_content: None, envelope_id: None, notify: None, original: false },
) -> SendResult / {net.send[l], net.send_secret[l], net.recv[l], clock.read, task::deadline.at, entropy.next bounded, smtp.fail, abort.raise} =
  match try[email.unwritable] { email::write_fresh(d, email::repertoire_for(d)) } {
    Ok(data) -> submit[l](s, email::envelope(d), data, dsn_request),
    Err(reason) -> smtp.fail(Unwritable(reason)),
  }

/// Forwards a message that was read to everyone its fields name, as `std.email`'s
/// `message_envelope` reads them: the bytes it was read from, without its `Bcc` and `Resent-Bcc`
/// lines. Returns and raises as `submit` does, and raises `Unreadable` for a message that names no
/// envelope.
pub fn relay<[l]>(
  s: Session,
  m: Message,
  dsn_request: Dsn = { return_content: None, envelope_id: None, notify: None, original: false },
) -> SendResult / {net.send[l], net.send_secret[l], net.recv[l], clock.read, task::deadline.at, smtp.fail, abort.raise} =
  match try[email.fail] { email::message_envelope(m) } {
    Ok(envelope) ->
      submit[l](
        s,
        envelope,
        email::render(email::without(email::without(m, "Bcc"), "Resent-Bcc")),
        dsn_request,
      ),
    Err(reason) -> smtp.fail(Unreadable(reason)),
  }

fn send_quit<[l]>(
  s: Session,
) -> Unit / {net.send[l], net.send_secret[l], net.recv[l], clock.read, task::deadline.at, abort.raise} =
  match try[smtp.fail] {
      drive[l](s.handle, leave(s.engine), [], None, |_: Int, _: Bytes| Some(NotReady), max_reads())
    } {
    Ok(_) -> (),
    Err(_) -> (),
  }

/// Ends a session: sends `QUIT`, waits for the server's reply if it comes in time, and closes the
/// connection.
pub fn quit<[l]>(
  s: Session,
) -> Unit / {net.send[l], net.send_secret[l], net.recv[l], net.close[l], clock.read, task::deadline.at, abort.raise} = {
  send_quit[l](s);
  net.close[l](s.handle)
}

/// Closes a session's connection without sending anything: all that is left to do after an error
/// for which `usable` returns `false`.
pub fn close<[l]>(s: Session) -> Unit / {net.close[l]} = net.close[l](s.handle)

/// Opens a TLS session with the server at `host` and `port`, as `open_tls` does, runs `body` with
/// it, and returns what `body` returns. Sends `QUIT` when `body` returns and closes the session
/// however `body` ends. `body` must not quit or close the session itself.
pub fn with_session_tls<a, [l] | e>(
  host: String,
  port: Int,
  c: Config,
  body: (Session) -> a / e,
) -> a / {net.connect[l] bounded, net.start_tls[l] bounded, net.send[l], net.send_secret[l], net.recv[l], net.close[l], clock.read, task::deadline.at, entropy.next bounded, smtp.fail, abort.raise | e} =
  with_scope[session](open_tls[l](host, port, c), |s: Session| close[l](s)) { scoped_session -> {
    let s = scoped_session.get();
    let result_of = body(s);
    send_quit[l](s);
    result_of
  } }

/// Like `with_session_tls`, but opens the session as `open` does, on a connection that starts
/// unencrypted and is upgraded with `STARTTLS`.
pub fn with_session<a, [l] | e>(
  host: String,
  port: Int,
  c: Config,
  body: (Session) -> a / e,
) -> a / {net.connect[l] bounded, net.start_tls[l], net.send[l], net.send_secret[l], net.recv[l], net.close[l], clock.read, task::deadline.at, entropy.next bounded, smtp.fail, abort.raise | e} =
  with_scope[session](open[l](host, port, c), |s: Session| close[l](s)) { scoped_session -> {
    let s = scoped_session.get();
    let result_of = body(s);
    send_quit[l](s);
    result_of
  } }

/// Returns the capabilities the server most recently offered.
pub fn server_offered(s: Session) -> Option<Capabilities> = offered(s.engine)

/// The newest lines of a session's exchange, `Limits.transcript` of them at most, oldest
/// first. No credential is among them.
pub fn transcript(s: Session) -> List<Line> = s.recent_lines

/// Lines of an exchange as text, one per line: `C:` before what the client sent, `S:` before what
/// the server sent, and `*:` before anything else.
pub fn transcript_text(lines: List<Line>) -> String =
  String::join(
    lines.map(|l: Line|
      match l {
        Client(reply_of) -> if reply_of == "" { "C:" } else { "C: " ++ reply_of },
        Server(reply_of) -> "S: " ++ reply_of,
        Payload(n) -> "*: " ++ n.to_string() ++ " octets of message",
        Upgraded -> "*: TLS",
      }),
    "\n",
  )

fn reply_of(n: Int, texts: List<String>) -> Reply / {abort.raise} =
  match code(n) {
    None -> panic("no code"),
    Some(c) -> match reply(c, texts) { Some(r) -> r, None -> panic("no reply") },
  }

fn reply_summary(r: Reply) -> String = code_text(r.code) ++ "|" ++ String::join(r.lines, "|")

type Read = { data: Bytes, expect: Result<String, Error> }

fn reads() -> List<Read> =
  [
    { data: b"250 OK\r\n", expect: Ok("250|OK") },
    { data: b"250\r\n", expect: Ok("250|") },
    { data: b"250 \r\n", expect: Ok("250|") },
    {
      data: b"220 foo.com Simple Mail Transfer Service Ready\r\n",
      expect: Ok("220|foo.com Simple Mail Transfer Service Ready"),
    },
    {
      data: b"250-foo.com greets bar.com\r\n250-8BITMIME\r\n250-SIZE\r\n250-DSN\r\n250 HELP\r\n",
      expect: Ok("250|foo.com greets bar.com|8BITMIME|SIZE|DSN|HELP"),
    },
    { data: b"250-\r\n250\r\n", expect: Ok("250||") },
    {
      data: b"354 Start mail input; end with <CRLF>.<CRLF>\r\n",
      expect: Ok("354|Start mail input; end with <CRLF>.<CRLF>"),
    },
    { data: b"550 5.1.1 caf\xc3\xa9\tclosed\r\n", expect: Ok("550|5.1.1 caf\u{e9}\tclosed") },
    {
      data: b"571 not in RFC 5321's grammar, and sent all the same\r\n",
      expect: Ok("571|not in RFC 5321's grammar, and sent all the same"),
    },
    {
      data: b"550 bad \xff byte \x1b[31m and \x00\r\n",
      expect: Ok("550|bad \u{fffd} byte \u{fffd}[31m and \u{fffd}"),
    },
    { data: b"250 OK\n", expect: Err(BadLine) },
    { data: b"\n", expect: Err(BadLine) },
    { data: b"\r\n", expect: Err(BadLine) },
    { data: b"250 O\rK\r\n", expect: Err(BadLine) },
    { data: b"25 OK\r\n", expect: Err(BadLine) },
    { data: b"2500 OK\r\n", expect: Err(BadLine) },
    { data: b"250_OK\r\n", expect: Err(BadLine) },
    { data: b"199 too low\r\n", expect: Err(BadLine) },
    { data: b"600 too high\r\n", expect: Err(BadLine) },
    { data: b"-25 signed\r\n", expect: Err(BadLine) },
    { data: b"2 5 spaced\r\n", expect: Err(BadLine) },
    { data: b"OK\r\n", expect: Err(BadLine) },
    { data: b"250-first\r\n251 second\r\n", expect: Err(MixedCodes) },
    { data: b"250 OK\r\n250 again\r\n", expect: Err(Unsolicited) },
    { data: b"250 OK\r\nmore", expect: Err(Unsolicited) },
    { data: b"250 OK", expect: Err(BadLine) },
    { data: b"250-first\r\n", expect: Err(BadLine) },
    { data: b"", expect: Err(BadLine) },
  ]

test "the reply {r.data} is its code and the text of each of its lines, or is rejected" for r: Read in reads(
  ) { assert_eq(parse_reply(r.data, default_limits()).map(reply_summary), r.expect) }

test "a reply past a limit is rejected, whether or not its line has ended" {
  let tight: Limits = { line: 16, reply: 40, scram_iterations: 1, transcript: 0 };
  assert_eq(parse_reply(b"250 0123456789\r\n", tight).map(reply_summary), Ok("250|0123456789"));
  assert_eq(parse_reply(b"250 01234567890\r\n", tight), Err(LineTooLong));
  assert_eq(parse_reply(b"250 0123456789012", tight), Err(LineTooLong));
  assert_eq(
    parse_reply(b"250-0123456789\r\n250-0123456789\r\n250 01\r\n", tight).map(reply_summary),
    Ok("250|0123456789|0123456789|01"),
  );
  assert_eq(
    parse_reply(b"250-0123456789\r\n250-0123456789\r\n250 012\r\n", tight),
    Err(ReplyTooLarge),
  );
  assert_eq(
    parse_reply(b"250-0123456789\r\n250-0123456789\r\n250-01234", tight),
    Err(ReplyTooLarge),
  )
}

test "`render_reply` writes a reply in SMTP wire format, and `reply` rejects invalid text" {
  assert_eq(render_reply(reply_of(250, ["OK"])), b"250 OK\r\n");
  assert_eq(render_reply(reply_of(250, [""])), b"250\r\n");
  assert_eq(
    render_reply(reply_of(250, ["foo.com greets bar.com", "", "HELP"])),
    b"250-foo.com greets bar.com\r\n250-\r\n250 HELP\r\n",
  );
  assert_eq(reply_text(reply_of(250, ["foo.com", "HELP"])), "foo.com\nHELP");
  assert_eq(reply(Code(250), []), None);
  assert_eq(reply(Code(250), ["a\r\nb"]), None);
  assert_eq(reply(Code(250), ["a\u{7f}"]), None);
  assert_eq(result_is_ok_some(reply(Code(250), ["tab\there"])), true)
}

fn result_is_ok_some(r: Option<Reply>) -> Bool = r != None

fn reads_or_rejects(given: Bytes, limits: Limits) -> Bool =
  match try[abort.raise] {
      match parse_reply(given, limits) {
        Err(_) -> true,
        Ok(r) ->
          given.len() <= limits.reply && parse_reply(render_reply(r), default_limits()) == Ok(r),
      }
    } {
    Ok(accepted) -> accepted,
    Err(_) -> false,
  }

test "parsing any bytes as an SMTP reply either succeeds within the line and reply size limits or is rejected, including for truncated input" {
  gen::check2(gen::bytes(), gen::any_int(), |data: Bytes, cut: Int| {
    let tight: Limits = { line: 24, reply: 60, scram_iterations: 1, transcript: 0 };
    let lined = Bytes::concat_all([b"250-", data, b"\r\n250 ", data, b"\r\n"]);
    let n = lined.len() + 1;
    reads_or_rejects(data, tight) && reads_or_rejects(lined, tight)
      && reads_or_rejects(lined.slice(0, (cut % n + n) % n), tight)
  })
}

test "a code is three digits, the first of which reports what became of the command" {
  assert_eq(
    [199, 200, 250, 354, 421, 550, 599, 600, -250].map(|n: Int|
      match code(n) { Some(c) -> number(c), None -> 0 }),
    [0, 200, 250, 354, 421, 550, 599, 0, 0],
  );
  assert_eq(
    [220, 354, 451, 554].map(|n: Int| match code(n) { Some(c) -> Some(class_of(c)), None -> None }),
    [Some(Completed), Some(Intermediate), Some(Transient), Some(Rejected)],
  );
  assert_eq(show(code(250)), "Some(250)")
}

type StatusCase = { text: String, expect: Option<List<Int>> }

fn enhanced_status_cases() -> List<StatusCase> =
  [
    { text: "2.0.0", expect: Some([2, 0, 0]) },
    { text: "4.2.2", expect: Some([4, 2, 2]) },
    { text: "5.1.1", expect: Some([5, 1, 1]) },
    { text: "5.7.999", expect: Some([5, 7, 999]) },
    { text: "5.07.1", expect: Some([5, 7, 1]) },
    { text: "3.1.1", expect: None },
    { text: "1.0.0", expect: None },
    { text: "5.1", expect: None },
    { text: "5.1.1.1", expect: None },
    { text: "5.1000.1", expect: None },
    { text: "5.-1.1", expect: None },
    { text: "5..1", expect: None },
    { text: "5.1.x", expect: None },
    { text: " 5.1.1", expect: None },
    { text: "", expect: None },
  ]

test "the enhanced status {show(s.text)} is a class, a subject and a detail, or none" for s: StatusCase in enhanced_status_cases(
  ) { assert_eq(option_parts(read_status(s.text)), s.expect) }

fn option_parts(s: Option<Status>) -> Option<List<Int>> =
  match s { Some(status) -> Some(status_parts(status)), None -> None }

test "`enhanced_status` returns the status code at the start of a reply's text, only if its first digit matches the first digit of the reply code" {
  assert_eq(show(enhanced_status(reply_of(550, ["5.1.1 No such user"]))), "Some(5.1.1)");
  assert_eq(show(enhanced_status(reply_of(250, ["2.1.5 Ok", "2.1.5 more"]))), "Some(2.1.5)");
  assert_eq(
    show(enhanced_status(reply_of(451, ["4.7.1 Greylisted, try again in 300 seconds"]))),
    "Some(4.7.1)",
  );
  assert_eq(enhanced_status(reply_of(250, ["2.0.0"])), status(2, 0, 0));
  assert_eq(enhanced_status(reply_of(550, ["No such user"])), None);
  assert_eq(enhanced_status(reply_of(550, ["2.1.5 a status of another class"])), None);
  assert_eq(enhanced_status(reply_of(354, ["3.0.0 no such class"])), None);
  assert_eq(enhanced_status(reply_of(250, [""])), None);
  assert_eq(status(3, 0, 0), None);
  assert_eq(status(5, 1000, 0), None);
  assert_eq(status(5, 0, -1), None)
}

test "what a server offers is read from the lines after its name" {
  let c = capabilities(
    reply_of(250, [
      "mx.example at your service, [192.0.2.7]",
      "SIZE 35651584",
      "8bitmime",
      "AUTH LOGIN PLAIN XOAUTH2 PLAIN-CLIENTTOKEN OAUTHBEARER scram-sha-256 CRAM-MD5",
      "ENHANCEDSTATUSCODES",
      "PIPELINING",
      "CHUNKING",
      "SMTPUTF8",
      "STARTTLS",
      "DSN",
      "X-EXPS GSSAPI NTLM",
      "HELP",
      "",
    ]),
  );
  assert_eq(c.greeting, "mx.example at your service, [192.0.2.7]");
  assert_eq(c.size, AtMost(35651584));
  assert_eq(c.auth, [
    sasl::Login,
    sasl::Plain,
    sasl::XOAuth2,
    sasl::OAuthBearer,
    sasl::ScramSha256,
  ]);
  assert_eq(c.unsupported_mechanisms, ["PLAIN-CLIENTTOKEN", "CRAM-MD5"]);
  assert_eq([c.starttls, c.pipelining, c.eight_bit, c.utf8, c.chunking, c.dsn, c.enhanced], [
    true,
    true,
    true,
    true,
    true,
    true,
    true,
  ]);
  assert_eq(c.others, [
    { keyword: "X-EXPS", params: ["GSSAPI", "NTLM"] },
    { keyword: "HELP", params: [] },
  ])
}

test "a server that names itself and nothing else offers nothing" {
  assert_eq(capabilities(reply_of(250, ["mx.example"])), nothing_offered("mx.example"));
  assert_eq(capabilities(reply_of(250, ["STARTTLS"])), nothing_offered("STARTTLS"));
  assert_eq(capabilities(reply_of(250, [""])), nothing_offered(""))
}

test "SIZE states a limit, or none, and AUTH is also read in the form old servers wrote" {
  let size_of = |line: String| capabilities(reply_of(250, ["mx.example", line])).size;
  assert_eq(size_of("SIZE"), Unbounded);
  assert_eq(size_of("SIZE 0"), Unbounded);
  assert_eq(size_of("SIZE 1000"), AtMost(1000));
  assert_eq(size_of("size 1000"), AtMost(1000));
  assert_eq(size_of("SIZE lots"), Unbounded);
  assert_eq(size_of("SIZE -5"), Unbounded);
  assert_eq(size_of("SIZES 1000"), NotAdvertised);
  assert_eq(capabilities(reply_of(250, ["mx", "AUTH=PLAIN LOGIN", "AUTH PLAIN"])).auth, [
    sasl::Plain,
    sasl::Login,
  ]);
  assert_eq(capabilities(reply_of(250, ["mx", "AUTH"])).auth, [])
}

type StuffingCase = { body: Bytes, expect: Bytes }

fn stuffings() -> List<StuffingCase> =
  [
    { body: b"", expect: b"" },
    {
      body: b"Blah blah blah...\r\n...etc. etc. etc.\r\n",
      expect: b"Blah blah blah...\r\n....etc. etc. etc.\r\n",
    },
    { body: b".\r\n", expect: b"..\r\n" },
    { body: b"a\r\n.\r\nb\r\n", expect: b"a\r\n..\r\nb\r\n" },
    { body: b".\r\n.\r\n..\r\n", expect: b"..\r\n..\r\n...\r\n" },
    { body: b"a.b\r\nc.\r\n", expect: b"a.b\r\nc.\r\n" },
    { body: b"\r\n.", expect: b"\r\n.." },
  ]

test "`dot_stuff` adds a dot to each line of the body that starts with a dot, and `unstuff` removes it: {s.body}" for s: StuffingCase in stuffings(
  ) {
  assert_eq(dot_stuff(s.body), s.expect);
  assert_eq(unstuff(s.expect), s.body)
}

type Lines = | Lines(Bytes)

fn lined() -> Gen<Lines> =
  gen::map(
    gen::list_of(
      gen::elements([b".", b"..", b"\r\n", b"\r\n", b"a", b"\r", b"\n", b" .", b"\r\n.\r\n"]),
      12,
    ),
    |pieces: List<Bytes>| Lines(Bytes::concat_all(pieces)),
  )

fn unlined(l: Lines) -> Bytes = match l { Lines(body) -> body }

test "`unstuff` reverses `dot_stuff` for any bytes, giving back the original body" {
  gen::check(gen::bytes(), |x: Bytes| inverse(dot_stuff, unstuff, x))
}

test "`dot_stuff` output never has a line that is only a dot, which would end the message body early" {
  gen::check2(lined(), gen::bytes(), |l: Lines, raw: Bytes| {
    [unlined(l), raw].all(|body: Bytes| !b"\r\n".concat(dot_stuff(body)).contains(b"\r\n.\r\n"))
  })
}

type MessageErrorCase = { what: String, data: Bytes, expect: Option<Error> }

fn flawed() -> List<MessageErrorCase> =
  [
    { what: "no bytes", data: b"", expect: None },
    {
      what: "a field, a blank line and a body",
      data: b"Subject: hi\r\n\r\nbody\r\n",
      expect: None,
    },
    { what: "one blank line", data: b"\r\n", expect: None },
    { what: "a line of 998 bytes", data: b"x".repeat(998).concat(b"\r\n"), expect: None },
    {
      what: "a bare line feed",
      data: b"a\nb\r\n",
      expect: Some(Unsendable({ at: 1, reason: email::BareLineFeed })),
    },
    {
      what: "a dot and a bare line feed",
      data: b"a\r\n.\n",
      expect: Some(Unsendable({ at: 4, reason: email::BareLineFeed })),
    },
    {
      what: "a bare carriage return",
      data: b"a\rb\r\n",
      expect: Some(Unsendable({ at: 1, reason: email::BareCarriageReturn })),
    },
    {
      what: "a dot and a bare carriage return",
      data: b"a\r\n.\r",
      expect: Some(Unsendable({ at: 4, reason: email::BareCarriageReturn })),
    },
    {
      what: "a line of 999 bytes",
      data: b"x".repeat(999).concat(b"\r\n"),
      expect: Some(Unsendable({ at: 998, reason: email::LongLine })),
    },
    { what: "a NUL", data: b"a\x00b\r\n", expect: Some(NulByte(1)) },
    { what: "a last line left open", data: b"a\r\nb", expect: Some(Unterminated) },
    { what: "one line left open", data: b"a", expect: Some(Unterminated) },
  ]

test "`message_error` returns the byte offset where a message stops being CRLF-terminated lines, and does not repair it: {f.what}" for f: MessageErrorCase in flawed(
  ) { assert_eq(message_error(f.data), f.expect) }

test "a parameter's text is carried as printable ASCII" {
  assert_eq(xtext("QQ314159"), "QQ314159");
  assert_eq(xtext("Bob@Example.COM"), "Bob@Example.COM");
  assert_eq(xtext("a+b=c d"), "a+2Bb+3Dc+20d");
  assert_eq(xtext("caf\u{e9}\r\n"), "caf+C3+A9+0D+0A");
  assert_eq(xtext(""), "");
  assert_eq(original_of(email::address("Bob", "Example.COM")), "rfc822;Bob@Example.COM");
  assert_eq(original_of(email::address("a+b", "example.org")), "rfc822;a+2Bb@example.org");
  assert_eq(
    original_of(email::address("j\u{fc}rgen m=1", "example.org", email::Utf8)),
    "utf-8;\"j\u{fc}rgen\\x{20}m\\x{3D}1\"@example.org",
  )
}

test "a client greets by a domain or an address in brackets, and by nothing else" {
  let named = |client: String| Result::is_ok(try[smtp.fail] { config(client, default_limits()) });
  assert(named("client.example"));
  assert(named("localhost"));
  assert(named("[192.0.2.1]"));
  assert(named("[IPv6:2001:db8::1]"));
  assert(!named(""));
  assert(!named("client.example\r\nMAIL FROM:<eve@example.org>"));
  assert(!named("two words"));
  assert(!named("a@b"));
  assert(!named("b\u{fc}cher.example"));
  assert(!named("client.example>"))
}

type ServerEvent = | ServerSends(Bytes) | TlsStarts | ServerCloses

type Act = | Deliver(Envelope, Bytes, Dsn) | Bye

type RecordingReader = { events: List<ServerEvent>, run: List<String> }

fn flush_server_lines(t: RecordingReader) -> List<ServerEvent> =
  if t.run.len() == 0 { t.events }
  else { t.events.push(ServerSends(Bytes::of_string(String::join(t.run, "\r\n") ++ "\r\n"))) }

fn beats_of(recording: String) -> List<ServerEvent> / {abort.raise} =
  flush_server_lines(
    recording.split("\n").fold({ events: [], run: [] }, |t: RecordingReader, line: String|
      if line.starts_with("S:") {
        { events: t.events, run: t.run.push(line.slice(min(3, line.len()), line.len())) }
      } else if line == "*: TLS" { { events: flush_server_lines(t).push(TlsStarts), run: [] } }
      else if line == "*: closed" { { events: flush_server_lines(t).push(ServerCloses), run: [] } }
      else { { events: flush_server_lines(t), run: [] } }),
  )

fn marked(mark: String, sent: Bytes) -> List<String> =
  if sent.len() < 2 { [] } else {
    String::of_bytes_lossy(sent.slice(0, sent.len() - 2)).split("\r\n").map(|line: String|
      if line == "" { mark } else { mark ++ " " ++ line })
  }

fn written(t: Turn) -> List<String> =
  List::concat(if t.reply_lines.contains(Upgraded) { ["*: TLS"] } else { [] }, match t.out {
    Veiled(_, _, _) ->
      t.reply_lines.filter(|l: Line| match l { Client(_) -> true, _ -> false }).map(|l: Line|
        transcript_text([l])),
    Open(sent) -> marked("C:", sent),
  })

fn stage_word(s: Stage) -> String =
  match s { AtMail -> "MAIL", AtRcpt -> "RCPT", AtData -> "DATA", AtEnd -> "end" }

fn delivery_summary(d: Delivery) -> String =
  show(d.recipient) ++ " "
    ++ (match d.outcome {
      Accepted(r) -> "accepted " ++ code_text(r.code),
      Temporary(stage, r) -> "temporary " ++ stage_word(stage) ++ " " ++ code_text(r.code),
      Permanent(stage, r) -> "permanent " ++ stage_word(stage) ++ " " ++ code_text(r.code),
    })

fn open_bytes(w: Wire) -> Bytes = match w { Open(reply_of) -> reply_of, Veiled(_, _, _) -> b"" }

fn starred_bytes(w: Wire) -> Bytes =
  match w {
    Open(reply_of) -> reply_of,
    Veiled(lead, _, end) -> Bytes::concat_all([lead, b"****", end]),
  }

type ReplayState = {
  lines: List<String>,
  wire: Bytes,
  sealed: List<Secret<Bytes>>,
  shown: String,
  outcomes: List<String>,
  delivering: Bool,
  engine: Engine,
}

type ReplayResult = {
  exchange: String,
  wire: Bytes,
  sealed: List<Secret<Bytes>>,
  shown: String,
  engine: Engine,
  ended: Result<List<String>, Error>,
}

fn replay_result(t: ReplayState, how: Result<List<String>, Error>) -> ReplayResult =
  {
    exchange: String::join(t.lines, "\n"),
    wire: t.wire,
    sealed: t.sealed,
    shown: t.shown,
    engine: t.engine,
    ended: how,
  }

type ReplayStep =
  | Halt(Result<List<String>, Error>)
  | Onward(Result<Turn, Error>, List<ServerEvent>, List<Act>, ReplayState)

fn onward(
  t: Turn,
  beats: List<ServerEvent>,
  acts: List<Act>,
  here: ReplayState,
) -> ReplayStep / {abort.raise} =
  match t.next {
    Over -> Halt(Ok(here.outcomes)),
    Secure -> match beats {
      [TlsStarts, ..later] -> Onward(try[smtp.fail] { tls_started(t.engine) }, later, acts, here),
      [ServerSends(chunk), ..later] ->
        Onward(try[smtp.fail] { feed(t.engine, chunk) }, later, acts, {
          ..here,
          lines: here.lines.concat(marked("S:", chunk)),
        }),
      _ -> Halt(Err(HandshakeFailed(net::Reset))),
    },
    Await(p) -> match beats {
      [ServerSends(chunk), ..later] ->
        Onward(try[smtp.fail] { feed(t.engine, chunk) }, later, acts, {
          ..here,
          lines: here.lines.concat(marked("S:", chunk)),
        }),
      [ServerCloses, ..later] ->
        Onward(try[smtp.fail] { connection_closed(t.engine) }, later, acts, {
          ..here,
          lines: here.lines.push("*: closed"),
        }),
      _ -> Halt(Err(TimedOut(p))),
    },
    Ready -> match acts {
      [] -> Halt(Ok(here.outcomes)),
      [Bye, ..rest] -> Onward(try[smtp.fail] { leave(t.engine) }, beats, rest, here),
      [Deliver(envelope, data, dsn_request), ..rest] -> match try[smtp.fail] {
          mail(t.engine, envelope, data, dsn_request)
        } {
        Ok(next_turn) -> Onward(Ok(next_turn), beats, rest, { ..here, delivering: true }),
        Err(reason) -> if !usable(reason) { Halt(Err(reason)) } else {
          Onward(Ok({ ..t, out: Open(b""), reply_lines: [] }), beats, rest, {
            ..here,
            outcomes: here.outcomes.push("rejected: " ++ show(reason)),
          })
        },
      },
    },
  }

fn replay(
  t: Turn,
  beats: List<ServerEvent>,
  acts: List<Act>,
  tale: ReplayState,
  left: Int,
) -> ReplayResult / {abort.raise} = {
  let rests = t.next == Ready || t.next == Over;
  let here: ReplayState = {
    lines: tale.lines.concat(written(t)),
    wire: tale.wire.concat(open_bytes(t.out)),
    sealed: match t.out {
      Veiled(lead, reply_of, end) ->
        tale.sealed.push(net::sent_secret(lead, reply_of, "base64", end)),
      Open(_) -> tale.sealed,
    },
    shown: tale.shown ++ show(t),
    outcomes: if tale.delivering && rests {
      tale.outcomes.concat(deliveries(t.engine).map(delivery_summary))
    } else { tale.outcomes },
    delivering: tale.delivering && !rests,
    engine: t.engine,
  };
  match onward(t, beats, acts, here) {
    Halt(how) -> replay_result(here, how),
    Onward(next_turn, beats_left, acts_left, now) -> match next_turn {
      Err(reason) -> replay_result(now, Err(reason)),
      Ok(turned) -> if left <= 0 { replay_result(now, Err(NotReady)) }
      else { replay(turned, beats_left, acts_left, now, left - 1) },
    },
  }
}

fn link(secure: Bool) -> Link =
  { host: "mx.example", port: 587, secure: secure, nonce: "rOprNGfwEbeRWgbNEkqO" }

fn played(
  client: Config,
  secure: Bool,
  acts: List<Act>,
  beats: List<ServerEvent>,
) -> ReplayResult / {abort.raise} = {
  let first_turn = start(client, link(secure));
  replay(
    first_turn,
    beats,
    acts,
    {
      lines: [],
      wire: b"",
      sealed: [],
      shown: "",
      outcomes: [],
      delivering: false,
      engine: first_turn.engine,
    },
    2000,
  )
}

fn replayed(
  client: Config,
  secure: Bool,
  acts: List<Act>,
  exchange: String,
) -> ReplayResult / {abort.raise} = played(client, secure, acts, beats_of(exchange))

fn test_sender() -> Address / {email.fail, abort.raise} = email::address("Smith", "bar.com")

fn test_recipients(names: List<String>) -> List<Address> / {email.fail, abort.raise} =
  names.map(|who: String| email::address(who, "foo.com"))

fn test_message() -> Bytes = b"Blah blah blah...\r\n...etc. etc. etc.\r\n"

fn deliver(names: List<String>) -> Act / {email.fail, abort.raise} =
  Deliver(
    email::envelope_of(ReturnTo(test_sender()), test_recipients(names)),
    test_message(),
    no_dsn(),
  )

fn client() -> Config / {smtp.fail, abort.raise} = config("client.example", default_limits())

fn tim_password() -> Credential / {sasl.fail} =
  sasl::password("tim", Secret::of_bytes(b"tanstaaftanstaaf"))

fn user_password() -> Credential / {sasl.fail} = sasl::password("user", Secret::of_bytes(b"pencil"))

type TestCredential = | Nobody | TimPassword | Pencil | Bearer(String)

type Setup = {
  name: String,
  tls: TlsPolicy,
  credential: TestCredential,
  mechanisms: Option<List<Mechanism>>,
  exposure: Exposure,
  helo: Bool,
}

fn setup() -> Setup =
  {
    name: "client.example",
    tls: RequireTls,
    credential: Nobody,
    mechanisms: None,
    exposure: Protected,
    helo: false,
  }

fn named_as(name: String) -> Setup = { ..setup(), name: name }

fn tls_as(s: Setup, policy: TlsPolicy) -> Setup = { ..s, tls: policy }

fn given(s: Setup, h: TestCredential) -> Setup = { ..s, credential: h }

fn mechs(s: Setup, order: List<Mechanism>) -> Setup = { ..s, mechanisms: Some(order) }

fn clear_password(s: Setup) -> Setup = { ..s, exposure: PasswordInClear }

fn helo(s: Setup) -> Setup = { ..s, helo: true }

fn configured(s: Setup) -> Config / {abort.raise} = {
  let credential_result = match s.credential {
    Nobody -> Ok(None),
    TimPassword -> try[sasl.fail] { Some(tim_password()) },
    Pencil -> try[sasl.fail] { Some(user_password()) },
    Bearer(token) -> try[sasl.fail] { Some(sasl::bearer("tim", Secret::of_string(token).bytes())) },
  };
  match ((try[smtp.fail] { config(s.name, default_limits()) }, credential_result)) {
    (Ok(bare), Ok(credential)) -> {
      let c = with_exposure(with_tls(bare, s.tls), s.exposure);
      let given = match credential { Some(k) -> with_credential(c, k), None -> c };
      let ordered = match s.mechanisms {
        Some(order) -> with_mechanisms(given, order),
        None -> given,
      };
      if s.helo { with_helo_fallback(ordered) } else { ordered }
    },
    _ -> panic("the client settings of a test case are invalid"),
  }
}

type RecordingCase = {
  what: String,
  client: Setup,
  secure: Bool,
  acts: List<Act>,
  exchange: String,
  ended: Result<List<String>, Error>,
}

fn sendings() -> List<RecordingCase> / {email.fail, abort.raise} =
  [
    {
      what: "RFC 5321 D.1: three recipients, of whom one has no mailbox",
      client: tls_as(named_as("bar.com"), Plain),
      secure: false,
      acts: [deliver(["Jones", "Green", "Brown"]), Bye],
      exchange:
        \\S: 220 foo.com Simple Mail Transfer Service Ready
        \\C: EHLO bar.com
        \\S: 250-foo.com greets bar.com
        \\S: 250-8BITMIME
        \\S: 250-SIZE
        \\S: 250-DSN
        \\S: 250 HELP
        \\C: MAIL FROM:<Smith@bar.com> SIZE=38
        \\S: 250 OK
        \\C: RCPT TO:<Jones@foo.com>
        \\S: 250 OK
        \\C: RCPT TO:<Green@foo.com>
        \\S: 550 No such user here
        \\C: RCPT TO:<Brown@foo.com>
        \\S: 250 OK
        \\C: DATA
        \\S: 354 Start mail input; end with <CRLF>.<CRLF>
        \\C: Blah blah blah...
        \\C: ....etc. etc. etc.
        \\C: .
        \\S: 250 OK
        \\C: QUIT
        \\S: 221 foo.com Service closing transmission channel
      ,
      ended: Ok([
        "Jones@foo.com accepted 250",
        "Green@foo.com permanent RCPT 550",
        "Brown@foo.com accepted 250",
      ]),
    },
    {
      what: "STARTTLS, a second EHLO, AUTH PLAIN, and two messages in pipelined commands with a RSET between",
      client: given(setup(), TimPassword),
      secure: false,
      acts: [deliver(["Jones", "Green"]), deliver(["Brown"]), Bye],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250-PIPELINING
        \\S: 250-AUTH PLAIN LOGIN
        \\S: 250 STARTTLS
        \\C: STARTTLS
        \\S: 220 2.0.0 Ready to start TLS
        \\*: TLS
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250-PIPELINING
        \\S: 250-SIZE 10240000
        \\S: 250-ENHANCEDSTATUSCODES
        \\S: 250-8BITMIME
        \\S: 250 AUTH PLAIN LOGIN
        \\C: AUTH PLAIN ****
        \\S: 235 2.7.0 Authentication successful
        \\C: MAIL FROM:<Smith@bar.com> SIZE=38
        \\C: RCPT TO:<Jones@foo.com>
        \\C: RCPT TO:<Green@foo.com>
        \\C: DATA
        \\S: 250 2.1.0 Ok
        \\S: 250 2.1.5 Ok
        \\S: 450 4.2.2 Mailbox full
        \\S: 354 End data with <CR><LF>.<CR><LF>
        \\C: Blah blah blah...
        \\C: ....etc. etc. etc.
        \\C: .
        \\S: 250 2.0.0 Ok: queued as 4F2A91
        \\C: RSET
        \\C: MAIL FROM:<Smith@bar.com> SIZE=38
        \\C: RCPT TO:<Brown@foo.com>
        \\C: DATA
        \\S: 250 2.0.0 Ok
        \\S: 250 2.1.0 Ok
        \\S: 250 2.1.5 Ok
        \\S: 354 End data with <CR><LF>.<CR><LF>
        \\C: Blah blah blah...
        \\C: ....etc. etc. etc.
        \\C: .
        \\S: 250 2.0.0 Ok: queued as 4F2A92
        \\C: QUIT
        \\S: 221 2.0.0 Bye
      ,
      ended: Ok([
        "Jones@foo.com accepted 250",
        "Green@foo.com temporary RCPT 450",
        "Brown@foo.com accepted 250",
      ]),
    },
    {
      what: "a sender told to come back later: every recipient may be tried again",
      client: setup(),
      secure: true,
      acts: [deliver(["Jones", "Brown"]), Bye],
      exchange:
        \\S: 220-mx.example ESMTP
        \\S: 220 Unsolicited commercial mail is not welcome here
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 ENHANCEDSTATUSCODES
        \\C: MAIL FROM:<Smith@bar.com>
        \\S: 451 4.7.1 Greylisted, try again in 300 seconds
        \\C: QUIT
        \\S: 221 2.0.0 Bye
      ,
      ended: Ok(["Jones@foo.com temporary MAIL 451", "Brown@foo.com temporary MAIL 451"]),
    },
    {
      what: "the server rejects EHLO and accepts only HELO, so the client falls back to HELO; the server also replies 251 to say it will forward mail for the recipient",
      client: helo(tls_as(setup(), Plain)),
      secure: false,
      acts: [deliver(["Jones"])],
      exchange:
        \\S: 220 old.example Sendmail 5.61 ready
        \\C: EHLO client.example
        \\S: 500 Command unrecognized
        \\C: HELO client.example
        \\S: 250 old.example Hello client.example
        \\C: MAIL FROM:<Smith@bar.com>
        \\S: 250 Sender ok
        \\C: RCPT TO:<Jones@foo.com>
        \\S: 251 User not local; will forward to <Jones@elsewhere.example>
        \\C: DATA
        \\S: 354 Enter mail
        \\C: Blah blah blah...
        \\C: ....etc. etc. etc.
        \\C: .
        \\S: 250 Ok
      ,
      ended: Ok(["Jones@foo.com accepted 250"]),
    },
    {
      what: "the server replies 552 because there are too many recipients, so the client sends the remaining recipients again; it sends no DATA command when the server accepted no recipient",
      client: setup(),
      secure: true,
      acts: [deliver(["Jones", "Green"]), Bye],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250 mx.example
        \\C: MAIL FROM:<Smith@bar.com>
        \\S: 250 OK
        \\C: RCPT TO:<Jones@foo.com>
        \\S: 552 Too many recipients
        \\C: RCPT TO:<Green@foo.com>
        \\S: 550 No such user here
        \\C: QUIT
        \\S: 221 Bye
      ,
      ended: Ok(["Jones@foo.com temporary RCPT 552", "Green@foo.com permanent RCPT 550"]),
    },
    {
      what: "a pipelined DATA given leave with no recipient taken is responded to with no message",
      client: setup(),
      secure: true,
      acts: [deliver(["Green"]), deliver(["Jones"])],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 PIPELINING
        \\C: MAIL FROM:<Smith@bar.com>
        \\C: RCPT TO:<Green@foo.com>
        \\C: DATA
        \\S: 250 OK
        \\S: 550 No such user here
        \\S: 354 Go ahead
        \\C: .
        \\S: 554 No valid recipients
        \\C: RSET
        \\C: MAIL FROM:<Smith@bar.com>
        \\C: RCPT TO:<Jones@foo.com>
        \\C: DATA
        \\S: 250 Reset
        \\S: 250 OK
        \\S: 250 OK
        \\S: 554 5.5.1 Not today
      ,
      ended: Ok(["Green@foo.com permanent RCPT 550", "Jones@foo.com permanent DATA 554"]),
    },
    {
      what: "a message rejected once it was read, for good and then for now",
      client: setup(),
      secure: true,
      acts: [deliver(["Jones", "Brown"]), deliver(["Jones"])],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 PIPELINING
        \\C: MAIL FROM:<Smith@bar.com>
        \\C: RCPT TO:<Jones@foo.com>
        \\C: RCPT TO:<Brown@foo.com>
        \\C: DATA
        \\S: 250 OK
        \\S: 250 OK
        \\S: 250 OK
        \\S: 354 Go ahead
        \\C: Blah blah blah...
        \\C: ....etc. etc. etc.
        \\C: .
        \\S: 550 5.7.1 Message content rejected
        \\C: RSET
        \\C: MAIL FROM:<Smith@bar.com>
        \\C: RCPT TO:<Jones@foo.com>
        \\C: DATA
        \\S: 250 OK
        \\S: 250 OK
        \\S: 250 OK
        \\S: 354 Go ahead
        \\C: Blah blah blah...
        \\C: ....etc. etc. etc.
        \\C: .
        \\S: 452 4.3.1 Insufficient system storage
      ,
      ended: Ok([
        "Jones@foo.com permanent end 550",
        "Brown@foo.com permanent end 550",
        "Jones@foo.com temporary end 452",
      ]),
    },
    {
      what: "a server closing down in the middle of a message: everyone is tried again, and the session is over",
      client: setup(),
      secure: true,
      acts: [deliver(["Jones", "Brown"]), deliver(["Green"])],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 PIPELINING
        \\C: MAIL FROM:<Smith@bar.com>
        \\C: RCPT TO:<Jones@foo.com>
        \\C: RCPT TO:<Brown@foo.com>
        \\C: DATA
        \\S: 250 2.1.0 Ok
        \\S: 250 2.1.5 Ok
        \\S: 421 4.3.2 System shutting down
      ,
      ended: Ok(["Jones@foo.com temporary RCPT 421", "Brown@foo.com temporary RCPT 421"]),
    },
    {
      what: "a message past the size the server takes is rejected before a byte of it is sent, and the session goes on",
      client: setup(),
      secure: true,
      acts: [
        deliver(["Jones"]),
        Deliver(
          email::envelope_of(ReturnTo(test_sender()), test_recipients(["Jones"])),
          b"Hi\r\n",
          no_dsn(),
        ),
      ],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 SIZE 30
        \\C: MAIL FROM:<Smith@bar.com> SIZE=4
        \\S: 250 OK
        \\C: RCPT TO:<Jones@foo.com>
        \\S: 250 OK
        \\C: DATA
        \\S: 354 Go ahead
        \\C: Hi
        \\C: .
        \\S: 250 OK
      ,
      ended: Ok(["rejected: TooLarge(38, 30)", "Jones@foo.com accepted 250"]),
    },
    {
      what: "addresses and bytes outside ASCII go only to a server that takes them, and are declared",
      client: setup(),
      secure: true,
      acts: [
        Deliver(
          email::envelope_of(ReturnTo(test_sender()), [
            email::address("\u{7528}\u{6237}", "\u{4f8b}\u{3048}.jp", email::Utf8),
          ]),
          Bytes::of_string("Subject: hi\r\n\r\nGr\u{fc}\u{df}e\r\n"),
          no_dsn(),
        ),
        Deliver(
          email::envelope_of(ReturnTo(test_sender()), test_recipients(["Jones"])),
          Bytes::of_string("Subject: Gr\u{fc}\u{df}e\r\n\r\nHi.\r\n"),
          no_dsn(),
        ),
        Deliver(
          email::envelope_of(ReturnTo(test_sender()), test_recipients(["Jones"])),
          Bytes::of_string("Subject: hi\r\n\r\nGr\u{fc}\u{df}e\r\n"),
          no_dsn(),
        ),
      ],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250-PIPELINING
        \\S: 250-8BITMIME
        \\S: 250 SMTPUTF8
        \\C: MAIL FROM:<Smith@bar.com> BODY=8BITMIME SMTPUTF8
        \\C: RCPT TO:<用户@例え.jp>
        \\C: DATA
        \\S: 250 OK
        \\S: 250 OK
        \\S: 354 Go ahead
        \\C: Subject: hi
        \\C:
        \\C: Grüße
        \\C: .
        \\S: 250 OK
        \\C: RSET
        \\C: MAIL FROM:<Smith@bar.com> BODY=8BITMIME SMTPUTF8
        \\C: RCPT TO:<Jones@foo.com>
        \\C: DATA
        \\S: 250 OK
        \\S: 250 OK
        \\S: 250 OK
        \\S: 354 Go ahead
        \\C: Subject: Grüße
        \\C:
        \\C: Hi.
        \\C: .
        \\S: 250 OK
        \\C: RSET
        \\C: MAIL FROM:<Smith@bar.com> BODY=8BITMIME
        \\C: RCPT TO:<Jones@foo.com>
        \\C: DATA
        \\S: 250 OK
        \\S: 250 OK
        \\S: 250 OK
        \\S: 354 Go ahead
        \\C: Subject: hi
        \\C:
        \\C: Grüße
        \\C: .
        \\S: 250 OK
      ,
      ended: Ok([
        "\u{7528}\u{6237}@\u{4f8b}\u{3048}.jp accepted 250",
        "Jones@foo.com accepted 250",
        "Jones@foo.com accepted 250",
      ]),
    },
    {
      what: "a server that takes neither is sent neither, and the session goes on",
      client: setup(),
      secure: true,
      acts: [
        Deliver(
          email::envelope_of(ReturnTo(test_sender()), [
            email::address("\u{7528}\u{6237}", "example.org", email::Utf8),
          ]),
          test_message(),
          no_dsn(),
        ),
        Deliver(
          email::envelope_of(ReturnTo(test_sender()), test_recipients(["Jones"])),
          Bytes::of_string("Subject: Gr\u{fc}\u{df}e\r\n\r\nHi.\r\n"),
          no_dsn(),
        ),
        Deliver(
          email::envelope_of(ReturnTo(test_sender()), test_recipients(["Jones"])),
          test_message(),
          { return_content: None, envelope_id: None, notify: Some([]), original: false },
        ),
        Deliver(email::envelope_of(ReturnTo(test_sender()), []), test_message(), no_dsn()),
        Deliver(
          email::envelope_of(ReturnTo(test_sender()), test_recipients(["Jones"])),
          b"a\nb\r\n",
          no_dsn(),
        ),
        Bye,
      ],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250 mx.example
        \\C: QUIT
        \\S: 221 Bye
      ,
      ended: Ok([
        "rejected: MissingExtension(SmtpUtf8)",
        "rejected: MissingExtension(EightBitMime)",
        "rejected: MissingExtension(Notices)",
        "rejected: NoRecipients",
        "rejected: Unsendable({at: 1, reason: BareLineFeed})",
      ]),
    },
    {
      what: "RFC 3461's requests for reports, a bounce's null reverse path, and a local part that needs its quotes",
      client: setup(),
      secure: true,
      acts: [
        Deliver(
          email::envelope_of(ReturnTo(email::address("Alice", "Example.ORG")), [
            email::address("Bob", "Example.COM"),
            email::address("john doe", "example.org"),
          ]),
          test_message(),
          {
            return_content: Some(Headers),
            envelope_id: Some("QQ314159"),
            notify: Some([Failed, Delivered]),
            original: true,
          },
        ),
        Deliver(
          email::envelope_of(NullPath, [email::address("Alice", "Example.ORG")]),
          test_message(),
          { return_content: Some(Full), envelope_id: None, notify: Some([]), original: false },
        ),
        Deliver(
          email::envelope_of(NullPath, [email::address("Alice", "Example.ORG")]),
          test_message(),
          { return_content: None, envelope_id: Some("caf\u{e9}"), notify: None, original: false },
        ),
      ],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250-PIPELINING
        \\S: 250 DSN
        \\C: MAIL FROM:<Alice@Example.ORG> RET=HDRS ENVID=QQ314159
        \\C: RCPT TO:<Bob@Example.COM> NOTIFY=SUCCESS,FAILURE ORCPT=rfc822;Bob@Example.COM
        \\C: RCPT TO:<"john doe"@example.org> NOTIFY=SUCCESS,FAILURE ORCPT=rfc822;"john+20doe"@example.org
        \\C: DATA
        \\S: 250 OK
        \\S: 250 OK
        \\S: 250 OK
        \\S: 354 Go ahead
        \\C: Blah blah blah...
        \\C: ....etc. etc. etc.
        \\C: .
        \\S: 250 OK
        \\C: RSET
        \\C: MAIL FROM:<> RET=FULL
        \\C: RCPT TO:<Alice@Example.ORG> NOTIFY=NEVER
        \\C: DATA
        \\S: 250 OK
        \\S: 250 OK
        \\S: 250 OK
        \\S: 354 Go ahead
        \\C: Blah blah blah...
        \\C: ....etc. etc. etc.
        \\C: .
        \\S: 250 OK
      ,
      ended: Ok([
        "Bob@Example.COM accepted 250",
        "\"john doe\"@example.org accepted 250",
        "Alice@Example.ORG accepted 250",
        "rejected: BadEnvelopeId",
      ]),
    },
  ]

test "replaying a recorded successful SMTP exchange sends the recorded bytes and reports each recipient's result: {r.what}" for r: RecordingCase in sendings(
  ) {
  let got = replayed(configured(r.client), r.secure, r.acts, r.exchange);
  assert_eq(got.exchange, r.exchange);
  assert_eq(got.ended, r.ended)
}

fn failings() -> List<RecordingCase> / {email.fail, abort.raise} =
  [
    {
      what: "CVE-2011-0411: what is read with the leave to start TLS is not kept for after it",
      client: setup(),
      secure: false,
      acts: [],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 STARTTLS
        \\C: STARTTLS
        \\S: 220 2.0.0 Ready to start TLS
        \\S: 250-mx.example
        \\S: 250 AUTH PLAIN
      ,
      ended: Err(Injected),
    },
    {
      what: "a server that drops the connection after the message was sent",
      client: setup(),
      secure: true,
      acts: [deliver(["Jones"])],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250 mx.example
        \\C: MAIL FROM:<Smith@bar.com>
        \\S: 250 OK
        \\C: RCPT TO:<Jones@foo.com>
        \\S: 250 OK
        \\C: DATA
        \\S: 354 Go ahead
        \\C: Blah blah blah...
        \\C: ....etc. etc. etc.
        \\C: .
        \\*: closed
      ,
      ended: Err(Closed(Body)),
    },
    {
      what: "a server that drops the connection before it gave leave to send",
      client: setup(),
      secure: true,
      acts: [deliver(["Jones"])],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 PIPELINING
        \\C: MAIL FROM:<Smith@bar.com>
        \\C: RCPT TO:<Jones@foo.com>
        \\C: DATA
        \\S: 250 OK
        \\*: closed
      ,
      ended: Err(Closed(Rcpt)),
    },
    {
      what: "a server that offers nothing, where TLS is required",
      client: setup(),
      secure: false,
      acts: [deliver(["Jones"])],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250 mx.example
      ,
      ended: Err(NoTls),
    },
    {
      what: "a server that offers nothing, to a client with a credential to prove",
      client: given(setup(), TimPassword),
      secure: true,
      acts: [deliver(["Jones"])],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250 mx.example
      ,
      ended: Err(NoMechanism),
    },
    {
      what: "a server that rejects EHLO, to a client not asked to fall back",
      client: tls_as(setup(), Plain),
      secure: false,
      acts: [],
      exchange:
        \\S: 220 old.example Sendmail 5.61 ready
        \\C: EHLO client.example
        \\S: 500 Command unrecognized
      ,
      ended: Err(Unexpected(Hello, reply_of(500, ["Command unrecognized"]))),
    },
    {
      what: "a server that does not take mail",
      client: setup(),
      secure: true,
      acts: [],
      exchange:
        \\S: 554 No SMTP service here
      ,
      ended: Err(Unexpected(Greeting, reply_of(554, ["No SMTP service here"]))),
    },
    {
      what: "a server that says more than it was asked",
      client: setup(),
      secure: true,
      acts: [],
      exchange:
        \\S: 220 mx.example ESMTP
        \\S: 250 and something no one asked for
      ,
      ended: Err(Unsolicited),
    },
    {
      what: "a server that offers STARTTLS and then rejects it, where TLS is required",
      client: setup(),
      secure: false,
      acts: [],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 STARTTLS
        \\C: STARTTLS
        \\S: 454 4.7.0 TLS not available due to temporary reason
      ,
      ended: Err(
        Unexpected(StartTls, reply_of(454, ["4.7.0 TLS not available due to temporary reason"])),
      ),
    },
    {
      what: "the same server fails to start TLS, and the client uses TLS only when the server offers it",
      client: tls_as(setup(), Opportunistic),
      secure: false,
      acts: [Bye],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 STARTTLS
        \\C: STARTTLS
        \\S: 454 4.7.0 TLS not available due to temporary reason
        \\C: QUIT
        \\*: closed
      ,
      ended: Ok([]),
    },
    {
      what: "a client asked for no TLS does not ask the server for it",
      client: tls_as(setup(), Plain),
      secure: false,
      acts: [Bye],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 STARTTLS
        \\C: QUIT
        \\S: 221 Bye
      ,
      ended: Ok([]),
    },
    {
      what: "a password is not sent in the clear",
      client: given(tls_as(setup(), Opportunistic), TimPassword),
      secure: false,
      acts: [],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 AUTH LOGIN PLAIN
      ,
      ended: Err(InClear(sasl::Plain)),
    },
    {
      what: "unless the caller explicitly allows sending the password without encryption",
      client: clear_password(given(tls_as(setup(), Plain), TimPassword)),
      secure: false,
      acts: [],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 AUTH LOGIN PLAIN
        \\C: AUTH PLAIN ****
        \\S: 235 2.7.0 Authentication successful
      ,
      ended: Ok([]),
    },
    {
      what: "SCRAM-SHA-256 as RFC 7677 defines it: the client proves it knows the password without sending it, and checks the server's proof",
      client: given(tls_as(setup(), Opportunistic), Pencil),
      secure: false,
      acts: [],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 AUTH PLAIN SCRAM-SHA-256
        \\C: AUTH SCRAM-SHA-256 ****
        \\S: 334 cj1yT3ByTkdmd0ViZVJXZ2JORWtxTyVodllEcFdVYTJSYVRDQWZ1eEZJbGopaE5sRiRrMCxzPVcyMlphSjBTTlk3c29Fc1VFamI2Z1E9PSxpPTQwOTY=
        \\C: ****
        \\S: 334 dj02cnJpVFJCaTIzV3BSUi93dHVwK21NaFVaVW4vZEI1bkxUSlJzamw5NUc0PQ==
        \\C: ****
        \\S: 235 2.7.0 Authentication successful
      ,
      ended: Ok([]),
    },
    {
      what: "a SCRAM server that says welcome before it has proved it knows the password",
      client: given(setup(), Pencil),
      secure: true,
      acts: [],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 AUTH SCRAM-SHA-256
        \\C: AUTH SCRAM-SHA-256 ****
        \\S: 334 cj1yT3ByTkdmd0ViZVJXZ2JORWtxTyVodllEcFdVYTJSYVRDQWZ1eEZJbGopaE5sRiRrMCxzPVcyMlphSjBTTlk3c29Fc1VFamI2Z1E9PSxpPTQwOTY=
        \\C: ****
        \\S: 235 2.7.0 Authentication successful
      ,
      ended: Err(BadAuth(sasl::BadServerProof)),
    },
    {
      what: "a SCRAM server whose proof is not the password's",
      client: given(setup(), Pencil),
      secure: true,
      acts: [],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 AUTH SCRAM-SHA-256
        \\C: AUTH SCRAM-SHA-256 ****
        \\S: 334 cj1yT3ByTkdmd0ViZVJXZ2JORWtxTyVodllEcFdVYTJSYVRDQWZ1eEZJbGopaE5sRiRrMCxzPVcyMlphSjBTTlk3c29Fc1VFamI2Z1E9PSxpPTQwOTY=
        \\C: ****
        \\S: 334 dj1BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBPQ==
      ,
      ended: Err(BadAuth(sasl::BadServerProof)),
    },
    {
      what: "LOGIN is the only mechanism requested, and the server rejects the credential",
      client: mechs(given(setup(), TimPassword), [sasl::Login]),
      secure: true,
      acts: [],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 AUTH PLAIN LOGIN
        \\C: AUTH LOGIN
        \\S: 334 VXNlcm5hbWU6
        \\C: ****
        \\S: 334 UGFzc3dvcmQ6
        \\C: ****
        \\S: 535 5.7.8 Authentication credentials invalid
      ,
      ended: Err(Denied(reply_of(535, ["5.7.8 Authentication credentials invalid"]))),
    },
    {
      what: "RFC 7628: the server sends an error message for a bad token, the client replies with one byte, and the server then rejects the token",
      client: given(setup(), Bearer("ya29.token")),
      secure: true,
      acts: [],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 AUTH XOAUTH2 OAUTHBEARER
        \\C: AUTH OAUTHBEARER ****
        \\S: 334 eyJzdGF0dXMiOiJpbnZhbGlkX3Rva2VuIiwic2NvcGUiOiJtYWlsIn0=
        \\C: ****
        \\S: 535 5.7.8 Authentication failed
      ,
      ended: Err(Denied(reply_of(535, ["5.7.8 Authentication failed"]))),
    },
    {
      what: "a token too long for the command's line is sent on a line of its own, once the server asks",
      client: given(setup(), Bearer("ya29." ++ "x".repeat(600))),
      secure: true,
      acts: [Bye],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 AUTH XOAUTH2
        \\C: AUTH XOAUTH2
        \\S: 334
        \\C: ****
        \\S: 235 2.7.0 Accepted
        \\C: QUIT
        \\S: 221 2.0.0 closing connection
      ,
      ended: Ok([]),
    },
    {
      what: "a challenge that is no base64",
      client: mechs(given(setup(), TimPassword), [sasl::Login]),
      secure: true,
      acts: [],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 AUTH LOGIN
        \\C: AUTH LOGIN
        \\S: 334 Username:
      ,
      ended: Err(BadAuth(sasl::BadChallenge)),
    },
    {
      what: "the server replies to a command with a status code that is not valid for that command",
      client: setup(),
      secure: true,
      acts: [deliver(["Jones"])],
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250 mx.example
        \\C: MAIL FROM:<Smith@bar.com>
        \\S: 354 Go ahead
      ,
      ended: Err(Unexpected(Mail, reply_of(354, ["Go ahead"]))),
    },
  ]

test "replaying a recorded failing SMTP exchange sends the recorded bytes and ends with the expected error: {r.what}" for r: RecordingCase in failings(
  ) {
  let got = replayed(configured(r.client), r.secure, r.acts, r.exchange);
  assert_eq(got.exchange, r.exchange);
  assert_eq(got.ended, r.ended)
}

fn split_server_reads(beats: List<ServerEvent>, size: Int) -> List<ServerEvent> / {abort.raise} =
  beats.flat_map(|b: ServerEvent|
    match b {
      ServerSends(chunk) ->
        range(0, (chunk.len() + size - 1) / size).map(|i: Int|
          ServerSends(chunk.slice(i * size, min(chunk.len(), (i + 1) * size)))),
      other -> [other],
    })

test "the client sends the same bytes and ends in the same state however the server's bytes are split across reads" {
  let cases = sendings().concat(failings()).filter(|r: RecordingCase| r.ended != Err(Unsolicited));
  let differing = cases.flat_map(|r: RecordingCase| {
    let whole = replayed(configured(r.client), r.secure, r.acts, r.exchange);
    [1, 2, 3, 5, 7, 64].filter(|size: Int| {
      let cut = played(
        configured(r.client),
        r.secure,
        r.acts,
        split_server_reads(beats_of(r.exchange), size),
      );
      cut.wire != whole.wire || cut.sealed != whole.sealed || cut.ended != whole.ended
    }).map(|size: Int| r.what ++ ", in reads of " ++ size.to_string())
  });
  assert_eq(differing, [])
}

type AuthCase = {
  what: String,
  client: Setup,
  secure: Bool,
  exchange: String,
  hidden: List<String>,
  sent: List<String>,
  sent_secret: List<Bytes>,
}

fn long_bearer_line() -> Bytes / {abort.raise} =
  Bytes::of_string(
    base64_encode(
        Bytes::of_string("user=tim\u{1}auth=Bearer ya29." ++ "x".repeat(600) ++ "\u{1}\u{1}"),
      )
      ++ "\r\n",
  )

fn provings() -> List<AuthCase> / {abort.raise} =
  [
    {
      what: "PLAIN: RFC 4616's message, in base64",
      client: given(setup(), TimPassword),
      secure: true,
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 AUTH LOGIN PLAIN
        \\C: AUTH PLAIN ****
        \\S: 535 5.7.8 Authentication credentials invalid
      ,
      hidden: ["tanstaaf", "AHRpbQB0YW5zdGFhZnRhbnN0YWFm", "dGFuc3RhYWZ0YW5zdGFhZg"],
      sent: ["EHLO client.example\r\n"],
      sent_secret: [b"AUTH PLAIN AHRpbQB0YW5zdGFhZnRhbnN0YWFm\r\n"],
    },
    {
      what: "LOGIN: the name and then the password",
      client: mechs(given(setup(), TimPassword), [sasl::Login]),
      secure: true,
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 AUTH LOGIN PLAIN
        \\C: AUTH LOGIN
        \\S: 334 VXNlcm5hbWU6
        \\C: ****
        \\S: 334 UGFzc3dvcmQ6
        \\C: ****
        \\S: 235 2.7.0 Accepted
      ,
      hidden: ["tanstaaf", "dGFuc3RhYWZ0YW5zdGFhZg"],
      sent: ["EHLO client.example\r\nAUTH LOGIN\r\n"],
      sent_secret: [b"dGlt\r\n", b"dGFuc3RhYWZ0YW5zdGFhZg==\r\n"],
    },
    {
      what: "SCRAM-SHA-256: RFC 7677's messages, and an empty line once the server has proved itself",
      client: given(setup(), Pencil),
      secure: true,
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 AUTH PLAIN SCRAM-SHA-256
        \\C: AUTH SCRAM-SHA-256 ****
        \\S: 334 cj1yT3ByTkdmd0ViZVJXZ2JORWtxTyVodllEcFdVYTJSYVRDQWZ1eEZJbGopaE5sRiRrMCxzPVcyMlphSjBTTlk3c29Fc1VFamI2Z1E9PSxpPTQwOTY=
        \\C: ****
        \\S: 334 dj02cnJpVFJCaTIzV3BSUi93dHVwK21NaFVaVW4vZEI1bkxUSlJzamw5NUc0PQ==
        \\C: ****
        \\S: 235 2.7.0 Accepted
      ,
      hidden: ["pencil", "dHzbZapWIk4jUhN", "Yz1iaXdzLHI9ck9wck5HZndFYmVSV2diTkVrcU8laHZZRHBXVWEy"],
      sent: ["EHLO client.example\r\n"],
      sent_secret: [
        b"AUTH SCRAM-SHA-256 biwsbj11c2VyLHI9ck9wck5HZndFYmVSV2diTkVrcU8=\r\n",
        b"Yz1iaXdzLHI9ck9wck5HZndFYmVSV2diTkVrcU8laHZZRHBXVWEyUmFUQ0FmdXhGSWxqKWhObEYkazAscD1kSHpiWmFwV0lrNGpVaE4rVXRlOXl0YWc5empmTUhnc3FtbWl6N0FuZFZRPQ==\r\n",
        b"\r\n",
      ],
    },
    {
      what: "OAUTHBEARER as RFC 7628 defines it: the client sends one byte after the server rejects the token",
      client: given(setup(), Bearer("ya29.token")),
      secure: true,
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 AUTH XOAUTH2 OAUTHBEARER
        \\C: AUTH OAUTHBEARER ****
        \\S: 334 eyJzdGF0dXMiOiJpbnZhbGlkX3Rva2VuIiwic2NvcGUiOiJtYWlsIn0=
        \\C: ****
        \\S: 535 5.7.8 Authentication failed
      ,
      hidden: [
        "ya29",
        "bixhPXRpbSwBaG9zdD1teC5leGFtcGxlAXBvcnQ9NTg3AWF1dGg9QmVhcmVyIHlhMjkudG9rZW4BAQ",
      ],
      sent: ["EHLO client.example\r\n"],
      sent_secret: [
        b"AUTH OAUTHBEARER bixhPXRpbSwBaG9zdD1teC5leGFtcGxlAXBvcnQ9NTg3AWF1dGg9QmVhcmVyIHlhMjkudG9rZW4BAQ==\r\n",
        b"AQ==\r\n",
      ],
    },
    {
      what: "XOAUTH2 is sent as a separate line when the string is too long for the AUTH command line",
      client: given(setup(), Bearer("ya29." ++ "x".repeat(600))),
      secure: true,
      exchange:
        \\S: 220 mx.example ESMTP
        \\C: EHLO client.example
        \\S: 250-mx.example
        \\S: 250 AUTH XOAUTH2
        \\C: AUTH XOAUTH2
        \\S: 334
        \\C: ****
        \\S: 235 2.7.0 Accepted
      ,
      hidden: ["ya29", "xxxxxxxx", "dXNlcj10aW0BYXV0aD1CZWFyZXIgeWEyOS54"],
      sent: ["EHLO client.example\r\nAUTH XOAUTH2\r\n"],
      sent_secret: [long_bearer_line()],
    },
  ]

test "a credential is sent to the server in a `Secret`, and does not appear in errors, displayed values, the session's recorded lines or plain bytes, under {p.what}" for p: AuthCase in provings(
  ) {
  let got = replayed(configured(p.client), p.secure, [], p.exchange);
  let wire = String::of_bytes_lossy(got.wire);
  assert_eq(got.exchange, p.exchange);
  assert(p.sent.all(|part: String| wire.contains(part)));
  assert(got.sealed == p.sent_secret.map(Secret::of_bytes));
  assert(
    p.hidden.all(|part: String|
      !wire.contains(part) && !got.exchange.contains(part) && !got.shown.contains(part)
        && !show(got.ended).contains(part)
        && !show(got.engine).contains(part)
        && !show(configured(p.client)).contains(part)),
  )
}

test "displaying a session that uses a credential shows `****` in place of the credential" {
  let got = replayed(
    with_credential(client(), tim_password()),
    true,
    [],
    \\S: 220 mx.example ESMTP
    \\C: EHLO client.example
    \\S: 250-mx.example
    \\S: 250 AUTH PLAIN
  );
  assert(got.shown.contains("out: ****"));
  assert(got.shown.contains("Client(\"AUTH PLAIN ****\")"));
  assert(got.shown.contains("credential: Some(password(\"tim\", ****))"));
  assert(got.shown.contains("out: b\"EHLO client.example\\r\\n\""))
}

fn ehlo_reply(lines: List<String>) -> Bytes = render_reply({ code: Code(250), lines: lines })

test "after STARTTLS the client discards the capabilities listed before TLS and uses only those in the next EHLO reply" {
  gen::check2(replies(), replies(), |before: Reply, after: Reply| {
    match try[smtp.fail] { config("client.example", default_limits()) } {
      Err(_) -> false,
      Ok(plain_client) -> {
        let dsn_request = played(plain_client, false, [], [
          ServerSends(b"220 mx.example ESMTP\r\n"),
          ServerSends(ehlo_reply(before.lines.push("STARTTLS"))),
          ServerSends(b"220 Go ahead\r\n"),
        ]);
        let got = played(plain_client, false, [], [
          ServerSends(b"220 mx.example ESMTP\r\n"),
          ServerSends(ehlo_reply(before.lines.push("STARTTLS"))),
          ServerSends(b"220 Go ahead\r\n"),
          TlsStarts,
          ServerSends(ehlo_reply(after.lines)),
        ]);
        dsn_request.ended == Err(HandshakeFailed(net::Reset)) && !secured(dsn_request.engine)
          && offered(dsn_request.engine)
          == Some(capabilities({ code: Code(250), lines: before.lines.push("STARTTLS") }))
          && got.ended == Ok([])
          && secured(got.engine)
          && offered(got.engine) == Some(capabilities({ code: Code(250), lines: after.lines }))
      },
    }
  })
}

type Script = | Script(List<Bytes>)

fn openings() -> List<List<Bytes>> = {
  let greeting = b"220 mx.example ESMTP\r\n";
  let offer = b"250-mx.example\r\n250-PIPELINING\r\n250-STARTTLS\r\n250 AUTH PLAIN LOGIN SCRAM-SHA-256\r\n";
  let bare_offer = b"250-mx.example\r\n250-SIZE 100\r\n250 AUTH LOGIN\r\n";
  let challenge = b"334 cj1yT3ByTkdmd0ViZVJXZ2JORWtxT3NlcnZlcixzPVcyMlphSjBTTlk3c29Fc1VFamI2Z1E9PSxpPTI=\r\n";
  [
    [],
    [greeting],
    [greeting, offer],
    [greeting, offer, b"220 Go ahead\r\n", offer],
    [greeting, offer, b"220 Go ahead\r\n", offer, b"235 Accepted\r\n"],
    [
      greeting,
      offer,
      b"220 Go ahead\r\n",
      bare_offer,
      b"334 VXNlcm5hbWU6\r\n",
      b"334 UGFzc3dvcmQ6\r\n",
    ],
    [greeting, offer, b"235 Accepted\r\n"],
    [greeting, offer, challenge],
    [greeting, offer, challenge, b"334 dj1BQUFB\r\n"],
    [greeting, bare_offer],
    [greeting, bare_offer, b"250 OK\r\n", b"250 OK\r\n", b"354 Go ahead\r\n"],
    [greeting, bare_offer, b"334 VXNlcm5hbWU6\r\n", b"334 UGFzc3dvcmQ6\r\n", b"235 Accepted\r\n"],
    [greeting, b"250-mx.example\r\n250 AUTH PLAIN\r\n", b"235 Accepted\r\n"],
    [greeting, b"500 What?\r\n", b"250 mx.example\r\n"],
  ]
}

fn scripts() -> Gen<Script> =
  gen::map2(
    gen::elements(openings()),
    gen::list_of(
      gen::one_of([
        gen::map(replies(), render_reply),
        gen::elements([
          b"250 OK\r\n",
          b"250 OK\r\n",
          b"250 OK\r\n250 OK\r\n",
          b"250 OK\r\n250 OK\r\n354 Go ahead\r\n",
          b"354 Go ahead\r\n",
          b"235 Accepted\r\n",
          b"334\r\n",
          b"220 Go ahead\r\n",
          b"421 Closing\r\n",
          b"550 No\r\n",
          b"451 Later\r\n",
          b"221 Bye\r\n",
          b"250-half a reply\r\n",
          b"250 no line end",
        ]),
        gen::and_then(gen::int_between(0, 12), |n: Int| gen::bytes_of(n)),
      ]),
      14,
    ),
    |opened: List<Bytes>, chunks: List<Bytes>| Script(opened.concat(chunks)),
  )

fn whole_lines(sent: Bytes) -> Bool / {abort.raise} =
  sent.len() == 0
    || (sent.peek(sent.len() - 1) == b'\n'
    && email::line_flaws(sent).all(|f: email::Error| f.reason == email::LongLine))

fn run_engine(
  t: Turn,
  chunks: List<Bytes>,
  envelope: Envelope,
  wrote: Bytes,
  left: Int,
) -> Option<Bytes> / {abort.raise} = {
  let fine = buffered_size(t.engine) <= config_of(t.engine).limits.reply
    && read_limit(t.engine) >= 1
    && whole_lines(starred_bytes(t.out));
  let so_far = wrote.concat(starred_bytes(t.out));
  let fed = match t.next { Await(_) -> true, _ -> false };
  let next_turn = match t.next {
    Over -> None,
    Secure -> Some(try[smtp.fail] { tls_started(t.engine) }),
    Ready ->
      Some(if left % 5 == 0 { try[smtp.fail] { leave(t.engine) } }
      else { try[smtp.fail] { mail(t.engine, envelope, test_message()) } }),
    Await(_) -> match chunks.first() {
      Some(chunk) -> Some(try[smtp.fail] { feed(t.engine, chunk) }),
      None -> None,
    },
  };
  if !fine { None } else {
    match next_turn {
      Some(Ok(turned)) -> if left <= 0 { Some(so_far) } else {
        run_engine(turned, if fed { chunks.drop(1) } else { chunks }, envelope, so_far, left - 1)
      },
      _ -> Some(so_far),
    }
  }
}

fn driven_as(chunks: List<Bytes>, envelope: Envelope, secure: Bool, shape: Int) -> Option<Bytes> = {
  let limits: Limits = { line: 80, reply: 120, scram_iterations: 4, transcript: 0 };
  let kind = (shape % 24 + 24) % 24;
  let policy = if kind % 3 == 0 { RequireTls }
  else if kind % 3 == 1 { Opportunistic }
  else { Plain };
  match try[abort.raise] {
      match try[smtp.fail] { config("client.example", limits) } {
        Err(_) -> None,
        Ok(bare) -> match try[sasl.fail] { sasl::password("user", Secret::of_bytes(b"pencil")) } {
          Err(_) -> None,
          Ok(credential) -> {
            let c = with_exposure(
              with_tls(
                if kind % 2 == 0 { bare } else { with_credential(bare, credential) },
                policy,
              ),
              if kind % 4 < 2 { Protected } else { PasswordInClear },
            );
            run_engine(start(c, link(secure)), chunks, envelope, b"", 40)
          },
        },
      }
    } {
    Ok(wrote) -> wrote,
    Err(_) -> None,
  }
}

fn server_greeting() -> List<Bytes> =
  [b"220 mx.example ESMTP\r\n", b"250-mx.example\r\n250-PIPELINING\r\n250 SMTPUTF8\r\n"]

test "for any bytes a server sends, the client either succeeds or fails with an SMTP error, and never panics or loops" {
  gen::check3(
    scripts(),
    email::envelopes(),
    gen::any_int(),
    |s: Script, envelope: Envelope, shape: Int| {
      match s {
        Script(chunks) ->
          driven_as(chunks, envelope, true, shape) != None
            && driven_as(chunks, envelope, false, shape) != None
            && driven_as(server_greeting().concat(chunks), envelope, true, shape) != None,
      }
    },
  )
}

fn serving(port: Int, scripts: List<List<net::Step>>) -> net::MemNet / {abort.raise} =
  net::mem_serving(
    net::mem_resolving(
      net::mem_empty(),
      dns::with_name(dns::table(), "mx.example", [ip::loopback_v4()]),
    ),
    ip::socket_at(ip::loopback_v4(), port),
    scripts,
  )

fn script_of(beats: List<ServerEvent>) -> List<net::Step> =
  beats.map(|b: ServerEvent|
    match b {
      ServerSends(chunk) -> net::Sends(chunk),
      TlsStarts -> net::Upgrades,
      ServerCloses -> net::Leaves,
    })

fn implicit(exchange: String) -> List<net::Step> / {abort.raise} =
  list::prepend(net::Upgrades, script_of(beats_of(exchange)))

fn scripted(exchange: String) -> List<net::Step> / {abort.raise} = {
  let grouped = exchange.split("\n").fold(
    { steps: [], mark: "", run: [] },
    |g: Grouped, line: String| {
      let mark = line.slice(0, min(2, line.len()));
      if line == "*: TLS" { { steps: flushed_steps(g).push(net::Upgrades), mark: "", run: [] } }
      else if line == "*: closed" {
        { steps: flushed_steps(g).push(net::Leaves), mark: "", run: [] }
      } else if mark == g.mark { { ..g, run: g.run.push(line) } }
      else { { steps: flushed_steps(g), mark: mark, run: [line] } }
    },
  );
  flushed_steps(grouped)
}

type Grouped = { steps: List<net::Step>, mark: String, run: List<String> }

fn flushed_steps(g: Grouped) -> List<net::Step> / {abort.raise} =
  if g.run == [] { g.steps } else {
    let reply_of = Bytes::of_string(
      String::join(g.run.map(|line: String| line.slice(min(3, line.len()), line.len())), "\r\n")
        ++ "\r\n",
    );
    g.steps.push(if g.mark == "S:" { net::Sends(reply_of) } else { net::Expects(reply_of) })
  }

fn on_mx<a>(
  world: net::MemNet,
  go: () -> a / {net.write[mail], clock.read, clock.write, task::deadline.at, entropy.next, time.now_ms, smtp.fail, abort.raise},
) -> net::RunResult<Result<a, Error>> / {sim.read, abort.raise} =
  net::on_mem(world, ||
    simulate {
      task::unbounded(||
        handle {
          try[smtp.fail] { go() }
        } with {
          entropy.next() -> 7,
          time.now_ms() -> 880127706123,
        })
    })

fn submission() -> String =
  \\S: 220 mx.example ESMTP
  \\C: EHLO client.example
  \\S: 250-mx.example
  \\S: 250-PIPELINING
  \\S: 250-SIZE 10240000
  \\S: 250 AUTH PLAIN LOGIN
  \\C: AUTH PLAIN ****
  \\S: 235 2.7.0 Authentication successful
  \\C: MAIL FROM:<Smith@bar.com> SIZE=38
  \\C: RCPT TO:<Jones@foo.com>
  \\C: RCPT TO:<Green@foo.com>
  \\C: DATA
  \\S: 250 2.1.0 Ok
  \\S: 250 2.1.5 Ok
  \\S: 550 5.1.1 No such user
  \\S: 354 End data with <CR><LF>.<CR><LF>
  \\C: Blah blah blah...
  \\C: ....etc. etc. etc.
  \\C: .
  \\S: 250 2.0.0 Ok: queued as 4F2A91
  \\C: QUIT
  \\S: 221 2.0.0 Bye

test "a session that starts with TLS checks the server's host name, sends the same bytes as the engine replay, uses the configured timeouts, and closes the connection once" {
  let c = with_credential(client(), tim_password());
  let envelope = email::envelope_of(ReturnTo(test_sender()), test_recipients(["Jones", "Green"]));
  let ran = on_mx(serving(465, [implicit(submission())]), || {
    let s = open_tls[mail]("mx.example", 465, c);
    let sent = submit[mail](s, envelope, test_message());
    quit[mail](sent.session);
    sent.deliveries.map(delivery_summary)
  });
  assert_eq(ran.value, Ok(["Jones@foo.com accepted 250", "Green@foo.com permanent RCPT 550"]));
  let engine = replayed(c, true, [deliver(["Jones", "Green"]), Bye], submission());
  assert_eq(net::mem_sent(ran.net, 1), engine.wire);
  assert(net::mem_sent_secrets(ran.net, 1) == engine.sealed);
  assert_eq(net::mem_secured(ran.net, 1), Some("mx.example"));
  assert_eq(net::mem_deadlines(ran.net, 1), [300000, 300000, 300000, 300000, 600000, 30000]);
  assert_eq(net::mem_remaining_script(ran.net, 1), []);
  assert_eq(ran.net.closed, [1])
}

test "a session sends the full password in its `AUTH` line, and the transcript shows `AUTH PLAIN ****` without the encoded password" {
  let script = [
    net::Upgrades,
    net::Sends(b"220 mx.example ESMTP\r\n"),
    net::Expects(b"EHLO client.example\r\n"),
    net::Sends(b"250-mx.example\r\n250 AUTH PLAIN\r\n"),
    net::ExpectsSecret(b"AUTH PLAIN AHRpbQB0YW5zdGFhZnRhbnN0YWFm\r\n"),
    net::Sends(b"235 2.7.0 Accepted\r\n"),
    net::Expects(b"QUIT\r\n"),
    net::Sends(b"221 2.0.0 Bye\r\n"),
  ];
  let c = with_credential(
    config("client.example", { ..default_limits(), transcript: 40 }),
    tim_password(),
  );
  let ran = on_mx(serving(465, [script]), || {
    let s = open_tls[mail]("mx.example", 465, c);
    let handle_auth_reply = authenticated(s.engine);
    let text = transcript_text(transcript(s));
    quit[mail](s);
    { proved: handle_auth_reply, text: text }
  });
  match ran.value {
    Ok(v) -> {
      assert(v.proved);
      assert(v.text.contains("C: AUTH PLAIN ****"));
      assert(!v.text.contains("AHRp"))
    },
    Err(reason) -> panic("the session was rejected: " ++ show(reason)),
  };
  let plain = String::of_bytes_lossy(net::mem_sent(ran.net, 1));
  assert_eq(plain, "EHLO client.example\r\nQUIT\r\n");
  assert_eq(net::mem_remaining_script(ran.net, 1), [])
}

test "with STARTTLS, only EHLO and STARTTLS are sent unencrypted, and the credential is sent only after the connection is upgraded to TLS" {
  let r = sendings().get(1);
  let jones = email::envelope_of(ReturnTo(test_sender()), test_recipients(["Jones", "Green"]));
  let brown = email::envelope_of(ReturnTo(test_sender()), test_recipients(["Brown"]));
  let in_clear = [
    net::Sends(b"220 mx.example ESMTP\r\n"),
    net::Expects(b"EHLO client.example\r\n"),
    net::Sends(b"250-mx.example\r\n250-PIPELINING\r\n250-AUTH PLAIN LOGIN\r\n250 STARTTLS\r\n"),
    net::Expects(b"STARTTLS\r\n"),
    net::Sends(b"220 2.0.0 Ready to start TLS\r\n"),
    net::Upgrades,
  ];
  let script = in_clear.concat(script_of(beats_of(r.exchange)).drop(4));
  let ran = on_mx(serving(587, [script]), || {
    let s = open[mail]("mx.example", 587, configured(r.client));
    let first_sent = submit[mail](s, jones, test_message());
    let second_sent = submit[mail](first_sent.session, brown, test_message());
    quit[mail](second_sent.session);
    first_sent.deliveries.concat(second_sent.deliveries).map(delivery_summary)
  });
  assert_eq(ran.value, r.ended);
  assert_eq(
    net::mem_sent(ran.net, 1),
    replayed(configured(r.client), false, r.acts, r.exchange).wire,
  );
  assert_eq(net::mem_secured(ran.net, 1), Some("mx.example"));
  assert_eq(net::mem_remaining_script(ran.net, 1), []);
  assert_eq(ran.net.closed, [1])
}

fn run_acts<[l]>(
  s: Session,
  acts: List<Act>,
) -> List<String> / {net.send[l], net.send_secret[l], net.recv[l], net.close[l], clock.read, task::deadline.at, smtp.fail, abort.raise} =
  acts.fold(
    { session: s, outcomes: [] },
    |done: { session: Session, outcomes: List<String> }, act: Act|
      if state(done.session.engine).over { done } else {
        match act {
          Bye -> {
            quit[l](done.session);
            done
          },
          Deliver(envelope, data, dsn_request) -> match try[smtp.fail] {
              submit[l](done.session, envelope, data, dsn_request)
            } {
            Ok(sent) ->
              {
                session: sent.session,
                outcomes: done.outcomes.concat(sent.deliveries.map(delivery_summary)),
              },
            Err(reason) -> if usable(reason) {
              { ..done, outcomes: done.outcomes.push("rejected: " ++ show(reason)) }
            } else { smtp.fail(reason) },
          },
        }
      },
  ).outcomes

test "each recorded exchange without a credential, played to a server that checks every client line, ends with the same result and sends the same bytes as the engine replay" {
  let cases = sendings().concat(failings()).filter(|r: RecordingCase| !r.exchange.contains("****"));
  let differing = cases.filter(|r: RecordingCase| {
    let port = if r.secure { 465 } else { 587 };
    let script = if r.secure { list::prepend(net::Upgrades, scripted(r.exchange)) }
    else { scripted(r.exchange) };
    let c = configured(r.client);
    let ran = on_mx(serving(port, [script]), ||
      run_acts[mail](
        if r.secure { open_tls[mail]("mx.example", port, c) }
        else { open[mail]("mx.example", port, c) },
        r.acts,
      ));
    ran.value != r.ended
      || net::mem_sent(ran.net, 1) != replayed(c, r.secure, r.acts, r.exchange).wire
  });
  assert_eq(differing.map(|r: RecordingCase| r.what), [])
}

test "plaintext waiting at the upgrade is rejected before TLS, whether the client read it or it is still on the socket" {
  let offered = [
    net::Sends(b"220 mx.example ESMTP\r\n"),
    net::Sends(b"250-mx.example\r\n250 STARTTLS\r\n"),
  ];
  let read_with = on_mx(
    serving(587, [
      offered.concat([
        net::Sends(b"220 2.0.0 Go ahead\r\n250-mx.example\r\n250 AUTH PLAIN\r\n"),
        net::Upgrades,
      ]),
    ]),
    || secured(open[mail]("mx.example", 587, client()).engine),
  );
  let held_back = on_mx(
    serving(587, [
      offered.concat([
        net::Sends(b"220 2.0.0 Go ahead\r\n"),
        net::Sends(b"250-mx.example\r\n250 AUTH PLAIN\r\n"),
        net::Upgrades,
      ]),
    ]),
    || secured(open[mail]("mx.example", 587, client()).engine),
  );
  assert_eq([read_with.value, held_back.value], [Err(Injected), Err(Injected)]);
  assert(
    [read_with.net, held_back.net].all(|n: net::MemNet|
      net::mem_sent(n, 1) == b"EHLO client.example\r\nSTARTTLS\r\n"
        && net::mem_secured(n, 1) == None
        && n.closed == [1]),
  )
}

test "a STARTTLS connection fails and closes when the server cannot be verified, and with TLS set to plain the client never starts TLS" {
  let offer = [
    net::Sends(b"220 mx.example ESMTP\r\n"),
    net::Sends(b"250-mx.example\r\n250 STARTTLS\r\n"),
    net::Sends(b"220 2.0.0 Ready to start TLS\r\n"),
  ];
  let untrusted = on_mx(serving(587, [offer.push(net::Rejects(net::Untrusted))]), ||
    secured(open[mail]("mx.example", 587, client()).engine));
  assert_eq(untrusted.value, Err(HandshakeFailed(net::Untrusted)));
  assert_eq(untrusted.net.closed, [1]);
  let plain = on_mx(
    serving(25, [
      [
        net::Sends(b"220 mx.example ESMTP\r\n"),
        net::Sends(b"250-mx.example\r\n250 STARTTLS\r\n"),
        net::Sends(b"221 Bye\r\n"),
      ],
    ]),
    || {
      let s = open[mail]("mx.example", 25, with_tls(client(), Plain));
      quit[mail](s);
      secured(s.engine)
    },
  );
  assert_eq(plain.value, Ok(false));
  assert_eq(net::mem_sent(plain.net, 1), b"EHLO client.example\r\nQUIT\r\n");
  assert_eq(net::mem_secured(plain.net, 1), None);
  assert_eq(plain.net.closed, [1])
}

test "opening a session fails when the server is unreachable, fails verification as the named host, or hangs up immediately" {
  let open_one = || secured(open_tls[mail]("mx.example", 465, client()).engine);
  let gone = on_mx(serving(25, []), open_one);
  assert_eq(gone.value, Err(Unreachable));
  assert_eq(gone.net.closed, []);
  let untrusted = on_mx(serving(465, [[net::Rejects(net::Untrusted)]]), open_one);
  assert_eq(untrusted.value, Err(HandshakeFailed(net::Untrusted)));
  assert_eq(untrusted.net.closed, [1]);
  let hung = on_mx(serving(465, [[net::Upgrades, net::Leaves]]), open_one);
  assert_eq(hung.value, Err(Closed(Greeting)));
  assert_eq(hung.net.closed, [1])
}

fn slowly<a>(
  ms: Int,
  go: () -> a / {net.write[mail], clock.read, task::deadline.at, entropy.next, time.now_ms, smtp.fail, abort.raise},
) -> a / {net.write[mail], clock.read, clock.write, task::deadline.at, entropy.next, time.now_ms, smtp.fail, abort.raise} =
  handle {
    go()
  } with {
    net.recv[mail](c, most, t) -> {
      clock.sleep(millis(ms));
      net.recv[mail](c, most, t)
    },
  }

test "a wait is one deadline, and each read gets what is left of it, however the reply trickles in" {
  let silent = on_mx(serving(465, [[net::Upgrades, net::Silent]]), ||
    secured(open_tls[mail]("mx.example", 465, client()).engine));
  assert_eq(silent.value, Err(TimedOut(Greeting)));
  assert_eq(net::mem_deadlines(silent.net, 1), [300000]);
  assert_eq(silent.net.closed, [1]);
  let trickling = [
    net::Upgrades,
    net::Sends(b"220 mx.example ESMTP\r\n"),
    net::Sends(b"250-mx.exa"),
    net::Sends(b"mple\r\n"),
    net::Sends(b"250-PIPE"),
    net::Sends(b"LINING\r\n250 HELP\r\n"),
  ];
  let within = |ms: Int| {
    let waits: Timeouts = { ..default_timeouts(), other_ms: ms };
    on_mx(serving(465, [trickling]), ||
      slowly(20, ||
        secured(open_tls[mail]("mx.example", 465, with_timeouts(client(), waits)).engine)))
  };
  let short = within(60);
  assert_eq(short.value, Err(TimedOut(Hello)));
  assert_eq(net::mem_deadlines(short.net, 1), [300000, 60, 40, 20]);
  assert_eq(net::mem_remaining_script(short.net, 1), [net::Sends(b"LINING\r\n250 HELP\r\n")]);
  assert_eq(short.net.closed, [1]);
  let long = within(80);
  assert_eq(long.value, Ok(true));
  assert_eq(net::mem_deadlines(long.net, 1), [300000, 80, 60, 40, 20]);
  assert_eq(long.net.closed, [])
}

test "a session applies the surrounding timeout to every wait, so each wait is limited to the time remaining" {
  let ran = net::on_mem(serving(465, [[net::Upgrades, net::Silent]]), ||
    simulate {
      task::unbounded(||
        task::timeout(millis(250), ||
          handle {
            try[smtp.fail] { secured(open_tls[mail]("mx.example", 465, client()).engine) }
          } with {
            entropy.next() -> 7,
          }))
    });
  assert_eq(ran.value, task::Done(Err(TimedOut(Greeting))));
  assert_eq(net::mem_deadlines(ran.net, 1), [250])
}

test "a server that stops accepting bytes is sent nothing more" {
  let ran = on_mx(
    serving(465, [[net::Upgrades, net::Sends(b"220 mx.example ESMTP\r\n"), net::Leaves]]),
    || secured(open_tls[mail]("mx.example", 465, client()).engine),
  );
  assert_eq(ran.value, Err(NotSent(Hello)));
  assert_eq(net::mem_sent(ran.net, 1), b"");
  assert_eq(ran.net.closed, [1])
}

test "a session is sent QUIT when its user is done, and closed however its user ends" {
  let envelope = email::envelope_of(ReturnTo(test_sender()), test_recipients(["Jones", "Green"]));
  let c = with_credential(client(), tim_password());
  let done = on_mx(serving(465, [implicit(submission())]), ||
    with_session_tls[mail]("mx.example", 465, c, |s: Session|
      submit[mail](s, envelope, test_message()).deliveries.len()));
  assert_eq(done.value, Ok(2));
  assert_eq(
    net::mem_sent(done.net, 1),
    replayed(c, true, [deliver(["Jones", "Green"]), Bye], submission()).wire,
  );
  assert_eq(done.net.closed, [1]);
  let dropped = failings().get(1);
  let jones = email::envelope_of(ReturnTo(test_sender()), test_recipients(["Jones"]));
  let cut = on_mx(serving(465, [list::prepend(net::Upgrades, scripted(dropped.exchange))]), ||
    with_session_tls[mail]("mx.example", 465, configured(dropped.client), |s: Session|
      submit[mail](s, jones, test_message()).deliveries.len()));
  assert_eq(cut.value, Err(Closed(Body)));
  assert_eq(
    net::mem_sent(cut.net, 1),
    replayed(configured(dropped.client), true, dropped.acts, dropped.exchange).wire,
  );
  assert_eq(cut.net.closed, [1])
}

fn delivered(sent: Bytes) -> Bytes / {abort.raise} =
  match sent.index_of(b"DATA\r\n") {
    None -> b"",
    Some(from) -> match sent.index_of_from(b"\r\n.\r\n", from) {
      None -> b"",
      Some(to) -> unstuff(sent.slice(from + 6, to + 2)),
    },
  }

fn accepting_server() -> List<net::Step> =
  [
    net::Sends(b"250 OK\r\n"),
    net::Sends(b"250 OK\r\n"),
    net::Sends(b"250 OK\r\n"),
    net::Sends(b"354 Go ahead\r\n"),
    net::Sends(b"250 OK\r\n"),
  ]

fn hello_draft() -> Draft / {time.now_ms, entropy.next, email.fail, abort.raise} =
  email::with_bcc(
    email::with_text(
      email::compose(
        email::named_mailbox("John Doe", email::address("jdoe", "machine.example")),
        [email::mailbox(email::address("mary", "example.net"))],
        "Gr\u{fc}\u{df}e",
      ),
      "Hello.\n.A line that opens with a dot.\n..\n",
    ),
    [email::mailbox_entry(email::mailbox(email::address("eve", "example.org")))],
  )

test "sending a draft delivers it to every recipient including blind copies, and sends the bytes `email::build` writes, which have no `Bcc` header" {
  let d = match handle {
      try[email.fail] { hello_draft() }
    } with {
      entropy.next() -> 7,
      time.now_ms() -> 880127706123,
    } {
    Ok(made) -> made,
    Err(_) -> panic("the draft was rejected"),
  };
  let ran = on_mx(
    serving(465, [
      [
        net::Upgrades,
        net::Sends(b"220 mx.example ESMTP\r\n"),
        net::Sends(b"250-mx.example\r\n250 SMTPUTF8\r\n"),
      ].concat(
        accepting_server(),
      ),
    ]),
    || send[mail](open_tls[mail]("mx.example", 465, client()), d).deliveries.map(delivery_summary),
  );
  let written = match email::build(d, "boundary-7-7") { Ok(data) -> data, Err(_) -> b"" };
  let wire = String::of_bytes_lossy(net::mem_sent(ran.net, 1));
  assert_eq(ran.value, Ok(["mary@example.net accepted 250", "eve@example.org accepted 250"]));
  assert_eq(email::repertoire_for(d), email::Ascii);
  assert(written.len() > 0);
  assert_eq(delivered(net::mem_sent(ran.net, 1)), written);
  assert(
    wire.contains(
      "MAIL FROM:<jdoe@machine.example>\r\nRCPT TO:<mary@example.net>\r\nRCPT TO:<eve@example.org>\r\nDATA\r\n",
    ),
  );
  assert(wire.contains("\r\n..A line that opens with a dot.\r\n...\r\n.\r\n"));
  assert(!wire.contains("Bcc"));
  assert(!String::of_bytes_lossy(written).contains("eve@example.org"))
}

test "`relay` sends a message that was read as its original bytes to every recipient it names, leaving out its Bcc header lines" {
  let data = b"From: John Doe <jdoe@machine.example>\r\nTo: Mary Smith <mary@example.net>\r\nBcc: eve@example.org\r\nSubject: Saying Hello\r\nX-Odd:   kept \t as it was\r\n\r\n.Hello.\r\n";
  let m = email::read_tolerant(data, email::default_limits()).message;
  let greeted = [
    net::Upgrades,
    net::Sends(b"220 mx.example ESMTP\r\n"),
    net::Sends(b"250 mx.example\r\n"),
  ];
  let ran = on_mx(serving(465, [greeted.concat(accepting_server())]), ||
    relay[mail](open_tls[mail]("mx.example", 465, client()), m).deliveries.map(delivery_summary));
  assert_eq(ran.value, Ok(["mary@example.net accepted 250", "eve@example.org accepted 250"]));
  assert_eq(
    delivered(net::mem_sent(ran.net, 1)),
    b"From: John Doe <jdoe@machine.example>\r\nTo: Mary Smith <mary@example.net>\r\nSubject: Saying Hello\r\nX-Odd:   kept \t as it was\r\n\r\n.Hello.\r\n",
  );
  let nameless = email::read_tolerant(
    b"Subject: no one\r\n\r\nHi.\r\n",
    email::default_limits(),
  ).message;
  let rejected = on_mx(serving(465, [greeted]), ||
    relay[mail](open_tls[mail]("mx.example", 465, client()), nameless).deliveries.len());
  assert_eq(rejected.value, Err(Unreadable({ at: 0, reason: email::Missing("from") })));
  assert_eq(net::mem_sent(rejected.net, 1), b"EHLO client.example\r\n")
}

test "a session's transcript contains only the newest lines up to its limit, and never a credential" {
  let envelope = email::envelope_of(ReturnTo(test_sender()), test_recipients(["Jones", "Green"]));
  let transcript_for_limit = |most: Int| {
    let limits: Limits = { ..default_limits(), transcript: most };
    let c = with_credential(config("client.example", limits), tim_password());
    on_mx(serving(465, [implicit(submission())]), || {
      let s = open_tls[mail]("mx.example", 465, c);
      transcript_text(transcript(submit[mail](s, envelope, test_message()).session))
    }).value
  };
  assert_eq(
    transcript_for_limit(100),
    Ok(
      \\S: 220 mx.example ESMTP
      \\C: EHLO client.example
      \\S: 250-mx.example
      \\S: 250-PIPELINING
      \\S: 250-SIZE 10240000
      \\S: 250 AUTH PLAIN LOGIN
      \\C: AUTH PLAIN ****
      \\S: 235 2.7.0 Authentication successful
      \\C: MAIL FROM:<Smith@bar.com> SIZE=38
      \\C: RCPT TO:<Jones@foo.com>
      \\C: RCPT TO:<Green@foo.com>
      \\C: DATA
      \\S: 250 2.1.0 Ok
      \\S: 250 2.1.5 Ok
      \\S: 550 5.1.1 No such user
      \\S: 354 End data with <CR><LF>.<CR><LF>
      \\*: 42 octets of message
      \\S: 250 2.0.0 Ok: queued as 4F2A91
    ),
  );
  assert_eq(
    transcript_for_limit(3),
    Ok(
      \\S: 354 End data with <CR><LF>.<CR><LF>
      \\*: 42 octets of message
      \\S: 250 2.0.0 Ok: queued as 4F2A91
    ),
  );
  assert_eq(transcript_for_limit(0), Ok(""))
}

test "no address and no parameter writes a line of its own: a message's commands are one line each" {
  gen::check3(
    email::envelopes(),
    gen::text(),
    gen::bool(),
    |envelope: Envelope, id: String, original: Bool| {
      match try[smtp.fail] { config("client.example", default_limits()) } {
        Err(_) -> false,
        Ok(c) -> {
          let opened = played(c, true, [], [
            ServerSends(b"220 mx.example ESMTP\r\n"),
            ServerSends(
              b"250-mx.example\r\n250-PIPELINING\r\n250-SMTPUTF8\r\n250-8BITMIME\r\n250 DSN\r\n",
            ),
          ]);
          match try[smtp.fail] {
              mail(opened.engine, envelope, test_message(), {
                return_content: Some(Headers),
                envelope_id: Some(id),
                notify: Some([Failed, Delayed]),
                original: original,
              })
            } {
            Err(reason) -> usable(reason),
            Ok(t) -> {
              let lines = marked("", open_bytes(t.out));
              whole_lines(open_bytes(t.out)) && lines.len() == envelope.recipients.len() + 2
                && list::enumerate(lines).all(|l: { index: Int, value: String }|
                  l.value.starts_with(if l.index == 0 { " MAIL FROM:<" }
                  else if l.index <= envelope.recipients.len() { " RCPT TO:<" }
                  else { " DATA" }))
            },
          }
        },
      }
    },
  )
}
