//! Cookies as RFC 6265bis defines them: the `Cookie` field a request carries, the `Set-Cookie`
//! field a response sends, values signed or encrypted under a key, and the jar where a client
//! stores cookies.
//!
//! `pairs` reads a `Cookie` field leniently, as a server must: it skips each pair it cannot read
//! and still returns the rest of the field. `set_cookie` makes a cookie with the defaults a server
//! should use unless it has a reason not to: `Secure`, `HttpOnly`, `Path=/` and `SameSite=Lax`.
//!
//! `render` writes a cookie as a `Set-Cookie` field. It raises `cookie.fail` for a cookie that a
//! browser would drop or would read back as a different cookie. These are the cases: - a name that
//! is not a token; - a value outside the cookie octets; - a name and value over 4096 bytes, or an
//! attribute over 1024 bytes; - a `Domain` or `Path` that a field cannot carry; - a `__Secure-`
//! cookie without `Secure`; - a `__Host-` cookie with a `Domain`, or with a `Path` other than `/`;
//! - `SameSite=None` or `Partitioned` without `Secure`. The prefixes are matched ignoring case, as
//! a browser matches them.
//!
//! `signed` writes a value that a client can read but cannot change: an HMAC-SHA-256 tag under a
//! key, computed over the cookie's name and value. `sealed` writes a value that a client can
//! neither read nor change: XChaCha20-Poly1305 encryption under a `std.crypto` key, with the name
//! bound in. Both bind the name, so a value set for one cookie is rejected when read as another
//! cookie.
//!
//! A `Jar` is a client's cookies as a value. `store` records the `Set-Cookie` fields of a response
//! from a URL. `header_for` returns the `Cookie` field for a request to a URL. Both take the
//! current instant, which the caller reads from the wall clock, counted from the Unix epoch.
//!
//! A cookie is sent to the host that set it, or to the domain its `Domain` names if that host is in
//! that domain. It is sent only under its path, only over `https` if it is `Secure`, and only until
//! it expires. A response over `http` cannot set a `Secure` cookie or replace one.
//!
//! There is no public suffix list here. A `Domain` with a single label is rejected, but a `Domain`
//! such as `co.uk`, which is a public suffix, is accepted. So a jar is not safe to share between
//! sites that do not trust each other.
//!
//! `SameSite` is a browser's rule about which site started a request. It does not apply to a client
//! that starts every request itself.

import std.base64 (base64url_decode, base64url_encode)
import std.crypto
import std.crypto (SealKey)
import std.date
import std.date (OffsetDateTime)
import std.hash (hmac_sha256, tags_match)
import std.ip
import std.list
import std.math (abs)
import std.mime (is_token)
import std.random (entropy)
import std.string
import std.time (after, nanos_at, seconds)
import std.url
import std.url (Url, url_host, url_path, url_scheme)
import std.gen

/// One `name=value` of a request's `Cookie` field.
pub type Pair = { name: String, value: String }

/// The pairs of a `Cookie` field, in order. A pair whose name is not a token, or that has no `=`,
/// is skipped. A value in double quotes is read without the quotes.
pub fn pairs(field: String) -> List<Pair> / {abort.raise} =
  field.split(";").fold([], |found: List<Pair>, piece: String|
    match pair_of(piece) { Some(p) -> found.push(p), None -> found })

/// The pairs of every `Cookie` field a request carries, the fields in order.
pub fn pairs_of(fields: List<String>) -> List<Pair> / {abort.raise} =
  fields.fold([], |found: List<Pair>, field: String| concat_pairs(found, pairs(field)))

fn concat_pairs(a: List<Pair>, b: List<Pair>) -> List<Pair> =
  b.fold(a, |accumulator: List<Pair>, p: Pair| accumulator.push(p))

/// The value of the first pair named `name`, the name matched exactly.
pub fn get(found: List<Pair>, name: String) -> Option<String> = url::query_get(found, name)

fn pair_of(piece: String) -> Option<Pair> / {abort.raise} = {
  let b = Bytes::of_string(piece);
  match b.index_of(b"=") {
    None -> None,
    Some(at) -> {
      let name = String::of_bytes_lossy(b.slice(0, at)).ascii_trim();
      let value = unquoted(String::of_bytes_lossy(b.slice(at + 1, b.len())).ascii_trim());
      if is_token(name) { Some({ name: name, value: value }) } else { None }
    },
  }
}

fn unquoted(value: String) -> String = {
  let n = value.len();
  if n >= 2 && value.starts_with("\"") && value.ends_with("\"") { value.slice(1, n - 1) }
  else { value }
}

/// When a browser sends a cookie on a request another site started: never, on a top-level
/// navigation, or always. `Unrestricted` is written `SameSite=None` and needs `Secure`.
pub type SameSite = | Strict | Lax | Unrestricted

/// A cookie a response sets.
pub type SetCookie = {
  name: String,
  value: String,
  /// The number of seconds the cookie lives, counted from when the client receives it. Zero or less
  /// removes the cookie. Written as `Max-Age`.
  max_age: Option<Int>,
  /// When it expires, for a client that does not read `Max-Age`; one in the past removes it.
  expires: Option<OffsetDateTime>,
  /// The domain the cookie is also sent to, besides the host that set it. `None` restricts the
  /// cookie to the host that set it.
  domain: Option<String>,
  /// The path under which it is sent; `None` lets the client use the request's directory.
  path: Option<String>,
  secure: Bool,
  http_only: Bool,
  same_site: SameSite,
  /// Stored separately for each site that embeds the site that set it (CHIPS). Needs `Secure`.
  partitioned: Bool,
}

/// A cookie with the defaults a server should use. It lasts until the browser closes, and is sent
/// only to the host that set it, under `/`, and over `https`. Scripts cannot read it, and it is
/// sent cross-site only on top-level navigations.
pub fn set_cookie(name: String, value: String) -> SetCookie =
  {
    name: name,
    value: value,
    max_age: None,
    expires: None,
    domain: None,
    path: Some("/"),
    secure: true,
    http_only: true,
    same_site: Lax,
    partitioned: false,
  }

/// A cookie that tells a client to delete `c`: the same name, domain and path, an empty value,
/// `Max-Age=0`, and an `Expires` at the epoch for clients that ignore `Max-Age`.
pub fn removal(c: SetCookie) -> SetCookie =
  { ..c, value: "", max_age: Some(0), expires: date::of_unix_seconds(0) }

/// Why a cookie cannot be written.
pub type Error =
  /// The name is not an RFC 9110 token.
  | BadName
  /// The value contains a byte outside the cookie octets: a control, a space, `"`, `,`, `;` or `\`.
  | BadValue
  /// The domain is not one or more labels of letters, digits and `-`.
  | BadDomain
  /// The path does not begin with `/`, or contains a control character or `;`.
  | BadPath
  /// The name and the value are over 4096 bytes together.
  | TooLong
  /// The named attribute's value is over 1024 bytes.
  | AttributeTooLong(String)
  /// The cookie uses something that requires the `Secure` attribute, but `Secure` is not set. The
  /// text describes what was used: a `__Secure-` or `__Host-` name, `SameSite=None`, or
  /// `Partitioned`.
  | NeedsSecure(String)
  /// A cookie with a `__Host-` name sets the `Domain` attribute, or sets a `Path` other than `/`.
  | HostPrefix

/// The error this module raises.
pub effect cookie {
  /// The cookie cannot be written as it is.
  raise fail(reason: Error)
}

/// The most bytes a name and its value take together.
pub fn max_pair() -> Int = 4096

/// The most bytes an attribute's value takes.
pub fn max_attribute() -> Int = 1024

/// The `Set-Cookie` field's value for `c`. Raises `cookie.fail` where `try_render` returns `Err`.
pub fn render(c: SetCookie) -> String / {cookie.fail} = {
  validate(c);
  let parts = [
    c.name ++ "=" ++ c.value,
    attribute("Max-Age", option_map_text(c.max_age, Int::to_string)),
    attribute("Expires", option_map_text(c.expires, date::http_date)),
    attribute("Domain", c.domain),
    attribute("Path", c.path),
    flag("Secure", c.secure),
    flag("HttpOnly", c.http_only),
    "SameSite=" ++ same_site_name(c.same_site),
    flag("Partitioned", c.partitioned),
  ];
  parts.fold("", |accumulator: String, part: String|
    if part.len() == 0 { accumulator }
    else if accumulator.len() == 0 { part }
    else { accumulator ++ "; " ++ part })
}

/// The `Set-Cookie` field's value for `c`, or why it cannot be written.
pub fn try_render(c: SetCookie) -> Result<String, Error> = try { render(c) }

fn option_map_text<a>(x: Option<a>, f: (a) -> String) -> Option<String> =
  match x { Some(v) -> Some(f(v)), None -> None }

fn attribute(name: String, value: Option<String>) -> String =
  match value { Some(v) -> name ++ "=" ++ v, None -> "" }

fn flag(name: String, on: Bool) -> String = if on { name } else { "" }

/// How each `SameSite` value is written in a `Set-Cookie` field.
pub fn same_site_name(s: SameSite) -> String =
  match s { Strict -> "Strict", Lax -> "Lax", Unrestricted -> "None" }

fn validate(c: SetCookie) -> Unit / {cookie.fail} =
  if !is_token(c.name) { cookie.fail(BadName) }
  else if !all_cookie_octets(c.value) { cookie.fail(BadValue) }
  else if Bytes::of_string(c.name ++ c.value).len() > max_pair() { cookie.fail(TooLong) }
  else { validate_attributes(c) }

fn validate_attributes(c: SetCookie) -> Unit / {cookie.fail} = {
  match c.domain {
    Some(d) -> if Bytes::of_string(d).len() > max_attribute() {
      cookie.fail(AttributeTooLong("Domain"))
    } else if !is_valid_domain(d) { cookie.fail(BadDomain) }
    else { () },
    None -> (),
  };
  match c.path {
    Some(p) -> if Bytes::of_string(p).len() > max_attribute() {
      cookie.fail(AttributeTooLong("Path"))
    } else if !is_valid_path(p) { cookie.fail(BadPath) }
    else { () },
    None -> (),
  };
  validate_prefixes(c)
}

fn validate_prefixes(c: SetCookie) -> Unit / {cookie.fail} =
  if host_prefixed(c.name) {
    if !c.secure { cookie.fail(NeedsSecure("a `__Host-` name")) }
    else if c.domain != None || c.path != Some("/") { cookie.fail(HostPrefix) }
    else { () }
  } else if secure_prefixed(c.name) && !c.secure { cookie.fail(NeedsSecure("a `__Secure-` name")) }
  else if c.same_site == Unrestricted && !c.secure { cookie.fail(NeedsSecure("`SameSite=None`")) }
  else if c.partitioned && !c.secure { cookie.fail(NeedsSecure("`Partitioned`")) }
  else { () }

fn host_prefixed(name: String) -> Bool = name.ascii_lower().starts_with("__host-")

fn secure_prefixed(name: String) -> Bool = name.ascii_lower().starts_with("__secure-")

fn all_cookie_octets(value: String) -> Bool = {
  let b = Bytes::of_string(value);
  range(0, b.len()).fold(true, |ok: Bool, i: Int| ok && is_cookie_octet(b.at(i)))
}

fn is_cookie_octet(o: Int) -> Bool =
  o == 0x21 || (o >= 0x23 && o <= 0x2b) || (o >= 0x2d && o <= 0x3a) || (o >= 0x3c && o <= 0x5b)
    || (o >= 0x5d && o <= 0x7e)

fn is_valid_domain(d: String) -> Bool =
  d.is_ascii() && d.len() > 0
    && d.split(".").fold(true, |ok: Bool, label: String| ok && is_valid_label(label))

fn is_valid_label(label: String) -> Bool = {
  let b = Bytes::of_string(label);
  b.len() > 0 && b.len() <= 63
    && range(0, b.len()).fold(true, |ok: Bool, i: Int| ok && is_label_byte(b.at(i)))
}

fn is_label_byte(o: Int) -> Bool =
  (o >= 0x30 && o <= 0x39) || (o >= 0x41 && o <= 0x5a) || (o >= 0x61 && o <= 0x7a) || o == 0x2d

fn is_valid_path(p: String) -> Bool = {
  let b = Bytes::of_string(p);
  p.starts_with("/")
    && range(0, b.len()).fold(true, |ok: Bool, i: Int| {
      let o = b.at(i);
      ok && o >= 0x20 && o != 0x7f && o != 0x3b
    })
}

/// Parses a `Set-Cookie` field the way a client does. Returns `None` if the field has no cookie:
/// its name and value have no `=`, its name is empty, or its name and value together are over 4096
/// bytes. An attribute that cannot be parsed, or whose value is over 1024 bytes, is skipped. When
/// an attribute appears twice, the last one wins. An `Expires` is parsed as an HTTP date, with
/// `now` deciding the century of a two-digit year. A `Path` that does not begin with `/` is
/// ignored. An unknown `SameSite` is `Lax`. Nothing is checked against the URL here; `store` does
/// that.
pub fn parse_set_cookie(field: String, now: Instant) -> Option<SetCookie> / {abort.raise} = {
  let pieces = field.split(";");
  let first = match pieces.at(0) { Some(p) -> p, None -> "" };
  let b = Bytes::of_string(first);
  match b.index_of(b"=") {
    None -> None,
    Some(at) -> {
      let name = String::of_bytes_lossy(b.slice(0, at)).ascii_trim();
      let value = String::of_bytes_lossy(b.slice(at + 1, b.len())).ascii_trim();
      if name.len() == 0 || Bytes::of_string(name ++ value).len() > max_pair() { None } else {
        let bare = {
          name: name,
          value: value,
          max_age: None,
          expires: None,
          domain: None,
          path: None,
          secure: false,
          http_only: false,
          same_site: Lax,
          partitioned: false,
        };
        Some(
          drop_first(pieces).fold(bare, |c: SetCookie, piece: String|
            with_attribute(c, piece, now)),
        )
      }
    },
  }
}

fn drop_first(xs: List<String>) -> List<String> = match xs { [_, ..rest] -> rest, [] -> [] }

fn with_attribute(c: SetCookie, piece: String, now: Instant) -> SetCookie / {abort.raise} = {
  let b = Bytes::of_string(piece);
  let split = match b.index_of(b"=") {
    Some(at) ->
      {
        name: String::of_bytes_lossy(b.slice(0, at)).ascii_trim().ascii_lower(),
        value: String::of_bytes_lossy(b.slice(at + 1, b.len())).ascii_trim(),
      },
    None -> { name: piece.ascii_trim().ascii_lower(), value: "" },
  };
  if Bytes::of_string(split.value).len() > max_attribute() { c }
  else { attribute_read(c, split.name, split.value, now) }
}

fn attribute_read(
  c: SetCookie,
  name: String,
  value: String,
  now: Instant,
) -> SetCookie / {abort.raise} =
  if name == "expires" {
    match date::parse_http_date(value, now) { Some(at) -> { ..c, expires: Some(at) }, None -> c }
  } else if name == "max-age" {
    match max_age_of(value) { Some(n) -> { ..c, max_age: Some(n) }, None -> c }
  } else if name == "domain" {
    if value.len() == 0 { c } else {
      let bare = if value.starts_with(".") { value.slice(1, value.len()) } else { value };
      { ..c, domain: Some(bare.ascii_lower()) }
    }
  } else if name == "path" {
    { ..c, path: if value.starts_with("/") { Some(value) } else { None } }
  } else { flag_read(c, name, value) }

fn flag_read(c: SetCookie, name: String, value: String) -> SetCookie =
  if name == "secure" { { ..c, secure: true } }
  else if name == "httponly" { { ..c, http_only: true } }
  else if name == "partitioned" { { ..c, partitioned: true } }
  else if name == "samesite" { { ..c, same_site: same_site_of(value) } }
  else { c }

fn same_site_of(value: String) -> SameSite =
  if value.eq_ignore_ascii_case("strict") { Strict }
  else if value.eq_ignore_ascii_case("none") { Unrestricted }
  else { Lax }

fn max_age_of(value: String) -> Option<Int> / {abort.raise} = {
  let negative = value.starts_with("-");
  let digits = if negative { value.slice(1, value.len()) } else { value };
  let b = Bytes::of_string(digits);
  if b.len() == 0 || b.len() > 18
      || !range(0, b.len()).fold(true, |ok: Bool, i: Int|
        ok && b.at(i) >= 0x30 && b.at(i) <= 0x39) { None } else {
    match digits.int_of_string() { Some(n) -> Some(if negative { 0 - n } else { n }), None -> None }
  }
}

/// `value` signed with `key` for the cookie `name`: the value's bytes and an HMAC tag, each in
/// unpadded base64url, joined by `.`. A client can read it but cannot change it.
pub fn signed(key: Secret<Bytes>, name: String, value: Bytes) -> String / {abort.raise} = {
  let text = base64url_encode(value);
  text ++ "." ++ base64url_encode(hmac_sha256(key, tagged(name, text)))
}

/// The value `signed` wrote under `key` for the cookie `name`. `None` if the tag does not match
/// that key, name and value, or the text is not in the form `signed` writes.
pub fn verified(key: Secret<Bytes>, name: String, text: String) -> Option<Bytes> / {abort.raise} = {
  let b = Bytes::of_string(text);
  match b.index_of(b".") {
    None -> None,
    Some(at) -> {
      let body = String::of_bytes_lossy(b.slice(0, at));
      let tag = base64url_decode(String::of_bytes_lossy(b.slice(at + 1, b.len())));
      match tag {
        Some(t) -> if tags_match(t, hmac_sha256(key, tagged(name, body))) { base64url_decode(body) }
        else { None },
        None -> None,
      }
    },
  }
}

fn tagged(name: String, body: String) -> Bytes = Bytes::of_string(name ++ "=" ++ body)

/// `value` encrypted under `key` for the cookie `name`, in unpadded base64url. A client can neither
/// read it nor change it, and a value sealed for one name does not decrypt under another.
pub fn sealed(key: SealKey, name: String, value: Bytes) -> String / {entropy.next, abort.raise} =
  base64url_encode(crypto::seal(key, value, Bytes::of_string(name)))

/// `sealed` with a given nonce, so that a test gets the same output on every run.
pub fn sealed_under(
  key: SealKey,
  nonce: Bytes,
  name: String,
  value: Bytes,
) -> String / {abort.raise} =
  base64url_encode(crypto::seal_with_nonce(key, nonce, value, Bytes::of_string(name)))

/// The value `sealed` encrypted under `key` for the cookie `name`, or `None` if it does not
/// decrypt.
pub fn opened(key: SealKey, name: String, text: String) -> Option<Bytes> / {abort.raise} =
  match base64url_decode(text) {
    Some(b) -> crypto::open(key, b, Bytes::of_string(name)),
    None -> None,
  }

/// A cookie stored in a jar: its name and value, the host or domain it is sent back to, the path it
/// is sent under, when it expires (`None` for a session cookie), and `created`, the order in which
/// it was first set.
pub type StoredCookie = {
  name: String,
  value: String,
  domain: String,
  host_only: Bool,
  path: String,
  expires: Option<Instant>,
  secure: Bool,
  http_only: Bool,
  same_site: SameSite,
  created: Int,
}

/// A client's stored cookies. `most` is the maximum number of cookies it stores; when it is
/// exceeded, the oldest cookies are dropped first.
pub type Jar = new { cookies: List<StoredCookie>, made: Int, most: Int }

/// An empty jar that stores at most `most` cookies.
pub fn jar(most: Int) -> Jar = { cookies: [], made: 0, most: max(most, 0) }

/// The cookies in `j`, in the order they were first set.
pub fn all_cookies(j: Jar) -> List<StoredCookie> = j.cookies

/// Returns `j` with the cookies set by each `Set-Cookie` field of a response from `from`, at `now`.
/// A field is skipped if it cannot be parsed or if `from` may not set its cookie. `from` may not
/// set a cookie in these cases: its `Domain` is not the host or a parent of the host; its `Domain`
/// is a single label (such as `com`) other than the host; the response is over `http` and the
/// cookie is `Secure`; the response is over `http` and the cookie would replace a stored `Secure`
/// cookie; its name has a `__Secure-` or `__Host-` prefix and its attributes break that prefix's
/// rules; or it has `SameSite=None` without `Secure`. An expired cookie removes the stored cookie
/// with the same name, domain and path.
pub fn store(j: Jar, from: Url, fields: List<String>, now: Instant) -> Jar / {abort.raise} =
  fields.fold(j, |jar: Jar, field: String|
    match parse_set_cookie(field, now) {
      Some(c) -> match accepted(jar, from, c, now) {
        Some(s) -> insert_cookie(jar, s, now),
        None -> jar,
      },
      None -> jar,
    })

/// The `Cookie` field for a request to `to` at `now`, or `None` if no cookie is sent there.
pub fn header_for(j: Jar, to: Url, now: Instant) -> Option<String> / {abort.raise} =
  match sent_to(j, to, now) {
    [] -> None,
    sent ->
      Some(
        sent.fold("", |accumulator: String, p: Pair|
          if accumulator.len() == 0 { p.name ++ "=" ++ p.value }
          else { accumulator ++ "; " ++ p.name ++ "=" ++ p.value }),
      ),
  }

/// Returns the cookies to send with a request to `to` at `now`. Cookies with longer paths come
/// first; among equal paths, older cookies come first.
pub fn sent_to(j: Jar, to: Url, now: Instant) -> List<Pair> / {abort.raise} = {
  let host = host_of(to);
  let secure = secure_scheme(to);
  let path = request_path(to);
  let going = j.cookies.filter(|s: StoredCookie|
    live(s, now) && domain_applies(s, host) && path_matches(path, s.path) && (secure || !s.secure));
  going.sort_by(|a: StoredCookie, b: StoredCookie|
    a.path.len() > b.path.len() || (a.path.len() == b.path.len() && a.created < b.created)).map(
    |s: StoredCookie| { name: s.name, value: s.value },
  )
}

/// `j` without the cookies that have expired at `now`.
pub fn expired_removed(j: Jar, now: Instant) -> Jar =
  { ..j, cookies: j.cookies.filter(|s: StoredCookie| live(s, now)) }

fn live(s: StoredCookie, now: Instant) -> Bool =
  match s.expires { Some(at) -> nanos_at(at) > nanos_at(now), None -> true }

fn host_of(u: Url) -> String =
  match url_host(u) {
    Some(url::Name(name)) -> name.ascii_lower(),
    Some(url::V4(four)) -> ip::render(ip::V4(four)),
    Some(url::V6(six)) -> ip::render(ip::V6(six)),
    None -> "",
  }

fn host_is_address(u: Url) -> Bool =
  match url_host(u) { Some(url::Name(_)) -> false, Some(_) -> true, None -> false }

fn secure_scheme(u: Url) -> Bool = url_scheme(u) == "https" || url_scheme(u) == "wss"

fn request_path(u: Url) -> String = if url_path(u).len() == 0 { "/" } else { url_path(u) }

fn default_path(u: Url) -> String / {abort.raise} = {
  let p = request_path(u);
  if !p.starts_with("/") { "/" } else {
    let b = Bytes::of_string(p);
    let last = range(0, b.len()).fold(0, |at: Int, i: Int| if b.at(i) == 0x2f { i } else { at });
    if last == 0 { "/" } else { String::of_bytes_lossy(b.slice(0, last)) }
  }
}

fn domain_applies(s: StoredCookie, host: String) -> Bool =
  if s.host_only { host == s.domain } else { domain_matches(host, s.domain) }

fn domain_matches(host: String, domain: String) -> Bool =
  host == domain || host.ends_with("." ++ domain)

fn path_matches(path: String, cookie_path: String) -> Bool / {abort.raise} =
  path == cookie_path
    || (path.starts_with(cookie_path)
    && (cookie_path.ends_with("/") || path.slice(cookie_path.len(), cookie_path.len() + 1) == "/"))

fn accepted(j: Jar, from: Url, c: SetCookie, now: Instant) -> Option<StoredCookie> / {abort.raise} = {
  let host = host_of(from);
  let secure = secure_scheme(from);
  let place = match c.domain {
    None -> Some({ domain: host, host_only: true }),
    Some(d) -> if host_is_address(from) {
      if d == host { Some({ domain: host, host_only: true }) } else { None }
    } else if !d.contains(".") && d != host { None }
    else if domain_matches(host, d) { Some({ domain: d, host_only: false }) }
    else { None },
  };
  let path = match c.path { Some(p) -> p, None -> default_path(from) };
  let fail = host.len() == 0 || (c.secure && !secure)
    || (host_prefixed(c.name) && (!c.secure || c.domain != None || path != "/"))
    || (secure_prefixed(c.name) && !c.secure)
    || (c.same_site == Unrestricted && !c.secure)
    || (!secure && overwrites_secure(j, c.name, host, path));
  match place {
    None -> None,
    Some(at) -> if fail { None } else {
      Some({
        name: c.name,
        value: c.value,
        domain: at.domain,
        host_only: at.host_only,
        path: path,
        expires: expiry(c, now),
        secure: c.secure,
        http_only: c.http_only,
        same_site: c.same_site,
        created: j.made,
      })
    },
  }
}

fn overwrites_secure(j: Jar, name: String, host: String, path: String) -> Bool / {abort.raise} =
  j.cookies.any(|s: StoredCookie|
    s.secure && s.name == name && (domain_matches(s.domain, host) || domain_matches(host, s.domain))
      && path_matches(path, s.path))

fn expiry(c: SetCookie, now: Instant) -> Option<Instant> =
  match c.max_age {
    Some(n) -> Some(if n <= 0 { Instant(0) } else { after(now, seconds(n)) }),
    None -> match c.expires { Some(at) -> Some(date_instant(at)), None -> None },
  }

fn date_instant(at: OffsetDateTime) -> Instant =
  match date::instant(at) { Some(i) -> i, None -> Instant(0) }

fn insert_cookie(j: Jar, s: StoredCookie, now: Instant) -> Jar = {
  let same = |t: StoredCookie| t.name == s.name && t.domain == s.domain && t.path == s.path;
  let before = j.cookies.filter(|t: StoredCookie| same(t));
  let others = j.cookies.filter(|t: StoredCookie| !same(t));
  if !live(s, now) { { ..j, cookies: others } } else {
    let stored = match before { [old, ..] -> { ..s, created: old.created }, [] -> s };
    let all = others.filter(|t: StoredCookie| live(t, now)).push(stored).sort_by(
      |a: StoredCookie, b: StoredCookie| a.created < b.created,
    );
    let over = all.len() - j.most;
    { cookies: if over > 0 { drop_oldest(all, over) } else { all }, made: j.made + 1, most: j.most }
  }
}

fn drop_oldest(xs: List<StoredCookie>, n: Int) -> List<StoredCookie> =
  match xs { [_, ..rest] -> if n <= 0 { xs } else { drop_oldest(rest, n - 1) }, [] -> [] }

test "a Cookie field's pairs are read in order, skipping any that cannot be read" {
  assert_eq(pairs("a=1; b=\"two\";c=3;=4; broken; d e=5;f="), [
    { name: "a", value: "1" },
    { name: "b", value: "two" },
    { name: "c", value: "3" },
    { name: "f", value: "" },
  ]);
  let found = pairs_of(["a=1", "a=2; b=3"]);
  assert_eq(get(found, "a"), Some("1"));
  assert_eq(get(found, "b"), Some("3"));
  assert_eq(get(found, "B"), None)
}

test "`set_cookie` renders with Secure, HttpOnly and SameSite=Lax by default, and renders every attribute that is set" {
  assert_eq(
    try_render(set_cookie("session", "abc123")),
    Ok("session=abc123; Path=/; Secure; HttpOnly; SameSite=Lax"),
  );
  let every = {
    ..set_cookie("id", "7"),
    max_age: Some(3600),
    expires: date::of_unix_seconds(1700000000),
    domain: Some("example.com"),
    same_site: Unrestricted,
    partitioned: true,
  };
  assert_eq(
    try_render(every),
    Ok(
      "id=7; Max-Age=3600; Expires=Tue, 14 Nov 2023 22:13:20 GMT; Domain=example.com; Path=/; Secure; HttpOnly; SameSite=None; Partitioned",
    ),
  );
  assert_eq(
    try_render(removal(set_cookie("id", "7"))),
    Ok(
      "id=; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Path=/; Secure; HttpOnly; SameSite=Lax",
    ),
  )
}

test "rendering a cookie fails with an error when the cookie is invalid: {c.what}" for c: { what: String, cookie: SetCookie, reason: Error } in [
    { what: "a name with a space", cookie: set_cookie("a b", "1"), reason: BadName },
    { what: "a value with a semicolon", cookie: set_cookie("a", "1;2"), reason: BadValue },
    { what: "a value with a space", cookie: set_cookie("a", "1 2"), reason: BadValue },
    {
      what: "a domain of an empty label",
      cookie: { ..set_cookie("a", "1"), domain: Some("a..b") },
      reason: BadDomain,
    },
    {
      what: "a path not from the root",
      cookie: { ..set_cookie("a", "1"), path: Some("x") },
      reason: BadPath,
    },
    {
      what: "a path that ends the field",
      cookie: { ..set_cookie("a", "1"), path: Some("/a;b") },
      reason: BadPath,
    },
    {
      what: "a `__Secure-` cookie over http",
      cookie: { ..set_cookie("__Secure-a", "1"), secure: false },
      reason: NeedsSecure("a `__Secure-` name"),
    },
    {
      what: "a `__Host-` cookie that names a domain",
      cookie: { ..set_cookie("__Host-a", "1"), domain: Some("example.com") },
      reason: HostPrefix,
    },
    {
      what: "a `__host-` cookie under a path",
      cookie: { ..set_cookie("__host-a", "1"), path: Some("/app") },
      reason: HostPrefix,
    },
    {
      what: "`SameSite=None` over http",
      cookie: { ..set_cookie("a", "1"), secure: false, same_site: Unrestricted },
      reason: NeedsSecure("`SameSite=None`"),
    },
    {
      what: "`Partitioned` over http",
      cookie: { ..set_cookie("a", "1"), secure: false, partitioned: true },
      reason: NeedsSecure("`Partitioned`"),
    },
  ] { assert_eq(try_render(c.cookie), Err(c.reason)) }

test "a name and value over 4096 bytes, or an attribute over 1024, is rejected" {
  let long = |n: Int| range(0, n).fold("", |accumulator: String, _i: Int| accumulator ++ "x");
  assert_eq(try_render(set_cookie("a", long(4096))), Err(TooLong));
  assert(try_render(set_cookie("a", long(4095))) != Err(TooLong));
  assert_eq(
    try_render({ ..set_cookie("a", "1"), path: Some("/" ++ long(1024)) }),
    Err(AttributeTooLong("Path")),
  )
}

test "`parse_set_cookie` parses a Set-Cookie header field into a cookie and ignores unknown or invalid attributes" {
  let now = test_now();
  assert_eq(
    parse_set_cookie(
      "id=7; Path=/a; Domain=.Example.COM; Max-Age=60; Secure; HttpOnly; SameSite=strict; Partitioned; Bogus",
      now,
    ),
    Some({
      name: "id",
      value: "7",
      max_age: Some(60),
      expires: None,
      domain: Some("example.com"),
      path: Some("/a"),
      secure: true,
      http_only: true,
      same_site: Strict,
      partitioned: true,
    }),
  );
  let loose = parse_set_cookie(
    "x=1; path=relative; samesite=sideways; max-age=1e3; expires=never",
    now,
  );
  assert_eq(
    loose,
    Some({
      name: "x",
      value: "1",
      max_age: None,
      expires: None,
      domain: None,
      path: None,
      secure: false,
      http_only: false,
      same_site: Lax,
      partitioned: false,
    }),
  );
  assert_eq(parse_set_cookie("no equals sign", now), None);
  assert_eq(parse_set_cookie("=1", now), None)
}

test "`verified` returns the original bytes of a signed cookie, and None for a different key, a different name or altered text" {
  let key = Secret::of_bytes(b"0123456789abcdef0123456789abcdef");
  let other = Secret::of_bytes(b"fedcba9876543210fedcba9876543210");
  let text = signed(key, "cart", b"3 bolts");
  assert_eq(verified(key, "cart", text), Some(b"3 bolts"));
  assert_eq(verified(other, "cart", text), None);
  assert_eq(verified(key, "basket", text), None);
  assert_eq(verified(key, "cart", signed(key, "cart", b"4 bolts") ++ "x"), None);
  assert_eq(verified(key, "cart", "no dot here"), None);
  assert(all_cookie_octets(text))
}

test "a sealed value decrypts under its key and name, and cannot be read without them" {
  match crypto::seal_key(Secret::of_bytes(b"0123456789abcdef0123456789abcdef")) {
    None -> panic("a key of 32 bytes"),
    Some(key) -> {
      let nonce = b"abcdefghijklmnopqrstuvwx";
      let text = sealed_under(key, nonce, "cart", b"3 bolts");
      assert_eq(opened(key, "cart", text), Some(b"3 bolts"));
      assert_eq(opened(key, "basket", text), None);
      assert(!text.contains(base64url_encode(b"3 bolts")));
      assert(all_cookie_octets(text))
    },
  }
}

fn test_now() -> Instant = after(Instant(0), seconds(1700000000))

test "a jar sends a cookie only to the hosts, paths and schemes that its Domain, Path and Secure settings allow" {
  let set = store(
    jar(50),
    url"https://shop.example.com/cart/add",
    [
      "host=1",
      "wide=2; Domain=example.com; Path=/",
      "deep=3; Path=/cart/items",
      "safe=4; Secure; Path=/",
    ],
    test_now(),
  );
  assert_eq(
    header_for(set, url"https://shop.example.com/cart/items/9", test_now()),
    Some("deep=3; host=1; wide=2; safe=4"),
  );
  assert_eq(header_for(set, url"https://api.example.com/", test_now()), Some("wide=2"));
  assert_eq(header_for(set, url"http://shop.example.com/", test_now()), Some("wide=2"));
  assert_eq(header_for(set, url"https://example.org/", test_now()), None);
  assert_eq(
    header_for(set, url"https://shop.example.com/cartography", test_now()),
    Some("wide=2; safe=4"),
  )
}

test "a jar stores no cookie from a response that is not allowed to set it: {c.what}" for c: { what: String, from: Url, field: String } in [
    {
      what: "a domain the host is not in",
      from: url"https://a.example.com/",
      field: "x=1; Domain=example.org",
    },
    { what: "a domain of one label", from: url"https://example/", field: "x=1; Domain=com" },
    { what: "a secure cookie over http", from: url"http://example.com/", field: "x=1; Secure" },
    {
      what: "a `__Host-` cookie with a domain",
      from: url"https://example.com/",
      field: "__Host-x=1; Secure; Path=/; Domain=example.com",
    },
    {
      what: "a `__Host-` cookie under a path",
      from: url"https://example.com/",
      field: "__Host-x=1; Secure; Path=/a",
    },
    {
      what: "a `__Secure-` cookie without Secure",
      from: url"https://example.com/",
      field: "__Secure-x=1",
    },
    {
      what: "`SameSite=None` without Secure",
      from: url"https://example.com/",
      field: "x=1; SameSite=None",
    },
    { what: "a domain on an address", from: url"https://192.0.2.1/", field: "x=1; Domain=0.2.1" },
  ] { assert_eq(all_cookies(store(jar(50), c.from, [c.field], test_now())), []) }

test "a jar does not let an http response overwrite a secure cookie, and drops cookies that have expired" {
  let secure = store(jar(50), url"https://example.com/", ["id=s; Secure; Path=/"], test_now());
  let shadowed = store(secure, url"http://example.com/", ["id=plain; Path=/"], test_now());
  assert_eq(header_for(shadowed, url"https://example.com/", test_now()), Some("id=s"));
  let gone = store(
    secure,
    url"https://example.com/",
    ["id=; Secure; Path=/; Max-Age=0"],
    test_now(),
  );
  assert_eq(all_cookies(gone), []);
  let later = store(secure, url"https://example.com/", ["t=1; Max-Age=10"], test_now());
  assert_eq(
    header_for(later, url"https://example.com/", after(test_now(), seconds(11))),
    Some("id=s"),
  );
  let dated = store(
    jar(50),
    url"https://example.com/",
    [
      "old=1; Expires=Thu, 01 Jan 1970 00:00:00 GMT",
      "new=2; Expires=Wed, 01 Jan 2031 00:00:00 GMT",
    ],
    test_now(),
  );
  assert_eq(header_for(dated, url"https://example.com/", test_now()), Some("new=2"))
}

test "a jar stores at most its limit, dropping the oldest first" {
  let full = store(jar(2), url"https://example.com/", ["a=1", "b=2", "c=3"], test_now());
  assert_eq(all_cookies(full).map(|s: StoredCookie| s.name), ["b", "c"]);
  let replaced = store(full, url"https://example.com/", ["b=9"], test_now());
  assert_eq(header_for(replaced, url"https://example.com/", test_now()), Some("b=9; c=3"))
}

fn named(n: Int) -> String = "c" ++ abs(n % 1000).to_string()

test "a cookie set for its own host is never sent to another" {
  gen::check2(gen::any_int(), gen::any_int(), |n: Int, v: Int| {
    let j = store(
      jar(50),
      url"https://a.example.com/",
      [named(n) ++ "=" ++ v.to_string()],
      test_now(),
    );
    header_for(j, url"https://b.example.com/", test_now()) == None
      && header_for(j, url"https://example.com/", test_now()) == None
  })
}

test "a jar never has more cookies than its limit" {
  gen::check2(gen::any_int(), gen::list(gen::any_int()), |most: Int, ns: List<Int>| {
    let j = store(
      jar(abs(most % 8)),
      url"https://example.com/",
      ns.map(|n: Int| named(n) ++ "=1"),
      test_now(),
    );
    all_cookies(j).len() <= abs(most % 8)
  })
}

test "`verified` returns the original bytes that `signed` wrapped, when given the same key and name" {
  gen::check(gen::bytes(), |b: Bytes| {
    let key = Secret::of_bytes(b"0123456789abcdef0123456789abcdef");
    verified(key, "k", signed(key, "k", b)) == Some(b)
  })
}
