//! JSON Web Tokens: claims signed by a key and verified as RFC 7519 and RFC 7515 define, with the
//! mistakes RFC 8725 lists made impossible by the types the functions take.
//!
//! A token is three base64url texts joined by dots: a header that states how the token was signed,
//! a payload, and a signature over the first two as written. `sign` makes a token from a `Claims`.
//! `verify` returns a `Verified` only when the given key made the signature and the claims meet the
//! given `Policy` at the given instant. `Verified` is opaque, so a function that takes one cannot
//! be passed unchecked claims. `peek` reads a token without checking it and returns an
//! `Unverified`, so a caller can choose a key by what the token says about itself. `sign_bytes` and
//! `verify_bytes` make and check the same kind of signature over a payload that is not claims.
//!
//! A `Key` names exactly one algorithm. A token whose header names a different algorithm is
//! rejected before any signature is computed. So the token never chooses how it is checked: `none`
//! is not an algorithm a key can name, and a public key is never used as an HMAC secret. The
//! algorithms are HMAC with SHA-256, SHA-384 and SHA-512 (`HS256`, `HS384`, `HS512`), EdDSA over
//! Ed25519, ECDSA over P-256 with SHA-256 (`ES256`), P-384 with SHA-384 (`ES384`), P-521 with
//! SHA-512 (`ES512`) and secp256k1 with SHA-256 (`ES256K`, RFC 8812), RSA PKCS #1 v1.5 (`RS256`,
//! `RS384`, `RS512`) and RSA-PSS (`PS256`, `PS384`, `PS512`). Every signature depends only on the
//! key and the input: an ECDSA nonce is computed as RFC 6979 specifies, and a PSS salt is derived
//! from the key and the message.
//!
//! A key that signs stores its material as a `Secret`, which only the runtime can read. A key that
//! only verifies is public bytes. `sign` and `verify` both reject an HMAC secret shorter than its
//! hash's digest (RFC 7518 section 3.2), because a verifier with a guessable secret accepts anyone
//! who guesses it. They reject an RSA key under 2048 bits as `SmallKey`. An `ES256` signature is
//! the two integers `r` and `s`, written one after the other and each as long as the curve's
//! scalar, with nothing else. The DER form that X.509 writes is not a valid signature here.
//!
//! Reading is strict. A token longer than the `max_bytes` that the caller passes (for `verify`,
//! `Policy.max_bytes`) is rejected without being read. Each part must be unpadded base64url with no
//! other characters and with the unused trailing bits set to zero. The header and the claims must
//! be JSON objects with no repeated member. A `crit` header, `b64` set to false and the five parts
//! of an encrypted token are each rejected with their own reason. A header that points at a key
//! (`jku`, `x5u`, `jwk`) is never followed: nothing here performs effects, so no token can make a
//! verifier fetch anything. An HMAC is compared the way `tags_match` in `std.hash` compares tags,
//! and the payload is not parsed until the signature is valid.
//!
//! A `Policy` has no default. The code that builds a `Policy` must set the longest token to read,
//! how far apart the issuer's clock and the verifier's clock may be, whether a token must expire,
//! and what `iss`, `aud`, `sub` and `typ` must be, or `Any` for each of those it does not check.
//! `exp` and `nbf` are checked against the `Instant` the caller passes, never against a clock read
//! here. `iat` and `jti` are returned but not checked: a verifier that limits a token's age, or
//! rejects a token used twice, must track that state itself.
//!
//! `jwk` and `jwks` read the RFC 7517 keys this module can use: `oct`, `OKP` over Ed25519, `EC`
//! over the four curves, and `RSA`. `key_for` picks the key that a peeked header names. A JWK is
//! JSON that the caller has already parsed, so the base64url text of a `k` or `d` member is an
//! ordinary `String`. Decoding that text produces a `Secret`, so the decoded bytes are never an
//! ordinary value. Only the runtime turns the numbers of an RSA private key into a key document.

import std.base64 (base64url_decode, base64url_decode_secret, base64url_encode)
import std.crypto
import std.crypto (Digest, EcdsaCurve, Raw, Sha256, Sha384, Sha512)
import std.decimal
import std.ed25519
import std.gen
import std.gen (Gen)
import std.hash (hmac_sha256, hmac_sha384, hmac_sha512, tags_match)
import std.json
import std.json (Array, DecodeError, Json, JsonCodec, Member, Number, Object, Str)
import std.list (enumerate, somes)
import std.math (max_int, min_int)
import std.option
import std.result
import std.string
import std.time (after, as_nanos, nanos_at, seconds)

/// A key for one signature algorithm, which it signs or verifies with. A key that signs contains a
/// `Secret` and can also verify what it signed. A key that only verifies is public bytes. Because a
/// `Key` can contain a `Secret`, a `forall` cannot generate one: a test must choose the bytes and
/// build the key from them.
pub type Key =
  /// `HS256`: HMAC with SHA-256 under a shared secret of thirty-two bytes or more.
  | HmacSha256(Secret<Bytes>)
  /// `HS384`: HMAC with SHA-384 under a shared secret of forty-eight bytes or more.
  | HmacSha384(Secret<Bytes>)
  /// `HS512`: HMAC with SHA-512 under a shared secret of sixty-four bytes or more.
  | HmacSha512(Secret<Bytes>)
  /// `EdDSA` over Ed25519, to verify with: the thirty-two bytes of a public key.
  | Ed25519(Bytes)
  /// `EdDSA` over Ed25519, to sign with: the thirty-two bytes of a seed, which is the private key.
  | Ed25519Seed(Secret<Bytes>)
  /// `ES256`, `ES384`, `ES512` or `ES256K` by its curve (P-256, P-384, P-521 or secp256k1), to
  /// verify with: a point of the curve in its uncompressed form.
  | Ecdsa(EcdsaCurve, Bytes)
  /// The same, to sign with: the curve's scalar, most significant byte first.
  | EcdsaScalar(EcdsaCurve, Secret<Bytes>)
  /// `RS256`, `RS384` or `RS512` by its digest, to verify with: a PKCS #1 `RSAPublicKey` of 2048
  /// bits or more.
  | RsaPkcs1(Digest, Bytes)
  /// The same, to sign with: a private key document, PKCS #8 or PKCS #1 in DER.
  | RsaPkcs1Document(Digest, Secret<Bytes>)
  /// `PS256`, `PS384` or `PS512` by its digest, to verify with: a PKCS #1 `RSAPublicKey` of 2048
  /// bits or more.
  | RsaPss(Digest, Bytes)
  /// The same, to sign with: a private key document, PKCS #8 or PKCS #1 in DER.
  | RsaPssDocument(Digest, Secret<Bytes>)

fn digest_bits(digest: Digest) -> String =
  match digest { Sha256 -> "256", Sha384 -> "384", Sha512 -> "512" }

fn curve_algorithm(curve: EcdsaCurve) -> String =
  match curve {
    crypto::NistP256 -> "ES256",
    crypto::NistP384 -> "ES384",
    crypto::NistP521 -> "ES512",
    crypto::Secp256k1 -> "ES256K",
  }

/// The `alg` a token signed with `key` names.
pub fn algorithm(key: Key) -> String =
  match key {
    HmacSha256(_) -> "HS256",
    HmacSha384(_) -> "HS384",
    HmacSha512(_) -> "HS512",
    Ed25519(_) -> "EdDSA",
    Ed25519Seed(_) -> "EdDSA",
    Ecdsa(curve, _) -> curve_algorithm(curve),
    EcdsaScalar(curve, _) -> curve_algorithm(curve),
    RsaPkcs1(digest, _) -> "RS" ++ digest_bits(digest),
    RsaPkcs1Document(digest, _) -> "RS" ++ digest_bits(digest),
    RsaPss(digest, _) -> "PS" ++ digest_bits(digest),
    RsaPssDocument(digest, _) -> "PS" ++ digest_bits(digest),
  }

/// The key a verifier uses for what `key` signs: the public key of an Ed25519 seed, an ECDSA
/// scalar or an RSA document, or for an HMAC secret, the secret itself, which both sides share.
/// Raises for a key that `sign` would reject.
pub fn verification_key(key: Key) -> Key / {jwt.fail, abort.raise} =
  match validated_key(key) {
    Ed25519Seed(seed) -> Ed25519(ed25519::public_key(seed)),
    EcdsaScalar(curve, scalar) ->
      Ecdsa(curve, public_of(crypto::ecdsa_signing(curve, scalar, Raw), key)),
    RsaPkcs1Document(digest, document) ->
      RsaPkcs1(digest, public_of(crypto::rsa_pkcs1_signing(document, digest), key)),
    RsaPssDocument(digest, document) ->
      RsaPss(digest, public_of(crypto::rsa_pss_signing(document, digest), key)),
    other -> other,
  }

fn point_key(curve: EcdsaCurve, point: Bytes) -> Option<crypto::VerifyingKey> =
  crypto::ecdsa_verifying(curve, crypto::curve_digest(curve), point, Raw)

fn public_of(signer: Option<crypto::SigningKey>, key: Key) -> Bytes / {jwt.fail} =
  match signer {
    Some(made) -> crypto::verifying_bytes(crypto::verifying_key(made)),
    None -> jwt.fail(NoKey(algorithm(key))),
  }

fn validated_key(key: Key) -> Key / {jwt.fail} =
  match key {
    HmacSha256(secret) -> if secret.len() < 32 { fail_short_key(secret) } else { key },
    HmacSha384(secret) -> if secret.len() < 48 { fail_short_key(secret) } else { key },
    HmacSha512(secret) -> if secret.len() < 64 { fail_short_key(secret) } else { key },
    Ed25519(public) -> if public.len() != 32 { wrong_key_length(public.len()) } else { key },
    Ed25519Seed(seed) -> if seed.len() != 32 { wrong_key_length(seed.len()) } else { key },
    Ecdsa(curve, point) -> if point_key(curve, point) == None { no_key(key) } else { key },
    EcdsaScalar(curve, scalar) -> if crypto::ecdsa_signing(curve, scalar, Raw) == None {
      no_key(key)
    } else { key },
    RsaPkcs1(_, public) -> rsa_usable(key, public),
    RsaPss(_, public) -> rsa_usable(key, public),
    RsaPkcs1Document(digest, document) -> if crypto::rsa_pkcs1_signing(document, digest) == None {
      no_key(key)
    } else { key },
    RsaPssDocument(digest, document) -> if crypto::rsa_pss_signing(document, digest) == None {
      no_key(key)
    } else { key },
  }

fn rsa_usable(key: Key, public: Bytes) -> Key / {jwt.fail} =
  match crypto::rsa_modulus_bits(public) {
    None -> no_key(key),
    Some(bits) -> if bits < 2048 { jwt.fail(SmallKey(bits)) }
    else if crypto::rsa_pkcs1_verifying(public, Sha256) == None { no_key(key) }
    else { key },
  }

fn fail_short_key<a>(secret: Secret<Bytes>) -> a / {jwt.fail} = jwt.fail(ShortKey(secret.len()))

fn wrong_key_length<a>(size: Int) -> a / {jwt.fail} = jwt.fail(KeyLength(size))

fn no_key<a>(key: Key) -> a / {jwt.fail} = jwt.fail(NoKey(algorithm(key)))

fn signature(key: Key, input: Bytes) -> Bytes / {jwt.fail, abort.raise} =
  match key {
    HmacSha256(secret) -> hmac_sha256(secret, input),
    HmacSha384(secret) -> hmac_sha384(secret, input),
    HmacSha512(secret) -> hmac_sha512(secret, input),
    Ed25519Seed(seed) -> ed25519::sign(seed, input),
    EcdsaScalar(curve, scalar) -> sign_with(crypto::ecdsa_signing(curve, scalar, Raw), key, input),
    RsaPkcs1Document(digest, document) ->
      sign_with(crypto::rsa_pkcs1_signing(document, digest), key, input),
    RsaPssDocument(digest, document) ->
      sign_with(crypto::rsa_pss_signing(document, digest), key, input),
    Ed25519(_) -> jwt.fail(CannotSign),
    Ecdsa(_, _) -> jwt.fail(CannotSign),
    RsaPkcs1(_, _) -> jwt.fail(CannotSign),
    RsaPss(_, _) -> jwt.fail(CannotSign),
  }

fn sign_with(
  signer: Option<crypto::SigningKey>,
  key: Key,
  input: Bytes,
) -> Bytes / {jwt.fail, abort.raise} =
  match signer { Some(made) -> crypto::sign(made, input), None -> no_key(key) }

fn signature_matches(key: Key, input: Bytes, signature: Bytes) -> Bool / {abort.raise} =
  match key {
    HmacSha256(secret) -> tags_match(hmac_sha256(secret, input), signature),
    HmacSha384(secret) -> tags_match(hmac_sha384(secret, input), signature),
    HmacSha512(secret) -> tags_match(hmac_sha512(secret, input), signature),
    Ed25519(public) -> ed25519::verify(public, input, signature),
    Ed25519Seed(seed) -> ed25519::verify(ed25519::public_key(seed), input, signature),
    Ecdsa(curve, point) -> verified_by(point_key(curve, point), input, signature),
    EcdsaScalar(curve, scalar) ->
      verified_by(verifier_of(crypto::ecdsa_signing(curve, scalar, Raw)), input, signature),
    RsaPkcs1(digest, public) ->
      verified_by(crypto::rsa_pkcs1_verifying(public, digest), input, signature),
    RsaPkcs1Document(digest, document) ->
      verified_by(verifier_of(crypto::rsa_pkcs1_signing(document, digest)), input, signature),
    RsaPss(digest, public) ->
      verified_by(crypto::rsa_pss_verifying(public, digest), input, signature),
    RsaPssDocument(digest, document) ->
      verified_by(verifier_of(crypto::rsa_pss_signing(document, digest)), input, signature),
  }

fn verifier_of(signer: Option<crypto::SigningKey>) -> Option<crypto::VerifyingKey> =
  match signer { Some(made) -> Some(crypto::verifying_key(made)), None -> None }

fn verified_by(key: Option<crypto::VerifyingKey>, input: Bytes, signature: Bytes) -> Bool =
  match key { Some(verifier) -> crypto::verify(verifier, input, signature), None -> false }

/// What a signer writes in a token's header besides `alg`, which comes from its key.
pub type HeaderParameters = new {
  /// `typ`: what kind of token this is, such as `JWT` or `at+jwt`, for a verifier that receives
  /// more than one kind.
  typ: Option<String>,
  /// `kid`: which of the signer's keys this is, for a verifier that has several.
  kid: Option<String>,
}

/// A token's header as it was read.
pub type Header = new {
  /// `alg`, as the token writes it.
  alg: String,
  /// `typ`, if it has one.
  typ: Option<String>,
  /// `kid`, if it has one.
  kid: Option<String>,
  /// Every member, including those above.
  members: Map<String, Json>,
}

/// A token's claims: the seven claims RFC 7519 registers, and every other claim by name.
pub type Claims = new {
  /// `iss`: who issued the token.
  issuer: Option<String>,
  /// `sub`: whom it is about.
  subject: Option<String>,
  /// `aud`: whom it is for. A single audience written as a string reads as a list of one, and no
  /// audience as an empty list.
  audience: List<String>,
  /// `exp`: the instant it stops being valid.
  expires: Option<Instant>,
  /// `nbf`: the instant it starts being valid.
  not_before: Option<Instant>,
  /// `iat`: when it was issued.
  issued_at: Option<Instant>,
  /// `jti`: an identifier the issuer gives to only one token, which a verifier that rejects
  /// reused tokens remembers.
  id: Option<String>,
  /// Every other member. It contains none of the seven names above.
  other: Map<String, Json>,
}

/// No claims at all, as a starting point for a record update.
pub fn claims() -> Claims =
  {
    issuer: None,
    subject: None,
    audience: [],
    expires: None,
    not_before: None,
    issued_at: None,
    id: None,
    other: Map::new(),
  }

/// What a verifier requires one claim, or the header's `typ`, to be.
pub type Expect =
  /// Nothing: the verifier does not check, and a token without the claim passes.
  | Any
  /// This string, as written. For `aud`, which may list several, this one must be among them.
  | Exactly(String)
  | OneOf(List<String>)

/// What a verifier requires of a token. It has no default: each field is written out.
pub type Policy = new {
  /// The longest token that is read, in bytes.
  max_bytes: Int,
  /// How much the issuer's clock and the verifier's clock may differ. `exp` and `nbf` are checked
  /// with this margin added to the token's validity: it expires later and becomes valid earlier by
  /// this amount. A value below zero counts as zero.
  leeway: Duration,
  /// Whether a token with no `exp` is rejected.
  must_expire: Bool,
  issuer: Expect,
  /// What `aud` must contain: the name of this verifier.
  audience: Expect,
  subject: Expect,
  /// What the header's `typ` must be, compared exactly: case and an `application/` prefix
  /// matter.
  typ: Expect,
}

/// Claims whose signature `verify` checked against the verifier's key, and which meet the
/// verifier's policy. Only `verify` creates one.
pub opaque type Verified = new { header: Header, claims: Claims }

/// A payload whose signature `verify_bytes` checked against the verifier's key. Only `verify_bytes`
/// creates one.
pub opaque type Signed = new { header: Header, payload: Bytes }

/// The header and claims of a token, read without checking the signature or any claim. Use it only
/// to choose a key, and never to decide whether to trust the token.
pub type Unverified = new { header: Header, claims: Claims }

/// Names the part of a token, or the key set, that an error is about.
pub type Part = | InHeader | InPayload | InSignature | InKeys

/// Why a token, a key or a signing was rejected.
pub type Error =
  /// The token or the key set is this many bytes, which is more than the `max_bytes` limit.
  | TooLong(Int)
  /// It is this many parts between dots, where a signed token is three.
  | Parts(Int)
  /// It is five parts: an encrypted token (JWE), which this module does not read.
  | Encrypted
  /// This part is not unpadded base64url as RFC 4648 §5 defines it. It contains a character outside
  /// the alphabet, such as padding or whitespace, or its last character has extra bits that do not
  /// belong to any byte.
  | Encoding(Part)
  /// This part is not a JSON object, or the object repeats a member name. The `DecodeError` gives
  /// the reason.
  | Malformed(Part, DecodeError)
  /// The header has no `alg`, or one that is not a string.
  | NoAlgorithm
  /// The header's `alg` is `none`, in any capitalization, so nobody signed the token.
  | Unsecured(String)
  /// The header's `alg`, or a key's type or curve, is this string, which JOSE defines but this
  /// module does not implement.
  | Unsupported(String)
  /// The header's `alg` is the first string, but the key is for the algorithm named by the second
  /// string.
  | WrongAlgorithm(String, String)
  /// The header's `crit` lists these: extensions a reader must understand to accept the token,
  /// and this module understands none.
  | Critical(List<String>)
  /// The header sets `b64` to false: a payload that is not base64url (RFC 7797).
  | Unencoded
  /// The signature is not the key's over this header and payload.
  | BadSignature
  /// An HMAC secret of this many bytes, fewer than its hash's digest.
  | ShortKey(Int)
  /// An Ed25519 key of this many bytes, where a public key and a seed are thirty-two.
  | KeyLength(Int)
  /// An RSA key whose modulus is this many bits, fewer than 2048.
  | SmallKey(Int)
  /// The key's bytes are not a valid key for the algorithm named by the string, for example a point
  /// off the curve, a scalar out of range, or bytes that are not an RSA key.
  | NoKey(String)
  /// A public key was asked to sign.
  | CannotSign
  /// This member is not of the type its definition gives it.
  | Mistyped(String)
  /// `other` contains this name, which belongs to a registered claim with a field of its own.
  | Reserved(String)
  /// The token expired at this instant, the leeway or more before now.
  | Expired(Instant)
  /// The token is not valid before this instant, more than the leeway after now.
  | NotYet(Instant)
  /// This member is required and absent.
  | Missing(String)
  /// This member has these values, which are not what was required.
  | Unexpected(String, List<String>)

/// The effect this module's functions raise when they reject their input.
pub effect jwt {
  /// A token, a key or a set of claims is not one the function accepts.
  raise fail(e: Error)
}

/// Describes an error in one sentence, for a log.
pub fn rejection_to_string(r: Error) -> String =
  match r {
    TooLong(size) -> "it is " ++ size.to_string() ++ " bytes, past the limit",
    Parts(count) ->
      "a signed token is three parts joined by dots, and this is " ++ count.to_string(),
    Encrypted -> "five parts are an encrypted token (JWE), which is not read here",
    Encoding(part) -> part_name(part) ++ " is not unpadded base64url",
    Malformed(part, e) ->
      part_name(part) ++ " is not a JSON object naming each member once: "
        ++ json::error_to_string(e),
    NoAlgorithm -> "the header names no `alg`",
    Unsecured(alg) -> "the header's `alg` is `" ++ alg ++ "`: nobody signed this token",
    Unsupported(name) ->
      "`" ++ name
        ++ "` is not implemented: this module has HS256, HS384, HS512, EdDSA over Ed25519, ES256, ES384, ES512, ES256K, RS256, RS384, RS512, PS256, PS384 and PS512",
    WrongAlgorithm(found, wanted) ->
      "the header's `alg` is `" ++ found ++ "` and the key is for `" ++ wanted ++ "`",
    Critical(names) ->
      "the header marks critical what is not understood here: " ++ String::join(names, ", "),
    Unencoded -> "the header sets `b64` false, and a payload that is not base64url is not read",
    BadSignature -> "the signature is not this key's over this header and payload",
    ShortKey(size) ->
      "an HMAC secret of " ++ size.to_string() ++ " bytes is shorter than its hash's digest",
    KeyLength(size) -> "an Ed25519 key is 32 bytes, and this is " ++ size.to_string(),
    SmallKey(bits) ->
      "an RSA key of " ++ bits.to_string() ++ " bits is under the 2048 a signature needs",
    NoKey(alg) -> "the key's bytes are no `" ++ alg ++ "` key",
    CannotSign -> "a public key signs nothing",
    Mistyped(name) -> "`" ++ name ++ "` is not of the type its definition gives it",
    Reserved(name) -> "`" ++ name ++ "` is a registered claim, which has a field of its own",
    Expired(at) -> "the token expired at " ++ seconds_text(at),
    NotYet(at) -> "the token is not valid before " ++ seconds_text(at),
    Missing(name) -> "`" ++ name ++ "` is required and absent",
    Unexpected(name, found) ->
      "`" ++ name ++ "` is " ++ String::join(found, ", ") ++ ", which is not what is required",
  }

fn part_name(part: Part) -> String =
  match part {
    InHeader -> "the header",
    InPayload -> "the payload",
    InSignature -> "the signature",
    InKeys -> "the key set",
  }

fn seconds_text(at: Instant) -> String =
  Int::to_string(nanos_at(at) / 1000000000) ++ " seconds from 1970-01-01T00:00:00Z"

/// Returns a token whose payload is `claims`, signed with `key`. The header contains the key's
/// `alg` and the `typ` and `kid` from `marks`. The same claims, key and marks always make the same
/// token: the header and payload are written without whitespace, with members in ascending order.
///
/// Raises when `key` cannot sign, as `sign_bytes` does, and when `claims.other` contains the name
/// of a registered claim.
pub fn sign(claims: Claims, key: Key, marks: HeaderParameters) -> String / {jwt.fail, abort.raise} =
  sign_bytes(json::to_bytes(claims_json(claims)), key, marks)

/// A token whose payload is `payload`, signed with `key`: the compact form of RFC 7515.
///
/// Raises for an HMAC secret shorter than its hash's digest, for a seed, a scalar or a document
/// that is not a valid key for its algorithm, and for a public key.
pub fn sign_bytes(
  payload: Bytes,
  key: Key,
  marks: HeaderParameters,
) -> String / {jwt.fail, abort.raise} = {
  let signer = validated_key(key);
  let header = json::to_bytes(header_json(algorithm(signer), marks));
  let input = base64url_encode(header) ++ "." ++ base64url_encode(payload);
  input ++ "." ++ base64url_encode(signature(signer, Bytes::of_string(input)))
}

fn header_json(alg: String, marks: HeaderParameters) -> Json =
  json::object(
    somes([
      text_member("alg", Some(alg)),
      text_member("typ", marks.typ),
      text_member("kid", marks.kid),
    ]),
  )

fn text_member(name: String, text: Option<String>) -> Option<Member> =
  text.map(|s: String| { key: name, value: Str(s) })

/// Returns the claims of `token` if `key` signed it and the claims meet `policy` at `now`.
///
/// Errors are checked in this order. The key is one `sign` would reject. The token is longer than
/// `policy.max_bytes`, is not three parts, or its header is not base64url of a JSON object with a
/// string `alg`. The `alg` is `none` or is not the key's, or the header sets `b64` to false or
/// lists anything in `crit`. The signature is not base64url, or is not the key's. The payload is
/// not base64url of a JSON object, or a registered claim in it has the wrong type. Then the
/// policy: `typ`; `exp`, which has passed once `now` is at or after `exp` plus the leeway; `nbf`,
/// which is still ahead while `now` is before `nbf` minus the leeway; `iss`; `aud`; and `sub`.
pub fn verify(
  token: String,
  key: Key,
  policy: Policy,
  now: Instant,
) -> Verified / {jwt.fail, abort.raise} = {
  let signed = verify_bytes(token, key, policy.max_bytes);
  let claims = claims_of_members(members_of(InPayload, signed.payload));
  check_policy(signed.header, claims, policy, now);
  { header: signed.header, claims: claims }
}

/// `verify`, returning its error as an `Err`.
pub fn try_verify(
  token: String,
  key: Key,
  policy: Policy,
  now: Instant,
) -> Result<Verified, Error> / {abort.raise} = try { verify(token, key, policy, now) }

/// Returns the payload of `token` if `key` signed it. It makes the same checks as `verify` up to
/// the signature, but does not read the payload as claims, so no claim is checked. `max_bytes` is
/// the longest token that is read.
pub fn verify_bytes(token: String, key: Key, max_bytes: Int) -> Signed / {jwt.fail, abort.raise} = {
  let verifier = validated_key(key);
  let parts = parts_of(token, max_bytes);
  let header = header_of(parts.header);
  check_header(header, verifier);
  let registered_members = decoded(InSignature, parts.signature);
  if !signature_matches(
      verifier,
      Bytes::of_string(parts.header ++ "." ++ parts.payload),
      registered_members,
    ) { jwt.fail(BadSignature) }
  else { { header: header, payload: decoded(InPayload, parts.payload) } }
}

/// What `token` states about itself, with nothing checked: not its signature, its `alg`, or any
/// claim. Use it to choose the key to verify the token with, by its `kid` or its issuer.
/// `max_bytes` is the longest token that is read.
pub fn peek(token: String, max_bytes: Int) -> Unverified / {jwt.fail, abort.raise} = {
  let parts = parts_of(token, max_bytes);
  let header = header_of(parts.header);
  {
    header: header,
    claims: claims_of_members(members_of(InPayload, decoded(InPayload, parts.payload))),
  }
}

type Parts = { header: String, payload: String, signature: String }

fn parts_of(token: String, max_bytes: Int) -> Parts / {jwt.fail} = {
  let size = Bytes::of_string(token).len();
  if size > max_bytes { jwt.fail(TooLong(size)) } else {
    match token.split(".") {
      [header, payload, signature] -> { header: header, payload: payload, signature: signature },
      parts -> if parts.len() == 5 { jwt.fail(Encrypted) } else { jwt.fail(Parts(parts.len())) },
    }
  }
}

fn decoded(part: Part, text: String) -> Bytes / {jwt.fail, abort.raise} =
  match base64url_decode(text) { Some(raw) -> raw, None -> jwt.fail(Encoding(part)) }

fn members_of(part: Part, raw: Bytes) -> Map<String, Json> / {jwt.fail, abort.raise} =
  match json::parse_unique(raw) {
    Ok(Object(members)) -> members,
    Ok(other) -> jwt.fail(Malformed(part, json::expected("an object", other))),
    Err(e) -> jwt.fail(Malformed(part, e)),
  }

fn header_of(text: String) -> Header / {jwt.fail, abort.raise} = {
  let members = members_of(InHeader, decoded(InHeader, text));
  match members.get("alg") {
    Some(Str(alg)) ->
      { alg: alg, typ: text_of(members, "typ"), kid: text_of(members, "kid"), members: members },
    _ -> jwt.fail(NoAlgorithm),
  }
}

fn check_header(header: Header, key: Key) -> Unit / {jwt.fail} =
  if is_none_algorithm(header.alg) { jwt.fail(Unsecured(header.alg)) }
  else if header.alg != algorithm(key) { jwt.fail(WrongAlgorithm(header.alg, algorithm(key))) }
  else if header.members.get("b64") == Some(json::Bool(false)) { jwt.fail(Unencoded) } else {
    match header.members.get("crit") {
      Some(listed) -> jwt.fail(Critical(strings_in(listed))),
      None -> (),
    }
  }

fn is_none_algorithm(alg: String) -> Bool =
  alg.chars().map(|c: Char| Int::of_char(c) | 0x20) == [110, 111, 110, 101]

fn strings_in(j: Json) -> List<String> =
  match j {
    Array(items) -> somes(items.map(|item: Json| match item { Str(s) -> Some(s), _ -> None })),
    _ -> [],
  }

fn registered() -> List<String> = ["iss", "sub", "aud", "exp", "nbf", "iat", "jti"]

/// Returns the claims object for `c`: each registered claim that is set, a single audience as a
/// string, each time as a NumericDate, and the members of `c.other`. Raises `Reserved` when
/// `c.other` contains the name of a registered claim, since that claim would be written twice.
pub fn claims_json(c: Claims) -> Json / {jwt.fail, abort.raise} =
  match registered().find(|name: String| c.other.contains(name)) {
    Some(name) -> jwt.fail(Reserved(name)),
    None ->
      Object(
        registered_members(c).fold(c.other, |members: Map<String, Json>, m: Member|
          members.insert(m.key, m.value)),
      ),
  }

/// Reads the claims of a JSON object. Raises `Malformed` for a value that is not an object, and
/// `Mistyped` for a registered claim of the wrong type: `iss`, `sub` and `jti` are strings, `aud`
/// is a string or an array of strings, and `exp`, `nbf` and `iat` are numbers.
///
/// A time with more precision than a nanosecond is rounded to a nanosecond so that rounding never
/// makes a token valid for longer: `exp` and `iat` round down to the earlier nanosecond, and `nbf`
/// rounds up to the later one. A time too large or too small for an `Instant`, such as the `exp` of
/// a token that never expires, becomes the last or the first instant.
pub fn claims_of_json(j: Json) -> Claims / {jwt.fail, abort.raise} =
  match j {
    Object(members) -> claims_of_members(members),
    other -> jwt.fail(Malformed(InPayload, json::expected("an object", other))),
  }

/// Reads the claim `name` in `c.other` with `codec`. Returns an `Err` if there is no such claim
/// or the codec cannot read it. To read all of `c.other` as one record, decode `Object(c.other)`
/// with the record's codec.
pub fn claim<a>(
  c: Claims,
  name: String,
  codec: JsonCodec<a>,
) -> Result<a, DecodeError> / {abort.raise} = json::field(Object(c.other), name, codec)

fn registered_members(c: Claims) -> List<Member> / {abort.raise} =
  somes([
    text_member("iss", c.issuer),
    text_member("sub", c.subject),
    audience_member(c.audience),
    time_member("exp", c.expires),
    time_member("nbf", c.not_before),
    time_member("iat", c.issued_at),
    text_member("jti", c.id),
  ])

fn audience_member(audience: List<String>) -> Option<Member> =
  match audience {
    [] -> None,
    [one] -> Some({ key: "aud", value: Str(one) }),
    several -> Some({ key: "aud", value: json::strings(several) }),
  }

fn time_member(name: String, at: Option<Instant>) -> Option<Member> / {abort.raise} =
  at.map(|t: Instant| { key: name, value: numeric_date(t) })

fn numeric_date(at: Instant) -> Json / {abort.raise} =
  Number(Decimal::of_int(nanos_at(at)).div(1000000000m, 9, Down).normalize())

fn claims_of_members(members: Map<String, Json>) -> Claims / {jwt.fail, abort.raise} =
  {
    issuer: text_of(members, "iss"),
    subject: text_of(members, "sub"),
    audience: audience_of(members),
    expires: time_of(members, "exp", Floor),
    not_before: time_of(members, "nbf", Ceiling),
    issued_at: time_of(members, "iat", Floor),
    id: text_of(members, "jti"),
    other: registered().fold(members, |rest: Map<String, Json>, name: String| rest.remove(name)),
  }

fn text_of(members: Map<String, Json>, name: String) -> Option<String> / {jwt.fail} =
  match members.get(name) {
    None -> None,
    Some(Str(text)) -> Some(text),
    Some(_) -> jwt.fail(Mistyped(name)),
  }

fn audience_of(members: Map<String, Json>) -> List<String> / {jwt.fail} =
  match members.get("aud") {
    None -> [],
    Some(Str(one)) -> [one],
    Some(Array(items)) ->
      items.map(|item: Json| match item { Str(s) -> s, _ -> jwt.fail(Mistyped("aud")) }),
    Some(_) -> jwt.fail(Mistyped("aud")),
  }

fn time_of(
  members: Map<String, Json>,
  name: String,
  toward: Rounding,
) -> Option<Instant> / {jwt.fail, abort.raise} =
  match members.get(name) {
    None -> None,
    Some(Number(seconds)) -> Some(instant_of(seconds, toward)),
    Some(_) -> jwt.fail(Mistyped(name)),
  }

fn instant_of(seconds: Decimal, toward: Rounding) -> Instant / {abort.raise} =
  if seconds >= 9223372037m { Instant(max_int()) }
  else if seconds <= -9223372037m { Instant(min_int()) } else {
    match Int::of_decimal(seconds.round(9, toward) * 1000000000m, toward) {
      Some(nanos) -> Instant(nanos),
      None -> Instant(if seconds > 0m { max_int() } else { min_int() }),
    }
  }

fn check_policy(header: Header, c: Claims, policy: Policy, now: Instant) -> Unit / {jwt.fail} = {
  require_claim("typ", policy.typ, listed(header.typ));
  in_time(c, policy, now);
  require_claim("iss", policy.issuer, listed(c.issuer));
  require_claim("aud", policy.audience, c.audience);
  require_claim("sub", policy.subject, listed(c.subject))
}

fn in_time(c: Claims, policy: Policy, now: Instant) -> Unit / {jwt.fail} = {
  let leeway = max(as_nanos(policy.leeway), 0);
  let at = nanos_at(now);
  match c.expires {
    Some(expires) -> if at >= nanos_at(expires) +| leeway { jwt.fail(Expired(expires)) },
    None -> if policy.must_expire { jwt.fail(Missing("exp")) },
  };
  match c.not_before {
    Some(start) -> if at < nanos_at(start) -| leeway { jwt.fail(NotYet(start)) },
    None -> (),
  }
}

fn require_claim(name: String, expect: Expect, found: List<String>) -> Unit / {jwt.fail} =
  if satisfies(expect, found) { () }
  else if found.len() == 0 { jwt.fail(Missing(name)) }
  else { jwt.fail(Unexpected(name, found)) }

fn satisfies(expect: Expect, found: List<String>) -> Bool =
  match expect {
    Any -> true,
    Exactly(wanted) -> found.contains(wanted),
    OneOf(wanted) -> found.any(|value: String| wanted.contains(value)),
  }

fn listed(text: Option<String>) -> List<String> = match text { Some(t) -> [t], None -> [] }

/// A key as a JSON Web Key (RFC 7517) describes it, with the `kid` its set identifies it by.
pub type Jwk = new { kid: Option<String>, key: Key }

/// Reads the key that a JWK describes. The supported keys are: - `oct`: a shared secret whose `alg`
/// is `HS256`, `HS384` or `HS512`. - `OKP` on `Ed25519`: a public key, or a private seed when `d`
/// is present. - `EC` on `P-256`, `P-384`, `P-521` or `secp256k1`: a public point, or a private
/// scalar when `d` is present. - `RSA` whose `alg` is one of the six RSA algorithms: a public key,
/// or a private key when `d` is present.
///
/// An `oct` or `RSA` key with no `alg` is rejected as `Missing`, because a `Key` includes its
/// algorithm and the key bytes do not say which one. To use such a key, build a `Key` directly with
/// the constructor for the algorithm you intend. A private `RSA` key without its primes is also
/// rejected as `Missing`.
///
/// Raises `Unsupported` for any other `kty`, curve or `alg`. Raises `Unexpected` for a `use` other
/// than `sig`, and for a `d` that is not the private key for the public key `x`. Raises `SmallKey`
/// for an RSA modulus under 2048 bits. Raises `NoKey` for a point that is not on its curve, and for
/// private RSA numbers that do not match the public modulus `n` and exponent `e`. Raises `Mistyped`
/// for a member of the wrong type or one that is not base64url.
pub fn jwk(j: Json) -> Jwk / {jwt.fail, abort.raise} =
  match j {
    Object(members) -> {
      check_optional_member("use", text_of(members, "use"), "sig");
      let alg = text_of(members, "alg");
      let key = match required_text(members, "kty") {
        "oct" -> shared_key(alg, secret_octets(members, "k")),
        "OKP" -> edwards_key(members, alg),
        "EC" -> curve_key(members, alg),
        "RSA" -> rsa_key(members, alg),
        kind -> jwt.fail(Unsupported(kind)),
      };
      { kid: text_of(members, "kid"), key: validated_key(key) }
    },
    other -> jwt.fail(Malformed(InKeys, json::expected("an object", other))),
  }

/// Reads the keys of a JWK Set that this module can use, in the set's order. A key that `jwk`
/// would reject is skipped, as RFC 7517 §5 asks, so a set that also contains an encryption key
/// reads as its other keys. Raises for a text longer than `max_bytes`, or one that is not a JSON
/// object with an array `keys`.
pub fn jwks(source: Bytes, max_bytes: Int) -> List<Jwk> / {jwt.fail, abort.raise} =
  if source.len() > max_bytes { jwt.fail(TooLong(source.len())) } else {
    match members_of(InKeys, source).get("keys") {
      Some(Array(items)) -> somes(items.map(|item: Json| usable_jwk(item))),
      Some(_) -> jwt.fail(Mistyped("keys")),
      None -> jwt.fail(Missing("keys")),
    }
  }

fn usable_jwk(j: Json) -> Option<Jwk> / {abort.raise} =
  match try { jwk(j) } { Ok(k) -> Some(k), Err(_) -> None }

/// Returns the key in `keys` that can verify a token with this `header`: the key whose algorithm
/// equals `header.alg` and, if the header has a `kid`, whose `kid` equals it. A key's algorithm was
/// fixed when the JWK was read, from its `kty`, curve and `alg`. Returns `None` if no key matches
/// or more than one does.
pub fn key_for(keys: List<Jwk>, header: Header) -> Option<Key> =
  match keys.filter(|k: Jwk|
      algorithm(k.key) == header.alg && (header.kid == None || k.kid == header.kid)) {
    [only] -> Some(only.key),
    _ -> None,
  }

fn required_text(members: Map<String, Json>, name: String) -> String / {jwt.fail} =
  match text_of(members, name) { Some(text) -> text, None -> jwt.fail(Missing(name)) }

fn octets(members: Map<String, Json>, name: String) -> Bytes / {jwt.fail, abort.raise} =
  match base64url_decode(required_text(members, name)) {
    Some(raw) -> raw,
    None -> jwt.fail(Mistyped(name)),
  }

fn secret_octets(
  members: Map<String, Json>,
  name: String,
) -> Secret<Bytes> / {jwt.fail, abort.raise} =
  match base64url_decode_secret(Secret::of_string(required_text(members, name))) {
    Some(raw) -> raw,
    None -> jwt.fail(Mistyped(name)),
  }

fn shared_key(alg: Option<String>, secret: Secret<Bytes>) -> Key / {jwt.fail} =
  match alg {
    Some("HS256") -> HmacSha256(secret),
    Some("HS384") -> HmacSha384(secret),
    Some("HS512") -> HmacSha512(secret),
    Some(other) -> jwt.fail(Unsupported(other)),
    None -> jwt.fail(Missing("alg")),
  }

fn edwards_key(members: Map<String, Json>, alg: Option<String>) -> Key / {jwt.fail, abort.raise} = {
  check_optional_member("alg", alg, "EdDSA");
  let curve = required_text(members, "crv");
  if curve != "Ed25519" { jwt.fail(Unsupported(curve)) } else {
    let public = validated_key(Ed25519(octets(members, "x")));
    if !members.contains("d") { public } else {
      let seed = validated_key(Ed25519Seed(secret_octets(members, "d")));
      if verification_key(seed) == public { seed }
      else { jwt.fail(Unexpected("x", [required_text(members, "x")])) }
    }
  }
}

fn jwk_curve(name: String) -> Option<EcdsaCurve> =
  match name {
    "P-256" -> Some(crypto::NistP256),
    "P-384" -> Some(crypto::NistP384),
    "P-521" -> Some(crypto::NistP521),
    "secp256k1" -> Some(crypto::Secp256k1),
    _ -> None,
  }

fn curve_key(members: Map<String, Json>, alg: Option<String>) -> Key / {jwt.fail, abort.raise} = {
  let named = required_text(members, "crv");
  match jwk_curve(named) {
    None -> jwt.fail(Unsupported(named)),
    Some(curve) -> {
      check_optional_member("alg", alg, curve_algorithm(curve));
      let size = crypto::scalar_size(curve);
      let x = octets(members, "x");
      let y = octets(members, "y");
      let public = if x.len() != size || y.len() != size { jwt.fail(NoKey(curve_algorithm(curve))) }
      else { validated_key(Ecdsa(curve, Bytes::concat_all([b"\x04", x, y]))) };
      if !members.contains("d") { public } else {
        let scalar = validated_key(EcdsaScalar(curve, secret_octets(members, "d")));
        if verification_key(scalar) == public { scalar }
        else { jwt.fail(Unexpected("x", [required_text(members, "x")])) }
      }
    },
  }
}

fn secret_text(members: Map<String, Json>, name: String) -> Secret<String> / {jwt.fail} =
  Secret::of_string(required_text(members, name))

fn rsa_key(members: Map<String, Json>, alg: Option<String>) -> Key / {jwt.fail, abort.raise} = {
  let n = octets(members, "n");
  let e = octets(members, "e");
  let public = match crypto::public_of_jwk(crypto::Rsa(n, e)) {
    Some(crypto::RsaPublic(document)) -> document,
    _ -> jwt.fail(NoKey("RSA")),
  };
  let private = if !members.contains("d") { None } else {
    let numbers = {
      d: secret_text(members, "d"),
      p: secret_text(members, "p"),
      q: secret_text(members, "q"),
      dp: secret_text(members, "dp"),
      dq: secret_text(members, "dq"),
      qi: secret_text(members, "qi"),
    };
    match crypto::rsa_private_of_jwk(n, e, numbers) {
      Some(crypto::RsaPrivate(document)) -> Some(document),
      _ -> jwt.fail(NoKey(match alg { Some(named) -> named, None -> "RSA" })),
    }
  };
  match ((alg, private)) {
    (Some("RS256"), None) -> RsaPkcs1(Sha256, public),
    (Some("RS384"), None) -> RsaPkcs1(Sha384, public),
    (Some("RS512"), None) -> RsaPkcs1(Sha512, public),
    (Some("PS256"), None) -> RsaPss(Sha256, public),
    (Some("PS384"), None) -> RsaPss(Sha384, public),
    (Some("PS512"), None) -> RsaPss(Sha512, public),
    (Some("RS256"), Some(document)) -> RsaPkcs1Document(Sha256, document),
    (Some("RS384"), Some(document)) -> RsaPkcs1Document(Sha384, document),
    (Some("RS512"), Some(document)) -> RsaPkcs1Document(Sha512, document),
    (Some("PS256"), Some(document)) -> RsaPssDocument(Sha256, document),
    (Some("PS384"), Some(document)) -> RsaPssDocument(Sha384, document),
    (Some("PS512"), Some(document)) -> RsaPssDocument(Sha512, document),
    (Some(other), _) -> jwt.fail(Unsupported(other)),
    (None, _) -> jwt.fail(Missing("alg")),
  }
}

fn check_optional_member(
  name: String,
  registered_members: Option<String>,
  wanted: String,
) -> Unit / {jwt.fail} =
  match registered_members {
    Some(value) -> if value != wanted { jwt.fail(Unexpected(name, [value])) },
    None -> (),
  }

fn decode_base64url(text: String) -> Bytes / {abort.raise} = base64url_decode(text).expect(text)

type Stated =
  | Shared(Int, Bytes)
  | Seed(Bytes)
  | Edwards(Bytes)
  | Scalar(EcdsaCurve, Bytes)
  | Point(EcdsaCurve, Bytes)
  | Document(Digest, Bytes)
  | Pkcs1(Digest, Bytes)
  | Pss(Digest, Bytes)
  | PssDocument(Digest, Bytes)

fn stated_keys() -> Gen<Stated> =
  gen::and_then(gen::below(5), |kind: Int|
    if kind < 3 {
      gen::and_then(gen::below(17), |more: Int|
        gen::map(gen::bytes_of(32 + 16 * kind + more), |secret: Bytes|
          Shared(256 + 128 * kind, secret)))
    } else {
      gen::map(gen::bytes_of(32), |material: Bytes|
        if kind == 3 { Seed(material) }
        else if crypto::ecdsa_signing(crypto::NistP256, Secret::of_bytes(material), Raw) != None {
          Scalar(crypto::NistP256, material)
        } else { Scalar(crypto::NistP256, scalar_one()) })
    })

fn scalar_one() -> Bytes =
  b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01"

fn key_of(registered_members: Stated) -> Key =
  match registered_members {
    Shared(256, secret) -> HmacSha256(Secret::of_bytes(secret)),
    Shared(384, secret) -> HmacSha384(Secret::of_bytes(secret)),
    Shared(_, secret) -> HmacSha512(Secret::of_bytes(secret)),
    Seed(seed) -> Ed25519Seed(Secret::of_bytes(seed)),
    Edwards(public) -> Ed25519(public),
    Scalar(curve, scalar) -> EcdsaScalar(curve, Secret::of_bytes(scalar)),
    Point(curve, point) -> Ecdsa(curve, point),
    Document(digest, document) -> RsaPkcs1Document(digest, Secret::of_bytes(document)),
    Pkcs1(digest, public) -> RsaPkcs1(digest, public),
    Pss(digest, public) -> RsaPss(digest, public),
    PssDocument(digest, document) -> RsaPssDocument(digest, Secret::of_bytes(document)),
  }

fn b64(text: String) -> String / {abort.raise} = base64url_encode(Bytes::of_string(text))

fn at_second(secs: Int) -> Instant = after(Instant(0), seconds(secs))

fn counting(n: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(range(0, n).map(|i: Int| byte_of_int(i)))

fn lax() -> Policy =
  {
    max_bytes: 4096,
    leeway: seconds(0),
    must_expire: false,
    issuer: Any,
    audience: Any,
    subject: Any,
    typ: Any,
  }

fn as_jwt() -> HeaderParameters = { typ: Some("JWT"), kid: None }

fn unmarked() -> HeaderParameters = { typ: None, kid: None }

fn forged(header: String, payload: String, key: Key) -> String / {jwt.fail, abort.raise} =
  sign_input(b64(header) ++ "." ++ b64(payload), key)

fn sign_input(input: String, key: Key) -> String / {jwt.fail, abort.raise} =
  input ++ "." ++ base64url_encode(signature(key, Bytes::of_string(input)))

fn rfc_stated() -> Stated / {abort.raise} =
  Shared(
    256,
    decode_base64url(
      "AyM1SysPpbyDfgZld3umj1qzKObwVMkoqQ-EstJQLr_T-1qS0gZH75aKtMN3Yj0iPS4hcgUuTwjAzZr1Z9CAow",
    ),
  )

fn rfc_key() -> Key / {abort.raise} = key_of(rfc_stated())

fn rfc_claims_part() -> String =
  "eyJpc3MiOiJqb2UiLA0KICJleHAiOjEzMDA4MTkzODAsDQogImh0dHA6Ly9leGFtcGxlLmNvbS9pc19yb290Ijp0cnVlfQ"

fn rfc_token() -> String =
  "eyJ0eXAiOiJKV1QiLA0KICJhbGciOiJIUzI1NiJ9." ++ rfc_claims_part()
    ++ ".dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"

test "RFC 7519's example token verifies under its key, and its claims are the RFC's" {
  let v = verify(rfc_token(), rfc_key(), lax(), at_second(1300819379));
  assert_eq(v.header.alg, "HS256");
  assert_eq(v.header.typ, Some("JWT"));
  assert_eq(v.header.kid, None);
  assert_eq(v.claims, {
    ..claims(),
    issuer: Some("joe"),
    expires: Some(at_second(1300819380)),
    other: #{"http://example.com/is_root": json::Bool(true)},
  });
  assert_eq(
    try_verify(rfc_token(), rfc_key(), lax(), at_second(1300819380)),
    Err(Expired(at_second(1300819380))),
  )
}

fn rfc_seed() -> Bytes / {abort.raise} =
  decode_base64url("nWGxne_9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A")

fn rfc_public() -> Bytes / {abort.raise} =
