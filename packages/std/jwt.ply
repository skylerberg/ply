test "{c.alg}: `verify_bytes` accepts a token signed elsewhere, a key read from a JWK signs a token its public key verifies, and a changed payload fails with `BadSignature`" for c: ExternalCurveToken in curved(
  ) {
  let point = Bytes::concat_all([b"\x04", decode_base64url(c.x), decode_base64url(c.y)]);
  let public = key_of(Point(c.curve, point));
  assert_eq(algorithm(public), c.alg);
  assert_eq(verify_bytes(c.token, public, 4096).payload, b"Payload");
  let read = jwk(
    document(
      "{\"kty\":\"EC\",\"alg\":\"" ++ c.alg ++ "\",\"crv\":\"" ++ c.crv ++ "\",\"x\":\"" ++ c.x
        ++ "\",\"y\":\""
        ++ c.y
        ++ "\",\"d\":\""
        ++ c.d
        ++ "\"}",
    ),
  );
  assert_eq(verification_key(read.key), public);
  let ours = sign_bytes(b"Payload", read.key, unmarked());
  assert_eq(ours, sign_bytes(b"Payload", read.key, unmarked()));
  assert_eq(verify_bytes(ours, public, 4096).payload, b"Payload");
  assert_eq(
    ours.split(".").at(2).map(|part: String| decode_base64url(part).len()),
    Some(2 * crypto::scalar_size(c.curve)),
  );
  let parts = ours.split(".");
  let turned = parts.at(0).expect("a header") ++ "." ++ base64url_encode(b"Payloae") ++ "."
    ++ parts.at(2).expect("a signature");
  assert_eq(try { verify_bytes(turned, public, 4096) }, Err(BadSignature))
}

