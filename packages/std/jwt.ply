test "a JWK holding RFC 7515's RSA private key parses into the matching RSA key, and signs the RFC's token" {
  let read = jwk(document(rsa_private_jwk("RS256")));
  assert_eq(read.key, RsaPkcs1Document(Sha256, Secret::of_bytes(rsa_document())));
  assert_eq(sign_bytes(rfc_payload(), read.key, unmarked()), rsa_token());
  assert_eq(verification_key(read.key), RsaPkcs1(Sha256, rsa_public()));
  let pss = jwk(document(rsa_private_jwk("PS384")));
  assert_eq(pss.key, RsaPssDocument(Sha384, Secret::of_bytes(rsa_document())))
}

test "`verify_bytes` accepts the published token of {c.name} under its public key and returns the expected payload and algorithm" for c: Published in published(
  ) {
  let signed = verify_bytes(c.token, key_of(c.key), 4096);
  assert_eq(signed.payload, c.payload);
  assert_eq(signed.header.alg, c.alg)
}

test "signing with RFC 7515's RSA key produces the RFC's token, and the matching public key verifies it" {
  let signer = RsaPkcs1Document(Sha256, Secret::of_bytes(rsa_document()));
  assert_eq(sign_bytes(rfc_payload(), signer, unmarked()), rsa_token());
  assert_eq(verification_key(signer), RsaPkcs1(Sha256, rsa_public()));
  assert_eq(verify_bytes(rsa_token(), signer, 4096).payload, rfc_payload());
  assert_eq(
    try { verify_bytes(rsa_token(), RsaPkcs1(Sha384, rsa_public()), 4096) },
    Err(WrongAlgorithm("RS256", "RS384")),
  );
  assert_eq(try { sign_bytes(b"x", RsaPkcs1(Sha256, rsa_public()), unmarked()) }, Err(CannotSign))
}

