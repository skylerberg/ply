test "signing with RFC 8037's Ed25519 seed produces the RFC's example token, and a public key cannot sign" {
  assert_eq(
    sign_bytes(
      b"Example of Ed25519 signing",
      Ed25519Seed(Secret::of_bytes(rfc_seed())),
      unmarked(),
    ),
    rfc_edwards_token(),
  );
  let signing_result = try { sign_bytes(b"x", Ed25519(rfc_public()), unmarked()) };
  assert_eq(signing_result, Err(CannotSign))
}

