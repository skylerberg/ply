//! The signals sent to a program, as an effect.
//!
//! `stopping` and `deadline_ms` report whether a stop has been requested by `SIGINT` or `SIGTERM`,
//! and how much time the service's drain has left.
//!
//! `hangup`, `user1`, `user2` and `resized` each return whether their signal (`SIGHUP`, `SIGUSR1`,
//! `SIGUSR2` or `SIGWINCH`) has arrived since the previous check. Arrivals are not counted: two
//! hangups between checks give one `true`. The first check installs the signal handler and returns
//! `false`. Before that check, the platform's default applies, and for `SIGHUP`, `SIGUSR1` and
//! `SIGUSR2` the default ends the process. A program that reloads on a hangup should therefore
//! check once at startup. No code runs inside the handler, so a program sees a signal only when it
//! checks. To notice a hangup within a second, check once a second.
//!
//! `ply run` listens for a stop when the root of the program performs `signal` or accepts
//! connections. When a stop arrives, the drain closes those connections. If the root starts a child
//! process, `ply run` ends the children and exits immediately on `INT` or `TERM`. For any other
//! program the platform ends it immediately. A run that does not listen for a stop, such as a test,
//! never sees a stop or any signal: each check returns `false`, no handler is installed, and the
//! platform's default behavior applies to the whole process.
//!
//! In a test, a `Stop` handles the stop operations and `Arrivals` handles the other signals.
//! `run_scripted` handles all six operations from the pair. A signal is `std.process`'s `Signal`,
//! the same type a program uses to signal a child, so a test scripts arrivals with the values a
//! supervisor sends.

import std.internal.native (native)
import std.list
import std.process (Signal, Hangup, User1, User2, WindowChange)

/// The host's request to stop, and the signals a program checks for.
pub nondet effect signal {
  /// Whether a stop has been requested.
  read stopping() -> Bool
  /// The milliseconds the drain has left, or `-1` while no stop has been requested.
  read deadline_ms() -> Int
  /// Whether a `SIGHUP` has arrived since the last check. Daemons take it as a request to read
  /// their configuration again. It is a write rather than a read because the check consumes the
  /// arrival.
  write hangup() -> Bool
  /// Whether a `SIGUSR1` has arrived since the last check.
  write user1() -> Bool
  /// Whether a `SIGUSR2` has arrived since the last check.
  write user2() -> Bool
  /// Whether a `SIGWINCH` has arrived since the last check, meaning the terminal changed size.
  /// `std.term`'s `size` returns the new size.
  write resized() -> Bool
}

host for signal by host_handler

fn host_handler<a | e>(go: () -> a / {signal.read, signal.write | e}) -> a / {native.read | e} =
  handle {
    go()
  } with {
    signal.stopping() -> signal_stopping(),
    signal.deadline_ms() -> signal_deadline_ms(),
    signal.hangup() -> signal_arrived(0),
    signal.user1() -> signal_arrived(1),
    signal.user2() -> signal_arrived(2),
    signal.resized() -> signal_arrived(3),
  }

extern fn signal_stopping() -> Bool / {native.read}

extern fn signal_deadline_ms() -> Int / {native.read}

extern fn signal_arrived(which: Int) -> Bool / {native.read}

/// The stop state a test passes to `stopping_step` and `stop_deadline_ms` in place of the host.
pub type Stop = { stopping: Bool, deadline_ms: Int }

/// A service with no stop requested.
pub fn running() -> Stop = { stopping: false, deadline_ms: -1 }

/// A service whose stop was requested, with `ms` milliseconds of drain left.
pub fn stopping_within(ms: Int) -> Stop = { stopping: true, deadline_ms: ms }

/// What `signal.stopping` returns for `s`.
pub fn stopping_step(s: Stop) -> Bool = s.stopping

/// What `signal.deadline_ms` returns for `s`.
pub fn stop_deadline_ms(s: Stop) -> Int = s.deadline_ms

/// Whether there is time to start work that needs `ms` milliseconds.
pub fn has_time_for(s: Stop, ms: Int) -> Bool = if s.stopping { s.deadline_ms >= ms } else { true }

/// The signals a test supplies to the four signal checks in place of the host. `arrived` lists the
/// signals that have arrived and not yet been checked. `pending_batches` lists the batches that
/// have not arrived yet, one arriving just before each check. The checks cover `Hangup`, `User1`,
/// `User2` and `WindowChange`. Any other signal in a script stays in `arrived` forever, because no
/// check removes it.
pub type Arrivals = { arrived: List<Signal>, pending_batches: List<List<Signal>> }

/// A fake whose batches arrive in order, one just before each check, with nothing after the last.
pub fn arrivals(script: List<List<Signal>>) -> Arrivals = { arrived: [], pending_batches: script }

/// Returns `a` with `which` added to the arrived signals. Does nothing if `which` has already
/// arrived and not been checked.
pub fn delivered(a: Arrivals, which: Signal) -> Arrivals =
  { ..a, arrived: a.arrived.push_unique(which) }

/// The result of one check, and the fake with the arrival consumed.
pub type PollResult = { arrivals: Arrivals, arrived: Bool }

/// Performs one check for `which` on `a`. First the next pending batch, if any, arrives, just
/// before the check. The result says whether `which` is among the arrived signals, and removes it
/// from them if so.
pub fn poll_step(a: Arrivals, which: Signal) -> PollResult = {
  let now = match a.pending_batches {
    [] -> a,
    [batch, ..rest] -> { arrived: batch.fold(a.arrived, List::push_unique), pending_batches: rest },
  };
  match now.arrived.remove_first(which) {
    Some(left) -> { arrivals: { ..now, arrived: left }, arrived: true },
    None -> { arrivals: now, arrived: false },
  }
}

/// What `go` returned with a fake, and the arrivals left when it finished.
pub type FakeRun<a> = { value: a, arrivals: Arrivals }

/// Runs `go`, handling every operation from `stop` and `a`.
pub fn run_scripted<a | e>(
  stop: Stop,
  a: Arrivals,
  go: () -> a / {signal.read, signal.write | e},
) -> FakeRun<a> / e =
  handle {
    go()
  } with {
    var fake = a,
    signal.stopping() -> stopping_step(stop),
    signal.deadline_ms() -> stop_deadline_ms(stop),
    signal.hangup() -> {
      let poll = poll_step(fake, Hangup);
      fake = poll.arrivals;
      poll.arrived
    },
    signal.user1() -> {
      let poll = poll_step(fake, User1);
      fake = poll.arrivals;
      poll.arrived
    },
    signal.user2() -> {
      let poll = poll_step(fake, User2);
      fake = poll.arrivals;
      poll.arrived
    },
    signal.resized() -> {
      let poll = poll_step(fake, WindowChange);
      fake = poll.arrivals;
      poll.arrived
    },
    return value -> { value: value, arrivals: fake },
  }

test "`has_time_for` is true for any duration while running, and while stopping only if the duration is shorter than the time left before the stop deadline" {
  assert(has_time_for(running(), 60000));
  assert(has_time_for(stopping_within(400), 100));
  assert(!has_time_for(stopping_within(400), 900))
}

test "`signal.stopping()` and `signal.deadline_ms()` can be handled with fixed values, so code that reads them gives the same result every run" {
  handle {
    assert(signal.stopping());
    assert_eq(signal.deadline_ms(), 250)
  } with {
    signal.stopping() -> stopping_step(stopping_within(250)),
    signal.deadline_ms() -> stop_deadline_ms(stopping_within(250)),
  }
}

fn serve(turns: Int) -> List<Int> / {signal.hangup, signal.stopping} =
  range(0, turns).fold([], |reloads: List<Int>, turn: Int|
    if signal.stopping() { reloads }
    else if signal.hangup() { reloads.push(turn) }
    else { reloads })

test "a hangup is seen once, by the next check, and two hangups before one check count as one" {
  let ran = run_scripted(running(), arrivals([[], [Hangup], [], [Hangup, Hangup], []]), ||
    serve(6));
  assert_eq(ran.value, [1, 3]);
  assert_eq(ran.arrivals, arrivals([]))
}

test "a check consumes its own signal and leaves the others waiting" {
  let waiting = delivered(delivered(delivered(arrivals([]), User1), WindowChange), User1);
  assert_eq(waiting.arrived, [User1, WindowChange]);
  let first = poll_step(waiting, Hangup);
  assert(!first.arrived);
  let second = poll_step(first.arrivals, WindowChange);
  assert(second.arrived);
  assert_eq(second.arrivals.arrived, [User1]);
  assert(!poll_step(second.arrivals, WindowChange).arrived);
  assert(poll_step(second.arrivals, User1).arrived)
}

test "`signal.user1()`, `user2()`, `resized()` and `hangup()` each check only their own signal, and `signal.stopping()` is true once a stop is scheduled" {
  let ran = run_scripted(stopping_within(100), arrivals([[User1, User2, WindowChange]]), ||
    [signal.user1(), signal.user2(), signal.resized(), signal.hangup(), signal.stopping()]);
  assert_eq(ran.value, [true, true, true, false, true])
}
