//! The `datetime"2026-10-04T12:30:00"` literal: a `std.date` date-time with no time zone, whose
//! text is validated when the program is checked.
//!
//! A literal's tag names a module, and `std.date`'s tag already reads a date, so date-times need
//! this module of their own. The type and its operations are in `std.date`.

import std.date (DateTime, Error, date_time, date_time_literal)
import std.result

/// Validates the text of a `datetime"..."` literal.
///
/// Returns the date-time that `std.date`'s `parse_date_time` reads from the text. Otherwise returns
/// an error with the reason the text is not a date-time and the offset where it stops being one.
pub fn literal(text: String) -> Result<DateTime, Error> = date_time_literal(text)

// --- Tests ------------------------------------------------------------------

test "`literal` returns the date-time for valid text, and otherwise an error with the character position of the first invalid text" {
  assert_eq(literal("2026-10-04T12:30:00").ok(), date_time(2026, 10, 4, 12, 30, 0));
  assert_eq(literal("2026-10-04T12:30:00Z"), Err({ message: "nothing follows here", offset: 19 }))
}
