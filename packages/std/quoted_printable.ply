//! Quoted-printable, a text encoding of bytes that leaves ASCII text readable.
//!
//! `encode` accepts any bytes. It writes a printable ASCII character other than `=` as itself, and
//! every other byte as `=` followed by two upper-case hex digits. It writes lines of at most 76
//! characters. Each line except the last ends with a soft line break, which is a `=` before a CRLF
//! and decodes to nothing. A space or a tab is written as itself unless it would end a line.
//! `encode_text` does the same for text whose lines matter. It writes each line break of the text,
//! a line feed with or without a carriage return before it, as a CRLF, so a reader that does not
//! decode quoted-printable still sees the lines.
//!
//! `read` raises an `Error` stating where a text stops being quoted-printable and why, and `decode`
//! returns the same `Error` as an `Err`. They accept hex digits in either case, a line of any
//! length, and a line break written as CRLF or as a lone line feed, and they decode each line break
//! exactly as written. They drop blanks at the end of a line, as padding that a transport added,
//! and accept a soft line break at the end of the text. They reject a `=` that is not followed by
//! two hex digits or the end of the line, and a byte that the encoding never writes unescaped: a
//! control character, or a byte greater than `~`.

import std.bytes (hex_value)
import std.laws (round_trip)
import std.pem (trimmed_length)
import std.result
import std.string
import std.gen

/// Why a text is not quoted-printable.
pub type ErrorKind =
  /// A `=` not followed by two hex digits or the end of its line.
  | BadEscape
  /// A byte that must be escaped but was not, with its value.
  | BadByte(Int)

/// Why a text was rejected, and the offset in the text's UTF-8 bytes where the problem was found.
pub type Error = { at: Int, reason: ErrorKind }

/// The effect this module's readers raise when they reject a text.
pub effect quoted_printable {
  /// The text is not quoted-printable.
  raise fail(e: Error)
}

/// `data` in quoted-printable, with its line breaks escaped like any other bytes, so `read`
/// returns exactly `data`.
pub fn encode(data: Bytes) -> String / {abort.raise} = encode_bytes(data, false)

/// Returns `text` encoded as quoted-printable, with each line break of the text written as a CRLF
/// instead of being escaped. A carriage return that is not followed by a line feed is escaped like
/// any other byte.
pub fn encode_text(text: String) -> String / {abort.raise} =
  encode_bytes(Bytes::of_string(text), true)

/// `=` and the two upper-case hex digits of the byte `c`.
pub fn escape(c: Int) -> Bytes / {abort.raise} =
  Bytes::of_string("=" ++ byte_of_int(c).hex_of().ascii_upper())

type Line = { out: List<Bytes>, column: Int }

fn encode_bytes(data: Bytes, lines: Bool) -> String / {abort.raise} =
  String::of_bytes(
    Bytes::concat_all(
      range(0, data.len()).fold({ out: [], column: 0 }, |l: Line, i: Int| {
        let c = data.at(i);
        if lines && c == b'\n' { { out: l.out.push(b"\r\n"), column: 0 } }
        else if lines && c == b'\r' && data.peek(i + 1) == b'\n' { l }
        else { append_wrapped(l, encode_byte(c, ends_line(data, i + 1, lines))) }
      }).out,
    ),
  )

fn ends_line(data: Bytes, next: Int, lines: Bool) -> Bool = {
  let c = data.peek(next);
  c < 0 || (lines && (c == b'\n' || (c == b'\r' && data.peek(next + 1) == b'\n')))
}

fn encode_byte(c: Int, last: Bool) -> Bytes / {abort.raise} =
  if (c > b' ' && c <= b'~' && c != b'=') || ((c == b' ' || c == b'\t') && !last) { byte_of_int(c) }
  else { escape(c) }

fn append_wrapped(l: Line, piece: Bytes) -> Line = {
  let width = piece.len();
  if l.column + width > 75 { { out: l.out.push(b"=\r\n").push(piece), column: width } }
  else { { out: l.out.push(piece), column: l.column + width } }
}

/// The bytes `text` encodes. Raises `quoted_printable.fail` where `decode` returns `Err`.
pub fn read(text: String) -> Bytes / {quoted_printable.fail, abort.raise} = {
  let lines = Bytes::of_string(text).split(b"\n");
  let last = lines.len() - 1;
  Bytes::concat_all(
    range(0, lines.len()).fold({ out: [], at: 0 }, |r: ReadState, i: Int|
      match lines.at(i) { Some(line) -> read_line(r, line, i == last), None -> r }).out,
  )
}

/// The bytes `text` encodes, or where it stops being quoted-printable and why.
pub fn decode(text: String) -> Result<Bytes, Error> / {abort.raise} = try { read(text) }

type ReadState = { out: List<Bytes>, at: Int }

fn printable() -> Bytes =
  b"\t !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

fn read_line(
  r: ReadState,
  line: Bytes,
  last: Bool,
) -> ReadState / {quoted_printable.fail, abort.raise} = {
  let n = line.len();
  let crlf = !last && line.peek(n - 1) == b'\r';
  let end = trimmed_length(line, if crlf { n - 1 } else { n });
  let soft = line.peek(end - 1) == b'=';
  let content = line.slice(0, if soft { end - 1 } else { end });
  let bytes = match unescape(content, b'=', printable()) {
    Ok(found) -> found,
    Err(i) ->
      quoted_printable.fail({
        at: r.at + i,
        reason: if content.at(i) == b'=' { BadEscape } else { BadByte(content.at(i)) },
      }),
  };
  {
    out: r.out.push(bytes).push(if soft || last { b"" } else if crlf { b"\r\n" } else { b"\n" }),
    at: r.at + n + 1,
  }
}

type UnescapeState = { out: List<Bytes>, at: Int, bad: Int }

/// Decodes `text`, where `marker` followed by two hex digits in either case is one byte, and every
/// other byte must be one of `plain` and is copied as is. Returns the bytes, or the index of the
/// first byte that is neither.
pub fn unescape(text: Bytes, marker: Int, plain: Bytes) -> Result<Bytes, Int> / {abort.raise} = {
  let pieces = text.split(byte_of_int(marker));
  let done = range(0, pieces.len()).fold({ out: [], at: 0, bad: -1 }, |u: UnescapeState, i: Int|
    match pieces.at(i) {
      Some(piece) -> if u.bad >= 0 { u } else { unescape_piece(u, piece, i > 0, plain) },
      None -> u,
    });
  if done.bad >= 0 { Err(done.bad) } else { Ok(Bytes::concat_all(done.out)) }
}

fn unescape_piece(
  u: UnescapeState,
  piece: Bytes,
  escaped: Bool,
  plain: Bytes,
) -> UnescapeState / {abort.raise} = {
  let n = piece.len();
  let from = if escaped { 2 } else { 0 };
  let value = if escaped { hex_value(piece.peek(0)) * 16 + hex_value(piece.peek(1)) } else { 0 };
  if escaped && (hex_value(piece.peek(0)) < 0 || hex_value(piece.peek(1)) < 0) {
    { ..u, bad: u.at - 1 }
  } else {
    let stop = if from >= n { n } else { piece.scan(from, plain, n - from) };
    if stop < n { { ..u, bad: u.at + stop } } else {
      {
        out: List::push(
          if escaped { u.out.push(byte_of_int(value)) } else { u.out },
          piece.slice(from, n),
        ),
        at: u.at + n + 1,
        bad: -1,
      }
    }
  }
}

test "a decode of an encode is the bytes encoded" {
  gen::check(gen::bytes(), |x: Bytes| round_trip(encode, |text: String| decode(text).ok(), x))
}

fn longest_line(text: String) -> Int =
  text.split("\r\n").fold(0, |most: Int, line: String| max(most, line.len()))

test "no encoded line is longer than 76 characters" {
  gen::check(gen::bytes(), |data: Bytes| {
    longest_line(encode(data)) <= 76
      && longest_line(encode_text(String::of_bytes_lossy(data))) <= 76
  })
}

type Vector = { description: String, encoded: String, decoded: Bytes }

fn vectors() -> List<Vector> =
  [
    {
      description: "soft line breaks",
      encoded: "Now's the time =\r\nfor all folk to come=\r\n to the aid of their country.",
      decoded: b"Now's the time for all folk to come to the aid of their country.",
    },
    {
      description: "a euro sign",
      encoded: "Joe owes =E2=82=AC100.",
      decoded: b"Joe owes \xe2\x82\xac100.",
    },
    { description: "nothing", encoded: "", decoded: b"" },
    { description: "an escaped `=`", encoded: "a=3Db", decoded: b"a=b" },
    { description: "hex digits in lower case", encoded: "a=3db=c3=A9", decoded: b"a=b\xc3\xa9" },
    { description: "CRLF line breaks", encoded: "one\r\ntwo\r\n", decoded: b"one\r\ntwo\r\n" },
    { description: "bare line feeds", encoded: "one\ntwo\n", decoded: b"one\ntwo\n" },
    {
      description: "blanks a transport added",
      encoded: "padded \t \r\nline  ",
      decoded: b"padded\r\nline",
    },
    {
      description: "a padded soft line break",
      encoded: "soft= \t\r\nbreak",
      decoded: b"softbreak",
    },
    {
      description: "a soft line break ending the text",
      encoded: "soft=\nbreak=",
      decoded: b"softbreak",
    },
    {
      description: "an escaped blank ending a line",
      encoded: "kept =20\r\n",
      decoded: b"kept  \r\n",
    },
    {
      description: "escaped bytes of every kind",
      encoded: "=00=FF=0D=0A",
      decoded: b"\x00\xff\r\n",
    },
    { description: "a tab", encoded: "tab\there", decoded: b"tab\there" },
    { description: "lines of nothing", encoded: "a\n\nb\r\n\r\nc", decoded: b"a\n\nb\r\n\r\nc" },
    { description: "a line that is a soft line break", encoded: "a=\r\n=\r\nb", decoded: b"ab" },
  ]

test "`decode` returns the original bytes from the quoted-printable text for {c.description}" for c: Vector in vectors(
  ) { assert_eq(decode(c.encoded), Ok(c.decoded)) }

type ErrorCase = { what: String, encoded: String, at: Int, reason: ErrorKind }

fn error_cases() -> List<ErrorCase> =
  [
    {
      what: "a `=` before a letter that is no hex digit",
      encoded: "a=zz",
      at: 1,
      reason: BadEscape,
    },
    { what: "a `=` before one hex digit", encoded: "a=3", at: 1, reason: BadEscape },
    { what: "a `=` before a hex digit and a letter", encoded: "a=3G", at: 1, reason: BadEscape },
    { what: "two `=` in a row", encoded: "ok\r\na==41", at: 5, reason: BadEscape },
    { what: "a `=` before a blank inside a line", encoded: "a= b", at: 1, reason: BadEscape },
    { what: "a byte past `~`", encoded: "caf\u{e9}", at: 3, reason: BadByte(0xC3) },
    { what: "a NUL", encoded: "nul\0", at: 3, reason: BadByte(0) },
    {
      what: "a carriage return inside a line",
      encoded: "bare\rreturn",
      at: 4,
      reason: BadByte(13),
    },
    { what: "a carriage return ending the text", encoded: "ends\r", at: 4, reason: BadByte(13) },
    { what: "a DEL on a later line", encoded: "one\r\ntwo\u{7f}", at: 8, reason: BadByte(127) },
  ]

test "`decode` fails with the error position and reason for the invalid text in {c.what}" for c: ErrorCase in error_cases(
  ) { assert_eq(decode(c.encoded), Err({ at: c.at, reason: c.reason })) }

test "`read` raises the same error that `decode` returns as `Err`" {
  assert_eq(try { read("a=zz") }, Err({ at: 1, reason: BadEscape }))
}

test "`encode` escapes unprintable bytes, `=`, and a space or tab at the end of a line" {
  assert_eq(encode(b"plain text"), "plain text");
  assert_eq(encode(b"!~\x7f"), "!~=7F");
  assert_eq(encode(b"a=b"), "a=3Db");
  assert_eq(encode(b"caf\xc3\xa9"), "caf=C3=A9");
  assert_eq(encode(b"ends in a space "), "ends in a space=20");
  assert_eq(encode(b"ends in a tab\t"), "ends in a tab=09");
  assert_eq(encode(b"two\r\nlines"), "two=0D=0Alines");
  assert_eq(encode(b"a \x00"), "a =00");
  assert_eq(encode(b""), "");
  assert_eq(escape(0), b"=00");
  assert_eq(escape(255), b"=FF")
}

test "`encode_text` ends every line with CRLF and escapes a space or tab at the end of a line" {
  assert_eq(encode_text("one\ntwo\r\nthree"), "one\r\ntwo\r\nthree");
  assert_eq(encode_text("blank \nthen\t\r\nend "), "blank=20\r\nthen=09\r\nend=20");
  assert_eq(encode_text("a\rb"), "a=0Db");
  assert_eq(encode_text("a \rb c\nd"), "a =0Db c\r\nd");
  let full = String::of_bytes(b"x".repeat(75));
  assert_eq(encode_text("a\n" ++ full), "a\r\n" ++ full);
  assert_eq(encode_text("\n\n"), "\r\n\r\n");
  assert_eq(encode_text("Joe owes \u{20ac}100."), "Joe owes =E2=82=AC100.")
}

test "`encode` ends each long output line with `=` and CRLF within 76 characters, and never splits an `=XX` escape across lines" {
  let line = encode(b"x".repeat(100));
  assert_eq(line.split("=\r\n"), [line.slice(0, 75), line.slice(78, 103)]);
  let escapes = encode(b"\xff".repeat(30));
  assert_eq(escapes.split("=\r\n").map(String::len), [75, 15]);
  assert_eq(decode(escapes), Ok(b"\xff".repeat(30)))
}

test "`unescape` decodes a marker byte followed by two hex digits and passes allowed bytes through, and fails at the first other byte" {
  assert_eq(unescape(b"a%20b%2fc", b'%', b"abc"), Ok(b"a b/c"));
  assert_eq(unescape(b"", b'%', b"abc"), Ok(b""));
  assert_eq(unescape(b"%41", b'%', b""), Ok(b"A"));
  assert_eq(unescape(b"ab d", b'%', b"abcd"), Err(2));
  assert_eq(unescape(b"ab%4", b'%', b"abcd"), Err(2));
  assert_eq(unescape(b"ab%", b'%', b"abcd"), Err(2));
  assert_eq(unescape(b"%%41", b'%', b"abcd"), Err(0))
}
