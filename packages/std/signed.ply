//! Signed documents: a payload and the Ed25519 signatures over it.
//!
//! Every writer produces the same encoding. Each signature covers the payload behind a domain
//! prefix of its own, so it is never valid as a signature over another protocol's message. A
//! document contains at most one signature per signer. `ply build --sign` writes one beside an
//! artifact.

import std.bin
import std.ed25519

/// One signer's signature: its public key, and what it signed with the matching seed.
pub type Signature = { signer: Bytes, signature: Bytes }

/// A payload and every signature over it.
pub type Signed = { payload: Bytes, signatures: List<Signature> }

derive bin for Signature

derive bin for Signed

fn magic() -> Bytes = b"PLYSIG01"

/// The prefix that keeps a signature over a payload from being valid over a definition hash or
/// another protocol's message.
fn domain() -> Bytes = b"ply.signed.1\x00"

/// The document's encoding.
pub fn signed_bytes(s: Signed) -> Bytes / {abort.raise} =
  magic().concat(bin::encode(s, signed_bin()))

/// Decodes a document that `signed_bytes` encoded. Returns `None` for any other bytes.
pub fn signed_of(b: Bytes) -> Option<Signed> / {abort.raise} =
  if !b.starts_with(magic()) { None } else {
    match bin::decode(b.slice(magic().len(), b.len()), signed_bin()) {
      Ok(s) -> Some(s),
      Err(_) -> None,
    }
  }

/// `seed`'s signature over `payload`. Raises for a seed that is not 32 bytes.
pub fn signature_by(seed: Secret<Bytes>, payload: Bytes) -> Signature / {abort.raise} =
  { signer: ed25519::public_key(seed), signature: ed25519::sign(seed, domain().concat(payload)) }

/// Whether the signature is a valid signature by its signer over `payload`.
pub fn signature_matches(s: Signature, payload: Bytes) -> Bool / {abort.raise} =
  ed25519::verify(s.signer, domain().concat(payload), s.signature)

/// `s` with `seed`'s signature added, replacing any earlier signature by the same signer.
pub fn countersigned(s: Signed, seed: Secret<Bytes>) -> Signed / {abort.raise} = {
  let mine = signature_by(seed, s.payload);
  { ..s, signatures: s.signatures.filter(|x: Signature| x.signer != mine.signer).push(mine) }
}

/// The signer of the first signature that is by a key in `trusted` and valid over the payload.
pub fn trusted_signer(s: Signed, trusted: List<Bytes>) -> Option<Bytes> / {abort.raise} =
  s.signatures.fold(None, |found: Option<Bytes>, x: Signature|
    match found {
      Some(_) -> found,
      None -> if trusted.fold(false, |t: Bool, k: Bytes| t || k == x.signer)
          && signature_matches(x, s.payload) { Some(x.signer) }
      else { None },
    })

// --- Tests ------------------------------------------------------------------

fn a_seed(n: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(range(0, 32).map(|i: Int| byte_of_int((i + n) % 256)))

test "a signature is valid over its payload alone, and a document has each signer once" {
  let seed = |n: Int| Secret::of_bytes(a_seed(n));
  let one = countersigned({ payload: b"what was built", signatures: [] }, seed(1));
  let both = countersigned(countersigned(one, seed(2)), seed(1));
  assert_eq(both.signatures.len(), 2);
  assert_eq(signed_of(signed_bytes(both)), Some(both));
  let first = ed25519::public_key(seed(1));
  let second = ed25519::public_key(seed(2));
  assert_eq(trusted_signer(both, [second]), Some(second));
  assert_eq(trusted_signer(both, [ed25519::public_key(seed(3))]), None);
  assert_eq(trusted_signer({ ..both, payload: b"something else" }, [first, second]), None);
  assert_eq(signed_of(b"not signatures"), None)
}
