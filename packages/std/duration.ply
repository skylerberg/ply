//! `Duration` literals in source. With `import std.duration`, `duration"1h30m"` is the `Duration`
//! that `read_duration` in `std.time` returns for that text. The text is parsed when the program is
//! checked.
//!
//! Text that is not a duration is a check error at the first character that makes it invalid. A
//! mistyped unit therefore fails the check instead of failing at run time, and a call site can
//! write `duration"250ms"` instead of multiplying out milliseconds.

import std.time (parse_duration, rejection_message)

/// Checks a `duration"..."` literal. Returns the `Duration` that `parse_duration` in `std.time`
/// produces for the text, or an error message with the offset of the character that makes the text
/// invalid.
pub fn literal(text: String) -> Result<Duration, { message: String, offset: Int }> / {abort.raise} =
  match parse_duration(text) {
    Ok(d) -> Ok(d),
    Err(rejected) -> Err({ message: rejection_message(rejected), offset: rejected.at }),
  }

type DurationCase = { text: String, nanos: Int }

const spans: List<DurationCase> =
  [
    { text: "1h30m", nanos: 5400000000000 },
    { text: "1.5s", nanos: 1500000000 },
    { text: "250ms", nanos: 250000000 },
    { text: "-2m", nanos: 0 - 120000000000 },
    { text: "0", nanos: 0 },
  ]

test "the literal {c.text} parses to its duration" for c: DurationCase in spans {
  assert_eq(literal(c.text), Ok(Duration(c.nanos)))
}

type ErrorCase = { text: String, message: String, offset: Int }

const rejections: List<ErrorCase> =
  [
    { text: "", message: "no duration is written here", offset: 0 },
    { text: "90", message: "a number must be followed by its unit", offset: 2 },
    {
      text: "1h30min",
      message: "unknown unit: use `h`, `m`, `s`, `ms`, `us` or `ns`; a day has no fixed length",
      offset: 4,
    },
    {
      text: "1.h",
      message: "a number goes here: digits, with digits after a point if it has one",
      offset: 2,
    },
    {
      text: "1.5ns",
      message: "finer than a nanosecond, the smallest span a `Duration` can represent",
      offset: 0,
    },
    {
      text: "1h9999999h",
      message: "longer than a `Duration` can represent, about 292 years",
      offset: 2,
    },
  ]

test "`literal` fails on the invalid duration {c.text}, reporting the error message and the offset where the text stops being a valid duration" for c: ErrorCase in rejections {
  assert_eq(literal(c.text), Err({ message: c.message, offset: c.offset }))
}
