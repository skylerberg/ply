//! `Duration` literals in source. With `import std.duration`, `duration"1h30m"` is the `Duration`
//! that `std.time`'s `read_duration` returns for that text. The text is parsed when the program is
//! checked.
//!
//! Text that is not a duration is a check error at the first character that makes it invalid. So a
//! mistyped unit never reaches a run, and a call site can write `duration"250ms"` instead of
//! multiplying out milliseconds.

import std.time (parse_duration, rejection_message)

/// Checks a `duration"..."` literal. Returns the `Duration` the text writes in `std.time`'s
/// compound form, or an error message with the offset of the character it is about.
pub fn literal(text: String) -> Result<Duration, { message: String, offset: Int }> / {abort.raise} =
  match parse_duration(text) {
    Ok(d) -> Ok(d),
    Err(rejected) -> Err({ message: rejection_message(rejected), offset: rejected.at }),
  }

// --- Tests ------------------------------------------------------------------

type DurationCase = { text: String, nanos: Int }

fn spans() -> List<DurationCase> =
  [
    { text: "1h30m", nanos: 5400000000000 },
    { text: "1.5s", nanos: 1500000000 },
    { text: "250ms", nanos: 250000000 },
    { text: "-2m", nanos: 0 - 120000000000 },
    { text: "0", nanos: 0 },
  ]

test "the literal {c.text} parses to its duration" for c: DurationCase in spans() {
  assert_eq(literal(c.text), Ok(Duration(c.nanos)))
}

type ErrorCase = { text: String, message: String, offset: Int }

fn rejections() -> List<ErrorCase> =
  [
    { text: "", message: "no duration is written here", offset: 0 },
    { text: "90", message: "a number takes its unit after it", offset: 2 },
    {
      text: "1h30min",
      message: "the unit is not one of `h`, `m`, `s`, `ms`, `us` or `ns`; a day has no fixed length, so `d` is not a unit",
      offset: 4,
    },
    {
      text: "1.h",
      message: "a number goes here: digits, with digits after a point if it has one",
      offset: 2,
    },
    { text: "1.5ns", message: "smaller than a nanosecond, the smallest span a `Duration` can store", offset: 0 },
    { text: "1h9999999h", message: "larger than a `Duration` can store, about 292 years", offset: 2 },
  ]

test "the literal {c.text} fails where it stops being one" for c: ErrorCase in rejections() {
  assert_eq(literal(c.text), Err({ message: c.message, offset: c.offset }))
}
