//! Runs a compiled unit, which is a program compiled to a native library. Running other programs
//! requires the `machine` capability, which a program is granted with `--allow machine`.
//!
//! `open` loads a unit from a native library. `bind` sets up the host effects that the runtime
//! implements itself (such as files, processes and credentials) for one run, using only what the
//! run was granted, and returns a binding, which is an integer handle to that setup. `enter` runs
//! one root, an entry point of the unit, on the calling thread. Its arguments are a list of values
//! encoded with `std.value.encode`. Its result is the encoded value the root wrote, returned as it
//! was written. The caller chooses which root to enter and what arguments to pass, and interprets
//! the result or failure. A failure names a location as a root's name plus an offset from the start
//! of that root's definition. A caller that has the program's source can map that location to a
//! source position.
//!
//! `hermetic_machine` provides the same operations using only what they are given. It binds no host
//! effects, it applies no time limit, it does not measure how long an entry takes, and
//! `changed_read` never reports a change. A test that runs a program through it is therefore
//! deterministic and its result can be cached. It needs no grant.

import std.bin
import std.internal.trail as trail
import std.value
import std.value (Value)

/// Runs compiled units: loads them, binds the host features a program was granted, and runs their
/// roots.
pub nondet effect machine {
  /// Loads the unit compiled into the library at `library`, or returns why it did not load, such
  /// as a library built against another runtime.
  write open(library: String) -> Result<LoadedUnit, String>
  /// Creates a binding of the families the runtime handles itself, from only `grants`, or returns
  /// why it could not: a file root that is not a directory (`E0454`), a program that cannot be
  /// started (`E0457`), or a credential that does not load (`E0430`).
  write bind(grants: Grants) -> Result<Int, List<Failure>>
  /// Runs `root` of the unit `unit` on the calling thread, separately from any other entry, within
  /// the limits in `run`. `arguments` is a list of values encoded with `std.value.encode`, which
  /// the root reads.
  read enter(unit: Int, root: String, arguments: Bytes, run: Run) -> Outcome
  /// Prints `line` for the person watching the run, on standard error if `to_stderr` is true and
  /// otherwise on standard output. It is a `read` so that `parallel` branches can report as they
  /// finish: what it prints changes no result.
  read report(line: String, to_stderr: Bool) -> Unit
  /// Describes, for a person, the first read in `trace` that no longer returns what it did under
  /// `grants`, or `None` if no read changed.
  read changed_read(grants: Grants, trace: Bytes) -> Option<String>
  /// Returns the facts about the host effects that the runtime implements itself, for a run granted
  /// `grants`. They are why a credential or file directory was rejected, the TLS settings and
  /// credentials the run's connections use, the file directories the run may access, and where log
  /// output goes. A run prints these when it starts.
  read hosting(grants: Grants) -> Hosting
  /// Closes the binding: ends its child processes and writes out any buffered output. Returns a
  /// `Report` from each host feature, covering what happened during the run.
  write unbind(binding: Int) -> List<Report>
  /// Releases the unit. If an entry is still running, the unit stays loaded until that entry ends.
  write close(unit: Int) -> Unit
}

/// Has the same operations as `machine`, but each handler uses only the arguments its operation is
/// given, never any state outside them.
pub effect hermetic_machine {
  /// Loads the unit compiled into the library at `library`, or returns why it did not load.
  write open(library: String) -> Result<LoadedUnit, String>
  /// Sets up the host effects that the runtime implements itself (such as files and processes) from
  /// `grants`, and returns the binding, or the reasons it could not.
  write bind(grants: Grants) -> Result<Int, List<Failure>>
  /// Runs `root` of unit `unit` within the limits `run` sets, and returns how the run ended.
  read enter(unit: Int, root: String, arguments: Bytes, run: Run) -> Outcome
  /// Returns a description of the first read in `trace` whose result differs under `grants`, or
  /// `None` if no read changed.
  read changed_read(grants: Grants, trace: Bytes) -> Option<String>
  /// Returns the facts about the host effects that the runtime implements itself (files, TLS, log
  /// output and so on) for a run given `grants`. A run prints these when it starts.
  read hosting(grants: Grants) -> Hosting
  /// Tears down the binding `binding`, ends its child processes, writes out any log records still
  /// buffered, and returns one `Report` from each part of the runtime that has something to say
  /// about the run.
  write unbind(binding: Int) -> List<Report>
  /// Releases the unit `unit`. A run still using it keeps it loaded until the run ends.
  write close(unit: Int) -> Unit
}

/// An opened unit: its handle, its number of roots, the nanoseconds loading it took, and how many
/// threads the runtime runs `parallel` branches on.
pub type LoadedUnit = { unit: Int, root_count: Int, nanos: Int, threads: Int }

/// A file root or a program granted to a run, with the name the program's operations use for it.
pub type NamedPath = { name: String, path: String }

/// What a run is allowed to use. The runtime implements some effects itself, such as the file
/// system and processes. `fs`, `exec`, `allow`, `argv`, `stderr` and `spawning` limit those
/// effects. `given` supplies named values that the handlers for all other effects read.
pub type Grants = {
  fs: List<NamedPath>,
  exec: List<NamedPath>,
  /// The names of the runtime's restricted families that the run may use. A family is restricted
  /// when it is unavailable unless listed here. The possible names are `machine`, `shipped` and
  /// `toolchain`.
  allow: List<String>,
  /// The command line `process.args` returns, or `None` for a run that is not a process, such as
  /// a test.
  argv: Option<List<String>>,
  /// Whether the program writes its own lines to stderr. It is `true` for a process that prints its
  /// own messages, because `--json` reserves stdout for its single JSON document.
  stderr: Bool,
  /// Whether `process` may start programs. When `false`, as for a test, a run can start only the
  /// programs named in `exec`.
  spawning: Bool,
  given: List<GrantEntry>,
}

/// A named group of values that the handlers of other effects read, with the names of its fields.
pub type GrantEntry = { name: String, fields: List<String> }

/// Returns `Grants` with every list empty, no command line and both flags `false`, so the run may
/// use nothing.
pub const no_grants: Grants =
  { fs: [], exec: [], allow: [], argv: None, stderr: false, spawning: false, given: [] }

/// The limits and settings for one run of a root: its time limit, schedule, recording options and
/// kind.
pub type Run = {
  /// The binding the run uses, as returned by `bind`, or 0 for none. When `hosted` is `true`, that
  /// binding's handlers handle the run's operations.
  binding: Int,
  hosted: Bool,
  /// The wall-clock milliseconds it may take, where 0 means no limit. Past it, the entry fails
  /// with `W0612`.
  timeout_ms: Int,
  /// The schedule its `simulate` blocks follow.
  seed: Option<Seed>,
  /// Whether this run is one of several runs of the same test made by a search. When `true`, any
  /// operation that needs the real host fails.
  re_executed: Bool,
  /// Whether to record what it read, in its outcome's trace.
  observe: Bool,
  /// Whether to read the wall clock to measure how long it took.
  measure: Bool,
  /// Whether the run is a test. A test's `Usage` counts every operation it performs, including
  /// those its own handlers handle, and the objects still live when it ends. Any other run counts
  /// only the operations the runtime's own handlers handle.
  tested: Bool,
  /// The name to report for the entry if it runs for a long time, or empty for none.
  label: String,
}

/// Selects one schedule for a run. `root` seeds the random choices, `path` lists choices to replay
/// first, and `steps` is the most scheduling points the run may take.
pub type Seed = { root: U64, path: List<Int>, steps: Int }

/// Returns a `Run` with no time limit and no schedule, and with recording, measuring and test
/// counting turned off.
pub const unbounded: Run =
  {
    binding: 0,
    hosted: false,
    timeout_ms: 0,
    seed: None,
    re_executed: false,
    observe: false,
    measure: false,
    tested: false,
    label: "",
  }

/// The result of running a root: how it ended, the code passed to `process.exit` if any, the
/// resources it used, warnings from the runtime as it ended, the schedule its `simulate` blocks
/// followed, and a trace of what it read.
pub type Outcome = {
  ended: Termination,
  exit: Option<Int>,
  usage: Usage,
  warnings: List<Failure>,
  interleaving: Option<Interleaving>,
  trace: Option<Bytes>,
}

/// How an entry ended.
pub type Termination =
  /// The root returned normally. The bytes are its result encoded in the PLV1 value format.
  | Returned(Bytes)
  /// An unhandled raise, a runtime error, a timeout, or a result that cannot be encoded as a value.
  | Failed(Failure)
  /// The runtime itself failed, which is a bug in Ply, with its message.
  | Panicked(String)
  /// The unit has no such root.
  | NoRoot
  /// The result contains a value that cannot be encoded, such as one tied to this run. The string
  /// says which value and why.
  | UnencodableResult(String)

/// `nanos` is 0 for a run not measured.
pub type Usage = {
  nanos: Int,
  /// Whether the run used a nondeterministic host handler, one whose results can differ between
  /// runs.
  host: Bool,
  performs: Int,
  native_objects: Int,
  scheduled: Int,
  task_stacks: Int,
  frame_tables: Int,
  /// The blocks the run took through the runtime: each past what compiled code takes inline, and
  /// one each time a page of smaller blocks fills. An update in place takes none.
  runtime_blocks: Int,
  /// The objects a test's run allocated that were still live after it returned, each one never
  /// released. 0 for any other run.
  live: Int,
}

/// A diagnostic from the runtime. `values` contains each value the message refers to, encoded in
/// the PLV1 value format that `value_of` decodes.
pub type Failure = {
  code: String,
  severity: Severity,
  message: String,
  labels: List<Label>,
  notes: List<String>,
  values: List<Bytes>,
}

/// Whether a diagnostic stops the run, warns, or adds a note.
pub type Severity = | Error | Warning | Note

/// What a failure reports about a location. `primary` marks the location it is about, and `site`
/// is `None` for a location outside every root.
pub type Label = { site: Option<Site>, primary: Bool, text: String }

/// A location in a root's definition, as offsets from its start.
pub type Site = { root: String, start: Int, end: Int }

/// What a run's `simulate` blocks did: each scheduling point, and the virtual time spent.
pub type Interleaving = { steps: List<Step>, virtual_time: Int }

/// One scheduling point, where the scheduler picks which task runs next. `scheduler` identifies the
/// scheduler. `task` is the task it resumed, `enabled` lists the tasks it could have resumed, and
/// `choice` is the index in `enabled` that it picked. `accesses` lists what the step after this
/// point read or wrote. `definition` is the name of the function the step was in, and `site` is the
/// position in it, when known. `stamp` is the task's vector clock.
pub type Step = {
  scheduler: Int,
  task: Int,
  enabled: List<Int>,
  choice: Int,
  accesses: List<Access>,
  definition: Option<String>,
  site: Option<Site>,
  stamp: List<Int>,
}

/// One thing a step read or wrote, with `write` telling which. It is an operation or resource of an
/// effect, a variable of a handler (identified by the handler's number and the variable's index),
/// or a scoped value.
pub type Access =
  | EffectAccess({ effect: String, resource: Option<String>, write: Bool, operation: Option<String> })
  | VariableAccess({ handler: Int, index: Int, write: Bool })
  | ScopedAccess({ id: Int, write: Bool })

/// What one part of the runtime reports about a run after the binding is torn down. `name` says
/// which part, and `body` is its content. `teardown` lists the tracing spans that were still open,
/// `handshakes` lists the lines printed about TLS, `stopping` describes how the run was stopped,
/// and `trace` contains the log records the log destination received.
pub type Report = { name: String, body: Bytes }

/// The facts about the host effects that the runtime implements itself, such as TLS, file
/// directories, log output and signals. A run prints them when it starts.
pub type Hosting = {
  /// Why a credential or a file root granted to the run does not load.
  rejections: List<Failure>,
  /// `None` when the credentials failed to load.
  transport: Option<Transport>,
  roots: List<NamedPath>,
  sink: Sink,
  signals: List<String>,
}

/// The TLS a run's connections use: the library and its provider, the protocol versions and ALPN
/// names it offers, the root certificates it trusts (`trusted_root_count` is their count) and the
/// credentials it presents.
pub type Transport = {
  tls_library: String,
  version: String,
  provider: String,
  versions: List<String>,
  alpn: List<String>,
  roots: String,
  roots_version: String,
  trusted_root_count: Int,
  credentials: List<Credential>,
}

/// A credential that the run's TLS connections present: its name, the fingerprint of its
/// certificate, and the number of certificates in its chain.
pub type Credential = { name: String, fingerprint: String, certificates: Int }

/// `level` is `None` when the records are discarded.
pub type Sink = { sink: String, destination: String, level: Option<String> }

derive bin for LoadedUnit
derive bin for NamedPath
derive bin for GrantEntry
derive bin for Seed
derive bin for Run
derive bin for Severity
derive bin for Site
derive bin for Label
derive bin for Failure
derive bin for Access
derive bin for Step
derive bin for Interleaving
derive bin for Usage
derive bin for Termination
derive bin for Report
derive bin for Outcome
derive bin for Credential
derive bin for Transport
derive bin for Sink
derive bin for Hosting

host for machine by served

host for hermetic_machine by served_hermetically

/// Runs `go` with `machine` handled by the runtime.
pub fn served<a | e>(go: () -> a / {machine.read, machine.write | e}) -> a / {abort.raise | e} =
  handle {
    go()
  } with {
    machine.open(library) -> loaded_unit_of(unit_open(library)),
    machine.bind(grants) -> bound_of(unit_bind(encode_grants(grants))),
    machine.enter(unit, root, arguments, run) ->
      read(unit_enter(unit, root, arguments, bin::encode(run, run_bin())), outcome_bin()),
    machine.report(line, to_stderr) -> unit_report(line, to_stderr),
    machine.changed_read(grants, trace) ->
      changed_read_of(unit_moved(encode_grants(grants), trace)),
    machine.hosting(grants) -> read(unit_hosting(encode_grants(grants)), hosting_bin()),
    machine.unbind(binding) -> read(unit_unbind(binding), reports_bin()),
    machine.close(unit) -> unit_close(unit),
  }

/// Runs `go` with `hermetic_machine` handled by the runtime, using only what each operation is
/// given.
pub fn served_hermetically<a | e>(
  go: () -> a / {hermetic_machine.read, hermetic_machine.write | e},
) -> a / {abort.raise | e} =
  handle {
    go()
  } with {
    hermetic_machine.open(library) -> loaded_unit_of(unit_open(library)),
    hermetic_machine.bind(grants) -> match hermetic_failure(grants) {
      Some(rejected) -> Err([rejected]),
      None -> Ok(0),
    },
    hermetic_machine.enter(unit, root, arguments, run) -> {
      let outcome: Outcome = read(
        unit_enter(
          unit,
          root,
          arguments,
          bin::encode(
            { ..run, binding: 0, hosted: false, timeout_ms: 0, measure: false },
            run_bin(),
          ),
        ),
        outcome_bin(),
      );
      { ..outcome, trace: if run.observe { Some(b"") } else { outcome.trace } }
    },
    hermetic_machine.changed_read(grants, trace) -> None,
    hermetic_machine.hosting(grants) -> match hermetic_failure(grants) {
      Some(rejected) ->
        { ..read(unit_hosting(encode_grants(no_grants)), hosting_bin()), rejections: [rejected] },
      None -> read(unit_hosting(encode_grants(without_argv(grants))), hosting_bin()),
    },
    hermetic_machine.unbind(binding) -> read(unit_unbind(binding), reports_bin()),
    hermetic_machine.close(unit) -> unit_close(unit),
  }

fn without_argv(grants: Grants) -> Grants = { ..grants, argv: None }

fn hermetic_failure(grants: Grants) -> Option<Failure> =
  if grants.fs.len() == 0 && grants.exec.len() == 0
      && !grants.given.any(|g: GrantEntry| g.name == "tls" || g.name == "trust") { None } else {
    Some({
      code: "E0459",
      severity: Error,
      message: "`hermetic_machine` does not touch the real computer, so the run cannot be given a directory to read, a program to start or a credential",
      labels: [],
      notes: [
        "a test that reads real files, starts real programs or uses credentials needs the real computer; put it under `test/nondet`",
      ],
      values: [],
    })
  }

/// Decodes a value that a failure shows, from the bytes in the PLV1 value format that the runtime
/// wrote, as `value::decode_shown` does. Panics if the bytes do not decode, which is a bug in the
/// runtime.
pub fn value_of(bytes: Bytes) -> Value / {abort.raise} =
  match value::decode_shown(bytes) {
    Some(v) -> v,
    None -> panic("the runtime wrote a value that cannot be decoded"),
  }

/// Returns the notes of `f` and the decoded values that the failure's message refers to. An
/// assertion failure (`E0501`) has two values, the expected one and the actual one. For it, the
/// result adds a note saying where the two values first differ, along with the values that note
/// refers to.
pub fn failure_details(f: Failure) -> { notes: List<String>, values: List<Value> } / {abort.raise} = {
  let values = f.values.map(value_of);
  let parted = if f.code != "E0501" { None } else {
    match values {
      [expected, actual] -> value::difference_note(actual, expected, values.len()),
      _ -> None,
    }
  };
  match parted {
    Some(p) -> { notes: f.notes.push(p.note), values: values.concat(p.values) },
    None -> { notes: f.notes, values: values },
  }
}

fn encode_grants(grants: Grants) -> Bytes / {abort.raise} =
  bin::encode(entries_of(grants), grant_entries_bin())

fn entries_of(grants: Grants) -> List<GrantEntry> = {
  let pairs = |name: String, ns: List<NamedPath>|
    ns.map(|n: NamedPath| { name: name, fields: [n.name, n.path] });
  [
    pairs("fs", grants.fs),
    pairs("exec", grants.exec),
    grants.allow.map(|f: String| { name: "allow", fields: [f] }),
    match grants.argv { Some(argv) -> [{ name: "argv", fields: argv }], None -> [] },
    if grants.stderr { [{ name: "stderr", fields: [] }] } else { [] },
    if grants.spawning { [{ name: "spawning", fields: [] }] } else { [] },
    grants.given,
  ].fold([], |accumulator: List<GrantEntry>, part: List<GrantEntry>| accumulator.concat(part))
}

fn grant_entries_bin() -> bin::BinCodec<List<GrantEntry>> = bin::list_bin(grant_entry_bin())

fn reports_bin() -> bin::BinCodec<List<Report>> = bin::list_bin(report_bin())

fn loaded_unit_of(bytes: Bytes) -> Result<LoadedUnit, String> / {abort.raise} =
  read(bytes, bin::result_bin(loaded_unit_bin(), bin::string_bin()))

fn bound_of(bytes: Bytes) -> Result<Int, List<Failure>> / {abort.raise} =
  read(bytes, bin::result_bin(bin::int_bin(), bin::list_bin(failure_bin())))

fn changed_read_of(bytes: Bytes) -> Option<String> / {abort.raise} =
  read(bytes, bin::option_bin(bin::string_bin()))

fn read<a>(bytes: Bytes, codec: bin::BinCodec<a>) -> a / {abort.raise} =
  match bin::decode(bytes, codec) {
    Ok(x) -> x,
    Err(e) -> panic("the runtime's result cannot be decoded: " ++ bin::error_to_string(e)),
  }

extern fn unit_open(library: String) -> Bytes
extern fn unit_bind(grants: Bytes) -> Bytes
extern fn unit_enter(unit: Int, root: String, arguments: Bytes, run: Bytes) -> Bytes
extern fn unit_moved(grants: Bytes, trace: Bytes) -> Bytes
extern fn unit_hosting(grants: Bytes) -> Bytes
extern fn unit_unbind(binding: Int) -> Bytes
extern fn unit_close(unit: Int) -> Unit
extern fn unit_report(line: String, to_stderr: Bool) -> Unit

fn failure_with_values(code: String, values: List<Value>) -> Failure =
  {
    code: code,
    severity: Error,
    message: "m",
    labels: [],
    notes: ["n"],
    values: values.map(|v: Value| match value::encode(v) { Some(b) -> b, None -> b"" }),
  }

test "`value_of` decodes the bytes the runtime wrote for a failure's value, including constructors and the placeholders for secret and scoped values" {
  assert_eq(value_of(b"PLV1\x0c\x00\x04Some\x01\x03\x54"), value::VCtor("Some", [value::VInt(42)]));
  assert_eq(value_of(b"PLV1\x09\x02\x0f\x00\x0f\x01"), value::VList([value::VSecret, value::VHold]))
}

test "an assertion's failure notes where its values first differ, and no other failure does" {
  let row = |n: Int| value::VRecord([{ name: "qty", value: value::VInt(n) }]);
  let s = failure_details(failure_with_values("E0501", [row(3), row(2)]));
  assert_eq(s.notes.len(), 2);
  assert_eq(
    value::filled(match s.notes.at(1) { Some(n) -> n, None -> "" }, s.values),
    "first difference at `.qty`: expected 3, found 2",
  );
  assert_eq(failure_details(failure_with_values("E0502", [row(3), row(2)])).notes, ["n"]);
  assert_eq(
    failure_details(failure_with_values("E0501", [value::VInt(3), value::VInt(2)])).notes,
    ["n"],
  )
}

test "`entries_of` turns grants into named entries that each hold a list of strings, and `encode_grants` writes bytes that decode to those entries" {
  assert_eq(entries_of(no_grants), []);
  assert_eq(
    entries_of({
      ..no_grants,
      fs: [{ name: "cwd", path: "." }],
      allow: ["machine"],
      argv: Some(["a", "b"]),
      given: [{ name: "trust", fields: ["ca.pem"] }],
    }),
    [
      { name: "fs", fields: ["cwd", "."] },
      { name: "allow", fields: ["machine"] },
      { name: "argv", fields: ["a", "b"] },
      { name: "trust", fields: ["ca.pem"] },
    ],
  );
  assert_eq(
    bin::decode(encode_grants({ ..no_grants, allow: ["machine"] }), grant_entries_bin()),
    Ok([{ name: "allow", fields: ["machine"] }]),
  )
}

test "a run result's bytes decode into how the run ended, its exit code, usage counts and warnings, with no scheduling steps" {
  let bytes = Bytes::concat_all([
    b"\x00\x02ok",
    b"\x01\x0e",
    b"\x00\x00\x04\x00\x00\x00\x00\x00\x06",
    b"\x01\x02E1\x01\x01w\x01\x01\x01m\x04\x00\x01\x01l\x00\x00",
    b"\x00",
    b"\x00",
  ]);
  let o = read(bytes, outcome_bin());
  assert_eq(o.ended, Returned(b"ok"));
  assert_eq(o.exit, Some(7));
  assert_eq(o.usage.performs, 2);
  assert_eq(o.usage.live, 3);
  assert_eq(o.warnings, [
    {
      code: "E1",
      severity: Warning,
      message: "w",
      labels: [{ site: Some({ root: "m", start: 2, end: 0 }), primary: true, text: "l" }],
      notes: [],
      values: [],
    },
  ]);
  assert_eq(o.interleaving, None)
}

test "scheduling steps recorded by a simulation, once encoded, decode into the step records a run result contains" {
  let step = {
    scheduler: 0,
    task: 1,
    runnable: [0, 1],
    choice: 1,
    accesses: [
      trail::Effect("task.chan", trail::Named("#0"), trail::Write, None),
      trail::ScopedValue(2, trail::Read),
    ],
    site: Some({ root: 4, start: 1, end: 3 }),
    vector_clock: [1, 1],
  };
  let placed = |s: trail::Site|
    { definition: Some("f"), site: Some({ root: "f", start: s.start + 10, end: s.end + 10 }) };
  assert_eq(
    bin::decode(
      trail::interleaving_of(trail::encode_steps(trail::no_steps, [step], placed), 25),
      interleaving_bin(),
    ),
    Ok({
      steps: [
        {
          scheduler: 0,
          task: 1,
          enabled: [0, 1],
          choice: 1,
          accesses: [
            EffectAccess({
              effect: "task.chan",
              resource: Some("#0"),
              write: true,
              operation: None,
            }),
            ScopedAccess({ id: 2, write: false }),
          ],
          definition: Some("f"),
          site: Some({ root: "f", start: 11, end: 13 }),
          stamp: [1, 1],
        },
      ],
      virtual_time: 25,
    }),
  )
}

test "a run is written field by field in the order the runtime reads it" {
  let encode_grants = bin::encode({ ..unbounded, binding: 3, hosted: true }, run_bin());
  assert_eq(encode_grants, b"\x06\x01\x00\x00\x00\x00\x00\x00\x00")
}

test "`hermetic_failure` returns a failure for permissions that read files, run programs or pass credentials, and none for no permissions" {
  assert_eq(hermetic_failure(no_grants), None);
  assert(hermetic_failure({ ..no_grants, fs: [{ name: "cwd", path: "." }] }) != None);
  assert(hermetic_failure({ ..no_grants, exec: [{ name: "git", path: "/usr/bin/git" }] }) != None);
  assert(
    hermetic_failure({ ..no_grants, given: [{ name: "tls", fields: ["a", "c", "k"] }] }) != None,
  )
}
