//! The `re"a+b"` literal: a `std.regex` pattern over text, compiled when the program is checked.
//!
//! The type and its operations live in `std.regex`. A literal's text follows the rules of an
//! interpolated string, so write a pattern's `\` as `\\` and double its braces: `\d{2,4}` is
//! `re"\\d{{2,4}}"`. No literal takes its text raw. A pattern full of `\` and braces reads better
//! as a line string passed to `std.regex`'s `read` in a `const fn`. A build compiles it once, and
//! a check rejects a bad pattern there just as it rejects a bad literal.

import std.regex (Regex, compile, reason)
import std.result

/// Checks a `re"..."` literal.
///
/// Returns the pattern compiled with `std.regex`'s `options()`. Otherwise returns why the pattern
/// is rejected, and the offset of the character where it is rejected.
pub fn literal(text: String) -> Result<Regex, { message: String, offset: Int }> / {abort.raise} =
  match compile(text) {
    Ok(re) -> Ok(re),
    Err(rejected) -> Err({ message: reason(rejected.reason), offset: rejected.at }),
  }

// --- Tests ------------------------------------------------------------------

test "`literal` returns the same pattern as `compile` for valid text, and for invalid text fails with a message and the offset of the error" {
  assert_eq(literal("a+b").ok(), compile("a+b").ok());
  assert_eq(literal("a(b"), Err({ message: "this `(` has no closing `)`", offset: 1 }));
  assert_eq(
    literal("(a)\\1"),
    Err({
      message: "backreferences are not supported: they can make matching take exponential time",
      offset: 3,
    }),
  );
  assert_eq(
    literal("a(?=b)"),
    Err({
      message: "lookahead and lookbehind are not supported: they can make matching take exponential time",
      offset: 1,
    }),
  )
}
