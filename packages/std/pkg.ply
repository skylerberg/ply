//! The types for the package manifest: a `ply.pkg` file, a `ply.work` file, the dependencies a
//! lockfile pins, a registry's index, and the results of running a published version's archive (an
//! attestation).
//!
//! A `ply.pkg` file is one `fn package` returning a `Manifest`, and a `ply.work` file is one `fn
//! workspace` returning a `Workspace`. The body must be a plain value, not code; breaking this rule
//! is `E0129`–`E0131`. Every manifest type derives `json`.

import std.bin
import std.bytes
import std.json

/// A semantic version; ordered major, then minor, then patch.
pub type Version = { major: Int, minor: Int, patch: Int }

/// Where a dependency's sources come from: a path on this machine, a git remote pinned by
/// revision, or the registry, whose address is the dependency's name and version and nothing else.
pub type Source = | Path(String) | Git(String, String) | Registry

/// The lowest acceptable version of the dependency, not an exact version. Resolution picks the
/// highest version that any package in the dependency tree requires, and the lockfile records the
/// version it picked.
pub type Dependency = { name: String, prefix: Option<String>, min: Version, source: Source }

/// A package's manifest.
pub type Manifest = {
  name: String,
  version: Version,
  /// The module root importers use for this package; `name` when None.
  prefix: Option<String>,
  /// The toolchain this package builds with; built artifacts reject a version mismatch (E0444).
  runtime: Version,
  dependencies: List<Dependency>,
  /// The definition `ply build` starts from; `main` when None.
  entry: Option<String>,
}

derive json for Version
derive json for Source
derive json for Dependency
derive json for Manifest
derive bin for Source
derive bin for Dependency
derive bin for Manifest

/// A repository of packages, as its `ply.work` file describes it: the directory of each package,
/// relative to the file. Each directory appears only once in the file.
pub type Workspace = {
  /// The packages whose code the repository maintains.
  packages: List<String>,
  /// The packages of tests and examples. `ply test` runs them like any package, but they are not
  /// part of any package's code.
  suites: List<Suite>,
  /// Directories of Ply sources that belong to no package, such as inputs that tests read. `ply
  /// fmt` and `ply rename` do not change these files.
  fixtures: List<String>,
  /// Where `ply`'s own parts are, in the repository that builds `ply`; `None` in any other.
  toolchain: Option<ToolchainParts>,
}

/// A package of tests or examples, and whether `ply prove` proves its laws and contracts in
/// addition to `ply test` running its tests.
pub type Suite = { dir: String, proved: Bool }

/// The parts a bootstrap builds `ply` from, and the suites that test the standard library and
/// the program.
pub type ToolchainParts = {
  /// The standard library. Its files are the modules `std.*`, both in this checkout and in the
  /// binary. Loading a path inside the checkout reads these files instead of the binary's copy.
  std: String,
  /// The standard library's tests that read fixture files, in a separate package of tests.
  std_tests: String,
  /// The compiler: its files are the modules `compiler.*`, as the standard library's are `std.*`.
  compiler: String,
  /// The `ply` program's package.
  cli: String,
  /// The program's entry point, `module.name` in its package.
  entry: String,
  /// The program's suite, which drives it as a user does.
  cli_tests: String,
  /// The cargo package whose static library a native program is linked with.
  runtime: String,
}

derive json for Suite
derive json for ToolchainParts
derive json for Workspace

/// The file cargo builds the runtime's static library as, below `target/<profile>`: `lib`, then the
/// package's name with each `-` an `_`, then `.a`.
pub fn library_of(t: ToolchainParts) -> String = "lib" ++ t.runtime.replace("-", "_") ++ ".a"

/// The module root importers use for the package: its `prefix`, else its `name`.
pub fn prefix_of(m: Manifest) -> String = match m.prefix { None -> m.name, Some(p) -> p }

/// The definition `ply build` starts from: its `entry`, else `main`.
pub fn entry_of(m: Manifest) -> String = match m.entry { None -> "main", Some(e) -> e }

/// Returns the version as text in the form `1.4.0`.
pub fn render_version(version: Version) -> String =
  version.major.to_string() ++ "." ++ version.minor.to_string() ++ "." ++ version.patch.to_string()

/// Parses text such as `1.4.0` into a version, and returns `None` unless the text is exactly three
/// whole numbers separated by dots. Each number has no sign and no leading zero, except that `0`
/// itself is allowed.
pub fn parse_version(text: String) -> Option<Version> / {abort.raise} =
  match text.split(".") {
    [a, b, c] -> match count_of(a) {
      None -> None,
      Some(major) -> match count_of(b) {
        None -> None,
        Some(minor) -> match count_of(c) {
          None -> None,
          Some(patch) -> Some({ major: major, minor: minor, patch: patch }),
        },
      },
    },
    _ -> None,
  }

fn count_of(text: String) -> Option<Int> / {abort.raise} = {
  let bs = Bytes::of_string(text);
  let n = bs.len();
  if n == 0 || n > 9 || bs.at(0) == 45 || (n > 1 && bs.at(0) == 48) { None }
  else { bs.int_of_ascii() }
}

/// One published version of a package: its version, the digest of its `.plyz` archive file, whether
/// the publisher withdrew it (yanked it), and the toolchain version its manifest declares.
pub type Release = { version: Version, digest: String, yanked: Bool, runtime: Version }

/// A registry's `index.json`: every published release of one package, newest last.
pub type Index = { name: String, versions: List<Release> }

/// The release of `version` the index lists, if it lists one.
pub fn release_at(index: Index, version: Version) -> Option<Release> =
  index.versions.fold(None, |found: Option<Release>, release: Release|
    match found {
      Some(_) -> found,
      None -> if release.version == version { Some(release) } else { None },
    })

/// The results of checking one published version of a package. An attester is a party that runs the
/// package's archive with its own `ply` and reports the outcome. The record names the archive, the
/// semantics and the builder used. It says whether the package checks, whether its contracts
/// (`reuse fn` and `returns` promises) hold, how many tests passed and failed, and how many claims
/// were proved, refuted or left unproved.
pub type Attestation = {
  name: String,
  version: Version,
  archive: String,
  semantics: String,
  builder: String,
  checked: Bool,
  contracts_hold: Bool,
  tests: { passed: Int, failed: Int },
  proofs: { proved: Int, refuted: Int, unproved: Int },
}

derive bin for Version

derive bin for Attestation

/// Returns whether the version passed every check: it checks, its contracts hold, no test failed,
/// and no claim is refuted or unproved.
pub fn attested(a: Attestation) -> Bool =
  a.checked && a.contracts_hold && a.tests.failed == 0 && a.proofs.refuted == 0
    && a.proofs.unproved == 0

fn version_text_json() -> json::JsonCodec<Version> =
  {
    encode: |v: Version| json::string_json().encode(render_version(v)),
    decode: |j: json::Json|
      match json::string_json().decode(j) {
        Err(_) -> Err(json::expected("a version such as \"0.1.0\"", j)),
        Ok(text) -> match parse_version(text) {
          Some(v) -> Ok(v),
          None -> Err(json::decode_error("`" ++ text ++ "` is not a version such as `0.1.0`")),
        },
      },
  }

/// Encodes and decodes a release in JSON, with its version as a string such as `"0.1.0"`.
pub fn release_json() -> json::JsonCodec<Release> =
  {
    encode: |release: Release|
      json::object([
        { key: "version", value: version_text_json().encode(release.version) },
        { key: "digest", value: json::string_json().encode(release.digest) },
        { key: "yanked", value: json::bool_json().encode(release.yanked) },
        { key: "runtime", value: version_json().encode(release.runtime) },
      ]),
    decode: |j: json::Json|
      match json::field(j, "version", version_text_json()) {
        Err(e) -> Err(e),
        Ok(version) -> match json::field(j, "digest", json::string_json()) {
          Err(e) -> Err(e),
          Ok(digest) -> match json::field(j, "yanked", json::bool_json()) {
            Err(e) -> Err(e),
            Ok(yanked) -> match json::field(j, "runtime", version_json()) {
              Err(e) -> Err(e),
              Ok(runtime) ->
                Ok({ version: version, digest: digest, yanked: yanked, runtime: runtime }),
            },
          },
        },
      },
  }

/// An index as the registry serves it, its versions as dotted text.
pub fn index_json() -> json::JsonCodec<Index> =
  {
    encode: |index: Index|
      json::object([
        { key: "name", value: json::string_json().encode(index.name) },
        { key: "versions", value: json::list_json(release_json()).encode(index.versions) },
      ]),
    decode: |j: json::Json|
      match json::field(j, "name", json::string_json()) {
        Err(e) -> Err(e),
        Ok(name) -> match json::field(j, "versions", json::list_json(release_json())) {
          Err(e) -> Err(e),
          Ok(versions) -> Ok({ name: name, versions: versions }),
        },
      },
  }

test "`release_at` returns the release for a version the index lists, and none for a version it does not list" {
  let v = |minor: Int| { major: 1, minor: minor, patch: 0 };
  let release = { version: v(2), digest: "b3:00", yanked: false, runtime: v(0) };
  let index = { name: "lib", versions: [{ ..release, version: v(1) }, release] };
  assert_eq(release_at(index, v(2)), Some(release));
  assert_eq(release_at(index, v(3)), None)
}

test "`render_version` prints a version as dot-separated numbers" {
  assert_eq(render_version({ major: 1, minor: 23, patch: 4 }), "1.23.4")
}

test "prefix and entry default to the name and main" {
  let m: Manifest = {
    name: "tool",
    version: { major: 0, minor: 1, patch: 0 },
    prefix: None,
    runtime: { major: 0, minor: 1, patch: 0 },
    dependencies: [],
    entry: None,
  };
  assert_eq(prefix_of(m), "tool");
  assert_eq(entry_of(m), "main");
  assert_eq(prefix_of({ ..m, prefix: Some("kx") }), "kx");
  assert_eq(entry_of({ ..m, entry: Some("app.serve") }), "app.serve")
}

test "a manifest round-trips through its json codec" {
  let m: Manifest = {
    name: "tool",
    version: { major: 0, minor: 1, patch: 0 },
    prefix: Some("kx"),
    runtime: { major: 0, minor: 1, patch: 0 },
    dependencies: [
      { name: "cli", prefix: None, min: { major: 1, minor: 2, patch: 3 }, source: Path("../cli") },
      {
        name: "gitlib",
        prefix: None,
        min: { major: 0, minor: 0, patch: 1 },
        source: Git("https://example.com/gitlib", "deadbee"),
      },
      {
        name: "reglib",
        prefix: Some("rl"),
        min: { major: 2, minor: 0, patch: 0 },
        source: Registry,
      },
    ],
    entry: Some("app.serve"),
  };
  assert_eq(manifest_json().decode(manifest_json().encode(m)), Ok(m))
}

const a_toolchain: ToolchainParts =
  {
    std: "lib/std",
    std_tests: "tests/std",
    compiler: "lib/compiler",
    cli: "cli",
    entry: "ply.main",
    cli_tests: "tests/cli",
    runtime: "ply-runtime",
  }

test "a workspace round-trips through its json codec" {
  let w: Workspace = {
    packages: ["lib/store"],
    suites: [{ dir: "examples", proved: true }, { dir: "tests/lang", proved: false }],
    fixtures: ["tests/fixtures"],
    toolchain: Some(a_toolchain),
  };
  assert_eq(workspace_json().decode(workspace_json().encode(w)), Ok(w));
  let bare = { ..w, toolchain: None };
  assert_eq(workspace_json().decode(workspace_json().encode(bare)), Ok(bare))
}

test "the runtime's library is the file cargo names for its package" {
  assert_eq(library_of(a_toolchain), "libply_runtime.a");
  assert_eq(library_of({ ..a_toolchain, runtime: "rt" }), "librt.a")
}

test "a version orders major, then minor, then patch" {
  assert_eq(compare({ major: 1, minor: 0, patch: 0 }, { major: 0, minor: 9, patch: 9 }), Greater);
  assert_eq(compare({ major: 0, minor: 2, patch: 0 }, { major: 0, minor: 1, patch: 9 }), Greater);
  assert_eq(compare({ major: 0, minor: 1, patch: 2 }, { major: 0, minor: 1, patch: 1 }), Greater);
  assert_eq(compare({ major: 1, minor: 2, patch: 3 }, { major: 1, minor: 2, patch: 3 }), Equal)
}

test "`parse_version` accepts the text `render_version` prints, and rejects every other format" {
  assert_eq(parse_version("1.23.4"), Some({ major: 1, minor: 23, patch: 4 }));
  assert_eq(parse_version("0.0.0"), Some({ major: 0, minor: 0, patch: 0 }));
  assert_eq(
    parse_version(render_version({ major: 10, minor: 0, patch: 7 })),
    Some({ major: 10, minor: 0, patch: 7 }),
  );
  assert_eq(parse_version("1.2"), None);
  assert_eq(parse_version("1.2.3.4"), None);
  assert_eq(parse_version("1..3"), None);
  assert_eq(parse_version("01.2.3"), None);
  assert_eq(parse_version("1.2.-3"), None);
  assert_eq(parse_version("1.2.3 "), None);
  assert_eq(parse_version("v1.2.3"), None);
  assert_eq(parse_version("1234567890.0.0"), None)
}

fn a_release(version: String, yanked: Bool) -> Release / {abort.raise} =
  {
    version: match parse_version(version) { Some(v) -> v, None -> panic("a fixture's version") },
    digest: "b3:" ++ version,
    yanked: yanked,
    runtime: { major: 0, minor: 16, patch: 0 },
  }

test "an index round-trips through the document a registry serves, versions in order" {
  let x: Index = {
    name: "orders",
    versions: [a_release("0.2.0", false), a_release("0.1.0", true)],
  };
  let text = json::to_string(index_json().encode(x));
  assert_eq(
    text,
    "{\"name\":\"orders\",\"versions\":[{\"digest\":\"b3:0.2.0\",\"runtime\":{\"major\":0,\"minor\":16,\"patch\":0},\"version\":\"0.2.0\",\"yanked\":false},{\"digest\":\"b3:0.1.0\",\"runtime\":{\"major\":0,\"minor\":16,\"patch\":0},\"version\":\"0.1.0\",\"yanked\":true}]}",
  );
  assert_eq(json::decode_string(text, index_json()), Ok(x))
}

test "decoding an index whose version text is not a version fails with an error giving the path of that field" {
  let text = "{\"name\":\"orders\",\"versions\":[{\"digest\":\"b3:ab\",\"runtime\":{\"major\":0,\"minor\":1,\"patch\":0},\"version\":\"latest\",\"yanked\":false}]}";
  match json::decode_string(text, index_json()) {
    Ok(_) -> panic("`latest` is not a version"),
    Err(e) ->
      assert_eq(
        json::error_to_string(e),
        "$.versions[0].version: `latest` is not a version such as `0.1.0`",
      ),
  }
}
