//! INI: sections of `key = value` lines, parsed so that a file can be written back with one value
//! changed and nothing else touched.
//!
//! INI has no standard, so the dialect parsed here is the contract. A text is lines separated by
//! line feeds. A blank is a space, a tab or a carriage return. After the blanks at its start, a
//! line is one of four things:
//!
//! - Blank, when nothing is left. - A comment, when it starts with `#` or `;`. The comment runs to
//! the end of the line. - A section header, when it starts with `[`. The name runs to the first
//! `]`, without the blanks around it, and is not empty. Only blanks or a comment may follow the
//! `]`. Names do not nest, so `[a.b]` and `[a "b"]` are the sections named `a.b` and `a "b"`. - An
//! entry, otherwise. The key is the text before the first `=` and the value is the text after it,
//! each without the blanks around it. The key is not empty.
//!
//! A line that is none of these is rejected.
//!
//! An entry above the first header is in the section whose name is the empty text. A header that
//! names a section again reopens it, and a key may appear more than once: `get` returns its last
//! value and `get_all` returns every value. Keys and names match exactly as written. A value is the
//! characters on its line: its quotes are part of it, a backslash is a backslash, a `#` or `;` in
//! it is part of it, nothing is substituted into it, and no line continues another.
//!
//! Git's configuration, systemd's units, Python's `configparser` and Windows' profile files parse
//! such a text differently, and `Options` has a field for each choice where they differ. `defaults`
//! is the dialect above. A `Document` stores every line as it was written, so `render` returns the
//! text `read` was given, byte for byte. `set` rewrites one value and leaves the blanks and the
//! comment of its line, and every other line, unchanged. `read`, `line`, `set` and `add` raise
//! `ini.fail` with the line and the reason, and `decode` returns the same error as an `Err`. `read`
//! takes the maximum number of bytes of text it will accept.

import std.bytes
import std.laws (round_trip)
import std.list
import std.list (enumerate, zip)
import std.string
import std.unicode
import std.gen

/// The choices where INI readers differ. `defaults` makes each choice as most of them do.
pub type Options = new {
  /// Whether `#` starts a comment.
  hash: Bool,
  /// Whether `;` starts a comment.
  semicolon: Bool,
  /// Whether a comment may follow a value, or a key with no value, on its line. It starts at the
  /// first `#` or `;` that has a blank before it, so one with no blank before it is still part of
  /// the value.
  trailing_comments: Bool,
  /// Whether `:` separates a key from its value as `=` does, whichever comes first.
  colon: Bool,
  /// Whether a value that starts with `"` runs to the closing `"`, keeping the blanks and comment
  /// characters between them, with `\\`, `\"`, `\n`, `\t` and `\r` as its escapes. Only blanks or
  /// a comment may follow the closing quote.
  quotes: Bool,
  /// Whether a line with no delimiter is a key with no value. Otherwise such a line is rejected.
  bare_keys: Bool,
  /// Whether a key may appear again in its section. Otherwise the second one is rejected.
  repeats: Bool,
  /// Whether keys and section names match regardless of letter case, by comparing their Unicode
  /// lower case, as Python's `configparser` folds a key.
  any_case: Bool,
}

/// Returns the default dialect: `#` and `;` start comments only on lines of their own, only `=`
/// separates a key from its value, values are taken as written, a line with no `=` is rejected,
/// keys may repeat, and keys and section names match case-sensitively.
pub fn defaults() -> Options =
  {
    hash: true,
    semicolon: true,
    trailing_comments: false,
    colon: false,
    quotes: false,
    bare_keys: false,
    repeats: true,
    any_case: false,
  }

/// A key and its value, which is `None` when the line has no delimiter.
pub type Entry = new { key: String, value: Option<String> }

/// What a line is.
pub type LineKind =
  /// Nothing but blanks.
  | Blank
  /// A comment on a line of its own.
  | Comment
  /// A section header, by its name.
  | Header(String)
  /// A key and its value, with quotes and escapes removed when the dialect uses quotes.
  | Entry(Entry)

/// One line: what it is, and its text as written, without its line feed.
pub type Line = new { what: LineKind, text: String }

/// A parsed text: the dialect it was parsed in, and its lines in order. The text is the lines
/// joined by line feeds, so a text that ends in a line feed ends in an empty line.
pub type Document = new { options: Options, lines: List<Line> }

/// Why a text is not INI in a dialect, or why the dialect cannot write what was requested.
pub type ErrorKind =
  /// The text is longer than the limit the reader was given.
  | TooLong
  /// A line that is not a comment or a header, and has no delimiter to separate a key from a
  /// value.
  | NoDelimiter
  /// An entry with nothing before its delimiter.
  | NoKey
  /// A header with no `]`, no name, or something other than blanks or a comment after its `]`.
  | BadHeader
  /// A quoted value with no closing quote, or with something other than blanks or a comment
  /// after it.
  | BadQuote
  /// A backslash in a quoted value before a character that is not an escape.
  | BadEscape
  /// A key that appears again in its section, in a dialect whose keys may not repeat.
  | Repeated
  /// A key, a section name or a value the dialect cannot write in a form that parses back.
  | Unwritable

/// An error and the line it is about, counted from one. For `TooLong` it is the first line; for a
/// write, it is the line the new text would have had.
pub type Error = new { line: Int, reason: ErrorKind }

/// What this module's readers and writers raise when they fail.
pub effect ini {
  /// The text is not INI in the dialect, or the dialect cannot write what was requested.
  raise fail(e: Error)
}

/// A sentence for each reason, for a message to a person.
pub fn explain(reason: ErrorKind) -> String =
  match reason {
    TooLong -> "the text is longer than the limit the reader was given",
    NoDelimiter ->
      "a line must be a comment, a `[section]` header, or a key and a value separated by a delimiter",
    NoKey -> "an entry has no key before its delimiter",
    BadHeader ->
      "a header must be `[name]` with a non-empty name, followed by nothing except an optional comment",
    BadQuote -> "a quoted value closes with `\"`, and nothing but a comment follows it",
    BadEscape -> "the escapes of a quoted value are \\\\ \\\" \\n \\t and \\r",
    Repeated -> "a key may be written only once in a section",
    Unwritable ->
      "the INI writer cannot save this key, section name or value in a way that reading the file returns the same value",
  }

/// Parses `text` in the dialect `options`. A text of more than `limit` bytes is rejected without
/// being parsed. Raises `ini.fail` where `decode` returns `Err`.
pub fn read(text: String, options: Options, limit: Int) -> Document / {ini.fail, abort.raise} = {
  let raw = Bytes::of_string(text);
  if raw.len() > limit { fail(1, TooLong) } else {
    let doc: Document = {
      options: options,
      lines: raw.split(b"\n").fold([], |lines: List<Line>, row: Bytes|
        lines.push({
          what: shape(row, lines.len() + 1, options).what,
          text: String::of_bytes(row),
        })),
    };
    if options.repeats { doc } else { check_unique_keys(doc) }
  }
}

/// Parses `text`, or returns the line where it stops being INI and why.
pub fn decode(
  text: String,
  options: Options,
  limit: Int,
) -> Result<Document, Error> / {abort.raise} = try { read(text, options, limit) }

/// Parses one line on its own, as `read` parses each line of a text. `number` is the line number
/// an error reports. A line feed in `text` is an ordinary character here, where `read` would have
/// ended the line.
pub fn line(text: String, number: Int, options: Options) -> Line / {ini.fail, abort.raise} =
  { what: shape(Bytes::of_string(text), number, options).what, text: text }

/// The text of a document: every line as it stands, with a line feed between each two.
pub fn render(doc: Document) -> String =
  String::of_bytes_lossy(Bytes::join(doc.lines.map(|l: Line| Bytes::of_string(l.text)), b"\n"))

/// Returns a document with a single empty line, which `render` writes as the empty text.
pub fn empty(options: Options) -> Document = { options: options, lines: [blank_line()] }

fn blank_line() -> Line = { what: Blank, text: "" }

fn fail<a>(line: Int, reason: ErrorKind) -> a / {ini.fail} =
  ini.fail({ line: line, reason: reason })

type Shape = { what: LineKind, key: Int, key_end: Int, from: Int, to: Int }

fn plain(what: LineKind) -> Shape = { what: what, key: 0, key_end: 0, from: 0, to: 0 }

fn blanks() -> Bytes = b" \t\r"

fn is_comment_marker(o: Options, c: Int) -> Bool = (c == 35 && o.hash) || (c == 59 && o.semicolon)

fn delimiters(o: Options) -> Bytes = if o.colon { b"=:" } else { b"=" }

fn shape(row: Bytes, number: Int, o: Options) -> Shape / {ini.fail, abort.raise} = {
  let lead = row.skip(0, blanks());
  let c = row.peek(lead);
  if c < 0 { plain(Blank) }
  else if is_comment_marker(o, c) { plain(Comment) }
  else if c == 91 { plain(Header(header_name(row, lead, number, o))) }
  else { entry_shape(row, lead, number, o) }
}

fn header_name(row: Bytes, lead: Int, number: Int, o: Options) -> String / {ini.fail, abort.raise} = {
  let n = row.len();
  let close = row.skip_until(lead + 1, b"]");
  let from = min(row.skip(lead + 1, blanks()), close);
  let to = trimmed_end(row, from, close);
  let after = row.skip(close + 1, blanks());
  if close >= n || to == from || (after < n && !is_comment_marker(o, row.at(after))) {
    fail(number, BadHeader)
  } else { String::of_bytes(row.slice(from, to)) }
}

fn trimmed_end(row: Bytes, from: Int, to: Int) -> Int / {abort.raise} =
  if to > from && blanks().index_of_byte(row.at(to - 1)) != None { trimmed_end(row, from, to - 1) }
  else { to }

fn comment_from(row: Bytes, from: Int, o: Options) -> Int / {abort.raise} =
  if !o.trailing_comments { row.len() } else {
    openers(o).fold(row.len(), |first_at: Int, opener: Bytes|
      match row.index_of_from(opener, from) { Some(at) -> min(first_at, at + 1), None -> first_at })
  }

fn openers(o: Options) -> List<Bytes> = {
  let hashes = if o.hash { [b" #", b"\t#", b"\r#"] } else { [] };
  let semicolons = if o.semicolon { [b" ;", b"\t;", b"\r;"] } else { [] };
  hashes.concat(semicolons)
}

fn entry_shape(row: Bytes, lead: Int, number: Int, o: Options) -> Shape / {ini.fail, abort.raise} = {
  let cut = row.skip_until(lead, delimiters(o));
  let note = comment_from(row, lead, o);
  if cut >= note {
    if !o.bare_keys { fail(number, NoDelimiter) } else {
      let end = trimmed_end(row, lead, note);
      {
        what: Entry({ key: String::of_bytes(row.slice(lead, end)), value: None }),
        key: lead,
        key_end: end,
        from: end,
        to: end,
      }
    }
  } else {
    let key_end = trimmed_end(row, lead, cut);
    if key_end == lead { fail(number, NoKey) }
    else { valued_entry_shape(row, lead, key_end, cut, number, o) }
  }
}

fn valued_entry_shape(
  row: Bytes,
  lead: Int,
  key_end: Int,
  cut: Int,
  number: Int,
  o: Options,
) -> Shape / {ini.fail, abort.raise} = {
  let n = row.len();
  let key = String::of_bytes(row.slice(lead, key_end));
  let start = row.skip(cut + 1, blanks());
  if o.quotes && row.peek(start) == 34 {
    let q = read_quoted(row, start + 1, number);
    let after = row.skip(q.end, blanks());
    if after < n && !is_comment_marker(o, row.at(after)) { fail(number, BadQuote) } else {
      {
        what: Entry({ key: key, value: Some(String::of_bytes(q.value)) }),
        key: lead,
        key_end: key_end,
        from: start,
        to: q.end,
      }
    }
  } else {
    let end = trimmed_end(row, start, comment_from(row, cut + 1, o));
    let hollow = end == start && start < n;
    {
      what: Entry({ key: key, value: Some(String::of_bytes(row.slice(start, end))) }),
      key: lead,
      key_end: key_end,
      from: if hollow { cut + 1 } else { start },
      to: if hollow { cut + 1 } else { end },
    }
  }
}

fn read_quoted(
  row: Bytes,
  from: Int,
  number: Int,
) -> { value: Bytes, end: Int } / {ini.fail, abort.raise} =
  iterate({ at: from, read: b"" }, row.len() + 1, |s: { at: Int, read: Bytes }| {
    let stop = row.skip_until(s.at, b"\"\\");
    let read = s.read.concat(row.slice(s.at, stop));
    if stop >= row.len() { fail(number, BadQuote) }
    else if row.at(stop) == 34 { Stop({ value: read, end: stop + 1 }) }
    else { Continue({ at: stop + 2, read: read.concat(unescaped(row.peek(stop + 1), number)) }) }
  })

fn unescaped(c: Int, number: Int) -> Bytes / {ini.fail} =
  if c == 92 { b"\\" }
  else if c == 34 { b"\"" }
  else if c == 110 { b"\n" }
  else if c == 116 { b"\t" }
  else if c == 114 { b"\r" }
  else if c < 0 { fail(number, BadQuote) }
  else { fail(number, BadEscape) }

type LocatedEntry = { at: Int, section: String, entry: Entry }

type EntryScan = { at: Int, section: String, found: List<LocatedEntry> }

fn located_entries(doc: Document) -> List<LocatedEntry> =
  doc.lines.fold({ at: 0, section: "", found: [] }, |w: EntryScan, l: Line|
    match l.what {
      Header(name) -> { at: w.at + 1, section: name, found: w.found },
      Entry(e) ->
        {
          at: w.at + 1,
          section: w.section,
          found: w.found.push({ at: w.at, section: w.section, entry: e }),
        },
      _ -> { at: w.at + 1, section: w.section, found: w.found },
    }).found

fn case_folded(o: Options, name: String) -> String =
  if o.any_case { unicode::lowercase(name) } else { name }

fn same(o: Options, a: String, b: String) -> Bool = case_folded(o, a) == case_folded(o, b)

fn section_entries(doc: Document, section: String) -> List<LocatedEntry> =
  located_entries(doc).filter(|p: LocatedEntry| same(doc.options, p.section, section))

fn key_entries(doc: Document, section: String, key: String) -> List<LocatedEntry> =
  section_entries(doc, section).filter(|p: LocatedEntry| same(doc.options, p.entry.key, key))

/// Returns the value of `key` in `section`, or the last value if the key appears more than once. A
/// key written without a value returns the empty string, the same as a key with an empty value; use
/// `entries` to tell the two apart, since an entry without a value has `value: None`. `section` is
/// the empty string for entries above the first header.
pub fn get(doc: Document, section: String, key: String) -> Option<String> =
  get_all(doc, section, key).last()

/// Every value of `key` in `section`, in the order they are written.
pub fn get_all(doc: Document, section: String, key: String) -> List<String> =
  key_entries(doc, section, key).map(|p: LocatedEntry|
    match p.entry.value { Some(v) -> v, None -> "" })

/// Returns every entry of `section` in the order written, including entries under every header that
/// names the section.
pub fn entries(doc: Document, section: String) -> List<Entry> =
  section_entries(doc, section).map(|p: LocatedEntry| p.entry)

/// The keys of `section`, each once, in the order they are first written.
pub fn keys(doc: Document, section: String) -> List<String> =
  distinct(doc.options, section_entries(doc, section).map(|p: LocatedEntry| p.entry.key))

/// The section names in the document's headers, each once, in the order they first appear. The
/// section above the first header has no name and is not among them.
pub fn sections(doc: Document) -> List<String> =
  distinct(
    doc.options,
    doc.lines.fold([], |names: List<String>, l: Line|
      match l.what { Header(name) -> names.push(name), _ -> names }),
  )

type Distinct = { seen: Map<String, Unit>, unique: List<String> }

fn distinct(o: Options, names: List<String>) -> List<String> =
  names.fold({ seen: Map::new(), unique: [] }, |d: Distinct, name: String|
    if d.seen.contains(case_folded(o, name)) { d }
    else { { seen: d.seen.insert(case_folded(o, name), ()), unique: d.unique.push(name) } }).unique

fn check_unique_keys(doc: Document) -> Document / {ini.fail} = {
  let o = doc.options;
  let _ = located_entries(doc).fold(Map::new(), |seen: Map<List<String>, Unit>, p: LocatedEntry| {
    let name = [case_folded(o, p.section), case_folded(o, p.entry.key)];
    if seen.contains(name) { fail(p.at + 1, Repeated) } else { seen.insert(name, ()) }
  });
  doc
}

/// Returns `doc` with `key` in `section` set to `value`. If the key exists, the value of its last
/// entry is rewritten in place. The new value is quoted if the old value was quoted, or if it
/// cannot be written unquoted. The line's blanks and comment, the key as written, and every other
/// line stay unchanged. If the key does not exist, this is `add`. Fails with `ini.fail` and
/// `Unwritable` for a value the dialect cannot write in a form that parses back. When the dialect's
/// `quotes` option is off, that is a value that contains a line feed, starts or ends with a blank,
/// or, when `trailing_comments` is on, contains a `#` or `;` after a blank, which would start a
/// comment.
pub fn set(
  doc: Document,
  section: String,
  key: String,
  value: String,
) -> Document / {ini.fail, abort.raise} =
  match key_entries(doc, section, key).last() {
    Some(p) -> rewrite_value(doc, p, value),
    None -> add(doc, section, key, value),
  }

/// `doc` with a new entry for `key` in `section`, whatever entries the key already has there. The
/// line goes after the section's last entry and copies its style: its indent and the blanks around
/// its delimiter. In a section with no entries, the line goes after its header as `key = value`.
/// In the section above the first header, it goes below the comments at the start of the text
/// when a blank line follows them, and at the top otherwise. A section the document does not have
/// is added at the end. The line ends as the line above it does, with or without a carriage
/// return. Raises `ini.fail` with `Unwritable` for a key, a name or a value the dialect cannot
/// write in a form that parses back, and with `Repeated` when the dialect's keys may not repeat
/// and the section has the key.
pub fn add(
  doc: Document,
  section: String,
  key: String,
  value: String,
) -> Document / {ini.fail, abort.raise} = {
  let spot = placement_for(doc, section);
  if !doc.options.repeats && key_entries(doc, section, key).len() > 0 {
    fail(spot.at + 1, Repeated)
  } else {
    let end = line_ending(doc, spot.at);
    let header = if spot.opens { [header_line(doc.options, section, end, spot.at + 1)] }
    else { [] };
    let entry = entry_line(doc.options, spot.indent ++ key ++ spot.separator, value, end, {
      line: spot.at + header.len() + 1,
      key: key,
      quoted_first: false,
    });
    {
      options: doc.options,
      lines: doc.lines.take(spot.at).concat(header.push(entry)).concat(doc.lines.drop(spot.at)),
    }
  }
}

/// `doc` without the entries of `key` in `section`; every other line stays as it is.
pub fn remove(doc: Document, section: String, key: String) -> Document = {
  let gone = key_entries(doc, section, key).fold(
    Map::new(),
    |at: Map<Int, Unit>, p: LocatedEntry| at.insert(p.at, ()),
  );
  {
    options: doc.options,
    lines: enumerate(doc.lines).filter(|l: { index: Int, value: Line }|
      !gone.contains(l.index)).map(|l: { index: Int, value: Line }| l.value),
  }
}

type Placement = { at: Int, indent: String, separator: String, opens: Bool }

fn placement_for(doc: Document, section: String) -> Placement / {ini.fail, abort.raise} =
  match section_entries(doc, section).last() {
    Some(p) -> styled_after(doc, p.at),
    None -> match header_indexes(doc, section).last() {
      Some(at) -> { at: at + 1, indent: "", separator: " = ", opens: false },
      None -> if section == "" { { at: top_of(doc), indent: "", separator: " = ", opens: false } }
      else { { at: bottom_of(doc), indent: "", separator: " = ", opens: true } },
    },
  }

fn styled_after(doc: Document, at: Int) -> Placement / {ini.fail, abort.raise} = {
  let row = Bytes::of_string(doc.lines.get(at).text);
  let s = shape(row, at + 1, doc.options);
  {
    at: at + 1,
    indent: String::of_bytes(row.slice(0, s.key)),
    separator: if s.from > s.key_end { String::of_bytes(row.slice(s.key_end, s.from)) }
    else { " = " },
    opens: false,
  }
}

fn header_indexes(doc: Document, section: String) -> List<Int> =
  enumerate(doc.lines).fold([], |found: List<Int>, l: { index: Int, value: Line }|
    match l.value.what {
      Header(name) -> if same(doc.options, name, section) { found.push(l.index) } else { found },
      _ -> found,
    })

type Top = { at: Int, below: Int, open: Bool }

fn top_of(doc: Document) -> Int =
  enumerate(doc.lines).fold(
    { at: 0, below: 0, open: true },
    |t: Top, l: { index: Int, value: Line }|
      if !t.open { t } else {
        match l.value.what {
          Header(_) -> { at: t.at, below: t.below, open: false },
          Blank -> { at: t.below, below: t.below, open: true },
          _ -> { at: t.at, below: l.index + 1, open: true },
        }
      },
  ).at

fn bottom_of(doc: Document) -> Int =
  match doc.lines.last() {
    Some(l) -> if l.text == "" { doc.lines.len() - 1 } else { doc.lines.len() },
    None -> 0,
  }

fn line_ending(doc: Document, at: Int) -> String =
  match doc.lines.at(if at > 0 { at - 1 } else { 0 }) {
    Some(l) -> if l.text.ends_with("\r") { "\r" } else { "" },
    None -> "",
  }

type Wanted = { line: Int, key: String, quoted_first: Bool }

fn entry_line(
  o: Options,
  head: String,
  value: String,
  tail: String,
  w: Wanted,
) -> Line / {ini.fail, abort.raise} = {
  let what = Entry({ key: w.key, value: Some(value) });
  let bare = head ++ value ++ tail;
  let tried = if !o.quotes { [bare] }
  else if w.quoted_first { [head ++ in_quotes(value) ++ tail, bare] }
  else { [bare, head ++ in_quotes(value) ++ tail] };
  match tried.filter(|text: String| parses_as(o, text, what)) {
    [text, ..] -> { what: what, text: text },
    [] -> fail(w.line, Unwritable),
  }
}

fn header_line(
  o: Options,
  name: String,
  tail: String,
  number: Int,
) -> Line / {ini.fail, abort.raise} = {
  let text = "[" ++ name ++ "]" ++ tail;
  if parses_as(o, text, Header(name)) { { what: Header(name), text: text } }
  else { fail(number, Unwritable) }
}

fn parses_as(o: Options, text: String, what: LineKind) -> Bool / {abort.raise} = {
  let read = try { shape(Bytes::of_string(text), 0, o) };
  !text.contains("\n") && (match read { Ok(s) -> s.what == what, Err(_) -> false })
}

fn in_quotes(value: String) -> String / {abort.raise} = {
  let raw = Bytes::of_string(value);
  let escaped = [
    { from: b"\\", to: b"\\\\" },
    { from: b"\"", to: b"\\\"" },
    { from: b"\n", to: b"\\n" },
    { from: b"\t", to: b"\\t" },
    { from: b"\r", to: b"\\r" },
  ].fold(raw, |text: Bytes, e: { from: Bytes, to: Bytes }| text.replace(e.from, e.to));
  "\"" ++ String::of_bytes(escaped) ++ "\""
}

fn rewrite_value(
  doc: Document,
  p: LocatedEntry,
  value: String,
) -> Document / {ini.fail, abort.raise} = {
  let row = Bytes::of_string(doc.lines.get(p.at).text);
  let s = shape(row, p.at + 1, doc.options);
  let valued_entry_shape = p.entry.value != None;
  let head = String::of_bytes(row.slice(0, s.from))
    ++ (if valued_entry_shape { "" } else { " = " });
  let tail = String::of_bytes(row.slice(s.to, row.len()));
  let line = entry_line(doc.options, head, value, tail, {
    line: p.at + 1,
    key: p.entry.key,
    quoted_first: valued_entry_shape && row.peek(s.from) == 34,
  });
  { options: doc.options, lines: doc.lines.set(p.at, line) }
}

fn size_limit() -> Int = 1_000_000

fn all_enabled() -> Options =
  {
    hash: true,
    semicolon: true,
    trailing_comments: true,
    colon: true,
    quotes: true,
    bare_keys: true,
    repeats: true,
    any_case: true,
  }

fn quoting() -> Options = { ..defaults(), quotes: true }

test "a text that parses is written back byte for byte" {
  gen::check(gen::text(), |text: String| {
    match decode(text, all_enabled(), size_limit()) {
      Ok(doc) -> render(doc) == text,
      Err(_) -> true,
    }
  })
}

test "a value that is set is the value parsed back from the text" {
  gen::check(gen::text(), |x: String|
    round_trip(
      |value: String| render(set(empty(quoting()), "section", "key", value)),
      |text: String| get(read(text, quoting(), size_limit()), "section", "key"),
      x,
    ))
}

type Reading = { name: String, options: Options, text: String, kind: LineKind }

fn entry(key: String, value: String) -> LineKind = Entry({ key: key, value: Some(value) })

fn readings() -> List<Reading> =
  [
    { name: "a line of blanks", options: defaults(), text: " \t\r", kind: Blank },
    { name: "a `#` comment", options: defaults(), text: "# key = value", kind: Comment },
    { name: "an indented `;` comment", options: defaults(), text: "  ; [core]", kind: Comment },
    { name: "a header", options: defaults(), text: "[core]", kind: Header("core") },
    {
      name: "a header's blanks, inside and out",
      options: defaults(),
      text: "\t[ two words ]  \r",
      kind: Header("two words"),
    },
    { name: "a dotted name", options: defaults(), text: "[a.b]", kind: Header("a.b") },
    {
      name: "a quoted subsection",
      options: defaults(),
      text: "[remote \"origin\"]",
      kind: Header("remote \"origin\""),
    },
    {
      name: "a comment after a header",
      options: defaults(),
      text: "[core] ; noted",
      kind: Header("core"),
    },
    { name: "an entry", options: defaults(), text: "key=value", kind: entry("key", "value") },
    {
      name: "the blanks around a key and a value",
      options: defaults(),
      text: "  two words\t=\tsome value  \r",
      kind: entry("two words", "some value"),
    },
    { name: "an empty value", options: defaults(), text: "key =", kind: entry("key", "") },
    { name: "the first `=`", options: defaults(), text: "a=b=c", kind: entry("a", "b=c") },
    {
      name: "quotes, kept",
      options: defaults(),
      text: "key = \"value\"",
      kind: entry("key", "\"value\""),
    },
    {
      name: "a backslash, kept",
      options: defaults(),
      text: "path = C:\\dir\\n",
      kind: entry("path", "C:\\dir\\n"),
    },
    {
      name: "a comment character in a value, left in the value",
      options: defaults(),
      text: "key = a # b ; c",
      kind: entry("key", "a # b ; c"),
    },
    { name: "a colon in a key", options: defaults(), text: "a:b = c", kind: entry("a:b", "c") },
    {
      name: "a `#` that opens no comment",
      options: { ..defaults(), hash: false },
      text: "#key = value",
      kind: entry("#key", "value"),
    },
    {
      name: "a `;` that opens no comment",
      options: { ..defaults(), semicolon: false },
      text: ";key = value",
      kind: entry(";key", "value"),
    },
    {
      name: "a comment after a value",
      options: { ..defaults(), trailing_comments: true },
      text: "key = value # noted ; twice",
      kind: entry("key", "value"),
    },
    {
      name: "a comment character with no blank before it",
      options: { ..defaults(), trailing_comments: true },
      text: "url = https://example.com/a#b;c",
      kind: entry("url", "https://example.com/a#b;c"),
    },
    {
      name: "a comment after an empty value",
      options: { ..defaults(), trailing_comments: true },
      text: "key = # noted",
      kind: entry("key", ""),
    },
    {
      name: "a mark right after the delimiter",
      options: { ..defaults(), trailing_comments: true },
      text: "key =# value",
      kind: entry("key", "# value"),
    },
    {
      name: "a colon as a delimiter",
      options: { ..defaults(), colon: true },
      text: "key: a=b",
      kind: entry("key", "a=b"),
    },
    {
      name: "an `=` before a colon",
      options: { ..defaults(), colon: true },
      text: "key = a:b",
      kind: entry("key", "a:b"),
    },
    {
      name: "a quoted value's blanks",
      options: quoting(),
      text: "key = \"  padded  \"",
      kind: entry("key", "  padded  "),
    },
    {
      name: "a quoted value's escapes",
      options: quoting(),
      text: "key = \"a \\\"b\\\" \\\\ \\n\\t\\r\"",
      kind: entry("key", "a \"b\" \\ \n\t\r"),
    },
    {
      name: "a comment character inside quotes",
      options: { ..all_enabled(), colon: false },
      text: "key = \"a # b\" # noted",
      kind: entry("key", "a # b"),
    },
    {
      name: "a comment right after a closing quote",
      options: quoting(),
      text: "key = \"a\";noted",
      kind: entry("key", "a"),
    },
    {
      name: "a quote that does not open a value",
      options: quoting(),
      text: "key = a \"b\"",
      kind: entry("key", "a \"b\""),
    },
    {
      name: "an empty quoted value",
      options: quoting(),
      text: "key = \"\"",
      kind: entry("key", ""),
    },
    {
      name: "a key with no value",
      options: { ..defaults(), bare_keys: true },
      text: "  flag  ",
      kind: Entry({ key: "flag", value: None }),
    },
    {
      name: "a key with no value before a comment",
      options: { ..all_enabled(), colon: false },
      text: "flag # key = value",
      kind: Entry({ key: "flag", value: None }),
    },
    {
      name: "a key's letter case is kept",
      options: { ..defaults(), any_case: true },
      text: "KeY = Value",
      kind: entry("KeY", "Value"),
    },
  ]

test "`line` parses the INI line {c.name} into the expected kind of line and keeps its text" for c: Reading in readings(
  ) { assert_eq(line(c.text, 1, c.options), { what: c.kind, text: c.text }) }

type Rejected = { name: String, options: Options, text: String, line: Int, reason: ErrorKind }

fn rejected() -> List<Rejected> =
  [
    {
      name: "a line with no delimiter",
      options: defaults(),
      text: "a = 1\n\njust words\n",
      line: 3,
      reason: NoDelimiter,
    },
    {
      name: "a colon between key and value where only `=` is allowed",
      options: defaults(),
      text: "key: value",
      line: 1,
      reason: NoDelimiter,
    },
    {
      name: "a line after a carriage return and a line feed",
      options: defaults(),
      text: "a = 1\r\n\r\nwords\r\n",
      line: 3,
      reason: NoDelimiter,
    },
    {
      name: "an entry with no key",
      options: defaults(),
      text: "[a]\n = value",
      line: 2,
      reason: NoKey,
    },
    {
      name: "a header that never closes",
      options: defaults(),
      text: "[core\nkey = value",
      line: 1,
      reason: BadHeader,
    },
    {
      name: "a header with no name",
      options: defaults(),
      text: "[  ]",
      line: 1,
      reason: BadHeader,
    },
    {
      name: "a header with text after it",
      options: defaults(),
      text: "[core] key = value",
      line: 1,
      reason: BadHeader,
    },
    {
      name: "a value in quotes that never close",
      options: quoting(),
      text: "key = \"value",
      line: 1,
      reason: BadQuote,
    },
    {
      name: "a value whose quotes end on a backslash",
      options: quoting(),
      text: "key = \"value\\",
      line: 1,
      reason: BadQuote,
    },
    {
      name: "text after a closing quote",
      options: quoting(),
      text: "a = \"b\"\nkey = \"value\" more",
      line: 2,
      reason: BadQuote,
    },
    {
      name: "an escape the dialect lacks",
      options: quoting(),
      text: "key = \"C:\\dir\"",
      line: 1,
      reason: BadEscape,
    },
    {
      name: "a key written twice where keys do not repeat",
      options: { ..defaults(), repeats: false },
      text: "[a]\nkey = 1\n[b]\nkey = 2\n[a]\nkey = 3\n",
      line: 6,
      reason: Repeated,
    },
    {
      name: "a key written twice in another case",
      options: { ..defaults(), repeats: false, any_case: true },
      text: "Key = 1\nkEY = 2",
      line: 2,
      reason: Repeated,
    },
    {
      name: "a key with no value where every key needs a value",
      options: { ..defaults(), trailing_comments: true },
      text: "flag # key = value",
      line: 1,
      reason: NoDelimiter,
    },
  ]

test "`decode` rejects the INI input {c.name} with the expected line number and reason, and `explain` describes that reason" for c: Rejected in rejected(
  ) {
  assert_eq(decode(c.text, c.options, size_limit()), Err({ line: c.line, reason: c.reason }));
  assert(explain(c.reason).len() > 0)
}

test "a text over the limit is rejected without parsing, and one at the limit parses" {
  assert_eq(decode("key = é\n", defaults(), 8), Err({ line: 1, reason: TooLong }));
  assert_eq(
    decode("key = é\n", defaults(), 9),
    Ok({
      options: defaults(),
      lines: [{ what: entry("key", "é"), text: "key = é" }, { what: Blank, text: "" }],
    }),
  )
}

test "a text is its lines joined by line feeds, so every text is written back" {
  let back = |text: String| render(read(text, defaults(), size_limit()));
  assert_eq(read("", defaults(), size_limit()).lines.len(), 1);
  assert_eq(read("", defaults(), size_limit()), empty(defaults()));
  assert_eq(read("a = 1\n", defaults(), size_limit()).lines.len(), 2);
  assert_eq(read("a = 1", defaults(), size_limit()).lines.len(), 1);
  assert_eq(back(""), "");
  assert_eq(back("\n\n"), "\n\n");
  assert_eq(back("  a  =  1  \r\n\t; c\r\n[ s ]\r\nb=2"), "  a  =  1  \r\n\t; c\r\n[ s ]\r\nb=2")
}

test "a line parsed alone treats a line feed as a character" {
  assert_eq(line("key = two\nlines", 7, defaults()).what, entry("key", "two\nlines"));
  assert_eq(try { line("words", 7, defaults()) }, Err({ line: 7, reason: NoDelimiter }))
}

fn nested() -> String =
  \\top = 1
  \\[a]
  \\x = 1
  \\x = 2
  \\flag
  \\[b]
  \\x = 3
  \\[A]
  \\y =
  \\X = 5

test "a key is looked up in its section, and its last value is returned" {
  let doc = read(nested(), { ..defaults(), bare_keys: true }, size_limit());
  assert_eq(get(doc, "a", "x"), Some("2"));
  assert_eq(get_all(doc, "a", "x"), ["1", "2"]);
  assert_eq(get(doc, "b", "x"), Some("3"));
  assert_eq(get(doc, "", "top"), Some("1"));
  assert_eq(get(doc, "", "x"), None);
  assert_eq(get(doc, "a", "top"), None);
  assert_eq(get(doc, "c", "x"), None);
  assert_eq(get_all(doc, "c", "x"), [])
}

test "a key with no value returns the empty text from `get`, and `entries` records it as having no value, unlike an empty value" {
  let doc = read(nested(), { ..defaults(), bare_keys: true }, size_limit());
  assert_eq(get(doc, "a", "flag"), Some(""));
  assert_eq(get(doc, "A", "y"), Some(""));
  assert_eq(entries(doc, "a"), [
    { key: "x", value: Some("1") },
    { key: "x", value: Some("2") },
    { key: "flag", value: None },
  ]);
  assert_eq(entries(doc, "A"), [{ key: "y", value: Some("") }, { key: "X", value: Some("5") }])
}

test "sections and keys are listed once each, in the order they first appear" {
  let doc = read(nested(), { ..defaults(), bare_keys: true }, size_limit());
  assert_eq(sections(doc), ["a", "b", "A"]);
  assert_eq(keys(doc, "a"), ["x", "flag"]);
  assert_eq(keys(doc, ""), ["top"]);
  assert_eq(keys(doc, "c"), []);
  assert_eq(sections(read("# nothing\n", defaults(), size_limit())), [])
}

test "a section opened again is one section, and case is ignored only when the dialect says so" {
  let case_folded = read(nested(), { ..defaults(), bare_keys: true, any_case: true }, size_limit());
  assert_eq(sections(case_folded), ["a", "b"]);
  assert_eq(keys(case_folded, "A"), ["x", "flag", "y"]);
  assert_eq(get_all(case_folded, "a", "X"), ["1", "2", "5"]);
  assert_eq(get(case_folded, "A", "x"), Some("5"));
  let again = read("[a]\nx = 1\n[b]\n[a]\nx = 2\n", defaults(), size_limit());
  assert_eq(sections(again), ["a", "b"]);
  assert_eq(get_all(again, "a", "x"), ["1", "2"]);
  let accented = read("[Größe]\nÄnderung = 1\n", { ..defaults(), any_case: true }, size_limit());
  assert_eq(get(accented, "GRÖßE", "änderung"), Some("1"))
}

fn example_ini() -> String =
  \\# site.ini
  \\name = demo
  \\
  \\[server]
  \\  host = example.com   ; where it listens
  \\  port = 8080
  \\
  \\[paths]
  \\root=C:\data
  \\

fn trailing_comment_options() -> Options = { ..defaults(), trailing_comments: true }

test "`set` replaces one value and leaves the line's whitespace and trailing comment unchanged" {
  let doc = read(example_ini(), trailing_comment_options(), size_limit());
  assert_eq(
    render(set(doc, "server", "host", "example.org")),
    example_ini().replace("example.com", "example.org"),
  );
  assert_eq(
    render(set(doc, "paths", "root", "D:\\srv")),
    example_ini().replace("C:\\data", "D:\\srv"),
  );
  assert_eq(render(set(doc, "", "name", "")), example_ini().replace("name = demo", "name = "));
  assert_eq(get(set(doc, "server", "host", "example.org"), "server", "host"), Some("example.org"));
  assert_eq(render(set(doc, "server", "port", "8080")), example_ini())
}

test "a key written more than once has its last value set" {
  let doc = read("[a]\nx = 1\nx = 2\n[a]\nx = 3 \ny = 4\n", defaults(), size_limit());
  assert_eq(render(set(doc, "a", "x", "9")), "[a]\nx = 1\nx = 2\n[a]\nx = 9 \ny = 4\n")
}

test "`set` on a missing key adds an entry after the section's last entry, in the same formatting" {
  let doc = read(example_ini(), trailing_comment_options(), size_limit());
  assert_eq(
    render(set(doc, "server", "tls", "on")),
    example_ini().replace("  port = 8080\n", "  port = 8080\n  tls = on\n"),
  );
  assert_eq(
    render(set(doc, "paths", "cache", "/tmp")),
    example_ini().replace("root=C:\\data\n", "root=C:\\data\ncache=/tmp\n"),
  );
  assert_eq(
    render(set(doc, "", "owner", "ada")),
    example_ini().replace("name = demo\n", "name = demo\nowner = ada\n"),
  );
  assert_eq(
    render(add(doc, "server", "host", "example.net")),
    example_ini().replace("  port = 8080\n", "  port = 8080\n  host = example.net\n"),
  );
  assert_eq(
    render(
      add(
        read("[a]\nx=1\n[b]\n[a]\ny : 2\n", { ..defaults(), colon: true }, size_limit()),
        "a",
        "z",
        "3",
      ),
    ),
    "[a]\nx=1\n[b]\n[a]\ny : 2\nz : 3\n",
  )
}

test "`add` puts an entry under the header of a section with no entries, and adds a missing section at the end" {
  let at = |text: String, section: String|
    render(add(read(text, defaults(), size_limit()), section, "k", "v"));
  assert_eq(at("[a]\n[b]\nx=1\n", "a"), "[a]\nk = v\n[b]\nx=1\n");
  assert_eq(at("[a]\nx=1\n", "b"), "[a]\nx=1\n[b]\nk = v\n");
  assert_eq(at("[a]\nx=1", "b"), "[a]\nx=1\n[b]\nk = v");
  assert_eq(at("", "b"), "[b]\nk = v\n");
  assert_eq(at("", ""), "k = v\n");
  assert_eq(at("# opening\n\n[a]\n", ""), "# opening\nk = v\n\n[a]\n");
  assert_eq(at("# about a\n[a]\n", ""), "k = v\n# about a\n[a]\n");
  assert_eq(at("# only this\n", ""), "# only this\nk = v\n")
}

test "a line written into text with CRLF line endings also ends with CRLF" {
  let doc = read("[a]\r\nx = 1\r\n", defaults(), size_limit());
  assert_eq(render(set(doc, "a", "x", "2")), "[a]\r\nx = 2\r\n");
  assert_eq(render(set(doc, "a", "y", "2")), "[a]\r\nx = 1\r\ny = 2\r\n");
  assert_eq(render(set(doc, "b", "y", "2")), "[a]\r\nx = 1\r\n[b]\r\ny = 2\r\n");
  assert_eq(render(set(doc, "", "y", "2")), "y = 2\r\n[a]\r\nx = 1\r\n")
}

test "a value is written in quotes when it was in quotes or needs them" {
  let doc = read(
    "a = \"one\" ; noted\nb = two\nc = \"x\"#y\n",
    { ..all_enabled(), colon: false },
    size_limit(),
  );
  let text = |d: Document| render(d);
  assert_eq(text(set(doc, "", "a", "1")), "a = \"1\" ; noted\nb = two\nc = \"x\"#y\n");
  assert_eq(text(set(doc, "", "c", "z")), "a = \"one\" ; noted\nb = two\nc = \"z\"#y\n");
  assert_eq(text(set(doc, "", "b", "2")), "a = \"one\" ; noted\nb = 2\nc = \"x\"#y\n");
  assert_eq(
    text(set(doc, "", "b", " a \"b\"\n# c ")),
    "a = \"one\" ; noted\nb = \" a \\\"b\\\"\\n# c \"\nc = \"x\"#y\n",
  );
  assert_eq(get(set(doc, "", "b", " a \"b\"\n# c "), "", "b"), Some(" a \"b\"\n# c "))
}

test "`set` adds a delimiter to a key with no value, and leaves the trailing comment of an empty value in place" {
  let doc = read(
    "flag ; noted\nempty = ; noted\nbare\n",
    { ..all_enabled(), colon: false },
    size_limit(),
  );
  assert_eq(render(set(doc, "", "flag", "on")), "flag = on ; noted\nempty = ; noted\nbare\n");
  assert_eq(render(set(doc, "", "bare", "on")), "flag ; noted\nempty = ; noted\nbare = on\n");
  assert_eq(render(set(doc, "", "empty", "full")), "flag ; noted\nempty =full ; noted\nbare\n");
  assert_eq(get(set(doc, "", "empty", "full"), "", "empty"), Some("full"))
}

test "remove deletes every entry of a key and leaves the other lines" {
  let doc = read("[a]\nx = 1\n# kept\nx = 2\ny = 3\n[b]\nx = 4\n", defaults(), size_limit());
  assert_eq(render(remove(doc, "a", "x")), "[a]\n# kept\ny = 3\n[b]\nx = 4\n");
  assert_eq(remove(doc, "a", "z"), doc);
  assert_eq(remove(doc, "c", "x"), doc)
}

type Unwritten = { name: String, options: Options, section: String, key: String, value: String }

fn unwritten() -> List<Unwritten> =
  [
    {
      name: "a value of two lines",
      options: defaults(),
      section: "a",
      key: "k",
      value: "two\nlines",
    },
    {
      name: "a value that opens with a blank",
      options: defaults(),
      section: "a",
      key: "k",
      value: " v",
    },
    {
      name: "a value that ends in a carriage return",
      options: defaults(),
      section: "a",
      key: "k",
      value: "v\r",
    },
    {
      name: "a value that would open a comment",
      options: trailing_comment_options(),
      section: "a",
      key: "k",
      value: "v # w",
    },
    {
      name: "a key with the delimiter in it",
      options: defaults(),
      section: "a",
      key: "k=l",
      value: "v",
    },
    { name: "an empty key", options: defaults(), section: "a", key: "", value: "v" },
    {
      name: "a key that opens as a header",
      options: defaults(),
      section: "a",
      key: "[k",
      value: "v",
    },
    {
      name: "a key that opens as a comment",
      options: defaults(),
      section: "a",
      key: "#k",
      value: "v",
    },
    {
      name: "a key with blanks around it",
      options: defaults(),
      section: "a",
      key: " k ",
      value: "v",
    },
    {
      name: "a section name with a `]` in it",
      options: defaults(),
      section: "b]c",
      key: "k",
      value: "v",
    },
    {
      name: "a section name of two lines",
      options: defaults(),
      section: "b\nc",
      key: "k",
      value: "v",
    },
  ]

test "`set` fails with `Unwritable` and the line of the entry when the value cannot be written in case {c.name}" for c: Unwritten in unwritten(
  ) {
  let doc = read("[a]\nx = 1\n", c.options, size_limit());
  assert_eq(try { set(doc, c.section, c.key, c.value) }, Err({ line: 3, reason: Unwritable }))
}

test "`set` fails with `Unwritable` for a value with a leading space, but writes it in quotes when the options allow quoting" {
  let doc = read("[a]\nx = 1\ny = 2\n", defaults(), size_limit());
  assert_eq(try { set(doc, "a", "x", " v") }, Err({ line: 2, reason: Unwritable }));
  assert_eq(render(set(doc, "a", "x", "v # w")), "[a]\nx = v # w\ny = 2\n");
  let read_quoted = read("[a]\nx = 1\ny = 2\n", quoting(), size_limit());
  assert_eq(render(set(read_quoted, "a", "x", " v")), "[a]\nx = \" v\"\ny = 2\n")
}

test "a key is added again only when the dialect's keys may repeat" {
  let once = read("[a]\nx = 1\n", { ..defaults(), repeats: false }, size_limit());
  assert_eq(try { add(once, "a", "x", "2") }, Err({ line: 3, reason: Repeated }));
  assert_eq(render(set(once, "a", "x", "2")), "[a]\nx = 2\n");
  assert_eq(render(add(once, "a", "y", "2")), "[a]\nx = 1\ny = 2\n");
  let many = read("[a]\nx = 1\n", defaults(), size_limit());
  assert_eq(get_all(add(many, "a", "x", "2"), "a", "x"), ["1", "2"])
}
