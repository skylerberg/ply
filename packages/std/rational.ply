//! Exact fractions: a ratio of two `BigInt`s in lowest terms.
//!
//! A `Rational` has a numerator that carries the sign and a denominator above zero, so each number
//! has exactly one representation. The type is opaque, so only this module constructs a `Rational`,
//! and every function here returns one in that form. Property tests that check a law over
//! `Rational` generate fractions with `arbitrary`.
//!
//! Comparing numerator and denominator pairs does not order fractions by value, so the type
//! declares a `key`: the terms of the fraction's continued fraction. As a result `==`, `<`, the
//! language's `compare`, `digest` and `Map` all treat fractions by value. Computing a key costs as
//! much as a greatest common divisor, so the `compare` function in this module cross-multiplies
//! instead, which is cheaper.
//!
//! The type also declares `numeric`, so `a + b`, `a - b`, `a * b` and `-a` call `add`, `sub`, `mul`
//! and `neg`. A function that accepts any `numeric` type, such as `std.math.sum`, therefore accepts
//! a `Rational`. Division is `div`, which returns `None` for a zero divisor instead of raising.
//!
//! A fraction is written `3/4`, or `3` when it is a whole number. Parsing accepts either form and
//! decimals such as `0.75`. The literal `rational"3/4"` is parsed when the program is checked, so
//! an invalid literal is an error at that point. A `Float` or a `Decimal` converts exactly to the
//! fraction with the same value. Converting back rounds to the nearest `Float`, or to a `Decimal`
//! of a given scale using a `Rounding`.

import std.bigint
import std.bigint (BigInt)
import std.bytes
import std.decimal
import std.float
import std.gen
import std.gen (Gen)
import std.laws (round_trip, total_order)
import std.list
import std.math
import std.option
import std.result

/// A fraction in lowest terms: the numerator, which carries the sign, and the denominator, which
/// is above zero.
pub opaque type Rational = | Rational(BigInt, BigInt)

key for Rational by order_key

show for Rational by to_string

numeric for Rational by { add: add, sub: sub, mul: mul, neg: neg, of_int: of_int }

/// Why a text is not a fraction.
pub type ErrorKind =
  /// A character that cannot be part of a fraction, or the text ending where a digit is expected.
  | UnexpectedCharacter
  | ZeroDenominator

/// A parse error, and the offset of the character it is about.
pub type Error = new { at: Int, reason: ErrorKind }

/// The effect this module raises when it rejects a text.
pub effect rational {
  /// The text is not a fraction.
  raise fail(e: Error)
}

/// Generates a fraction from two whole numbers generated as `std.bigint` generates them, or from a
/// small numerator and denominator. Small values often produce equal fractions, or fractions whose
/// continued fractions start with the same terms, which tests need to cover.
pub fn arbitrary() -> Gen<Rational> =
  gen::one_of([
    gen::map2(bigint::arbitrary(), bigint::arbitrary(), |n: BigInt, d: BigInt|
      reduced(n, bigint::abs_value(d) + bigint::one)),
    gen::map2(gen::int_between(0 - 64, 64), gen::int_between(1, 16), |n: Int, d: Int|
      reduced(bigint::of_int(n), bigint::of_int(d))),
  ])

/// Zero.
pub const zero: Rational = Rational(bigint::zero, bigint::one)

/// One.
pub const one: Rational = Rational(bigint::one, bigint::one)

/// The whole number `n`.
pub fn of_int(n: Int) -> Rational = Rational(bigint::of_int(n), bigint::one)

/// The whole number `n`.
pub fn of_bigint(n: BigInt) -> Rational = Rational(n, bigint::one)

/// `numerator / denominator` in lowest terms; `None` for a zero denominator.
pub fn ratio(numerator: BigInt, denominator: BigInt) -> Option<Rational> =
  if bigint::is_zero(denominator) { None } else { Some(reduced(numerator, denominator)) }

/// `numerator / denominator` in lowest terms; `None` for a zero denominator.
pub fn of_ints(numerator: Int, denominator: Int) -> Option<Rational> =
  ratio(bigint::of_int(numerator), bigint::of_int(denominator))

/// The numerator of the lowest terms, which has the fraction's sign.
pub fn numerator(r: Rational) -> BigInt = match r { Rational(n, _) -> n }

/// The denominator of the lowest terms, which is above zero.
pub fn denominator(r: Rational) -> BigInt = match r { Rational(_, d) -> d }

/// Whether the fraction is zero.
pub fn is_zero(r: Rational) -> Bool = bigint::is_zero(numerator(r))

/// Whether the fraction is below zero.
pub fn is_negative(r: Rational) -> Bool = bigint::is_negative(numerator(r))

/// Whether the fraction is a whole number.
pub fn is_integer(r: Rational) -> Bool = bigint::compare(denominator(r), bigint::one) == Equal

/// `-1`, `0` or `1`.
pub fn sign(r: Rational) -> Int = bigint::sign(numerator(r))

/// `a + b`.
pub fn add(a: Rational, b: Rational) -> Rational =
  reduced(
    numerator(a) * denominator(b) + numerator(b) * denominator(a),
    denominator(a) * denominator(b),
  )

/// `a - b`.
pub fn sub(a: Rational, b: Rational) -> Rational = add(a, neg(b))

/// `a * b`.
pub fn mul(a: Rational, b: Rational) -> Rational =
  reduced(numerator(a) * numerator(b), denominator(a) * denominator(b))

/// The fraction with its sign flipped.
pub fn neg(r: Rational) -> Rational = Rational(bigint::neg(numerator(r)), denominator(r))

/// The distance from zero.
pub fn abs(r: Rational) -> Rational = Rational(bigint::abs_value(numerator(r)), denominator(r))

/// `1 / r`, or `None` for zero.
pub fn reciprocal(r: Rational) -> Option<Rational> = ratio(denominator(r), numerator(r))

/// `a / b`; `None` for a zero divisor.
pub fn div(a: Rational, b: Rational) -> Option<Rational> =
  match reciprocal(b) { Some(inverse) -> Some(mul(a, inverse)), None -> None }

/// Raises `r` to a whole power. A negative exponent raises the reciprocal, so zero to a negative
/// power returns `None`. Anything to the power zero is one.
pub fn pow(r: Rational, exponent: Int) -> Option<Rational> =
  if exponent >= 0 {
    Some(Rational(bigint::pow(numerator(r), exponent), bigint::pow(denominator(r), exponent)))
  } else {
    match reciprocal(r) {
      Some(inverse) ->
        Some(
          Rational(
            bigint::pow(numerator(inverse), 0 - exponent),
            bigint::pow(denominator(inverse), 0 - exponent),
          ),
        ),
      None -> None,
    }
  }

/// Compares `a` with `b` by value and returns `Less`, `Equal` or `Greater`. It cross-multiplies,
/// which is cheaper than comparing keys.
pub fn compare(a: Rational, b: Rational) -> Ordering =
  bigint::compare(numerator(a) * denominator(b), numerator(b) * denominator(a))

/// Rounds the fraction to a whole number by `mode`. `mode` is the prelude's `Rounding`, and means
/// what it does for a `Decimal`.
pub fn round(r: Rational, mode: Rounding) -> BigInt =
  match bigint::div_round(numerator(r), denominator(r), mode) {
    Some(whole) -> whole,
    None -> bigint::zero,
  }

/// The greatest whole number at or below the fraction.
pub fn floor(r: Rational) -> BigInt = round(r, Floor)

/// The least whole number at or above the fraction.
pub fn ceil(r: Rational) -> BigInt = round(r, Ceiling)

/// The whole part of the fraction, rounded toward zero.
pub fn truncate(r: Rational) -> BigInt = round(r, Down)

/// Returns the fraction nearest `r` whose denominator is at most `max`, as Python's
/// `limit_denominator` does. It walks the convergents of `r`'s continued fraction (its successive
/// best approximations), then also tries one semiconvergent, a fraction between the last two
/// convergents, because that fraction can be closer than the last convergent. Returns `None` when
/// `max` is below one.
pub fn limit_denominator(r: Rational, max: BigInt) -> Option<Rational> =
  if bigint::compare(max, bigint::one) == Less { None }
  else if bigint::compare(denominator(r), max) != Greater { Some(r) } else {
    Some(
      nearest(
        r,
        max,
        numerator(r),
        denominator(r),
        { p: bigint::zero, q: bigint::one },
        { p: bigint::one, q: bigint::zero },
        2 * bigint::bit_length(denominator(r)) + 3,
      ),
    )
  }

/// The exact fraction a `Decimal` represents.
pub fn of_decimal(d: Decimal) -> Rational / {abort.raise} =
  match parse(d.to_string()) { Ok(r) -> r, Err(_) -> zero }

/// The fraction as a `Decimal` with `scale` digits after the point, rounded by `mode`. It is exact
/// when the fraction has no more digits than that. `None` for a scale outside `0..=28` and for a
/// value too large for a `Decimal`.
pub fn to_decimal(r: Rational, scale: Int, mode: Rounding) -> Option<Decimal> =
  if scale < 0 || scale > 28 { None } else {
    let unscaled = round(mul(r, of_bigint(bigint::pow(bigint::of_int(10), scale))), mode);
    Decimal::of_string(bigint::to_string(unscaled) ++ "e-" ++ scale.to_string())
  }

/// The exact fraction a `Float` represents: every finite `Float` is a whole number over a power of
/// two. `None` for a `NaN` and for an infinity.
pub fn of_float(f: Float) -> Option<Rational> = {
  let bits = bits_of_float(f);
  let exponent = bits >> 52 & 0x7FF;
  let fraction = bits & 0xF_FFFF_FFFF_FFFF;
  if exponent == 0x7FF { None } else {
    let mantissa = bigint::of_int(if exponent == 0 { fraction } else { fraction | 1 << 52 });
    let signed = if bits < 0 { bigint::neg(mantissa) } else { mantissa };
    let power = if exponent == 0 { 0 - 1074 } else { exponent - 1075 };
    if power >= 0 { Some(of_bigint(signed * power_of_two(power))) }
    else { ratio(signed, power_of_two(0 - power)) }
  }
}

/// The `Float` nearest the fraction, with a tie going to the one whose last bit is zero, as IEEE
/// 754 rounds. A fraction past the largest `Float` becomes an infinity, and one below half the
/// smallest becomes zero.
pub fn to_float(r: Rational) -> Float = {
  let n = bigint::abs_value(numerator(r));
  let d = denominator(r);
  if bigint::is_zero(n) { 0.0 } else {
    let above = bigint::bit_length(n) - bigint::bit_length(d);
    let at_least_power = if above >= 0 { bigint::compare(n, d * power_of_two(above)) != Less }
    else { bigint::compare(n * power_of_two(0 - above), d) != Less };
    let shift = min(if at_least_power { 52 - above } else { 53 - above }, 1074);
    let rounded = if shift >= 0 { bigint::div_round(n * power_of_two(shift), d, HalfEven) }
    else { bigint::div_round(n, d * power_of_two(0 - shift), HalfEven) };
    let magnitude = if shift < 0 - 971 { Float::pow2(1024) } else {
      match rounded {
        Some(whole) -> match bigint::to_int(whole) {
          Some(mantissa) -> Float::of_int(mantissa) * Float::pow2(0 - shift),
          None -> Float::pow2(1024),
        },
        None -> 0.0,
      }
    };
    if is_negative(r) { 0.0 - magnitude } else { magnitude }
  }
}

/// `3/4`, or `3` for a whole number, with a leading `-` when negative.
pub fn to_string(r: Rational) -> String =
  if is_integer(r) { bigint::to_string(numerator(r)) }
  else { bigint::to_string(numerator(r)) ++ "/" ++ bigint::to_string(denominator(r)) }

/// Reads a fraction from text: a whole number `-3`, a ratio `3/4` or a decimal `0.75`, with an
/// optional sign first and at least one digit on each side of a `/` or a point. The ratio need
/// not be in lowest terms. Raises `fail` for anything else, at the first character that cannot be
/// part of a fraction, and for a zero denominator.
pub fn read(text: String) -> Rational / {rational.fail, abort.raise} = {
  let bytes = Bytes::of_string(text);
  let n = bytes.len();
  let from = if bytes.peek(0) == 45 || bytes.peek(0) == 43 { 1 } else { 0 };
  let whole_end = bytes.skip(from, b"0123456789");
  let mark = bytes.peek(whole_end);
  let part_end = bytes.skip(whole_end + 1, b"0123456789");
  if whole_end == from { fail(whole_end, UnexpectedCharacter) }
  else if whole_end == n { of_bigint(number(bytes, 0, n)) }
  else if mark != 47 && mark != 46 { fail(whole_end, UnexpectedCharacter) }
  else if part_end == whole_end + 1 || part_end != n { fail(part_end, UnexpectedCharacter) }
  else if mark == 47 {
    match ratio(number(bytes, 0, whole_end), number(bytes, whole_end + 1, n)) {
      Some(r) -> r,
      None -> fail(whole_end + 1, ZeroDenominator),
    }
  } else {
    let part = number(bytes, whole_end + 1, n);
    let unit = bigint::pow(bigint::of_int(10), n - whole_end - 1);
    reduced(
      number(bytes, 0, whole_end) * unit
        + (if bytes.peek(0) == 45 { bigint::neg(part) } else { part }),
      unit,
    )
  }
}

/// Reads a fraction from text as `read` does, or returns why the text is not one.
pub fn parse(text: String) -> Result<Rational, Error> / {abort.raise} = try { read(text) }

/// Checks a `rational"..."` literal. Returns the fraction `read` reads, or an error with the reason
/// and the offset where the text stops being a fraction.
pub fn literal(text: String) -> Result<Rational, { message: String, offset: Int }> / {abort.raise} =
  match parse(text) {
    Ok(r) -> Ok(r),
    Err(e) ->
      Err({
        message: match e.reason {
          UnexpectedCharacter -> "a fraction is a whole number, a ratio `3/4` or a decimal `0.75`",
          ZeroDenominator -> "the denominator must not be zero",
        },
        offset: e.at,
      }),
  }

fn fail<a>(at: Int, reason: ErrorKind) -> a / {rational.fail} =
  rational.fail({ at: at, reason: reason })

fn reduced(n: BigInt, d: BigInt) -> Rational = {
  let shared = bigint::gcd(n, d);
  if bigint::is_negative(d) {
    Rational(bigint::neg(exact_div(n, shared)), bigint::neg(exact_div(d, shared)))
  } else { Rational(exact_div(n, shared), exact_div(d, shared)) }
}

fn exact_div(a: BigInt, b: BigInt) -> BigInt = match bigint::div(a, b) { Some(q) -> q, None -> a }

fn floor_div_mod(n: BigInt, d: BigInt) -> { q: BigInt, r: BigInt } =
  match bigint::div_mod(n, d) {
    Some(split) -> if bigint::is_negative(split.r) { { q: split.q - bigint::one, r: split.r + d } }
    else { split },
    None -> { q: bigint::zero, r: bigint::zero },
  }

fn order_key(r: Rational) -> List<(Int, BigInt)> =
  terms(numerator(r), denominator(r), 0, [], 2 * bigint::bit_length(denominator(r)) + 3)

fn terms(n: BigInt, d: BigInt, i: Int, out: List<(Int, BigInt)>, left: Int) -> List<(Int, BigInt)> =
  if left <= 0 { out } else {
    let split = floor_div_mod(n, d);
    let term = (0, if i % 2 == 0 { split.q } else { bigint::neg(split.q) });
    if bigint::is_zero(split.r) {
      out.push(term).push((if i % 2 == 0 { 0 - 1 } else { 1 }, bigint::zero))
    } else { terms(d, split.r, i + 1, out.push(term), left - 1) }
  }

fn nearest(
  r: Rational,
  max: BigInt,
  n: BigInt,
  d: BigInt,
  before: { p: BigInt, q: BigInt },
  last: { p: BigInt, q: BigInt },
  left: Int,
) -> Rational = {
  let term = floor_div_mod(n, d).q;
  let next = before.q + term * last.q;
  if left <= 0 || bigint::compare(next, max) == Greater {
    let most = floor_div_mod(max - before.q, last.q).q;
    let between = { p: before.p + most * last.p, q: before.q + most * last.q };
    if bigint::compare(bigint::of_int(2) * d * between.q, denominator(r)) != Greater {
      Rational(last.p, last.q)
    } else { Rational(between.p, between.q) }
  } else {
    nearest(r, max, d, n - term * d, last, { p: before.p + term * last.p, q: next }, left - 1)
  }
}

fn power_of_two(k: Int) -> BigInt = bigint::set_bit(bigint::zero, k)

fn number(bytes: Bytes, from: Int, to: Int) -> BigInt / {abort.raise} =
  match bigint::of_string(String::of_bytes(bytes.slice(from, to))) {
    Some(n) -> n,
    None -> bigint::zero,
  }

fn fraction_of(n: Int, d: Int) -> Rational / {abort.raise} =
  match of_ints(n, d) { Some(r) -> r, None -> panic("the denominator must not be zero") }

fn in_lowest_terms(r: Rational) -> Bool =
  bigint::sign(denominator(r)) == 1
    && bigint::compare(bigint::gcd(numerator(r), denominator(r)), bigint::one) == Equal

test "a fraction is stored in lowest terms over a denominator above zero" {
  assert_eq(fraction_of(16, 0 - 10), Rational(bigint::of_int(0 - 8), bigint::of_int(5)));
  assert_eq(fraction_of(0, 0 - 7), zero);
  assert_eq(fraction_of(6, 3), of_int(2));
  assert_eq(of_ints(1, 0), None);
  assert_eq(ratio(bigint::one, bigint::zero), None);
  assert_eq(numerator(fraction_of(6, 0 - 4)), bigint::of_int(0 - 3));
  assert_eq(denominator(fraction_of(6, 0 - 4)), bigint::of_int(2));
  assert(is_integer(fraction_of(6, 3)) && !is_integer(fraction_of(6, 4)));
  assert(is_zero(zero) && is_negative(fraction_of(1, 0 - 2)) && !is_negative(zero));
  assert_eq([fraction_of(0 - 1, 2), zero, fraction_of(1, 2)].map(sign), [0 - 1, 0, 1])
}

test "arithmetic is exact, and the operators call the functions" {
  assert_eq(fraction_of(1, 3) + fraction_of(1, 6), fraction_of(1, 2));
  assert_eq(fraction_of(1, 3) - fraction_of(1, 2), fraction_of(0 - 1, 6));
  assert_eq(fraction_of(3, 4) * fraction_of(2, 3), fraction_of(1, 2));
  assert_eq(-fraction_of(3, 4), fraction_of(0 - 3, 4));
  assert_eq(div(fraction_of(3, 4), fraction_of(0 - 9, 8)), Some(fraction_of(0 - 2, 3)));
  assert_eq(div(fraction_of(3, 4), zero), None);
  assert_eq(reciprocal(fraction_of(0 - 2, 3)), Some(fraction_of(0 - 3, 2)));
  assert_eq(reciprocal(zero), None);
  assert_eq(abs(fraction_of(0 - 2, 3)), fraction_of(2, 3));
  assert_eq(pow(fraction_of(2, 3), 5), Some(fraction_of(32, 243)));
  assert_eq(pow(fraction_of(2, 3), 0 - 3), Some(fraction_of(27, 8)));
  assert_eq(pow(fraction_of(0 - 2, 3), 0 - 3), Some(fraction_of(0 - 27, 8)));
  assert_eq(pow(zero, 0), Some(one));
  assert_eq(pow(zero, 0 - 1), None);
  assert_eq(range(0, 10).fold(zero, |sum: Rational, _i: Int| sum + fraction_of(1, 10)), one)
}

test "`Rational` values compare by numeric value with `<`, `compare`, `max` and as map keys, and 2/4 has the same digest as 1/2" {
  let ordered = [
    fraction_of(0 - 7, 2),
    fraction_of(0 - 10, 3),
    of_int(0 - 3),
    fraction_of(0 - 1, 2),
    fraction_of(0 - 1, 3),
    zero,
    fraction_of(1, 3),
    fraction_of(1, 2),
    fraction_of(2, 3),
    one,
    fraction_of(3, 2),
    fraction_of(355, 113),
    fraction_of(22, 7),
  ];
  let pairs = range(0, ordered.len() - 1).map(|i: Int| ordered.slice(i, i + 2));
  assert(
    pairs.fold(true, |ok: Bool, pair: List<Rational>|
      match pair { [low, high] -> ok && low < high && compare(low, high) == Less, _ -> false }),
  );
  let keyed = ordered.fold(Map::new(), |m: Map<Rational, Int>, r: Rational| m.insert(r, 0));
  assert_eq(keyed.keys(), ordered);
  assert_eq(keyed.get(fraction_of(44, 14)), Some(0));
  assert_eq(digest(fraction_of(2, 4)), digest(fraction_of(1, 2)));
  assert_eq(max(fraction_of(1, 2), fraction_of(2, 3)), fraction_of(2, 3))
}

test "generic numeric functions such as `List::sum`, `math::abs` and `math::clamp` accept a Rational" {
  assert_eq(List::sum([fraction_of(1, 2), fraction_of(1, 3), fraction_of(1, 6)]), one);
  assert_eq(List::product([fraction_of(2, 3), fraction_of(3, 4)]), fraction_of(1, 2));
  assert_eq(math::abs(fraction_of(0 - 1, 2)), fraction_of(1, 2));
  assert_eq(math::clamp(fraction_of(5, 2), zero, one), one)
}

test "`round` on a `Rational` returns the same whole number for each `Rounding` value as rounding that value as a Decimal would" {
  let by_mode = |r: Rational|
    [HalfEven, HalfUp, Down, Up, Ceiling, Floor].map(|mode: Rounding|
      bigint::to_int(round(r, mode)));
  assert_eq(by_mode(fraction_of(5, 2)), [2, 3, 2, 3, 3, 2].map(|n: Int| Some(n)));
  assert_eq(
    by_mode(fraction_of(0 - 7, 2)),
    [0 - 4, 0 - 4, 0 - 3, 0 - 4, 0 - 3, 0 - 4].map(|n: Int| Some(n)),
  );
  assert_eq(by_mode(fraction_of(1, 3)), [0, 0, 0, 1, 1, 0].map(|n: Int| Some(n)));
  assert_eq(floor(fraction_of(0 - 7, 2)), bigint::of_int(0 - 4));
  assert_eq(ceil(fraction_of(0 - 7, 2)), bigint::of_int(0 - 3));
  assert_eq(truncate(fraction_of(0 - 7, 2)), bigint::of_int(0 - 3));
  assert_eq(floor(fraction_of(355, 113)), bigint::of_int(3))
}

test "a fraction is written as a ratio or a whole number, and read from those and a decimal" {
  assert_eq(to_string(fraction_of(3, 4)), "3/4");
  assert_eq(to_string(fraction_of(0 - 3, 4)), "-3/4");
  assert_eq(to_string(fraction_of(6, 3)), "2");
  assert_eq(f"{fraction_of(1, 3)} of {of_int(6)}", "1/3 of 6");
  assert_eq(parse("3/4"), Ok(fraction_of(3, 4)));
  assert_eq(parse("-3"), Ok(of_int(0 - 3)));
  assert_eq(parse("+3/7"), Ok(fraction_of(3, 7)));
  assert_eq(parse("007/014"), Ok(fraction_of(1, 2)));
  assert_eq(parse("0.75"), Ok(fraction_of(3, 4)));
  assert_eq(parse("-0.75"), Ok(fraction_of(0 - 3, 4)));
  assert_eq(parse("1.50"), Ok(fraction_of(3, 2)));
  assert_eq(parse("1.414213"), Ok(fraction_of(1414213, 1000000)));
  assert_eq(parse("-0.0"), Ok(zero))
}

type ErrorCase = { text: String, at: Int, reason: ErrorKind }

const error_cases: List<ErrorCase> =
  [
    { text: "", at: 0, reason: UnexpectedCharacter },
    { text: "-", at: 1, reason: UnexpectedCharacter },
    { text: "x", at: 0, reason: UnexpectedCharacter },
    { text: "3/", at: 2, reason: UnexpectedCharacter },
    { text: "/4", at: 0, reason: UnexpectedCharacter },
    { text: "3/-4", at: 2, reason: UnexpectedCharacter },
    { text: "3/4/5", at: 3, reason: UnexpectedCharacter },
    { text: "3 /4", at: 1, reason: UnexpectedCharacter },
    { text: ".5", at: 0, reason: UnexpectedCharacter },
    { text: "5.", at: 2, reason: UnexpectedCharacter },
    { text: "1.5e3", at: 3, reason: UnexpectedCharacter },
    { text: "1.2.3", at: 3, reason: UnexpectedCharacter },
    { text: "3/0", at: 2, reason: ZeroDenominator },
    { text: "-3/000", at: 3, reason: ZeroDenominator },
  ]

test "`parse` fails with the error position and reason for the invalid fraction `{c.text}`" for c: ErrorCase in error_cases {
  assert_eq(parse(c.text), Err({ at: c.at, reason: c.reason }))
}

test "`literal` returns the fraction for valid text, or an error message and the offset of the first invalid character" {
  assert_eq(literal("-6/8"), Ok(fraction_of(0 - 3, 4)));
  assert_eq(
    literal("3/x"),
    Err({ message: "a fraction is a whole number, a ratio `3/4` or a decimal `0.75`", offset: 2 }),
  );
  assert_eq(literal("3/0"), Err({ message: "the denominator must not be zero", offset: 2 }))
}

test "a Decimal converts to the fraction it represents, and a fraction to a Decimal at a scale" {
  assert_eq(of_decimal(0.75m), fraction_of(3, 4));
  assert_eq(of_decimal(0m - 1.50m), fraction_of(0 - 3, 2));
  assert_eq(of_decimal(3m), of_int(3));
  assert_eq(to_decimal(fraction_of(3, 4), 2, HalfEven).map(Decimal::to_string), Some("0.75"));
  assert_eq(to_decimal(fraction_of(3, 4), 4, HalfEven).map(Decimal::to_string), Some("0.7500"));
  assert_eq(to_decimal(fraction_of(1, 3), 5, HalfEven).map(Decimal::to_string), Some("0.33333"));
  assert_eq(to_decimal(fraction_of(2, 3), 5, HalfEven).map(Decimal::to_string), Some("0.66667"));
  assert_eq(to_decimal(fraction_of(0 - 2, 3), 5, Down).map(Decimal::to_string), Some("-0.66666"));
  assert_eq(to_decimal(fraction_of(0 - 1, 8), 2, HalfEven).map(Decimal::to_string), Some("-0.12"));
  assert_eq(to_decimal(fraction_of(0 - 1, 8), 2, HalfUp).map(Decimal::to_string), Some("-0.13"));
  assert_eq(to_decimal(fraction_of(5, 1), 0, Down).map(Decimal::to_string), Some("5"));
  assert_eq(to_decimal(fraction_of(1, 3), 29, Down), None);
  assert_eq(to_decimal(fraction_of(1, 3), 0 - 1, Down), None);
  assert_eq(to_decimal(of_bigint(power_of_two(96)), 0, Down), None);
  assert_eq(
    to_decimal(of_bigint(power_of_two(96) - bigint::one), 0, Down).map(Decimal::to_string),
    Some("79228162514264337593543950335"),
  )
}

test "a Float converts to the fraction it represents, as Python's fractions module converts it" {
  assert_eq(of_float(2.25), Some(fraction_of(9, 4)));
  assert_eq(of_float(0.0 - 0.1), Some(fraction_of(0 - 3602879701896397, 36028797018963968)));
  assert_eq(of_float(1.1), Some(fraction_of(2476979795053773, 2251799813685248)));
  assert_eq(of_float(0.0), Some(zero));
  assert_eq(of_float(0.0 - 0.0), Some(zero));
  assert_eq(of_float(5e-324), ratio(bigint::one, power_of_two(1074)));
  assert_eq(
    of_float(1.7976931348623157e308),
    Some(of_bigint(power_of_two(1024) - power_of_two(971))),
  );
  assert_eq(of_float(Float::of_bits(0x7FF0_0000_0000_0000)), None);
  assert_eq(of_float(Float::of_bits(0x7FF8_0000_0000_0000)), None)
}

test "`to_float` rounds once to the nearest Float with ties to even, including subnormal results and overflow to infinity" {
  assert_eq(to_float(fraction_of(1, 3)), 0.3333333333333333);
  assert_eq(to_float(fraction_of(0 - 2, 3)), 0.0 - 0.6666666666666666);
  assert_eq(to_float(fraction_of(9, 4)), 2.25);
  assert_eq(to_float(zero), 0.0);
  let ten_30 = bigint::pow(bigint::of_int(10), 30);
  assert_eq(option_float(ratio(ten_30, bigint::of_int(7))), 1.4285714285714285e29);
  assert_eq(option_float(ratio(bigint::one, ten_30)), 1e-30);
  assert_eq(option_float(ratio(bigint::one, power_of_two(1074))), 5e-324);
  assert_eq(option_float(ratio(bigint::of_int(3), power_of_two(1075))), 1e-323);
  assert_eq(option_float(ratio(bigint::one, power_of_two(1075))), 0.0);
  assert_eq(option_float(ratio(bigint::of_int(5), power_of_two(1076))), 5e-324);
  assert_eq(to_float(of_bigint(power_of_two(1024) - power_of_two(971))), 1.7976931348623157e308);
  assert_eq(to_float(of_bigint(power_of_two(1024) - power_of_two(970))), Float::pow2(1024));
  assert_eq(to_float(of_bigint(bigint::neg(power_of_two(2000)))), 0.0 - Float::pow2(1024));
  assert_eq(option_float(ratio(bigint::one, power_of_two(2000))), 0.0)
}

fn option_float(r: Option<Rational>) -> Float =
  match r { Some(x) -> to_float(x), None -> 0.0 / 0.0 }

test "the nearest fraction under a denominator is the one Python's limit_denominator finds" {
  let pi = of_decimal(3.141592653589793m);
  let limited = |r: Rational, max: Int| limit_denominator(r, bigint::of_int(max));
  assert_eq(limited(pi, 10), Some(fraction_of(22, 7)));
  assert_eq(limited(pi, 100), Some(fraction_of(311, 99)));
  assert_eq(limited(pi, 1000), Some(fraction_of(355, 113)));
  assert_eq(limited(fraction_of(355, 113), 100), Some(fraction_of(311, 99)));
  assert_eq(limited(fraction_of(0 - 355, 113), 7), Some(fraction_of(0 - 22, 7)));
  assert_eq(limited(fraction_of(1, 3), 2), Some(fraction_of(1, 2)));
  assert_eq(limited(fraction_of(2, 3), 2), Some(fraction_of(1, 2)));
  assert_eq(limited(fraction_of(5, 7), 1), Some(one));
  assert_eq(limited(fraction_of(5, 7), 7), Some(fraction_of(5, 7)));
  assert_eq(limited(fraction_of(5, 7), 0), None);
  assert_eq(
    limited(fraction_of(4503599627370497, 9007199254740992), 1000000),
    Some(fraction_of(1, 2)),
  );
  assert_eq(
    limited(fraction_of(2476979795053773, 2251799813685248), 1000000),
    Some(fraction_of(11, 10)),
  )
}

test "division undoes multiplication" {
  gen::check2(arbitrary(), arbitrary(), |x: Rational, y: Rational| {
    match div(x * y, y) { Some(q) -> q == x, None -> is_zero(y) }
  })
}

test "every result is in lowest terms over a denominator above zero" {
  gen::check2(arbitrary(), arbitrary(), |x: Rational, y: Rational| {
    in_lowest_terms(x) && in_lowest_terms(x + y) && in_lowest_terms(x * y) && in_lowest_terms(-x)
      && (match div(x, y) { Some(q) -> in_lowest_terms(q), None -> true })
  })
}

test "cross-multiplying is a total order" {
  gen::check3(arbitrary(), arbitrary(), arbitrary(), |x: Rational, y: Rational, z: Rational|
    total_order(compare, x, y, z))
}

test "`of_int` addition and multiplication of two Ints equal the `Rational` result of `of_int` on the Int sum or product, when that does not overflow" {
  gen::check2(gen::any_int(), gen::any_int(), |a: Int, b: Int| {
    (match checked_add(a, b) { Some(s) -> of_int(a) + of_int(b) == of_int(s), None -> true })
      && (match checked_mul(a, b) { Some(p) -> of_int(a) * of_int(b) == of_int(p), None -> true })
  })
}

test "parsing a fraction's `to_string` text returns the same fraction" {
  gen::check(arbitrary(), |x: Rational| round_trip(to_string, |text: String| parse(text).ok(), x))
}
