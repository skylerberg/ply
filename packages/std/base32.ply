//! Base32 as RFC 4648 defines it, with and without padding, and Crockford's alphabet.
//!
//! `encode` and `decode` use RFC 4648 §6: the alphabet `A-Z2-7`, padded to a multiple of eight
//! characters. `hex_encode` and `hex_decode` use §7, base32hex: the alphabet `0-9A-V`, whose texts
//! sort in the same order as their bytes. Each has an `_unpadded` variant, the form used for
//! one-time-password secrets and DNSSEC hashes. Crockford's alphabet leaves out the letters a
//! reader confuses with digits, and is never padded.
//!
//! Every decoder returns `None` for any text its encoder would not write, like every alphabet in
//! `std.radix`. To decode text a person typed, pass it to `normalize` or `crockford_normalize`
//! first. A decoder is never lenient on its own.

import std.bytes
import std.laws (round_trip)
import std.radix
import std.string
import std.gen

/// Encodes `data` as base32 text with `=` padding, using the standard alphabet of RFC 4648.
pub fn encode(data: Bytes) -> String / {abort.raise} = radix::encode(radix::base32, data)

/// Decodes text that `encode` wrote. Returns `None` for any other text.
pub fn decode(text: String) -> Option<Bytes> / {abort.raise} = radix::decode(radix::base32, text)

/// Decodes a secret text as `decode` does, and returns the bytes as a secret. The runtime decodes
/// it without revealing it, in steps that depend only on its length. Returns `None` for any other
/// text, and reveals nothing else about it.
pub fn decode_secret(text: Secret<String>) -> Option<Secret<Bytes>> / {abort.raise} =
  Secret::decode("base32", text)

/// Decodes a secret text as a person typed it, as `decode_unpadded(normalize(typed))` would, and
/// returns the bytes as a secret. Use it for a one-time-password secret from a configuration.
pub fn decode_typed_secret(typed: Secret<String>) -> Option<Secret<Bytes>> / {abort.raise} =
  Secret::decode("base32-typed", typed)

/// Encodes `data` as base32 text without padding, using the standard alphabet of RFC 4648.
pub fn encode_unpadded(data: Bytes) -> String / {abort.raise} =
  radix::encode(radix::unpadded(radix::base32), data)

/// Decodes text that `encode_unpadded` wrote. Returns `None` for any other text, including padded
/// text.
pub fn decode_unpadded(text: String) -> Option<Bytes> / {abort.raise} =
  radix::decode(radix::unpadded(radix::base32), text)

/// Encodes `data` as base32 text with `=` padding, using the base32hex alphabet of RFC 4648.
pub fn hex_encode(data: Bytes) -> String / {abort.raise} = radix::encode(radix::base32hex, data)

/// Decodes text that `hex_encode` wrote. Returns `None` for any other text.
pub fn hex_decode(text: String) -> Option<Bytes> / {abort.raise} =
  radix::decode(radix::base32hex, text)

/// Encodes `data` as base32 text without padding, using the base32hex alphabet of RFC 4648.
pub fn hex_encode_unpadded(data: Bytes) -> String / {abort.raise} =
  radix::encode(radix::unpadded(radix::base32hex), data)

/// Decodes text that `hex_encode_unpadded` wrote. Returns `None` for any other text.
pub fn hex_decode_unpadded(text: String) -> Option<Bytes> / {abort.raise} =
  radix::decode(radix::unpadded(radix::base32hex), text)

/// Encodes `data` as upper case base32 text using Crockford's alphabet, without the optional
/// checksum character.
pub fn crockford_encode(data: Bytes) -> String / {abort.raise} =
  radix::encode(radix::crockford, data)

/// Decodes text that `crockford_encode` wrote. Returns `None` for any other text.
pub fn crockford_decode(text: String) -> Option<Bytes> / {abort.raise} =
  radix::decode(radix::crockford, text)

/// Converts base32 text as a person typed it to the form `decode_unpadded` reads. Letters become
/// upper case, and spaces, tabs, hyphens and the padding at the end are dropped. Any other
/// character stays, so the decoder rejects it.
pub fn normalize(typed: String) -> String / {abort.raise} =
  without_padding(without(typed, " \t-").ascii_upper())

/// Converts Crockford text as a person typed it to the form `crockford_decode` reads, by the rules
/// the alphabet was designed for. Letters become upper case, `O` becomes `0`, `I` and `L` become
/// `1`, and hyphens are dropped.
pub fn crockford_normalize(typed: String) -> String =
  without(typed, "-").ascii_upper().replace("O", "0").replace("I", "1").replace("L", "1")

/// Checks a `base32"..."` literal. Returns the bytes of padded text in RFC 4648 §6's alphabet, or
/// an error with the offset where the text stops being valid.
pub fn literal(text: String) -> Result<Bytes, { message: String, offset: Int }> / {abort.raise} =
  match radix::parse(radix::base32, text) {
    Ok(data) -> Ok(data),
    Err(r) ->
      Err({
        message: match r.reason {
          radix::InvalidSymbol -> if lower_at(text, r.at) { "base32 is written in upper case" }
          else { "not a base32 letter" },
          radix::BadPaddedLength -> "padded base32 is a multiple of eight characters",
          radix::TrailingSymbol ->
            "the last letter is extra: the bytes are already complete without it",
          radix::NonzeroTrailingBits ->
            "the last letter sets bits that do not belong to any byte, so they must be zero",
        },
        offset: r.at,
      }),
  }

fn lower_at(text: String, at: Int) -> Bool / {abort.raise} =
  text.slice(at, at + 1).ascii_upper() != text.slice(at, at + 1)

fn without(text: String, dropped: String) -> String =
  dropped.chars().fold(text, |t: String, c: Char| t.replace(String::of_chars([c]), ""))

fn without_padding(text: String) -> String / {abort.raise} =
  text.slice(0, padding_start(text, text.len()))

fn padding_start(text: String, n: Int) -> Int / {abort.raise} =
  if n > 0 && text.slice(n - 1, n) == "=" { padding_start(text, n - 1) } else { n }

test "`decode` of the output of `encode` returns the original bytes" {
  gen::check(gen::bytes(), |x: Bytes| round_trip(encode, decode, x))
}

test "`crockford_decode` of the output of `crockford_encode` returns the original bytes" {
  gen::check(gen::bytes(), |x: Bytes| round_trip(crockford_encode, crockford_decode, x))
}

type Vector = { bytes: Bytes, text: String, hex: String }

const rfc_4648: List<Vector> =
  [
    { bytes: b"", text: "", hex: "" },
    { bytes: b"f", text: "MY======", hex: "CO======" },
    { bytes: b"fo", text: "MZXQ====", hex: "CPNG====" },
    { bytes: b"foo", text: "MZXW6===", hex: "CPNMU===" },
    { bytes: b"foob", text: "MZXW6YQ=", hex: "CPNMUOG=" },
    { bytes: b"fooba", text: "MZXW6YTB", hex: "CPNMUOJ1" },
    { bytes: b"foobar", text: "MZXW6YTBOI======", hex: "CPNMUOJ1E8======" },
  ]

test "the RFC 4648 vector of {v.bytes} encodes and decodes" for v: Vector in rfc_4648 {
  assert_eq(encode(v.bytes), v.text);
  assert_eq(decode(v.text), Some(v.bytes));
  assert_eq(hex_encode(v.bytes), v.hex);
  assert_eq(hex_decode(v.hex), Some(v.bytes))
}

test "for the RFC 4648 test vector of {v.bytes}, the unpadded encode and decode functions match the padded text with its `=` padding removed" for v: Vector in rfc_4648 {
  assert_eq(encode_unpadded(v.bytes), without_padding(v.text));
  assert_eq(decode_unpadded(without_padding(v.text)), Some(v.bytes));
  assert_eq(hex_encode_unpadded(v.bytes), without_padding(v.hex));
  assert_eq(hex_decode_unpadded(without_padding(v.hex)), Some(v.bytes))
}

test "a decoder rejects any text not in canonical form" {
  assert_eq(decode("mzxw6==="), None);
  assert_eq(decode("MZXW6"), None);
  assert_eq(decode("MZXW6=="), None);
  assert_eq(decode("MZ=W6==="), None);
  assert_eq(decode("MZXW6YTB========"), None);
  assert_eq(decode("MZX====="), None);
  assert_eq(decode("MZXW7==="), None);
  assert_eq(decode("MZXW1==="), None);
  assert_eq(hex_decode("MZXW6==="), None);
  assert_eq(decode("CPNMUOJ1"), None);
  assert_eq(decode_unpadded("MZXW6==="), None);
  assert_eq(decode_unpadded("MZXW7"), None);
  assert_eq(hex_decode_unpadded("CPNMU==="), None)
}

test "a secret text decodes, or fails to, exactly as a plain text does" {
  let read = |text: String| decode_secret(Secret::of_string(text));
  let as_typed = |text: String| decode_typed_secret(Secret::of_string(text));
  assert_eq(read("MZXW6YTBOI======"), Some(Secret::of_bytes(b"foobar")));
  assert_eq(read("MZXW6YQ="), Some(Secret::of_bytes(b"foob")));
  assert_eq(read(""), Some(Secret::of_bytes(b"")));
  assert_eq(read("mzxw6==="), None);
  assert_eq(read("MZXW6"), None);
  assert_eq(read("MZXW6=="), None);
  assert_eq(read("MZ=W6==="), None);
  assert_eq(read("MZXW6YTB========"), None);
  assert_eq(read("MZX====="), None);
  assert_eq(read("MZXW7==="), None);
  assert_eq(read("MZXW1==="), None);
  assert_eq(as_typed("mzxw 6ytb oi=="), Some(Secret::of_bytes(b"foobar")));
  assert_eq(as_typed("jbsw y3dp-ehpk\t3pxp"), Some(Secret::of_bytes(b"Hello!\xDE\xAD\xBE\xEF")));
  assert_eq(as_typed("=="), Some(Secret::of_bytes(b"")));
  assert_eq(as_typed("MZ=W6"), None);
  assert_eq(as_typed("mzxw6 ?"), None);
  assert_eq(as_typed("MZXW7"), None)
}

test "Crockford's alphabet has no I, L, O or U, and `crockford_decode` rejects text that `crockford_encode` would not write" {
  assert_eq(crockford_encode(b"\x00\x44\x32\x14\xc7"), "01234567");
  assert_eq(crockford_encode(b"\x84\x65\x3a\x56\xd7"), "GHJKMNPQ");
  assert_eq(crockford_encode(b"\xc6\x75\xbe\x77\xdf"), "RSTVWXYZ");
  assert_eq(crockford_encode(b"f"), "CR");
  assert_eq(crockford_decode("CR"), Some(b"f"));
  assert_eq(crockford_decode("cr"), None);
  assert_eq(crockford_decode("C-R"), None);
  assert_eq(crockford_decode("OI"), None);
  assert_eq(crockford_decode("UU"), None)
}

test "`normalize` converts typed text to canonical base32, and the decoders never normalize text themselves" {
  assert_eq(normalize("jbsw y3dp-ehpk\t3pxp"), "JBSWY3DPEHPK3PXP");
  assert_eq(normalize("mzxw6==="), "MZXW6");
  assert_eq(normalize("=="), "");
  assert_eq(normalize("MZ=W6"), "MZ=W6");
  assert_eq(normalize("mzxw6 ?"), "MZXW6?");
  assert_eq(normalize("ı"), "ı");
  assert_eq(decode_unpadded(normalize("mzxw 6ytb oi==")), Some(b"foobar"));
  assert_eq(decode_unpadded("mzxw 6ytb oi=="), None);
  assert_eq(crockford_normalize("o1il-Cr"), "0111CR");
  assert_eq(crockford_decode(crockford_normalize("c-r")), Some(b"f"))
}

test "`literal` returns the bytes of valid base32 text, or the offset of the first character that is not canonical" {
  assert_eq(literal("MZXW6YQ="), Ok(b"foob"));
  assert_eq(literal(""), Ok(b""));
  assert_eq(literal("MZxW6YQ="), Err({ message: "base32 is written in upper case", offset: 2 }));
  assert_eq(literal("MZ1W6YQ="), Err({ message: "not a base32 letter", offset: 2 }));
  assert_eq(literal("MZ=W6YQ="), Err({ message: "not a base32 letter", offset: 2 }));
  assert_eq(
    literal("MZXW6"),
    Err({ message: "padded base32 is a multiple of eight characters", offset: 5 }),
  );
  assert_eq(
    literal("MZX====="),
    Err({
      message: "the last letter is extra: the bytes are already complete without it",
      offset: 2,
    }),
  );
  assert_eq(
    literal("MZXW7==="),
    Err({
      message: "the last letter sets bits that do not belong to any byte, so they must be zero",
      offset: 4,
    }),
  )
}
