//! A set of non-negative `Int`s, stored as bits packed 62 to a word in an `Array`.
//!
//! It has the operations of `std.set` under the same names, plus operations that need packed bits:
//! `next_set`, `rank`, `select`, `complement`, `insert_range` and `remove_range`. The laws in this
//! module's tests check each operation against what `std.set` returns for the same elements.
//! `of_set` and `to_set` convert between the two types.
//!
//! A word stores 62 bits because that is how many an `Int` can hold without boxing. A set whose
//! greatest element is `n` takes `n / 62 + 1` words. `size`, the operations on two sets and the
//! range updates process one word at a time, however many elements the word contains.
//!
//! A set has exactly as many words as its greatest element needs, so the array grows and shrinks
//! with the set. Equal sets are therefore equal values to `==`, `digest` and `Map` keys. `compare`
//! orders sets by their words, which is not the order of their element lists.
//!
//! An update whose result has the same number of words as its input writes into the input's array
//! when nothing else references it, and allocates nothing. An insert past the last word, or a
//! removal that empties the last word, copies the words into an array of the new length. To build a
//! large set, use `of_list` or `insert_range`, which allocate the array once.
//!
//! Every function that updates a set has the `abort.raise` effect, as the array builtins it uses
//! do. It raises only for an element below zero, or for an element beyond the `2^26` words an array
//! can contain.

import std.laws (agrees, refines)
import std.list
import std.set
import std.set (Set)
import std.gen

/// A set of non-negative `Int`s. Build one with `empty`, `of_list`, `of_set` or `insert_range`. A
/// record written by hand can have a zero last word. Such a record is not equal under `==` to the
/// same set built by those functions.
pub type Bitset = new {
  /// Stores the elements, 62 to a word. Element `x` is bit `x % 62` of word `x / 62`, so the lowest
  /// elements are in the first word. The last word is never zero.
  words: Array<Int>,
}

type Operation = | Or | And | AndNot | Xor

fn apply_operation(operation: Operation, current: Int, beside: Int) -> Int =
  match operation {
    Or -> current | beside,
    And -> current & beside,
    AndNot -> current & ~beside,
    Xor -> current ^ beside,
  }

fn count_ones(w: Int) -> Int = {
  let twos = w - (w >> 1 & 0x1555_5555_5555_5555);
  let fours = (twos & 0x3333_3333_3333_3333) + (twos >> 2 & 0x3333_3333_3333_3333);
  let eights = fours + (fours >> 4) & 0x0F0F_0F0F_0F0F_0F0F;
  let sixteens = eights + (eights >> 8);
  let halves = sixteens + (sixteens >> 16);
  halves + (halves >> 32) & 0x7F
}

fn lowest_bit(w: Int) -> Int = count_ones((w & -w) - 1)

fn highest_bit(w: Int) -> Int = {
  let two = w | w >> 1;
  let four = two | two >> 2;
  let eight = four | four >> 4;
  let sixteen = eight | eight >> 8;
  let half = sixteen | sixteen >> 16;
  count_ones(half | half >> 32) - 1
}

fn low_mask(n: Int) -> Int = if n >= 62 { 0x3FFF_FFFF_FFFF_FFFF } else { (1 << n) - 1 }

fn clear_lowest_set_bits(w: Int, n: Int) -> Int =
  if n <= 0 { w } else { clear_lowest_set_bits(w & w - 1, n - 1) }

fn word(words: Array<Int>, i: Int) -> Int = match words.at(i) { Some(w) -> w, None -> 0 }

fn raise_negative_element<t>(x: Int) -> t / {abort.raise} =
  panic("a bit set cannot contain a negative element, but the element is " ++ x.to_string())

reuse fn copied(into: Array<Int>, from: Array<Int>, i: Int) -> Array<Int> =
  if i >= into.len() { into }
  else { match from.at(i) { Some(w) -> copied(into.set(i, w), from, i + 1), None -> into } }

fn used_word_count(words: Array<Int>, n: Int) -> Int =
  if n <= 0 { 0 } else if word(words, n - 1) == 0 { used_word_count(words, n - 1) } else { n }

fn trimmed(words: Array<Int>) -> Array<Int> / {abort.raise} = {
  let n = used_word_count(words, words.len());
  if n == words.len() { words } else { copied(Array::new(n, 0), words, 0) }
}

/// The set with nothing in it.
pub const empty: Bitset = { words: Array::of_list([]) }

/// Whether the set contains nothing.
pub fn is_empty(s: Bitset) -> Bool = s.words.len() == 0

/// How many elements the set contains.
pub fn size(s: Bitset) -> Int = count_bits_from(s.words, s.words.len(), 0, 0)

fn count_bits_from(words: Array<Int>, end: Int, i: Int, n: Int) -> Int =
  if i >= end { n } else { count_bits_from(words, end, i + 1, n + count_ones(word(words, i))) }

/// Whether `x` is in the set. Nothing below zero ever is.
pub fn contains(s: Bitset, x: Int) -> Bool = x >= 0 && word(s.words, x / 62) >> x % 62 & 1 == 1

/// `s` with `x` added. If `x` is already there, returns `s` unchanged. Raises for an `x` below
/// zero.
pub reuse fn insert(s: Bitset, x: Int) -> Bitset / {abort.raise} =
  if x < 0 { raise_negative_element(x) } else {
    let current = s.words;
    let at = x / 62;
    let bit = 1 << x % 62;
    if at < current.len() {
      let w = current.get(at);
      if w & bit != 0 { { words: current } } else { { words: current.set(at, w | bit) } }
    } else { { words: copied(Array::new(at + 1, 0), current, 0).set(at, bit) } }
  }

/// `s` without `x`. If `x` is absent, returns `s` unchanged.
pub reuse fn remove(s: Bitset, x: Int) -> Bitset / {abort.raise} =
  if !contains(s, x) { s } else {
    let current = s.words;
    let at = x / 62;
    let w = current.get(at) & ~(1 << x % 62);
    { words: trimmed(current.set(at, w)) }
  }

/// `s` with every element from `lo` up to but not including `hi` added. Raises for a `lo` below
/// zero, unless the range is empty.
pub fn insert_range(s: Bitset, lo: Int, hi: Int) -> Bitset / {abort.raise} =
  if lo >= hi { s }
  else if lo < 0 { raise_negative_element(lo) } else {
    let current = s.words;
    let end = (hi - 1) / 62 + 1;
    let room = if end <= current.len() { current } else { copied(Array::new(end, 0), current, 0) };
    { words: spanned(room, lo, hi, Or, lo / 62, end) }
  }

/// Returns `s` without the elements from `lo` up to but not including `hi`.
pub fn remove_range(s: Bitset, lo: Int, hi: Int) -> Bitset / {abort.raise} = {
  let from = if lo < 0 { 0 } else { lo };
  let most = s.words.len() * 62;
  let to = if hi > most { most } else { hi };
  if from >= to { s } else {
    let current = s.words;
    { words: trimmed(spanned(current, from, to, AndNot, from / 62, (to - 1) / 62 + 1)) }
  }
}

reuse fn spanned(
  words: Array<Int>,
  lo: Int,
  hi: Int,
  op: Operation,
  i: Int,
  end: Int,
) -> Array<Int> / {abort.raise} =
  if i >= end { words } else {
    let from = if lo > i * 62 { lo - i * 62 } else { 0 };
    let to = if hi < (i + 1) * 62 { hi - i * 62 } else { 62 };
    let current = words.get(i);
    spanned(
      words.set(i, apply_operation(op, current, low_mask(to) & ~low_mask(from))),
      lo,
      hi,
      op,
      i + 1,
      end,
    )
  }

/// Returns the elements from 0 up to but not including `n` that `s` does not contain.
pub fn complement(s: Bitset, n: Int) -> Bitset / {abort.raise} =
  difference(insert_range(empty, 0, n), s)

/// The elements, in order.
pub fn elements(s: Bitset) -> List<Int> =
  fold(s, [], |accumulator: List<Int>, x: Int| accumulator.push(x))

/// The set of the elements of `xs`. Raises for one below zero.
pub fn of_list(xs: List<Int>) -> Bitset / {abort.raise} = {
  let top = greatest(xs, 0, -1);
  if top < 0 { empty } else { { words: marked(Array::new(top / 62 + 1, 0), xs, 0) } }
}

fn greatest(xs: List<Int>, i: Int, best: Int) -> Int / {abort.raise} =
  match xs.at(i) {
    Some(x) -> if x < 0 { raise_negative_element(x) }
    else { greatest(xs, i + 1, if x > best { x } else { best }) },
    None -> best,
  }

reuse fn marked(words: Array<Int>, xs: List<Int>, i: Int) -> Array<Int> / {abort.raise} =
  match xs.at(i) {
    Some(x) -> {
      let w = words.get(x / 62);
      marked(words.set(x / 62, w | 1 << x % 62), xs, i + 1)
    },
    None -> words,
  }

/// The bit set of a set's elements. Raises for one below zero.
pub fn of_set(s: Set<Int>) -> Bitset / {abort.raise} = of_list(s.elements())

/// The set of a bit set's elements.
pub fn to_set(s: Bitset) -> Set<Int> = Set::of_list(elements(s))

/// The least element, or `None` for the empty set.
pub fn min(s: Bitset) -> Option<Int> = first_from(s.words, 0)

fn first_from(words: Array<Int>, i: Int) -> Option<Int> =
  match words.at(i) {
    Some(w) -> if w == 0 { first_from(words, i + 1) } else { Some(i * 62 + lowest_bit(w)) },
    None -> None,
  }

/// The greatest element, or `None` for the empty set.
pub fn max(s: Bitset) -> Option<Int> = {
  let last = s.words.len() - 1;
  match s.words.at(last) { Some(w) -> Some(last * 62 + highest_bit(w)), None -> None }
}

/// The least element that is `from` or greater, or `None` when there is none.
pub fn next_set(s: Bitset, from: Int) -> Option<Int> = {
  let start = if from < 0 { 0 } else { from };
  let at = start / 62;
  let rest = word(s.words, at) >> start % 62 << start % 62;
  if rest != 0 { Some(at * 62 + lowest_bit(rest)) } else { first_from(s.words, at + 1) }
}

/// How many elements are below `x`.
pub fn rank(s: Bitset, x: Int) -> Int =
  if x <= 0 { 0 } else {
    let at = x / 62;
    let end = if at < s.words.len() { at } else { s.words.len() };
    count_bits_from(s.words, end, 0, count_ones(word(s.words, at) & low_mask(x % 62)))
  }

/// The element with `n` elements below it, or `None` when the set has no more than `n` elements.
pub fn select(s: Bitset, n: Int) -> Option<Int> = if n < 0 { None } else { selected(s.words, 0, n) }

fn selected(words: Array<Int>, i: Int, n: Int) -> Option<Int> =
  match words.at(i) {
    Some(w) -> if n < count_ones(w) { Some(i * 62 + lowest_bit(clear_lowest_set_bits(w, n))) }
    else { selected(words, i + 1, n - count_ones(w)) },
    None -> None,
  }

/// Calls `step` on each element in order, starting from `init` and passing each call the previous
/// call's result.
pub fn fold<t | e>(s: Bitset, init: t, step: (t, Int) -> t / e) -> t / e =
  folded(s.words, 0, init, step)

fn folded<t | e>(words: Array<Int>, i: Int, accumulator: t, step: (t, Int) -> t / e) -> t / e =
  match words.at(i) {
    Some(w) -> folded(words, i + 1, word_folded(w, count_ones(w), i * 62, accumulator, step), step),
    None -> accumulator,
  }

fn word_folded<t | e>(
  w: Int,
  left: Int,
  base: Int,
  accumulator: t,
  step: (t, Int) -> t / e,
) -> t / e =
  if left <= 0 { accumulator }
  else { word_folded(w & w - 1, left - 1, base, step(accumulator, base + lowest_bit(w)), step) }

/// The set of what `f` returns for each element. It is smaller than `s` when `f` returns the same
/// value for two elements. Raises when `f` returns a value below zero.
pub fn map<| e>(s: Bitset, f: (Int) -> Int / e) -> Bitset / {abort.raise | e} =
  of_list(fold(s, [], |accumulator: List<Int>, x: Int| accumulator.push(f(x))))

/// The elements for which `keep` returns true.
pub fn filter<| e>(s: Bitset, keep: (Int) -> Bool / e) -> Bitset / {abort.raise | e} =
  fold(s, s, |accumulator: Bitset, x: Int|
    if keep(x) { accumulator } else { remove(accumulator, x) })

/// The elements for which `ok` returns true, and the rest. `ok` is called once per element.
pub fn partition<| e>(
  s: Bitset,
  ok: (Int) -> Bool / e,
) -> { yes: Bitset, no: Bitset } / {abort.raise | e} =
  fold(s, { yes: s, no: s }, |accumulator: { yes: Bitset, no: Bitset }, x: Int| {
    let yes = accumulator.yes;
    let no = accumulator.no;
    if ok(x) { { yes: yes, no: remove(no, x) } } else { { yes: remove(yes, x), no: no } }
  })

/// Whether `ok` returns true for some element. It calls `ok` in order and stops at the first true.
/// `false` for the empty set.
pub fn any<| e>(s: Bitset, ok: (Int) -> Bool / e) -> Bool / e =
  fold(s, false, |found: Bool, x: Int| found || ok(x))

/// Whether `ok` returns true for every element. It calls `ok` in order and stops at the first
/// false. `true` for the empty set.
pub fn all<| e>(s: Bitset, ok: (Int) -> Bool / e) -> Bool / e =
  fold(s, true, |current: Bool, x: Int| current && ok(x))

/// Whether every element of `xs` is in the set. True for an empty `xs`.
pub fn contains_all(s: Bitset, xs: List<Int>) -> Bool = xs.all(|x: Int| contains(s, x))

/// Whether no element of `xs` is in the set. True for an empty `xs`.
pub fn contains_none(s: Bitset, xs: List<Int>) -> Bool = !xs.any(|x: Int| contains(s, x))

/// Everything in either set.
pub fn union(a: Bitset, b: Bitset) -> Bitset / {abort.raise} = {
  let x = a.words;
  let y = b.words;
  if x.len() >= y.len() { { words: applied(x, y, Or) } } else { { words: applied(y, x, Or) } }
}

/// Everything in any of the sets.
pub fn unions(sets: List<Bitset>) -> Bitset / {abort.raise} = unions_from(empty, sets, 0)

fn unions_from(accumulator: Bitset, sets: List<Bitset>, i: Int) -> Bitset / {abort.raise} =
  match sets.at(i) {
    Some(s) -> unions_from(union(accumulator, s), sets, i + 1),
    None -> accumulator,
  }

/// The elements in both sets.
pub fn intersection(a: Bitset, b: Bitset) -> Bitset / {abort.raise} = {
  let x = a.words;
  let y = b.words;
  if x.len() <= y.len() { { words: applied(x, y, And) } } else { { words: applied(y, x, And) } }
}

/// The elements of `a` that are not in `b`.
pub fn difference(a: Bitset, b: Bitset) -> Bitset / {abort.raise} = {
  let x = a.words;
  let y = b.words;
  { words: applied(x, y, AndNot) }
}

/// The elements in exactly one of the two sets.
pub fn symmetric_difference(a: Bitset, b: Bitset) -> Bitset / {abort.raise} = {
  let x = a.words;
  let y = b.words;
  if x.len() >= y.len() { { words: applied(x, y, Xor) } } else { { words: applied(y, x, Xor) } }
}

fn applied(x: Array<Int>, y: Array<Int>, operation: Operation) -> Array<Int> / {abort.raise} = {
  let n = applied_word_count(x, y, operation, x.len());
  if n == x.len() { combined(x, y, operation, 0) }
  else { combined(copied(Array::new(n, 0), x, 0), y, operation, 0) }
}

fn applied_word_count(x: Array<Int>, y: Array<Int>, operation: Operation, n: Int) -> Int =
  if n <= 0 { 0 } else if apply_operation(operation, word(x, n - 1), word(y, n - 1)) == 0 {
    applied_word_count(x, y, operation, n - 1)
  } else { n }

reuse fn combined(
  into: Array<Int>,
  other: Array<Int>,
  op: Operation,
  i: Int,
) -> Array<Int> / {abort.raise} =
  if i >= into.len() { into } else {
    let current = into.get(i);
    let next = apply_operation(op, current, word(other, i));
    if next == current { combined(into, other, op, i + 1) }
    else { combined(into.set(i, next), other, op, i + 1) }
  }

/// Whether every element of `a` is in `b`. The empty set is a subset of everything.
pub fn is_subset(a: Bitset, b: Bitset) -> Bool = all_zero(a.words, b.words, AndNot, 0)

/// Whether every element of `b` is in `a`.
pub fn is_superset(a: Bitset, b: Bitset) -> Bool = is_subset(b, a)

/// Whether the two sets share no element. The empty set is disjoint from every set.
pub fn is_disjoint(a: Bitset, b: Bitset) -> Bool = all_zero(a.words, b.words, And, 0)

fn all_zero(x: Array<Int>, y: Array<Int>, operation: Operation, i: Int) -> Bool =
  match x.at(i) {
    Some(w) -> apply_operation(operation, w, word(y, i)) == 0 && all_zero(x, y, operation, i + 1),
    None -> true,
  }

test "a word's bits are counted, and its lowest and highest set bits found, at every position" {
  assert_eq(count_ones(0), 0);
  assert_eq(count_ones(low_mask(62)), 62);
  assert_eq(count_ones(0x2AAA_AAAA_AAAA_AAAA), 31);
  assert_eq(clear_lowest_set_bits(13, 2), 8);
  assert(
    range(0, 62).all(|k: Int|
      count_ones(1 << k) == 1 && lowest_bit(1 << k) == k && highest_bit(1 << k) == k
        && count_ones(low_mask(k)) == k
        && lowest_bit(1 << k | 1 << 61) == k
        && highest_bit(1 << k | 1) == k),
  )
}

test "a bit set contains each element once, and lists them in order" {
  let s = of_list([200, 3, 61, 62, 3]);
  assert_eq(elements(s), [3, 61, 62, 200]);
  assert_eq(size(s), 4);
  assert(!is_empty(s));
  assert(is_empty(empty));
  assert(contains(s, 61));
  assert(contains(s, 62));
  assert(!contains(s, 63));
  assert(!contains(s, -1));
  assert(!contains(s, 100000));
  assert_eq(to_set(s), #[3, 61, 62, 200]);
  assert_eq(of_set(#[200, 3, 61, 62]), s);
  assert_eq(elements(empty), [])
}

test "equal bit sets are equal and have equal digests, regardless of how they were built" {
  let grown = insert(insert(insert(empty, 500), 7), 70);
  let shrunk = remove(remove(of_list([7, 70, 500, 900, 9000]), 9000), 900);
  assert_eq(grown, shrunk);
  assert_eq(digest(grown), digest(shrunk));
  assert_eq(#{grown: 1}.get(shrunk), Some(1));
  assert_eq(remove(remove(of_list([5, 700]), 700), 5), empty);
  assert_eq(intersection(of_list([1, 700]), of_list([1, 900])), of_list([1]));
  assert_eq(intersection(of_list([700]), of_list([900])), empty);
  assert_eq(difference(of_list([1, 700]), of_list([700])), of_list([1]));
  assert_eq(symmetric_difference(of_list([1, 700]), of_list([2, 700])), of_list([1, 2]));
  assert_eq(remove_range(of_list([1, 700]), 2, 5000), of_list([1]));
  assert_eq(filter(of_list([1, 700]), |x: Int| x < 9), of_list([1]));
  assert_eq(complement(of_list([0, 1, 2, 700]), 3), empty)
}

test "an element below zero raises when inserted, and is absent everywhere else" {
  let rejected = |x: Int|
    Err("a bit set cannot contain a negative element, but the element is " ++ x.to_string());
  assert_eq(try[abort.raise] { insert(of_list([3]), -1) }, rejected(-1));
  assert_eq(try[abort.raise] { of_list([3, -2]) }, rejected(-2));
  assert_eq(try[abort.raise] { insert_range(empty, -3, 4) }, rejected(-3));
  assert_eq(try[abort.raise] { map(of_list([1]), |x: Int| x - 5) }, rejected(-4));
  assert_eq(remove(of_list([3]), -1), of_list([3]));
  assert_eq(insert_range(of_list([3]), -5, -9), of_list([3]));
  assert_eq(remove_range(of_list([3]), -5, 2), of_list([3]));
  assert_eq(next_set(of_list([3]), -5), Some(3));
  assert_eq(rank(of_list([3]), -5), 0);
  assert_eq(select(of_list([3]), -1), None)
}

test "`insert_range`, `remove_range` and `complement` give correct results for ranges that span several 64-bit words" {
  assert_eq(elements(insert_range(empty, 60, 65)), [60, 61, 62, 63, 64]);
  assert_eq(insert_range(of_list([0, 300]), 60, 126), of_list([0, 300].concat(range(60, 126))));
  assert_eq(insert_range(of_list([5]), 9, 9), of_list([5]));
  assert_eq(size(insert_range(empty, 0, 1000)), 1000);
  assert_eq(
    remove_range(insert_range(empty, 0, 1000), 10, 990),
    of_list(range(0, 10).concat(range(990, 1000))),
  );
  assert_eq(remove_range(insert_range(empty, 0, 1000), 10, 5000), of_list(range(0, 10)));
  assert_eq(remove_range(of_list([5]), 9, 9), of_list([5]));
  assert_eq(complement(of_list([1, 3, 500]), 5), of_list([0, 2, 4]));
  assert_eq(complement(empty, 0), empty);
  assert_eq(complement(insert_range(empty, 0, 200), 200), empty);
  assert_eq(size(complement(of_list([61, 62, 124]), 186)), 183)
}

test "`min`, `max` and `next_set` find elements, `rank` returns the number of smaller elements and `select` returns the nth element" {
  let s = of_list([3, 61, 62, 200]);
  assert_eq([min(s), max(s), min(empty), max(empty)], [Some(3), Some(200), None, None]);
  assert_eq([min(of_list([124])), max(of_list([124]))], [Some(124), Some(124)]);
  let places = [0, 3, 4, 62, 63, 200, 201, 100000];
  let next = places.flat_map(|from: Int| [next_set(s, from)]);
  assert_eq(next, [Some(3), Some(3), Some(61), Some(62), Some(200), Some(200), None, None]);
  let ranks = places.flat_map(|x: Int| [rank(s, x)]);
  assert_eq(ranks, [0, 0, 1, 2, 3, 3, 4, 4]);
  let nth = range(0, 5).flat_map(|n: Int| [select(s, n)]);
  assert_eq(nth, [Some(3), Some(61), Some(62), Some(200), None])
}

test "`map` can return a smaller set, `filter` returns only the elements that pass, and `partition` splits the set in two" {
  let s = of_list([1, 2, 3, 4, 70]);
  assert_eq(map(s, |x: Int| x * 100), of_list([100, 200, 300, 400, 7000]));
  assert_eq(map(s, |x: Int| x % 2), of_list([0, 1]));
  assert_eq(filter(s, |x: Int| x > 3), of_list([4, 70]));
  assert_eq(filter(s, |x: Int| x > 99), empty);
  assert_eq(partition(s, |x: Int| x % 2 == 0), { yes: of_list([2, 4, 70]), no: of_list([1, 3]) });
  assert_eq(partition(s, |x: Int| x < 99), { yes: s, no: empty })
}

effect asking {
  write ask() -> Unit
}

test "`fold` visits elements in ascending order, and `any` and `all` stop as soon as the result is known, even when the callback performs effects" {
  let s = of_list([200, 3, 62]);
  assert_eq(fold(s, [], |accumulator: List<Int>, x: Int| accumulator.push(x)), [3, 62, 200]);
  assert(any(s, |x: Int| x == 62));
  assert(!any(s, |x: Int| x > 200));
  assert(all(s, |x: Int| x > 0));
  assert(!all(s, |x: Int| x < 200));
  assert(!any(empty, |_: Int| true));
  assert(all(empty, |_: Int| false));
  let outcome = handle {
    let found = any(s, |x: Int| {
      asking.ask();
      x == 62
    });
    let current = all(s, |x: Int| {
      asking.ask();
      x < 3
    });
    { found: found, held: current }
  } with {
    var n = 0,
    asking.ask() -> {
      n = n + 1;
    },
    return r -> { found: r.found, held: r.held, requested: n },
  };
  assert_eq(outcome, { found: true, held: false, requested: 3 })
}

test "`union`, `intersection`, `difference`, `symmetric_difference` and the subset, superset and disjoint checks return correct results" {
  let a = of_list([1, 2, 300]);
  let b = of_list([300, 4]);
  assert_eq(union(a, b), of_list([1, 2, 4, 300]));
  assert_eq(union(b, a), of_list([1, 2, 4, 300]));
  assert_eq(unions([of_list([1]), of_list([300, 4]), empty, of_list([1, 2])]), union(a, b));
  assert_eq(unions([]), empty);
  assert_eq(intersection(a, b), of_list([300]));
  assert_eq(intersection(a, empty), empty);
  assert_eq(difference(a, b), of_list([1, 2]));
  assert_eq(difference(b, a), of_list([4]));
  assert_eq(difference(a, a), empty);
  assert_eq(symmetric_difference(a, b), of_list([1, 2, 4]));
  assert_eq(symmetric_difference(a, a), empty);
  assert(is_subset(of_list([1, 300]), a));
  assert(is_subset(empty, a));
  assert(!is_subset(b, a));
  assert(!is_subset(of_list([1, 900]), a));
  assert(is_superset(a, of_list([1])));
  assert(!is_superset(a, b));
  assert(is_disjoint(of_list([1, 2]), of_list([3, 900])));
  assert(is_disjoint(a, empty));
  assert(!is_disjoint(a, b));
  assert(contains_all(a, [1, 300]));
  assert(contains_all(a, []));
  assert(!contains_all(a, [1, 9]));
  assert(contains_none(a, [8, 9, -1]));
  assert(!contains_none(a, [8, 300]))
}

type Pick = { first: Bool, edge: Bool, next_word: Bool, later_word: Bool }

type PickPair = { a: Pick, b: Pick }

type Spot = | First | Edge | Next | LaterWord

fn spot(at: Spot) -> Int = match at { First -> 0, Edge -> 61, Next -> 62, LaterWord -> 130 }

fn listed(p: Pick) -> List<Int> = {
  let first = if p.first { [0] } else { [] };
  let edge = if p.edge { first.push(61) } else { first };
  let next = if p.next_word { edge.push(62) } else { edge };
  if p.later_word { next.push(130) } else { next }
}

fn bitset_of(p: Pick) -> Bitset / {abort.raise} = of_list(listed(p))

fn model(p: Pick) -> Set<Int> = Set::of_list(listed(p))

fn pick_of(s: Bitset) -> Pick =
  {
    first: contains(s, 0),
    edge: contains(s, 61),
    next_word: contains(s, 62),
    later_word: contains(s, 130),
  }

fn on_bitsets(
  operation: keep (Bitset, Bitset) -> Bitset / {abort.raise},
) -> (PickPair) -> Bitset / {abort.raise} = |t: PickPair| operation(bitset_of(t.a), bitset_of(t.b))

fn on_sets(
  operation: keep (Set<Int>, Set<Int>) -> Set<Int>,
) -> (PickPair) -> Bitset / {abort.raise} = |t: PickPair| of_set(operation(model(t.a), model(t.b)))

fn one_by_one(
  s: Bitset,
  xs: List<Int>,
  i: Int,
  operation: (Bitset, Int) -> Bitset / {abort.raise},
) -> Bitset / {abort.raise} =
  match xs.at(i) { Some(x) -> one_by_one(operation(s, x), xs, i + 1, operation), None -> s }

fn spread(xs: List<Int>) -> List<Int> = xs.flat_map(|x: Int| [x & 1023])

law "a bit set lists the same elements as the set it was built from" =
  agrees(|p: Pick| to_set(bitset_of(p)), model)

law "`insert` on a bit set gives the same result as `insert` on a set" =
  refines(
    model,
    |p: Pick, at: Spot| pick_of(insert(bitset_of(p), spot(at))),
    |s: Set<Int>, at: Spot| s.insert(spot(at)),
  )

law "`remove` on a bit set gives the same result as `remove` on a set" =
  refines(
    model,
    |p: Pick, at: Spot| pick_of(remove(bitset_of(p), spot(at))),
    |s: Set<Int>, at: Spot| s.remove(spot(at)),
  )

law "inserting a set's elements one at a time is the union with it" =
  agrees(|t: PickPair| one_by_one(bitset_of(t.a), listed(t.b), 0, insert), on_sets(Set::union))

law "removing a set's elements one at a time is the difference from it" =
  agrees(|t: PickPair| one_by_one(bitset_of(t.a), listed(t.b), 0, remove), on_sets(Set::difference))

law "a union is the bit set of the sets' union" = agrees(on_bitsets(union), on_sets(Set::union))

law "an intersection is the bit set of the sets' intersection" =
  agrees(on_bitsets(intersection), on_sets(Set::intersection))

law "a difference is the bit set of the sets' difference" =
  agrees(on_bitsets(difference), on_sets(Set::difference))

law "a symmetric difference is the bit set of the sets' symmetric difference" =
  agrees(on_bitsets(symmetric_difference), on_sets(Set::symmetric_difference))

law "`is_subset` on bit sets returns the same result as `is_subset` on the equivalent sets" =
  agrees(|t: PickPair| is_subset(bitset_of(t.a), bitset_of(t.b)), |t: PickPair|
    model(t.a).is_subset(model(t.b)))

law "`is_disjoint` on bit sets returns the same result as `is_disjoint` on the equivalent sets" =
  agrees(|t: PickPair| is_disjoint(bitset_of(t.a), bitset_of(t.b)), |t: PickPair|
    model(t.a).is_disjoint(model(t.b)))

law "`size`, `min` and `max` of a bit set equal those of the equivalent set" =
  agrees(
    |p: Pick|
      { size: size(bitset_of(p)), minimum_sizes: min(bitset_of(p)), greatest: max(bitset_of(p)) },
    |p: Pick| { size: model(p).size(), minimum_sizes: model(p).min(), greatest: model(p).max() },
  )

law "a complement is the universe without the set" =
  agrees(|p: Pick| complement(bitset_of(p), 131), |p: Pick|
    of_set(Set::of_list(range(0, 131)).difference(model(p))))

law "the complement of a union equals the intersection of the complements" =
  agrees(
    on_bitsets(|a: Bitset, b: Bitset| complement(union(a, b), 131)),
    on_bitsets(|a: Bitset, b: Bitset| intersection(complement(a, 131), complement(b, 131))),
  )

law "the complement of an intersection equals the union of the complements" =
  agrees(
    on_bitsets(|a: Bitset, b: Bitset| complement(intersection(a, b), 131)),
    on_bitsets(|a: Bitset, b: Bitset| union(complement(a, 131), complement(b, 131))),
  )

law "`rank` returns how many elements are below a value, and `select` at that rank returns the value"
  forall (p: Pick, at: Spot) {
    rank(bitset_of(p), spot(at)) == model(p).filter(|x: Int| x < spot(at)).size()
      && (!contains(bitset_of(p), spot(at))
      || select(bitset_of(p), rank(bitset_of(p), spot(at))) == Some(spot(at)))
  }

law "`next_set` returns the least element at or after a given position"
  forall (p: Pick, at: Spot) {
    next_set(bitset_of(p), spot(at)) == model(p).filter(|x: Int| x >= spot(at)).min()
      && next_set(bitset_of(p), spot(at) + 1) == model(p).filter(|x: Int| x > spot(at)).min()
  }

test "a bit set built from any list of integers contains the same elements as a `Set` built from it" {
  gen::check(gen::list(gen::any_int()), |x: List<Int>|
    agrees(
      |xs: List<Int>| to_set(of_list(spread(xs))),
      |xs: List<Int>| Set::of_list(spread(xs)),
      x,
    ))
}

test "bit set union, intersection, difference, subset and disjoint tests match `Set`'s for any integers" {
  gen::check2(
    gen::list(gen::any_int()),
    gen::list(gen::any_int()),
    |xs: List<Int>, ys: List<Int>| {
      let a = of_list(spread(xs));
      let b = of_list(spread(ys));
      let x = Set::of_list(spread(xs));
      let y = Set::of_list(spread(ys));
      union(a, b) == of_set(x.union(y)) && intersection(a, b) == of_set(x.intersection(y))
        && difference(a, b) == of_set(x.difference(y))
        && symmetric_difference(a, b) == of_set(x.symmetric_difference(y))
        && is_subset(a, b) == x.is_subset(y)
        && is_disjoint(a, b) == x.is_disjoint(y)
    },
  )
}
