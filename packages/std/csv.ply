//! CSV, as RFC 4180 defines it.
//!
//! A file is a list of records, and a record is a list of fields. The writer quotes a field with
//! `"` exactly when it contains a comma, a quote, CR or LF, and doubles any quote inside it.
//!
//! `csv_parse` returns `None` for anything RFC 4180 does not define: an unterminated quoted field,
//! text after a closing quote, a quote inside an unquoted field, or a bare carriage return. It
//! accepts one extension: a bare line feed also ends a record, because real files use it. The
//! writer always writes CRLF. A trailing line break adds no record, and an empty line is one empty
//! field, as a spreadsheet reads it.

import std.string

/// The records in `text`, each a list of its fields; `None` for text that is not RFC 4180.
pub fn csv_parse(text: String) -> Option<List<List<String>>> / {abort.raise} =
  csv_records(text, 0, [], text.len())

/// The text for a table: every field quoted only if it has to be, every record ended with CRLF
/// except the last.
pub fn csv_build(rows: List<List<String>>) -> String = String::join(rows.map(csv_row_text), "\r\n")

fn csv_records(
  text: String,
  at: Int,
  accumulator: List<List<String>>,
  left: Int,
) -> Option<List<List<String>>> / {abort.raise} =
  if at >= text.len() { Some(accumulator) } else {
    match csv_record(text, at) {
      None -> None,
      Some(record) -> if record.at >= text.len() { Some(accumulator.push(record.fields)) }
      else if left <= 0 { panic("more records than characters") }
      else { csv_records(text, record.at, accumulator.push(record.fields), left - 1) },
    }
  }

fn csv_record(text: String, at: Int) -> Option<{ fields: List<String>, at: Int }> / {abort.raise} =
  match csv_field(text, at) {
    None -> None,
    Some(field) -> csv_more_fields(text, field.at, [field.text], text.len() - at),
  }

fn csv_more_fields(
  text: String,
  at: Int,
  accumulator: List<String>,
  left: Int,
) -> Option<{ fields: List<String>, at: Int }> / {abort.raise} =
  if at >= text.len() { Some({ fields: accumulator, at: at }) } else {
    let c = text.slice(at, at + 1);
    if c == "," {
      match csv_field(text, at + 1) {
        None -> None,
        Some(field) -> if left <= 0 { panic("more fields than characters") }
        else { csv_more_fields(text, field.at, accumulator.push(field.text), left - 1) },
      }
    } else if c == "\n" { Some({ fields: accumulator, at: at + 1 }) } else if c == "\r" {
      if at + 1 < text.len() && text.slice(at + 1, at + 2) == "\n" {
        Some({ fields: accumulator, at: at + 2 })
      } else { None }
    } else { None }
  }

fn csv_field(text: String, at: Int) -> Option<{ text: String, at: Int }> / {abort.raise} =
  if at < text.len() && text.slice(at, at + 1) == "\"" { csv_quoted(text, at + 1, "") }
  else { csv_unquoted(text, at, "") }

fn csv_unquoted(
  text: String,
  at: Int,
  accumulator: String,
) -> Option<{ text: String, at: Int }> / {abort.raise} =
  if at >= text.len() { Some({ text: accumulator, at: at }) } else {
    let c = text.slice(at, at + 1);
    if c == "," || c == "\n" { Some({ text: accumulator, at: at }) }
    else if c == "\"" { None } else if c == "\r" {
      if at + 1 < text.len() && text.slice(at + 1, at + 2) == "\n" {
        Some({ text: accumulator, at: at })
      } else { None }
    } else { csv_unquoted(text, at + 1, accumulator ++ c) }
  }

fn csv_quoted(
  text: String,
  at: Int,
  accumulator: String,
) -> Option<{ text: String, at: Int }> / {abort.raise} =
  if at >= text.len() { None } else {
    let c = text.slice(at, at + 1);
    if c == "\"" {
      if at + 1 < text.len() && text.slice(at + 1, at + 2) == "\"" {
        csv_quoted(text, at + 2, accumulator ++ "\"")
      } else { Some({ text: accumulator, at: at + 1 }) }
    } else { csv_quoted(text, at + 1, accumulator ++ c) }
  }

fn csv_row_text(fields: List<String>) -> String = String::join(fields.map(csv_field_text), ",")

fn csv_field_text(field: String) -> String =
  if needs_quotes(field) { "\"" ++ escape_quotes(field) ++ "\"" } else { field }

fn needs_quotes(field: String) -> Bool =
  field.contains(",") || field.contains("\"") || field.contains("\n") || field.contains("\r")

fn escape_quotes(field: String) -> String = String::join(field.split("\""), "\"\"")

test "quoting is the minimum the RFC requires, and it round-trips" {
  assert_eq(csv_build([["a", "b"], ["c", "d"]]), "a,b\r\nc,d");
  assert_eq(csv_parse("a,b\r\nc,d"), Some([["a", "b"], ["c", "d"]]));
  assert_eq(csv_build([["a,b", "c"]]), "\"a,b\",c");
  assert_eq(csv_build([["a\"b"]]), "\"a\"\"b\"");
  assert_eq(csv_build([["a\nb"]]), "\"a\nb\"");
  assert_eq(csv_build([["a\rb"]]), "\"a\rb\"");
  assert_eq(csv_parse("\"a,b\",\"c\"\"d\""), Some([["a,b", "c\"d"]]));
  assert_eq(csv_parse("\"a\nb\",c"), Some([["a\nb", "c"]]));
  assert_eq(csv_build([["plain"]]), "plain")
}

test "a final line ending adds no CSV record, and an empty line is a record with one empty field" {
  assert_eq(csv_parse(""), Some([]));
  assert_eq(csv_parse("a"), Some([["a"]]));
  assert_eq(csv_parse("a\n"), Some([["a"]]));
  assert_eq(csv_parse("a\r\n"), Some([["a"]]));
  assert_eq(csv_parse("a\nb"), Some([["a"], ["b"]]));
  assert_eq(csv_parse("\n"), Some([[""]]));
  assert_eq(csv_parse("a\n\n"), Some([["a"], [""]]));
  assert_eq(csv_parse("a,"), Some([["a", ""]]));
  assert_eq(csv_parse(","), Some([["", ""]]))
}

test "the parser rejects what the RFC does not define" {
  assert_eq(csv_parse("\"unterminated"), None);
  assert_eq(csv_parse("a\"b"), None);
  assert_eq(csv_parse("\"a\"b"), None);
  assert_eq(csv_parse("a\rb"), None);
  assert_eq(csv_parse("a\"\"b"), None)
}
