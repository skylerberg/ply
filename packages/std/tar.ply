//! Tar archives: reads, writes and plans the extraction of them as values, and packs a directory
//! tree into one and extracts one onto a directory, using a root of `std.fs`. A root is a `std.fs`
//! value that limits file access to one directory and everything beneath it.
//!
//! `read` turns an archive's bytes into entries, each a header and its data. It understands POSIX
//! ustar, pax extended headers (long and non-ASCII paths, large sizes and owner ids, times finer
//! than a second), GNU tar's long name and long link members and base-256 numbers, and the old v7
//! format. It accepts a header checksum computed with signed or unsigned bytes.
//!
//! `read` takes `Limits`: the most entries, the most bytes of data in total and in one entry, and
//! the longest path. It rejects an archive, reporting the reason and the header's offset, when a
//! checksum does not match, a number field is not a number, an extended record is malformed, a name
//! is not UTF-8, or the archive ends inside an entry. A device, a FIFO and any type flag this
//! module has no name for are read as their headers describe them. A sparse file is read as a
//! `Sparse` entry whose data is the stored form, not expanded.
//!
//! `read`, and `members`, which lists an archive without its data, are built on `step`. `step`
//! reads one member's header from the bytes seen so far and returns where the member's data lies
//! and where the next member starts, or how many bytes it needs first. A caller that has only part
//! of an archive calls `step` again as more bytes arrive.
//!
//! `write` emits ustar, with a pax header before an entry only where ustar cannot express it. Equal
//! entries give equal bytes, because `write` adds no clock, user or order of its own. `file`,
//! `directory`, `symlink` and `hard_link` make entries owned by nobody and modified at the epoch
//! unless told otherwise.
//!
//! An entry's path is whatever the archive says, and an archive may say `../../etc/passwd`. `plan`
//! touches no file system. It returns the operations that extract a list of entries beneath a root,
//! each on a path checked to stay inside the root, or the entry that may not be extracted and why.
//! It rejects: - an absolute path, or a path that climbs out of the root; - an entry beneath a
//! symbolic link or beneath a file the archive itself made; - a symbolic link that points out of
//! the root or through another link; - a hard link to anything but a file the archive made earlier;
//! - an entry that replaces an earlier one with a different kind of thing; - devices, FIFOs and
//! sparse files.
//!
//! A path's segments are what lies between `/`. These checks compare paths in Unicode lower case,
//! so an archive cannot pass through a link by exploiting a case-folding file system; Unicode
//! normalization is not folded. A later file replaces an earlier one at the same path, and every
//! operation's mode is permission bits only.
//!
//! `extract` carries out a plan beneath a directory of a root. `unpack` reads an archive from a
//! file and extracts it. It checks every member before it writes any, and it holds no more of the
//! archive in memory than a window.
//!
//! A plan knows what the archive made, but not what the directory already contained or what another
//! program changes meanwhile, so each operation checks first. The directory it writes in must be
//! reached through no link and under the name the plan gave it, and whatever is already at the path
//! must be something the operation may replace. A file is always created new, and only where
//! nothing exists, so nothing is written through a link or into another name of the same file.
//!
//! One race remains: between a check and the write after it, a program that can write in the
//! directory can put a link there. The write then lands where the link leads, but the root still
//! keeps that inside the root.
//!
//! `pack` writes the archive of a tree into a sink, one chunk of a file at a time. Its entries are
//! sorted by name. Unless told to keep them, it omits the times and modes that differ from one
//! checkout to the next.

import std.bytes (ascii_of_int)
import std.fs
import std.fs (fs, files, FileError)
import std.io
import std.io (io, Sink, Source)
import std.list (enumerate)
import std.option
import std.path
import std.result
import std.string
import std.time (nanos_at)
import std.unicode
import std.gen

/// What an entry is.
pub type Kind =
  | File
  | Directory
  /// A symbolic link to the text in its header's `link`.
  | Symlink
  /// Another name for the file at the archive path in its header's `link`.
  | HardLink
  | CharDevice
  | BlockDevice
  | Fifo
  /// A sparse file as GNU tar stores it, without its holes. The entry's data is the stored bytes,
  /// not expanded to the file's full size. In the pax sparse format, the data starts with a map of
  /// which parts of the file are stored.
  | Sparse
  /// Any other type flag. The `Int` is the flag's byte value.
  | Other(Int)

/// One record of a pax extended header.
pub type Record = new { keyword: String, value: Bytes }

/// The metadata of an archive member: everything except its data.
pub type Header = new {
  /// The member's path exactly as the archive stores it, without a directory's trailing `/`. It is
  /// untrusted: it may be absolute or climb out of the extraction root. `plan` checks it before
  /// anything is extracted.
  path: String,
  kind: Kind,
  /// The permission, set-id and sticky bits.
  mode: Int,
  uid: Int,
  gid: Int,
  uname: String,
  gname: String,
  /// Counted from the Unix epoch.
  modified: Instant,
  /// A link's target; empty for any other kind.
  link: String,
  /// A device's numbers; zero for any other kind.
  major: Int,
  minor: Int,
  /// The pax extended records that apply to this member and that no field above stores, sorted by
  /// keyword. Examples are access and change times, extended attributes and vendor-specific
  /// records.
  extended: List<Record>,
}

/// A member of an archive: its header and its data, which only a `File`, a `Sparse` and an
/// `Other` have.
pub type Entry = new { header: Header, data: Bytes }

fn header(path: String, kind: Kind, mode: Int, modified: Instant, link: String) -> Header =
  {
    path: path,
    kind: kind,
    mode: mode,
    uid: 0,
    gid: 0,
    uname: "",
    gname: "",
    modified: modified,
    link: link,
    major: 0,
    minor: 0,
    extended: [],
  }

/// A file's entry, mode `0644`.
pub fn file(path: String, data: Bytes, mode: Int = 420, modified: Instant = Instant(0)) -> Entry =
  { header: header(path, File, mode, modified, ""), data: data }

/// A directory's entry, mode `0755`.
pub fn directory(path: String, mode: Int = 493, modified: Instant = Instant(0)) -> Entry =
  { header: header(path, Directory, mode, modified, ""), data: b"" }

/// A symbolic link's entry: `path` points at the text `target`.
pub fn symlink(path: String, target: String, modified: Instant = Instant(0)) -> Entry =
  { header: header(path, Symlink, 511, modified, target), data: b"" }

/// A hard link's entry: `path` is another name for the file an earlier entry put at `target`.
pub fn hard_link(path: String, target: String, modified: Instant = Instant(0)) -> Entry =
  { header: header(path, HardLink, 420, modified, target), data: b"" }

/// Why a reader rejected an archive, or a writer an entry.
pub type ErrorKind =
  /// The archive ends inside a header or an entry's data.
  | Truncated
  /// A header whose stored checksum equals neither the sum of its bytes as unsigned values nor the
  /// sum as signed values.
  | BadChecksum
  /// A header field that is not a number, or a number outside the range its field can store: a
  /// negative size, a time outside an `Instant`'s range, or a mode above `07777`.
  | BadNumber
  /// An extended header that is not made of `length keyword=value` records, a record whose value is
  /// invalid for its keyword, or, when writing, a record whose keyword is one that a `Header` field
  /// already stores.
  | BadRecord
  /// A path, a link or an owner's name that is not UTF-8.
  | NotUtf8
  /// A block of zeros that is not followed by a second block of zeros. An archive ends with two.
  | BadEnd
  /// More entries than the reader's limit.
  | TooMany
  /// An entry, or an extended header, larger than the reader's limit.
  | TooLarge
  /// More data in total than the reader's limit.
  | TooMuch
  /// A path or a link longer than the reader's limit.
  | TooLong
  /// A path, a link or an owner's name that cannot be written to a header: one containing a NUL, an
  /// empty path, or a path that ends in `/`.
  | BadName
  /// Data on an entry of a kind that has none.
  | StrayData
  /// A kind that cannot be written: `Sparse`, or an `Other` whose type flag is the flag of another
  /// kind.
  | BadKind

/// A reading error, and the offset of the header it is about.
pub type Error = new { at: Int, reason: ErrorKind }

/// A writing error, and the index of the entry it rejected.
pub type WriteError = new { index: Int, reason: ErrorKind }

/// Why an entry may not be extracted.
pub type UnsafeReason =
  /// An empty path, or a path or a link with a NUL.
  | NoName
  /// A path that starts at the file system's root.
  | Absolute
  /// A path that climbs out of the root it is extracted under.
  | Escapes
  /// A path that passes through a symbolic link that an earlier entry created. Also a link created
  /// at a location that an earlier link's target passes through.
  | ThroughLink
  /// A path inside a location that an earlier entry created as a regular file, so the file would
  /// have to be a directory.
  | BeneathFile
  /// An entry that replaces an earlier entry of a different kind at the same path, such as a link
  /// replacing a directory or a directory replacing a file.
  | Replaces
  /// A symbolic link whose target is absolute or climbs out of the root, or a hard link whose
  /// target does.
  | LinkEscapes
  /// A hard link whose target is not a regular file that an earlier entry created.
  | LinkMissing
  /// A kind that extraction does not create: a device, a FIFO, a sparse file, or an entry whose
  /// type flag is not a known kind.
  | Special
  /// A path or a link containing a `\`, which some systems treat as a `/` and others as an ordinary
  /// name character. Tar names are Unix names, so `std.tar` does not reject a `\` in a name;
  /// `std.zip` does.
  | Backslash
  /// A path or a link with a segment that starts with a letter followed by `:`, which some systems
  /// treat as a drive. `std.zip` rejects this, as it rejects a `\`, but `std.tar` does not.
  | Drive

/// An entry that may not be extracted: its index among the entries, its path as written in the
/// archive, and the reason.
pub type UnsafeEntry = new { index: Int, path: String, reason: UnsafeReason }

/// The effects this module raises when it rejects its input.
pub effect tar {
  /// The bytes are not an archive within the limits.
  raise fail(e: Error)
  /// An entry has no header.
  raise unwritable(e: WriteError)
  /// An entry may not be extracted.
  raise unsafe(e: UnsafeEntry)
}

fn fail<a>(at: Int, reason: ErrorKind) -> a / {tar.fail} = tar.fail({ at: at, reason: reason })

fn text(header_block: Bytes, from: Int, width: Int) -> Bytes / {abort.raise} = {
  let field = header_block.slice(from, from + width);
  field.slice(0, field.skip_until(0, b"\x00"))
}

fn number(header_block: Bytes, from: Int, width: Int) -> Option<Int> / {abort.raise} = {
  let field = header_block.slice(from, from + width);
  if field.at(0) >= 0x80 { twos_complement_number(field) } else {
    let start = field.skip(0, b" \x00");
    let end = field.skip(start, b"01234567");
    if end < width && field.at(end) != 0x20 && field.at(end) != 0 { None }
    else { Some(range(start, end).fold(0, |n: Int, i: Int| n << 3 | field.at(i) - 48)) }
  }
}

fn twos_complement_number(field: Bytes) -> Option<Int> / {abort.raise} = {
  let negative = field.at(0) & 0x40 != 0;
  let flip = if negative { 0xFF } else { 0 };
  let magnitude = range(0, field.len()).fold(Some(0), |so_far: Option<Int>, i: Int|
    match so_far {
      Some(n) -> if n >> 55 != 0 { None }
      else { Some(n << 8 | (field.at(i) ^ flip) & (if i == 0 { 0x7F } else { 0xFF })) },
      None -> None,
    });
  magnitude.map(|n: Int| if negative { -1 - n } else { n })
}

fn size_ceiling() -> Int = 0x1000_0000_0000_0000

fn field_number(
  header_block: Bytes,
  at: Int,
  from: Int,
  width: Int,
) -> Int / {tar.fail, abort.raise} =
  match number(header_block, from, width) {
    Some(n) -> if n < 0 || n >= size_ceiling() { fail(at, BadNumber) } else { n },
    None -> fail(at, BadNumber),
  }

fn sums(header_block: Bytes) -> { unsigned: Int, signed: Int } / {abort.raise} =
  range(0, 512).fold({ unsigned: 0, signed: 0 }, |sum: { unsigned: Int, signed: Int }, i: Int| {
    let byte = if i >= 148 && i < 156 { 0x20 } else { header_block.at(i) };
    {
      unsigned: sum.unsigned + byte,
      signed: sum.signed + (if byte >= 0x80 { byte - 256 } else { byte }),
    }
  })

type Format = | Old | Ustar | Gnu

type RawHeader = {
  name: Bytes,
  mode: Int,
  uid: Int,
  gid: Int,
  size: Int,
  seconds: Int,
  flag: Int,
  link: Bytes,
  uname: Bytes,
  gname: Bytes,
  major: Int,
  minor: Int,
  prefix: Bytes,
  continued: Bool,
}

fn read_raw_header(seen: Bytes, at: Int) -> RawHeader / {tar.fail, abort.raise} = {
  let header_block = seen.slice(at, at + 512);
  let sum = sums(header_block);
  let stored = number(header_block, 148, 8);
  if stored != Some(sum.unsigned) && stored != Some(sum.signed) { fail(at, BadChecksum) } else {
    let format = if header_block.slice(257, 262) != b"ustar" { Old }
    else if header_block.at(262) == 0x20 { Gnu }
    else { Ustar };
    let flag = header_block.at(156);
    let device = format != Old && (flag == 51 || flag == 52);
    {
      name: text(header_block, 0, 100),
      mode: field_number(header_block, at, 100, 8),
      uid: field_number(header_block, at, 108, 8),
      gid: field_number(header_block, at, 116, 8),
      size: field_number(header_block, at, 124, 12),
      seconds: match number(header_block, 136, 12) { Some(n) -> n, None -> fail(at, BadNumber) },
      flag: flag,
      link: text(header_block, 157, 100),
      uname: if format == Old { b"" } else { text(header_block, 265, 32) },
      gname: if format == Old { b"" } else { text(header_block, 297, 32) },
      major: if device { field_number(header_block, at, 329, 8) } else { 0 },
      minor: if device { field_number(header_block, at, 337, 8) } else { 0 },
      prefix: if format == Ustar { text(header_block, 345, 155) } else { b"" },
      continued: format == Gnu && flag == 83 && header_block.at(482) != 0,
    }
  }
}

fn kind_of(flag: Int, stored: Bytes) -> Kind =
  if flag == 0 || flag == 48 || flag == 55 { if stored.ends_with(b"/") { Directory } else { File } }
  else if flag == 49 { HardLink }
  else if flag == 50 { Symlink }
  else if flag == 51 { CharDevice }
  else if flag == 52 { BlockDevice }
  else if flag == 53 { Directory }
  else if flag == 54 { Fifo }
  else if flag == 83 { Sparse }
  else { Other(flag) }

fn flag_of(kind: Kind) -> Option<Int> =
  match kind {
    File -> Some(48),
    HardLink -> Some(49),
    Symlink -> Some(50),
    CharDevice -> Some(51),
    BlockDevice -> Some(52),
    Directory -> Some(53),
    Fifo -> Some(54),
    Sparse -> None,
    Other(flag) -> if flag < 1 || flag > 255 || (flag >= 48 && flag <= 55) || describes_next(flag)
        || flag == 83 { None }
    else { Some(flag) },
  }

fn describes_next(flag: Int) -> Bool = flag == 120 || flag == 103 || flag == 76 || flag == 75

fn has_data(kind: Kind) -> Bool = match kind { File | Sparse | Other(_) -> true, _ -> false }

fn padded(size: Int) -> Int = (size + 511) / 512 * 512

/// Returns the length of the first `n` bytes of `stored` after removing trailing slashes, but never
/// less than 1.
pub fn slash_trimmed_length(stored: Bytes, n: Int) -> Int / {abort.raise} =
  if n > 1 && stored.at(n - 1) == 0x2F { slash_trimmed_length(stored, n - 1) } else { n }

fn header_keywords() -> List<String> =
  ["path", "linkpath", "size", "uid", "gid", "uname", "gname", "mtime"]

fn records(at: Int, data: Bytes) -> List<Record> / {tar.fail, abort.raise} =
  records_from(at, data, 0, [], data.len())

fn records_from(
  at: Int,
  data: Bytes,
  i: Int,
  accumulator: List<Record>,
  span: Int,
) -> List<Record> / {tar.fail, abort.raise} =
  if i >= data.len() || span <= 0 { accumulator } else {
    let digits = data.skip(i, b"0123456789");
    match data.slice(i, digits).int_of_ascii() {
      None -> fail(at, BadRecord),
      Some(length) -> if length < digits - i + 2 || length > data.len() - i
          || data.at(digits) != 0x20
          || data.at(i + length - 1) != 0x0A { fail(at, BadRecord) } else {
        let body = data.slice(digits + 1, i + length - 1);
        let keyword = body.slice(0, body.skip_until(0, b"="));
        if keyword.len() == 0 || keyword.len() == body.len() || !keyword.is_utf8() {
          fail(at, BadRecord)
        } else {
          records_from(
            at,
            data,
            i + length,
            accumulator.push({
              keyword: String::of_bytes(keyword),
              value: body.slice(keyword.len() + 1, body.len()),
            }),
            span - 1,
          )
        }
      },
    }
  }

fn record_bytes(keyword: String, value: Bytes) -> Bytes = {
  let body = Bytes::concat_all([b" ", Bytes::of_string(keyword), b"=", value, b"\n"]);
  let short = body.len() + ascii_of_int(body.len()).len();
  let whole = body.len() + ascii_of_int(short).len();
  ascii_of_int(whole).concat(body)
}

fn with_records(pax_records: Map<String, Bytes>, more: List<Record>) -> Map<String, Bytes> =
  more.fold(pax_records, |m: Map<String, Bytes>, r: Record| m.insert(r.keyword, r.value))

fn instant_of(text: Bytes) -> Option<Instant> / {abort.raise} = {
  let n = text.len();
  let negative = n > 0 && text.at(0) == 0x2D;
  let from = if negative { 1 } else { 0 };
  let dot = text.skip(from, b"0123456789");
  let end = if dot < n && text.at(dot) == 0x2E { text.skip(dot + 1, b"0123456789") } else { dot };
  if dot == from || end != n || end == dot + 1 { None } else {
    let fraction = range(dot + 1, dot + 10).fold(0, |f: Int, i: Int|
      f * 10 + (if i < end { text.at(i) - 48 } else { 0 }));
    let nanos = text.slice(from, dot).int_of_ascii().and_then(|seconds: Int|
      checked_mul(seconds, 1000000000).and_then(|whole: Int| checked_add(whole, fraction)));
    nanos.map(|byte_sum: Int| Instant(if negative { 0 - byte_sum } else { byte_sum }))
  }
}

fn instant_text(nanos: Int) -> Bytes / {abort.raise} = {
  let size = if nanos < 0 { 0 - nanos } else { nanos };
  let fraction = Bytes::of_string(Int::to_string(1000000000 + size % 1000000000));
  let trimmed_length = zero_trimmed_length(fraction, 10);
  Bytes::concat_all([
    if nanos < 0 { b"-" } else { b"" },
    ascii_of_int(size / 1000000000),
    if trimmed_length == 1 { b"" } else { b".".concat(fraction.slice(1, trimmed_length)) },
  ])
}

fn zero_trimmed_length(digits: Bytes, n: Int) -> Int / {abort.raise} =
  if n > 1 && digits.at(n - 1) == 0x30 { zero_trimmed_length(digits, n - 1) } else { n }

/// What a reader accepts: `entries` members, `total` bytes of data in all, `size` bytes in one, and
/// `path` bytes in a path or a link. The data of a member that only describes the next, an extended
/// header or a GNU long name, is limited by `size` and counts toward `total`.
pub type Limits = new { entries: Int, total: Int, size: Int, path: Int }

/// A reader's position in an archive: the offset of the next header in the bytes seen, the entries
/// and bytes of data read so far, and the global extended records in effect.
pub type Cursor = new { at: Int, entries: Int, bytes: Int, global: Map<String, Bytes> }

/// A cursor at an archive's first header.
pub fn start() -> Cursor = { at: 0, entries: 0, bytes: 0, global: Map::new() }

/// A member found: its header, the offset of its data in the bytes seen and how many bytes it
/// is, and the cursor after it. The data need not have been seen yet.
pub type Member = new { header: Header, data: Int, size: Int, next: Cursor }

/// What `step` found at a cursor.
pub type Step =
  | Next(Member)
  /// The two blocks of zeros that end an archive.
  | End
  /// The bytes seen so far end before the next member's header is complete, counting any extended
  /// headers before it. The `Int` is the total number of bytes, counted from the start of the
  /// archive, that `seen` must contain before `step` can make progress.
  | NeedMore(Int)

type Pending = { path: Option<Bytes>, link: Option<Bytes>, local: Map<String, Bytes> }

/// Reads the member that starts at `from` in `seen`, the archive bytes received so far. Returns
/// `Next` with the member, `End` at the closing zero blocks, or `NeedMore` with the length `seen`
/// must reach before the member can be read. Fails with `tar.fail` on a malformed archive. Offsets
/// count from the start of `seen`.
pub fn step(seen: Bytes, from: Cursor, limits: Limits) -> Step / {tar.fail, abort.raise} =
  read_member_header(
    seen,
    from,
    limits,
    { path: None, link: None, local: Map::new() },
    (seen.len() - from.at) / 512 + 1,
  )

fn read_member_header(
  seen: Bytes,
  c: Cursor,
  limits: Limits,
  pending: Pending,
  span: Int,
) -> Step / {tar.fail, abort.raise} =
  if span <= 0 || c.at < 0 || seen.len() - c.at < 512 { NeedMore(max(c.at, 0) + 512) }
  else if seen.skip(c.at, b"\x00") >= c.at + 512 {
    if seen.len() - c.at < 1024 { NeedMore(c.at + 1024) }
    else if seen.skip(c.at + 512, b"\x00") >= c.at + 1024 { End }
    else { fail(c.at + 512, BadEnd) }
  } else {
    let h = read_raw_header(seen, c.at);
    let data = c.at + 512;
    if !describes_next(h.flag) { finish_member(seen, c, limits, pending, h) }
    else if h.size > limits.size { fail(c.at, TooLarge) }
    else if h.size > limits.total - c.bytes { fail(c.at, TooMuch) }
    else if h.size > seen.len() - data { NeedMore(data + h.size) } else {
      let header_keywords = seen.slice(data, data + h.size);
      let after = { ..c, at: data + padded(h.size), bytes: c.bytes + h.size };
      if h.flag == 103 {
        read_member_header(
          seen,
          { ..after, global: with_records(c.global, records(c.at, header_keywords)) },
          limits,
          pending,
          span - 1,
        )
      } else {
        let name = Some(header_keywords.slice(0, header_keywords.skip_until(0, b"\x00")));
        read_member_header(
          seen,
          after,
          limits,
          if h.flag == 120 {
            { ..pending, local: with_records(pending.local, records(c.at, header_keywords)) }
          } else if h.flag == 76 { { ..pending, path: name } }
          else { { ..pending, link: name } },
          span - 1,
        )
      }
    }
  }

fn past_map(seen: Bytes, at: Int, continued: Bool, span: Int) -> Option<Int> / {abort.raise} =
  if !continued { Some(at) }
  else if span <= 0 || seen.len() - at < 512 { None }
  else { past_map(seen, at + 512, seen.at(at + 504) != 0, span - 1) }

fn utf8(at: Int, text: Bytes) -> String / {tar.fail, abort.raise} =
  if text.is_utf8() { String::of_bytes(text) } else { fail(at, NotUtf8) }

fn decimal(at: Int, text: Bytes) -> Int / {tar.fail, abort.raise} =
  match text.int_of_ascii() {
    Some(n) -> if n < 0 || n >= size_ceiling() { fail(at, BadRecord) } else { n },
    None -> fail(at, BadRecord),
  }

fn finish_member(
  seen: Bytes,
  c: Cursor,
  limits: Limits,
  pending: Pending,
  h: RawHeader,
) -> Step / {tar.fail, abort.raise} = {
  let pax_records = c.global.merge(pending.local).fold(
    Map::new(),
    |non_empty_records: Map<String, Bytes>, keyword: String, value: Bytes|
      if value.len() == 0 { non_empty_records } else { non_empty_records.insert(keyword, value) },
  );
  let stored = match pending.path {
    Some(long) -> long,
    None -> match pax_records.get("path") {
      Some(path) -> path,
      None -> if h.prefix.len() == 0 { h.name }
      else { Bytes::concat_all([h.prefix, b"/", h.name]) },
    },
  };
  let kind = if pax_records.keys().any(|keyword: String| keyword.starts_with("GNU.sparse.")) {
    Sparse
  } else { kind_of(h.flag, stored) };
  let path = if kind == Directory { stored.slice(0, slash_trimmed_length(stored, stored.len())) }
  else { stored };
  let link = match pending.link {
    Some(long) -> long,
    None -> match pax_records.get("linkpath") { Some(target) -> target, None -> h.link },
  };
  let size = if !has_data(kind) { 0 }
  else { match pax_records.get("size") { Some(digits) -> decimal(c.at, digits), None -> h.size } };
  let modified = match pax_records.get("mtime") {
    Some(time) -> match instant_of(time) { Some(t) -> t, None -> fail(c.at, BadRecord) },
    None -> match checked_mul(h.seconds, 1000000000) {
      Some(nanos) -> Instant(nanos),
      None -> fail(c.at, BadNumber),
    },
  };
  let named = |keyword: String, written: Bytes|
    match pax_records.get(keyword) { Some(value) -> value, None -> written };
  let counted = |keyword: String, written: Int|
    match pax_records.get(keyword) { Some(digits) -> decimal(c.at, digits), None -> written };
  if c.entries >= limits.entries { fail(c.at, TooMany) }
  else if path.len() > limits.path || link.len() > limits.path { fail(c.at, TooLong) }
  else if size > limits.size { fail(c.at, TooLarge) }
  else if size > limits.total - c.bytes { fail(c.at, TooMuch) } else {
    match past_map(seen, c.at + 512, h.continued, seen.len() / 512) {
      None -> NeedMore(seen.len() + 512),
      Some(data) ->
        Next({
          header: {
            path: utf8(c.at, path),
            kind: kind,
            mode: h.mode & 0xFFF,
            uid: counted("uid", h.uid),
            gid: counted("gid", h.gid),
            uname: utf8(c.at, named("uname", h.uname)),
            gname: utf8(c.at, named("gname", h.gname)),
            modified: modified,
            link: utf8(c.at, link),
            major: h.major,
            minor: h.minor,
            extended: header_keywords().fold(
              pax_records,
              |rest: Map<String, Bytes>, keyword: String| rest.remove(keyword),
            ).entries(
            ).map(|e: { key: String, value: Bytes }| -> Record {
              { keyword: e.key, value: e.value }
            }),
          },
          data: data,
          size: size,
          next: {
            at: data + padded(size),
            entries: c.entries + 1,
            bytes: c.bytes + size,
            global: c.global,
          },
        }),
    }
  }
}

/// Every member of `archive`, its header and where its data lies, without the data: a listing.
/// An archive may end at its last member without the blocks of zeros that should follow.
pub fn members(archive: Bytes, limits: Limits) -> List<Member> / {tar.fail, abort.raise} =
  collect_members(archive, start(), limits, [], archive.len() / 512 + 1)

fn collect_members(
  archive: Bytes,
  c: Cursor,
  limits: Limits,
  accumulator: List<Member>,
  span: Int,
) -> List<Member> / {tar.fail, abort.raise} =
  if span <= 0 { accumulator } else {
    match step(archive, c, limits) {
      End -> accumulator,
      NeedMore(_) -> if archive.skip(c.at, b"\x00") >= archive.len() { accumulator }
      else { fail(c.at, Truncated) },
      Next(m) -> if m.size > archive.len() - m.data { fail(c.at, Truncated) }
      else { collect_members(archive, m.next, limits, accumulator.push(m), span - 1) },
    }
  }

/// The entries of `archive`. Raises `tar.fail` where `decode` returns `Err`.
pub fn read(archive: Bytes, limits: Limits) -> List<Entry> / {tar.fail, abort.raise} =
  members(archive, limits).map(|m: Member| -> Entry {
    { header: m.header, data: archive.slice(m.data, m.data + m.size) }
  })

/// The entries of `archive`, or why it is not an archive within `limits`.
pub fn decode(archive: Bytes, limits: Limits) -> Result<List<Entry>, Error> / {abort.raise} =
  try { read(archive, limits) }

type HeaderFields = {
  name: Bytes,
  mode: Int,
  uid: Int,
  gid: Int,
  size: Int,
  seconds: Int,
  flag: Int,
  link: Bytes,
  uname: Bytes,
  gname: Bytes,
  major: Int,
  minor: Int,
  prefix: Bytes,
}

fn octal(n: Int, digits: Int) -> Bytes =
  Bytes::concat_all(
    range(0, digits).map(|i: Int| byte_of_int(48 + (n >> 3 * (digits - 1 - i) & 7))),
  ).concat(
    b"\x00",
  )

fn nul_padded(text: Bytes, width: Int) -> Bytes = text.concat(b"\x00".repeat(width - text.len()))

fn byte_sum(bytes: Bytes) -> Int =
  range(0, bytes.len()).fold(0, |sum: Int, i: Int| sum + bytes.at(i))

fn header_block(b: HeaderFields) -> Bytes / {abort.raise} = {
  let before = Bytes::concat_all([
    nul_padded(b.name, 100),
    octal(b.mode, 7),
    octal(b.uid, 7),
    octal(b.gid, 7),
    octal(b.size, 11),
    octal(b.seconds, 11),
  ]);
  let after = Bytes::concat_all([
    byte_of_int(b.flag),
    nul_padded(b.link, 100),
    b"ustar\x0000",
    nul_padded(b.uname, 32),
    nul_padded(b.gname, 32),
    octal(b.major, 7),
    octal(b.minor, 7),
    nul_padded(b.prefix, 155),
    b"\x00".repeat(12),
  ]);
  Bytes::concat_all([before, octal(byte_sum(before) + 8 * 0x20 + byte_sum(after), 6), b" ", after])
}

fn ascii(text: Bytes) -> Bool = text.position(0, |byte: Int| byte >= 0x80) == None

fn shortened(text: Bytes, width: Int) -> Bytes =
  Bytes::concat_all(
    range(0, min(width, text.len())).map(|i: Int|
      if text.at(i) >= 0x80 { b"_" } else { text.slice(i, i + 1) }),
  )

fn prefix_split(stored: Bytes) -> Option<Int> = {
  let n = stored.len();
  range(max(1, n - 101), min(n - 1, 156)).fold(None, |found: Option<Int>, i: Int|
    if stored.at(i) == 0x2F { Some(i) } else { found })
}

fn unwritable<a>(index: Int, reason: ErrorKind) -> a / {tar.unwritable} =
  tar.unwritable({ index: index, reason: reason })

fn max_octal_field() -> Int = 0x1F_FFFF
fn eleven_digits() -> Int = 0x1_FFFF_FFFF

fn header_error(h: Header, size: Int) -> Option<ErrorKind> = {
  let nul = |text: String| text.contains("\0");
  let device = h.kind == CharDevice || h.kind == BlockDevice;
  if h.path == "" || h.path.ends_with("/") || nul(h.path) || nul(h.link) || nul(h.uname)
      || nul(h.gname) { Some(BadName) }
  else if flag_of(h.kind) == None { Some(BadKind) }
  else if size > 0 && !has_data(h.kind) { Some(StrayData) }
  else if h.mode < 0 || h.mode > 0xFFF || h.uid < 0 || h.gid < 0 || h.major < 0 || h.minor < 0
      || h.major > max_octal_field()
      || h.minor > max_octal_field()
      || (!device && (h.major != 0 || h.minor != 0))
      || size >= size_ceiling()
      || checked_neg(nanos_at(h.modified)) == None { Some(BadNumber) }
  else if h.extended.any(|r: Record|
      r.keyword == "" || r.keyword.contains("=") || r.value.len() == 0
        || header_keywords().any(|keyword: String| keyword == r.keyword)
        || r.keyword.starts_with("GNU.sparse.")) { Some(BadRecord) }
  else { None }
}

fn member_bytes(index: Int, e: Entry) -> Bytes / {tar.unwritable, abort.raise} = {
  let size = e.data.len();
  Bytes::concat_all([
    header_bytes(index, e.header, size),
    e.data,
    b"\x00".repeat(padded(size) - size),
  ])
}

fn header_bytes(index: Int, h: Header, size: Int) -> Bytes / {tar.unwritable, abort.raise} =
  match header_error(h, size) {
    Some(reason) -> unwritable(index, reason),
    None -> {
      let stored = Bytes::of_string(h.path).concat(if h.kind == Directory { b"/" } else { b"" });
      let link = Bytes::of_string(h.link);
      let uname = Bytes::of_string(h.uname);
      let gname = Bytes::of_string(h.gname);
      let nanos = nanos_at(h.modified);
      let seconds = nanos / 1000000000;
      let split = if stored.len() <= 100 { Some(0) } else { prefix_split(stored) };
      let plain_path = ascii(stored) && split != None;
      let plain_link = ascii(link) && link.len() <= 100;
      let plain_uname = ascii(uname) && uname.len() < 32;
      let plain_gname = ascii(gname) && gname.len() < 32;
      let plain_time = nanos % 1000000000 == 0 && seconds >= 0 && seconds <= eleven_digits();
      let pax_records = [
        { keyword: "path", value: stored, written: !plain_path },
        { keyword: "linkpath", value: link, written: !plain_link },
        { keyword: "size", value: ascii_of_int(size), written: size > eleven_digits() },
        { keyword: "uid", value: ascii_of_int(h.uid), written: h.uid > max_octal_field() },
        { keyword: "gid", value: ascii_of_int(h.gid), written: h.gid > max_octal_field() },
        { keyword: "uname", value: uname, written: !plain_uname },
        { keyword: "gname", value: gname, written: !plain_gname },
        { keyword: "mtime", value: instant_text(nanos), written: !plain_time },
      ].fold(
        with_records(Map::new(), h.extended),
        |m: Map<String, Bytes>, r: { keyword: String, value: Bytes, written: Bool }|
          if r.written { m.insert(r.keyword, r.value) } else { m },
      );
      let records = Bytes::concat_all(
        pax_records.fold([], |parts: List<Bytes>, keyword: String, value: Bytes|
          parts.push(record_bytes(keyword, value))),
      );
      let at = match split { Some(i) -> i, None -> 0 };
      let own = header_block({
        name: if !plain_path { shortened(stored, 100) }
        else if at == 0 { stored }
        else { stored.slice(at + 1, stored.len()) },
        mode: h.mode,
        uid: if h.uid > max_octal_field() { 0 } else { h.uid },
        gid: if h.gid > max_octal_field() { 0 } else { h.gid },
        size: if size > eleven_digits() { 0 } else { size },
        seconds: if plain_time { seconds } else { min(max(seconds, 0), eleven_digits()) },
        flag: match flag_of(h.kind) { Some(flag) -> flag, None -> 48 },
        link: if plain_link { link } else { shortened(link, 100) },
        uname: if plain_uname { uname } else { shortened(uname, 31) },
        gname: if plain_gname { gname } else { shortened(gname, 31) },
        major: h.major,
        minor: h.minor,
        prefix: if plain_path && at > 0 { stored.slice(0, at) } else { b"" },
      });
      Bytes::concat_all([
        if pax_records.len() == 0 { b"" } else {
          Bytes::concat_all([
            header_block({
              name: b"PaxHeader",
              mode: 420,
              uid: 0,
              gid: 0,
              size: records.len(),
              seconds: 0,
              flag: 120,
              link: b"",
              uname: b"",
              gname: b"",
              major: 0,
              minor: 0,
              prefix: b"",
            }),
            records,
            b"\x00".repeat(padded(records.len()) - records.len()),
          ])
        },
        own,
      ])
    },
  }

/// The archive of `entries`, in their order. Raises `tar.unwritable` where `encode` returns `Err`,
/// for an entry whose header cannot be written. The same entries give the same bytes.
pub fn write(entries: List<Entry>) -> Bytes / {tar.unwritable, abort.raise} =
  Bytes::concat_all(
    enumerate(entries).map(|e: { index: Int, value: Entry }| member_bytes(e.index, e.value)).push(
      b"\x00".repeat(1024),
    ),
  )

/// The archive of `entries`, or the first entry whose header cannot be written and why.
pub fn encode(entries: List<Entry>) -> Result<Bytes, WriteError> / {abort.raise} =
  try { write(entries) }

/// One step of an extraction. Every path is relative to the root the caller extracts under:
/// segments with `/` between them, none of them empty, `.` or `..`.
pub type Operation =
  /// Makes the directory at the path with the mode. If a directory already exists there, sets its
  /// mode instead. A plan makes a directory before anything inside it.
  | MakeDirectory(String, Int)
  /// Write the file at the path, with the mode and the data, in place of any file there.
  | WriteFile(String, Int, Bytes)
  /// Make a symbolic link at the path to the text.
  | MakeSymlink(String, String)
  /// Make the first path another name for the file at the second.
  | MakeHardLink(String, String)

type PlannedPath = | PlannedDirectory | PlannedFile | PlannedLink | LinkTraversed

type Plan = {
  made: Map<String, PlannedPath>,
  directories: Map<String, Unit>,
  steps: List<Operation>,
}

type EntryPath = { index: Int, path: String }

fn danger<a>(entry: EntryPath, reason: UnsafeReason) -> a / {tar.unsafe} =
  tar.unsafe({ index: entry.index, path: entry.path, reason: reason })

fn joined(segments: List<String>) -> String = String::join(segments, "/")

fn folded(segments: List<String>) -> String = unicode::lowercase(joined(segments))

fn resolve_path(
  entry: EntryPath,
  made: Map<String, PlannedPath>,
  text: String,
  from: List<String>,
  climbing: UnsafeReason,
) -> { at: List<String>, passed: List<List<String>> } / {tar.unsafe} =
  text.split("/").fold(
    { at: from, passed: [] },
    |collect_members: { at: List<String>, passed: List<List<String>> }, segment: String|
      if segment == "" || segment == "." { collect_members } else {
        let through = if collect_members.at.len() == 0 { collect_members.passed } else {
          match made.get(folded(collect_members.at)) {
            Some(PlannedLink) -> danger(entry, ThroughLink),
            Some(PlannedFile) -> danger(entry, BeneathFile),
            _ -> collect_members.passed.push(collect_members.at),
          }
        };
        if segment != ".." { { at: collect_members.at.push(segment), passed: through } }
        else if collect_members.at.len() == 0 { danger(entry, climbing) }
        else { { at: collect_members.at.take(collect_members.at.len() - 1), passed: through } }
      },
  )

fn entry_segments(entry: EntryPath, made: Map<String, PlannedPath>) -> List<String> / {tar.unsafe} =
  if entry.path == "" || entry.path.contains("\0") { danger(entry, NoName) }
  else if entry.path.starts_with("/") { danger(entry, Absolute) }
  else { resolve_path(entry, made, entry.path, [], Escapes).at }

fn with_parents(p: Plan, at: List<String>) -> Plan =
  range(1, at.len()).fold(p, |so_far: Plan, depth: Int| {
    let parent_path = at.take(depth);
    {
      made: so_far.made.insert(folded(parent_path), PlannedDirectory),
      directories: so_far.directories.insert(joined(parent_path), ()),
      steps: if so_far.directories.contains(joined(parent_path)) { so_far.steps }
      else { so_far.steps.push(MakeDirectory(joined(parent_path), 493)) },
    }
  })

fn may_replace(now: Option<PlannedPath>, next: PlannedPath) -> Bool =
  match now {
    None -> true,
    Some(LinkTraversed) -> next != PlannedLink,
    Some(PlannedDirectory) -> next == PlannedDirectory,
    Some(PlannedFile) -> next == PlannedFile,
    Some(PlannedLink) -> false,
  }

fn plan_entry(p: Plan, index: Int, e: Entry) -> Plan / {tar.unsafe} = {
  let h = e.header;
  let entry = { index: index, path: h.path };
  let at = entry_segments(entry, p.made);
  let next = match h.kind {
    Directory -> PlannedDirectory,
    File | HardLink -> PlannedFile,
    Symlink -> PlannedLink,
    _ -> danger(entry, Special),
  };
  if at.len() == 0 { if next == PlannedDirectory { p } else { danger(entry, Replaces) } }
  else if !may_replace(p.made.get(folded(at)), next) {
    danger(entry, if p.made.get(folded(at)) == Some(LinkTraversed) { ThroughLink }
    else { Replaces })
  } else {
    let parent_path = with_parents(p, at);
    let made = parent_path.made.insert(folded(at), next);
    match h.kind {
      Directory ->
        {
          made: made,
          directories: parent_path.directories.insert(joined(at), ()),
          steps: parent_path.steps.push(MakeDirectory(joined(at), h.mode & 0x1FF)),
        },
      File ->
        {
          ..parent_path,
          made: made,
          steps: parent_path.steps.push(WriteFile(joined(at), h.mode & 0x1FF, e.data)),
        },
      HardLink -> {
        let target = if h.link.contains("\0") { danger(entry, NoName) }
        else if h.link.starts_with("/") { danger(entry, LinkEscapes) }
        else { resolve_path(entry, p.made, h.link, [], LinkEscapes).at };
        if p.made.get(folded(target)) != Some(PlannedFile) { danger(entry, LinkMissing) } else {
          {
            ..parent_path,
            made: made,
            steps: parent_path.steps.push(MakeHardLink(joined(at), joined(target))),
          }
        }
      },
      _ -> {
        let target = if h.link == "" || h.link.contains("\0") { danger(entry, NoName) }
        else if h.link.starts_with("/") { danger(entry, LinkEscapes) }
        else { resolve_path(entry, p.made, h.link, at.take(at.len() - 1), LinkEscapes) };
        {
          ..parent_path,
          made: target.passed.fold(made, |m: Map<String, PlannedPath>, through: List<String>|
            if m.contains(folded(through)) { m } else { m.insert(folded(through), LinkTraversed) }),
          steps: parent_path.steps.push(MakeSymlink(joined(at), h.link)),
        }
      },
    }
  }
}

/// The operations that extract `entries`, in order, beneath a root. Raises `tar.unsafe` where
/// `plan` returns `Err`.
pub fn plan_or_raise(entries: List<Entry>) -> List<Operation> / {tar.unsafe} =
  enumerate(entries).fold(
    { made: Map::new(), directories: Map::new(), steps: [] },
    |p: Plan, e: { index: Int, value: Entry }| plan_entry(p, e.index, e.value),
  ).steps

/// The operations that extract `entries`, in order, beneath a root, or the first entry that may
/// not be extracted and why. No operation leaves the root, passes through a link the plan
/// makes, or makes a link that points out of the root.
pub fn plan(entries: List<Entry>) -> Result<List<Operation>, UnsafeEntry> =
  try { plan_or_raise(entries) }

/// The path beneath a root that `path` names, `.` for the root itself: its segments with the empty
/// ones and `.` dropped and each `..` resolved. `Err` for an empty path, one with a NUL, an
/// absolute one, and one that climbs out. This checks a path alone; `plan` checks it against what
/// the entries before it made.
pub fn safe_path(path: String) -> Result<String, UnsafeReason> =
  match try { entry_segments({ index: 0, path: path }, Map::new()) } {
    Ok(at) -> Ok(if at.len() == 0 { "." } else { joined(at) }),
    Err(rejected) -> Err(rejected.reason),
  }

/// What became of one operation of a plan.
pub type OperationOutcome =
  /// It was carried out.
  | Extracted
  /// The operation was skipped and nothing was written, because the file system differs from what
  /// the plan assumed. The reason is `ThroughLink` when a directory above the path is a link or has
  /// a different real path than the plan gave, `Replaces` when the path holds something the
  /// operation may not replace, and `LinkMissing` when a hard link's target is not a file.
  | Barred(UnsafeReason)
  /// The file system failed to do it.
  | Failed(FileError)

/// An operation's path beneath the directory extracted into, and what became of it.
pub type ExtractionResult = new { path: String, outcome: OperationOutcome }

type PendingDirectory = { index: Int, mode: Int, modified: Option<Instant> }

type Extraction = {
  into: String,
  base: Option<String>,
  outcomes: Map<Int, ExtractionResult>,
  links: List<{ index: Int, path: String, target: String }>,
  dirs: Map<String, PendingDirectory>,
}

fn full_path(into: String, path: String) -> String =
  if into == "" { path } else if path == "" { into } else { into ++ "/" ++ path }

fn parent_path(path: String) -> String = {
  let named = path.split("/");
  joined(named.take(named.len() - 1))
}

fn begin_extraction<[l]>(into: String) -> Extraction / {fs.canonical[l]} = {
  let at = joined(path::segments(into));
  { into: at, base: fs.canonical[l](at), outcomes: Map::new(), links: [], dirs: Map::new() }
}

fn check_directory<[l]>(
  x: Extraction,
  dir: String,
) -> Option<OperationOutcome> / {fs.canonical[l]} =
  match x.base {
    None -> Some(Failed(fs::NotFound)),
    Some(base) -> {
      let wanted = if dir == "" { base }
      else if base.ends_with("/") { base ++ dir }
      else { base ++ "/" ++ dir };
      match fs.canonical[l](full_path(x.into, dir)) {
        Some(found) -> if found == wanted { None } else { Some(Barred(ThroughLink)) },
        None -> Some(Failed(fs::NotFound)),
      }
    },
  }

fn record_outcome(
  x: Extraction,
  index: Int,
  path: String,
  outcome: OperationOutcome,
) -> Extraction = {
  let apply_operation: ExtractionResult = { path: path, outcome: outcome };
  { ..x, outcomes: x.outcomes.insert(index, apply_operation) }
}

fn clear_path<[l]>(full: String) -> Option<OperationOutcome> / {fs.stat[l], fs.remove[l]} =
  match fs.stat[l](full) {
    None -> None,
    Some(found) -> if found.kind != fs::File { Some(Barred(Replaces)) }
    else if fs.remove[l](full) { None }
    else { Some(Failed(fs::Other(0, "remove"))) },
  }

fn open_new_file<[l]>(
  x: Extraction,
  path: String,
) -> Result<Int, OperationOutcome> / {fs.canonical[l], fs.stat[l], fs.remove[l], fs.open[l]} = {
  let full = full_path(x.into, path);
  match check_directory[l](x, parent_path(path)) {
    Some(outcome) -> Err(outcome),
    None -> match clear_path[l](full) {
      Some(outcome) -> Err(outcome),
      None -> match fs.open[l](full, fs::ToCreate) {
        Ok(file) -> Ok(file),
        Err(reason) -> Err(Failed(reason)),
      },
    },
  }
}

fn close_new_file<[l]>(opened: Result<Int, OperationOutcome>) -> Unit / {fs.close[l]} =
  match opened {
    Ok(file) -> {
      fs.close[l](file);
      ()
    },
    Err(_) -> (),
  }

fn finish_file<[l]>(
  x: Extraction,
  path: String,
  written: Bool,
  mode: Int,
  modified: Option<Instant>,
) -> OperationOutcome / {fs.remove[l], fs.set_mode[l], fs.set_modified[l]} = {
  let full = full_path(x.into, path);
  if !written {
    fs.remove[l](full);
    Failed(fs::Other(0, "write_chunk"))
  } else if !set_time[l](full, modified) { Failed(fs::Other(0, "set_modified")) }
  else if !fs.set_mode[l](full, fs::mode_of_bits(mode)) { Failed(fs::Other(0, "set_mode")) }
  else { Extracted }
}

fn set_time<[l]>(full: String, modified: Option<Instant>) -> Bool / {fs.set_modified[l]} =
  match modified {
    None -> true,
    Some(at) -> fs.set_modified[l](full, max(nanos_at(at) / 1000000, 0)),
  }

fn make_hard_link<[l]>(
  x: Extraction,
  path: String,
  target: String,
) -> OperationOutcome / {fs.canonical[l], fs.stat[l], fs.remove[l], fs.link[l]} = {
  let full = full_path(x.into, path);
  let to = full_path(x.into, target);
  if path == target { Extracted } else {
    match check_directory[l](x, parent_path(path)) {
      Some(outcome) -> outcome,
      None -> match check_directory[l](x, parent_path(target)) {
        Some(outcome) -> outcome,
        None -> match fs.stat[l](to) {
          None -> Barred(LinkMissing),
          Some(aimed) -> if aimed.kind != fs::File { Barred(LinkMissing) } else {
            match clear_path[l](full) {
              Some(outcome) -> outcome,
              None -> match fs.link[l](full, to) {
                Ok(_) -> Extracted,
                Err(reason) -> Failed(reason),
              },
            }
          },
        },
      },
    }
  }
}

fn make_directory<[l]>(
  x: Extraction,
  index: Int,
  path: String,
  mode: Int,
  modified: Option<Instant>,
) -> Extraction / {fs.canonical[l], fs.stat[l], fs.create_dir[l]} = {
  let full = full_path(x.into, path);
  let outcome = match check_directory[l](x, parent_path(path)) {
    Some(barring) -> barring,
    None -> match fs.stat[l](full) {
      Some(found) -> if found.kind == fs::Dir { Extracted } else { Barred(Replaces) },
      None -> if fs.create_dir[l](full) { Extracted } else { Failed(fs::Other(0, "create_dir")) },
    },
  };
  let after = record_outcome(x, index, path, outcome);
  if outcome != Extracted { after } else {
    { ..after, dirs: after.dirs.insert(path, { index: index, mode: mode, modified: modified }) }
  }
}

fn apply_operation<[l]>(
  x: Extraction,
  index: Int,
  operation: Operation,
  modified: Option<Instant>,
) -> Extraction / {fs.canonical[l], fs.stat[l], fs.create_dir[l], fs.remove[l], fs.open[l], fs.write_chunk[l], fs.close[l], fs.link[l], fs.set_mode[l], fs.set_modified[l]} =
  match operation {
    MakeDirectory(path, mode) -> make_directory[l](x, index, path, mode, modified),
    WriteFile(path, mode, data) ->
      record_outcome(
        x,
        index,
        path,
        bracket(
          || open_new_file[l](x, path),
          |opened: Result<Int, OperationOutcome>| close_new_file[l](opened),
          |opened: Result<Int, OperationOutcome>|
            match opened {
              Err(outcome) -> outcome,
              Ok(file) -> finish_file[l](x, path, fs.write_chunk[l](file, data), mode, modified),
            },
        ),
      ),
    MakeSymlink(path, target) ->
      { ..x, links: x.links.push({ index: index, path: path, target: target }) },
    MakeHardLink(path, target) ->
      record_outcome(x, index, path, make_hard_link[l](x, path, target)),
  }

fn finish_extraction<[l]>(
  x: Extraction,
) -> List<ExtractionResult> / {fs.canonical[l], fs.stat[l], fs.symlink[l], fs.set_mode[l], fs.set_modified[l]} = {
  let linked_up = x.links.fold(
    x,
    |y: Extraction, link: { index: Int, path: String, target: String }| {
      let full = full_path(y.into, link.path);
      let outcome = match check_directory[l](y, parent_path(link.path)) {
        Some(barring) -> barring,
        None -> match fs.stat[l](full) {
          Some(_) -> Barred(Replaces),
          None -> if fs.symlink[l](full, link.target) { Extracted }
          else { Failed(fs::Other(0, "symlink")) },
        },
      };
      record_outcome(y, link.index, link.path, outcome)
    },
  );
  let resolved = linked_up.dirs.entries().reverse().fold(
    linked_up,
    |y: Extraction, dir: { key: String, value: PendingDirectory }| {
      let full = full_path(y.into, dir.key);
      let outcome = match check_directory[l](y, dir.key) {
        Some(barring) -> barring,
        None -> if !set_time[l](full, dir.value.modified) { Failed(fs::Other(0, "set_modified")) }
        else if !fs.set_mode[l](full, fs::mode_of_bits(dir.value.mode)) {
          Failed(fs::Other(0, "set_mode"))
        } else { Extracted },
      };
      if outcome == Extracted { y } else { record_outcome(y, dir.value.index, dir.key, outcome) }
    },
  );
  resolved.outcomes.values()
}

/// Carries out a plan beneath the directory `into` under the root `l`, and returns the outcome of
/// each operation in the plan's order. An empty `into` means the root itself. Each operation checks
/// before it writes. It is blocked with `ThroughLink` if a directory above its path is a link or is
/// reached under a different name than the plan used, and with `Replaces` if something at its path
/// may not be replaced. A blocked or failed operation writes nothing, and the remaining operations
/// still run. A file is created accessible to its owner only, replaces any file already there
/// without writing through it, and has its mode set after it is written. A hard link is made at its
/// place in the plan, because a later file may take its target's name. Symbolic links are made
/// after all other operations, and a directory's mode is set after everything beneath it. A plan
/// contains no times, so everything it makes is dated when it is made.
pub fn extract<[l]>(
  steps: List<Operation>,
  into: String,
) -> List<OperationOutcome> / {fs.canonical[l], fs.stat[l], fs.create_dir[l], fs.remove[l], fs.open[l], fs.write_chunk[l], fs.close[l], fs.link[l], fs.symlink[l], fs.set_mode[l], fs.set_modified[l]} = {
  let done = enumerate(steps).fold(
    begin_extraction[l](into),
    |x: Extraction, s: { index: Int, value: Operation }|
      apply_operation[l](x, s.index, s.value, None),
  );
  finish_extraction[l](done).map(|c: ExtractionResult| c.outcome)
}

type Event = | Began(Header, Int) | Piece(Bytes) | Closed | Finished | Idle

type ReaderState = { seen: Bytes, before: Int, cursor: Cursor, data: Int, pad: Int, open: Bool }

type ReadStep = { reading: ReaderState, event: Event }

fn initial_reader() -> ReaderState =
  { seen: b"", before: 0, cursor: start(), data: 0, pad: 0, open: false }

fn window_size(window: Int) -> Int = max(window, 4096)

fn max_reads(limits: Limits, window: Int) -> Int = {
  let bytes = limits.total +| (limits.entries +| 1) *| (window_size(window) +| 1024) +| 1024;
  bytes *| 3 +| limits.entries +| 16
}

fn read_next<[r] | e>(
  r: ReaderState,
  source: Scoped<Source<| e>, [r]>,
  limits: Limits,
  window: Int,
) -> ReadStep / {scoped.read[r], tar.fail, abort.raise | e} = {
  let most = window_size(window);
  let header_keywords = r.seen.len();
  if r.open && r.data == 0 { { reading: { ..r, open: false }, event: Closed } } else if r.data > 0 {
    if header_keywords == 0 {
      let more = io::read(source, min(most, r.data));
      if more.len() == 0 { fail(r.before, Truncated) }
      else { { reading: { ..r, seen: more }, event: Idle } }
    } else {
      let n = min(header_keywords, r.data);
      {
        reading: {
          ..r,
          seen: r.seen.slice(n, header_keywords),
          before: r.before + n,
          data: r.data - n,
        },
        event: Piece(r.seen.slice(0, n)),
      }
    }
  } else if r.pad > 0 {
    if header_keywords == 0 {
      let more = io::read(source, min(most, r.pad));
      if more.len() == 0 { { reading: { ..r, pad: 0 }, event: Finished } }
      else { { reading: { ..r, seen: more }, event: Idle } }
    } else {
      let n = min(header_keywords, r.pad);
      {
        reading: {
          ..r,
          seen: r.seen.slice(n, header_keywords),
          before: r.before + n,
          pad: r.pad - n,
        },
        event: Idle,
      }
    }
  } else {
    let found: Result<Step, Error> = try[tar.fail] { step(r.seen, { ..r.cursor, at: 0 }, limits) };
    match found {
      Err(rejected) -> fail(r.before + rejected.at, rejected.reason),
      Ok(End) -> { reading: r, event: Finished },
      Ok(NeedMore(n)) -> if n > most { fail(r.before, TooLarge) } else {
        let more = io::read(source, n - header_keywords);
        if more.len() > 0 { { reading: { ..r, seen: r.seen.concat(more) }, event: Idle } }
        else if r.seen.skip(0, b"\x00") >= header_keywords { { reading: r, event: Finished } }
        else { fail(r.before, Truncated) }
      },
      Ok(Next(m)) -> {
        let at = min(m.data, header_keywords);
        {
          reading: {
            seen: r.seen.slice(at, header_keywords),
            before: r.before + at,
            cursor: m.next,
            data: m.size,
            pad: padded(m.size) - m.size,
            open: true,
          },
          event: Began(m.header, m.size),
        }
      },
    }
  }
}

fn empty_plan() -> Plan = { made: Map::new(), directories: Map::new(), steps: [] }

fn plan_member(p: Plan, index: Int, h: Header) -> Plan / {tar.unsafe} =
  plan_entry({ ..p, steps: [] }, index, { header: h, data: b"" })

fn check_archive<[r] | e>(
  source: Scoped<Source<| e>, [r]>,
  limits: Limits,
  window: Int,
) -> Int / {scoped.read[r], tar.fail, tar.unsafe, abort.raise | e} =
  iterate(
    { reading: initial_reader(), plan: empty_plan(), index: 0 },
    max_reads(limits, window),
    |j: { reading: ReaderState, plan: Plan, index: Int }| {
      let next = read_next(j.reading, source, limits, window);
      match next.event {
        Finished -> Stop(j.index),
        Began(h, _) ->
          Continue({
            reading: next.reading,
            plan: plan_member(j.plan, j.index, h),
            index: j.index + 1,
          }),
        _ -> Continue({ ..j, reading: next.reading }),
      }
    },
  )

type UnpackState = {
  reading: ReaderState,
  plan: Plan,
  index: Int,
  operation_count: Int,
  extraction: Extraction,
}

fn write_member_data<[l], [r] | e>(
  r: ReaderState,
  source: Scoped<Source<| e>, [r]>,
  limits: Limits,
  window: Int,
  opened: Result<Int, OperationOutcome>,
) -> { reading: ReaderState, written: Bool } / {scoped.read[r], tar.fail, fs.write_chunk[l], abort.raise | e} =
  iterate(
    { reading: r, written: true },
    r.data *| 2 +| 8,
    |p: { reading: ReaderState, written: Bool }| {
      let next = read_next(p.reading, source, limits, window);
      match next.event {
        Closed -> Stop({ reading: next.reading, written: p.written }),
        Piece(bytes) ->
          Continue({
            reading: next.reading,
            written: p.written
              && (match opened { Ok(file) -> fs.write_chunk[l](file, bytes), Err(_) -> true }),
          }),
        _ -> Continue({ ..p, reading: next.reading }),
      }
    },
  )

fn unpack_member<[l], [r] | e>(
  s: UnpackState,
  r: ReaderState,
  h: Header,
  source: Scoped<Source<| e>, [r]>,
  limits: Limits,
  window: Int,
) -> UnpackState / {scoped.read[r], tar.fail, tar.unsafe, fs.canonical[l], fs.stat[l], fs.create_dir[l], fs.remove[l], fs.open[l], fs.write_chunk[l], fs.close[l], fs.link[l], fs.set_mode[l], fs.set_modified[l], abort.raise | e} = {
  let p = plan_member(s.plan, s.index, h);
  let own = p.steps.len() - 1;
  enumerate(p.steps).fold(
    {
      reading: r,
      plan: p,
      index: s.index + 1,
      operation_count: s.operation_count + p.steps.len(),
      extraction: s.extraction,
    },
    |u: UnpackState, o: { index: Int, value: Operation }| {
      let at = s.operation_count + o.index;
      let modified = if o.index == own { Some(h.modified) } else { None };
      match o.value {
        WriteFile(path, mode, _) ->
          bracket(
            || open_new_file[l](u.extraction, path),
            |opened: Result<Int, OperationOutcome>| close_new_file[l](opened),
            |opened: Result<Int, OperationOutcome>| {
              let poured = write_member_data[l](u.reading, source, limits, window, opened);
              let outcome = match opened {
                Err(barring) -> barring,
                Ok(_) -> finish_file[l](u.extraction, path, poured.written, mode, modified),
              };
              {
                ..u,
                reading: poured.reading,
                extraction: record_outcome(u.extraction, at, path, outcome),
              }
            },
          ),
        other -> { ..u, extraction: apply_operation[l](u.extraction, at, other, modified) },
      }
    },
  )
}

fn unpack_source<[l], [r] | e>(
  source: Scoped<Source<| e>, [r]>,
  into: String,
  limits: Limits,
  window: Int,
) -> List<ExtractionResult> / {scoped.read[r], tar.fail, tar.unsafe, fs.canonical[l], fs.stat[l], fs.create_dir[l], fs.remove[l], fs.open[l], fs.write_chunk[l], fs.close[l], fs.link[l], fs.symlink[l], fs.set_mode[l], fs.set_modified[l], abort.raise | e} =
  iterate(
    {
      reading: initial_reader(),
      plan: empty_plan(),
      index: 0,
      operation_count: 0,
      extraction: begin_extraction[l](into),
    },
    max_reads(limits, window),
    |s: UnpackState| {
      let next = read_next(s.reading, source, limits, window);
      match next.event {
        Finished -> Stop(finish_extraction[l](s.extraction)),
        Began(h, _) -> Continue(unpack_member[l](s, next.reading, h, source, limits, window)),
        _ -> Continue({ ..s, reading: next.reading }),
      }
    },
  )

/// Extracts the archive in the file at `archive` under the root `a` into the directory `into` under
/// the root `l`, and returns the outcome of each operation in order, as `extract` does for a plan.
/// The archive is read twice. The first pass checks every member as `read` and `plan` do, and
/// raises `tar.fail` or `tar.unsafe` for the first member that is invalid or may not be extracted,
/// before anything is written, so such an archive extracts nothing. The second pass carries out
/// each member as it is read: a file's data is written as it arrives, and then the file's mode and
/// the time in its header are set. The time is cut off to the millisecond, and a header time before
/// the epoch is set to the epoch.
///
/// The call buffers at most `window` bytes of the archive at once, and at least 4096. A file of any
/// size passes through in pieces no larger than that, and an archive whose headers before one
/// member are longer than that is rejected as `TooLarge`. Besides the window, the call stores only
/// the names of what it has made.
pub fn unpack<[a], [l]>(
  archive: String,
  into: String,
  limits: Limits,
  window: Int,
) -> List<ExtractionResult> / {fs.open[a], fs.read_chunk[a], fs.close[a], io.fail, io.closed, tar.fail, tar.unsafe, fs.canonical[l], fs.stat[l], fs.create_dir[l], fs.remove[l], fs.open[l], fs.write_chunk[l], fs.close[l], fs.link[l], fs.symlink[l], fs.set_mode[l], fs.set_modified[l], abort.raise} = {
  with_scope[judging](
    io::reading[a](archive),
    io::close_source,
  ) { source -> check_archive(source, limits, window) };
  with_scope[unpacking](
    io::reading[a](archive),
    io::close_source,
  ) { source -> unpack_source[l](source, into, limits, window) }
}

/// How a tree is packed.
pub type PackOptions = new {
  /// Whether each file's and directory's entry records the modification time from its file system.
  /// If false, every entry uses the epoch, so an archive is identical wherever its tree is checked
  /// out. A link's entry always uses the epoch, because no root can set a link's time.
  times: Bool,
  /// Whether each entry records its mode unchanged. If false, a directory and a file its owner may
  /// execute are `rwxr-xr-x`, and any other file is `rw-r--r--`.
  modes: Bool,
  /// The most entries (`TooMany`).
  entries: Int,
  /// The most bytes of files in all (`TooMuch`).
  bytes: Int,
  /// The most bytes of a file read into memory at once.
  chunk: Int,
}

/// Returns pack options with the limits `entries`, `bytes` and `chunk`, that record each entry's
/// mode and no times. The same tree then gives the same archive whenever and wherever it is packed,
/// as long as its modes are the same.
pub fn pack_options(entries: Int, bytes: Int, chunk: Int) -> PackOptions =
  { times: false, modes: true, entries: entries, bytes: bytes, chunk: chunk }

/// What a pack wrote: how many entries, and how many bytes of archive.
pub type PackResult = new { entries: Int, bytes: Int }

fn gather_paths<[l]>(
  top: String,
  paths: List<String>,
) -> Map<String, fs::Stat> / {fs.stat[l], fs.scan[l], files.fail, abort.raise} =
  paths.fold(Map::new(), |found: Map<String, fs::Stat>, path: String| {
    let name = joined(path::segments(path));
    let full = full_path(top, name);
    let skip = if full == "" { 0 } else { full.len() + 1 };
    match fs.stat[l](full) {
      None -> files.fail(full, fs::NotFound),
      Some(own) -> {
        let with_own = if name == "" { found } else { found.insert(name, own) };
        if own.kind != fs::Dir { with_own } else {
          match fs.scan[l](full, true) {
            None -> files.fail(full, fs::NotADirectory),
            Some(seen) ->
              seen.fold(with_own, |m: Map<String, fs::Stat>, s: fs::ScanEntry|
                m.insert(full_path(name, s.path.slice(skip, s.path.len())), s.stat)),
          }
        }
      },
    }
  })

fn header_of<[l]>(
  full: String,
  name: String,
  found: fs::Stat,
  first: Option<String>,
  options: PackOptions,
) -> Header / {fs.read_link[l], files.fail} = {
  let mode = if options.modes { fs::mode_bits(found.mode) }
  else if found.kind == fs::Dir || found.mode.owner.execute { 493 }
  else { 420 };
  let modified = if options.times { found.modified } else { Instant(0) };
  match found.kind {
    fs::Dir -> header(name, Directory, mode, modified, ""),
    fs::Symlink -> match fs.read_link[l](full) {
      Some(target) -> header(name, Symlink, 511, Instant(0), target),
      None -> files.fail(full, fs::NotFound),
    },
    _ -> match first {
      Some(to) -> header(name, HardLink, mode, modified, to),
      None -> header(name, File, mode, modified, ""),
    },
  }
}

fn copy_file_data<[l], [r] | e>(
  full: String,
  size: Int,
  to: Scoped<Sink<| e>, [r]>,
  chunk: Int,
) -> Unit / {fs.open[l], fs.read_chunk[l], fs.close[l], io.fail, io.closed, io.write_failed, files.fail, scoped.read[r], abort.raise | e} =
  with_scope[file](
    io::reading[l](full),
    io::close_source,
  ) { source -> {
    iterate(0, size + 1, |sent: Int|
      if sent >= size { Stop(()) } else {
        let bytes = io::read(source, min(max(chunk, 1), size - sent));
        if bytes.len() == 0 { files.fail(full, fs::Other(0, "changed while it was read")) } else {
          io::write(to, bytes);
          Continue(sent + bytes.len())
        }
      });
    io::write(to, b"\x00".repeat(padded(size) - size))
  } }

type PackState = {
  index: Int,
  bytes: Int,
  data: Int,
  first_names: Map<Int, { device: Int, name: String }>,
}

/// Writes into the sink the archive of what `paths` name beneath the directory `dir` under the root
/// `l`: each path's own entry, and for a directory everything beneath it. An empty path means all
/// of `dir`, with no entry for `dir` itself. Entries are named by their paths beneath `dir`,
/// written in the order of those names whatever order the paths came in, and owned by nobody. A
/// link is an entry and is never followed, and a file's second name is a hard link to its first.
/// With `options`'s `times` and `modes` both off, the bytes written depend only on the names, the
/// kinds, the files' bytes and whether their owners may execute them.
///
/// A file is read through a descriptor a chunk at a time, so a tree of any size is packed in the
/// memory of its names and one chunk. A file the root will not open raises `io.fail`. A path that
/// names nothing, or a file that shrinks while it is read, raises `files.fail`. A tree beyond
/// `options`'s bounds, or a name no header can contain, raises `tar.unwritable`. What was written
/// by then is not a valid archive.
pub fn pack<[l], [r] | e>(
  dir: String,
  paths: List<String>,
  to: Scoped<Sink<| e>, [r]>,
  options: PackOptions,
) -> PackResult / {fs.stat[l], fs.scan[l], fs.read_link[l], fs.open[l], fs.read_chunk[l], fs.close[l], io.fail, io.closed, io.write_failed, files.fail, tar.unwritable, scoped.read[r], abort.raise | e} = {
  let top = joined(path::segments(dir));
  let found = gather_paths[l](top, paths);
  if found.len() > options.entries { unwritable(options.entries, TooMany) } else { () };
  let done = found.fold(
    { index: 0, bytes: 0, data: 0, first_names: Map::new() },
    |p: PackState, name: String, stat: fs::Stat| {
      let full = full_path(top, name);
      let first = if stat.kind != fs::File || stat.links < 2 { None } else {
        match p.first_names.get(stat.id) {
          Some(named) -> if named.device == stat.device { Some(named.name) } else { None },
          None -> None,
        }
      };
      let h = header_of[l](full, name, stat, first, options);
      let size = if h.kind == File { stat.size } else { 0 };
      if size > options.bytes - p.data { unwritable(p.index, TooMuch) } else { () };
      let head = header_bytes(p.index, h, size);
      io::write(to, head);
      if size > 0 { copy_file_data[l](full, size, to, options.chunk) } else { () };
      {
        index: p.index + 1,
        bytes: p.bytes + head.len() + padded(size),
        data: p.data + size,
        first_names: if h.kind != File || stat.links < 2 { p.first_names }
        else { p.first_names.insert(stat.id, { device: stat.device, name: name }) },
      }
    },
  );
  io::write(to, b"\x00".repeat(1024));
  { entries: done.index, bytes: done.bytes + 1024 }
}

fn generous_limits() -> Limits = limits_of(1000, 100000000, 100000000, 4096)

fn limits_of(entries: Int, byte_sum: Int, size: Int, path: Int) -> Limits =
  { entries: entries, total: byte_sum, size: size, path: path }

fn sample_paths() -> List<String> =
  [
    "a",
    "dir/file.txt",
    "caf\u{e9}/\u{6c34}.txt",
    "name with spaces",
    String::join(range(0, 12).map(|_: Int| "0123456789ab"), "/"),
    String::join(range(0, 30).map(|_: Int| "0123456789ab"), "/"),
    String::join(range(0, 11).map(|_: Int| "0123456789"), ""),
    "a/b/c/d",
  ]

fn sample_path(pick: Int) -> String =
  match sample_paths().at(pick & 7) { Some(path) -> path, None -> "a" }

fn generated_entry(pick: Int, data: Bytes) -> Entry = {
  let kind = pick >> 3 & 7;
  let made = if kind == 0 { directory(sample_path(pick)) }
  else if kind == 1 { symlink(sample_path(pick), sample_path(pick >> 12)) }
  else if kind == 2 { hard_link(sample_path(pick), sample_path(pick >> 12)) }
  else { file(sample_path(pick), data) };
  {
    header: {
      ..made.header,
      kind: if kind == 3 { Fifo } else if kind == 4 { CharDevice } else { made.header.kind },
      mode: pick >> 6 & 0xFFF,
      uid: pick >> 18 & 0xFF_FFFF,
      uname: if pick & 0x4000_0000 == 0 { "" } else { sample_path(pick >> 21) },
      modified: Instant(pick >> 24),
      major: if kind == 4 { pick >> 18 & 0xFF } else { 0 },
      extended: if pick & 0x2000_0000 == 0 || data.len() == 0 { [] }
      else { [{ keyword: "comment", value: data }] },
    },
    data: if kind == 3 || kind == 4 { b"" } else { made.data },
  }
}

test "what is written reads back as the entries it was written from" {
  gen::check2(gen::list(gen::any_int()), gen::bytes(), |picks: List<Int>, data: Bytes| {
    let entries = picks.map(|pick: Int| generated_entry(pick, data));
    decode(write(entries), generous_limits()) == Ok(entries)
  })
}

fn segments() -> List<String> =
  ["a", "b", "c", "d", "A", "B", "x", "y", "z", "a", "b", ".", "..", "", "c", "x"]

fn segment(pick: Int) -> String = match segments().at(pick & 15) { Some(name) -> name, None -> "a" }

fn winding(pick: Int) -> String =
  (if pick & 0x3F00 == 0 { "/" } else { "" }) ++ segment(pick) ++ "/" ++ segment(pick >> 4)

fn tricky(pick: Int) -> Entry = {
  let kind = pick >> 14 & 7;
  if kind == 0 { directory(winding(pick)) }
  else if kind == 1 { symlink(winding(pick), winding(pick >> 17)) }
  else if kind == 2 { hard_link(winding(pick), winding(pick >> 17)) }
  else { file(winding(pick), b"") }
}

fn target_of(step: Operation) -> String =
  match step {
    MakeDirectory(path, _) | WriteFile(path, _, _) | MakeSymlink(path, _) | MakeHardLink(path, _) ->
      path,
  }

fn inside(path: String) -> Bool =
  path.split("/").all(|name: String| name != "" && name != "." && name != "..")

fn stays_inside(path: String, text: String) -> Bool =
  !text.starts_with("/")
    && text.split("/").fold(path.split("/").len() - 1, |depth: Int, name: String|
      if depth < 0 || name == "" || name == "." { depth }
      else if name == ".." { depth - 1 }
      else { depth + 1 })
    >= 0

fn beneath(path: String, parent_path: String) -> Bool =
  unicode::lowercase(path).starts_with(unicode::lowercase(parent_path) ++ "/")

test "`plan` only creates paths inside the root, never through a link it creates, and every link it creates points inside the root" {
  gen::check(gen::list(gen::any_int()), |picks: List<Int>| {
    match plan(picks.map(tricky)) {
      Err(_) -> true,
      Ok(steps) ->
        steps.all(|step: Operation|
          inside(target_of(step))
            && (match step {
              MakeSymlink(path, text) -> stays_inside(path, text),
              MakeHardLink(_, file) -> inside(file),
              _ -> true,
            })
            && steps.all(|other: Operation|
              match other { MakeSymlink(link, _) -> !beneath(target_of(step), link), _ -> true })),
    }
  })
}

test "`safe_path` returns an already safe path unchanged, and the result stays inside the root" {
  gen::check(gen::any_int(), |pick: Int| {
    match safe_path(winding(pick) ++ "/" ++ winding(pick >> 20)) {
      Ok(path) -> safe_path(path) == Ok(path) && (path == "." || inside(path)),
      Err(_) -> true,
    }
  })
}

fn altered(header_block: Bytes, at: Int, bytes: Bytes, signed: Bool) -> Bytes / {abort.raise} = {
  let changed = Bytes::concat_all([
    header_block.slice(0, at),
    bytes,
    header_block.slice(at + bytes.len(), header_block.len()),
  ]);
  let unsigned = byte_sum(changed.slice(0, 148)) + 8 * 0x20 + byte_sum(changed.slice(156, 512));
  let high = range(0, 512).filter(|i: Int| (i < 148 || i >= 156) && changed.at(i) >= 0x80).len();
  Bytes::concat_all([
    changed.slice(0, 148),
    octal((if signed { unsigned - 256 * high } else { unsigned }) & 0x3_FFFF, 6),
    b" ",
    changed.slice(156, changed.len()),
  ])
}

fn with_meta_member(flag: Bytes, data: Bytes, e: Entry) -> Bytes / {tar.unwritable, abort.raise} = {
  let over = altered(write([file("PaxHeader", data)]), 156, flag, false);
  over.slice(0, over.len() - 1024).concat(write([e]))
}

fn rejection(archive: Bytes, limits: Limits) -> Option<Error> / {abort.raise} =
  match decode(archive, limits) { Ok(_) -> None, Err(rejected) -> Some(rejected) }

fn second_entry_error(reason: ErrorKind) -> Result<Bytes, WriteError> =
  Err({ index: 1, reason: reason })

fn paths(archive: Bytes) -> List<String> / {tar.fail, abort.raise} =
  members(archive, generous_limits()).map(|m: Member| m.header.path)

test "an archive of one file is its header, its data padded to a 512-byte block, and two blocks of zeros" {
  let archive = write([file("hello.txt", b"hi\n")]);
  assert_eq(archive.len(), 2048);
  assert_eq(archive.slice(0, 10), b"hello.txt\x00");
  assert_eq(
    archive.slice(100, 156),
    b"0000644\x000000000\x000000000\x0000000000003\x0000000000000\x00011042\x00 ",
  );
  assert_eq(archive.slice(156, 157), b"0");
  assert_eq(archive.slice(257, 265), b"ustar\x0000");
  assert_eq(archive.slice(512, 516), b"hi\n\x00");
  assert_eq(archive.slice(515, 2048), b"\x00".repeat(1533));
  assert_eq(read(archive, generous_limits()), [file("hello.txt", b"hi\n")]);
  assert_eq(write([]), b"\x00".repeat(1024));
  assert_eq(read(write([]), generous_limits()), [])
}

test "the entry makers set no owner and the epoch as the time unless told otherwise" {
  let made = file("a", b"x");
  assert_eq(made.header, {
    path: "a",
    kind: File,
    mode: 420,
    uid: 0,
    gid: 0,
    uname: "",
    gname: "",
    modified: Instant(0),
    link: "",
    major: 0,
    minor: 0,
    extended: [],
  });
  assert_eq(file("a", b"x", mode: 493, modified: Instant(5)).header.mode, 493);
  assert_eq(directory("d").header.mode, 493);
  assert_eq(symlink("l", "d").header, {
    ..made.header,
    path: "l",
    kind: Symlink,
    mode: 511,
    link: "d",
  });
  assert_eq(hard_link("h", "a").header, { ..made.header, path: "h", kind: HardLink, link: "a" });
  assert_eq(write([made, directory("d")]), write([file("a", b"x"), directory("d")]))
}

test "a header number field is read as octal padded with spaces or NUL bytes, or as GNU's base-256 binary form" {
  assert_eq(number(b"0000644\x00", 0, 8), Some(420));
  assert_eq(number(b"000644 \x00", 0, 8), Some(420));
  assert_eq(number(b"   644 \x00", 0, 8), Some(420));
  assert_eq(number(b"644\x00\x00\x00\x00\x00", 0, 8), Some(420));
  assert_eq(number(b"77777777", 0, 8), Some(16777215));
  assert_eq(number(b"\x00\x00\x00\x00\x00\x00\x00\x00", 0, 8), Some(0));
  assert_eq(number(b"        ", 0, 8), Some(0));
  assert_eq(number(b"0000648\x00", 0, 8), None);
  assert_eq(number(b"00006x4\x00", 0, 8), None);
  assert_eq(number(b"-000001\x00", 0, 8), None);
  assert_eq(number(b"xx0000644\x00", 2, 8), Some(420));
  assert_eq(number(b"\x80\x00\x00\x00\xb2\xd0\x5e\x00", 0, 8), Some(3000000000));
  assert_eq(number(b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xae\x80", 0, 12), Some(-86400));
  assert_eq(number(b"\xff\xff\xff\xff\xff\xff\xff\xff", 0, 8), Some(-1));
  assert_eq(number(b"\xff\xbf\xff\xff\xff\xff\xff\xff", 0, 8), Some(-18014398509481985));
  assert_eq(number(b"\x80\x40\x00\x00\x00\x00\x00\x00", 0, 8), Some(18014398509481984));
  assert_eq(
    number(b"\x80\x00\x00\x00\x7f\xff\xff\xff\xff\xff\xff\xff", 0, 12),
    Some(9223372036854775807),
  );
  assert_eq(number(b"\x80\x00\x00\x00\x80\x00\x00\x00\x00\x00\x00\x00", 0, 12), None);
  assert_eq(number(b"\x80\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00", 0, 12), None)
}

test "a header's checksum is accepted when computed with signed or with unsigned bytes, and rejected otherwise" {
  let archive = write([file("ab", b"")]);
  let unsigned = altered(archive, 0, b"\xc3\xa9", false);
  let signed = altered(archive, 0, b"\xc3\xa9", true);
  assert(unsigned != signed);
  assert_eq(paths(unsigned), ["\u{e9}"]);
  assert_eq(paths(signed), ["\u{e9}"]);
  let wide = b"\x80\x00\x00\x00\x00\x00\x00\x07";
  assert_eq(
    [true, false].map(|signed: Bool|
      read(altered(archive, 108, wide, signed), generous_limits()).map(|e: Entry| e.header.uid)),
    [[7], [7]],
  );
  let off = Bytes::concat_all([archive.slice(0, 1), b"c", archive.slice(2, archive.len())]);
  assert_eq(rejection(off, generous_limits()), Some({ at: 0, reason: BadChecksum }));
  assert_eq(
    rejection(altered(archive, 0, b"\xff\xfe", false), generous_limits()),
    Some({ at: 0, reason: NotUtf8 }),
  );
  assert_eq(
    rejection(altered(archive, 100, b"00006x4", false), generous_limits()),
    Some({ at: 0, reason: BadNumber }),
  );
  assert_eq(
    rejection(
      altered(archive, 124, b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff", false),
      generous_limits(),
    ),
    Some({ at: 0, reason: BadNumber }),
  )
}

test "an archive cut off in the middle of an entry is rejected as truncated, but an archive missing only its final zero blocks is read in full" {
  let archive = write([file("a", b"0123456789"), file("b", b"")]);
  assert_eq(archive.len(), 2560);
  assert_eq(paths(archive.slice(0, 1536)), ["a", "b"]);
  assert_eq(paths(archive.slice(0, 2048)), ["a", "b"]);
  assert_eq(paths(archive.slice(0, 1700)), ["a", "b"]);
  assert_eq(
    rejection(archive.slice(0, 1500), generous_limits()),
    Some({ at: 1024, reason: Truncated }),
  );
  assert_eq(
    rejection(archive.slice(0, 520), generous_limits()),
    Some({ at: 0, reason: Truncated }),
  );
  assert_eq(
    rejection(archive.slice(0, 100), generous_limits()),
    Some({ at: 0, reason: Truncated }),
  );
  assert_eq(paths(archive.slice(0, 522)), ["a"]);
  let after_end = archive.slice(0, 2048).concat(archive.slice(0, 512));
  assert_eq(rejection(after_end, generous_limits()), Some({ at: 2048, reason: BadEnd }));
  assert_eq(paths(archive.concat(b"anything after the end is not the archive's")), ["a", "b"])
}

test "reading an archive is rejected when it exceeds the given limit on entries, total size, file size or path length" {
  let archive = write([file("one", b"12345"), file("two/long-name", b"123"), directory("d")]);
  assert_eq(rejection(archive, limits_of(3, 8, 5, 13)), None);
  assert_eq(rejection(archive, limits_of(2, 8, 5, 13)), Some({ at: 2048, reason: TooMany }));
  assert_eq(rejection(archive, limits_of(3, 7, 5, 13)), Some({ at: 1024, reason: TooMuch }));
  assert_eq(rejection(archive, limits_of(3, 8, 4, 13)), Some({ at: 0, reason: TooLarge }));
  assert_eq(rejection(archive, limits_of(3, 8, 5, 12)), Some({ at: 1024, reason: TooLong }));
  let make_hard_link = write([symlink("l", "a-long-target")]);
  assert_eq(rejection(make_hard_link, limits_of(1, 0, 0, 13)), None);
  assert_eq(rejection(make_hard_link, limits_of(1, 0, 0, 12)), Some({ at: 0, reason: TooLong }));
  let timed = write([file("t", b"", modified: Instant(1500000000))]);
  assert_eq(rejection(timed, limits_of(1, 13, 13, 1)), None);
  assert_eq(rejection(timed, limits_of(1, 13, 12, 1)), Some({ at: 0, reason: TooLarge }));
  assert_eq(rejection(timed, limits_of(1, 12, 13, 1)), Some({ at: 0, reason: TooMuch }));
  let later = write([file("f", b"12345"), file("t", b"", modified: Instant(1500000000))]);
  assert_eq(rejection(later, limits_of(2, 18, 13, 1)), None);
  assert_eq(rejection(later, limits_of(2, 17, 13, 1)), Some({ at: 1024, reason: TooMuch }))
}

test "`step` returns the next archive entry from the bytes read so far, or how many more bytes it needs" {
  let archive = write([
    file("first", b"0123456789"),
    file("caf\u{e9}", b"abc", modified: Instant(1500000000)),
  ]);
  let stepped = |seen: Int, from: Cursor| step(archive.slice(0, seen), from, generous_limits());
  assert_eq(stepped(0, start()), NeedMore(512));
  assert_eq(stepped(511, start()), NeedMore(512));
  let first = match stepped(512, start()) { Next(m) -> m, _ -> panic("a header is a member") };
  assert_eq((first.header.path, first.data, first.size), ("first", 512, 10));
  assert_eq(first.next, { at: 1024, entries: 1, bytes: 10, global: Map::new() });
  assert_eq(stepped(1024, first.next), NeedMore(1536));
  assert_eq(stepped(1536, first.next), NeedMore(1563));
  assert_eq(stepped(1563, first.next), NeedMore(2560));
  let second_entry_error = match stepped(2560, first.next) {
    Next(m) -> m,
    _ -> panic("a header is a member"),
  };
  assert_eq((second_entry_error.header.path, second_entry_error.header.modified), (
    "caf\u{e9}",
    Instant(1500000000),
  ));
  assert_eq(
    (
      second_entry_error.data,
      second_entry_error.size,
      second_entry_error.next.at,
      second_entry_error.next.bytes,
    ),
    (2560, 3, 3072, 40),
  );
  assert_eq(stepped(3072, second_entry_error.next), NeedMore(3584));
  assert_eq(stepped(3584, second_entry_error.next), NeedMore(4096));
  assert_eq(stepped(4096, second_entry_error.next), End);
  assert_eq(members(archive, generous_limits()).map(|m: Member| m.data), [512, 2560])
}

test "a path too long for a header's name fields is split at a slash, or stored in a pax extended header record" {
  let name = |n: Int| String::of_bytes(b"n".repeat(n));
  let fits = name(100);
  let split = name(155) ++ "/" ++ name(100);
  let past = name(156) ++ "/" ++ name(100);
  let whole = name(101);
  assert_eq([fits, split, past, whole].map(|path: String| write([file(path, b"")]).len()), [
    1536,
    1536,
    2560,
    2560,
  ]);
  let prefix_split = write([file(split, b"")]);
  assert_eq(prefix_split.slice(0, 100), b"n".repeat(100));
  assert_eq(prefix_split.slice(345, 500), b"n".repeat(155));
  let apply_operation = write([file(past, b"")]);
  assert_eq(apply_operation.slice(0, 10), b"PaxHeader\x00");
  assert_eq(apply_operation.slice(156, 157), b"x");
  assert_eq(apply_operation.slice(512, 521), b"267 path=");
  assert_eq(apply_operation.slice(1024, 1124), b"n".repeat(100));
  assert_eq(paths(prefix_split), [split]);
  assert_eq(paths(apply_operation), [past]);
  assert_eq(paths(write([directory(name(99)), directory(name(100)), file("d/" ++ whole, b"")])), [
    name(99),
    name(100),
    "d/" ++ whole,
  ])
}

test "a pax record contains what a ustar header cannot express, and nothing else" {
  let plain = file("a", b"");
  let records = |e: Entry| {
    let archive = write([e]);
    if archive.slice(156, 157) != b"x" { "" }
    else { String::of_bytes(archive.slice(512, 512 + number(archive, 124, 12).expect("a size"))) }
  };
  assert_eq(records(plain), "");
  assert_eq(records(file("caf\u{e9}", b"")), "14 path=caf\u{e9}\n");
  assert_eq(records(symlink("l", "\u{6c34}")), "16 linkpath=\u{6c34}\n");
  assert_eq(
    records({ ..plain, header: { ..plain.header, uid: 2097151, gid: 2097152 } }),
    "15 gid=2097152\n",
  );
  assert_eq(
    records({
      ..plain,
      header: { ..plain.header, uname: "ren\u{e9}e", gname: String::of_bytes(b"g".repeat(32)) },
    }),
    "42 gname=gggggggggggggggggggggggggggggggg\n16 uname=ren\u{e9}e\n",
  );
  assert_eq(records(file("a", b"", modified: Instant(8589934591000000000))), "");
  assert_eq(
    records(file("a", b"", modified: Instant(8589934592000000000))),
    "20 mtime=8589934592\n",
  );
  assert_eq(records(file("a", b"", modified: Instant(1500000000))), "13 mtime=1.5\n");
  assert_eq(records(file("a", b"", modified: Instant(-1))), "22 mtime=-0.000000001\n");
  assert_eq(
    records({
      ..plain,
      header: { ..plain.header, extended: [{ keyword: "comment", value: b"two\nlines" }] },
    }),
    "21 comment=two\nlines\n",
  );
  let full = {
    ..plain,
    header: {
      ..plain.header,
      uid: 3000000000,
      uname: "ren\u{e9}e",
      modified: Instant(-1500000000),
      extended: [
        { keyword: "SCHILY.xattr.user.k", value: b"\x00\x01=\n" },
        { keyword: "atime", value: b"1.25" },
      ],
    },
  };
  assert_eq(read(write([full, plain]), generous_limits()), [full, plain])
}

test "an extended header whose records are malformed is rejected, and a global extended header applies until another replaces it" {
  let read_over = |records: Bytes|
    rejection(with_meta_member(b"x", records, file("a", b"")), generous_limits());
  assert_eq(read_over(b"13 mtime=1.5\n"), None);
  assert_eq(read_over(b"12 mtime=1.5\n"), Some({ at: 0, reason: BadRecord }));
  assert_eq(read_over(b"14 mtime=1.5\n"), Some({ at: 0, reason: BadRecord }));
  assert_eq(read_over(b"13 mtime=1.5 "), Some({ at: 0, reason: BadRecord }));
  assert_eq(read_over(b"mtime=1.5\n"), Some({ at: 0, reason: BadRecord }));
  assert_eq(read_over(b"9 mtime1\n"), Some({ at: 0, reason: BadRecord }));
  assert_eq(read_over(b"5 =1\n"), Some({ at: 0, reason: BadRecord }));
  assert_eq(read_over(b"13 mtime=1.5\n99 x=y\n"), Some({ at: 0, reason: BadRecord }));
  assert_eq(read_over(b"13 mtime=1.x\n"), Some({ at: 1024, reason: BadRecord }));
  assert_eq(read_over(b"12 mtime=.5\n"), Some({ at: 1024, reason: BadRecord }));
  assert_eq(read_over(b"9 size=0\n"), None);
  assert_eq(
    read(with_meta_member(b"x", b"20 mtime=8589934592\n", file("a", b"")), generous_limits()).map(
      |e: Entry| e.header.modified,
    ),
    [Instant(8589934592000000000)],
  );
  assert_eq(read_over(b"12 mtime=1.\n"), Some({ at: 1024, reason: BadRecord }));
  assert_eq(read_over(b"12 mtime=x1\n"), Some({ at: 1024, reason: BadRecord }));
  assert_eq(read_over(b"11 size=-1\n"), Some({ at: 1024, reason: BadRecord }));
  assert_eq(read_over(b"9 uid=1x\n"), Some({ at: 1024, reason: BadRecord }));
  assert_eq(read_over(b"13 path=\xff\xfe/a\n"), Some({ at: 1024, reason: NotUtf8 }));
  let global = with_meta_member(
    b"g",
    b"18 uname=everyone\n16 comment=kept\n",
    file("a", b""),
  ).slice(
    0,
    1536,
  ).concat(
    with_meta_member(b"x", b"15 uname=local\n12 comment=\n", file("b", b"")),
  );
  let all = global.slice(0, global.len() - 1024).concat(write([file("c", b"")]));
  assert_eq(
    read(all, generous_limits()).map(|e: Entry| (e.header.path, e.header.uname, e.header.extended)),
    [
      ("a", "everyone", [{ keyword: "comment", value: b"kept" }]),
      ("b", "local", []),
      ("c", "everyone", [{ keyword: "comment", value: b"kept" }]),
    ],
  )
}

test "a GNU sparse entry is read with its stored data and no hole filling, and the entries after it are still read correctly" {
  let stored = file("holes", b"data");
  let old = write([stored, file("after", b"")]);
  let gnu = altered(
    altered(altered(old, 257, b"ustar  \x00", false), 156, b"S", false),
    482,
    b"\x01",
    false,
  );
  let continued = Bytes::concat_all([
    gnu.slice(0, 512),
    b"\x00".repeat(504).concat(b"\x01\x00\x00\x00\x00\x00\x00\x00"),
    b"\x00".repeat(512),
    gnu.slice(512, gnu.len()),
  ]);
  assert_eq(
    read(continued, generous_limits()).map(|e: Entry| (e.header.kind, e.header.path, e.data)),
    [(Sparse, "holes", b"data"), (File, "after", b"")],
  );
  assert_eq(step(continued.slice(0, 1024), start(), generous_limits()), NeedMore(1536));
  assert_eq(
    match step(continued.slice(0, 1536), start(), generous_limits()) {
      Next(m) -> (m.data, m.size),
      _ -> (0, 0),
    },
    (1536, 4),
  );
  assert_eq(
    read(altered(gnu, 482, b"\x00", false), generous_limits()).map(|e: Entry|
      (e.header.kind, e.data)),
    [(Sparse, b"data"), (File, b"")],
  );
  let pax = read(
    write([
      {
        ..stored,
        header: {
          ..stored.header,
          extended: [{ keyword: "LIBARCHIVE.creationtime", value: b"1" }],
        },
      },
    ]),
    generous_limits(),
  );
  assert_eq(pax.map(|e: Entry| e.header.kind), [File]);
  let marked = Bytes::concat_all([
    altered(write([file("PaxHeader", b"22 GNU.sparse.major=1\n")]), 156, b"x", false).slice(
      0,
      1024,
    ),
    write([stored]),
  ]);
  assert_eq(read(marked, generous_limits()).map(|e: Entry| (e.header.kind, e.header.extended)), [
    (Sparse, [{ keyword: "GNU.sparse.major", value: b"1" }]),
  ]);
  assert_eq(
    plan(read(marked, generous_limits())),
    Err({ index: 0, path: "holes", reason: Special }),
  )
}

test "an entry whose header cannot be written is reported with its index and the reason" {
  let plain = file("a", b"");
  let with_header = |h: Header| encode([plain, { header: h, data: b"" }]);
  assert_eq(["", "a/", "a\0b"].map(|path: String| with_header({ ..plain.header, path: path })), [
    second_entry_error(BadName),
    second_entry_error(BadName),
    second_entry_error(BadName),
  ]);
  assert_eq(with_header({ ..plain.header, link: "a\0" }), second_entry_error(BadName));
  assert_eq(with_header({ ..plain.header, gname: "a\0" }), second_entry_error(BadName));
  assert_eq(with_header({ ..plain.header, kind: Sparse }), second_entry_error(BadKind));
  assert_eq(
    [0, 48, 53, 75, 76, 83, 103, 120, 256].map(|flag: Int|
      with_header({ ..plain.header, kind: Other(flag) })),
    [
      second_entry_error(BadKind),
      second_entry_error(BadKind),
      second_entry_error(BadKind),
      second_entry_error(BadKind),
      second_entry_error(BadKind),
      second_entry_error(BadKind),
      second_entry_error(BadKind),
      second_entry_error(BadKind),
      second_entry_error(BadKind),
    ],
  );
  assert_eq(
    [1, 47, 56, 255].map(|flag: Int|
      encode([{ ..plain, header: { ..plain.header, kind: Other(flag) } }]).is_ok()),
    [true, true, true, true],
  );
  assert_eq(with_header({ ..plain.header, kind: Other(55) }), second_entry_error(BadKind));
  assert_eq(
    encode([{ header: directory("d").header, data: b"x" }]),
    Err({ index: 0, reason: StrayData }),
  );
  assert_eq(with_header({ ..plain.header, mode: 4096 }), second_entry_error(BadNumber));
  assert_eq(with_header({ ..plain.header, mode: -1 }), second_entry_error(BadNumber));
  assert_eq(with_header({ ..plain.header, uid: -1 }), second_entry_error(BadNumber));
  assert_eq(with_header({ ..plain.header, major: 1 }), second_entry_error(BadNumber));
  assert_eq(
    with_header({ ..plain.header, kind: BlockDevice, major: 2097152 }),
    second_entry_error(BadNumber),
  );
  assert_eq(
    with_header({ ..plain.header, modified: Instant(-9223372036854775807 - 1) }),
    second_entry_error(BadNumber),
  );
  let with_record = |keyword: String, value: Bytes|
    with_header({ ..plain.header, extended: [{ keyword: keyword, value: value }] });
  assert_eq(with_record("", b"x"), second_entry_error(BadRecord));
  assert_eq(with_record("a=b", b"x"), second_entry_error(BadRecord));
  assert_eq(with_record("comment", b""), second_entry_error(BadRecord));
  assert_eq(with_record("path", b"x"), second_entry_error(BadRecord));
  assert_eq(with_record("GNU.sparse.major", b"1"), second_entry_error(BadRecord));
  let kinds = [
    { ..plain, header: { ..plain.header, kind: Other(86), mode: 0 } },
    { header: { ..plain.header, kind: Other(77) }, data: b"more" },
    { header: { ..plain.header, kind: CharDevice, major: 3, minor: 2, mode: 438 }, data: b"" },
    {
      header: { ..plain.header, kind: BlockDevice, major: 2097151, minor: 2097151, mode: 3565 },
      data: b"",
    },
    { header: { ..plain.header, kind: Fifo }, data: b"" },
  ];
  assert_eq(decode(write(kinds), generous_limits()), Ok(kinds))
}

fn unsafe_at(
  index: Int,
  path: String,
  reason: UnsafeReason,
) -> Result<List<Operation>, UnsafeEntry> = Err({ index: index, path: path, reason: reason })

test "a plan creates each directory before the paths inside it, and strips setuid, setgid and sticky bits from modes" {
  let entries = [
    file("a/b/one.txt", b"1", mode: 2541),
    directory("a", mode: 448),
    directory("c/d"),
    symlink("a/b/link", "one.txt"),
    hard_link("c/again", "a/b/one.txt"),
    file("a/b/one.txt", b"2"),
    directory("."),
    file("./e//f", b""),
    file("a/../g", b""),
    file("c/d/../h", b""),
  ];
  assert_eq(
    plan(entries),
    Ok([
      MakeDirectory("a", 493),
      MakeDirectory("a/b", 493),
      WriteFile("a/b/one.txt", 493, b"1"),
      MakeDirectory("a", 448),
      MakeDirectory("c", 493),
      MakeDirectory("c/d", 493),
      MakeSymlink("a/b/link", "one.txt"),
      MakeHardLink("c/again", "a/b/one.txt"),
      WriteFile("a/b/one.txt", 420, b"2"),
      MakeDirectory("e", 493),
      WriteFile("e/f", 420, b""),
      WriteFile("g", 420, b""),
      WriteFile("c/h", 420, b""),
    ]),
  );
  assert_eq(plan([]), Ok([]))
}

test "a plan rejects a path that leaves the root, either because it is absolute or because `..` segments climb out of it" {
  let after = |path: String| plan([file("ok", b""), file(path, b"")]);
  assert_eq(after(""), unsafe_at(1, "", NoName));
  assert_eq(after("a\0b"), unsafe_at(1, "a\0b", NoName));
  assert_eq(after("/etc/passwd"), unsafe_at(1, "/etc/passwd", Absolute));
  assert_eq(after("../x"), unsafe_at(1, "../x", Escapes));
  assert_eq(after("a/../../x"), unsafe_at(1, "a/../../x", Escapes));
  assert_eq(after("a/b/../../../x"), unsafe_at(1, "a/b/../../../x", Escapes));
  assert_eq(after(".."), unsafe_at(1, "..", Escapes));
  assert_eq(after("a/.."), unsafe_at(1, "a/..", Replaces));
  assert_eq(after("ok/x"), unsafe_at(1, "ok/x", BeneathFile));
  assert_eq(after("OK/x"), unsafe_at(1, "OK/x", BeneathFile));
  assert_eq(after("a/../x"), Ok([WriteFile("ok", 420, b""), WriteFile("x", 420, b"")]))
}

test "a plan rejects a path through a link the archive created, and an entry that would replace an entry of another kind" {
  assert_eq(
    plan([symlink("way", "elsewhere"), file("way/planted", b"")]),
    unsafe_at(1, "way/planted", ThroughLink),
  );
  assert_eq(
    plan([symlink("Way", "elsewhere"), file("way/planted", b"")]),
    unsafe_at(1, "way/planted", ThroughLink),
  );
  assert_eq(
    plan([symlink("Été", "elsewhere"), file("été/planted", b"")]),
    unsafe_at(1, "été/planted", ThroughLink),
  );
  assert_eq(
    plan([symlink("way", "elsewhere"), file("way/../x", b"")]),
    unsafe_at(1, "way/../x", ThroughLink),
  );
  assert_eq(
    plan([directory("d"), file("d/f", b""), symlink("d", "elsewhere"), file("d/g", b"")]),
    unsafe_at(2, "d", Replaces),
  );
  assert_eq(plan([directory("d"), symlink("D", "x")]), unsafe_at(1, "D", Replaces));
  assert_eq(plan([file("f", b""), symlink("f", "x")]), unsafe_at(1, "f", Replaces));
  assert_eq(plan([symlink("l", "x"), file("l", b"")]), unsafe_at(1, "l", Replaces));
  assert_eq(plan([symlink("l", "x"), symlink("l", "y")]), unsafe_at(1, "l", Replaces));
  assert_eq(plan([file("f", b""), directory("f")]), unsafe_at(1, "f", Replaces));
  assert_eq(plan([directory("d"), file("d", b"")]), unsafe_at(1, "d", Replaces));
  assert_eq(
    plan([file("f", b""), file("x", b""), file("f/..", b"")]),
    unsafe_at(2, "f/..", BeneathFile),
  );
  assert_eq(
    plan([file("Readme", b"1"), file("README", b"2"), directory("Docs"), directory("docs")]),
    Ok([
      WriteFile("Readme", 420, b"1"),
      WriteFile("README", 420, b"2"),
      MakeDirectory("Docs", 493),
      MakeDirectory("docs", 493),
    ]),
  );
  assert_eq(
    plan([file("Docs/a", b""), file("docs/b", b"")]),
    Ok([
      MakeDirectory("Docs", 493),
      WriteFile("Docs/a", 420, b""),
      MakeDirectory("docs", 493),
      WriteFile("docs/b", 420, b""),
    ]),
  )
}

test "a plan makes no link that points out of the root or through another link" {
  let link = |path: String, target: String| plan([directory("d"), symlink(path, target)]);
  assert_eq(link("l", "/etc"), unsafe_at(1, "l", LinkEscapes));
  assert_eq(link("l", ".."), unsafe_at(1, "l", LinkEscapes));
  assert_eq(link("d/l", "../.."), unsafe_at(1, "d/l", LinkEscapes));
  assert_eq(link("d/l", "x/../../../y"), unsafe_at(1, "d/l", LinkEscapes));
  assert_eq(link("l", ""), unsafe_at(1, "l", NoName));
  assert_eq(link("l", "a\0"), unsafe_at(1, "l", NoName));
  assert_eq(link("d/l", ".."), Ok([MakeDirectory("d", 493), MakeSymlink("d/l", "..")]));
  assert_eq(
    link("d/l", "../d/../x"),
    Ok([MakeDirectory("d", 493), MakeSymlink("d/l", "../d/../x")]),
  );
  assert_eq(plan([symlink("a", "d"), symlink("b", "a/..")]), unsafe_at(1, "b", ThroughLink));
  assert_eq(plan([symlink("b", "a/.."), symlink("a", ".")]), unsafe_at(1, "a", ThroughLink));
  assert_eq(plan([symlink("b", "a/.."), symlink("A", ".")]), unsafe_at(1, "A", ThroughLink));
  assert_eq(
    plan([symlink("b", "a/x"), directory("a"), file("a/x", b"")]),
    Ok([MakeSymlink("b", "a/x"), MakeDirectory("a", 493), WriteFile("a/x", 420, b"")]),
  );
  assert_eq(
    plan([symlink("b", "a/x"), file("a/x", b"")]),
    Ok([MakeSymlink("b", "a/x"), MakeDirectory("a", 493), WriteFile("a/x", 420, b"")]),
  );
  assert_eq(
    plan([symlink("a", "b"), symlink("b", "c"), file("c", b"")]),
    Ok([MakeSymlink("a", "b"), MakeSymlink("b", "c"), WriteFile("c", 420, b"")]),
  )
}

test "a hard link is to a file the archive made before it" {
  assert_eq(
    plan([file("f", b""), hard_link("h", "f")]),
    Ok([WriteFile("f", 420, b""), MakeHardLink("h", "f")]),
  );
  assert_eq(plan([hard_link("h", "f"), file("f", b"")]), unsafe_at(0, "h", LinkMissing));
  assert_eq(plan([directory("d"), hard_link("h", "d")]), unsafe_at(1, "h", LinkMissing));
  assert_eq(plan([symlink("s", "f"), hard_link("h", "s")]), unsafe_at(1, "h", LinkMissing));
  assert_eq(plan([file("f", b""), hard_link("h", "")]), unsafe_at(1, "h", LinkMissing));
  assert_eq(plan([file("f", b""), hard_link("h", "/f")]), unsafe_at(1, "h", LinkEscapes));
  assert_eq(plan([file("f", b""), hard_link("h", "../f")]), unsafe_at(1, "h", LinkEscapes));
  assert_eq(plan([file("f", b""), hard_link("h", "f\0")]), unsafe_at(1, "h", NoName));
  assert_eq(
    plan([symlink("s", "d"), file("d/f", b""), hard_link("h", "s/f")]),
    unsafe_at(2, "h", ThroughLink),
  );
  assert_eq(
    plan([file("d/f", b""), hard_link("h", "d/../d/./f"), hard_link("i", "h"), file("h", b"x")]),
    Ok([
      MakeDirectory("d", 493),
      WriteFile("d/f", 420, b""),
      MakeHardLink("h", "d/f"),
      MakeHardLink("i", "h"),
      WriteFile("h", 420, b"x"),
    ]),
  )
}

test "a plan rejects character devices, block devices, FIFOs, sparse entries and entries of unknown kinds" {
  let plain = file("node", b"");
  assert_eq(
    [CharDevice, BlockDevice, Fifo, Sparse, Other(86)].map(|kind: Kind|
      plan([plain, { ..plain, header: { ..plain.header, kind: kind } }])),
    range(0, 5).map(|_: Int| unsafe_at(1, "node", Special)),
  )
}

test "`safe_path` normalizes a valid path, and rejects an empty, absolute or escaping path" {
  assert_eq(["a/b", "./a//b/", "a/b/../c", "a/../b", ".", "a/..", "a/./.."].map(safe_path), [
    Ok("a/b"),
    Ok("a/b"),
    Ok("a/c"),
    Ok("b"),
    Ok("."),
    Ok("."),
    Ok("."),
  ]);
  assert_eq(["", "a\0", "/", "/a", "..", "a/../..", "a/b/../../.."].map(safe_path), [
    Err(NoName),
    Err(NoName),
    Err(Absolute),
    Err(Absolute),
    Err(Escapes),
    Err(Escapes),
    Err(Escapes),
  ])
}

test "`read` returns the entries `write` wrote: files, directories, links, owners and times, with one 512-byte header each" {
  let owned = file("d/f", b"x", modified: Instant(1704164645000000000));
  let entries = [
    directory("d", modified: Instant(8589934591000000000)),
    {
      ..owned,
      header: { ..owned.header, uid: 2097151, gid: 2097150, uname: "ply", gname: "staff" },
    },
    symlink("d/l", String::of_bytes(b"t".repeat(100))),
    hard_link("d/h", "d/f"),
  ];
  let archive = write(entries);
  assert_eq(archive.len(), 5 * 512 + 1024);
  assert_eq(read(archive, generous_limits()), entries)
}

test "a header's fields are read at their positions, however a writer padded them" {
  let archive = write([file("ab", b"abc")]);
  let padded_left = [
    { at: 100, field: b"644\x00\x00\x00\x00\x00" },
    { at: 108, field: b"7\x00\x00\x00\x00\x00\x00\x00" },
    { at: 116, field: b"5 \x00\x00\x00\x00\x00\x00" },
    { at: 124, field: b"3\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00" },
    { at: 136, field: b"13 \x00\x00\x00\x00\x00\x00\x00\x00\x00" },
    { at: 329, field: b"no digit" },
  ].fold(archive, |so_far: Bytes, change: { at: Int, field: Bytes }|
    altered(so_far, change.at, change.field, false));
  let made = file("ab", b"abc", modified: Instant(11000000000));
  assert_eq(read(padded_left, generous_limits()), [
    { ..made, header: { ..made.header, uid: 7, gid: 5 } },
  ]);
  assert_eq(
    [b"\x00", b"0", b"7"].map(|flag: Bytes|
      read(altered(archive, 156, flag, false), generous_limits()).map(|e: Entry|
        (e.header.kind, e.data))),
    [[(File, b"abc")], [(File, b"abc")], [(File, b"abc")]],
  );
  assert_eq(read(altered(archive, 257, b"ustar  \x00", false), generous_limits()), [
    file("ab", b"abc"),
  ]);
  let folder = write([directory("ab")]);
  assert_eq(paths(folder), ["ab"]);
  assert_eq(paths(altered(folder, 0, b"a//", false)), ["a"]);
  assert_eq(paths(altered(folder, 0, b"/\x00\x00", false)), ["/"])
}

test "a long-name or long-link block replaces the name or link target of the entry that follows it" {
  let named = with_meta_member(b"L", b"a/long/name\x00", file("short", b"x"));
  assert_eq(read(named, generous_limits()), [file("a/long/name", b"x")]);
  let make_hard_link = with_meta_member(b"K", b"a/long/target\x00", symlink("l", "t"));
  assert_eq(read(make_hard_link, generous_limits()), [symlink("l", "a/long/target")]);
  let both = named.slice(0, 1024).concat(make_hard_link);
  assert_eq(read(both, generous_limits()), [symlink("a/long/name", "a/long/target")]);
  assert_eq(rejection(both, limits_of(1, 26, 14, 13)), None);
  assert_eq(rejection(both, limits_of(1, 26, 14, 12)), Some({ at: 2048, reason: TooLong }));
  assert_eq(rejection(both, limits_of(1, 26, 13, 13)), Some({ at: 1024, reason: TooLarge }));
  assert_eq(rejection(both, limits_of(1, 25, 14, 13)), Some({ at: 1024, reason: TooMuch }))
}

fn sample_file_system() -> fs::MemFs / {abort.raise} = {
  let files = fs::mem_of([
    { path: "src/a.txt", body: b"alpha" },
    { path: "src/sub/b.sh", body: b"#!/bin/sh\n" },
  ]);
  let moded = fs::mem_set_mode(
    fs::mem_set_mode(
      fs::mem_create_dir(files, "src/empty").fs,
      "src/sub/b.sh",
      fs::mode_of_bits(488),
    ).fs,
    "src/empty",
    fs::mode_of_bits(448),
  ).fs;
  let set_time = fs::mem_set_modified(
    fs::mem_set_modified(moded, "src/a.txt", 5000).fs,
    "src/empty",
    9001,
  ).fs;
  fs::mem_link(
    fs::mem_symlink(set_time, "src/l", "sub/b.sh").fs,
    "src/sub/twin.txt",
    "src/a.txt",
  ).fs
}

fn describe_tree(tree: fs::MemFs, dir: String, timed: Bool) -> List<String> / {abort.raise} =
  match fs::mem_scan(tree, dir, true) {
    None -> ["no " ++ dir],
    Some(seen) ->
      seen.map(|s: fs::ScanEntry| {
        let what = match s.stat.kind {
          fs::File ->
            "file " ++ String::of_bytes_lossy(fs::mem_read(tree, s.path).expect("a file's bytes")),
          fs::Dir -> "dir",
          fs::Symlink -> "link to " ++ fs::mem_read_link(tree, s.path).expect("a link's target"),
          fs::Missing -> "nothing",
        };
        s.path.slice(dir.len() + 1, s.path.len()) ++ ": " ++ what ++ ", mode "
          ++ fs::mode_bits(s.stat.mode).to_string()
          ++ ", x"
          ++ s.stat.links.to_string()
          ++ (if !timed || s.stat.kind == fs::Symlink { "" }
          else { ", at " ++ Int::to_string(nanos_at(s.stat.modified) / 1000000) })
      }),
  }

fn keep_all_options(chunk: Int) -> PackOptions =
  { times: true, modes: true, entries: 100, bytes: 100000, chunk: chunk }

fn plain_options() -> PackOptions =
  { times: false, modes: false, entries: 100, bytes: 100000, chunk: 64 }

fn packed_to_file(
  paths: List<String>,
  options: PackOptions,
) -> PackResult / {fs.read[d], fs.write[d], io.fail, io.closed, io.write_failed, files.fail, tar.unwritable, abort.raise} =
  with_scope[out](
    io::writing[d]("a.tar"),
    io::close_sink,
  ) { sink -> pack[d]("src", paths, sink, options) }

fn path_outcomes(apply_operation: List<ExtractionResult>) -> List<(String, OperationOutcome)> =
  apply_operation.map(|c: ExtractionResult| (c.path, c.outcome))

test "a directory tree packed into a tar file and unpacked again equals the original, including modes, times and links: {c}" for c: { chunk: Int, window: Int, short: Int } in [
    { chunk: 64, window: 8192, short: 0 },
    { chunk: 3, window: 4096, short: 0 },
    { chunk: 64, window: 4096, short: 7 },
    { chunk: 1, window: 0, short: 1 },
  ] {
  let over = fs::on_mem[d](fs::mem_short_reads(sample_file_system(), c.short), || {
    let packed = packed_to_file([""], keep_all_options(c.chunk));
    let made = fs.create_dir[d]("out");
    let apply_operation = unpack[d, d]("a.tar", "out", generous_limits(), c.window);
    { packed: packed, made: made, carried: apply_operation, size: fs.file_size[d]("a.tar") }
  });
  assert_eq(over.value.size, Some(over.value.packed.bytes));
  assert_eq(over.value.packed.entries, 6);
  assert_eq(path_outcomes(over.value.carried), [
    ("a.txt", Extracted),
    ("empty", Extracted),
    ("l", Extracted),
    ("sub", Extracted),
    ("sub/b.sh", Extracted),
    ("sub/twin.txt", Extracted),
  ]);
  assert_eq(
    describe_tree(over.tree, "out", true),
    describe_tree(sample_file_system(), "src", true),
  );
  assert_eq(describe_tree(over.tree, "out", true), [
    "a.txt: file alpha, mode 420, x2, at 5000",
    "empty: dir, mode 448, x1, at 9001",
    "l: link to sub/b.sh, mode 511, x1",
    "sub: dir, mode 493, x1, at 3",
    "sub/b.sh: file #!/bin/sh\n, mode 488, x1, at 4",
    "sub/twin.txt: file alpha, mode 420, x2, at 5000",
  ]);
  assert_eq(over.tree.opened.len(), 0)
}

test "packing without times and modes produces the same archive as `write` of the same entries, for any path order or file time" {
  let archived = |tree: fs::MemFs, paths: List<String>, options: PackOptions|
    fs::mem_read(fs::on_mem[d](tree, || packed_to_file(paths, options)).tree, "a.tar");
  let archive = |tree: fs::MemFs, paths: List<String>| archived(tree, paths, plain_options());
  let moved = fs::mem_set_modified(sample_file_system(), "src/a.txt", 123456).fs;
  let whole = write([
    file("a.txt", b"alpha"),
    directory("empty"),
    symlink("l", "sub/b.sh"),
    directory("sub"),
    file("sub/b.sh", b"#!/bin/sh\n", mode: 493),
    hard_link("sub/twin.txt", "a.txt"),
  ]);
  assert_eq(archive(sample_file_system(), [""]), Some(whole));
  assert_eq(archive(moved, ["./"]), Some(whole));
  assert_eq(
    archive(sample_file_system(), ["sub/twin.txt", "l", "sub", "empty", "a.txt", "sub/b.sh"]),
    Some(whole),
  );
  assert_eq(
    archive(sample_file_system(), ["sub/twin.txt", "l"]),
    Some(write([symlink("l", "sub/b.sh"), file("sub/twin.txt", b"alpha")])),
  );
  assert_eq(
    archived(moved, [""], pack_options(100, 100000, 64)),
    Some(
      write([
        file("a.txt", b"alpha"),
        directory("empty", mode: 448),
        symlink("l", "sub/b.sh"),
        directory("sub"),
        file("sub/b.sh", b"#!/bin/sh\n", mode: 488),
        hard_link("sub/twin.txt", "a.txt"),
      ]),
    ),
  )
}

fn pack_rejected(
  paths: List<String>,
  options: PackOptions,
) -> String / {io.fail, io.closed, io.write_failed, abort.raise} =
  fs::on_mem[d](sample_file_system(), || {
    let unwritten: Result<String, WriteError> = try[tar.unwritable] {
      let missing: Result<PackResult, (String, FileError)> = try[files.fail] {
        packed_to_file(paths, options)
      };
      match missing {
        Ok(_) -> "packed",
        Err((path, reason)) ->
          path ++ (if reason == fs::NotFound { " is not there" } else { " was rejected" }),
      }
    };
    match unwritten {
      Ok(pax_records) -> pax_records,
      Err(e) ->
        (if e.reason == TooMany { "too many at " }
          else if e.reason == TooMuch { "too much at " }
          else { "unwritable at " })
          ++ e.index.to_string(),
    }
  }).value

test "packing fails when it exceeds the entry or byte limit, and reports a requested path that does not exist" {
  let bounded = |entries: Int, bytes: Int| -> PackOptions {
    { ..plain_options(), entries: entries, bytes: bytes }
  };
  assert_eq(pack_rejected([""], bounded(6, 15)), "packed");
  assert_eq(pack_rejected([""], bounded(5, 15)), "too many at 5");
  assert_eq(pack_rejected([""], bounded(6, 14)), "too much at 4");
  assert_eq(pack_rejected(["a.txt", "absent"], bounded(6, 15)), "src/absent is not there")
}

fn planned_steps(entries: List<Entry>) -> List<Operation> / {abort.raise} =
  match plan(entries) {
    Ok(steps) -> steps,
    Err(_) -> panic("planning failed for entries that the test expects to be safe to extract"),
  }

test "extracting entries into a directory creates links last and sets a directory's mode after its contents" {
  let steps = planned_steps([
    symlink("l", "d/f.txt"),
    directory("d", mode: 320),
    file("d/f.txt", b"first", mode: 384),
    hard_link("d/again", "d/f.txt"),
    file("d/f.txt", b"second", mode: 384),
    file("top", b"t"),
  ]);
  let over = fs::on_mem[d](fs::mem_of([{ path: "out/top", body: b"old" }]), ||
    extract[d](steps, "./out/"));
  assert_eq(over.value, [Extracted, Extracted, Extracted, Extracted, Extracted, Extracted]);
  assert_eq(describe_tree(over.tree, "out", false), [
    "d: dir, mode 320, x1",
    "d/again: file first, mode 384, x1",
    "d/f.txt: file second, mode 384, x1",
    "l: link to d/f.txt, mode 511, x1",
    "top: file t, mode 420, x1",
  ]);
  assert_eq(fs::mem_write(over.tree, "out/d/new", b"x").ok, false)
}

test "extraction writes nothing when a parent directory is a symlink or the path would replace an existing file, directory or link" {
  let files = fs::mem_of([
    { path: "elsewhere/secret", body: b"kept" },
    { path: "out/held/deep", body: b"d" },
    { path: "out/top", body: b"t" },
  ]);
  let tree = fs::mem_symlink(
    fs::mem_symlink(files, "out/sub", "../elsewhere").fs,
    "out/aimed",
    "../elsewhere/secret",
  ).fs;
  let steps = [
    MakeDirectory("sub", 493),
    WriteFile("sub/f", 420, b"x"),
    WriteFile("held", 420, b"h"),
    WriteFile("aimed", 420, b"overwritten"),
    MakeSymlink("top", "held"),
    MakeHardLink("named", "gone"),
    MakeHardLink("sub/named", "top"),
    MakeDirectory("top", 493),
    WriteFile("fine", 420, b"fine"),
  ];
  let over = fs::on_mem[d](tree, || extract[d](steps, "out"));
  assert_eq(over.value, [
    Barred(Replaces),
    Barred(ThroughLink),
    Barred(Replaces),
    Barred(Replaces),
    Barred(Replaces),
    Barred(LinkMissing),
    Barred(ThroughLink),
    Barred(Replaces),
    Extracted,
  ]);
  assert_eq(fs::listed_names(fs::mem_list(over.tree, "elsewhere")), Some(["secret"]));
  assert_eq(fs::mem_read(over.tree, "elsewhere/secret"), Some(b"kept"));
  assert_eq(
    fs::listed_names(fs::mem_list(over.tree, "out")),
    Some(["aimed", "fine", "held", "sub", "top"]),
  );
  assert_eq(fs::mem_read(over.tree, "out/top"), Some(b"t"));
  let nowhere = fs::on_mem[d](tree, || extract[d](steps, "absent"));
  assert_eq(nowhere.value, steps.map(|_: Operation| Failed(fs::NotFound)));
  assert_eq(fs::mem_kind(nowhere.tree, "absent"), fs::Missing)
}

fn unpack_tried(
  archive: Bytes,
  window: Int,
) -> fs::MemResult<Result<Result<List<ExtractionResult>, UnsafeEntry>, Error>> / {io.fail, io.closed, abort.raise} =
  fs::on_mem[d](fs::mem_create_dir(fs::mem_of([{ path: "a.tar", body: archive }]), "out").fs, || {
    let rejected: Result<Result<List<ExtractionResult>, UnsafeEntry>, Error> = try[tar.fail] {
      let unsafe: Result<List<ExtractionResult>, UnsafeEntry> = try[tar.unsafe] {
        unpack[d, d]("a.tar", "out", generous_limits(), window)
      };
      unsafe
    };
    rejected
  })

fn paths_of(entries: List<Entry>) -> String =
  String::join(
    entries.map(|e: Entry|
      if e.header.link == "" { e.header.path } else { e.header.path ++ " -> " ++ e.header.link }),
    ", ",
  )

test "an archive with a member that may not be extracted extracts nothing, wherever the member is: {paths_of(c.entries)}" for c: { entries: List<Entry>, index: Int, reason: UnsafeReason } in [
    { entries: [file("ok", b"1"), file("../out", b"x")], index: 1, reason: Escapes },
    {
      entries: [file("ok", b"1"), file("d/../../out", b"x"), file("z", b"z")],
      index: 1,
      reason: Escapes,
    },
    { entries: [file("ok", b"1"), file("/etc/passwd", b"x")], index: 1, reason: Absolute },
    {
      entries: [directory("d"), symlink("l", "d"), file("l/f", b"x")],
      index: 2,
      reason: ThroughLink,
    },
    { entries: [file("ok", b"1"), symlink("l", "../../outside")], index: 1, reason: LinkEscapes },
    { entries: [file("ok", b"1"), symlink("l", "/etc")], index: 1, reason: LinkEscapes },
    { entries: [file("ok", b"1"), hard_link("h", "../outside")], index: 1, reason: LinkEscapes },
  ] {
  let over = unpack_tried(write(c.entries), 2048);
  assert_eq(
    match over.value { Ok(Err(e)) -> Some((e.index, e.reason)), _ -> None },
    Some((c.index, c.reason)),
  );
  assert_eq(fs::listed_names(fs::mem_list(over.tree, "out")), Some([]));
  assert_eq(fs::listed_names(fs::mem_list(over.tree, "")), Some(["a.tar", "out"]));
  assert_eq(over.tree.opened.len(), 0)
}

test "extracting a truncated archive, or one with a header larger than the read buffer, creates no files" {
  let whole = write([file("ok", b"1"), file("big", b"b".repeat(2000))]);
  let prefix_split = unpack_tried(whole.slice(0, 2048), 4096);
  assert_eq(
    match prefix_split.value { Err(e) -> Some((e.at, e.reason)), Ok(_) -> None },
    Some((2048, Truncated)),
  );
  assert_eq(fs::listed_names(fs::mem_list(prefix_split.tree, "out")), Some([]));
  let long = write([file("ok", b"1"), file(String::of_bytes(b"n".repeat(4000)), b"x")]);
  let narrow = unpack_tried(long, 4096);
  assert_eq(
    match narrow.value { Err(e) -> Some((e.at, e.reason)), Ok(_) -> None },
    Some((1024, TooLarge)),
  );
  assert_eq(fs::listed_names(fs::mem_list(narrow.tree, "out")), Some([]));
  let wide = unpack_tried(long, 8192);
  assert_eq(match wide.value { Ok(Ok(apply_operation)) -> apply_operation.len(), _ -> 0 }, 2)
}

fn measured<a>(
  go: () -> a / {fs.read[d], fs.write[d], io.fail, io.closed, tar.fail, tar.unsafe, abort.raise},
) -> { value: a, requested: Int, wrote: Int } / {fs.read[d], fs.write[d], io.fail, io.closed, tar.fail, tar.unsafe, abort.raise} =
  handle {
    go()
  } with {
    var largest_read = 0,
    var wrote = 0,
    fs.read_chunk[d](file, most) -> {
      largest_read = max(largest_read, most);
      fs.read_chunk[d](file, most)
    },
    fs.write_chunk[d](file, body) -> {
      wrote = max(wrote, body.len());
      fs.write_chunk[d](file, body)
    },
    return value -> { value: value, requested: largest_read, wrote: wrote },
  }

test "unpacking a file larger than the read buffer reads and writes it in pieces no larger than the buffer" {
  let body = b"0123456789".repeat(2000);
  let archive = write([directory("d"), file("d/large", body), file("small", b"s")]);
  let tree = fs::mem_create_dir(fs::mem_of([{ path: "a.tar", body: archive }]), "out").fs;
  let over = fs::on_mem[d](tree, ||
    measured(|| unpack[d, d]("a.tar", "out", generous_limits(), 4096)));
  assert_eq(over.value.value.len(), 3);
  assert_eq(fs::mem_read(over.tree, "out/d/large"), Some(body));
  assert_eq(fs::mem_read(over.tree, "out/small"), Some(b"s"));
  assert_eq(over.value.requested, 4096);
  assert_eq(over.value.wrote, 4096);
  assert(body.len() > 4 * 4096)
}

effect pushed {
  write push(bytes: Int) -> Unit
}

test "packing a file larger than the chunk size sends it to the sink in several smaller writes whose total is the archive size" {
  let body = b"0123456789".repeat(2000);
  let tree = fs::mem_of([{ path: "src/large", body: body }]);
  let over = fs::on_mem[d](tree, ||
    handle {
      let sink: Sink<| {pushed.push}> = {
        push: |bytes: Bytes| {
          pushed.push(bytes.len());
          true
        },
        close: || (),
      };
      let options: PackOptions = {
        times: false,
        modes: false,
        entries: 1,
        bytes: 20000,
        chunk: 700,
      };
      with_scope[out](sink, io::close_sink) { out -> pack[d]("src", [""], out, options) }
    } with {
      var longest = 0,
      var byte_sum = 0,
      pushed.push(n) -> {
        longest = max(longest, n);
        byte_sum = byte_sum + n;
      },
      return packed -> { packed: packed, longest: longest, total: byte_sum },
    });
  assert_eq(over.value.total, over.value.packed.bytes);
  assert_eq(over.value.packed.bytes, 512 + 20480 + 1024);
  assert_eq(over.value.longest, 1024)
}
