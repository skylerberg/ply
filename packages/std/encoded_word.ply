//! Reads and writes text outside ASCII in a header field: RFC 2047's encoded words, and the
//! extended parameter values of RFC 2231 and RFC 8187.
//!
//! An encoded word is `=?charset?coding?text?=`: a charset's name, the coding `Q` or `B`, and the
//! text's bytes written in that coding. `Q` is quoted-printable restricted to the characters
//! allowed in every header position, with `_` for a space. `B` is base64.
//!
//! `encode` returns printable ASCII that contains no `=?` unchanged. It writes any other text as
//! UTF-8 encoded words of at most 75 characters, separated by spaces, and never splits a character
//! between words. `encode_words` always writes encoded words, even for text that `encode` would
//! leave unchanged.
//!
//! `read` returns the text of a field's value. It decodes each encoded word wherever it appears,
//! drops the blanks between two encoded words, and leaves everything else as written. Text shaped
//! like an encoded word must be a valid one. `read` raises an `Error`, and `decode` returns it as
//! an `Err`, for a charset or coding this module does not know, for encoded text that is invalid in
//! its coding, and for bytes that are not valid text in the charset. A word longer than 75
//! characters is still read. `pieces` returns the parts that `read` is made of, each word with its
//! text or the reason it has none, for a caller that wants to keep an unreadable word as written.
//!
//! An extended value is `charset'language'text`, with the text's bytes percent-encoded. It is the
//! value of a parameter whose name ends in `*`, as in `filename*=UTF-8''na%C3%AFve.txt`. The
//! language is read and dropped. RFC 2231 also splits a value into sections, `name*0*`, `name*1`,
//! and only the first section names the charset. `read_sections` reads sections as one value and
//! `encode_sections` writes one. `std.mime` decides which parameters are sections of one value.
//!
//! The charsets read and written are UTF-8, US-ASCII, ISO-8859-1, ISO-8859-2, ISO-8859-15,
//! windows-1250, windows-1251, windows-1252 and KOI8-R. Any other charset is an error of kind
//! `UnknownCharset`, which carries the charset's name.

import std.base64 (base64_decode, base64_encode)
import std.bytes
import std.quoted_printable (escape, unescape)
import std.list
import std.result
import std.show (show)
import std.string
import std.url (url_encode)
import std.gen

/// A character set this module reads and writes.
pub type Charset =
  | Utf8
  | UsAscii
  | Latin1
  /// ISO-8859-2, the charset for Central European languages.
  | Latin2
  /// ISO-8859-15: ISO-8859-1 with the euro sign and with the French and Finnish letters that
  /// ISO-8859-1 lacks.
  | Latin9
  | Windows1250
  | Windows1251
  | Windows1252
  | Koi8R

/// How an encoded word writes its bytes.
pub type Coding =
  /// Printable ASCII as itself, `_` for a space, and `=` with two hex digits for any other byte.
  | Q
  | B

/// Why a text cannot be read.
pub type ErrorKind =
  /// A charset this module does not read, with its name as written.
  | UnknownCharset(String)
  /// An encoded word whose coding is neither `Q` nor `B`, with the coding as written.
  | UnknownCoding(String)
  /// Encoded text that is invalid in its coding: a stray `=` in `Q`, base64 that is not canonical,
  /// or in an extended value a `%` without two hex digits or a character that must be escaped.
  | BadText
  /// Bytes that are not text in the named charset.
  | BadBytes
  /// An extended value without the two `'` that end its charset and its language.
  | NoCharset

/// An error, and the offset in the text's UTF-8 where it was found.
pub type Error = { at: Int, reason: ErrorKind }

/// What this module's readers raise when they cannot read a text.
pub effect encoded_word {
  /// The text contains an encoded word or an extended value that cannot be read.
  raise fail(e: Error)
}

fn fail<a>(at: Int, reason: ErrorKind) -> a / {encoded_word.fail} =
  encoded_word.fail({ at: at, reason: reason })

/// The charset a name means, in any case: `utf-8` and `utf8`; `us-ascii` and `ascii`;
/// `iso-8859-1`, `iso8859-1`, `iso_8859-1`, `latin1` and `l1`, and the same five forms of
/// ISO-8859-2 and ISO-8859-15 (`latin2`, `l2`, `latin9`, `l9`); `windows-1250`, `windows-1251` and
/// `windows-1252`, each also as `cp125x`; and `koi8-r`.
pub fn charset_named(name: String) -> Option<Charset> =
  match name.ascii_lower() {
    "utf-8" | "utf8" -> Some(Utf8),
    "us-ascii" | "ascii" -> Some(UsAscii),
    "iso-8859-1" | "iso8859-1" | "iso_8859-1" | "latin1" | "l1" -> Some(Latin1),
    "iso-8859-2" | "iso8859-2" | "iso_8859-2" | "latin2" | "l2" -> Some(Latin2),
    "iso-8859-15" | "iso8859-15" | "iso_8859-15" | "latin9" | "l9" -> Some(Latin9),
    "windows-1250" | "cp1250" -> Some(Windows1250),
    "windows-1251" | "cp1251" -> Some(Windows1251),
    "windows-1252" | "cp1252" -> Some(Windows1252),
    "koi8-r" -> Some(Koi8R),
    _ -> None,
  }

/// Returns the name of `c` in the IANA charset registry, as written in an encoded word.
pub fn charset_name(c: Charset) -> String =
  match c {
    Utf8 -> "UTF-8",
    UsAscii -> "US-ASCII",
    Latin1 -> "ISO-8859-1",
    Latin2 -> "ISO-8859-2",
    Latin9 -> "ISO-8859-15",
    Windows1250 -> "windows-1250",
    Windows1251 -> "windows-1251",
    Windows1252 -> "windows-1252",
    Koi8R -> "KOI8-R",
  }

/// Every charset this module reads and writes.
pub fn charsets() -> List<Charset> =
  [Utf8, UsAscii, Latin1, Latin2, Latin9, Windows1250, Windows1251, Windows1252, Koi8R]

/// Returns the text that the bytes `data` spell in the charset `c`, or `None` when `data` is not
/// valid in it. That happens for bytes that are not UTF-8, for a byte above 127 in US-ASCII, and
/// for a byte that a single-byte charset maps to no character. Every byte is valid in ISO-8859-1,
/// ISO-8859-2, ISO-8859-15 and KOI8-R.
pub fn text_of(c: Charset, data: Bytes) -> Option<String> / {abort.raise} =
  match c {
    Utf8 -> if data.is_utf8() { Some(String::of_bytes(data)) } else { None },
    UsAscii -> if is_ascii(data) { Some(String::of_bytes(data)) } else { None },
    _ -> {
      let points = points_of(c);
      String::of_code_points(range(0, data.len()).map(|i: Int| points.at_or(data.at(i), -1)))
    },
  }

/// Returns the bytes that spell `text` in the charset `c`, or `None` when `text` contains a
/// character the charset lacks.
pub fn bytes_of(c: Charset, text: String) -> Option<Bytes> / {abort.raise} =
  match c {
    Utf8 -> Some(Bytes::of_string(text)),
    UsAscii -> if is_ascii(Bytes::of_string(text)) { Some(Bytes::of_string(text)) } else { None },
    _ -> {
      let byte_of_point = enumerate_points(points_of(c)).fold(
        Map::new(),
        |m: Map<Int, Int>, p: Point| if p.point < 0 { m } else { m.insert(p.point, p.byte) },
      );
      let found = text.code_points().map(|p: Int| byte_of_point.get(p));
      if found.fold(true, |ok: Bool, b: Option<Int>| ok && b != None) {
        Some(
          Bytes::concat_all(
            found.map(|b: Option<Int>| match b { Some(n) -> byte_of_int(n), None -> b"" }),
          ),
        )
      } else { None }
    },
  }

type Point = { byte: Int, point: Int }

fn enumerate_points(points: List<Int>) -> List<Point> =
  range(0, points.len()).map(|b: Int| { byte: b, point: points.at_or(b, -1) })

fn points_of(c: Charset) -> List<Int> / {abort.raise} = {
  let first = table_start(c);
  let table_points = table(c).code_points().map(|p: Int| if p == 0xFFFD { -1 } else { p });
  range(0, first).concat(table_points).concat(range(first + table_points.len(), 256))
}

fn table_start(c: Charset) -> Int =
  match c {
    Latin2 | Latin9 -> 0xA0,
    Windows1250 | Windows1251 | Windows1252 | Koi8R -> 0x80,
    _ -> 256,
  }

