  match c {
    Latin2 ->
      "\u{A0}Ą˘Ł¤ĽŚ§¨ŠŞŤŹ\u{AD}ŽŻ°ą˛ł´ľśˇ¸šşťź˝žż"
        ++ "ŔÁÂĂÄĹĆÇČÉĘËĚÍÎĎĐŃŇÓÔŐÖ×ŘŮÚŰÜÝŢß"
        ++ "ŕáâăäĺćçčéęëěíîďđńňóôőö÷řůúűüýţ˙",
    Latin9 -> "\u{A0}¡¢£€¥Š§š©ª«¬\u{AD}®¯°±²³Žµ¶·ž¹º»ŒœŸ¿",
    Windows1250 ->
      "€\u{FFFD}‚\u{FFFD}„…†‡\u{FFFD}‰Š‹ŚŤŽŹ\u{FFFD}‘’“”•–—\u{FFFD}™š›śťžź"
        ++ "\u{A0}ˇ˘Ł¤Ą¦§¨©Ş«¬\u{AD}®Ż°±˛ł´µ¶·¸ąş»Ľ˝ľż"
        ++ "ŔÁÂĂÄĹĆÇČÉĘËĚÍÎĎĐŃŇÓÔŐÖ×ŘŮÚŰÜÝŢß"
        ++ "ŕáâăäĺćçčéęëěíîďđńňóôőö÷řůúűüýţ˙",
    Windows1251 ->
      "ЂЃ‚ѓ„…†‡€‰Љ‹ЊЌЋЏђ‘’“”•–—\u{FFFD}™љ›њќћџ"
        ++ "\u{A0}ЎўЈ¤Ґ¦§Ё©Є«¬\u{AD}®Ї°±Ііґµ¶·ё№є»јЅѕї"
        ++ "АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ"
        ++ "абвгдежзийклмнопрстуфхцчшщъыьэюя",
    Windows1252 ->
      "€\u{FFFD}‚ƒ„…†‡ˆ‰Š‹Œ\u{FFFD}Ž\u{FFFD}\u{FFFD}‘’“”•–—˜™š›œ\u{FFFD}žŸ",
    Koi8R ->
      "─│┌┐└┘├┤┬┴┼▀▄█▌▐░▒▓⌠■∙√≈≤≥\u{A0}⌡°²·÷"
        ++ "═║╒ё╓╔╕╖╗╘╙╚╛╜╝╞╟╠╡Ё╢╣╤╥╦╧╨╩╪╫╬©"
        ++ "юабцдефгхийклмнопярстужвьызшэщчъ"
        ++ "ЮАБЦДЕФГХИЙКЛМНОПЯРСТУЖВЬЫЗШЭЩЧЪ",
    _ -> "",
  }

fn is_ascii(data: Bytes) -> Bool = data.position(0, |c: Int| c > 127) == None

/// Returns `text` in the form it takes in a header field: unchanged if it is printable ASCII
/// containing no `=?`, and otherwise UTF-8 encoded words in `coding`, each at most 75 characters
/// and containing only whole characters, with a space between them.
pub fn encode(text: String, coding: Coding) -> String / {abort.raise} =
  if is_plain(text) { text } else { String::join(encode_words(text, coding), " ") }

/// `text` as UTF-8 encoded words in `coding` whatever it contains, printable ASCII too: each word
/// at most 75 characters and containing only whole characters. An empty text gives no words.
pub fn encode_words(text: String, coding: Coding) -> List<String> / {abort.raise} =
  chunks(text, coding).map(|chunk: Bytes| encode_chunk(chunk, coding))

/// One part of a field's value.
pub type Piece =
  /// Text that is not an encoded word, as written.
  | Literal(String)
  /// An encoded word as written, and its text or the reason it has none.
  | EncodedWord(String, Result<String, Error>)

/// The parts `text` is made of, in order, with each encoded word separate from the text around it.
/// Nothing is left out, including the blanks between two encoded words: the parts joined in order
/// are `text`. An error's offset is the word's position in `text`.
pub fn pieces(text: String) -> List<Piece> / {abort.raise} = {
  let b = Bytes::of_string(text);
  words(b, { at: 0, out: [] }, b.len() + 1)
}

/// The text of a field's value with each encoded word in it decoded, raising `encoded_word.fail`
/// where `decode` returns `Err`.
pub fn read(text: String) -> String / {encoded_word.fail, abort.raise} = {
  let read = pieces(text).fold({ out: [], gap: "", joined: false }, |j: JoinState, p: Piece|
    match p {
      Literal(written) -> if j.joined && is_blank(written) { { ..j, gap: written } }
      else { { out: j.out.push(j.gap).push(written), gap: "", joined: false } },
      EncodedWord(_, Ok(carried)) -> { out: j.out.push(carried), gap: "", joined: true },
      EncodedWord(_, Err(r)) -> fail(r.at, r.reason),
    });
  String::join(read.out.push(read.gap), "")
}

type JoinState = { out: List<String>, gap: String, joined: Bool }

/// Whether `text` is nothing but spaces, tabs and line breaks: what may separate two encoded words
/// that are read as one text.
pub fn is_blank(text: String) -> Bool / {abort.raise} = {
  let b = Bytes::of_string(text);
  b.skip(0, b" \t\r\n") == b.len()
}

/// The text of a field's value with each encoded word in it decoded, or where and why one cannot
/// be read.
pub fn decode(text: String) -> Result<String, Error> / {abort.raise} = try { read(text) }

fn printable() -> Bytes =
  b" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

fn q_unescaped_bytes() -> Bytes =
  b"!*+-/0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

fn is_plain(text: String) -> Bool / {abort.raise} = {
  let b = Bytes::of_string(text);
  !text.contains("=?") && b.skip(0, printable()) == b.len()
}

fn max_text_width(coding: Coding) -> Int = match coding { Q -> 63, B -> 45 }

fn width(bytes: Bytes, coding: Coding) -> Int / {abort.raise} =
  match coding {
    B -> bytes.len(),
    Q -> range(0, bytes.len()).fold(0, |sum: Int, i: Int| sum + q_encode_byte(bytes.at(i)).len()),
  }

fn q_encode_byte(c: Int) -> Bytes / {abort.raise} =
  if c == b' ' { b"_" }
  else if byte_of_int(c).skip(0, q_unescaped_bytes()) == 1 { byte_of_int(c) }
  else { escape(c) }

type ChunkState = { done: List<Bytes>, pending: List<Bytes>, room: Int }

fn chunks(text: String, coding: Coding) -> List<Bytes> / {abort.raise} = {
  let cut = text.chars().fold(
    { done: [], pending: [], room: max_text_width(coding) },
    |c: ChunkState, char: Char| {
      let bytes = Bytes::of_string(String::of_chars([char]));
      let wide = width(bytes, coding);
      if wide > c.room {
        {
          done: c.done.push(Bytes::concat_all(c.pending)),
          pending: [bytes],
          room: max_text_width(coding) - wide,
        }
      } else { { done: c.done, pending: c.pending.push(bytes), room: c.room - wide } }
    },
  );
  if cut.pending.len() == 0 { cut.done } else { cut.done.push(Bytes::concat_all(cut.pending)) }
}

fn encode_chunk(chunk: Bytes, coding: Coding) -> String / {abort.raise} =
  match coding {
    B -> "=?UTF-8?B?" ++ base64_encode(chunk) ++ "?=",
    Q ->
      "=?UTF-8?Q?"
        ++ String::of_bytes(
          Bytes::concat_all(range(0, chunk.len()).map(|i: Int| q_encode_byte(chunk.at(i)))),
        )
        ++ "?=",
  }

type Scan = { at: Int, out: List<Piece> }

fn words(b: Bytes, s: Scan, left: Int) -> List<Piece> / {abort.raise} =
  if left <= 0 { s.out } else {
    match b.index_of_from(b"=?", s.at) {
      None -> with_literal(s.out, b, s.at, b.len()),
      Some(open) -> match word_at(b, open) {
        None -> words(b, { at: open + 2, out: with_literal(s.out, b, s.at, open + 2) }, left - 1),
        Some(w) ->
          words(
            b,
            {
              at: w.end,
              out: with_literal(s.out, b, s.at, open).push(
                EncodedWord(String::of_bytes(b.slice(open, w.end)), decode_word(b, w)),
              ),
            },
            left - 1,
          ),
      },
    }
  }

fn with_literal(out: List<Piece>, b: Bytes, from: Int, to: Int) -> List<Piece> / {abort.raise} =
  if to <= from { out } else { out.push(Literal(String::of_bytes(b.slice(from, to)))) }

type WordPositions = { charset_at: Int, coding_at: Int, text_at: Int, text_end: Int, end: Int }

fn word_at(b: Bytes, open: Int) -> Option<WordPositions> / {abort.raise} = {
  let stops = b"? \t\r\n";
  let charset_end = b.skip_until(open + 2, stops);
  let coding_end = b.skip_until(charset_end + 1, stops);
  let text_end = b.skip_until(coding_end + 1, stops);
  if charset_end == open + 2 || coding_end == charset_end + 1 { None }
  else if b.peek(charset_end) != b'?' || b.peek(coding_end) != b'?' { None }
  else if b.peek(text_end) != b'?' || b.peek(text_end + 1) != b'=' { None } else {
    Some({
      charset_at: open + 2,
      coding_at: charset_end + 1,
      text_at: coding_end + 1,
      text_end: text_end,
      end: text_end + 2,
    })
  }
}

fn decode_word(b: Bytes, w: WordPositions) -> Result<String, Error> / {abort.raise} = {
  let named = String::of_bytes(b.slice(w.charset_at, w.coding_at - 1));
  let name = match named.split("*") { [first, ..] -> first, [] -> named };
  let coding = String::of_bytes(b.slice(w.coding_at, w.text_at - 1));
  let coded = b.slice(w.text_at, w.text_end);
  match charset_named(name) {
    None -> Err({ at: w.charset_at, reason: UnknownCharset(name) }),
    Some(charset) -> match word_bytes(coding.ascii_lower(), coded) {
      None -> Err({ at: w.coding_at, reason: UnknownCoding(coding) }),
      Some(None) -> Err({ at: w.text_at, reason: BadText }),
      Some(Some(found)) -> match text_of(charset, found) {
        Some(text) -> Ok(text),
        None -> Err({ at: w.text_at, reason: BadBytes }),
      },
    },
  }
}

fn word_bytes(coding: String, coded: Bytes) -> Option<Option<Bytes>> / {abort.raise} =
  match coding {
    "q" -> Some(unescape(coded.replace(b"_", b" "), b'=', printable()).ok()),
    "b" -> Some(base64_decode(String::of_bytes(coded))),
    _ -> None,
  }

/// `text` as an extended parameter value: `UTF-8''` and its bytes percent-encoded.
pub fn encode_extended(text: String) -> String / {abort.raise} = "UTF-8''" ++ url_encode(text)

/// The text an extended parameter value carries, raising `encoded_word.fail` where
/// `decode_extended` returns `Err`.
pub fn read_extended(value: String) -> String / {encoded_word.fail, abort.raise} =
  read_sections([{ text: value, extended: true }])

/// The text an extended parameter value carries, or where and why it cannot be read.
pub fn decode_extended(value: String) -> Result<String, Error> / {abort.raise} =
  try { read_extended(value) }

/// One section of a parameter's value as RFC 2231 splits it: its text as written, and whether it
/// is extended. An extended section is percent-encoded and, as a value's first section, starts
/// with the charset and the language.
pub type Section = { text: String, extended: Bool }

/// Returns the value that the sections form together, in the order given. Raises
/// `encoded_word.fail` where `decode_sections` returns `Err`. When no section is extended, the
/// value is the sections' texts joined as written. Otherwise the first section must be extended and
/// name the charset. Each extended section holds percent-encoded bytes of that charset. Every other
/// section is plain text that the charset must be able to encode. One character's bytes may be
/// split across two sections. An error's offset counts characters through the sections' texts, one
/// after another.
pub fn read_sections(sections: List<Section>) -> String / {encoded_word.fail, abort.raise} =
  match sections {
    [] -> "",
    [first, ..rest] -> if !sections.fold(false, |any: Bool, s: Section| any || s.extended) {
      String::join(sections.map(|s: Section| s.text), "")
    } else if !first.extended { fail(0, NoCharset) }
    else { read_extended_value(first.text, rest) },
  }

fn read_extended_value(
  head: String,
  rest: List<Section>,
) -> String / {encoded_word.fail, abort.raise} = {
  let b = Bytes::of_string(head);
  let n = b.len();
  let first = b.skip_until(0, b"'");
  let second = b.skip_until(first + 1, b"'");
  if second >= n { fail(n, NoCharset) } else {
    let name = String::of_bytes(b.slice(0, first));
    let charset = match charset_named(name) { Some(c) -> c, None -> fail(0, UnknownCharset(name)) };
    let opening = String::of_bytes(b.slice(second + 1, n));
    let read = rest.fold(
      { out: [section_bytes(charset, { text: opening, extended: true }, second + 1)], at: n },
      |r: { out: List<Bytes>, at: Int }, s: Section|
        {
          out: r.out.push(section_bytes(charset, s, r.at)),
          at: r.at + Bytes::of_string(s.text).len(),
        },
    );
    match text_of(charset, Bytes::concat_all(read.out)) {
      Some(text) -> text,
      None -> fail(second + 1, BadBytes),
    }
  }
}

fn section_bytes(
  charset: Charset,
  s: Section,
  at: Int,
) -> Bytes / {encoded_word.fail, abort.raise} =
  if s.extended {
    match unescape(Bytes::of_string(s.text), b'%', attribute_chars()) {
      Ok(found) -> found,
      Err(i) -> fail(at + i, BadText),
    }
  } else { match bytes_of(charset, s.text) { Some(found) -> found, None -> fail(at, BadBytes) } }

/// The value of the sections together, or where and why it cannot be read.
pub fn decode_sections(sections: List<Section>) -> Result<String, Error> / {abort.raise} =
  try { read_sections(sections) }

/// Splits `text` into extended sections, each a piece of its percent-encoded UTF-8. The first
/// section begins with `UTF-8''`. A character's escapes are never split between sections. Each
/// section is at most `room` characters of encoded output, unless one character's escapes alone are
/// longer. A text that fits is a single section equal to the value of `encode_extended`.
pub fn encode_sections(text: String, room: Int) -> List<String> / {abort.raise} = {
  let cut = text.chars().fold(
    { done: [], held: "UTF-8''" },
    |c: { done: List<String>, held: String }, char: Char| {
      let escaped = url_encode(String::of_chars([char]));
      if c.held.len() + escaped.len() > room { { done: c.done.push(c.held), held: escaped } }
      else { { done: c.done, held: c.held ++ escaped } }
    },
  );
  cut.done.push(cut.held)
}

fn attribute_chars() -> Bytes =
  b"!#$&+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

test "`encode` returns only ASCII, and every space-separated encoded word is at most 75 characters long" {
  gen::check(gen::text(), |text: String| {
    is_plain(text)
      || [Q, B].fold(true, |ok: Bool, coding: Coding|
        ok && is_ascii(Bytes::of_string(encode(text, coding)))
          && encode(text, coding).split(" ").fold(true, |short: Bool, w: String|
            short && w.len() <= 75 && w.starts_with("=?UTF-8?") && w.ends_with("?=")))
  })
}

test "encoded words are read back whatever the text contains" {
  gen::check(gen::text(), |text: String| {
    [Q, B].fold(true, |ok: Bool, coding: Coding|
      ok && decode(String::join(encode_words(text, coding), " ")) == Ok(text))
  })
}

type Vector = { field: String, decoded_text: String }

fn vectors() -> List<Vector> =
  [
    {
      field: "=?US-ASCII?Q?Keith_Moore?= <moore@cs.utk.edu>",
      decoded_text: "Keith Moore <moore@cs.utk.edu>",
    },
    {
      field: "=?ISO-8859-1?Q?Keld_J=F8rn_Simonsen?= <keld@dkuug.dk>",
      decoded_text: "Keld J\u{f8}rn Simonsen <keld@dkuug.dk>",
    },
    {
      field: "=?ISO-8859-1?Q?Andr=E9?= Pirard <PIRARD@vm1.ulg.ac.be>",
      decoded_text: "Andr\u{e9} Pirard <PIRARD@vm1.ulg.ac.be>",
    },
    {
      field: "=?ISO-8859-1?B?SWYgeW91IGNhbiByZWFkIHRoaXMgeW8=?=",
      decoded_text: "If you can read this yo",
    },
    {
      field: "=?ISO-8859-1?B?SWYgeW91IGNhbiByZWFkIHRoaXMgeW8=?= =?ISO-8859-2?B?dSB1bmRlcnN0YW5kIHRoZSBleGFtcGxlLg==?=",
      decoded_text: "If you can read this you understand the example.",
    },
    {
      field: "=?ISO-8859-1?Q?Olle_J=E4rnefors?= <ojarnef@admin.kth.se>",
      decoded_text: "Olle J\u{e4}rnefors <ojarnef@admin.kth.se>",
    },
    {
      field: "=?ISO-8859-1?Q?Patrik_F=E4ltstr=F6m?= <paf@nada.kth.se>",
      decoded_text: "Patrik F\u{e4}ltstr\u{f6}m <paf@nada.kth.se>",
    },
    { field: "(=?ISO-8859-1?Q?a?=)", decoded_text: "(a)" },
    { field: "(=?ISO-8859-1?Q?a?= b)", decoded_text: "(a b)" },
    { field: "(=?ISO-8859-1?Q?a?= =?ISO-8859-1?Q?b?=)", decoded_text: "(ab)" },
    { field: "(=?ISO-8859-1?Q?a?=  =?ISO-8859-1?Q?b?=)", decoded_text: "(ab)" },
    { field: "(=?ISO-8859-1?Q?a?=\r\n    =?ISO-8859-1?Q?b?=)", decoded_text: "(ab)" },
    { field: "(=?ISO-8859-1?Q?a_b?=)", decoded_text: "(a b)" },
    { field: "(=?ISO-8859-1?Q?a?= =?US-ASCII?Q?_b?=)", decoded_text: "(a b)" },
    { field: "(=?ISO-8859-1?Q?a?= =?ISO-8859-2?Q?_b?=)", decoded_text: "(a b)" },
    {
      field: "=?windows-1252?Q?=80_=93quoted=94?=",
      decoded_text: "\u{20ac} \u{201c}quoted\u{201d}",
    },
    { field: "=?ISO-8859-15?Q?=A4uro?=", decoded_text: "\u{20ac}uro" },
    { field: "=?koi8-r?B?8NLJ18XU?=", decoded_text: "\u{41f}\u{440}\u{438}\u{432}\u{435}\u{442}" },
    {
      field: "=?windows-1251?Q?=CF=F0=E8=E2=E5=F2?=",
      decoded_text: "\u{41f}\u{440}\u{438}\u{432}\u{435}\u{442}",
    },
    { field: "=?CP1250?Q?=8Aal=E1t?=", decoded_text: "\u{160}al\u{e1}t" },
    {
      field: "Nathaniel Borenstein <nsb@thumper.bellcore.com>",
      decoded_text: "Nathaniel Borenstein <nsb@thumper.bellcore.com>",
    },
    { field: "=?utf-8?q?caf=c3=a9?=", decoded_text: "caf\u{e9}" },
    { field: "=?UTF-8*fr?B?Y2Fmw6k=?=", decoded_text: "caf\u{e9}" },
    { field: "=?UTF-8?Q??=", decoded_text: "" },
    { field: "a =?UTF-8?Q?b?= c =?UTF-8?Q?d?=", decoded_text: "a b c d" },
    { field: "=? not a word ?= and =?half?", decoded_text: "=? not a word ?= and =?half?" },
    { field: "1 + 1 =?", decoded_text: "1 + 1 =?" },
    { field: "=? =?UTF-8?Q?a?=", decoded_text: "=? a" },
    { field: "=?UTF-8?Q?a?=x =?UTF-8?Q?b?=", decoded_text: "ax b" },
    { field: "=??Q?a?=", decoded_text: "=??Q?a?=" },
    { field: "=??Q?a?b?=", decoded_text: "=??Q?a?b?=" },
    { field: "=?UTF-8??a?=", decoded_text: "=?UTF-8??a?=" },
    { field: "=?UTF-8??a?b?=", decoded_text: "=?UTF-8??a?b?=" },
    { field: "=?UTF-8 Q?a?=", decoded_text: "=?UTF-8 Q?a?=" },
    { field: "=?UTF-8?Q a?=", decoded_text: "=?UTF-8?Q a?=" },
    { field: "=?UTF-8?B?Y2Fm?w6k=?=", decoded_text: "=?UTF-8?B?Y2Fm?w6k=?=" },
    { field: "", decoded_text: "" },
  ]

test "`decode` returns the expected decoded text for the encoded-word field {show(c.field)}" for c: Vector in vectors(
  ) { assert_eq(decode(c.field), Ok(c.decoded_text)) }

type ErrorCase = { field: String, at: Int, reason: ErrorKind }

fn error_cases() -> List<ErrorCase> =
  [
    { field: "=?iso-8859-8?b?7eXs+SDv4SDp7Oj08A==?=", at: 2, reason: UnknownCharset("iso-8859-8") },
    {
      field: "=?ISO-8859-1?B?SWYgeW91IGNhbiByZWFkIHRoaXMgeW8=?= =?ISO-2022-JP?B?dSB1bmRlcnN0YW5k?=",
      at: 52,
      reason: UnknownCharset("ISO-2022-JP"),
    },
    { field: "=?windows-1252?Q?=81?=", at: 17, reason: BadBytes },
    { field: "=?UTF-8?X?abc?=", at: 8, reason: UnknownCoding("X") },
    { field: "=?UTF-8?Q?a=ZZ?=", at: 10, reason: BadText },
    { field: "=?UTF-8?Q?a=4?=", at: 10, reason: BadText },
    { field: "=?UTF-8?B?abc?=", at: 10, reason: BadText },
    { field: "=?UTF-8?Q?=FF?=", at: 10, reason: BadBytes },
    { field: "=?US-ASCII?Q?caf=E9?=", at: 13, reason: BadBytes },
    { field: "ok =?UTF-8?Q?a?= =?Big5?Q?b?=", at: 19, reason: UnknownCharset("Big5") },
  ]

test "`decode` returns an error with the expected position and reason for the malformed field {show(c.field)}" for c: ErrorCase in error_cases(
  ) { assert_eq(decode(c.field), Err({ at: c.at, reason: c.reason })) }

test "`read` and `read_extended` raise the same errors that `decode` and `decode_extended` return" {
  assert_eq(try { read("=?x?q?a?=") }, Err({ at: 2, reason: UnknownCharset("x") }));
  assert_eq(try { read_extended("UTF-8'%41") }, Err({ at: 9, reason: NoCharset }))
}

test "`encode` returns plain text unchanged and encodes any other text as UTF-8 encoded words in the requested Q or B encoding" {
  assert_eq(encode("Hello, world", Q), "Hello, world");
  assert_eq(encode("", B), "");
  assert_eq(encode("caf\u{e9} au lait", Q), "=?UTF-8?Q?caf=C3=A9_au_lait?=");
  assert_eq(encode("caf\u{e9}", B), "=?UTF-8?B?Y2Fmw6k=?=");
  assert_eq(encode("a=?b", Q), "=?UTF-8?Q?a=3D=3Fb?=");
  assert_eq(encode("tab\there", Q), "=?UTF-8?Q?tab=09here?=");
  assert_eq(encode("\tx", Q), "=?UTF-8?Q?=09x?=");
  assert_eq(encode("\u{e9}", Q), "=?UTF-8?Q?=C3=A9?=");
  assert_eq(encode("under_score \u{20ac}", Q), "=?UTF-8?Q?under=5Fscore_=E2=82=AC?=")
}

test "a long text is cut between characters into words of at most 75" {
  let euros = String::of_chars(range(0, 20).map(|_: Int| '\u{20ac}'));
  assert_eq(encode(euros, Q).split(" "), [
    "=?UTF-8?Q?=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC?=",
    "=?UTF-8?Q?=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC?=",
    "=?UTF-8?Q?=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC?=",
  ]);
  assert_eq(encode(euros, B).split(" "), [
    "=?UTF-8?B?4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs?=",
    "=?UTF-8?B?4oKs4oKs4oKs4oKs4oKs?=",
  ]);
  assert_eq(decode(encode(euros, Q)), Ok(euros));
  assert_eq(decode(encode(euros, B)), Ok(euros));
  let letters = |n: Int| "\u{e9}" ++ String::of_chars(range(0, n).map(|_: Int| 'a'));
  assert_eq(encode(letters(57), Q).split(" ").map(String::len), [75]);
  assert_eq(encode(letters(58), Q).split(" ").map(String::len), [75, 13]);
  assert_eq(encode(letters(43), B).split(" ").map(String::len), [72]);
  assert_eq(encode(letters(44), B).split(" ").map(String::len), [72, 16])
}

type ExtendedCase = { value: String, text: String }

fn extended() -> List<ExtendedCase> =
  [
    { value: "iso-8859-1'en'%A3%20rates", text: "\u{a3} rates" },
    { value: "UTF-8''%c2%a3%20and%20%e2%82%ac%20rates", text: "\u{a3} and \u{20ac} rates" },
    { value: "UTF-8''%e2%82%ac%20rates", text: "\u{20ac} rates" },
    { value: "utf-8'en-GB'plain.txt", text: "plain.txt" },
    { value: "US-ASCII''", text: "" },
    { value: "windows-1252'de'%80%20Kurs", text: "\u{20ac} Kurs" },
  ]

test "`decode_extended` returns the expected text for the RFC 2231 value {c.value}, which names a charset" for c: ExtendedCase in extended(
  ) { assert_eq(decode_extended(c.value), Ok(c.text)) }

fn unreadable() -> List<ErrorCase> =
  [
    { field: "plain.txt", at: 9, reason: NoCharset },
    { field: "UTF-8'plain.txt", at: 15, reason: NoCharset },
    { field: "''plain.txt", at: 0, reason: UnknownCharset("") },
    { field: "shift_jis''plain.txt", at: 0, reason: UnknownCharset("shift_jis") },
    { field: "UTF-8''two words", at: 10, reason: BadText },
    { field: "UTF-8''100%", at: 10, reason: BadText },
    { field: "UTF-8''a%2", at: 8, reason: BadText },
    { field: "UTF-8''caf\u{e9}", at: 10, reason: BadText },
    { field: "UTF-8''%FF", at: 7, reason: BadBytes },
    { field: "US-ASCII'en'%E2%82%AC", at: 12, reason: BadBytes },
  ]

test "`decode_extended` returns an error with the expected position and reason for the malformed RFC 2231 value {c.field}" for c: ErrorCase in unreadable(
  ) { assert_eq(decode_extended(c.field), Err({ at: c.at, reason: c.reason })) }

test "`encode_extended` writes UTF-8 and percent-escapes every byte except letters, digits and a few safe punctuation characters" {
  assert_eq(encode_extended("\u{20ac} rates.txt"), "UTF-8''%E2%82%AC%20rates.txt");
  assert_eq(encode_extended(""), "UTF-8''")
}

test "`charset_named` finds a charset by name in any letter case, and the listed charsets round-trip through their names" {
  assert_eq(
    ["UTF-8", "utf8", "US-ASCII", "ascii", "ISO-8859-1", "Latin1", "l1"].map(charset_named),
    [
      Some(Utf8),
      Some(Utf8),
      Some(UsAscii),
      Some(UsAscii),
      Some(Latin1),
      Some(Latin1),
      Some(Latin1),
    ],
  );
  assert_eq(charset_named("iso-8859-8"), None);
  assert_eq(charsets().map(charset_name), [
    "UTF-8",
    "US-ASCII",
    "ISO-8859-1",
    "ISO-8859-2",
    "ISO-8859-15",
    "windows-1250",
    "windows-1251",
    "windows-1252",
    "KOI8-R",
  ]);
  assert_eq(charsets().map(charset_name).map(charset_named), charsets().map(|c: Charset| Some(c)));
  assert_eq(["Latin2", "L9", "iso_8859-15", "CP1251", "cp1252", "Koi8-R"].map(charset_named), [
    Some(Latin2),
    Some(Latin9),
    Some(Latin9),
    Some(Windows1251),
    Some(Windows1252),
    Some(Koi8R),
  ]);
  assert_eq(text_of(Latin1, b"caf\xe9"), Some("caf\u{e9}"));
  assert_eq(text_of(Utf8, b"caf\xe9"), None);
  assert_eq(text_of(UsAscii, b"caf\xe9"), None);
  assert_eq(bytes_of(Latin1, "caf\u{e9}"), Some(b"caf\xe9"));
  assert_eq(bytes_of(Latin1, "\u{20ac}"), None);
  assert_eq(bytes_of(Latin1, "\u{100}"), None);
  assert_eq(bytes_of(Latin1, "\u{ff}"), Some(b"\xff"));
  assert_eq(bytes_of(UsAscii, "caf\u{e9}"), None);
  assert_eq(bytes_of(Utf8, "\u{20ac}"), Some(b"\xe2\x82\xac"))
}

type TableCase = { charset: Charset, data: Bytes, text: String }

fn table_cases() -> List<TableCase> =
  [
    { charset: Latin1, data: b"\x80\xa4\xff", text: "\u{80}\u{a4}\u{ff}" },
    { charset: Latin2, data: b"\x80\xa1\xb1\xff", text: "\u{80}\u{104}\u{105}\u{2d9}" },
    {
      charset: Latin9,
      data: b"\x9f\xa4\xa6\xbc\xbd\xbe\xc0",
      text: "\u{9f}\u{20ac}\u{160}\u{152}\u{153}\u{178}\u{c0}",
    },
    { charset: Windows1250, data: b"\x80\x8a\xa5\xff", text: "\u{20ac}\u{160}\u{104}\u{2d9}" },
    { charset: Windows1251, data: b"\x80\x88\xc0\xff", text: "\u{402}\u{20ac}\u{410}\u{44f}" },
    {
      charset: Windows1252,
      data: b"\x80\x85\x99\x9f\xa0\xff",
      text: "\u{20ac}\u{2026}\u{2122}\u{178}\u{a0}\u{ff}",
    },
    { charset: Koi8R, data: b"\x80\xa3\xb3\xc0\xff", text: "\u{2500}\u{451}\u{401}\u{44e}\u{42a}" },
  ]

test "{charset_name(c.charset)} reads {c.data}" for c: TableCase in table_cases() {
  assert_eq(text_of(c.charset, c.data), Some(c.text));
  assert_eq(bytes_of(c.charset, c.text), Some(c.data))
}

test "`text_of` returns nothing for a byte the charset does not define, and `bytes_of` returns nothing for a character the charset cannot represent" {
  assert_eq([0x81, 0x8d, 0x8f, 0x90, 0x9d].map(|b: Int| text_of(Windows1252, byte_of_int(b))), [
    None,
    None,
    None,
    None,
    None,
  ]);
  assert_eq(text_of(Windows1251, b"\x98"), None);
  assert_eq(text_of(Windows1250, b"\x81"), None);
  assert_eq(bytes_of(Windows1252, "\u{81}"), None);
  assert_eq(bytes_of(Windows1252, "\u{fffd}"), None);
  assert_eq(bytes_of(Latin9, "\u{a4}"), None);
  assert_eq(bytes_of(Latin2, "\u{20ac}"), None);
  assert_eq(bytes_of(Koi8R, "\u{e9}"), None)
}

test "the parts of a value are its encoded words and the text around them" {
  assert_eq(pieces("a =?UTF-8?Q?b?=  =?x?Q?c?= =?"), [
    Literal("a "),
    EncodedWord("=?UTF-8?Q?b?=", Ok("b")),
    Literal("  "),
    EncodedWord("=?x?Q?c?=", Err({ at: 19, reason: UnknownCharset("x") })),
    Literal(" =?"),
  ]);
  assert_eq(pieces(""), []);
  assert_eq(pieces("plain"), [Literal("plain")]);
  assert_eq(pieces("=?UTF-8?B?!?="), [
    EncodedWord("=?UTF-8?B?!?=", Err({ at: 10, reason: BadText })),
  ])
}

test "encoded words are written for any text, plain or not, and none for an empty text" {
  assert_eq(encode_words("plain", Q), ["=?UTF-8?Q?plain?="]);
  assert_eq(encode_words("plain", B), ["=?UTF-8?B?cGxhaW4=?="]);
  assert_eq(encode_words("", Q), []);
  assert_eq(encode_words(String::of_bytes(b"a".repeat(200)), Q).map(String::len), [75, 75, 75, 23])
}

type SectionCase = { sections: List<Section>, text: String }

fn section_cases() -> List<SectionCase> =
  [
    {
      sections: [
        { text: "ftp://", extended: false },
        { text: "cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar", extended: false },
      ],
      text: "ftp://cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar",
    },
    {
      sections: [
        { text: "us-ascii'en'This%20is%20even%20more%20", extended: true },
        { text: "%2A%2A%2Afun%2A%2A%2A%20", extended: true },
        { text: "isn't it!", extended: false },
      ],
      text: "This is even more ***fun*** isn't it!",
    },
    {
      sections: [
        { text: "UTF-8''%E2%82", extended: true },
        { text: "%AC%20rates", extended: true },
        { text: " 100%.txt", extended: false },
      ],
      text: "\u{20ac} rates 100%.txt",
    },
    { sections: [], text: "" },
    { sections: [{ text: "as written%20", extended: false }], text: "as written%20" },
  ]

test "`decode_sections` joins the numbered sections of an RFC 2231 parameter into the text {show(c.text)}" for c: SectionCase in section_cases(
  ) { assert_eq(decode_sections(c.sections), Ok(c.text)) }

test "`decode_sections` fails when the first section names no charset, or a later section is not valid in that charset" {
  let later = { text: "%41", extended: true };
  assert_eq(
    decode_sections([{ text: "plain", extended: false }, later]),
    Err({ at: 0, reason: NoCharset }),
  );
  assert_eq(
    decode_sections([{ text: "UTF-8'x", extended: true }, later]),
    Err({ at: 7, reason: NoCharset }),
  );
  assert_eq(
    decode_sections([{ text: "UTF-8''a", extended: true }, { text: "b%4", extended: true }]),
    Err({ at: 9, reason: BadText }),
  );
  assert_eq(
    decode_sections([
      { text: "US-ASCII''a", extended: true },
      { text: "caf\u{e9}", extended: false },
    ]),
    Err({ at: 11, reason: BadBytes }),
  );
  assert_eq(
    decode_sections([{ text: "UTF-8''%E2", extended: true }, { text: "%82", extended: true }]),
    Err({ at: 7, reason: BadBytes }),
  )
}

test "a value is split into sections between characters, the first naming UTF-8" {
  assert_eq(encode_sections("\u{20ac} rates.txt", 80), ["UTF-8''%E2%82%AC%20rates.txt"]);
  assert_eq(encode_sections("\u{20ac}\u{20ac}\u{20ac}", 20), [
    "UTF-8''%E2%82%AC",
    "%E2%82%AC%E2%82%AC",
  ]);
  assert_eq(encode_sections("", 80), ["UTF-8''"]);
  assert_eq(encode_sections("ab", 0), ["UTF-8''", "a", "b"])
}
