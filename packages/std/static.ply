//! Serves files from a root of `std.fs`, with HTTP conditional requests and byte ranges.
//!
//! `decide` chooses the response to a request as a pure function of the method, the request's
//! headers, and the file's length and validators. It returns `Whole` (200), `Partial` (206),
//! `NotModified` (304), `PreconditionFailed` (412) or `Unsatisfiable` (416). `If-Match` and
//! `If-Range` compare entity tags strongly, `If-None-Match` compares them weakly, and dates compare
//! to the whole second. `decide` returns `Whole`, the entire file, for a `Range` that does not
//! parse, uses a unit other than bytes, lists more ranges than the limit, or lists overlapping
//! ranges. HTTP allows this, and it stops a client from getting a response far larger than its
//! request by listing many overlapping ranges. A `Range` whose ranges all fall outside the file
//! gets 416.
//!
//! `serve` responds to `GET` and `HEAD` with the file that the request's path names under the root
//! `r`. The path is percent-decoded one segment at a time. `serve` returns 404 when a segment is
//! `.` or `..`, contains a `/`, a `\` or a NUL, or names a dotfile and `Options` does not allow
//! dotfiles. It never follows links on the path, so it serves only files and directories inside the
//! root. It never lists a directory: it serves the directory's index file when `Options` names one,
//! and returns 404 otherwise. `std.fs` also rejects any path that leaves the root. Each response
//! has a `Content-Type` header with the file's type, an `X-Content-Type-Options: nosniff` header
//! that stops browsers from guessing a different type, a strong entity tag (computed from the size
//! and the modification time), `Last-Modified`, `Date` and `Accept-Ranges: bytes`. A request for
//! several ranges gets one `multipart/byteranges` body, with a boundary drawn from `entropy`. The
//! body of a whole file or a single range is a stream that reads the file one chunk at a time as it
//! is sent, so a file of any size needs memory for only one chunk. A response to `HEAD` opens no
//! file.

import std.date
import std.date (OffsetDateTime)
import std.fs
import std.fs (fs)
import std.http
import std.http (Body, Headers, Method, Request, Response, Stream, Streamed)
import std.ip
import std.ip (ip)
import std.list
import std.math (abs, to_radix)
import std.mime
import std.multipart
import std.net
import std.net (Sends, net)
import std.random (entropy, rand, with_rand)
import std.seq
import std.seq (Seq)
import std.string
import std.time (nanos_at)
import std.url (url_decode)
import std.gen

/// An entity tag: its opaque text without the quotes, and whether it is weak.
pub type ETag = { weak: Bool, tag: String }

/// The tag as a header field writes it: `"text"`, or `W/"text"` for a weak one.
pub fn etag_text(e: ETag) -> String = (if e.weak { "W/" } else { "" }) ++ "\"" ++ e.tag ++ "\""

/// What an `If-Match` or an `If-None-Match` lists: `*`, or entity tags.
pub type ETagCondition = | AnyTag | Listed(List<ETag>)

/// Parses the entity tags listed in an `If-Match` or `If-None-Match` field. Returns `None` when the
/// field is not a valid list of tags or `*`.
pub fn read_tags(field: String) -> Option<ETagCondition> / {abort.raise} =
  if field.ascii_trim() == "*" { Some(AnyTag) } else {
    field.split(",").fold(Some(Listed([])), |accumulator: Option<ETagCondition>, piece: String|
      match accumulator {
        Some(Listed(tags)) -> match read_tag(piece.ascii_trim()) {
          Some(t) -> Some(Listed(tags.push(t))),
          None -> if piece.ascii_trim().len() == 0 { accumulator } else { None },
        },
        _ -> None,
      })
  }

fn read_tag(text: String) -> Option<ETag> / {abort.raise} = {
  let weak = text.starts_with("W/");
  let quoted = if weak { text.slice(2, text.len()) } else { text };
  let n = quoted.len();
  if n >= 2 && quoted.starts_with("\"") && quoted.ends_with("\"") {
    let inner = quoted.slice(1, n - 1);
    if inner.contains("\"") { None } else { Some({ weak: weak, tag: inner }) }
  } else { None }
}

/// Whether two tags match strongly: both strong, and the same text.
pub fn strong_match(a: ETag, b: ETag) -> Bool = !a.weak && !b.weak && a.tag == b.tag

/// Whether two tags match weakly: the same text, either weak or not.
pub fn weak_match(a: ETag, b: ETag) -> Bool = a.tag == b.tag

/// The parts of a representation that preconditions check: its entity tag and when it last
/// changed, if it has them.
pub type Validators = { etag: Option<ETag>, modified: Option<OffsetDateTime> }

/// A range of bytes resolved against a representation's length: its first and its last byte.
pub type ByteRange = { first: Int, last: Int }

/// The response a request for a representation gets.
pub type Decision =
  /// 200: the whole representation.
  | Whole
  /// 206: these ranges of it, in the order requested, none overlapping.
  | Partial(List<ByteRange>)
  /// 304: the client's copy is current.
  | NotModified
  /// 412: a precondition the client set is false.
  | PreconditionFailed
  /// 416: none of the requested ranges fall inside the representation.
  | Unsatisfiable

/// The HTTP status of a decision.
pub fn status_of(d: Decision) -> Int =
  match d {
    Whole -> 200,
    Partial(_) -> 206,
    NotModified -> 304,
    PreconditionFailed -> 412,
    Unsatisfiable -> 416,
  }

/// Decides the response to a request with `method` and `headers` for a file of `length` bytes whose
/// validators are `v`. If the `Range` header lists more than `max_ranges` ranges, the response is
/// `Whole` instead of `Partial`. `now` is the current time, used to interpret dates in the headers
/// that give a two-digit year.
pub fn decide(
  method: Method,
  headers: Headers,
  v: Validators,
  length: Int,
  max_ranges: Int,
  now: Instant,
) -> Decision / {abort.raise} =
  if !if_match_satisfied(headers, v) || !unmodified_since_satisfied(headers, v, now) {
    PreconditionFailed
  } else {
    match none_match_satisfied(headers, v) {
      Some(false) -> if is_safe(method) { NotModified } else { PreconditionFailed },
      Some(true) -> range_decision(method, headers, v, length, max_ranges, now),
      None -> if is_safe(method) && !modified_since_satisfied(headers, v, now) { NotModified }
      else { range_decision(method, headers, v, length, max_ranges, now) },
    }
  }

fn is_safe(m: Method) -> Bool = m == http::Get || m == http::Head

fn if_match_satisfied(headers: Headers, v: Validators) -> Bool / {abort.raise} =
  match http::header(headers, "if-match") {
    None -> true,
    Some(field) -> match read_tags(field) {
      Some(AnyTag) -> true,
      Some(Listed(tags)) -> match v.etag {
        Some(own) -> tags.any(|t: ETag| strong_match(t, own)),
        None -> false,
      },
      None -> false,
    },
  }

fn unmodified_since_satisfied(headers: Headers, v: Validators, now: Instant) -> Bool =
  if http::has_header(headers, "if-match") { true } else {
    match ((http::date_field(headers, "if-unmodified-since", now), v.modified)) {
      (Some(at), Some(modified)) -> seconds_of(modified) <= seconds_of(at),
      _ -> true,
    }
  }

fn none_match_satisfied(headers: Headers, v: Validators) -> Option<Bool> / {abort.raise} =
  match http::header(headers, "if-none-match") {
    None -> None,
    Some(field) -> match read_tags(field) {
      Some(AnyTag) -> Some(false),
      Some(Listed(tags)) -> match v.etag {
        Some(own) -> Some(!tags.any(|t: ETag| weak_match(t, own))),
        None -> Some(true),
      },
      None -> Some(true),
    },
  }

fn modified_since_satisfied(headers: Headers, v: Validators, now: Instant) -> Bool =
  match ((http::date_field(headers, "if-modified-since", now), v.modified)) {
    (Some(at), Some(modified)) -> seconds_of(modified) > seconds_of(at),
    _ -> true,
  }

fn seconds_of(o: OffsetDateTime) -> Int = date::unix_seconds(o)

fn range_decision(
  method: Method,
  headers: Headers,
  v: Validators,
  length: Int,
  max_ranges: Int,
  now: Instant,
) -> Decision / {abort.raise} =
  if method != http::Get { Whole } else {
    match http::header(headers, "range") {
      None -> Whole,
      Some(field) -> if !if_range_satisfied(headers, v, now) { Whole } else {
        match read_ranges(field, length, max_ranges) {
          None -> Whole,
          Some([]) -> Unsatisfiable,
          Some(ranges) -> Partial(ranges),
        }
      },
    }
  }

fn if_range_satisfied(headers: Headers, v: Validators, now: Instant) -> Bool / {abort.raise} =
  match http::header(headers, "if-range") {
    None -> true,
    Some(field) -> if field.ascii_trim().starts_with("\"") || field.ascii_trim().starts_with("W/") {
      match ((read_tag(field.ascii_trim()), v.etag)) {
        (Some(t), Some(own)) -> strong_match(t, own),
        _ -> false,
      }
    } else {
      match ((date::parse_http_date(field, now), v.modified)) {
        (Some(at), Some(modified)) -> seconds_of(at) == seconds_of(modified),
        _ -> false,
      }
    },
  }

/// The ranges a `Range` field requests of `length` bytes, resolved and in the order requested,
/// leaving out those that fall entirely outside the representation. `None` when the field must be
/// ignored: it does not parse, names another unit, or requests more than `max_ranges` ranges or
/// overlapping ranges.
pub fn read_ranges(
  field: String,
  length: Int,
  max_ranges: Int,
) -> Option<List<ByteRange>> / {abort.raise} =
  if !field.starts_with("bytes=") { None } else {
    let specs = field.slice(6, field.len()).split(",");
    if specs.len() > max_ranges { None } else {
      let resolved = specs.fold(Some([]), |accumulator: Option<List<ByteRange>>, spec: String|
        match accumulator {
          None -> None,
          Some(find_file) -> match resolve_range_spec(spec.ascii_trim(), length) {
            InBounds(r) -> Some(find_file.push(r)),
            PastEnd -> Some(find_file),
            Malformed -> None,
          },
        });
      match resolved {
        Some(ranges) -> if overlapping(ranges) { None } else { Some(ranges) },
        None -> None,
      }
    }
  }

type RangeResolution = | InBounds(ByteRange) | PastEnd | Malformed

fn resolve_range_spec(spec: String, length: Int) -> RangeResolution / {abort.raise} = {
  let b = Bytes::of_string(spec);
  match b.index_of(b"-") {
    None -> Malformed,
    Some(at) -> {
      let first = digits_of(spec.slice(0, at));
      let last = digits_of(spec.slice(at + 1, spec.len()));
      match ((at == 0, first, last)) {
        (true, _, Some(n)) -> if n == 0 || length == 0 { PastEnd }
        else { InBounds({ first: max(length - n, 0), last: length - 1 }) },
        (false, Some(a), None) -> if spec.len() == at + 1 {
          if a >= length { PastEnd } else { InBounds({ first: a, last: length - 1 }) }
        } else { Malformed },
        (false, Some(a), Some(z)) -> if a > z { Malformed }
        else if a >= length { PastEnd }
        else { InBounds({ first: a, last: min(z, length - 1) }) },
        _ -> Malformed,
      }
    },
  }
}

fn digits_of(text: String) -> Option<Int> / {abort.raise} = {
  let b = Bytes::of_string(text);
  if b.len() == 0 || b.len() > 18
      || !range(0, b.len()).fold(true, |ok: Bool, i: Int|
        ok && b.at(i) >= 0x30 && b.at(i) <= 0x39) { None }
  else { text.int_of_string() }
}

fn overlapping(ranges: List<ByteRange>) -> Bool = {
  let sorted = ranges.sort_by(|a: ByteRange, b: ByteRange| a.first < b.first);
  sorted.fold(
    { last: -1, overlaps: false },
    |s: { last: Int, overlaps: Bool }, r: ByteRange|
      { last: max(s.last, r.last), overlaps: s.overlaps || r.first <= s.last },
  ).overlaps
}

/// Settings for `serve`.
pub type Options = {
  /// The file served for a directory's path; with `None`, a directory gets 404.
  index: Option<String>,
  /// Whether a path with a segment that begins with `.` is served.
  dotfiles: Bool,
  /// The most ranges one request can get as ranges.
  max_ranges: Int,
  /// The `Cache-Control` sent with each file, if any.
  cache_control: Option<String>,
  /// The most bytes one read of a file takes.
  chunk: Int,
}

/// `index.html` for a directory, no dotfile, sixteen ranges, no `Cache-Control`, and reads of
/// 1 MiB.
pub const default_options: Options =
  {
    index: Some("index.html"),
    dotfiles: false,
    max_ranges: 16,
    cache_control: None,
    chunk: 1048576,
  }

/// The path under the root that a request's `path` names, percent-decoded. `None` when it names
/// nothing `serve` would serve: a segment that is `.` or `..`, contains `/`, `\` or a NUL once
/// decoded, does not decode, or begins with `.` unless `dotfiles` is set. Empty segments are
/// skipped; the root is `.`.
pub fn file_path(path: String, dotfiles: Bool) -> Option<String> / {abort.raise} =
  if !path.starts_with("/") { None } else {
    let decoded = path.split("/").fold(
      Some([]),
      |accumulator: Option<List<String>>, seg: String|
        match accumulator {
          None -> None,
          Some(segs) -> if seg.len() == 0 { accumulator } else {
            match url_decode(seg) {
              Some(d) -> if segment_served(d, dotfiles) { Some(segs.push(d)) } else { None },
              None -> None,
            }
          },
        },
    );
    match decoded {
      Some([]) -> Some("."),
      Some(segs) ->
        Some(
          segs.fold("", |accumulator: String, s: String|
            if accumulator.len() == 0 { s } else { accumulator ++ "/" ++ s }),
        ),
      None -> None,
    }
  }

fn segment_served(seg: String, dotfiles: Bool) -> Bool =
  seg != "." && seg != ".." && !seg.contains("/") && !seg.contains("\\") && !seg.contains("\u{0}")
    && (dotfiles || !seg.starts_with("."))

/// The strong entity tag `serve` gives a file: its size and its modification time in hex.
pub fn file_etag(size: Int, modified: Instant) -> ETag / {abort.raise} =
  { weak: false, tag: to_radix(size, 16) ++ "-" ++ to_radix(max(nanos_at(modified), 0), 16) }

/// The response to `request` from the file that `path` names under the root `r`. `path` is the part of
/// the request's path below where the files are served, as the request wrote it. `now` is the
/// wall-clock time, used for `Date` and for reading the client's dates. The body is a stream of the
/// file's length, read through a handle `Options.chunk` bytes at a time as it is sent; a range is
/// read with `read_at`. If the file becomes shorter than its length when it was looked up, or
/// changes, the stream ends early and its connection is closed. A response to `HEAD` opens nothing.
pub fn serve<[r] | s>(
  request: Request,
  path: String,
  options: Options,
  now: OffsetDateTime,
) -> Response<| {fs.read_chunk[r], fs.read_at[r], fs.close[r], abort.raise | s}> / {fs.kind[r], fs.stat[r], fs.open[r], fs.read_at[r], entropy.next, abort.raise} =
  if request.method != http::Get && request.method != http::Head {
    http::dated(http::method_not_allowed([http::Get, http::Head]), now)
  } else {
    match file_path(path, options.dotfiles) {
      None -> not_found(now),
      Some(under) -> match find_file[r](under, options) {
        None -> not_found(now),
        Some(file) -> file_response[r](request, file, options, now),
      },
    }
  }

fn not_found<| e>(now: OffsetDateTime) -> Response<| e> =
  http::dated(http::text_response(404, "there is no such file\n"), now)

type FoundFile = { path: String, stat: fs::Stat }

fn find_file<[r]>(under: String, options: Options) -> Option<FoundFile> / {fs.kind[r], fs.stat[r]} =
  if !has_no_symlink[r](under) { None } else {
    match fs.stat[r](under) {
      Some(s) -> if s.kind == fs::File { Some({ path: under, stat: s }) }
      else if s.kind == fs::Dir {
        match options.index {
          Some(name) -> {
            let index = if under == "." { name } else { under ++ "/" ++ name };
            match fs.stat[r](index) {
              Some(i) -> if i.kind == fs::File { Some({ path: index, stat: i }) } else { None },
              None -> None,
            }
          },
          None -> None,
        }
      } else { None },
      None -> None,
    }
  }

fn has_no_symlink<[r]>(under: String) -> Bool / {fs.kind[r]} =
  if under == "." { true } else {
    under.split("/").fold({ at: "", ok: true }, |s: { at: String, ok: Bool }, seg: String| {
      let at = if s.at.len() == 0 { seg } else { s.at ++ "/" ++ seg };
      { at: at, ok: s.ok && fs.kind[r](at) != fs::Symlink }
    }).ok
  }

fn file_response<[r] | s>(
  request: Request,
  file: FoundFile,
  options: Options,
  now: OffsetDateTime,
) -> Response<| {fs.read_chunk[r], fs.read_at[r], fs.close[r], abort.raise | s}> / {fs.open[r], fs.read_at[r], entropy.next, abort.raise} = {
  let tag = file_etag(file.stat.size, file.stat.modified);
  let modified = date::of_instant(file.stat.modified);
  let v = { etag: Some(tag), modified: Some(modified) };
  let kind = match mime::of_path(file.path) {
    Some(m) -> mime::render(m),
    None -> "application/octet-stream",
  };
  let wall = match date::instant(now) { Some(i) -> i, None -> Instant(0) };
  let base_response = base_response(tag, modified, options, now);
  match decide(request.method, request.headers, v, file.stat.size, options.max_ranges, wall) {
    NotModified -> { ..base_response, status: 304 },
    PreconditionFailed -> { ..base_response, status: 412 },
    Unsatisfiable ->
      {
        ..base_response,
        status: 416,
        headers: http::set_header(
          base_response.headers,
          "content-range",
          "bytes */" ++ file.stat.size.to_string(),
        ),
      },
    Whole -> {
      let typed = http::set_header(base_response.headers, "content-type", kind);
      if request.method == http::Head {
        { ..base_response, headers: typed, body: head_body[r](file.stat.size) }
      } else {
        match fs.open[r](file.path, fs::ToRead) {
          Err(_) -> file_changed_response(now),
          Ok(opened) ->
            {
              ..base_response,
              headers: typed,
              body: file_body[r](opened, file.stat.size, options.chunk),
            },
        }
      }
    },
    Partial([one]) ->
      {
        status: 206,
        headers: http::set_header(
          http::set_header(base_response.headers, "content-type", kind),
          "content-range",
          content_range(one, file.stat.size),
        ),
        body: range_body[r](file.path, one, options.chunk),
      },
    Partial(ranges) ->
      byteranges[r](file.path, ranges, file.stat.size, kind, base_response, options.chunk, now),
  }
}

fn head_body<[r] | s>(
  size: Int,
) -> Body<| {fs.read_chunk[r], fs.read_at[r], fs.close[r], abort.raise | s}> = {
  let stream: Stream<| {fs.read_chunk[r], fs.read_at[r], fs.close[r], abort.raise | s}> = {
    length: Some(size),
    chunks: seq::empty(),
    close: || (),
  };
  Streamed(stream)
}

fn file_body<[r] | s>(
  f: Int,
  size: Int,
  chunk: Int,
) -> Body<| {fs.read_chunk[r], fs.read_at[r], fs.close[r], abort.raise | s}> = {
  let stream: Stream<| {fs.read_chunk[r], fs.read_at[r], fs.close[r], abort.raise | s}> = {
    length: Some(size),
    chunks: file_chunks[r](f, size, chunk),
    close: || {
      fs.close[r](f);
      ()
    },
  };
  Streamed(stream)
}

fn range_body<[r] | s>(
  path: String,
  range: ByteRange,
  chunk: Int,
) -> Body<| {fs.read_chunk[r], fs.read_at[r], fs.close[r], abort.raise | s}> = {
  let stream: Stream<| {fs.read_chunk[r], fs.read_at[r], fs.close[r], abort.raise | s}> = {
    length: Some(range.last - range.first + 1),
    chunks: ranged_chunks[r](path, range, chunk),
    close: || (),
  };
  Streamed(stream)
}

fn file_chunks<[r] | e>(
  f: Int,
  size: Int,
  chunk: Int,
) -> Seq<Bytes | {fs.read_chunk[r], fs.read_at[r], fs.close[r], abort.raise | e}> = {
  let step: (Int) -> Option<{ value: Bytes, next: Int }> / {fs.read_chunk[r], fs.read_at[r], fs.close[r], abort.raise | e} = |sent: Int|
    if sent >= size { None } else {
      match fs.read_chunk[r](f, min(chunk, size - sent)) {
        Some(b) -> if b.len() == 0 { None } else { Some({ value: b, next: sent + b.len() }) },
        None -> None,
      }
    };
  seq::unfold(0, step)
}

fn ranged_chunks<[r] | e>(
  path: String,
  range: ByteRange,
  chunk: Int,
) -> Seq<Bytes | {fs.read_chunk[r], fs.read_at[r], fs.close[r], abort.raise | e}> = {
  let want = range.last - range.first + 1;
  let step: (Int) -> Option<{ value: Bytes, next: Int }> / {fs.read_chunk[r], fs.read_at[r], fs.close[r], abort.raise | e} = |sent: Int|
    if sent >= want { None } else {
      match fs.read_at[r](path, range.first + sent, min(chunk, want - sent)) {
        Some(b) -> if b.len() == 0 { None } else { Some({ value: b, next: sent + b.len() }) },
        None -> None,
      }
    };
  seq::unfold(0, step)
}

fn base_response<| e>(
  tag: ETag,
  modified: OffsetDateTime,
  options: Options,
  now: OffsetDateTime,
) -> Response<| e> = {
  let base = http::last_modified(http::dated(http::response(200, b""), now), modified);
  let fields = http::set_header(
    http::set_header(
      http::set_header(base.headers, "etag", etag_text(tag)),
      "accept-ranges",
      "bytes",
    ),
    "x-content-type-options",
    "nosniff",
  );
  match options.cache_control {
    Some(c) -> { ..base, headers: http::set_header(fields, "cache-control", c) },
    None -> { ..base, headers: fields },
  }
}

fn content_range(r: ByteRange, size: Int) -> String =
  "bytes " ++ r.first.to_string() ++ "-" ++ r.last.to_string() ++ "/" ++ size.to_string()

fn file_changed_response<| e>(now: OffsetDateTime) -> Response<| e> =
  http::dated(http::text_response(503, "the file changed while it was read\n"), now)

fn byteranges<[r] | e>(
  path: String,
  ranges: List<ByteRange>,
  size: Int,
  kind: String,
  base_response: Response<| e>,
  chunk: Int,
  now: OffsetDateTime,
) -> Response<| e> / {fs.read_at[r], entropy.next, abort.raise} = {
  let parts = ranges.fold(Some([]), |accumulator: Option<List<multipart::Part>>, r: ByteRange|
    match accumulator {
      None -> None,
      Some(done) -> match range_bytes[r](path, r, chunk) {
        Some(b) ->
          Some(
            done.push(
              multipart::part(
                [
                  { name: "Content-Type", value: kind },
                  { name: "Content-Range", value: content_range(r, size) },
                ],
                b,
              ),
            ),
          ),
        None -> None,
      },
    });
  let boundary = multipart::fresh_boundary();
  match parts {
    None -> file_changed_response(now),
    Some(ps) -> match multipart::build(ps, boundary) {
      Ok(body) ->
        {
          status: 206,
          headers: http::set_header(
            base_response.headers,
            "content-type",
            "multipart/byteranges; boundary=" ++ boundary,
          ),
          body: http::Whole(body),
        },
      Err(_) -> file_changed_response(now),
    },
  }
}

fn range_bytes<[r]>(
  path: String,
  r: ByteRange,
  chunk: Int,
) -> Option<Bytes> / {fs.read_at[r], abort.raise} = {
  let want = r.last - r.first + 1;
  iterate({ got: [], total: 0 }, want + 2, |s: { got: List<Bytes>, total: Int }|
    if s.total >= want { Stop(Some(Bytes::concat_all(s.got))) } else {
      match fs.read_at[r](path, r.first + s.total, min(chunk, want - s.total)) {
        None -> Stop(None),
        Some(b) -> if b.len() == 0 { Stop(None) }
        else { Continue({ got: s.got.push(b), total: s.total + b.len() }) },
      }
    })
}

fn tag(text: String) -> ETag = { weak: false, tag: text }

fn at_second(s: Int) -> OffsetDateTime / {abort.raise} =
  match date::of_unix_seconds(s) { Some(o) -> o, None -> panic("a date") }

fn fields(pairs: List<{ name: String, value: String }>) -> Headers =
  pairs.fold(http::empty_headers, |h: Headers, p: { name: String, value: String }|
    http::add_header(h, p.name, p.value))

const resource: Validators = { etag: Some(tag("v1")), modified: Some(at_second(1700000000)) }

const today: Instant = Instant(1700000100000000000)

test "every range `read_ranges` returns for a Range field lies within the file's length" {
  gen::check3(gen::any_int(), gen::any_int(), gen::any_int(), |a: Int, b: Int, length: Int| {
    let first = abs(a % 2000);
    let last = abs(b % 2000);
    let n = abs(length % 1000);
    match read_ranges("bytes=" ++ first.to_string() ++ "-" ++ last.to_string(), n, 16) {
      Some(ranges) ->
        first <= last && ranges.all(|r: ByteRange| 0 <= r.first && r.first <= r.last && r.last < n),
      None -> first > last,
    }
  })
}

test "entity tags are read from a field, and compared strongly or weakly" {
  assert_eq(
    read_tags("\"a\", W/\"b\" ,\"\""),
    Some(Listed([{ weak: false, tag: "a" }, { weak: true, tag: "b" }, { weak: false, tag: "" }])),
  );
  assert_eq(read_tags(" * "), Some(AnyTag));
  assert_eq(read_tags("a"), None);
  assert_eq(read_tags("\"a\"b\""), None);
  assert(strong_match(tag("a"), tag("a")));
  assert(!strong_match({ weak: true, tag: "a" }, tag("a")));
  assert(weak_match({ weak: true, tag: "a" }, tag("a")));
  assert(!weak_match(tag("a"), tag("b")));
  assert_eq(etag_text({ weak: true, tag: "x" }), "W/\"x\"")
}

test "for {c.what}, checking RFC 9110 preconditions in order returns the expected decision" for c: { what: String, method: Method, fields: List<{ name: String, value: String }>, decision: Decision } in [
    { what: "nothing asked", method: http::Get, fields: [], decision: Whole },
    {
      what: "If-Match that matches",
      method: http::Put,
      fields: [{ name: "If-Match", value: "\"v1\"" }],
      decision: Whole,
    },
    {
      what: "If-Match *",
      method: http::Put,
      fields: [{ name: "If-Match", value: "*" }],
      decision: Whole,
    },
    {
      what: "If-Match of another tag",
      method: http::Put,
      fields: [{ name: "If-Match", value: "\"v0\"" }],
      decision: PreconditionFailed,
    },
    {
      what: "If-Match of a weak tag",
      method: http::Get,
      fields: [{ name: "If-Match", value: "W/\"v1\"" }],
      decision: PreconditionFailed,
    },
    {
      what: "If-Unmodified-Since before the change",
      method: http::Put,
      fields: [{ name: "If-Unmodified-Since", value: "Tue, 14 Nov 2023 22:13:19 GMT" }],
      decision: PreconditionFailed,
    },
    {
      what: "If-Unmodified-Since at the change",
      method: http::Put,
      fields: [{ name: "If-Unmodified-Since", value: "Tue, 14 Nov 2023 22:13:20 GMT" }],
      decision: Whole,
    },
    {
      what: "If-Match wins over If-Unmodified-Since",
      method: http::Put,
      fields: [
        { name: "If-Match", value: "\"v1\"" },
        { name: "If-Unmodified-Since", value: "Tue, 14 Nov 2023 22:13:19 GMT" },
      ],
      decision: Whole,
    },
    {
      what: "If-None-Match of the tag",
      method: http::Get,
      fields: [{ name: "If-None-Match", value: "\"x\", W/\"v1\"" }],
      decision: NotModified,
    },
    {
      what: "If-None-Match on a PUT",
      method: http::Put,
      fields: [{ name: "If-None-Match", value: "*" }],
      decision: PreconditionFailed,
    },
    {
      what: "If-None-Match of another tag",
      method: http::Head,
      fields: [{ name: "If-None-Match", value: "\"v0\"" }],
      decision: Whole,
    },
    {
      what: "If-Modified-Since at the change",
      method: http::Get,
      fields: [{ name: "If-Modified-Since", value: "Tue, 14 Nov 2023 22:13:20 GMT" }],
      decision: NotModified,
    },
    {
      what: "If-Modified-Since before the change",
      method: http::Get,
      fields: [{ name: "If-Modified-Since", value: "Tue, 14 Nov 2023 22:13:19 GMT" }],
      decision: Whole,
    },
    {
      what: "If-None-Match wins over If-Modified-Since",
      method: http::Get,
      fields: [
        { name: "If-None-Match", value: "\"v0\"" },
        { name: "If-Modified-Since", value: "Tue, 14 Nov 2023 22:13:20 GMT" },
      ],
      decision: Whole,
    },
    {
      what: "If-Modified-Since on a POST",
      method: http::Post,
      fields: [{ name: "If-Modified-Since", value: "Tue, 14 Nov 2023 22:13:20 GMT" }],
      decision: Whole,
    },
    {
      what: "If-Modified-Since that does not read",
      method: http::Get,
      fields: [{ name: "If-Modified-Since", value: "yesterday" }],
      decision: Whole,
    },
    {
      what: "a range",
      method: http::Get,
      fields: [{ name: "Range", value: "bytes=0-9" }],
      decision: Partial([{ first: 0, last: 9 }]),
    },
    {
      what: "a range on a HEAD",
      method: http::Head,
      fields: [{ name: "Range", value: "bytes=0-9" }],
      decision: Whole,
    },
    {
      what: "a range under an If-Range that matches",
      method: http::Get,
      fields: [{ name: "Range", value: "bytes=-5" }, { name: "If-Range", value: "\"v1\"" }],
      decision: Partial([{ first: 95, last: 99 }]),
    },
    {
      what: "a range under an If-Range of another tag",
      method: http::Get,
      fields: [{ name: "Range", value: "bytes=-5" }, { name: "If-Range", value: "\"v0\"" }],
      decision: Whole,
    },
    {
      what: "a range under a weak If-Range",
      method: http::Get,
      fields: [{ name: "Range", value: "bytes=-5" }, { name: "If-Range", value: "W/\"v1\"" }],
      decision: Whole,
    },
    {
      what: "a range under an If-Range of the date",
      method: http::Get,
      fields: [
        { name: "Range", value: "bytes=10-" },
        { name: "If-Range", value: "Tue, 14 Nov 2023 22:13:20 GMT" },
      ],
      decision: Partial([{ first: 10, last: 99 }]),
    },
    {
      what: "a range past the end",
      method: http::Get,
      fields: [{ name: "Range", value: "bytes=100-200" }],
      decision: Unsatisfiable,
    },
    {
      what: "a range before a precondition that fails",
      method: http::Get,
      fields: [{ name: "Range", value: "bytes=0-1" }, { name: "If-None-Match", value: "\"v1\"" }],
      decision: NotModified,
    },
  ] {
  assert_eq(decide(c.method, fields(c.fields), resource, 100, 16, today), c.decision);
  assert_eq(status_of(c.decision), match c.decision {
    Whole -> 200,
    Partial(_) -> 206,
    NotModified -> 304,
    PreconditionFailed -> 412,
    Unsatisfiable -> 416,
  })
}

test "`read_ranges` returns the byte ranges of the Range field {c.field} clamped to the file length, or none when it is invalid" for c: { field: String, ranges: Option<List<ByteRange>> } in [
    { field: "bytes=0-0", ranges: Some([{ first: 0, last: 0 }]) },
    { field: "bytes=5-500", ranges: Some([{ first: 5, last: 99 }]) },
    { field: "bytes=-1000", ranges: Some([{ first: 0, last: 99 }]) },
    { field: "bytes=0-9, 20-29", ranges: Some([{ first: 0, last: 9 }, { first: 20, last: 29 }]) },
    { field: "bytes=200-300, 0-1", ranges: Some([{ first: 0, last: 1 }]) },
    { field: "bytes=-0", ranges: Some([]) },
    { field: "bytes=0-9, 5-14", ranges: None },
    { field: "bytes=9-0", ranges: None },
    { field: "bytes=a-b", ranges: None },
    { field: "bytes=", ranges: None },
    { field: "items=0-9", ranges: None },
    { field: "bytes=0-1,2-3,4-5", ranges: None },
  ] { assert_eq(read_ranges(c.field, 100, 2), c.ranges) }

test "`file_path` maps the request path {c.path} to a path under the root, or to none when it is unsafe" for c: { path: String, dotfiles: Bool, under: Option<String> } in [
    { path: "/", dotfiles: false, under: Some(".") },
    { path: "/css/site.css", dotfiles: false, under: Some("css/site.css") },
    { path: "/a%20b/c%2Ed", dotfiles: false, under: Some("a b/c.d") },
    { path: "//css///site.css", dotfiles: false, under: Some("css/site.css") },
    { path: "/../etc/passwd", dotfiles: false, under: None },
    { path: "/%2e%2e/etc/passwd", dotfiles: false, under: None },
    { path: "/a/%2Fb", dotfiles: false, under: None },
    { path: "/a/..%5Cb", dotfiles: false, under: None },
    { path: "/a%00", dotfiles: false, under: None },
    { path: "/a/./b", dotfiles: false, under: None },
    { path: "/.env", dotfiles: false, under: None },
    { path: "/.well-known/x", dotfiles: true, under: Some(".well-known/x") },
    { path: "/%zz", dotfiles: false, under: None },
    { path: "relative", dotfiles: false, under: None },
  ] { assert_eq(file_path(c.path, c.dotfiles), c.under) }

fn sample_files() -> fs::MemFs / {abort.raise} = {
  let tree = fs::mem_of([
    { path: "index.html", body: b"<h1>parts</h1>" },
    { path: "css/site.css", body: b"body{}" },
    { path: "data/parts.csv", body: b"0123456789abcdefghij" },
    { path: "empty/readme.txt", body: b"" },
    { path: ".env", body: b"SECRET=1" },
  ]);
  let stamped = fs::mem_set_modified(
    fs::mem_set_modified(
      fs::mem_set_modified(tree, "index.html", 1700000000000).fs,
      "data/parts.csv",
      1700000000000,
    ).fs,
    "css/site.css",
    1700000000000,
  ).fs;
  fs::mem_symlink(stamped, "escape", "data").fs
}

const noon: OffsetDateTime = at_second(1700000100)

type ReadResponse = { status: Int, headers: Headers, body: Bytes, length: Option<Int> }

fn fetch(
  method: Method,
  path: String,
  pairs: List<{ name: String, value: String }>,
  options: Options,
) -> ReadResponse / {abort.raise} = {
  let bare = http::request_to(method, "example.org", path, b"");
  let request = { ..bare, headers: fields(pairs) };
  with_rand(rand(7), ||
    fs::on_mem[site](sample_files(), || {
      let r = serve[site](request, request.path, options, noon);
      {
        status: r.status,
        headers: r.headers,
        length: http::body_length(r.body),
        body: match http::collect_body(r.body, 1048576) {
          Some(b) -> b,
          None -> panic("a site file must be smaller than 1 MiB"),
        },
      }
    }).value).value
}

test "a served file's response has content type, last-modified, entity tag and range-support headers" {
  let r = fetch(http::Get, "/css/site.css", [], default_options);
  assert_eq(r.status, 200);
  assert_eq(r.body, b"body{}");
  assert_eq(http::header(r.headers, "content-type"), Some("text/css"));
  assert_eq(http::header(r.headers, "x-content-type-options"), Some("nosniff"));
  assert_eq(http::header(r.headers, "accept-ranges"), Some("bytes"));
  assert_eq(http::header(r.headers, "last-modified"), Some("Tue, 14 Nov 2023 22:13:20 GMT"));
  assert_eq(http::header(r.headers, "date"), Some("Tue, 14 Nov 2023 22:15:00 GMT"));
  assert_eq(
    http::header(r.headers, "etag"),
    Some(etag_text(file_etag(6, Instant(1700000000000000000)))),
  );
  let root = fetch(http::Get, "/", [], default_options);
  assert_eq((root.status, root.body), (200, b"<h1>parts</h1>"));
  assert_eq(http::header(root.headers, "content-type"), Some("text/html"))
}

test "a client whose copy is current gets 304, and one whose copy is stale gets the file" {
  let first = fetch(http::Get, "/css/site.css", [], default_options);
  let etag = match http::header(first.headers, "etag") { Some(e) -> e, None -> "" };
  let again = fetch(
    http::Get,
    "/css/site.css",
    [{ name: "If-None-Match", value: etag }],
    default_options,
  );
  assert_eq((again.status, again.body), (304, b""));
  assert_eq(http::header(again.headers, "etag"), Some(etag));
  let dated = fetch(
    http::Get,
    "/css/site.css",
    [{ name: "If-Modified-Since", value: "Tue, 14 Nov 2023 22:13:20 GMT" }],
    default_options,
  );
  assert_eq(dated.status, 304);
  let stale = fetch(
    http::Get,
    "/css/site.css",
    [{ name: "If-None-Match", value: "\"0-0\"" }],
    default_options,
  );
  assert_eq((stale.status, stale.body), (200, b"body{}"));
  let guarded = fetch(
    http::Get,
    "/css/site.css",
    [{ name: "If-Match", value: "\"0-0\"" }],
    default_options,
  );
  assert_eq(guarded.status, 412)
}

test "ranges of a file are served one or several at a time, and ranges past its end are rejected" {
  let one = fetch(
    http::Get,
    "/data/parts.csv",
    [{ name: "Range", value: "bytes=2-5" }],
    default_options,
  );
  assert_eq((one.status, one.body), (206, b"2345"));
  assert_eq(http::header(one.headers, "content-range"), Some("bytes 2-5/20"));
  let tail = fetch(http::Get, "/data/parts.csv", [{ name: "Range", value: "bytes=-3" }], {
    ..default_options,
    chunk: 2,
  });
  assert_eq(tail.body, b"hij");
  let two = fetch(
    http::Get,
    "/data/parts.csv",
    [{ name: "Range", value: "bytes=0-1, 18-19" }],
    default_options,
  );
  assert_eq(two.status, 206);
  let kind = match http::header(two.headers, "content-type") { Some(k) -> k, None -> "" };
  assert(kind.starts_with("multipart/byteranges; boundary="));
  let boundary = kind.slice("multipart/byteranges; boundary=".len(), kind.len());
  match multipart::parse(two.body, boundary, multipart::default_limits) {
    Ok(parts) -> {
      assert_eq(parts.map(|p: multipart::Part| p.data), [b"01", b"ij"]);
      assert_eq(parts.map(|p: multipart::Part| multipart::header(p, "content-range")), [
        Some("bytes 0-1/20"),
        Some("bytes 18-19/20"),
      ])
    },
    Err(_) -> panic("a byteranges body reads as parts"),
  };
  let beyond = fetch(
    http::Get,
    "/data/parts.csv",
    [{ name: "Range", value: "bytes=20-" }],
    default_options,
  );
  assert_eq(beyond.status, 416);
  assert_eq(http::header(beyond.headers, "content-range"), Some("bytes */20"));
  let many = fetch(
    http::Get,
    "/data/parts.csv",
    [{ name: "Range", value: "bytes=0-0,2-2,4-4" }],
    { ..default_options, max_ranges: 2 },
  );
  assert_eq((many.status, many.body), (200, b"0123456789abcdefghij"))
}

test "a request for {c.path} returns 200 for a served file and 404 for anything outside the served files" for c: { path: String, status: Int } in [
    { path: "/.env", status: 404 },
    { path: "/escape/parts.csv", status: 404 },
    { path: "/../index.html", status: 404 },
    { path: "/data", status: 404 },
    { path: "/missing.txt", status: 404 },
    { path: "/data/parts.csv", status: 200 },
  ] { assert_eq(fetch(http::Get, c.path, [], default_options).status, c.status) }

test "on one connection, a range request gets a 206 partial response and a request with a matching ETag gets 304 Not Modified" {
  let etag = etag_text(file_etag(20, Instant(1700000000000000000)));
  let requests = Bytes::of_string(
    "GET /data/parts.csv HTTP/1.1\r\nHost: x\r\nRange: bytes=0-3\r\n\r\n"
      ++ "GET /data/parts.csv HTTP/1.1\r\nHost: x\r\nIf-None-Match: "
      ++ etag
      ++ "\r\nConnection: close\r\n\r\n",
  );
  let ran = net::on_mem(
    net::mem_calling(net::mem_empty(), ip::read_socket("198.51.100.4:5000"), [Sends(requests)]),
    ||
      with_rand(rand(7), ||
        fs::on_mem[site](sample_files(), || {
          let listener = net.listen[listener](0);
          http::serve_connection[conn](
            net.accept[listener](listener),
            http::default_limits,
            |request: Request| serve[site](request, request.path, default_options, noon),
          )
        }).value).value,
  );
  let wire = String::of_bytes_lossy(net::mem_sent(ran.net, 2));
  let second = wire.find("HTTP/1.1 304 Not Modified\r\n");
  assert(wire.starts_with("HTTP/1.1 206 Partial Content\r\n"));
  assert(wire.slice(0, second).contains("content-range: bytes 0-3/20\r\n"));
  assert(wire.slice(0, second).ends_with("\r\n\r\n0123"));
  assert(wire.slice(second, wire.len()).contains("etag: " ++ etag ++ "\r\n"));
  assert(wire.ends_with("Connection: close\r\n\r\n"))
}

test "a file is read in chunks of the requested size, and a HEAD response has the length a GET would but reads no file data" {
  let small = fetch(http::Get, "/data/parts.csv", [], { ..default_options, chunk: 3 });
  assert_eq((small.body, small.length), (b"0123456789abcdefghij", Some(20)));
  let head = fetch(http::Head, "/data/parts.csv", [], default_options);
  assert_eq((head.status, head.body, head.length), (200, b"", Some(20)));
  let head_request = {
    ..http::request_to(http::Head, "example.org", "/data/parts.csv", b""),
    headers: fields([]),
  };
  let reads = with_rand(rand(7), ||
    fs::on_mem[site](sample_files(), ||
      handle {
        http::collect_body(
          serve[site](head_request, head_request.path, default_options, noon).body,
          1048576,
        )
      } with {
        var n = 0,
        fs.kind[site](path) -> fs.kind[site](path),
        fs.stat[site](path) -> fs.stat[site](path),
        fs.close[site](file) -> fs.close[site](file),
        fs.open[site](path, how) -> {
          n = n + 1;
          fs.open[site](path, how)
        },
        fs.read_at[site](path, at, most) -> {
          n = n + 1;
          fs.read_at[site](path, at, most)
        },
        fs.read_chunk[site](file, most) -> {
          n = n + 1;
          fs.read_chunk[site](file, most)
        },
        return _body -> n,
      }).value).value;
  assert(reads == 0, Some("a HEAD opened or read the file"));
  assert_eq(fetch(http::Post, "/data/parts.csv", [], default_options).status, 405);
  assert_eq(fetch(http::Get, "/empty/readme.txt", [], default_options).body, b"")
}
