//! The host's time, as an effect with two clock readings and a wait.
//!
//! None of these operations depends only on the program's state, so a definition that performs one
//! is `nondet`. A test supplies its own handler for the effect.
//!
//! This is not the language's `clock`, which has a monotonic reading and a wait that pauses only
//! the calling task. A `simulate { .. }` block runs `clock` on virtual time, so a deadline written
//! with `clock` (see `std.task`) costs no real time there. A normal run uses the real clock and
//! waits for the deadline. `time` returns what the operating system reports, including the date,
//! and its wait blocks the whole thread.
//!
//! The prelude's `Instant` and `Duration` count nanoseconds. An `Instant` is a clock reading and a
//! `Duration` is the span between two readings. The functions here build and read them. Every
//! conversion uses checked arithmetic, so a conversion that overflows an `Int` raises.
//!
//! A `Duration` has two text forms, and each converts to text and back without loss.
//! `render_duration` writes the compound form that a flag or configuration file uses for a timeout,
//! such as `1h30m15.5s`, and `read_duration` reads it. `render_iso_duration` and
//! `read_iso_duration` write and read the ISO 8601 form, such as `PT1H30M15.5S`. Both readers
//! reject text that is finer than a nanosecond or longer than a `Duration` can represent. They
//! report why and where by raising `duration.fail`. `parse_duration` and `parse_iso_duration`
//! return the same error as an `Err` instead. Neither form has years or months, because their
//! length depends on the date they are counted from. Those belong to parse it with `Period` from `std.date`. With
//! `import std.duration`, `duration"1h30m"` is a `Duration` read at compile time.

import std.bytes
import std.internal.native (native)
import std.laws (round_trip)
import std.math (pow)
import std.gen

/// The wall clock, the monotonic clock, and a wait.
pub nondet effect time {
  /// Milliseconds since the Unix epoch. Use it to timestamp a record, not to measure time, since
  /// the system clock can be set backwards.
  read now_ms() -> Int
  /// Milliseconds on a clock that counts from when the run's host was built and never goes
  /// backwards. The difference of two readings is a span; a single reading means nothing on its
  /// own.
  read elapsed_ms() -> Int
  /// The same monotonic clock in microseconds, for a benchmark of calls that take microseconds,
  /// which `elapsed_ms` is too coarse to see.
  read elapsed_us() -> Int
  /// Blocks the thread that performs it for `ms` milliseconds, which also blocks every task in the
  /// run. To make only the calling task wait, perform `clock.sleep` instead. A negative `ms` does
  /// not wait. A test can handle this operation with a handler that returns immediately, so a
  /// program that polls is tested without waiting.
  write sleep_ms(ms: Int) -> Unit
}

/// A deadline on the monotonic clock, `ms` milliseconds from now.
pub fn deadline_in(ms: Int) -> Int / {time.elapsed_ms bounded} = time.elapsed_ms() + ms

/// Whether the monotonic clock has reached `deadline`.
pub fn expired(deadline: Int) -> Bool / {time.elapsed_ms bounded} = time.elapsed_ms() >= deadline

/// Milliseconds since the monotonic reading `started`.
pub fn since(started: Int) -> Int / {time.elapsed_ms bounded} = time.elapsed_ms() - started

/// Microseconds since `started`, a reading of `time.elapsed_us`.
pub fn since_us(started: Int) -> Int / {time.elapsed_us bounded} = time.elapsed_us() - started

/// A span of `n` nanoseconds. `micros`, `millis`, `seconds`, `minutes` and `hours` take other
/// units.
pub fn nanos(n: Int) -> Duration = Duration(n)

/// A span of `n` microseconds.
pub fn micros(n: Int) -> Duration = Duration(n * 1000)

/// A span of `n` milliseconds.
pub fn millis(n: Int) -> Duration = Duration(n * 1000000)

/// A span of `n` seconds.
pub fn seconds(n: Int) -> Duration = Duration(n * 1000000000)

/// A span of `n` minutes.
pub fn minutes(n: Int) -> Duration = seconds(n * 60)

/// A span of `n` hours.
pub fn hours(n: Int) -> Duration = minutes(n * 60)

/// A span in nanoseconds.
pub fn as_nanos(d: Duration) -> Int = match d { Duration(n) -> n }

/// Whole microseconds, rounded toward zero.
pub fn as_micros(d: Duration) -> Int = as_nanos(d) / 1000

/// Whole milliseconds, rounded toward zero.
pub fn as_millis(d: Duration) -> Int = as_nanos(d) / 1000000

/// Whole seconds, rounded toward zero.
pub fn as_seconds(d: Duration) -> Int = as_nanos(d) / 1000000000

/// The two spans together.
pub fn plus(a: Duration, b: Duration) -> Duration = Duration(as_nanos(a) + as_nanos(b))

/// Returns the difference `a - b` as a `Duration`.
pub fn minus(a: Duration, b: Duration) -> Duration = Duration(as_nanos(a) - as_nanos(b))

/// Returns `d` multiplied by `k`.
pub fn scaled(d: Duration, k: Int) -> Duration = Duration(as_nanos(d) * k)

/// The reading's nanoseconds; only the difference of two readings of one clock means anything.
pub fn nanos_at(i: Instant) -> Int = match i { Instant(n) -> n }

/// Returns the `Instant` that is `d` later than `i`.
pub fn after(i: Instant, d: Duration) -> Instant = Instant(nanos_at(i) + as_nanos(d))

/// The reading `ms` milliseconds after the clock's zero, for a moment that a machine or a test
/// gives in milliseconds.
pub fn at_millis(ms: Int) -> Instant = after(Instant(0), millis(ms))

/// Returns the `Duration` from `earlier` to `later`. The result is negative when `later` comes
/// before `earlier`.
pub fn between(earlier: Instant, later: Instant) -> Duration =
  Duration(nanos_at(later) - nanos_at(earlier))

/// Why a reader rejected a text. The last five apply only to the ISO 8601 form.
pub type ErrorKind =
  /// The text has no content to read: it is empty, it is only a sign, or it is an ISO `P` or `T`
  /// with no component after it.
  | Empty
  /// No digit where a number begins, or after its point.
  | NoNumber
  /// A number with no unit after it.
  | NoUnit
  /// A unit that is none of `h`, `m`, `s`, `ms`, `us` and `ns`.
  | UnknownUnit
  /// A fraction finer than a nanosecond.
  | TooFine
  /// The span is too long for a `Duration` to represent, in either direction.
  | TooLong
  /// A text that does not open with `P`.
  | MissingP
  /// A year or a month: a calendar period, which is parse it with `Period` from `std.date`, not a span of time.
  | Calendar
  /// A designator that is none of `W`, `D`, `H`, `M` and `S`.
  | UnknownDesignator
  /// A designator out of its order, written twice, or on the wrong side of the `T`.
  | OutOfOrder
  /// A fraction on a component that is not the last.
  | FractionNotLast

/// A reading error, and the offset of the character it is about.
pub type Error = new { reason: ErrorKind, at: Int }

/// The effect a duration reader raises when it rejects a text.
pub effect duration {
  /// The text is not in the format that `read_duration` or `read_iso_duration` accepts.
  raise fail(e: Error)
}

/// The error message to show whoever wrote the text.
pub fn rejection_message(rejected: Error) -> String =
  match rejected.reason {
    Empty -> "no duration is written here",
    NoNumber -> "a number goes here: digits, with digits after a point if it has one",
    NoUnit -> "a number must be followed by its unit",
    UnknownUnit -> "unknown unit: use `h`, `m`, `s`, `ms`, `us` or `ns`; a day has no fixed length",
    TooFine -> "finer than a nanosecond, the smallest span a `Duration` can represent",
    TooLong -> "longer than a `Duration` can represent, about 292 years",
    MissingP -> "an ISO 8601 duration opens with `P`",
    Calendar ->
      "a year or a month is a calendar period, not a fixed span of time: parse it with `Period` from `std.date`",
    UnknownDesignator -> "unknown unit letter: use upper case `W`, `D`, `H`, `M` or `S`",
    OutOfOrder ->
      "unit letters are out of order or repeated: write `W` and `D` first, then `T` (which starts the time part) followed by `H`, `M` and `S`, each at most once",
    FractionNotLast -> "only the last component can have a fraction",
  }

/// Returns `d` as compound duration text, which has exactly one text for each span. The text lists
/// hours, minutes and seconds, largest first, and omits any that is zero. Only the seconds may have
/// a fraction. A span under one second is written in the largest of `ms`, `us` and `ns` in which it
/// is at least 1, as in `250ms` and `1.5us`. Zero is `0s`, and a negative span starts with `-`.
pub fn render_duration(d: Duration) -> String = {
  let n = as_nanos(d);
  let below = if n > 0 { 0 - n } else { n };
  let sign = if n < 0 { "-" } else { "" };
  if n == 0 { "0s" }
  else if below > 0 - 1000 { sign ++ Int::to_string(0 - below) ++ "ns" }
  else if below > 0 - 1000000 {
    sign ++ decimal_text(0 - below / 1000, 0 - below % 1000, 3) ++ "us"
  } else if below > 0 - 1000000000 {
    sign ++ decimal_text(0 - below / 1000000, 0 - below % 1000000, 6) ++ "ms"
  } else { sign ++ hours_minutes_seconds(below, "h", "m", "s") }
}

/// The span `text` writes in the compound form, or the error that reports why it is not one. This
/// is `read_duration` with its error returned as an `Err`.
pub fn parse_duration(text: String) -> Result<Duration, Error> / {abort.raise} =
  try { read_duration(text) }

/// The span `text` writes in the compound form. Raises `duration.fail` when it is not one.
///
/// A text is an optional `-` followed by one or more terms, in any order, that add up. Each term is
/// a number in digits, optionally with more digits after a `.`, followed by a unit: `h`, `m`, `s`,
/// `ms`, `us` (also `µs`) or `ns`. Spaces are not allowed. `0` alone is zero. There is no `d`,
/// since a day is not a fixed span. A term that is not a whole number of nanoseconds, and a text
/// longer than a `Duration` can hold, are rejected, never rounded or wrapped.
pub fn read_duration(text: String) -> Duration / {duration.fail, abort.raise} = {
  let b = Bytes::of_string(text);
  let start = minus_sign_width(b);
  if start >= b.len() { fail(b, Empty, start) }
  else if b.slice(start, b.len()) == b"0" { Duration(0) } else {
    apply_sign(
      b,
      start,
      iterate({ at: start, below: 0 }, b.len() + 1, |s: CompoundState|
        if s.at >= b.len() { Stop(s.below) } else { Continue(read_term(b, s)) }),
    )
  }
}

/// Returns `d` as ISO 8601 duration text, which has exactly one text for each span. The text is
/// `PT` followed by the hours, minutes and seconds, each ending in `H`, `M` or `S`, with any that
/// is zero omitted. Zero is `PT0S`, a negative span starts with `-`, and days and weeks are never
/// written.
pub fn render_iso_duration(d: Duration) -> String = {
  let n = as_nanos(d);
  if n == 0 { "PT0S" } else {
    (if n < 0 { "-" } else { "" }) ++ "PT"
      ++ hours_minutes_seconds(if n > 0 { 0 - n } else { n }, "H", "M", "S")
  }
}

/// The span `text` writes as an ISO 8601 duration, or the error that reports why it is not one.
/// This is `read_iso_duration` with its error returned as an `Err`.
pub fn parse_iso_duration(text: String) -> Result<Duration, Error> / {abort.raise} =
  try { read_iso_duration(text) }

/// The span `text` writes as an ISO 8601 duration. Raises `duration.fail` when it is not one.
///
/// A text is an optional `-`, then `P`, then components in the order weeks, days, `T`, hours,
/// minutes, seconds. Each component is a number followed by its designator, `W`, `D`, `H`, `M` or
/// `S`, and appears at most once. The `T` is present exactly when a component follows it. A week is
/// seven days and a day is 24 hours. The last component may have a fraction after a `.` or a `,`. A
/// year or a month before the `T` is rejected as `Calendar`. A value that is not a whole number of
/// nanoseconds, or is longer than a `Duration` can hold, is rejected too.
pub fn read_iso_duration(text: String) -> Duration / {duration.fail, abort.raise} = {
  let b = Bytes::of_string(text);
  let start = minus_sign_width(b);
  if start >= b.len() { fail(b, Empty, start) }
  else if b.at(start) != 80 { fail(b, MissingP, start) } else {
    let read = iterate(
      {
        at: start + 1,
        negated_nanos: 0,
        rank: 0,
        in_time: false,
        fraction_at: 0 - 1,
        no_component: true,
      },
      b.len() + 1,
      |s: IsoState| if s.at >= b.len() { Stop(s) } else { Continue(iso_step(b, s)) },
    );
    if read.no_component { fail(b, Empty, read.at) }
    else { apply_sign(b, start, read.negated_nanos) }
  }
}

type CompoundState = { at: Int, below: Int }

type IsoState = {
  at: Int,
  negated_nanos: Int,
  rank: Int,
  in_time: Bool,
  fraction_at: Int,
  no_component: Bool,
}

type Number = { whole: Bytes, fraction: Bytes, has_point: Bool, end: Int }

fn fail<a>(b: Bytes, reason: ErrorKind, at: Int) -> a / {duration.fail, abort.raise} =
  duration.fail({ reason: reason, at: characters_before(b, at) })

fn characters_before(b: Bytes, at: Int) -> Int / {abort.raise} =
  range(0, at).fold(0, |count: Int, i: Int| if b.at(i) & 0xC0 == 0x80 { count } else { count + 1 })

fn minus_sign_width(b: Bytes) -> Int = if b.len() > 0 && b.at(0) == 45 { 1 } else { 0 }

fn apply_sign(b: Bytes, start: Int, below: Int) -> Duration / {duration.fail, abort.raise} =
  if start == 1 { Duration(below) }
  else { match checked_neg(below) { Some(n) -> Duration(n), None -> fail(b, TooLong, 0) } }

fn read_term(b: Bytes, s: CompoundState) -> CompoundState / {duration.fail, abort.raise} = {
  let n = number_at(b, s.at, b".");
  let unit_end = b.skip_until(n.end, b"0123456789.");
  if unit_end == n.end { fail(b, NoUnit, n.end) } else {
    match unit_nanos(b.slice(n.end, unit_end)) {
      None -> fail(b, UnknownUnit, n.end),
      Some(unit) -> { at: unit_end, below: add_term(b, s.below, n, unit, s.at) },
    }
  }
}

fn unit_nanos(unit: Bytes) -> Option<Int> =
  if unit == b"ns" { Some(1) }
  else if unit == b"us" || unit == b"\xc2\xb5s" || unit == b"\xce\xbcs" { Some(1000) }
  else if unit == b"ms" { Some(1000000) }
  else if unit == b"s" { Some(1000000000) }
  else if unit == b"m" { Some(60000000000) }
  else if unit == b"h" { Some(3600000000000) }
  else { None }

fn iso_step(b: Bytes, s: IsoState) -> IsoState / {duration.fail, abort.raise} =
  if b.at(s.at) == 84 {
    if s.in_time { fail(b, OutOfOrder, s.at) }
    else { { ..s, at: s.at + 1, in_time: true, no_component: true } }
  } else if s.fraction_at >= 0 { fail(b, FractionNotLast, s.fraction_at) } else {
    let n = number_at(b, s.at, b".,");
    if n.end >= b.len() { fail(b, NoUnit, n.end) } else {
      let part = iso_part(b, n.end, s.in_time);
      if part.rank <= s.rank { fail(b, OutOfOrder, n.end) } else {
        {
          at: n.end + 1,
          negated_nanos: add_term(b, s.negated_nanos, n, part.nanos, s.at),
          rank: part.rank,
          in_time: s.in_time,
          fraction_at: if n.has_point { s.at } else { 0 - 1 },
          no_component: false,
        }
      }
    }
  }

fn iso_part(
  b: Bytes,
  at: Int,
  in_time: Bool,
) -> { rank: Int, nanos: Int } / {duration.fail, abort.raise} = {
  let designator = b.at(at);
  if designator == 89 || (designator == 77 && !in_time) { fail(b, Calendar, at) } else {
    let part = if designator == 87 { { rank: 1, nanos: 604800000000000, timed: false } }
    else if designator == 68 { { rank: 2, nanos: 86400000000000, timed: false } }
    else if designator == 72 { { rank: 3, nanos: 3600000000000, timed: true } }
    else if designator == 77 { { rank: 4, nanos: 60000000000, timed: true } }
    else if designator == 83 { { rank: 5, nanos: 1000000000, timed: true } }
    else { fail(b, UnknownDesignator, at) };
    if part.timed != in_time { fail(b, OutOfOrder, at) }
    else { { rank: part.rank, nanos: part.nanos } }
  }
}

fn number_at(b: Bytes, i: Int, points: Bytes) -> Number / {duration.fail, abort.raise} = {
  let whole_end = b.skip(i, b"0123456789");
  if whole_end == i { fail(b, NoNumber, i) }
  else if whole_end < b.len() && points.index_of_byte(b.at(whole_end)) != None {
    let end = b.skip(whole_end + 1, b"0123456789");
    if end == whole_end + 1 { fail(b, NoNumber, end) } else {
      {
        whole: b.slice(i, whole_end),
        fraction: without_trailing_zeros(b.slice(whole_end + 1, end)),
        has_point: true,
        end: end,
      }
    }
  } else { { whole: b.slice(i, whole_end), fraction: b"", has_point: false, end: whole_end } }
}

fn without_trailing_zeros(digits: Bytes) -> Bytes / {abort.raise} =
  digits.slice(
    0,
    range(0, digits.len()).fold(0, |trimmed_length: Int, i: Int|
      if digits.at(i) == 48 { trimmed_length } else { i + 1 }),
  )

fn add_term(
  b: Bytes,
  below: Int,
  n: Number,
  unit: Int,
  at: Int,
) -> Int / {duration.fail, abort.raise} = {
  let places = n.fraction.len();
  if places > 18 { fail(b, TooFine, at) } else {
    let part = I128::of_int(match n.fraction.int_of_ascii() { Some(f) -> f, None -> 0 })
      * I128::of_int(unit);
    let scale = I128::of_int(pow(10, places));
    if part % scale != 0i128 { fail(b, TooFine, at) } else {
      let read = match Bytes::int_of_ascii(b"-" ++ n.whole) {
        None -> None,
        Some(whole) -> match checked_mul(whole, unit) {
          None -> None,
          Some(scaled) -> match checked_sub(scaled, Int::of_i128(part / scale)) {
            None -> None,
            Some(of_term) -> checked_add(below, of_term),
          },
        },
      };
      match read { Some(total) -> total, None -> fail(b, TooLong, at) }
    }
  }
}

fn hours_minutes_seconds(below: Int, hour: String, minute: String, second: String) -> String = {
  let hours = 0 - below / 3600000000000;
  let minutes = 0 - below % 3600000000000 / 60000000000;
  let nanos = 0 - below % 60000000000;
  (if hours == 0 { "" } else { hours.to_string() ++ hour })
    ++ (if minutes == 0 { "" } else { minutes.to_string() ++ minute })
    ++ (if nanos == 0 { "" }
    else { decimal_text(nanos / 1000000000, nanos % 1000000000, 9) ++ second })
}

fn decimal_text(whole: Int, part: Int, places: Int) -> String =
  whole.to_string()
    ++ (if part == 0 { "" } else {
      "."
        ++ range(0, places).fold(
          { rest: part, out: "" },
          |s: { rest: Int, out: String }, _: Int|
            {
              rest: s.rest / 10,
              out: if s.out == "" && s.rest % 10 == 0 { "" }
              else { Int::to_string(s.rest % 10) ++ s.out },
            },
        ).out
    })

/// The readings a test's handler clauses return through the functions below in place of the host's
/// clocks, each list read in order. The last reading repeats once a list runs out, so a program may
/// read more often than the test planned.
pub type Ticks = { wall: List<Int>, mono: List<Int>, last_wall: Int, last_mono: Int }

/// One reading, and the ticks left to return.
pub type ClockReading = { at: Int, ticks: Ticks }

/// A fake clock that returns `wall` for `now_ms` and `mono` for `elapsed_ms`, each in order.
pub fn ticks(wall: List<Int>, mono: List<Int>) -> Ticks =
  { wall: wall, mono: mono, last_wall: 0, last_mono: 0 }

/// What `time.now_ms` returns from `t`.
pub fn now_step(t: Ticks) -> ClockReading =
  match t.wall {
    [] -> { at: t.last_wall, ticks: t },
    [first, ..rest] -> { at: first, ticks: { ..t, wall: rest, last_wall: first } },
  }

/// What `time.elapsed_ms` returns from `t`.
pub fn elapsed_step(t: Ticks) -> ClockReading =
  match t.mono {
    [] -> { at: t.last_mono, ticks: t },
    [first, ..rest] -> { at: first, ticks: { ..t, mono: rest, last_mono: first } },
  }

/// What `time.elapsed_us` returns from `t`: its millisecond reading times a thousand, so a test
/// that gives five milliseconds means five thousand microseconds.
pub fn elapsed_us_step(t: Ticks) -> ClockReading = {
  let step = elapsed_step(t);
  { at: step.at * 1000, ticks: step.ticks }
}

host for time by with_host

fn with_host<a | e>(go: () -> a / {time.read, time.write | e}) -> a / {native.read | e} =
  handle {
    go()
  } with {
    time.now_ms() -> time_now_ms(),
    time.elapsed_ms() -> time_elapsed_ns() / 1000000,
    time.elapsed_us() -> time_elapsed_ns() / 1000,
    time.sleep_ms(ms) -> if ms > 0 { time_sleep_ms(ms) } else { () },
  }

extern fn time_now_ms() -> Int / {native.read}

extern fn time_elapsed_ns() -> Int / {native.read}

extern fn time_sleep_ms(ms: Int) -> Unit / {native.read}

fn measure() -> Int / {time.elapsed_ms} = {
  let started = time.elapsed_ms();
  since(started)
}

fn sleep_then_elapsed(interval: Int) -> Int / {time.elapsed_ms, time.sleep_ms} = {
  time.sleep_ms(interval);
  time.elapsed_ms()
}

test "a handler can replace `time.sleep_ms` and `time.elapsed_ms`, so a program that sleeps and checks the clock is tested without waiting" {
  let polls = handle {
    sleep_then_elapsed(120) + sleep_then_elapsed(120)
  } with {
    var waited = 0,
    time.sleep_ms(ms) -> {
      waited = waited + ms;
    },
    time.elapsed_ms() -> waited,
    return readings -> { readings: readings, waited: waited },
  };
  assert_eq(polls.waited, 240);
  assert_eq(polls.readings, 360)
}

fn measured_us() -> Int / {time.elapsed_us} = {
  let started = time.elapsed_us();
  since_us(started)
}

test "a microsecond reading is the millisecond reading from the same clock multiplied by 1000" {
  let readings = handle {
    measured_us() + measured_us()
  } with {
    var s = ticks([], [5, 9]),
    time.elapsed_us() -> {
      let r = elapsed_us_step(s);
      s = r.ticks;
      r.at
    },
  };
  assert_eq(readings, 4000)
}

test "a span is the difference of two monotonic readings, and a test supplies both" {
  let left = handle {
    assert_eq(measure(), 15)
  } with {
    var s = ticks([], [10, 25]),
    time.elapsed_ms() -> {
      let r = elapsed_step(s);
      s = r.ticks;
      r.at
    },
    return u -> s,
  };
  assert_eq(left.mono, [])
}

test "a deadline is read against the same clock that set it" {
  handle {
    let deadline = deadline_in(500);
    assert_eq(deadline, 1500);
    assert(!expired(deadline));
    assert(expired(deadline))
  } with {
    var s = ticks([], [1000, 1499, 1500]),
    time.elapsed_ms() -> {
      let r = elapsed_step(s);
      s = r.ticks;
      r.at
    },
  }
}

test "the wall clock and the monotonic clock each read from their own list, so reading one does not use up the other" {
  let start = ticks([1700000000000, 1700000000500], [4, 9]);
  let wall_once = now_step(start);
  assert_eq(wall_once.at, 1700000000000);
  assert_eq(wall_once.ticks.mono, [4, 9]);
  let mono_once = elapsed_step(wall_once.ticks);
  assert_eq(mono_once.at, 4);
  assert_eq(now_step(mono_once.ticks).at, 1700000000500);
  assert_eq(elapsed_step(mono_once.ticks).at, 9)
}

test "when a test's list of clock readings runs out, the last reading is returned again, and an empty list reads zero" {
  let spent = elapsed_step(elapsed_step(ticks([], [7])).ticks);
  assert_eq(spent.at, 7);
  assert_eq(elapsed_step(spent.ticks).at, 7);
  assert_eq(now_step(ticks([], [])).at, 0)
}

test "a duration is stored as nanoseconds whatever unit created it, and converting it to a unit returns whole units" {
  assert_eq(seconds(2), millis(2000));
  assert_eq(as_nanos(minutes(1)), 60000000000);
  assert_eq(as_millis(micros(2500)), 2);
  assert_eq(as_seconds(hours(1)), 3600);
  assert_eq(plus(seconds(1), millis(500)), millis(1500));
  assert_eq(minus(seconds(1), seconds(3)), seconds(-2));
  assert_eq(scaled(millis(3), 4), millis(12))
}

test "an instant moved by a duration is that far from where it was" {
  let start = Instant(100);
  assert_eq(between(start, after(start, seconds(1))), seconds(1));
  assert_eq(between(after(start, millis(5)), start), millis(-5));
  assert_eq(compare(start, after(start, nanos(1))), Less)
}

test "`parse_duration` returns the duration that `render_duration` wrote as text such as `1m30s`" {
  gen::check(gen::map(gen::any_int(), |n: Int| Duration(n)), |x: Duration|
    round_trip(
      render_duration,
      |text: String| match parse_duration(text) { Ok(d) -> Some(d), Err(_) -> None },
      x,
    ))
}

test "a duration reads back from its ISO 8601 text" {
  gen::check(gen::map(gen::any_int(), |n: Int| Duration(n)), |x: Duration|
    round_trip(
      render_iso_duration,
      |text: String| match parse_iso_duration(text) { Ok(d) -> Some(d), Err(_) -> None },
      x,
    ))
}

type RenderCase = { nanos: Int, text: String }

type ErrorCase = { text: String, reason: ErrorKind, at: Int }

const min_nanos: Int = 0 - 9223372036854775807 - 1

test "`render_duration` writes a duration as text such as `1m30s`, with the largest unit first and units of zero left out" {
  let texts: List<RenderCase> = [
    { nanos: 0, text: "0s" },
    { nanos: 1, text: "1ns" },
    { nanos: 999, text: "999ns" },
    { nanos: 1000, text: "1us" },
    { nanos: 1001, text: "1.001us" },
    { nanos: 1500, text: "1.5us" },
    { nanos: 250000, text: "250us" },
    { nanos: 1500000, text: "1.5ms" },
    { nanos: 250000000, text: "250ms" },
    { nanos: 999999999, text: "999.999999ms" },
    { nanos: 1000000000, text: "1s" },
    { nanos: 1000000001, text: "1.000000001s" },
    { nanos: 1500000000, text: "1.5s" },
    { nanos: 60000000000, text: "1m" },
    { nanos: 90000000000, text: "1m30s" },
    { nanos: 3600000000000, text: "1h" },
    { nanos: 3600500000000, text: "1h0.5s" },
    { nanos: 5400000000000, text: "1h30m" },
    { nanos: 5415500000000, text: "1h30m15.5s" },
    { nanos: 86400000000000, text: "24h" },
    { nanos: 0 - 1, text: "-1ns" },
    { nanos: 0 - 120000000000, text: "-2m" },
    { nanos: 9223372036854775807, text: "2562047h47m16.854775807s" },
    { nanos: min_nanos, text: "-2562047h47m16.854775808s" },
  ];
  texts.fold((), |_: Unit, c: RenderCase| {
    assert_eq(render_duration(Duration(c.nanos)), c.text);
    assert_eq(parse_duration(c.text), Ok(Duration(c.nanos)))
  })
}

test "`parse_duration` accepts terms in any order, and accepts a fraction when it is a whole number of nanoseconds" {
  let read: List<RenderCase> = [
    { nanos: 5400000000000, text: "90m" },
    { nanos: 5400000000000, text: "1.5h" },
    { nanos: 5400000000000, text: "30m1h" },
    { nanos: 3602000000000, text: "1s1h1s" },
    { nanos: 500000000, text: "0.5s" },
    { nanos: 1500000000, text: "1.50s" },
    { nanos: 7000000000, text: "007s" },
    { nanos: 0, text: "0" },
    { nanos: 0, text: "-0" },
    { nanos: 0, text: "-0s" },
    { nanos: 0, text: "0h0.0s" },
    { nanos: 1000, text: "1\u{b5}s" },
    { nanos: 1000, text: "1\u{3bc}s" },
    { nanos: 1, text: "0.001us" },
    { nanos: 1, text: "0.000000001s" },
    { nanos: 9, text: "0.0000000000025h" },
    { nanos: 1500000000, text: "1.50000000000000000000000000000s" },
    { nanos: 9223372036854775807, text: "9223372036854775807ns" },
    { nanos: min_nanos, text: "-9223372036854775808ns" },
    { nanos: min_nanos, text: "-9223372036s854775808ns" },
  ];
  read.fold((), |_: Unit, c: RenderCase| assert_eq(parse_duration(c.text), Ok(Duration(c.nanos))))
}

test "`parse_duration` rejects invalid text with the position of the first invalid character" {
  let rejected: List<ErrorCase> = [
    { text: "", reason: Empty, at: 0 },
    { text: "-", reason: Empty, at: 1 },
    { text: "h", reason: NoNumber, at: 0 },
    { text: "+1s", reason: NoNumber, at: 0 },
    { text: ".5s", reason: NoNumber, at: 0 },
    { text: "1.s", reason: NoNumber, at: 2 },
    { text: "1h-1m", reason: UnknownUnit, at: 1 },
    { text: "1", reason: NoUnit, at: 1 },
    { text: "1.5", reason: NoUnit, at: 3 },
    { text: "1h30", reason: NoUnit, at: 4 },
    { text: "1.5.5s", reason: NoUnit, at: 3 },
    { text: "1d", reason: UnknownUnit, at: 1 },
    { text: "1w", reason: UnknownUnit, at: 1 },
    { text: "1H", reason: UnknownUnit, at: 1 },
    { text: "1min", reason: UnknownUnit, at: 1 },
    { text: "1 h", reason: UnknownUnit, at: 1 },
    { text: "1h ", reason: UnknownUnit, at: 1 },
    { text: "1\u{b5}s1x", reason: UnknownUnit, at: 4 },
    { text: "0.5ns", reason: TooFine, at: 0 },
    { text: "1h0.0000000001s", reason: TooFine, at: 2 },
    { text: "0.00000000000001h", reason: TooFine, at: 0 },
    { text: "9223372036854775808ns", reason: TooLong, at: 0 },
    { text: "2562047h47m16.854775808s", reason: TooLong, at: 0 },
    { text: "-2562047h47m16.854775809s", reason: TooLong, at: 12 },
    { text: "2562048h", reason: TooLong, at: 0 },
    { text: "99999999999999999999h", reason: TooLong, at: 0 },
  ];
  rejected.fold((), |_: Unit, c: ErrorCase|
    assert_eq(parse_duration(c.text), Err({ reason: c.reason, at: c.at })))
}

test "a span has one ISO 8601 text, in hours, minutes and seconds" {
  let texts: List<RenderCase> = [
    { nanos: 0, text: "PT0S" },
    { nanos: 1, text: "PT0.000000001S" },
    { nanos: 250000, text: "PT0.00025S" },
    { nanos: 1500000000, text: "PT1.5S" },
    { nanos: 90000000000, text: "PT1M30S" },
    { nanos: 5400000000000, text: "PT1H30M" },
    { nanos: 5415500000000, text: "PT1H30M15.5S" },
    { nanos: 129600000000000, text: "PT36H" },
    { nanos: 0 - 120000000000, text: "-PT2M" },
    { nanos: 9223372036854775807, text: "PT2562047H47M16.854775807S" },
    { nanos: min_nanos, text: "-PT2562047H47M16.854775808S" },
  ];
  texts.fold((), |_: Unit, c: RenderCase| {
    assert_eq(render_iso_duration(Duration(c.nanos)), c.text);
    assert_eq(parse_iso_duration(c.text), Ok(Duration(c.nanos)))
  })
}

test "an ISO 8601 week is seven days and a day 24 hours, and the last component may be a fraction" {
  let read: List<RenderCase> = [
    { nanos: 86400000000000, text: "P1D" },
    { nanos: 604800000000000, text: "P1W" },
    { nanos: 1483506500000000, text: "P2W3DT4H5M6.5S" },
    { nanos: 1500000000, text: "PT1,5S" },
    { nanos: 5400000000000, text: "PT1.5H" },
    { nanos: 5400000000000, text: "PT90M" },
    { nanos: 43200000000000, text: "P0.5D" },
    { nanos: 302400000000000, text: "P0.5W" },
    { nanos: 0, text: "P0D" },
    { nanos: 0, text: "-PT0.0S" },
    { nanos: 0 - 86400000000000, text: "-P1D" },
    { nanos: 9223372036854775807, text: "P15250WT47H47M16.854775807S" },
  ];
  read.fold((), |_: Unit, c: RenderCase|
    assert_eq(parse_iso_duration(c.text), Ok(Duration(c.nanos))))
}

test "`parse_iso_duration` rejects invalid ISO 8601 text with the position of the first invalid character" {
  let rejected: List<ErrorCase> = [
    { text: "", reason: Empty, at: 0 },
    { text: "-", reason: Empty, at: 1 },
    { text: "P", reason: Empty, at: 1 },
    { text: "PT", reason: Empty, at: 2 },
    { text: "P1DT", reason: Empty, at: 4 },
    { text: "1h", reason: MissingP, at: 0 },
    { text: "p1d", reason: MissingP, at: 0 },
    { text: "+PT1S", reason: MissingP, at: 0 },
    { text: "P1Y", reason: Calendar, at: 2 },
    { text: "P1M", reason: Calendar, at: 2 },
    { text: "P1W2M", reason: Calendar, at: 4 },
    { text: "P1Y2M3DT4H", reason: Calendar, at: 2 },
    { text: "PT1Y", reason: Calendar, at: 3 },
    { text: "PT1M2H", reason: OutOfOrder, at: 5 },
    { text: "PT1H1H", reason: OutOfOrder, at: 5 },
    { text: "P1D1W", reason: OutOfOrder, at: 4 },
    { text: "P1H", reason: OutOfOrder, at: 2 },
    { text: "P1S", reason: OutOfOrder, at: 2 },
    { text: "PT1W", reason: OutOfOrder, at: 3 },
    { text: "PT1D", reason: OutOfOrder, at: 3 },
    { text: "PTT1S", reason: OutOfOrder, at: 2 },
    { text: "PT1HT1M", reason: OutOfOrder, at: 4 },
    { text: "PT1.5H30M", reason: FractionNotLast, at: 2 },
    { text: "PT1.0H30M", reason: FractionNotLast, at: 2 },
    { text: "P0.5DT1H", reason: FractionNotLast, at: 1 },
    { text: "PT1h", reason: UnknownDesignator, at: 3 },
    { text: "PT1X", reason: UnknownDesignator, at: 3 },
    { text: "PT1 S", reason: UnknownDesignator, at: 3 },
    { text: "PT1", reason: NoUnit, at: 3 },
    { text: "PT1.5", reason: NoUnit, at: 5 },
    { text: "PTS", reason: NoNumber, at: 2 },
    { text: "PT.5S", reason: NoNumber, at: 2 },
    { text: "PT1.S", reason: NoNumber, at: 4 },
    { text: "PT-1S", reason: NoNumber, at: 2 },
    { text: "PT0.0000000001S", reason: TooFine, at: 2 },
    { text: "P15251W", reason: TooLong, at: 1 },
    { text: "P106752D", reason: TooLong, at: 1 },
    { text: "PT2562047H47M16.854775808S", reason: TooLong, at: 0 },
  ];
  rejected.fold((), |_: Unit, c: ErrorCase|
    assert_eq(parse_iso_duration(c.text), Err({ reason: c.reason, at: c.at })))
}

test "a reader raises its error, and each error has a message" {
  let raised = handle { as_nanos(read_duration("1h30")) } with { duration.fail(e) -> 0 - e.at };
  assert_eq(raised, 0 - 4);
  assert_eq(as_nanos(read_duration("1h30m")), 5400000000000);
  assert_eq(as_nanos(read_iso_duration("PT1H30M")), 5400000000000);
  let sentences = [
    Empty,
    NoNumber,
    NoUnit,
    UnknownUnit,
    TooFine,
    TooLong,
    MissingP,
    Calendar,
    UnknownDesignator,
    OutOfOrder,
    FractionNotLast,
  ].map(|reason: ErrorKind| rejection_message({ reason: reason, at: 0 }));
  assert_eq(sentences.filter(|s: String| s == "").len(), 0);
  assert(
    rejection_message({ reason: Calendar, at: 0 }).contains(
      "parse it with `Period` from `std.date`",
    ),
  )
}
