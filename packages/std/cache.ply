//! Caches that a program manages as values, with a size bound enforced by evicting the least
//! recently used entry, and with entries that expire.
//!
//! A `Cache` is a persistent value. Every operation returns a new cache and leaves the cache it was
//! given unchanged, so the caller must use the returned cache. `get` returns the value together
//! with a new cache in which that entry counts as the most recently used. If the caller ignores
//! that new cache and keeps using the old one, the old cache still returns the same values, and its
//! order of use is as it was before the `get`. No operation reads a clock. An operation that
//! depends on time takes the current time as an `Instant`.
//!
//! The bound is a total weight. `put` gives every entry a weight of one, which makes the bound a
//! count, and `insert` takes a weight of at least one. When an entry raises the total weight above
//! the capacity, the least recently used entries are evicted, oldest first, until the rest fit. An
//! entry heavier than the whole capacity is not stored. A `put`, an `insert` and a `get` that
//! returns a value each count as a use. `peek` and `contains` read without counting as a use.
//!
//! An entry may have a deadline: the cache's lifetime after the time it was put, or the lifetime
//! given to `insert`. At or after its deadline, an entry is never returned. It is removed when
//! `get` requests it, when `sweep` runs or when eviction reaches it. Until then it counts toward
//! the bound, and eviction does not remove the entry nearest its deadline first.
//!
//! `get`, `put`, `insert` and `remove` each read and write a fixed number of map entries, plus a
//! fixed number more for each entry evicted, so each takes time logarithmic in the number of
//! entries. Two caches with the same capacity and lifetime that contain the same entries in the
//! same order of use are equal, whatever operations built them, because a cache stores no timestamp
//! or counter.

import std.laws (refines)
import std.math (ilog2)
import std.time (after, at_millis, millis, nanos, nanos_at, seconds)
import std.gen

/// One entry, as `entries_by_use` lists it and `of_entries` takes it.
pub type Entry<k, v> = {
  key: k,
  value: v,
  /// How much the entry counts toward its cache's capacity, at least one.
  weight: Int,
  /// The time from which the entry is no longer returned, or `None` if it never expires.
  expires: Option<Instant>,
}

/// How `insert` stores an entry: its weight, and how long it lives, where `None` means forever.
pub type InsertOptions = { weight: Int, lifetime: Option<Duration> }

type Node<k, v> = {
  value: v,
  weight: Int,
  expires: Option<Instant>,
  older: Option<k>,
  newer: Option<k>,
}

/// A cache of at most `capacity` total weight. `lru`, `expiring` and `of_entries` create one.
pub type Cache<k, v> = new {
  capacity: Int,
  /// How long an entry stored by `put` lives, or forever if `None`.
  lifetime: Option<Duration>,
  entries: Map<k, Node<k, v>>,
  /// The least recently used key, which eviction removes first.
  oldest: Option<k>,
  newest: Option<k>,
  /// The total weight of the entries.
  weight: Int,
}

/// What a read returns: the value, and the cache after the read.
pub type GetResult<k, v> = { value: Option<v>, cache: Cache<k, v> }

/// What a write returns: the cache after it, and the entries it evicted, in the order evicted.
pub type InsertResult<k, v> = { cache: Cache<k, v>, evicted: List<Entry<k, v>> }

/// An empty cache of at most `capacity` entries, none of which expire. A cache with no capacity
/// stores nothing.
pub fn lru<k, v>(capacity: Int) -> Cache<k, v>
  where derivable(ord, k)
= empty(capacity, None)

/// An empty cache of at most `capacity` entries, each living `lifetime` from the time it is put.
pub fn expiring<k, v>(capacity: Int, lifetime: Duration) -> Cache<k, v>
  where derivable(ord, k)
= empty(capacity, Some(lifetime))

/// Builds a cache from entries listed least recently used first, each with its listed weight and
/// deadline, so `of_entries(capacity(c), lifetime(c), entries_by_use(c))` equals `c`. Entries past
/// the capacity are evicted as `put` would evict them.
pub fn of_entries<k, v>(
  capacity: Int,
  lifetime: Option<Duration>,
  entries_by_use: List<Entry<k, v>>,
) -> Cache<k, v> / {abort.raise}
  where derivable(ord, k)
=
  entries_by_use.fold(empty(capacity, lifetime), |c: Cache<k, v>, h: Entry<k, v>|
    insert_entry(c, h).cache)

fn empty<k, v>(capacity: Int, lifetime: Option<Duration>) -> Cache<k, v>
  where derivable(ord, k)
=
  {
    capacity: capacity,
    lifetime: lifetime,
    entries: Map::new(),
    oldest: None,
    newest: None,
    weight: 0,
  }

/// The most total weight the cache can store.
pub fn capacity<k, v>(c: Cache<k, v>) -> Int = c.capacity

/// How long an entry stored by `put` lives.
pub fn lifetime<k, v>(c: Cache<k, v>) -> Option<Duration> = c.lifetime

/// The total weight of the entries, never more than the capacity.
pub fn weight<k, v>(c: Cache<k, v>) -> Int = c.weight

/// The number of entries, including those past their deadline that are not yet dropped.
pub fn size<k, v>(c: Cache<k, v>) -> Int
  where derivable(ord, k)
= c.entries.len()

/// Looks up `key` at time `now`, and returns the value and the cache after the read. A returned
/// value makes its entry the most recently used. An entry at or past its deadline returns `None`
/// and is dropped. A missing key returns `None` and the cache unchanged.
pub fn get<k, v>(c: Cache<k, v>, key: k, now: Instant) -> GetResult<k, v>
  where derivable(ord, k)
=
  match c.entries.get(key) {
    None -> { value: None, cache: c },
    Some(e) -> if is_expired(e.expires, now) { { value: None, cache: unlinked(c, key, e) } } else {
      {
        value: Some(e.value),
        cache: match e.newer { None -> c, Some(_) -> linked(unlinked(c, key, e), key, e) },
      }
    },
  }

/// Looks up `key` at time `now` without changing the order of use or dropping anything.
pub fn peek<k, v>(c: Cache<k, v>, key: k, now: Instant) -> Option<v>
  where derivable(ord, k)
= match c.entries.get(key) { Some(e) if !is_expired(e.expires, now) -> Some(e.value), _ -> None }

/// Whether `get` would return a value for `key` at time `now`.
pub fn contains<k, v>(c: Cache<k, v>, key: k, now: Instant) -> Bool
  where derivable(ord, k)
= match peek(c, key, now) { Some(_) -> true, None -> false }

/// Every entry, least recently used first, which is the order eviction removes them in.
pub fn entries_by_use<k, v>(c: Cache<k, v>) -> List<Entry<k, v>>
  where derivable(ord, k)
=
  range(0, c.entries.len()).fold(
    { at: c.oldest, listed: [] },
    |s: { at: Option<k>, listed: List<Entry<k, v>> }, _: Int|
      match s.at {
        None -> s,
        Some(key) -> match c.entries.get(key) {
          None -> { at: None, listed: s.listed },
          Some(e) -> { at: e.newer, listed: s.listed.push(entry_of(key, e)) },
        },
      },
  ).listed

/// The keys, the least recently used first.
pub fn keys<k, v>(c: Cache<k, v>) -> List<k>
  where derivable(ord, k)
= entries_by_use(c).map(|h: Entry<k, v>| h.key)

fn entry_of<k, v>(key: k, e: Node<k, v>) -> Entry<k, v> =
  { key: key, value: e.value, weight: e.weight, expires: e.expires }

fn is_expired(expires: Option<Instant>, now: Instant) -> Bool =
  match expires { None -> false, Some(deadline) -> nanos_at(now) >= nanos_at(deadline) }

/// Stores `value` under `key` as the most recently used entry, with weight one and the cache's
/// lifetime from `now`. It replaces any value already under `key`, and evicts the least recently
/// used entries until the rest fit.
pub fn put<k, v>(c: Cache<k, v>, key: k, value: v, now: Instant) -> Cache<k, v> / {abort.raise}
  where derivable(ord, k)
= insert(c, key, value, { weight: 1, lifetime: c.lifetime }, now).cache

/// `put` with the caller's weight and lifetime, which also returns the evicted entries. A weight
/// below one counts as one. An entry heavier than the whole capacity is not stored: the returned
/// cache has no `key`, and the entry is returned as evicted.
pub fn insert<k, v>(
  c: Cache<k, v>,
  key: k,
  value: v,
  terms: InsertOptions,
  now: Instant,
) -> InsertResult<k, v> / {abort.raise}
  where derivable(ord, k)
=
  insert_entry(c, {
    key: key,
    value: value,
    weight: terms.weight,
    expires: match terms.lifetime { None -> None, Some(span) -> Some(after(now, span)) },
  })

/// Removes `key`. A missing key leaves the cache unchanged.
pub fn remove<k, v>(c: Cache<k, v>, key: k) -> Cache<k, v>
  where derivable(ord, k)
= match c.entries.get(key) { None -> c, Some(e) -> unlinked(c, key, e) }

/// Removes the entries at or past their deadline at time `now`. It reads every entry.
pub fn sweep<k, v>(c: Cache<k, v>, now: Instant) -> Cache<k, v>
  where derivable(ord, k)
=
  entries_by_use(c).fold(c, |remaining: Cache<k, v>, h: Entry<k, v>|
    if is_expired(h.expires, now) { remove(remaining, h.key) } else { remaining })

/// Returns an empty cache with the same capacity and lifetime as `c`.
pub fn clear<k, v>(c: Cache<k, v>) -> Cache<k, v>
  where derivable(ord, k)
= empty(c.capacity, c.lifetime)

fn insert_entry<k, v>(c: Cache<k, v>, h: Entry<k, v>) -> InsertResult<k, v> / {abort.raise}
  where derivable(ord, k)
= {
  let weighed = { ..h, weight: max(h.weight, 1) };
  let without = remove(c, h.key);
  if weighed.weight > c.capacity { { cache: without, evicted: [weighed] } } else {
    evict_to_fit(
      linked(without, h.key, {
        value: h.value,
        weight: weighed.weight,
        expires: h.expires,
        older: None,
        newer: None,
      }),
    )
  }
}

fn evict_to_fit<k, v>(c: Cache<k, v>) -> InsertResult<k, v> / {abort.raise}
  where derivable(ord, k)
=
  iterate({ cache: c, evicted: [] }, c.entries.len() + 1, |s: InsertResult<k, v>|
    if s.cache.weight <= s.cache.capacity { Stop(s) } else {
      match s.cache.oldest {
        None -> Stop(s),
        Some(key) -> match s.cache.entries.get(key) {
          None -> Stop(s),
          Some(e) ->
            Continue({
              cache: unlinked(s.cache, key, e),
              evicted: s.evicted.push(entry_of(key, e)),
            }),
        },
      }
    })

fn unlinked<k, v>(c: Cache<k, v>, key: k, e: Node<k, v>) -> Cache<k, v>
  where derivable(ord, k)
= {
  let apart = c.entries.remove(key);
  let behind = match e.older {
    None -> apart,
    Some(older) -> apart.update(older, |o: Node<k, v>| { ..o, newer: e.newer }),
  };
  {
    ..c,
    entries: match e.newer {
      None -> behind,
      Some(newer) -> behind.update(newer, |n: Node<k, v>| { ..n, older: e.older }),
    },
    oldest: match e.older { None -> e.newer, Some(_) -> c.oldest },
    newest: match e.newer { None -> e.older, Some(_) -> c.newest },
    weight: c.weight - e.weight,
  }
}

fn linked<k, v>(c: Cache<k, v>, key: k, e: Node<k, v>) -> Cache<k, v>
  where derivable(ord, k)
=
  {
    ..c,
    entries: Map::insert(
      match c.newest {
        None -> c.entries,
        Some(newest) -> c.entries.update(newest, |n: Node<k, v>| { ..n, newer: Some(key) }),
      },
      key,
      { ..e, older: c.newest, newer: None },
    ),
    oldest: match c.oldest { None -> Some(key), Some(_) -> c.oldest },
    newest: Some(key),
    weight: c.weight + e.weight,
  }

fn filled(capacity: Int, keys: List<String>) -> Cache<String, Int> / {abort.raise} =
  keys.fold(lru(capacity), |c: Cache<String, Int>, key: String|
    put(c, key, key.len(), at_millis(0)))

test "a full cache evicts the entry used longest ago, and a read is a use" {
  let c = filled(2, ["a", "bb"]);
  assert_eq(keys(c), ["a", "bb"]);
  assert_eq(keys(put(c, "ccc", 3, at_millis(0))), ["bb", "ccc"]);
  let read = get(c, "a", at_millis(0));
  assert_eq(read.value, Some(1));
  assert_eq(keys(read.cache), ["bb", "a"]);
  assert_eq(keys(put(read.cache, "ccc", 3, at_millis(0))), ["a", "ccc"]);
  let written = put(c, "a", 10, at_millis(0));
  assert_eq(keys(written), ["bb", "a"]);
  assert_eq(peek(written, "a", at_millis(0)), Some(10));
  assert_eq(size(written), 2)
}

test "`get` returns the value, and the cache passed to it keeps its original eviction order" {
  let c = filled(2, ["a", "bb"]);
  assert_eq(get(c, "a", at_millis(0)).value, Some(1));
  assert_eq(get(c, "a", at_millis(0)).value, Some(1));
  assert_eq(keys(c), ["a", "bb"]);
  assert_eq(keys(put(c, "ccc", 3, at_millis(0))), ["bb", "ccc"])
}

test "a miss, a peek and a read of the newest entry leave the cache as it was" {
  let c = filled(3, ["a", "bb", "ccc"]);
  assert_eq(get(c, "zz", at_millis(0)), { value: None, cache: c });
  assert_eq(get(c, "ccc", at_millis(0)), { value: Some(3), cache: c });
  assert_eq(peek(c, "a", at_millis(0)), Some(1));
  assert(contains(c, "a", at_millis(0)));
  assert(!contains(c, "zz", at_millis(0)));
  assert_eq(remove(c, "zz"), c);
  assert_eq(keys(remove(c, "bb")), ["a", "ccc"]);
  assert_eq(keys(remove(remove(c, "a"), "ccc")), ["bb"]);
  assert_eq(clear(c), lru(3))
}

test "caches with the same entries in the same order are equal, however each was built" {
  let one = get(filled(3, ["a", "bb"]), "a", at_millis(0)).cache;
  let other = remove(put(filled(3, ["zz", "bb"]), "a", 1, at_millis(5)), "zz");
  assert_eq(keys(one), ["bb", "a"]);
  assert_eq(one, other);
  assert_eq(of_entries(3, None, entries_by_use(one)), one);
  assert(one != filled(3, ["a", "bb"]));
  assert(one != get(filled(4, ["a", "bb"]), "a", at_millis(0)).cache)
}

test "a cache with a weight limit evicts the oldest entries until a new entry fits" {
  let weighing = |c: Cache<String, Int>, key: String, weight: Int|
    insert(c, key, weight, { weight: weight, lifetime: None }, at_millis(0));
  let c = weighing(weighing(weighing(lru(10), "a", 4).cache, "b", 3).cache, "c", 3).cache;
  assert_eq(weight(c), 10);
  let pushed = weighing(c, "d", 5);
  assert_eq(pushed.evicted.map(|h: Entry<String, Int>| h.key), ["a", "b"]);
  assert_eq(keys(pushed.cache), ["c", "d"]);
  assert_eq(weight(pushed.cache), 8);
  let rejected = weighing(c, "b", 11);
  assert_eq(rejected.evicted, [{ key: "b", value: 11, weight: 11, expires: None }]);
  assert_eq(keys(rejected.cache), ["a", "c"]);
  assert_eq(weight(weighing(lru(10), "light", 0).cache), 1);
  let nothing: Cache<String, Int> = lru(0);
  assert_eq(size(put(nothing, "a", 1, at_millis(0))), 0)
}

test "an entry is returned until its deadline and never from then on" {
  let c = put(expiring(4, seconds(60)), "a", 1, at_millis(1000));
  assert_eq(lifetime(c), Some(seconds(60)));
  assert_eq(entries_by_use(c), [
    { key: "a", value: 1, weight: 1, expires: Some(at_millis(61000)) },
  ]);
  assert_eq(get(c, "a", at_millis(60999)).value, Some(1));
  assert_eq(peek(c, "a", at_millis(61000)), None);
  assert(!contains(c, "a", at_millis(61000)));
  let late = get(c, "a", at_millis(61000));
  assert_eq(late.value, None);
  assert_eq(size(late.cache), 0);
  assert_eq(size(c), 1);
  assert_eq(get(put(c, "a", 2, at_millis(61000)), "a", at_millis(120000)).value, Some(2))
}

test "an entry may have its own lifetime, and a sweep removes the entries past theirs" {
  let brief = { weight: 1, lifetime: Some(millis(10)) };
  let lasting = { weight: 1, lifetime: None };
  let c = insert(
    insert(put(expiring(4, seconds(1)), "a", 1, at_millis(0)), "b", 2, brief, at_millis(0)).cache,
    "c",
    3,
    lasting,
    at_millis(0),
  ).cache;
  assert_eq(keys(c), ["a", "b", "c"]);
  assert_eq(keys(sweep(c, at_millis(9))), ["a", "b", "c"]);
  assert_eq(keys(sweep(c, at_millis(10))), ["a", "c"]);
  assert_eq(entries_by_use(sweep(c, at_millis(1000))), [
    { key: "c", value: 3, weight: 1, expires: None },
  ]);
  let full = put(put(c, "d", 4, at_millis(20)), "e", 5, at_millis(20));
  assert_eq(keys(full), ["b", "c", "d", "e"]);
  assert_eq(get(full, "b", at_millis(20)).value, None)
}

effect directory {
  read name_of(id: Int) -> String
}

fn greeting(id: Int) -> String / {directory.name_of} = "hello " ++ directory.name_of(id)

test "a handler that stores a `Cache` in a `var` looks up each repeated id only once" {
  let none: Cache<Int, String> = lru(2);
  let run_script = handle {
    [1, 2, 1, 3, 2].map(greeting)
  } with {
    var state = { cache: none, looked_up: [] },
    directory.name_of(id) -> {
      let read = get(state.cache, id, at_millis(0));
      match read.value {
        Some(name) -> {
          state = { ..state, cache: read.cache };
          name
        },
        None -> {
          let name = "user " ++ id.to_string();
          state = {
            cache: put(read.cache, id, name, at_millis(0)),
            looked_up: state.looked_up.push(id),
          };
          name
        },
      }
    },
    return greetings -> { messages: greetings, state: state },
  };
  assert_eq(run_script.messages, [
    "hello user 1",
    "hello user 2",
    "hello user 1",
    "hello user 3",
    "hello user 2",
  ]);
  assert_eq(run_script.state.looked_up, [1, 2, 3, 2]);
  assert_eq(keys(run_script.state.cache), [3, 2])
}

fn acts() -> gen::Gen<Operation> =
  gen::one_of([
    gen::map2(gen::any_int(), gen::any_int(), |f0: Int, f1: Int| Put(f0, f1)),
    gen::map4(
      gen::any_int(),
      gen::any_int(),
      gen::any_int(),
      gen::any_int(),
      |f0: Int, f1: Int, f2: Int, f3: Int| Insert(f0, f1, f2, f3),
    ),
    gen::map(gen::any_int(), |f0: Int| Get(f0)),
    gen::map(gen::any_int(), |f0: Int| Remove(f0)),
    gen::map(gen::any_int(), |f0: Int| Wait(f0)),
    gen::constant(Sweep),
  ])

type Operation =
  | Put(Int, Int)
  | Insert(Int, Int, Int, Int)
  | Get(Int)
  | Remove(Int)
  | Wait(Int)
  | Sweep

type Model = { now: Int, entries: List<Entry<Int, Int>>, results: List<Option<Int>> }

type RunResult = { cache: Cache<Int, Int>, now: Int, results: List<Option<Int>> }

fn a_key(n: Int) -> Int = n & 3

fn a_weight(n: Int) -> Int = (n & 3) + 1

fn a_lifetime_millis(n: Int) -> Option<Int> = if n & 7 == 0 { None } else { Some(n & 7) }

fn span_of(ms: Option<Int>) -> Option<Duration> =
  match ms { None -> None, Some(n) -> Some(millis(n)) }

fn run_script(lifetime: Option<Int>, script: List<Operation>) -> RunResult / {abort.raise} =
  script.fold(
    { cache: of_entries(3, span_of(lifetime), []), now: 0, results: [] },
    |r: RunResult, a: Operation|
      match a {
        Put(key, value) -> { ..r, cache: put(r.cache, a_key(key), value, at_millis(r.now)) },
        Insert(key, value, weight, life) ->
          {
            ..r,
            cache: insert(
              r.cache,
              a_key(key),
              value,
              { weight: a_weight(weight), lifetime: span_of(a_lifetime_millis(life)) },
              at_millis(r.now),
            ).cache,
          },
        Get(key) -> {
          let read = get(r.cache, a_key(key), at_millis(r.now));
          { ..r, cache: read.cache, results: r.results.push(read.value) }
        },
        Remove(key) -> { ..r, cache: remove(r.cache, a_key(key)) },
        Wait(ms) -> { ..r, now: r.now + (ms & 3) },
        Sweep -> { ..r, cache: sweep(r.cache, at_millis(r.now)) },
      },
  )

fn observed(lifetime: Option<Int>, script: List<Operation>) -> Model / {abort.raise} = {
  let r = run_script(lifetime, script);
  { now: r.now, entries: entries_by_use(r.cache), results: r.results }
}

fn deadline(now: Int, lifetime: Option<Int>) -> Option<Instant> =
  match lifetime { None -> None, Some(ms) -> Some(at_millis(now + ms)) }

fn is_expired_at(h: Entry<Int, Int>, now: Int) -> Bool =
  match h.expires { None -> false, Some(Instant(nanoseconds)) -> now * 1000000 >= nanoseconds }

fn without(entries_by_use: List<Entry<Int, Int>>, key: Int) -> List<Entry<Int, Int>> =
  entries_by_use.filter(|h: Entry<Int, Int>| h.key != key)

fn total_weight(entries_by_use: List<Entry<Int, Int>>) -> Int =
  entries_by_use.fold(0, |total: Int, h: Entry<Int, Int>| total + h.weight)

fn trimmed(entries_by_use: List<Entry<Int, Int>>) -> List<Entry<Int, Int>> =
  match entries_by_use {
    [_, ..rest] if total_weight(entries_by_use) > 3 -> trimmed(rest),
    _ -> entries_by_use,
  }

fn model_insert(
  entries_by_use: List<Entry<Int, Int>>,
  h: Entry<Int, Int>,
) -> List<Entry<Int, Int>> =
  if h.weight > 3 { without(entries_by_use, h.key) }
  else { trimmed(without(entries_by_use, h.key).push(h)) }

fn model_step(lifetime: Option<Int>, m: Model, a: Operation) -> Model =
  match a {
    Put(key, value) ->
      {
        ..m,
        entries: model_insert(m.entries, {
          key: a_key(key),
          value: value,
          weight: 1,
          expires: deadline(m.now, lifetime),
        }),
      },
    Insert(key, value, weight, life) ->
      {
        ..m,
        entries: model_insert(m.entries, {
          key: a_key(key),
          value: value,
          weight: a_weight(weight),
          expires: deadline(m.now, a_lifetime_millis(life)),
        }),
      },
    Get(key) -> match m.entries.filter(|h: Entry<Int, Int>| h.key == a_key(key)) {
      [h, ..] -> if is_expired_at(h, m.now) {
        { ..m, entries: without(m.entries, h.key), results: m.results.push(None) }
      } else {
        { ..m, entries: without(m.entries, h.key).push(h), results: m.results.push(Some(h.value)) }
      },
      [] -> { ..m, results: m.results.push(None) },
    },
    Remove(key) -> { ..m, entries: without(m.entries, a_key(key)) },
    Wait(ms) -> { ..m, now: m.now + (ms & 3) },
    Sweep -> { ..m, entries: m.entries.filter(|h: Entry<Int, Int>| !is_expired_at(h, m.now)) },
  }

test "applying a sequence of cache operations gives the same result as applying them to a list ordered by recent use" {
  gen::check2(gen::list(acts()), acts(), |x: List<Operation>, y: Operation|
    refines(
      |script: List<Operation>| observed(None, script),
      |script: List<Operation>, a: Operation| script.push(a),
      |m: Model, a: Operation| model_step(None, m, a),
      x,
      y,
    ))
}

test "after any operations, a cache's total entry weight is at most its capacity, and every entry weighs at least one" {
  gen::check2(gen::list(acts()), gen::any_int(), |script: List<Operation>, lived: Int| {
    let c = run_script(a_lifetime_millis(lived), script).cache;
    weight(c) <= capacity(c) && size(c) <= weight(c) && weight(c) == total_weight(entries_by_use(c))
      && entries_by_use(c).len() == size(c)
  })
}

test "an entry is never returned from its deadline on" {
  gen::check3(
    gen::list(acts()),
    gen::any_int(),
    gen::any_int(),
    |script: List<Operation>, lived: Int, later: Int| {
      let c = run_script(a_lifetime_millis(lived), script).cache;
      entries_by_use(c).fold(true, |ok: Bool, h: Entry<Int, Int>|
        ok
          && (match h.expires {
            None -> true,
            Some(due) -> {
              let now = after(due, nanos(later & 0xFFFF));
              get(c, h.key, now).value == None && peek(c, h.key, now) == None
                && !contains(c, h.key, now)
                && size(sweep(c, now)) < size(c)
            },
          }))
    },
  )
}
