//! What a computation costs, which a test reads, and whether the steps it takes keep pace with a
//! bound as its size doubles.
//!
//! `spent` answers what a function cost in what the runtime counts rather than in time: the calls
//! it made, the objects it allocated and the bytes those took. It reads them through `meter`, which
//! only `ply test` answers: any other run fails at its first reading with `E0424`, since what a
//! computation costs is its compiler's to choose, and no program's answer may hang on it.
//!
//! `paced` runs a body at the sizes 1, 2, 4 … 4096, counting its steps as `spent` does, and asserts
//! they grow no faster than the bound over the last two spans between the sizes it read, so
//! constant factors and lower-order terms do not count. It is a test's evidence about the sizes it
//! ran and no proof: a bound on every call is a `cost` clause, which `ply prove` proves or refuses.
//!
//! This module imports only `std.internal.native`, so that any module may import it to test
//! itself but the home modules and those beneath them, which it reads with no import.

import std.internal.native (native)

/// What a test's run has cost so far.
pub effect meter {
  /// The calls the run has made, each counted as `--steps` counts them, the objects it allocated
  /// and the bytes those took, since it began.
  read reading() -> Cost
}

/// What a computation cost: its calls, the objects it allocated and the bytes those took, which an
/// update in place does not spend and a copy does.
pub type Cost = { steps: Int, allocations: Int, bytes: Int }

/// What `f()` answers, beside what it cost: the calls it made, its own among them, the objects it
/// allocated and the bytes those took. A memoized constant costs what computing it costs, whether
/// or not an earlier call computed it; a `const fn` a build kept costs nothing to read; and what a
/// region's scheduler does to answer a task's operations costs nothing, nor does reading the meter.
pub fn spent<a | e>(
  f: () -> a / e,
) -> { value: a, steps: Int, allocations: Int, bytes: Int } / {meter.read | e} = {
  let before = meter.reading();
  let value = f();
  let after = meter.reading();
  // Only a reading lies between `after` and `again`, and `after - before` holds one as well.
  let again = meter.reading();
  {
    value: value,
    steps: after.steps - before.steps - (again.steps - after.steps),
    allocations: after.allocations - before.allocations - (again.allocations - after.allocations),
    bytes: after.bytes - before.bytes - (again.bytes - after.bytes),
  }
}

/// One size a body was run at: the steps it took there, and its bound there.
pub type Measure = { size: Int, steps: Int, bound: Int }

/// Every power of two up to 4096.
pub fn sizes() -> List<Int> = range(0, 13).map(|k: Int| 1 << k)

/// A size that took more steps than this is the last one run, so a test of a steep bound stays
/// quick: its pace is read off the sizes below.
pub fn size_limit() -> Int = 200000

/// Two spans are what a verdict reads, so fewer sizes than this decide nothing.
pub fn least_sizes() -> Int = 3

/// Whether the steps outgrew the bound: they grew past the slack over both of the last two spans.
/// One span alone is not enough, since a body can change strategies at one size. Fewer than
/// `least_sizes` measures outgrow nothing.
pub fn outgrown(measures: List<Measure>) -> Bool = {
  let n = measures.len();
  let at = |i: Int| match measures.at(i) { Some(m) -> m, None -> { size: 0, steps: 0, bound: 0 } };
  n >= least_sizes() && outgrew(at(n - 3), at(n - 2)) && outgrew(at(n - 2), at(n - 1))
}

/// 2^0.05: how much faster than the bound a doubling may grow the steps.
fn slack() -> Float = 1.0352649238413776

fn outgrew(was: Measure, now: Measure) -> Bool = {
  let allowed = range(0, doublings(was.size, now.size)).fold(1.0, |a: Float, _i: Int| a * slack());
  Float::of_int(now.steps) * Float::of_int(was.bound)
    > Float::of_int(was.steps) * Float::of_int(now.bound) * allowed
}

/// A positive `Int` doubled 63 times is past any other.
fn doublings(from: Int, to: Int) -> Int =
  range(0, 64).fold({ at: from, n: 0 }, |s: { at: Int, n: Int }, _round: Int|
    if s.at <= 0 || s.at >= to { s } else { { at: s.at * 2, n: s.n + 1 } }).n

/// The steps `body` takes at each of `sizes` from `least` up whose bound is positive, in order,
/// ending after the first that takes more than `size_limit` steps.
pub fn measured<a | e>(
  least: Int,
  bound: (Int) -> Int / {abort.raise},
  body: (Int) -> a / e,
) -> List<Measure> / {meter.read, abort.raise | e} =
  sizes().filter(|n: Int| n >= least).fold(
    { measures: [], spent: false },
    |acc: { measures: List<Measure>, spent: Bool }, n: Int|
      if acc.spent { acc } else {
        let allowed = bound(n);
        if allowed <= 0 { acc } else {
          let steps = spent(|| body(n)).steps;
          {
            measures: acc.measures.push({ size: n, steps: steps, bound: allowed }),
            spent: steps > size_limit(),
          }
        }
      },
  ).measures

fn lines(measures: List<Measure>) -> String =
  measures.fold("", |acc: String, m: Measure|
    (if acc == "" { "" } else { acc ++ "; " }) ++ "at " ++ m.size.to_string() ++ ": "
      ++ m.steps.to_string()
      ++ " steps, bound "
      ++ m.bound.to_string())

/// Asserts the steps `body` takes grow no faster than `bound` does as the size doubles from 1 to
/// 4096, give or take a twentieth of a doubling over each of the last two spans read. A size whose
/// bound is not positive is not run. The test fails where the steps outgrew the bound over both
/// spans, and where fewer than three sizes were read, naming every size with its steps and bound.
pub fn paced<a | e>(
  bound: (Int) -> Int / {abort.raise},
  body: (Int) -> a / e,
) -> Unit / {meter.read, abort.raise | e} = paced_from(1, bound, body)

/// `paced` over the sizes from `least` up.
pub fn paced_from<a | e>(
  least: Int,
  bound: (Int) -> Int / {abort.raise},
  body: (Int) -> a / e,
) -> Unit / {meter.read, abort.raise | e} = held(measured(least, bound, body))

fn held(measures: List<Measure>) -> Unit / {abort.raise} =
  if measures.len() < least_sizes() {
    panic(
      "too few sizes to read a pace from, which takes " ++ least_sizes().to_string() ++ ": "
        ++ lines(measures),
    )
  } else if outgrown(measures) { panic("the steps outgrew the bound: " ++ lines(measures)) }
  else { () }

// --- The real handler -------------------------------------------------------

host for meter by served

/// `go` with its readings answered by the runtime, which answers them in a test's run alone.
fn served<a | e>(go: () -> a / {meter.read | e}) -> a / {native.read | e} =
  handle {
    go()
  } with {
    meter.reading() ->
      { steps: meter_steps(), allocations: meter_allocations(), bytes: meter_bytes() },
  }

extern fn meter_steps() -> Int / {native.read}

extern fn meter_allocations() -> Int / {native.read}

extern fn meter_bytes() -> Int / {native.read}

// --- Tests ------------------------------------------------------------------

fn measured_by(steps: (Int) -> Int, bound: (Int) -> Int) -> List<Measure> =
  sizes().map(|n: Int| { size: n, steps: steps(n), bound: bound(n) })

fn ilog2(n: Int) -> Int =
  range(0, 63).fold(0, |k: Int, i: Int| if n >> i + 1 > 0 { i + 1 } else { k })

fn failure(run: () -> Unit / {meter.read, abort.raise}) -> Option<String> / {meter.read} =
  handle { run() } with { abort.raise(message) -> Some(message), return _done -> None }

fn total(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + x)

fn pairs(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + total(xs) * x)

test "the sizes are the powers of two up to 4096" {
  assert_eq(sizes().len(), 13);
  assert_eq(sizes().at(0), Some(1));
  assert_eq(sizes().at(12), Some(4096))
}

test "a linear count under a linear bound holds, whatever its constants" {
  assert(!outgrown(measured_by(|n: Int| 5 * n + 1000, |n: Int| n)));
  assert(!outgrown(measured_by(|n: Int| 3 * n, |n: Int| n)));
  // Growing more slowly than the bound is within it.
  assert(!outgrown(measured_by(|n: Int| 7, |n: Int| n)))
}

test "a count growing faster than its bound is outgrown, and one matching it is not" {
  assert(outgrown(measured_by(|n: Int| n * n, |n: Int| n)));
  assert(!outgrown(measured_by(|n: Int| 2 * n * n + n, |n: Int| n * n)));
  assert(outgrown(measured_by(|n: Int| n * ilog2(n) + n, |n: Int| n)));
  assert(
    !outgrown(
      measured_by(|n: Int| n * ilog2(n) + n, |n: Int| n * ilog2(n)).filter(|m: Measure|
        m.bound > 0),
    ),
  );
  // A constant bound is outgrown by anything that grows.
  assert(outgrown(measured_by(|n: Int| n, |n: Int| 1)))
}

test "only the last two spans decide, so a body that changes strategy at one size still holds" {
  // Quadratic until 64, then linear: the tail is what the bound is about.
  assert(!outgrown(measured_by(|n: Int| if n <= 64 { n * n } else { 64 * n }, |n: Int| n)));
  // One span past the slack is not two.
  assert(!outgrown(measured_by(|n: Int| if n < 4096 { n } else { 3 * n }, |n: Int| n)))
}

test "a span over a skipped size allows its doublings, and too few sizes decide nothing" {
  let skipping = [
    { size: 1, steps: 1, bound: 1 },
    { size: 4, steps: 4, bound: 4 },
    { size: 16, steps: 16, bound: 16 },
  ];
  assert(!outgrown(skipping));
  assert(outgrown(skipping.map(|m: Measure| { ..m, steps: m.size * m.size })));
  assert(!outgrown([{ size: 1, steps: 1, bound: 1 }, { size: 2, steps: 100, bound: 1 }]))
}

test "a body is run at each size from the least whose bound is positive" {
  let body = |n: Int| total(range(0, n));
  let read = measured(2, |n: Int| if n == 8 { 0 } else { n }, body);
  assert_eq(read.map(|m: Measure| m.size), [2, 4, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096]);
  assert_eq(read.at(0), Some({ size: 2, steps: spent(|| body(2)).steps, bound: 2 }))
}

type Chain = | Link(Int, Chain) | End

fn chain(n: Int) -> Chain = if n <= 0 { End } else { Link(n, chain(n - 1)) }

test "a call is a step and an object built an allocation, and reading the meter costs nothing" {
  let small = spent(|| chain(10));
  let large = spent(|| chain(20));
  assert_eq([large.steps - small.steps, large.allocations - small.allocations, large.bytes], [
    10,
    10,
    2 * small.bytes,
  ]);
  let nothing = spent(|| 7);
  assert_eq([nothing.value, nothing.allocations, nothing.bytes], [7, 0, 0]);
  // The one step there may be is the call of the function itself.
  assert(nothing.steps == 0 || nothing.steps == 1, Some(nothing.steps.to_string()))
}

test "a body that keeps pace passes, and one that outgrows its bound fails naming its sizes" {
  assert_eq(failure(|| paced(|n: Int| n, |n: Int| total(range(0, n)))), None);
  assert_eq(failure(|| paced(|n: Int| n * n, |n: Int| pairs(range(0, n)))), None);
  let outgrew = failure(|| paced(|n: Int| n, |n: Int| pairs(range(0, n))));
  assert(match outgrew {
    // A steep body stops at the first size past the limit, which is what keeps this quick.
    Some(message) ->
      message.starts_with("the steps outgrew the bound: at 1: ")
        && !message.contains("; at 4096: "),
    None -> false,
  });
  let few = failure(|| paced_from(2048, |n: Int| n, |n: Int| total(range(0, n))));
  assert(match few {
    Some(message) -> message.starts_with("too few sizes to read a pace from, which takes 3: "),
    None -> false,
  })
}
