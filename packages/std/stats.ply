//! Summaries of numeric data: where it centres, how far it spreads, where a share of it lies, and
//! how two runs of it move together.
//!
//! Every result over `Float`s is exact, rounded once. Every `Float` is a whole number times one
//! fixed power of two, so a sum of them, of their squares or of their products can be stored as one
//! whole number (a `BigInt`) times a power of two, with no rounding at all. A mean, a variance, a
//! quantile between two data points or the slope of a line is the true value of its formula over
//! the data, rounded to the nearest `Float` at the end. The order of the data, and how a run is
//! split and its parts merged, change no bit of a result. A `Tally` is built in one pass, merging
//! two gives the tally of both runs, and `merge` is associative with `empty` as its identity. So
//! `std.parallel`'s `par_fold` gives the same summary that `List::fold` does. A result past the
//! greatest `Float` is an infinity.
//!
//! The data are finite numbers. A NaN or an infinity is not a valid data point: every function here
//! returns `None` for data that contain one, as it does for no data at all. A `Tally` counts such
//! numbers separately, as `flawed`. A variance is named for what it divides by.
//! `population_variance` divides by the count, for data that are the whole of what they describe.
//! `sample_variance` divides by one less, for a sample of something larger.
//!
//! A quantile is requested as a ratio, `quantile(xs, 99, 100)`, so the share is exact too. It is
//! computed by one of the nine methods Hyndman and Fan numbered, which `Method` names as R does.
//! `mode` and `modes` count any values that can be ordered, not only numbers. They do not accept
//! `Float`, which cannot be used as a map key.

import std.bigint
import std.bigint (BigInt)
import std.float
import std.laws (refines)
import std.list (zip)
import std.map
import std.math (bit_length, div_floor, even, ilog2, rem_floor, trailing_zeros)
import std.parallel (grain_size, par_fold)
import std.gen

/// How a quantile is computed when it falls between two data points: Hyndman and Fan's nine
/// methods, named `R1` to `R9` as R numbers them. With `n` data in ascending order and a share `p`,
/// each method picks the datum at a position `h`, counting from one, or a value between two
/// neighbouring data.
pub type Method =
  /// The inverse of the empirical distribution: the datum at `n * p`, rounded up.
  | R1
  /// Like `R1`, but where `n * p` is a whole number, returns the mean of the datum at that position
  /// and the next one.
  | R2
  /// The datum nearest `n * p`, taking the even position when two are equally near.
  | R3
  /// Between the data either side of `n * p`.
  | R4
  /// Between the data either side of `n * p + 1/2`: Hazen's.
  | R5
  /// Between the data either side of `(n + 1) * p`: Weibull's, and Python's `exclusive`.
  | R6
  /// Between the data either side of `(n - 1) * p + 1`: the default in R, NumPy and spreadsheets,
  /// and Python's `inclusive`.
  | R7
  /// Between the data either side of `(n + 1/3) * p + 1/3`: median-unbiased whatever the
  /// distribution.
  | R8
  /// Between the data either side of `(n + 1/4) * p + 3/8`: unbiased for normal data.
  | R9

/// A summary of a run of numbers.
pub type Summary = new {
  /// How many numbers there are: at least one.
  count: Int,
  minimum_sizes: Float,
  greatest: Float,
  sum: Float,
  mean: Float,
  /// The mean square of the distances from the mean.
  population_variance: Float,
  /// The sum of the squares of the distances from the mean, divided by one less than the count. It
  /// is `None` for a single number, which has no spread to estimate.
  sample_variance: Option<Float>,
}

/// A run of numbers added one at a time, in space that does not grow with their count: how many
/// there were, the least and the greatest, and their exact sum and sum of squares. Two tallies of
/// the same numbers are equal, whatever order and grouping added them.
pub type Tally = new {
  /// How many finite numbers were added.
  count: Int,
  /// How many numbers added were a NaN or an infinity. If this is above zero, `summary` returns
  /// `None`.
  flawed: Int,
  minimum_sizes: Float,
  greatest: Float,
  sum: { units: BigInt, scale: Int },
  squares: { units: BigInt, scale: Int },
}

/// Data counted between edges: how many fell in each bin, in the edges' order, and how many fell
/// below the first edge and above the last.
pub type Histogram = new { below: Int, counts: List<Int>, above: Int }

/// The line `y = slope * x + intercept`.
pub type Line = new { slope: Float, intercept: Float }

/// The tally of no numbers: `merge`'s identity.
pub const empty: Tally =
  {
    count: 0,
    flawed: 0,
    minimum_sizes: Float::infinity(),
    greatest: Float::neg_infinity(),
    sum: exact_zero,
    squares: times(exact_zero, exact_zero),
  }

/// `t` with `x` added.
pub fn push(t: Tally, x: Float) -> Tally =
  if !x.is_finite() { { ..t, flawed: t.flawed + 1 } } else {
    let exact_value = exact(x);
    {
      count: t.count + 1,
      flawed: t.flawed,
      minimum_sizes: lower(t.minimum_sizes, x),
      greatest: higher(t.greatest, x),
      sum: plus(t.sum, exact_value),
      squares: plus(t.squares, times(exact_value, exact_value)),
    }
  }

/// The tally of everything added to `a` and `b`: what one tally would contain had both runs been
/// added to it. Associative, and `empty` changes nothing on either side.
pub fn merge(a: Tally, b: Tally) -> Tally =
  {
    count: a.count + b.count,
    flawed: a.flawed + b.flawed,
    minimum_sizes: lower(a.minimum_sizes, b.minimum_sizes),
    greatest: higher(a.greatest, b.greatest),
    sum: plus(a.sum, b.sum),
    squares: plus(a.squares, b.squares),
  }

/// The tally of `xs`, in one pass.
pub fn tally(xs: List<Float>) -> Tally = xs.fold(empty, push)

/// The summary of the numbers added to `t`. `None` if there were none, or if one was a NaN or an
/// infinity.
pub fn summary(t: Tally) -> Option<Summary> =
  if t.count == 0 || t.flawed > 0 { None } else {
    Some({
      count: t.count,
      minimum_sizes: t.minimum_sizes,
      greatest: t.greatest,
      sum: ratio(t.sum, whole(1)),
      mean: ratio(t.sum, whole(t.count)),
      population_variance: ratio(scaled_variance(t), int_product(t.count, t.count)),
      sample_variance: if t.count < 2 { None }
      else { Some(ratio(scaled_variance(t), int_product(t.count, t.count - 1))) },
    })
  }

/// The summary of `xs`, in one pass: `summary` of their `tally`.
pub fn summarize(xs: List<Float>) -> Option<Summary> = summary(tally(xs))

fn scaled_variance(t: Tally) -> Exact = minus(times(whole(t.count), t.squares), times(t.sum, t.sum))

fn lower(a: Float, b: Float) -> Float =
  if b < a || (b == a && b.is_sign_negative()) { b } else { a }

fn higher(a: Float, b: Float) -> Float =
  if b > a || (b == a && !b.is_sign_negative()) { b } else { a }

/// The sum of `xs`, exact and rounded once, so neither the order of the numbers nor cancellation
/// among them changes it. Zero for no numbers. `None` if one is a NaN or an infinity.
pub fn sum(xs: List<Float>) -> Option<Float> = {
  let t = tally(xs);
  if t.flawed > 0 { None } else { Some(ratio(t.sum, whole(1))) }
}

/// The arithmetic mean: the sum over the count.
pub fn mean(xs: List<Float>) -> Option<Float> =
  match usable(tally(xs), 1) { Some(t) -> Some(ratio(t.sum, whole(t.count))), None -> None }

/// The mean square of the distances from the mean, for data that are the whole population.
pub fn population_variance(xs: List<Float>) -> Option<Float> =
  match usable(tally(xs), 1) {
    Some(t) -> Some(ratio(scaled_variance(t), int_product(t.count, t.count))),
    None -> None,
  }

/// Returns the sum of the squares of the distances from the mean, divided by one less than the
/// count. This estimates the variance of what `xs` is a sample of. It is `None` for fewer than two
/// numbers.
pub fn sample_variance(xs: List<Float>) -> Option<Float> =
  match usable(tally(xs), 2) {
    Some(t) -> Some(ratio(scaled_variance(t), int_product(t.count, t.count - 1))),
    None -> None,
  }

/// The square root of `population_variance`, in the data's own unit.
pub fn population_stdev(xs: List<Float>) -> Option<Float> =
  match population_variance(xs) { Some(v) -> Some(v.sqrt()), None -> None }

/// The square root of `sample_variance`. `None` for fewer than two numbers.
pub fn sample_stdev(xs: List<Float>) -> Option<Float> =
  match sample_variance(xs) { Some(v) -> Some(v.sqrt()), None -> None }

/// The least of `xs`.
pub fn least(xs: List<Float>) -> Option<Float> =
  if nonempty_and_finite(xs) { Some(xs.fold(Float::infinity(), lower)) } else { None }

/// The greatest of `xs`.
pub fn greatest(xs: List<Float>) -> Option<Float> =
  if nonempty_and_finite(xs) { Some(xs.fold(Float::neg_infinity(), higher)) } else { None }

/// The range of `xs`: the greatest less the least.
pub fn spread(xs: List<Float>) -> Option<Float> =
  if nonempty_and_finite(xs) {
    Some(xs.fold(Float::neg_infinity(), higher) - xs.fold(Float::infinity(), lower))
  } else { None }

/// The value or values that occur most often, each once, in the order they first occur; none
/// for no values.
pub fn modes<a>(xs: List<a>) -> List<a>
  where derivable(ord, a)
= {
  let counts = List::frequencies(xs);
  let most = counts.fold(0, |best: Int, _: a, times_seen: Int| max(best, times_seen));
  xs.filter(|x: a| counts.get_or(x, 0) == most).unique()
}

/// The value that occurs most often, or the first of them when several tie.
pub fn mode<a>(xs: List<a>) -> Option<a>
  where derivable(ord, a)
= modes(xs).first()

fn usable(t: Tally, least_count: Int) -> Option<Tally> =
  if t.count < least_count || t.flawed > 0 { None } else { Some(t) }

fn nonempty_and_finite(xs: List<Float>) -> Bool = xs.len() > 0 && xs.all(Float::is_finite)

/// The middle of `xs` in order: the middle number of an odd count, and the mean of the middle
/// two of an even one.
pub fn median(xs: List<Float>) -> Option<Float> / {abort.raise} = quantile(xs, 1, 2, R6)

/// The middle of `xs` in order, and the lower of the middle two of an even count: always one of
/// the data.
pub fn median_low(xs: List<Float>) -> Option<Float> / {abort.raise} = quantile(xs, 1, 2, R1)

/// The middle of `xs` in order, and the higher of the middle two of an even count.
pub fn median_high(xs: List<Float>) -> Option<Float> =
  match sorted_finite(xs) {
    Some(sorted) -> Some(datum_at(sorted, sorted.len() / 2 + 1)),
    None -> None,
  }

/// Returns the value at the fraction `part / parts` of the way through the sorted `xs`, using
/// `method`. For example, the median is `quantile(xs, 1, 2)` and the 99.9th percentile is
/// `quantile(xs, 999, 1000)`. When that position lies between two data points, the result is their
/// exact weighted mean, rounded to a `Float` once. Returns `None` if `parts` is below one or above
/// `2^59`, if `part` is below zero or above `parts`, or if `xs` contains a NaN or an infinity.
pub fn quantile(
  xs: List<Float>,
  part: Int,
  parts: Int,
  method: Method = R7,
) -> Option<Float> / {abort.raise} =
  if parts < 1 || parts > 1 << 59 || part < 0 || part > parts { None } else {
    match sorted_finite(xs) {
      Some(sorted) -> Some(sorted_quantile(sorted, part, parts, method)),
      None -> None,
    }
  }

/// The value `percent` hundredths of the way through `xs` in order: `quantile(xs, percent, 100)`.
pub fn percentile(
  xs: List<Float>,
  percent: Int,
  method: Method = R7,
) -> Option<Float> / {abort.raise} = quantile(xs, percent, 100, method)

/// The `parts - 1` values that cut `xs` in order into `parts` equal shares: three quartiles for
/// four, ninety-nine percentiles for a hundred. `None` for a `parts` below one or above `2^59`.
pub fn quantiles(
  xs: List<Float>,
  parts: Int,
  method: Method = R7,
) -> Option<List<Float>> / {abort.raise} =
  if parts < 1 || parts > 1 << 59 { None } else {
    match sorted_finite(xs) {
      Some(sorted) ->
        Some(range(1, parts).map(|part: Int| sorted_quantile(sorted, part, parts, method))),
      None -> None,
    }
  }

/// How many of `xs` fall in each bin that `edges` mark. The bin from one edge to the next counts
/// values at least the first edge and below the second, and the last bin includes its upper edge
/// too. Values below the first edge or above the last are counted separately, so nothing goes
/// uncounted. `None` for fewer than two edges, edges that do not ascend, or a NaN or an infinity
/// in either list. With no data, every count is zero.
pub fn histogram(xs: List<Float>, edges: List<Float>) -> Option<Histogram> = {
  let bins = edges.len() - 1;
  let ascending = range(0, bins).all(|i: Int| edges.at_or(i, 0.0) < edges.at_or(i + 1, 0.0));
  if bins < 1 || !ascending || !edges.all(Float::is_finite) || !xs.all(Float::is_finite) { None }
  else {
    let last = edges.at_or(bins, 0.0);
    Some({
      below: xs.count(|x: Float| x < edges.at_or(0, 0.0)),
      counts: range(0, bins).map(|i: Int|
        xs.count(|x: Float|
          x >= edges.at_or(i, 0.0)
            && (x < edges.at_or(i + 1, 0.0) || (i == bins - 1 && x == last)))),
      above: xs.count(|x: Float| x > last),
    })
  }
}

fn sorted_finite(xs: List<Float>) -> Option<List<Float>> =
  if nonempty_and_finite(xs) { Some(xs.sort_by(|a: Float, b: Float| a < b)) } else { None }

fn datum_at(sorted: List<Float>, k: Int) -> Float =
  sorted.at_or(max(1, min(k, sorted.len())) - 1, 0.0)

fn sorted_quantile(
  sorted: List<Float>,
  part: Int,
  parts: Int,
  method: Method,
) -> Float / {abort.raise} = {
  let place = place_of(method, sorted.len(), part, parts);
  let j = Int::of_i128(div_floor(place.over, place.under));
  let past = Int::of_i128(rem_floor(place.over, place.under));
  let under = Int::of_i128(place.under);
  let here = datum_at(sorted, j);
  let next = datum_at(sorted, j + 1);
  match method {
    R1 -> if past == 0 { here } else { next },
    R2 -> if past == 0 { ratio(plus(exact(here), exact(next)), whole(2)) } else { next },
    R3 -> if past == 0 && even(j) { here } else { next },
    _ -> if past == 0 { here } else {
      ratio(
        plus(times(exact(here), whole(under - past)), times(exact(next), whole(past))),
        whole(under),
      )
    },
  }
}

fn place_of(method: Method, n: Int, part: Int, parts: Int) -> { over: I128, under: I128 } = {
  let count = I128::of_int(n);
  let i = I128::of_int(part);
  let of = I128::of_int(parts);
  match method {
    R1 | R2 | R4 -> { over: count * i, under: of },
    R3 -> { over: 2i128 * count * i - of, under: 2i128 * of },
    R5 -> { over: 2i128 * count * i + of, under: 2i128 * of },
    R6 -> { over: (count + 1i128) * i, under: of },
    R7 -> { over: (count - 1i128) * i + of, under: of },
    R8 -> { over: (3i128 * count + 1i128) * i + of, under: 3i128 * of },
    R9 -> { over: (8i128 * count + 2i128) * i + 3i128 * of, under: 8i128 * of },
  }
}

/// The sample covariance of `xs` and `ys`: the products of their distances from their means,
/// summed and divided by one less than the count. `None` for lists of different lengths, for fewer
/// than two pairs, and if a number is a NaN or an infinity.
pub fn covariance(xs: List<Float>, ys: List<Float>) -> Option<Float> =
  match paired_sums(xs, ys) {
    Some(p) -> Some(ratio(p.xy, int_product(p.count, p.count - 1))),
    None -> None,
  }

/// Returns Pearson's correlation of `xs` and `ys`, from `-1.0` to `1.0`. It computes the square of
/// the correlation exactly, rounds it to a `Float`, takes the square root, and gives the result the
/// sign of the covariance. So data that lie exactly on a line give `1.0` or `-1.0`. Returns `None`
/// where `covariance` does, and when either list is one number repeated.
pub fn correlation(xs: List<Float>, ys: List<Float>) -> Option<Float> =
  match paired_sums(xs, ys) {
    None -> None,
    Some(p) -> if is_exact_zero(p.x_squares) || is_exact_zero(p.yy) { None } else {
      let size = ratio(times(p.xy, p.xy), times(p.x_squares, p.yy)).sqrt();
      Some(if bigint::is_negative(p.xy.units) { 0.0 - size } else { size })
    },
  }

/// The least-squares line through the points that `xs` and `ys` pair up: the slope and intercept
/// that minimize the sum of the squared distances of the `ys` from it. `None` where `covariance`
/// is `None`, and when the `xs` are one number repeated, since no slope follows from them.
pub fn linear_regression(xs: List<Float>, ys: List<Float>) -> Option<Line> =
  match paired_sums(xs, ys) {
    None -> None,
    Some(p) -> if is_exact_zero(p.x_squares) { None } else {
      Some({
        slope: ratio(p.xy, p.x_squares),
        intercept: ratio(
          minus(times(p.y, p.x_squares), times(p.xy, p.x)),
          times(whole(p.count), p.x_squares),
        ),
      })
    },
  }

type PairedSums = { count: Int, x: Exact, y: Exact, x_squares: Exact, yy: Exact, xy: Exact }

fn paired_sums(xs: List<Float>, ys: List<Float>) -> Option<PairedSums> =
  if xs.len() != ys.len() || xs.len() < 2 || !xs.all(Float::is_finite)
      || !ys.all(Float::is_finite) { None } else {
    let n = whole(xs.len());
    let x = total(xs, xs, false);
    let y = total(ys, ys, false);
    Some({
      count: xs.len(),
      x: x,
      y: y,
      x_squares: minus(times(n, total(xs, xs, true)), times(x, x)),
      yy: minus(times(n, total(ys, ys, true)), times(y, y)),
      xy: minus(times(n, total(xs, ys, true)), times(x, y)),
    })
  }

fn total(xs: List<Float>, ys: List<Float>, products: Bool) -> Exact =
  zip(xs, ys).fold(exact_zero, |accumulator: Exact, pair: { first: Float, second: Float }|
    plus(accumulator, if products { times(exact(pair.first), exact(pair.second)) }
    else { exact(pair.first) }))

type Exact = { units: BigInt, scale: Int }

const exact_zero: Exact = { units: bigint::zero, scale: 1024 }

fn is_exact_zero(a: Exact) -> Bool = bigint::is_zero(a.units)

fn whole(n: Int) -> Exact = { units: bigint::of_int(n), scale: 0 }

fn int_product(a: Int, b: Int) -> Exact = times(whole(a), whole(b))

fn exact(x: Float) -> Exact = {
  let bits = bits_of_float(x);
  let biased = bits >>> 52 & 0x7FF;
  let digits = if biased == 0 { bits & 0x000F_FFFF_FFFF_FFFF }
  else { bits & 0x000F_FFFF_FFFF_FFFF | 0x0010_0000_0000_0000 };
  if digits == 0 { exact_zero } else {
    let even_bits = trailing_zeros(digits);
    let odd = digits >> even_bits;
    {
      units: bigint::of_int(if bits < 0 { 0 - odd } else { odd }),
      scale: max(biased, 1) - 1075 + even_bits,
    }
  }
}

fn plus(a: Exact, b: Exact) -> Exact = {
  let scale = min(a.scale, b.scale);
  {
    units: bigint::shift_left(a.units, a.scale - scale)
      + bigint::shift_left(b.units, b.scale - scale),
    scale: scale,
  }
}

fn minus(a: Exact, b: Exact) -> Exact = plus(a, { units: -b.units, scale: b.scale })

fn times(a: Exact, b: Exact) -> Exact = { units: a.units * b.units, scale: a.scale + b.scale }

fn ratio(n: Exact, d: Exact) -> Float =
  if is_exact_zero(n) { 0.0 } else {
    let over = bigint::abs_value(n.units);
    let lift = 58 - (bigint::bit_length(over) - bigint::bit_length(d.units));
    let cut = bigint::shift_right(over, 0 - lift);
    let cut_nothing = lift >= 0 || bigint::shift_left(cut, 0 - lift) == over;
    match bigint::div_mod(bigint::shift_left(cut, lift), d.units) {
      None -> 0.0,
      Some(s) -> {
        let quotient = match bigint::to_int(s.q) { Some(q) -> q, None -> 0 };
        let size = nearest(
          quotient,
          !(cut_nothing && bigint::is_zero(s.r)),
          n.scale - d.scale - lift,
        );
        if bigint::is_negative(n.units) { 0.0 - size } else { size }
      },
    }
  }

fn nearest(q: Int, more: Bool, scale: Int) -> Float = {
  let width = bit_length(q);
  let top = width - 1 + scale;
  if top > 1023 { Float::infinity() }
  else if top < 0 - 1075 { 0.0 } else {
    let significant_bits = if top >= 0 - 1022 { 53 } else { top + 1075 };
    let cut = width - significant_bits;
    let leading = q >> cut;
    let rest = q & (1 << cut) - 1;
    let half = 1 << cut - 1;
    let up = rest > half || (rest == half && (more || leading & 1 == 1));
    Float::of_int(if up { leading + 1 } else { leading }) * Float::pow2(scale + cut)
  }
}

test "the tally of two lists joined end to end equals the merge of their separate tallies" {
  gen::check2(gen::list(gen::float()), gen::list(gen::float()), |x: List<Float>, y: List<Float>|
    refines(
      tally,
      |xs: List<Float>, ys: List<Float>| xs.concat(ys),
      |t: Tally, ys: List<Float>| merge(t, tally(ys)),
      x,
      y,
    ))
}

test "a mean lies between the least and the greatest" {
  gen::check(gen::list(gen::float()), |xs: List<Float>| {
    match summarize(xs) {
      None -> xs.len() == 0 || !xs.all(Float::is_finite),
      Some(s) ->
        s.minimum_sizes <= s.mean && s.mean <= s.greatest && s.population_variance >= 0.0
          && s.count == xs.len(),
    }
  })
}

test "every method's quantiles ascend from the least to the greatest" {
  gen::check2(gen::list(gen::float()), gen::any_int(), |xs: List<Float>, pick: Int| {
    let method = [R1, R2, R3, R4, R5, R6, R7, R8, R9].at_or(rem_floor(pick, 9), R7);
    match quantiles(xs, 8, method) {
      None -> !nonempty_and_finite(xs),
      Some(cuts) ->
        range(0, 6).all(|i: Int| cuts.at_or(i, 0.0) <= cuts.at_or(i + 1, 0.0))
          && quantile(xs, 0, 8, method) == least(xs)
          && quantile(xs, 8, 8, method) == greatest(xs),
    }
  })
}

test "`mean`, `median` and `mode` return the results shown in the examples in Python's statistics documentation" {
  assert_eq(mean([1.0, 2.0, 3.0, 4.0, 4.0]), Some(2.8));
  assert_eq(mean([0.0 - 1.0, 2.5, 3.25, 5.75]), Some(2.625));
  assert_eq(mean([3.5, 4.0, 5.25]), Some(4.25));
  assert_eq(median([1.0, 3.0, 5.0]), Some(3.0));
  assert_eq(median([1.0, 3.0, 5.0, 7.0]), Some(4.0));
  assert_eq(median_low([1.0, 3.0, 5.0]), Some(3.0));
  assert_eq(median_low([1.0, 3.0, 5.0, 7.0]), Some(3.0));
  assert_eq(median_high([1.0, 3.0, 5.0]), Some(3.0));
  assert_eq(median_high([1.0, 3.0, 5.0, 7.0]), Some(5.0));
  assert_eq(mode([1, 1, 2, 3, 3, 3, 3, 4]), Some(3));
  assert_eq(mode(["red", "blue", "blue", "red", "green", "red", "red"]), Some("red"));
  assert_eq(modes("aabbbbccddddeeffffgg".chars()), ['b', 'd', 'f']);
  assert_eq(modes("".chars()), []);
  assert_eq(population_stdev([1.5, 2.5, 2.5, 2.75, 3.25, 4.75]), Some(0.986893273527251));
  assert_eq(population_variance([0.0, 0.25, 0.25, 1.25, 1.5, 1.75, 2.75, 3.25]), Some(1.25));
  assert_eq(sample_stdev([1.5, 2.5, 2.5, 2.75, 3.25, 4.75]), Some(1.0810874155219827));
  assert_eq(sample_variance([2.75, 1.75, 1.25, 0.25, 0.5, 1.25, 3.5]), Some(1.3720238095238095))
}

