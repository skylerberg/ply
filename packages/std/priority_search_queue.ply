//! `std.priority_search_queue` is a priority queue of keys. The key with the least priority leaves
//! first, and the priority of a key can be read, changed or removed by naming the key.
//!
//! A key is in a queue at most once. Keys with the same priority leave in the order they were
//! inserted, so a scheduler built on a queue is deterministic. Inserting a key again with its
//! current priority leaves its place unchanged. Inserting it with another priority puts it behind
//! the keys already at that priority.
//!
//! `std.heap` is the queue for anonymous entries. This module is for entries a program needs to
//! find again: a node whose distance drops, a task whose time changes, a cache entry that is used.
//!
//! A `PrioritySearchQueue` is two maps: each key's position, and the keys ordered by position. So
//! `insert`, `adjust`, `remove`, `priority_of`, `peek_min` and `pop_min` each look up one entry in
//! each map. A queue that nothing else references is updated in place, so a loop that pops should
//! pass the `rest` of each pop to the next iteration.
//!
//! Two queues are equal when they would pop the same keys in the same order. The `key` of a queue
//! is the result of `to_list`, so such queues are `==`, have the same `digest` and are the same
//! `Map` key, however each was built.

import std.laws (agrees)
import std.list as list
import std.gen

/// A key and the priority it is queued under.
pub type Entry<k, p> = { key: k, priority: p }

/// A queue of keys `k`, each at most once, with priorities `p`.
///
/// The fields are, in order: each key's position, the keys ordered by position, the position number
/// the next inserted key gets, and a function that lists the entries in position order. A position
/// is a priority and the number of the insertion. The `key` declaration below must name a function
/// of the queue alone, which cannot require `k` and `p` to be ordered. So the queue stores the
/// listing function that `empty` creates, which can require it.
///
/// When nothing else references a queue, each write to it updates its maps in place.
pub type PrioritySearchQueue<k, p> =
  | PrioritySearchQueue(Map<k, (p, Int)>, Map<(p, Int), k>, Int, (Map<(p, Int), k>) -> List<Entry<k, p>>)

key for PrioritySearchQueue by to_list

/// The empty queue.
pub fn empty<k, p>() -> PrioritySearchQueue<k, p>
  where derivable(ord, k), derivable(ord, p)
=
  PrioritySearchQueue(Map::new(), Map::new(), 0, |order: Map<(p, Int), k>|
    order.fold([], |out: List<Entry<k, p>>, position: (p, Int), key: k|
      out.push({ key: key, priority: position._0 })))

/// A queue of `entries`. Of two entries with the same priority, the earlier one leaves first. A key
/// that appears again takes its later priority, as `insert` does.
pub fn of_list<k, p>(entries: List<Entry<k, p>>) -> PrioritySearchQueue<k, p>
  where derivable(ord, k), derivable(ord, p)
=
  entries.fold(empty(), |q: PrioritySearchQueue<k, p>, entry: Entry<k, p>|
    insert(q, entry.key, entry.priority))

/// The number of keys in the queue.
pub fn size<k, p>(q: PrioritySearchQueue<k, p>) -> Int
  where derivable(ord, k), derivable(ord, p)
= match q { PrioritySearchQueue(_, order, _, _) -> order.len() }

/// Whether the queue is empty.
pub fn is_empty<k, p>(q: PrioritySearchQueue<k, p>) -> Bool
  where derivable(ord, k), derivable(ord, p)
= size(q) == 0

/// Whether `key` is in the queue.
pub fn contains<k, p>(q: PrioritySearchQueue<k, p>, key: k) -> Bool
  where derivable(ord, k), derivable(ord, p)
= match q { PrioritySearchQueue(positions, _, _, _) -> positions.contains(key) }

/// The priority of `key`, or `None` when `key` is not in the queue.
pub fn priority_of<k, p>(q: PrioritySearchQueue<k, p>, key: k) -> Option<p>
  where derivable(ord, k), derivable(ord, p)
=
  match q {
    PrioritySearchQueue(positions, _, _, _) -> match positions.get(key) {
      Some(position) -> Some(position._0),
      None -> None,
    },
  }

/// `q` with `key` at `priority`, behind every key already at that priority. A key already in the
/// queue at another priority moves. A key already at `priority` keeps its place.
pub fn insert<k, p>(q: PrioritySearchQueue<k, p>, key: k, priority: p) -> PrioritySearchQueue<k, p>
  where derivable(ord, k), derivable(ord, p)
=
  match q {
    PrioritySearchQueue(positions, order, next, list_entries) -> match positions.get(key) {
      None -> add_entry(positions, order, next, key, priority, list_entries),
      Some(position) -> if position._0 == priority {
        PrioritySearchQueue(positions, order, next, list_entries)
      } else { add_entry(positions, order.remove(position), next, key, priority, list_entries) },
    },
  }

fn add_entry<k, p>(
  positions: Map<k, (p, Int)>,
  order: Map<(p, Int), k>,
  next: Int,
  key: k,
  priority: p,
  list_entries: keep (Map<(p, Int), k>) -> List<Entry<k, p>>,
) -> PrioritySearchQueue<k, p>
  where derivable(ord, k), derivable(ord, p)
=
  PrioritySearchQueue(
    positions.insert(key, (priority, next)),
    order.insert((priority, next), key),
    next + 1,
    list_entries,
  )

/// `q` with the priority of `key` replaced by `f` of it, placed as `insert` places it. A key not in
/// the queue leaves the queue unchanged.
pub fn adjust<k, p | e>(
  q: PrioritySearchQueue<k, p>,
  key: k,
  f: (p) -> p / e,
) -> PrioritySearchQueue<k, p> / e
  where derivable(ord, k), derivable(ord, p)
= match priority_of(q, key) { Some(priority) -> insert(q, key, f(priority)), None -> q }

/// `q` without `key`. Removing a key not in the queue returns the queue unchanged.
pub fn remove<k, p>(q: PrioritySearchQueue<k, p>, key: k) -> PrioritySearchQueue<k, p>
  where derivable(ord, k), derivable(ord, p)
=
  match q {
    PrioritySearchQueue(positions, order, next, list_entries) -> match positions.get(key) {
      None -> PrioritySearchQueue(positions, order, next, list_entries),
      Some(position) ->
        PrioritySearchQueue(positions.remove(key), order.remove(position), next, list_entries),
    },
  }

/// The entry `pop_min` would take, or `None` for an empty queue.
pub fn peek_min<k, p>(q: PrioritySearchQueue<k, p>) -> Option<Entry<k, p>>
  where derivable(ord, k), derivable(ord, p)
=
  match q {
    PrioritySearchQueue(_, order, _, _) -> match order.first() {
      Some(first) -> Some({ key: first.value, priority: first.key._0 }),
      None -> None,
    },
  }

/// Removes the first key to leave: the earliest to reach the least priority. Returns it with its
/// priority and the rest of the queue, or `None` for an empty queue.
pub fn pop_min<k, p>(
  q: PrioritySearchQueue<k, p>,
) -> Option<{ key: k, priority: p, rest: PrioritySearchQueue<k, p> }>
  where derivable(ord, k), derivable(ord, p)
=
  match q {
    PrioritySearchQueue(positions, order, next, list_entries) -> match order.pop_first() {
      None -> None,
      Some(first) -> {
        let key = first.value;
        Some({
          key: key,
          priority: first.key._0,
          rest: PrioritySearchQueue(positions.remove(key), first.rest, next, list_entries),
        })
      },
    },
  }

/// The entries in the order `pop_min` would return them. Queues are compared, ordered and digested
/// by this list.
pub fn to_list<k, p>(q: PrioritySearchQueue<k, p>) -> List<Entry<k, p>> =
  match q { PrioritySearchQueue(_, order, _, list_entries) -> list_entries(order) }

fn jobs() -> PrioritySearchQueue<String, Int> =
  insert(insert(insert(insert(empty(), "b", 2), "a", 1), "c", 2), "d", 1)

test "keys come out in order of lowest priority first, and keys with equal priority come out in the order they were inserted" {
  let q = jobs();
  assert_eq(size(q), 4);
  assert(!is_empty(q));
  assert_eq(to_list(q), [
    { key: "a", priority: 1 },
    { key: "d", priority: 1 },
    { key: "b", priority: 2 },
    { key: "c", priority: 2 },
  ]);
  assert_eq(peek_min(q), Some({ key: "a", priority: 1 }));
  match pop_min(q) {
    None -> assert(false),
    Some(top) -> {
      assert_eq({ key: top.key, priority: top.priority }, { key: "a", priority: 1 });
      assert_eq(size(top.rest), 3);
      assert_eq(peek_min(top.rest), Some({ key: "d", priority: 1 }));
      assert(!contains(top.rest, "a"))
    },
  }
}

test "an empty queue has nothing to return" {
  let none: PrioritySearchQueue<String, Int> = empty();
  assert(is_empty(none));
  assert_eq(size(none), 0);
  assert_eq(peek_min(none), None);
  assert(pop_min(none) == None);
  assert_eq(to_list(none), []);
  assert_eq(priority_of(none, "a"), None);
  assert_eq(remove(none, "a"), none);
  assert_eq(adjust(none, "a", |p: Int| p + 1), none)
}

test "a key's priority is read, changed and removed by the key" {
  let q = jobs();
  assert_eq(priority_of(q, "c"), Some(2));
  assert_eq(priority_of(q, "z"), None);
  assert(contains(q, "c"));
  assert(!contains(q, "z"));
  assert_eq(to_list(insert(q, "c", 0)), [
    { key: "c", priority: 0 },
    { key: "a", priority: 1 },
    { key: "d", priority: 1 },
    { key: "b", priority: 2 },
  ]);
  assert_eq(to_list(adjust(q, "a", |p: Int| p + 1)), [
    { key: "d", priority: 1 },
    { key: "b", priority: 2 },
    { key: "c", priority: 2 },
    { key: "a", priority: 2 },
  ]);
  assert_eq(adjust(q, "z", |p: Int| p + 1), q);
  assert_eq(to_list(remove(q, "d")), [
    { key: "a", priority: 1 },
    { key: "b", priority: 2 },
    { key: "c", priority: 2 },
  ]);
  assert_eq(remove(q, "z"), q);
  assert_eq(size(insert(q, "c", 0)), 4)
}

test "inserting a key again with its current priority leaves its position in the queue unchanged" {
  let q = jobs();
  assert_eq(to_list(insert(q, "a", 1)), to_list(q));
  assert_eq(insert(q, "a", 1), q);
  assert_eq(to_list(insert(insert(q, "a", 5), "a", 1)), [
    { key: "d", priority: 1 },
    { key: "a", priority: 1 },
    { key: "b", priority: 2 },
    { key: "c", priority: 2 },
  ])
}

test "two queues built by different steps but with the same pop order are equal, have the same digest and collapse to one map key, while a different order is unequal" {
  let one = of_list([
    { key: "x", priority: 3 },
    { key: "y", priority: 1 },
    { key: "z", priority: 3 },
  ]);
  let other = insert(insert(remove(insert(insert(empty(), "y", 9), "x", 3), "y"), "y", 1), "z", 3);
  assert_eq(to_list(one), to_list(other));
  assert(one == other);
  assert_eq(digest(one), digest(other));
  assert_eq(#{one: 1, other: 2}.len(), 1);
  assert(one != insert(other, "z", 0));
  assert(
    one
      != of_list([{ key: "z", priority: 3 }, { key: "y", priority: 1 }, { key: "x", priority: 3 }]),
  )
}

test "`of_list` uses the last priority given for a key, and orders entries of equal priority by their position in the list" {
  assert_eq(
    to_list(
      of_list([
        { key: 1, priority: "m" },
        { key: 2, priority: "a" },
        { key: 3, priority: "m" },
        { key: 1, priority: "a" },
      ]),
    ),
    [{ key: 2, priority: "a" }, { key: 1, priority: "a" }, { key: 3, priority: "m" }],
  );
  let none: List<Entry<Int, String>> = [];
  assert(is_empty(of_list(none)))
}

type Step = { kind: Int, key: Int, priority: Int }

fn run_script(
  script: List<Step>,
  i: Int,
  q: PrioritySearchQueue<Int, Int>,
) -> PrioritySearchQueue<Int, Int> =
  match script.at(i) {
    None -> q,
    Some(step) -> {
      let key = step.key % 8;
      let priority = step.priority % 4;
      let kind = step.kind % 4;
      run_script(script, i + 1, if kind == 0 || kind == -1 { remove(q, key) }
      else if kind == 1 || kind == -2 { adjust(q, key, |p: Int| p - priority) }
      else if kind == 2 { match pop_min(q) { Some(top) -> top.rest, None -> q } }
      else { insert(q, key, priority) })
    },
  }

fn run_model(script: List<Step>, i: Int, model: List<Entry<Int, Int>>) -> List<Entry<Int, Int>> =
  match script.at(i) {
    None -> model,
    Some(step) -> {
      let key = step.key % 8;
      let priority = step.priority % 4;
      let kind = step.kind % 4;
      run_model(script, i + 1, if kind == 0 || kind == -1 { removed_from(model, key) }
      else if kind == 1 || kind == -2 {
        match model.find(|e: Entry<Int, Int>| e.key == key) {
          Some(existing) -> inserted_in(model, key, existing.priority - priority),
          None -> model,
        }
      } else if kind == 2 { model.drop(1) }
      else { inserted_in(model, key, priority) })
    },
  }

fn removed_from(model: List<Entry<Int, Int>>, key: Int) -> List<Entry<Int, Int>> =
  model.partition(|e: Entry<Int, Int>| e.key != key).yes

fn inserted_in(model: List<Entry<Int, Int>>, key: Int, priority: Int) -> List<Entry<Int, Int>> =
  if model.contains({ key: key, priority: priority }) { model } else {
    let rest = removed_from(model, key);
    let ahead = rest.partition(|e: Entry<Int, Int>| e.priority <= priority);
    ahead.yes.push({ key: key, priority: priority }).concat(ahead.no)
  }

fn steps() -> gen::Gen<Step> =
  gen::map3(gen::any_int(), gen::any_int(), gen::any_int(), |kind: Int, key: Int, priority: Int|
    { kind: kind, key: key, priority: priority })

test "after any sequence of writes, a queue lists the same entries in pop order as a plain list model" {
  gen::check(gen::list(steps()), |x: List<Step>|
    agrees(
      |script: List<Step>| to_list(run_script(script, 0, empty())),
      |script: List<Step>| run_model(script, 0, []),
      x,
    ))
}
