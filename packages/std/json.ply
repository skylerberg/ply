//! JSON: the value, a parser, a serializer, and the codecs that `derive json for T` builds on.
//!
//! Numbers are `Decimal`, so a document's numbers read back exactly. Objects are maps, which keep
//! their keys in sorted order, so serializing the same object always writes its members in the same
//! order. When a member name appears twice, `parse` uses the last value and `parse_unique` rejects
//! the document. A `JsonCodec<a>` pairs an encoder with a decoder. The codecs here are the parts a
//! derived codec is built from, and `decode_bytes`, `decode_string`, `encode_bytes` and
//! `encode_string` run a codec from start to finish.
//!
//! `to_bytes` writes a value with no whitespace and `pretty_bytes` writes it indented. Both use one
//! writer, so their output differs only in whitespace. `parse_lines` and `lines_to_bytes` read and
//! write JSON Lines, one value per line. `lines_start`, `lines_step` and `lines_end` read JSON
//! Lines from input that arrives in chunks. A `Pointer` is a JSON Pointer (RFC 6901), and `resolve`
//! follows it into a value.

import std.bytes
import std.bytes (hex_value)
import std.list
import std.gen
import std.derive
import std.derive.codec (derive_json)

/// Returns the source of the definition that `derive json for T` adds: a value named
/// `<snake_case(T)>_json`, which is the `JsonCodec` for `T`. `std.derive.codec` generates it.
pub fn derive(declaration: derive::Declaration) -> Result<String, derive::Refused> / {abort.raise} =
  derive_json(declaration)

/// A JSON value.
pub type Json =
  | Null
  | Bool(Bool)
  | Number(Decimal)
  | Str(String)
  | Array(List<Json>)
  | Object(Map<String, Json>)

/// The deepest nesting `parse` will accept.
pub fn max_depth() -> Int = 128

/// A decoding error. Only the parser sets `offset`; a codec over a parsed `Json` locates an error
/// by `path`.
pub type DecodeError = { path: String, offset: Option<Int>, message: String }

/// An error with no place yet; the decoders around it add the path.
pub fn decode_error(message: String) -> DecodeError = { path: "", offset: None, message: message }

/// An error at a byte offset of the parsed text.
pub fn error_at(offset: Int, message: String) -> DecodeError =
  { path: "", offset: Some(offset), message: message }

/// An error saying `what` was expected and naming the kind of value `found` is instead.
pub fn expected(what: String, found: Json) -> DecodeError =
  decode_error("expected " ++ what ++ ", found " ++ kind_of(found))

/// What a value is, as an error names it: `null`, `a number`, `an object`.
pub fn kind_of(j: Json) -> String =
  match j {
    Null -> "null",
    Bool(_) -> "a boolean",
    Number(_) -> "a number",
    Str(_) -> "a string",
    Array(_) -> "an array",
    Object(_) -> "an object",
  }

/// Returns `e` with the object field `name` added to the front of its path. Each enclosing decoder
/// calls this as the error passes outward, so the finished path reads from the outermost value to
/// the innermost.
pub fn in_field(name: String, e: DecodeError) -> DecodeError =
  { path: "." ++ name ++ e.path, offset: e.offset, message: e.message }

/// Returns `e` with the array index `index` added to the front of its path.
pub fn in_index(index: Int, e: DecodeError) -> DecodeError =
  { path: "[" ++ index.to_string() ++ "]" ++ e.path, offset: e.offset, message: e.message }

/// Returns the error as one line: `$` (the root of the document), then the path, then the message,
/// then the byte offset if the parser reported one.
pub fn error_to_string(e: DecodeError) -> String =
  "$" ++ e.path ++ ": " ++ e.message
    ++ (match e.offset { Some(n) -> " (at byte " ++ n.to_string() ++ ")", None -> "" })

/// How to write an `a` as JSON and read one back.
pub type JsonCodec<a> = {
  encode: (a) -> Json / {abort.raise},
  decode: (Json) -> Result<a, DecodeError> / {abort.raise},
}

/// A decoded value passed through `f`; an error passes through unchanged.
pub fn decode_map<a, b | e>(
  r: Result<a, DecodeError>,
  f: (a) -> b / e,
) -> Result<b, DecodeError> / e = match r { Ok(x) -> Ok(f(x)), Err(e) -> Err(e) }

/// A decoded value passed through a further decoding step; the first error wins.
pub fn decode_and_then<a, b | e>(
  r: Result<a, DecodeError>,
  f: (a) -> Result<b, DecodeError> / e,
) -> Result<b, DecodeError> / e = match r { Ok(x) -> f(x), Err(e) -> Err(e) }

type Step = { value: Json, next: Int }

type Text = { text: String, next: Int }

type Piece = { bytes: Bytes, next: Int }

type Rules = { limit: Int, unique: Bool }

/// One JSON document: valid UTF-8, nested at most `max_depth` deep, with nothing but whitespace
/// after its value. A byte order mark is not part of one, and is rejected with its own error.
pub fn parse(source: Bytes) -> Result<Json, DecodeError> / {abort.raise} =
  parse_within(source, max_depth(), false)

/// Parses like `parse`, but fails if an object has two members with the same name. The error points
/// at the second occurrence.
///
/// JSON does not say what a repeated name means, and `parse` uses the last value, as most parsers
/// do. Two parsers that choose different values read the same text as two different documents. A
/// caller that makes a decision from a document that another parser also checks, such as the
/// verifier of a signed token, should reject repeated names instead. Names are compared as the
/// strings they decode to, however their escapes are written.
pub fn parse_unique(source: Bytes) -> Result<Json, DecodeError> / {abort.raise} =
  parse_within(source, max_depth(), true)

fn parse_within(
  source: Bytes,
  limit: Int,
  unique: Bool,
) -> Result<Json, DecodeError> / {abort.raise} =
  if !source.is_utf8() { Err(error_at(0, "a JSON document must be valid UTF-8")) } else {
    let rules = { limit: min(limit, max_depth()), unique: unique };
    let step = value(source, skip_ws(source, 0), 0, rules)?;
    parse_end(source, step)
  }

/// `parse` over a string's bytes.
pub fn parse_string(source: String) -> Result<Json, DecodeError> / {abort.raise} =
  parse(Bytes::of_string(source))

fn parse_end(source: Bytes, step: Step) -> Result<Json, DecodeError> / {abort.raise} = {
  let end = skip_ws(source, step.next);
  if end == source.len() { Ok(step.value) }
  else { Err(error_at(end, "the document ended here; nothing may follow the top-level value")) }
}

fn ws() -> Bytes = b" \t\r\n"

fn digits() -> Bytes = b"0123456789"

fn skip_ws(source: Bytes, i: Int) -> Int / {abort.raise} = source.skip(i, ws())

fn value(
  source: Bytes,
  i: Int,
  depth: Int,
  rules: Rules,
) -> Result<Step, DecodeError> / {abort.raise} = {
  let c = source.peek(i);
  if c == 34 { string_value(source, i) }
  else if c == 45 || (c >= 48 && c <= 57) { number(source, i) }
  else if c == 123 { object_value(source, i, depth, rules) }
  else if c == 91 { array_value(source, i, depth, rules) }
  else if c == 116 { keyword(source, i, b"true", Bool(true)) }
  else if c == 102 { keyword(source, i, b"false", Bool(false)) }
  else if c == 110 { keyword(source, i, b"null", Null) }
  else if c < 0 { Err(error_at(i, "the input ended where a value was expected")) }
  else if source.slice(i, source.len()).starts_with(byte_order_mark()) {
    Err(error_at(i, "a byte order mark is no part of JSON: remove its three bytes"))
  } else {
    Err(error_at(i, "expected a value: `{`, `[`, `\"`, a number, `true`, `false` or `null`"))
  }
}

fn byte_order_mark() -> Bytes = b"\xef\xbb\xbf"

fn keyword(
  source: Bytes,
  i: Int,
  word: Bytes,
  v: Json,
) -> Result<Step, DecodeError> / {abort.raise} =
  if i + word.len() > source.len() {
    Err(error_at(i, "the input ended inside `" ++ String::of_bytes(word) ++ "`"))
  } else if source.slice(i, i + word.len()) == word { Ok({ value: v, next: i + word.len() }) }
  else { Err(error_at(i, "expected `" ++ String::of_bytes(word) ++ "`")) }

fn array_value(
  source: Bytes,
  i: Int,
  depth: Int,
  rules: Rules,
) -> Result<Step, DecodeError> / {abort.raise} =
  if depth >= rules.limit { Err(too_deep_at(i, rules.limit)) }
  else { array_start(source, skip_ws(source, i + 1), depth + 1, rules) }

fn too_deep_at(i: Int, limit: Int) -> DecodeError =
  error_at(
    i,
    "nested deeper than " ++ max(limit, 0).to_string()
      ++ (if limit == 1 { " level" } else { " levels" }),
  )

fn array_start(
  source: Bytes,
  i: Int,
  depth: Int,
  rules: Rules,
) -> Result<Step, DecodeError> / {abort.raise} =
  if source.peek(i) == 93 { Ok({ value: Array([]), next: i + 1 }) }
  else { array_items(source, i, depth, rules, [], source.len() - i) }

reuse fn array_items(
  src: Bytes,
  i: Int,
  depth: Int,
  rules: Rules,
  accumulator: List<Json>,
  left: Int,
) -> Result<Step, DecodeError> / {abort.raise} = {
  let step = value(src, i, depth, rules)?;
  array_more(src, step, depth, rules, accumulator.push(step.value), left)
}

fn array_more(
  source: Bytes,
  step: Step,
  depth: Int,
  rules: Rules,
  items: List<Json>,
  left: Int,
) -> Result<Step, DecodeError> / {abort.raise} = {
  let j = skip_ws(source, step.next);
  let c = source.peek(j);
  if c == 44 {
    if left <= 0 { panic("the parser counted more array items than the input has bytes") }
    else { array_items(source, skip_ws(source, j + 1), depth, rules, items, left - 1) }
  } else if c == 93 { Ok({ value: Array(items), next: j + 1 }) }
  else { Err(error_at(j, "expected `,` or `]` in an array")) }
}

fn object_value(
  source: Bytes,
  i: Int,
  depth: Int,
  rules: Rules,
) -> Result<Step, DecodeError> / {abort.raise} =
  if depth >= rules.limit { Err(too_deep_at(i, rules.limit)) }
  else { object_start(source, skip_ws(source, i + 1), depth + 1, rules) }

fn object_start(
  source: Bytes,
  i: Int,
  depth: Int,
  rules: Rules,
) -> Result<Step, DecodeError> / {abort.raise} =
  if source.peek(i) == 125 { Ok({ value: Object(Map::new()), next: i + 1 }) }
  else { object_members(source, i, depth, rules, Map::new(), source.len() - i) }

fn object_members(
  source: Bytes,
  i: Int,
  depth: Int,
  rules: Rules,
  accumulator: Map<String, Json>,
  left: Int,
) -> Result<Step, DecodeError> / {abort.raise} =
  if source.peek(i) != 34 { Err(error_at(i, "an object key must be a quoted string")) } else {
    let key = string_body(source, i + 1)?;
    if rules.unique && accumulator.contains(key.text) {
      Err(error_at(i, "this object already has a member named `" ++ key.text ++ "`"))
    } else { object_colon(source, key, depth, rules, accumulator, left) }
  }

fn object_colon(
  source: Bytes,
  key: Text,
  depth: Int,
  rules: Rules,
  accumulator: Map<String, Json>,
  left: Int,
) -> Result<Step, DecodeError> / {abort.raise} = {
  let j = skip_ws(source, key.next);
  if source.peek(j) != 58 { Err(error_at(j, "expected `:` after an object key")) }
  else { object_member(source, key.text, skip_ws(source, j + 1), depth, rules, accumulator, left) }
}

fn object_member(
  source: Bytes,
  key: String,
  i: Int,
  depth: Int,
  rules: Rules,
  accumulator: Map<String, Json>,
  left: Int,
) -> Result<Step, DecodeError> / {abort.raise} = {
  let step = value(source, i, depth, rules)?;
  object_more(source, step, depth, rules, accumulator.insert(key, step.value), left)
}

fn object_more(
  source: Bytes,
  step: Step,
  depth: Int,
  rules: Rules,
  members: Map<String, Json>,
  left: Int,
) -> Result<Step, DecodeError> / {abort.raise} = {
  let j = skip_ws(source, step.next);
  let c = source.peek(j);
  if c == 44 {
    if left <= 0 { panic("the parser counted more object members than the input has bytes") }
    else { object_members(source, skip_ws(source, j + 1), depth, rules, members, left - 1) }
  } else if c == 125 { Ok({ value: Object(members), next: j + 1 }) }
  else { Err(error_at(j, "expected `,` or `}` in an object")) }
}

fn string_stops() -> Bytes =
  b"\"\\\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f"

fn string_value(source: Bytes, i: Int) -> Result<Step, DecodeError> / {abort.raise} = {
  let t = string_body(source, i + 1)?;
  Ok({ value: Str(t.text), next: t.next })
}

fn string_body(source: Bytes, i: Int) -> Result<Text, DecodeError> / {abort.raise} =
  string_chunks(source, i, b"", source.len() - i)

fn string_chunks(
  source: Bytes,
  i: Int,
  accumulator: Bytes,
  left: Int,
) -> Result<Text, DecodeError> / {abort.raise} = {
  let n = source.len();
  let stop = source.skip_until(i, string_stops());
  if stop >= n { Err(error_at(i, "this string is never closed")) }
  else { string_stop(source, stop, accumulator.concat(source.slice(i, stop)), left) }
}

fn string_stop(
  source: Bytes,
  stop: Int,
  so_far: Bytes,
  left: Int,
) -> Result<Text, DecodeError> / {abort.raise} = {
  let c = source.at(stop);
  if c == 34 { Ok({ text: String::of_bytes(so_far), next: stop + 1 }) }
  else if c == 92 { string_escape(source, stop, so_far, left) }
  else { Err(error_at(stop, "a control character must be written as an escape inside a string")) }
}

fn string_escape(
  source: Bytes,
  stop: Int,
  so_far: Bytes,
  left: Int,
) -> Result<Text, DecodeError> / {abort.raise} = {
  let p = escape(source, stop + 1)?;
  if left <= 0 { panic("the parser counted more string escapes than the input has bytes") }
  else { string_chunks(source, p.next, so_far.concat(p.bytes), left - 1) }
}

fn escape(source: Bytes, i: Int) -> Result<Piece, DecodeError> / {abort.raise} = {
  let c = source.peek(i);
  if c == 34 { Ok({ bytes: b"\"", next: i + 1 }) }
  else if c == 92 { Ok({ bytes: b"\\", next: i + 1 }) }
  else if c == 47 { Ok({ bytes: b"/", next: i + 1 }) }
  else if c == 98 { Ok({ bytes: b"\x08", next: i + 1 }) }
  else if c == 102 { Ok({ bytes: b"\x0c", next: i + 1 }) }
  else if c == 110 { Ok({ bytes: b"\n", next: i + 1 }) }
  else if c == 114 { Ok({ bytes: b"\r", next: i + 1 }) }
  else if c == 116 { Ok({ bytes: b"\t", next: i + 1 }) }
  else if c == 117 { unicode_escape(source, i + 1) }
  else { Err(error_at(i - 1, "the escapes are \\\" \\\\ \\/ \\b \\f \\n \\r \\t and \\uXXXX")) }
}

fn unicode_escape(source: Bytes, i: Int) -> Result<Piece, DecodeError> / {abort.raise} = {
  let code_point = hex4(source, i);
  if code_point < 0 { Err(error_at(i, "a \\u escape needs exactly four hexadecimal digits")) }
  else if code_point >= 55296 && code_point <= 56319 { surrogate_pair(source, i, code_point) }
  else if code_point >= 56320 && code_point <= 57343 {
    Err(error_at(i, "a low surrogate must follow a high surrogate, which is \\ud800 to \\udbff"))
  } else { Ok({ bytes: utf8(code_point), next: i + 4 }) }
}

fn surrogate_pair(source: Bytes, i: Int, high: Int) -> Result<Piece, DecodeError> / {abort.raise} =
  if source.peek(i + 4) != 92 || source.peek(i + 5) != 117 {
    Err(error_at(i, "a high surrogate must be followed by a \\u low surrogate"))
  } else { low_surrogate(i, high, hex4(source, i + 6)) }

fn low_surrogate(i: Int, high: Int, low: Int) -> Result<Piece, DecodeError> / {abort.raise} =
  if low < 56320 || low > 57343 {
    Err(
      error_at(
        i + 6,
        "a high surrogate must be followed by a low surrogate, which is \\udc00 to \\udfff",
      ),
    )
  } else { Ok({ bytes: utf8(65536 + (high - 55296) * 1024 + (low - 56320)), next: i + 10 }) }

fn hex4(source: Bytes, i: Int) -> Int = {
  let a = hex_value(source.peek(i));
  let b = hex_value(source.peek(i + 1));
  let c = hex_value(source.peek(i + 2));
  let d = hex_value(source.peek(i + 3));
  if a < 0 || b < 0 || c < 0 || d < 0 { -1 } else { a * 4096 + b * 256 + c * 16 + d }
}

fn number(source: Bytes, i: Int) -> Result<Step, DecodeError> / {abort.raise} = {
  let start = if source.peek(i) == 45 { i + 1 } else { i };
  let int_end = source.skip(start, digits());
  if int_end == start { Err(error_at(start, "a number needs at least one digit")) }
  else if source.peek(start) == 48 && int_end - start > 1 {
    Err(error_at(i, "a number may not have a leading zero"))
  } else { number_fraction(source, i, int_end) }
}

fn number_fraction(
  source: Bytes,
  i: Int,
  after_int: Int,
) -> Result<Step, DecodeError> / {abort.raise} =
  if source.peek(after_int) != 46 { number_exponent(source, i, after_int) }
  else { number_fraction_digits(source, i, after_int + 1, source.skip(after_int + 1, digits())) }

fn number_fraction_digits(
  source: Bytes,
  i: Int,
  first: Int,
  end: Int,
) -> Result<Step, DecodeError> / {abort.raise} =
  if end == first { Err(error_at(first, "a fraction needs at least one digit after the `.`")) }
  else { number_exponent(source, i, end) }

fn number_exponent(source: Bytes, i: Int, after: Int) -> Result<Step, DecodeError> / {abort.raise} = {
  let c = source.peek(after);
  if c != 101 && c != 69 { number_of(source, i, after) }
  else { number_exponent_digits(source, i, exponent_first(source, after + 1)) }
}

fn exponent_first(source: Bytes, i: Int) -> Int = {
  let c = source.peek(i);
  if c == 43 || c == 45 { i + 1 } else { i }
}

fn number_exponent_digits(
  source: Bytes,
  i: Int,
  first: Int,
) -> Result<Step, DecodeError> / {abort.raise} = {
  let end = source.skip(first, digits());
  if end == first { Err(error_at(first, "an exponent needs at least one digit")) }
  else { number_of(source, i, end) }
}

fn number_of(source: Bytes, i: Int, end: Int) -> Result<Step, DecodeError> / {abort.raise} = {
  let text = String::of_bytes(source.slice(i, end));
  match Decimal::of_string(text) {
    Some(d) -> Ok({ value: Number(d), next: end }),
    None ->
      Err(
        error_at(
          i,
          "`" ++ text ++ "` is outside `Decimal`'s range or needs more than 28 significant digits",
        ),
      ),
  }
}

/// `j` as compact JSON. Raises for a value nested deeper than the parser's `max_depth`, so nothing
/// is written that `parse` would reject.
pub fn to_bytes(j: Json) -> Bytes / {abort.raise} = write(j, 0, None)

/// `j` laid out for a reader: every array element and object member on a line of its own, `indent`
/// spaces deeper than its container, a space after each member's colon, and an empty array or
/// object as `[]` or `{}`. Members appear in ascending key order, as `to_bytes` writes them, and no
/// line feed follows the last token. An `indent` of zero or less starts every line at the margin.
/// The tokens are the ones `to_bytes` writes, so the two differ only in whitespace.
pub fn pretty_bytes(j: Json, indent: Int) -> Bytes / {abort.raise} =
  write(j, 0, Some(b" ".repeat(indent)))

/// `pretty_bytes` as a string.
pub fn pretty_string(j: Json, indent: Int) -> String / {abort.raise} =
  String::of_bytes(pretty_bytes(j, indent))

fn unwritable<a>() -> a / {abort.raise} =
  panic(
    "a JSON value nested deeper than " ++ max_depth().to_string()
      ++ " levels cannot be written, because `parse` would reject the result",
  )

fn write(j: Json, depth: Int, pad: Option<Bytes>) -> Bytes / {abort.raise} =
  match j {
    Null -> b"null",
    Bool(b) -> if b { b"true" } else { b"false" },
    Number(d) -> Bytes::of_string(d.to_string()),
    Str(s) -> quote(s),
    Array(items) -> if depth >= max_depth() { unwritable() } else {
      container_contents(b"[", items.map(|x: Json| write(x, depth + 1, pad)), b"]", depth, pad)
    },
    Object(m) -> if depth >= max_depth() { unwritable() } else {
      container_contents(
        b"{",
        m.entries().map(|e: Member| member(e, depth + 1, pad)),
        b"}",
        depth,
        pad,
      )
    },
  }

/// Returns `j` as compact JSON text. The text is valid UTF-8 because every byte written is ASCII or
/// comes from a `String`.
pub fn to_string(j: Json) -> String / {abort.raise} = String::of_bytes(to_bytes(j))

/// One member of a JSON object, as `Map::entries` yields it and `object` takes it.
pub type Member = { key: String, value: Json }

fn member(e: Member, depth: Int, pad: Option<Bytes>) -> Bytes / {abort.raise} =
  quote(e.key).concat(match pad { None -> b":", Some(_) -> b": " }).concat(
    write(e.value, depth, pad),
  )

fn container_contents(
  open: Bytes,
  parts: List<Bytes>,
  close: Bytes,
  depth: Int,
  pad: Option<Bytes>,
) -> Bytes =
  match pad {
    None -> wrap(open, Bytes::join(parts, b","), close),
    Some(step) -> if parts.len() == 0 { open.concat(close) } else {
      let outer = b"\n".concat(step.repeat(depth));
      let inner = outer.concat(step);
      Bytes::concat_all([open, inner, Bytes::join(parts, b",".concat(inner)), outer, close])
    },
  }

fn wrap(open: Bytes, inner: Bytes, close: Bytes) -> Bytes = open.concat(inner.concat(close))

fn quote(s: String) -> Bytes / {abort.raise} = {
  let raw = Bytes::of_string(s);
  b"\"".concat(Bytes::concat_all(escape_runs(raw, 0, [], raw.len())).concat(b"\""))
}

reuse fn escape_runs(
  raw: Bytes,
  i: Int,
  accumulator: List<Bytes>,
  left: Int,
) -> List<Bytes> / {abort.raise} = {
  let n = raw.len();
  let stop = raw.skip_until(i, string_stops());
  if stop >= n { accumulator.push(raw.slice(i, n)) }
  else if left <= 0 { panic("found more bytes to escape than the input contains") } else {
    escape_runs(
      raw,
      stop + 1,
      accumulator.push(raw.slice(i, stop).concat(escaped_byte(raw.at(stop)))),
      left - 1,
    )
  }
}

/// Returns the JSON escape for byte `c`, which a string cannot contain unescaped: a quote, a
/// backslash or a control character. It returns the short escape (`\n`, `\t`, `\b`, `\f`, `\r`)
/// where one exists and `\u00XX` for any other control character. TOML basic strings use the same
/// escapes.
pub fn escaped_byte(c: Int) -> Bytes / {abort.raise} =
  if c == 34 { b"\\\"" }
  else if c == 92 { b"\\\\" }
  else if c == 8 { b"\\b" }
  else if c == 9 { b"\\t" }
  else if c == 10 { b"\\n" }
  else if c == 12 { b"\\f" }
  else if c == 13 { b"\\r" }
  else { b"\\u00".concat(bytes::hex_digit(c / 16).concat(bytes::hex_digit(c % 16))) }

fn utf8(code_point: Int) -> Bytes / {abort.raise} =
  if code_point < 128 { byte_of_int(code_point) } else if code_point < 2048 {
    byte_of_int(192 + code_point / 64).concat(byte_of_int(128 + code_point % 64))
  } else if code_point < 65536 {
    byte_of_int(224 + code_point / 4096).concat(
      byte_of_int(128 + code_point / 64 % 64).concat(byte_of_int(128 + code_point % 64)),
    )
  } else {
    byte_of_int(240 + code_point / 262144).concat(byte_of_int(128 + code_point / 4096 % 64)).concat(
      byte_of_int(128 + code_point / 64 % 64).concat(byte_of_int(128 + code_point % 64)),
    )
  }

/// An object's member named `name`; `None` for an absent one and for any value not an object.
pub fn get(j: Json, name: String) -> Option<Json> = match j { Object(m) -> m.get(name), _ -> None }

/// Decodes the member `name` of the object `j` with `codec`. Returns an error if `j` is not an
/// object, the member is missing, or the member fails to decode; the error names the field. Derived
/// record decoders call it once per field.
pub fn field<a>(
  j: Json,
  name: String,
  codec: JsonCodec<a>,
) -> Result<a, DecodeError> / {abort.raise} =
  match j { Object(m) -> field_of(m, name, codec), _ -> Err(expected("an object", j)) }

fn field_of<a>(
  m: Map<String, Json>,
  name: String,
  codec: JsonCodec<a>,
) -> Result<a, DecodeError> / {abort.raise} =
  match m.get(name) {
    Some(v) -> decode_in_field(name, (codec.decode)(v)),
    None -> Err(in_field(name, decode_error("this field is missing"))),
  }

fn decode_in_field<a>(name: String, r: Result<a, DecodeError>) -> Result<a, DecodeError> =
  match r { Ok(x) -> Ok(x), Err(e) -> Err(in_field(name, e)) }

/// An absent field and a `null` field give the same result, `Ok(None)`.
pub fn optional_field<a>(
  j: Json,
  name: String,
  codec: JsonCodec<a>,
) -> Result<Option<a>, DecodeError> / {abort.raise} =
  match j { Object(m) -> optional_field_of(m, name, codec), _ -> Err(expected("an object", j)) }

fn optional_field_of<a>(
  m: Map<String, Json>,
  name: String,
  codec: JsonCodec<a>,
) -> Result<Option<a>, DecodeError> / {abort.raise} =
  match m.get(name) {
    None -> Ok(None),
    Some(Null) -> Ok(None),
    Some(v) -> decode_in_field(name, decode_map((codec.decode)(v), |x: a| Some(x))),
  }

/// Returns an object with these members. If a key appears more than once, the last member with that
/// key wins.
pub fn object(fields: List<Member>) -> Json = Object(Map::of_entries(fields))

/// An array of these items.
pub fn array(items: List<Json>) -> Json = Array(items)

/// The number `n`.
pub fn int(n: Int) -> Json = Number(Decimal::of_int(n))

/// An array of strings.
pub fn strings(xs: List<String>) -> Json = Array(xs.map(|x: String| Str(x)))

/// `Null` where there is no string.
pub fn string_or_null(s: Option<String>) -> Json = match s { Some(x) -> Str(x), None -> Null }

/// `Null` where there is no number.
pub fn int_or_null(n: Option<Int>) -> Json = match n { Some(x) -> int(x), None -> Null }

/// `Null` where there are no strings, which is not an empty list of them.
pub fn strings_or_null(xs: Option<List<String>>) -> Json =
  match xs { Some(x) -> strings(x), None -> Null }

/// A derived ADT codec's form: a fieldless variant is its tag, else `{"tag": .., "values": [..]}`.
pub type Tagged = { tag: String, values: List<Json> }

/// A variant as a derived codec writes it: its tag alone, or `{"tag", "values"}`.
pub fn variant(tag: String, values: List<Json>) -> Json =
  if values.len() == 0 { Str(tag) }
  else { object([{ key: "tag", value: Str(tag) }, { key: "values", value: Array(values) }]) }

/// A variant written by `variant`, read back.
pub fn variant_of(j: Json) -> Result<Tagged, DecodeError> =
  match j {
    Str(tag) -> Ok({ tag: tag, values: [] }),
    Object(m) -> tagged_of(j, m),
    _ -> Err(expected("a variant: a string, or an object with a `tag`", j)),
  }

fn tagged_of(j: Json, m: Map<String, Json>) -> Result<Tagged, DecodeError> =
  match m.get("tag") {
    Some(Str(tag)) -> Ok({ tag: tag, values: tagged_values(m) }),
    Some(other) -> Err(in_field("tag", expected("a string", other))),
    None -> Err(expected("a variant: a string, or an object with a `tag`", j)),
  }

fn tagged_values(m: Map<String, Json>) -> List<Json> =
  match m.get("values") { Some(Array(vs)) -> vs, _ -> [] }

/// Whether a variant is the one tagged `tag`.
pub fn has_tag(v: Tagged, tag: String) -> Bool = v.tag == tag

/// A variant's value at `index`, or an error when it has fewer values.
pub fn variant_value(v: Tagged, index: Int) -> Result<Json, DecodeError> =
  match v.values.at(index) {
    Some(x) -> Ok(x),
    None ->
      Err(
        decode_error(
          "`" ++ v.tag ++ "` needs " ++ Int::to_string(index + 1) ++ " values, and this one has "
            ++ v.values.len().to_string(),
        ),
      ),
  }

/// The error a derived decoder returns for a tag its type does not have.
pub fn unknown_variant<a>(tag: String, expected_tags: List<String>) -> Result<a, DecodeError> =
  Err(
    decode_error(
      "`" ++ tag ++ "` is not one of the variants, which are " ++ comma_list(expected_tags),
    ),
  )

/// The codec a derived codec over a recursive type uses past `max_depth` levels. Encoding raises
/// and decoding fails, since `parse` reads no deeper.
pub fn too_deep<a>() -> JsonCodec<a> =
  {
    encode: |_: a| unwritable(),
    decode: |_: Json|
      Err(decode_error("nested deeper than " ++ max_depth().to_string() ++ " levels")),
  }

fn comma_list(names: List<String>) -> String =
  names.fold("", |accumulator: String, n: String|
    if accumulator.len() == 0 { n } else { accumulator ++ ", " ++ n })

/// The value itself.
pub fn json_json() -> JsonCodec<Json> = { encode: |j: Json| j, decode: |j: Json| Ok(j) }

/// A boolean.
pub fn bool_json() -> JsonCodec<Bool> =
  {
    encode: |b: Bool| Bool(b),
    decode: |j: Json| match j { Bool(b) -> Ok(b), _ -> Err(expected("a boolean", j)) },
  }

/// `()` as `null`.
pub fn unit_json() -> JsonCodec<Unit> =
  {
    encode: |u: Unit| Null,
    decode: |j: Json| match j { Null -> Ok(()), _ -> Err(expected("null", j)) },
  }

/// A string.
pub fn string_json() -> JsonCodec<String> =
  {
    encode: |s: String| Str(s),
    decode: |j: Json| match j { Str(s) -> Ok(s), _ -> Err(expected("a string", j)) },
  }

/// Writes a `Decimal` as a JSON number and reads one back without rounding.
pub fn decimal_json() -> JsonCodec<Decimal> =
  {
    encode: |d: Decimal| Number(d),
    decode: |j: Json| match j { Number(d) -> Ok(d), _ -> Err(expected("a number", j)) },
  }

/// `Int::of_decimal` truncates, so the round trip through `Decimal::of_int` is what rejects `1.5`.
pub fn int_json() -> JsonCodec<Int> =
  {
    encode: |n: Int| Number(Decimal::of_int(n)),
    decode: |j: Json| match j { Number(d) -> int_of(d), _ -> Err(expected("a number", j)) },
  }

fn int_of(d: Decimal) -> Result<Int, DecodeError> =
  match Int::of_decimal(d, Down) {
    None -> Err(decode_error("`" ++ d.to_string() ++ "` is outside `Int`'s range")),
    Some(n) -> if Decimal::of_int(n) == d { Ok(n) }
    else { Err(decode_error("expected a whole number, found `" ++ d.to_string() ++ "`")) },
  }

/// A string of exactly one character.
pub fn char_json() -> JsonCodec<Char> =
  {
    encode: |c: Char| Str(String::of_chars([c])),
    decode: |j: Json|
      match j {
        Str(s) -> match s.chars() {
          [c] -> Ok(c),
          _ -> Err(expected("a string of one character", j)),
        },
        _ -> Err(expected("a string of one character", j)),
      },
  }

/// An `Instant` and a `Duration` are their nanoseconds.
pub fn instant_json() -> JsonCodec<Instant> =
  {
    encode: |t: Instant| match t { Instant(n) -> int_json().encode(n) },
    decode: |j: Json| decode_map(int_json().decode(j), |n: Int| Instant(n)),
  }

/// A number of nanoseconds.
pub fn duration_json() -> JsonCodec<Duration> =
  {
    encode: |t: Duration| match t { Duration(n) -> int_json().encode(n) },
    decode: |j: Json| decode_map(int_json().decode(j), |n: Int| Duration(n)),
  }

/// JSON has no non-finite literals, so there is nothing to write for a NaN or an infinity.
pub fn float_json() -> JsonCodec<Float> =
  {
    encode: |f: Float|
      match Decimal::of_float(f) {
        Some(d) -> Number(d),
        None -> panic("a Float that is " ++ float_reason(f) ++ " has no JSON encoding"),
      },
    decode: |j: Json|
      match j { Number(d) -> Ok(Float::of_decimal(d)), _ -> Err(expected("a number", j)) },
  }

fn float_reason(f: Float) -> String =
  if f != f { "NaN" }
  else if f * 2.0 == f && f != 0.0 { if f > 0.0 { "Infinity" } else { "-Infinity" } }
  else { "outside `Decimal`'s range" }

/// Writes a `List` as a JSON array and reads one back, using `item` for each element. A decode
/// error names the index of the failing element.
pub fn list_json<a>(item: JsonCodec<a>) -> JsonCodec<List<a>> =
  {
    encode: |xs: List<a>| Array(xs.map(|x: a| (item.encode)(x))),
    decode: |j: Json|
      match j { Array(items) -> collect(items, item, 0, []), _ -> Err(expected("an array", j)) },
  }

/// A JSON array, read back as an array of the length the document gives it.
pub fn array_json<a>(item: JsonCodec<a>) -> JsonCodec<Array<a>> = {
  let items = list_json(item);
  {
    encode: |xs: Array<a>| (items.encode)(xs.to_list()),
    decode: |j: Json|
      match (items.decode)(j) { Ok(xs) -> Ok(Array::of_list(xs)), Err(e) -> Err(e) },
  }
}

fn collect<a>(
  items: List<Json>,
  item: JsonCodec<a>,
  index: Int,
  accumulator: List<a>,
) -> Result<List<a>, DecodeError> / {abort.raise} =
  match items {
    [] -> Ok(accumulator),
    [x, ..rest] -> match (item.decode)(x) {
      Err(e) -> Err(in_index(index, e)),
      Ok(v) -> collect(rest, item, index + 1, accumulator.push(v)),
    },
  }

/// `None` is `null` and `Some(x)` is `x`.
pub fn option_json<a>(item: JsonCodec<a>) -> JsonCodec<Option<a>> =
  {
    encode: |o: Option<a>| match o { None -> Null, Some(x) -> (item.encode)(x) },
    decode: |j: Json|
      match j { Null -> Ok(None), _ -> decode_map((item.decode)(j), |x: a| Some(x)) },
  }

/// A variant tagged `Ok` or `Err`, as a derived codec writes a sum type.
pub fn result_json<a, b>(ok: JsonCodec<a>, err: JsonCodec<b>) -> JsonCodec<Result<a, b>> =
  {
    encode: |r: Result<a, b>|
      match r {
        Ok(x) -> variant("Ok", [(ok.encode)(x)]),
        Err(e) -> variant("Err", [(err.encode)(e)]),
      },
    decode: |j: Json| decode_and_then(variant_of(j), |t: Tagged| result_of(t, ok, err)),
  }

fn result_of<a, b>(
  t: Tagged,
  ok: JsonCodec<a>,
  err: JsonCodec<b>,
) -> Result<Result<a, b>, DecodeError> / {abort.raise} =
  if t.tag == "Ok" {
    decode_and_then(variant_value(t, 0), |v: Json| decode_map((ok.decode)(v), |x: a| Ok(x)))
  } else if t.tag == "Err" {
    decode_and_then(variant_value(t, 0), |v: Json| decode_map((err.decode)(v), |x: b| Err(x)))
  } else { unknown_variant(t.tag, ["Ok", "Err"]) }

/// A map keyed by `String` is a JSON object.
pub fn string_map_json<v>(value: JsonCodec<v>) -> JsonCodec<Map<String, v>> =
  {
    encode: |m: Map<String, v>|
      Object(
        Map::of_entries(
          m.entries().map(|e: { key: String, value: v }|
            { key: e.key, value: (value.encode)(e.value) }),
        ),
      ),
    decode: |j: Json|
      match j {
        Object(m) -> collect_members(m.entries(), value, Map::new()),
        _ -> Err(expected("an object", j)),
      },
  }

fn collect_members<v>(
  entries: List<Member>,
  value: JsonCodec<v>,
  accumulator: Map<String, v>,
) -> Result<Map<String, v>, DecodeError> / {abort.raise} =
  match entries {
    [] -> Ok(accumulator),
    [e, ..rest] -> match (value.decode)(e.value) {
      Err(err) -> Err(in_field(e.key, err)),
      Ok(v) -> collect_members(rest, value, accumulator.insert(e.key, v)),
    },
  }

/// Other keys have no object form: an array of `{"key", "value"}` objects in ascending key order.
pub fn map_json<k, v>(key: JsonCodec<k>, value: JsonCodec<v>) -> JsonCodec<Map<k, v>>
  where derivable(ord, k)
=
  {
    encode: |m: Map<k, v>|
      Array(
        m.entries().map(|e: { key: k, value: v }|
          object([
            { key: "key", value: (key.encode)(e.key) },
            { key: "value", value: (value.encode)(e.value) },
          ])),
      ),
    decode: |j: Json|
      match j {
        Array(items) -> collect_pairs(items, key, value, 0, Map::new()),
        _ -> Err(expected("an array of `{key, value}` objects", j)),
      },
  }

fn collect_pairs<k, v>(
  items: List<Json>,
  key: JsonCodec<k>,
  value: JsonCodec<v>,
  index: Int,
  accumulator: Map<k, v>,
) -> Result<Map<k, v>, DecodeError> / {abort.raise}
  where derivable(ord, k)
=
  match items {
    [] -> Ok(accumulator),
    [x, ..rest] -> match pair_of(x, key, value) {
      Err(e) -> Err(in_index(index, e)),
      Ok(p) -> collect_pairs(rest, key, value, index + 1, accumulator.insert(p.key, p.value)),
    },
  }

fn pair_of<k, v>(
  x: Json,
  key: JsonCodec<k>,
  value: JsonCodec<v>,
) -> Result<{ key: k, value: v }, DecodeError> / {abort.raise} =
  decode_and_then(field(x, "key", key), |k2: k|
    decode_map(field(x, "value", value), |v2: v| { key: k2, value: v2 }))

/// JSON has no byte string, so `Bytes` is padded base64 (RFC 4648).
pub fn bytes_json() -> JsonCodec<Bytes> =
  {
    encode: |b: Bytes| Str(base64_encode(b)),
    decode: |j: Json|
      match j { Str(s) -> base64_decode(s), _ -> Err(expected("a base64 string", j)) },
  }

fn b64_alphabet() -> Bytes = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn b64_symbol(v: Int) -> Bytes / {abort.raise} = b64_alphabet().slice(v, v + 1)

/// Encodes `raw` as padded base64 (RFC 4648). `bytes_json` uses it to encode `Bytes` as a JSON
/// string.
pub fn base64_encode(raw: Bytes) -> String / {abort.raise} =
  String::of_bytes(
    Bytes::concat_all(range(0, (raw.len() + 2) / 3).map(|g: Int| b64_group(raw, g * 3))),
  )

fn b64_group(raw: Bytes, i: Int) -> Bytes / {abort.raise} = {
  let n = raw.len();
  let a = raw.at(i);
  if i + 3 <= n { b64_three(a, raw.at(i + 1), raw.at(i + 2)) }
  else if i + 2 == n { b64_tail_two(a, raw.at(i + 1)) }
  else { b64_one(a) }
}

fn b64_three(a: Int, b: Int, c: Int) -> Bytes / {abort.raise} =
  b64_symbol(a / 4).concat(b64_symbol(a % 4 * 16 + b / 16)).concat(
    b64_symbol(b % 16 * 4 + c / 64).concat(b64_symbol(c % 64)),
  )

fn b64_tail_two(a: Int, b: Int) -> Bytes / {abort.raise} =
  b64_symbol(a / 4).concat(b64_symbol(a % 4 * 16 + b / 16)).concat(
    b64_symbol(b % 16 * 4).concat(b"="),
  )

fn b64_one(a: Int) -> Bytes / {abort.raise} =
  b64_symbol(a / 4).concat(b64_symbol(a % 4 * 16)).concat(b"==")

/// Decodes padded base64 `text` (RFC 4648) into bytes. Returns an error if the length of `text` is
/// not a multiple of four or if `text` contains a character outside the base64 alphabet.
pub fn base64_decode(text: String) -> Result<Bytes, DecodeError> / {abort.raise} = {
  let raw = Bytes::of_string(text);
  if raw.len() % 4 != 0 { Err(decode_error("a base64 string's length must be a multiple of 4")) }
  else { decode_map(b64_groups(raw, 0, []), |pieces: List<Bytes>| Bytes::concat_all(pieces)) }
}

fn b64_groups(
  raw: Bytes,
  i: Int,
  accumulator: List<Bytes>,
) -> Result<List<Bytes>, DecodeError> / {abort.raise} =
  if i >= raw.len() { Ok(accumulator) } else {
    let chunk = b64_decode_group(raw, i)?;
    b64_groups(raw, i + 4, accumulator.push(chunk))
  }

fn b64_decode_group(raw: Bytes, i: Int) -> Result<Bytes, DecodeError> / {abort.raise} = {
  let a = b64_value(raw.at(i));
  let b = b64_value(raw.at(i + 1));
  let third = raw.at(i + 2);
  let fourth = raw.at(i + 3);
  if a < 0 || b < 0 { Err(decode_error("this is not base64")) } else if third == 61 {
    if fourth == 61 { Ok(byte_of_int(a * 4 + b / 16)) }
    else { Err(decode_error("base64 padding may only be at the end")) }
  } else { b64_tail(a, b, b64_value(third), fourth) }
}

fn b64_tail(a: Int, b: Int, c: Int, fourth: Int) -> Result<Bytes, DecodeError> / {abort.raise} =
  if c < 0 { Err(decode_error("this is not base64")) }
  else if fourth == 61 { Ok(byte_of_int(a * 4 + b / 16).concat(byte_of_int(b % 16 * 16 + c / 4))) }
  else { b64_full(a, b, c, b64_value(fourth)) }

fn b64_full(a: Int, b: Int, c: Int, d: Int) -> Result<Bytes, DecodeError> / {abort.raise} =
  if d < 0 { Err(decode_error("this is not base64")) } else {
    Ok(
      byte_of_int(a * 4 + b / 16).concat(
        byte_of_int(b % 16 * 16 + c / 4).concat(byte_of_int(c % 4 * 64 + d)),
      ),
    )
  }

fn b64_value(c: Int) -> Int / {abort.raise} =
  match b64_alphabet().index_of_byte(c) { Some(v) -> v, None -> -1 }

/// Parses a document and decodes it with `codec`.
pub fn decode_bytes<a>(
  source: Bytes,
  codec: JsonCodec<a>,
) -> Result<a, DecodeError> / {abort.raise} =
  decode_and_then(parse(source), |j: Json| (codec.decode)(j))

/// Converts `src` to bytes, then parses and decodes it as `decode_bytes` does.
pub fn decode_string<a>(
  source: String,
  codec: JsonCodec<a>,
) -> Result<a, DecodeError> / {abort.raise} = decode_bytes(Bytes::of_string(source), codec)

/// Encodes `x` with `codec` and returns it as JSON bytes.
pub fn encode_bytes<a>(x: a, codec: JsonCodec<a>) -> Bytes / {abort.raise} =
  to_bytes((codec.encode)(x))

/// Encodes `x` with `codec` and returns it as a JSON string.
pub fn encode_string<a>(x: a, codec: JsonCodec<a>) -> String / {abort.raise} =
  to_string((codec.encode)(x))

/// The error from reading JSON Lines input: the number of the line that failed, counting from one,
/// and the error for that line. The `offset` of the error is a byte position within that line.
pub type LineError = new { line: Int, error: DecodeError }

/// Formats `e` as "line N: " followed by the text `error_to_string` gives for the error, where N is
/// the line number.
pub fn line_error_to_string(e: LineError) -> String =
  "line " ++ e.line.to_string() ++ ": " ++ error_to_string(e.error)

/// A JSON Lines reader between two chunks of its input: its limits, the line it is on, counted from
/// one, and the bytes of that line it has been given so far.
pub type LineReader = new { max_line: Int, max_depth: Int, line: Int, partial: Bytes }

/// The result of passing one chunk to `lines_step`: the values of the lines that ended in that
/// chunk, in order, and the reader to pass the next chunk to.
pub type LineStep = new { reader: LineReader, values: List<Json> }

/// Returns a reader positioned at the start of an input. The reader rejects a line longer than
/// `max_line` bytes as soon as it has received that many bytes without a line feed. It rejects a
/// value nested deeper than `max_depth`, or deeper than `parse` allows if that limit is lower.
pub fn lines_start(max_line: Int, max_depth: Int) -> LineReader =
  { max_line: max_line, max_depth: max_depth, line: 1, partial: b"" }

/// Passes the reader the next `chunk` of its input, which may be cut anywhere.
///
/// A line is the bytes up to a line feed, and contains one value as `parse` reads it, so a carriage
/// return before the line feed is whitespace. A line of only whitespace contains no value and is
/// skipped, though it counts as a line. A byte order mark is rejected, as `parse` rejects it.
pub fn lines_step(reader: LineReader, chunk: Bytes) -> Result<LineStep, LineError> / {abort.raise} = {
  let pieces = chunk.split(b"\n");
  let ended = pieces.len() - 1;
  let start: Result<LineStep, LineError> = Ok({ reader: reader, values: [] });
  let step = pieces.take(ended).fold(start, finish_line)?;
  let rest = append_to_line(step.reader, pieces.at_or(ended, b""))?;
  Ok({ reader: rest, values: step.values })
}

/// The value on the last line, when the input ended without a line feed and that line contains one.
pub fn lines_end(reader: LineReader) -> Result<Option<Json>, LineError> / {abort.raise} =
  line_value(reader)

/// Every value of a JSON Lines text, in order, under the limits and rules of `lines_start` and
/// `lines_step`: the whole input as one chunk. A last line needs no line feed.
pub fn parse_lines(
  source: Bytes,
  max_line: Int,
  max_depth: Int,
) -> Result<List<Json>, LineError> / {abort.raise} = {
  let step = lines_step(lines_start(max_line, max_depth), source)?;
  let last = lines_end(step.reader)?;
  Ok(match last { Some(j) -> step.values.push(j), None -> step.values })
}

/// Each value as `to_bytes` writes it, which contains no line feed, followed by a line feed.
pub fn lines_to_bytes(values: List<Json>) -> Bytes / {abort.raise} =
  Bytes::concat_all(values.map(|j: Json| to_bytes(j).concat(b"\n")))

fn finish_line(
  accumulator: Result<LineStep, LineError>,
  piece: Bytes,
) -> Result<LineStep, LineError> / {abort.raise} = {
  let step = accumulator?;
  let whole = append_to_line(step.reader, piece)?;
  let read = line_value(whole)?;
  Ok({
    reader: { ..whole, line: whole.line + 1, partial: b"" },
    values: match read { Some(j) -> step.values.push(j), None -> step.values },
  })
}

fn append_to_line(r: LineReader, piece: Bytes) -> Result<LineReader, LineError> =
  if r.partial.len() + piece.len() > r.max_line {
    Err({
      line: r.line,
      error: error_at(
        max(r.max_line, 0),
        "a line is longer than the " ++ r.max_line.to_string() ++ " bytes this reader accepts",
      ),
    })
  } else { Ok({ ..r, partial: r.partial.concat(piece) }) }

fn line_value(r: LineReader) -> Result<Option<Json>, LineError> / {abort.raise} =
  if skip_ws(r.partial, 0) == r.partial.len() { Ok(None) } else {
    match parse_within(r.partial, r.max_depth, false) {
      Ok(j) -> Ok(Some(j)),
      Err(e) -> Err({ line: r.line, error: e }),
    }
  }

/// A JSON Pointer (RFC 6901): the reference tokens that lead from a document to one value in it,
/// each with `~1` and `~0` already unescaped. An empty list of tokens means the document itself.
pub type Pointer = | Pointer(List<String>)

show for Pointer by pointer_text

/// A pointer as RFC 6901 writes it: each token after a `/`, its `~` as `~0` and its `/` as `~1`.
pub fn pointer_text(p: Pointer) -> String =
  match p {
    Pointer(tokens) ->
      tokens.fold("", |text: String, token: String| text ++ "/" ++ escaped_token(token)),
  }

fn escaped_token(token: String) -> String =
  token.chars().fold("", |text: String, c: Char|
    text ++ (if c == '~' { "~0" } else if c == '/' { "~1" } else { String::of_chars([c]) }))

/// Parses `text` as a pointer in RFC 6901 form. Returns `None` if `text` is neither empty nor
/// starts with `/`, or if it contains a `~` that is not followed by `0` or `1`.
pub fn pointer_of(text: String) -> Option<Pointer> / {abort.raise} =
  match text.split("/") {
    [""] -> Some(Pointer([])),
    ["", ..written] -> match tokens_of(written) {
      Some(tokens) -> Some(Pointer(tokens)),
      None -> None,
    },
    _ -> None,
  }

fn tokens_of(written: List<String>) -> Option<List<String>> / {abort.raise} =
  written.fold(Some([]), token_read)

fn token_read(
  accumulator: Option<List<String>>,
  written: String,
) -> Option<List<String>> / {abort.raise} = {
  let tokens = accumulator?;
  let token = unescaped_token(written)?;
  Some(tokens.push(token))
}

fn unescaped_token(written: String) -> Option<String> / {abort.raise} =
  match written.split("~") {
    [] -> Some(written),
    [first, ..rest] ->
      rest.fold(Some(first), |accumulator: Option<String>, piece: String|
        match accumulator {
          None -> None,
          Some(text) -> if piece.starts_with("0") {
            Some(text ++ "~" ++ piece.slice(1, piece.len()))
          } else if piece.starts_with("1") { Some(text ++ "/" ++ piece.slice(1, piece.len())) }
          else { None },
        }),
  }

/// Returns the value in `j` that `p` points to, where each token names an object member or an array
/// element. Returns `None` if there is no such value: the object has no such member, the index is
/// at or past the end of the array, the index is not written as RFC 6901 requires (digits with no
/// leading zero), the token is `-` (which names the position after the last element), or a token is
/// applied to a value that is neither an object nor an array.
pub fn resolve(j: Json, p: Pointer) -> Option<Json> / {abort.raise} =
  match p {
    Pointer(tokens) ->
      tokens.fold(Some(j), |at: Option<Json>, token: String|
        match at {
          Some(Object(m)) -> m.get(token),
          Some(Array(items)) -> element(items, token),
          _ -> None,
        }),
  }

fn element(items: List<Json>, token: String) -> Option<Json> / {abort.raise} = {
  let index = Bytes::of_string(token);
  let n = index.len();
  if n == 0 || index.skip(0, digits()) < n || (n > 1 && index.at(0) == 48) { None }
  else { match index.int_of_ascii() { Some(i) -> items.at(i), None -> None } }
}

fn jsons_at(depth: Int) -> gen::Gen<Json> =
  if depth <= 0 {
    gen::one_of([
      gen::constant(Null),
      gen::map(gen::bool(), |f0: Bool| Bool(f0)),
      gen::map(gen::decimal(), |f0: Decimal| Number(f0)),
      gen::map(gen::text(), |f0: String| Str(f0)),
    ])
  } else {
    gen::one_of([
      gen::constant(Null),
      gen::map(gen::bool(), |f0: Bool| Bool(f0)),
      gen::map(gen::decimal(), |f0: Decimal| Number(f0)),
      gen::map(gen::text(), |f0: String| Str(f0)),
      gen::map(gen::list_of(jsons_at(depth - 1), 3), |f0: List<Json>| Array(f0)),
      gen::map(gen::map_of(gen::text(), jsons_at(depth - 1)), |f0: Map<String, Json>| Object(f0)),
    ])
  }

/// A `Json` as a test draws one.
pub fn jsons() -> gen::Gen<Json> = gen::sized(|size: Int| jsons_at(min(max(size / 16, 0), 3)))

test "parsing what was rendered gives back the value" {
  gen::check(jsons(), |j: Json| { parse(to_bytes(j)) == Ok(j) })
}

test "a codec's decode undoes its encode" {
  gen::check(gen::list(gen::any_int()), |xs: List<Int>| {
    decode_bytes(encode_bytes(xs, list_json(int_json())), list_json(int_json())) == Ok(xs)
  })
}

test "reading JSON in chunks returns the same result wherever the input is split between chunks" {
  gen::check2(gen::list(jsons()), gen::any_int(), |js: List<Json>, cut: Int| {
    read_chunks(cut_in_two(lines_to_bytes(js), cut), no_line_limit(), max_depth())
      == parse_lines(lines_to_bytes(js), no_line_limit(), max_depth())
  })
}

type StringScan = { out: Bytes, in_string: Bool, escaped: Bool }

fn squeezed(text: Bytes) -> Bytes =
  range(0, text.len()).fold(
    { out: b"", in_string: false, escaped: false },
    |s: StringScan, i: Int| {
      let c = text.at(i);
      let extended_output = s.out.concat(byte_of_int(c));
      if s.in_string {
        { out: extended_output, in_string: s.escaped || c != 34, escaped: !s.escaped && c == 92 }
      } else if ws().contains(byte_of_int(c)) { s }
      else { { out: extended_output, in_string: c == 34, escaped: false } }
    },
  ).out

fn no_line_limit() -> Int = 1_000_000

fn cut_in_two(text: Bytes, cut: Int) -> List<Bytes> / {abort.raise} = {
  let n = text.len();
  let at = if n == 0 { 0 } else { (cut % n + n) % n };
  [text.slice(0, at), text.slice(at, n)]
}

fn read_chunks(
  chunks: List<Bytes>,
  max_line: Int,
  max_depth: Int,
) -> Result<List<Json>, LineError> / {abort.raise} = {
  let start: Result<LineStep, LineError> = Ok({
    reader: lines_start(max_line, max_depth),
    values: [],
  });
  let step = chunks.fold(start, fed_chunk)?;
  let last = lines_end(step.reader)?;
  Ok(match last { Some(j) -> step.values.push(j), None -> step.values })
}

fn fed_chunk(
  accumulator: Result<LineStep, LineError>,
  chunk: Bytes,
) -> Result<LineStep, LineError> / {abort.raise} = {
  let so_far = accumulator?;
  let next = lines_step(so_far.reader, chunk)?;
  Ok({ reader: next.reader, values: so_far.values.concat(next.values) })
}

fn parsed(source: Bytes) -> Json / {abort.raise} =
  match parse(source) { Ok(j) -> j, Err(e) -> panic("expected a parse: " ++ error_to_string(e)) }

fn failure(source: Bytes) -> DecodeError / {abort.raise} =
  match parse(source) { Ok(j) -> panic("expected a failure, parsed " ++ to_string(j)), Err(e) -> e }

fn offset_of(source: Bytes) -> Int / {abort.raise} =
  match failure(source).offset { Some(n) -> n, None -> -1 }

test "a missing number or list of strings is null, and an empty list is not" {
  assert_eq(int_or_null(Some(3)), int(3));
  assert_eq(int_or_null(None), Null);
  assert_eq(strings_or_null(Some([])), Array([]));
  assert_eq(strings_or_null(None), Null)
}

test "every kind of value parses" {
  assert_eq(parse(b"null"), Ok(Null));
  assert_eq(parse(b"true"), Ok(Bool(true)));
  assert_eq(parse(b"false"), Ok(Bool(false)));
  assert_eq(parse(b"42"), Ok(int(42)));
  assert_eq(parse(b"\"hi\""), Ok(Str("hi")));
  assert_eq(parse(b"[]"), Ok(Array([])));
  assert_eq(parse(b"{}"), Ok(Object(Map::new())))
}

test "JSON allows whitespace between tokens but not inside a token" {
  assert_eq(parse(b" \t\r\n [ 1 , 2 ] \n"), Ok(Array([int(1), int(2)])));
  assert_eq(parse(b"{ \"a\" : 1 }"), Ok(Object(Map::new().insert("a", int(1)))));
  assert_eq(failure(b"tr ue").message, "expected `true`")
}

test "a nested document parses to the value it describes" {
  assert_eq(
    parse(b"{\"a\":[1,{\"b\":null}],\"c\":true}"),
    Ok(
      Object(
        Map::new().insert("a", Array([int(1), Object(Map::new().insert("b", Null))])).insert(
          "c",
          Bool(true),
        ),
      ),
    ),
  )
}

test "an object is a map, so key order is the map's and not the document's" {
  assert_eq(parsed(b"{\"b\":1,\"a\":2}"), parsed(b"{\"a\":2,\"b\":1}"));
  assert_eq(to_bytes(parsed(b"{\"b\":1,\"a\":2}")), b"{\"a\":2,\"b\":1}")
}

test "when an object repeats a key, `parse` uses the last value for that key" {
  assert_eq(parsed(b"{\"a\":1,\"a\":2}"), Object(Map::new().insert("a", int(2))));
  assert_eq(Map::len(match parsed(b"{\"a\":1,\"a\":2}") { Object(m) -> m, _ -> Map::new() }), 1)
}

type Repeated = { name: String, text: Bytes, at: Int, member: String }

fn repeated() -> List<Repeated> =
  [
    { name: "at the top", text: b"{\"a\":1,\"a\":2}", at: 7, member: "a" },
    { name: "with equal values", text: b"{\"a\":1,\"b\":2,\"a\":1}", at: 13, member: "a" },
    { name: "inside an object", text: b"{\"x\":{\"k\":1, \"k\":2}}", at: 13, member: "k" },
    { name: "inside an array", text: b"[1,{\"k\":null,\"k\":null}]", at: 13, member: "k" },
    { name: "written with an escape", text: b"{\"alg\":1,\"\\u0061lg\":2}", at: 9, member: "alg" },
    { name: "by the empty name", text: b"{\"\":1,\"\":2}", at: 6, member: "" },
  ]

test "`parse_unique` fails at the second occurrence of the repeated member name {c.name}, but `parse` succeeds" for c: Repeated in repeated(
  ) {
  assert_eq(
    parse_unique(c.text),
    Err(error_at(c.at, "this object already has a member named `" ++ c.member ++ "`")),
  );
  assert(match parse(c.text) { Ok(_) -> true, Err(_) -> false })
}

test "`parse_unique` rejects a repeated key only within one object, so different objects may use the same key" {
  let text = b"{\"a\":{\"a\":1},\"b\":[{\"a\":2},{\"a\":3}]}";
  assert_eq(parse_unique(text), parse(text));
  assert_eq(parse_unique(b"{\"a\":1,\"A\":2}"), parse(b"{\"a\":1,\"A\":2}"));
  assert_eq(parse_unique(b"{\"a\":1,}"), parse(b"{\"a\":1,}"));
  assert_eq(
    parse_unique(nest(b"[", b"]", max_depth() + 1)),
    parse(nest(b"[", b"]", max_depth() + 1)),
  )
}

fn backspace() -> String / {abort.raise} = String::of_bytes(b"\x08")

fn form_feed() -> String / {abort.raise} = String::of_bytes(b"\x0c")

test "every escape form decodes" {
  assert_eq(parse(b"\"\\\"\""), Ok(Str("\"")));
  assert_eq(parse(b"\"\\\\\""), Ok(Str("\\")));
  assert_eq(parse(b"\"\\/\""), Ok(Str("/")));
  assert_eq(parse(b"\"\\b\""), Ok(Str(backspace())));
  assert_eq(parse(b"\"\\f\""), Ok(Str(form_feed())));
  assert_eq(parse(b"\"\\n\""), Ok(Str("\n")));
  assert_eq(parse(b"\"\\r\""), Ok(Str("\r")));
  assert_eq(parse(b"\"\\t\""), Ok(Str("\t")));
  assert_eq(parse(b"\"\\u0041\""), Ok(Str("A")))
}

test "`parse` decodes a `\\u` escape to a 1-, 2- or 3-byte character, and a surrogate pair to a 4-byte character" {
  assert_eq(parse(b"\"\\u0000\""), Ok(Str("\0")));
  assert_eq(parse(b"\"\\u00e9\""), Ok(Str("é")));
  assert_eq(parse(b"\"\\u20ac\""), Ok(Str("€")));
  assert_eq(parse(b"\"\\ud83d\\ude00\""), Ok(Str("😀")));
  assert_eq(Bytes::of_string("😀").len(), 4)
}

test "a surrogate that is not part of a pair is rejected" {
  assert_eq(
    failure(b"\"\\ud83d\"").message,
    "a high surrogate must be followed by a \\u low surrogate",
  );
  assert_eq(
    failure(b"\"\\ud83dx\"").message,
    "a high surrogate must be followed by a \\u low surrogate",
  );
  assert_eq(
    failure(b"\"\\ud83d\\u0041\"").message,
    "a high surrogate must be followed by a low surrogate, which is \\udc00 to \\udfff",
  );
  assert_eq(
    failure(b"\"\\ude00\"").message,
    "a low surrogate must follow a high surrogate, which is \\ud800 to \\udbff",
  )
}

test "a malformed escape in a JSON string fails with an error message listing the valid escapes, and the error reports the offset" {
  assert_eq(
    failure(b"\"\\q\"").message,
    "the escapes are \\\" \\\\ \\/ \\b \\f \\n \\r \\t and \\uXXXX",
  );
  assert_eq(offset_of(b"\"a\\q\""), 2);
  assert_eq(failure(b"\"\\u00g0\"").message, "a \\u escape needs exactly four hexadecimal digits");
  assert_eq(failure(b"\"\\u00\"").message, "a \\u escape needs exactly four hexadecimal digits")
}

test "an unescaped control character is rejected and an escaped one is not" {
  assert_eq(
    failure(b"\"a\nb\"").message,
    "a control character must be written as an escape inside a string",
  );
  assert_eq(offset_of(b"\"a\nb\""), 2);
  assert_eq(parse(b"\"a\\nb\""), Ok(Str("a\nb")))
}

test "a string that is never closed is rejected rather than truncated" {
  assert_eq(failure(b"\"abc").message, "this string is never closed");
  assert_eq(failure(b"\"abc\\\"").message, "this string is never closed");
  assert_eq(failure(b"\"").message, "this string is never closed")
}

test "a document that is not UTF-8 is rejected whole" {
  assert_eq(failure(b"\"\xff\"").message, "a JSON document must be valid UTF-8")
}

test "escaping is the inverse of parsing, including the characters JSON does not require escaped" {
  assert_eq(to_bytes(Str("a\"b\\c")), b"\"a\\\"b\\\\c\"");
  assert_eq(to_bytes(Str("\n\t\r" ++ backspace() ++ form_feed())), b"\"\\n\\t\\r\\b\\f\"");
  assert_eq(to_bytes(Str(String::of_bytes(b"\x00\x1f"))), b"\"\\u0000\\u001f\"");
  assert_eq(to_bytes(Str("/é😀")), b"\"".concat(Bytes::of_string("/é😀").concat(b"\"")))
}

test "`to_bytes` escapes quotes and backslashes in a string exactly, including adjacent escapes and a long string" {
  assert_eq(to_bytes(Str("\"ab\\cd\"")), b"\"\\\"ab\\\\cd\\\"\"");
  assert_eq(to_bytes(Str("\"\"\"")), b"\"\\\"\\\"\\\"\"");
  assert_eq(to_bytes(Str("\"tail")), b"\"\\\"tail\"");
  let many = range(0, 200).fold("", |a: String, _: Int| a ++ "ab\"");
  assert_eq(to_bytes(Str(many)).len(), 2 + 200 * 4)
}

test "`parse` accepts JSON numbers with a sign or exponent, and reads a fraction as a decimal" {
  assert_eq(parse(b"0"), Ok(int(0)));
  assert_eq(parse(b"-0"), Ok(int(0)));
  assert_eq(parse(b"-12"), Ok(int(-12)));
  assert_eq(parse(b"1e3"), Ok(int(1000)));
  assert_eq(parse(b"1E3"), Ok(int(1000)));
  assert_eq(parse(b"1e+3"), Ok(int(1000)));
  assert_eq(parse(b"1000e-3"), Ok(int(1)));
  assert_eq(parse(b"1.5"), Ok(Number(1.5m)));
  assert_eq(parse(b"-0.001"), Ok(Number(-0.001m)))
}

test "`parse` rejects numbers JSON does not allow, such as `01`, `1.` and `1e`, with an error message for each" {
  assert_eq(failure(b"01").message, "a number may not have a leading zero");
  assert_eq(failure(b"-").message, "a number needs at least one digit");
  assert_eq(failure(b"1.").message, "a fraction needs at least one digit after the `.`");
  assert_eq(
    failure(b".5").message,
    "expected a value: `{`, `[`, `\"`, a number, `true`, `false` or `null`",
  );
  assert_eq(failure(b"1e").message, "an exponent needs at least one digit");
  assert_eq(failure(b"1e+").message, "an exponent needs at least one digit");
  assert_eq(
    failure(b"+1").message,
    "expected a value: `{`, `[`, `\"`, a number, `true`, `false` or `null`",
  )
}

test "a number outside Decimal's range is a decode error naming the byte offset" {
  assert_eq(offset_of(b"[1,1e400]"), 3);
  assert_eq(offset_of(b"[1,12345678901234567890123456789012345678901234]"), 3);
  assert(failure(b"[1,1e400]").message.contains("outside `Decimal`'s range"))
}

test "parsing and printing a number preserve its trailing zeros, so `1.50` stays `1.50`" {
  assert_eq(parse(b"1.50"), Ok(Number(1.50m)));
  assert_eq(to_bytes(Number(1.50m)), b"1.50");
  assert_eq(to_bytes(Number(1.5m)), b"1.5")
}

test "trailing data after a complete value is rejected" {
  assert_eq(
    failure(b"1 2").message,
    "the document ended here; nothing may follow the top-level value",
  );
  assert_eq(offset_of(b"1 2"), 2);
  assert_eq(offset_of(b"{} {}"), 3);
  assert_eq(offset_of(b"[1,2]x"), 5);
  assert_eq(parse(b"1 \r\n"), Ok(int(1)))
}

test "a truncated document is a diagnostic and not a panic" {
  assert_eq(failure(b"").message, "the input ended where a value was expected");
  assert_eq(failure(b"[1,").message, "the input ended where a value was expected");
  assert_eq(failure(b"[1").message, "expected `,` or `]` in an array");
  assert_eq(failure(b"{\"a\"").message, "expected `:` after an object key");
  assert_eq(failure(b"{\"a\":").message, "the input ended where a value was expected");
  assert_eq(failure(b"{\"a\":1").message, "expected `,` or `}` in an object");
  assert_eq(failure(b"nul").message, "the input ended inside `null`")
}

test "`parse` rejects trailing commas, unquoted object keys and arrays with a missing comma" {
  assert_eq(
    failure(b"[1,]").message,
    "expected a value: `{`, `[`, `\"`, a number, `true`, `false` or `null`",
  );
  assert_eq(failure(b"{\"a\":1,}").message, "an object key must be a quoted string");
  assert_eq(failure(b"{a:1}").message, "an object key must be a quoted string");
  assert_eq(failure(b"[1 2]").message, "expected `,` or `]` in an array")
}

fn nest(open: Bytes, close: Bytes, depth: Int) -> Bytes =
  range(0, depth).fold(b"1", |accumulator: Bytes, i: Int| open.concat(accumulator.concat(close)))

test "nesting is bounded, and the bound is a diagnostic rather than a stack overflow" {
  assert(match parse(nest(b"[", b"]", max_depth())) { Ok(_) -> true, Err(_) -> false });
  assert(failure(nest(b"[", b"]", max_depth() + 1)).message.contains("nested deeper than"));
  assert(failure(nest(b"{\"a\":", b"}", max_depth() + 1)).message.contains("nested deeper than"));
  assert(failure(nest(b"[", b"", 500)).message.contains("nested deeper than"))
}

fn round_trip_int(n: Int) -> Result<Int, DecodeError> / {abort.raise} =
  decode_bytes(encode_bytes(n, int_json()), int_json())

test "the codecs for `Int`, `Bool`, `String`, `Decimal` and unit decode the values they encode" {
  assert_eq(round_trip_int(0), Ok(0));
  assert_eq(round_trip_int(-9007199254740993), Ok(-9007199254740993));
  assert_eq(decode_bytes(encode_bytes(true, bool_json()), bool_json()), Ok(true));
  assert_eq(decode_bytes(encode_bytes("hi\n", string_json()), string_json()), Ok("hi\n"));
  assert_eq(decode_bytes(encode_bytes(1.50m, decimal_json()), decimal_json()), Ok(1.50m));
  assert_eq(decode_bytes(encode_bytes((), unit_json()), unit_json()), Ok(()))
}

test "`char_json` encodes a character as a one-character string, and `Instant` and `Duration` encode as a nanosecond count" {
  assert_eq(encode_bytes('\u{e9}', char_json()), b"\"\xc3\xa9\"");
  assert_eq(decode_bytes(encode_bytes('\u{1F600}', char_json()), char_json()), Ok('\u{1F600}'));
  assert_eq(
    char_json().decode(Str("ab")),
    Err(decode_error("expected a string of one character, found a string")),
  );
  assert(char_json().decode(Str("")) != Ok('a'));
  assert_eq(encode_bytes(Instant(1_500), instant_json()), b"1500");
  assert_eq(decode_bytes(b"-7", instant_json()), Ok(Instant(-7)));
  assert_eq(
    decode_bytes(encode_bytes(Duration(42), duration_json()), duration_json()),
    Ok(Duration(42)),
  );
  assert(duration_json().decode(Number(1.5m)) != Ok(Duration(1)))
}

test "a number with a fraction is not an Int" {
  assert_eq(
    int_json().decode(Number(1.5m)),
    Err(decode_error("expected a whole number, found `1.5`")),
  );
  assert_eq(int_json().decode(Number(1.0m)), Ok(1));
  assert_eq(
    int_json().decode(Number(100000000000000000000m)),
    Err(decode_error("`100000000000000000000` is outside `Int`'s range")),
  )
}

test "a finite `Float` encodes and decodes back, and a non-finite `Float` fails with NaN or Infinity as the reason" {
  assert_eq(decode_bytes(encode_bytes(1.5, float_json()), float_json()), Ok(1.5));
  assert_eq(encode_bytes(0.0, float_json()), b"0");
  assert_eq(float_reason(0.0 / 0.0), "NaN");
  assert_eq(float_reason(1.0 / 0.0), "Infinity");
  assert_eq(float_reason(-1.0 / 0.0), "-Infinity")
}

test "decoding a JSON value of the wrong type fails with an error naming the expected type and the type found" {
  assert_eq(int_json().decode(Str("1")), Err(decode_error("expected a number, found a string")));
  assert_eq(bool_json().decode(Null), Err(decode_error("expected a boolean, found null")));
  assert_eq(
    list_json(int_json()).decode(Object(Map::new())),
    Err(decode_error("expected an array, found an object")),
  )
}

test "a failure inside a structure names its path" {
  assert_eq(
    error_to_string(match list_json(int_json()).decode(Array([int(1), Str("x")])) {
      Err(e) -> e,
      Ok(_) -> decode_error("unreachable"),
    }),
    "$[1]: expected a number, found a string",
  );
  assert_eq(
    error_to_string(match field(parsed(b"{\"a\":{\"b\":1}}"), "a", string_json()) {
      Err(e) -> e,
      Ok(_) -> decode_error("unreachable"),
    }),
    "$.a: expected a string, found an object",
  )
}

test "a missing field and an optional one give different results" {
  let j = parsed(b"{\"a\":1}");
  assert_eq(
    error_to_string(match field(j, "b", int_json()) {
      Err(e) -> e,
      Ok(_) -> decode_error("unreachable"),
    }),
    "$.b: this field is missing",
  );
  assert_eq(optional_field(j, "b", int_json()), Ok(None));
  assert_eq(optional_field(j, "a", int_json()), Ok(Some(1)));
  assert_eq(optional_field(parsed(b"{\"a\":null}"), "a", int_json()), Ok(None))
}

test "`list_json` encodes a list as a JSON array and decodes it back to the same list" {
  let xs = [1, 2, 3];
  assert_eq(encode_bytes(xs, list_json(int_json())), b"[1,2,3]");
  assert_eq(decode_bytes(b"[1,2,3]", list_json(int_json())), Ok(xs));
  assert_eq(decode_bytes(b"[]", list_json(int_json())), Ok([]))
}

test "`array_json` encodes an `Array` as a JSON array like `list_json` does, and rejects a JSON object" {
  let xs = Array::of_list([1, 2, 3]);
  assert_eq(encode_bytes(xs, array_json(int_json())), b"[1,2,3]");
  assert_eq(decode_bytes(b"[1,2,3]", array_json(int_json())), Ok(xs));
  assert_eq(decode_bytes(b"[]", array_json(int_json())), Ok(Array::new(0, 0)));
  assert(decode_bytes(b"{}", array_json(int_json())) != Ok(xs))
}

test "a string-keyed map is an object and any other map is an array of pairs" {
  let m = Map::new().insert("b", 2).insert("a", 1);
  assert_eq(encode_bytes(m, string_map_json(int_json())), b"{\"a\":1,\"b\":2}");
  assert_eq(decode_bytes(b"{\"a\":1,\"b\":2}", string_map_json(int_json())), Ok(m));

  let byint = Map::new().insert(2, "b").insert(1, "a");
  assert_eq(
    encode_bytes(byint, map_json(int_json(), string_json())),
    b"[{\"key\":1,\"value\":\"a\"},{\"key\":2,\"value\":\"b\"}]",
  );
  assert_eq(
    decode_bytes(
      b"[{\"key\":1,\"value\":\"a\"},{\"key\":2,\"value\":\"b\"}]",
      map_json(int_json(), string_json()),
    ),
    Ok(byint),
  )
}

test "a variant with no fields is a string and one with fields is a tagged object" {
  assert_eq(variant("Placed", []), Str("Placed"));
  assert_eq(to_bytes(variant("Refunded", [int(3)])), b"{\"tag\":\"Refunded\",\"values\":[3]}");
  assert_eq(variant_of(Str("Placed")), Ok({ tag: "Placed", values: [] }));
  assert_eq(
    variant_of(parsed(b"{\"tag\":\"Refunded\",\"values\":[3]}")),
    Ok({ tag: "Refunded", values: [int(3)] }),
  );
  assert_eq(
    variant_of(int(1)),
    Err(decode_error("expected a variant: a string, or an object with a `tag`, found a number")),
  )
}

test "`result_json` encodes and decodes both an `Ok` value and an `Err` value" {
  let codec = result_json(int_json(), string_json());
  assert_eq(encode_bytes(Ok(1), codec), b"{\"tag\":\"Ok\",\"values\":[1]}");
  assert_eq(decode_bytes(b"{\"tag\":\"Ok\",\"values\":[1]}", codec), Ok(Ok(1)));
  assert_eq(decode_bytes(b"{\"tag\":\"Err\",\"values\":[\"no\"]}", codec), Ok(Err("no")));
  assert(match decode_bytes(b"\"Other\"", codec) { Err(_) -> true, Ok(_) -> false })
}

test "an option is null, and null is an option" {
  assert_eq(encode_bytes(None, option_json(int_json())), b"null");
  assert_eq(encode_bytes(Some(1), option_json(int_json())), b"1");
  assert_eq(decode_bytes(b"null", option_json(int_json())), Ok(None));
  assert_eq(decode_bytes(b"1", option_json(int_json())), Ok(Some(1)))
}

test "bytes are base64, padding included" {
  assert_eq(base64_encode(b""), "");
  assert_eq(base64_encode(b"f"), "Zg==");
  assert_eq(base64_encode(b"fo"), "Zm8=");
  assert_eq(base64_encode(b"foo"), "Zm9v");
  assert_eq(base64_encode(b"foob"), "Zm9vYg==");
  assert_eq(base64_encode(b"fooba"), "Zm9vYmE=");
  assert_eq(base64_encode(b"foobar"), "Zm9vYmFy");
  assert_eq(base64_decode("Zm9vYmFy"), Ok(b"foobar"));
  assert_eq(base64_decode("Zg=="), Ok(b"f"));
  assert_eq(base64_decode(base64_encode(b"\x00\xff\xfe")), Ok(b"\x00\xff\xfe"));
  assert_eq(encode_bytes(b"\xff", bytes_json()), b"\"/w==\"")
}

test "`base64_decode` fails on text with wrong padding or characters outside the base64 alphabet" {
  assert(match base64_decode("Zg=") { Err(_) -> true, Ok(_) -> false });
  assert(match base64_decode("Z!==") { Err(_) -> true, Ok(_) -> false });
  assert(match base64_decode("Z=g=") { Err(_) -> true, Ok(_) -> false })
}

fn order_payload() -> Bytes =
  b"{\"id\":\"a4f1c2\",\"customer\":{\"id\":991,\"name\":\"Ada Lovelace\",\"email\":\"ada@example.com\"},".concat(
    b"\"lines\":[{\"sku\":\"PLY-001\",\"qty\":2,\"price\":19.99},{\"sku\":\"PLY-002\",\"qty\":1,\"price\":4.50}],".concat(
      b"\"total\":44.48,\"placed_at\":1723600000,\"notes\":null,\"paid\":true}",
    ),
  )

fn line_price(j: Json) -> Result<Decimal, DecodeError> / {abort.raise} =
  field(j, "price", decimal_json())

test "a realistic order payload parses, its fields decode to the expected values, and it renders back" {
  let doc = parsed(order_payload());
  assert_eq(field(doc, "id", string_json()), Ok("a4f1c2"));
  assert_eq(field(doc, "paid", bool_json()), Ok(true));
  assert_eq(optional_field(doc, "notes", string_json()), Ok(None));
  assert_eq(field(doc, "placed_at", int_json()), Ok(1723600000));
  assert_eq(field(doc, "total", decimal_json()), Ok(44.48m));

  assert_eq(
    decode_and_then(field(doc, "customer", json_json()), |c: Json| field(c, "name", string_json())),
    Ok("Ada Lovelace"),
  );

  assert_eq(
    decode_and_then(field(doc, "lines", list_json(json_json())), |ls: List<Json>|
      collect_prices(ls, [])),
    Ok([19.99m, 4.50m]),
  );

  assert_eq(to_bytes(doc), to_bytes(parsed(to_bytes(doc))))
}

fn collect_prices(
  ls: List<Json>,
  accumulator: List<Decimal>,
) -> Result<List<Decimal>, DecodeError> / {abort.raise} =
  match ls {
    [] -> Ok(accumulator),
    [l, ..rest] ->
      decode_and_then(line_price(l), |p: Decimal| collect_prices(rest, accumulator.push(p))),
  }

fn round_trips(source: Bytes) -> Bool / {abort.raise} = to_bytes(parsed(source)) == source

test "a large array renders and parses back to itself" {
  let big = Array(range(0, 2000).map(|i: Int| Number(Decimal::of_int(i))));
  let text = to_string(big);
  assert_eq(text.len(), 8891);
  assert_eq(parse(Bytes::of_string(text)), Ok(big));
  let joined = Array(range(0, 500).map(|i: Int| Str("value")));
  assert_eq(parse(to_bytes(joined)), Ok(joined))
}

test "rendering is canonical, so a rendered document parses to itself" {
  assert(round_trips(b"null"));
  assert(round_trips(b"[1,2,3]"));
  assert(round_trips(b"{\"a\":1,\"b\":[true,null]}"));
  assert(round_trips(b"\"\\u0000\\n\\\"\""));
  assert(round_trips(b"-1.50"));
  assert(!round_trips(b"[1, 2]"));
  assert_eq(parsed(b"[1, 2]"), parsed(b"[1,2]"))
}

fn pretty_printed() -> String =
  \\{
  \\  "a": {},
  \\  "b": [
  \\    1.50,
  \\    {
  \\      "c": null
  \\    },
  \\    []
  \\  ]
  \\}

test "pretty text puts each object member and array element on its own line in sorted key order, with no trailing newline" {
  let doc = parsed(b"{\"b\":[1.50,{\"c\":null},[]],\"a\":{}}");
  assert_eq(pretty_string(doc, 2), pretty_printed());
  assert_eq(pretty_bytes(doc, 2), Bytes::of_string(pretty_printed()));
  assert_eq(pretty_string(parsed(b"[1,[2]]"), 4), "[\n    1,\n    [\n        2\n    ]\n]")
}

test "a value with nothing nested in it is written on one line" {
  assert_eq(pretty_string(Array([]), 2), "[]");
  assert_eq(pretty_string(Object(Map::new()), 2), "{}");
  assert_eq(pretty_string(Null, 2), "null");
  assert_eq(pretty_string(Str("a\nb"), 2), "\"a\\nb\"");
  assert_eq(pretty_string(parsed(b"[[],{}]"), 1), "[\n [],\n {}\n]")
}

test "an indent of zero or less still puts each element on its own line, with no indentation" {
  let doc = parsed(b"{\"a\":[1,2]}");
  assert_eq(pretty_string(doc, 0), "{\n\"a\": [\n1,\n2\n]\n}");
  assert_eq(pretty_string(doc, 0 - 3), pretty_string(doc, 0))
}

test "pretty text contains the same tokens as compact text, a string's whitespace among them" {
  let doc = parsed(b"{\"a b\":\" [1, 2] \",\"c\":\"\\\" , \\\\\"}");
  assert_eq(squeezed(pretty_bytes(doc, 2)), to_bytes(doc));
  assert_eq(squeezed(b" [ 1 , \" a \\\" b \" ] \r\n"), b"[1,\" a \\\" b \"]")
}

test "pretty printing a value nested deeper than `max_depth` fails, while one at `max_depth` prints and parses back" {
  let deep = range(0, max_depth() + 1).fold(Null, |inner: Json, _: Int| Array([inner]));
  let written = try[abort.raise] { pretty_bytes(deep, 2) };
  assert(match written { Err(_) -> true, Ok(_) -> false });
  let deepest = range(0, max_depth()).fold(Null, |inner: Json, _: Int| Array([inner]));
  assert_eq(parse(pretty_bytes(deepest, 1)), Ok(deepest))
}

test "`parse_lines` returns one value per line in order, and the last line needs no trailing line feed" {
  let three = Ok([Object(Map::new().insert("a", int(1))), Array([int(2)]), Str("three")]);
  assert_eq(parse_lines(b"{\"a\":1}\n[2]\n\"three\"\n", 64, 8), three);
  assert_eq(parse_lines(b"{\"a\":1}\n[2]\n\"three\"", 64, 8), three);
  assert_eq(parse_lines(b"", 64, 8), Ok([]));
  assert_eq(parse_lines(b"\n", 64, 8), Ok([]))
}

test "`parse_lines` skips blank lines but still counts them in line numbers, and treats a carriage return as whitespace" {
  assert_eq(parse_lines(b"1\n\n \t\n2\n", 64, 8), Ok([int(1), int(2)]));
  assert_eq(parse_lines(b"1\r\n2\r\n\r\n", 64, 8), Ok([int(1), int(2)]));
  assert_eq(
    parse_lines(b"1\n\n \t\n?\n", 64, 8),
    Err({
      line: 4,
      error: error_at(0, "expected a value: `{`, `[`, `\"`, a number, `true`, `false` or `null`"),
    }),
  )
}

type InvalidInput = { name: String, text: Bytes, line: Int, offset: Int, message: String }

fn invalid_inputs() -> List<InvalidInput> =
  [
    {
      name: "a byte order mark",
      text: b"\xef\xbb\xbf{}\n",
      line: 1,
      offset: 0,
      message: "a byte order mark is no part of JSON: remove its three bytes",
    },
    {
      name: "two values on a line",
      text: b"1\n2 3\n",
      line: 2,
      offset: 2,
      message: "the document ended here; nothing may follow the top-level value",
    },
    {
      name: "a value over two lines",
      text: b"[1,\n2]\n",
      line: 1,
      offset: 3,
      message: "the input ended where a value was expected",
    },
    {
      name: "a line that is not UTF-8",
      text: b"1\n2\n\"\xff\"\n",
      line: 3,
      offset: 0,
      message: "a JSON document must be valid UTF-8",
    },
    {
      name: "a line past the length",
      text: b"[1]\n[1,2,3,4,5,6,7]\n",
      line: 2,
      offset: 12,
      message: "a line is longer than the 12 bytes this reader accepts",
    },
    {
      name: "a value past the depth",
      text: b"[[1]]\n[[[1]]]\n",
      line: 2,
      offset: 2,
      message: "nested deeper than 2 levels",
    },
    {
      name: "a last line that is cut short",
      text: b"1\n{\"a\":",
      line: 2,
      offset: 5,
      message: "the input ended where a value was expected",
    },
  ]

test "`parse_lines` and `read_chunks` both fail on the invalid input {c.name}, returning its line number and the byte offset of the error" for c: InvalidInput in invalid_inputs(
  ) {
  let rejected: Result<List<Json>, LineError> = Err({
    line: c.line,
    error: error_at(c.offset, c.message),
  });
  assert_eq(parse_lines(c.text, 12, 2), rejected);
  assert_eq(read_chunks(each_byte(c.text), 12, 2), rejected)
}

fn each_byte(text: Bytes) -> List<Bytes> = range(0, text.len()).map(|i: Int| text.slice(i, i + 1))

test "a line exactly as long as the line limit parses, and a longer line is rejected before the line ends" {
  assert_eq(parse_lines(b"[1,2,3]\n", 7, 8), Ok([Array([int(1), int(2), int(3)])]));
  assert_eq(parse_lines(b"[1,2,3]\r\n", 8, 8), Ok([Array([int(1), int(2), int(3)])]));
  let early = lines_step(lines_start(7, 8), b"[1,2,3,4");
  assert_eq(
    early,
    Err({ line: 1, error: error_at(7, "a line is longer than the 7 bytes this reader accepts") }),
  );
  assert_eq(
    line_error_to_string({ line: 3, error: error_at(7, "no") }),
    "line 3: $: no (at byte 7)",
  )
}

test "a depth limit above the parser's maximum is capped at that maximum, and a limit of zero or less rejects every array" {
  assert(match parse_lines(nest(b"[", b"]", max_depth()), no_line_limit(), 1_000) {
    Ok(_) -> true,
    Err(_) -> false,
  });
  assert_eq(
    parse_lines(nest(b"[", b"]", max_depth() + 1), no_line_limit(), 1_000),
    Err({ line: 1, error: error_at(max_depth(), "nested deeper than 128 levels") }),
  );
  assert_eq(parse_lines(b"7\n", 8, 0), Ok([int(7)]));
  assert_eq(
    parse_lines(b"[]\n", 8, 0 - 1),
    Err({ line: 1, error: error_at(0, "nested deeper than 0 levels") }),
  );
  assert_eq(
    parse_lines(b"[[]]\n", 8, 1),
    Err({ line: 1, error: error_at(1, "nested deeper than 1 level") }),
  )
}

test "`read_chunks` gives the same result when input is split mid-value or mid-character, buffering the unfinished line" {
  let text = Bytes::of_string("{\"name\":\"zoë\"}\n[1,\"😀\"]\n");
  let whole = parse_lines(text, 64, 8);
  assert_eq(
    whole,
    Ok([parsed(Bytes::of_string("{\"name\":\"zoë\"}")), Array([int(1), Str("😀")])]),
  );
  assert_eq(read_chunks(each_byte(text), 64, 8), whole);
  let first = lines_step(lines_start(64, 8), text.slice(0, 12));
  assert_eq(
    first,
    Ok({ reader: { max_line: 64, max_depth: 8, line: 1, partial: text.slice(0, 12) }, values: [] }),
  )
}

test "`lines_to_bytes` writes each value on its own line, with no line feed inside a value" {
  assert_eq(lines_to_bytes([]), b"");
  assert_eq(
    lines_to_bytes([Str("a\nb"), parsed(b"{ \"k\" : [ 1 , 2 ] }")]),
    b"\"a\\nb\"\n{\"k\":[1,2]}\n",
  )
}

fn rfc6901_document() -> Json / {abort.raise} =
  parsed(
    b"{\"foo\":[\"bar\",\"baz\"],\"\":0,\"a/b\":1,\"c%d\":2,\"e^f\":3,\"g|h\":4,\"i\\\\j\":5,\"k\\\"l\":6,\" \":7,\"m~n\":8}",
  )

type Pointed = { pointer: String, expected: Bytes }

fn pointer_cases() -> List<Pointed> =
  [
    { pointer: "/foo", expected: b"[\"bar\",\"baz\"]" },
    { pointer: "/foo/0", expected: b"\"bar\"" },
    { pointer: "/", expected: b"0" },
    { pointer: "/a~1b", expected: b"1" },
    { pointer: "/c%d", expected: b"2" },
    { pointer: "/e^f", expected: b"3" },
    { pointer: "/g|h", expected: b"4" },
    { pointer: "/i\\j", expected: b"5" },
    { pointer: "/k\"l", expected: b"6" },
    { pointer: "/ ", expected: b"7" },
    { pointer: "/m~0n", expected: b"8" },
  ]

fn pointed_by(text: String) -> Option<Json> / {abort.raise} =
  match pointer_of(text) {
    Some(p) -> resolve(rfc6901_document(), p),
    None -> panic("not a pointer: " ++ text),
  }

test "`pointed_by` returns the value that the RFC 6901 pointer `{c.pointer}` selects" for c: Pointed in pointer_cases(
  ) { assert_eq(pointed_by(c.pointer), Some(parsed(c.expected))) }

test "the empty pointer resolves to the whole document, and a pointer to a missing member or index gives `None`" {
  assert_eq(pointed_by(""), Some(rfc6901_document()));
  assert_eq(pointed_by("/nope"), None);
  assert_eq(pointed_by("/foo/2"), None);
  assert_eq(pointed_by("/foo/-"), None);
  assert_eq(pointed_by("/foo/0/bar"), None);
  assert_eq(pointed_by("/a~1b/0"), None)
}

test "an array index is digits with no leading zero" {
  let items = parsed(b"[\"zero\",\"one\"]");
  let at = |token: String| resolve(items, Pointer([token]));
  assert_eq(at("1"), Some(Str("one")));
  assert_eq(at("0"), Some(Str("zero")));
  assert_eq(at("01"), None);
  assert_eq(at("00"), None);
  assert_eq(at("+1"), None);
  assert_eq(at("-1"), None);
  assert_eq(at("1.0"), None);
  assert_eq(at(""), None);
  assert_eq(at("99999999999999999999"), None)
}

test "`pointer_text` escapes `~` and `/` in each token, `pointer_of` parses it back, and text that is not a pointer gives `None`" {
  let p = Pointer(["a/b", "m~n", "", "~1"]);
  assert_eq(pointer_text(p), "/a~1b/m~0n//~01");
  assert_eq(f"{p}", "/a~1b/m~0n//~01");
  assert_eq(pointer_of("/a~1b/m~0n//~01"), Some(p));
  assert_eq(pointer_of(""), Some(Pointer([])));
  assert_eq(pointer_of("/"), Some(Pointer([""])));
  assert_eq(pointer_of("foo"), None);
  assert_eq(pointer_of("foo/bar"), None);
  assert_eq(pointer_of("/a~"), None);
  assert_eq(pointer_of("/a~2b"), None)
}
