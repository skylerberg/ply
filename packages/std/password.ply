//! Hashes and verifies passwords as strings that a user table can store. It makes and verifies
//! Argon2id and scrypt hashes. It can only verify Argon2i, Argon2d, bcrypt and PBKDF2 hashes, so a
//! store that used them can migrate.
//!
//! A hash string records the algorithm, its cost, the salt and the tag. `hash` writes the PHC
//! string format, for example `$argon2id$v=19$m=19456,t=2,p=1$salt$tag`, with sixteen bytes of salt
//! drawn from `entropy`. `verify` reads the costs from the stored string, computes the tag again
//! for the supplied password, and compares the two tags in time that depends only on their length,
//! never on where they differ.
//!
//! There is no default cost. `hash` and `verify` both take the `Params` that the deployment hashes
//! with. `verify` returns `ValidNeedsRehash` for a correct password whose stored hash differs from
//! what `hash` would write with those params: a different algorithm, cost, salt length or tag
//! length. The password is available only while verifying, so that is the moment to replace the
//! stored hash. Raising the cost then means changing one `Params` value.
//!
//! Each operation of `kdf` is slow and, for Argon2 and scrypt, uses a lot of memory. Each call
//! therefore runs on a separate runtime thread, and the program's other tasks keep running. At most
//! as many hashes run at once as the machine has cores. The others wait in a queue, and each task
//! waits only for its own hash. Each operation is a function of its arguments, so a test that calls
//! one is cached like any other test result. Argon2 fills its lanes one after another, so a hash
//! with `p` lanes takes as long as one lane that uses all the memory. `fake_kdf` replaces `kdf`
//! with a cheap stand-in, for testing a sign-up or a login without computing real hashes.
//!
//! A password is a `Secret` from where it is read until the operation that hashes it, and a hash
//! cannot be reversed to recover it. The password is hashed as its UTF-8 bytes, exactly as given,
//! as every implementation this module reads does. An error reports which number was out of range,
//! never the password.
//!
//! Whoever wrote a stored string chose its numbers, so `read` checks each against `bounds` before
//! computing anything, and `verify` returns `Invalid` for a string that `read` rejects. Each bound
//! limits the work to a few seconds of one core: for Argon2, 2 GiB of memory (the first option RFC
//! 9106 recommends) and 1 GiB filled four times; for scrypt, a gigabyte filled once; for bcrypt,
//! cost 16; for PBKDF2, ten million iterations.
//!
//! The forms this module reads: - Argon2 version 19, as the reference implementation writes it. -
//! scrypt in the PHC form `$scrypt$ln=17,r=8,p=1$salt$tag`, which passlib and the Rust `scrypt`
//! crate write. Other scrypt formats, such as the `$7$` and `$s0$` prefixes, are rejected. - bcrypt
//! as `$2a$`, `$2b$` and `$2y$`, each read as `$2b$`. Its key is the first seventy-two bytes of the
//! password followed by a terminating zero, so bytes after that in a longer password do not affect
//! the hash. - PBKDF2 under SHA-1, SHA-256 and SHA-512, as passlib writes it,
//! `$pbkdf2-sha256$29000$salt$tag`, and in the PHC form, `$pbkdf2-sha256$i=29000,l=32$salt$tag`.

import std.bytes (u32_be)
import std.gen
import std.gen (Gen)
import std.hash (hmac_sha256, tags_match)
import std.internal.native (native, wait, job_wait)
import std.laws (round_trip)
import std.list
import std.radix
import std.radix (Alphabet)
import std.random (entropy, rand, token_bytes, with_rand)
import std.result
import std.show (show)
import std.string

/// The Argon2 variant, which sets how the algorithm picks the memory blocks it reads and writes on
/// each pass over its memory.
pub type Variant =
  /// Picks memory blocks based on the password. This makes it the hardest variant for an attacker's
  /// hardware to guess against, but the pattern of memory accesses leaks information about the
  /// password.
  | Argon2d
  /// Chooses blocks independently of anything secret.
  | Argon2i
  /// Like `Argon2i` for the first half pass and `Argon2d` after it. RFC 9106 recommends this one.
  | Argon2id

/// The hash function PBKDF2's HMAC uses.
pub type Digest = | Sha1 | Sha256 | Sha512

/// What an Argon2 hash costs: `memory` KiB, filled `passes` times, in `lanes` lanes.
pub type Argon2Cost = new { memory: Int, passes: Int, lanes: Int }

/// What a scrypt hash costs: it fills `2^log_n` blocks of `128 * r` bytes of memory, and `p`
/// independent copies of the mixing work multiply the time by `p`.
pub type ScryptCost = new { log_n: Int, r: Int, p: Int }

/// An algorithm and what it costs.
pub type Scheme =
  /// Argon2 version 1.3, written `v=19` in a hash string.
  | Argon2(Variant, Argon2Cost)
  /// scrypt as RFC 7914 defines it.
  | Scrypt(ScryptCost)
  /// bcrypt at this cost: `2^cost` rounds of its key schedule.
  | Bcrypt(Int)
  /// PBKDF2 under HMAC, with this many iterations.
  | Pbkdf2(Digest, Int)

/// A parsed stored hash: how it was made, and its salt and tag.
pub type StoredHash = new { scheme: Scheme, salt: Bytes, tag: Bytes }

/// The algorithm and cost that `hash` writes with: Argon2id or scrypt at a cost within `bounds`.
/// Make one with `argon2id`, `scrypt`, or one of the `owasp_` functions.
pub opaque type Params = | WithArgon2id(Argon2Cost) | WithScrypt(ScryptCost)

/// The result of `verify`: whether the password matches the stored hash, and whether that hash
/// should be replaced.
pub type Verdict =
  /// The password matches, and the stored hash is what `hash` would write.
  | Valid
  /// The password matches, and the stored hash should be replaced with a new `hash` of it.
  | ValidNeedsRehash
  /// The password does not match, or `read` cannot read the stored text.
  | Invalid

/// The limits a hash is checked against before anything is computed.
pub type Bounds = new {
  /// The longest hash string, in bytes.
  text: Int,
  /// The most memory an Argon2 hash fills, in KiB.
  memory: Int,
  /// The most KiB an Argon2 hash fills over all its passes.
  argon2_work: Int,
  /// The largest `2^log_n * r * p` of a scrypt hash. It limits the hash's memory,
  /// `128 * r * 2^log_n` bytes, to a gigabyte.
  scrypt_work: Int,
  /// The highest cost of a bcrypt hash.
  bcrypt_cost: Int,
  /// The most iterations of PBKDF2.
  iterations: Int,
  /// The longest salt, in bytes.
  salt: Int,
  /// The longest tag, in bytes.
  tag: Int,
}

/// Why a text is rejected as a hash, or why a cost is rejected as out of range.
pub type Error =
  /// The text is this many bytes, more than `bounds().text`.
  | TooLong(Int)
  /// The text does not have the fields its first field calls for: a field is missing or extra, a
  /// parameter is misnamed or out of order, a number is not plain decimal, or a salt or tag is not
  /// in its form's base64.
  | Malformed
  /// The algorithm name in the text's first field is not one this module reads. The payload is that
  /// name.
  | Unknown(String)
  /// The Argon2 version number in the text is not 19, the only version this module reads. A text
  /// with no `v=` field is version 16.
  | Version(Int)
  /// Argon2's memory in KiB: under eight per lane, or over `bounds().memory`.
  | Memory(Int)
  /// Argon2's passes: under one, or so many that they fill more than `bounds().argon2_work`.
  | Passes(Int)
  /// Argon2's lanes: outside 1 to 255.
  | Lanes(Int)
  /// scrypt's cost: a `log_n`, `r` or `p` under one, or a product over `bounds().scrypt_work`.
  | ScryptWork(ScryptCost)
  /// bcrypt's cost: outside 4 to `bounds().bcrypt_cost`.
  | BcryptCost(Int)
  /// PBKDF2's iterations: outside 1 to `bounds().iterations`.
  | Iterations(Int)
  /// A salt whose length in bytes, the payload, is not allowed. A salt may not be longer than
  /// `bounds().salt`. It must be at least eight bytes for Argon2 and for a new hash from
  /// `hash_with_salt`, and exactly sixteen bytes for bcrypt.
  | SaltLength(Int)
  /// A tag whose length in bytes, the payload, is not allowed. A tag must be at least four bytes
  /// and no more than `bounds().tag`, except that a bcrypt tag must be exactly twenty-three bytes.
  | TagLength(Int)

/// The error this module's functions raise.
pub effect password {
  /// A text is not a hash this module reads, or a cost is outside what it accepts.
  raise fail(e: Error)
}

/// The operations that compute a password hash. The runtime computes each one on a separate thread.
/// A cost over `bounds` makes the operation raise `abort`. No function in this module requests such
/// a cost.
pub effect kdf {
  /// Argon2 version 1.3 as RFC 9106 defines it: `variant` is `argon2d`, `argon2i` or `argon2id`,
  /// `key` and `data` its secret and its associated data, either of which may be empty, `memory`
  /// in KiB, and `length` how many bytes of tag to return.
  read argon2(variant: String, password: Secret<Bytes>, salt: Bytes, key: Secret<Bytes>, data: Bytes, memory: Int, passes: Int, lanes: Int, length: Int) -> Bytes
  /// scrypt as RFC 7914 defines it, with `N = 2^log_n`.
  read scrypt(password: Secret<Bytes>, salt: Bytes, log_n: Int, r: Int, p: Int, length: Int) -> Bytes
  /// The twenty-three tag bytes a bcrypt hash string contains, under a sixteen-byte salt. The key
  /// is the password and a terminating zero, cut to seventy-two bytes.
  read bcrypt(password: Secret<Bytes>, salt: Bytes, cost: Int) -> Bytes
  /// PBKDF2 under HMAC with the hash named `SHA-1`, `SHA-256`, `SHA-384` or `SHA-512`.
  read pbkdf2(hash: String, password: Secret<Bytes>, salt: Bytes, iterations: Int, length: Int) -> Bytes
}

/// The limits every hash is checked against.
pub const fn bounds() -> Bounds =
  {
    text: 512,
    memory: 1 << 21,
    argon2_work: 1 << 22,
    scrypt_work: 1 << 23,
    bcrypt_cost: 16,
    iterations: 10000000,
    salt: 64,
    tag: 64,
  }

fn generated_salt_length() -> Int = 16

fn tag_bytes() -> Int = 32

/// Returns Argon2id parameters that fill `memory` KiB of memory in `passes` passes, using `lanes`
/// parallel lanes. Raises `Memory`, `Passes` or `Lanes` for a cost Argon2 does not define or one
/// past `bounds`.
pub fn argon2id(memory: Int, passes: Int, lanes: Int) -> Params / {password.fail} = {
  let cost: Argon2Cost = { memory: memory, passes: passes, lanes: lanes };
  check_bounds(Argon2(Argon2id, cost), generated_salt_length(), tag_bytes());
  WithArgon2id(cost)
}

/// Returns scrypt parameters with `N = 2^log_n`, blocks of `128 * r` bytes and a parallelism of
/// `p`. Raises `ScryptWork` for a cost scrypt does not define or one past `bounds`.
pub fn scrypt(log_n: Int, r: Int, p: Int) -> Params / {password.fail} = {
  let cost: ScryptCost = { log_n: log_n, r: r, p: p };
  check_bounds(Scrypt(cost), generated_salt_length(), tag_bytes());
  WithScrypt(cost)
}

/// Returns the lowest-cost Argon2id parameters OWASP recommends: 19 MiB of memory, two passes and
/// one lane.
pub const fn owasp_argon2id() -> Params = WithArgon2id({ memory: 19456, passes: 2, lanes: 1 })

/// Returns OWASP's alternative Argon2id parameters that use more memory and fewer passes: 46 MiB,
/// one pass and one lane.
pub const fn owasp_argon2id_46mib() -> Params = WithArgon2id({ memory: 47104, passes: 1, lanes: 1 })

/// Returns the scrypt parameters OWASP recommends when Argon2id is not available: `N = 2^17`, `r =
/// 8` and `p = 1`, which fill 128 MiB of memory.
pub const fn owasp_scrypt() -> Params = WithScrypt({ log_n: 17, r: 8, p: 1 })

/// The algorithm and cost `params` hashes with.
pub fn scheme_of(params: Params) -> Scheme =
  match params { WithArgon2id(cost) -> Argon2(Argon2id, cost), WithScrypt(cost) -> Scrypt(cost) }

/// The hash string of `password` under `params` and sixteen bytes of salt from `entropy`.
pub fn hash(
  password: Secret<String>,
  params: Params,
) -> String / {entropy.next, kdf.argon2, kdf.scrypt, abort.raise} =
  salted(Secret::bytes(password), params, token_bytes(generated_salt_length()))

/// Like `hash`, but uses the salt the caller supplies. Tests use it to get a fixed output, and so
/// does a migration from a store that has salts in a separate column. Raises `SaltLength` for a
/// salt outside 8 to 64 bytes.
pub fn hash_with_salt(
  secret: Secret<String>,
  params: Params,
  salt: Bytes,
) -> String / {password.fail, kdf.argon2, kdf.scrypt, abort.raise} =
  if salt.len() < 8 || salt.len() > bounds().salt { password.fail(SaltLength(salt.len())) }
  else { salted(secret.bytes(), params, salt) }

/// Returns whether `supplied` is the password that `stored` was hashed from, and whether `stored`
/// matches what `hash` writes under `params`.
///
/// The tag is computed with the costs written in `stored`, whatever `params` are, and compared with
/// `tags_match` from `std.hash`. A text that `read` rejects returns `Invalid` immediately, so a
/// caller who times the call can tell that the account has no readable hash. A caller who must hide
/// this should also verify a real hash in that case.
pub fn verify(
  stored: String,
  supplied: Secret<String>,
  params: Params,
) -> Verdict / {kdf.argon2, kdf.scrypt, kdf.bcrypt, kdf.pbkdf2, abort.raise} =
  match parse(stored) {
    Err(_) -> Invalid,
    Ok(stored_hash) -> {
      let tag = tag_of(
        stored_hash.scheme,
        supplied.bytes(),
        stored_hash.salt,
        stored_hash.tag.len(),
      );
      if !tags_match(tag, stored_hash.tag) { Invalid }
      else if matches_params(stored_hash, params) { Valid }
      else { ValidNeedsRehash }
    },
  }

/// Returns whether `stored` differs from what `hash` writes under `params`: another algorithm,
/// another cost, a salt that is not sixteen bytes, a tag that is not thirty-two bytes, or a text
/// that `read` cannot parse. Use it to find the hashes to upgrade across a table, without needing
/// the passwords. `verify` makes the same comparison.
pub fn needs_rehash(stored: String, params: Params) -> Bool / {abort.raise} =
  match parse(stored) { Ok(stored_hash) -> !matches_params(stored_hash, params), Err(_) -> true }

fn matches_params(stored_hash: StoredHash, params: Params) -> Bool =
  stored_hash.scheme == scheme_of(params) && stored_hash.salt.len() == generated_salt_length()
    && stored_hash.tag.len() == tag_bytes()

fn salted(
  password: Secret<Bytes>,
  params: Params,
  salt: Bytes,
) -> String / {kdf.argon2, kdf.scrypt, abort.raise} =
  match params {
    WithArgon2id(cost) ->
      format_hash({
        scheme: Argon2(Argon2id, cost),
        salt: salt,
        tag: argon2_tag(Argon2id, cost, password, salt, tag_bytes()),
      }),
    WithScrypt(cost) ->
      format_hash({
        scheme: Scrypt(cost),
        salt: salt,
        tag: scrypt_tag(cost, password, salt, tag_bytes()),
      }),
  }

fn tag_of(
  scheme: Scheme,
  password: Secret<Bytes>,
  salt: Bytes,
  length: Int,
) -> Bytes / {kdf.argon2, kdf.scrypt, kdf.bcrypt, kdf.pbkdf2} =
  match scheme {
    Argon2(variant, cost) -> argon2_tag(variant, cost, password, salt, length),
    Scrypt(cost) -> scrypt_tag(cost, password, salt, length),
    Bcrypt(cost) -> kdf.bcrypt(password, salt, cost),
    Pbkdf2(digest, iterations) ->
      kdf.pbkdf2(digest_name(digest), password, salt, iterations, length),
  }

fn argon2_tag(
  variant: Variant,
  cost: Argon2Cost,
  password: Secret<Bytes>,
  salt: Bytes,
  length: Int,
) -> Bytes / {kdf.argon2} =
  kdf.argon2(
    variant_name(variant),
    password,
    salt,
    Secret::of_bytes(b""),
    b"",
    cost.memory,
    cost.passes,
    cost.lanes,
    length,
  )

fn scrypt_tag(
  cost: ScryptCost,
  password: Secret<Bytes>,
  salt: Bytes,
  length: Int,
) -> Bytes / {kdf.scrypt} = kdf.scrypt(password, salt, cost.log_n, cost.r, cost.p, length)

fn check_bounds(scheme: Scheme, salt: Int, tag: Int) -> Unit / {password.fail} =
  match scheme {
    Argon2(_, cost) -> {
      check_argon2_cost(cost);
      check_lengths(salt, 8, tag)
    },
    Scrypt(cost) -> {
      check_scrypt_cost(cost);
      check_lengths(salt, 0, tag)
    },
    Bcrypt(cost) -> if cost < 4 || cost > bounds().bcrypt_cost { password.fail(BcryptCost(cost)) }
    else if salt != 16 { password.fail(SaltLength(salt)) }
    else if tag != 23 { password.fail(TagLength(tag)) }
    else { () },
    Pbkdf2(_, iterations) -> if iterations < 1 || iterations > bounds().iterations {
      password.fail(Iterations(iterations))
    } else { check_lengths(salt, 0, tag) },
  }

fn check_argon2_cost(cost: Argon2Cost) -> Unit / {password.fail} =
  if cost.lanes < 1 || cost.lanes > 255 { password.fail(Lanes(cost.lanes)) }
  else if cost.memory < 8 * cost.lanes || cost.memory > bounds().memory {
    password.fail(Memory(cost.memory))
  } else if cost.passes < 1 || product_exceeds(cost.memory, cost.passes, bounds().argon2_work) {
    password.fail(Passes(cost.passes))
  } else { () }

fn check_scrypt_cost(cost: ScryptCost) -> Unit / {password.fail} =
  if cost.log_n < 1 || cost.log_n > 62 || cost.r < 1 || cost.p < 1 {
    password.fail(ScryptWork(cost))
  } else {
    let costly = match checked_mul(1 << cost.log_n, cost.r) {
      Some(blocks) -> product_exceeds(blocks, cost.p, bounds().scrypt_work),
      None -> true,
    };
    if costly { password.fail(ScryptWork(cost)) } else { () }
  }

fn product_exceeds(a: Int, b: Int, most: Int) -> Bool =
  match checked_mul(a, b) { Some(product) -> product > most, None -> true }

fn check_lengths(salt: Int, least_salt: Int, tag: Int) -> Unit / {password.fail} =
  if salt < least_salt || salt > bounds().salt { password.fail(SaltLength(salt)) }
  else if tag < 4 || tag > bounds().tag { password.fail(TagLength(tag)) }
  else { () }

/// Returns the hash that `stored` contains. Raises `password.fail` when `stored` is not in any form
/// this module reads, or when the hash is past `bounds`.
pub fn read(stored: String) -> StoredHash / {password.fail, abort.raise} = {
  let size = Bytes::of_string(stored).len();
  if size > bounds().text { password.fail(TooLong(size)) }
  else if !stored.starts_with("$") { malformed() } else {
    let stored_hash = fields_read(stored.slice(1, stored.len()).split("$"));
    check_bounds(stored_hash.scheme, stored_hash.salt.len(), stored_hash.tag.len());
    stored_hash
  }
}

/// The hash `stored` contains, or why it is not a hash this module reads.
pub fn parse(stored: String) -> Result<StoredHash, Error> / {abort.raise} = try { read(stored) }

/// Returns the hash string for `stored`, in a form `read` parses back: Argon2 and scrypt in the PHC
/// form, bcrypt as `$2b$`, PBKDF2 as passlib writes it. Use it to convert a store that has an
/// algorithm's salt and tag in separate columns. Raises `password.fail` for a hash past `bounds`.
pub fn write(stored: StoredHash) -> String / {password.fail, abort.raise} = {
  check_bounds(stored.scheme, stored.salt.len(), stored.tag.len());
  format_hash(stored)
}

fn format_hash(stored_hash: StoredHash) -> String / {abort.raise} =
  match stored_hash.scheme {
    Argon2(variant, cost) ->
      "$" ++ variant_name(variant) ++ "$v=19$m=" ++ cost.memory.to_string() ++ ",t="
        ++ cost.passes.to_string()
        ++ ",p="
        ++ cost.lanes.to_string()
        ++ "$"
        ++ radix::encode(phc64(), stored_hash.salt)
        ++ "$"
        ++ radix::encode(phc64(), stored_hash.tag),
    Scrypt(cost) ->
      "$scrypt$ln=" ++ cost.log_n.to_string() ++ ",r=" ++ cost.r.to_string() ++ ",p="
        ++ cost.p.to_string()
        ++ "$"
        ++ radix::encode(phc64(), stored_hash.salt)
        ++ "$"
        ++ radix::encode(phc64(), stored_hash.tag),
    Bcrypt(cost) ->
      "$2b$" ++ cost.to_string().pad_left(2, "0") ++ "$"
        ++ radix::encode(crypt64(), stored_hash.salt)
        ++ radix::encode(crypt64(), stored_hash.tag),
    Pbkdf2(digest, iterations) ->
      "$" ++ digest_id(digest) ++ "$" ++ iterations.to_string() ++ "$"
        ++ radix::encode(phc64(), stored_hash.salt).replace("+", ".")
        ++ "$"
        ++ radix::encode(phc64(), stored_hash.tag).replace("+", "."),
  }

const fn phc64() -> Alphabet = radix::unpadded(radix::base64())

fn crypt_symbols() -> Bytes = b"./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

const fn crypt64() -> Alphabet =
  match radix::alphabet(crypt_symbols(), false) { Some(a) -> a, None -> radix::base64() }

fn malformed<a>() -> a / {password.fail} = password.fail(Malformed)

fn needed<a>(found: Option<a>) -> a / {password.fail} =
  match found { Some(x) -> x, None -> malformed() }

fn variant_name(v: Variant) -> String =
  match v { Argon2d -> "argon2d", Argon2i -> "argon2i", Argon2id -> "argon2id" }

fn variant_of(id: String) -> Option<Variant> =
  if id == "argon2id" { Some(Argon2id) }
  else if id == "argon2i" { Some(Argon2i) }
  else if id == "argon2d" { Some(Argon2d) }
  else { None }

fn digest_name(d: Digest) -> String =
  match d { Sha1 -> "SHA-1", Sha256 -> "SHA-256", Sha512 -> "SHA-512" }

fn digest_id(d: Digest) -> String =
  match d { Sha1 -> "pbkdf2", Sha256 -> "pbkdf2-sha256", Sha512 -> "pbkdf2-sha512" }

fn digest_of(id: String) -> Option<Digest> =
  if id == "pbkdf2-sha256" { Some(Sha256) }
  else if id == "pbkdf2-sha512" { Some(Sha512) }
  else if id == "pbkdf2" { Some(Sha1) }
  else { None }

fn is_bcrypt(id: String) -> Bool = id == "2a" || id == "2b" || id == "2y"

fn fields_read(fields: List<String>) -> StoredHash / {password.fail, abort.raise} =
  match fields {
    [id, version, costs, salt, tag] -> match variant_of(id) {
      Some(variant) -> {
        check_version(version);
        argon2_read(variant, costs, salt, tag)
      },
      None -> bad_first_field(id),
    },
    [id, costs, salt, tag] -> read_four_fields(id, costs, salt, tag),
    [id, cost, rest] -> if is_bcrypt(id) { bcrypt_read(cost, rest) } else { bad_first_field(id) },
    [id, _] -> bad_first_field(id),
    [id] -> bad_first_field(id),
    _ -> malformed(),
  }

fn bad_first_field<a>(id: String) -> a / {password.fail} =
  if variant_of(id) != None || digest_of(id) != None || is_bcrypt(id) || id == "scrypt" {
    malformed()
  } else { password.fail(Unknown(id)) }

fn read_four_fields(
  id: String,
  costs: String,
  salt: String,
  tag: String,
) -> StoredHash / {password.fail, abort.raise} =
  if id == "scrypt" {
    match numbers(costs, ["ln", "r", "p"]) {
      [log_n, r, p] ->
        {
          scheme: Scrypt({ log_n: log_n, r: r, p: p }),
          salt: decode_unpadded_base64(salt),
          tag: decode_unpadded_base64(tag),
        },
      _ -> malformed(),
    }
  } else {
    match digest_of(id) {
      Some(digest) -> pbkdf2_read(digest, costs, salt, tag),
      None -> if variant_of(id) != None { password.fail(Version(16)) } else { bad_first_field(id) },
    }
  }

fn check_version(field: String) -> Unit / {password.fail, abort.raise} = {
  let version = named_number(field, "v");
  if version == 19 { () } else { password.fail(Version(version)) }
}

fn argon2_read(
  variant: Variant,
  costs: String,
  salt: String,
  tag: String,
) -> StoredHash / {password.fail, abort.raise} =
  match numbers(costs, ["m", "t", "p"]) {
    [memory, passes, lanes] ->
      {
        scheme: Argon2(variant, { memory: memory, passes: passes, lanes: lanes }),
        salt: decode_unpadded_base64(salt),
        tag: decode_unpadded_base64(tag),
      },
    _ -> malformed(),
  }

fn pbkdf2_read(
  digest: Digest,
  costs: String,
  salt: String,
  tag: String,
) -> StoredHash / {password.fail, abort.raise} = {
  let key = decode_unpadded_base64(tag.replace(".", "+"));
  let iterations = if !costs.contains("=") { number(costs) } else {
    match costs.split(",") {
      [count] -> named_number(count, "i"),
      [count, length] -> if named_number(length, "l") == key.len() { named_number(count, "i") }
      else { malformed() },
      _ -> malformed(),
    }
  };
  {
    scheme: Pbkdf2(digest, iterations),
    salt: decode_unpadded_base64(salt.replace(".", "+")),
    tag: key,
  }
}

fn bcrypt_read(cost: String, rest: String) -> StoredHash / {password.fail, abort.raise} = {
  let digits = Bytes::of_string(cost);
  let symbols = Bytes::of_string(rest);
  if digits.len() != 2 || symbols.len() != 53 { malformed() } else {
    {
      scheme: Bcrypt(needed(digits_read(digits))),
      salt: decode_crypt64(symbols.slice(0, 22), 4),
      tag: decode_crypt64(symbols.slice(22, 53), 2),
    }
  }
}

fn decode_crypt64(symbols: Bytes, spare: Int) -> Bytes / {password.fail, abort.raise} = {
  let last = symbols.len() - 1;
  let value = needed(crypt_symbols().index_of_byte(symbols.at(last)));
  let masked_value = value >>> spare << spare;
  needed(
    radix::decode(
      crypt64(),
      String::of_bytes(
        symbols.slice(0, last).concat(crypt_symbols().slice(masked_value, masked_value + 1)),
      ),
    ),
  )
}

fn decode_unpadded_base64(text: String) -> Bytes / {password.fail, abort.raise} =
  needed(radix::decode(phc64(), text))

fn numbers(text: String, names: List<String>) -> List<Int> / {password.fail, abort.raise} = {
  let parts = text.split(",");
  if parts.len() != names.len() { malformed() } else {
    range(0, names.len()).map(|i: Int|
      match ((parts.at(i), names.at(i))) {
        (Some(part), Some(name)) -> named_number(part, name),
        _ -> malformed(),
      })
  }
}

fn named_number(part: String, name: String) -> Int / {password.fail, abort.raise} =
  if !part.starts_with(name ++ "=") { malformed() }
  else { number(part.slice(name.len() + 1, part.len())) }

fn number(text: String) -> Int / {password.fail, abort.raise} = {
  let digits = Bytes::of_string(text);
  if digits.len() > 10 || (digits.len() > 1 && digits.at(0) == b'0') { malformed() }
  else { needed(digits_read(digits)) }
}

fn digits_read(digits: Bytes) -> Option<Int> / {abort.raise} =
  if digits.scan(0, b"0123456789", digits.len()) < digits.len() { None }
  else { digits.int_of_ascii() }

host for kdf by served

fn served<a | e>(go: () -> a / {kdf.read | e}) -> a / {native.read, wait.read | e} =
  handle {
    go()
  } with {
    kdf.argon2(variant, password, salt, key, data, memory, passes, lanes, length) ->
      job_wait(kdf_argon2(variant, password, salt, key, data, memory, passes, lanes, length)),
    kdf.scrypt(password, salt, log_n, r, p, length) ->
      job_wait(kdf_scrypt(password, salt, log_n, r, p, length)),
    kdf.bcrypt(password, salt, cost) -> job_wait(kdf_bcrypt(password, salt, cost)),
    kdf.pbkdf2(name, password, salt, iterations, length) ->
      job_wait(kdf_pbkdf2(name, password, salt, iterations, length)),
  }

extern fn kdf_argon2(
  variant: String,
  password: Secret<Bytes>,
  salt: Bytes,
  key: Secret<Bytes>,
  data: Bytes,
  memory: Int,
  passes: Int,
  lanes: Int,
  length: Int,
) -> Int / {native.read}

extern fn kdf_scrypt(
  password: Secret<Bytes>,
  salt: Bytes,
  log_n: Int,
  r: Int,
  p: Int,
  length: Int,
) -> Int / {native.read}

extern fn kdf_bcrypt(password: Secret<Bytes>, salt: Bytes, cost: Int) -> Int / {native.read}

extern fn kdf_pbkdf2(
  hash: String,
  password: Secret<Bytes>,
  salt: Bytes,
  iterations: Int,
  length: Int,
) -> Int / {native.read}

/// Runs `body`, handling every operation of `kdf` with a fake: an HMAC, under the password, of the
/// operation's arguments. It is instant where a real hash is slow, and it protects nothing, so it
/// is only for tests: a sign-up, a login and a rehash run under it at no cost. Its tags match no
/// real algorithm, so a hash made under it verifies only under it.
pub fn fake_kdf<a | e>(
  body: () -> a / {kdf.argon2, kdf.scrypt, kdf.bcrypt, kdf.pbkdf2 | e},
) -> a / {abort.raise | e} =
  handle {
    body()
  } with {
    kdf.argon2(variant, password, salt, key, data, memory, passes, lanes, length) ->
      fake_tag(
        Secret::concat(password, key),
        [
          b"argon2",
          Bytes::of_string(variant),
          salt,
          u32_be(key.len()),
          data,
          u32_be(memory),
          u32_be(passes),
          u32_be(lanes),
        ],
        length,
      ),
    kdf.scrypt(password, salt, log_n, r, p, length) ->
      fake_tag(password, [b"scrypt", salt, u32_be(log_n), u32_be(r), u32_be(p)], length),
    kdf.bcrypt(password, salt, cost) -> fake_tag(password, [b"bcrypt", salt, u32_be(cost)], 23),
    kdf.pbkdf2(name, password, salt, iterations, length) ->
      fake_tag(password, [b"pbkdf2", Bytes::of_string(name), salt, u32_be(iterations)], length),
  }

fn fake_tag(
  password: Secret<Bytes>,
  hashed_inputs: List<Bytes>,
  length: Int,
) -> Bytes / {abort.raise} = {
  let message = Bytes::concat_all(hashed_inputs.map(|part: Bytes| u32_be(part.len()).concat(part)));
  let wide = hmac_sha256(password, message.concat(b"\x00")).concat(
    hmac_sha256(password, message.concat(b"\x01")),
  );
  wide.slice(0, min(max(length, 0), wide.len()))
}

fn arbitrary_params() -> Gen<Params> =
  gen::one_of([
    gen::map(arbitrary_argon2(), |cost: Argon2Cost| WithArgon2id(cost)),
    gen::map(arbitrary_scrypt(), |cost: ScryptCost| WithScrypt(cost)),
  ])

fn arbitrary_argon2() -> Gen<Argon2Cost> =
  gen::and_then(gen::int_between(1, 255), |lanes: Int|
    gen::and_then(
      gen::one_of([gen::int_between(8 * lanes, 1 << 16), gen::constant(1 << 21)]),
      |memory: Int|
        gen::map(gen::int_between(1, min(64, (1 << 22) / memory)), |passes: Int|
          { memory: memory, passes: passes, lanes: lanes }),
    ))

fn arbitrary_scrypt() -> Gen<ScryptCost> =
  gen::and_then(gen::int_between(1, 20), |log_n: Int|
    gen::and_then(gen::int_between(1, min(16, 1 << 23 - log_n)), |r: Int|
      gen::map(gen::int_between(1, min(16, (1 << 23 - log_n) / r)), |p: Int|
        { log_n: log_n, r: r, p: p })))

fn arbitrary_stored() -> Gen<StoredHash> =
  gen::one_of([
    sized_stored(
      gen::map2(
        gen::elements([Argon2d, Argon2i, Argon2id]),
        arbitrary_argon2(),
        |v: Variant, cost: Argon2Cost| Argon2(v, cost),
      ),
      8,
    ),
    sized_stored(gen::map(arbitrary_scrypt(), |cost: ScryptCost| Scrypt(cost)), 0),
    gen::and_then(gen::int_between(4, 16), |cost: Int|
      gen::map2(gen::bytes_of(16), gen::bytes_of(23), |salt: Bytes, tag: Bytes|
        { scheme: Bcrypt(cost), salt: salt, tag: tag })),
    sized_stored(
      gen::map2(
        gen::elements([Sha1, Sha256, Sha512]),
        gen::int_between(1, 10000000),
        |d: Digest, n: Int| Pbkdf2(d, n),
      ),
      0,
    ),
  ])

fn sized_stored(schemes: Gen<Scheme>, least_salt: Int) -> Gen<StoredHash> =
  gen::and_then(schemes, |scheme: Scheme|
    gen::and_then(gen::int_between(least_salt, 64), |salt: Int|
      gen::and_then(gen::int_between(4, 64), |tag: Int|
        gen::map2(gen::bytes_of(salt), gen::bytes_of(tag), |s: Bytes, t: Bytes|
          { scheme: scheme, salt: s, tag: t }))))

fn hashed(password: String, params: Params, root: Int) -> String / {abort.raise} =
  fake_kdf(|| with_rand(rand(root), || hash(Secret::of_string(password), params)).value)

fn verified(stored: String, supplied: String, params: Params) -> Verdict / {abort.raise} =
  fake_kdf(|| verify(stored, Secret::of_string(supplied), params))

fn fake_hash_text(
  scheme: Scheme,
  password: String,
  salt: Bytes,
  length: Int,
) -> String / {abort.raise} =
  format_hash({
    scheme: scheme,
    salt: salt,
    tag: fake_kdf(|| tag_of(scheme, Secret::of_string(password).bytes(), salt, length)),
  })

fn count_kdf_calls<a>(
  body: () -> a / {kdf.argon2, kdf.scrypt, kdf.bcrypt, kdf.pbkdf2, abort.raise},
) -> Int / {abort.raise} =
  handle {
    body()
  } with {
    var performs = 0,
    kdf.argon2(_, _, _, _, _, _, _, _, _) -> {
      performs = performs + 1;
      b""
    },
    kdf.scrypt(_, _, _, _, _, _) -> {
      performs = performs + 1;
      b""
    },
    kdf.bcrypt(_, _, _) -> {
      performs = performs + 1;
      b""
    },
    kdf.pbkdf2(_, _, _, _, _) -> {
      performs = performs + 1;
      b""
    },
    return _result -> performs,
  }

fn argon2_text(costs: String, salt: Int, tag: Int) -> String / {abort.raise} =
  "$argon2id$v=19$" ++ costs ++ "$" ++ radix::encode(phc64(), zeros(salt)) ++ "$"
    ++ radix::encode(phc64(), zeros(tag))

fn zeros(n: Int) -> Bytes = Bytes::concat_all(range(0, n).map(|_: Int| b"\x00"))

test "a hash is a PHC string of its algorithm, its costs, its salt and its tag" {
  let secret = Secret::of_string("correct horse");
  let salt = b"0123456789abcdef";
  let argon = try { fake_kdf(|| hash_with_salt(secret, owasp_argon2id(), salt)) };
  let scrypted = try { fake_kdf(|| hash_with_salt(secret, owasp_scrypt(), salt)) };
  let tag = |scheme: Scheme|
    radix::encode(phc64(), fake_kdf(|| tag_of(scheme, secret.bytes(), salt, 32)));
  assert_eq(
    argon,
    Ok(
      "$argon2id$v=19$m=19456,t=2,p=1$MDEyMzQ1Njc4OWFiY2RlZg$" ++ tag(scheme_of(owasp_argon2id())),
    ),
  );
  assert_eq(
    scrypted,
    Ok("$scrypt$ln=17,r=8,p=1$MDEyMzQ1Njc4OWFiY2RlZg$" ++ tag(scheme_of(owasp_scrypt()))),
  );
  assert_eq(tag(scheme_of(owasp_scrypt())).len(), 43);
  assert_eq(
    try { fake_kdf(|| hash_with_salt(secret, owasp_argon2id(), b"7 bytes")) },
    Err(SaltLength(7)),
  );
  assert_eq(
    try { fake_kdf(|| hash_with_salt(secret, owasp_argon2id(), zeros(65))) },
    Err(SaltLength(65)),
  )
}

test "a hash draws sixteen bytes of salt, so two hashes of one password differ" {
  let first = hashed("correct horse", owasp_argon2id(), 1);
  let second = hashed("correct horse", owasp_argon2id(), 2);
  assert(first != second);
  assert_eq(hashed("correct horse", owasp_argon2id(), 1), first);
  assert_eq([first, second].map(|text: String| salt_length(parse(text))), [Some(16), Some(16)])
}

fn salt_length(read: Result<StoredHash, Error>) -> Option<Int> =
  match read { Ok(stored_hash) -> Some(stored_hash.salt.len()), Err(_) -> None }

test "`verified` returns `Valid` for the correct password and `Invalid` for any other, including empty and padded variants" {
  let stored = hashed("correct horse", owasp_argon2id(), 7);
  assert_eq(verified(stored, "correct horse", owasp_argon2id()), Valid);
  assert_eq(verified(stored, "correct horsf", owasp_argon2id()), Invalid);
  assert_eq(verified(stored, "", owasp_argon2id()), Invalid);
  assert_eq(verified(stored, "correct horse ", owasp_argon2id()), Invalid);
  let scrypted = hashed("", owasp_scrypt(), 7);
  assert_eq(verified(scrypted, "", owasp_scrypt()), Valid);
  assert_eq(verified(scrypted, " ", owasp_scrypt()), Invalid)
}

test "a correct password returns `ValidNeedsRehash`, and `needs_rehash` is true, when the hash was made with different params" {
  let stored = hashed("correct horse", owasp_argon2id(), 7);
  assert_eq(verified(stored, "correct horse", owasp_argon2id_46mib()), ValidNeedsRehash);
  assert_eq(verified(stored, "correct horse", owasp_scrypt()), ValidNeedsRehash);
  assert_eq(verified(stored, "wrong", owasp_scrypt()), Invalid);
  assert_eq(needs_rehash(stored, owasp_argon2id()), false);
  assert_eq(needs_rehash(stored, owasp_argon2id_46mib()), true);
  assert_eq(needs_rehash(stored, owasp_scrypt()), true);
  assert_eq(needs_rehash("not a hash", owasp_argon2id()), true);
  assert_eq(count_kdf_calls(|| needs_rehash(stored, owasp_scrypt())), 0)
}

type Legacy = { name: String, scheme: Scheme, salt: Int, tag: Int }

fn legacies() -> List<Legacy> =
  [
    {
      name: "Argon2i",
      scheme: Argon2(Argon2i, { memory: 19456, passes: 2, lanes: 1 }),
      salt: 16,
      tag: 32,
    },
    {
      name: "Argon2d",
      scheme: Argon2(Argon2d, { memory: 19456, passes: 2, lanes: 1 }),
      salt: 16,
      tag: 32,
    },
    {
      name: "Argon2id under eight bytes of salt",
      scheme: scheme_of(owasp_argon2id()),
      salt: 8,
      tag: 32,
    },
    {
      name: "Argon2id with sixteen bytes of tag",
      scheme: scheme_of(owasp_argon2id()),
      salt: 16,
      tag: 16,
    },
    {
      name: "scrypt at a lower cost",
      scheme: Scrypt({ log_n: 14, r: 8, p: 1 }),
      salt: 16,
      tag: 32,
    },
    { name: "bcrypt", scheme: Bcrypt(12), salt: 16, tag: 23 },
    { name: "PBKDF2 under SHA-256", scheme: Pbkdf2(Sha256, 600000), salt: 16, tag: 32 },
    { name: "PBKDF2 under SHA-512", scheme: Pbkdf2(Sha512, 220000), salt: 16, tag: 64 },
    { name: "PBKDF2 under SHA-1", scheme: Pbkdf2(Sha1, 1400000), salt: 12, tag: 20 },
  ]

test "a stored {c.name} hash verifies the correct password but needs rehashing, and rejects a wrong password" for c: Legacy in legacies(
  ) {
  let stored = fake_hash_text(c.scheme, "correct horse", zeros(c.salt), c.tag);
  assert_eq(verified(stored, "correct horse", owasp_argon2id()), ValidNeedsRehash);
  assert_eq(verified(stored, "correct horsf", owasp_argon2id()), Invalid);
  assert_eq(needs_rehash(stored, owasp_argon2id()), true);
  assert_eq(count_kdf_calls(|| verify(stored, Secret::of_string("any"), owasp_argon2id())), 1)
}

type Foreign = { name: String, text: String, scheme: Scheme, salt: String, tag: String }

fn foreign() -> List<Foreign> =
  [
    {
      name: "the reference implementation's Argon2id",
      text: "$argon2id$v=19$m=65536,t=2,p=1$c29tZXNhbHQ$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc",
      scheme: Argon2(Argon2id, { memory: 65536, passes: 2, lanes: 1 }),
      salt: "736f6d6573616c74",
      tag: "09316115d5cf24ed5a15a31a3ba326e5cf32edc24702987c02b6566f61913cf7",
    },
    {
      name: "the reference implementation's Argon2i",
      text: "$argon2i$v=19$m=65536,t=2,p=1$c29tZXNhbHQ$wWKIMhR9lyDFvRz9YTZweHKfbftvj+qf+YFY4NeBbtA",
      scheme: Argon2(Argon2i, { memory: 65536, passes: 2, lanes: 1 }),
      salt: "736f6d6573616c74",
      tag: "c1628832147d9720c5bd1cfd61367078729f6dfb6f8fea9ff98158e0d7816ed0",
    },
    {
      name: "jBCrypt's empty password",
      text: "$2a$06$DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s.",
      scheme: Bcrypt(6),
      salt: "144b3d691a7b4ecf39cf735c7fa7a79c",
      tag: "557e94f34bf286e8719a26be94ac1e16d95ef9f819dee0",
    },
    {
      name: "jBCrypt's alphabet",
      text: "$2a$08$aTsUwsyowQuzRrDqFflhgekJ8d9/7Z3GV3UcgvzQW3J5zMyrTvlz.",
      scheme: Bcrypt(8),
      salt: "715b96caed2ac92c354ed16c1e19e38a",
      tag: "98bf9ffc1f5be485f959e8b1d526392fbd4ed2d5719f50",
    },
  ]

test "`parse` of a {c.name} hash text returns its scheme, salt and tag" for c: Foreign in foreign(
  ) {
  match parse(c.text) {
    Ok(stored_hash) -> {
      assert_eq(stored_hash.scheme, c.scheme);
      assert_eq(stored_hash.salt.hex_of(), c.salt);
      assert_eq(stored_hash.tag.hex_of(), c.tag)
    },
    Err(reason) -> assert(false, Some(show(reason))),
  }
}

test "bcrypt hashes with the `$2a`, `$2b` and `$2y` prefixes parse to the same hash, which is formatted with `$2b`" {
  let rest = "$06$DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s.";
  let read = ["$2a", "$2b", "$2y"].map(|prefix: String| parse(prefix ++ rest));
  assert_eq(read.at(0), read.at(1));
  assert_eq(read.at(1), read.at(2));
  assert_eq(
    match read.at(0) { Some(Ok(stored_hash)) -> Some(format_hash(stored_hash)), _ -> None },
    Some("$2b" ++ rest),
  );
  assert_eq(parse("$2x" ++ rest), Err(Unknown("2x")))
}

test "the unused bits in the last symbol of a bcrypt salt or tag are ignored" {
  let clean = parse("$2b$06$DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s.");
  assert(clean.ok() != None);
  assert_eq(parse("$2b$06$DCq7YPn5Rq63x1Lad4cll/TV4S6ytwfsfvkgY8jIucDrjc8deX1s."), clean);
  assert_eq(parse("$2b$06$DCq7YPn5Rq63x1Lad4cllMTV4S6ytwfsfvkgY8jIucDrjc8deX1s."), clean);
  assert_eq(parse("$2b$06$DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s/"), clean);
  assert(parse("$2b$06$DCq7YPn5Rq63x1Lad4cllOTV4S6ytwfsfvkgY8jIucDrjc8deX1s.") != clean)
}

test "PBKDF2 hashes parse from passlib and PHC formats, and `format_hash` writes them in passlib format" {
  let stored_hash: StoredHash = {
    scheme: Pbkdf2(Sha256, 29000),
    salt: b"\xfb\xef\xbe\x00sixteen bytes",
    tag: b"\xfb\xef\xbe".concat(zeros(29)),
  };
  let salt = "++++AHNpeHRlZW4gYnl0ZXM";
  let tag = "++++" ++ "A".repeat(39);
  let dotted = |text: String| text.replace("+", ".");
  let passlib = "$pbkdf2-sha256$29000$" ++ dotted(salt) ++ "$" ++ dotted(tag);
  assert_eq(format_hash(stored_hash), passlib);
  assert_eq(parse(passlib), Ok(stored_hash));
  assert_eq(parse("$pbkdf2-sha256$i=29000$" ++ salt ++ "$" ++ tag), Ok(stored_hash));
  assert_eq(parse("$pbkdf2-sha256$i=29000,l=32$" ++ salt ++ "$" ++ tag), Ok(stored_hash));
  assert_eq(parse("$pbkdf2-sha256$i=29000,l=31$" ++ salt ++ "$" ++ tag), Err(Malformed));
  assert_eq(parse("$pbkdf2-sha256$l=32,i=29000$" ++ salt ++ "$" ++ tag), Err(Malformed));
  assert_eq(
    ["pbkdf2", "pbkdf2-sha512"].map(|id: String|
      match parse("$" ++ id ++ "$29000$" ++ dotted(salt) ++ "$" ++ dotted(tag)) {
        Ok(read) -> Some(read.scheme),
        Err(_) -> None,
      }),
    [Some(Pbkdf2(Sha1, 29000)), Some(Pbkdf2(Sha512, 29000))],
  )
}

type Rejected = { name: String, text: String, reason: Error }

fn bcrypt_rest() -> String = "DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s."

fn rejected_texts() -> List<Rejected> / {abort.raise} =
  [
    { name: "nothing", text: "", reason: Malformed },
    { name: "a password in the clear", text: "correct horse", reason: Malformed },
    { name: "a bare `$`", text: "$", reason: Unknown("") },
    { name: "an algorithm alone", text: "$argon2id", reason: Malformed },
    { name: "SHA-crypt", text: "$5$rounds=5000$salt$hash", reason: Unknown("5") },
    { name: "yescrypt", text: "$y$j9T$salt$hash", reason: Unknown("y") },
    { name: "scrypt's `$7$`", text: "$7$C6..../....salt$hash", reason: Unknown("7") },
    {
      name: "PBKDF2 under a hash not read",
      text: "$pbkdf2-md5$1000$c2FsdA$AAAAAA",
      reason: Unknown("pbkdf2-md5"),
    },
    {
      name: "Argon2 with no version",
      text: "$argon2id$m=64,t=1,p=1$AAAAAAAAAAA$AAAAAA",
      reason: Version(16),
    },
    {
      name: "Argon2 version 16",
      text: "$argon2id$v=16$m=64,t=1,p=1$AAAAAAAAAAA$AAAAAA",
      reason: Version(16),
    },
    {
      name: "an Argon2 version not yet made",
      text: "$argon2id$v=20$m=64,t=1,p=1$AAAAAAAAAAA$AAAAAA",
      reason: Version(20),
    },
    {
      name: "Argon2 with no number for its version",
      text: "$argon2id$v=$m=64,t=1,p=1$AAAAAAAAAAA$AAAAAA",
      reason: Malformed,
    },
    {
      name: "Argon2's costs out of order",
      text: argon2_text("t=1,m=64,p=1", 8, 32),
      reason: Malformed,
    },
    {
      name: "a cost with a zero ahead of it",
      text: argon2_text("m=064,t=1,p=1", 8, 32),
      reason: Malformed,
    },
    { name: "a cost with a sign", text: argon2_text("m=+64,t=1,p=1", 8, 32), reason: Malformed },
    {
      name: "a cost of eleven digits",
      text: argon2_text("m=10000000000,t=1,p=1", 8, 32),
      reason: Malformed,
    },
    { name: "a cost left out", text: argon2_text("m=64,t=1", 8, 32), reason: Malformed },
    {
      name: "Argon2 with a key identifier",
      text: argon2_text("m=64,t=1,p=1,keyid=AAAA", 8, 32),
      reason: Malformed,
    },
    {
      name: "a field too many",
      text: argon2_text("m=64,t=1,p=1", 8, 32) ++ "$",
      reason: Malformed,
    },
    {
      name: "four gigabytes of memory",
      text: argon2_text("m=4194304,t=1,p=1", 16, 32),
      reason: Memory(4194304),
    },
    {
      name: "a kibibyte past two gigabytes",
      text: argon2_text("m=2097153,t=1,p=1", 16, 32),
      reason: Memory(2097153),
    },
    {
      name: "memory under eight kibibytes a lane",
      text: argon2_text("m=31,t=1,p=4", 16, 32),
      reason: Memory(31),
    },
    {
      name: "three passes over two gigabytes",
      text: argon2_text("m=2097152,t=3,p=1", 16, 32),
      reason: Passes(3),
    },
    {
      name: "five passes over a gigabyte",
      text: argon2_text("m=1048576,t=5,p=1", 16, 32),
      reason: Passes(5),
    },
    {
      name: "four billion passes",
      text: argon2_text("m=64,t=4294967295,p=1", 16, 32),
      reason: Passes(4294967295),
    },
    { name: "no passes", text: argon2_text("m=64,t=0,p=1", 16, 32), reason: Passes(0) },
    { name: "no lanes", text: argon2_text("m=64,t=1,p=0", 16, 32), reason: Lanes(0) },
    {
      name: "more lanes than a string names",
      text: argon2_text("m=4096,t=1,p=256", 16, 32),
      reason: Lanes(256),
    },
    {
      name: "Argon2 under seven bytes of salt",
      text: argon2_text("m=64,t=1,p=1", 7, 32),
      reason: SaltLength(7),
    },
    {
      name: "a salt of sixty-five bytes",
      text: argon2_text("m=64,t=1,p=1", 65, 32),
      reason: SaltLength(65),
    },
    {
      name: "a tag of three bytes",
      text: argon2_text("m=64,t=1,p=1", 16, 3),
      reason: TagLength(3),
    },
    {
      name: "a tag of sixty-five bytes",
      text: argon2_text("m=64,t=1,p=1", 16, 65),
      reason: TagLength(65),
    },
    {
      name: "a salt with bits past its last byte",
      text: "$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHR$AAAAAA",
      reason: Malformed,
    },
    {
      name: "a padded salt",
      text: "$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ=$AAAAAA",
      reason: Malformed,
    },
    {
      name: "scrypt past a gigabyte",
      text: "$scrypt$ln=21,r=8,p=1$c2FsdA$AAAAAA",
      reason: ScryptWork({ log_n: 21, r: 8, p: 1 }),
    },
    {
      name: "scrypt mixed twice over a gigabyte",
      text: "$scrypt$ln=20,r=8,p=2$c2FsdA$AAAAAA",
      reason: ScryptWork({ log_n: 20, r: 8, p: 2 }),
    },
    {
      name: "scrypt of one block",
      text: "$scrypt$ln=0,r=8,p=1$c2FsdA$AAAAAA",
      reason: ScryptWork({ log_n: 0, r: 8, p: 1 }),
    },
    {
      name: "scrypt of `2^4000000000` blocks",
      text: "$scrypt$ln=4000000000,r=1,p=1$c2FsdA$AAAAAA",
      reason: ScryptWork({ log_n: 4000000000, r: 1, p: 1 }),
    },
    {
      name: "scrypt whose costs overflow",
      text: "$scrypt$ln=62,r=4294967295,p=4294967295$c2FsdA$AAAAAA",
      reason: ScryptWork({ log_n: 62, r: 4294967295, p: 4294967295 }),
    },
    {
      name: "scrypt with `N` written out",
      text: "$scrypt$n=16384,r=8,p=1$c2FsdA$AAAAAA",
      reason: Malformed,
    },
    { name: "bcrypt at cost 17", text: "$2b$17$" ++ bcrypt_rest(), reason: BcryptCost(17) },
    { name: "bcrypt at cost 31", text: "$2b$31$" ++ bcrypt_rest(), reason: BcryptCost(31) },
    { name: "bcrypt at cost 3", text: "$2b$03$" ++ bcrypt_rest(), reason: BcryptCost(3) },
    { name: "bcrypt with a cost of one digit", text: "$2b$6$" ++ bcrypt_rest(), reason: Malformed },
    {
      name: "bcrypt with a cost of no digits",
      text: "$2b$1x$" ++ bcrypt_rest(),
      reason: Malformed,
    },
    {
      name: "bcrypt a symbol short",
      text: "$2b$06$" ++ bcrypt_rest().slice(0, 52),
      reason: Malformed,
    },
    {
      name: "bcrypt with a symbol of another alphabet",
      text: "$2b$06$+" ++ bcrypt_rest().slice(1, 53),
      reason: Malformed,
    },
    {
      name: "PBKDF2 past ten million iterations",
      text: "$pbkdf2-sha256$10000001$c2FsdA$AAAAAA",
      reason: Iterations(10000001),
    },
    {
      name: "PBKDF2 of no iterations",
      text: "$pbkdf2-sha256$0$c2FsdA$AAAAAA",
      reason: Iterations(0),
    },
    { name: "PBKDF2 with no count", text: "$pbkdf2-sha256$$c2FsdA$AAAAAA", reason: Malformed },
    { name: "a text past any hash string", text: "$" ++ "a".repeat(512), reason: TooLong(513) },
  ]

test "`parse` fails on {c.name} text with the expected reason, and `verify` rejects it without computing a hash" for c: Rejected in rejected_texts(
  ) {
  assert_eq(parse(c.text), Err(c.reason));
  assert_eq(needs_rehash(c.text, owasp_argon2id()), true);
  let kdf_calls = count_kdf_calls(||
    assert_eq(verify(c.text, Secret::of_string("correct horse"), owasp_argon2id()), Invalid));
  assert_eq(kdf_calls, 0)
}

test "a hash with params at the minimum or maximum limit parses, and verifying it computes exactly one hash" {
  let at_bounds = [
    argon2_text("m=2097152,t=2,p=4", 16, 32),
    argon2_text("m=1048576,t=4,p=1", 16, 32),
    argon2_text("m=2040,t=2056,p=255", 64, 64),
    argon2_text("m=8,t=524288,p=1", 8, 4),
    "$scrypt$ln=20,r=8,p=1$$AAAAAA",
    "$scrypt$ln=1,r=1,p=4194304$c2FsdA$AAAAAA",
    "$2b$16$" ++ bcrypt_rest(),
    "$2b$04$" ++ bcrypt_rest(),
    "$pbkdf2-sha256$10000000$$AAAAAA",
  ];
  at_bounds.fold((), |_: Unit, text: String| {
    assert(parse(text).ok() != None, Some(text));
    assert_eq(count_kdf_calls(|| verify(text, Secret::of_string("any"), owasp_argon2id())), 1)
  })
}

test "the params constructors accept values within the limits and return an error for values beyond them" {
  assert_eq(try { argon2id(19456, 2, 1) }, Ok(owasp_argon2id()));
  assert_eq(try { argon2id(47104, 1, 1) }, Ok(owasp_argon2id_46mib()));
  assert_eq(try { scrypt(17, 8, 1) }, Ok(owasp_scrypt()));
  assert(Result::ok(try { argon2id(bounds().memory, 2, 4) }) != None);
  assert(Result::ok(try { scrypt(20, 8, 1) }) != None);
  assert_eq(try { argon2id(bounds().memory + 1, 1, 1) }, Err(Memory(bounds().memory + 1)));
  assert_eq(try { argon2id(bounds().memory, 3, 1) }, Err(Passes(3)));
  assert_eq(try { argon2id(7, 1, 1) }, Err(Memory(7)));
  assert_eq(try { argon2id(64, 1, 0) }, Err(Lanes(0)));
  assert_eq(try { scrypt(21, 8, 1) }, Err(ScryptWork({ log_n: 21, r: 8, p: 1 })));
  assert_eq(try { scrypt(14, 0, 1) }, Err(ScryptWork({ log_n: 14, r: 0, p: 1 })));
  assert_eq(scheme_of(owasp_argon2id()), Argon2(Argon2id, { memory: 19456, passes: 2, lanes: 1 }));
  assert_eq(scheme_of(owasp_scrypt()), Scrypt({ log_n: 17, r: 8, p: 1 }))
}

test "a hash to write is checked against the same bounds as a hash read" {
  let salt = zeros(16);
  assert_eq(
    try { write({ scheme: Bcrypt(12), salt: salt, tag: zeros(23) }) },
    Ok("$2b$12$" ++ ".".repeat(53)),
  );
  assert_eq(
    try { write({ scheme: Bcrypt(12), salt: zeros(15), tag: zeros(23) }) },
    Err(SaltLength(15)),
  );
  assert_eq(try { write({ scheme: Bcrypt(12), salt: salt, tag: zeros(24) }) }, Err(TagLength(24)));
  assert_eq(try { write({ scheme: Bcrypt(17), salt: salt, tag: zeros(23) }) }, Err(BcryptCost(17)));
  assert_eq(
    try { write({ scheme: Pbkdf2(Sha256, 0), salt: salt, tag: zeros(32) }) },
    Err(Iterations(0)),
  );
  assert_eq(
    try { write({ scheme: scheme_of(owasp_argon2id()), salt: zeros(7), tag: zeros(32) }) },
    Err(SaltLength(7)),
  )
}

test "the stand-in key derivation function used in tests returns output of the requested length that differs when any argument differs" {
  let secret = Secret::of_bytes(b"correct horse");
  let empty = Secret::of_bytes(b"");
  let argon = |variant: String, password: Secret<Bytes>, salt: Bytes, key: Secret<Bytes>, data: Bytes, memory: Int, passes: Int, lanes: Int|
    fake_kdf(|| kdf.argon2(variant, password, salt, key, data, memory, passes, lanes, 32));
  let base = argon("argon2id", secret, b"saltsalt", empty, b"", 64, 1, 1);
  assert_eq(argon("argon2id", secret, b"saltsalt", empty, b"", 64, 1, 1), base);
  assert_eq(base.len(), 32);
  let others = [
    argon("argon2i", secret, b"saltsalt", empty, b"", 64, 1, 1),
    argon("argon2id", Secret::of_bytes(b"correct horsf"), b"saltsalt", empty, b"", 64, 1, 1),
    argon("argon2id", secret, b"saltsalu", empty, b"", 64, 1, 1),
    argon("argon2id", secret, b"saltsalt", Secret::of_bytes(b"k"), b"", 64, 1, 1),
    argon("argon2id", secret, b"saltsalt", empty, b"d", 64, 1, 1),
    argon("argon2id", secret, b"saltsalt", empty, b"", 65, 1, 1),
    argon("argon2id", secret, b"saltsalt", empty, b"", 64, 2, 1),
    argon("argon2id", secret, b"saltsalt", empty, b"", 64, 1, 2),
    fake_kdf(|| kdf.scrypt(secret, b"saltsalt", 14, 8, 1, 32)),
    fake_kdf(|| kdf.scrypt(secret, b"saltsalt", 15, 8, 1, 32)),
    fake_kdf(|| kdf.pbkdf2("SHA-256", secret, b"saltsalt", 1000, 32)),
    fake_kdf(|| kdf.pbkdf2("SHA-512", secret, b"saltsalt", 1000, 32)),
    fake_kdf(|| kdf.pbkdf2("SHA-256", secret, b"saltsalt", 1001, 32)),
  ];
  assert_eq(others.filter(|tag: Bytes| tag == base).len(), 0);
  assert_eq(others.unique().len(), others.len());
  assert_eq(fake_kdf(|| kdf.bcrypt(secret, zeros(16), 12)).len(), 23);
  assert_eq(
    [4, 20, 64].map(|length: Int| fake_kdf(|| kdf.scrypt(secret, b"", 14, 8, 1, length)).len()),
    [4, 20, 64],
  )
}

test "a hash string reads back as the hash it was written from" {
  gen::check(arbitrary_stored(), |x: StoredHash|
    round_trip(format_hash, |text: String| parse(text).ok(), x))
}

test "`parse` returns a result without crashing for any text after an algorithm prefix such as `$argon2id$`" {
  gen::check(gen::text(), |rest: String| {
    let heads = [
      "",
      "$",
      "$argon2id$",
      "$argon2id$v=19$",
      "$scrypt$",
      "$2b$",
      "$2b$10$",
      "$pbkdf2-sha256$",
    ];
    heads.fold(true, |ok: Bool, head: String|
      ok && (match parse(head ++ rest) { Ok(_) -> true, Err(_) -> true }))
  })
}

test "a hash verifies its own password and no other, and does not need rehashing under the params that made it" {
  gen::check4(
    gen::text(),
    gen::text(),
    arbitrary_params(),
    gen::any_int(),
    |password: String, other: String, params: Params, root: Int| {
      let stored = hashed(password, params, root);
      verified(stored, password, params) == Valid
        && (other == password || verified(stored, other, params) == Invalid)
        && !needs_rehash(stored, params)
    },
  )
}

fn reference_argon2id() -> String =
  "$argon2id$v=19$m=65536,t=2,p=1$c29tZXNhbHQ$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc"

fn jbcrypt_empty() -> String = "$2a$06$DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s."

test "`verify` accepts the reference implementation's Argon2id hash and jBCrypt's bcrypt hash, and flags both for rehashing" {
  let verdict = |stored: String, supplied: String|
    verify(stored, Secret::of_string(supplied), owasp_argon2id());
  assert_eq(verdict(reference_argon2id(), "password"), ValidNeedsRehash);
  assert_eq(verdict(reference_argon2id(), "passwore"), Invalid);
  assert_eq(verdict(jbcrypt_empty(), ""), ValidNeedsRehash);
  assert_eq(verdict(jbcrypt_empty(), " "), Invalid)
}
