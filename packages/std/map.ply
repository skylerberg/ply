//! Functions over a `Map<k, v>`, built on the prelude's map builtins.
//!
//! A map stores its entries in the order `compare` gives its keys. So every result here comes back
//! in key order, and two maps with the same entries are `==` however each was built. If the key
//! type declares a `key` function, keys are compared through it. Every signature carries `where
//! derivable(ord, k)`, because a `Map`'s key type must satisfy it.
//!
//! `Map::first`, `Map::last`, `Map::floor`, `Map::ceiling`, `Map::below`, `Map::above`,
//! `Map::pop_first`, `Map::pop_last`, `Map::split` and `Map::between` each visit one path of the
//! map's tree: a few nodes, however many entries the map contains. `Map::entries_between` visits
//! one path and then the entries it returns.
//!
//! A map that nothing else references is updated in place, by `Map::pop_first` and `Map::split` as
//! by `Map::insert`. A map that something else references is not changed, and the result shares
//! everything with it except the changed path. A record that you still read from later counts as
//! such a reference. So a loop that pops entries should keep the map that `Map::pop_first` or
//! `Map::pop_last` returns in a variable or argument of its own. Alternatively, it should read
//! whatever else it needs from the record that contains the map before it pops.
//!
//! `Map::merge_with`, `Map::union`, `Map::intersection` and `Map::difference` visit the smaller of
//! their two maps and look up each of its keys in the larger. `Map::merge` visits its second map,
//! and `Map::merge_by` and `Map::diff` visit both.
//!
//! Importing `Map::map`, `Map::filter`, `Map::fold`, `Map::entries_between` or `Map::floor` from
//! this module by name hides the prelude's function of the same name in the importing module.
//! Calling them as `map::fold` and so on hides nothing.

import std.laws (agrees)
import std.list as list
import std.gen

/// One end of a range of keys: the key itself counted, the key left out, or no end at all.
pub type Bound<k> = | Included(k) | Excluded(k) | Unbounded

/// Whether the map contains no keys.
pub fn Map::is_empty<k, v>(m: Map<k, v>) -> Bool
  where derivable(ord, k)
= m.len() == 0

/// How many keys the map contains.
pub fn Map::size<k, v>(m: Map<k, v>) -> Int
  where derivable(ord, k)
= m.len()

/// The value under `key`, or `fallback`. The fallback is already evaluated.
pub fn Map::get_or<k, v>(m: Map<k, v>, key: k, fallback: v) -> v
  where derivable(ord, k)
= match m.get(key) { Some(value) -> value, None -> fallback }

/// Updates the entry for `key` with `f`. `f` is given `Some` of the current value, or `None` if
/// the key is absent. It returns the new value, or `None` to remove the key. So one call can
/// insert, replace or remove.
pub fn Map::alter<k, v | e>(m: Map<k, v>, key: k, f: (Option<v>) -> Option<v> / e) -> Map<k, v> / e
  where derivable(ord, k)
=
  match m.get(key) {
    None -> match f(None) { Some(value) -> m.insert(key, value), None -> m },
    Some(push_if_some) -> {
      let rest = m.remove(key);
      match f(Some(push_if_some)) { Some(value) -> rest.insert(key, value), None -> rest }
    },
  }

/// The entries of both maps. A key in both gets `f` of `a`'s value and `b`'s value.
pub fn Map::merge_with<k, v | e>(a: Map<k, v>, b: Map<k, v>, f: (v, v) -> v / e) -> Map<k, v> / e
  where derivable(ord, k)
=
  if b.len() <= a.len() {
    b.fold(a, |accumulator: Map<k, v>, key: k, theirs: v|
      match accumulator.get(key) {
        Some(ours) -> accumulator.insert(key, f(ours, theirs)),
        None -> accumulator.insert(key, theirs),
      })
  } else {
    a.fold(b, |accumulator: Map<k, v>, key: k, ours: v|
      match accumulator.get(key) {
        Some(theirs) -> accumulator.insert(key, f(ours, theirs)),
        None -> accumulator.insert(key, ours),
      })
  }

/// Combines every key of either map with `f`. `f` is given the key and `Some` of each map's value
/// for it, or `None` where that map lacks the key. It returns the value to store, or `None` to
/// leave the key out. The two maps may have values of different types.
pub fn Map::merge_by<k, a, b, c | e>(
  left: Map<k, a>,
  right: Map<k, b>,
  f: (k, Option<a>, Option<b>) -> Option<c> / e,
) -> Map<k, c> / e
  where derivable(ord, k)
= Map::of_entries(merge_entries(left.entries(), 0, right.entries(), 0, f, []))

fn merge_entries<k, a, b, c | e>(
  ls: List<{ key: k, value: a }>,
  i: Int,
  rs: List<{ key: k, value: b }>,
  j: Int,
  f: (k, Option<a>, Option<b>) -> Option<c> / e,
  out: List<{ key: k, value: c }>,
) -> List<{ key: k, value: c }> / e
  where derivable(ord, k)
=
  match ls.at(i) {
    None -> match rs.at(j) {
      None -> out,
      Some(r) ->
        merge_entries(ls, i, rs, j + 1, f, push_if_some(out, r.key, f(r.key, None, Some(r.value)))),
    },
    Some(l) -> match rs.at(j) {
      None ->
        merge_entries(ls, i + 1, rs, j, f, push_if_some(out, l.key, f(l.key, Some(l.value), None))),
      Some(r) -> match compare(l.key, r.key) {
        Less ->
          merge_entries(
            ls,
            i + 1,
            rs,
            j,
            f,
            push_if_some(out, l.key, f(l.key, Some(l.value), None)),
          ),
        Greater ->
          merge_entries(
            ls,
            i,
            rs,
            j + 1,
            f,
            push_if_some(out, r.key, f(r.key, None, Some(r.value))),
          ),
        Equal ->
          merge_entries(
            ls,
            i + 1,
            rs,
            j + 1,
            f,
            push_if_some(out, l.key, f(l.key, Some(l.value), Some(r.value))),
          ),
      },
    },
  }

fn push_if_some<k, v>(
  out: List<{ key: k, value: v }>,
  key: k,
  value: Option<v>,
) -> List<{ key: k, value: v }> =
  match value { Some(value) -> out.push({ key: key, value: value }), None -> out }

/// Every entry of either map. A key in both maps takes `a`'s value.
pub fn Map::union<k, v>(a: Map<k, v>, b: Map<k, v>) -> Map<k, v>
  where derivable(ord, k)
= b.merge(a)

/// The entries of `a` whose keys are also in `b`.
pub fn Map::intersection<k, v, w>(a: Map<k, v>, b: Map<k, w>) -> Map<k, v>
  where derivable(ord, k)
=
  if a.len() <= b.len() { a.filter(|key: k, _value: v| b.contains(key)) } else {
    Map::of_entries(
      b.fold([], |accumulator: List<{ key: k, value: v }>, key: k, _theirs: w|
        match a.floor(key) {
          Some(ours) -> if ours.key == key { accumulator.push(ours) } else { accumulator },
          None -> accumulator,
        }),
    )
  }

/// The entries of `a` whose keys are not in `b`.
pub fn Map::difference<k, v, w>(a: Map<k, v>, b: Map<k, w>) -> Map<k, v>
  where derivable(ord, k)
=
  if b.len() < a.len() {
    b.fold(a, |accumulator: Map<k, v>, key: k, _theirs: w| accumulator.remove(key))
  } else { a.filter(|key: k, _value: v| !b.contains(key)) }

/// What changed from `before` to `after`: the entries only in `after`, the entries only in
/// `before`, and both values of each key whose value differs.
pub fn Map::diff<k, v>(
  before: Map<k, v>,
  after: Map<k, v>,
) -> { added: Map<k, v>, removed: Map<k, v>, changed: Map<k, { before: v, after: v }> }
  where derivable(ord, k)
=
  {
    added: after.difference(before),
    removed: before.difference(after),
    changed: before.merge_by(after, |_key: k, was: Option<v>, is: Option<v>|
      match was {
        None -> None,
        Some(x) -> match is {
          None -> None,
          Some(y) -> if x == y { None } else { Some({ before: x, after: y }) },
        },
      }),
  }

/// A map of the pairs. When a key repeats, its value becomes `f` of the earlier value and the
/// later one.
pub fn Map::from_entries_with<k, v | e>(
  entries: List<{ key: k, value: v }>,
  f: (v, v) -> v / e,
) -> Map<k, v> / e
  where derivable(ord, k)
= insert_all_with(entries, 0, Map::new(), f)

fn insert_all_with<k, v | e>(
  entries: List<{ key: k, value: v }>,
  i: Int,
  accumulator: Map<k, v>,
  f: (v, v) -> v / e,
) -> Map<k, v> / e
  where derivable(ord, k)
=
  match entries.at(i) {
    None -> accumulator,
    Some(entry) ->
      insert_all_with(
        entries,
        i + 1,
        match accumulator.get(entry.key) {
          Some(earlier) -> accumulator.insert(entry.key, f(earlier, entry.value)),
          None -> accumulator.insert(entry.key, entry.value),
        },
        f,
      ),
  }

/// The map with `f` applied to each value.
pub fn Map::map<k, v, w | e>(m: Map<k, v>, f: (v) -> w / e) -> Map<k, w> / e
  where derivable(ord, k)
=
  Map::of_entries(
    m.fold([], |accumulator: List<{ key: k, value: w }>, key: k, value: v|
      accumulator.push({ key: key, value: f(value) })),
  )

/// The entries for which `keep` returns true.
pub fn Map::filter<k, v | e>(m: Map<k, v>, keep: (k, v) -> Bool / e) -> Map<k, v> / e
  where derivable(ord, k)
=
  Map::of_entries(
    m.fold([], |accumulator: List<{ key: k, value: v }>, key: k, value: v|
      if keep(key, value) { accumulator.push({ key: key, value: value }) } else { accumulator }),
  )

/// The entries for which `ok` returns true, and the rest.
pub fn Map::partition<k, v | e>(
  m: Map<k, v>,
  ok: (k, v) -> Bool / e,
) -> { yes: Map<k, v>, no: Map<k, v> } / e
  where derivable(ord, k)
= {
  let parted = m.fold(
    { yes: [], no: [] },
    |accumulator: { yes: List<{ key: k, value: v }>, no: List<{ key: k, value: v }> }, key: k, value: v|
      if ok(key, value) {
        { yes: accumulator.yes.push({ key: key, value: value }), no: accumulator.no }
      } else { { yes: accumulator.yes, no: accumulator.no.push({ key: key, value: value }) } },
  );
  { yes: Map::of_entries(parted.yes), no: Map::of_entries(parted.no) }
}

/// How many entries `ok` returns true for.
pub fn Map::count<k, v | e>(m: Map<k, v>, ok: (k, v) -> Bool / e) -> Int / e
  where derivable(ord, k)
= m.fold(0, |n: Int, key: k, value: v| if ok(key, value) { n + 1 } else { n })

/// Whether `ok` returns true for some entry. False for the empty map.
pub fn Map::any<k, v | e>(m: Map<k, v>, ok: (k, v) -> Bool / e) -> Bool / e
  where derivable(ord, k)
= m.fold(false, |found: Bool, key: k, value: v| found || ok(key, value))

/// Whether `ok` returns true for every entry. True for the empty map.
pub fn Map::all<k, v | e>(m: Map<k, v>, ok: (k, v) -> Bool / e) -> Bool / e
  where derivable(ord, k)
= m.fold(true, |so_far: Bool, key: k, value: v| so_far && ok(key, value))

/// Returns the entries whose keys lie between `lo` and `hi`, in key order. Returns no entries when
/// `lo` is above `hi`.
pub fn Map::entries_between<k, v>(
  m: Map<k, v>,
  lo: Bound<k>,
  hi: Bound<k>,
) -> List<{ key: k, value: v }>
  where derivable(ord, k)
= m.entries_between_take(lo, hi, m.len())

/// The first `limit` entries of `m.entries_between(lo, hi)`, or none if `limit` is not positive.
/// It visits no entry past the ones it returns, so one page of a long range costs one page.
pub fn Map::entries_between_take<k, v>(
  m: Map<k, v>,
  lo: Bound<k>,
  hi: Bound<k>,
  limit: Int,
) -> List<{ key: k, value: v }>
  where derivable(ord, k)
= m.range(bound_key(lo), is_included(lo), bound_key(hi), is_included(hi), limit)

fn bound_key<k>(bound: Bound<k>) -> Option<k> =
  match bound { Included(key) -> Some(key), Excluded(key) -> Some(key), Unbounded -> None }

fn is_included<k>(bound: Bound<k>) -> Bool = match bound { Included(_) -> true, _ -> false }

/// A map of the entries that `m.entries_between(lo, hi)` returns. It shares what it can with `m`
/// and visits one path of the tree for each bound, however many entries lie between them.
pub fn Map::between<k, v>(m: Map<k, v>, lo: Bound<k>, hi: Bound<k>) -> Map<k, v>
  where derivable(ord, k)
= from_bound(to_bound(m, hi), lo)

fn from_bound<k, v>(m: Map<k, v>, lo: Bound<k>) -> Map<k, v>
  where derivable(ord, k)
=
  match lo {
    Unbounded -> m,
    Excluded(key) -> m.split(key).above,
    Included(key) -> match m.below(key) { Some(under) -> m.split(under.key).above, None -> m },
  }

fn to_bound<k, v>(m: Map<k, v>, hi: Bound<k>) -> Map<k, v>
  where derivable(ord, k)
=
  match hi {
    Unbounded -> m,
    Excluded(key) -> m.split(key).below,
    Included(key) -> match m.above(key) { Some(over) -> m.split(over.key).below, None -> m },
  }

fn counted(i: Int, n: Int, accumulator: Map<Int, Int>) -> Map<Int, Int> =
  if i >= n { accumulator } else { counted(i + 1, n, accumulator.insert(i, i * 10)) }

fn numbered(n: Int) -> Map<Int, Int> = counted(0, n, Map::new())

fn sample_map() -> Map<String, Int> =
  Map::of_entries([{ key: "d", value: 4 }, { key: "b", value: 2 }, { key: "f", value: 6 }])

fn joined(x: String, y: String) -> String = x ++ "+" ++ y

test "a map contains what was inserted and returns it in key order" {
  let m = Map::of_entries([{ key: 2, value: "b" }, { key: 1, value: "a" }]);
  assert_eq(m.size(), 2);
  assert(!m.is_empty());
  assert(Map::of_entries([]).is_empty());
  assert_eq(m.get(1), Some("a"));
  assert_eq(m.get(3), None);
  assert_eq(m.get_or(1, "z"), "a");
  assert_eq(m.get_or(3, "z"), "z");
  assert(m.contains(2));
  assert(!m.contains(3));
  assert_eq(m.keys(), [1, 2]);
  assert_eq(m.values(), ["a", "b"]);
  assert_eq(m.entries(), [{ key: 1, value: "a" }, { key: 2, value: "b" }])
}

test "`insert` overwrites an existing key's value, `remove` deletes a key, and `merge` prefers the second map's value for a shared key" {
  let m = Map::of_entries([{ key: 1, value: "a" }]).insert(1, "z");
  assert_eq(m.get(1), Some("z"));
  assert_eq(m.remove(1).get(1), None);
  assert_eq(m.remove(3).size(), 1);
  let both = Map::of_entries([{ key: 1, value: "a" }, { key: 2, value: "b" }]).merge(
    Map::of_entries([{ key: 2, value: "z" }]),
  );
  assert_eq(both.get(1), Some("a"));
  assert_eq(both.get(2), Some("z"));
  assert_eq(both.size(), 2);
  assert_eq(Map::of_entries([{ key: 1, value: "a" }, { key: 1, value: "z" }]).get(1), Some("z"))
}

test "update rewrites a value that is there, and alter inserts, replaces or removes" {
  let m = sample_map();
  assert_eq(m.update("b", |n: Int| n + 40).get("b"), Some(42));
  assert_eq(m.update("c", |n: Int| n + 40), m);
  let wide = range(0, 100).fold(Map::new(), |accumulator: Map<Int, Int>, i: Int|
    accumulator.insert(2 * i, i));
  assert_eq(wide.update(51, |n: Int| n + 1), wide);
  assert_eq(wide.update(150, |n: Int| n + 1).get(150), Some(76));
  let bumped = |push_if_some: Option<Int>| Some(match push_if_some { Some(n) -> n + 1, None -> 1 });
  assert_eq(m.alter("b", bumped).get("b"), Some(3));
  assert_eq(m.alter("c", bumped).get("c"), Some(1));
  assert_eq(m.alter("b", |_held: Option<Int>| None).keys(), ["d", "f"]);
  assert_eq(m.alter("c", |push_if_some: Option<Int>| push_if_some), m)
}

test "merge_with passes its function the first map's value and then the second's" {
  let small = Map::of_entries([{ key: 2, value: "p" }, { key: 9, value: "q" }]);
  let large = Map::of_entries([
    { key: 1, value: "a" },
    { key: 2, value: "b" },
    { key: 3, value: "c" },
  ]);
  assert_eq(large.merge_with(small, joined).entries(), [
    { key: 1, value: "a" },
    { key: 2, value: "b+p" },
    { key: 3, value: "c" },
    { key: 9, value: "q" },
  ]);
  assert_eq(small.merge_with(large, joined).entries(), [
    { key: 1, value: "a" },
    { key: 2, value: "p+b" },
    { key: 3, value: "c" },
    { key: 9, value: "q" },
  ]);
  assert_eq(large.merge_with(Map::new(), joined), large);
  assert_eq(Map::new().merge_with(large, joined), large)
}

test "merge_by is called for a key of either map, with each map's value" {
  let stock = Map::of_entries([{ key: "nut", value: 3 }, { key: "bolt", value: 5 }]);
  let prices = Map::of_entries([{ key: "nut", value: "0.10" }, { key: "gear", value: "2.00" }]);
  let merged = stock.merge_by(prices, |name: String, n: Option<Int>, price: Option<String>|
    match n {
      None -> Some(name ++ ": none held"),
      Some(n) -> match price {
        None -> None,
        Some(price) -> Some(n.to_string() ++ " at " ++ price),
      },
    });
  assert_eq(merged.entries(), [
    { key: "gear", value: "gear: none held" },
    { key: "nut", value: "3 at 0.10" },
  ])
}

test "union, intersection and difference keep the first map's values" {
  let a = Map::of_entries([
    { key: 1, value: "a1" },
    { key: 2, value: "a2" },
    { key: 3, value: "a3" },
  ]);
  let b = Map::of_entries([{ key: 3, value: 30 }, { key: 4, value: 40 }]);
  let c = Map::of_entries([{ key: 3, value: "c3" }, { key: 4, value: "c4" }]);
  assert_eq(a.union(c).entries(), [
    { key: 1, value: "a1" },
    { key: 2, value: "a2" },
    { key: 3, value: "a3" },
    { key: 4, value: "c4" },
  ]);
  assert_eq(a.intersection(b).entries(), [{ key: 3, value: "a3" }]);
  assert_eq(b.intersection(a).entries(), [{ key: 3, value: 30 }]);
  assert_eq(a.difference(b).entries(), [{ key: 1, value: "a1" }, { key: 2, value: "a2" }]);
  assert_eq(b.difference(a).entries(), [{ key: 4, value: 40 }]);
  assert_eq(a.difference(a), Map::new());
  assert_eq(a.intersection(a), a)
}

test "diff reports what was added, what was removed and what changed" {
  let before = Map::of_entries([
    { key: "a", value: 1 },
    { key: "b", value: 2 },
    { key: "c", value: 3 },
  ]);
  let after = Map::of_entries([
    { key: "b", value: 2 },
    { key: "c", value: 30 },
    { key: "d", value: 4 },
  ]);
  let difference = before.diff(after);
  assert_eq(difference.added.entries(), [{ key: "d", value: 4 }]);
  assert_eq(difference.removed.entries(), [{ key: "a", value: 1 }]);
  assert_eq(difference.changed.entries(), [{ key: "c", value: { before: 3, after: 30 } }]);
  let same = before.diff(before);
  assert(same.added.is_empty() && same.removed.is_empty() && same.changed.is_empty())
}

test "from_entries_with combines the values of one key in the order they came" {
  let seen = [
    { key: "b", value: "1" },
    { key: "a", value: "2" },
    { key: "b", value: "3" },
    { key: "b", value: "4" },
  ];
  assert_eq(Map::from_entries_with(seen, joined).entries(), [
    { key: "a", value: "2" },
    { key: "b", value: "1+3+4" },
  ]);
  assert_eq(Map::from_entries_with([], joined), Map::new())
}

test "fold, map, filter, partition, count, any and all read every entry in key order" {
  let m = sample_map();
  assert_eq(
    m.fold("", |accumulator: String, key: String, value: Int|
      accumulator ++ key ++ value.to_string()),
    "b2d4f6",
  );
  assert_eq(m.map(|n: Int| n * 10).entries(), [
    { key: "b", value: 20 },
    { key: "d", value: 40 },
    { key: "f", value: 60 },
  ]);
  assert_eq(m.filter(|key: String, n: Int| key != "d" && n > 2).keys(), ["f"]);
  let parted = m.partition(|_key: String, n: Int| n < 5);
  assert_eq(parted.yes.keys(), ["b", "d"]);
  assert_eq(parted.no.keys(), ["f"]);
  assert_eq(m.count(|_key: String, n: Int| n > 2), 2);
  assert(m.any(|key: String, _n: Int| key == "f"));
  assert(!m.any(|_key: String, n: Int| n > 6));
  assert(m.all(|_key: String, n: Int| n % 2 == 0));
  assert(!m.all(|key: String, _n: Int| key != "f"));
  assert(!Map::new().any(|_key: String, _n: Int| true));
  assert(Map::new().all(|_key: String, _n: Int| false))
}

fn positive(key: String, value: Int) -> Bool / {abort.raise} = {
  assert(value > 0, Some(key));
  true
}

test "a function passed to a traversal may raise, and then so may the traversal" {
  let m = sample_map();
  assert(m.all(positive));
  assert(m.any(positive));
  assert_eq(m.count(positive), 3);
  assert_eq(m.filter(positive).size(), 3);
  assert_eq(m.partition(positive).yes.size(), 3);
  assert_eq(
    m.fold(0, |sum: Int, key: String, value: Int|
      if positive(key, value) { sum + value } else { sum }),
    12,
  );
  assert_eq(m.map(|value: Int| if positive("", value) { value + 1 } else { value }).values(), [
    3,
    5,
    7,
  ])
}

test "`first`, `last`, `floor`, `ceiling`, `below` and `above` return entries by key order" {
  let m = sample_map();
  assert_eq(m.first(), Some({ key: "b", value: 2 }));
  assert_eq(m.last(), Some({ key: "f", value: 6 }));
  assert_eq(m.floor("d"), Some({ key: "d", value: 4 }));
  assert_eq(m.floor("e"), Some({ key: "d", value: 4 }));
  assert_eq(m.floor("a"), None);
  assert_eq(m.ceiling("d"), Some({ key: "d", value: 4 }));
  assert_eq(m.ceiling("c"), Some({ key: "d", value: 4 }));
  assert_eq(m.ceiling("g"), None);
  assert_eq(m.below("d"), Some({ key: "b", value: 2 }));
  assert_eq(m.below("b"), None);
  assert_eq(m.above("d"), Some({ key: "f", value: 6 }));
  assert_eq(m.above("f"), None);
  let none: Map<String, Int> = Map::new();
  assert_eq(none.first(), None);
  assert_eq(none.last(), None);
  assert_eq(none.floor("a"), None);
  assert_eq(none.above("a"), None)
}

test "`pop_first` and `pop_last` return the smallest or largest entry and the map without it" {
  let m = sample_map();
  assert_eq(m.pop_first(), Some({ key: "b", value: 2, rest: m.remove("b") }));
  assert_eq(m.pop_last(), Some({ key: "f", value: 6, rest: m.remove("f") }));
  let none: Map<String, Int> = Map::new();
  assert_eq(none.pop_first(), None);
  assert_eq(none.pop_last(), None);
  assert_eq(
    Map::of_entries([{ key: 1, value: 1 }]).pop_first(),
    Some({ key: 1, value: 1, rest: Map::new() }),
  )
}

test "a range includes or excludes a bound's own key, as the bound states" {
  let m = numbered(10);
  let ks = |lo: Bound<Int>, hi: Bound<Int>| m.between(lo, hi).keys();
  assert_eq(m.entries_between(Included(3), Included(5)), [
    { key: 3, value: 30 },
    { key: 4, value: 40 },
    { key: 5, value: 50 },
  ]);
  assert_eq(ks(Included(3), Included(5)), [3, 4, 5]);
  assert_eq(ks(Excluded(3), Included(5)), [4, 5]);
  assert_eq(ks(Included(3), Excluded(5)), [3, 4]);
  assert_eq(ks(Excluded(3), Excluded(5)), [4]);
  assert_eq(ks(Unbounded, Excluded(2)), [0, 1]);
  assert_eq(ks(Included(8), Unbounded), [8, 9]);
  assert_eq(ks(Unbounded, Unbounded), m.keys());
  assert_eq(ks(Included(5), Included(3)), []);
  assert_eq(ks(Excluded(4), Excluded(4)), []);
  assert_eq(ks(Included(4), Included(4)), [4]);
  assert_eq(ks(Included(-5), Included(100)), m.keys());
  assert_eq(ks(Included(20), Unbounded), []);
  assert_eq(m.entries_between_take(Excluded(3), Unbounded, 2), [
    { key: 4, value: 40 },
    { key: 5, value: 50 },
  ]);
  assert_eq(m.entries_between_take(Unbounded, Unbounded, 0), []);
  assert_eq(m.entries_between_take(Unbounded, Unbounded, -3), []);
  assert_eq(m.entries_between_take(Unbounded, Unbounded, 99).len(), 10)
}

test "a split divides a map at a key it contains or lacks" {
  let m = numbered(100);
  let push_if_some = m.split(40);
  assert_eq(push_if_some.below.size(), 40);
  assert_eq(push_if_some.at, Some(400));
  assert_eq(push_if_some.above.size(), 59);
  assert_eq(push_if_some.above.first(), Some({ key: 41, value: 410 }));
  assert_eq(push_if_some.below.last(), Some({ key: 39, value: 390 }));
  let lacked = m.remove(40).split(40);
  assert_eq(lacked.below.size(), 40);
  assert_eq(lacked.at, None);
  assert_eq(lacked.above.size(), 59);
  let under = m.split(-1);
  assert(under.below.is_empty());
  assert_eq(under.above, m);
  let over = m.split(100);
  assert_eq(over.below, m);
  assert(over.above.is_empty())
}

type Probe = { m: Map<Int, String>, key: Int }

type Window = { m: Map<Int, String>, lo: Bound<Int>, hi: Bound<Int>, limit: Int }

type Pair = { a: Map<Int, String>, b: Map<Int, String> }

fn keys_mod_eight(m: Map<Int, String>) -> Map<Int, String> =
  m.fold(Map::new(), |accumulator: Map<Int, String>, key: Int, value: String|
    accumulator.insert(key % 8, value))

fn near_bound(bound: Bound<Int>) -> Bound<Int> =
  match bound {
    Included(key) -> Included(key % 8),
    Excluded(key) -> Excluded(key % 8),
    Unbounded -> Unbounded,
  }

fn entries_where_key<v>(m: Map<Int, v>, ok: (Int) -> Bool) -> List<{ key: Int, value: v }> =
  m.entries().partition(|entry: { key: Int, value: v }| ok(entry.key)).yes

fn within(lo: Bound<Int>, hi: Bound<Int>, key: Int) -> Bool =
  (match lo { Included(least) -> least <= key, Excluded(least) -> least < key, Unbounded -> true })
    && (match hi { Included(most) -> key <= most, Excluded(most) -> key < most, Unbounded -> true })

fn merged_lists(
  xs: List<{ key: Int, value: String }>,
  ys: List<{ key: Int, value: String }>,
) -> List<{ key: Int, value: String }> =
  xs.flat_map(|x: { key: Int, value: String }|
    [
      match ys.find(|y: { key: Int, value: String }| y.key == x.key) {
        Some(y) -> { key: x.key, value: joined(x.value, y.value) },
        None -> x,
      },
    ]).concat(
    ys.partition(|y: { key: Int, value: String }|
      !xs.any(|x: { key: Int, value: String }| x.key == y.key)).yes,
  ).sort_by(|p: { key: Int, value: String }, q: { key: Int, value: String }| p.key <= q.key)

fn probes() -> gen::Gen<Probe> =
  gen::map2(
    gen::map_of(gen::any_int(), gen::text()),
    gen::any_int(),
    |m: Map<Int, String>, key: Int| { m: m, key: key },
  )

fn windows() -> gen::Gen<Window> =
  gen::map4(
    gen::map_of(gen::any_int(), gen::text()),
    gen::one_of([
      gen::map(gen::any_int(), |f0: Int| Included(f0)),
      gen::map(gen::any_int(), |f0: Int| Excluded(f0)),
      gen::constant(Unbounded),
    ]),
    gen::one_of([
      gen::map(gen::any_int(), |f0: Int| Included(f0)),
      gen::map(gen::any_int(), |f0: Int| Excluded(f0)),
      gen::constant(Unbounded),
    ]),
    gen::any_int(),
    |m: Map<Int, String>, lo: Bound<Int>, hi: Bound<Int>, limit: Int|
      { m: m, lo: lo, hi: hi, limit: limit },
  )

fn pairs() -> gen::Gen<Pair> =
  gen::map2(
    gen::map_of(gen::any_int(), gen::text()),
    gen::map_of(gen::any_int(), gen::text()),
    |a: Map<Int, String>, b: Map<Int, String>| { a: a, b: b },
  )

test "a range is the entries within its bounds" {
  gen::check(windows(), |x: Window|
    agrees(
      |w: Window| keys_mod_eight(w.m).entries_between(near_bound(w.lo), near_bound(w.hi)),
      |w: Window|
        entries_where_key(keys_mod_eight(w.m), |key: Int|
          within(near_bound(w.lo), near_bound(w.hi), key)),
      x,
    ))
}

test "a split is the entries below the key, the value under it and the entries above it" {
  gen::check(probes(), |x: Probe|
    agrees(
      |q: Probe| keys_mod_eight(q.m).split(q.key % 8),
      |q: Probe|
        {
          below: Map::of_entries(
            entries_where_key(keys_mod_eight(q.m), |key: Int| key < q.key % 8),
          ),
          at: keys_mod_eight(q.m).get(q.key % 8),
          above: Map::of_entries(
            entries_where_key(keys_mod_eight(q.m), |key: Int| key > q.key % 8),
          ),
        },
      x,
    ))
}

test "merge_with is the merge of the two association lists" {
  gen::check(pairs(), |x: Pair|
    agrees(
      |p: Pair| keys_mod_eight(p.a).merge_with(keys_mod_eight(p.b), joined).entries(),
      |p: Pair| merged_lists(keys_mod_eight(p.a).entries(), keys_mod_eight(p.b).entries()),
      x,
    ))
}

test "`union`, `intersection` and `difference` return the same entries as filtering and merging the two maps directly" {
  gen::check(pairs(), |x: Pair|
    agrees(
      |p: Pair|
        {
          union: keys_mod_eight(p.a).union(keys_mod_eight(p.b)).entries(),
          intersection: keys_mod_eight(p.a).intersection(keys_mod_eight(p.b)).entries(),
          difference: keys_mod_eight(p.a).difference(keys_mod_eight(p.b)).entries(),
        },
      |p: Pair|
        {
          union: keys_mod_eight(p.b).merge(keys_mod_eight(p.a)).entries(),
          intersection: entries_where_key(keys_mod_eight(p.a), |key: Int|
            keys_mod_eight(p.b).contains(key)),
          difference: entries_where_key(keys_mod_eight(p.a), |key: Int|
            !keys_mod_eight(p.b).contains(key)),
        },
      x,
    ))
}
