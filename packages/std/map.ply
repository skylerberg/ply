//! What a program wants over a `Map<k, v>`: the prelude's `map_` builtins under the module's name
//! (`m.get(key)` rather than `m.get(key)`), and what is written over them.
//!
//! A map holds its entries in the order `compare` gives its keys, so every answer here comes back
//! in key order, two maps of the same entries are `==` however each was built, and a key of a type
//! that states a `key` is found through it. Every signature carries `where derivable(ord, k)`, as a
//! `Map`'s key must.
//!
//! `Map::first`, `Map::last`, `Map::floor`, `Map::ceiling`, `Map::below`, `Map::above`,
//! `Map::pop_first`, `Map::pop_last`, `Map::split` and `Map::between` each walk one path of the
//! map's tree, a few nodes however many entries it holds; `Map::entries_between` walks one path and
//! then the entries it answers. A map nothing else holds is written where it stands, by
//! `Map::pop_first` and `Map::split` as by `Map::insert`; one something else holds is left whole,
//! and the answer shares all of it but the path. A record still to be read is such a holder, so a
//! loop that pops hands `rest` on as an argument of its own, or binds whatever else it keeps of the
//! record that holds the map before it pops.
//!
//! `Map::merge_with`, `Map::union`, `Map::intersection` and `Map::difference` walk the smaller of
//! their two maps and look each of its keys up in the larger. `Map::merge` walks its second map,
//! and `Map::merge_by` and `Map::diff` walk both.
//!
//! A module that imports `Map::map`, `Map::filter`, `Map::fold`, `Map::entries_between` or
//! `Map::floor` from here by name hides the prelude's function of that name; reached as `map::fold`
//! they hide nothing.

import std.laws (agrees)
import std.list as list
import std.gen

/// One end of a range of keys: the key itself counted, the key left out, or no end at all.
pub type Bound<k> = | Included(k) | Excluded(k) | Unbounded

/// Whether the map holds no keys.
pub fn Map::is_empty<k, v>(m: Map<k, v>) -> Bool
  where derivable(ord, k)
= m.len() == 0

/// How many keys the map holds.
pub fn Map::size<k, v>(m: Map<k, v>) -> Int
  where derivable(ord, k)
= m.len()

/// The value under `key`, or `fallback`. The fallback is already evaluated.
pub fn Map::get_or<k, v>(m: Map<k, v>, key: k, fallback: v) -> v
  where derivable(ord, k)
= match m.get(key) { Some(value) -> value, None -> fallback }

/// `m` with what `f` makes of the value under `key`: it is handed `Some` of the value, or `None`
/// where the key is absent, and answers the value to hold, or `None` to hold none. One call
/// inserts, replaces or removes.
pub fn Map::alter<k, v | e>(m: Map<k, v>, key: k, f: (Option<v>) -> Option<v> / e) -> Map<k, v> / e
  where derivable(ord, k)
=
  match m.get(key) {
    None -> match f(None) { Some(value) -> m.insert(key, value), None -> m },
    Some(held) -> {
      let rest = m.remove(key);
      match f(Some(held)) { Some(value) -> rest.insert(key, value), None -> rest }
    },
  }

/// The two maps together; a key in both holds `f` of `a`'s value and `b`'s.
pub fn Map::merge_with<k, v | e>(a: Map<k, v>, b: Map<k, v>, f: (v, v) -> v / e) -> Map<k, v> / e
  where derivable(ord, k)
=
  if b.len() <= a.len() {
    b.fold(a, |acc: Map<k, v>, key: k, theirs: v|
      match acc.get(key) {
        Some(ours) -> acc.insert(key, f(ours, theirs)),
        None -> acc.insert(key, theirs),
      })
  } else {
    a.fold(b, |acc: Map<k, v>, key: k, ours: v|
      match acc.get(key) {
        Some(theirs) -> acc.insert(key, f(ours, theirs)),
        None -> acc.insert(key, ours),
      })
  }

/// What `f` makes of every key either map holds: it is handed the key with `Some` of each map's
/// value under it, or `None` where that map has none, and answers the value to hold, or `None` to
/// leave the key out. The two maps may hold values of different types.
pub fn Map::merge_by<k, a, b, c | e>(
  left: Map<k, a>,
  right: Map<k, b>,
  f: (k, Option<a>, Option<b>) -> Option<c> / e,
) -> Map<k, c> / e
  where derivable(ord, k)
= Map::of_entries(zipped(left.entries(), 0, right.entries(), 0, f, []))

fn zipped<k, a, b, c | e>(
  ls: List<{ key: k, value: a }>,
  i: Int,
  rs: List<{ key: k, value: b }>,
  j: Int,
  f: (k, Option<a>, Option<b>) -> Option<c> / e,
  out: List<{ key: k, value: c }>,
) -> List<{ key: k, value: c }> / e
  where derivable(ord, k)
=
  match ls.at(i) {
    None -> match rs.at(j) {
      None -> out,
      Some(r) -> zipped(ls, i, rs, j + 1, f, held(out, r.key, f(r.key, None, Some(r.value)))),
    },
    Some(l) -> match rs.at(j) {
      None -> zipped(ls, i + 1, rs, j, f, held(out, l.key, f(l.key, Some(l.value), None))),
      Some(r) -> match compare(l.key, r.key) {
        Less -> zipped(ls, i + 1, rs, j, f, held(out, l.key, f(l.key, Some(l.value), None))),
        Greater -> zipped(ls, i, rs, j + 1, f, held(out, r.key, f(r.key, None, Some(r.value)))),
        Equal ->
          zipped(ls, i + 1, rs, j + 1, f, held(out, l.key, f(l.key, Some(l.value), Some(r.value)))),
      },
    },
  }

fn held<k, v>(
  out: List<{ key: k, value: v }>,
  key: k,
  value: Option<v>,
) -> List<{ key: k, value: v }> =
  match value { Some(value) -> out.push({ key: key, value: value }), None -> out }

/// Every key either map holds; a key in both keeps `a`'s value.
pub fn Map::union<k, v>(a: Map<k, v>, b: Map<k, v>) -> Map<k, v>
  where derivable(ord, k)
= b.merge(a)

/// The entries of `a` whose keys `b` holds too.
pub fn Map::intersection<k, v, w>(a: Map<k, v>, b: Map<k, w>) -> Map<k, v>
  where derivable(ord, k)
=
  if a.len() <= b.len() { a.filter(|key: k, _value: v| b.contains(key)) } else {
    Map::of_entries(
      b.fold([], |acc: List<{ key: k, value: v }>, key: k, _theirs: w|
        match a.floor(key) {
          Some(ours) -> if ours.key == key { acc.push(ours) } else { acc },
          None -> acc,
        }),
    )
  }

/// The entries of `a` whose keys `b` does not hold.
pub fn Map::difference<k, v, w>(a: Map<k, v>, b: Map<k, w>) -> Map<k, v>
  where derivable(ord, k)
=
  if b.len() < a.len() { b.fold(a, |acc: Map<k, v>, key: k, _theirs: w| acc.remove(key)) }
  else { a.filter(|key: k, _value: v| !b.contains(key)) }

/// What changed from `before` to `after`: the entries only `after` holds, the entries only `before`
/// holds, and for each key whose value differs, the two values.
pub fn Map::diff<k, v>(
  before: Map<k, v>,
  after: Map<k, v>,
) -> { added: Map<k, v>, removed: Map<k, v>, changed: Map<k, { before: v, after: v }> }
  where derivable(ord, k)
=
  {
    added: after.difference(before),
    removed: before.difference(after),
    changed: before.merge_by(after, |_key: k, was: Option<v>, is: Option<v>|
      match was {
        None -> None,
        Some(x) -> match is {
          None -> None,
          Some(y) -> if x == y { None } else { Some({ before: x, after: y }) },
        },
      }),
  }

/// A map of the pairs; a key that comes again holds `f` of the value it held and the later one.
pub fn Map::from_entries_with<k, v | e>(
  entries: List<{ key: k, value: v }>,
  f: (v, v) -> v / e,
) -> Map<k, v> / e
  where derivable(ord, k)
= gathered(entries, 0, Map::new(), f)

fn gathered<k, v | e>(
  entries: List<{ key: k, value: v }>,
  i: Int,
  acc: Map<k, v>,
  f: (v, v) -> v / e,
) -> Map<k, v> / e
  where derivable(ord, k)
=
  match entries.at(i) {
    None -> acc,
    Some(entry) ->
      gathered(
        entries,
        i + 1,
        match acc.get(entry.key) {
          Some(earlier) -> acc.insert(entry.key, f(earlier, entry.value)),
          None -> acc.insert(entry.key, entry.value),
        },
        f,
      ),
  }

/// The map with `f` of each value under its key.
pub fn Map::map<k, v, w | e>(m: Map<k, v>, f: (v) -> w / e) -> Map<k, w> / e
  where derivable(ord, k)
=
  Map::of_entries(
    m.fold([], |acc: List<{ key: k, value: w }>, key: k, value: v|
      acc.push({ key: key, value: f(value) })),
  )

/// The entries `keep` answers true for.
pub fn Map::filter<k, v | e>(m: Map<k, v>, keep: (k, v) -> Bool / e) -> Map<k, v> / e
  where derivable(ord, k)
=
  Map::of_entries(
    m.fold([], |acc: List<{ key: k, value: v }>, key: k, value: v|
      if keep(key, value) { acc.push({ key: key, value: value }) } else { acc }),
  )

/// The entries `ok` answers true for, and the rest.
pub fn Map::partition<k, v | e>(
  m: Map<k, v>,
  ok: (k, v) -> Bool / e,
) -> { yes: Map<k, v>, no: Map<k, v> } / e
  where derivable(ord, k)
= {
  let parted = m.fold(
    { yes: [], no: [] },
    |acc: { yes: List<{ key: k, value: v }>, no: List<{ key: k, value: v }> }, key: k, value: v|
      if ok(key, value) { { yes: acc.yes.push({ key: key, value: value }), no: acc.no } }
      else { { yes: acc.yes, no: acc.no.push({ key: key, value: value }) } },
  );
  { yes: Map::of_entries(parted.yes), no: Map::of_entries(parted.no) }
}

/// How many entries `ok` answers true for.
pub fn Map::count<k, v | e>(m: Map<k, v>, ok: (k, v) -> Bool / e) -> Int / e
  where derivable(ord, k)
= m.fold(0, |n: Int, key: k, value: v| if ok(key, value) { n + 1 } else { n })

/// Whether `ok` answers true for an entry. The empty map is `false`.
pub fn Map::any<k, v | e>(m: Map<k, v>, ok: (k, v) -> Bool / e) -> Bool / e
  where derivable(ord, k)
= m.fold(false, |found: Bool, key: k, value: v| found || ok(key, value))

/// Whether `ok` answers true for every entry. The empty map is `true`.
pub fn Map::all<k, v | e>(m: Map<k, v>, ok: (k, v) -> Bool / e) -> Bool / e
  where derivable(ord, k)
= m.fold(true, |so_far: Bool, key: k, value: v| so_far && ok(key, value))

/// The entries whose keys lie from `lo` to `hi`, in key order. Bounds that cross hold nothing.
pub fn Map::entries_between<k, v>(
  m: Map<k, v>,
  lo: Bound<k>,
  hi: Bound<k>,
) -> List<{ key: k, value: v }>
  where derivable(ord, k)
= m.entries_between_take(lo, hi, m.len())

/// The first `limit` entries of `m.entries_between(lo, hi)`, none where `limit` is not positive. It
/// walks no entry past the ones it answers, so a page of a long range costs a page.
pub fn Map::entries_between_take<k, v>(
  m: Map<k, v>,
  lo: Bound<k>,
  hi: Bound<k>,
  limit: Int,
) -> List<{ key: k, value: v }>
  where derivable(ord, k)
= m.range(bound_key(lo), is_included(lo), bound_key(hi), is_included(hi), limit)

fn bound_key<k>(bound: Bound<k>) -> Option<k> =
  match bound { Included(key) -> Some(key), Excluded(key) -> Some(key), Unbounded -> None }

fn is_included<k>(bound: Bound<k>) -> Bool = match bound { Included(_) -> true, _ -> false }

/// The map of the entries `m.entries_between(lo, hi)` lists. It shares what it can with `m` and
/// walks one path of the tree for each bound, however many entries lie between them.
pub fn Map::between<k, v>(m: Map<k, v>, lo: Bound<k>, hi: Bound<k>) -> Map<k, v>
  where derivable(ord, k)
= from_bound(to_bound(m, hi), lo)

fn from_bound<k, v>(m: Map<k, v>, lo: Bound<k>) -> Map<k, v>
  where derivable(ord, k)
=
  match lo {
    Unbounded -> m,
    Excluded(key) -> m.split(key).above,
    Included(key) -> match m.below(key) { Some(under) -> m.split(under.key).above, None -> m },
  }

fn to_bound<k, v>(m: Map<k, v>, hi: Bound<k>) -> Map<k, v>
  where derivable(ord, k)
=
  match hi {
    Unbounded -> m,
    Excluded(key) -> m.split(key).below,
    Included(key) -> match m.above(key) { Some(over) -> m.split(over.key).below, None -> m },
  }

// --- Tests ------------------------------------------------------------------

fn counted(i: Int, n: Int, acc: Map<Int, Int>) -> Map<Int, Int> =
  if i >= n { acc } else { counted(i + 1, n, acc.insert(i, i * 10)) }

/// `i` under `10 * i` for every `i` from zero to below `n`.
fn numbered(n: Int) -> Map<Int, Int> = counted(0, n, Map::new())

fn lettered() -> Map<String, Int> =
  Map::of_entries([{ key: "d", value: 4 }, { key: "b", value: 2 }, { key: "f", value: 6 }])

fn joined(x: String, y: String) -> String = x ++ "+" ++ y

test "a map holds what was inserted and answers in key order" {
  let m = Map::of_entries([{ key: 2, value: "b" }, { key: 1, value: "a" }]);
  assert_eq(m.size(), 2);
  assert(!m.is_empty());
  assert(Map::of_entries([]).is_empty());
  assert_eq(m.get(1), Some("a"));
  assert_eq(m.get(3), None);
  assert_eq(m.get_or(1, "z"), "a");
  assert_eq(m.get_or(3, "z"), "z");
  assert(m.contains(2));
  assert(!m.contains(3));
  assert_eq(m.keys(), [1, 2]);
  assert_eq(m.values(), ["a", "b"]);
  assert_eq(m.entries(), [{ key: 1, value: "a" }, { key: 2, value: "b" }])
}

test "insert replaces, remove takes away, and merge prefers the second map" {
  let m = Map::of_entries([{ key: 1, value: "a" }]).insert(1, "z");
  assert_eq(m.get(1), Some("z"));
  assert_eq(m.remove(1).get(1), None);
  assert_eq(m.remove(3).size(), 1);
  let both = Map::of_entries([{ key: 1, value: "a" }, { key: 2, value: "b" }]).merge(
    Map::of_entries([{ key: 2, value: "z" }]),
  );
  assert_eq(both.get(1), Some("a"));
  assert_eq(both.get(2), Some("z"));
  assert_eq(both.size(), 2);
  // A later entry for a key wins in `Map::of_entries` too.
  assert_eq(Map::of_entries([{ key: 1, value: "a" }, { key: 1, value: "z" }]).get(1), Some("z"))
}

test "update rewrites a value that is there, and alter inserts, replaces or removes" {
  let m = lettered();
  assert_eq(m.update("b", |n: Int| n + 40).get("b"), Some(42));
  assert_eq(m.update("c", |n: Int| n + 40), m);
  let wide = range(0, 100).fold(Map::new(), |acc: Map<Int, Int>, i: Int| acc.insert(2 * i, i));
  assert_eq(wide.update(51, |n: Int| n + 1), wide);
  assert_eq(wide.update(150, |n: Int| n + 1).get(150), Some(76));
  let bumped = |held: Option<Int>| Some(match held { Some(n) -> n + 1, None -> 1 });
  assert_eq(m.alter("b", bumped).get("b"), Some(3));
  assert_eq(m.alter("c", bumped).get("c"), Some(1));
  assert_eq(m.alter("b", |_held: Option<Int>| None).keys(), ["d", "f"]);
  assert_eq(m.alter("c", |held: Option<Int>| held), m)
}

test "merge_with hands its function the first map's value and then the second's" {
  let small = Map::of_entries([{ key: 2, value: "p" }, { key: 9, value: "q" }]);
  let large = Map::of_entries([
    { key: 1, value: "a" },
    { key: 2, value: "b" },
    { key: 3, value: "c" },
  ]);
  assert_eq(large.merge_with(small, joined).entries(), [
    { key: 1, value: "a" },
    { key: 2, value: "b+p" },
    { key: 3, value: "c" },
    { key: 9, value: "q" },
  ]);
  assert_eq(small.merge_with(large, joined).entries(), [
    { key: 1, value: "a" },
    { key: 2, value: "p+b" },
    { key: 3, value: "c" },
    { key: 9, value: "q" },
  ]);
  assert_eq(large.merge_with(Map::new(), joined), large);
  assert_eq(Map::new().merge_with(large, joined), large)
}

test "merge_by is asked about a key of either map, with what each holds" {
  let stock = Map::of_entries([{ key: "nut", value: 3 }, { key: "bolt", value: 5 }]);
  let prices = Map::of_entries([{ key: "nut", value: "0.10" }, { key: "gear", value: "2.00" }]);
  let told = stock.merge_by(prices, |name: String, n: Option<Int>, price: Option<String>|
    match n {
      None -> Some(name ++ ": none held"),
      Some(n) -> match price {
        None -> None,
        Some(price) -> Some(n.to_string() ++ " at " ++ price),
      },
    });
  assert_eq(told.entries(), [
    { key: "gear", value: "gear: none held" },
    { key: "nut", value: "3 at 0.10" },
  ])
}

test "union, intersection and difference keep the first map's values" {
  let a = Map::of_entries([
    { key: 1, value: "a1" },
    { key: 2, value: "a2" },
    { key: 3, value: "a3" },
  ]);
  let b = Map::of_entries([{ key: 3, value: 30 }, { key: 4, value: 40 }]);
  let c = Map::of_entries([{ key: 3, value: "c3" }, { key: 4, value: "c4" }]);
  assert_eq(a.union(c).entries(), [
    { key: 1, value: "a1" },
    { key: 2, value: "a2" },
    { key: 3, value: "a3" },
    { key: 4, value: "c4" },
  ]);
  assert_eq(a.intersection(b).entries(), [{ key: 3, value: "a3" }]);
  assert_eq(b.intersection(a).entries(), [{ key: 3, value: 30 }]);
  assert_eq(a.difference(b).entries(), [{ key: 1, value: "a1" }, { key: 2, value: "a2" }]);
  assert_eq(b.difference(a).entries(), [{ key: 4, value: 40 }]);
  assert_eq(a.difference(a), Map::new());
  assert_eq(a.intersection(a), a)
}

test "diff tells what was added, what was removed and what changed" {
  let before = Map::of_entries([
    { key: "a", value: 1 },
    { key: "b", value: 2 },
    { key: "c", value: 3 },
  ]);
  let after = Map::of_entries([
    { key: "b", value: 2 },
    { key: "c", value: 30 },
    { key: "d", value: 4 },
  ]);
  let told = before.diff(after);
  assert_eq(told.added.entries(), [{ key: "d", value: 4 }]);
  assert_eq(told.removed.entries(), [{ key: "a", value: 1 }]);
  assert_eq(told.changed.entries(), [{ key: "c", value: { before: 3, after: 30 } }]);
  let same = before.diff(before);
  assert(same.added.is_empty() && same.removed.is_empty() && same.changed.is_empty())
}

test "from_entries_with combines the values of one key in the order they came" {
  let seen = [
    { key: "b", value: "1" },
    { key: "a", value: "2" },
    { key: "b", value: "3" },
    { key: "b", value: "4" },
  ];
  assert_eq(Map::from_entries_with(seen, joined).entries(), [
    { key: "a", value: "2" },
    { key: "b", value: "1+3+4" },
  ]);
  assert_eq(Map::from_entries_with([], joined), Map::new())
}

test "fold, map, filter, partition, count, any and all read every entry in key order" {
  let m = lettered();
  assert_eq(
    m.fold("", |acc: String, key: String, value: Int| acc ++ key ++ value.to_string()),
    "b2d4f6",
  );
  assert_eq(m.map(|n: Int| n * 10).entries(), [
    { key: "b", value: 20 },
    { key: "d", value: 40 },
    { key: "f", value: 60 },
  ]);
  assert_eq(m.filter(|key: String, n: Int| key != "d" && n > 2).keys(), ["f"]);
  let parted = m.partition(|_key: String, n: Int| n < 5);
  assert_eq(parted.yes.keys(), ["b", "d"]);
  assert_eq(parted.no.keys(), ["f"]);
  assert_eq(m.count(|_key: String, n: Int| n > 2), 2);
  assert(m.any(|key: String, _n: Int| key == "f"));
  assert(!m.any(|_key: String, n: Int| n > 6));
  assert(m.all(|_key: String, n: Int| n % 2 == 0));
  assert(!m.all(|key: String, _n: Int| key != "f"));
  assert(!Map::new().any(|_key: String, _n: Int| true));
  assert(Map::new().all(|_key: String, _n: Int| false))
}

fn positive(key: String, value: Int) -> Bool / {abort.raise} = {
  assert(value > 0, Some(key));
  true
}

test "a function handed to a walk may raise, as the walk then may" {
  let m = lettered();
  assert(m.all(positive));
  assert(m.any(positive));
  assert_eq(m.count(positive), 3);
  assert_eq(m.filter(positive).size(), 3);
  assert_eq(m.partition(positive).yes.size(), 3);
  assert_eq(
    m.fold(0, |sum: Int, key: String, value: Int|
      if positive(key, value) { sum + value } else { sum }),
    12,
  );
  assert_eq(m.map(|value: Int| if positive("", value) { value + 1 } else { value }).values(), [
    3,
    5,
    7,
  ])
}

test "the ends and the neighbours of a key are read off the key order" {
  let m = lettered();
  assert_eq(m.first(), Some({ key: "b", value: 2 }));
  assert_eq(m.last(), Some({ key: "f", value: 6 }));
  assert_eq(m.floor("d"), Some({ key: "d", value: 4 }));
  assert_eq(m.floor("e"), Some({ key: "d", value: 4 }));
  assert_eq(m.floor("a"), None);
  assert_eq(m.ceiling("d"), Some({ key: "d", value: 4 }));
  assert_eq(m.ceiling("c"), Some({ key: "d", value: 4 }));
  assert_eq(m.ceiling("g"), None);
  assert_eq(m.below("d"), Some({ key: "b", value: 2 }));
  assert_eq(m.below("b"), None);
  assert_eq(m.above("d"), Some({ key: "f", value: 6 }));
  assert_eq(m.above("f"), None);
  let none: Map<String, Int> = Map::new();
  assert_eq(none.first(), None);
  assert_eq(none.last(), None);
  assert_eq(none.floor("a"), None);
  assert_eq(none.above("a"), None)
}

test "a pop answers an end's entry beside the map without it" {
  let m = lettered();
  assert_eq(m.pop_first(), Some({ key: "b", value: 2, rest: m.remove("b") }));
  assert_eq(m.pop_last(), Some({ key: "f", value: 6, rest: m.remove("f") }));
  let none: Map<String, Int> = Map::new();
  assert_eq(none.pop_first(), None);
  assert_eq(none.pop_last(), None);
  assert_eq(
    Map::of_entries([{ key: 1, value: 1 }]).pop_first(),
    Some({ key: 1, value: 1, rest: Map::new() }),
  )
}

test "a range counts a bound's own key or leaves it out, as the bound says" {
  let m = numbered(10);
  let ks = |lo: Bound<Int>, hi: Bound<Int>| m.between(lo, hi).keys();
  assert_eq(m.entries_between(Included(3), Included(5)), [
    { key: 3, value: 30 },
    { key: 4, value: 40 },
    { key: 5, value: 50 },
  ]);
  assert_eq(ks(Included(3), Included(5)), [3, 4, 5]);
  assert_eq(ks(Excluded(3), Included(5)), [4, 5]);
  assert_eq(ks(Included(3), Excluded(5)), [3, 4]);
  assert_eq(ks(Excluded(3), Excluded(5)), [4]);
  assert_eq(ks(Unbounded, Excluded(2)), [0, 1]);
  assert_eq(ks(Included(8), Unbounded), [8, 9]);
  assert_eq(ks(Unbounded, Unbounded), m.keys());
  assert_eq(ks(Included(5), Included(3)), []);
  assert_eq(ks(Excluded(4), Excluded(4)), []);
  assert_eq(ks(Included(4), Included(4)), [4]);
  assert_eq(ks(Included(-5), Included(100)), m.keys());
  assert_eq(ks(Included(20), Unbounded), []);
  assert_eq(m.entries_between_take(Excluded(3), Unbounded, 2), [
    { key: 4, value: 40 },
    { key: 5, value: 50 },
  ]);
  assert_eq(m.entries_between_take(Unbounded, Unbounded, 0), []);
  assert_eq(m.entries_between_take(Unbounded, Unbounded, -3), []);
  assert_eq(m.entries_between_take(Unbounded, Unbounded, 99).len(), 10)
}

test "a split parts a map at a key it holds or lacks" {
  let m = numbered(100);
  let held = m.split(40);
  assert_eq(held.below.size(), 40);
  assert_eq(held.at, Some(400));
  assert_eq(held.above.size(), 59);
  assert_eq(held.above.first(), Some({ key: 41, value: 410 }));
  assert_eq(held.below.last(), Some({ key: 39, value: 390 }));
  let lacked = m.remove(40).split(40);
  assert_eq(lacked.below.size(), 40);
  assert_eq(lacked.at, None);
  assert_eq(lacked.above.size(), 59);
  let under = m.split(-1);
  assert(under.below.is_empty());
  assert_eq(under.above, m);
  let over = m.split(100);
  assert_eq(over.below, m);
  assert(over.above.is_empty())
}

test "an ordered query makes the same on a map of a hundred entries and of a hundred thousand, and walks only down the tree" {
  let cost = |n: Int| {
    let m = numbered(n);
    let spent = metered(||
      {
        first: m.first(),
        last: m.last(),
        floor: m.floor(n / 2),
        ceiling: m.ceiling(n / 2),
        below: m.below(n / 2),
        above: m.above(n / 2),
        page: m.entries_between_take(Included(n / 3), Unbounded, 10),
      });
    { steps: spent.steps, allocations: spent.allocations }
  };
  let small = cost(100);
  let large = cost(100000);
  assert_eq(large.allocations, small.allocations);
  assert(small.allocations <= 40, Some(small.allocations.to_string()));
  // A thousand times the entries is two levels more of the tree, each a walk of a branch at most.
  assert(large.steps <= 4 * small.steps, Some(large.steps.to_string()))
}

/// The keys popped from the front of `m`, each read once, in a loop that holds the map alone.
fn drained(m: Map<Int, Int>, left: Int, sum: Int) -> Int =
  if left <= 0 { sum } else {
    match m.pop_first() {
      None -> sum,
      Some(popped) -> drained(popped.rest, left - 1, sum + popped.key),
    }
  }

test "a pop of a map nothing else holds copies none of it" {
  let cost = |n: Int| {
    let built = metered(|| numbered(n).size()).allocations;
    metered(|| drained(numbered(n), n, 0)).allocations - built
  };
  // Each pop makes at most its answer, a record and its `Some`, so four times the pops cost four
  // times as much; a copy of the map would cost more the more it holds.
  assert(cost(1000) <= 2 * 1000, Some(cost(1000).to_string()));
  assert_eq(cost(4000), 4 * cost(1000))
}

test "a split of a map nothing else holds makes a node for each level it cuts" {
  let cost = |n: Int| {
    let built = metered(|| numbered(n).size()).allocations;
    metered(|| numbered(n).split(n / 2).below.size()).allocations - built
  };
  assert(cost(100) <= 8, Some(cost(100).to_string()));
  assert(cost(100000) <= 12, Some(cost(100000).to_string()))
}

test "merge_with takes the steps of the smaller map, whichever side it is on" {
  let small = numbered(8);
  let steps = |n: Int| {
    let large = numbered(n);
    metered(|| large.merge_with(small, |x: Int, y: Int| x + y).size()).steps
      + metered(|| small.merge_with(large, |x: Int, y: Int| x + y).size()).steps
  };
  // Five times the entries, in a tree two levels of branches deep either way.
  assert_eq(steps(1000), steps(5000))
}

/// A map and a key, each brought near zero so the key is often one the map holds.
type Probe = { m: Map<Int, String>, key: Int }

/// A map, two bounds and a limit, brought near zero as a `Probe` is.
type Window = { m: Map<Int, String>, lo: Bound<Int>, hi: Bound<Int>, limit: Int }

type Pair = { a: Map<Int, String>, b: Map<Int, String> }

/// The map with each key brought within eight of zero, a later entry of a key standing.
fn near(m: Map<Int, String>) -> Map<Int, String> =
  m.fold(Map::new(), |acc: Map<Int, String>, key: Int, value: String| acc.insert(key % 8, value))

fn near_bound(bound: Bound<Int>) -> Bound<Int> =
  match bound {
    Included(key) -> Included(key % 8),
    Excluded(key) -> Excluded(key % 8),
    Unbounded -> Unbounded,
  }

/// The entries whose keys `ok` keeps, by a walk of every entry.
fn kept<v>(m: Map<Int, v>, ok: (Int) -> Bool) -> List<{ key: Int, value: v }> =
  m.entries().partition(|entry: { key: Int, value: v }| ok(entry.key)).yes

fn within(lo: Bound<Int>, hi: Bound<Int>, key: Int) -> Bool =
  (match lo { Included(least) -> least <= key, Excluded(least) -> least < key, Unbounded -> true })
    && (match hi { Included(most) -> key <= most, Excluded(most) -> key < most, Unbounded -> true })

/// `Map::merge_with` over association lists: each entry of `xs` with what `ys` holds under its key,
/// then what `ys` alone holds, in key order.
fn merged_lists(
  xs: List<{ key: Int, value: String }>,
  ys: List<{ key: Int, value: String }>,
) -> List<{ key: Int, value: String }> =
  xs.flat_map(|x: { key: Int, value: String }|
    [
      match ys.find(|y: { key: Int, value: String }| y.key == x.key) {
        Some(y) -> { key: x.key, value: joined(x.value, y.value) },
        None -> x,
      },
    ]).concat(
    ys.partition(|y: { key: Int, value: String }|
      !xs.any(|x: { key: Int, value: String }| x.key == y.key)).yes,
  ).sort_by(|p: { key: Int, value: String }, q: { key: Int, value: String }| p.key <= q.key)

/// A `Probe` as a test draws one.
fn probes() -> gen::Gen<Probe> =
  gen::map2(
    gen::map_of(gen::any_int(), gen::text()),
    gen::any_int(),
    |m: Map<Int, String>, key: Int| { m: m, key: key },
  )

/// A `Window` as a test draws one.
fn windows() -> gen::Gen<Window> =
  gen::map4(
    gen::map_of(gen::any_int(), gen::text()),
    gen::one_of([
      gen::map(gen::any_int(), |f0: Int| Included(f0)),
      gen::map(gen::any_int(), |f0: Int| Excluded(f0)),
      gen::constant(Unbounded),
    ]),
    gen::one_of([
      gen::map(gen::any_int(), |f0: Int| Included(f0)),
      gen::map(gen::any_int(), |f0: Int| Excluded(f0)),
      gen::constant(Unbounded),
    ]),
    gen::any_int(),
    |m: Map<Int, String>, lo: Bound<Int>, hi: Bound<Int>, limit: Int|
      { m: m, lo: lo, hi: hi, limit: limit },
  )

/// A `Pair` as a test draws one.
fn pairs() -> gen::Gen<Pair> =
  gen::map2(
    gen::map_of(gen::any_int(), gen::text()),
    gen::map_of(gen::any_int(), gen::text()),
    |a: Map<Int, String>, b: Map<Int, String>| { a: a, b: b },
  )

test "a range is the entries within its bounds" {
  gen::check(windows(), |x: Window|
    agrees(
      |w: Window| near(w.m).entries_between(near_bound(w.lo), near_bound(w.hi)),
      |w: Window| kept(near(w.m), |key: Int| within(near_bound(w.lo), near_bound(w.hi), key)),
      x,
    ))
}

test "a split is the entries below the key, the value under it and the entries above it" {
  gen::check(probes(), |x: Probe|
    agrees(
      |q: Probe| near(q.m).split(q.key % 8),
      |q: Probe|
        {
          below: Map::of_entries(kept(near(q.m), |key: Int| key < q.key % 8)),
          at: near(q.m).get(q.key % 8),
          above: Map::of_entries(kept(near(q.m), |key: Int| key > q.key % 8)),
        },
      x,
    ))
}

test "merge_with is the merge of the two association lists" {
  gen::check(pairs(), |x: Pair|
    agrees(
      |p: Pair| near(p.a).merge_with(near(p.b), joined).entries(),
      |p: Pair| merged_lists(near(p.a).entries(), near(p.b).entries()),
      x,
    ))
}

test "union, intersection and difference are the entries of the first map the second map says" {
  gen::check(pairs(), |x: Pair|
    agrees(
      |p: Pair|
        {
          union: near(p.a).union(near(p.b)).entries(),
          intersection: near(p.a).intersection(near(p.b)).entries(),
          difference: near(p.a).difference(near(p.b)).entries(),
        },
      |p: Pair|
        {
          union: near(p.b).merge(near(p.a)).entries(),
          intersection: kept(near(p.a), |key: Int| near(p.b).contains(key)),
          difference: kept(near(p.a), |key: Int| !near(p.b).contains(key)),
        },
      x,
    ))
}
