    {
      what: "A.5, white space, comments and other oddities",
      text: oddities(),
      defects: [],
      field_values: [
        "from Pete <pete@silly.test>",
        "to A Group:Chris Jones <c@public.example>, joe@example.org, John <jdoe@one.test>;",
        "cc Hidden recipients:;",
        "date 1969-02-13T23:32:00-03:30",
        "id <testabcd.1234@silly.test>",
        "text Testing.\n",
      ],
    },
    {
      what: "A.6.1, obsolete addressing",
      text: obsolete_addressing(),
      defects: [ObsoleteSyntax, ObsoleteSyntax],
      field_values: [
        "from \"Joe Q. Public\" <john.q.public@example.com>",
        "to Mary Smith <mary@example.net>, jdoe@test.example",
        "date 2003-07-01T10:52:37+02:00",
        "id <5678.21-Nov-1997@example.com>",
        "text Hi everyone.\n",
      ],
    },
    {
      what: "A.6.2, obsolete dates",
      text: obsolete_dates(),
      defects: [ObsoleteSyntax],
      field_values: [
        "from John Doe <jdoe@machine.example>",
        "to Mary Smith <mary@example.net>",
        "subject Saying Hello",
        "date 1997-11-21T09:55:06Z",
        "id <1234@local.machine.example>",
        hello(),
      ],
    },
    {
      what: "A.6.3, obsolete white space and comments",
      text: obsolete_white_space().replace("__", "  "),
      defects: [
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
      ],
      field_values: [
        "from John Doe <jdoe@machine.example>",
        "to Mary Smith <mary@example.net>",
        "subject Saying Hello",
        "date 1997-11-21T09:55:06-06:00",
        "id <1234@local.machine.example>",
        hello(),
      ],
    },
    {
      what: "the fields of RFC 2047's example",
      text: encoded_names(),
      defects: [Missing("date")],
      field_values: [
        "from Keith Moore <moore@cs.utk.edu>",
        "to Keld J\u{f8}rn Simonsen <keld@dkuug.dk>",
        "cc Andr\u{e9} Pirard <PIRARD@vm1.ulg.ac.be>",
        "subject If you can read this you understand the example.",
      ],
    },
  ]

test "`read_tolerant` on {c.what} returns the expected defects and field values, `render` writes the message back unchanged, and `parse` succeeds only if there are no defects" for c: Example in examples(
  ) {
  let data = crlf_text(c.text);
  let read = read_tolerant(data, default_limits());
  assert_eq(read.defects.map(|d: Error| d.reason), c.defects);
  assert_eq(reader_summary(read.message), c.field_values);
  assert_eq(render(read.message), data);
  assert_eq(parse(data, default_limits()).is_ok(), c.defects.len() == 0)
}

test "a field's raw text keeps its original line breaks and spacing, while its value joins the folded lines into one line" {
  let m = read(crlf_text(received_example()), default_limits());
  assert_eq(headers(m, "received"), [
    "from x.y.test   by example.net   via TCP   with ESMTP   id ABC12345   for <mary@example.net>;  21 Nov 1997 10:05:43 -0600",
    "from node.example by x.y.test; 21 Nov 1997 10:01:22 -0600",
  ]);
  assert_eq(header(m, "RECEIVED"), headers(m, "Received").at(0));
  assert_eq(header(m, "x-none"), None);
  assert_eq(
    fields(m).first().map(|f: Field| f.raw),
    Some(
      b"Received: from x.y.test\r\n   by example.net\r\n   via TCP\r\n   with ESMTP\r\n   id ABC12345\r\n   for <mary@example.net>;  21 Nov 1997 10:05:43 -0600\r\n",
    ),
  );
  assert_eq(fields(m).map(|f: Field| f.name), [
    "Received",
    "Received",
    "From",
    "To",
    "Subject",
    "Date",
    "Message-ID",
  ]);
  assert_eq(body(m), b"This is a message just to say hello.\r\nSo, \"Hello\".\r\n");
  let again = read(crlf_text(resent()), default_limits());
  assert_eq(header(again, "Resent-Message-ID"), Some("<78910@example.net>"));
  assert_eq(
    parse_address_list(match header(again, "resent-to") { Some(v) -> v, None -> "" }).map(
      address_list_text,
    ),
    Ok("Jane Brown <j-brown@other.example>"),
  )
}

fn required_fields() -> String = "Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: a@example.org\r\n"

fn message_of(extra: String, payload: Bytes) -> Bytes =
  Bytes::concat_all([
    Bytes::of_string(required_fields()),
    Bytes::of_string(extra),
    b"\r\n",
    payload,
  ])

type DefectCase = { what: String, data: Bytes, utf8: Bool, defects: List<Error> }

fn defect_case(what: String, extra: String, payload: Bytes, defects: List<Error>) -> DefectCase =
  { what: what, data: message_of(extra, payload), utf8: false, defects: defects }

fn defect_cases() -> List<DefectCase> =
  [
    {
      what: "a missing blank line",
      data: Bytes::of_string(required_fields()).concat(b"The body starts here: at once.\r\n"),
      utf8: false,
      defects: [{ at: 60, reason: NoBlankLine }],
    },
    {
      what: "a header with no colon",
      data: Bytes::of_string(required_fields()).concat(
        b"Subject hello\r\nTo: b@example.org\r\n\r\nbody\r\n",
      ),
      utf8: false,
      defects: [{ at: 60, reason: NoBlankLine }],
    },
    {
      what: "a continuation before any field",
      data: b" folded\r\n".concat(Bytes::of_string(required_fields())),
      utf8: false,
      defects: [
        { at: 0, reason: NoBlankLine },
        { at: 0, reason: Missing("date") },
        { at: 0, reason: Missing("from") },
      ],
    },
    {
      what: "bare line feeds",
      data: b"Date: Fri, 21 Nov 1997 09:55:06 -0600\nFrom: a@example.org\n\nbody\nmore\n",
      utf8: false,
      defects: [{ at: 37, reason: BareLineFeed }, { at: 63, reason: BareLineFeed }],
    },
    defect_case("a bare carriage return in the body", "", b"bo\rdy\r\n", [
      { at: 64, reason: BareCarriageReturn },
    ]),
    defect_case("a bare carriage return in a field", "Subject: a\rb\r\n", b"", [
      { at: 70, reason: BareCarriageReturn },
    ]),
    defect_case("an unterminated quoted string", "To: \"unclosed <b@example.org>\r\n", b"", [
      { at: 60, reason: Unclosed },
    ]),
    defect_case(
      "a boundary never closed",
      "Content-Type: multipart/mixed; boundary=b\r\n",
      b"--b\r\n\r\none\r\n--b\r\n\r\ntwo\r\n",
      [{ at: 129, reason: UnclosedBoundary }],
    ),
    defect_case("a line over 998 octets", "", b"x".repeat(999).concat(b"\r\n"), [
      { at: 62 + 998, reason: LongLine },
    ]),
    defect_case("a header line over 998 octets", "X-Long: " ++ "x".repeat(991) ++ "\r\n", b"", [
      { at: 60 + 998, reason: LongLine },
    ]),
    defect_case("8-bit bytes in a header", "Subject: caf\u{e9}\r\n", b"", [
      { at: 60 + 12, reason: EightBitHeader },
    ]),
    {
      what: "bytes that are no UTF-8 in a header that may hold UTF-8",
      data: Bytes::concat_all([Bytes::of_string(required_fields()), b"Subject: caf\xe9\r\n\r\n"]),
      utf8: true,
      defects: [{ at: 60 + 12, reason: EightBitHeader }],
    },
    defect_case("a bad encoded word", "Subject: =?x-unknown?Q?a?= b\r\n", b"", [
      { at: 60, reason: BadEncodedWord },
    ]),
    defect_case(
      "an encoded word that carries a line break",
      "Subject: =?UTF-8?Q?a=0D=0ABcc:_x?=\r\n",
      b"",
      [{ at: 60, reason: BadEncodedWord }],
    ),
    defect_case("a control character in a field", "Subject: a\0b\r\n", b"", [
      { at: 70, reason: Control },
    ]),
    {
      what: "no date and no author",
      data: b"Subject: x\r\n\r\n",
      utf8: false,
      defects: [{ at: 0, reason: Missing("date") }, { at: 0, reason: Missing("from") }],
    },
    defect_case("a second author field", "From: b@example.org\r\n", b"", [
      { at: 60, reason: Repeated("from") },
    ]),
    defect_case("a group for an author", "Subject: x\r\nFrom: Team:b@example.org;\r\n", b"", [
      { at: 72, reason: Repeated("from") },
      { at: 72, reason: Unexpected },
    ]),
    {
      what: "a field that ends the message with no line break",
      data: b"Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: a@example.org",
      utf8: false,
      defects: [{ at: 58, reason: Truncated }],
    },
    {
      what: "a date that is none",
      data: b"Date: yesterday\r\nFrom: a@example.org\r\n\r\n",
      utf8: false,
      defects: [{ at: 0, reason: BadDate }],
    },
    defect_case(
      "a message identifier with no brackets",
      "Message-ID: 1234@example.org\r\n",
      b"",
      [{ at: 60, reason: BadMessageId }],
    ),
    defect_case("two message identifiers for one message", "Message-ID: <a@b> <c@d>\r\n", b"", [
      { at: 60, reason: BadMessageId },
    ]),
    defect_case("references that name nothing", "References: (none)\r\n", b"", [
      { at: 60, reason: BadMessageId },
    ]),
    defect_case("a media type that is none", "Content-Type: text\r\n", b"x", [
      { at: 60, reason: BadMediaType },
    ]),
    defect_case(
      "a parameter whose sections do not count from zero",
      "Content-Type: text/plain; name*1=x\r\n",
      b"x",
      [{ at: 60, reason: BadMediaType }],
    ),
    defect_case(
      "a second media type",
      "Content-Type: text/plain\r\nContent-Type: text/html\r\n",
      b"x",
      [{ at: 86, reason: Repeated("content-type") }],
    ),
    defect_case(
      "a disposition that does not read",
      "Content-Disposition: attachment; filename\r\n",
      b"x",
      [{ at: 60, reason: BadDisposition }],
    ),
    defect_case(
      "a transfer encoding nobody names",
      "Content-Transfer-Encoding: uuencode\r\n",
      b"x",
      [{ at: 60, reason: BadEncoding("uuencode") }],
    ),
    defect_case(
      "a body that is not the base64 it says",
      "Content-Transfer-Encoding: base64\r\n",
      b"!!!!",
      [{ at: 60 + 37, reason: BadTransferData }],
    ),
    defect_case(
      "a body that is not the quoted-printable it says",
      "Content-Transfer-Encoding: quoted-printable\r\n",
      b"a=ZZ",
      [{ at: 60 + 47, reason: BadTransferData }],
    ),
    defect_case("an 8-bit byte in a body that names no encoding", "", b"caf\xe9\r\n", [
      { at: 65, reason: Undeclared8Bit },
    ]),
    defect_case(
      "a multipart body under an encoding",
      "Content-Type: multipart/mixed; boundary=b\r\nContent-Transfer-Encoding: base64\r\n",
      b"--b--\r\n",
      [{ at: 103, reason: BadEncoding("base64") }],
    ),
    defect_case(
      "a multipart body with no boundary named",
      "Content-Type: multipart/mixed\r\n",
      b"--b--\r\n",
      [{ at: 93, reason: BadMultipart(multipart::NoBoundary) }],
    ),
    defect_case(
      "a delimiter that goes on as text",
      "Content-Type: multipart/mixed; boundary=b\r\n",
      b"--bx\r\n\r\none\r\n--b--\r\n",
      [{ at: 108, reason: BadMultipart(multipart::BadDelimiter) }],
    ),
    defect_case("an obsolete blank before a colon", "Subject : x\r\n", b"", [
      { at: 60, reason: ObsoleteSyntax },
    ]),
    defect_case("a folded line of blanks alone", "Subject: x\r\n \t\r\n y\r\n", b"", [
      { at: 72, reason: ObsoleteSyntax },
    ]),
  ]

test "lists the defects of {c.what}" for c: DefectCase in defect_cases() {
  let repertoire = if c.utf8 { Utf8 } else { Ascii };
  let read = read_tolerant(c.data, default_limits(), repertoire);
  assert_eq(read.defects, c.defects);
  assert_eq(render(read.message), c.data);
  assert_eq(parse(c.data, default_limits(), repertoire).map(render), match c.defects {
    [found, ..] -> Err(found),
    [] -> Ok(c.data),
  })
}

type LimitCase = { what: String, data: Bytes, limits: Limits, at: Int, reason: ErrorKind }

fn tight() -> Limits =
  { max_bytes: 400, max_fields: 3, max_header_bytes: 120, max_depth: 1, max_parts: 2 }

fn two_deep() -> Bytes =
  message_of(
    "Content-Type: multipart/mixed; boundary=a\r\n",
    b"--a\r\nContent-Type: multipart/mixed; boundary=b\r\n\r\n--b\r\n\r\ndeep\r\n--b--\r\n--a--\r\n",
  )

fn three_parts() -> Bytes =
  message_of(
    "Content-Type: multipart/mixed; boundary=a\r\n",
    b"--a\r\n\r\n1\r\n--a\r\n\r\n2\r\n--a\r\n\r\n3\r\n--a--\r\n",
  )

fn limit_cases() -> List<LimitCase> =
  [
    {
      what: "a message longer than the limit",
      data: message_of("", b"x".repeat(400)),
      limits: tight(),
      at: 400,
      reason: TooLarge,
    },
    {
      what: "a header field more than the limit",
      data: message_of("Subject: x\r\nTo: b@example.org\r\n", b""),
      limits: tight(),
      at: 72,
      reason: TooManyFields,
    },
    {
      what: "a header block longer than the limit",
      data: message_of("Subject: " ++ "x".repeat(100) ++ "\r\n", b""),
      limits: tight(),
      at: 120,
      reason: HeadersTooLarge,
    },
    {
      what: "a header block with no end",
      data: Bytes::of_string(required_fields() ++ "Subject: ").concat(b"x".repeat(300)),
      limits: tight(),
      at: 120,
      reason: HeadersTooLarge,
    },
    {
      what: "parts nested deeper than the limit",
      data: two_deep(),
      limits: tight(),
      at: 110,
      reason: TooDeep,
    },
    {
      what: "any multipart body where none may nest",
      data: three_parts(),
      limits: { ..tight(), max_depth: 0 },
      at: 0,
      reason: TooDeep,
    },
    {
      what: "a part more than the limit",
      data: three_parts(),
      limits: tight(),
      at: 130,
      reason: TooManyParts,
    },
    {
      what: "a nested part more than the limit",
      data: two_deep(),
      limits: { ..tight(), max_depth: 2, max_parts: 1 },
      at: 160,
      reason: TooManyParts,
    },
    {
      what: "a header field more than the limit in a part",
      data: message_of(
        "Content-Type: multipart/mixed; boundary=a\r\n",
        b"--a\r\nA: 1\r\nB: 2\r\nC: 3\r\nD: 4\r\n\r\n\r\n--a--\r\n",
      ),
      limits: tight(),
      at: 128,
      reason: TooManyFields,
    },
  ]

test "`parse` and `parse_tolerant` both fail with the expected position and reason on a message that exceeds the limit for {c.what}" for c: LimitCase in limit_cases(
  ) {
  assert_eq(parse(c.data, c.limits).map(render), Err({ at: c.at, reason: c.reason }));
  assert_eq(
    parse_tolerant(c.data, c.limits).map(|t: MessageWithDefects| t.defects),
    Err({ at: c.at, reason: c.reason }),
  )
}

test "`parse` accepts a message exactly at each size limit, and treats a negative limit as zero" {
  let limits: Limits = tight();
  assert(parse(message_of("", b"x".repeat(338)), limits).is_ok());
  assert(parse(message_of("Subject: x\r\n", b""), limits).is_ok());
  assert(parse(message_of("Subject: " ++ "x".repeat(47) ++ "\r\n", b""), limits).is_ok());
  assert(parse(two_deep(), { ..limits, max_depth: 2 }).is_ok());
  assert(parse(three_parts(), { ..limits, max_parts: 3 }).is_ok());
  assert_eq(
    parse(b"", { ..limits, max_bytes: -1 }).map(render),
    Err({ at: 0, reason: Missing("date") }),
  );
  assert_eq(parse(b"x", { ..limits, max_bytes: -1 }).map(render), Err({ at: 0, reason: TooLarge }));
  assert_eq(
    parse(message_of("", b""), { ..limits, max_fields: -1 }).map(render),
    Err({ at: 0, reason: TooManyFields }),
  )
}

fn sample_message() -> String =
  \\From: Nathaniel Borenstein <nsb@bellcore.com>
  \\To: Ned Freed <ned@innosoft.com>
  \\Date: Sun, 21 Mar 1993 23:56:48 -0800 (PST)
  \\Subject: Sample message
  \\MIME-Version: 1.0
  \\Content-type: multipart/mixed; boundary="simple boundary"
  \\
  \\This is the preamble.  It is to be ignored, though it
  \\is a handy place for composition agents to include an
  \\explanatory note to non-MIME conformant readers.
  \\
  \\--simple boundary
  \\
  \\This is implicitly typed plain US-ASCII text.
  \\It does NOT end with a linebreak.
  \\--simple boundary
  \\Content-type: text/plain; charset=us-ascii
  \\
  \\This is explicitly typed plain US-ASCII text.
  \\It DOES end with a linebreak.
  \\
  \\--simple boundary--
  \\
  \\This is the epilogue.  It is also to be ignored.

fn formatted_text_mail() -> String =
  \\From: Nathaniel Borenstein <nsb@bellcore.com>
  \\To: Ned Freed <ned@innosoft.com>
  \\Date: Mon, 22 Mar 1993 09:41:09 -0800 (PST)
  \\Subject: Formatted text mail
  \\MIME-Version: 1.0
  \\Content-Type: multipart/alternative; boundary=boundary42
  \\
  \\--boundary42
  \\Content-Type: text/plain; charset=us-ascii
  \\
  \\  ... plain text version of message goes here ...
  \\
  \\--boundary42
  \\Content-Type: text/enriched
  \\
  \\  ... RFC 1896 text/enriched version of same message
  \\      goes here ...
  \\
  \\--boundary42
  \\Content-Type: application/x-whatever
  \\
  \\  ... fanciest version of same message goes here ...
  \\
  \\--boundary42--

fn complex_multipart() -> String =
  \\MIME-Version: 1.0
  \\From: Nathaniel Borenstein <nsb@nsb.fv.com>
  \\To: Ned Freed <ned@innosoft.com>
  \\Date: Fri, 07 Oct 1994 16:15:05 -0700 (PDT)
  \\Subject: A multipart example
  \\Content-Type: multipart/mixed;
  \\              boundary=unique-boundary-1
  \\
  \\This is the preamble area of a multipart message.
  \\Mail readers that understand multipart format
  \\should ignore this preamble.
  \\
  \\If you are reading this text, you might want to
  \\consider changing to a mail reader that understands
  \\how to properly display multipart messages.
  \\
  \\--unique-boundary-1
  \\
  \\  ... Some text appears here ...
  \\
  \\[Note that the blank between the boundary and the start
  \\ of the text in this part means no header fields were
  \\ given and this is text in the US-ASCII character set.
  \\ It could have been done with explicit typing as in the
  \\ next part.]
  \\
  \\--unique-boundary-1
  \\Content-type: text/plain; charset=US-ASCII
  \\
  \\This could have been part of the previous part, but
  \\illustrates explicit versus implicit typing of body
  \\parts.
  \\
  \\--unique-boundary-1
  \\Content-Type: multipart/parallel; boundary=unique-boundary-2
  \\
  \\--unique-boundary-2
  \\Content-Type: audio/basic
  \\
  \\Content-Transfer-Encoding: base64
  \\
  \\  ... base64-encoded 8000 Hz single-channel
  \\      mu-law-format audio data goes here ...
  \\
  \\--unique-boundary-2
  \\Content-Type: image/jpeg
  \\Content-Transfer-Encoding: base64
  \\
  \\  ... base64-encoded image data goes here ...
  \\
  \\--unique-boundary-2--
  \\
  \\--unique-boundary-1
  \\Content-type: text/enriched
  \\
  \\This is <bold><italic>enriched.</italic></bold>
  \\<smaller>as defined in RFC 1896</smaller>
  \\
  \\Isn't it
  \\<bigger><bigger>cool?</bigger></bigger>
  \\
  \\--unique-boundary-1
  \\Content-Type: message/rfc822
  \\
  \\From: (mailbox in US-ASCII)
  \\To: (address in US-ASCII)
  \\Subject: (subject in US-ASCII)
  \\Content-Type: Text/plain; charset=ISO-8859-1
  \\Content-Transfer-Encoding: Quoted-printable
  \\
  \\  ... Additional text in ISO-8859-1 goes here ...
  \\
  \\--unique-boundary-1--

fn leaf_types(m: Message) -> List<String> / {abort.raise} =
  leaves(m, []).map(|l: Leaf| show(content_type(l.part)))

test "RFC 2046's sample message is two parts between a preamble and an epilogue" {
  let m = read(crlf_text(sample_message()), default_limits());
  assert_eq(show(content_type(m)), "multipart/mixed; boundary=\"simple boundary\"");
  assert_eq(mime_version(m), Some("1.0"));
  assert_eq(parts(m).map(body), [
    b"This is implicitly typed plain US-ASCII text.\r\nIt does NOT end with a linebreak.",
    b"This is explicitly typed plain US-ASCII text.\r\nIt DOES end with a linebreak.\r\n",
  ]);
  assert_eq(leaf_types(m), ["text/plain; charset=us-ascii", "text/plain; charset=us-ascii"]);
  assert_eq(
    text_body(m),
    Some(Text("This is implicitly typed plain US-ASCII text.\nIt does NOT end with a linebreak.")),
  );
  assert_eq(html_body(m), None);
  assert_eq(attachments(m).map(|a: Attachment| a.data), [
    b"This is explicitly typed plain US-ASCII text.\r\nIt DOES end with a linebreak.\r\n",
  ]);
  assert_eq(date(m), date::parse_rfc3339("1993-03-21T23:56:48-08:00"));
  assert_eq(render(m), crlf_text(sample_message()))
}

test "for an RFC 2046 alternative message, parts are read in written order and `text_body` returns the plain text part" {
  let m = read(crlf_text(formatted_text_mail()), default_limits());
  assert_eq(leaf_types(m), [
    "text/plain; charset=us-ascii",
    "text/enriched",
    "application/x-whatever",
  ]);
  assert_eq(text_body(m), Some(Text("  ... plain text version of message goes here ...\n")));
  assert_eq(html_body(m), None);
  assert_eq(attachments(m).len(), 2);
  assert_eq(draft_of(m), None)
}

test "`read_tolerant` reads the RFC 2049 complex multipart message into its expected parts, headers and nested message" {
  let data = crlf_text(complex_multipart());
  let read = read_tolerant(data, default_limits());
  let m = read.message;
  assert_eq(read.defects.map(|d: Error| d.reason), [BadTransferData]);
  assert_eq(leaf_types(m), [
    "text/plain; charset=us-ascii",
    "text/plain; charset=US-ASCII",
    "audio/basic",
    "image/jpeg",
    "text/enriched",
    "message/rfc822",
  ]);
  assert_eq(parts(m).map(|p: Message| parts(p).len()), [0, 0, 2, 0, 0]);
  assert_eq(leaves(m, []).map(|l: Leaf| transfer_encoding(l.part)), [
    SevenBit,
    SevenBit,
    SevenBit,
    Base64,
    SevenBit,
    SevenBit,
  ]);
  assert_eq(subject(m), Some("A multipart example"));
  assert_eq(date(m), date::parse_rfc3339("1994-10-07T16:15:05-07:00"));
  let inner = read_tolerant(
    match parts(m).at(4) { Some(p) -> body(p), None -> b"" },
    default_limits(),
  ).message;
  assert_eq(subject(inner), Some("(subject in US-ASCII)"));
  assert_eq(show(content_type(inner)), "text/plain; charset=ISO-8859-1");
  assert_eq(transfer_encoding(inner), QuotedPrintable);
  assert_eq(text(inner), Text("  ... Additional text in ISO-8859-1 goes here ...\n"));
  assert_eq(render(m), data)
}

type MediaTypeCase = { fields: String, media: String }

fn media_type_cases() -> List<MediaTypeCase> =
  [
    {
      fields: "Content-type: text/plain; charset=us-ascii (Plain text)\r\n",
      media: "text/plain; charset=us-ascii",
    },
    {
      fields: "Content-type: text/plain; charset=\"us-ascii\"\r\n",
      media: "text/plain; charset=us-ascii",
    },
    {
      fields: "Content-Type: message/external-body; access-type=URL;\r\n URL*0=\"ftp://\";\r\n URL*1=\"cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar\"\r\n",
      media: "message/external-body; access-type=URL; url=\"ftp://cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar\"",
    },
    {
      fields: "Content-Type: application/x-stuff;\r\n title*=us-ascii'en-us'This%20is%20%2A%2A%2Afun%2A%2A%2A\r\n",
      media: "application/x-stuff; title=\"This is ***fun***\"",
    },
    {
      fields: "Content-Type: application/x-stuff;\r\n title*0*=us-ascii'en'This%20is%20even%20more%20;\r\n title*1*=%2A%2A%2Afun%2A%2A%2A%20;\r\n title*2=\"isn't it!\"\r\n",
      media: "application/x-stuff; title=\"This is even more ***fun*** isn't it!\"",
    },
    { fields: "", media: "text/plain; charset=us-ascii" },
    { fields: "CONTENT-TYPE: (a comment) Image/PNG (and another)\r\n", media: "image/png" },
    {
      fields: "Content-Type: text/html; title=\"a (b) c\"\r\n",
      media: "text/html; title=\"a (b) c\"",
    },
    { fields: "Content-Type: nonsense\r\n", media: "text/plain; charset=us-ascii" },
  ]

test "`content_type` returns the expected media type for a message with the header fields {show(c.fields)}" for c: MediaTypeCase in media_type_cases(
  ) {
  assert_eq(
    show(content_type(read_tolerant(message_of(c.fields, b""), default_limits()).message)),
    c.media,
  )
}

test "RFC 2045's four forms of one MIME version are the same version" {
  let version = |value: String|
    mime_version(read(message_of("MIME-Version: " ++ value ++ "\r\n", b""), default_limits()));
  assert_eq(
    [
      "1.0",
      "1.0 (produced by MetaSend Vx.x)",
      "(produced by MetaSend Vx.x) 1.0",
      "1.(produced by MetaSend Vx.x)0",
    ].map(
      version,
    ),
    [Some("1.0"), Some("1.0"), Some("1.0"), Some("1.0")],
  );
  assert_eq(mime_version(read(message_of("", b""), default_limits())), None)
}

type EncodingCase = {
  description: String,
  fields: String,
  payload: Bytes,
  content: Option<Bytes>,
  text: BodyText,
}

fn coded_bodies() -> List<EncodingCase> =
  [
    {
      description: "a body with no fields",
      fields: "",
      payload: b"plain\r\ntext\r\n",
      content: Some(b"plain\r\ntext\r\n"),
      text: Text("plain\ntext\n"),
    },
    {
      description: "quoted-printable UTF-8",
      fields: "Content-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: quoted-printable\r\n",
      payload: b"caf=C3=A9 au=\r\n lait\r\n",
      content: Some(b"caf\xc3\xa9 au lait\r\n"),
      text: Text("caf\u{e9} au lait\n"),
    },
    {
      description: "base64 in lines",
      fields: "Content-Type: text/plain; charset=UTF-8\r\nContent-Transfer-Encoding: BASE64\r\n",
      payload: b"Y2Fm\r\nw6k=\r\n",
      content: Some(b"caf\xc3\xa9"),
      text: Text("caf\u{e9}"),
    },
    {
      description: "base64 with blanks, a stray byte and no padding",
      fields: "Content-Transfer-Encoding: base64\r\n",
      payload: b" Y2 Fm!\r\n\tw6k\r\n",
      content: Some(b"caf\xc3\xa9"),
      text: Malformed(b"caf\xc3\xa9"),
    },
    {
      description: "8bit ISO-8859-1",
      fields: "Content-Type: text/plain; charset=ISO-8859-1\r\nContent-Transfer-Encoding: 8bit\r\n",
      payload: b"caf\xe9\r\n",
      content: Some(b"caf\xe9\r\n"),
      text: Text("caf\u{e9}\n"),
    },
    {
      description: "windows-1252",
      fields: "Content-Type: text/plain; charset=\"Windows-1252\"\r\nContent-Transfer-Encoding: quoted-printable\r\n",
      payload: b"=93quoted=94 =80",
      content: Some(b"\x93quoted\x94 \x80"),
      text: Text("\u{201c}quoted\u{201d} \u{20ac}"),
    },
    {
      description: "a charset this module does not read",
      fields: "Content-Type: text/plain; charset=Shift_JIS\r\nContent-Transfer-Encoding: base64\r\n",
      payload: b"k/qWe4zq",
      content: Some(b"\x93\xfa\x96\x7b\x8c\xea"),
      text: Unknown(b"\x93\xfa\x96\x7b\x8c\xea", "shift_jis"),
    },
    {
      description: "bytes that are no text in the charset named",
      fields: "Content-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: 8bit\r\n",
      payload: b"caf\xe9",
      content: Some(b"caf\xe9"),
      text: Malformed(b"caf\xe9"),
    },
    {
      description: "8-bit bytes under no charset",
      fields: "Content-Transfer-Encoding: 8bit\r\n",
      payload: b"caf\xc3\xa9",
      content: Some(b"caf\xc3\xa9"),
      text: Malformed(b"caf\xc3\xa9"),
    },
    {
      description: "a body that is not in its encoding",
      fields: "Content-Transfer-Encoding: quoted-printable\r\n",
      payload: b"a=ZZ",
      content: None,
      text: Malformed(b"a=ZZ"),
    },
    {
      description: "an encoding nobody names",
      fields: "Content-Transfer-Encoding: x-uuencode\r\n",
      payload: b"begin",
      content: None,
      text: Malformed(b"begin"),
    },
    {
      description: "line breaks of every kind",
      fields: "Content-Transfer-Encoding: binary\r\n",
      payload: b"a\r\nb\nc\r\r\nd\re",
      content: Some(b"a\r\nb\nc\r\r\nd\re"),
      text: Text("a\nb\nc\nd\re"),
    },
  ]

test "`content` returns the expected decoded bytes and `text` returns the expected string for a message with {c.description}" for c: EncodingCase in coded_bodies(
  ) {
  let m = read_tolerant(message_of(c.fields, c.payload), default_limits()).message;
  assert_eq(content(m), c.content);
  assert_eq(text(m), c.text)
}

fn mixed_message() -> String =
  \\From: =?UTF-8?Q?J=C3=BCrgen?= <j@example.org>
  \\Date: Fri, 21 Nov 1997 09:55:06 -0600
  \\MIME-Version: 1.0
  \\Content-Type: multipart/mixed; boundary="outer"
  \\
  \\--outer
  \\Content-Type: multipart/alternative; boundary=inner
  \\
  \\--inner
  \\Content-Type: text/plain; charset=utf-8
  \\Content-Transfer-Encoding: quoted-printable
  \\
  \\caf=C3=A9
  \\--inner
  \\Content-Type: multipart/related; boundary=deepest
  \\
  \\--deepest
  \\Content-Type: text/html
  \\
  \\<img src="cid:logo@example.org">
  \\--deepest
  \\Content-Type: image/png
  \\Content-Transfer-Encoding: base64
  \\Content-ID: <logo@example.org>
  \\Content-Disposition: inline; filename=logo.png
  \\
  \\iVBORw0KGgo=
  \\--deepest--
  \\--inner--
  \\--outer
  \\Content-Type: application/pdf; name="fallback.pdf"
  \\Content-Disposition: attachment;
  \\ filename*0*=UTF-8''na%C3%AFve%20;
  \\ filename*1="resume.pdf" (a comment)
  \\Content-Transfer-Encoding: base64
  \\
  \\JVBERi0xLjQ=
  \\--outer
  \\Content-Type: text/plain
  \\Content-Disposition: ATTACHMENT; filename="../../etc/passwd"
  \\
  \\root
  \\--outer--

test "a message's bodies and its attachments are found through its parts" {
  let data = crlf_text(mixed_message());
  let m = read(data, default_limits());
  assert_eq(text_body(m), Some(Text("caf\u{e9}")));
  assert_eq(html_body(m), Some(Text("<img src=\"cid:logo@example.org\">")));
  assert_eq(attachments(m).map(|a: Attachment| a.filename), [
    Some("logo.png"),
    Some("na\u{ef}ve resume.pdf"),
    Some("../../etc/passwd"),
  ]);
  assert_eq(attachments(m).map(|a: Attachment| show(a.content_type)), [
    "image/png",
    "application/pdf; name=fallback.pdf",
    "text/plain",
  ]);
  assert_eq(attachments(m).map(|a: Attachment| a.data), [
    b"\x89PNG\r\n\x1a\n",
    b"%PDF-1.4",
    b"root",
  ]);
  assert_eq(attachments(m).map(|a: Attachment| a.content_id.map(id_text)), [
    Some("<logo@example.org>"),
    None,
    None,
  ]);
  assert_eq(multipart::safe_filename("../../etc/passwd"), Some("passwd"));
  let attached = match parts(m).at(1) { Some(p) -> disposition(p), None -> None };
  assert_eq(attached, Some({ kind: "attachment", filename: Some("na\u{ef}ve resume.pdf") }));
  assert_eq(disposition(m), None);
  assert_eq(content_id(m), None);
  assert_eq(from(m).map(|a: Mailbox| display_name(a)), [Some("J\u{fc}rgen")]);
  assert_eq(render(m), data)
}

test "a single part that is not text is an attachment, and an attached text part is not a body" {
  let pdf = read(
    message_of(
      "Content-Type: application/pdf\r\nContent-Transfer-Encoding: base64\r\n",
      b"JVBERi0xLjQ=",
    ),
    default_limits(),
  );
  assert_eq(text_body(pdf), None);
  assert_eq(attachments(pdf).map(|a: Attachment| a.data), [b"%PDF-1.4"]);
  let note = read(
    message_of(
      "Content-Type: text/plain\r\nContent-Disposition: attachment; filename=note.txt\r\n",
      b"x",
    ),
    default_limits(),
  );
  assert_eq(text_body(note), None);
  assert_eq(attachments(note).map(|a: Attachment| a.filename), [Some("note.txt")]);
  let page = read(message_of("Content-Type: text/html\r\n", b"<p>x</p>"), default_limits());
  assert_eq(html_body(page), Some(Text("<p>x</p>")));
  assert_eq(text_body(page), None);
  assert_eq(attachments(page), [])
}

test "UTF-8 in a header is read when requested, and is a defect when not" {
  let data = Bytes::of_string(
    "Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: J\u{fc}rgen M\u{fc}ller <j\u{fc}rgen@b\u{fc}cher.example>\r\nTo: \u{7528}\u{6237}@\u{4f8b}\u{3048}.jp\r\nSubject: Gr\u{fc}\u{df}e aus K\u{f6}ln\r\n\r\n",
  );
  let m = read(data, default_limits(), Utf8);
  assert_eq(from(m).map(|a: Mailbox| show(a)), [
    "J\u{fc}rgen M\u{fc}ller <j\u{fc}rgen@b\u{fc}cher.example>",
  ]);
  assert_eq(address_list_text(to(m)), "\u{7528}\u{6237}@\u{4f8b}\u{3048}.jp");
  assert_eq(subject(m), Some("Gr\u{fc}\u{df}e aus K\u{f6}ln"));
  assert_eq(render(m), data);
  let plain = read_tolerant(data, default_limits());
  assert_eq(plain.defects.map(|d: Error| d.reason), [
    NonAscii,
    EightBitHeader,
    NonAscii,
    EightBitHeader,
    EightBitHeader,
  ]);
  assert_eq(from(plain.message), []);
  assert_eq(subject(plain.message), Some("Gr\u{fc}\u{df}e aus K\u{f6}ln"));
  assert_eq(parse(data, default_limits()).map(render), Err({ at: 39, reason: NonAscii }))
}

test "RFC 8058's `List-Unsubscribe` fields are read from a message, and `list_unsubscribe` writes them from a list of URLs" {
  let simple = read(
    message_of(
      "List-Unsubscribe: <https://example.com/unsubscribe/opaquepart>\r\nList-Unsubscribe-Post: List-Unsubscribe=One-Click\r\n",
      b"",
    ),
    default_limits(),
  );
  assert_eq(
    header(simple, "List-Unsubscribe"),
    Some("<https://example.com/unsubscribe/opaquepart>"),
  );
  assert_eq(header(simple, "List-Unsubscribe-Post"), Some("List-Unsubscribe=One-Click"));
  let complex = read(
    message_of(
      "List-Unsubscribe:\r\n    <mailto:listrequest@example.com?subject=unsubscribe>,\r\n    <https://example.com/unsubscribe.html?opaque=123456789>\r\nList-Unsubscribe-Post: List-Unsubscribe=One-Click\r\n",
      b"",
    ),
    default_limits(),
  );
  assert_eq(
    header(complex, "list-unsubscribe"),
    Some(
      "<mailto:listrequest@example.com?subject=unsubscribe>,    <https://example.com/unsubscribe.html?opaque=123456789>",
    ),
  );
  let d = list_unsubscribe(plain_draft(), [
    "mailto:listrequest@example.com?subject=unsubscribe",
    "https://example.com/unsubscribe.html?opaque=123456789",
  ]);
  assert_eq(d.fields.map(|f: Field| f.raw), [
    b"List-Unsubscribe: <mailto:listrequest@example.com?subject=unsubscribe>,\r\n <https://example.com/unsubscribe.html?opaque=123456789>\r\n",
    b"List-Unsubscribe-Post: List-Unsubscribe=One-Click\r\n",
  ]);
  let once = list_unsubscribe(d, ["https://example.com/unsubscribe/opaquepart"]);
  assert_eq(once.fields.map(|f: Field| f.value), [
    "<https://example.com/unsubscribe/opaquepart>",
    "List-Unsubscribe=One-Click",
  ]);
  assert_eq(
    try { list_unsubscribe(d, ["mailto:list@example.com"]) },
    Err({ at: 0, reason: Unexpected }),
  );
  assert_eq(try { list_unsubscribe(d, []) }, Err({ at: 0, reason: Unexpected }));
  assert_eq(
    try {
      list_unsubscribe(d, [
        "https://example.com/a",
        "https://example.com/b>,<mailto:eve@example.org",
      ])
    },
    Err({ at: 1, reason: Unexpected }),
  );
  assert_eq(
    try { list_unsubscribe(d, ["https://example.com/a b"]) },
    Err({ at: 0, reason: Unexpected }),
  )
}

fn example_date() -> OffsetDateTime / {abort.raise} =
  match date::parse_rfc3339("1997-11-21T09:55:06-06:00") {
    Some(at) -> at,
    None -> panic("no date"),
  }

fn plain_draft() -> Draft / {email.fail, abort.raise} =
  draft(
    named_mailbox("John Doe", address("jdoe", "machine.example")),
    [named_mailbox("Mary Smith", address("mary", "example.net"))],
    "Saying Hello",
    example_date(),
    message_id("1234", "local.machine.example"),
  )

fn greeting() -> String = "This is a message just to say hello.\nSo, \"Hello\".\n"

test "a text draft is written as RFC 5322's first example, with the fields MIME adds" {
  let d = with_text(plain_draft(), greeting());
  assert_eq(
    build(d, "unused"),
    Ok(
      b"Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: John Doe <jdoe@machine.example>\r\nTo: Mary Smith <mary@example.net>\r\nSubject: Saying Hello\r\nMessage-ID: <1234@local.machine.example>\r\nMIME-Version: 1.0\r\nContent-Type: text/plain; charset=us-ascii\r\nContent-Transfer-Encoding: 7bit\r\n\r\nThis is a message just to say hello.\r\nSo, \"Hello\".\r\n",
    ),
  );
  let read_back = read(write(d, "unused"), default_limits());
  assert_eq(
    reader_summary(read_back),
    reader_summary(read(crlf_text(simple_addressing()), default_limits())),
  );
  assert_eq(draft_of(read_back), Some(d));
  assert_eq(draft_of(read(crlf_text(simple_addressing()), default_limits())), Some(d))
}

test "a draft of nothing but its fields has no body and no content type" {
  assert_eq(
    build(plain_draft(), "unused"),
    Ok(
      b"Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: John Doe <jdoe@machine.example>\r\nTo: Mary Smith <mary@example.net>\r\nSubject: Saying Hello\r\nMessage-ID: <1234@local.machine.example>\r\nMIME-Version: 1.0\r\n\r\n",
    ),
  );
  assert_eq(draft_of(read(write(plain_draft(), "unused"), default_limits())), Some(plain_draft()));
  let empty = with_text(plain_draft(), "");
  assert(empty != plain_draft());
  assert_eq(draft_of(read(write(empty, "unused"), default_limits())), Some(empty))
}

test "a text and an HTML body are alternatives, inline parts are related, and attachments are mixed" {
  let logo: Attachment = {
    filename: Some("logo.png"),
    content_type: MediaType("image", "png", []),
    content_id: Some(message_id("logo", "machine.example")),
    data: b"\x89PNG\r\n\x1a\n",
  };
  let d = attach(
    attach_inline(
      with_html(with_text(plain_draft(), "caf\u{e9}\n"), "<img src=\"cid:logo@machine.example\">"),
      logo,
    ),
    attachment("r\u{e9}sum\u{e9}.txt", b"plain\r\nlines\r\n"),
  );
  assert_eq(
    build(d, "b").map(|data: Bytes|
      String::of_bytes(
        data.slice(match data.index_of(b"MIME-Version") { Some(i) -> i, None -> 0 }, data.len()),
      )),
    Ok(
      String::replace(
        \\MIME-Version: 1.0
        \\Content-Type: multipart/mixed; boundary=b
        \\
        \\--b
        \\Content-Type: multipart/alternative; boundary=2-b
        \\
        \\--2-b
        \\Content-Type: text/plain; charset=utf-8
        \\Content-Transfer-Encoding: base64
        \\
        \\Y2Fmw6kNCg==
        \\--2-b
        \\Content-Type: multipart/related; boundary=3-b
        \\
        \\--3-b
        \\Content-Type: text/html; charset=us-ascii
        \\Content-Transfer-Encoding: 7bit
        \\
        \\<img src="cid:logo@machine.example">
        \\--3-b
        \\Content-Type: image/png
        \\Content-Transfer-Encoding: base64
        \\Content-Disposition: inline; filename=logo.png
        \\Content-ID: <logo@machine.example>
        \\
        \\iVBORw0KGgo=
        \\--3-b--
        \\
        \\--2-b--
        \\
        \\--b
        \\Content-Type: text/plain
        \\Content-Transfer-Encoding: 7bit
        \\Content-Disposition: attachment; filename*=UTF-8''r%C3%A9sum%C3%A9.txt
        \\
        \\plain
        \\lines
        \\
        \\--b--
        \\
        ,
        "\n",
        "\r\n",
      ),
    ),
  );
  let m = read(write(d, "b"), default_limits());
  assert_eq(text_body(m), Some(Text("caf\u{e9}\n")));
  assert_eq(html_body(m), Some(Text("<img src=\"cid:logo@machine.example\">")));
  assert_eq(attachments(m).map(|a: Attachment| a.filename), [
    Some("logo.png"),
    Some("r\u{e9}sum\u{e9}.txt"),
  ]);
  assert_eq(draft_of(m), Some(d))
}

test "a draft writes its extra fields after its own fields, and rejects an extra field whose name matches a field the draft writes itself" {
  let d = with_field(
    with_field(plain_draft(), field("X-Mailer", "ply")),
    text_field("Comments", "caf\u{e9}"),
  );
  assert_eq(d.fields.map(|f: Field| f.raw), [
    b"X-Mailer: ply\r\n",
    b"Comments: =?UTF-8?B?Y2Fmw6k=?=\r\n",
  ]);
  let m = read(write(d, "unused"), default_limits());
  assert_eq(fields(m).map(|f: Field| f.name), [
    "Date",
    "From",
    "To",
    "Subject",
    "Message-ID",
    "X-Mailer",
    "Comments",
    "MIME-Version",
  ]);
  assert_eq(unstructured(m, "comments"), Some("caf\u{e9}"));
  assert_eq(draft_of(m), Some(d));
  assert_eq(
    [
      "From",
      "bcc",
      "SUBJECT",
      "Message-Id",
      "MIME-Version",
      "Content-Type",
      "content-anything",
    ].map(|name: String|
      (try { with_field(plain_draft(), field(name, "x")) }) == Err({ at: 0, reason: BadName })),
    [true, true, true, true, true, true, true],
  )
}

test "a text value containing a line break cannot add a field to a draft or message" {
  let eve = "x\r\nBcc: eve@example.org";
  assert_eq(try { with_subject(plain_draft(), eve) }, Err({ at: 1, reason: LineBreak }));
  assert_eq(
    try { draft(mailbox(jdoe()), [], eve, example_date(), message_id("a", "example.org")) },
    Err({ at: 1, reason: LineBreak }),
  );
  assert_eq(try { named_mailbox(eve, jdoe()) }, Err({ at: 1, reason: LineBreak }));
  assert_eq(try { address(eve, "example.org") }, Err({ at: 1, reason: LineBreak }));
  assert_eq(
    try { address("jdoe", "example.org>\r\nBcc: eve@example.org") },
    Err({ at: 11, reason: BadDomain }),
  );
  assert_eq(try { message_id("a", eve) }, Err({ at: 1, reason: BadMessageId }));
  assert_eq(try { field("X-A", eve) }, Err({ at: 1, reason: LineBreak }));
  assert_eq(try { field(eve, "x") }, Err({ at: 1, reason: BadName }));
  assert_eq(try { with_from(plain_draft(), []) }, Err({ at: 0, reason: NoAddress }));
  let d = attach(with_text(plain_draft(), eve), attachment("a\r\nBcc: eve@example.org", b"x"));
  let m = read(write(d, "b"), default_limits());
  assert_eq(bcc(m), []);
  assert_eq(text_body(m), Some(Text("x\nBcc: eve@example.org")));
  assert_eq(attachments(m).map(|a: Attachment| a.filename), [Some("a\r\nBcc: eve@example.org")]);
  assert_eq(fields(m).len(), 7)
}

test "a blind copy is in the envelope, and in the bytes only when requested" {
  let eve = mailbox(address("eve", "example.org"));
  let d = with_bcc(
    with_cc(plain_draft(), [
      group("Team", [mailbox(address("mary", "EXAMPLE.NET")), eve]),
      mailbox_entry(mailbox(jdoe())),
    ]),
    [mailbox_entry(eve), mailbox_entry(mailbox(address("frank", "example.org")))],
  );
  let sent_to = recipients(d).map(|a: Address| show(a));
  assert_eq(sent_to, [
    "mary@example.net",
    "eve@example.org",
    "jdoe@example.org",
    "frank@example.org",
  ]);
  let e = envelope(d);
  assert_eq(e.sender, ReturnTo(address("jdoe", "machine.example")));
  assert_eq(e.recipients, recipients(d));
  assert_eq(e.utf8, false);
  assert_eq(repertoire_for(d), Ascii);
  let dropped = read(write(d, "unused"), default_limits());
  assert_eq(bcc(dropped), []);
  assert_eq(header(dropped, "bcc"), None);
  assert_eq(
    header(dropped, "cc"),
    Some("Team: mary@EXAMPLE.NET, eve@example.org;, jdoe@example.org"),
  );
  let with_blind_copy = read(write(d, "unused", Ascii, IncludeBcc), default_limits());
  assert_eq(address_list_text(bcc(with_blind_copy)), "eve@example.org, frank@example.org");
  assert_eq(draft_of(with_blind_copy), Some(d));
  assert_eq(draft_of(dropped), Some(with_bcc(d, [])));
  let sender = named_mailbox("Michael Jones", address("mjones", "machine.example"));
  assert_eq(show(envelope(with_sender(d, sender)).sender), "ReturnTo(mjones@machine.example)");
  let far = with_to(d, [mailbox_entry(mailbox(address("\u{7528}\u{6237}", "example.org", Utf8)))]);
  assert_eq(envelope(far).utf8, true);
  assert_eq(repertoire_for(far), Utf8)
}

test "an envelope contains each address once, and reports whether one of them is outside ASCII" {
  let far = address("\u{7528}\u{6237}", "example.org", Utf8);
  let mary = address("mary", "example.net");
  let bounce = envelope_of(NullPath, [jdoe(), address("jdoe", "EXAMPLE.ORG"), mary]);
  assert_eq(bounce.sender, NullPath);
  assert_eq(bounce.recipients, [jdoe(), mary]);
  assert_eq(bounce.utf8, false);
  assert_eq(envelope_of(ReturnTo(far), [jdoe()]).utf8, true);
  assert_eq(envelope_of(NullPath, [jdoe(), far]).utf8, true);
  assert_eq(envelope_of(NullPath, []).recipients, [])
}

type RelayCase = { what: String, message: String, expect: Result<String, Error> }

fn relay_cases() -> List<RelayCase> =
  [
    {
      what: "a sender, and every address of To, Cc and Bcc, a group's among them",
      message:
        \\From: John Doe <jdoe@machine.example>, Ann <ann@example.org>
        \\Sender: Michael Jones <mjones@machine.example>
        \\To: Mary Smith <mary@example.net>, Team: a@example.org, b@example.org;
        \\Cc: <boss@nil.test>, MARY@EXAMPLE.NET
        \\Bcc: eve@example.org
        \\Date: Fri, 21 Nov 1997 09:55:06 -0600
        \\
        \\Hi.
      ,
      expect: Ok(
        "mjones@machine.example > mary@example.net a@example.org b@example.org boss@nil.test MARY@EXAMPLE.NET eve@example.org",
      ),
    },
    {
      what: "the first author where no sender is named, and an empty blind copy field",
      message:
        \\From: jdoe@machine.example, ann@example.org
        \\To: mary@example.net
        \\Bcc:
        \\
        \\Hi.
      ,
      expect: Ok("jdoe@machine.example > mary@example.net"),
    },
    {
      what: "a message resent travels under its Resent- fields",
      message:
        \\Resent-From: Mary Smith <mary@example.net>
        \\Resent-To: Jane Brown <j-brown@other.example>
        \\Resent-Bcc: eve@example.org
        \\Resent-Date: Mon, 24 Nov 1997 14:22:01 -0800
        \\From: John Doe <jdoe@machine.example>
        \\To: Mary Smith <mary@example.net>
        \\Cc: boss@nil.test
        \\
        \\Hi.
      ,
      expect: Ok("mary@example.net > j-brown@other.example eve@example.org"),
    },
    {
      what: "a message resent twice does not say whose addresses are whose",
      message:
        \\Resent-From: a@example.org
        \\Resent-To: b@example.org
        \\Resent-From: mary@example.net
        \\Resent-To: c@example.org
        \\From: jdoe@machine.example
        \\
        \\Hi.
      ,
      expect: Err({ at: 0, reason: Repeated("resent-from") }),
    },
    {
      what: "no author",
      message:
        \\To: mary@example.net
        \\
        \\Hi.
      ,
      expect: Err({ at: 0, reason: Missing("from") }),
    },
    {
      what: "a resent message with no one who resent it",
      message:
        \\Resent-To: b@example.org
        \\From: jdoe@machine.example
        \\
        \\Hi.
      ,
      expect: Err({ at: 0, reason: Missing("resent-from") }),
    },
    {
      what: "a recipient field that does not read is rejected, never passed over",
      message:
        \\From: jdoe@machine.example
        \\To: mary@example.net, broken@
        \\
        \\Hi.
      ,
      expect: Err({ at: 25, reason: BadDomain }),
    },
    {
      what: "no recipient at all is an envelope to no one",
      message:
        \\From: jdoe@machine.example
        \\
        \\Hi.
      ,
      expect: Ok("jdoe@machine.example >"),
    },
  ]

test "a message read is relayed with the envelope its fields name: {r.what}" for r: RelayCase in relay_cases(
  ) {
  let m = read_tolerant(crlf_text(r.message), default_limits()).message;
  let named_by = try { message_envelope(m) };
  assert_eq(
    named_by.map(|e: Envelope|
      String::join(
        prepend(
          match e.sender { ReturnTo(a) -> show(a) ++ " >", NullPath -> "<>" },
          e.recipients.map(|a: Address| show(a)),
        ),
        " ",
      )),
    r.expect,
  )
}

test "`without` removes only the named `Bcc` fields, and the message renders unchanged otherwise" {
  let data = crlf_text(
    \\From: jdoe@machine.example
    \\bcc: eve@example.org,
    \\ frank@example.org
    \\To: mary@example.net
    \\Bcc: grace@example.org
    \\
    \\Bcc: this line is the body's
  );
  let m = read_tolerant(data, default_limits()).message;
  assert_eq(
    render(without(m, "Bcc")),
    crlf_text(
      \\From: jdoe@machine.example
      \\To: mary@example.net
      \\
      \\Bcc: this line is the body's
    ),
  );
  assert_eq(render(without(m, "resent-bcc")), data);
  assert_eq(bcc(without(m, "BCC")), []);
  assert_eq(message_envelope(m).recipients.len(), 4);
  assert_eq(message_envelope(without(m, "bcc")).recipients.len(), 1)
}

test "a domain outside ASCII is written as its A-labels unless UTF-8 is requested, and needs no `SMTPUTF8`" {
  let a = address("a", "b\u{fc}cher.example", Utf8);
  let written = |utf8: Bool|
    Result::map(try { address_field("To", [mailbox_entry(mailbox(a))], utf8) }, value_of);
  assert_eq(written(false).map(|v: String| v.contains("a@xn--bcher-kva.example")), Ok(true));
  assert_eq(written(true).map(|v: String| v.contains("a@b\u{fc}cher.example")), Ok(true));
  let d = with_sender(with_text(plain_draft(), "text\n"), mailbox(a));
  assert_eq(envelope(d).utf8, false);
  assert_eq(envelope(d).sender, ReturnTo(a));
  assert_eq(ascii_text(a), Some("a@xn--bcher-kva.example"));
  assert(build(d, "x").is_ok())
}

type WriteErrorCase = { what: String, draft: Draft, boundary: String, reason: Unwritable }

fn write_error_cases() -> List<WriteErrorCase> / {email.fail, abort.raise} = {
  let d = with_text(plain_draft(), "text\n--b\n");
  let file: Attachment = {
    filename: None,
    content_type: MediaType("text", "plain", []),
    content_id: None,
    data: b"x",
  };
  [
    {
      what: "an address outside ASCII",
      draft: with_to(d, [mailbox_entry(mailbox(address("j\u{fc}rgen", "example.org", Utf8)))]),
      boundary: "x",
      reason: NeedsUtf8,
    },
    {
      what: "a local part outside ASCII beside a domain outside it",
      draft: with_sender(d, mailbox(address("\u{e4}", "b\u{fc}cher.example", Utf8))),
      boundary: "x",
      reason: NeedsUtf8,
    },
    {
      what: "a field outside ASCII",
      draft: with_field(d, field("X-Note", "caf\u{e9}", Utf8)),
      boundary: "x",
      reason: NeedsUtf8,
    },
    {
      what: "inline parts and no HTML body",
      draft: attach_inline(d, file),
      boundary: "x",
      reason: NoHtml,
    },
    {
      what: "an attachment that is multipart",
      draft: attach(attach(d, file), { ..file, content_type: MediaType("multipart", "mixed", []) }),
      boundary: "x",
      reason: BadAttachment(1),
    },
    {
      what: "an attachment that is a message",
      draft: attach(attach_inline(with_html(d, "x"), file), {
        ..file,
        content_type: MediaType("message", "rfc822", []),
      }),
      boundary: "x",
      reason: BadAttachment(1),
    },
    {
      what: "an attachment whose type is no token",
      draft: attach(d, { ..file, content_type: MediaType("text", "pl\r\nain", []) }),
      boundary: "x",
      reason: BadAttachment(0),
    },
    {
      what: "an attachment whose parameter is named as a section",
      draft: attach(d, {
        ..file,
        content_type: MediaType("text", "plain", [{ name: "a*0", value: "x" }]),
      }),
      boundary: "x",
      reason: BadAttachment(0),
    },
    {
      what: "a boundary a part holds",
      draft: attach(d, file),
      boundary: "b",
      reason: Framing(multipart::BoundaryInPart(0)),
    },
    {
      what: "a boundary that is none",
      draft: attach(d, file),
      boundary: "a\"b",
      reason: Framing(multipart::InvalidBoundary),
    },
    {
      what: "a boundary too long to nest",
      draft: attach(with_html(d, "x"), file),
      boundary: "a".repeat(69),
      reason: Framing(multipart::InvalidBoundary),
    },
  ]
}

test "`build` returns the expected write error for a draft that cannot be written: {c.what}" for c: WriteErrorCase in write_error_cases(
  ) { assert_eq(build(c.draft, c.boundary), Err(c.reason)) }

test "under UTF-8 a draft is written unchanged, and read back" {
  let d = with_field(
    with_text(
      draft(
        named_mailbox(
          "J\u{fc}rgen M\u{fc}ller",
          address("j\u{fc}rgen", "b\u{fc}cher.example", Utf8),
        ),
        [mailbox(address("\u{7528}\u{6237}", "\u{4f8b}\u{3048}.jp", Utf8))],
        "Gr\u{fc}\u{df}e",
        example_date(),
        message_id("1", "example.org"),
      ),
      "Gr\u{fc}\u{df}e\n",
    ),
    field("X-Note", "caf\u{e9}", Utf8),
  );
  let data = write(d, "unused", Utf8);
  assert_eq(
    String::of_bytes(data),
    "Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: J\u{fc}rgen M\u{fc}ller <j\u{fc}rgen@b\u{fc}cher.example>\r\nTo: \u{7528}\u{6237}@\u{4f8b}\u{3048}.jp\r\nSubject: Gr\u{fc}\u{df}e\r\nMessage-ID: <1@example.org>\r\nX-Note: caf\u{e9}\r\nMIME-Version: 1.0\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: base64\r\n\r\nR3LDvMOfZQ0K\r\n",
  );
  assert_eq(draft_of(read(data, default_limits(), Utf8)), Some(d));
  assert_eq(envelope(d).utf8, true)
}

test "`compose` takes a draft's date from the clock and its message ID from the random number source" {
  let composed = handle {
    try {
      compose(
        named_mailbox("John Doe", address("jdoe", "machine.example")),
        [mailbox(jdoe())],
        "Hello",
      )
    }
  } with {
    time.now_ms() -> 880127706123,
    entropy.next() -> 7,
  };
  assert_eq(composed.map(|d: Draft| show(d.date)), Ok("1997-11-21T15:55:06Z"));
  assert_eq(composed.map(|d: Draft| id_text(d.id)), Ok("<7-7@machine.example>"));
  let fresh = handle {
    build_fresh(attach(with_text(plain_draft(), "x"), attachment("a.bin", b"\x00\x01")))
  } with {
    entropy.next() -> 7,
  };
  assert_eq(
    fresh.map(|data: Bytes| show(content_type(read(data, default_limits())))),
    Ok("multipart/mixed; boundary=boundary-7-7"),
  )
}

fn build_fresh(d: Draft) -> Result<Bytes, Unwritable> / {entropy.next bounded, abort.raise} =
  try { write_fresh(d) }

test "the `drafts` generator produces drafts with and without text, HTML, attachments, subject, groups and non-ASCII addresses" {
  let arbitrary_text = list::somes(
    range(0, 300).map(|root: Int| gen::sample(drafts(), root, b"shapes", root % 40, None).value),
  );
  let some = |ok: (Draft) -> Bool / {abort.raise}| arbitrary_text.any(ok);
  assert_eq(arbitrary_text.len(), 300);
  assert(some(|d: Draft| d.text != None && d.html == None));
  assert(some(|d: Draft| d.text == None && d.html != None));
  assert(some(|d: Draft| d.text != None && d.html != None));
  assert(some(|d: Draft| d.text == None && d.html == None && d.attachments.len() == 0));
  assert(some(|d: Draft| d.text == None && d.html == None && d.attachments.len() > 0));
  assert(some(|d: Draft| d.inline.len() > 0 && d.attachments.len() > 0 && d.text != None));
  assert(some(|d: Draft| d.subject == None));
  assert(some(|d: Draft| match d.subject { Some(s) -> s.len() > 998, None -> false }));
  assert(some(|d: Draft| !envelope(d).utf8 && d.fields.len() == 0));
  assert(some(|d: Draft| envelope(d).utf8));
  assert(some(|d: Draft| d.to.any(|e: Entry| group_name(e) != None)));
  assert(some(|d: Draft| d.bcc.len() > 0 && d.references.len() > 0 && d.sender != None));
  assert(some(|d: Draft| build(d, "boundary").is_ok()));
  assert(some(|d: Draft| build(d, "boundary") == Err(NeedsUtf8)))
}

fn roomy() -> Limits =
  {
    max_bytes: 1073741824,
    max_fields: 100000,
    max_header_bytes: 16777216,
    max_depth: 64,
    max_parts: 100000,
  }

test "for any generated draft, `build` then `parse` gives back the same draft, and `render` gives back the same bytes" {
  gen::check(drafts(), |d: Draft| {
    match build(d, "boundary", Utf8, IncludeBcc) {
      Err(_) -> false,
      Ok(data) -> match parse(data, roomy(), Utf8) {
        Ok(m) -> draft_of(m) == Some(d) && render(m) == data,
        Err(_) -> false,
      },
    }
  })
}

test "`write` encodes a body that does not end in a line break so that the written message ends in a line break and reads back as the same body" {
  let texts = [
    "Hello",
    "Hello\nagain",
    "caf\u{e9}",
    "\u{65e5}\u{672c}\u{8a9e}\u{306e}\u{30c6}\u{30ad}\u{30b9}\u{30c8}",
    "a=b",
    "",
    "x\n",
  ];
  assert_eq(
    texts.map(|body: String| {
      let d = with_text(plain_draft(), body);
      let data = write(d, "unused");
      let m = read(data, default_limits());
      {
        ended: String::of_bytes(data).ends_with("\r\n"),
        encoding: header(m, "content-transfer-encoding"),
        read: text_body(m) == Some(Text(body)),
        same: draft_of(m) == Some(d),
      }
    }),
    ["quoted-printable", "quoted-printable", "base64", "base64", "base64", "7bit", "7bit"].map(
      |encoding: String| { ended: true, encoding: Some(encoding), read: true, same: true },
    ),
  );
  assert(
    String::of_bytes(write(with_text(plain_draft(), "Hello"), "unused")).ends_with(
      "\r\n\r\nHello=\r\n",
    ),
  )
}

test "a generated subject or name never produces a line break in a header, a line over 998 bytes, or an extra field" {
  gen::check2(gen::text(), gen::text(), |topic: String, name: String| {
    match try {
        draft(
          named_mailbox(name, jdoe()),
          [named_mailbox(name, jdoe())],
          topic,
          example_date(),
          message_id("a", "example.org"),
        )
      } {
      Err(_) -> !is_quotable(topic) || !is_quotable(name),
      Ok(d) -> match build(d, "unused") {
        Err(_) -> false,
        Ok(data) -> match parse(data, roomy()) {
          Err(_) -> false,
          Ok(m) ->
            line_defects(data, 0).len() == 0 && fields(m).len() == 6 && subject(m) == Some(topic)
              && from(m).map(display_name) == [if name == "" { None } else { Some(name) }],
        },
      },
    }
  })
}

test "`parse_tolerant` accepts any bytes, and `render` returns exactly the bytes that were parsed" {
  gen::check(gen::bytes(), |data: Bytes| {
    let wrapped = Bytes::concat_all([
      b"Content-Type: multipart/mixed; boundary=b\r\n\r\n--b\r\n",
      data,
      b"\r\n--b\r\nContent-Type: multipart/mixed; boundary=c\r\n\r\n--c\r\n",
      data,
      b"\r\n--b--\r\n",
    ]);
    [data, wrapped].all(|given: Bytes|
      [Ascii, Utf8].all(|repertoire: Repertoire|
        match parse_tolerant(given, default_limits(), repertoire) {
          Ok(read) ->
            render(read.message) == given
              && read.defects.all(|d: Error| d.at >= 0 && d.at <= given.len())
              && read.defects.len() == 0 == parse(given, default_limits(), repertoire).is_ok(),
          Err(_) -> false,
        }))
  })
}

fn canonicalization_message() -> Bytes =
  b"A: X\r\nB : Y\t\r\n\tZ  \r\n\r\n C \r\nD \t E\r\n\r\n\r\n"

test "`canonical_field` and `canonical_body` give the DKIM canonicalized header and body from RFC 6376's examples, in both simple and relaxed modes" {
  let m = read_tolerant(canonicalization_message(), default_limits()).message;
  let head = |form: Canonical|
    Bytes::concat_all(fields(m).map(|f: Field| canonical_field(f, form)));
  assert_eq(head(Relaxed), b"a:X\r\nb:Y Z\r\n");
  assert_eq(canonical_body(body(m), Relaxed), b" C\r\nD E\r\n");
  assert_eq(head(Simple), b"A: X\r\nB : Y\t\r\n\tZ  \r\n");
  assert_eq(canonical_body(body(m), Simple), b" C \r\nD \t E\r\n")
}

test "`canonical_body` turns an empty body into a line break in DKIM simple mode and into empty bytes in relaxed mode" {
  assert_eq(canonical_body(b"", Simple), b"\r\n");
  assert_eq(canonical_body(b"\r\n\r\n", Simple), b"\r\n");
  assert_eq(canonical_body(b"", Relaxed), b"");
  assert_eq(canonical_body(b"\r\n \t\r\n", Relaxed), b"");
  assert_eq(canonical_body(b"a", Simple), b"a\r\n");
  assert_eq(canonical_body(b"a", Relaxed), b"a\r\n");
  assert_eq(canonical_body(b"a\r\n\r\nb \r\n\r\n", Simple), b"a\r\n\r\nb \r\n");
  assert_eq(canonical_body(b"a\r\n\r\nb \r\n\r\n", Relaxed), b"a\r\n\r\nb\r\n");
  assert_eq(canonical_body(b"\ta  b\t", Relaxed), b" a b\r\n");
  let folded_field = field("Subject", "word ".repeat(30));
  assert_eq(
    canonical_field(folded_field, Relaxed),
    Bytes::of_string("subject:" ++ "word ".repeat(29) ++ "word\r\n"),
  );
  assert_eq(canonical_field(folded_field, Simple), folded_field.raw)
}
