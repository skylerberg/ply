//! Internet mail: addresses, and messages read and written (RFC 5322 and MIME).
//!
//! An `Address` is a local part and a domain, a `Mailbox` is an address with a display name, and an
//! `Entry` of an address list is a mailbox or a named group of them. Each is built only by this
//! module's functions and readers, so none contains a line break, a control character or an `@`
//! other than its one separator. A text that one reader would read as two addresses and another as
//! one is rejected, never repaired. Two addresses are `==` when their local parts are the same
//! text, including case, and their domains are the same name: they differ at most in the case of
//! ASCII letters and in whether an internationalized label is written in its script or as its
//! A-label, so `user@b\u{fc}cher.example` is `user@xn--bcher-kva.example`. `read_address_list` is
//! the one parser of RFC 5322 §3.4. It reads display names as atoms, quoted strings and encoded
//! words; angle addresses; groups; comments wherever the grammar allows them, which are read and
//! dropped; and quoted local parts and domain literals, whose text is kept as written. Under
//! `Obsolete` it also accepts §4's syntax, as a mail reader must: a route in an angle address is
//! read and dropped, and empty list elements, periods in a display name and blanks around the dots
//! of an address are skipped. A domain uses host names' letters, digits and hyphens. UTF-8 in a
//! local part, a domain or a display name (RFC 6531, RFC 6532) is read only under `Utf8` and
//! rejected with a reason otherwise. A domain with a label outside ASCII, or one that starts with
//! `xn--`, must be a domain name as `std.idna` reads one, or it is rejected with what `std.idna`
//! found wrong. An address keeps its domain as written, and `show` writes it that way.
//! `ascii_domain` is its A-labels, which is what a writer under `Ascii` writes and what a path
//! without `SMTPUTF8` carries, so only a local part outside ASCII needs `Utf8`. With `import
//! std.email`, `email"jdoe@example.org"` is an `Address` checked when the program is checked.
//!
//! A `Message` is header fields in the order written and a body, and it keeps the bytes it was read
//! from. Each `Field` keeps its original lines alongside its unfolded value, so `render` of a
//! message that was read returns the bytes read, which a signature depends on. `read` is strict: it
//! accepts what a conforming writer writes and rejects anything else with an `Error` reporting
//! where and why. `read_tolerant` reads mail as it is found and returns the message with every
//! defect `read` would have rejected it for. It rejects only a message past its `Limits`, which
//! every reader takes. The typed readers (`from`, `to`, `date`, `id`, `subject`, `content_type` and
//! the rest) return a field's value, or nothing when the value does not parse. A body is a tree.
//! `parts` are a multipart entity's parts, found by `std.multipart`. `content` undoes a part's
//! transfer encoding. `text` decodes it in its charset if that is one of `std.encoded_word`'s, and
//! otherwise returns the bytes with the charset's name, never a guess. `text_body`, `html_body` and
//! `attachments` find what a person would call those. A file name is data a sender chose, never a
//! path: `std.multipart`'s `safe_filename` is the one way to a name on disk.
//!
//! A `Draft` is a message to write, made of typed parts: mailboxes, a subject, a date, an id, a
//! text and an HTML body, inline images and attachments. Nothing in it is written exactly as given:
//! text outside ASCII goes out in encoded words, lines fold at 78 octets and never pass 998, a
//! body's transfer encoding is chosen from its bytes, and a value that contains a line break is
//! rejected where it is set, so no value can add a field. The date, the id and the boundary are
//! arguments; `compose` and `write_fresh` take them from `time` and `entropy`. `write` leaves `Bcc`
//! out unless requested, and `repertoire_for` reports whether a draft can be written in ASCII.
//!
//! An `Envelope` is what a transport receives alongside the bytes: a reverse path, which is an
//! address or the null path a bounce uses, and every address the message goes to, once each.
//! `envelope` returns a draft's envelope and `message_envelope` that of a message that was read;
//! `without` removes its `Bcc` lines before it is sent on.
//!
//! `canonical_field` and `canonical_body` are RFC 6376's `simple` and `relaxed` forms, which a
//! DKIM signature is taken over; the signature itself is not here.

import std.base64 (base64_decode, base64_encode)
import std.bytes
import std.date
import std.date (OffsetDateTime)
import std.encoded_word
import std.encoded_word (Literal, Piece, EncodedWord, encode_words, is_blank, pieces)
import std.gen
import std.gen (Gen)
import std.idna
import std.list
import std.list (enumerate, prepend)
import std.mime
import std.mime (MediaType, Param, is_quotable, is_token)
import std.multipart
import std.multipart (Lenient, Span, RawPart)
import std.option
import std.quoted_printable
import std.random (entropy, nonce)
import std.result
import std.show (show)
import std.string
import std.time (time)

// --- What is allowed, and what is rejected -----------------------------------

/// The characters an address, a display name and a field's value may contain unencoded.
pub type Repertoire =
  /// ASCII only, which every mail system carries. A writer puts other text in encoded words
  /// where a field allows them, and rejects an address that contains any.
  | Ascii
  /// UTF-8 too, as RFC 6531 and RFC 6532 have it. Only a path that offers `SMTPUTF8` carries
  /// such a message.
  | Utf8

/// Which of RFC 5322's grammars a reader accepts.
pub type Syntax =
  /// Only §3's: what a conforming writer writes.
  | Current
  /// §4's obsolete syntax too, and also what real mail does with encoded words: one inside a
  /// quoted string is decoded, and one may touch the `<` or `:` after it.
  | Obsolete

/// Why a text is rejected, or what is wrong with a message a tolerant reader accepted.
pub type ErrorKind =
  /// Nothing where an address must be.
  | NoAddress
  /// Words with no `@` and no angle address after them.
  | NoAt
  /// A local part that is neither atoms between single dots nor a quoted string, or one that
  /// contains an `@` in its quotes.
  | BadLocalPart
  /// A domain that is neither host labels between single dots nor a literal in brackets.
  | BadDomain
  /// A domain with a label outside ASCII, or one that starts with `xn--`, that is not a valid
  /// domain name: each problem `std.idna` finds with it, by label.
  | BadIdna(List<idna::Problem>)
  /// A quoted string that never closes.
  | Unclosed
  /// A comment that never closes.
  | UnclosedComment
  /// An angle address with no `>` after it.
  | UnclosedAngle
  /// A group with no `;` after it.
  | UnclosedGroup
  /// A character that is not allowed where it appears.
  | Unexpected
  /// A control character other than a tab.
  | Control
  /// A carriage return or a line feed inside a value.
  | LineBreak
  /// A character outside ASCII, when `Utf8` is not requested.
  | NonAscii
  /// Syntax RFC 5322 §4 calls obsolete, when `Current` is requested.
  | ObsoleteSyntax
  /// A local part, a domain, a name or a piece of text longer than a line can fit.
  | TooLong
  /// An encoded word that cannot be read or that carries a control character, which a tolerant
  /// reader leaves as written; or one with no blank between it and the `<` or `:` after it,
  /// which RFC 2047 requires.
  | BadEncodedWord
  /// An invalid field name, or one a draft writes itself.
  | BadName
  /// A message identifier that is not `<` and `>` around text without blanks.
  | BadMessageId
  /// A `Date` field that is not an RFC 5322 date.
  | BadDate
  /// A `Content-Type` that is not a media type, or whose parameters do not join.
  | BadMediaType
  /// A `Content-Disposition` that does not parse.
  | BadDisposition
  /// A `Content-Transfer-Encoding` this module does not undo, or one a multipart entity may not
  /// have, with its name.
  | BadEncoding(String)
  /// A body that is not in the transfer encoding it names.
  | BadTransferData
  /// A byte past 127 in a body whose transfer encoding is `7bit`, named or by default.
  | Undeclared8Bit
  /// A byte past 127 in a header field, when `Utf8` is not requested or the field is not UTF-8.
  | EightBitHeader
  /// A line of a header block that is neither a field nor the continuation of one: the block
  /// ends before it, with no blank line, and the body starts with it.
  | NoBlankLine
  /// A line feed with no carriage return before it.
  | BareLineFeed
  /// A carriage return with no line feed after it.
  | BareCarriageReturn
  /// A line longer than 998 octets.
  | LongLine
  /// A header field with no line break after it: the message ends inside its header block.
  | Truncated
  /// A field every message has that this one lacks, with its name in lower case.
  | Missing(String)
  /// A field a message has at most once that this one has again, with its name in lower case.
  | Repeated(String)
  /// A multipart body with no closing delimiter: its last part runs to the body's end.
  | UnclosedBoundary
  /// A multipart body `std.multipart` rejects, and why. A tolerant reader keeps it as one part.
  | BadMultipart(multipart::ErrorKind)
  /// The message is longer than `Limits.max_bytes`.
  | TooLarge
  /// A header block has more fields than `Limits.max_fields`.
  | TooManyFields
  /// A header block is longer than `Limits.max_header_bytes`.
  | HeadersTooLarge
  /// Multipart bodies nest deeper than `Limits.max_depth`.
  | TooDeep
  /// The message has more parts than `Limits.max_parts`.
  | TooManyParts

/// An error, or a defect of a message that was read: the offset where it was found, and why. For a
/// field whose value does not parse, the offset is the field's first byte.
pub type Error = { at: Int, reason: ErrorKind }

/// Why a draft has no bytes.
pub type Unwritable =
  /// An address or a field contains a character outside ASCII, and `Utf8` is not requested.
  | NeedsUtf8
  /// The draft has inline parts and no HTML body to show them in.
  | NoHtml
  /// The attachment of this index, counting the inline ones and then the attached, has a media
  /// type that is `multipart` or `message`, or that no `Content-Type` field can carry.
  | BadAttachment(Int)
  /// The parts cannot be separated with the given boundary, for the reason `std.multipart`
  /// reports.
  | Framing(multipart::WriteError)

/// What this module raises when it rejects input.
pub effect email {
  /// The text is not an address, or the bytes are not a message, that this module reads.
  raise fail(e: Error)
  /// The draft cannot be written.
  raise unwritable(reason: Unwritable)
}

fn fail<a>(at: Int, reason: ErrorKind) -> a / {email.fail} = email.fail({ at: at, reason: reason })

/// An error's reason as a sentence.
pub fn explain(reason: ErrorKind) -> String =
  match reason {
    NoAddress -> "an address is expected here",
    NoAt -> "an `@` or an address in angle brackets is expected here",
    BadLocalPart -> "a local part is atoms between single dots, or a quoted string",
    BadDomain ->
      "a domain is labels of letters, digits and hyphens between single dots, or a literal in brackets",
    BadIdna(problems) ->
      "no internationalized domain name: "
        ++ (match problems {
          [found, ..] -> idna::reason(found.reason),
          [] -> "it converts to none",
        }),
    Unclosed -> "the quoted string never closes",
    UnclosedComment -> "the comment never closes",
    UnclosedAngle -> "a `>` is expected here",
    UnclosedGroup -> "a `;` is expected to end the group",
    Unexpected -> "this cannot stand here",
    Control -> "a control character other than a tab",
    LineBreak -> "a line break inside a value",
    NonAscii -> "a character outside ASCII, which only `Utf8` admits",
    ObsoleteSyntax -> "obsolete syntax, which only `Obsolete` admits",
    TooLong -> "longer than a line can hold",
    BadEncodedWord -> "an encoded word that cannot be read",
    BadName -> "no name a field of this kind may have",
    BadMessageId -> "a message identifier is `<`, text without blanks and `>`",
    BadDate -> "no RFC 5322 date",
    BadMediaType -> "no media type",
    BadDisposition -> "no content disposition",
    BadEncoding(name) -> "the transfer encoding `" ++ name ++ "` cannot be used here",
    BadTransferData -> "the body is not in its transfer encoding",
    Undeclared8Bit -> "a byte past 127 in a 7bit body",
    EightBitHeader -> "a byte past 127 in a header field",
    NoBlankLine -> "a line that is no header field, with no blank line before it",
    BareLineFeed -> "a line feed with no carriage return before it",
    BareCarriageReturn -> "a carriage return with no line feed after it",
    LongLine -> "a line longer than 998 octets",
    Truncated -> "the message ends inside a header field",
    Missing(name) -> "the message has no `" ++ name ++ "` field",
    Repeated(name) -> "the message has a second `" ++ name ++ "` field",
    UnclosedBoundary -> "the multipart body has no closing delimiter",
    BadMultipart(_) -> "the multipart body cannot be read",
    TooLarge -> "the message is larger than the limit",
    TooManyFields -> "more header fields than the limit",
    HeadersTooLarge -> "a header block larger than the limit",
    TooDeep -> "parts nested deeper than the limit",
    TooManyParts -> "more parts than the limit",
  }

// --- Characters ---------------------------------------------------------------

/// RFC 5322's `atext`: what an atom is made of.
fn atext() -> Bytes =
  b"!#$%&'*+-/0123456789=?ABCDEFGHIJKLMNOPQRSTUVWXYZ^_`abcdefghijklmnopqrstuvwxyz{|}~"

/// What a host name's label is made of.
fn label_chars() -> Bytes = b"-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

fn printable() -> Bytes =
  b" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

/// RFC 5322's `dtext`: what a domain literal contains between its brackets.
fn dtext() -> Bytes =
  b"!\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ^_`abcdefghijklmnopqrstuvwxyz{|}~"

/// RFC 5322's `ftext`: what a field's name is made of.
fn ftext() -> Bytes =
  b"!\"#$%&'()*+,-./0123456789;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

/// What a message identifier contains between its angle brackets.
fn id_chars() -> Bytes =
  b"!\"#$%&'()*+,-./0123456789:;=?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

/// Every control character but a tab.
fn controls() -> Bytes =
  b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x7f"

/// Every byte past 127.
const fn high() -> Bytes = Bytes::concat_all(range(128, 256).map(byte_of_int))

const fn atext_wide() -> Bytes = atext().concat(high())

const fn label_wide() -> Bytes = label_chars().concat(high())

const fn printable_wide() -> Bytes = printable().concat(high())

/// What ends a run of plain text in a quoted string, where every byte past 127 is text.
const fn quoted_stops() -> Bytes = b"\"\\".concat(controls())

/// What ends a run of plain text in a quoted string that contains only ASCII.
const fn quoted_stops_ascii() -> Bytes = quoted_stops().concat(high())

// --- Reading: the pieces of an address ---------------------------------------

/// A text being read, and what its reader allows.
type Context = { b: Bytes, utf8: Bool, obsolete: Bool }

fn context_of(text: String, repertoire: Repertoire, syntax: Syntax) -> Context =
  { b: Bytes::of_string(text), utf8: repertoire == Utf8, obsolete: syntax == Obsolete }

fn atoms(context: Context) -> Bytes = if context.utf8 { atext_wide() } else { atext() }

/// Why the byte at `at` is not allowed where it appears.
fn byte_problem(context: Context, at: Int) -> ErrorKind = {
  let c = context.b.peek(at);
  if c == b'\r' || c == b'\n' { LineBreak }
  else if (c >= 0 && c < 32 && c != b'\t') || c == 127 { Control }
  else if c > 127 && !context.utf8 { NonAscii }
  else { Unexpected }
}

/// Why the byte at `at` is not allowed where it appears: `otherwise` when the byte itself is one a
/// value may contain.
fn byte_problem_or(context: Context, at: Int, otherwise: ErrorKind) -> ErrorKind =
  match byte_problem(context, at) { Unexpected -> otherwise, found -> found }

/// Whether a comment or a quoted string may contain the byte `c`, as itself or after a backslash.
fn is_text(context: Context, c: Int) -> Bool =
  c == b'\t' || (c >= 32 && c < 127) || (c > 127 && context.utf8)

/// Where the blanks and comments from `at` end. Comments nest, and a backslash in one takes the
/// character after it.
fn cfws(context: Context, at: Int) -> Int / {email.fail} =
  blank(context, at, 0, context.b.len() - at + 1)

/// `depth` counts the comments open at `at`. `left` bounds the recursion: each step consumes a
/// character.
fn blank(context: Context, at: Int, depth: Int, left: Int) -> Int / {email.fail} = {
  let c = context.b.peek(at);
  if left <= 0 { at } else if depth > 0 {
    let opened = if c == b'(' { 1 } else if c == b')' { -1 } else { 0 };
    blank(context, at + commented(context, at), depth + opened, left - 1)
  } else if bytes::is_blank(c) { blank(context, at + 1, 0, left - 1) }
  else if c == b'(' { blank(context, at + 1, 1, left - 1) }
  else { at }
}

/// How many bytes the comment character at `at` takes: two for a backslash and the character it
/// escapes. Raises when the comment ends unclosed, and for a character no comment may contain.
fn commented(context: Context, at: Int) -> Int / {email.fail} = {
  let c = context.b.peek(at);
  if c < 0 { fail(at, UnclosedComment) }
  else if c != b'\\' { if is_text(context, c) { 1 } else { fail(at, byte_problem(context, at)) } }
  else if context.b.peek(at + 1) < 0 { fail(at + 1, UnclosedComment) }
  else if !is_text(context, context.b.peek(at + 1)) { fail(at + 1, byte_problem(context, at + 1)) }
  else { 2 }
}

/// A text read, and the offset after it.
type Text = { text: String, at: Int }

/// The quoted string whose opening quote is at `at`: its contents, with each backslash pair
/// replaced by the character after the backslash.
fn quoted(context: Context, at: Int) -> Text / {email.fail, abort.raise} =
  quoted_from(context, at + 1, [], context.b.len() - at + 1)

/// `left` bounds the recursion: each step consumes a backslash pair.
fn quoted_from(
  context: Context,
  at: Int,
  kept: List<Bytes>,
  left: Int,
) -> Text / {email.fail, abort.raise} = {
  let stop = context.b.skip_until(at, if context.utf8 { quoted_stops() }
  else { quoted_stops_ascii() });
  let so_far = kept.push(context.b.slice(at, stop));
  let c = context.b.peek(stop);
  if c == b'"' { { text: String::of_bytes(Bytes::concat_all(so_far)), at: stop + 1 } }
  else if c < 0 || left <= 0 { fail(stop, Unclosed) }
  else if c != b'\\' { fail(stop, byte_problem(context, stop)) }
  else if context.b.peek(stop + 1) < 0 { fail(stop + 1, Unclosed) }
  else if !is_text(context, context.b.peek(stop + 1)) {
    fail(stop + 1, byte_problem(context, stop + 1))
  } else {
    quoted_from(context, stop + 2, so_far.push(context.b.slice(stop + 1, stop + 2)), left - 1)
  }
}

/// One token of the words an address opens with.
type Tok = | Atom(String) | Quoted(String) | Dot

/// A token, where it starts and ends, and whether blanks or a comment came before it.
type TokenSpan = { token: Tok, at: Int, end: Int, spaced: Bool }

/// The words an address starts with, and the offset after them and the blanks that follow.
type Run = { tokens: List<TokenSpan>, at: Int }

/// The atoms, quoted strings and dots from `at`, which are a display name or a local part
/// depending on what follows them.
fn run(context: Context, at: Int) -> Run / {email.fail, abort.raise} =
  run_from(context, { tokens: [], at: at }, context.b.len() - at + 1)

/// `left` bounds the recursion: each step consumes a token.
fn run_from(context: Context, r: Run, left: Int) -> Run / {email.fail, abort.raise} = {
  let start = cfws(context, r.at);
  let c = context.b.peek(start);
  let spaced = start > r.at;
  if left <= 0 { { tokens: r.tokens, at: start } } else if c == b'"' {
    let q = quoted(context, start);
    run_from(context, with_token(r, Quoted(q.text), start, q.at, spaced), left - 1)
  } else if c == b'.' { run_from(context, with_token(r, Dot, start, start + 1, spaced), left - 1) }
  else {
    let end = context.b.skip(start, atoms(context));
    if end == start { { tokens: r.tokens, at: start } } else {
      run_from(
        context,
        with_token(r, Atom(String::of_bytes(context.b.slice(start, end))), start, end, spaced),
        left - 1,
      )
    }
  }
}

fn with_token(r: Run, token: Tok, at: Int, end: Int, spaced: Bool) -> Run =
  { tokens: r.tokens.push({ token: token, at: at, end: end, spaced: spaced }), at: end }

fn is_dot(t: TokenSpan) -> Bool = match t.token { Dot -> true, _ -> false }

fn token_text(t: TokenSpan) -> String =
  match t.token { Atom(text) -> text, Quoted(text) -> text, Dot -> "." }

/// The local part the words `tokens` form, starting at `at`: a word, then a dot and a word any
/// number of times.
fn local_of(
  context: Context,
  tokens: List<TokenSpan>,
  at: Int,
) -> String / {email.fail, abort.raise} =
  match enumerate(tokens).find(|t: { index: Int, value: TokenSpan }|
      t.index % 2 == 0 == is_dot(t.value)) {
    Some(odd) -> fail(odd.value.at, BadLocalPart),
    None -> match tokens.last() {
      None -> fail(at, BadLocalPart),
      Some(end) -> if is_dot(end) { fail(end.at, BadLocalPart) }
      else if !context.obsolete && !is_current_local(tokens) { fail(at, ObsoleteSyntax) }
      else { local_checked(String::join(tokens.map(token_text), ""), context.utf8, at) },
    },
  }

/// Whether a local part's words are RFC 5322 §3's: one quoted string, or atoms and dots with no
/// blank between them.
fn is_current_local(tokens: List<TokenSpan>) -> Bool =
  match tokens {
    [_] -> true,
    [_, ..rest] ->
      tokens.all(|t: TokenSpan| match t.token { Quoted(_) -> false, _ -> true })
        && rest.all(|t: TokenSpan| !t.spaced),
    [] -> false,
  }

/// `local`, checked to be a valid local part: printable characters except `@`, and at most 255
/// octets.
fn local_checked(local: String, utf8: Bool, at: Int) -> String / {email.fail, abort.raise} = {
  let b = Bytes::of_string(local);
  let stop = b.skip(0, if utf8 { printable_wide() } else { printable() });
  let second = b.skip_until(0, b"@");
  if stop < b.len() {
    fail(at + stop, byte_problem_or({ b: b, utf8: utf8, obsolete: false }, stop, Control))
  } else if second < b.len() { fail(at + second, BadLocalPart) }
  else if b.len() > 255 { fail(at, TooLong) }
  else { local }
}

/// A domain as written, the key all its equivalent forms share, and the offset after it.
type Domain = { text: String, key: String, at: Int }

/// The checks a mail domain must pass when `std.idna` reads it: a host name's rules, except the
/// one on hyphens in the third and fourth positions, which a pure ASCII label skips too.
fn host_checks() -> idna::Options =
  {
    check_hyphens: false,
    check_bidi: true,
    check_joiners: true,
    use_std3_ascii_rules: true,
    verify_dns_length: true,
  }

/// The key that addresses are compared by, shared by every form of the name `labels` join to: the
/// name in lower case if it is ASCII, and the A-labels `std.idna` makes of a name with a label
/// outside ASCII or one that starts with `xn--`. Raises `email.fail` at `at` if `std.idna` makes
/// none.
fn name_key(labels: List<String>, name: String, at: Int) -> String / {email.fail, abort.raise} = {
  let encode_body = labels.any(|l: String| l.ascii_lower().starts_with("xn--"));
  if name.is_ascii() && !encode_body { name.ascii_lower() } else {
    match idna::to_ascii(name, host_checks()) {
      Ok(wire) -> wire,
      Err(problems) -> fail(at, BadIdna(problems)),
    }
  }
}

/// The domain that starts at `start`.
fn domain_from(context: Context, start: Int) -> Domain / {email.fail, abort.raise} =
  if context.b.peek(start) == b'[' {
    let literal = bracketed(context, start);
    { text: literal.text, key: literal.text.ascii_lower(), at: literal.at }
  } else {
    let read = labels(context, { at: start, held: [] }, context.b.len() - start + 1);
    let name = String::join(read.held, ".");
    if !read.held.all(is_label) { fail(start, BadDomain) }
    else if Bytes::of_string(name).len() > 255 { fail(start, TooLong) }
    else { { text: name, key: name_key(read.held, name, start), at: read.at } }
  }

type Labels = { at: Int, held: List<String> }

/// The atoms between dots from `s.at`. `left` bounds the recursion: each step consumes an atom.
fn labels(context: Context, s: Labels, left: Int) -> Labels / {email.fail, abort.raise} = {
  let end = context.b.skip(s.at, atoms(context));
  if end == s.at { fail(s.at, byte_problem_or(context, s.at, BadDomain)) } else {
    let held = s.held.push(String::of_bytes(context.b.slice(s.at, end)));
    let dot = cfws(context, end);
    if left <= 0 || context.b.peek(dot) != b'.' { { at: end, held: held } } else {
      let next = cfws(context, dot + 1);
      if (dot > end || next > dot + 1) && !context.obsolete { fail(end, ObsoleteSyntax) }
      else { labels(context, { at: next, held: held }, left - 1) }
    }
  }
}

/// Whether `label` is one a host name has: letters, digits and hyphens, and under `Utf8` any
/// character outside ASCII; at most 63 octets, with no hyphen first or last.
fn is_label(label: String) -> Bool / {abort.raise} = {
  let b = Bytes::of_string(label);
  let n = b.len();
  n > 0 && n <= 63 && b.skip(0, label_wide()) == n && b.at(0) != b'-' && b.at(n - 1) != b'-'
}

/// The domain literal whose `[` is at `at`, with its brackets and without the blanks RFC 5322
/// allows after `[` and before `]`. A blank inside it is rejected: the text between the brackets is
/// one address, and no reader should have to decide whether it is two.
fn bracketed(context: Context, at: Int) -> Text / {email.fail, abort.raise} = {
  let from = context.b.skip(at + 1, b" \t");
  let end = context.b.skip(from, dtext());
  let close = context.b.skip(end, b" \t");
  if context.b.peek(close) != b']' { fail(close, byte_problem_or(context, close, BadDomain)) }
  else if end == from { fail(at, BadDomain) }
  else if end - from > 253 { fail(at, TooLong) }
  else { { text: "[" ++ String::of_bytes(context.b.slice(from, end)) ++ "]", at: close + 1 } }
}

/// The domain after the `@` at `at - 1`, with the blanks and comments around it skipped.
fn domain_at(context: Context, at: Int) -> Domain / {email.fail, abort.raise} = {
  let d = domain_from(context, cfws(context, at));
  { text: d.text, key: d.key, at: cfws(context, d.at) }
}

type AddressSpec = { address: Address, at: Int }

/// The address whose local part is the words `r`, which started at `from`, and whose `@` is at
/// `r.at`.
fn address_spec(context: Context, r: Run, from: Int) -> AddressSpec / {email.fail, abort.raise} = {
  let local = local_of(context, r.tokens, from);
  let d = domain_at(context, r.at + 1);
  { address: Address(local, d.text, d.key), at: d.at }
}

/// The address in the angle brackets that open at `at`, and the offset after its `>` and the
/// blanks that follow. A route, `@a,@b:`, is read and dropped under `Obsolete`.
fn angle(context: Context, at: Int) -> AddressSpec / {email.fail, abort.raise} = {
  let start = cfws(context, at + 1);
  let c = context.b.peek(start);
  let routed = c == b'@' || c == b',';
  let from = if !routed { start }
  else if context.obsolete { route(context, start, false, false, context.b.len() - start + 1) }
  else { fail(start, ObsoleteSyntax) };
  let r = run(context, from);
  let next = context.b.peek(r.at);
  if next != b'@' {
    fail(r.at, if r.tokens.len() == 0 && next == b'>' { NoAddress }
    else if next < 0 { UnclosedAngle }
    else { byte_problem_or(context, r.at, NoAt) })
  } else {
    let s = address_spec(context, r, from);
    if context.b.peek(s.at) != b'>' {
      fail(s.at, if context.b.peek(s.at) < 0 { UnclosedAngle } else { byte_problem(context, s.at) })
    } else { { address: s.address, at: cfws(context, s.at + 1) } }
  }
}

/// Where a route that starts at `at` ends, after its `:`: `@` and a domain, and more of them
/// after commas. `any` records that a domain was read, and `held` that one was read since the last
/// comma. `left` bounds the recursion: each step consumes a comma or a domain.
fn route(
  context: Context,
  at: Int,
  any: Bool,
  held: Bool,
  left: Int,
) -> Int / {email.fail, abort.raise} = {
  let start = cfws(context, at);
  let c = context.b.peek(start);
  if c == b':' && any { start + 1 }
  else if left <= 0 { fail(start, Unexpected) }
  else if c == b',' { route(context, start + 1, any, false, left - 1) } else if c == b'@' && !held {
    route(context, domain_at(context, start + 1).at, true, true, left - 1)
  } else { fail(start, if c < 0 { UnclosedAngle } else { byte_problem(context, start) }) }
}

/// The display name the words `tokens` form: atoms and quoted strings with a space between them,
/// each encoded word decoded, and two encoded words side by side as one text.
fn phrase(context: Context, tokens: List<TokenSpan>) -> Option<String> / {email.fail, abort.raise} =
  match tokens {
    [] -> None,
    [opening, ..] -> if is_dot(opening) { fail(opening.at, Unexpected) } else {
      let reader_summary = tokens.fold(
        { out: [], dot: false, word: false },
        |s: PhraseState, t: TokenSpan| add_phrase_word(context, s, t),
      );
      let name = String::join(reader_summary.out, "");
      if name == "" { None } else { Some(name) }
    },
  }

/// The words collected so far, whether the last was a dot, and whether it was an encoded word.
type PhraseState = { out: List<String>, dot: Bool, word: Bool }

fn add_phrase_word(
  context: Context,
  s: PhraseState,
  t: TokenSpan,
) -> PhraseState / {email.fail, abort.raise} =
  match t.token {
    Dot -> if !context.obsolete { fail(t.at, ObsoleteSyntax) }
    else { { out: s.out.push(if t.spaced { " ." } else { "." }), dot: true, word: false } },
    Atom(written) -> {
      let w = decode_atom(context, written, t.at);
      { out: s.out.push(gap(s, t, w.whole) ++ w.text), dot: false, word: w.whole }
    },
    Quoted(held) ->
      {
        out: s.out.push(
          gap(s, t, false)
            ++ (if context.obsolete { decode_encoded_words(held).text } else { held }),
        ),
        dot: false,
        word: false,
      },
  }

/// The separator between the words collected and the next one.
fn gap(s: PhraseState, t: TokenSpan, word: Bool) -> String =
  if s.out.len() == 0 || (s.dot && !t.spaced) || (s.word && word) { "" } else { " " }

/// A text with its encoded words decoded: whether one could not be, and whether the text was
/// one encoded word and nothing else.
type DecodedWords = { text: String, bad: Bool, whole: Bool }

type WordDecodeState = {
  out: List<String>,
  gap: String,
  joined: Bool,
  bad: Bool,
  words: Int,
  others: Int,
}

/// `text` with each encoded word in it decoded, as `std.encoded_word`'s `read` decodes them,
/// except a word that cannot be read or that carries a control character, which is left as written.
fn decode_encoded_words(text: String) -> DecodedWords / {abort.raise} = {
  let read = pieces(text).fold(
    { out: [], gap: "", joined: false, bad: false, words: 0, others: 0 },
    |u: WordDecodeState, p: Piece|
      match p {
        Literal(written) -> if u.joined && is_blank(written) { { ..u, gap: written } }
        else { keep_as_written(u, written, false) },
        EncodedWord(written, Ok(field_bytes)) -> if !is_quotable(field_bytes) {
          keep_as_written(u, written, true)
        } else { { ..u, out: u.out.push(field_bytes), gap: "", joined: true, words: u.words + 1 } },
        EncodedWord(written, Err(_)) -> keep_as_written(u, written, true),
      },
  );
  {
    text: String::join(read.out.push(read.gap), ""),
    bad: read.bad,
    whole: read.words == 1 && read.others == 0 && read.gap == "",
  }
}

fn keep_as_written(u: WordDecodeState, written: String, bad: Bool) -> WordDecodeState =
  {
    out: u.out.push(u.gap).push(written),
    gap: "",
    joined: false,
    bad: u.bad || bad,
    words: u.words,
    others: u.others + 1,
  }

/// An atom of a display name, decoded where it is an encoded word.
fn decode_atom(
  context: Context,
  written: String,
  at: Int,
) -> DecodedWords / {email.fail, abort.raise} =
  if !written.contains("=?") { { text: written, bad: false, whole: false } } else {
    let read = decode_encoded_words(written);
    if read.bad && !context.obsolete { fail(at, BadEncodedWord) } else { read }
  }

/// Whether the words `r` end with an encoded word that touches the character at `r.at`, with no
/// blank between them.
fn touches(r: Run) -> Bool =
  match r.tokens.last() {
    Some(end) -> match end.token {
      Atom(written) -> end.end == r.at && written.starts_with("=?") && written.ends_with("?="),
      _ -> false,
    },
    None -> false,
  }

type ParsedMailbox = { mailbox: Mailbox, at: Int }

/// The mailbox whose opening words are `r`, which started at `from`.
fn mailbox_from(context: Context, r: Run, from: Int) -> ParsedMailbox / {email.fail, abort.raise} = {
  let c = context.b.peek(r.at);
  if c == b'<' {
    let name = if !context.obsolete && touches(r) { fail(r.at, BadEncodedWord) }
    else { phrase(context, r.tokens) };
    let a = angle(context, r.at);
    { mailbox: Mailbox(name, a.address), at: a.at }
  } else if c == b'@' {
    let s = address_spec(context, r, from);
    { mailbox: Mailbox(None, s.address), at: s.at }
  } else {
    let ends = c < 0 || c == b',' || c == b';';
    fail(r.at, if !ends { byte_problem(context, r.at) }
    else if r.tokens.len() == 0 { NoAddress }
    else { NoAt })
  }
}

type ParsedList = { entries: List<Entry>, at: Int }

type Element = { entry: Entry, at: Int }

/// What is in the place of a list's next element: the list's end, nothing before a comma, or an
/// element.
type Place = | Ended | Empty | Filled

/// What is at `r.at`, where `r` is the words read from an element's place. `any` records that an
/// element was read before, and `grouped` that a `;` ends the list.
fn place(context: Context, r: Run, any: Bool, grouped: Bool) -> Place / {email.fail} = {
  let c = context.b.peek(r.at);
  if r.tokens.len() > 0 { Filled } else if c < 0 || (grouped && c == b';') {
    if any && !context.obsolete { fail(r.at, ObsoleteSyntax) } else { Ended }
  } else if c != b',' { Filled }
  else if context.obsolete { Empty }
  else { fail(r.at, ObsoleteSyntax) }
}

/// Where a list continues after the element that ends at `at`: after a comma, or nowhere at the
/// list's end.
fn after_element(context: Context, at: Int, grouped: Bool) -> Option<Int> / {email.fail} = {
  let c = context.b.peek(at);
  if c == b',' { Some(at + 1) }
  else if c < 0 || (grouped && c == b';') { None }
  else { fail(at, byte_problem(context, at)) }
}

/// The addresses from `at` to the end of the text. `left` bounds the recursion: each step consumes
/// an address or a comma.
fn list_from(
  context: Context,
  at: Int,
  acc: List<Entry>,
  left: Int,
) -> ParsedList / {email.fail, abort.raise} = {
  let r = run(context, at);
  if left <= 0 { { entries: acc, at: r.at } } else {
    match place(context, r, acc.len() > 0, false) {
      Ended -> { entries: acc, at: r.at },
      Empty -> list_from(context, r.at + 1, acc, left - 1),
      Filled -> {
        let e = element(context, r, at);
        match after_element(context, e.at, false) {
          Some(next) -> list_from(context, next, acc.push(e.entry), left - 1),
          None -> { entries: acc.push(e.entry), at: e.at },
        }
      },
    }
  }
}

type Members = { members: List<Mailbox>, at: Int }

/// The mailboxes of a group from `at` to its `;`. `left` bounds the recursion: each step consumes
/// a mailbox or a comma.
fn members_from(
  context: Context,
  at: Int,
  acc: List<Mailbox>,
  left: Int,
) -> Members / {email.fail, abort.raise} = {
  let r = run(context, at);
  if left <= 0 { { members: acc, at: r.at } } else {
    match place(context, r, acc.len() > 0, true) {
      Ended -> { members: acc, at: r.at },
      Empty -> members_from(context, r.at + 1, acc, left - 1),
      Filled -> {
        let m = if context.b.peek(r.at) == b':' { fail(r.at, Unexpected) }
        else { mailbox_from(context, r, at) };
        match after_element(context, m.at, true) {
          Some(next) -> members_from(context, next, acc.push(m.mailbox), left - 1),
          None -> { members: acc.push(m.mailbox), at: m.at },
        }
      },
    }
  }
}

/// The mailbox or the group whose opening words are `r`, which started at `from`.
fn element(context: Context, r: Run, from: Int) -> Element / {email.fail, abort.raise} =
  if context.b.peek(r.at) != b':' {
    let m = mailbox_from(context, r, from);
    { entry: Single(m.mailbox), at: m.at }
  } else if !context.obsolete && touches(r) { fail(r.at, BadEncodedWord) } else {
    match phrase(context, r.tokens) {
      None -> fail(r.at, Unexpected),
      Some(name) -> {
        let inner = members_from(context, r.at + 1, [], context.b.len() - r.at + 2);
        if context.b.peek(inner.at) != b';' { fail(inner.at, UnclosedGroup) }
        else { { entry: Group(name, inner.members), at: cfws(context, inner.at + 1) } }
      },
    }
  }

// --- Addresses ----------------------------------------------------------------

/// An address: a local part and a domain, `jdoe` and `example.org` of `jdoe@example.org`.
///
/// The local part is its text, without the quotes and backslashes it may be written with: printable
/// characters, including a space, and at most 255 octets. It contains no `@`, though RFC 5322
/// allows one in quotes: an address has one `@`, and what follows it is its domain however a reader
/// splits it. The domain is host labels between dots, or a literal in its brackets (`[192.0.2.1]`),
/// at most 255 octets. Two addresses are `==` when their local parts are the same text, including
/// case, and their domains are the same name: in any case of ASCII letters, and with an
/// internationalized label in its script or as its A-label, since `std.idna` maps both to one name.
/// `show` writes `local@domain` as the address was written, quoting the local part if it must.
pub opaque type Address = | Address(String, String, String)

key for Address by address_key

show for Address by address_text

type AddressKey = { domain: String, local: String }

fn address_key(a: Address) -> AddressKey =
  match a { Address(local, _, shared) -> { domain: shared, local: local } }

/// The address with this local part and this domain, raising `email.fail` if either is invalid, at
/// the offending byte of that argument. The local part is given as its text, with no quotes. A tab,
/// which RFC 5322 allows in a quoted local part but SMTP cannot carry, is rejected, and so is an
/// `@`.
pub fn address(
  local: String,
  domain: String,
  repertoire: Repertoire = Ascii,
) -> Address / {email.fail, abort.raise} = {
  let context = context_of(domain, repertoire, Current);
  let d = domain_from(context, 0);
  if d.at < context.b.len() { fail(d.at, byte_problem_or(context, d.at, BadDomain)) }
  else { Address(local_checked(local, context.utf8, 0), d.text, d.key) }
}

/// An address's local part, as text: `john doe` of `"john doe"@example.org`.
pub fn local_part(a: Address) -> String = match a { Address(local, _, _) -> local }

/// An address's domain as written: host labels between dots, or a literal with its brackets.
pub fn domain(a: Address) -> String = match a { Address(_, domain, _) -> domain }

/// An address's domain in ASCII: as written if it is ASCII, and otherwise the A-labels of the name,
/// in lower case. It is what a DNS query uses and what a path without `SMTPUTF8` carries.
pub fn ascii_domain(a: Address) -> String =
  match a { Address(_, domain, shared) -> if domain.is_ascii() { domain } else { shared } }

/// The address in ASCII, its domain as `ascii_domain` writes it: what a writer under `Ascii`
/// writes. `None` when the local part is outside ASCII, which has no ASCII form.
pub fn ascii_text(a: Address) -> Option<String> =
  if is_ascii(a) { Some(local_text(local_part(a)) ++ "@" ++ ascii_domain(a)) } else { None }

/// The text between the brackets of an address whose domain is a literal, `192.0.2.1` or
/// `IPv6:2001:db8::1`; `None` for a domain that is a name. The text is kept as written and is
/// not parsed as an address of any kind.
pub fn domain_literal(a: Address) -> Option<String> / {abort.raise} = {
  let d = domain(a);
  if d.starts_with("[") { Some(d.slice(1, d.len() - 1)) } else { None }
}

/// Whether an address can be written in ASCII alone, so that a message need not use `SMTPUTF8`
/// for it: its local part is ASCII. A domain always can be, as its A-labels.
pub fn is_ascii(a: Address) -> Bool = local_part(a).is_ascii()

/// The address in `text`, raising `email.fail` where `parse_address` returns `Err`: a local
/// part, `@` and a domain in RFC 5322's current syntax, with no blank and no comment anywhere.
pub fn read_address(
  text: String,
  repertoire: Repertoire = Ascii,
) -> Address / {email.fail, abort.raise} = {
  let context = context_of(text, repertoire, Current);
  let r = run(context, 0);
  let tight = r.tokens.all(|t: TokenSpan| !t.spaced)
    && (match r.tokens.last() { Some(t) -> t.end == r.at, None -> true });
  if context.b.peek(r.at) != b'@' {
    fail(r.at, if context.b.peek(r.at) >= 0 { byte_problem_or(context, r.at, NoAt) }
    else if r.tokens.len() == 0 { NoAddress }
    else { NoAt })
  } else if !tight { fail(0, Unexpected) } else {
    let local = local_of(context, r.tokens, 0);
    let d = domain_from(context, r.at + 1);
    if d.at < context.b.len() { fail(d.at, byte_problem(context, d.at)) }
    else if Bytes::of_string(d.text).len() != d.at - r.at - 1 { fail(r.at + 1, Unexpected) }
    else { Address(local, d.text, d.key) }
  }
}

/// The address in `text`, or where and why it stops being one.
pub fn parse_address(
  text: String,
  repertoire: Repertoire = Ascii,
) -> Result<Address, Error> / {abort.raise} = try { read_address(text, repertoire) }

/// Checks an `email"..."` literal.
///
/// Returns the address `read_address` returns under `Utf8`. Otherwise returns why the text is not
/// an address, and the offset of the character where it stops being one.
pub fn literal(text: String) -> Result<Address, { message: String, offset: Int }> / {abort.raise} =
  match parse_address(text, Utf8) {
    Ok(a) -> Ok(a),
    Err(r) ->
      Err({
        message: explain(r.reason),
        offset: String::of_bytes_lossy(Bytes::of_string(text).slice(0, r.at)).len(),
      }),
  }

fn address_text(a: Address) -> String =
  match a { Address(local, domain, _) -> local_text(local) ++ "@" ++ domain }

fn local_text(local: String) -> String = if is_dot_atom(local) { local } else { quote(local) }

/// `text` in quotes, with a backslash before each quote and backslash in it.
fn quote(text: String) -> String =
  "\""
    ++ String::of_chars(
      text.chars().fold([], |acc: List<Char>, c: Char|
        if c == '"' || c == '\\' { acc.push('\\').push(c) } else { acc.push(c) }),
    )
    ++ "\""

/// Whether `text` is atoms between single dots, which a local part is written as without quotes.
fn is_dot_atom(text: String) -> Bool = {
  let seen = text.chars().fold({ ok: true, dot: true }, |s: { ok: Bool, dot: Bool }, c: Char|
    if c == '.' { { ok: s.ok && !s.dot, dot: true } }
    else { { ok: s.ok && is_atom_char(c), dot: false } });
  seen.ok && !seen.dot
}

fn is_atom_char(c: Char) -> Bool =
  Int::of_char(c) > 127
    || "!#$%&'*+-/0123456789=?ABCDEFGHIJKLMNOPQRSTUVWXYZ^_`abcdefghijklmnopqrstuvwxyz{|}~".contains(
      String::of_chars([c]),
    )

// --- Mailboxes and address lists ----------------------------------------------

/// A mailbox: an address, and its display name, if any. A name contains no control character but a
/// tab and is never empty. `show` writes `Name <local@domain>`, quoting the name if it is not
/// plain words.
pub opaque type Mailbox = | Mailbox(Option<String>, Address)

key for Mailbox by mailbox_key

show for Mailbox by mailbox_text

type MailboxKey = { address: AddressKey, name: Option<String> }

fn mailbox_key(m: Mailbox) -> MailboxKey =
  match m { Mailbox(name, a) -> { address: address_key(a), name: name } }

/// The mailbox of an address with no name.
pub fn mailbox(a: Address) -> Mailbox = Mailbox(None, a)

/// The mailbox of an address with a display name, raising `email.fail` at the offending byte for a
/// name that contains a line break or a control character other than a tab. An empty name means no
/// name.
pub fn named_mailbox(name: String, a: Address) -> Mailbox / {email.fail, abort.raise} =
  Mailbox(if name == "" { None } else { Some(header_text(name)) }, a)

/// `text`, checked to fit in a field's value: no control character but a tab.
fn header_text(text: String) -> String / {email.fail, abort.raise} = {
  let b = Bytes::of_string(text);
  let stop = b.skip_until(0, controls());
  if stop < b.len() {
    fail(stop, if b.at(stop) == b'\r' || b.at(stop) == b'\n' { LineBreak } else { Control })
  } else { text }
}

/// A mailbox's display name.
pub fn display_name(m: Mailbox) -> Option<String> = match m { Mailbox(name, _) -> name }

/// A mailbox's address.
pub fn address_of(m: Mailbox) -> Address = match m { Mailbox(_, a) -> a }

/// The mailbox in `text`, raising `email.fail` where `parse_mailbox` returns `Err`: an address
/// alone, or a display name and an address in angle brackets, with comments wherever RFC 5322
/// allows them. `text` is an unfolded field value: a line break in it is rejected.
pub fn read_mailbox(
  text: String,
  repertoire: Repertoire = Ascii,
  syntax: Syntax = Obsolete,
) -> Mailbox / {email.fail, abort.raise} = {
  let context = context_of(text, repertoire, syntax);
  let m = mailbox_from(context, run(context, 0), 0);
  if m.at < context.b.len() { fail(m.at, byte_problem(context, m.at)) } else { m.mailbox }
}

/// The mailbox in `text`, or where and why it stops being one.
pub fn parse_mailbox(
  text: String,
  repertoire: Repertoire = Ascii,
  syntax: Syntax = Obsolete,
) -> Result<Mailbox, Error> / {abort.raise} = try { read_mailbox(text, repertoire, syntax) }

fn mailbox_text(m: Mailbox) -> String =
  match m {
    Mailbox(None, a) -> address_text(a),
    Mailbox(Some(name), a) -> phrase_text(name) ++ " <" ++ address_text(a) ++ ">",
  }

/// A display name as `show` writes it: unchanged if it is atoms with one space between them and
/// none is an encoded word, and quoted otherwise.
fn phrase_text(name: String) -> String =
  if is_words(name) && !name.contains("=?") { name } else { quote(name) }

/// Whether `text` is atoms with a single space between them.
fn is_words(text: String) -> Bool = {
  let seen = text.chars().fold({ ok: true, gap: true }, |s: { ok: Bool, gap: Bool }, c: Char|
    if c == ' ' { { ok: s.ok && !s.gap, gap: true } }
    else { { ok: s.ok && is_atom_char(c), gap: false } });
  seen.ok && !seen.gap
}

/// One element of an address list: a mailbox, or a group, which is a name and the mailboxes
/// listed under it, none for `undisclosed-recipients:;`.
pub opaque type Entry = | Single(Mailbox) | Group(String, List<Mailbox>)

show for Entry by entry_text

/// The entry that is one mailbox.
pub fn mailbox_entry(m: Mailbox) -> Entry = Single(m)

/// Each mailbox as an entry of its own.
pub fn mailbox_entries(ms: List<Mailbox>) -> List<Entry> = ms.map(mailbox_entry)

/// The group of this name and these members, raising `email.fail` for a name that is empty or
/// contains a line break or a control character other than a tab.
pub fn group(name: String, members: List<Mailbox>) -> Entry / {email.fail, abort.raise} =
  if name == "" { fail(0, NoAddress) } else { Group(header_text(name), members) }

/// A group's name; `None` for an entry that is a mailbox.
pub fn group_name(e: Entry) -> Option<String> =
  match e { Single(_) -> None, Group(name, _) -> Some(name) }

/// The mailboxes in an entry: itself, or a group's members.
pub fn members(e: Entry) -> List<Mailbox> = match e { Single(m) -> [m], Group(_, held) -> held }

/// Every mailbox of an address list in the order written, groups flattened.
pub fn mailboxes_of(es: List<Entry>) -> List<Mailbox> = es.flat_map(members)

/// The address list in `text`, raising `email.fail` where `parse_address_list` returns `Err`:
/// RFC 5322's `address-list`, mailboxes and groups separated by commas. `text` is an unfolded field
/// value: a line break in it is rejected. An empty list is rejected too.
pub fn read_address_list(
  text: String,
  repertoire: Repertoire = Ascii,
  syntax: Syntax = Obsolete,
) -> List<Entry> / {email.fail, abort.raise} = {
  let context = context_of(text, repertoire, syntax);
  let read = list_from(context, 0, [], context.b.len() + 2);
  if read.at < context.b.len() { fail(read.at, byte_problem(context, read.at)) }
  else if read.entries.len() == 0 { fail(read.at, NoAddress) }
  else { read.entries }
}

/// The address list in `text`, or where and why it stops being one.
pub fn parse_address_list(
  text: String,
  repertoire: Repertoire = Ascii,
  syntax: Syntax = Obsolete,
) -> Result<List<Entry>, Error> / {abort.raise} =
  try { read_address_list(text, repertoire, syntax) }

fn entry_text(e: Entry) -> String =
  match e {
    Single(m) -> mailbox_text(m),
    Group(name, held) ->
      phrase_text(name) ++ ":" ++ String::join(held.map(mailbox_text), ", ") ++ ";",
  }

/// An address list as `show` writes its entries, with `, ` between them: what
/// `read_address_list` reads back under `Utf8` and `Current`.
pub fn address_list_text(es: List<Entry>) -> String = String::join(es.map(entry_text), ", ")

// --- Generators ---------------------------------------------------------------

/// A text of `least` to `most` characters, each one of `chars`.
fn arbitrary_text(chars: String, least: Int, most: Int) -> Gen<String> =
  gen::and_then(gen::int_between(least, most), |n: Int|
    gen::map(gen::list_of_length(gen::elements(chars.chars()), n), |cs: List<Char>|
      String::of_chars(cs)))

/// One to three of what `g` draws, with `sep` between them.
fn several(g: Gen<String>, sep: String) -> Gen<String> =
  gen::and_then(gen::int_between(1, 3), |n: Int|
    gen::map(gen::list_of_length(g, n), |held: List<String>| String::join(held, sep)))

fn arbitrary_local_part() -> Gen<String> =
  gen::one_of([
    several(arbitrary_text("abcxyzABC019", 1, 6), "."),
    several(arbitrary_text("ab0!#$%&'*+-/=?^_`{|}~", 1, 4), "."),
    arbitrary_text("ab .\"\\(),:;<>[]", 0, 8),
    arbitrary_text("a\u{e9}\u{65e5}\u{1f600}.", 1, 5),
  ])

fn arbitrary_label() -> Gen<String> =
  gen::map2(
    arbitrary_text("abcXYZ019", 1, 4),
    arbitrary_text("abc019-", 0, 3),
    |head: String, tail: String| head ++ tail ++ "z",
  )

/// A domain as written, and the key its equivalent forms share.
type ArbitraryDomain = { text: String, shared: String }

fn arbitrary_domain() -> Gen<ArbitraryDomain> =
  gen::one_of([
    gen::map(several(arbitrary_label(), "."), |name: String|
      { text: name, shared: name.ascii_lower() }),
    gen::elements([
      { text: "example.org", shared: "example.org" },
      { text: "EXAMPLE.org", shared: "example.org" },
      { text: "[192.0.2.1]", shared: "[192.0.2.1]" },
      { text: "[IPv6:2001:db8::1]", shared: "[ipv6:2001:db8::1]" },
      { text: "xn--bcher-kva.example", shared: "xn--bcher-kva.example" },
      { text: "b\u{fc}cher.example", shared: "xn--bcher-kva.example" },
      { text: "B\u{dc}CHER.Example", shared: "xn--bcher-kva.example" },
      { text: "\u{4f8b}\u{3048}.jp", shared: "xn--r8jz45g.jp" },
      { text: "\u{5d0}\u{5d1}.xn--4dbc", shared: "xn--4dbc.xn--4dbc" },
    ]),
  ])

/// Addresses of every kind a reader returns: plain and quoted local parts, UTF-8 ones, and for
/// domains names, literals and internationalized names in their script and as A-labels.
pub fn addresses() -> Gen<Address> =
  gen::map2(arbitrary_local_part(), arbitrary_domain(), |local: String, d: ArbitraryDomain|
    Address(local, d.text, d.shared))

fn arbitrary_display_name() -> Gen<String> =
  gen::one_of([
    several(arbitrary_text("abcXYZ", 1, 6), " "),
    arbitrary_text("ab Z.,\"\\()<>@:;=?_\t", 1, 10),
    arbitrary_text("a \u{e9}\u{65e5}\u{1f600}", 1, 6),
  ])

/// Mailboxes with no name, plain names, names that must be quoted and names outside ASCII.
pub fn mailboxes() -> Gen<Mailbox> =
  gen::map2(
    gen::option_of(arbitrary_display_name()),
    addresses(),
    |name: Option<String>, a: Address| Mailbox(name, a),
  )

/// Mailboxes, and groups of none to three.
pub fn entries() -> Gen<Entry> =
  gen::one_of([
    gen::map(mailboxes(), mailbox_entry),
    gen::map(mailboxes(), mailbox_entry),
    gen::map2(
      arbitrary_display_name(),
      gen::list_of(mailboxes(), 3),
      |name: String, held: List<Mailbox>| Group(name, held),
    ),
  ])

// --- Message identifiers ------------------------------------------------------

/// A message identifier: the text between the angle brackets of a `Message-ID`, a
/// `Content-ID` or one of the `References`. It is ASCII text with no blank, no control character
/// and no angle bracket, short enough for a line, and two are `==` when they are the same text.
/// `show` writes it in its brackets.
pub opaque type MessageId = | MessageId(String)

show for MessageId by id_text

/// The identifier `left@right`, raising `email.fail` if either side is not what RFC 5322 tells a
/// writer to write: atoms between single dots, or for the right side a domain literal.
pub fn message_id(left: String, right: String) -> MessageId / {email.fail, abort.raise} = {
  let l = Bytes::of_string(left);
  if !is_dot_atom(left) || l.skip(0, atext().concat(b".")) < l.len() { fail(0, BadMessageId) }
  else {
    let context = context_of(right, Ascii, Current);
    let d = domain_from(context, 0);
    if d.at < context.b.len() || d.text != right { fail(d.at, BadMessageId) }
    else { identifier(left ++ "@" ++ right, 0) }
  }
}

/// The identifier `text`, checked to be valid.
fn identifier(text: String, at: Int) -> MessageId / {email.fail, abort.raise} = {
  let b = Bytes::of_string(text);
  let n = b.len();
  if n == 0 || b.skip(0, id_chars()) < n { fail(at, BadMessageId) }
  else if n > 995 { fail(at, TooLong) }
  else { MessageId(text) }
}

/// An identifier in its angle brackets, `<left@right>`.
pub fn id_text(i: MessageId) -> String = match i { MessageId(text) -> "<" ++ text ++ ">" }

/// The identifiers in `text`, raising `email.fail` where `parse_message_ids` returns `Err`: each
/// `<` and `>` around text with no blank, with blanks and comments between them, as a `Message-ID`,
/// an `In-Reply-To` or a `References` field carries. Under `Obsolete` a blank or a comment inside
/// the brackets is skipped, and so are the words and commas old mail wrote between identifiers.
pub fn read_message_ids(
  text: String,
  syntax: Syntax = Current,
) -> List<MessageId> / {email.fail, abort.raise} = {
  let context = context_of(text, Ascii, syntax);
  let n = context.b.len() + 2;
  if context.obsolete { ids_from(context, 0, [], n) } else {
    match try { ids_from(context, 0, [], n) } {
      Ok(found) -> found,
      Err(r) ->
        fail(r.at, if Result::is_ok(try { ids_from({ ..context, obsolete: true }, 0, [], n) }) {
          ObsoleteSyntax
        } else { r.reason }),
    }
  }
}

/// The identifiers in `text`, or where and why it stops being identifiers.
pub fn parse_message_ids(
  text: String,
  syntax: Syntax = Current,
) -> Result<List<MessageId>, Error> / {abort.raise} = try { read_message_ids(text, syntax) }

/// `left` bounds the recursion: each step consumes an identifier, a word or a comma.
fn ids_from(
  context: Context,
  at: Int,
  acc: List<MessageId>,
  left: Int,
) -> List<MessageId> / {email.fail, abort.raise} = {
  let start = cfws(context, at);
  let c = context.b.peek(start);
  if c < 0 || left <= 0 { acc } else if c == b'<' {
    let close = context.b.skip_until(start + 1, b">");
    let inner = context.b.slice(start + 1, close);
    if close >= context.b.len() { fail(close, UnclosedAngle) }
    else if inner.len() > 0 && inner.skip(0, id_chars()) == inner.len() {
      ids_from(context, close + 1, acc.push(identifier(String::of_bytes(inner), start)), left - 1)
    } else if !context.obsolete {
      fail(start, byte_problem_or(context, start + 1 + inner.skip(0, id_chars()), BadMessageId))
    } else {
      let i = spaced_id(context, start);
      ids_from(context, i.at, acc.push(identifier(i.text, start)), left - 1)
    }
  } else if !context.obsolete { fail(start, byte_problem_or(context, start, BadMessageId)) }
  else if c == b',' { ids_from(context, start + 1, acc, left - 1) } else {
    let r = run(context, start);
    if r.at == start { fail(start, byte_problem_or(context, start, BadMessageId)) }
    else { ids_from(context, r.at, acc, left - 1) }
  }
}

/// The identifier whose `<` is at `at`, written with blanks or comments inside its brackets as RFC
/// 5322 §4 allows: a local part, `@` and a domain, read as an address's are.
fn spaced_id(context: Context, at: Int) -> Text / {email.fail, abort.raise} = {
  let r = run(context, at + 1);
  if context.b.peek(r.at) != b'@' { fail(at, byte_problem_or(context, r.at, BadMessageId)) } else {
    let left = String::join(r.tokens.map(token_text), "");
    let start = cfws(context, r.at + 1);
    let right = if context.b.peek(start) == b'[' { bracketed(context, start) } else {
      let read = labels(context, { at: start, held: [] }, context.b.len() - start + 1);
      { text: String::join(read.held, "."), at: read.at }
    };
    let close = cfws(context, right.at);
    if context.b.peek(close) != b'>' { fail(close, UnclosedAngle) }
    else { { text: left ++ "@" ++ right.text, at: close + 1 } }
  }
}

/// An identifier whose left side is the host's entropy and whose right side is `domain`, as RFC
/// 5322 recommends. Raises `email.fail` for an invalid domain.
pub fn fresh_id(domain: String) -> MessageId / {entropy.next bounded, email.fail, abort.raise} =
  message_id(nonce(), domain)

/// Identifiers as `message_id` creates them, and the bare words old mail used.
pub fn ids() -> Gen<MessageId> =
  gen::one_of([
    gen::map2(
      several(arbitrary_text("abc019$=+", 1, 6), "."),
      arbitrary_label(),
      |l: String, r: String| MessageId(l ++ "@" ++ r ++ ".example"),
    ),
    gen::map(arbitrary_text("ab01.@[]:/", 1, 12), |text: String| MessageId(text)),
  ])

// --- Fields -------------------------------------------------------------------

/// One header field.
pub opaque type Field = new {
  /// The field's name as written: `Subject`, in whatever case.
  name: String,
  /// The field exactly as in the message: its name, its colon, its value on as many lines as it
  /// was folded over, and its line break.
  raw: Bytes,
  /// The value unfolded, without the blanks around it. Encoded words in it are as written:
  /// `unstructured` decodes them.
  value: String,
}

/// The field `name: value`, folded at its spaces to lines of 78 octets where possible and 998 at
/// most. Raises `email.fail`, at the offending byte of the argument, for an invalid field name, and
/// for a value that contains a line break, a control character other than a tab, a character
/// outside ASCII when `Utf8` is not requested, or a run between two spaces too long for any line.
/// The value is written as given, with no encoding: `text_field` writes text outside ASCII.
pub fn field(
  name: String,
  value: String,
  repertoire: Repertoire = Ascii,
) -> Field / {email.fail, abort.raise} = {
  let held = String::of_chars(trimmed(header_text(value).chars()));
  let cut = stretches(held);
  let eight = Bytes::of_string(held).skip_until(0, high());
  if eight < Bytes::of_string(held).len() && repertoire == Ascii { fail(eight, NonAscii) }
  else if cut.any(|s: String| Bytes::of_string(s).len() > 998) { fail(0, TooLong) }
  else { { name: field_name(name), raw: folded(name, cut), value: held } }
}

/// The field `name` whose value is `text` as an unstructured field carries it: unchanged if it is
/// printable ASCII, or under `Utf8` any printable text, and in encoded words otherwise. Raises
/// `email.fail` as `field` does, except for a character outside ASCII.
pub fn text_field(
  name: String,
  text: String,
  repertoire: Repertoire = Ascii,
) -> Field / {email.fail, abort.raise} = {
  let raw = folded(field_name(name), text_stretches(header_text(text), repertoire == Utf8));
  { name: name, raw: raw, value: value_of(raw) }
}

/// `name`, checked to be a valid field name: printable ASCII with no space and no colon, short
/// enough to leave room on a line.
fn field_name(name: String) -> String / {email.fail, abort.raise} = {
  let n = Bytes::of_string(name);
  let stop = n.skip(0, ftext());
  if n.len() == 0 || n.len() > 76 || stop < n.len() { fail(min(stop, 76), BadName) } else { name }
}

/// `chars` without the spaces and tabs at either end.
fn trimmed(chars: List<Char>) -> List<Char> = {
  let blank = |c: Char| c == ' ' || c == '\t';
  chars.drop_while(blank).reverse().drop_while(blank).reverse()
}

/// `text` split before each run of spaces, each piece starting with its spaces and the first with
/// the space that follows a field's colon: where a field's line may be folded.
fn stretches(text: String) -> List<String> =
  text.split(" ").fold(
    { out: [], pad: " " },
    |s: { out: List<String>, pad: String }, part: String|
      if part == "" { { out: s.out, pad: s.pad ++ " " } }
      else { { out: s.out.push(s.pad ++ part), pad: " " } },
  ).out

type Folding = { out: List<Bytes>, width: Int, fresh: Bool }

/// A field's lines: its name and colon, then each piece, with a line break before one that would
/// take a line past 78 octets when the line already contains a piece, and before one that would
/// take it past 998.
fn folded(name: String, cut: List<String>) -> Bytes = {
  let head = Bytes::of_string(name ++ ":");
  let done = cut.fold({ out: [head], width: head.len(), fresh: true }, |f: Folding, s: String| {
    let piece = Bytes::of_string(s);
    let wide = piece.len();
    if (f.width + wide > 78 && !f.fresh) || f.width + wide > 998 {
      { out: f.out.push(b"\r\n").push(piece), width: wide, fresh: false }
    } else { { out: f.out.push(piece), width: f.width + wide, fresh: false } }
  });
  Bytes::concat_all(done.out.push(b"\r\n"))
}

/// The pieces that carry `text` as an unstructured value: its words if it is plain, and encoded
/// words otherwise.
fn text_stretches(text: String, utf8: Bool) -> List<String> / {abort.raise} = {
  let cut = stretches(text);
  if is_plain(text, utf8) && cut.all(|s: String| Bytes::of_string(s).len() <= 998) { cut }
  else { encode_words(text, coding_for(text)).map(|w: String| " " ++ w) }
}

/// Whether `text` written unchanged reads back as itself: printable, with no blank at either end
/// and nothing shaped like an encoded word.
fn is_plain(text: String, utf8: Bool) -> Bool / {abort.raise} = {
  let b = Bytes::of_string(text);
  !text.contains("=?") && !text.starts_with(" ") && !text.ends_with(" ")
    && b.skip(0, if utf8 { printable_wide() } else { printable() }) == b.len()
    && !has_c1(text)
}

/// Whether `text` contains one of the control characters `U+0080` to `U+009F`.
fn has_c1(text: String) -> Bool =
  text.chars().any(|c: Char| Int::of_char(c) >= 128 && Int::of_char(c) < 160)

/// What `Q` writes unchanged, and a space.
fn q_plain() -> Bytes = b" !*+-/0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

/// The coding that writes `text` in fewer characters: `Q` when few of its bytes need an escape.
fn coding_for(text: String) -> encoded_word::Coding / {abort.raise} =
  if mostly(Bytes::of_string(text), q_plain()) { encoded_word::Q } else { encoded_word::B }

/// Whether fewer than one in six of the first 4096 bytes of `data` are outside `plain`, which is
/// when escaping them takes less space than base64 does.
fn mostly(data: Bytes, plain: Bytes) -> Bool / {abort.raise} = {
  let head = data.slice(0, min(data.len(), 4096));
  count_outside(head, plain, 0, 0, head.len() + 1) * 6 < head.len()
}

/// How many bytes of `b` from `at` on are not in `plain`, plus `count`. `left` bounds the
/// recursion: each step consumes a run of them.
fn count_outside(b: Bytes, plain: Bytes, at: Int, count: Int, left: Int) -> Int / {abort.raise} = {
  let stop = b.skip(at, plain);
  let next = b.skip_until(stop, plain);
  if left <= 0 || stop >= b.len() { count }
  else { count_outside(b, plain, next, count + next - stop, left - 1) }
}

/// A field's value unfolded: what follows its colon, without its line breaks and the blanks
/// around it, and with `U+FFFD` for bytes that are not UTF-8.
fn value_of(raw: Bytes) -> String / {abort.raise} = {
  let n = raw.len();
  let colon = match raw.index_of_byte(b':') { Some(i) -> i + 1, None -> n };
  let held = raw.slice(colon, n).replace(b"\r", b"").replace(b"\n", b"");
  String::of_chars(trimmed(String::of_bytes_lossy(held).chars()))
}

// --- Messages -----------------------------------------------------------------

/// What reading one message may cost. A message past a limit is rejected where it passes it, by
/// `read_tolerant` too.
pub type Limits = new {
  /// Bytes in the whole message.
  max_bytes: Int,
  /// Header fields in one header block: the message's, or a part's.
  max_fields: Int,
  /// Bytes in one header block.
  max_header_bytes: Int,
  /// How deep multipart bodies nest. At `0` none is read.
  max_depth: Int,
  /// Parts in the whole message, at every depth.
  max_parts: Int,
}

/// 25 MiB a message, a thousand fields and 256 KiB a header block, and a thousand parts nested
/// eight deep.
pub fn default_limits() -> Limits =
  { max_bytes: 26214400, max_fields: 1000, max_header_bytes: 262144, max_depth: 8, max_parts: 1000 }

/// What one entity contains: its fields, the blank line after them as written, its body, and
/// whether it was read under `Utf8`.
type MessageData = { fields: List<Field>, gap: Bytes, body: Bytes, utf8: Bool }

/// A message, or one part of one: header fields in the order written, and a body. It keeps the
/// bytes it was read from, so `render` returns them again, and the parts of a multipart body as
/// messages of their own.
pub opaque type Message = | Message(MessageData, List<Message>)

fn held(m: Message) -> MessageData = match m { Message(h, _) -> h }

/// The bytes a message was read from, exactly.
pub fn render(m: Message) -> Bytes = {
  let h = held(m);
  Bytes::concat_all(h.fields.map(|f: Field| f.raw).push(h.gap).push(h.body))
}

/// A message's header fields, in the order written.
pub fn fields(m: Message) -> List<Field> = held(m).fields

/// A message's body as it was transferred, its transfer encoding not undone: everything after
/// the blank line that ends the header block.
pub fn body(m: Message) -> Bytes = held(m).body

/// The parts of a multipart message, each a message of its own; none for any other. A part of
/// `message/rfc822` is a part like any other: its body is a message for a reader to read in turn.
pub fn parts(m: Message) -> List<Message> = match m { Message(_, children) -> children }

fn fields_named(held: List<Field>, lower: String) -> List<Field> =
  held.filter(|f: Field| f.name.ascii_lower() == lower)

/// The unfolded value of a message's first field named `name`, in any case.
pub fn header(m: Message, name: String) -> Option<String> =
  fields_named(held(m).fields, name.ascii_lower()).first().map(|f: Field| f.value)

/// The unfolded value of each of a message's fields named `name`, in the order written.
pub fn headers(m: Message, name: String) -> List<String> =
  fields_named(held(m).fields, name.ascii_lower()).map(|f: Field| f.value)

/// A message read by `read_tolerant`, and everything `read` would have rejected it for, in order
/// of position.
pub type MessageWithDefects = { message: Message, defects: List<Error> }

/// The message in `data`, raising `email.fail` where `parse` returns `Err`: what a conforming
/// writer writes, and nothing else. Lines end with CRLF and contain at most 998 octets; a header
/// block is fields and their folded lines, ended by a blank line or the message's end; `Date` and
/// `From` are present, and no field RFC 5322 allows once appears twice; each field whose value this
/// module reads parses in RFC 5322's current syntax; a header contains ASCII, or under `Utf8`
/// UTF-8; a body is in the transfer encoding it names, and a multipart body is parts under its
/// boundary, closed. A body whose encoding is `binary` has no line rules to follow.
pub fn read(
  data: Bytes,
  limits: Limits,
  repertoire: Repertoire = Ascii,
) -> Message / {email.fail, abort.raise} = {
  let read = read_tolerant(data, limits, repertoire);
  match read.defects { [] -> read.message, [found, ..] -> fail(found.at, found.reason) }
}

/// The message in `data`, or where and why it is rejected.
pub fn parse(
  data: Bytes,
  limits: Limits,
  repertoire: Repertoire = Ascii,
) -> Result<Message, Error> / {abort.raise} = try { read(data, limits, repertoire) }

/// The message in `data`, with each defect `read` would have rejected it for, raising `email.fail`
/// only for a message past a limit. Any bytes are read: a line feed alone ends a line; a line of a
/// header block that is not a field ends the block and starts the body; a field whose value does
/// not parse is kept as written, and its typed reader returns nothing; a multipart body with no
/// closing delimiter has the parts found before its end, and one `std.multipart` rejects for any
/// other reason is kept as one part.
pub fn read_tolerant(
  data: Bytes,
  limits: Limits,
  repertoire: Repertoire = Ascii,
) -> MessageWithDefects / {email.fail, abort.raise} = {
  let most = max(limits.max_bytes, 0);
  if data.len() > most { fail(most, TooLarge) } else {
    let settings = { limits: limits, utf8: repertoire == Utf8 };
    let read = entity(data, 0, settings, limits.max_depth, limits.max_parts);
    let all_found = read.defects.concat(top_checks(held(read.message).fields, settings.utf8));
    { message: read.message, defects: all_found.sort_by(|a: Error, b: Error| a.at < b.at) }
  }
}

/// The message in `data` with its defects, or the limit it passes.
pub fn parse_tolerant(
  data: Bytes,
  limits: Limits,
  repertoire: Repertoire = Ascii,
) -> Result<MessageWithDefects, Error> / {abort.raise} =
  try { read_tolerant(data, limits, repertoire) }

type ReadSettings = { limits: Limits, utf8: Bool }

/// A header block read: its fields, the blank line that ends it as written, and where the body
/// starts.
type Block = { fields: List<Field>, gap: Bytes, body_at: Int, defects: List<Error> }

/// A header block reader's state: at a line's start, inside the field that started at `start`, or
/// in no field when `start` is below zero.
type HeaderScan = { at: Int, start: Int, fields: List<Field>, defects: List<Error> }

fn block(b: Bytes, origin: Int, settings: ReadSettings) -> Block / {email.fail, abort.raise} =
  block_from(b, origin, settings, { at: 0, start: -1, fields: [], defects: [] }, b.len() + 2)

/// `left` bounds the recursion: each step consumes a line.
fn block_from(
  b: Bytes,
  origin: Int,
  settings: ReadSettings,
  h: HeaderScan,
  left: Int,
) -> Block / {email.fail, abort.raise} = {
  let n = b.len();
  let feed = b.skip_until(h.at, b"\n");
  let next = min(feed + 1, n);
  let end = if feed > h.at && b.at(feed - 1) == b'\r' { feed - 1 } else { feed };
  let most = max(settings.limits.max_header_bytes, 0);
  if h.at > most { fail(origin + most, HeadersTooLarge) }
  else if left <= 0 || h.at >= n || end == h.at { end_block(b, origin, settings, h, next, None) }
  else if !bytes::is_blank(b.at(h.at)) {
    match named_line(b, origin, settings, h) {
      Some(opened) -> block_from(b, origin, settings, opened, left - 1),
      None -> end_block(b, origin, settings, h, h.at, Some(NoBlankLine)),
    }
  } else if h.start < 0 { end_block(b, origin, settings, h, h.at, Some(NoBlankLine)) } else {
    let blank = b.skip(h.at, b" \t") >= end;
    block_from(
      b,
      origin,
      settings,
      { ..h, at: next, defects: line_found(h.defects, origin, h.at, blank, feed >= n, n) },
      left - 1,
    )
  }
}

/// The reader after the line at `h.at`, which starts with no blank, if that line starts a field;
/// `None` if it is not a field's line.
fn named_line(
  b: Bytes,
  origin: Int,
  settings: ReadSettings,
  h: HeaderScan,
) -> Option<HeaderScan> / {email.fail, abort.raise} = {
  let n = b.len();
  let feed = b.skip_until(h.at, b"\n");
  let name_end = b.skip(h.at, ftext());
  let colon = b.skip(name_end, b" \t");
  if name_end == h.at || b.peek(colon) != b':' { None } else {
    let done = close_field(b, origin, settings, h, h.at);
    Some({
      at: min(feed + 1, n),
      start: h.at,
      fields: done.fields,
      defects: line_found(done.defects, origin, h.at, colon > name_end, feed >= n, n),
    })
  }
}

/// `defects` with what a header line at `at` revealed: obsolete syntax, or no line break.
fn line_found(
  defects: List<Error>,
  origin: Int,
  at: Int,
  obsolete: Bool,
  open: Bool,
  n: Int,
) -> List<Error> = {
  let with_obsolete = if obsolete { defects.push({ at: origin + at, reason: ObsoleteSyntax }) }
  else { defects };
  if open { with_obsolete.push({ at: origin + n, reason: Truncated }) } else { with_obsolete }
}

/// The block that ends at `h.at`, its body starting at `body_at`.
fn end_block(
  b: Bytes,
  origin: Int,
  settings: ReadSettings,
  h: HeaderScan,
  body_at: Int,
  reason: Option<ErrorKind>,
) -> Block / {email.fail, abort.raise} = {
  let done = close_field(b, origin, settings, h, h.at);
  {
    fields: done.fields,
    gap: b.slice(h.at, body_at),
    body_at: body_at,
    defects: match reason {
      Some(found) -> done.defects.push({ at: origin + h.at, reason: found }),
      None -> done.defects,
    },
  }
}

/// `h` with the field it is in ended at `to`.
fn close_field(
  b: Bytes,
  origin: Int,
  settings: ReadSettings,
  h: HeaderScan,
  to: Int,
) -> HeaderScan / {email.fail, abort.raise} =
  if h.start < 0 { h }
  else if h.fields.len() >= settings.limits.max_fields { fail(origin + h.start, TooManyFields) }
  else {
    let raw = b.slice(h.start, to);
    {
      at: h.at,
      start: -1,
      fields: h.fields.push({
        name: String::of_bytes(raw.slice(0, raw.skip(0, ftext()))),
        raw: raw,
        value: value_of(raw),
      }),
      defects: h.defects.concat(field_defects(raw, origin + h.start, settings.utf8)),
    }
  }

/// Every control character a header field may not contain: all but a tab and the two of a line
/// break.
fn field_controls() -> Bytes =
  b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x0b\x0c\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x7f"

fn field_defects(raw: Bytes, at: Int, utf8: Bool) -> List<Error> / {abort.raise} = {
  let n = raw.len();
  let eight = raw.skip_until(0, high());
  let control = raw.skip_until(0, field_controls());
  List::concat(
    if eight < n && !(utf8 && raw.is_utf8()) { [{ at: at + eight, reason: EightBitHeader }] }
    else { [] },
    if control < n { [{ at: at + control, reason: Control }] } else { [] },
  )
}

/// A line reader's state, and the first bare line feed, bare carriage return and line past 998
/// octets it found, each below zero until it finds one.
type LineScan = { at: Int, start: Int, feed: Int, ret: Int, long: Int }

/// What keeps `data` from being lines as a message has them, each ending with CRLF and containing
/// at most 998 octets: the first line feed with no carriage return before it, the first carriage
/// return with no line feed after it and the first line too long, in that order, each at its
/// offset. A transport checks this before it sends bytes it did not write.
pub fn line_flaws(data: Bytes) -> List<Error> / {abort.raise} = line_defects(data, 0)

/// What is wrong with the lines of `b`, which starts at `origin`: the first of each kind.
fn line_defects(b: Bytes, origin: Int) -> List<Error> / {abort.raise} = {
  let seen = lines_from(b, { at: 0, start: 0, feed: -1, ret: -1, long: -1 }, b.len() + 2);
  List::concat(
    if seen.feed < 0 { [] } else { [{ at: origin + seen.feed, reason: BareLineFeed }] },
    if seen.ret < 0 { [] } else { [{ at: origin + seen.ret, reason: BareCarriageReturn }] },
  ).concat(if seen.long < 0 { [] } else { [{ at: origin + seen.long, reason: LongLine }] })
}

/// `left` bounds the recursion: each step consumes a carriage return or a line feed.
fn lines_from(b: Bytes, s: LineScan, left: Int) -> LineScan / {abort.raise} = {
  let stop = b.skip_until(s.at, b"\r\n");
  let c = b.peek(stop);
  let long = if s.long < 0 && stop - s.start > 998 { s.start + 998 } else { s.long };
  if c < 0 || left <= 0 { { ..s, long: long } } else if c == b'\r' && b.peek(stop + 1) == b'\n' {
    lines_from(b, { ..s, at: stop + 2, start: stop + 2, long: long }, left - 1)
  } else if c == b'\r' {
    lines_from(
      b,
      { ..s, at: stop + 1, ret: if s.ret < 0 { stop } else { s.ret }, long: long },
      left - 1,
    )
  } else {
    lines_from(
      b,
      {
        ..s,
        at: stop + 1,
        start: stop + 1,
        feed: if s.feed < 0 { stop } else { s.feed },
        long: long,
      },
      left - 1,
    )
  }
}

/// An entity read: its message, the parts in it at every depth, and its defects.
type Entity = { message: Message, parts: Int, defects: List<Error> }

/// The entity in `b`, which starts at `origin` of the message. `depth_left` is how many multipart
/// bodies deeper it may nest, and `parts_left` how many more parts the message may contain.
fn entity(
  b: Bytes,
  origin: Int,
  settings: ReadSettings,
  depth_left: Int,
  parts_left: Int,
) -> Entity / {email.fail, abort.raise} = {
  let head = block(b, origin, settings);
  let payload = b.slice(head.body_at, b.len());
  let at = origin + head.body_at;
  let media = media_of(head.fields).media;
  let multipart_entity = mime::top_level(media) == "multipart";
  let own = head.defects.concat(line_defects(b.slice(0, head.body_at), origin)).concat(
    mime_checks(head.fields, origin, multipart_entity),
  );
  let kept = { fields: head.fields, gap: head.gap, body: payload, utf8: settings.utf8 };
  if !multipart_entity {
    {
      message: Message(kept, []),
      parts: 0,
      defects: own.concat(leaf_defects(head.fields, payload, at)),
    }
  } else if depth_left <= 0 { fail(origin, TooDeep) } else {
    let found = spans_of(
      payload,
      at,
      match mime::boundary(media) { Some(named_by) -> named_by, None -> "" },
      parts_left,
    );
    let read = found.spans.fold(
      { children: [], parts: found.spans.len(), defects: [] },
      |r: Branching, s: Span| {
        let child = entity(
          payload.slice(s.from, s.to),
          at + s.from,
          settings,
          depth_left - 1,
          parts_left - r.parts,
        );
        {
          children: r.children.push(child.message),
          parts: r.parts + child.parts,
          defects: r.defects.concat(child.defects),
        }
      },
    );
    {
      message: Message(kept, read.children),
      parts: read.parts,
      defects: own.concat(found.defects).concat(around(payload, at, found)).concat(read.defects),
    }
  }
}

type Branching = { children: List<Message>, parts: Int, defects: List<Error> }

/// What is wrong with the lines of a multipart body that belong to no part: all of them, when the
/// body is kept as one part.
fn around(payload: Bytes, at: Int, found: PartSpans) -> List<Error> / {abort.raise} =
  if found.ok { between(payload, at, found.spans) } else { line_defects(payload, at) }

/// Where a multipart body's parts are, or that it is kept as one part, and why.
type PartSpans = { spans: List<Span>, defects: List<Error>, ok: Bool }

/// Limits that bound only a body's parts: the message's own limits bound the rest.
fn multipart_limits(parts_left: Int) -> multipart::Limits = {
  let most = 9223372036854775807;
  {
    max_parts: parts_left,
    max_header_bytes: most,
    max_header_count: most,
    max_part_bytes: most,
    max_body: most,
    max_boundary: most,
    max_preamble: most,
    max_depth: 0,
  }
}

fn spans_of(
  payload: Bytes,
  at: Int,
  boundary: String,
  parts_left: Int,
) -> PartSpans / {email.fail, abort.raise} =
  match multipart::parse_spans(payload, boundary, multipart_limits(parts_left), Lenient) {
    Ok(found) -> { spans: found, defects: [], ok: true },
    Err(r) -> match r.reason {
      multipart::TooManyParts -> fail(at + r.at, TooManyParts),
      multipart::Truncated -> closed_spans(payload, at, boundary, parts_left),
      reason -> { spans: [], defects: [{ at: at + r.at, reason: BadMultipart(reason) }], ok: false },
    },
  }

/// The spans of a body that ends before its closing delimiter: the spans it has once a delimiter
/// is added after it.
fn closed_spans(
  payload: Bytes,
  at: Int,
  boundary: String,
  parts_left: Int,
) -> PartSpans / {email.fail, abort.raise} = {
  let n = payload.len();
  let shut = Bytes::concat_all([payload, b"\r\n--", Bytes::of_string(boundary), b"--"]);
  match multipart::parse_spans(shut, boundary, multipart_limits(parts_left), Lenient) {
    Ok(found) ->
      {
        spans: found.map(|s: Span| { from: min(s.from, n), to: min(s.to, n) }),
        defects: [{ at: at + n, reason: UnclosedBoundary }],
        ok: true,
      },
    Err(r) -> match r.reason {
      multipart::TooManyParts -> fail(at + min(r.at, n), TooManyParts),
      reason ->
        { spans: [], defects: [{ at: at + min(r.at, n), reason: BadMultipart(reason) }], ok: false },
    },
  }
}

/// What is wrong with the lines of a multipart body that belong to no part: its preamble, its
/// delimiters and its epilogue.
fn between(payload: Bytes, at: Int, spans: List<Span>) -> List<Error> / {abort.raise} = {
  let cut = spans.fold({ from: 0, out: [] }, |g: { from: Int, out: List<Error> }, s: Span|
    {
      from: s.to,
      out: g.out.concat(line_defects(payload.slice(g.from, max(s.from, g.from)), at + g.from)),
    });
  cut.out.concat(line_defects(payload.slice(cut.from, payload.len()), at + cut.from))
}

/// What is wrong with the body of an entity that is not multipart.
fn leaf_defects(held: List<Field>, payload: Bytes, at: Int) -> List<Error> / {abort.raise} = {
  let encoding = encoding_of(held);
  let eight = payload.skip_until(0, high());
  List::concat(if encoding == Binary { [] } else { line_defects(payload, at) }, match encoding {
    SevenBit -> if eight < payload.len() { [{ at: at + eight, reason: Undeclared8Bit }] }
    else { [] },
    Base64 -> if clean_base64(payload) == None { [{ at: at, reason: BadTransferData }] }
    else { [] },
    QuotedPrintable -> if unquoted(payload) == None { [{ at: at, reason: BadTransferData }] }
    else { [] },
    _ -> [],
  })
}

/// A field, and the offset in the message where it starts.
type PositionedField = { at: Int, field: Field }

fn field_positions(held: List<Field>, origin: Int) -> List<PositionedField> =
  held.fold({ at: origin, out: [] }, |p: { at: Int, out: List<PositionedField> }, f: Field|
    { at: p.at + f.raw.len(), out: p.out.push({ at: p.at, field: f }) }).out

/// Each repeat of a field named in `names`, which a header block may have only once.
fn repeats(held: List<PositionedField>, names: List<String>) -> List<Error> =
  held.fold(
    { seen: Map::new(), out: [] },
    |r: { seen: Map<String, Unit>, out: List<Error> }, p: PositionedField| {
      let lower = p.field.name.ascii_lower();
      if !names.contains(lower) { r } else if r.seen.contains(lower) {
        { seen: r.seen, out: r.out.push({ at: p.at, reason: Repeated(lower) }) }
      } else { { seen: r.seen.insert(lower, ()), out: r.out } }
    },
  ).out

/// What is wrong with the MIME fields of one entity.
fn mime_checks(
  held: List<Field>,
  origin: Int,
  multipart_entity: Bool,
) -> List<Error> / {abort.raise} = {
  let all_placed = field_positions(held, origin);
  repeats(all_placed, [
    "content-type",
    "content-transfer-encoding",
    "content-disposition",
    "content-id",
    "mime-version",
  ]).concat(
    all_placed.flat_map(|p: PositionedField|
      mime_check(p.field, multipart_entity).map(|reason: ErrorKind| { at: p.at, reason: reason })),
  )
}

fn mime_check(f: Field, multipart_entity: Bool) -> List<ErrorKind> / {abort.raise} =
  match f.name.ascii_lower() {
    "content-type" -> if media_of([f]).ok { [] } else { [BadMediaType] },
    "content-disposition" -> if read_disposition([f]).ok { [] } else { [BadDisposition] },
    "content-transfer-encoding" -> match encoding_of([f]) {
      Other(name) -> [BadEncoding(name)],
      QuotedPrintable -> if multipart_entity { [BadEncoding("quoted-printable")] } else { [] },
      Base64 -> if multipart_entity { [BadEncoding("base64")] } else { [] },
      _ -> [],
    },
    "content-id" -> match parse_message_ids(f.value, Current) {
      Ok([_]) -> [],
      _ -> [BadMessageId],
    },
    _ -> [],
  }

/// What is wrong with the fields of a message's own header block: one it must have and lacks, one
/// it may have once and has again, and each value this module reads that does not parse in RFC
/// 5322's current syntax.
fn top_checks(held: List<Field>, utf8: Bool) -> List<Error> / {abort.raise} = {
  let all_placed = field_positions(held, 0);
  let lowered = held.map(|f: Field| f.name.ascii_lower());
  ["date", "from"].filter(|name: String| !lowered.contains(name)).map(|name: String|
    { at: 0, reason: Missing(name) }).concat(
    repeats(all_placed, [
      "date",
      "from",
      "sender",
      "reply-to",
      "to",
      "cc",
      "bcc",
      "message-id",
      "in-reply-to",
      "references",
      "subject",
    ]),
  ).concat(
    all_placed.flat_map(|p: PositionedField|
      value_check(p.field.name.ascii_lower(), p.field.value, if utf8 { Utf8 } else { Ascii }).map(
        |reason: ErrorKind| { at: p.at, reason: reason },
      )),
  )
}

fn value_check(
  lower: String,
  value: String,
  repertoire: Repertoire,
) -> List<ErrorKind> / {abort.raise} =
  match lower {
    "from" -> match parse_address_list(value, repertoire, Current) {
      Ok(es) -> if es.all(|e: Entry| group_name(e) == None) { [] } else { [Unexpected] },
      Err(r) -> [r.reason],
    },
    "sender" -> match parse_mailbox(value, repertoire, Current) {
      Ok(_) -> [],
      Err(r) -> [r.reason],
    },
    "reply-to" | "to" | "cc" -> listed_check(value, repertoire),
    "bcc" -> if value == "" { [] } else { listed_check(value, repertoire) },
    "date" -> if date::parse_rfc5322(value) == None { [BadDate] }
    else if obsolete_date(value) { [ObsoleteSyntax] }
    else { [] },
    "message-id" -> match parse_message_ids(value, Current) {
      Ok([_]) -> [],
      Ok(_) -> [BadMessageId],
      Err(r) -> [r.reason],
    },
    "in-reply-to" | "references" -> match parse_message_ids(value, Current) {
      Ok([]) -> [BadMessageId],
      Ok(_) -> [],
      Err(r) -> [r.reason],
    },
    "subject" | "comments" -> if decode_encoded_words(value).bad { [BadEncodedWord] } else { [] },
    _ -> [],
  }

fn listed_check(value: String, repertoire: Repertoire) -> List<ErrorKind> / {abort.raise} =
  match parse_address_list(value, repertoire, Current) { Ok(_) -> [], Err(r) -> [r.reason] }

/// Whether a date that parses uses syntax only RFC 5322 §4 allows: a comment anywhere but after
/// it, blanks inside its time, a year of fewer than four digits, or a zone that is a name.
fn obsolete_date(value: String) -> Bool / {abort.raise} = {
  let head = match value.split_once("(") { Some(split) -> split.head, None -> value };
  let context = context_of(value, Utf8, Obsolete);
  let after = Bytes::of_string(head).len();
  let words = head.words();
  match words.find_index(is_clock) {
    None -> true,
    Some(i) ->
      words.len() != i + 2 || !is_year(words.at_or(i - 1, "")) || !is_zone(words.at_or(i + 1, ""))
        || Result::ok(try { cfws(context, after) }) != Some(context.b.len()),
  }
}

fn digits() -> Bytes = b"0123456789"

/// Whether `word` is a time as RFC 5322 §3 writes one: `hh:mm` or `hh:mm:ss`.
fn is_clock(word: String) -> Bool / {abort.raise} = {
  let b = Bytes::of_string(word);
  let n = b.len();
  (n == 5 || n == 8) && b.skip(0, digits()) == 2 && b.peek(2) == b':' && b.skip(3, digits()) >= 5
    && (n == 5 || (b.peek(5) == b':' && b.skip(6, digits()) == 8))
}

fn is_year(word: String) -> Bool / {abort.raise} = {
  let b = Bytes::of_string(word);
  b.len() >= 4 && b.skip(0, digits()) == b.len()
}

fn is_zone(word: String) -> Bool / {abort.raise} = {
  let b = Bytes::of_string(word);
  b.len() == 5 && (b.peek(0) == b'+' || b.peek(0) == b'-') && b.skip(1, digits()) == 5
}

// --- What a message's fields contain --------------------------------------------

fn repertoire_of(m: Message) -> Repertoire = if held(m).utf8 { Utf8 } else { Ascii }

fn listed_in(m: Message, lower: String) -> List<Entry> / {abort.raise} =
  match fields_named(held(m).fields, lower).first() {
    None -> [],
    Some(f) -> match parse_address_list(f.value, repertoire_of(m), Obsolete) {
      Ok(found) -> found,
      Err(_) -> [],
    },
  }

/// The mailboxes of a message's `From` field, including the members of a group; none when the
/// message has no such field or its value does not parse. Each of the readers below likewise
/// returns nothing, and also reads RFC 5322's obsolete syntax.
pub fn from(m: Message) -> List<Mailbox> / {abort.raise} = mailboxes_of(listed_in(m, "from"))

/// The mailbox of a message's `Sender` field.
pub fn sender(m: Message) -> Option<Mailbox> / {abort.raise} =
  match header(m, "sender") {
    None -> None,
    Some(value) -> parse_mailbox(value, repertoire_of(m), Obsolete).ok(),
  }

/// The address list of a message's `Reply-To` field.
pub fn reply_to(m: Message) -> List<Entry> / {abort.raise} = listed_in(m, "reply-to")

/// The address list of a message's `To` field.
pub fn to(m: Message) -> List<Entry> / {abort.raise} = listed_in(m, "to")

/// The address list of a message's `Cc` field.
pub fn cc(m: Message) -> List<Entry> / {abort.raise} = listed_in(m, "cc")

/// The address list of a message's `Bcc` field.
pub fn bcc(m: Message) -> List<Entry> / {abort.raise} = listed_in(m, "bcc")

/// The instant a message's `Date` field names, as `std.date` reads RFC 5322's dates, including
/// the obsolete ones: a year of two digits, a zone that is a name.
pub fn date(m: Message) -> Option<OffsetDateTime> =
  match header(m, "date") { Some(value) -> date::parse_rfc5322(value), None -> None }

fn ids_in(m: Message, lower: String) -> List<MessageId> / {abort.raise} =
  match header(m, lower) {
    None -> [],
    Some(value) -> match parse_message_ids(value, Obsolete) { Ok(found) -> found, Err(_) -> [] },
  }

/// A message's own identifier: its `Message-ID` field's.
pub fn id(m: Message) -> Option<MessageId> / {abort.raise} = ids_in(m, "message-id").first()

/// The identifiers of a message's `In-Reply-To` field.
pub fn in_reply_to(m: Message) -> List<MessageId> / {abort.raise} = ids_in(m, "in-reply-to")

/// The identifiers of a message's `References` field.
pub fn references(m: Message) -> List<MessageId> / {abort.raise} = ids_in(m, "references")

/// The text of a message's first field named `name`, read as an unstructured field: its value
/// with each encoded word decoded. A word that cannot be read, or that carries a control
/// character, is left as written.
pub fn unstructured(m: Message, name: String) -> Option<String> / {abort.raise} =
  match header(m, name) { Some(value) -> Some(decode_encoded_words(value).text), None -> None }

/// A message's subject: its `Subject` field, read as `unstructured` reads one.
pub fn subject(m: Message) -> Option<String> / {abort.raise} = unstructured(m, "subject")

/// A message's `MIME-Version` value once its comments and blanks are removed: `1.0` for every
/// version in existence.
pub fn mime_version(m: Message) -> Option<String> / {abort.raise} =
  match header(m, "mime-version") {
    None -> None,
    Some(value) -> Some(uncommented(value).replace(" ", "").replace("\t", "")),
  }

/// `text` with each comment replaced by a space, where a parenthesis inside a quoted string does
/// not start a comment: a MIME field's value once RFC 5322's comments are removed. `text` itself
/// when a comment or a quoted string never closes.
fn uncommented(text: String) -> String / {abort.raise} =
  if !text.contains("(") { text } else {
    let context = context_of(text, Utf8, Obsolete);
    match try { stripped(context, 0, [], context.b.len() + 1) } {
      Ok(found) -> String::of_bytes(Bytes::concat_all(found)),
      Err(_) -> text,
    }
  }

/// `left` bounds the recursion: each step consumes a quoted string or a comment.
fn stripped(
  context: Context,
  at: Int,
  out: List<Bytes>,
  left: Int,
) -> List<Bytes> / {email.fail, abort.raise} = {
  let stop = context.b.skip_until(at, b"\"(");
  let so_far = out.push(context.b.slice(at, stop));
  let c = context.b.peek(stop);
  if c < 0 || left <= 0 { so_far } else if c == b'"' {
    let q = quoted(context, stop);
    stripped(context, q.at, so_far.push(context.b.slice(stop, q.at)), left - 1)
  } else {
    stripped(
      context,
      blank(context, stop + 1, 1, context.b.len() - stop),
      so_far.push(b" "),
      left - 1,
    )
  }
}

/// A media type read from a `Content-Type` field, and whether the field parsed.
type Media = { media: MediaType, ok: Bool }

fn media_of(held: List<Field>) -> Media / {abort.raise} =
  match fields_named(held, "content-type").first() {
    None ->
      { media: MediaType("text", "plain", [{ name: "charset", value: "us-ascii" }]), ok: true },
    Some(f) -> match mime::parse(uncommented(f.value)) {
      Err(_) ->
        { media: MediaType("text", "plain", [{ name: "charset", value: "us-ascii" }]), ok: false },
      Ok(m) -> match mime::join(mime::params(m)) {
        Ok(joined) -> { media: MediaType(mime::top_level(m), mime::subtype(m), joined), ok: true },
        Err(_) -> { media: m, ok: false },
      },
    },
  }

/// A message's media type: its `Content-Type` field's, with comments skipped and each parameter RFC
/// 2231 writes in sections or with a charset joined into one value. `text/plain; charset=us-ascii`
/// when the message has no such field or its value is not a media type, as RFC 2045 §5.2 specifies.
pub fn content_type(m: Message) -> MediaType / {abort.raise} = media_of(held(m).fields).media

/// How a body is written for transfer.
pub type Encoding =
  | SevenBit
  | EightBit
  | Binary
  | QuotedPrintable
  | Base64
  /// Any other encoding, by its name in lower case. `content` undoes none.
  | Other(String)

fn encoding_of(held: List<Field>) -> Encoding / {abort.raise} =
  match fields_named(held, "content-transfer-encoding").first() {
    None -> SevenBit,
    Some(f) -> match String::of_chars(trimmed(uncommented(f.value).chars())).ascii_lower() {
      "7bit" -> SevenBit,
      "8bit" -> EightBit,
      "binary" -> Binary,
      "quoted-printable" -> QuotedPrintable,
      "base64" -> Base64,
      other -> Other(other),
    },
  }

/// A message's transfer encoding: its `Content-Transfer-Encoding` field's, and `SevenBit` when
/// it has none.
pub fn transfer_encoding(m: Message) -> Encoding / {abort.raise} = encoding_of(held(m).fields)

/// A `Content-Disposition` field's value: `inline`, `attachment` or whatever other word it starts
/// with, in lower case, and the file name it gives, which is data a sender chose and never a path.
pub type Disposition = new { kind: String, filename: Option<String> }

/// A disposition read, and whether its whole field parsed.
type ParsedDisposition = { found: Option<Disposition>, ok: Bool }

fn read_disposition(held: List<Field>) -> ParsedDisposition / {abort.raise} =
  match fields_named(held, "content-disposition").first() {
    None -> { found: None, ok: true },
    Some(f) -> {
      let value = uncommented(f.value);
      let b = Bytes::of_string(value);
      let kind_end = mime::token_end(b, b.skip(0, b" \t"));
      let kind = String::of_bytes(b.slice(b.skip(0, b" \t"), kind_end)).ascii_lower();
      if kind == "" { { found: None, ok: false } } else {
        match parameters(value, kind_end) {
          Some(joined) ->
            {
              found: Some({
                kind: kind,
                filename: joined.find(|p: Param| p.name == "filename").map(|p: Param| p.value),
              }),
              ok: true,
            },
          None -> { found: Some({ kind: kind, filename: None }), ok: false },
        }
      }
    },
  }

/// The parameters in `value` from byte `at` on, with each one written in sections joined into one.
fn parameters(value: String, at: Int) -> Option<List<Param>> / {abort.raise} =
  match try { mime::read_params(value, at) } { Ok(read) -> mime::join(read).ok(), Err(_) -> None }

/// A message's `Content-Disposition`; `None` when it has none or its value does not start with a
/// word.
pub fn disposition(m: Message) -> Option<Disposition> / {abort.raise} =
  read_disposition(held(m).fields).found

/// The identifier of a message's `Content-ID` field, which a `cid:` link in an HTML body names
/// a part by.
pub fn content_id(m: Message) -> Option<MessageId> / {abort.raise} = ids_in(m, "content-id").first()

// --- What a message's body contains --------------------------------------------

fn base64_chars() -> Bytes = b"+/0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

/// The bytes a base64 body encodes, if it is nothing but canonical base64 and line breaks.
fn clean_base64(payload: Bytes) -> Option<Bytes> / {abort.raise} =
  if payload.skip_until(0, high()) < payload.len() { None }
  else { base64_decode(String::of_bytes(payload.replace(b"\r\n", b"").replace(b"\n", b""))) }

/// The bytes a base64 body encodes, read as RFC 2045 §6.8 tells a reader to: every byte outside
/// the alphabet skipped, what follows the first `=` left out, and padding supplied.
fn robust_base64(payload: Bytes) -> Option<Bytes> / {abort.raise} = {
  let encode_body = payload.slice(0, payload.skip_until(0, b"="));
  let letters = Bytes::concat_all(runs(encode_body, base64_chars(), 0, [], encode_body.len() + 1));
  let n = letters.len();
  let whole = if n % 4 == 1 { letters.slice(0, n - 1) } else { letters };
  base64_decode(String::of_bytes(whole.concat(b"=".repeat((4 - whole.len() % 4) % 4))))
}

/// The runs of `b` from `at` on whose bytes are in `set`. `left` bounds the recursion: each step
/// consumes a run.
fn runs(b: Bytes, set: Bytes, at: Int, out: List<Bytes>, left: Int) -> List<Bytes> / {abort.raise} = {
  let start = b.skip_until(at, set);
  let end = b.skip(start, set);
  if left <= 0 || start >= b.len() { out }
  else { runs(b, set, end, out.push(b.slice(start, end)), left - 1) }
}

fn unquoted(payload: Bytes) -> Option<Bytes> / {abort.raise} =
  if !payload.is_utf8() { None } else { quoted_printable::decode(String::of_bytes(payload)).ok() }

/// A message's body with its transfer encoding undone: unchanged under `7bit`, `8bit` and `binary`,
/// and decoded under `quoted-printable` and `base64`, the latter read as RFC 2045 tells a reader
/// to, skipping bytes outside its alphabet. `None` for any other encoding, and for a body that is
/// not in the named encoding. A multipart message's content is its body unchanged.
pub fn content(m: Message) -> Option<Bytes> / {abort.raise} = {
  let h = held(m);
  match encoding_of(h.fields) {
    SevenBit | EightBit | Binary -> Some(h.body),
    QuotedPrintable -> unquoted(h.body),
    Base64 -> match clean_base64(h.body) {
      Some(found) -> Some(found),
      None -> robust_base64(h.body),
    },
    Other(_) -> None,
  }
}

/// A part's text.
pub type BodyText =
  /// The text, read in the charset the part names, each line break a line feed.
  | Text(String)
  /// The part's bytes, its transfer encoding undone, in a charset this module does not read,
  /// with the charset's name in lower case.
  | Unknown(Bytes, String)
  /// The part's bytes, which are not text in the charset it names; or its body as transferred,
  /// when that is not in its transfer encoding.
  | Malformed(Bytes)

/// A message's body as text: its content decoded in the `charset` its `Content-Type` names, or
/// `us-ascii` when it names none, if that charset is one of `std.encoded_word`'s. Any other
/// charset returns the bytes and its name, never a guess.
pub fn text(m: Message) -> BodyText / {abort.raise} =
  match content(m) {
    None -> Malformed(body(m)),
    Some(data) -> {
      let name = match mime::charset(content_type(m)) { Some(found) -> found, None -> "us-ascii" };
      match encoded_word::charset_named(name) {
        None -> Unknown(data, name),
        Some(charset) -> match encoded_word::text_of(charset, data) {
          Some(read) -> Text(normalize_line_breaks(read)),
          None -> Malformed(data),
        },
      }
    },
  }

/// `text` with each line break a single line feed: no carriage return before it.
fn normalize_line_breaks(text: String) -> String =
  if !text.contains("\r\n") { text } else {
    let lines = text.split("\n");
    let end = lines.len() - 1;
    String::join(
      enumerate(lines).map(|l: { index: Int, value: String }|
        if l.index == end { l.value } else { strip_carriage_returns(l.value) }),
      "\n",
    )
  }

/// `line` without the carriage returns it ends with.
fn strip_carriage_returns(line: String) -> String =
  if !line.ends_with("\r") { line }
  else { String::of_chars(line.chars().reverse().drop_while(|c: Char| c == '\r').reverse()) }

fn is_attached(held: List<Field>) -> Bool / {abort.raise} =
  match read_disposition(held).found { Some(d) -> d.kind == "attachment", None -> false }

/// Where a message's `text/<subtype>` body part is, as the index of a part at each depth.
fn body_path(m: Message, subtype: String) -> Option<List<Int>> / {abort.raise} =
  match m {
    Message(h, []) -> if mime::essence(media_of(h.fields).media) == "text/" ++ subtype
        && !is_attached(h.fields) { Some([]) }
    else { None },
    Message(h, children) -> {
      let lead_alone = mime::subtype(media_of(h.fields).media) == "related";
      children.fold(
        { at: 0, found: None },
        |s: { at: Int, found: Option<List<Int>> }, child: Message|
          {
            at: s.at + 1,
            found: if s.found != None || (lead_alone && s.at > 0) { s.found }
            else { body_path(child, subtype).map(|path: List<Int>| prepend(s.at, path)) },
          },
      ).found
    },
  }

fn part_at(m: Message, path: List<Int>) -> Option<Message> =
  path.fold(Some(m), |at: Option<Message>, i: Int|
    match at { Some(Message(_, children)) -> children.at(i), None -> None })

fn body_text(m: Message, subtype: String) -> Option<BodyText> / {abort.raise} =
  match body_path(m, subtype) { None -> None, Some(path) -> part_at(m, path).map(text) }

/// The text a person reads a message as: its first part of `text/plain` that is not an attachment,
/// through each multipart body in turn, and of a `multipart/related` body its first part alone.
pub fn text_body(m: Message) -> Option<BodyText> / {abort.raise} = body_text(m, "plain")

/// A message's HTML body: its first part of `text/html` that is not an attachment, found as
/// `text_body` finds its part.
pub fn html_body(m: Message) -> Option<BodyText> / {abort.raise} = body_text(m, "html")

/// A file a message carries.
pub type Attachment = new {
  /// The name its `Content-Disposition` gives it. It is data a sender chose, never a path:
  /// `std.multipart`'s `safe_filename` returns the one name it can be saved under.
  filename: Option<String>,
  /// Its media type as the sender named it.
  content_type: MediaType,
  /// Its `Content-ID`, which an HTML body's `cid:` link names it by.
  content_id: Option<MessageId>,
  /// Its bytes, the transfer encoding undone.
  data: Bytes,
}

type Leaf = { path: List<Int>, part: Message }

fn leaves(m: Message, path: List<Int>) -> List<Leaf> =
  match m {
    Message(_, []) -> [{ path: path, part: m }],
    Message(_, children) ->
      children.fold({ at: 0, out: [] }, |l: { at: Int, out: List<Leaf> }, child: Message|
        { at: l.at + 1, out: l.out.concat(leaves(child, path.push(l.at))) }).out,
  }

fn attachment_of(m: Message) -> Attachment / {abort.raise} =
  {
    filename: match disposition(m) { Some(d) -> d.filename, None -> None },
    content_type: content_type(m),
    content_id: content_id(m),
    data: match content(m) { Some(data) -> data, None -> body(m) },
  }

/// Every part of a message that is neither its text body nor its HTML body, in the order
/// written, including inline images. A part whose transfer encoding cannot be undone contains its
/// body as transferred.
pub fn attachments(m: Message) -> List<Attachment> / {abort.raise} = {
  let plain = body_path(m, "plain");
  let html = body_path(m, "html");
  leaves(m, []).filter(|l: Leaf| Some(l.path) != plain && Some(l.path) != html).map(|l: Leaf|
    attachment_of(l.part))
}

// --- Drafts -------------------------------------------------------------------

/// A message to write: what `write` writes the bytes of.
///
/// Only this module creates one, and every part of it is a value that cannot contain a line break
/// where a field is written from it, so nothing given to a draft can add a field to the message.
pub opaque type Draft = new {
  /// Who wrote the message: one mailbox at least.
  from: List<Mailbox>,
  /// Who sent it, when that is not who wrote it.
  sender: Option<Mailbox>,
  reply_to: List<Entry>,
  to: List<Entry>,
  cc: List<Entry>,
  /// Who else it goes to. `envelope` includes them; `write` leaves the field out unless requested.
  bcc: List<Entry>,
  /// The subject's text, which is written in encoded words when it must be.
  subject: Option<String>,
  /// When it was written, to the second.
  date: OffsetDateTime,
  id: MessageId,
  in_reply_to: List<MessageId>,
  references: List<MessageId>,
  /// Every other field, in the order they are written.
  fields: List<Field>,
  /// The text body, each of its line breaks a line feed.
  text: Option<String>,
  /// The HTML body, each of its line breaks a line feed.
  html: Option<String>,
  /// What the HTML body shows by `cid:` links: the parts of a `multipart/related` body.
  inline: List<Attachment>,
  attachments: List<Attachment>,
}

/// A draft from `from` to `to` with no body, written at `date` and known by `id`. Raises
/// `email.fail` for a subject that contains a line break or a control character other than a
/// tab, at its byte.
pub fn draft(
  from: Mailbox,
  to: List<Mailbox>,
  subject: String,
  date: OffsetDateTime,
  id: MessageId,
) -> Draft / {email.fail, abort.raise} =
  {
    from: [from],
    sender: None,
    reply_to: [],
    to: mailbox_entries(to),
    cc: [],
    bcc: [],
    subject: Some(header_text(subject)),
    date: to_the_second(date),
    id: id,
    in_reply_to: [],
    references: [],
    fields: [],
    text: None,
    html: None,
    inline: [],
    attachments: [],
  }

fn to_the_second(o: OffsetDateTime) -> OffsetDateTime =
  match o {
    date::OffsetDateTime(reading, minutes) ->
      date::OffsetDateTime(date::truncate_date_time(reading, date::Seconds), minutes),
  }

/// A draft from `from` to `to` written now, by the host's clock in UTC, and known by an
/// identifier drawn from the host's entropy under `from`'s domain. Raises `email.fail` as
/// `draft` does, and for a domain outside ASCII, which no identifier can contain.
pub fn compose(
  from: Mailbox,
  to: List<Mailbox>,
  subject: String,
) -> Draft / {time.now_ms bounded, entropy.next bounded, email.fail, abort.raise} = {
  let now = match date::of_unix_millis(time.now_ms()) {
    Some(read) -> read,
    None -> date::utc(date::at(date::earliest(), date::midnight())),
  };
  draft(from, to, subject, now, fresh_id(domain(address_of(from))))
}

/// `d` written by these mailboxes, raising `email.fail` for none.
pub fn with_from(d: Draft, from: List<Mailbox>) -> Draft / {email.fail} =
  if from.len() == 0 { fail(0, NoAddress) } else { { ..d, from: from } }

/// `d` sent by `sender` on its authors' behalf.
pub fn with_sender(d: Draft, sender: Mailbox) -> Draft = { ..d, sender: Some(sender) }

/// `d` with replies requested to these addresses.
pub fn with_reply_to(d: Draft, entries: List<Entry>) -> Draft = { ..d, reply_to: entries }

/// `d` addressed to these.
pub fn with_to(d: Draft, entries: List<Entry>) -> Draft = { ..d, to: entries }

/// `d` copied to these.
pub fn with_cc(d: Draft, entries: List<Entry>) -> Draft = { ..d, cc: entries }

/// `d` copied to these without the other recipients being told.
pub fn with_bcc(d: Draft, entries: List<Entry>) -> Draft = { ..d, bcc: entries }

/// `d` under this subject, raising `email.fail` as `draft` does.
pub fn with_subject(d: Draft, subject: String) -> Draft / {email.fail, abort.raise} =
  { ..d, subject: Some(header_text(subject)) }

/// `d` as a reply: `in_reply_to` are the messages it replies to, and `references` the thread
/// they belong to, oldest first, as RFC 5322 §3.6.4 fills the two fields.
pub fn with_thread(d: Draft, in_reply_to: List<MessageId>, references: List<MessageId>) -> Draft =
  { ..d, in_reply_to: in_reply_to, references: references }

/// The names of the fields a draft writes itself.
fn managed() -> List<String> =
  [
    "date",
    "from",
    "sender",
    "reply-to",
    "to",
    "cc",
    "bcc",
    "subject",
    "message-id",
    "in-reply-to",
    "references",
    "mime-version",
  ]

fn is_managed(name: String) -> Bool = {
  let lower = name.ascii_lower();
  managed().contains(lower) || lower.starts_with("content-")
}

/// `d` with one more field after its existing ones, rebuilt from the field's name and value as
/// `field` builds one. Raises `email.fail` as `field` does, and for the name of a field a
/// draft writes itself: `From`, `Subject`, `Content-Type` and the rest.
pub fn with_field(d: Draft, f: Field) -> Draft / {email.fail, abort.raise} =
  if is_managed(f.name) { fail(0, BadName) }
  else { { ..d, fields: d.fields.push(field(f.name, f.value, Utf8)) } }

/// `d` with `text` for its text body, each line break of it a line feed.
pub fn with_text(d: Draft, text: String) -> Draft = { ..d, text: Some(normalize_line_breaks(text)) }

/// `d` with `html` for its HTML body. With a text body too the message is
/// `multipart/alternative`, the text first.
pub fn with_html(d: Draft, html: String) -> Draft = { ..d, html: Some(normalize_line_breaks(html)) }

/// `d` with one more attachment, which makes the message `multipart/mixed`.
pub fn attach(d: Draft, a: Attachment) -> Draft = { ..d, attachments: d.attachments.push(a) }

/// `d` with one more part its HTML body shows: an image a `cid:` link names by the part's
/// `content_id`. The HTML body and these are written as `multipart/related`.
pub fn inline(d: Draft, a: Attachment) -> Draft = { ..d, inline: d.inline.push(a) }

/// A file to attach: its name, its bytes, and the media type its name's extension names in
/// `std.mime`'s table, `application/octet-stream` when it names none.
pub fn attachment(filename: String, data: Bytes) -> Attachment / {abort.raise} =
  {
    filename: Some(filename),
    content_type: match mime::of_path(filename) {
      Some(found) -> found,
      None -> MediaType("application", "octet-stream", []),
    },
    content_id: None,
    data: data,
  }

/// `d` with the two fields RFC 8058 has a list's mail carry for one-click unsubscription:
/// `List-Unsubscribe` with each of `uris` in angle brackets, and `List-Unsubscribe-Post`. They
/// replace any the draft has. Raises `email.fail` when no URI is an `https:` one, which RFC 8058
/// requires, or when one contains a blank, a comma, an angle bracket or a character outside
/// printable ASCII, at the index of that URI.
pub fn list_unsubscribe(d: Draft, uris: List<String>) -> Draft / {email.fail, abort.raise} = {
  let fit = |uri: String| {
    let b = Bytes::of_string(uri);
    b.len() > 0 && b.skip(0, uri_chars()) == b.len()
  };
  let kept = d.fields.filter(|f: Field| {
    let lower = f.name.ascii_lower();
    lower != "list-unsubscribe" && lower != "list-unsubscribe-post"
  });
  match uris.find_index(|uri: String| !fit(uri)) {
    Some(i) -> fail(i, Unexpected),
    None -> if !uris.any(|uri: String| uri.ascii_lower().starts_with("https:")) {
      fail(0, Unexpected)
    } else {
      {
        ..d,
        fields: kept.push(
          field("List-Unsubscribe", String::join(uris.map(|uri: String| "<" ++ uri ++ ">"), ", ")),
        ).push(
          field("List-Unsubscribe-Post", "List-Unsubscribe=One-Click"),
        ),
      }
    },
  }
}

/// What a URI in a `List-Unsubscribe` field is made of: printable ASCII except a space, a comma
/// and the angle brackets.
fn uri_chars() -> Bytes =
  b"!\"#$%&'()*+-./0123456789:;=?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

// --- Writing ------------------------------------------------------------------

/// Whether `write` writes a draft's `Bcc` field.
pub type Bcc =
  /// The field is left out: the copy every recipient gets.
  | OmitBcc
  /// The field is written: the copy a sender keeps.
  | IncludeBcc

/// The bytes of the message `d`, raising `email.unwritable` where `build` returns `Err`.
///
/// The fields are `Date`, `From`, `Sender`, `Reply-To`, `To`, `Cc`, `Bcc` if requested, `Subject`,
/// `Message-ID`, `In-Reply-To`, `References`, the draft's other fields and `MIME-Version`, each
/// only if the draft has a value for it. A display name and a subject are written unchanged when
/// that reads back, quoted when a name must be, and in UTF-8 encoded words otherwise; under `Utf8`
/// text outside ASCII is written unchanged. A line is folded at a space before it passes 78 octets
/// wherever there is one, and no line passes 998. The body is `text/plain`, `text/html`, or
/// `multipart/alternative` of the two; the HTML with its inline parts is `multipart/related`; and
/// with attachments the whole is `multipart/mixed`. Each part's transfer encoding is chosen from
/// its bytes: `7bit` when they are lines of ASCII, `quoted-printable` when few of them need an
/// escape, and `base64` otherwise. The message ends with a line break, as a transport requires: a
/// body that is the whole message and lacks one at its end is written in an encoding that adds one
/// without adding it to the text. `boundary` separates the outermost multipart body's parts, and a
/// body inside that one has `2-` or `3-` before it, so a boundary may be at most 68 of RFC 2046's
/// characters when bodies nest.
pub fn write(
  d: Draft,
  boundary: String,
  repertoire: Repertoire = Ascii,
  bcc: Bcc = OmitBcc,
) -> Bytes / {email.unwritable, abort.raise} = {
  let utf8 = repertoire == Utf8;
  let payload = payload_of(d, boundary);
  Bytes::concat_all(
    [
      folded("Date", [" " ++ date::rfc5322(d.date)]),
      address_field("From", mailbox_entries(d.from), utf8),
      address_field("Sender", match d.sender { Some(s) -> [Single(s)], None -> [] }, utf8),
      address_field("Reply-To", d.reply_to, utf8),
      address_field("To", d.to, utf8),
      address_field("Cc", d.cc, utf8),
      address_field("Bcc", if bcc == IncludeBcc { d.bcc } else { [] }, utf8),
      match d.subject { Some(s) -> folded("Subject", text_stretches(s, utf8)), None -> b"" },
      id_field("Message-ID", [d.id]),
      id_field("In-Reply-To", d.in_reply_to),
      id_field("References", d.references),
    ].concat(
      d.fields.map(|f: Field| field_bytes(f, utf8)).concat([
        b"MIME-Version: 1.0\r\n",
        payload.head,
        b"\r\n",
        payload.data,
      ]),
    ),
  )
}

/// The bytes of the message `d`, or why it has none.
pub fn build(
  d: Draft,
  boundary: String,
  repertoire: Repertoire = Ascii,
  bcc: Bcc = OmitBcc,
) -> Result<Bytes, Unwritable> / {abort.raise} = try { write(d, boundary, repertoire, bcc) }

/// The bytes of the message `d` under a boundary drawn from the host's entropy, raising
/// `email.unwritable` as `write` does.
pub fn write_fresh(
  d: Draft,
  repertoire: Repertoire = Ascii,
  bcc: Bcc = OmitBcc,
) -> Bytes / {entropy.next bounded, email.unwritable, abort.raise} =
  write(d, multipart::fresh_boundary(), repertoire, bcc)

/// A field's lines as a draft stores them, if the repertoire allows them.
fn field_bytes(f: Field, utf8: Bool) -> Bytes / {email.unwritable, abort.raise} =
  if !utf8 && f.raw.skip_until(0, high()) < f.raw.len() { email.unwritable(NeedsUtf8) }
  else { f.raw }

fn id_field(name: String, held: List<MessageId>) -> Bytes =
  if held.len() == 0 { b"" } else { folded(name, held.map(|i: MessageId| " " ++ id_text(i))) }

/// The field `name` of these addresses; nothing for none.
fn address_field(
  name: String,
  held: List<Entry>,
  utf8: Bool,
) -> Bytes / {email.unwritable, abort.raise} =
  if held.len() == 0 { b"" } else {
    let end = held.len() - 1;
    folded(
      name,
      enumerate(held).flat_map(|e: { index: Int, value: Entry }|
        append_to_last(entry_stretches(e.value, utf8), if e.index < end { "," } else { "" })),
    )
  }

/// `cut` with `mark` after its last piece.
fn append_to_last(cut: List<String>, mark: String) -> List<String> / {abort.raise} =
  match cut.last() { Some(end) -> cut.set(cut.len() - 1, end ++ mark), None -> cut }

fn entry_stretches(e: Entry, utf8: Bool) -> List<String> / {email.unwritable, abort.raise} =
  match e {
    Single(m) -> mailbox_stretches(m, utf8),
    Group(name, held) -> {
      let end = held.len() - 1;
      let written = name_stretches(name, utf8);
      let encode_body = match written.last() { Some(w) -> w.ends_with("?="), None -> false };
      append_to_last(
        append_to_last(written, if encode_body { " :" } else { ":" }).concat(
          enumerate(held).flat_map(|m: { index: Int, value: Mailbox }|
            append_to_last(mailbox_stretches(m.value, utf8), if m.index < end { "," } else { "" })),
        ),
        ";",
      )
    },
  }

fn mailbox_stretches(m: Mailbox, utf8: Bool) -> List<String> / {email.unwritable, abort.raise} =
  match m {
    Mailbox(None, a) -> [" " ++ wire_address(a, utf8)],
    Mailbox(Some(name), a) -> name_stretches(name, utf8).push(" <" ++ wire_address(a, utf8) ++ ">"),
  }

/// An address as a field carries it: as written under `Utf8`, and in ASCII otherwise, with a
/// non-ASCII domain written as its A-labels.
fn wire_address(a: Address, utf8: Bool) -> String / {email.unwritable} =
  if utf8 { address_text(a) }
  else { match ascii_text(a) { Some(text) -> text, None -> email.unwritable(NeedsUtf8) } }

/// The pieces that carry a display name: its words if it is atoms with one space between them, a
/// quoted string if it is printable, and encoded words otherwise.
fn name_stretches(name: String, utf8: Bool) -> List<String> / {abort.raise} = {
  let b = Bytes::of_string(name);
  let printed = !name.contains("=?")
    && b.skip(0, Bytes::concat(if utf8 { printable_wide() } else { printable() }, b"\t")) == b.len()
    && !has_c1(name);
  let cut = stretches(if printed && is_words(name) { name } else { quote(name) });
  if printed && cut.all(|s: String| Bytes::of_string(s).len() <= 900) { cut }
  else { encode_words(name, coding_for(name)).map(|w: String| " " ++ w) }
}

/// The draft's body as one entity: its `Content` fields and its bytes.
fn payload_of(d: Draft, boundary: String) -> RawPart / {email.unwritable, abort.raise} = {
  let attached = enumerate(d.attachments).map(|a: { index: Int, value: Attachment }|
    file_part(a.value, d.inline.len() + a.index, "attachment"));
  if attached.len() == 0 {
    match main_body_part(d, boundary, 1) { Some(found) -> found, None -> { head: b"", data: b"" } }
  } else {
    multipart_entity(
      "mixed",
      match main_body_part(d, boundary, 2) {
        Some(found) -> prepend(found, attached),
        None -> attached,
      },
      nested_boundary(boundary, 1),
    )
  }
}

/// The boundary of a multipart body `level` bodies deep.
fn nested_boundary(boundary: String, level: Int) -> String =
  if level <= 1 { boundary } else { level.to_string() ++ "-" ++ boundary }

/// The text body, the HTML body, or both as alternatives, when the next multipart body is
/// `level` deep.
fn main_body_part(
  d: Draft,
  boundary: String,
  level: Int,
) -> Option<RawPart> / {email.unwritable, abort.raise} =
  match d.text {
    None -> html_part(d, boundary, level),
    Some(plain) -> match html_part(d, boundary, level + 1) {
      None -> Some(text_part(plain, "plain", level == 1)),
      Some(page) ->
        Some(
          multipart_entity(
            "alternative",
            [text_part(plain, "plain", false), page],
            nested_boundary(boundary, level),
          ),
        ),
    },
  }

/// The HTML body, with its inline parts if it has any.
fn html_part(
  d: Draft,
  boundary: String,
  level: Int,
) -> Option<RawPart> / {email.unwritable, abort.raise} =
  match d.html {
    None -> if d.inline.len() > 0 { email.unwritable(NoHtml) } else { None },
    Some(html) -> if d.inline.len() == 0 { Some(text_part(html, "html", level == 1)) } else {
      Some(
        multipart_entity(
          "related",
          prepend(
            text_part(html, "html", false),
            enumerate(d.inline).map(|a: { index: Int, value: Attachment }|
              file_part(a.value, a.index, "inline")),
          ),
          nested_boundary(boundary, level),
        ),
      )
    },
  }

/// A multipart entity of these parts.
fn multipart_entity(
  subtype: String,
  held: List<RawPart>,
  boundary: String,
) -> RawPart / {email.unwritable, abort.raise} =
  match try { multipart::frame(held, boundary) } {
    Err(reason) -> email.unwritable(Framing(reason)),
    Ok(data) ->
      {
        head: folded(
          "Content-Type",
          param_stretches("multipart/" ++ subtype, [{ name: "boundary", value: boundary }]),
        ),
        data: data,
      },
  }

fn param_stretches(lead: String, held: List<Param>) -> List<String> = {
  let end = held.len() - 1;
  prepend(
    " " ++ lead ++ (if held.len() > 0 { ";" } else { "" }),
    enumerate(held).map(|p: { index: Int, value: Param }|
      " " ++ mime::param_text(p.value) ++ (if p.index < end { ";" } else { "" })),
  )
}

/// A part's body in the transfer encoding its bytes are best written in, and the encoding's
/// name.
type EncodedBody = { encoding: String, data: Bytes }

/// `wire`, a body as it would be transferred unencoded, encoded if it must be. `text` is the
/// body's text when its line breaks must stay line breaks.
///
/// A `whole` body is a message's last bytes, and a message ends with a line break, since a
/// transport's lone dot follows one. So a body that does not end with a line break is written in an
/// encoding whose last line break is not part of what it carries: a soft one under
/// quoted-printable.
fn encode_body(wire: Bytes, text: Option<String>, whole: Bool) -> EncodedBody / {abort.raise} = {
  let size = wire.len();
  let end_block = !whole || size == 0 || wire.slice(max(size - 2, 0), size) == b"\r\n";
  if end_block && wire.skip(0, seven_bit()) == size && line_defects(wire, 0).len() == 0 {
    { encoding: "7bit", data: wire }
  } else if mostly(wire, qp_plain()) {
    let quoted = match text {
      Some(lines) -> quoted_printable::encode_text(lines),
      None -> quoted_printable::encode(wire),
    };
    {
      encoding: "quoted-printable",
      data: Bytes::of_string(if !whole || quoted.ends_with("\r\n") { quoted }
      else { quoted ++ "=\r\n" }),
    }
  } else {
    let letters = Bytes::of_string(base64_encode(wire));
    let n = letters.len();
    {
      encoding: "base64",
      data: Bytes::join(
        range(0, (n + 75) / 76).map(|i: Int| letters.slice(i * 76, min(n, i * 76 + 76))),
        b"\r\n",
      ).concat(if whole { b"\r\n" } else { b"" }),
    }
  }
}

/// Every byte a `7bit` body may contain: ASCII except NUL.
const fn seven_bit() -> Bytes = Bytes::concat_all(range(1, 128).map(byte_of_int))

/// What quoted-printable writes unchanged.
fn qp_plain() -> Bytes =
  b"\t\r\n !\"#$%&'()*+,-./0123456789:;<>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

fn text_part(text: String, subtype: String, whole: Bool) -> RawPart / {abort.raise} = {
  let wire = Bytes::of_string(text).replace(b"\n", b"\r\n");
  let ascii = wire.skip_until(0, high()) >= wire.len();
  let body = encode_body(wire, Some(text), whole);
  {
    head: Bytes::of_string(
      "Content-Type: text/" ++ subtype ++ "; charset=" ++ (if ascii { "us-ascii" } else { "utf-8" })
        ++ "\r\nContent-Transfer-Encoding: "
        ++ body.encoding
        ++ "\r\n",
    ),
    data: body.data,
  }
}

/// The part for an attachment, under the disposition `kind`.
fn file_part(a: Attachment, index: Int, kind: String) -> RawPart / {email.unwritable, abort.raise} = {
  let top = mime::top_level(a.content_type);
  let held = mime::params(a.content_type);
  let fit = is_token(top) && is_token(mime::subtype(a.content_type)) && top != "multipart"
    && top != "message"
    && held.all(|p: Param| is_token(p.name) && !p.name.contains("*") && p.name.len() <= 40);
  if !fit { email.unwritable(BadAttachment(index)) } else {
    let body = encode_body(a.data, None, false);
    {
      head: Bytes::concat_all([
        folded(
          "Content-Type",
          param_stretches(
            mime::essence(a.content_type),
            held.flat_map(|p: Param| mime::sectioned(p.name.ascii_lower(), p.value, 60)),
          ),
        ),
        Bytes::of_string("Content-Transfer-Encoding: " ++ body.encoding ++ "\r\n"),
        folded(
          "Content-Disposition",
          param_stretches(kind, match a.filename {
            Some(name) -> mime::sectioned("filename", name, 60),
            None -> [],
          }),
        ),
        match a.content_id { Some(i) -> id_field("Content-ID", [i]), None -> b"" },
      ]),
      data: body.data,
    }
  }
}

// --- The draft behind a message -----------------------------------------------

type MainBody = { text: Option<String>, html: Option<String>, inline: List<Attachment> }

fn is_leaf(m: Message) -> Bool / {abort.raise} =
  match m { Message(h, []) -> mime::top_level(media_of(h.fields).media) != "multipart", _ -> false }

/// The text of a part that is `text/<subtype>` and decodes in its charset.
fn leaf_text(m: Message, subtype: String) -> Option<String> / {abort.raise} =
  if !is_leaf(m) || mime::essence(content_type(m)) != "text/" ++ subtype { None }
  else { match text(m) { Text(read) -> Some(read), _ -> None } }

fn html_body_of(m: Message) -> Option<MainBody> / {abort.raise} =
  match leaf_text(m, "html") {
    Some(read) -> Some({ text: None, html: Some(read), inline: [] }),
    None -> if mime::essence(content_type(m)) != "multipart/related" { None } else {
      match parts(m) {
        [] -> None,
        [page, ..shown] -> match leaf_text(page, "html") {
          Some(read) -> if !shown.all(is_leaf) { None }
          else { Some({ text: None, html: Some(read), inline: shown.map(attachment_of) }) },
          None -> None,
        },
      }
    },
  }

fn main_body_of(m: Message) -> Option<MainBody> / {abort.raise} =
  match leaf_text(m, "plain") {
    Some(read) -> {
      let h = held(m);
      let bare = h.body.len() == 0 && fields_named(h.fields, "content-type").len() == 0;
      Some({ text: if bare { None } else { Some(read) }, html: None, inline: [] })
    },
    None -> if mime::essence(content_type(m)) != "multipart/alternative" { html_body_of(m) } else {
      match parts(m) {
        [plain, rich] -> match leaf_text(plain, "plain") {
          Some(read) -> html_body_of(rich).map(|page: MainBody| { ..page, text: Some(read) }),
          None -> None,
        },
        _ -> None,
      }
    },
  }

type Shape = { core: MainBody, attachments: List<Attachment> }

fn shape_of(m: Message) -> Option<Shape> / {abort.raise} =
  if mime::essence(content_type(m)) != "multipart/mixed" {
    main_body_of(m).map(|core: MainBody| { core: core, attachments: [] })
  } else {
    match parts(m) {
      [] -> None,
      [lead, ..rest] -> if !rest.all(is_leaf) { None }
      else if is_leaf(lead) && is_attached(held(lead).fields) {
        Some({
          core: { text: None, html: None, inline: [] },
          attachments: parts(m).map(attachment_of),
        })
      } else {
        main_body_of(lead).map(|core: MainBody|
          { core: core, attachments: rest.map(attachment_of) })
      },
    }
  }

/// The draft that `write` would turn into this message, or into one with the same content. `None`
/// when the message has no author, date or identifier that parses, has a subject or another field
/// no draft can contain, or has a body that is not one of a draft's: text, HTML, the two as
/// alternatives, the HTML with inline parts, and any of these with attachments.
pub fn draft_of(m: Message) -> Option<Draft> / {abort.raise} = {
  let h = held(m);
  let others = h.fields.filter(|f: Field| !is_managed(f.name)).map(|f: Field|
    Result::ok(try { field(f.name, f.value, Utf8) }));
  let topic = match subject(m) {
    Some(read) -> if is_quotable(read) { Some(Some(read)) } else { None },
    None -> Some(None),
  };
  match shape_of(m) {
    None -> None,
    Some(shape) -> match draft_of_fields(m, topic, list::somes(others)) {
      None -> None,
      Some(head) -> if others.len() != head.fields.len() { None } else {
        Some({
          ..head,
          text: shape.core.text,
          html: shape.core.html,
          inline: shape.core.inline,
          attachments: shape.attachments,
        })
      },
    },
  }
}

/// The draft of a message's fields, with no body.
fn draft_of_fields(
  m: Message,
  topic: Option<Option<String>>,
  others: List<Field>,
) -> Option<Draft> / {abort.raise} =
  match from(m) {
    [] -> None,
    authors -> match date(m) {
      None -> None,
      Some(when) -> match id(m) {
        None -> None,
        Some(known) -> match topic {
          None -> None,
          Some(reader_summary) ->
            Some({
              from: authors,
              sender: sender(m),
              reply_to: reply_to(m),
              to: to(m),
              cc: cc(m),
              bcc: bcc(m),
              subject: reader_summary,
              date: to_the_second(when),
              id: known,
              in_reply_to: in_reply_to(m),
              references: references(m),
              fields: others,
              text: None,
              html: None,
              inline: [],
              attachments: [],
            }),
        },
      },
    },
  }

// --- Who a message goes to ----------------------------------------------------

/// Where notice that a message could not be delivered goes: RFC 5321's reverse path.
pub type ReversePath =
  /// Nowhere. The message is itself such a notice, a bounce or a delivery report, and none is sent
  /// about it, so that two servers never reply to each other's reports forever.
  | NullPath
  /// To this address.
  | ReturnTo(Address)

/// What a transport receives alongside a message's bytes. It is built only here, so `utf8`
/// always matches its addresses.
pub opaque type Envelope = new {
  /// Where a report of failure goes.
  sender: ReversePath,
  /// Every address it goes to, once each.
  recipients: List<Address>,
  /// Whether a local part here is outside ASCII, so that only a path offering `SMTPUTF8` accepts
  /// it. Any other path receives each address as `ascii_text` writes it.
  utf8: Bool,
}

/// The envelope of a reverse path and the addresses a message goes to, each once, whatever the
/// case of its domain.
pub fn envelope_of(path: ReversePath, to_all: List<Address>) -> Envelope = {
  let once = to_all.fold([], |acc: List<Address>, a: Address| acc.push_unique(a));
  {
    sender: path,
    recipients: once,
    utf8: !once.all(is_ascii) || (match path { ReturnTo(a) -> !is_ascii(a), NullPath -> false }),
  }
}

/// Envelopes with and without a reverse path, to none, one and several addresses.
pub fn envelopes() -> Gen<Envelope> =
  gen::map2(
    gen::option_of(addresses()),
    gen::list_of(addresses(), 4),
    |from: Option<Address>, to_all: List<Address>|
      envelope_of(match from { Some(a) -> ReturnTo(a), None -> NullPath }, to_all),
  )

/// Every address a draft goes to: those of `To`, `Cc` and `Bcc` in that order, including the
/// members of a group, each once however its domain is cased or written.
pub fn recipients(d: Draft) -> List<Address> =
  envelope_of(NullPath, mailboxes_of(d.to.concat(d.cc).concat(d.bcc)).map(address_of)).recipients

/// What a transport receives alongside the bytes `write` writes: a failure report goes to the
/// draft's `Sender`, or else the first of its authors, and the draft goes to everyone `recipients`
/// returns, including the `Bcc` recipients `write` leaves out.
pub fn envelope(d: Draft) -> Envelope / {abort.raise} =
  envelope_of(
    ReturnTo(match d.sender {
      Some(s) -> address_of(s),
      None -> match d.from.first() {
        Some(m) -> address_of(m),
        None -> panic("a draft has an author"),
      },
    }),
    recipients(d),
  )

/// The repertoire a draft must be written under: `Utf8` when one of its addresses, or a field
/// `with_field` gave it, contains a character outside ASCII, which no encoding can carry in an
/// ASCII header; `Ascii` otherwise, and then `write` puts every non-ASCII name and subject in
/// encoded words. A message written under `Utf8` travels only where `SMTPUTF8` is offered.
pub fn repertoire_for(d: Draft) -> Repertoire / {abort.raise} = {
  let named_in = mailbox_entries(d.from).concat(d.reply_to).concat(match d.sender {
    Some(s) -> [Single(s)],
    None -> [],
  }).concat(
    d.to.concat(d.cc).concat(d.bcc),
  );
  if mailboxes_of(named_in).all(|m: Mailbox| is_ascii(address_of(m)))
      && d.fields.all(|f: Field| f.raw.skip_until(0, high()) >= f.raw.len()) { Ascii }
  else { Utf8 }
}

/// A message without its fields named `dropped`, in any case: `render` leaves their lines out and
/// returns every other byte as it was read. A relay does this to `Bcc` before the message goes to
/// anyone.
pub fn without(m: Message, dropped: String) -> Message =
  match m {
    Message(h, children) ->
      Message(
        { ..h, fields: h.fields.filter(|f: Field| f.name.ascii_lower() != dropped.ascii_lower()) },
        children,
      ),
  }

/// The envelope a message that was read uses when it is sent on: a failure report goes to its
/// `Sender`, or else the first of its authors, and the message goes to every address of its `To`,
/// `Cc` and `Bcc` fields. A message that was resent (RFC 5322 §3.6.6) uses its `Resent-` fields
/// instead, which name who sent it on and to whom.
///
/// Raises `email.fail`: `Missing` when no field names a sender, `Repeated` for a message resent
/// more than once, whose fields do not show which addresses belong to which resending, and, at the
/// offset of a field's value, whatever prevents that field from being read, since a half-read field
/// would send mail to fewer people than it names.
pub fn message_envelope(m: Message) -> Envelope / {email.fail, abort.raise} = {
  let held_fields = held(m).fields;
  let resent = held_fields.any(|f: Field| f.name.ascii_lower().starts_with("resent-"));
  let stem = if resent { "resent-" } else { "" };
  let repertoire = repertoire_of(m);
  let listed = |lower: String|
    fields_named(held_fields, stem ++ lower).flat_map(|f: Field|
      if f.value == "" { [] }
      else { mailboxes_of(read_address_list(f.value, repertoire, Obsolete)) });
  let twice = ["resent-from", "resent-date"].find(|lower: String|
    fields_named(held_fields, lower).len() > 1);
  match twice {
    Some(lower) -> fail(0, Repeated(lower)),
    None -> {
      let sent_as = match fields_named(held_fields, stem ++ "sender").first() {
        Some(f) -> read_mailbox(f.value, repertoire, Obsolete),
        None -> match listed("from").first() {
          Some(author) -> author,
          None -> fail(0, Missing(stem ++ "from")),
        },
      };
      envelope_of(
        ReturnTo(address_of(sent_as)),
        listed("to").concat(listed("cc")).concat(listed("bcc")).map(address_of),
      )
    },
  }
}

// --- Canonical forms ----------------------------------------------------------

/// One of the two forms RFC 6376 §3.4 computes a signature over.
pub type Canonical =
  /// The bytes unchanged, except for empty lines at the body's end.
  | Simple
  /// Runs of blanks collapsed and a field's name in lower case, so that the changes a relay may
  /// make to them do not affect the signature.
  | Relaxed

/// A header field in a canonical form (RFC 6376 §3.4.1, §3.4.2): under `Simple` its lines
/// unchanged; under `Relaxed` its name in lower case, a colon, and its value unfolded with each
/// run of blanks one space and none at either end, then a CRLF.
pub fn canonical_field(f: Field, form: Canonical) -> Bytes / {abort.raise} =
  match form {
    Simple -> f.raw,
    Relaxed -> {
      let n = f.raw.len();
      let colon = match f.raw.index_of_byte(b':') { Some(i) -> i + 1, None -> n };
      let value = f.raw.slice(colon, n).replace(b"\r", b"").replace(b"\n", b"");
      Bytes::concat_all([
        Bytes::of_string(f.name.ascii_lower()),
        b":",
        Bytes::join(split_on_blanks(value, 0, [], value.len() + 1), b" "),
        b"\r\n",
      ])
    },
  }

/// The pieces of `b` between its blanks. `left` bounds the recursion: each step consumes one.
fn split_on_blanks(b: Bytes, at: Int, out: List<Bytes>, left: Int) -> List<Bytes> / {abort.raise} = {
  let start = b.skip(at, b" \t");
  let end = b.skip_until(start, b" \t");
  if left <= 0 || start >= b.len() { out }
  else { split_on_blanks(b, end, out.push(b.slice(start, end)), left - 1) }
}

/// A body in a canonical form (RFC 6376 §3.4.3, §3.4.4). Under `Simple` it is unchanged except that
/// the empty lines at its end are dropped and one CRLF follows its last line, so an empty body
/// becomes a CRLF. Under `Relaxed` each line also loses its trailing blanks and has each other run
/// of blanks collapsed to one space, and an empty body stays empty.
pub fn canonical_body(payload: Bytes, form: Canonical) -> Bytes / {abort.raise} =
  match form {
    Simple -> payload.slice(0, end_without_crlfs(payload, payload.len())).concat(b"\r\n"),
    Relaxed -> {
      let lines = payload.split(b"\r\n").map(collapse_blanks);
      let kept = lines.reverse().drop_while(|l: Bytes| l.len() == 0).reverse();
      if kept.len() == 0 { b"" } else { Bytes::join(kept, b"\r\n").concat(b"\r\n") }
    },
  }

/// Where `b` ends once the CRLFs at the end of its first `n` bytes are removed.
fn end_without_crlfs(b: Bytes, n: Int) -> Int / {abort.raise} =
  if n >= 2 && b.at(n - 2) == b'\r' && b.at(n - 1) == b'\n' { end_without_crlfs(b, n - 2) }
  else { n }

/// A line with each run of blanks one space, and none at its end.
fn collapse_blanks(line: Bytes) -> Bytes / {abort.raise} = {
  let words = Bytes::join(split_on_blanks(line, 0, [], line.len() + 1), b" ");
  if words.len() > 0 && bytes::is_blank(line.peek(0)) { b" ".concat(words) } else { words }
}

// --- Generating drafts --------------------------------------------------------

fn arbitrary_subject() -> Gen<String> =
  gen::one_of([
    several(arbitrary_text("abcXYZ019", 1, 8), " "),
    arbitrary_text("ab =?_.,:;\"\\<>()\t\u{e9}\u{65e5}\u{1f600}", 0, 12),
    gen::map2(
      arbitrary_text("ab \u{e9}", 0, 6),
      gen::int_between(70, 1100),
      |lead: String, n: Int| lead ++ "x".repeat(n),
    ),
    gen::map(gen::list_of_length(arbitrary_text("abcdefgh", 3, 9), 30), |words: List<String>|
      String::join(words, " ")),
  ])

fn arbitrary_body() -> Gen<String> =
  gen::one_of([
    arbitrary_text("ab \n", 0, 24),
    gen::map(arbitrary_text("a\u{e9}\n\r=. \t-", 0, 30), normalize_line_breaks),
    gen::map(gen::int_between(990, 1010), |n: Int| "y".repeat(n)),
    arbitrary_text("\u{65e5}\u{672c}\u{8a9e}\n", 1, 20),
  ])

fn arbitrary_date() -> Gen<OffsetDateTime> =
  gen::map2(
    gen::int_between(0, 4102444800),
    gen::int_between(-720, 840),
    |seconds: Int, east: Int|
      match date::of_unix_seconds(seconds) {
        Some(at) -> match date::in_offset(at, east) { Some(there) -> there, None -> at },
        None -> date::utc(date::at(date::earliest(), date::midnight())),
      },
  )

fn arbitrary_field() -> Gen<Field> =
  gen::map(
    gen::elements([
      { name: "X-Mailer", value: "ply" },
      { name: "Keywords", value: "one, two,  three" },
      { name: "List-Id", value: "A list <list.example.org>" },
      { name: "X-Note", value: "caf\u{e9} =?UTF-8?Q?as_written?=" },
      {
        name: "X-Long",
        value: "a long value that is folded where it has a space to fold at and no sooner than it has to be",
      },
    ]),
    |p: Param|
      match try { field(p.name, p.value, Utf8) } {
        Ok(made) -> made,
        Err(_) -> { name: "X-None", raw: b"X-None:\r\n", value: "" },
      },
  )

fn arbitrary_attachment() -> Gen<Attachment> =
  gen::map2(
    gen::map2(
      gen::option_of(arbitrary_text("ab.c d\u{e9}\"\\;%'*/", 0, 12)),
      gen::option_of(ids()),
      |filename: Option<String>, content_id: Option<MessageId>|
        { filename: filename, content_id: content_id },
    ),
    gen::map2(
      gen::elements([
        MediaType("application", "octet-stream", []),
        MediaType("image", "png", []),
        MediaType("text", "plain", [{ name: "charset", value: "utf-8" }]),
        MediaType("text", "csv", [
          { name: "header", value: "present" },
          { name: "title", value: "a \"b\" \u{e9}" },
        ]),
      ]),
      gen::one_of([
        gen::and_then(gen::int_between(0, 60), |n: Int| gen::bytes_of(n)),
        gen::map(arbitrary_text("ab \r\n", 0, 40), Bytes::of_string),
        gen::map(arbitrary_text("ab\n", 0, 40), |lines: String|
          Bytes::of_string(lines).replace(b"\n", b"\r\n")),
      ]),
      |content_type: MediaType, data: Bytes| { content_type: content_type, data: data },
    ),
    |named_as: { filename: Option<String>, content_id: Option<MessageId> }, held: { content_type: MediaType, data: Bytes }|
      {
        filename: named_as.filename,
        content_type: held.content_type,
        content_id: named_as.content_id,
        data: held.data,
      },
  )

fn arbitrary_shape() -> Gen<Shape> =
  gen::map2(
    gen::map2(
      gen::map2(
        gen::option_of(arbitrary_body()),
        gen::option_of(arbitrary_body()),
        |text: Option<String>, html: Option<String>| { text: text, html: html },
      ),
      gen::list_of(arbitrary_attachment(), 2),
      |reader_summary: { text: Option<String>, html: Option<String> }, inline: List<Attachment>|
        {
          text: reader_summary.text,
          html: reader_summary.html,
          inline: if reader_summary.html == None { [] } else { inline },
        },
    ),
    gen::list_of(arbitrary_attachment(), 2),
    |core: MainBody, attached: List<Attachment>| { core: core, attachments: attached },
  )

type Parties = { author: Mailbox, sender: Option<Mailbox>, lists: List<List<Entry>> }

fn arbitrary_parties() -> Gen<Parties> =
  gen::map2(
    gen::map2(
      mailboxes(),
      gen::option_of(mailboxes()),
      |author: Mailbox, sender: Option<Mailbox>| { author: author, sender: sender },
    ),
    gen::list_of_length(gen::list_of(entries(), 2), 4),
    |lead: { author: Mailbox, sender: Option<Mailbox> }, lists: List<List<Entry>>|
      { author: lead.author, sender: lead.sender, lists: lists },
  )

type Stamp = {
  subject: Option<String>,
  date: OffsetDateTime,
  id: MessageId,
  threads: List<List<MessageId>>,
  fields: List<Field>,
}

fn arbitrary_stamp() -> Gen<Stamp> =
  gen::map2(
    gen::map2(
      gen::option_of(arbitrary_subject()),
      arbitrary_date(),
      |subject: Option<String>, date: OffsetDateTime| { subject: subject, date: date },
    ),
    gen::map2(
      gen::map2(
        ids(),
        gen::list_of_length(gen::list_of(ids(), 2), 2),
        |id: MessageId, threads: List<List<MessageId>>| { id: id, threads: threads },
      ),
      gen::list_of(arbitrary_field(), 2),
      |known: { id: MessageId, threads: List<List<MessageId>> }, others: List<Field>|
        { id: known.id, threads: known.threads, fields: others },
    ),
    |reader_summary: { subject: Option<String>, date: OffsetDateTime }, rest: { id: MessageId, threads: List<List<MessageId>>, fields: List<Field> }|
      {
        subject: reader_summary.subject,
        date: reader_summary.date,
        id: rest.id,
        threads: rest.threads,
        fields: rest.fields,
      },
  )

/// Drafts of every shape `write` writes: with and without each address field, a subject, a
/// thread and other fields, a text and an HTML body, inline parts and attachments.
pub fn drafts() -> Gen<Draft> =
  gen::map2(
    gen::map2(arbitrary_parties(), arbitrary_stamp(), |who: Parties, stamp: Stamp|
      { who: who, stamp: stamp }),
    arbitrary_shape(),
    |head: { who: Parties, stamp: Stamp }, shape: Shape|
      {
        from: [head.who.author],
        sender: head.who.sender,
        reply_to: head.who.lists.at_or(0, []),
        to: head.who.lists.at_or(1, []),
        cc: head.who.lists.at_or(2, []),
        bcc: head.who.lists.at_or(3, []),
        subject: head.stamp.subject,
        date: head.stamp.date,
        id: head.stamp.id,
        in_reply_to: head.stamp.threads.at_or(0, []),
        references: head.stamp.threads.at_or(1, []),
        fields: head.stamp.fields,
        text: shape.core.text,
        html: shape.core.html,
        inline: shape.core.inline,
        attachments: shape.attachments,
      },
  )

// --- Tests ------------------------------------------------------------------

type Listing = { text: String, read: String }

/// Address lists and what each reads as, as `show` writes one. The first five are RFC 5322
/// Appendix A.1.2's and A.1.3's, the next three A.5's, the next three A.6's obsolete forms, and
/// the five after them the fields of RFC 2047 §8.
fn listings() -> List<Listing> =
  [
    {
      text: "Mary Smith <mary@x.test>, jdoe@example.org, Who? <one@y.test>",
      read: "Mary Smith <mary@x.test>, jdoe@example.org, Who? <one@y.test>",
    },
    {
      text: "<boss@nil.test>, \"Giant; \\\"Big\\\" Box\" <sysservices@example.net>",
      read: "boss@nil.test, \"Giant; \\\"Big\\\" Box\" <sysservices@example.net>",
    },
    {
      text: "\"Joe Q. Public\" <john.q.public@example.com>",
      read: "\"Joe Q. Public\" <john.q.public@example.com>",
    },
    {
      text: "A Group:Ed Jones <c@a.test>,joe@where.test,John <jdoe@one.test>;",
      read: "A Group:Ed Jones <c@a.test>, joe@where.test, John <jdoe@one.test>;",
    },
    { text: "Undisclosed recipients:;", read: "Undisclosed recipients:;" },
    {
      text: "Pete(A nice \\) chap) <pete(his account)@silly.test(his host)>",
      read: "Pete <pete@silly.test>",
    },
    {
      text: "A Group(Some people)     :Chris Jones <c@(Chris's host.)public.example>,         joe@example.org,  John <jdoe@one.test> (my dear friend); (the end of the group)",
      read: "A Group:Chris Jones <c@public.example>, joe@example.org, John <jdoe@one.test>;",
    },
    {
      text: "(Empty list)(start)Hidden recipients  :(nobody(that I know))  ;",
      read: "Hidden recipients:;",
    },
    {
      text: "Joe Q. Public <john.q.public@example.com>",
      read: "\"Joe Q. Public\" <john.q.public@example.com>",
    },
    {
      text: "Mary Smith <@node.test:mary@example.net>, , jdoe@test  . example",
      read: "Mary Smith <mary@example.net>, jdoe@test.example",
    },
    { text: "John Doe <jdoe@machine(comment).  example>", read: "John Doe <jdoe@machine.example>" },
    {
      text: "=?US-ASCII?Q?Keith_Moore?= <moore@cs.utk.edu>",
      read: "Keith Moore <moore@cs.utk.edu>",
    },
    {
      text: "=?ISO-8859-1?Q?Keld_J=F8rn_Simonsen?= <keld@dkuug.dk>",
      read: "Keld J\u{f8}rn Simonsen <keld@dkuug.dk>",
    },
    {
      text: "=?ISO-8859-1?Q?Andr=E9?= Pirard <PIRARD@vm1.ulg.ac.be>",
      read: "Andr\u{e9} Pirard <PIRARD@vm1.ulg.ac.be>",
    },
    {
      text: "Nathaniel Borenstein <nsb@thumper.bellcore.com> (=?iso-8859-8?b?7eXs+SDv4SDp7Oj08A==?=)",
      read: "Nathaniel Borenstein <nsb@thumper.bellcore.com>",
    },
    {
      text: "Greg Vaudreuil <gvaudre@NRI.Reston.VA.US>, Ned Freed <ned@innosoft.com>, Keith Moore <moore@cs.utk.edu>",
      read: "Greg Vaudreuil <gvaudre@NRI.Reston.VA.US>, Ned Freed <ned@innosoft.com>, Keith Moore <moore@cs.utk.edu>",
    },
    {
      text: "=?UTF-8?Q?J=C3=BCrgen?= =?UTF-8?Q?_M?= <j@example.org>",
      read: "J\u{fc}rgen M <j@example.org>",
    },
    { text: "\"=?UTF-8?Q?J=C3=BCrgen?=\" <j@example.org>", read: "J\u{fc}rgen <j@example.org>" },
    { text: "=?x-unknown?Q?a?= <j@example.org>", read: "\"=?x-unknown?Q?a?=\" <j@example.org>" },
    {
      text: "=?UTF-8?Q?a=0D=0ABcc=3A_x?= <j@example.org>",
      read: "\"=?UTF-8?Q?a=0D=0ABcc=3A_x?=\" <j@example.org>",
    },
    {
      text: "\"john doe\"@example.org, \"a,b <c>\"@example.org, \"quo\\\"te\"@example.org",
      read: "\"john doe\"@example.org, \"a,b <c>\"@example.org, \"quo\\\"te\"@example.org",
    },
    { text: "\"john.doe\"@example.org", read: "john.doe@example.org" },
    { text: "\"john\" . doe@example.org", read: "john.doe@example.org" },
    { text: "\"\"@example.org", read: "\"\"@example.org" },
    {
      text: "a@[192.0.2.1], b@[IPv6:2001:db8::1], c@[ 192.0.2.1 ]",
      read: "a@[192.0.2.1], b@[IPv6:2001:db8::1], c@[192.0.2.1]",
    },
    { text: "user@xn--bcher-kva.example", read: "user@xn--bcher-kva.example" },
    { text: "John.Doe@Example.ORG", read: "John.Doe@Example.ORG" },
    { text: "\"\" <a@example.org>", read: "a@example.org" },
    { text: "a@example.org,,b@example.org,", read: "a@example.org, b@example.org" },
    { text: "Group:,a@example.org,,;", read: "Group:a@example.org;" },
    { text: "<@a.test,@b.test:c@example.org>", read: "c@example.org" },
    { text: "<,@a.test,,@b.test , :c@example.org>", read: "c@example.org" },
    { text: "alice@example.org,<bob@example.com>", read: "alice@example.org, bob@example.com" },
    {
      text: "\"Alice, alice@example.org\" <bob@example.com>",
      read: "\"Alice, alice@example.org\" <bob@example.com>",
    },
    { text: "alice@example.org (Alice)", read: "alice@example.org" },
  ]

test "lists {show(c.text)}" for c: Listing in listings() {
  assert_eq(parse_address_list(c.text).map(address_list_text), Ok(c.read))
}

type ListErrorCase = { text: String, at: Int, reason: ErrorKind }

/// Texts that are not address lists, each with where and why it stops being one. The first
/// thirteen are the texts behind CVE-2023-27043 and CVE-2019-16056, which a reader took for
/// `alice@example.org` alone while a transport delivered to another address: each is rejected
/// whole, under either syntax.
fn list_error_cases() -> List<ListErrorCase> =
  [
    { text: "alice@example.org)<bob@example.com>", at: 17, reason: Unexpected },
    { text: "alice@example.org(<bob@example.com>", at: 35, reason: UnclosedComment },
    { text: "alice@example.org<<bob@example.com>", at: 17, reason: Unexpected },
    { text: "alice@example.org><bob@example.com>", at: 17, reason: Unexpected },
    { text: "alice@example.org[<bob@example.com>", at: 17, reason: Unexpected },
    { text: "alice@example.org]<bob@example.com>", at: 17, reason: Unexpected },
    { text: "alice@example.org@<bob@example.com>", at: 17, reason: Unexpected },
    { text: "alice@example.org;<bob@example.com>", at: 17, reason: Unexpected },
    { text: "alice@example.org:<bob@example.com>", at: 17, reason: Unexpected },
    { text: "alice@example.org.<bob@example.com>", at: 18, reason: BadDomain },
    { text: "alice@example.org\"<bob@example.com>", at: 17, reason: Unexpected },
    { text: "alice@example.org )Alice(", at: 18, reason: Unexpected },
    { text: "a@malicious.org@important.com", at: 15, reason: Unexpected },
    { text: "alice@example.org <bob@example.com>", at: 18, reason: Unexpected },
    { text: "", at: 0, reason: NoAddress },
    { text: " , ", at: 3, reason: NoAddress },
    { text: "John Doe", at: 8, reason: NoAt },
    { text: "jdoe", at: 4, reason: NoAt },
    { text: "john doe@example.com", at: 5, reason: BadLocalPart },
    { text: ".a@example.org", at: 0, reason: BadLocalPart },
    { text: "a..b@example.org", at: 2, reason: BadLocalPart },
    { text: "a.@example.org", at: 1, reason: BadLocalPart },
    { text: "@example.org", at: 0, reason: BadLocalPart },
    { text: "\"a\tb\"@example.org", at: 1, reason: Control },
    { text: "\"a@b\"@example.org", at: 1, reason: BadLocalPart },
    { text: "Eve <\"eve@example.net\"@example.org>", at: 8, reason: BadLocalPart },
    { text: "a@b_c.example", at: 2, reason: BadDomain },
    { text: "a@-b.example", at: 2, reason: BadDomain },
    { text: "a@b..example", at: 4, reason: BadDomain },
    { text: "a@b.", at: 4, reason: BadDomain },
    { text: "a@", at: 2, reason: BadDomain },
    { text: "a@[]", at: 2, reason: BadDomain },
    { text: "a@[192.0.2.1", at: 12, reason: BadDomain },
    { text: "a@[a\\]b]", at: 4, reason: BadDomain },
    { text: "a@[1 92.0.2.1]", at: 5, reason: BadDomain },
    { text: "a@[192.0.2.1 (]", at: 13, reason: BadDomain },
    { text: "<@a.test@b.test:c@example.org>", at: 8, reason: Unexpected },
    { text: "<,:c@example.org>", at: 2, reason: Unexpected },
    { text: "j\u{fc}rgen@example.org", at: 1, reason: NonAscii },
    { text: "a@b\u{fc}cher.example", at: 3, reason: NonAscii },
    { text: "J\u{fc}rgen <j@example.org>", at: 1, reason: NonAscii },
    { text: "<>", at: 1, reason: NoAddress },
    { text: "<a@example.org", at: 14, reason: UnclosedAngle },
    { text: "Joe <a>", at: 6, reason: NoAt },
    { text: "x: a@example.org", at: 16, reason: UnclosedGroup },
    { text: "x: y: a@example.org;;", at: 4, reason: Unexpected },
    { text: ":;", at: 0, reason: Unexpected },
    { text: "a@example.org, b@example.org;", at: 28, reason: Unexpected },
    { text: "\"unclosed <a@example.org>", at: 25, reason: Unclosed },
    { text: "a@example.org (unclosed", at: 23, reason: UnclosedComment },
    { text: "Joe <a@example.org>\r\nBcc: <b@example.org>", at: 19, reason: LineBreak },
    { text: "Joe\n <a@example.org>", at: 3, reason: LineBreak },
    { text: "a@example.org\0", at: 13, reason: Control },
    { text: "<@x.test a@example.org>", at: 9, reason: Unexpected },
    { text: "a@example.org b@example.org", at: 14, reason: Unexpected },
  ]

test "rejects {show(c.text)}" for c: ListErrorCase in list_error_cases() {
  assert_eq(parse_address_list(c.text), Err({ at: c.at, reason: c.reason }));
  assert(!parse_address_list(c.text, Ascii, Current).is_ok())
}

/// Address lists only RFC 5322 §4 allows, each with where and why the current syntax stops.
fn outdated() -> List<ListErrorCase> =
  [
    { text: "Joe Q. Public <john.q.public@example.com>", at: 5, reason: ObsoleteSyntax },
    { text: "Mary Smith <@node.test:mary@example.net>", at: 12, reason: ObsoleteSyntax },
    { text: "a@example.org, , c@example.org", at: 15, reason: ObsoleteSyntax },
    { text: "a@example.org,", at: 14, reason: ObsoleteSyntax },
    { text: ",a@example.org", at: 0, reason: ObsoleteSyntax },
    { text: "jdoe@test  . example", at: 9, reason: ObsoleteSyntax },
    { text: "\"john\".doe@example.org", at: 0, reason: ObsoleteSyntax },
    { text: "john . doe@example.org", at: 0, reason: ObsoleteSyntax },
    { text: "x:,;", at: 2, reason: ObsoleteSyntax },
    { text: "=?x-unknown?Q?a?= <j@example.org>", at: 0, reason: BadEncodedWord },
    { text: "=?UTF-8?Q?a=0D=0ABcc=3A_x?= <j@example.org>", at: 0, reason: BadEncodedWord },
    { text: "=?UTF-8?Q?J=C3=BCrgen?=<j@example.org>", at: 23, reason: BadEncodedWord },
    { text: "=?UTF-8?Q?Team?=:j@example.org;", at: 16, reason: BadEncodedWord },
  ]

test "the current syntax rejects {show(c.text)}" for c: ListErrorCase in outdated() {
  assert_eq(parse_address_list(c.text, Ascii, Current), Err({ at: c.at, reason: c.reason }));
  assert(parse_address_list(c.text).is_ok())
}

test "an encoded word in a quoted string is decoded only under the obsolete syntax" {
  let text = "\"=?UTF-8?Q?J=C3=BCrgen?=\" <j@example.org>";
  assert_eq(
    parse_mailbox(text, Ascii, Current).map(display_name),
    Ok(Some("=?UTF-8?Q?J=C3=BCrgen?=")),
  );
  assert_eq(parse_mailbox(text).map(display_name), Ok(Some("J\u{fc}rgen")))
}

test "UTF-8 is read in a name, a local part and a domain only when requested" {
  let text = "J\u{fc}rgen M\u{fc}ller <j\u{fc}rgen@b\u{fc}cher.example>, \u{7528}\u{6237}@\u{4f8b}\u{3048}.jp, \"\u{e9} \u{e8}\"@example.org";
  assert_eq(parse_address_list(text, Utf8).map(address_list_text), Ok(text));
  assert_eq(parse_address_list(text), Err({ at: 1, reason: NonAscii }));
  let a = try { read_address("j\u{fc}rgen@b\u{fc}cher.example", Utf8) };
  assert_eq(a.map(local_part), Ok("j\u{fc}rgen"));
  assert_eq(a.map(domain), Ok("b\u{fc}cher.example"));
  assert_eq(a.map(is_ascii), Ok(false));
  assert_eq(parse_address("j\u{fc}rgen@example.org"), Err({ at: 1, reason: NonAscii }));
  assert_eq(parse_address("jdoe@b\u{fc}cher.example"), Err({ at: 6, reason: NonAscii }));
  assert_eq(parse_address("jdoe@xn--bcher-kva.example").map(is_ascii), Ok(true));
  // A comment may contain UTF-8 too, and is dropped like any other; a domain literal may not.
  assert_eq(
    parse_address_list("J\u{fc}rgen (\u{e9}t\u{e9}) <a@example.org> (\u{65e5}\u{672c})", Utf8).map(
      address_list_text,
    ),
    Ok("J\u{fc}rgen <a@example.org>"),
  );
  assert_eq(parse_address("a@[\u{fc}]", Utf8), Err({ at: 3, reason: BadDomain }))
}

type AddressCase = { text: String, read: Result<String, Error> }

/// Inputs to `read_address`, each with its address as `show` writes it, or why it is not one.
fn address_cases() -> List<AddressCase> =
  [
    { text: "jdoe@example.org", read: Ok("jdoe@example.org") },
    { text: "john.q.public@example.com", read: Ok("john.q.public@example.com") },
    { text: "\"john doe\"@example.org", read: Ok("\"john doe\"@example.org") },
    { text: "\"jdoe\"@example.org", read: Ok("jdoe@example.org") },
    { text: "a!#$%&'*+-/=?^_`{|}~b@example.org", read: Ok("a!#$%&'*+-/=?^_`{|}~b@example.org") },
    { text: "jdoe@[192.0.2.1]", read: Ok("jdoe@[192.0.2.1]") },
    { text: "jdoe@localhost", read: Ok("jdoe@localhost") },
    { text: "", read: Err({ at: 0, reason: NoAddress }) },
    { text: "jdoe", read: Err({ at: 4, reason: NoAt }) },
    { text: " jdoe@example.org", read: Err({ at: 0, reason: Unexpected }) },
    { text: "jdoe@example.org ", read: Err({ at: 16, reason: Unexpected }) },
    { text: "jdoe @example.org", read: Err({ at: 0, reason: Unexpected }) },
    { text: "jdoe@ example.org", read: Err({ at: 5, reason: BadDomain }) },
    { text: "jdoe(comment)@example.org", read: Err({ at: 0, reason: Unexpected }) },
    { text: "jdoe@example.org(comment)", read: Err({ at: 16, reason: Unexpected }) },
    { text: "John <jdoe@example.org>", read: Err({ at: 5, reason: NoAt }) },
    { text: "<jdoe@example.org>", read: Err({ at: 0, reason: NoAt }) },
    { text: "jdoe@[ 192.0.2.1 ]", read: Err({ at: 5, reason: Unexpected }) },
    { text: "john . doe@example.org", read: Err({ at: 0, reason: Unexpected }) },
    { text: "\"john\".doe@example.org", read: Err({ at: 0, reason: ObsoleteSyntax }) },
    { text: "a@b@c", read: Err({ at: 3, reason: Unexpected }) },
    { text: "a@example.org\r\n", read: Err({ at: 13, reason: LineBreak }) },
    { text: "a@example.org, b@example.org", read: Err({ at: 13, reason: Unexpected }) },
  ]

test "the address {show(c.text)}" for c: AddressCase in address_cases() {
  assert_eq(parse_address(c.text).map(|a: Address| show(a)), c.read)
}

fn jdoe() -> Address / {email.fail, abort.raise} = address("jdoe", "example.org")

test "an address is built from a valid local part and a valid domain" {
  assert_eq(try { address("jdoe", "example.org") }, parse_address("jdoe@example.org"));
  assert_eq(try { show(address("john doe", "Example.ORG")) }, Ok("\"john doe\"@Example.ORG"));
  assert_eq(try { show(address("", "example.org")) }, Ok("\"\"@example.org"));
  assert_eq(try { show(address("a,b", "example.org")) }, Ok("\"a,b\"@example.org"));
  assert_eq(
    try { address("eve@example.net", "example.org") },
    Err({ at: 3, reason: BadLocalPart }),
  );
  assert_eq(try { address("a\r\nBcc: b", "example.org") }, Err({ at: 1, reason: LineBreak }));
  assert_eq(try { address("a\tb", "example.org") }, Err({ at: 1, reason: Control }));
  assert_eq(try { address("a\0", "example.org") }, Err({ at: 1, reason: Control }));
  assert_eq(try { address("j\u{fc}rgen", "example.org") }, Err({ at: 1, reason: NonAscii }));
  assert_eq(try { address("a".repeat(256), "example.org") }, Err({ at: 0, reason: TooLong }));
  assert(Result::is_ok(try { address("a".repeat(255), "example.org") }));
  assert_eq(try { address("a", "") }, Err({ at: 0, reason: BadDomain }));
  assert_eq(try { address("a", "ex ample.org") }, Err({ at: 2, reason: BadDomain }));
  assert_eq(try { address("a", "example.org>") }, Err({ at: 11, reason: BadDomain }));
  assert_eq(try { address("a", "b@example.org") }, Err({ at: 1, reason: BadDomain }));
  assert_eq(try { address("a", "example.org\r\n") }, Err({ at: 11, reason: LineBreak }));
  assert_eq(try { address("a", "b\u{fc}cher.example") }, Err({ at: 1, reason: NonAscii }));
  assert(Result::is_ok(try { address("j\u{fc}rgen", "b\u{fc}cher.example", Utf8) }));
  assert_eq(try { address("a", "a".repeat(64) ++ ".example") }, Err({ at: 0, reason: BadDomain }));
  assert(Result::is_ok(try { address("a", "a".repeat(63) ++ ".example") }));
  let label = "a".repeat(63) ++ ".";
  assert_eq(try { address("a", label.repeat(4) ++ "example") }, Err({ at: 0, reason: TooLong }))
}

test "addresses are equal by their local part as written and their domain in any case" {
  assert_eq(try { address("jdoe", "EXAMPLE.Org") }, try { jdoe() });
  assert((try { address("JDoe", "example.org") }) != (try { jdoe() }));
  assert_eq(parse_address("\"jdoe\"@example.org"), try { jdoe() });
  assert_eq(
    Result::map(try { address("jdoe", "EXAMPLE.Org") }, digest),
    Result::map(try { jdoe() }, digest),
  );
  assert_eq(Result::map(try { address("jdoe", "EXAMPLE.Org") }, domain), Ok("EXAMPLE.Org"))
}

test "addresses are equal whether a label of their domain is written in its script or as its A-label" {
  let written = try { address("user", "b\u{fc}cher.example", Utf8) };
  let encode_body = parse_address("user@xn--bcher-kva.example");
  assert_eq(written, encode_body);
  assert_eq(written.map(digest), encode_body.map(digest));
  assert_eq(
    try { address("user", "B\u{dc}CHER.Example", Utf8) },
    parse_address("user@XN--Bcher-KVA.example"),
  );
  assert_eq(try { address("user", "bu\u{308}cher.example", Utf8) }, encode_body);
  assert((try { address("user", "bucher.example") }) != encode_body);
  assert((try { address("User", "b\u{fc}cher.example", Utf8) }) != encode_body);
  // The name is `std.idna`'s, which reads the Kelvin sign as the `k` it maps to.
  assert_eq(try { address("a", "\u{212a}.example", Utf8) }, try { address("a", "k.example") });
  assert_eq(written.map(domain), Ok("b\u{fc}cher.example"));
  assert_eq(written.map(ascii_domain), Ok("xn--bcher-kva.example"));
  assert_eq(written.map(|a: Address| show(a)), Ok("user@b\u{fc}cher.example"));
  assert_eq(written.map(ascii_text), Ok(Some("user@xn--bcher-kva.example")));
  assert_eq(written.map(is_ascii), Ok(true));
  assert_eq(
    Result::map(try { address("j\u{fc}rgen", "b\u{fc}cher.example", Utf8) }, ascii_text),
    Ok(None),
  );
  assert_eq(
    Result::map(try { address("a b", "EXAMPLE.Org") }, ascii_text),
    Ok(Some("\"a b\"@EXAMPLE.Org")),
  );
  assert_eq(
    Result::map(try { address("a", "[IPv6:2001:DB8::1]") }, ascii_domain),
    Ok("[IPv6:2001:DB8::1]"),
  )
}

test "a domain with a label outside ASCII or an A-label is a domain name, or fails with what is wrong" {
  let wrong = |domain: String, label: Int, reason: idna::ErrorKind|
    assert_eq(
      try { address("a", domain, Utf8) },
      Err({ at: 0, reason: BadIdna([{ label: label, reason: reason }]) }),
    );
  wrong("xn--a.example", 0, idna::Disallowed);
  wrong("example.xn--0", 1, idna::Punycode);
  wrong("a.\u{200d}b.example", 1, idna::Joiner);
  wrong("\u{5d0}a.example", 0, idna::Bidi);
  wrong("b\u{ff20}c.example", 0, idna::Disallowed);
  wrong("\u{301}a.example", 0, idna::LeadingMark);
  wrong("\u{fc}" ++ "a".repeat(58) ++ ".example", 0, idna::LongLabel);
  assert_eq(
    parse_address("a@xn--a.example"),
    Err({ at: 2, reason: BadIdna([{ label: 0, reason: idna::Disallowed }]) }),
  );
  assert_eq(parse_address("a@b\u{fc}cher.example"), Err({ at: 3, reason: NonAscii }));
  assert(Result::is_ok(try { address("a", "ab--c.example") }));
  assert(Result::is_ok(try { address("a", "ab--c.b\u{fc}cher.example", Utf8) }));
  assert(Result::is_ok(try { address("a", "axn--b.example") }));
  assert_eq(
    explain(BadIdna([{ label: 0, reason: idna::Bidi }])),
    "no internationalized domain name: a name with a right-to-left label keeps the Bidi rule in every label",
  )
}

test "a domain literal is kept as written between its brackets" {
  let a = try { address("jdoe", "[IPv6:2001:db8::1]") };
  assert_eq(a.map(domain), Ok("[IPv6:2001:db8::1]"));
  assert_eq(
    try { domain_literal(address("jdoe", "[IPv6:2001:db8::1]")) },
    Ok(Some("IPv6:2001:db8::1")),
  );
  assert_eq(try { domain_literal(jdoe()) }, Ok(None));
  // The blanks RFC 5322 allows in a literal are not part of it.
  assert_eq(Result::map(try { address("a", "[192.0.2.1 ]") }, domain), Ok("[192.0.2.1]"))
}

fn joe() -> Mailbox / {email.fail, abort.raise} = named_mailbox("Joe Q. Public", jdoe())

test "a mailbox is an address with a name that contains no line break" {
  assert_eq(try { show(joe()) }, Ok("\"Joe Q. Public\" <jdoe@example.org>"));
  assert_eq(try { show(named_mailbox("Joe Public", jdoe())) }, Ok("Joe Public <jdoe@example.org>"));
  assert_eq(try { show(mailbox(jdoe())) }, Ok("jdoe@example.org"));
  assert_eq(try { named_mailbox("", jdoe()) }, try { mailbox(jdoe()) });
  assert_eq(try { display_name(joe()) }, Ok(Some("Joe Q. Public")));
  assert_eq(try { address_of(joe()) }, try { jdoe() });
  assert_eq(
    try { named_mailbox("Joe\r\nBcc: eve@example.org", jdoe()) },
    Err({ at: 3, reason: LineBreak }),
  );
  assert_eq(try { named_mailbox("Joe\0", jdoe()) }, Err({ at: 3, reason: Control }));
  assert(Result::is_ok(try { named_mailbox("tab\tand caf\u{e9}", jdoe()) }));
  assert((try { named_mailbox("Joe", jdoe()) }) != (try { named_mailbox("joe", jdoe()) }));
  assert_eq(try { named_mailbox("Joe", address("jdoe", "EXAMPLE.ORG")) }, try {
    named_mailbox("Joe", jdoe())
  });
  assert_eq(
    parse_mailbox("Joe <jdoe@example.org>, x@example.org").map(display_name),
    Err({ at: 22, reason: Unexpected }),
  );
  assert_eq(parse_mailbox("A Group:;"), Err({ at: 7, reason: Unexpected }))
}

test "a group is a name and its members, and an address list flattens to its mailboxes" {
  let listed = parse_address_list(
    "a@example.org, Team: Joe <b@example.org>, c@example.org;, None:;",
  );
  assert_eq(
    listed.map(|es: List<Entry>| es.map(group_name)),
    Ok([None, Some("Team"), Some("None")]),
  );
  assert_eq(
    listed.map(|es: List<Entry>| mailboxes_of(es).map(|m: Mailbox| show(m))),
    Ok(["a@example.org", "Joe <b@example.org>", "c@example.org"]),
  );
  assert_eq(try { show(group("undisclosed-recipients", [])) }, Ok("undisclosed-recipients:;"));
  assert_eq(try { members(group("Team", [mailbox(jdoe())])) }, try { [mailbox(jdoe())] });
  assert_eq(try { members(mailbox_entry(mailbox(jdoe()))) }, try { [mailbox(jdoe())] });
  assert_eq(try { group("", []) }, Err({ at: 0, reason: NoAddress }));
  assert_eq(try { group("a\nb", []) }, Err({ at: 1, reason: LineBreak }))
}

test "the literal's check returns the address, or the offset where the text stops being one" {
  assert_eq(literal("jdoe@example.org").ok(), Result::ok(try { jdoe() }));
  assert_eq(literal("j\u{fc}rgen@"), Err({ message: explain(BadDomain), offset: 7 }));
  assert_eq(literal("John <jdoe@example.org>"), Err({ message: explain(NoAt), offset: 5 }))
}

test "an address list's text reads back as the same list" {
  gen::check(gen::list(entries()), |es: List<Entry>| {
    es.len() == 0 || parse_address_list(address_list_text(es), Utf8, Current) == Ok(es)
  })
}

type IdCase = { text: String, syntax: Syntax, read: Result<List<String>, Error> }

/// Texts of identifiers and what each contains, the first four from RFC 5322 Appendix A.
fn identified_cases() -> List<IdCase> =
  [
    {
      text: "<1234@local.machine.example>",
      syntax: Current,
      read: Ok(["<1234@local.machine.example>"]),
    },
    {
      text: "<1234@local.machine.example> <3456@example.net>",
      syntax: Current,
      read: Ok(["<1234@local.machine.example>", "<3456@example.net>"]),
    },
    {
      text: "             <testabcd.1234@silly.test>",
      syntax: Current,
      read: Ok(["<testabcd.1234@silly.test>"]),
    },
    {
      text: "<1234   @   local(blah)  .machine .example>",
      syntax: Obsolete,
      read: Ok(["<1234@local.machine.example>"]),
    },
    {
      text: "<1234   @   local(blah)  .machine .example>",
      syntax: Current,
      read: Err({ at: 0, reason: ObsoleteSyntax }),
    },
    {
      text: "<a@b>(comment)<c@[192.0.2.1]>",
      syntax: Current,
      read: Ok(["<a@b>", "<c@[192.0.2.1]>"]),
    },
    { text: "<no-at-sign>", syntax: Current, read: Ok(["<no-at-sign>"]) },
    { text: "", syntax: Current, read: Ok([]) },
    { text: "<>", syntax: Current, read: Err({ at: 0, reason: BadMessageId }) },
    { text: "<a@b", syntax: Current, read: Err({ at: 4, reason: UnclosedAngle }) },
    { text: "1234@example.org", syntax: Current, read: Err({ at: 0, reason: BadMessageId }) },
    { text: "<a@b>, <c@d>", syntax: Current, read: Err({ at: 5, reason: ObsoleteSyntax }) },
    { text: "<a@b>, <c@d>", syntax: Obsolete, read: Ok(["<a@b>", "<c@d>"]) },
    {
      text: "Your message of \"Tue, 1 Jul\" <a@b> and (see) <c@d>",
      syntax: Obsolete,
      read: Ok(["<a@b>", "<c@d>"]),
    },
    { text: "<\"a b\"@c>", syntax: Obsolete, read: Err({ at: 0, reason: BadMessageId }) },
    { text: "<caf\u{e9}@example.org>", syntax: Current, read: Err({ at: 0, reason: NonAscii }) },
    { text: "<caf\u{e9}@example.org>", syntax: Obsolete, read: Err({ at: 0, reason: NonAscii }) },
    { text: "<a@b>\r\n<c@d>", syntax: Obsolete, read: Err({ at: 5, reason: LineBreak }) },
  ]

test "the identifiers of {show(c.text)} under the {c.syntax} syntax" for c: IdCase in identified_cases(
  ) {
  assert_eq(
    parse_message_ids(c.text, c.syntax).map(|found: List<MessageId>| found.map(id_text)),
    c.read,
  )
}

test "an identifier is built from a left side and a domain a writer may write" {
  assert_eq(try { id_text(message_id("1234.abc", "example.org")) }, Ok("<1234.abc@example.org>"));
  assert_eq(try { show(message_id("a", "[192.0.2.1]")) }, Ok("<a@[192.0.2.1]>"));
  assert_eq(try { message_id("a b", "example.org") }, Err({ at: 0, reason: BadMessageId }));
  assert_eq(try { message_id("", "example.org") }, Err({ at: 0, reason: BadMessageId }));
  assert_eq(try { message_id("a..b", "example.org") }, Err({ at: 0, reason: BadMessageId }));
  assert_eq(try { message_id("caf\u{e9}", "example.org") }, Err({ at: 0, reason: BadMessageId }));
  assert_eq(try { message_id("a", "exa mple.org") }, Err({ at: 3, reason: BadMessageId }));
  assert_eq(
    try { message_id("a>\r\nBcc: x", "example.org") },
    Err({ at: 0, reason: BadMessageId }),
  );
  assert_eq(
    handle { try { id_text(fresh_id("example.org")) } } with { entropy.next() -> 7 },
    Ok("<7-7@example.org>"),
  )
}

test "a field is its name and its value, folded at its spaces" {
  let made = try { field("X-Mailer", "  ply 0.1 \t") };
  assert_eq(made.map(|f: Field| f.raw), Ok(b"X-Mailer: ply 0.1\r\n"));
  assert_eq(made.map(|f: Field| f.value), Ok("ply 0.1"));
  assert_eq(made.map(|f: Field| f.name), Ok("X-Mailer"));
  assert_eq(Result::map(try { field("X-Empty", "") }, |f: Field| f.raw), Ok(b"X-Empty:\r\n"));
  let words = String::join(range(0, 20).map(|i: Int| "word" ++ i.to_string()), " ");
  assert_eq(
    Result::map(try { field("X-Long", words) }, |f: Field| f.raw),
    Ok(
      b"X-Long: word0 word1 word2 word3 word4 word5 word6 word7 word8 word9 word10\r\n word11 word12 word13 word14 word15 word16 word17 word18 word19\r\n",
    ),
  );
  // A run with no space in it is kept whole, on a line of its own if it must be.
  let link = "https://example.org/" ++ "a".repeat(975);
  assert_eq(
    Result::map(try { field("X-Link", "see " ++ link) }, |f: Field| f.raw),
    Ok(Bytes::of_string("X-Link: see\r\n " ++ link ++ "\r\n")),
  );
  assert_eq(
    Result::map(try { field("X-Link", link ++ " x") }, |f: Field| f.raw),
    Ok(Bytes::of_string("X-Link:\r\n " ++ link ++ "\r\n x\r\n")),
  );
  assert_eq(
    Result::map(try { field("X-Gaps", "a   b") }, |f: Field| f.raw),
    Ok(b"X-Gaps: a   b\r\n"),
  )
}

type FieldErrorCase = { name: String, value: String, at: Int, reason: ErrorKind }

fn field_error_cases() -> List<FieldErrorCase> =
  [
    { name: "", value: "x", at: 0, reason: BadName },
    { name: "Bad Name", value: "x", at: 3, reason: BadName },
    { name: "Bad:Name", value: "x", at: 3, reason: BadName },
    { name: "X-Caf\u{e9}", value: "x", at: 5, reason: BadName },
    { name: "X\r\nBcc", value: "x", at: 1, reason: BadName },
    { name: "X".repeat(77), value: "x", at: 76, reason: BadName },
    { name: "X-A", value: "a\r\nBcc: eve@example.org", at: 1, reason: LineBreak },
    { name: "X-A", value: "a\nb", at: 1, reason: LineBreak },
    { name: "X-A", value: "a\rb", at: 1, reason: LineBreak },
    { name: "X-A", value: "a\0b", at: 1, reason: Control },
    { name: "X-A", value: "caf\u{e9}", at: 3, reason: NonAscii },
    { name: "X-A", value: "a".repeat(998), at: 0, reason: TooLong },
  ]

test "no field is made of {show(c.name)} and {show(c.value)}" for c: FieldErrorCase in field_error_cases(
  ) { assert_eq(try { field(c.name, c.value) }, Err({ at: c.at, reason: c.reason })) }

test "an unstructured field is written unchanged when that reads back, and in encoded words otherwise" {
  let raw = |text: String| Result::map(try { text_field("Subject", text) }, |f: Field| f.raw);
  assert_eq(raw("Saying Hello"), Ok(b"Subject: Saying Hello\r\n"));
  assert_eq(raw(""), Ok(b"Subject:\r\n"));
  assert_eq(raw("Gr\u{fc}\u{df}e"), Ok(b"Subject: =?UTF-8?B?R3LDvMOfZQ==?=\r\n"));
  assert_eq(
    raw("a long subject with one caf\u{e9} in it"),
    Ok(b"Subject: =?UTF-8?Q?a_long_subject_with_one_caf=C3=A9_in_it?=\r\n"),
  );
  assert_eq(raw(" led by a space"), Ok(b"Subject: =?UTF-8?Q?_led_by_a_space?=\r\n"));
  assert_eq(raw("tab\there"), Ok(b"Subject: =?UTF-8?Q?tab=09here?=\r\n"));
  assert_eq(
    raw("=?UTF-8?Q?not_a_word?="),
    Ok(b"Subject: =?UTF-8?B?PT9VVEYtOD9RP25vdF9hX3dvcmQ/PQ==?=\r\n"),
  );
  assert_eq(raw("a\r\nBcc: x"), Err({ at: 1, reason: LineBreak }));
  assert_eq(
    Result::map(try { text_field("Subject", "Gr\u{fc}\u{df}e", Utf8) }, |f: Field| f.raw),
    Ok(Bytes::of_string("Subject: Gr\u{fc}\u{df}e\r\n")),
  );
  assert_eq(
    Result::map(try { text_field("Subject", "Gr\u{fc}\u{df}e") }, |f: Field| f.value),
    Ok("=?UTF-8?B?R3LDvMOfZQ==?="),
  );
  assert_eq(try { text_field("Sub ject", "x") }, Err({ at: 3, reason: BadName }))
}

/// `text` as it is sent: each of its lines, the last too, ended by CRLF.
fn crlf_text(text: String) -> Bytes = Bytes::of_string(text.replace("\n", "\r\n") ++ "\r\n")

fn shown_text(found: Option<BodyText>) -> String =
  match found { Some(Text(read)) -> read, Some(_) -> "(not text)", None -> "" }

fn summary_line(label: String, value: String) -> String =
  if value == "" { "" } else { label ++ " " ++ value }

/// What a message's typed readers return, each on a line of its own, and no line for a reader
/// that returns nothing.
fn reader_summary(m: Message) -> List<String> / {abort.raise} =
  [
    summary_line("from", address_list_text(mailbox_entries(from(m)))),
    summary_line("sender", match sender(m) { Some(s) -> show(s), None -> "" }),
    summary_line("reply-to", address_list_text(reply_to(m))),
    summary_line("to", address_list_text(to(m))),
    summary_line("cc", address_list_text(cc(m))),
    summary_line("bcc", address_list_text(bcc(m))),
    summary_line("subject", match subject(m) { Some(s) -> s, None -> "" }),
    summary_line("date", match date(m) { Some(d) -> show(d), None -> "" }),
    summary_line("id", match id(m) { Some(i) -> id_text(i), None -> "" }),
    summary_line("in-reply-to", String::join(in_reply_to(m).map(id_text), " ")),
    summary_line("references", String::join(references(m).map(id_text), " ")),
    summary_line("text", shown_text(text_body(m))),
  ].filter(|line: String| line != "")

fn hello() -> String = "text This is a message just to say hello.\nSo, \"Hello\".\n"

fn simple_addressing() -> String =
  \\From: John Doe <jdoe@machine.example>
  \\To: Mary Smith <mary@example.net>
  \\Subject: Saying Hello
  \\Date: Fri, 21 Nov 1997 09:55:06 -0600
  \\Message-ID: <1234@local.machine.example>
  \\
  \\This is a message just to say hello.
  \\So, "Hello".

fn sent_by_a_secretary() -> String =
  \\From: John Doe <jdoe@machine.example>
  \\Sender: Michael Jones <mjones@machine.example>
  \\To: Mary Smith <mary@example.net>
  \\Subject: Saying Hello
  \\Date: Fri, 21 Nov 1997 09:55:06 -0600
  \\Message-ID: <1234@local.machine.example>
  \\
  \\This is a message just to say hello.
  \\So, "Hello".

fn different_mailboxes() -> String =
  \\From: "Joe Q. Public" <john.q.public@example.com>
  \\To: Mary Smith <mary@x.test>, jdoe@example.org, Who? <one@y.test>
  \\Cc: <boss@nil.test>, "Giant; \"Big\" Box" <sysservices@example.net>
  \\Date: Tue, 1 Jul 2003 10:52:37 +0200
  \\Message-ID: <5678.21-Nov-1997@example.com>
  \\
  \\Hi everyone.

fn group_addresses() -> String =
  \\From: Pete <pete@silly.example>
  \\To: A Group:Ed Jones <c@a.test>,joe@where.test,John <jdoe@one.test>;
  \\Cc: Undisclosed recipients:;
  \\Date: Thu, 13 Feb 1969 23:32:54 -0330
  \\Message-ID: <testabcd.1234@silly.example>
  \\
  \\Testing.

fn first_reply() -> String =
  \\From: Mary Smith <mary@example.net>
  \\To: John Doe <jdoe@machine.example>
  \\Reply-To: "Mary Smith: Personal Account" <smith@home.example>
  \\Subject: Re: Saying Hello
  \\Date: Fri, 21 Nov 1997 10:01:10 -0600
  \\Message-ID: <3456@example.net>
  \\In-Reply-To: <1234@local.machine.example>
  \\References: <1234@local.machine.example>
  \\
  \\This is a reply to your hello.

fn second_reply() -> String =
  \\To: "Mary Smith: Personal Account" <smith@home.example>
  \\From: John Doe <jdoe@machine.example>
  \\Subject: Re: Saying Hello
  \\Date: Fri, 21 Nov 1997 11:00:00 -0600
  \\Message-ID: <abcd.1234@local.machine.test>
  \\In-Reply-To: <3456@example.net>
  \\References: <1234@local.machine.example> <3456@example.net>
  \\
  \\This is a reply to your reply.

fn resent() -> String =
  \\Resent-From: Mary Smith <mary@example.net>
  \\Resent-To: Jane Brown <j-brown@other.example>
  \\Resent-Date: Mon, 24 Nov 1997 14:22:01 -0800
  \\Resent-Message-ID: <78910@example.net>
  \\From: John Doe <jdoe@machine.example>
  \\To: Mary Smith <mary@example.net>
  \\Subject: Saying Hello
  \\Date: Fri, 21 Nov 1997 09:55:06 -0600
  \\Message-ID: <1234@local.machine.example>
  \\
  \\This is a message just to say hello.
  \\So, "Hello".

fn traced() -> String =
  \\Received: from x.y.test
  \\   by example.net
  \\   via TCP
  \\   with ESMTP
  \\   id ABC12345
  \\   for <mary@example.net>;  21 Nov 1997 10:05:43 -0600
  \\Received: from node.example by x.y.test; 21 Nov 1997 10:01:22 -0600
  \\From: John Doe <jdoe@node.example>
  \\To: Mary Smith <mary@example.net>
  \\Subject: Saying Hello
  \\Date: Fri, 21 Nov 1997 09:55:06 -0600
  \\Message-ID: <1234@local.node.example>
  \\
  \\This is a message just to say hello.
  \\So, "Hello".

fn oddities() -> String =
  \\From: Pete(A nice \) chap) <pete(his account)@silly.test(his host)>
  \\To:A Group(Some people)
  \\     :Chris Jones <c@(Chris's host.)public.example>,
  \\         joe@example.org,
  \\  John <jdoe@one.test> (my dear friend); (the end of the group)
  \\Cc:(Empty list)(start)Hidden recipients  :(nobody(that I know))  ;
  \\Date: Thu,
  \\      13
  \\        Feb
  \\          1969
  \\      23:32
  \\               -0330 (Newfoundland Time)
  \\Message-ID:              <testabcd.1234@silly.test>
  \\
  \\Testing.

fn obsolete_addressing() -> String =
  \\From: Joe Q. Public <john.q.public@example.com>
  \\To: Mary Smith <@node.test:mary@example.net>, , jdoe@test  . example
  \\Date: Tue, 1 Jul 2003 10:52:37 +0200
  \\Message-ID: <5678.21-Nov-1997@example.com>
  \\
  \\Hi everyone.

fn obsolete_dates() -> String =
  \\From: John Doe <jdoe@machine.example>
  \\To: Mary Smith <mary@example.net>
  \\Subject: Saying Hello
  \\Date: 21 Nov 97 09:55:06 GMT
  \\Message-ID: <1234@local.machine.example>
  \\
  \\This is a message just to say hello.
  \\So, "Hello".

/// RFC 5322 Appendix A.6.3, where `__` represents the two spaces its folded line is made of, as
/// in the RFC.
fn obsolete_white_space() -> String =
  \\From  : John Doe <jdoe@machine(comment).  example>
  \\To    : Mary Smith
  \\__
  \\          <mary@example.net>
  \\Subject     : Saying Hello
  \\Date  : Fri, 21 Nov 1997 09(comment):   55  :  06 -0600
  \\Message-ID  : <1234   @   local(blah)  .machine .example>
  \\
  \\This is a message just to say hello.
  \\So, "Hello".

/// The fields of RFC 2047 §8's first example, as a message with no body.
fn encoded_names() -> String =
  \\From: =?US-ASCII?Q?Keith_Moore?= <moore@cs.utk.edu>
  \\To: =?ISO-8859-1?Q?Keld_J=F8rn_Simonsen?= <keld@dkuug.dk>
  \\CC: =?ISO-8859-1?Q?Andr=E9?= Pirard <PIRARD@vm1.ulg.ac.be>
  \\Subject: =?ISO-8859-1?B?SWYgeW91IGNhbiByZWFkIHRoaXMgeW8=?=
  \\ =?ISO-8859-2?B?dSB1bmRlcnN0YW5kIHRoZSBleGFtcGxlLg==?=

type Example = { what: String, text: String, defects: List<ErrorKind>, says: List<String> }

/// RFC 5322 Appendix A's messages, each with what `read` rejects it for (nothing for all before
/// A.6), and what its fields contain.
fn examples() -> List<Example> =
  [
    {
      what: "A.1.1, a message from one person to another",
      text: simple_addressing(),
      defects: [],
      says: [
        "from John Doe <jdoe@machine.example>",
        "to Mary Smith <mary@example.net>",
        "subject Saying Hello",
        "date 1997-11-21T09:55:06-06:00",
        "id <1234@local.machine.example>",
        hello(),
      ],
    },
    {
      what: "A.1.1, the same sent by a secretary",
      text: sent_by_a_secretary(),
      defects: [],
      says: [
        "from John Doe <jdoe@machine.example>",
        "sender Michael Jones <mjones@machine.example>",
        "to Mary Smith <mary@example.net>",
        "subject Saying Hello",
        "date 1997-11-21T09:55:06-06:00",
        "id <1234@local.machine.example>",
        hello(),
      ],
    },
    {
      what: "A.1.2, different types of mailboxes",
      text: different_mailboxes(),
      defects: [],
      says: [
        "from \"Joe Q. Public\" <john.q.public@example.com>",
        "to Mary Smith <mary@x.test>, jdoe@example.org, Who? <one@y.test>",
        "cc boss@nil.test, \"Giant; \\\"Big\\\" Box\" <sysservices@example.net>",
        "date 2003-07-01T10:52:37+02:00",
        "id <5678.21-Nov-1997@example.com>",
        "text Hi everyone.\n",
      ],
    },
    {
      what: "A.1.3, group addresses",
      text: group_addresses(),
      defects: [],
      says: [
        "from Pete <pete@silly.example>",
        "to A Group:Ed Jones <c@a.test>, joe@where.test, John <jdoe@one.test>;",
        "cc Undisclosed recipients:;",
        "date 1969-02-13T23:32:54-03:30",
        "id <testabcd.1234@silly.example>",
        "text Testing.\n",
      ],
    },
    {
      what: "A.2, a reply",
      text: first_reply(),
      defects: [],
      says: [
        "from Mary Smith <mary@example.net>",
        "reply-to \"Mary Smith: Personal Account\" <smith@home.example>",
        "to John Doe <jdoe@machine.example>",
        "subject Re: Saying Hello",
        "date 1997-11-21T10:01:10-06:00",
        "id <3456@example.net>",
        "in-reply-to <1234@local.machine.example>",
        "references <1234@local.machine.example>",
        "text This is a reply to your hello.\n",
      ],
    },
    {
      what: "A.2, a reply to the reply",
      text: second_reply(),
      defects: [],
      says: [
        "from John Doe <jdoe@machine.example>",
        "to \"Mary Smith: Personal Account\" <smith@home.example>",
        "subject Re: Saying Hello",
        "date 1997-11-21T11:00:00-06:00",
        "id <abcd.1234@local.machine.test>",
        "in-reply-to <3456@example.net>",
        "references <1234@local.machine.example> <3456@example.net>",
        "text This is a reply to your reply.\n",
      ],
    },
    {
      what: "A.3, a resent message",
      text: resent(),
      defects: [],
      says: [
        "from John Doe <jdoe@machine.example>",
        "to Mary Smith <mary@example.net>",
        "subject Saying Hello",
        "date 1997-11-21T09:55:06-06:00",
        "id <1234@local.machine.example>",
        hello(),
      ],
    },
    {
      what: "A.4, a message with trace fields",
      text: traced(),
      defects: [],
      says: [
        "from John Doe <jdoe@node.example>",
        "to Mary Smith <mary@example.net>",
        "subject Saying Hello",
        "date 1997-11-21T09:55:06-06:00",
        "id <1234@local.node.example>",
        hello(),
      ],
    },
    {
      what: "A.5, white space, comments and other oddities",
      text: oddities(),
      defects: [],
      says: [
        "from Pete <pete@silly.test>",
        "to A Group:Chris Jones <c@public.example>, joe@example.org, John <jdoe@one.test>;",
        "cc Hidden recipients:;",
        "date 1969-02-13T23:32:00-03:30",
        "id <testabcd.1234@silly.test>",
        "text Testing.\n",
      ],
    },
    {
      what: "A.6.1, obsolete addressing",
      text: obsolete_addressing(),
      defects: [ObsoleteSyntax, ObsoleteSyntax],
      says: [
        "from \"Joe Q. Public\" <john.q.public@example.com>",
        "to Mary Smith <mary@example.net>, jdoe@test.example",
        "date 2003-07-01T10:52:37+02:00",
        "id <5678.21-Nov-1997@example.com>",
        "text Hi everyone.\n",
      ],
    },
    {
      what: "A.6.2, obsolete dates",
      text: obsolete_dates(),
      defects: [ObsoleteSyntax],
      says: [
        "from John Doe <jdoe@machine.example>",
        "to Mary Smith <mary@example.net>",
        "subject Saying Hello",
        "date 1997-11-21T09:55:06Z",
        "id <1234@local.machine.example>",
        hello(),
      ],
    },
    {
      what: "A.6.3, obsolete white space and comments",
      text: obsolete_white_space().replace("__", "  "),
      defects: [
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
      ],
      says: [
        "from John Doe <jdoe@machine.example>",
        "to Mary Smith <mary@example.net>",
        "subject Saying Hello",
        "date 1997-11-21T09:55:06-06:00",
        "id <1234@local.machine.example>",
        hello(),
      ],
    },
    {
      what: "the fields of RFC 2047's example",
      text: encoded_names(),
      defects: [Missing("date")],
      says: [
        "from Keith Moore <moore@cs.utk.edu>",
        "to Keld J\u{f8}rn Simonsen <keld@dkuug.dk>",
        "cc Andr\u{e9} Pirard <PIRARD@vm1.ulg.ac.be>",
        "subject If you can read this you understand the example.",
      ],
    },
  ]

test "reads {c.what}" for c: Example in examples() {
  let data = crlf_text(c.text);
  let read = read_tolerant(data, default_limits());
  assert_eq(read.defects.map(|d: Error| d.reason), c.defects);
  assert_eq(reader_summary(read.message), c.says);
  assert_eq(render(read.message), data);
  assert_eq(parse(data, default_limits()).is_ok(), c.defects.len() == 0)
}

test "a field is kept as it was written alongside its unfolded value" {
  let m = read(crlf_text(traced()), default_limits());
  assert_eq(headers(m, "received"), [
    "from x.y.test   by example.net   via TCP   with ESMTP   id ABC12345   for <mary@example.net>;  21 Nov 1997 10:05:43 -0600",
    "from node.example by x.y.test; 21 Nov 1997 10:01:22 -0600",
  ]);
  assert_eq(header(m, "RECEIVED"), headers(m, "Received").at(0));
  assert_eq(header(m, "x-none"), None);
  assert_eq(
    fields(m).first().map(|f: Field| f.raw),
    Some(
      b"Received: from x.y.test\r\n   by example.net\r\n   via TCP\r\n   with ESMTP\r\n   id ABC12345\r\n   for <mary@example.net>;  21 Nov 1997 10:05:43 -0600\r\n",
    ),
  );
  assert_eq(fields(m).map(|f: Field| f.name), [
    "Received",
    "Received",
    "From",
    "To",
    "Subject",
    "Date",
    "Message-ID",
  ]);
  assert_eq(body(m), b"This is a message just to say hello.\r\nSo, \"Hello\".\r\n");
  let again = read(crlf_text(resent()), default_limits());
  assert_eq(header(again, "Resent-Message-ID"), Some("<78910@example.net>"));
  assert_eq(
    parse_address_list(match header(again, "resent-to") { Some(v) -> v, None -> "" }).map(
      address_list_text,
    ),
    Ok("Jane Brown <j-brown@other.example>"),
  )
}

fn required_fields() -> String = "Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: a@example.org\r\n"

/// A message of the two fields every message has, then `fields`, a blank line and `payload`.
fn message_of(extra: String, payload: Bytes) -> Bytes =
  Bytes::concat_all([
    Bytes::of_string(required_fields()),
    Bytes::of_string(extra),
    b"\r\n",
    payload,
  ])

type DefectCase = { what: String, data: Bytes, utf8: Bool, defects: List<Error> }

fn defect_case(what: String, extra: String, payload: Bytes, defects: List<Error>) -> DefectCase =
  { what: what, data: message_of(extra, payload), utf8: false, defects: defects }

/// Messages a conforming writer does not write, each with every defect a tolerant reader lists
/// for it, the first of which is what a strict one rejects it for.
fn defect_cases() -> List<DefectCase> =
  [
    {
      what: "a missing blank line",
      data: Bytes::of_string(required_fields()).concat(b"The body starts here: at once.\r\n"),
      utf8: false,
      defects: [{ at: 60, reason: NoBlankLine }],
    },
    {
      what: "a header with no colon",
      data: Bytes::of_string(required_fields()).concat(
        b"Subject hello\r\nTo: b@example.org\r\n\r\nbody\r\n",
      ),
      utf8: false,
      defects: [{ at: 60, reason: NoBlankLine }],
    },
    {
      what: "a continuation before any field",
      data: b" folded\r\n".concat(Bytes::of_string(required_fields())),
      utf8: false,
      defects: [
        { at: 0, reason: NoBlankLine },
        { at: 0, reason: Missing("date") },
        { at: 0, reason: Missing("from") },
      ],
    },
    {
      what: "bare line feeds",
      data: b"Date: Fri, 21 Nov 1997 09:55:06 -0600\nFrom: a@example.org\n\nbody\nmore\n",
      utf8: false,
      defects: [{ at: 37, reason: BareLineFeed }, { at: 63, reason: BareLineFeed }],
    },
    defect_case("a bare carriage return in the body", "", b"bo\rdy\r\n", [
      { at: 64, reason: BareCarriageReturn },
    ]),
    defect_case("a bare carriage return in a field", "Subject: a\rb\r\n", b"", [
      { at: 70, reason: BareCarriageReturn },
    ]),
    defect_case("an unterminated quoted string", "To: \"unclosed <b@example.org>\r\n", b"", [
      { at: 60, reason: Unclosed },
    ]),
    defect_case(
      "a boundary never closed",
      "Content-Type: multipart/mixed; boundary=b\r\n",
      b"--b\r\n\r\none\r\n--b\r\n\r\ntwo\r\n",
      [{ at: 129, reason: UnclosedBoundary }],
    ),
    defect_case("a line over 998 octets", "", b"x".repeat(999).concat(b"\r\n"), [
      { at: 62 + 998, reason: LongLine },
    ]),
    defect_case("a header line over 998 octets", "X-Long: " ++ "x".repeat(991) ++ "\r\n", b"", [
      { at: 60 + 998, reason: LongLine },
    ]),
    defect_case("8-bit bytes in a header", "Subject: caf\u{e9}\r\n", b"", [
      { at: 60 + 12, reason: EightBitHeader },
    ]),
    {
      what: "bytes that are no UTF-8 in a header that may hold UTF-8",
      data: Bytes::concat_all([Bytes::of_string(required_fields()), b"Subject: caf\xe9\r\n\r\n"]),
      utf8: true,
      defects: [{ at: 60 + 12, reason: EightBitHeader }],
    },
    defect_case("a bad encoded word", "Subject: =?x-unknown?Q?a?= b\r\n", b"", [
      { at: 60, reason: BadEncodedWord },
    ]),
    defect_case(
      "an encoded word that carries a line break",
      "Subject: =?UTF-8?Q?a=0D=0ABcc:_x?=\r\n",
      b"",
      [{ at: 60, reason: BadEncodedWord }],
    ),
    defect_case("a control character in a field", "Subject: a\0b\r\n", b"", [
      { at: 70, reason: Control },
    ]),
    {
      what: "no date and no author",
      data: b"Subject: x\r\n\r\n",
      utf8: false,
      defects: [{ at: 0, reason: Missing("date") }, { at: 0, reason: Missing("from") }],
    },
    defect_case("a second author field", "From: b@example.org\r\n", b"", [
      { at: 60, reason: Repeated("from") },
    ]),
    defect_case("a group for an author", "Subject: x\r\nFrom: Team:b@example.org;\r\n", b"", [
      { at: 72, reason: Repeated("from") },
      { at: 72, reason: Unexpected },
    ]),
    {
      what: "a field that ends the message with no line break",
      data: b"Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: a@example.org",
      utf8: false,
      defects: [{ at: 58, reason: Truncated }],
    },
    {
      what: "a date that is none",
      data: b"Date: yesterday\r\nFrom: a@example.org\r\n\r\n",
      utf8: false,
      defects: [{ at: 0, reason: BadDate }],
    },
    defect_case(
      "a message identifier with no brackets",
      "Message-ID: 1234@example.org\r\n",
      b"",
      [{ at: 60, reason: BadMessageId }],
    ),
    defect_case("two message identifiers for one message", "Message-ID: <a@b> <c@d>\r\n", b"", [
      { at: 60, reason: BadMessageId },
    ]),
    defect_case("references that name nothing", "References: (none)\r\n", b"", [
      { at: 60, reason: BadMessageId },
    ]),
    defect_case("a media type that is none", "Content-Type: text\r\n", b"x", [
      { at: 60, reason: BadMediaType },
    ]),
    defect_case(
      "a parameter whose sections do not count from zero",
      "Content-Type: text/plain; name*1=x\r\n",
      b"x",
      [{ at: 60, reason: BadMediaType }],
    ),
    defect_case(
      "a second media type",
      "Content-Type: text/plain\r\nContent-Type: text/html\r\n",
      b"x",
      [{ at: 86, reason: Repeated("content-type") }],
    ),
    defect_case(
      "a disposition that does not read",
      "Content-Disposition: attachment; filename\r\n",
      b"x",
      [{ at: 60, reason: BadDisposition }],
    ),
    defect_case(
      "a transfer encoding nobody names",
      "Content-Transfer-Encoding: uuencode\r\n",
      b"x",
      [{ at: 60, reason: BadEncoding("uuencode") }],
    ),
    defect_case(
      "a body that is not the base64 it says",
      "Content-Transfer-Encoding: base64\r\n",
      b"!!!!",
      [{ at: 60 + 37, reason: BadTransferData }],
    ),
    defect_case(
      "a body that is not the quoted-printable it says",
      "Content-Transfer-Encoding: quoted-printable\r\n",
      b"a=ZZ",
      [{ at: 60 + 47, reason: BadTransferData }],
    ),
    defect_case("an 8-bit byte in a body that names no encoding", "", b"caf\xe9\r\n", [
      { at: 65, reason: Undeclared8Bit },
    ]),
    defect_case(
      "a multipart body under an encoding",
      "Content-Type: multipart/mixed; boundary=b\r\nContent-Transfer-Encoding: base64\r\n",
      b"--b--\r\n",
      [{ at: 103, reason: BadEncoding("base64") }],
    ),
    defect_case(
      "a multipart body with no boundary named",
      "Content-Type: multipart/mixed\r\n",
      b"--b--\r\n",
      [{ at: 93, reason: BadMultipart(multipart::NoBoundary) }],
    ),
    defect_case(
      "a delimiter that goes on as text",
      "Content-Type: multipart/mixed; boundary=b\r\n",
      b"--bx\r\n\r\none\r\n--b--\r\n",
      [{ at: 108, reason: BadMultipart(multipart::BadDelimiter) }],
    ),
    defect_case("an obsolete blank before a colon", "Subject : x\r\n", b"", [
      { at: 60, reason: ObsoleteSyntax },
    ]),
    defect_case("a folded line of blanks alone", "Subject: x\r\n \t\r\n y\r\n", b"", [
      { at: 72, reason: ObsoleteSyntax },
    ]),
  ]

test "lists the defects of {c.what}" for c: DefectCase in defect_cases() {
  let repertoire = if c.utf8 { Utf8 } else { Ascii };
  let read = read_tolerant(c.data, default_limits(), repertoire);
  assert_eq(read.defects, c.defects);
  assert_eq(render(read.message), c.data);
  assert_eq(parse(c.data, default_limits(), repertoire).map(render), match c.defects {
    [found, ..] -> Err(found),
    [] -> Ok(c.data),
  })
}

type LimitCase = { what: String, data: Bytes, limits: Limits, at: Int, reason: ErrorKind }

/// Limits small enough for a test's message to pass each.
fn tight() -> Limits =
  { max_bytes: 400, max_fields: 3, max_header_bytes: 120, max_depth: 1, max_parts: 2 }

fn two_deep() -> Bytes =
  message_of(
    "Content-Type: multipart/mixed; boundary=a\r\n",
    b"--a\r\nContent-Type: multipart/mixed; boundary=b\r\n\r\n--b\r\n\r\ndeep\r\n--b--\r\n--a--\r\n",
  )

fn three_parts() -> Bytes =
  message_of(
    "Content-Type: multipart/mixed; boundary=a\r\n",
    b"--a\r\n\r\n1\r\n--a\r\n\r\n2\r\n--a\r\n\r\n3\r\n--a--\r\n",
  )

/// Messages past a limit, each with where it passes it.
fn limit_cases() -> List<LimitCase> =
  [
    {
      what: "a message longer than the limit",
      data: message_of("", b"x".repeat(400)),
      limits: tight(),
      at: 400,
      reason: TooLarge,
    },
    {
      what: "a header field more than the limit",
      data: message_of("Subject: x\r\nTo: b@example.org\r\n", b""),
      limits: tight(),
      at: 72,
      reason: TooManyFields,
    },
    {
      what: "a header block longer than the limit",
      data: message_of("Subject: " ++ "x".repeat(100) ++ "\r\n", b""),
      limits: tight(),
      at: 120,
      reason: HeadersTooLarge,
    },
    {
      what: "a header block with no end",
      data: Bytes::of_string(required_fields() ++ "Subject: ").concat(b"x".repeat(300)),
      limits: tight(),
      at: 120,
      reason: HeadersTooLarge,
    },
    {
      what: "parts nested deeper than the limit",
      data: two_deep(),
      limits: tight(),
      at: 110,
      reason: TooDeep,
    },
    {
      what: "any multipart body where none may nest",
      data: three_parts(),
      limits: { ..tight(), max_depth: 0 },
      at: 0,
      reason: TooDeep,
    },
    {
      what: "a part more than the limit",
      data: three_parts(),
      limits: tight(),
      at: 130,
      reason: TooManyParts,
    },
    {
      what: "a nested part more than the limit",
      data: two_deep(),
      limits: { ..tight(), max_depth: 2, max_parts: 1 },
      at: 160,
      reason: TooManyParts,
    },
    {
      what: "a header field more than the limit in a part",
      data: message_of(
        "Content-Type: multipart/mixed; boundary=a\r\n",
        b"--a\r\nA: 1\r\nB: 2\r\nC: 3\r\nD: 4\r\n\r\n\r\n--a--\r\n",
      ),
      limits: tight(),
      at: 128,
      reason: TooManyFields,
    },
  ]

test "rejects {c.what}" for c: LimitCase in limit_cases() {
  assert_eq(parse(c.data, c.limits).map(render), Err({ at: c.at, reason: c.reason }));
  assert_eq(
    parse_tolerant(c.data, c.limits).map(|t: MessageWithDefects| t.defects),
    Err({ at: c.at, reason: c.reason }),
  )
}

test "a message at its limits is read, and limits below zero are read as zero" {
  let limits: Limits = tight();
  assert(parse(message_of("", b"x".repeat(338)), limits).is_ok());
  assert(parse(message_of("Subject: x\r\n", b""), limits).is_ok());
  assert(parse(message_of("Subject: " ++ "x".repeat(47) ++ "\r\n", b""), limits).is_ok());
  assert(parse(two_deep(), { ..limits, max_depth: 2 }).is_ok());
  assert(parse(three_parts(), { ..limits, max_parts: 3 }).is_ok());
  assert_eq(
    parse(b"", { ..limits, max_bytes: -1 }).map(render),
    Err({ at: 0, reason: Missing("date") }),
  );
  assert_eq(parse(b"x", { ..limits, max_bytes: -1 }).map(render), Err({ at: 0, reason: TooLarge }));
  assert_eq(
    parse(message_of("", b""), { ..limits, max_fields: -1 }).map(render),
    Err({ at: 0, reason: TooManyFields }),
  )
}

/// RFC 2046 §5.1.1's message.
fn sample_message() -> String =
  \\From: Nathaniel Borenstein <nsb@bellcore.com>
  \\To: Ned Freed <ned@innosoft.com>
  \\Date: Sun, 21 Mar 1993 23:56:48 -0800 (PST)
  \\Subject: Sample message
  \\MIME-Version: 1.0
  \\Content-type: multipart/mixed; boundary="simple boundary"
  \\
  \\This is the preamble.  It is to be ignored, though it
  \\is a handy place for composition agents to include an
  \\explanatory note to non-MIME conformant readers.
  \\
  \\--simple boundary
  \\
  \\This is implicitly typed plain US-ASCII text.
  \\It does NOT end with a linebreak.
  \\--simple boundary
  \\Content-type: text/plain; charset=us-ascii
  \\
  \\This is explicitly typed plain US-ASCII text.
  \\It DOES end with a linebreak.
  \\
  \\--simple boundary--
  \\
  \\This is the epilogue.  It is also to be ignored.

/// RFC 2046 §5.1.4's message.
fn formatted_text_mail() -> String =
  \\From: Nathaniel Borenstein <nsb@bellcore.com>
  \\To: Ned Freed <ned@innosoft.com>
  \\Date: Mon, 22 Mar 1993 09:41:09 -0800 (PST)
  \\Subject: Formatted text mail
  \\MIME-Version: 1.0
  \\Content-Type: multipart/alternative; boundary=boundary42
  \\
  \\--boundary42
  \\Content-Type: text/plain; charset=us-ascii
  \\
  \\  ... plain text version of message goes here ...
  \\
  \\--boundary42
  \\Content-Type: text/enriched
  \\
  \\  ... RFC 1896 text/enriched version of same message
  \\      goes here ...
  \\
  \\--boundary42
  \\Content-Type: application/x-whatever
  \\
  \\  ... fanciest version of same message goes here ...
  \\
  \\--boundary42--

/// RFC 2049 Appendix A's message, as printed: its audio part's encoding comes after a blank line,
/// in its body, and its base64 parts contain a sentence in place of their data.
fn complex_multipart() -> String =
  \\MIME-Version: 1.0
  \\From: Nathaniel Borenstein <nsb@nsb.fv.com>
  \\To: Ned Freed <ned@innosoft.com>
  \\Date: Fri, 07 Oct 1994 16:15:05 -0700 (PDT)
  \\Subject: A multipart example
  \\Content-Type: multipart/mixed;
  \\              boundary=unique-boundary-1
  \\
  \\This is the preamble area of a multipart message.
  \\Mail readers that understand multipart format
  \\should ignore this preamble.
  \\
  \\If you are reading this text, you might want to
  \\consider changing to a mail reader that understands
  \\how to properly display multipart messages.
  \\
  \\--unique-boundary-1
  \\
  \\  ... Some text appears here ...
  \\
  \\[Note that the blank between the boundary and the start
  \\ of the text in this part means no header fields were
  \\ given and this is text in the US-ASCII character set.
  \\ It could have been done with explicit typing as in the
  \\ next part.]
  \\
  \\--unique-boundary-1
  \\Content-type: text/plain; charset=US-ASCII
  \\
  \\This could have been part of the previous part, but
  \\illustrates explicit versus implicit typing of body
  \\parts.
  \\
  \\--unique-boundary-1
  \\Content-Type: multipart/parallel; boundary=unique-boundary-2
  \\
  \\--unique-boundary-2
  \\Content-Type: audio/basic
  \\
  \\Content-Transfer-Encoding: base64
  \\
  \\  ... base64-encoded 8000 Hz single-channel
  \\      mu-law-format audio data goes here ...
  \\
  \\--unique-boundary-2
  \\Content-Type: image/jpeg
  \\Content-Transfer-Encoding: base64
  \\
  \\  ... base64-encoded image data goes here ...
  \\
  \\--unique-boundary-2--
  \\
  \\--unique-boundary-1
  \\Content-type: text/enriched
  \\
  \\This is <bold><italic>enriched.</italic></bold>
  \\<smaller>as defined in RFC 1896</smaller>
  \\
  \\Isn't it
  \\<bigger><bigger>cool?</bigger></bigger>
  \\
  \\--unique-boundary-1
  \\Content-Type: message/rfc822
  \\
  \\From: (mailbox in US-ASCII)
  \\To: (address in US-ASCII)
  \\Subject: (subject in US-ASCII)
  \\Content-Type: Text/plain; charset=ISO-8859-1
  \\Content-Transfer-Encoding: Quoted-printable
  \\
  \\  ... Additional text in ISO-8859-1 goes here ...
  \\
  \\--unique-boundary-1--

/// The media type of each part of a message that is not multipart, in the order written.
fn leaf_types(m: Message) -> List<String> / {abort.raise} =
  leaves(m, []).map(|l: Leaf| show(content_type(l.part)))

test "RFC 2046's sample message is two parts between a preamble and an epilogue" {
  let m = read(crlf_text(sample_message()), default_limits());
  assert_eq(show(content_type(m)), "multipart/mixed; boundary=\"simple boundary\"");
  assert_eq(mime_version(m), Some("1.0"));
  assert_eq(parts(m).map(body), [
    b"This is implicitly typed plain US-ASCII text.\r\nIt does NOT end with a linebreak.",
    b"This is explicitly typed plain US-ASCII text.\r\nIt DOES end with a linebreak.\r\n",
  ]);
  assert_eq(leaf_types(m), ["text/plain; charset=us-ascii", "text/plain; charset=us-ascii"]);
  assert_eq(
    text_body(m),
    Some(Text("This is implicitly typed plain US-ASCII text.\nIt does NOT end with a linebreak.")),
  );
  assert_eq(html_body(m), None);
  assert_eq(attachments(m).map(|a: Attachment| a.data), [
    b"This is explicitly typed plain US-ASCII text.\r\nIt DOES end with a linebreak.\r\n",
  ]);
  assert_eq(date(m), date::parse_rfc3339("1993-03-21T23:56:48-08:00"));
  assert_eq(render(m), crlf_text(sample_message()))
}

test "RFC 2046's alternatives are read in the order written, the plainest the text body" {
  let m = read(crlf_text(formatted_text_mail()), default_limits());
  assert_eq(leaf_types(m), [
    "text/plain; charset=us-ascii",
    "text/enriched",
    "application/x-whatever",
  ]);
  assert_eq(text_body(m), Some(Text("  ... plain text version of message goes here ...\n")));
  assert_eq(html_body(m), None);
  assert_eq(attachments(m).len(), 2);
  assert_eq(draft_of(m), None)
}

test "RFC 2049's complex multipart message is read as the parts it prints" {
  let data = crlf_text(complex_multipart());
  let read = read_tolerant(data, default_limits());
  let m = read.message;
  assert_eq(read.defects.map(|d: Error| d.reason), [BadTransferData]);
  assert_eq(leaf_types(m), [
    "text/plain; charset=us-ascii",
    "text/plain; charset=US-ASCII",
    "audio/basic",
    "image/jpeg",
    "text/enriched",
    "message/rfc822",
  ]);
  assert_eq(parts(m).map(|p: Message| parts(p).len()), [0, 0, 2, 0, 0]);
  assert_eq(leaves(m, []).map(|l: Leaf| transfer_encoding(l.part)), [
    SevenBit,
    SevenBit,
    SevenBit,
    Base64,
    SevenBit,
    SevenBit,
  ]);
  assert_eq(subject(m), Some("A multipart example"));
  assert_eq(date(m), date::parse_rfc3339("1994-10-07T16:15:05-07:00"));
  // The encapsulated message is a part's body, and a message of its own to whoever reads it.
  let inner = read_tolerant(
    match parts(m).at(4) { Some(p) -> body(p), None -> b"" },
    default_limits(),
  ).message;
  assert_eq(subject(inner), Some("(subject in US-ASCII)"));
  assert_eq(show(content_type(inner)), "text/plain; charset=ISO-8859-1");
  assert_eq(transfer_encoding(inner), QuotedPrintable);
  assert_eq(text(inner), Text("  ... Additional text in ISO-8859-1 goes here ...\n"));
  assert_eq(render(m), data)
}

type MediaTypeCase = { fields: String, media: String }

/// `Content-Type` fields and the media type each is. The first two are RFC 2045 §5.1's, which
/// it calls completely equivalent, and the next three RFC 2231's.
fn media_type_cases() -> List<MediaTypeCase> =
  [
    {
      fields: "Content-type: text/plain; charset=us-ascii (Plain text)\r\n",
      media: "text/plain; charset=us-ascii",
    },
    {
      fields: "Content-type: text/plain; charset=\"us-ascii\"\r\n",
      media: "text/plain; charset=us-ascii",
    },
    {
      fields: "Content-Type: message/external-body; access-type=URL;\r\n URL*0=\"ftp://\";\r\n URL*1=\"cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar\"\r\n",
      media: "message/external-body; access-type=URL; url=\"ftp://cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar\"",
    },
    {
      fields: "Content-Type: application/x-stuff;\r\n title*=us-ascii'en-us'This%20is%20%2A%2A%2Afun%2A%2A%2A\r\n",
      media: "application/x-stuff; title=\"This is ***fun***\"",
    },
    {
      fields: "Content-Type: application/x-stuff;\r\n title*0*=us-ascii'en'This%20is%20even%20more%20;\r\n title*1*=%2A%2A%2Afun%2A%2A%2A%20;\r\n title*2=\"isn't it!\"\r\n",
      media: "application/x-stuff; title=\"This is even more ***fun*** isn't it!\"",
    },
    { fields: "", media: "text/plain; charset=us-ascii" },
    { fields: "CONTENT-TYPE: (a comment) Image/PNG (and another)\r\n", media: "image/png" },
    {
      fields: "Content-Type: text/html; title=\"a (b) c\"\r\n",
      media: "text/html; title=\"a (b) c\"",
    },
    { fields: "Content-Type: nonsense\r\n", media: "text/plain; charset=us-ascii" },
  ]

test "the media type of {show(c.fields)}" for c: MediaTypeCase in media_type_cases() {
  assert_eq(
    show(content_type(read_tolerant(message_of(c.fields, b""), default_limits()).message)),
    c.media,
  )
}

test "RFC 2045's four forms of one MIME version are the same version" {
  let version = |value: String|
    mime_version(read(message_of("MIME-Version: " ++ value ++ "\r\n", b""), default_limits()));
  assert_eq(
    [
      "1.0",
      "1.0 (produced by MetaSend Vx.x)",
      "(produced by MetaSend Vx.x) 1.0",
      "1.(produced by MetaSend Vx.x)0",
    ].map(
      version,
    ),
    [Some("1.0"), Some("1.0"), Some("1.0"), Some("1.0")],
  );
  assert_eq(mime_version(read(message_of("", b""), default_limits())), None)
}

type EncodingCase = {
  what: String,
  fields: String,
  payload: Bytes,
  content: Option<Bytes>,
  text: BodyText,
}

/// Bodies in each transfer encoding and charset, with their content and their text.
fn coded_bodies() -> List<EncodingCase> =
  [
    {
      what: "a body with no fields",
      fields: "",
      payload: b"plain\r\ntext\r\n",
      content: Some(b"plain\r\ntext\r\n"),
      text: Text("plain\ntext\n"),
    },
    {
      what: "quoted-printable UTF-8",
      fields: "Content-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: quoted-printable\r\n",
      payload: b"caf=C3=A9 au=\r\n lait\r\n",
      content: Some(b"caf\xc3\xa9 au lait\r\n"),
      text: Text("caf\u{e9} au lait\n"),
    },
    {
      what: "base64 in lines",
      fields: "Content-Type: text/plain; charset=UTF-8\r\nContent-Transfer-Encoding: BASE64\r\n",
      payload: b"Y2Fm\r\nw6k=\r\n",
      content: Some(b"caf\xc3\xa9"),
      text: Text("caf\u{e9}"),
    },
    {
      what: "base64 with blanks, a stray byte and no padding",
      fields: "Content-Transfer-Encoding: base64\r\n",
      payload: b" Y2 Fm!\r\n\tw6k\r\n",
      content: Some(b"caf\xc3\xa9"),
      text: Malformed(b"caf\xc3\xa9"),
    },
    {
      what: "8bit ISO-8859-1",
      fields: "Content-Type: text/plain; charset=ISO-8859-1\r\nContent-Transfer-Encoding: 8bit\r\n",
      payload: b"caf\xe9\r\n",
      content: Some(b"caf\xe9\r\n"),
      text: Text("caf\u{e9}\n"),
    },
    {
      what: "windows-1252",
      fields: "Content-Type: text/plain; charset=\"Windows-1252\"\r\nContent-Transfer-Encoding: quoted-printable\r\n",
      payload: b"=93quoted=94 =80",
      content: Some(b"\x93quoted\x94 \x80"),
      text: Text("\u{201c}quoted\u{201d} \u{20ac}"),
    },
    {
      what: "a charset this module does not read",
      fields: "Content-Type: text/plain; charset=Shift_JIS\r\nContent-Transfer-Encoding: base64\r\n",
      payload: b"k/qWe4zq",
      content: Some(b"\x93\xfa\x96\x7b\x8c\xea"),
      text: Unknown(b"\x93\xfa\x96\x7b\x8c\xea", "shift_jis"),
    },
    {
      what: "bytes that are no text in the charset named",
      fields: "Content-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: 8bit\r\n",
      payload: b"caf\xe9",
      content: Some(b"caf\xe9"),
      text: Malformed(b"caf\xe9"),
    },
    {
      what: "8-bit bytes under no charset",
      fields: "Content-Transfer-Encoding: 8bit\r\n",
      payload: b"caf\xc3\xa9",
      content: Some(b"caf\xc3\xa9"),
      text: Malformed(b"caf\xc3\xa9"),
    },
    {
      what: "a body that is not in its encoding",
      fields: "Content-Transfer-Encoding: quoted-printable\r\n",
      payload: b"a=ZZ",
      content: None,
      text: Malformed(b"a=ZZ"),
    },
    {
      what: "an encoding nobody names",
      fields: "Content-Transfer-Encoding: x-uuencode\r\n",
      payload: b"begin",
      content: None,
      text: Malformed(b"begin"),
    },
    {
      what: "line breaks of every kind",
      fields: "Content-Transfer-Encoding: binary\r\n",
      payload: b"a\r\nb\nc\r\r\nd\re",
      content: Some(b"a\r\nb\nc\r\r\nd\re"),
      text: Text("a\nb\nc\nd\re"),
    },
  ]

test "the content and the text of {c.what}" for c: EncodingCase in coded_bodies() {
  let m = read_tolerant(message_of(c.fields, c.payload), default_limits()).message;
  assert_eq(content(m), c.content);
  assert_eq(text(m), c.text)
}

fn mixed_message() -> String =
  \\From: =?UTF-8?Q?J=C3=BCrgen?= <j@example.org>
  \\Date: Fri, 21 Nov 1997 09:55:06 -0600
  \\MIME-Version: 1.0
  \\Content-Type: multipart/mixed; boundary="outer"
  \\
  \\--outer
  \\Content-Type: multipart/alternative; boundary=inner
  \\
  \\--inner
  \\Content-Type: text/plain; charset=utf-8
  \\Content-Transfer-Encoding: quoted-printable
  \\
  \\caf=C3=A9
  \\--inner
  \\Content-Type: multipart/related; boundary=deepest
  \\
  \\--deepest
  \\Content-Type: text/html
  \\
  \\<img src="cid:logo@example.org">
  \\--deepest
  \\Content-Type: image/png
  \\Content-Transfer-Encoding: base64
  \\Content-ID: <logo@example.org>
  \\Content-Disposition: inline; filename=logo.png
  \\
  \\iVBORw0KGgo=
  \\--deepest--
  \\--inner--
  \\--outer
  \\Content-Type: application/pdf; name="fallback.pdf"
  \\Content-Disposition: attachment;
  \\ filename*0*=UTF-8''na%C3%AFve%20;
  \\ filename*1="resume.pdf" (a comment)
  \\Content-Transfer-Encoding: base64
  \\
  \\JVBERi0xLjQ=
  \\--outer
  \\Content-Type: text/plain
  \\Content-Disposition: ATTACHMENT; filename="../../etc/passwd"
  \\
  \\root
  \\--outer--

test "a message's bodies and its attachments are found through its parts" {
  let data = crlf_text(mixed_message());
  let m = read(data, default_limits());
  assert_eq(text_body(m), Some(Text("caf\u{e9}")));
  assert_eq(html_body(m), Some(Text("<img src=\"cid:logo@example.org\">")));
  assert_eq(attachments(m).map(|a: Attachment| a.filename), [
    Some("logo.png"),
    Some("na\u{ef}ve resume.pdf"),
    Some("../../etc/passwd"),
  ]);
  assert_eq(attachments(m).map(|a: Attachment| show(a.content_type)), [
    "image/png",
    "application/pdf; name=fallback.pdf",
    "text/plain",
  ]);
  assert_eq(attachments(m).map(|a: Attachment| a.data), [
    b"\x89PNG\r\n\x1a\n",
    b"%PDF-1.4",
    b"root",
  ]);
  assert_eq(attachments(m).map(|a: Attachment| a.content_id.map(id_text)), [
    Some("<logo@example.org>"),
    None,
    None,
  ]);
  // A file name is data: the one way to a name on disk never leaves its directory.
  assert_eq(multipart::safe_filename("../../etc/passwd"), Some("passwd"));
  let attached = match parts(m).at(1) { Some(p) -> disposition(p), None -> None };
  assert_eq(attached, Some({ kind: "attachment", filename: Some("na\u{ef}ve resume.pdf") }));
  assert_eq(disposition(m), None);
  assert_eq(content_id(m), None);
  assert_eq(from(m).map(|a: Mailbox| display_name(a)), [Some("J\u{fc}rgen")]);
  assert_eq(render(m), data)
}

test "a single part that is not text is an attachment, and an attached text part is not a body" {
  let pdf = read(
    message_of(
      "Content-Type: application/pdf\r\nContent-Transfer-Encoding: base64\r\n",
      b"JVBERi0xLjQ=",
    ),
    default_limits(),
  );
  assert_eq(text_body(pdf), None);
  assert_eq(attachments(pdf).map(|a: Attachment| a.data), [b"%PDF-1.4"]);
  let note = read(
    message_of(
      "Content-Type: text/plain\r\nContent-Disposition: attachment; filename=note.txt\r\n",
      b"x",
    ),
    default_limits(),
  );
  assert_eq(text_body(note), None);
  assert_eq(attachments(note).map(|a: Attachment| a.filename), [Some("note.txt")]);
  let page = read(message_of("Content-Type: text/html\r\n", b"<p>x</p>"), default_limits());
  assert_eq(html_body(page), Some(Text("<p>x</p>")));
  assert_eq(text_body(page), None);
  assert_eq(attachments(page), [])
}

test "UTF-8 in a header is read when requested, and is a defect when not" {
  let data = Bytes::of_string(
    "Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: J\u{fc}rgen M\u{fc}ller <j\u{fc}rgen@b\u{fc}cher.example>\r\nTo: \u{7528}\u{6237}@\u{4f8b}\u{3048}.jp\r\nSubject: Gr\u{fc}\u{df}e aus K\u{f6}ln\r\n\r\n",
  );
  let m = read(data, default_limits(), Utf8);
  assert_eq(from(m).map(|a: Mailbox| show(a)), [
    "J\u{fc}rgen M\u{fc}ller <j\u{fc}rgen@b\u{fc}cher.example>",
  ]);
  assert_eq(address_list_text(to(m)), "\u{7528}\u{6237}@\u{4f8b}\u{3048}.jp");
  assert_eq(subject(m), Some("Gr\u{fc}\u{df}e aus K\u{f6}ln"));
  assert_eq(render(m), data);
  let plain = read_tolerant(data, default_limits());
  assert_eq(plain.defects.map(|d: Error| d.reason), [
    NonAscii,
    EightBitHeader,
    NonAscii,
    EightBitHeader,
    EightBitHeader,
  ]);
  assert_eq(from(plain.message), []);
  assert_eq(subject(plain.message), Some("Gr\u{fc}\u{df}e aus K\u{f6}ln"));
  assert_eq(parse(data, default_limits()).map(render), Err({ at: 39, reason: NonAscii }))
}

test "RFC 8058's fields are read, and written from the same links" {
  let simple = read(
    message_of(
      "List-Unsubscribe: <https://example.com/unsubscribe/opaquepart>\r\nList-Unsubscribe-Post: List-Unsubscribe=One-Click\r\n",
      b"",
    ),
    default_limits(),
  );
  assert_eq(
    header(simple, "List-Unsubscribe"),
    Some("<https://example.com/unsubscribe/opaquepart>"),
  );
  assert_eq(header(simple, "List-Unsubscribe-Post"), Some("List-Unsubscribe=One-Click"));
  let complex = read(
    message_of(
      "List-Unsubscribe:\r\n    <mailto:listrequest@example.com?subject=unsubscribe>,\r\n    <https://example.com/unsubscribe.html?opaque=123456789>\r\nList-Unsubscribe-Post: List-Unsubscribe=One-Click\r\n",
      b"",
    ),
    default_limits(),
  );
  assert_eq(
    header(complex, "list-unsubscribe"),
    Some(
      "<mailto:listrequest@example.com?subject=unsubscribe>,    <https://example.com/unsubscribe.html?opaque=123456789>",
    ),
  );
  let d = list_unsubscribe(plain_draft(), [
    "mailto:listrequest@example.com?subject=unsubscribe",
    "https://example.com/unsubscribe.html?opaque=123456789",
  ]);
  assert_eq(d.fields.map(|f: Field| f.raw), [
    b"List-Unsubscribe: <mailto:listrequest@example.com?subject=unsubscribe>,\r\n <https://example.com/unsubscribe.html?opaque=123456789>\r\n",
    b"List-Unsubscribe-Post: List-Unsubscribe=One-Click\r\n",
  ]);
  let once = list_unsubscribe(d, ["https://example.com/unsubscribe/opaquepart"]);
  assert_eq(once.fields.map(|f: Field| f.value), [
    "<https://example.com/unsubscribe/opaquepart>",
    "List-Unsubscribe=One-Click",
  ]);
  assert_eq(
    try { list_unsubscribe(d, ["mailto:list@example.com"]) },
    Err({ at: 0, reason: Unexpected }),
  );
  assert_eq(try { list_unsubscribe(d, []) }, Err({ at: 0, reason: Unexpected }));
  assert_eq(
    try {
      list_unsubscribe(d, [
        "https://example.com/a",
        "https://example.com/b>,<mailto:eve@example.org",
      ])
    },
    Err({ at: 1, reason: Unexpected }),
  );
  assert_eq(
    try { list_unsubscribe(d, ["https://example.com/a b"]) },
    Err({ at: 0, reason: Unexpected }),
  )
}

fn when() -> OffsetDateTime / {abort.raise} =
  match date::parse_rfc3339("1997-11-21T09:55:06-06:00") {
    Some(at) -> at,
    None -> panic("no date"),
  }

/// RFC 5322 Appendix A.1.1's message as a draft, with no body yet.
fn plain_draft() -> Draft / {email.fail, abort.raise} =
  draft(
    named_mailbox("John Doe", address("jdoe", "machine.example")),
    [named_mailbox("Mary Smith", address("mary", "example.net"))],
    "Saying Hello",
    when(),
    message_id("1234", "local.machine.example"),
  )

fn greeting() -> String = "This is a message just to say hello.\nSo, \"Hello\".\n"

test "a text draft is written as RFC 5322's first example, with the fields MIME adds" {
  let d = with_text(plain_draft(), greeting());
  assert_eq(
    build(d, "unused"),
    Ok(
      b"Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: John Doe <jdoe@machine.example>\r\nTo: Mary Smith <mary@example.net>\r\nSubject: Saying Hello\r\nMessage-ID: <1234@local.machine.example>\r\nMIME-Version: 1.0\r\nContent-Type: text/plain; charset=us-ascii\r\nContent-Transfer-Encoding: 7bit\r\n\r\nThis is a message just to say hello.\r\nSo, \"Hello\".\r\n",
    ),
  );
  let read_back = read(write(d, "unused"), default_limits());
  assert_eq(
    reader_summary(read_back),
    reader_summary(read(crlf_text(simple_addressing()), default_limits())),
  );
  assert_eq(draft_of(read_back), Some(d));
  // RFC 5322's own message, which has no MIME fields, is a draft of the same text.
  assert_eq(draft_of(read(crlf_text(simple_addressing()), default_limits())), Some(d))
}

test "a draft of nothing but its fields has no body and no content type" {
  assert_eq(
    build(plain_draft(), "unused"),
    Ok(
      b"Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: John Doe <jdoe@machine.example>\r\nTo: Mary Smith <mary@example.net>\r\nSubject: Saying Hello\r\nMessage-ID: <1234@local.machine.example>\r\nMIME-Version: 1.0\r\n\r\n",
    ),
  );
  assert_eq(draft_of(read(write(plain_draft(), "unused"), default_limits())), Some(plain_draft()));
  let empty = with_text(plain_draft(), "");
  assert(empty != plain_draft());
  assert_eq(draft_of(read(write(empty, "unused"), default_limits())), Some(empty))
}

test "a text and an HTML body are alternatives, inline parts are related, and attachments are mixed" {
  let logo: Attachment = {
    filename: Some("logo.png"),
    content_type: MediaType("image", "png", []),
    content_id: Some(message_id("logo", "machine.example")),
    data: b"\x89PNG\r\n\x1a\n",
  };
  let d = attach(
    inline(
      with_html(with_text(plain_draft(), "caf\u{e9}\n"), "<img src=\"cid:logo@machine.example\">"),
      logo,
    ),
    attachment("r\u{e9}sum\u{e9}.txt", b"plain\r\nlines\r\n"),
  );
  assert_eq(
    build(d, "b").map(|data: Bytes|
      String::of_bytes(
        data.slice(match data.index_of(b"MIME-Version") { Some(i) -> i, None -> 0 }, data.len()),
      )),
    Ok(
      String::replace(
        \\MIME-Version: 1.0
        \\Content-Type: multipart/mixed; boundary=b
        \\
        \\--b
        \\Content-Type: multipart/alternative; boundary=2-b
        \\
        \\--2-b
        \\Content-Type: text/plain; charset=utf-8
        \\Content-Transfer-Encoding: base64
        \\
        \\Y2Fmw6kNCg==
        \\--2-b
        \\Content-Type: multipart/related; boundary=3-b
        \\
        \\--3-b
        \\Content-Type: text/html; charset=us-ascii
        \\Content-Transfer-Encoding: 7bit
        \\
        \\<img src="cid:logo@machine.example">
        \\--3-b
        \\Content-Type: image/png
        \\Content-Transfer-Encoding: base64
        \\Content-Disposition: inline; filename=logo.png
        \\Content-ID: <logo@machine.example>
        \\
        \\iVBORw0KGgo=
        \\--3-b--
        \\
        \\--2-b--
        \\
        \\--b
        \\Content-Type: text/plain
        \\Content-Transfer-Encoding: 7bit
        \\Content-Disposition: attachment; filename*=UTF-8''r%C3%A9sum%C3%A9.txt
        \\
        \\plain
        \\lines
        \\
        \\--b--
        \\
        ,
        "\n",
        "\r\n",
      ),
    ),
  );
  let m = read(write(d, "b"), default_limits());
  assert_eq(text_body(m), Some(Text("caf\u{e9}\n")));
  assert_eq(html_body(m), Some(Text("<img src=\"cid:logo@machine.example\">")));
  assert_eq(attachments(m).map(|a: Attachment| a.filename), [
    Some("logo.png"),
    Some("r\u{e9}sum\u{e9}.txt"),
  ]);
  assert_eq(draft_of(m), Some(d))
}

test "a draft's other fields are written after its own, and none takes the name of one it writes" {
  let d = with_field(
    with_field(plain_draft(), field("X-Mailer", "ply")),
    text_field("Comments", "caf\u{e9}"),
  );
  assert_eq(d.fields.map(|f: Field| f.raw), [
    b"X-Mailer: ply\r\n",
    b"Comments: =?UTF-8?B?Y2Fmw6k=?=\r\n",
  ]);
  let m = read(write(d, "unused"), default_limits());
  assert_eq(fields(m).map(|f: Field| f.name), [
    "Date",
    "From",
    "To",
    "Subject",
    "Message-ID",
    "X-Mailer",
    "Comments",
    "MIME-Version",
  ]);
  assert_eq(unstructured(m, "comments"), Some("caf\u{e9}"));
  assert_eq(draft_of(m), Some(d));
  assert_eq(
    [
      "From",
      "bcc",
      "SUBJECT",
      "Message-Id",
      "MIME-Version",
      "Content-Type",
      "content-anything",
    ].map(|name: String|
      (try { with_field(plain_draft(), field(name, "x")) }) == Err({ at: 0, reason: BadName })),
    [true, true, true, true, true, true, true],
  )
}

test "no value given to a draft adds a field to it" {
  let eve = "x\r\nBcc: eve@example.org";
  assert_eq(try { with_subject(plain_draft(), eve) }, Err({ at: 1, reason: LineBreak }));
  assert_eq(
    try { draft(mailbox(jdoe()), [], eve, when(), message_id("a", "example.org")) },
    Err({ at: 1, reason: LineBreak }),
  );
  assert_eq(try { named_mailbox(eve, jdoe()) }, Err({ at: 1, reason: LineBreak }));
  assert_eq(try { address(eve, "example.org") }, Err({ at: 1, reason: LineBreak }));
  assert_eq(
    try { address("jdoe", "example.org>\r\nBcc: eve@example.org") },
    Err({ at: 11, reason: BadDomain }),
  );
  assert_eq(try { message_id("a", eve) }, Err({ at: 1, reason: BadMessageId }));
  assert_eq(try { field("X-A", eve) }, Err({ at: 1, reason: LineBreak }));
  assert_eq(try { field(eve, "x") }, Err({ at: 1, reason: BadName }));
  assert_eq(try { with_from(plain_draft(), []) }, Err({ at: 0, reason: NoAddress }));
  // A file name and a body are data, and are written so that they stay data.
  let d = attach(with_text(plain_draft(), eve), attachment("a\r\nBcc: eve@example.org", b"x"));
  let m = read(write(d, "b"), default_limits());
  assert_eq(bcc(m), []);
  assert_eq(text_body(m), Some(Text("x\nBcc: eve@example.org")));
  assert_eq(attachments(m).map(|a: Attachment| a.filename), [Some("a\r\nBcc: eve@example.org")]);
  assert_eq(fields(m).len(), 7)
}

test "a blind copy is in the envelope, and in the bytes only when requested" {
  let eve = mailbox(address("eve", "example.org"));
  let d = with_bcc(
    with_cc(plain_draft(), [
      group("Team", [mailbox(address("mary", "EXAMPLE.NET")), eve]),
      mailbox_entry(mailbox(jdoe())),
    ]),
    [mailbox_entry(eve), mailbox_entry(mailbox(address("frank", "example.org")))],
  );
  let sent_to = recipients(d).map(|a: Address| show(a));
  assert_eq(sent_to, [
    "mary@example.net",
    "eve@example.org",
    "jdoe@example.org",
    "frank@example.org",
  ]);
  let e = envelope(d);
  assert_eq(e.sender, ReturnTo(address("jdoe", "machine.example")));
  assert_eq(e.recipients, recipients(d));
  assert_eq(e.utf8, false);
  assert_eq(repertoire_for(d), Ascii);
  let dropped = read(write(d, "unused"), default_limits());
  assert_eq(bcc(dropped), []);
  assert_eq(header(dropped, "bcc"), None);
  assert_eq(
    header(dropped, "cc"),
    Some("Team: mary@EXAMPLE.NET, eve@example.org;, jdoe@example.org"),
  );
  let kept = read(write(d, "unused", Ascii, IncludeBcc), default_limits());
  assert_eq(address_list_text(bcc(kept)), "eve@example.org, frank@example.org");
  assert_eq(draft_of(kept), Some(d));
  assert_eq(draft_of(dropped), Some(with_bcc(d, [])));
  let sender = named_mailbox("Michael Jones", address("mjones", "machine.example"));
  assert_eq(show(envelope(with_sender(d, sender)).sender), "ReturnTo(mjones@machine.example)");
  let far = with_to(d, [mailbox_entry(mailbox(address("\u{7528}\u{6237}", "example.org", Utf8)))]);
  assert_eq(envelope(far).utf8, true);
  assert_eq(repertoire_for(far), Utf8)
}

test "an envelope contains each address once, and reports whether one of them is outside ASCII" {
  let far = address("\u{7528}\u{6237}", "example.org", Utf8);
  let mary = address("mary", "example.net");
  let bounce = envelope_of(NullPath, [jdoe(), address("jdoe", "EXAMPLE.ORG"), mary]);
  assert_eq(bounce.sender, NullPath);
  assert_eq(bounce.recipients, [jdoe(), mary]);
  assert_eq(bounce.utf8, false);
  assert_eq(envelope_of(ReturnTo(far), [jdoe()]).utf8, true);
  assert_eq(envelope_of(NullPath, [jdoe(), far]).utf8, true);
  assert_eq(envelope_of(NullPath, []).recipients, [])
}

type RelayCase = { what: String, message: String, expect: Result<String, Error> }

fn relay_cases() -> List<RelayCase> =
  [
    {
      what: "a sender, and every address of To, Cc and Bcc, a group's among them",
      message:
        \\From: John Doe <jdoe@machine.example>, Ann <ann@example.org>
        \\Sender: Michael Jones <mjones@machine.example>
        \\To: Mary Smith <mary@example.net>, Team: a@example.org, b@example.org;
        \\Cc: <boss@nil.test>, MARY@EXAMPLE.NET
        \\Bcc: eve@example.org
        \\Date: Fri, 21 Nov 1997 09:55:06 -0600
        \\
        \\Hi.
      ,
      expect: Ok(
        "mjones@machine.example > mary@example.net a@example.org b@example.org boss@nil.test MARY@EXAMPLE.NET eve@example.org",
      ),
    },
    {
      what: "the first author where no sender is named, and an empty blind copy field",
      message:
        \\From: jdoe@machine.example, ann@example.org
        \\To: mary@example.net
        \\Bcc:
        \\
        \\Hi.
      ,
      expect: Ok("jdoe@machine.example > mary@example.net"),
    },
    {
      what: "a message resent travels under its Resent- fields",
      message:
        \\Resent-From: Mary Smith <mary@example.net>
        \\Resent-To: Jane Brown <j-brown@other.example>
        \\Resent-Bcc: eve@example.org
        \\Resent-Date: Mon, 24 Nov 1997 14:22:01 -0800
        \\From: John Doe <jdoe@machine.example>
        \\To: Mary Smith <mary@example.net>
        \\Cc: boss@nil.test
        \\
        \\Hi.
      ,
      expect: Ok("mary@example.net > j-brown@other.example eve@example.org"),
    },
    {
      what: "a message resent twice does not say whose addresses are whose",
      message:
        \\Resent-From: a@example.org
        \\Resent-To: b@example.org
        \\Resent-From: mary@example.net
        \\Resent-To: c@example.org
        \\From: jdoe@machine.example
        \\
        \\Hi.
      ,
      expect: Err({ at: 0, reason: Repeated("resent-from") }),
    },
    {
      what: "no author",
      message:
        \\To: mary@example.net
        \\
        \\Hi.
      ,
      expect: Err({ at: 0, reason: Missing("from") }),
    },
    {
      what: "a resent message with no one who resent it",
      message:
        \\Resent-To: b@example.org
        \\From: jdoe@machine.example
        \\
        \\Hi.
      ,
      expect: Err({ at: 0, reason: Missing("resent-from") }),
    },
    {
      what: "a recipient field that does not read is refused, never passed over",
      message:
        \\From: jdoe@machine.example
        \\To: mary@example.net, broken@
        \\
        \\Hi.
      ,
      expect: Err({ at: 25, reason: BadDomain }),
    },
    {
      what: "no recipient at all is an envelope to no one",
      message:
        \\From: jdoe@machine.example
        \\
        \\Hi.
      ,
      expect: Ok("jdoe@machine.example >"),
    },
  ]

test "a message read is relayed with the envelope its fields name: {r.what}" for r: RelayCase in relay_cases(
  ) {
  let m = read_tolerant(crlf_text(r.message), default_limits()).message;
  let named_by = try { message_envelope(m) };
  assert_eq(
    named_by.map(|e: Envelope|
      String::join(
        prepend(
          match e.sender { ReturnTo(a) -> show(a) ++ " >", NullPath -> "<>" },
          e.recipients.map(|a: Address| show(a)),
        ),
        " ",
      )),
    r.expect,
  )
}

test "a message without a field renders as it was read, except for those lines" {
  let data = crlf_text(
    \\From: jdoe@machine.example
    \\bcc: eve@example.org,
    \\ frank@example.org
    \\To: mary@example.net
    \\Bcc: grace@example.org
    \\
    \\Bcc: this line is the body's
  );
  let m = read_tolerant(data, default_limits()).message;
  assert_eq(
    render(without(m, "Bcc")),
    crlf_text(
      \\From: jdoe@machine.example
      \\To: mary@example.net
      \\
      \\Bcc: this line is the body's
    ),
  );
  assert_eq(render(without(m, "resent-bcc")), data);
  assert_eq(bcc(without(m, "BCC")), []);
  assert_eq(message_envelope(m).recipients.len(), 4);
  assert_eq(message_envelope(without(m, "bcc")).recipients.len(), 1)
}

test "a domain outside ASCII is written as its A-labels unless UTF-8 is requested, and needs no `SMTPUTF8`" {
  let a = address("a", "b\u{fc}cher.example", Utf8);
  let written = |utf8: Bool|
    Result::map(try { address_field("To", [mailbox_entry(mailbox(a))], utf8) }, value_of);
  assert_eq(written(false).map(|v: String| v.contains("a@xn--bcher-kva.example")), Ok(true));
  assert_eq(written(true).map(|v: String| v.contains("a@b\u{fc}cher.example")), Ok(true));
  let d = with_sender(with_text(plain_draft(), "text\n"), mailbox(a));
  assert_eq(envelope(d).utf8, false);
  assert_eq(envelope(d).sender, ReturnTo(a));
  assert_eq(ascii_text(a), Some("a@xn--bcher-kva.example"));
  assert(build(d, "x").is_ok())
}

type WriteErrorCase = { what: String, draft: Draft, boundary: String, reason: Unwritable }

fn write_error_cases() -> List<WriteErrorCase> / {email.fail, abort.raise} = {
  let d = with_text(plain_draft(), "text\n--b\n");
  let file: Attachment = {
    filename: None,
    content_type: MediaType("text", "plain", []),
    content_id: None,
    data: b"x",
  };
  [
    {
      what: "an address outside ASCII",
      draft: with_to(d, [mailbox_entry(mailbox(address("j\u{fc}rgen", "example.org", Utf8)))]),
      boundary: "x",
      reason: NeedsUtf8,
    },
    {
      what: "a local part outside ASCII beside a domain outside it",
      draft: with_sender(d, mailbox(address("\u{e4}", "b\u{fc}cher.example", Utf8))),
      boundary: "x",
      reason: NeedsUtf8,
    },
    {
      what: "a field outside ASCII",
      draft: with_field(d, field("X-Note", "caf\u{e9}", Utf8)),
      boundary: "x",
      reason: NeedsUtf8,
    },
    {
      what: "inline parts and no HTML body",
      draft: inline(d, file),
      boundary: "x",
      reason: NoHtml,
    },
    {
      what: "an attachment that is multipart",
      draft: attach(attach(d, file), { ..file, content_type: MediaType("multipart", "mixed", []) }),
      boundary: "x",
      reason: BadAttachment(1),
    },
    {
      what: "an attachment that is a message",
      draft: attach(inline(with_html(d, "x"), file), {
        ..file,
        content_type: MediaType("message", "rfc822", []),
      }),
      boundary: "x",
      reason: BadAttachment(1),
    },
    {
      what: "an attachment whose type is no token",
      draft: attach(d, { ..file, content_type: MediaType("text", "pl\r\nain", []) }),
      boundary: "x",
      reason: BadAttachment(0),
    },
    {
      what: "an attachment whose parameter is named as a section",
      draft: attach(d, {
        ..file,
        content_type: MediaType("text", "plain", [{ name: "a*0", value: "x" }]),
      }),
      boundary: "x",
      reason: BadAttachment(0),
    },
    {
      what: "a boundary a part holds",
      draft: attach(d, file),
      boundary: "b",
      reason: Framing(multipart::BoundaryInPart(0)),
    },
    {
      what: "a boundary that is none",
      draft: attach(d, file),
      boundary: "a\"b",
      reason: Framing(multipart::InvalidBoundary),
    },
    {
      what: "a boundary too long to nest",
      draft: attach(with_html(d, "x"), file),
      boundary: "a".repeat(69),
      reason: Framing(multipart::InvalidBoundary),
    },
  ]
}

test "does not write {c.what}" for c: WriteErrorCase in write_error_cases() {
  assert_eq(build(c.draft, c.boundary), Err(c.reason))
}

test "under UTF-8 a draft is written unchanged, and read back" {
  let d = with_field(
    with_text(
      draft(
        named_mailbox(
          "J\u{fc}rgen M\u{fc}ller",
          address("j\u{fc}rgen", "b\u{fc}cher.example", Utf8),
        ),
        [mailbox(address("\u{7528}\u{6237}", "\u{4f8b}\u{3048}.jp", Utf8))],
        "Gr\u{fc}\u{df}e",
        when(),
        message_id("1", "example.org"),
      ),
      "Gr\u{fc}\u{df}e\n",
    ),
    field("X-Note", "caf\u{e9}", Utf8),
  );
  let data = write(d, "unused", Utf8);
  assert_eq(
    String::of_bytes(data),
    "Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: J\u{fc}rgen M\u{fc}ller <j\u{fc}rgen@b\u{fc}cher.example>\r\nTo: \u{7528}\u{6237}@\u{4f8b}\u{3048}.jp\r\nSubject: Gr\u{fc}\u{df}e\r\nMessage-ID: <1@example.org>\r\nX-Note: caf\u{e9}\r\nMIME-Version: 1.0\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: base64\r\n\r\nR3LDvMOfZQ0K\r\n",
  );
  assert_eq(draft_of(read(data, default_limits(), Utf8)), Some(d));
  assert_eq(envelope(d).utf8, true)
}

test "a draft composed now is dated by the clock and identified by the host's entropy" {
  let composed = handle {
    try {
      compose(
        named_mailbox("John Doe", address("jdoe", "machine.example")),
        [mailbox(jdoe())],
        "Hello",
      )
    }
  } with {
    time.now_ms() -> 880127706123,
    entropy.next() -> 7,
  };
  assert_eq(composed.map(|d: Draft| show(d.date)), Ok("1997-11-21T15:55:06Z"));
  assert_eq(composed.map(|d: Draft| id_text(d.id)), Ok("<7-7@machine.example>"));
  let fresh = handle {
    build_fresh(attach(with_text(plain_draft(), "x"), attachment("a.bin", b"\x00\x01")))
  } with {
    entropy.next() -> 7,
  };
  assert_eq(
    fresh.map(|data: Bytes| show(content_type(read(data, default_limits())))),
    Ok("multipart/mixed; boundary=boundary-7-7"),
  )
}

fn build_fresh(d: Draft) -> Result<Bytes, Unwritable> / {entropy.next bounded, abort.raise} =
  try { write_fresh(d) }

test "the generators draw drafts of every shape" {
  let arbitrary_text = list::somes(
    range(0, 300).map(|root: Int| gen::sample(drafts(), root, b"shapes", root % 40, None).value),
  );
  let some = |ok: (Draft) -> Bool / {abort.raise}| arbitrary_text.any(ok);
  assert_eq(arbitrary_text.len(), 300);
  assert(some(|d: Draft| d.text != None && d.html == None));
  assert(some(|d: Draft| d.text == None && d.html != None));
  assert(some(|d: Draft| d.text != None && d.html != None));
  assert(some(|d: Draft| d.text == None && d.html == None && d.attachments.len() == 0));
  assert(some(|d: Draft| d.text == None && d.html == None && d.attachments.len() > 0));
  assert(some(|d: Draft| d.inline.len() > 0 && d.attachments.len() > 0 && d.text != None));
  assert(some(|d: Draft| d.subject == None));
  assert(some(|d: Draft| match d.subject { Some(s) -> s.len() > 998, None -> false }));
  assert(some(|d: Draft| !envelope(d).utf8 && d.fields.len() == 0));
  assert(some(|d: Draft| envelope(d).utf8));
  assert(some(|d: Draft| d.to.any(|e: Entry| group_name(e) != None)));
  assert(some(|d: Draft| d.bcc.len() > 0 && d.references.len() > 0 && d.sender != None));
  assert(some(|d: Draft| build(d, "boundary").is_ok()));
  assert(some(|d: Draft| build(d, "boundary") == Err(NeedsUtf8)))
}

/// Limits no message a test draws comes near.
fn roomy() -> Limits =
  {
    max_bytes: 1073741824,
    max_fields: 100000,
    max_header_bytes: 16777216,
    max_depth: 64,
    max_parts: 100000,
  }

test "a draft written and read strictly is the draft, and what was read is rendered as the bytes written" {
  gen::check(drafts(), |d: Draft| {
    match build(d, "boundary", Utf8, IncludeBcc) {
      Err(_) -> false,
      Ok(data) -> match parse(data, roomy(), Utf8) {
        Ok(m) -> draft_of(m) == Some(d) && render(m) == data,
        Err(_) -> false,
      },
    }
  })
}

test "a body with no line break at its end is written with one that is not part of it" {
  let texts = [
    "Hello",
    "Hello\nagain",
    "caf\u{e9}",
    "\u{65e5}\u{672c}\u{8a9e}\u{306e}\u{30c6}\u{30ad}\u{30b9}\u{30c8}",
    "a=b",
    "",
    "x\n",
  ];
  assert_eq(
    texts.map(|body: String| {
      let d = with_text(plain_draft(), body);
      let data = write(d, "unused");
      let m = read(data, default_limits());
      {
        ended: String::of_bytes(data).ends_with("\r\n"),
        encoding: header(m, "content-transfer-encoding"),
        read: text_body(m) == Some(Text(body)),
        same: draft_of(m) == Some(d),
      }
    }),
    ["quoted-printable", "quoted-printable", "base64", "base64", "base64", "7bit", "7bit"].map(
      |encoding: String| { ended: true, encoding: Some(encoding), read: true, same: true },
    ),
  );
  assert(
    String::of_bytes(write(with_text(plain_draft(), "Hello"), "unused")).ends_with(
      "\r\n\r\nHello=\r\n",
    ),
  )
}

test "no subject and no name writes a line break of its own, a line past 998 octets or a second field" {
  gen::check2(gen::text(), gen::text(), |topic: String, name: String| {
    match try {
        draft(
          named_mailbox(name, jdoe()),
          [named_mailbox(name, jdoe())],
          topic,
          when(),
          message_id("a", "example.org"),
        )
      } {
      Err(_) -> !is_quotable(topic) || !is_quotable(name),
      Ok(d) -> match build(d, "unused") {
        Err(_) -> false,
        Ok(data) -> match parse(data, roomy()) {
          Err(_) -> false,
          Ok(m) ->
            line_defects(data, 0).len() == 0 && fields(m).len() == 6 && subject(m) == Some(topic)
              && from(m).map(display_name) == [if name == "" { None } else { Some(name) }],
        },
      },
    }
  })
}

test "any bytes are read tolerantly, and rendered as they were" {
  gen::check(gen::bytes(), |data: Bytes| {
    let wrapped = Bytes::concat_all([
      b"Content-Type: multipart/mixed; boundary=b\r\n\r\n--b\r\n",
      data,
      b"\r\n--b\r\nContent-Type: multipart/mixed; boundary=c\r\n\r\n--c\r\n",
      data,
      b"\r\n--b--\r\n",
    ]);
    [data, wrapped].all(|given: Bytes|
      [Ascii, Utf8].all(|repertoire: Repertoire|
        match parse_tolerant(given, default_limits(), repertoire) {
          Ok(read) ->
            render(read.message) == given
              && read.defects.all(|d: Error| d.at >= 0 && d.at <= given.len())
              && read.defects.len() == 0 == parse(given, default_limits(), repertoire).is_ok(),
          Err(_) -> false,
        }))
  })
}

/// RFC 6376 §3.4.5's message.
fn signed_message() -> Bytes = b"A: X\r\nB : Y\t\r\n\tZ  \r\n\r\n C \r\nD \t E\r\n\r\n\r\n"

test "RFC 6376's examples are canonical in each form" {
  let m = read_tolerant(signed_message(), default_limits()).message;
  let head = |form: Canonical|
    Bytes::concat_all(fields(m).map(|f: Field| canonical_field(f, form)));
  assert_eq(head(Relaxed), b"a:X\r\nb:Y Z\r\n");
  assert_eq(canonical_body(body(m), Relaxed), b" C\r\nD E\r\n");
  assert_eq(head(Simple), b"A: X\r\nB : Y\t\r\n\tZ  \r\n");
  assert_eq(canonical_body(body(m), Simple), b" C \r\nD \t E\r\n")
}

test "an empty body is a line break in the simple form and empty in the relaxed one" {
  assert_eq(canonical_body(b"", Simple), b"\r\n");
  assert_eq(canonical_body(b"\r\n\r\n", Simple), b"\r\n");
  assert_eq(canonical_body(b"", Relaxed), b"");
  assert_eq(canonical_body(b"\r\n \t\r\n", Relaxed), b"");
  assert_eq(canonical_body(b"a", Simple), b"a\r\n");
  assert_eq(canonical_body(b"a", Relaxed), b"a\r\n");
  assert_eq(canonical_body(b"a\r\n\r\nb \r\n\r\n", Simple), b"a\r\n\r\nb \r\n");
  assert_eq(canonical_body(b"a\r\n\r\nb \r\n\r\n", Relaxed), b"a\r\n\r\nb\r\n");
  assert_eq(canonical_body(b"\ta  b\t", Relaxed), b" a b\r\n");
  let folded_field = field("Subject", "word ".repeat(30));
  assert_eq(
    canonical_field(folded_field, Relaxed),
    Bytes::of_string("subject:" ++ "word ".repeat(29) ++ "word\r\n"),
  );
  assert_eq(canonical_field(folded_field, Simple), folded_field.raw)
}
