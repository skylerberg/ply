test "`xxh3_64` of a generated {c.size}-byte input with seed {c.seed} matches the reference hash" for c: Sanity in xxh3_sanity(
  ) { assert_eq(xxh3_64(sanity(c.size), c.seed), c.sum) }

test "xxHash of text, unseeded" {
  assert_eq(xxh64(b"abc", 0u64), 0x44BC_2CF5_AD77_0999u64);
  assert_eq(xxh3_64(b"abc", 0u64), 0x78AF_5F94_892F_3950u64);
  assert_eq(xxh64(b"Nobody inspects the spammish repetition", 0u64), 0xFBCE_A83C_8A37_8BF1u64);
  assert_eq(xxh3_64(b"Nobody inspects the spammish repetition", 0u64), 0x6CB0_0603_B5CC_47E9u64)
}

fn sixteen() -> SipKey = SipKey(0x0706_0504_0302_0100, 0x0F0E_0D0C_0B0A_0908)

type SipVector = { size: Int, siphash24: U64, siphash13: U64 }

fn sip_vectors() -> List<SipVector> =
  [
    { size: 0, siphash24: 0x726F_DB47_DD0E_0E31u64, siphash13: 0xABAC_0158_050F_C4DCu64 },
    { size: 1, siphash24: 0x74F8_39C5_93DC_67FDu64, siphash13: 0xC9F4_9BF3_7D57_CA93u64 },
    { size: 7, siphash24: 0xAB02_00F5_8B01_D137u64, siphash13: 0xD392_7D98_9BB1_1140u64 },
    { size: 8, siphash24: 0x93F5_F579_9A93_2462u64, siphash13: 0x3690_9511_8D29_9A8Eu64 },
    { size: 9, siphash24: 0x9E00_82DF_0BA9_E4B0u64, siphash13: 0x25A4_8EB3_6C06_3DE4u64 },
    { size: 15, siphash24: 0xA129_CA61_49BE_45E5u64, siphash13: 0xD320_D86D_2A51_9956u64 },
    { size: 16, siphash24: 0x3F2A_CC7F_57C2_9BDBu64, siphash13: 0xCC4F_DD1A_7D90_8B66u64 },
    { size: 63, siphash24: 0x958A_324C_EB06_4572u64, siphash13: 0x9D19_9062_B7BB_B3A8u64 },
  ]

test "`siphash24` and `siphash13` of {c.size} bytes with the reference 16-byte key match the published test vectors" for c: SipVector in sip_vectors(
  ) {
  assert_eq(siphash24(sixteen(), counted(c.size)), c.siphash24);
  assert_eq(siphash13(sixteen(), counted(c.size)), c.siphash13)
}

test "`sip_key` accepts only 16 bytes, printing a key shows `SipKey(****)` instead of its bytes, and `random_sip_key` draws random numbers" {
  assert_eq(sip_key(counted(16)), Some(sixteen()));
  assert_eq(sip_key(counted(15)), None);
  assert_eq(sip_key(counted(17)), None);
  assert_eq(show(sixteen()), "SipKey(****)");
  assert_eq(f"{sixteen()}", "SipKey(****)");
  let drawn = handle { random_sip_key() } with { entropy.next() -> 5 };
  assert_eq(drawn, SipKey(5 | 1 << 63, 5))
}

fn every() -> List<Algorithm> =
  [
    Crc(crc8_smbus()),
    Crc(crc16_arc()),
    Crc(crc16_xmodem()),
    Crc(crc32_iso_hdlc()),
    Crc(crc32_mpeg2()),
    Crc(crc64_xz()),
    Crc(crc64_ecma_182()),
    Adler32,
    Fnv1a32,
    Fnv1a64,
    Xxh64(0u64),
    Xxh64(0x9E37_79B1_85EB_CA8Du64),
    Xxh3(0u64),
    Xxh3(0x9E37_79B1_85EB_CA8Du64),
    SipHash13(sixteen()),
    SipHash24(sixteen()),
  ]

fn whole(a: Algorithm, data: Bytes) -> U64 = finish(update(init(a), data))

fn pieces(a: Algorithm, data: Bytes, size: Int) -> State / {abort.raise} =
  range(0, (data.len() + size - 1) / size).fold(init(a), |s: State, k: Int|
    update(s, data.slice(k * size, min((k + 1) * size, data.len()))))

test "the checksum of an input fed in pieces, split at any position or into any piece size, equals the checksum of the whole input" {
  let data = sanity(1500);
  let cuts = [
    0,
    1,
    3,
    4,
    7,
    8,
    9,
    31,
    32,
    33,
    63,
    64,
    65,
    128,
    129,
    239,
    240,
    241,
    256,
    1023,
    1024,
    1025,
    1088,
    1089,
    1499,
    1500,
  ];
  every().fold((), |_: Unit, a: Algorithm| {
    let want = whole(a, data);
    cuts.fold((), |_: Unit, at: Int|
      assert_eq(finish(update(update(init(a), data.slice(0, at)), data.slice(at, 1500))), want));
    [1, 7, 64, 100, 241].fold((), |_: Unit, size: Int|
      assert_eq(finish(pieces(a, data, size)), want))
  })
}

test "a state stays usable after finishing: it accepts more input" {
  every().fold((), |_: Unit, a: Algorithm| {
    let half = update(init(a), b"the first half, ");
    assert_eq(finish(half), whole(a, b"the first half, "));
    assert_eq(finish(update(half, b"and the second")), whole(a, b"the first half, and the second"))
  })
}

test "for any two inputs, updating a checksum with each in turn equals the checksum of the two joined" {
  gen::check2(gen::bytes(), gen::bytes(), |a: Bytes, b: Bytes| {
    every().fold(true, |ok: Bool, alg: Algorithm|
      ok && finish(update(update(init(alg), a), b)) == whole(alg, a.concat(b)))
  })
}

test "the CRC-32 of two inputs joined is their CRC-32s combined" {
  gen::check2(gen::bytes(), gen::bytes(), |a: Bytes, b: Bytes| {
    crc32_combine(crc32(a), crc32(b), b.len()) == crc32(a.concat(b))
  })
}

test "the Adler-32 of two inputs joined is their Adler-32s combined" {
  gen::check2(gen::bytes(), gen::bytes(), |a: Bytes, b: Bytes| {
    adler32_combine(adler32(a), adler32(b), b.len()) == adler32(a.concat(b))
  })
}

fn models() -> List<Crc> =
  [
    crc8_smbus(),
    crc16_arc(),
    crc16_ibm_3740(),
    crc16_xmodem(),
    crc32_iso_hdlc(),
    crc32_cksum(),
    crc32_mpeg2(),
    crc64_xz(),
    crc64_ecma_182(),
    match crc_of(crc12_umts()) { Some(c) -> c, None -> crc8_smbus() },
  ]

test "a CRC combines under every kind of model, over lengths short and long" {
  let data = sanity(3000);
  models().fold((), |_: Unit, c: Crc|
    [0, 1, 7, 8, 255, 256, 1500, 2999, 3000].fold((), |_: Unit, at: Int| {
      let head = data.slice(0, at);
      let tail = data.slice(at, 3000);
      assert_eq(crc_combine(c, crc(c, head), crc(c, tail), 3000 - at), crc(c, data));
      assert_eq(crc_join(c, crc_part(c, head), crc_part(c, tail)), crc_part(c, data))
    }));
  assert_eq(crc32_combine(crc32(b"abc"), crc32(b""), 0), crc32(b"abc"));
  assert_eq(crc32_combine(crc32(b"abc"), crc32(b""), 0 - 5), crc32(b"abc"));
  assert_eq(adler32_combine(adler32(b"abc"), adler32(b""), 0 - 5), adler32(b"abc"))
}

test "a CRC computed over chunks with `par_fold` equals the CRC of the chunks joined into one input" {
  let chunks = range(0, 3 * grain_size() + 5).map(|i: Int| sanity(i % 41));
  let all = Bytes::concat_all(chunks);
  [crc32_iso_hdlc(), crc16_xmodem(), crc64_xz()].fold((), |_: Unit, c: Crc| {
    let folded = par_fold(
      chunks,
      crc_empty(c),
      |accumulator: Part, chunk: Bytes| crc_join(c, accumulator, crc_part(c, chunk)),
      |a: Part, b: Part| crc_join(c, a, b),
    );
    assert_eq(folded.sum, crc(c, all))
  })
}
