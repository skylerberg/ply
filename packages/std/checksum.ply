//! Checksums and non-cryptographic hashes: any CRC, Adler-32, FNV-1a, xxHash and SipHash.
//!
//! A checksum detects accidental damage, not an attacker: none of these replaces `std.hash`.
//! SipHash is the keyed one, for a table whose keys an outsider chooses. A key drawn at start-up
//! makes a hash that differs from run to run, so keep it out of anything whose order a program can
//! observe.
//!
//! Each algorithm hashes a whole input in one call, and `init`, `update` and `finish` give the
//! same result for the input in pieces, however it is split. A sum is a number, a `U32` or a
//! `U64`. Where a format stores one, the format decides the byte order: gzip writes its CRC-32
//! least significant byte first, and zlib writes its Adler-32 most significant byte first.
//!
//! A CRC is described by the Rocksoft model, `Model`, and computed by a `Crc`, which is the model
//! with its tables built: 2048 entries, processing eight bytes per step. The presets are those of
//! the CRC catalogue, each built once per run. Build a model of your own with `crc_of`, and keep
//! the `Crc` it returns. `crc_join` computes the sum of a concatenation from the sums of its
//! parts, which makes a CRC a monoid and lets `std.parallel.par_fold` compute one over chunks.
//!
//! Nothing here raises or reads the outside world except `random_sip_key`.

import std.bytes (u64_le)
import std.laws (monoid)
import std.list
import std.parallel (grain_size, par_fold)
import std.random (entropy)
import std.show (show)
import std.gen

fn u32_of(x: Int) -> U32 = handle { U32::of_int(x & 0xFFFF_FFFF) } with { abort.raise(_) -> 0u32 }

fn u64_of(x: Int) -> U64 =
  handle {
    U64::of_int(x >>> 32) << 32 | U64::of_int(x & 0xFFFF_FFFF)
  } with {
    abort.raise(_) -> 0u64,
  }

fn int_of(x: U64) -> Int =
  handle {
    Int::of_u64(x >>> 32) << 32 | Int::of_u64(x & 0xFFFF_FFFFu64)
  } with {
    abort.raise(_) -> 0,
  }

fn joined(pending: Bytes, chunk: Bytes) -> Bytes =
  if pending.len() == 0 { chunk } else { pending.concat(chunk) }

/// Describes a CRC by the standard parameters of the Rocksoft model. `width` is the register size
/// in bits, from 1 to 64. `poly` is the generator polynomial without its top term. `init` is the
/// starting register. `reflect_in` says whether each input byte is bit-reversed, and `reflect_out`
/// whether the final register is. `xor_out` is xored into the result.
pub type Model = new {
  width: Int,
  poly: U64,
  init: U64,
  reflect_in: Bool,
  reflect_out: Bool,
  xor_out: U64,
}

/// A `Model` with its tables built, ready to compute. Build one with `crc_of`: a `Crc` built any
/// other way may not match any model.
pub type Crc = new {
  model: Model,
  /// The polynomial with its `width` bits in reverse order. Every model stores its register in
  /// reverse bit order, so one loop computes all of them.
  poly: Int,
  /// The register before any byte.
  start: Int,
  /// What the last register is xored with.
  last: Int,
  /// The multiplier that moves a register past one byte: `x` raised to the eighth power, modulo the
  /// polynomial, in reverse bit order.
  byte: Int,
  /// Eight tables of 256 entries: entry `256 * k + b` is the register that byte `b` produces `k`
  /// bytes later.
  table: Array<Int>,
}

/// The `Crc` that computes `model`, or `None` for a width outside 1 to 64 or a parameter wider than
/// the width.
pub fn crc_of(model: Model) -> Option<Crc> =
  if model.width < 1 || model.width > 64 { None }
  else if model.width < 64 && (model.poly | model.init | model.xor_out) >>> model.width != 0u64 {
    None
  } else { Some(crc_from_model(model)) }

fn crc_from_model(model: Model) -> Crc = {
  let poly = reflected(int_of(model.poly), model.width);
  {
    model: model,
    poly: poly,
    start: reflected(int_of(model.init), model.width),
    last: int_of(model.xor_out),
    byte: crc_entry(poly, 1 << model.width - 1),
    table: crc_table(poly),
  }
}

fn all_bits_reversed(x: Int) -> Int = {
  let bytes = bits_reversed(x);
  let pairs = bytes >>> 8 & 0x00FF_00FF_00FF_00FF | (bytes & 0x00FF_00FF_00FF_00FF) << 8;
  let quads = pairs >>> 16 & 0x0000_FFFF_0000_FFFF | (pairs & 0x0000_FFFF_0000_FFFF) << 16;
  quads >>> 32 | quads << 32
}

fn bits_reversed(x: Int) -> Int = {
  let ones = x >>> 1 & 0x5555_5555_5555_5555 | (x & 0x5555_5555_5555_5555) << 1;
  let twos = ones >>> 2 & 0x3333_3333_3333_3333 | (ones & 0x3333_3333_3333_3333) << 2;
  twos >>> 4 & 0x0F0F_0F0F_0F0F_0F0F | (twos & 0x0F0F_0F0F_0F0F_0F0F) << 4
}

fn reflected(x: Int, width: Int) -> Int = all_bits_reversed(x) >>> 64 - width

fn crc_entry(poly: Int, reg: Int) -> Int =
  range(0, 8).fold(reg, |accumulator: Int, _: Int|
    if accumulator & 1 == 1 { poly ^ accumulator >>> 1 } else { accumulator >>> 1 })

fn crc_table(poly: Int) -> Array<Int> = {
  let first = range(0, 256).map(|n: Int| crc_entry(poly, n));
  Array::of_list(
    range(256, 2048).fold(first, |accumulator: List<Int>, i: Int|
      match accumulator.at(i - 256) {
        None -> accumulator,
        Some(before) -> match first.at(before & 0xFF) {
          None -> accumulator,
          Some(next) -> accumulator.push(next ^ before >>> 8),
        },
      }),
  )
}

fn crc_words(
  table: Array<Int>,
  reflect: Bool,
  reg: Int,
  data: Bytes,
  i: Int,
) -> Int / {abort.raise} =
  if i + 8 > data.len() { crc_tail(table, reflect, reg, data, i) } else {
    let word = Int::of_u32(data.u32_le(i)) | Int::of_u32(data.u32_le(i + 4)) << 32;
    let x = reg ^ (if reflect { word } else { bits_reversed(word) });
    crc_words(
      table,
      reflect,
      table.get(1792 + (x & 0xFF)) ^ table.get(1536 + (x >>> 8 & 0xFF))
        ^ table.get(1280 + (x >>> 16 & 0xFF))
        ^ table.get(1024 + (x >>> 24 & 0xFF))
        ^ table.get(768 + (x >>> 32 & 0xFF))
        ^ table.get(512 + (x >>> 40 & 0xFF))
        ^ table.get(256 + (x >>> 48 & 0xFF))
        ^ table.get(x >>> 56),
      data,
      i + 8,
    )
  }

fn crc_tail(
  table: Array<Int>,
  reflect: Bool,
  reg: Int,
  data: Bytes,
  i: Int,
) -> Int / {abort.raise} =
  if i >= data.len() { reg } else {
    let byte = if reflect { data.at(i) } else { bits_reversed(data.at(i)) };
    crc_tail(table, reflect, table.get((reg ^ byte) & 0xFF) ^ reg >>> 8, data, i + 1)
  }

fn crc_mask(width: Int) -> Int = if width >= 64 { 0 - 1 } else { (1 << width) - 1 }

fn crc_out(c: Crc, reg: Int) -> Int =
  (if c.model.reflect_out { reg } else { reflected(reg, c.model.width) }) ^ c.last

fn crc_in(c: Crc, sum: Int) -> Int = {
  let reg = (sum ^ c.last) & crc_mask(c.model.width);
  if c.model.reflect_out { reg } else { reflected(reg, c.model.width) }
}

fn crc_product(poly: Int, a: Int, b: Int, bit: Int, accumulator: Int) -> Int =
  if bit < 0 { accumulator } else {
    crc_product(
      poly,
      a,
      if b & 1 == 1 { poly ^ b >>> 1 } else { b >>> 1 },
      bit - 1,
      if a >>> bit & 1 == 1 { accumulator ^ b } else { accumulator },
    )
  }

fn crc_times(c: Crc, a: Int, b: Int) -> Int = crc_product(c.poly, a, b, c.model.width - 1, 0)

fn crc_shift(c: Crc, n: Int, base: Int, accumulator: Int) -> Int =
  if n <= 0 { accumulator } else {
    crc_shift(c, n / 2, crc_times(c, base, base), if n % 2 == 1 { crc_times(c, accumulator, base) }
    else { accumulator })
  }

fn crc_one(c: Crc) -> Int = 1 << c.model.width - 1

fn crc_over(c: Crc, reg: Int, data: Bytes) -> Int =
  handle { crc_words(c.table, c.model.reflect_in, reg, data, 0) } with { abort.raise(_) -> reg }

/// The CRC of `data` under `c`, in the low `width` bits.
pub fn crc(c: Crc, data: Bytes) -> U64 = u64_of(crc_out(c, crc_over(c, c.start, data)))

/// Summarizes a run of bytes so that runs can be joined. `sum` is the CRC of the bytes, and `shift`
/// is `x` raised to eight times their length, modulo the polynomial. Values wider than the model's
/// width are invalid; under a 64-bit model every pair of values is allowed.
pub type Part = new { sum: U64, shift: U64 }

/// The part for `chunk`.
pub fn crc_part(c: Crc, chunk: Bytes) -> Part =
  { sum: crc(c, chunk), shift: u64_of(crc_shift(c, chunk.len(), c.byte, crc_one(c))) }

/// The part for no bytes: the identity of `crc_join`.
pub fn crc_empty(c: Crc) -> Part = { sum: u64_of(crc_out(c, c.start)), shift: u64_of(crc_one(c)) }

/// The part for `a`'s bytes followed by `b`'s, computed in a number of steps that does not grow
/// with either. Associative, with `crc_empty` as its identity.
pub fn crc_join(c: Crc, a: Part, b: Part) -> Part = {
  let shift = int_of(b.shift);
  let carried = crc_times(c, crc_in(c, int_of(a.sum)) ^ c.start, shift);
  {
    sum: u64_of(crc_out(c, carried ^ crc_in(c, int_of(b.sum)))),
    shift: u64_of(crc_times(c, int_of(a.shift), shift)),
  }
}

/// The CRC of two inputs joined, from the CRC `a` of the first, the CRC `b` of the second and
/// the second's length in bytes.
pub fn crc_combine(c: Crc, a: U64, b: U64, len_b: Int) -> U64 =
  crc_join(c, { sum: a, shift: 0u64 }, {
    sum: b,
    shift: u64_of(crc_shift(c, len_b, c.byte, crc_one(c))),
  }).sum

fn preset(width: Int, poly: U64, init: U64, reflect: Bool, xor_out: U64) -> Crc =
  crc_from_model({
    width: width,
    poly: poly,
    init: init,
    reflect_in: reflect,
    reflect_out: reflect,
    xor_out: xor_out,
  })

/// CRC-8/SMBUS.
pub const fn crc8_smbus() -> Crc = preset(8, 0x07u64, 0u64, false, 0u64)

/// CRC-16/ARC, the CRC-16 of LHA and ARC.
pub const fn crc16_arc() -> Crc = preset(16, 0x8005u64, 0u64, true, 0u64)

/// CRC-16/IBM-3740, often called CCITT-FALSE.
pub const fn crc16_ibm_3740() -> Crc = preset(16, 0x1021u64, 0xFFFFu64, false, 0u64)

/// CRC-16/IBM-SDLC, the frame check of HDLC, X.25 and PPP.
pub const fn crc16_ibm_sdlc() -> Crc = preset(16, 0x1021u64, 0xFFFFu64, true, 0xFFFFu64)

/// CRC-16/KERMIT, the CCITT CRC as Bluetooth and Kermit run it.
pub const fn crc16_kermit() -> Crc = preset(16, 0x1021u64, 0u64, true, 0u64)

/// CRC-16/MODBUS.
pub const fn crc16_modbus() -> Crc = preset(16, 0x8005u64, 0xFFFFu64, true, 0u64)

/// CRC-16/USB.
pub const fn crc16_usb() -> Crc = preset(16, 0x8005u64, 0xFFFFu64, true, 0xFFFFu64)

/// CRC-16/XMODEM.
pub const fn crc16_xmodem() -> Crc = preset(16, 0x1021u64, 0u64, false, 0u64)

/// CRC-32/BZIP2.
pub const fn crc32_bzip2() -> Crc =
  preset(32, 0x04C1_1DB7u64, 0xFFFF_FFFFu64, false, 0xFFFF_FFFFu64)

/// CRC-32/CKSUM, the POSIX `cksum` polynomial without the length it appends.
pub const fn crc32_cksum() -> Crc = preset(32, 0x04C1_1DB7u64, 0u64, false, 0xFFFF_FFFFu64)

/// CRC-32/ISCSI, which is CRC-32C: iSCSI, SCTP, ext4 and Btrfs.
pub const fn crc32_iscsi() -> Crc = preset(32, 0x1EDC_6F41u64, 0xFFFF_FFFFu64, true, 0xFFFF_FFFFu64)

/// CRC-32/ISO-HDLC, the CRC-32 of gzip, zip, PNG and Ethernet.
pub const fn crc32_iso_hdlc() -> Crc =
  preset(32, 0x04C1_1DB7u64, 0xFFFF_FFFFu64, true, 0xFFFF_FFFFu64)

/// CRC-32/MPEG-2.
pub const fn crc32_mpeg2() -> Crc = preset(32, 0x04C1_1DB7u64, 0xFFFF_FFFFu64, false, 0u64)

/// CRC-64/ECMA-182.
pub const fn crc64_ecma_182() -> Crc = preset(64, 0x42F0_E1EB_A9EA_3693u64, 0u64, false, 0u64)

/// CRC-64/GO-ISO, the ISO polynomial as Go's `hash/crc64` runs it.
pub const fn crc64_go_iso() -> Crc =
  preset(64, 0x1Bu64, 0xFFFF_FFFF_FFFF_FFFFu64, true, 0xFFFF_FFFF_FFFF_FFFFu64)

/// CRC-64/NVME.
pub const fn crc64_nvme() -> Crc =
  preset(64, 0xAD93_D235_94C9_3659u64, 0xFFFF_FFFF_FFFF_FFFFu64, true, 0xFFFF_FFFF_FFFF_FFFFu64)

/// CRC-64/XZ, the CRC-64 of xz.
pub const fn crc64_xz() -> Crc =
  preset(64, 0x42F0_E1EB_A9EA_3693u64, 0xFFFF_FFFF_FFFF_FFFFu64, true, 0xFFFF_FFFF_FFFF_FFFFu64)

/// The CRC-32 of gzip, zip and PNG: CRC-32/ISO-HDLC.
pub fn crc32(data: Bytes) -> U32 = u32_of(state_sum(update(init(Crc(crc32_iso_hdlc())), data)))

/// CRC-32C: CRC-32/ISCSI.
pub fn crc32c(data: Bytes) -> U32 = u32_of(state_sum(update(init(Crc(crc32_iscsi())), data)))

/// `crc_combine` for `crc32`: the CRC-32 of two inputs joined, from the CRC-32 of each and the
/// second's length in bytes.
pub fn crc32_combine(a: U32, b: U32, len_b: Int) -> U32 = {
  let wide = |x: U32| u64_of(Int::of_u32(x));
  u32_of(int_of(crc_combine(crc32_iso_hdlc(), wide(a), wide(b), len_b)))
}

fn adler_words(data: Bytes, i: Int, a: Int, b: Int) -> Int / {abort.raise} =
  if i + 8 > data.len() { adler_tail(data, i, a, b) } else {
    let x = Int::of_u32(data.u32_le(i));
    let y = Int::of_u32(data.u32_le(i + 4));
    let d0 = x & 0xFF;
    let d1 = x >>> 8 & 0xFF;
    let d2 = x >>> 16 & 0xFF;
    let d3 = x >>> 24;
    let d4 = y & 0xFF;
    let d5 = y >>> 8 & 0xFF;
    let d6 = y >>> 16 & 0xFF;
    let d7 = y >>> 24;
    adler_words(
      data,
      i + 8,
      (a + d0 + d1 + d2 + d3 + d4 + d5 + d6 + d7) % 65521,
      (b + 8 * (a + d0) + 7 * d1 + 6 * d2 + 5 * d3 + 4 * d4 + 3 * d5 + 2 * d6 + d7) % 65521,
    )
  }

fn adler_tail(data: Bytes, i: Int, a: Int, b: Int) -> Int / {abort.raise} =
  if i >= data.len() { b << 16 | a } else {
    let next = (a + data.at(i)) % 65521;
    adler_tail(data, i + 1, next, (b + next) % 65521)
  }

/// Adler-32, the checksum of zlib (RFC 1950).
pub fn adler32(data: Bytes) -> U32 = u32_of(state_sum(update(init(Adler32), data)))

/// The Adler-32 of two inputs joined, from the Adler-32 of each and the second's length in bytes.
pub fn adler32_combine(a: U32, b: U32, len_b: Int) -> U32 = {
  let first = Int::of_u32(a);
  let second = Int::of_u32(b);
  let low = ((first & 0xFFFF) + 65520) % 65521;
  let sum = (low + (second & 0xFFFF)) % 65521;
  let weighted = ((first >>> 16) + (second >>> 16) + max(len_b, 0) % 65521 * low) % 65521;
  u32_of(weighted << 16 | sum)
}

fn fnv32_bytes(data: Bytes, i: Int, h: Int) -> Int / {abort.raise} =
  if i >= data.len() { h }
  else { fnv32_bytes(data, i + 1, (h ^ data.at(i)) * 0x0100_0193 & 0xFFFF_FFFF) }

fn fnv64_bytes(data: Bytes, i: Int, h: Int) -> Int / {abort.raise} =
  if i >= data.len() { h }
  else { fnv64_bytes(data, i + 1, wrap_mul(h ^ data.at(i), 0x0000_0100_0000_01B3)) }

/// Returns the 32-bit FNV-1a hash of `data`.
pub fn fnv1a_32(data: Bytes) -> U32 = u32_of(state_sum(update(init(Fnv1a32), data)))

/// Returns the 64-bit FNV-1a hash of `data`.
pub fn fnv1a_64(data: Bytes) -> U64 = finish(update(init(Fnv1a64), data))

fn prime32_1() -> Int = 0x9E37_79B1

fn prime32_2() -> Int = 0x85EB_CA77

fn prime32_3() -> Int = 0xC2B2_AE3D

fn prime64_1() -> Int = 0x9E37_79B1_85EB_CA87

fn prime64_2() -> Int = 0xC2B2_AE3D_27D4_EB4F

fn prime64_3() -> Int = 0x1656_67B1_9E37_79F9

fn prime64_4() -> Int = 0x85EB_CA77_C2B2_AE63

fn prime64_5() -> Int = 0x27D4_EB2F_1656_67C5

/// Holds the state of an XXH64 hash between chunks: the seed, the four accumulators `v1` to `v4`,
/// the bytes of the current incomplete 32-byte block in `pending`, and the number of bytes consumed
/// in `total`.
pub type Xxh64Run = new {
  seed: Int,
  v1: Int,
  v2: Int,
  v3: Int,
  v4: Int,
  pending: Bytes,
  total: Int,
}

fn xxh64_round(accumulator: Int, input: Int) -> Int =
  wrap_mul(rotr(wrap_add(accumulator, wrap_mul(input, prime64_2())), 64 - 31), prime64_1())

fn xxh64_avalanche(h: Int) -> Int = {
  let a = wrap_mul(h ^ h >>> 33, prime64_2());
  let b = wrap_mul(a ^ a >>> 29, prime64_3());
  b ^ b >>> 32
}

fn xxh64_start(seed: Int) -> Xxh64Run =
  {
    seed: seed,
    v1: wrap_add(seed, wrap_add(prime64_1(), prime64_2())),
    v2: wrap_add(seed, prime64_2()),
    v3: seed,
    v4: wrap_sub(seed, prime64_1()),
    pending: b"",
    total: 0,
  }

fn xxh64_stripes(b: Bytes, i: Int, r: Xxh64Run) -> Xxh64Run / {abort.raise} =
  if i + 32 > b.len() { { ..r, pending: b.slice(i, b.len()) } } else {
    xxh64_stripes(b, i + 32, {
      ..r,
      v1: xxh64_round(r.v1, b.word_at(i)),
      v2: xxh64_round(r.v2, b.word_at(i + 8)),
      v3: xxh64_round(r.v3, b.word_at(i + 16)),
      v4: xxh64_round(r.v4, b.word_at(i + 24)),
    })
  }

fn xxh64_fed(r: Xxh64Run, chunk: Bytes) -> Xxh64Run / {abort.raise} =
  xxh64_stripes(joined(r.pending, chunk), 0, { ..r, total: r.total + chunk.len() })

fn xxh64_merged(h: Int, v: Int) -> Int =
  wrap_add(wrap_mul(h ^ xxh64_round(0, v), prime64_1()), prime64_4())

fn xxh64_rest(b: Bytes, i: Int, h: Int) -> Int / {abort.raise} =
  if i + 8 <= b.len() {
    xxh64_rest(
      b,
      i + 8,
      wrap_add(wrap_mul(rotr(h ^ xxh64_round(0, b.word_at(i)), 64 - 27), prime64_1()), prime64_4()),
    )
  } else if i + 4 <= b.len() {
    xxh64_rest(
      b,
      i + 4,
      wrap_add(
        wrap_mul(rotr(h ^ wrap_mul(Int::of_u32(b.u32_le(i)), prime64_1()), 64 - 23), prime64_2()),
        prime64_3(),
      ),
    )
  } else if i < b.len() {
    xxh64_rest(b, i + 1, wrap_mul(rotr(h ^ wrap_mul(b.at(i), prime64_5()), 64 - 11), prime64_1()))
  } else { xxh64_avalanche(h) }

fn xxh64_done(r: Xxh64Run) -> Int / {abort.raise} = {
  let lanes = if r.total < 32 { wrap_add(r.seed, prime64_5()) } else {
    [r.v1, r.v2, r.v3, r.v4].fold(
      wrap_add(
        wrap_add(rotr(r.v1, 64 - 1), rotr(r.v2, 64 - 7)),
        wrap_add(rotr(r.v3, 64 - 12), rotr(r.v4, 64 - 18)),
      ),
      xxh64_merged,
    )
  };
  xxh64_rest(r.pending, 0, wrap_add(lanes, r.total))
}

/// XXH64 of `data` under `seed`.
pub fn xxh64(data: Bytes, seed: U64) -> U64 = finish(update(init(Xxh64(seed)), data))

/// Holds the state of an XXH3 hash between chunks. While `total` is at most 240 bytes, the input is
/// only buffered in `pending`, because short inputs use a separate formula at the end. Beyond that,
/// `accumulator` has mixed in every 64-byte block except the bytes in `pending`, which is never empty.
/// `stripes` counts the blocks mixed in since `accumulator` was last scrambled. `tail` is the last block
/// mixed in, because the final step also needs the input's last 64 bytes, which can overlap
/// `pending`.
pub type Xxh3Run = new {
  seed: Int,
  secret: Bytes,
  accumulator: List<Int>,
  stripes: Int,
  tail: Bytes,
  pending: Bytes,
  total: Int,
}

fn xxh3_secret() -> Bytes =
  b"\xb8\xfe\x6c\x39\x23\xa4\x4b\xbe\x7c\x01\x81\x2c\xf7\x21\xad\x1c\xde\xd4\x6d\xe9\x83\x90\x97\xdb\x72\x40\xa4\xa4\xb7\xb3\x67\x1f\xcb\x79\xe6\x4e\xcc\xc0\xe5\x78\x82\x5a\xd0\x7d\xcc\xff\x72\x21\xb8\x08\x46\x74\xf7\x43\x24\x8e\xe0\x35\x90\xe6\x81\x3a\x26\x4c\x3c\x28\x52\xbb\x91\xc3\x00\xcb\x88\xd0\x65\x8b\x1b\x53\x2e\xa3\x71\x64\x48\x97\xa2\x0d\xf9\x4e\x38\x19\xef\x46\xa9\xde\xac\xd8\xa8\xfa\x76\x3f\xe3\x9c\x34\x3f\xf9\xdc\xbb\xc7\xc7\x0b\x4f\x1d\x8a\x51\xe0\x4b\xcd\xb4\x59\x31\xc8\x9f\x7e\xc9\xd9\x78\x73\x64\xea\xc5\xac\x83\x34\xd3\xeb\xc3\xc5\x81\xa0\xff\xfa\x13\x63\xeb\x17\x0d\xdd\x51\xb7\xf0\xda\x49\xd3\x16\x55\x26\x29\xd4\x68\x9e\x2b\x16\xbe\x58\x7d\x47\xa1\xfc\x8f\xf8\xb8\xd1\x7a\xd0\x31\xce\x45\xcb\x3a\x8f\x95\x16\x04\x28\xaf\xd7\xfb\xca\xbb\x4b\x40\x7e"

fn xxh3_seeded(seed: Int) -> Bytes =
  if seed == 0 { xxh3_secret() } else {
    handle {
      Bytes::concat_all(
        range(0, 24).map(|i: Int| {
          let word = xxh3_secret().word_at(8 * i);
          u64_le(if i % 2 == 0 { wrap_add(word, seed) } else { wrap_sub(word, seed) })
        }),
      )
    } with {
      abort.raise(_) -> xxh3_secret(),
    }
  }

fn xxh3_start(seed: Int) -> Xxh3Run =
  {
    seed: seed,
    secret: xxh3_seeded(seed),
    accumulator: [
      prime32_3(),
      prime64_1(),
      prime64_2(),
      prime64_3(),
      prime64_4(),
      prime32_2(),
      prime64_5(),
      prime32_1(),
    ],
    stripes: 0,
    tail: b"",
    pending: b"",
    total: 0,
  }

fn xxh3_folded(a: Int, b: Int) -> Int = {
  let al = a & 0xFFFF_FFFF;
  let ah = a >>> 32;
  let bl = b & 0xFFFF_FFFF;
  let bh = b >>> 32;
  let lh = wrap_mul(al, bh);
  let hl = wrap_mul(ah, bl);
  let cross = (wrap_mul(al, bl) >>> 32) + (lh & 0xFFFF_FFFF) + (hl & 0xFFFF_FFFF);
  let high = wrap_add(wrap_mul(ah, bh), (lh >>> 32) + (hl >>> 32) + (cross >>> 32));
  wrap_mul(a, b) ^ high
}

fn xxh3_avalanche(h: Int) -> Int = {
  let a = wrap_mul(h ^ h >>> 37, 0x1656_6791_9E37_79F9);
  a ^ a >>> 32
}

fn xxh3_mix16(b: Bytes, i: Int, secret: Bytes, s: Int, seed: Int) -> Int / {abort.raise} =
  xxh3_folded(
    b.word_at(i) ^ wrap_add(secret.word_at(s), seed),
    b.word_at(i + 8) ^ wrap_sub(secret.word_at(s + 8), seed),
  )

fn swapped32(x: Int) -> Int =
  (x & 0xFF) << 24 | (x >>> 8 & 0xFF) << 16 | (x >>> 16 & 0xFF) << 8 | x >>> 24 & 0xFF

fn swapped64(x: Int) -> Int = swapped32(x & 0xFFFF_FFFF) << 32 | swapped32(x >>> 32)

fn xxh3_short(b: Bytes, seed: Int) -> Int / {abort.raise} = {
  let n = b.len();
  let s = xxh3_secret();
  if n == 0 { xxh64_avalanche(seed ^ s.word_at(56) ^ s.word_at(64)) } else if n <= 3 {
    let packed = b.at(0) << 16 | b.at(n / 2) << 24 | b.at(n - 1) | n << 8;
    let key = Int::of_u32(s.u32_le(0)) ^ Int::of_u32(s.u32_le(4));
    xxh64_avalanche(packed ^ wrap_add(key, seed))
  } else if n <= 8 {
    let mixed = seed ^ swapped32(seed & 0xFFFF_FFFF) << 32;
    let keyed = (Int::of_u32(b.u32_le(n - 4)) | Int::of_u32(b.u32_le(0)) << 32)
      ^ wrap_sub(s.word_at(8) ^ s.word_at(16), mixed);
    let a = wrap_mul(keyed ^ rotr(keyed, 64 - 49) ^ rotr(keyed, 64 - 24), 0x9FB2_1C65_1E98_DF25);
    let c = wrap_mul(a ^ (a >>> 35) + n, 0x9FB2_1C65_1E98_DF25);
    c ^ c >>> 28
  } else if n <= 16 {
    let low = b.word_at(0) ^ wrap_add(s.word_at(24) ^ s.word_at(32), seed);
    let high = b.word_at(n - 8) ^ wrap_sub(s.word_at(40) ^ s.word_at(48), seed);
    xxh3_avalanche(wrap_add(wrap_add(n, swapped64(low)), wrap_add(high, xxh3_folded(low, high))))
  } else if n <= 128 {
    xxh3_avalanche(
      range(0, (n - 1) / 32 + 1).fold(wrap_mul(n, prime64_1()), |accumulator: Int, k: Int|
        wrap_add(
          accumulator,
          wrap_add(
            xxh3_mix16(b, 16 * k, s, 32 * k, seed),
            xxh3_mix16(b, n - 16 * (k + 1), s, 32 * k + 16, seed),
          ),
        )),
    )
  } else {
    let first = range(0, 8).fold(wrap_mul(n, prime64_1()), |accumulator: Int, i: Int|
      wrap_add(accumulator, xxh3_mix16(b, 16 * i, s, 16 * i, seed)));
    let rest = range(8, n / 16).fold(xxh3_avalanche(first), |accumulator: Int, i: Int|
      wrap_add(accumulator, xxh3_mix16(b, 16 * i, s, 16 * (i - 8) + 3, seed)));
    xxh3_avalanche(wrap_add(rest, xxh3_mix16(b, n - 16, s, 119, seed)))
  }
}

fn xxh3_stripe(
  accumulator: List<Int>,
  b: Bytes,
  at: Int,
  secret: Bytes,
  s: Int,
) -> List<Int> / {abort.raise} =
  range(0, 8).map(|i: Int| {
    let key = b.word_at(at + 8 * i) ^ secret.word_at(s + 8 * i);
    wrap_add(
      wrap_add(accumulator.at_or(i, 0), b.word_at(at + 8 * (i ^ 1))),
      wrap_mul(key & 0xFFFF_FFFF, key >>> 32),
    )
  })

fn xxh3_scrambled(accumulator: List<Int>, secret: Bytes) -> List<Int> / {abort.raise} =
  range(0, 8).map(|i: Int| {
    let lane = accumulator.at_or(i, 0);
    wrap_mul(lane ^ lane >>> 47 ^ secret.word_at(128 + 8 * i), prime32_1())
  })

fn xxh3_stripes(b: Bytes, i: Int, r: Xxh3Run) -> Xxh3Run / {abort.raise} =
  if i + 64 >= b.len() {
    { ..r, tail: if i == 0 { r.tail } else { b.slice(i - 64, i) }, pending: b.slice(i, b.len()) }
  } else {
    let accumulator = xxh3_stripe(r.accumulator, b, i, r.secret, 8 * r.stripes);
    xxh3_stripes(b, i + 64, if r.stripes == 15 {
      { ..r, accumulator: xxh3_scrambled(accumulator, r.secret), stripes: 0 }
    } else { { ..r, accumulator: accumulator, stripes: r.stripes + 1 } })
  }

fn xxh3_fed(r: Xxh3Run, chunk: Bytes) -> Xxh3Run / {abort.raise} = {
  let total = r.total + chunk.len();
  let buffered = joined(r.pending, chunk);
  if total <= 240 { { ..r, pending: buffered, total: total } }
  else { xxh3_stripes(buffered, 0, { ..r, total: total }) }
}

fn xxh3_done(r: Xxh3Run) -> Int / {abort.raise} =
  if r.total <= 240 { xxh3_short(r.pending, r.seed) } else {
    let end = r.tail.concat(r.pending);
    let accumulator = xxh3_stripe(r.accumulator, end, end.len() - 64, r.secret, 121);
    xxh3_avalanche(
      range(0, 4).fold(wrap_mul(r.total, prime64_1()), |sum: Int, i: Int|
        wrap_add(
          sum,
          xxh3_folded(
            accumulator.at_or(2 * i, 0) ^ r.secret.word_at(11 + 16 * i),
            accumulator.at_or(2 * i + 1, 0) ^ r.secret.word_at(19 + 16 * i),
          ),
        )),
    )
  }

/// XXH3, 64 bits, of `data` under `seed`; a seed of zero is the unseeded hash.
pub fn xxh3_64(data: Bytes, seed: U64) -> U64 = finish(update(init(Xxh3(seed)), data))

/// A SipHash key: its sixteen bytes as two words, each least significant byte first.
pub type SipKey = | SipKey(Int, Int)

show for SipKey by sip_key_shown

fn sip_key_shown(_: SipKey) -> String = "SipKey(****)"

/// The key made of sixteen bytes, or `None` for any other length.
pub fn sip_key(bytes: Bytes) -> Option<SipKey> =
  if bytes.len() != 16 { None } else {
    handle { Some(SipKey(bytes.word_at(0), bytes.word_at(8))) } with { abort.raise(_) -> None }
  }

/// Returns a random key built from three draws of the host's entropy. Hashes under this key differ
/// from run to run, so the key suits a hash table, but a program's output order must not depend on
/// the hash.
pub fn random_sip_key() -> SipKey / {entropy.next bounded} = {
  let spare = entropy.next();
  SipKey(entropy.next() | (spare & 1) << 63, entropy.next() | (spare >>> 1 & 1) << 63)
}

/// The four words SipHash mixes.
pub type Sip = new { v0: Int, v1: Int, v2: Int, v3: Int }

/// SipHash state between chunks: the rounds per word and at the end, the four words, the bytes
/// left over from an incomplete word, and the number of bytes consumed.
pub type SipRun = new { each: Int, last: Int, v: Sip, pending: Bytes, total: Int }

fn sip_round(s: Sip) -> Sip = {
  let a = wrap_add(s.v0, s.v1);
  let b = rotr(s.v1, 64 - 13) ^ a;
  let c = wrap_add(s.v2, s.v3);
  let d = rotr(s.v3, 64 - 16) ^ c;
  let e = wrap_add(rotr(a, 64 - 32), d);
  let f = wrap_add(c, b);
  { v0: e, v1: rotr(b, 64 - 17) ^ f, v2: rotr(f, 64 - 32), v3: rotr(d, 64 - 21) ^ e }
}

fn sip_rounds(s: Sip, n: Int) -> Sip = if n <= 0 { s } else { sip_rounds(sip_round(s), n - 1) }

fn sip_word(s: Sip, word: Int, rounds: Int) -> Sip = {
  let mixed = sip_rounds({ ..s, v3: s.v3 ^ word }, rounds);
  { ..mixed, v0: mixed.v0 ^ word }
}

fn sip_start(key: SipKey, each: Int, last: Int) -> SipRun =
  match key {
    SipKey(k0, k1) ->
      {
        each: each,
        last: last,
        v: {
          v0: k0 ^ 0x736F_6D65_7073_6575,
          v1: k1 ^ 0x646F_7261_6E64_6F6D,
          v2: k0 ^ 0x6C79_6765_6E65_7261,
          v3: k1 ^ 0x7465_6462_7974_6573,
        },
        pending: b"",
        total: 0,
      },
  }

fn sip_words(b: Bytes, i: Int, r: SipRun) -> SipRun / {abort.raise} =
  if i + 8 > b.len() { { ..r, pending: b.slice(i, b.len()) } }
  else { sip_words(b, i + 8, { ..r, v: sip_word(r.v, b.word_at(i), r.each) }) }

fn sip_fed(r: SipRun, chunk: Bytes) -> SipRun / {abort.raise} =
  sip_words(joined(r.pending, chunk), 0, { ..r, total: r.total + chunk.len() })

fn sip_done(r: SipRun) -> Int = {
  let end = range(0, r.pending.len()).fold((r.total & 0xFF) << 56, |accumulator: Int, i: Int|
    accumulator | r.pending.at(i) << 8 * i);
  let mixed = sip_word(r.v, end, r.each);
  let s = sip_rounds({ ..mixed, v2: mixed.v2 ^ 0xFF }, r.last);
  s.v0 ^ s.v1 ^ s.v2 ^ s.v3
}

/// Returns the SipHash-1-3 hash of `data` under `key`. It is faster than SipHash-2-4 and is the
/// right choice for a hash table.
pub fn siphash13(key: SipKey, data: Bytes) -> U64 = finish(update(init(SipHash13(key)), data))

/// SipHash-2-4 of `data` under `key`: the one the SipHash paper recommends.
pub fn siphash24(key: SipKey, data: Bytes) -> U64 = finish(update(init(SipHash24(key)), data))

/// Selects the checksum to compute. `Crc` carries the CRC definition, `Xxh64` and `Xxh3` carry a
/// seed, and the SipHash variants carry a key.
pub type Algorithm =
  | Crc(Crc)
  | Adler32
  | Fnv1a32
  | Fnv1a64
  | Xxh64(U64)
  | Xxh3(U64)
  | SipHash13(SipKey)
  | SipHash24(SipKey)

/// A sum partway through its input.
pub type State =
  | CrcState(Crc, Int)
  | AdlerState(Int)
  | Fnv32State(Int)
  | Fnv64State(Int)
  | Xxh64State(Xxh64Run)
  | Xxh3State(Xxh3Run)
  | SipState(SipRun)

/// The state before any input.
pub fn init(a: Algorithm) -> State =
  match a {
    Crc(c) -> CrcState(c, c.start),
    Adler32 -> AdlerState(1),
    Fnv1a32 -> Fnv32State(0x811C_9DC5),
    Fnv1a64 -> Fnv64State(0xCBF2_9CE4_8422_2325),
    Xxh64(seed) -> Xxh64State(xxh64_start(int_of(seed))),
    Xxh3(seed) -> Xxh3State(xxh3_start(int_of(seed))),
    SipHash13(key) -> SipState(sip_start(key, 1, 3)),
    SipHash24(key) -> SipState(sip_start(key, 2, 4)),
  }

/// The state after also consuming `chunk`. However an input is split into chunks, the state after
/// the last one finishes with the same sum as the whole input.
pub fn update(s: State, chunk: Bytes) -> State =
  handle { advanced(s, chunk) } with { abort.raise(_) -> s }

fn advanced(s: State, chunk: Bytes) -> State / {abort.raise} =
  match s {
    CrcState(c, reg) -> CrcState(c, crc_words(c.table, c.model.reflect_in, reg, chunk, 0)),
    AdlerState(sum) -> AdlerState(adler_words(chunk, 0, sum & 0xFFFF, sum >>> 16)),
    Fnv32State(h) -> Fnv32State(fnv32_bytes(chunk, 0, h)),
    Fnv64State(h) -> Fnv64State(fnv64_bytes(chunk, 0, h)),
    Xxh64State(r) -> Xxh64State(xxh64_fed(r, chunk)),
    Xxh3State(r) -> Xxh3State(xxh3_fed(r, chunk)),
    SipState(r) -> SipState(sip_fed(r, chunk)),
  }

/// Returns the sum of all input the state has consumed. A sum narrower than 64 bits, such as a
/// CRC-16, occupies the low bits of the result. The state stays usable and may consume more input
/// afterward.
pub fn finish(s: State) -> U64 = u64_of(state_sum(s))

fn state_sum(s: State) -> Int =
  handle {
    match s {
      CrcState(c, reg) -> crc_out(c, reg),
      AdlerState(sum) -> sum,
      Fnv32State(h) -> h,
      Fnv64State(h) -> h,
      Xxh64State(r) -> xxh64_done(r),
      Xxh3State(r) -> xxh3_done(r),
      SipState(r) -> sip_done(r),
    }
  } with {
    abort.raise(_) -> 0,
  }

type Check = { name: String, crc: Crc, check: U64 }

fn catalogue() -> List<Check> =
  [
    { name: "CRC-8/SMBUS", crc: crc8_smbus(), check: 0xF4u64 },
    { name: "CRC-16/ARC", crc: crc16_arc(), check: 0xBB3Du64 },
    { name: "CRC-16/IBM-3740", crc: crc16_ibm_3740(), check: 0x29B1u64 },
    { name: "CRC-16/IBM-SDLC", crc: crc16_ibm_sdlc(), check: 0x906Eu64 },
    { name: "CRC-16/KERMIT", crc: crc16_kermit(), check: 0x2189u64 },
    { name: "CRC-16/MODBUS", crc: crc16_modbus(), check: 0x4B37u64 },
    { name: "CRC-16/USB", crc: crc16_usb(), check: 0xB4C8u64 },
    { name: "CRC-16/XMODEM", crc: crc16_xmodem(), check: 0x31C3u64 },
    { name: "CRC-32/BZIP2", crc: crc32_bzip2(), check: 0xFC89_1918u64 },
    { name: "CRC-32/CKSUM", crc: crc32_cksum(), check: 0x765E_7680u64 },
    { name: "CRC-32/ISCSI", crc: crc32_iscsi(), check: 0xE306_9283u64 },
    { name: "CRC-32/ISO-HDLC", crc: crc32_iso_hdlc(), check: 0xCBF4_3926u64 },
    { name: "CRC-32/MPEG-2", crc: crc32_mpeg2(), check: 0x0376_E6E7u64 },
    { name: "CRC-64/ECMA-182", crc: crc64_ecma_182(), check: 0x6C40_DF5F_0B49_7347u64 },
    { name: "CRC-64/GO-ISO", crc: crc64_go_iso(), check: 0xB909_56C7_75A4_1001u64 },
    { name: "CRC-64/NVME", crc: crc64_nvme(), check: 0xAE8B_1486_0A79_9888u64 },
    { name: "CRC-64/XZ", crc: crc64_xz(), check: 0x995D_C9BB_DF19_39FAu64 },
  ]

test "{c.name} of 123456789 is the catalogue's check value" for c: Check in catalogue() {
  assert_eq(crc(c.crc, b"123456789"), c.check)
}

fn check_of(model: Model) -> Option<U64> =
  match crc_of(model) { Some(c) -> Some(crc(c, b"123456789")), None -> None }

fn crc12_umts() -> Model =
  { width: 12, poly: 0x80Fu64, init: 0u64, reflect_in: false, reflect_out: true, xor_out: 0u64 }

test "CRC models with an odd width, or that reflect only the input or only the output, produce the catalogue's check values" {
  assert_eq(check_of(crc12_umts()), Some(0xDAFu64));
  assert_eq(
    check_of({
      width: 5,
      poly: 0x05u64,
      init: 0x1Fu64,
      reflect_in: true,
      reflect_out: true,
      xor_out: 0x1Fu64,
    }),
    Some(0x19u64),
  );
  assert_eq(
    check_of({
      width: 7,
      poly: 0x09u64,
      init: 0u64,
      reflect_in: false,
      reflect_out: false,
      xor_out: 0u64,
    }),
    Some(0x75u64),
  )
}

fn plain(width: Int, poly: U64) -> Model =
  { width: width, poly: poly, init: 0u64, reflect_in: true, reflect_out: true, xor_out: 0u64 }

test "a model with an invalid width, or a parameter wider than the width, makes no CRC" {
  assert_eq(crc_of(plain(0, 1u64)), None);
  assert_eq(crc_of(plain(65, 1u64)), None);
  assert_eq(crc_of(plain(8, 0x100u64)), None);
  assert(crc_of(plain(1, 1u64)) != None);
  assert(crc_of(plain(64, 0xFFFF_FFFF_FFFF_FFFFu64)) != None)
}

fn counted(n: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(range(0, 256).map(byte_of_int)).repeat(n / 256 + 1).slice(0, n)

test "CRC-32 and CRC-32C of a whole input, and RFC 3720's four vectors" {
  assert_eq(crc32(b""), 0u32);
  assert_eq(crc32(b"123456789"), 0xCBF4_3926u32);
  assert_eq(crc32(b"The quick brown fox jumps over the lazy dog"), 0x414F_A339u32);
  assert_eq(crc32c(b"123456789"), 0xE306_9283u32);
  assert_eq(crc32c(b"\x00".repeat(32)), 0x8A91_36AAu32);
  assert_eq(crc32c(b"\xff".repeat(32)), 0x62A8_AB43u32);
  assert_eq(crc32c(counted(32)), 0x46DD_794Eu32);
  assert_eq(
    crc32c(Bytes::concat_all(range(0, 32).map(|i: Int| byte_of_int(31 - i)))),
    0x113F_DB5Cu32,
  )
}

test "Adler-32 as zlib computes it, past where a 32-bit sum would have overflowed" {
  assert_eq(adler32(b""), 1u32);
  assert_eq(adler32(b"a"), 0x0062_0062u32);
  assert_eq(adler32(b"abc"), 0x024D_0127u32);
  assert_eq(adler32(b"Wikipedia"), 0x11E6_0398u32);
  assert_eq(adler32(b"123456789"), 0x091E_01DEu32);
  assert_eq(adler32(b"\xff".repeat(6000)), 0xA497_59EAu32);
  assert_eq(adler32(counted(10240)), 0xF475_ED1Eu32)
}

test "`fnv1a_32` and `fnv1a_64` return the test values published by the FNV authors" {
  assert_eq(fnv1a_32(b""), 0x811C_9DC5u32);
  assert_eq(fnv1a_32(b"a"), 0xE40C_292Cu32);
  assert_eq(fnv1a_32(b"b"), 0xE70C_2DE5u32);
  assert_eq(fnv1a_32(b"foobar"), 0xBF9C_F968u32);
  assert_eq(fnv1a_32(b"chongo was here!\n"), 0xD499_30D5u32);
  assert_eq(fnv1a_64(b""), 0xCBF2_9CE4_8422_2325u64);
  assert_eq(fnv1a_64(b"a"), 0xAF63_DC4C_8601_EC8Cu64);
  assert_eq(fnv1a_64(b"b"), 0xAF63_DF4C_8601_F1A5u64);
  assert_eq(fnv1a_64(b"foobar"), 0x8594_4171_F739_67E8u64);
  assert_eq(fnv1a_64(b"chongo was here!\n"), 0x4681_0940_EFF5_F915u64)
}

fn sanity(n: Int) -> Bytes =
  Bytes::concat_all(
    range(0, n).fold(
      { out: [], gen: 2654435761 },
      |s: { out: List<Bytes>, gen: Int }, _: Int|
        { out: s.out.push(byte_of_int(s.gen >>> 56)), gen: wrap_mul(s.gen, 0x9E37_79B1_85EB_CA8D) },
    ).out,
  )

type Sanity = { size: Int, seed: U64, sum: U64 }

fn xxh64_sanity() -> List<Sanity> =
  [
    { size: 0, seed: 0u64, sum: 0xEF46_DB37_51D8_E999u64 },
    { size: 0, seed: 2654435761u64, sum: 0xAC75_FDA2_929B_17EFu64 },
    { size: 1, seed: 0u64, sum: 0xE934_A84A_DB05_2768u64 },
    { size: 1, seed: 2654435761u64, sum: 0x5014_6076_43A9_B4C3u64 },
    { size: 4, seed: 0u64, sum: 0x9136_A0DC_A574_57EEu64 },
