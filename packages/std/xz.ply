//! xz: reading `.xz` files.
//!
//! `decompress` reads what `xz` and liblzma write: a file of one stream or several, with the zero
//! padding the format allows between and after them; LZMA2 blocks in every chunk type and under
//! any properties; each block's CRC-32, CRC-64 or SHA-256 checked, along with the sizes its header
//! declares; and the index and footer checked against the blocks that were read.
//! `decompress_first` reads one stream and reports where it ended. The decoder is written in Ply;
//! no part of it comes from a C library.
//!
//! Every reader takes `Limits`, and none works without them. `output` is the most bytes it
//! returns. `window` is the most bytes of history a block may ask the reader to keep, which is the
//! block's LZMA2 dictionary. A file of a few bytes can request gigabytes, so a block that requests
//! more than `window` is rejected at its header, before any chunk is read. An error reports the
//! reason and the offset of the input byte. `decompress` raises it as `xz.fail`, and
//! `try_decompress` returns it.
//!
//! A block whose filters are not LZMA2 alone is rejected with the filter's number: the delta
//! filter and the branch converters for machine code are not supported. Neither is the older
//! `.lzma` format, which has no magic number and no check.
//!
//! `decompress_stream` is `decompress` over a `std.seq` sequence of chunks, such as `std.io`'s
//! `chunks` gives for a file. It reads a file of any length using the memory of its dictionary and
//! a chunk, and gives the same bytes however the input is split. There is no writer.

import std.bytes (u32_le)
import std.checksum
import std.checksum (crc32, crc64_xz)
import std.hash
import std.seq
import std.seq (seq, Seq, Done, Skip, Yield)
import std.gen

// --- Errors -----------------------------------------------------------------

/// Why a reader failed.
pub type ErrorKind =
  /// The bytes do not open with a stream's magic number.
  | NotThisFormat
  /// The stream contains, or a block declares, more bytes than `Limits.output`.
  | OverLimit
  /// A block asks its reader to keep more bytes of history than `Limits.window`, or 2 GiB.
  | Window
  /// The input ends before the stream does.
  | Truncated
  /// A stream or block header that sets a reserved bit, encodes a number in more bytes than it
  /// needs, gives LZMA2 no dictionary size, or is padded with anything other than zeros.
  | Header
  /// A stream header, block header, index or stream footer whose CRC-32 does not match its bytes.
  | HeaderChecksum
  /// A block whose filters are not LZMA2 alone: the number of the first that is not. 3 is the
  /// delta filter, and 4 to 11 the branch converters for x86, PowerPC, IA-64, ARM, ARM Thumb,
  /// SPARC, ARM64 and RISC-V.
  | Filter(Int)
  /// A stream whose blocks use a check type this reader does not support, with the type's number.
  /// The supported types are 0, none; 1, CRC-32; 4, CRC-64; and 10, SHA-256.
  | CheckType(Int)
  /// An LZMA2 chunk of a kind the format does not define, one that continues from a dictionary or
  /// properties that no earlier chunk set, or one with properties LZMA does not define.
  | Chunk
  /// A chunk whose coded bits do not start with a zero byte, do not end where the chunk states, or
  /// contain a match longer than what the chunk has left to write.
  | Code
  /// A match that reaches back before the dictionary's first byte.
  | Distance
  /// A block whose packed or unpacked size differs from what its header declares.
  | Size
  /// A block whose check does not match its bytes.
  | Checksum
  /// An index that does not list the blocks the stream contained, or a footer that does not match
  /// the index or the header.
  | Index
  /// Bytes after a stream that are neither zero padding in groups of four nor another stream.
  | Trailing

/// An error, and the offset of the input byte the reader was at.
pub type Error = new { at: Int, reason: ErrorKind }

/// The error a reader in this module raises.
pub effect xz {
  /// The input is not made of complete, valid streams, or needs more than the limits allow.
  raise fail(e: Error)
}

fn fail<a>(at: Int, why: ErrorKind) -> a / {xz.fail} = xz.fail({ at: at, reason: why })

/// The resources a reader may use: the most bytes it returns, and the most bytes of history a
/// block may ask it to keep, which is the block's LZMA2 dictionary.
pub type Limits = new { output: Int, window: Int }

/// Each byte value as the one byte it is.
const fn single_bytes() -> Array<Bytes> = Array::of_list(range(0, 256).map(byte_of_int))

// --- LZMA -------------------------------------------------------------------

// All probabilities are in one array. From 0: whether a match follows, by state and position.
// From 192: whether a match repeats a distance. From 204, 216 and 228: whether it repeats the
// last distance, the one before, or the third. From 240: whether a repeat of the last distance is
// longer than one byte. From 432: distance slots by length. From 688 and 802: the low bits of near
// and of far distances. From 818 for a match and 1332 for a repeat: lengths, each with two
// choices, and within each, sixteen short three-bit codes from 2, sixteen codes for the next eight
// lengths from 130, and one eight-bit code from 258. From 1846: the literals, 768 per context.

// A chunk's constants are packed in one `Int`: the position mask in its low four bits, the literal
// position mask in the next four, the literal context bits in the next four, the low four bits of
// the dictionary's start in the next four, and above them the output length at the end of the
// chunk. Values a symbol rarely reads are in an array: at 0 the dictionary's start in the output,
// at 1 its size, and at 2 the stream offset of the chunk's coded bytes.

/// The decoder state after a chunk: the bytes written, the probabilities, the state, the last four
/// distances (the third and fourth packed in one `Int`, 31 bits each), and where its bits ended.
type LzmaState = {
  out: Bytes,
  probs: Array<Int>,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  ip: Int,
  code: Int,
}

/// The state after a literal.
fn after_literal(state: Int) -> Int =
  if state < 4 { 0 } else if state < 10 { state - 3 } else { state - 6 }

/// Decodes one symbol. A bit decides whether it is a literal, which is read here, or a match.
fn decode_symbol(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let n = out.len();
    let low = range < 16777216;
    let r = if low { range << 8 } else { range };
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    if ip > lim.get(3) { fail(lim.get(2) + lim.get(3), Code) } else if n >= k >>> 16 {
      { out: out, probs: probs, state: state, rep0: rep0, rep1: rep1, r23: r23, ip: p, code: c }
    } else {
      let pos = n - (k >>> 12 & 15);
      let at = (state << 4) + (pos & k & 15);
      let prob = probs.get(at);
      let bound = (r >>> 11) * prob;
      if c >= bound {
        choice(
          src,
          p,
          r - bound,
          c - bound,
          probs.set(at, prob - (prob >>> 5)),
          out,
          state,
          rep0,
          rep1,
          r23,
          k,
          lim,
          fuel - 1,
        )
      } else {
        let before = if n > lim.get(0) { out.at(n - 1) } else { 0 };
        let lc = k >>> 8 & 15;
        let base = 1846 + ((before >>> 8 - lc) + ((pos & k >>> 4 & 15) << lc)) * 768;
        let next = probs.set(at, prob + (2048 - prob >>> 5));
        if state < 7 {
          literal(src, p, bound, c, next, out, state, rep0, rep1, r23, k, lim, fuel - 1, base, 1)
        } else {
          matched(
            src,
            p,
            bound,
            c,
            next,
            out,
            state,
            rep0,
            rep1,
            r23,
            k,
            lim,
            fuel - 1,
            base,
            1,
            out.at(n - rep0 - 1) << 1,
          )
        }
      }
    }
  }

/// Reads a literal's bits from the most significant, each in the context of the bits before it.
fn literal(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
  base: Int,
  symbol: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let low = range < 16777216;
    let r = if low { range << 8 } else { range };
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    let prob = probs.get(base + symbol);
    let bound = (r >>> 11) * prob;
    if c < bound {
      let next = probs.set(base + symbol, prob + (2048 - prob >>> 5));
      if symbol < 128 {
        literal(
          src,
          p,
          bound,
          c,
          next,
          out,
          state,
          rep0,
          rep1,
          r23,
          k,
          lim,
          fuel - 1,
          base,
          symbol * 2,
        )
      } else {
        decode_symbol(
          src,
          p,
          bound,
          c,
          next,
          out ++ single_bytes().get(symbol * 2 - 256),
          after_literal(state),
          rep0,
          rep1,
          r23,
          k,
          lim,
          fuel - 1,
        )
      }
    } else {
      let next = probs.set(base + symbol, prob - (prob >>> 5));
      if symbol < 128 {
        literal(
          src,
          p,
          r - bound,
          c - bound,
          next,
          out,
          state,
          rep0,
          rep1,
          r23,
          k,
          lim,
          fuel - 1,
          base,
          symbol * 2 + 1,
        )
      } else {
        decode_symbol(
          src,
          p,
          r - bound,
          c - bound,
          next,
          out ++ single_bytes().get(symbol * 2 - 255),
          after_literal(state),
          rep0,
          rep1,
          r23,
          k,
          lim,
          fuel - 1,
        )
      }
    }
  }

/// Reads a literal after a match, against the byte the match would have copied next. Each bit is
/// also read in the context of that byte's bit, for as long as the two agree. `against` is that
/// byte, with its next bit at bit 8.
fn matched(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
  base: Int,
  symbol: Int,
  against: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let low = range < 16777216;
    let r = if low { range << 8 } else { range };
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    let theirs = against & 256;
    let at = base + 256 + theirs + symbol;
    let prob = probs.get(at);
    let bound = (r >>> 11) * prob;
    if c < bound {
      let next = probs.set(at, prob + (2048 - prob >>> 5));
      if symbol >= 128 {
        decode_symbol(
          src,
          p,
          bound,
          c,
          next,
          out ++ single_bytes().get(symbol * 2 - 256),
          after_literal(state),
          rep0,
          rep1,
          r23,
          k,
          lim,
          fuel - 1,
        )
      } else if theirs == 0 {
        matched(
          src,
          p,
          bound,
          c,
          next,
          out,
          state,
          rep0,
          rep1,
          r23,
          k,
          lim,
          fuel - 1,
          base,
          symbol * 2,
          against << 1,
        )
      } else {
        literal(
          src,
          p,
          bound,
          c,
          next,
          out,
          state,
          rep0,
          rep1,
          r23,
          k,
          lim,
          fuel - 1,
          base,
          symbol * 2,
        )
      }
    } else {
      let next = probs.set(at, prob - (prob >>> 5));
      if symbol >= 128 {
        decode_symbol(
          src,
          p,
          r - bound,
          c - bound,
          next,
          out ++ single_bytes().get(symbol * 2 - 255),
          after_literal(state),
          rep0,
          rep1,
          r23,
          k,
          lim,
          fuel - 1,
        )
      } else if theirs != 0 {
        matched(
          src,
          p,
          r - bound,
          c - bound,
          next,
          out,
          state,
          rep0,
          rep1,
          r23,
          k,
          lim,
          fuel - 1,
          base,
          symbol * 2 + 1,
          against << 1,
        )
      } else {
        literal(
          src,
          p,
          r - bound,
          c - bound,
          next,
          out,
          state,
          rep0,
          rep1,
          r23,
          k,
          lim,
          fuel - 1,
          base,
          symbol * 2 + 1,
        )
      }
    }
  }

/// After a bit that chose a match, a bit decides whether its distance is new or one of the last
/// four. A new distance moves the last three down and leaves the first to be read, marked by a
/// value below zero.
fn choice(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let low = range < 16777216;
    let r = if low { range << 8 } else { range };
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    let prob = probs.get(192 + state);
    let bound = (r >>> 11) * prob;
    if c < bound {
      length(
        src,
        p,
        bound,
        c,
        probs.set(192 + state, prob + (2048 - prob >>> 5)),
        out,
        if state < 7 { 7 } else { 10 },
        -1,
        rep0,
        rep1 | (r23 & 0x7FFF_FFFF) << 31,
        k,
        lim,
        fuel - 1,
        818,
      )
    } else {
      repeat_first(
        src,
        p,
        r - bound,
        c - bound,
        probs.set(192 + state, prob - (prob >>> 5)),
        out,
        state,
        rep0,
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
      )
    }
  }

/// A repeat: a bit decides whether it repeats the last distance.
fn repeat_first(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let low = range < 16777216;
    let r = if low { range << 8 } else { range };
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    let prob = probs.get(204 + state);
    let bound = (r >>> 11) * prob;
    if c < bound {
      repeat_short(
        src,
        p,
        bound,
        c,
        probs.set(204 + state, prob + (2048 - prob >>> 5)),
        out,
        state,
        rep0,
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
      )
    } else {
      repeat_second(
        src,
        p,
        r - bound,
        c - bound,
        probs.set(204 + state, prob - (prob >>> 5)),
        out,
        state,
        rep0,
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
      )
    }
  }

/// A repeat of the last distance: a bit decides whether it is one byte or has a length.
fn repeat_short(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let low = range < 16777216;
    let r = if low { range << 8 } else { range };
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    let at = 240 + (state << 4) + (out.len() - (k >>> 12 & 15) & k & 15);
    let prob = probs.get(at);
    let bound = (r >>> 11) * prob;
    if c < bound {
      copy(
        src,
        p,
        bound,
        c,
        probs.set(at, prob + (2048 - prob >>> 5)),
        out,
        (if state < 7 { 9 } else { 11 }) | 1 << 4,
        rep0,
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
      )
    } else {
      length(
        src,
        p,
        r - bound,
        c - bound,
        probs.set(at, prob - (prob >>> 5)),
        out,
        if state < 7 { 8 } else { 11 },
        rep0,
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
        1332,
      )
    }
  }

/// A repeat of an older distance: a bit decides whether it is the one before the last, which then
/// swaps places with the last.
fn repeat_second(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let low = range < 16777216;
    let r = if low { range << 8 } else { range };
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    let prob = probs.get(216 + state);
    let bound = (r >>> 11) * prob;
    if c < bound {
      length(
        src,
        p,
        bound,
        c,
        probs.set(216 + state, prob + (2048 - prob >>> 5)),
        out,
        if state < 7 { 8 } else { 11 },
        rep1,
        rep0,
        r23,
        k,
        lim,
        fuel - 1,
        1332,
      )
    } else {
      repeat_third(
        src,
        p,
        r - bound,
        c - bound,
        probs.set(216 + state, prob - (prob >>> 5)),
        out,
        state,
        rep0,
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
      )
    }
  }

/// A repeat of the third or fourth distance, which comes to the front as the others move down.
fn repeat_third(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let low = range < 16777216;
    let r = if low { range << 8 } else { range };
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    let prob = probs.get(228 + state);
    let bound = (r >>> 11) * prob;
    if c < bound {
      length(
        src,
        p,
        bound,
        c,
        probs.set(228 + state, prob + (2048 - prob >>> 5)),
        out,
        if state < 7 { 8 } else { 11 },
        r23 & 0x7FFF_FFFF,
        rep0,
        rep1 | r23 >>> 31 << 31,
        k,
        lim,
        fuel - 1,
        1332,
      )
    } else {
      length(
        src,
        p,
        r - bound,
        c - bound,
        probs.set(228 + state, prob - (prob >>> 5)),
        out,
        if state < 7 { 8 } else { 11 },
        r23 >>> 31,
        rep0,
        rep1 | (r23 & 0x7FFF_FFFF) << 31,
        k,
        lim,
        fuel - 1,
        1332,
      )
    }
  }

/// A length's first choice, using the probabilities from `from`: a short three-bit code, or a
/// second choice.
fn length(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
  from: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let low = range < 16777216;
    let r = if low { range << 8 } else { range };
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    let prob = probs.get(from);
    let bound = (r >>> 11) * prob;
    if c < bound {
      length_bits(
        src,
        p,
        bound,
        c,
        probs.set(from, prob + (2048 - prob >>> 5)),
        out,
        state,
        rep0,
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
        from + 2 + ((out.len() - (k >>> 12 & 15) & k & 15) << 3),
        1,
        -6,
      )
    } else {
      length_more(
        src,
        p,
        r - bound,
        c - bound,
        probs.set(from, prob - (prob >>> 5)),
        out,
        state,
        rep0,
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
        from,
      )
    }
  }

/// A length's second choice: the next eight lengths in three bits, or the rest in eight.
fn length_more(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
  from: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let low = range < 16777216;
    let r = if low { range << 8 } else { range };
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    let prob = probs.get(from + 1);
    let bound = (r >>> 11) * prob;
    if c < bound {
      length_bits(
        src,
        p,
        bound,
        c,
        probs.set(from + 1, prob + (2048 - prob >>> 5)),
        out,
        state,
        rep0,
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
        from + 130 + ((out.len() - (k >>> 12 & 15) & k & 15) << 3),
        1,
        2,
      )
    } else {
      length_bits(
        src,
        p,
        r - bound,
        c - bound,
        probs.set(from + 1, prob - (prob >>> 5)),
        out,
        state,
        rep0,
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
        from + 258,
        1,
        -238,
      )
    }
  }

/// A length's code, read as a literal's bits are. The length is the code plus `add`, which is
/// below -200 for the eight-bit code. The length is then packed above the state's four bits and
/// passed on to where a new distance is read or a known one is copied.
fn length_bits(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
  base: Int,
  symbol: Int,
  add: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let low = range < 16777216;
    let r = if low { range << 8 } else { range };
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    let prob = probs.get(base + symbol);
    let bound = (r >>> 11) * prob;
    let one = c >= bound;
    let next = probs.set(base + symbol, if one { prob - (prob >>> 5) }
    else { prob + (2048 - prob >>> 5) });
    let r2 = if one { r - bound } else { bound };
    let c2 = if one { c - bound } else { c };
    let grown = symbol * 2 + (if one { 1 } else { 0 });
    if grown < (if add < -200 { 256 } else { 8 }) {
      length_bits(
        src,
        p,
        r2,
        c2,
        next,
        out,
        state,
        rep0,
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
        base,
        grown,
        add,
      )
    } else if rep0 >= 0 {
      copy(src, p, r2, c2, next, out, state | grown + add << 4, rep0, rep1, r23, k, lim, fuel - 1)
    } else {
      slot(
        src,
        p,
        r2,
        c2,
        next,
        out,
        state | grown + add << 4,
        rep0,
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
        432 + (min(grown + add, 5) - 2 << 6),
        1,
      )
    }
  }

/// A new distance's slot: six bits, using the probabilities its length selected. A slot below 4 is
/// the distance. A slot below 14 gives two high bits and reads the rest in its own code. A higher
/// slot reads all but the last four bits directly.
fn slot(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
  base: Int,
  symbol: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let low = range < 16777216;
    let r = if low { range << 8 } else { range };
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    let prob = probs.get(base + symbol);
    let bound = (r >>> 11) * prob;
    let one = c >= bound;
    let next = probs.set(base + symbol, if one { prob - (prob >>> 5) }
    else { prob + (2048 - prob >>> 5) });
    let r2 = if one { r - bound } else { bound };
    let c2 = if one { c - bound } else { c };
    let grown = symbol * 2 + (if one { 1 } else { 0 });
    if grown < 64 {
      slot(src, p, r2, c2, next, out, state, rep0, rep1, r23, k, lim, fuel - 1, base, grown)
    } else if grown < 68 {
      copy(src, p, r2, c2, next, out, state, grown - 64, rep1, r23, k, lim, fuel - 1)
    } else {
      let s = grown - 64;
      let more = (s >>> 1) - 1;
      let high = 2 + (s & 1);
      if s < 14 {
        near(
          src,
          p,
          r2,
          c2,
          next,
          out,
          state,
          high << more,
          rep1,
          r23,
          k,
          lim,
          fuel - 1,
          688 + (high << more) - s - 1,
          1,
          more,
        )
      } else { far(src, p, r2, c2, next, out, state, high, rep1, r23, k, lim, fuel - 1, more - 4) }
    }
  }

/// Each five-bit value with its bits reversed.
fn bit_reversal() -> Bytes =
  b"\x00\x10\x08\x18\x04\x14\x0c\x1c\x02\x12\x0a\x1a\x06\x16\x0e\x1e\x01\x11\x09\x19\x05\x15\x0d\x1d\x03\x13\x0b\x1b\x07\x17\x0f\x1f"

/// The `more` low bits of a near distance, lowest first, in their own code.
fn near(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
  base: Int,
  symbol: Int,
  more: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let low = range < 16777216;
    let r = if low { range << 8 } else { range };
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    let prob = probs.get(base + symbol);
    let bound = (r >>> 11) * prob;
    let one = c >= bound;
    let next = probs.set(base + symbol, if one { prob - (prob >>> 5) }
    else { prob + (2048 - prob >>> 5) });
    let r2 = if one { r - bound } else { bound };
    let c2 = if one { c - bound } else { c };
    let grown = symbol * 2 + (if one { 1 } else { 0 });
    if grown < 1 << more {
      near(src, p, r2, c2, next, out, state, rep0, rep1, r23, k, lim, fuel - 1, base, grown, more)
    } else {
      copy(
        src,
        p,
        r2,
        c2,
        next,
        out,
        state,
        rep0 + (bit_reversal().at(grown - (1 << more)) >>> 5 - more),
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
      )
    }
  }

/// The `left` middle bits of a far distance, each read with a fixed probability of one half.
fn far(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
  left: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else if left <= 0 {
    last_four(src, ip, range, code, probs, out, state, rep0 << 4, rep1, r23, k, lim, fuel - 1, 1)
  } else {
    let low = range < 16777216;
    let r = (if low { range << 8 } else { range }) >>> 1;
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    if c >= r {
      far(src, p, r, c - r, probs, out, state, rep0 * 2 + 1, rep1, r23, k, lim, fuel - 1, left - 1)
    } else { far(src, p, r, c, probs, out, state, rep0 * 2, rep1, r23, k, lim, fuel - 1, left - 1) }
  }

/// The last four bits of a far distance, lowest first, in a code all far distances share.
fn last_four(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
  symbol: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let low = range < 16777216;
    let r = if low { range << 8 } else { range };
    let c = if low { (code << 8 | src.at(ip)) & 0xFFFF_FFFF } else { code };
    let p = if low { ip + 1 } else { ip };
    let prob = probs.get(802 + symbol);
    let bound = (r >>> 11) * prob;
    let one = c >= bound;
    let next = probs.set(802 + symbol, if one { prob - (prob >>> 5) }
    else { prob + (2048 - prob >>> 5) });
    let r2 = if one { r - bound } else { bound };
    let c2 = if one { c - bound } else { c };
    let grown = symbol * 2 + (if one { 1 } else { 0 });
    if grown < 16 {
      last_four(src, p, r2, c2, next, out, state, rep0, rep1, r23, k, lim, fuel - 1, grown)
    } else {
      copy(
        src,
        p,
        r2,
        c2,
        next,
        out,
        state,
        rep0 + (bit_reversal().at(grown - 16) >>> 1),
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
      )
    }
  }

/// Writes a match. Its length is above the state's four bits, and it copies from one more than
/// `rep0` bytes back.
fn copy(
  src: Bytes,
  ip: Int,
  range: Int,
  code: Int,
  probs: Array<Int>,
  out: Bytes,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  k: Int,
  lim: Array<Int>,
  fuel: Int,
) -> LzmaState / {xz.fail, abort.raise} =
  if fuel <= 0 { fail(lim.get(2), Code) } else {
    let n = out.len();
    let length = state >>> 4;
    if rep0 >= n - lim.get(0) || rep0 >= lim.get(1) {
      fail(lim.get(2) + min(ip, lim.get(3)), Distance)
    } else if n + length > k >>> 16 { fail(lim.get(2) + min(ip, lim.get(3)), Code) } else {
      decode_symbol(
        src,
        ip,
        range,
        code,
        probs,
        if rep0 + 1 >= length { out ++ out.slice(n - rep0 - 1, n - rep0 - 1 + length) }
        else { out ++ out.slice(n - rep0 - 1, n).cycle(length) },
        state & 15,
        rep0,
        rep1,
        r23,
        k,
        lim,
        fuel - 1,
      )
    }
  }

// --- Streams and blocks -------------------------------------------------------

/// A decoded number: its value and the offset of the byte after it. A value of -1 means the number
/// was cut short at the given end, and -2 means it was badly encoded.
type Number = { value: Int, next: Int }

/// Reads a number stored seven bits per byte, lowest first, where a set high bit means another
/// byte follows. It has at most nine bytes, and no last byte of zero, which would add nothing.
fn number(b: Bytes, at: Int, end: Int, shift: Int, low: Int) -> Number / {abort.raise} =
  if at >= end { { value: -1, next: at } } else {
    let byte = b.at(at);
    if byte == 0 && shift > 0 { { value: -2, next: at } }
    else if byte < 128 { { value: low | byte << shift, next: at + 1 } }
    else if shift >= 56 { { value: -2, next: at } }
    else { number(b, at + 1, end, shift + 7, low | (byte & 127) << shift) }
  }

/// `n` encoded as `number` reads it.
fn number_bytes(n: Int) -> Bytes / {abort.raise} =
  if n < 128 { byte_of_int(n) } else { byte_of_int(n % 128 + 128).concat(number_bytes(n / 128)) }

/// The running sum that a block's bytes are checked by.
type RunningCheck = | NoCheck | CrcCheck(checksum::State) | HashCheck(hash::Hasher)

/// The initial sum for a check type.
fn running_check(check: Int) -> RunningCheck =
  if check == 1 { CrcCheck(checksum::init(checksum::Crc(checksum::crc32_iso_hdlc()))) }
  else if check == 4 { CrcCheck(checksum::init(checksum::Crc(crc64_xz()))) }
  else if check == 10 { HashCheck(hash::init(hash::sha256_hash())) }
  else { NoCheck }

fn update_check(sum: RunningCheck, bytes: Bytes) -> RunningCheck / {abort.raise} =
  match sum {
    NoCheck -> NoCheck,
    CrcCheck(state) -> CrcCheck(checksum::update(state, bytes)),
    HashCheck(state) -> HashCheck(hash::update(state, bytes)),
  }

/// The bytes a block of a check type ends with.
fn check_of(sum: RunningCheck, check: Int) -> Bytes / {abort.raise} =
  match sum {
    NoCheck -> b"",
    HashCheck(state) -> hash::finish(state),
    CrcCheck(state) -> {
      let v = checksum::finish(state);
      let low = u32_le(Int::of_u64(v & 0xFFFF_FFFFu64));
      if check == 1 { low } else { low.concat(u32_le(Int::of_u64(v >>> 32))) }
    },
  }

/// How many bytes the check of a type is.
fn check_size(check: Int) -> Int =
  if check == 1 { 4 } else if check == 4 { 8 } else if check == 10 { 32 } else { 0 }

/// A block being read: its header's size and the sizes it declares, or -1; its dictionary's size
/// and where in the history it starts; the stream offset of its first chunk and the bytes written
/// before it; the LZMA state one chunk passes to the next; its properties as
/// `lc | lp << 4 | pb << 8`, or -1 before a chunk sets them; whether a chunk has started the
/// dictionary; and the running sum of its bytes.
type Block = {
  head: Int,
  packed: Int,
  plain: Int,
  dict: Int,
  floor: Int,
  from: Int,
  start: Int,
  probs: Array<Int>,
  state: Int,
  rep0: Int,
  rep1: Int,
  r23: Int,
  props: Int,
  begun: Bool,
  sum: RunningCheck,
}

fn no_block() -> Block =
  {
    head: 0,
    packed: -1,
    plain: -1,
    dict: 0,
    floor: 0,
    from: 0,
    start: 0,
    probs: Array::of_list([1024]),
    state: 0,
    rep0: 0,
    rep1: 0,
    r23: 0,
    props: -1,
    begun: false,
    sum: NoCheck,
  }

/// A reader's state apart from its two buffers: its position in the input and how much it has
/// returned, how many bytes it has dropped from the front of the history, the number of streams
/// read, what comes next (0 a stream's header or the padding after one, 1 a block's header or the
/// index, 2 a chunk, 3 a block's padding and check, 4 a stream's footer), how many bytes it needs
/// before it can continue, whether a stream has ended, the stream's check type, a record of each
/// block for the index to match, the index's size, and the block being read.
type Core = {
  limits: Limits,
  at: Int,
  base: Int,
  sent: Int,
  cut: Int,
  streams: Int,
  phase: Int,
  need: Int,
  closed: Bool,
  check: Int,
  records: List<Bytes>,
  index: Int,
  block: Block,
}

/// A reader partway through its input: the input not yet read, the bytes written that a match may
/// still copy or that are not yet returned, and the rest of its state.
type Decoder = { input: Bytes, history: Bytes, core: Core }

fn decoder(limits: Limits, input: Bytes) -> Decoder =
  {
    input: input,
    history: b"",
    core: {
      limits: limits,
      at: 0,
      base: 0,
      sent: 0,
      cut: 0,
      streams: 0,
      phase: 0,
      need: 0,
      closed: false,
      check: 0,
      records: [],
      index: 0,
      block: no_block(),
    },
  }

fn needing_input(d: Decoder, need: Int) -> Decoder = { ..d, core: { ..d.core, need: need } }

fn magic() -> Bytes = b"\xFD7zXZ\x00"

/// Reads a stream's twelve-byte header, or the zero padding in groups of four that may come
/// between two streams.
fn stream_start(d: Decoder, have: Int) -> Decoder / {xz.fail, abort.raise} = {
  let core = d.core;
  let at = core.at;
  let zeros = if core.streams > 0 { d.input.scan(at, b"\x00", have) - at >>> 2 << 2 } else { 0 };
  if zeros > 0 { { ..d, core: { ..core, at: at + zeros, need: 0 } } }
  else if have < 12 { needing_input(d, 12) } else if d.input.slice(at, at + 6) != magic() {
    fail(core.base + at, if core.streams == 0 { NotThisFormat } else { Trailing })
  } else {
    let check = d.input.at(at + 7);
    if d.input.at(at + 6) != 0 || check > 15 { fail(core.base + at + 6, Header) }
    else if Int::of_u32(crc32(d.input.slice(at + 6, at + 8)))
        != Int::of_u32(d.input.u32_le(at + 8)) { fail(core.base + at + 8, HeaderChecksum) }
    else if check != 0 && check != 1 && check != 4 && check != 10 {
      fail(core.base + at + 7, CheckType(check))
    } else {
      { ..d, core: { ..core, at: at + 12, phase: 1, need: 0, check: check, records: [], index: 0 } }
    }
  }
}

/// Reads the filters a block header lists from `p`, which must be LZMA2 alone with a byte giving
/// its dictionary's size. Returns that size.
fn filters(
  input: Bytes,
  p: Int,
  end: Int,
  count: Int,
  where: Int,
) -> Number / {xz.fail, abort.raise} = {
  let id = number(input, p, end, 0, 0);
  let size = number(input, id.next, end, 0, 0);
  let v = if size.next < end { input.at(size.next) } else { 255 };
  if id.value < 0 || size.value < 0 { fail(where, Header) }
  else if id.value != 0x21 { fail(where, Filter(id.value)) }
  else if count > 1 || size.value != 1 || v > 40 { fail(where, Header) } else {
    {
      value: if v == 40 { 0xFFFF_FFFF } else { (2 | v & 1) << (v >>> 1) + 11 },
      next: size.next + 1,
    }
  }
}

/// Reads a block's header: its size in a byte, flags, the sizes it declares, its filters, zero
/// padding, and a CRC-32 of all of that.
fn block_start(d: Decoder, have: Int) -> Decoder / {xz.fail, abort.raise} = {
  let core = d.core;
  let at = core.at;
  let where = core.base + at;
  let head = (d.input.at(at) + 1) * 4;
  if have < head { needing_input(d, head) } else {
    let end = at + head - 4;
    let flags = d.input.at(at + 1);
    let packed: Number = if flags & 0x40 != 0 { number(d.input, at + 2, end, 0, 0) }
    else { { value: -1, next: at + 2 } };
    let plain: Number = if flags & 0x80 != 0 { number(d.input, packed.next, end, 0, 0) }
    else { { value: -1, next: packed.next } };
    if Int::of_u32(crc32(d.input.slice(at, end))) != Int::of_u32(d.input.u32_le(end)) {
      fail(where, HeaderChecksum)
    } else if flags & 0x3C != 0 || (flags & 0x40 != 0 && packed.value < 1)
        || (flags & 0x80 != 0 && plain.value < 0) { fail(where, Header) } else {
      let dict = filters(d.input, plain.next, end, (flags & 3) + 1, where);
      if d.input.scan(dict.next, b"\x00", end - dict.next) != end { fail(where, Header) }
      else if dict.value > core.limits.window || dict.value > 0x7FFF_FFFF { fail(where, Window) }
      else if plain.value > core.limits.output - core.cut - d.history.len() {
        fail(where, OverLimit)
      } else {
        {
          ..d,
          core: {
            ..core,
            at: at + head,
            phase: 2,
            need: 0,
            block: {
              ..no_block(),
              head: head,
              packed: packed.value,
              plain: plain.value,
              dict: dict.value,
              floor: d.history.len(),
              from: where + head,
              start: core.cut + d.history.len(),
              sum: running_check(core.check),
            },
          },
        }
      }
    }
  }
}

/// Reads an uncompressed chunk: three bytes of header, where the second and third are one less
/// than the number of bytes that follow. The first kind resets the dictionary, after which
/// properties must be set again.
fn plain_chunk(d: Decoder, have: Int, control: Int) -> Decoder / {xz.fail, abort.raise} =
  if have < 3 { needing_input(d, 3) } else {
    let core = d.core;
    let at = core.at;
    let size = (d.input.at(at + 1) << 8 | d.input.at(at + 2)) + 1;
    let block = core.block;
    if have < 3 + size { needing_input(d, 3 + size) }
    else if control == 2 && !block.begun { fail(core.base + at, Chunk) }
    else if size > core.limits.output - core.cut - d.history.len() {
      fail(core.base + at, OverLimit)
    } else {
      let piece = d.input.slice(at + 3, at + 3 + size);
      let floor = if control == 1 { d.history.len() } else { block.floor };
      {
        ..d,
        history: d.history ++ piece,
        core: {
          ..core,
          at: at + 3 + size,
          need: 0,
          block: {
            ..block,
            floor: floor,
            begun: true,
            props: if control == 1 { -1 } else { block.props },
            sum: update_check(block.sum, piece),
          },
        },
      }
    }
  }

/// The properties a byte encodes, as `lc | lp << 4 | pb << 8`: literal context bits, literal
/// position bits and position bits. The first two add up to at most four.
fn properties(byte: Int, where: Int) -> Int / {xz.fail} = {
  let lc = byte % 9;
  let lp = byte / 9 % 5;
  if byte > 224 || lc + lp > 4 { fail(where, Chunk) } else { lc | lp << 4 | byte / 45 << 8 }
}

/// Reads an LZMA chunk. Its control byte contains the top bits of one less than its unpacked size,
/// the next two bytes contain the rest, and the two after them are one less than its coded size.
/// The control byte also states what is reset first: nothing, the state, the state with new
/// properties in a following byte, or all of those and the dictionary.
fn coded_chunk(d: Decoder, have: Int, control: Int) -> Decoder / {xz.fail, abort.raise} = {
  let mode = control >>> 5 & 3;
  let head = if mode >= 2 { 6 } else { 5 };
  let core = d.core;
  let at = core.at;
  let where = core.base + at;
  if have < head { needing_input(d, head) } else {
    let sizes = d.input.slice(at, at + head);
    let plain = ((control & 31) << 16 | sizes.at(1) << 8 | sizes.at(2)) + 1;
    let packed = (sizes.at(3) << 8 | sizes.at(4)) + 1;
    let block = core.block;
    if have < head + packed { needing_input(d, head + packed) }
    else if (mode < 3 && !block.begun) || (mode < 2 && block.props < 0) { fail(where, Chunk) }
    else if plain > core.limits.output - core.cut - d.history.len() { fail(where, OverLimit) }
    else if packed < 5 || d.input.at(at + head) != 0 { fail(where + head, Code) } else {
      let props = if mode >= 2 { properties(sizes.at(5), where) } else { block.props };
      let lc = props & 15;
      let lp = props >>> 4 & 15;
      let coded = d.input.slice(at + head, at + head + packed).concat(
        b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
      );
      let fresh = mode >= 1;
      let probs = if fresh { Array::new(1846 + (768 << lc + lp), 1024) } else { block.probs };
      let before = d.history.len();
      let floor = if mode == 3 { before } else { block.floor };
      let done = decode_symbol(
        coded,
        5,
        0xFFFF_FFFF,
        coded.at(1) << 24 | coded.at(2) << 16 | coded.at(3) << 8 | coded.at(4),
        probs,
        d.history,
        if fresh { 0 } else { block.state },
        if fresh { 0 } else { block.rep0 },
        if fresh { 0 } else { block.rep1 },
        if fresh { 0 } else { block.r23 },
        (1 << (props >>> 8)) - 1 | (1 << lp) - 1 << 4 | lc << 8 | (floor & 15) << 12
          | before + plain << 16,
        Array::of_list([floor, block.dict, where + head, packed]),
        64 * plain + 64,
      );
      if done.ip != packed || done.code != 0 { fail(where + head + min(done.ip, packed), Code) }
      else {
        {
          ..d,
          history: done.out,
          core: {
            ..core,
            at: at + head + packed,
            need: 0,
            block: {
              ..block,
              floor: floor,
              begun: true,
              props: props,
              probs: done.probs,
              state: done.state,
              rep0: done.rep0,
              rep1: done.rep1,
              r23: done.r23,
              sum: update_check(block.sum, done.out.slice(before, done.out.len())),
            },
          },
        }
      }
    }
  }
}

/// One chunk of a block's LZMA2 data, or the zero byte that ends it.
fn chunk(d: Decoder, have: Int) -> Decoder / {xz.fail, abort.raise} = {
  let control = d.input.at(d.core.at);
  if control == 0 { { ..d, core: { ..d.core, at: d.core.at + 1, phase: 3, need: 0 } } }
  else if control >= 0x80 { coded_chunk(d, have, control) }
  else if control > 2 { fail(d.core.base + d.core.at, Chunk) }
  else { plain_chunk(d, have, control) }
}

/// Reads what follows a block's data: zero padding to a multiple of four bytes, and its check.
/// Also checks that the block's sizes match what its header declared.
fn block_end(d: Decoder, have: Int) -> Decoder / {xz.fail, abort.raise} = {
  let core = d.core;
  let at = core.at;
  let where = core.base + at;
  let block = core.block;
  let packed = where - block.from;
  let pad = 4 - packed % 4 & 3;
  let size = check_size(core.check);
  let plain = core.cut + d.history.len() - block.start;
  if have < pad + size { needing_input(d, pad + size) }
  else if d.input.scan(at, b"\x00", pad) != at + pad { fail(where, Header) }
  else if (block.packed >= 0 && block.packed != packed)
      || (block.plain >= 0 && block.plain != plain) { fail(where, Size) }
  else if d.input.slice(at + pad, at + pad + size) != check_of(block.sum, core.check) {
    fail(where + pad, Checksum)
  } else {
    {
      ..d,
      core: {
        ..core,
        at: at + pad + size,
        phase: 1,
        need: 0,
        block: no_block(),
        records: core.records.push(
          number_bytes(block.head + packed + size).concat(number_bytes(plain)),
        ),
      },
    }
  }
}

/// The index that a stream's blocks require: a zero byte, the number of blocks, each block's size
/// without padding and its unpacked size, zero padding to a multiple of four bytes, and a CRC-32.
fn index_of(records: List<Bytes>) -> Bytes / {abort.raise} = {
  let listed = Bytes::concat_all([
    b"\x00",
    number_bytes(records.len()),
    Bytes::concat_all(records),
  ]);
  let filled = listed.concat(b"\x00\x00\x00".slice(0, 4 - listed.len() % 4 & 3));
  filled.concat(u32_le(Int::of_u32(crc32(filled))))
}

/// Reads the index, which must match what the blocks read require, byte for byte.
fn index(d: Decoder, have: Int) -> Decoder / {xz.fail, abort.raise} = {
  let core = d.core;
  let want = index_of(core.records);
  let n = want.len();
  if have < n { needing_input(d, n) }
  else if d.input.slice(core.at, core.at + n) != want { fail(core.base + core.at, Index) }
  else { { ..d, core: { ..core, at: core.at + n, phase: 4, need: 0, index: n, records: [] } } }
}

/// Reads a stream's twelve-byte footer: a CRC-32 of the six bytes after it, the index's size, the
/// header's flags again, and two letters.
fn footer(d: Decoder, have: Int) -> Decoder / {xz.fail, abort.raise} =
  if have < 12 { needing_input(d, 12) } else {
    let core = d.core;
    let at = core.at;
    let where = core.base + at;
    if Int::of_u32(crc32(d.input.slice(at + 4, at + 10))) != Int::of_u32(d.input.u32_le(at)) {
      fail(where, HeaderChecksum)
    } else if d.input.slice(at + 10, at + 12) != b"YZ" { fail(where + 10, Header) }
    else if (Int::of_u32(d.input.u32_le(at + 4)) + 1) * 4 != core.index || d.input.at(at + 8) != 0
        || d.input.at(at + 9) != core.check { fail(where + 4, Index) } else {
      {
        ..d,
        core: { ..core, at: at + 12, phase: 0, need: 0, closed: true, streams: core.streams + 1 },
      }
    }
  }

/// One step of a reader. A reader that needs more input than it has records how much in `need`.
fn step(d: Decoder) -> Decoder / {xz.fail, abort.raise} = {
  let phase = d.core.phase;
  let have = d.input.len() - d.core.at;
  if phase == 0 { stream_start(d, have) }
  else if phase == 4 { footer(d, have) }
  else if have < 1 { needing_input(d, 1) }
  else if phase == 2 { chunk(d, have) }
  else if phase == 3 { block_end(d, have) }
  else if d.input.at(d.core.at) == 0 { index(d, have) }
  else { block_start(d, have) }
}

/// Steps until the reader needs input, has `goal` bytes to return, or, when `one` is set, has
/// read a stream.
fn pump(d: Decoder, goal: Int, one: Bool, fuel: Int) -> Decoder / {xz.fail, abort.raise} =
  if fuel <= 0 || d.core.need > 0 || (one && d.core.closed)
      || d.history.len() - d.core.sent >= goal { d }
  else { pump(step(d), goal, one, fuel - 1) }

/// Checks the reader's state at the end of its input. It must be just after a stream, with nothing
/// left over except padding that `stream_start` skipped.
fn finished(d: Decoder) -> Decoder / {xz.fail, abort.raise} = {
  let at = d.core.at;
  let left = d.input.slice(at, d.input.len());
  let opens = magic().starts_with(left.slice(0, min(6, left.len())));
  if d.core.phase == 0 && !opens {
    fail(d.core.base + at, if d.core.streams == 0 { NotThisFormat } else { Trailing })
  } else if d.core.phase != 0 || d.core.streams == 0 || left.len() != 0 {
    fail(d.core.base + d.input.len(), Truncated)
  } else { d }
}

/// The bytes written and not yet returned.
fn pending(d: Decoder) -> Bytes / {abort.raise} =
  if d.core.sent == 0 { d.history } else { d.history.slice(d.core.sent, d.history.len()) }

/// The decompressed contents of an `.xz` file's streams, at most `limits.output` bytes.
pub fn decompress(data: Bytes, limits: Limits) -> Bytes / {xz.fail, abort.raise} =
  pending(finished(pump(decoder(limits, data), 0x3FFF_FFFF_FFFF_FFFF, false, 2 * data.len() + 8)))

/// `decompress`, with an error returned rather than raised.
pub fn try_decompress(data: Bytes, limits: Limits) -> Result<Bytes, Error> / {abort.raise} =
  try { decompress(data, limits) }

/// A file's first stream, and how many bytes of the input it used.
pub type FirstStream = new { plain: Bytes, used: Int }

/// The first stream of `data`, whatever follows it.
pub fn decompress_first(data: Bytes, limits: Limits) -> FirstStream / {xz.fail, abort.raise} = {
  let end = pump(decoder(limits, data), 0x3FFF_FFFF_FFFF_FFFF, true, 2 * data.len() + 8);
  if !end.core.closed { fail(data.len(), Truncated) }
  else { { plain: pending(end), used: end.core.at } }
}

// --- A stream a chunk at a time -----------------------------------------------

/// The reader with `chunk` appended to the input it has not read.
fn feed(d: Decoder, chunk: Bytes) -> Decoder / {abort.raise} = {
  let core = d.core;
  {
    input: d.input.slice(core.at, d.input.len()).concat(chunk),
    history: d.history,
    core: { ..core, at: 0, base: core.base + core.at, need: 0 },
  }
}

type DecoderOutput = { out: Bytes, next: Decoder }

/// What the reader has written and not yet returned, and the reader without the history no match
/// can reach. Within a block's chunks a match can reach the block's dictionary, and elsewhere it
/// can reach nothing.
fn take_output(d: Decoder) -> DecoderOutput / {abort.raise} = {
  let core = d.core;
  let block = core.block;
  let n = d.history.len();
  let out = d.history.slice(core.sent, n);
  let dead = if core.phase != 2 { n } else { max(0, max(block.floor, n - block.dict)) };
  if dead >= 65536 && dead * 4 >= n - dead {
    {
      out: out,
      next: {
        input: d.input,
        history: d.history.slice(dead, n),
        core: {
          ..core,
          sent: n - dead,
          cut: core.cut + dead,
          block: { ..block, floor: block.floor - dead },
        },
      },
    }
  } else { { out: out, next: { ..d, core: { ..core, sent: n } } } }
}

/// How many bytes a reader writes before returning them: 64 KiB, or an eighth of the block's
/// dictionary if that is more.
fn stride(d: Decoder) -> Int = max(65536, d.core.block.dict >>> 3)

fn decompress_chunks<| e>(
  packed: Seq<Bytes | e>,
  d: Decoder,
  fuel: Int,
) -> Seq<Bytes | {xz.fail, abort.raise | e}> =
  ||
    if fuel <= 0 { Done } else {
      let moved = pump(d, stride(d), false, 2 * d.input.len() + 8);
      if moved.history.len() > moved.core.sent {
        let answered = take_output(moved);
        Yield(answered.out, decompress_chunks(packed, answered.next, fuel - 1))
      } else if moved.core.need == 0 { Skip(decompress_chunks(packed, moved, fuel - 1)) } else {
        match packed() {
          Done -> {
            finished(moved);
            Done
          },
          Skip(rest) -> Skip(decompress_chunks(rest, moved, fuel - 1)),
          Yield(chunk, rest) -> Skip(decompress_chunks(rest, feed(moved, chunk), fuel - 1)),
        }
      }
    }

/// The decompressed contents of the `.xz` file in `packed`, as a sequence with a chunk for each
/// pull that has bytes to return. A pull reads at most one chunk of `packed`, and decompresses
/// until it has a stride of bytes (64 KiB, or an eighth of the block's dictionary) or needs the
/// next chunk. So the reader keeps in memory one chunk of input, one LZMA2 chunk, which is at most
/// 64 KiB packed and 2 MiB unpacked, and no more of its output than a block's dictionary plus a
/// quarter of it plus a stride. The sequence fails where `decompress` would, at the same offset,
/// and also when `packed` ends before the file does.
pub fn decompress_stream<| e>(
  packed: Seq<Bytes | e>,
  limits: Limits,
) -> Seq<Bytes | {xz.fail, abort.raise | e}> =
  decompress_chunks(packed, decoder(limits, b""), 0x3FFF_FFFF_FFFF_FFFF)

// --- Tests ------------------------------------------------------------------

fn checked() -> Bytes =
  b"Ply checks every effect a program performs, and a test that reads no host is cached. "

fn thrice() -> Bytes = checked().repeat(3)

fn large_limits() -> Limits = { output: 1048576, window: 67108864 }

type Fixture = { name: String, packed: String, plain: Bytes }

/// Files written by `xz` 5.8.2.
fn files() -> List<Fixture> =
  [
    {
      name: "a sentence three times at the default level, with a CRC-64",
      packed: "",
      plain: thrice(),
    },
    {
      name: "a sentence three times with a SHA-256",
      packed: "",
      plain: thrice(),
    },
    {
      name: "a sentence at the fastest level, with a CRC-32",
      packed: "fd377a585a0000016922de3604c05b55210110000000000000000000b931d4a5e0005400535d00281b0b2202b1c3b5ce2b452bc4f762147a2aedbd0b3d9199ef34bc6510970d218e96e2f3d2b648aaf05d5542062612694e83df75938fb36bb56d20468efb9e5ab8f6f0b44ffdd1a7191c36fea38809cd0f00000000fd137faf00017355653a953f9042990d010000000001595a",
      plain: checked(),
    },
    {
      name: "a sentence with no check, in a chunk of the bytes as they are",
      packed: "fd377a585a000000ff12d94104c0595521011000000000000000000014f5ba44010054506c7920636865636b732065766572792065666665637420612070726f6772616d20706572666f726d732c20616e64206120746573742074686174207265616473206e6f20686f7374206973206361636865642e200000000000016d55ba05d4eb06729e7a010000000000595a",
      plain: checked(),
    },
  ]

fn file(i: Int) -> Bytes / {abort.raise} =
  match files().at(i) { Some(f) -> Bytes::of_hex(f.packed), None -> panic("no such file") }

/// The decompressed chunks of a file, joined.
fn joined(
  chunks: Seq<Bytes | {xz.fail, abort.raise}>,
) -> Bytes / {xz.fail, seq.spent, abort.raise} = Bytes::concat_all(seq::to_list(chunks, 1000000))

test "decompress reads {f.name}, whole and a few bytes at a time" for f: Fixture in files() {
  let packed = Bytes::of_hex(f.packed);
  assert_eq(decompress(packed, large_limits()), f.plain);
  assert_eq(joined(decompress_stream(seq::slices(packed, 1), large_limits())), f.plain);
  assert_eq(joined(decompress_stream(seq::slices(packed, 7), large_limits())), f.plain)
}

test "cut short anywhere, {f.name} fails as truncated" for f: Fixture in files() {
  let whole = Bytes::of_hex(f.packed);
  assert_eq(
    range(0, whole.len()).filter(|n: Int|
      match try_decompress(whole.slice(0, n), large_limits()) {
        Err(refusal) -> refusal.reason != Truncated,
        Ok(_) -> true,
      }),
    [],
  )
}

test "whichever byte of {f.name} is changed, a file whose blocks are checked is rejected" for f: Fixture in files(
  ) {
  let whole = Bytes::of_hex(f.packed);
  let read = range(0, whole.len()).filter(|i: Int|
    match try_decompress(whole.with_byte(i, whole.at(i) ^ 0x10), large_limits()) {
      Ok(_) -> true,
      Err(_) -> false,
    });
  // With no check, a changed data byte just changes a byte of the result.
  assert(read == [] || whole.at(7) == 0, Some(read.len().to_string()))
}

fn assert_error(got: Result<Bytes, Error>, at: Int, why: ErrorKind) -> Unit / {abort.raise} =
  assert_eq(got, Err({ at: at, reason: why }))

/// A stream's header for blocks of the check type `check`.
fn stream_head(check: Int) -> Bytes / {abort.raise} = {
  let flags = b"\x00".concat(byte_of_int(check));
  Bytes::concat_all([magic(), flags, u32_le(Int::of_u32(crc32(flags)))])
}

/// A block's header that declares no size, for LZMA2 alone with the dictionary byte `dict`.
fn block_head(dict: Int) -> Bytes / {abort.raise} = {
  let head = Bytes::concat_all([b"\x02\x00\x21\x01", byte_of_int(dict), b"\x00\x00\x00"]);
  head.concat(u32_le(Int::of_u32(crc32(head))))
}

/// `plain` as an `.xz` file of one block with no check, in uncompressed chunks of `size` bytes.
fn stored(plain: Bytes, size: Int) -> Bytes / {abort.raise} = {
  let n = plain.len();
  let chunks = range(0, (n + size - 1) / size).map(|i: Int| {
    let piece = plain.slice(i * size, min(n, i * size + size));
    Bytes::concat_all([
      if i == 0 { b"\x01" } else { b"\x02" },
      byte_of_int(piece.len() - 1 >>> 8),
      byte_of_int(piece.len() - 1 & 255),
      piece,
    ])
  });
  let data = Bytes::concat_all(chunks).concat(b"\x00");
  let block = Bytes::concat_all([
    block_head(0),
    data,
    b"\x00\x00\x00".slice(0, 4 - data.len() % 4 & 3),
  ]);
  let index = index_of(if n == 0 { [] }
  else { [number_bytes(12 + data.len()).concat(number_bytes(n))] });
  let back = u32_le(index.len() / 4 - 1).concat(b"\x00\x00");
  Bytes::concat_all([
    stream_head(0),
    if n == 0 { b"" } else { block },
    index,
    u32_le(Int::of_u32(crc32(back))),
    back,
    b"YZ",
  ])
}

test "a reader reports why bytes are not an .xz file, and where" {
  let good = file(0);
  let n = good.len();
  let read = |packed: Bytes| try_decompress(packed, large_limits());
  assert_error(read(b""), 0, Truncated);
  assert_error(read(b"\xFD7z"), 3, Truncated);
  assert_error(read(b"\x1f\x8b\x08\x00 a file of another kind"), 0, NotThisFormat);
  assert_error(read(good.with_byte(7, 5)), 8, HeaderChecksum);
  assert_error(read(good.with_byte(6, 1)), 6, Header);
  assert_error(read(stream_head(2).concat(good.slice(12, n))), 7, CheckType(2));
  assert_error(read(good.with_byte(13, 1)), 12, HeaderChecksum);
  assert_error(read(stream_head(4).concat(block_head(41))), 12, Header);
  assert_error(
    read(
      Bytes::of_hex("fd377a585a000004e6d6b44604c15b550400210110000000000000001755c2b1e000540053"),
    ),
    12,
    Filter(4),
  );
  assert_error(
    read(Bytes::of_hex("fd377a585a000004e6d6b44604c15955030100210110000000000000c3e01b1001005450")),
    12,
    Filter(3),
  );
  // The block's header is twenty bytes, so its first chunk starts at 32 and its coded bits at 38.
  assert_error(read(good.with_byte(32, 3)), 32, Chunk);
  assert_error(read(good.with_byte(32, 0x80)), 32, Chunk);
  assert_error(read(good.with_byte(38, 1)), 38, Code);
  assert_error(read(good.with_byte(n - 1, 0x59)), n - 2, Header);
  assert_error(read(good.with_byte(n - 4, 5)), n - 12, HeaderChecksum);
  assert_error(try_decompress(good, { output: 254, window: 67108864 }), 12, OverLimit);
  assert_error(try_decompress(good, { output: 1048576, window: 8388607 }), 12, Window);
  assert_eq(try_decompress(good, { output: 255, window: 8388608 }), Ok(thrice()))
}

test "concatenated files are one file, with zero padding between and after, and the first reads alone" {
  let a = file(2);
  let b = file(3);
  let both = checked().concat(checked());
  let n = a.len();
  assert_eq(decompress(a.concat(b), large_limits()), both);
  let padded = Bytes::concat_all([a, b"\x00\x00\x00\x00", b, b"\x00\x00\x00\x00\x00\x00\x00\x00"]);
  assert_eq(decompress(padded, large_limits()), both);
  assert_eq(joined(decompress_stream(seq::slices(padded, 5), large_limits())), both);
  assert_error(
    try_decompress(Bytes::concat_all([a, b"\x00\x00\x00", b]), large_limits()),
    n,
    Trailing,
  );
  assert_error(try_decompress(a.concat(b"\x00\x00"), large_limits()), n, Trailing);
  assert_error(try_decompress(a.concat(b"more"), large_limits()), n, Trailing);
  assert_error(try_decompress(b"\x00\x00\x00\x00".concat(a), large_limits()), 0, NotThisFormat);
  assert_error(try_decompress(a.concat(b.slice(0, 20)), large_limits()), n + 20, Truncated);
  assert_error(try_decompress(padded, { output: 169, window: 67108864 }), n + 4 + 12, OverLimit);
  let head = decompress_first(a.concat(b"more"), large_limits());
  assert_eq(head.plain, checked());
  assert_eq(head.used, n)
}

test "a file of uncompressed chunks reads back, whole and however it is split" {
  gen::check3(gen::bytes(), gen::any_int(), gen::any_int(), |x: Bytes, size: Int, cut: Int| {
    let packed = stored(x, 1 + (size & 63));
    let at = (cut & 0x7FFF_FFFF) % packed.len();
    decompress(packed, large_limits()) == x
      && joined(decompress_stream(seq::slices(packed, 1 + (cut & 7)), large_limits())) == x
      && joined(
        decompress_stream(
          seq::of_list([packed.slice(0, at), packed.slice(at, packed.len())]),
          large_limits(),
        ),
      )
      == x
  })
}

/// Whether a reader limited to 4096 bytes returns no more than that or fails with an `xz` error,
/// and raises nothing else.
fn harmless(packed: Bytes) -> Bool = {
  let got: Result<Result<Bytes, Error>, String> = try[abort.raise] {
    try_decompress(packed, { output: 4096, window: 65536 })
  };
  match got { Ok(Ok(plain)) -> plain.len() <= 4096, Ok(Err(_)) -> true, Err(_) -> false }
}

/// `coded` as the only LZMA chunk of a block, declared to unpack to `plain` bytes under the
/// properties `props`.
fn coded_file(coded: Bytes, plain: Int, props: Int) -> Bytes / {abort.raise} = {
  let body = Bytes::concat_all([b"\x00", coded, b"\x00\x00\x00\x00"]);
  Bytes::concat_all([
    stream_head(0),
    block_head(8),
    b"\xE0",
    byte_of_int(plain - 1 >>> 8 & 255),
    byte_of_int(plain - 1 & 255),
    byte_of_int(body.len() - 1 >>> 8 & 255),
    byte_of_int(body.len() - 1 & 255),
    byte_of_int(props),
    body,
    b"\x00",
  ])
}

test "whatever bytes a reader is given, as a file or a chunk's coded bits, it stays within its limits or fails" {
  gen::check2(gen::bytes(), gen::any_int(), |x: Bytes, props: Int| {
    harmless(x) && harmless(stream_head(1).concat(x)) && harmless(coded_file(x, 64, 0x5D))
      && harmless(coded_file(x, 3000, (props & 0xFFFF) % 225))
  })
}

test "a block that requests a dictionary past the limit is rejected before any chunk is read" {
  let asks = |dict: Int| try_decompress(stream_head(4).concat(block_head(dict)), large_limits());
  assert_error(asks(40), 12, Window);
  assert_error(asks(31), 12, Window)
}

/// The largest size the history reaches after returning output, reading `d` until it needs input.
fn widest(d: Decoder, most: Int, fuel: Int) -> { d: Decoder, most: Int } / {xz.fail, abort.raise} =
  if fuel <= 0 || d.core.need > 0 { { d: d, most: most } } else {
    let answered = take_output(pump(d, stride(d), false, 1000000));
    widest(answered.next, max(most, answered.next.history.len()), fuel - 1)
  }

test "a file is read in a history its dictionary bounds, however long it is" {
  let plain = checked().repeat(4000);
  let packed = stored(plain, 1000);
  assert(decompress(packed, large_limits()) == plain);
  let read = seq::to_list(seq::slices(packed, 5000), 1000).fold(
    { d: decoder(large_limits(), b""), most: 0 },
    |at: { d: Decoder, most: Int }, chunk: Bytes| widest(feed(at.d, chunk), at.most, 1000),
  );
  assert_eq(read.d.core.cut + read.d.history.len(), 340000);
  assert(read.most < 140000, Some(read.most.to_string()))
}
