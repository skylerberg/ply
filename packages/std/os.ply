//! Facts about the machine and the process a program runs in, as an effect.
//!
//! Every result comes from the host, not from the program, so the effect is `nondet`. Results can
//! differ from one machine to another. `pid`, `hostname` and `cpus` can also differ from one run to
//! the next. A test replaces the host with `with_machine` and a `FakeMachine`, so it can run code
//! that depends on a system other than the one the test runs on. None of the operations reads the
//! environment; that is the job of `std.env`. `user` looks up the name for the process's user id in
//! the system's own records, and `hostname` asks the kernel, not a DNS resolver.
//!
//! The results describe the machine the program runs on, never the one that built it. A `const fn`
//! performs no effects, so a build cannot store a result from the build machine. A built program
//! queries the facts again when it runs. For this reason `endian` and `pointer_bits` are operations
//! rather than constants. When the program installs no handler for the `os` effect, the host
//! handles it: `host_handler` is the effect's host handler. Every entry point whose effects include
//! `os` runs under `host_handler` without needing any permission.

import std.internal.native (found_text, native, told, found)

/// Facts about the host. `family`, `arch`, `endian`, `pointer_bits`, `pid`, `user` and
/// `executable` stay the same for a whole run. `name`, `hostname` and `cpus` are what the system
/// reports at the time of the call.
pub nondet effect os {
  /// Returns the operating system family the process runs on.
  read family() -> Family
  /// The system's own name for itself and its release, as `uname -sr` prints them:
  /// `Darwin 24.6.0`, `Linux 6.8.0-45-generic`.
  read name() -> String
  /// The processor architecture the running `ply` was built for.
  read arch() -> Arch
  /// How many processors the process may run on at once, at least one. Where the system reports
  /// them, this accounts for the process's affinity mask and its control group's quota. Use it to
  /// decide how many workers to start; it is not the number of processors the machine has.
  read cpus() -> Int
  /// The kernel's name for the machine, as `gethostname` returns it.
  read hostname() -> String
  /// The user the process runs as.
  read user() -> User
  /// The process's id.
  read pid() -> Int
  /// The absolute path of the executable the process is running, with symbolic links resolved.
  /// Under `ply run` it is `ply` itself. `None` if the system does not report it.
  read executable() -> Option<String>
  /// The byte order of the machine's words.
  read endian() -> Endian
  /// The width of an address on the machine, in bits: 64 or 32.
  read pointer_bits() -> Int
}

/// An operating system, with `OtherFamily` containing the toolchain's name for one not listed.
pub type Family = | Linux | MacOs | Windows | FreeBsd | OpenBsd | NetBsd | OtherFamily(String)

/// A processor architecture, with `OtherArch` containing the toolchain's name for one not listed.
pub type Arch = | X86_64 | Aarch64 | X86 | Arm | Riscv64 | OtherArch(String)

/// A byte order.
pub type Endian = | Little | Big

/// A user: its numeric id, and the name the system's records give that id. The name is `None`
/// when there is no record, as in a container run under an arbitrary id.
pub type User = { id: Int, name: Option<String> }

/// Returns the lowercase name that build tools and target triples use for an operating system:
/// `linux`, `macos`, `windows`, `freebsd`, `openbsd` or `netbsd`. For `OtherFamily(name)` it
/// returns `name`.
pub fn family_name(f: Family) -> String =
  match f {
    Linux -> "linux",
    MacOs -> "macos",
    Windows -> "windows",
    FreeBsd -> "freebsd",
    OpenBsd -> "openbsd",
    NetBsd -> "netbsd",
    OtherFamily(name) -> name,
  }

/// Returns the name that build tools and target triples use for an architecture: `x86_64`,
/// `aarch64`, `x86`, `arm` or `riscv64`. For `OtherArch(name)` it returns `name`.
pub fn arch_name(a: Arch) -> String =
  match a {
    X86_64 -> "x86_64",
    Aarch64 -> "aarch64",
    X86 -> "x86",
    Arm -> "arm",
    Riscv64 -> "riscv64",
    OtherArch(name) -> name,
  }

/// Whether a system is one of the Unix family: every listed one but Windows.
pub fn is_unix(f: Family) -> Bool = match f { Windows -> false, OtherFamily(_) -> false, _ -> true }

/// What a test passes to `with_machine` in place of the host: a result for each operation.
pub type FakeMachine = {
  family: Family,
  name: String,
  arch: Arch,
  cpus: Int,
  hostname: String,
  user: User,
  pid: Int,
  executable: Option<String>,
  endian: Endian,
  pointer_bits: Int,
}

/// A starting machine for tests: x86-64 Linux with four processors. A test updates the facts it is
/// about.
pub fn machine() -> FakeMachine =
  {
    family: Linux,
    name: "Linux 6.8.0",
    arch: X86_64,
    cpus: 4,
    hostname: "host",
    user: { id: 1000, name: Some("user") },
    pid: 4242,
    executable: Some("/usr/local/bin/ply"),
    endian: Little,
    pointer_bits: 64,
  }

/// Runs `go` on the machine `m`, handling every operation from `m`'s fields.
pub fn with_machine<a | e>(m: FakeMachine, go: () -> a / {os.read | e}) -> a / e =
  handle {
    go()
  } with {
    os.family() -> m.family,
    os.name() -> m.name,
    os.arch() -> m.arch,
    os.cpus() -> m.cpus,
    os.hostname() -> m.hostname,
    os.user() -> m.user,
    os.pid() -> m.pid,
    os.executable() -> m.executable,
    os.endian() -> m.endian,
    os.pointer_bits() -> m.pointer_bits,
  }

host for os by host_handler

fn host_handler<a | e>(go: () -> a / {os.read | e}) -> a / {native.read, abort.raise | e} =
  handle {
    go()
  } with {
    os.family() -> family_of(os_system()),
    os.name() -> String::of_bytes_lossy(told("its name", os_uname())),
    os.arch() -> arch_of(os_machine()),
    os.cpus() -> os_cpus(),
    os.hostname() -> String::of_bytes_lossy(told("its hostname", os_hostname())),
    os.user() -> user_of(os_uid()),
    os.pid() -> os_pid(),
    os.executable() -> found_text(os_executable()),
    os.endian() -> if os_big_endian() { Big } else { Little },
    os.pointer_bits() -> os_pointer_bits(),
  }

fn family_of(name: String) -> Family =
  match name {
    "linux" -> Linux,
    "macos" -> MacOs,
    "windows" -> Windows,
    "freebsd" -> FreeBsd,
    "openbsd" -> OpenBsd,
    "netbsd" -> NetBsd,
    _ -> OtherFamily(name),
  }

fn arch_of(name: String) -> Arch =
  match name {
    "x86_64" -> X86_64,
    "aarch64" -> Aarch64,
    "x86" -> X86,
    "arm" -> Arm,
    "riscv64" -> Riscv64,
    _ -> OtherArch(name),
  }

fn user_of(id: Int) -> User / {native.read} = { id: id, name: found_text(os_user_name(id)) }

extern fn os_system() -> String / {native.read}

extern fn os_machine() -> String / {native.read}

extern fn os_uname() -> Bytes / {native.read}

extern fn os_hostname() -> Bytes / {native.read}

extern fn os_cpus() -> Int / {native.read}

extern fn os_uid() -> Int / {native.read}

extern fn os_user_name(id: Int) -> Bytes / {native.read}

extern fn os_pid() -> Int / {native.read}

extern fn os_executable() -> Bytes / {native.read}

extern fn os_big_endian() -> Bool / {native.read}

extern fn os_pointer_bits() -> Int / {native.read}

fn origin() -> String / {os.hostname, os.pid, os.user} =
  match os.user().name {
    Some(name) -> name ++ "@" ++ os.hostname() ++ "[" ++ os.pid().to_string() ++ "]",
    None -> os.user().id.to_string() ++ "@" ++ os.hostname() ++ "[" ++ os.pid().to_string() ++ "]",
  }

fn settings_dir(home: String) -> String / {os.family} =
  match os.family() {
    Windows -> home ++ "\\AppData\\Roaming\\tool",
    MacOs -> home ++ "/Library/Application Support/tool",
    _ -> home ++ "/.config/tool",
  }

fn workers() -> Int / {os.cpus} = max(1, os.cpus() - 1)

test "a test fixes every machine property, such as the system, CPU count and host name, so code that reads them is deterministic" {
  let m = machine();
  with_machine(m, || {
    assert_eq(os.family(), Linux);
    assert_eq(os.name(), "Linux 6.8.0");
    assert_eq(os.arch(), X86_64);
    assert_eq(os.cpus(), 4);
    assert_eq(os.hostname(), "host");
    assert_eq(os.user(), { id: 1000, name: Some("user") });
    assert_eq(os.pid(), 4242);
    assert_eq(os.executable(), Some("/usr/local/bin/ply"));
    assert_eq(os.endian(), Little);
    assert_eq(os.pointer_bits(), 64)
  });
  assert_eq(with_machine(m, origin), "user@host[4242]");
  assert_eq(with_machine({ ..m, user: { id: 70123, name: None } }, origin), "70123@host[4242]")
}

test "`settings_dir` returns the settings directory for the operating system family {family_name(f)}, on any host" for f: Family in [
    Linux,
    MacOs,
    Windows,
    FreeBsd,
    OtherFamily("plan9"),
  ] {
  let dir = with_machine({ ..machine(), family: f }, || settings_dir("/home/ada"));
  assert_eq(dir, match f {
    Windows -> "/home/ada\\AppData\\Roaming\\tool",
    MacOs -> "/home/ada/Library/Application Support/tool",
    _ -> "/home/ada/.config/tool",
  })
}

test "work is sized by the processors the process may use" {
  assert_eq(with_machine({ ..machine(), cpus: 16 }, workers), 15);
  assert_eq(with_machine({ ..machine(), cpus: 1 }, workers), 1)
}

test "`family_name` and `arch_name` return lowercase names such as `linux` and `x86_64`, and an unlisted family or architecture returns the text it was created with" {
  assert_eq([Linux, MacOs, Windows, FreeBsd, OpenBsd, NetBsd].map(family_name), [
    "linux",
    "macos",
    "windows",
    "freebsd",
    "openbsd",
    "netbsd",
  ]);
  assert_eq(family_name(OtherFamily("illumos")), "illumos");
  assert_eq([X86_64, Aarch64, X86, Arm, Riscv64].map(arch_name), [
    "x86_64",
    "aarch64",
    "x86",
    "arm",
    "riscv64",
  ]);
  assert_eq(arch_name(OtherArch("s390x")), "s390x");
  assert(is_unix(MacOs));
  assert(!is_unix(Windows));
  assert(!is_unix(OtherFamily("wasi")))
}

test "`family_of` and `arch_of` turn the names from `family_name` and `arch_name` back into the original value" {
  [Linux, MacOs, Windows, FreeBsd, OpenBsd, NetBsd, OtherFamily("plan9")].fold(
    (),
    |_: Unit, f: Family| assert_eq(family_of(family_name(f)), f),
  );
  [X86_64, Aarch64, X86, Arm, Riscv64, OtherArch("s390x")].fold((), |_: Unit, a: Arch|
    assert_eq(arch_of(arch_name(a)), a));
  assert_eq(found_text(b"\x01ada"), Some("ada"));
  assert_eq(found_text(b"\x00"), None)
}

test/nondet "a run with no handler of its own queries the machine it runs on" {
  assert(os.cpus() >= 1);
  assert(os.pointer_bits() == 64 || os.pointer_bits() == 32);
  assert(os.pid() > 0 && os.pid() == os.pid());
  assert(os.user().id >= 0);
  assert(os.executable() != None);
  assert(os.hostname().len() > 0);
  assert(os.name().len() > 0);
  assert_eq(family_of(family_name(os.family())), os.family());
  assert_eq(arch_of(arch_name(os.arch())), os.arch())
}
