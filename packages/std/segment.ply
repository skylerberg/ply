//! Where a text may be split: its grapheme clusters, which are what a reader sees as characters,
//! and its words.
//!
//! A `Char` is a code point, and what a reader sees as one character is often several: a letter
//! and its accents, a Hangul syllable written as its letters, an emoji joined from others, a flag,
//! or a consonant cluster of an Indic script. `graphemes` splits a text into these, the extended
//! grapheme clusters of UAX #29. Reversing, truncating or counting a text by clusters never splits
//! what is drawn as one. `split_words` splits a text at the word boundaries of the same annex, so
//! every character falls in some segment. `words` returns only the segments that contain
//! a letter or a number. The rules are the defaults, tailored to no language: a script written
//! without spaces between words, such as Thai or Chinese, is not divided into words.
//!
//! A boundary is a position between characters, counted in characters from the start as
//! `String::slice` counts. A text of `n` characters has boundaries at `0` and `n` unless it is
//! empty, and the segments between consecutive boundaries make up the text. The table is
//! `std.ucd`'s, for the Unicode version it names.

import std.char
import std.char (sample_text)
import std.laws (agrees)
import std.list
import std.ucd
import std.ucd (Table)
import std.gen

type GraphemeBreak =
  | AnyGrapheme
  | Cr
  | Lf
  | Control
  | Extend
  | Zwj
  | RegionalIndicator
  | Prepend
  | SpacingMark
  | Leading
  | Vowel
  | Trailing
  | LvSyllable
  | LvtSyllable

fn grapheme_number(name: Bytes) -> Int / {abort.raise} =
  match name {
    b"" -> 0,
    b"CR" -> 1,
    b"LF" -> 2,
    b"Control" -> 3,
    b"Extend" -> 4,
    b"ZWJ" -> 5,
    b"Regional_Indicator" -> 6,
    b"Prepend" -> 7,
    b"SpacingMark" -> 8,
    b"L" -> 9,
    b"V" -> 10,
    b"T" -> 11,
    b"LV" -> 12,
    b"LVT" -> 13,
    _ -> panic(f"`{String::of_bytes_lossy(name)}` is not a Grapheme_Cluster_Break value"),
  }

fn grapheme_at(number: Int) -> GraphemeBreak =
  match number {
    1 -> Cr,
    2 -> Lf,
    3 -> Control,
    4 -> Extend,
    5 -> Zwj,
    6 -> RegionalIndicator,
    7 -> Prepend,
    8 -> SpacingMark,
    9 -> Leading,
    10 -> Vowel,
    11 -> Trailing,
    12 -> LvSyllable,
    13 -> LvtSyllable,
    _ -> AnyGrapheme,
  }

type WordBreak =
  | AnyWord
  | WordCr
  | WordLf
  | Newline
  | WordExtend
  | WordZwj
  | WordRegionalIndicator
  | Format
  | Katakana
  | HebrewLetter
  | ALetter
  | SingleQuote
  | DoubleQuote
  | MidNumberLetter
  | MidLetter
  | MidNumber
  | Numeric
  | ExtendNumberLetter
  | WSegSpace

fn word_number(name: Bytes) -> Int / {abort.raise} =
  match name {
    b"" -> 0,
    b"CR" -> 1,
    b"LF" -> 2,
    b"Newline" -> 3,
    b"Extend" -> 4,
    b"ZWJ" -> 5,
    b"Regional_Indicator" -> 6,
    b"Format" -> 7,
    b"Katakana" -> 8,
    b"Hebrew_Letter" -> 9,
    b"ALetter" -> 10,
    b"Single_Quote" -> 11,
    b"Double_Quote" -> 12,
    b"MidNumLet" -> 13,
    b"MidLetter" -> 14,
    b"MidNum" -> 15,
    b"Numeric" -> 16,
    b"ExtendNumLet" -> 17,
    b"WSegSpace" -> 18,
    _ -> panic(f"`{String::of_bytes_lossy(name)}` is not a Word_Break value"),
  }

fn word_at(number: Int) -> WordBreak =
  match number {
    1 -> WordCr,
    2 -> WordLf,
    3 -> Newline,
    4 -> WordExtend,
    5 -> WordZwj,
    6 -> WordRegionalIndicator,
    7 -> Format,
    8 -> Katakana,
    9 -> HebrewLetter,
    10 -> ALetter,
    11 -> SingleQuote,
    12 -> DoubleQuote,
    13 -> MidNumberLetter,
    14 -> MidLetter,
    15 -> MidNumber,
    16 -> Numeric,
    17 -> ExtendNumberLetter,
    18 -> WSegSpace,
    _ -> AnyWord,
  }

const extended_pictographic_flag: Int = 0x200

const conjunct_consonant: Int = 0x400

const conjunct_extend: Int = 0x800

const conjunct_linker: Int = 0x1000

fn flag(letter: Int) -> Int / {abort.raise} =
  match letter {
    b'P' -> extended_pictographic_flag,
    b'C' -> conjunct_consonant,
    b'E' -> conjunct_extend,
    b'L' -> conjunct_linker,
    _ ->
      panic(
        "a grapheme break flag letter must be P, C, E or L (extended pictographic, conjunct consonant, conjunct extend or conjunct linker)",
      ),
  }

fn pack_break_properties(fields: List<Bytes>) -> Int / {abort.raise} = {
  let field = |i: Int| match fields.at(i) { Some(text) -> text, None -> b"" };
  range(0, field(2).len()).fold(
    grapheme_number(field(0)) | word_number(field(1)) << 4,
    |bits: Int, i: Int| bits | flag(field(2).at(i)),
  )
}

const breaks: Table = ucd::table(embed("ucd/breaks.txt"), 0, pack_break_properties)

fn break_properties(text: String) -> List<Int> = {
  let break_table = breaks;
  text.chars().map(|c: Char| ucd::lookup(break_table, Int::of_char(c)))
}

type ClusterState = { last: GraphemeBreak, odd: Bool, joining: Int, indic_conjunct_progress: Int }

fn is_break(g: GraphemeBreak) -> Bool = g == Control || g == Cr || g == Lf

fn cluster_ends(seen: ClusterState, properties: Int) -> Bool = {
  let next = grapheme_at(properties & 15);
  if seen.last == Cr && next == Lf { false }
  else if is_break(seen.last) || is_break(next) { true }
  else if seen.last == Leading
      && (next == Leading || next == Vowel || next == LvSyllable || next == LvtSyllable) { false }
  else if (seen.last == LvSyllable || seen.last == Vowel) && (next == Vowel || next == Trailing) {
    false
  } else if (seen.last == LvtSyllable || seen.last == Trailing) && next == Trailing { false }
  else if next == Extend || next == Zwj || next == SpacingMark || seen.last == Prepend { false }
  else if seen.indic_conjunct_progress == 2 && properties & conjunct_consonant != 0 { false }
  else if seen.joining == 2 && properties & extended_pictographic_flag != 0 { false }
  else { !(seen.last == RegionalIndicator && next == RegionalIndicator && seen.odd) }
}

fn advance_cluster(seen: ClusterState, properties: Int) -> ClusterState = {
  let next = grapheme_at(properties & 15);
  {
    last: next,
    odd: next == RegionalIndicator && !(seen.last == RegionalIndicator && seen.odd),
    joining: if properties & extended_pictographic_flag != 0 { 1 }
    else if seen.joining == 1 && next == Extend { 1 }
    else if seen.joining == 1 && next == Zwj { 2 }
    else { 0 },
    indic_conjunct_progress: if properties & conjunct_consonant != 0 { 1 }
    else if seen.indic_conjunct_progress > 0 && properties & conjunct_linker != 0 { 2 }
    else if seen.indic_conjunct_progress > 0 && properties & conjunct_extend != 0 {
      seen.indic_conjunct_progress
    } else { 0 },
  }
}

type ClusterScan = { at: List<Int>, place: Int, seen: ClusterState }

/// The grapheme cluster boundaries of `text`, in increasing order. Each is a position, counted in
/// characters, where one extended grapheme cluster ends and the next begins. The start and the end
/// of the text are included. The empty text has none.
pub fn grapheme_boundaries(text: String) -> List<Int> = {
  let cut = break_properties(text).fold(
    {
      at: [],
      place: 0,
      seen: { last: AnyGrapheme, odd: false, joining: 0, indic_conjunct_progress: 0 },
    },
    |so_far: ClusterScan, properties: Int|
      {
        at: if so_far.place == 0 || cluster_ends(so_far.seen, properties) {
          so_far.at.push(so_far.place)
        } else { so_far.at },
        place: so_far.place + 1,
        seen: advance_cluster(so_far.seen, properties),
      },
  );
  if cut.place == 0 { [] } else { cut.at.push(cut.place) }
}

fn pieces(text: String, boundaries: List<Int>) -> List<String> = {
  let chars = Array::of_list(text.chars());
  match boundaries {
    [] -> [],
    [first, ..rest] ->
      rest.fold(
        { out: [], from: first },
        |so_far: { out: List<String>, from: Int }, to: Int|
          {
            out: so_far.out.push(
              String::of_chars(
                range(so_far.from, to).fold([], |piece: List<Char>, i: Int|
                  match chars.at(i) { Some(c) -> piece.push(c), None -> piece }),
              ),
            ),
            from: to,
          },
      ).out,
  }
}

/// The extended grapheme clusters of `text`, in order: what a reader sees as its characters.
/// Joined, they are the text.
pub fn graphemes(text: String) -> List<String> = pieces(text, grapheme_boundaries(text))

/// The number of extended grapheme clusters in `text`: its length as a reader counts it.
pub fn grapheme_count(text: String) -> Int = {
  let boundaries = grapheme_boundaries(text);
  if boundaries.len() == 0 { 0 } else { boundaries.len() - 1 }
}

fn is_newline(w: WordBreak) -> Bool = w == Newline || w == WordCr || w == WordLf

fn is_ignored(w: WordBreak) -> Bool = w == WordExtend || w == Format || w == WordZwj

fn is_letter(w: WordBreak) -> Bool = w == ALetter || w == HebrewLetter

fn is_mid_letter(w: WordBreak) -> Bool = w == MidLetter || w == MidNumberLetter || w == SingleQuote

fn is_mid_number(w: WordBreak) -> Bool = w == MidNumber || w == MidNumberLetter || w == SingleQuote

fn following(words: Array<Int>, i: Int) -> WordBreak =
  match words.at(i) {
    None -> AnyWord,
    Some(properties) -> {
      let class = word_at(properties >> 4 & 31);
      if is_ignored(class) { following(words, i + 1) } else { class }
    },
  }

type WordState = { raw: WordBreak, last: WordBreak, before: WordBreak, odd: Bool }

fn word_ends(seen: WordState, words: Array<Int>, i: Int, properties: Int) -> Bool = {
  let next = word_at(properties >> 4 & 31);
  if seen.raw == WordCr && next == WordLf { false }
  else if is_newline(seen.raw) || is_newline(next) { true }
  else if seen.raw == WordZwj && properties & extended_pictographic_flag != 0 { false }
  else if seen.raw == WSegSpace && next == WSegSpace { false }
  else if is_ignored(next) { false }
  else { ends_by_letters(seen, next, following(words, i + 1)) }
}

fn ends_by_letters(seen: WordState, next: WordBreak, after: WordBreak) -> Bool =
  if is_letter(seen.last) && is_letter(next) { false }
  else if is_letter(seen.last) && is_mid_letter(next) && is_letter(after) { false }
  else if is_letter(seen.before) && is_mid_letter(seen.last) && is_letter(next) { false }
  else if seen.last == HebrewLetter && next == SingleQuote { false }
  else if seen.last == HebrewLetter && next == DoubleQuote && after == HebrewLetter { false }
  else if seen.before == HebrewLetter && seen.last == DoubleQuote && next == HebrewLetter { false }
  else { ends_among_numbers(seen, next, after) }

fn ends_among_numbers(seen: WordState, next: WordBreak, after: WordBreak) -> Bool = {
  let joins = |w: WordBreak| is_letter(w) || w == Numeric || w == Katakana;
  if seen.last == Numeric && (next == Numeric || is_letter(next)) { false }
  else if is_letter(seen.last) && next == Numeric { false }
  else if seen.before == Numeric && is_mid_number(seen.last) && next == Numeric { false }
  else if seen.last == Numeric && is_mid_number(next) && after == Numeric { false }
  else if seen.last == Katakana && next == Katakana { false }
  else if (joins(seen.last) || seen.last == ExtendNumberLetter) && next == ExtendNumberLetter {
    false
  } else if seen.last == ExtendNumberLetter && joins(next) { false }
  else { !(seen.last == WordRegionalIndicator && next == WordRegionalIndicator && seen.odd) }
}

fn advance_word(seen: WordState, next: WordBreak, opens: Bool) -> WordState =
  if is_ignored(next) && !opens {
    { raw: next, last: seen.last, before: seen.before, odd: seen.odd }
  } else {
    {
      raw: next,
      last: next,
      before: seen.last,
      odd: next == WordRegionalIndicator && !(seen.last == WordRegionalIndicator && seen.odd),
    }
  }

type WordScan = { at: List<Int>, place: Int, seen: WordState }

/// The word boundaries of `text`, in increasing order. Each is a position, counted in characters,
/// where the default word segmentation of UAX #29 allows a break. The start and the end of the
/// text are included. The empty text has none.
pub fn word_boundaries(text: String) -> List<Int> = {
  let words = Array::of_list(break_properties(text));
  let cut = range(0, words.len()).fold(
    { at: [], place: 0, seen: { raw: AnyWord, last: AnyWord, before: AnyWord, odd: false } },
    |so_far: WordScan, i: Int|
      match words.at(i) {
        None -> so_far,
        Some(properties) -> {
          let opens = i == 0 || is_newline(so_far.seen.raw);
          {
            at: if i == 0 || word_ends(so_far.seen, words, i, properties) { so_far.at.push(i) }
            else { so_far.at },
            place: i + 1,
            seen: advance_word(so_far.seen, word_at(properties >> 4 & 31), opens),
          }
        },
      },
  );
  if cut.place == 0 { [] } else { cut.at.push(cut.place) }
}

/// The segments of `text` between its word boundaries, in order: words, and between them the
/// spaces and punctuation, each a segment or several. Joined, they are the text.
pub fn split_words(text: String) -> List<String> = pieces(text, word_boundaries(text))

/// The words of `text`, in order: the segments from `split_words` that contain a letter or a
/// number, without what lies between them.
pub fn words(text: String) -> List<String> =
  split_words(text).filter(|segment: String| segment.chars().any(Char::is_alphanumeric))

test "joining a text's grapheme clusters gives the text, and joining its word segments also gives the text" {
  gen::check(gen::any_int(), |seed: Int| {
    let text = sample_text(seed);
    let joined = |segments: List<String>| segments.fold("", |all: String, s: String| all ++ s);
    joined(graphemes(text)) == text && joined(split_words(text)) == text
  })
}

test "a text has as many clusters as grapheme_count returns" {
  gen::check(gen::any_int(), |x: Int|
    agrees(
      |seed: Int| grapheme_count(sample_text(seed)),
      |seed: Int| graphemes(sample_text(seed)).len(),
      x,
    ))
}

test "`graphemes` keeps a letter with its combining marks, a Hangul syllable's jamo letters, and `\r\n` together as one cluster" {
  assert_eq(graphemes("e\u{301}a"), ["e\u{301}", "a"]);
  assert_eq(graphemes("\u{1100}\u{1161}\u{11A8}\u{AC00}"), [
    "\u{1100}\u{1161}\u{11A8}",
    "\u{AC00}",
  ]);
  assert_eq(graphemes("a\r\nb"), ["a", "\r\n", "b"]);
  assert_eq(graphemes("\n\u{301}"), ["\n", "\u{301}"]);
  assert_eq(graphemes("\u{915}\u{94D}\u{937}\u{93F}"), ["\u{915}\u{94D}\u{937}\u{93F}"]);
  assert_eq(graphemes("\u{915}\u{937}"), ["\u{915}", "\u{937}"]);
  assert_eq(graphemes(""), []);
  assert_eq(grapheme_boundaries("e\u{301}a"), [0, 2, 3]);
  assert_eq(grapheme_boundaries(""), []);
  assert_eq(grapheme_count("e\u{301}a"), 2);
  assert_eq(grapheme_count(""), 0)
}

test "an emoji sequence joined with zero-width joiners, an emoji with a skin-tone modifier and a flag pair are each one cluster" {
  assert_eq(graphemes("\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}!"), [
    "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}",
    "!",
  ]);
  assert_eq(graphemes("\u{1F44D}\u{1F3FD}"), ["\u{1F44D}\u{1F3FD}"]);
  assert_eq(graphemes("\u{2764}\u{FE0F}x"), ["\u{2764}\u{FE0F}", "x"]);
  assert_eq(graphemes("\u{1F1E9}\u{1F1EA}\u{1F1EB}\u{1F1F7}"), [
    "\u{1F1E9}\u{1F1EA}",
    "\u{1F1EB}\u{1F1F7}",
  ]);
  assert_eq(graphemes("\u{1F1E9}\u{1F1EA}\u{1F1EB}"), ["\u{1F1E9}\u{1F1EA}", "\u{1F1EB}"]);
  assert_eq(graphemes("a\u{200D}\u{1F469}"), ["a\u{200D}", "\u{1F469}"])
}

test "`split_words` keeps apostrophes and decimal points inside words, and returns spaces and punctuation as separate segments" {
  assert_eq(split_words("can't stop"), ["can't", " ", "stop"]);
  assert_eq(split_words("3.14, 1,000"), ["3.14", ",", " ", "1,000"]);
  assert_eq(split_words("a.b a. b"), ["a.b", " ", "a", ".", " ", "b"]);
  assert_eq(split_words("snake_case x1"), ["snake_case", " ", "x1"]);
  assert_eq(split_words("a  b\r\nc"), ["a", "  ", "b", "\r\n", "c"]);
  assert_eq(words("Hello, wor\u{301}ld! 42"), ["Hello", "wor\u{301}ld", "42"]);
  assert_eq(words("\u{4E2D}\u{6587}"), ["\u{4E2D}", "\u{6587}"]);
  assert_eq(words(" ... "), []);
  assert_eq(word_boundaries("can't stop"), [0, 5, 6, 10]);
  assert_eq(word_boundaries(""), [])
}
