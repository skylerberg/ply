//! Declares a program's command line as one `Spec` that describes its commands, flags and
//! positionals. The parser, error messages, help, completion scripts and manual page are all
//! computed from the `Spec`, so they cannot disagree with each other.
//!
//! `parse` reads a list of words and performs no effects. The words are a parameter, the settings
//! that flags fall back to are passed in, and the result is a value the caller acts on: a run, a
//! request for help or the version, or an `Error` naming the argument and the reason.
//!
//! The grammar is the usual one for command-line programs: `--flag=value` and `--flag value`; short
//! flags that are attached, spaced or combined (`-vvj4`); `--no-flag` for a switch declared
//! negatable; `--` to end the flags; commands nested under commands, where a flag may be written at
//! the level that declares it or at any level below; trailing arguments collected into a list; and
//! `--help`, `help` and `--version` at any level. A word that starts with `-` is never taken as a
//! value or a positional. To pass a negative number, write `--offset=-3` or put it after `--`.
//!
//! A flag's value is typed where the flag is declared. An `Arg` pairs a flag with the `Codec` that
//! reads its value. The parser rejects what the codec rejects, with the codec's reason, and `get`
//! returns what the codec read. A program's decoder can therefore build its own record from a
//! `Parsed` command line, and `parse_with` returns that record instead of a table of strings. A
//! flag that is not written takes the value of its setting if one is passed in, and otherwise its
//! default. So the command line wins over the setting, and the setting wins over the default.
//! `settings` queries `std.config` for each setting, which reads `--set`, then `--config` files,
//! then the environment.
//!
//! A positional is a plain word that the program's decoder reads as it likes. An `Err` from the
//! decoder is reported like one of the parser's own errors. `reply` returns what a program prints
//! for a command line that does not run: help and the version go to the output stream with exit
//! code 0, and an error goes to the error stream with exit code 2.
//!
//! `faults` lists mistakes in a declaration that can be found before any command line is read, such
//! as a `requires` that names no flag. `arguments` writes a parsed command line back as words that
//! parse to the same result. `completion` writes the script that completes the command line in
//! bash, zsh or fish, `man_page` writes a command's manual page, and `description` writes the
//! declaration as JSON.

import std.config
import std.config (config)
import std.fmt (parse_size)
import std.json
import std.json (Json)
import std.list (enumerate, prepend)
import std.laws (round_trip)
import std.result
import std.show (show)
import std.string
import std.text
import std.text (closest, table, wrap)
import std.time
import std.time (parse_duration, render_duration)
import std.unicode
import std.gen

/// Describes what values a flag accepts. A `Switch` takes no value. `Nat` accepts zero or more,
/// `Positive` accepts one or more, and `Choice` accepts one of the words in its list. Any other
/// restriction is the flag's `check` function, which the `Codec` of an `Arg` supplies.
pub type Kind = | Switch | Text | Nat | Positive | Choice(List<String>)

/// One flag a command reads.
pub type Flag = new {
  /// Its name, written after `--`.
  long: String,
  /// Its letter, written after `-`, or "" for none.
  short: String,
  kind: Kind,
  /// What the help calls its value, as `N` in `--jobs <N>`.
  value_name: String,
  /// Its value when the line leaves it off, or "" for none.
  default: String,
  help: String,
  /// Whether the flag may be written more than once. A flag with a value then collects all its
  /// values in a list, and a switch counts how many times it is written.
  repeatable: Bool,
  /// The value a valued flag takes when written with no value; "" means a value is required.
  bare_value: String,
  /// The long names that must be written with it.
  requires: List<String>,
  /// The long names of the flags that cannot be written on the same line as this flag.
  conflicts: List<String>,
  /// Checks a value beyond what the flag's kind already checks: returns `Err` with the reason when
  /// the value is not one this flag accepts.
  check: (String) -> Result<Unit, String> / {abort.raise},
  /// Whether a switch may also be written `--no-<long>`, with the later occurrence winning.
  negatable: Bool,
  /// The configuration key whose value is used when the line leaves the flag off, or "" for none.
  setting: String,
}

/// The check that accepts every value.
pub fn ok_any(_: String) -> Result<Unit, String> = Ok(())

/// A flag that is either present or absent.
pub fn switch(long: String, help: String) -> Flag =
  {
    long: long,
    short: "",
    kind: Switch,
    value_name: "",
    default: "",
    help: help,
    repeatable: false,
    bare_value: "",
    requires: [],
    conflicts: [],
    check: ok_any,
    negatable: false,
    setting: "",
  }

/// A flag that takes a value of `kind`, called `value_name` in the help.
pub fn valued(long: String, value_name: String, kind: Kind, help: String) -> Flag = {
  let base: Flag = switch(long, help);
  { ..base, kind: kind, value_name: value_name }
}

/// A bare word a command takes.
pub type Positional = new {
  name: String,
  help: String,
  /// The value this positional takes when the line omits it, or "" for none.
  default: String,
  required: Bool,
  /// Whether it takes every remaining word.
  many: Bool,
  /// The long name of a flag whose presence makes it optional, or "" for none.
  unless: String,
}

/// A positional the line must include.
pub fn positional(name: String, help: String) -> Positional =
  { name: name, help: help, default: "", required: true, many: false, unless: "" }

/// A positional that takes `default` when the line leaves it off.
pub fn defaulted(name: String, help: String, default: String) -> Positional = {
  let base: Positional = positional(name, help);
  { ..base, default: default, required: false }
}

/// `flag`, also written `-<short>`.
pub fn with_short(flag: Flag, short: String) -> Flag = { ..flag, short: short }

/// `flag`, taking `default` when the line leaves it off.
pub fn with_default(flag: Flag, default: String) -> Flag = { ..flag, default: default }

/// `flag`, keeping every occurrence: a valued flag collects its values in order, and a switch is
/// counted, so `-vvv` is three.
pub fn repeated(flag: Flag) -> Flag = { ..flag, repeatable: true }

/// The value the flag takes when written with no value: `--show` is `--show=*`.
pub fn with_bare_value(flag: Flag, value: String) -> Flag = { ..flag, bare_value: value }

/// `flag`, rejected unless each of `longs` is also written.
pub fn requiring(flag: Flag, longs: List<String>) -> Flag = { ..flag, requires: longs }

/// `flag`, rejected when any of `longs` is also written.
pub fn conflicting(flag: Flag, longs: List<String>) -> Flag = { ..flag, conflicts: longs }

/// `flag`, with `check` deciding which values it accepts.
pub fn with_check(
  flag: Flag,
  check: keep (String) -> Result<Unit, String> / {abort.raise},
) -> Flag = { ..flag, check: check }

/// Returns `flag` as a switch that may also be written `--no-<long>`; the later occurrence wins.
/// `chosen` returns `Some(true)` if the switch was written, `Some(false)` if it was negated, and
/// `None` if neither.
pub fn negatable(flag: Flag) -> Flag = { ..flag, negatable: true }

/// `flag`, taking the value of the configuration key `setting` when the line leaves it off and the
/// settings passed to `parse` contain the key. For a switch the value is `true` or `false`.
pub fn with_setting(flag: Flag, setting: String) -> Flag = { ..flag, setting: setting }

/// One word of the line: a command. A record cannot contain itself, so the body is a variant's
/// payload.
pub type Command = | CommandBody(Body)

/// The definition of a command: its name, help text, flags, positionals, subcommands and extra
/// check.
pub type Body = new {
  name: String,
  about: String,
  /// The flags read at this command and at every command under it.
  flags: List<Flag>,
  positionals: List<Positional>,
  /// The commands under it; a command that has any is not run itself.
  subs: List<Command>,
  /// Whether the words after `--` are the program's own argument vector.
  trailing: Bool,
  /// A cross-check no per-flag rule can express, such as one flag against another flag's value:
  /// `Err` with what the line gets wrong.
  extra: (Parsed) -> Result<Unit, String> / {abort.raise},
}

/// Returns the `Body` that `command` wraps.
pub fn body(command: Command) -> Body = match command { CommandBody(b) -> b }

/// The cross-check that accepts every line.
pub fn ok_command(_: Parsed) -> Result<Unit, String> = Ok(())

/// A command that reads `flags` and nothing else.
pub fn command(name: String, about: String, flags: List<Flag>) -> Command =
  CommandBody({
    name: name,
    about: about,
    flags: flags,
    positionals: [],
    subs: [],
    trailing: false,
    extra: ok_command,
  })

/// `command`, taking these bare words in order.
pub fn with_positionals(command: Command, positionals: List<Positional>) -> Command = {
  let base: Body = body(command);
  CommandBody({ ..base, positionals: positionals })
}

/// `command`, with these commands under it.
pub fn with_subs(command: Command, subs: List<Command>) -> Command = {
  let base: Body = body(command);
  CommandBody({ ..base, subs: subs })
}

/// `command`, with the words after `--` passed on as the program's own argument vector.
pub fn with_trailing(command: Command) -> Command = {
  let base: Body = body(command);
  CommandBody({ ..base, trailing: true })
}

/// `command`, with `extra` checking each line that passed every other rule.
pub fn with_extra(
  command: Command,
  extra: keep (Parsed) -> Result<Unit, String> / {abort.raise},
) -> Command = {
  let base: Body = body(command);
  CommandBody({ ..base, extra: extra })
}

/// A positional made optional by a flag: a code is required unless `--all` is written.
pub fn required_unless(p: Positional, long: String) -> Positional = { ..p, unless: long }

/// A positional that takes every remaining word.
pub fn many(p: Positional) -> Positional = { ..p, many: true }

/// Describes a whole program: its binary name, its version and its root command. The root's `subs`
/// are the program's commands, and its `flags` are read by every command.
pub type Spec = new { bin: String, version: String, root: Command }

/// One flag as it appears in a parsed line: its long name, and the value if it takes one. A
/// negated switch is stored under `no-<long>`.
pub type Given = new { long: String, value: Option<String> }

/// The result of successfully parsing one line.
pub type Parsed = new {
  /// The command words, as `["cache", "stats"]`.
  path: List<String>,
  /// Every flag written, in the order written, then each flag supplied by a configuration setting,
  /// then each valued flag of the matched command that was omitted, with its default. Omitted flags
  /// of a parent command are not added, but `get` still returns their defaults.
  flags: List<Given>,
  /// The bare words, with defaults filled in for the ones left off.
  positionals: List<String>,
  /// What followed `--` under a trailing command.
  argv: List<String>,
}

/// Why a line was rejected.
pub type ErrorKind =
  /// A word starting with `-` that is not a flag the command reads, as written, and the closest
  /// long name if one differs by at most three single-character changes.
  | UnknownFlag(String, Option<String>)
  /// A word that names no command where one was expected, and the closest command name if one
  /// differs by at most three single-character changes.
  | UnknownCommand(String, Option<String>)
  /// A bare word no positional is left to take.
  | UnexpectedWord(String)
  /// A flag, by its long name, written with no value where it takes one.
  | MissingValue(String)
  /// A switch, as it was written, and the value it was given.
  | UnexpectedValue(String, String)
  /// A flag by its long name, the value written for it, and why the value is invalid: the reason
  /// given by the flag's kind or by its check.
  | InvalidValue(String, String, String)
  /// A flag by its long name, the value written for it, and the values it chooses among.
  | NotAChoice(String, String, List<String>)
  /// A configuration key, the long name of the flag it supplies, the key's value, and why the flag
  /// does not accept it.
  | InvalidSetting(String, String, String, String)
  /// A flag by its long name, and the long name of a flag it requires that was not written.
  | MissingRequired(String, String)
  /// A flag by its long name, and the long name written with it that it cannot be used with.
  | Conflict(String, String)
  /// The line ended where a command was expected: the commands it could have named.
  | MissingCommand(List<String>)
  /// The required positionals that were never written, by name.
  | MissingPositionals(List<String>)
  /// The message from the command's `extra` check or the program's decoder, which rejected the
  /// line.
  | Rejected(String)

/// An error: `path` holds the command words parsed so far, and `reason` says what went wrong.
pub type Error = new { path: List<String>, reason: ErrorKind }

/// The result of parsing one line: a run, which carries the parsed line or what a program's decoder
/// built from it; a request for the help of the command a path names; a request for the version;
/// or an error.
pub type Outcome<a> = | Run(a) | Help(List<String>) | Version | Failed(Error)

/// The body of the command a path of words names; the root is the empty path.
pub fn node_at(root: Command, path: List<String>) -> Option<Body> =
  match path {
    [] -> Some(body(root)),
    [first, ..rest] -> match scan_subs(body(root).subs, first) {
      Some(sub) -> node_at(sub, rest),
      None -> None,
    },
  }

fn scan_subs(subs: List<Command>, name: String) -> Option<Command> =
  match subs {
    [] -> None,
    [sub, ..rest] -> if body(sub).name == name { Some(sub) } else { scan_subs(rest, name) },
  }

fn node_or_root(root: Command, path: List<String>) -> Body =
  match node_at(root, path) { Some(node) -> node, None -> body(root) }

fn levels(root: Command, path: List<String>) -> List<Body> =
  match path {
    [] -> [body(root)],
    [first, ..rest] -> match scan_subs(body(root).subs, first) {
      Some(sub) -> prepend(body(root), levels(sub, rest)),
      None -> [body(root)],
    },
  }

/// Returns every flag the command at `path` accepts: its own flags first, then those of each
/// enclosing command, ending with the root's. A command's own flag is therefore found before an
/// enclosing flag with the same name.
pub fn flags_at(root: Command, path: List<String>) -> List<Flag> =
  levels(root, path).reverse().flat_map(|level: Body| level.flags)

fn scan_long(flags: List<Flag>, name: String) -> Option<Flag> =
  match flags {
    [] -> None,
    [f, ..rest] -> if f.long == name { Some(f) } else { scan_long(rest, name) },
  }

fn scan_short(flags: List<Flag>, letter: String) -> Option<Flag> =
  match flags {
    [] -> None,
    [f, ..rest] -> if f.short == letter { Some(f) } else { scan_short(rest, letter) },
  }

fn scan_negated(flags: List<Flag>, name: String) -> Option<Flag> =
  match flags {
    [] -> None,
    [f, ..rest] -> if f.negatable && name == negation(f.long) { Some(f) }
    else { scan_negated(rest, name) },
  }

fn negation(long: String) -> String = "no-" ++ long

fn flag_label(flag: Flag) -> String =
  if flag.kind == Switch { "--" ++ flag.long }
  else { "--" ++ flag.long ++ " <" ++ flag.value_name ++ ">" }

type StopReason = | Continue | ForHelp | ForVersion | ForArguments

type Reading = {
  path: List<String>,
  flags: List<Given>,
  positionals: List<String>,
  argv: List<String>,
  pending: Option<Flag>,
  after_separator: Bool,
  halt: StopReason,
}

fn empty_reading() -> Reading =
  {
    path: [],
    flags: [],
    positionals: [],
    argv: [],
    pending: None,
    after_separator: false,
    halt: Continue,
  }

fn is_flag_word(w: String) -> Bool = w.starts_with("-") && w != "-"

fn error_at(reading: Reading, reason: ErrorKind) -> Error = { path: reading.path, reason: reason }

/// The result of parsing the words `argv` under `spec`: the program's arguments, without its own
/// name. `settings` are the configuration values a flag left off the line may take; when a key
/// appears twice, the first wins. Every list of words gets a result: nothing here raises unless a
/// flag's `check` or a command's `extra` does.
pub fn parse(
  spec: Spec,
  argv: List<String>,
  settings: List<{ key: String, value: String }> = [],
) -> Outcome<Parsed> / {abort.raise} =
  match words(spec, settings, empty_reading(), argv) {
    Ok(outcome) -> outcome,
    Err(rejection) -> Failed(rejection),
  }

/// `parse`, with a run's line passed to `decode` to build the program's own value. An `Err` from
/// `decode` becomes an error at the command the line named.
pub fn parse_with<a>(
  spec: Spec,
  argv: List<String>,
  decode: (Parsed) -> Result<a, String> / {abort.raise},
  settings: List<{ key: String, value: String }> = [],
) -> Outcome<a> / {abort.raise} =
  match parse(spec, argv, settings) {
    Run(parsed) -> match decode(parsed) {
      Ok(x) -> Run(x),
      Err(reason) -> Failed({ path: parsed.path, reason: Rejected(reason) }),
    },
    Help(path) -> Help(path),
    Version -> Version,
    Failed(rejection) -> Failed(rejection),
  }

fn words(
  spec: Spec,
  settings: List<{ key: String, value: String }>,
  reading: Reading,
  argv: List<String>,
) -> Result<Outcome<Parsed>, Error> / {abort.raise} =
  if reading.halt != Continue { finish(spec, settings, reading) } else {
    match argv {
      [] -> finish(spec, settings, reading),
      [w, ..rest] -> words(spec, settings, word(spec, reading, w, rest)?, rest),
    }
  }

fn word(
  spec: Spec,
  reading: Reading,
  w: String,
  rest: List<String>,
) -> Result<Reading, Error> / {abort.raise} =
  match reading.pending {
    Some(f) -> if is_flag_word(w) {
      if f.bare_value == "" { Err(error_at(reading, MissingValue(f.long))) }
      else { flag_or_word(spec, record(reading, f, Some(f.bare_value)), w, rest) }
    } else { valued_as(reading, f, w) },
    None -> flag_or_word(spec, reading, w, rest),
  }

fn flag_or_word(
  spec: Spec,
  reading: Reading,
  w: String,
  rest: List<String>,
) -> Result<Reading, Error> / {abort.raise} = {
  let node = node_or_root(spec.root, reading.path);
  if reading.after_separator { Ok({ ..reading, positionals: reading.positionals.push(w) }) }
  else if w == "--" {
    if node.trailing { Ok({ ..reading, argv: rest, halt: ForArguments }) }
    else { Ok({ ..reading, after_separator: true }) }
  } else if w == "-h" || w == "--help" { Ok({ ..reading, halt: ForHelp }) }
  else if w == "-V" || w == "--version" { Ok({ ..reading, halt: ForVersion }) }
  else if w == "help" && node.subs.len() > 0 && reading.positionals.len() == 0 {
    help_path(spec, reading, rest)
  } else if w.starts_with("--") { long_flag(spec, reading, w) } else if is_flag_word(w) {
    short_flags(flags_at(spec.root, reading.path), reading, w.chars().drop(1))
  } else { bare_word(spec, node, reading, w) }
}

fn help_path(spec: Spec, reading: Reading, rest: List<String>) -> Result<Reading, Error> = {
  let path = reading.path.concat(rest);
  match node_at(spec.root, path) {
    Some(_) -> Ok({ ..reading, path: path, halt: ForHelp }),
    None -> match rest {
      [first, ..] ->
        Err(error_at(reading, UnknownCommand(first, near_sub(spec.root, reading.path, first)))),
      [] -> Ok({ ..reading, halt: ForHelp }),
    },
  }
}

fn long_flag(spec: Spec, reading: Reading, w: String) -> Result<Reading, Error> / {abort.raise} = {
  let written = w.slice(2, w.len());
  let cut = written.split_once("=");
  let name = match cut { Some(c) -> c.head, None -> written };
  let flags = flags_at(spec.root, reading.path);
  match scan_long(flags, name) {
    Some(f) -> match f.kind {
      Switch -> match cut {
        Some(c) -> Err(error_at(reading, UnexpectedValue("--" ++ f.long, c.tail))),
        None -> Ok(record(reading, f, None)),
      },
      _ -> match cut {
        Some(c) -> valued_as(reading, f, c.tail),
        None -> Ok({ ..reading, pending: Some(f) }),
      },
    },
    None -> match scan_negated(flags, name) {
      Some(f) -> match cut {
        Some(c) -> Err(error_at(reading, UnexpectedValue("--" ++ name, c.tail))),
        None ->
          Ok({
            ..reading,
            flags: without_flag(reading.flags, f).push({ long: name, value: None }),
          }),
      },
      None ->
        Err(
          error_at(
            reading,
            UnknownFlag("--" ++ name, closest(name, written_names(flags), max_typo_distance())),
          ),
        ),
    },
  }
}

fn short_flags(
  flags: List<Flag>,
  reading: Reading,
  letters: List<Char>,
) -> Result<Reading, Error> / {abort.raise} =
  match letters {
    [] -> Ok(reading),
    [c, ..rest] -> {
      let letter = String::of_chars([c]);
      match scan_short(flags, letter) {
        None -> Err(error_at(reading, UnknownFlag("-" ++ letter, None))),
        Some(f) -> if f.kind == Switch {
          match rest {
            ['=', ..value] ->
              Err(error_at(reading, UnexpectedValue("-" ++ letter, String::of_chars(value)))),
            _ -> short_flags(flags, record(reading, f, None), rest),
          }
        } else {
          match rest {
            [] -> Ok({ ..reading, pending: Some(f) }),
            ['=', ..value] -> valued_as(reading, f, String::of_chars(value)),
            _ -> valued_as(reading, f, String::of_chars(rest)),
          }
        },
      }
    },
  }

fn bare_word(spec: Spec, node: Body, reading: Reading, w: String) -> Result<Reading, Error> =
  match scan_subs(node.subs, w) {
    Some(sub) -> if reading.positionals.len() == 0 {
      Ok({ ..reading, path: reading.path.push(body(sub).name) })
    } else { Err(error_at(reading, UnexpectedWord(w))) },
    None -> if room_for_positional(node, reading) {
      Ok({ ..reading, positionals: reading.positionals.push(w) })
    } else if node.subs.len() > 0 && reading.positionals.len() == 0 {
      Err(error_at(reading, UnknownCommand(w, near_sub(spec.root, reading.path, w))))
    } else { Err(error_at(reading, UnexpectedWord(w))) },
  }

fn room_for_positional(node: Body, reading: Reading) -> Bool =
  is_many(node) || reading.positionals.len() < node.positionals.len()

fn is_many(node: Body) -> Bool =
  match node.positionals.at(node.positionals.len() - 1) { Some(last) -> last.many, None -> false }

fn valued_as(
  reading: Reading,
  flag: Flag,
  value: String,
) -> Result<Reading, Error> / {abort.raise} =
  match bad_value(flag, value) {
    Some(reason) -> Err(error_at(reading, reason)),
    None -> Ok(record(reading, flag, Some(value))),
  }

fn record(reading: Reading, flag: Flag, value: Option<String>) -> Reading =
  { ..reading, flags: record_flag(reading.flags, flag, value), pending: None }

fn record_flag(flags: List<Given>, flag: Flag, value: Option<String>) -> List<Given> =
  if flag.repeatable { flags.push({ long: flag.long, value: value }) }
  else { without_flag(flags, flag).push({ long: flag.long, value: value }) }

fn without_flag(flags: List<Given>, flag: Flag) -> List<Given> =
  if flag.negatable { drop_flag(drop_flag(flags, flag.long), negation(flag.long)) }
  else { drop_flag(flags, flag.long) }

fn drop_flag(flags: List<Given>, long: String) -> List<Given> =
  match flags {
    [] -> [],
    [g, ..rest] -> if g.long == long { rest } else { prepend(g, drop_flag(rest, long)) },
  }

fn has_flag(flags: List<Given>, long: String) -> Bool =
  match flags { [] -> false, [g, ..rest] -> g.long == long || has_flag(rest, long) }

fn bad_value(flag: Flag, value: String) -> Option<ErrorKind> / {abort.raise} =
  match flag.kind {
    Switch -> None,
    Text -> checked(flag, value),
    Nat -> match parse_nat(value) {
      Some(_) -> checked(flag, value),
      None -> Some(InvalidValue(flag.long, value, "a number is required")),
    },
    Positive -> match parse_nat(value) {
      Some(n) -> if n >= 1 { checked(flag, value) }
      else { Some(InvalidValue(flag.long, value, "a number of 1 or more is required")) },
      None -> Some(InvalidValue(flag.long, value, "a number is required")),
    },
    Choice(choices) -> if choices.contains(value) { checked(flag, value) }
    else { Some(NotAChoice(flag.long, value, choices)) },
  }

fn checked(flag: Flag, value: String) -> Option<ErrorKind> / {abort.raise} =
  match (flag.check)(value) {
    Ok(_) -> None,
    Err(reason) -> Some(InvalidValue(flag.long, value, reason)),
  }

/// A non-negative decimal integer; `None` for anything else, including one past `Int`'s top.
pub fn parse_nat(text: String) -> Option<Int> / {abort.raise} =
  if text.starts_with("-") { None } else { text.int_of_string() }

fn finish(
  spec: Spec,
  settings: List<{ key: String, value: String }>,
  reading: Reading,
) -> Result<Outcome<Parsed>, Error> / {abort.raise} =
  match reading.halt {
    ForHelp -> Ok(Help(reading.path)),
    ForVersion -> Ok(Version),
    _ -> match reading.pending {
      Some(f) -> if f.bare_value == "" { Err(error_at(reading, MissingValue(f.long))) }
      else { finish_run(spec, settings, record(reading, f, Some(f.bare_value))) },
      None -> finish_run(spec, settings, reading),
    },
  }

fn finish_run(
  spec: Spec,
  settings: List<{ key: String, value: String }>,
  reading: Reading,
) -> Result<Outcome<Parsed>, Error> / {abort.raise} = {
  let node = node_or_root(spec.root, reading.path);
  if node.subs.len() > 0 {
    Err(error_at(reading, MissingCommand(node.subs.map(|s: Command| body(s).name))))
  } else { validate(spec, settings, node, reading) }
}

fn validate(
  spec: Spec,
  settings: List<{ key: String, value: String }>,
  node: Body,
  reading: Reading,
) -> Result<Outcome<Parsed>, Error> / {abort.raise} = {
  let flags = flags_at(spec.root, reading.path);
  let parsed: Parsed = {
    path: reading.path,
    flags: reading.flags,
    positionals: fill_defaults(node, reading.positionals),
    argv: reading.argv,
  };
  match broken_rule(flags, node, reading) {
    Some(reason) -> Err(error_at(reading, reason)),
    None -> match (node.extra)(parsed) {
      Err(reason) -> Err(error_at(reading, Rejected(reason))),
      Ok(_) -> match apply_settings(flags, settings, reading.flags) {
        Err(reason) -> Err(error_at(reading, reason)),
        Ok(given) -> Ok(Run({ ..parsed, flags: fill_flag_defaults(node, given) })),
      },
    },
  }
}

fn broken_rule(flags: List<Flag>, node: Body, reading: Reading) -> Option<ErrorKind> =
  first_some([
    unmet_requirement(flags, reading.flags),
    conflict_of(flags, reading.flags),
    missing_positional(node, reading),
    excess_positional(node, reading),
  ])

fn first_some(found: List<Option<ErrorKind>>) -> Option<ErrorKind> =
  match found {
    [] -> None,
    [first, ..rest] -> match first { Some(reason) -> Some(reason), None -> first_some(rest) },
  }

fn unmet_requirement(flags: List<Flag>, given: List<Given>) -> Option<ErrorKind> =
  first_some(
    flags.map(|flag: Flag|
      if has_flag(given, flag.long) {
        match flag.requires.find(|request: String| !has_flag(given, request)) {
          Some(request) -> Some(MissingRequired(flag.long, request)),
          None -> None,
        }
      } else { None }),
  )

fn conflict_of(flags: List<Flag>, given: List<Given>) -> Option<ErrorKind> =
  first_some(
    flags.map(|flag: Flag|
      if has_flag(given, flag.long) {
        match flag.conflicts.find(|other: String| has_flag(given, other)) {
          Some(other) -> Some(Conflict(flag.long, other)),
          None -> None,
        }
      } else { None }),
  )

fn missing_positional(node: Body, reading: Reading) -> Option<ErrorKind> = {
  let missing = enumerate(node.positionals).filter(|p: { index: Int, value: Positional }|
    p.value.required && reading.positionals.len() <= p.index
      && !(p.value.unless != "" && has_flag(reading.flags, p.value.unless)));
  if missing.len() == 0 { None } else {
    Some(MissingPositionals(missing.map(|p: { index: Int, value: Positional }| p.value.name)))
  }
}

fn excess_positional(node: Body, reading: Reading) -> Option<ErrorKind> =
  if is_many(node) { None } else {
    match reading.positionals.at(node.positionals.len()) {
      Some(extra) -> Some(UnexpectedWord(extra)),
      None -> None,
    }
  }

fn fill_defaults(node: Body, given: List<String>) -> List<String> =
  if is_many(node) {
    if given.len() > 0 { given } else {
      match node.positionals.at(node.positionals.len() - 1) {
        Some(last) -> if last.default != "" { [last.default] } else { given },
        None -> given,
      }
    }
  } else {
    range(given.len(), node.positionals.len()).fold(
      { out: given, open: true },
      |s: { out: List<String>, open: Bool }, i: Int|
        if !s.open { s } else {
          match node.positionals.at(i) {
            Some(p) -> if p.default != "" { { out: s.out.push(p.default), open: true } }
            else { { ..s, open: false } },
            None -> { ..s, open: false },
          }
        },
    ).out
  }

fn apply_settings(
  flags: List<Flag>,
  settings: List<{ key: String, value: String }>,
  given: List<Given>,
) -> Result<List<Given>, ErrorKind> / {abort.raise} =
  flags.fold(Ok(given), |accumulator: Result<List<Given>, ErrorKind>, flag: Flag|
    match accumulator {
      Err(reason) -> Err(reason),
      Ok(collected) -> match setting_of(flag, settings, collected) {
        None -> Ok(collected),
        Some(text) -> match flags_from_setting(flag, text) {
          Ok(more) -> Ok(collected.concat(more)),
          Err(reason) -> Err(reason),
        },
      },
    })

fn setting_of(
  flag: Flag,
  settings: List<{ key: String, value: String }>,
  given: List<Given>,
) -> Option<String> =
  if flag.setting == "" || has_flag(given, flag.long) || has_flag(given, negation(flag.long)) {
    None
  } else {
    match settings.find(|s: { key: String, value: String }| s.key == flag.setting) {
      Some(s) -> Some(s.value),
      None -> None,
    }
  }

fn flags_from_setting(flag: Flag, text: String) -> Result<List<Given>, ErrorKind> / {abort.raise} =
  if flag.kind == Switch {
    if text == "true" { Ok([{ long: flag.long, value: None }]) } else if text == "false" {
      Ok(if flag.negatable { [{ long: negation(flag.long), value: None }] } else { [] })
    } else { Err(InvalidSetting(flag.setting, flag.long, text, "`true` or `false` is required")) }
  } else {
    match bad_value(flag, text) {
      None -> Ok([{ long: flag.long, value: Some(text) }]),
      Some(InvalidValue(_, _, reason)) ->
        Err(InvalidSetting(flag.setting, flag.long, text, reason)),
      Some(NotAChoice(_, _, choices)) ->
        Err(
          InvalidSetting(
            flag.setting,
            flag.long,
            text,
            "not one of " ++ String::join(choices, ", "),
          ),
        ),
      Some(reason) -> Err(reason),
    }
  }

fn fill_flag_defaults(node: Body, given: List<Given>) -> List<Given> =
  node.flags.fold(given, |accumulator: List<Given>, flag: Flag|
    if flag.default != "" && !has_flag(given, flag.long) {
      accumulator.push({ long: flag.long, value: Some(flag.default) })
    } else { accumulator })

fn max_typo_distance() -> Int = 3

fn written_names(flags: List<Flag>) -> List<String> =
  flags.flat_map(|flag: Flag|
    if flag.negatable { [flag.long, negation(flag.long)] } else { [flag.long] })

fn near_sub(root: Command, path: List<String>, name: String) -> Option<String> =
  match node_at(root, path) {
    Some(node) -> closest(name, node.subs.map(|s: Command| body(s).name), max_typo_distance()),
    None -> None,
  }

/// An error's message, without the usage around it.
pub fn error_message(spec: Spec, rejection: Error) -> String =
  match rejection.reason {
    UnknownFlag(written, near) ->
      "unexpected argument '" ++ written ++ "' found"
        ++ (match near {
          Some(long) -> "\n\n  tip: a similar argument exists: '--" ++ long ++ "'",
          None -> "",
        }),
    UnknownCommand(written, near) ->
      "unrecognized subcommand '" ++ written ++ "'"
        ++ (match near {
          Some(name) -> "\n\n  tip: a similar subcommand exists: '" ++ name ++ "'",
          None -> "",
        }),
    UnexpectedWord(written) -> "unexpected argument '" ++ written ++ "' found",
    MissingValue(long) ->
      "a value is required for '" ++ name_at(spec, rejection.path, long)
        ++ "' but none was supplied",
    UnexpectedValue(written, value) ->
      "unexpected value '" ++ value ++ "' for '" ++ written ++ "' found",
    InvalidValue(long, value, reason) ->
      "invalid value '" ++ value ++ "' for '" ++ name_at(spec, rejection.path, long) ++ "': "
        ++ reason,
    NotAChoice(long, value, choices) ->
      "invalid value '" ++ value ++ "' for '" ++ name_at(spec, rejection.path, long)
        ++ "'\n  [possible values: "
        ++ String::join(choices, ", ")
        ++ "]",
    InvalidSetting(key, long, value, reason) ->
      "invalid value '" ++ value ++ "' for '" ++ name_at(spec, rejection.path, long)
        ++ "' from the setting `"
        ++ key
        ++ "`: "
        ++ reason,
    MissingRequired(long, required) ->
      "the argument '" ++ name_at(spec, rejection.path, long) ++ "' requires '--" ++ required
        ++ "'",
    Conflict(long, other) ->
      "the argument '" ++ name_at(spec, rejection.path, long) ++ "' cannot be used with '--"
        ++ other
        ++ "'",
    MissingCommand(names) -> if rejection.path.len() == 0 {
      "'" ++ spec.bin ++ "' requires a subcommand but one was not provided"
    } else {
      "'" ++ String::join(rejection.path, " ")
        ++ "' requires a subcommand but one was not provided; try one of "
        ++ String::join(names, ", ")
    },
    MissingPositionals(names) ->
      "the following required arguments were not provided:"
        ++ names.fold("", |accumulator: String, name: String|
          accumulator ++ "\n  <" ++ name ++ ">"),
    Rejected(reason) -> reason,
  }

fn name_at(spec: Spec, path: List<String>, long: String) -> String =
  match scan_long(flags_at(spec.root, path), long) {
    Some(flag) -> flag_label(flag),
    None -> "--" ++ long,
  }

/// An error as command-line users expect it: the message, the usage of the command where it
/// happened, and how to get help.
pub fn error_text(spec: Spec, rejection: Error) -> String =
  "error: " ++ error_message(spec, rejection) ++ "\n\n" ++ usage(spec, rejection.path)
    ++ "\n\nFor more information, try '--help'."

/// The line `--version` prints.
pub fn version_line(spec: Spec) -> String = spec.bin ++ " " ++ spec.version

/// What a program prints for a line that does not run, and its exit code.
pub type Reply = new {
  text: String,
  /// 0 for help and a version, which go to the output stream; 2 for an error, which goes to the
  /// error stream.
  code: Int,
}

/// A run's value, or what the program prints instead of running: the help in `width` columns, the
/// version, or the error.
pub fn reply<a>(
  spec: Spec,
  outcome: Outcome<a>,
  width: Option<Int> = None,
) -> Result<a, Reply> / {abort.raise} =
  match outcome {
    Run(x) -> Ok(x),
    Help(path) -> Err({ text: help(spec, path, width), code: 0 }),
    Version -> Err({ text: version_line(spec), code: 0 }),
    Failed(rejection) -> Err({ text: error_text(spec, rejection), code: 2 }),
  }

type Row = { left: String, right: String, notes: List<String> }

/// Returns the help text for the command named by `path`, or for the root command when `path` names
/// no command. The text has the about line, the usage line, and sections for arguments, options and
/// commands, each a column of names beside their descriptions. With `width`, lines are wrapped to
/// at most that many columns, and a wrapped description continues under the start of the
/// description column. Without `width`, no line is wrapped.
pub fn help(spec: Spec, path: List<String>, width: Option<Int> = None) -> String / {abort.raise} = {
  let at = match node_at(spec.root, path) { Some(_) -> path, None -> [] };
  let node = node_or_root(spec.root, at);
  let sections = [
    match width {
      Some(columns) -> String::join(wrap(about_line(node.about), columns), "\n"),
      None -> about_line(node.about),
    },
    usage(spec, at),
    arguments_section(node, width),
    options_section(flags_at(spec.root, at), width),
    commands_section(node, width),
  ];
  sections.fold("", |accumulator: String, part: String|
    if part == "" { accumulator } else { accumulator ++ part ++ "\n\n" }).strip_suffix(
    "\n",
  )
}

fn row(left: String, right: String) -> Row = { left: left, right: right, notes: [] }

fn arguments_section(node: Body, width: Option<Int>) -> String =
  if node.positionals.len() == 0 { "" } else {
    "Arguments:\n"
      ++ aligned(node.positionals.map(|p: Positional| row(positional_left(p), p.help)), width)
  }

fn positional_left(p: Positional) -> String = {
  let inner = if p.required { "<" ++ p.name ++ ">" } else { "[" ++ p.name ++ "]" };
  if p.many { inner ++ "..." } else { inner }
}

fn options_section(flags: List<Flag>, width: Option<Int>) -> String = {
  let rows = flags.map(|flag: Flag|
    { left: flag_left(flag), right: flag.help, notes: flag_notes(flag) });
  let builtin = [row("-h, --help", "Print help"), row("-V, --version", "Print version")];
  "Options:\n" ++ aligned(rows.concat(builtin), width)
}

fn commands_section(node: Body, width: Option<Int>) -> String / {abort.raise} =
  if node.subs.len() == 0 { "" } else {
    let rows = node.subs.map(|s: Command| row(body(s).name, about_line(body(s).about)));
    "Commands:\n"
      ++ aligned(
        rows.push(row("help", "Print this message or the help of the given subcommand(s)")),
        width,
      )
  }

fn about_line(about: String) -> String / {abort.raise} = about.strip_suffix(".")

fn flag_left(flag: Flag) -> String = {
  let short = if flag.short == "" { "    " } else { "-" ++ flag.short ++ ", " };
  let long = if flag.negatable { "--[no-]" ++ flag.long } else { "--" ++ flag.long };
  let value = if flag.kind != Switch { " <" ++ flag.value_name ++ ">" }
  else if flag.repeatable { "..." }
  else { "" };
  short ++ long ++ value
}

fn flag_notes(flag: Flag) -> List<String> =
  [
    if flag.setting != "" { ["[setting: " ++ flag.setting ++ "]"] } else { [] },
    if flag.default != "" { ["[default: " ++ flag.default ++ "]"] } else { [] },
    match flag.kind {
      Choice(choices) -> ["[possible values: " ++ String::join(choices, ", ") ++ "]"],
      _ -> [],
    },
  ].flatten(
  )

fn noted(right: String, notes: List<String>) -> String =
  notes.fold(right, |accumulator: String, note: String| accumulator ++ " " ++ note)

fn space_placeholder() -> String = "\u{E000}"

fn aligned(rows: List<Row>, width: Option<Int>) -> String =
  match width {
    None -> String::join(table(rows.map(|r: Row| ["  " ++ r.left, noted(r.right, r.notes)])), "\n"),
    Some(columns) -> {
      let lefts = rows.fold(0, |most: Int, r: Row| max(most, text::width("  " ++ r.left)));
      String::join(
        rows.flat_map(|r: Row| {
          let lines = wrap(
            noted(r.right, r.notes.map(|note: String| note.replace(" ", space_placeholder()))),
            columns,
            String::pad_right("  " ++ r.left, lefts, " ") ++ "  ",
            " ".repeat(lefts + 2),
          );
          if lines.len() == 0 { ["  " ++ r.left] }
          else { lines.map(|line: String| line.replace(space_placeholder(), " ")) }
        }),
        "\n",
      )
    },
  }

/// Returns the usage line for the command named by `path`, or for the root command when `path`
/// names no command.
pub fn usage(spec: Spec, path: List<String>) -> String = "Usage: " ++ usage_words(spec, path)

fn usage_words(spec: Spec, path: List<String>) -> String = {
  let node = node_or_root(spec.root, path);
  let line = spec.bin ++ path.fold("", |accumulator: String, w: String| accumulator ++ " " ++ w)
    ++ " [OPTIONS]";
  let with_positionals = node.positionals.fold(line, |accumulator: String, p: Positional|
    accumulator ++ " " ++ positional_left(p));
  let with_subs = if node.subs.len() > 0 { with_positionals ++ " <COMMAND>" }
  else { with_positionals };
  if node.trailing { with_subs ++ " [-- ARGS]" } else { with_subs }
}

/// Whether the flag was written, or supplied by its setting or its default.
pub fn has(parsed: Parsed, long: String) -> Bool = has_flag(parsed.flags, long)

/// The flag's value: its last occurrence, else its setting, else its default.
pub fn value(parsed: Parsed, long: String) -> Option<String> =
  parsed.flags.fold(None, |accumulator: Option<String>, g: Given|
    if g.long == long { g.value } else { accumulator })

/// Every value a repeatable flag was written with, in order.
pub fn values_of(parsed: Parsed, long: String) -> List<String> =
  parsed.flags.fold([], |accumulator: List<String>, g: Given|
    match g.value {
      Some(v) -> if g.long == long { accumulator.push(v) } else { accumulator },
      None -> accumulator,
    })

/// How many times a repeatable switch was written: `-vvv` is three.
pub fn times(parsed: Parsed, long: String) -> Int =
  parsed.flags.fold(0, |n: Int, g: Given| if g.long == long { n + 1 } else { n })

/// The state of a negatable switch: `Some(true)` if written, `Some(false)` if negated, and `None`
/// when the line has neither and no setting supplies one.
pub fn chosen(parsed: Parsed, long: String) -> Option<Bool> =
  if has(parsed, long) { Some(true) }
  else if has(parsed, negation(long)) { Some(false) }
  else { None }

/// Returns the value of a `Nat` or `Positive` flag as an `Int`, or `None` when the flag has no
/// value.
pub fn nat_value(p: Parsed, long: String) -> Option<Int> / {abort.raise} =
  match value(p, long) { Some(v) -> parse_nat(v), None -> None }

/// How a value is written as one word of a line, and read back from it.
pub type Codec<a> = new {
  /// Returns the value the word represents, or `Err` with a message explaining why the word is not
  /// valid.
  decode: (String) -> Result<a, String> / {abort.raise},
  /// The word that reads back as the value.
  encode: (a) -> String / {abort.raise},
  /// The words a value is chosen from, which the help lists; empty when any word is allowed.
  choices: List<String>,
}

/// A codec of a program's own, with no closed list of words.
pub fn codec<a>(
  decode: keep (String) -> Result<a, String> / {abort.raise},
  encode: keep (a) -> String / {abort.raise},
) -> Codec<a> = { decode: decode, encode: encode, choices: [] }

/// Any text, as it is written.
pub fn text() -> Codec<String> = codec(|word: String| Ok(word), |word: String| word)

/// A path, as text: any word but the empty one.
pub fn path() -> Codec<String> =
  codec(
    |word: String| if word == "" { Err("a path must not be empty") } else { Ok(word) },
    |word: String| word,
  )

/// A whole number in decimal, with a `-` before a negative one.
pub fn int() -> Codec<Int> =
  codec(
    |word: String|
      match word.int_of_string() { Some(n) -> Ok(n), None -> Err("a whole number is required") },
    |n: Int| n.to_string(),
  )

/// A number as `Float::of_string` reads one, written as the shortest text that reads back.
pub fn float() -> Codec<Float> =
  codec(
    |word: String|
      match Float::of_string(word) { Some(x) -> Ok(x), None -> Err("a number is required") },
    |x: Float| x.to_string(),
  )

/// A span of time in `std.time`'s compound form, as `1h30m` and `250ms`.
pub fn duration() -> Codec<Duration> =
  codec(
    |word: String|
      match parse_duration(word) {
        Ok(d) -> Ok(d),
        Err(rejected) -> Err(time::rejection_message(rejected)),
      },
    |d: Duration| render_duration(d),
  )

/// A codec for a size in bytes. It accepts what `std.fmt`'s `parse_size` accepts, such as `64MiB`
/// or `1.5GB`, and encodes the size as a plain number of bytes.
pub fn size() -> Codec<Int> =
  codec(
    |word: String|
      match parse_size(word) {
        Some(bytes) -> Ok(bytes),
        None -> Err("a size is a number and its unit, as `64MiB`"),
      },
    |bytes: Int| bytes.to_string(),
  )

/// One of a closed list of words, each representing a value of the program's own. A value the
/// list does not contain is written as the empty word.
pub fn one_of<a>(named: List<{ name: String, value: a }>) -> Codec<a>
  where derivable(eq, a)
=
  {
    decode: |word: String|
      match named.find(|n: { name: String, value: a }| n.name == word) {
        Some(n) -> Ok(n.value),
        None ->
          Err(
            "not one of " ++ String::join(named.map(|n: { name: String, value: a }| n.name), ", "),
          ),
      },
    encode: |x: a|
      match named.find(|n: { name: String, value: a }| n.value == x) {
        Some(n) -> n.name,
        None -> "",
      },
    choices: named.map(|n: { name: String, value: a }| n.name),
  }

/// A flag whose value has type `a`. `flag` is the declaration listed in the command's help, and
/// `codec` converts the flag's words to values: the parser uses it to validate each word and `get`
/// uses it to read the value.
pub type Arg<a> = new { flag: Flag, codec: Codec<a> }

/// Returns `flag` paired with `codec`. The flag's `check` rejects every word that its own check or
/// `codec` rejects. When `codec` has a list of choices, the flag's kind becomes a `Choice` of them.
pub fn arg<a>(flag: Flag, codec: Codec<a>) -> Arg<a> = {
  let own = flag.check;
  let decode = codec.decode;
  {
    flag: {
      ..flag,
      kind: if codec.choices.len() > 0 { Choice(codec.choices) } else { flag.kind },
      check: |word: String|
        match own(word) {
          Err(reason) -> Err(reason),
          Ok(_) -> match decode(word) { Ok(_) -> Ok(()), Err(reason) -> Err(reason) },
        },
    },
    codec: codec,
  }
}

/// The flag's value: its last occurrence, else its setting, else its default; `None` when it has
/// none of them.
pub fn get<a>(parsed: Parsed, arg: Arg<a>) -> Option<a> / {abort.raise} = {
  let word = match value(parsed, arg.flag.long) {
    Some(written) -> Some(written),
    None -> if arg.flag.default == "" { None } else { Some(arg.flag.default) },
  };
  match word {
    None -> None,
    Some(w) -> match arg.codec.decode(w) { Ok(x) -> Some(x), Err(_) -> None },
  }
}

/// `get`, with `otherwise` when the flag has no value.
pub fn get_or<a>(parsed: Parsed, arg: Arg<a>, otherwise: a) -> a / {abort.raise} =
  match get(parsed, arg) { Some(x) -> x, None -> otherwise }

/// Returns the flag's value like `get`, or `Err` when the flag has no value. Use it for a flag that
/// the user must write or that always has a default.
pub fn required<a>(parsed: Parsed, arg: Arg<a>) -> Result<a, String> / {abort.raise} =
  match get(parsed, arg) {
    Some(x) -> Ok(x),
    None -> Err("the following required arguments were not provided:\n  " ++ flag_label(arg.flag)),
  }

/// Every value a repeatable flag was written with, in order.
pub fn all<a>(parsed: Parsed, arg: Arg<a>) -> List<a> / {abort.raise} =
  values_of(parsed, arg.flag.long).flat_map(|word: String|
    match arg.codec.decode(word) { Ok(x) -> [x], Err(_) -> [] })

/// The flag as it appears in a parsed line with the value `x`.
pub fn given<a>(arg: Arg<a>, x: a) -> Given / {abort.raise} =
  { long: arg.flag.long, value: Some(arg.codec.encode(x)) }

/// A switch as it appears in a parsed line when written.
pub fn on(flag: Flag) -> Given = { long: flag.long, value: None }

/// A negatable switch as it appears in a parsed line when negated.
pub fn off(flag: Flag) -> Given = { long: negation(flag.long), value: None }

type CommandAtPath = { path: List<String>, node: Body }

fn all_commands(command: Command, path: List<String>) -> List<CommandAtPath> =
  match command {
    CommandBody(node) ->
      node.subs.fold(
        [{ path: path, node: node }],
        |accumulator: List<CommandAtPath>, sub: Command|
          accumulator.concat(all_commands(sub, path.push(sub_name(sub)))),
      ),
  }

fn sub_name(command: Command) -> String = match command { CommandBody(node) -> node.name }

/// The configuration keys the flags of `spec` fall back to, each once, in the order declared.
pub fn keys(spec: Spec) -> List<String> =
  all_commands(spec.root, []).fold([], |accumulator: List<String>, at: CommandAtPath|
    at.node.flags.fold(accumulator, |names: List<String>, flag: Flag|
      if flag.setting == "" || names.contains(flag.setting) { names }
      else { names.push(flag.setting) }))

/// What `config.get[l]` returns for each key `spec` names: the settings `parse` takes. `std.config`
/// reads a key from `--set`, then `--config` files, then the environment.
pub fn settings<[l]>(spec: Spec) -> List<{ key: String, value: String }> / {config.get[l]} =
  keys(spec).flat_map(|key: String|
    match config.get[l](key) { Some(value) -> [{ key: key, value: value }], None -> [] })

/// Returns the words that parse back to `parsed` under `spec`: the command path, each flag joined
/// to its value, and then the positionals after `--`. For a command that takes trailing arguments,
/// the positionals come first, with no `--` before them, followed by `--` and the argument vector.
pub fn arguments(spec: Spec, parsed: Parsed) -> List<String> = {
  let head = parsed.path.concat(parsed.flags.map(long_flag_argument));
  if node_or_root(spec.root, parsed.path).trailing {
    head.concat(parsed.positionals).concat(if parsed.argv.len() == 0 { [] }
    else { prepend("--", parsed.argv) })
  } else if parsed.positionals.len() == 0 { head }
  else { head.push("--").concat(parsed.positionals) }
}

fn long_flag_argument(g: Given) -> String =
  match g.value { Some(v) -> "--" ++ g.long ++ "=" ++ v, None -> "--" ++ g.long }

/// Something a declaration gets wrong: the command it is under, the flag, positional or command
/// it is about, and why.
pub type Fault = new { path: List<String>, about: String, reason: String }

/// Whether `spec` declares a line the parser can read as written: `faults` finds nothing.
pub fn well_formed(spec: Spec) -> Bool / {abort.raise} = faults(spec).len() == 0

/// Returns the mistakes in `spec` that can be found without parsing any command line. Each fault
/// names the command and flag or positional. The checks are: - `requires`, `conflicts` or `unless`
/// names a flag the command does not read. - A name is declared twice, or is one the parser handles
/// itself (`--help`, `--version`, `-h`, `-V`, `help`). - A short name is not exactly one character.
/// - A default or bare value is rejected by the flag's kind or check. - A switch is given a default
/// or bare value. - A negation is set on a flag that is not a plain switch, or clashes with another
/// flag's name. - A positional follows one that takes all remaining words. - A command with
/// subcommands also takes positionals or trailing words.
pub fn faults(spec: Spec) -> List<Fault> / {abort.raise} =
  all_commands(spec.root, []).flat_map(|at: CommandAtPath| {
    let reads = flags_at(spec.root, at.path);
    at.node.flags.flat_map(|flag: Flag| flag_faults(at, reads, flag)).concat(
      duplicate_faults(at, "--", at.node.flags.map(|flag: Flag| flag.long)),
    ).concat(
      duplicate_faults(
        at,
        "-",
        at.node.flags.map(|flag: Flag| flag.short).filter(|s: String| s != ""),
      ).concat(
        positional_faults(at, reads).concat(command_faults(at)),
      ),
    )
  })

fn fault(at: CommandAtPath, about: String, reason: String) -> Fault =
  { path: at.path, about: about, reason: reason }

fn declares(flags: List<Flag>, long: String) -> Bool =
  match scan_long(flags, long) { Some(_) -> true, None -> false }

fn flag_faults(at: CommandAtPath, reads: List<Flag>, flag: Flag) -> List<Fault> / {abort.raise} = {
  let is_switch = flag.kind == Switch;
  let whys = [
    if flag.long == "" || flag.long.starts_with("-") || flag.long.contains("=") {
      ["its name is empty, starts with `-` or holds `=`"]
    } else if flag.long == "help" || flag.long == "version" {
      [
        "`help` and `version` are reserved for the built-in flags, so no flag can use them as its name",
      ]
    } else { [] },
    if flag.short == "" { [] }
    else if flag.short.chars().len() != 1 || flag.short == "-" || flag.short == "=" {
      ["its short `" ++ flag.short ++ "` must be one character other than `-` and `=`"]
    } else if flag.short == "h" || flag.short == "V" {
      [
        "`-" ++ flag.short
          ++ "` is reserved for a built-in flag, so no flag can use it as its short name",
      ]
    } else { [] },
    if is_switch && (flag.default != "" || flag.bare_value != "") {
      [
        "a switch takes no value, so it cannot have a default or a bare value (the value used when the flag is given without one)",
      ]
    } else if !is_switch && flag.value_name == "" {
      ["the flag takes a value, so it needs a value name for the help text"]
    } else { [] },
    if !flag.negatable { [] } else if !is_switch || flag.repeatable {
      ["only a switch that cannot be repeated can have a `--no-` form"]
    } else if declares(reads, negation(flag.long)) {
      ["its `--no-` form is already the name of another flag"]
    } else { [] },
    match flag.kind {
      Choice(choices) -> if choices.len() == 0 { ["the flag has an empty list of choices"] }
      else { [] },
      _ -> [],
    },
    rejected_value(flag, flag.default, "its default"),
    rejected_value(flag, flag.bare_value, "its bare value"),
    naming(reads, flag, flag.requires, "requires"),
    naming(reads, flag, flag.conflicts, "conflicts with"),
  ].flatten(
  );
  whys.map(|reason: String| fault(at, "--" ++ flag.long, reason))
}

fn rejected_value(flag: Flag, word: String, role: String) -> List<String> / {abort.raise} =
  if word == "" { [] } else {
    match bad_value(flag, word) {
      Some(_) -> [role ++ " `" ++ word ++ "` is not a value this flag accepts"],
      None -> [],
    }
  }

fn naming(reads: List<Flag>, flag: Flag, longs: List<String>, role: String) -> List<String> =
  longs.flat_map(|long: String|
    if long == flag.long { [role ++ " itself"] } else if !declares(reads, long) {
      [role ++ " `--" ++ long ++ "`, but no flag with that name is declared"]
    } else { [] })

fn duplicate_faults(at: CommandAtPath, lead: String, names: List<String>) -> List<Fault> =
  names.filter(|name: String| names.filter(|other: String| other == name).len() > 1).unique().map(
    |name: String| fault(at, lead ++ name, "is declared twice"),
  )

fn positional_faults(at: CommandAtPath, reads: List<Flag>) -> List<Fault> = {
  let last = at.node.positionals.len() - 1;
  enumerate(at.node.positionals).flat_map(|p: { index: Int, value: Positional }|
    [
      if p.value.many && p.index != last { ["takes every remaining word, so none can follow it"] }
      else { [] },
      if p.value.unless != "" && !declares(reads, p.value.unless) {
        [
          "can be left out when `--" ++ p.value.unless
            ++ "` is given, but no flag with that name is declared",
        ]
      } else { [] },
      if p.value.required && p.value.unless == ""
          && at.node.positionals.take(p.index).any(|before: Positional| !before.required) {
        [
          "is required but follows an optional argument, so a command line with fewer words cannot show which argument each word is for",
        ]
      } else { [] },
    ].flatten(
    ).map(|reason: String| fault(at, "<" ++ p.value.name ++ ">", reason)))
}

fn command_faults(at: CommandAtPath) -> List<Fault> = {
  let names = at.node.subs.map(sub_name);
  duplicate_faults(at, "", names).concat(
    names.flat_map(|name: String|
      if name == "help" { [fault(at, name, "the parser handles `help` itself")] }
      else if name == "" || name.starts_with("-") {
        [fault(at, name, "its name is empty or starts with `-`")]
      } else { [] }),
  ).concat(if at.node.subs.len() > 0 && (at.node.positionals.len() > 0 || at.node.trailing) {
    [fault(at, at.node.name, "has commands under it, so it takes no words of its own")]
  } else { [] })
}

/// A shell a completion script is written for.
pub type Shell = | Bash | Zsh | Fish

/// Returns a script that completes command lines for `spec` in `shell`. It completes commands at
/// every level, each flag by all its names, and the choices of a flag. Other flag values and
/// positionals complete as file names. A command, flag or choice is left out when its name needs
/// quoting in a shell, that is, when `std.text`'s `shell_quote` would change it.
pub fn completion(spec: Spec, shell: Shell) -> String / {abort.raise} =
  match shell { Bash -> bash_script(spec), Zsh -> zsh_script(spec), Fish -> fish_script(spec) }

fn is_plain(word: String) -> Bool = text::shell_quote(word) == Some(word)

fn identifier(name: String) -> String =
  String::of_chars(
    name.chars().map(|c: Char|
      if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') { c }
      else { '_' }),
  )

fn takes_value(flag: Flag) -> Bool = flag.kind != Switch

fn flag_words(flag: Flag) -> List<String> =
  [
    ["--" ++ flag.long],
    if flag.short == "" { [] } else { ["-" ++ flag.short] },
    if flag.negatable { ["--" ++ negation(flag.long)] } else { [] },
  ].flatten(
  ).filter(
    is_plain,
  )

fn plain_subs(node: Body) -> List<Body> = node.subs.map(body).filter(|sub: Body| is_plain(sub.name))

fn choices_of(flag: Flag) -> List<String> =
  match flag.kind { Choice(choices) -> choices.filter(is_plain), _ -> [] }

fn bash_script(spec: Spec) -> String = {
  let function = "_" ++ identifier(spec.bin);
  let nodes = all_commands(spec.root, []);
  String::join(
    [
      [
        "# bash completion for " ++ spec.bin,
        function ++ "() {",
        "    local cur prev path word skip i",
        "    cur=\"${COMP_WORDS[COMP_CWORD]}\"",
        "    prev=\"${COMP_WORDS[COMP_CWORD-1]}\"",
        "    if [[ $cur == \"=\" ]]; then cur=\"\"; fi",
        "    if [[ $prev == \"=\" ]]; then prev=\"${COMP_WORDS[COMP_CWORD-2]}\"; fi",
        "    path=\"\"",
        "    skip=0",
        "    for ((i = 1; i < COMP_CWORD; i++)); do",
        "        word=\"${COMP_WORDS[i]}\"",
        "        if ((skip)); then [[ $word == \"=\" ]] || skip=0; continue; fi",
        "        case \"$path $word\" in",
      ],
      nodes.flat_map(|at: CommandAtPath| bash_steps(spec, at)),
      ["        esac", "    done", "    COMPREPLY=()", "    case \"$path\" in"],
      nodes.flat_map(|at: CommandAtPath| bash_node(spec, at)),
      ["    esac", "}", "complete -o default -F " ++ function ++ " " ++ spec.bin, ""],
    ].flatten(
    ),
    "\n",
  )
}

fn bash_steps(spec: Spec, at: CommandAtPath) -> List<String> = {
  let here = String::join(at.path, " ");
  let valued = flags_at(spec.root, at.path).filter(takes_value).flat_map(flag_words);
  plain_subs(at.node).map(|sub: Body|
    "            \"" ++ here ++ " " ++ sub.name ++ "\") path=\""
      ++ String::join(at.path.push(sub.name), " ")
      ++ "\" ;;").concat(if valued.len() == 0 { [] } else {
    [
      "            "
        ++ String::join(valued.map(|word: String| "\"" ++ here ++ " " ++ word ++ "\""), "|")
        ++ ") skip=1 ;;",
    ]
  })
}

fn bash_node(spec: Spec, at: CommandAtPath) -> List<String> = {
  let flags = flags_at(spec.root, at.path);
  let values = flags.filter(takes_value).flat_map(|flag: Flag|
    if flag_words(flag).len() == 0 { [] } else {
      [
        "                " ++ String::join(flag_words(flag), "|") ++ ") "
          ++ (if choices_of(flag).len() == 0 { "return ;;" } else {
            "COMPREPLY=($(compgen -W \"" ++ String::join(choices_of(flag), " ")
              ++ "\" -- \"$cur\")); return ;;"
          }),
      ]
    });
  let offered = [
    if at.node.subs.len() == 0 { [] }
    else { plain_subs(at.node).map(|sub: Body| sub.name).push("help") },
    flags.flat_map(flag_words),
    ["--help", "-h", "--version", "-V"],
  ].flatten(
  );
  [
    ["        \"" ++ String::join(at.path, " ") ++ "\")"],
    if values.len() == 0 { [] }
    else { [["            case \"$prev\" in"], values, ["            esac"]].flatten() },
    [
      "            COMPREPLY=($(compgen -W \"" ++ String::join(offered, " ") ++ "\" -- \"$cur\"))",
      "            ;;",
    ],
  ].flatten(
  )
}

fn zsh_function_name(spec: Spec, path: List<String>) -> String =
  "_" ++ identifier(String::join(prepend(spec.bin, path), "_"))

fn zsh_script(spec: Spec) -> String / {abort.raise} = {
  let function = zsh_function_name(spec, []);
  String::join(
    [
      ["#compdef " ++ spec.bin, ""],
      all_commands(spec.root, []).flat_map(|at: CommandAtPath| zsh_function(spec, at)),
      [
        "if [ \"$funcstack[1]\" = \"" ++ function ++ "\" ]; then",
        "    " ++ function ++ " \"$@\"",
        "else",
        "    compdef " ++ function ++ " " ++ spec.bin,
        "fi",
        "",
      ],
    ].flatten(
    ),
    "\n",
  )
}

fn zsh_text(words: String) -> String =
  [
    { from: "\\", to: "\\\\" },
    { from: "'", to: "'\\''" },
    { from: "[", to: "\\[" },
    { from: "]", to: "\\]" },
    { from: ":", to: "\\:" },
    { from: "$", to: "\\$" },
    { from: "`", to: "\\`" },
  ].fold(words, |text: String, swap: { from: String, to: String }| text.replace(swap.from, swap.to))

fn zsh_function(spec: Spec, at: CommandAtPath) -> List<String> / {abort.raise} = {
  let subs = plain_subs(at.node);
  let specs = [
    flags_at(spec.root, at.path).flat_map(zsh_options),
    ["'(- *)'{-h,--help}'[Print help]'", "'(- *)'{-V,--version}'[Print version]'"],
    if at.node.subs.len() > 0 { ["'1: :->command'", "'*:: :->args'"] }
    else { at.node.positionals.map(zsh_positional) },
  ].flatten(
  );
  let last = specs.len() - 1;
  let arguments = enumerate(specs).map(|s: { index: Int, value: String }|
    "        " ++ s.value ++ (if s.index == last { "" } else { " \\" }));
  [
    [zsh_function_name(spec, at.path) ++ "() {"],
    if at.node.subs.len() > 0 { ["    local line state", "    _arguments -s -S -C \\"] }
    else { ["    _arguments -s -S \\"] },
    arguments,
    if at.node.subs.len() == 0 { [] } else {
      [
        [
          "    case $state in",
          "        command)",
          "            local -a commands",
          "            commands=(",
        ],
        subs.map(|sub: Body|
          "                '" ++ sub.name ++ ":" ++ zsh_text(about_line(sub.about)) ++ "'"),
        [
          "                'help:Print this message or the help of the given subcommand(s)'",
          "            )",
          "            _describe -t commands command commands",
          "            ;;",
          "        args)",
          "            case $line[1] in",
        ],
        subs.map(|sub: Body|
          "                " ++ sub.name ++ ") " ++ zsh_function_name(spec, at.path.push(sub.name))
            ++ " ;;"),
        ["            esac", "            ;;", "    esac"],
      ].flatten(
      )
    },
    ["}", ""],
  ].flatten(
  )
}

fn zsh_options(flag: Flag) -> List<String> =
  if !is_plain("--" ++ flag.long) { [] } else {
    let valued = takes_value(flag);
    let short = flag.short != "" && is_plain("-" ++ flag.short);
    let names = if short {
      "{-" ++ flag.short ++ (if valued { "+" } else { "" }) ++ ",--" ++ flag.long
        ++ (if valued { "=" } else { "" })
        ++ "}"
    } else { "--" ++ flag.long ++ (if valued { "=" } else { "" }) };
    let prefix = if flag.repeatable { "'*'" }
    else if short { "'(-" ++ flag.short ++ " --" ++ flag.long ++ ")'" }
    else { "" };
    let about = "[" ++ zsh_text(flag.help) ++ "]";
    let value = if !valued { "" } else {
      ":" ++ zsh_text(flag.value_name) ++ ":"
        ++ (if choices_of(flag).len() == 0 { "_files" }
        else { "(" ++ String::join(choices_of(flag), " ") ++ ")" })
    };
    [prefix ++ names ++ "'" ++ about ++ value ++ "'"].concat(if flag.negatable {
      ["--" ++ negation(flag.long) ++ "'" ++ about ++ "'"]
    } else { [] })
  }

fn zsh_positional(p: Positional) -> String =
  "'" ++ (if p.many { "*:" } else if p.required { ":" } else { "::" }) ++ zsh_text(p.name)
    ++ ":_files'"

fn fish_text(words: String) -> String =
  "'" ++ words.replace("\\", "\\\\").replace("'", "\\'") ++ "'"

fn fish_script(spec: Spec) -> String / {abort.raise} = {
  let lead = "complete -c " ++ spec.bin;
  String::join(
    [
      ["# fish completion for " ++ spec.bin],
      all_commands(spec.root, []).flat_map(|at: CommandAtPath| fish_node(lead, at)),
      [lead ++ " -s h -l help -d 'Print help'", lead ++ " -s V -l version -d 'Print version'", ""],
    ].flatten(
    ),
    "\n",
  )
}

fn fish_node(lead: String, at: CommandAtPath) -> List<String> / {abort.raise} = {
  let seen = at.path.map(|word: String| "__fish_seen_subcommand_from " ++ word);
  let subs = plain_subs(at.node);
  let under = lead
    ++ (if seen.len() == 0 { "" } else { " -n \"" ++ String::join(seen, "; and ") ++ "\"" });
  let before = lead ++ " -n \""
    ++ (if seen.len() == 0 { "__fish_use_subcommand" } else {
      String::join(seen, "; and ") ++ "; and not __fish_seen_subcommand_from "
        ++ String::join(subs.map(|sub: Body| sub.name).push("help"), " ")
    })
    ++ "\"";
  at.node.flags.flat_map(|flag: Flag| fish_flags(under, flag)).concat(if at.node.subs.len() == 0 {
    []
  } else {
    subs.map(|sub: Body|
      before ++ " -f -a " ++ sub.name ++ " -d " ++ fish_text(about_line(sub.about))).push(
      before ++ " -f -a help -d 'Print this message or the help of the given subcommand(s)'",
    )
  })
}

fn fish_flags(under: String, flag: Flag) -> List<String> =
  if !is_plain("--" ++ flag.long) { [] } else {
    let short = if flag.short != "" && is_plain("-" ++ flag.short) { " -s " ++ flag.short }
    else { "" };
    let value = if !takes_value(flag) { "" }
    else if choices_of(flag).len() == 0 { " -r" }
    else { " -x -a '" ++ String::join(choices_of(flag), " ") ++ "'" };
    let about = " -d " ++ fish_text(flag.help);
    [under ++ short ++ " -l " ++ flag.long ++ value ++ about].concat(if flag.negatable {
      [under ++ " -l " ++ negation(flag.long) ++ about]
    } else { [] })
  }

fn roff_escaped(words: String) -> String = words.replace("\\", "\\e").replace("-", "\\-")

fn roff_bold(words: String) -> String = "\\fB" ++ roff_escaped(words) ++ "\\fR"

fn roff_italic(words: String) -> String = "\\fI" ++ roff_escaped(words) ++ "\\fR"

fn roff_line(words: String) -> String =
  if words.starts_with(".") || words.starts_with("'") { "\\&" ++ roff_escaped(words) }
  else { roff_escaped(words) }

/// The manual page of the command `path` names, or the root's where it names none, in `man`'s
/// markup: its name and about, its synopsis, and its arguments, options and commands. The page
/// of `stash put` is named `stash-put`, and carries no date.
pub fn man_page(spec: Spec, path: List<String>) -> String / {abort.raise} = {
  let at = match node_at(spec.root, path) { Some(_) -> path, None -> [] };
  let node = node_or_root(spec.root, at);
  let name = String::join(prepend(spec.bin, at), "-");
  let options = flags_at(spec.root, at).flat_map(|flag: Flag|
    [
      ".TP",
      String::join(
        [
          if flag.short == "" { [] } else { [roff_bold("-" ++ flag.short)] },
          [
            roff_bold(if flag.negatable { "--[no-]" ++ flag.long } else { "--" ++ flag.long })
              ++ (if takes_value(flag) { " " ++ roff_italic(flag.value_name) } else { "" }),
          ],
        ].flatten(
        ),
        ", ",
      ),
      roff_line(noted(flag.help, flag_notes(flag))),
    ]);
  String::join(
    [
      [
        ".TH \"" ++ roff_escaped(unicode::uppercase(name)) ++ "\" 1 \"\" \""
          ++ roff_escaped(version_line(spec))
          ++ "\"",
        ".SH NAME",
        roff_escaped(name) ++ " \\- " ++ roff_escaped(about_line(node.about)),
        ".SH SYNOPSIS",
        roff_line(usage_words(spec, at)),
      ],
      if node.positionals.len() == 0 { [] } else {
        prepend(
          ".SH ARGUMENTS",
          node.positionals.flat_map(|p: Positional|
            [".TP", roff_italic(positional_left(p)), roff_line(p.help)]),
        )
      },
      [".SH OPTIONS"],
      options,
      [
        ".TP",
        roff_bold("-h") ++ ", " ++ roff_bold("--help"),
        "Print help",
        ".TP",
        roff_bold("-V") ++ ", " ++ roff_bold("--version"),
        "Print version",
      ],
      if node.subs.len() == 0 { [] } else {
        prepend(
          ".SH COMMANDS",
          node.subs.map(body).flat_map(|sub: Body|
            [".TP", roff_bold(sub.name), roff_line(about_line(sub.about))]),
        )
      },
      [""],
    ].flatten(
    ),
    "\n",
  )
}

/// The declaration as JSON, for a program that reads what a line takes rather than its help:
/// the program's name and version, and its root command with every command under it, each with
/// its about, the flags declared at it, its positionals, and whether the words after `--` are an
/// argument vector. A text the declaration leaves empty is `null`.
pub fn description(spec: Spec) -> Json =
  json::object([
    { key: "bin", value: json::Str(spec.bin) },
    { key: "version", value: json::Str(spec.version) },
    { key: "command", value: command_described(spec.root) },
  ])

fn command_described(command: Command) -> Json =
  match command {
    CommandBody(node) ->
      json::object([
        { key: "name", value: json::Str(node.name) },
        { key: "about", value: json::Str(node.about) },
        { key: "flags", value: json::Array(node.flags.map(flag_described)) },
        { key: "positionals", value: json::Array(node.positionals.map(positional_described)) },
        { key: "trailing", value: json::Bool(node.trailing) },
        { key: "commands", value: json::Array(node.subs.map(command_described)) },
      ]),
  }

fn nullable_string(words: String) -> Json = if words == "" { json::Null } else { json::Str(words) }

fn flag_described(flag: Flag) -> Json =
  json::object([
    { key: "long", value: json::Str(flag.long) },
    { key: "short", value: nullable_string(flag.short) },
    {
      key: "kind",
      value: json::Str(match flag.kind {
        Switch -> "switch",
        Text -> "text",
        Nat -> "nat",
        Positive -> "pos",
        Choice(_) -> "choice",
      }),
    },
    {
      key: "choices",
      value: json::strings(match flag.kind { Choice(choices) -> choices, _ -> [] }),
    },
    { key: "value_name", value: nullable_string(flag.value_name) },
    { key: "default", value: nullable_string(flag.default) },
    { key: "bare_value", value: nullable_string(flag.bare_value) },
    { key: "setting", value: nullable_string(flag.setting) },
    { key: "help", value: json::Str(flag.help) },
    { key: "repeatable", value: json::Bool(flag.repeatable) },
    { key: "negatable", value: json::Bool(flag.negatable) },
    { key: "requires", value: json::strings(flag.requires) },
    { key: "conflicts", value: json::strings(flag.conflicts) },
  ])

fn positional_described(p: Positional) -> Json =
  json::object([
    { key: "name", value: json::Str(p.name) },
    { key: "help", value: json::Str(p.help) },
    { key: "default", value: nullable_string(p.default) },
    { key: "required", value: json::Bool(p.required) },
    { key: "many", value: json::Bool(p.many) },
    { key: "unless", value: nullable_string(p.unless) },
  ])

type Format = | Table | Lines

type Mode = | Write | DryRun | Force

type PutOptions = {
  name: String,
  files: List<String>,
  level: Int,
  keep: Option<Duration>,
  most: Option<Int>,
  tags: List<String>,
  mode: Mode,
}

type ListOptions = { format: Format, color: Option<Bool>, pattern: String }

type Job = | Putting(PutOptions) | Listing(ListOptions)

type Order = { verbosity: Int, job: Job }

fn level() -> Arg<Int> =
  arg(
    with_setting(
      with_short(with_default(valued("level", "N", Text, "How hard to compress."), "6"), "l"),
      "STASH_LEVEL",
    ),
    int(),
  )

fn keep() -> Arg<Duration> =
  arg(valued("keep", "SPAN", Text, "Drop the entry once it is this old."), duration())

fn most() -> Arg<Int> =
  arg(valued("most", "SIZE", Text, "Reject an entry larger than this."), size())

fn tag() -> Arg<String> =
  arg(
    with_short(repeated(valued("tag", "TAG", Text, "A label to find it by. Repeatable.")), "t"),
    text(),
  )

fn format() -> Arg<Format> =
  arg(
    with_default(valued("format", "FORMAT", Text, "How to print the entries."), "table"),
    one_of([{ name: "table", value: Table }, { name: "lines", value: Lines }]),
  )

fn dry_run() -> Flag =
  with_short(switch("dry-run", "Say what would be stored, and store nothing."), "n")

fn force() -> Flag =
  conflicting(switch("force", "Write over an entry of the same name."), ["dry-run"])

fn color() -> Flag = with_setting(negatable(switch("color", "Colour the names.")), "STASH_COLOR")

fn verbose() -> Flag =
  with_short(repeated(switch("verbose", "Print more output. Repeat for more.")), "v")

fn stash() -> Spec = {
  let put = with_positionals(
    command("put", "Store files under a name.", [
      level().flag,
      keep().flag,
      most().flag,
      tag().flag,
      dry_run(),
      force(),
    ]),
    [
      positional("NAME", "What to call the entry."),
      many(defaulted("FILES", "The files to store; defaults to the working directory.", "")),
    ],
  );
  let list = with_positionals(command("list", "List the entries.", [format().flag, color()]), [
    defaulted("PATTERN", "Only entries whose name matches this pattern.", "*"),
  ]);
  {
    bin: "stash",
    version: "1.4.0",
    root: with_subs(command("", "Keep files for later.", [verbose()]), [put, list]),
  }
}

fn put_options_of(p: Parsed) -> Result<PutOptions, String> / {abort.raise} = {
  let level = required(p, level())?;
  Ok({
    name: p.positionals.at_or(0, ""),
    files: p.positionals.drop(1),
    level: level,
    keep: get(p, keep()),
    most: get(p, most()),
    tags: all(p, tag()),
    mode: if has(p, "dry-run") { DryRun } else if has(p, "force") { Force } else { Write },
  })
}

fn list_options_of(p: Parsed) -> Result<ListOptions, String> / {abort.raise} = {
  let format = required(p, format())?;
  Ok({ format: format, color: chosen(p, "color"), pattern: p.positionals.at_or(0, "") })
}

fn order_of(p: Parsed) -> Result<Order, String> / {abort.raise} = {
  let job = match p.path.at_or(0, "") {
    "put" -> put_options_of(p).map(|s: PutOptions| Putting(s)),
    _ -> list_options_of(p).map(|l: ListOptions| Listing(l)),
  };
  job.map(|j: Job| { verbosity: times(p, "verbose"), job: j })
}

fn parse_stash(line: List<String>) -> Outcome<Order> / {abort.raise} =
  parse_with(stash(), line, order_of)

fn line_of(order: Order) -> List<String> / {abort.raise} = {
  let loud = range(0, order.verbosity).map(|_: Int| on(verbose()));
  arguments(stash(), match order.job {
    Putting(s) ->
      {
        path: ["put"],
        flags: loud.concat(put_flags(s)),
        positionals: prepend(s.name, s.files),
        argv: [],
      },
    Listing(l) ->
      {
        path: ["list"],
        flags: [
          loud,
          [given(format(), l.format)],
          match l.color { Some(true) -> [on(color())], Some(false) -> [off(color())], None -> [] },
        ].flatten(
        ),
        positionals: [l.pattern],
        argv: [],
      },
  })
}

fn put_flags(s: PutOptions) -> List<Given> / {abort.raise} =
  put_singles(s).concat(s.tags.map(|t: String| given(tag(), t)))

fn put_singles(s: PutOptions) -> List<Given> / {abort.raise} =
  [
    [given(level(), s.level)],
    match s.keep { Some(d) -> [given(keep(), d)], None -> [] },
    match s.most { Some(n) -> [given(most(), n)], None -> [] },
    match s.mode { Write -> [], DryRun -> [on(dry_run())], Force -> [on(force())] },
  ].flatten(
  )

fn plain(name: String, files: List<String>) -> PutOptions =
  { name: name, files: files, level: 6, keep: None, most: None, tags: [], mode: Write }

fn putting(verbosity: Int, s: PutOptions) -> Order = { verbosity: verbosity, job: Putting(s) }

fn listing(verbosity: Int, l: ListOptions) -> Order = { verbosity: verbosity, job: Listing(l) }

type RunCase = { line: List<String>, order: Order }

fn runs() -> List<RunCase> =
  [
    { line: ["put", "notes"], order: putting(0, plain("notes", [])) },
    {
      line: ["put", "notes", "a.txt", "b.txt"],
      order: putting(0, plain("notes", ["a.txt", "b.txt"])),
    },
    {
      line: ["put", "--level", "9", "notes", "--keep=1h30m", "--most", "64MiB", "a.txt"],
      order: putting(0, {
        ..plain("notes", ["a.txt"]),
        level: 9,
        keep: Some(Duration(5400000000000)),
        most: Some(67108864),
      }),
    },
    {
      line: ["put", "-l9", "-l=3", "notes"],
      order: putting(0, { ..plain("notes", []), level: 3 }),
    },
    {
      line: ["put", "--level=-2", "notes"],
      order: putting(0, { ..plain("notes", []), level: 0 - 2 }),
    },
    {
      line: ["put", "-t", "work", "notes", "--tag=2026", "-thome"],
      order: putting(0, { ..plain("notes", []), tags: ["work", "2026", "home"] }),
    },
    {
      line: ["-v", "put", "-vnl", "3", "notes", "-v"],
      order: putting(3, { ..plain("notes", []), level: 3, mode: DryRun }),
    },
    { line: ["put", "--force", "notes"], order: putting(0, { ..plain("notes", []), mode: Force }) },
    {
      line: ["put", "--", "-n", "--force", "help"],
      order: putting(0, plain("-n", ["--force", "help"])),
    },
    { line: ["put", "-", "-"], order: putting(0, plain("-", ["-"])) },
    { line: ["list"], order: listing(0, { format: Table, color: None, pattern: "*" }) },
    {
      line: ["list", "--format=lines", "*.txt", "--no-color"],
      order: listing(0, { format: Lines, color: Some(false), pattern: "*.txt" }),
    },
    {
      line: ["list", "--no-color", "--color", "-vv"],
      order: listing(2, { format: Table, color: Some(true), pattern: "*" }),
    },
    {
      line: ["list", "--color", "--no-color"],
      order: listing(0, { format: Table, color: Some(false), pattern: "*" }),
    },
  ]

test "stash {String::join(c.line, " ")} runs as the order it describes" for c: RunCase in runs() {
  assert_eq(parse_stash(c.line), Run(c.order))
}

test "stash {String::join(c.line, " ")} is the line its order is written back as, or parses as it" for c: RunCase in runs(
  ) { assert_eq(parse_stash(line_of(c.order)), Run(c.order)) }

type ErrorCase = { line: List<String>, at: List<String>, reason: ErrorKind, message: String }

fn error_cases() -> List<ErrorCase> =
  [
    {
      line: [],
      at: [],
      reason: MissingCommand(["put", "list"]),
      message: "'stash' requires a subcommand but one was not provided",
    },
    {
      line: ["pot", "notes"],
      at: [],
      reason: UnknownCommand("pot", Some("put")),
      message: "unrecognized subcommand 'pot'\n\n  tip: a similar subcommand exists: 'put'",
    },
    {
      line: ["frobnicate"],
      at: [],
      reason: UnknownCommand("frobnicate", None),
      message: "unrecognized subcommand 'frobnicate'",
    },
    {
      line: ["put", "--levle", "3", "notes"],
      at: ["put"],
      reason: UnknownFlag("--levle", Some("level")),
      message: "unexpected argument '--levle' found\n\n  tip: a similar argument exists: '--level'",
    },
    {
      line: ["list", "--no-colour"],
      at: ["list"],
      reason: UnknownFlag("--no-colour", Some("no-color")),
      message: "unexpected argument '--no-colour' found\n\n  tip: a similar argument exists: '--no-color'",
    },
    {
      line: ["put", "-x", "notes"],
      at: ["put"],
      reason: UnknownFlag("-x", None),
      message: "unexpected argument '-x' found",
    },
    {
      line: ["put", "-nx", "notes"],
      at: ["put"],
      reason: UnknownFlag("-x", None),
      message: "unexpected argument '-x' found",
    },
    {
      line: ["put", "notes", "--level"],
      at: ["put"],
      reason: MissingValue("level"),
      message: "a value is required for '--level <N>' but none was supplied",
    },
    {
      line: ["put", "--level", "-3", "notes"],
      at: ["put"],
      reason: MissingValue("level"),
      message: "a value is required for '--level <N>' but none was supplied",
    },
    {
      line: ["put", "--dry-run=yes", "notes"],
      at: ["put"],
      reason: UnexpectedValue("--dry-run", "yes"),
      message: "unexpected value 'yes' for '--dry-run' found",
    },
    {
      line: ["put", "-n=yes", "notes"],
      at: ["put"],
      reason: UnexpectedValue("-n", "yes"),
      message: "unexpected value 'yes' for '-n' found",
    },
    {
      line: ["list", "--no-color=never"],
      at: ["list"],
      reason: UnexpectedValue("--no-color", "never"),
      message: "unexpected value 'never' for '--no-color' found",
    },
    {
      line: ["put", "--level", "high", "notes"],
      at: ["put"],
      reason: InvalidValue("level", "high", "a whole number is required"),
      message: "invalid value 'high' for '--level <N>': a whole number is required",
    },
    {
      line: ["put", "--keep", "3d", "notes"],
      at: ["put"],
      reason: InvalidValue(
        "keep",
        "3d",
        "unknown unit: use `h`, `m`, `s`, `ms`, `us` or `ns`; a day has no fixed length",
      ),
      message: "invalid value '3d' for '--keep <SPAN>': unknown unit: use `h`, `m`, `s`, `ms`, `us` or `ns`; a day has no fixed length",
    },
    {
      line: ["put", "--most=lots", "notes"],
      at: ["put"],
      reason: InvalidValue("most", "lots", "a size is a number and its unit, as `64MiB`"),
      message: "invalid value 'lots' for '--most <SIZE>': a size is a number and its unit, as `64MiB`",
    },
    {
      line: ["list", "--format", "json"],
      at: ["list"],
      reason: NotAChoice("format", "json", ["table", "lines"]),
      message: "invalid value 'json' for '--format <FORMAT>'\n  [possible values: table, lines]",
    },
    {
      line: ["put", "--force", "-n", "notes"],
      at: ["put"],
      reason: Conflict("force", "dry-run"),
      message: "the argument '--force' cannot be used with '--dry-run'",
    },
    {
      line: ["put", "--force"],
      at: ["put"],
      reason: MissingPositionals(["NAME"]),
      message: "the following required arguments were not provided:\n  <NAME>",
    },
    {
      line: ["list", "a*", "b*"],
      at: ["list"],
      reason: UnexpectedWord("b*"),
      message: "unexpected argument 'b*' found",
    },
  ]

fn usage_under(path: List<String>) -> String =
  match path {
    [] -> "Usage: stash [OPTIONS] <COMMAND>",
    [first, ..] -> if first == "put" { "Usage: stash put [OPTIONS] <NAME> [FILES]..." }
    else { "Usage: stash list [OPTIONS] [PATTERN]" },
  }

test "stash {String::join(c.line, " ")} is rejected" for c: ErrorCase in error_cases() {
  match parse_stash(c.line) {
    Failed(rejection) -> {
      assert_eq(rejection, { path: c.at, reason: c.reason });
      assert_eq(error_message(stash(), rejection), c.message);
      assert_eq(
        error_text(stash(), rejection),
        "error: " ++ c.message ++ "\n\n" ++ usage_under(c.at)
          ++ "\n\nFor more information, try '--help'.",
      );
      assert_eq(
        reply(stash(), parse_stash(c.line)),
        Err({ text: error_text(stash(), rejection), code: 2 }),
      )
    },
    _ -> panic("the line was not rejected"),
  }
}

type Page = { path: List<String>, width: Option<Int>, text: String }

fn top_page() -> String =
  \\Keep files for later
  \\
  \\Usage: stash [OPTIONS] <COMMAND>
  \\
  \\Options:
  \\  -v, --verbose...  Print more output. Repeat for more.
  \\  -h, --help        Print help
  \\  -V, --version     Print version
  \\
  \\Commands:
  \\  put   Store files under a name
  \\  list  List the entries
  \\  help  Print this message or the help of the given subcommand(s)
  \\

fn put_page() -> String =
  \\Store files under a name
  \\
  \\Usage: stash put [OPTIONS] <NAME> [FILES]...
  \\
  \\Arguments:
  \\  <NAME>      What to call the entry.
  \\  [FILES]...  The files to store; defaults to the working directory.
  \\
  \\Options:
  \\  -l, --level <N>    How hard to compress. [setting: STASH_LEVEL] [default: 6]
  \\      --keep <SPAN>  Drop the entry once it is this old.
  \\      --most <SIZE>  Reject an entry larger than this.
  \\  -t, --tag <TAG>    A label to find it by. Repeatable.
  \\  -n, --dry-run      Say what would be stored, and store nothing.
  \\      --force        Write over an entry of the same name.
  \\  -v, --verbose...   Print more output. Repeat for more.
  \\  -h, --help         Print help
  \\  -V, --version      Print version
  \\

fn list_page() -> String =
  \\List the entries
  \\
  \\Usage: stash list [OPTIONS] [PATTERN]
  \\
  \\Arguments:
  \\  [PATTERN]  Only entries whose name matches this pattern.
  \\
  \\Options:
  \\      --format <FORMAT>  How to print the entries. [default: table] [possible values: table, lines]
  \\      --[no-]color       Colour the names. [setting: STASH_COLOR]
  \\  -v, --verbose...       Print more output. Repeat for more.
  \\  -h, --help             Print help
  \\  -V, --version          Print version
  \\

fn narrow_list_page() -> String =
  \\List the entries
  \\
  \\Usage: stash list [OPTIONS] [PATTERN]
  \\
  \\Arguments:
  \\  [PATTERN]  Only entries whose name matches this pattern.
  \\
  \\Options:
  \\      --format <FORMAT>  How to print the entries.
  \\                         [default: table]
  \\                         [possible values: table, lines]
  \\      --[no-]color       Colour the names.
  \\                         [setting: STASH_COLOR]
  \\  -v, --verbose...       Print more output. Repeat for more.
  \\  -h, --help             Print help
  \\  -V, --version          Print version
  \\

fn narrow_put_page() -> String =
  \\Store files under a name
  \\
  \\Usage: stash put [OPTIONS] <NAME> [FILES]...
  \\
  \\Arguments:
  \\  <NAME>      What to call the entry.
  \\  [FILES]...  The files to store; defaults to the
  \\              working directory.
  \\
  \\Options:
  \\  -l, --level <N>    How hard to compress.
  \\                     [setting: STASH_LEVEL]
  \\                     [default: 6]
  \\      --keep <SPAN>  Drop the entry once it is this
  \\                     old.
  \\      --most <SIZE>  Reject an entry larger than
  \\                     this.
  \\  -t, --tag <TAG>    A label to find it by.
  \\                     Repeatable.
  \\  -n, --dry-run      Say what would be stored, and
  \\                     store nothing.
  \\      --force        Write over an entry of the same
  \\                     name.
  \\  -v, --verbose...   Print more output. Repeat for
  \\                     more.
  \\  -h, --help         Print help
  \\  -V, --version      Print version
  \\

fn pages() -> List<Page> =
  [
    { path: [], width: None, text: top_page() },
    { path: ["put"], width: None, text: put_page() },
    { path: ["list"], width: None, text: list_page() },
    { path: ["list"], width: Some(60), text: narrow_list_page() },
    { path: ["put"], width: Some(52), text: narrow_put_page() },
  ]

test "stash's help under {show(c.path)} in {show(c.width)} columns" for c: Page in pages() {
  assert_eq(help(stash(), c.path, c.width), c.text);
  assert_eq(
    reply(stash(), parse_stash(c.path.push("--help")), c.width),
    Err({ text: c.text, code: 0 }),
  )
}

test "`--help`, `-h` or the word `help` at any command level requests help, and arguments after it are not parsed" {
  assert_eq(parse_stash(["--help"]), Help([]));
  assert_eq(parse_stash(["-h", "--frobnicate"]), Help([]));
  assert_eq(parse_stash(["help"]), Help([]));
  assert_eq(parse_stash(["help", "put"]), Help(["put"]));
  assert_eq(parse_stash(["put", "notes", "-h"]), Help(["put"]));
  assert_eq(parse_stash(["list", "--help", "--format", "json"]), Help(["list"]));
  assert_eq(
    parse_stash(["help", "pt"]),
    Failed({ path: [], reason: UnknownCommand("pt", Some("put")) }),
  )
}

test "the version can be requested at any level, and is the program's name and its version" {
  assert_eq(parse_stash(["--version"]), Version);
  assert_eq(parse_stash(["put", "-V"]), Version);
  assert_eq(reply(stash(), parse_stash(["-V"])), Err({ text: "stash 1.4.0", code: 0 }))
}

test "a flag not given on the command line takes its value from the settings, and a flag given on the command line overrides the setting" {
  let settings = [{ key: "STASH_LEVEL", value: "3" }, { key: "STASH_COLOR", value: "false" }];
  let put = |line: List<String>| parse_with(stash(), line, order_of, settings);
  assert_eq(put(["put", "notes"]), Run(putting(0, { ..plain("notes", []), level: 3 })));
  assert_eq(put(["put", "-l8", "notes"]), Run(putting(0, { ..plain("notes", []), level: 8 })));
  assert_eq(put(["list"]), Run(listing(0, { format: Table, color: Some(false), pattern: "*" })));
  assert_eq(
    put(["list", "--color"]),
    Run(listing(0, { format: Table, color: Some(true), pattern: "*" })),
  );
  let on = parse_with(stash(), ["list"], order_of, [{ key: "STASH_COLOR", value: "true" }]);
  assert_eq(on, Run(listing(0, { format: Table, color: Some(true), pattern: "*" })));
  let duplicate_faults = [
    { key: "STASH_LEVEL", value: "1" },
    { key: "STASH_LEVEL", value: "2" },
    { key: "OTHER", value: "x" },
  ];
  assert_eq(
    parse_with(stash(), ["put", "notes"], order_of, duplicate_faults),
    Run(putting(0, { ..plain("notes", []), level: 1 })),
  )
}

test "a setting whose value its flag does not accept is rejected, naming the key" {
  let level = parse(stash(), ["put", "notes"], [{ key: "STASH_LEVEL", value: "high" }]);
  let color = parse(stash(), ["list"], [{ key: "STASH_COLOR", value: "yes" }]);
  assert_eq(
    level,
    Failed({
      path: ["put"],
      reason: InvalidSetting("STASH_LEVEL", "level", "high", "a whole number is required"),
    }),
  );
  assert_eq(
    color,
    Failed({
      path: ["list"],
      reason: InvalidSetting("STASH_COLOR", "color", "yes", "`true` or `false` is required"),
    }),
  );
  match level {
    Failed(rejection) ->
      assert_eq(
        error_message(stash(), rejection),
        "invalid value 'high' for '--level <N>' from the setting `STASH_LEVEL`: a whole number is required",
      ),
    _ -> panic("the setting was rejected"),
  };
  assert_eq(
    parse(stash(), ["put"], [{ key: "STASH_LEVEL", value: "high" }]),
    Failed({ path: ["put"], reason: MissingPositionals(["NAME"]) }),
  )
}

test "`settings` returns the configuration values for the keys the flags name, and ignores other keys" {
  assert_eq(keys(stash()), ["STASH_LEVEL", "STASH_COLOR"]);
  let config_values = config::values(
    [{ key: "STASH_LEVEL", value: "2" }, { key: "HOME", value: "/" }],
    [],
  );
  let parse_stash = handle {
    settings[app](stash())
  } with {
    config.get[app](key) -> config::get_value(config_values, key),
  };
  assert_eq(parse_stash, [{ key: "STASH_LEVEL", value: "2" }])
}

test "when the function that converts parsed arguments returns an error, parsing fails with that message and the usage of the subcommand typed" {
  let closed = parse_with(stash(), ["list", "-v"], |_: Parsed| {
    let none: Result<Order, String> = Err("no stash is open here");
    none
  });
  assert_eq(closed, Failed({ path: ["list"], reason: Rejected("no stash is open here") }));
  assert_eq(
    reply(stash(), closed),
    Err({
      text: "error: no stash is open here\n\nUsage: stash list [OPTIONS] [PATTERN]\n\nFor more information, try '--help'.",
      code: 2,
    }),
  )
}

type CodecCase = { word: String, int: Option<Int>, size: Option<Int>, span: Option<Duration> }

fn codec_cases() -> List<CodecCase> =
  [
    { word: "0", int: Some(0), size: Some(0), span: Some(Duration(0)) },
    { word: "42", int: Some(42), size: Some(42), span: None },
    { word: "-7", int: Some(0 - 7), size: Some(0 - 7), span: None },
    { word: "+7", int: None, size: None, span: None },
    { word: "", int: None, size: None, span: None },
    { word: "1.5", int: None, size: Some(2), span: None },
    { word: "1.5kB", int: None, size: Some(1500), span: None },
    { word: "64MiB", int: None, size: Some(67108864), span: None },
    { word: "90s", int: None, size: None, span: Some(Duration(90000000000)) },
    { word: "1h30m", int: None, size: None, span: Some(Duration(5400000000000)) },
    { word: "-250ms", int: None, size: None, span: Some(Duration(0 - 250000000)) },
    { word: "9223372036854775808", int: None, size: None, span: None },
  ]

test "the word {show(c.word)} decodes with the `int`, `size` and `duration` codecs to the expected values, or fails" for c: CodecCase in codec_cases(
  ) {
  assert_eq(int().decode(c.word).ok(), c.int);
  assert_eq(size().decode(c.word).ok(), c.size);
  assert_eq(duration().decode(c.word).ok(), c.span)
}

test "a codec encodes a value to a word that decodes back to it, and rejects invalid words with an error message" {
  assert_eq(int().encode(0 - 12), "-12");
  assert_eq(size().encode(67108864), "67108864");
  assert_eq(duration().encode(Duration(5400000000000)), "1h30m");
  assert_eq(float().encode(0.25), "0.25");
  assert_eq(float().decode("2.5e-1"), Ok(0.25));
  assert_eq(float().decode("half"), Err("a number is required"));
  assert_eq(text().decode(""), Ok(""));
  assert_eq(path().decode("a/b"), Ok("a/b"));
  assert_eq(path().decode(""), Err("a path must not be empty"));
  let formats = one_of([{ name: "table", value: Table }, { name: "lines", value: Lines }]);
  assert_eq((formats.decode)("lines"), Ok(Lines));
  assert_eq((formats.decode)("json"), Err("not one of table, lines"));
  assert_eq((formats.encode)(Table), "table");
  assert_eq(formats.choices, ["table", "lines"])
}

test "an `arg`'s flag first applies its own check and then the codec's check, and a choice codec gives the flag a list of allowed values" {
  let even = arg(
    with_check(valued("jobs", "N", Positive, "Workers."), |word: String|
      if word.ends_with("0") { Ok(()) } else { Err("a round number is required") }),
    int(),
  );
  assert_eq(even.flag.check("10"), Ok(()));
  assert_eq(even.flag.check("7"), Err("a round number is required"));
  assert_eq(even.flag.check("x0"), Err("a whole number is required"));
  assert_eq(even.flag.kind, Positive);
  assert_eq(format().flag.kind, Choice(["table", "lines"]))
}

test "a typed flag's value is the value given on the command line, else its default, else `None`" {
  let p = match parse(stash(), ["put", "notes", "-t", "a", "-tb", "--keep", "2s"]) {
    Run(parsed) -> parsed,
    _ -> panic("the line runs"),
  };
  assert_eq(get(p, level()), Some(6));
  assert_eq(get(p, keep()), Some(Duration(2000000000)));
  assert_eq(get(p, most()), None);
  assert_eq(get_or(p, most(), 1024), 1024);
  assert_eq(all(p, tag()), ["a", "b"]);
  assert_eq(required(p, keep()), Ok(Duration(2000000000)));
  assert_eq(
    required(p, most()),
    Err("the following required arguments were not provided:\n  --most <SIZE>"),
  );
  let listed = match parse(stash(), ["list"]) {
    Run(parsed) -> parsed,
    _ -> panic("the line runs"),
  };
  assert_eq(value(listed, "format"), Some("table"));
  assert_eq(get(listed, format()), Some(Table));
  let tint = arg(with_default(valued("color", "COLOR", Text, "Colour."), "auto"), text());
  let ran = run_of(parse(fixture(), ["run"]));
  assert_eq(value(ran, "color"), None);
  assert_eq(get(ran, tint), Some("auto"));
  assert_eq(given(format(), Lines), { long: "format", value: Some("lines") });
  assert_eq(on(dry_run()), { long: "dry-run", value: None });
  assert_eq(off(color()), { long: "no-color", value: None })
}

test "`arguments` rebuilds a parsed command line as arguments that parse to the same result" {
  let line = ["-v", "put", "-nt", "x", "notes", "a.txt", "--level=2", "-v"];
  let p = match parse(stash(), line) { Run(parsed) -> parsed, _ -> panic("the line runs") };
  let back = arguments(stash(), p);
  assert_eq(back, [
    "put",
    "--verbose",
    "--dry-run",
    "--tag=x",
    "--level=2",
    "--verbose",
    "--",
    "notes",
    "a.txt",
  ]);
  assert_eq(parse(stash(), back), Run(p))
}

fn broken() -> Spec =
  {
    bin: "broken",
    version: "0",
    root: with_subs(
      command("", "Wrong on purpose.", [switch("json", "As JSON."), switch("json", "Again.")]),
      [
        with_positionals(
          command("go", "Go.", [
            requiring(switch("fast", "Quickly."), ["turbo"]),
            conflicting(switch("slow", "Slowly."), ["slow", "json"]),
            with_default(valued("jobs", "N", Positive, "Workers."), "0"),
            with_short(switch("version", "Mine."), "V"),
            negatable(valued("name", "", Text, "A name.")),
            with_default(switch("loud", "Loudly."), "yes"),
            with_short(negatable(switch("cache", "Keep it.")), "cc"),
            switch("no-cache", "Do not."),
            valued("when", "WHEN", Choice([]), "When."),
          ]),
          [
            defaulted("FROM", "From.", "."),
            many(positional("FILES", "Files.")),
            required_unless(positional("LAST", "Last."), "all"),
          ],
        ),
        command("help", "Mine.", []),
        command("go", "Again.", []),
        with_subs(with_trailing(command("deep", "Deeper.", [])), [command("er", "Deepest.", [])]),
      ],
    ),
  }

fn found(path: List<String>, about: String, reason: String) -> Fault =
  { path: path, about: about, reason: reason }

test "`faults` lists every error in a command declaration, with its command path, the flag and the reason" {
  assert_eq(faults(broken()), [
    found([], "--json", "is declared twice"),
    found([], "go", "is declared twice"),
    found([], "help", "the parser handles `help` itself"),
    found(["go"], "--fast", "requires `--turbo`, but no flag with that name is declared"),
    found(["go"], "--slow", "conflicts with itself"),
    found(["go"], "--jobs", "its default `0` is not a value this flag accepts"),
    found(
      ["go"],
      "--version",
      "`help` and `version` are reserved for the built-in flags, so no flag can use them as its name",
    ),
    found(
      ["go"],
      "--version",
      "`-V` is reserved for a built-in flag, so no flag can use it as its short name",
    ),
    found(["go"], "--name", "the flag takes a value, so it needs a value name for the help text"),
    found(["go"], "--name", "only a switch that cannot be repeated can have a `--no-` form"),
    found(
      ["go"],
      "--loud",
      "a switch takes no value, so it cannot have a default or a bare value (the value used when the flag is given without one)",
    ),
    found(["go"], "--cache", "its short `cc` must be one character other than `-` and `=`"),
    found(["go"], "--cache", "its `--no-` form is already the name of another flag"),
    found(["go"], "--when", "the flag has an empty list of choices"),
    found(["go"], "<FILES>", "takes every remaining word, so none can follow it"),
    found(
      ["go"],
      "<FILES>",
      "is required but follows an optional argument, so a command line with fewer words cannot show which argument each word is for",
    ),
    found(
      ["go"],
      "<LAST>",
      "can be left out when `--all` is given, but no flag with that name is declared",
    ),
    found(["deep"], "deep", "has commands under it, so it takes no words of its own"),
  ]);
  assert(!well_formed(broken()))
}

test "a declaration with nothing wrong has no fault" {
  assert_eq(faults(stash()), []);
  assert_eq(faults(fixture()), []);
  assert(well_formed(stash()))
}

law "the tool's declaration has no fault" { well_formed(stash()) }

fn jobs() -> gen::Gen<Job> =
  gen::one_of([
    gen::map(arbitrary_put_options(), |f0: PutOptions| Putting(f0)),
    gen::map(arbitrary_list_options(), |f0: ListOptions| Listing(f0)),
  ])

fn arbitrary_put_options() -> gen::Gen<PutOptions> =
  gen::and_then(gen::text(), |name: String|
    gen::and_then(gen::list(gen::text()), |files: List<String>|
      gen::and_then(gen::any_int(), |level: Int|
        gen::map4(
          gen::option_of(gen::map(gen::any_int(), |n: Int| Duration(n))),
          gen::option_of(gen::any_int()),
          gen::list(gen::text()),
          modes(),
          |keep: Option<Duration>, most: Option<Int>, tags: List<String>, mode: Mode|
            {
              name: name,
              files: files,
              level: level,
              keep: keep,
              most: most,
              tags: tags,
              mode: mode,
            },
        ))))

fn modes() -> gen::Gen<Mode> = gen::elements([Write, DryRun, Force])

fn arbitrary_list_options() -> gen::Gen<ListOptions> =
  gen::map3(
    formats(),
    gen::option_of(gen::bool()),
    gen::text(),
    |format: Format, color: Option<Bool>, pattern: String|
      { format: format, color: color, pattern: pattern },
  )

fn formats() -> gen::Gen<Format> = gen::elements([Table, Lines])

test "any `stash` run command converted to a command line by `line_of` parses back to the same command" {
  gen::check(jobs(), |x: Job|
    round_trip(
      |job: Job| line_of({ verbosity: 0, job: job }),
      |line: List<String>| match parse_stash(line) { Run(order) -> Some(order.job), _ -> None },
      x,
    ))
}

fn has_reply(line: List<String>) -> Bool / {abort.raise} =
  match reply(stash(), parse_stash(line), Some(40)) {
    Ok(_) -> true,
    Err(failure) -> failure.code == 0 || failure.code == 2,
  }

test "parsing any list of words for the `stash` example program returns a result or a usage error, never a crash" {
  gen::check(gen::list(gen::text()), |line: List<String>| { has_reply(line) })
}

fn stash_bash() -> String =
  \\# bash completion for stash
  \\_stash() {
  \\    local cur prev path word skip i
  \\    cur="${COMP_WORDS[COMP_CWORD]}"
  \\    prev="${COMP_WORDS[COMP_CWORD-1]}"
  \\    if [[ $cur == "=" ]]; then cur=""; fi
  \\    if [[ $prev == "=" ]]; then prev="${COMP_WORDS[COMP_CWORD-2]}"; fi
  \\    path=""
  \\    skip=0
  \\    for ((i = 1; i < COMP_CWORD; i++)); do
  \\        word="${COMP_WORDS[i]}"
  \\        if ((skip)); then [[ $word == "=" ]] || skip=0; continue; fi
  \\        case "$path $word" in
  \\            " put") path="put" ;;
  \\            " list") path="list" ;;
  \\            "put --level"|"put -l"|"put --keep"|"put --most"|"put --tag"|"put -t") skip=1 ;;
  \\            "list --format") skip=1 ;;
  \\        esac
  \\    done
  \\    COMPREPLY=()
  \\    case "$path" in
  \\        "")
  \\            COMPREPLY=($(compgen -W "put list help --verbose -v --help -h --version -V" -- "$cur"))
  \\            ;;
  \\        "put")
  \\            case "$prev" in
  \\                --level|-l) return ;;
  \\                --keep) return ;;
  \\                --most) return ;;
  \\                --tag|-t) return ;;
  \\            esac
  \\            COMPREPLY=($(compgen -W "--level -l --keep --most --tag -t --dry-run -n --force --verbose -v --help -h --version -V" -- "$cur"))
  \\            ;;
  \\        "list")
  \\            case "$prev" in
  \\                --format) COMPREPLY=($(compgen -W "table lines" -- "$cur")); return ;;
  \\            esac
  \\            COMPREPLY=($(compgen -W "--format --color --no-color --verbose -v --help -h --version -V" -- "$cur"))
  \\            ;;
  \\    esac
  \\}
  \\complete -o default -F _stash stash
  \\

fn stash_zsh() -> String =
  \\#compdef stash
  \\
  \\_stash() {
  \\    local line state
  \\    _arguments -s -S -C \
  \\        '*'{-v,--verbose}'[Print more output. Repeat for more.]' \
  \\        '(- *)'{-h,--help}'[Print help]' \
  \\        '(- *)'{-V,--version}'[Print version]' \
  \\        '1: :->command' \
  \\        '*:: :->args'
  \\    case $state in
  \\        command)
  \\            local -a commands
  \\            commands=(
  \\                'put:Store files under a name'
  \\                'list:List the entries'
  \\                'help:Print this message or the help of the given subcommand(s)'
  \\            )
  \\            _describe -t commands command commands
  \\            ;;
  \\        args)
  \\            case $line[1] in
  \\                put) _stash_put ;;
  \\                list) _stash_list ;;
  \\            esac
  \\            ;;
  \\    esac
  \\}
  \\
  \\_stash_put() {
  \\    _arguments -s -S \
  \\        '(-l --level)'{-l+,--level=}'[How hard to compress.]:N:_files' \
  \\        --keep='[Drop the entry once it is this old.]:SPAN:_files' \
  \\        --most='[Reject an entry larger than this.]:SIZE:_files' \
  \\        '*'{-t+,--tag=}'[A label to find it by. Repeatable.]:TAG:_files' \
  \\        '(-n --dry-run)'{-n,--dry-run}'[Say what would be stored, and store nothing.]' \
  \\        --force'[Write over an entry of the same name.]' \
  \\        '*'{-v,--verbose}'[Print more output. Repeat for more.]' \
  \\        '(- *)'{-h,--help}'[Print help]' \
  \\        '(- *)'{-V,--version}'[Print version]' \
  \\        ':NAME:_files' \
  \\        '*:FILES:_files'
  \\}
  \\
  \\_stash_list() {
  \\    _arguments -s -S \
  \\        --format='[How to print the entries.]:FORMAT:(table lines)' \
  \\        --color'[Colour the names.]' \
  \\        --no-color'[Colour the names.]' \
  \\        '*'{-v,--verbose}'[Print more output. Repeat for more.]' \
  \\        '(- *)'{-h,--help}'[Print help]' \
  \\        '(- *)'{-V,--version}'[Print version]' \
  \\        '::PATTERN:_files'
  \\}
  \\
  \\if [ "$funcstack[1]" = "_stash" ]; then
  \\    _stash "$@"
  \\else
  \\    compdef _stash stash
  \\fi
  \\

fn stash_fish() -> String =
  \\# fish completion for stash
  \\complete -c stash -s v -l verbose -d 'Print more output. Repeat for more.'
  \\complete -c stash -n "__fish_use_subcommand" -f -a put -d 'Store files under a name'
  \\complete -c stash -n "__fish_use_subcommand" -f -a list -d 'List the entries'
  \\complete -c stash -n "__fish_use_subcommand" -f -a help -d 'Print this message or the help of the given subcommand(s)'
  \\complete -c stash -n "__fish_seen_subcommand_from put" -s l -l level -r -d 'How hard to compress.'
  \\complete -c stash -n "__fish_seen_subcommand_from put" -l keep -r -d 'Drop the entry once it is this old.'
  \\complete -c stash -n "__fish_seen_subcommand_from put" -l most -r -d 'Reject an entry larger than this.'
  \\complete -c stash -n "__fish_seen_subcommand_from put" -s t -l tag -r -d 'A label to find it by. Repeatable.'
  \\complete -c stash -n "__fish_seen_subcommand_from put" -s n -l dry-run -d 'Say what would be stored, and store nothing.'
  \\complete -c stash -n "__fish_seen_subcommand_from put" -l force -d 'Write over an entry of the same name.'
  \\complete -c stash -n "__fish_seen_subcommand_from list" -l format -x -a 'table lines' -d 'How to print the entries.'
  \\complete -c stash -n "__fish_seen_subcommand_from list" -l color -d 'Colour the names.'
  \\complete -c stash -n "__fish_seen_subcommand_from list" -l no-color -d 'Colour the names.'
  \\complete -c stash -s h -l help -d 'Print help'
  \\complete -c stash -s V -l version -d 'Print version'
  \\

fn stash_man() -> String =
  \\.TH "STASH" 1 "" "stash 1.4.0"
  \\.SH NAME
  \\stash \- Keep files for later
  \\.SH SYNOPSIS
  \\stash [OPTIONS] <COMMAND>
  \\.SH OPTIONS
  \\.TP
  \\\fB\-v\fR, \fB\-\-verbose\fR
  \\Print more output. Repeat for more.
  \\.TP
  \\\fB\-h\fR, \fB\-\-help\fR
  \\Print help
  \\.TP
  \\\fB\-V\fR, \fB\-\-version\fR
  \\Print version
  \\.SH COMMANDS
  \\.TP
  \\\fBput\fR
  \\Store files under a name
  \\.TP
  \\\fBlist\fR
  \\List the entries
  \\

fn stash_put_man() -> String =
  \\.TH "STASH\-PUT" 1 "" "stash 1.4.0"
  \\.SH NAME
  \\stash\-put \- Store files under a name
  \\.SH SYNOPSIS
  \\stash put [OPTIONS] <NAME> [FILES]...
  \\.SH ARGUMENTS
  \\.TP
  \\\fI<NAME>\fR
  \\What to call the entry.
  \\.TP
  \\\fI[FILES]...\fR
  \\The files to store; defaults to the working directory.
  \\.SH OPTIONS
  \\.TP
  \\\fB\-l\fR, \fB\-\-level\fR \fIN\fR
  \\How hard to compress. [setting: STASH_LEVEL] [default: 6]
  \\.TP
  \\\fB\-\-keep\fR \fISPAN\fR
  \\Drop the entry once it is this old.
  \\.TP
  \\\fB\-\-most\fR \fISIZE\fR
  \\Reject an entry larger than this.
  \\.TP
  \\\fB\-t\fR, \fB\-\-tag\fR \fITAG\fR
  \\A label to find it by. Repeatable.
  \\.TP
  \\\fB\-n\fR, \fB\-\-dry\-run\fR
  \\Say what would be stored, and store nothing.
  \\.TP
  \\\fB\-\-force\fR
  \\Write over an entry of the same name.
  \\.TP
  \\\fB\-v\fR, \fB\-\-verbose\fR
  \\Print more output. Repeat for more.
  \\.TP
  \\\fB\-h\fR, \fB\-\-help\fR
  \\Print help
  \\.TP
  \\\fB\-V\fR, \fB\-\-version\fR
  \\Print version
  \\

type Script = { shell: Shell, text: String }

fn scripts() -> List<Script> =
  [
    { shell: Bash, text: stash_bash() },
    { shell: Zsh, text: stash_zsh() },
    { shell: Fish, text: stash_fish() },
  ]

test "stash's completion script for {show(c.shell)}" for c: Script in scripts() {
  assert_eq(completion(stash(), c.shell), c.text)
}

test "stash's manual pages, the program's and a command's" {
  assert_eq(man_page(stash(), []), stash_man());
  assert_eq(man_page(stash(), ["put"]), stash_put_man());
  assert_eq(man_page(stash(), ["nowhere"]), stash_man())
}

test "a nested command such as `cache clear` completes with its own and its parent's flags in bash, zsh and fish" {
  let bash = completion(fixture(), Bash);
  assert(bash.contains("\"cache clear\") path=\"cache clear\" ;;"));
  assert(bash.contains("        \"cache clear\")\n"));
  assert(bash.contains("\"cache clear --color\") skip=1 ;;"));
  let zsh = completion(fixture(), Zsh);
  assert(zsh.contains("_fx_cache_clear() {"));
  assert(zsh.contains("                clear) _fx_cache_clear ;;"));
  assert(zsh.contains("--color='[Colour.]:COLOR:(auto always never)'"));
  let fish = completion(fixture(), Fish);
  assert(
    fish.contains(
      "-n \"__fish_seen_subcommand_from cache; and not __fish_seen_subcommand_from clear inspect help\" -f -a clear -d 'Discard it'",
    ),
  );
  assert(
    fish.contains(
      "-n \"__fish_seen_subcommand_from cache; and __fish_seen_subcommand_from clear\" -l json -d 'As JSON.'",
    ),
  )
}

test "`description` converts a spec with nested commands, flags and positionals into JSON" {
  let small: Spec = {
    bin: "t",
    version: "2",
    root: with_subs(command("", "Top.", [negatable(switch("color", "Colour."))]), [
      with_trailing(
        with_positionals(
          command("go", "Go.", [
            with_setting(
              with_short(
                with_default(valued("when", "WHEN", Choice(["now", "later"]), "When."), "now"),
                "w",
              ),
              "T_WHEN",
            ),
          ]),
          [many(defaulted("FILES", "Files.", "."))],
        ),
      ),
    ]),
  };
  assert_eq(
    json::to_string(description(small)),
    "{\"bin\":\"t\",\"command\":{\"about\":\"Top.\",\"commands\":[{\"about\":\"Go.\",\"commands\":[],\"flags\":[{\"bare_value\":null,\"choices\":[\"now\",\"later\"],\"conflicts\":[],\"default\":\"now\",\"help\":\"When.\",\"kind\":\"choice\",\"long\":\"when\",\"negatable\":false,\"repeatable\":false,\"requires\":[],\"setting\":\"T_WHEN\",\"short\":\"w\",\"value_name\":\"WHEN\"}],\"name\":\"go\",\"positionals\":[{\"default\":\".\",\"help\":\"Files.\",\"many\":true,\"name\":\"FILES\",\"required\":false,\"unless\":null}],\"trailing\":true}],\"flags\":[{\"bare_value\":null,\"choices\":[],\"conflicts\":[],\"default\":null,\"help\":\"Colour.\",\"kind\":\"switch\",\"long\":\"color\",\"negatable\":true,\"repeatable\":false,\"requires\":[],\"setting\":null,\"short\":null,\"value_name\":null}],\"name\":\"\",\"positionals\":[],\"trailing\":false},\"version\":\"2\"}",
  )
}

test "completion scripts omit names containing spaces, and quote text that has shell special characters" {
  let odd: Spec = {
    bin: "odd-tool",
    version: "0",
    root: with_subs(
      command("", "Odd.", [
        valued("pick", "ONE", Choice(["plain", "two words", "$(rm)"]), "It's [one]: `this`."),
        switch("we ird", "Never offered."),
      ]),
      [command("fine", "Fine.", []), command("not fine", "Left out.", [])],
    ),
  };
  let bash = completion(odd, Bash);
  assert(bash.contains("_odd_tool() {"));
  assert(bash.contains("complete -o default -F _odd_tool odd-tool"));
  assert(bash.contains("compgen -W \"plain\" -- \"$cur\")); return ;;"));
  assert(bash.contains("compgen -W \"fine help --pick --help -h --version -V\""));
  assert(!bash.contains("rm"));
  let zsh = completion(odd, Zsh);
  assert(zsh.contains("--pick='[It'\\''s \\[one\\]\\: \\`this\\`.]:ONE:(plain)'"));
  assert(!zsh.contains("ird"));
  let fish = completion(odd, Fish);
  assert(fish.contains("-l pick -x -a 'plain' -d 'It\\'s [one]: `this`.'"));
  assert(!fish.contains("not fine"));
  assert(man_page(odd, ["fine"]).contains(".TH \"ODD\\-TOOL\\-FINE\" 1 \"\" \"odd\\-tool 0\""))
}

fn fixture() -> Spec = {
  let run = with_trailing(
    with_positionals(
      command("run", "Run it.", [
        switch("verbose", "Say more."),
        with_short(valued("jobs", "N", Positive, "Worker threads."), "j"),
        valued("name", "NAME", Text, "A name."),
        with_default(valued("when", "WHEN", Choice(["auto", "never"]), "When."), "auto"),
        repeated(valued("dep", "DEP", Text, "A dependency.")),
        with_bare_value(valued("show", "MODULE", Text, "What to show."), "*"),
      ]),
      [defaulted("PATH", "Where.", ".")],
    ),
  );
  let clear = with_positionals(command("clear", "Discard it.", [switch("json", "As JSON.")]), [
    defaulted("PATH", "Where.", "."),
  ]);
  let inspect = with_positionals(command("inspect", "Look.", []), [positional("DEF", "Which.")]);
  let cache = with_subs(command("cache", "The cache.", []), [clear, inspect]);
  let explain = with_extra(
    with_positionals(
      command("explain", "Say what a code means.", [
        switch("all", "Every code."),
        valued("width", "N", Nat, "Columns."),
      ]),
      [required_unless(positional("CODE", "Which."), "all")],
    ),
    |p: Parsed|
      if has(p, "all") && value(p, "width") == Some("0") {
        Err(
          "`--all` cannot print every diagnostic code when `--width` is 0, because the output would have no columns",
        )
      } else { Ok(()) },
  );
  let root = command("", "the fixture tool", [
    with_default(valued("color", "COLOR", Choice(["auto", "always", "never"]), "Colour."), "auto"),
  ]);
  {
    bin: "fx",
    version: "1.2.3",
    root: with_subs(root, [
      run,
      cache,
      command("build", "Build it.", [switch("json", "As JSON.")]),
      explain,
    ]),
  }
}

fn run_of(outcome: Outcome<Parsed>) -> Parsed / {abort.raise} =
  match outcome { Run(p) -> p, _ -> panic("the line was rejected, not run") }

fn rejected_of(outcome: Outcome<Parsed>) -> String / {abort.raise} =
  match outcome {
    Failed(rejection) -> error_text(fixture(), rejection),
    _ -> panic("the line ran, was not rejected"),
  }

fn help_of(argv: List<String>) -> String / {abort.raise} =
  match parse(fixture(), argv) {
    Help(path) -> help(fixture(), path),
    _ -> panic("the line asked for no help"),
  }

test "a bare command line parses with the defaults" {
  let p = run_of(parse(fixture(), ["run"]));
  assert_eq(p.path, ["run"]);
  assert_eq(p.positionals, ["."]);
  assert_eq(p.argv, []);
  assert(!has(p, "verbose"));
  assert_eq(value(p, "jobs"), None);
  assert_eq(p.flags, [{ long: "when", value: Some("auto") }])
}

test "flags parse as `--name value` and `--name=value`, and a global flag is accepted before or after the command" {
  let p = run_of(
    parse(fixture(), ["--color", "never", "run", "--verbose", "--jobs=4", "--name", "x"]),
  );
  assert(has(p, "verbose"));
  assert_eq(value(p, "color"), Some("never"));
  assert_eq(value(p, "jobs"), Some("4"));
  assert_eq(nat_value(p, "jobs"), Some(4));
  assert_eq(value(p, "name"), Some("x"));
  let fused = run_of(parse(fixture(), ["run", "--color=never"]));
  assert_eq(value(fused, "color"), Some("never"));
  let under = run_of(parse(fixture(), ["cache", "clear", "--color=always"]));
  assert_eq(value(under, "color"), Some("always"))
}

test "a short flag takes its value attached (`-j4`), after `=`, or as the next word" {
  assert_eq(value(run_of(parse(fixture(), ["run", "-j4"])), "jobs"), Some("4"));
  assert_eq(value(run_of(parse(fixture(), ["run", "-j=4"])), "jobs"), Some("4"));
  assert_eq(value(run_of(parse(fixture(), ["run", "-j", "4"])), "jobs"), Some("4"))
}

test "a repeatable flag collects every value in order" {
  let p = run_of(parse(fixture(), ["run", "--dep", "a", "--dep=b"]));
  assert_eq(values_of(p, "dep"), ["a", "b"]);
  assert_eq(values_of(p, "jobs"), [])
}

test "for a command that forwards arguments, words after `--` are passed to the program unparsed" {
  let p = run_of(parse(fixture(), ["run", "m.ply", "--", "--json", "-x"]));
  assert_eq(p.positionals, ["m.ply"]);
  assert_eq(p.argv, ["--json", "-x"]);
  assert(!has(p, "json"));
  assert_eq(arguments(fixture(), p), ["run", "--when=auto", "m.ply", "--", "--json", "-x"]);
  assert_eq(parse(fixture(), arguments(fixture(), p)), Run(p))
}

test "after `--` under a plain command every word is a positional" {
  let p = run_of(parse(fixture(), ["cache", "clear", "--", "--json"]));
  assert_eq(p.positionals, ["--json"]);
  assert(!has(p, "json"))
}

test "an unknown flag is rejected with a suggestion when one is near" {
  let text = rejected_of(parse(fixture(), ["run", "--job"]));
  assert(text.contains("unexpected argument '--job' found"));
  assert(text.contains("tip: a similar argument exists: '--jobs'"));
  assert(text.contains("Usage: fx run"));
  assert(text.trim().ends_with("For more information, try '--help'."))
}

test "an unknown flag unlike any known name is rejected without a suggestion" {
  let text = rejected_of(parse(fixture(), ["run", "--frobnicate"]));
  assert(text.contains("unexpected argument '--frobnicate' found"));
  assert(!text.contains("tip:"))
}

test "an unknown command is rejected, and a near one is suggested" {
  let text = rejected_of(parse(fixture(), ["rn"]));
  assert(text.contains("unrecognized subcommand 'rn'"));
  assert(text.contains("tip: a similar subcommand exists: 'run'"));
  let far = rejected_of(parse(fixture(), ["frobnicate"]));
  assert(far.contains("unrecognized subcommand 'frobnicate'"));
  assert(!far.contains("tip:"))
}

test "a valued flag missing its value is rejected, and a flag word is not the value" {
  let text = rejected_of(parse(fixture(), ["run", "--jobs"]));
  assert(text.contains("a value is required for '--jobs <N>' but none was supplied"));
  let next = rejected_of(parse(fixture(), ["run", "--jobs", "--verbose"]));
  assert(next.contains("a value is required for '--jobs <N>'"))
}

test "a flag with an optional value gets the value `*` when none follows it, and giving the flag again on the command line replaces the earlier value" {
  assert_eq(value(run_of(parse(fixture(), ["run", "--show"])), "show"), Some("*"));
  assert_eq(value(run_of(parse(fixture(), ["run", "--show", "m.f"])), "show"), Some("m.f"));
  let before = run_of(parse(fixture(), ["run", "--show", "--verbose"]));
  assert_eq(value(before, "show"), Some("*"));
  assert(has(before, "verbose"));
  let duplicate_faults = run_of(parse(fixture(), ["run", "--show", "m.f", "--show"]));
  assert_eq(values_of(duplicate_faults, "show"), ["*"])
}

test "a switch takes no value" {
  let text = rejected_of(parse(fixture(), ["run", "--verbose=yes"]));
  assert(text.contains("unexpected value 'yes' for '--verbose' found"))
}

test "a number flag rejects a word, and a positive one rejects zero" {
  let word = rejected_of(parse(fixture(), ["run", "--jobs", "four"]));
  assert(word.contains("invalid value 'four' for '--jobs <N>': a number is required"));
  let zero = rejected_of(parse(fixture(), ["run", "--jobs", "0"]));
  assert(zero.contains("invalid value '0' for '--jobs <N>': a number of 1 or more is required"));
  let negative = rejected_of(parse(fixture(), ["explain", "--all", "--width=-1"]));
  assert(negative.contains("invalid value '-1' for '--width <N>': a number is required"))
}

test "a choice flag names the values it takes" {
  let text = rejected_of(parse(fixture(), ["run", "--when", "sometimes"]));
  assert(text.contains("invalid value 'sometimes' for '--when <WHEN>'"));
  assert(text.contains("[possible values: auto, never]"))
}

test "giving a flag twice on the command line keeps only its last value, and giving a flag without a value twice records it once" {
  let p = run_of(parse(fixture(), ["run", "--jobs", "4", "--jobs", "8"]));
  assert_eq(value(p, "jobs"), Some("8"));
  assert_eq(values_of(p, "jobs"), ["8"]);
  let both = run_of(parse(fixture(), ["run", "--verbose", "--verbose"]));
  assert(has(both, "verbose"));
  assert_eq(times(both, "verbose"), 1)
}

test "a subcommand parses under its command, with its own flags and positionals" {
  let p = run_of(parse(fixture(), ["cache", "clear", "--json", "tmp"]));
  assert_eq(p.path, ["cache", "clear"]);
  assert_eq(p.positionals, ["tmp"]);
  assert(has(p, "json"))
}

test "a command with subcommands but none given is rejected, naming them" {
  let text = rejected_of(parse(fixture(), ["cache"]));
  assert(
    text.contains(
      "'cache' requires a subcommand but one was not provided; try one of clear, inspect",
    ),
  );
  let root = rejected_of(parse(fixture(), []));
  assert(root.contains("error: 'fx' requires a subcommand but one was not provided\n"))
}

test "a required positional must be given, unless the flag that makes it optional is written" {
  let text = rejected_of(parse(fixture(), ["cache", "inspect"]));
  assert(text.contains("the following required arguments were not provided:\n  <DEF>"));
  assert(rejected_of(parse(fixture(), ["explain"])).contains("<CODE>"));
  assert_eq(run_of(parse(fixture(), ["explain", "--all"])).positionals, []);
  assert_eq(run_of(parse(fixture(), ["explain", "E0302"])).positionals, ["E0302"])
}

test "an extra positional argument is rejected as unexpected, including after `--`" {
  let text = rejected_of(parse(fixture(), ["cache", "clear", "a", "b"]));
  assert(text.contains("unexpected argument 'b' found"));
  let past = rejected_of(parse(fixture(), ["cache", "clear", "--", "a", "-b"]));
  assert(past.contains("unexpected argument '-b' found"))
}

test "a command's own validation runs only after the grammar rules pass, and rejects an invalid flag combination" {
  let text = rejected_of(parse(fixture(), ["explain", "--all", "--width", "0"]));
  assert_eq(
    text,
    "error: `--all` cannot print every diagnostic code when `--width` is 0, because the output would have no columns\n\nUsage: fx explain [OPTIONS] <CODE>\n\nFor more information, try '--help'.",
  );
  assert(has(run_of(parse(fixture(), ["explain", "--all", "--width", "80"])), "all"));
  assert(rejected_of(parse(fixture(), ["explain", "--width", "0"])).contains("<CODE>"))
}

test "help works at any level and stops the parse" {
  let top = help_of(["--help"]);
  assert(top.contains("the fixture tool"));
  assert(top.contains("Usage: fx [OPTIONS] <COMMAND>"));
  assert(top.contains("run"));
  assert_eq(top.count("--color <COLOR>"), 1);
  let run = help_of(["run", "--help"]);
  assert(run.contains("Run it"));
  assert(run.contains("Usage: fx run [OPTIONS] [PATH] [-- ARGS]"));
  assert(run.contains("-j, --jobs <N>"));
  assert_eq(run.count("--color <COLOR>"), 1);
  assert(run.contains("[default: auto]"));
  assert(run.contains("[possible values: auto, never]"));
  assert(run.contains("Print help"));
  assert_eq(parse(fixture(), ["run", "--help", "--frobnicate"]), Help(["run"]))
}

test "`help` followed by command names shows the help of that subcommand, and an unknown name is rejected with a suggestion" {
  assert(help_of(["help", "cache", "clear"]).contains("Discard it"));
  assert(help_of(["help"]).contains("the fixture tool"));
  assert(help_of(["cache", "help", "inspect"]).contains("Look"));
  let text = rejected_of(parse(fixture(), ["help", "cache", "clr"]));
  assert(text.contains("unrecognized subcommand 'cache'"));
  assert(text.contains("tip: a similar subcommand exists: 'cache'"))
}

test "help for a path that names no command is the top-level help" {
  assert_eq(help(fixture(), ["nowhere"]), help(fixture(), []));
  assert_eq(usage(fixture(), ["nowhere"]), "Usage: fx nowhere [OPTIONS] <COMMAND>")
}

test "version works at any level" {
  assert_eq(parse(fixture(), ["--version"]), Version);
  assert_eq(parse(fixture(), ["run", "-V"]), Version);
  assert_eq(version_line(fixture()), "fx 1.2.3")
}

test "the usage line shows what the command takes" {
  assert_eq(usage(fixture(), []), "Usage: fx [OPTIONS] <COMMAND>");
  assert_eq(usage(fixture(), ["run"]), "Usage: fx run [OPTIONS] [PATH] [-- ARGS]");
  assert_eq(usage(fixture(), ["cache"]), "Usage: fx cache [OPTIONS] <COMMAND>");
  assert_eq(usage(fixture(), ["cache", "inspect"]), "Usage: fx cache inspect [OPTIONS] <DEF>")
}

test "a suggestion for an unknown command is the nearest name within three edits, including swapped letters" {
  let near = rejected_of(parse(fixture(), ["buil"]));
  assert(near.contains("tip: a similar subcommand exists: 'build'"));
  let swapped = rejected_of(parse(fixture(), ["cahce"]));
  assert(swapped.contains("tip: a similar subcommand exists: 'cache'"))
}

test "`parse_nat` returns None for a number too large for an integer, and for empty or non-numeric text" {
  assert_eq(parse_nat("0"), Some(0));
  assert_eq(parse_nat("9223372036854775807"), Some(9223372036854775807));
  assert_eq(parse_nat("9223372036854775808"), None);
  assert_eq(parse_nat(""), None);
  assert_eq(parse_nat("4x"), None);
  assert_eq(parse_nat(" 4"), None);
  assert_eq(parse_nat("-4"), None)
}

test "the command listing includes `help`, and command descriptions are shown without their final period" {
  let top = help_of(["--help"]);
  assert(top.contains("Print this message or the help of the given subcommand(s)"));
  assert(top.contains("Run it"));
  assert(!top.contains("Run it."));
  assert(help_of(["run", "--help"]).starts_with("Run it\n"))
}

test "a flag declared on a parent command is accepted after any subcommand, and a subcommand's flag of the same name overrides it" {
  let deep: Spec = {
    bin: "t",
    version: "0",
    root: with_subs(command("", "Top.", [valued("at", "WHERE", Text, "Top's.")]), [
      with_subs(command("remote", "Remotes.", [switch("quiet", "Say less.")]), [
        command("add", "Add one.", [valued("at", "WHERE", Text, "Add's.")]),
        command("list", "List them.", []),
      ]),
    ]),
  };
  let listed = run_of(parse(deep, ["remote", "--quiet", "list", "--at=x"]));
  assert_eq(listed.flags, [{ long: "quiet", value: None }, { long: "at", value: Some("x") }]);
  assert(has(run_of(parse(deep, ["remote", "list", "--quiet"])), "quiet"));
  assert_eq(
    parse(deep, ["--quiet", "remote", "list"]),
    Failed({ path: [], reason: UnknownFlag("--quiet", None) }),
  );
  let page = help(deep, ["remote", "add"]);
  assert(page.contains("--at <WHERE>  Add's."));
  assert(page.contains("--quiet"));
  assert(page.contains("--at <WHERE>  Top's."))
}
