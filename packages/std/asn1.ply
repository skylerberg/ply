test "`decode` fails on the malformed DER bytes {c.name}, reporting the byte offset and the reason for the error" for c: RejectedInput in rejected_inputs(
  ) { assert_eq(decode(c.der, 4), Err({ at: c.at, reason: c.reason })) }

type CursorRead =
  | AnInt
  | AMagnitude
  | ATime
  | NamedBits
  | AnOctetString
  | ADefaultOfFalse
  | ASequence
  | IntsInSequence
  | PairsInSequence
  | IntsInSet
  | AnExplicitInt
  | AnImplicitInt

fn unit<a>(read: ReadResult<a>) -> ReadResult<Unit> = { value: (), rest: read.rest }

fn two_ints(r: Reader) -> ReadResult<Int> / {asn1.fail, abort.raise} = read_int(read_int(r).rest)

fn run_read(ask: CursorRead, r: Reader) -> ReadResult<Unit> / {asn1.fail, abort.raise} =
  match ask {
    AnInt -> unit(read_int(r)),
    AMagnitude -> unit(read_unsigned(r)),
    ATime -> unit(read_time(r)),
    NamedBits -> unit(read_named_bits(r)),
    AnOctetString -> unit(read_octet_string(r)),
    ADefaultOfFalse -> unit(read_default(r, universal(1), false, read_boolean)),
    ASequence -> unit(within(read_sequence(r), read_null)),
    IntsInSequence -> unit(read_sequence_of(r, read_int)),
    PairsInSequence -> unit(read_sequence_of(r, two_ints)),
    IntsInSet -> unit(read_set_of(r, read_int)),
    AnExplicitInt -> unit(read_explicit(r, context(0), read_int)),
    AnImplicitInt -> unit(read_implicit(r, context(2), read_int)),
  }

type RejectedRead = { name: String, read: CursorRead, der: Bytes, at: Int, reason: ErrorKind }

fn rejected_read(
  name: String,
  ask: CursorRead,
  der: Bytes,
  at: Int,
  reason: ErrorKind,
) -> RejectedRead = { name: name, read: ask, der: der, at: at, reason: reason }

fn rejected_reads() -> List<RejectedRead> / {abort.raise} =
  [
    rejected_read(
      "an INTEGER of sixty-five bits as an Int",
      AnInt,
      Bytes::of_hex("0209008000000000000000"),
      2,
      TooWide,
    ),
    rejected_read(
      "a BOOLEAN as an INTEGER",
      AnInt,
      Bytes::of_hex("0101ff"),
      0,
      WrongTag(universal(1)),
    ),
    rejected_read("nothing as an INTEGER", AnInt, b"", 0, Truncated),
    rejected_read(
      "a negative INTEGER as a magnitude",
      AMagnitude,
      Bytes::of_hex("020180"),
      2,
      Negative,
    ),
    rejected_read(
      "a GeneralizedTime in 2049 as a certificate's time",
      ATime,
      b"\x18\x0f20491231235959Z",
      0,
      WrongTimeType,
    ),
    rejected_read(
      "a GeneralizedTime in 1950 as a certificate's time",
      ATime,
      b"\x18\x0f19500101000000Z",
      0,
      WrongTimeType,
    ),
    rejected_read(
      "a GeneralizedTime with a fraction as a certificate's time",
      ATime,
      b"\x18\x1120500101000000.5Z",
      0,
      WrongTimeType,
    ),
    rejected_read(
      "a string as a certificate's time",
      ATime,
      Bytes::of_hex("0c00"),
      0,
      WrongTag(universal(12)),
    ),
    rejected_read(
      "named bits ending in a zero bit",
      NamedBits,
      Bytes::of_hex("03020680"),
      2,
      TrailingZeroBits,
    ),
    rejected_read(
      "named bits ending in a zero octet",
      NamedBits,
      Bytes::of_hex("0303008000"),
      2,
      TrailingZeroBits,
    ),
    rejected_read(
      "an OCTET STRING in pieces as an OCTET STRING",
      AnOctetString,
      Bytes::of_hex("24050403616263"),
      0,
      WrongForm,
    ),
    rejected_read(
      "a default written out",
      ADefaultOfFalse,
      Bytes::of_hex("010100"),
      0,
      DefaultEncoded,
    ),
    rejected_read(
      "a SET as a SEQUENCE",
      ASequence,
      Bytes::of_hex("3100"),
      0,
      WrongTag(universal(17)),
    ),
    rejected_read(
      "a SEQUENCE with a field too many",
      ASequence,
      Bytes::of_hex("300405000500"),
      4,
      Trailing,
    ),
    rejected_read(
      "a SEQUENCE OF with a member of another type",
      IntsInSequence,
      Bytes::of_hex("30030101ff"),
      2,
      WrongTag(universal(1)),
    ),
    rejected_read(
      "a member read as two elements",
      PairsInSequence,
      Bytes::of_hex("3006020101020102"),
      5,
      Truncated,
    ),
    rejected_read(
      "a SET OF out of order, to the cursor",
      IntsInSet,
      Bytes::of_hex("3106020102020101"),
      5,
      Unsorted,
    ),
    rejected_read(
      "two elements under an explicit tag",
      AnExplicitInt,
      Bytes::of_hex("a006020101020102"),
      5,
      Trailing,
    ),
    rejected_read(
      "a primitive element as an explicit tag",
      AnExplicitInt,
      Bytes::of_hex("8000"),
      0,
      WrongForm,
    ),
    rejected_read(
      "the type's own tag where an implicit one is asked",
      AnImplicitInt,
      Bytes::of_hex("020101"),
      0,
      WrongTag(universal(2)),
    ),
  ]

test "`decode_with` fails when its reader function reads the malformed DER bytes {c.name}, reporting the byte offset and reason" for c: RejectedRead in rejected_reads(
  ) {
  assert_eq(
    decode_with(c.der, 2, |r: Reader| run_read(c.read, r)),
    Err({ at: c.at, reason: c.reason }),
  )
}

test "an INTEGER is written as the fewest octets of its two's complement, whether built from an Int, a BigInt or octets" {
  let ints = [
    { n: 0, der: "020100" },
    { n: 127, der: "02017f" },
    { n: 128, der: "02020080" },
    { n: 256, der: "02020100" },
    { n: 0 - 1, der: "0201ff" },
    { n: 0 - 128, der: "020180" },
    { n: 0 - 129, der: "0202ff7f" },
    { n: 9223372036854775807, der: "02087fffffffffffffff" },
    { n: 0 - 9223372036854775807 - 1, der: "02088000000000000000" },
  ];
  assert_eq(
    ints.map(|c: { n: Int, der: String }| int(c.n).hex_of()),
    ints.map(|c: { n: Int, der: String }| c.der),
  );
  assert_eq(
    ints.map(|c: { n: Int, der: String }| decode_with(Bytes::of_hex(c.der), 0, read_int)),
    ints.map(|c: { n: Int, der: String }| Ok(c.n)),
  );
  assert_eq(
    ints.map(|c: { n: Int, der: String }| big_int(bigint::of_int(c.n)).hex_of()),
    ints.map(|c: { n: Int, der: String }| c.der),
  );
  let two_digits = bigint::of_int(2);
  let bigs = [
    { n: bigint::pow(two_digits, 55), der: "02080080000000000000" },
    { n: bigint::neg(bigint::pow(two_digits, 55)), der: "020780000000000000" },
    { n: bigint::pow(two_digits, 56), der: "02080100000000000000" },
    { n: bigint::pow(two_digits, 64), der: "0209010000000000000000" },
    { n: bigint::neg(bigint::pow(two_digits, 64)), der: "0209ff0000000000000000" },
    { n: bigint"123456789012345678901234567890", der: "020d018ee90ff6c373e0ee4e3f0ad2" },
    { n: bigint"-1", der: "0201ff" },
    { n: bigint::pow(two_digits, 200), der: "021a01" ++ zeros(25).hex_of() },
    { n: bigint::neg(bigint::pow(two_digits, 200)), der: "021aff" ++ zeros(25).hex_of() },
    {
      n: bigint::sub(bigint::pow(two_digits, 200), bigint::one()),
      der: "021a00" ++ b"\xff".repeat(25).hex_of(),
    },
  ];
  assert_eq(
    bigs.map(|c: { n: BigInt, der: String }| big_int(c.n).hex_of()),
    bigs.map(|c: { n: BigInt, der: String }| c.der),
  );
  assert_eq(
    bigs.map(|c: { n: BigInt, der: String }| decode_with(Bytes::of_hex(c.der), 0, read_big_int)),
    bigs.map(|c: { n: BigInt, der: String }| Ok(c.n)),
  );
  assert_eq(integer(b""), Bytes::of_hex("020100"));
  assert_eq(integer(b"\x00\x00\x01"), Bytes::of_hex("020101"));
  assert_eq(integer(b"\xff\xff\x80"), Bytes::of_hex("020180"));
  assert_eq(integer(b"\x00\x80"), Bytes::of_hex("02020080"));
  assert_eq(unsigned(b"\x80"), Bytes::of_hex("02020080"));
  assert_eq(unsigned(b"\x00\x00\x7f"), Bytes::of_hex("02017f"));
  assert_eq(unsigned(b""), Bytes::of_hex("020100"));
  assert_eq(decode_with(Bytes::of_hex("02020080"), 0, read_unsigned), Ok(b"\x80"));
  assert_eq(decode_with(Bytes::of_hex("020100"), 0, read_unsigned), Ok(b"\x00"));
  assert_eq(decode_with(Bytes::of_hex("02020080"), 0, read_integer), Ok(b"\x00\x80"));
  assert_eq(int_of_integer(b""), None);
  assert_eq(enumerated(3).hex_of(), "0a0103");
  assert_eq(decode_with(Bytes::of_hex("0a0103"), 0, read_enumerated), Ok(3))
}

test "`octet_string`, `primitive` and `constructed` write the shortest length and tag bytes, and `explicit` and `implicit` wrap or replace a tag" {
  let header_at = |der: Bytes, n: Int| der.slice(0, n).hex_of();
  assert_eq(header_at(octet_string(zeros(127)), 2), "047f");
  assert_eq(header_at(octet_string(zeros(128)), 3), "048180");
  assert_eq(header_at(octet_string(zeros(255)), 3), "0481ff");
  assert_eq(header_at(octet_string(zeros(256)), 4), "04820100");
  assert_eq(header_at(octet_string(zeros(65536)), 5), "0483010000");
  let all_times_valid = |r: Result<Bytes, ErrorKind>|
    match r { Ok(der) -> der.hex_of(), Err(_) -> "unwritable" };
  assert_eq(all_times_valid(try { primitive(context(30), b"") }), "9e00");
  assert_eq(all_times_valid(try { primitive(context(31), b"") }), "9f1f00");
  assert_eq(all_times_valid(try { primitive(context(127), b"") }), "9f7f00");
  assert_eq(all_times_valid(try { primitive(context(128), b"") }), "9f810000");
  assert_eq(all_times_valid(try { constructed(application(1), [null()]) }), "61020500");
  assert_eq(all_times_valid(try { explicit(context(3), null()) }), "a3020500");
  assert_eq(all_times_valid(try { implicit(context(2), string(Ia5String, "a")) }), "820161");
  assert_eq(all_times_valid(try { implicit(context(0), sequence([null()])) }), "a0020500");
  assert_eq(
    all_times_valid(try { implicit(universal(4), primitive(private(200), b"x")) }),
    "040178",
  );
  assert_eq(
    all_times_valid(try { implicit(universal(4), primitive(private(31), b"x")) }),
    "040178",
  );
  assert_eq(
    all_times_valid(try { implicit(universal(4), primitive(private(16384), b"x")) }),
    "040178",
  );
  assert_eq(try { primitive(context(0 - 1), b"") }, Err(BadTag));
  assert_eq(try { constructed(universal(0), []) }, Err(BadTag));
  assert_eq(try { implicit(context(1), b"") }, Err(Truncated));
  assert_eq(try { implicit(context(1), Bytes::of_hex("9f81")) }, Err(Truncated));
  assert_eq(sequence([int(1), null()]).hex_of(), "30050201010500");
  assert_eq(
    set_of([int(2), int(1), boolean(true), int(1)]).hex_of(),
    "310c0101ff020101020101020102",
  )
}

test "each string type accepts only its own characters, and writing a string with any other character fails" {
  let kinds = [
    Utf8String,
    NumericString,
    PrintableString,
    Ia5String,
    VisibleString,
    UniversalString,
    BmpString,
  ];
  assert(
    kinds.fold(true, |ok: Bool, kind: StringKind|
      ok && decode_with(string(kind, "12 34"), 0, |r: Reader| read_string(r, kind)) == Ok("12 34")),
  );
  let error_case = |kind: StringKind, text: String|
    assert_eq(try { string(kind, text) }, Err(BadText(kind)));
  error_case(NumericString, "1a");
  error_case(PrintableString, "a*b");
  error_case(PrintableString, "@");
  error_case(PrintableString, "[");
  error_case(PrintableString, "`");
  error_case(PrintableString, "{");
  error_case(PrintableString, "é");
  error_case(VisibleString, "\u{7f}");
  error_case(Ia5String, "é");
  error_case(VisibleString, "a\tb");
  error_case(BmpString, "\u{1F600}");
  assert_eq(
    try { string(PrintableString, "AZaz09 '()+,-./:=?") },
    Ok(b"\x13\x12AZaz09 '()+,-./:=?"),
  );
  assert_eq(
    try { string(UniversalString, "a\u{1F600}") },
    Ok(Bytes::of_hex("1c08000000610001f600")),
  );
  assert_eq(try { string(BmpString, "a\u{3c0}") }, Ok(Bytes::of_hex("1e04006103c0")));
  assert_eq(try { string(BmpString, "\u{ffff}") }, Ok(Bytes::of_hex("1e02ffff")))
}

test "a time is written in the single text form DER allows, and a certificate time uses UTC time or generalized time depending on its year" {
  let t = timestamp"2019-12-16T03:02:10Z";
  assert_eq(utc_time_text(t), Some("191216030210Z"));
  assert_eq(generalized_time_text(t), "20191216030210Z");
  assert_eq(generalized_time_text(timestamp"2019-12-16T03:02:10.5Z"), "20191216030210.5Z");
  assert_eq(
    generalized_time_text(timestamp"2019-12-16T03:02:10.000000001Z"),
    "20191216030210.000000001Z",
  );
  assert_eq(generalized_time_text(timestamp"0033-12-16T03:02:10Z"), "00331216030210Z");
  assert_eq(utc_time_text(timestamp"2019-12-16T03:02:10.000000001Z"), None);
  assert_eq(utc_time_text(timestamp"1949-12-31T23:59:59Z"), None);
  assert_eq(utc_time_text(timestamp"2050-01-01T00:00:00Z"), None);
  assert_eq(utc_time_text(timestamp"2049-12-31T00:00:00Z"), Some("491231000000Z"));
  assert_eq(utc_time_text(timestamp"1950-01-01T00:00:00Z"), Some("500101000000Z"));
  assert_eq(try { utc_time(timestamp"2050-01-01T00:00:00Z") }, Err(BadTime));
  assert_eq(try { time(timestamp"2049-12-31T00:00:00Z") }, Ok(b"\x17\x0d491231000000Z"));
  assert_eq(try { time(timestamp"1950-01-01T00:00:00Z") }, Ok(b"\x17\x0d500101000000Z"));
  assert_eq(try { time(timestamp"2050-01-01T00:00:00Z") }, Ok(b"\x18\x0f20500101000000Z"));
  assert_eq(try { time(timestamp"1949-12-31T00:00:00Z") }, Ok(b"\x18\x0f19491231000000Z"));
  assert_eq(try { time(timestamp"2019-12-16T03:02:10.000000005Z") }, Err(BadTime));
  assert_eq(
    decode_with(b"\x17\x0d491231000000Z", 0, read_time),
    Ok(timestamp"2049-12-31T00:00:00Z"),
  );
  assert_eq(
    decode_with(b"\x18\x0f20500101000000Z", 0, read_time),
    Ok(timestamp"2050-01-01T00:00:00Z"),
  );
  assert_eq(
    decode_with(b"\x18\x0f19491231000000Z", 0, read_time),
    Ok(timestamp"1949-12-31T00:00:00Z"),
  );
  assert_eq(
    decode_with(b"\x18\x1120191216030210.5Z", 0, read_generalized_time),
    Ok(timestamp"2019-12-16T03:02:10.5Z"),
  )
}

test "a two-digit year is read as 1950 to 2049" {
  let year = |digits: String|
    match decode_with(element(0x17, Bytes::of_string(digits ++ "0101000000Z")), 0, read_utc_time) {
      Ok(t) -> date::year(date::date_of(date::local(t))),
      Err(_) -> 0 - 1,
    };
  assert_eq(["50", "51", "99", "00", "01", "49"].map(year), [1950, 1951, 1999, 2000, 2001, 2049])
}

test "a time with an offset is written as its UTC instant, and a `Value` accepts a time only in UTC" {
  let children = timestamp"2019-12-16T05:02:10+02:00";
  assert_eq(utc_time_text(children), Some("191216030210Z"));
  assert_eq(generalized_time_text(children), "20191216030210Z");
  assert_eq(try { utc_time(children) }, Ok(b"\x17\x0d191216030210Z"));
  let late = timestamp"2049-12-31T23:30:00-01:00";
  assert_eq(utc_time_text(late), None);
  assert_eq(try { time(late) }, Ok(b"\x18\x0f20500101003000Z"));
  assert_eq(try { time(timestamp"1950-01-01T00:30:00+01:00") }, Ok(b"\x18\x0f19491231233000Z"));
  assert_eq(encode(UtcTime(children)), Err(BadTime));
  assert_eq(encode(GeneralizedTime(children)), Err(BadTime));
  assert_eq(encode(UtcTime(timestamp"2050-01-01T00:00:00Z")), Err(BadTime));
  assert_eq(encode(UtcTime(timestamp"2019-12-16T03:02:10.5Z")), Err(BadTime));
  assert_eq(encode(GeneralizedTime(date::in_utc(children))), Ok(b"\x18\x0f20191216030210Z"))
}

test "a time is read only when its date is a real calendar date" {
  let reads = |year: Int, month: Int, day: Int| {
    let text = year.to_string().pad_left(4, "0") ++ two_digits(month) ++ two_digits(day)
      ++ "000000Z";
    decode_with(element(0x18, Bytes::of_string(text)), 0, read_generalized_time).ok() != None
  };
  let days = |year: Int|
    range(1, 13).map(|month: Int| range(0, 40).filter(|day: Int| reads(year, month, day)).len());
  assert_eq(days(2023), [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]);
  assert_eq(days(2024), [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]);
  assert(reads(2000, 2, 29) && !reads(1900, 2, 29));
  assert(reads(0, 1, 1) && reads(9999, 12, 31) && !reads(2023, 0, 1) && !reads(2023, 13, 1))
}

test "`bit_at` counts bits from the high bit of the first byte, and `bits_valid` rejects unused-bit counts the bytes do not allow" {
  let bits: Bits = { unused: 6, bytes: Bytes::of_hex("6e5dc0") };
  assert_eq(range(0, 20).map(|i: Int| bit_at(bits, i)), [
    false,
    true,
    true,
    false,
    true,
    true,
    true,
    false,
    false,
    true,
    false,
    true,
    true,
    true,
    false,
    true,
    true,
    true,
    false,
    false,
  ]);
  assert(!bit_at(bits, 0 - 1));
  assert(bit_at({ unused: 7, bytes: b"\x80" }, 0) && !bit_at({ unused: 1, bytes: b"\x01" }, 7));
  assert(bits_valid({ unused: 7, bytes: b"\x80" }));
  assert(
    bits_valid(bits) && !bits_valid({ ..bits, unused: 7 }) && !bits_valid({ ..bits, unused: 8 }),
  );
  assert(bits_valid({ unused: 0, bytes: b"" }) && !bits_valid({ unused: 1, bytes: b"" }));
  assert_eq(try { bit_string({ unused: 8, bytes: b"\x00" }) }, Err(BadBits));
  assert_eq(try { bit_string(bits) }, Ok(Bytes::of_hex("0304066e5dc0")));
  assert_eq(named_bits([]).hex_of(), "030100");
  assert_eq(named_bits([0]).hex_of(), "03020780");
  assert_eq(named_bits([5, 0]).hex_of(), "03020284");
  assert_eq(named_bits([8, 0 - 3]).hex_of(), "0303070080");
  assert_eq(named_bits([7, 0]).hex_of(), "03020081");
  let usage = decode_with(named_bits([5, 0]), 0, read_named_bits);
  assert_eq(usage, Ok({ unused: 2, bytes: b"\x84" }));
  assert_eq(decode_with(named_bits([]), 0, read_named_bits), Ok({ unused: 0, bytes: b"" }))
}

type Entry = { id: Oid, critical: Bool, value: Bytes }

type Certificate = {
  version: Int,
  serial: Bytes,
  algorithm: Bytes,
  names: List<String>,
  key_id: Option<Bytes>,
  host: Option<String>,
  entries: List<Entry>,
  trailing_value: Value,
}

fn entry(r: Reader) -> ReadResult<Entry> / {asn1.fail, abort.raise} =
  within(read_sequence(r), |fields: Reader| {
    let id = read_oid(fields);
    let critical = read_default(id.rest, universal(1), false, read_boolean);
    let value = read_octet_string(critical.rest);
    { value: { id: id.value, critical: critical.value, value: value.value }, rest: value.rest }
  })

fn card(r: Reader) -> ReadResult<Certificate> / {asn1.fail, abort.raise} =
  within(read_sequence(r), |fields: Reader| {
    let version = read_default(fields, context(0), 0, |x: Reader|
      read_explicit(x, context(0), read_int));
    let serial = read_unsigned(version.rest);
    let algorithm = read_raw(serial.rest);
    let names = read_set_of(algorithm.rest, |x: Reader| read_string(x, Utf8String));
    let key_id = read_optional(names.rest, context(1), |x: Reader|
      read_implicit(x, context(1), read_octet_string));
    let host = read_optional(key_id.rest, context(2), |x: Reader|
      read_implicit(x, context(2), |y: Reader| read_string(y, Ia5String)));
    let entries = read_optional(host.rest, context(3), |x: Reader|
      read_implicit(x, context(3), |y: Reader| read_sequence_of(y, entry)));
    let rest = read_any(entries.rest);
    {
      value: {
        version: version.value,
        serial: serial.value,
        algorithm: algorithm.value,
        names: names.value,
        key_id: key_id.value,
        host: host.value,
        entries: match entries.value { Some(found) -> found, None -> [] },
        trailing_value: rest.value,
      },
      rest: rest.rest,
    }
  })

test "a `Reader` reads a schema's fields: tagged, optional, defaulted to a given value, repeated, and raw bytes" {
  let algorithm = try { sequence([oid(oid::sha256_with_rsa_encryption()), null()]) };
  let full = try {
    sequence([
      explicit(context(0), int(2)),
      unsigned(Bytes::of_hex("c0ffee")),
      sequence([oid(oid::sha256_with_rsa_encryption()), null()]),
      set_of([string(Utf8String, "b"), string(Utf8String, "a")]),
      implicit(context(1), octet_string(b"\x01\x02")),
      implicit(context(2), string(Ia5String, "asn1.example")),
      implicit(
        context(3),
        sequence([
          sequence([oid(oid::key_usage()), boolean(true), octet_string(named_bits([0, 5]))]),
          sequence([oid(oid::subject_key_identifier()), octet_string(b"\x04\x01\x09")]),
        ]),
      ),
      boolean(true),
    ])
  };
  let read = match full { Ok(der) -> decode_with(der, 4, card), Err(_) -> panic("it writes") };
  assert_eq(
    read,
    Ok({
      version: 2,
      serial: Bytes::of_hex("c0ffee"),
      algorithm: match algorithm { Ok(der) -> der, Err(_) -> b"" },
      names: ["a", "b"],
      key_id: Some(b"\x01\x02"),
      host: Some("asn1.example"),
      entries: [
        { id: oid"2.5.29.15", critical: true, value: Bytes::of_hex("03020284") },
        { id: oid"2.5.29.14", critical: false, value: b"\x04\x01\x09" },
      ],
      trailing_value: Boolean(true),
    }),
  );
  assert_eq(
    decode_with(sequence([int(7), sequence([]), set_of([]), null()]), 4, card),
    Ok({
      version: 0,
      serial: b"\x07",
      algorithm: Bytes::of_hex("3000"),
      names: [],
      key_id: None,
      host: None,
      entries: [],
      trailing_value: Null,
    }),
  );
  let nested = |depth: Int|
    decode_with(Bytes::of_hex("30023000"), depth, |r: Reader|
      read_sequence_of(r, |x: Reader| read_sequence_of(x, read_null)));
  assert_eq(nested(0), Err({ at: 0, reason: TooDeep }));
  assert_eq(nested(1), Err({ at: 2, reason: TooDeep }));
  assert_eq(nested(2), Ok([[]]));
  let reading = reader(Bytes::of_hex("0500"), 0);
  assert_eq(peek(reading), Some(universal(5)));
  assert(!is_empty(reading) && is_empty(read_null(reading).rest));
  assert_eq(peek(read_null(reading).rest), None);
  assert_eq(decode_with(b"\x14\x02hi", 0, |r: Reader| read_primitive(r, universal(20))), Ok(b"hi"))
}

test "`encode` fails on any value that `decode` could not have returned, such as an empty INTEGER or an unsorted SET" {
  assert_eq(encode(Integer(b"")), Err(EmptyInteger));
  assert_eq(encode(Integer(b"\x00\x01")), Err(OverlongInteger));
  assert_eq(encode(Enumerated(b"\xff\xff")), Err(OverlongInteger));
  assert_eq(encode(Set([Integer(b"\x02"), Integer(b"\x01")])), Err(Unsorted));
  assert_eq(encode(Primitive(universal(2), b"\x01")), Err(BadTag));
  let unchecked = [7, 9, 13, 14, 15, 20, 21, 25, 27];
  assert_eq(
    range(0, 31).filter(|n: Int| encode(Primitive(universal(n), b"")) != Err(BadTag)),
    unchecked,
  );
  assert_eq(
    range(1, 31).filter(|n: Int|
      decode(byte_of_int(n).concat(b"\x00"), 0) == Ok(Primitive(universal(n), b""))),
    unchecked,
  );
  assert_eq(range(0, 31).filter(|n: Int| encode(Constructed(universal(n), [])) != Err(BadTag)), [
    8,
    11,
    29,
  ]);
  assert_eq(
    range(1, 31).filter(|n: Int|
      decode(byte_of_int(n | 0x20).concat(b"\x00"), 1) == Ok(Constructed(universal(n), []))),
    [8, 11, 29],
  );
  assert_eq(encode(Primitive(universal(36), b"")), Ok(Bytes::of_hex("1f2400")));
  assert_eq(encode(Primitive(context(0 - 1), b"")), Err(BadTag));
  assert_eq(encode(ObjectId(oid::Oid([3, 1]))), Err(BadOid));
  assert_eq(encode(Text(NumericString, "x")), Err(BadText(NumericString)));
  assert_eq(encode(Sequence([Null, BitString({ unused: 3, bytes: b"" })])), Err(BadBits));
  let nested = |levels: Int|
    range(0, levels).fold(Null, |children: Value, _: Int| Sequence([children]));
  let der = match encode(nested(64)) { Ok(written) -> written, Err(_) -> panic("it writes") };
  assert_eq(height(nested(64)), 64);
  assert_eq(decode(der, 64), Ok(nested(64)));
  assert_eq(decode(der, 63), Err({ at: 127, reason: TooDeep }));
  assert_eq(try { read(der, 63) }, Err({ at: 127, reason: TooDeep }));
  assert_eq(decode(Bytes::of_hex("0500"), 0), Ok(Null));
  assert_eq(decode(Bytes::of_hex("3000"), 0), Err({ at: 0, reason: TooDeep }));
  assert_eq(int_of_integer(b"\xff\x7f"), Some(0 - 129));
  assert_eq(big_int_of_integer(b"\xff\x7f"), bigint::of_int(0 - 129));
  assert_eq(big_int_of_integer(b""), bigint::zero())
}
