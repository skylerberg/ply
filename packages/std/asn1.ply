    vector("a VisibleString", b"\x1a\x03a~ ", Text(VisibleString, "a~ ")),
    vector("a UniversalString", Bytes::of_hex("1c040001f600"), Text(UniversalString, "\u{1F600}")),
    vector("a BMPString", Bytes::of_hex("1e0203c0"), Text(BmpString, "\u{3c0}")),
    vector("a UTCTime", b"\x17\x0d191216030210Z", UtcTime(timestamp"2019-12-16T03:02:10Z")),
    vector("a UTCTime of 1950", b"\x17\x0d500101000000Z", UtcTime(timestamp"1950-01-01T00:00:00Z")),
    vector("a UTCTime of 2049", b"\x17\x0d491231235959Z", UtcTime(timestamp"2049-12-31T23:59:59Z")),
    vector(
      "a GeneralizedTime",
      b"\x18\x0f20200229235959Z",
      GeneralizedTime(timestamp"2020-02-29T23:59:59Z"),
    ),
    vector(
      "a GeneralizedTime on the leap day of a century",
      b"\x18\x0f20000229000000Z",
      GeneralizedTime(timestamp"2000-02-29T00:00:00Z"),
    ),
    vector(
      "a GeneralizedTime with a fraction of its second",
      b"\x18\x1320191216030210.025Z",
      GeneralizedTime(timestamp"2019-12-16T03:02:10.025Z"),
    ),
    vector(
      "a GeneralizedTime to the nanosecond",
      b"\x18\x1999991231235959.999999999Z",
