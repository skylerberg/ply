//! ASN.1 in its distinguished encoding (DER): builders that write it, a cursor that reads it, and a
//! tree for a document whose shape is not known.
//!
//! DER gives each value exactly one encoding, so a signature can be checked over bytes.
//! Certificates, keys and signatures are DER. This module enforces every rule that makes the
//! encoding unique, on both sides. A builder computes its own lengths and writes the shortest form
//! of everything, so its output is always canonical. A reader rejects, with the reason and the byte
//! offset, any of these: - a length or tag number not in its shortest form, or an indefinite
//! length; - a `BOOLEAN` that is not `00` or `FF`; - an `INTEGER` with a redundant leading octet; -
//! a `BIT STRING` whose unused bits are set; - an identifier arc with a leading `80`; - a `SET OF`
//! that is out of order; - a character outside its string type's character set; - a time not
//! written `YYMMDDHHMMSSZ` or `YYYYMMDDHHMMSS[.f]Z`, or naming no real date; - a string or a time
//! in constructed form; - a field that equals its default but is written out anyway; - any bytes
//! after the value. Every length is checked against the remaining input before it is read, and
//! nesting is limited by the depth the reader is given.
//!
//! BER, the looser encoding that DER is a subset of, is rejected. Some files called DER are really
//! BER: a PKCS #7 or PKCS #12 bundle from an older tool uses indefinite lengths.
//!
//! A time is an instant, `std.date`'s `OffsetDateTime`. DER writes a time only in UTC, so a reader
//! returns it at UTC, and a builder writes the instant it is given, whatever its offset. A
//! `UTCTime`'s two-digit year means a year from 1950 to 2049.
//!
//! The cursor is a `Reader`, a window onto the bytes. A read takes the element at the front of the
//! reader and returns its value together with the reader positioned after it, so a parser passes
//! one reader through a `SEQUENCE`'s fields. `read_sequence` returns a reader over the content, and
//! `within` runs a parser on a reader and rejects anything the parser left unread. `read_explicit`
//! and `read_implicit` read a field that a schema tags, and `read_optional` and `read_default` read
//! a field that may be absent. A read raises `asn1.fail`, and `decode_with` returns the error as an
//! `Err`.
//!
//! `Value` is a whole document. `decode` and `encode` are inverses of each other and return an
//! error as an `Err`, while `read` and `write` raise it. The tree names the universal types this
//! module checks, and any other element is a `Primitive` or a `Constructed` under its tag. A `SET`
//! must be in `SET OF` order, the order of its members' encodings. A `SET` whose schema orders its
//! members by tag is read with `read_constructed`.

import std.bigint
import std.bigint (BigInt)
import std.bytes (is_digit, u16_be, u32_be, u64_be)
import std.date
import std.date (DateTime, OffsetDateTime)
import std.laws (round_trip)
import std.list
import std.gen
import std.oid
import std.oid (Oid)
import std.result
import std.string
import std.timestamp

/// The four namespaces of tag numbers.
pub type Class =
  /// The types ASN.1 itself defines: `INTEGER` is universal 2.
  | Universal
  /// Numbers one application's schemas share.
  | Application
  /// Numbers whose meaning the enclosing type defines, as for `[0]`.
  | Context
  /// Tag numbers whose meaning an individual organisation defines.
  | Private

/// The type an element declares: a class, and a number in it.
pub type Tag = new { class: Class, number: Int }

/// The tag of a type ASN.1 defines.
pub fn universal(number: Int) -> Tag = { class: Universal, number: number }

/// An application tag, `[APPLICATION n]`.
pub fn application(number: Int) -> Tag = { class: Application, number: number }

/// A context-specific tag, `[n]`.
pub fn context(number: Int) -> Tag = { class: Context, number: number }

/// A private tag, `[PRIVATE n]`.
pub fn private(number: Int) -> Tag = { class: Private, number: number }

fn class_of(bits: Int) -> Class =
  if bits == 0 { Universal }
  else if bits == 1 { Application }
  else if bits == 2 { Context }
  else { Private }

fn class_bits(class: Class) -> Int =
  match class { Universal -> 0, Application -> 0x40, Context -> 0x80, Private -> 0xC0 }

/// The string types whose characters this module checks.
pub type StringKind =
  /// Any text, in UTF-8.
  | Utf8String
  /// Digits and the space.
  | NumericString
  /// Letters, digits, the space and `'()+,-./:=?`.
  | PrintableString
  /// ASCII, control characters included.
  | Ia5String
  /// ASCII from the space to `~`.
  | VisibleString
  /// Any text, with each character taking four octets.
  | UniversalString
  /// Text from the Basic Multilingual Plane, with each character taking two octets.
  | BmpString

/// A `BIT STRING`: the bits of `bytes`, most significant first, except the last `unused` bits,
/// which are padding. `unused` is from 0 to 7, and is 0 when `bytes` is empty. The padding bits
/// must be zero.
pub type Bits = new { unused: Int, bytes: Bytes }

/// A document, or one element of it.
pub type Value =
  | Boolean(Bool)
  /// An `INTEGER`, as its content: the number's two's complement, most significant octet first, in
  /// the fewest octets. `int_of_integer` and `big_int_of_integer` read the number.
  | Integer(Bytes)
  /// An `ENUMERATED`, with its number stored as in an `Integer`.
  | Enumerated(Bytes)
  | BitString(Bits)
  | OctetString(Bytes)
  | Null
  | ObjectId(Oid)
  /// A string of one of the checked types.
  | Text(StringKind, String)
  /// A `UTCTime`: an instant of the years 1950 to 2049, to the second, at UTC.
  | UtcTime(OffsetDateTime)
  /// A `GeneralizedTime`: an instant of the years 0 to 9999, to the nanosecond, at UTC.
  | GeneralizedTime(OffsetDateTime)
  | Sequence(List<Value>)
  /// A `SET OF`: its members in the order of their encodings.
  | Set(List<Value>)
  /// A constructed element of any other tag, such as an explicitly tagged field, with the elements
  /// it contains.
  | Constructed(Tag, List<Value>)
  /// A primitive element of any other tag, such as an implicitly tagged field, with its content.
  | Primitive(Tag, Bytes)

/// Why a reader rejected some bytes, or a writer rejected a value.
pub type ErrorKind =
  /// The input ends before the element does.
  | Truncated
  /// Bytes follow the last element.
  | Trailing
  /// Nested past the depth the reader was given.
  | TooDeep
  /// A length of the indefinite form, which only BER has.
  | IndefiniteLength
  /// A length not written in the fewest octets.
  | OverlongLength
  /// A tag number not written in the fewest octets.
  | OverlongTag
  /// A length, a tag number, an arc, a fraction of a second or an `INTEGER` too large for the type
  /// it is read into.
  | TooWide
  /// An element tagged universal 0, which ends an indefinite length and is not an element of DER.
  | EndOfContents
  /// An element with a tag other than the one requested. It carries the tag found.
  | WrongTag(Tag)
  /// An element that is constructed where its type must be primitive (for example a string split
  /// into pieces), or primitive where its type must be constructed.
  | WrongForm
  /// A `BOOLEAN` that is not the one octet `00` or `FF`.
  | BadBoolean
  /// An `INTEGER` of no octets.
  | EmptyInteger
  /// An `INTEGER` whose first octet only repeats the sign of its second.
  | OverlongInteger
  /// A negative `INTEGER` where a magnitude was expected.
  | Negative
  /// A `BIT STRING` with no count of unused bits, a count past 7 or past its octets, or an unused
  /// bit set.
  | BadBits
  /// A list of named bits that ends in a zero bit.
  | TrailingZeroBits
  /// A `NULL` with content.
  | BadNull
  /// An identifier with no octets, or one that ends in the middle of an arc. A writer also uses it
  /// for an `Oid` that is not valid.
  | BadOid
  /// An identifier arc with a leading `80`.
  | OverlongArc
  /// A string containing a character its type does not allow. When a reader reports it, `Error.at`
  /// is the octet of that character.
  | BadText(StringKind)
  /// A time that is not in the single form DER allows, is not a real date or time of day, or that
  /// its type cannot represent. When a `Value` is written, a time that is not at UTC also causes
  /// it.
  | BadTime
  /// A `GeneralizedTime` where X.509 writes a `UTCTime`: a year from 1950 to 2049.
  | WrongTimeType
  /// A `SET OF` whose members are not in the order of their encodings.
  | Unsorted
  /// A field written out with its schema's default value, which DER requires be left out.
  | DefaultEncoded
  /// A tag with a negative number or universal number 0. Writing a `Value` also rejects a
  /// `Primitive` or `Constructed` tag that `Value` has its own variant for, such as `universal(2)`,
  /// because reading would return that variant instead.
  | BadTag

/// Why a reader rejected its input, and the offset in the input of the problem.
pub type Error = new { at: Int, reason: ErrorKind }

/// The errors this module raises.
pub effect asn1 {
  /// The bytes are not the DER that was expected.
  raise fail(e: Error)
  /// The value has no DER encoding.
  raise unwritable(reason: ErrorKind)
}

fn fail<a>(at: Int, reason: ErrorKind) -> a / {asn1.fail} = asn1.fail({ at: at, reason: reason })

/// The content of the `INTEGER` `n`: its two's complement in the fewest octets.
pub fn integer_of_int(n: Int) -> Bytes / {abort.raise} = minimal(u64_be(n))

/// The `Int` an `INTEGER`'s content encodes, or `None` for one wider than 64 bits or with no
/// octets.
pub fn int_of_integer(content: Bytes) -> Option<Int> =
  if content.len() == 0 || content.len() > 8 { None } else {
    Some(
      range(0, content.len()).fold(
        if content.at(0) >= 0x80 { 0 - 1 } else { 0 },
        |n: Int, i: Int| n << 8 | content.at(i),
      ),
    )
  }

/// The content of the `INTEGER` `n`, whatever its size.
pub fn integer_of_big_int(n: BigInt) -> Bytes / {abort.raise} =
  if bigint::is_negative(n) {
    integer_content(bigint::to_bytes(bigint::sub(bigint::neg(n), bigint::one()))).xor_byte(0xFF)
  } else { integer_content(bigint::to_bytes(n)) }

/// The number an `INTEGER`'s content encodes, or zero for no octets.
pub fn big_int_of_integer(content: Bytes) -> BigInt / {abort.raise} =
  if content.len() > 0 && content.at(0) >= 0x80 {
    bigint::sub(bigint::neg(bigint::of_bytes(content.xor_byte(0xFF))), bigint::one())
  } else { bigint::of_bytes(content) }

fn redundant(content: Bytes, i: Int) -> Bool / {abort.raise} =
  i + 1 < content.len()
    && ((content.at(i) == 0 && content.at(i + 1) < 0x80)
    || (content.at(i) == 0xFF && content.at(i + 1) >= 0x80))

fn minimal(content: Bytes) -> Bytes / {abort.raise} =
  if content.len() == 0 { b"\x00" }
  else { content.slice(first_significant(content, 0), content.len()) }

fn first_significant(content: Bytes, i: Int) -> Int / {abort.raise} =
  if i >= content.len() - 1 { i }
  else if redundant(content, i) { first_significant(content, i + 1) }
  else { i }

fn integer_content(magnitude: Bytes) -> Bytes =
  if magnitude.len() == 0 || magnitude.at(0) >= 0x80 { b"\x00".concat(magnitude) }
  else { magnitude }

/// Returns whether `b` is a valid DER bit string: `unused` is 0 to 7, `unused` is 0 when there are
/// no octets, and the unused bits of the last octet are zero.
pub fn bits_valid(b: Bits) -> Bool / {abort.raise} =
  b.unused >= 0 && b.unused <= 7 && (b.unused == 0 || b.bytes.len() > 0)
    && (b.unused == 0 || b.bytes.at(b.bytes.len() - 1) & (1 << b.unused) - 1 == 0)

/// Bit `i` of the string, counting the first octet's most significant bit as 0; `false` past its
/// end.
pub fn bit_at(b: Bits, i: Int) -> Bool / {abort.raise} =
  i >= 0 && i < 8 * b.bytes.len() - b.unused && b.bytes.at(i / 8) & 0x80 >> i % 8 != 0

fn at_utc(t: OffsetDateTime) -> DateTime = date::local(date::in_utc(t))

fn year_of(t: OffsetDateTime) -> Int = date::year(date::date_of(at_utc(t)))

fn nanosecond_of(t: OffsetDateTime) -> Int = date::nanosecond(date::time_of(at_utc(t)))

/// The text of the `UTCTime` of the instant `t`, `YYMMDDHHMMSSZ` in UTC. `None` when `t` has no
/// `UTCTime`: a year outside 1950 to 2049, or a fraction of a second.
pub fn utc_time_text(t: OffsetDateTime) -> Option<String> =
  if year_of(t) >= 1950 && year_of(t) <= 2049 && nanosecond_of(t) == 0 {
    Some(two_digits(year_of(t) % 100) ++ clock_text(at_utc(t)) ++ "Z")
  } else { None }

/// The text of the `GeneralizedTime` of the instant `t`, `YYYYMMDDHHMMSSZ` in UTC, with the
/// fraction of a second before the `Z` when it has one.
pub fn generalized_time_text(t: OffsetDateTime) -> String =
  year_of(t).to_string().pad_left(4, "0") ++ clock_text(at_utc(t))
    ++ (if nanosecond_of(t) == 0 { "" } else { "." ++ fraction_digits(nanosecond_of(t), 9) })
    ++ "Z"

fn two_digits(n: Int) -> String = n.to_string().pad_left(2, "0")

fn clock_text(at: DateTime) -> String = {
  let day = date::parts(date::date_of(at));
  let time = date::time_of(at);
  two_digits(day.month) ++ two_digits(day.day) ++ two_digits(date::hour(time))
    ++ two_digits(date::minute(time))
    ++ two_digits(date::second(time))
}

fn fraction_digits(n: Int, digits: Int) -> String =
  if digits > 1 && n % 10 == 0 { fraction_digits(n / 10, digits - 1) }
  else { n.to_string().pad_left(digits, "0") }

fn length_octets(n: Int) -> Bytes / {abort.raise} =
  if n < 0x80 { byte_of_int(n) } else {
    let octets = u64_be(n).strip_leading_zeros();
    byte_of_int(0x80 | octets.len()).concat(octets)
  }

fn septets(n: Int) -> Bytes = septets_before(n / 128, byte_of_int(n & 0x7F))

fn septets_before(n: Int, low: Bytes) -> Bytes =
  if n <= 0 { low } else { septets_before(n / 128, byte_of_int(n & 0x7F | 0x80).concat(low)) }

fn identifier(tag: Tag, constructed: Bool) -> Bytes / {asn1.unwritable, abort.raise} = {
  let first_significant = class_bits(tag.class) | (if constructed { 0x20 } else { 0 });
  if tag.number < 0 || (tag.class == Universal && tag.number == 0) { asn1.unwritable(BadTag) }
  else if tag.number < 31 { byte_of_int(first_significant | tag.number) }
  else { byte_of_int(first_significant | 0x1F).concat(septets(tag.number)) }
}

fn element(first_significant: Int, content: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([byte_of_int(first_significant), length_octets(content.len()), content])

/// A `BOOLEAN`.
pub fn boolean(b: Bool) -> Bytes / {abort.raise} = element(0x01, if b { b"\xff" } else { b"\x00" })

/// The `INTEGER` whose two's complement is `content`, most significant octet first. It is written
/// in the fewest octets, whatever padding `content` has. No octets means zero.
pub fn integer(content: Bytes) -> Bytes / {abort.raise} = element(0x02, minimal(content))

/// The `INTEGER` `n`.
pub fn int(n: Int) -> Bytes / {abort.raise} = element(0x02, integer_of_int(n))

/// The `INTEGER` `n`, whatever its size.
pub fn big_int(n: BigInt) -> Bytes / {abort.raise} = element(0x02, integer_of_big_int(n))

/// The `INTEGER` whose magnitude is `magnitude`, most significant octet first. It is never
/// negative, whatever its first bit is. Use it for a modulus or half of a signature.
pub fn unsigned(magnitude: Bytes) -> Bytes / {abort.raise} =
  element(0x02, integer_content(magnitude.strip_leading_zeros()))

/// The `ENUMERATED` `n`.
pub fn enumerated(n: Int) -> Bytes / {abort.raise} = element(0x0A, integer_of_int(n))

/// A `BIT STRING`. Raises `BadBits` unless `bits_valid`.
pub fn bit_string(b: Bits) -> Bytes / {asn1.unwritable, abort.raise} =
  if bits_valid(b) { element(0x03, byte_of_int(b.unused).concat(b.bytes)) }
  else { asn1.unwritable(BadBits) }

/// The `BIT STRING` of a list of named bits, such as a key's usages. The bits at the positions in
/// `set` are one, and the string ends at the last of them. A negative position names no bit.
pub fn named_bits(set: List<Int>) -> Bytes / {abort.raise} = {
  let top = set.fold(0 - 1, |highest: Int, position: Int| max(highest, position));
  let octets = range(0, (top + 8) / 8).map(|i: Int|
    byte_of_int(
      set.fold(0, |octet: Int, position: Int|
        if position >= 0 && position / 8 == i { octet | 0x80 >> position % 8 } else { octet }),
    ));
  element(
    0x03,
    byte_of_int(if top < 0 { 0 } else { 7 - top % 8 }).concat(Bytes::concat_all(octets)),
  )
}

/// An `OCTET STRING`.
pub fn octet_string(octets: Bytes) -> Bytes / {abort.raise} = element(0x04, octets)

/// A `NULL`.
pub fn null() -> Bytes = b"\x05\x00"

/// An `OBJECT IDENTIFIER`. Raises `BadOid` for arcs no identifier has.
pub fn oid(o: Oid) -> Bytes / {asn1.unwritable, abort.raise} =
  match oid::arcs(o) {
    [first, second, ..rest] if oid::is_valid(o) ->
      element(0x06, Bytes::concat_all([first * 40 + second].concat(rest).map(septets))),
    _ -> asn1.unwritable(BadOid),
  }

/// A string of the type `kind`. Raises `BadText` for a character the type does not allow.
pub fn string(kind: StringKind, text: String) -> Bytes / {asn1.unwritable, abort.raise} =
  element(string_number(kind), match kind {
    Utf8String -> Bytes::of_string(text),
    UniversalString -> Bytes::concat_all(text.chars().map(|c: Char| u32_be(Int::of_char(c)))),
    BmpString ->
      Bytes::concat_all(
        text.chars().map(|c: Char|
          if Int::of_char(c) > 0xFFFF { asn1.unwritable(BadText(kind)) }
          else { u16_be(Int::of_char(c)) }),
      ),
    _ -> match first_invalid_octet(kind, Bytes::of_string(text)) {
      None -> Bytes::of_string(text),
      Some(_) -> asn1.unwritable(BadText(kind)),
    },
  })

/// A `UTCTime` of the instant `t`, whatever its offset. Raises `BadTime` where `utc_time_text`
/// returns `None`.
pub fn utc_time(t: OffsetDateTime) -> Bytes / {asn1.unwritable, abort.raise} =
  match utc_time_text(t) {
    Some(text) -> element(0x17, Bytes::of_string(text)),
    None -> asn1.unwritable(BadTime),
  }

/// A `GeneralizedTime` of the instant `t`, whatever its offset.
pub fn generalized_time(t: OffsetDateTime) -> Bytes / {abort.raise} =
  element(0x18, Bytes::of_string(generalized_time_text(t)))

/// The `Time` of an X.509 certificate for the instant `t`: a `UTCTime` when its UTC year is 1950
/// to 2049, and a `GeneralizedTime` otherwise, as RFC 5280 requires. Raises `BadTime` for a
/// fraction of a second, which it cannot represent.
pub fn time(t: OffsetDateTime) -> Bytes / {asn1.unwritable, abort.raise} =
  if nanosecond_of(t) != 0 { asn1.unwritable(BadTime) }
  else if year_of(t) >= 1950 && year_of(t) <= 2049 { utc_time(t) }
  else { generalized_time(t) }

/// A `SEQUENCE` of the encoded elements `parts`, in order.
pub fn sequence(parts: List<Bytes>) -> Bytes / {abort.raise} =
  element(0x30, Bytes::concat_all(parts))

/// A `SET OF` the encoded elements `parts`, which it puts in the order of their encodings.
pub fn set_of(parts: List<Bytes>) -> Bytes / {abort.raise} =
  element(0x31, Bytes::concat_all(parts.sort()))

/// A primitive element of any tag: `content` as it is. Raises `BadTag` for a negative number and
/// for universal 0.
pub fn primitive(tag: Tag, content: Bytes) -> Bytes / {asn1.unwritable, abort.raise} =
  Bytes::concat_all([identifier(tag, false), length_octets(content.len()), content])

/// A constructed element of any tag containing the encoded elements `parts`, in order. Raises
/// `BadTag` as `primitive` does.
pub fn constructed(tag: Tag, parts: List<Bytes>) -> Bytes / {asn1.unwritable, abort.raise} = {
  let content = Bytes::concat_all(parts);
  Bytes::concat_all([identifier(tag, true), length_octets(content.len()), content])
}

/// The encoded element `inner` tagged explicitly, `[n] EXPLICIT`: wrapped whole in an element of
/// `tag`.
pub fn explicit(tag: Tag, inner: Bytes) -> Bytes / {asn1.unwritable, abort.raise} =
  constructed(tag, [inner])

/// The encoded element `inner` tagged implicitly, `[n] IMPLICIT`: `tag` replaces its own. Raises
/// `Truncated` for bytes that contain no tag to replace.
pub fn implicit(tag: Tag, inner: Bytes) -> Bytes / {asn1.unwritable, abort.raise} =
  if inner.len() == 0 { asn1.unwritable(Truncated) } else {
    let first = inner.at(0);
    let after = if first & 0x1F != 0x1F { Some(1) } else {
      match inner.position(1, |octet: Int| octet < 0x80) {
        Some(last) -> Some(last + 1),
        None -> None,
      }
    };
    match after {
      Some(n) -> identifier(tag, first & 0x20 != 0).concat(inner.slice(n, inner.len())),
      None -> asn1.unwritable(Truncated),
    }
  }

type Header = { tag: Tag, constructed: Bool, from: Int, to: Int }

type Septets = | Number(Int, Int) | Ended | Padded | Overflow

fn septets_at(data: Bytes, at: Int, end: Int) -> Septets / {abort.raise} =
  if at >= end { Ended }
  else if data.at(at) == 0x80 { Padded }
  else { septets_from(data, at, end, 0, 9) }

fn septets_from(data: Bytes, at: Int, end: Int, value: Int, left: Int) -> Septets / {abort.raise} =
  if at >= end { Ended }
  else if left <= 0 { Overflow } else {
    let octet = data.at(at);
    let more = value << 7 | octet & 0x7F;
    if octet < 0x80 { Number(more, at + 1) }
    else { septets_from(data, at + 1, end, more, left - 1) }
  }

fn header_at(data: Bytes, at: Int, end: Int) -> Header / {asn1.fail, abort.raise} =
  if at >= end { fail(at, Truncated) } else {
    let first = data.at(at);
    let id = if first & 0x1F != 0x1F { { number: first & 0x1F, next: at + 1 } } else {
      match septets_at(data, at + 1, end) {
        Number(number, next) -> if number < 31 { fail(at, OverlongTag) }
        else { { number: number, next: next } },
        Ended -> fail(end, Truncated),
        Padded -> fail(at, OverlongTag),
        Overflow -> fail(at, TooWide),
      }
    };
    if first < 0x40 && id.number == 0 { fail(at, EndOfContents) } else {
      let span = length_at(data, id.next, end);
      if span.length > end - span.from { fail(span.from, Truncated) } else {
        {
          tag: { class: class_of(first >> 6), number: id.number },
          constructed: first & 0x20 != 0,
          from: span.from,
          to: span.from + span.length,
        }
      }
    }
  }

fn length_at(
  data: Bytes,
  at: Int,
  end: Int,
) -> { length: Int, from: Int } / {asn1.fail, abort.raise} =
  if at >= end { fail(at, Truncated) } else {
    let first = data.at(at);
    let octets = first & 0x7F;
    if first < 0x80 { { length: first, from: at + 1 } }
    else if octets == 0 { fail(at, IndefiniteLength) }
    else if octets > end - at - 1 { fail(end, Truncated) }
    else if data.at(at + 1) == 0 { fail(at, OverlongLength) }
    else if octets > 8 || (octets == 8 && data.at(at + 1) >= 0x80) { fail(at, TooWide) } else {
      let length = range(at + 1, at + 1 + octets).fold(0, |n: Int, i: Int| n << 8 | data.at(i));
      if length < 0x80 { fail(at, OverlongLength) }
      else { { length: length, from: at + 1 + octets } }
    }
  }

fn boolean_of(content: Bytes, at: Int) -> Bool / {asn1.fail} =
  if content == b"\x00" { false } else if content == b"\xff" { true } else { fail(at, BadBoolean) }

fn integer_of(content: Bytes, at: Int) -> Bytes / {asn1.fail, abort.raise} =
  if content.len() == 0 { fail(at, EmptyInteger) }
  else if redundant(content, 0) { fail(at, OverlongInteger) }
  else { content }

fn int_of(content: Bytes, at: Int) -> Int / {asn1.fail, abort.raise} =
  match int_of_integer(integer_of(content, at)) { Some(n) -> n, None -> fail(at, TooWide) }

fn unsigned_of(content: Bytes, at: Int) -> Bytes / {asn1.fail, abort.raise} = {
  let number = integer_of(content, at);
  if number.at(0) >= 0x80 { fail(at, Negative) }
  else if number.len() > 1 && number.at(0) == 0 { number.slice(1, number.len()) }
  else { number }
}

fn bits_of(content: Bytes, at: Int) -> Bits / {asn1.fail, abort.raise} =
  if content.len() == 0 { fail(at, BadBits) } else {
    let bits: Bits = { unused: content.at(0), bytes: content.slice(1, content.len()) };
    if bits_valid(bits) { bits } else { fail(at, BadBits) }
  }

fn named_bits_of(content: Bytes, at: Int) -> Bits / {asn1.fail, abort.raise} = {
  let bits = bits_of(content, at);
  let octets = bits.bytes.len();
  if octets > 0 && bits.bytes.at(octets - 1) >> bits.unused & 1 == 0 { fail(at, TrailingZeroBits) }
  else { bits }
}

fn null_of(content: Bytes, at: Int) -> Unit / {asn1.fail} =
  if content.len() == 0 { () } else { fail(at, BadNull) }

fn oid_of(content: Bytes, at: Int) -> Oid / {asn1.fail, abort.raise} =
  match arcs_of(content, 0, at, [], content.len()) {
    [] -> fail(at, BadOid),
    [first, ..rest] ->
      oid::Oid(
        List::concat(
          if first < 40 { [0, first] }
          else if first < 80 { [1, first - 40] }
          else { [2, first - 80] },
          rest,
        ),
      ),
  }

fn arcs_of(
  content: Bytes,
  i: Int,
  at: Int,
  accumulator: List<Int>,
  left: Int,
) -> List<Int> / {asn1.fail, abort.raise} =
  if i >= content.len() || left <= 0 { accumulator } else {
    match septets_at(content, i, content.len()) {
      Number(arc, next) -> arcs_of(content, next, at, accumulator.push(arc), left - 1),
      Ended -> fail(at + i, BadOid),
      Padded -> fail(at + i, OverlongArc),
      Overflow -> fail(at + i, TooWide),
    }
  }

fn string_number(kind: StringKind) -> Int =
  match kind {
    Utf8String -> 12,
    NumericString -> 18,
    PrintableString -> 19,
    Ia5String -> 22,
    VisibleString -> 26,
    UniversalString -> 28,
    BmpString -> 30,
  }

fn string_kind(number: Int) -> Option<StringKind> =
  match number {
    12 -> Some(Utf8String),
    18 -> Some(NumericString),
    19 -> Some(PrintableString),
    22 -> Some(Ia5String),
    26 -> Some(VisibleString),
    28 -> Some(UniversalString),
    30 -> Some(BmpString),
    _ -> None,
  }

fn first_invalid_octet(kind: StringKind, content: Bytes) -> Option<Int> =
  content.position(0, |b: Int|
    !(match kind {
      NumericString -> is_digit(b) || b == 0x20,
      PrintableString ->
        is_digit(b) || (b >= 0x41 && b <= 0x5A) || (b >= 0x61 && b <= 0x7A)
          || b" '()+,-./:=?".index_of_byte(b) != None,
      VisibleString -> b >= 0x20 && b <= 0x7E,
      _ -> b < 0x80,
    }))

fn text_of(kind: StringKind, content: Bytes, at: Int) -> String / {asn1.fail, abort.raise} =
  match kind {
    Utf8String -> if content.is_utf8() { String::of_bytes(content) }
    else { fail(at, BadText(kind)) },
    UniversalString -> wide_text(kind, content, at, 4),
    BmpString -> wide_text(kind, content, at, 2),
    _ -> match first_invalid_octet(kind, content) {
      None -> String::of_bytes(content),
      Some(i) -> fail(at + i, BadText(kind)),
    },
  }

fn wide_text(
  kind: StringKind,
  content: Bytes,
  at: Int,
  width: Int,
) -> String / {asn1.fail, abort.raise} =
  if content.len() % width != 0 { fail(at, BadText(kind)) } else {
    String::of_chars(
      range(0, content.len() / width).map(|i: Int|
        match Char::of_int(
            range(i * width, i * width + width).fold(0, |point: Int, j: Int|
              point << 8 | content.at(j)),
          ) {
          Some(c) -> c,
          None -> fail(at + i * width, BadText(kind)),
        }),
    )
  }

fn digits_at(content: Bytes, from: Int, n: Int) -> Option<Int> / {abort.raise} =
  range(from, from + n).fold(Some(0), |so_far: Option<Int>, i: Int|
    match so_far {
      Some(v) if is_digit(content.at(i)) -> Some(v * 10 + content.at(i) - 48),
      _ -> None,
    })

fn date_time_at(
  year: Int,
  content: Bytes,
  from: Int,
  nanosecond: Int,
) -> Option<OffsetDateTime> / {abort.raise} =
  match range(0, 5).map(|i: Int| digits_at(content, from + 2 * i, 2)) {
    [Some(month), Some(day), Some(hour), Some(minute), Some(second)] -> match ((
        date::of(year, month, day),
        date::time(hour, minute, second, nanosecond),
      )) {
      (Some(on), Some(clock)) -> Some(date::utc(date::at(on, clock))),
      _ -> None,
    },
    _ -> None,
  }

fn utc_time_of(content: Bytes, at: Int) -> OffsetDateTime / {asn1.fail, abort.raise} = {
  let read = if content.len() != 13 || content.at(12) != 0x5A { None } else {
    match digits_at(content, 0, 2) {
      Some(year) -> date_time_at(if year >= 50 { 1900 + year } else { 2000 + year }, content, 2, 0),
      None -> None,
    }
  };
  match read { Some(t) -> t, None -> fail(at, BadTime) }
}

fn generalized_time_of(content: Bytes, at: Int) -> OffsetDateTime / {asn1.fail, abort.raise} = {
  let z = content.len() - 1;
  if z < 14 || content.at(z) != 0x5A { fail(at, BadTime) } else {
    let nanosecond = if z == 14 { 0 } else { fraction_of(content, at, z) };
    let read = match digits_at(content, 0, 4) {
      Some(year) -> date_time_at(year, content, 4, nanosecond),
      None -> None,
    };
    match read { Some(t) -> t, None -> fail(at, BadTime) }
  }
}

fn fraction_of(content: Bytes, at: Int, z: Int) -> Int / {asn1.fail, abort.raise} =
  if content.at(14) != 0x2E || z < 16 || content.skip(15, b"0123456789") < z
      || content.at(z - 1) == 0x30 { fail(at, BadTime) }
  else if z > 24 { fail(at, TooWide) } else {
    range(15, 24).fold(0, |n: Int, i: Int| n * 10 + (if i < z { content.at(i) - 48 } else { 0 }))
  }

/// A window onto DER: the elements from `at` up to `end` in `data`, and how many more levels a
/// read may enter. `implicit` is the tag the next typed read expects in place of its type's own.
pub type Reader = new { data: Bytes, at: Int, end: Int, room: Int, implicit: Option<Tag> }

/// What a read returns: a value, and the reader after what it consumed.
pub type ReadResult<a> = { value: a, rest: Reader }

/// A reader over all of `data` that enters at most `depth` nested elements.
pub fn reader(data: Bytes, depth: Int) -> Reader =
  { data: data, at: 0, end: data.len(), room: depth, implicit: None }

/// Whether nothing is left to read.
pub fn is_empty(r: Reader) -> Bool = r.at >= r.end

/// Fails with `Trailing` if the reader has anything left to read.
pub fn finish(r: Reader) -> Unit / {asn1.fail} = if is_empty(r) { () } else { fail(r.at, Trailing) }

/// The tag of the next element, or `None` if nothing is left.
pub fn peek(r: Reader) -> Option<Tag> / {asn1.fail, abort.raise} =
  if is_empty(r) { None } else { Some(header_at(r.data, r.at, r.end).tag) }

fn after(r: Reader, h: Header) -> Reader = { ..r, at: h.to, implicit: None }

fn expect(r: Reader, tag: Tag, constructed: Bool) -> Header / {asn1.fail, abort.raise} = {
  let h = header_at(r.data, r.at, r.end);
  if h.tag != tag { fail(r.at, WrongTag(h.tag)) }
  else if h.constructed != constructed { fail(r.at, WrongForm) }
  else { h }
}

fn expect_universal(
  r: Reader,
  number: Int,
  constructed: Bool,
) -> Header / {asn1.fail, abort.raise} =
  expect(r, match r.implicit { Some(tag) -> tag, None -> universal(number) }, constructed)

fn leaf<a>(
  r: Reader,
  number: Int,
  of: (Bytes, Int) -> a / {asn1.fail, abort.raise},
) -> ReadResult<a> / {asn1.fail, abort.raise} = {
  let h = expect_universal(r, number, false);
  { value: of(r.data.slice(h.from, h.to), h.from), rest: after(r, h) }
}

/// A `BOOLEAN`.
pub fn read_boolean(r: Reader) -> ReadResult<Bool> / {asn1.fail, abort.raise} =
  leaf(r, 1, boolean_of)

/// An `INTEGER`, as its content: the number's two's complement in the fewest octets.
pub fn read_integer(r: Reader) -> ReadResult<Bytes> / {asn1.fail, abort.raise} =
  leaf(r, 2, integer_of)

/// An `INTEGER` that fits in an `Int`, or `TooWide` for any other.
pub fn read_int(r: Reader) -> ReadResult<Int> / {asn1.fail, abort.raise} = leaf(r, 2, int_of)

/// An `INTEGER` of any size.
pub fn read_big_int(r: Reader) -> ReadResult<BigInt> / {asn1.fail, abort.raise} =
  leaf(r, 2, |content: Bytes, at: Int| big_int_of_integer(integer_of(content, at)))

/// An `INTEGER` that is not negative, as its magnitude: most significant octet first with no
/// leading zero octet, and one zero octet for zero. `Negative` for one below zero.
pub fn read_unsigned(r: Reader) -> ReadResult<Bytes> / {asn1.fail, abort.raise} =
  leaf(r, 2, unsigned_of)

/// An `ENUMERATED` that fits in an `Int`.
pub fn read_enumerated(r: Reader) -> ReadResult<Int> / {asn1.fail, abort.raise} =
  leaf(r, 10, int_of)

/// A `BIT STRING`.
pub fn read_bit_string(r: Reader) -> ReadResult<Bits> / {asn1.fail, abort.raise} =
  leaf(r, 3, bits_of)

/// A `BIT STRING` that is a list of named bits, which DER ends at its last one bit:
/// `TrailingZeroBits` for one that ends in a zero.
pub fn read_named_bits(r: Reader) -> ReadResult<Bits> / {asn1.fail, abort.raise} =
  leaf(r, 3, named_bits_of)

/// An `OCTET STRING`.
pub fn read_octet_string(r: Reader) -> ReadResult<Bytes> / {asn1.fail, abort.raise} =
  leaf(r, 4, |content: Bytes, _: Int| content)

/// A `NULL`.
pub fn read_null(r: Reader) -> ReadResult<Unit> / {asn1.fail, abort.raise} = leaf(r, 5, null_of)

/// An `OBJECT IDENTIFIER`.
pub fn read_oid(r: Reader) -> ReadResult<Oid> / {asn1.fail, abort.raise} = leaf(r, 6, oid_of)

/// A string of the type `kind`.
pub fn read_string(r: Reader, kind: StringKind) -> ReadResult<String> / {asn1.fail, abort.raise} =
  leaf(r, string_number(kind), |content: Bytes, at: Int| text_of(kind, content, at))

/// A `UTCTime`: the instant it names, at UTC, with its two-digit year read as 1950 to 2049.
pub fn read_utc_time(r: Reader) -> ReadResult<OffsetDateTime> / {asn1.fail, abort.raise} =
  leaf(r, 23, utc_time_of)

/// A `GeneralizedTime`: the instant it names, at UTC.
pub fn read_generalized_time(r: Reader) -> ReadResult<OffsetDateTime> / {asn1.fail, abort.raise} =
  leaf(r, 24, generalized_time_of)

/// The `Time` of an X.509 certificate: a `UTCTime`, or for a year outside 1950 to 2049 a
/// `GeneralizedTime` without a fraction of a second. `WrongTimeType` for a `GeneralizedTime` that
/// X.509 requires be written as a `UTCTime`.
pub fn read_time(r: Reader) -> ReadResult<OffsetDateTime> / {asn1.fail, abort.raise} =
  if peek(r) != Some(universal(24)) { read_utc_time(r) } else {
    let read = read_generalized_time(r);
    if (year_of(read.value) >= 1950 && year_of(read.value) <= 2049)
        || nanosecond_of(read.value) != 0 { fail(r.at, WrongTimeType) }
    else { read }
  }

/// The content of a primitive element of `tag`, whatever it contains.
pub fn read_primitive(r: Reader, tag: Tag) -> ReadResult<Bytes> / {asn1.fail, abort.raise} = {
  let h = expect(r, tag, false);
  { value: r.data.slice(h.from, h.to), rest: after(r, h) }
}

fn enter(r: Reader, h: Header) -> ReadResult<Reader> / {asn1.fail} =
  if r.room <= 0 { fail(r.at, TooDeep) } else {
    {
      value: { data: r.data, at: h.from, end: h.to, room: r.room - 1, implicit: None },
      rest: after(r, h),
    }
  }

/// A reader over the contents of a constructed element of `tag`.
pub fn read_constructed(r: Reader, tag: Tag) -> ReadResult<Reader> / {asn1.fail, abort.raise} =
  enter(r, expect(r, tag, true))

/// A reader over the fields of a `SEQUENCE`.
pub fn read_sequence(r: Reader) -> ReadResult<Reader> / {asn1.fail, abort.raise} =
  enter(r, expect_universal(r, 16, true))

/// Reads the element in `inner` with `item` and returns its value together with the reader that
/// followed that element in the original input. Fails with `Trailing` if `item` leaves unread
/// content in the element.
pub fn within<a | e>(
  inner: ReadResult<Reader>,
  item: (Reader) -> ReadResult<a> / {asn1.fail, abort.raise | e},
) -> ReadResult<a> / {asn1.fail, abort.raise | e} = {
  let read = item(inner.value);
  finish(read.rest);
  { value: read.value, rest: inner.rest }
}

/// A field tagged explicitly, `[n] EXPLICIT`: the one element inside a constructed element of
/// `tag`, read by `item`.
pub fn read_explicit<a | e>(
  r: Reader,
  tag: Tag,
  item: (Reader) -> ReadResult<a> / {asn1.fail, abort.raise | e},
) -> ReadResult<a> / {asn1.fail, abort.raise | e} = within(read_constructed(r, tag), item)

/// Reads a field tagged implicitly, `[n] IMPLICIT`: `item` reads the next element, expecting `tag`
/// in place of its type's own. `item` is one of this module's typed reads, or `read_sequence_of` or
/// `read_set_of`. A read that names its own tag, such as `read_primitive`, ignores the implicit
/// tag.
pub fn read_implicit<a | e>(
  r: Reader,
  tag: Tag,
  item: (Reader) -> ReadResult<a> / {asn1.fail, abort.raise | e},
) -> ReadResult<a> / {asn1.fail, abort.raise | e} = item({ ..r, implicit: Some(tag) })

/// A field that may be absent: `item`'s reading of the next element if its tag is `tag`.
/// Otherwise, or if nothing is left, `None` with the reader unchanged.
pub fn read_optional<a | e>(
  r: Reader,
  tag: Tag,
  item: (Reader) -> ReadResult<a> / {asn1.fail, abort.raise | e},
) -> ReadResult<Option<a>> / {asn1.fail, abort.raise | e} =
  if peek(r) != Some(tag) { { value: None, rest: r } } else {
    let read = item(r);
    { value: Some(read.value), rest: read.rest }
  }

/// A field with a default: `default` when it is absent, as `read_optional` decides, and
/// `DefaultEncoded` if it is written out with that value, which DER requires be left out.
pub fn read_default<a | e>(
  r: Reader,
  tag: Tag,
  default: a,
  item: (Reader) -> ReadResult<a> / {asn1.fail, abort.raise | e},
) -> ReadResult<a> / {asn1.fail, abort.raise | e}
  where derivable(eq, a)
= {
  let read = read_optional(r, tag, item);
  match read.value {
    None -> { value: default, rest: read.rest },
    Some(value) -> if value == default { fail(r.at, DefaultEncoded) }
    else { { value: value, rest: read.rest } },
  }
}

fn members<a | e>(
  inner: Reader,
  item: (Reader) -> ReadResult<a> / {asn1.fail, abort.raise | e},
  sorted: Bool,
  last: Bytes,
  accumulator: List<a>,
  left: Int,
) -> List<a> / {asn1.fail, abort.raise | e} =
  if is_empty(inner) || left <= 0 { accumulator } else {
    let h = header_at(inner.data, inner.at, inner.end);
    let whole = if sorted { inner.data.slice(inner.at, h.to) } else { b"" };
    if compare(last, whole) == Greater { fail(inner.at, Unsorted) } else {
      let read = item({ ..inner, end: h.to });
      finish(read.rest);
      members({ ..inner, at: h.to }, item, sorted, whole, accumulator.push(read.value), left - 1)
    }
  }

/// A `SEQUENCE OF`: each member read by `item`, which reads one element.
pub fn read_sequence_of<a | e>(
  r: Reader,
  item: (Reader) -> ReadResult<a> / {asn1.fail, abort.raise | e},
) -> ReadResult<List<a>> / {asn1.fail, abort.raise | e} = {
  let inner = read_sequence(r);
  {
    value: members(inner.value, item, false, b"", [], inner.value.end - inner.value.at),
    rest: inner.rest,
  }
}

/// A `SET OF`: each member read by `item`, which reads one element. `Unsorted` unless the members
/// are in the order of their encodings.
pub fn read_set_of<a | e>(
  r: Reader,
  item: (Reader) -> ReadResult<a> / {asn1.fail, abort.raise | e},
) -> ReadResult<List<a>> / {asn1.fail, abort.raise | e} = {
  let inner = enter(r, expect_universal(r, 17, true));
  {
    value: members(inner.value, item, true, b"", [], inner.value.end - inner.value.at),
    rest: inner.rest,
  }
}

/// The next element whole, header included, as needed for the bytes a signature covers.
pub fn read_raw(r: Reader) -> ReadResult<Bytes> / {asn1.fail, abort.raise} = {
  let h = header_at(r.data, r.at, r.end);
  { value: r.data.slice(r.at, h.to), rest: after(r, h) }
}

/// The next element, whatever it is, as a tree.
pub fn read_any(r: Reader) -> ReadResult<Value> / {asn1.fail, abort.raise} = {
  let tree = tree_at(r.data, r.at, r.end, r.room);
  { value: tree.value, rest: { ..r, at: tree.at, implicit: None } }
}

/// What `item` reads from all of `data`, entering at most `depth` nested elements. Fails with
/// `Trailing` if it leaves anything unread.
pub fn read_with<a | e>(
  data: Bytes,
  depth: Int,
  item: (Reader) -> ReadResult<a> / {asn1.fail, abort.raise | e},
) -> a / {asn1.fail, abort.raise | e} = {
  let read = item(reader(data, depth));
  finish(read.rest);
  read.value
}

/// Reads with `read_with` and returns a failure as an `Err` instead of raising `asn1.fail`.
pub fn decode_with<a | e>(
  data: Bytes,
  depth: Int,
  item: (Reader) -> ReadResult<a> / {asn1.fail, abort.raise | e},
) -> Result<a, Error> / {abort.raise | e} = try { read_with(data, depth, item) }

fn is_constructed_type(number: Int) -> Bool =
  number == 8 || number == 11 || number == 16 || number == 17 || number == 29

fn untyped(tag: Tag, constructed: Bool) -> Bool =
  if tag.class != Universal { true }
  else if constructed { tag.number == 8 || tag.number == 11 || tag.number == 29 } else {
    !is_constructed_type(tag.number) && (tag.number < 1 || tag.number > 6) && tag.number != 10
      && tag.number != 23
      && tag.number != 24
      && string_kind(tag.number) == None
  }

fn leaf_value(tag: Tag, content: Bytes, at: Int) -> Value / {asn1.fail, abort.raise} =
  if tag.class != Universal { Primitive(tag, content) } else {
    match tag.number {
      1 -> Boolean(boolean_of(content, at)),
      2 -> Integer(integer_of(content, at)),
      3 -> BitString(bits_of(content, at)),
      4 -> OctetString(content),
      5 -> {
        null_of(content, at);
        Null
      },
      6 -> ObjectId(oid_of(content, at)),
      10 -> Enumerated(integer_of(content, at)),
      23 -> UtcTime(utc_time_of(content, at)),
      24 -> GeneralizedTime(generalized_time_of(content, at)),
      number -> match string_kind(number) {
        Some(kind) -> Text(kind, text_of(kind, content, at)),
        None -> Primitive(tag, content),
      },
    }
  }

fn tree_at(
  data: Bytes,
  at: Int,
  end: Int,
  depth_left: Int,
) -> { value: Value, at: Int } / {asn1.fail, abort.raise} = {
  let h = header_at(data, at, end);
  if h.tag.class == Universal && h.constructed != is_constructed_type(h.tag.number) {
    fail(at, WrongForm)
  } else if !h.constructed {
    { value: leaf_value(h.tag, data.slice(h.from, h.to), h.from), at: h.to }
  } else if depth_left <= 0 { fail(at, TooDeep) } else {
    let set = h.tag == universal(17);
    let children = trees(data, h.from, h.to, depth_left - 1, set, b"", [], h.to - h.from);
    {
      value: if set { Set(children) }
      else if h.tag == universal(16) { Sequence(children) }
      else { Constructed(h.tag, children) },
      at: h.to,
    }
  }
}

fn trees(
  data: Bytes,
  at: Int,
  end: Int,
  depth_left: Int,
  sorted: Bool,
  last: Bytes,
  accumulator: List<Value>,
  left: Int,
) -> List<Value> / {asn1.fail, abort.raise} =
  if at >= end || left <= 0 { accumulator } else {
    let tree = tree_at(data, at, end, depth_left);
    let whole = if sorted { data.slice(at, tree.at) } else { b"" };
    if compare(last, whole) == Greater { fail(at, Unsorted) } else {
      trees(data, tree.at, end, depth_left, sorted, whole, accumulator.push(tree.value), left - 1)
    }
  }

/// The document `data` encodes, nested at most `depth` deep. Raises `asn1.fail` where `decode`
/// returns `Err`.
pub fn read(data: Bytes, depth: Int) -> Value / {asn1.fail, abort.raise} =
  read_with(data, depth, read_any)

/// The document `data` encodes, nested at most `depth` deep, or why it is not exactly one DER
/// value.
pub fn decode(data: Bytes, depth: Int) -> Result<Value, Error> / {abort.raise} =
  try { read(data, depth) }

fn exact_integer(content: Bytes) -> Bytes / {asn1.unwritable, abort.raise} =
  if content.len() == 0 { asn1.unwritable(EmptyInteger) }
  else if redundant(content, 0) { asn1.unwritable(OverlongInteger) }
  else { content }

/// Returns the encoding of `v`. Raises `asn1.unwritable` where `encode` returns `Err`. It writes
/// only trees that `read` could have returned: an `Integer` uses the fewest octets, a `Set` is in
/// order, and a `Primitive` or `Constructed` has a tag that `read` would not turn into another kind
/// of value.
pub fn write(v: Value) -> Bytes / {asn1.unwritable, abort.raise} =
  match v {
    Boolean(b) -> boolean(b),
    Integer(content) -> element(0x02, exact_integer(content)),
    Enumerated(content) -> element(0x0A, exact_integer(content)),
    BitString(b) -> bit_string(b),
    OctetString(octets) -> octet_string(octets),
    Null -> null(),
    ObjectId(o) -> oid(o),
    Text(kind, text) -> string(kind, text),
    UtcTime(t) -> if date::offset_minutes(t) == 0 { utc_time(t) } else { asn1.unwritable(BadTime) },
    GeneralizedTime(t) -> if date::offset_minutes(t) == 0 { generalized_time(t) }
    else { asn1.unwritable(BadTime) },
    Sequence(children) -> sequence(children.map(write)),
    Set(children) -> {
      let parts = children.map(write);
      if parts.is_sorted() { element(0x31, Bytes::concat_all(parts)) }
      else { asn1.unwritable(Unsorted) }
    },
    Constructed(tag, children) -> if untyped(tag, true) { constructed(tag, children.map(write)) }
    else { asn1.unwritable(BadTag) },
    Primitive(tag, content) -> if untyped(tag, false) { primitive(tag, content) }
    else { asn1.unwritable(BadTag) },
  }

/// The encoding of `v`, or why it has none.
pub fn encode(v: Value) -> Result<Bytes, ErrorKind> / {abort.raise} = try { write(v) }

fn height(v: Value) -> Int =
  match v {
    Sequence(children) | Set(children) | Constructed(_, children) ->
      1 + children.map(height).fold(0, |deepest: Int, h: Int| max(deepest, h)),
    _ -> 0,
  }

fn in_calendar(t: OffsetDateTime) -> Bool =
  match t {
    OffsetDateTime(DateTime(on, clock), _) ->
      date::of_unix_days(date::unix_days(on)) == Some(on)
        && date::time_of_nanos(date::nanos_of_day(clock)) == Some(clock),
  }

fn all_times_valid(v: Value) -> Bool =
  match v {
    UtcTime(t) | GeneralizedTime(t) -> in_calendar(t),
    Sequence(children) | Set(children) | Constructed(_, children) -> children.all(all_times_valid),
    _ -> true,
  }

fn can_encode(v: Value) -> Bool / {abort.raise} =
  all_times_valid(v) && (match encode(v) { Ok(_) -> true, Err(_) -> false })

fn rewritten(data: Bytes) -> Bool / {abort.raise} =
  match decode(data, 64) { Err(_) -> true, Ok(v) -> encode(v) == Ok(data) }

fn altered(data: Bytes, at: Int, octet: Int) -> Bytes / {abort.raise} =
  if data.len() == 0 { data } else {
    let i = (at & 9223372036854775807) % data.len();
    Bytes::concat_all([data.slice(0, i), byte_of_int(octet & 0xFF), data.slice(i + 1, data.len())])
  }

fn oids() -> gen::Gen<Oid> = gen::map(gen::list(gen::any_int()), |arcs: List<Int>| Oid(arcs))

fn values_at(depth: Int) -> gen::Gen<Value> =
  if depth <= 0 {
    gen::one_of([
      gen::map(gen::bool(), |f0: Bool| Boolean(f0)),
      gen::map(gen::bytes(), |f0: Bytes| Integer(f0)),
      gen::map(gen::bytes(), |f0: Bytes| Enumerated(f0)),
      gen::map(arbitrary_bits(), |f0: Bits| BitString(f0)),
      gen::map(gen::bytes(), |f0: Bytes| OctetString(f0)),
      gen::constant(Null),
      gen::map(oids(), |f0: Oid| ObjectId(f0)),
      gen::map2(string_kinds(), gen::text(), |f0: StringKind, f1: String| Text(f0, f1)),
      gen::map(date::offset_date_times(), |f0: OffsetDateTime| UtcTime(f0)),
      gen::map(date::offset_date_times(), |f0: OffsetDateTime| GeneralizedTime(f0)),
      gen::map2(tags(), gen::bytes(), |f0: Tag, f1: Bytes| Primitive(f0, f1)),
    ])
  } else {
    gen::one_of([
      gen::map(gen::bool(), |f0: Bool| Boolean(f0)),
      gen::map(gen::bytes(), |f0: Bytes| Integer(f0)),
      gen::map(gen::bytes(), |f0: Bytes| Enumerated(f0)),
      gen::map(arbitrary_bits(), |f0: Bits| BitString(f0)),
      gen::map(gen::bytes(), |f0: Bytes| OctetString(f0)),
      gen::constant(Null),
      gen::map(oids(), |f0: Oid| ObjectId(f0)),
      gen::map2(string_kinds(), gen::text(), |f0: StringKind, f1: String| Text(f0, f1)),
      gen::map(date::offset_date_times(), |f0: OffsetDateTime| UtcTime(f0)),
      gen::map(date::offset_date_times(), |f0: OffsetDateTime| GeneralizedTime(f0)),
      gen::map(gen::list_of(values_at(depth - 1), 3), |f0: List<Value>| Sequence(f0)),
      gen::map(gen::list_of(values_at(depth - 1), 3), |f0: List<Value>| Set(f0)),
      gen::map2(tags(), gen::list_of(values_at(depth - 1), 3), |f0: Tag, f1: List<Value>|
        Constructed(f0, f1)),
      gen::map2(tags(), gen::bytes(), |f0: Tag, f1: Bytes| Primitive(f0, f1)),
    ])
  }

fn values() -> gen::Gen<Value> = gen::sized(|size: Int| values_at(min(max(size / 16, 0), 3)))

fn arbitrary_bits() -> gen::Gen<Bits> =
  gen::map2(gen::any_int(), gen::bytes(), |unused: Int, bytes: Bytes|
    { unused: unused, bytes: bytes })

fn string_kinds() -> gen::Gen<StringKind> =
  gen::elements([
    Utf8String,
    NumericString,
    PrintableString,
    Ia5String,
    VisibleString,
    UniversalString,
    BmpString,
  ])

fn tags() -> gen::Gen<Tag> =
  gen::map2(classes(), gen::any_int(), |class: Class, number: Int| { class: class, number: number })

fn classes() -> gen::Gen<Class> = gen::elements([Universal, Application, Context, Private])

test "`decode` of the bytes `write` produces for an encodable value returns that same value" {
  gen::check(values(), |v: Value|
    if can_encode(v) { decode(write(v), height(v)) == Ok(v) } else { true })
}

test "a written value with one octet changed is rejected or is another value's encoding" {
  gen::check3(values(), gen::any_int(), gen::any_int(), |v: Value, at: Int, octet: Int|
    if can_encode(v) { rewritten(altered(write(v), at, octet)) } else { true })
}

law "a Bool reads back from the BOOLEAN written for it" =
  round_trip(boolean, |der: Bytes| decode_with(der, 0, read_boolean).ok())

type Vector = { name: String, der: Bytes, value: Value }

fn vector(name: String, der: Bytes, value: Value) -> Vector = { name: name, der: der, value: value }

fn zeros(n: Int) -> Bytes = b"\x00".repeat(n)

fn vectors() -> List<Vector> / {abort.raise} =
  [
    vector("TRUE", Bytes::of_hex("0101ff"), Boolean(true)),
    vector("FALSE", Bytes::of_hex("010100"), Boolean(false)),
    vector("the INTEGER 0", Bytes::of_hex("020100"), Integer(b"\x00")),
    vector("the INTEGER 127", Bytes::of_hex("02017f"), Integer(b"\x7f")),
    vector("the INTEGER 128", Bytes::of_hex("02020080"), Integer(b"\x00\x80")),
    vector("the INTEGER -128", Bytes::of_hex("020180"), Integer(b"\x80")),
    vector("the INTEGER -129", Bytes::of_hex("0202ff7f"), Integer(b"\xff\x7f")),
    vector("an ENUMERATED", Bytes::of_hex("0a0101"), Enumerated(b"\x01")),
