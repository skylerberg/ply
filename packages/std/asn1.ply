    vector("a length of 127", Bytes::of_hex("047f").concat(zeros(127)), OctetString(zeros(127))),
    vector("a length of 128", Bytes::of_hex("048180").concat(zeros(128)), OctetString(zeros(128))),
    vector(
      "a length of 256",
      Bytes::of_hex("04820100").concat(zeros(256)),
      OctetString(zeros(256)),
    ),
    vector(
      "a length of 65536",
      Bytes::of_hex("0483010000").concat(zeros(65536)),
      OctetString(zeros(65536)),
    ),
  ]

test "`decode` returns the expected value for the DER bytes of {c.name}, and `encode` returns those bytes for the value" for c: Vector in vectors(
  ) {
  assert_eq(decode(c.der, 1), Ok(c.value));
  assert_eq(encode(c.value), Ok(c.der))
}

type RejectedInput = { name: String, der: Bytes, at: Int, reason: ErrorKind }

fn error_case(name: String, der: Bytes, at: Int, reason: ErrorKind) -> RejectedInput =
  { name: name, der: der, at: at, reason: reason }

