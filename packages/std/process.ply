//! The process a program runs in, and the programs it runs, as an effect.
//!
//! The operations on the program's own process take a label, `[proc]` by convention. Only `ply run`
//! binds them. `ply test` does not bind them and reports `E0424` for a use of one, because a test
//! is not a process.
//!
//! Under `ply run --json`, what the program writes to standard output goes to stderr, lines and
//! bytes alike and each immediately, so stdout still carries only the one JSON object.
//!
//! Standard output is buffered and standard error is not. `out_bytes` adds to the buffer. The
//! buffer is written when it reaches 64 KiB, when `flush` is called, when `out` writes a line,
//! before anything is written to standard error, before standard input is read, before a child that
//! inherits a stream is started, and when the program ends, however it ends: by returning, by a
//! raise or by `exit`. So the two streams carry what was written in the order it was written, a
//! prompt is shown before the program waits for its answer, and nothing written is lost. `flush`
//! only controls when output appears, for a partial line that should be seen while the program
//! computes or sleeps.
//!
//! Standard input has one buffer, which `line` and `in_bytes` both read. A read of bytes after a
//! line starts where that line ended, and a line after a read of bytes starts where those bytes
//! ended.
//!
//! A stream whose reader has gone away, as when the program writes into `head`, accepts nothing
//! more. `out_bytes`, `err_bytes` and `flush` then return `false`, and `write_out`, `write_err` and
//! `flush_out` raise `pipe.broken` instead, which a program handles as any raise. If the raise is
//! not handled, and for a line written with `out` or `err`, which return nothing, the run ends
//! there quietly with the status a shell reports for `SIGPIPE`, 141.
//!
//! `std.io` provides the three streams as a `Source` and two `Sink`s (`io::stdin`, `io::stdout`,
//! `io::stderr`), for code that reads and writes any stream.
//!
//! The operations that run another program take an executable as their label. `--exec
//! cc=/usr/bin/cc` binds one program to `cc`, and `process.spawn[cc](..)` can start that program
//! and no other, so the run decides what a `process.spawn[cc]` in its effects may do. Unlike the
//! operations on the program's own process, these are also bound under `ply test`. A label that no
//! `--exec` names is `E0456`, and an `--exec` path that is missing, is not a file or has no execute
//! bit is `E0457` before anything runs. A child's `dir` is its working directory (`""` is the run's
//! own directory). Unlike an `fs` path, `dir` is not confined to a directory, so the label alone
//! limits what a child can do. A child starts with exactly the environment variables passed in
//! `env` and inherits none of the run's. The host stores at most 64 MiB of each stream a child
//! writes, and a stream larger than that is `E0458`.
//!
//! No child outlives the run that started it: however the run ends, every child still running is
//! killed with `SIGKILL` and reaped by the host.
//!
//! A test replaces the host with fakes. `over` runs a whole program against a `FakeProcess`, which
//! fakes the program's own process. `Spawns` fakes `spawn`, and `Children` fakes `start` and the
//! operations on a started child.

import std.gen
import std.internal.native (encode_texts, native, wait, job_wait, found, parts, encode_parts,
                            decode_int)

/// The program's own process, and the children it runs. `spawn` runs another program to its end,
/// and `start` runs one alongside the program.
pub nondet effect process {
  /// What followed `--` on the `ply run` command line.
  read args[p]() -> List<String>
  /// Whether the run bound an executable to the label, which is decided before anything runs.
  read bound[e]() -> Bool
  /// Writes one line to standard output, after whatever was in its buffer.
  write out[p](text: String) -> Unit
  /// Writes one line to standard error.
  write err[p](text: String) -> Unit
  /// Adds `bytes` to standard output's buffer as they are, with no line ending. Returns `false`
  /// once the stream's reader has gone away, and the bytes are then dropped.
  write out_bytes[p](bytes: Bytes) -> Bool
  /// Writes `bytes` to standard error as they are, with no line ending. Returns `false` once the
  /// stream's reader has gone away.
  write err_bytes[p](bytes: Bytes) -> Bool
  /// Writes the contents of standard output's buffer. Returns `false` when its reader has gone
  /// away.
  write flush[p]() -> Bool
  /// Reads one line of the program's standard input, without its line ending, or returns `None` at
  /// end of input. The line is consumed, so two readers of one input each see different lines. A
  /// line that is not UTF-8 is `E0502`, and `in_bytes` can read it.
  write line[p]() -> Option<String>
  /// Reads what comes next on standard input, at most `max` bytes, waiting until there is
  /// something. A result shorter than `max` does not mean the end, but an empty one does. One read
  /// returns at most 1 MiB, and a negative `max` is `E0502`.
  write in_bytes[p](max: Int) -> Bytes
  /// Ends the program here with `code`, `0` to `125` (else `E0502`). Nothing after it runs and no
  /// value is printed.
  write exit[p](code: Int) -> Unit
  /// Runs the program the label names to its end, with empty input, and returns how it ended and
  /// both streams in full. A stream over 64 MiB is `E0458`.
  write spawn[e](args: List<String>, dir: String, env: List<EnvironmentVariable>) -> CompletedProcess
  /// Starts a child and returns its handle, or why it could not start. The run kills any child
  /// still running when the run ends, however it ends.
  write start[e](args: List<String>, dir: String, env: List<EnvironmentVariable>, io: Io) -> Result<Int, String>
  /// Once the child has ended, returns how it ended and the contents of its streams, and the handle
  /// can no longer be used. Returns `None` if the child is still running at the timeout. A
  /// negative timeout waits as long as it takes.
  write wait[e](child: Int, timeout_ms: Int) -> Option<CompletedProcess>
  /// Sends `signal` to the child. Returns `false` when the child had already ended.
  write signal[e](child: Int, signal: Signal) -> Bool
  /// Writes every byte to the child's input. Returns `false` once the child's input is closed or
  /// the child has ended.
  write input[e](child: Int, bytes: Bytes) -> Bool
  /// Closes the child's input.
  write end_input[e](child: Int) -> Unit
  /// Returns the next line that any of the child's `Lines` streams wrote, in the order the host
  /// read them, without its `\n` or `\r\n`, and with anything not UTF-8 replaced by U+FFFD.
  write output_line[e](child: Int, timeout_ms: Int) -> OutputLine
}

/// The error a write to one of the program's own streams raises.
pub effect pipe {
  /// The stream's reader went away, so the stream accepts nothing more. If nothing handles the
  /// raise under `ply run`, the run ends quietly with status 141, the status a shell reports for a
  /// program killed by `SIGPIPE`.
  raise broken(stream: Stream)
}

/// One of the three streams a process is started with.
pub type Stream = | Stdin | Stdout | Stderr

/// Writes `bytes` to standard output as they are, with no line ending.
pub fn write_out<[p]>(bytes: Bytes) -> Unit / {process.out_bytes[p], pipe.broken} =
  if process.out_bytes[p](bytes) { () } else { pipe.broken(Stdout) }

/// Writes `bytes` to standard error as they are, with no line ending.
pub fn write_err<[p]>(bytes: Bytes) -> Unit / {process.err_bytes[p], pipe.broken} =
  if process.err_bytes[p](bytes) { () } else { pipe.broken(Stderr) }

/// Writes the contents of standard output's buffer.
pub fn flush_out<[p]>() -> Unit / {process.flush[p], pipe.broken} =
  if process.flush[p]() { () } else { pipe.broken(Stdout) }

/// One environment variable of a child, with a name and a value.
pub type EnvironmentVariable = { name: String, value: String }

/// One variable of a child's environment.
pub fn environment_variable(name: String, value: String) -> EnvironmentVariable =
  { name: name, value: value }

/// How a child ended: its own code, or the signal that killed it.
pub type ExitStatus = | Exited(Int) | Signalled(Int)

/// What a child left behind: how it ended and what the host stored of each stream, which for a
/// spawn is everything it wrote.
pub type CompletedProcess = { ended: ExitStatus, out: Bytes, err: Bytes }

/// The code a child exited with, or `None` if a signal killed it.
pub fn exit_code(f: CompletedProcess) -> Option<Int> =
  match f.ended { Exited(code) -> Some(code), Signalled(_) -> None }

/// Says where one of a started child's output streams goes. `Keep` stores all of it for `wait` to
/// return. `Discard` drops it. `Lines` makes each line available through `output_line`, and `wait`
/// returns the lines that `output_line` has not read. `Inherit` writes to the program's own stream.
/// `File` writes to a file, relative to the child's directory, that starts empty.
pub type Output = | Keep | Discard | Inherit | Lines | File(String)

/// How a started child is wired: whether it reads what the program writes, and where each of its
/// output streams goes.
pub type Io = { input: Bool, out: Output, err: Output }

/// `SIGHUP`, `SIGINT`, `SIGTERM`, `SIGKILL`, `SIGUSR1`, `SIGUSR2` or `SIGWINCH`.
pub type Signal = | Hangup | Interrupt | Terminate | Kill | User1 | User2 | WindowChange

/// What `output_line` returns: `LineWritten` with the next line of any `Lines` stream without its
/// ending, `TimedOut` if no line arrived before the timeout, or `Closed` once every `Lines` stream
/// has ended and each of its lines has been read.
pub type OutputLine = | LineWritten(String) | TimedOut | Closed

host for process by host_process

fn host_process<a | e>(
  go: () -> a / {process.read[*], process.write[*] | e},
) -> a / {native.read, wait.read, abort.raise | e} =
  handle {
    go()
  } with {
    process.args[*p]() -> parts(process_args()).map(|arg: Bytes| String::of_bytes_lossy(arg)),
    process.bound[*label]() -> process_bound(label),
    process.out[*p](text) -> process_line(0, text),
    process.err[*p](text) -> process_line(1, text),
    process.out_bytes[*p](bytes) -> process_write(0, bytes),
    process.err_bytes[*p](bytes) -> process_write(1, bytes),
    process.flush[*p]() -> process_flush(),
    process.line[*p]() -> match found(job_wait(process_read_line())) {
      Some(line) -> Some(String::of_bytes_lossy(line)),
      None -> None,
    },
    process.in_bytes[*p](max) -> if max < 0 {
      panic("`process.in_bytes` was asked for " ++ max.to_string() ++ " bytes")
    } else { job_wait(process_read(max)) },
    process.exit[*p](code) -> if code < 0 || code > 125 {
      panic("`process.exit` was given " ++ code.to_string() ++ ", and an exit code is 0 to 125")
    } else { process_exit(code) },
    process.spawn[*label](args, dir, env) ->
      completed_process_of(
        job_wait(process_spawn(label, encode_texts(args), dir, environment(env))),
      ),
    process.start[*label](args, dir, env, io) -> {
      let start_result = process_start(
        label,
        encode_texts(args),
        dir,
        environment(env),
        encode_io(io),
      );
      let rest = start_result.slice(1, start_result.len());
      if start_result.at(0) == 1 { Ok(decode_int(rest)) } else { Err(String::of_bytes_lossy(rest)) }
    },
    process.wait[*label](child, timeout_ms) -> match found(
        job_wait(process_wait(label, child, timeout_ms)),
      ) {
      Some(flat) -> Some(completed_process_of(flat)),
      None -> None,
    },
    process.signal[*label](child, signal) -> process_signal(label, child, signal_number(signal)),
    process.input[*label](child, bytes) -> job_wait(process_input(label, child, bytes)) == b"\x01",
    process.end_input[*label](child) -> process_end_input(label, child),
    process.output_line[*label](child, timeout_ms) ->
      output_line_of(job_wait(process_output_line(label, child, timeout_ms))),
  }

fn environment(env: List<EnvironmentVariable>) -> Bytes =
  encode_parts(
    env.fold([], |accumulator: List<Bytes>, v: EnvironmentVariable|
      accumulator.push(Bytes::of_string(v.name)).push(Bytes::of_string(v.value))),
  )

fn encode_io(io: Io) -> Bytes / {abort.raise} =
  encode_parts([
    Bytes::concat_all(
      [if io.input { 1 } else { 0 }, output_number(io.out), output_number(io.err)].map(|b: Int|
        byte_of_int(b)),
    ),
    Bytes::of_string(output_file(io.out)),
    Bytes::of_string(output_file(io.err)),
  ])

fn output_number(o: Output) -> Int =
  match o { Keep -> 0, Discard -> 1, Inherit -> 2, Lines -> 3, File(_) -> 4 }

fn output_file(o: Output) -> String = match o { File(path) -> path, _ -> "" }

fn signal_number(s: Signal) -> Int =
  match s {
    Hangup -> 0,
    Interrupt -> 1,
    Terminate -> 2,
    Kill -> 3,
    User1 -> 4,
    User2 -> 5,
    WindowChange -> 6,
  }

fn completed_process_of(flat: Bytes) -> CompletedProcess / {abort.raise} =
  match parts(flat) {
    [kind, n, out, err] ->
      {
        ended: if decode_int(kind) == 0 { Exited(decode_int(n)) } else { Signalled(decode_int(n)) },
        out: out,
        err: err,
      },
    _ -> panic("a completed process result does not have four parts: kind, code, output and error"),
  }

fn output_line_of(flat: Bytes) -> OutputLine / {abort.raise} =
  match flat.at(0) {
    0 -> LineWritten(String::of_bytes_lossy(flat.slice(1, flat.len()))),
    1 -> TimedOut,
    _ -> Closed,
  }

extern fn process_args() -> Bytes / {native.read}

extern fn process_bound(label: String) -> Bool / {native.read}

extern fn process_line(stream: Int, text: String) -> Unit / {native.read}

extern fn process_write(stream: Int, bytes: Bytes) -> Bool / {native.read}

extern fn process_flush() -> Bool / {native.read}

extern fn process_read_line() -> Int / {native.read}

extern fn process_read(max: Int) -> Int / {native.read}

extern fn process_exit(code: Int) -> Unit / {native.read}

extern fn process_spawn(label: String, args: Bytes, dir: String, env: Bytes) -> Int / {native.read}

extern fn process_start(
  label: String,
  args: Bytes,
  dir: String,
  env: Bytes,
  encode_io: Bytes,
) -> Bytes / {native.read}

extern fn process_wait(label: String, child: Int, timeout_ms: Int) -> Int / {native.read}

extern fn process_signal(label: String, child: Int, signal: Int) -> Bool / {native.read}

extern fn process_input(label: String, child: Int, bytes: Bytes) -> Int / {native.read}

extern fn process_end_input(label: String, child: Int) -> Unit / {native.read}

extern fn process_output_line(label: String, child: Int, timeout_ms: Int) -> Int / {native.read}

/// One write the fake received: the stream, and the exact bytes, a line including its `\n`.
pub type Write = { stream: Stream, bytes: Bytes }

/// What a test passes to the clauses below in place of the host: the arguments the program was
/// started with, what it may read, what it wrote, and the code it exited with.
pub type FakeProcess = {
  args: List<String>,
  /// The input that has not been read yet, as the chunks that reads return. A read of bytes takes
  /// from the first chunk only, so one read never returns more than one chunk. An empty chunk acts
  /// as an end of input, but later chunks can still follow it, as on a terminal. When the chunks
  /// run out, the input has ended for good.
  input: List<Bytes>,
  /// The text of each call to `process.out`, in order.
  out: List<String>,
  /// The text of each call to `process.err`, in order.
  err: List<String>,
  /// Every write to either stream in the order it was made, lines and bytes alike.
  written: List<Write>,
  /// The streams whose reader has gone away, which accept nothing more.
  gone: List<Stream>,
  code: Option<Int>,
}

/// A fake process started with these arguments, with no input.
pub fn captured(args: List<String>) -> FakeProcess =
  { args: args, input: [], out: [], err: [], written: [], gone: [], code: None }

/// The same fake, reading the given lines before end of input, one chunk per line.
pub fn with_input(c: FakeProcess, lines: List<String>) -> FakeProcess =
  { ..c, input: lines.map(|line: String| Bytes::of_string(line ++ "\n")) }

/// The same fake, with its input returned in these chunks, so a test can reproduce the short reads
/// a pipe or a terminal gives.
pub fn with_chunks(c: FakeProcess, chunks: List<Bytes>) -> FakeProcess = { ..c, input: chunks }

/// The same fake once `stream`'s reader has gone away.
pub fn hung_up(c: FakeProcess, stream: Stream) -> FakeProcess = { ..c, gone: c.gone.push(stream) }

/// Everything written to `stream`, byte for byte.
pub fn written_to(c: FakeProcess, stream: Stream) -> Bytes =
  Bytes::concat_all(
    c.written.fold([], |parts: List<Bytes>, w: Write|
      if w.stream == stream { parts.push(w.bytes) } else { parts }),
  )

/// The status a shell reports for a program that a closed pipe ended.
pub fn broken_pipe_status() -> Int = 141

/// What `process.args` returns for `c`.
pub fn args_step(c: FakeProcess) -> List<String> = c.args

/// One scripted line and the fake with that line consumed. `line` is `None` once the input is
/// empty.
pub type Line = { captured: FakeProcess, line: Option<String> }

type LineSplit = { before: List<Bytes>, after: List<Bytes>, ended: Bool }

fn cut_at_newline(chunks: List<Bytes>) -> LineSplit / {abort.raise} =
  chunks.fold({ before: [], after: [], ended: false }, |cut: LineSplit, chunk: Bytes|
    if cut.ended { { ..cut, after: cut.after.push(chunk) } } else {
      match chunk.index_of_byte(b'\n') {
        None -> { ..cut, before: cut.before.push(chunk) },
        Some(i) -> {
          let rest = chunk.slice(i + 1, chunk.len());
          {
            before: cut.before.push(chunk.slice(0, i)),
            after: if rest.len() == 0 { cut.after } else { cut.after.push(rest) },
            ended: true,
          }
        },
      }
    })

fn before_returns(line: Bytes, n: Int) -> Int / {abort.raise} =
  if n <= 0 { 0 } else if line.at(n - 1) == b'\r' { before_returns(line, n - 1) } else { n }

/// What `process.line` returns for `c`: the input up to its first `\n`, across as many chunks as
/// that takes. What follows stays for the next read, of a line or of bytes. A last line needs no
/// `\n`. A line that is not UTF-8 panics, as the host rejects one.
pub fn line_step(c: FakeProcess) -> Line / {abort.raise} = {
  let cut = cut_at_newline(c.input);
  let line = Bytes::concat_all(cut.before);
  if !cut.ended && line.len() == 0 { { captured: { ..c, input: [] }, line: None } } else {
    {
      captured: { ..c, input: cut.after },
      line: Some(String::of_bytes(line.slice(0, before_returns(line, line.len())))),
    }
  }
}

/// One read's result and the fake with it consumed.
pub type Read = { captured: FakeProcess, bytes: Bytes }

/// Returns what `process.in_bytes` returns for `c`: at most `max` bytes from the first chunk of the
/// input, or nothing once the input has run out. Any unread rest of that chunk stays at the front
/// of the input. Panics if `max` is negative, as the host does.
pub fn in_bytes_step(c: FakeProcess, max: Int) -> Read / {abort.raise} =
  if max < 0 { panic("a read's length cannot be negative") } else {
    match c.input {
      [] -> { captured: c, bytes: b"" },
      [chunk, ..later] -> {
        let n = min(max, chunk.len());
        let left = chunk.slice(n, chunk.len());
        {
          captured: {
            ..c,
            input: if left.len() == 0 { later } else { later.fold([left], List::push) },
          },
          bytes: chunk.slice(0, n),
        }
      },
    }
  }

fn reader_gone(c: FakeProcess, stream: Stream) -> Bool =
  c.gone.fold(false, |gone: Bool, s: Stream| gone || s == stream)

fn line_written(c: FakeProcess, stream: Stream, text: String) -> List<Write> =
  c.written.push({ stream: stream, bytes: Bytes::of_string(text ++ "\n") })

/// What `process.out` records; nothing, once the stream's reader has gone.
pub fn out_step(c: FakeProcess, text: String) -> FakeProcess =
  if reader_gone(c, Stdout) { c }
  else { { ..c, out: c.out.push(text), written: line_written(c, Stdout, text) } }

/// What `process.err` records; nothing, once the stream's reader has gone.
pub fn err_step(c: FakeProcess, text: String) -> FakeProcess =
  if reader_gone(c, Stderr) { c }
  else { { ..c, err: c.err.push(text), written: line_written(c, Stderr, text) } }

/// One write of bytes: the fake after it, and whether the stream accepted them.
pub type WriteResult = { captured: FakeProcess, taken: Bool }

fn bytes_written(c: FakeProcess, stream: Stream, bytes: Bytes) -> WriteResult =
  if reader_gone(c, stream) { { captured: c, taken: false } } else {
    { captured: { ..c, written: c.written.push({ stream: stream, bytes: bytes }) }, taken: true }
  }

/// What `process.out_bytes` returns for `c`, and records.
pub fn out_bytes_step(c: FakeProcess, bytes: Bytes) -> WriteResult = bytes_written(c, Stdout, bytes)

/// What `process.err_bytes` returns for `c`, and records.
pub fn err_bytes_step(c: FakeProcess, bytes: Bytes) -> WriteResult = bytes_written(c, Stderr, bytes)

/// What `process.flush` returns for `c`. The fake buffers nothing, so a flush moves nothing.
pub fn flush_step(c: FakeProcess) -> Bool = !reader_gone(c, Stdout)

/// The first code wins, as under the host: the program has stopped before a second exit can run.
pub fn exit_step(c: FakeProcess, code: Int) -> FakeProcess =
  match c.code { Some(_) -> c, None -> { ..c, code: Some(code) } }

/// What a program returned under a fake, and the fake it left. `value` is `None` when the program
/// ended itself: by `process.exit`, or by a line written to a stream whose reader had gone, which
/// sets the code 141.
pub type FakeRun<a> = { value: Option<a>, captured: FakeProcess }

/// Runs `go` as the program whose process is `c`. The fake handles every operation on its own
/// streams, arguments and exit code, as the host handles them.
pub fn over<a, [p] | e>(
  c: FakeProcess,
  go: () -> a / {process.args[p], process.out[p], process.err[p], process.out_bytes[p], process.err_bytes[p], process.flush[p], process.line[p], process.in_bytes[p], process.exit[p] | e},
) -> FakeRun<a> / {abort.raise | e} =
  handle {
    go()
  } with {
    var io = c,
    process.args[p]() -> args_step(io),
    process.out[p](text) resume k -> {
      let l = lined(io, Stdout, out_step(io, text));
      io = l.io;
      if l.ok { k(()) } else { { value: None, captured: io } }
    },
    process.err[p](text) resume k -> {
      let l = lined(io, Stderr, err_step(io, text));
      io = l.io;
      if l.ok { k(()) } else { { value: None, captured: io } }
    },
    process.out_bytes[p](bytes) -> {
      let w = out_bytes_step(io, bytes);
      io = w.captured;
      w.taken
    },
    process.err_bytes[p](bytes) -> {
      let w = err_bytes_step(io, bytes);
      io = w.captured;
      w.taken
    },
    process.flush[p]() -> flush_step(io),
    process.line[p]() -> {
      let read = line_step(io);
      io = read.captured;
      read.line
    },
    process.in_bytes[p](max) -> {
      let read = in_bytes_step(io, max);
      io = read.captured;
      read.bytes
    },
    process.exit[p](code) resume k -> { value: None, captured: exit_step(io, code) },
    return value -> { value: Some(value), captured: io },
  }

fn lined(io: FakeProcess, stream: Stream, after: FakeProcess) -> { io: FakeProcess, ok: Bool } = {
  let gone = reader_gone(io, stream);
  { io: if gone { exit_step(io, broken_pipe_status()) } else { after }, ok: !gone }
}

/// What one spawn or start requested. The executable is not included: `label` names it, and the
/// host decides which program `label` refers to.
pub type Launch = { args: List<String>, dir: String, env: List<EnvironmentVariable> }

/// The replies a test gives to spawns, in order, and the launches the program has requested so far.
/// `bound` is what `process.bound` returns for the label: true when a reply is planned, unless the
/// test sets it. No step changes `bound`.
pub type Spawns = { replies: List<CompletedProcess>, launched: List<Launch>, bound: Bool }

/// A fake that replies to spawns with `replies`, in order.
pub fn runs(replies: List<CompletedProcess>) -> Spawns =
  { replies: replies, launched: [], bound: replies.len() > 0 }

/// What `process.bound` returns for `r`.
pub fn spawns_bound_step(r: Spawns) -> Bool = r.bound

/// One spawn's result and the fake that recorded it.
pub type Ran = { runs: Spawns, finished: CompletedProcess }

/// A spawn the test planned no reply for exits with 127, as a shell does for a command it cannot
/// run.
pub fn spawn_step(r: Spawns, launch: Launch) -> Ran =
  match r.replies {
    [] ->
      {
        runs: { ..r, launched: r.launched.push(launch) },
        finished: { ended: Exited(127), out: b"", err: b"" },
      },
    [first, ..rest] ->
      { runs: { ..r, replies: rest, launched: r.launched.push(launch) }, finished: first },
  }

/// A child that exited with `code` and wrote these streams.
pub fn exited(code: Int, out: Bytes, err: Bytes) -> CompletedProcess =
  { ended: Exited(code), out: out, err: err }

/// A child killed by `signal`, having written these streams.
pub fn signalled(signal: Int, out: Bytes, err: Bytes) -> CompletedProcess =
  { ended: Signalled(signal), out: out, err: err }

/// One child a test plans: how many `wait`s find it still running, how it ends, and what
/// `output_line` returns from it, in order.
pub type Script = { polls: Int, finished: CompletedProcess, output_lines: List<OutputLine> }

/// A child that `wait` finds running `polls` times and then `finished`, and whose lines are
/// `heard`.
pub fn script(polls: Int, finished: CompletedProcess, output_lines: List<OutputLine>) -> Script =
  { polls: polls, finished: finished, output_lines: output_lines }

/// A started child and what the program did to it: the bytes it wrote to the child's input,
/// whether that input is still open, and the signals it sent.
pub type Child = {
  launch: Launch,
  io: Io,
  script: Script,
  written: Bytes,
  open: Bool,
  signals: List<Signal>,
  reaped: Bool,
}

/// What a test passes to the children's clauses in place of the host. `unstarted` holds the planned
/// children, which `start` takes in order. `started` holds each child that has been started; a
/// child's handle is its position in `started`, counting from 1. `bound` is what `process.bound`
/// returns for the label: true when a child is planned, unless the test sets it. No step changes
/// `bound`.
pub type Children = { unstarted: List<Script>, started: List<Child>, bound: Bool }

/// A fake that gives the planned children to `start`s, in order.
pub fn children(planned: List<Script>) -> Children =
  { unstarted: planned, started: [], bound: planned.len() > 0 }

/// What `process.bound` returns for `c`.
pub fn children_bound(c: Children) -> Bool = c.bound

/// The outcome of one fake step: the updated `Children` state and the value the real operating
/// system would have returned for that step.
pub type ChildResult<a> = { children: Children, result: a }

/// Starts the next planned child and returns its handle, counting from 1. Returns `Err` when every
/// planned child has already been started.
pub fn start_step(c: Children, launch: Launch, io: Io) -> ChildResult<Result<Int, String>> =
  match c.unstarted {
    [] -> { children: c, result: Err("no child was planned for this start") },
    [first, ..rest] -> {
      let child = {
        launch: launch,
        io: io,
        script: first,
        written: b"",
        open: io.input,
        signals: [],
        reaped: false,
      };
      let started = c.started.push(child);
      { children: { ..c, unstarted: rest, started: started }, result: Ok(started.len()) }
    },
  }

fn child_at(c: Children, child: Int) -> Child / {abort.raise} =
  match c.started.at(child - 1) {
    None -> panic("no child has the handle " ++ child.to_string()),
    Some(one) -> if one.reaped {
      panic("child " ++ child.to_string() ++ " has already been waited on")
    } else { one },
  }

fn replaced(c: Children, child: Int, one: Child) -> Children / {abort.raise} =
  { ..c, started: c.started.set(child - 1, one) }

/// What `process.wait` returns for `c`: the child's `CompletedProcess` once its planned polls are
/// used up, after which the handle can no longer be used.
pub fn wait_step(c: Children, child: Int) -> ChildResult<Option<CompletedProcess>> / {abort.raise} = {
  let one = child_at(c, child);
  if one.script.polls > 0 {
    let polled = { ..one.script, polls: one.script.polls - 1 };
    { children: replaced(c, child, { ..one, script: polled }), result: None }
  } else {
    { children: replaced(c, child, { ..one, reaped: true }), result: Some(one.script.finished) }
  }
}

/// `Kill` ends a scripted child as it ends a real one, so the next `wait` returns it.
pub fn signal_step(c: Children, child: Int, signal: Signal) -> ChildResult<Bool> / {abort.raise} = {
  let one = child_at(c, child);
  let polls = match signal { Kill -> 0, _ -> one.script.polls };
  let signalled = {
    ..one,
    script: { ..one.script, polls: polls },
    signals: one.signals.push(signal),
  };
  { children: replaced(c, child, signalled), result: true }
}

/// Appends `bytes` to what the child has been sent and returns `true`. Returns `false` and discards
/// the bytes when the child's input has been closed.
pub fn input_step(c: Children, child: Int, bytes: Bytes) -> ChildResult<Bool> / {abort.raise} = {
  let one = child_at(c, child);
  if one.open {
    let input_bytes = { ..one, written: one.written.concat(bytes) };
    { children: replaced(c, child, input_bytes), result: true }
  } else { { children: c, result: false } }
}

/// Closes the child's input, so later calls to `input_step` for it return `false`.
pub fn end_input_step(c: Children, child: Int) -> Children / {abort.raise} =
  replaced(c, child, { ..child_at(c, child), open: false })

/// When the script runs out, the child's lines are closed, as at the end of a stream.
pub fn output_line_step(c: Children, child: Int) -> ChildResult<OutputLine> / {abort.raise} = {
  let one = child_at(c, child);
  match one.script.output_lines {
    [] -> { children: c, result: Closed },
    [first, ..rest] -> {
      let updated_child = { ..one, script: { ..one.script, output_lines: rest } };
      { children: replaced(c, child, updated_child), result: first }
    },
  }
}

fn greet(names: List<String>) -> Unit / {process.out[proc]} =
  match names {
    [] -> (),
    [first, ..rest] -> {
      process.out[proc]("hello " ++ first);
      greet(rest)
    },
  }

fn greet_all() -> Unit / {process.args[proc], process.out[proc], process.err[proc], process.exit[proc]} = {
  let names = process.args[proc]();
  if names.len() == 0 {
    process.err[proc]("no one to greet");
    process.exit[proc](2)
  } else {
    greet(names);
    process.exit[proc](0)
  }
}

test "a program run against the fake process writes its lines in order, each on the stream it chose" {
  let c = handle {
    greet_all()
  } with {
    var s = captured(["ada", "bob"]),
    process.args[proc]() -> args_step(s),
    process.out[proc](t) -> {
      s = out_step(s, t);
    },
    process.err[proc](t) -> {
      s = err_step(s, t);
    },
    process.exit[proc](c) -> {
      s = exit_step(s, c);
    },
    return u -> s,
  };
  assert_eq(c.out, ["hello ada", "hello bob"]);
  assert_eq(c.err, []);
  assert_eq(c.code, Some(0))
}

test "a `process.exit` handler that does not resume ends the program, so later output is never written" {
  let c = handle {
    greet_all();
    process.out[proc]("after the exit")
  } with {
    var s = captured([]),
    process.args[proc]() -> args_step(s),
    process.out[proc](t) -> {
      s = out_step(s, t);
    },
    process.err[proc](t) -> {
      s = err_step(s, t);
    },
    process.exit[proc](c) resume k -> exit_step(s, c),
    return u -> s,
  };
  assert_eq(c.out, []);
  assert_eq(c.err, ["no one to greet"]);
  assert_eq(c.code, Some(2))
}

test "a new fake process has the given arguments, no output, no errors and no exit code" {
  let c = captured(["--verbose"]);
  assert_eq(args_step(c), ["--verbose"]);
  assert_eq(c.out, []);
  assert_eq(c.err, []);
  assert_eq(c.code, None)
}

test "the first exit code is the one recorded" {
  let once = exit_step(captured([]), 3);
  assert_eq(once.code, Some(3));
  assert_eq(exit_step(once, 4).code, Some(3))
}

fn compile(unit: String) -> Result<Bytes, String> / {process.spawn[cc]} = {
  let done = process.spawn[cc](["-c", unit, "-o", unit ++ ".o"], "build", [
    environment_variable("LANG", "C"),
    environment_variable("TMPDIR", "/tmp"),
  ]);
  match done.ended {
    Exited(code) -> if code == 0 { Ok(done.out) } else { Err("cc exited " ++ code.to_string()) },
    Signalled(sig) -> Err("cc was killed by signal " ++ sig.to_string()),
  }
}

test "a spawn is handled by the fake, which records what it was asked to run" {
  let seen = handle {
    assert_eq(compile("lexer.c"), Ok(b"built"))
  } with {
    var s = runs([exited(0, b"built", b"")]),
    process.spawn[cc](args, dir, env) -> {
      let r = spawn_step(s, { args: args, dir: dir, env: env });
      s = r.runs;
      r.finished
    },
    return u -> s,
  };
  assert_eq(seen.launched.len(), 1);
  match seen.launched.at(0) {
    None -> panic("the spawn was recorded"),
    Some(one) -> {
      assert_eq(one.args, ["-c", "lexer.c", "-o", "lexer.c.o"]);
      assert_eq(one.dir, "build");
      assert_eq(one.env, [
        environment_variable("LANG", "C"),
        environment_variable("TMPDIR", "/tmp"),
      ])
    },
  }
}

test "a nonzero exit and a signal are both ordinary results" {
  handle {
    assert_eq(compile("parser.c"), Err("cc exited 1"))
  } with {
    process.spawn[cc](args, dir, env) -> exited(1, b"", b"parser.c:3: expected `;`"),
  };
  handle {
    assert_eq(compile("parser.c"), Err("cc was killed by signal 9"))
  } with {
    process.spawn[cc](args, dir, env) -> signalled(9, b"", b""),
  }
}

fn echo_lines() -> Unit / {process.line[proc], process.out[proc], diverges} =
  match process.line[proc]() {
    None -> (),
    Some(text) -> {
      process.out[proc](text);
      echo_lines()
    },
  }

test "a program reads lines until the input ends, and each ends at its newline" {
  let c = handle {
    echo_lines()
  } with {
    var s = with_input(captured([]), ["one", "two"]),
    process.line[proc]() -> {
      let step = line_step(s);
      s = step.captured;
      step.line
    },
    process.out[proc](t) -> {
      s = out_step(s, t);
    },
    return u -> s,
  };
  assert_eq(c.out, ["one", "two"]);
  assert_eq(line_step(captured([])).line, None)
}

test "`spawn_step` with no scripted result returns exit code 127 and still records the launch" {
  let r = spawn_step(runs([]), { args: [], dir: "", env: [] });
  assert_eq(exit_code(r.finished), Some(127));
  assert_eq(r.finished.out, b"");
  assert_eq(r.runs.launched.len(), 1);
  assert_eq(exit_code(signalled(9, b"", b"")), None)
}

fn supervise(
  tries: Int,
) -> Result<CompletedProcess, String> / {process.start[srv], process.output_line[srv], process.signal[srv], process.wait[srv]} = {
  let child = process.start[srv](["serve"], "", [], { input: false, out: Lines, err: Inherit })?;
  if listening(child, tries) {
    let _ = process.signal[srv](child, Terminate);
    match process.wait[srv](child, 1000) { Some(done) -> Ok(done), None -> killed(child) }
  } else {
    let _ = killed(child);
    Err("the server never said it was listening")
  }
}

fn listening(child: Int, tries: Int) -> Bool / {process.output_line[srv]} =
  if tries <= 0 { false } else {
    match process.output_line[srv](child, 100) {
      LineWritten(line) -> line.starts_with("listening") || listening(child, tries - 1),
      TimedOut -> listening(child, tries - 1),
      Closed -> false,
    }
  }

fn killed(
  child: Int,
) -> Result<CompletedProcess, String> / {process.signal[srv], process.wait[srv]} = {
  let _ = process.signal[srv](child, Kill);
  match process.wait[srv](child, -1) {
    Some(done) -> Ok(done),
    None -> Err("the server was still running after it was killed"),
  }
}

fn supervised(
  planned: List<Script>,
) -> ChildResult<Result<CompletedProcess, String>> / {abort.raise} =
  handle {
    supervise(5)
  } with {
    var kids = children(planned),
    process.start[srv](args, dir, env, io) -> {
      let step = start_step(kids, { args: args, dir: dir, env: env }, io);
      kids = step.children;
      step.result
    },
    process.output_line[srv](child, timeout_ms) -> {
      let step = output_line_step(kids, child);
      kids = step.children;
      step.result
    },
    process.signal[srv](child, signal) -> {
      let step = signal_step(kids, child, signal);
      kids = step.children;
      step.result
    },
    process.wait[srv](child, timeout_ms) -> {
      let step = wait_step(kids, child);
      kids = step.children;
      step.result
    },
    return result -> { children: kids, result: result },
  }

fn only_child(c: Children) -> Child / {abort.raise} =
  match c.started { [one] -> one, _ -> panic("expected exactly one child to have been started") }

test "a server that reports it is listening is stopped, and the stop is what ended it" {
  let run = supervised([
    script(0, exited(0, b"", b""), [
      LineWritten("booting"),
      TimedOut,
      LineWritten("listening on 8080"),
    ]),
  ]);
  assert_eq(run.result, Ok(exited(0, b"", b"")));
  let server = only_child(run.children);
  assert_eq(server.launch.args, ["serve"]);
  assert_eq(server.io, { input: false, out: Lines, err: Inherit });
  assert_eq(server.signals, [Terminate]);
  assert(server.reaped)
}

test "a server that does not exit after a terminate signal is then sent a kill signal, and the run returns its killed status" {
  let run = supervised([script(3, signalled(9, b"", b""), [LineWritten("listening on 8080")])]);
  assert_eq(run.result, Ok(signalled(9, b"", b"")));
  assert_eq(only_child(run.children).signals, [Terminate, Kill])
}

test "a server that never reports it is listening is killed rather than waited on" {
  let run = supervised([script(10, signalled(9, b"", b""), [LineWritten("booting")])]);
  assert_eq(run.result, Err("the server never said it was listening"));
  assert_eq(only_child(run.children).signals, [Kill])
}

test "starting a child when none is scripted fails, and nothing is waited on" {
  let run = supervised([]);
  assert_eq(run.result, Err("no child was planned for this start"));
  assert_eq(run.children.started, [])
}

fn feed(
  lines: List<String>,
) -> Result<Bytes, String> / {process.start[tool], process.input[tool], process.end_input[tool], process.wait[tool]} = {
  let child = process.start[tool](["--stdin"], "", [], { input: true, out: Keep, err: Discard })?;
  let input_bytes = lines.fold(true, |ok: Bool, line: String|
    ok && process.input[tool](child, Bytes::of_string(line ++ "\n")));
  process.end_input[tool](child);
  match process.wait[tool](child, -1) {
    Some(done) -> if input_bytes { Ok(done.out) } else { Err("the tool stopped reading") },
    None -> Err("the tool is still running"),
  }
}

test "a tool fed through its input gets every byte, then the end of its input" {
  let left = handle {
    assert_eq(feed(["one", "two"]), Ok(b"2 lines\n"))
  } with {
    var kids = children([script(0, exited(0, b"2 lines\n", b""), [])]),
    process.start[tool](args, dir, env, io) -> {
      let step = start_step(kids, { args: args, dir: dir, env: env }, io);
      kids = step.children;
      step.result
    },
    process.input[tool](child, bytes) -> {
      let step = input_step(kids, child, bytes);
      kids = step.children;
      step.result
    },
    process.end_input[tool](child) -> {
      kids = end_input_step(kids, child);
    },
    process.wait[tool](child, timeout_ms) -> {
      let step = wait_step(kids, child);
      kids = step.children;
      step.result
    },
    return u -> kids,
  };
  let tool = only_child(left);
  assert_eq(tool.written, b"one\ntwo\n");
  assert(!tool.open)
}

test "a child's input accepts nothing once it is ended or was never opened" {
  let io = { input: true, out: Keep, err: Keep };
  let started = start_step(
    children([script(0, exited(0, b"", b""), [])]),
    { args: [], dir: "", env: [] },
    io,
  );
  let ended = end_input_step(started.children, 1);
  assert_eq(input_step(ended, 1, b"late").result, false);
  let unopened = start_step(
    children([script(0, exited(0, b"", b""), [])]),
    { args: [], dir: "", env: [] },
    { ..io, input: false },
  );
  assert_eq(input_step(unopened.children, 1, b"early").result, false)
}

test "a fake child's `wait` returns nothing until its scripted delay passes, then its exit status, and its output lines end with `Closed`" {
  let started = start_step(
    children([script(2, exited(3, b"", b""), [LineWritten("one")])]),
    { args: [], dir: "", env: [] },
    { input: false, out: Lines, err: Keep },
  );
  let first = wait_step(started.children, 1);
  assert_eq(first.result, None);
  let second = wait_step(first.children, 1);
  assert_eq(second.result, None);
  let first_line = output_line_step(second.children, 1);
  assert_eq(first_line.result, LineWritten("one"));
  assert_eq(output_line_step(first_line.children, 1).result, Closed);
  let third = wait_step(first_line.children, 1);
  assert_eq(third.result, Some(exited(3, b"", b"")));
  assert(only_child(third.children).reaped)
}

fn tools_bound() -> List<Bool> / {process.bound[cc], process.bound[srv]} =
  [process.bound[cc](), process.bound[srv]()]

test "`bound` returns true for a label the fake binds and false for one it does not" {
  handle {
    assert_eq(tools_bound(), [true, false])
  } with {
    process.bound[cc]() -> spawns_bound_step(runs([exited(0, b"", b"")])),
    process.bound[srv]() -> children_bound(children([])),
  };
  handle {
    assert_eq(tools_bound(), [false, true])
  } with {
    process.bound[cc]() -> spawns_bound_step(runs([])),
    process.bound[srv]() -> children_bound(children([script(0, exited(0, b"", b""), [])])),
  }
}

test "a fake handler still reports its label as bound after all its scripted results are used, and a test can set that flag itself" {
  let launch = { args: [], dir: "", env: [] };
  let spent = spawn_step(runs([exited(0, b"", b"")]), launch).runs;
  assert_eq(spent.replies, []);
  assert(spawns_bound_step(spent));
  let planned = children([script(0, exited(0, b"", b""), [])]);
  let started = start_step(planned, launch, { input: false, out: Keep, err: Keep });
  assert_eq(started.children.unstarted, []);
  assert(children_bound(wait_step(started.children, 1).children));
  assert(!children_bound({ ..planned, bound: false }));
  assert(spawns_bound_step({ ..runs([]), bound: true }))
}

fn ask(
  question: String,
) -> Option<String> / {process.out_bytes[proc], process.line[proc], pipe.broken} = {
  write_out[proc](Bytes::of_string(question));
  process.line[proc]()
}

test "`ask` writes its prompt without a newline and reads the reply from the next input line" {
  let ran = over[proc](with_input(captured([]), ["ada"]), || ask("name: "));
  assert_eq(ran.value, Some(Some("ada")));
  assert_eq(written_to(ran.captured, Stdout), b"name: ");
  assert_eq(ran.captured.out, []);
  assert_eq(ran.captured.input, [])
}

test "`line_step` and `in_bytes_step` read from the same input, and each continues where the other stopped" {
  let first = line_step(with_chunks(captured([]), [b"head", b"er\r\nbo", b"dy\nlast"]));
  assert_eq(first.line, Some("header"));
  let some = in_bytes_step(first.captured, 100);
  assert_eq(some.bytes, b"bo");
  let more = in_bytes_step(some.captured, 1);
  assert_eq(more.bytes, b"d");
  let second = line_step(more.captured);
  assert_eq(second.line, Some("y"));
  let last = line_step(second.captured);
  assert_eq(last.line, Some("last"));
  assert_eq(line_step(last.captured).line, None);
  assert_eq(in_bytes_step(last.captured, 8).bytes, b"")
}

test "`in_bytes_step` returns no more bytes than requested or than the next chunk contains, and an empty chunk returns no bytes without ending the input" {
  let c = with_chunks(captured([]), [b"abc", b"", b"de"]);
  let none = in_bytes_step(c, 0);
  assert_eq(none.bytes, b"");
  assert_eq(none.captured.input, c.input);
  let two = in_bytes_step(c, 2);
  assert_eq(two.bytes, b"ab");
  let short = in_bytes_step(two.captured, 100);
  assert_eq(short.bytes, b"c");
  let ended = in_bytes_step(short.captured, 100);
  assert_eq(ended.bytes, b"");
  assert_eq(in_bytes_step(ended.captured, 100).bytes, b"de")
}

test "the fake records what was written to each stream, and both in the order it was written" {
  let ran = over[proc](captured([]), || {
    write_out[proc](b"a");
    process.err[proc]("warn");
    process.out[proc]("b");
    write_err[proc](b"\x00\xff")
  });
  assert_eq(ran.captured.written, [
    { stream: Stdout, bytes: b"a" },
    { stream: Stderr, bytes: b"warn\n" },
    { stream: Stdout, bytes: b"b\n" },
    { stream: Stderr, bytes: b"\x00\xff" },
  ]);
  assert_eq(written_to(ran.captured, Stdout), b"ab\n");
  assert_eq(written_to(ran.captured, Stderr), b"warn\n\x00\xff");
  assert_eq(ran.captured.out, ["b"]);
  assert_eq(ran.captured.err, ["warn"])
}

test "writing to a closed stdout raises `pipe.broken`, which a program can catch, and otherwise ends the program" {
  let closed = hung_up(captured([]), Stdout);
  let returned = over[proc](closed, || {
    let wrote: Result<Unit, Stream> = try[pipe.broken] { write_out[proc](b"x") };
    wrote
  });
  assert_eq(returned.value, Some(Err(Stdout)));
  assert_eq(returned.captured.code, None);
  let flushed = over[proc](closed, || {
    let wrote: Result<Unit, Stream> = try[pipe.broken] { flush_out[proc]() };
    wrote
  });
  assert_eq(flushed.value, Some(Err(Stdout)));
  let ended = over[proc](closed, || {
    process.err[proc]("still read");
    process.out[proc]("into nothing");
    process.err[proc]("never written")
  });
  assert_eq(ended.value, None);
  assert_eq(ended.captured.code, Some(broken_pipe_status()));
  assert_eq(ended.captured.err, ["still read"]);
  assert_eq(written_to(ended.captured, Stdout), b"")
}

test "`process.exit` run against the fake stops the program there, with the output written so far and the exit code" {
  let ran = over[proc](captured(["x"]), || {
    process.out[proc](at_first(process.args[proc]()));
    process.exit[proc](3);
    process.out[proc]("after the exit")
  });
  assert_eq(ran.value, None);
  assert_eq(ran.captured.out, ["x"]);
  assert_eq(ran.captured.code, Some(3))
}

fn at_first(args: List<String>) -> String = match args { [first, ..] -> first, [] -> "" }

type ChunkedInput = { head: List<Int>, tail: List<Int>, ask: Int }

fn input_bytes(picks: List<Int>) -> Bytes =
  Bytes::concat_all(
    picks.map(|p: Int| if p % 3 == 0 { b"\n" } else if p % 3 == 1 { b"\x00" } else { b"\xff" }),
  )

fn read_in_pieces(f: ChunkedInput) -> Bytes / {abort.raise} = {
  let chunks = [input_bytes(f.head), input_bytes(f.tail)].filter(|chunk: Bytes| chunk.len() > 0);
  let most = (f.ask % 5 + 5) % 5 + 1;
  Bytes::concat_all(
    iterate(
      { fake: with_chunks(captured([]), chunks), parts: [] },
      f.head.len() + f.tail.len() + 2,
      |s: { fake: FakeProcess, parts: List<Bytes> }| {
        let read = in_bytes_step(s.fake, most);
        if read.bytes.len() == 0 { Stop(s.parts) }
        else { Continue({ fake: read.captured, parts: s.parts.push(read.bytes) }) }
      },
    ),
  )
}

fn read_whole(f: ChunkedInput) -> Bytes = input_bytes(f.head).concat(input_bytes(f.tail))

fn chunked_inputs() -> gen::Gen<ChunkedInput> =
  gen::map3(
    gen::list(gen::any_int()),
    gen::list(gen::any_int()),
    gen::any_int(),
    |head: List<Int>, tail: List<Int>, ask: Int| { head: head, tail: tail, ask: ask },
  )

test "what a program reads is what its input contained, whatever the chunks and however much each read requests" {
  gen::check(chunked_inputs(), |f: ChunkedInput| { read_in_pieces(f) == read_whole(f) })
}
