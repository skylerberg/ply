//! Reads and writes PEM, the text format that certificates and keys are stored in, as RFC 7468
//! defines it.
//!
//! A block is a `-----BEGIN label-----` line, base64 data, and a `-----END label-----` line with
//! the same label. `read` returns every block in the text, in order, and ignores any text outside
//! the blocks, such as the notes a certificate bundle contains. Inside a block, `read` accepts
//! lines of any length, any of the three line endings, blanks at the end of a line, and empty lines
//! before the data. It rejects everything else. The lines together must be canonical base64, as
//! `std.base64` reads it. The `BEGIN` and `END` labels must match. A line that looks like a `BEGIN`
//! or `END` line must be a valid one. `write` produces the strict form: 64 columns and nothing
//! extra.
//!
//! RFC 7468 allows no headers. The `Name: value` lines that legacy PEM (RFC 1421) puts above the
//! data are still read and written, because keys in that form still exist. A header that marks a
//! block as encrypted is rejected with the `Encrypted` error; `explain` returns the message that
//! describes it.
//!
//! A private key is returned as a `Key`: the DER bytes of a `PRIVATE KEY` block, wrapped in a
//! `Secret`. A `Key` can be compared and passed to functions that take a secret, such as the
//! private key readers in `std.crypto`. It cannot be shown, encoded or written out again. The
//! caller must discard the text the key was read from.
//!
//! `read` and `write` raise `pem.fail` with the line number and the reason. `decode` and `encode`
//! return the same error as an `Err`. A reader has a maximum text length; text longer than that is
//! rejected with `TooLong`.

import std.base64 (base64_decode_secret, base64_encode)
import std.bytes
import std.laws (agrees)
import std.list
import std.radix
import std.string
import std.gen

/// What a block declares it contains. Labels with the same text are equal, however each was built:
/// `Other("CERTIFICATE")` is `Certificate`. Each shows as the text between the hyphens.
pub type Label =
  /// `CERTIFICATE`: an X.509 certificate.
  | Certificate
  /// `X509 CRL`: a certificate revocation list.
  | Crl
  /// `CERTIFICATE REQUEST`: a PKCS #10 certification request.
  | CertificateRequest
  /// `PKCS7`: a PKCS #7 message.
  | Pkcs7
  /// `CMS`: a Cryptographic Message Syntax message.
  | Cms
  /// `PRIVATE KEY`: a PKCS #8 private key, unencrypted.
  | PrivateKey
  /// `ENCRYPTED PRIVATE KEY`: a PKCS #8 private key under a password.
  | EncryptedPrivateKey
  /// `ATTRIBUTE CERTIFICATE`: an X.509 attribute certificate, which binds attributes such as roles
  /// to a holder.
  | AttributeCertificate
  /// `PUBLIC KEY`: a public key with its algorithm.
  | PublicKey
  /// `RSA PRIVATE KEY`: a PKCS #1 private key.
  | RsaPrivateKey
  /// `EC PRIVATE KEY`: a SEC 1 private key.
  | EcPrivateKey
  /// Any other label, by its text.
  | Other(String)

key for Label by label_text

show for Label by label_text

/// One `Name: value` line of the headers legacy PEM put above a block's data.
pub type Header = new { name: String, value: String }

/// A block whose bytes anyone may read.
pub type Block = new { label: Label, headers: List<Header>, data: Bytes }

/// A private key as a reader returns it: the bytes its block carried, in a `Secret`.
pub type Key = new { label: Label, headers: List<Header>, cache_key: Secret<Bytes> }

/// One block of a parsed text: a `Block`, or a `Key` when the label is a private key's.
pub type Item = | Open(Block) | Sealed(Key)

/// The reason a text is not valid PEM, or a block cannot be written as PEM.
pub type ErrorKind =
  /// The text is longer than the limit the reader was given.
  | TooLong
  /// A line starts like a boundary but is not one: five hyphens, a label, five hyphens, then
  /// blanks.
  | BadBoundary
  /// An `-----END` line with no block open.
  | Unopened
  /// A block with no `-----END` line before the next `-----BEGIN` or the text's end.
  | Unclosed
  /// An `-----END` line whose label is not its `-----BEGIN` line's.
  | Mismatched
  /// A header that is not a name, a colon and a value, or headers with no empty line after them.
  | BadHeader
  /// A block encrypted the legacy way, by its `Proc-Type` header.
  | Encrypted
  /// A line of a block's data that is not base64 characters, or an empty line among them.
  | BadData
  /// Data lines that together are not canonical padded base64.
  | NotCanonical
  /// A block to write whose label is not one a boundary line can carry.
  | BadLabel

/// An error and the line it is about, counted from one. The line is the block's `-----BEGIN`
/// line for `Unclosed`, the first line for `TooLong`, and the line it would have had for a block
/// being written.
pub type Error = new { line: Int, reason: ErrorKind }

/// What this module's readers and writers raise when they fail.
pub effect pem {
  /// The text is not PEM, or the block cannot be written as it.
  raise fail(e: Error)
}

/// The text between a boundary line's hyphens for `label`.
pub fn label_text(label: Label) -> String =
  match label {
    Certificate -> "CERTIFICATE",
    Crl -> "X509 CRL",
    CertificateRequest -> "CERTIFICATE REQUEST",
    Pkcs7 -> "PKCS7",
    Cms -> "CMS",
    PrivateKey -> "PRIVATE KEY",
    EncryptedPrivateKey -> "ENCRYPTED PRIVATE KEY",
    AttributeCertificate -> "ATTRIBUTE CERTIFICATE",
    PublicKey -> "PUBLIC KEY",
    RsaPrivateKey -> "RSA PRIVATE KEY",
    EcPrivateKey -> "EC PRIVATE KEY",
    Other(text) -> text,
  }

/// The label that a boundary line's text names. Only the exact texts give the named labels: RFC
/// 7468 treats `X509 CERTIFICATE` and `NEW CERTIFICATE REQUEST` as distinct from the labels they
/// resemble.
pub fn label_of(text: String) -> Label =
  match text {
    "CERTIFICATE" -> Certificate,
    "X509 CRL" -> Crl,
    "CERTIFICATE REQUEST" -> CertificateRequest,
    "PKCS7" -> Pkcs7,
    "CMS" -> Cms,
    "PRIVATE KEY" -> PrivateKey,
    "ENCRYPTED PRIVATE KEY" -> EncryptedPrivateKey,
    "ATTRIBUTE CERTIFICATE" -> AttributeCertificate,
    "PUBLIC KEY" -> PublicKey,
    "RSA PRIVATE KEY" -> RsaPrivateKey,
    "EC PRIVATE KEY" -> EcPrivateKey,
    _ -> Other(text),
  }

/// Whether a block with this label is key material that a reader seals: a label ending in
/// `PRIVATE KEY`, except `ENCRYPTED PRIVATE KEY`, whose bytes are already protected by a password.
pub fn is_private(label: Label) -> Bool =
  label_text(label).ends_with("PRIVATE KEY") && label != EncryptedPrivateKey

/// `block` with its bytes hidden in a `Secret`, as a reader returns a private key.
pub fn seal(block: Block) -> Key =
  { label: block.label, headers: block.headers, cache_key: Secret::of_bytes(block.data) }

/// What a reader returns for `block`: the block itself, or its sealed key when the label is
/// private.
pub fn item(block: Block) -> Item =
  if is_private(block.label) { Sealed(seal(block)) } else { Open(block) }

/// Returns a sentence describing `reason`, for showing to a person.
pub fn explain(reason: ErrorKind) -> String =
  match reason {
    TooLong -> "the text is longer than the limit given to the reader",
    BadBoundary -> "a line starts like a BEGIN or END line but is not a valid one",
    Unopened -> "an END line appears where no block is open",
    Unclosed -> "a block has no matching END line",
    Mismatched -> "an END line has a different label than its BEGIN line",
    BadHeader ->
      "a header must be a name, a colon and a value on one line, and an empty line ends the headers",
    Encrypted ->
      "the block holds a private key encrypted with a legacy method, which derives the encryption key from a password using MD5: "
        ++ "decrypt the private key with the tool that encrypted it, then save it again in PKCS #8 format, "
        ++ "whose label is ENCRYPTED PRIVATE KEY",
    BadData -> "each line of a block's data must be non-empty and contain only base64 characters",
    NotCanonical -> "a block's data lines together are not valid base64 with correct `=` padding",
    BadLabel ->
      "a label must be printable ASCII, and a space or hyphen must not be the first or last character of the label",
  }

/// Every block of `text`, in order, with private keys sealed. A text of more than `limit` bytes is
/// rejected without being read. Raises `pem.fail` where `decode` returns `Err`.
pub fn read(text: String, limit: Int) -> List<Item> / {pem.fail, abort.raise} = {
  let raw = Bytes::of_string(text);
  if raw.len() > limit { fail(1, TooLong) } else {
    let walked = rows_of(raw).fold({ items: [], line: 0, block: None }, step);
    match walked.block { Some(o) -> fail(o.line, Unclosed), None -> walked.items }
  }
}

fn rows_of(text: Bytes) -> List<Bytes> = {
  let rows = text.replace(b"\r\n", b"\n").replace(b"\r", b"\n").split(b"\n");
  if rows.at(rows.len() - 1) == Some(b"") { rows.take(rows.len() - 1) } else { rows }
}

/// Returns every block of `text` in order. When `text` is not valid PEM, returns an `Error` with
/// the line where it stops being PEM and the reason.
pub fn decode(text: String, limit: Int) -> Result<List<Item>, Error> / {abort.raise} =
  try { read(text, limit) }

/// `block` in the strict form: its boundary lines, its headers followed by an empty line if it has
/// any, and its bytes in base64 at 64 columns, each line ended with a line feed. Raises
/// `pem.fail` where `encode` returns `Err`: for a label or a header that no reader here would
/// read back.
pub fn write(block: Block) -> String / {pem.fail, abort.raise} = {
  let label = label_text(block.label);
  if !is_label(Bytes::of_string(label)) { fail(1, BadLabel) } else {
    let head = block.headers.fold(
      ["-----BEGIN " ++ label ++ "-----"],
      |lines: List<String>, h: Header| lines.push(header_line(h, lines.len() + 1)),
    );
    String::unlines(
      [
        if block.headers.len() == 0 { head } else { head.push("") },
        radix::wrap(base64_encode(block.data), 64),
        ["-----END " ++ label ++ "-----"],
      ].flatten(
      ),
    )
  }
}

/// `block` in the strict form, or why it cannot be written.
pub fn encode(block: Block) -> Result<String, Error> / {abort.raise} = try { write(block) }

fn fail<a>(line: Int, reason: ErrorKind) -> a / {pem.fail} =
  pem.fail({ line: line, reason: reason })

type ReadState = { items: List<Item>, line: Int, block: Option<OpenBlock> }

type OpenBlock = {
  label: String,
  line: Int,
  stage: Stage,
  headers: List<Header>,
  data: List<Bytes>,
  first: Int,
}

type Stage = | Start | Headed | Gap | Data

fn step(w: ReadState, raw: Bytes) -> ReadState / {pem.fail, abort.raise} = {
  let line = w.line + 1;
  let row = raw.slice(0, trimmed_length(raw, raw.len()));
  let begins = row.starts_with(b"-----BEGIN ");
  let ends = row.starts_with(b"-----END ");
  match w.block {
    None -> if begins {
      { items: w.items, line: line, block: Some(open_block(label_in(row, 11, line), line)) }
    } else if ends {
      let _ = label_in(row, 9, line);
      fail(line, Unopened)
    } else { { items: w.items, line: line, block: None } },
    Some(o) -> if ends {
      { items: w.items.push(closed(o, label_in(row, 9, line), line)), line: line, block: None }
    } else if begins { fail(o.line, Unclosed) }
    else { { items: w.items, line: line, block: Some(read_block_line(o, row, line)) } },
  }
}

fn open_block(label: String, line: Int) -> OpenBlock =
  { label: label, line: line, stage: Start, headers: [], data: [], first: 0 }

/// The length of the first `n` bytes of `row` before the spaces and tabs they end in.
pub fn trimmed_length(row: Bytes, n: Int) -> Int / {abort.raise} =
  if n > 0 && (row.at(n - 1) == 32 || row.at(n - 1) == 9) { trimmed_length(row, n - 1) } else { n }

fn label_in(row: Bytes, lead: Int, line: Int) -> String / {pem.fail, abort.raise} = {
  let end = row.len() - 5;
  if end < lead || !row.ends_with(b"-----") || !is_label(row.slice(lead, end)) {
    fail(line, BadBoundary)
  } else { String::of_bytes(row.slice(lead, end)) }
}

fn is_label(text: Bytes) -> Bool =
  range(0, text.len()).fold(true, |ok: Bool, i: Int| {
    let c = text.at(i);
    ok && c >= 32 && c <= 126
      && (!is_space_or_hyphen(c)
      || (i > 0 && i + 1 < text.len() && !is_space_or_hyphen(text.at(i - 1))))
  })

fn is_space_or_hyphen(c: Int) -> Bool = c == 32 || c == 45

fn read_block_line(o: OpenBlock, row: Bytes, line: Int) -> OpenBlock / {pem.fail, abort.raise} = {
  let empty = row.len() == 0;
  let named = row.index_of_byte(58) != None;
  match o.stage {
    Start -> if empty { { ..o, stage: Gap } }
    else if named { header(o, row, line) }
    else { data(o, row, line) },
    Headed -> if empty { { ..o, stage: Gap } }
    else if named { header(o, row, line) }
    else { fail(line, BadHeader) },
    Gap -> if empty { o } else { data(o, row, line) },
    Data -> data(o, row, line),
  }
}

fn header(o: OpenBlock, row: Bytes, line: Int) -> OpenBlock / {pem.fail, abort.raise} = {
  let colon = row.skip_until(0, b":");
  let name = row.slice(0, colon);
  let value = row.slice(row.skip(colon + 1, b" \t"), row.len());
  if !is_name(name) { fail(line, BadHeader) }
  else if is_encryption_header(name, value) { fail(line, Encrypted) } else {
    {
      ..o,
      stage: Headed,
      headers: o.headers.push({ name: String::of_bytes(name), value: String::of_bytes(value) }),
    }
  }
}

fn is_name(name: Bytes) -> Bool =
  name.len() > 0 && name.position(0, |c: Int| c < 33 || c > 126 || c == 58) == None

fn is_encryption_header(name: Bytes, value: Bytes) -> Bool =
  name == b"Proc-Type" && value.contains(b"ENCRYPTED")

fn data(o: OpenBlock, row: Bytes, line: Int) -> OpenBlock / {pem.fail} =
  if row.len() == 0 || row.scan(0, data_bytes, row.len()) < row.len() { fail(line, BadData) } else {
    { ..o, stage: Data, data: o.data.push(row), first: if o.first == 0 { line } else { o.first } }
  }

const data_bytes: Bytes = radix::base64.symbols.concat(b"=")

fn closed(o: OpenBlock, label: String, line: Int) -> Item / {pem.fail, abort.raise} =
  if label != o.label { fail(line, Mismatched) }
  else if o.stage == Headed { fail(line, BadHeader) } else {
    match radix::parse(radix::base64, String::of_bytes(Bytes::concat_all(o.data))) {
      Err(r) -> fail(line_of(o, r.at), NotCanonical),
      Ok(bytes) -> item({ label: label_of(o.label), headers: o.headers, data: bytes }),
    }
  }

fn line_of(o: OpenBlock, at: Int) -> Int =
  min(
    o.first + o.data.len() - 1,
    o.data.fold({ line: o.first, left: at }, |s: { line: Int, left: Int }, row: Bytes|
      if s.left < 0 { s }
      else if s.left < row.len() { { line: s.line, left: -1 } }
      else { { line: s.line + 1, left: s.left - row.len() } }).line,
  )

fn header_line(h: Header, line: Int) -> String / {pem.fail} = {
  let name = Bytes::of_string(h.name);
  let value = Bytes::of_string(h.value);
  if !is_name(name) || !is_value(value) { fail(line, BadHeader) }
  else if is_encryption_header(name, value) { fail(line, Encrypted) }
  else { h.name ++ ": " ++ h.value }
}

fn is_value(value: Bytes) -> Bool =
  value.position(0, |c: Int| c < 32 || c == 127) == None && !value.starts_with(b" ")
    && !value.ends_with(b" ")

const labels: List<Label> =
  [
    Certificate,
    Crl,
    CertificateRequest,
    Pkcs7,
    Cms,
    PrivateKey,
    EncryptedPrivateKey,
    AttributeCertificate,
    PublicKey,
    RsaPrivateKey,
    EcPrivateKey,
    Other("TRUSTED CERTIFICATE"),
  ]

fn sample(c: { kind: Int, data: Bytes }) -> Block =
  {
    label: labels.at_or((c.kind % 12 + 12) % 12, Certificate),
    headers: if c.kind % 2 == 0 { [] } else { [{ name: "Comment", value: "a b" }] },
    data: c.data,
  }

test "`decode` of `write` output returns the same block, except a private key comes back as a `Sealed` value" {
  gen::check(
    gen::map2(gen::any_int(), gen::bytes(), |kind: Int, data: Bytes| { kind: kind, data: data }),
    |x: { kind: Int, data: Bytes }|
      agrees(
        |c: { kind: Int, data: Bytes }| decode(write(sample(c)), 1048576),
        |c: { kind: Int, data: Bytes }| Ok([item(sample(c))]),
        x,
      ),
  )
}

fn der_whole(data: Bytes) -> Bool = {
  let n = data.len();
  if n < 2 || data.at(0) != 0x30 { false } else {
    let first = data.at(1);
    if first < 0x80 { n == 2 + first }
    else if first == 0x81 { n >= 3 && n == 3 + data.at(2) }
    else if first == 0x82 { n >= 4 && n == 4 + (data.at(2) << 8 | data.at(3)) }
    else { false }
  }
}

fn letters(text: String) -> String =
  text.split("\n").fold("", |all: String, row: String|
    if row.starts_with("-----") { all } else { all ++ row })

type Rfc7468Example = { figure: Int, label: String, size: Int, text: String }

test "`read` parses the RFC 7468 example figure {c.figure} ({c.label}), and `write` reproduces the text of a public block" for c: Rfc7468Example in rfc7468_examples {
  match read(c.text, 4096) {
    [Open(b)] -> {
      assert(!is_private(label_of(c.label)));
      assert_eq(b.label, label_of(c.label));
      assert_eq(b.headers, []);
      assert_eq(b.data.len(), c.size);
      assert(der_whole(b.data));
      assert(c.text.ends_with("\n" ++ write(b)) || c.text == write(b))
    },
    [Sealed(k)] -> {
      assert(is_private(label_of(c.label)));
      assert_eq(k.label, label_of(c.label));
      assert(Some(k.cache_key) == base64_decode_secret(Secret::of_string(letters(c.text))))
    },
    other -> assert_eq(other.len(), 1),
  }
}

test "`label_of` turns each known label text into its own constructor, and only `TRUSTED CERTIFICATE` becomes `Other`" {
  assert_eq(
    labels.filter(|l: Label| match label_of(label_text(l)) { Other(_) -> true, _ -> false }),
    [Other("TRUSTED CERTIFICATE")],
  );
  assert_eq(
    labels.map(|l: Label| match l { Other(_) -> "", _ -> label_text(label_of(label_text(l))) }),
    [
      "CERTIFICATE",
      "X509 CRL",
      "CERTIFICATE REQUEST",
      "PKCS7",
      "CMS",
      "PRIVATE KEY",
      "ENCRYPTED PRIVATE KEY",
      "ATTRIBUTE CERTIFICATE",
      "PUBLIC KEY",
      "RSA PRIVATE KEY",
      "EC PRIVATE KEY",
      "",
    ],
  )
}

test "the labels RFC 7468 names are distinct from the ones that resemble them" {
  assert_eq(label_of("X509 CRL"), Crl);
  assert_eq(label_of("X509 CERTIFICATE"), Other("X509 CERTIFICATE"));
  assert_eq(label_of("NEW CERTIFICATE REQUEST"), Other("NEW CERTIFICATE REQUEST"));
  assert_eq(label_of("certificate"), Other("certificate"));
  assert(label_of("CRL") != Crl)
}

test "labels with the same text are equal, however each was built" {
  assert(Other("CERTIFICATE") == Certificate);
  assert(Other("PRIVATE KEY") == PrivateKey);
  assert(Other("PUBLIC KEY") != PrivateKey);
  assert_eq(#{Certificate: 1, PublicKey: 2}.get(Other("PUBLIC KEY")), Some(2));
  assert_eq(f"{Crl} and {Other("OPENSSH PRIVATE KEY")}", "X509 CRL and OPENSSH PRIVATE KEY")
}

test "`is_private` is true for any label ending in PRIVATE KEY except ENCRYPTED PRIVATE KEY" {
  assert_eq(labels.filter(is_private), [PrivateKey, RsaPrivateKey, EcPrivateKey]);
  assert(is_private(Other("OPENSSH PRIVATE KEY")));
  assert(is_private(Other("PRIVATE KEY")));
  assert(!is_private(Other("ENCRYPTED PRIVATE KEY")))
}

fn expected_foobar_certificate() -> Result<List<Item>, Error> =
  Ok([Open({ label: Certificate, headers: [], data: b"foobar" })])

test "a reader accepts any line length, any line ending, and blanks at a line's end" {
  assert_eq(
    decode("-----BEGIN CERTIFICATE-----\nZm9vYmFy\n-----END CERTIFICATE-----\n", 4096),
    expected_foobar_certificate(),
  );
  assert_eq(
    decode("-----BEGIN CERTIFICATE-----\nZm9vYmFy\n-----END CERTIFICATE-----", 4096),
    expected_foobar_certificate(),
  );
  assert_eq(
    decode("-----BEGIN CERTIFICATE-----\r\nZm9v\r\nYmFy\r\n-----END CERTIFICATE-----\r\n", 4096),
    expected_foobar_certificate(),
  );
  assert_eq(
    decode("-----BEGIN CERTIFICATE-----\rZm9vYmFy\r-----END CERTIFICATE-----\r", 4096),
    expected_foobar_certificate(),
  );
  assert_eq(
    decode(
      "-----BEGIN CERTIFICATE----- \t\n\n \nZ\nm9vYm \nFy\t\n-----END CERTIFICATE-----  \n",
      4096,
    ),
    expected_foobar_certificate(),
  )
}

test "padding may be on a line of its own, and a block may contain no bytes" {
  assert_eq(
    decode("-----BEGIN CERTIFICATE-----\nZm9vYg=\n=\n-----END CERTIFICATE-----\n", 4096),
    Ok([Open({ label: Certificate, headers: [], data: b"foob" })]),
  );
  assert_eq(
    decode("-----BEGIN CERTIFICATE-----\n-----END CERTIFICATE-----\n", 4096),
    Ok([Open({ label: Certificate, headers: [], data: b"" })]),
  );
  assert_eq(
    write({ label: Certificate, headers: [], data: b"" }),
    "-----BEGIN CERTIFICATE-----\n-----END CERTIFICATE-----\n",
  );
  assert_eq(decode("", 4096), Ok([]));
  assert_eq(decode("no block here\n", 4096), Ok([]))
}

test "a bundle is every block in order, whatever is written between them" {
  let bundle =
    \\# the leaf
    \\-----BEGIN CERTIFICATE-----
    \\Zm9v
    \\-----END CERTIFICATE-----
    \\
    \\subject: the issuer, whose line holds a colon
    \\ -----BEGIN CERTIFICATE----- an indented line is text too
    \\-----BEGIN X509 CRL-----
    \\YmFy
    \\-----END X509 CRL-----
    \\# and its key
    \\-----BEGIN EC PRIVATE KEY-----
    \\Zm9vYmFy
    \\-----END EC PRIVATE KEY-----
    \\trailing words
  ;
  match decode(bundle, 4096) {
    Ok([Open(leaf), Open(crl), Sealed(k)]) -> {
      assert_eq(leaf, { label: Certificate, headers: [], data: b"foo" });
      assert_eq(crl, { label: Crl, headers: [], data: b"bar" });
      assert_eq(k.label, EcPrivateKey);
      assert(k.cache_key == Secret::of_bytes(b"foobar"));
      assert(k.cache_key != Secret::of_bytes(b"foobaz"));
      assert_eq(k.cache_key.len(), 6)
    },
    other -> assert_eq(result_len(other), 3),
  }
}

fn result_len(r: Result<List<Item>, Error>) -> Int =
  match r { Ok(items) -> items.len(), Err(_) -> -1 }

test "`decode` returns a private key as `Sealed(seal(block))`, and equal sealed keys compare equal" {
  let block: Block = { label: PrivateKey, headers: [], data: b"foobar" };
  assert(decode(write(block), 4096) == Ok([Sealed(seal(block))]));
  assert(seal(block) == seal(block));
  assert(seal(block) != seal({ label: PrivateKey, headers: [], data: b"foobaz" }));
  assert(item(block) == Sealed(seal(block)));
  assert(
    item({ label: EncryptedPrivateKey, headers: [], data: b"foobar" })
      == Open({ label: EncryptedPrivateKey, headers: [], data: b"foobar" }),
  )
}

test "`write` wraps data at 64 columns and puts headers before the data, followed by an empty line" {
  assert_eq(
    write({ label: PublicKey, headers: [], data: b"\x00".repeat(49) }),
    \\-----BEGIN PUBLIC KEY-----
    \\AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    \\AA==
    \\-----END PUBLIC KEY-----
    \\
  );
  let headed: Block = {
    label: Other("MESSAGE"),
    headers: [{ name: "Comment", value: "a b: c" }, { name: "Empty", value: "" }],
    data: b"foo",
  };
  let text = "-----BEGIN MESSAGE-----\nComment: a b: c\nEmpty: \n\nZm9v\n-----END MESSAGE-----\n";
  assert_eq(write(headed), text);
  assert_eq(decode(text, 4096), Ok([Open(headed)]));
  assert_eq(
    decode(
      "-----BEGIN MESSAGE-----\nComment:a b: c  \nEmpty:\n\nZm9v\n-----END MESSAGE-----",
      4096,
    ),
    Ok([Open(headed)]),
  );
  assert_eq(
    decode(
      "-----BEGIN -----\nN: v\nProc-Type: 4,MIC-ONLY\n!~: ENCRYPTED\n\nZm9v\n-----END -----\n",
      4096,
    ),
    Ok([
      Open({
        label: Other(""),
        headers: [
          { name: "N", value: "v" },
          { name: "Proc-Type", value: "4,MIC-ONLY" },
          { name: "!~", value: "ENCRYPTED" },
        ],
        data: b"foo",
      }),
    ]),
  )
}

type Rejected = { name: String, text: String, line: Int, reason: ErrorKind }

const rejected: List<Rejected> =
  [
    {
      name: "an END label that is not the BEGIN's",
      text: "-----BEGIN A-----\nAAAA\n-----END B-----\n",
      line: 3,
      reason: Mismatched,
    },
    {
      name: "a block the text ends inside",
      text: "x\n-----BEGIN A-----\nAAAA\n",
      line: 2,
      reason: Unclosed,
    },
    {
      name: "a block opened inside another",
      text: "-----BEGIN A-----\nAAAA\n-----BEGIN A-----\nAAAA\n-----END A-----\n",
      line: 1,
      reason: Unclosed,
    },
    { name: "an END with no block open", text: "-----END A-----\n", line: 1, reason: Unopened },
    { name: "an END that is no boundary", text: "-----END A----\n", line: 1, reason: BadBoundary },
    {
      name: "an END, outside any block, whose label opens with a hyphen",
      text: "-----END -A-----\n",
      line: 1,
      reason: BadBoundary,
    },
    {
      name: "four hyphens after a label",
      text: "-----BEGIN A----\nAAAA\n-----END A-----\n",
      line: 1,
      reason: BadBoundary,
    },
    { name: "words after a boundary", text: "-----BEGIN A----- x\n", line: 1, reason: BadBoundary },
    {
      name: "a label ending in a space",
      text: "-----BEGIN A -----\n",
      line: 1,
      reason: BadBoundary,
    },
    {
      name: "a label with two spaces together",
      text: "x\n-----BEGIN A  B-----\n",
      line: 2,
      reason: BadBoundary,
    },
    {
      name: "a label with a hyphen beside a space",
      text: "-----BEGIN A- B-----\n",
      line: 1,
      reason: BadBoundary,
    },
    {
      name: "a character that is not base64",
      text: "-----BEGIN A-----\nAA*A\n-----END A-----\n",
      line: 2,
      reason: BadData,
    },
    {
      name: "a blank inside a data line",
      text: "-----BEGIN A-----\nAA AA\n-----END A-----\n",
      line: 2,
      reason: BadData,
    },
    {
      name: "a blank before a data line",
      text: "-----BEGIN A-----\n AAAA\n-----END A-----\n",
      line: 2,
      reason: BadData,
    },
    {
      name: "an empty line between data lines",
      text: "-----BEGIN A-----\nAAAA\n\nAAAA\n-----END A-----\n",
      line: 3,
      reason: BadData,
    },
    {
      name: "padding that opens a line before the last",
      text: "-----BEGIN A-----\nAAAA\n=AAA\nAAAA\n-----END A-----\n",
      line: 3,
      reason: NotCanonical,
    },
    {
      name: "a header with no name",
      text: "-----BEGIN A-----\n: v\n\nAAAA\n-----END A-----\n",
      line: 2,
      reason: BadHeader,
    },
    {
      name: "a header led by a blank",
      text: "-----BEGIN A-----\n Name: v\n\nAAAA\n-----END A-----\n",
      line: 2,
      reason: BadHeader,
    },
    {
      name: "padding before the data's end",
      text: "-----BEGIN A-----\nAAAA\nAA==\nAAAA\n-----END A-----\n",
      line: 3,
      reason: NotCanonical,
    },
    {
      name: "a last letter with bits no byte holds",
      text: "-----BEGIN A-----\nAAAA\nAAAA\nAB==\n-----END A-----\n",
      line: 4,
      reason: NotCanonical,
    },
    {
      name: "data short of a group",
      text: "-----BEGIN A-----\nAAAA\nAAA\n-----END A-----\n",
      line: 3,
      reason: NotCanonical,
    },
    {
      name: "a line among the headers that is none",
      text: "-----BEGIN A-----\nName: v\nAAAA\n\nAAAA\n-----END A-----\n",
      line: 3,
      reason: BadHeader,
    },
    {
      name: "a header with a space in its name",
      text: "-----BEGIN A-----\nNa me: v\n\nAAAA\n-----END A-----\n",
      line: 2,
      reason: BadHeader,
    },
    {
      name: "headers with no empty line after them",
      text: "-----BEGIN A-----\nName: v\n-----END A-----\n",
      line: 3,
      reason: BadHeader,
    },
    {
      name: "a header after the empty line",
      text: "-----BEGIN A-----\n\nName: v\n\nAAAA\n-----END A-----\n",
      line: 3,
      reason: BadData,
    },
    {
      name: "a key encrypted the legacy way",
      line: 2,
      reason: Encrypted,
      text:
        \\-----BEGIN RSA PRIVATE KEY-----
        \\Proc-Type: 4,ENCRYPTED
        \\DEK-Info: AES-128-CBC,00
        \\
        \\AAAA
        \\-----END RSA PRIVATE KEY-----
        \\
    },
  ]

test "`decode` fails on the malformed PEM text {c.name} with the expected line and reason" for c: Rejected in rejected {
  assert_eq(decode(c.text, 4096), Err({ line: c.line, reason: c.reason }));
  assert(explain(c.reason).len() > 0)
}

test "a text past the limit is rejected unread, and one at the limit is read" {
  let text = "-----BEGIN A-----\nAAAA\n-----END A-----\n";
  assert_eq(decode(text, text.len() - 1), Err({ line: 1, reason: TooLong }));
  assert_eq(
    decode(text, text.len()),
    Ok([Open({ label: Other("A"), headers: [], data: b"\x00\x00\x00" })]),
  )
}

test "the error for legacy encryption explains what to do instead" {
  assert(explain(Encrypted).contains("MD5"));
  assert(explain(Encrypted).contains("ENCRYPTED PRIVATE KEY"))
}

test "a block no reader here would read back is not written" {
  let bytes = b"foo";
  let labelled = |text: String| encode({ label: Other(text), headers: [], data: bytes });
  let headed = |name: String, value: String|
    encode({
      label: Certificate,
      headers: [{ name: "Ok", value: "v" }, { name: name, value: value }],
      data: bytes,
    });
  assert_eq(
    ["A--B", "A\nB", " A", "A-", "A\u{7f}B", "Ä"].map(labelled),
    range(0, 6).map(|_: Int| Err({ line: 1, reason: BadLabel })),
  );
  assert_eq(labelled("A~ B-C"), Ok("-----BEGIN A~ B-C-----\nZm9v\n-----END A~ B-C-----\n"));
  assert_eq(labelled("A B"), Ok("-----BEGIN A B-----\nZm9v\n-----END A B-----\n"));
  assert_eq(
    ["No:colon", "No space", "", "N\u{7f}", "Né"].map(|name: String| headed(name, "v")),
    range(0, 5).map(|_: Int| Err({ line: 3, reason: BadHeader })),
  );
  assert_eq(
    ["two\nlines", " led", "trailed ", "a\tb", "a\u{7f}b"].map(|value: String|
      headed("Name", value)),
    range(0, 5).map(|_: Int| Err({ line: 3, reason: BadHeader })),
  );
  assert_eq(headed("Proc-Type", "4,ENCRYPTED"), Err({ line: 3, reason: Encrypted }));
  assert_eq(
    headed("!~", "é ~"),
    Ok("-----BEGIN CERTIFICATE-----\nOk: v\n!~: é ~\n\nZm9v\n-----END CERTIFICATE-----\n"),
  );
  assert_eq(
    encode({ label: Other(""), headers: [], data: bytes }),
    Ok("-----BEGIN -----\nZm9v\n-----END -----\n"),
  )
}

