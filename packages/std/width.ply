//! How many columns a text takes in a terminal or any other grid of fixed cells.
//!
//! A character is zero, one or two columns wide. East Asian wide and fullwidth characters take
//! two, and most emoji are among them. A character that is not drawn in a cell of its own takes
//! none: a combining mark, a control, a format character, the conjoining Hangul vowels and
//! trailing consonants, and what the database calls default-ignorable. The rest take one. A
//! character the database calls ambiguous, such as a Greek or Cyrillic letter or a box-drawing
//! line, is one column in most terminals and two in those set up for East Asian text. So every
//! function takes that choice as an argument, and none reads it from the environment.
//!
//! A text is measured by its grapheme clusters, since what is drawn as one character takes the
//! cells of one. A cluster is as wide as its characters together, with three exceptions for emoji.
//! A character joined to the one before it by `U+200D`, and an emoji modifier after its base, add
//! nothing. `U+FE0F` makes an emoji that is otherwise drawn as text two columns wide, a keycap's
//! digit among them. `U+FE0E` makes an emoji that is otherwise drawn as an emoji one column wide.
//! So a family of four joined emoji and a flag are two columns each, and a Hangul syllable written
//! as its letters takes the two columns of its first letter. Terminals do not all agree on this. A
//! terminal that draws a joined emoji as its parts takes more columns than these functions return.
//!
//! A control character and a line break count for nothing. To measure a text of several lines,
//! split it and measure each line. The table is `std.ucd`'s, for the Unicode version it names.

import std.char (sample_text)
import std.laws (agrees)
import std.segment
import std.ucd
import std.ucd (Table)
import std.gen

/// How wide a character of ambiguous width counts.
pub type AmbiguousWidth =
  /// One column, as terminals draw them unless set up for East Asian text.
  | Narrow
  /// Two columns, as a terminal with an East Asian legacy font draws them.
  | Wide

const emoji_mask: Int = 4

const emoji_presentation_mask: Int = 8

const modifier_mask: Int = 16

fn width_table_entry(fields: List<Bytes>) -> Int / {abort.raise} = {
  let field = |i: Int| match fields.at(i) { Some(text) -> text, None -> b"" };
  let columns = match field(0) {
    b"" -> 0,
    b"0" -> 1,
    b"2" -> 2,
    b"A" -> 3,
    _ ->
      panic(
        "the columns field of `ucd/width.txt` must be empty, `0` (no columns), `2` (two columns) or `A` (ambiguous)",
      ),
  };
  range(0, field(1).len()).fold(columns, |bits: Int, i: Int|
    bits
      | (match field(1).at(i) {
        b'e' -> emoji_mask,
        b'p' -> emoji_presentation_mask,
        b'm' -> modifier_mask,
        _ ->
          panic(
            "a flag in the flags field of `ucd/width.txt` must be `e` (emoji), `p` (emoji presentation) or `m` (modifier)",
          ),
      }))
}

const widths: Table = ucd::table(embed("ucd/width.txt"), 0, width_table_entry)

fn columns_of(word: Int, ambiguous: AmbiguousWidth) -> Int =
  match word & 3 { 0 -> 1, 1 -> 0, 2 -> 2, _ -> if ambiguous == Wide { 2 } else { 1 } }

/// Returns the columns `c` takes when measured alone: zero, one or two. Summing these over a text
/// overcounts, because a joined emoji counts as its separate parts and a modifier counts as its own
/// character instead of joining its base. Use `columns` to measure a text.
pub fn char_columns(c: Char, ambiguous: AmbiguousWidth = Narrow) -> Int =
  if c >= ' ' && c <= '~' { 1 } else { columns_of(ucd::lookup(widths, Int::of_char(c)), ambiguous) }

type ClusterState = { total: Int, last: Int, counted: Int, joined: Bool }

const empty_cluster: ClusterState = { total: 0, last: 0, counted: 0, joined: false }

fn add_code_point(
  width_table: Table,
  so_far: ClusterState,
  code_point: Int,
  first: Bool,
  ambiguous: AmbiguousWidth,
) -> ClusterState =
  if code_point == 0xFE0F && so_far.last & emoji_mask != 0 && so_far.counted < 2 {
    { total: so_far.total + 2 - so_far.counted, last: so_far.last, counted: 2, joined: false }
  } else if code_point == 0xFE0E && so_far.last & emoji_presentation_mask != 0
      && so_far.counted == 2 {
    { total: so_far.total - 1, last: so_far.last, counted: 1, joined: false }
  } else {
    let word = ucd::lookup(width_table, code_point);
    let own = if !first && (so_far.joined || word & modifier_mask != 0) { 0 }
    else { columns_of(word, ambiguous) };
    { total: so_far.total + own, last: word, counted: own, joined: code_point == 0x200D }
  }

/// Returns the columns `cluster` takes as one grapheme cluster, whatever it contains. This is the
/// sum of its characters' columns, except that modifiers and characters after a joiner add no
/// columns, a variation selector `U+FE0F` widens a preceding emoji to two columns, and `U+FE0E`
/// narrows it to one.
pub fn cluster_columns(cluster: String, ambiguous: AmbiguousWidth = Narrow) -> Int = {
  let width_table = widths;
  cluster.chars().fold(
    { so_far: empty_cluster, first: true },
    |m: { so_far: ClusterState, first: Bool }, c: Char|
      {
        so_far: add_code_point(width_table, m.so_far, Int::of_char(c), m.first, ambiguous),
        first: false,
      },
  ).so_far.total
}

fn is_plain(text: String) -> Bool =
  text.len() == Bytes::of_string(text).len()
    && text.chars().fold(true, |plain: Bool, c: Char| plain && c >= ' ' && c <= '~')

type TextState = { total: Int, cluster: ClusterState, place: Int, boundaries: List<Int> }

fn add_char(width_table: Table, walk: TextState, c: Char, ambiguous: AmbiguousWidth) -> TextState =
  match walk.boundaries {
    [next, ..rest] -> if next == walk.place {
      {
        total: walk.total + walk.cluster.total,
        cluster: add_code_point(width_table, empty_cluster, Int::of_char(c), true, ambiguous),
        place: walk.place + 1,
        boundaries: rest,
      }
    } else {
      {
        total: walk.total,
        cluster: add_code_point(width_table, walk.cluster, Int::of_char(c), false, ambiguous),
        place: walk.place + 1,
        boundaries: walk.boundaries,
      }
    },
    [] -> walk,
  }

/// The columns `text` takes on one line: the sum of its grapheme clusters', each measured as
/// `cluster_columns` measures one.
pub fn columns(text: String, ambiguous: AmbiguousWidth = Narrow) -> Int =
  if is_plain(text) { text.len() } else {
    let width_table = widths;
    let done = text.chars().fold(
      {
        total: 0,
        cluster: empty_cluster,
        place: 0,
        boundaries: segment::grapheme_boundaries(text),
      },
      |walk: TextState, c: Char| add_char(width_table, walk, c, ambiguous),
    );
    done.total + done.cluster.total
  }

/// The longest prefix of `text`, cut between grapheme clusters, that takes at most `max_columns`
/// columns. It fits a cell of that width without splitting an emoji or a letter from its accent.
/// Zero-width clusters that follow the prefix are included.
pub fn truncate(text: String, max_columns: Int, ambiguous: AmbiguousWidth = Narrow) -> String =
  segment::graphemes(text).fold(
    { retained: "", left: max_columns, open: true },
    |so_far: { retained: String, left: Int, open: Bool }, cluster: String| {
      let wide = cluster_columns(cluster, ambiguous);
      if so_far.open && wide <= so_far.left {
        { retained: so_far.retained ++ cluster, left: so_far.left - wide, open: true }
      } else { { retained: so_far.retained, left: so_far.left, open: false } }
    },
  ).retained

test "a random text's columns are the sum of its clusters' columns" {
  gen::check(gen::any_int(), |x: Int|
    agrees(
      |seed: Int| columns(sample_text(seed)),
      |seed: Int|
        segment::graphemes(sample_text(seed)).fold(0, |sum: Int, cluster: String|
          sum + cluster_columns(cluster)),
      x,
    ))
}

test "a truncated text is a prefix that fits in the given columns" {
  gen::check2(gen::any_int(), gen::any_int(), |seed: Int, max_columns: Int| {
    let text = sample_text(seed);
    let prefix = truncate(text, max_columns & 31);
    text.starts_with(prefix) && columns(prefix) <= max_columns & 31
      && (prefix != text || columns(text) <= max_columns & 31)
  })
}

type WidthCase = { text: String, columns: Int }

const measures: List<WidthCase> =
  [
    { text: "", columns: 0 },
    { text: "plain", columns: 5 },
    { text: "e\u{301}", columns: 1 },
    { text: "\u{4E2D}\u{6587}", columns: 4 },
    { text: "\u{FF21}\u{FF11}", columns: 4 },
    { text: "\u{FF76}", columns: 1 },
    { text: "\u{AC00}", columns: 2 },
    { text: "\u{1100}\u{1161}\u{11A8}", columns: 2 },
    { text: "\u{1F600}", columns: 2 },
    { text: "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}", columns: 2 },
    { text: "\u{1F44D}\u{1F3FD}", columns: 2 },
    { text: "\u{1F3FD}", columns: 2 },
    { text: "\u{1F1E9}\u{1F1EA}", columns: 2 },
    { text: "\u{1F1E9}", columns: 1 },
    { text: "\u{2764}", columns: 1 },
    { text: "\u{2764}\u{FE0F}", columns: 2 },
    { text: "1\u{FE0F}\u{20E3}", columns: 2 },
    { text: "1\u{20E3}", columns: 1 },
    { text: "\u{231A}", columns: 2 },
    { text: "\u{231A}\u{FE0E}", columns: 1 },
    { text: "a\u{FE0F}", columns: 1 },
    { text: "\u{1F3F3}\u{FE0F}\u{200D}\u{1F308}", columns: 2 },
    { text: "\u{915}\u{94D}\u{937}\u{93F}", columns: 3 },
    { text: "a\u{200B}b", columns: 2 },
    { text: "a\tb\n", columns: 2 },
    { text: "\u{AD}", columns: 1 },
    { text: "\u{301}", columns: 0 },
    { text: "\u{600}1", columns: 2 },
    { text: "a\u{4E2D}b\u{1F600}!", columns: 7 },
  ]

test "the text of {c.text.chars().map(Int::of_char)} takes {c.columns} columns" for c: WidthCase in measures {
  assert_eq(columns(c.text), c.columns)
}

test "an ambiguous character is one column or two, as the caller chooses" {
  assert_eq(columns("\u{3B1}\u{2500}\u{A1}"), 3);
  assert_eq(columns("\u{3B1}\u{2500}\u{A1}", Wide), 6);
  assert_eq(columns("\u{3B1}\u{2500}\u{A1}", Narrow), 3);
  assert_eq(char_columns('\u{3B1}', Wide), 2);
  assert_eq(char_columns('\u{3B1}'), 1);
  assert_eq(columns("a\u{4E2D}", Wide), 3);
  assert_eq(cluster_columns("\u{AD}", Wide), 2)
}

test "a character alone takes none, one or two columns" {
  assert_eq(
    [
      'a',
      ' ',
      '~',
      '\u{E9}',
      '\u{4E2D}',
      '\u{1F600}',
      '\u{301}',
      '\0',
      '\n',
      '\u{7F}',
      '\u{200D}',
      '\u{1F3FD}',
    ].map(|c: Char| char_columns(c)),
    [1, 1, 1, 1, 2, 2, 0, 0, 0, 0, 0, 2],
  )
}

test "`truncate` cuts only between whole grapheme clusters, and zero-width marks stay with the character before them" {
  assert_eq(truncate("a\u{4E2D}b", 3), "a\u{4E2D}");
  assert_eq(truncate("a\u{4E2D}b", 2), "a");
  assert_eq(truncate("\u{4E2D}", 1), "");
  assert_eq(truncate("e\u{301}\u{301}x", 1), "e\u{301}\u{301}");
  assert_eq(
    truncate("\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}ab", 3),
    "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}a",
  );
  assert_eq(truncate("ab\u{200B}c", 2), "ab\u{200B}");
  assert_eq(truncate("abc", 0), "");
  assert_eq(truncate("abc", -1), "");
  assert_eq(truncate("abc", 10), "abc")
}

test "each listed text's columns are the sum of its clusters' columns" {
  let texts = measures.map(|m: WidthCase| m.text);
  assert_eq(
    texts.filter(|text: String|
      columns(text)
        != segment::graphemes(text).fold(0, |sum: Int, cluster: String|
          sum + cluster_columns(cluster))),
    [],
  )
}
