//! Checks `strftime"..."` literals, such as `strftime"%Y-%m-%d"`, as `std.date` patterns when the
//! program is checked.
//!
//! A literal's tag is the name of the module that checks it, so this module checks the text of each
//! `strftime` literal with `std.date`'s `pattern`. A directive that `std.date` does not support is
//! a check error at the literal, not wrong text at run time. The pattern type, its directives (`ply
//! doc std.date.pattern`) and the functions that format and parse with a pattern are in `std.date`.

import std.date (Pattern, Error, format_date, of, pattern)

/// Checks a `strftime"..."` literal. Returns the pattern that `std.date`'s `pattern` parses, or an
/// error with the offset of the `%` where the text stops being a pattern.
pub fn literal(text: String) -> Result<Pattern, Error> = pattern(text)

test "`literal` returns a pattern for a valid date format string, and an error naming the first directive that does not exist" {
  let written = match ((literal("%d %b %Y"), of(2026, 10, 4))) {
    (Ok(p), Some(d)) -> format_date(p, d),
    _ -> None,
  };
  assert_eq(written, Some("04 Oct 2026"));
  assert_eq(literal("%d %Q"), Err({ message: "`%Q` is not a directive", offset: 3 }))
}
