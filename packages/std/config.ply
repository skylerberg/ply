//! Configuration as an effect, read once at start-up.
//!
//! A key's value comes from the first of these sources that supplies it: the command line, then
//! `--config` files, then the environment.
//!
//! Each operation names a label in brackets, as in `config.read[credentials]`. The label is a name
//! you choose to group the keys a part of the program reads. Describe keys with `spec`, `required`,
//! `optional` and `with_default`, and pass the `ConfigSpec` with `--config-schema`. A key the
//! schema declares secret is readable only through `config.secret`; without a schema no key is
//! secret. Every supplied value is checked against its shape before the program starts reading
//! configuration. A run with no configuration returns `None` for every key. A test handles the
//! effect with `get_value` and `get_secret` over a `Values`.

import std.internal.native (native, found)

/// The run's configuration, under a namespace label.
pub nondet effect config {
  /// A plain key's value; `None` when no source supplies it.
  read get[k](key: String) -> Option<String>
  /// A secret key's value, which only this operation reads.
  read secret[k](key: String) -> Option<Secret<String>>
}

/// A key's type, which the run checks a resolved value against. An `SInt` is what
/// `std.string.int_of_string` reads, an `SBool` is `true` or `false`, and an `SSecret` is not
/// empty.
pub type Shape = | SText | SInt | SBool | SSecret

/// A key in the schema. Every other source overrides `default`: the command line, then `--config`
/// files, then the environment.
pub type Key = { name: String, shape: Shape, required: Bool, default: Option<String> }

/// The keys a program reads, which `--config-schema` takes.
pub type ConfigSpec = { keys: List<Key> }

/// A schema of these keys.
pub fn spec(keys: List<Key>) -> ConfigSpec = { keys: keys }

/// A key a run may not start without.
pub fn required(name: String, shape: Shape) -> Key =
  { name: name, shape: shape, required: true, default: None }

/// A key whose absence is a `None` the program matches on.
pub fn optional(name: String, shape: Shape) -> Key =
  { name: name, shape: shape, required: false, default: None }

/// A key with a default value, used when no other source supplies one.
pub fn with_default(name: String, shape: Shape, value: String) -> Key =
  { name: name, shape: shape, required: false, default: Some(value) }

/// The values a test gives `config.get` and `config.secret`.
pub type Values = { plain: Map<String, String>, secret: Map<String, String> }

/// Returns a `Values` built from a list of plain entries and a list of secret entries, for a test's
/// handler.
pub fn values(
  plain: List<{ key: String, value: String }>,
  secret: List<{ key: String, value: String }>,
) -> Values = { plain: Map::of_entries(plain), secret: Map::of_entries(secret) }

/// No value for any key.
pub const no_values: Values = { plain: Map::new(), secret: Map::new() }

/// Returns the plain value of `key` in the test's `Values` `v`, as `config.get` would.
pub fn get_value(v: Values, key: String) -> Option<String> = v.plain.get(key)

/// Returns the secret value of `key` in the test's `Values` `v` as a `Secret`, as `config.secret`
/// would.
pub fn get_secret(v: Values, key: String) -> Option<Secret<String>> = {
  let text = v.secret.get(key)?;
  Some(Secret::of_string(text))
}

/// Returns a `Values` whose only entry is the secret `key` with `value`. A test secret is written
/// in the source, which is safe because it is not a real credential.
pub fn one_secret(key: String, value: String) -> Values = values([], [{ key: key, value: value }])

/// A single plain value.
pub fn one_value(key: String, value: String) -> Values = values([{ key: key, value: value }], [])

host for config by host_handler

fn host_handler<a | e>(go: () -> a / {config.read[*] | e}) -> a / {native.read | e} =
  handle {
    go()
  } with {
    config.get[*](key) -> match found(config_get(key)) {
      Some(value) -> Some(String::of_bytes_lossy(value)),
      None -> None,
    },
    config.secret[*](key) -> if config_secret_held(key) { Some(config_secret(key)) } else { None },
  }

extern fn config_get(key: String) -> Bytes / {native.read}

extern fn config_secret_held(key: String) -> Bool / {native.read}

extern fn config_secret(key: String) -> Secret<String> / {native.read}

test "a config read under a `handle` block returns the fixture's values and touches no real configuration" {
  let fixture = values([{ key: "SERVICE_REGION", value: "eu" }], []);
  handle {
    assert_eq(config.get[server]("SERVICE_REGION"), Some("eu"));
    assert_eq(config.get[server]("SERVICE_ABSENT"), None)
  } with {
    config.get[server](k) -> get_value(fixture, k),
  }
}

test "the fake never returns a secret through get, or a plain value through secret" {
  let fixture = values([{ key: "SERVICE_REGION", value: "eu" }], [
    { key: "SERVICE_API_KEY", value: "fixture-key" },
  ]);
  assert_eq(get_value(fixture, "SERVICE_API_KEY"), None);
  assert_eq(get_secret(fixture, "SERVICE_REGION"), None);
  assert_eq(get_value(fixture, "SERVICE_REGION"), Some("eu"))
}

test "a secret arrives as a Secret rather than a String" {
  let fixture = one_secret("SERVICE_API_KEY", "fixture-key");
  handle {
    match config.secret[credentials]("SERVICE_API_KEY") {
      None -> panic("the fixture supplies this key"),
      Some(key) -> {
        assert(key.verify("fixture-key"));
        assert(!key.verify("fixture-ke"));
        assert(!key.is_empty())
      },
    }
  } with {
    config.secret[credentials](k) -> get_secret(fixture, k),
  }
}

test "no_values returns nothing rather than failing" {
  assert_eq(get_value(no_values, "SERVICE_PORT"), None);
  assert_eq(get_secret(no_values, "SERVICE_API_KEY"), None)
}

test "a config spec is plain data whose keys, requirements and defaults can be read before any values are loaded" {
  let s = spec([
    required("SERVICE_PORT", SInt),
    required("SERVICE_API_KEY", SSecret),
    with_default("SERVICE_REGION", SText, "eu"),
    optional("SERVICE_DEBUG", SBool),
  ]);
  assert_eq(s.keys.len(), 4);
  assert_eq(required("SERVICE_PORT", SInt).default, None);
  assert_eq(with_default("SERVICE_REGION", SText, "eu").required, false);
  assert_eq(with_default("SERVICE_REGION", SText, "eu").default, Some("eu"))
}

test/nondet "every namespace reads the run's configuration, and a key no source supplies is None" {
  assert_eq(config.get[server]("PATH"), config.get[credentials]("PATH"));
  assert_eq(config.get[server]("PLY_NOTHING_SUPPLIES_THIS_KEY"), None);
  assert_eq(config.secret[credentials]("PLY_NOTHING_SUPPLIES_THIS_KEY"), None)
}
