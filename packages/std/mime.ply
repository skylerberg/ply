type Written = { text: String, canonical: String }

const valid_media_types: List<Written> =
  [
    { text: "text/html;charset=utf-8", canonical: "text/html; charset=utf-8" },
    { text: "Text/HTML;Charset=\"utf-8\"", canonical: "text/html; charset=utf-8" },
    { text: "text/html; charset=\"utf-8\"", canonical: "text/html; charset=utf-8" },
    { text: "text/html;charset=UTF-8", canonical: "text/html; charset=UTF-8" },
    {
      text: "multipart/mixed; boundary=gc0p4Jq0M2Yt08j34c0p",
      canonical: "multipart/mixed; boundary=gc0p4Jq0M2Yt08j34c0p",
    },
    {
      text: "multipart/mixed; boundary=\"gc0pJq0M:08jU534c0p\"",
      canonical: "multipart/mixed; boundary=\"gc0pJq0M:08jU534c0p\"",
    },
    {
      text: "multipart/mixed; boundary=\"simple boundary\"",
      canonical: "multipart/mixed; boundary=\"simple boundary\"",
    },
    { text: "text/plain", canonical: "text/plain" },
    { text: " \ttext/plain \t", canonical: "text/plain" },
    { text: "APPLICATION/LD+JSON", canonical: "application/ld+json" },
    { text: "*/*", canonical: "*/*" },
    { text: "text/*;q=0.5", canonical: "text/*; q=0.5" },
    { text: "text/html;;charset=utf-8 ; ", canonical: "text/html; charset=utf-8" },
    { text: "text/plain; title=\"\"", canonical: "text/plain; title=\"\"" },
    {
      text: "text/plain; title=\"a \\\"b\\\" \\\\ \\c\"",
      canonical: "text/plain; title=\"a \\\"b\\\" \\\\ c\"",
    },
    {
      text: "text/plain; name=\"na\u{ef}ve.txt\"",
      canonical: "text/plain; name=\"na\u{ef}ve.txt\"",
    },
    {
      text: "text/plain; format=flowed; DelSp=yes",
      canonical: "text/plain; format=flowed; delsp=yes",
    },
  ]

test "`parse` accepts the media type {show(c.text)}, `render` writes it in canonical form, and parsing that form gives the same value" for c: Written in valid_media_types {
  assert_eq(match parse(c.text) { Ok(m) -> Some(render(m)), Err(_) -> None }, Some(c.canonical));
  assert_eq(parse(c.canonical), parse(c.text))
}

type Rejected = { text: String, at: Int, reason: ErrorKind }

const unreadable: List<Rejected> =
  [
    { text: "", at: 0, reason: NoToken },
    { text: "/html", at: 0, reason: NoToken },
    { text: "text", at: 4, reason: NoSlash },
    { text: "text html", at: 4, reason: NoSlash },
    { text: "text/", at: 5, reason: NoToken },
    { text: "text/ html", at: 5, reason: NoToken },
    { text: "text/html charset=utf-8", at: 10, reason: Trailing },
    { text: "text/html, text/plain", at: 9, reason: Trailing },
    { text: "multipart/mixed; boundary=gc0pJq0M:08jU534c0p", at: 34, reason: Trailing },
    { text: "text/html; charset", at: 18, reason: NoEquals },
    { text: "text/html; charset =utf-8", at: 18, reason: NoEquals },
    { text: "text/html; charset= utf-8", at: 19, reason: NoToken },
    { text: "text/html; charset=", at: 19, reason: NoToken },
    { text: "text/html; =utf-8", at: 11, reason: Trailing },
    { text: "text/html; charset=\"utf-8", at: 25, reason: Unclosed },
    { text: "text/html; a=\"x\\", at: 16, reason: Unclosed },
    { text: "text/html; a=\"x\\\"", at: 17, reason: Unclosed },
    { text: "text/html; a=\"x\u{7f}y\"", at: 15, reason: Control },
    { text: "text/html; a=\"x\\\u{7f}y\"", at: 16, reason: Control },
    { text: "text/html; a=1; b=2; A=3", at: 21, reason: Repeated("a") },
    { text: "text/html; a=\"x\"y", at: 16, reason: Trailing },
  ]

test "`parse` fails on {show(c.text)} with the expected character offset and reason" for c: Rejected in unreadable {
  assert_eq(parse(c.text), Err({ at: c.at, reason: c.reason }))
}

test "`read` and `read_list` raise the same error that `parse` and `parse_list` return" {
  assert_eq(try { read("text") }, Err({ at: 4, reason: NoSlash }));
  assert_eq(try { read_list("text/html, text") }, Err({ at: 15, reason: NoSlash }))
}

test "a quoted string may contain a space or tab after a backslash, but a NUL character is rejected" {
  assert_eq(parse("text/plain; t=\"a\\ b\\\tc\""), parse("text/plain; t=\"a b\tc\""));
  assert_eq(parse("text/html; a=\"x\0y\""), Err({ at: 15, reason: Control }));
  assert_eq(parse("text/html; a=\"x\\\0y\""), Err({ at: 16, reason: Control }))
}

test "`read_params` parses the parameters after the first token of a header value the same way as a media type's parameters" {
  assert_eq(
    try { read_params("attachment; filename=\"a b.txt\"; Size=12 ", 10) },
    Ok([{ name: "filename", value: "a b.txt" }, { name: "size", value: "12" }]),
  );
  assert_eq(try { read_params("inline", 6) }, Ok([]));
  assert_eq(try { read_params("inline", 9) }, Ok([]));
  assert_eq(try { read_params("inline; a=1 b", 6) }, Err({ at: 12, reason: Trailing }));
  assert_eq(try { read_params("inline; a=1; A=2", 6) }, Err({ at: 13, reason: Repeated("a") }))
}

test "RFC 9110's four forms of one media type are equal, and parameter order does not matter" {
  let spellings = [
    "text/html;charset=utf-8",
    "Text/HTML;Charset=\"utf-8\"",
    "text/html; charset=\"utf-8\"",
  ].map(
    parse,
  );
  assert_eq(
    spellings,
    spellings.map(|_: Result<MediaType, Error>| parse("text/html;charset=UTF-8")),
  );
  assert_eq(parse("text/plain; a=1; b=2"), parse("TEXT/Plain; B=2; A=1"));
  assert(parse("text/plain; a=1") != parse("text/plain; a=2"));
  assert(parse("text/plain; a=x") != parse("text/plain; a=X"));
  assert(parse("text/plain") != parse("text/plain; a=1"));
  assert_eq(MediaType("Text", "HTML", [{ name: "Charset", value: "UTF-8" }]), html_utf8);
  assert_eq(digest(MediaType("Text", "HTML", [])), digest(MediaType("text", "html", [])))
}

const html_utf8: MediaType = MediaType("text", "html", [{ name: "charset", value: "utf-8" }])

test "a media type is shown as its canonical text, and its parts are read in lower case" {
  let m = MediaType("Image", "SVG+XML", [{ name: "Charset", value: "UTF-8" }]);
  assert_eq(f"{m}", "image/svg+xml; charset=UTF-8");
  assert_eq(top_level(m), "image");
  assert_eq(subtype(m), "svg+xml");
  assert_eq(suffix(m), Some("xml"));
  assert_eq(suffix(html_utf8), None);
  assert_eq(essence(m), "image/svg+xml");
  assert_eq(charset(m), Some("utf-8"));
  assert_eq(param(m, "CHARSET"), Some("UTF-8"));
  assert_eq(param(m, "boundary"), None);
  assert_eq(params(m), [{ name: "Charset", value: "UTF-8" }]);
  assert_eq(without_params(m), MediaType("image", "svg+xml", []));
  let kelvin = MediaType("text", "MAR\u{212A}DOWN", [{ name: "charset", value: "\u{212A}OI8-R" }]);
  assert_eq(subtype(kelvin), "mar\u{212A}down");
  assert_eq(charset(kelvin), Some("\u{212A}oi8-r"));
  assert(without_params(kelvin) != MediaType("text", "markdown", []));
  assert_eq(
    match parse("multipart/form-data; boundary=\"simple boundary\"") {
      Ok(form) -> boundary(form),
      Err(_) -> None,
    },
    Some("simple boundary"),
  )
}

test "`media_type` and `with_param` return `None` unless the names are valid tokens and the parameter value contains only characters allowed in a quoted string" {
  assert_eq(media_type("Text", "HTML"), Some(MediaType("text", "html", [])));
  assert_eq(media_type("text", ""), None);
  assert_eq(media_type("te xt", "html"), None);
  assert_eq(media_type("text", "html/x"), None);
  let plain = MediaType("text", "plain", []);
  assert_eq(
    with_param(plain, "Charset", "utf-8"),
    Some(MediaType("text", "plain", [{ name: "charset", value: "utf-8" }])),
  );
  let two = MediaType("text", "plain", [{ name: "a", value: "1" }, { name: "b", value: "2" }]);
  assert_eq(
    match with_param(two, "A", "x y") { Some(m) -> render(m), None -> "" },
    "text/plain; a=\"x y\"; b=2",
  );
  assert_eq(with_param(plain, "a b", "1"), None);
  assert_eq(with_param(plain, "", "1"), None);
  assert_eq(with_param(plain, "a", "line\nbreak"), None);
  assert_eq(with_param(plain, "a", "nul\0"), None);
  assert_eq(with_param(plain, "a", "del\u{7f}"), None);
  assert(with_param(plain, "a", "next line\u{85}") != None);
  assert(with_param(plain, "a", "tab\tand caf\u{e9}") != None);
  assert(is_token("a.b-c_d~1"));
  assert(!is_token("a/b"));
  assert(!is_token(""))
}

fn range_of(text: String) -> MediaType / {abort.raise} =
  match parse(text) { Ok(m) -> m, Err(_) -> panic("no media type: " ++ text) }

test "a range covers the types it names, and a wider range is less specific" {
  let html = range_of("text/html; charset=utf-8");
  assert(matches(range_of("*/*"), html));
  assert(matches(range_of("text/*"), html));
  assert(matches(range_of("TEXT/HTML"), html));
  assert(matches(range_of("text/html; q=0.2"), html));
  assert(matches(range_of("text/html; charset=UTF-8"), html));
  assert(!matches(range_of("text/html; level=1"), html));
  assert(!matches(range_of("text/plain"), html));
  assert(!matches(range_of("image/*"), html));
  assert(!matches(html, range_of("text/*")));
  assert_eq(
    ["*/*", "text/*", "text/plain", "text/plain;format=flowed", "text/plain;q=0.1"].map(
      |t: String| specificity(range_of(t)),
    ),
    [0, 1, 2, 3, 2],
  )
}

type WeightedCase = { text: String, weight: Option<Int> }

const weights: List<WeightedCase> =
  [
    { text: "text/html", weight: Some(1000) },
    { text: "text/html;q=1", weight: Some(1000) },
    { text: "text/html;q=1.000", weight: Some(1000) },
    { text: "text/html;q=1.", weight: Some(1000) },
    { text: "text/html;q=0", weight: Some(0) },
    { text: "text/html;q=0.", weight: Some(0) },
    { text: "text/html;q=0.5", weight: Some(500) },
    { text: "text/html;q=0.25", weight: Some(250) },
    { text: "text/html;Q=0.001", weight: Some(1) },
    { text: "text/html;q=0.999", weight: Some(999) },
    { text: "text/html;q=1.001", weight: None },
    { text: "text/html;q=2", weight: None },
    { text: "text/html;q=0.1234", weight: None },
    { text: "text/html;q=0.0001", weight: None },
    { text: "text/html;q=0.-1", weight: None },
    { text: "text/html;q=.5", weight: None },
    { text: "text/html;q=05", weight: None },
    { text: "text/html;q=-1", weight: None },
    { text: "text/html;q=\"\"", weight: None },
    { text: "text/html;q=0.x", weight: None },
  ]

test "`quality` returns the expected q-value (the weight from an HTTP Accept header) for {show(c.text)}" for c: WeightedCase in weights {
  assert_eq(quality(range_of(c.text)), c.weight)
}

type Listed = { text: String, canonical: List<String> }

const accepted: List<Listed> =
  [
    { text: "audio/*; q=0.2, audio/basic", canonical: ["audio/*; q=0.2", "audio/basic"] },
    {
      text: "text/plain; q=0.5, text/html, text/x-dvi; q=0.8, text/x-c",
      canonical: ["text/plain; q=0.5", "text/html", "text/x-dvi; q=0.8", "text/x-c"],
    },
    {
      text: "text/*, text/plain, text/plain;format=flowed, */*",
      canonical: ["text/*", "text/plain", "text/plain; format=flowed", "*/*"],
    },
    { text: "", canonical: [] },
    { text: " , ,", canonical: [] },
    {
      text: ",text/html,,text/plain; a=\"x,y\" ,",
      canonical: ["text/html", "text/plain; a=\"x,y\""],
    },
  ]

test "`parse_list` accepts {show(c.text)} as a list of media types, and `render` writes each one in canonical form" for c: Listed in accepted {
  assert_eq(
    match parse_list(c.text) { Ok(ms) -> Some(ms.map(render)), Err(_) -> None },
    Some(c.canonical),
  )
}

test "a list is rejected when an element is not a media type" {
  assert_eq(parse_list("text/html text/plain"), Err({ at: 10, reason: Trailing }));
  assert_eq(parse_list("text/html, plain"), Err({ at: 16, reason: NoSlash }));
  assert_eq(parse_list("text/html; a=\"x, text/plain"), Err({ at: 27, reason: Unclosed }))
}

test "`literal` returns a media type for valid text, or an error with the offset where the text is invalid" {
  assert_eq(literal("text/html; charset=utf-8"), Ok(html_utf8));
  assert_eq(
    literal("text/html; charset"),
    Err({ message: "a `=` is expected after a parameter's name", offset: 18 }),
  );
  assert_eq(
    literal("text/plain; a=\"caf\u{e9}\"; a=1"),
    Err({ message: "the parameter `a` is given twice", offset: 22 }),
  )
}

fn tokenized(text: String) -> String = {
  let token_text = String::of_chars(
    text.chars().filter(|c: Char| token_chars.contains(String::of_chars([c]))),
  );
  if token_text == "" { "x" } else { token_text }
}

type Seed = { top: String, subtype: String, name: String, value: String }

fn quoted_text(text: String) -> String =
  String::of_chars(text.chars().filter(|c: Char| is_quotable(String::of_chars([c]))))

fn seed_media_type(s: Seed) -> MediaType =
  match media_type(tokenized(s.top), tokenized(s.subtype)) {
    Some(m) -> match with_param(m, tokenized(s.name), quoted_text(s.value)) {
      Some(set) -> set,
      None -> m,
    },
    None -> MediaType("x", "x", []),
  }

fn upper_media_type(s: Seed) -> MediaType =
  MediaType(tokenized(s.top).ascii_upper(), tokenized(s.subtype).ascii_upper(), [
    { name: tokenized(s.name).ascii_upper(), value: quoted_text(s.value) },
  ])

fn seeds() -> gen::Gen<Seed> =
  gen::map4(
    gen::text(),
    gen::text(),
    gen::text(),
    gen::text(),
    |top: String, subtype: String, name: String, value: String|
      { top: top, subtype: subtype, name: name, value: value },
  )

test "a media type's canonical text reads back as the same media type" {
  gen::check(seeds(), |x: Seed|
    agrees(|s: Seed| parse(render(seed_media_type(s))), |s: Seed| Ok(seed_media_type(s)), x))
}

test "a media type is equal however its names are cased" {
  gen::check(seeds(), |x: Seed| agrees(upper_media_type, seed_media_type, x))
}

type Named = { extension: String, named: String }

const sampled: List<Named> =
  [
    { extension: "html", named: "text/html" },
    { extension: "htm", named: "text/html" },
    { extension: "css", named: "text/css" },
    { extension: "js", named: "text/javascript" },
