    { extension: "csv", named: "text/csv" },
    { extension: "md", named: "text/markdown" },
    { extension: "wasm", named: "application/wasm" },
    { extension: "png", named: "image/png" },
    { extension: "jpg", named: "image/jpeg" },
    { extension: "jpeg", named: "image/jpeg" },
    { extension: "gif", named: "image/gif" },
