//! Media types: the `type/subtype; name=value` text that a `Content-Type` field carries, and a
//! table that maps a file name's extension to a media type and back.
//!
//! A `MediaType` follows RFC 9110 §8.3. The type, the subtype and each parameter name are tokens,
//! and a parameter value is a token or a quoted string. The type, the subtype and the parameter
//! names are case-insensitive and stored in lower case. A value is stored as written, without its
//! quotes. Two media types are `==` when they have the same type and subtype and the same
//! parameters, in any order. `show` writes the canonical text and quotes a value that is not a
//! token.
//!
//! `read` raises an `Error` that says where and why a text is not a media type. `parse` returns
//! that `Error` as an `Err`. A text is rejected, never repaired. Whitespace around `=`, a parameter
//! named twice, and text after the last parameter are each an error.
//!
//! With `import std.mime`, `mime"text/html; charset=utf-8"` is a literal that is checked when the
//! program is checked.
//!
//! A `MediaType` can also be a range, such as `text/*` or `*/*`, which stands for every type that
//! matches it. `matches` reports whether a range covers a type. `quality` returns the weight that
//! an `Accept` field gives a range, and `read_list` reads such a field. `std.http` uses these to
//! pick the best of several types.
//!
//! RFC 2231 lets a long or non-ASCII parameter value be written in numbered sections (`name*0`,
//! `name*1`), and with a charset (`name*` or `name*0*`). The readers return these parameters
//! exactly as written. `joined` combines the sections of each such parameter into one value under
//! its plain name, and `split_into_sections` writes a value in sections.
//!
//! `of_extension` and `of_path` return the media type for a file name's extension. `extension` and
//! `extensions` return the extensions written for a media type. The table is built into this module
//! and never taken from the host, so the result is the same on every machine. It covers the types
//! that a web server or an upload handler commonly meets. An extension gives the type the file is
//! declared to have, not the type of its contents. A browser may sniff the bytes and infer another
//! type, unless `X-Content-Type-Options: nosniff` turns that off.

import std.bytes
import std.encoded_word
import std.encoded_word (Section, decode_sections, encode_sections)
import std.laws (agrees)
import std.list (enumerate)
import std.path
import std.show (show)
import std.string
import std.gen

/// One parameter of a media type: its name in lower case, and its value as written without quotes.
pub type Param = { name: String, value: String }

/// A media type: its type, its subtype, and its parameters in the order written.
///
/// `media_type`, `with_param` and the readers create one whose type, subtype and names are
/// lower-case tokens. The constructor used directly checks nothing, and `==`, `compare`, `digest`
/// and `show` treat such a value as lower case too.
pub type MediaType = | MediaType(String, String, List<Param>)

key for MediaType by identity

show for MediaType by render

/// Why a text is not a media type.
pub type ErrorKind =
  /// No token where a type, a subtype, a parameter's name or its value must be.
  | NoToken
  /// No `/` after the type.
  | NoSlash
  /// No `=` after a parameter's name. Whitespace between the name and the `=` also causes this
  /// error.
  | NoEquals
  /// A quoted string that never closes.
  | Unclosed
  /// A control byte in a quoted string, which allows none but a tab.
  | Control
  /// A parameter named twice, with its name.
  | Repeated(String)
  /// Text after the media type that is not a parameter.
  | Trailing

/// An error, and the offset in the text's UTF-8 where it was found.
pub type Error = { at: Int, reason: ErrorKind }

/// Why `joined` cannot combine the parameters into values. RFC 2231 writes one long value as
/// numbered sections, such as `name*0` and `name*1`, and each section is a separate parameter.
pub type JoinError =
  /// The sections of the parameter with this name are not numbered `0`, `1`, `2` and so on in
  /// order. This error also occurs when the parameter is written both as a single `name*` with a
  /// charset and as numbered sections.
  | BadSections(String)
  /// The value of the parameter of this name cannot be read, with the reason `std.encoded_word`
  /// reports.
  | BadValue(String, encoded_word::ErrorKind)

/// What this module's readers raise when they reject a text.
pub effect mime {
  /// The text is not a media type.
  raise fail(e: Error)
  /// The parameters do not join into one value each.
  raise unjoined(e: JoinError)
}

/// The media type in `text`, raising `mime.fail` where `parse` returns `Err`. Blanks around it
/// are skipped.
pub fn read(text: String) -> MediaType / {mime.fail, abort.raise} = {
  let b = Bytes::of_string(text);
  let one = read_at(b, b.skip(0, optional_whitespace));
  let end = b.skip(one.at, optional_whitespace);
  if end < b.len() { fail(end, Trailing) } else { one.value }
}

/// The media type in `text`, or where and why it stops being one.
pub fn parse(text: String) -> Result<MediaType, Error> / {abort.raise} = try { read(text) }

/// The media types of a comma-separated list, as an `Accept` field carries its ranges, in the
/// order written; an empty element is skipped (RFC 9110 §5.6.1). Raises `mime.fail` where
/// `parse_list` returns `Err`.
pub fn read_list(text: String) -> List<MediaType> / {mime.fail, abort.raise} = {
  let b = Bytes::of_string(text);
  listed(b, 0, [], b.len() + 1)
}

/// Parses a comma-separated list of media types. Returns an `Error` with the offset and reason when
/// the text is not such a list.
pub fn parse_list(text: String) -> Result<List<MediaType>, Error> / {abort.raise} =
  try { read_list(text) }

/// The parameters in `text` from byte `at` on, each after a `;` as in a media type: what follows
/// the first word of a field such as `Content-Disposition`. Raises `mime.fail` as `read` does.
pub fn read_params(text: String, at: Int) -> List<Param> / {mime.fail, abort.raise} = {
  let b = Bytes::of_string(text);
  let scan = parameters(b, { at: at, params: [], seen: Map::new() }, b.len() + 1);
  let end = b.skip(scan.at, optional_whitespace);
  if end < b.len() { fail(end, Trailing) } else { scan.params }
}

/// Checks a `mime"..."` literal.
///
/// Returns the media type `read` returns. Otherwise returns why the text is not a media type, and
/// the offset of the character where it stops being one.
pub fn literal(
  text: String,
) -> Result<MediaType, { message: String, offset: Int }> / {abort.raise} =
  match parse(text) {
    Ok(m) -> Ok(m),
    Err(r) ->
      Err({
        message: explained(r.reason),
        offset: String::of_bytes_lossy(Bytes::of_string(text).slice(0, r.at)).len(),
      }),
  }

fn explained(reason: ErrorKind) -> String =
  match reason {
    NoToken -> "a name is expected here",
    NoSlash -> "a `/` is expected between the type and the subtype",
    NoEquals -> "a `=` is expected after a parameter's name",
    Unclosed -> "the quoted string never closes",
    Control -> "a quoted string cannot contain a control character other than a tab",
    Repeated(name) -> "the parameter `" ++ name ++ "` is given twice",
    Trailing -> "only `;` and a parameter can follow a media type",
  }

fn fail<a>(at: Int, reason: ErrorKind) -> a / {mime.fail} = mime.fail({ at: at, reason: reason })

const tchars: Bytes =
  b"!#$%&'*+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

const optional_whitespace: Bytes = b" \t"

const quoted_stops: Bytes =
  b"\"\\\x00\x01\x02\x03\x04\x05\x06\x07\x08\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x7f"

fn ascii_lower_slice(b: Bytes, from: Int, to: Int) -> String / {abort.raise} =
  String::of_bytes(b.slice(from, to)).ascii_lower()

type ReadResult = { value: MediaType, at: Int }

fn read_at(b: Bytes, at: Int) -> ReadResult / {mime.fail, abort.raise} = {
  let slash = b.skip(at, tchars);
  if slash == at { fail(at, NoToken) }
  else if b.peek(slash) != b'/' { fail(slash, NoSlash) } else {
    let end = b.skip(slash + 1, tchars);
    if end == slash + 1 { fail(end, NoToken) } else {
      let scan = parameters(b, { at: end, params: [], seen: Map::new() }, b.len() + 1);
      {
        value: MediaType(
          ascii_lower_slice(b, at, slash),
          ascii_lower_slice(b, slash + 1, end),
          scan.params,
        ),
        at: scan.at,
      }
    }
  }
}

fn listed(
  b: Bytes,
  at: Int,
  accumulator: List<MediaType>,
  left: Int,
) -> List<MediaType> / {mime.fail, abort.raise} = {
  let start = b.skip(at, b" \t,");
  if left <= 0 { accumulator }
  else if start >= b.len() { accumulator } else {
    let one = read_at(b, start);
    let end = b.skip(one.at, optional_whitespace);
    if end < b.len() && b.at(end) != b',' { fail(end, Trailing) }
    else { listed(b, end, accumulator.push(one.value), left - 1) }
  }
}

type ParamScan = { at: Int, params: List<Param>, seen: Map<String, Unit> }

fn parameters(b: Bytes, scan: ParamScan, left: Int) -> ParamScan / {mime.fail, abort.raise} = {
  let semi = b.skip(scan.at, optional_whitespace);
  if left <= 0 { scan }
  else if b.peek(semi) != b';' { scan } else {
    let start = b.skip(semi + 1, optional_whitespace);
    let equals = b.skip(start, tchars);
    if equals == start { parameters(b, { ..scan, at: start }, left - 1) }
    else if b.peek(equals) != b'=' { fail(equals, NoEquals) }
    else { parameters(b, with_parameter(b, scan, start, equals), left - 1) }
  }
}

fn with_parameter(
  b: Bytes,
  scan: ParamScan,
  start: Int,
  equals: Int,
) -> ParamScan / {mime.fail, abort.raise} = {
  let name = ascii_lower_slice(b, start, equals);
  if scan.seen.contains(name) { fail(start, Repeated(name)) } else {
    let value = value_at(b, equals + 1);
    {
      at: value.at,
      params: scan.params.push({ name: name, value: value.text }),
      seen: scan.seen.insert(name, ()),
    }
  }
}

type TextResult = { text: String, at: Int }

fn value_at(b: Bytes, at: Int) -> TextResult / {mime.fail, abort.raise} =
  if b.peek(at) == b'"' { quoted(b, at + 1, [], b.len() + 1) } else {
    let end = b.skip(at, tchars);
    if end == at { fail(at, NoToken) }
    else { { text: String::of_bytes(b.slice(at, end)), at: end } }
  }

fn quoted(
  b: Bytes,
  at: Int,
  chunks: List<Bytes>,
  left: Int,
) -> TextResult / {mime.fail, abort.raise} = {
  let stop = b.skip_until(at, quoted_stops);
  let so_far = chunks.push(b.slice(at, stop));
  let c = b.peek(stop);
  if left <= 0 { fail(stop, Unclosed) }
  else if c == b'"' { { text: String::of_bytes(Bytes::concat_all(so_far)), at: stop + 1 } }
  else if c < 0 { fail(stop, Unclosed) }
  else if c != b'\\' { fail(stop, Control) }
  else if stop + 1 >= b.len() { fail(stop + 1, Unclosed) }
  else if !is_escapable(b.at(stop + 1)) { fail(stop + 1, Control) }
  else { quoted(b, stop + 2, so_far.push(b.slice(stop + 1, stop + 2)), left - 1) }
}

fn is_escapable(c: Int) -> Bool = c == b'\t' || (c >= b' ' && c != 0x7F)

/// The canonical text: the type and subtype in lower case, then each parameter as `; name=value`
/// in stored order. A value that is not a token is quoted, with a backslash before each quote and
/// backslash in it. `read` reads the text back as the same value for any value that `media_type`,
/// `with_param` or the readers return.
pub fn render(m: MediaType) -> String =
  match m {
    MediaType(top, subtype, params) ->
      params.fold(
        top.ascii_lower() ++ "/" ++ subtype.ascii_lower(),
        |accumulator: String, p: Param| accumulator ++ "; " ++ param_text(p),
      ),
  }

/// One parameter as `render` writes it: its name in lower case, `=`, and its value, quoted when it
/// is not a token.
pub fn param_text(p: Param) -> String = p.name.ascii_lower() ++ "=" ++ quote_value(p.value)

fn quote_value(value: String) -> String =
  if is_token(value) { value } else {
    "\""
      ++ String::of_chars(
        value.chars().fold([], |accumulator: List<Char>, c: Char|
          if c == '"' || c == '\\' { accumulator.push('\\').push(c) } else { accumulator.push(c) }),
      )
      ++ "\""
  }

/// Whether `text` is a token of RFC 9110 §5.6.2: one or more of the letters, the digits and
/// ``!#$%&'*+-.^_`|~``.
pub fn is_token(text: String) -> Bool =
  text.len() > 0
    && text.chars().fold(true, |ok: Bool, c: Char|
      ok && token_chars.contains(String::of_chars([c])))

/// Where the token that starts at `at` in `b` ends: `at` itself where none starts there.
pub fn token_end(b: Bytes, at: Int) -> Int / {abort.raise} = b.skip(at, tchars)

const token_chars: String =
  "!#$%&'*+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

/// Whether a quoted string, or a header field's value, can contain `text`: no control character
/// but a tab.
pub fn is_quotable(text: String) -> Bool =
  text.chars().fold(true, |ok: Bool, c: Char|
    ok && (c == '\t' || (Int::of_char(c) >= 32 && Int::of_char(c) != 127)))

type MediaTypeKey = { top: String, subtype: String, params: List<Param> }

fn identity(m: MediaType) -> MediaTypeKey =
  match m {
    MediaType(top, subtype, params) ->
      {
        top: top.ascii_lower(),
        subtype: subtype.ascii_lower(),
        params: ordered(
          params.map(|p: Param| {
            let name = p.name.ascii_lower();
            { name: name, value: if name == "charset" { p.value.ascii_lower() } else { p.value } }
          }),
        ),
      },
  }

fn ordered(params: List<Param>) -> List<Param> =
  if params.len() < 2 { params } else { params.sort() }

/// The media type `top/subtype` with no parameter, in lower case; `None` unless both are tokens.
pub fn media_type(top: String, subtype: String) -> Option<MediaType> =
  if is_token(top) && is_token(subtype) {
    Some(MediaType(top.ascii_lower(), subtype.ascii_lower(), []))
  } else { None }

/// `m` with the parameter `name` set to `value`: in place of the one it has under that name, or
/// after its last. `None` when `name` is not a token or `value` contains a control character other
/// than a tab, which no media type's text can carry.
pub fn with_param(m: MediaType, name: String, value: String) -> Option<MediaType> = {
  let lower = name.ascii_lower();
  if !is_token(name) || !is_quotable(value) { None } else {
    match m {
      MediaType(top, subtype, params) ->
        Some(
          MediaType(top, subtype, if has_param(params, lower) {
            params.map(|p: Param|
              if p.name.ascii_lower() == lower { { name: lower, value: value } } else { p })
          } else { params.push({ name: lower, value: value }) }),
        ),
    }
  }
}

fn has_param(params: List<Param>, lower: String) -> Bool =
  params.fold(false, |found: Bool, p: Param| found || p.name.ascii_lower() == lower)

/// `m` with no parameter.
pub fn without_params(m: MediaType) -> MediaType =
  match m { MediaType(top, subtype, _) -> MediaType(top, subtype, []) }

/// The type before the `/`, in lower case: `text` of `text/html`.
pub fn top_level(m: MediaType) -> String = match m { MediaType(top, _, _) -> top.ascii_lower() }

/// The subtype after the `/`, in lower case: `svg+xml` of `image/svg+xml`.
pub fn subtype(m: MediaType) -> String =
  match m { MediaType(_, subtype, _) -> subtype.ascii_lower() }

/// Returns the structured syntax suffix of the subtype, which is the part after its last `+`: `xml`
/// for `image/svg+xml`. Returns `None` when the subtype has no `+`, as in `text/html`.
pub fn suffix(m: MediaType) -> Option<String> = {
  let pieces = subtype(m).split("+");
  if pieces.len() < 2 { None } else { pieces.at(pieces.len() - 1) }
}

/// The type and subtype alone, `text/html`, in lower case.
pub fn essence(m: MediaType) -> String = top_level(m) ++ "/" ++ subtype(m)

/// The parameters in stored order.
pub fn params(m: MediaType) -> List<Param> = match m { MediaType(_, _, held) -> held }

/// The value of the parameter `name`, whatever case either is written in.
pub fn param(m: MediaType, name: String) -> Option<String> = {
  let lower = name.ascii_lower();
  params(m).fold(None, |found: Option<String>, p: Param|
    match found {
      Some(_) -> found,
      None -> if p.name.ascii_lower() == lower { Some(p.value) } else { None },
    })
}

/// The `charset` parameter in lower case, as a charset's name is case-insensitive.
pub fn charset(m: MediaType) -> Option<String> =
  match param(m, "charset") { Some(name) -> Some(name.ascii_lower()), None -> None }

/// The `boundary` parameter, which delimits the parts of a `multipart` body.
pub fn boundary(m: MediaType) -> Option<String> = param(m, "boundary")

/// Whether the range `range` covers `m`: `*/*` covers every type, `text/*` every subtype of
/// `text`, and any other range the one type and subtype it names. Each parameter of the range but
/// `q` must be `m`'s too, with the same value.
pub fn matches(range: MediaType, m: MediaType) -> Bool = {
  let want = identity(range);
  let have = identity(m);
  (want.top == "*" || want.top == have.top) && (want.subtype == "*" || want.subtype == have.subtype)
    && want.params.fold(true, |ok: Bool, p: Param| ok && (p.name == "q" || have.params.contains(p)))
}

/// How much of a type a range pins down, for ranking the ranges that cover one: 0 for `*/*`, 1 for
/// `text/*`, 2 for `text/html`, and 3 for one with a parameter other than `q`.
pub fn specificity(range: MediaType) -> Int = {
  let want = identity(range);
  if want.top == "*" { 0 }
  else if want.subtype == "*" { 1 }
  else if want.params.filter(|p: Param| p.name != "q").len() == 0 { 2 }
  else { 3 }
}

/// Returns the weight of an `Accept` range in thousandths: 1000 when the range has no `q`
/// parameter. Returns `None` when `q` is not a valid weight under RFC 9110 §12.4.2, which is a
/// number from 0 to 1 with at most three decimals.
pub fn quality(range: MediaType) -> Option<Int> / {abort.raise} =
  match param(range, "q") { None -> Some(1000), Some(q) -> weight(q) }

fn weight(q: String) -> Option<Int> / {abort.raise} = {
  let b = Bytes::of_string(q);
  let n = b.len();
  let digits = b.skip(2, b"0123456789");
  if n == 0 || n > 5 || (n > 1 && (b.at(1) != b'.' || digits < n)) { None } else {
    let whole = b.at(0) - b'0';
    match q.slice(if n > 1 { 2 } else { 1 }, n).pad_right(3, "0").int_of_string() {
      Some(part) -> if (whole == 0 || whole == 1) && whole * 1000 + part <= 1000 {
        Some(whole * 1000 + part)
      } else { None },
      None -> None,
    }
  }
}

/// Returns `held` with the sections of each RFC 2231 value joined into one parameter under its
/// plain name. Raises `mime.unjoined` where `join` returns `Err`.
///
/// The sections `name*0`, `name*1` and so on are joined in the order of their numbers, whatever
/// order they were written in. A section whose name ends in `*`, and a lone `name*`, is
/// percent-encoded. The first section of a value then starts with the charset and the language that
/// the value's bytes are read in. The joined parameter takes the place of the value's first
/// section. A parameter with the plain name beside the sections is dropped, because RFC 6266 tells
/// a reader to prefer the extended form. Every other parameter is returned unchanged.
pub fn joined(params: List<Param>) -> List<Param> / {mime.unjoined, abort.raise} = {
  let read = params.map(sectioned_name);
  let groups = read.fold(Map::new(), |m: Map<String, List<ParamSection>>, n: ParamSection|
    m.insert(n.base, List::push(match m.get(n.base) { Some(found) -> found, None -> [] }, n)));
  read.fold({ out: [], seen: Map::new() }, |j: JoinState, n: ParamSection|
    if j.seen.contains(n.base) { j } else {
      {
        out: j.out.push(
          whole(n.base, match groups.get(n.base) { Some(found) -> found, None -> [] }),
        ),
        seen: j.seen.insert(n.base, ()),
      }
    }).out
}

/// Joins parameters split into RFC 2231 sections, or given a charset, into one parameter per name.
/// Returns `Err` with the reason when they cannot be joined.
pub fn join(params: List<Param>) -> Result<List<Param>, JoinError> / {abort.raise} =
  try { joined(params) }

type ParamSection = { base: String, index: Int, extended: Bool, starred: Bool, value: String }

type JoinState = { out: List<Param>, seen: Map<String, Unit> }

fn sectioned_name(p: Param) -> ParamSection / {abort.raise} = {
  let plain = { base: p.name, index: -1, extended: false, starred: false, value: p.value };
  match p.name.split("*") {
    [base, ""] -> if base == "" { plain }
    else { { ..plain, base: base, extended: true, starred: true } },
    [base, digits] -> numbered(plain, base, digits, false),
    [base, digits, ""] -> numbered(plain, base, digits, true),
    _ -> plain,
  }
}

fn numbered(
  plain: ParamSection,
  base: String,
  digits: String,
  extended: Bool,
) -> ParamSection / {abort.raise} =
  match Bytes::of_string(digits).int_of_ascii() {
    Some(n) -> if base == "" || n < 0 || n.to_string() != digits { plain }
    else { { base: base, index: n, extended: extended, starred: true, value: plain.value } },
    None -> plain,
  }

fn whole(base: String, group: List<ParamSection>) -> Param / {mime.unjoined, abort.raise} =
  match group.filter(|n: ParamSection| n.starred) {
    [] -> { name: base, value: match group { [first, ..] -> first.value, [] -> "" } },
    starred -> join_sections(base, starred),
  }

fn join_sections(
  base: String,
  starred: List<ParamSection>,
) -> Param / {mime.unjoined, abort.raise} = {
  let sections = starred.filter(|n: ParamSection| n.index >= 0).sort_by(
    |a: ParamSection, b: ParamSection| a.index < b.index,
  );
  let counted = enumerate(sections).fold(
    true,
    |ok: Bool, s: { index: Int, value: ParamSection }| ok && s.value.index == s.index,
  );
  let wholes = starred.len() - sections.len();
  if !counted || wholes > 1 || (wholes == 1 && sections.len() > 0) {
    mime.unjoined(BadSections(base))
  } else {
    match decode_sections(
        List::map(if wholes == 1 { starred } else { sections }, |n: ParamSection|
          { text: n.value, extended: n.extended }),
      ) {
      Ok(value) -> { name: base, value: value },
      Err(r) -> mime.unjoined(BadValue(base, r.reason)),
    }
  }
}

/// Returns the parameters that carry `value` under `name`, written as mail writes them.
///
/// The result is the single parameter `name=value` when both of these hold: `value` is printable
/// ASCII with none of `"`, `\`, `'`, `%` and `*`, which readers of RFC 2231 interpret in more than
/// one way, and the parameter, quoted if needed, is at most `max_length` characters.
///
/// Otherwise the result is RFC 2231's extended sections: `name*` alone, or `name*0*`, `name*1*` and
/// so on. Each section is at most `max_length` characters, unless the escapes for a single
/// character are longer. `joined` turns the result back into `name=value`.
pub fn split_into_sections(
  name: String,
  value: String,
  max_length: Int,
) -> List<Param> / {abort.raise} = {
  let b = Bytes::of_string(value);
  if b.skip(0, plain_value_bytes) == b.len()
      && name.len() + 1 + quote_value(value).len() <= max_length { [{ name: name, value: value }] }
  else {
    match encode_sections(value, max_length - name.len() - 6) {
      [only] -> [{ name: name ++ "*", value: only }],
      several ->
        enumerate(several).map(|s: { index: Int, value: String }|
          { name: name ++ "*" ++ s.index.to_string() ++ "*", value: s.value }),
    }
  }
}

const plain_value_bytes: Bytes =
  b" !#$&()+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~"

/// The media type a file name's extension names, written with or without its dot and in any
/// case: `text/html` for `html`, `.html` and `HTML`. `None` for one the table does not contain.
pub fn of_extension(extension: String) -> Option<MediaType> / {abort.raise} =
  match table.types.get(undotted(extension.ascii_lower())) {
    Some(named) -> Some(bare(named)),
    None -> None,
  }

/// The media type of a path by its file name's last extension, so `a/b.tar.gz` is
/// `application/gzip`: what the bytes are, whatever they unpack to. `None` for a name with no
/// extension, including a dotfile, and for an extension the table does not contain.
pub fn of_path(file: String) -> Option<MediaType> / {abort.raise} =
  match path::extension(file) { Some(extension) -> of_extension(extension), None -> None }

/// The extension a type is most often written under, without a dot: `jpg` for `image/jpeg`.
/// Parameters are ignored. `None` for a type the table does not contain.
pub fn extension(m: MediaType) -> Option<String> = extensions(m).at(0)

/// Every extension the table lists for a type, the preferred one first; none for a type it does
/// not contain.
pub fn extensions(m: MediaType) -> List<String> =
  match table.extensions.get(essence(m)) { Some(found) -> found, None -> [] }

fn undotted(extension: String) -> String / {abort.raise} =
  if extension.starts_with(".") { extension.slice(1, extension.len()) } else { extension }

fn bare(named: String) -> MediaType / {abort.raise} = {
  let slash = named.find("/");
  MediaType(named.slice(0, slash), named.slice(slash + 1, named.len()), [])
}

type Table = { types: Map<String, String>, extensions: Map<String, List<String>> }

const table: Table =
  rows.split("\n").fold({ types: Map::new(), extensions: Map::new() }, |t: Table, row: String|
    match row.split(" ") {
      [named, ..exts] ->
        {
          types: exts.fold(t.types, |m: Map<String, String>, extension: String|
            if m.contains(extension) { m } else { m.insert(extension, named) }),
          extensions: t.extensions.insert(named, exts),
        },
      [] -> t,
    })

