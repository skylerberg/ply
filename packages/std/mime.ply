test "{c.extension} is {c.named}" for c: Named in sampled {
  assert_eq(
    match of_extension(c.extension) { Some(m) -> Some(render(m)), None -> None },
    Some(c.named),
  );
  assert(match parse(c.named) { Ok(m) -> extensions(m).contains(c.extension), Err(_) -> false })
}

test "`of_extension` ignores a leading dot and letter case, and `of_path` uses the path's last file extension" {
  let html = Some(MediaType("text", "html", []));
  assert_eq(of_extension("html"), html);
  assert_eq(of_extension(".html"), html);
  assert_eq(of_extension("HTML"), html);
  assert_eq(of_extension(".HtM"), html);
  assert_eq(of_extension("..html"), None);
  assert_eq(of_extension(""), None);
  assert_eq(of_extension("no-such-extension"), None);
  assert_eq(of_extension("mkv"), Some(MediaType("video", "x-matroska", [])));
  assert_eq(of_extension("m\u{212A}v"), None);
  assert_eq(of_path("site/index.html"), html);
  assert_eq(of_path("a/b.tar.gz"), Some(MediaType("application", "gzip", [])));
  assert_eq(of_path("photo.JPG"), Some(MediaType("image", "jpeg", [])));
  assert_eq(of_path("a.d/README"), None);
  assert_eq(of_path(".gitignore"), None);
  assert_eq(of_path("archive."), None);
  assert_eq(of_path(""), None)
}

test "`extensions` returns a media type's extensions with the preferred one first, ignoring case and parameters" {
  let jpeg = MediaType("IMAGE", "JPEG", [{ name: "q", value: "0.5" }]);
  assert_eq(extensions(jpeg), ["jpg", "jpeg", "jpe"]);
  assert_eq(extension(jpeg), Some("jpg"));
  assert_eq(extension(MediaType("audio", "mpeg", [])), Some("mp3"));
  assert_eq(extension(MediaType("text", "plain", [])), Some("txt"));
  assert_eq(extension(MediaType("application", "octet-stream", [])), Some("bin"));
  assert_eq(extensions(MediaType("text", "xml", [])), ["xml"]);
  assert_eq(of_extension("xml"), Some(MediaType("application", "xml", [])));
  assert_eq(extensions(MediaType("application", "x-no-such-type", [])), []);
  assert_eq(extension(MediaType("application", "x-no-such-type", [])), None)
}

test "every media type in the table is lower case, and every extension in the table maps to a type that lists that extension" {
  let t = table;
  assert(t.extensions.len() > 400);
  assert(t.types.len() > 550);
  assert_eq(
    t.extensions.keys().filter(|named: String|
      match parse(named) {
        Ok(m) -> render(m) != named || extensions(m).len() == 0,
        Err(_) -> true,
      }),
    [],
  );
  assert_eq(
    t.types.keys().filter(|extension: String|
      extension != extension.ascii_lower()
        || (match of_extension(extension) {
          Some(m) -> !extensions(m).contains(extension),
          None -> true,
        })),
    [],
  )
}

type Joined = { text: String, params: List<Param> }

const section_cases: List<Joined> =
  [
    {
      text: "message/external-body; access-type=URL; URL*0=\"ftp://\"; URL*1=\"cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar\"",
      params: [
        { name: "access-type", value: "URL" },
        { name: "url", value: "ftp://cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar" },
      ],
    },
    {
      text: "application/x-stuff; title*=us-ascii'en-us'This%20is%20%2A%2A%2Afun%2A%2A%2A",
      params: [{ name: "title", value: "This is ***fun***" }],
    },
    {
      text: "application/x-stuff; title*0*=us-ascii'en'This%20is%20even%20more%20; title*1*=%2A%2A%2Afun%2A%2A%2A%20; title*2=\"isn't it!\"",
      params: [{ name: "title", value: "This is even more ***fun*** isn't it!" }],
    },
    {
      text: "text/plain; a*1=two; b=1; a*0=one; c*=UTF-8''%E2%82%AC",
      params: [
        { name: "a", value: "onetwo" },
        { name: "b", value: "1" },
        { name: "c", value: "\u{20ac}" },
      ],
    },
    {
      text: "application/pdf; name=fallback.pdf; name*=UTF-8''na%C3%AFve.pdf",
      params: [{ name: "name", value: "na\u{ef}ve.pdf" }],
    },
    {
      text: "text/plain; a*b=1; *=2; x*01=3; y*-1=4; z**=5",
      params: [
        { name: "a*b", value: "1" },
        { name: "*", value: "2" },
        { name: "x*01", value: "3" },
        { name: "y*-1", value: "4" },
        { name: "z**", value: "5" },
      ],
    },
    { text: "text/plain", params: [] },
  ]

test "`join` merges the numbered and encoded parameter pieces of the media type {show(c.text)} into whole parameters" for c: Joined in section_cases {
  assert_eq(match parse(c.text) { Ok(m) -> join(params(m)), Err(_) -> Ok([]) }, Ok(c.params))
}

test "`join` fails with the parameter's name when its pieces are not numbered from zero or cannot be decoded" {
  let of = |text: String| join(params(range_of(text)));
  assert_eq(of("text/plain; a*1=x"), Err(BadSections("a")));
  assert_eq(of("text/plain; a*0=x; a*2=y"), Err(BadSections("a")));
  assert_eq(of("text/plain; a*0=x; a*0*=y"), Err(BadSections("a")));
  assert_eq(of("text/plain; a*=UTF-8''x; a*0=y"), Err(BadSections("a")));
  assert_eq(of("text/plain; a*=plain"), Err(BadValue("a", encoded_word::NoCharset)));
  assert_eq(
    of("text/plain; a*0*=big5''x; a*1=y"),
    Err(BadValue("a", encoded_word::UnknownCharset("big5"))),
  );
  assert_eq(of("text/plain; a*0=x; a*1*=%41"), Err(BadValue("a", encoded_word::NoCharset)));
  assert_eq(of("text/plain; a*=UTF-8''%FF"), Err(BadValue("a", encoded_word::BadBytes)));
  assert_eq(try { joined(params(range_of("text/plain; a*1=x"))) }, Err(BadSections("a")))
}

test "`split_into_sections` writes a short plain ASCII value as one parameter, and any other value as encoded pieces" {
  assert_eq(split_into_sections("filename", "report.pdf", 60), [
    { name: "filename", value: "report.pdf" },
  ]);
  assert_eq(split_into_sections("filename", "my report.pdf", 60), [
    { name: "filename", value: "my report.pdf" },
  ]);
  assert_eq(split_into_sections("filename", "it's 100%.txt", 60), [
    { name: "filename*", value: "UTF-8''it%27s%20100%25.txt" },
  ]);
  assert_eq(split_into_sections("filename", "a\"b\\c*", 60), [
    { name: "filename*", value: "UTF-8''a%22b%5Cc%2A" },
  ]);
  assert_eq(split_into_sections("filename", "na\u{ef}ve.pdf", 60), [
    { name: "filename*", value: "UTF-8''na%C3%AFve.pdf" },
  ]);
  assert_eq(split_into_sections("filename", "\u{20ac}\u{20ac}\u{20ac}\u{20ac}.txt", 34), [
    { name: "filename*0*", value: "UTF-8''%E2%82%AC" },
    { name: "filename*1*", value: "%E2%82%AC%E2%82%AC" },
    { name: "filename*2*", value: "%E2%82%AC.txt" },
  ]);
  assert_eq(split_into_sections("a", "line\r\nbreak", 60), [
    { name: "a*", value: "UTF-8''line%0D%0Abreak" },
  ]);
  assert_eq(
    render(MediaType("text", "plain", split_into_sections("name", "a b \u{e9}", 60))),
    "text/plain; name*=UTF-8''a%20b%20%C3%A9",
  )
}
