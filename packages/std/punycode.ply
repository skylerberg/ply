//! Punycode (RFC 3492): any text written with ASCII letters, digits and hyphens, the form the
//! labels of an internationalized domain name take on the wire.
//!
//! The encoding writes the text's ASCII characters first, unchanged, then a hyphen if there were
//! any. A run of letters and digits follows that encodes each other character and its position.
//! `encode` writes this form in lowercase, without the `xn--` prefix a domain name label adds.
//! `decode` reads it in either case. This module knows nothing of domain names: `std.idna` maps,
//! checks and converts them.

import std.laws (round_trip)
import std.list
import std.gen

/// The threshold for the digit at position `k`, which advances in steps of 36. A digit whose value
/// is below it ends the number.
fn threshold(k: Int, bias: Int) -> Int =
  if k <= bias { 1 } else if k >= bias + 26 { 26 } else { k - bias }

/// The bias for the next number, adapted after a delta of `delta` with `points` characters handled
/// (RFC 3492 section 6.1).
fn adapt_bias(delta: Int, points: Int, first: Bool) -> Int / {abort.raise} = {
  let scaled = if first { delta / 700 } else { delta / 2 };
  bias_for_delta(scaled + scaled / points, 0)
}

fn bias_for_delta(delta: Int, k: Int) -> Int / {abort.raise} =
  if delta > 455 { bias_for_delta(delta / 35, k + 36) } else { k + 36 * delta / (delta + 38) }

/// The digit whose value is `d`: `a` to `z` for 0 to 25, then `0` to `9`.
fn digit(d: Int) -> Char =
  match Char::of_int(if d < 26 { 97 + d } else { 22 + d }) { Some(c) -> c, None -> '0' }

/// `out` followed by `q`, written as a variable-length number (RFC 3492 section 3.3) whose next
/// digit is at position `k`. `digits_left` limits the digits; a 63-bit number never reaches it.
fn write_number(
  out: List<Char>,
  q: Int,
  k: Int,
  bias: Int,
  digits_left: Int,
) -> List<Char> / {abort.raise} = {
  let t = threshold(k, bias);
  if q < t || digits_left <= 0 { out.push(digit(q)) } else {
    write_number(
      out.push(digit(t + (q - t) % (36 - t))),
      (q - t) / (36 - t),
      k + 36,
      bias,
      digits_left - 1,
    )
  }
}

/// What is written so far, the smallest code point not yet handled, the delta since the last
/// number written, the bias, and how many characters are handled.
type EncoderState = { out: List<Char>, n: Int, delta: Int, bias: Int, handled: Int }

/// `text` in Punycode: ASCII letters, digits and hyphens, plus any other ASCII characters `text`
/// contains, unchanged. A nonempty all-ASCII text encodes as itself followed by a hyphen.
pub fn encode(text: String) -> String / {abort.raise} = {
  let points = text.chars().map(Int::of_char);
  let basic = text.chars().filter(|c: Char| c < '\u{80}');
  let others = points.fold(Map::new(), |seen: Map<Int, Unit>, cp: Int|
    if cp < 128 { seen } else { seen.insert(cp, ()) }).keys(
  );
  let start = {
    out: if basic.len() > 0 { basic.push('-') } else { basic },
    n: 128,
    delta: 0,
    bias: 72,
    handled: basic.len(),
  };
  let done = others.fold(start, |e: EncoderState, m: Int| {
    let risen = {
      out: e.out,
      n: m,
      delta: e.delta + (m - e.n) * (e.handled + 1),
      bias: e.bias,
      handled: e.handled,
    };
    let passed = points.fold(risen, |s: EncoderState, cp: Int|
      if cp < m { { out: s.out, n: s.n, delta: s.delta + 1, bias: s.bias, handled: s.handled } }
      else if cp == m {
        {
          out: write_number(s.out, s.delta, 36, s.bias, 20),
          n: s.n,
          delta: 0,
          bias: adapt_bias(s.delta, s.handled + 1, s.handled == basic.len()),
          handled: s.handled + 1,
        }
      } else { s });
    {
      out: passed.out,
      n: m + 1,
      delta: passed.delta + 1,
      bias: passed.bias,
      handled: passed.handled,
    }
  });
  String::of_chars(done.out)
}

/// The value of a digit in either case, or `-1`.
fn digit_value(c: Int) -> Int =
  if c >= 97 && c <= 122 { c - 97 }
  else if c >= 65 && c <= 90 { c - 65 }
  else if c >= 48 && c <= 57 { c - 22 }
  else { -1 }

/// A number read: `i` plus its value, and the position just past its last digit.
type Number = { i: Int, next: Int }

/// The number whose digits start at `at`, added to `i` with weight `w`. `None` if the digits run
/// out, a character is not a digit, or the number overflows an `Int`.
fn read_number(digits: Array<Int>, at: Int, i: Int, w: Int, k: Int, bias: Int) -> Option<Number> =
  match digits.at(at) {
    None -> None,
    Some(c) -> {
      let d = digit_value(c);
      let t = threshold(k, bias);
      if d < 0 { None } else {
        match checked_mul(d, w) {
          None -> None,
          Some(scaled) -> match checked_add(i, scaled) {
            None -> None,
            Some(sum) -> if d < t { Some({ i: sum, next: at + 1 }) } else {
              match checked_mul(w, 36 - t) {
                None -> None,
                Some(heavier) -> read_number(digits, at + 1, sum, heavier, k + 36, bias),
              }
            },
          },
        }
      }
    },
  }

/// The text read so far as code points, the code point and place the next number counts from,
/// the bias, and where the next number's digits start.
type DecoderState = { out: List<Int>, n: Int, i: Int, bias: Int, next: Int }

/// The text whose Punycode is `encoded`. `None` if `encoded` is not valid Punycode: it contains a
/// character that is not ASCII, a number that is cut short or malformed, or a number that names no
/// character. Also `None` if the result would have more than `max_length` characters.
pub fn decode(encoded: String, max_length: Int) -> Option<String> / {abort.raise} = {
  let chars = encoded.chars().map(Int::of_char);
  let hyphen = range(0, chars.len()).fold(-1, |last: Int, i: Int|
    if chars.at(i) == Some(45) { i } else { last });
  let basic = if hyphen > 0 { chars.take(hyphen) } else { [] };
  let digits = Array::of_list(if hyphen > 0 { chars.drop(hyphen + 1) } else { chars });
  if chars.filter(|c: Int| c >= 128).len() > 0 || basic.len() > max_length { None } else {
    iterate({ out: basic, n: 128, i: 0, bias: 72, next: 0 }, digits.len() + 1, |d: DecoderState|
      if d.next >= digits.len() {
        Stop(
          Some(
            String::of_chars(
              d.out.map(|cp: Int| match Char::of_int(cp) { Some(c) -> c, None -> '\u{FFFD}' }),
            ),
          ),
        )
      } else {
        match read_number(digits, d.next, d.i, 1, 36, d.bias) {
          None -> Stop(None),
          Some(read) -> {
            let count = d.out.len() + 1;
            match checked_add(d.n, read.i / count) {
              None -> Stop(None),
              Some(n) -> if count > max_length || Char::of_int(n) == None { Stop(None) } else {
                let at = read.i % count;
                Continue({
                  out: d.out.take(at).push(n).concat(d.out.drop(at)),
                  n: n,
                  i: at + 1,
                  bias: adapt_bias(read.i - d.i, count, d.i == 0),
                  next: read.next,
                })
              },
            }
          },
        }
      })
  }
}

// --- Properties -------------------------------------------------------------------

test "a text's Punycode reads back as the text" {
  gen::check(gen::text(), |x: String|
    round_trip(encode, |encoded: String| decode(encoded, encoded.len()), x))
}

test "decoding any text returns, and its result encodes and decodes back to itself" {
  gen::check(gen::text(), |text: String| {
    match decode(text, text.len()) {
      None -> true,
      Some(read) -> read.len() <= text.len() && decode(encode(read), text.len()) == Some(read),
    }
  })
}

// --- Tests ------------------------------------------------------------------------

type Sample = { text: String, encoded: String }

/// The sample strings of RFC 3492 section 7.1 whose Punycode is in one case, and a few more.
fn samples() -> List<Sample> =
  [
    {
      text: "\u{644}\u{64A}\u{647}\u{645}\u{627}\u{628}\u{62A}\u{643}\u{644}\u{645}\u{648}\u{634}\u{639}\u{631}\u{628}\u{64A}\u{61F}",
      encoded: "egbpdaj6bu4bxfgehfvwxn",
    },
    {
      text: "\u{4ED6}\u{4EEC}\u{4E3A}\u{4EC0}\u{4E48}\u{4E0D}\u{8BF4}\u{4E2D}\u{6587}",
      encoded: "ihqwcrb4cv8a8dqg056pqjye",
    },
    {
      text: "\u{5DC}\u{5DE}\u{5D4}\u{5D4}\u{5DD}\u{5E4}\u{5E9}\u{5D5}\u{5D8}\u{5DC}\u{5D0}\u{5DE}\u{5D3}\u{5D1}\u{5E8}\u{5D9}\u{5DD}\u{5E2}\u{5D1}\u{5E8}\u{5D9}\u{5EA}",
      encoded: "4dbcagdahymbxekheh6e0a7fei0b",
    },
    {
      text: "3\u{5E74}B\u{7D44}\u{91D1}\u{516B}\u{5148}\u{751F}",
      encoded: "3B-ww4c5e180e575a65lsy2b",
    },
    { text: "-> $1.00 <-", encoded: "-> $1.00 <--" },
    { text: "b\u{FC}cher", encoded: "bcher-kva" },
    { text: "\u{FC}", encoded: "tda" },
    { text: "a", encoded: "a-" },
    { text: "", encoded: "" },
    { text: "\u{1F600}", encoded: "e28h" },
    { text: "a\u{10FFFF}", encoded: "a-h023p" },
    { text: "a-b", encoded: "a-b-" },
  ]

test "{c.encoded} is the Punycode of its text, and reads back as it" for c: Sample in samples() {
  assert_eq(encode(c.text), c.encoded);
  assert_eq(decode(c.encoded, 64), Some(c.text))
}

test "Punycode is read in either case, and written in small letters" {
  assert_eq(decode("BCHER-KVA", 64), Some("B\u{FC}CHER"));
  assert_eq(decode("bcher-KVA", 64), Some("b\u{FC}cher"));
  assert_eq(decode("E1AOEDXV", 64), Some("\u{43F}\u{43E}\u{447}\u{435}\u{43C}\u{443}"));
  assert_eq(encode("\u{43F}\u{43E}\u{447}\u{435}\u{43C}\u{443}"), "e1aoedxv")
}

test "{text} is not Punycode and is rejected" for text: String in [
    "-",
    "\u{FC}",
    "bcher-kv",
    "!",
    "99999999999999999999a",
    "a-\u{20AC}",
  ] { assert_eq(decode(text, 64), None) }

test "a result longer than the maximum length is rejected" {
  assert_eq(decode("bcher-kva", 6), Some("b\u{FC}cher"));
  assert_eq(decode("bcher-kva", 5), None);
  assert_eq(decode("abcdef-", 5), None);
  assert_eq(decode("abcdef-", 6), Some("abcdef"))
}
