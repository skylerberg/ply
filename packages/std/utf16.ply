//! UTF-16: text as sixteen-bit units, and the units as bytes in either order.
//!
//! A character up to `U+FFFF` is one unit and one past it is two, a high surrogate (`0xD800` to
//! `0xDBFF`) and then a low one (`0xDC00` to `0xDFFF`). A `String` holds no surrogate, so every
//! text encodes; units need not decode, since a surrogate may stand without its partner, as one
//! does in a file name or a JavaScript string cut in the wrong place. A strict reader refuses that,
//! saying where; a lossy one answers `U+FFFD` for each such unit and for half a unit at the end,
//! and always answers.
//!
//! Bytes are read in the order the caller names. With `with_byte_order_mark`, a byte-order mark opening the
//! bytes decides instead and is no part of the text, and the named order stands where there is
//! none; without it nothing is looked for, and `U+FEFF` at the start is a character like another.
//! `encode` writes the mark only where asked to.

import std.gen

/// The order of a unit's two bytes.
pub type Order =
  /// The high byte first: UTF-16BE, and the order the standard assumes where nothing says.
  | BigEndian
  /// The low byte first: UTF-16LE, the order of Windows and of most files.
  | LittleEndian

/// Why units or bytes are not UTF-16.
pub type Error =
  /// A surrogate without its partner: the unit, and where it stands, counted in units from the
  /// start of units and in bytes from the start of bytes.
  | Unpaired({ at: Int, unit: Int })
  /// An odd number of bytes: the last one, at `at`, is half a unit.
  | OddLength({ at: Int })

/// How reading UTF-16 fails.
pub effect utf16 {
  /// The units or bytes are not UTF-16.
  raise fail(why: Error)
}

fn is_high(unit: Int) -> Bool = unit >= 0xD800 && unit <= 0xDBFF

fn is_low(unit: Int) -> Bool = unit >= 0xDC00 && unit <= 0xDFFF

/// The units of `text`, in order.
pub fn units(text: String) -> List<Int> =
  text.chars().fold([], |all: List<Int>, c: Char| {
    let cp = Int::of_char(c);
    if cp < 0x10000 { all.push(cp) }
    else { all.push(0xD800 + (cp - 0x10000 >> 10)).push(0xDC00 + (cp - 0x10000 & 0x3FF)) }
  })

/// The code points read so far, the high surrogate waiting for its partner (`-1` for none), and
/// how many units have been read.
type PairState = { out: List<Int>, high: Int, read: Int }

/// The text of `units`, each taken as its low sixteen bits, with the code point `unpaired`
/// answers in place of each surrogate that has no partner, handed where the unit stands and the
/// unit.
fn decode_units<| e>(units: List<Int>, unpaired: (Int, Int) -> Int / e) -> String / e = {
  let done = units.fold({ out: [], high: -1, read: 0 }, |so_far: PairState, wide: Int| {
    let unit = wide & 0xFFFF;
    let at = so_far.read;
    if so_far.high >= 0 && is_low(unit) {
      let cp = 0x10000 + (so_far.high - 0xD800 << 10) + (unit - 0xDC00);
      { out: so_far.out.push(cp), high: -1, read: at + 1 }
    } else {
      let before = if so_far.high >= 0 { so_far.out.push(unpaired(at - 1, so_far.high)) }
      else { so_far.out };
      if is_high(unit) { { out: before, high: unit, read: at + 1 } }
      else if is_low(unit) { { out: before.push(unpaired(at, unit)), high: -1, read: at + 1 } }
      else { { out: before.push(unit), high: -1, read: at + 1 } }
    }
  });
  let points = if done.high >= 0 { done.out.push(unpaired(done.read - 1, done.high)) }
  else { done.out };
  String::of_chars(
    points.fold([], |text: List<Char>, cp: Int|
      match Char::of_int(cp) { Some(c) -> text.push(c), None -> text }),
  )
}

/// The text `units` encode, each unit read as its low sixteen bits. Raises `utf16.fail` at
/// the first surrogate without its partner.
pub fn of_units(units: List<Int>) -> String / {utf16.fail} =
  decode_units(units, |at: Int, unit: Int| utf16.fail(Unpaired({ at: at, unit: unit })))

/// The text `units` encode, with `U+FFFD` for each surrogate without its partner.
pub fn of_units_lossy(units: List<Int>) -> String = decode_units(units, |_: Int, _: Int| 0xFFFD)

fn unit_bytes(unit: Int, order: Order) -> Bytes / {abort.raise} =
  match order {
    BigEndian -> byte_of_int(unit >> 8).concat(byte_of_int(unit & 0xFF)),
    LittleEndian -> byte_of_int(unit & 0xFF).concat(byte_of_int(unit >> 8)),
  }

/// `text` in UTF-16, two bytes a unit in `order`, after a byte-order mark where `with_byte_order_mark` asks for
/// one.
pub fn encode(
  text: String,
  order: Order,
  with_byte_order_mark: Bool = false,
) -> Bytes / {abort.raise} = {
  let body = Bytes::concat_all(units(text).map(|unit: Int| unit_bytes(unit, order)));
  if with_byte_order_mark { unit_bytes(0xFEFF, order).concat(body) } else { body }
}

/// Bytes as the units they hold: the order they are in, where the units start, and the units.
type ReadResult = { order: Order, from: Int, units: List<Int> }

/// The whole units of `bytes`, in the order a mark opening them gives where `with_byte_order_mark` looks for
/// one, and in `order` otherwise.
fn read_units(
  bytes: Bytes,
  order: Order,
  with_byte_order_mark: Bool,
) -> ReadResult / {abort.raise} = {
  let opening = if with_byte_order_mark && bytes.len() >= 2 { bytes.at(0) << 8 | bytes.at(1) }
  else { 0 };
  let found = if opening == 0xFEFF { Some(BigEndian) }
  else if opening == 0xFFFE { Some(LittleEndian) }
  else { None };
  let reading = match found { Some(by_mark) -> by_mark, None -> order };
  let from = if found == None { 0 } else { 2 };
  {
    order: reading,
    from: from,
    units: range(0, (bytes.len() - from) / 2).map(|i: Int| {
      let first = bytes.at(from + 2 * i);
      let second = bytes.at(from + 2 * i + 1);
      match reading { BigEndian -> first << 8 | second, LittleEndian -> second << 8 | first }
    }),
  }
}

/// The text `bytes` hold in UTF-16. Raises `utf16.fail` at the first surrogate without its
/// partner, and for an odd number of bytes; where it raises is counted in bytes from the start.
pub fn read(
  bytes: Bytes,
  order: Order,
  with_byte_order_mark: Bool = false,
) -> String / {utf16.fail, abort.raise} = {
  let held = read_units(bytes, order, with_byte_order_mark);
  let text = decode_units(held.units, |at: Int, unit: Int|
    utf16.fail(Unpaired({ at: held.from + 2 * at, unit: unit })));
  if (bytes.len() - held.from) % 2 == 1 { utf16.fail(OddLength({ at: bytes.len() - 1 })) }
  else { text }
}

/// `read`, answering the refusal instead of raising it.
pub fn decode(
  bytes: Bytes,
  order: Order,
  with_byte_order_mark: Bool = false,
) -> Result<String, Error> / {abort.raise} = try { read(bytes, order, with_byte_order_mark) }

/// The text `bytes` hold in UTF-16, with `U+FFFD` for each surrogate without its partner and for
/// half a unit at the end: every sequence of bytes has an answer.
pub fn lossy(
  bytes: Bytes,
  order: Order,
  with_byte_order_mark: Bool = false,
) -> String / {abort.raise} = {
  let held = read_units(bytes, order, with_byte_order_mark);
  let text = of_units_lossy(held.units);
  if (bytes.len() - held.from) % 2 == 1 { text ++ "\u{FFFD}" } else { text }
}

// --- Properties -------------------------------------------------------------------

test "a text encoded in either order, marked or not, reads back as the text" {
  gen::check3(
    gen::text(),
    gen::bool(),
    gen::bool(),
    |text: String, little: Bool, with_byte_order_mark: Bool| {
      let order = if little { LittleEndian } else { BigEndian };
      // Unmarked, a mark opening the text is the text's own, and reading for one would take it.
      let own = text.starts_with("\u{FEFF}") || text.starts_with("\u{FFFE}");
      decode(encode(text, order, with_byte_order_mark), order, with_byte_order_mark) == Ok(text)
        && (own || with_byte_order_mark
        || decode(encode(text, order), order, with_byte_order_mark: true) == Ok(text))
        && lossy(encode(text, order, with_byte_order_mark), order, with_byte_order_mark) == text
    },
  )
}

test "a strict reading of any bytes answers, and agrees with the lossy one where it is a text" {
  gen::check3(
    gen::bytes(),
    gen::bool(),
    gen::bool(),
    |bytes: Bytes, little: Bool, with_byte_order_mark: Bool| {
      let order = if little { LittleEndian } else { BigEndian };
      match decode(bytes, order, with_byte_order_mark) {
        Ok(text) -> lossy(bytes, order, with_byte_order_mark) == text,
        Err(Unpaired(lone_surrogate_cases)) ->
          lone_surrogate_cases.at >= 0 && lone_surrogate_cases.at < bytes.len()
            && (is_high(lone_surrogate_cases.unit) || is_low(lone_surrogate_cases.unit)),
        Err(OddLength(half)) -> half.at == bytes.len() - 1,
      }
    },
  )
}

// --- Tests ------------------------------------------------------------------------

test "a character past U+FFFF is a surrogate pair, and any other is its own unit" {
  assert_eq(units("a\u{E9}\u{4E2D}"), [0x61, 0xE9, 0x4E2D]);
  assert_eq(units("\u{10000}\u{1F600}\u{10FFFF}"), [
    0xD800,
    0xDC00,
    0xD83D,
    0xDE00,
    0xDBFF,
    0xDFFF,
  ]);
  assert_eq(units("\u{FFFF}\u{D7FF}\u{E000}"), [0xFFFF, 0xD7FF, 0xE000]);
  assert_eq(try { of_units([0xD83D, 0xDE00, 0x61]) }, Ok("\u{1F600}a"));
  assert_eq(units(""), [])
}

type LoneSurrogateCase = { units: List<Int>, at: Int, lossy: String }

fn lone_surrogate_cases() -> List<LoneSurrogateCase> =
  [
    { units: [0xD800], at: 0, lossy: "\u{FFFD}" },
    { units: [0xDC00], at: 0, lossy: "\u{FFFD}" },
    { units: [0x61, 0xD83D], at: 1, lossy: "a\u{FFFD}" },
    { units: [0x61, 0xDE00, 0x62], at: 1, lossy: "a\u{FFFD}b" },
    { units: [0xD83D, 0x62], at: 0, lossy: "\u{FFFD}b" },
    { units: [0xD83D, 0xD83D, 0xDE00], at: 0, lossy: "\u{FFFD}\u{1F600}" },
    { units: [0xDE00, 0xD83D], at: 0, lossy: "\u{FFFD}\u{FFFD}" },
    { units: [0xD83D, 0xDE00, 0xDE00], at: 2, lossy: "\u{1F600}\u{FFFD}" },
  ]

test "a surrogate without its partner at {c.at} of {c.units} is refused there, and lossily is U+FFFD" for c: LoneSurrogateCase in lone_surrogate_cases(
  ) {
  let unit = match c.units.at(c.at) { Some(u) -> u, None -> -1 };
  assert_eq(try { of_units(c.units) }, Err(Unpaired({ at: c.at, unit: unit })));
  assert_eq(of_units_lossy(c.units), c.lossy);
  let bytes = Bytes::concat_all(c.units.map(|u: Int| unit_bytes(u, LittleEndian)));
  assert_eq(decode(bytes, LittleEndian), Err(Unpaired({ at: 2 * c.at, unit: unit })));
  assert_eq(lossy(bytes, LittleEndian), c.lossy)
}

test "bytes are read in the order named, or in the order a mark gives where one is looked for" {
  assert_eq(encode("a\u{1F600}", BigEndian), b"\x00a\xd8\x3d\xde\x00");
  assert_eq(encode("a\u{1F600}", LittleEndian), b"a\x00\x3d\xd8\x00\xde");
  assert_eq(encode("a", LittleEndian, with_byte_order_mark: true), b"\xff\xfea\x00");
  assert_eq(encode("a", BigEndian, with_byte_order_mark: true), b"\xfe\xff\x00a");
  assert_eq(decode(b"\xff\xfea\x00", BigEndian, with_byte_order_mark: true), Ok("a"));
  assert_eq(decode(b"\xfe\xff\x00a", LittleEndian, with_byte_order_mark: true), Ok("a"));
  assert_eq(decode(b"\x00a", BigEndian, with_byte_order_mark: true), Ok("a"));
  assert_eq(decode(b"\xfe\xff\x00a", BigEndian), Ok("\u{FEFF}a"));
  assert_eq(decode(b"", LittleEndian, with_byte_order_mark: true), Ok(""));
  assert_eq(decode(b"\xff\xfe", LittleEndian, with_byte_order_mark: true), Ok(""))
}

test "an odd number of bytes is refused at the last, and lossily ends in U+FFFD" {
  assert_eq(decode(b"a\x00b", LittleEndian), Err(OddLength({ at: 2 })));
  assert_eq(decode(b"a", BigEndian, with_byte_order_mark: true), Err(OddLength({ at: 0 })));
  assert_eq(lossy(b"a\x00b", LittleEndian), "a\u{FFFD}");
  assert_eq(decode(b"\x00\xd8b", LittleEndian), Err(Unpaired({ at: 0, unit: 0xD800 })));
  assert_eq(lossy(b"\x00\xd8b", LittleEndian), "\u{FFFD}\u{FFFD}")
}
