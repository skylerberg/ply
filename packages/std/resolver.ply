//! A stub resolver: it sends one question to a DNS server over UDP, and again over TCP when the
//! response was truncated.
//!
//! `dns.lookup` queries the system's resolver, which returns addresses and nothing else. This
//! module queries the records that mail and service discovery need (MX, TXT, SRV), and those behind
//! an address (CNAME, PTR, NS). `resolve` sends a question to each of the servers it is given in
//! turn, going round the list `attempts` times. Each exchange must finish within `timeout_ms`
//! milliseconds, measured by the `clock` effect. It returns the records of the requested kind, each
//! with its time to live. `resolve_system` queries the servers `dns.servers` lists. A question's id
//! is drawn from `entropy`. A response is accepted only when it comes from the server queried,
//! carries that id, and repeats the question, so a datagram from anywhere else is ignored and does
//! not extend the wait. A response too long for a datagram is marked truncated, and is requested
//! again over TCP.
//!
//! A failure is `std.dns`'s `Failure`: `NoSuchName` when the server reports that the name does not
//! exist, `NoData` when it exists but has no records of the kind, `ServerFailure` when every server
//! that responded rejected the query or failed, and `TimedOut` when none responded.
//!
//! This module also has the message format, `encode` and `decode`, and neither raises. A message
//! that does not parse decodes to `None`. A name that uses compression pointers follows at most as
//! many pointers as the name could have labels, so a loop of pointers ends. Nothing past the answer
//! section is read. With these, a test's server is a function from a question to a response, and
//! `std.udp`'s fake runs that function under the loss, duplication and reordering that a network
//! can cause.

import std.bytes (u16_be, u32_be)
import std.dns
import std.dns (Failure, NoData, NoSuchName, ServerFailure, TimedOut, dns)
import std.ip
import std.ip (Ip, SocketAddress, V4, V6, ip)
import std.list
import std.net
import std.net (Expects, MemNet, Error, Sends, ms_left, net, send_all)
import std.random (entropy, rand, rand_below, with_rand)
import std.string
import std.time (after, millis)
import std.udp
import std.udp (Dropped, MemUdp, udp)

/// The kind of record a question asks for.
pub type Kind =
  /// An IPv4 address.
  | A
  /// An IPv6 address.
  | Aaaa
  /// The name this one is an alias of.
  | Cname
  /// The hosts that take mail for the name.
  | Mx
  /// Text stored at the name.
  | Txt
  /// Where a service of the name is: `_service._proto.name`.
  | Srv
  /// A reverse lookup of an IP address: the name queried is the address written under
  /// `in-addr.arpa` (IPv4) or `ip6.arpa` (IPv6), and the data is a host name.
  | Ptr
  /// The servers authoritative for the name.
  | Ns

/// The data of an SRV record, which says where a service runs. Clients try the lowest `priority`
/// first. Among targets with equal priority, a client picks one at random, with probability
/// proportional to `weight`.
pub type Service = { priority: Int, weight: Int, port: Int, target: String }

/// The data of one record.
pub type Data =
  /// An address, from an A or an AAAA record.
  | Address(Ip)
  /// The name a CNAME record aliases.
  | Alias(String)
  /// An MX record's preference, lower first, and its host.
  | Exchange(Int, String)
  /// The strings of a TXT record, each at most 255 bytes, exactly as they appear in the record.
  /// They are not joined or decoded.
  | Text(List<Bytes>)
  /// An SRV record.
  | ServiceLocation(Service)
  /// The name a PTR record points to.
  | Pointer(String)
  /// The server an NS record names.
  | NameServer(String)
  /// A record of a type this module does not decode: its type number, and its data bytes unchanged.
  | Opaque(Int, Bytes)

/// One record: the name it is for, its time to live, and its data.
pub type Record = { name: String, ttl: Duration, data: Data }

/// The question a message asks: the name to look up and the kind of record wanted.
pub type Question = { name: String, kind: Kind }

/// A DNS message with the fields a stub resolver uses: its id, whether it is a response, whether it
/// was truncated to fit a datagram, whether recursion is requested, its response code, its
/// question, and its answer section.
pub type Message = {
  id: Int,
  response: Bool,
  truncated: Bool,
  recursion_desired: Bool,
  code: Int,
  question: Option<Question>,
  answers: List<Record>,
}

fn kind_code(kind: Kind) -> Int =
  match kind { A -> 1, Ns -> 2, Cname -> 5, Ptr -> 12, Mx -> 15, Txt -> 16, Aaaa -> 28, Srv -> 33 }

fn kind_of_code(code: Int) -> Option<Kind> =
  if code == 1 { Some(A) }
  else if code == 2 { Some(Ns) }
  else if code == 5 { Some(Cname) }
  else if code == 12 { Some(Ptr) }
  else if code == 15 { Some(Mx) }
  else if code == 16 { Some(Txt) }
  else if code == 28 { Some(Aaaa) }
  else if code == 33 { Some(Srv) }
  else { None }

fn data_code(data: Data) -> Int =
  match data {
    Address(V4(_)) -> 1,
    Address(V6(_)) -> 28,
    Alias(_) -> 5,
    Exchange(_, _) -> 15,
    Text(_) -> 16,
    ServiceLocation(_) -> 33,
    Pointer(_) -> 12,
    NameServer(_) -> 2,
    Opaque(code, _) -> code,
  }

fn name_bytes(name: String) -> Option<Bytes> / {abort.raise} = {
  let bare = if name.ends_with(".") { name.slice(0, name.len() - 1) } else { name };
  if bare == "" { Some(b"\x00") } else {
    let labels = bare.split(".").map(Bytes::of_string);
    if Bytes::of_string(bare).len() > 253
        || !labels.all(|label: Bytes| label.len() > 0 && label.len() <= 63) { None } else {
      Some(
        Bytes::concat_all(labels.map(|label: Bytes| byte_of_int(label.len()).concat(label))).concat(
          b"\x00",
        ),
      )
    }
  }
}

fn data_bytes(data: Data) -> Option<Bytes> / {abort.raise} =
  match data {
    Address(address) -> Some(ip::to_bytes(address)),
    Alias(name) -> name_bytes(name),
    Pointer(name) -> name_bytes(name),
    NameServer(name) -> name_bytes(name),
    Exchange(preference, host) -> {
      let to = name_bytes(host)?;
      if preference < 0 || preference > 65535 { None } else { Some(u16_be(preference).concat(to)) }
    },
    Text(strings) -> if !strings.all(|s: Bytes| s.len() <= 255) { None }
    else { Some(Bytes::concat_all(strings.map(|s: Bytes| byte_of_int(s.len()).concat(s)))) },
    ServiceLocation(s) -> {
      let target = name_bytes(s.target)?;
      if ![s.priority, s.weight, s.port].all(|n: Int| n >= 0 && n <= 65535) { None } else {
        Some(Bytes::concat_all([u16_be(s.priority), u16_be(s.weight), u16_be(s.port), target]))
      }
    },
    Opaque(_, bytes) -> Some(bytes),
  }

fn record_bytes(r: Record) -> Option<Bytes> / {abort.raise} = {
  let owner = name_bytes(r.name)?;
  let data = data_bytes(r.data)?;
  let seconds = match r.ttl { Duration(nanos) -> nanos / 1000000000 };
  if seconds < 0 || seconds > 4294967295 || data.len() > 65535 { None } else {
    Some(
      Bytes::concat_all([
        owner,
        u16_be(data_code(r.data)),
        u16_be(1),
        u32_be(seconds),
        u16_be(data.len()),
        data,
      ]),
    )
  }
}

fn question_bytes(request: Option<Question>) -> Option<Bytes> / {abort.raise} =
  match request {
    None -> Some(b""),
    Some(q) -> {
      let name = name_bytes(q.name)?;
      Some(Bytes::concat_all([name, u16_be(kind_code(q.kind)), u16_be(1)]))
    },
  }

fn flags_of(m: Message) -> Int =
  (if m.response { 0x8000 } else { 0 }) | (if m.truncated { 0x0200 } else { 0 })
    | (if m.recursion_desired { 0x0100 } else { 0 })
    | m.code & 15

/// Returns the message in DNS wire format, writing every name in full without compression pointers.
/// Returns `None` when the message cannot be sent: the id or a count does not fit in sixteen bits,
/// or a name or string is longer than the format allows.
pub fn encode(m: Message) -> Option<Bytes> / {abort.raise} = {
  let request = question_bytes(m.question)?;
  let answers = m.answers.fold(Some([]), |so_far: Option<List<Bytes>>, r: Record|
    match so_far {
      None -> None,
      Some(parts) -> match record_bytes(r) { Some(bytes) -> Some(parts.push(bytes)), None -> None },
    })?;
  if m.id < 0 || m.id > 65535 || answers.len() > 65535 { None } else {
    Some(
      Bytes::concat_all([
        u16_be(m.id),
        u16_be(flags_of(m)),
        u16_be(if m.question == None { 0 } else { 1 }),
        u16_be(answers.len()),
        u16_be(0),
        u16_be(0),
        request,
        Bytes::concat_all(answers),
      ]),
    )
  }
}

/// The question for `name` and `kind`, under `id`, asking the server to recurse.
pub fn question(id: Int, name: String, kind: Kind) -> Message =
  {
    id: id,
    response: false,
    truncated: false,
    recursion_desired: true,
    code: 0,
    question: Some({ name: name, kind: kind }),
    answers: [],
  }

/// Returns the response to `request` with response code `code` and the records `answers`, as a
/// server would send it.
pub fn response(request: Message, code: Int, answers: List<Record>) -> Message =
  { ..request, response: true, code: code, answers: answers }

const name_steps: Int = 128

type ParsedName = { name: String, next: Int }

fn name_at(b: Bytes, at: Int) -> Option<ParsedName> = labels_from(b, at, [], None, name_steps)

fn labels_from(
  b: Bytes,
  at: Int,
  labels: List<String>,
  resume: Option<Int>,
  steps: Int,
) -> Option<ParsedName> =
  if steps <= 0 || at < 0 || at >= b.len() { None } else {
    let n = b.at(at);
    if n == 0 {
      Some({
        name: String::join(labels, "."),
        next: match resume { Some(after) -> after, None -> at + 1 },
      })
    } else if n >= 192 {
      if at + 1 >= b.len() { None } else {
        labels_from(
          b,
          (n - 192) * 256 + b.at(at + 1),
          labels,
          match resume { Some(after) -> Some(after), None -> Some(at + 2) },
          steps - 1,
        )
      }
    } else if n > 63 || at + 1 + n > b.len() { None } else {
      labels_from(
        b,
        at + 1 + n,
        labels.push(String::of_bytes_lossy(b.slice(at + 1, at + 1 + n))),
        resume,
        steps - 1,
      )
    }
  }

fn strings_between(b: Bytes, start: Int, end: Int) -> Option<List<Bytes>> / {abort.raise} =
  iterate({ at: start, found: [] }, max(end - start, 0) + 2, |s: { at: Int, found: List<Bytes> }|
    if s.at == end { Stop(Some(s.found)) }
    else if s.at > end { Stop(None) } else {
      let n = b.at(s.at);
      if s.at + 1 + n > end { Stop(None) }
      else { Continue({ at: s.at + 1 + n, found: s.found.push(b.slice(s.at + 1, s.at + 1 + n)) }) }
    })

fn data_between(b: Bytes, code: Int, start: Int, end: Int) -> Option<Data> / {abort.raise} =
  if code == 1 || code == 28 {
    if end - start != (if code == 1 { 4 } else { 16 }) { None }
    else { Some(Address(ip::of_bytes(b.slice(start, end))?)) }
  } else if code == 5 { Some(Alias(name_ending(b, start, end)?)) }
  else if code == 12 { Some(Pointer(name_ending(b, start, end)?)) }
  else if code == 2 { Some(NameServer(name_ending(b, start, end)?)) }
  else if code == 15 { Some(Exchange(b.u16_be_at(start)?, name_ending(b, start + 2, end)?)) }
  else if code == 16 { Some(Text(strings_between(b, start, end)?)) } else if code == 33 {
    Some(
      ServiceLocation({
        priority: b.u16_be_at(start)?,
        weight: b.u16_be_at(start + 2)?,
        port: b.u16_be_at(start + 4)?,
        target: name_ending(b, start + 6, end)?,
      }),
    )
  } else { Some(Opaque(code, b.slice(start, end))) }

fn name_ending(b: Bytes, from: Int, end: Int) -> Option<String> = {
  let read = name_at(b, from)?;
  if from < end && read.next == end { Some(read.name) } else { None }
}

type ParsedRecord = { record: Record, next: Int }

fn record_at(b: Bytes, at: Int) -> Option<ParsedRecord> / {abort.raise} = {
  let owner = name_at(b, at)?;
  let code = b.u16_be_at(owner.next)?;
  let seconds = b.u32_be_at(owner.next + 4)?;
  let size = b.u16_be_at(owner.next + 8)?;
  let start = owner.next + 10;
  if start + size > b.len() { None } else {
    let data = data_between(b, code, start, start + size)?;
    Some({
      record: { name: owner.name, ttl: Duration(seconds * 1000000000), data: data },
      next: start + size,
    })
  }
}

fn records_from(
  b: Bytes,
  at: Int,
  left: Int,
  found: List<Record>,
) -> Option<List<Record>> / {abort.raise} =
  if left <= 0 { Some(found) } else {
    let read = record_at(b, at)?;
    records_from(b, read.next, left - 1, found.push(read.record))
  }

type ParsedQuestion = { question: Option<Question>, next: Int }

fn question_at(b: Bytes, count: Int) -> Option<ParsedQuestion> =
  if count == 0 { Some({ question: None, next: 12 }) }
  else if count != 1 { None } else {
    let named = name_at(b, 12)?;
    let kind = kind_of_code(b.u16_be_at(named.next)?)?;
    let _class = b.u16_be_at(named.next + 2)?;
    Some({ question: Some({ name: named.name, kind: kind }), next: named.next + 4 })
  }

/// Parses the message in `b`: its header, its one question, and its answer section. Returns `None`
/// if the bytes are not a message, the message has more than one question, or the question asks for
/// a kind of record this module does not support.
pub fn decode(b: Bytes) -> Option<Message> / {abort.raise} = {
  let id = b.u16_be_at(0)?;
  let flags = b.u16_be_at(2)?;
  let request = question_at(b, b.u16_be_at(4)?)?;
  let answers = records_from(b, request.next, b.u16_be_at(6)?, [])?;
  let _rest = b.u32_be_at(8)?;
  Some({
    id: id,
    response: flags & 0x8000 != 0,
    truncated: flags & 0x0200 != 0,
    recursion_desired: flags & 0x0100 != 0,
    code: flags & 15,
    question: request.question,
    answers: answers,
  })
}

fn of_kind(data: Data, kind: Kind) -> Bool = kind_of_code(data_code(data)) == Some(kind)

fn responds_to(m: Message, request: Message) -> Bool / {abort.raise} =
  m.response && m.id == request.id
    && (match m.question {
      Some(theirs) -> match request.question {
        Some(ours) -> theirs.kind == ours.kind && same_name(theirs.name, ours.name),
        None -> false,
      },
      None -> false,
    })

fn same_name(a: String, b: String) -> Bool / {abort.raise} =
  without_trailing_dot(a).eq_ignore_ascii_case(without_trailing_dot(b))

fn without_trailing_dot(name: String) -> String / {abort.raise} =
  if name.ends_with(".") { name.slice(0, name.len() - 1) } else { name }

fn max_stray_datagrams() -> Int = 8

fn receive_result<[l]>(
  socket: Int,
  server: SocketAddress,
  request: Message,
  end: Instant,
) -> Option<Message> / {udp.recv_from[l], clock.read, abort.raise} =
  iterate(0, max_stray_datagrams() + 1, |read: Int|
    if read >= max_stray_datagrams() { Stop(None) } else {
      match ms_left(end) {
        None -> Stop(None),
        Some(left) -> match udp.recv_from[l](socket, 65535, left) {
          Err(_) -> Stop(None),
          Ok(d) -> if d.from != server { Continue(read + 1) } else {
            match decode(d.payload) {
              Some(m) -> if responds_to(m, request) { Stop(Some(m)) } else { Continue(read + 1) },
              None -> Continue(read + 1),
            }
          },
        },
      }
    })

fn exchange_over_udp<[l]>(
  server: SocketAddress,
  request: Message,
  query: Bytes,
  end: Instant,
) -> Option<Message> / {udp.bind[l], udp.send_to[l], udp.recv_from[l], udp.close[l], clock.read, abort.raise} =
  bracket(
    || udp.bind[l](ip::socket_at(ip::unspecified_like(ip::socket_ip(server)), 0), []),
    |opened: Result<Int, Error>| match opened { Ok(socket) -> udp.close[l](socket), Err(_) -> () },
    |opened: Result<Int, Error>|
      match opened {
        Err(_) -> None,
        Ok(socket) -> match ms_left(end) {
          None -> None,
          Some(left) -> match udp.send_to[l](socket, server, query, left) {
            Err(_) -> None,
            Ok(_) -> receive_result[l](socket, server, request, end),
          },
        },
      },
  )

fn read_exactly<[k]>(
  connection: Int,
  n: Int,
  end: Instant,
) -> Option<Bytes> / {net.recv[k], clock.read, abort.raise} =
  iterate(b"", n + 1, |got: Bytes|
    if got.len() >= n { Stop(Some(got)) } else {
      match ms_left(end) {
        None -> Stop(None),
        Some(left) -> match net.recv[k](connection, n - got.len(), left) {
          None -> Stop(None),
          Some(more) -> if more.len() == 0 { Stop(None) } else { Continue(got.concat(more)) },
        },
      }
    })

fn exchange_over_tcp<[k]>(
  server: SocketAddress,
  request: Message,
  query: Bytes,
  end: Instant,
) -> Option<Message> / {net.connect_to[k], net.send[k], net.recv[k], net.close[k], clock.read, abort.raise} =
  match ms_left(end) {
    None -> None,
    Some(left) ->
      bracket(
        || net.connect_to[k](server, [], left),
        |opened: Result<Int, Error>|
          match opened { Ok(connection) -> net.close[k](connection), Err(_) -> () },
        |opened: Result<Int, Error>|
          match opened {
            Ok(connection) -> exchange_on_connection[k](connection, request, query, end),
            Err(_) -> None,
          },
      ),
  }

fn exchange_on_connection<[k]>(
  connection: Int,
  request: Message,
  query: Bytes,
  end: Instant,
) -> Option<Message> / {net.send[k], net.recv[k], clock.read, abort.raise} = {
  let left = ms_left(end)?;
  if !send_all[k](connection, u16_be(query.len()).concat(query), left) { None } else {
    let size = read_exactly[k](connection, 2, end)?.u16_be_at(0)?;
    let m = decode(read_exactly[k](connection, size, end)?)?;
    if responds_to(m, request) { Some(m) } else { None }
  }
}

fn deadline_after(timeout_ms: Int) -> Instant / {clock.read} =
  after(clock.now(), millis(timeout_ms))

/// Returns the records of `kind` at `name`, querying `servers` in turn and going through the whole
/// list `attempts` times. `timeout_ms` is the time limit of each exchange, over a datagram or a
/// connection; datagrams that do not answer the question do not extend it. `l` is the effect label
/// of the datagram sockets, and `k` is the label of the TCP connection used to retry a truncated
/// response. Returns the same failure as `dns.lookup` for a name that is not ASCII. Panics if
/// `timeout_ms <= 0`.
pub fn resolve<[l], [k]>(
  servers: List<SocketAddress>,
  name: String,
  kind: Kind,
  attempts: Int,
  timeout_ms: Int,
) -> Result<List<Record>, Failure> / {udp.bind[l], udp.send_to[l], udp.recv_from[l], udp.close[l], net.connect_to[k], net.send[k], net.recv[k], net.close[k], entropy.below, clock.read, abort.raise} = {
  let tries = max(attempts, 0) * servers.len();
  if timeout_ms <= 0 {
    panic(
      "`resolver::resolve` was given a timeout of " ++ timeout_ms.to_string() ++ " milliseconds",
    )
  } else if !name.is_ascii() { Err(dns::not_ascii) } else if name_bytes(name) == None {
    Err(
      dns::Other(
        0,
        "each label of a name must be 1 to 63 bytes, and the whole name at most 253 bytes",
      ),
    )
  } else if servers.len() == 0 { Err(dns::Other(0, "there is no server to ask")) } else {
    iterate({ tried: 0, worst: TimedOut }, tries + 1, |s: { tried: Int, worst: Failure }|
      if s.tried >= tries { Stop(Err(s.worst)) } else {
        match servers.at(s.tried % servers.len()) {
          None -> Stop(Err(s.worst)),
          Some(server) -> {
            let request = question(entropy.below(65536), name, kind);
            let reply = match encode(request) {
              None -> None,
              Some(query) -> match exchange_over_udp[l](
                  server,
                  request,
                  query,
                  deadline_after(timeout_ms),
                ) {
                Some(m) -> if m.truncated {
                  exchange_over_tcp[k](server, request, query, deadline_after(timeout_ms))
                } else { Some(m) },
                None -> None,
              },
            };
            match reply {
              None -> Continue({ tried: s.tried + 1, worst: s.worst }),
              Some(m) -> if m.code == 3 { Stop(Err(NoSuchName)) }
              else if m.code != 0 { Continue({ tried: s.tried + 1, worst: ServerFailure }) } else {
                let found = m.answers.filter(|r: Record| of_kind(r.data, kind));
                Stop(if found.len() == 0 { Err(NoData) } else { Ok(found) })
              },
            }
          },
        }
      })
  }
}

/// Calls `resolve` with the servers the system's resolver is configured to use.
pub fn resolve_system<[l], [k]>(
  name: String,
  kind: Kind,
  attempts: Int,
  timeout_ms: Int,
) -> Result<List<Record>, Failure> / {dns.servers, udp.bind[l], udp.send_to[l], udp.recv_from[l], udp.close[l], net.connect_to[k], net.send[k], net.recv[k], net.close[k], entropy.below, clock.read, abort.raise} =
  resolve[l, k](dns.servers(), name, kind, attempts, timeout_ms)

/// The addresses among `records`, each with its time to live, in the order they came.
pub fn addresses(records: List<Record>) -> List<dns::ResolvedAddress> =
  records.fold([], |found: List<dns::ResolvedAddress>, r: Record|
    match r.data {
      Address(address) -> found.push({ address: address, ttl: Some(r.ttl) }),
      _ -> found,
    })

/// The mail exchanges among `records`, the most preferred first.
pub fn mail_exchanges(records: List<Record>) -> List<{ preference: Int, host: String }> =
  records.fold([], |found: List<{ preference: Int, host: String }>, r: Record|
    match r.data {
      Exchange(preference, host) -> found.push({ preference: preference, host: host }),
      _ -> found,
    }).sort_by(|a: { preference: Int, host: String }, b: { preference: Int, host: String }|
    a.preference < b.preference)

/// Returns the text of each TXT record among `records`, with its strings joined into one value.
/// Long values, such as SPF policies and verification tokens, are split into several strings of at
/// most 255 bytes, and a reader of them wants them joined.
pub fn texts(records: List<Record>) -> List<Bytes> =
  records.fold([], |found: List<Bytes>, r: Record|
    match r.data { Text(strings) -> found.push(Bytes::concat_all(strings)), _ -> found })

/// The services among `records`, the lowest priority first.
pub fn services(records: List<Record>) -> List<Service> =
  records.fold([], |found: List<Service>, r: Record|
    match r.data { ServiceLocation(s) -> found.push(s), _ -> found }).sort_by(
    |a: Service, b: Service| a.priority < b.priority,
  )

fn encode_or_panic(m: Message) -> Bytes / {abort.raise} =
  match encode(m) { Some(bytes) -> bytes, None -> panic("the test message cannot be encoded") }

fn test_record(name: String, seconds: Int, data: Data) -> Record =
  { name: name, ttl: Duration(seconds * 1000000000), data: data }

test "`encode` writes a DNS question as the DNS wire format, and fails for an invalid name or an id above 65535" {
  assert_eq(
    encode(question(0x1234, "example.com", A)),
    Some(b"\x12\x34\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00\x07example\x03com\x00\x00\x01\x00\x01"),
  );
  assert_eq(encode(question(7, "example.com.", Mx)), encode(question(7, "example.com", Mx)));
  assert_eq(encode(question(7, "a..b", A)), None);
  assert_eq(encode(question(65536, "example.com", A)), None)
}

test "`decode` parses a DNS response whose names use compression pointers back to earlier names" {
  let b = Bytes::concat_all([
    b"\x12\x34\x81\x80\x00\x01\x00\x01\x00\x00\x00\x00",
    b"\x07example\x03com\x00\x00\x0f\x00\x01",
    b"\xc0\x0c\x00\x0f\x00\x01\x00\x00\x01\x2c\x00\x09\x00\x0a\x04mail\xc0\x0c",
  ]);
  assert_eq(
    decode(b),
    Some({
      id: 0x1234,
      response: true,
      truncated: false,
      recursion_desired: true,
      code: 0,
      question: Some({ name: "example.com", kind: Mx }),
      answers: [test_record("example.com", 300, Exchange(10, "mail.example.com"))],
    }),
  )
}

test "`decode` of an encoded response returns every kind of record unchanged" {
  let m = response(question(9, "example.org", Txt), 0, [
    test_record("example.org", 60, Address(ip::read("192.0.2.1"))),
    test_record("example.org", 60, Address(ip::read("2001:db8::1"))),
    test_record("www.example.org", 3600, Alias("example.org")),
    test_record("example.org", 300, Exchange(10, "mail.example.org")),
    test_record("example.org", 300, Text([b"v=spf1 -all", b""])),
    test_record(
      "_imaps._tcp.example.org",
      0,
      ServiceLocation({ priority: 1, weight: 2, port: 993, target: "imap.example.org" }),
    ),
    test_record("1.2.0.192.in-addr.arpa", 86400, Pointer("example.org")),
    test_record("example.org", 172800, NameServer("ns1.example.org")),
    test_record("", 5, Opaque(99, b"\x01\x02")),
  ]);
  assert_eq(decode(encode_or_panic(m)), Some(m));
  let cut = { ..m, truncated: true, code: 2, answers: [] };
  assert_eq(decode(encode_or_panic(cut)), Some(cut))
}

const single_question_header: Bytes = b"\x00\x01\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00"

const returning_one: Bytes = b"\x00\x01\x81\x80\x00\x01\x00\x01\x00\x00\x00\x00"

test "`decode` returns `None` for a malformed DNS message: {c.what}" for c: { what: String, bytes: Bytes } in [
    { what: "a header cut short", bytes: b"\x12\x34\x01\x00\x00\x01" },
    {
      what: "a name that points at itself",
      bytes: single_question_header.concat(b"\xc0\x0c\x00\x01\x00\x01"),
    },
    {
      what: "a label that runs past the end",
      bytes: single_question_header.concat(b"\x3fexample"),
    },
    {
      what: "two questions",
      bytes: b"\x00\x01\x01\x00\x00\x02\x00\x00\x00\x00\x00\x00\x01a\x00\x00\x01\x00\x01\x01b\x00\x00\x01\x00\x01",
    },
    {
      what: "a question of a kind not read here",
      bytes: single_question_header.concat(b"\x01a\x00\x00\xff\x00\x01"),
    },
    {
      what: "a result counted and not there",
      bytes: returning_one.concat(b"\x01a\x00\x00\x01\x00\x01"),
    },
    {
      what: "an address of five bytes",
      bytes: returning_one.concat(
        b"\x01a\x00\x00\x01\x00\x01\xc0\x0c\x00\x01\x00\x01\x00\x00\x00\x05\x00\x05\x01\x02\x03\x04\x05",
      ),
    },
    {
      what: "a name that ends short of its record",
      bytes: returning_one.concat(
        b"\x01a\x00\x00\x05\x00\x01\xc0\x0c\x00\x05\x00\x01\x00\x00\x00\x05\x00\x04\xc0\x0c\x00\x00",
      ),
    },
    {
      what: "a string that runs past its record",
      bytes: returning_one.concat(
        b"\x01a\x00\x00\x10\x00\x01\xc0\x0c\x00\x10\x00\x01\x00\x00\x00\x05\x00\x02\x05a",
      ),
    },
  ] { assert_eq(decode(c.bytes), None) }

fn server() -> SocketAddress / {ip.fail, abort.raise} = ip::read_socket("192.0.2.53:53")

fn second() -> SocketAddress / {ip.fail, abort.raise} = ip::read_socket("192.0.2.54:53")

const mail: List<Record> =
  [
    test_record("example.org", 300, Exchange(20, "backup.example.org")),
    test_record("example.org", 300, Exchange(10, "mail.example.org")),
  ]

fn replies(query: Bytes, code: Int, records: List<Record>) -> List<Bytes> / {abort.raise} =
  match decode(query) {
    Some(request) -> [encode_or_panic(response(request, code, records))],
    None -> [],
  }

fn mail_server(query: Bytes) -> List<Bytes> / {abort.raise} = replies(query, 0, mail)

fn failing_server(query: Bytes) -> List<Bytes> / {abort.raise} = replies(query, 2, [])

type RunResult = { result: Result<List<Record>, Failure>, udp: MemUdp, net: MemNet }

fn resolve_over(
  datagrams: MemUdp,
  streams: MemNet,
  servers: List<SocketAddress>,
  kind: Kind,
  attempts: Int,
  seed: Int,
) -> RunResult / {clock.read, abort.raise} = {
  let ran = net::on_mem(streams, ||
    udp::on_mem(datagrams, ||
      with_rand(rand(seed), ||
        resolve[lookup, fallback](servers, "example.org", kind, attempts, 500)).value));
  { result: ran.value.value, udp: ran.value.udp, net: ran.net }
}

test "a name's mail exchanges are queried and come back with their time to live" {
  simulate {
    let world = udp::mem_with_responder(udp::mem_empty(), server(), mail_server);
    let ran = resolve_over(world, net::mem_empty(), [server()], Mx, 1, 7);
    assert_eq(ran.result, Ok(mail));
    assert_eq(mail_exchanges(mail), [
      { preference: 10, host: "mail.example.org" },
      { preference: 20, host: "backup.example.org" },
    ]);
    assert_eq(ran.udp.applied_fates.len(), 2);
    assert_eq(ran.udp.closed, [1])
  }
}

test "a question that is lost is sent again, as often as allowed and no more" {
  simulate {
    let world = udp::mem_with_fates(
      udp::mem_with_responder(udp::mem_empty(), server(), mail_server),
      [Dropped, Dropped],
    );
    assert_eq(resolve_over(world, net::mem_empty(), [server()], Mx, 3, 7).result, Ok(mail));
    assert_eq(resolve_over(world, net::mem_empty(), [server()], Mx, 2, 7).result, Err(TimedOut))
  }
}

fn stray_replies(max_stray_datagrams: Int, query: Bytes) -> List<Bytes> / {abort.raise} =
  match decode(query) {
    Some(request) -> {
      let other = { ..request, id: (request.id + 1) % 65536 };
      let elsewhere = response(question(request.id, "example.net", Mx), 0, [
        test_record("example.net", 300, Exchange(0, "mallory.example")),
      ]);
      range(0, max_stray_datagrams).map(|i: Int|
        if i % 2 == 0 {
          encode_or_panic(
            response(other, 0, [test_record("example.org", 300, Exchange(0, "mallory.example"))]),
          )
        } else { encode_or_panic(elsewhere) }).push(
        encode_or_panic(response(request, 0, mail)),
      )
    },
    None -> [],
  }

test "a response with a different id is ignored, and the response that matches the question is used" {
  simulate {
    let world = udp::mem_with_responder(udp::mem_empty(), server(), |query: Bytes|
      stray_replies(2, query));
    assert_eq(resolve_over(world, net::mem_empty(), [server()], Mx, 1, 7).result, Ok(mail))
  }
}

fn arriving<a | e>(
  each: Duration,
  go: () -> a / {udp.recv_from[lookup] | e},
) -> a / {udp.recv_from[lookup], clock.write | e} =
  handle {
    go()
  } with {
    udp.recv_from[lookup](socket, most, timeout_ms) -> {
      clock.sleep(each);
      udp.recv_from[lookup](socket, most, timeout_ms)
    },
  }

test "datagrams that are not the response do not extend the wait for it" {
  simulate {
    let world = udp::mem_with_responder(udp::mem_empty(), server(), |query: Bytes|
      stray_replies(3, query));
    let request = |timeout_ms: Int|
      net::on_mem(net::mem_empty(), ||
        udp::on_mem(world, ||
          with_rand(rand(7), ||
            arriving(millis(200), ||
              resolve[lookup, fallback](
                [server()],
                "example.org",
                Mx,
                1,
                timeout_ms,
              ))).value).value).value;
    let began = clock.now();
    assert_eq(request(500), Err(TimedOut));
    assert_eq(clock.now(), after(began, millis(600)));
    assert_eq(request(1000), Ok(mail))
  }
}

test "a server's reply gives `NoSuchName` for a missing name, `NoData` for no records of the kind, and `ServerFailure` for a failure" {
  simulate {
    let resolve_with_reply = |code: Int, records: List<Record>| {
      resolve_over(
        udp::mem_with_responder(udp::mem_empty(), server(), |query: Bytes|
          replies(query, code, records)),
        net::mem_empty(),
        [server()],
        Mx,
        3,
        7,
      )
    };
    let absent = resolve_with_reply(3, []);
    assert_eq(absent.result, Err(NoSuchName));
    assert_eq(absent.udp.applied_fates.len(), 2);
    assert_eq(resolve_with_reply(0, []).result, Err(NoData));
    assert_eq(
      resolve_with_reply(0, [test_record("example.org", 60, Alias("example.net"))]).result,
      Err(NoData),
    );
    let failing = resolve_with_reply(2, []);
    assert_eq(failing.result, Err(ServerFailure));
    assert_eq(failing.udp.applied_fates.len(), 6)
  }
}

test "a server that fails is skipped for the next one" {
  simulate {
    let world = udp::mem_with_responder(
      udp::mem_with_responder(udp::mem_empty(), server(), failing_server),
      second(),
      mail_server,
    );
    assert_eq(
      resolve_over(world, net::mem_empty(), [server(), second()], Mx, 1, 7).result,
      Ok(mail),
    );
    assert_eq(
      resolve_over(udp::mem_empty(), net::mem_empty(), [server(), second()], Mx, 2, 7).result,
      Err(TimedOut),
    )
  }
}

test "a response truncated to fit a datagram is requested again over a connection" {
  let long = [
    test_record(
      "example.org",
      60,
      Text([Bytes::of_string("v=spf1 include:_spf.example.net ~all")]),
    ),
  ];
  let cut = |query: Bytes|
    match decode(query) {
      Some(request) -> {
        let short = response(request, 0, []);
        [encode_or_panic({ ..short, truncated: true })]
      },
      None -> [],
    };
  let id = match rand_below(rand(7), 65536) { Some(drawn) -> drawn.value, None -> 0 };
  let request = question(id, "example.org", Txt);
  let exchange_on_connection = |message: Bytes| u16_be(message.len()).concat(message);
  let streams = net::mem_chunk_limit(
    net::mem_serving(net::mem_empty(), server(), [
      [
        Expects(exchange_on_connection(encode_or_panic(request))),
        Sends(exchange_on_connection(encode_or_panic(response(request, 0, long)))),
      ],
    ]),
    3,
  );
  let world = udp::mem_with_responder(udp::mem_empty(), server(), cut);
  simulate {
    let ran = resolve_over(world, streams, [server()], Txt, 1, 7);
    assert_eq(ran.result, Ok(long));
    assert_eq(texts(long), [b"v=spf1 include:_spf.example.net ~all"]);
    assert_eq(net::mem_remaining_script(ran.net, 1), []);
    assert_eq(ran.net.closed, [1]);
    assert_eq(resolve_over(world, net::mem_empty(), [server()], Txt, 1, 7).result, Err(TimedOut))
  }
}

test "an invalid question is rejected before anything is sent: {c.name}" for c: { name: String, reason: Failure } in [
    {
      name: "a..b",
      reason: dns::Other(
        0,
        "each label of a name must be 1 to 63 bytes, and the whole name at most 253 bytes",
      ),
    },
    { name: "b\u{fc}cher.example", reason: dns::not_ascii },
  ] {
  simulate {
    let ran = resolve_over(udp::mem_empty(), net::mem_empty(), [], Mx, 3, 7);
    assert_eq(ran.result, Err(dns::Other(0, "there is no server to ask")));
    let unnamed = net::on_mem(net::mem_empty(), ||
      udp::on_mem(udp::mem_empty(), ||
        with_rand(rand(7), || resolve[lookup, fallback]([server()], c.name, Mx, 1, 500)).value));
    assert_eq(unnamed.value.value, Err(c.reason));
    assert_eq(unnamed.value.udp.applied_fates, [])
  }
}

test "the system's servers are the ones queried" {
  let srv = [
    test_record(
      "_imaps._tcp.example.org",
      60,
      ServiceLocation({ priority: 20, weight: 0, port: 993, target: "b.example.org" }),
    ),
    test_record(
      "_imaps._tcp.example.org",
      60,
      ServiceLocation({ priority: 10, weight: 0, port: 993, target: "a.example.org" }),
    ),
  ];
  let streams = net::mem_resolving(net::mem_empty(), dns::with_servers(dns::table, [second()]));
  let world = udp::mem_with_responder(udp::mem_empty(), second(), |query: Bytes|
    replies(query, 0, srv));
  simulate {
    let ran = net::on_mem(streams, ||
      udp::on_mem(world, ||
        with_rand(rand(7), ||
          resolve_system[lookup, fallback]("_imaps._tcp.example.org", Srv, 1, 500)).value));
    assert_eq(ran.value.value, Ok(srv));
    assert_eq(services(srv).map(|s: Service| s.target), ["a.example.org", "b.example.org"])
  }
}

test "the addresses of a response carry their time to live" {
  let records = [
    test_record("www.example.org", 30, Alias("example.org")),
    test_record("example.org", 120, Address(ip::read("192.0.2.1"))),
  ];
  assert_eq(addresses(records), [
    { address: ip::read("192.0.2.1"), ttl: Some(Duration(120000000000)) },
  ])
}

test "a question still gets its answer on a network that drops, duplicates and reorders messages" {
  simulate {
    let world = udp::mem_lossy(
      udp::mem_with_responder(udp::mem_empty(), server(), mail_server),
      sim.seed(),
      { drop: 30, duplicate: 20, reorder: 20 },
    );
    let ran = resolve_over(world, net::mem_empty(), [server()], Mx, 40, sim.seed());
    assert_eq(ran.result, Ok(mail))
  }
}
