//! Text laid out for people to read, with functions for wrapping, measuring, renaming and shell
//! quoting.
//!
//! This module lays out prose in a width (`wrap`, `fill`, `indent`, `dedent`, `truncate`,
//! `aligned`, `table`), measures how far one word is from another (`edit_distance`,
//! `typo_distance`, `closest`), converts a name to another case style (`snake_case` and the
//! others), and quotes words for a POSIX shell (`shell_quote`, `shell_join`, `shell_split`). Every
//! function is total and has no effects.
//!
//! A width counts columns, and a `Measure` gives how many columns each character takes. Without
//! one, each character is one column. That is right for ASCII and wrong for wide or combining
//! characters, so pass a measure that knows them when the text may contain them. Every layout
//! function takes a measure, so none needs a second version. An escape sequence is measured as the
//! characters it is made of.
//!
//! The case styles work on ASCII, as `std.string`'s `ascii_lower` does: a letter is `A-Z` or `a-z`.
//! A character outside ASCII belongs to the word it is in and is never changed.
//!
//! `std.sh` writes an argument list in Ply source code, which the Ply compiler reads. The shell
//! functions here do the opposite. `shell_quote` and `shell_join` write arguments as a line for a
//! person to paste into a shell or to show in a log, and `shell_split` parses such a line back into
//! its arguments. Nothing here starts a shell: to start a program, pass it an argument list
//! (`std.process`).

import std.laws (agrees)
import std.list (prepend)
import std.show (show)
import std.string
import std.gen

/// The number of columns a character takes. `None`, the default for every `measure` parameter,
/// counts one for every character.
///
/// A function should return zero for a character that combines with the one before it, and two for
/// a wide character. A result below zero counts as zero.
pub type Measure = Option<(Char) -> Int>

/// Which side of its width a text is placed on.
pub type Align =
  /// At the start, with padding after it.
  | Left
  /// At the end, with padding before it, as a column of numbers lines up.
  | Right
  /// In the middle. When the padding is odd, the extra column goes after the text.
  | Center

fn columns(measure: Measure, c: Char) -> Int =
  match measure { None -> 1, Some(wide) -> max(wide(c), 0) }

fn measured(text: String, measure: Measure) -> Int =
  match measure {
    None -> text.len(),
    Some(_) -> text.chars().fold(0, |sum: Int, c: Char| sum + columns(measure, c)),
  }

/// The number of columns `text` takes.
pub fn width(text: String, measure: Measure = None) -> Int = measured(text, measure)

type WrapState = { lines: List<String>, line: String, used: Int, line_empty: Bool }

/// Splits the words of `text` into lines of at most `width` columns. Each line takes as many words
/// as fit, one space apart. The first line starts with `first` and every later line with `rest`.
/// Their columns count toward the width, so a hanging indent is a `rest` of spaces. Both default
/// to empty.
///
/// The text is treated as one paragraph. A word is a run of characters between spaces, tabs and
/// line breaks, and a text with no words has no lines. A word wider than a line goes whole on a
/// line of its own, over the width, unless `break_words` is true, which splits it at the width.
/// Every line has at least one character, so wrapping ends even when nothing fits in the width.
pub fn wrap(
  text: String,
  width: Int,
  first: String = "",
  rest: String = "",
  break_words: Bool = false,
  measure: Measure = None,
) -> List<String> = {
  let laid = spaced(text).fold(
    { lines: [], line: first, used: measured(first, measure), line_empty: true },
    |s: WrapState, word: String| placed(s, word, width, rest, break_words, measure),
  );
  if laid.line_empty { laid.lines } else { laid.lines.push(laid.line) }
}

/// `wrap`'s lines joined into one text, with a line feed between lines and none after the last.
/// The options are as for `wrap`.
pub fn fill(
  text: String,
  width: Int,
  first: String = "",
  rest: String = "",
  break_words: Bool = false,
  measure: Measure = None,
) -> String = String::join(wrap(text, width, first, rest, break_words, measure), "\n")

fn placed(
  s: WrapState,
  word: String,
  width: Int,
  rest: String,
  break_words: Bool,
  measure: Measure,
) -> WrapState = {
  let wide = measured(word, measure);
  if !s.line_empty && s.used + 1 + wide <= width {
    { ..s, line: s.line ++ " " ++ word, used: s.used + 1 + wide }
  } else {
    let fresh = if s.line_empty { s } else { end_line(s, rest, measure) };
    if break_words && fresh.used + wide > width {
      word.chars().fold(fresh, |accumulator: WrapState, c: Char| {
        let one = columns(measure, c);
        let at = if !accumulator.line_empty && accumulator.used + one > width {
          end_line(accumulator, rest, measure)
        } else { accumulator };
        { ..at, line: at.line ++ String::of_chars([c]), used: at.used + one, line_empty: false }
      })
    } else { { ..fresh, line: fresh.line ++ word, used: fresh.used + wide, line_empty: false } }
  }
}

fn end_line(s: WrapState, rest: String, measure: Measure) -> WrapState =
  { lines: s.lines.push(s.line), line: rest, used: measured(rest, measure), line_empty: true }

fn spaced(text: String) -> List<String> = {
  let read = text.chars().fold(
    { done: [], word: [] },
    |s: { done: List<String>, word: List<Char> }, c: Char|
      if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
        { done: push_word(s.done, s.word), word: [] }
      } else { { done: s.done, word: s.word.push(c) } },
  );
  push_word(read.done, read.word)
}

fn push_word(done: List<String>, word: List<Char>) -> List<String> =
  if word.len() == 0 { done } else { done.push(String::of_chars(word)) }

/// `text` with `prefix` added before each line. A line of only spaces and tabs is left as it is,
/// so no line gains trailing whitespace.
pub fn indent(text: String, prefix: String) -> String =
  String::join(
    lines_of(text).map(|line: List<Char>|
      if is_blank_line(line) { String::of_chars(line) } else { prefix ++ String::of_chars(line) }),
    "\n",
  )

/// `text` with the leading spaces and tabs shared by every line removed. Margins are compared
/// character by character, so a tab does not equal eight spaces. A line of only spaces and tabs
/// does not count toward the shared margin, and loses all its whitespace.
pub fn dedent(text: String) -> String = {
  let lines = lines_of(text);
  let shared = lines.fold(None, |seen: Option<List<Char>>, line: List<Char>|
    if is_blank_line(line) { seen } else {
      let own = line.take(margin(line));
      match seen { None -> Some(own), Some(so_far) -> Some(common_prefix(so_far, own)) }
    });
  let cut = match shared { None -> 0, Some(m) -> m.len() };
  String::join(
    lines.map(|line: List<Char>|
      String::of_chars(line.drop(if is_blank_line(line) { margin(line) } else { cut }))),
    "\n",
  )
}

fn lines_of(text: String) -> List<List<Char>> = {
  let read = text.chars().fold(
    { done: [], line: [] },
    |s: { done: List<List<Char>>, line: List<Char> }, c: Char|
      if c == '\n' { { done: s.done.push(s.line), line: [] } }
      else { { done: s.done, line: s.line.push(c) } },
  );
  read.done.push(read.line)
}

fn margin(line: List<Char>) -> Int = line.take_while(|c: Char| c == ' ' || c == '\t').len()

fn is_blank_line(line: List<Char>) -> Bool = {
  let body = line.drop(margin(line));
  body == [] || body == ['\r']
}

fn common_prefix(a: List<Char>, b: List<Char>) -> List<Char> =
  a.take(
    range(0, min(a.len(), b.len())).fold(
      { n: 0, same: true },
      |s: { n: Int, same: Bool }, i: Int|
        if s.same && a.at(i) == b.at(i) { { n: s.n + 1, same: true } }
        else { { n: s.n, same: false } },
    ).n,
  )

/// `text` cut to at most `width` columns. A text that fits is returned unchanged. Otherwise the
/// result is the longest start of the text that leaves room for `ellipsis`, followed by the
/// ellipsis, which defaults to `…`. An ellipsis wider than the width is left out, and a width
/// below one gives the empty text.
pub fn truncate(
  text: String,
  width: Int,
  ellipsis: String = "\u{2026}",
  measure: Measure = None,
) -> String =
  if measured(text, measure) <= width { text } else {
    let room = width - measured(ellipsis, measure);
    if room < 0 { fit_prefix(text, width, measure) }
    else { fit_prefix(text, room, measure) ++ ellipsis }
  }

fn fit_prefix(text: String, room: Int, measure: Measure) -> String =
  String::of_chars(
    text.chars().fold(
      { retained: [], used: 0, open: true },
      |s: { retained: List<Char>, used: Int, open: Bool }, c: Char| {
        let one = columns(measure, c);
        if s.open && s.used + one <= room {
          { retained: s.retained.push(c), used: s.used + one, open: true }
        } else { { retained: s.retained, used: s.used, open: false } }
      },
    ).retained,
  )

/// Returns `text` padded with spaces to `width` columns. `side` says where the text sits: `Left`
/// (the default) puts the padding after the text, `Right` puts it before, and `Center` splits it on
/// both sides. A text that is already `width` columns or wider is returned unchanged.
pub fn aligned(text: String, width: Int, side: Align = Left, measure: Measure = None) -> String = {
  let missing = width - measured(text, measure);
  if missing <= 0 { text } else {
    match side {
      Left -> text ++ " ".repeat(missing),
      Right -> " ".repeat(missing) ++ text,
      Center -> " ".repeat(missing / 2) ++ text ++ " ".repeat(missing - missing / 2),
    }
  }
}

/// `rows` laid out as lines with their cells in columns. Each column is as wide as its widest
/// cell, and `gap`, two spaces by default, separates neighbouring columns. Each cell is aligned as
/// `sides` gives for its column, or `Left` if `sides` gives none. A row with fewer cells is filled
/// out with empty cells, and no line ends in a space.
pub fn table(
  rows: List<List<String>>,
  sides: List<Align> = [],
  gap: String = "  ",
  measure: Measure = None,
) -> List<String> = {
  let count = rows.fold(0, |most: Int, row: List<String>| max(most, row.len()));
  let widths = range(0, count).map(|i: Int|
    rows.fold(0, |most: Int, row: List<String>| max(most, measured(row.at_or(i, ""), measure))));
  rows.map(|row: List<String>|
    without_trailing_spaces(
      String::join(
        range(0, count).map(|i: Int|
          aligned(row.at_or(i, ""), widths.at_or(i, 0), sides.at_or(i, Left), measure)),
        gap,
      ),
    ))
}

fn without_trailing_spaces(line: String) -> String = {
  let cs = line.chars();
  let trimmed_length = cs.fold({ at: 0, keep: 0 }, |s: { at: Int, keep: Int }, c: Char|
    { at: s.at + 1, keep: if c == ' ' { s.keep } else { s.at + 1 } }).keep;
  if trimmed_length == cs.len() { line } else { String::of_chars(cs.take(trimmed_length)) }
}

type BandedRow = { first_column: Int, cells: List<Int> }

type DistanceRows = { before: BandedRow, above: BandedRow, within_limit: Bool }

/// The number of characters that must be inserted, deleted or replaced to turn `a` into `b`: the
/// Levenshtein distance, over characters. It is a metric: zero only between equal texts, the same
/// in both directions, and the direct distance is never more than the distance by way of a third
/// text.
pub fn edit_distance(a: String, b: String) -> Int = unlimited_distance(a.chars(), b.chars(), false)

/// `edit_distance` if it is at most `limit`, and `None` if it is more. The search visits only the
/// cells that can still be within the limit, and stops at the first row where none can.
pub fn edit_distance_within(a: String, b: String, limit: Int) -> Option<Int> =
  banded_distance(a.chars(), b.chars(), limit, false)

/// `edit_distance` with one more kind of edit: swapping two neighbouring characters, the most
/// common typing mistake. So `"form"` is one edit from `"from"`, not two. No character is edited
/// twice (the optimal string alignment distance), so it is not a metric: the distance by way of a
/// third text can be less than the direct distance. It is never more than `edit_distance`.
pub fn typo_distance(a: String, b: String) -> Int = unlimited_distance(a.chars(), b.chars(), true)

/// `typo_distance` if it is at most `limit`, and `None` if it is more. Searches as
/// `edit_distance_within` does.
pub fn typo_distance_within(a: String, b: String, limit: Int) -> Option<Int> =
  banded_distance(a.chars(), b.chars(), limit, true)

/// The candidate nearest to `word` by `typo_distance`, among those within `limit` of it. If
/// several are equally near, returns the earliest. Returns `None` if none is within the limit. A
/// candidate equal to the word is at distance zero, so it is returned.
pub fn closest(word: String, candidates: List<String>, limit: Int) -> Option<String> = {
  let letters = word.chars();
  candidates.fold(
    { best: None, within: limit },
    |s: { best: Option<String>, within: Int }, candidate: String|
      match banded_distance(letters, candidate.chars(), s.within, true) {
        Some(d) -> { best: Some(candidate), within: d - 1 },
        None -> s,
      },
  ).best
}

fn unlimited_distance(a: List<Char>, b: List<Char>, swaps: Bool) -> Int = {
  let most = max(a.len(), b.len());
  match banded_distance(a, b, most, swaps) { Some(d) -> d, None -> most }
}

fn banded_distance(a: List<Char>, b: List<Char>, limit: Int, swaps: Bool) -> Option<Int> = {
  let n = a.len();
  let m = b.len();
  let bound = min(limit, max(n, m));
  if bound < 0 || n - m > bound || m - n > bound { None } else {
    let top = { first_column: 0, cells: range(0, min(m, bound) + 1) };
    let last = range(1, n + 1).fold(
      { before: top, above: top, within_limit: true },
      |s: DistanceRows, i: Int|
        if !s.within_limit { s } else {
          let row = row_below(a, b, bound, swaps, i, s.before, s.above);
          { before: s.above, above: row, within_limit: least(row.cells, bound + 1) <= bound }
        },
    );
    let d = cell_at(last.above, m, bound + 1);
    if last.within_limit && d <= bound { Some(d) } else { None }
  }
}

fn row_below(
  a: List<Char>,
  b: List<Char>,
  bound: Int,
  swaps: Bool,
  i: Int,
  before: BandedRow,
  above: BandedRow,
) -> BandedRow = {
  let over = bound + 1;
  let from = max(0, i - bound);
  let x = a.at_or(i - 1, ' ');
  {
    first_column: from,
    cells: range(from, min(b.len(), i + bound) + 1).fold(
      { cells: [], left: over },
      |s: { cells: List<Int>, left: Int }, j: Int| {
        let cell = if j == 0 { i } else {
          let y = b.at_or(j - 1, ' ');
          let edited = min(
            min(cell_at(above, j, over), s.left) + 1,
            cell_at(above, j - 1, over) + (if x == y { 0 } else { 1 }),
          );
          if swaps && i > 1 && j > 1 && x == b.at_or(j - 2, ' ') && y == a.at_or(i - 2, ' ') {
            min(edited, cell_at(before, j - 2, over) + 1)
          } else { edited }
        };
        { cells: s.cells.push(min(cell, over)), left: min(cell, over) }
      },
    ).cells,
  }
}

fn cell_at(row: BandedRow, j: Int, spare: Int) -> Int =
  match row.cells.at(j - row.first_column) { Some(cell) -> cell, None -> spare }

fn least(cells: List<Int>, spare: Int) -> Int = cells.fold(spare, |low: Int, v: Int| min(low, v))

/// The words a name is made of, in order and unchanged. An ASCII character that is neither a
/// letter nor a digit separates words and belongs to none. A new word also starts at an
/// upper-case letter that follows a lower-case letter, a digit or a character outside ASCII, and
/// at the last letter of an upper-case run that a lower-case letter follows. So
/// `HTTPRequest2Line_id` has the words `HTTP`, `Request2`, `Line` and `id`.
pub fn name_words(name: String) -> List<String> = {
  let cs = name.chars();
  let read = range(0, cs.len()).fold(
    { done: [], word: [] },
    |s: { done: List<String>, word: List<Char> }, i: Int| {
      let c = cs.at_or(i, ' ');
      if separator(c) { { done: push_word(s.done, s.word), word: [] } }
      else if s.word.len() > 0 && starts_word(cs.at_or(i - 1, ' '), c, cs.at_or(i + 1, ' ')) {
        { done: push_word(s.done, s.word), word: [c] }
      } else { { done: s.done, word: s.word.push(c) } }
    },
  );
  push_word(read.done, read.word)
}

/// `name`'s words in lower case with `_` between them, so `HTTPRequest` becomes `http_request`.
/// `derive` names a type's functions this way.
pub fn snake_case(name: String) -> String =
  String::join(name_words(name).map(String::ascii_lower), "_")

/// `name`'s words in lower case with `-` between them, so `HTTPRequest` becomes `http-request`.
pub fn kebab_case(name: String) -> String =
  String::join(name_words(name).map(String::ascii_lower), "-")

/// `name`'s words joined together, each after the first capitalized, so `http_request` becomes
/// `httpRequest`. Neighbouring one-letter words merge into one, so a name with them does not
/// convert back to the same words.
pub fn camel_case(name: String) -> String =
  match name_words(name) {
    [] -> "",
    [head, ..tail] -> head.ascii_lower() ++ String::join(tail.map(capital), ""),
  }

/// `name`'s words joined together, each capitalized, so `http_request` becomes `HttpRequest`.
/// This is the style of type names. Neighbouring one-letter words merge, as in `camel_case`.
pub fn pascal_case(name: String) -> String = String::join(name_words(name).map(capital), "")

/// `name`'s words, each capitalized, with a space between them, so `http_request` becomes
/// `Http Request`.
pub fn title_case(name: String) -> String = String::join(name_words(name).map(capital), " ")

fn upper(c: Char) -> Bool = c >= 'A' && c <= 'Z'

fn lower(c: Char) -> Bool = c >= 'a' && c <= 'z'

fn digit(c: Char) -> Bool = c >= '0' && c <= '9'

fn separator(c: Char) -> Bool = Int::of_char(c) < 128 && !upper(c) && !lower(c) && !digit(c)

fn starts_word(before: Char, c: Char, after: Char) -> Bool =
  upper(c)
    && (lower(before) || digit(before) || Int::of_char(before) >= 128
    || (upper(before) && lower(after)))

fn capital(word: String) -> String = word.ascii_lower().capitalize()

/// `word` written so a POSIX shell reads it as exactly that one word. A word whose characters are
/// all letters, digits or one of `_@%+:,./-` is left as it is. Any other word goes between single
/// quotes, with each single quote inside it written as `'\''`, so the empty word is `''`. Words
/// the shell would treat as its own syntax in a command's position are quoted too: reserved words
/// such as `if` or `time`, and any word containing `=` that does not start with `-`, which could
/// be an assignment. Returns `None` for a word containing the zero character, which no shell word
/// can carry.
///
/// This is for showing a command, or for a shell someone else runs. To start a program, pass
/// `std.process` the argument list. To write an argument list in source code, use `std.sh`.
pub fn shell_quote(word: String) -> Option<String> = {
  let cs = word.chars();
  if cs.contains('\0') { None }
  else if cs.len() > 0 && !reserved(word)
      && cs.all(|c: Char| plain(c) || (c == '=' && cs.at(0) == Some('-'))) { Some(word) } else {
    Some(
      "'"
        ++ String::join(
          cs.map(|c: Char| if c == '\'' { "'\\''" } else { String::of_chars([c]) }),
          "",
        )
        ++ "'",
    )
  }
}

/// `args` as one line that a POSIX shell reads back as those words: each written as `shell_quote`
/// writes it, with a space between them. Returns `None` if a word contains the zero character.
pub fn shell_join(args: List<String>) -> Option<String> = {
  let quoted = args.fold(Some([]), |done: Option<List<String>>, arg: String|
    match done {
      None -> None,
      Some(words) -> match shell_quote(arg) { Some(q) -> Some(words.push(q)), None -> None },
    });
  match quoted { Some(words) -> Some(String::join(words, " ")), None -> None }
}

/// Returns the words a POSIX shell would pass to a program for `line`, or `None` if a shell would
/// do more than split and unquote it.
///
/// Words are separated by spaces and tabs. Single quotes, double quotes and a backslash before a
/// character quote it (Shell Command Language, 2.2). Nothing is expanded, so the result is the text
/// as written.
///
/// Returns `None` for an unclosed quote or a trailing backslash. Also returns `None` for anything a
/// shell would treat specially: - an unquoted character other than a letter, a digit or one of
/// `_@%+:,./-=`, which covers operators, expansions, patterns, comments and line breaks; - a `$` or
/// a backquote inside double quotes; - a first word that is an assignment (`NAME=value`) or a
/// reserved word (`if`, `time`); - whitespace outside ASCII, which some shells split at and others
/// do not, depending on locale; - the NUL character (code point 0).
pub fn shell_split(line: String) -> Option<List<String>> = {
  let read = line.chars().fold(
    {
      done: [],
      word: [],
      open: false,
      quoting: Bare,
      escaped: false,
      variable_like: false,
      rejected: false,
    },
    |r: SplitState, c: Char| if r.rejected { r } else { stepped(r, c) },
  );
  if read.escaped || read.quoting != Bare || closed(read).rejected { None }
  else { Some(closed(read).done) }
}

type Quoting = | Bare | Single | Double

type SplitState = {
  done: List<String>,
  word: List<Char>,
  open: Bool,
  quoting: Quoting,
  escaped: Bool,
  variable_like: Bool,
  rejected: Bool,
}

fn plain(c: Char) -> Bool =
  upper(c) || lower(c) || digit(c) || c == '_' || c == '@' || c == '%' || c == '+' || c == ':'
    || c == ','
    || c == '.'
    || c == '/'
    || c == '-'

fn reserved(word: String) -> Bool =
  [
    "case",
    "coproc",
    "do",
    "done",
    "elif",
    "else",
    "esac",
    "fi",
    "for",
    "function",
    "if",
    "in",
    "select",
    "then",
    "time",
    "until",
    "while",
  ].contains(
    word,
  )

fn closed(r: SplitState) -> SplitState =
  if !r.open { r }
  else if r.variable_like && r.done.len() == 0 && reserved(String::of_chars(r.word)) {
    { ..r, rejected: true }
  } else {
    {
      ..r,
      done: r.done.push(String::of_chars(r.word)),
      word: [],
      open: false,
      variable_like: false,
    }
  }

fn stepped(r: SplitState, c: Char) -> SplitState =
  if c == '\0' { { ..r, rejected: true } } else {
    match r.quoting {
      Single -> if c == '\'' { { ..r, quoting: Bare } } else { taken(r, c) },
      Double -> double_quoted(r, c),
      Bare -> unquoted(r, c),
    }
  }

fn taken(r: SplitState, c: Char) -> SplitState =
  { ..r, word: r.word.push(c), open: true, escaped: false, variable_like: false }

fn double_quoted(r: SplitState, c: Char) -> SplitState =
  if r.escaped {
    if c == '\n' { { ..r, escaped: false } }
    else if c == '$' || c == '`' || c == '"' || c == '\\' { taken(r, c) }
    else { taken(taken(r, '\\'), c) }
  } else if c == '"' { { ..r, quoting: Bare } }
  else if c == '\\' { { ..r, escaped: true } }
  else if c == '$' || c == '`' { { ..r, rejected: true } }
  else { taken(r, c) }

fn unquoted(r: SplitState, c: Char) -> SplitState =
  if r.escaped { if c == '\n' { { ..r, escaped: false } } else { taken(r, c) } }
  else if c == '\\' { { ..r, escaped: true } }
  else if c == '\'' { { ..r, quoting: Single, open: true, variable_like: false } }
  else if c == '"' { { ..r, quoting: Double, open: true, variable_like: false } }
  else if c == ' ' || c == '\t' { closed(r) } else if c == '=' {
    if r.variable_like && r.done.len() == 0 { { ..r, rejected: true } } else { taken(r, c) }
  } else if plain(c) {
    let named = upper(c) || lower(c) || c == '_' || (r.open && digit(c));
    { ..r, word: r.word.push(c), open: true, variable_like: named && (r.variable_like || !r.open) }
  } else if Int::of_char(c) >= 128 && String::of_chars([c]).trim() != "" { taken(r, c) }
  else { { ..r, rejected: true } }

fn within(n: Int, top: Int) -> Int / {abort.raise} = (n % top + top) % top

fn spelled(codes: List<Int>, alphabet: String) -> String / {abort.raise} = {
  let letters = alphabet.chars();
  String::of_chars(codes.map(|code: Int| letters.at_or(within(code, letters.len()), ' ')))
}

fn prose(codes: List<Int>) -> String / {abort.raise} = spelled(codes, "ab cd ef\n")

fn cjk_measure() -> Measure =
  Some(|c: Char| if Int::of_char(c) >= 0x4E00 { 2 } else if c == '\u{301}' { 0 } else { 1 })

test "`wrap` puts as many words on each line as fit the width, separated by single spaces" {
  assert_eq(wrap("the quick brown fox jumps", 10), ["the quick", "brown fox", "jumps"]);
  assert_eq(wrap("  the\tquick \n brown  ", 80), ["the quick brown"]);
  assert_eq(wrap("a bb ccc", 0), ["a", "bb", "ccc"]);
  assert_eq(wrap("", 10), []);
  assert_eq(wrap(" \n\t", 10), []);
  assert_eq(fill("the quick brown fox", 10), "the quick\nbrown fox");
  assert_eq(fill("", 10), "")
}

test "`wrap` indents every line after the first with the `rest` prefix, and the prefix's width counts toward the line width" {
  assert_eq(wrap("one two three four five", 12, first: "* ", rest: "  "), [
    "* one two",
    "  three four",
    "  five",
  ]);
  assert_eq(wrap("", 12, first: "* "), [])
}

test "a word wider than a line stays whole unless word breaking is on" {
  assert_eq(wrap("a abcdefghij b", 4), ["a", "abcdefghij", "b"]);
  assert_eq(wrap("a abcdefghij b", 4, break_words: true), ["a", "abcd", "efgh", "ij b"]);
  assert_eq(wrap("abc", 0, break_words: true), ["a", "b", "c"]);
  assert_eq(wrap("abcdef", 4, rest: "> ", break_words: true), ["abcd", "> ef"])
}

test "a measure counts a wide character twice and a combining one not at all" {
  assert_eq(width("a\u{4E16}\u{754C}"), 3);
  assert_eq(width("a\u{4E16}\u{754C}", measure: cjk_measure()), 5);
  assert_eq(width("e\u{301}", measure: cjk_measure()), 1);
  assert_eq(wrap("\u{4E16}\u{754C} \u{4E16}\u{754C} ab", 5, measure: cjk_measure()), [
    "\u{4E16}\u{754C}",
    "\u{4E16}\u{754C}",
    "ab",
  ]);
  assert_eq(
    truncate("\u{4E16}\u{754C}\u{4E16}\u{754C}", 5, measure: cjk_measure()),
    "\u{4E16}\u{754C}\u{2026}",
  );
  assert_eq(aligned("\u{4E16}", 4, side: Right, measure: cjk_measure()), "  \u{4E16}")
}

test "indent prefixes the lines that are not blank" {
  assert_eq(indent("a\n\n  b\n", "> "), "> a\n\n>   b\n");
  assert_eq(indent("a\n \t\nb", "  "), "  a\n \t\n  b");
  assert_eq(indent("a\r\n\r\nb", "  "), "  a\r\n\r\n  b");
  assert_eq(indent("", "  "), "")
}

test "dedent removes the margin every line shares, and all of a blank line's whitespace" {
  assert_eq(dedent("  a\n    b\n\n  c"), "a\n  b\n\nc");
  assert_eq(dedent("  a\n \t \n  b"), "a\n\nb");
  assert_eq(dedent("\ta\n  b"), "\ta\n  b");
  assert_eq(dedent("    a\r\n    \r\n    b\r\n"), "a\r\n\r\nb\r\n");
  assert_eq(dedent("a\n  b"), "a\n  b");
  assert_eq(dedent("   "), "");
  assert_eq(dedent(""), "")
}

test "a text is cut to its width with the ellipsis inside it" {
  assert_eq(truncate("hello world", 8), "hello w\u{2026}");
  assert_eq(truncate("hello", 5), "hello");
  assert_eq(truncate("hello", 4), "hel\u{2026}");
  assert_eq(truncate("hello", 1), "\u{2026}");
  assert_eq(truncate("hello", 0), "");
  assert_eq(truncate("hello", 0 - 3), "");
  assert_eq(truncate("hello world", 8, ellipsis: "..."), "hello...");
  assert_eq(truncate("hello", 2, ellipsis: "..."), "he")
}

test "a text is placed on the requested side of its width" {
  assert_eq(aligned("ab", 5), "ab   ");
  assert_eq(aligned("ab", 5, side: Right), "   ab");
  assert_eq(aligned("ab", 5, side: Center), " ab  ");
  assert_eq(aligned("abcdef", 3, side: Right), "abcdef")
}

test "a table's columns are as wide as their widest cell, and numbers line up on the right" {
  assert_eq(table([["name", "size"], ["a", "10"], ["bbb", "7"]], sides: [Left, Right]), [
    "name  size",
    "a       10",
    "bbb      7",
  ]);
  assert_eq(table([["a", "b"], ["c"], []]), ["a  b", "c", ""]);
  assert_eq(table([["a", "bb"], ["ccc", "d"]], sides: [Center], gap: " | "), [
    " a  | bb",
    "ccc | d",
  ]);
  assert_eq(table([]), [])
}

test "the edit distance counts characters inserted, deleted and replaced" {
  assert_eq(edit_distance("kitten", "sitting"), 3);
  assert_eq(edit_distance("flaw", "lawn"), 2);
  assert_eq(edit_distance("", "abc"), 3);
  assert_eq(edit_distance("abc", ""), 3);
  assert_eq(edit_distance("", ""), 0);
  assert_eq(edit_distance("na\u{ef}ve", "naive"), 1);
  assert_eq(edit_distance("form", "from"), 2)
}

test "a swap of neighbours is one edit, and no character is edited twice" {
  assert_eq(typo_distance("form", "from"), 1);
  assert_eq(typo_distance("abcd", "badc"), 2);
  assert_eq(typo_distance("kitten", "sitting"), 3);
  assert_eq(typo_distance("ca", "ac"), 1);
  assert_eq(typo_distance("ac", "abc"), 1);
  assert_eq(typo_distance("ca", "abc"), 3)
}

test "`edit_distance_within` returns `Some(distance)` when the distance is within the limit, and `None` when it is larger" {
  assert_eq(edit_distance_within("kitten", "sitting", 3), Some(3));
  assert_eq(edit_distance_within("kitten", "sitting", 2), None);
  assert_eq(edit_distance_within("abc", "abc", 0), Some(0));
  assert_eq(edit_distance_within("abc", "abd", 0), None);
  assert_eq(edit_distance_within("abc", "abc", 0 - 1), None);
  assert_eq(edit_distance_within("a", "abcdefgh", 3), None);
  assert_eq(edit_distance_within("abc", "xyz", 9223372036854775807), Some(3));
  assert_eq(typo_distance_within("form", "from", 1), Some(1));
  assert_eq(edit_distance_within("form", "from", 1), None)
}

test "`closest` returns the candidate nearest to the word within the limit, and the first of several equally near candidates" {
  assert_eq(closest("verbse", ["verbose", "jobs"], 3), Some("verbose"));
  assert_eq(closest("tset", ["rest", "test", "best"], 2), Some("test"));
  assert_eq(closest("cat", ["bat", "hat", "cot"], 1), Some("bat"));
  assert_eq(closest("xyz", ["abc"], 1), None);
  assert_eq(closest("run", ["ruin", "run"], 1), Some("run"));
  assert_eq(closest("run", [], 3), None);
  assert_eq(closest("run", ["run"], 0 - 1), None)
}

type Styled = {
  name: String,
  words: List<String>,
  snake: String,
  kebab: String,
  camel: String,
  pascal: String,
  title: String,
}

fn styled() -> List<Styled> =
  [
    {
      name: "HTTPRequest",
      words: ["HTTP", "Request"],
      snake: "http_request",
      kebab: "http-request",
      camel: "httpRequest",
      pascal: "HttpRequest",
      title: "Http Request",
    },
    {
      name: "orderLine",
      words: ["order", "Line"],
      snake: "order_line",
      kebab: "order-line",
      camel: "orderLine",
      pascal: "OrderLine",
      title: "Order Line",
    },
    {
      name: "Order2Line",
      words: ["Order2", "Line"],
      snake: "order2_line",
      kebab: "order2-line",
      camel: "order2Line",
      pascal: "Order2Line",
      title: "Order2 Line",
    },
    {
      name: "sha256_hash",
      words: ["sha256", "hash"],
      snake: "sha256_hash",
      kebab: "sha256-hash",
      camel: "sha256Hash",
      pascal: "Sha256Hash",
      title: "Sha256 Hash",
    },
    {
      name: "  hello, world! ",
      words: ["hello", "world"],
      snake: "hello_world",
      kebab: "hello-world",
      camel: "helloWorld",
      pascal: "HelloWorld",
      title: "Hello World",
    },
    {
      name: "__init__",
      words: ["init"],
      snake: "init",
      kebab: "init",
      camel: "init",
      pascal: "Init",
      title: "Init",
    },
    {
      name: "caf\u{e9}Bar",
      words: ["caf\u{e9}", "Bar"],
      snake: "caf\u{e9}_bar",
      kebab: "caf\u{e9}-bar",
      camel: "caf\u{e9}Bar",
      pascal: "Caf\u{e9}Bar",
      title: "Caf\u{e9} Bar",
    },
    { name: "A", words: ["A"], snake: "a", kebab: "a", camel: "a", pascal: "A", title: "A" },
    { name: "", words: [], snake: "", kebab: "", camel: "", pascal: "", title: "" },
  ]

test "{show(c.name)} splits into the expected words and converts to the expected snake, kebab, camel, Pascal and title case" for c: Styled in styled(
  ) {
  assert_eq(name_words(c.name), c.words);
  assert_eq(snake_case(c.name), c.snake);
  assert_eq(kebab_case(c.name), c.kebab);
  assert_eq(camel_case(c.name), c.camel);
  assert_eq(pascal_case(c.name), c.pascal);
  assert_eq(title_case(c.name), c.title)
}

type Quoted = { word: String, quoted: Option<String> }

fn quotings() -> List<Quoted> =
  [
    { word: "", quoted: Some("''") },
    { word: "abc", quoted: Some("abc") },
    { word: "src/main.ply:12", quoted: Some("src/main.ply:12") },
    { word: "a b", quoted: Some("'a b'") },
    { word: "it's", quoted: Some("'it'\\''s'") },
    { word: "'", quoted: Some("''\\'''") },
    { word: "$HOME", quoted: Some("'$HOME'") },
    { word: "{a,b}", quoted: Some("'{a,b}'") },
    { word: "~", quoted: Some("'~'") },
    { word: "*.ply", quoted: Some("'*.ply'") },
    { word: "a\nb", quoted: Some("'a\nb'") },
    { word: "a\\b", quoted: Some("'a\\b'") },
    { word: "CC=gcc", quoted: Some("'CC=gcc'") },
    { word: "if", quoted: Some("'if'") },
    { word: "time", quoted: Some("'time'") },
    { word: "iffy", quoted: Some("iffy") },
    { word: "=ls", quoted: Some("'=ls'") },
    { word: "--jobs=4", quoted: Some("--jobs=4") },
    { word: "-", quoted: Some("-") },
    { word: "caf\u{e9}", quoted: Some("'caf\u{e9}'") },
    { word: "a\0b", quoted: None },
  ]

test "the word {show(c.word)} is quoted for a shell" for c: Quoted in quotings() {
  assert_eq(shell_quote(c.word), c.quoted)
}

type Split = { line: String, words: Option<List<String>> }

fn splits() -> List<Split> =
  [
    { line: "", words: Some([]) },
    { line: " \t ", words: Some([]) },
    { line: "  a  b\tc ", words: Some(["a", "b", "c"]) },
    { line: "'a b' \"c d\" e\\ f", words: Some(["a b", "c d", "e f"]) },
    { line: "'' \"\"", words: Some(["", ""]) },
    { line: "a'b'\"c\"d", words: Some(["abcd"]) },
    { line: "\"a\\\"b\\\\c\\$d\\`e\"", words: Some(["a\"b\\c$d`e"]) },
    { line: "\"a\\nb\"", words: Some(["a\\nb"]) },
    { line: "'a\\nb'", words: Some(["a\\nb"]) },
    { line: "'it'\\''s'", words: Some(["it's"]) },
    { line: "\\$HOME \\*", words: Some(["$HOME", "*"]) },
    { line: "'a\nb' \"c\nd\"", words: Some(["a\nb", "c\nd"]) },
    { line: "a \\\n b", words: Some(["a", "b"]) },
    { line: "a\\\nb \"c\\\nd\"", words: Some(["ab", "cd"]) },
    { line: "make CC=gcc --jobs=4", words: Some(["make", "CC=gcc", "--jobs=4"]) },
    { line: "'CC=gcc' make", words: Some(["CC=gcc", "make"]) },
    { line: "caf\u{e9} \u{1F600}", words: Some(["caf\u{e9}", "\u{1F600}"]) },
    { line: "'abc", words: None },
    { line: "\"abc", words: None },
    { line: "abc\\", words: None },
    { line: "echo $HOME", words: None },
    { line: "echo \"$HOME\"", words: None },
    { line: "echo `date`", words: None },
    { line: "echo \"`date`\"", words: None },
    { line: "ls *.ply", words: None },
    { line: "a | b", words: None },
    { line: "a; b", words: None },
    { line: "a > b", words: None },
    { line: "a && b", words: None },
    { line: "(a)", words: None },
    { line: "~/bin/x", words: None },
    { line: "a # b", words: None },
    { line: "{a,b}", words: None },
    { line: "! a", words: None },
    { line: "a\nb", words: None },
    { line: "a\r", words: None },
    { line: "CC=gcc make", words: None },
    { line: "if x", words: None },
    { line: "time make", words: None },
    { line: "done", words: None },
    { line: "'if' x", words: Some(["if", "x"]) },
    { line: "i\\f x", words: Some(["if", "x"]) },
    { line: "x if done", words: Some(["x", "if", "done"]) },
    { line: "iffy", words: Some(["iffy"]) },
    { line: "_x1=2", words: None },
    { line: "a\u{3000}b", words: None },
    { line: "a\0b", words: None },
    { line: "'a\0b'", words: None },
  ]

test "`shell_split` splits {show(c.line)} into words, or returns `None` for an unclosed quote, an operator, an expansion or a reserved first word" for c: Split in splits(
  ) { assert_eq(shell_split(c.line), c.words) }

fn twos() -> gen::Gen<Two> =
  gen::map2(gen::list(gen::any_int()), gen::list(gen::any_int()), |a: List<Int>, b: List<Int>|
    { a: a, b: b })

test "a wrapped line is within the width unless it is one word" {
  gen::check2(gen::list(gen::any_int()), gen::any_int(), |codes: List<Int>, w: Int| {
    let width = 1 + within(w, 24);
    wrap(prose(codes), width).all(|line: String| line.len() <= width || !line.contains(" "))
  })
}

test "`wrap` returns every word of the text, in the original order" {
  gen::check2(gen::list(gen::any_int()), gen::any_int(), |codes: List<Int>, w: Int| {
    String::join(wrap(prose(codes), 1 + within(w, 24)), " ")
      == String::join(spaced(prose(codes)), " ")
  })
}

fn word_of(codes: List<Int>) -> String / {abort.raise} = spelled(codes, "abc")

fn fewest(a: List<Char>, b: List<Char>, swaps: Bool) -> Int =
  match a {
    [] -> b.len(),
    [x, ..xs] -> match b {
      [] -> a.len(),
      [y, ..ys] -> if x == y { fewest(xs, ys, swaps) } else {
        let edited = 1
          + min(fewest(xs, b, swaps), min(fewest(a, ys, swaps), fewest(xs, ys, swaps)));
        match xs {
          [x2, ..xs2] -> match ys {
            [y2, ..ys2] -> if swaps && x == y2 && x2 == y {
              min(edited, 1 + fewest(xs2, ys2, swaps))
            } else { edited },
            [] -> edited,
          },
          [] -> edited,
        }
      },
    },
  }

type Two = { a: List<Int>, b: List<Int> }

test "`edit_distance` equals the fewest edits found by trying every possible sequence of edits" {
  gen::check(twos(), |x: Two|
    agrees(
      |p: Two| edit_distance(word_of(p.a.take(5)), word_of(p.b.take(5))),
      |p: Two| fewest(word_of(p.a.take(5)).chars(), word_of(p.b.take(5)).chars(), false),
      x,
    ))
}

test "a bounded search agrees with the distance within its limit" {
  gen::check3(
    gen::list(gen::any_int()),
    gen::list(gen::any_int()),
    gen::any_int(),
    |x: List<Int>, y: List<Int>, k: Int| {
      let a = word_of(x);
      let b = word_of(y);
      let limit = within(k, 9) - 1;
      edit_distance_within(a, b, limit)
        == (if edit_distance(a, b) <= limit { Some(edit_distance(a, b)) } else { None })
        && typo_distance_within(a, b, limit)
        == (if typo_distance(a, b) <= limit { Some(typo_distance(a, b)) } else { None })
    },
  )
}

test "`closest` returns the first of the nearest candidates within the limit, or `None` when every candidate is farther" {
  gen::check3(
    gen::list(gen::any_int()),
    gen::list(gen::list(gen::any_int())),
    gen::any_int(),
    |x: List<Int>, ys: List<List<Int>>, k: Int| {
      let word = word_of(x);
      let candidates = ys.map(|y: List<Int>| word_of(y));
      let limit = within(k, 6);
      match closest(word, candidates, limit) {
        None -> candidates.all(|c: String| typo_distance(word, c) > limit),
        Some(best) ->
          typo_distance(word, best) <= limit
            && candidates.all(|c: String| typo_distance(word, c) >= typo_distance(word, best))
            && candidates.filter(|c: String|
              typo_distance(word, c) == typo_distance(word, best)).at(
              0,
            )
            == Some(best),
      }
    },
  )
}

fn mixed(codes: List<Int>) -> String / {abort.raise} = spelled(codes, "abXY12_- .\u{e9}")

test "snake_case, kebab-case and Title Case are unchanged by a second pass, and keep the words" {
  gen::check(gen::list(gen::any_int()), |codes: List<Int>| {
    let name = mixed(codes);
    let words = name_words(name).map(String::ascii_lower);
    snake_case(snake_case(name)) == snake_case(name)
      && kebab_case(kebab_case(name)) == kebab_case(name)
      && title_case(title_case(name)) == title_case(name)
      && name_words(snake_case(name)) == words
      && name_words(kebab_case(name)) == words
      && name_words(title_case(name)).map(String::ascii_lower) == words
  })
}

test "a line of quoted words splits back into them" {
  gen::check(gen::list(gen::text()), |args: List<String>| {
    match shell_join(args) {
      Some(line) -> shell_split(line) == Some(args),
      None -> !args.all(|arg: String| !arg.contains("\0")),
    }
  })
}

test "a word a shell would treat as syntax is quoted, and splits back" {
  gen::check(gen::list(gen::any_int()), |picks: List<Int>| {
    let own = ["if", "do", "time", "in", "CC=1", "=x", "x", "", "-o=1", "~", "#"];
    let args = picks.map(|p: Int| own.at_or(within(p, 11), ""));
    match shell_join(args) { Some(line) -> shell_split(line) == Some(args), None -> false }
  })
}
