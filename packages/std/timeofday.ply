//! The `timeofday"12:30:00"` literal: a `std.date` time of day, checked when the program is
//! checked.
//!
//! A literal's tag names a module. The `date` tag already reads a date, so the time of day needs
//! a module of its own. The `Time` type and its functions are in `std.date`.

import std.date (Error, Time, time, time_literal)
import std.result

/// Checks a `timeofday"..."` literal. Returns the time that `std.date`'s `parse_time` reads, or an
/// error with the reason and the offset of the first character that is not part of a time.
pub fn literal(text: String) -> Result<Time, Error> = time_literal(text)

test "`literal` returns the time of day, or an error with the position of the first invalid character" {
  assert_eq(literal("12:30:00.25").ok(), time(12, 30, 0, 250000000));
  assert_eq(literal("12:60:00"), Err({ message: "a minute is 00 to 59", offset: 3 }))
}
