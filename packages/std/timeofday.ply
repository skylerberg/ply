//! The `timeofday"12:30:00"` literal: a `std.date` time of day, checked when the program is.
//!
//! A tag is a module, and `std.date`'s own reads a date, so the time of day has this one. The type
//! and everything done with it are `std.date`'s.

import std.date (Error, Time, time, time_literal)
import std.result

/// What a `timeofday"..."` literal is checked by: the time `std.date`'s `parse_time` reads, or why
/// the text is none and the character it stops being one at.
pub fn literal(text: String) -> Result<Time, Error> = time_literal(text)

// --- Tests ------------------------------------------------------------------

test "the check answers the time, or where the text stops being one" {
  assert_eq(literal("12:30:00.25").ok(), time(12, 30, 0, 250000000));
  assert_eq(literal("12:60:00"), Err({ message: "a minute is 00 to 59", offset: 3 }))
}
