//! Name lookups through the system's resolver, as an effect of its own.
//!
//! `dns.lookup` queries the system's resolver for a name's addresses, as connecting by name does,
//! so it reads the hosts file and whatever else the machine is configured with. It returns the
//! addresses as `std.ip` values in the resolver's order, which follows the resolver's policy. A
//! text that is already an address returns itself, with no query. `dns.reverse` returns the names
//! for an address. The system's resolver does not report how long a result stays valid, so a
//! `ResolvedAddress` from it has no `ttl`. A record that `std.resolver` reads off the wire has one.
//!
//! A name must be ASCII. To look up an internationalized name, convert it to its A-labels with
//! `ascii` in `std.idna`. Any other name fails with `not_ascii`, with no query.
//!
//! Neither operation takes a deadline, because the system's resolver has its own timeouts and
//! cannot be hurried. `resolve` and `names` limit the wait with a deadline on the clock instead:
//! when the deadline passes, the lookup's task is stopped and the result is `TimedOut`. Under
//! `simulate` the clock is virtual time. Outside `simulate` it is the real clock of the running
//! program.
//!
//! A lookup is a `read` operation. A function whose effects include `dns.lookup` may query a
//! resolver. A deterministic test handles the effect with `on_table`, from a `Table`: a resolver as
//! a value. `std.net`'s `dial` looks names up through this effect, so the table a test passes
//! decides where a name connects. `net::on_mem` handles both from one table.
//!
//! `interleave` orders addresses the way a connector should try them (RFC 8305 section 4). The two
//! address families alternate, starting with the resolver's first choice, and each family keeps its
//! given order. If one family cannot be routed, the connector wastes one attempt on it before
//! trying the other, not one attempt for every address in that family.
//!
//! Records the system's resolver does not provide (MX, TXT, SRV, CNAME) are in `std.resolver`,
//! which queries a server itself.

import std.bytes (i64_be, u32_be)
import std.internal.native (native, wait, job_wait, found, parts, decode_int)
import std.ip
import std.ip (Ip, SocketAddress, ip)
import std.list
import std.string
import std.task
import std.task (deadline)
import std.time (after, seconds)
import std.gen

/// One address a name resolves to, and how long the result stays valid when the resolver reports
/// it.
pub type ResolvedAddress = { address: Ip, ttl: Option<Duration> }

/// Why a lookup failed.
pub type Failure =
  | NoSuchName
  /// The name exists but has no records of the requested kind.
  | NoData
  /// A server failed or rejected the query.
  | ServerFailure
  /// No response came before the deadline.
  | TimedOut
  /// The resolver failed for another reason: its error code and message.
  | Other(Int, String)

/// The system's resolver.
pub nondet effect dns {
  /// The addresses of `name`, in the order the system's resolver gives them. An address written
  /// as text returns itself. Never an empty `Ok`: a name with no address is `NoData` or
  /// `NoSuchName`. It waits as long as the system's resolver does; `resolve` limits the wait.
  read lookup(name: String) -> Result<List<ResolvedAddress>, Failure>
  /// The names for `address`, most often one. `names` limits the wait.
  read reverse(address: Ip) -> Result<List<String>, Failure>
  /// The servers the system's resolver is configured to query, in its order. Empty when the host
  /// has no list to read.
  read servers() -> List<SocketAddress>
}

/// The error for a name that is not ASCII.
pub const not_ascii: Failure =
  Other(
    0,
    "the name must be ASCII: convert an internationalized name to its ASCII form (`xn--` Punycode) before the lookup",
  )

/// The addresses of `name` as `dns.lookup` returns them, or `TimedOut` when the resolver has not
/// replied within `wait`. The lookup runs as a task of its own. It is stopped at this deadline, or
/// at an enclosing deadline when that one is earlier.
pub fn resolve(
  name: String,
  wait: Duration,
) -> Result<List<ResolvedAddress>, Failure> / {dns.lookup, task.write, clock.read, clock.write, deadline.at} =
  match task::timeout(wait, || dns.lookup(name)) {
    task::Done(result) -> result,
    task::TimedOut -> Err(TimedOut),
  }

/// The names for `address` as `dns.reverse` returns them, or `TimedOut` when the resolver has not
/// replied within `wait`.
pub fn names(
  address: Ip,
  wait: Duration,
) -> Result<List<String>, Failure> / {dns.reverse, task.write, clock.read, clock.write, deadline.at} =
  match task::timeout(wait, || dns.reverse(address)) {
    task::Done(result) -> result,
    task::TimedOut -> Err(TimedOut),
  }

/// Returns the `address` of each entry in `found`, dropping the `ttl` values.
pub fn addresses(found: List<ResolvedAddress>) -> List<Ip> =
  found.map(|f: ResolvedAddress| f.address)

/// `addresses` in the order to try them: the first as given, then the families alternating, each
/// in the order it was given.
pub fn interleave(addresses: List<Ip>) -> List<Ip> =
  match addresses {
    [] -> [],
    [first, ..] -> {
      let same = addresses.filter(|a: Ip| same_family(a, first));
      let other = addresses.filter(|a: Ip| !same_family(a, first));
      alternate(same, other)
    },
  }

fn same_family(a: Ip, b: Ip) -> Bool = ip::bit_width(a) == ip::bit_width(b)

fn alternate(first: List<Ip>, second: List<Ip>) -> List<Ip> =
  match first { [] -> second, [head, ..rest] -> [head].concat(alternate(second, rest)) }

/// A resolver as a value: the result for each name and each address, and the servers it reports.
/// Names are stored in lower case without a final dot, the form they are looked up in.
pub type Table = {
  names: Map<String, Result<List<ResolvedAddress>, Failure>>,
  reversed: Map<Ip, List<String>>,
  servers: List<SocketAddress>,
}

/// A resolver that knows no name.
pub const table: Table = { names: Map::new(), reversed: Map::new(), servers: [] }

fn table_key(name: String) -> String / {abort.raise} = {
  let lower = name.ascii_lower();
  if lower.ends_with(".") { lower.slice(0, lower.len() - 1) } else { lower }
}

/// Returns the table with `name` resolving to `addresses` in that order, each with a `ttl` of
/// `None`. If `addresses` is empty, a lookup of `name` in the table fails with `NoData`.
pub fn with_name(t: Table, name: String, addresses: List<Ip>) -> Table / {abort.raise} =
  with_resolved(t, name, addresses.map(|a: Ip| { address: a, ttl: None }))

/// The table with `name` resolving to `found`, each with its own `ttl`.
pub fn with_resolved(
  t: Table,
  name: String,
  found: List<ResolvedAddress>,
) -> Table / {abort.raise} =
  {
    ..t,
    names: t.names.insert(table_key(name), if found.len() == 0 { Err(NoData) } else { Ok(found) }),
  }

/// The table with a lookup of `name` failing with `reason`.
pub fn with_failure(t: Table, name: String, reason: Failure) -> Table / {abort.raise} =
  { ..t, names: t.names.insert(table_key(name), Err(reason)) }

/// The table with `names` as the names for `address`.
pub fn with_reverse(t: Table, address: Ip, names: List<String>) -> Table =
  { ..t, reversed: t.reversed.insert(address, names) }

/// The table reporting `servers` as its servers.
pub fn with_servers(t: Table, servers: List<SocketAddress>) -> Table = { ..t, servers: servers }

fn lookup_with<| e>(
  name: String,
  ask: (String) -> Result<List<ResolvedAddress>, Failure> / e,
) -> Result<List<ResolvedAddress>, Failure> / {abort.raise | e} =
  match ip::parse(name) {
    Ok(address) -> Ok([{ address: address, ttl: None }]),
    Err(_) -> if !name.is_ascii() { Err(not_ascii) } else { ask(name) },
  }

/// What `dns.lookup` returns from the table. An address written as text returns itself. A name
/// that is not ASCII fails as it does on the host. A name in the table returns what it was given,
/// and any other name is `NoSuchName`.
pub fn table_lookup(
  t: Table,
  name: String,
) -> Result<List<ResolvedAddress>, Failure> / {abort.raise} =
  lookup_with(name, |queried_name: String|
    match t.names.get(table_key(queried_name)) { Some(result) -> result, None -> Err(NoSuchName) })

/// What `dns.reverse` returns from the table.
pub fn table_reverse(t: Table, address: Ip) -> Result<List<String>, Failure> =
  match t.reversed.get(address) {
    Some(names) -> if names.len() == 0 { Err(NoData) } else { Ok(names) },
    None -> Err(NoSuchName),
  }

/// Runs `go`, handling every lookup from the table without waiting.
pub fn on_table<a | e>(
  t: Table,
  go: () -> a / {dns.lookup, dns.reverse, dns.servers | e},
) -> a / {abort.raise | e bounded} =
  handle {
    go()
  } with {
    dns.lookup(name) -> table_lookup(t, name),
    dns.reverse(address) -> table_reverse(t, address),
    dns.servers() -> t.servers,
  }

host for dns by served

fn served<a | e>(go: () -> a / {dns.read | e}) -> a / {native.read, wait.read, abort.raise | e} =
  handle {
    go()
  } with {
    dns.lookup(name) ->
      lookup_with(name, |queried_name: String|
        decode_addresses(job_wait(dns_lookup(queried_name)))),
    dns.reverse(address) -> decode_names(job_wait(dns_reverse(ip::to_bytes(address)))),
    dns.servers() -> match found(dns_configuration()) {
      Some(text) -> parse_servers(String::of_bytes_lossy(text)),
      None -> [],
    },
  }

extern fn dns_lookup(name: String) -> Int / {native.read}

extern fn dns_reverse(address: Bytes) -> Int / {native.read}

extern fn dns_configuration() -> Bytes / {native.read}

fn decode_addresses(reply: Bytes) -> Result<List<ResolvedAddress>, Failure> / {abort.raise} =
  if reply.at(0) == 1 {
    Ok(
      parts(reply.slice(1, reply.len())).fold([], |accumulator: List<ResolvedAddress>, b: Bytes|
        match ip::of_bytes(b) {
          Some(a) -> accumulator.push({ address: a, ttl: None }),
          None -> accumulator,
        }),
    )
  } else { Err(decode_failure(reply)) }

fn decode_names(reply: Bytes) -> Result<List<String>, Failure> / {abort.raise} =
  if reply.at(0) == 1 {
    Ok(parts(reply.slice(1, reply.len())).map(|name: Bytes| String::of_bytes_lossy(name)))
  } else { Err(decode_failure(reply)) }

fn decode_failure(reply: Bytes) -> Failure / {abort.raise} =
  match reply.at(1) {
    1 -> NoSuchName,
    2 -> NoData,
    3 -> ServerFailure,
    _ -> match parts(reply.slice(2, reply.len())) {
      [code, words] -> Other(decode_int(code), String::of_bytes_lossy(words)),
      _ -> Other(0, String::of_bytes_lossy(reply.slice(2, reply.len()))),
    },
  }

/// Returns the servers listed by the `nameserver` lines of a resolver configuration, in order, each
/// on the DNS port 53. Skips a `nameserver` line whose address cannot be parsed.
pub fn parse_servers(configuration: String) -> List<SocketAddress> / {abort.raise} =
  configuration.lines().fold([], |accumulator: List<SocketAddress>, line: String|
    match line.words() {
      [word, server, ..] -> if word != "nameserver" { accumulator }
      else { match parse_server(server) { Some(at) -> accumulator.push(at), None -> accumulator } },
      _ -> accumulator,
    })

fn parse_server(server: String) -> Option<SocketAddress> / {abort.raise} =
  match server.split_once("%") {
    None -> match ip::parse(server) { Ok(a) -> Some(ip::socket_at(a, 53)), Err(_) -> None },
    Some(split) -> match ip::parse(split.head) {
      Ok(a) -> ip::in_zone(ip::socket_at(a, 53), split.tail),
      Err(_) -> None,
    },
  }

test "`parse_servers` returns nameserver addresses in file order with port 53, including an IPv6 zone, and skips other lines" {
  let named = parse_servers(
    "# the network's\nsearch example.org\nnameserver 192.0.2.53\nnameserver fe80::1%en0\nnameserver   2001:db8::53 # trailing\nnameserver not-an-address\noptions ndots:2\n",
  );
  assert_eq(named.map(ip::render_socket), [
    "192.0.2.53:53",
    "[fe80::1%en0]:53",
    "[2001:db8::53]:53",
  ])
}

test "the resolver's replies decode to the failures and addresses they encode" {
  let address = ip::read("192.0.2.7");
  assert_eq(
    decode_addresses(Bytes::concat_all([b"\x01", u32_be(4), ip::to_bytes(address)])),
    Ok([{ address: address, ttl: None }]),
  );
  assert_eq(decode_addresses(b"\x00\x01"), Err(NoSuchName));
  assert_eq(decode_names(b"\x00\x02"), Err(NoData));
  assert_eq(decode_names(b"\x00\x03"), Err(ServerFailure));
  assert_eq(
    decode_names(Bytes::concat_all([b"\x00\x04", u32_be(8), i64_be(-2), u32_be(4), b"gone"])),
    Err(Other(-2, "gone")),
  );
  assert_eq(
    decode_names(Bytes::concat_all([b"\x01", u32_be(11), b"example.org"])),
    Ok(["example.org"]),
  )
}

fn interleaved(written: List<String>) -> List<String> / {ip.fail, abort.raise} =
  interleave(written.map(ip::read)).map(ip::render)

test "`interleaved` alternates IPv6 and IPv4 addresses, starting with the family of the first address and preserving each family's order" {
  assert_eq(interleaved([]), []);
  assert_eq(interleaved(["192.0.2.1"]), ["192.0.2.1"]);
  assert_eq(
    interleaved(["2001:db8::1", "2001:db8::2", "2001:db8::3", "192.0.2.1", "192.0.2.2"]),
    ["2001:db8::1", "192.0.2.1", "2001:db8::2", "192.0.2.2", "2001:db8::3"],
  );
  assert_eq(interleaved(["192.0.2.1", "192.0.2.2", "2001:db8::1"]), [
    "192.0.2.1",
    "2001:db8::1",
    "192.0.2.2",
  ]);
  assert_eq(interleaved(["192.0.2.1", "192.0.2.2"]), ["192.0.2.1", "192.0.2.2"])
}

test "`interleave` returns the same addresses, with the first address of the input still first" {
  gen::check(gen::list(ip::arbitrary()), |addresses: List<Ip>| {
    let ordered = interleave(addresses);
    ordered.sort() == addresses.sort() && ordered.take(1) == addresses.take(1)
  })
}

fn example() -> Table / {ip.fail, abort.raise} =
  with_reverse(
    with_failure(
      with_name(
        with_name(table, "Example.ORG.", [ip::read("2001:db8::7"), ip::read("192.0.2.7")]),
        "empty.example",
        [],
      ),
      "slow.example",
      TimedOut,
    ),
    ip::read("192.0.2.7"),
    ["example.org"],
  )

test "a test DNS table resolves names ignoring case and a final dot, returns an IP address unchanged, and returns an error for other names" {
  let found = on_table(example(), ||
    [
      dns.lookup("example.org"),
      dns.lookup("EXAMPLE.org."),
      dns.lookup("192.0.2.9"),
      dns.lookup("empty.example"),
      dns.lookup("slow.example"),
      dns.lookup("absent.example"),
    ]);
  let both = Ok([
    { address: ip::read("2001:db8::7"), ttl: None },
    { address: ip::read("192.0.2.7"), ttl: None },
  ]);
  assert_eq(found, [
    both,
    both,
    Ok([{ address: ip::read("192.0.2.9"), ttl: None }]),
    Err(NoData),
    Err(TimedOut),
    Err(NoSuchName),
  ])
}

test "a test DNS table returns the names for an address, and returns the servers configured on the table" {
  let results = on_table(with_servers(example(), [ip::read_socket("192.0.2.53:53")]), || {
    {
      known: dns.reverse(ip::read("192.0.2.7")),
      unknown_effect: dns.reverse(ip::read("192.0.2.8")),
      servers: dns.servers(),
    }
  });
  assert_eq(results.known, Ok(["example.org"]));
  assert_eq(results.unknown_effect, Err(NoSuchName));
  assert_eq(results.servers.map(ip::render_socket), ["192.0.2.53:53"])
}

test "a name that is not ASCII fails without a lookup" {
  let named = with_name(table, "bücher.example", [ip::read("192.0.2.7")]);
  assert_eq(on_table(named, || dns.lookup("bücher.example")), Err(not_ascii));
  assert_eq(on_table(named, || dns.lookup("xn--bcher-kva.example")), Err(NoSuchName))
}

fn slow_resolver<a | e>(
  takes: Duration,
  at: Ip,
  go: () -> a / {dns.lookup, dns.reverse | e},
) -> a / {clock.write | e} =
  handle {
    go()
  } with {
    dns.lookup(name) -> {
      clock.sleep(takes);
      Ok([{ address: at, ttl: None }])
    },
    dns.reverse(address) -> {
      clock.sleep(takes);
      Ok(["example.org"])
    },
  }

type WaitCase = { wait: Int, outcome: String }

const waits: List<WaitCase> =
  [
    { wait: 5, outcome: "returns when the resolver replies" },
    { wait: 2, outcome: "is given up on at the deadline" },
  ]

test "a lookup that takes three seconds, waited on for {c.wait}, {c.outcome}" for c: WaitCase in waits {
  simulate {
    let at = ip::read("192.0.2.7");
    let began = clock.now();
    let found = slow_resolver(seconds(3), at, ||
      task::unbounded(|| resolve("example.org", seconds(c.wait))));
    assert_eq(found, if c.wait > 3 { Ok([{ address: at, ttl: None }]) } else { Err(TimedOut) });
    assert_eq(clock.now(), after(began, seconds(min(c.wait, 3))))
  }
}

test "a reverse lookup that takes three seconds, waited on for {c.wait}, {c.outcome}" for c: WaitCase in waits {
  simulate {
    let at = ip::read("192.0.2.7");
    let began = clock.now();
    let named = slow_resolver(seconds(3), at, || task::unbounded(|| names(at, seconds(c.wait))));
    assert_eq(named, if c.wait > 3 { Ok(["example.org"]) } else { Err(TimedOut) });
    assert_eq(clock.now(), after(began, seconds(min(c.wait, 3))))
  }
}

test "`resolve` times out at an enclosing `task::timeout` when that deadline is earlier than the lookup's own timeout" {
  simulate {
    let outcome = slow_resolver(seconds(3), ip::read("192.0.2.7"), ||
      task::unbounded(|| task::timeout(seconds(1), || resolve("example.org", seconds(5)))));
    assert_eq(outcome, task::TimedOut)
  }
}
