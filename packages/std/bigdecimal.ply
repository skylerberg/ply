//! Decimal numbers of any size: a `BigInt` and the number of its digits that follow the point.
//!
//! A `BigDecimal` is `unscaled / 10^scale`, as a `Decimal` is, with no limit on either part. The
//! scale is never negative: a value that would need a negative scale is stored at scale zero with
//! its zeros written out. The type is opaque, so only this module builds values: `of_parts`, a
//! conversion or `read` makes one, and `arbitrary` generates them for tests.
//!
//! A value keeps the scale it was written or computed at, but equality ignores the scale. The type
//! declares a `key`, which is the value that decides equality, ordering and hashing, so `1.5` and
//! `1.50` are `==`, sort as the same number, have the same `digest` and are the same `Map` key.
//! (`Decimal` literals `1.5m` and `1.50m` behave the same way.) `to_string`, which `show` uses,
//! tells them apart, `scale` returns the scale, and `strip_trailing_zeros` removes zeros a value
//! does not need. `compare` here gives the same result as the language's comparison and is cheaper,
//! because the language's comparison builds a key from the digits first.
//!
//! Addition, subtraction and multiplication are exact, and the type's `numeric` makes them the
//! operators. A sum has the larger of the two scales and a product has the sum of the two scales,
//! even when an operand is zero. A `Decimal` instead returns the other operand unchanged when one
//! is zero, and writes a zero product as `0`. An operation that cannot be exact takes arguments
//! saying where to stop and how to round, and does not read any ambient context. Where to stop is a
//! number of places after the point (a negative number counts whole tens) or a precision in
//! significant digits. How to round is the prelude's `Rounding`, which means the same here as for
//! `Decimal::div`. A quotient or root to a precision follows the General Decimal Arithmetic
//! specification: it is written at the precision where it is rounded, without zeros an exact result
//! does not need.

import std.bigint
import std.bigint (BigInt)
import std.bytes
import std.decimal
import std.gen
import std.gen (Gen)
import std.list
import std.option
import std.rational
import std.rational (Rational)
import std.result

/// A decimal number: its digits as a whole number, and how many of them follow the point, which
/// is never negative.
pub opaque type BigDecimal = | BigDecimal(BigInt, Int)

key for BigDecimal by order_key

show for BigDecimal by to_string

numeric for BigDecimal by { add: add, sub: sub, mul: mul, neg: neg, of_int: of_int }

/// Why a text is not a decimal number.
pub type ErrorKind =
  /// A character that cannot be part of a number, or the text ending where a digit is expected.
  | UnexpectedCharacter
  /// An exponent past the bound the reader was given.
  | TooWide

/// Why a text was rejected, and the offset of the character at fault.
pub type Error = new { at: Int, reason: ErrorKind }

/// The error this module raises.
pub effect bigdecimal {
  /// The text is not a decimal number within the reader's bound.
  raise fail(e: Error)
}

/// Generates random values for tests: either a `BigInt` from `std.bigint` with up to forty places
/// after the point, or a small whole number with up to three places. The small ones often equal
/// another generated value at a different scale.
pub fn arbitrary() -> Gen<BigDecimal> =
  gen::one_of([
    gen::map2(bigint::arbitrary(), gen::int_between(0, 40), |digits: BigInt, places: Int|
      BigDecimal(digits, places)),
    gen::map2(gen::int_between(0 - 200, 200), gen::int_between(0, 3), |digits: Int, places: Int|
      BigDecimal(bigint::of_int(digits), places)),
  ])

/// Zero, at scale zero.
pub fn zero() -> BigDecimal = BigDecimal(bigint::zero(), 0)

/// One, at scale zero.
pub fn one() -> BigDecimal = BigDecimal(bigint::one(), 0)

/// The whole number `n`, at scale zero.
pub fn of_int(n: Int) -> BigDecimal = BigDecimal(bigint::of_int(n), 0)

/// The whole number `n`, at scale zero.
pub fn of_bigint(n: BigInt) -> BigDecimal = BigDecimal(n, 0)

/// `unscaled / 10^scale`, at that scale. A scale below zero multiplies by that many tens, and the
/// value is stored at scale zero with the zeros written out.
pub fn of_parts(unscaled: BigInt, scale: Int) -> BigDecimal =
  if scale >= 0 { BigDecimal(unscaled, scale) } else { BigDecimal(unscaled * ten_to(0 - scale), 0) }

/// The digits as a whole number: the value times `10^scale`.
pub fn unscaled(value: BigDecimal) -> BigInt = match value { BigDecimal(digits, _) -> digits }

/// How many digits follow the point.
pub fn scale(value: BigDecimal) -> Int = match value { BigDecimal(_, places) -> places }

/// How many digits the unscaled value has, one for zero: its significant digits, counting
/// trailing zeros.
pub fn precision(value: BigDecimal) -> Int = digits_of(value).len()

/// Whether the value is zero, at any scale.
pub fn is_zero(value: BigDecimal) -> Bool = bigint::is_zero(unscaled(value))

/// Whether the value is below zero.
pub fn is_negative(value: BigDecimal) -> Bool = bigint::is_negative(unscaled(value))

/// `-1`, `0` or `1`.
pub fn sign(value: BigDecimal) -> Int = bigint::sign(unscaled(value))

/// `a + b`, exactly, at the larger of the two scales.
pub fn add(a: BigDecimal, b: BigDecimal) -> BigDecimal = {
  let places = max(scale(a), scale(b));
  BigDecimal(unscaled_at(a, places) + unscaled_at(b, places), places)
}

/// `a - b`, exactly, at the larger of the two scales.
pub fn sub(a: BigDecimal, b: BigDecimal) -> BigDecimal = add(a, neg(b))

/// `a * b`, exactly, at the sum of the two scales.
pub fn mul(a: BigDecimal, b: BigDecimal) -> BigDecimal =
  BigDecimal(unscaled(a) * unscaled(b), scale(a) + scale(b))

/// The value with its sign flipped, at its scale.
pub fn neg(value: BigDecimal) -> BigDecimal = BigDecimal(bigint::neg(unscaled(value)), scale(value))

/// The distance from zero, at the value's scale.
pub fn abs(value: BigDecimal) -> BigDecimal =
  BigDecimal(bigint::abs_value(unscaled(value)), scale(value))

/// The value to a whole power, exactly, at its scale times the exponent; `None` for an exponent
/// below zero, whose result need not be a decimal number.
pub fn pow(value: BigDecimal, exponent: Int) -> Option<BigDecimal> =
  if exponent < 0 { None }
  else { Some(BigDecimal(power(unscaled(value), exponent), scale(value) * exponent)) }

/// The order of the numbers, whatever their scales.
pub fn compare(a: BigDecimal, b: BigDecimal) -> Ordering = {
  let places = max(scale(a), scale(b));
  bigint::compare(unscaled_at(a, places), unscaled_at(b, places))
}

/// The same value at the smallest scale that represents it: `1.50` is `1.5`, and `2.00` and
/// `0.000` are `2` and `0`.
pub fn strip_trailing_zeros(value: BigDecimal) -> BigDecimal = trimmed(value, 0)

/// The value at no more than `places` digits after the point, rounded by `mode`. A value with no
/// more digits than that is returned unchanged, without added zeros; `rescale` adds them. A
/// negative `places` rounds to that many whole tens.
pub fn round(value: BigDecimal, places: Int, mode: Rounding) -> BigDecimal =
  if places >= scale(value) { value }
  else { rounded_ratio(unscaled(value), ten_to(scale(value)), places, mode) }

/// The value at exactly `places` digits after the point: rounded by `mode` where it has more, and
/// with zeros added where it has fewer. A negative `places` rounds to that many whole tens, stored
/// at scale zero.
pub fn rescale(value: BigDecimal, places: Int, mode: Rounding) -> BigDecimal =
  if places >= scale(value) { BigDecimal(unscaled_at(value, places), places) }
  else { round(value, places, mode) }

/// Returns the value rounded by `mode` to the scale of `like`. Only the scale of `like` is used,
/// not its digits.
pub fn quantize(value: BigDecimal, like: BigDecimal, mode: Rounding) -> BigDecimal =
  rescale(value, scale(like), mode)

/// Returns the value rounded by `mode` to at most `digits` significant digits. A value that already
/// has at most that many digits is returned unchanged. A `digits` below one is treated as one.
pub fn round_to_precision(value: BigDecimal, digits: Int, mode: Rounding) -> BigDecimal =
  if precision(value) <= max(digits, 1) { value } else {
    trim_overflow_digit(
      ratio_to_precision(unscaled(value), ten_to(scale(value)), digits, mode),
      digits,
    )
  }

/// `a / b` at exactly `places` digits after the point, rounded by `mode`: the number `Decimal::div`
/// returns, with zeros written to fill the scale. A negative `places` rounds to that many whole
/// tens. `None` for a zero divisor.
pub fn div(a: BigDecimal, b: BigDecimal, places: Int, mode: Rounding) -> Option<BigDecimal> =
  if is_zero(b) { None } else {
    Some(
      rounded_ratio(unscaled(a) * ten_to(scale(b)), unscaled(b) * ten_to(scale(a)), places, mode),
    )
  }

/// Returns `a / b` rounded by `mode` to `digits` significant digits, or `None` for a zero divisor.
/// A quotient that is exact in fewer digits is written without the extra zeros, down to the scale
/// of `a` minus that of `b`. A `digits` below one is treated as one.
pub fn div_to_precision(
  a: BigDecimal,
  b: BigDecimal,
  digits: Int,
  mode: Rounding,
) -> Option<BigDecimal> =
  if is_zero(b) { None }
  else if is_zero(a) { Some(BigDecimal(bigint::zero(), max(scale(a) - scale(b), 0))) } else {
    let quotient = ratio_to_precision(
      unscaled(a) * ten_to(scale(b)),
      unscaled(b) * ten_to(scale(a)),
      digits,
      mode,
    );
    if compare(mul(quotient, b), a) == Equal { Some(trimmed(quotient, scale(a) - scale(b))) }
    else { Some(trim_overflow_digit(quotient, digits)) }
  }

/// `a / b` when it is a decimal number, at the smallest scale that represents it. `None` when its
/// digits never end, as a third's do not, and for a zero divisor.
pub fn div_exact(a: BigDecimal, b: BigDecimal) -> Option<BigDecimal> =
  match rational::div(to_rational(a), to_rational(b)) {
    Some(quotient) -> of_rational_exact(quotient),
    None -> None,
  }

/// The square root at exactly `places` digits after the point, rounded by `mode`; `None` for a
/// value below zero.
pub fn sqrt(value: BigDecimal, places: Int, mode: Rounding) -> Option<BigDecimal> =
  if is_negative(value) { None } else { Some(root(value, places, mode)) }

/// Returns the square root of `value` at `digits` significant digits, rounded by `mode`; a `digits`
/// below one counts as one. A root that is exact in fewer digits is written without the extra
/// trailing zeros, but never with fewer digits after the point than half of `scale(value)` rounded
/// up. Returns `None` for a negative value.
pub fn sqrt_to_precision(value: BigDecimal, digits: Int, mode: Rounding) -> Option<BigDecimal> =
  if is_negative(value) { None }
  else if is_zero(value) { Some(BigDecimal(bigint::zero(), (scale(value) + 1) / 2)) } else {
    let found = root(value, max(digits, 1) - half_up(precision(value) - scale(value)), mode);
    if compare(mul(found, found), value) == Equal { Some(trimmed(found, (scale(value) + 1) / 2)) }
    else { Some(trim_overflow_digit(found, digits)) }
  }

/// Returns the `BigDecimal` with the same number and the same scale as `d`.
pub fn of_decimal(d: Decimal) -> BigDecimal / {abort.raise} =
  match parse(d.to_string(), 0) { Ok(value) -> value, Err(_) -> zero() }

/// The value as a `Decimal`: at its own scale when a `Decimal` can store that, and otherwise
/// without its trailing zeros. `None` when it fits neither way: more than 28 digits after the
/// point even without trailing zeros, or digits that need more than 96 bits.
pub fn to_decimal(value: BigDecimal) -> Option<Decimal> =
  match Decimal::of_string(to_string(value)) {
    Some(d) -> Some(d),
    None -> Decimal::of_string(to_string(strip_trailing_zeros(value))),
  }

/// The fraction the value is, exactly.
pub fn to_rational(value: BigDecimal) -> Rational =
  match rational::ratio(unscaled(value), ten_to(scale(value))) {
    Some(r) -> r,
    None -> rational::zero(),
  }

/// The fraction at `places` digits after the point, rounded by `mode`.
pub fn of_rational(r: Rational, places: Int, mode: Rounding) -> BigDecimal =
  rounded_ratio(rational::numerator(r), rational::denominator(r), places, mode)

/// The fraction as a decimal number, at the smallest scale that represents it. `None` when its
/// denominator has a factor other than two and five, so its digits never end.
pub fn of_rational_exact(r: Rational) -> Option<BigDecimal> = {
  let left = bigint::bit_length(rational::denominator(r)) + 1;
  let twos = without_factor(rational::denominator(r), 2, 0, left);
  let fives = without_factor(twos.rest, 5, 0, left);
  let places = max(twos.count, fives.count);
  if bigint::compare(fives.rest, bigint::one()) != Equal { None }
  else { Some(of_rational(r, places, Down)) }
}

/// The `Float`'s value, exactly, which every finite one has as a decimal number; `None` for a
/// `NaN` and for an infinity.
pub fn of_float(f: Float) -> Option<BigDecimal> =
  match rational::of_float(f) { Some(r) -> of_rational_exact(r), None -> None }

/// The `Float` nearest the value, a tie going to the one whose last bit is zero.
pub fn to_float(value: BigDecimal) -> Float = rational::to_float(to_rational(value))

/// The value in plain decimal at its scale, so `1.50` is written `1.50`, with a leading `-` when
/// negative and a zero before a point that would otherwise lead.
pub fn to_string(value: BigDecimal) -> String = {
  let digits = digits_of(value);
  let padded = if digits.len() > scale(value) { digits } else {
    digits.fold(
      range(0, scale(value) + 1 - digits.len()).map(|_i: Int| '0'),
      |all: List<Char>, c: Char| all.push(c),
    )
  };
  let whole = padded.take(padded.len() - scale(value));
  let signed = if is_negative(value) { whole.fold(['-'], |all: List<Char>, c: Char| all.push(c)) }
  else { whole };
  String::of_chars(if scale(value) == 0 { signed } else {
    padded.drop(padded.len() - scale(value)).fold(signed.push('.'), |all: List<Char>, c: Char|
      all.push(c))
  })
}

/// Returns the value in scientific notation: its digits with a point after the first digit, then
/// `E`, a sign, and the exponent that makes the first digit's place a power of ten. `123.45` gives
/// `1.2345E+2` and `0.00` gives `0E-2`.
pub fn to_scientific(value: BigDecimal) -> String = {
  let digits = digits_of(value);
  let power = digits.len() - 1 - scale(value);
  let lead = if is_negative(value) { ['-'] } else { [] };
  let first = lead.push(digits.at_or(0, '0'));
  let mantissa = if digits.len() == 1 { first }
  else { digits.drop(1).fold(first.push('.'), |all: List<Char>, c: Char| all.push(c)) };
  String::of_chars(mantissa) ++ (if power < 0 { "E-" } else { "E+" })
    ++ Int::to_string(if power < 0 { 0 - power } else { power })
}

/// The number a text represents: digits with an optional sign before them, an optional point
/// among them, and an optional exponent after them (`e` or `E` and a whole number), as
/// `Decimal::of_string` reads one. The scale is the number of digits after the point minus the
/// exponent. Raises `fail` for any other text, at the first character that cannot be part of a
/// number. Also raises for an exponent past `max_exponent` in either direction, since
/// `1e1000000000` would be written out in full.
pub fn read(text: String, max_exponent: Int) -> BigDecimal / {bigdecimal.fail, abort.raise} = {
  let bytes = Bytes::of_string(text);
  let from = if is_sign(bytes.peek(0)) { 1 } else { 0 };
  let whole_end = bytes.skip(from, b"0123456789");
  let part_from = if bytes.peek(whole_end) == 46 { whole_end + 1 } else { whole_end };
  let part_end = bytes.skip(part_from, b"0123456789");
  if whole_end - from + part_end - part_from == 0 { fail(part_end, UnexpectedCharacter) } else {
    let digits = bytes.slice(from, whole_end) ++ bytes.slice(part_from, part_end);
    let magnitude = match bigint::of_string(String::of_bytes(digits)) {
      Some(n) -> n,
      None -> bigint::zero(),
    };
    let coefficient = if bytes.peek(0) == 45 { bigint::neg(magnitude) } else { magnitude };
    if part_end == bytes.len() { of_parts(coefficient, part_end - part_from) }
    else if bytes.peek(part_end) != 69 && bytes.peek(part_end) != 101 {
      fail(part_end, UnexpectedCharacter)
    } else {
      let exponent = read_exponent(bytes, part_end + 1, max_exponent);
      of_parts(coefficient, part_end - part_from - exponent)
    }
  }
}

/// The number a text represents, as `read` reads it under the same bound, or why it is not one.
pub fn parse(text: String, max_exponent: Int) -> Result<BigDecimal, Error> / {abort.raise} =
  try { read(text, max_exponent) }

/// Checks a `bigdecimal"..."` literal. Returns the number `read` reads with exponents up to 6144,
/// or an error with the reason and the offset where the text stops being a number.
pub fn literal(
  text: String,
) -> Result<BigDecimal, { message: String, offset: Int }> / {abort.raise} =
  match parse(text, 6144) {
    Ok(value) -> Ok(value),
    Err(e) ->
      Err({
        message: match e.reason {
          UnexpectedCharacter ->
            "a decimal number is digits, with an optional sign, point and exponent",
          TooWide -> "an exponent is at most 6144 either way",
        },
        offset: e.at,
      }),
  }

fn fail<a>(at: Int, reason: ErrorKind) -> a / {bigdecimal.fail} =
  bigdecimal.fail({ at: at, reason: reason })

fn is_sign(byte: Int) -> Bool = byte == 43 || byte == 45

fn read_exponent(
  bytes: Bytes,
  from: Int,
  max_exponent: Int,
) -> Int / {bigdecimal.fail, abort.raise} = {
  let digits_from = if is_sign(bytes.peek(from)) { from + 1 } else { from };
  let end = bytes.skip(digits_from, b"0123456789");
  if end == digits_from || end != bytes.len() { fail(end, UnexpectedCharacter) } else {
    match bytes.slice(digits_from, end).int_of_ascii() {
      Some(n) -> if n > max_exponent { fail(from, TooWide) }
      else if bytes.peek(from) == 45 { 0 - n }
      else { n },
      None -> fail(from, TooWide),
    }
  }
}

fn power(base: BigInt, exponent: Int) -> BigInt =
  handle { bigint::pow(base, exponent) } with { abort.raise(_) -> bigint::zero() }

fn ten_to(k: Int) -> BigInt = power(bigint::of_int(10), k)

fn unscaled_at(value: BigDecimal, places: Int) -> BigInt =
  unscaled(value) * ten_to(places - scale(value))

fn digits_of(value: BigDecimal) -> List<Char> =
  bigint::to_string(bigint::abs_value(unscaled(value))).chars()

fn zeros_ending(digits: List<Char>) -> Int =
  range(0, digits.len()).fold(0, |count: Int, k: Int|
    if count == k && digits.at_or(digits.len() - 1 - k, '1') == '0' { k + 1 } else { count })

fn trimmed(value: BigDecimal, least: Int) -> BigDecimal = {
  let minimum_scale = max(least, 0);
  let cut = min(zeros_ending(digits_of(value)), scale(value) - minimum_scale);
  if is_zero(value) { BigDecimal(bigint::zero(), min(scale(value), minimum_scale)) }
  else if cut <= 0 { value }
  else { rounded_ratio(unscaled(value), ten_to(scale(value)), scale(value) - cut, Down) }
}

fn rounded_ratio(n: BigInt, d: BigInt, places: Int, mode: Rounding) -> BigDecimal = {
  let rounded = if places >= 0 { bigint::div_round(n * ten_to(places), d, mode) }
  else { bigint::div_round(n, d * ten_to(0 - places), mode) };
  of_parts(match rounded { Some(q) -> q, None -> bigint::zero() }, places)
}

fn ratio_to_precision(n: BigInt, d: BigInt, digits: Int, mode: Rounding) -> BigDecimal =
  rounded_ratio(
    n,
    d,
    max(digits, 1) - quotient_integer_digits(bigint::abs_value(n), bigint::abs_value(d)),
    mode,
  )

fn quotient_integer_digits(n: BigInt, d: BigInt) -> Int = {
  let apart = bigint::to_string(n).len() - bigint::to_string(d).len();
  let has_extra_digit = if apart >= 0 { bigint::compare(n, d * ten_to(apart)) != Less }
  else { bigint::compare(n * ten_to(0 - apart), d) != Less };
  if has_extra_digit { apart + 1 } else { apart }
}

fn trim_overflow_digit(value: BigDecimal, digits: Int) -> BigDecimal =
  if precision(value) > max(digits, 1) && scale(value) > 0 {
    rounded_ratio(unscaled(value), ten_to(scale(value)), scale(value) - 1, Down)
  } else { value }

fn half_up(n: Int) -> Int = if n >= 0 { (n + 1) / 2 } else { 0 - (0 - n) / 2 }

fn root(value: BigDecimal, places: Int, mode: Rounding) -> BigDecimal = {
  let shift = 2 * (places + 1) - scale(value);
  let whole = if shift >= 0 { { q: unscaled(value) * ten_to(shift), r: bigint::zero() } } else {
    match bigint::div_mod(unscaled(value), ten_to(0 - shift)) {
      Some(split) -> split,
      None -> { q: bigint::zero(), r: bigint::zero() },
    }
  };
  let found = match bigint::isqrt(whole.q) { Some(r) -> r, None -> bigint::zero() };
  let dropped = !bigint::is_zero(whole.r) || bigint::compare(found * found, whole.q) != Equal;
  of_parts(guarded(found, dropped, mode), places)
}

fn guarded(with_guard: BigInt, dropped: Bool, mode: Rounding) -> BigInt =
  match bigint::div_mod(with_guard, bigint::of_int(10)) {
    None -> with_guard,
    Some(split) -> {
      let guard = match bigint::to_int(split.r) { Some(g) -> g, None -> 0 };
      let up = match mode {
        Down -> false,
        Floor -> false,
        Up -> guard > 0 || dropped,
        Ceiling -> guard > 0 || dropped,
        HalfUp -> guard >= 5,
        HalfEven -> guard > 5 || (guard == 5 && (dropped || bigint::test_bit(split.q, 0))),
      };
      if up { split.q + bigint::one() } else { split.q }
    },
  }

fn without_factor(n: BigInt, p: Int, count: Int, left: Int) -> { rest: BigInt, count: Int } =
  if left <= 0 { { rest: n, count: count } } else {
    match bigint::div_mod(n, bigint::of_int(p)) {
      Some(split) -> if bigint::is_zero(split.r) && !bigint::is_zero(n) {
        without_factor(split.q, p, count + 1, left - 1)
      } else { { rest: n, count: count } },
      None -> { rest: n, count: count },
    }
  }

fn order_key(value: BigDecimal) -> (Int, Int, List<Int>) = {
  let digits = digits_of(value);
  let significant_digits = digits.take(digits.len() - zeros_ending(digits));
  if is_zero(value) { (0, 0, []) } else if is_negative(value) {
    (
      0 - 1,
      scale(value) - digits.len(),
      significant_digits.map(|c: Char| 0 - Int::of_char(c)).push(1),
    )
  } else { (1, digits.len() - scale(value), significant_digits.map(|c: Char| Int::of_char(c))) }
}

fn big_decimal(text: String) -> BigDecimal / {abort.raise} =
  match parse(text, 400) { Ok(value) -> value, Err(_) -> panic("a decimal number") }

fn text_of(value: Option<BigDecimal>) -> String =
  match value { Some(v) -> to_string(v), None -> "none" }

test "a `BigDecimal` retains its scale, and a scale below zero is stored as the whole number with trailing zeros" {
  assert_eq(to_string(of_parts(bigint::of_int(150), 2)), "1.50");
  assert_eq(to_string(of_parts(bigint::of_int(0 - 5), 3)), "-0.005");
  assert_eq(to_string(of_parts(bigint::of_int(12), 0 - 3)), "12000");
  assert_eq(scale(of_parts(bigint::of_int(12), 0 - 3)), 0);
  assert_eq(to_string(of_int(0 - 42)), "-42");
  assert_eq(to_string(zero()), "0");
  assert_eq(to_string(of_parts(bigint::zero(), 2)), "0.00");
  assert_eq(unscaled(big_decimal("1.50")), bigint::of_int(150));
  assert_eq(scale(big_decimal("1.50")), 2);
  assert_eq(["0", "0.00", "1.50", "-123.456", "100"].map(|t: String| precision(big_decimal(t))), [
    1,
    1,
    3,
    6,
    3,
  ]);
  assert(
    is_zero(big_decimal("0.000")) && is_negative(big_decimal("-0.1"))
      && !is_negative(big_decimal("0.0")),
  );
  assert_eq(["-0.1", "0.00", "7"].map(|t: String| sign(big_decimal(t))), [0 - 1, 0, 1])
}

test "equality, order, digest and `Map` lookup ignore the scale, but `to_string` and formatting still show it" {
  assert(big_decimal("1.5") == big_decimal("1.50") && big_decimal("1.5") != big_decimal("1.51"));
  assert_eq(digest(big_decimal("1.5")), digest(big_decimal("1.500")));
  assert_eq(digest(big_decimal("0")), digest(big_decimal("0.00")));
  assert_eq(f"{big_decimal("1.5")} and {big_decimal("1.50")}", "1.5 and 1.50");
  let ordered = [
    "-100",
    "-12.5",
    "-12.34",
    "-1.234",
    "-0.001",
    "0",
    "0.0009",
    "0.001",
    "0.12",
    "0.123",
    "9",
    "10",
    "10.01",
  ].map(
    big_decimal,
  );
  let keyed = ordered.fold(Map::new(), |m: Map<BigDecimal, Int>, v: BigDecimal| m.insert(v, 0));
  assert_eq(keyed.keys().map(to_string), ordered.map(to_string));
  assert_eq(keyed.get(big_decimal("-12.500")), Some(0));
  assert_eq(keyed.insert(big_decimal("10.0100"), 1).len(), ordered.len());
  assert(
    range(0, ordered.len() - 1).fold(true, |ok: Bool, i: Int|
      ok && ordered.at_or(i, zero()) < ordered.at_or(i + 1, zero())
        && compare(ordered.at_or(i, zero()), ordered.at_or(i + 1, zero())) == Less),
  );
  assert_eq(compare(big_decimal("1.50"), big_decimal("1.5")), Equal);
  assert_eq(to_string(max(big_decimal("1.5"), big_decimal("2.50"))), "2.50")
}

test "sums, differences and products are exact: a sum has the larger scale and a product has the sum of the scales" {
  assert_eq(to_string(big_decimal("1.50") + big_decimal("2")), "3.50");
  assert_eq(to_string(big_decimal("1.50") - big_decimal("1.5")), "0.00");
  assert_eq(to_string(big_decimal("1.50") * big_decimal("2.0")), "3.000");
  assert_eq(to_string(-big_decimal("1.50")), "-1.50");
  assert_eq(to_string(abs(big_decimal("-1.50"))), "1.50");
  assert_eq(to_string(big_decimal("0.1") + big_decimal("0.2")), "0.3");
  assert_eq(
    to_string(
      big_decimal("123456789012345678901234567890.123456789")
        * big_decimal("-1000000000000000000000.000001"),
    ),
    "-123456789012345678901234568013580245801345678901234.567890123456789",
  );
  assert_eq(
    to_string(List::sum([big_decimal("0.1"), big_decimal("0.20"), big_decimal("0.300")])),
    "0.600",
  );
  assert_eq(text_of(pow(big_decimal("-1.5"), 3)), "-3.375");
  assert_eq(text_of(pow(big_decimal("1.5"), 0)), "1");
  assert_eq(text_of(pow(big_decimal("2"), 100)), "1267650600228229401496703205376");
  assert_eq(pow(big_decimal("2"), 0 - 1), None)
}

