    { a: "125", b: "", n: 2, mode: Down, expected: "120" },
    { a: "125", b: "", n: 2, mode: Up, expected: "130" },
    { a: "125", b: "", n: 2, mode: Ceiling, expected: "130" },
    { a: "125", b: "", n: 2, mode: Floor, expected: "120" },
    { a: "135", b: "", n: 2, mode: HalfEven, expected: "140" },
    { a: "135", b: "", n: 2, mode: HalfUp, expected: "140" },
    { a: "135", b: "", n: 2, mode: Down, expected: "130" },
    { a: "135", b: "", n: 2, mode: Up, expected: "140" },
    { a: "135", b: "", n: 2, mode: Ceiling, expected: "140" },
    { a: "135", b: "", n: 2, mode: Floor, expected: "130" },
    { a: "-0.5", b: "", n: 1, mode: HalfEven, expected: "-0.5" },
    { a: "-0.5", b: "", n: 1, mode: HalfUp, expected: "-0.5" },
    { a: "-0.5", b: "", n: 1, mode: Down, expected: "-0.5" },
    { a: "-0.5", b: "", n: 1, mode: Up, expected: "-0.5" },
    { a: "-0.5", b: "", n: 1, mode: Ceiling, expected: "-0.5" },
    { a: "-0.5", b: "", n: 1, mode: Floor, expected: "-0.5" },
    { a: "1.5", b: "", n: 5, mode: HalfEven, expected: "1.5" },
    { a: "1.5", b: "", n: 5, mode: HalfUp, expected: "1.5" },
    { a: "1.5", b: "", n: 5, mode: Down, expected: "1.5" },
    { a: "1.5", b: "", n: 5, mode: Up, expected: "1.5" },
    { a: "1.5", b: "", n: 5, mode: Ceiling, expected: "1.5" },
    { a: "1.5", b: "", n: 5, mode: Floor, expected: "1.5" },
    { a: "999999", b: "", n: 3, mode: HalfEven, expected: "1000000" },
    { a: "999999", b: "", n: 3, mode: HalfUp, expected: "1000000" },
    { a: "999999", b: "", n: 3, mode: Down, expected: "999000" },
    { a: "999999", b: "", n: 3, mode: Up, expected: "1000000" },
    { a: "999999", b: "", n: 3, mode: Ceiling, expected: "1000000" },
    { a: "999999", b: "", n: 3, mode: Floor, expected: "999000" },
  ]

