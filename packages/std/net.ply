//! Sockets: TCP, TLS and Unix sockets, as an effect whose label says what a connection is for.
//!
//! Every operation takes a label chosen by the caller, so the caller can tell its connections
//! apart. `net.send[conn](..)` writes to a connection the program accepted, and
//! `net.send[upstream](..)` writes to one it opened. Operations under different labels never
//! conflict.
//!
//! A deadline is in milliseconds, and `timeout_ms <= 0` is a runtime error. For the operations that
//! return an `Option`, `None` means the deadline expired, and an empty `Some` means the peer has
//! finished sending. A socket stores no timeout, so every read and write is given its own deadline.
//!
//! Addresses are `std.ip`'s. `connect_to` and `listen_on` take a `SocketAddress`, and
//! `peer_address` and `local_address` return one, so the address that a filter checked is the
//! address that is connected to. These operations return a `Result` whose `Err` is an `Error` that
//! says why. The functions here that open something (`dial`, `dial_address`, `listening`, `secure`)
//! instead raise the `Error` as `socket.fail`, and `try` turns it back into a `Result`. `socket` is
//! a separate effect because `net` is `nondet` and a raise is not.
//!
//! `connect` and `connect_tls` pass the host a name. The host looks the name up as `dns.lookup`
//! would and tries each address in turn. `dial` does the same in Ply: it performs `dns.lookup`,
//! orders the addresses with `dns::interleave`, and connects with `connect_to`. A test's DNS table
//! therefore decides where a name connects, and a caller that validated an address connects to that
//! address. The `timeout_ms` of `dial` is one deadline for the lookup and all attempts together,
//! and any enclosing `std.task` deadline limits it further. It works under `simulate`, under
//! `task::unbounded`, and under an enclosing deadline. It tries one address at a time and never
//! races them. Every connection has `NoDelay` on. A `SocketOption` is set when a connection or a
//! listener opens, or later with `set_option`, and `options` reads back each option.
//!
//! `start_tls` secures a connection that is already open, as SMTP's `STARTTLS` and Postgres's
//! `SSLRequest` require. The handshake completes inside the call, the handle is the secured
//! connection afterwards, and the server is verified as `connect_tls` verifies it. Plaintext read
//! before the handshake must not be trusted after it, so the caller passes in the bytes it has read
//! but not consumed. If there are any such bytes, or any bytes still waiting in the socket, the
//! result is `Injected`. `serve_tls` is the server side of `start_tls`. After an error the
//! connection is closed.
//!
//! A listener binds a loopback address. `listen_unix` and `connect_unix` name a path under the
//! filesystem root that the run is given with `--fs`, confined as `std.fs` confines paths. Closing
//! the listener removes the socket's file, so open one under `with_scope` or `bracket`.
//! `peer_credentials` reports which user owns the far end of a Unix socket.
//!
//! `reading` and `writing` present a connection as `std.io`'s `Source` and `Sink`. Under
//! `with_scope`, when the source is released the connection is closed, and when the sink is
//! released this end stops sending.
//!
//! `MemNet` is the in-memory fake, with a `mem_` function for every operation. `on_mem` runs code
//! that is written for any labels against a `MemNet`, and it handles `dns` from the table that the
//! `MemNet` stores. A far end is either a script of `Step`s (what it sends, what it must receive
//! first, where it upgrades to TLS) or the program's own listener, in which case the two ends are
//! connected. `MemNet` rejects what the host rejects, with the host's messages. Nothing waits in
//! it: a read with nothing to return is a deadline expiry.

import std.bytes
import std.bytes (flag_byte, i64_be, u16_be)
import std.dns
import std.dns (dns)
import std.internal.native (encode_texts, found_int, found_text, native, wait, job_wait, found,
                            parts, encode_parts, decode_int)
import std.io
import std.io (Sink, Source)
import std.ip
import std.ip (Ip, SocketAddress, ip)
import std.list
import std.option
import std.task
import std.time (after, as_millis, as_nanos, between, millis, nanos, seconds)

/// Why a socket operation failed.
pub type Error =
  /// Nothing is listening where the connection was sent.
  | Rejected
  /// No route leads to the address.
  | Unreachable
  /// The deadline passed first.
  | TimedOut
  /// The peer ended the connection.
  | Reset
  /// The name has no address.
  | NameNotFound
  /// The address is bound already.
  | AddressInUse
  /// The run is not allowed to do this, for example listening on any address other than the
  /// loopback address, or opening a path it may not use.
  | PermissionDenied
  /// Plaintext was waiting to be read where a TLS handshake was to begin.
  | Injected
  /// The peer's certificate is not one this run trusts for the name.
  | Untrusted
  /// The TLS handshake failed for the reason given.
  | Handshake(String)
  /// The host failed for another reason: its error number and its message.
  | Other(Int, String)

/// The result of an upgrade to TLS: the application protocol the two ends agreed on, if one was
/// offered and accepted.
pub type UpgradeResult = { protocol: Option<String> }

/// When an idle connection is probed, and, where the platform allows setting them, how often and
/// after how many unanswered probes it ends.
pub type Probing = { idle: Duration, interval: Option<Duration>, count: Option<Int> }

/// One setting of a socket.
pub type SocketOption =
  /// Sends small writes immediately instead of combining them into larger packets (`TCP_NODELAY`).
  /// Every connection starts with it on, and `NoDelay(false)` turns it off.
  | NoDelay(Bool)
  /// Sends keep-alive probes on an idle connection, set by the `Probing` value. `None` turns the
  /// probes off.
  | KeepAlive(Option<Probing>)
  /// Allows binding an address that is still in `TIME_WAIT` (`SO_REUSEADDR`). Every listener starts
  /// with this set to `true`.
  | ReuseAddress(Bool)
  /// Let several listeners share one port (`SO_REUSEPORT`).
  | ReusePort(Bool)
  /// The send buffer's size in bytes, which the host may round.
  | SendBuffer(Int)
  /// The receive buffer's size in bytes, which the host may round.
  | ReceiveBuffer(Int)
  /// How long a close waits for unsent bytes to be sent. `None` uses the operating system's default
  /// behavior.
  | Linger(Option<Duration>)
  /// Let a datagram socket send to a broadcast address (`SO_BROADCAST`).
  | Broadcast(Bool)
  /// Whether a datagram socket receives what it sends to a group it has joined.
  | MulticastLoop(Bool)
  /// Join a multicast group on the named interface, or on one the host picks. It can be set but
  /// not read back: `options` lists no memberships.
  | JoinGroup(Ip, Option<String>)
  /// Leave a multicast group joined on that interface.
  | LeaveGroup(Ip, Option<String>)
  /// Selects the certificate that this client presents when the server asks for one during a later
  /// `start_tls`. `name` is the name of a credential given on the command line as `--tls
  /// NAME=CERT,KEY`. A run without that credential fails with `E0429` at `start_tls`. `options`
  /// does not list this option.
  | Presenting(String)

/// Who owns the far end of a Unix socket: its user, its group, and its process where the platform
/// reports it.
pub type PeerCredentials = { user: Int, group: Int, process: Option<Int> }

/// Operations on listeners and connections. Each call names a label in brackets, such as
/// `net.send[conn]`, to say what the socket is used for.
pub nondet effect net {
  /// A listener on `port`. Port `0` requests any free port, which `local_port` then reports.
  write listen[s](port: Int) -> Int
  /// A listener that serves TLS with the credential `--tls NAME=CERT,KEY` gave the name
  /// `credential`. A credential the run lacks is `E0429`.
  write listen_tls[s](port: Int, credential: String) -> Int
  /// A listener at exactly `at`, which is a loopback address, with `options` set before it binds.
  /// Any other address is `PermissionDenied`.
  write listen_on[s](at: SocketAddress, options: List<SocketOption>) -> Result<Int, Error>
  /// A listener on the Unix socket at `path` under the `--fs` root named `root`. A path that
  /// already exists is `AddressInUse`, and `close` removes the socket this creates.
  write listen_unix[s](root: String, path: String) -> Result<Int, Error>
  /// Connects to `host` and returns the connection, trying each address that `host` resolves to
  /// until the deadline. Returns `None` when no connection could be made, for any reason.
  write connect[s](host: String, port: Int, timeout_ms: Int) -> Option<Int>
  /// `connect` over TLS: the server is verified as `host` against the built-in roots and any
  /// `--trust` certificate. The handshake is deferred to the first `send` or `recv`, so a peer that
  /// connects and sends nothing costs nothing. After a failed handshake, reads return the end of
  /// the stream and writes send `0` bytes.
  write connect_tls[s](host: String, port: Int, timeout_ms: Int) -> Option<Int>
  /// A connection to exactly `to`, no name looked up, with `options` set before it connects.
  write connect_to[s](to: SocketAddress, options: List<SocketOption>, timeout_ms: Int) -> Result<Int, Error>
  /// A connection to the Unix socket at `path` under the `--fs` root named `root`.
  write connect_unix[s](root: String, path: String, timeout_ms: Int) -> Result<Int, Error>
  /// Completes the TLS handshake now instead of when the first request needs it, and returns how
  /// long the handshake took in microseconds. Returns `None` when there is no handshake to
  /// complete: the connection is plaintext, or its handshake failed (which ends the connection). If
  /// the handshake had already completed, returns the time that earlier handshake took.
  write handshake[s](conn: Int) -> Option<Int>
  /// Secures an open plaintext connection as the TLS client. The handshake completes within
  /// `timeout_ms`, and the server is verified as `name`, as `connect_tls` does. Afterwards `conn`
  /// is the secured connection. `alpn` lists the application protocols to offer, and offers none
  /// when empty. `unread` is the plaintext the caller has read from `conn` but not yet used, and it
  /// must be empty. If it is not empty, or if more plaintext is waiting in the socket, the result
  /// is `Err(Injected)`. Any `Err` ends the connection.
  write start_tls[s](conn: Int, name: String, alpn: List<String>, unread: Bytes, timeout_ms: Int) -> Result<UpgradeResult, Error>
  /// Secures an open plaintext connection as the TLS server, using the credential given on the
  /// command line as `--tls NAME=CERT,KEY` with the name `credential`. A run without that
  /// credential fails with `E0429`. `alpn` lists the application protocols the server accepts. When
  /// it is empty, no protocol is negotiated and every client is still accepted. `unread` is the
  /// plaintext the caller read beyond the request to upgrade, and it must be empty.
  write serve_tls[s](conn: Int, credential: String, alpn: List<String>, unread: Bytes, timeout_ms: Int) -> Result<UpgradeResult, Error>
  /// The next connection a listener accepts, waiting for one, or `0` once the run has stopped
  /// accepting.
  write accept[s](listener: Int) -> Int
  /// At most `max` bytes, as soon as any arrive. A shorter result does not mean the peer has
  /// finished sending.
  write recv[s](conn: Int, max: Int, timeout_ms: Int) -> Option<Bytes>
  /// Writes some prefix of `payload` and returns how many bytes it wrote, which may be fewer than
  /// given. `send_all` loops until all are written.
  write send[s](conn: Int, payload: Bytes, timeout_ms: Int) -> Option<Int>
  /// Ends this end's sending, which the peer reads as the end of the stream, and leaves reading
  /// open. A later `send` returns `Some(0)`.
  write close_write[s](conn: Int) -> Unit
  /// Closes the socket. Closing a listener stops it accepting, and closing a Unix listener removes
  /// its socket file.
  write close[s](socket: Int) -> Unit
  /// Sets `option` on the socket, which can be a listener or a connection. Returns `Err` when the
  /// option does not apply to this kind of socket or the system rejects it.
  write set_option[s](socket: Int, option: SocketOption) -> Result<Unit, Error>
  /// Returns the port this end of the socket is bound to. For a listener opened on port `0`, this
  /// is the port the system chose. Returns `None` for a listener that was closed when the run began
  /// shutting down.
  read local_port[s](socket: Int) -> Option<Int>
  /// Returns the address this end of the socket is bound to. Returns `None` for a Unix socket, and
  /// for a listener that was closed when the run began shutting down.
  read local_address[s](socket: Int) -> Option<SocketAddress>
  /// The address of a connection's far end as the socket has it, which behind a proxy is the
  /// proxy's. `None` for a listener and for a Unix socket.
  read peer_address[s](conn: Int) -> Option<SocketAddress>
  /// Who owns the far end of a Unix socket. `None` for any other socket, and where the platform
  /// does not report it.
  read peer_credentials[s](conn: Int) -> Option<PeerCredentials>
  /// The far end's end-entity certificate (DER) on a secured connection once its handshake has
  /// completed. A client gets the server's certificate, which RFC 5929's `tls-server-end-point`
  /// channel binding hashes. A server gets the client's, if it presented one the run verified
  /// against `--trust`, which identifies the client. `None` for any other connection.
  read peer_certificate[s](conn: Int) -> Option<Bytes>
  /// The application protocol (ALPN) a secured connection's handshake agreed on, once it has
  /// completed. A connection that `listen_tls` accepted or `connect_tls` opened offers only
  /// `http/1.1`, so it is that or none. For one that `start_tls` or `serve_tls` secured, it is what
  /// they returned. `None` for a plaintext connection, and when the ends agreed on none.
  read protocol[s](conn: Int) -> Option<String>
  /// Each option the socket has, as currently set.
  read options[s](socket: Int) -> List<SocketOption>
  /// Writes `before`, then `secret` in `encoding`, then `after`, laid out as `std.fs`'s
  /// `write_secret` lays out a file, and returns whether every byte was written. The secret is sent
  /// without ever becoming a plain value. For example, SASL's PLAIN login can send the base64 of
  /// the user and password as `secret`, with `AUTH PLAIN ` as `before` and a line end as `after`.
  /// An `encoding` that `write_secret` does not support is a runtime error, and so is a write of
  /// zero bytes. `false` means a deadline passed, the peer left, or this end's sending was already
  /// closed. After `false`, the caller cannot tell how many bytes were sent.
  write send_secret[s](conn: Int, before: Bytes, secret: Secret<Bytes>, encoding: String, after: Bytes, timeout_ms: Int) -> Bool
}

/// Errors from opening or upgrading a socket.
pub effect socket {
  /// A connection did not open, or an upgrade did not complete.
  raise fail(connection: Error)
}

/// Returns a short English description of `reason`.
pub fn error_message(reason: Error) -> String =
  match reason {
    Rejected -> "nothing is listening there",
    Unreachable -> "no route leads there",
    TimedOut -> "the deadline passed first",
    Reset -> "the peer ended the connection",
    NameNotFound -> "the name has no address",
    AddressInUse -> "the address is already bound",
    PermissionDenied -> "the operating system denied permission for this network operation",
    Injected -> "plaintext data arrived where a TLS handshake was expected",
    Untrusted -> "the peer's certificate is not trusted for that name",
    Handshake(reason) -> reason,
    Other(code, text) -> text ++ " (" ++ code.to_string() ++ ")",
  }

/// Reads until the peer has finished sending, which `recv` reports as an empty result. A `recv`
/// shorter than `max` is not the end.
pub fn drain<[l]>(c: Int, so_far: Bytes, timeout_ms: Int) -> Bytes / {net.recv[l], diverges} =
  match net.recv[l](c, 4096, timeout_ms) {
    None -> so_far,
    Some(chunk) -> if chunk.len() == 0 { so_far }
    else { drain[l](c, so_far.concat(chunk), timeout_ms) },
  }

/// Sends every byte, looping over partial writes. Returns `false` when the peer stops accepting
/// them.
pub fn send_all<[l]>(c: Int, payload: Bytes, timeout_ms: Int) -> Bool / {net.send[l], abort.raise} =
  send_from[l](c, payload, 0, timeout_ms, max_writes())

fn max_writes() -> Int = 4096

fn send_from<[l]>(
  c: Int,
  payload: Bytes,
  at: Int,
  timeout_ms: Int,
  left: Int,
) -> Bool / {net.send[l], abort.raise} =
  if at >= payload.len() { true }
  else if left <= 0 { false } else {
    match net.send[l](
        c,
        if at == 0 { payload } else { payload.slice(at, payload.len()) },
        timeout_ms,
      ) {
      None -> false,
      Some(n) -> if n <= 0 { false }
      else { send_from[l](c, payload, at + n, timeout_ms, left - 1) },
    }
  }

/// A connection to exactly `to`, or raises why it could not open.
pub fn dial_address<[l]>(
  to: SocketAddress,
  options: List<SocketOption>,
  timeout_ms: Int,
) -> Int / {net.connect_to[l], socket.fail} =
  match net.connect_to[l](to, options, timeout_ms) {
    Ok(c) -> c,
    Err(reason) -> socket.fail(reason),
  }

/// Connects to `name` at `port` and returns the connection. The addresses of `name` are looked up
/// with `dns`, ordered by `dns::interleave`, and tried one at a time until one connects.
/// `timeout_ms` is a single time limit for the lookup and all attempts together, or the enclosing
/// deadline if that is earlier. Each attempt gets an equal share of the time remaining, so an
/// address that does not respond uses up only its own share. Raises `NameNotFound` when `name` has
/// no address, `Other` when `name` is not ASCII, and the last address's error when no address
/// connects.
pub fn dial<[l]>(
  name: String,
  port: Int,
  options: List<SocketOption>,
  timeout_ms: Int,
) -> Int / {dns.lookup, net.connect_to[l], socket.fail, task.write, clock.read, clock.write, task::deadline.at, abort.raise} =
  dialled[l](name, port, options, deadline_after("dial", timeout_ms))

fn deadline_after(
  function: String,
  timeout_ms: Int,
) -> Instant / {clock.read, task::deadline.at, abort.raise} =
  if timeout_ms <= 0 {
    panic(
      "`net::" ++ function ++ "` was given a timeout of " ++ timeout_ms.to_string()
        ++ " milliseconds",
    )
  } else {
    let own = after(clock.now(), millis(timeout_ms));
    match task::earliest(Some(own), task::deadline.at()) { Some(earlier) -> earlier, None -> own }
  }

/// The `timeout_ms` for an operation that must end by `end`: the whole milliseconds left before
/// it, or `None` if none are left.
pub fn ms_left(end: Instant) -> Option<Int> / {clock.read} = {
  let left = as_millis(between(clock.now(), end));
  if left > 0 { Some(left) } else { None }
}

fn dialled<[l]>(
  name: String,
  port: Int,
  options: List<SocketOption>,
  end: Instant,
) -> Int / {dns.lookup, net.connect_to[l], socket.fail, task.write, clock.read, clock.write, task::deadline.at} =
  match dns::resolve(name, between(clock.now(), end)) {
    Ok(found) ->
      connect_first_address[l](dns::interleave(dns::addresses(found)), port, options, end),
    Err(dns::TimedOut) -> socket.fail(TimedOut),
    Err(dns::Other(code, text)) -> socket.fail(Other(code, text)),
    Err(_) -> socket.fail(NameNotFound),
  }

fn connect_first_address<[l]>(
  addresses: List<Ip>,
  port: Int,
  options: List<SocketOption>,
  end: Instant,
) -> Int / {net.connect_to[l], socket.fail, clock.read} =
  match addresses {
    [] -> socket.fail(NameNotFound),
    [address, ..rest] -> match ip::socket_address(address, port) {
      None -> socket.fail(Other(0, "a port is 0 to 65535")),
      Some(to) -> match ms_left(end) {
        None -> socket.fail(TimedOut),
        Some(left) -> match net.connect_to[l](to, options, max(left / addresses.len(), 1)) {
          Ok(c) -> c,
          Err(reason) -> if rest.len() == 0 { socket.fail(reason) }
          else { connect_first_address[l](rest, port, options, end) },
        },
      },
    },
  }

/// Secures `conn` as a TLS client, as `net.start_tls` does, but raises `socket.fail` with the error
/// instead of returning `Err`.
pub fn secure<[l]>(
  connection: Int,
  name: String,
  alpn: List<String>,
  unread: Bytes,
  timeout_ms: Int,
) -> UpgradeResult / {net.start_tls[l], socket.fail} =
  match net.start_tls[l](connection, name, alpn, unread, timeout_ms) {
    Ok(secured) -> secured,
    Err(reason) -> socket.fail(reason),
  }

/// Secures the open connection `conn` as the TLS server, using the credential named `credential`,
/// and returns the negotiated protocol. Fails with the error `net.serve_tls` returns. `unread` must
/// be empty.
pub fn secure_accepted<[l]>(
  connection: Int,
  credential: String,
  alpn: List<String>,
  unread: Bytes,
  timeout_ms: Int,
) -> UpgradeResult / {net.serve_tls[l], socket.fail} =
  match net.serve_tls[l](connection, credential, alpn, unread, timeout_ms) {
    Ok(secured) -> secured,
    Err(reason) -> socket.fail(reason),
  }

/// A TLS connection to `name` at `port`, dialled as `dial` dials and then secured as `name`,
/// offering `alpn`, with the handshake under the same deadline as the dial. The handshake is
/// complete when this returns. A connection that fails to secure is closed before its error is
/// raised.
pub fn dial_tls<[l]>(
  name: String,
  port: Int,
  alpn: List<String>,
  options: List<SocketOption>,
  timeout_ms: Int,
) -> Int / {dns.lookup, net.connect_to[l], net.start_tls[l], net.close[l], socket.fail, task.write, clock.read, clock.write, task::deadline.at, abort.raise} = {
  let end = deadline_after("dial_tls", timeout_ms);
  let c = dialled[l](name, port, options, end);
  let secured = match ms_left(end) {
    None -> Err(TimedOut),
    Some(left) -> net.start_tls[l](c, name, alpn, b"", left),
  };
  match secured {
    Ok(_) -> c,
    Err(reason) -> {
      net.close[l](c);
      socket.fail(reason)
    },
  }
}

/// A listener at `at`, or raises why it could not open.
pub fn listening<[l]>(
  at: SocketAddress,
  options: List<SocketOption>,
) -> Int / {net.listen_on[l], socket.fail} =
  match net.listen_on[l](at, options) { Ok(s) -> s, Err(reason) -> socket.fail(reason) }

/// A listener on the Unix socket at `path` under `root`, or raises why it could not open.
pub fn listening_unix<[l]>(root: String, path: String) -> Int / {net.listen_unix[l], socket.fail} =
  match net.listen_unix[l](root, path) { Ok(s) -> s, Err(reason) -> socket.fail(reason) }

/// A connection to the Unix socket at `path` under `root`, or raises why it could not open.
pub fn dial_unix<[l]>(
  root: String,
  path: String,
  timeout_ms: Int,
) -> Int / {net.connect_unix[l], socket.fail} =
  match net.connect_unix[l](root, path, timeout_ms) {
    Ok(c) -> c,
    Err(reason) -> socket.fail(reason),
  }

/// Returns a source that reads from the connection `conn`. Each pull is one `recv` that waits at
/// most `timeout_ms` and fails with `TimedOut` if nothing arrives. The source ends when the peer
/// finishes sending. Closing the source closes the connection.
pub fn reading<[l]>(
  connection: Int,
  timeout_ms: Int,
) -> Source<| {net.recv[l], net.close[l], socket.fail}> =
  {
    pull: |size: Int|
      match net.recv[l](connection, size, timeout_ms) {
        Some(bytes) -> bytes,
        None -> socket.fail(TimedOut),
      },
    close: || net.close[l](connection),
  }

/// Returns a sink that writes to the connection `conn`. Each push sends all of its bytes, and each
/// write waits at most `timeout_ms`. Closing the sink ends sending but leaves the connection open
/// for reading, so create the sink inside the scope of the source that reads from the same
/// connection.
pub fn writing<[l]>(
  connection: Int,
  timeout_ms: Int,
) -> Sink<| {net.send[l], net.close_write[l], abort.raise}> =
  {
    push: |bytes: Bytes| bytes.len() == 0 || send_all[l](connection, bytes, timeout_ms),
    close: || net.close_write[l](connection),
  }

/// What the far end of a scripted connection does next.
pub type Step =
  | Sends(Bytes)
  /// The far end waits until it has received exactly these bytes, appended to the bytes it received
  /// in earlier steps. If the program sends different bytes, that send fails.
  | Expects(Bytes)
  /// The far end waits until the program has finished sending on the connection.
  | ExpectsEnd
  /// The far end waits until it has received exactly these bytes, sent in one `send_secret` call.
  /// The bytes are the secret's contents as `send_secret` frames them. If the program sends
  /// anything else here, or sends these bytes without `send_secret`, that send fails, and the error
  /// does not say how the bytes differ.
  | ExpectsSecret(Bytes)
  /// It does its half of a TLS handshake here, and what follows is read only once secured.
  | Upgrades
  /// It fails a TLS handshake here with this error.
  | Rejects(Error)
  /// It sends nothing before one deadline passes.
  | Stalls
  /// The far end sends nothing more but stays connected, so every later read waits until its
  /// deadline passes.
  | Silent
  /// It sends these bytes again at every read, without end: a peer that never finishes.
  | Repeats(Bytes)
  /// It accepts nothing before one deadline passes: one `send` returns `None`.
  | Blocks
  /// It leaves: its stream ends after what it sent, and nothing sent to it afterwards is accepted.
  | Leaves

/// What a connection finds at an address the fake knows: a peer that serves each connection with
/// the next of its scripts, or an error.
pub type Endpoint = | Serving(List<List<Step>>) | Failing(Error)

/// A client the fake's `accept` returns: where it connects from, what it does, for a Unix socket
/// who it is, and the certificate (DER) it presents once its connection is secured.
pub type Caller = {
  from: Option<SocketAddress>,
  script: List<Step>,
  credentials: Option<PeerCredentials>,
  certificate: Option<Bytes>,
}

/// A listener in a fake: where it is bound (an address or a Unix path), the credential it serves
/// TLS with, and the program's own connections waiting to be accepted.
pub type MemListener = {
  label: String,
  at: Option<SocketAddress>,
  key: String,
  tls: Option<String>,
  waiting: List<Int>,
  options: List<SocketOption>,
}

/// A connection in a fake network. `script` is what the far end does next. `may_send_more` is true
/// when the far end may send more than the script contains: when the connection goes to the
/// program's own listener or client and is still open. `gone` is true when the far end accepts
/// nothing more. `sent` is everything this end sent except secrets. `sent_secrets` contains the
/// secrets sent with `send_secret`, in the form `send_secret` frames them. `unheard` is the
/// received bytes that no `Expects` step has matched yet. `deadlines` is the deadline given to each
/// read, in order.
pub type MemoryConnection = {
  label: Option<String>,
  local: Option<SocketAddress>,
  peer: Option<SocketAddress>,
  script: List<Step>,
  joined: Option<Int>,
  may_send_more: Bool,
  gone: Bool,
  ended: Bool,
  sent: Bytes,
  sent_secrets: List<Secret<Bytes>>,
  unheard: Bytes,
  deadlines: List<Int>,
  tls_name: Option<String>,
  /// The application protocol the connection's handshake agreed on, if it agreed on one.
  negotiated: Option<String>,
  options: List<SocketOption>,
  credentials: Option<PeerCredentials>,
  /// Whether `accept` returned the connection, and the certificate its client presents, if any.
  accepted: Bool,
  client_certificate: Option<Bytes>,
}

/// A whole fake network, as a value. `chunk_limit` is the most bytes one `recv` or `send` moves, or
/// zero for no limit. `closed` lists the handles that `close` has closed, in the order they were
/// closed.
pub type MemNet = {
  next: Int,
  port: Int,
  listeners: Map<Int, MemListener>,
  conns: Map<Int, MemoryConnection>,
  endpoints: Map<String, Endpoint>,
  callers: List<Caller>,
  names: dns::Table,
  credentials: List<String>,
  /// The certificate (DER) a far end secured under each name presents.
  leaves: Map<String, Bytes>,
  chunk_limit: Int,
  closed: List<Int>,
}

/// An operation's two results: the network after it, and what the host would have returned.
pub type StepResult<a> = { net: MemNet, result: a }

/// A network with no listeners and no names.
pub fn mem_empty() -> MemNet =
  {
    next: 1,
    port: 49152,
    listeners: Map::new(),
    conns: Map::new(),
    endpoints: Map::new(),
    callers: [],
    names: dns::table(),
    credentials: [],
    leaves: Map::new(),
    chunk_limit: 0,
    closed: [],
  }

/// Returns the network with a far end that presents the certificate `der` when the program secures
/// a connection to it as `name`. A client connection the program opens with the `Presenting(name)`
/// socket option presents the same certificate to the program's own listener.
pub fn mem_server_certificate(n: MemNet, name: String, der: Bytes) -> MemNet =
  { ..n, leaves: n.leaves.insert(name, der) }

/// Returns the network with a peer at `at` that serves each connection with the next of `scripts`,
/// and rejects connections once the scripts run out.
pub fn mem_serving(n: MemNet, at: SocketAddress, scripts: List<List<Step>>) -> MemNet =
  { ..n, endpoints: n.endpoints.insert(ip::render_socket(at), Serving(scripts)) }

/// The network with every connection to `at` failing with `reason`.
pub fn mem_failing(n: MemNet, at: SocketAddress, reason: Error) -> MemNet =
  { ..n, endpoints: n.endpoints.insert(ip::render_socket(at), Failing(reason)) }

/// The network with a peer on the Unix socket at `path` under `root`.
pub fn mem_serving_unix(
  n: MemNet,
  root: String,
  path: String,
  scripts: List<List<Step>>,
) -> MemNet = { ..n, endpoints: n.endpoints.insert(unix_key(root, path), Serving(scripts)) }

/// The network with one more client for `accept` to return, connecting from `from` and running
/// `script`.
pub fn mem_calling(n: MemNet, from: SocketAddress, script: List<Step>) -> MemNet =
  {
    ..n,
    callers: n.callers.push({
      from: Some(from),
      script: script,
      credentials: None,
      certificate: None,
    }),
  }

/// Like `mem_calling`, but the client presents the certificate `der` once its connection is
/// secured. A server then gets `der` from `net.peer_certificate`.
pub fn mem_calling_with_certificate(
  n: MemNet,
  from: SocketAddress,
  der: Bytes,
  script: List<Step>,
) -> MemNet =
  {
    ..n,
    callers: n.callers.push({
      from: Some(from),
      script: script,
      credentials: None,
      certificate: Some(der),
    }),
  }

/// The network with one more client for `accept` to return over a Unix socket, owned by `who`.
pub fn mem_calling_unix(n: MemNet, who: PeerCredentials, script: List<Step>) -> MemNet =
  {
    ..n,
    callers: n.callers.push({
      from: None,
      script: script,
      credentials: Some(who),
      certificate: None,
    }),
  }

/// Returns the network that resolves names with `names`. Both `connect` and `connect_tls` use it,
/// and so does `dns` when handled by `on_mem`.
pub fn mem_resolving(n: MemNet, names: dns::Table) -> MemNet = { ..n, names: names }

/// The network with a TLS credential named `name`, as `--tls` would give the run.
pub fn mem_credential(n: MemNet, name: String) -> MemNet =
  { ..n, credentials: n.credentials.push(name) }

/// The network moving at most `most` bytes in each `recv` and `send` from here on, and as many as
/// requested when `most` is zero: the short reads and partial writes a real socket produces.
pub fn mem_chunk_limit(n: MemNet, most: Int) -> MemNet = { ..n, chunk_limit: most }

/// Everything the program sent on `conn` except credentials, whether or not it is still open.
pub fn mem_sent(n: MemNet, connection: Int) -> Bytes =
  match n.conns.get(connection) { Some(c) -> c.sent, None -> b"" }

/// Returns each secret the program sent on `conn` with `send_secret`, in order. Each is still a
/// `Secret` in the form `send_secret` frames it, so a test can compare it as a whole with the
/// secret it expects.
pub fn mem_sent_secrets(n: MemNet, connection: Int) -> List<Secret<Bytes>> =
  match n.conns.get(connection) { Some(c) -> c.sent_secrets, None -> [] }

/// What `conn`'s far end has yet to do: empty when the program has run its script to the end.
pub fn mem_remaining_script(n: MemNet, connection: Int) -> List<Step> =
  match n.conns.get(connection) { Some(c) -> c.script, None -> [] }

/// Returns the deadline given to each read of `conn`, in milliseconds and in order. A test of a
/// timeout can add them up.
pub fn mem_deadlines(n: MemNet, connection: Int) -> List<Int> =
  match n.conns.get(connection) { Some(c) -> c.deadlines, None -> [] }

/// The name or credential `conn` was secured as, or `None` for plaintext.
pub fn mem_secured(n: MemNet, connection: Int) -> Option<String> =
  match n.conns.get(connection) { Some(c) -> c.tls_name, None -> None }

fn unix_key(root: String, path: String) -> String = "unix:" ++ root ++ "/" ++ path

fn deadline(operation: String, timeout_ms: Int) -> Unit / {abort.raise} =
  if timeout_ms <= 0 {
    panic(
      "`net." ++ operation ++ "` was given a timeout of " ++ timeout_ms.to_string()
        ++ " milliseconds",
    )
  } else { () }

fn checked_read_size(max: Int) -> Int / {abort.raise} =
  if max <= 0 { panic("`net.recv` was asked for " ++ max.to_string() ++ " bytes") } else { max }

fn check_nonempty_write(operation: String, empty: Bool) -> Unit / {abort.raise} =
  if empty { panic("`net." ++ operation ++ "` was given an empty payload") } else { () }

fn listenable(at: SocketAddress) -> Bool = ip::is_loopback(ip::socket_ip(at))

fn option_checked(option: SocketOption) -> SocketOption / {abort.raise} = {
  let sized = |bytes: Int|
    if bytes < 0 { panic("a socket buffer was sized at " ++ bytes.to_string() ++ " bytes") }
    else { () };
  let waited = |d: Duration|
    if as_nanos(d) < 0 {
      panic("a socket was given a duration of " ++ as_nanos(d).to_string() ++ " nanoseconds")
    } else { () };
  match option {
    SendBuffer(bytes) -> sized(bytes),
    ReceiveBuffer(bytes) -> sized(bytes),
    Linger(Some(d)) -> waited(d),
    KeepAlive(Some(p)) -> {
      waited(p.idle);
      match p.interval { Some(d) -> waited(d), None -> () };
      match p.count {
        Some(n) -> if n < 0 || n > 4294967295 {
          panic("a socket was given a probe count of " ++ n.to_string())
        } else { () },
        None -> (),
      }
    },
    _ -> (),
  };
  option
}

fn no_socket<a>(id: Int) -> a / {abort.raise} =
  panic("there is no open socket with handle " ++ id.to_string())

fn claimed(
  id: Int,
  current_label: Option<String>,
  label: String,
) -> Option<String> / {abort.raise} =
  match current_label {
    None -> Some(label),
    Some(first) -> if first == label { current_label } else {
      panic(
        "socket " ++ id.to_string() ++ " is being used as `net[" ++ label ++ "]` and `net[" ++ first
          ++ "]`",
      )
    },
  }

fn connection_of(n: MemNet, label: String, id: Int) -> MemoryConnection / {abort.raise} =
  match n.conns.get(id) {
    Some(c) -> if n.closed.contains(id) { no_socket(id) }
    else { { ..c, label: claimed(id, c.label, label) } },
    None -> if n.listeners.contains(id) {
      panic("socket " ++ id.to_string() ++ " is a listener, and this operation wants a connection")
    } else { no_socket(id) },
  }

fn listener_of(n: MemNet, label: String, id: Int) -> MemListener / {abort.raise} =
  match n.listeners.get(id) {
    Some(l) -> {
      let _held = claimed(id, Some(l.label), label);
      l
    },
    None -> if n.conns.contains(id) {
      panic("socket " ++ id.to_string() ++ " is a connection, and `net.accept` wants a listener")
    } else { no_socket(id) },
  }

fn with_connection(n: MemNet, id: Int, c: MemoryConnection) -> MemNet =
  { ..n, conns: n.conns.insert(id, c) }

fn advance_script(c: MemoryConnection) -> MemoryConnection / {abort.raise} =
  match c.script {
    [Sends(bytes), ..rest] -> if bytes.len() == 0 { advance_script({ ..c, script: rest }) }
    else { c },
    [ExpectsEnd, ..rest] -> if c.ended { advance_script({ ..c, script: rest }) } else { c },
    [ExpectsSecret(_), ..] -> if c.unheard.len() == 0 { c } else {
      panic(
        "the scripted peer expected a credential but the program sent \""
          ++ String::of_bytes_lossy(c.unheard)
          ++ "\"",
      )
    },
    [Leaves, ..] -> { ..c, script: [], may_send_more: false, gone: true },
    [Expects(expected), ..rest] -> {
      let wanted = expected.len();
      if c.unheard.starts_with(expected) {
        advance_script({ ..c, script: rest, unheard: c.unheard.slice(wanted, c.unheard.len()) })
      } else if expected.starts_with(c.unheard) { c } else {
        panic(
          "the scripted peer expected to receive \"" ++ String::of_bytes_lossy(expected)
            ++ "\" but the program sent \""
            ++ String::of_bytes_lossy(c.unheard)
            ++ "\"",
        )
      }
    },
    _ -> c,
  }

fn connection_with_script(
  local: Option<SocketAddress>,
  peer: Option<SocketAddress>,
  script: List<Step>,
) -> MemoryConnection =
  {
    label: None,
    local: local,
    peer: peer,
    script: script,
    joined: None,
    may_send_more: false,
    gone: false,
    ended: false,
    sent: b"",
    sent_secrets: [],
    unheard: b"",
    deadlines: [],
    tls_name: None,
    negotiated: None,
    options: [NoDelay(true)],
    credentials: None,
    accepted: false,
    client_certificate: None,
  }

fn bound_at(n: MemNet, key: String) -> Option<Int> =
  n.listeners.fold(None, |found: Option<Int>, id: Int, l: MemListener|
    if l.key == key { Some(id) } else { found })

fn bind(
  n: MemNet,
  label: String,
  address: Ip,
  port: Int,
  tls: Option<String>,
  options: List<SocketOption>,
) -> StepResult<Result<Int, Error>> / {abort.raise} = {
  let assigned = if port == 0 { n.port } else { port };
  let at = ip::socket_at(address, assigned);
  let key = ip::render_socket(at);
  if bound_at(n, key) != None || n.endpoints.contains(key) { { net: n, result: Err(AddressInUse) } }
  else {
    let l: MemListener = {
      label: label,
      at: Some(at),
      key: key,
      tls: tls,
      waiting: [],
      options: options.fold([ReuseAddress(true)], with_option),
    };
    {
      net: {
        ..n,
        next: n.next + 1,
        port: if port == 0 { n.port + 1 } else { n.port },
        listeners: n.listeners.insert(n.next, l),
      },
      result: Ok(n.next),
    }
  }
}

fn port_checked(operation: String, port: Int) -> Int / {abort.raise} =
  if port < 0 || port > 65535 {
    panic(
      "`net." ++ operation ++ "` was given port " ++ port.to_string()
        ++ ", which is not a TCP port",
    )
  } else { port }

/// What `net.listen` returns over the network. A port already bound fails as the host's bind
/// does.
pub fn mem_listen(n: MemNet, label: String, port: Int) -> StepResult<Int> / {abort.raise} = {
  let bound = bind(n, label, ip::loopback_v4(), port_checked("listen", port), None, []);
  match bound.result {
    Ok(id) -> { net: bound.net, result: id },
    Err(_) ->
      panic("`net.listen` could not bind 127.0.0.1:" ++ port.to_string() ++ ": address in use"),
  }
}

/// Returns the handle of a TLS listener on loopback `port`. Fails when `credential` was not added
/// to the network with `mem_credential`.
pub fn mem_listen_tls(
  n: MemNet,
  label: String,
  port: Int,
  credential: String,
) -> StepResult<Int> / {abort.raise} = {
  let configured_credential = credentialed(n, credential);
  let bound = bind(
    n,
    label,
    ip::loopback_v4(),
    port_checked("listen_tls", port),
    Some(configured_credential),
    [],
  );
  match bound.result {
    Ok(id) -> { net: bound.net, result: id },
    Err(_) ->
      panic("`net.listen_tls` could not bind 127.0.0.1:" ++ port.to_string() ++ ": address in use"),
  }
}

fn credentialed(n: MemNet, credential: String) -> String / {abort.raise} =
  if n.credentials.filter(|configured: String| configured == credential).len() > 0 { credential }
  else { panic("no TLS credential named `" ++ credential ++ "` was configured for this run") }

/// What `net.listen_on` returns over the network.
pub fn mem_listen_on(
  n: MemNet,
  label: String,
  at: SocketAddress,
  options: List<SocketOption>,
) -> StepResult<Result<Int, Error>> / {abort.raise} =
  if !listenable(at) { { net: n, result: Err(PermissionDenied) } }
  else { bind(n, label, ip::socket_ip(at), ip::socket_port(at), None, options.map(option_checked)) }

/// Returns a listener on the Unix socket at `path` under `root`, or `AddressInUse` when something
/// is already bound there. The path stays bound until the listener is closed.
pub fn mem_listen_unix(
  n: MemNet,
  label: String,
  root: String,
  path: String,
) -> StepResult<Result<Int, Error>> = {
  let key = unix_key(root, path);
  if bound_at(n, key) != None || n.endpoints.contains(key) { { net: n, result: Err(AddressInUse) } }
  else {
    let l: MemListener = { label: label, at: None, key: key, tls: None, waiting: [], options: [] };
    { net: { ..n, next: n.next + 1, listeners: n.listeners.insert(n.next, l) }, result: Ok(n.next) }
  }
}

fn opened(
  n: MemNet,
  label: String,
  to: Option<SocketAddress>,
  key: String,
  options: List<SocketOption>,
) -> StepResult<Result<Int, Error>> / {abort.raise} = {
  let local = match to {
    Some(at) -> Some(ip::socket_at(ip::loopback_like(ip::socket_ip(at)), n.port)),
    None -> None,
  };
  let fresh = connection_with_script(local, to, []);
  let mine = { ..fresh, label: Some(label), options: options.fold(fresh.options, with_option) };
  let after = { ..n, port: if local == None { n.port } else { n.port + 1 } };
  match bound_at(n, key) {
    Some(listener) -> {
      let l = match n.listeners.get(listener) { Some(l) -> l, None -> no_socket(listener) };
      let accepted = connection_with_script(l.at, local, []);
      let theirs = {
        ..accepted,
        joined: Some(n.next),
        may_send_more: true,
        tls_name: l.tls,
        accepted: true,
        client_certificate: presented_by(n, options),
      };
      {
        net: {
          ..after,
          next: n.next + 2,
          conns: n.conns.insert(n.next, {
            ..mine,
            joined: Some(n.next + 1),
            may_send_more: true,
          }).insert(
            n.next + 1,
            theirs,
          ),
          listeners: n.listeners.insert(listener, { ..l, waiting: l.waiting.push(n.next + 1) }),
        },
        result: Ok(n.next),
      }
    },
    None -> match n.endpoints.get(key) {
      Some(Serving([script, ..rest])) ->
        {
          net: {
            ..after,
            next: n.next + 1,
            conns: n.conns.insert(n.next, { ..mine, script: script }),
            endpoints: n.endpoints.insert(key, Serving(rest)),
          },
          result: Ok(n.next),
        },
      Some(Failing(reason)) -> { net: n, result: Err(reason) },
      _ -> { net: n, result: Err(Rejected) },
    },
  }
}

fn presented_by(n: MemNet, options: List<SocketOption>) -> Option<Bytes> =
  options.fold(None, |was: Option<Bytes>, o: SocketOption|
    match o { Presenting(name) -> n.leaves.get(name), _ -> was })

/// What `net.connect_to` returns over the network.
pub fn mem_connect_to(
  n: MemNet,
  label: String,
  to: SocketAddress,
  options: List<SocketOption>,
  timeout_ms: Int,
) -> StepResult<Result<Int, Error>> / {abort.raise} = {
  deadline("connect_to", timeout_ms);
  opened(n, label, Some(to), ip::render_socket(to), options.map(option_checked))
}

/// What `net.connect_unix` returns over the network.
pub fn mem_connect_unix(
  n: MemNet,
  label: String,
  root: String,
  path: String,
  timeout_ms: Int,
) -> StepResult<Result<Int, Error>> / {abort.raise} = {
  deadline("connect_unix", timeout_ms);
  opened(n, label, None, unix_key(root, path), [])
}

/// What `net.connect` returns over the network: the name resolved by the network's table and each
/// address tried in the order the table gives it.
pub fn mem_connect(
  n: MemNet,
  label: String,
  host: String,
  port: Int,
  timeout_ms: Int,
) -> StepResult<Option<Int>> / {abort.raise} = {
  deadline("connect", timeout_ms);
  let found = match dns::table_lookup(n.names, host) {
    Ok(found) -> dns::addresses(found),
    Err(_) -> [],
  };
  connect_first(n, label, found, port_checked("connect", port))
}

fn connect_first(
  n: MemNet,
  label: String,
  addresses: List<Ip>,
  port: Int,
) -> StepResult<Option<Int>> / {abort.raise} =
  match addresses {
    [] -> { net: n, result: None },
    [address, ..rest] -> {
      let to = ip::socket_at(address, port);
      let tried = opened(n, label, Some(to), ip::render_socket(to), []);
      match tried.result {
        Ok(id) -> { net: tried.net, result: Some(id) },
        Err(_) -> connect_first(n, label, rest, port),
      }
    },
  }

/// What `net.connect_tls` returns over the network: `mem_connect`, with the connection secured as
/// `host`. TLS changes none of the bytes a fake carries.
pub fn mem_connect_tls(
  n: MemNet,
  label: String,
  host: String,
  port: Int,
  timeout_ms: Int,
) -> StepResult<Option<Int>> / {abort.raise} = {
  let connect_first_address = mem_connect(n, label, host, port, timeout_ms);
  match connect_first_address.result {
    Some(id) -> match connect_first_address.net.conns.get(id) {
      Some(c) ->
        {
          net: with_connection(connect_first_address.net, id, {
            ..c,
            tls_name: Some(host),
            negotiated: Some("http/1.1"),
          }),
          result: Some(id),
        },
      None -> connect_first_address,
    },
    None -> connect_first_address,
  }
}

/// Returns the handle of the next connection to accept. This is a connection the program made to
/// the listener, if one is waiting. Otherwise it is the next client added with `mem_calling`. When
/// there is neither, it returns `0`, as a host that has stopped accepting does.
pub fn mem_accept(n: MemNet, label: String, listener: Int) -> StepResult<Int> / {abort.raise} = {
  let l = listener_of(n, label, listener);
  match l.waiting {
    [id, ..rest] ->
      { net: { ..n, listeners: n.listeners.insert(listener, { ..l, waiting: rest }) }, result: id },
    [] -> match n.callers {
      [] -> { net: n, result: 0 },
      [caller, ..rest] -> {
        let fresh = connection_with_script(l.at, caller.from, caller.script);
        let c = {
          ..fresh,
          tls_name: l.tls,
          credentials: caller.credentials,
          accepted: true,
          client_certificate: caller.certificate,
        };
        {
          net: { ..n, next: n.next + 1, callers: rest, conns: n.conns.insert(n.next, c) },
          result: n.next,
        }
      },
    },
  }
}

/// Returns the next bytes from the far end, or `None` when the read times out. A read times out
/// when the far end is waiting for this end to send, has stalled, or is the program's own and has
/// sent nothing.
pub fn mem_recv(
  n: MemNet,
  label: String,
  connection: Int,
  max: Int,
  timeout_ms: Int,
) -> StepResult<Option<Bytes>> / {abort.raise} = {
  deadline("recv", timeout_ms);
  let wanted = checked_read_size(max);
  let advanced = advance_script(connection_of(n, label, connection));
  let c = { ..advanced, deadlines: advanced.deadlines.push(timeout_ms) };
  let most = if n.chunk_limit > 0 { min(wanted, n.chunk_limit) } else { wanted };
  match c.script {
    [] ->
      {
        net: with_connection(n, connection, c),
        result: if c.may_send_more { None } else { Some(b"") },
      },
    [Sends(bytes), ..rest] -> if bytes.len() > most {
      let left = bytes.slice(most, bytes.len());
      {
        net: with_connection(n, connection, { ..c, script: [Sends(left)].concat(rest) }),
        result: Some(bytes.slice(0, most)),
      }
    } else { { net: with_connection(n, connection, { ..c, script: rest }), result: Some(bytes) } },
    [Repeats(bytes), ..] ->
      {
        net: with_connection(n, connection, c),
        result: Some(bytes.slice(0, min(most, bytes.len()))),
      },
    [Stalls, ..rest] ->
      { net: with_connection(n, connection, { ..c, script: rest }), result: None },
    _ -> { net: with_connection(n, connection, c), result: None },
  }
}

/// What `net.send` returns over the network. The far end receives the bytes, and when the far end
/// is the program's own, the program reads them there.
pub fn mem_send(
  n: MemNet,
  label: String,
  connection: Int,
  payload: Bytes,
  timeout_ms: Int,
) -> StepResult<Option<Int>> / {abort.raise} = {
  deadline("send", timeout_ms);
  check_nonempty_write("send", payload.len() == 0);
  let c = advance_script(connection_of(n, label, connection));
  if c.ended || c.gone { { net: with_connection(n, connection, c), result: Some(0) } } else {
    match c.script {
      [Blocks, ..rest] ->
        { net: with_connection(n, connection, { ..c, script: rest }), result: None },
      _ -> {
        let size = if n.chunk_limit > 0 { min(payload.len(), n.chunk_limit) }
        else { payload.len() };
        let part = payload.slice(0, size);
        let mine = advance_script({
          ..c,
          sent: c.sent.concat(part),
          unheard: c.unheard.concat(part),
        });
        { net: passed_on(with_connection(n, connection, mine), c.joined, part), result: Some(size) }
      },
    }
  }
}

/// Returns the bytes `send_secret` writes to a connection, as a `Secret`: `before`, the encoded
/// `secret`, then `after`. The fake and every other handler of `send_secret` keep this value
/// instead of plain bytes, so no code can read the credential. Fails for an encoding `send_secret`
/// does not support.
pub fn sent_secret(
  before: Bytes,
  secret: Secret<Bytes>,
  encoding: String,
  after: Bytes,
) -> Secret<Bytes> / {abort.raise} = {
  let written = if encoding == "raw" { secret } else {
    match try[abort.raise] { Secret::encode(encoding, secret) } {
      Ok(text) -> text.bytes(),
      Err(_) -> panic("`net.send_secret` does not support the encoding `" ++ encoding ++ "`"),
    }
  };
  Secret::of_bytes(before).concat(written).concat(Secret::of_bytes(after))
}

/// Returns whether the credential was sent. The write is all or nothing. The far end receives the
/// whole credential, which an `ExpectsSecret` step matches, and `mem_sent_secrets` records it.
/// `mem_sent` does not contain it. Panics when the connection is joined to one of the program's own
/// listeners or clients: the program's other end would read the credential as plain bytes, while a
/// real socket delivers it intact.
pub fn mem_send_secret(
  n: MemNet,
  label: String,
  connection: Int,
  before: Bytes,
  secret: Secret<Bytes>,
  encoding: String,
  after: Bytes,
  timeout_ms: Int,
) -> StepResult<Bool> / {abort.raise} = {
  deadline("send_secret", timeout_ms);
  let framed = sent_secret(before, secret, encoding, after);
  check_nonempty_write("send_secret", framed.is_empty());
  let c = advance_script(connection_of(n, label, connection));
  if c.ended || c.gone { { net: with_connection(n, connection, c), result: false } }
  else if c.joined != None {
    panic(
      "the in-memory network cannot send a credential to the program's own end of socket "
        ++ connection.to_string()
        ++ ": that end would read the credential as plain bytes, so send it to a scripted peer instead",
    )
  } else {
    let with_secret = { ..c, sent_secrets: c.sent_secrets.push(framed) };
    match c.script {
      [Blocks, ..rest] ->
        { net: with_connection(n, connection, { ..c, script: rest }), result: false },
      [Expects(expected), ..] ->
        panic(
          "the scripted peer expected to receive \"" ++ String::of_bytes_lossy(expected)
            ++ "\" but the program sent a credential",
        ),
      [ExpectsSecret(expected), ..rest] -> if Secret::of_bytes(expected) == framed {
        {
          net: with_connection(n, connection, advance_script({ ..with_secret, script: rest })),
          result: true,
        }
      } else {
        panic(
          "the scripted peer expected one credential but the program sent a different credential",
        )
      },
      _ -> { net: with_connection(n, connection, with_secret), result: true },
    }
  }
}

fn passed_on(n: MemNet, other: Option<Int>, bytes: Bytes) -> MemNet =
  match other {
    None -> n,
    Some(id) -> match n.conns.get(id) {
      Some(c) -> with_connection(n, id, { ..c, script: c.script.push(Sends(bytes)) }),
      None -> n,
    },
  }

fn signal_far_end(n: MemNet, other: Option<Int>, closed: Bool) -> MemNet =
  match other {
    None -> n,
    Some(id) -> match n.conns.get(id) {
      Some(c) ->
        with_connection(n, id, {
          ..c,
          may_send_more: false,
          gone: c.gone || closed,
          joined: if closed { None } else { c.joined },
        }),
      None -> n,
    },
  }

/// What `net.close_write` does over the network.
pub fn mem_close_write(
  n: MemNet,
  label: String,
  connection: Int,
) -> StepResult<Unit> / {abort.raise} = {
  let c = connection_of(n, label, connection);
  {
    net: signal_far_end(
      with_connection(n, connection, advance_script({ ..c, ended: true })),
      c.joined,
      false,
    ),
    result: (),
  }
}

/// What `net.close` does over the network: the handle names nothing afterwards, a Unix listener's
/// path is free again, and what a connection sent stays readable by `mem_sent`.
pub fn mem_close(n: MemNet, label: String, socket: Int) -> StepResult<Unit> / {abort.raise} =
  match n.conns.get(socket) {
    Some(_) -> {
      let c = connection_of(n, label, socket);
      let closed_network = with_connection(n, socket, {
        ..c,
        gone: true,
        ended: true,
        joined: None,
      });
      {
        net: { ..signal_far_end(closed_network, c.joined, true), closed: n.closed.push(socket) },
        result: (),
      }
    },
    None -> {
      let _l = listener_of(n, label, socket);
      {
        net: { ..n, listeners: n.listeners.remove(socket), closed: n.closed.push(socket) },
        result: (),
      }
    },
  }

fn upgraded(
  n: MemNet,
  operation: String,
  label: String,
  connection: Int,
  who: String,
  alpn: List<String>,
  unread: Bytes,
  timeout_ms: Int,
) -> StepResult<Result<UpgradeResult, Error>> / {abort.raise} = {
  deadline(operation, timeout_ms);
  let c = advance_script(connection_of(n, label, connection));
  let secured = |rest: List<Step>| {
    {
      net: with_connection(n, connection, {
        ..c,
        script: rest,
        tls_name: Some(who),
        negotiated: alpn.at(0),
      }),
      result: Ok({ protocol: alpn.at(0) }),
    }
  };
  let over = |reason: Error| {
    {
      net: signal_far_end(
        with_connection(n, connection, {
          ..c,
          script: [],
          may_send_more: false,
          gone: true,
          ended: true,
          joined: None,
        }),
        c.joined,
        true,
      ),
      result: Err(reason),
    }
  };
  if c.tls_name != None {
    panic(
      "`net." ++ operation ++ "` cannot secure socket " ++ connection.to_string()
        ++ ": it is already TLS",
    )
  } else if c.local == None && c.peer == None {
    panic(
      "`net." ++ operation ++ "` cannot secure socket " ++ connection.to_string()
        ++ ": it is a Unix socket",
    )
  } else if unread.len() > 0 { over(Injected) } else {
    match c.script {
      [Upgrades, ..rest] -> secured(rest),
      [Sends(_), ..] -> over(Injected),
      [Repeats(_), ..] -> over(Injected),
      [Rejects(reason), ..] -> over(reason),
      [] -> if c.joined != None { secured([]) } else { over(Reset) },
      _ -> over(TimedOut),
    }
  }
}

/// What `net.start_tls` returns over the network.
pub fn mem_start_tls(
  n: MemNet,
  label: String,
  connection: Int,
  name: String,
  alpn: List<String>,
  unread: Bytes,
  timeout_ms: Int,
) -> StepResult<Result<UpgradeResult, Error>> / {abort.raise} =
  upgraded(n, "start_tls", label, connection, name, alpn, unread, timeout_ms)

/// Returns the result of securing the connection as a TLS server with `credential`. Fails when
/// `credential` was not added to the network with `mem_credential`.
pub fn mem_serve_tls(
  n: MemNet,
  label: String,
  connection: Int,
  credential: String,
  alpn: List<String>,
  unread: Bytes,
  timeout_ms: Int,
) -> StepResult<Result<UpgradeResult, Error>> / {abort.raise} =
  upgraded(n, "serve_tls", label, connection, credentialed(n, credential), alpn, unread, timeout_ms)

/// What `net.handshake` returns over the network: a secured connection has none left to complete,
/// and a plaintext one has none at all.
pub fn mem_handshake(
  n: MemNet,
  label: String,
  connection: Int,
) -> StepResult<Option<Int>> / {abort.raise} = {
  let c = connection_of(n, label, connection);
  {
    net: with_connection(n, connection, c),
    result: if c.tls_name == None { None } else { Some(0) },
  }
}

fn setting(option: SocketOption) -> Int =
  match option {
    NoDelay(_) -> 0,
    KeepAlive(_) -> 1,
    ReuseAddress(_) -> 2,
    ReusePort(_) -> 3,
    SendBuffer(_) -> 4,
    ReceiveBuffer(_) -> 5,
    Linger(_) -> 6,
    Broadcast(_) -> 7,
    MulticastLoop(_) -> 8,
    JoinGroup(_, _) -> 9,
    LeaveGroup(_, _) -> 10,
    Presenting(_) -> 11,
  }

/// `options` with `option` replacing any option for the same setting: how a fake stores the options
/// set on a socket. A group joined or left, or a credential to present, is not a setting, and is
/// not stored.
pub fn with_option(options: List<SocketOption>, option: SocketOption) -> List<SocketOption> =
  if setting(option) >= 9 { options } else {
    options.filter(|existing_option: SocketOption|
      setting(existing_option) != setting(option)).push(
      option,
    )
  }

/// What `net.set_option` returns over the network. It stores each setting, and no setting changes
/// its behavior, since it has no kernel to tune.
pub fn mem_set_option(
  n: MemNet,
  label: String,
  socket: Int,
  requested_option: SocketOption,
) -> StepResult<Result<Unit, Error>> / {abort.raise} = {
  let option = option_checked(requested_option);
  match n.conns.get(socket) {
    Some(_) -> {
      let c = connection_of(n, label, socket);
      let set = with_connection(n, socket, { ..c, options: with_option(c.options, option) });
      let presenting = match ((c.accepted, c.joined)) {
        (false, Some(peer)) -> match set.conns.get(peer) {
          Some(p) ->
            with_connection(set, peer, { ..p, client_certificate: presented_by(n, [option]) }),
          None -> set,
        },
        _ -> set,
      };
      { net: match option { Presenting(_) -> presenting, _ -> set }, result: Ok(()) }
    },
    None -> {
      let l = listener_of(n, label, socket);
      {
        net: {
          ..n,
          listeners: n.listeners.insert(socket, { ..l, options: with_option(l.options, option) }),
        },
        result: Ok(()),
      }
    },
  }
}

/// What `net.options` returns over the network: each option set, as it was last set.
pub fn mem_options(n: MemNet, label: String, socket: Int) -> List<SocketOption> / {abort.raise} =
  match n.conns.get(socket) {
    Some(_) -> connection_of(n, label, socket).options,
    None -> listener_of(n, label, socket).options,
  }

/// What `net.local_address` returns over the network.
pub fn mem_local_address(
  n: MemNet,
  label: String,
  socket: Int,
) -> Option<SocketAddress> / {abort.raise} =
  match n.conns.get(socket) {
    Some(_) -> connection_of(n, label, socket).local,
    None -> listener_of(n, label, socket).at,
  }

/// What `net.local_port` returns over the network.
pub fn mem_local_port(n: MemNet, label: String, socket: Int) -> Option<Int> / {abort.raise} =
  match mem_local_address(n, label, socket) { Some(at) -> Some(ip::socket_port(at)), None -> None }

/// What `net.peer_address` returns over the network.
pub fn mem_peer_address(
  n: MemNet,
  label: String,
  connection: Int,
) -> Option<SocketAddress> / {abort.raise} =
  match n.conns.get(connection) {
    Some(_) -> connection_of(n, label, connection).peer,
    None -> {
      let _l = listener_of(n, label, connection);
      None
    },
  }

/// Returns the certificate of the far end of a secured connection. A server gets the certificate
/// its client presents: the one given to `mem_calling_with_certificate`, or the one named by the
/// `Presenting` option on the program's own client. A client gets the certificate that
/// `mem_server_certificate` registered for the name the connection was secured as.
pub fn mem_peer_certificate(
  n: MemNet,
  label: String,
  connection: Int,
) -> Option<Bytes> / {abort.raise} =
  match n.conns.get(connection) {
    Some(_) -> {
      let c = connection_of(n, label, connection);
      match c.tls_name {
        Some(name) -> if c.accepted { c.client_certificate } else { n.leaves.get(name) },
        None -> None,
      }
    },
    None -> {
      let _l = listener_of(n, label, connection);
      None
    },
  }

/// Returns the application protocol of the connection: the first protocol offered when it was
/// upgraded, or `http/1.1` for a connection opened by `connect_tls`.
pub fn mem_protocol(n: MemNet, label: String, connection: Int) -> Option<String> / {abort.raise} =
  match n.conns.get(connection) {
    Some(_) -> connection_of(n, label, connection).negotiated,
    None -> {
      let _l = listener_of(n, label, connection);
      None
    },
  }

/// What `net.peer_credentials` returns over the network.
pub fn mem_peer_credentials(
  n: MemNet,
  label: String,
  connection: Int,
) -> Option<PeerCredentials> / {abort.raise} =
  match n.conns.get(connection) {
    Some(_) -> connection_of(n, label, connection).credentials,
    None -> {
      let _l = listener_of(n, label, connection);
      None
    },
  }

/// What `go` returned over a fake, and the network after it.
pub type RunResult<a> = { value: a, net: MemNet }

/// Runs `go` over the network `start`, with every `net` operation handled by the fake and every
/// `dns` operation by the fake's name table. Tests use it for code that opens, serves or secures
/// connections. Code that starts tasks, such as `dial`, which starts a task to limit its name
/// lookup, must run inside a `simulate` block opened within `go`, so the fake's handler is outside
/// the scheduler and still handles the `net` operations those tasks perform.
pub fn on_mem<a | e>(
  start: MemNet,
  go: () -> a / {net.read[*], net.write[*], dns.lookup, dns.reverse, dns.servers | e},
) -> RunResult<a> / {abort.raise | e bounded} =
  handle {
    go()
  } with {
    var t = start,
    net.listen[*label](port) -> {
      let s = mem_listen(t, label, port);
      t = s.net;
      s.result
    },
    net.listen_tls[*label](port, credential) -> {
      let s = mem_listen_tls(t, label, port, credential);
      t = s.net;
      s.result
    },
    net.listen_on[*label](at, options) -> {
      let s = mem_listen_on(t, label, at, options);
      t = s.net;
      s.result
    },
    net.listen_unix[*label](root, path) -> {
      let s = mem_listen_unix(t, label, root, path);
      t = s.net;
      s.result
    },
    net.connect[*label](host, port, timeout_ms) -> {
      let s = mem_connect(t, label, host, port, timeout_ms);
      t = s.net;
      s.result
    },
    net.connect_tls[*label](host, port, timeout_ms) -> {
      let s = mem_connect_tls(t, label, host, port, timeout_ms);
      t = s.net;
      s.result
    },
    net.connect_to[*label](to, options, timeout_ms) -> {
      let s = mem_connect_to(t, label, to, options, timeout_ms);
      t = s.net;
      s.result
    },
    net.connect_unix[*label](root, path, timeout_ms) -> {
      let s = mem_connect_unix(t, label, root, path, timeout_ms);
      t = s.net;
      s.result
    },
    net.handshake[*label](connection) -> {
      let s = mem_handshake(t, label, connection);
      t = s.net;
      s.result
    },
    net.start_tls[*label](connection, name, alpn, unread, timeout_ms) -> {
      let s = mem_start_tls(t, label, connection, name, alpn, unread, timeout_ms);
      t = s.net;
      s.result
    },
    net.serve_tls[*label](connection, credential, alpn, unread, timeout_ms) -> {
      let s = mem_serve_tls(t, label, connection, credential, alpn, unread, timeout_ms);
      t = s.net;
      s.result
    },
    net.accept[*label](listener) -> {
      let s = mem_accept(t, label, listener);
      t = s.net;
      s.result
    },
    net.recv[*label](connection, max, timeout_ms) -> {
      let s = mem_recv(t, label, connection, max, timeout_ms);
      t = s.net;
      s.result
    },
    net.send[*label](connection, payload, timeout_ms) -> {
      let s = mem_send(t, label, connection, payload, timeout_ms);
      t = s.net;
      s.result
    },
    net.send_secret[*label](connection, before, secret, encoding, after, timeout_ms) -> {
      let s = mem_send_secret(t, label, connection, before, secret, encoding, after, timeout_ms);
      t = s.net;
      s.result
    },
    net.close_write[*label](connection) -> {
      t = mem_close_write(t, label, connection).net;
    },
    net.close[*label](socket) -> {
      t = mem_close(t, label, socket).net;
    },
    net.set_option[*label](socket, option) -> {
      let s = mem_set_option(t, label, socket, option);
      t = s.net;
      s.result
    },
    net.local_port[*label](socket) -> mem_local_port(t, label, socket),
    net.local_address[*label](socket) -> mem_local_address(t, label, socket),
    net.peer_address[*label](connection) -> mem_peer_address(t, label, connection),
    net.peer_credentials[*label](connection) -> mem_peer_credentials(t, label, connection),
    net.peer_certificate[*label](connection) -> mem_peer_certificate(t, label, connection),
    net.protocol[*label](connection) -> mem_protocol(t, label, connection),
    net.options[*label](socket) -> mem_options(t, label, socket),
    dns.lookup(name) -> dns::table_lookup(t.names, name),
    dns.reverse(address) -> dns::table_reverse(t.names, address),
    dns.servers() -> t.names.servers,
    return value -> { value: value, net: t },
  }

host for net by host_handler

fn host_handler<a | e>(
  go: () -> a / {net.read[*], net.write[*] | e},
) -> a / {native.read, wait.read, abort.raise | e} =
  handle {
    go()
  } with {
    net.listen[*label](port) -> net_listen(label, port_checked("listen", port)),
    net.listen_tls[*label](port, credential) ->
      net_listen_tls(label, port_checked("listen_tls", port), credential),
    net.listen_on[*label](at, options) -> if !listenable(at) { Err(PermissionDenied) } else {
      decode_result(net_listen_on(label, encode_address(at), encode_options(options)), decode_int)
    },
    net.listen_unix[*label](root, path) ->
      decode_result(net_listen_unix(label, root, path), decode_int),
    net.connect[*label](host, port, timeout_ms) -> {
      deadline("connect", timeout_ms);
      found_int(job_wait(net_connect(label, host, port_checked("connect", port), timeout_ms)))
    },
    net.connect_tls[*label](host, port, timeout_ms) -> {
      deadline("connect_tls", timeout_ms);
      found_int(
        job_wait(net_connect_tls(label, host, port_checked("connect_tls", port), timeout_ms)),
      )
    },
    net.connect_to[*label](to, options, timeout_ms) -> {
      deadline("connect_to", timeout_ms);
      let connect_job = net_connect_to(
        label,
        encode_address(to),
        encode_options(options),
        timeout_ms,
      );
      decode_result(job_wait(connect_job), decode_int)
    },
    net.connect_unix[*label](root, path, timeout_ms) -> {
      deadline("connect_unix", timeout_ms);
      decode_result(job_wait(net_connect_unix(label, root, path, timeout_ms)), decode_int)
    },
    net.handshake[*label](connection) -> found_int(job_wait(net_handshake(label, connection))),
    net.start_tls[*label](connection, name, alpn, unread, timeout_ms) -> {
      deadline("start_tls", timeout_ms);
      let start_tls_job = net_start_tls(
        label,
        connection,
        name,
        encode_texts(alpn),
        unread.len(),
        timeout_ms,
      );
      decode_result(job_wait(start_tls_job), decode_upgrade_result)
    },
    net.serve_tls[*label](connection, credential, alpn, unread, timeout_ms) -> {
      deadline("serve_tls", timeout_ms);
      let serve_tls_job = net_serve_tls(
        label,
        connection,
        credential,
        encode_texts(alpn),
        unread.len(),
        timeout_ms,
      );
      decode_result(job_wait(serve_tls_job), decode_upgrade_result)
    },
    net.accept[*label](listener) -> decode_int(job_wait(net_accept(label, listener))),
    net.recv[*label](connection, max, timeout_ms) -> {
      deadline("recv", timeout_ms);
      found(job_wait(net_recv(label, connection, checked_read_size(max), timeout_ms)))
    },
    net.send[*label](connection, payload, timeout_ms) -> {
      deadline("send", timeout_ms);
      check_nonempty_write("send", payload.len() == 0);
      found_int(job_wait(net_send(label, connection, payload, timeout_ms)))
    },
    net.send_secret[*label](connection, before, secret, encoding, after, timeout_ms) -> {
      deadline("send_secret", timeout_ms);
      let framed = sent_secret(before, secret, encoding, after);
      check_nonempty_write("send_secret", framed.is_empty());
      job_wait(net_send_secret(label, connection, framed, timeout_ms)) == b"\x01"
    },
    net.close_write[*label](connection) -> net_close_write(label, connection),
    net.close[*label](socket) -> net_close(label, socket),
    net.set_option[*label](socket, option) ->
      decode_result(net_set_option(label, socket, encode_option(option)), |_: Bytes| ()),
    net.local_port[*label](socket) -> {
      let at = net_local_port(label, socket);
      if at < 0 { None } else { Some(at) }
    },
    net.local_address[*label](socket) -> address_found(net_local_address(label, socket)),
    net.peer_address[*label](connection) -> address_found(net_peer_address(label, connection)),
    net.peer_credentials[*label](connection) -> match found(
        net_peer_credentials(label, connection),
      ) {
      Some(flat) -> Some(decode_credentials(flat)),
      None -> None,
    },
    net.peer_certificate[*label](connection) -> found(net_peer_certificate(label, connection)),
    net.protocol[*label](connection) -> found_text(net_protocol(label, connection)),
    net.options[*label](socket) -> decode_options(net_options(label, socket)),
  }

extern fn net_listen(label: String, connection: Int) -> Int / {native.read}

extern fn net_listen_tls(label: String, connection: Int, credential: String) -> Int / {native.read}

extern fn net_listen_on(label: String, connection: Bytes, options: Bytes) -> Bytes / {native.read}

extern fn net_listen_unix(label: String, connection: String, path: String) -> Bytes / {native.read}

extern fn net_connect(
  label: String,
  connection: String,
  port: Int,
  timeout_ms: Int,
) -> Int / {native.read}

extern fn net_connect_tls(
  label: String,
  connection: String,
  port: Int,
  timeout_ms: Int,
) -> Int / {native.read}

extern fn net_connect_to(
  label: String,
  connection: Bytes,
  options: Bytes,
  timeout_ms: Int,
) -> Int / {native.read}

extern fn net_connect_unix(
  label: String,
  connection: String,
  path: String,
  timeout_ms: Int,
) -> Int / {native.read}

extern fn net_handshake(label: String, connection: Int) -> Int / {native.read}

extern fn net_start_tls(
  label: String,
  connection: Int,
  name: String,
  alpn: Bytes,
  unread: Int,
  timeout_ms: Int,
) -> Int / {native.read}

extern fn net_serve_tls(
  label: String,
  connection: Int,
  credential: String,
  alpn: Bytes,
  unread: Int,
  timeout_ms: Int,
) -> Int / {native.read}

extern fn net_accept(label: String, connection: Int) -> Int / {native.read}

extern fn net_recv(label: String, connection: Int, max: Int, timeout_ms: Int) -> Int / {native.read}

extern fn net_send(
  label: String,
  connection: Int,
  payload: Bytes,
  timeout_ms: Int,
) -> Int / {native.read}

extern fn net_send_secret(
  label: String,
  connection: Int,
  framed: Secret<Bytes>,
  timeout_ms: Int,
) -> Int / {native.read}

extern fn net_close_write(label: String, connection: Int) -> Unit / {native.read}

extern fn net_close(label: String, connection: Int) -> Unit / {native.read}

extern fn net_set_option(label: String, connection: Int, option: Bytes) -> Bytes / {native.read}

extern fn net_local_port(label: String, connection: Int) -> Int / {native.read}

extern fn net_local_address(label: String, connection: Int) -> Bytes / {native.read}

extern fn net_peer_address(label: String, connection: Int) -> Bytes / {native.read}

extern fn net_peer_credentials(label: String, connection: Int) -> Bytes / {native.read}

extern fn net_peer_certificate(label: String, connection: Int) -> Bytes / {native.read}

extern fn net_protocol(label: String, connection: Int) -> Bytes / {native.read}

extern fn net_options(label: String, connection: Int) -> Bytes / {native.read}

fn address_found(encoded: Bytes) -> Option<SocketAddress> / {abort.raise} =
  match found(encoded) { Some(flat) -> Some(decode_address(flat)), None -> None }

fn decode_upgrade_result(encoded: Bytes) -> UpgradeResult = { protocol: found_text(encoded) }

fn decode_credentials(flat: Bytes) -> PeerCredentials / {abort.raise} =
  match parts(flat) {
    [user, group, process] ->
      { user: decode_int(user), group: decode_int(group), process: process.i64_be_at(0) },
    _ -> panic("the host's socket function returned malformed credentials"),
  }

/// Encodes `at` for the host's socket natives with `encode_parts`. The three byte strings are the
/// address's bytes, the port in two bytes, and the zone, which is empty when there is none.
pub fn encode_address(at: SocketAddress) -> Bytes =
  encode_parts([
    ip::to_bytes(ip::socket_ip(at)),
    u16_be(ip::socket_port(at)),
    match ip::socket_zone(at) { Some(zone) -> Bytes::of_string(zone), None -> b"" },
  ])

/// The socket address `encode_address` writes.
pub fn decode_address(flat: Bytes) -> SocketAddress / {abort.raise} =
  match parts(flat) {
    [address, port, zone] -> match ip::of_bytes(address) {
      Some(a) -> {
        let at = ip::socket_at(a, port.u16_be_at(0).unwrap_or(0));
        if zone.len() == 0 { at } else {
          match ip::in_zone(at, String::of_bytes_lossy(zone)) { Some(zoned) -> zoned, None -> at }
        }
      },
      None -> panic("the host's socket function returned a malformed address"),
    },
    _ -> panic("the host's socket function returned a malformed address"),
  }

/// Encodes `requested` for the host's socket natives. The first byte is the option's number from
/// `setting`. The rest is its value: a flag is one byte, a size is eight bytes, and an option that
/// may be unset is byte 0 for unset, or byte 1 followed by its value.
pub fn encode_option(requested_option: SocketOption) -> Bytes / {abort.raise} = {
  let option = option_checked(requested_option);
  byte_of_int(setting(option)).concat(match option {
    NoDelay(on) -> flag_byte(on),
    KeepAlive(None) -> b"\x00",
    KeepAlive(Some(p)) ->
      b"\x01".concat(
        encode_parts([
          i64_be(as_nanos(p.idle)),
          match p.interval { Some(d) -> i64_be(as_nanos(d)), None -> b"" },
          match p.count { Some(n) -> i64_be(n), None -> b"" },
        ]),
      ),
    ReuseAddress(on) -> flag_byte(on),
    ReusePort(on) -> flag_byte(on),
    SendBuffer(bytes) -> i64_be(bytes),
    ReceiveBuffer(bytes) -> i64_be(bytes),
    Linger(None) -> b"\x00",
    Linger(Some(d)) -> b"\x01".concat(i64_be(as_nanos(d))),
    Broadcast(on) -> flag_byte(on),
    MulticastLoop(on) -> flag_byte(on),
    JoinGroup(group, interface) -> encode_group(group, interface),
    LeaveGroup(group, interface) -> encode_group(group, interface),
    Presenting(name) -> Bytes::of_string(name),
  })
}

fn encode_group(group: Ip, interface: Option<String>) -> Bytes =
  encode_parts([
    ip::to_bytes(group),
    match interface { Some(name) -> Bytes::of_string(name), None -> b"" },
  ])

fn decode_option(flat: Bytes) -> SocketOption / {abort.raise} = {
  let rest = flat.slice(1, flat.len());
  let on = rest.len() > 0 && rest.at(0) == 1;
  let after = if rest.len() > 0 { rest.slice(1, rest.len()) } else { b"" };
  match flat.at(0) {
    0 -> NoDelay(on),
    1 -> KeepAlive(if on { Some(decode_probing(after)) } else { None }),
    2 -> ReuseAddress(on),
    3 -> ReusePort(on),
    4 -> SendBuffer(decode_int(rest)),
    5 -> ReceiveBuffer(decode_int(rest)),
    6 -> Linger(if on { Some(nanos(decode_int(after))) } else { None }),
    7 -> Broadcast(on),
    8 -> MulticastLoop(on),
    9 -> match decode_group(rest) { (group, interface) -> JoinGroup(group, interface) },
    10 -> match decode_group(rest) { (group, interface) -> LeaveGroup(group, interface) },
    _ -> Presenting(String::of_bytes_lossy(rest)),
  }
}

fn decode_probing(flat: Bytes) -> Probing / {abort.raise} =
  match parts(flat) {
    [idle, interval, count] ->
      {
        idle: nanos(decode_int(idle)),
        interval: match interval.i64_be_at(0) { Some(n) -> Some(nanos(n)), None -> None },
        count: count.i64_be_at(0),
      },
    _ -> panic("the host's socket function returned malformed keep-alive probe settings"),
  }

fn decode_group(flat: Bytes) -> (Ip, Option<String>) / {abort.raise} =
  match parts(flat) {
    [address, interface] -> match ip::of_bytes(address) {
      Some(group) ->
        (group, if interface.len() == 0 { None } else { Some(String::of_bytes_lossy(interface)) }),
      None -> panic("the host's socket function returned a malformed multicast group"),
    },
    _ -> panic("the host's socket function returned a malformed multicast group"),
  }

/// Encodes `options` for the host's socket natives: each option is encoded by `encode_option`, and
/// the results are joined by `encode_parts`.
pub fn encode_options(options: List<SocketOption>) -> Bytes / {abort.raise} =
  encode_parts(options.map(encode_option))

/// The options `encode_options` writes.
pub fn decode_options(flat: Bytes) -> List<SocketOption> / {abort.raise} =
  parts(flat).map(decode_option)

fn decode_socket_error(flat: Bytes) -> Error / {abort.raise} = {
  let rest = flat.slice(1, flat.len());
  match flat.at(0) {
    1 -> Rejected,
    2 -> Unreachable,
    3 -> TimedOut,
    4 -> Reset,
    5 -> NameNotFound,
    6 -> AddressInUse,
    7 -> PermissionDenied,
    8 -> Injected,
    9 -> Untrusted,
    10 -> Handshake(String::of_bytes_lossy(rest)),
    _ -> match parts(rest) {
      [code, words] -> Other(decode_int(code), String::of_bytes_lossy(words)),
      _ -> Other(0, String::of_bytes_lossy(rest)),
    },
  }
}

/// Decodes a socket native's reply to an operation that may fail. If the first byte is 1, `ok`
/// converts the remaining bytes into the success value. Otherwise the remaining bytes are an error.
pub fn decode_result<a | e>(
  encoded: Bytes,
  ok: (Bytes) -> a / e,
) -> Result<a, Error> / {abort.raise | e} = {
  let rest = encoded.slice(1, encoded.len());
  if encoded.at(0) == 1 { Ok(ok(rest)) } else { Err(decode_socket_error(rest)) }
}

test "socket addresses, socket options and error results decode back to their original values after the encoding the runtime uses to pass them to the operating system" {
  let addresses = [
    ip::read_socket("192.0.2.1:80"),
    ip::read_socket("[2001:db8::1]:443"),
    ip::read_socket("[fe80::1%en0]:8080"),
  ];
  assert_eq(addresses.map(|at: SocketAddress| decode_address(encode_address(at))), addresses);
  let probing: Probing = { idle: seconds(60), interval: Some(seconds(5)), count: Some(3) };
  let options = [
    NoDelay(true),
    KeepAlive(Some(probing)),
    KeepAlive(Some({ idle: seconds(1), interval: None, count: None })),
    KeepAlive(None),
    ReuseAddress(false),
    ReusePort(true),
    SendBuffer(65536),
    ReceiveBuffer(0),
    Linger(Some(millis(250))),
    Linger(None),
    Broadcast(true),
    MulticastLoop(false),
    JoinGroup(ip::read("239.0.0.1"), Some("en0")),
    LeaveGroup(ip::read("ff02::1"), None),
    Presenting("client"),
  ];
  assert_eq(decode_options(encode_options(options)), options);
  assert_eq(decode_options(encode_options([])), []);
  let rejected = |kind: Bytes| decode_result(b"\x00".concat(kind), |_: Bytes| ());
  assert_eq(rejected(b"\x01"), Err(Rejected));
  assert_eq(rejected(b"\x09"), Err(Untrusted));
  assert_eq(rejected(b"\x0Ano shared cipher"), Err(Handshake("no shared cipher")));
  assert_eq(
    rejected(b"\x0B".concat(encode_parts([i64_be(61), b"rejected by the system"]))),
    Err(Other(61, "rejected by the system")),
  );
  assert_eq(decode_result(b"\x01".concat(i64_be(7)), decode_int), Ok(7))
}

fn head(queued: List<Bytes>) -> Bytes = match queued { [first, ..] -> first, _ -> b"" }

fn tail(queued: List<Bytes>) -> List<Bytes> = match queued { [_, ..rest] -> rest, _ -> [] }

test "drain stops at end of stream rather than at the first short read" {
  let left = handle {
    assert_eq(drain[conn](1, b"", 1000), b"abc")
  } with {
    var inbox = [b"ab", b"c", b"", b"unread"],
    net.recv[conn](c, max, timeout_ms) -> {
      let queued = inbox;
      inbox = tail(queued);
      Some(head(queued))
    },
    return u -> inbox,
  };
  assert_eq(left, [b"unread"])
}

test "`drain` keeps reading after a receive times out and returns the data it already received" {
  handle {
    assert_eq(drain[conn](1, b"", 1000), b"ab")
  } with {
    var inbox = [b"ab"],
    net.recv[conn](c, max, timeout_ms) -> {
      let queued = inbox;
      inbox = tail(queued);
      match queued { [first, ..] -> Some(first), _ -> None }
    },
  }
}

test "send_all loops over a partial write and stops at a dead peer" {
  let written = handle {
    assert(send_all[conn](1, b"hello", 1000))
  } with {
    var written = b"",
    net.send[conn](c, payload, timeout_ms) -> {
      let take = if payload.len() > 2 { 2 } else { payload.len() };
      written = written.concat(payload.slice(0, take));
      Some(take)
    },
    return u -> written,
  };
  assert_eq(written, b"hello");
  handle {
    assert(!send_all[conn](1, b"hello", 1000))
  } with {
    net.send[conn](c, payload, timeout_ms) -> Some(0),
  };
  handle {
    assert(!send_all[conn](1, b"hello", 1000))
  } with {
    net.send[conn](c, payload, timeout_ms) -> None,
  }
}

test "`net.send_secret` sends the text before the secret, then the secret in the named encoding, then the text after it, as one secret value" {
  let password = Secret::of_bytes(b"\x00ada\x00hunter2");
  let sent = handle {
    net.send_secret[smtp](1, b"AUTH PLAIN ", password, "base64", b"\r\n", 1000)
  } with {
    var wire: List<Secret<Bytes>> = [],
    net.send_secret[smtp](c, before, secret, encoding, after, timeout_ms) -> {
      wire = wire.push(sent_secret(before, secret, encoding, after));
      true
    },
    return went -> { went: went, wire: wire },
  };
  assert(sent.went);
  assert(sent.wire == [Secret::of_bytes(b"AUTH PLAIN AGFkYQBodW50ZXIy\r\n")]);
  assert(sent_secret(b"", password, "raw", b"") == password);
  assert(
    sent_secret(b"user=", Secret::of_bytes(b"\xff\x01"), "hex", b";")
      == Secret::of_bytes(b"user=ff01;"),
  )
}

fn relayed(script: List<Step>) -> MemNet / {ip.fail, abort.raise} =
  mem_serving(mem_empty(), ip::read_socket("192.0.2.25:25"), [script])

fn to_relay() -> Int / {net.connect_to[relay], ip.fail, abort.raise} =
  match net.connect_to[relay](ip::read_socket("192.0.2.25:25"), [], 1000) {
    Ok(c) -> c,
    Err(_) -> panic("the connection to the relay peer was rejected"),
  }

test "a scripted peer sends its lines in order, waits for the program to send the lines it expects, then closes" {
  let script = [Sends(b"220 ready\r\n"), Expects(b"EHLO x\r\n"), Sends(b"250 ok\r\n")];
  let ran = on_mem(relayed(script), || {
    let c = to_relay();
    let greeting = net.recv[relay](c, 512, 1000);
    let early = net.recv[relay](c, 512, 1000);
    let half = net.send[relay](c, b"EHLO", 1000);
    let waiting = net.recv[relay](c, 512, 1000);
    let rest = send_all[relay](c, b" x\r\n", 1000);
    let reply = net.recv[relay](c, 512, 1000);
    let ended = net.recv[relay](c, 512, 1000);
    net.close[relay](c);
    { c: c, read: [greeting, early, waiting, reply, ended], half: half, rest: rest }
  });
  assert_eq(ran.value.read, [Some(b"220 ready\r\n"), None, None, Some(b"250 ok\r\n"), Some(b"")]);
  assert_eq(ran.value.half, Some(4));
  assert(ran.value.rest);
  assert_eq(mem_sent(ran.net, ran.value.c), b"EHLO x\r\n");
  assert_eq(mem_remaining_script(ran.net, ran.value.c), []);
  assert_eq(ran.net.closed, [ran.value.c])
}

test "a program that sends what its peer did not expect fails at that send" {
  let failed: Result<Option<Int>, String> = try[abort.raise] {
    on_mem(relayed([Expects(b"EHLO x\r\n")]), ||
      net.send[relay](to_relay(), b"HELO x\r\n", 1000)).value
  };
  assert_eq(
    failed,
    Err("the scripted peer expected to receive \"EHLO x\r\n\" but the program sent \"HELO x\r\n\""),
  )
}

fn plain_auth() -> Bytes = b"AUTH PLAIN AGFkYQBodW50ZXIy\r\n"

test "the peer receives a password exactly as `net.send_secret` was given it, and the connection's recorded sent bytes never contain the password as plain text" {
  let password = Secret::of_bytes(b"\x00ada\x00hunter2");
  let script = [
    Sends(b"220 ready\r\n"),
    Expects(b"EHLO x\r\n"),
    Sends(b"250 AUTH PLAIN\r\n"),
    ExpectsSecret(plain_auth()),
    Sends(b"235 ok\r\n"),
  ];
  let ran = on_mem(relayed(script), || {
    let c = to_relay();
    let greeting = net.recv[relay](c, 512, 1000);
    let hello = send_all[relay](c, b"EHLO x\r\n", 1000);
    let offer = net.recv[relay](c, 512, 1000);
    let went = net.send_secret[relay](c, b"AUTH PLAIN ", password, "base64", b"\r\n", 1000);
    let reply = net.recv[relay](c, 512, 1000);
    net.close_write[relay](c);
    let late = net.send_secret[relay](c, b"", password, "raw", b"", 1000);
    net.close[relay](c);
    { c: c, read: [greeting, offer, reply], hello: hello, went: went, shed_timed_out: late }
  });
  assert(ran.value.hello && ran.value.went && !ran.value.shed_timed_out);
  assert_eq(ran.value.read, [
    Some(b"220 ready\r\n"),
    Some(b"250 AUTH PLAIN\r\n"),
    Some(b"235 ok\r\n"),
  ]);
  assert_eq(mem_sent(ran.net, ran.value.c), b"EHLO x\r\n");
  assert(mem_sent_secrets(ran.net, ran.value.c) == [Secret::of_bytes(plain_auth())]);
  assert_eq(mem_remaining_script(ran.net, ran.value.c), [])
}

test "`net.send_secret` fails when the peer expected a different secret, and the error message does not contain either secret" {
  let sent = |script: List<Step>, encoding: String| {
    let failed: Result<Bool, String> = try[abort.raise] {
      on_mem(relayed(script), ||
        net.send_secret[relay](
          to_relay(),
          b"AUTH PLAIN ",
          Secret::of_bytes(b"\x00ada\x00hunter2"),
          encoding,
          b"\r\n",
          1000,
        )).value
    };
    failed
  };
  assert_eq(sent([ExpectsSecret(plain_auth())], "base64"), Ok(true));
  assert_eq(
    sent([ExpectsSecret(plain_auth())], "raw"),
    Err("the scripted peer expected one credential but the program sent a different credential"),
  );
  assert_eq(
    sent([Expects(b"AUTH PLAIN\r\n")], "base64"),
    Err(
      "the scripted peer expected to receive \"AUTH PLAIN\r\n\" but the program sent a credential",
    ),
  );
  assert_eq(sent([Sends(b"220 ready\r\n")], "base64"), Ok(true));
  assert_eq(sent([Blocks], "base64"), Ok(false));
  assert_eq(sent([], "rot13"), Err("`net.send_secret` does not support the encoding `rot13`"));
  let pending: Result<Bool, String> = try[abort.raise] {
    on_mem(relayed([ExpectsSecret(plain_auth())]), || {
      let c = to_relay();
      let _half = net.send[relay](c, b"AUTH", 1000);
      net.send_secret[relay](c, b"", Secret::of_bytes(plain_auth()), "raw", b"", 1000)
    }).value
  };
  assert_eq(pending, Err("the scripted peer expected a credential but the program sent \"AUTH\""))
}

test "`net.recv` and `net.send` move at most as many bytes as the in-memory network's chunk limit allows" {
  let ran = on_mem(mem_chunk_limit(relayed([Sends(b"abcdefg"), Expects(b"hello")]), 3), || {
    let c = to_relay();
    let read = [
      net.recv[relay](c, 512, 1000),
      net.recv[relay](c, 2, 1000),
      net.recv[relay](c, 512, 1000),
    ];
    let partial = net.send[relay](c, b"hello", 1000);
    { c: c, read: read, partial: partial, whole: send_all[relay](c, b"lo", 1000) }
  });
  assert_eq(ran.value.read, [Some(b"abc"), Some(b"de"), Some(b"fg")]);
  assert_eq(ran.value.partial, Some(3));
  assert(ran.value.whole);
  assert_eq(mem_remaining_script(ran.net, ran.value.c), [])
}

test "`net.start_tls` secures the connection when the peer upgrades, and later data is read over the secured connection" {
  let script = [
    Sends(b"220 go ahead\r\n"),
    Upgrades,
    Expects(b"EHLO x\r\n"),
    Sends(b"250 secured\r\n"),
  ];
  let ran = on_mem(relayed(script), || {
    let c = to_relay();
    let go_ahead = net.recv[relay](c, 512, 1000);
    let read_before_upgrade = net.recv[relay](c, 512, 1000);
    let before = net.handshake[relay](c);
    let secured = net.start_tls[relay](c, "mail.example", [], b"", 1000);
    let after = net.handshake[relay](c);
    let sent = send_all[relay](c, b"EHLO x\r\n", 1000);
    {
      c: c,
      go_ahead: go_ahead,
      held: read_before_upgrade,
      before: before,
      secured: secured,
      after: after,
      sent: sent,
      reply: net.recv[relay](c, 512, 1000),
    }
  });
  assert_eq(ran.value.go_ahead, Some(b"220 go ahead\r\n"));
  assert_eq(ran.value.held, None);
  assert_eq(ran.value.before, None);
  assert_eq(ran.value.secured, Ok({ protocol: None }));
  assert_eq(ran.value.after, Some(0));
  assert(ran.value.sent);
  assert_eq(ran.value.reply, Some(b"250 secured\r\n"));
  assert_eq(mem_secured(ran.net, ran.value.c), Some("mail.example"))
}

test "`net.start_tls` fails with `Injected` if the peer sent plaintext after its `220 go ahead` reply, whether it is still in the socket or in the caller's unread buffer" {
  let waiting = on_mem(
    relayed([Sends(b"220 go ahead\r\n"), Sends(b"250 injected\r\n"), Upgrades]),
    || {
      let c = to_relay();
      let _go_ahead = net.recv[relay](c, 512, 1000);
      let rejected = net.start_tls[relay](c, "mail.example", [], b"", 1000);
      {
        c: c,
        rejected: rejected,
        read: net.recv[relay](c, 512, 1000),
        wrote: net.send[relay](c, b"AUTH", 1000),
      }
    },
  );
  assert_eq(waiting.value.rejected, Err(Injected));
  assert_eq(waiting.value.read, Some(b""));
  assert_eq(waiting.value.wrote, Some(0));
  assert_eq(mem_secured(waiting.net, waiting.value.c), None);
  let buffered = on_mem(relayed([Sends(b"220 go ahead\r\n250 injected\r\n"), Upgrades]), || {
    let c = to_relay();
    let read = match net.recv[relay](c, 512, 1000) { Some(bytes) -> bytes, None -> b"" };
    let unread = read.slice(b"220 go ahead\r\n".len(), read.len());
    net.start_tls[relay](c, "mail.example", [], unread, 1000)
  });
  assert_eq(buffered.value, Err(Injected))
}

test "`net.start_tls` against a peer that {c.outcome} returns {c.shown}" for c: { outcome: String, script: List<Step>, alpn: List<String>, shown: String, result: Result<UpgradeResult, Error> } in [
    {
      outcome: "upgrades with a protocol offered",
      script: [Upgrades],
      alpn: ["postgresql", "h2"],
      shown: "the first offered",
      result: Ok({ protocol: Some("postgresql") }),
    },
    {
      outcome: "shows a certificate not trusted",
      script: [Rejects(Untrusted)],
      alpn: [],
      shown: "Untrusted",
      result: Err(Untrusted),
    },
    {
      outcome: "fails the handshake",
      script: [Rejects(Handshake("no cipher suite in common"))],
      alpn: [],
      shown: "why",
      result: Err(Handshake("no cipher suite in common")),
    },
    {
      outcome: "stalls",
      script: [Stalls, Upgrades],
      alpn: [],
      shown: "TimedOut",
      result: Err(TimedOut),
    },
    {
      outcome: "still waits to hear something",
      script: [Expects(b"STARTTLS\r\n"), Upgrades],
      alpn: [],
      shown: "TimedOut",
      result: Err(TimedOut),
    },
    { outcome: "is gone", script: [], alpn: [], shown: "Reset", result: Err(Reset) },
  ] {
  let ran = on_mem(relayed(c.script), || {
    let connection = to_relay();
    {
      result: net.start_tls[relay](connection, "db.example", c.alpn, b"", 1000),
      after: net.send[relay](connection, b"x", 1000),
    }
  });
  assert_eq(ran.value.result, c.result);
  assert_eq(ran.value.after, match c.result { Ok(_) -> Some(1), Err(_) -> Some(0) })
}

test "a failed connection or upgrade is raised by the functions that open one" {
  let ran = on_mem(relayed([Rejects(Untrusted)]), || {
    let c = to_relay();
    let upgrade: Result<UpgradeResult, Error> = try {
      secure[relay](c, "mail.example", [], b"", 1000)
    };
    let nobody: Result<Int, Error> = try[socket.fail] {
      dial_address[relay](ip::read_socket("192.0.2.26:25"), [], 1000)
    };
    let beyond: Result<Int, Error> = try[socket.fail] {
      listening[listener](ip::read_socket("192.0.2.1:80"), [])
    };
    { upgrade: upgrade, nobody: nobody, beyond: beyond }
  });
  assert_eq(ran.value.upgrade, Err(Untrusted));
  assert_eq(ran.value.nobody, Err(Rejected));
  assert_eq(ran.value.beyond, Err(PermissionDenied))
}

test "`net.accept` returns each waiting client with its own address, then reports that the listener has stopped" {
  let callers = mem_calling(
    mem_calling(mem_empty(), ip::read_socket("203.0.113.9:4431"), [Sends(b"hi"), Expects(b"yo")]),
    ip::read_socket("[2001:db8::9]:4432"),
    [],
  );
  let ran = on_mem(callers, || {
    let l = net.listen[listener](0);
    let first = net.accept[listener](l);
    let second = net.accept[listener](l);
    let third = net.accept[listener](l);
    let received = net.recv[conn](first, 64, 1000);
    let encoded = net.send[conn](first, b"yo", 1000);
    {
      first: first,
      third: third,
      port: net.local_port[listener](l),
      here: net.local_address[conn](first),
      peers: [
        net.peer_address[conn](first),
        net.peer_address[conn](second),
        net.peer_address[listener](l),
      ],
      output_lines: received,
      messages: encoded,
      ended: net.recv[conn](first, 64, 1000),
    }
  });
  assert_eq(ran.value.third, 0);
  assert_eq(ran.value.port, Some(49152));
  assert_eq(ran.value.here, Some(ip::read_socket("127.0.0.1:49152")));
  assert_eq(ran.value.peers, [
    Some(ip::read_socket("203.0.113.9:4431")),
    Some(ip::read_socket("[2001:db8::9]:4432")),
    None,
  ]);
  assert_eq(ran.value.output_lines, Some(b"hi"));
  assert_eq(ran.value.messages, Some(2));
  assert_eq(ran.value.ended, Some(b""));
  assert_eq(mem_remaining_script(ran.net, ran.value.first), [])
}

test "`net.serve_tls` upgrades a client that sent STARTTLS using the named server credential, and fails if the caller's unread buffer holds bytes the client sent before the upgrade" {
  let client_script = [
    Sends(b"STARTTLS\r\n"),
    Expects(b"220 go ahead\r\n"),
    Upgrades,
    Sends(b"EHLO x\r\n"),
  ];
  let client = ip::read_socket("203.0.113.9:4431");
  let host_handler = |script: List<Step>, unread: Bytes| {
    on_mem(mem_credential(mem_calling(mem_empty(), client, script), "mail"), || {
      let l = net.listen[listener](2525);
      let c = net.accept[listener](l);
      let _asked = net.recv[conn](c, 512, 1000);
      let _told = send_all[conn](c, b"220 go ahead\r\n", 1000);
      let secured = net.serve_tls[conn](c, "mail", [], unread, 1000);
      { c: c, secured: secured, next: net.recv[conn](c, 512, 1000) }
    })
  };
  let ran = host_handler(client_script, b"");
  assert_eq(ran.value.secured, Ok({ protocol: None }));
  assert_eq(ran.value.next, Some(b"EHLO x\r\n"));
  assert_eq(mem_secured(ran.net, ran.value.c), Some("mail"));
  let injected = host_handler(client_script, b"MAIL FROM:<mallory@example>\r\n");
  assert_eq(injected.value.secured, Err(Injected));
  assert_eq(injected.value.next, Some(b""));
  let unheld: Result<Result<UpgradeResult, Error>, String> = try[abort.raise] {
    on_mem(mem_calling(mem_empty(), client, client_script), || {
      let c = net.accept[listener](net.listen[listener](2525));
      net.serve_tls[conn](c, "mail", [], b"", 1000)
    }).value
  };
  assert_eq(unheld, Err("no TLS credential named `mail` was configured for this run"))
}

test "a connection to the program's own listener passes bytes and end-of-stream both ways between client and server" {
  let ran = on_mem(mem_empty(), || {
    let here = ip::read_socket("127.0.0.1:8080");
    let l = listening[listener](here, []);
    let client = dial_address[client](here, [], 1000);
    let server = net.accept[listener](l);
    let quiet = net.recv[conn](server, 64, 1000);
    let ping_sent = net.send[client](client, b"ping", 1000);
    let received = net.recv[conn](server, 64, 1000);
    let returned = net.send[conn](server, b"pong", 1000);
    net.close_write[client](client);
    let after_end = net.send[client](client, b"more", 1000);
    let ended = net.recv[conn](server, 64, 1000);
    let reply = net.recv[client](client, 64, 1000);
    net.close[client](client);
    {
      quiet: quiet,
      requested: ping_sent,
      output_lines: received,
      returned: returned,
      after_end: after_end,
      ended: ended,
      reply: reply,
      gone: net.send[conn](server, b"late", 1000),
      from: net.peer_address[conn](server),
      none_left: net.accept[listener](l),
    }
  });
  assert_eq(ran.value.quiet, None);
  assert_eq(ran.value.requested, Some(4));
  assert_eq(ran.value.output_lines, Some(b"ping"));
  assert_eq(ran.value.returned, Some(4));
  assert_eq(ran.value.after_end, Some(0));
  assert_eq(ran.value.ended, Some(b""));
  assert_eq(ran.value.reply, Some(b"pong"));
  assert_eq(ran.value.gone, Some(0));
  assert_eq(ran.value.from, Some(ip::read_socket("127.0.0.1:49152")));
  assert_eq(ran.value.none_left, 0)
}

test "connecting to a host name tries the name's addresses in the order listed, and fails for a name with none" {
  let names = dns::with_name(dns::table(), "db.example", [
    ip::read("2001:db8::5"),
    ip::read("192.0.2.5"),
  ]);
  let world = mem_failing(
    mem_serving(mem_resolving(mem_empty(), names), ip::read_socket("192.0.2.5:5432"), [
      [Sends(b"R")],
      [Sends(b"R")],
      [Sends(b"R")],
    ]),
    ip::read_socket("[2001:db8::5]:5432"),
    Unreachable,
  );
  let ran = on_mem(world, ||
    simulate {
      task::unbounded(|| {
        let by_host = net.connect[db]("db.example", 5432, 1000);
        let tls = net.connect_tls[db]("db.example", 5432, 1000);
        let dialled = dial[db]("DB.example.", 5432, [], 1000);
        let nowhere = net.connect[db]("other.example", 5432, 1000);
        let unknown: Result<Int, Error> = try { dial[db]("other.example", 5432, [], 1000) };
        let foreign: Result<Int, Error> = try { dial[db]("b\u{fc}cher.example", 5432, [], 1000) };
        let spent: Result<Int, Error> = try { dial[db]("db.example", 5432, [], 1000) };
        {
          by_host: by_host,
          tls: tls,
          peer: net.peer_address[db](dialled),
          nowhere: nowhere,
          unknown_effect: unknown,
          foreign: foreign,
          spent: spent,
        }
      })
    });
  assert_eq(ran.value.by_host, Some(1));
  assert_eq(ran.value.tls, Some(2));
  assert_eq(mem_secured(ran.net, 2), Some("db.example"));
  assert_eq(ran.value.peer, Some(ip::read_socket("192.0.2.5:5432")));
  assert_eq(ran.value.nowhere, None);
  assert_eq(ran.value.unknown_effect, Err(NameNotFound));
  assert_eq(
    ran.value.foreign,
    Err(
      Other(
        0,
        "the name must be ASCII: convert an internationalized name to its ASCII form (`xn--` Punycode) before the lookup",
      ),
    ),
  );
  assert_eq(ran.value.spent, Err(Rejected))
}

fn pending<a | e>(
  dead: List<SocketAddress>,
  go: () -> a / {net.connect_to[db] | e},
) -> a / {clock.write | e} =
  handle {
    go()
  } with {
    net.connect_to[db](to, _options, timeout_ms) -> if dead.contains(to) {
      clock.sleep(millis(timeout_ms));
      Err(TimedOut)
    } else { Ok(7) },
  }

test "`dial` uses one deadline for all of a name's addresses, and an unresponsive address uses part of the remaining time" {
  let hosts = [ip::read("192.0.2.5"), ip::read("192.0.2.6"), ip::read("192.0.2.7")];
  let names = dns::with_name(dns::table(), "db.example", hosts);
  let at = |n: Int| hosts.take(n).map(|host: Ip| ip::socket_at(host, 5432));
  simulate {
    let began = clock.now();
    let since = || as_millis(between(began, clock.now()));
    dns::on_table(names, ||
      task::unbounded(|| {
        assert_eq(pending(at(1), || dial[db]("db.example", 5432, [], 900)), 7);
        assert_eq(since(), 300);
        let none: Result<Int, Error> = try {
          pending(at(3), || dial[db]("db.example", 5432, [], 1000))
        };
        assert_eq((none, since()), (Err(TimedOut), 1300));
        let timed_dial = task::timeout(millis(300), ||
          pending(at(1), || dial[db]("db.example", 5432, [], 900)));
        assert_eq((timed_dial, since()), (task::Done(7), 1400))
      }))
  }
}

test "`dial_tls` connects by name and starts TLS, and it closes the connection when the TLS handshake fails" {
  let names = dns::with_name(dns::table(), "api.example", [ip::read("192.0.2.7")]);
  let world = mem_serving(mem_resolving(mem_empty(), names), ip::read_socket("192.0.2.7:443"), [
    [Upgrades, Sends(b"ok")],
    [Rejects(Untrusted)],
  ]);
  let ran = on_mem(world, ||
    simulate {
      task::unbounded(|| {
        let c = dial_tls[api]("api.example", 443, ["h2"], [], 1000);
        let rejected: Result<Int, Error> = try { dial_tls[api]("api.example", 443, [], [], 1000) };
        { c: c, read: net.recv[api](c, 16, 1000), rejected: rejected }
      })
    });
  assert_eq(ran.value.read, Some(b"ok"));
  assert_eq(mem_secured(ran.net, ran.value.c), Some("api.example"));
  assert_eq(ran.value.rejected, Err(Untrusted));
  assert_eq(ran.net.closed, [2])
}

test "`net.peer_certificate` returns no certificate before the TLS handshake, then the server certificate for the name given" {
  let at = ip::read_socket("192.0.2.9:5432");
  let world = mem_server_certificate(
    mem_serving(mem_empty(), at, [[Upgrades]]),
    "db.example",
    b"leaf",
  );
  let ran = on_mem(world, || {
    let c = dial_address[db](at, [], 1000);
    let before = net.peer_certificate[db](c);
    secure[db](c, "db.example", [], b"", 1000);
    { before: before, after: net.peer_certificate[db](c) }
  });
  assert_eq(ran.value, { before: None, after: Some(b"leaf") })
}

test "a TLS server connection returns the client's certificate, or no certificate if the client sent none" {
  let world = mem_calling(
    mem_calling_with_certificate(
      mem_credential(mem_empty(), "api"),
      ip::read_socket("198.51.100.4:5000"),
      b"client leaf",
      [],
    ),
    ip::read_socket("198.51.100.5:5000"),
    [],
  );
  let ran = on_mem(world, || {
    let l = net.listen_tls[web](0, "api");
    let first = net.accept[web](l);
    let second = net.accept[web](l);
    [net.peer_certificate[web](first), net.peer_certificate[web](second)]
  });
  assert_eq(ran.value, [Some(b"client leaf"), None])
}

test "the program's own TLS listener sees the client's certificate, or no certificate if the client sent none" {
  let world = mem_server_certificate(mem_credential(mem_empty(), "api"), "caller", b"caller leaf");
  let ran = on_mem(world, || {
    let here = ip::read_socket("127.0.0.1:8443");
    let l = listening[listener](here, []);
    let presenting = dial_address[client](here, [Presenting("caller")], 1000);
    let later = dial_address[client](here, [], 1000);
    let anonymous = dial_address[client](here, [], 1000);
    let set = net.set_option[client](later, Presenting("caller"));
    let host_handler = [presenting, later, anonymous].map(|_c: Int| {
      let c = net.accept[listener](l);
      let _secured = net.serve_tls[listener](c, "api", [], b"", 1000);
      net.peer_certificate[listener](c)
    });
    { set: set, served: host_handler, options: net.options[client](presenting) }
  });
  assert_eq(ran.value.set, Ok(()));
  assert_eq(ran.value.served, [Some(b"caller leaf"), Some(b"caller leaf"), None]);
  assert_eq(ran.value.options, [NoDelay(true)])
}

test "`net.protocol` returns no protocol on a plaintext connection and the negotiated protocol after the TLS handshake" {
  let at = ip::read_socket("192.0.2.9:443");
  let ran = on_mem(mem_serving(mem_empty(), at, [[Upgrades]]), || {
    let c = dial_address[web](at, [], 1000);
    let before = net.protocol[web](c);
    let secured = secure[web](c, "web.example", ["h2", "http/1.1"], b"", 1000);
    { before: before, secured: secured.protocol, after: net.protocol[web](c) }
  });
  assert_eq(ran.value, { before: None, secured: Some("h2"), after: Some("h2") })
}

test "`net.options` returns the options a socket was opened with, plus any options set on it later" {
  let probing = {
    idle: Duration(60000000000),
    interval: Some(Duration(10000000000)),
    count: Some(3),
  };
  let ran = on_mem(relayed([]), || {
    let c = match net.connect_to[relay](
        ip::read_socket("192.0.2.25:25"),
        [KeepAlive(Some(probing)), NoDelay(false)],
        1000,
      ) {
      Ok(c) -> c,
      Err(_) -> panic("the connection to the relay peer was rejected"),
    };
    let opened = net.options[relay](c);
    let set = net.set_option[relay](c, Linger(Some(Duration(0))));
    let l = listening[listener](ip::read_socket("127.0.0.1:0"), [ReusePort(true)]);
    { opened: opened, set: set, now: net.options[relay](c), listener: net.options[listener](l) }
  });
  assert_eq(ran.value.opened, [KeepAlive(Some(probing)), NoDelay(false)]);
  assert_eq(ran.value.set, Ok(()));
  assert_eq(ran.value.now, [KeepAlive(Some(probing)), NoDelay(false), Linger(Some(Duration(0)))]);
  assert_eq(ran.value.listener, [ReuseAddress(true), ReusePort(true)])
}

test "listening on a Unix socket path that a listener already uses fails with `AddressInUse`, and a Unix connection reports the peer's user, group and process" {
  let who = { user: 501, group: 20, process: Some(4242) };
  let world = mem_serving_unix(
    mem_calling_unix(mem_empty(), who, [Sends(b"hello")]),
    "run",
    "docker.sock",
    [[Sends(b"{}")]],
  );
  let ran = on_mem(world, || {
    let l = listening_unix[listener]("run", "app.sock");
    let twice = net.listen_unix[listener]("run", "app.sock");
    let taken = net.listen_unix[listener]("run", "docker.sock");
    let mine = dial_unix[client]("run", "app.sock", 1000);
    let joined = net.accept[listener](l);
    let scripted = net.accept[listener](l);
    let docker = dial_unix[client]("run", "docker.sock", 1000);
    net.close[listener](l);
    {
      twice: twice,
      taken: taken,
      nobody: net.connect_unix[client]("run", "absent.sock", 1000),
      ends: [net.peer_address[client](mine), net.local_address[conn](joined)],
      owners: [net.peer_credentials[conn](joined), net.peer_credentials[conn](scripted)],
      read: [net.recv[conn](scripted, 64, 1000), net.recv[client](docker, 64, 1000)],
      reprinted: net.listen_unix[listener]("run", "app.sock"),
    }
  });
  assert_eq(ran.value.twice, Err(AddressInUse));
  assert_eq(ran.value.taken, Err(AddressInUse));
  assert_eq(ran.value.nobody, Err(Rejected));
  assert_eq(ran.value.ends, [None, None]);
  assert_eq(ran.value.owners, [None, Some(who)]);
  assert_eq(ran.value.read, [Some(b"hello"), Some(b"{}")]);
  assert_eq(ran.value.reprinted, Ok(6))
}

test "a connection can be read and written as streams, and `with_scope` closes the connection afterwards" {
  let script = [Expects(b"PING\n"), ExpectsEnd, Sends(b"one\ntw"), Sends(b"o\nthree")];
  let ran = on_mem(relayed(script), || {
    let c = to_relay();
    with_scope[conn](
      reading[relay](c, 1000),
      io::close_source,
    ) { source -> {
      with_scope[out](
        writing[relay](c, 1000),
        io::close_sink,
      ) { sink -> io::write(sink, b"PING\n") };
      io::fold_lines(source, 4, 1024, [], |lines: List<Bytes>, line: Bytes| lines.push(line))
    } }
  });
  assert_eq(ran.value, [b"one", b"two", b"three"]);
  assert_eq(mem_remaining_script(ran.net, 1), []);
  assert_eq(ran.net.closed, [1])
}

test "a stream read that times out fails with `TimedOut`, and the connection is still closed" {
  let ran = on_mem(relayed([Sends(b"partial"), Stalls]), || {
    let c = to_relay();
    let read: Result<Bytes, Error> = try[socket.fail] {
      with_scope[conn](
        reading[relay](c, 1000),
        io::close_source,
      ) { source -> io::read_all(source, 64, 1024) }
    };
    read
  });
  assert_eq(ran.value, Err(TimedOut));
  assert_eq(ran.net.closed, [1])
}

test "the simulated network rejects {c.what} with the same error message as the real host" for c: { misuse: String, what: String, says: String } in [
    {
      misuse: "label",
      what: "a socket under two labels",
      says: "socket 1 is being used as `net[other]` and `net[relay]`",
    },
    { misuse: "closed", what: "a closed socket", says: "there is no open socket with handle 1" },
    {
      misuse: "deadline",
      what: "a deadline of zero",
      says: "`net.recv` was given a timeout of 0 milliseconds",
    },
    { misuse: "nothing", what: "an empty payload", says: "`net.send` was given an empty payload" },
    {
      misuse: "no secret",
      what: "an empty credential in an empty frame",
      says: "`net.send_secret` was given an empty payload",
    },
    {
      misuse: "encoding",
      what: "a credential in an encoding it does not write",
      says: "`net.send_secret` does not support the encoding `rot13`",
    },
    { misuse: "none", what: "a read of no bytes", says: "`net.recv` was asked for 0 bytes" },
    {
      misuse: "listener",
      what: "a read of a listener",
      says: "socket 2 is a listener, and this operation wants a connection",
    },
    {
      misuse: "accept",
      what: "an accept on a connection",
      says: "socket 1 is a connection, and `net.accept` wants a listener",
    },
    {
      misuse: "bound",
      what: "a port already bound",
      says: "`net.listen` could not bind 127.0.0.1:8080: address in use",
    },
    {
      misuse: "twice",
      what: "a second upgrade",
      says: "`net.start_tls` cannot secure socket 1: it is already TLS",
    },
  ] {
  let failed: Result<Unit, String> = try[abort.raise] {
    on_mem(relayed([Upgrades]), || {
      let connection = to_relay();
      if c.misuse == "label" { net.close[other](connection) } else if c.misuse == "closed" {
        net.close[relay](connection);
        net.close[relay](connection)
      } else if c.misuse == "deadline" {
        let _read = net.recv[relay](connection, 16, 0);
        ()
      } else if c.misuse == "nothing" {
        let _sent = net.send[relay](connection, b"", 1000);
        ()
      } else if c.misuse == "no secret" {
        let _sent = net.send_secret[relay](
          connection,
          b"",
          Secret::of_bytes(b""),
          "raw",
          b"",
          1000,
        );
        ()
      } else if c.misuse == "encoding" {
        let _sent = net.send_secret[relay](
          connection,
          b"",
          Secret::of_bytes(b"k"),
          "rot13",
          b"",
          1000,
        );
        ()
      } else if c.misuse == "none" {
        let _read = net.recv[relay](connection, 0, 1000);
        ()
      } else if c.misuse == "listener" {
        let _read = net.recv[listener](net.listen[listener](8080), 16, 1000);
        ()
      } else if c.misuse == "accept" {
        let _taken = net.accept[relay](connection);
        ()
      } else if c.misuse == "bound" {
        let _first = net.listen[listener](8080);
        let _second = net.listen[listener](8080);
        ()
      } else {
        let _once = net.start_tls[relay](connection, "mail.example", [], b"", 1000);
        let _twice = net.start_tls[relay](connection, "mail.example", [], b"", 1000);
        ()
      }
    }).value
  };
  assert_eq(failed, Err(c.says))
}

test "`send_all` and `drain` work with a `net` instance of any name, such as `net[upstream]`" {
  let written = handle {
    assert(send_all[upstream](1, b"hello", 1000));
    assert_eq(drain[upstream](1, b"", 1000), b"hi")
  } with {
    var written = b"",
    var inbox = [b"hi", b""],
    net.send[upstream](c, payload, timeout_ms) -> {
      written = written.concat(payload);
      Some(payload.len())
    },
    net.recv[upstream](c, max, timeout_ms) -> {
      let queued = inbox;
      inbox = tail(queued);
      Some(head(queued))
    },
    return u -> written,
  };
  assert_eq(written, b"hello")
}
