//! Sockets: TCP, TLS and Unix sockets, as an effect whose label names what a connection is for.
//!
//! Every operation takes its resource label from the caller (`net.send[conn](..)` writes to a
//! connection this program answered, `net.send[upstream](..)` to one it opened), so two labels never
//! conflict. A deadline is milliseconds; `timeout_ms <= 0` is a runtime error. On the operations that
//! answer an `Option`, `None` is a deadline expiring and an empty `Some` is the peer done sending.
//! There is no timeout a socket keeps: each read and write is handed its own.
//!
//! An address is `std.ip`'s: `connect_to` and `listen_on` take a `SocketAddress`, and
//! `peer_address` and `local_address` answer one, so what a filter checked is what is connected to.
//! The operations added with them answer a `Result` whose `Err` is a `Refusal` saying why; the
//! functions here that open something (`dial`, `dial_address`, `listening`, `secure`) raise it as
//! `socket.refused` instead, and `try` makes it a `Result` again. `socket` is an effect of its own
//! because `net` is `nondet` and a raise is not.
//!
//! `connect` and `connect_tls` hand the host a name, and the host looks it up as `dns.lookup`
//! would and tries each address in turn. `dial` is that loop written here: it performs
//! `dns.lookup`, orders the addresses with `dns::interleave`, and connects with `connect_to`, so a
//! test's table decides where a name connects and a caller that validated an address connects to
//! that address. Its `timeout_ms` is one deadline on the clock for the lookup and every attempt,
//! and it is held to a `std.task` deadline around it, so it runs under `simulate` or a run with
//! `task::unbounded` or a deadline above it. It tries one address at a time and races none.
//! Every connection has `NoDelay` on; a `SocketOption` is set as a connection or a
//! listener opens, or later with `set_option`, and `options` reads each back.
//!
//! `start_tls` secures a connection that is already open, as SMTP's `STARTTLS` and Postgres's
//! `SSLRequest` ask: the handle is the secured connection afterwards, the handshake completes
//! inside the call, and the server is verified as `connect_tls` verifies one. Plaintext read
//! before the handshake must not be trusted after it, so the caller hands over what it has read
//! and not consumed and anything there is `Injected`, as is anything the socket still holds;
//! `serve_tls` is the server's half. A refusal ends the connection.
//!
//! A listener binds a loopback address. `listen_unix` and `connect_unix` name a path under a
//! filesystem root the run binds with `--fs`, confined as `std.fs` confines one; closing the
//! listener removes the socket's file, so open one under `with_hold` or `bracket`.
//! `peer_credentials` says who holds the far end of one.
//!
//! `reading` and `writing` are a connection as `std.io`'s `Source` and `Sink`: under `with_hold`
//! the source's release closes the connection and the sink's ends this end's sending.
//!
//! The twin is `MemNet`, with a `mem_` function for every operation, and `on_mem` runs code
//! written against any labels over one, answering `dns` from the table it holds. A far end is a
//! script of `Step`s (what it says, what it must hear first, where it upgrades), or the program's
//! own listener, in which case the two ends are joined. It refuses what the host refuses, in the
//! host's words. Nothing waits in it: a read with nothing to answer is a deadline.

import std.bytes
import std.bytes (i64_be, u16_be)
import std.dns
import std.dns (dns)
import std.internal.native (native, wait, job_wait, found, parts, in_parts, int_of)
import std.io
import std.io (Sink, Source)
import std.ip
import std.ip (Ip, SocketAddress, ip)
import std.list
import std.option
import std.task
import std.time (after, as_millis, as_nanos, between, millis, nanos, seconds)

/// Why a socket operation did not do what it was asked.
pub type Refusal =
  /// Nothing is listening where the connection was sent.
  | Refused
  /// No route leads to the address.
  | Unreachable
  /// The deadline passed first.
  | TimedOut
  /// The peer ended the connection.
  | Reset
  /// The name has no address.
  | NameNotFound
  /// The address is bound already.
  | AddressInUse
  /// The run may not do this: a listener beyond loopback, or a path it cannot open.
  | PermissionDenied
  /// Plaintext was waiting to be read where a TLS handshake was to begin.
  | Injected
  /// The peer's certificate is not one this run trusts for the name.
  | Untrusted
  /// The TLS handshake failed for the reason given.
  | Handshake(String)
  /// The host refused for a reason of its own: its error number, and what it says.
  | Other(Int, String)

/// What an upgrade to TLS settled: the application protocol the two ends agreed on, where one was
/// offered and taken.
pub type Secured = { protocol: Option<String> }

/// When an idle connection is probed, and where the platform lets a program say, how often and how
/// many unanswered probes end it.
pub type Probing = { idle: Duration, interval: Option<Duration>, count: Option<Int> }

/// One setting of a socket.
pub type SocketOption =
  /// Send small writes at once rather than gathering them (`TCP_NODELAY`). On for every
  /// connection unless set off.
  | NoDelay(Bool)
  /// Probe an idle connection, or `None` to stop.
  | KeepAlive(Option<Probing>)
  /// Bind an address still in its closing wait (`SO_REUSEADDR`). On for every listener.
  | ReuseAddress(Bool)
  /// Let several listeners share one port (`SO_REUSEPORT`).
  | ReusePort(Bool)
  /// The send buffer's size in bytes, which the host may round.
  | SendBuffer(Int)
  /// The receive buffer's size in bytes, which the host may round.
  | ReceiveBuffer(Int)
  /// How long a close waits for unsent bytes to leave, or `None` for the host's own way.
  | Linger(Option<Duration>)
  /// Let a datagram socket send to a broadcast address (`SO_BROADCAST`).
  | Broadcast(Bool)
  /// Whether a datagram socket hears what it sends to a group it has joined.
  | MulticastLoop(Bool)
  /// Join a multicast group on the interface named, or on the one the host picks. It is set and
  /// not read back: `options` lists no membership.
  | JoinGroup(Ip, Option<String>)
  /// Leave a multicast group joined on that interface.
  | LeaveGroup(Ip, Option<String>)
  /// Present the certificate of the credential `--tls NAME=CERT,KEY` named this when a later
  /// `start_tls` secures the connection and its server asks for a client certificate; one the run
  /// lacks is `E0429` at that `start_tls`. It is set and not read back: `options` lists none.
  | Presenting(String)

/// Who holds the far end of a Unix socket: its user, its group, and its process where the platform
/// says.
pub type PeerCredentials = { user: Int, group: Int, process: Option<Int> }

/// Listeners and connections, under the label the caller names them by.
pub nondet effect net {
  /// A listener on `port`; port `0` asks for any free one, which `local_port` then names.
  write listen[s](port: Int) -> Int
  /// A listener that serves TLS with the credential `--tls NAME=CERT,KEY` named `credential`; one
  /// the run lacks is `E0429`.
  write listen_tls[s](port: Int, credential: String) -> Int
  /// A listener at exactly `at`, which is a loopback address, with `options` set before it binds.
  /// Any other address is `PermissionDenied`.
  write listen_on[s](at: SocketAddress, options: List<SocketOption>) -> Result<Int, Refusal>
  /// A listener on the Unix socket at `path` under the root `--fs` binds as `root`. A path
  /// something is already at is `AddressInUse`; `close` removes the one this made.
  write listen_unix[s](root: String, path: String) -> Result<Int, Refusal>
  /// A connection to `host`, trying each address it resolves to until the deadline. `None` is a
  /// host not reached, for any reason.
  write connect[s](host: String, port: Int, timeout_ms: Int) -> Option<Int>
  /// `connect` over TLS: the server is verified as `host` against the built-in roots and any
  /// `--trust` certificate. The handshake is left to the first `send` or `recv`, so a peer that
  /// connects and says nothing costs nothing; a failed one reads as the peer done sending and
  /// writes `0` bytes.
  write connect_tls[s](host: String, port: Int, timeout_ms: Int) -> Option<Int>
  /// A connection to exactly `to`, no name looked up, with `options` set before it connects.
  write connect_to[s](to: SocketAddress, options: List<SocketOption>, timeout_ms: Int) -> Result<Int, Refusal>
  /// A connection to the Unix socket at `path` under the root `--fs` binds as `root`.
  write connect_unix[s](root: String, path: String, timeout_ms: Int) -> Result<Int, Refusal>
  /// The TLS handshake, completed now rather than when a request needs it, answering what it took in
  /// microseconds. `None` for a connection with no handshake to complete: a plaintext one, or one
  /// whose handshake failed, which ends it. A session that already handshook answers what took it.
  write handshake[s](conn: Int) -> Option<Int>
  /// Secures an open plaintext connection as its client: the handshake completes within
  /// `timeout_ms`, verifying the server as `name` the way `connect_tls` does, and `conn` is the
  /// secured connection afterwards. `alpn` is the application protocols to offer, none when empty.
  /// `unread` is the plaintext the caller read and has not consumed: it must be empty, and it or
  /// anything the socket still holds is `Injected`. An `Err` ends the connection.
  write start_tls[s](conn: Int, name: String, alpn: List<String>, unread: Bytes, timeout_ms: Int) -> Result<Secured, Refusal>
  /// The server's half of `start_tls`, with the credential `--tls` names `credential`; one the run
  /// lacks is `E0429`. `alpn` is the protocols to accept; empty agrees on none and refuses no
  /// client. `unread` is what the caller read past the request to upgrade, and must be empty.
  write serve_tls[s](conn: Int, credential: String, alpn: List<String>, unread: Bytes, timeout_ms: Int) -> Result<Secured, Refusal>
  /// The next connection a listener takes, waiting for one; `0` once the run has stopped accepting.
  write accept[s](listener: Int) -> Int
  /// At most `max` bytes, as soon as any arrive; a shorter answer is not the end of what the peer
  /// sends.
  write recv[s](conn: Int, max: Int, timeout_ms: Int) -> Option<Bytes>
  /// Writes some prefix of `payload` and answers how many bytes it took, which may be fewer than
  /// given; `send_all` loops.
  write send[s](conn: Int, payload: Bytes, timeout_ms: Int) -> Option<Int>
  /// Ends this end's sending, which the peer reads as the end of the stream, and leaves reading
  /// open. A later `send` answers `Some(0)`.
  write close_write[s](conn: Int) -> Unit
  /// Closes a listener or a connection.
  write close[s](socket: Int) -> Unit
  /// Sets one option of a listener or a connection.
  write set_option[s](socket: Int, option: SocketOption) -> Result<Unit, Refusal>
  /// The port this end of a socket is bound to: for a listener asked for port 0, the one it was
  /// given. `None` for a listener the drain has closed.
  read local_port[s](socket: Int) -> Option<Int>
  /// The address this end of a socket is bound to; `None` for a Unix socket, and for a listener
  /// the drain has closed.
  read local_address[s](socket: Int) -> Option<SocketAddress>
  /// The address of a connection's far end as the socket has it, which behind a proxy is the
  /// proxy's. `None` for a listener and for a Unix socket.
  read peer_address[s](conn: Int) -> Option<SocketAddress>
  /// Who holds the far end of a Unix socket; `None` for any other, and where the platform does
  /// not say.
  read peer_credentials[s](conn: Int) -> Option<PeerCredentials>
  /// The far end's end-entity certificate (DER) on a secured connection once its handshake has
  /// completed: the server's to a client, which is what RFC 5929's `tls-server-end-point`
  /// channel binding hashes, and the client's to a server where it presented one the run verified
  /// against `--trust`, which is who the client is. `None` for any other connection.
  read peer_certificate[s](conn: Int) -> Option<Bytes>
  /// The application protocol a secured connection's handshake agreed (ALPN) once it has
  /// completed: on a connection `listen_tls` accepted or `connect_tls` opened, which offer
  /// `http/1.1` alone, that or none; on one `start_tls` or `serve_tls` secured, what they
  /// answered. `None` for a plaintext connection, and where the ends agreed on none.
  read protocol[s](conn: Int) -> Option<String>
  /// Each option the socket has, as it stands now.
  read options[s](socket: Int) -> List<SocketOption>
  /// Writes `before`, then `secret` in `encoding`, then `after`, every byte or `false`, framed as
  /// `std.fs`'s `write_secret` frames a file: what puts a credential on a connection, as SASL's
  /// PLAIN puts `\0user\0password` in base64 between `AUTH PLAIN ` and a line end, without it ever
  /// being a plain value. An encoding `write_secret` does not name is a runtime error, and so is a
  /// write of nothing at all. `false` is a deadline, a peer gone or this end's sending ended before
  /// every byte went, and nothing says how many did.
  write send_secret[s](conn: Int, before: Bytes, secret: Secret<Bytes>, encoding: String, after: Bytes, timeout_ms: Int) -> Bool
}

/// What a socket refuses.
pub effect socket {
  /// A connection did not open, or an upgrade did not complete.
  raise refused(why: Refusal)
}

/// A refusal as a sentence.
pub fn refusal_message(why: Refusal) -> String =
  match why {
    Refused -> "nothing is listening there",
    Unreachable -> "no route leads there",
    TimedOut -> "the deadline passed first",
    Reset -> "the peer ended the connection",
    NameNotFound -> "the name has no address",
    AddressInUse -> "the address is already bound",
    PermissionDenied -> "this run may not do that",
    Injected -> "plaintext was waiting where a TLS handshake was to begin",
    Untrusted -> "the peer's certificate is not trusted for that name",
    Handshake(reason) -> reason,
    Other(code, text) -> text ++ " (" ++ code.to_string() ++ ")",
  }

/// Reads until the peer is done sending (an empty answer); a `recv` shorter than `max` is not the end.
pub fn drain<[l]>(c: Int, so_far: Bytes, timeout_ms: Int) -> Bytes / {net.recv[l], diverges} =
  match net.recv[l](c, 4096, timeout_ms) {
    None -> so_far,
    Some(chunk) -> if chunk.len() == 0 { so_far }
    else { drain[l](c, so_far.concat(chunk), timeout_ms) },
  }

/// Sends every byte, looping over partial writes; `false` when the peer stops taking them.
pub fn send_all<[l]>(c: Int, payload: Bytes, timeout_ms: Int) -> Bool / {net.send[l], abort.raise} =
  send_from[l](c, payload, 0, timeout_ms, max_writes())

/// The most `net.send` calls one `send_all` makes.
fn max_writes() -> Int = 4096

fn send_from<[l]>(
  c: Int,
  payload: Bytes,
  at: Int,
  timeout_ms: Int,
  left: Int,
) -> Bool / {net.send[l], abort.raise} =
  if at >= payload.len() { true }
  else if left <= 0 { false } else {
    match net.send[l](
        c,
        if at == 0 { payload } else { payload.slice(at, payload.len()) },
        timeout_ms,
      ) {
      None -> false,
      Some(n) -> if n <= 0 { false }
      else { send_from[l](c, payload, at + n, timeout_ms, left - 1) },
    }
  }

/// A connection to exactly `to`, raising why there is none.
pub fn dial_address<[l]>(
  to: SocketAddress,
  options: List<SocketOption>,
  timeout_ms: Int,
) -> Int / {net.connect_to[l], socket.refused} =
  match net.connect_to[l](to, options, timeout_ms) { Ok(c) -> c, Err(why) -> socket.refused(why) }

/// A connection to `name` at `port`: its addresses looked up through `dns`, ordered by
/// `dns::interleave`, and tried one at a time until one connects. `timeout_ms` is one deadline on
/// the clock for all of it, the lookup and every attempt, held to the deadline already around
/// this call where that is earlier; each attempt is given an even share of what is left, so an
/// address that does not answer costs its share and not the rest. A name with no address raises
/// `NameNotFound`, a name that is not ASCII raises `Other`, and a name none of whose addresses
/// connects raises what the last one was refused with.
pub fn dial<[l]>(
  name: String,
  port: Int,
  options: List<SocketOption>,
  timeout_ms: Int,
) -> Int / {dns.lookup, net.connect_to[l], socket.refused, task.write, clock.read, clock.write, task::deadline.at, abort.raise} =
  dialled[l](name, port, options, ending("dial", timeout_ms))

/// The instant `timeout_ms` from now, or the deadline around this call where that is earlier.
fn ending(
  function: String,
  timeout_ms: Int,
) -> Instant / {clock.read, task::deadline.at, abort.raise} =
  if timeout_ms <= 0 {
    panic(
      "`net::" ++ function ++ "` was given a timeout of " ++ timeout_ms.to_string()
        ++ " milliseconds",
    )
  } else {
    let own = after(clock.now(), millis(timeout_ms));
    match task::earliest(Some(own), task::deadline.at()) { Some(earlier) -> earlier, None -> own }
  }

/// The `timeout_ms` of an operation that must end by `end`: the whole milliseconds left before it,
/// `None` where there is none.
pub fn ms_left(end: Instant) -> Option<Int> / {clock.read} = {
  let left = as_millis(between(clock.now(), end));
  if left > 0 { Some(left) } else { None }
}

/// `dial` by the instant `end`.
fn dialled<[l]>(
  name: String,
  port: Int,
  options: List<SocketOption>,
  end: Instant,
) -> Int / {dns.lookup, net.connect_to[l], socket.refused, task.write, clock.read, clock.write, task::deadline.at} =
  match dns::resolve(name, between(clock.now(), end)) {
    Ok(found) -> reached[l](dns::interleave(dns::addresses(found)), port, options, end),
    Err(dns::TimedOut) -> socket.refused(TimedOut),
    Err(dns::Other(code, text)) -> socket.refused(Other(code, text)),
    Err(_) -> socket.refused(NameNotFound),
  }

fn reached<[l]>(
  addresses: List<Ip>,
  port: Int,
  options: List<SocketOption>,
  end: Instant,
) -> Int / {net.connect_to[l], socket.refused, clock.read} =
  match addresses {
    [] -> socket.refused(NameNotFound),
    [address, ..rest] -> match ip::socket_address(address, port) {
      None -> socket.refused(Other(0, "a port is 0 to 65535")),
      Some(to) -> match ms_left(end) {
        None -> socket.refused(TimedOut),
        Some(left) -> match net.connect_to[l](to, options, max(left / addresses.len(), 1)) {
          Ok(c) -> c,
          Err(why) -> if rest.len() == 0 { socket.refused(why) }
          else { reached[l](rest, port, options, end) },
        },
      },
    },
  }

/// `conn` secured as its client, raising why it is not: `net.start_tls`, with its rules.
pub fn secure<[l]>(
  conn: Int,
  name: String,
  alpn: List<String>,
  unread: Bytes,
  timeout_ms: Int,
) -> Secured / {net.start_tls[l], socket.refused} =
  match net.start_tls[l](conn, name, alpn, unread, timeout_ms) {
    Ok(secured) -> secured,
    Err(why) -> socket.refused(why),
  }

/// `conn` secured as its server, raising why it is not: `net.serve_tls`, with its rules.
pub fn secure_accepted<[l]>(
  conn: Int,
  credential: String,
  alpn: List<String>,
  unread: Bytes,
  timeout_ms: Int,
) -> Secured / {net.serve_tls[l], socket.refused} =
  match net.serve_tls[l](conn, credential, alpn, unread, timeout_ms) {
    Ok(secured) -> secured,
    Err(why) -> socket.refused(why),
  }

/// A TLS connection to `name` at `port`, dialled as `dial` dials and then secured as `name`,
/// offering `alpn`, the handshake under the same deadline as the dial. The handshake is complete
/// when this answers; a connection that does not secure is closed before its refusal is raised.
pub fn dial_tls<[l]>(
  name: String,
  port: Int,
  alpn: List<String>,
  options: List<SocketOption>,
  timeout_ms: Int,
) -> Int / {dns.lookup, net.connect_to[l], net.start_tls[l], net.close[l], socket.refused, task.write, clock.read, clock.write, task::deadline.at, abort.raise} = {
  let end = ending("dial_tls", timeout_ms);
  let c = dialled[l](name, port, options, end);
  let secured = match ms_left(end) {
    None -> Err(TimedOut),
    Some(left) -> net.start_tls[l](c, name, alpn, b"", left),
  };
  match secured {
    Ok(_) -> c,
    Err(why) -> {
      net.close[l](c);
      socket.refused(why)
    },
  }
}

/// A listener at `at`, raising why there is none.
pub fn listening<[l]>(
  at: SocketAddress,
  options: List<SocketOption>,
) -> Int / {net.listen_on[l], socket.refused} =
  match net.listen_on[l](at, options) { Ok(s) -> s, Err(why) -> socket.refused(why) }

/// A listener on the Unix socket at `path` under `root`, raising why there is none.
pub fn listening_unix<[l]>(
  root: String,
  path: String,
) -> Int / {net.listen_unix[l], socket.refused} =
  match net.listen_unix[l](root, path) { Ok(s) -> s, Err(why) -> socket.refused(why) }

/// A connection to the Unix socket at `path` under `root`, raising why there is none.
pub fn dial_unix<[l]>(
  root: String,
  path: String,
  timeout_ms: Int,
) -> Int / {net.connect_unix[l], socket.refused} =
  match net.connect_unix[l](root, path, timeout_ms) { Ok(c) -> c, Err(why) -> socket.refused(why) }

/// A connection as a source: each pull is one `recv` within `timeout_ms`, the end is the peer done
/// sending, and a deadline raises `TimedOut`. Its `close` closes the connection, so the hold of
/// the source is the hold of the connection.
pub fn reading<[l]>(
  conn: Int,
  timeout_ms: Int,
) -> Source<| {net.recv[l], net.close[l], socket.refused}> =
  {
    pull: |size: Int|
      match net.recv[l](conn, size, timeout_ms) {
        Some(bytes) -> bytes,
        None -> socket.refused(TimedOut),
      },
    close: || net.close[l](conn),
  }

/// A connection as a sink: a push sends all it is given, each write within `timeout_ms`. Its
/// `close` ends this end's sending and leaves the connection open to be read, so it is held
/// inside the hold of the connection's source.
pub fn writing<[l]>(
  conn: Int,
  timeout_ms: Int,
) -> Sink<| {net.send[l], net.close_write[l], abort.raise}> =
  {
    push: |bytes: Bytes| bytes.len() == 0 || send_all[l](conn, bytes, timeout_ms),
    close: || net.close_write[l](conn),
  }

// --- The twin ---------------------------------------------------------------

/// What the far end of a scripted connection does next.
pub type Step =
  /// It sends these bytes.
  | Says(Bytes)
  /// It waits until it has heard exactly these bytes, in order, after what it heard before. A
  /// program that sends anything else fails where it sends it.
  | Hears(Bytes)
  /// It waits until this end has ended its sending.
  | HearsEnd
  /// It waits until it has heard exactly these bytes, written whole by one `send_secret`: a
  /// credential in its frame, as `sent_secret` makes it, which the far end knows as a server
  /// knows a password. A program that sends anything else here, or these bytes any other way,
  /// fails where it sends it, and nothing says how what it sent differs.
  | HearsSecret(Bytes)
  /// It does its half of a TLS handshake here, and what follows is read only once secured.
  | Upgrades
  /// It fails a TLS handshake here with this refusal.
  | Refuses(Refusal)
  /// It sends nothing before one deadline passes.
  | Stalls
  /// It sends nothing more and stays: every read from here on is a deadline.
  | Silent
  /// It sends these bytes again at every read, without end: a peer that never finishes.
  | Repeats(Bytes)
  /// It takes nothing before one deadline passes: one `send` answers `None`.
  | Blocks
  /// It goes away: what it sent is at its end, and nothing sent to it after is taken.
  | Leaves

/// What a connection to an address the twin was told of finds: a peer that answers each
/// connection with the next of its scripts, or a refusal.
pub type Reach = | Serving(List<List<Step>>) | Failing(Refusal)

/// A client the twin's `accept` hands out: where it calls from, what it does, for a Unix socket who
/// it is, and the certificate (DER) it presents once its connection is secured.
pub type Caller = {
  from: Option<SocketAddress>,
  script: List<Step>,
  credentials: Option<PeerCredentials>,
  certificate: Option<Bytes>,
}

/// A listener a twin holds: where it is bound (an address or a Unix path), the credential it
/// serves TLS with, and the program's own connections waiting to be accepted.
pub type MemListener = {
  label: String,
  at: Option<SocketAddress>,
  key: String,
  tls: Option<String>,
  waiting: List<Int>,
  options: List<SocketOption>,
}

/// A connection a twin holds. `script` is what the far end does next; `fed` says the far end may
/// send more than the script holds, which is so while it is the program's own and open; `gone`
/// says it will take nothing more. `sent` is everything this end sent but credentials, which
/// `sealed` holds as `send_secret` framed them; `unheard` is what no `Hears` has matched yet,
/// and `deadlines` the deadline each read was given, in order.
pub type MemConn = {
  label: Option<String>,
  local: Option<SocketAddress>,
  peer: Option<SocketAddress>,
  script: List<Step>,
  joined: Option<Int>,
  fed: Bool,
  gone: Bool,
  ended: Bool,
  sent: Bytes,
  sealed: List<Secret<Bytes>>,
  unheard: Bytes,
  deadlines: List<Int>,
  secured: Option<String>,
  /// The application protocol the connection's handshake agreed, where it agreed one.
  agreed: Option<String>,
  options: List<SocketOption>,
  credentials: Option<PeerCredentials>,
  /// `accept` handed the connection out, and the certificate its client presents, where it does.
  accepted: Bool,
  presented: Option<Bytes>,
}

/// One network, as a value. `short` is the most bytes one `recv` or `send` moves, zero for as
/// many as it is asked; `closed` is each handle `close` let go, in order.
pub type MemNet = {
  next: Int,
  port: Int,
  listeners: Map<Int, MemListener>,
  conns: Map<Int, MemConn>,
  reaches: Map<String, Reach>,
  callers: List<Caller>,
  names: dns::Table,
  credentials: List<String>,
  /// The certificate (DER) a far end secured under each name presents.
  leaves: Map<String, Bytes>,
  short: Int,
  closed: List<Int>,
}

/// An operation's two answers: the network it left, and what the host would have answered.
pub type Stepped<a> = { net: MemNet, answer: a }

/// A network nothing listens on, that knows no name.
pub fn mem_empty() -> MemNet =
  {
    next: 1,
    port: 49152,
    listeners: Map::new(),
    conns: Map::new(),
    reaches: Map::new(),
    callers: [],
    names: dns::table(),
    credentials: [],
    leaves: Map::new(),
    short: 0,
    closed: [],
  }

/// The network with a far end secured as `name` presenting the certificate `der`, and with a
/// connection `Presenting(name)` presenting it to the program's own listener.
pub fn mem_presenting(n: MemNet, name: String, der: Bytes) -> MemNet =
  { ..n, leaves: n.leaves.insert(name, der) }

/// The network with a peer at `at` that answers each connection with the next of `scripts`, and
/// refuses one more than it has scripts for.
pub fn mem_serving(n: MemNet, at: SocketAddress, scripts: List<List<Step>>) -> MemNet =
  { ..n, reaches: n.reaches.insert(ip::render_socket(at), Serving(scripts)) }

/// The network with every connection to `at` refused with `why`.
pub fn mem_failing(n: MemNet, at: SocketAddress, why: Refusal) -> MemNet =
  { ..n, reaches: n.reaches.insert(ip::render_socket(at), Failing(why)) }

/// The network with a peer on the Unix socket at `path` under `root`.
pub fn mem_serving_unix(
  n: MemNet,
  root: String,
  path: String,
  scripts: List<List<Step>>,
) -> MemNet = { ..n, reaches: n.reaches.insert(unix_key(root, path), Serving(scripts)) }

/// The network with one more client for `accept` to hand out, calling from `from` and doing
/// `script`.
pub fn mem_calling(n: MemNet, from: SocketAddress, script: List<Step>) -> MemNet =
  {
    ..n,
    callers: n.callers.push({
      from: Some(from),
      script: script,
      credentials: None,
      certificate: None,
    }),
  }

/// `mem_calling`, for a client that presents the certificate `der` once its connection is
/// secured: what a server's `net.peer_certificate` then answers.
pub fn mem_calling_presenting(
  n: MemNet,
  from: SocketAddress,
  der: Bytes,
  script: List<Step>,
) -> MemNet =
  {
    ..n,
    callers: n.callers.push({
      from: Some(from),
      script: script,
      credentials: None,
      certificate: Some(der),
    }),
  }

/// The network with one more client for `accept` to hand out over a Unix socket, held by `who`.
pub fn mem_calling_unix(n: MemNet, who: PeerCredentials, script: List<Step>) -> MemNet =
  {
    ..n,
    callers: n.callers.push({
      from: None,
      script: script,
      credentials: Some(who),
      certificate: None,
    }),
  }

/// The network resolving names by `names`, which `connect`, `connect_tls` and, under `on_mem`,
/// `dns` are answered from.
pub fn mem_resolving(n: MemNet, names: dns::Table) -> MemNet = { ..n, names: names }

/// The network holding a TLS credential named `name`, as `--tls` would give the run.
pub fn mem_credential(n: MemNet, name: String) -> MemNet =
  { ..n, credentials: n.credentials.push(name) }

/// The network moving at most `most` bytes in each `recv` and `send` from here on, and as many
/// as it is asked when `most` is zero: the short reads and partial writes a socket gives.
pub fn mem_short(n: MemNet, most: Int) -> MemNet = { ..n, short: most }

/// Everything the program sent on `conn` but credentials, whether or not it is still open.
pub fn mem_sent(n: MemNet, conn: Int) -> Bytes =
  match n.conns.get(conn) { Some(c) -> c.sent, None -> b"" }

/// Each credential the program sent on `conn` by `send_secret`, in its frame and in order, sealed:
/// what a test compares whole with the one it expects.
pub fn mem_sent_secrets(n: MemNet, conn: Int) -> List<Secret<Bytes>> =
  match n.conns.get(conn) { Some(c) -> c.sealed, None -> [] }

/// What `conn`'s far end has yet to do: empty when the program played its script out.
pub fn mem_unmet(n: MemNet, conn: Int) -> List<Step> =
  match n.conns.get(conn) { Some(c) -> c.script, None -> [] }

/// The deadline each read of `conn` was given, in milliseconds and in order: what a test of a
/// timeout sums.
pub fn mem_deadlines(n: MemNet, conn: Int) -> List<Int> =
  match n.conns.get(conn) { Some(c) -> c.deadlines, None -> [] }

/// The name or credential `conn` was secured as, or `None` for plaintext.
pub fn mem_secured(n: MemNet, conn: Int) -> Option<String> =
  match n.conns.get(conn) { Some(c) -> c.secured, None -> None }

fn unix_key(root: String, path: String) -> String = "unix:" ++ root ++ "/" ++ path

fn deadline(operation: String, timeout_ms: Int) -> Unit / {abort.raise} =
  if timeout_ms <= 0 {
    panic(
      "`net." ++ operation ++ "` was given a timeout of " ++ timeout_ms.to_string()
        ++ " milliseconds",
    )
  } else { () }

/// `max`, refused where a read asks for no bytes: an empty answer is the peer done sending, so a
/// read of none would answer as the end of the stream does.
fn asked_for(max: Int) -> Int / {abort.raise} =
  if max <= 0 { panic("`net.recv` was asked for " ++ max.to_string() ++ " bytes") } else { max }

/// Refuses a write of nothing, which would answer as a peer gone does.
fn something_to(operation: String, empty: Bool) -> Unit / {abort.raise} =
  if empty { panic("`net." ++ operation ++ "` was given an empty payload") } else { () }

/// Whether a run may listen at `at`: a listener the rest of a network can reach is not a run's to
/// open.
fn listenable(at: SocketAddress) -> Bool = ip::is_loopback(ip::socket_ip(at))

/// `option`, refused where it sets a size or a wait below zero.
fn option_checked(option: SocketOption) -> SocketOption / {abort.raise} = {
  let sized = |bytes: Int|
    if bytes < 0 { panic("a socket buffer was sized at " ++ bytes.to_string() ++ " bytes") }
    else { () };
  let waited = |d: Duration|
    if as_nanos(d) < 0 {
      panic("a socket was given a duration of " ++ as_nanos(d).to_string() ++ " nanoseconds")
    } else { () };
  match option {
    SendBuffer(bytes) -> sized(bytes),
    ReceiveBuffer(bytes) -> sized(bytes),
    Linger(Some(d)) -> waited(d),
    KeepAlive(Some(p)) -> {
      waited(p.idle);
      match p.interval { Some(d) -> waited(d), None -> () };
      match p.count {
        Some(n) -> if n < 0 || n > 4294967295 {
          panic("a socket was given a probe count of " ++ n.to_string())
        } else { () },
        None -> (),
      }
    },
    _ -> (),
  };
  option
}

fn no_socket<a>(id: Int) -> a / {abort.raise} =
  panic("there is no open socket with handle " ++ id.to_string())

/// The label a socket is used under, held to the one it was first used under as the host holds it.
fn claimed(id: Int, held: Option<String>, label: String) -> Option<String> / {abort.raise} =
  match held {
    None -> Some(label),
    Some(first) -> if first == label { held } else {
      panic(
        "socket " ++ id.to_string() ++ " is being used as `net[" ++ label ++ "]` and `net[" ++ first
          ++ "]`",
      )
    },
  }

/// A closed connection is kept for what it sent, and names nothing an operation may use.
fn conn_of(n: MemNet, label: String, id: Int) -> MemConn / {abort.raise} =
  match n.conns.get(id) {
    Some(c) -> if n.closed.contains(id) { no_socket(id) }
    else { { ..c, label: claimed(id, c.label, label) } },
    None -> if n.listeners.contains(id) {
      panic("socket " ++ id.to_string() ++ " is a listener, and this operation wants a connection")
    } else { no_socket(id) },
  }

fn listener_of(n: MemNet, label: String, id: Int) -> MemListener / {abort.raise} =
  match n.listeners.get(id) {
    Some(l) -> {
      let _held = claimed(id, Some(l.label), label);
      l
    },
    None -> if n.conns.contains(id) {
      panic("socket " ++ id.to_string() ++ " is a connection, and `net.accept` wants a listener")
    } else { no_socket(id) },
  }

fn with_conn(n: MemNet, id: Int, c: MemConn) -> MemNet = { ..n, conns: n.conns.insert(id, c) }

/// The connection with every step at the head of its script that has been met taken off: a
/// `Hears` the program has sent all of, a `HearsEnd` after it ended its sending, a `Says` of
/// nothing, and a `Leaves`, which ends the script. A `Hears` the program has sent something else
/// for fails here, and so does a `HearsSecret` it has sent plain bytes for.
fn listened(c: MemConn) -> MemConn / {abort.raise} =
  match c.script {
    [Says(bytes), ..rest] -> if bytes.len() == 0 { listened({ ..c, script: rest }) } else { c },
    [HearsEnd, ..rest] -> if c.ended { listened({ ..c, script: rest }) } else { c },
    [HearsSecret(_), ..] -> if c.unheard.len() == 0 { c } else {
      panic(
        "the peer was to hear a credential and the program sent \""
          ++ String::of_bytes_lossy(c.unheard)
          ++ "\"",
      )
    },
    [Leaves, ..] -> { ..c, script: [], fed: false, gone: true },
    [Hears(expected), ..rest] -> {
      let wanted = expected.len();
      if c.unheard.starts_with(expected) {
        listened({ ..c, script: rest, unheard: c.unheard.slice(wanted, c.unheard.len()) })
      } else if expected.starts_with(c.unheard) { c } else {
        panic(
          "the peer was to hear \"" ++ String::of_bytes_lossy(expected)
            ++ "\" and the program sent \""
            ++ String::of_bytes_lossy(c.unheard)
            ++ "\"",
        )
      }
    },
    _ -> c,
  }

fn new_conn(
  local: Option<SocketAddress>,
  peer: Option<SocketAddress>,
  script: List<Step>,
) -> MemConn =
  {
    label: None,
    local: local,
    peer: peer,
    script: script,
    joined: None,
    fed: false,
    gone: false,
    ended: false,
    sent: b"",
    sealed: [],
    unheard: b"",
    deadlines: [],
    secured: None,
    agreed: None,
    options: [NoDelay(true)],
    credentials: None,
    accepted: false,
    presented: None,
  }

/// The listener bound at `key`, if the program holds one there.
fn bound_at(n: MemNet, key: String) -> Option<Int> =
  n.listeners.fold(None, |found: Option<Int>, id: Int, l: MemListener|
    if l.key == key { Some(id) } else { found })

/// The network with a listener bound at `key`, a port asked for as `0` assigned.
fn bind(
  n: MemNet,
  label: String,
  address: Ip,
  port: Int,
  tls: Option<String>,
  options: List<SocketOption>,
) -> Stepped<Result<Int, Refusal>> / {abort.raise} = {
  let assigned = if port == 0 { n.port } else { port };
  let at = ip::socket_at(address, assigned);
  let key = ip::render_socket(at);
  if bound_at(n, key) != None || n.reaches.contains(key) { { net: n, answer: Err(AddressInUse) } }
  else {
    let l: MemListener = {
      label: label,
      at: Some(at),
      key: key,
      tls: tls,
      waiting: [],
      options: options.fold([ReuseAddress(true)], with_option),
    };
    {
      net: {
        ..n,
        next: n.next + 1,
        port: if port == 0 { n.port + 1 } else { n.port },
        listeners: n.listeners.insert(n.next, l),
      },
      answer: Ok(n.next),
    }
  }
}

fn port_checked(operation: String, port: Int) -> Int / {abort.raise} =
  if port < 0 || port > 65535 {
    panic(
      "`net." ++ operation ++ "` was given port " ++ port.to_string()
        ++ ", which is not a TCP port",
    )
  } else { port }

/// What `net.listen` answers over the network. A port already bound fails as the host's bind
/// does.
pub fn mem_listen(n: MemNet, label: String, port: Int) -> Stepped<Int> / {abort.raise} = {
  let bound = bind(n, label, ip::loopback_v4(), port_checked("listen", port), None, []);
  match bound.answer {
    Ok(id) -> { net: bound.net, answer: id },
    Err(_) ->
      panic("`net.listen` could not bind 127.0.0.1:" ++ port.to_string() ++ ": address in use"),
  }
}

/// What `net.listen_tls` answers over the network, which holds the credentials `mem_credential`
/// gave it.
pub fn mem_listen_tls(
  n: MemNet,
  label: String,
  port: Int,
  credential: String,
) -> Stepped<Int> / {abort.raise} = {
  let held = credentialed(n, credential);
  let bound = bind(n, label, ip::loopback_v4(), port_checked("listen_tls", port), Some(held), []);
  match bound.answer {
    Ok(id) -> { net: bound.net, answer: id },
    Err(_) ->
      panic("`net.listen_tls` could not bind 127.0.0.1:" ++ port.to_string() ++ ": address in use"),
  }
}

fn credentialed(n: MemNet, credential: String) -> String / {abort.raise} =
  if n.credentials.filter(|held: String| held == credential).len() > 0 { credential }
  else { panic("no TLS credential named `" ++ credential ++ "` was configured for this run") }

/// What `net.listen_on` answers over the network.
pub fn mem_listen_on(
  n: MemNet,
  label: String,
  at: SocketAddress,
  options: List<SocketOption>,
) -> Stepped<Result<Int, Refusal>> / {abort.raise} =
  if !listenable(at) { { net: n, answer: Err(PermissionDenied) } }
  else { bind(n, label, ip::socket_ip(at), ip::socket_port(at), None, options.map(option_checked)) }

/// What `net.listen_unix` answers over the network, which keeps the path bound until the
/// listener closes.
pub fn mem_listen_unix(
  n: MemNet,
  label: String,
  root: String,
  path: String,
) -> Stepped<Result<Int, Refusal>> = {
  let key = unix_key(root, path);
  if bound_at(n, key) != None || n.reaches.contains(key) { { net: n, answer: Err(AddressInUse) } }
  else {
    let l: MemListener = { label: label, at: None, key: key, tls: None, waiting: [], options: [] };
    { net: { ..n, next: n.next + 1, listeners: n.listeners.insert(n.next, l) }, answer: Ok(n.next) }
  }
}

/// A connection opened to `key`: joined to the program's own listener there, or answered by the
/// next script of the peer the network was told of, or refused.
fn opened(
  n: MemNet,
  label: String,
  to: Option<SocketAddress>,
  key: String,
  options: List<SocketOption>,
) -> Stepped<Result<Int, Refusal>> / {abort.raise} = {
  let local = match to {
    Some(at) -> Some(ip::socket_at(ip::loopback_like(ip::socket_ip(at)), n.port)),
    None -> None,
  };
  let fresh = new_conn(local, to, []);
  let mine = { ..fresh, label: Some(label), options: options.fold(fresh.options, with_option) };
  let after = { ..n, port: if local == None { n.port } else { n.port + 1 } };
  match bound_at(n, key) {
    Some(listener) -> {
      let l = match n.listeners.get(listener) { Some(l) -> l, None -> no_socket(listener) };
      let accepted = new_conn(l.at, local, []);
      let theirs = {
        ..accepted,
        joined: Some(n.next),
        fed: true,
        secured: l.tls,
        accepted: true,
        presented: presented_by(n, options),
      };
      {
        net: {
          ..after,
          next: n.next + 2,
          conns: n.conns.insert(n.next, { ..mine, joined: Some(n.next + 1), fed: true }).insert(
            n.next + 1,
            theirs,
          ),
          listeners: n.listeners.insert(listener, { ..l, waiting: l.waiting.push(n.next + 1) }),
        },
        answer: Ok(n.next),
      }
    },
    None -> match n.reaches.get(key) {
      Some(Serving([script, ..rest])) ->
        {
          net: {
            ..after,
            next: n.next + 1,
            conns: n.conns.insert(n.next, { ..mine, script: script }),
            reaches: n.reaches.insert(key, Serving(rest)),
          },
          answer: Ok(n.next),
        },
      Some(Failing(why)) -> { net: n, answer: Err(why) },
      _ -> { net: n, answer: Err(Refused) },
    },
  }
}

/// The certificate a connection opened with `options` presents to the program's own listener.
fn presented_by(n: MemNet, options: List<SocketOption>) -> Option<Bytes> =
  options.fold(None, |was: Option<Bytes>, o: SocketOption|
    match o { Presenting(name) -> n.leaves.get(name), _ -> was })

/// What `net.connect_to` answers over the network.
pub fn mem_connect_to(
  n: MemNet,
  label: String,
  to: SocketAddress,
  options: List<SocketOption>,
  timeout_ms: Int,
) -> Stepped<Result<Int, Refusal>> / {abort.raise} = {
  deadline("connect_to", timeout_ms);
  opened(n, label, Some(to), ip::render_socket(to), options.map(option_checked))
}

/// What `net.connect_unix` answers over the network.
pub fn mem_connect_unix(
  n: MemNet,
  label: String,
  root: String,
  path: String,
  timeout_ms: Int,
) -> Stepped<Result<Int, Refusal>> / {abort.raise} = {
  deadline("connect_unix", timeout_ms);
  opened(n, label, None, unix_key(root, path), [])
}

/// What `net.connect` answers over the network: the name resolved by the network's table and each
/// address tried in the order the table gives it.
pub fn mem_connect(
  n: MemNet,
  label: String,
  host: String,
  port: Int,
  timeout_ms: Int,
) -> Stepped<Option<Int>> / {abort.raise} = {
  deadline("connect", timeout_ms);
  let found = match dns::table_lookup(n.names, host) {
    Ok(found) -> dns::addresses(found),
    Err(_) -> [],
  };
  first_reached(n, label, found, port_checked("connect", port))
}

fn first_reached(
  n: MemNet,
  label: String,
  addresses: List<Ip>,
  port: Int,
) -> Stepped<Option<Int>> / {abort.raise} =
  match addresses {
    [] -> { net: n, answer: None },
    [address, ..rest] -> {
      let to = ip::socket_at(address, port);
      let tried = opened(n, label, Some(to), ip::render_socket(to), []);
      match tried.answer {
        Ok(id) -> { net: tried.net, answer: Some(id) },
        Err(_) -> first_reached(n, label, rest, port),
      }
    },
  }

/// What `net.connect_tls` answers over the network: `mem_connect`, the connection secured as
/// `host`. TLS changes none of the bytes a twin carries.
pub fn mem_connect_tls(
  n: MemNet,
  label: String,
  host: String,
  port: Int,
  timeout_ms: Int,
) -> Stepped<Option<Int>> / {abort.raise} = {
  let reached = mem_connect(n, label, host, port, timeout_ms);
  match reached.answer {
    Some(id) -> match reached.net.conns.get(id) {
      Some(c) ->
        {
          net: with_conn(reached.net, id, { ..c, secured: Some(host), agreed: Some("http/1.1") }),
          answer: Some(id),
        },
      None -> reached,
    },
    None -> reached,
  }
}

/// What `net.accept` answers over the network: the program's own connection waiting on the
/// listener, else the next client the network was told of, else `0`, as a host that has stopped
/// accepting answers.
pub fn mem_accept(n: MemNet, label: String, listener: Int) -> Stepped<Int> / {abort.raise} = {
  let l = listener_of(n, label, listener);
  match l.waiting {
    [id, ..rest] ->
      { net: { ..n, listeners: n.listeners.insert(listener, { ..l, waiting: rest }) }, answer: id },
    [] -> match n.callers {
      [] -> { net: n, answer: 0 },
      [caller, ..rest] -> {
        let fresh = new_conn(l.at, caller.from, caller.script);
        let c = {
          ..fresh,
          secured: l.tls,
          credentials: caller.credentials,
          accepted: true,
          presented: caller.certificate,
        };
        {
          net: { ..n, next: n.next + 1, callers: rest, conns: n.conns.insert(n.next, c) },
          answer: n.next,
        }
      },
    },
  }
}

/// What `net.recv` answers over the network. A read with nothing to answer is a deadline:
/// the far end is waiting for this one, has stalled, or is the program's own and has not sent.
pub fn mem_recv(
  n: MemNet,
  label: String,
  conn: Int,
  max: Int,
  timeout_ms: Int,
) -> Stepped<Option<Bytes>> / {abort.raise} = {
  deadline("recv", timeout_ms);
  let wanted = asked_for(max);
  let asked = listened(conn_of(n, label, conn));
  let c = { ..asked, deadlines: asked.deadlines.push(timeout_ms) };
  let most = if n.short > 0 { min(wanted, n.short) } else { wanted };
  match c.script {
    [] -> { net: with_conn(n, conn, c), answer: if c.fed { None } else { Some(b"") } },
    [Says(bytes), ..rest] -> if bytes.len() > most {
      let left = bytes.slice(most, bytes.len());
      {
        net: with_conn(n, conn, { ..c, script: [Says(left)].concat(rest) }),
        answer: Some(bytes.slice(0, most)),
      }
    } else { { net: with_conn(n, conn, { ..c, script: rest }), answer: Some(bytes) } },
    [Repeats(bytes), ..] ->
      { net: with_conn(n, conn, c), answer: Some(bytes.slice(0, min(most, bytes.len()))) },
    [Stalls, ..rest] -> { net: with_conn(n, conn, { ..c, script: rest }), answer: None },
    _ -> { net: with_conn(n, conn, c), answer: None },
  }
}

/// What `net.send` answers over the network: the bytes are the far end's to hear, and where it
/// is the program's own, to read.
pub fn mem_send(
  n: MemNet,
  label: String,
  conn: Int,
  payload: Bytes,
  timeout_ms: Int,
) -> Stepped<Option<Int>> / {abort.raise} = {
  deadline("send", timeout_ms);
  something_to("send", payload.len() == 0);
  let c = listened(conn_of(n, label, conn));
  if c.ended || c.gone { { net: with_conn(n, conn, c), answer: Some(0) } } else {
    match c.script {
      [Blocks, ..rest] -> { net: with_conn(n, conn, { ..c, script: rest }), answer: None },
      _ -> {
        let size = if n.short > 0 { min(payload.len(), n.short) } else { payload.len() };
        let part = payload.slice(0, size);
        let mine = listened({ ..c, sent: c.sent.concat(part), unheard: c.unheard.concat(part) });
        { net: passed_on(with_conn(n, conn, mine), c.joined, part), answer: Some(size) }
      },
    }
  }
}

/// The bytes `send_secret` puts on a connection, sealed: what a peer reads, and what the twin and
/// any other handler of `send_secret` keeps in their place, since nothing in Ply opens them.
/// Raises, in the host's words, for an encoding `send_secret` does not write.
pub fn sent_secret(
  before: Bytes,
  secret: Secret<Bytes>,
  encoding: String,
  after: Bytes,
) -> Secret<Bytes> / {abort.raise} = {
  let written = if encoding == "raw" { secret } else {
    match try[abort.raise] { Secret::encode(encoding, secret) } {
      Ok(text) -> text.bytes(),
      Err(_) -> panic("`net.send_secret` knows no encoding `" ++ encoding ++ "`"),
    }
  };
  Secret::of_bytes(before).concat(written).concat(Secret::of_bytes(after))
}

/// What `net.send_secret` answers over the network: every byte or none, all of it sealed. The far
/// end hears the credential in its frame, whole, as a `HearsSecret` waits for it, and
/// `mem_sent_secrets` keeps it; nothing of it is in `mem_sent`. A credential is not handed to
/// the program's own end, which would read it as plain bytes: a joined connection fails here,
/// where a socket would deliver it.
pub fn mem_send_secret(
  n: MemNet,
  label: String,
  conn: Int,
  before: Bytes,
  secret: Secret<Bytes>,
  encoding: String,
  after: Bytes,
  timeout_ms: Int,
) -> Stepped<Bool> / {abort.raise} = {
  deadline("send_secret", timeout_ms);
  let framed = sent_secret(before, secret, encoding, after);
  something_to("send_secret", framed.is_empty());
  let c = listened(conn_of(n, label, conn));
  if c.ended || c.gone { { net: with_conn(n, conn, c), answer: false } } else if c.joined != None {
    panic(
      "the twin cannot hand a credential to the program's own end of socket " ++ conn.to_string()
        ++ ": nothing in Ply opens it",
    )
  } else {
    let kept = { ..c, sealed: c.sealed.push(framed) };
    match c.script {
      [Blocks, ..rest] -> { net: with_conn(n, conn, { ..c, script: rest }), answer: false },
      [Hears(expected), ..] ->
        panic(
          "the peer was to hear \"" ++ String::of_bytes_lossy(expected)
            ++ "\" and the program sent a credential",
        ),
      [HearsSecret(expected), ..rest] -> if Secret::of_bytes(expected) == framed {
        { net: with_conn(n, conn, listened({ ..kept, script: rest })), answer: true }
      } else { panic("the peer was to hear one credential and the program sent another") },
      _ -> { net: with_conn(n, conn, kept), answer: true },
    }
  }
}

/// The network with `bytes` waiting to be read at the other end of a joined connection.
fn passed_on(n: MemNet, other: Option<Int>, bytes: Bytes) -> MemNet =
  match other {
    None -> n,
    Some(id) -> match n.conns.get(id) {
      Some(c) -> with_conn(n, id, { ..c, script: c.script.push(Says(bytes)) }),
      None -> n,
    },
  }

/// The network with the other end of a joined connection told this end sends no more, and, when
/// this end is closed, that it takes no more either.
fn parted(n: MemNet, other: Option<Int>, closed: Bool) -> MemNet =
  match other {
    None -> n,
    Some(id) -> match n.conns.get(id) {
      Some(c) ->
        with_conn(n, id, {
          ..c,
          fed: false,
          gone: c.gone || closed,
          joined: if closed { None } else { c.joined },
        }),
      None -> n,
    },
  }

/// What `net.close_write` does over the network.
pub fn mem_close_write(n: MemNet, label: String, conn: Int) -> Stepped<Unit> / {abort.raise} = {
  let c = conn_of(n, label, conn);
  { net: parted(with_conn(n, conn, listened({ ..c, ended: true })), c.joined, false), answer: () }
}

/// What `net.close` does over the network: the handle names nothing afterwards, a Unix listener's
/// path is free again, and what a connection sent stays readable by `mem_sent`.
pub fn mem_close(n: MemNet, label: String, socket: Int) -> Stepped<Unit> / {abort.raise} =
  match n.conns.get(socket) {
    Some(_) -> {
      let c = conn_of(n, label, socket);
      let kept = with_conn(n, socket, { ..c, gone: true, ended: true, joined: None });
      { net: { ..parted(kept, c.joined, true), closed: n.closed.push(socket) }, answer: () }
    },
    None -> {
      let _l = listener_of(n, label, socket);
      {
        net: { ..n, listeners: n.listeners.remove(socket), closed: n.closed.push(socket) },
        answer: (),
      }
    },
  }

/// An upgrade's rule over the network. Plaintext the caller holds unread, or the far end sent
/// ahead of its handshake, is `Injected`; a far end that does not upgrade here refuses, stalls or
/// is gone; and the program's own far end is secured without a script.
fn upgraded(
  n: MemNet,
  operation: String,
  label: String,
  conn: Int,
  who: String,
  alpn: List<String>,
  unread: Bytes,
  timeout_ms: Int,
) -> Stepped<Result<Secured, Refusal>> / {abort.raise} = {
  deadline(operation, timeout_ms);
  let c = listened(conn_of(n, label, conn));
  let secured = |rest: List<Step>| {
    {
      net: with_conn(n, conn, { ..c, script: rest, secured: Some(who), agreed: alpn.at(0) }),
      answer: Ok({ protocol: alpn.at(0) }),
    }
  };
  let over = |why: Refusal| {
    {
      net: parted(
        with_conn(n, conn, { ..c, script: [], fed: false, gone: true, ended: true, joined: None }),
        c.joined,
        true,
      ),
      answer: Err(why),
    }
  };
  if c.secured != None {
    panic(
      "`net." ++ operation ++ "` cannot secure socket " ++ conn.to_string()
        ++ ": it is already TLS",
    )
  } else if c.local == None && c.peer == None {
    panic(
      "`net." ++ operation ++ "` cannot secure socket " ++ conn.to_string()
        ++ ": it is a Unix socket",
    )
  } else if unread.len() > 0 { over(Injected) } else {
    match c.script {
      [Upgrades, ..rest] -> secured(rest),
      [Says(_), ..] -> over(Injected),
      [Repeats(_), ..] -> over(Injected),
      [Refuses(why), ..] -> over(why),
      [] -> if c.joined != None { secured([]) } else { over(Reset) },
      _ -> over(TimedOut),
    }
  }
}

/// What `net.start_tls` answers over the network.
pub fn mem_start_tls(
  n: MemNet,
  label: String,
  conn: Int,
  name: String,
  alpn: List<String>,
  unread: Bytes,
  timeout_ms: Int,
) -> Stepped<Result<Secured, Refusal>> / {abort.raise} =
  upgraded(n, "start_tls", label, conn, name, alpn, unread, timeout_ms)

/// What `net.serve_tls` answers over the network, which holds the credentials `mem_credential`
/// gave it.
pub fn mem_serve_tls(
  n: MemNet,
  label: String,
  conn: Int,
  credential: String,
  alpn: List<String>,
  unread: Bytes,
  timeout_ms: Int,
) -> Stepped<Result<Secured, Refusal>> / {abort.raise} =
  upgraded(n, "serve_tls", label, conn, credentialed(n, credential), alpn, unread, timeout_ms)

/// What `net.handshake` answers over the network: a secured connection has none left to
/// complete, and a plaintext one has none at all.
pub fn mem_handshake(n: MemNet, label: String, conn: Int) -> Stepped<Option<Int>> / {abort.raise} = {
  let c = conn_of(n, label, conn);
  { net: with_conn(n, conn, c), answer: if c.secured == None { None } else { Some(0) } }
}

/// Which setting an option is, whatever it sets it to.
fn setting(option: SocketOption) -> Int =
  match option {
    NoDelay(_) -> 0,
    KeepAlive(_) -> 1,
    ReuseAddress(_) -> 2,
    ReusePort(_) -> 3,
    SendBuffer(_) -> 4,
    ReceiveBuffer(_) -> 5,
    Linger(_) -> 6,
    Broadcast(_) -> 7,
    MulticastLoop(_) -> 8,
    JoinGroup(_, _) -> 9,
    LeaveGroup(_, _) -> 10,
    Presenting(_) -> 11,
  }

/// `options` with `option` in place of what it held for the same setting: what a twin keeps of
/// the options set on a socket. A group joined or left, or a credential to present, is no setting,
/// and is not kept.
pub fn with_option(options: List<SocketOption>, option: SocketOption) -> List<SocketOption> =
  if setting(option) >= 9 { options }
  else { options.filter(|held: SocketOption| setting(held) != setting(option)).push(option) }

/// What `net.set_option` answers over the network, which keeps each setting and is changed by
/// none: it has no kernel to tune.
pub fn mem_set_option(
  n: MemNet,
  label: String,
  socket: Int,
  asked: SocketOption,
) -> Stepped<Result<Unit, Refusal>> / {abort.raise} = {
  let option = option_checked(asked);
  match n.conns.get(socket) {
    Some(_) -> {
      let c = conn_of(n, label, socket);
      let set = with_conn(n, socket, { ..c, options: with_option(c.options, option) });
      let presenting = match ((c.accepted, c.joined)) {
        (false, Some(peer)) -> match set.conns.get(peer) {
          Some(p) -> with_conn(set, peer, { ..p, presented: presented_by(n, [option]) }),
          None -> set,
        },
        _ -> set,
      };
      { net: match option { Presenting(_) -> presenting, _ -> set }, answer: Ok(()) }
    },
    None -> {
      let l = listener_of(n, label, socket);
      {
        net: {
          ..n,
          listeners: n.listeners.insert(socket, { ..l, options: with_option(l.options, option) }),
        },
        answer: Ok(()),
      }
    },
  }
}

/// What `net.options` answers over the network: each option set, as it was last set.
pub fn mem_options(n: MemNet, label: String, socket: Int) -> List<SocketOption> / {abort.raise} =
  match n.conns.get(socket) {
    Some(_) -> conn_of(n, label, socket).options,
    None -> listener_of(n, label, socket).options,
  }

/// What `net.local_address` answers over the network.
pub fn mem_local_address(
  n: MemNet,
  label: String,
  socket: Int,
) -> Option<SocketAddress> / {abort.raise} =
  match n.conns.get(socket) {
    Some(_) -> conn_of(n, label, socket).local,
    None -> listener_of(n, label, socket).at,
  }

/// What `net.local_port` answers over the network.
pub fn mem_local_port(n: MemNet, label: String, socket: Int) -> Option<Int> / {abort.raise} =
  match mem_local_address(n, label, socket) { Some(at) -> Some(ip::socket_port(at)), None -> None }

/// What `net.peer_address` answers over the network.
pub fn mem_peer_address(
  n: MemNet,
  label: String,
  conn: Int,
) -> Option<SocketAddress> / {abort.raise} =
  match n.conns.get(conn) {
    Some(_) -> conn_of(n, label, conn).peer,
    None -> {
      let _l = listener_of(n, label, conn);
      None
    },
  }

/// What `net.peer_certificate` answers over the network, once a connection is secured: to a server,
/// the certificate its client was handed out presenting (`mem_calling_presenting`), or the program's
/// own client presents (`Presenting`); to a client, the one `mem_presenting` gave the name it
/// secured the connection as.
pub fn mem_peer_certificate(n: MemNet, label: String, conn: Int) -> Option<Bytes> / {abort.raise} =
  match n.conns.get(conn) {
    Some(_) -> {
      let c = conn_of(n, label, conn);
      match c.secured {
        Some(name) -> if c.accepted { c.presented } else { n.leaves.get(name) },
        None -> None,
      }
    },
    None -> {
      let _l = listener_of(n, label, conn);
      None
    },
  }

/// What `net.protocol` answers over the network: the first protocol an upgrade offered, which is
/// what the twin's far end agrees to, and `http/1.1` for a connection `connect_tls` opened.
pub fn mem_protocol(n: MemNet, label: String, conn: Int) -> Option<String> / {abort.raise} =
  match n.conns.get(conn) {
    Some(_) -> conn_of(n, label, conn).agreed,
    None -> {
      let _l = listener_of(n, label, conn);
      None
    },
  }

/// What `net.peer_credentials` answers over the network.
pub fn mem_peer_credentials(
  n: MemNet,
  label: String,
  conn: Int,
) -> Option<PeerCredentials> / {abort.raise} =
  match n.conns.get(conn) {
    Some(_) -> conn_of(n, label, conn).credentials,
    None -> {
      let _l = listener_of(n, label, conn);
      None
    },
  }

/// What `go` answered over a twin, and the network it left.
pub type Over<a> = { value: a, net: MemNet }

/// `go` run over `start`, every `net` operation under every label answered by the twin and every
/// `dns` operation by the table the twin holds: what a test hands code that opens, serves or
/// secures connections. Code that starts tasks, as `dial` does to bound its lookup, runs in a
/// `simulate` region opened inside `go`, so that the twin is older than the scheduler.
pub fn on_mem<a | e>(
  start: MemNet,
  go: () -> a / {net.read[*], net.write[*], dns.lookup, dns.reverse, dns.servers | e},
) -> Over<a> / {abort.raise | e bounded} =
  handle {
    go()
  } with {
    var t = start,
    net.listen[*label](port) -> {
      let s = mem_listen(t, label, port);
      t = s.net;
      s.answer
    },
    net.listen_tls[*label](port, credential) -> {
      let s = mem_listen_tls(t, label, port, credential);
      t = s.net;
      s.answer
    },
    net.listen_on[*label](at, options) -> {
      let s = mem_listen_on(t, label, at, options);
      t = s.net;
      s.answer
    },
    net.listen_unix[*label](root, path) -> {
      let s = mem_listen_unix(t, label, root, path);
      t = s.net;
      s.answer
    },
    net.connect[*label](host, port, timeout_ms) -> {
      let s = mem_connect(t, label, host, port, timeout_ms);
      t = s.net;
      s.answer
    },
    net.connect_tls[*label](host, port, timeout_ms) -> {
      let s = mem_connect_tls(t, label, host, port, timeout_ms);
      t = s.net;
      s.answer
    },
    net.connect_to[*label](to, options, timeout_ms) -> {
      let s = mem_connect_to(t, label, to, options, timeout_ms);
      t = s.net;
      s.answer
    },
    net.connect_unix[*label](root, path, timeout_ms) -> {
      let s = mem_connect_unix(t, label, root, path, timeout_ms);
      t = s.net;
      s.answer
    },
    net.handshake[*label](conn) -> {
      let s = mem_handshake(t, label, conn);
      t = s.net;
      s.answer
    },
    net.start_tls[*label](conn, name, alpn, unread, timeout_ms) -> {
      let s = mem_start_tls(t, label, conn, name, alpn, unread, timeout_ms);
      t = s.net;
      s.answer
    },
    net.serve_tls[*label](conn, credential, alpn, unread, timeout_ms) -> {
      let s = mem_serve_tls(t, label, conn, credential, alpn, unread, timeout_ms);
      t = s.net;
      s.answer
    },
    net.accept[*label](listener) -> {
      let s = mem_accept(t, label, listener);
      t = s.net;
      s.answer
    },
    net.recv[*label](conn, max, timeout_ms) -> {
      let s = mem_recv(t, label, conn, max, timeout_ms);
      t = s.net;
      s.answer
    },
    net.send[*label](conn, payload, timeout_ms) -> {
      let s = mem_send(t, label, conn, payload, timeout_ms);
      t = s.net;
      s.answer
    },
    net.send_secret[*label](conn, before, secret, encoding, after, timeout_ms) -> {
      let s = mem_send_secret(t, label, conn, before, secret, encoding, after, timeout_ms);
      t = s.net;
      s.answer
    },
    net.close_write[*label](conn) -> {
      t = mem_close_write(t, label, conn).net;
    },
    net.close[*label](socket) -> {
      t = mem_close(t, label, socket).net;
    },
    net.set_option[*label](socket, option) -> {
      let s = mem_set_option(t, label, socket, option);
      t = s.net;
      s.answer
    },
    net.local_port[*label](socket) -> mem_local_port(t, label, socket),
    net.local_address[*label](socket) -> mem_local_address(t, label, socket),
    net.peer_address[*label](conn) -> mem_peer_address(t, label, conn),
    net.peer_credentials[*label](conn) -> mem_peer_credentials(t, label, conn),
    net.peer_certificate[*label](conn) -> mem_peer_certificate(t, label, conn),
    net.protocol[*label](conn) -> mem_protocol(t, label, conn),
    net.options[*label](socket) -> mem_options(t, label, socket),
    dns.lookup(name) -> dns::table_lookup(t.names, name),
    dns.reverse(address) -> dns::table_reverse(t.names, address),
    dns.servers() -> t.names.servers,
    return value -> { value: value, net: t },
  }

// --- The real handler -------------------------------------------------------

host for net by served

/// `go` with every socket operation done on the machine, each socket under the label its clause
/// binds, and every operation that waits waiting in the asking task. Each clause answers with its
/// value and the handler holds nothing, so a `parallel` branch is answered on its own thread.
fn served<a | e>(
  go: () -> a / {net.read[*], net.write[*] | e},
) -> a / {native.read, wait.read, abort.raise | e} =
  handle {
    go()
  } with {
    net.listen[*label](port) -> net_listen(label, port_checked("listen", port)),
    net.listen_tls[*label](port, credential) ->
      net_listen_tls(label, port_checked("listen_tls", port), credential),
    net.listen_on[*label](at, options) -> if !listenable(at) { Err(PermissionDenied) } else {
      refused_or(net_listen_on(label, address_written(at), options_written(options)), int_of)
    },
    net.listen_unix[*label](root, path) -> refused_or(net_listen_unix(label, root, path), int_of),
    net.connect[*label](host, port, timeout_ms) -> {
      deadline("connect", timeout_ms);
      int_found(job_wait(net_connect(label, host, port_checked("connect", port), timeout_ms)))
    },
    net.connect_tls[*label](host, port, timeout_ms) -> {
      deadline("connect_tls", timeout_ms);
      int_found(
        job_wait(net_connect_tls(label, host, port_checked("connect_tls", port), timeout_ms)),
      )
    },
    net.connect_to[*label](to, options, timeout_ms) -> {
      deadline("connect_to", timeout_ms);
      let asked = net_connect_to(label, address_written(to), options_written(options), timeout_ms);
      refused_or(job_wait(asked), int_of)
    },
    net.connect_unix[*label](root, path, timeout_ms) -> {
      deadline("connect_unix", timeout_ms);
      refused_or(job_wait(net_connect_unix(label, root, path, timeout_ms)), int_of)
    },
    net.handshake[*label](conn) -> int_found(job_wait(net_handshake(label, conn))),
    net.start_tls[*label](conn, name, alpn, unread, timeout_ms) -> {
      deadline("start_tls", timeout_ms);
      let asked = net_start_tls(label, conn, name, texts_written(alpn), unread.len(), timeout_ms);
      refused_or(job_wait(asked), secured_read)
    },
    net.serve_tls[*label](conn, credential, alpn, unread, timeout_ms) -> {
      deadline("serve_tls", timeout_ms);
      let asked = net_serve_tls(
        label,
        conn,
        credential,
        texts_written(alpn),
        unread.len(),
        timeout_ms,
      );
      refused_or(job_wait(asked), secured_read)
    },
    net.accept[*label](listener) -> int_of(job_wait(net_accept(label, listener))),
    net.recv[*label](conn, max, timeout_ms) -> {
      deadline("recv", timeout_ms);
      found(job_wait(net_recv(label, conn, asked_for(max), timeout_ms)))
    },
    net.send[*label](conn, payload, timeout_ms) -> {
      deadline("send", timeout_ms);
      something_to("send", payload.len() == 0);
      int_found(job_wait(net_send(label, conn, payload, timeout_ms)))
    },
    net.send_secret[*label](conn, before, secret, encoding, after, timeout_ms) -> {
      deadline("send_secret", timeout_ms);
      let framed = sent_secret(before, secret, encoding, after);
      something_to("send_secret", framed.is_empty());
      job_wait(net_send_secret(label, conn, framed, timeout_ms)) == b"\x01"
    },
    net.close_write[*label](conn) -> net_close_write(label, conn),
    net.close[*label](socket) -> net_close(label, socket),
    net.set_option[*label](socket, option) ->
      refused_or(net_set_option(label, socket, option_written(option)), |_: Bytes| ()),
    net.local_port[*label](socket) -> {
      let at = net_local_port(label, socket);
      if at < 0 { None } else { Some(at) }
    },
    net.local_address[*label](socket) -> address_found(net_local_address(label, socket)),
    net.peer_address[*label](conn) -> address_found(net_peer_address(label, conn)),
    net.peer_credentials[*label](conn) -> match found(net_peer_credentials(label, conn)) {
      Some(flat) -> Some(credentials_read(flat)),
      None -> None,
    },
    net.peer_certificate[*label](conn) -> found(net_peer_certificate(label, conn)),
    net.protocol[*label](conn) -> text_found(net_protocol(label, conn)),
    net.options[*label](socket) -> options_read(net_options(label, socket)),
  }

/// A listener on `port` of the loopback address, as its handle.
extern fn net_listen(label: String, port: Int) -> Int / {native.read}

/// A listener on `port` of the loopback address serving TLS with `credential`, as its handle.
extern fn net_listen_tls(label: String, port: Int, credential: String) -> Int / {native.read}

/// A listener at exactly the address written, with the options written set before it binds.
extern fn net_listen_on(label: String, at: Bytes, options: Bytes) -> Bytes / {native.read}

/// A listener on the Unix socket at `path` under `root`.
extern fn net_listen_unix(label: String, root: String, path: String) -> Bytes / {native.read}

/// The ticket of a connection to `host`, its handle found.
extern fn net_connect(
  label: String,
  host: String,
  port: Int,
  timeout_ms: Int,
) -> Int / {native.read}

/// The ticket of a TLS connection to `host`, verified as it, its handle found.
extern fn net_connect_tls(
  label: String,
  host: String,
  port: Int,
  timeout_ms: Int,
) -> Int / {native.read}

/// The ticket of a connection to exactly the address written.
extern fn net_connect_to(
  label: String,
  to: Bytes,
  options: Bytes,
  timeout_ms: Int,
) -> Int / {native.read}

/// The ticket of a connection to the Unix socket at `path` under `root`.
extern fn net_connect_unix(
  label: String,
  root: String,
  path: String,
  timeout_ms: Int,
) -> Int / {native.read}

/// The ticket of a connection's TLS handshake, the microseconds it took found.
extern fn net_handshake(label: String, conn: Int) -> Int / {native.read}

/// The ticket of a plaintext connection secured as its client.
extern fn net_start_tls(
  label: String,
  conn: Int,
  name: String,
  alpn: Bytes,
  unread: Int,
  timeout_ms: Int,
) -> Int / {native.read}

/// The ticket of a plaintext connection secured as its server.
extern fn net_serve_tls(
  label: String,
  conn: Int,
  credential: String,
  alpn: Bytes,
  unread: Int,
  timeout_ms: Int,
) -> Int / {native.read}

/// The ticket of the next connection a listener takes.
extern fn net_accept(label: String, listener: Int) -> Int / {native.read}

/// The ticket of at most `max` bytes of a connection, found.
extern fn net_recv(label: String, conn: Int, max: Int, timeout_ms: Int) -> Int / {native.read}

/// The ticket of a write of some prefix of `payload`, how many bytes it took found.
extern fn net_send(label: String, conn: Int, payload: Bytes, timeout_ms: Int) -> Int / {native.read}

/// The ticket of a write of every byte of `framed`.
extern fn net_send_secret(
  label: String,
  conn: Int,
  framed: Secret<Bytes>,
  timeout_ms: Int,
) -> Int / {native.read}

/// Ends a connection's sending.
extern fn net_close_write(label: String, conn: Int) -> Unit / {native.read}

/// Closes a socket.
extern fn net_close(label: String, socket: Int) -> Unit / {native.read}

/// Sets the option written on a socket.
extern fn net_set_option(label: String, socket: Int, option: Bytes) -> Bytes / {native.read}

/// The port this end of a socket is bound to, or -1 for none.
extern fn net_local_port(label: String, socket: Int) -> Int / {native.read}

/// The address this end of a socket is bound to, found.
extern fn net_local_address(label: String, socket: Int) -> Bytes / {native.read}

/// The address of a connection's far end, found.
extern fn net_peer_address(label: String, conn: Int) -> Bytes / {native.read}

/// Who holds the far end of a Unix socket, found.
extern fn net_peer_credentials(label: String, conn: Int) -> Bytes / {native.read}

/// The far end's certificate on a secured connection, found.
extern fn net_peer_certificate(label: String, conn: Int) -> Bytes / {native.read}

/// The application protocol a secured connection's handshake agreed, found.
extern fn net_protocol(label: String, conn: Int) -> Bytes / {native.read}

/// Each option a socket has, as parts.
extern fn net_options(label: String, socket: Int) -> Bytes / {native.read}

// --- What the host's socket natives read and write ----------------------------

/// The integer a native found.
fn int_found(said: Bytes) -> Option<Int> / {abort.raise} =
  match found(said) { Some(flat) -> Some(int_of(flat)), None -> None }

/// The text a native found.
fn text_found(said: Bytes) -> Option<String> =
  match found(said) { Some(flat) -> Some(String::of_bytes_lossy(flat)), None -> None }

/// The socket address a native found.
fn address_found(said: Bytes) -> Option<SocketAddress> / {abort.raise} =
  match found(said) { Some(flat) -> Some(address_read(flat)), None -> None }

fn texts_written(texts: List<String>) -> Bytes =
  in_parts(texts.map(|t: String| Bytes::of_string(t)))

/// What an upgrade settled: the protocol the two ends agreed, found.
fn secured_read(said: Bytes) -> Secured = { protocol: text_found(said) }

/// Parts: the user, the group, and the process, empty where the platform does not say.
fn credentials_read(flat: Bytes) -> PeerCredentials / {abort.raise} =
  match parts(flat) {
    [user, group, process] ->
      { user: int_of(user), group: int_of(group), process: process.i64_be_at(0) },
    _ -> panic("a socket native wrote no credentials"),
  }

/// A socket address as the host's socket natives read and write one: parts of its address's bytes,
/// its port in two bytes, and its zone, empty for none.
pub fn address_written(at: SocketAddress) -> Bytes =
  in_parts([
    ip::to_bytes(ip::socket_ip(at)),
    u16_be(ip::socket_port(at)),
    match ip::socket_zone(at) { Some(zone) -> Bytes::of_string(zone), None -> b"" },
  ])

/// The socket address `address_written` writes.
pub fn address_read(flat: Bytes) -> SocketAddress / {abort.raise} =
  match parts(flat) {
    [address, port, zone] -> match ip::of_bytes(address) {
      Some(a) -> {
        let at = ip::socket_at(a, port.u16_be_at(0).unwrap_or(0));
        if zone.len() == 0 { at } else {
          match ip::in_zone(at, String::of_bytes_lossy(zone)) { Some(zoned) -> zoned, None -> at }
        }
      },
      None -> panic("a socket native wrote no address"),
    },
    _ -> panic("a socket native wrote no address"),
  }

/// A socket option as the host's socket natives read and write one: its setting's byte, as
/// `with_option` numbers settings, and then what it sets: a flag's byte, a size's eight bytes, or
/// for an option that may set nothing, byte 0, or byte 1 and what it sets.
pub fn option_written(asked: SocketOption) -> Bytes / {abort.raise} = {
  let option = option_checked(asked);
  byte_of_int(setting(option)).concat(match option {
    NoDelay(on) -> flag_written(on),
    KeepAlive(None) -> b"\x00",
    KeepAlive(Some(p)) ->
      b"\x01".concat(
        in_parts([
          i64_be(as_nanos(p.idle)),
          match p.interval { Some(d) -> i64_be(as_nanos(d)), None -> b"" },
          match p.count { Some(n) -> i64_be(n), None -> b"" },
        ]),
      ),
    ReuseAddress(on) -> flag_written(on),
    ReusePort(on) -> flag_written(on),
    SendBuffer(bytes) -> i64_be(bytes),
    ReceiveBuffer(bytes) -> i64_be(bytes),
    Linger(None) -> b"\x00",
    Linger(Some(d)) -> b"\x01".concat(i64_be(as_nanos(d))),
    Broadcast(on) -> flag_written(on),
    MulticastLoop(on) -> flag_written(on),
    JoinGroup(group, interface) -> group_written(group, interface),
    LeaveGroup(group, interface) -> group_written(group, interface),
    Presenting(name) -> Bytes::of_string(name),
  })
}

fn flag_written(on: Bool) -> Bytes = if on { b"\x01" } else { b"\x00" }

/// Parts: the group's address bytes and the interface, empty for the one the host picks.
fn group_written(group: Ip, interface: Option<String>) -> Bytes =
  in_parts([
    ip::to_bytes(group),
    match interface { Some(name) -> Bytes::of_string(name), None -> b"" },
  ])

/// The option `option_written` writes.
fn option_read(flat: Bytes) -> SocketOption / {abort.raise} = {
  let rest = flat.slice(1, flat.len());
  let on = rest.len() > 0 && rest.at(0) == 1;
  let after = if rest.len() > 0 { rest.slice(1, rest.len()) } else { b"" };
  match flat.at(0) {
    0 -> NoDelay(on),
    1 -> KeepAlive(if on { Some(probing_read(after)) } else { None }),
    2 -> ReuseAddress(on),
    3 -> ReusePort(on),
    4 -> SendBuffer(int_of(rest)),
    5 -> ReceiveBuffer(int_of(rest)),
    6 -> Linger(if on { Some(nanos(int_of(after))) } else { None }),
    7 -> Broadcast(on),
    8 -> MulticastLoop(on),
    9 -> match group_read(rest) { (group, interface) -> JoinGroup(group, interface) },
    10 -> match group_read(rest) { (group, interface) -> LeaveGroup(group, interface) },
    _ -> Presenting(String::of_bytes_lossy(rest)),
  }
}

fn probing_read(flat: Bytes) -> Probing / {abort.raise} =
  match parts(flat) {
    [idle, interval, count] ->
      {
        idle: nanos(int_of(idle)),
        interval: match interval.i64_be_at(0) { Some(n) -> Some(nanos(n)), None -> None },
        count: count.i64_be_at(0),
      },
    _ -> panic("a socket native wrote no probing"),
  }

fn group_read(flat: Bytes) -> (Ip, Option<String>) / {abort.raise} =
  match parts(flat) {
    [address, interface] -> match ip::of_bytes(address) {
      Some(group) ->
        (group, if interface.len() == 0 { None } else { Some(String::of_bytes_lossy(interface)) }),
      None -> panic("a socket native wrote no group"),
    },
    _ -> panic("a socket native wrote no group"),
  }

/// `options` as the host's socket natives read them: each written, as parts.
pub fn options_written(options: List<SocketOption>) -> Bytes / {abort.raise} =
  in_parts(options.map(option_written))

/// The options `options_written` writes.
pub fn options_read(flat: Bytes) -> List<SocketOption> / {abort.raise} =
  parts(flat).map(option_read)

/// The refusal a socket native wrote: its kind's byte, `Refused` 1 to `Other` 11 in declaration
/// order, then `Handshake`'s reason, or `Other`'s code and words as parts.
fn refusal_read(flat: Bytes) -> Refusal / {abort.raise} = {
  let rest = flat.slice(1, flat.len());
  match flat.at(0) {
    1 -> Refused,
    2 -> Unreachable,
    3 -> TimedOut,
    4 -> Reset,
    5 -> NameNotFound,
    6 -> AddressInUse,
    7 -> PermissionDenied,
    8 -> Injected,
    9 -> Untrusted,
    10 -> Handshake(String::of_bytes_lossy(rest)),
    _ -> match parts(rest) {
      [code, words] -> Other(int_of(code), String::of_bytes_lossy(words)),
      _ -> Other(0, String::of_bytes_lossy(rest)),
    },
  }
}

/// What a socket native answered where the operation may be refused: byte 1 and what `ok` reads of
/// the rest, or byte 0 and the refusal.
pub fn refused_or<a | e>(
  said: Bytes,
  ok: (Bytes) -> a / e,
) -> Result<a, Refusal> / {abort.raise | e} = {
  let rest = said.slice(1, said.len());
  if said.at(0) == 1 { Ok(ok(rest)) } else { Err(refusal_read(rest)) }
}

// --- Tests ------------------------------------------------------------------

test "an address, an option and a refusal read back as the host's natives write them" {
  let addresses = [
    ip::read_socket("192.0.2.1:80"),
    ip::read_socket("[2001:db8::1]:443"),
    ip::read_socket("[fe80::1%en0]:8080"),
  ];
  assert_eq(addresses.map(|at: SocketAddress| address_read(address_written(at))), addresses);
  let probing: Probing = { idle: seconds(60), interval: Some(seconds(5)), count: Some(3) };
  let options = [
    NoDelay(true),
    KeepAlive(Some(probing)),
    KeepAlive(Some({ idle: seconds(1), interval: None, count: None })),
    KeepAlive(None),
    ReuseAddress(false),
    ReusePort(true),
    SendBuffer(65536),
    ReceiveBuffer(0),
    Linger(Some(millis(250))),
    Linger(None),
    Broadcast(true),
    MulticastLoop(false),
    JoinGroup(ip::read("239.0.0.1"), Some("en0")),
    LeaveGroup(ip::read("ff02::1"), None),
    Presenting("client"),
  ];
  assert_eq(options_read(options_written(options)), options);
  assert_eq(options_read(options_written([])), []);
  let refused = |kind: Bytes| refused_or(b"\x00".concat(kind), |_: Bytes| ());
  assert_eq(refused(b"\x01"), Err(Refused));
  assert_eq(refused(b"\x09"), Err(Untrusted));
  assert_eq(refused(b"\x0Ano shared cipher"), Err(Handshake("no shared cipher")));
  assert_eq(
    refused(b"\x0B".concat(in_parts([i64_be(61), b"refused by the system"]))),
    Err(Other(61, "refused by the system")),
  );
  assert_eq(refused_or(b"\x01".concat(i64_be(7)), int_of), Ok(7))
}

fn head(queued: List<Bytes>) -> Bytes = match queued { [first, ..] -> first, _ -> b"" }

fn tail(queued: List<Bytes>) -> List<Bytes> = match queued { [_, ..rest] -> rest, _ -> [] }

test "drain stops at end of stream rather than at the first short read" {
  let left = handle {
    assert_eq(drain[conn](1, b"", 1000), b"abc")
  } with {
    var inbox = [b"ab", b"c", b"", b"unread"],
    net.recv[conn](c, max, timeout_ms) -> {
      let queued = inbox;
      inbox = tail(queued);
      Some(head(queued))
    },
    return u -> inbox,
  };
  assert_eq(left, [b"unread"])
}

// A caller that could not tell a deadline from an ending would answer 408 to a peer that had finished.
test "a deadline is not an ending" {
  handle {
    assert_eq(drain[conn](1, b"", 1000), b"ab")
  } with {
    var inbox = [b"ab"],
    net.recv[conn](c, max, timeout_ms) -> {
      let queued = inbox;
      inbox = tail(queued);
      match queued { [first, ..] -> Some(first), _ -> None }
    },
  }
}

test "send_all loops over a partial write and stops at a dead peer" {
  let written = handle {
    assert(send_all[conn](1, b"hello", 1000))
  } with {
    var written = b"",
    net.send[conn](c, payload, timeout_ms) -> {
      let take = if payload.len() > 2 { 2 } else { payload.len() };
      written = written.concat(payload.slice(0, take));
      Some(take)
    },
    return u -> written,
  };
  assert_eq(written, b"hello");
  handle {
    assert(!send_all[conn](1, b"hello", 1000))
  } with {
    net.send[conn](c, payload, timeout_ms) -> Some(0),
  };
  handle {
    assert(!send_all[conn](1, b"hello", 1000))
  } with {
    net.send[conn](c, payload, timeout_ms) -> None,
  }
}

test "a credential goes on a connection whole and sealed, framed by what is said before and after it" {
  let password = Secret::of_bytes(b"\x00ada\x00hunter2");
  let sent = handle {
    net.send_secret[smtp](1, b"AUTH PLAIN ", password, "base64", b"\r\n", 1000)
  } with {
    var wire: List<Secret<Bytes>> = [],
    net.send_secret[smtp](c, before, secret, encoding, after, timeout_ms) -> {
      wire = wire.push(sent_secret(before, secret, encoding, after));
      true
    },
    return went -> { went: went, wire: wire },
  };
  assert(sent.went);
  assert(sent.wire == [Secret::of_bytes(b"AUTH PLAIN AGFkYQBodW50ZXIy\r\n")]);
  assert(sent_secret(b"", password, "raw", b"") == password);
  assert(
    sent_secret(b"user=", Secret::of_bytes(b"\xff\x01"), "hex", b";")
      == Secret::of_bytes(b"user=ff01;"),
  )
}

/// A network with one peer at `192.0.2.25:25` that answers one connection with `script`.
fn relayed(script: List<Step>) -> MemNet / {ip.refused, abort.raise} =
  mem_serving(mem_empty(), ip::read_socket("192.0.2.25:25"), [script])

/// A connection to that peer.
fn to_relay() -> Int / {net.connect_to[relay], ip.refused, abort.raise} =
  match net.connect_to[relay](ip::read_socket("192.0.2.25:25"), [], 1000) {
    Ok(c) -> c,
    Err(_) -> panic("the relay refused"),
  }

test "a scripted peer says its lines in order, waits to hear the program's, and ends" {
  let script = [Says(b"220 ready\r\n"), Hears(b"EHLO x\r\n"), Says(b"250 ok\r\n")];
  let ran = on_mem(relayed(script), || {
    let c = to_relay();
    let greeting = net.recv[relay](c, 512, 1000);
    let early = net.recv[relay](c, 512, 1000);
    let half = net.send[relay](c, b"EHLO", 1000);
    let waiting = net.recv[relay](c, 512, 1000);
    let rest = send_all[relay](c, b" x\r\n", 1000);
    let reply = net.recv[relay](c, 512, 1000);
    let ended = net.recv[relay](c, 512, 1000);
    net.close[relay](c);
    { c: c, read: [greeting, early, waiting, reply, ended], half: half, rest: rest }
  });
  assert_eq(ran.value.read, [Some(b"220 ready\r\n"), None, None, Some(b"250 ok\r\n"), Some(b"")]);
  assert_eq(ran.value.half, Some(4));
  assert(ran.value.rest);
  assert_eq(mem_sent(ran.net, ran.value.c), b"EHLO x\r\n");
  assert_eq(mem_unmet(ran.net, ran.value.c), []);
  assert_eq(ran.net.closed, [ran.value.c])
}

test "a program that sends what its peer was not to hear fails where it sends it" {
  let failed: Result<Option<Int>, String> = try[abort.raise] {
    on_mem(relayed([Hears(b"EHLO x\r\n")]), ||
      net.send[relay](to_relay(), b"HELO x\r\n", 1000)).value
  };
  assert_eq(failed, Err("the peer was to hear \"EHLO x\r\n\" and the program sent \"HELO x\r\n\""))
}

fn plain_auth() -> Bytes = b"AUTH PLAIN AGFkYQBodW50ZXIy\r\n"

test "a credential reaches the far end whole in its frame, and nothing that shows the connection holds it" {
  let password = Secret::of_bytes(b"\x00ada\x00hunter2");
  let script = [
    Says(b"220 ready\r\n"),
    Hears(b"EHLO x\r\n"),
    Says(b"250 AUTH PLAIN\r\n"),
    HearsSecret(plain_auth()),
    Says(b"235 ok\r\n"),
  ];
  let ran = on_mem(relayed(script), || {
    let c = to_relay();
    let greeting = net.recv[relay](c, 512, 1000);
    let hello = send_all[relay](c, b"EHLO x\r\n", 1000);
    let offer = net.recv[relay](c, 512, 1000);
    let went = net.send_secret[relay](c, b"AUTH PLAIN ", password, "base64", b"\r\n", 1000);
    let reply = net.recv[relay](c, 512, 1000);
    net.close_write[relay](c);
    let late = net.send_secret[relay](c, b"", password, "raw", b"", 1000);
    net.close[relay](c);
    { c: c, read: [greeting, offer, reply], hello: hello, went: went, late: late }
  });
  assert(ran.value.hello && ran.value.went && !ran.value.late);
  assert_eq(ran.value.read, [
    Some(b"220 ready\r\n"),
    Some(b"250 AUTH PLAIN\r\n"),
    Some(b"235 ok\r\n"),
  ]);
  assert_eq(mem_sent(ran.net, ran.value.c), b"EHLO x\r\n");
  assert(mem_sent_secrets(ran.net, ran.value.c) == [Secret::of_bytes(plain_auth())]);
  assert_eq(mem_unmet(ran.net, ran.value.c), [])
}

test "a credential the peer was not to hear fails where it is sent, and says nothing of either" {
  let sent = |script: List<Step>, encoding: String| {
    let failed: Result<Bool, String> = try[abort.raise] {
      on_mem(relayed(script), ||
        net.send_secret[relay](
          to_relay(),
          b"AUTH PLAIN ",
          Secret::of_bytes(b"\x00ada\x00hunter2"),
          encoding,
          b"\r\n",
          1000,
        )).value
    };
    failed
  };
  assert_eq(sent([HearsSecret(plain_auth())], "base64"), Ok(true));
  assert_eq(
    sent([HearsSecret(plain_auth())], "raw"),
    Err("the peer was to hear one credential and the program sent another"),
  );
  assert_eq(
    sent([Hears(b"AUTH PLAIN\r\n")], "base64"),
    Err("the peer was to hear \"AUTH PLAIN\r\n\" and the program sent a credential"),
  );
  assert_eq(sent([Says(b"220 ready\r\n")], "base64"), Ok(true));
  assert_eq(sent([Blocks], "base64"), Ok(false));
  assert_eq(sent([], "rot13"), Err("`net.send_secret` knows no encoding `rot13`"));
  let pending: Result<Bool, String> = try[abort.raise] {
    on_mem(relayed([HearsSecret(plain_auth())]), || {
      let c = to_relay();
      let _half = net.send[relay](c, b"AUTH", 1000);
      net.send_secret[relay](c, b"", Secret::of_bytes(plain_auth()), "raw", b"", 1000)
    }).value
  };
  assert_eq(pending, Err("the peer was to hear a credential and the program sent \"AUTH\""))
}

test "a read and a write move no more than a short network lets them" {
  let ran = on_mem(mem_short(relayed([Says(b"abcdefg"), Hears(b"hello")]), 3), || {
    let c = to_relay();
    let read = [
      net.recv[relay](c, 512, 1000),
      net.recv[relay](c, 2, 1000),
      net.recv[relay](c, 512, 1000),
    ];
    let partial = net.send[relay](c, b"hello", 1000);
    { c: c, read: read, partial: partial, whole: send_all[relay](c, b"lo", 1000) }
  });
  assert_eq(ran.value.read, [Some(b"abc"), Some(b"de"), Some(b"fg")]);
  assert_eq(ran.value.partial, Some(3));
  assert(ran.value.whole);
  assert_eq(mem_unmet(ran.net, ran.value.c), [])
}

test "an upgrade secures the connection where the peer upgrades, and what follows is read after it" {
  let script = [
    Says(b"220 go ahead\r\n"),
    Upgrades,
    Hears(b"EHLO x\r\n"),
    Says(b"250 secured\r\n"),
  ];
  let ran = on_mem(relayed(script), || {
    let c = to_relay();
    let go_ahead = net.recv[relay](c, 512, 1000);
    let held = net.recv[relay](c, 512, 1000);
    let before = net.handshake[relay](c);
    let secured = net.start_tls[relay](c, "mail.example", [], b"", 1000);
    let after = net.handshake[relay](c);
    let sent = send_all[relay](c, b"EHLO x\r\n", 1000);
    {
      c: c,
      go_ahead: go_ahead,
      held: held,
      before: before,
      secured: secured,
      after: after,
      sent: sent,
      reply: net.recv[relay](c, 512, 1000),
    }
  });
  assert_eq(ran.value.go_ahead, Some(b"220 go ahead\r\n"));
  // Nothing past the upgrade is read before it: the peer is waiting for the handshake.
  assert_eq(ran.value.held, None);
  assert_eq(ran.value.before, None);
  assert_eq(ran.value.secured, Ok({ protocol: None }));
  assert_eq(ran.value.after, Some(0));
  assert(ran.value.sent);
  assert_eq(ran.value.reply, Some(b"250 secured\r\n"));
  assert_eq(mem_secured(ran.net, ran.value.c), Some("mail.example"))
}

test "plaintext sent behind the go-ahead is refused, whether the socket holds it or the caller does" {
  // The peer's second line is in the socket when the handshake is to begin.
  let waiting = on_mem(
    relayed([Says(b"220 go ahead\r\n"), Says(b"250 injected\r\n"), Upgrades]),
    || {
      let c = to_relay();
      let _go_ahead = net.recv[relay](c, 512, 1000);
      let refused = net.start_tls[relay](c, "mail.example", [], b"", 1000);
      {
        c: c,
        refused: refused,
        read: net.recv[relay](c, 512, 1000),
        wrote: net.send[relay](c, b"AUTH", 1000),
      }
    },
  );
  assert_eq(waiting.value.refused, Err(Injected));
  // The connection is over: nothing injected is ever read as if it were secured.
  assert_eq(waiting.value.read, Some(b""));
  assert_eq(waiting.value.wrote, Some(0));
  assert_eq(mem_secured(waiting.net, waiting.value.c), None);
  // Both lines came in one read, so the second is in the caller's own buffer.
  let buffered = on_mem(relayed([Says(b"220 go ahead\r\n250 injected\r\n"), Upgrades]), || {
    let c = to_relay();
    let read = match net.recv[relay](c, 512, 1000) { Some(bytes) -> bytes, None -> b"" };
    let unread = read.slice(b"220 go ahead\r\n".len(), read.len());
    net.start_tls[relay](c, "mail.example", [], unread, 1000)
  });
  assert_eq(buffered.value, Err(Injected))
}

test "an upgrade whose peer {c.told} answers {c.shown}" for c: { told: String, script: List<Step>, alpn: List<String>, shown: String, answer: Result<Secured, Refusal> } in [
    {
      told: "upgrades with a protocol offered",
      script: [Upgrades],
      alpn: ["postgresql", "h2"],
      shown: "the first offered",
      answer: Ok({ protocol: Some("postgresql") }),
    },
    {
      told: "shows a certificate not trusted",
      script: [Refuses(Untrusted)],
      alpn: [],
      shown: "Untrusted",
      answer: Err(Untrusted),
    },
    {
      told: "fails the handshake",
      script: [Refuses(Handshake("no cipher suite in common"))],
      alpn: [],
      shown: "why",
      answer: Err(Handshake("no cipher suite in common")),
    },
    {
      told: "stalls",
      script: [Stalls, Upgrades],
      alpn: [],
      shown: "TimedOut",
      answer: Err(TimedOut),
    },
    {
      told: "still waits to hear something",
      script: [Hears(b"STARTTLS\r\n"), Upgrades],
      alpn: [],
      shown: "TimedOut",
      answer: Err(TimedOut),
    },
    { told: "is gone", script: [], alpn: [], shown: "Reset", answer: Err(Reset) },
  ] {
  let ran = on_mem(relayed(c.script), || {
    let conn = to_relay();
    {
      answer: net.start_tls[relay](conn, "db.example", c.alpn, b"", 1000),
      after: net.send[relay](conn, b"x", 1000),
    }
  });
  assert_eq(ran.value.answer, c.answer);
  assert_eq(ran.value.after, match c.answer { Ok(_) -> Some(1), Err(_) -> Some(0) })
}

test "a refused connection or upgrade is raised by the functions that open one" {
  let ran = on_mem(relayed([Refuses(Untrusted)]), || {
    let c = to_relay();
    let upgrade: Result<Secured, Refusal> = try { secure[relay](c, "mail.example", [], b"", 1000) };
    let nobody: Result<Int, Refusal> = try[socket.refused] {
      dial_address[relay](ip::read_socket("192.0.2.26:25"), [], 1000)
    };
    let beyond: Result<Int, Refusal> = try[socket.refused] {
      listening[listener](ip::read_socket("192.0.2.1:80"), [])
    };
    { upgrade: upgrade, nobody: nobody, beyond: beyond }
  });
  assert_eq(ran.value.upgrade, Err(Untrusted));
  assert_eq(ran.value.nobody, Err(Refused));
  assert_eq(ran.value.beyond, Err(PermissionDenied))
}

test "a listener hands out the clients waiting, each from its address, then says it has stopped" {
  let callers = mem_calling(
    mem_calling(mem_empty(), ip::read_socket("203.0.113.9:4431"), [Says(b"hi"), Hears(b"yo")]),
    ip::read_socket("[2001:db8::9]:4432"),
    [],
  );
  let ran = on_mem(callers, || {
    let l = net.listen[listener](0);
    let first = net.accept[listener](l);
    let second = net.accept[listener](l);
    let third = net.accept[listener](l);
    let heard = net.recv[conn](first, 64, 1000);
    let said = net.send[conn](first, b"yo", 1000);
    {
      first: first,
      third: third,
      port: net.local_port[listener](l),
      here: net.local_address[conn](first),
      peers: [
        net.peer_address[conn](first),
        net.peer_address[conn](second),
        net.peer_address[listener](l),
      ],
      heard: heard,
      said: said,
      ended: net.recv[conn](first, 64, 1000),
    }
  });
  assert_eq(ran.value.third, 0);
  assert_eq(ran.value.port, Some(49152));
  assert_eq(ran.value.here, Some(ip::read_socket("127.0.0.1:49152")));
  assert_eq(ran.value.peers, [
    Some(ip::read_socket("203.0.113.9:4431")),
    Some(ip::read_socket("[2001:db8::9]:4432")),
    None,
  ]);
  assert_eq(ran.value.heard, Some(b"hi"));
  assert_eq(ran.value.said, Some(2));
  assert_eq(ran.value.ended, Some(b""));
  assert_eq(mem_unmet(ran.net, ran.value.first), [])
}

test "a server secures a client that asks, with a credential the run holds, and refuses what it read past the request" {
  let asking = [Says(b"STARTTLS\r\n"), Hears(b"220 go ahead\r\n"), Upgrades, Says(b"EHLO x\r\n")];
  let client = ip::read_socket("203.0.113.9:4431");
  let served = |script: List<Step>, unread: Bytes| {
    on_mem(mem_credential(mem_calling(mem_empty(), client, script), "mail"), || {
      let l = net.listen[listener](2525);
      let c = net.accept[listener](l);
      let _asked = net.recv[conn](c, 512, 1000);
      let _told = send_all[conn](c, b"220 go ahead\r\n", 1000);
      let secured = net.serve_tls[conn](c, "mail", [], unread, 1000);
      { c: c, secured: secured, next: net.recv[conn](c, 512, 1000) }
    })
  };
  let ran = served(asking, b"");
  assert_eq(ran.value.secured, Ok({ protocol: None }));
  assert_eq(ran.value.next, Some(b"EHLO x\r\n"));
  assert_eq(mem_secured(ran.net, ran.value.c), Some("mail"));
  // A client that sent a command behind its request, to be run as if it had come secured.
  let injected = served(asking, b"MAIL FROM:<mallory@example>\r\n");
  assert_eq(injected.value.secured, Err(Injected));
  assert_eq(injected.value.next, Some(b""));
  let unheld: Result<Result<Secured, Refusal>, String> = try[abort.raise] {
    on_mem(mem_calling(mem_empty(), client, asking), || {
      let c = net.accept[listener](net.listen[listener](2525));
      net.serve_tls[conn](c, "mail", [], b"", 1000)
    }).value
  };
  assert_eq(unheld, Err("no TLS credential named `mail` was configured for this run"))
}

test "a connection to the program's own listener joins the two ends" {
  let ran = on_mem(mem_empty(), || {
    let here = ip::read_socket("127.0.0.1:8080");
    let l = listening[listener](here, []);
    let client = dial_address[client](here, [], 1000);
    let server = net.accept[listener](l);
    let quiet = net.recv[conn](server, 64, 1000);
    let asked = net.send[client](client, b"ping", 1000);
    let heard = net.recv[conn](server, 64, 1000);
    let answered = net.send[conn](server, b"pong", 1000);
    net.close_write[client](client);
    let after_end = net.send[client](client, b"more", 1000);
    let ended = net.recv[conn](server, 64, 1000);
    let reply = net.recv[client](client, 64, 1000);
    net.close[client](client);
    {
      quiet: quiet,
      asked: asked,
      heard: heard,
      answered: answered,
      after_end: after_end,
      ended: ended,
      reply: reply,
      gone: net.send[conn](server, b"late", 1000),
      from: net.peer_address[conn](server),
      none_left: net.accept[listener](l),
    }
  });
  assert_eq(ran.value.quiet, None);
  assert_eq(ran.value.asked, Some(4));
  assert_eq(ran.value.heard, Some(b"ping"));
  assert_eq(ran.value.answered, Some(4));
  assert_eq(ran.value.after_end, Some(0));
  assert_eq(ran.value.ended, Some(b""));
  assert_eq(ran.value.reply, Some(b"pong"));
  assert_eq(ran.value.gone, Some(0));
  assert_eq(ran.value.from, Some(ip::read_socket("127.0.0.1:49152")));
  assert_eq(ran.value.none_left, 0)
}

test "a name connects where the network's table says, each address tried in the order it is given" {
  let names = dns::with_name(dns::table(), "db.example", [
    ip::read("2001:db8::5"),
    ip::read("192.0.2.5"),
  ]);
  let world = mem_failing(
    mem_serving(mem_resolving(mem_empty(), names), ip::read_socket("192.0.2.5:5432"), [
      [Says(b"R")],
      [Says(b"R")],
      [Says(b"R")],
    ]),
    ip::read_socket("[2001:db8::5]:5432"),
    Unreachable,
  );
  let ran = on_mem(world, ||
    simulate {
      task::unbounded(|| {
        let by_host = net.connect[db]("db.example", 5432, 1000);
        let tls = net.connect_tls[db]("db.example", 5432, 1000);
        let dialled = dial[db]("DB.example.", 5432, [], 1000);
        let nowhere = net.connect[db]("other.example", 5432, 1000);
        let unknown: Result<Int, Refusal> = try { dial[db]("other.example", 5432, [], 1000) };
        let foreign: Result<Int, Refusal> = try { dial[db]("b\u{fc}cher.example", 5432, [], 1000) };
        let spent: Result<Int, Refusal> = try { dial[db]("db.example", 5432, [], 1000) };
        {
          by_host: by_host,
          tls: tls,
          peer: net.peer_address[db](dialled),
          nowhere: nowhere,
          unknown: unknown,
          foreign: foreign,
          spent: spent,
        }
      })
    });
  assert_eq(ran.value.by_host, Some(1));
  assert_eq(ran.value.tls, Some(2));
  assert_eq(mem_secured(ran.net, 2), Some("db.example"));
  assert_eq(ran.value.peer, Some(ip::read_socket("192.0.2.5:5432")));
  assert_eq(ran.value.nowhere, None);
  assert_eq(ran.value.unknown, Err(NameNotFound));
  // A name that is not ASCII is refused as `dns.lookup` refuses it, and nothing is looked up.
  assert_eq(
    ran.value.foreign,
    Err(Other(0, "a name is ASCII: an internationalized name is looked up by its A-labels")),
  );
  // The last address tried is the one whose refusal is raised: the peer has no script left.
  assert_eq(ran.value.spent, Err(Refused))
}

/// `go` over a network where a connection to one of `dead` is never answered, which costs its
/// caller the whole of the deadline it gave, and one to any other address is answered at once.
fn unanswered<a | e>(
  dead: List<SocketAddress>,
  go: () -> a / {net.connect_to[db] | e},
) -> a / {clock.write | e} =
  handle {
    go()
  } with {
    net.connect_to[db](to, _options, timeout_ms) -> if dead.contains(to) {
      clock.sleep(millis(timeout_ms));
      Err(TimedOut)
    } else { Ok(7) },
  }

test "a dial is one deadline: an address that does not answer costs its share of what is left" {
  let hosts = [ip::read("192.0.2.5"), ip::read("192.0.2.6"), ip::read("192.0.2.7")];
  let names = dns::with_name(dns::table(), "db.example", hosts);
  let at = |n: Int| hosts.take(n).map(|host: Ip| ip::socket_at(host, 5432));
  simulate {
    let began = clock.now();
    let since = || as_millis(between(began, clock.now()));
    dns::on_table(names, ||
      task::unbounded(|| {
        // The first of three is given a third, and the second answers.
        assert_eq(unanswered(at(1), || dial[db]("db.example", 5432, [], 900)), 7);
        assert_eq(since(), 300);
        // Half of what the first left, then all of what the second left: the deadline and no more.
        let none: Result<Int, Refusal> = try {
          unanswered(at(3), || dial[db]("db.example", 5432, [], 1000))
        };
        assert_eq((none, since()), (Err(TimedOut), 1300));
        // Under a deadline that is earlier than its own, the shares are of that one.
        let held = task::timeout(millis(300), ||
          unanswered(at(1), || dial[db]("db.example", 5432, [], 900)));
        assert_eq((held, since()), (task::Done(7), 1400))
      }))
  }
}

test "a TLS connection by name is dialled, secured, and closed when it does not secure" {
  let names = dns::with_name(dns::table(), "api.example", [ip::read("192.0.2.7")]);
  let world = mem_serving(mem_resolving(mem_empty(), names), ip::read_socket("192.0.2.7:443"), [
    [Upgrades, Says(b"ok")],
    [Refuses(Untrusted)],
  ]);
  let ran = on_mem(world, ||
    simulate {
      task::unbounded(|| {
        let c = dial_tls[api]("api.example", 443, ["h2"], [], 1000);
        let refused: Result<Int, Refusal> = try { dial_tls[api]("api.example", 443, [], [], 1000) };
        { c: c, read: net.recv[api](c, 16, 1000), refused: refused }
      })
    });
  assert_eq(ran.value.read, Some(b"ok"));
  assert_eq(mem_secured(ran.net, ran.value.c), Some("api.example"));
  assert_eq(ran.value.refused, Err(Untrusted));
  assert_eq(ran.net.closed, [2])
}

test "a secured connection's far end presents the certificate its name was given, and none before" {
  let at = ip::read_socket("192.0.2.9:5432");
  let world = mem_presenting(mem_serving(mem_empty(), at, [[Upgrades]]), "db.example", b"leaf");
  let ran = on_mem(world, || {
    let c = dial_address[db](at, [], 1000);
    let before = net.peer_certificate[db](c);
    secure[db](c, "db.example", [], b"", 1000);
    { before: before, after: net.peer_certificate[db](c) }
  });
  assert_eq(ran.value, { before: None, after: Some(b"leaf") })
}

test "a server's connection answers the certificate its client presented, and none for one that presented none" {
  let world = mem_calling(
    mem_calling_presenting(
      mem_credential(mem_empty(), "api"),
      ip::read_socket("198.51.100.4:5000"),
      b"client leaf",
      [],
    ),
    ip::read_socket("198.51.100.5:5000"),
    [],
  );
  let ran = on_mem(world, || {
    let l = net.listen_tls[web](0, "api");
    let first = net.accept[web](l);
    let second = net.accept[web](l);
    [net.peer_certificate[web](first), net.peer_certificate[web](second)]
  });
  assert_eq(ran.value, [Some(b"client leaf"), None])
}

test "the program's own listener sees the certificate its client presents, and none from one presenting none" {
  let world = mem_presenting(mem_credential(mem_empty(), "api"), "caller", b"caller leaf");
  let ran = on_mem(world, || {
    let here = ip::read_socket("127.0.0.1:8443");
    let l = listening[listener](here, []);
    let presenting = dial_address[client](here, [Presenting("caller")], 1000);
    let later = dial_address[client](here, [], 1000);
    let anonymous = dial_address[client](here, [], 1000);
    let set = net.set_option[client](later, Presenting("caller"));
    let served = [presenting, later, anonymous].map(|_c: Int| {
      let c = net.accept[listener](l);
      let _secured = net.serve_tls[listener](c, "api", [], b"", 1000);
      net.peer_certificate[listener](c)
    });
    { set: set, served: served, options: net.options[client](presenting) }
  });
  assert_eq(ran.value.set, Ok(()));
  assert_eq(ran.value.served, [Some(b"caller leaf"), Some(b"caller leaf"), None]);
  assert_eq(ran.value.options, [NoDelay(true)])
}

test "a secured connection says which protocol its handshake agreed, and a plaintext one none" {
  let at = ip::read_socket("192.0.2.9:443");
  let ran = on_mem(mem_serving(mem_empty(), at, [[Upgrades]]), || {
    let c = dial_address[web](at, [], 1000);
    let before = net.protocol[web](c);
    let secured = secure[web](c, "web.example", ["h2", "http/1.1"], b"", 1000);
    { before: before, secured: secured.protocol, after: net.protocol[web](c) }
  });
  assert_eq(ran.value, { before: None, secured: Some("h2"), after: Some("h2") })
}

test "a socket keeps the options it was opened with and the ones set on it since" {
  let probing = {
    idle: Duration(60000000000),
    interval: Some(Duration(10000000000)),
    count: Some(3),
  };
  let ran = on_mem(relayed([]), || {
    let c = match net.connect_to[relay](
        ip::read_socket("192.0.2.25:25"),
        [KeepAlive(Some(probing)), NoDelay(false)],
        1000,
      ) {
      Ok(c) -> c,
      Err(_) -> panic("the relay refused"),
    };
    let opened = net.options[relay](c);
    let set = net.set_option[relay](c, Linger(Some(Duration(0))));
    let l = listening[listener](ip::read_socket("127.0.0.1:0"), [ReusePort(true)]);
    { opened: opened, set: set, now: net.options[relay](c), listener: net.options[listener](l) }
  });
  assert_eq(ran.value.opened, [KeepAlive(Some(probing)), NoDelay(false)]);
  assert_eq(ran.value.set, Ok(()));
  assert_eq(ran.value.now, [KeepAlive(Some(probing)), NoDelay(false), Linger(Some(Duration(0)))]);
  assert_eq(ran.value.listener, [ReuseAddress(true), ReusePort(true)])
}

test "a Unix socket is a path one listener holds until it closes, and its far end has an owner" {
  let who = { user: 501, group: 20, process: Some(4242) };
  let world = mem_serving_unix(
    mem_calling_unix(mem_empty(), who, [Says(b"hello")]),
    "run",
    "docker.sock",
    [[Says(b"{}")]],
  );
  let ran = on_mem(world, || {
    let l = listening_unix[listener]("run", "app.sock");
    let twice = net.listen_unix[listener]("run", "app.sock");
    let taken = net.listen_unix[listener]("run", "docker.sock");
    let mine = dial_unix[client]("run", "app.sock", 1000);
    let joined = net.accept[listener](l);
    let scripted = net.accept[listener](l);
    let docker = dial_unix[client]("run", "docker.sock", 1000);
    net.close[listener](l);
    {
      twice: twice,
      taken: taken,
      nobody: net.connect_unix[client]("run", "absent.sock", 1000),
      ends: [net.peer_address[client](mine), net.local_address[conn](joined)],
      owners: [net.peer_credentials[conn](joined), net.peer_credentials[conn](scripted)],
      read: [net.recv[conn](scripted, 64, 1000), net.recv[client](docker, 64, 1000)],
      again: net.listen_unix[listener]("run", "app.sock"),
    }
  });
  assert_eq(ran.value.twice, Err(AddressInUse));
  assert_eq(ran.value.taken, Err(AddressInUse));
  assert_eq(ran.value.nobody, Err(Refused));
  assert_eq(ran.value.ends, [None, None]);
  assert_eq(ran.value.owners, [None, Some(who)]);
  assert_eq(ran.value.read, [Some(b"hello"), Some(b"{}")]);
  // The path was free again once its listener closed.
  assert_eq(ran.value.again, Ok(6))
}

test "a connection is read and written as streams, and its hold closes it" {
  let script = [Hears(b"PING\n"), HearsEnd, Says(b"one\ntw"), Says(b"o\nthree")];
  let ran = on_mem(relayed(script), || {
    let c = to_relay();
    with_hold[conn](
      reading[relay](c, 1000),
      io::shut,
    ) { source -> {
      with_hold[out](writing[relay](c, 1000), io::shut_sink) { sink -> io::write(sink, b"PING\n") };
      io::fold_lines(source, 4, 1024, [], |lines: List<Bytes>, line: Bytes| lines.push(line))
    } }
  });
  assert_eq(ran.value, [b"one", b"two", b"three"]);
  assert_eq(mem_unmet(ran.net, 1), []);
  assert_eq(ran.net.closed, [1])
}

test "a stream's deadline is raised, and its connection is still closed" {
  let ran = on_mem(relayed([Says(b"partial"), Stalls]), || {
    let c = to_relay();
    let read: Result<Bytes, Refusal> = try[socket.refused] {
      with_hold[conn](
        reading[relay](c, 1000),
        io::shut,
      ) { source -> io::read_all(source, 64, 1024) }
    };
    read
  });
  assert_eq(ran.value, Err(TimedOut));
  assert_eq(ran.net.closed, [1])
}

test "the twin refuses {c.what} in the host's words" for c: { misuse: String, what: String, says: String } in [
    {
      misuse: "label",
      what: "a socket under two labels",
      says: "socket 1 is being used as `net[other]` and `net[relay]`",
    },
    { misuse: "closed", what: "a closed socket", says: "there is no open socket with handle 1" },
    {
      misuse: "deadline",
      what: "a deadline of zero",
      says: "`net.recv` was given a timeout of 0 milliseconds",
    },
    { misuse: "nothing", what: "an empty payload", says: "`net.send` was given an empty payload" },
    {
      misuse: "no secret",
      what: "an empty credential in an empty frame",
      says: "`net.send_secret` was given an empty payload",
    },
    {
      misuse: "encoding",
      what: "a credential in an encoding it does not write",
      says: "`net.send_secret` knows no encoding `rot13`",
    },
    { misuse: "none", what: "a read of no bytes", says: "`net.recv` was asked for 0 bytes" },
    {
      misuse: "listener",
      what: "a read of a listener",
      says: "socket 2 is a listener, and this operation wants a connection",
    },
    {
      misuse: "accept",
      what: "an accept on a connection",
      says: "socket 1 is a connection, and `net.accept` wants a listener",
    },
    {
      misuse: "bound",
      what: "a port already bound",
      says: "`net.listen` could not bind 127.0.0.1:8080: address in use",
    },
    {
      misuse: "twice",
      what: "a second upgrade",
      says: "`net.start_tls` cannot secure socket 1: it is already TLS",
    },
  ] {
  let failed: Result<Unit, String> = try[abort.raise] {
    on_mem(relayed([Upgrades]), || {
      let conn = to_relay();
      if c.misuse == "label" { net.close[other](conn) } else if c.misuse == "closed" {
        net.close[relay](conn);
        net.close[relay](conn)
      } else if c.misuse == "deadline" {
        let _read = net.recv[relay](conn, 16, 0);
        ()
      } else if c.misuse == "nothing" {
        let _sent = net.send[relay](conn, b"", 1000);
        ()
      } else if c.misuse == "no secret" {
        let _sent = net.send_secret[relay](conn, b"", Secret::of_bytes(b""), "raw", b"", 1000);
        ()
      } else if c.misuse == "encoding" {
        let _sent = net.send_secret[relay](conn, b"", Secret::of_bytes(b"k"), "rot13", b"", 1000);
        ()
      } else if c.misuse == "none" {
        let _read = net.recv[relay](conn, 0, 1000);
        ()
      } else if c.misuse == "listener" {
        let _read = net.recv[listener](net.listen[listener](8080), 16, 1000);
        ()
      } else if c.misuse == "accept" {
        let _taken = net.accept[relay](conn);
        ()
      } else if c.misuse == "bound" {
        let _first = net.listen[listener](8080);
        let _second = net.listen[listener](8080);
        ()
      } else {
        let _once = net.start_tls[relay](conn, "mail.example", [], b"", 1000);
        let _twice = net.start_tls[relay](conn, "mail.example", [], b"", 1000);
        ()
      }
    }).value
  };
  assert_eq(failed, Err(c.says))
}

// One definition serves two resources: a clause naming one label never sees the other's bytes.
test "the loops run under whichever label the caller fills" {
  let written = handle {
    assert(send_all[upstream](1, b"hello", 1000));
    assert_eq(drain[upstream](1, b"", 1000), b"hi")
  } with {
    var written = b"",
    var inbox = [b"hi", b""],
    net.send[upstream](c, payload, timeout_ms) -> {
      written = written.concat(payload);
      Some(payload.len())
    },
    net.recv[upstream](c, max, timeout_ms) -> {
      let queued = inbox;
      inbox = tail(queued);
      Some(head(queued))
    },
    return u -> written,
  };
  assert_eq(written, b"hello")
}
