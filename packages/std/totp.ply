//! One-time passwords: HOTP as RFC 4226 defines it, TOTP as RFC 6238 does, and the `otpauth://`
//! URIs an authenticator app is provisioned with.
//!
//! A code is an HMAC of a counter under a shared key, truncated to a few decimal digits. In HOTP
//! the counter is a count both sides keep. In TOTP it is the current time in steps, which `step_at`
//! computes from an `Instant` taken as nanoseconds since 1970-01-01T00:00:00Z, as `std.date` writes
//! it. The time is always an argument: nothing here reads a clock.
//!
//! `verify` returns the step whose code was typed, not a `Bool`, because a code is valid only once.
//! The caller stores the step it accepted for a key and passes it back as `last`, and
//! `verify_after` then rejects that step and every step before it. That record, and a count of
//! failed attempts to slow down a guesser, are the caller's state, and both RFCs require them.
//!
//! A key that makes or checks codes is a `Secret`, and the runtime computes the HMAC under it.
//! `sealed_key` reads one from a sealed base32 text, as a configuration stores it. A key being
//! provisioned is `Bytes`, because a provisioning URI contains the key in the clear, for a person
//! to scan: `new_key` creates one, `uri` writes it, and neither belongs in a log. A code can be
//! made for a key of any length, because an authenticator accepts whatever key it is given and many
//! services give ten bytes. RFC 4226 requires at least sixteen and recommends twenty, which is what
//! `new_key` creates, and `uri` raises for a key under sixteen.
//!
//! Many authenticator apps make six-digit SHA-1 codes every thirty seconds whatever a URI requests,
//! so `standard` is the only form that every app supports.

import std.base32
import std.bytes (u64_be)
import std.hash (hmac_sha256, hmac_sha512, tags_match)
import std.hash.legacy (hmac_sha1)
import std.laws (agrees)
import std.list
import std.math (max_int, pow)
import std.random (entropy, token_bytes)
import std.string
import std.time (as_nanos, nanos_at, seconds)
import std.url (Pair, query_parse, url_decode, url_encode)
import std.gen

/// The hash function a code's HMAC uses.
pub type Algorithm = | Sha1 | Sha256 | Sha512

/// How a code is made from an HMAC: which hash, and how many decimal digits, from six to ten.
/// RFC 4226 defines six, seven and eight. Truncation leaves thirty-one bits, which is less than ten
/// full digits: a ten-digit code starts with 0, 1 or 2 and carries only those thirty-one bits.
pub type CodeFormat = new { algorithm: Algorithm, digits: Int }

/// How TOTP makes its codes: their form, how long a step lasts, and the instant steps count from.
pub type Config = new { form: CodeFormat, step: Duration, epoch: Instant }

/// How far from the current step a verifier looks: whole steps before and after it, where a count
/// below zero means none. One step either way allows for a slow clock and a slow typist; each extra
/// step is one more code that passes.
pub type Window = new { before: Int, after: Int }

/// Whether an account's codes follow the clock or a count.
pub type Kind =
  /// Time-based, with how long a step lasts: whole seconds, at least one.
  | TimeBased(Duration)
  /// Counter-based, with the counter its next code is made at.
  | CounterBased(Int)

/// What a provisioning URI gives an authenticator: whose key it is, the key, and how its codes are
/// made.
pub type Provision = new {
  kind: Kind,
  /// Who the account is with, or empty for no one. It contains no colon.
  issuer: String,
  /// The account's name. It contains no colon and does not start with a space.
  account: String,
  key: Bytes,
  form: CodeFormat,
}

/// Why a text is not a provisioning URI.
pub type ErrorKind =
  /// It does not start with `otpauth://`.
  | NotOtpauth
  /// Its type, which is neither `totp` nor `hotp`.
  | UnknownKind(String)
  /// Its label is not percent-encoded UTF-8, or contains more than one colon.
  | BadLabel
  /// Its query is not percent-encoded `name=value` pairs.
  | BadQuery
  /// It gives this parameter more than once.
  | DuplicateParameter(String)
  /// It has no `secret`, or an empty one.
  | NoSecret
  /// Its `secret` is not base32.
  | BadSecret
  /// Its label and its `issuer` parameter name different issuers.
  | TwoIssuers
  /// This parameter has a value it cannot take.
  | BadValue(String)
  /// It is a `hotp` URI with no `counter`.
  | NoCounter

/// Why a function here failed, with the value it rejected.
pub type Error =
  /// A count of digits outside six to ten.
  | Digits(Int)
  /// A counter below zero.
  | Counter(Int)
  /// A step that is not above zero, or one a URI cannot express because it is not whole seconds.
  | Step(Duration)
  /// A reading before the epoch, or further past it than an `Int` of nanoseconds.
  | TimeOutOfRange(Instant)
  /// A key to provision that is this many bytes long, under sixteen.
  | ShortKey(Int)
  /// An issuer or an account a label cannot contain: one with a colon, or an account that starts
  /// with a space.
  | Label(String)
  /// A text that is not a provisioning URI.
  | Malformed(ErrorKind)

/// The effect this module's functions raise when they fail.
pub effect totp {
  /// A parameter is outside what the function defines, or a text is not a provisioning URI.
  raise fail(e: Error)
}

/// SHA-1 codes of six digits, a step of thirty seconds, counted from the Unix epoch.
pub fn standard() -> Config =
  { form: { algorithm: Sha1, digits: 6 }, step: seconds(30), epoch: Instant(0) }

/// Twenty bytes of the operating system's entropy: the key size RFC 4226 recommends. It is plain
/// `Bytes` so it can be provisioned; whatever checks codes afterwards stores `Secret::of_bytes` of
/// it.
pub fn new_key() -> Bytes / {entropy.next, abort.raise} = token_bytes(20)

/// The key in a sealed `secret`, read as a person would type it: base32 in either case, with or
/// without spaces, hyphens and padding. Raises `Malformed(BadSecret)` for any other text and
/// `Malformed(NoSecret)` for an empty one, and reveals nothing more about either.
pub fn sealed_key(secret: Secret<String>) -> Secret<Bytes> / {totp.fail, abort.raise} = {
  let key = required(base32::decode_typed_secret(secret), BadSecret);
  if key.is_empty() { malformed(NoSecret) } else { key }
}

// --- Codes ------------------------------------------------------------------

/// The HOTP code of `counter` under `key`: `form.digits` decimal digits, with leading zeros. Raises
/// for a count of digits outside six to ten and for a counter below zero.
pub fn hotp(
  form: CodeFormat,
  key: Secret<Bytes>,
  counter: Int,
) -> String / {totp.fail, abort.raise} =
  if form.digits < 6 || form.digits > 10 { totp.fail(Digits(form.digits)) }
  else if counter < 0 { totp.fail(Counter(counter)) } else {
    let mac = match form.algorithm {
      Sha1 -> hmac_sha1(key, u64_be(counter)),
      Sha256 -> hmac_sha256(key, u64_be(counter)),
      Sha512 -> hmac_sha512(key, u64_be(counter)),
    };
    let at = mac.at(mac.len() - 1) & 0x0F;
    let cut = (mac.at(at) & 0x7F) << 24 | mac.at(at + 1) << 16 | mac.at(at + 2) << 8
      | mac.at(at + 3);
    Int::to_string(cut % pow(10, form.digits)).pad_left(form.digits, "0")
  }

/// The step `now` falls in: whole steps of `c.step` since `c.epoch`. Raises for a step that is
/// not above zero and for a reading before the epoch.
pub fn step_at(c: Config, now: Instant) -> Int / {totp.fail} = {
  let step = as_nanos(c.step);
  if step < 1 { totp.fail(Step(c.step)) } else {
    match checked_sub(nanos_at(now), nanos_at(c.epoch)) {
      Some(since) -> if since < 0 { totp.fail(TimeOutOfRange(now)) } else { since / step },
      None -> totp.fail(TimeOutOfRange(now)),
    }
  }
}

/// The TOTP code at `now`: the HOTP code of the step `now` falls in. Raises as `hotp` and
/// `step_at` do.
pub fn code(c: Config, key: Secret<Bytes>, now: Instant) -> String / {totp.fail, abort.raise} =
  hotp(c.form, key, step_at(c, now))

// --- Verifying --------------------------------------------------------------

/// The step whose code is `typed`, among the steps of `window` around the step `now` falls in, or
/// `None` when no step in the window matches. `typed` is the digits alone.
///
/// When two steps in the window have the same code, the later one is returned, so storing the
/// result invalidates every earlier code. Every step in the window is computed and compared as
/// `std.hash`'s `tags_match` compares, whichever one matches. So the work done depends only on the
/// window and on lengths, not on where a guess goes wrong. Raises as `code` does.
pub fn verify(
  c: Config,
  key: Secret<Bytes>,
  typed: String,
  now: Instant,
  window: Window,
) -> Option<Int> / {totp.fail, abort.raise} = verify_after(c, key, typed, now, window, None)

/// `verify`, but never returning a step at or before `last`, the step last accepted for this key. A
/// code already used, and any older one, gives `None`. Store the result as the next `last`.
pub fn verify_after(
  c: Config,
  key: Secret<Bytes>,
  typed: String,
  now: Instant,
  window: Window,
  last: Option<Int>,
) -> Option<Int> / {totp.fail, abort.raise} =
  latest_match(c.form, key, typed, around(step_at(c, now), window), last)

/// The counter whose HOTP code is `typed`, among `counter` and the `ahead` counters after it, or
/// `None`. As in `verify`, the later of two counters with the same code is returned, and every
/// counter is computed and compared. A server stores the result plus one as its next counter.
/// Raises as `hotp` does.
pub fn hotp_verify(
  form: CodeFormat,
  key: Secret<Bytes>,
  typed: String,
  counter: Int,
  ahead: Int,
) -> Option<Int> / {totp.fail, abort.raise} =
  latest_match(form, key, typed, around(counter, { before: 0, after: ahead }), None)

/// The steps of a window around `at`, earliest first, without those below zero or past an `Int`.
fn around(at: Int, window: Window) -> List<Int> =
  range(0 - max(window.before, 0), max(window.after, 0) + 1).fold([], |steps: List<Int>, by: Int|
    match checked_add(at, by) {
      Some(step) -> if step < 0 { steps } else { steps.push(step) },
      None -> steps,
    })

/// The last of `counters` past `last` whose code is `typed`.
fn latest_match(
  form: CodeFormat,
  key: Secret<Bytes>,
  typed: String,
  counters: List<Int>,
  last: Option<Int>,
) -> Option<Int> / {totp.fail, abort.raise} = {
  let wanted = Bytes::of_string(typed);
  counters.fold(None, |found: Option<Int>, counter: Int| {
    let same = tags_match(Bytes::of_string(hotp(form, key, counter)), wanted);
    let fresh = is_after_last(counter, last);
    if same && fresh { Some(counter) } else { found }
  })
}

fn is_after_last(counter: Int, last: Option<Int>) -> Bool =
  match last { Some(accepted) -> counter > accepted, None -> true }

// --- Provisioning URIs ------------------------------------------------------

/// The `otpauth://` URI of `p`, in Google Authenticator's key URI format: the type, the label
/// `issuer:account`, then `secret` in unpadded base32, `issuer`, `algorithm`, `digits`, and
/// `period` or `counter`, each written out. Raises for a key under sixteen bytes, a count of digits
/// outside six to ten, a step that is not whole seconds or is under one second, a counter below
/// zero, and an issuer or account the label cannot contain.
pub fn uri(p: Provision) -> String / {totp.fail, abort.raise} =
  if p.key.len() < 16 { totp.fail(ShortKey(p.key.len())) }
  else if p.form.digits < 6 || p.form.digits > 10 { totp.fail(Digits(p.form.digits)) }
  else if p.issuer.contains(":") { totp.fail(Label(p.issuer)) }
  else if p.account.contains(":") || p.account.starts_with(" ") { totp.fail(Label(p.account)) }
  else {
    "otpauth://" ++ kind_name(p.kind) ++ "/" ++ label_of(p.issuer, p.account) ++ "?secret="
      ++ base32::encode_unpadded(p.key)
      ++ (if p.issuer == "" { "" } else { "&issuer=" ++ url_encode(p.issuer) })
      ++ "&algorithm="
      ++ algorithm_name(p.form.algorithm)
      ++ "&digits="
      ++ p.form.digits.to_string()
      ++ kind_parameter(p.kind)
  }

/// What `text` provisions. Raises `totp.fail` where `try_parse_uri` returns `Err`.
///
/// `algorithm`, `digits` and `period` may be left out, and then default to SHA-1, six and thirty
/// seconds. A `secret` is read as typed: in either case, with or without its padding. A parameter
/// this format does not define is ignored, and one it defines may appear only once.
pub fn parse_uri(text: String) -> Provision / {totp.fail, abort.raise} = {
  let scheme = "otpauth://";
  if !text.starts_with(scheme) { malformed(NotOtpauth) } else {
    let rest = text.slice(scheme.len(), text.len());
    let slash = if rest.contains("/") { rest.find("/") } else { rest.len() };
    let tail = rest.slice(min(slash + 1, rest.len()), rest.len());
    let mark = if tail.contains("?") { tail.find("?") } else { tail.len() };
    let query = tail.slice(min(mark + 1, tail.len()), tail.len());
    let timed = is_timed(rest.slice(0, slash));
    let named = label_parts(required(url_decode(tail.slice(0, mark)), BadLabel));
    let pairs = required(query_parse(query), BadQuery);
    let key = key_of(parameter(pairs, "secret"));
    let issuer = issuer_of(named.issuer, parameter(pairs, "issuer"));
    let algorithm = algorithm_of(parameter(pairs, "algorithm"));
    let digits = digits_of(pairs);
    {
      kind: if timed { TimeBased(period_of(pairs)) }
      else { CounterBased(required(number(pairs, "counter", 0), NoCounter)) },
      issuer: issuer,
      account: named.account,
      key: key,
      form: { algorithm: algorithm, digits: digits },
    }
  }
}

/// What `text` provisions, or why it is not a provisioning URI.
pub fn try_parse_uri(text: String) -> Result<Provision, Error> / {abort.raise} =
  try { parse_uri(text) }

/// How a provisioned account's codes are made, for one that follows the clock from the Unix
/// epoch; `None` for a counter-based one.
pub fn config_of(p: Provision) -> Option<Config> =
  match p.kind {
    TimeBased(step) -> Some({ form: p.form, step: step, epoch: Instant(0) }),
    CounterBased(_) -> None,
  }

fn malformed<a>(reason: ErrorKind) -> a / {totp.fail} = totp.fail(Malformed(reason))

fn required<a>(found: Option<a>, reason: ErrorKind) -> a / {totp.fail} =
  match found { Some(x) -> x, None -> malformed(reason) }

fn kind_name(k: Kind) -> String = match k { TimeBased(_) -> "totp", CounterBased(_) -> "hotp" }

fn kind_parameter(k: Kind) -> String / {totp.fail} =
  match k {
    TimeBased(step) -> if as_nanos(step) < 1 || as_nanos(step) % 1000000000 != 0 {
      totp.fail(Step(step))
    } else { "&period=" ++ Int::to_string(as_nanos(step) / 1000000000) },
    CounterBased(counter) -> if counter < 0 { totp.fail(Counter(counter)) }
    else { "&counter=" ++ counter.to_string() },
  }

fn algorithm_name(a: Algorithm) -> String =
  match a { Sha1 -> "SHA1", Sha256 -> "SHA256", Sha512 -> "SHA512" }

fn label_of(issuer: String, account: String) -> String / {abort.raise} =
  if issuer == "" { url_encode(account) } else { url_encode(issuer) ++ ":" ++ url_encode(account) }

/// A decoded label's two names: the issuer before its colon, if it has one, and the account
/// after it without the spaces that may follow the colon.
fn label_parts(
  label: String,
) -> { issuer: Option<String>, account: String } / {totp.fail, abort.raise} =
  match label.split(":") {
    [account] -> { issuer: None, account: account },
    [issuer, account] ->
      { issuer: Some(issuer), account: account.slice(skip_spaces(account, 0), account.len()) },
    _ -> malformed(BadLabel),
  }

/// Where the spaces that start at `at` end.
fn skip_spaces(text: String, at: Int) -> Int / {abort.raise} =
  if at >= text.len() { at }
  else if text.slice(at, at + 1) == " " { skip_spaces(text, at + 1) }
  else { at }

/// The one value `pairs` gives `name`, or `None` when they give none.
fn parameter(pairs: List<Pair>, name: String) -> Option<String> / {totp.fail} =
  match pairs.filter(|p: Pair| p.name == name) {
    [] -> None,
    [only] -> Some(only.value),
    _ -> malformed(DuplicateParameter(name)),
  }

fn issuer_of(labelled: Option<String>, given: Option<String>) -> String / {totp.fail} =
  match labelled {
    None -> match given { Some(issuer) -> issuer, None -> "" },
    Some(issuer) -> match given {
      Some(other) -> if other == issuer { issuer } else { malformed(TwoIssuers) },
      None -> issuer,
    },
  }

fn key_of(secret: Option<String>) -> Bytes / {totp.fail, abort.raise} = {
  let key = required(
    base32::decode_unpadded(base32::normalize(required(secret, NoSecret))),
    BadSecret,
  );
  if key.len() == 0 { malformed(NoSecret) } else { key }
}

fn algorithm_of(given: Option<String>) -> Algorithm / {totp.fail} =
  match given {
    None -> Sha1,
    Some(name) -> {
      let upper = name.ascii_upper();
      if upper == "SHA1" { Sha1 }
      else if upper == "SHA256" { Sha256 }
      else if upper == "SHA512" { Sha512 }
      else { malformed(BadValue("algorithm")) }
    },
  }

/// The whole number `pairs` give `name`, which must be at least `least`; `None` when they give
/// none.
fn number(pairs: List<Pair>, name: String, least: Int) -> Option<Int> / {totp.fail, abort.raise} =
  match parameter(pairs, name) {
    None -> None,
    Some(text) -> match text.int_of_string() {
      Some(n) -> if n < least { malformed(BadValue(name)) } else { Some(n) },
      None -> malformed(BadValue(name)),
    },
  }

fn digits_of(pairs: List<Pair>) -> Int / {totp.fail, abort.raise} =
  match number(pairs, "digits", 6) {
    None -> 6,
    Some(n) -> if n > 10 { malformed(BadValue("digits")) } else { n },
  }

/// Whether a URI's type is `totp`, where `hotp` is the other.
fn is_timed(name: String) -> Bool / {totp.fail} =
  if name == "totp" { true } else if name == "hotp" { false } else { malformed(UnknownKind(name)) }

fn period_of(pairs: List<Pair>) -> Duration / {totp.fail, abort.raise} =
  match number(pairs, "period", 1) {
    None -> seconds(30),
    Some(n) -> match checked_mul(n, 1000000000) {
      Some(nanoseconds) -> Duration(nanoseconds),
      None -> malformed(BadValue("period")),
    },
  }

// --- Tests ------------------------------------------------------------------

/// The key of RFC 4226's vectors, and of RFC 6238's for SHA-1.
fn rfc_key() -> Bytes = b"12345678901234567890"

type CounterVector = { counter: Int, cut: Int, code: String }

/// RFC 4226, appendix D: each counter's thirty-one bits and its six digits.
fn rfc_4226() -> List<CounterVector> =
  [
    { counter: 0, cut: 1284755224, code: "755224" },
    { counter: 1, cut: 1094287082, code: "287082" },
    { counter: 2, cut: 137359152, code: "359152" },
    { counter: 3, cut: 1726969429, code: "969429" },
    { counter: 4, cut: 1640338314, code: "338314" },
    { counter: 5, cut: 868254676, code: "254676" },
    { counter: 6, cut: 1918287922, code: "287922" },
    { counter: 7, cut: 82162583, code: "162583" },
    { counter: 8, cut: 673399871, code: "399871" },
    { counter: 9, cut: 645520489, code: "520489" },
  ]

test "RFC 4226's code at counter {c.counter}" for c: CounterVector in rfc_4226() {
  assert_eq(hotp({ algorithm: Sha1, digits: 6 }, Secret::of_bytes(rfc_key()), c.counter), c.code);
  // Ten digits show the whole truncated value, with leading zeros.
  assert_eq(
    hotp({ algorithm: Sha1, digits: 10 }, Secret::of_bytes(rfc_key()), c.counter),
    c.cut.to_string().pad_left(10, "0"),
  )
}

type TimeVector = { algorithm: Algorithm, at: Int, code: String }

/// RFC 6238, appendix B: eight digits, a step of thirty seconds from the Unix epoch.
fn rfc_6238() -> List<TimeVector> =
  [
    { algorithm: Sha1, at: 59, code: "94287082" },
    { algorithm: Sha256, at: 59, code: "46119246" },
    { algorithm: Sha512, at: 59, code: "90693936" },
    { algorithm: Sha1, at: 1111111109, code: "07081804" },
    { algorithm: Sha256, at: 1111111109, code: "68084774" },
    { algorithm: Sha512, at: 1111111109, code: "25091201" },
    { algorithm: Sha1, at: 1111111111, code: "14050471" },
    { algorithm: Sha256, at: 1111111111, code: "67062674" },
    { algorithm: Sha512, at: 1111111111, code: "99943326" },
    { algorithm: Sha1, at: 1234567890, code: "89005924" },
    { algorithm: Sha256, at: 1234567890, code: "91819424" },
    { algorithm: Sha512, at: 1234567890, code: "93441116" },
    { algorithm: Sha1, at: 2000000000, code: "69279037" },
    { algorithm: Sha256, at: 2000000000, code: "90698825" },
    { algorithm: Sha512, at: 2000000000, code: "38618901" },
    { algorithm: Sha1, at: 20000000000, code: "65353130" },
    { algorithm: Sha256, at: 20000000000, code: "77737706" },
    { algorithm: Sha512, at: 20000000000, code: "47863826" },
  ]

/// The key RFC 6238's vectors use under each hash: the ASCII digits repeated to its digest's
/// length.
fn rfc_6238_key(a: Algorithm) -> Bytes =
  match a {
    Sha1 -> rfc_key(),
    Sha256 -> b"12345678901234567890123456789012",
    Sha512 -> b"1234567890123456789012345678901234567890123456789012345678901234",
  }

test "RFC 6238's {c.algorithm} code at {c.at} seconds" for c: TimeVector in rfc_6238() {
  let config: Config = { ..standard(), form: { algorithm: c.algorithm, digits: 8 } };
  let key = rfc_6238_key(c.algorithm);
  assert_eq(hotp(config.form, Secret::of_bytes(key), c.at / 30), c.code);
  // An `Instant` ends in 2262 and the last vector is in 2603, so that one has only its step.
  if c.at <= max_int() / 1000000000 {
    assert_eq(code(config, Secret::of_bytes(key), at_second(c.at)), c.code)
  }
}

/// `secs` seconds past the Unix epoch.
fn at_second(secs: Int) -> Instant = Instant(secs * 1000000000)

test "a step is thirty seconds from the epoch unless the config says otherwise" {
  assert_eq(step_at(standard(), at_second(0)), 0);
  assert_eq(step_at(standard(), at_second(29)), 0);
  assert_eq(step_at(standard(), at_second(30)), 1);
  assert_eq(step_at(standard(), at_second(1111111109)), 0x23523EC);
  let late: Config = { ..standard(), step: seconds(60), epoch: at_second(100) };
  assert_eq(step_at(late, at_second(100)), 0);
  assert_eq(step_at(late, at_second(220)), 2)
}

test "a form, a counter, a step or a reading outside what is defined is rejected by name" {
  let five = try { hotp({ algorithm: Sha1, digits: 5 }, Secret::of_bytes(rfc_key()), 0) };
  assert_eq(five, Err(Digits(5)));
  let eleven = try { hotp({ algorithm: Sha1, digits: 11 }, Secret::of_bytes(rfc_key()), 0) };
  assert_eq(eleven, Err(Digits(11)));
  let negative = try { hotp({ algorithm: Sha1, digits: 6 }, Secret::of_bytes(rfc_key()), 0 - 1) };
  assert_eq(negative, Err(Counter(0 - 1)));
  let still: Config = { ..standard(), step: seconds(0) };
  assert_eq(try { step_at(still, at_second(5)) }, Err(Step(seconds(0))));
  assert_eq(try { step_at(standard(), at_second(0 - 1)) }, Err(TimeOutOfRange(at_second(0 - 1))));
  let far: Config = { ..standard(), epoch: Instant(0 - max_int()) };
  assert_eq(try { step_at(far, Instant(max_int())) }, Err(TimeOutOfRange(Instant(max_int()))))
}

test "a code verifies in its window and nowhere else" {
  let made = at_second(1111111109);
  let typed = code(standard(), Secret::of_bytes(rfc_key()), made);
  let exact: Window = { before: 0, after: 0 };
  let either: Window = { before: 1, after: 1 };
  assert_eq(typed, "081804");
  assert_eq(verify(standard(), Secret::of_bytes(rfc_key()), typed, made, exact), Some(0x23523EC));
  assert_eq(
    verify(standard(), Secret::of_bytes(rfc_key()), typed, at_second(1111111139), exact),
    None,
  );
  assert_eq(
    verify(standard(), Secret::of_bytes(rfc_key()), typed, at_second(1111111139), either),
    Some(0x23523EC),
  );
  assert_eq(
    verify(standard(), Secret::of_bytes(rfc_key()), typed, at_second(1111111079), either),
    Some(0x23523EC),
  );
  assert_eq(
    verify(standard(), Secret::of_bytes(rfc_key()), typed, at_second(1111111169), either),
    None,
  );
  assert_eq(verify(standard(), Secret::of_bytes(rfc_key()), "81804", made, either), None);
  assert_eq(verify(standard(), Secret::of_bytes(rfc_key()), "", made, either), None)
}

test "a code accepted once is rejected the second time, and so is an older one" {
  let now = at_second(1111111109);
  let either: Window = { before: 1, after: 1 };
  let typed = code(standard(), Secret::of_bytes(rfc_key()), now);
  let first = verify_after(standard(), Secret::of_bytes(rfc_key()), typed, now, either, None);
  assert_eq(first, Some(0x23523EC));
  assert_eq(verify_after(standard(), Secret::of_bytes(rfc_key()), typed, now, either, first), None);
  let older = code(standard(), Secret::of_bytes(rfc_key()), at_second(1111111079));
  assert_eq(verify_after(standard(), Secret::of_bytes(rfc_key()), older, now, either, first), None);
  assert_eq(
    verify_after(standard(), Secret::of_bytes(rfc_key()), older, now, either, None),
    Some(0x23523EB),
  )
}

test "a counter-based code verifies within the look-ahead, and the counter it was made at is returned" {
  let form: CodeFormat = { algorithm: Sha1, digits: 6 };
  assert_eq(hotp_verify(form, Secret::of_bytes(rfc_key()), "969429", 0, 5), Some(3));
  assert_eq(hotp_verify(form, Secret::of_bytes(rfc_key()), "969429", 3, 0), Some(3));
  assert_eq(hotp_verify(form, Secret::of_bytes(rfc_key()), "969429", 0, 2), None);
  assert_eq(hotp_verify(form, Secret::of_bytes(rfc_key()), "969429", 4, 5), None)
}

test "a new key is twenty bytes of the entropy it is given" {
  let key = handle { new_key() } with { entropy.next() -> 0x0706_0504_0302_0100 };
  assert_eq(key.len(), 20);
  assert_eq(key.slice(0, 8), b"\x00\x01\x02\x03\x04\x05\x06\x00")
}

/// Google Authenticator's own example key: `Hello!` and four bytes more.
fn hello() -> Bytes = b"Hello!\xDE\xAD\xBE\xEF"

test "a sealed secret is read as typed, and an error reveals only that it is not one" {
  let read = |text: String| try { sealed_key(Secret::of_string(text)) };
  assert_eq(read("jbsw y3dp-ehpk 3pxp"), Ok(Secret::of_bytes(hello())));
  assert_eq(read("JBSWY3DPEHPK3PXP===="), Ok(Secret::of_bytes(hello())));
  assert_eq(read(""), Err(Malformed(NoSecret)));
  assert_eq(read(" - "), Err(Malformed(NoSecret)));
  assert_eq(read("JBSWY3DPEHPK3PX1"), Err(Malformed(BadSecret)));
  assert_eq(read("J"), Err(Malformed(BadSecret)));
  // RFC 4226, appendix D: the key `12345678901234567890`, sealed, at count zero.
  assert_eq(
    try {
      hotp(
        { algorithm: Sha1, digits: 6 },
        sealed_key(Secret::of_string("GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ")),
        0,
      )
    },
    Ok("755224"),
  )
}

test "the key URI format's examples are read as it reads them" {
  assert_eq(
    try_parse_uri("otpauth://totp/Example:alice@google.com?secret=JBSWY3DPEHPK3PXP&issuer=Example"),
    Ok({
      kind: TimeBased(seconds(30)),
      issuer: "Example",
      account: "alice@google.com",
      key: hello(),
      form: { algorithm: Sha1, digits: 6 },
    }),
  );
  assert_eq(
    try_parse_uri(
      "otpauth://totp/ACME%20Co:john.doe@email.com?secret=HXDMVJECJJWSRB3HWIZR4IFUGFTMXBOZ&issuer=ACME%20Co&algorithm=SHA1&digits=6&period=30",
    ),
    Ok({
      kind: TimeBased(seconds(30)),
      issuer: "ACME Co",
      account: "john.doe@email.com",
      key: b"\x3D\xC6\xCA\xA4\x82\x4A\x6D\x28\x87\x67\xB2\x33\x1E\x20\xB4\x31\x66\xCB\x85\xD9",
      form: { algorithm: Sha1, digits: 6 },
    }),
  )
}

test "a URI is read as an app reads one: its defaults, its separators and a typed secret" {
  let read = try_parse_uri(
    "otpauth://hotp/Big%20Co%3A%20%20bob?secret=jbsw%20y3dp-ehpk3pxp%3D%3D&digits=8&algorithm=sha512&counter=7&image=x",
  );
  assert_eq(
    read,
    Ok({
      kind: CounterBased(7),
      issuer: "Big Co",
      account: "bob",
      key: hello(),
      form: { algorithm: Sha512, digits: 8 },
    }),
  );
  assert_eq(
    try_parse_uri("otpauth://totp/bob?secret=JBSWY3DPEHPK3PXP&issuer=Big%20Co&period=60"),
    Ok({
      kind: TimeBased(seconds(60)),
      issuer: "Big Co",
      account: "bob",
      key: hello(),
      form: { algorithm: Sha1, digits: 6 },
    }),
  )
}

type ErrorCase = { text: String, reason: ErrorKind }

fn error_cases() -> List<ErrorCase> =
  [
    { text: "", reason: NotOtpauth },
    { text: "https://totp/a?secret=JBSWY3DPEHPK3PXP", reason: NotOtpauth },
    { text: "otpauth://", reason: UnknownKind("") },
    { text: "otpauth://steam/a?secret=JBSWY3DPEHPK3PXP", reason: UnknownKind("steam") },
    { text: "otpauth://TOTP/a?secret=JBSWY3DPEHPK3PXP", reason: UnknownKind("TOTP") },
    { text: "otpauth://totp/a%ZZ?secret=JBSWY3DPEHPK3PXP", reason: BadLabel },
    { text: "otpauth://totp/a:b:c?secret=JBSWY3DPEHPK3PXP", reason: BadLabel },
    { text: "otpauth://totp/a?secret=JBSWY3DPEHPK3PXP&issuer=%G1", reason: BadQuery },
    {
      text: "otpauth://totp/a?secret=JBSWY3DPEHPK3PXP&secret=JBSWY3DPEHPK3PXP",
      reason: DuplicateParameter("secret"),
    },
    {
      text: "otpauth://totp/a?secret=JBSWY3DPEHPK3PXP&digits=6&digits=8",
      reason: DuplicateParameter("digits"),
    },
    { text: "otpauth://totp/a", reason: NoSecret },
    { text: "otpauth://totp/a?issuer=b", reason: NoSecret },
    { text: "otpauth://totp/a?secret=", reason: NoSecret },
    { text: "otpauth://totp/a?secret=JBSWY3DPEHPK3PX1", reason: BadSecret },
    { text: "otpauth://totp/a?secret=J", reason: BadSecret },
    { text: "otpauth://totp/b:a?secret=JBSWY3DPEHPK3PXP&issuer=c", reason: TwoIssuers },
    {
      text: "otpauth://totp/a?secret=JBSWY3DPEHPK3PXP&algorithm=MD5",
      reason: BadValue("algorithm"),
    },
    { text: "otpauth://totp/a?secret=JBSWY3DPEHPK3PXP&digits=5", reason: BadValue("digits") },
    { text: "otpauth://totp/a?secret=JBSWY3DPEHPK3PXP&digits=11", reason: BadValue("digits") },
    { text: "otpauth://totp/a?secret=JBSWY3DPEHPK3PXP&digits=six", reason: BadValue("digits") },
    { text: "otpauth://totp/a?secret=JBSWY3DPEHPK3PXP&period=0", reason: BadValue("period") },
    {
      text: "otpauth://totp/a?secret=JBSWY3DPEHPK3PXP&period=9223372036854775807",
      reason: BadValue("period"),
    },
    { text: "otpauth://hotp/a?secret=JBSWY3DPEHPK3PXP&counter=-1", reason: BadValue("counter") },
    { text: "otpauth://hotp/a?secret=JBSWY3DPEHPK3PXP", reason: NoCounter },
  ]

test "`{c.text}` is not a provisioning URI" for c: ErrorCase in error_cases() {
  assert_eq(try_parse_uri(c.text), Err(Malformed(c.reason)))
}

/// A provision of the standard form for `issuer` and `account`, under a twenty-byte key.
fn provision(issuer: String, account: String) -> Provision =
  {
    kind: TimeBased(seconds(30)),
    issuer: issuer,
    account: account,
    key: rfc_key(),
    form: { algorithm: Sha1, digits: 6 },
  }

test "a URI writes every parameter, and percent-encodes its names" {
  assert_eq(
    uri(provision("ACME Co", "john.doe@email.com")),
    "otpauth://totp/ACME%20Co:john.doe%40email.com?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&issuer=ACME%20Co&algorithm=SHA1&digits=6&period=30",
  );
  let counted: Provision = {
    ..provision("", "bob"),
    kind: CounterBased(4),
    form: { algorithm: Sha256, digits: 8 },
  };
  assert_eq(
    uri(counted),
    "otpauth://hotp/bob?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&algorithm=SHA256&digits=8&counter=4",
  )
}

test "what a URI cannot contain is rejected by name" {
  let short: Provision = { ..provision("a", "b"), key: b"123456789012345" };
  assert_eq(try { uri(short) }, Err(ShortKey(15)));
  let wide: Provision = { ..provision("a", "b"), form: { algorithm: Sha1, digits: 12 } };
  assert_eq(try { uri(wide) }, Err(Digits(12)));
  assert_eq(try { uri(provision("a:c", "b")) }, Err(Label("a:c")));
  assert_eq(try { uri(provision("a", "b:c")) }, Err(Label("b:c")));
  assert_eq(try { uri(provision("a", " b")) }, Err(Label(" b")));
  let half: Provision = { ..provision("a", "b"), kind: TimeBased(Duration(1500000000)) };
  assert_eq(try { uri(half) }, Err(Step(Duration(1500000000))));
  let still: Provision = { ..provision("a", "b"), kind: TimeBased(seconds(0)) };
  assert_eq(try { uri(still) }, Err(Step(seconds(0))));
  let behind: Provision = { ..provision("a", "b"), kind: CounterBased(0 - 1) };
  assert_eq(try { uri(behind) }, Err(Counter(0 - 1)))
}

test "a time-based provision has a config, and a counter-based one has none" {
  let fast: Provision = { ..provision("a", "b"), kind: TimeBased(seconds(15)) };
  assert_eq(
    config_of(fast),
    Some({ form: { algorithm: Sha1, digits: 6 }, step: seconds(15), epoch: Instant(0) }),
  );
  let counted: Provision = { ..provision("a", "b"), kind: CounterBased(0) };
  assert_eq(config_of(counted), None)
}

// --- Properties -------------------------------------------------------------
//
// Not every combination of field values is a valid value, so each test builds one from a draw.

/// A reading a whole number of seconds past the epoch, at least one step in.
fn sample_instant(ticks: Int) -> Instant = at_second(1000 + (ticks & 0xFFFF_FFFF))

/// A form of six to ten digits under one of the three hashes.
fn form_of(n: Int) -> CodeFormat =
  {
    algorithm: match (n >>> 8 & 0xFF) % 3 { 0 -> Sha1, 1 -> Sha256, _ -> Sha512 },
    digits: 6 + (n & 0xFF) % 5,
  }

/// A `ProvisionInput` as a test draws one.
fn provision_inputs() -> gen::Gen<ProvisionInput> =
  gen::map4(
    gen::text(),
    gen::text(),
    gen::bytes(),
    gen::any_int(),
    |issuer: String, account: String, key: Bytes, n: Int|
      { issuer: issuer, account: account, key: key, n: n },
  )

test "a code verifies while its step is in the window, and not from outside it" {
  gen::check(
    gen::and_then(gen::bytes(), |key: Bytes|
      gen::map4(
        gen::any_int(),
        gen::any_int(),
        gen::any_int(),
        gen::any_int(),
        |ticks: Int, drift: Int, before: Int, after: Int| (key, ticks, drift, before, after),
      )),
    |drawn: (Bytes, Int, Int, Int, Int)| {
      let key = drawn._0;
      let ticks = drawn._1;
      let drift = drawn._2;
      let before = drawn._3;
      let after = drawn._4;
      let made = sample_instant(ticks);
      let by = (drift & 7) - 4;
      let window: Window = { before: before & 3, after: after & 3 };
      let step = step_at(standard(), made);
      let typed = code(standard(), Secret::of_bytes(key), made);
      let later = Instant(nanos_at(made) + by * 30000000000);
      let result = verify(standard(), Secret::of_bytes(key), typed, later, window);
      if by <= window.before && 0 - by <= window.after {
        match result {
          Some(found) ->
            found >= step && hotp(standard().form, Secret::of_bytes(key), found) == typed,
          None -> false,
        }
      } else { result != Some(step) }
    },
  )
}

test "a code accepted once is not accepted again" {
  gen::check4(
    gen::bytes(),
    gen::any_int(),
    gen::any_int(),
    gen::any_int(),
    |key: Bytes, ticks: Int, before: Int, after: Int| {
      let now = sample_instant(ticks);
      let window: Window = { before: before & 3, after: after & 3 };
      let typed = code(standard(), Secret::of_bytes(key), now);
      let first = verify_after(standard(), Secret::of_bytes(key), typed, now, window, None);
      first != None
        && verify_after(standard(), Secret::of_bytes(key), typed, now, window, first) == None
    },
  )
}

/// What a test draws for a provision: any two names, any key, and a number its form and kind are
/// derived from.
type ProvisionInput = { issuer: String, account: String, key: Bytes, n: Int }

/// A provision that `uri` can write, made from what a test drew.
fn provision_of(d: ProvisionInput) -> Provision =
  {
    kind: if d.n >>> 16 & 1 == 0 { TimeBased(seconds(1 + (d.n >>> 17 & 0xFFF))) }
    else { CounterBased(d.n >>> 17 & 0xFFFF_FFFF) },
    issuer: d.issuer.replace(":", ""),
    account: d.account.replace(":", "").ascii_trim_start(),
    key: d.key.concat(rfc_key()),
    form: form_of(d.n),
  }

test "a provisioning URI reads back as the provision it was written from" {
  gen::check(provision_inputs(), |x: ProvisionInput|
    agrees(
      |d: ProvisionInput| try_parse_uri(uri(provision_of(d))),
      |d: ProvisionInput| Ok(provision_of(d)),
      x,
    ))
}
