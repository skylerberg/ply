//! Classifies characters and converts them: gives a character's General_Category, its digit value,
//! and its upper, lower and title case forms.
//!
//! A `Char` is one Unicode scalar value, so every function here returns a result for every
//! character, and only the two that take a radix can raise. Each predicate tests one property of
//! the Unicode Character Database, and its doc names the property, because languages differ exactly
//! here. `Char::is_numeric` is the General_Category N, as in Rust and Go but not Python's
//! `isnumeric`. `Char::is_digit` is only the decimal digits. `Char::is_alphabetic` is the derived
//! property Alphabetic, which covers more than letters. The tables come from `std.ucd`, for the
//! Unicode version `std.ucd.version` returns. A code point that version assigns nothing to is
//! `Unassigned` and has no property.
//!
//! An `is_ascii_` function is its Unicode form restricted to ASCII: it reads no table and is false
//! for every character past `U+007F`. The functions over all of Unicode return the same result for
//! an ASCII character. For any other character, they read a table once, in constant time.
//!
//! `Char::to_uppercase`, `Char::to_lowercase` and `Char::to_titlecase` are the simple case
//! mappings, one character to one. A character whose full mapping is several characters (`ß` to
//! `SS`), or depends on its neighbors (a final sigma) or on a language (a Turkish `i`), maps here
//! to the single character the database gives for it alone, which may be itself. Those mappings and
//! case folding apply to strings: `std.unicode`'s `uppercase` and `lowercase` map in full, and
//! agree with these wherever they map one character to one.

import std.bytes (digit_value)
import std.gen
import std.gen (Gen)
import std.laws (agrees, round_trip)
import std.list
import std.math (to_radix_padded)
import std.string
import std.ucd
import std.ucd (Table)

/// A General_Category: the thirty kinds the Unicode Character Database sorts every code point
/// into, under the names it gives them. `show` writes the two-letter abbreviation.
pub type Category =
  /// `Lu`: an uppercase letter.
  | UppercaseLetter
  /// `Ll`: a lowercase letter.
  | LowercaseLetter
  /// `Lt`: a digraph with its first part uppercase, as `U+01C5`.
  | TitlecaseLetter
  /// `Lm`: a modifier letter.
  | ModifierLetter
  /// `Lo`: any other letter, a syllable or an ideograph among them.
  | OtherLetter
  /// `Mn`: a mark that takes no room of its own, as a combining accent.
  | NonspacingMark
  /// `Mc`: a combining mark that takes room.
  | SpacingMark
  /// `Me`: a mark that encloses what it follows.
  | EnclosingMark
  /// `Nd`: a decimal digit.
  | DecimalNumber
  /// `Nl`: a number that looks like letters, as a Roman numeral.
  | LetterNumber
  /// `No`: any other number, a fraction or a superscript among them.
  | OtherNumber
  /// `Pc`: punctuation that joins, as `_`.
  | ConnectorPunctuation
  /// `Pd`: a dash or a hyphen.
  | DashPunctuation
  /// `Ps`: an opening bracket.
  | OpenPunctuation
  /// `Pe`: a closing bracket.
  | ClosePunctuation
  /// `Pi`: an opening quotation mark.
  | InitialPunctuation
  /// `Pf`: a closing quotation mark.
  | FinalPunctuation
  /// `Po`: any other punctuation.
  | OtherPunctuation
  /// `Sm`: a mathematical symbol.
  | MathSymbol
  /// `Sc`: a currency sign.
  | CurrencySymbol
  /// `Sk`: a modifier that stands alone, as `^`.
  | ModifierSymbol
  /// `So`: any other symbol.
  | OtherSymbol
  /// `Zs`: a space.
  | SpaceSeparator
  /// `Zl`: `U+2028`, the line separator.
  | LineSeparator
  /// `Zp`: `U+2029`, the paragraph separator.
  | ParagraphSeparator
  /// `Cc`: a control code.
  | Control
  /// `Cf`: a format control, which is invisible.
  | Format
  /// `Cs`: a surrogate code point. A surrogate is not a valid `Char`, so no `Char` has this
  /// category.
  | Surrogate
  /// `Co`: a private-use character.
  | PrivateUse
  /// `Cn`: a code point this version of Unicode assigns no character to.
  | Unassigned

show for Category by abbreviation

/// The seven classes the categories fall into, each the first letter of its categories'
/// abbreviations.
pub type MajorClass =
  /// `L`.
  | Letter
  /// `M`.
  | Mark
  /// `N`.
  | Number
  /// `P`.
  | Punctuation
  /// `S`.
  | Symbol
  /// `Z`.
  | Separator
  /// `C`: controls, surrogates, private-use characters and the unassigned.
  | Other

/// The class `category` falls in.
pub fn major_class(category: Category) -> MajorClass =
  match category {
    UppercaseLetter | LowercaseLetter | TitlecaseLetter | ModifierLetter | OtherLetter -> Letter,
    NonspacingMark | SpacingMark | EnclosingMark -> Mark,
    DecimalNumber | LetterNumber | OtherNumber -> Number,
    ConnectorPunctuation | DashPunctuation | OpenPunctuation | ClosePunctuation -> Punctuation,
    InitialPunctuation | FinalPunctuation | OtherPunctuation -> Punctuation,
    MathSymbol | CurrencySymbol | ModifierSymbol | OtherSymbol -> Symbol,
    SpaceSeparator | LineSeparator | ParagraphSeparator -> Separator,
    Control | Format | Surrogate | PrivateUse | Unassigned -> Other,
  }

/// The two letters the Unicode Character Database abbreviates `category` to, `Lu` for
/// `UppercaseLetter`.
pub fn abbreviation(category: Category) -> String =
  match category {
    UppercaseLetter -> "Lu",
    LowercaseLetter -> "Ll",
    TitlecaseLetter -> "Lt",
    ModifierLetter -> "Lm",
    OtherLetter -> "Lo",
    NonspacingMark -> "Mn",
    SpacingMark -> "Mc",
    EnclosingMark -> "Me",
    DecimalNumber -> "Nd",
    LetterNumber -> "Nl",
    OtherNumber -> "No",
    ConnectorPunctuation -> "Pc",
    DashPunctuation -> "Pd",
    OpenPunctuation -> "Ps",
    ClosePunctuation -> "Pe",
    InitialPunctuation -> "Pi",
    FinalPunctuation -> "Pf",
    OtherPunctuation -> "Po",
    MathSymbol -> "Sm",
    CurrencySymbol -> "Sc",
    ModifierSymbol -> "Sk",
    OtherSymbol -> "So",
    SpaceSeparator -> "Zs",
    LineSeparator -> "Zl",
    ParagraphSeparator -> "Zp",
    Control -> "Cc",
    Format -> "Cf",
    Surrogate -> "Cs",
    PrivateUse -> "Co",
    Unassigned -> "Cn",
  }

fn category_at(number: Int) -> Category =
  match number {
    0 -> UppercaseLetter,
    1 -> LowercaseLetter,
    2 -> TitlecaseLetter,
    3 -> ModifierLetter,
    4 -> OtherLetter,
    5 -> NonspacingMark,
    6 -> SpacingMark,
    7 -> EnclosingMark,
    8 -> DecimalNumber,
    9 -> LetterNumber,
    10 -> OtherNumber,
    11 -> ConnectorPunctuation,
    12 -> DashPunctuation,
    13 -> OpenPunctuation,
    14 -> ClosePunctuation,
    15 -> InitialPunctuation,
    16 -> FinalPunctuation,
    17 -> OtherPunctuation,
    18 -> MathSymbol,
    19 -> CurrencySymbol,
    20 -> ModifierSymbol,
    21 -> OtherSymbol,
    22 -> SpaceSeparator,
    23 -> LineSeparator,
    24 -> ParagraphSeparator,
    25 -> Control,
    26 -> Format,
    27 -> Surrogate,
    28 -> PrivateUse,
    _ -> Unassigned,
  }

/// Every category, in the order the Unicode Character Database lists them.
pub const categories: List<Category> = range(0, 30).map(category_at)

/// The category's name as the standard writes it out: `Uppercase_Letter` for `Lu`.
pub fn name(category: Category) -> String =
  match category {
    UppercaseLetter -> "Uppercase_Letter",
    LowercaseLetter -> "Lowercase_Letter",
    TitlecaseLetter -> "Titlecase_Letter",
    ModifierLetter -> "Modifier_Letter",
    OtherLetter -> "Other_Letter",
    NonspacingMark -> "Nonspacing_Mark",
    SpacingMark -> "Spacing_Mark",
    EnclosingMark -> "Enclosing_Mark",
    DecimalNumber -> "Decimal_Number",
    LetterNumber -> "Letter_Number",
    OtherNumber -> "Other_Number",
    ConnectorPunctuation -> "Connector_Punctuation",
    DashPunctuation -> "Dash_Punctuation",
    OpenPunctuation -> "Open_Punctuation",
    ClosePunctuation -> "Close_Punctuation",
    InitialPunctuation -> "Initial_Punctuation",
    FinalPunctuation -> "Final_Punctuation",
    OtherPunctuation -> "Other_Punctuation",
    MathSymbol -> "Math_Symbol",
    CurrencySymbol -> "Currency_Symbol",
    ModifierSymbol -> "Modifier_Symbol",
    OtherSymbol -> "Other_Symbol",
    SpaceSeparator -> "Space_Separator",
    LineSeparator -> "Line_Separator",
    ParagraphSeparator -> "Paragraph_Separator",
    Control -> "Control",
    Format -> "Format",
    Surrogate -> "Surrogate",
    PrivateUse -> "Private_Use",
    Unassigned -> "Unassigned",
  }

/// The category `text` abbreviates, as `Lu` abbreviates `UppercaseLetter`. `None` for any other
/// text, including text that differs only in case.
pub fn category_named(text: String) -> Option<Category> =
  categories.find(|category: Category| abbreviation(category) == text)

const alphabetic: Int = 0x20

const lowercase: Int = 0x40

const uppercase: Int = 0x80

const white_space: Int = 0x100

const xid_start: Int = 0x200

const xid_continue: Int = 0x400

fn flag(letter: Int) -> Int / {abort.raise} =
  match letter {
    b'A' -> alphabetic,
    b'L' -> lowercase,
    b'U' -> uppercase,
    b'W' -> white_space,
    b'S' -> xid_start,
    b'C' -> xid_continue,
    _ -> panic("a flag letter in `ucd/classes.txt` must be one of A, L, U, W, S or C"),
  }

fn flags(letters: Bytes) -> Int / {abort.raise} =
  range(0, letters.len()).fold(0, |bits: Int, i: Int| bits | flag(letters.at(i)))

fn class_word(numbers: Map<Bytes, Int>, fields: List<Bytes>) -> Int / {abort.raise} = {
  let numbered = |name: Bytes|
    match numbers.get(name) {
      Some(number) -> number,
      None -> panic(f"`{String::of_bytes_lossy(name)}` is not a category abbreviation"),
    };
  match fields {
    [name] -> numbered(name),
    [name, letters] -> numbered(name) | flags(letters),
    [name, letters, digit] -> match digit.int_of_ascii() {
      Some(value) -> if value < 0 || value > 9 { panic("a decimal digit must be from 0 to 9") }
      else { numbered(name) | flags(letters) | value + 1 << 11 },
      None -> panic("a decimal digit must be from 0 to 9"),
    },
    _ -> panic("a line of `ucd/classes.txt` must be `category[;flags[;digit]]`"),
  }
}

const classes: Table = {
  let numbers = range(0, 30).fold(Map::new(), |known: Map<Bytes, Int>, number: Int|
    known.insert(Bytes::of_string(abbreviation(category_at(number))), number));
  ucd::table(embed("ucd/classes.txt"), 29, |fields: List<Bytes>| class_word(numbers, fields))
}

fn class_of(c: Char) -> Int = ucd::lookup(classes, Int::of_char(c))

fn has_flag(c: Char, property: Int) -> Bool = class_of(c) & property != 0

fn packed_case_distances(fields: List<Bytes>) -> Int / {abort.raise} =
  match fields {
    [upper, lower, title] ->
      ucd::parse_offset(upper) << 40 | ucd::parse_offset(lower) << 20 | ucd::parse_offset(title),
    _ -> panic("a line of `ucd/simple_case.txt` must have three fields: `upper;lower;title`"),
  }

const case_table: Table = ucd::table(embed("ucd/simple_case.txt"), 0, packed_case_distances)

fn case_mapped(c: Char, shift: Int) -> Char =
  match Char::of_int(
      ucd::apply_distance(Int::of_char(c), ucd::lookup(case_table, Int::of_char(c)) >> shift),
    ) {
    Some(to) -> to,
    None -> c,
  }

/// Whether `c` is one of the 128 ASCII characters, `U+0000` to `U+007F`.
pub fn Char::is_ascii(c: Char) -> Bool = c <= '\u{7F}'

/// Whether `c` is an ASCII capital, `A` to `Z`: `Char::is_uppercase` restricted to ASCII.
pub fn Char::is_ascii_uppercase(c: Char) -> Bool = 'A' <= c && c <= 'Z'

/// Whether `c` is an ASCII small letter, `a` to `z`: `Char::is_lowercase` restricted to ASCII.
pub fn Char::is_ascii_lowercase(c: Char) -> Bool = 'a' <= c && c <= 'z'

/// Whether `c` is an ASCII letter of either case: `Char::is_alphabetic`, and `Char::is_letter`,
/// restricted to ASCII.
pub fn Char::is_ascii_alphabetic(c: Char) -> Bool = c.is_ascii_uppercase() || c.is_ascii_lowercase()

/// Returns whether `c` is one of `0` to `9`. This is `Char::is_digit` and `Char::is_numeric`
/// restricted to ASCII, where the only numbers are the ten decimal digits.
pub fn Char::is_ascii_digit(c: Char) -> Bool = '0' <= c && c <= '9'

/// Whether `c` is an ASCII letter or digit: `Char::is_alphanumeric` restricted to ASCII.
pub fn Char::is_ascii_alphanumeric(c: Char) -> Bool = c.is_ascii_alphabetic() || c.is_ascii_digit()

/// Whether `c` is a digit of radix sixteen in either case: `0` to `9`, `a` to `f` or `A` to `F`.
pub fn Char::is_ascii_hexdigit(c: Char) -> Bool =
  c.is_ascii_digit() || ('a' <= c && c <= 'f') || ('A' <= c && c <= 'F')

/// Returns whether `c` is a space, a tab, a line feed, a vertical tab, a form feed or a carriage
/// return: `Char::is_whitespace` restricted to ASCII. The vertical tab is included because
/// Unicode's White_Space property includes it.
pub fn Char::is_ascii_whitespace(c: Char) -> Bool = c == ' ' || ('\t' <= c && c <= '\r')

/// Whether `c` is `U+0000` to `U+001F` or `U+007F`: `Char::is_control` restricted to ASCII.
pub fn Char::is_ascii_control(c: Char) -> Bool = c < ' ' || c == '\u{7F}'

/// Whether `c` is one of the 32 visible ASCII characters that are neither letters nor digits: those
/// for which `Char::is_punctuation` or `Char::is_symbol` is true, restricted to ASCII, as C's
/// `ispunct` defines them.
pub fn Char::is_ascii_punctuation(c: Char) -> Bool =
  ('!' <= c && c <= '/') || (':' <= c && c <= '@') || ('[' <= c && c <= '`')
    || ('{' <= c && c <= '~')

/// `c` as an ASCII capital where it is an ASCII small letter, and `c` itself otherwise.
pub fn Char::to_ascii_uppercase(c: Char) -> Char =
  if c.is_ascii_lowercase() {
    match Char::of_int(Int::of_char(c) - 32) { Some(upper) -> upper, None -> c }
  } else { c }

/// `c` as an ASCII small letter where it is an ASCII capital, and `c` itself otherwise.
pub fn Char::to_ascii_lowercase(c: Char) -> Char =
  if c.is_ascii_uppercase() {
    match Char::of_int(Int::of_char(c) + 32) { Some(lower) -> lower, None -> c }
  } else { c }

fn ascii_category(code: Int) -> Category =
  match code {
    b'a'..=b'z' -> LowercaseLetter,
    b'A'..=b'Z' -> UppercaseLetter,
    b'0'..=b'9' -> DecimalNumber,
    b' ' -> SpaceSeparator,
    0..=31 | 127 -> Control,
    b'_' -> ConnectorPunctuation,
    b'-' -> DashPunctuation,
    b'(' | b'[' | b'{' -> OpenPunctuation,
    b')' | b']' | b'}' -> ClosePunctuation,
    b'$' -> CurrencySymbol,
    b'+' | b'<' | b'=' | b'>' | b'|' | b'~' -> MathSymbol,
    b'^' | b'`' -> ModifierSymbol,
    _ -> OtherPunctuation,
  }

/// The General_Category of `c`. Never `Surrogate`.
pub fn Char::general_category(c: Char) -> Category =
  if c.is_ascii() { ascii_category(Int::of_char(c)) } else { category_at(class_of(c) & 31) }

/// Returns whether `c` has the Unicode property Alphabetic. This includes every letter, letter
/// numbers such as Roman numerals, and some marks and symbols that belong to words, such as vowel
/// signs.
pub fn Char::is_alphabetic(c: Char) -> Bool =
  if c.is_ascii() { c.is_ascii_alphabetic() } else { has_flag(c, alphabetic) }

/// Whether `c` is a number of any kind, the General_Category N: a decimal digit, a letter number
/// or another number such as a fraction. An ideograph that names a number is a letter, and is not
/// one of these.
pub fn Char::is_numeric(c: Char) -> Bool = major_class(c.general_category()) == Number

/// Whether `c` is Alphabetic or a number: `Char::is_alphabetic` or `Char::is_numeric`.
pub fn Char::is_alphanumeric(c: Char) -> Bool =
  if c.is_ascii() { c.is_ascii_alphanumeric() } else {
    let word = class_of(c);
    word & alphabetic != 0 || major_class(category_at(word & 31)) == Number
  }

/// Whether `c` is White_Space: a space of any width, a tab, or a line or paragraph break. A
/// zero-width space is not.
pub fn Char::is_whitespace(c: Char) -> Bool =
  if c.is_ascii() { c.is_ascii_whitespace() } else { has_flag(c, white_space) }

/// Whether `c` is Uppercase: an uppercase letter, or another character the database counts as
/// one, as a circled capital. A titlecase letter is neither Uppercase nor Lowercase.
pub fn Char::is_uppercase(c: Char) -> Bool =
  if c.is_ascii() { c.is_ascii_uppercase() } else { has_flag(c, uppercase) }

/// Whether `c` is Lowercase: a lowercase letter, or another character the database counts as
/// one, as a feminine ordinal or a small modifier letter.
pub fn Char::is_lowercase(c: Char) -> Bool =
  if c.is_ascii() { c.is_ascii_lowercase() } else { has_flag(c, lowercase) }

/// Whether `c` is a control code, the General_Category Cc: `U+0000` to `U+001F` and `U+007F` to
/// `U+009F`.
pub fn Char::is_control(c: Char) -> Bool = c.general_category() == Control

/// Whether `c` is a letter, the General_Category L. Narrower than `Char::is_alphabetic`.
pub fn Char::is_letter(c: Char) -> Bool = major_class(c.general_category()) == Letter

/// Whether `c` is a combining mark, the General_Category M.
pub fn Char::is_mark(c: Char) -> Bool = major_class(c.general_category()) == Mark

/// Whether `c` is a decimal digit of any script, the General_Category Nd: a character
/// `Char::decimal_value` returns a value for.
pub fn Char::is_digit(c: Char) -> Bool = c.general_category() == DecimalNumber

/// Whether `c` is punctuation, the General_Category P. `+`, `$` and `^` are symbols.
pub fn Char::is_punctuation(c: Char) -> Bool = major_class(c.general_category()) == Punctuation

/// Whether `c` is a symbol, the General_Category S.
pub fn Char::is_symbol(c: Char) -> Bool = major_class(c.general_category()) == Symbol

/// Whether `c` is a separator, the General_Category Z: a space, or the line or paragraph
/// separator. A tab and a line feed are controls.
pub fn Char::is_separator(c: Char) -> Bool = major_class(c.general_category()) == Separator

/// Whether this version of Unicode assigns `c` a character: any General_Category but Cn. A
/// private-use character is assigned.
pub fn Char::is_assigned(c: Char) -> Bool = c.general_category() != Unassigned

/// Whether `c` is XID_Start, what Unicode's identifier syntax lets a name begin with: a letter, a
/// letter number, or one of the few characters the database adds to them. `_` is not.
pub fn Char::is_xid_start(c: Char) -> Bool =
  if c.is_ascii() { c.is_ascii_alphabetic() } else { has_flag(c, xid_start) }

/// Returns whether `c` is XID_Continue: a character Unicode's identifier syntax allows after the
/// first character of a name. These are the XID_Start characters, digits, marks and joining
/// punctuation such as `_`.
pub fn Char::is_xid_continue(c: Char) -> Bool =
  if c.is_ascii() { c.is_ascii_alphanumeric() || c == '_' } else { has_flag(c, xid_continue) }

/// The value of `c` as a digit of `radix`: `0` to `9`, then `a` to `z` in either case for ten to
/// thirty-five. `None` for a character that is not a digit of the radix, including a digit of
/// another script. Raises for a radix outside `2..=36`.
pub fn Char::to_digit(c: Char, radix: Int) -> Option<Int> / {abort.raise} =
  if radix < 2 || radix > 36 { panic("a radix is 2 to 36") } else {
    let value = digit_value(Int::of_char(c));
    if value >= 0 && value < radix { Some(value) } else { None }
  }

/// The digit of `radix` whose value is `n`, a small letter from ten on; `None` for an `n` the
/// radix has no digit for. Raises for a radix outside `2..=36`.
pub fn Char::of_digit(n: Int, radix: Int) -> Option<Char> / {abort.raise} =
  if radix < 2 || radix > 36 { panic("a radix is 2 to 36") }
  else if n < 0 || n >= radix { None }
  else { Char::of_int(if n < 10 { 48 + n } else { 87 + n }) }

/// The value of `c` as a decimal digit of its script, `3` for `U+0663`: Numeric_Type Decimal,
/// which is the characters for which `Char::is_digit` is true. `None` for any other character,
/// including a superscript digit, a fraction and a Roman numeral.
pub fn Char::decimal_value(c: Char) -> Option<Int> =
  if c.is_ascii() { if c.is_ascii_digit() { Some(Int::of_char(c) - 48) } else { None } } else {
    let digit = class_of(c) >> 11 & 15;
    if digit == 0 { None } else { Some(digit - 1) }
  }

/// The simple uppercase mapping of `c`: one character, `c` itself where it has none.
pub fn Char::to_uppercase(c: Char) -> Char =
  if c.is_ascii() { c.to_ascii_uppercase() } else { case_mapped(c, 40) }

/// The simple lowercase mapping of `c`: one character, `c` itself where it has none.
pub fn Char::to_lowercase(c: Char) -> Char =
  if c.is_ascii() { c.to_ascii_lowercase() } else { case_mapped(c, 20) }

/// The simple titlecase mapping of `c`, the form that begins a capitalized word: its uppercase
/// for nearly every character, and the titlecase letter for a digraph that has one.
pub fn Char::to_titlecase(c: Char) -> Char =
  if c.is_ascii() { c.to_ascii_uppercase() } else { case_mapped(c, 0) }

/// The Unicode scalar value of `c`: `0` to `0x10FFFF`, never a surrogate.
pub fn Char::code_point(c: Char) -> Int = Int::of_char(c)

/// The character whose scalar value is `n`; `None` for a surrogate (`0xD800` to `0xDFFF`), a
/// negative number and one past `0x10FFFF`.
pub fn Char::of_code_point(n: Int) -> Option<Char> = Char::of_int(n)

/// The character whose scalar value is `n`, and `U+FFFD`, the replacement character, where
/// `Char::of_code_point` returns `None`.
pub fn Char::of_code_point_lossy(n: Int) -> Char =
  match Char::of_int(n) { Some(c) -> c, None -> '\u{FFFD}' }

/// The text whose characters are at `points`, in order, each as `Char::of_code_point_lossy` returns
/// it.
pub fn text_of(points: List<Int>) -> String =
  String::of_chars(points.map(Char::of_code_point_lossy))

/// How many bytes `c` takes in UTF-8: one to four.
pub fn Char::utf8_len(c: Char) -> Int =
  if c < '\u{80}' { 1 } else if c < '\u{800}' { 2 } else if c < '\u{10000}' { 3 } else { 4 }

/// How many sixteen-bit units `c` takes in UTF-16: two for a character past `U+FFFF`, which is
/// written as a surrogate pair, and one for any other.
pub fn Char::utf16_len(c: Char) -> Int = if c < '\u{10000}' { 1 } else { 2 }

/// Code points in a row, `first` through `last`.
pub type CodePointRange = { first: Int, last: Int }

/// A property of a code point that the character table records: its general category, its major
/// class, or a flag such as being alphabetic.
pub type Property =
  /// The code point's general category is the given `Category`.
  | InCategory(Category)
  /// The code point's general category belongs to the given `MajorClass`.
  | InMajorClass(MajorClass)
  /// `Char::is_alphabetic` is true of it.
  | Alphabetic
  /// `Char::is_lowercase` is true of it.
  | Lowercase
  /// `Char::is_uppercase` is true of it.
  | Uppercase
  /// `Char::is_whitespace` is true of it.
  | WhiteSpace
  /// `Char::is_xid_start` is true of it.
  | XidStart
  /// `Char::is_xid_continue` is true of it.
  | XidContinue

const class_runs: Array<Int> = {
  let table = classes;
  Array::of_list(
    range(0, 0x110000).fold(
      { runs: [], last: -1 },
      |so_far: { runs: List<Int>, last: Int }, code_point: Int| {
        let word = ucd::lookup(table, code_point);
        if word == so_far.last { so_far }
        else { { runs: so_far.runs.push(code_point).push(word), last: word } }
      },
    ).runs,
  )
}

fn has_property(word: Int, property: Property, number: Int) -> Bool =
  match property {
    InCategory(_) -> word & 31 == number,
    InMajorClass(class) -> major_class(category_at(word & 31)) == class,
    Alphabetic -> word & alphabetic != 0,
    Lowercase -> word & lowercase != 0,
    Uppercase -> word & uppercase != 0,
    WhiteSpace -> word & white_space != 0,
    XidStart -> word & xid_start != 0,
    XidContinue -> word & xid_continue != 0,
  }

/// Returns every code point that `property` is true of, as ascending ranges that neither touch nor
/// overlap. A matcher builds a character class from these ranges. A surrogate, which is not a
/// `Char`, is included in the ranges of the surrogate category.
pub fn code_point_ranges(property: Property) -> List<CodePointRange> = {
  let runs = class_runs;
  let number = match property {
    InCategory(category) ->
      range(0, 30).fold(29, |found: Int, n: Int|
        if category_at(n) == category { n } else { found }),
    _ -> 0,
  };
  let walked = range(0, runs.len() / 2).fold(
    { done: [], open: None },
    |so_far: { done: List<CodePointRange>, open: Option<CodePointRange> }, i: Int|
      match ((runs.at(2 * i), runs.at(2 * i + 1), so_far.open)) {
        (Some(first), Some(word), open) -> if has_property(word, property, number) {
          match open {
            Some(_) -> so_far,
            None -> { done: so_far.done, open: Some({ first: first, last: first }) },
          }
        } else {
          match open {
            Some(stretch) ->
              { done: so_far.done.push({ first: stretch.first, last: first - 1 }), open: None },
            None -> so_far,
          }
        },
        _ -> so_far,
      },
  );
  match walked.open {
    Some(stretch) -> walked.done.push({ first: stretch.first, last: 0x10FFFF }),
    None -> walked.done,
  }
}

const edges: List<Char> =
  "\u{7F}\u{80}\u{7FF}\u{800}\u{D7FF}\u{E000}\u{DF}\u{130}\u{131}\u{17F}\u{1C5}\u{345}\u{3C2}\u{3F4}\u{10D0}\u{1E9E}\u{1F88}\u{2126}\u{212A}\u{24B6}\u{A7AE}\u{10400}\u{1E922}".chars(
  ).concat(
    range(0, 17).flat_map(|plane: Int|
      [Char::of_code_point_lossy(plane << 16), Char::of_code_point_lossy(plane << 16 | 0xFFFF)]),
  )

/// Returns a generator of characters from anywhere in Unicode, for claims over characters. It picks
/// equally among an ASCII character, a character below `U+3000` (where most cased letters are), a
/// character at an edge (see `edges`), and any code point of the seventeen planes. It shrinks
/// toward ASCII.
pub fn arbitrary() -> Gen<Char> =
  gen::one_of([
    gen::map(gen::int_between(0, 0x7F), Char::of_code_point_lossy),
    gen::map(gen::int_between(0x80, 0x2FFF), Char::of_code_point_lossy),
    gen::elements(edges),
    gen::map2(gen::below(17), gen::below(0x10000), |plane: Int, low: Int|
      Char::of_code_point_lossy(plane << 16 | low)),
  ])

const tricky_texts: List<String> =
  [
    "\u{1FB3}\u{313}",
    "a\u{345}\u{35D}",
    "I\u{307}",
    "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}",
    "\u{1F44D}\u{1F3FD}",
    "\u{1F1E9}\u{1F1EA}",
    "\u{2764}\u{FE0F}",
    "1\u{FE0F}\u{20E3}",
    "\u{1100}\u{1161}\u{11A8}",
    "\u{D4DB}",
    "\u{915}\u{94D}\u{937}",
    "\u{DF}",
    "\u{130}",
    "\u{3A3}",
    "\u{FB03}",
    "\u{1E9B}\u{323}",
    "a\u{301}\u{323}",
    "\u{5D0}\u{5D1}",
    "\u{628}\u{200C}",
    "\r\n",
    ".",
    "-",
    "xn--",
    " ",
    "9",
  ]

/// Returns a generator of texts for claims over texts. Each text joins up to twelve pieces. A piece
/// is a character from `arbitrary`, a run of ASCII lowercase letters, a combining mark, a Hangul
/// syllable or jamo, a Greek or emoji character, or one of `tricky_texts`. It shrinks toward the
/// empty text.
pub fn arbitrary_text() -> Gen<String> =
  gen::map(
    gen::list_of(
      gen::one_of([
        gen::map(gen::list_of(gen::int_between(0x61, 0x7A), 6), text_of),
        gen::map(arbitrary(), |c: Char| String::of_chars([c])),
        gen::elements(tricky_texts),
        gen::map(
          gen::one_of([
            gen::int_between(0x300, 0x36F),
            gen::int_between(0xAC00, 0xD7A3),
            gen::int_between(0x1100, 0x11FF),
            gen::int_between(0x391, 0x3C9),
            gen::int_between(0x1F600, 0x1F64F),
          ]),
          |code_point: Int| text_of([code_point]),
        ),
      ]),
      12,
    ),
    |pieces: List<String>| pieces.fold("", |text: String, piece: String| text ++ piece),
  )

fn sample_of<a>(g: Gen<a>, seed: Int) -> a / {abort.raise} =
  match gen::sample(g, 0, Bytes::of_string(seed.to_string()), 32, None).value {
    Some(value) -> value,
    None -> panic("the generator gave up"),
  }

/// The character `arbitrary` draws for `seed`: how a claim or a test over whole numbers ranges
/// over characters.
pub fn arbitrary_char(seed: Int) -> Char / {abort.raise} = sample_of(arbitrary(), seed)

/// The text `arbitrary_text` draws for `seed`: how a claim or a test over whole numbers ranges
/// over texts.
pub fn sample_text(seed: Int) -> String / {abort.raise} = sample_of(arbitrary_text(), seed)

law "converting a category to its abbreviation and back gives the same category" =
  round_trip(abbreviation, category_named)

test "`Char::of_code_point` and `Char::of_code_point_lossy` return the original character from its code point" {
  gen::check(gen::any_int(), |seed: Int| {
    Char::of_code_point(arbitrary_char(seed).code_point()) == Some(arbitrary_char(seed))
      && Char::of_code_point_lossy(arbitrary_char(seed).code_point()) == arbitrary_char(seed)
  })
}

test "`text_of` rebuilds a string from the code points of its characters" {
  gen::check(gen::any_int(), |seed: Int| {
    text_of(sample_text(seed).chars().map(Char::code_point)) == sample_text(seed)
  })
}

test "is_ascii_alphabetic is is_alphabetic restricted to ASCII" {
  gen::check(gen::any_int(), |x: Int|
    agrees(
      |seed: Int| arbitrary_char(seed).is_ascii_alphabetic(),
      |seed: Int| arbitrary_char(seed).is_ascii() && arbitrary_char(seed).is_alphabetic(),
      x,
    ))
}

test "the ASCII case mappings are the simple ones restricted to ASCII" {
  gen::check(gen::any_int(), |seed: Int| {
    let c = arbitrary_char(seed);
    c.to_ascii_uppercase() == (if c.is_ascii() { c.to_uppercase() } else { c })
      && c.to_ascii_lowercase() == (if c.is_ascii() { c.to_lowercase() } else { c })
  })
}

test "a character is in exactly one of the letter, mark, number, punctuation, symbol and separator groups, unless its category is Other" {
  gen::check(gen::any_int(), |seed: Int| {
    let c = arbitrary_char(seed);
    let of_a_class = [
      c.is_letter(),
      c.is_mark(),
      c.is_numeric(),
      c.is_punctuation(),
      c.is_symbol(),
      c.is_separator(),
    ].count(|yes: Bool| yes);
    of_a_class == (if major_class(c.general_category()) == Other { 0 } else { 1 })
      && c.is_control() == (c.general_category() == Control)
      && c.is_assigned() == (c.general_category() != Unassigned)
  })
}

test "uppercase, lowercase and letter characters are alphabetic, and no character is both uppercase and lowercase" {
  gen::check(gen::any_int(), |seed: Int| {
    let c = arbitrary_char(seed);
    (c.is_alphabetic() || !(c.is_uppercase() || c.is_lowercase() || c.is_letter()))
      && !(c.is_uppercase() && c.is_lowercase())
      && c.is_alphanumeric() == (c.is_alphabetic() || c.is_numeric())
  })
}

test "`Char::of_digit` returns a character that `to_digit` converts back to the same digit in the same radix" {
  gen::check2(gen::any_int(), gen::any_int(), |n: Int, r: Int| {
    let radix = 2 + (r % 35 + 35) % 35;
    let digit = (n % radix + radix) % radix;
    match Char::of_digit(digit, radix) {
      Some(c) -> c.to_digit(radix) == Some(digit),
      None -> false,
    }
  })
}

test "`to_uppercase`, `to_lowercase` and `to_titlecase` return the same character when applied to their own result" {
  gen::check(gen::any_int(), |seed: Int| {
    let c = arbitrary_char(seed);
    c.to_uppercase().to_uppercase() == c.to_uppercase()
      && c.to_lowercase().to_lowercase() == c.to_lowercase()
      && c.to_titlecase().to_titlecase() == c.to_titlecase()
  })
}

type Sample = { c: Char, category: Category }

const samples: List<Sample> =
  [
    { c: 'A', category: UppercaseLetter },
    { c: '\u{3A3}', category: UppercaseLetter },
    { c: 'a', category: LowercaseLetter },
    { c: '\u{DF}', category: LowercaseLetter },
    { c: '\u{1C5}', category: TitlecaseLetter },
    { c: '\u{2B0}', category: ModifierLetter },
    { c: '\u{AA}', category: OtherLetter },
    { c: '\u{4E2D}', category: OtherLetter },
    { c: '\u{301}', category: NonspacingMark },
    { c: '\u{903}', category: SpacingMark },
    { c: '\u{20DD}', category: EnclosingMark },
    { c: '5', category: DecimalNumber },
    { c: '\u{663}', category: DecimalNumber },
    { c: '\u{2167}', category: LetterNumber },
    { c: '\u{BD}', category: OtherNumber },
    { c: '_', category: ConnectorPunctuation },
    { c: '-', category: DashPunctuation },
    { c: '(', category: OpenPunctuation },
    { c: ')', category: ClosePunctuation },
    { c: '\u{AB}', category: InitialPunctuation },
    { c: '\u{BB}', category: FinalPunctuation },
    { c: '!', category: OtherPunctuation },
    { c: '+', category: MathSymbol },
    { c: '$', category: CurrencySymbol },
    { c: '^', category: ModifierSymbol },
    { c: '\u{A9}', category: OtherSymbol },
    { c: ' ', category: SpaceSeparator },
    { c: '\u{3000}', category: SpaceSeparator },
    { c: '\u{2028}', category: LineSeparator },
    { c: '\u{2029}', category: ParagraphSeparator },
    { c: '\n', category: Control },
    { c: '\u{85}', category: Control },
    { c: '\u{AD}', category: Format },
    { c: '\u{E000}', category: PrivateUse },
    { c: '\u{10FFFD}', category: PrivateUse },
    { c: '\u{378}', category: Unassigned },
    { c: '\u{10FFFF}', category: Unassigned },
  ]

fn code_point_text(c: Char) -> String / {abort.raise} =
  "U+" ++ to_radix_padded(Int::of_char(c), 16, 4).ascii_upper()

test "{code_point_text(s.c)} has the general category {s.category}" for s: Sample in samples {
  assert_eq(s.c.general_category(), s.category)
}

test "every category except `Surrogate` has a sample character, `categories` lists each category once, and category abbreviations look up the right category" {
  let sampled = samples.map(|s: Sample| s.category);
  assert_eq(
    categories.filter(|category: Category| sampled.count(|c: Category| c == category) == 0),
    [Surrogate],
  );
  assert_eq(categories.len(), 30);
  assert_eq(
    categories.map(|category: Category| categories.count(|c: Category| c == category)),
    range(0, 30).map(|_: Int| 1),
  );
  assert_eq(f"{'A'.general_category()}", "Lu");
  assert_eq(category_named("Lu"), Some(UppercaseLetter));
  assert_eq(category_named("lu"), None);
  assert_eq(category_named("L"), None)
}

const ascii: List<Char> = range(0, 128).map(Char::of_code_point_lossy)

test "every ASCII character's category, properties and case mappings match the values in the Unicode lookup tables" {
  let unlike = ascii.filter(|c: Char| {
    let word = class_of(c);
    c.general_category() != category_at(word & 31) || c.is_alphabetic() != has_flag(c, alphabetic)
      || c.is_lowercase() != has_flag(c, lowercase)
      || c.is_uppercase() != has_flag(c, uppercase)
      || c.is_whitespace() != has_flag(c, white_space)
      || c.is_xid_start() != has_flag(c, xid_start)
      || c.is_xid_continue() != has_flag(c, xid_continue)
      || c.is_alphanumeric() != (c.is_alphabetic() || c.is_numeric())
      || c.decimal_value()
      != (if word >> 11 & 15 == 0 { None } else { Some((word >> 11 & 15) - 1) })
      || c.to_uppercase() != case_mapped(c, 40)
      || c.to_lowercase() != case_mapped(c, 20)
      || c.to_titlecase() != case_mapped(c, 0)
  });
  assert_eq(unlike, [])
}

test "each ASCII predicate is true of the characters it names and of no other" {
  let of = |named: (Char) -> Bool| String::of_chars(ascii.filter(named));
  assert_eq(of(Char::is_ascii_uppercase), "ABCDEFGHIJKLMNOPQRSTUVWXYZ");
  assert_eq(of(Char::is_ascii_lowercase), "abcdefghijklmnopqrstuvwxyz");
  assert_eq(of(Char::is_ascii_digit), "0123456789");
  assert_eq(of(Char::is_ascii_hexdigit), "0123456789ABCDEFabcdef");
  assert_eq(of(Char::is_ascii_whitespace), "\t\n\u{B}\u{C}\r ");
  assert_eq(of(Char::is_ascii_punctuation), "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~");
  assert_eq(ascii.filter(Char::is_ascii_control).len(), 33);
  assert_eq(ascii.filter(Char::is_ascii_alphanumeric).len(), 62);
  assert_eq(ascii.filter(Char::is_ascii).len(), 128);
  assert(!'\u{80}'.is_ascii() && !'\u{E9}'.is_ascii_alphabetic() && !'\u{663}'.is_ascii_digit())
}

test "Unicode properties such as alphabetic and uppercase include characters outside the matching general categories" {
  assert('\u{2167}'.is_alphabetic() && !'\u{2167}'.is_letter());
  assert('\u{345}'.is_alphabetic() && '\u{345}'.is_mark());
  assert('\u{4E2D}'.is_alphabetic() && !'\u{4E2D}'.is_uppercase() && !'\u{4E2D}'.is_lowercase());
  assert('\u{24B6}'.is_uppercase() && '\u{24B6}'.is_symbol());
  assert('\u{AA}'.is_lowercase() && '\u{AA}'.general_category() == OtherLetter);
  assert(!'\u{1C5}'.is_uppercase() && !'\u{1C5}'.is_lowercase() && '\u{1C5}'.is_letter());
  assert('\u{BD}'.is_numeric() && !'\u{BD}'.is_digit() && '\u{BD}'.is_alphanumeric());
  assert(!'\u{4E09}'.is_numeric() && '\u{4E09}'.is_letter());
  assert('\u{A0}'.is_whitespace() && '\u{2028}'.is_whitespace() && '\u{85}'.is_whitespace());
  assert(!'\u{200B}'.is_whitespace() && !'\u{200B}'.is_separator());
  assert(' '.is_separator() && !'\t'.is_separator() && '\t'.is_control());
  assert('\u{2014}'.is_punctuation() && '\u{20AC}'.is_symbol() && !'+'.is_punctuation());
  assert('\u{E000}'.is_assigned() && !'\u{378}'.is_assigned() && !'\u{378}'.is_alphabetic())
}

test "an identifier begins with a letter and goes on with letters, digits, marks and `_`" {
  assert('x'.is_xid_start() && '\u{E9}'.is_xid_start() && '\u{4E2D}'.is_xid_start());
  assert(!'_'.is_xid_start() && !'7'.is_xid_start() && !'\u{301}'.is_xid_start());
  assert('_'.is_xid_continue() && '7'.is_xid_continue() && '\u{301}'.is_xid_continue());
  assert('\u{663}'.is_xid_continue() && !'-'.is_xid_continue() && !' '.is_xid_continue())
}

test "a digit of a radix is 0-9 and then the letters, in either case" {
  assert_eq('7'.to_digit(10), Some(7));
  assert_eq('7'.to_digit(7), None);
  assert_eq('f'.to_digit(16), Some(15));
  assert_eq('F'.to_digit(16), Some(15));
  assert_eq('g'.to_digit(16), None);
  assert_eq('z'.to_digit(36), Some(35));
  assert_eq('\u{663}'.to_digit(10), None);
  assert_eq(Char::of_digit(7, 10), Some('7'));
  assert_eq(Char::of_digit(15, 16), Some('f'));
  assert_eq(Char::of_digit(35, 36), Some('z'));
  assert_eq(Char::of_digit(16, 16), None);
  assert_eq(Char::of_digit(-1, 10), None);
  let pairs = range(2, 37).flat_map(|radix: Int|
    range(0, radix).map(|n: Int| { n: n, radix: radix }));
  assert_eq(
    pairs.filter(|p: { n: Int, radix: Int }|
      match Char::of_digit(p.n, p.radix) {
        Some(c) -> c.to_digit(p.radix) != Some(p.n),
        None -> true,
      }),
    [],
  )
}

test "a radix of {radix} is rejected" for radix: Int in [-1, 0, 1, 37] {
  assert_eq(try[abort.raise] { '1'.to_digit(radix) }, Err("a radix is 2 to 36"));
  assert_eq(try[abort.raise] { Char::of_digit(1, radix) }, Err("a radix is 2 to 36"))
}

test "`decimal_value` returns the value of a decimal digit in any script, and `None` for every other character" {
  assert_eq('7'.decimal_value(), Some(7));
  assert_eq('\u{663}'.decimal_value(), Some(3));
  assert_eq('\u{FF19}'.decimal_value(), Some(9));
  assert_eq('\u{1D7D8}'.decimal_value(), Some(0));
  assert_eq('\u{B2}'.decimal_value(), None);
  assert_eq('\u{BD}'.decimal_value(), None);
  assert_eq('\u{2167}'.decimal_value(), None);
  assert_eq('a'.decimal_value(), None)
}

type Cased = { c: Char, upper: Char, lower: Char, title: Char }

const cased: List<Cased> =
  [
    { c: 'a', upper: 'A', lower: 'a', title: 'A' },
    { c: 'Z', upper: 'Z', lower: 'z', title: 'Z' },
    { c: '7', upper: '7', lower: '7', title: '7' },
    { c: '\u{E9}', upper: '\u{C9}', lower: '\u{E9}', title: '\u{C9}' },
    { c: '\u{FF}', upper: '\u{178}', lower: '\u{FF}', title: '\u{178}' },
    { c: '\u{DF}', upper: '\u{DF}', lower: '\u{DF}', title: '\u{DF}' },
    { c: '\u{1E9E}', upper: '\u{1E9E}', lower: '\u{DF}', title: '\u{1E9E}' },
    { c: '\u{130}', upper: '\u{130}', lower: 'i', title: '\u{130}' },
    { c: '\u{131}', upper: 'I', lower: '\u{131}', title: 'I' },
    { c: '\u{3A3}', upper: '\u{3A3}', lower: '\u{3C3}', title: '\u{3A3}' },
    { c: '\u{3C2}', upper: '\u{3A3}', lower: '\u{3C2}', title: '\u{3A3}' },
    { c: '\u{1C4}', upper: '\u{1C4}', lower: '\u{1C6}', title: '\u{1C5}' },
    { c: '\u{1C5}', upper: '\u{1C4}', lower: '\u{1C6}', title: '\u{1C5}' },
    { c: '\u{1C6}', upper: '\u{1C4}', lower: '\u{1C6}', title: '\u{1C5}' },
    { c: '\u{10D0}', upper: '\u{1C90}', lower: '\u{10D0}', title: '\u{10D0}' },
    { c: '\u{212A}', upper: '\u{212A}', lower: 'k', title: '\u{212A}' },
    { c: '\u{A7AE}', upper: '\u{A7AE}', lower: '\u{26A}', title: '\u{A7AE}' },
    { c: '\u{10428}', upper: '\u{10400}', lower: '\u{10428}', title: '\u{10400}' },
    { c: '\u{1E900}', upper: '\u{1E900}', lower: '\u{1E922}', title: '\u{1E900}' },
    { c: '\u{4E2D}', upper: '\u{4E2D}', lower: '\u{4E2D}', title: '\u{4E2D}' },
    { c: '\u{10FFFF}', upper: '\u{10FFFF}', lower: '\u{10FFFF}', title: '\u{10FFFF}' },
  ]

test "{code_point_text(k.c)} has the expected single-character uppercase, lowercase and titlecase mappings" for k: Cased in cased {
  assert_eq(k.c.to_uppercase(), k.upper);
  assert_eq(k.c.to_lowercase(), k.lower);
  assert_eq(k.c.to_titlecase(), k.title)
}

test "the ASCII mappings change ASCII letters and nothing else" {
  assert_eq(
    String::of_chars("aZ9_\u{E9}\u{C9}".chars().map(Char::to_ascii_uppercase)),
    "AZ9_\u{E9}\u{C9}",
  );
  assert_eq(
    String::of_chars("aZ9_\u{E9}\u{C9}".chars().map(Char::to_ascii_lowercase)),
    "az9_\u{E9}\u{C9}",
  )
}

test "`utf8_len` and `utf16_len` return the number of bytes or 16-bit units a character needs, which grows at each encoding's size boundaries" {
  assert_eq(
    ['\0', '\u{7F}', '\u{80}', '\u{7FF}', '\u{800}', '\u{FFFF}', '\u{10000}', '\u{10FFFF}'].map(
      Char::utf8_len,
    ),
    [1, 1, 2, 2, 3, 3, 4, 4],
  );
  assert_eq(
    ['\0', '\u{D7FF}', '\u{E000}', '\u{FFFF}', '\u{10000}', '\u{10FFFF}'].map(Char::utf16_len),
    [1, 1, 1, 1, 2, 2],
  )
}

test "`of_code_point` returns a character for a valid code point, and `None` for a negative number, a surrogate or a number above U+10FFFF" {
  assert_eq('A'.code_point(), 65);
  assert_eq(Char::of_code_point(0x1F600), Some('\u{1F600}'));
  assert_eq([-1, 0xD800, 0xDFFF, 0x110000].map(Char::of_code_point), [None, None, None, None])
}

test "each category's `name` is its long Unicode name, and no two categories have the same name" {
  assert_eq(name(UppercaseLetter), "Uppercase_Letter");
  assert_eq(name(DecimalNumber), "Decimal_Number");
  assert_eq(name(PrivateUse), "Private_Use");
  assert_eq(name(Control), "Control");
  assert_eq(
    categories.count(|a: Category| categories.count(|b: Category| name(a) == name(b)) != 1),
    0,
  )
}

test "each category's code point ranges are sorted and do not overlap or touch, and all categories together cover every code point" {
  let sizes = categories.map(|category: Category| {
    let found = code_point_ranges(InCategory(category));
    let rising = found.fold(
      { ok: true, past: -2 },
      |so_far: { ok: Bool, past: Int }, s: CodePointRange|
        { ok: so_far.ok && s.first > so_far.past + 1 && s.last >= s.first, past: s.last },
    );
    assert(rising.ok, Some(abbreviation(category)));
    found.fold(0, |sum: Int, s: CodePointRange| sum + s.last - s.first + 1)
  });
  assert_eq(sizes.fold(0, |sum: Int, n: Int| sum + n), 0x110000);
  assert_eq(code_point_ranges(InCategory(DecimalNumber)).at(0), Some({ first: 0x30, last: 0x39 }));
  assert_eq(code_point_ranges(InCategory(Surrogate)), [{ first: 0xD800, last: 0xDFFF }]);
  assert_eq(code_point_ranges(WhiteSpace).at(0), Some({ first: 9, last: 13 }));
  let letters = code_point_ranges(InMajorClass(Letter)).fold(0, |sum: Int, s: CodePointRange|
    sum + s.last - s.first + 1);
  assert_eq(
    letters,
    [UppercaseLetter, LowercaseLetter, TitlecaseLetter, ModifierLetter, OtherLetter].fold(
      0,
      |sum: Int, category: Category|
        sum
          + code_point_ranges(InCategory(category)).fold(0, |n: Int, s: CodePointRange|
            n + s.last - s.first + 1),
    ),
  )
}

test "`of_code_point_lossy` and `text_of` replace a number that is not a valid code point with U+FFFD" {
  assert_eq([0x41, 0xD7FF, 0xE000, 0x10FFFF].map(Char::of_code_point_lossy), [
    'A',
    '\u{D7FF}',
    '\u{E000}',
    '\u{10FFFF}',
  ]);
  assert_eq([-1, 0xD800, 0xDFFF, 0x110000].map(Char::of_code_point_lossy), [
    '\u{FFFD}',
    '\u{FFFD}',
    '\u{FFFD}',
    '\u{FFFD}',
  ]);
  assert_eq(text_of([0x68, 0xD800, 0x1F600, 0x69]), "h\u{FFFD}\u{1F600}i");
  assert_eq(text_of([]), "")
}

test "the character generator produces ASCII characters, characters from every Unicode plane, boundary characters and many characters with case mappings" {
  let seen = range(0, 4000).map(arbitrary_char);
  assert_eq(
    range(0, 17).filter(|plane: Int| seen.count(|c: Char| c.code_point() >> 16 == plane) == 0),
    [],
  );
  assert_eq(edges.filter(|edge: Char| seen.count(|c: Char| c == edge) == 0), []);
  assert(seen.count(Char::is_ascii) > 800);
  assert(seen.count(|c: Char| c.to_uppercase() != c || c.to_lowercase() != c) > 400)
}

test "the text generator produces the empty string, strings longer than 20 characters and every string in `tricky_texts`" {
  let seen = range(0, 3000).map(sample_text);
  assert(seen.count(|text: String| text == "") > 0);
  assert(seen.count(|text: String| text.len() > 20) > 0);
  assert_eq(
    tricky_texts.filter(|knot: String| seen.count(|text: String| text.contains(knot)) == 0),
    [],
  )
}
