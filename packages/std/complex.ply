//! Complex numbers over `Float`.
//!
//! A `Complex` is a real part and an imaginary part, each any `Float`, so every pair is a valid
//! number and there is no invariant to maintain. The type declares `numeric`, so `a + b`, `a - b`,
//! `a * b` and `-a` call `add`, `sub`, `mul` and `neg`. It declares no `key`: `==` compares the two
//! parts as IEEE does, so `-0.0` equals `0.0` and a `NaN` is not equal to anything, including
//! itself. Complex numbers therefore have no order, cannot be `Map` keys, and do not satisfy
//! `numeric(a)`, which includes `<`. Laws over complex numbers are checked by running them, not
//! proved.
//!
//! Each function returns its principal value, using the branch cuts and signed zeros that C99 Annex
//! G specifies (the choices made by William Kahan). `sqrt` and `ln` are cut along the negative real
//! axis. `asin`, `acos` and `atanh` are cut along the real axis outside `-1..=1`. `asinh` and
//! `atan` are cut along the imaginary axis outside `-i..=i`. `acosh` is cut along the real axis
//! below `1`. On a cut, the sign of the zero part decides which side the point is on: `sqrt` of
//! `-4+0i` is `2i` and of `-4-0i` is `-2i`. Each function maps a conjugate to the conjugate of its
//! result. `sqrt`, `ln` and `exp` also match Annex G for infinities and `NaN`s. The other functions
//! match it only for finite arguments.

import std.float
import std.list
import std.gen

/// A complex number: its real part, then its imaginary part.
pub type Complex = | Complex(Float, Float)

numeric for Complex by { add: add, sub: sub, mul: mul, neg: neg, of_int: of_int }

show for Complex by to_string

/// Zero.
pub fn zero() -> Complex = Complex(0.0, 0.0)

/// One.
pub fn one() -> Complex = Complex(1.0, 0.0)

/// The imaginary unit.
pub fn i() -> Complex = Complex(0.0, 1.0)

/// `re + im * i`.
pub fn of_parts(re: Float, imaginary: Float) -> Complex = Complex(re, imaginary)

/// Returns the complex number whose real part is `x` and whose imaginary part is zero.
pub fn of_float(x: Float) -> Complex = Complex(x, 0.0)

/// The whole number `n`, to the nearest `Float`.
pub fn of_int(n: Int) -> Complex = Complex(Float::of_int(n), 0.0)

/// The number at distance `r` from zero and angle `theta` radians from the positive real axis.
pub fn of_polar(r: Float, theta: Float) -> Complex = Complex(r * theta.cos(), r * theta.sin())

/// The real part.
pub fn re(z: Complex) -> Float = match z { Complex(x, _) -> x }

/// The imaginary part.
pub fn imaginary_part(z: Complex) -> Float = match z { Complex(_, y) -> y }

/// The distance from zero, computed without intermediate overflow. It is infinite if either part
/// is infinite.
pub fn abs(z: Complex) -> Float = re(z).hypot(imaginary_part(z))

/// The angle from the positive real axis in radians, in `[-pi, pi]`. On the negative real axis it
/// is `pi` for a `+0.0` imaginary part and `-pi` for a `-0.0` one.
pub fn arg(z: Complex) -> Float = imaginary_part(z).atan2(re(z))

/// The distance from zero and the angle: `abs` and `arg`.
pub fn to_polar(z: Complex) -> { r: Float, theta: Float } = { r: abs(z), theta: arg(z) }

/// Whether either part is a `NaN`.
pub fn is_nan(z: Complex) -> Bool = re(z).is_nan() || imaginary_part(z).is_nan()

/// Whether either part is an infinity, whatever the other is.
pub fn is_infinite(z: Complex) -> Bool = re(z).is_infinite() || imaginary_part(z).is_infinite()

/// Whether both parts are finite.
pub fn is_finite(z: Complex) -> Bool = re(z).is_finite() && imaginary_part(z).is_finite()

/// Whether `a` and `b` are within `relative` of the larger of their distances from zero, or
/// within `absolute`, whichever allows more, as Python's `cmath.isclose` decides.
pub fn is_close(a: Complex, b: Complex, relative: Float, absolute: Float) -> Bool =
  (re(a) == re(b) && imaginary_part(a) == imaginary_part(b))
    || (is_finite(a) && is_finite(b)
    && (abs(sub(a, b)) <= relative * abs(a) || abs(sub(a, b)) <= relative * abs(b)
    || abs(sub(a, b)) <= absolute))

/// Returns the sum of `a` and `b`, adding the real parts and the imaginary parts separately.
pub fn add(a: Complex, b: Complex) -> Complex =
  Complex(re(a) + re(b), imaginary_part(a) + imaginary_part(b))

/// Returns the difference of `a` and `b`, subtracting the real parts and the imaginary parts
/// separately.
pub fn sub(a: Complex, b: Complex) -> Complex =
  Complex(re(a) - re(b), imaginary_part(a) - imaginary_part(b))

/// `a * b`.
pub fn mul(a: Complex, b: Complex) -> Complex =
  Complex(
    re(a) * re(b) - imaginary_part(a) * imaginary_part(b),
    re(a) * imaginary_part(b) + imaginary_part(a) * re(b),
  )

/// The number with the signs of both parts flipped, including a zero's.
pub fn neg(z: Complex) -> Complex = Complex(-re(z), -imaginary_part(z))

/// The conjugate: the imaginary part's sign flipped.
pub fn conj(z: Complex) -> Complex = Complex(re(z), -imaginary_part(z))

/// `z` times the real number `factor`.
pub fn scale(z: Complex, factor: Float) -> Complex =
  Complex(re(z) * factor, imaginary_part(z) * factor)

/// `a / b`, by Smith's method: the divisor's smaller part is divided by its larger part first, so
/// nothing is squared and a quotient that fits is not lost to intermediate overflow. Dividing by
/// zero gives what each part divided by zero gives: infinities, or `NaN`s for zero over zero.
pub fn div(a: Complex, b: Complex) -> Complex =
  if re(b) == 0.0 && imaginary_part(b) == 0.0 { Complex(re(a) / re(b), imaginary_part(a) / re(b)) }
  else if re(b).abs() >= imaginary_part(b).abs() {
    let ratio = imaginary_part(b) / re(b);
    let over = re(b) + imaginary_part(b) * ratio;
    Complex((re(a) + imaginary_part(a) * ratio) / over, (imaginary_part(a) - re(a) * ratio) / over)
  } else {
    let ratio = re(b) / imaginary_part(b);
    let over = re(b) * ratio + imaginary_part(b);
    Complex((re(a) * ratio + imaginary_part(a)) / over, (imaginary_part(a) * ratio - re(a)) / over)
  }

/// `1 / z`.
pub fn reciprocal(z: Complex) -> Complex = div(one(), z)

/// `e` to the power `z`: `e^re` at the angle `im`. A real `z` gives a real result, keeping the sign
/// of the zero imaginary part.
pub fn exp(z: Complex) -> Complex = {
  let x = re(z);
  let y = imaginary_part(z);
  if y == 0.0 { Complex(x.exp(), y) } else if y.is_finite() {
    if x.is_infinite() && x < 0.0 {
      Complex(Float::copy_sign(0.0, y.cos()), Float::copy_sign(0.0, y.sin()))
    } else { Complex(x.exp() * y.cos(), x.exp() * y.sin()) }
  } else if x.is_infinite() { if x < 0.0 { Complex(0.0, 0.0) } else { Complex(x, Float::nan()) } }
  else { Complex(Float::nan(), Float::nan()) }
}

/// The natural logarithm: the logarithm of `abs` as the real part, and `arg` as the imaginary
/// part. It is cut along the negative real axis, where the imaginary part is `pi` above the cut and
/// `-pi` below it. The logarithm of zero has a real part of negative infinity.
pub fn ln(z: Complex) -> Complex = Complex(abs(z).ln(), arg(z))

/// The square root in the right half-plane. It is cut along the negative real axis, where the
/// root is on the positive imaginary axis above the cut and on the negative one below it.
pub fn sqrt(z: Complex) -> Complex = {
  let x = re(z);
  let y = imaginary_part(z);
  if x == 0.0 && y == 0.0 { Complex(0.0, y) }
  else if y.is_infinite() { Complex(Float::infinity(), y) }
  else if x.is_nan() { Complex(Float::nan(), Float::nan()) } else if x.is_infinite() {
    if x > 0.0 { Complex(x, if y.is_nan() { y } else { Float::copy_sign(0.0, y) }) }
    else { Complex(if y.is_nan() { y } else { 0.0 }, Float::infinity().copy_sign(y)) }
  } else if x.abs() >= 4e307 || y.abs() >= 4e307 { scale(finite_root(0.25 * x, 0.25 * y), 2.0) }
  else { finite_root(x, y) }
}

/// `z` to the power `w`: `exp` of `w` times `ln` of `z`, so it is cut where `ln` is. Anything to
/// the power zero is one, and zero to a power with a real part above zero is zero.
pub fn pow(z: Complex, w: Complex) -> Complex =
  if re(w) == 0.0 && imaginary_part(w) == 0.0 { one() }
  else if re(z) == 0.0 && imaginary_part(z) == 0.0 && re(w) > 0.0 { zero() }
  else { exp(mul(w, ln(z))) }

/// The hyperbolic sine.
pub fn sinh(z: Complex) -> Complex =
  if imaginary_part(z) == 0.0 { Complex(real_sinh(re(z)), imaginary_part(z)) } else {
    Complex(real_sinh(re(z)) * imaginary_part(z).cos(), real_cosh(re(z)) * imaginary_part(z).sin())
  }

/// The hyperbolic cosine.
pub fn cosh(z: Complex) -> Complex =
  Complex(real_cosh(re(z)) * imaginary_part(z).cos(), real_sinh(re(z)) * imaginary_part(z).sin())

/// Returns the hyperbolic tangent. With `x` and `y` the real and imaginary parts of `z`, and `d`
/// equal to `sinh(x)^2 + cos(y)^2`, the real part is `sinh(x) * cosh(x) / d` and the imaginary part
/// is `sin(y) * cos(y) / d`. This avoids the precision loss of dividing `sinh` by `cosh`. When `x`
/// is far from zero, the real part is returned as exactly `-1` or `1`.
pub fn tanh(z: Complex) -> Complex =
  if re(z).abs() > 22.0 {
    Complex(
      Float::copy_sign(1.0, re(z)),
      4.0 * imaginary_part(z).sin() * imaginary_part(z).cos() * Float::exp(-2.0 * re(z).abs()),
    )
  } else {
    let over = real_sinh(re(z)) * real_sinh(re(z))
      + imaginary_part(z).cos() * imaginary_part(z).cos();
    Complex(
      real_sinh(re(z)) * real_cosh(re(z)) / over,
      imaginary_part(z).sin() * imaginary_part(z).cos() / over,
    )
  }

/// The sine.
pub fn sin(z: Complex) -> Complex = times_minus_i(sinh(times_i(z)))

/// The cosine.
pub fn cos(z: Complex) -> Complex = cosh(times_i(z))

/// The tangent.
pub fn tan(z: Complex) -> Complex = times_minus_i(tanh(times_i(z)))

/// The inverse sine, its real part in `[-pi/2, pi/2]`. It is cut along the real axis outside
/// `-1..=1`.
pub fn asin(z: Complex) -> Complex = {
  let below = sqrt(Complex(1.0 - re(z), -imaginary_part(z)));
  let above = sqrt(Complex(1.0 + re(z), imaginary_part(z)));
  Complex(
    re(z).atan2(re(below) * re(above) - imaginary_part(below) * imaginary_part(above)),
    real_asinh(re(below) * imaginary_part(above) - imaginary_part(below) * re(above)),
  )
}

/// The inverse cosine, its real part in `[0, pi]`. It is cut along the real axis outside
/// `-1..=1`.
pub fn acos(z: Complex) -> Complex = {
  let below = sqrt(Complex(1.0 - re(z), -imaginary_part(z)));
  let above = sqrt(Complex(1.0 + re(z), imaginary_part(z)));
  Complex(
    2.0 * re(below).atan2(re(above)),
    real_asinh(re(above) * imaginary_part(below) - imaginary_part(above) * re(below)),
  )
}

/// The inverse tangent, its real part in `[-pi/2, pi/2]`. It is cut along the imaginary axis
/// outside `-i..=i`.
pub fn atan(z: Complex) -> Complex = times_minus_i(atanh(times_i(z)))

/// The inverse hyperbolic sine, its imaginary part in `[-pi/2, pi/2]`. It is cut along the
/// imaginary axis outside `-i..=i`.
pub fn asinh(z: Complex) -> Complex = times_minus_i(asin(times_i(z)))

/// The inverse hyperbolic cosine, its real part not negative and its imaginary part in
/// `[-pi, pi]`. It is cut along the real axis below `1`.
pub fn acosh(z: Complex) -> Complex = {
  let below = sqrt(Complex(re(z) - 1.0, imaginary_part(z)));
  let above = sqrt(Complex(re(z) + 1.0, imaginary_part(z)));
  Complex(
    real_asinh(re(below) * re(above) + imaginary_part(below) * imaginary_part(above)),
    2.0 * imaginary_part(below).atan2(re(above)),
  )
}

/// The inverse hyperbolic tangent, its imaginary part in `[-pi/2, pi/2]`. It is cut along the
/// real axis outside `-1..=1`, and is an infinity at `1` and at `-1`.
pub fn atanh(z: Complex) -> Complex = {
  let x = re(z);
  let y = imaginary_part(z);
  let a = x.abs();
  Complex(
    Float::copy_sign(0.25 * ln_one_plus(4.0 * a / ((1.0 - a) * (1.0 - a) + y * y)), x),
    0.5 * Float::atan2(2.0 * y, (1.0 - x) * (1.0 + x) - y * y),
  )
}

/// The two parts as `Float::to_string` writes each, with the imaginary part signed and followed by
/// `i`, as in `1.5+2.0i`, `-0.0-1e-7i` or `NaN+Infinityi`.
pub fn to_string(z: Complex) -> String =
  re(z).to_string() ++ (if imaginary_part(z).is_sign_negative() { "-" } else { "+" })
    ++ imaginary_part(z).abs().to_string()
    ++ "i"

/// Parses a number in the form `to_string` writes: a real part, a sign, an imaginary part and an
/// `i`. Each part is a `Float` as `Float::of_string` reads it, or `Infinity` or `NaN`. Returns
/// `None` for any other text.
pub fn parse(text: String) -> Option<Complex> = {
  let chars = text.chars();
  let n = chars.len();
  let split = range(1, n).fold(0, |found: Int, k: Int|
    if is_sign(chars.at_or(k, ' ')) && !is_exponent_mark(chars.at_or(k - 1, ' ')) { k }
    else { found });
  if split == 0 || chars.at_or(n - 1, ' ') != 'i' { None } else {
    match part(chars, 0, split) {
      None -> None,
      Some(real) -> match part(chars, split + 1, n - 1) {
        None -> None,
        Some(imaginary) -> if is_sign(chars.at_or(split + 1, ' ')) { None }
        else if chars.at_or(split, ' ') == '-' { Some(Complex(real, -imaginary)) }
        else { Some(Complex(real, imaginary)) },
      },
    }
  }
}

fn times_i(z: Complex) -> Complex = Complex(-imaginary_part(z), re(z))

fn times_minus_i(z: Complex) -> Complex = Complex(imaginary_part(z), -re(z))

fn finite_root(x: Float, y: Float) -> Complex =
  if x >= 0.0 {
    let t = Float::sqrt((x + x.hypot(y)) * 0.5);
    Complex(t, y / (2.0 * t))
  } else {
    let t = Float::sqrt((x.hypot(y) - x) * 0.5);
    Complex(y.abs() / (2.0 * t), t.copy_sign(y))
  }

fn real_sinh(x: Float) -> Float = {
  let a = x.abs();
  let x2 = x * x;
  if a < 0.5 {
    x
      * (1.0
      + x2 / 6.0
      * (1.0
      + x2 / 20.0
      * (1.0
      + x2 / 42.0
      * (1.0 + x2 / 72.0 * (1.0 + x2 / 110.0 * (1.0 + x2 / 156.0 * (1.0 + x2 / 210.0)))))))
  } else if a > 709.0 { Float::copy_sign(0.5 * Float::exp(0.5 * a) * Float::exp(0.5 * a), x) }
  else { Float::copy_sign(0.5 * (a.exp() - 1.0 / a.exp()), x) }
}

fn real_cosh(x: Float) -> Float = {
  let a = x.abs();
  if a > 709.0 { 0.5 * Float::exp(0.5 * a) * Float::exp(0.5 * a) }
  else { 0.5 * (a.exp() + 1.0 / a.exp()) }
}

fn ln_one_plus(u: Float) -> Float = {
  let sum = 1.0 + u;
  if sum == 1.0 { u } else { sum.ln() * (u / (sum - 1.0)) }
}

fn real_asinh(t: Float) -> Float = {
  let a = t.abs();
  if a > 1e150 { Float::copy_sign(a.ln() + Float::ln(2.0), t) }
  else { ln_one_plus(a + a * a / (1.0 + Float::sqrt(a * a + 1.0))).copy_sign(t) }
}

fn is_sign(c: Char) -> Bool = c == '+' || c == '-'

fn is_exponent_mark(c: Char) -> Bool = c == 'e' || c == 'E'

fn part(chars: List<Char>, from: Int, to: Int) -> Option<Float> = {
  let text = String::of_chars(chars.slice(from, to));
  if text == "NaN" { Some(Float::nan()) }
  else if text == "Infinity" { Some(Float::infinity()) }
  else if text == "-Infinity" { Some(Float::neg_infinity()) }
  else if from >= to { None }
  else { Float::of_string(text) }
}

fn same(a: Complex, b: Complex) -> Bool =
  same_part(re(a), re(b)) && same_part(imaginary_part(a), imaginary_part(b))

fn same_part(a: Float, b: Float) -> Bool =
  bits_of_float(a) == bits_of_float(b) || (a.is_nan() && b.is_nan())

fn matches_reference_part(got: Float, want: Float) -> Bool =
  if want.is_nan() { got.is_nan() }
  else if want == 0.0 || want.is_infinite() { bits_of_float(got) == bits_of_float(want) }
  else { got.is_close(want, 1e-12, 0.0) }

test "a number is its two parts, and the constants have their stated values" {
  let z = of_parts(1.5, -2.0);
  assert_eq(re(z), 1.5);
  assert_eq(imaginary_part(z), -2.0);
  assert_eq(of_float(2.5), Complex(2.5, 0.0));
  assert_eq(of_int(-3), Complex(-3.0, 0.0));
  assert_eq(mul(i(), i()), Complex(-1.0, 0.0));
  assert_eq(zero() + one(), one());
  assert(is_finite(z) && !is_nan(z) && !is_infinite(z));
  assert(
    is_nan(Complex(Float::nan(), 1.0)) && is_infinite(Complex(Float::nan(), Float::infinity())),
  );
  assert(!is_finite(Complex(1.0, Float::neg_infinity())))
}

test "`+`, `-`, `*` and unary `-` on complex numbers give the expected parts, and `==` compares each part by IEEE rules" {
  let a = Complex(1.0, 2.0);
  let b = Complex(3.0, -1.0);
  assert_eq(a + b, Complex(4.0, 1.0));
  assert_eq(a - b, Complex(-2.0, 3.0));
  assert_eq(a * b, Complex(5.0, 5.0));
  assert_eq(-a, Complex(-1.0, -2.0));
  assert_eq(conj(a), Complex(1.0, -2.0));
  assert_eq(scale(a, 2.0), Complex(2.0, 4.0));
  assert(Complex(0.0, -0.0) == Complex(-0.0, 0.0));
  assert(Complex(Float::nan(), 0.0) != Complex(Float::nan(), 0.0));
  assert(imaginary_part(conj(zero())).is_sign_negative() && re(-zero()).is_sign_negative())
}

test "Smith's division is exact where possible and does not overflow for a quotient that fits" {
  assert(is_close(div(Complex(5.0, 5.0), Complex(3.0, -1.0)), Complex(1.0, 2.0), 1e-15, 0.0));
  assert_eq(div(Complex(5.0, 5.0), Complex(1.0, 2.0)), Complex(3.0, -1.0));
  assert_eq(div(Complex(1e300, 1e300), Complex(1e300, 1e300)), Complex(1.0, 0.0));
  assert_eq(div(Complex(1e300, -1e300), Complex(2e-300, 2e300)), Complex(-0.5, -0.5));
  assert_eq(reciprocal(i()), Complex(0.0, -1.0));
  assert_eq(div(Complex(1.0, -1.0), zero()), Complex(Float::infinity(), Float::neg_infinity()));
  assert(is_nan(div(zero(), zero())))
}

test "`abs` does not overflow for large parts, and `arg` of a negative real is pi or -pi depending on the sign of a zero imaginary part" {
  assert_eq(abs(Complex(3.0, -4.0)), 5.0);
  assert(abs(Complex(3e200, 4e200)).is_close(5e200, 1e-15, 0.0));
  assert_eq(abs(Complex(Float::neg_infinity(), Float::nan())), Float::infinity());
  assert_eq(arg(Complex(-1.0, 0.0)), Float::pi());
  assert_eq(arg(Complex(-1.0, -0.0)), -Float::pi());
  assert_eq(arg(Complex(0.0, 1.0)), Float::pi() / 2.0);
  assert_eq(arg(one()), 0.0);
  assert_eq(to_polar(Complex(0.0, -2.0)), { r: 2.0, theta: -Float::pi() / 2.0 });
  assert(is_close(of_polar(2.0, Float::pi() / 2.0), Complex(0.0, 2.0), 1e-15, 0.0));
  assert_eq(of_polar(3.0, 0.0), Complex(3.0, 0.0))
}

type Point = { f: String, re: Int, imaginary: Int, want_re: Int, expected_im: Int }

fn applied(name: String, z: Complex) -> Complex / {abort.raise} =
  if name == "sqrt" { sqrt(z) }
  else if name == "ln" { ln(z) }
  else if name == "exp" { exp(z) }
  else if name == "sin" { sin(z) }
  else if name == "cos" { cos(z) }
  else if name == "tan" { tan(z) }
  else if name == "sinh" { sinh(z) }
  else if name == "cosh" { cosh(z) }
  else if name == "tanh" { tanh(z) }
  else if name == "asin" { asin(z) }
  else if name == "acos" { acos(z) }
  else if name == "atan" { atan(z) }
  else if name == "asinh" { asinh(z) }
  else if name == "acosh" { acosh(z) }
  else if name == "atanh" { atanh(z) }
  else { panic("no such function") }

fn reference_points() -> List<Point> =
  [
    {
      f: "sqrt",
      re: 0xC010000000000000,
      imaginary: 0x0000000000000000,
      want_re: 0x0000000000000000,
      expected_im: 0x4000000000000000,
    },
    {
      f: "sqrt",
      re: 0xC010000000000000,
      imaginary: 0x8000000000000000,
      want_re: 0x0000000000000000,
      expected_im: 0xC000000000000000,
    },
    {
      f: "sqrt",
      re: 0xBFF0000000000000,
      imaginary: 0x0000000000000000,
      want_re: 0x0000000000000000,
      expected_im: 0x3FF0000000000000,
    },
    {
      f: "sqrt",
      re: 0xBFF0000000000000,
      imaginary: 0x8000000000000000,
      want_re: 0x0000000000000000,
      expected_im: 0xBFF0000000000000,
    },
    {
      f: "sqrt",
      re: 0xC010000000000000,
      imaginary: 0x01A56E1FC2F8F359,
      want_re: 0x01856E1FC2F8F359,
      expected_im: 0x4000000000000000,
    },
    {
      f: "sqrt",
      re: 0xC010000000000000,
      imaginary: 0x81A56E1FC2F8F359,
      want_re: 0x01856E1FC2F8F359,
      expected_im: 0xC000000000000000,
    },
    {
      f: "sqrt",
      re: 0x0000000000000000,
      imaginary: 0x0000000000000000,
      want_re: 0x0000000000000000,
      expected_im: 0x0000000000000000,
    },
    {
      f: "sqrt",
      re: 0x8000000000000000,
      imaginary: 0x0000000000000000,
      want_re: 0x0000000000000000,
      expected_im: 0x0000000000000000,
    },
    {
      f: "sqrt",
      re: 0x0000000000000000,
      imaginary: 0x8000000000000000,
      want_re: 0x0000000000000000,
      expected_im: 0x8000000000000000,
    },
    {
      f: "sqrt",
      re: 0x8000000000000000,
      imaginary: 0x8000000000000000,
      want_re: 0x0000000000000000,
      expected_im: 0x8000000000000000,
    },
    {
      f: "sqrt",
      re: 0x4008000000000000,
      imaginary: 0x4010000000000000,
      want_re: 0x4000000000000000,
      expected_im: 0x3FF0000000000000,
    },
    {
      f: "sqrt",
      re: 0x4008000000000000,
      imaginary: 0xC010000000000000,
      want_re: 0x4000000000000000,
      expected_im: 0xBFF0000000000000,
    },
    {
      f: "sqrt",
      re: 0xC008000000000000,
      imaginary: 0x4010000000000000,
      want_re: 0x3FF0000000000000,
      expected_im: 0x4000000000000000,
    },
