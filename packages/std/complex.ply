test "the complex function `{c.f}` applied to {to_string(Complex(Float::of_bits(c.re), Float::of_bits(c.imaginary)))} gives the same real and imaginary parts as Python's `cmath`" for c: Point in reference_points(
  ) {
  let got = applied(c.f, Complex(Float::of_bits(c.re), Float::of_bits(c.imaginary)));
  assert(
    matches_reference_part(re(got), Float::of_bits(c.want_re))
      && matches_reference_part(imaginary_part(got), Float::of_bits(c.expected_im)),
    Some(
      to_string(got) ++ " is not "
        ++ to_string(Complex(Float::of_bits(c.want_re), Float::of_bits(c.expected_im))),
    ),
  )
}

test "complex functions return the C99 standard's special values for zeros and infinities, where Python's `cmath` raises an error" {
  let inf = Float::infinity();
  assert(same(ln(Complex(0.0, 0.0)), Complex(-inf, 0.0)));
  assert(same(ln(Complex(-0.0, 0.0)), Complex(-inf, Float::pi())));
  assert(same(ln(Complex(0.0, -0.0)), Complex(-inf, -0.0)));
  assert(same(ln(Complex(-0.0, -0.0)), Complex(-inf, -Float::pi())));
  assert(same(exp(Complex(1.0, inf)), Complex(Float::nan(), Float::nan())));
  assert(same(exp(Complex(-1.0, -inf)), Complex(Float::nan(), Float::nan())));
  assert(same(exp(Complex(inf, inf)), Complex(inf, Float::nan())));
  assert(same(exp(Complex(-inf, inf)), Complex(0.0, 0.0)))
}

test "`pow` equals the exponential of the exponent times the logarithm, with the logarithm's branch cut on the negative real axis" {
  let close = |got: Complex, x: Float, y: Float| is_close(got, Complex(x, y), 1e-12, 1e-15);
  assert(
    close(pow(Complex(-8.0, 0.0), Complex(1.0 / 3.0, 0.0)), 1.0000000000000002, 1.7320508075688772),
  );
  assert(close(pow(Complex(-1.0, -0.0), Complex(0.5, 0.0)), 6.123233995736766e-17, -1.0));
  assert(close(pow(Complex(2.0, 0.0), Complex(3.0, 0.0)), 8.0, 0.0));
  assert(close(pow(i(), i()), 0.20787957635076193, 0.0));
  assert(close(pow(Complex(1.0, 2.0), Complex(3.0, -1.0)), -27.43638199160605, 19.789310365010714));
  assert_eq(pow(zero(), zero()), one());
  assert_eq(pow(Complex(5.0, -7.0), zero()), one());
  assert_eq(pow(zero(), Complex(2.0, 1.0)), zero())
}

test "a number is written as its parts and read back, and other text does not parse" {
  assert_eq(to_string(Complex(1.5, 2.0)), "1.5+2.0i");
  assert_eq(to_string(Complex(-0.0, -1.5e-7)), "-0.0-1.5e-7i");
  assert_eq(f"{Complex(Float::nan(), Float::neg_infinity())}", "NaN-Infinityi");
  assert_eq(parse("1.5+2.0i"), Some(Complex(1.5, 2.0)));
  assert_eq(parse("-1e-5-2.5e3i"), Some(Complex(-1e-5, -2500.0)));
  assert(same(option_or_nan(parse("-0.0-0.0i")), Complex(-0.0, -0.0)));
  assert(
    same(
      option_or_nan(parse("Infinity-Infinityi")),
      Complex(Float::infinity(), Float::neg_infinity()),
    ),
  );
  assert(same(option_or_nan(parse("NaN+NaNi")), Complex(Float::nan(), Float::nan())));
  assert_eq(
    ["", "1.5", "2.0i", "1.5+2.0", "1.5+-2.0i", "1.5+i", "+i", "1.5 + 2.0i", "x+1i"].map(parse),
    [None, None, None, None, None, None, None, None, None],
  )
}

fn option_or_nan(z: Option<Complex>) -> Complex =
  match z { Some(found) -> found, None -> Complex(Float::nan(), Float::nan()) }

type IntPair = { a: Int, b: Int }

fn to_complex(p: IntPair) -> Complex =
  Complex(Float::of_int(p.a >> 46) / 64.0, Float::of_int(p.b >> 46) / 64.0)

fn arbitrary_int_pairs() -> gen::Gen<IntPair> =
  gen::map2(gen::any_int(), gen::any_int(), |a: Int, b: Int| { a: a, b: b })

test "division undoes multiplication" {
  gen::check2(arbitrary_int_pairs(), arbitrary_int_pairs(), |p: IntPair, q: IntPair| {
    (re(to_complex(q)) == 0.0 && imaginary_part(to_complex(q)) == 0.0)
      || is_close(div(to_complex(p) * to_complex(q), to_complex(q)), to_complex(p), 1e-12, 0.0)
  })
}

test "applying a function to the result of its inverse, such as `sin(asin(z))`, returns the original number" {
  gen::check(arbitrary_int_pairs(), |p: IntPair| {
    let z = scale(to_complex(p), 1.0 / 64.0);
    is_close(sin(asin(z)), z, 1e-9, 1e-12) && is_close(cos(acos(z)), z, 1e-9, 1e-12)
      && is_close(sinh(asinh(z)), z, 1e-9, 1e-12)
      && is_close(cosh(acosh(z)), z, 1e-9, 1e-12)
      && (re(z).abs() == 1.0 || is_close(tanh(atanh(z)), z, 1e-9, 1e-12))
      && (imaginary_part(z).abs() == 1.0 || is_close(tan(atan(z)), z, 1e-9, 1e-12))
  })
}

test "a number reads back from its text, bit for bit" {
  gen::check2(gen::float(), gen::float(), |x: Float, y: Float| {
    same(option_or_nan(parse(to_string(Complex(x, y)))), Complex(x, y))
  })
}
