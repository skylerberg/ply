//! Bytes written as hexadecimal text. The literal `hex"deadbeef"` is four bytes, decoded when the
//! program is checked.
//!
//! The text is lower case, two digits per byte. This is what `std.bytes`'s `hex_of` writes, and the
//! only form `decode` and the literal accept. Upper case is a different alphabet, RFC 4648's
//! base16, which `std.radix` provides alongside this one.

import std.bytes
import std.laws (round_trip)
import std.radix
import std.string
import std.gen

/// Decodes text that `hex_of` wrote back into its bytes. Returns `None` for any other text: an odd
/// length, an upper-case digit, or a character that is not a hex digit.
pub fn decode(text: String) -> Option<Bytes> / {abort.raise} = radix::decode(radix::hex(), text)

/// Decodes secret text as `decode` does, and returns the bytes as a secret. The runtime decodes
/// without revealing the text, and the time it takes depends only on the text's length. Returns
/// `None` for invalid text and reveals nothing else about it.
pub fn decode_secret(text: Secret<String>) -> Option<Secret<Bytes>> / {abort.raise} =
  Secret::decode("hex", text)

/// Checks a `hex"..."` literal. Returns the bytes the lower-case hex text encodes, or an error with
/// the reason and the offset where the text stops being valid hex.
pub fn literal(text: String) -> Result<Bytes, { message: String, offset: Int }> / {abort.raise} =
  match radix::parse(radix::hex(), text) {
    Ok(data) -> Ok(data),
    Err(r) ->
      Err({
        message: match r.reason {
          radix::TrailingSymbol -> "a byte is two hex digits, and this one has no pair",
          _ -> if upper_digit(text, r.at) { "hex is written in lower case" }
          else { "not a hex digit" },
        },
        offset: r.at,
      }),
  }

fn upper_digit(text: String, at: Int) -> Bool / {abort.raise} =
  "ABCDEF".contains(text.slice(at, at + 1))

test "decoding what hex_of writes returns the original bytes" {
  gen::check(gen::bytes(), |x: Bytes| round_trip(Bytes::hex_of, decode, x))
}

type Vector = { bytes: Bytes, text: String }

fn rfc_4648() -> List<Vector> =
  [
    { bytes: b"", text: "" },
    { bytes: b"f", text: "66" },
    { bytes: b"fo", text: "666F" },
    { bytes: b"foo", text: "666F6F" },
    { bytes: b"foob", text: "666F6F62" },
    { bytes: b"fooba", text: "666F6F6261" },
    { bytes: b"foobar", text: "666F6F626172" },
  ]

test "the RFC 4648 base16 test vector for {v.bytes} encodes to hex and decodes back" for v: Vector in rfc_4648(
  ) {
  assert_eq(radix::encode(radix::base16(), v.bytes), v.text);
  assert_eq(radix::decode(radix::base16(), v.text), Some(v.bytes));
  assert_eq(v.bytes.hex_of(), v.text.ascii_lower());
  assert_eq(decode(v.text.ascii_lower()), Some(v.bytes))
}

test "`decode_secret` decodes a hex `Secret` and rejects invalid input the same way `decode` does for a string" {
  let read = |text: String| decode_secret(Secret::of_string(text));
  assert_eq(read("666f"), Some(Secret::of_bytes(b"fo")));
  assert_eq(read(""), Some(Secret::of_bytes(b"")));
  assert_eq(read("00ff"), Some(Secret::of_bytes(b"\x00\xff")));
  assert_eq(read("666F"), None);
  assert_eq(read("666"), None);
  assert_eq(read("66 6f"), None);
  assert_eq(read("0x66"), None);
  assert_eq(read("6g"), None);
  assert_eq(read("/:`{"), None)
}

test "`decode` accepts lower-case hex digits and rejects upper-case ones, while `radix::decode` with `radix::base16()` rejects lower-case" {
  assert_eq(decode("666f"), Some(b"fo"));
  assert_eq(decode("666F"), None);
  assert_eq(radix::decode(radix::base16(), "666f"), None);
  assert_eq(decode("666"), None);
  assert_eq(decode("66 6f"), None);
  assert_eq(decode("0x66"), None)
}

test "`literal` returns the decoded bytes of lower-case hex, or an error at the offset of the first invalid character" {
  assert_eq(literal("deadbeef"), Ok(b"\xde\xad\xbe\xef"));
  assert_eq(literal(""), Ok(b""));
  assert_eq(literal("deadBeef"), Err({ message: "hex is written in lower case", offset: 4 }));
  assert_eq(literal("dead beef"), Err({ message: "not a hex digit", offset: 4 }));
  assert_eq(
    literal("deadbee"),
    Err({ message: "a byte is two hex digits, and this one has no pair", offset: 6 }),
  )
}
