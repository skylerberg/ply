//! The environment the process runs in, as an effect: its variables and its working directory.
//!
//! Every run may read its environment without a grant. The values come from the host, so the
//! effect is `nondet`; a test fixes them by passing an `Environment` to `on`. A command-line tool
//! reads its environment directly. A program that its user configures reads `std.config` instead,
//! which also takes keys from the command line and from files. When no handler in the program
//! handles an operation, `host_handler` handles it with the real process environment.

import std.internal.native (native, found, parts)

/// The process's environment.
pub nondet effect env {
  /// The value of the variable `name`; `None` where it is not set, or its value is not UTF-8.
  read variable(name: String) -> Option<String>
  /// Every variable whose name and value are both UTF-8, in the order the process stores them.
  read variables() -> List<{ name: String, value: String }>
  /// The directory the process runs in, as an absolute path, or `.` when it is unknown.
  read working_directory() -> String
}

// --- The fake ---------------------------------------------------------------

/// A fake environment that a test passes to `on` in place of the process's. When two variables
/// have the same name, the later one wins.
pub type Environment = {
  variables: List<{ name: String, value: String }>,
  working_directory: String,
}

/// An environment for a test to start from: no variables, and `/home/user` as the working
/// directory.
pub fn environment() -> Environment = { variables: [], working_directory: "/home/user" }

/// Runs `go` with every `env` operation handled from `e`.
pub fn on<a | f>(e: Environment, go: () -> a / {env.read | f}) -> a / f =
  handle {
    go()
  } with {
    env.variable(name) ->
      e.variables.fold(None, |found: Option<String>, v: { name: String, value: String }|
        if v.name == name { Some(v.value) } else { found }),
    env.variables() -> e.variables,
    env.working_directory() -> e.working_directory,
  }

// --- The host handler -------------------------------------------------------

host for env by host_handler

/// Runs `go` with every `env` operation handled by the process the program runs in.
fn host_handler<a | f>(go: () -> a / {env.read | f}) -> a / {native.read, abort.raise | f} =
  handle {
    go()
  } with {
    env.variable(name) -> match found(env_variable(name)) {
      Some(value) -> Some(String::of_bytes_lossy(value)),
      None -> None,
    },
    env.variables() ->
      parts(env_variables()).map(|both: Bytes|
        match parts(both) {
          [name, value] ->
            { name: String::of_bytes_lossy(name), value: String::of_bytes_lossy(value) },
          _ -> panic("the environment returned a variable that is not a name and a value"),
        }),
    env.working_directory() -> String::of_bytes_lossy(env_working_directory()),
  }

/// The value of the variable `name`, encoded for `found`: present only when it is set and UTF-8.
extern fn env_variable(name: String) -> Bytes / {native.read}

/// Every variable whose name and value are UTF-8, encoded as `parts`. Each part is one variable's
/// name and value, themselves encoded as `parts`.
extern fn env_variables() -> Bytes / {native.read}

/// The directory the process runs in.
extern fn env_working_directory() -> Bytes / {native.read}

// --- Tests ------------------------------------------------------------------

test "the fake returns each variable, and a later variable of a name hides an earlier one" {
  let e = {
    ..environment(),
    variables: [
      { name: "HOME", value: "/a" },
      { name: "TERM", value: "dumb" },
      { name: "HOME", value: "/b" },
    ],
  };
  assert_eq(on(e, || env.variable("HOME")), Some("/b"));
  assert_eq(on(e, || env.variable("TERM")), Some("dumb"));
  assert_eq(on(e, || env.variable("PATH")), None);
  assert_eq(on(e, || env.variables().len()), 3);
  assert_eq(on(e, || env.working_directory()), "/home/user")
}
