//! The environment the process runs in, as an effect: its variables and its working directory.
//!
//! The environment is open to every run, so nothing grants it, and every answer is the host's, so
//! the effect is `nondet`: a test fixes it over an `Environment` with `on`. A program that is a
//! tool reads its environment; a program configured by whoever runs it reads `std.config`, whose
//! keys come from the command line and files as well as the environment. Where nothing of the
//! program answers an operation, the process does: `served` is the effect's real handler.

import std.internal.native (native, found, parts)

/// The process's environment.
pub nondet effect env {
  /// The value of the variable `name`; `None` where it is not set, or its value is not UTF-8.
  read variable(name: String) -> Option<String>
  /// Every variable whose name and value are both UTF-8, in the order the process holds them.
  read variables() -> List<{ name: String, value: String }>
  /// The directory the process runs in, as an absolute path; `.` where the system does not say.
  read working_directory() -> String
}

// --- The twin ---------------------------------------------------------------

/// What a test hands `on` in place of the process: its variables, a later one of a name hiding an
/// earlier, and its working directory.
pub type Environment = { variables: List<{ name: String, value: String }>, working_directory: String }

/// An environment to start a test's from: no variables, run from `/home/user`.
pub fn environment() -> Environment = { variables: [], working_directory: "/home/user" }

/// `go` run in the environment `e`: every operation answered from it.
pub fn on<a | f>(e: Environment, go: () -> a / {env.read | f}) -> a / f =
  handle {
    go()
  } with {
    env.variable(name) ->
      e.variables.fold(None, |found: Option<String>, v: { name: String, value: String }|
        if v.name == name { Some(v.value) } else { found }),
    env.variables() -> e.variables,
    env.working_directory() -> e.working_directory,
  }

// --- The real handler -------------------------------------------------------

host for env by served

/// `go` with every operation answered by the process the program runs in.
fn served<a | f>(go: () -> a / {env.read | f}) -> a / {native.read, abort.raise | f} =
  handle {
    go()
  } with {
    env.variable(name) -> match found(env_variable(name)) {
      Some(value) -> Some(String::of_bytes_lossy(value)),
      None -> None,
    },
    env.variables() -> parts(env_variables()).map(|both: Bytes| match parts(both) {
      [name, value] -> { name: String::of_bytes_lossy(name), value: String::of_bytes_lossy(value) },
      _ -> panic("the environment's native wrote no variable"),
    }),
    env.working_directory() -> String::of_bytes_lossy(env_working_directory()),
  }

/// The value of the variable `name`, found where it is set and UTF-8.
extern fn env_variable(name: String) -> Bytes / {native.read}

/// Every variable whose name and value are UTF-8, each its name and value as parts, as parts.
extern fn env_variables() -> Bytes / {native.read}

/// The directory the process runs in.
extern fn env_working_directory() -> Bytes / {native.read}

// --- Tests ------------------------------------------------------------------

test "the twin answers each variable and a later one of a name hides an earlier" {
  let e = {
    ..environment(),
    variables: [{ name: "HOME", value: "/a" }, { name: "TERM", value: "dumb" }, { name: "HOME", value: "/b" }],
  };
  assert_eq(on(e, || env.variable("HOME")), Some("/b"));
  assert_eq(on(e, || env.variable("TERM")), Some("dumb"));
  assert_eq(on(e, || env.variable("PATH")), None);
  assert_eq(on(e, || env.variables().len()), 3);
  assert_eq(on(e, || env.working_directory()), "/home/user")
}
