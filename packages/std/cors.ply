//! Cross-origin resource sharing (CORS): a policy as a value, the response to a preflight, and the
//! headers a response to a cross-origin request carries.
//!
//! `policy` makes a `Policy` from what it should allow. It fails with `cors.fail` for a policy that
//! allows any origin together with credentials. A browser ignores `*` with credentials, and the
//! usual workaround, echoing back whatever `Origin` arrives, gives every site access to a user's
//! session. An origin is `scheme://host`, with a port when it is not the scheme's default, as a
//! browser sends it. Origins are compared case-insensitively.
//!
//! `serving` responds to a preflight itself, and adds the CORS headers to the app's response to any
//! other request. Each response states that it varies by `Origin`, unless the policy treats every
//! origin the same. A preflight response also varies by the method and headers it requested. This
//! way a cache never serves one origin's response to another. A preflight that requests something
//! the policy does not allow gets a 403 with no CORS headers, which the browser treats as a denial.

import std.http
import std.http (Method, Request, Response)
import std.ip
import std.ip (ip)
import std.list
import std.mime (is_token)
import std.net
import std.net (Sends, net)
import std.string
import std.url

/// Which origins a policy admits.
pub type Origins =
  /// Every origin, sent as `*`. Cannot be combined with credentials.
  | AnyOrigin
  /// Only these origins.
  | Listed(List<String>)

/// What a policy should allow.
pub type PolicyOptions = {
  origins: Origins,
  /// The methods a preflight may request, beyond `GET`, `HEAD` and `POST`, which are always
  /// allowed.
  methods: List<Method>,
  /// The request headers a preflight may request, beyond the headers that browsers always allow
  /// (such as `Accept` and `Content-Language`).
  headers: List<String>,
  /// The response headers a script may read, beyond the headers that browsers always expose (such
  /// as `Content-Type` and `Cache-Control`).
  exposed: List<String>,
  /// Whether a request may carry cookies and `Authorization`, with a script then allowed to read
  /// the response.
  credentials: Bool,
  /// How long a browser may cache a preflight's response.
  max_age_seconds: Option<Int>,
}

/// A checked policy, made by `policy`. It stores what it allows, with origins and header names in
/// lower case.
pub opaque type Policy = new { wanted: PolicyOptions }

/// Why a policy cannot be made.
pub type Error =
  /// The options allow any origin and also allow credentials, which `policy` rejects.
  | AnyOriginWithCredentials
  /// Not an origin, which is an `http` or `https` URL with only a host and an optional port.
  | NotAnOrigin(String)
  /// Not a valid header name.
  | NotAField(String)

/// The errors this module raises.
pub effect cors {
  /// The policy cannot be made.
  raise fail(reason: Error)
}

/// Returns options that allow only the listed origins, with no methods beyond the CORS-safelisted
/// ones (`GET`, `HEAD` and `POST`), no extra headers, no credentials, and no caching of preflight
/// responses.
pub fn policy_options(origins: List<String>) -> PolicyOptions =
  {
    origins: Listed(origins),
    methods: [],
    headers: [],
    exposed: [],
    credentials: false,
    max_age_seconds: None,
  }

/// The policy that allows what `w` requests. Raises `cors.fail` where `try_policy` returns `Err`.
pub fn policy(w: PolicyOptions) -> Policy / {cors.fail, abort.raise} =
  if w.origins == AnyOrigin && w.credentials { cors.fail(AnyOriginWithCredentials) } else {
    let origins = match w.origins {
      AnyOrigin -> AnyOrigin,
      Listed(listed) -> Listed(listed.map(|o: String| origin_checked(o))),
    };
    let headers = w.headers.map(|h: String| field_checked(h));
    let exposed = w.exposed.map(|h: String| field_checked(h));
    { wanted: { ..w, origins: origins, headers: headers, exposed: exposed } }
  }

/// The policy that allows what `w` requests, or the reason it cannot be made.
pub fn try_policy(w: PolicyOptions) -> Result<Policy, Error> / {abort.raise} = try { policy(w) }

/// Returns the options `p` was made from, with origins and header names in lower case.
pub fn allows(p: Policy) -> PolicyOptions = p.wanted

fn origin_checked(o: String) -> String / {cors.fail, abort.raise} =
  match url::url_parse(o) {
    Ok(u) -> if (url::url_scheme(u) == "http" || url::url_scheme(u) == "https")
        && url::url_host(u) != None
        && url::url_userinfo(u) == None
        && url::url_path(u) == ""
        && url::url_query(u) == None
        && url::url_fragment(u) == None { o.ascii_lower() }
    else { cors.fail(NotAnOrigin(o)) },
    Err(_) -> cors.fail(NotAnOrigin(o)),
  }

fn field_checked(h: String) -> String / {cors.fail} =
  if is_token(h) { h.ascii_lower() } else { cors.fail(NotAField(h)) }

fn safelisted() -> List<String> = ["accept", "accept-language", "content-language", "content-type"]

fn allowed_origin(p: Policy, request: Request) -> Option<String> =
  match http::header(request.headers, "origin") {
    None -> None,
    Some(o) -> {
      let lower = o.ascii_lower();
      match p.wanted.origins {
        AnyOrigin -> Some(lower),
        Listed(listed) -> if listed.contains(lower) { Some(lower) } else { None },
      }
    },
  }

/// Returns whether `request` is a preflight: an `OPTIONS` request with an `Origin` header and an
/// `Access-Control-Request-Method` header.
pub fn is_preflight(request: Request) -> Bool =
  request.method == http::Options && http::has_header(request.headers, "origin")
    && http::has_header(request.headers, "access-control-request-method")

/// Returns the response to a preflight. If `p` allows the origin, the requested method and the
/// requested headers, the response is a 204 carrying the CORS headers for that origin. Otherwise it
/// is a 403 with no CORS headers.
pub fn preflight<| e>(p: Policy, request: Request) -> Response<| e> = {
  let asked_method = match http::header(request.headers, "access-control-request-method") {
    Some(m) -> m.ascii_trim(),
    None -> "",
  };
  let asked_fields = http::header_lines(request.headers, "access-control-request-headers").fold(
    [],
    |accumulator: List<String>, line: String|
      line.split(",").fold(accumulator, |inner: List<String>, part: String| {
        let t = part.ascii_trim().ascii_lower();
        if t.len() == 0 { inner } else { inner.push(t) }
      }),
  );
  match allowed_origin(p, request) {
    None -> vary_preflight(p, http::text_response(403, "this origin may not ask for that\n")),
    Some(origin) -> if !method_allowed(p, asked_method)
        || asked_fields.any(|f: String|
          !p.wanted.headers.contains(f) && !safelisted().contains(f)) {
      vary_preflight(p, http::text_response(403, "this origin may not ask for that\n"))
    } else {
      let base = with_origin(p, origin, http::response(204, b""));
      let methods = set_list(
        base,
        "access-control-allow-methods",
        p.wanted.methods.map(http::method_name),
      );
      let fields = set_list(methods, "access-control-allow-headers", asked_fields);
      let response = match p.wanted.max_age_seconds {
        Some(s) ->
          {
            ..fields,
            headers: http::set_header(fields.headers, "access-control-max-age", s.to_string()),
          },
        None -> fields,
      };
      vary_preflight(p, response)
    },
  }
}

fn vary_preflight<| e>(p: Policy, r: Response<| e>) -> Response<| e> =
  http::vary(
    http::vary(vary_by_origin(p, r), "Access-Control-Request-Method"),
    "Access-Control-Request-Headers",
  )

fn method_allowed(p: Policy, name: String) -> Bool =
  name == "GET" || name == "HEAD" || name == "POST"
    || p.wanted.methods.any(|m: Method| http::method_name(m) == name)

fn set_list<| e>(r: Response<| e>, name: String, items: List<String>) -> Response<| e> =
  match items {
    [] -> r,
    _ ->
      {
        ..r,
        headers: http::set_header(
          r.headers,
          name,
          items.fold("", |accumulator: String, i: String|
            if accumulator.len() == 0 { i } else { accumulator ++ ", " ++ i }),
        ),
      },
  }

fn with_origin<| e>(p: Policy, origin: String, r: Response<| e>) -> Response<| e> = {
  let named = match p.wanted.origins { AnyOrigin -> "*", Listed(_) -> origin };
  let allowed = { ..r, headers: http::set_header(r.headers, "access-control-allow-origin", named) };
  if p.wanted.credentials {
    {
      ..allowed,
      headers: http::set_header(allowed.headers, "access-control-allow-credentials", "true"),
    }
  } else { allowed }
}

fn vary_by_origin<| e>(p: Policy, r: Response<| e>) -> Response<| e> =
  match p.wanted.origins { AnyOrigin -> r, Listed(_) -> http::vary(r, "Origin") }

/// `response`, the response to `request`, with the CORS headers `p` gives the request's origin. Adds none if
/// `request` has no origin or `p` does not allow it.
pub fn with_cors_headers<| e>(
  p: Policy,
  request: Request,
  response: Response<| e>,
) -> Response<| e> =
  vary_by_origin(p, match allowed_origin(p, request) {
    None -> response,
    Some(origin) ->
      set_list(with_origin(p, origin, response), "access-control-expose-headers", p.wanted.exposed),
  })

/// Responds to a preflight with `preflight`, and to any other request with `app`'s response plus
/// `with_cors_headers`.
pub fn serving<| e, s>(
  p: Policy,
  request: Request,
  app: (Request) -> Response<| s> / e,
) -> Response<| s> / e =
  if is_preflight(request) { preflight(p, request) }
  else { with_cors_headers(p, request, app(request)) }

fn shop() -> Policy / {abort.raise} =
  match try_policy({
      ..policy_options(["https://Shop.Example.com", "http://localhost:8080"]),
      methods: [http::Put, http::Delete],
      headers: ["X-Request-Id", "Authorization"],
      exposed: ["X-Total"],
      credentials: true,
      max_age_seconds: Some(600),
    }) {
    Ok(p) -> p,
    Err(_) -> panic("the shop's policy options are invalid"),
  }

fn request(
  method: http::Method,
  fields: List<{ name: String, value: String }>,
) -> Request / {abort.raise} = {
  let bare = http::request_to(method, "api.example.com", "/orders", b"");
  {
    ..bare,
    headers: fields.fold(
      http::empty_headers(),
      |h: http::Headers, f: { name: String, value: String }| http::add_header(h, f.name, f.value),
    ),
  }
}

test "a CORS policy is rejected when it allows any origin with credentials, when an allowed origin is not a valid origin, and when a header name is invalid" {
  assert_eq(
    try_policy({ ..policy_options([]), origins: AnyOrigin, credentials: true }),
    Err(AnyOriginWithCredentials),
  );
  assert_eq(
    try_policy(policy_options(["https://example.com/path"])),
    Err(NotAnOrigin("https://example.com/path")),
  );
  assert_eq(try_policy(policy_options(["example.com"])), Err(NotAnOrigin("example.com")));
  assert_eq(
    try_policy({ ..policy_options([]), headers: ["bad field"] }),
    Err(NotAField("bad field")),
  );
  assert(try_policy({ ..policy_options([]), origins: AnyOrigin }) != Err(AnyOriginWithCredentials))
}

test "a preflight from an allowed origin gets the methods and headers it may use" {
  let r = preflight(
    shop(),
    request(http::Options, [
      { name: "Origin", value: "https://shop.example.com" },
      { name: "Access-Control-Request-Method", value: "PUT" },
      { name: "Access-Control-Request-Headers", value: "x-request-id, Content-Type" },
    ]),
  );
  assert_eq(r.status, 204);
  assert_eq(
    http::header(r.headers, "access-control-allow-origin"),
    Some("https://shop.example.com"),
  );
  assert_eq(http::header(r.headers, "access-control-allow-credentials"), Some("true"));
  assert_eq(http::header(r.headers, "access-control-allow-methods"), Some("PUT, DELETE"));
  assert_eq(
    http::header(r.headers, "access-control-allow-headers"),
    Some("x-request-id, content-type"),
  );
  assert_eq(http::header(r.headers, "access-control-max-age"), Some("600"));
  assert_eq(
    http::header(r.headers, "vary"),
    Some("Origin, Access-Control-Request-Method, Access-Control-Request-Headers"),
  )
}

test "a preflight request that the policy does not allow gets status 403 and no Access-Control-Allow-Origin header: {c.what}" for c: { what: String, origin: String, method: String, fields: String } in [
    { what: "another origin", origin: "https://evil.example.org", method: "PUT", fields: "" },
    {
      what: "a method not listed",
      origin: "https://shop.example.com",
      method: "PATCH",
      fields: "",
    },
    {
      what: "a field not listed",
      origin: "https://shop.example.com",
      method: "PUT",
      fields: "x-secret",
    },
  ] {
  let r = preflight(
    shop(),
    request(http::Options, [
      { name: "Origin", value: c.origin },
      { name: "Access-Control-Request-Method", value: c.method },
      { name: "Access-Control-Request-Headers", value: c.fields },
    ]),
  );
  assert_eq(r.status, 403);
  assert_eq(http::header(r.headers, "access-control-allow-origin"), None);
  assert(http::header(r.headers, "vary") != None)
}

fn listing<| e>(request: Request) -> Response<| e> = http::text_response(200, "[]")

test "a response echoes an allowed Origin in Access-Control-Allow-Origin, omits it for other origins, and sets Vary: Origin" {
  let p = shop();
  let admitted_one = serving(
    p,
    request(http::Get, [{ name: "Origin", value: "http://localhost:8080" }]),
    listing,
  );
  assert_eq(
    http::header(admitted_one.headers, "access-control-allow-origin"),
    Some("http://localhost:8080"),
  );
  assert_eq(http::header(admitted_one.headers, "access-control-expose-headers"), Some("x-total"));
  assert_eq(http::header(admitted_one.headers, "vary"), Some("Origin"));
  let stranger = serving(
    p,
    request(http::Get, [{ name: "Origin", value: "https://evil.example.org" }]),
    listing,
  );
  assert_eq(http::header(stranger.headers, "access-control-allow-origin"), None);
  assert_eq(http::header(stranger.headers, "vary"), Some("Origin"));
  let same_site = serving(p, request(http::Get, []), listing);
  assert_eq(same_site.status, 200);
  assert_eq(http::header(same_site.headers, "access-control-allow-origin"), None)
}

test "a preflight and the request it allowed are both served over one connection" {
  let request = b"OPTIONS /orders HTTP/1.1\r\nHost: api.example.com\r\nOrigin: https://shop.example.com\r\nAccess-Control-Request-Method: DELETE\r\n\r\nDELETE /orders HTTP/1.1\r\nHost: api.example.com\r\nOrigin: https://shop.example.com\r\nConnection: close\r\n\r\n";
  let ran = net::on_mem(
    net::mem_calling(net::mem_empty(), ip::read_socket("198.51.100.4:5000"), [Sends(request)]),
    || {
      let listener = net.listen[listener](0);
      http::serve_connection[conn](
        net.accept[listener](listener),
        http::default_limits(),
        |request: Request| serving(shop(), request, listing),
      )
    },
  );
  let wire = String::of_bytes_lossy(net::mem_sent(ran.net, 2));
  assert(wire.starts_with("HTTP/1.1 204 No Content\r\n"));
  assert(wire.contains("access-control-allow-methods: PUT, DELETE\r\n"));
  assert(wire.contains("HTTP/1.1 200 OK\r\naccess-control-allow-credentials: true\r\n"));
  assert(wire.contains("access-control-expose-headers: x-total\r\n"))
}

test "a policy for any origin sends `*`, without credentials" {
  match try_policy({ ..policy_options([]), origins: AnyOrigin }) {
    Ok(p) -> {
      let r = serving(
        p,
        request(http::Get, [{ name: "Origin", value: "https://anyone.example" }]),
        listing,
      );
      assert_eq(http::header(r.headers, "access-control-allow-origin"), Some("*"));
      assert_eq(http::header(r.headers, "access-control-allow-credentials"), None);
      assert_eq(http::header(r.headers, "vary"), None)
    },
    Err(_) -> panic("a policy for any origin without credentials is one"),
  }
}
