//! Throwaway self-signed certificates for benches and tests.
//!
//! A `localhost` certificate is generated where the run is, so nothing checked in is either expired
//! or shipping its private key.
//!
//! The machine generates one, with no grant; a test handles the effect over `canned`.

import std.bytes
import std.hash (sha256)
import std.internal.native (native, told, parts)

/// A source of fresh self-signed certificates.
pub nondet effect certgen {
  /// A new key and a certificate for it; each call makes a new key.
  read issue() -> Certificate
}

/// A fresh certificate, its key, and what a client trusts it by.
pub type Certificate = {
  /// The certificate and its private key, PEM-encoded, as `--tls NAME=CERT,KEY` wants them.
  certificate: String,
  key: String,
  /// The certificate's DER bytes, for a client that trusts exactly this one.
  der: Bytes,
  /// The certificate's SHA-256 fingerprint, `sha256:` and lowercase hex; how `ply hosts` prints
  /// one.
  fingerprint: String,
}

/// The one every bench asks for: `localhost`, and the names a local listener is reached by.
pub fn localhost() -> Certificate / {certgen.issue bounded} = certgen.issue()

// --- The real handler -------------------------------------------------------

host for certgen by host_handler

/// `go` with every certificate it asks for generated on the machine the program runs on.
fn host_handler<a | e>(go: () -> a / {certgen.read | e}) -> a / {native.read, abort.raise | e} =
  handle { go() } with { certgen.issue() -> certificate_of(told("a certificate", certgen_issue())) }

/// The certificate whose certificate, key, DER and fingerprint are `response`'s parts.
fn certificate_of(response: Bytes) -> Certificate / {abort.raise} =
  match parts(response) {
    [certificate, key, der, fingerprint] ->
      {
        certificate: String::of_bytes_lossy(certificate),
        key: String::of_bytes_lossy(key),
        der: der,
        fingerprint: String::of_bytes_lossy(fingerprint),
      },
    _ -> panic("the machine told a certificate of other than four parts"),
  }

/// A new self-signed certificate for `localhost`, told: its certificate, its key, its DER and its
/// fingerprint as parts.
extern fn certgen_issue() -> Bytes / {native.read}

// --- Tests ------------------------------------------------------------------

/// What a test hands the clause below in place of the host: the certificate it stands in for.
pub fn canned(certificate: String, key: String, der: Bytes, fingerprint: String) -> Certificate =
  { certificate: certificate, key: key, der: der, fingerprint: fingerprint }

test "a program that asks for a certificate is tested without generating one" {
  let stood_in = canned("CERT", "KEY", b"der", "ab");
  let asked = handle {
    let certificate_of = localhost();
    {
      cert: certificate_of.certificate,
      key: certificate_of.key,
      der: certificate_of.der,
      at: certificate_of.fingerprint,
    }
  } with {
    certgen.issue() -> stood_in,
  };
  assert_eq(asked.cert, "CERT");
  assert_eq(asked.key, "KEY");
  assert_eq(asked.der, b"der");
  assert_eq(asked.at, "ab")
}

test/nondet "the machine issues a fresh certificate each time, named by its DER's digest" {
  let first = localhost();
  let second = localhost();
  assert(first.certificate.starts_with("-----BEGIN CERTIFICATE-----"));
  assert(first.key.starts_with("-----BEGIN PRIVATE KEY-----"));
  assert_eq(first.fingerprint, "sha256:" ++ sha256(first.der).hex_of());
  assert(first.der != second.der);
  assert(first.fingerprint != second.fingerprint)
}
