test "`{c.written}` is how its string is written, and reads back" for c: SpellingCase in spellings(
  ) {
  assert_eq(to_string(String(c.text)), c.written ++ "\n");
  assert_eq(parse_string(c.written ++ "\n", limited()), Ok(String(c.text)))
}

test "a string inside a flow collection is quoted where one of its indicators would end it" {
  assert_eq(
    inline(strings(["a, b", "[a]", "a]b", "a{b", "a: b", "plain", "two\nlines\n", "yes", "-a"])),
    "[\"a, b\", \"[a]\", \"a]b\", \"a{b\", \"a: b\", plain, \"two\\nlines\\n\", \"yes\", -a]",
  );
  assert_eq(
    must_parse(
      "[\"a, b\", \"[a]\", \"a]b\", \"a{b\", \"a: b\", plain, \"two\\nlines\\n\", \"yes\", -a]",
    ),
    strings(["a, b", "[a]", "a]b", "a{b", "a: b", "plain", "two\nlines\n", "yes", "-a"]),
  )
}

test "a tag, a key that is not a short scalar and an indented block are each written so they read back" {
  let odd = Mapping([
    entry("k", String(" indented\nline\n")),
    entry("l", Sequence([String("a\n\nb")])),
    entry("m", Tagged("!t", String("x\ny\n"))),
    entry("n", Tagged("tag:yaml.org,2002:binary", Sequence([Integer(1)]))),
    entry("o", Tagged("a b%é", Mapping([entry("p", Null)]))),
    entry("q", Tagged("!t", String(""))),
    { key: Tagged("!k", String("tagged key")), value: Float(1.0) },
    { key: Null, value: Float(-0.0) },
    { key: Mapping([]), value: Sequence([]) },
    { key: String("a\nb"), value: Integer(1) },
  ]);
  let text =
    \\k: |2
    \\   indented
    \\  line
    \\l:
    \\  - |-
    \\    a
    \\
    \\    b
    \\m: !t |
    \\  x
    \\  y
    \\"n": !!binary
    \\  - 1
    \\o: !<a%20b%25%c3%a9>
    \\  p: null
    \\q: !t ""
    \\? !k tagged key
    \\: 1.0
    \\null: -0.0
    \\{}: []
    \\"a\nb": 1
    \\
  ;
  assert_eq(to_string(odd), text);
  assert_eq(
    parse_string(text, limited(), {
      merge_keys: false,
      keep_tags: ["!t", "!k", "a b%é", "tag:yaml.org,2002:binary"],
    }),
    Ok(odd),
  );
  let long = Mapping([entry("long ".repeat(120), Integer(1))]);
  assert(to_string(long).starts_with("? \"long long"));
  assert_eq(parse(to_bytes(long), limited()), Ok(long))
}

test "a value a maker would not build is written as the value it means" {
  assert_eq(to_string(Mapping([entry("a", Integer(1)), entry("a", Integer(2))])), "a: 2\n");
  assert_eq(to_string(Tagged("!t", Integer(12))), "!t \"12\"\n");
  assert_eq(to_string(Tagged("!t", Tagged("!u", String("x")))), "!t x\n");
  assert_eq(to_string(Tagged("", String("x"))), "x\n");
  assert_eq(to_string(Tagged("tag:yaml.org,2002:str", Integer(1))), "1\n")
}

test "the documents of a stream are written each after its marker" {
  let documents = [
    Null,
    String("a"),
    must_parse("[1, 2]"),
    must_parse("a: 1"),
    Tagged("!t", must_parse("a: 1")),
    String("x\ny\n"),
  ];
  assert_eq(
    String::of_bytes_lossy(stream_to_bytes(documents)),
    "---\nnull\n---\na\n---\n- 1\n- 2\n---\na: 1\n---\n!t\na: 1\n---\n|\n  x\n  y\n",
  );
  assert_eq(
    parse_all(stream_to_bytes(documents), limited(), { merge_keys: false, keep_tags: ["!t"] }),
    Ok(documents),
  );
  assert_eq(stream_to_bytes([]), b"")
}

// --- Tests: events ----------------------------------------------------------

test "the events of a stream are placed where they are written, comments included" {
  let scan_plain_scalar: Properties = { anchor: None, tag: None };
  assert_eq(
    try { events(b"# top\na: [1, &x two] # tail\nb: !!str |\n  text\n", limited()) },
    Ok([
      { kind: StreamStart, from: 0, to: 0 },
      { kind: Comment(" top"), from: 0, to: 5 },
      { kind: DocumentStart(false), from: 6, to: 6 },
      { kind: MappingStart(scan_plain_scalar, false), from: 6, to: 6 },
      { kind: Scalar(scan_plain_scalar, "a", Plain), from: 6, to: 7 },
      { kind: SequenceStart(scan_plain_scalar, true), from: 9, to: 10 },
      { kind: Scalar(scan_plain_scalar, "1", Plain), from: 10, to: 11 },
      { kind: Scalar({ anchor: Some("x"), tag: None }, "two", Plain), from: 13, to: 19 },
      { kind: SequenceEnd, from: 19, to: 20 },
      { kind: Comment(" tail"), from: 21, to: 27 },
      { kind: Scalar(scan_plain_scalar, "b", Plain), from: 28, to: 29 },
      {
        kind: Scalar({ anchor: None, tag: Some("tag:yaml.org,2002:str") }, "text\n", Literal),
        from: 31,
        to: 46,
      },
      { kind: MappingEnd, from: 46, to: 46 },
      { kind: DocumentEnd(false), from: 46, to: 46 },
      { kind: StreamEnd, from: 46, to: 46 },
    ]),
  );
  assert_eq(location_at(b"# top\na: [1, &x two] # tail\n", 13), { line: 2, column: 8 })
}

test "events report what a value does not: styles, markers, an alias, a tag no reader keeps, a key twice" {
  let kinds = |text: String|
    Result::map(try { events(Bytes::of_string(text), limited()) }, |es: List<Event>|
      es.map(|e: Event| e.kind));
  let scan_plain_scalar: Properties = { anchor: None, tag: None };
  assert_eq(
    kinds("--- !local 'a'\n...\n--- >-\n b\n"),
    Ok([
      StreamStart,
      DocumentStart(true),
      Scalar({ anchor: None, tag: Some("!local") }, "a", SingleQuoted),
      DocumentEnd(true),
      DocumentStart(true),
      Scalar(scan_plain_scalar, "b", Folded),
      DocumentEnd(false),
      StreamEnd,
    ]),
  );
  assert_eq(
    kinds("{a: *x, a: \"y\"}"),
    Ok([
      StreamStart,
      DocumentStart(false),
      MappingStart(scan_plain_scalar, true),
      Scalar(scan_plain_scalar, "a", Plain),
      Alias("x"),
      Scalar(scan_plain_scalar, "a", Plain),
      Scalar(scan_plain_scalar, "y", DoubleQuoted),
      MappingEnd,
      DocumentEnd(false),
      StreamEnd,
    ]),
  );
  assert_eq(kinds("a: [\n").map_err(|e: Error| e.reason), Err(Expected("a node")))
}

// --- Tests: codecs ----------------------------------------------------------

type Server = { name: String, port: Int, tags: List<String>, weight: Option<Float> }

fn server_yaml() -> YamlCodec<Server> =
  {
    encode: |s: Server|
      mapping([
        entry("name", String(s.name)),
        entry("port", Integer(s.port)),
        entry("tags", list_yaml(string_yaml()).encode(s.tags)),
        entry("weight", option_yaml(float_yaml()).encode(s.weight)),
      ]),
    decode: |v: Yaml| server_of(v),
  }

fn server_of(v: Yaml) -> Result<Server, DecodeError> / {abort.raise} =
  match only_fields(v, ["name", "port", "tags", "weight"]) {
    Err(e) -> Err(e),
    Ok(_) -> match field(v, "name", string_yaml()) {
      Err(e) -> Err(e),
      Ok(name) -> match field(v, "port", int_yaml()) {
        Err(e) -> Err(e),
        Ok(port) -> match field(v, "tags", list_yaml(string_yaml())) {
          Err(e) -> Err(e),
          Ok(tags) -> match optional_field(v, "weight", float_yaml()) {
            Err(e) -> Err(e),
            Ok(weight) -> Ok({ name: name, port: port, tags: tags, weight: weight }),
          },
        },
      },
    },
  }

fn web() -> Server = { name: "web", port: 80, tags: ["a", "no"], weight: Some(1.5) }

test "a record's codec writes a document and reads it back" {
  let text = encode_string(web(), server_yaml());
  assert_eq(text, "name: web\nport: 80\ntags:\n  - a\n  - \"no\"\nweight: 1.5\n");
  assert_eq(decode_string(text, limited(), server_yaml()), Ok(web()));
  assert_eq(
    decode_string("{name: web, port: 80, tags: [], weight: ~}", limited(), server_yaml()),
    Ok({ name: "web", port: 80, tags: [], weight: None }),
  );
  assert_eq(
    decode_string("{name: web, port: 80, tags: []}", limited(), server_yaml()),
    Ok({ name: "web", port: 80, tags: [], weight: None }),
  )
}

test "a decode error reports the path of keys and the line and column it is written at" {
  let failed = |text: String|
    decode_string(text, limited(), list_yaml(server_yaml())).map_err(error_to_string);
  assert_eq(
    failed("- name: web\n  port: 80\n  tags: [a]\n- name: db\n  port: eighty\n  tags: []\n"),
    Err("line 5, column 9: [1].port: expected an integer, found a string"),
  );
  assert_eq(
    failed("- name: web\n  port: 80\n  tags: [a, 2]\n"),
    Err("line 3, column 13: [0].tags[1]: expected a string, found an integer"),
  );
  assert_eq(
    failed("- name: web\n  port: 80\n"),
    Err("line 1, column 3: [0].tags: this key is missing"),
  );
  assert_eq(
    failed("- name: web\n  port: 80\n  tags: []\n  wieght: 1\n"),
    Err(
      "line 4, column 11: [0].wieght: this key is not one of name, port, tags, weight; did you mean weight?",
    ),
  );
  assert_eq(
    failed("- name: no\n  port: 80\n  tags: []\n- name: 12\n  port: 80\n  tags: []\n"),
    Err("line 4, column 9: [1].name: expected a string, found an integer"),
  );
  assert_eq(failed("- name: [\n"), Err("line 2, column 1: expected a node"));
  assert_eq(failed("name: web"), Err("line 1, column 1: expected a sequence, found a mapping"))
}

test "a codec over a value alone gives the path and no place" {
  assert_eq(
    list_yaml(server_yaml()).decode(must_parse("- {name: web, port: 80, tags: [a, 2]}")),
    Err({
      path: [Index(0), Key("tags"), Index(1)],
      place: None,
      message: "expected a string, found an integer",
    }),
  );
  assert_eq(error_to_string(decode_error("wrong")), "wrong");
  assert_eq(
    error_to_string(in_field("a b", in_index(2, decode_error("wrong")))),
    "\"a b\"[2]: wrong",
  )
}

test "the leaf codecs read their own kind and report what they found instead" {
  assert_eq(bool_yaml().decode(Boolean(true)), Ok(true));
  assert_eq(bool_yaml().decode(String("yes")), Err(expected("a boolean", String("yes"))));
  assert_eq(string_yaml().decode(String("no")), Ok("no"));
  assert_eq(
    string_yaml().decode(Float(1.2)),
    Err(decode_error("expected a string, found a float")),
  );
  assert_eq(int_yaml().decode(Integer(7)), Ok(7));
  assert_eq(int_yaml().decode(Float(7.0)), Err(decode_error("expected an integer, found a float")));
  assert_eq(float_yaml().decode(Float(1.5)), Ok(1.5));
  assert_eq(float_yaml().decode(Integer(3)), Ok(3.0));
  assert_eq(
    float_yaml().decode(Integer(9007199254740993)),
    Err(decode_error("this integer is too large for a float to represent exactly")),
  );
  assert_eq(option_yaml(int_yaml()).decode(Null), Ok(None));
  assert_eq(option_yaml(int_yaml()).decode(Integer(1)), Ok(Some(1)));
  assert_eq(option_yaml(int_yaml()).encode(None), Null);
  assert_eq(yaml_yaml().decode(Tagged("!t", Null)), Ok(Tagged("!t", Null)));
  assert_eq([Null, Sequence([]), Mapping([]), Tagged("!t", String("x"))].map(kind_of), [
    "null",
    "a sequence",
    "a mapping",
    "a value tagged !t",
  ])
}

test "a timestamp is a string to the reader and a date or an instant to its codec" {
  let text = "day: 2001-12-14\nat: 2001-12-14T21:59:43Z\nlocal: 2001-12-14T21:59:43\nclock: 21:59:43\n";
  let v = must_parse(text);
  assert_eq(get(v, "day"), Some(String("2001-12-14")));
  assert_eq(field(v, "day", date_yaml()), Ok(date::of(2001, 12, 14).expect("a date")));
  assert_eq(field(v, "at", offset_date_time_yaml()).map(date::rfc3339), Ok("2001-12-14T21:59:43Z"));
  assert_eq(
    field(v, "local", date_time_yaml()).map(date::date_time_text),
    Ok("2001-12-14T21:59:43"),
  );
  assert_eq(field(v, "clock", time_yaml()).map(date::time_text), Ok("21:59:43"));
  assert_eq(
    field(v, "clock", date_yaml()).map_err(error_to_string),
    Err("clock: expected a date, as 1979-05-27"),
  );
  assert_eq(date_yaml().encode(date::of(2001, 12, 14).expect("a date")), String("2001-12-14"));
  assert_eq(to_string(Mapping([entry("day", String("2001-12-14"))])), "day: \"2001-12-14\"\n")
}

test "a string-keyed map is a mapping, and a key that is not a string is rejected" {
  let codec = string_map_yaml(int_yaml());
  assert_eq((codec.encode)(#{"b": 2, "a": 1}), must_parse("{a: 1, b: 2}"));
  assert_eq((codec.decode)(must_parse("{b: 2, a: 1}")), Ok(#{"a": 1, "b": 2}));
  assert_eq(
    Result::map_err((codec.decode)(must_parse("{a: 1, b: x}")), error_to_string),
    Err("b: expected an integer, found a string"),
  );
  assert_eq(
    Result::map_err((codec.decode)(must_parse("{1: 1}")), error_to_string),
    Err("expected a string for a key, found an integer"),
  )
}

fn sample_deployment() -> String =
  \\# A deployment.
  \\apiVersion: apps/v1
  \\kind: Deployment
  \\metadata:
  \\  name: web  # the name
  \\  labels: {app: web, tier: front}
  \\spec:
  \\  replicas: 3
  \\  template:
  \\    containers:
  \\      - name: web
  \\        image: "nginx:1.25"
  \\        args: [--port, "80"]
  \\        env:
  \\        - name: A
  \\          value: |
  \\            two
  \\            lines
  \\        - name: B
  \\      # a sidecar
  \\      - name: log
  \\  strategy:
  \\

fn edited(
  text: String,
  edit: (Document) -> Document / {yaml.fail, abort.raise},
) -> String / {abort.raise} =
  match parse_document(Bytes::of_string(text), limited()) {
    Err(e) -> "unread: " ++ error_message(e),
    Ok(d) -> match try { edit(d) } {
      Ok(made) -> String::of_bytes_lossy(source(made)),
      Err(e) -> "rejected: " ++ error_message(e),
    },
  }

test "a document is its bytes and its value, and reports where a path is written" {
  let text = Bytes::of_string(sample_deployment());
  match parse_document(text, limited()) {
    Err(e) -> panic(error_message(e)),
    Ok(d) -> {
      assert_eq(source(d), text);
      assert_eq(Ok(value(d)), parse(text, limited()));
      assert_eq(place(d, []), Some({ line: 2, column: 1 }));
      assert_eq(place(d, [Key("metadata"), Key("name")]), Some({ line: 5, column: 9 }));
      assert_eq(
        place(d, [Key("metadata"), Key("labels"), Key("tier")]),
        Some({ line: 6, column: 28 }),
      );
      assert_eq(
        place(d, [Key("spec"), Key("template"), Key("containers"), Index(1), Key("name")]),
        Some({ line: 21, column: 15 }),
      );
      assert_eq(place(d, [Key("spec"), Key("strategy")]), Some({ line: 22, column: 12 }));
      assert_eq(place(d, [Key("absent")]), None);
      assert_eq(place(d, [Key("kind"), Index(0)]), None)
    },
  };
  assert_eq(
    parse_document(b"a: [", limited()).map_err(|e: Error| e.reason),
    Err(Expected("a node")),
  )
}

/// The lines of the manifest an edit changed: those it removed, each after `-`, then those it
/// added, each after `+`.
fn changed(
  edit: (Document) -> Document / {yaml.fail, abort.raise},
) -> List<String> / {abort.raise} = {
  let before = sample_deployment().lines();
  let after = edited(sample_deployment(), edit).lines();
  before.filter(|l: String| !after.contains(l)).map(|l: String| "-" ++ l).concat(
    after.filter(|l: String| !before.contains(l)).map(|l: String| "+" ++ l),
  )
}

fn first_container() -> List<PathSegment> =
  [Key("spec"), Key("template"), Key("containers"), Index(0)]

test "setting a value that is written changes those bytes and no others" {
  assert_eq(changed(|d: Document| set(d, [Key("spec"), Key("replicas")], Integer(5))), [
    "-  replicas: 3",
    "+  replicas: 5",
  ]);
  assert_eq(changed(|d: Document| set(d, [Key("metadata"), Key("name")], String("api: v2"))), [
    "-  name: web  # the name",
    "+  name: \"api: v2\"  # the name",
  ]);
  assert_eq(
    changed(|d: Document| set(d, [Key("metadata"), Key("labels"), Key("tier")], String("a, b"))),
    ["-  labels: {app: web, tier: front}", "+  labels: {app: web, tier: \"a, b\"}"],
  );
  assert_eq(
    changed(|d: Document| set(d, first_container().push(Key("image")), String("nginx:1.26"))),
    ["-        image: \"nginx:1.25\"", "+        image: nginx:1.26"],
  );
  assert_eq(
    changed(|d: Document|
      set(d, first_container().push(Key("args")).push(Index(1)), Integer(8080))),
    ["-        args: [--port, \"80\"]", "+        args: [--port, 8080]"],
  );
  assert_eq(
    changed(|d: Document| set(d, [Key("spec"), Key("strategy")], must_parse("{type: Rolling}"))),
    ["-  strategy:", "+  strategy: {type: Rolling}"],
  );
  assert_eq(
    edited("hr:   65 # runs\n", |d: Document| set(d, [Key("hr")], Integer(66))),
    "hr:   66 # runs\n",
  )
}

test "a value over several lines is replaced by one on the line of its key" {
  assert_eq(
    changed(|d: Document|
      set(d, first_container().push(Key("env")).push(Index(0)).push(Key("value")), String("one"))),
    ["-          value: |", "-            two", "-            lines", "+          value: one"],
  );
  assert_eq(
    edited("a:\n- 1\n- 2\nb: 3\n", |d: Document| set(d, [Key("a")], Integer(0))),
    "a: 0\nb: 3\n",
  );
  assert_eq(
    edited("a:\n  # why\n  b: 1\nc: 2\n", |d: Document| set(d, [Key("a")], strings(["x"]))),
    "a:\n  # why\n  [x]\nc: 2\n",
  );
  assert_eq(edited("a: 1\n", |d: Document| set(d, [], strings(["x"]))), "[x]\n");
  assert_eq(edited("", |d: Document| set(d, [], must_parse("{a: 1}"))), "{a: 1}")
}

test "a new key goes after its mapping's last entry, as that mapping's keys are indented" {
  assert_eq(
    changed(|d: Document| set(d, [Key("metadata"), Key("namespace")], String("default"))),
    ["+  namespace: default"],
  );
  assert_eq(
    changed(|d: Document| set(d, [Key("metadata"), Key("labels"), Key("env")], String("prod"))),
    ["-  labels: {app: web, tier: front}", "+  labels: {app: web, tier: front, env: prod}"],
  );
  assert_eq(
    changed(|d: Document| set(d, first_container().push(Key("ports")), must_parse("[80, 443]"))),
    ["+        ports: [80, 443]"],
  );
  assert_eq(changed(|d: Document| set(d, [Key("status"), Key("ready")], Boolean(true))), [
    "+status: {ready: true}",
  ]);
  assert_eq(edited("a: 1", |d: Document| set(d, [Key("b")], Integer(2))), "a: 1\nb: 2");
  assert_eq(edited("{}\n", |d: Document| set(d, [Key("b")], Integer(2))), "{b: 2}\n");
  assert_eq(
    edited("- a: 1\n  b: |\n    text\n- c\n", |d: Document| set(d, [Index(0), Key("z")], Null)),
    "- a: 1\n  b: |\n    text\n  z: null\n- c\n",
  )
}

test "removing a path takes its lines and leaves the rest, comments among it" {
  assert_eq(changed(|d: Document| remove(d, [Key("kind")])), ["-kind: Deployment"]);
  assert_eq(changed(|d: Document| remove(d, [Key("metadata"), Key("name")])), [
    "-  name: web  # the name",
  ]);
  assert_eq(changed(|d: Document| remove(d, [Key("metadata"), Key("labels"), Key("app")])), [
    "-  labels: {app: web, tier: front}",
    "+  labels: {tier: front}",
  ]);
  assert_eq(changed(|d: Document| remove(d, [Key("metadata"), Key("labels"), Key("tier")])), [
    "-  labels: {app: web, tier: front}",
    "+  labels: {app: web}",
  ]);
  assert_eq(changed(|d: Document| remove(d, [Key("spec"), Key("strategy")])), ["-  strategy:"]);
  assert_eq(changed(|d: Document| remove(d, first_container().push(Key("name")))), [
    "-      - name: web",
    "-        image: \"nginx:1.25\"",
    "+      - image: \"nginx:1.25\"",
  ]);
  assert_eq(changed(|d: Document| remove(d, first_container().push(Key("env")).push(Index(1)))), [
    "-        - name: B",
  ]);
  assert_eq(
    changed(|d: Document| remove(d, first_container().push(Key("args")).push(Index(0)))),
    ["-        args: [--port, \"80\"]", "+        args: [\"80\"]"],
  );
  assert_eq(
    changed(|d: Document| remove(d, [Key("spec"), Key("template"), Key("containers"), Index(1)])),
    ["-      - name: log"],
  );
  assert_eq(changed(|d: Document| remove(d, [Key("absent")])), []);
  assert_eq(edited("a: 1", |d: Document| remove(d, [Key("a")])), "{}");
  assert_eq(edited("- a\n- b\n", |d: Document| remove(d, [Index(1)])), "- a\n");
  assert_eq(edited("- a\n", |d: Document| remove(d, [Index(0)])), "[]\n")
}

test "an edit the document has no place for is rejected where the path stops" {
  let rejected = |text: String, edit: (Document) -> Document / {yaml.fail, abort.raise}|
    match parse_document(Bytes::of_string(text), limited()) {
      Err(e) -> Some((e.line, e.column, e.reason)),
      Ok(d) -> match try { edit(d) } {
        Ok(_) -> None,
        Err(e) -> Some((e.line, e.column, e.reason)),
      },
    };
  assert_eq(
    rejected("a: 1\nb: x\n", |d: Document| set(d, [Key("b"), Key("c")], Null)),
    Some((2, 4, Uneditable([Key("b"), Key("c")]))),
  );
  assert_eq(
    rejected("a: [1]\n", |d: Document| set(d, [Key("a"), Index(1)], Null)),
    Some((1, 4, Uneditable([Key("a"), Index(1)]))),
  );
  assert_eq(rejected("a: 1\n", |d: Document| remove(d, [])), Some((1, 1, Uneditable([]))));
  assert_eq(
    rejected("a: &x 1\nb: *x\n", |d: Document| set(d, [Key("a")], Integer(2))),
    Some((1, 4, Uneditable([Key("a")]))),
  );
  assert_eq(
    rejected("a: &x {k: 1}\nb: *x\n", |d: Document| set(d, [Key("b"), Key("k")], Integer(2))),
    Some((2, 4, Uneditable([Key("b"), Key("k")]))),
  );
  assert_eq(
    edited("a: &x 1\nb: *x\n", |d: Document| set(d, [Key("b")], Integer(2))),
    "a: &x 1\nb: 2\n",
  );
  let tight: Limits = { bytes: 12, depth: 4, nodes: 100, scalar: 100, documents: 1 };
  assert_eq(
    Result::map_err(
      try {
        match parse_document(b"a: 1\nb: 2\n", tight) {
          Ok(d) -> source(set(d, [Key("c")], Integer(3))),
          Err(_) -> b"",
        }
      },
      |e: Error| e.reason,
    ),
    Err(Uneditable([Key("c")])),
  );
  assert_eq(
    error_message({ offset: 0, line: 1, column: 1, reason: Uneditable([Key("a"), Index(1)]) }),
    "line 1, column 1: the document has no place for an edit at `a[1]`",
  )
}

test "a document decodes as it is, and again after an edit" {
  let text = "- name: web\n  port: 80\n  tags: [a]\n- name: db\n  port: 5432\n  tags: []\n";
  match parse_document(Bytes::of_string(text), limited()) {
    Err(e) -> panic(error_message(e)),
    Ok(d) -> {
      assert_eq(
        decode_document(d, list_yaml(server_yaml())).map(|servers: List<Server>|
          servers.map(|s: Server| s.port)),
        Ok([80, 5432]),
      );
      let moved = try { set(d, [Index(1), Key("port")], String("none")) };
      assert_eq(
        match moved {
          Ok(after) -> decode_document(after, list_yaml(server_yaml())).map_err(error_to_string),
          Err(e) -> panic(error_message(e)),
        },
        Err("line 5, column 9: [1].port: expected an integer, found a string"),
      )
    },
  }
}
