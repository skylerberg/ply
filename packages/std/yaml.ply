    { text: "\u{ffff}", written: "\"\\uFFFF\"" },
    { text: "é \u{a0}\u{1F600}", written: "é \u{a0}\u{1F600}" },
    { text: "two\nlines\n", written: "|\n  two\n  lines" },
    { text: "no end\nline", written: "|-\n  no end\n  line" },
    { text: "kept\n\n\n", written: "|+\n  kept\n\n" },
    { text: "\nlead\n", written: "|\n\n  lead" },
    { text: "a\n\tb\n", written: "|\n  a\n  \tb" },
    { text: "\n", written: "\"\\n\"" },
    { text: " indented\nline\n", written: "\" indented\\nline\\n\"" },
