//! The `timestamp"2026-10-04T12:30:00Z"` literal: a `std.date` instant with a UTC offset, written
//! in RFC 3339 form and checked when the program is checked.
//!
//! A literal's tag names a module, and the `date` tag already reads a date, so instants need a tag
//! of their own. The type and every operation on it belong to `std.date`.

import std.date (OffsetDateTime, Error, rfc3339_literal, unix_seconds)
import std.option
import std.result

/// Checks a `timestamp"..."` literal. Returns the instant `std.date`'s `parse_rfc3339` reads, or
/// an error with the reason and the offset of the character where the text stops being valid.
pub fn literal(text: String) -> Result<OffsetDateTime, Error> = rfc3339_literal(text)

test "`literal` returns the instant, or an error with the position of the first invalid character in the timestamp" {
  assert_eq(literal("1970-01-01T01:00:00+01:00").ok().map(unix_seconds), Some(0));
  assert_eq(
    literal("1970-01-01T01:00:00"),
    Err({ message: "an offset is `Z`, or `+` or `-` and hh:mm", offset: 19 }),
  )
}
