//! A `Value` is any value represented as data, and `render` converts a `Value` to text.
//!
//! A `Value` is what `machine.call` takes and returns, what a runtime diagnostic contains, and what
//! a counterexample stores for each variable. `render` writes a value in the language's own syntax:
//! a constructor by the name its module declares, a `new` record as the literal that builds it, a
//! `std.set` set as the `#[..]` that builds it, and an array as `Array::of_list([..])`.
//!
//! In a diagnostic, a value is cut off once its text passes `shown_characters`, and the items left
//! out of each string, bytes value, list, map, record and constructor are counted. Nesting deeper
//! than `shown_depth` shows as `…`, and a credential shows as `Secret(****)`. `render_all` writes
//! every item at every depth, with no cut-off.
//!
//! A fixed-width integer stores its bit pattern, so `-1i8` is `VFixed("I8", 255u128)`. Only a
//! generated function (`ConstantFunction`, `ProjectionFunction`, `TableFunction`) can be passed
//! back into the running program through `machine.call`. `VElided` marks the part of a value that a
//! diagnostic's snapshot cut off.

import std.string
import std.gen
import std.list

/// Returns `x` as a `Value`. An integer type narrower than 64 bits that the program does not
/// declare with a fixed width becomes `VInt`, and a function the program defined becomes
/// `VFn(FAnonymous)`.
pub extern fn reflect<a>(x: a) -> Value

/// As `reflect`, but a value whose type declares a `show` becomes `VShown` of what that function
/// writes, at any depth.
pub extern fn shown<a>(x: a) -> Value

/// A value of any type: what `machine.call` marshals, what a runtime diagnostic carries, and what
/// the prover generates.
pub type Value =
  | VUnit
  | VBool(Bool)
  | VInt(Int)
  | VFloat(Float)
  | VDecimal(Decimal)
  /// The width's name and its bit pattern, with no bit set above the width: `-1i8` is `0xFFu128`.
  | VFixed(String, U128)
  | VChar(Char)
  | VStr(String)
  | VBytes(Bytes)
  | VList(List<Value>)
  /// Sorted by name, as a record's fields are.
  | VRecord(List<Field>)
  | VCtor(String, List<Value>)
  /// The entries of a map, sorted by key.
  | VMap(List<Entry>)
  | VFn(Fun)
  /// A scoped value, such as an open file, which a `with_scope` block releases when the block ends.
  /// It has no data representation, so it cannot be sent or stored.
  | VHold
  /// A credential, whose payload never leaves the runtime.
  | VSecret
  /// Marks the part of a value that a diagnostic's snapshot left out. A positive number is how many
  /// more items of a list or map were left out. Zero means everything nested deeper was left out.
  | VElided(Int)
  | VArray(List<Value>)
  /// What a type's own `show` wrote in place of a value, which `render` writes unchanged; only
  /// `shown` creates one.
  | VShown(String)

/// One field of a record value.
pub type Field = { name: String, value: Value }

/// One key and value of a map value.
pub type Entry = { key: Value, value: Value }

/// A function as data. Only a generated one (constant, projection, table) can be called, and it
/// takes at most 255 arguments.
pub type Fun =
  | NamedFunction(String)
  | FAnonymous
  | ConstantFunction({ arity: U8, value: Value })
  | ProjectionFunction({ arity: U8, index: U8 })
  /// The first entry whose key equals the first argument, else `default`.
  | TableFunction({ arity: U8, entries: List<Entry>, default: Value })

/// A value a diagnostic shows is cut once its text reaches this many characters.
pub const shown_characters: Int = 2000

/// Nesting past this shows as `…`.
pub const shown_depth: Int = 16

/// The text a diagnostic shows. Once the text reaches `shown_characters`, the items left out of
/// each string, bytes value, list, map, record and constructor are counted, and nesting past
/// `shown_depth` shows as `…`.
pub fn render(v: Value) -> String = rendered(v, 0, Some(shown_characters))

/// What a program shows (`std.show`): every item at every depth, in `render`'s format.
pub fn render_all(v: Value) -> String = rendered(v, 0, None)

fn rendered(v: Value, depth: Int, room: Option<Int>) -> String =
  if room != None && depth > shown_depth { "…" } else {
    match v {
      VUnit -> "()",
      VBool(b) -> if b { "true" } else { "false" },
      VInt(n) -> n.to_string(),
      VFloat(f) -> f.to_string(),
      VDecimal(d) -> d.to_string(),
      VFixed(ty, bits) -> fixed_text(ty, bits),
      VChar(c) -> "'" ++ char_escaped(c) ++ "'",
      VStr(s) ->
        cut_text(
          "\"",
          "\"",
          fitted(s.chars(), room, |accumulator: List<Char>, c: Char|
            escaped_char(accumulator, c, '"')),
        ),
      VBytes(b) -> cut_text("b\"", "\"", fitted(bytes_of(b), room, byte_chars)),
      VList(items) -> "[" ++ values_text(items, depth, spent(room, "[")) ++ "]",
      VArray(items) -> {
        let head = "Array::of_list([";
        head ++ values_text(items, depth, spent(room, head)) ++ "])"
      },
      VRecord(fields) -> record_text(fields, depth, room),
      VCtor(name, args) -> match set_elements(name, args) {
        Some(keys) -> "#[" ++ values_text(keys, depth, spent(room, "#[")) ++ "]",
        None -> if args.len() == 0 { constructor_name(name) } else {
          let head = constructor_name(name) ++ "(";
          head ++ values_text(args, depth, spent(room, head)) ++ ")"
        },
      },
      VMap(entries) ->
        "{"
          ++ items_text(
            entries,
            spent(room, "{"),
            |e: Entry, left: Option<Int>| entry_text(e, depth, left),
            |e: Entry| weight(e.key),
          )
          ++ "}",
      VFn(f) ->
        "<fn"
          ++ function_text(f, spent(room, "<fn"), |x: Value, left: Option<Int>|
            rendered(x, depth + 1, left))
          ++ ">",
      VHold -> "<hold>",
      VSecret -> "Secret(****)",
      VElided(n) -> elided(n),
      VShown(text) -> if room == None { text } else {
        cut_text(
          "",
          "",
          fitted(text.chars(), room, |accumulator: List<Char>, c: Char| accumulator.push(c)),
        )
      },
    }
  }

fn spent(room: Option<Int>, text: String) -> Option<Int> =
  match room { Some(n) -> Some(n - text.len()), None -> None }

/// The name a constructor's module declares it under, which is how it is shown: the module's path
/// is not part of the value.
pub fn constructor_name(name: String) -> String =
  String::of_chars(
    name.chars().fold([], |accumulator: List<Char>, c: Char|
      if c == '.' { [] } else { accumulator.push(c) }),
  )

fn set_elements(name: String, args: List<Value>) -> Option<List<Value>> =
  if name != "std.set.Set" { None }
  else { match args { [VMap(entries)] -> Some(entries.map(|e: Entry| e.key)), _ -> None } }

fn elided(n: Int) -> String = if n == 0 { "…" } else { "… " ++ n.to_string() ++ " more" }

fn entry_text(e: Entry, depth: Int, room: Option<Int>) -> String =
  match e.key {
    VElided(n) -> elided(n),
    k -> {
      let head = rendered(k, depth + 1, room) ++ ": ";
      head ++ rendered(e.value, depth + 1, spent(room, head))
    },
  }

fn values_text(items: List<Value>, depth: Int, room: Option<Int>) -> String =
  items_text(items, room, |x: Value, left: Option<Int>| rendered(x, depth + 1, left), weight)

fn weight(v: Value) -> Int = match v { VElided(n) -> max(n, 1), _ -> 1 }

fn items_text<a>(
  items: List<a>,
  room: Option<Int>,
  item: (a, Option<Int>) -> String,
  count: (a) -> Int,
) -> String =
  match room {
    None -> String::join(items.map(|x: a| item(x, None)), ", "),
    Some(n) -> {
      let walked = items.fold(
        { parts: [], left: n, more: 0 },
        |s: { parts: List<String>, left: Int, more: Int }, x: a|
          if s.left <= 0 { { ..s, more: s.more + count(x) } } else {
            let text = item(x, Some(s.left));
            { ..s, parts: s.parts.push(text), left: s.left - text.len() - 2 }
          },
      );
      String::join(
        if walked.more == 0 { walked.parts } else { walked.parts.push(elided(walked.more)) },
        ", ",
      )
    },
  }

fn record_text(fields: List<Field>, depth: Int, room: Option<Int>) -> String =
  if is_tuple(fields) {
    "("
      ++ items_text(
        range(0, fields.len()),
        spent(room, "("),
        |i: Int, left: Option<Int>| tuple_item(fields, i, depth, left),
        |_: Int| 1,
      )
      ++ ")"
  } else {
    "{"
      ++ items_text(
        fields,
        spent(room, "{"),
        |f: Field, left: Option<Int>| {
          let head = f.name ++ ": ";
          head ++ rendered(f.value, depth + 1, spent(left, head))
        },
        |_: Field| 1,
      )
      ++ "}"
  }

/// Whether a record's fields are a tuple's: two or more, named `_0`, `_1` and on.
pub fn is_tuple(fields: List<Field>) -> Bool =
  fields.len() >= 2
    && range(0, fields.len()).fold(true, |accumulator: Bool, i: Int|
      accumulator && field_named(fields, "_" ++ i.to_string()) != None)

/// The value of the field `name` among `fields`: the last one so named, or `None`.
pub fn field_named(fields: List<Field>, name: String) -> Option<Value> =
  fields.fold(None, |accumulator: Option<Value>, f: Field|
    if f.name == name { Some(f.value) } else { accumulator })

fn tuple_item(fields: List<Field>, i: Int, depth: Int, room: Option<Int>) -> String =
  match field_named(fields, "_" ++ i.to_string()) {
    Some(v) -> rendered(v, depth + 1, room),
    None -> "",
  }

fn function_text(f: Fun, room: Option<Int>, inner: (Value, Option<Int>) -> String) -> String =
  match f {
    NamedFunction(name) -> " " ++ name,
    FAnonymous -> "",
    ConstantFunction(c) -> {
      let head = " |" ++ String::join(range(0, Int::of_u8(c.arity)).map(|_: Int| "_"), ", ")
        ++ "| ";
      head ++ inner(c.value, spent(room, head))
    },
    ProjectionFunction(p) -> " |" ++ params(p.arity) ++ "| x" ++ Int::of_u8(p.index).to_string(),
    TableFunction(t) -> {
      let head = " |" ++ params(t.arity) ++ "| ";
      head ++ table_text(t.entries, t.default, spent(room, head), inner)
    },
  }

fn params(arity: U8) -> String =
  String::join(range(0, Int::of_u8(arity)).map(|i: Int| "x" ++ i.to_string()), ", ")

fn table_text(
  entries: List<Entry>,
  default: Value,
  room: Option<Int>,
  inner: (Value, Option<Int>) -> String,
) -> String = {
  let opened = entries.fold(
    { parts: [], left: room },
    |s: { parts: List<String>, left: Option<Int> }, e: Entry| {
      let head = "if x0 == " ++ inner(e.key, s.left) ++ " { ";
      let piece = head ++ inner(e.value, spent(s.left, head)) ++ " } else { ";
      { parts: s.parts.push(piece), left: spent(s.left, piece) }
    },
  );
  String::join(opened.parts, "") ++ inner(default, opened.left) ++ " }".repeat(entries.len())
}

const opener: String = String::of_bytes(b"\x01")

const closer: String = String::of_bytes(b"\x02")

/// `text` with each slot replaced by its value, rendered.
pub fn filled(text: String, values: List<Value>) -> String / {abort.raise} =
  match text.split(opener) {
    [head, ..pieces] ->
      pieces.fold(head, |accumulator: String, piece: String|
        accumulator ++ slot_piece(piece, values)),
    [] -> text,
  }

fn slot_piece(piece: String, values: List<Value>) -> String / {abort.raise} =
  match piece.split(closer) {
    [index, ..rest] -> match slot_value(index, values) {
      Some(v) -> render(v) ++ String::join(rest, closer),
      None -> opener ++ piece,
    },
    [] -> opener ++ piece,
  }

fn slot_value(index: String, values: List<Value>) -> Option<Value> / {abort.raise} =
  if index.len() > 9 || index.starts_with("-") { None }
  else { match index.int_of_string() { Some(at) -> values.at(at), None -> None } }

fn slot(i: Int) -> String = opener ++ i.to_string() ++ closer

type Step = | IndexStep(Int) | KeyStep(Value) | FieldStep(String) | ArgumentStep(String, Int)

type Difference = { path: List<Step>, expected: Value, actual: Value }

/// Returns a note saying where `actual` first differs from `expected` below the top level, or
/// `None` when they are equal or differ only at the top level. The note gives the path to that
/// place and names the two differing values with placeholders numbered from `first`: the note text
/// refers to each by its number. The result also returns the values those numbers stand for, in
/// numbered order: each map key on the path, then the expected value, then the actual value. Lists
/// and arrays of equal length are compared item by item, maps with equal keys entry by entry,
/// records with equal field names field by field, and values of the same constructor argument by
/// argument.
pub fn difference_note(
  actual: Value,
  expected: Value,
  first: Int,
) -> Option<{ note: String, values: List<Value> }> =
  match difference(actual, expected, true) {
    None -> None,
    Some(p) -> {
      let path_note = p.path.fold(
        { text: "", values: [] },
        |accumulator: { text: String, values: List<Value> }, s: Step|
          match s {
            IndexStep(i) ->
              { ..accumulator, text: accumulator.text ++ "[" ++ i.to_string() ++ "]" },
            KeyStep(k) ->
              {
                text: accumulator.text ++ "[" ++ slot(first + accumulator.values.len()) ++ "]",
                values: accumulator.values.push(k),
              },
            FieldStep(name) -> { ..accumulator, text: accumulator.text ++ "." ++ name },
            ArgumentStep(constructor, i) ->
              {
                ..accumulator,
                text: accumulator.text ++ "." ++ constructor ++ "." ++ i.to_string(),
              },
          },
      );
      let at = first + path_note.values.len();
      Some({
        note: "first difference at `" ++ path_note.text ++ "`: expected " ++ slot(at) ++ ", found "
          ++ slot(at + 1),
        values: path_note.values.push(p.expected).push(p.actual),
      })
    },
  }

fn difference(actual: Value, expected: Value, top: Bool) -> Option<Difference> =
  match ((actual, expected)) {
    (VList(a), VList(e)) -> if a.len() == e.len() { item_difference(a, e) }
    else { whole(actual, expected, top) },
    (VArray(a), VArray(e)) -> if a.len() == e.len() { item_difference(a, e) }
    else { whole(actual, expected, top) },
    (VMap(a), VMap(e)) -> if keys_agree(a, e) {
      first_difference(a.len(), |i: Int|
        match ((a.at(i), e.at(i))) {
          (Some(x), Some(y)) -> within(KeyStep(x.key), x.value, y.value),
          _ -> None,
        })
    } else { whole(actual, expected, top) },
    (VRecord(a), VRecord(e)) -> if a.map(|f: Field| f.name) == e.map(|f: Field| f.name) {
      first_difference(a.len(), |i: Int|
        match ((a.at(i), e.at(i))) {
          (Some(x), Some(y)) -> within(FieldStep(x.name), x.value, y.value),
          _ -> None,
        })
    } else { whole(actual, expected, top) },
    (VCtor(n, a), VCtor(m, e)) -> if n == m && a.len() == e.len() {
      first_difference(a.len(), |i: Int|
        match ((a.at(i), e.at(i))) {
          (Some(x), Some(y)) -> within(ArgumentStep(n, i), x, y),
          _ -> None,
        })
    } else { whole(actual, expected, top) },
    _ -> whole(actual, expected, top),
  }

fn item_difference(a: List<Value>, e: List<Value>) -> Option<Difference> =
  first_difference(a.len(), |i: Int|
    match ((a.at(i), e.at(i))) { (Some(x), Some(y)) -> within(IndexStep(i), x, y), _ -> None })

fn keys_agree(a: List<Entry>, e: List<Entry>) -> Bool =
  a.len() == e.len()
    && range(0, a.len()).all(|i: Int|
      match ((a.at(i), e.at(i))) { (Some(x), Some(y)) -> order(x.key, y.key) == Equal, _ -> false })

fn first_difference(n: Int, part: (Int) -> Option<Difference>) -> Option<Difference> =
  range(0, n).fold(None, |found: Option<Difference>, i: Int|
    match found { Some(_) -> found, None -> part(i) })

fn within(step: Step, actual: Value, expected: Value) -> Option<Difference> =
  match difference(actual, expected, false) {
    Some(p) -> Some({ ..p, path: [step].concat(p.path) }),
    None -> None,
  }

fn whole(actual: Value, expected: Value, top: Bool) -> Option<Difference> =
  if top || actual == expected { None }
  else { Some({ path: [], expected: expected, actual: actual }) }

/// How many bits the fixed-width integer type `ty` names, as `"U8"` or `"I64"`: 128 for any other.
pub fn width_of(ty: String) -> Int =
  if ty == "U8" || ty == "I8" { 8 }
  else if ty == "U16" || ty == "I16" { 16 }
  else if ty == "U32" || ty == "I32" { 32 }
  else if ty == "U64" || ty == "I64" { 64 }
  else { 128 }

fn mask(width: Int) -> U128 = if width == 128 { ~0u128 } else { wrap_sub(1u128 << width, 1u128) }

fn fixed_text(ty: String, bits: U128) -> String = {
  let width = width_of(ty);
  let pattern = bits & mask(width);
  let negative = ty.starts_with("I") && pattern >> width - 1 == 1u128;
  if negative { "-" ++ U128::to_string(wrap_sub(0u128, pattern) & mask(width)) }
  else { pattern.to_string() }
}

/// Compares two values in the order the runtime sorts them, which is the order of a map's keys when
/// the key type does not declare a `key`. Values of different kinds are ordered by kind; values of
/// the same kind are ordered by their contents with `compare`.
pub fn order(a: Value, b: Value) -> Ordering = {
  let ranks = compare(rank(a), rank(b));
  if ranks != Equal { ranks } else {
    match ((a, b)) {
      (VBool(x), VBool(y)) -> compare(x, y),
      (VInt(x), VInt(y)) -> compare(x, y),
      (VFloat(x), VFloat(y)) -> compare(total_key(x), total_key(y)),
      (VDecimal(x), VDecimal(y)) -> compare(x, y),
      (VFixed(tx, x), VFixed(ty, y)) -> {
        let widths = compare(width_rank(tx), width_rank(ty));
        if widths != Equal { widths } else { compare(signed_key(tx, x), signed_key(ty, y)) }
      },
      (VChar(x), VChar(y)) -> compare(x, y),
      (VStr(x), VStr(y)) -> compare(x, y),
      (VBytes(x), VBytes(y)) -> compare(x, y),
      (VList(xs), VList(ys)) -> ordered(xs, ys, order),
      (VArray(xs), VArray(ys)) -> ordered(xs, ys, order),
      (VMap(xs), VMap(ys)) ->
        ordered(xs, ys, |p: Entry, q: Entry| {
          let keys = order(p.key, q.key);
          if keys != Equal { keys } else { order(p.value, q.value) }
        }),
      (VRecord(xs), VRecord(ys)) ->
        ordered(xs, ys, |p: Field, q: Field| {
          let names = compare(p.name, q.name);
          if names != Equal { names } else { order(p.value, q.value) }
        }),
      (VCtor(nx, xs), VCtor(ny, ys)) -> {
        let names = compare(nx, ny);
        if names != Equal { names } else { ordered(xs, ys, order) }
      },
      (VShown(x), VShown(y)) -> compare(x, y),
      _ -> Equal,
    }
  }
}

fn rank(v: Value) -> Int =
  match v {
    VUnit -> 0,
    VBool(_) -> 1,
    VInt(_) -> 2,
    VFloat(_) -> 3,
    VDecimal(_) -> 4,
    VStr(_) -> 5,
    VBytes(_) -> 6,
    VList(_) -> 7,
    VMap(_) -> 8,
    VRecord(_) -> 9,
    VCtor(_, _) -> 10,
    VFn(_) -> 11,
    VHold -> 12,
    VSecret -> 14,
    VFixed(_, _) -> 15,
    VChar(_) -> 16,
    VArray(_) -> 17,
    VElided(_) -> 19,
    VShown(_) -> 20,
  }

fn total_key(f: Float) -> Int = {
  let b = bits_of_float(f);
  if b < 0 { b ^ 0x7FFF_FFFF_FFFF_FFFF } else { b }
}

fn width_rank(ty: String) -> Int =
  match list_index(["U8", "U16", "U32", "U64", "I8", "I16", "I32", "I64", "U128", "I128"], ty) {
    Some(i) -> i,
    None -> 10,
  }

fn list_index(xs: List<String>, x: String) -> Option<Int> =
  range(0, xs.len()).fold(None, |found: Option<Int>, i: Int|
    match found { Some(_) -> found, None -> if xs.at(i) == Some(x) { Some(i) } else { None } })

fn signed_key(ty: String, bits: U128) -> U128 = {
  let width = width_of(ty);
  let pattern = bits & mask(width);
  if ty.starts_with("I") { pattern ^ 1u128 << width - 1 } else { pattern }
}

fn ordered<a>(xs: List<a>, ys: List<a>, by: (a, a) -> Ordering) -> Ordering = {
  let common = range(0, min(xs.len(), ys.len())).fold(Equal, |accumulator: Ordering, i: Int|
    if accumulator != Equal { accumulator }
    else { match ((xs.at(i), ys.at(i))) { (Some(x), Some(y)) -> by(x, y), _ -> Equal } });
  if common != Equal { common } else { compare(xs.len(), ys.len()) }
}

/// Returns a map value containing `entries`, sorted by key. When several entries have the same key,
/// the first entry's key is kept and the last entry's value wins, as if the entries were inserted
/// one at a time.
pub fn map_of(entries: List<Entry>) -> Value =
  VMap(entries.fold([], |accumulator: List<Entry>, e: Entry| inserted(accumulator, e)))

fn inserted(sorted: List<Entry>, e: Entry) -> List<Entry> = {
  let at = range(0, sorted.len()).fold(sorted.len(), |found: Int, i: Int|
    if found < sorted.len() { found } else {
      match sorted.at(i) {
        Some(s) -> if order(e.key, s.key) != Greater { i } else { found },
        None -> found,
      }
    });
  if at == sorted.len() { sorted.push(e) } else {
    let same = match sorted.at(at) { Some(s) -> order(e.key, s.key) == Equal, None -> false };
    range(0, sorted.len()).fold([], |out: List<Entry>, i: Int|
      match sorted.at(i) {
        Some(s) -> if i != at { out.push(s) }
        else if same { out.push({ key: s.key, value: e.value }) }
        else { out.push(e).push(s) },
        None -> out,
      })
  }
}

/// Encodes `v` as PLV1, the one format used both to pass a value to the runtime and to store it.
/// Each value starts with a tag byte. Within one encoding, a constructor or field name is written
/// in full the first time and as a number after that. Every number is a little-endian base-128
/// varint. Returns `None` when `v` contains a value that PLV1 cannot store: a scoped value, a task,
/// a channel, a credential, a `VElided` marker, or a `VShown` text.
pub fn encode(v: Value) -> Option<Bytes> =
  handle {
    Some(Bytes::concat_all(written(v, { out: [b"PLV1"], names: Map::new() }).out))
  } with {
    abort.raise(_) -> None,
  }

/// Decodes the PLV1 bytes `b` into a value. A repeated reference to an earlier string, bytes, list,
/// array or map decodes as a copy of that earlier value, and a function the program wrote, which
/// has no name, decodes as `FAnonymous`. Returns `None` unless `b` is exactly one complete value,
/// or when `b` contains a handle: a scoped value or credential, which is passed to the runtime
/// beside the bytes instead of inside them.
pub fn decode(b: Bytes) -> Option<Value> = decoded(b, false, b.len() + 1)

/// Decodes PLV1 bytes `b`, written by the runtime for a diagnostic, into a value to show. It
/// decodes as `decode` does, except that a handle decodes as a placeholder value chosen by the
/// handle's number: `VHold` when the number is 1, and `VSecret` for any other number. A value
/// nested deeper than `shown_levels` levels decodes as `VElided(0)`.
pub fn decode_shown(b: Bytes) -> Option<Value> = decoded(b, true, shown_levels)

/// Returns how many levels of nesting `decode_shown` reads before it decodes deeper values as
/// `VElided(0)`. The limit is more than `render` shows and small enough that decoding stays within
/// the call depth the decoder allows.
pub const shown_levels: Int = 256

fn decoded(b: Bytes, shown: Bool, levels: Int) -> Option<Value> =
  handle {
    if !b.starts_with(b"PLV1") { None } else {
      let read = read_value(
        b,
        { at: 4, names: [], opened: [], levels: levels, shown: shown },
        3 * b.len() + 3,
      );
      if read.r.at == b.len() { Some(read.v) } else { None }
    }
  } with {
    abort.raise(_) -> None,
  }

type EncodeState = { out: List<Bytes>, names: Map<String, Int> }

fn put(w: EncodeState, b: Bytes) -> EncodeState = { ..w, out: w.out.push(b) }

fn written(v: Value, w: EncodeState) -> EncodeState / {abort.raise} =
  match v {
    VUnit -> put(w, byte_of_int(0)),
    VBool(x) -> put(w, byte_of_int(if x { 2 } else { 1 })),
    VInt(n) -> put(w, byte_of_int(3).concat(varint(zigzag(n)))),
    VFloat(f) -> put(w, byte_of_int(4).concat(float_bytes(f))),
    VDecimal(d) -> put(w, byte_of_int(5).concat(decimal_bytes(d))),
    VFixed(ty, bits) -> put(w, byte_of_int(6).concat(fixed_bytes(ty, bits))),
    VChar(c) -> put(w, byte_of_int(13).concat(varint(U128::of_int(Int::of_char(c))))),
    VStr(s) -> put(w, byte_of_int(7).concat(blob(Bytes::of_string(s)))),
    VBytes(b) -> put(w, byte_of_int(8).concat(blob(b))),
    VList(items) -> encode_all(items, put(w, counted(9, items.len()))),
    VArray(items) -> encode_all(items, put(w, counted(14, items.len()))),
    VMap(entries) ->
      entries.fold(put(w, counted(10, entries.len())), |accumulator: EncodeState, e: Entry|
        written(e.value, written(e.key, accumulator))),
    VRecord(fields) ->
      fields.fold(put(w, counted(11, fields.len())), |accumulator: EncodeState, f: Field|
        written(f.value, named(accumulator, f.name))),
    VCtor(name, args) ->
      encode_all(args, put(named(put(w, byte_of_int(12)), name), varint(U128::of_int(args.len())))),
    VFn(f) -> encode_function(f, put(w, byte_of_int(16))),
    VHold ->
      abort.raise(
        "cannot encode a value that exists only in the running program, such as an open handle",
      ),
    VSecret -> abort.raise("cannot encode a credential"),
    VElided(_) -> abort.raise("cannot encode a value that a snapshot left out"),
    VShown(_) ->
      abort.raise("cannot encode a value that was already converted to text by its type's `show`"),
  }

fn encode_all(items: List<Value>, w: EncodeState) -> EncodeState / {abort.raise} =
  items.fold(w, |accumulator: EncodeState, x: Value| written(x, accumulator))

fn encode_function(f: Fun, w: EncodeState) -> EncodeState / {abort.raise} =
  match f {
    NamedFunction(name) -> named(put(w, byte_of_int(0)), name),
    FAnonymous -> put(w, byte_of_int(1)),
    ConstantFunction(c) ->
      written(c.value, put(w, byte_of_int(2).concat(small(Int::of_u8(c.arity))))),
    ProjectionFunction(p) ->
      put(
        w,
        Bytes::concat_all([byte_of_int(3), small(Int::of_u8(p.arity)), small(Int::of_u8(p.index))]),
      ),
    TableFunction(t) ->
      written(
        t.default,
        t.entries.fold(
          put(
            w,
            Bytes::concat_all([byte_of_int(4), small(Int::of_u8(t.arity)), small(t.entries.len())]),
          ),
          |accumulator: EncodeState, e: Entry| written(e.value, written(e.key, accumulator)),
        ),
      ),
  }

fn named(w: EncodeState, name: String) -> EncodeState / {abort.raise} =
  match w.names.get(name) {
    Some(n) -> put(w, small(n)),
    None ->
      {
        out: w.out.push(small(0).concat(blob(Bytes::of_string(name)))),
        names: w.names.insert(name, w.names.len() + 1),
      },
  }

fn counted(tag: Int, n: Int) -> Bytes / {abort.raise} = byte_of_int(tag).concat(small(n))

fn blob(b: Bytes) -> Bytes / {abort.raise} = small(b.len()).concat(b)

fn small(n: Int) -> Bytes / {abort.raise} = varint(U128::of_int(n))

fn varint(x: U128) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, 10).fold(
      { out: [], rest: x, done: false },
      |s: { out: List<Bytes>, rest: U128, done: Bool }, _: Int|
        if s.done { s } else {
          let low = Int::of_u128(s.rest & 127u128);
          let rest = s.rest >> 7;
          if rest == 0u128 { { out: s.out.push(byte_of_int(low)), rest: rest, done: true } }
          else { { out: s.out.push(byte_of_int(low + 128)), rest: rest, done: false } }
        },
    ).out,
  )

fn zigzag(n: Int) -> U128 =
  if n >= 0 { U128::of_int(n) << 1 } else { U128::of_int(0 - (n + 1)) << 1 | 1u128 }

fn float_bytes(f: Float) -> Bytes = {
  let raw = bits_of_float(f);
  let nan = raw >>> 52 & 2047 == 2047 && raw & 0xF_FFFF_FFFF_FFFF != 0;
  let bits = if nan { 0x7FF8_0000_0000_0000 } else { raw };
  Bytes::concat_all(range(0, 8).map(|i: Int| byte_of_int(bits >>> 8 * i & 255)))
}

fn decimal_bytes(d: Decimal) -> Bytes = {
  let text = Decimal::to_string(d);
  let negative = text.starts_with("-");
  let words = text.chars().fold(
    { lo: 0, has_one: 0, hi: 0 },
    |accumulator: { lo: Int, has_one: Int, hi: Int }, c: Char|
      if c < '0' || c > '9' { accumulator } else {
        let lo = accumulator.lo * 10 + (Int::of_char(c) - 48);
        let mid = accumulator.has_one * 10 + (lo >> 32);
        let hi = accumulator.hi * 10 + (mid >> 32);
        { lo: lo & 0xFFFF_FFFF, has_one: mid & 0xFFFF_FFFF, hi: hi & 0xFFFF_FFFF }
      },
  );
  let flags = Decimal::scale(d) << 16 | (if negative { 1 << 31 } else { 0 });
  Bytes::concat_all([flags, words.lo, words.has_one, words.hi].map(le32))
}

fn le32(n: Int) -> Bytes =
  Bytes::concat_all(range(0, 4).map(|i: Int| byte_of_int(n >> 8 * i & 255)))

fn fixed_bytes(ty: String, bits: U128) -> Bytes / {abort.raise} = {
  let place = width_rank(ty);
  if place >= 10 { abort.raise("no width is named " ++ ty) } else {
    let width = width_of(ty);
    let pattern = bits & mask(width);
    let extended = if ty.starts_with("I") && width < 128 && pattern >> width - 1 == 1u128 {
      pattern | ~0u128 << width
    } else { pattern };
    let low = varint(extended & mask(64));
    byte_of_int(place).concat(if width == 128 { low.concat(varint(extended >> 64)) } else { low })
  }
}

type DecodeState = {
  at: Int,
  names: List<String>,
  opened: List<Option<Value>>,
  levels: Int,
  shown: Bool,
}

type ReadValue = { v: Value, r: DecodeState }

fn read_value(b: Bytes, r: DecodeState, depth: Int) -> ReadValue / {abort.raise} =
  if depth <= 0 { abort.raise("the bytes nest values deeper than the decoder allows") }
  else if r.levels == 0 { { v: VElided(0), r: skip_value(b, r) } } else {
    let t = b.at(r.at);
    let past = { ..r, at: r.at + 1, levels: r.levels - 1 };
    let read = if t == 7 || t == 8 || t == 9 || t == 10 || t == 14 {
      let n = past.opened.len();
      let body = read_body(b, t, { ..past, opened: past.opened.push(None) }, depth - 1);
      { v: body.v, r: { ..body.r, opened: body.r.opened.set(n, Some(body.v)) } }
    } else { read_body(b, t, past, depth - 1) };
    { v: read.v, r: { ..read.r, levels: r.levels } }
  }

type Remaining = { fields: Bool, left: Int }

fn skip_value(b: Bytes, r: DecodeState) -> DecodeState / {abort.raise} =
  iterate(
    { r: r, todo: [{ fields: false, left: 1 }] },
    b.len() + 2,
    |s: { r: DecodeState, todo: List<Remaining> }|
      match s.todo.last() {
        None -> Stop(s.r),
        Some(top) -> {
          let rest = if top.left == 1 { s.todo.take(s.todo.len() - 1) }
          else { s.todo.set(s.todo.len() - 1, { ..top, left: top.left - 1 }) };
          if top.fields {
            let name = read_name(b, s.r);
            Continue({ r: name.r, todo: rest.push({ fields: false, left: 1 }) })
          } else {
            let h = skip_head(b, s.r);
            Continue({ r: h.r, todo: if h.left.left == 0 { rest } else { rest.push(h.left) } })
          }
        },
      },
  )

fn skip_head(b: Bytes, r: DecodeState) -> { r: DecodeState, left: Remaining } / {abort.raise} = {
  let t = b.at(r.at);
  let at = r.at + 1;
  let alone = |to: Int| { r: { ..r, at: to }, left: { fields: false, left: 0 } };
  let opened = |to: Int, n: Int|
    {
      r: { ..r, at: to, opened: r.opened.push(Some(VElided(0))) },
      left: { fields: false, left: n },
    };
  if t <= 2 { alone(at) }
  else if t == 3 || t == 13 || t == 15 || t == 17 { alone(read_varint(b, at).at) }
  else if t == 4 { alone(at + 8) }
  else if t == 5 { alone(at + 16) } else if t == 6 {
    let low = read_varint(b, at + 1);
    alone(if b.at(at) >= 8 { read_varint(b, low.at).at } else { low.at })
  } else if t == 7 || t == 8 { opened(read_blob(b, at).at, 0) } else if t == 9 || t == 14 {
    let n = read_count(b, at);
    opened(n.at, n.n)
  } else if t == 10 {
    let n = read_count(b, at);
    opened(n.at, 2 * n.n)
  } else if t == 11 {
    let n = read_count(b, at);
    { r: { ..r, at: n.at }, left: { fields: true, left: n.n } }
  } else if t == 12 {
    let name = read_name(b, { ..r, at: at });
    let n = read_count(b, name.r.at);
    { r: { ..name.r, at: n.at }, left: { fields: false, left: n.n } }
  } else if t == 16 {
    let kind = b.at(at);
    if kind == 0 {
      let name = read_name(b, { ..r, at: at + 1 });
      { r: name.r, left: { fields: false, left: 0 } }
    } else if kind == 1 || kind == 5 { alone(at + 1) } else {
      let arity = read_varint(b, at + 1);
      if kind == 2 { { r: { ..r, at: arity.at }, left: { fields: false, left: 1 } } }
      else if kind == 3 { alone(read_varint(b, arity.at).at) } else if kind == 4 {
        let n = read_count(b, arity.at);
        { r: { ..r, at: n.at }, left: { fields: false, left: 2 * n.n + 1 } }
      } else {
        abort.raise("the bytes contain a function type number that this format does not define")
      }
    }
  } else { abort.raise("the bytes contain a value type number that this format does not define") }
}

fn read_body(b: Bytes, t: Int, r: DecodeState, depth: Int) -> ReadValue / {abort.raise} =
  if depth <= 0 { abort.raise("the bytes nest values deeper than the decoder allows") }
  else if t == 0 { { v: VUnit, r: r } }
  else if t == 1 { { v: VBool(false), r: r } }
  else if t == 2 { { v: VBool(true), r: r } } else if t == 3 {
    let z = read_varint(b, r.at);
    let half = Int::of_u128(z.u >> 1);
    { v: VInt(if z.u & 1u128 == 1u128 { 0 - half - 1 } else { half }), r: { ..r, at: z.at } }
  } else if t == 4 {
    let low = Int::of_u32(b.u32_le(r.at));
    let high = Int::of_u32(b.u32_le(r.at + 4));
    let signed = if high >= 0x8000_0000 { high - 0x1_0000_0000 } else { high };
    { v: VFloat(Float::of_bits(signed * 0x1_0000_0000 + low)), r: { ..r, at: r.at + 8 } }
  } else if t == 5 { { v: VDecimal(decimal_at(b, r.at)), r: { ..r, at: r.at + 16 } } }
  else if t == 6 {
    let place = b.at(r.at);
    let ty = match ["U8", "U16", "U32", "U64", "I8", "I16", "I32", "I64", "U128", "I128"].at(
        place,
      ) {
      Some(name) -> name,
      None -> abort.raise("a width this format does not have"),
    };
    let low = read_varint(b, r.at + 1);
    let high = if width_of(ty) == 128 { read_varint(b, low.at) } else { { u: 0u128, at: low.at } };
    {
      v: VFixed(ty, (high.u << 64 | low.u & mask(64)) & mask(width_of(ty))),
      r: { ..r, at: high.at },
    }
  } else if t == 7 {
    let s = read_blob(b, r.at);
    { v: VStr(String::of_bytes(s.b)), r: { ..r, at: s.at } }
  } else if t == 8 {
    let s = read_blob(b, r.at);
    { v: VBytes(s.b), r: { ..r, at: s.at } }
  } else if t == 9 || t == 14 {
    let n = read_count(b, r.at);
    let items = read_values(b, n.n, { ..r, at: n.at }, depth - 1);
    { v: if t == 9 { VList(items.vs) } else { VArray(items.vs) }, r: items.r }
  } else if t == 10 {
    let n = read_count(b, r.at);
    let entries = read_entries(b, n.n, { ..r, at: n.at }, depth - 1);
    { v: VMap(entries.es), r: entries.r }
  } else if t == 11 {
    let n = read_count(b, r.at);
    let fields = range(0, n.n).fold(
      { fs: [], r: { ..r, at: n.at } },
      |accumulator: { fs: List<Field>, r: DecodeState }, _: Int| {
        let name = read_name(b, accumulator.r);
        let value = read_value(b, name.r, depth - 1);
        { fs: accumulator.fs.push({ name: name.name, value: value.v }), r: value.r }
      },
    );
    { v: VRecord(fields.fs), r: fields.r }
  } else if t == 12 {
    let name = read_name(b, r);
    let n = read_count(b, name.r.at);
    let args = read_values(b, n.n, { ..name.r, at: n.at }, depth - 1);
    { v: VCtor(name.name, args.vs), r: args.r }
  } else if t == 13 {
    let c = read_varint(b, r.at);
    match Char::of_int(Int::of_u128(c.u)) {
      Some(ch) -> { v: VChar(ch), r: { ..r, at: c.at } },
      None -> abort.raise("a character that is not a Unicode scalar value"),
    }
  } else if t == 16 { read_function(b, r, depth - 1) } else if t == 17 {
    let n = read_varint(b, r.at);
    match r.opened.at(Int::of_u128(n.u)) {
      Some(Some(v)) -> { v: v, r: { ..r, at: n.at } },
      _ -> abort.raise("the bytes refer to a value before its encoding is complete"),
    }
  } else if t == 15 && r.shown {
    let n = read_varint(b, r.at);
    { v: if n.u == 1u128 { VHold } else { VSecret }, r: { ..r, at: n.at } }
  } else {
    abort.raise(
      "the bytes contain a value type number that this format does not define, or an open handle or credential that cannot be decoded here",
    )
  }

fn read_values(
  b: Bytes,
  n: Int,
  r: DecodeState,
  depth: Int,
) -> { vs: List<Value>, r: DecodeState } / {abort.raise} =
  if depth <= 0 { abort.raise("the bytes nest values deeper than the decoder allows") } else {
    range(0, n).fold({ vs: [], r: r }, |accumulator: { vs: List<Value>, r: DecodeState }, _: Int| {
      let x = read_value(b, accumulator.r, depth - 1);
      { vs: accumulator.vs.push(x.v), r: x.r }
    })
  }

fn read_entries(
  b: Bytes,
  n: Int,
  r: DecodeState,
  depth: Int,
) -> { es: List<Entry>, r: DecodeState } / {abort.raise} =
  if depth <= 0 { abort.raise("the bytes nest values deeper than the decoder allows") } else {
    range(0, n).fold({ es: [], r: r }, |accumulator: { es: List<Entry>, r: DecodeState }, _: Int| {
      let k = read_value(b, accumulator.r, depth - 1);
      let v = read_value(b, k.r, depth - 1);
      { es: accumulator.es.push({ key: k.v, value: v.v }), r: v.r }
    })
  }

fn read_function(b: Bytes, r: DecodeState, depth: Int) -> ReadValue / {abort.raise} =
  if depth <= 0 { abort.raise("the bytes nest values deeper than the decoder allows") } else {
    let kind = b.at(r.at);
    let past = { ..r, at: r.at + 1 };
    if kind == 0 {
      let name = read_name(b, past);
      { v: VFn(NamedFunction(name.name)), r: name.r }
    } else if kind == 1 || kind == 5 { { v: VFn(FAnonymous), r: past } } else {
      let arity = read_varint(b, past.at);
      let a = U8::of_int(Int::of_u128(arity.u));
      let after = { ..past, at: arity.at };
      if kind == 2 {
        let value = read_value(b, after, depth - 1);
        { v: VFn(ConstantFunction({ arity: a, value: value.v })), r: value.r }
      } else if kind == 3 {
        let index = read_varint(b, after.at);
        {
          v: VFn(ProjectionFunction({ arity: a, index: U8::of_int(Int::of_u128(index.u)) })),
          r: { ..after, at: index.at },
        }
      } else if kind == 4 {
        let n = read_count(b, after.at);
        let entries = read_entries(b, n.n, { ..after, at: n.at }, depth - 1);
        let default = read_value(b, entries.r, depth - 1);
        {
          v: VFn(TableFunction({ arity: a, entries: entries.es, default: default.v })),
          r: default.r,
        }
      } else {
        abort.raise("the bytes contain a function type number that this format does not define")
      }
    }
  }

fn read_name(b: Bytes, r: DecodeState) -> { name: String, r: DecodeState } / {abort.raise} = {
  let n = read_varint(b, r.at);
  if n.u == 0u128 {
    let s = read_blob(b, n.at);
    let name = String::of_bytes(s.b);
    { name: name, r: { ..r, at: s.at, names: r.names.push(name) } }
  } else {
    match r.names.at(Int::of_u128(n.u) - 1) {
      Some(name) -> { name: name, r: { ..r, at: n.at } },
      None -> abort.raise("a name read before it was written"),
    }
  }
}

fn read_blob(b: Bytes, at: Int) -> { b: Bytes, at: Int } / {abort.raise} = {
  let n = read_count(b, at);
  { b: b.slice(n.at, n.at + n.n), at: n.at + n.n }
}

fn read_count(b: Bytes, at: Int) -> { n: Int, at: Int } / {abort.raise} = {
  let x = read_varint(b, at);
  if x.u > U128::of_int(b.len() - x.at) { abort.raise("a count of more than the bytes left") }
  else { { n: Int::of_u128(x.u), at: x.at } }
}

fn read_varint(b: Bytes, at: Int) -> { u: U128, at: Int } / {abort.raise} =
  varint_from(b, at, 0, 0u128)

fn varint_from(
  b: Bytes,
  at: Int,
  shift: Int,
  accumulator: U128,
) -> { u: U128, at: Int } / {abort.raise} =
  if shift > 63 { abort.raise("a number longer than 64 bits") } else {
    let byte = b.at(at);
    let sum = accumulator | U128::of_int(byte & 127) << shift;
    if byte < 128 { { u: sum, at: at + 1 } } else { varint_from(b, at + 1, shift + 7, sum) }
  }

fn decimal_at(b: Bytes, at: Int) -> Decimal / {abort.raise} = {
  let flags = Int::of_u32(b.u32_le(at));
  let scale = flags >> 16 & 255;
  let words = [at + 12, at + 8, at + 4].map(|i: Int| Int::of_u32(b.u32_le(i)));
  let digits = iterate({ words: words, out: [] }, 40, |s: { words: List<Int>, out: List<Char> }|
    if s.words.all(|x: Int| x == 0) { Stop(s.out) } else {
      let divided = s.words.fold(
        { q: [], r: 0 },
        |accumulator: { q: List<Int>, r: Int }, x: Int| {
          let current = accumulator.r * 0x1_0000_0000 + x;
          { q: accumulator.q.push(current / 10), r: current % 10 }
        },
      );
      Continue({ words: divided.q, out: s.out.push(digit_char(divided.r)) })
    });
  let padded = range(digits.len(), scale + 1).fold(digits, |accumulator: List<Char>, _: Int|
    accumulator.push('0'));
  let ordered = padded.reverse();
  let whole = ordered.take(ordered.len() - scale);
  let fraction = ordered.drop(ordered.len() - scale);
  let text = (if flags >> 31 & 1 == 1 { "-" } else { "" }) ++ String::of_chars(whole)
    ++ (if scale == 0 { "" } else { "." ++ String::of_chars(fraction) });
  match Decimal::of_string(text) {
    Some(d) -> d,
    None -> abort.raise("the bytes contain a decimal that is too large or too precise to decode"),
  }
}

fn digit_char(d: Int) -> Char = match "0123456789".chars().at(d) { Some(c) -> c, None -> '0' }

fn char_escaped(c: Char) -> String = String::of_chars(escaped_char([], c, '\''))

fn escaped_char(accumulator: List<Char>, c: Char, quote: Char) -> List<Char> =
  if c == '\n' { accumulator.push('\\').push('n') }
  else if c == '\t' { accumulator.push('\\').push('t') }
  else if c == '\r' { accumulator.push('\\').push('r') }
  else if c == '\0' { accumulator.push('\\').push('0') }
  else if c == '\\' || c == quote { accumulator.push('\\').push(c) }
  else { accumulator.push(c) }

type Fitted = { chars: List<Char>, more: Int }

fn fitted<a>(units: List<a>, room: Option<Int>, write: (List<Char>, a) -> List<Char>) -> Fitted =
  match room {
    None -> { chars: units.fold([], write), more: 0 },
    Some(n) ->
      units.fold({ chars: [], more: 0 }, |s: Fitted, u: a|
        if s.more > 0 { { ..s, more: s.more + 1 } } else {
          let next = write(s.chars, u);
          if next.len() > n { { ..s, more: 1 } } else { { ..s, chars: next } }
        }),
  }

fn cut_text(open: String, close: String, f: Fitted) -> String =
  open ++ String::of_chars(f.chars) ++ close
    ++ (if f.more == 0 { "" } else { " " ++ elided(f.more) })

fn bytes_of(b: Bytes) -> List<Int> =
  handle { range(0, b.len()).map(|i: Int| b.at(i)) } with { abort.raise(_) -> [] }

fn byte_chars(accumulator: List<Char>, c: Int) -> List<Char> =
  if c == 10 { accumulator.push('\\').push('n') }
  else if c == 9 { accumulator.push('\\').push('t') }
  else if c == 13 { accumulator.push('\\').push('r') }
  else if c == 92 { accumulator.push('\\').push('\\') }
  else if c == 34 { accumulator.push('\\').push('"') } else if c >= 32 && c <= 126 {
    match Char::of_int(c) { Some(ch) -> accumulator.push(ch), None -> accumulator }
  } else { accumulator.push('\\').push('x').push(hex_digit(c / 16)).push(hex_digit(c % 16)) }

fn hex_digit(d: Int) -> Char = match "0123456789abcdef".chars().at(d) { Some(c) -> c, None -> '0' }

test "`render` shows scalar values as their source literals, without a type suffix such as `u8`" {
  assert_eq(render(VInt(-3)), "-3");
  assert_eq(render(VBool(true)), "true");
  assert_eq(render(VUnit), "()");
  assert_eq(render(VFloat(1.5)), "1.5");
  assert_eq(render(VDecimal(1.50m)), "1.50");
  assert_eq(render(VFixed("U8", 255u128)), "255");
  assert_eq(render(VFixed("I8", 255u128)), "-1");
  assert_eq(
    render(VFixed("I128", 170141183460469231731687303715884105728u128)),
    "-170141183460469231731687303715884105728",
  );
  assert_eq(
    render(VFixed("U128", 340282366920938463463374607431768211455u128)),
    "340282366920938463463374607431768211455",
  )
}

test "text is quoted and escaped" {
  assert_eq(render(VStr("a\"b\n")), "\"a\\\"b\\n\"");
  assert_eq(render(VStr("é")), "\"é\"");
  assert_eq(render(VBytes(b"GET \x00\xff")), "b\"GET \\x00\\xff\"")
}

fn last_cut(text: String) -> { shown: String, more: Int } / {abort.raise} = {
  let pieces = text.split("… ");
  let count = match pieces.last() {
    Some(last) -> match last.split(" ").at(0) { Some(n) -> n.int_of_string(), None -> None },
    None -> None,
  };
  {
    shown: String::join(pieces.take(pieces.len() - 1), "… "),
    more: match count { Some(n) -> n, None -> 0 },
  }
}

test "a value whose text fits the budget is shown whole" {
  gen::check(values(), |v: Value|
    render_all(v).len() > shown_characters || render(v) == render_all(v))
}

test "past the character limit, `render` cuts a string and reports how many characters it left out, and cuts bytes the same way" {
  let n = shown_characters;
  let text = |k: Int| VStr("a".repeat(k));
  assert_eq(render(text(n)), render_all(text(n)));
  assert_eq(render(text(n + 5)), render_all(text(n)) ++ " … 5 more");
  let bytes = |s: String| render(VBytes(Bytes::of_string(s)));
  assert_eq(bytes("a".repeat(n + 5)), "b" ++ render(text(n + 5)));
  let escaped = "ab\"\n".repeat(n);
  assert_eq(bytes(escaped), "b" ++ render(VStr(escaped)))
}

test "past the budget, each kind of container is cut alike, counting the items it left out" {
  let ints = |k: Int| range(0, k).map(|i: Int| VInt(i));
  let counted = |v: Value| {
    let cut = last_cut(render(v));
    cut.shown.split(", ").len() - 1 + cut.more
  };
  let n = shown_characters;
  assert_eq(
    [
      counted(VList(ints(n))),
      counted(VArray(ints(n))),
      counted(VCtor("m.Row", ints(n))),
      counted(VMap(ints(n).map(|x: Value| -> Entry { { key: x, value: x } }))),
      counted(
        VRecord(
          range(0, n).map(|i: Int| -> Field { { name: "f" ++ i.to_string(), value: VInt(i) } }),
        ),
      ),
    ],
    [n, n, n, n, n],
  );
  let small = last_cut(render(VList(ints(n))));
  let large = last_cut(render(VList(ints(2 * n))));
  assert_eq(small.shown, large.shown);
  assert_eq(large.more - small.more, n)
}

test "`render` applies the character limit to the whole value, so two strings in one list together show at most the limit" {
  let part = VStr("a".repeat(shown_characters * 3 / 5));
  assert_eq(render(VList([part])), render_all(VList([part])));
  let both = render(VList([part, part]));
  let letter_count = both.chars().filter(|c: Char| c == 'a').len();
  assert(letter_count <= shown_characters);
  assert_eq(letter_count + last_cut(both).more, 2 * (shown_characters * 3 / 5))
}

test "`render` shows a character as its literal, escaping the single quote and control characters but not the double quote" {
  assert_eq(render(VChar('a')), "'a'");
  assert_eq(render(VChar('\u{e9}')), "'\u{e9}'");
  assert_eq(render(VChar('\n')), "'\\n'");
  assert_eq(render(VChar('\'')), "'\\''");
  assert_eq(render(VChar('"')), "'\"'")
}

test "`order` compares characters by scalar value, and sorts characters after fixed-width integers" {
  assert_eq(order(VChar('a'), VChar('b')), Less);
  assert_eq(order(VChar('\u{1F600}'), VChar('z')), Greater);
  assert_eq(order(VFixed("U8", 255u128), VChar('a')), Less)
}

test "`render` shows nested lists, arrays, records, constructors and maps, and shows a record with fields `_0`, `_1` as a tuple" {
  assert_eq(render(VList([VInt(1), VInt(2)])), "[1, 2]");
  assert_eq(render(VArray([VInt(1), VInt(2)])), "Array::of_list([1, 2])");
  assert_eq(
    render(VRecord([{ name: "a", value: VInt(1) }, { name: "b", value: VStr("x") }])),
    "{a: 1, b: \"x\"}",
  );
  assert_eq(
    render(VRecord([{ name: "_0", value: VInt(1) }, { name: "_1", value: VBool(false) }])),
    "(1, false)",
  );
  assert_eq(render(VCtor("Some", [VInt(3)])), "Some(3)");
  assert_eq(render(VCtor("None", [])), "None");
  assert_eq(render(VMap([{ key: VStr("k"), value: VInt(1) }])), "{\"k\": 1}")
}

test "a constructor shows under the name its module declares, not the module's path" {
  assert_eq(render(VCtor("orders.Shipped", [VInt(3)])), "Shipped(3)");
  assert_eq(render(VCtor("app.models.Red", [])), "Red")
}

test "a set shows as the literal that builds it" {
  let set = |keys: List<Value>|
    VCtor("std.set.Set", [VMap(keys.map(|k: Value| { key: k, value: VUnit }))]);
  assert_eq(render(set([VInt(1), VStr("a")])), "#[1, \"a\"]");
  assert_eq(render(set([])), "#[]");
  assert_eq(render(set([VInt(1), VElided(4)])), "#[1, … 4 more]");
  assert_eq(render_all(VList([set([VInt(2)])])), "[#[2]]");
  assert_eq(render(VCtor("app.Set", [VMap([])])), "Set({})")
}

test "render_all writes what render does, every item at every depth" {
  let n = shown_characters;
  let long = VList(range(0, n).map(|i: Int| VInt(i)));
  assert_eq(
    render_all(long),
    "[" ++ String::join(range(0, n).map(|i: Int| i.to_string()), ", ") ++ "]",
  );
  assert(render(long) != render_all(long));
  assert_eq(render_all(VCtor("m.Shipped", [VInt(2)])), "Shipped(2)");
  let made = VFn(
    TableFunction({ arity: 1u8, entries: [{ key: VInt(0), value: long }], default: long }),
  );
  assert_eq(
    render_all(made),
    "<fn |x0| if x0 == 0 { " ++ render_all(long) ++ " } else { " ++ render_all(long) ++ " }>",
  )
}

fn scalars() -> gen::Gen<Value> =
  gen::one_of([
    gen::constant(VUnit),
    gen::map(gen::bool(), |b: Bool| VBool(b)),
    gen::map(gen::any_int(), |n: Int| VInt(n)),
    gen::map(gen::float(), |f: Float| VFloat(f)),
    gen::map(gen::decimal(), |d: Decimal| VDecimal(d)),
    gen::map(gen::u64(), |bits: U64| VFixed("U64", U128::of_int(Int::of_u64(bits >> 1)))),
    gen::map(gen::char(), |c: Char| VChar(c)),
    gen::map(gen::text(), |s: String| VStr(s)),
    gen::map(gen::bytes(), |b: Bytes| VBytes(b)),
    gen::map(gen::any_int(), |n: Int| VElided(n)),
    gen::map(gen::text(), |s: String| VShown(s)),
    gen::constant(VSecret),
  ])

fn values_at(depth: Int) -> gen::Gen<Value> =
  if depth <= 0 { scalars() } else {
    let inner = gen::list_of(values_at(depth - 1), 3);
    gen::one_of([
      scalars(),
      gen::map(inner, |items: List<Value>| VList(items)),
      gen::map(inner, |items: List<Value>| VArray(items)),
      gen::map2(gen::text(), inner, |name: String, args: List<Value>| VCtor("m." ++ name, args)),
      gen::map(
        gen::list_of(
          gen::map2(gen::text(), values_at(depth - 1), |name: String, value: Value| -> Field {
            { name: name, value: value }
          }),
          3,
        ),
        |fields: List<Field>| VRecord(fields),
      ),
      gen::map(
        gen::list_of(
          gen::map2(
            values_at(depth - 1),
            values_at(depth - 1),
            |key: Value, value: Value| -> Entry { { key: key, value: value } },
          ),
          3,
        ),
        |entries: List<Entry>| VMap(entries),
      ),
    ])
  }

/// A generator of values: a scalar, or a list, an array, a record, a map or a constructor of
/// values, a few levels deep. Its records and maps keep the order generated, which may differ from
/// the order the runtime uses.
pub fn values() -> gen::Gen<Value> = gen::sized(|size: Int| values_at(min(max(size / 16, 0), 2)))

test "render_all writes a value inside a list or a constructor as it writes the value alone" {
  gen::check(values(), |v: Value| {
    render_all(VList([v])) == "[" ++ render_all(v) ++ "]"
      && render_all(VCtor("m.Held", [v])) == "Held(" ++ render_all(v) ++ ")"
  })
}

test "a snapshot cut short shows where it was cut" {
  assert_eq(render(VList([VInt(1), VElided(5)])), "[1, … 5 more]");
  assert_eq(
    render(VMap([{ key: VInt(1), value: VInt(2) }, { key: VElided(3), value: VElided(3) }])),
    "{1: 2, … 3 more}",
  );
  assert_eq(render(VCtor("Some", [VElided(0)])), "Some(…)")
}

test "nesting past the shown depth is elided" {
  let deep = range(0, 20).fold(VInt(0), |accumulator: Value, _: Int| VList([accumulator]));
  assert(render(deep).contains("[…]"));
  assert(!render(deep).contains("0"))
}

test "`filled` replaces each numbered placeholder in a message with its rendered value, and leaves a placeholder with no matching value unchanged" {
  let slot = |i: Int| opener ++ i.to_string() ++ closer;
  assert_eq(
    filled("expected " ++ slot(0) ++ ", found " ++ slot(1), [VInt(1), VStr("a")]),
    "expected 1, found \"a\"",
  );
  assert_eq(filled("no slots", []), "no slots");
  assert_eq(filled("at " ++ slot(3), [VInt(1)]), "at " ++ slot(3))
}

test "`render` shows a function as `<fn ...>` with its name or body, a secret as `Secret(****)` and a lock handle as `<hold>`" {
  assert_eq(render(VFn(NamedFunction("m.double"))), "<fn m.double>");
  assert_eq(render(VFn(FAnonymous)), "<fn>");
  assert_eq(render(VFn(ConstantFunction({ arity: 2u8, value: VInt(3) }))), "<fn |_, _| 3>");
  assert_eq(render(VFn(ProjectionFunction({ arity: 2u8, index: 1u8 }))), "<fn |x0, x1| x1>");
  assert_eq(
    render(
      VFn(
        TableFunction({
          arity: 1u8,
          entries: [{ key: VInt(1), value: VBool(true) }],
          default: VBool(false),
        }),
      ),
    ),
    "<fn |x0| if x0 == 1 { true } else { false }>",
  );
  assert_eq(render(VSecret), "Secret(****)");
  assert_eq(render(VHold), "<hold>")
}

test "values order by kind first, then as their payloads compare" {
  assert_eq(order(VInt(5), VStr("a")), Less);
  assert_eq(order(VStr("b"), VStr("ab")), Greater);
  assert_eq(order(VList([VInt(1)]), VList([VInt(1), VInt(0)])), Less);
  assert_eq(order(VArray([VInt(2)]), VArray([VInt(1), VInt(0)])), Greater);
  assert_eq(order(VChar('z'), VArray([])), Less);
  assert_eq(order(VCtor("m.A", [VInt(9)]), VCtor("m.B", [])), Less);
  assert_eq(order(VFixed("I8", 255u128), VFixed("I8", 0u128)), Less);
  assert_eq(order(VFixed("U8", 255u128), VFixed("U8", 0u128)), Greater);
  assert_eq(order(VFloat(0.0 - 1.0), VFloat(0.5)), Less)
}

test "a map is in key order, and a later entry for a key replaces an earlier one" {
  assert_eq(
    map_of([
      { key: VInt(3), value: VStr("c") },
      { key: VInt(1), value: VStr("a") },
      { key: VInt(3), value: VStr("z") },
      { key: VInt(2), value: VStr("b") },
    ]),
    VMap([
      { key: VInt(1), value: VStr("a") },
      { key: VInt(2), value: VStr("b") },
      { key: VInt(3), value: VStr("z") },
    ]),
  )
}

test "a value is written as the runtime's codec writes it, byte for byte" {
  let plv1 = |b: Bytes| b"PLV1".concat(b);
  assert_eq(encode(VUnit), Some(plv1(b"\x00")));
  assert_eq(encode(VInt(1)), Some(plv1(b"\x03\x02")));
  assert_eq(encode(VInt(0 - 1)), Some(plv1(b"\x03\x01")));
  assert_eq(encode(VInt(300)), Some(plv1(b"\x03\xd8\x04")));
  assert_eq(encode(VFloat(1.0)), Some(plv1(b"\x04\x00\x00\x00\x00\x00\x00\xf0\x3f")));
  assert_eq(encode(VStr(String::of_bytes(b"\xc3\xa9"))), Some(plv1(b"\x07\x02\xc3\xa9")));
  assert_eq(encode(VChar('a')), Some(plv1(b"\x0d\x61")));
  assert_eq(
    encode(VFixed("I8", 255u128)),
    Some(plv1(b"\x06\x04\xff\xff\xff\xff\xff\xff\xff\xff\xff\x01")),
  );
  assert_eq(encode(VFixed("U8", 255u128)), Some(plv1(b"\x06\x00\xff\x01")));
  assert_eq(
    encode(VDecimal(Decimal::of_int(15).div(Decimal::of_int(10), 1, Down))),
    Some(plv1(b"\x05\x00\x00\x01\x00\x0f\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")),
  );
  let row = VRecord([{ name: "a", value: VInt(1) }]);
  assert_eq(
    encode(VList([row, row])),
    Some(plv1(b"\x09\x02\x0b\x01\x00\x01a\x03\x02\x0b\x01\x01\x03\x02")),
  );
  assert_eq(encode(VCtor("Some", [VInt(1)])), Some(plv1(b"\x0c\x00\x04Some\x01\x03\x02")));
  assert_eq(
    encode(VFn(ProjectionFunction({ arity: 2u8, index: 1u8 }))),
    Some(plv1(b"\x10\x03\x02\x01")),
  );
  assert_eq([VHold, VSecret, VElided(0), VShown("x")].map(encode), [None, None, None, None])
}

test "decoding what encoding wrote and encoding it again gives the same bytes" {
  gen::check(values(), |v: Value|
    match encode(v) {
      Some(b) -> match decode(b) { Some(back) -> encode(back) == Some(b), None -> false },
      None -> true,
    })
}

test "`decode` turns a back-reference into a copy of the earlier value, but returns `None` if that value is still being decoded" {
  let plv1 = |b: Bytes| b"PLV1".concat(b);
  assert_eq(decode(plv1(b"\x09\x02\x07\x01a\x11\x01")), Some(VList([VStr("a"), VStr("a")])));
  assert_eq(decode(plv1(b"\x09\x01\x11\x00")), None);
  assert_eq(decode(plv1(b"\x0f\x00")), None);
  assert_eq(decode(plv1(b"\x00\x00")), None);
  assert_eq(decode(b"PLW1\x00"), None);
  assert_eq(decode(plv1(b"\x09\x7f")), None);
  assert_eq(decode(plv1(b"\x0d\x80\x80\x80\x80\x80\x80\x80\x80\x80\x80\x01")), None)
}

test "decimals, fixed-width integers and floats decode to the same values they were encoded from" {
  let decimals = [
    Decimal::of_int(0),
    Decimal::of_int(0 - 7).div(Decimal::of_int(1000), 3, Down),
    Decimal::of_int(9223372036854775807).div(Decimal::of_int(100), 2, Down),
  ];
  assert_eq(
    decimals.map(|d: Decimal| match encode(VDecimal(d)) { Some(b) -> decode(b), None -> None }),
    decimals.map(|d: Decimal| Some(VDecimal(d))),
  );
  let widths = [
    VFixed("I128", ~0u128),
    VFixed("U128", ~0u128),
    VFixed("I64", 9223372036854775808u128),
    VFixed("U64", 18446744073709551615u128),
    VFixed("I16", 32768u128),
  ];
  assert_eq(
    widths.map(|v: Value| match encode(v) { Some(b) -> decode(b), None -> None }),
    widths.map(|v: Value| Some(v)),
  );
  let floats = [Float::of_bits(0 - 9223372036854775807 - 1), 1.5, 0.0 - 2.5];
  assert_eq(
    floats.map(|f: Float|
      match encode(VFloat(f)) {
        Some(b) -> match decode(b) { Some(VFloat(g)) -> bits_of_float(g), _ -> 0 },
        None -> 0,
      }),
    floats.map(bits_of_float),
  )
}

fn shown_text(v: Value) -> String =
  match encode(v) {
    Some(b) -> match decode_shown(b) { Some(x) -> render(x), None -> "no value" },
    None -> "no bytes",
  }

test "for any value that can be encoded, the text `shown_text` gives for a diagnostic equals `render` of that value" {
  gen::check(values(), |v: Value| encode(v) == None || shown_text(v) == render(v))
}

test "`shown_text` writes each kind of value in a diagnostic as Ply source text" {
  assert_eq(
    shown_text(
      VRecord([{ name: "at", value: VInt(1) }, { name: "why", value: VStr("not a digit") }]),
    ),
    "{at: 1, why: \"not a digit\"}",
  );
  assert_eq(shown_text(VCtor("orders.Shipped", [VInt(3)])), "Shipped(3)");
  assert_eq(shown_text(VCtor("Some", [VList([VInt(1), VInt(2)])])), "Some([1, 2])");
  assert_eq(shown_text(VMap([{ key: VStr("k"), value: VDecimal(1.50m) }])), "{\"k\": 1.50}");
  assert_eq(shown_text(VArray([VChar('a')])), "Array::of_list(['a'])");
  assert_eq(shown_text(VFixed("I8", 255u128)), "-1");
  assert_eq(shown_text(VFixed("U128", ~0u128)), "340282366920938463463374607431768211455");
  assert_eq(shown_text(VStr("a\"b\n")), "\"a\\\"b\\n\"");
  assert_eq(shown_text(VFloat(0.5)), "0.5");
  let long = VList(range(0, 40).map(|i: Int| VInt(i)));
  assert_eq(shown_text(VList([long])), render(VList([long])));
  let deep = range(0, 20).fold(VInt(0), |accumulator: Value, _: Int| VList([accumulator]));
  assert_eq(shown_text(deep), render(deep))
}

test "`decode_shown` turns the encoded secret and lock handle in a diagnostic's value into the matching runtime values, but `decode` rejects them" {
  let plv1 = |b: Bytes| b"PLV1".concat(b);
  let rendered = |b: Bytes|
    match decode_shown(plv1(b)) { Some(v) -> render(v), None -> "no value" };
  assert_eq(rendered(b"\x0f\x00"), "Secret(****)");
  assert_eq(rendered(b"\x0f\x01"), "<hold>");
  assert_eq(rendered(b"\x0b\x01\x00\x05token\x0f\x00"), "{token: Secret(****)}");
  assert_eq(decode(plv1(b"\x0f\x00")), None);
  assert_eq([decode(plv1(b"\x10\x05")), decode_shown(plv1(b"\x10\x05"))], [
    Some(VFn(FAnonymous)),
    Some(VFn(FAnonymous)),
  ])
}

test "`decode_shown` reads a diagnostic's value only to a fixed nesting depth, replaces anything deeper with a placeholder and still reads the values after it" {
  let nested = Bytes::concat_all(range(0, shown_levels).map(|_: Int| b"\x09\x01"));
  let b = Bytes::concat_all([b"PLV1\x09\x02", nested, b"\x07\x01x\x11\x81\x02"]);
  let second = |read: Option<Value>| match read { Some(VList([_, x])) -> Some(x), _ -> None };
  assert_eq(second(decode(b)), Some(VStr("x")));
  assert_eq(second(decode_shown(b)), Some(VElided(0)));
  let deep = range(0, shown_levels + 9).fold(VStr("end"), |accumulator: Value, _: Int|
    VList([accumulator]));
  match encode(VList([deep, VInt(5)])) {
    Some(written) -> assert_eq(second(decode_shown(written)), Some(VInt(5))),
    None -> assert(false),
  }
}

test "an assertion failure note gives the path to the first place two values differ, and the expected and actual values found there" {
  let noted = |actual: Value, expected: Value|
    match difference_note(actual, expected, 2) {
      Some(n) -> filled(n.note, [expected, actual].concat(n.values)),
      None -> "",
    };
  let row = |n: Int| VRecord([{ name: "id", value: VInt(1) }, { name: "qty", value: VInt(n) }]);
  assert_eq(
    noted(VList([row(1), row(2)]), VList([row(1), row(3)])),
    "first difference at `[1].qty`: expected 3, found 2",
  );
  assert_eq(
    noted(
      VMap([{ key: VStr("x"), value: VInt(0) }, { key: VStr("y"), value: VInt(1) }]),
      VMap([{ key: VStr("x"), value: VInt(0) }, { key: VStr("y"), value: VInt(2) }]),
    ),
    "first difference at `[\"y\"]`: expected 2, found 1",
  );
  let chain = |n: Int, bottom: String|
    range(0, n).fold(VCtor(bottom, []), |accumulator: Value, _: Int|
      VCtor("m.Link", [accumulator]));
  assert_eq(
    noted(chain(100, "m.Nil"), chain(100, "m.End")),
    "first difference at `" ++ ".m.Link.0".repeat(100) ++ "`: expected End, found Nil",
  );
  assert_eq(
    noted(VList([VList([VInt(1)])]), VList([VList([])])),
    "first difference at `[0]`: expected [], found [1]",
  );
  assert_eq(
    [
      noted(VInt(1), VInt(2)),
      noted(VList([VInt(1)]), VList([VInt(1), VInt(2)])),
